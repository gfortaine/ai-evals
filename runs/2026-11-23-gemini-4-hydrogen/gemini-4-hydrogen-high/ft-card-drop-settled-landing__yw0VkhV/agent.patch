diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..551513a
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,328 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "container", "item" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  connect() {
+    this.pendingSaves = 0
+    this.deferredRefresh = false
+    this.justDragged = false
+    this.mediaQuery = window.matchMedia(this.desktopBreakpointValue)
+    this.handleBreakpointChange = this.#updateDraggableItems.bind(this)
+    this.mediaQuery.addEventListener("change", this.handleBreakpointChange)
+    this.#updateDraggableItems()
+  }
+
+  disconnect() {
+    this.mediaQuery?.removeEventListener("change", this.handleBreakpointChange)
+    clearTimeout(this.justDraggedTimeout)
+    this.#clearDragState()
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = this.#isDesktop
+  }
+
+  dragStart(event) {
+    if (!this.#isDesktop) return
+
+    const item = this.#itemFrom(event.target)
+    if (!item) return
+
+    const sourceContainer = this.#containerFrom(item)
+    if (!sourceContainer) return
+
+    this.draggedItem = item
+    this.sourceContainer = sourceContainer
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+
+    requestAnimationFrame(() => {
+      if (this.draggedItem === item) {
+        item.classList.add(this.draggedItemClass)
+      }
+    })
+  }
+
+  dragEnd() {
+    this.#markJustDragged()
+    this.#clearDragState()
+    this.#flushDeferredRefresh()
+  }
+
+  preventClickAfterDrag(event) {
+    if (this.justDragged) {
+      event.preventDefault()
+      event.stopPropagation()
+    }
+  }
+
+  dragEnter(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#containerFrom(event.target)
+    if (container && container !== this.sourceContainer) {
+      event.preventDefault()
+      this.#setHoveredContainer(container)
+    }
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#containerFrom(event.target)
+    if (container && container !== this.sourceContainer) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#setHoveredContainer(container)
+    } else {
+      this.#clearHoveredContainer()
+    }
+  }
+
+  dragLeave(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#containerFrom(event.target)
+    if (!container || container !== this.hoveredContainer) return
+
+    const related = event.relatedTarget
+    if (related instanceof Node) {
+      if (!container.contains(related)) {
+        this.#clearHoveredContainer()
+      }
+    } else if (event.target === container) {
+      this.#clearHoveredContainer()
+    }
+  }
+
+  async drop(event) {
+    if (!this.draggedItem) return
+
+    const targetContainer = this.#containerFrom(event.target)
+    if (!targetContainer || targetContainer === this.sourceContainer) return
+
+    event.preventDefault()
+    this.#markJustDragged()
+
+    const item = this.draggedItem
+    const sourceContainer = this.sourceContainer
+    this.#clearDragState()
+
+    const previousState = this.#captureItemState(item)
+    this.#moveItem(item, sourceContainer, targetContainer)
+
+    this.pendingSaves += 1
+    try {
+      const response = await this.#saveMove(item, targetContainer)
+      if (!response?.ok) {
+        this.#restoreItem(item, sourceContainer, targetContainer, previousState)
+      }
+    } catch {
+      this.#restoreItem(item, sourceContainer, targetContainer, previousState)
+    } finally {
+      this.pendingSaves -= 1
+      this.#flushDeferredRefresh()
+    }
+  }
+
+  preventRefreshWhileDragging(event) {
+    if (!(this.draggedItem || this.pendingSaves > 0)) return
+    if (event.target.getAttribute("action") !== "refresh") return
+
+    event.preventDefault()
+    if (!this.pendingSaves) {
+      this.deferredRefresh = true
+    }
+  }
+
+  // Private
+
+  get #isDesktop() {
+    return this.mediaQuery?.matches ?? false
+  }
+
+  #markJustDragged() {
+    this.justDragged = true
+    clearTimeout(this.justDraggedTimeout)
+    this.justDraggedTimeout = setTimeout(() => {
+      this.justDragged = false
+    }, 50)
+  }
+
+  #updateDraggableItems() {
+    this.itemTargets.forEach(item => {
+      item.draggable = this.#isDesktop
+    })
+  }
+
+  #itemFrom(target) {
+    if (!(target instanceof Element)) return null
+    const item = target.closest('[data-drag-and-drop-target~="item"]')
+    return item && this.element.contains(item) ? item : null
+  }
+
+  #containerFrom(target) {
+    if (!(target instanceof Element)) return null
+    const container = target.closest('[data-drag-and-drop-target~="container"]')
+    return container && this.element.contains(container) ? container : null
+  }
+
+  #setHoveredContainer(container) {
+    if (this.hoveredContainer === container) return
+
+    this.#clearHoveredContainer()
+    this.hoveredContainer = container
+    this.hoveredContainer.classList.add(this.hoverContainerClass)
+  }
+
+  #clearHoveredContainer() {
+    if (this.hoveredContainer) {
+      this.hoveredContainer.classList.remove(this.hoverContainerClass)
+      this.hoveredContainer = null
+    }
+  }
+
+  #clearDragState() {
+    if (this.draggedItem) {
+      this.draggedItem.classList.remove(this.draggedItemClass)
+      this.draggedItem = null
+    }
+    this.sourceContainer = null
+    this.#clearHoveredContainer()
+  }
+
+  #captureItemState(item) {
+    const stamp = item.querySelector(".card__closed")
+    const bubble = item.querySelector(".bubble")
+
+    return {
+      parent: item.parentElement,
+      nextSibling: item.nextSibling,
+      cardColor: item.style.getPropertyValue("--card-color"),
+      className: item.className,
+      stamp: stamp ? stamp.cloneNode(true) : null,
+      bubbleHidden: bubble ? bubble.hasAttribute("hidden") : null
+    }
+  }
+
+  #moveItem(item, sourceContainer, targetContainer) {
+    this.#insertItemIntoContainer(item, targetContainer)
+    this.#updateItemAppearance(item, targetContainer)
+    this.#updateCount(sourceContainer, -1)
+    this.#updateCount(targetContainer, 1)
+  }
+
+  #restoreItem(item, sourceContainer, targetContainer, previousState) {
+    if (previousState.parent?.isConnected) {
+      previousState.parent.insertBefore(item, previousState.nextSibling)
+    }
+
+    item.className = previousState.className
+    if (previousState.cardColor) {
+      item.style.setProperty("--card-color", previousState.cardColor)
+    } else {
+      item.style.removeProperty("--card-color")
+    }
+
+    if (previousState.stamp && !item.querySelector(".card__closed")) {
+      item.querySelector(".card__body")?.append(previousState.stamp)
+    }
+
+    const bubble = item.querySelector(".bubble")
+    if (bubble && previousState.bubbleHidden !== null) {
+      bubble.toggleAttribute("hidden", previousState.bubbleHidden)
+    }
+
+    this.#updateCount(targetContainer, -1)
+    this.#updateCount(sourceContainer, 1)
+  }
+
+  #insertItemIntoContainer(item, targetContainer) {
+    const list = targetContainer.querySelector(".cards__list")
+    if (!list) return
+
+    item.removeAttribute("aria-selected")
+
+    const respectGoldenOrder = targetContainer.id === "maybe" || targetContainer.classList.contains("cards--doing")
+    const cards = Array.from(list.querySelectorAll(".card"))
+    const isGolden = item.classList.contains("golden-effect")
+
+    let referenceNode = null
+    if (cards.length > 0) {
+      if (!respectGoldenOrder || isGolden) {
+        referenceNode = cards[0]
+      } else {
+        referenceNode = cards.find(card => !card.classList.contains("golden-effect")) || null
+      }
+    }
+
+    if (referenceNode) {
+      referenceNode.before(item)
+    } else if (cards.length > 0) {
+      cards[cards.length - 1].after(item)
+    } else {
+      const frame = list.querySelector("turbo-frame")
+      ;(frame || list).prepend(item)
+    }
+  }
+
+  #updateItemAppearance(item, targetContainer) {
+    if (targetContainer.id === "not-now") {
+      item.classList.add("card--postponed")
+      item.classList.remove("card--active")
+    } else if (targetContainer.id === "closed-cards") {
+      item.classList.remove("card--postponed", "card--active")
+    } else {
+      item.classList.remove("card--postponed")
+      item.classList.add("card--active")
+      item.querySelector(".card__closed")?.remove()
+      item.querySelector(".bubble")?.setAttribute("hidden", "")
+
+      if (targetContainer.dataset.cardColor) {
+        item.style.setProperty("--card-color", targetContainer.dataset.cardColor)
+      }
+    }
+  }
+
+  #updateCount(container, delta) {
+    const countElement = container.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const currentCount = parseInt(countElement.dataset.count ?? countElement.textContent, 10)
+    if (Number.isNaN(currentCount)) return
+
+    const nextCount = Math.max(0, currentCount + delta)
+    countElement.dataset.count = nextCount
+    countElement.textContent = nextCount > 99 ? "99+" : String(nextCount)
+  }
+
+  #saveMove(item, targetContainer) {
+    if (targetContainer.id === "not-now") {
+      return post(item.dataset.cardNotNowUrl, { responseKind: "json" })
+    } else if (targetContainer.id === "closed-cards") {
+      return post(item.dataset.cardClosureUrl, { responseKind: "json" })
+    } else if (targetContainer.id === "maybe") {
+      return destroy(item.dataset.cardTriageUrl, { responseKind: "json" })
+    } else if (targetContainer.dataset.columnId) {
+      return post(item.dataset.cardTriageUrl, {
+        query: { column_id: targetContainer.dataset.columnId },
+        responseKind: "json"
+      })
+    }
+  }
+
+  #flushDeferredRefresh() {
+    if (this.deferredRefresh && !this.draggedItem && this.pendingSaves === 0) {
+      this.deferredRefresh = false
+      Turbo.session.refresh(document.baseURI)
+    }
+  }
+}
