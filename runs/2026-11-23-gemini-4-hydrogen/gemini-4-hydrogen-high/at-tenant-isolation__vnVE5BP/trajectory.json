k), params: { id: foreign_book.leaves.first.id, position: 0 }\n      assert_response :not_found\n\n      get new_book_page_path(foreign_book)\n      assert_response :not_found\n\n      post book_pages_path(foreign_book, format: :turbo_stream), params: { leaf: { title: \"Injected\" }, page: { body: \"Hi\" } }\n      assert_response :not_found\n    end\n\n    [ @leaf_b, @leaf_b_published ].each do |foreign_leaf|\n      get leafable_slug_path(foreign_leaf)\n      assert_response :not_found\n\n      get leafable_slug_path(foreign_leaf, format: :md)\n      assert_response :not_found\n\n      get edit_book_page_path(foreign_leaf.book, foreign_leaf)\n      assert_response :not_found\n\n      patch book_page_path(foreign_leaf.book, foreign_leaf), params: { page: { body: \"Hacked\" } }\n      assert_response :not_found\n\n      delete book_page_path(foreign_leaf.book, foreign_leaf)\n      assert_response :not_found\n\n      get page_edit_path(foreign_leaf, foreign_leaf.edits.last)\n      assert_response :not_found\n\n      get page_edit_path(foreign_leaf, \"latest\")\n      assert_response :not_found\n    end\n\n    # User stays signed in throughout\n    get book_slug_path(@book_a)\n    assert_response :success\n    assert_in_body \"Customer A Handbook\"\n  end\n\n  test \"customer A administrator also gets 404 for customer B books and edit histories\" do\n    sign_in @admin_a\n\n    get book_slug_path(@book_b)\n    assert_response :not_found\n\n    get edit_book_path(@book_b)\n    assert_response :not_found\n\n    get leafable_slug_path(@leaf_b)\n    assert_response :not_found\n\n    get page_edit_path(@leaf_b, \"latest\")\n    assert_response :not_found\n\n    # Admin stays signed in and can edit inside own tenant\n    get edit_book_path(@book_a)\n    assert_response :success\n  end\n\n  test \"within a tenant own books, everyone access, and page histories continue working\" do\n    sign_in @aaron\n\n    get root_path\n    assert_response :success\n    assert_in_body \"Customer A Handbook\"\n\n    get book_slug_path(@book_a)\n    assert_response :success\n\n    get leafable_slug_path(@leaf_a)\n    assert_response :success\n    assert_in_body \"Updated A content\"\n\n    get page_edit_path(@leaf_a, \"latest\")\n    assert_response :success\n    assert_in_body \"Original A content\"\n    assert_in_body \"Updated A content\"\n  end\n\n  test \"/users still names everyone on the install\" do\n    sign_in @alice\n\n    get users_path\n    assert_response :success\n    assert_in_body @alice.name\n    assert_in_body @bob.name\n    assert_in_body users(:kevin).name\n  end\n\n  test \"signed-out visitors see every published book across all tenants\" do\n    @book_a.update!(published: true)\n\n    get root_path\n    assert_response :success\n    assert_in_body \"Customer A Handbook\"\n    assert_in_body \"Customer B Public\"\n    assert_not_in_body \"Customer B Secret\"\n\n    get book_slug_path(@book_b_published)\n    assert_response :success\n\n    get leafable_slug_path(@leaf_b_published)\n    assert_response :success\n    assert_in_body \"Updated Published B content\"\n\n    get book_slug_path(@book_b)\n    assert_response :not_found\n  end\nend\nEOF"
