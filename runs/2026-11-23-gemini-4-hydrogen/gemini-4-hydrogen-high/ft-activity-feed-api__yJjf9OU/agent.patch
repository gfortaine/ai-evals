@@ -0,0 +1,312 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns accessible activities newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_operator @response.parsed_body.size, :>, 0
+
+    expected_ids = Event
+      .where(board: users(:kevin).boards)
+      .where(action: ActivitiesController::ACTIVITY_ACTIONS)
+      .reverse_chronologically
+      .limit(15)
+      .pluck(:id)
+
+    assert_equal expected_ids, @response.parsed_body.pluck("id")
+  end
+
+  test "index defaults to JSON and rejects HTML" do
+    get activities_path
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+  end
+
+  test "index authenticates with bearer token" do
+    sign_out
+    token = identity_access_tokens(:davids_api_token).token
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{token}" }
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  test "index requires authentication" do
+    sign_out
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer invalid" }
+    assert_response :unauthorized
+  end
+
+  test "index includes expected fields and representations for card and comment events" do
+    card_event = events(:logo_assignment_jz)
+    comment_event = events(:layout_commented)
+
+    card_event.update!(created_at: 2.minutes.ago)
+    comment_event.update!(created_at: 1.minute.ago)
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    comment_json = @response.parsed_body.find { |item| item["id"] == comment_event.id }
+    card_json = @response.parsed_body.find { |item| item["id"] == card_event.id }
+
+    assert_not_nil comment_json
+    assert_equal %w[ id action eventable_type created_at description particulars url eventable board creator ].sort, comment_json.keys.sort
+    assert_equal "comment_created", comment_json["action"]
+    assert_equal "Comment", comment_json["eventable_type"]
+    assert_equal comment_event.created_at.utc.iso8601(3), comment_json["created_at"]
+    assert_equal comment_event.description_for(users(:kevin)).to_plain_text, comment_json["description"]
+    assert_equal({}, comment_json["particulars"])
+    assert_equal card_url(comment_event.eventable.card, anchor: dom_id(comment_event.eventable)), comment_json["url"]
+    assert_equal comment_event.eventable.id, comment_json.dig("eventable", "id")
+    assert_equal comment_event.eventable.body.to_plain_text, comment_json.dig("eventable", "body", "plain_text")
+    assert_equal comment_event.board.id, comment_json.dig("board", "id")
+    assert_equal comment_event.board.name, comment_json.dig("board", "name")
+    assert_equal comment_event.creator.id, comment_json.dig("creator", "id")
+    assert_equal comment_event.creator.name, comment_json.dig("creator", "name")
+
+    assert_not_nil card_json
+    assert_equal "card_assigned", card_json["action"]
+    assert_equal "Card", card_json["eventable_type"]
+    assert_equal card_event.created_at.utc.iso8601(3), card_json["created_at"]
+    assert_equal card_event.description_for(users(:kevin)).to_plain_text, card_json["description"]
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, card_json["particulars"])
+    assert_equal card_url(card_event.eventable), card_json["url"]
+    assert_equal card_event.eventable.id, card_json.dig("eventable", "id")
+    assert_equal card_event.eventable.number, card_json.dig("eventable", "number")
+    assert_equal card_event.eventable.title, card_json.dig("eventable", "title")
+    assert_equal card_event.board.id, card_json.dig("board", "id")
+    assert_equal card_event.creator.id, card_json.dig("creator", "id")
+  end
+
+  test "index omits card_collection_changed and includes card_title_changed" do
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    omitted = board.events.create!(
+      action: "card_collection_changed",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: { particulars: { old_collection: "Old", new_collection: "New" } },
+      created_at: 2.minutes.ago
+    )
+    included = board.events.create!(
+      action: "card_title_changed",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: { particulars: { old_title: "Old Title", new_title: "New Title" } },
+      created_at: 1.minute.ago
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    ids = @response.parsed_body.pluck("id")
+    assert_not_includes ids, omitted.id
+    assert_includes ids, included.id
+
+    title_event_json = @response.parsed_body.find { |item| item["id"] == included.id }
+    assert_equal({ "old_title" => "Old Title", "new_title" => "New Title" }, title_event_json["particulars"])
+    assert_includes title_event_json["description"], "renamed"
+  end
+
+  test "index returns expected particulars for all event types including missing values" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    now = Time.current
+
+    published = board.events.create!(action: "card_published", creator: users(:david), eventable: card, created_at: now)
+    unassigned = board.events.create!(action: "card_unassigned", creator: users(:david), eventable: card, particulars: { assignee_ids: [ users(:kevin).id ] }, created_at: now - 1.second)
+    board_changed = board.events.create!(action: "card_board_changed", creator: users(:david), eventable: card, particulars: { particulars: { old_board: "Inbox", new_board: "Writebook" } }, created_at: now - 2.seconds)
+    board_missing = board.events.create!(action: "card_board_changed", creator: users(:david), eventable: card, particulars: {}, created_at: now - 3.seconds)
+    title_missing = board.events.create!(action: "card_title_changed", creator: users(:david), eventable: card, particulars: { particulars: { old_title: nil } }, created_at: now - 4.seconds)
+    triaged = board.events.create!(action: "card_triaged", creator: users(:david), eventable: card, particulars: { particulars: { column: "In Progress" } }, created_at: now - 5.seconds)
+    triaged_missing = board.events.create!(action: "card_triaged", creator: users(:david), eventable: card, particulars: {}, created_at: now - 6.seconds)
+    closed = board.events.create!(action: "card_closed", creator: users(:david), eventable: card, created_at: now - 7.seconds)
+    reopened = board.events.create!(action: "card_reopened", creator: users(:david), eventable: card, created_at: now - 8.seconds)
+    postponed = board.events.create!(action: "card_postponed", creator: users(:david), eventable: card, created_at: now - 9.seconds)
+    auto_postponed = board.events.create!(action: "card_auto_postponed", creator: users(:david), eventable: card, created_at: now - 10.seconds)
+    sent_back = board.events.create!(action: "card_sent_back_to_triage", creator: users(:david), eventable: card, created_at: now - 11.seconds)
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    by_id = @response.parsed_body.index_by { |item| item["id"] }
+
+    assert_equal({ "assignee_ids" => [ users(:kevin).id ] }, by_id.dig(unassigned.id, "particulars"))
+    assert_includes by_id.dig(unassigned.id, "description"), "unassigned yourself"
+    assert_equal({ "old_board" => "Inbox", "new_board" => "Writebook" }, by_id.dig(board_changed.id, "particulars"))
+    assert_equal({ "old_board" => "", "new_board" => "" }, by_id.dig(board_missing.id, "particulars"))
+    assert_equal({ "old_title" => "", "new_title" => "" }, by_id.dig(title_missing.id, "particulars"))
+    assert_equal({ "column" => "In Progress" }, by_id.dig(triaged.id, "particulars"))
+    assert_equal({ "column" => "" }, by_id.dig(triaged_missing.id, "particulars"))
+
+    [ published, closed, reopened, postponed, auto_postponed, sent_back ].each do |event|
+      assert_equal({}, by_id.dig(event.id, "particulars"), "Expected empty particulars for #{event.action}")
+    end
+  end
+
+  test "index scopes activity to boards the current user can access and current account" do
+    private_board = boards(:private)
+    assert_not users(:david).boards.include?(private_board)
+
+    private_event = nil
+    with_current_user(:kevin) do
+      private_card = private_board.cards.create!(title: "Secret Card", creator: users(:kevin), status: "published")
+      private_event = private_card.events.find_by!(action: "card_published")
+      private_event.update!(created_at: 1.minute.from_now)
+    end
+
+    other_account_event = Current.with_account(accounts(:initech)) do
+      with_current_user(:mike) do
+        boards(:miltons_wish_list).events.create!(
+          action: "card_published",
+          creator: users(:mike),
+          eventable: cards(:radio),
+          created_at: 2.minutes.from_now
+        )
+      end
+    end
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_includes @response.parsed_body.pluck("id"), private_event.id
+    assert_not_includes @response.parsed_body.pluck("id"), other_account_event.id
+
+    logout_and_sign_in_as :david
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+    assert_not_includes @response.parsed_body.pluck("id"), other_account_event.id
+
+    get activities_path(format: :json), params: { board_ids: [ private_board.id ] }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+
+    get activities_path(format: :json), params: { board_ids: [ private_board.id, boards(:writebook).id ] }
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |item| item.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "index filters by creator_ids and board_ids" do
+    private_board = boards(:private)
+    private_event = nil
+    with_current_user(:kevin) do
+      private_card = private_board.cards.create!(title: "Private Card", creator: users(:kevin), status: "published")
+      private_event = private_card.events.find_by!(action: "card_published")
+      private_event.update!(created_at: 1.minute.from_now)
+    end
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |item| item.dig("creator", "id") == users(:kevin).id }
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id, users(:david).id ] }
+    assert_response :success
+    creator_ids = @response.parsed_body.map { |item| item.dig("creator", "id") }.uniq
+    assert_includes creator_ids, users(:kevin).id
+    assert_includes creator_ids, users(:david).id
+
+    get activities_path(format: :json), params: { board_ids: [ private_board.id ] }
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+
+    get activities_path(format: :json), params: {
+      creator_ids: [ users(:david).id ],
+      board_ids: [ private_board.id ]
+    }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "index paginates results following API conventions" do
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    20.times do |i|
+      board.events.create!(
+        action: "card_closed",
+        creator: users(:kevin),
+        eventable: card,
+        created_at: i.minutes.from_now
+      )
+    end
+
+    expected_ids = Event
+      .where(board: users(:kevin).boards)
+      .where(action: ActivitiesController::ACTIVITY_ACTIONS)
+      .reverse_chronologically
+      .pluck(:id)
+
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+    assert_equal expected_ids.size.to_s, @response.headers["X-Total-Count"]
+  end
+
+  test "index updates cached descriptions for card title changes and viewer perspective" do
+    comment_event = events(:layout_commented)
+    comment_event.update!(created_at: 1.minute.from_now)
+    assignment_event = events(:layout_assignment_jz)
+    assignment_event.update!(created_at: 2.minutes.from_now)
+
+    previous_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache.lookup_store(:memory_store)
+
+    with_actionview_partial_caching do
+      get activities_path(format: :json)
+      assert_response :success
+      before_comment = @response.parsed_body.find { |item| item["id"] == comment_event.id }
+      before_assignment = @response.parsed_body.find { |item| item["id"] == assignment_event.id }
+      assert_includes before_comment["description"], "Layout is broken"
+      assert_includes before_assignment["description"], "David assigned JZ"
+
+      with_current_user(:david) do
+        cards(:layout).update!(title: "Layout is fixed")
+      end
+
+      get activities_path(format: :json)
+      assert_response :success
+      after_comment = @response.parsed_body.find { |item| item["id"] == comment_event.id }
+      assert_includes after_comment["description"], "Layout is fixed"
+
+      logout_and_sign_in_as :jz
+      get activities_path(format: :json)
+      assert_response :success
+      jz_assignment = @response.parsed_body.find { |item| item["id"] == assignment_event.id }
+      assert_includes jz_assignment["description"], "David will handle"
+    end
+  ensure
+    Rails.cache = previous_cache if defined?(previous_cache) && previous_cache
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
diff --git a/test/models/event/particulars_test.rb b/test/models/event/particulars_test.rb
new file mode 100644
index 0000000..8dbd192
--- /dev/null
+++ b/test/models/event/particulars_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "activity_particulars for assignment events" do
+    assigned = events(:logo_assignment_jz)
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, assigned.activity_particulars)
+
+    unassigned = Event.new(action: "card_unassigned", particulars: { assignee_ids: [ users(:kevin).id ] })
+    assert_equal({ assignee_ids: [ users(:kevin).id ] }, unassigned.activity_particulars)
+
