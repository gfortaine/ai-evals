+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,39 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = (User::DayTimeline::TIMELINEABLE_ACTIONS - %w[ card_collection_changed ] + %w[ card_title_changed ]).freeze
+
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from filtered_events
+      end
+    end
+  end
+
+  private
+    def filtered_events
+      events = Event
+        .preloaded_for_api
+        .where(board: filtered_boards)
+        .where(action: ACTIVITY_ACTIONS)
+        .reverse_chronologically
+
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events
+    end
+
+    def filtered_boards
+      if board_ids.present?
+        Current.user.boards.where(id: board_ids)
+      else
+        Current.user.boards
+      end
+    end
+
+    def board_ids
+      @board_ids ||= Array(params[:board_ids]).compact_blank
+    end
+
+    def creator_ids
+      @creator_ids ||= Array(params[:creator_ids]).compact_blank
+    end
+end
