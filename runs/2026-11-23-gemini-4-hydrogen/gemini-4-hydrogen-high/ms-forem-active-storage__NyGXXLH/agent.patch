diff --git a/spec/models/concerns/profile_imageable_spec.rb b/spec/models/concerns/profile_imageable_spec.rb
new file mode 100644
index 0000000..cafbcc6
--- /dev/null
+++ b/spec/models/concerns/profile_imageable_spec.rb
@@ -0,0 +1,242 @@
+require "rails_helper"
+require "exifr/jpeg"
+
+RSpec.describe ProfileImageable do
+  let(:image_jpg) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+  let(:image_png) { fixture_file_upload("800x600.png", "image/png") }
+  let(:image_pdf) { fixture_file_upload("800x600.pdf", "application/pdf") }
+  let(:image_with_gps) { fixture_file_upload("image_gps_data.jpg", "image/jpeg") }
+
+  describe "storage engine separation" do
+    it "stores new User profile images in Active Storage and ignores the legacy column", :aggregate_failures do
+      user = create(:user, profile_image: image_jpg)
+
+      expect(user.profile_image).to be_attached
+      expect(User.ignored_columns).to include("profile_image")
+      expect(User.uploaders).to be_empty
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/")
+      expect(user.profile_image_90).to eq(user.profile_image_url)
+    end
+
+    it "stores new Organization profile images in Active Storage and ignores the legacy column", :aggregate_failures do
+      organization = create(:organization, profile_image: image_png)
+
+      expect(organization.profile_image).to be_attached
+      expect(Organization.ignored_columns).to include("profile_image")
+      expect(Organization.uploaders.keys).to eq([:cover_image])
+      expect(organization.profile_image_url).to start_with("/rails/active_storage/blobs/")
+      expect(organization.profile_image_90).to eq(organization.profile_image_url)
+    end
+
+    it "keeps other uploaders on CarrierWave", :aggregate_failures do
+      expect(Tag.uploaders[:profile_image]).to eq(ProfileImageUploader)
+      expect(Organization.uploaders[:cover_image]).to eq(CoverImageUploader)
+      expect(Badge.uploaders[:badge_image]).to eq(BadgeUploader)
+      expect(Podcast.uploaders[:image]).to eq(ProfileImageUploader)
+    end
+  end
+
+  describe "CarrierWave retirement" do
+    it "does not fall back to legacy CarrierWave uploads for a User without an Active Storage attachment",
+       :aggregate_failures do
+      user = create(:user, profile_image: nil)
+      User.where(id: user.id).update_all(profile_image: "legacy-avatar.png")
+      user.reload
+
+      expect(user.profile_image).not_to be_attached
+      expect(user.profile_image_url).to be_nil
+      expect(user.profile_image_url_for(length: 90)).to eq(Images::Profile::BACKUP_LINK)
+      expect(user.as_json["profile_image"]).to eq("url" => nil)
+    end
+
+    it "requires an Active Storage attachment for Organization even if the legacy column is populated",
+       :aggregate_failures do
+      organization = create(:organization)
+      organization.profile_image.purge
+      Organization.where(id: organization.id).update_all(profile_image: "legacy-org.png")
+      organization.reload
+
+      expect(organization.profile_image).not_to be_attached
+      expect(organization.profile_image_url).to be_nil
+      expect(organization.valid?).to be(false)
+      expect(organization.errors[:profile_image]).to be_present
+    end
+
+    it "formats Active Storage URLs with the app domain in production" do
+      user = create(:user, profile_image: image_jpg)
+      allow(Rails).to receive(:env).and_return(ActiveSupport::StringInquirer.new("production"))
+      allow(URL).to receive_messages(domain: "forem.example.com", protocol: "https://")
+
+      expect(user.profile_image_url).to start_with("https://forem.example.com/rails/active_storage/blobs/")
+    end
+  end
+
+  describe "clearing profile_image" do
+    it "fails Organization presence validation when profile_image is cleared", :aggregate_failures do
+      organization = create(:organization)
