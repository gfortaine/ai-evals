diff --git a/spec/requests/profile_images_migration_spec.rb b/spec/requests/profile_images_migration_spec.rb
new file mode 100644
index 0000000..9662274
--- /dev/null
+++ b/spec/requests/profile_images_migration_spec.rb
@@ -0,0 +1,102 @@
+require "rails_helper"
+
+RSpec.describe "ProfileImagesActiveStorage" do
+  let(:user) { create(:user) }
+
+  describe "serving newly uploaded Active Storage profile pictures" do
+    it "serves the uploaded Active Storage blob from profile_image_url", :aggregate_failures do
+      uploaded = fixture_file_upload("800x600.png", "image/png")
+      expected_bytes = File.binread(uploaded.path)
+      sign_in user
+
+      patch profile_path(user), params: {
+        user: { profile_image: uploaded },
+        profile: {}
+      }
+
+      expect(response).to redirect_to(user_settings_path)
+      user.reload
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/")
+
+      get user.profile_image_url
+      expect(response).to have_http_status(:redirect)
+      follow_redirect!
+      expect(response).to have_http_status(:ok)
+      expect(response.body.b).to eq(expected_bytes)
+    end
+
+    it "serves newly uploaded Organization profile images via Active Storage", :aggregate_failures do
+      org_admin = create(:user, :org_admin)
+      organization = org_admin.organizations.first
+      uploaded = fixture_file_upload("800x600.jpg", "image/jpeg")
+      expected_bytes = File.binread(uploaded.path)
+      sign_in org_admin
+
+      put "/organizations/#{organization.id}", params: {
+        organization: { id: organization.id, profile_image: uploaded }
+      }
+
+      expect(response).to redirect_to("/settings/organization")
+      organization.reload
+      expect(organization.profile_image).to be_attached
+      expect(organization.profile_image_url).to start_with("/rails/active_storage/blobs/")
+
+      get organization.profile_image_url
+      expect(response).to have_http_status(:redirect)
+      follow_redirect!
+      expect(response).to have_http_status(:ok)
+      expect(response.body.b).to eq(expected_bytes)
+    end
+
+    it "returns profile_image.url in UsersController#update JSON response for onboarding", :aggregate_failures do
+      sign_in user
+      uploaded = fixture_file_upload("800x600.png", "image/png")
+
+      put "/users/#{user.id}", params: {
+        user: { profile_image: uploaded }
+      }, headers: { "Accept" => "application/json" }
+
+      expect(response).to have_http_status(:ok)
+      json = response.parsed_body
+      expect(json["success"]).to be(true)
+      expect(json.dig("user", "profile_image", "url")).to start_with("/rails/active_storage/blobs/")
+    end
+  end
+
+  describe "serving Active Storage profile pictures via API and profile pages" do
+    it "serves User Active Storage profile picture URLs on API and profile pages", :aggregate_failures do
+      get api_profile_image_path(user.username)
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(user.profile_image_url)
+      expect(response.parsed_body["profile_image_90"]).to eq(user.profile_image_url)
+
+      get "/#{user.username}"
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(user.profile_image_url)
+    end
+
+    it "serves Organization Active Storage profile picture URLs on API and org pages", :aggregate_failures do
+      organization = create(:organization)
+
+      get api_profile_image_path(organization.username)
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(organization.profile_image_url)
+      expect(response.parsed_body["profile_image_90"]).to eq(organization.profile_image_url)
+
+      get "/#{organization.slug}"
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(organization.profile_image_url)
+    end
+
+    it "does not serve retired CarrierWave uploads when no Active Storage attachment exists", :aggregate_failures do
+      legacy_user = create(:user, profile_image: nil)
+      User.where(id: legacy_user.id).update_all(profile_image: "existing-avatar.png")
+
+      get api_profile_image_path(legacy_user.username)
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(Images::Profile::BACKUP_LINK)
+      expect(response.parsed_body["profile_image_90"]).to eq(Images::Profile::BACKUP_LINK)
+    end
+  end
+end
