--- /dev/null
+++ b/lib/tasks/profile_images.rake
@@ -0,0 +1,8 @@
+namespace :profile_images do
+  desc "Copy existing CarrierWave profile images for users and organizations into Active Storage"
+  task copy: :environment do
+    result = Images::CopyProfileImagesToActiveStorage.call
+    puts "Profile images copy complete: copied=#{result.copied}, skipped=#{result.skipped}, failed=#{result.failed}"
+    raise "Failed to copy #{result.failed} profile image(s)" if result.failed.positive?
+  end
+end
