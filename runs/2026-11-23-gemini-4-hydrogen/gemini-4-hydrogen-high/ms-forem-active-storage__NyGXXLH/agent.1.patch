@@ -0,0 +1,99 @@
+require "rails_helper"
+
+RSpec.describe "ProfileImagesMigration" do
+  let(:user) { create(:user) }
+
+  describe "serving newly uploaded Active Storage profile pictures" do
+    it "serves the uploaded Active Storage blob from profile_image_url", :aggregate_failures do
+      uploaded = fixture_file_upload("800x600.png", "image/png")
+      expected_bytes = File.binread(uploaded.path)
+      sign_in user
+
+      patch profile_path(user), params: {
+        user: { profile_image: uploaded },
+        profile: {}
+      }
+
+      expect(response).to redirect_to(user_settings_path)
+      user.reload
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/")
+
+      get user.profile_image_url
+      expect(response).to have_http_status(:redirect)
+      follow_redirect!
+      expect(response).to have_http_status(:ok)
+      expect(response.body.b).to eq(expected_bytes)
+    end
+
+    it "serves newly uploaded Organization profile images via Active Storage", :aggregate_failures do
+      org_admin = create(:user, :org_admin)
+      organization = org_admin.organizations.first
+      uploaded = fixture_file_upload("800x600.jpg", "image/jpeg")
+      expected_bytes = File.binread(uploaded.path)
+      sign_in org_admin
+
+      put "/organizations/#{organization.id}", params: {
+        organization: { id: organization.id, profile_image: uploaded }
+      }
+
+      expect(response).to redirect_to("/settings/organization")
+      organization.reload
+      expect(organization.profile_image).to be_attached
+      expect(organization.profile_image_url).to start_with("/rails/active_storage/blobs/")
+
+      get organization.profile_image_url
+      expect(response).to have_http_status(:redirect)
+      follow_redirect!
+      expect(response).to have_http_status(:ok)
+      expect(response.body.b).to eq(expected_bytes)
+    end
+
+    it "returns profile_image.url in UsersController#update JSON response for onboarding", :aggregate_failures do
+      sign_in user
+      uploaded = fixture_file_upload("800x600.png", "image/png")
+
+      put "/users/#{user.id}", params: {
+        user: { profile_image: uploaded }
+      }, headers: { "Accept" => "application/json" }
+
+      expect(response).to have_http_status(:ok)
+      json = response.parsed_body
+      expect(json["success"]).to be(true)
+      expect(json.dig("user", "profile_image", "url")).to start_with("/rails/active_storage/blobs/")
+    end
+  end
+
+  describe "serving existing CarrierWave profile pictures via API and pages" do
+    it "continues to return legacy CarrierWave URLs for User on API and profile pages", :aggregate_failures do
+      legacy_user = create(:user, profile_image: nil)
+      legacy_user.update_column(:profile_image, "existing-avatar.png")
+      expected_url = "/uploads/user/profile_image/#{legacy_user.id}/existing-avatar.png"
+
+      get api_profile_image_path(legacy_user.username)
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(expected_url)
+      expect(response.parsed_body["profile_image_90"]).to eq(expected_url)
+
+      get "/#{legacy_user.username}"
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(expected_url)
+    end
+
+    it "continues to return legacy CarrierWave URLs for Organization on API and org pages", :aggregate_failures do
+      legacy_org = create(:organization)
+      legacy_org.profile_image.purge
+      legacy_org.update_column(:profile_image, "existing-org.png")
+      expected_url = "/uploads/organization/profile_image/#{legacy_org.id}/existing-org.png"
+
+      get api_profile_image_path(legacy_org.username)
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(expected_url)
+      expect(response.parsed_body["profile_image_90"]).to eq(expected_url)
+
+      get "/#{legacy_org.slug}"
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(expected_url)
+    end
+  end
+end
