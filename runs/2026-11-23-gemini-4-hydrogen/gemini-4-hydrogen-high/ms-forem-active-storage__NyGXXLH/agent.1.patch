diff --git a/spec/models/concerns/profile_imageable_spec.rb b/spec/models/concerns/profile_imageable_spec.rb
new file mode 100644
index 0000000..d863699
--- /dev/null
+++ b/spec/models/concerns/profile_imageable_spec.rb
@@ -0,0 +1,233 @@
+require "rails_helper"
+require "exifr/jpeg"
+
+RSpec.describe ProfileImageable do
+  let(:image_jpg) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+  let(:image_png) { fixture_file_upload("800x600.png", "image/png") }
+  let(:image_pdf) { fixture_file_upload("800x600.pdf", "application/pdf") }
+  let(:image_with_gps) { fixture_file_upload("image_gps_data.jpg", "image/jpeg") }
+
+  describe "storage engine separation" do
+    it "stores new User profile images in Active Storage and leaves legacy column nil", :aggregate_failures do
+      user = create(:user, profile_image: image_jpg)
+
+      expect(user.profile_image).to be_attached
+      expect(user.read_attribute(:profile_image)).to be_nil
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/")
+      expect(user.profile_image_90).to eq(user.profile_image_url)
+    end
+
+    it "stores new Organization profile images in Active Storage and leaves legacy column nil", :aggregate_failures do
+      organization = create(:organization, profile_image: image_png)
+
+      expect(organization.profile_image).to be_attached
+      expect(organization.read_attribute(:profile_image)).to be_nil
+      expect(organization.profile_image_url).to start_with("/rails/active_storage/blobs/")
+      expect(organization.profile_image_90).to eq(organization.profile_image_url)
+    end
+
+    it "keeps other uploaders on CarrierWave", :aggregate_failures do
+      expect(Tag.uploaders[:profile_image]).to eq(ProfileImageUploader)
+      expect(Organization.uploaders[:cover_image]).to eq(CoverImageUploader)
+      expect(Badge.uploaders[:badge_image]).to eq(BadgeUploader)
+      expect(Podcast.uploaders[:image]).to eq(ProfileImageUploader)
+    end
+  end
+
+  describe "legacy CarrierWave fallback (dual-read)" do
+    it "serves existing CarrierWave profile_image_url for a User without an Active Storage attachment",
+       :aggregate_failures do
+      user = create(:user, profile_image: nil)
+      user.update_column(:profile_image, "legacy-avatar.png")
+      user.reload
+
+      expect(user.profile_image).not_to be_attached
+      expect(user.profile_image_url).to eq("/uploads/user/profile_image/#{user.id}/legacy-avatar.png")
+      expect(user.profile_image_url_for(length: 90)).to eq(user.profile_image_url)
+      expect(user.as_json["profile_image"]).to eq("url" => user.profile_image_url)
+    end
+
+    it "serves existing CarrierWave profile_image_url for an Organization without an Active Storage attachment",
+       :aggregate_failures do
+      organization = create(:organization)
+      organization.profile_image.purge
+      organization.update_column(:profile_image, "legacy-org.png")
+      organization.reload
+
+      expect(organization.profile_image).not_to be_attached
+      expect(organization.profile_image_url).to eq(
+        "/uploads/organization/profile_image/#{organization.id}/legacy-org.png",
+      )
+      expect(organization.valid?).to be(true)
+      expect(organization.update(name: "Updated Legacy Org")).to be(true)
+    end
+
+    it "prefers Active Storage over legacy CarrierWave column once a new picture is uploaded", :aggregate_failures do
+      user = create(:user, profile_image: nil)
+      user.update_column(:profile_image, "legacy-avatar.png")
+      user.reload
+
+      expect(user.profile_image_url).to eq("/uploads/user/profile_image/#{user.id}/legacy-avatar.png")
+
+      user.update!(profile_image: image_png)
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/")
+      expect(user.read_attribute(:profile_image)).to eq("legacy-avatar.png")
+    end
+
+    it "formats Active Storage URLs with the app domain in production" do
+      user = create(:user, profile_image: image_jpg)
+      allow(Rails).to receive(:env).and_return(ActiveSupport::StringInquirer.new("production"))
+      allow(URL).to receive_messages(domain: "forem.example.com", protocol: "https://")
+
+      expect(user.profile_image_url).to start_with("https://forem.example.com/rails/active_storage/blobs/")
+    end
+  end
+
+  describe "clearing profile_image" do
+    it "fails Organization presence validation even when legacy column is present", :aggregate_failures do
+      organization = create(:organization)
+      organization.profile_image.purge
+      organization.update_column(:profile_image, "legacy-org.png")
+      organization.reload
+
+      organization.assign_attributes(profile_image: "")
+      expect(organization.valid?).to be(false)
+      expect(organization.errors[:profile_image]).to be_present
+    end
+
+    it "clears both Active Storage and legacy column on User when explicitly set to nil", :aggregate_failures do
+      user = create(:user, profile_image: image_jpg)
+      user.update_column(:profile_image, "legacy-avatar.png")
+      user.reload
+
+      user.update!(profile_image: nil)
+      expect(user.profile_image).not_to be_attached
+      expect(user.read_attribute(:profile_image)).to be_nil
+      expect(user.profile_image_url).to be_nil
+    end
+  end
+
+  describe "string assignment handling" do
+    it "attaches an Active Storage blob when given a valid signed_id" do
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: image_jpg.open,
+        filename: "signed.jpg",
+        content_type: "image/jpeg",
+      )
+      user = create(:user, profile_image: blob.signed_id)
+
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image.blob).to eq(blob)
+    end
+
+    it "ignores non-signed URL strings without raising InvalidSignature" do
+      user = build(:user, profile_image: Settings::General.mascot_image_url)
+      expect(user.valid?).to be(true)
+      expect(user.profile_image).not_to be_attached
+    end
+  end
+
+  describe "remote_profile_image_url=" do
+    it "downloads and attaches remote image to Active Storage", :aggregate_failures do
+      url = "https://example.com/avatar.png"
+      stub_request(:get, url).to_return(
+        status: 200,
+        body: File.binread(image_png.path),
+        headers: { "Content-Type" => "image/png" },
+      )
+
+      user = create(:user, profile_image: nil, remote_profile_image_url: url)
+
+      expect(user.profile_image).to be_attached
+      expect(user.remote_profile_image_url).to eq(url)
+      expect(user.profile_image.filename.to_s).to eq("avatar.png")
+    end
+
+    it "adds a validation error when remote download fails", :aggregate_failures do
+      url = "https://example.com/missing.png"
+      stub_request(:get, url).to_return(status: 404, body: "")
+
+      user = build(:user, profile_image: nil, remote_profile_image_url: url)
+
+      expect(user.valid?).to be(false)
+      expect(user.errors[:profile_image]).to be_present
+    end
+
+    it "attaches a File when passed a File (e.g. from SafeRemoteProfileImageUrl)" do
+      file = Images::SafeRemoteProfileImageUrl.call(nil)
+      user = create(:user, profile_image: nil, remote_profile_image_url: file)
+
+      expect(user.profile_image).to be_attached
+    ensure
+      file&.close
+    end
+  end
+
+  describe "validations" do
+    it "rejects unsupported formats like pdf", :aggregate_failures do
+      user = build(:user, profile_image: image_pdf)
+
+      expect(user.valid?).to be(false)
+      expect(user.errors[:profile_image]).to be_present
+    end
+
+    it "rejects images larger than MAX_FILE_SIZE", :aggregate_failures do
+      stub_const("ProfileImageUploader::MAX_FILE_SIZE", 2.megabytes)
+      large_image = fixture_file_upload("large_profile_img.jpg", "image/jpeg")
+      user = build(:user, profile_image: large_image)
+
+      expect(user.valid?).to be(false)
+      expect(user.errors.full_messages).to include("Profile image File size should be less than 2 MB")
+    end
+
+    it "rejects images exceeding max pixel dimensions", :aggregate_failures do
+      allow(FastImage).to receive(:size).and_return([5000, 5000])
+      user = build(:user, profile_image: image_jpg)
+
+      expect(user.valid?).to be(false)
+      expect(user.errors[:profile_image]).to be_present
+    end
+  end
+
+  describe "EXIF removal" do
+    before { ProfileImageUploader.enable_processing = true }
+    after { ProfileImageUploader.enable_processing = false }
+
+    it "strips EXIF and GPS data when saving to Active Storage", :aggregate_failures do
+      expect(EXIFR::JPEG.new(image_with_gps.path).exif?).to be(true)
+      expect(EXIFR::JPEG.new(image_with_gps.path).gps.present?).to be(true)
+
+      user = create(:user, profile_image: image_with_gps)
+      downloaded = Tempfile.new(["downloaded", ".jpg"])
+      downloaded.binmode
+      downloaded.write(user.profile_image.download)
+      downloaded.flush
+
+      expect(EXIFR::JPEG.new(downloaded.path).exif?).to be(false)
+      expect(EXIFR::JPEG.new(downloaded.path).gps.present?).to be(false)
+    ensure
+      downloaded&.close!
+    end
+  end
+
+  describe "callbacks on Active Storage profile image changes" do
+    it "busts profile image cache when a User uploads a new Active Storage picture" do
+      user = create(:user)
+
+      sidekiq_assert_enqueued_with(job: Users::BustProfileImageCacheWorker, args: [user.id]) do
+        user.update!(profile_image: image_png)
+      end
+    end
+
+    it "triggers social image generation when a User uploads a new Active Storage picture" do
+      user = create(:user)
+      create(:article, user: user)
+      allow(Images::SocialImageWorker).to receive(:perform_async)
+
+      user.update!(profile_image: image_png)
+
+      expect(Images::SocialImageWorker).to have_received(:perform_async).with(user.id, "User")
+    end
+  end
+end
