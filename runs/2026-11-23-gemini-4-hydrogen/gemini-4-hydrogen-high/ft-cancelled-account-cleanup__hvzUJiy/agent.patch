diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..2d11041 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,48 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    suppress_turbo_broadcasts do
+      destroy!
+    end
+
+    purge_blobs
+    clean_search_records
+  end
+
+  def due_for_incineration?
+    cancellation&.persisted? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+  end
+
+  private
+    def suppress_turbo_broadcasts(&block)
+      Board.suppressing_turbo_broadcasts do
+        Card.suppressing_turbo_broadcasts do
+          Notification.suppressing_turbo_broadcasts do
+            Account::Import.suppressing_turbo_broadcasts(&block)
+          end
+        end
+      end
+    end
+
+    def purge_blobs
+      ActiveStorage::VariantRecord.where(account_id: id).find_each(&:destroy)
+      ActiveStorage::Blob.where(account_id: id).find_each(&:purge)
+    end
+
+    def clean_search_records
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy)
+    end
 end
