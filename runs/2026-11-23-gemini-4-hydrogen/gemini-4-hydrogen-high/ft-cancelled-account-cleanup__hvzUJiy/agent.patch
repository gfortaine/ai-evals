diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..f7dba95
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts canceled more than 30 days ago" do
+    due_account = accounts("37s")
+    recent_account = accounts(:initech)
+    active_account = accounts(:acme)
+
+    due_account.cancel(initiated_by: users(:david))
+    due_account.cancellation.update_columns(created_at: 31.days.ago)
+
+    recent_account.cancel(initiated_by: users(:mike))
+    recent_account.cancellation.update_columns(created_at: 15.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(recent_account.id)
+    assert Account.exists?(active_account.id)
+  end
+
+  test "job is queued to backend queue" do
+    assert_equal "backend", Account::IncinerateDueJob.new.queue_name
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..cbe10d3
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,140 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration includes accounts canceled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.second).ago)
+
+    assert_includes Account.due_for_incineration, @account
+    assert @account.due_for_incineration?
+  end
+
+  test "due_for_incineration excludes active accounts" do
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.due_for_incineration?
+  end
+
+  test "due_for_incineration excludes accounts canceled within the grace period" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago)
+
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.due_for_incineration?
+  end
+
+  test "due_for_incineration excludes accounts canceled exactly 30 days ago" do
+    freeze_time do
+      @account.cancel(initiated_by: @user)
+      @account.cancellation.update_columns(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago)
+
+      assert_not_includes Account.due_for_incineration, @account
+      assert_not @account.due_for_incineration?
+    end
+  end
+
+  test "due_for_incineration excludes reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 40.days.ago)
+    @account.reactivate
+    @account.reload
+
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.due_for_incineration?
+  end
+
+  test "incinerate permanently removes the account and all associated data" do
+    other_account = accounts(:initech)
+    shared_identity = @user.identity
+    account_id = @account.id
+
+    Current.with_account(@account) do
+      Current.user = @user
+      @user.avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg")
+      @user.avatar_thumbnail.processed
+
+      card = cards(:logo)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "card.jpg", content_type: "image/jpeg")
+      embed_blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "embed.jpg", content_type: "image/jpeg")
+      card.update!(description: "<p>Hello #{ActionText::Attachment.from_attachable(embed_blob).to_html}</p>")
+      card.comments.create!(creator: @user, body: "A comment")
+
+      # Unattached blob
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("orphan"), filename: "orphan.txt", content_type: "text/plain")
+
+      @account.materialize_storage
+      boards(:writebook).materialize_storage
+      @account.imports.create!(identity: shared_identity)
+      @account.cancel(initiated_by: @user)
+    end
+
+    board_ids = @account.boards.ids
+    filter_ids = Filter.where(account_id: account_id).ids
+    blob_keys = ActiveStorage::Blob.where(account_id: account_id).pluck(:key)
+    assert blob_keys.any?
+
+    perform_enqueued_jobs do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(account_id)
+    assert_empty User.where(account_id: account_id)
+    assert_empty Board.where(account_id: account_id)
+    assert_empty Card.where(account_id: account_id)
+    assert_empty Comment.where(account_id: account_id)
+    assert_empty Event.where(account_id: account_id)
+    assert_empty Notification.where(account_id: account_id)
+    assert_empty Notification::Bundle.where(account_id: account_id)
+    assert_empty Mention.where(account_id: account_id)
+    assert_empty Tag.where(account_id: account_id)
+    assert_empty Tagging.where(account_id: account_id)
+    assert_empty Column.where(account_id: account_id)
+    assert_empty Entropy.where(account_id: account_id)
+    assert_empty Webhook.where(account_id: account_id)
+    assert_empty Webhook::Delivery.where(account_id: account_id)
+    assert_empty Webhook::DelinquencyTracker.where(account_id: account_id)
+    assert_empty Filter.where(account_id: account_id)
+    assert_empty Export.where(account_id: account_id)
+    assert_empty Account::Import.where(account_id: account_id)
+    assert_empty Account::JoinCode.where(account_id: account_id)
+    assert_empty Account::Cancellation.where(account_id: account_id)
+    assert_empty Storage::Entry.where(account_id: account_id)
+    assert_empty Storage::Total.where(owner_id: [ account_id, *board_ids ])
+    assert_empty ActionText::RichText.where(account_id: account_id)
+    assert_empty ActiveStorage::Attachment.where(account_id: account_id)
+    assert_empty ActiveStorage::VariantRecord.where(account_id: account_id)
+    assert_empty ActiveStorage::Blob.where(account_id: account_id)
+    assert_empty Search::Record.for(account_id).where(account_id: account_id)
+
+    blob_keys.each do |key|
+      assert_not ActiveStorage::Blob.service.exist?(key)
+    end
+
+    # Shared identity and other accounts are preserved
+    assert Identity.exists?(shared_identity.id)
+    assert Account.exists?(other_account.id)
+    assert other_account.users.exists?
+  end
+
+  test "incinerate_due only incinerates accounts canceled more than 30 days ago" do
+    due_account = accounts("37s")
+    recent_account = accounts(:initech)
+    active_account = accounts(:acme)
+
+    due_account.cancel(initiated_by: users(:david))
+    due_account.cancellation.update_columns(created_at: 31.days.ago)
+
+    recent_account.cancel(initiated_by: users(:mike))
+    recent_account.cancellation.update_columns(created_at: 29.days.ago)
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(recent_account.id)
+    assert Account.exists?(active_account.id)
+  end
+end
