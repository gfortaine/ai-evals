@@ -0,0 +1,77 @@
+require "test_helper"
+require "open3"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  test "runner broadcasts report to stdout and preserves log file output" do
+    log_path = Rails.root.join("log/test.log")
+    offset = log_path.exist? ? log_path.size : 0
+
+    stdout, stderr, status = Open3.capture3(
+      { "LOG_LEVEL" => "info" },
+      Rails.root.join("bin/rails").to_s, "runner", "-e", "test", "script/library_report.rb"
+    )
+
+    assert status.success?, "Expected runner to exit 0, stderr: #{stderr}"
+
+    lines = stdout.lines(chomp: true)
+    assert_match(/\ALibrary report: \d+ books\z/, lines.first)
+    assert_equal "Library report: done", lines.last
+
+    logged = log_path.binread(nil, offset)
+    lines.each do |line|
+      assert_includes logged, "#{line}\n"
+    end
+  end
+
+  test "runner broadcasts report lines with matching levels" do
+    original_logger = Rails.logger
+    file_io = StringIO.new
+    file_logger = ActiveSupport::TaggedLogging.new(ActiveSupport::Logger.new(file_io))
+    file_logger.level = ActiveSupport::Logger::INFO
+    Rails.logger = ActiveSupport::BroadcastLogger.new(file_logger)
+
+    out, = capture_io do
+      Rails.application.load_runner
+      load Rails.root.join("script/library_report.rb")
+    end
+
+    books = Book.order(:id).to_a
+    expected_lines = [ "Library report: #{books.size} books" ]
+    books.each do |book|
+      pages = book.leaves.count
+      if pages.zero?
+        expected_lines << "Library report: #{book.title} has no pages"
+      else
+        expected_lines << "Library report: #{book.title} has #{pages} #{"page".pluralize(pages)}"
+      end
+    end
+    expected_lines << "Library report: done"
+
+    assert_equal expected_lines, out.lines(chomp: true)
+    assert_equal expected_lines, file_io.string.lines(chomp: true)
+  ensure
+    Rails.logger = original_logger
+  end
+
+  test "runner respects raised log level on both stdout and file logger" do
+    original_logger = Rails.logger
+    file_io = StringIO.new
+    file_logger = ActiveSupport::TaggedLogging.new(ActiveSupport::Logger.new(file_io))
+    file_logger.level = ActiveSupport::Logger::WARN
+    Rails.logger = ActiveSupport::BroadcastLogger.new(file_logger)
+
+    warn_out, = capture_io do
+      Rails.application.load_runner
+      load Rails.root.join("script/library_report.rb")
+    end
+
+    expected_warn_lines = Book.order(:id).select { |b| b.leaves.count.zero? }.map do |book|
+      "Library report: #{book.title} has no pages"
+    end
+
+    assert_equal expected_warn_lines, warn_out.lines(chomp: true)
+    assert_equal expected_warn_lines, file_io.string.lines(chomp: true)
+  ensure
+    Rails.logger = original_logger
+  end
+end
