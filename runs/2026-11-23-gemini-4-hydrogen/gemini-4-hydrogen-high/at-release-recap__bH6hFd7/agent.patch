index 0000000..e342b34
--- /dev/null
+++ b/test/controllers/books/releases_controller_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @book = books(:manual)
+    sign_in :david
+  end
+
+  test "edit renders release form" do
+    get edit_book_release_path(@book)
+
+    assert_response :success
+    assert_in_body "Release this book"
+  end
+
+  test "update releases book and updates Recently updated list with the new title" do
+    with_memory_cache do
+      patch book_release_path(@book), params: { book: { title: "Published Edition", subtitle: "First printing" } }
+
+      assert_redirected_to root_path
+      follow_redirect!
+
+      assert_response :success
+      assert_select ".library__recents strong", text: "Published Edition"
+      assert_select ".library__recents span", text: "Published"
+      assert_select ".library__recents strong", text: "Manual", count: 0
+    end
+  end
+
+  test "update redirects to book when book is already published" do
+    @book.update!(published: true)
+
+    patch book_release_path(@book), params: { book: { title: "New Title" } }
+
+    assert_redirected_to book_slug_path(@book)
+    assert_equal "Manual", @book.reload.title
+  end
+
+  test "non-editor cannot access release actions" do
+    sign_in :jz
+
+    get edit_book_release_path(@book)
+    assert_response :forbidden
+
+    patch book_release_path(@book), params: { book: { title: "Unauthorized Title" } }
+    assert_response :forbidden
+    assert_equal "Manual", @book.reload.title
+  end
+
+  private
+    def with_memory_cache
+      original_cache = Rails.cache
+      Rails.cache = ActiveSupport::Cache::MemoryStore.new
+      yield
+    ensure
+      Rails.cache = original_cache
+    end
+end
diff --git a/test/models/book/recap_test.rb b/test/models/book/recap_test.rb
new file mode 100644
index 0000000..d095783
--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  test "recaps are cached per book without overwriting one another" do
+    with_memory_cache do
+      handbook = books(:handbook)
+      manual = books(:manual)
+
+      handbook.update!(title: "Updated Handbook", published: true)
+      manual.update!(title: "Updated Manual", published: false)
+
+      assert_equal({ title: "Updated Handbook", published: true }, handbook.cached_recap)
+      assert_equal({ title: "Updated Manual", published: false }, manual.cached_recap)
+    end
+  end
+
+  test "recaps expire on the configured schedule" do
+    with_memory_cache do
+      book = books(:handbook)
+      book.update!(title: "Fresh Title")
+
+      assert_equal({ title: "Fresh Title", published: false }, book.cached_recap)
+
+      travel Rails.application.config.x.recap.expires_in - 1.minute do
+        assert_equal({ title: "Fresh Title", published: false }, book.cached_recap)
+      end
+
+      travel Rails.application.config.x.recap.expires_in + 1.second do
+        assert_nil book.cached_recap
+      end
+    end
+  end
+
+  test "write_recap records committed attributes even when multiple instances update in a transaction" do
+    with_memory_cache do
+      first = books(:manual)
+      second = Book.find(first.id)
+
+      Book.transaction do
+        first.update!(title: "Committed Title")
+        second.update!(published: true)
+      end
+
+      assert_equal({ title: "Committed Title", published: true }, first.cached_recap)
+    end
+  end
+
+  private
+    def with_memory_cache
+      original_cache = Rails.cache
+      Rails.cache = ActiveSupport::Cache::MemoryStore.new
+      yield
+    ensure
+      Rails.cache = original_cache
+    end
+end
diff --git a/test/models/book/release_test.rb b/test/models/book/release_test.rb
new file mode 100644
index 0000000..9402fc2
--- /dev/null
+++ b/test/models/book/release_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Book::ReleaseTest < ActiveSupport::TestCase
+  test "finalize_release updates title, subtitle, published status, and recap cache" do
+    with_memory_cache do
+      book = books(:manual)
+      book.update!(subtitle: "Draft subtitle")
+
+      assert Book.finalize_release(book.id, title: "Published Manual", subtitle: "Final subtitle")
+
+      book.reload
+      assert_equal "Published Manual", book.title
+      assert_equal "Final subtitle", book.subtitle
+      assert book.published?
+      assert_equal({ title: "Published Manual", published: true }, book.cached_recap)
+    end
+  end
+
+  test "finalize_release preserves existing subtitle when subtitle is nil" do
+    book = books(:manual)
+    book.update!(subtitle: "Original subtitle")
+
+    assert Book.finalize_release(book.id, title: "Published Manual")
+
+    assert_equal "Original subtitle", book.reload.subtitle
+  end
+
+  test "finalize_release returns false for an already published book" do
+    book = books(:manual)
+    book.update!(published: true)
+
+    assert_not Book.finalize_release(book.id, title: "Different Title")
+    assert_equal "Manual", book.reload.title
+  end
+
+  test "ReleaseMarker.for works with a book id" do
+    draft = books(:manual)
+    published = books(:handbook)
+    published.update!(published: true)
+
+    assert_nil ReleaseMarker.for(published.id)
+
+    marker = ReleaseMarker.for(draft.id)
+    assert_not_nil marker
+    marker.publish!
+    assert draft.reload.published?
+  end
+
+  private
+    def with_memory_cache
+      original_cache = Rails.cache
+      Rails.cache = ActiveSupport::Cache::MemoryStore.new
+      yield
+    ensure
+      Rails.cache = original_cache
+    end
+end
