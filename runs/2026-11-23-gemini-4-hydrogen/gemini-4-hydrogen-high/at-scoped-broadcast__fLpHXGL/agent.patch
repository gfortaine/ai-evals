+
+  test "update does not broadcast being edited indicator to a collaborator downgraded to reader" do
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+
+    get edit_book_page_path(book, leaf)
+    assert_response :success
+
+    signed_stream_name = css_select("turbo-cable-stream-source").first["signed-stream-name"]
+    kevin_stream = Turbo::StreamsChannel.verified_stream_name(signed_stream_name)
+
+    book.access_for(user: users(:kevin)).update!(level: :reader)
+
+    sign_in :david
+    perform_enqueued_jobs do
+      patch book_page_path(book, leaf), params: { page: { body: "Updated body" } }
+      assert_response :no_content
+    end
+
+    assert_no_turbo_stream_broadcasts kevin_stream
+    assert_turbo_stream_broadcasts [ leaf, :being_edited, users(:jason) ], count: 1
+  end
+
+  test "update does not broadcast to collaborator removed before broadcast job runs" do
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+
+    get edit_book_page_path(book, leaf)
+    assert_response :success
+    signed_stream_name = css_select("turbo-cable-stream-source").first["signed-stream-name"]
+    kevin_stream = Turbo::StreamsChannel.verified_stream_name(signed_stream_name)
+
+    sign_in :david
+    patch book_page_path(book, leaf), params: { page: { body: "Updated body" } }
+    assert_response :no_content
+
+    book.update!(everyone_access: false)
+    book.update_access(editors: [ users(:david).id, users(:jason).id ], readers: [])
+
+    perform_enqueued_jobs
+
+    assert_no_turbo_stream_broadcasts kevin_stream
+    assert_turbo_stream_broadcasts [ leaf, :being_edited, users(:jason) ], count: 1
+  end
 end
