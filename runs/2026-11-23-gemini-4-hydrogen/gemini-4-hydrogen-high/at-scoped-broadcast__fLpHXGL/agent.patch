+    kevin_stream = Turbo::StreamsChannel.verified_stream_name(signed_stream_name)
+
+    book.update!(everyone_access: false)
+    book.update_access(editors: [ users(:david).id, users(:jason).id ], readers: [])
+
+    sign_in :david
+    perform_enqueued_jobs do
+      patch book_page_path(book, leaf), params: { page: { body: "Updated body" } }
+      assert_response :no_content
+    end
+
+    assert_no_turbo_stream_broadcasts kevin_stream
+    assert_turbo_stream_broadcasts [ leaf, :being_edited, users(:jason) ], count: 1
