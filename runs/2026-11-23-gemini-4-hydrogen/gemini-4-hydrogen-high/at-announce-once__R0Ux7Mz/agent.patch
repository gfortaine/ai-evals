diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..cd97a92
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,139 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+  end
+
+  test "going live announces once" do
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ] do
+      assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+        @book.update!(published: true)
+      end
+    end
+  end
+
+  test "going live and adding a page in the same sitting announces once" do
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ] do
+      assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+        @book.transaction do
+          @book.update!(published: true)
+          @book.press Page.new(body: ""), title: "New Page"
+        end
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "going live and updating multiple times in the same sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.update!(slug: "updated-slug")
+      end
+    end
+  end
+
+  test "taking a live book down does not announce" do
+    @book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update!(published: false)
+    end
+  end
+
+  test "saving an already-live book again does not announce" do
+    @book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true, slug: "still-live")
+        @book.press Page.new(body: ""), title: "Extra Page"
+      end
+    end
+  end
+
+  test "saving a draft book without going live does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(slug: "still-draft")
+        @book.press Page.new(body: ""), title: "Draft Page"
+      end
+    end
+  end
+
+  test "draft marked live then back to draft in the same sitting does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.update!(published: false)
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "already-live book taken down then back up in the same sitting does not announce" do
+    @book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: false)
+        @book.update!(published: true)
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "failed sitting after marking book live leaves a draft and no announcement" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises RuntimeError do
+        @book.transaction do
+          @book.update!(published: true)
+          raise "something went wrong"
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update!(published: true)
+    end
+  end
+
+  test "creating a book already live announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.create!(title: "Freshly Published", published: true)
+    end
+  end
+
+  test "nested savepoint rollback does not cancel outer publication announcement" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        Book.transaction(requires_new: true) do
+          @book.update!(published: false)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "two instances of the same book in one sitting announce once when going live" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        first = Book.find(@book.id)
+        second = Book.find(@book.id)
+        first.update!(published: true)
+        second.update!(slug: "reloaded-slug")
+      end
+    end
+  end
+end
