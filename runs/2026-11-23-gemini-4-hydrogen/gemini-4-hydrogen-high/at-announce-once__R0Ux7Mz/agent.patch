diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..6124a04 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,48 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_save :track_publication_for_announcement
+    before_commit :detach_publication_tracker
   end
 
   private
-    def announce_publication
-      AnnouncePublicationJob.perform_later self
+    def track_publication_for_announcement
+      was_published = previously_new_record? ? false : published_before_last_save
+      book_id = id
+
+      tracker = (ActiveSupport::IsolatedExecutionState[:book_announceable_tracker] ||= { pending: 0, initial_published: {} })
+      tracker[:pending] += 1
+
+      tx = self.class.current_transaction
+
+      tx.after_commit do
+        tracker[:initial_published][book_id] = was_published unless tracker[:initial_published].key?(book_id)
+        tracker[:pending] -= 1
+
+        if tracker[:pending].zero?
+          if ActiveSupport::IsolatedExecutionState[:book_announceable_tracker].equal?(tracker)
+            ActiveSupport::IsolatedExecutionState[:book_announceable_tracker] = nil
+          end
+
+          tracker[:initial_published].each do |id, was_pub|
+            next if was_pub
+            if (book = Book.published.find_by(id: id))
+              AnnouncePublicationJob.perform_later(book)
+            end
+          end
+        end
+      end
+
+      tx.after_rollback do
+        tracker[:pending] -= 1
+
+        if tracker[:pending].zero? && ActiveSupport::IsolatedExecutionState[:book_announceable_tracker].equal?(tracker)
+          ActiveSupport::IsolatedExecutionState[:book_announceable_tracker] = nil
+        end
+      end
+    end
+
+    def detach_publication_tracker
+      ActiveSupport::IsolatedExecutionState[:book_announceable_tracker] = nil
     end
 end
