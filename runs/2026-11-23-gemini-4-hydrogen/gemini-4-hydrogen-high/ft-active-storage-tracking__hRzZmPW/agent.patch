+++ b/app/jobs/storage/cleanup_job.rb
@@ -0,0 +1,16 @@
+class Storage::CleanupJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account, record_type, record_id)
+    case record_type
+    when "Board"
+      Storage::Entry.cleanup_board(account: account, board_id: record_id)
+    when "Card"
+      Storage::Entry.cleanup_card(account: account, card_id: record_id)
+    when "Comment"
+      Storage::Entry.cleanup_comment(account: account, comment_id: record_id)
+    end
+  end
+end
