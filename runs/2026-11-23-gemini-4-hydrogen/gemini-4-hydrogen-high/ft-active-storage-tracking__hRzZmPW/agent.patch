diff --git a/lib/rails_ext/active_storage_storage_tracking.rb b/lib/rails_ext/active_storage_storage_tracking.rb
new file mode 100644
index 0000000..ce0d0dc
--- /dev/null
+++ b/lib/rails_ext/active_storage_storage_tracking.rb
@@ -0,0 +1,59 @@
+module ActiveStorageAttachmentStorageTracking
+  def purge
+    target = storage_sync_target
+    super.tap { target&.sync_storage_later }
+  end
+
+  def purge_later
+    target = storage_sync_target
+    super.tap { target&.sync_storage_later }
+  end
+end
+
+module ActiveStorageDetachOneStorageTracking
+  def detach
+    target = attachment&.storage_sync_target
+    super.tap { target&.sync_storage_later }
+  end
+end
+
+module ActiveStorageDetachManyStorageTracking
+  def detach
+    targets = attachments.filter_map(&:storage_sync_target).uniq
+    super.tap { targets.each(&:sync_storage_later) }
+  end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  prepend ActiveStorageAttachmentStorageTracking
+
+  after_commit :sync_storage_later, on: %i[ create destroy ]
+
+  def storage_sync_target
+    case record_type
+    when "Card"
+      Card.find_by(id: record_id) if name == "image"
+    when "ActionText::RichText"
+      if name == "embeds" && (rich_text = ActionText::RichText.find_by(id: record_id))
+        case rich_text.record_type
+        when "Board"
+          Board.find_by(id: rich_text.record_id) if rich_text.name == "public_description"
+        when "Card"
+          Card.find_by(id: rich_text.record_id) if rich_text.name == "description"
+        when "Comment"
+          Comment.find_by(id: rich_text.record_id) if rich_text.name == "body"
+        end
+      end
+    end
+  end
+
+  private
+    def sync_storage_later
+      storage_sync_target&.sync_storage_later
+    end
+end
+
+Rails.application.config.to_prepare do
+  ActiveStorage::Attached::Changes::DetachOne.prepend ActiveStorageDetachOneStorageTracking
+  ActiveStorage::Attached::Changes::DetachMany.prepend ActiveStorageDetachManyStorageTracking
+end
