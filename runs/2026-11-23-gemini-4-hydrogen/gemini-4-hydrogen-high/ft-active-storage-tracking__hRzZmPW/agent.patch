+  perform_enqueued_jobs
+  assert_equal 444, @board.reload.bytes_used
+
+  card.rich_text_description.destroy!
+  perform_enqueued_jobs
+  assert_equal 0, @board.reload.bytes_used
+  assert_equal 0, @account.reload.bytes_used
+end
+
+test "reconcile_storage_later reconciles in the background" do
+  blob = create_blob(size: 650, filename: "bg_reconcile.txt")
+  @board.cards.create!(title: "Tracked", creator: @user, status: :published, image: blob)
+  perform_enqueued_jobs
+
+  @board.update_column(:bytes_used, 0)
