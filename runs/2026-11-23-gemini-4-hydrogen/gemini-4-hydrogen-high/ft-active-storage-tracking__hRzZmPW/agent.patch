+module Storage::Tracked
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :cleanup_storage_later, unless: :destroyed_by_association
+  end
+
+  def sync_storage_later
+    Storage::SyncJob.perform_later(self)
+  end
+
+  def sync_storage_now
+    Storage::Entry.sync(self)
+  end
+
+  private
+    def cleanup_storage_later
+      Storage::CleanupJob.perform_later(account, self.class.name, id)
+    end
+end
