@@ -9,6 +9,15 @@ You are welcome -- and encouraged -- to modify Fizzy to your liking.
 Please see our [Development guide](docs/development.md) for how to get Fizzy set up for local development.
 
 
+## Deployment
+
+Fizzy includes a single-server [Kamal](https://kamal-deploy.org/) configuration in `config/deploy.yml` and `.kamal/secrets` using SQLite, local Active Storage, Solid Queue background jobs in the same container, and automatic SSL via `kamal-proxy`.
+
+1. Update `config/deploy.yml` with your server IP/hostname (`servers.web`), your domain (`proxy.host` and `APP_HOST`), and your mail server settings (`MAILER_FROM_ADDRESS`, `SMTP_ADDRESS`, `SMTP_PORT`, `SMTP_USERNAME`).
+2. Provide your secrets (`SECRET_KEY_BASE`, `SMTP_PASSWORD`, and optionally `VAPID_PUBLIC_KEY` / `VAPID_PRIVATE_KEY` for web push notifications) via environment variables or `.kamal/secrets`.
+3. Run `bin/kamal setup`.
+
+
 ## Contributing
 
 We welcome contributions! Please read our [style guide](STYLE.md) before submitting code.
diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..3773152
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,61 @@
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image.
+image: fizzy
+
+# Deploy to these servers.
+servers:
+  web:
+    - 192.168.0.1
+
+# Enable SSL auto certification via Let's Encrypt and route requests to the container.
+# Note: If using Cloudflare, set encryption mode in SSL/TLS setting to "Full" to enable CF-to-app encryption.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Use a local Docker registry on your machine (no external registry required).
+registry:
+  server: localhost:5555
+
+# Configure builder setup.
+builder:
+  arch: amd64 # Change to arm64 if deploying to an ARM64 Linux server.
+
+# Persist SQLite databases and Active Storage uploads across deploys.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets between versions to avoid 404s on in-flight requests.
+asset_path: /rails/public/assets
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    # Public hostname for links in emails, webhooks, and exports (must match proxy.host).
+    APP_HOST: fizzy.example.com
+
+    # Run Solid Queue background jobs inside the web container.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Mail server settings.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: your-smtp-username
+    # SMTP_DOMAIN: example.com
+    # SMTP_AUTHENTICATION: plain
+    # SMTP_TLS: true
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# Aliases are triggered with "bin/kamal <alias>".
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
