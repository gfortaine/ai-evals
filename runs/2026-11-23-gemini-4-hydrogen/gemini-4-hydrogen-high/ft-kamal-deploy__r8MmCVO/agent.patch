+      if ENV["SMTP_USERNAME"].present? || ENV["SMTP_PASSWORD"].present?
+        smtp_settings[:user_name] = ENV["SMTP_USERNAME"].presence
+        smtp_settings[:password] = ENV["SMTP_PASSWORD"].presence
+        smtp_settings[:authentication] = ENV["SMTP_AUTHENTICATION"].presence || "plain"
