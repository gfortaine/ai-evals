+
+      if tls_enabled
+        smtp_settings[:tls] = true
+        smtp_settings[:enable_starttls_auto] = false
+      elsif ENV["SMTP_ENABLE_STARTTLS_AUTO"].present?
+        smtp_settings[:enable_starttls_auto] = ENV["SMTP_ENABLE_STARTTLS_AUTO"] == "true"
+      end
+
+      if ENV["SMTP_OPENSSL_VERIFY_MODE"].present?
+        smtp_settings[:openssl_verify_mode] = ENV["SMTP_OPENSSL_VERIFY_MODE"]
+      end
+
+      config.action_mailer.smtp_settings = smtp_settings.compact
+    end
+  end
