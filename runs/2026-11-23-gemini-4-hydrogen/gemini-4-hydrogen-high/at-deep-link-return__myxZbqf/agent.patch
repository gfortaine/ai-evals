@@ -30,4 +32,26 @@ class SessionsController < ApplicationController
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
     end
+
+    def safe_return_to
+      return_to = params[:return_to]
+      return unless return_to.is_a?(String) && return_to.valid_encoding?
+
+      return_to = return_to.presence
+      return unless return_to
+
+      uri = URI.parse(return_to)
+      return if uri.userinfo.present?
+
+      if uri.host.nil?
+        return_to if uri.scheme.nil? && return_to.start_with?("/") && !return_to.start_with?("//", "/\\")
+      elsif %w[ http https ].include?(uri.scheme) && uri.host.present? && uri.host.casecmp?(request.host)
+        if uri.port == request.port || (uri.port == uri.default_port && request.standard_port?)
+          uri.host = request.host
+          uri.to_s
+        end
+      end
+    rescue URI::InvalidURIError, ArgumentError
+      nil
+    end
 end
