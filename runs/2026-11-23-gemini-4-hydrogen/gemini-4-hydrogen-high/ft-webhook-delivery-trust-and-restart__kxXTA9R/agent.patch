+    assert_equal 1, webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "deliver deactivates webhook after 10 failures over an hour" do
+    freeze_time
+    stub_dns_resolution("93.184.216.34")
+    webhook = webhooks(:active)
+
+    stub_request(:post, webhook.url)
+      .with(ipaddr: "93.184.216.34")
+      .to_return(status: 500)
+
+    9.times do |i|
+      delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_commented))
+      delivery.deliver
+      assert webhook.reload.active?, "Webhook should still be active after #{i + 1} failures"
+    end
+
+    travel 1.hour
+    tenth_delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_commented))
+    tenth_delivery.deliver
+
+    assert_not webhook.reload.active?
+  end
+
+  test "cleanup removes deliveries older than a week and keeps recent ones" do
+    freeze_time
+
+    old_delivery = webhook_deliveries(:successfully_completed)
+    old_delivery.update_columns(created_at: 1.week.ago - 1.second)
+
+    boundary_delivery = webhook_deliveries(:unsuccessfully_completed)
+    boundary_delivery.update_columns(created_at: 1.week.ago)
+
+    recent_delivery = webhook_deliveries(:pending)
+    recent_delivery.update_columns(created_at: 6.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert Webhook::Delivery.exists?(boundary_delivery.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+  end
