+      .to_return(status: 200)
+
+    delivery.deliver
+
+    assert delivery.reload.succeeded?
+    parsed = JSON.parse(captured_body)
+    assert_match %r{/rails/active_storage/blobs/}, parsed.dig("eventable", "image_url")
+  end
