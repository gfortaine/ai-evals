+
 class Webhook::Delivery < ApplicationRecord
+  STALE_THRESHOLD = 1.week
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  HTTP_TIMEOUT = 5.seconds
+
+  NETWORK_ERRORS = [
+    EOFError,
+    IOError,
+    Net::HTTPBadResponse,
+    Net::HTTPHeaderSyntaxError,
+    Net::ProtocolError,
+    OpenSSL::SSL::SSLError,
+    Resolv::ResolvError,
+    Resolv::ResolvTimeout,
+    SocketError,
+    SystemCallError,
+    Timeout::Error,
+    URI::InvalidURIError,
