@@ -27,6 +71,153 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    !!(completed? && response[:error].blank? && response[:code]&.between?(200, 299))
   end
+
+  private
+    def claim_for_delivery
+      if self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+        self.state = "in_progress"
+        true
+      else
+        false
+      end
+    end
+
+    def perform_delivery
+      payload, content_type = build_payload
+      headers = build_headers(payload, content_type)
+      uri = URI.parse(webhook.url)
+
+      if ip = resolve_public_ip(uri.hostname)
+        http_response = send_request(uri, ip, headers, payload)
+        update!(
+          state: :completed,
+          request: { headers: headers },
+          response: { code: http_response.code.to_i }
+        )
+      else
+        update!(
+          state: :errored,
+          request: { headers: headers },
+          response: { error: "destination_unreachable" }
+        )
+      end
+    rescue *NETWORK_ERRORS => e
+      update!(
+        state: :errored,
+        request: { headers: headers },
+        response: { error: error_code_for(e) }
+      )
+    end
+
+    def build_payload
+      Current.set(account: account, user: nil) do
+        if webhook.for_basecamp?
+          [ { content: render_html }.to_json, "application/json" ]
+        elsif webhook.for_campfire?
+          [ render_html, "text/html" ]
+        elsif webhook.for_slack?
+          [ { text: render_slack_text }.to_json, "application/json" ]
+        else
+          [ render_json, "application/json" ]
+        end
+      end
+    end
+
+    def render_html
+      renderer.render(template: "webhooks/event", formats: :html, layout: false, assigns: { event: event }).strip
+    end
+
+    def render_slack_text
+      description = event.description_for(nil).to_plain_text
+      if event.eventable
+        url = Rails.application.routes.url_helpers.polymorphic_url(
+          event.eventable,
+          **default_url_options.with_defaults(host: http_host).merge(script_name: account.slug)
+        )
+        "#{description} <#{url}|↗︎>"
+      else
+        description.to_s
+      end
+    end
+
+    def render_json
+      renderer.render(template: "webhooks/event", formats: :json, assigns: { event: event })
+    end
+
+    def renderer
+      ApplicationController.renderer.new(
+        http_host: http_host,
+        https: default_url_options[:protocol] == "https",
+        script_name: account.slug
+      )
+    end
+
+    def default_url_options
+      @default_url_options ||= Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+
+    def http_host
+      [ default_url_options[:host], default_url_options[:port] ].compact.join(":").presence || "example.com"
+    end
+
+    def build_headers(payload, content_type)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => content_type,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+        "X-Webhook-Signature" => signature_for(payload)
+      }
+    end
+
+    def signature_for(payload)
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def resolve_public_ip(hostname)
+      if hostname.blank?
+        nil
+      elsif ip = parse_ip_address(hostname)
+        ip.to_s unless SsrfProtection.blocked_address?(ip)
+      else
+        SsrfProtection.resolve_public_ip(hostname)
+      end
+    end
+
+    def parse_ip_address(hostname)
+      IPAddr.new(hostname)
+    rescue IPAddr::InvalidAddressError
+      nil
+    end
+
+    def send_request(uri, ip, headers, payload)
+      http = Net::HTTP.new(uri.hostname, uri.port)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = HTTP_TIMEOUT
+      http.read_timeout = HTTP_TIMEOUT
+      http.write_timeout = HTTP_TIMEOUT
+      http.ssl_timeout = HTTP_TIMEOUT if http.use_ssl?
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = payload
+
+      http.request(request)
+    end
+
+    def error_code_for(exception)
+      case exception
+      when Timeout::Error
+        "request_timeout"
+      else
+        "destination_unreachable"
+      end
+    end
+
+    def record_outcome
+      webhook.delinquency_tracker.record_delivery_outcome(succeeded?)
+    end
 end
