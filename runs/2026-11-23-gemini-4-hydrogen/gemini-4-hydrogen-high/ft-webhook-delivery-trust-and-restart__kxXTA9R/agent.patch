diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..0e088ac
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,41 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  DELINQUENCY_DURATION = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_delivery_outcome(succeeded)
+    should_deactivate = false
+
+    with_lock do
+      if succeeded
+        reset
+      else
+        record_failure
+        should_deactivate = delinquent?
+      end
+    end
+
+    webhook.deactivate if should_deactivate
+  end
+
+  def reset
+    unless consecutive_failures_count.zero? && first_failure_at.nil?
+      update!(consecutive_failures_count: 0, first_failure_at: nil)
+    end
+  end
+
+  private
+    def record_failure
+      self.first_failure_at ||= Time.current
+      self.consecutive_failures_count += 1
+      save!
+    end
+
+    def delinquent?
+      consecutive_failures_count >= FAILURE_THRESHOLD &&
+        first_failure_at.present? &&
+        first_failure_at <= DELINQUENCY_DURATION.ago
+    end
+end
