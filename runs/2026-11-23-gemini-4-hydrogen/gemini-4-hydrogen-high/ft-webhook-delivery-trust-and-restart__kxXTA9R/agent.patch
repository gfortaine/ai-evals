@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "remains active before reaching 10 consecutive failures" do
+    9.times do
+      @tracker.record_delivery_outcome(false)
+      travel 15.minutes
+    end
+
+    assert @webhook.reload.active?
+    assert_equal 9, @tracker.consecutive_failures_count
+  end
+
+  test "remains active when 10 consecutive failures happen within less than an hour" do
+    10.times do
+      @tracker.record_delivery_outcome(false)
+      travel 5.minutes
+    end
+
+    assert @webhook.reload.active?
+    assert_equal 10, @tracker.consecutive_failures_count
+  end
+
+  test "deactivates webhook after 10 consecutive failures over at least an hour" do
+    freeze_time
+
+    9.times do
+      @tracker.record_delivery_outcome(false)
+    end
+    assert @webhook.reload.active?
+
+    travel 1.hour
+    @tracker.record_delivery_outcome(false)
+
+    assert_not @webhook.reload.active?
+    assert_equal 10, @tracker.consecutive_failures_count
+  end
+
+  test "deactivates on subsequent failure once duration passes an hour" do
+    freeze_time
+
+    10.times { @tracker.record_delivery_outcome(false) }
+    assert @webhook.reload.active?
+
+    travel 1.hour + 1.minute
+    @tracker.record_delivery_outcome(false)
+
+    assert_not @webhook.reload.active?
+    assert_equal 11, @tracker.consecutive_failures_count
+  end
+
+  test "a successful delivery resets consecutive failure streak" do
+    freeze_time
+
+    9.times { @tracker.record_delivery_outcome(false) }
+    travel 50.minutes
+
+    @tracker.record_delivery_outcome(true)
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+
+    travel 20.minutes
+    @tracker.record_delivery_outcome(false)
+    assert @webhook.reload.active?
+    assert_equal 1, @tracker.consecutive_failures_count
+  end
+
+  test "reactivating a deactivated webhook resets the delinquency tracker" do
+    freeze_time
+
+    9.times { @tracker.record_delivery_outcome(false) }
+    travel 1.hour
+    @tracker.record_delivery_outcome(false)
+    assert_not @webhook.reload.active?
+
+    @webhook.activate
+    assert @webhook.reload.active?
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+
+    @tracker.record_delivery_outcome(false)
+    assert @webhook.reload.active?
+    assert_equal 1, @tracker.consecutive_failures_count
+  end
+end
