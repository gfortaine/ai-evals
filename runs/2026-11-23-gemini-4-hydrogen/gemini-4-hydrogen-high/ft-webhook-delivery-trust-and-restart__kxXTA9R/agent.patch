+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  test "relaying an event triggers matching active webhooks on the board and delivers POST" do
+    board = boards(:writebook)
+    other_webhook = Webhook.create!(
+      board: board,
+      name: "Comments only",
+      url: "https://other.example.com/hook",
+      subscribed_actions: [ "comment_created" ]
+    )
+    inactive_board_webhook = Webhook.create!(
+      board: board,
+      name: "Paused",
+      url: "https://paused.example.com/hook",
+      subscribed_actions: [ "card_published" ],
+      active: false
+    )
+
+    request_stub = stub_request(:post, webhooks(:active).url)
+      .with(ipaddr: "93.184.216.34")
+      .to_return(status: 200)
+    other_stub = stub_request(:post, other_webhook.url)
+    inactive_stub = stub_request(:post, inactive_board_webhook.url)
+
+    card = nil
+    assert_difference -> { webhooks(:active).deliveries.count }, 1 do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        card = board.cards.create!(title: "Webhook Card", status: :published, creator: users(:david))
+      end
+    end
+
+    assert_requested request_stub, times: 1
+    assert_not_requested other_stub
+    assert_not_requested inactive_stub
+
+    delivery = webhooks(:active).deliveries.ordered.first
+    assert_equal "completed", delivery.state
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+    assert_equal "card_published", delivery.event.action
+    assert_equal card, delivery.event.eventable
+  end
+
+  test "relaying an event does not trigger webhooks on other boards" do
+    other_board_webhook = Webhook.create!(
+      board: boards(:private),
+      name: "Private board hook",
+      url: "https://private.example.com/hook",
+      subscribed_actions: [ "card_published" ]
+    )
+
+    stub_request(:post, webhooks(:active).url).to_return(status: 200)
+    other_stub = stub_request(:post, other_board_webhook.url)
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      boards(:writebook).cards.create!(title: "Another Card", status: :published, creator: users(:david))
+    end
+
+    assert_not_requested other_stub
+  end
+
+  test "re-running relay_now for the same event delivers at most once" do
+    request_stub = stub_request(:post, webhooks(:active).url)
+      .with(ipaddr: "93.184.216.34")
+      .to_return(status: 200)
+
+    event = nil
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      card = boards(:writebook).cards.create!(title: "Once Card", status: :published, creator: users(:david))
+      event = card.events.find_by!(action: "card_published")
+    end
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        event.relay_now
+      end
+    end
+
+    assert_requested request_stub, times: 1
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
