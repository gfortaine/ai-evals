diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..b3c0ae2
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,366 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+import { nextFrame } from "helpers/timing_helpers"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "container", "item" ]
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  initialize() {
+    this.draggedItem = null
+    this.sourceContainer = null
+    this.hoveredContainer = null
+    this.pendingSaves = 0
+    this.idleResolvers = []
+    this.updateDraggability = this.#updateDraggability.bind(this)
+  }
+
+  connect() {
+    this.mediaQuery = window.matchMedia(this.desktopBreakpointValue)
+    this.mediaQuery.addEventListener("change", this.updateDraggability)
+    this.#updateDraggability()
+  }
+
+  disconnect() {
+    this.mediaQuery?.removeEventListener("change", this.updateDraggability)
+    this.#cleanupDrag()
+    this.pendingSaves = 0
+    this.#resolveIdleIfReady()
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = this.#isDesktop
+  }
+
+  dragStart(event) {
+    if (!this.#isDesktop) return
+
+    const item = event.target.closest('[data-drag-and-drop-target~="item"]')
+    if (!item || !this.element.contains(item)) return
+
+    const sourceContainer = this.#containerFor(item)
+    if (!sourceContainer) return
+
+    this.draggedItem = item
+    this.sourceContainer = sourceContainer
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.id || "card")
+    }
+
+    nextFrame().then(() => {
+      if (this.draggedItem === item) {
+        item.classList.add(...this.draggedItemClasses)
+      }
+    })
+  }
+
+  dragEnter(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#validDropContainer(event.target)
+    if (container) {
+      event.preventDefault()
+      this.#setHoveredContainer(container)
+    } else {
+      this.#clearHoveredContainer()
+    }
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#validDropContainer(event.target)
+    if (!container) {
+      this.#clearHoveredContainer()
+      return
+    }
+
+    event.preventDefault()
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+    this.#setHoveredContainer(container)
+  }
+
+  dragLeave(event) {
+    if (!this.draggedItem || !this.hoveredContainer) return
+
+    if (event.relatedTarget) {
+      if (!this.hoveredContainer.contains(event.relatedTarget)) {
+        this.#clearHoveredContainer()
+      }
+    } else if (event.target === this.hoveredContainer || event.target === this.element) {
+      this.#clearHoveredContainer()
+    }
+  }
+
+  drop(event) {
+    const item = this.draggedItem
+    const sourceContainer = this.sourceContainer
+    if (!item || !sourceContainer) return
+
+    const targetContainer = this.#validDropContainer(event.target)
+    if (!targetContainer) {
+      this.#cleanupDrag()
+      return
+    }
+
+    event.preventDefault()
+    this.#cleanupDrag()
+
+    const snapshot = this.#snapshotItem(item, sourceContainer)
+    this.#moveItemToContainer(item, sourceContainer, targetContainer)
+    this.#persistMove(item, targetContainer, snapshot)
+  }
+
+  dragEnd() {
+    this.#cleanupDrag()
+    this.#resolveIdleIfReady()
+  }
+
+  deferRefresh(event) {
+    if (event.target.getAttribute("action") !== "refresh") return
+    if (!this.#isBusy) return
+
+    const originalRender = event.detail.render
+    event.detail.render = async (streamElement) => {
+      await this.#waitUntilIdle()
+      if (this.element.isConnected) {
+        return originalRender(streamElement)
+      }
+    }
+  }
+
+  // Private
+
+  get #isDesktop() {
+    return (this.mediaQuery ?? window.matchMedia(this.desktopBreakpointValue)).matches
+  }
+
+  get #isBusy() {
+    return Boolean(this.draggedItem) || this.pendingSaves > 0
+  }
+
+  #updateDraggability() {
+    const draggable = this.#isDesktop
+    this.itemTargets.forEach(item => {
+      item.draggable = draggable
+    })
+  }
+
+  #containerFor(element) {
+    if (!(element instanceof Element)) return null
+    const container = element.closest('[data-drag-and-drop-target~="container"]')
+    return container && this.element.contains(container) ? container : null
+  }
+
+  #validDropContainer(target) {
+    const container = this.#containerFor(target)
+    if (!container || container === this.sourceContainer) return null
+    return container
+  }
+
+  #setHoveredContainer(container) {
+    if (this.hoveredContainer === container) return
+
+    this.#clearHoveredContainer()
+    this.hoveredContainer = container
+    container.classList.add(...this.hoverContainerClasses)
+  }
+
+  #clearHoveredContainer() {
+    if (!this.hoveredContainer) return
+
+    this.hoveredContainer.classList.remove(...this.hoverContainerClasses)
+    this.hoveredContainer = null
+  }
+
+  #cleanupDrag() {
+    if (this.draggedItem) {
+      this.draggedItem.classList.remove(...this.draggedItemClasses)
+      this.draggedItem = null
+    }
+    this.sourceContainer = null
+    this.#clearHoveredContainer()
+  }
+
+  #snapshotItem(item, sourceContainer) {
+    return {
+      sourceContainer,
+      parent: item.parentElement,
+      nextSibling: item.nextElementSibling,
+      className: item.className,
+      cardColor: item.style.getPropertyValue("--card-color"),
+      closedStamp: item.querySelector(".card__closed")
+    }
+  }
+
+  #moveItemToContainer(item, sourceContainer, targetContainer) {
+    this.#updateItemAppearance(item, targetContainer)
+    this.#insertItemIntoContainer(item, targetContainer)
+    this.#adjustCount(sourceContainer, -1)
+    this.#adjustCount(targetContainer, 1)
+  }
+
+  #updateItemAppearance(item, targetContainer) {
+    item.removeAttribute("aria-selected")
+    if (document.activeElement && item.contains(document.activeElement)) {
+      document.activeElement.blur()
+    }
+
+    const columnType = targetContainer.dataset.dragAndDropColumnType
+    switch (columnType) {
+      case "not_now":
+        item.classList.remove("card--active")
+        item.classList.add("card--postponed")
+        item.style.setProperty("--card-color", "var(--color-card-default)")
+        item.querySelector(".card__closed")?.remove()
+        break
+      case "closed":
+        item.classList.remove("card--active", "card--postponed")
+        item.style.setProperty("--card-color", "var(--color-card-complete)")
+        break
+      case "maybe":
+        item.classList.remove("card--postponed")
+        item.classList.add("card--active")
+        item.style.setProperty("--card-color", "var(--color-card-default)")
+        item.querySelector(".card__closed")?.remove()
+        break
+      case "column":
+        item.classList.remove("card--postponed")
+        item.classList.add("card--active")
+        const color = targetContainer.style.getPropertyValue("--card-color")
+        if (color) {
+          item.style.setProperty("--card-color", color)
+        }
+        item.querySelector(".card__closed")?.remove()
+        break
+    }
+  }
+
+  #insertItemIntoContainer(item, targetContainer) {
+    const list = targetContainer.querySelector(".cards__list")
+    if (!list) {
+      item.remove()
+      return
+    }
+
+    const insertionContainer = list.querySelector("turbo-frame[id$='-pagination-contents-1']") || list
+    const columnType = targetContainer.dataset.dragAndDropColumnType
+    const sortGoldenFirst = columnType === "maybe" || columnType === "column"
+    const isGolden = item.classList.contains("golden-effect")
+
+    if (sortGoldenFirst && !isGolden) {
+      const cards = Array.from(insertionContainer.querySelectorAll(":scope > [data-drag-and-drop-target~='item']"))
+      const firstNonGolden = cards.find(card => !card.classList.contains("golden-effect"))
+      if (firstNonGolden) {
+        insertionContainer.insertBefore(item, firstNonGolden)
+      } else if (cards.length > 0) {
+        cards[cards.length - 1].after(item)
+      } else {
+        insertionContainer.prepend(item)
+      }
+    } else {
+      insertionContainer.prepend(item)
+    }
+  }
+
+  #adjustCount(container, delta) {
+    const countElement = container.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const text = countElement.textContent.trim()
+    if (text === "99+") return
+
+    const current = parseInt(text, 10)
+    if (Number.isNaN(current)) return
+
+    const next = Math.max(0, current + delta)
+    countElement.textContent = next > 99 ? "99+" : String(next)
+  }
+
+  async #persistMove(item, targetContainer, snapshot) {
+    this.pendingSaves++
+
+    try {
+      const response = await this.#sendMoveRequest(item, targetContainer)
+      if (!response.ok) {
+        this.#rollback(item, snapshot, targetContainer)
+      } else if (!targetContainer.querySelector(".cards__list")) {
+        targetContainer.querySelector("turbo-frame")?.reload()
+      }
+    } catch {
+      this.#rollback(item, snapshot, targetContainer)
+    } finally {
+      this.pendingSaves--
+      this.#resolveIdleIfReady()
+    }
+  }
+
+  #sendMoveRequest(item, targetContainer) {
+    const columnType = targetContainer.dataset.dragAndDropColumnType
+
+    switch (columnType) {
+      case "not_now":
+        return post(item.dataset.dragAndDropNotNowUrl, { responseKind: "json" })
+      case "closed":
+        return post(item.dataset.dragAndDropClosureUrl, { responseKind: "json" })
+      case "maybe":
+        return destroy(item.dataset.dragAndDropTriageUrl, { responseKind: "json" })
+      case "column":
+        return post(item.dataset.dragAndDropTriageUrl, {
+          query: { column_id: targetContainer.dataset.dragAndDropColumnId },
+          responseKind: "json"
+        })
+    }
+  }
+
+  #rollback(item, snapshot, targetContainer) {
+    if (snapshot.parent?.isConnected) {
+      if (snapshot.nextSibling && snapshot.nextSibling.parentElement === snapshot.parent) {
+        snapshot.parent.insertBefore(item, snapshot.nextSibling)
+      } else {
+        snapshot.parent.appendChild(item)
+      }
+    }
+
+    item.className = snapshot.className
+    if (snapshot.cardColor) {
+      item.style.setProperty("--card-color", snapshot.cardColor)
+    } else {
+      item.style.removeProperty("--card-color")
+    }
+    if (snapshot.closedStamp && !item.contains(snapshot.closedStamp)) {
+      item.querySelector(".card__body")?.appendChild(snapshot.closedStamp)
+    }
+
+    this.#adjustCount(snapshot.sourceContainer, 1)
+    this.#adjustCount(targetContainer, -1)
+  }
+
+  #waitUntilIdle() {
+    if (!this.#isBusy) return Promise.resolve()
+
+    return new Promise(resolve => {
+      this.idleResolvers.push(resolve)
+    })
+  }
+
+  #resolveIdleIfReady() {
+    if (this.#isBusy) return
+
+    while (this.idleResolvers.length > 0) {
+      this.idleResolvers.shift()()
+    }
+  }
+}
