diff --git a/test/models/event/relaying_test.rb b/test/models/event/relaying_test.rb
new file mode 100644
index 0000000..608c97e
--- /dev/null
+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @webhook = webhooks(:active)
+  end
+
+  test "relays subscribed event to active webhooks on the same board" do
+    request_stub = stub_request(:post, @webhook.url)
+      .to_return(status: 200, body: "OK")
+
+    assert_difference -> { @webhook.deliveries.count }, 1 do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        @card.close(user: users(:david))
+      end
+    end
+
+    assert_requested request_stub, times: 1
+    delivery = @webhook.deliveries.ordered.first
+    assert delivery.succeeded?
+    assert_equal "card_closed", delivery.event.action
+  end
+
+  test "does not relay events that the webhook is not subscribed to" do
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        @card.comments.create!(body: "Not subscribed", creator: users(:david))
+      end
+    end
+  end
+
+  test "does not relay events to inactive webhooks" do
+    @webhook.deactivate
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        @card.close(user: users(:david))
+      end
+    end
+  end
+
+  test "does not relay events to webhooks on other boards" do
+    other_webhook = webhooks(:inactive)
+    other_webhook.activate
+
+    assert_no_difference -> { other_webhook.deliveries.count } do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        @card.close(user: users(:david))
+      end
+    end
+  end
+
+  test "relaying the same event multiple times delivers exactly once" do
+    request_stub = stub_request(:post, @webhook.url)
+      .to_return(status: 200)
+
+    event = events(:text_published)
+
+    assert_difference -> { @webhook.deliveries.where(event: event).count }, 1 do
+      event.relay_now
+      event.relay_now
+      perform_enqueued_jobs only: Webhook::DeliveryJob
+    end
+
+    assert_requested request_stub, times: 1
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..4359802
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+    @event = events(:layout_commented)
+  end
+
+  test "does not deactivate before 10 consecutive failures" do
+    9.times do |i|
+      travel_to (i * 10).minutes.from_now do
+        record_failure
+      end
+    end
+
+    assert @webhook.reload.active?
+    assert_equal 9, @tracker.reload.consecutive_failures_count
+  end
+
+  test "does not deactivate if 10 consecutive failures occur in under an hour" do
+    freeze_time do
+      10.times { record_failure }
+
+      assert @webhook.reload.active?
+      assert_equal 10, @tracker.reload.consecutive_failures_count
+
+      travel 59.minutes
+      record_failure
+
+      assert @webhook.reload.active?
+      assert_equal 11, @tracker.reload.consecutive_failures_count
+    end
+  end
+
+  test "deactivates after 10 consecutive failures spanning an hour" do
+    freeze_time do
+      9.times { record_failure }
+      assert @webhook.reload.active?
+
+      travel 1.hour
+      record_failure
+
+      assert_not @webhook.reload.active?
+      assert_equal 0, @tracker.reload.consecutive_failures_count
+      assert_nil @tracker.first_failure_at
+    end
+  end
+
+  test "resets consecutive failures on a successful delivery" do
+    freeze_time do
+      9.times { record_failure }
+      travel 2.hours
+
+      record_success
+
+      assert @webhook.reload.active?
+      assert_equal 0, @tracker.reload.consecutive_failures_count
+      assert_nil @tracker.first_failure_at
+
+      record_failure
+      assert @webhook.reload.active?
+      assert_equal 1, @tracker.reload.consecutive_failures_count
+    end
+  end
+
+  test "reactivating webhook keeps tracker reset so next single failure does not immediately deactivate" do
+    freeze_time do
+      9.times { record_failure }
+      travel 1.hour
+      record_failure
+      assert_not @webhook.reload.active?
+
+      @webhook.activate
+      assert @webhook.reload.active?
+
+      record_failure
+      assert @webhook.reload.active?
+      assert_equal 1, @tracker.reload.consecutive_failures_count
+    end
+  end
+
+  private
+    def record_failure
+      delivery = Webhook::Delivery.new(webhook: @webhook, event: @event, state: :completed, response: { code: 500 })
+      @tracker.record_delivery_of(delivery)
+    end
+
+    def record_success
+      delivery = Webhook::Delivery.new(webhook: @webhook, event: @event, state: :completed, response: { code: 200 })
+      @tracker.record_delivery_of(delivery)
+    end
+end
