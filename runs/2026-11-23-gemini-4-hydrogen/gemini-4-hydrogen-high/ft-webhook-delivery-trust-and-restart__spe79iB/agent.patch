+    stub_request(:post, webhook.url)
+      .with { |req| captured_request = req; true }
+      .to_return(status: 201)
+
+    delivery.deliver
+
+    assert delivery.reload.succeeded?
+    assert_equal "text/html", captured_request.headers["Content-Type"]
+    assert_includes captured_request.body, "Layout is broken"
+    assert_includes captured_request.body, "<a href="
+  end
+
+  test "deliver records non-2xx response as completed but failed" do
+    webhook = webhooks(:active)
+    event = events(:layout_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub_request(:post, webhook.url).to_return(status: 500, body: "Internal Server Error")
+
+    delivery.deliver
+    delivery.reload
+
+    assert delivery.completed?
+    assert delivery.failed?
+    assert_not delivery.succeeded?
+    assert_equal 500, delivery.response[:code]
+    assert_equal 1, webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "deliver records network errors and timeouts as errored" do
+    webhook = webhooks(:active)
+    event = events(:layout_published)
+
+    stub_request(:post, webhook.url).to_raise(SocketError.new("Failed to open TCP connection"))
+    errored_delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+    errored_delivery.deliver
+    errored_delivery.reload
+
+    assert errored_delivery.errored?
+    assert errored_delivery.failed?
+    assert_equal "destination_unreachable", errored_delivery.response[:error]
+
+    stub_request(:post, webhook.url).to_timeout
+    timeout_delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+    timeout_delivery.deliver
+    timeout_delivery.reload
+
+    assert timeout_delivery.errored?
+    assert timeout_delivery.failed?
+    assert_equal "request_timeout", timeout_delivery.response[:error]
+  end
+
+  test "deliver executes at most once even if called multiple times" do
+    webhook = webhooks(:active)
+    event = events(:layout_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    request_stub = stub_request(:post, webhook.url).to_return(status: 500)
+
+    delivery.deliver
+    delivery.deliver
+    delivery.reload.deliver
+
+    assert_requested request_stub, times: 1
+  end
+
+  test "deliver does not send request if webhook is inactive" do
+    webhook = webhooks(:inactive)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_published))
+
+    request_stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    delivery.deliver
+
+    assert_not_requested request_stub
+    assert delivery.reload.pending?
+  end
+
+  test "cleanup deletes deliveries older than one week" do
+    old_delivery = webhook_deliveries(:successfully_completed)
+    errored_old_delivery = webhook_deliveries(:errored)
+    recent_delivery = webhook_deliveries(:unsuccessfully_completed)
+    newer_delivery = webhook_deliveries(:pending)
+
+    assert old_delivery.created_at < 1.week.ago
+    assert recent_delivery.created_at > 1.week.ago
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert_not Webhook::Delivery.exists?(errored_old_delivery.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+    assert Webhook::Delivery.exists?(newer_delivery.id)
+  end
+
+  test "10 consecutive failed deliveries over an hour deactivate the webhook" do
+    webhook = webhooks(:active)
+    event = events(:layout_published)
+    stub_request(:post, webhook.url).to_return(status: 500)
+
+    freeze_time do
+      9.times do
+        Webhook::Delivery.create!(webhook: webhook, event: event).deliver
+      end
+      assert webhook.reload.active?
+
+      travel 1.hour
+      Webhook::Delivery.create!(webhook: webhook, event: event).deliver
+      assert_not webhook.reload.active?
+    end
+  end
 end
