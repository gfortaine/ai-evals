@@ -29,4 +66,119 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim_for_delivery
+      return false unless pending? && webhook.active?
+
+      claimed = self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+      if claimed
+        self.state = "in_progress"
+        clear_attribute_changes([ :state ])
+      end
+      claimed
+    end
+
+    def build_payload_and_content_type
+      if webhook.for_basecamp?
+        [ { content: render_event_html }.to_json, "application/json" ]
+      elsif webhook.for_campfire?
+        [ render_event_html, "text/html" ]
+      elsif webhook.for_slack?
+        [ { text: render_slack_text }.to_json, "application/json" ]
+      else
+        [ render_event_json, "application/json" ]
+      end
+    end
+
+    def render_event_html
+      Current.set(user: nil) do
+        renderer.render(template: "webhooks/event", formats: :html, layout: false, assigns: { event: event }).strip
+      end
+    end
+
+    def render_event_json
+      renderer.render(template: "webhooks/event", formats: :json, assigns: { event: event })
+    end
+
+    def render_slack_text
+      text = CGI.unescapeHTML(event.description_for(nil).to_plain_text)
+
+      if event.eventable
+        eventable_url = Rails.application.routes.url_helpers.polymorphic_url(
+          event.eventable,
+          **url_options.merge(script_name: account.slug)
+        )
+        "#{text} <#{eventable_url}|↗︎>"
+      else
+        text
+      end
+    end
+
+    def renderer
+      ApplicationController.renderer.new(
+        http_host: http_host,
+        https: url_options[:protocol] == "https",
+        script_name: account.slug
+      )
+    end
+
+    def url_options
+      @url_options ||= Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options.presence ||
+        { host: "example.com" }
+    end
+
+    def http_host
+      if url_options[:port]
+        "#{url_options[:host]}:#{url_options[:port]}"
+      else
+        url_options[:host] || "example.com"
+      end
+    end
+
+    def request_headers(payload, content_type)
+      {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => content_type,
+        "X-Webhook-Signature" => signature_for(payload),
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601
+      }
+    end
+
+    def signature_for(payload)
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def post_payload(payload, headers)
+      uri = URI.parse(webhook.url)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = 5
+      http.read_timeout = 10
+
+      req = Net::HTTP::Post.new(uri.request_uri, headers)
+      req.body = payload
+
+      http_response = http.request(req)
+
+      {
+        state: :completed,
+        response: {
+          code: http_response.code.to_i,
+          headers: http_response.each_header.to_h
+        }
+      }
+    rescue Timeout::Error
+      { state: :errored, response: { error: "request_timeout" } }
+    rescue OpenSSL::SSL::SSLError
+      { state: :errored, response: { error: "failed_ssl_handshake" } }
+    rescue *NETWORK_ERRORS
+      { state: :errored, response: { error: "destination_unreachable" } }
+    end
+
+    def record_delinquency
+      tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+      tracker.record_delivery_of(self)
+    end
 end
