diff --git a/test/controllers/books/searches_rate_limit_test.rb b/test/controllers/books/searches_rate_limit_test.rb
new file mode 100644
index 0000000..c0a01da
--- /dev/null
+++ b/test/controllers/books/searches_rate_limit_test.rb
@@ -0,0 +1,149 @@
+require "test_helper"
+
+class Books::SearchesRateLimitTest < ActionDispatch::IntegrationTest
+  setup do
+    Rails.cache.clear
+    books(:handbook).update!(published: true)
+    books(:manual).update!(published: true)
+    Leaf.reindex_all
+  end
+
+  teardown do
+    Rails.cache.clear
+  end
+
+  test "allows 30 search requests in a minute and refuses the 31st with 429" do
+    headers = { "REMOTE_ADDR" => "198.51.100.10" }
+
+    30.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+      assert_response :success
+    end
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+    assert_response :too_many_requests
+  end
+
+  test "enforces the 30-request limit per address across all published books" do
+    headers = { "REMOTE_ADDR" => "198.51.100.11" }
+
+    15.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+      assert_response :success
+    end
+
+    15.times do
+      post book_search_path(books(:manual)), params: { search: "manual" }, headers: headers
+      assert_response :success
+    end
+
+    post book_search_path(books(:manual)), params: { search: "manual" }, headers: headers
+    assert_response :too_many_requests
+  end
+
+  test "enforces the limit over a sliding one-minute stretch" do
+    headers = { "REMOTE_ADDR" => "198.51.100.12" }
+
+    freeze_time do
+      15.times do
+        post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+        assert_response :success
+      end
+
+      travel 45.seconds
+      15.times do
+        post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+        assert_response :success
+      end
+
+      travel 20.seconds
+      15.times do
+        post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+        assert_response :success
+      end
+
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+      assert_response :too_many_requests
+    end
+  end
+
+  test "automatically serves the address again within five minutes after burst stops" do
+    headers = { "REMOTE_ADDR" => "198.51.100.13" }
+
+    freeze_time do
+      30.times do
+        post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+        assert_response :success
+      end
+
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+      assert_response :too_many_requests
+
+      travel 5.minutes
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+      assert_response :success
+      assert_select "a", text: /Thanks for reading/i
+    end
+  end
+
+  test "does not affect readers at a different address without signing in" do
+    blocked_headers = { "REMOTE_ADDR" => "198.51.100.14" }
+    other_headers = { "REMOTE_ADDR" => "198.51.100.15" }
+
+    31.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: blocked_headers
+    end
+    assert_response :too_many_requests
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: other_headers
+    assert_response :success
+    assert_select "a", text: /Thanks for reading/i
+  end
+
+  test "refused address can still open the book and its pages" do
+    headers = { "REMOTE_ADDR" => "198.51.100.16" }
+
+    31.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+    end
+    assert_response :too_many_requests
+
+    get book_slug_path(books(:handbook)), headers: headers
+    assert_response :success
+
+    get leafable_slug_path(leaves(:welcome_page)), headers: headers
+    assert_response :success
+  end
+
+  test "still enforces rate limit when Rails.cache is NullStore" do
+    original_cache = Rails.cache
+    original_controller_cache = ActionController::Base.cache_store
+    Rails.cache = ActiveSupport::Cache::NullStore.new
+    ActionController::Base.cache_store = ActiveSupport::Cache::NullStore.new
+
+    headers = { "REMOTE_ADDR" => "198.51.100.17" }
+    30.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+      assert_response :success
+    end
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+    assert_response :too_many_requests
+  ensure
+    Rails.cache = original_cache
+    ActionController::Base.cache_store = original_controller_cache
+  end
+
+test "rate limits by forwarded client IP when behind a trusted proxy" do
+  30.times do
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: { "X-Forwarded-For" => "198.51.100.20" }
+    assert_response :success
+  end
+
+  post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: { "X-Forwarded-For" => "198.51.100.20" }
+  assert_response :too_many_requests
+
+  post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: { "X-Forwarded-For" => "198.51.100.21" }
+  assert_response :success
+end
+end
