diff --git a/app/models/search_rate_limiter.rb b/app/models/search_rate_limiter.rb
new file mode 100644
index 0000000..911c817
--- /dev/null
+++ b/app/models/search_rate_limiter.rb
@@ -0,0 +1,127 @@
+require "securerandom"
+
+class SearchRateLimiter
+  LIMIT = 30
+  WINDOW = 1.minute
+
+  REDIS_LUA_SCRIPT = <<~LUA
+    local key = KEYS[1]
+    local now = tonumber(ARGV[1])
+    local cutoff = tonumber(ARGV[2])
+    local limit = tonumber(ARGV[3])
+    local ttl_ms = tonumber(ARGV[4])
+    local member = ARGV[5]
+
+    redis.call("ZREMRANGEBYSCORE", key, "-inf", cutoff)
+    local count = redis.call("ZCARD", key)
+    if count >= limit then
+      return 0
+    end
+    redis.call("ZADD", key, now, member)
+    redis.call("PEXPIRE", key, ttl_ms)
+    return 1
+  LUA
+
+  class << self
+    def instance
+      @instance ||= new
+    end
+
+    def allow?(identifier)
+      instance.allow?(identifier)
+    end
+  end
+
+  def initialize(limit: LIMIT, window: WINDOW)
+    @limit = limit
+    @window = window
+    @mutex = Mutex.new
+    @fallback_store = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  def allow?(identifier)
+    cache_key = "rate-limit:books/searches:#{identifier.presence || "unknown"}"
+    store = resolve_store
+
+    if redis_store?(store)
+      allow_with_redis?(store, cache_key)
+    else
+      allow_with_cache?(store, cache_key)
+    end
+  end
+
+  private
+    def resolve_store
+      if usable_store?(Rails.cache)
+        Rails.cache
+      elsif usable_store?(ActionController::Base.cache_store)
+        ActionController::Base.cache_store
+      else
+        @fallback_store
+      end
+    end
+
+    def usable_store?(store)
+      store && !store.is_a?(ActiveSupport::Cache::NullStore)
+    end
+
+    def redis_store?(store)
+      defined?(ActiveSupport::Cache::RedisCacheStore) && store.is_a?(ActiveSupport::Cache::RedisCacheStore)
+    end
+
+    def allow_with_cache?(store, cache_key)
+      now = Time.now.to_f
+      cutoff = now - @window.to_f
+
+      @mutex.synchronize do
+        timestamps = Array(store.read(cache_key)).select { |ts| ts > cutoff }
+        if timestamps.size >= @limit
+          false
+        else
+          timestamps << now
+          store.write(cache_key, timestamps, expires_in: @window)
+          true
+        end
+      end
+    end
+
+    def allow_with_redis?(store, cache_key)
+      now_ms = Time.now.to_f * 1000.0
+      cutoff_ms = now_ms - (@window.to_f * 1000.0)
+      ttl_ms = (@window.to_f * 1000.0).ceil
+      member = "#{now_ms}:#{SecureRandom.hex(8)}"
+      redis_key = store.options[:namespace].present? ? "#{store.options[:namespace]}:#{cache_key}" : cache_key
+
+      result = with_redis_client(store.redis, redis_key) do |client|
+        client.eval(
+          REDIS_LUA_SCRIPT,
+          keys: [ redis_key ],
+          argv: [ now_ms, cutoff_ms, @limit, ttl_ms, member ]
+        )
+      end
+
+      result == 1
+    rescue ::Redis::BaseError, *connection_pool_errors
+      allow_with_cache?(@fallback_store, cache_key)
+    end
+
+    def with_redis_client(redis, redis_key)
+      if redis.respond_to?(:with)
+        redis.with do |client|
+          client = client.node_for(redis_key) if defined?(::Redis::Distributed) && client.is_a?(::Redis::Distributed)
+          yield client
+        end
+      else
+        client = (defined?(::Redis::Distributed) && redis.is_a?(::Redis::Distributed)) ? redis.node_for(redis_key) : redis
+        yield client
+      end
+    end
+
+    def connection_pool_errors
+      if defined?(::ConnectionPool)
+        [ ::ConnectionPool::Error, ::ConnectionPool::TimeoutError ]
+      else
+        []
+      end
+    end
+end
