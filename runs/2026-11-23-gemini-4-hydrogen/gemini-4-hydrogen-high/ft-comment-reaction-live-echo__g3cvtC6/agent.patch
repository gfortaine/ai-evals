diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..d96397c
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,42 @@
+class Reaction < ApplicationRecord
+  ALL_EMOJI_REGEX = /\A(?:\p{Emoji_Presentation}|\p{Extended_Pictographic}\uFE0F?|[0-9#*]\uFE0F?\u20E3|\p{Emoji_Modifier}|\u200D|\uFE0F)+\z/
+
+  belongs_to :account, default: -> { reactable.account }
+  belongs_to :reactable, polymorphic: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  scope :ordered, -> { order(created_at: :asc, id: :asc) }
+
+  normalizes :content, with: ->(content) { content.strip }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  after_create_commit :broadcast_create
+  after_destroy_commit :broadcast_destroy
+
+  delegate :card, to: :reactable
+
+  def all_emoji?
+    content.match?(ALL_EMOJI_REGEX)
+  end
+
+  private
+    def broadcast_create
+      return unless reactable.is_a?(Comment)
+
+      Current.with_account(account) do
+        broadcast_replace_to [ card, :activity ],
+          target: ActionView::RecordIdentifier.dom_id(reactable, :reactions_list),
+          partial: "cards/comments/reactions/list",
+          locals: { comment: reactable }
+      end
+    end
+
+    def broadcast_destroy
+      return if destroyed_by_association.present?
+
+      Current.with_account(account) do
+        broadcast_remove_to [ card, :activity ]
+      end
+    end
+end
