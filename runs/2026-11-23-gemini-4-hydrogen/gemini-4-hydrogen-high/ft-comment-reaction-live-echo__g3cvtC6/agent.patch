+<div id="<%= dom_id(comment, :new_reaction) %>" contents data-reaction-form-target="newReaction">
+  <button type="button"
+      class="reactions__trigger btn btn--circle"
+      data-reaction-form-target="trigger"
+      data-action="click->reaction-form#open"
+      data-controller="tooltip">
+    <%= image_tag "boost-color.svg", aria: { hidden: true } %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <div class="reaction__form flex align-center" data-reaction-form-target="formContainer" hidden>
+    <div class="reaction__menu" data-controller="dialog" data-dialog-orient-value="false" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside dialog:close->reaction-form#focusInput">
+      <button type="button" class="btn btn--circle borderless reaction__menu-btn" data-action="click->dialog#toggle:stop">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Pick an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel shadow" data-dialog-target="dialog" data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <button type="button" class="btn btn--circle borderless" data-action="click->reaction-form#pickEmoji click->dialog#close" data-emoji="<%= emoji %>" aria-label="<%= label %>" title="<%= label %>">
+              <%= emoji %>
+            </button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form_with model: Reaction.new, url: card_comment_reactions_path(comment.card, comment),
+          class: "flex align-center gap-half",
+          data: {
+            controller: "form",
+            reaction_form_target: "form",
+            action: "submit->form#preventEmptySubmit submit->form#preventComposingSubmit turbo:submit-end->reaction-form#handleSubmitEnd"
+          } do |form| %>
+      <label class="reaction__form-label flex align-center">
+        <span class="for-screen-reader">Reaction</span>
+        <%= form.text_field :content,
+              class: "input reaction__input txt-small",
+              maxlength: 16,
+              autocomplete: "off",
+              required: true,
+              data: {
+                form_target: "input",
+                reaction_form_target: "input",
+                "1p-ignore": "true",
+                action: "compositionstart->form#compositionStart compositionend->form#compositionEnd"
+              } %>
+      </label>
+
+      <button type="submit" class="btn btn--circle borderless reaction__submit-btn" data-form-target="submit">
+        <%= icon_tag "check" %>
+        <span class="for-screen-reader">Add reaction</span>
+      </button>
+
+      <button type="button" class="btn btn--circle borderless reaction__cancel-btn" data-action="click->reaction-form#close">
+        <%= icon_tag "close" %>
+        <span class="for-screen-reader">Cancel</span>
+      </button>
+    <% end %>
