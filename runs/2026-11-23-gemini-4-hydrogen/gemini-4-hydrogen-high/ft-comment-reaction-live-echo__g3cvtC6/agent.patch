diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..1896351
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,62 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_reacter, only: :destroy
+  before_action :ensure_card_is_commentable, only: :create
+
+  def index
+    @reactions = @comment.reactions.includes(reacter: [ :avatar_attachment, :account ])
+  end
+
+  def show
+  end
+
+  def create
+    @reaction = @comment.reactions.new(reaction_params)
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { head :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..b8847db
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,38 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { reacterId: String }
+
+  connect() {
+    if (this.#isOwnedByCurrentUser) {
+      this.element.classList.add("reaction--deleteable")
+    }
+  }
+
+  toggle() {
+    if (this.#isOwnedByCurrentUser) {
+      this.element.classList.toggle("expanded")
+    }
+  }
+
+  close(event) {
+    if (this.element.classList.contains("expanded")) {
+      if (event?.type === "keydown") event.stopPropagation()
+      this.element.classList.remove("expanded")
+    }
+  }
+
+  closeOnClickOutside({ target }) {
+    if (!this.element.contains(target)) {
+      this.close()
+    }
+  }
+
+  delete() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  get #isOwnedByCurrentUser() {
+    return Current.user?.id === this.reacterIdValue
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..7483481
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,47 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "newReaction", "trigger", "formContainer", "form", "input" ]
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formContainerTarget.hidden = false
+    this.formContainerTarget.classList.add("reaction", "expanded")
+    this.newReactionTarget.setAttribute("data-turbo-permanent", "")
+    this.inputTarget.focus()
+  }
+
+  close(event) {
+    if (this.formContainerTarget.hidden) return
+    if (event?.type === "keydown") event.stopPropagation()
+
+    this.formTarget.reset()
+    this.formContainerTarget.classList.remove("reaction", "expanded")
+    this.newReactionTarget.removeAttribute("data-turbo-permanent")
+    this.formContainerTarget.hidden = true
+    this.triggerTarget.hidden = false
+  }
+
+  closeOnClickOutside({ target }) {
+    if (!this.element.contains(target)) {
+      this.close()
+    }
+  }
+
+  focusInput() {
+    if (!this.formContainerTarget.hidden) {
+      this.inputTarget.focus()
+    }
+  }
+
+  pickEmoji(event) {
+    this.inputTarget.value = event.currentTarget.dataset.emoji
+    this.formTarget.requestSubmit()
+  }
+
+  handleSubmitEnd(event) {
+    if (event.detail.success) {
+      this.close()
+    }
+  }
+}
