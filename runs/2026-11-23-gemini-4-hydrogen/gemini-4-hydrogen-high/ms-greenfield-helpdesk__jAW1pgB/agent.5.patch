@@ -0,0 +1,37 @@
+require "test_helper"
+
+class TicketMailerTest < ActionMailer::TestCase
+  setup do
+    ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+  end
+
+  teardown do
+    ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+  end
+
+  test "staff_reply uses support domain, private reply address, and threading headers" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+    staff = account.users.create!(name: "Jo", email: "jo@acme.test", password: "password123", role: "admin", verified: true)
+    customer = account.users.create!(name: "Avery", email: "avery@example.test", password: "password123", role: "customer", verified: false)
+    ticket = account.tickets.create!(
+      requester: customer,
+      subject: "Need help",
+      origin: "email",
+      email_message_id: "orig-123@example.test"
+    )
+    comment = ticket.comments.create!(author: staff, body: "We are looking into this.", public: true)
+
+    email = TicketMailer.staff_reply(ticket, comment)
+    assert_equal [ "acme@support.example.test" ], email.from
+    assert_equal [ "reply+#{ticket.reply_token}@support.example.test" ], email.reply_to
+    assert_equal [ "avery@example.test" ], email.to
+    assert_equal "Re: Need help", email.subject
+    assert_equal "<orig-123@example.test>", email.header["In-Reply-To"].value
+    assert_includes email.text_part.body.decoded, "We are looking into this."
+
+    ENV["HELPDESK_SUPPORT_DOMAIN"] = "mail.acmehelp.test"
+    email2 = TicketMailer.staff_reply(ticket, comment)
+    assert_equal [ "acme@mail.acmehelp.test" ], email2.from
+    assert_equal [ "reply+#{ticket.reply_token}@mail.acmehelp.test" ], email2.reply_to
+  end
+end
