diff --git a/app/mailboxes/support_mailbox.rb b/app/mailboxes/support_mailbox.rb
new file mode 100644
index 0000000..38e7b0a
--- /dev/null
+++ b/app/mailboxes/support_mailbox.rb
@@ -0,0 +1,327 @@
+require "cgi"
+require "securerandom"
+
+class SupportMailbox < ApplicationMailbox
+  class InvalidDeliveryError < StandardError; end
+
+  AUTOMATED_LOCAL_PART_PATTERN = /\A(?:mailer-daemon|postmaster|no-?reply|do-?not-reply|bounces?|auto(?:reply|responder)?)\z/i
+  AUTOMATED_PRECEDENCE_VALUES = %w[bulk list junk auto_reply auto-reply].freeze
+  LIST_HEADERS = %w[
+    List-Id
+    List-Unsubscribe
+    List-Post
+    List-Help
+    List-Subscribe
+    List-Owner
+    List-Archive
+    Mailing-List
+    X-Mailing-List
+  ].freeze
+  AUTO_REPLY_HEADERS = %w[
+    X-Auto-Response-Suppress
+    X-Autoreply
+    X-Autorespond
+    X-Failed-Recipients
+    X-Loop
+  ].freeze
+
+  before_processing :deduplicate_processed_message
+  before_processing :ignore_automated_or_list_mail
+  before_processing :resolve_sender
+  before_processing :resolve_recipients
+  before_processing :extract_message_body
+
+  def process
+    if @target_ticket
+      process_reply
+    else
+      process_new_ticket
+    end
+  end
+
+  private
+
+  def deduplicate_processed_message
+    if ProcessedInboundMessage.exists?(message_id: inbound_email.message_id)
+      delivered!
+    end
+  end
+
+  def ignore_automated_or_list_mail
+    if automated_or_list_mail?
+      bounced!
+    end
+  end
+
+  def resolve_sender
+    addr = safe_from_address
+    if addr.nil?
+      bounced!
+      return
+    end
+
+    @sender_email = addr.address.to_s.strip.downcase
+    unless @sender_email.match?(URI::MailTo::EMAIL_REGEXP)
+      bounced!
+      return
+    end
+
+    @sender_name = addr.display_name.to_s.strip.presence ||
+      addr.name.to_s.strip.presence ||
+      @sender_email.split("@").first.presence ||
+      @sender_email
+  end
+
+  def resolve_recipients
+    support_domain = SupportEmail.domain
+    domain_addresses = safe_recipient_addresses.select do |addr|
+      addr.domain.to_s.strip.downcase == support_domain
+    end
+    locals = domain_addresses.filter_map { |addr| addr.local.to_s.strip.downcase.presence }.uniq
+
+    if locals.empty?
+      bounced!
+      return
+    end
+
+    matched_accounts = []
+    matched_tickets = []
+
+    locals.each do |local|
+      if local.start_with?("reply+")
+        token = local.delete_prefix("reply+")
+        ticket = Ticket.includes(:account, :requester).find_by(reply_token: token)
+        if ticket.nil?
+          bounced!
+          return
+        end
+        matched_tickets << ticket
+        matched_accounts << ticket.account
+      else
+        account = Account.find_by(subdomain: local)
+        matched_accounts << account if account
+      end
+    end
+
+    accounts = matched_accounts.uniq(&:id)
+    tickets = matched_tickets.uniq(&:id)
+
+    if accounts.size != 1 || tickets.size > 1
+      bounced!
+      return
+    end
+
+    @target_account = accounts.first
+    if @target_account.cancelled?
+      bounced!
+      return
+    end
+
+    @target_ticket = tickets.first
+    if @target_ticket && (@target_ticket.requester.email != @sender_email || @target_ticket.requester.suspended?)
+      bounced!
+    end
+  end
+
+  def extract_message_body
+    @message_body = extract_plain_text_body
+    if @message_body.blank?
+      bounced!
+    end
+  end
+
+  def process_reply
+    Ticket.transaction do
+      @target_ticket.lock!
+
+      if @target_ticket.requester.email != @sender_email || @target_ticket.requester.suspended?
+        raise InvalidDeliveryError
+      end
+
+      comment = @target_ticket.comments.create!(
+        author: @target_ticket.requester,
+        body: @message_body,
+        public: true
+      )
+
+      if @target_ticket.pending? || @target_ticket.solved?
+        @target_ticket.update!(status: "open")
+      end
+
+      ProcessedInboundMessage.create!(
+        message_id: inbound_email.message_id,
+        ticket: @target_ticket,
+        comment: comment
+      )
+    end
+  rescue InvalidDeliveryError
+    bounced!
+  rescue ActiveRecord::RecordNotUnique
+    delivered!
+  end
+
+  def process_new_ticket
+    subject = mail.subject.to_s.strip
+    if subject.blank?
+      bounced!
+      return
+    end
+
+    verification_token = nil
+    created_user = nil
+
+    Ticket.transaction do
+      @target_account.lock!
+
+      user = @target_account.users.find_by(email: @sender_email)
+      if user
+        raise InvalidDeliveryError if user.suspended?
+      else
+        user = @target_account.users.build(
+          name: @sender_name,
+          email: @sender_email,
+          password: SecureRandom.urlsafe_base64(24),
+          role: "customer",
+          verified: false
+        )
+        user.save!
+        verification_token = user.generate_email_verification_token!
+        created_user = user
+      end
+
+      ticket = @target_account.tickets.create!(
+        requester: user,
+        subject: subject,
+        status: "open",
+        origin: "email",
+        email_message_id: inbound_email.message_id
+      )
+
+      comment = ticket.comments.create!(
+        author: user,
+        body: @message_body,
+        public: true
+      )
+
+      ProcessedInboundMessage.create!(
+        message_id: inbound_email.message_id,
+        ticket: ticket,
+        comment: comment
+      )
+    end
+
+    if verification_token && created_user
+      UserMailer.email_verification(created_user, verification_token).deliver_now
+    end
+  rescue InvalidDeliveryError
+    bounced!
+  rescue ActiveRecord::RecordNotUnique
+    delivered!
+  end
+
+  def automated_or_list_mail?
+    return true if mail.mime_type.to_s.downcase == "multipart/report"
+
+    auto_submitted_values = header_values("Auto-Submitted").map { |v| v.strip.downcase }
+    return true if auto_submitted_values.any? { |v| v.present? && v != "no" }
+
+    return true if LIST_HEADERS.any? { |name| header_values(name).any?(&:present?) }
+
+    precedence_values = header_values("Precedence").map { |v| v.strip.downcase }
+    return true if precedence_values.any? { |v| AUTOMATED_PRECEDENCE_VALUES.include?(v) }
+
+    return true if AUTO_REPLY_HEADERS.any? { |name| header_values(name).any?(&:present?) }
+
+    if mail.header["Return-Path"].present? && header_values("Return-Path").all?(&:blank?)
+      return true
+    end
+
+    from_addr = safe_from_address
+    if from_addr && from_addr.local.to_s.strip.match?(AUTOMATED_LOCAL_PART_PATTERN)
+      return true
+    end
+
+    false
+  end
+
+  def header_values(name)
+    Array(mail.header[name]).map { |field| field.value.to_s }
+  end
+
+  def safe_from_address
+    field = Array(mail.header[:from]).first
+    return nil unless field
+
+    element = field.respond_to?(:element) ? field.element : field.address_list
+    element&.addresses&.first
+  rescue Mail::Field::ParseError
+    nil
+  end
+
+  def safe_recipient_addresses
+    addresses = []
+
+    %i[to cc bcc].each do |field_name|
+      Array(mail.header[field_name]).each do |field|
+        element = field.respond_to?(:element) ? field.element : field.address_list
+        addresses.concat(Array(element&.addresses))
+      rescue Mail::Field::ParseError
+        next
+      end
+    end
+
+    %i[x_original_to x_forwarded_to].each do |field_name|
+      Array(mail.header[field_name]).each do |field|
+        addresses << Mail::Address.new(field.to_s)
+      rescue Mail::Field::ParseError
+        next
+      end
+    end
+
+    addresses
+  end
+
+  def extract_plain_text_body
+    text = if mail.multipart?
+      plain_part = find_part_by_mime_type(mail, "text/plain")
+      if plain_part
+        decode_part_text(plain_part)
+      elsif (html_part = find_part_by_mime_type(mail, "text/html"))
+        html_to_plain_text(decode_part_text(html_part))
+      else
+        ""
+      end
+    elsif mail.attachment?
+      ""
+    elsif mail.mime_type.nil? || mail.mime_type.downcase == "text/plain"
+      decode_part_text(mail)
+    elsif mail.mime_type.downcase == "text/html"
+      html_to_plain_text(decode_part_text(mail))
+    else
+      ""
+    end
+
+    text.gsub(/\r\n?/, "\n").strip
+  end
+
+  def find_part_by_mime_type(part, target_mime_type)
+    part.all_parts.find do |p|
+      !p.attachment? && p.mime_type.to_s.downcase == target_mime_type
+    end
+  end
+
+  def decode_part_text(part)
+    raw = part.body.decoded.to_s
+    charset = part.charset.presence || mail.charset.presence
+    if charset && raw.encoding == Encoding::BINARY
+      raw = raw.dup.force_encoding(Encoding.find(charset)) rescue raw
+    end
+    raw.encode("UTF-8", invalid: :replace, undef: :replace, replace: "")
+  end
+
+  def html_to_plain_text(html)
+    with_breaks = html.gsub(/<\s*(?:br\s*\/?|\/p|\/div|\/li|\/tr)\s*>/i, "\n")
+    stripped = ActionView::Base.full_sanitizer.sanitize(with_breaks)
+    CGI.unescapeHTML(stripped.to_s)
+  end
+end
diff --git a/app/mailers/ticket_mailer.rb b/app/mailers/ticket_mailer.rb
new file mode 100644
index 0000000..c644c5b
--- /dev/null
+++ b/app/mailers/ticket_mailer.rb
@@ -0,0 +1,27 @@
+class TicketMailer < ApplicationMailer
+  def staff_reply(ticket, comment)
+    @ticket = ticket
+    @comment = comment
+    @account = ticket.account
+    @requester = ticket.requester
+    @author = comment.author
+
+    if @ticket.email_message_id.present?
+      headers["In-Reply-To"] = "<#{@ticket.email_message_id}>"
+      headers["References"] = "<#{@ticket.email_message_id}>"
+    end
+
+    mail(
+      from: SupportEmail.account_address(@account),
+      reply_to: @ticket.reply_address,
+      to: @requester.email,
+      subject: reply_subject(@ticket.subject)
+    )
+  end
+
+  private
+
+  def reply_subject(subject)
+    subject.match?(/\Are:/i) ? subject : "Re: #{subject}"
+  end
+end
