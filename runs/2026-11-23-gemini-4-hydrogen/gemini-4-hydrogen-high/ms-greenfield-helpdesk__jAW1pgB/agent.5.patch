+test "decodes non-UTF8 charsets and handles cancelled accounts and HTML-only fallback" do
+  acme = Account.create!(name: "Acme", subdomain: "acme")
+  cancelled = Account.create!(name: "Old", subdomain: "old", cancelled_at: 1.day.ago)
+
+  # Cancelled account ignores mail
+  post_relay_email(build_rfc822(
+    from: "avery@example.test",
+    to: "old@support.example.test",
+    subject: "Help",
+    body: "Hello",
+    message_id: "<cancelled-1@example.test>"
+  ))
+  assert_response :no_content
+  assert_equal 0, cancelled.tickets.count
+
+  # ISO-8859-1 charset email
+  iso_mail = Mail.new do
+    from "avery@example.test"
+    to "acme@support.example.test"
+    subject "Charset test"
+    content_type "text/plain; charset=ISO-8859-1"
+    content_transfer_encoding "quoted-printable"
+    body "Caf\xE9".b
+  end
+  iso_mail.message_id = "<iso-1@example.test>"
+  post_relay_email(iso_mail.to_s)
+  assert_response :no_content
+  assert_equal "Café", acme.tickets.last.comments.last.body
+
+  # HTML-only fallback extracts text
+  html_mail = Mail.new do
+    from "avery@example.test"
+    to "acme@support.example.test"
+    subject "HTML only"
+    content_type "text/html; charset=UTF-8"
+    body "<p>Line one</p><p>Line two</p>"
+  end
+  html_mail.message_id = "<html-1@example.test>"
+  post_relay_email(html_mail.to_s)
+  assert_response :no_content
+  assert_equal "Line one\nLine two", acme.tickets.last.comments.last.body
+end
+end
