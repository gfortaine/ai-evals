+  test "deduplicates deliveries by Message-ID and invalid deliveries do not block later valid retries" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+
+    raw1 = build_rfc822(
+      from: "avery@example.test",
+      to: "acme@support.example.test",
+      subject: "Dedup test",
+      body: "First delivery",
+      message_id: "<dedup-1@example.test>"
+    )
+    post_relay_email(raw1)
+    assert_response :no_content
+    assert_equal 1, acme.tickets.count
+    assert_equal 1, ActionMailer::Base.deliveries.size
+
+    # Identical retry -> deduplicated
+    post_relay_email(raw1)
+    assert_response :no_content
+    assert_equal 1, acme.tickets.count
+    assert_equal 1, ActionMailer::Base.deliveries.size
+
+    # Different raw bytes, same Message-ID -> still deduplicated
+    raw1_modified = build_rfc822(
+      from: "avery@example.test",
+      to: "acme@support.example.test",
+      subject: "Dedup test",
+      body: "First delivery",
+      message_id: "<dedup-1@example.test>",
+      extra_headers: { "X-Relay-Hop" => "2" }
+    )
+    post_relay_email(raw1_modified)
+    assert_response :no_content
+    assert_equal 1, acme.tickets.count
+    assert_equal 1, ActionMailer::Base.deliveries.size
+
+    # Invalid delivery (missing subject) with Message-ID <retry-1@example.test>
+    invalid_raw = build_rfc822(
