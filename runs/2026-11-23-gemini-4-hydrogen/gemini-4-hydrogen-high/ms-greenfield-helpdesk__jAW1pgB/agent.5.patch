+  # Valid retry with same Message-ID + Reply-All (to reply_addr and cc acme@) succeeds
+  retry_raw = build_rfc822(
+    from: "avery@example.test",
+    to: reply_addr,
+    cc: "acme@support.example.test",
+    subject: "Re: Reply-all test",
