diff --git a/test/integration/helpdesk_inbound_email_test.rb b/test/integration/helpdesk_inbound_email_test.rb
new file mode 100644
index 0000000..4ba519f
--- /dev/null
+++ b/test/integration/helpdesk_inbound_email_test.rb
@@ -0,0 +1,658 @@
+require "test_helper"
+require "base64"
+
+class HelpdeskInboundEmailTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @prev_password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"]
+    @prev_domain = ENV["HELPDESK_SUPPORT_DOMAIN"]
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = "inbound-secret"
+    ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+  end
+
+  teardown do
+    ActionMailer::Base.deliveries.clear
+    if @prev_password.nil?
+      ENV.delete("RAILS_INBOUND_EMAIL_PASSWORD")
+    else
+      ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @prev_password
+    end
+
+    if @prev_domain.nil?
+      ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+    else
+      ENV["HELPDESK_SUPPORT_DOMAIN"] = @prev_domain
+    end
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def relay_auth_header(password = "inbound-secret")
+    encoded = Base64.strict_encode64("actionmailbox:#{password}")
+    { "Authorization" => "Basic #{encoded}" }
+  end
+
+  def post_relay_email(raw_email, headers: {})
+    post "/rails/action_mailbox/relay/inbound_emails",
+      params: raw_email,
+      headers: {
+        "CONTENT_TYPE" => "message/rfc822"
+      }.merge(relay_auth_header).merge(headers)
+  end
+
+  def build_rfc822(from:, to:, subject:, body: nil, cc: nil, message_id: nil, extra_headers: {}, &block)
+    mail = Mail.new do
+      from from if from
+      to to if to
+      cc cc if cc
+      subject subject if subject
+      body body if body && !block
+    end
+    mail.message_id = message_id if message_id
+    extra_headers.each { |k, v| mail.header[k] = v }
+    yield mail if block
+    mail.to_s
+  end
+
+  def create_verified_staff(account, email: "jo@acme.test", name: "Jo", role: "admin", password: "staff-password")
+    user = account.users.create!(
+      name: name,
+      email: email,
+      password: password,
+      role: role,
+      verified: true,
+      verified_at: Time.current
+    )
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => account.subdomain },
+      params: { session: { email: email, password: password } },
+      as: :json
+    assert_response :created
+    [ user, json_body.dig("session", "token") ]
+  end
+
+  test "relay ingress enforces authentication and content-type and processes mail synchronously in test" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    raw = build_rfc822(
+      from: "Avery <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Sync test",
+      body: "Hello support",
+      message_id: "<sync-1@example.test>"
+    )
+
+    # Missing auth -> 401
+    post "/rails/action_mailbox/relay/inbound_emails",
+      params: raw,
+      headers: { "CONTENT_TYPE" => "message/rfc822" }
+    assert_response :unauthorized
+    assert_equal 0, acme.tickets.count
+
+    # Wrong password -> 401
+    post "/rails/action_mailbox/relay/inbound_emails",
+      params: raw,
+      headers: { "CONTENT_TYPE" => "message/rfc822" }.merge(relay_auth_header("wrong"))
+    assert_response :unauthorized
+    assert_equal 0, acme.tickets.count
+
+    # Wrong content-type -> 415
+    post "/rails/action_mailbox/relay/inbound_emails",
+      params: raw,
+      headers: { "CONTENT_TYPE" => "text/plain" }.merge(relay_auth_header)
+    assert_response :unsupported_media_type
+    assert_equal 0, acme.tickets.count
+
+    # Valid relay request processes immediately before response completes
+    post_relay_email(raw)
+    assert_response :no_content
+    assert_equal 1, acme.tickets.count
+    ticket = acme.tickets.first
+    assert_equal "Sync test", ticket.subject
+    assert_equal "email", ticket.origin
+    assert_equal [ "Hello support" ], ticket.comments.pluck(:body)
+  end
+
+  test "new customer email creates unverified user, sends verification, and allows later portal access" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+
+    raw = build_rfc822(
+      from: "Avery Customer <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Cannot log in",
+      body: nil,
+      message_id: "<new-cust-1@example.test>"
+    ) do |mail|
+      mail.text_part = Mail::Part.new do
+        body "Plain text message body"
+      end
+      mail.html_part = Mail::Part.new do
+        content_type "text/html; charset=UTF-8"
+        body "<p>HTML body should not be used</p>"
+      end
+    end
+
+    post_relay_email(raw)
+    assert_response :no_content
+
+    customer = acme.users.find_by!(email: "avery@example.test")
+    assert_equal "Avery Customer", customer.name
+    assert_equal "customer", customer.role
+    assert_equal false, customer.verified?
+
+    # Verification email sent
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    ver_mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "avery@example.test" ], ver_mail.to
+    ver_body = ver_mail.text_part.body.decoded
+    token = CGI.unescape(ver_body.match(/token=([^\s&"']+)/)[1])
+
+    # Receiving email didn't verify account, so signing in is blocked until confirmed
+    assert_equal 1, acme.tickets.count
+    ticket = acme.tickets.first
+    assert_equal "Cannot log in", ticket.subject
+    assert_equal "Plain text message body", ticket.comments.first.body
+
+    # Customer verifies email, resets password, signs in, and sees their ticket in portal
+    post "/api/v1/email_verifications/confirm",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { email_verification: { token: token } },
+      as: :json
+    assert_response :ok
+    assert_equal true, customer.reload.verified?
+
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/password_resets",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { password_reset: { email: "avery@example.test" } },
+      as: :json
+    assert_response :ok
+    reset_body = ActionMailer::Base.deliveries.last.text_part.body.decoded
+    reset_token = CGI.unescape(reset_body.match(/token=([^\s&"']+)/)[1])
+
+    post "/api/v1/password_resets/confirm",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { password_reset: { token: reset_token, password: "portal-password-1" } },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { session: { email: "avery@example.test", password: "portal-password-1" } },
+      as: :json
+    assert_response :created
+    cust_token = json_body.dig("session", "token")
+
+    get "/api/v1/requests",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{cust_token}" }
+    assert_response :ok
+    assert_equal [ ticket.id ], json_body["requests"].map { |r| r["id"] }
+  end
+
+  test "reuses existing verified or unverified customer without verifying or resending verification" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    unverified = acme.users.create!(
+      name: "Unverified Cust",
+      email: "unver@example.test",
+      password: "password123",
+      role: "customer",
+      verified: false
+    )
+    verified = acme.users.create!(
+      name: "Verified Cust",
+      email: "ver@example.test",
+      password: "password123",
+      role: "customer",
+      verified: true,
+      verified_at: Time.current
+    )
+
+    post_relay_email(build_rfc822(
+      from: "unver@example.test",
+      to: "acme@support.example.test",
+      subject: "Question 1",
+      body: "Still unverified",
+      message_id: "<reuse-1@example.test>"
+    ))
+    assert_response :no_content
+    assert_equal false, unverified.reload.verified?
+    assert_equal 0, ActionMailer::Base.deliveries.size
+    assert_equal unverified.id, acme.tickets.last.requester_id
+
+    post_relay_email(build_rfc822(
+      from: "ver@example.test",
+      to: "acme@support.example.test",
+      subject: "Question 2",
+      body: "Already verified",
+      message_id: "<reuse-2@example.test>"
+    ))
+    assert_response :no_content
+    assert_equal true, verified.reload.verified?
+    assert_equal 0, ActionMailer::Base.deliveries.size
