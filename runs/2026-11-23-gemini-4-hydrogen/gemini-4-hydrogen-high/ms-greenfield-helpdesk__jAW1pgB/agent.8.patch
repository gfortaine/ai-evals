+  test "cursor pagination validates size, mutually exclusive cursors, and malformed or mismatched cursors" do
+    owner_token, = create_account_and_owner
+    customer_token, = register_verify_signin_customer
+
+    post "/api/v1/requests",
+      headers: auth_headers(customer_token),
+      params: { request: { subject: "Ticket 1", comment: { body: "Body 1" } } },
+      as: :json
+    assert_response :created
+
+    # Get valid cursors from tickets and users
+    get "/api/v1/tickets?page[size]=1", headers: auth_headers(owner_token)
+    assert_response :ok
+    ticket_cursor = json_body.dig("meta", "after_cursor")
+
+    get "/api/v1/users?page[size]=1", headers: auth_headers(owner_token)
+    assert_response :ok
+    users_cursor = json_body.dig("meta", "after_cursor")
+
+    # Invalid page[size]
+    [ "0", "-1", "abc" ].each do |bad_size|
+      get "/api/v1/tickets",
+        headers: auth_headers(owner_token),
+        params: { page: { size: bad_size } }
+      assert_response :unprocessable_entity
+      assert_equal "Invalid page[size] parameter", json_body["error"]
+    end
+
+    # Both after and before provided
+    get "/api/v1/tickets",
+      headers: auth_headers(owner_token),
+      params: { page: { after: ticket_cursor, before: ticket_cursor, size: 10 } }
+    assert_response :unprocessable_entity
+    assert_equal "Cannot specify both page[after] and page[before]", json_body["error"]
+
+    # Malformed / out-of-range / wrong-collection cursors
+    out_of_range_cursor = Base64.urlsafe_encode64(
+      JSON.generate({ "v" => 1, "k" => "tickets_recently_active", "val" => [ "2026-11-22T10:00:00.000000Z", 99_999_999_999_999_999_999 ] }),
+      padding: false
+    )
+    bad_ts_cursor = Base64.urlsafe_encode64(
+      JSON.generate({ "v" => 1, "k" => "tickets_recently_active", "val" => [ "not-a-timestamp", 1 ] }),
+      padding: false
+    )
+    binary_cursor = "____"
+
+    [ "not!valid!base64", users_cursor, out_of_range_cursor, bad_ts_cursor, binary_cursor ].each do |bad_cursor|
+      get "/api/v1/tickets",
+        headers: auth_headers(owner_token),
+        params: { page: { after: bad_cursor, size: 10 } }
+      assert_response :unprocessable_entity
+      assert_equal "Invalid pagination cursor", json_body["error"]
+    end
+
+    # page[after] without page[size] defaults to 25 (and size > 100 clamps to 100)
+    get "/api/v1/tickets",
+      headers: auth_headers(owner_token),
+      params: { page: { after: ticket_cursor } }
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+
+    get "/api/v1/tickets",
+      headers: auth_headers(owner_token),
+      params: { page: { size: 500 } }
+    assert_response :ok
+    assert_equal 1, json_body["tickets"].size
+  end
+end
