+++ b/test/integration/helpdesk_cursor_pagination_test.rb
@@ -0,0 +1,604 @@
+require "test_helper"
+require "base64"
+require "json"
+require "uri"
+
+class HelpdeskCursorPaginationTest < ActionDispatch::IntegrationTest
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def extract_token_from_last_email
+    mail = ActionMailer::Base.deliveries.last
+    assert_not_nil mail
+    body = mail.text_part ? mail.text_part.body.decoded : mail.body.decoded
+    match = body.match(/token=([^\s&"']+)/)
+    assert_not_nil match, "Expected token in email body: #{body}"
+    CGI.unescape(match[1])
+  end
+
+  def create_account_and_owner(subdomain: "acme", name: "Acme", email: "jo@acme.test", admin_name: "Jo", password: "owner-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: {
+            name: admin_name,
+            email: email,
+            password: password
+          }
+        }
+      },
+      as: :json
+    assert_response :created
+    owner_id = json_body.dig("user", "id")
+
+    token = extract_token_from_last_email
+    post "/api/v1/email_verifications/confirm",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { email_verification: { token: token } },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { session: { email: email, password: password } },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    [ json_body.dig("session", "token"), owner_id ]
+  end
+
+  def register_verify_signin_customer(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    post "/api/v1/registrations",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: {
+        user: {
+          name: name,
+          email: email,
+          password: password
+        }
+      },
+      as: :json
+    assert_response :created
+    user_id = json_body.dig("user", "id")
+
+    token = extract_token_from_last_email
+    post "/api/v1/email_verifications/confirm",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { email_verification: { token: token } },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { session: { email: email, password: password } },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    [ json_body.dig("session", "token"), user_id ]
+  end
+
+  def invite_accept_signin_staff(owner_token:, email:, name:, role: "agent", subdomain: "acme", password: "staff-password")
+    post "/api/v1/invitations",
+      headers: { "X-Helpdesk-Account" => subdomain, "Authorization" => "Bearer #{owner_token}" },
+      params: { invitation: { email: email, role: role } },
+      as: :json
+    assert_response :created
+    invite_token = extract_token_from_last_email
+
+    post "/api/v1/invitation_acceptances",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { invitation_acceptance: { token: invite_token, name: name, password: password } },
+      as: :json
+    assert_response :created
+    user_id = json_body.dig("user", "id")
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { session: { email: email, password: password } },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    [ json_body.dig("session", "token"), user_id ]
+  end
+
+  def auth_headers(token, subdomain: "acme")
+    { "X-Helpdesk-Account" => subdomain, "Authorization" => "Bearer #{token}" }
+  end
+
+  test "empty collection cursor response matches contract and preserves page-number API" do
+    owner_token, = create_account_and_owner
+
+    get "/api/v1/tickets?page[size]=25&status=open",
+      headers: auth_headers(owner_token)
+    assert_response :ok
+    assert_equal(
+      {
+        "tickets" => [],
+        "meta" => {
+          "has_more" => false,
+          "after_cursor" => nil,
+          "before_cursor" => nil
+        },
+        "links" => {
+          "next" => nil,
+          "prev" => nil
+        }
+      },
+      json_body
+    )
+
+    # Page-number API still works identically
+    get "/api/v1/tickets",
+      headers: auth_headers(owner_token),
+      params: { page: 1, per_page: 25, status: "open" }
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+    assert_equal 0, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_nil json_body["next_page"]
+    assert_nil json_body["previous_page"]
+  end
+
+  test "tickets cursor pagination forward and backward with filters, tie-breakers, and no COUNT/OFFSET" do
+    owner_token, = create_account_and_owner
+    customer_token, = register_verify_signin_customer
+
+    # Create 5 open tickets (2 with identical timestamps to test id tie-breaker) and 1 solved ticket
+    open_ids = []
+    travel_to Time.utc(2026, 11, 22, 10, 0, 0) do
+      2.times do |i|
+        post "/api/v1/requests",
+          headers: auth_headers(customer_token),
+          params: { request: { subject: "Same time #{i}", comment: { body: "Body #{i}" } } },
+          as: :json
+        assert_response :created
+        open_ids << json_body.dig("request", "id")
+      end
+    end
+
+    3.times do |i|
+      travel_to Time.utc(2026, 11, 22, 10, 1 + i, 0) do
+        post "/api/v1/requests",
+          headers: auth_headers(customer_token),
+          params: { request: { subject: "Later #{i}", comment: { body: "Body #{i}" } } },
+          as: :json
+        assert_response :created
+        open_ids << json_body.dig("request", "id")
+      end
+    end
+
+    # Solved ticket that must be excluded by status=open filter
+    travel_to Time.utc(2026, 11, 22, 11, 0, 0) do
+      post "/api/v1/requests",
+        headers: auth_headers(customer_token),
+        params: { request: { subject: "Solved one", comment: { body: "Done" } } },
+        as: :json
+      assert_response :created
+      solved_id = json_body.dig("request", "id")
+      patch "/api/v1/tickets/#{solved_id}",
+        headers: auth_headers(owner_token),
+        params: { ticket: { status: "solved" } },
+        as: :json
+      assert_response :ok
+    end
+
+    expected_order = open_ids.reverse # recently_active: updated_at DESC, id DESC
+
+    # Capture SQL queries during cursor browsing to ensure no COUNT(*) or OFFSET
+    sql_queries = []
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |_, _, _, _, payload|
+      sql_queries << payload[:sql] unless payload[:name] == "SCHEMA"
+    end
+
+    begin
+      # Page 1: size 2 with status=open
+      get "/api/v1/tickets?page[size]=2&status=open",
+        headers: auth_headers(owner_token)
+      assert_response :ok
+      assert_equal expected_order[0..1], json_body["tickets"].map { |t| t["id"] }
+      assert_equal true, json_body.dig("meta", "has_more")
+      assert_not_nil json_body.dig("meta", "before_cursor")
+      assert_not_nil json_body.dig("meta", "after_cursor")
+      assert_nil json_body.dig("links", "prev")
+      next_link_1 = json_body.dig("links", "next")
+      assert_not_nil next_link_1
+
+      # Verify filter preserved in link
+      next_uri = URI.parse(next_link_1)
+      assert_equal "/api/v1/tickets", next_uri.path
+      parsed_q = Rack::Utils.parse_nested_query(next_uri.query)
+      assert_equal "open", parsed_q["status"]
+      assert_equal "2", parsed_q.dig("page", "size")
+
+      # Page 2 via links.next
+      get next_link_1, headers: auth_headers(owner_token)
+      assert_response :ok
+      assert_equal expected_order[2..3], json_body["tickets"].map { |t| t["id"] }
+      assert_equal true, json_body.dig("meta", "has_more")
+      prev_link_2 = json_body.dig("links", "prev")
+      next_link_2 = json_body.dig("links", "next")
+      assert_not_nil prev_link_2
+      assert_not_nil next_link_2
+
+      # Page 3 (final partial page) via links.next
+      get next_link_2, headers: auth_headers(owner_token)
+      assert_response :ok
+      assert_equal expected_order[4..4], json_body["tickets"].map { |t| t["id"] }
+      assert_equal false, json_body.dig("meta", "has_more")
+      # Even on a 1-record populated page, both cursors are provided for first and last record
+      assert_equal json_body.dig("meta", "before_cursor"), json_body.dig("meta", "after_cursor")
+      assert_not_nil json_body.dig("meta", "before_cursor")
+      assert_nil json_body.dig("links", "next")
+      prev_link_3 = json_body.dig("links", "prev")
+      assert_not_nil prev_link_3
+
+      # Navigate backward from page 3 -> page 2
+      get prev_link_3, headers: auth_headers(owner_token)
+      assert_response :ok
+      assert_equal expected_order[2..3], json_body["tickets"].map { |t| t["id"] }
+      assert_equal true, json_body.dig("meta", "has_more")
+      assert_not_nil json_body.dig("links", "next")
+      prev_link_back = json_body.dig("links", "prev")
+      assert_not_nil prev_link_back
+
+      # Navigate backward from page 2 -> page 1
+      get prev_link_back, headers: auth_headers(owner_token)
+      assert_response :ok
+      assert_equal expected_order[0..1], json_body["tickets"].map { |t| t["id"] }
+      assert_equal false, json_body.dig("meta", "has_more")
+      assert_nil json_body.dig("links", "prev")
+      assert_not_nil json_body.dig("links", "next")
+
+      # Explicit page[after] past the very last record returns empty structure
+      last_cursor = nil
+      get next_link_2, headers: auth_headers(owner_token)
+      last_cursor = json_body.dig("meta", "after_cursor")
+      get "/api/v1/tickets",
+        headers: auth_headers(owner_token),
+        params: { page: { after: last_cursor, size: 2 }, status: "open" }
+      assert_response :ok
+      assert_equal [], json_body["tickets"]
+      assert_equal false, json_body.dig("meta", "has_more")
+      assert_nil json_body.dig("meta", "after_cursor")
+      assert_nil json_body.dig("meta", "before_cursor")
+      assert_nil json_body.dig("links", "next")
+      assert_nil json_body.dig("links", "prev")
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+
+    assert_empty sql_queries.select { |q| q.match?(/\bCOUNT\s*\(/i) }, "Cursor pagination must not run COUNT queries"
+    assert_empty sql_queries.select { |q| q.match?(/\bOFFSET\b/i) }, "Cursor pagination must not use OFFSET"
+  end
+
+  test "navigation remains stable while other people create, update, close, and delete records" do
+    owner_token, = create_account_and_owner
+    customer_token, = register_verify_signin_customer
+
+    ticket_ids = []
+    6.times do |i|
+      travel_to Time.utc(2026, 11, 22, 9, 0, 0) + i.minutes do
+        post "/api/v1/requests",
+          headers: auth_headers(customer_token),
+          params: { request: { subject: "Ticket #{i + 1}", comment: { body: "Initial #{i + 1}" } } },
+          as: :json
+        assert_response :created
+        ticket_ids << json_body.dig("request", "id")
+      end
+    end
+
+    # Canonical order: [T6, T5, T4, T3, T2, T1]
+    ordered = ticket_ids.reverse
+
+    # 1. Load Page 1 of /api/v1/tickets?page[size]=2&status=open -> [T6, T5]
+    get "/api/v1/tickets?page[size]=2&status=open", headers: auth_headers(owner_token)
+    assert_response :ok
+    assert_equal ordered[0..1], json_body["tickets"].map { |t| t["id"] }
+    page1_next = json_body.dig("links", "next")
+    page1_after_cursor = json_body.dig("meta", "after_cursor")
+
+    # 2. Meanwhile, other people work:
+    #    - New ticket T7 is created
+    #    - Boundary ticket T5 is updated with a comment (moves to top) AND solved (leaves status=open!)
+    travel_to Time.utc(2026, 11, 22, 10, 0, 0) do
+      post "/api/v1/requests",
+        headers: auth_headers(customer_token),
+        params: { request: { subject: "Ticket 7", comment: { body: "Brand new" } } },
+        as: :json
+      assert_response :created
+
+      patch "/api/v1/tickets/#{ordered[1]}",
+        headers: auth_headers(owner_token),
+        params: { ticket: { status: "solved", comment: { body: "Solved while browsing" } } },
+        as: :json
+      assert_response :ok
+    end
+
+    # 3. Following page1_next MUST still yield [T4, T3] cleanly without duplicating T6/T5 or skipping T4
+    get page1_next, headers: auth_headers(owner_token)
+    assert_response :ok
+    assert_equal ordered[2..3], json_body["tickets"].map { |t| t["id"] }
+    assert_equal true, json_body.dig("meta", "has_more")
+    page2_prev = json_body.dig("links", "prev")
+    assert_not_nil page2_prev
+
+    # Also test sending page[after] directly
+    get "/api/v1/tickets",
+      headers: auth_headers(owner_token),
+      params: { page: { after: page1_after_cursor, size: 2 }, status: "open" }
+    assert_response :ok
+    assert_equal ordered[2..3], json_body["tickets"].map { |t| t["id"] }
+
+    # 4. Internal staff note on T4 does NOT disturb customer's /api/v1/requests order
+    get "/api/v1/requests?page[size]=2", headers: auth_headers(customer_token)
+    assert_response :ok
+    req_page1_ids = json_body["requests"].map { |r| r["id"] }
+    req_next = json_body.dig("links", "next")
+
+    travel_to Time.utc(2026, 11, 22, 11, 0, 0) do
+      patch "/api/v1/tickets/#{req_page1_ids.last}",
+        headers: auth_headers(owner_token),
+        params: { ticket: { comment: { body: "Internal note", public: false } } },
+        as: :json
+      assert_response :ok
+    end
+
+    get req_next, headers: auth_headers(customer_token)
+    assert_response :ok
+    req_page2_ids = json_body["requests"].map { |r| r["id"] }
+    assert_empty(req_page1_ids & req_page2_ids)
+
+    # 5. Deletion stability on /api/v1/groups: deleting the boundary group does not break page[after]
+    group_ids = %w[G1 G2 G3 G4].map do |gname|
+      post "/api/v1/groups",
+        headers: auth_headers(owner_token),
+        params: { group: { name: gname } },
+        as: :json
+      assert_response :created
+      json_body.dig("group", "id")
+    end
+
+    get "/api/v1/groups?page[size]=2", headers: auth_headers(owner_token)
+    assert_response :ok
+    assert_equal group_ids[0..1], json_body["groups"].map { |g| g["id"] }
+    groups_next = json_body.dig("links", "next")
+
+    # Delete both G1 and G2 (including boundary record G2)
+    delete "/api/v1/groups/#{group_ids[0]}", headers: auth_headers(owner_token)
+    assert_response :no_content
+    delete "/api/v1/groups/#{group_ids[1]}", headers: auth_headers(owner_token)
+    assert_response :no_content
+
+    # Following groups_next still returns [G3, G4], and links.prev accurately becomes nil since G1 & G2 were deleted
+    get groups_next, headers: auth_headers(owner_token)
+    assert_response :ok
+    assert_equal group_ids[2..3], json_body["groups"].map { |g| g["id"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+    assert_nil json_body.dig("links", "next")
+    assert_nil json_body.dig("links", "prev")
+  end
+
+  test "cursor pagination works across all remaining collections and preserves page-number API" do
+    owner_token, owner_id = create_account_and_owner
