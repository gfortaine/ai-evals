+
+    # 1. /api/v1/tickets/:id/comments
+    get "/api/v1/tickets/#{ticket_id}/comments?page[size]=2", headers: auth_headers(owner_token)
+    assert_response :ok
+    assert_equal [ "C1", "C2 private" ], json_body["comments"].map { |c| c["body"] }
+    assert_equal true, json_body.dig("meta", "has_more")
+    get json_body.dig("links", "next"), headers: auth_headers(owner_token)
+    assert_response :ok
+    assert_equal [ "C3 public", "C4 public" ], json_body["comments"].map { |c| c["body"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+    get json_body.dig("links", "prev"), headers: auth_headers(owner_token)
+    assert_response :ok
+    assert_equal [ "C1", "C2 private" ], json_body["comments"].map { |c| c["body"] }
+
+    # 2. /api/v1/requests/:id/comments (public only)
+    get "/api/v1/requests/#{ticket_id}/comments?page[size]=2", headers: auth_headers(cust_token)
+    assert_response :ok
+    assert_equal [ "C1", "C3 public" ], json_body["comments"].map { |c| c["body"] }
+    assert_equal true, json_body.dig("meta", "has_more")
