+++ b/test/integration/helpdesk_auth_test.rb
@@ -0,0 +1,462 @@
+require "test_helper"
+
+class HelpdeskAuthTest < ActionDispatch::IntegrationTest
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  teardown do
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def signup_acme(email: "jo@acme.test", subdomain: "acme", name: "Acme", admin_name: "Jo", password: "my-first-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: {
+            name: admin_name,
+            email: email,
+            password: password
+          }
+        }
+      },
+      as: :json
+  end
+
+  def extract_token_from_last_email
+    mail = ActionMailer::Base.deliveries.last
+    assert_not_nil mail
+    body = mail.text_part ? mail.text_part.body.decoded : mail.body.decoded
+    match = body.match(/token=([^\s&"']+)/)
+    assert_not_nil match, "Expected token in email body: #{body}"
+    CGI.unescape(match[1])
+  end
+
+  def verify_and_signin(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token = extract_token_from_last_email
+    post "/api/v1/email_verifications/confirm",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { email_verification: { token: token } },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { session: { email: email, password: password } },
+      as: :json
+    assert_response :created
+    json_body.dig("session", "token")
+  end
+
+  test "full signup, verification, login, profile, password change, and signout flow" do
+    signup_acme
+    assert_response :created
+
+    body = json_body
+    assert_equal "Acme", body.dig("account", "name")
+    assert_equal "acme", body.dig("account", "subdomain")
+    assert_not_nil body.dig("account", "id")
+    assert_not_nil body.dig("account", "created_at")
+    assert_not_nil body.dig("account", "updated_at")
+
+    assert_equal "Jo", body.dig("user", "name")
+    assert_equal "jo@acme.test", body.dig("user", "email")
+    assert_equal "admin", body.dig("user", "role")
+    assert_equal false, body.dig("user", "verified")
+    assert_not_nil body.dig("user", "id")
+    assert_not_nil body.dig("user", "created_at")
+    assert_not_nil body.dig("user", "updated_at")
+    assert_nil body.dig("user", "password_digest")
+
+    # Verification email sent
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "support@example.test" ], mail.from
+    assert_equal [ "jo@acme.test" ], mail.to
+    assert_includes mail.text_part.body.decoded, "http://localhost:3001/verify-email?account=acme&token="
+
+    # Unverified user cannot sign in
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      as: :json
+    assert_response :forbidden
+
+    # Request a new verification link; old link should stop working
+    old_token = extract_token_from_last_email
+    post "/api/v1/email_verifications",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { email_verification: { email: "jo@acme.test" } },
+      as: :json
+    assert_response :ok
+    assert_equal 2, ActionMailer::Base.deliveries.size
+    new_token = extract_token_from_last_email
+    assert_not_equal old_token, new_token
+
+    post "/api/v1/email_verifications/confirm",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { email_verification: { token: old_token } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Confirm with new token
+    post "/api/v1/email_verifications/confirm",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { email_verification: { token: new_token } },
+      as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "verified")
+
+    # Token is single-use
+    post "/api/v1/email_verifications/confirm",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { email_verification: { token: new_token } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Public portal endpoint
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :ok
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, json_body)
+
+    # Signed-in account endpoint requires auth
+    get "/api/v1/account", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :unauthorized
+
+    # Sign in creates two sessions
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      as: :json
+    assert_response :created
+    token1 = json_body.dig("session", "token")
+    assert_not_nil token1
+    assert_equal "Acme", json_body.dig("account", "name")
+    assert_equal "Jo", json_body.dig("user", "name")
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      as: :json
+    assert_response :created
+    token2 = json_body.dig("session", "token")
+
+    # GET /account
+    get "/api/v1/account",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" }
+    assert_response :ok
+    assert_equal "Acme", json_body.dig("account", "name")
+    assert_not_nil json_body.dig("account", "id")
+
+    # GET /me and PATCH /me
+    get "/api/v1/me",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" }
+    assert_response :ok
+    assert_equal "Jo", json_body.dig("user", "name")
+
+    patch "/api/v1/me",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" },
+      params: { user: { name: "Jo Smith", role: "customer" } },
+      as: :json
+    assert_response :ok
+    assert_equal "Jo Smith", json_body.dig("user", "name")
+    assert_equal "admin", json_body.dig("user", "role")
+
+    # DELETE /session only signs out token2
+    delete "/api/v1/session",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token2}" }
+    assert_response :no_content
+
+    get "/api/v1/me",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token2}" }
+    assert_response :unauthorized
+
+    get "/api/v1/me",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" }
+    assert_response :ok
+
+    # Wrong current password rejected
+    put "/api/v1/me/password",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" },
+      params: { password_change: { current_password: "wrong-password", password: "my-new-password" } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Change password signs out existing sessions
+    put "/api/v1/me/password",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" },
+      params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" }
+    assert_response :unauthorized
+
+    # Old password fails, new password succeeds
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      as: :json
+    assert_response :unauthorized
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { session: { email: "jo@acme.test", password: "my-new-password" } },
+      as: :json
+    assert_response :created
+  end
+
+  test "same email can belong to different businesses and sessions are tenant-isolated" do
+    signup_acme(email: "jo@shared.test", subdomain: "acme", name: "Acme")
+    assert_response :created
+    token_acme = verify_and_signin(subdomain: "acme", email: "jo@shared.test")
+
+    signup_acme(email: "jo@shared.test", subdomain: "beta", name: "Beta")
+    assert_response :created
+    token_beta = verify_and_signin(subdomain: "beta", email: "jo@shared.test")
+
+    # Acme token cannot access Beta
+    get "/api/v1/me",
+      headers: { "X-Helpdesk-Account" => "beta", "Authorization" => "Bearer #{token_acme}" }
+    assert_response :unauthorized
+
+    # Beta token works on Beta
+    get "/api/v1/account",
+      headers: { "X-Helpdesk-Account" => "beta", "Authorization" => "Bearer #{token_beta}" }
+    assert_response :ok
+    assert_equal "beta", json_body.dig("account", "subdomain")
+  end
+
+  test "password reset flow replaces old tokens and signs out existing sessions" do
+    signup_acme
+    session_token = verify_and_signin
+
+    post "/api/v1/password_resets",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { password_reset: { email: "jo@acme.test" } },
+      as: :json
+    assert_response :ok
+    old_reset_token = extract_token_from_last_email
+
+    # Requesting another link replaces old one
+    post "/api/v1/password_resets",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { password_reset: { email: "jo@acme.test" } },
+      as: :json
+    assert_response :ok
+    new_reset_token = extract_token_from_last_email
+    assert_not_equal old_reset_token, new_reset_token
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_includes mail.text_part.body.decoded, "http://localhost:3001/reset-password?account=acme&token=#{new_reset_token}"
+
+    # Old token fails
+    post "/api/v1/password_resets/confirm",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { password_reset: { token: old_reset_token, password: "reset-password-1" } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # New token with blank password fails without consuming token
+    post "/api/v1/password_resets/confirm",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { password_reset: { token: new_reset_token, password: "" } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Valid reset succeeds and signs out existing session
+    post "/api/v1/password_resets/confirm",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { password_reset: { token: new_reset_token, password: "reset-password-1" } },
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{session_token}" }
+    assert_response :unauthorized
+
+    # Token cannot be reused
+    post "/api/v1/password_resets/confirm",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { password_reset: { token: new_reset_token, password: "reset-password-2" } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Sign in with new password works
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { session: { email: "jo@acme.test", password: "reset-password-1" } },
+      as: :json
+    assert_response :created
+  end
+
+  test "account cancellation revokes sessions, stops ordinary access, allows owner signin and reactivation within 90 days" do
+    signup_acme
+    owner_token = verify_and_signin
+
+    account = Account.find_by!(subdomain: "acme")
+    agent = account.users.create!(
+      name: "Agent Bob",
+      email: "bob@acme.test",
+      password: "agent-password",
+      role: "agent",
+      verified: true,
+      verified_at: Time.current
+    )
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { session: { email: "bob@acme.test", password: "agent-password" } },
+      as: :json
+    assert_response :created
+    agent_token = json_body.dig("session", "token")
+
+    # Non-admin cannot cancel
+    post "/api/v1/account/cancel",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{agent_token}" }
+    assert_response :forbidden
+
+    # Owner cancels account
+    post "/api/v1/account/cancel",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+    assert_equal true, json_body.dig("account", "cancelled")
+
+    # Existing sessions are revoked
+    get "/api/v1/me",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :forbidden # cancelled account blocks ordinary access before/with auth
+
+    # Public portal and ordinary endpoints stopped
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :forbidden
+
+    # Agent cannot sign in while cancelled
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { session: { email: "bob@acme.test", password: "agent-password" } },
+      as: :json
+    assert_response :forbidden
+
+    # Owner CAN still sign in to reactivate within 90 days
+    travel 89.days do
+      post "/api/v1/sessions",
+        headers: { "X-Helpdesk-Account" => "acme" },
+        params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+        as: :json
+      assert_response :created
+      reactivate_token = json_body.dig("session", "token")
+
+      # Ordinary access still blocked while cancelled
+      get "/api/v1/me",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{reactivate_token}" }
+      assert_response :forbidden
+
+      # Reactivate succeeds
+      post "/api/v1/account/reactivate",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{reactivate_token}" }
+      assert_response :ok
+      assert_equal false, json_body.dig("account", "cancelled")
+
+      # Ordinary access works again
+      get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+      assert_response :ok
+      get "/api/v1/me",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{reactivate_token}" }
+      assert_response :ok
+    end
+  end
+
+  test "cannot reactivate after 90 days" do
+    signup_acme
+    owner_token = verify_and_signin
+
+    post "/api/v1/account/cancel",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+
+    travel 91.days do
+      post "/api/v1/sessions",
+        headers: { "X-Helpdesk-Account" => "acme" },
+        params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+        as: :json
+      assert_response :forbidden
+    end
+  end
+
+  test "CORS allows configured frontend origin and rejects others" do
+    signup_acme
+
+    options "/api/v1/portal",
+      headers: {
+        "Origin" => "http://localhost:3001",
+        "Access-Control-Request-Method" => "GET",
+        "Access-Control-Request-Headers" => "X-Helpdesk-Account, Authorization"
+      }
+    assert_response :no_content
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+    assert_includes response.headers["Access-Control-Allow-Headers"], "X-Helpdesk-Account"
+
+    get "/api/v1/portal",
+      headers: {
+        "X-Helpdesk-Account" => "acme",
+        "Origin" => "http://localhost:3001"
+      }
+    assert_response :ok
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+
+    ENV["HELPDESK_FRONTEND_URL"] = "https://portal.example.com/"
+    get "/api/v1/portal",
+      headers: {
+        "X-Helpdesk-Account" => "acme",
+        "Origin" => "https://portal.example.com"
+      }
+    assert_response :ok
+    assert_equal "https://portal.example.com", response.headers["Access-Control-Allow-Origin"]
+
+    get "/api/v1/portal",
+      headers: {
+        "X-Helpdesk-Account" => "acme",
+        "Origin" => "https://evil.example.com"
+      }
+    assert_response :ok
+    assert_nil response.headers["Access-Control-Allow-Origin"]
+  end
+
+  test "respects HELPDESK_FRONTEND_URL and HELPDESK_MAIL_FROM environment variables" do
+    ENV["HELPDESK_FRONTEND_URL"] = "https://help.acme.test/"
+    ENV["HELPDESK_MAIL_FROM"] = "noreply@helpdesk.test"
+
+    signup_acme
+    assert_response :created
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "noreply@helpdesk.test" ], mail.from
+    assert_includes mail.text_part.body.decoded, "https://help.acme.test/verify-email?account=acme&token="
+  end
+
+  test "handles missing/unknown account header and invalid json cleanly" do
+    get "/api/v1/portal"
+    assert_response :bad_request
+
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "nonexistent" }
+    assert_response :not_found
+
+    post "/api/v1/account/create",
+      params: "{bad json",
+      headers: { "CONTENT_TYPE" => "application/json" }
+    assert_response :bad_request
+  end
+end
