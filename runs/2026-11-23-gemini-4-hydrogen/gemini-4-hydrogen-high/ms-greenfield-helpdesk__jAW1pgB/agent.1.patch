@@ -0,0 +1,38 @@
+require "test_helper"
+
+class UserTest < ActiveSupport::TestCase
+  include ActiveSupport::Testing::TimeHelpers
+
+  test "allows same email across different accounts but not within the same account" do
+    a1 = Account.create!(name: "One", subdomain: "one")
+    a2 = Account.create!(name: "Two", subdomain: "two")
+
+    u1 = a1.users.create!(name: "Jo", email: "  JO@Example.Test ", password: "password123")
+    assert_equal "jo@example.test", u1.email
+
+    u2 = a2.users.create!(name: "Jo", email: "jo@example.test", password: "password123")
+    assert u2.persisted?
+
+    dup = a1.users.build(name: "Jo 2", email: "JO@example.test", password: "password123")
+    assert_not dup.valid?
+  end
+
+  test "tokens expire after TTL" do
+    account = Account.create!(name: "One", subdomain: "one")
+    user = account.users.create!(name: "Jo", email: "jo@one.test", password: "password123")
+
+    ver_token = user.generate_email_verification_token!
+    assert_equal user, User.find_by_email_verification_token(ver_token)
+
+    travel 25.hours do
+      assert_nil User.find_by_email_verification_token(ver_token)
+    end
+
+    reset_token = user.generate_password_reset_token!
+    assert_equal user, User.find_by_password_reset_token(reset_token)
+
+    travel 3.hours do
+      assert_nil User.find_by_password_reset_token(reset_token)
+    end
+  end
+end
