+require "test_helper"
+
+class AccountTest < ActiveSupport::TestCase
+  test "normalizes subdomain and name" do
+    account = Account.create!(name: "  Acme Corp  ", subdomain: "  ACME-1  ")
+    assert_equal "Acme Corp", account.name
+    assert_equal "acme-1", account.subdomain
+  end
+
+  test "validates subdomain uniqueness case-insensitively and format" do
+    Account.create!(name: "Acme", subdomain: "acme")
+    dup = Account.new(name: "Acme 2", subdomain: "ACME")
+    assert_not dup.valid?
+
+    invalid = Account.new(name: "Bad", subdomain: "-bad-")
+    assert_not invalid.valid?
+  end
+end
