+require "test_helper"
+
+class UserMailerTest < ActionMailer::TestCase
+  setup do
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  teardown do
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  test "email_verification uses defaults and configured env vars" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+    user = account.users.create!(name: "Jo", email: "jo@acme.test", password: "password123")
+
+    email = UserMailer.email_verification(user, "tok123")
+    assert_equal [ "support@example.test" ], email.from
+    assert_equal [ "jo@acme.test" ], email.to
+    assert_includes email.text_part.body.decoded, "http://localhost:3001/verify-email?account=acme&token=tok123"
+
+    ENV["HELPDESK_FRONTEND_URL"] = "https://front.acme.test"
+    ENV["HELPDESK_MAIL_FROM"] = "mail@acme.test"
+
+    email2 = UserMailer.password_reset(user, "rst456")
+    assert_equal [ "mail@acme.test" ], email2.from
+    assert_includes email2.text_part.body.decoded, "https://front.acme.test/reset-password?account=acme&token=rst456"
+  end
+end
