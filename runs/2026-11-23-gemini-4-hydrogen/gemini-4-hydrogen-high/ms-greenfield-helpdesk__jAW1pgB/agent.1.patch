new file mode 100644
index 0000000..c6572a2
--- /dev/null
+++ b/app/controllers/api/v1/sessions_controller.rb
@@ -0,0 +1,53 @@
+module Api
+  module V1
+    class SessionsController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!, only: :destroy
+
+      def create
+        session_params = params.require(:session)
+        email = session_params[:email].to_s.strip.downcase
+        password = session_params[:password].to_s
+
+        user = current_account.users.find_by(email: email)
+        unless user&.authenticate(password)
+          render json: { error: "Invalid email or password" }, status: :unauthorized
+          return
+        end
+
+        unless user.verified?
+          render json: { error: "Email address must be verified before signing in" }, status: :forbidden
+          return
+        end
+
+        if current_account.cancelled?
+          unless user.admin?
+            render json: { error: "Account is cancelled" }, status: :forbidden
+            return
+          end
+
+          unless current_account.within_reactivation_window?
+            render json: { error: "Account reactivation window has expired" }, status: :forbidden
+            return
+          end
+        end
+
+        session = user.sessions.create!
+        render json: {
+          user: serialize_user(user),
+          account: serialize_account(current_account),
+          session: {
+            id: session.id,
+            token: session.plain_token,
+            created_at: session.created_at
+          }
+        }, status: :created
+      end
+
+      def destroy
+        current_session.destroy!
+        head :no_content
+      end
+    end
+  end
+end
