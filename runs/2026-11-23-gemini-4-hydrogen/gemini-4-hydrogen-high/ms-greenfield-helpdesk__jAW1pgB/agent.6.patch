+    assert_equal g_ids.first(2), json_body["groups"].map { |g| g["id"] }
+    assert_equal 3, json_body["count"]
+    assert_equal 2, json_body["next_page"]
+
+    # Non-boolean default rejected
+    post "/api/v1/group_memberships",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { group_membership: { group_id: g_ids[0], user_id: sam_id, default: "yes-please" } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    m_ids = g_ids.map do |gid|
+      post "/api/v1/group_memberships",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+        params: { group_membership: { group_id: gid, user_id: sam_id } },
+        as: :json
+      assert_response :created
+      json_body.dig("group_membership", "id")
+    end
+
+    # Pagination on /group_memberships
+    get "/api/v1/group_memberships",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" },
+      params: { page: 2, per_page: 2 }
