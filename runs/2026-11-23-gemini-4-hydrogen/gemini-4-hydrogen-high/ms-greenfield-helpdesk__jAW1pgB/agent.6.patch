diff --git a/app/controllers/api/v1/group_memberships_controller.rb b/app/controllers/api/v1/group_memberships_controller.rb
new file mode 100644
index 0000000..218f7e2
--- /dev/null
+++ b/app/controllers/api/v1/group_memberships_controller.rb
@@ -0,0 +1,112 @@
+module Api
+  module V1
+    class GroupMembershipsController < BaseController
+      MAX_BIGINT = 9_223_372_036_854_775_807
+      BOOLEAN_VALUES = [ true, false, "true", "false", "1", "0", 1, 0 ].freeze
+
+      before_action :require_account!
+      before_action :require_active_account!
+      before_action :authenticate_user!
+      before_action :require_staff!, only: %i[index show]
+      before_action :require_admin!, only: %i[create destroy make_default]
+      before_action :set_group_membership, only: %i[show destroy make_default]
+
+      def index
+        scope = current_account.group_memberships.includes(:group, :user)
+
+        if params[:group_id].present?
+          raw_group = params[:group_id].to_s
+          if (group_id = parse_id_filter(raw_group))
+            scope = scope.where(group_id: group_id)
+          else
+            render json: { error: "Invalid group_id filter" }, status: :unprocessable_entity
+            return
+          end
+        end
+
+        if params[:user_id].present?
+          raw_user = params[:user_id].to_s
+          if (user_id = parse_id_filter(raw_user))
+            scope = scope.where(user_id: user_id)
+          else
+            render json: { error: "Invalid user_id filter" }, status: :unprocessable_entity
+            return
+          end
+        end
+
+        scope = scope.ordered_by_id
+        result = paginate(scope)
+
+        render json: {
+          group_memberships: result[:records].map { |membership| serialize_group_membership(membership) }
+        }.merge(result[:meta]), status: :ok
+      end
+
+      def show
+        render json: { group_membership: serialize_group_membership(@group_membership) }, status: :ok
+      end
+
+      def create
+        raw_params = params.require(:group_membership)
+
+        if raw_params.key?(:default) && !raw_params[:default].nil? && !BOOLEAN_VALUES.include?(raw_params[:default])
+          render json: { errors: { default: [ "must be a boolean" ] } }, status: :unprocessable_entity
+          return
+        end
+
+        membership = nil
+        saved = false
+
+        GroupMembership.transaction do
+          current_account.lock!
+          membership = current_account.group_memberships.build(
+            group_id: raw_params[:group_id],
+            user_id: raw_params[:user_id],
+            default: raw_params.key?(:default) && !raw_params[:default].nil? ? ActiveModel::Type::Boolean.new.cast(raw_params[:default]) : false
+          )
+
+          if membership.save
+            saved = true
+          else
+            raise ActiveRecord::Rollback
+          end
+        end
+
+        if saved
+          render json: { group_membership: serialize_group_membership(membership.reload) }, status: :created
+        else
+          render json: { errors: membership.errors.messages }, status: :unprocessable_entity
+        end
+      end
+
+      def destroy
+        GroupMembership.transaction do
+          current_account.lock!
+          @group_membership.destroy!
+        end
+
+        head :no_content
+      end
+
+      def make_default
+        @group_membership.make_default!
+        render json: { group_membership: serialize_group_membership(@group_membership.reload) }, status: :ok
+      end
+
+      private
+
+      def set_group_membership
+        @group_membership = current_account.group_memberships.includes(:group, :user).find(params[:id])
+      end
+
+      def parse_id_filter(raw)
+        return nil unless raw.match?(/\A\d+\z/)
+
+        value = raw.to_i
+        return nil if value > MAX_BIGINT
+
+        value
+      end
+    end
+  end
+end
