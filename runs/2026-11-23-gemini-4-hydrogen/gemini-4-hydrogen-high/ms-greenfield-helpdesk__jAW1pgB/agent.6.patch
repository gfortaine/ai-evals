+    assert_equal 3, json_body["count"]
+    assert_equal 1, json_body["previous_page"]
+
+    # make_default is idempotent and cross-account returns 404
+    put "/api/v1/group_memberships/#{m_ids[0]}/make_default",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+    assert_equal true, json_body.dig("group_membership", "default")
+
+    put "/api/v1/group_memberships/#{m_ids[0]}/make_default",
+      headers: { "X-Helpdesk-Account" => "beta", "Authorization" => "Bearer #{beta_owner_token}" }
+    assert_response :not_found
+
+    # Invalid comment prevents group/assignee change on ticket update
+    post "/api/v1/requests",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+      params: { request: { subject: "Need help", comment: { body: "Details" } } },
+      as: :json
+    assert_response :created
+    tid = json_body.dig("request", "id")
+
+    patch "/api/v1/tickets/#{tid}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" },
+      params: { ticket: { group_id: g_ids[0], assignee_id: sam_id, comment: { body: "   " } } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    get "/api/v1/tickets/#{tid}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" }
+    assert_response :ok
+    assert_nil json_body.dig("ticket", "group_id")
+    assert_nil json_body.dig("ticket", "assignee_id")
+
+    # Assign ticket then cancel and purge account cleanly
+    patch "/api/v1/tickets/#{tid}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" },
+      params: { ticket: { group_id: g_ids[0], assignee_id: sam_id } },
+      as: :json
+    assert_response :ok
+
+    acme = Account.find_by!(subdomain: "acme")
+    acme.update!(cancelled_at: 91.days.ago)
+    assert_equal 1, Account.purge_cancelled!
+    assert_not Account.exists?(acme.id)
+    assert_equal 0, Group.where(account_id: acme.id).count
+    assert_equal 0, GroupMembership.where(account_id: acme.id).count
+    assert_equal 0, Ticket.where(account_id: acme.id).count
+  end
