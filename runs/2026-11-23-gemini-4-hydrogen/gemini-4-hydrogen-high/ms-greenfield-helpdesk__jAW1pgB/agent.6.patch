+    avery_token, _ = register_verify_signin_customer
+    beta_owner_token, _ = create_account_and_owner(subdomain: "beta", name: "Beta", email: "jo@beta.test")
+
+    g_ids = %w[Billing Support Security].map do |name|
+      post "/api/v1/groups",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+        params: { group: { name: name } },
+        as: :json
+      assert_response :created
+      json_body.dig("group", "id")
+    end
+
+    # Pagination on /groups
+    get "/api/v1/groups",
