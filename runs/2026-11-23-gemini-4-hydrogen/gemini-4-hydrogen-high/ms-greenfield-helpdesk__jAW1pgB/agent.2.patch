--- /dev/null
+++ b/app/controllers/api/v1/registrations_controller.rb
@@ -0,0 +1,39 @@
+module Api
+  module V1
+    class RegistrationsController < BaseController
+      before_action :require_account!
+      before_action :require_active_account!
+
+      def create
+        user_params = params.require(:user)
+
+        user = current_account.users.build(
+          name: user_params[:name],
+          email: user_params[:email],
+          password: user_params[:password],
+          role: "customer",
+          verified: false
+        )
+
+        verification_token = nil
+        saved = false
+
+        User.transaction do
+          if user.save
+            verification_token = user.generate_email_verification_token!
+            saved = true
+          else
+            raise ActiveRecord::Rollback
+          end
+        end
+
+        if saved
+          UserMailer.email_verification(user, verification_token).deliver_now
+          render json: { user: serialize_user(user) }, status: :created
+        else
+          render json: { errors: user.errors.messages }, status: :unprocessable_entity
+        end
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/requests_controller.rb b/app/controllers/api/v1/requests_controller.rb
new file mode 100644
index 0000000..02961d1
--- /dev/null
+++ b/app/controllers/api/v1/requests_controller.rb
@@ -0,0 +1,129 @@
+module Api
+  module V1
+    class RequestsController < BaseController
+      before_action :require_account!
+      before_action :require_active_account!
+      before_action :authenticate_user!
+      before_action :set_request, only: %i[show update comments]
+
+      def index
+        scope = current_account.tickets.where(requester: current_user).recently_active
+        result = paginate(scope)
+
+        render json: {
+          requests: result[:records].map { |ticket| serialize_request(ticket) }
+        }.merge(result[:meta]), status: :ok
+      end
+
+      def create
+        request_params = params.require(:request)
+        comment_params = request_params[:comment]
+        comment_body = if comment_params.is_a?(ActionController::Parameters) || comment_params.is_a?(Hash)
+          comment_params[:body]
+        end
+
+        ticket = current_account.tickets.build(
+          requester: current_user,
+          subject: request_params[:subject],
+          status: "open"
+        )
+        comment = ticket.comments.build(
+          author: current_user,
+          body: comment_body,
+          public: true
+        )
+
+        saved = false
+        Ticket.transaction do
+          ticket_valid = ticket.valid?
+          comment_valid = comment.valid?
+
+          if ticket_valid && comment_valid
+            ticket.save!
+            comment.save!
+            saved = true
+          else
+            raise ActiveRecord::Rollback
+          end
+        end
+
+        if saved
+          render json: { request: serialize_request(ticket) }, status: :created
+        else
+          errors = {}
+          errors.merge!(ticket.errors.messages) if ticket.errors.any?
+          errors[:comment] = comment.errors.messages if comment.errors.any?
+          render json: { errors: errors }, status: :unprocessable_entity
+        end
+      end
+
+      def show
+        render json: { request: serialize_request(@ticket) }, status: :ok
+      end
+
+      def update
+        request_params = params.require(:request)
+        has_comment = request_params.key?(:comment) && !request_params[:comment].nil?
+        has_status = request_params.key?(:status)
+
+        errors = {}
+        comment = nil
+
+        if has_status
+          requested_status = request_params[:status].to_s
+          if requested_status != "solved"
+            errors[:status] = [ "can only be set to solved" ]
+          end
+        end
+
+        if has_comment
+          comment_params = request_params[:comment]
+          comment_body = if comment_params.is_a?(ActionController::Parameters) || comment_params.is_a?(Hash)
+            comment_params[:body]
+          end
+          comment = @ticket.comments.build(
+            author: current_user,
+            body: comment_body,
+            public: true
+          )
+          unless comment.valid?
+            errors[:comment] = comment.errors.messages
+          end
+        end
+
+        if errors.any?
+          render json: { errors: errors }, status: :unprocessable_entity
+          return
+        end
+
+        Ticket.transaction do
+          if has_status
+            @ticket.status = "solved"
+          elsif has_comment && (@ticket.pending? || @ticket.solved?)
+            @ticket.status = "open"
+          end
+
+          @ticket.save! if @ticket.changed?
+          comment.save! if comment
+        end
+
+        render json: { request: serialize_request(@ticket.reload) }, status: :ok
+      end
+
+      def comments
+        scope = @ticket.comments.public_comments.includes(:author).oldest_first
+        result = paginate(scope)
+
+        render json: {
+          comments: result[:records].map { |comment| serialize_comment(comment) }
+        }.merge(result[:meta]), status: :ok
+      end
+
+      private
+
+      def set_request
+        @ticket = current_account.tickets.where(requester: current_user).find(params[:id])
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/tickets_controller.rb b/app/controllers/api/v1/tickets_controller.rb
new file mode 100644
index 0000000..68722e8
--- /dev/null
+++ b/app/controllers/api/v1/tickets_controller.rb
@@ -0,0 +1,91 @@
+module Api
+  module V1
+    class TicketsController < BaseController
+      before_action :require_account!
+      before_action :require_active_account!
+      before_action :authenticate_user!
+      before_action :require_staff!
+      before_action :set_ticket, only: %i[show update comments]
+
+      def index
+        scope = current_account.tickets.includes(:requester).recently_active
+        result = paginate(scope)
+
+        render json: {
+          tickets: result[:records].map { |ticket| serialize_ticket(ticket) }
+        }.merge(result[:meta]), status: :ok
+      end
+
+      def show
+        render json: { ticket: serialize_ticket(@ticket) }, status: :ok
+      end
+
+      def update
+        ticket_params = params.require(:ticket)
+        has_comment = ticket_params.key?(:comment) && !ticket_params[:comment].nil?
+        has_status = ticket_params.key?(:status)
+
+        errors = {}
+        comment = nil
+
+        if has_status
+          @ticket.status = ticket_params[:status]
+          unless @ticket.valid?
+            errors.merge!(@ticket.errors.messages)
+          end
+        end
+
+        if has_comment
+          comment_params = ticket_params[:comment]
+          if comment_params.is_a?(ActionController::Parameters) || comment_params.is_a?(Hash)
+            comment_body = comment_params[:body]
+            is_public = if comment_params.key?(:public) && !comment_params[:public].nil?
+              ActiveModel::Type::Boolean.new.cast(comment_params[:public])
+            else
+              true
+            end
+          else
+            comment_body = nil
+            is_public = true
+          end
+
+          comment = @ticket.comments.build(
+            author: current_user,
+            body: comment_body,
+            public: is_public
+          )
+          unless comment.valid?
+            errors[:comment] = comment.errors.messages
+          end
+        end
+
+        if errors.any?
+          render json: { errors: errors }, status: :unprocessable_entity
+          return
+        end
+
+        Ticket.transaction do
+          @ticket.save! if @ticket.changed?
+          comment.save! if comment
+        end
+
+        render json: { ticket: serialize_ticket(@ticket.reload) }, status: :ok
+      end
+
+      def comments
+        scope = @ticket.comments.includes(:author).oldest_first
+        result = paginate(scope)
+
+        render json: {
+          comments: result[:records].map { |comment| serialize_comment(comment) }
+        }.merge(result[:meta]), status: :ok
+      end
+
+      private
+
+      def set_ticket
+        @ticket = current_account.tickets.includes(:requester).find(params[:id])
+      end
+    end
+  end
+end
