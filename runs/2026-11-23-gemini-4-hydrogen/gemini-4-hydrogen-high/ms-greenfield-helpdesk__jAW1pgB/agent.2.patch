+require "test_helper"
+
+class CommentTest < ActiveSupport::TestCase
+  include ActiveSupport::Testing::TimeHelpers
+
+  test "validates body, public flag, same-account author, and touches ticket" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    beta = Account.create!(name: "Beta", subdomain: "beta")
+    customer = acme.users.create!(name: "Avery", email: "avery@example.test", password: "password123", role: "customer", verified: true)
+    other_user = beta.users.create!(name: "Bob", email: "bob@example.test", password: "password123", role: "customer", verified: true)
+
+    ticket = nil
+    travel_to Time.utc(2026, 11, 22, 10, 0, 0) do
+      ticket = acme.tickets.create!(requester: customer, subject: "Receipt issue")
+    end
+
+    travel_to Time.utc(2026, 11, 22, 10, 5, 0) do
+      comment = ticket.comments.create!(author: customer, body: "First message")
+      assert_equal true, comment.public
+      assert_equal Time.utc(2026, 11, 22, 10, 5, 0), ticket.reload.updated_at
+    end
+
+    blank = ticket.comments.build(author: customer, body: "   ")
+    assert_not blank.valid?
+
+    cross_tenant = ticket.comments.build(author: other_user, body: "Cross tenant")
+    assert_not cross_tenant.valid?
+  end
+end
