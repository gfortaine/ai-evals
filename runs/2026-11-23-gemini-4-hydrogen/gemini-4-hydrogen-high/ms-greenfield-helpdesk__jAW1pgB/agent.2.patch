+require "test_helper"
+
+class TicketTest < ActiveSupport::TestCase
+  test "validates subject, status, and same-account requester" do
+    acme = Account.create!(name: "Acme", subdomain: "acme")
+    beta = Account.create!(name: "Beta", subdomain: "beta")
+    acme_user = acme.users.create!(name: "Avery", email: "avery@example.test", password: "password123", role: "customer", verified: true)
+    beta_user = beta.users.create!(name: "Bob", email: "bob@example.test", password: "password123", role: "customer", verified: true)
+
+    ticket = acme.tickets.build(requester: acme_user, subject: "  Help me  ")
+    assert ticket.valid?
+    assert_equal "Help me", ticket.subject
+    assert_equal "open", ticket.status
+
+    ticket.status = "invalid"
+    assert_not ticket.valid?
+
+    cross_tenant = acme.tickets.build(requester: beta_user, subject: "Cross tenant")
+    assert_not cross_tenant.valid?
+  end
+end
