+
+    # Customer cannot set status to pending or open
+    patch "/api/v1/requests/#{ticket_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+      params: { request: { status: "pending" } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Customer blank comment does not reopen pending ticket
+    patch "/api/v1/requests/#{ticket_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+      params: { request: { comment: { body: "   " } } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    get "/api/v1/requests/#{ticket_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    assert_equal "pending", json_body.dig("request", "status")
+
+    # Staff invalid status with valid comment fails atomically
+    patch "/api/v1/tickets/#{ticket_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { ticket: { comment: { body: "Should not save" }, status: "closed" } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    get "/api/v1/tickets/#{ticket_id}/comments",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_equal 1, json_body["count"]
+  end
+
+  test "pagination and recently active ordering for requests, tickets, and comments" do
+    owner_token, = create_account_and_owner
+    avery_token, = register_verify_signin_customer
+
+    created_ids = []
+    30.times do |i|
+      travel_to Time.utc(2026, 11, 22, 9, 0, 0) + i.minutes do
+        post "/api/v1/requests",
+          headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+          params: { request: { subject: "Ticket #{i + 1}", comment: { body: "Body #{i + 1}" } } },
+          as: :json
+        assert_response :created
+        created_ids << json_body.dig("request", "id")
+      end
+    end
+
+    # Replying to oldest ticket (index 0) moves it to the top as most recently active
+    oldest_id = created_ids.first
+    travel_to Time.utc(2026, 11, 22, 11, 0, 0) do
+      patch "/api/v1/tickets/#{oldest_id}",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+        params: { ticket: { comment: { body: "Bumping oldest" }, status: "pending" } },
+        as: :json
+      assert_response :ok
+    end
+
+    # Default pagination on /requests (page 1, per_page 25)
+    get "/api/v1/requests",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    assert_response :ok
+    assert_equal 30, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    assert_equal 25, json_body["requests"].size
+    assert_equal oldest_id, json_body["requests"].first["id"]
+    assert_equal created_ids.last, json_body["requests"].second["id"]
+
+    # Page 2 on /tickets with default per_page 25
+    get "/api/v1/tickets",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { page: 2 }
+    assert_response :ok
+    assert_equal 30, json_body["count"]
+    assert_equal 2, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_nil json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+    assert_equal 5, json_body["tickets"].size
+
+    # Custom per_page pagination
+    get "/api/v1/tickets",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { page: 2, per_page: 10 }
+    assert_response :ok
+    assert_equal 30, json_body["count"]
+    assert_equal 2, json_body["page"]
+    assert_equal 10, json_body["per_page"]
+    assert_equal 3, json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+    assert_equal 10, json_body["tickets"].size
+
+    # Comments pagination (oldest first)
+    3.times do |j|
+      travel_to Time.utc(2026, 11, 22, 12, 0, 0) + j.minutes do
+        patch "/api/v1/tickets/#{oldest_id}",
+          headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+          params: { ticket: { comment: { body: "Reply #{j + 1}" } } },
+          as: :json
+        assert_response :ok
+      end
+    end
+
+    get "/api/v1/requests/#{oldest_id}/comments",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+      params: { page: 1, per_page: 2 }
+    assert_response :ok
+    assert_equal 5, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 2, json_body["per_page"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    assert_equal [ "Body 1", "Bumping oldest" ], json_body["comments"].map { |c| c["body"] }
+
+    get "/api/v1/requests/#{oldest_id}/comments",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+      params: { page: 3, per_page: 2 }
+    assert_response :ok
+    assert_equal 5, json_body["count"]
+    assert_equal 3, json_body["page"]
+    assert_equal 2, json_body["per_page"]
+    assert_nil json_body["next_page"]
+    assert_equal 2, json_body["previous_page"]
+    assert_equal [ "Reply 3" ], json_body["comments"].map { |c| c["body"] }
+  end
+
+  test "cancelled account blocks registrations, requests, and tickets, and purges cleanly" do
+    owner_token, = create_account_and_owner
+    avery_token, = register_verify_signin_customer
+
+    post "/api/v1/requests",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+      params: { request: { subject: "Before cancel", comment: { body: "Hello" } } },
+      as: :json
+    assert_response :created
+    ticket_id = json_body.dig("request", "id")
+
+    post "/api/v1/account/cancel",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+
+    post "/api/v1/registrations",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { user: { name: "New", email: "new@example.test", password: "password123" } },
+      as: :json
+    assert_response :forbidden
+
+    get "/api/v1/requests",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    assert_response :forbidden
+
+    get "/api/v1/tickets",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :forbidden
+
+    travel 91.days do
+      purged = Account.purge_cancelled!
+      assert_equal 1, purged
+      assert_not Ticket.exists?(ticket_id)
+      assert_equal 0, Comment.where(ticket_id: ticket_id).count
+    end
+  end
+end
