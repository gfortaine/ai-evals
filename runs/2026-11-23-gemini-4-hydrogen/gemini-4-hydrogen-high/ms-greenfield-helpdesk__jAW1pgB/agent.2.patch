index 0000000..5006d85
--- /dev/null
+++ b/app/models/comment.rb
@@ -0,0 +1,21 @@
+class Comment < ApplicationRecord
+  belongs_to :ticket, touch: true, inverse_of: :comments
+  belongs_to :author, class_name: "User", inverse_of: :comments
+
+  validates :body, presence: true
+  validates :public, inclusion: { in: [ true, false ] }
+  validate :author_belongs_to_ticket_account
+
+  scope :public_comments, -> { where(public: true) }
+  scope :oldest_first, -> { order(created_at: :asc, id: :asc) }
+
+  private
+
+  def author_belongs_to_ticket_account
+    return if ticket.blank? || author.blank?
+
+    if author.account_id != ticket.account_id
+      errors.add(:author, "must belong to the same account")
+    end
+  end
+end
diff --git a/app/models/ticket.rb b/app/models/ticket.rb
new file mode 100644
index 0000000..067cefe
--- /dev/null
+++ b/app/models/ticket.rb
@@ -0,0 +1,37 @@
+class Ticket < ApplicationRecord
+  STATUSES = %w[open pending solved].freeze
+
+  belongs_to :account, inverse_of: :tickets
+  belongs_to :requester, class_name: "User", inverse_of: :requested_tickets
+  has_many :comments, dependent: :destroy, inverse_of: :ticket
+
+  normalizes :subject, with: ->(value) { value.strip }
+
+  validates :subject, presence: true
+  validates :status, presence: true, inclusion: { in: STATUSES }
+  validate :requester_belongs_to_account
+
+  scope :recently_active, -> { order(updated_at: :desc, id: :desc) }
+
+  def open?
+    status == "open"
+  end
+
+  def pending?
+    status == "pending"
+  end
+
+  def solved?
+    status == "solved"
+  end
+
+  private
+
+  def requester_belongs_to_account
+    return if account_id.blank? || requester.blank?
+
+    if requester.account_id != account_id
+      errors.add(:requester, "must belong to the same account")
+    end
+  end
+end
