+
+    post "/api/v1/requests",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+      params: { request: { subject: "Avery 3", comment: { body: "A3" } } },
+      as: :json
+    a3 = json_body.dig("request", "id")
+
+    post "/api/v1/requests",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{casey_token}" },
+      params: { request: { subject: "Casey 1", comment: { body: "C1" } } },
+      as: :json
+    c1 = json_body.dig("request", "id")
+
+    post "/api/v1/requests",
+      headers: { "X-Helpdesk-Account" => "beta", "Authorization" => "Bearer #{beta_cust_token}" },
+      params: { request: { subject: "Beta 1", comment: { body: "B1" } } },
+      as: :json
+    b1 = json_body.dig("request", "id")
+
+    # Unauthenticated -> 401
+    post "/api/v1/tickets/#{a1}/merge",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { merge: { target_id: a2 } },
+      as: :json
+    assert_response :unauthorized
+
+    # Customer cannot merge -> 403
+    post "/api/v1/tickets/#{a1}/merge",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+      params: { merge: { target_id: a2 } },
+      as: :json
+    assert_response :forbidden
+
+    # Cross-account source -> 404
+    post "/api/v1/tickets/#{b1}/merge",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{acme_owner_token}" },
+      params: { merge: { target_id: a2 } },
+      as: :json
+    assert_response :not_found
+
+    # Cross-account target -> 422
+    post "/api/v1/tickets/#{a1}/merge",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{acme_owner_token}" },
+      params: { merge: { target_id: b1 } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Different customer target -> 422
+    post "/api/v1/tickets/#{a1}/merge",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{acme_owner_token}" },
+      params: { merge: { target_id: c1 } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Self-merge -> 422
+    post "/api/v1/tickets/#{a1}/merge",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{acme_owner_token}" },
+      params: { merge: { target_id: a1 } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Missing / invalid target_id -> 422; missing merge -> 400
