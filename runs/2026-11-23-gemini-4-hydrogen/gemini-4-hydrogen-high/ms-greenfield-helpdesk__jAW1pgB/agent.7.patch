+  test "custom merge notes allow independent public flags and never send emails even on email-origin tickets" do
+    owner_token, _ = create_account_and_owner
+    avery_token, _ = register_verify_signin_customer(email: "avery@example.test")
+
+    # Create two email-origin tickets for Avery
+    post_relay_email(build_rfc822(
+      from: "Avery <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Email dup",
+      body: "Email body 1",
+      message_id: "<merge-email-1@example.test>"
+    ))
+    assert_response :no_content
+
+    post_relay_email(build_rfc822(
+      from: "Avery <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Email main",
+      body: "Email body 2",
+      message_id: "<merge-email-2@example.test>"
+    ))
+    assert_response :no_content
+
+    acme = Account.find_by!(subdomain: "acme")
+    source_ticket, target_ticket = acme.tickets.order(:id).to_a
+    # Mark target as solved to confirm public merge note does not reopen it
+    target_ticket.update!(status: "solved")
+    target_reply_token = target_ticket.reply_token
+    target_email_msg_id = target_ticket.email_message_id
+    ActionMailer::Base.deliveries.clear
+
+    post "/api/v1/tickets/#{source_ticket.id}/merge",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: {
+        merge: {
+          target_id: target_ticket.id,
+          source_comment: { body: "Continuing in ticket #{target_ticket.id}.", public: true },
+          target_comment: { body: "Duplicate checked.", public: false }
+        }
+      },
+      as: :json
+    assert_response :ok
+
+    # Merge notes must NOT send email even for email-origin tickets with public notes
+    assert_equal 0, ActionMailer::Base.deliveries.size
+    assert_equal "solved", json_body.dig("target", "status")
+    assert_equal target_reply_token, target_ticket.reload.reply_token
+    assert_equal target_email_msg_id, target_ticket.email_message_id
+    assert_equal "email", target_ticket.origin
+
+    # Customer sees public source note, not private target note
+    get "/api/v1/requests/#{source_ticket.id}/comments",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    assert_response :ok
+    assert_equal [ "Email body 1", "Continuing in ticket #{target_ticket.id}." ], json_body["comments"].map { |c| c["body"] }
+
+    get "/api/v1/requests/#{target_ticket.id}/comments",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    assert_response :ok
+    assert_equal [ "Email body 2" ], json_body["comments"].map { |c| c["body"] }
+
+    # Staff sees both notes
+    get "/api/v1/tickets/#{target_ticket.id}/comments",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+    assert_equal [ "Email body 2", "Duplicate checked." ], json_body["comments"].map { |c| c["body"] }
+
+    # Closed source ticket rejects inbound email reply; surviving target ticket still accepts inbound email reply
+    post_relay_email(build_rfc822(
+      from: "avery@example.test",
+      to: source_ticket.reply_address,
+      subject: "Re: Email dup",
+      body: "Reply to closed ticket",
+      message_id: "<reply-closed-1@example.test>"
+    ))
+    assert_response :no_content
+    assert_equal "closed", source_ticket.reload.status
+    assert_equal 2, source_ticket.comments.count
+
+    post_relay_email(build_rfc822(
+      from: "avery@example.test",
+      to: target_ticket.reply_address,
+      subject: "Re: Email main",
+      body: "Reply to surviving ticket",
+      message_id: "<reply-surviving-1@example.test>"
+    ))
+    assert_response :no_content
+    assert_equal "open", target_ticket.reload.status
+    assert_equal 3, target_ticket.comments.count
+    assert_equal "Reply to surviving ticket", target_ticket.comments.oldest_first.last.body
+  end
