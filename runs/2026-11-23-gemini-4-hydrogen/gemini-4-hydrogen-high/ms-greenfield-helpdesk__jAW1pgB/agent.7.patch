diff --git a/test/integration/helpdesk_ticket_merge_test.rb b/test/integration/helpdesk_ticket_merge_test.rb
new file mode 100644
index 0000000..262cd88
--- /dev/null
+++ b/test/integration/helpdesk_ticket_merge_test.rb
@@ -0,0 +1,705 @@
+require "test_helper"
+require "base64"
+
+class HelpdeskTicketMergeTest < ActionDispatch::IntegrationTest
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @prev_password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"]
+    @prev_domain = ENV["HELPDESK_SUPPORT_DOMAIN"]
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = "inbound-secret"
+    ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+  end
+
+  teardown do
+    ActionMailer::Base.deliveries.clear
+    if @prev_password.nil?
+      ENV.delete("RAILS_INBOUND_EMAIL_PASSWORD")
+    else
+      ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @prev_password
+    end
+
+    if @prev_domain.nil?
+      ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+    else
+      ENV["HELPDESK_SUPPORT_DOMAIN"] = @prev_domain
+    end
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def extract_token_from_last_email
+    mail = ActionMailer::Base.deliveries.last
+    assert_not_nil mail
+    body = mail.text_part ? mail.text_part.body.decoded : mail.body.decoded
+    match = body.match(/token=([^\s&"']+)/)
+    assert_not_nil match, "Expected token in email body: #{body}"
+    CGI.unescape(match[1])
+  end
+
+  def relay_auth_header(password = "inbound-secret")
+    encoded = Base64.strict_encode64("actionmailbox:#{password}")
+    { "Authorization" => "Basic #{encoded}" }
+  end
+
+  def post_relay_email(raw_email, headers: {})
+    post "/rails/action_mailbox/relay/inbound_emails",
+      params: raw_email,
+      headers: {
+        "CONTENT_TYPE" => "message/rfc822"
+      }.merge(relay_auth_header).merge(headers)
+  end
+
+  def build_rfc822(from:, to:, subject:, body:, message_id:)
+    mail = Mail.new do
+      from from
+      to to
+      subject subject
+      body body
+    end
+    mail.message_id = message_id
+    mail.to_s
+  end
+
+  def create_account_and_owner(subdomain: "acme", name: "Acme", email: "jo@acme.test", admin_name: "Jo", password: "owner-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: {
+            name: admin_name,
+            email: email,
+            password: password
+          }
+        }
+      },
+      as: :json
+    assert_response :created
+    owner_id = json_body.dig("user", "id")
+
+    token = extract_token_from_last_email
+    post "/api/v1/email_verifications/confirm",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { email_verification: { token: token } },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { session: { email: email, password: password } },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    [ json_body.dig("session", "token"), owner_id ]
+  end
+
+  def invite_and_accept_agent(owner_token:, subdomain: "acme", email: "sam@acme.test", name: "Sam", password: "agent-password")
+    post "/api/v1/invitations",
+      headers: { "X-Helpdesk-Account" => subdomain, "Authorization" => "Bearer #{owner_token}" },
+      params: { invitation: { email: email, role: "agent" } },
+      as: :json
+    assert_response :created
+    inv_token = extract_token_from_last_email
+
+    post "/api/v1/invitation_acceptances",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { invitation_acceptance: { token: inv_token, name: name, password: password } },
+      as: :json
+    assert_response :created
+    agent_id = json_body.dig("user", "id")
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { session: { email: email, password: password } },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    [ json_body.dig("session", "token"), agent_id ]
+  end
+
+  def register_verify_signin_customer(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "customer-password")
+    post "/api/v1/registrations",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { user: { name: name, email: email, password: password } },
+      as: :json
+    assert_response :created
+    user_id = json_body.dig("user", "id")
+
+    token = extract_token_from_last_email
+    post "/api/v1/email_verifications/confirm",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { email_verification: { token: token } },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { session: { email: email, password: password } },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    [ json_body.dig("session", "token"), user_id ]
+  end
+
+  test "staff merges duplicate ticket with default private notes, keeps target attributes, and exposes merged_into_id and closed filter" do
+    owner_token, owner_id = create_account_and_owner
