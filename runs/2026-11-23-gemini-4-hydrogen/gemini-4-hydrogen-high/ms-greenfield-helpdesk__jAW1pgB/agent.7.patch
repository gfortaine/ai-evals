+    assert_response :ok
+
+    # Chained merge: t1 -> t2, then t2 -> t4; t3 -> t4
+    post "/api/v1/tickets/#{t1}/merge",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { merge: { target_id: t2 } },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/tickets/#{t2}/merge",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { merge: { target_id: t4 } },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/tickets/#{t3}/merge",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { merge: { target_id: t4 } },
+      as: :json
+    assert_response :ok
+
+    # t1 must still point to t2 (original link preserved, not rewritten to t4)
+    get "/api/v1/tickets/#{t1}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+    assert_equal "closed", json_body.dig("ticket", "status")
+    assert_equal t2, json_body.dig("ticket", "merged_into_id")
+
+    get "/api/v1/tickets/#{t2}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+    assert_equal "closed", json_body.dig("ticket", "status")
+    assert_equal t4, json_body.dig("ticket", "merged_into_id")
+
+    # 1. Removing Sam from Billing clears Sam's assignment on closed t1 while keeping group_id
+    delete "/api/v1/group_memberships/#{m_sam_billing}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :no_content
+
+    t1_reloaded = Ticket.find(t1)
+    assert_nil t1_reloaded.assignee_id
+    assert_equal billing_id, t1_reloaded.group_id
+
+    # 2. Suspending Lee clears Lee's assignment on closed t2 and t3
+    patch "/api/v1/users/#{lee_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { user: { suspended: true } },
+      as: :json
+    assert_response :ok
+
+    assert_nil Ticket.find(t2).assignee_id
+    assert_equal support_id, Ticket.find(t2).group_id
+    assert_nil Ticket.find(t3).assignee_id
+    assert_equal support_id, Ticket.find(t3).group_id
+
+    # 3. Deleting Billing and Support groups clears group_id on closed t1, t2, t3
+    delete "/api/v1/groups/#{billing_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :no_content
+
+    delete "/api/v1/groups/#{support_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :no_content
+
+    assert_nil Ticket.find(t1).group_id
+    assert_nil Ticket.find(t2).group_id
+    assert_nil Ticket.find(t3).group_id
+
+    # 4. Cancelling and purging account cleans up merged tickets cleanly
+    acme = Account.find_by!(subdomain: "acme")
+    acme.update!(cancelled_at: 91.days.ago)
+    assert_equal 1, Account.purge_cancelled!
+    assert_not Account.exists?(acme.id)
+    assert_equal 0, Ticket.where(account_id: acme.id).count
+  end
+end
