+  test "merge enforces permissions, same account, same customer, non-closed tickets, and atomic validation" do
+    acme_owner_token, _ = create_account_and_owner(subdomain: "acme", name: "Acme", email: "jo@acme.test")
+    beta_owner_token, _ = create_account_and_owner(subdomain: "beta", name: "Beta", email: "jo@beta.test")
