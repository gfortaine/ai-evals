diff --git a/test/integration/helpdesk_ticket_priority_and_filters_test.rb b/test/integration/helpdesk_ticket_priority_and_filters_test.rb
new file mode 100644
index 0000000..d683e77
--- /dev/null
+++ b/test/integration/helpdesk_ticket_priority_and_filters_test.rb
@@ -0,0 +1,474 @@
+require "test_helper"
+
+class HelpdeskTicketPriorityAndFiltersTest < ActionDispatch::IntegrationTest
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def extract_token_from_last_email
+    mail = ActionMailer::Base.deliveries.last
+    assert_not_nil mail
+    body = mail.text_part ? mail.text_part.body.decoded : mail.body.decoded
+    match = body.match(/token=([^\s&"']+)/)
+    assert_not_nil match, "Expected token in email body: #{body}"
+    CGI.unescape(match[1])
+  end
+
+  def create_account_and_owner(subdomain: "acme", name: "Acme", email: "jo@acme.test", admin_name: "Jo", password: "owner-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: {
+            name: admin_name,
+            email: email,
+            password: password
+          }
+        }
+      },
+      as: :json
+    assert_response :created
+    owner_id = json_body.dig("user", "id")
+
+    token = extract_token_from_last_email
+    post "/api/v1/email_verifications/confirm",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { email_verification: { token: token } },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { session: { email: email, password: password } },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    [ json_body.dig("session", "token"), owner_id ]
+  end
+
+  def invite_and_accept_agent(owner_token:, subdomain: "acme", email: "sam@acme.test", name: "Sam", password: "agent-password")
+    post "/api/v1/invitations",
+      headers: { "X-Helpdesk-Account" => subdomain, "Authorization" => "Bearer #{owner_token}" },
+      params: { invitation: { email: email, role: "agent" } },
+      as: :json
+    assert_response :created
+    inv_token = extract_token_from_last_email
+
+    post "/api/v1/invitation_acceptances",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { invitation_acceptance: { token: inv_token, name: name, password: password } },
+      as: :json
+    assert_response :created
+    agent_id = json_body.dig("user", "id")
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { session: { email: email, password: password } },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    [ json_body.dig("session", "token"), agent_id ]
+  end
+
+  def register_verify_signin_customer(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    post "/api/v1/registrations",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { user: { name: name, email: email, password: password } },
+      as: :json
+    assert_response :created
+    user_id = json_body.dig("user", "id")
+
+    token = extract_token_from_last_email
+    post "/api/v1/email_verifications/confirm",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { email_verification: { token: token } },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { session: { email: email, password: password } },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    [ json_body.dig("session", "token"), user_id ]
+  end
+
+  test "ticket priority defaults to normal, is staff-updatable, and stays internal to staff" do
+    owner_token, = create_account_and_owner
+    agent_token, agent_id = invite_and_accept_agent(owner_token: owner_token)
+    avery_token, = register_verify_signin_customer
+
+    # Customer attempt to pass priority on create is ignored and not exposed
+    t1_id = nil
+    t2_id = nil
+    travel_to Time.utc(2026, 11, 22, 10, 0, 0) do
+      post "/api/v1/requests",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+        params: { request: { subject: "First request", priority: "high", comment: { body: "Help 1" } } },
+        as: :json
+      assert_response :created
+      assert_not json_body["request"].key?("priority")
+      t1_id = json_body.dig("request", "id")
+    end
+
+    travel_to Time.utc(2026, 11, 22, 10, 1, 0) do
+      post "/api/v1/requests",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+        params: { request: { subject: "Second request", comment: { body: "Help 2" } } },
+        as: :json
+      assert_response :created
+      t2_id = json_body.dig("request", "id")
+    end
+
+    # Snapshot customer view of t1 and list ordering
+    get "/api/v1/requests/#{t1_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    assert_response :ok
+    t1_request_before = json_body["request"]
+    assert_not t1_request_before.key?("priority")
+
+    # Staff sees default normal priority in list and show
+    get "/api/v1/tickets/#{t1_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{agent_token}" }
+    assert_response :ok
+    assert_equal "normal", json_body.dig("ticket", "priority")
+
+    get "/api/v1/tickets",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{agent_token}" }
+    assert_response :ok
+    assert_equal %w[normal normal], json_body["tickets"].map { |t| t["priority"] }
+
+    # Customer cannot set priority on request update
+    patch "/api/v1/requests/#{t1_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+      params: { request: { priority: "high" } },
+      as: :json
+    assert_response :ok
+    assert_not json_body["request"].key?("priority")
+
+    get "/api/v1/tickets/#{t1_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{agent_token}" }
+    assert_equal "normal", json_body.dig("ticket", "priority")
+
+    # Customer cannot hit staff ticket endpoint
+    patch "/api/v1/tickets/#{t1_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+      params: { ticket: { priority: "high" } },
+      as: :json
+    assert_response :forbidden
+
+    # Staff updates priority to high later -> internal only, does not change customer updated_at or ordering
+    travel_to Time.utc(2026, 11, 22, 10, 30, 0) do
+      patch "/api/v1/tickets/#{t1_id}",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{agent_token}" },
+        params: { ticket: { priority: "high", assignee_id: agent_id } },
+        as: :json
+      assert_response :ok
+      assert_equal "high", json_body.dig("ticket", "priority")
+      assert_equal agent_id, json_body.dig("ticket", "assignee_id")
+    end
+
+    # Customer request view and order remain completely unchanged
+    get "/api/v1/requests/#{t1_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    assert_response :ok
+    assert_equal t1_request_before, json_body["request"]
+
+    get "/api/v1/requests",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    assert_response :ok
+    assert_equal [ t2_id, t1_id ], json_body["requests"].map { |r| r["id"] }
+    json_body["requests"].each do |req|
+      assert_not req.key?("priority")
+    end
+
+    # Staff list reflects updated_at bump (t1 now first)
