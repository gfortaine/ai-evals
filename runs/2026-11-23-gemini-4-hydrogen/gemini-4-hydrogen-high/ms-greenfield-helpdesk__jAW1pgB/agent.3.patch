diff --git a/app/controllers/api/v1/invitations_controller.rb b/app/controllers/api/v1/invitations_controller.rb
new file mode 100644
index 0000000..097aad8
--- /dev/null
+++ b/app/controllers/api/v1/invitations_controller.rb
@@ -0,0 +1,118 @@
+module Api
+  module V1
+    class InvitationsController < BaseController
+      before_action :require_account!
+      before_action :require_active_account!
+      before_action :authenticate_user!
+      before_action :require_admin!
+      before_action :set_invitation, only: %i[show resend destroy]
+
+      def index
+        scope = current_account.invitations.includes(:invited_by)
+
+        if params[:status].present?
+          status = params[:status].to_s
+          unless Invitation::STATUSES.include?(status)
+            render json: { error: "Invalid status filter" }, status: :unprocessable_entity
+            return
+          end
+          scope = scope.public_send(status)
+        end
+
+        scope = scope.ordered_by_id
+        result = paginate(scope)
+
+        render json: {
+          invitations: result[:records].map { |invitation| serialize_invitation(invitation) }
+        }.merge(result[:meta]), status: :ok
+      end
+
+      def show
+        render json: { invitation: serialize_invitation(@invitation) }, status: :ok
+      end
+
+      def create
+        invitation_params = params.require(:invitation)
+        invitation = nil
+        saved = false
+
+        Invitation.transaction do
+          current_account.lock!
+          invitation = current_account.invitations.build(
+            email: invitation_params[:email],
+            role: invitation_params[:role],
+            invited_by: current_user
+          )
+          if invitation.save
+            saved = true
+          else
+            raise ActiveRecord::Rollback
+          end
+        end
+
+        if saved
+          UserMailer.invitation(invitation, invitation.plain_token).deliver_now
+          render json: { invitation: serialize_invitation(invitation) }, status: :created
+        else
+          render json: { errors: invitation.errors.messages }, status: :unprocessable_entity
+        end
+      end
+
+      def resend
+        raw_token = nil
+        error_message = nil
+
+        Invitation.transaction do
+          current_account.lock!
+          @invitation.lock!
+
+          if @invitation.accepted?
+            error_message = "Accepted invitations cannot be resent"
+          elsif @invitation.revoked?
+            error_message = "Revoked invitations cannot be resent"
+          elsif current_account.users.exists?(email: @invitation.email)
+            error_message = "Email already belongs to a user in this account"
+          elsif current_account.invitations.pending.where.not(id: @invitation.id).exists?(email: @invitation.email)
+            error_message = "Email already has a pending invitation"
+          else
+            raw_token = @invitation.resend!
+          end
+        end
+
+        if error_message
+          render json: { error: error_message }, status: :unprocessable_entity
+          return
+        end
+
+        UserMailer.invitation(@invitation, raw_token).deliver_now
+        render json: { invitation: serialize_invitation(@invitation.reload) }, status: :ok
+      end
+
+      def destroy
+        error_message = nil
+
+        Invitation.transaction do
+          @invitation.lock!
+          if @invitation.pending?
+            @invitation.revoke!
+          else
+            error_message = "Only pending invitations can be revoked"
+          end
+        end
+
+        if error_message
+          render json: { error: error_message }, status: :unprocessable_entity
+          return
+        end
+
+        render json: { invitation: serialize_invitation(@invitation.reload) }, status: :ok
+      end
+
+      private
+
+      def set_invitation
+        @invitation = current_account.invitations.includes(:invited_by).find(params[:id])
+      end
+    end
+  end
+end
