diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
new file mode 100644
index 0000000..decf132
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,69 @@
+module Api
+  module V1
+    class InvitationAcceptancesController < BaseController
+      before_action :require_account!
+      before_action :require_active_account!
+
+      def create
+        acceptance_params = params.require(:invitation_acceptance)
+        token = acceptance_params[:token].to_s
+
+        invitation = nil
+        user = nil
+        error_message = nil
+        accepted = false
+
+        Invitation.transaction do
+          current_account.lock!
+          invitation = current_account.invitations.find_by_token(token)
+
+          if invitation.nil?
+            error_message = "Invitation token is invalid or has expired"
+            raise ActiveRecord::Rollback
+          end
+
+          invitation.lock!
+
+          if invitation.accepted?
+            error_message = "Invitation has already been accepted"
+            raise ActiveRecord::Rollback
+          elsif invitation.revoked?
+            error_message = "Invitation has been revoked"
+            raise ActiveRecord::Rollback
+          elsif invitation.expired?
+            error_message = "Invitation has expired"
+            raise ActiveRecord::Rollback
+          end
+
+          user = current_account.users.build(
+            name: acceptance_params[:name],
+            email: invitation.email,
+            password: acceptance_params[:password],
+            role: invitation.role,
+            verified: true,
+            verified_at: Time.current,
+            suspended: false
+          )
+
+          if user.save
+            invitation.update!(accepted_at: Time.current)
+            accepted = true
+          else
+            raise ActiveRecord::Rollback
+          end
+        end
+
+        if error_message
+          render json: { error: error_message }, status: :unprocessable_entity
+        elsif accepted
+          render json: {
+            user: serialize_user(user),
+            account: serialize_account(current_account)
+          }, status: :created
+        else
+          render json: { errors: user.errors.messages }, status: :unprocessable_entity
+        end
+      end
+    end
+  end
+end
