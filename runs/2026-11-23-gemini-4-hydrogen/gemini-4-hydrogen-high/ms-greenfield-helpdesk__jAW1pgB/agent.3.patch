diff --git a/test/integration/helpdesk_team_invitations_and_users_test.rb b/test/integration/helpdesk_team_invitations_and_users_test.rb
new file mode 100644
index 0000000..901a980
--- /dev/null
+++ b/test/integration/helpdesk_team_invitations_and_users_test.rb
@@ -0,0 +1,610 @@
+require "test_helper"
+
+class HelpdeskTeamInvitationsAndUsersTest < ActionDispatch::IntegrationTest
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  teardown do
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def extract_token_from_last_email
+    mail = ActionMailer::Base.deliveries.last
+    assert_not_nil mail
+    body = mail.text_part ? mail.text_part.body.decoded : mail.body.decoded
+    match = body.match(/token=([^\s&"']+)/)
+    assert_not_nil match, "Expected token in email body: #{body}"
+    CGI.unescape(match[1])
+  end
+
+  def create_account_and_owner(subdomain: "acme", name: "Acme", email: "jo@acme.test", admin_name: "Jo", password: "owner-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: {
+            name: admin_name,
+            email: email,
+            password: password
+          }
+        }
+      },
+      as: :json
+    assert_response :created
+    owner_id = json_body.dig("user", "id")
+
+    token = extract_token_from_last_email
+    post "/api/v1/email_verifications/confirm",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { email_verification: { token: token } },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { session: { email: email, password: password } },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    [ json_body.dig("session", "token"), owner_id ]
+  end
+
+  def register_verify_signin_customer(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    post "/api/v1/registrations",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { user: { name: name, email: email, password: password } },
+      as: :json
+    assert_response :created
+    user_id = json_body.dig("user", "id")
+
+    token = extract_token_from_last_email
+    post "/api/v1/email_verifications/confirm",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { email_verification: { token: token } },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => subdomain },
+      params: { session: { email: email, password: password } },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    [ json_body.dig("session", "token"), user_id ]
+  end
+
+  test "admin invites team members, previews and accepts invitation, manages lifecycle and filters" do
+    owner_token, owner_id = create_account_and_owner
+    beta_owner_token, = create_account_and_owner(subdomain: "beta", name: "Beta", email: "jo@beta.test")
+
+    # Invite Sam as agent
+    post "/api/v1/invitations",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { invitation: { email: "sam@example.test", role: "agent" } },
+      as: :json
+    assert_response :created
+    inv = json_body["invitation"]
+    assert_not_nil inv
+    sam_inv_id = inv["id"]
+    assert_equal "sam@example.test", inv["email"]
+    assert_equal "agent", inv["role"]
+    assert_equal "pending", inv["status"]
+    assert_equal owner_id, inv["invited_by_id"]
+    assert_nil inv["token"]
+    assert_nil inv["token_digest"]
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "sam@example.test" ], mail.to
+    assert_includes mail.text_part.body.decoded, "http://localhost:3001/accept-invitation?account=acme&token="
+    first_token = extract_token_from_last_email
+
+    # Competing invitation rejected
+    post "/api/v1/invitations",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { invitation: { email: "SAM@example.test", role: "admin" } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Customer registration cannot take a pending invite's email on same account
+    post "/api/v1/registrations",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { user: { name: "Sam Imp", email: "SAM@example.test", password: "password123" } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Customer role not invitable
+    post "/api/v1/invitations",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { invitation: { email: "cust@example.test", role: "customer" } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Same email CAN be invited on a different business
+    post "/api/v1/invitations",
+      headers: { "X-Helpdesk-Account" => "beta", "Authorization" => "Bearer #{beta_owner_token}" },
+      params: { invitation: { email: "sam@example.test", role: "agent" } },
+      as: :json
+    assert_response :created
+    beta_inv_id = json_body.dig("invitation", "id")
+
+    # Resend replaces token
+    post "/api/v1/invitations/#{sam_inv_id}/resend",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+    assert_equal "pending", json_body.dig("invitation", "status")
+    second_token = extract_token_from_last_email
+    assert_not_equal first_token, second_token
+
+    # Old token fails preview and acceptance
+    post "/api/v1/invitation_previews",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { invitation_preview: { token: first_token } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/invitation_acceptances",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { invitation_acceptance: { token: first_token, name: "Sam", password: "my-team-password" } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Beta cannot preview Acme's token
+    post "/api/v1/invitation_previews",
+      headers: { "X-Helpdesk-Account" => "beta" },
+      params: { invitation_preview: { token: second_token } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Preview valid token on Acme
+    post "/api/v1/invitation_previews",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { invitation_preview: { token: second_token } },
+      as: :json
+    assert_response :ok
+    preview = json_body["invitation_preview"]
+    assert_equal "sam@example.test", preview["email"]
+    assert_equal "agent", preview["role"]
+    assert_equal "Acme", preview["account_name"] || preview.dig("account", "name")
+    assert_equal "acme", preview["subdomain"]
+    assert_not_nil preview["expires_at"]
+
+    # Invalid acceptance payload does NOT consume token
+    post "/api/v1/invitation_acceptances",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { invitation_acceptance: { token: second_token, name: "Sam", password: "123" } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Valid acceptance creates verified user without sending verification email
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/invitation_acceptances",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { invitation_acceptance: { token: second_token, name: "Sam", password: "my-team-password" } },
+      as: :json
+    assert_response :created
+    assert_equal 0, ActionMailer::Base.deliveries.size
+    assert_equal "sam@example.test", json_body.dig("user", "email")
+    assert_equal "Sam", json_body.dig("user", "name")
+    assert_equal "agent", json_body.dig("user", "role")
+    assert_equal true, json_body.dig("user", "verified")
+    assert_equal false, json_body.dig("user", "suspended")
+    assert_equal "acme", json_body.dig("account", "subdomain")
+    sam_id = json_body.dig("user", "id")
+
+    # Token cannot be reused
+    post "/api/v1/invitation_acceptances",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { invitation_acceptance: { token: second_token, name: "Sam 2", password: "my-team-password" } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Cannot resend or revoke accepted invitation
+    post "/api/v1/invitations/#{sam_inv_id}/resend",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :unprocessable_entity
+
+    delete "/api/v1/invitations/#{sam_inv_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :unprocessable_entity
+
+    # Sam can sign in immediately
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { session: { email: "sam@example.test", password: "my-team-password" } },
+      as: :json
+    assert_response :created
+    sam_token = json_body.dig("session", "token")
+
+    # Agent cannot manage invitations or users
+    get "/api/v1/invitations",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" }
+    assert_response :forbidden
+
+    post "/api/v1/invitations",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" },
+      params: { invitation: { email: "other@example.test", role: "agent" } },
+      as: :json
+    assert_response :forbidden
+
+    get "/api/v1/users",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" }
+    assert_response :forbidden
+
+    patch "/api/v1/users/#{sam_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" },
+      params: { user: { suspended: true } },
+      as: :json
+    assert_response :forbidden
+
+    # Cross-tenant invitation inspect is 404
+    get "/api/v1/invitations/#{beta_inv_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :not_found
+
+    # Create a revocable invite and an expirable invite and a pending invite
+    post "/api/v1/invitations",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { invitation: { email: "revoked@example.test", role: "agent" } },
+      as: :json
+    assert_response :created
+    rev_id = json_body.dig("invitation", "id")
+    rev_token = extract_token_from_last_email
+
+    delete "/api/v1/invitations/#{rev_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+    assert_equal "revoked", json_body.dig("invitation", "status")
+
+    # Revoked token rejected
+    post "/api/v1/invitation_previews",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { invitation_preview: { token: rev_token } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Customer CAN register with revoked invitation's email
+    post "/api/v1/registrations",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { user: { name: "Rev", email: "revoked@example.test", password: "password123" } },
+      as: :json
+    assert_response :created
+
+    # Expirable invite
+    post "/api/v1/invitations",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { invitation: { email: "expired@example.test", role: "admin" } },
+      as: :json
+    assert_response :created
+    exp_id = json_body.dig("invitation", "id")
+    exp_token = extract_token_from_last_email
+
+    travel 8.days do
+      # Create a fresh pending invite at day 8
+      post "/api/v1/invitations",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+        params: { invitation: { email: "pending@example.test", role: "admin" } },
+        as: :json
+      assert_response :created
+      pend_id = json_body.dig("invitation", "id")
+
+      # Expired token cannot be previewed or accepted
+      post "/api/v1/invitation_previews",
+        headers: { "X-Helpdesk-Account" => "acme" },
+        params: { invitation_preview: { token: exp_token } },
+        as: :json
+      assert_response :unprocessable_entity
+
+      post "/api/v1/invitation_acceptances",
+        headers: { "X-Helpdesk-Account" => "acme" },
+        params: { invitation_acceptance: { token: exp_token, name: "Exp", password: "password123" } },
+        as: :json
+      assert_response :unprocessable_entity
+
+      # List all invitations by ID ascending
+      get "/api/v1/invitations",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+      assert_response :ok
+      assert_equal [ sam_inv_id, rev_id, exp_id, pend_id ], json_body["invitations"].map { |i| i["id"] }
+      assert_equal %w[accepted revoked expired pending], json_body["invitations"].map { |i| i["status"] }
+
+      # Filter by status
+      {
+        "pending" => [ pend_id ],
+        "accepted" => [ sam_inv_id ],
+        "revoked" => [ rev_id ],
+        "expired" => [ exp_id ]
+      }.each do |status, expected_ids|
+        get "/api/v1/invitations",
+          headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+          params: { status: status }
+        assert_response :ok
+        assert_equal expected_ids, json_body["invitations"].map { |i| i["id"] }
+      end
+
+      # Inspect single invitation
+      get "/api/v1/invitations/#{exp_id}",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+      assert_response :ok
+      assert_equal "expired", json_body.dig("invitation", "status")
+    end
+  end
+
+  test "users, staff, suspension, ticket assignment, and internal activity isolation" do
+    owner_token, owner_id = create_account_and_owner
+    avery_token, avery_id = register_verify_signin_customer
+
+    # Invite & accept agent Sam and second admin Morgan
+    post "/api/v1/invitations",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { invitation: { email: "sam@example.test", role: "agent" } },
+      as: :json
+    assert_response :created
+    sam_inv_token = extract_token_from_last_email
+
+    post "/api/v1/invitation_acceptances",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { invitation_acceptance: { token: sam_inv_token, name: "Sam", password: "sam-password" } },
+      as: :json
+    assert_response :created
+    sam_id = json_body.dig("user", "id")
+
+    post "/api/v1/invitations",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { invitation: { email: "morgan@example.test", role: "admin" } },
+      as: :json
+    assert_response :created
+    morgan_inv_token = extract_token_from_last_email
+
+    post "/api/v1/invitation_acceptances",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { invitation_acceptance: { token: morgan_inv_token, name: "Morgan", password: "morgan-password" } },
+      as: :json
+    assert_response :created
+    morgan_id = json_body.dig("user", "id")
+
+    # Sign in Sam and Morgan
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { session: { email: "sam@example.test", password: "sam-password" } },
+      as: :json
+    assert_response :created
+    sam_token = json_body.dig("session", "token")
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { session: { email: "morgan@example.test", password: "morgan-password" } },
+      as: :json
+    assert_response :created
+    morgan_token = json_body.dig("session", "token")
+
+    # GET /users ordered by ID ascending + filters
+    get "/api/v1/users",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+    assert_equal [ owner_id, avery_id, sam_id, morgan_id ], json_body["users"].map { |u| u["id"] }
+
+    get "/api/v1/users",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { role: "admin" }
+    assert_response :ok
+    assert_equal [ owner_id, morgan_id ], json_body["users"].map { |u| u["id"] }
+
+    get "/api/v1/users",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { suspended: "false", role: "agent" }
+    assert_response :ok
+    assert_equal [ sam_id ], json_body["users"].map { |u| u["id"] }
+
+    # GET /users/:id
+    get "/api/v1/users/#{sam_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+    assert_equal false, json_body.dig("user", "suspended")
+
+    # GET /staff accessible to agent (Sam) and admin, forbidden to customer
+    get "/api/v1/staff",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    assert_response :forbidden
+
+    get "/api/v1/staff",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" }
+    assert_response :ok
+    assert_equal [ owner_id, sam_id, morgan_id ], json_body["staff"].map { |u| u["id"] }
+
+    # Avery opens two requests at 10:00 and 10:01
+    ticket1_id = nil
+    ticket2_id = nil
+    travel_to Time.utc(2026, 11, 22, 10, 0, 0) do
+      post "/api/v1/requests",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+        params: { request: { subject: "First issue", comment: { body: "First body" } } },
+        as: :json
+      assert_response :created
+      ticket1_id = json_body.dig("request", "id")
+    end
+
+    travel_to Time.utc(2026, 11, 22, 10, 1, 0) do
+      post "/api/v1/requests",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" },
+        params: { request: { subject: "Second issue", comment: { body: "Second body" } } },
+        as: :json
+      assert_response :created
+      ticket2_id = json_body.dig("request", "id")
+    end
+
+    # Snapshot customer-facing request 1 and request list before internal activity
+    get "/api/v1/requests/#{ticket1_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    assert_response :ok
+    request1_before = json_body["request"]
+
+    get "/api/v1/requests",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    assert_response :ok
+    assert_equal [ ticket2_id, ticket1_id ], json_body["requests"].map { |r| r["id"] }
+
+    # Cannot assign ticket to customer
+    patch "/api/v1/tickets/#{ticket1_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" },
+      params: { ticket: { assignee_id: avery_id } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Agent assigns ticket 1 to Sam and posts a private note later at 10:30
+    travel_to Time.utc(2026, 11, 22, 10, 30, 0) do
+      patch "/api/v1/tickets/#{ticket1_id}",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" },
+        params: {
+          ticket: {
+            assignee_id: sam_id,
+            comment: { body: "Checking this with billing.", public: false }
+          }
+        },
+        as: :json
+      assert_response :ok
+      assert_equal sam_id, json_body.dig("ticket", "assignee_id")
+      assert_equal({ "id" => sam_id, "name" => "Sam" }, json_body.dig("ticket", "assignee"))
+    end
+
+    # Customer-facing request 1 and list ordering are COMPLETELY UNCHANGED!
+    get "/api/v1/requests/#{ticket1_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    assert_response :ok
+    assert_equal request1_before, json_body["request"]
+    assert_nil json_body.dig("request", "assignee_id")
+    assert_nil json_body.dig("request", "assignee")
+
+    get "/api/v1/requests",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    assert_response :ok
+    assert_equal [ ticket2_id, ticket1_id ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests/#{ticket1_id}/comments",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    assert_response :ok
+    assert_equal [ "First body" ], json_body["comments"].map { |c| c["body"] }
+
+    # Staff sees private note and assignee
+    get "/api/v1/tickets/#{ticket1_id}/comments",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+    assert_equal 2, json_body["comments"].size
+    assert_equal false, json_body["comments"].last["public"]
+
+    # Clear assignment with null
+    patch "/api/v1/tickets/#{ticket1_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { ticket: { assignee_id: nil } },
+      as: :json
+    assert_response :ok
+    assert_nil json_body.dig("ticket", "assignee_id")
+    assert_nil json_body.dig("ticket", "assignee")
+
+    # Re-assign to Sam, then suspend Sam
+    patch "/api/v1/tickets/#{ticket1_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { ticket: { assignee_id: sam_id } },
+      as: :json
+    assert_response :ok
+
+    patch "/api/v1/users/#{sam_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { user: { suspended: true } },
+      as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "suspended")
+
+    # Sam's session is revoked & Sam cannot sign in
+    get "/api/v1/tickets",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" }
+    assert_response :unauthorized
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { session: { email: "sam@example.test", password: "sam-password" } },
+      as: :json
+    assert_response :forbidden
+
+    # Sam's assignment was cleared
+    get "/api/v1/tickets/#{ticket1_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+    assert_nil json_body.dig("ticket", "assignee_id")
+    assert_nil json_body.dig("ticket", "assignee")
+
+    # Cannot assign to suspended Sam
+    patch "/api/v1/tickets/#{ticket1_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { ticket: { assignee_id: sam_id } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Suspended Sam excluded from /staff and included in /users?suspended=true
+    get "/api/v1/staff",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+    assert_equal [ owner_id, morgan_id ], json_body["staff"].map { |u| u["id"] }
+
+    get "/api/v1/users",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { suspended: "true" }
+    assert_response :ok
+    assert_equal [ sam_id ], json_body["users"].map { |u| u["id"] }
+
+    # Owner suspends Morgan (another active admin) -> allowed
+    patch "/api/v1/users/#{morgan_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { user: { suspended: true } },
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{morgan_token}" }
+    assert_response :unauthorized
+
+    # Owner cannot suspend the last active admin (themselves)
+    patch "/api/v1/users/#{owner_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { user: { suspended: true } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Owner cannot demote the last active admin
+    patch "/api/v1/users/#{owner_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { user: { role: "agent" } },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Unsuspending Sam allows Sam to sign in and appear in /staff again
+    patch "/api/v1/users/#{sam_id}",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" },
+      params: { user: { suspended: false } },
+      as: :json
+    assert_response :ok
+    assert_equal false, json_body.dig("user", "suspended")
+
+    post "/api/v1/sessions",
+      headers: { "X-Helpdesk-Account" => "acme" },
+      params: { session: { email: "sam@example.test", password: "sam-password" } },
+      as: :json
+    assert_response :created
+
+    get "/api/v1/staff",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+    assert_equal [ owner_id, sam_id ], json_body["staff"].map { |u| u["id"] }
+  end
+end
