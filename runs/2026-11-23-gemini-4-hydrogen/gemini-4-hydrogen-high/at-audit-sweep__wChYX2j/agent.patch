+
+  get slugged_leafable_path(books(:handbook), books(:handbook).slug, secret_leaf, secret_leaf.slug)
+  assert_response :not_found
+  assert_select ".page--page", count: 0
+end
 end
diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..77fcbb1
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "searches readable books" do
+    books(:manual).press(Page.new(body: "Secret"), title: "Welcome Secret Manual")
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Welcome Secret Manual"
+  end
+
+  test "searches published books when signed out and excludes unpublished books" do
+    books(:handbook).update!(published: true)
+    books(:manual).press(Page.new(body: "Secret"), title: "Welcome Secret Manual")
+
+    sign_out
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Welcome Secret Manual"
+  end
+
+  test "searches published books without accesses when signed in" do
+    public_book = Book.create!(title: "Public Guide", published: true)
+    public_book.press(Page.new(body: "Public body"), title: "Public Guide Intro")
+
+    get library_search_path, params: { q: "Public Guide Intro" }
+
+    assert_response :success
+    assert_in_body "Public Guide Intro"
+  end
+
+  test "treats apostrophes and SQL injection payloads as data" do
+    books(:handbook).press(Page.new(body: "Body"), title: "O'Reilly Guide")
+    books(:manual).press(Page.new(body: "Secret"), title: "Secret Manual Page")
+
+    get library_search_path, params: { q: "'" }
+    assert_response :success
+    assert_in_body "O&#39;Reilly Guide"
+    assert_not_in_body "Secret Manual Page"
+
+    get library_search_path, params: { q: "O'Reilly" }
+    assert_response :success
+    assert_in_body "O&#39;Reilly Guide"
+
+    get library_search_path, params: { q: "' OR '1'='1" }
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "treats percent and underscore literally rather than as wildcards" do
+    books(:handbook).press(Page.new(body: "Discount"), title: "Save 50% off")
+    books(:handbook).press(Page.new(body: "Snake"), title: "snake_case title")
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_not_in_body "snake_case title"
+
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_in_body "snake_case title"
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Save 50% off"
+  end
+
+  test "handles backslash literally without error" do
+    books(:handbook).press(Page.new(body: "Path"), title: 'C:\temp')
+
+    get library_search_path, params: { q: "\\" }
+    assert_response :success
+    assert_in_body 'C:\temp'
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+end
