+class AccountSignupAndAuthTest < ActionDispatch::IntegrationTest
+  test "business signup, email verification, resend replacement, and login" do
+    ActionMailer::Base.deliveries.clear
+
+    post "/api/v1/account/create", params: {
+      account: {
+        name: "Acme",
+        subdomain: "acme",
+        admin: {
+          name: "Jo",
+          email: "jo@acme.test",
+          password: "my-first-password"
+        }
+      }
+    }, as: :json
+
+    assert_response :created
+    body = json_body
+    assert_equal "Acme", body.dig("account", "name")
+    assert_equal "acme", body.dig("account", "subdomain")
+    assert_not_nil body.dig("account", "id")
+    assert_not_nil body.dig("account", "created_at")
+    assert_not_nil body.dig("account", "updated_at")
+
+    assert_equal "Jo", body.dig("user", "name")
+    assert_equal "jo@acme.test", body.dig("user", "email")
+    assert_equal "admin", body.dig("user", "role")
+    assert_equal false, body.dig("user", "verified")
+    assert_not_nil body.dig("user", "id")
+    assert_not_nil body.dig("user", "created_at")
+    assert_not_nil body.dig("user", "updated_at")
+    assert_nil body.dig("user", "password_digest")
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail1 = ActionMailer::Base.deliveries.last
+    assert_equal [ "support@example.test" ], mail1.from
+    assert_equal [ "jo@acme.test" ], mail1.to
+    token1 = extract_token_from_email(mail1)
+    assert_includes mail1.text_part.body.decoded, "http://localhost:3001/verify-email?account=acme&token=#{token1}"
+
+    # Unverified user cannot sign in
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :forbidden
+
+    # Request a new verification link; old token becomes invalid
+    post "/api/v1/email_verifications",
+         params: { email_verification: { email: "jo@acme.test" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :ok
+    assert_equal 2, ActionMailer::Base.deliveries.size
+    token2 = extract_token_from_email(ActionMailer::Base.deliveries.last)
+    assert_not_equal token1, token2
+
+    # Old token fails
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: token1 } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    # New token verifies
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: token2 } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "verified")
+
+    # Token cannot be reused
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: token2 } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    # Wrong password returns 401
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "wrong-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unauthorized
+
+    # Valid login succeeds
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :created
+    login_body = json_body
+    assert_not_nil login_body.dig("session", "token")
+    assert_equal true, login_body.dig("user", "verified")
+    assert_equal "acme", login_body.dig("account", "subdomain")
+  end
+
+  test "respects HELPDESK_FRONTEND_URL and HELPDESK_MAIL_FROM" do
+    old_frontend = ENV["HELPDESK_FRONTEND_URL"]
+    old_from = ENV["HELPDESK_MAIL_FROM"]
+    ENV["HELPDESK_FRONTEND_URL"] = "https://help.example.com/"
+    ENV["HELPDESK_MAIL_FROM"] = "noreply@help.example.com"
+    ActionMailer::Base.deliveries.clear
+
+    post "/api/v1/account/create", params: {
+      account: {
+        name: "Beta",
+        subdomain: "beta",
+        admin: { name: "Alex", email: "alex@beta.test", password: "my-first-password" }
+      }
+    }, as: :json
+    assert_response :created
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "noreply@help.example.com" ], mail.from
+    token = extract_token_from_email(mail)
+    assert_includes mail.text_part.body.decoded, "https://help.example.com/verify-email?account=beta&token=#{token}"
+  ensure
+    ENV["HELPDESK_FRONTEND_URL"] = old_frontend
+    ENV["HELPDESK_MAIL_FROM"] = old_from
+  end
+
+  test "signup validation errors" do
+    create_verified_account(subdomain: "acme")
+
+    post "/api/v1/account/create", params: {
+      account: {
+        name: "Acme 2",
+        subdomain: "acme",
+        admin: { name: "Jo", email: "bad-email", password: "short" }
+      }
+    }, as: :json
+    assert_response :unprocessable_entity
+    assert json_body["errors"].present?
+  end
+end
diff --git a/test/integration/cors_test.rb b/test/integration/cors_test.rb
new file mode 100644
index 0000000..24df021
--- /dev/null
+++ b/test/integration/cors_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class CorsTest < ActionDispatch::IntegrationTest
+  test "allows requests from default frontend origin and blocks others" do
+    create_verified_account(subdomain: "acme")
+
+    options "/api/v1/portal", headers: {
+      "Origin" => "http://localhost:3001",
+      "Access-Control-Request-Method" => "GET",
+      "Access-Control-Request-Headers" => "X-Helpdesk-Account, Authorization"
+    }
+    assert_response :no_content
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+    assert_includes response.headers["Access-Control-Allow-Headers"], "X-Helpdesk-Account"
+
+    get "/api/v1/portal", headers: {
+      "Origin" => "http://localhost:3001",
+      "X-Helpdesk-Account" => "acme"
+    }
+    assert_response :ok
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+
+    get "/api/v1/portal", headers: {
+      "Origin" => "http://evil.example",
+      "X-Helpdesk-Account" => "acme"
+    }
+    assert_response :ok
+    assert_nil response.headers["Access-Control-Allow-Origin"]
+  end
+
+  test "respects custom HELPDESK_FRONTEND_URL for CORS" do
+    old_frontend = ENV["HELPDESK_FRONTEND_URL"]
+    ENV["HELPDESK_FRONTEND_URL"] = "https://portal.example.com"
+    create_verified_account(subdomain: "acme")
+
+    get "/api/v1/portal", headers: {
+      "Origin" => "https://portal.example.com",
+      "X-Helpdesk-Account" => "acme"
+    }
+    assert_response :ok
+    assert_equal "https://portal.example.com", response.headers["Access-Control-Allow-Origin"]
+
+    get "/api/v1/portal", headers: {
+      "Origin" => "http://localhost:3001",
+      "X-Helpdesk-Account" => "acme"
+    }
+    assert_response :ok
+    assert_nil response.headers["Access-Control-Allow-Origin"]
+  ensure
+    ENV["HELPDESK_FRONTEND_URL"] = old_frontend
+  end
+end
diff --git a/test/integration/password_management_test.rb b/test/integration/password_management_test.rb
new file mode 100644
index 0000000..3363b7e
--- /dev/null
+++ b/test/integration/password_management_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class PasswordManagementTest < ActionDispatch::IntegrationTest
+  test "changing password signs out existing sessions" do
+    create_verified_account(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token1 = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token2 = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    # Wrong current_password
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "wrong", password: "my-new-password" } },
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" },
+        as: :json
+    assert_response :unprocessable_entity
+
+    # Valid password change
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" },
+        as: :json
+    assert_response :ok
+
+    # All existing sessions are signed out
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" }
+    assert_response :unauthorized
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token2}" }
+    assert_response :unauthorized
+
+    # Old password fails, new password succeeds
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unauthorized
+
+    new_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-new-password")
+    assert_not_nil new_token
+  end
+
+  test "password reset flow replaces old links and signs out existing sessions" do
+    create_verified_account(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    session_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    ActionMailer::Base.deliveries.clear
+
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "jo@acme.test" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :ok
+    mail1 = ActionMailer::Base.deliveries.last
+    token1 = extract_token_from_email(mail1)
+    assert_includes mail1.text_part.body.decoded, "http://localhost:3001/reset-password?account=acme&token=#{token1}"
+
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "jo@acme.test" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :ok
+    token2 = extract_token_from_email(ActionMailer::Base.deliveries.last)
+    assert_not_equal token1, token2
+
+    # Old token rejected
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: token1, password: "my-new-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    # Short password rejected without consuming token2
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: token2, password: "short" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    # Valid reset succeeds
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: token2, password: "my-new-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :ok
+
+    # Existing session signed out
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{session_token}" }
+    assert_response :unauthorized
+
+    # Token cannot be reused
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: token2, password: "another-new-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    # Can sign in with new password
+    sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-new-password")
+  end
+end
diff --git a/test/integration/tenant_and_profile_test.rb b/test/integration/tenant_and_profile_test.rb
new file mode 100644
index 0000000..ad59afb
--- /dev/null
+++ b/test/integration/tenant_and_profile_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class TenantAndProfileTest < ActionDispatch::IntegrationTest
+  test "portal, account, profile update, and single session sign out" do
+    create_verified_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+
+    # Missing header -> 400
+    get "/api/v1/portal"
+    assert_response :bad_request
+
+    # Unknown account -> 404
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "unknown" }
+    assert_response :not_found
+
+    # Public portal
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :ok
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, json_body)
+
+    # Full account requires auth
+    get "/api/v1/account", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :unauthorized
+
+    token1 = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token2 = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    get "/api/v1/account", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" }
+    assert_response :ok
+    assert_equal "Acme", json_body.dig("account", "name")
+    assert_not_nil json_body.dig("account", "id")
+
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" }
+    assert_response :ok
+    assert_equal "Jo", json_body.dig("user", "name")
+
+    patch "/api/v1/me",
+          params: { user: { name: "Jo Smith", role: "customer" } },
+          headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" },
+          as: :json
+    assert_response :ok
+    assert_equal "Jo Smith", json_body.dig("user", "name")
+    assert_equal "admin", json_body.dig("user", "role")
+
+    # Sign out only session 1
+    delete "/api/v1/session", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" }
+    assert_response :no_content
+
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" }
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token2}" }
+    assert_response :ok
+    assert_equal "Jo Smith", json_body.dig("user", "name")
+  end
+
+  test "same email can belong to different businesses and tenants are isolated" do
+    create_verified_account(name: "Acme", subdomain: "acme", admin_name: "Jo Acme", email: "jo@shared.test", password: "my-first-password")
+    create_verified_account(name: "Beta", subdomain: "beta", admin_name: "Jo Beta", email: "jo@shared.test", password: "beta-first-password")
+
+    acme_token = sign_in(subdomain: "acme", email: "jo@shared.test", password: "my-first-password")
+    beta_token = sign_in(subdomain: "beta", email: "jo@shared.test", password: "beta-first-password")
+
+    # Acme token rejected on beta
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "beta", "Authorization" => "Bearer #{acme_token}" }
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{acme_token}" }
+    assert_response :ok
+    assert_equal "Jo Acme", json_body.dig("user", "name")
+
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "beta", "Authorization" => "Bearer #{beta_token}" }
+    assert_response :ok
+    assert_equal "Jo Beta", json_body.dig("user", "name")
+  end
+end
