+++ b/test/tasks/purge_cancelled_accounts_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+require "rake"
+
+class PurgeCancelledAccountsTest < ActiveSupport::TestCase
+  setup do
+    Rails.application.load_tasks if Rake::Task.tasks.empty?
+  end
+
+  test "helpdesk:purge_cancelled_accounts deletes only accounts cancelled more than 90 days ago" do
+    expired = Account.create!(name: "Old", subdomain: "old-co", cancelled_at: 91.days.ago)
+    u = expired.users.create!(
+      name: "Owner",
+      email: "owner@old.test",
+      password: "my-first-password",
+      role: "admin",
+      verified_at: Time.current
+    )
+    u.issue_email_verification_token!
+    Session.issue_for!(u)
+
+    recent = Account.create!(name: "Recent", subdomain: "recent-co", cancelled_at: 89.days.ago)
+    active = Account.create!(name: "Active", subdomain: "active-co")
+
+    Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+    Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+
+    assert_nil Account.find_by(id: expired.id)
+    assert_equal 0, User.where(account_id: expired.id).count
+    assert_equal 0, Session.where(account_id: expired.id).count
+    assert_equal 0, UserToken.where(user_id: u.id).count
+
+    assert Account.exists?(recent.id)
+    assert Account.exists?(active.id)
+  end
+end
diff --git a/test/test_helper.rb b/test/test_helper.rb
new file mode 100644
index 0000000..a19fe06
--- /dev/null
+++ b/test/test_helper.rb
@@ -0,0 +1,53 @@
+ENV["RAILS_ENV"] ||= "test"
+require_relative "../config/environment"
+require "rails/test_help"
+
+module ActiveSupport
+  class TestCase
+    parallelize(workers: :number_of_processors)
+
+    def json_body
+      ::JSON.parse(response.body)
+    end
+
+    def extract_token_from_email(mail)
+      body = mail.text_part ? mail.text_part.body.decoded : mail.body.decoded
+      match = body.match(/token=([A-Za-z0-9_-]+)/)
+      assert match, "Expected token in email body:\n#{body}"
+      match[1]
+    end
+
+    def create_verified_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+      ActionMailer::Base.deliveries.clear
+      post "/api/v1/account/create", params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: {
+            name: admin_name,
+            email: email,
+            password: password
+          }
+        }
+      }, as: :json
+      assert_response :created
+      token = extract_token_from_email(ActionMailer::Base.deliveries.last)
+
+      post "/api/v1/email_verifications/confirm",
+           params: { email_verification: { token: token } },
+           headers: { "X-Helpdesk-Account" => subdomain },
+           as: :json
+      assert_response :ok
+      Account.find_by!(subdomain: subdomain)
+    end
+
+    def sign_in(subdomain:, email:, password:)
+      post "/api/v1/sessions",
+           params: { session: { email: email, password: password } },
+           headers: { "X-Helpdesk-Account" => subdomain },
+           as: :json
+      assert_response :created
+      json_body.dig("session", "token")
+    end
+  end
+end
