+    class PasswordsController < BaseController
+      def update
+        attrs = params.require(:password_change).permit(:current_password, :password)
+
+        unless current_user.authenticate(attrs[:current_password].to_s)
+          return render json: {
+            error: "Current password is invalid",
+            errors: { current_password: [ "is invalid" ] }
+          }, status: :unprocessable_entity
+        end
+
+        new_password = attrs[:password]
+        if new_password.blank?
+          return render json: {
+            error: "Password can't be blank",
+            errors: { password: [ "can't be blank" ] }
+          }, status: :unprocessable_entity
+        end
+
+        current_user.password = new_password
+        unless current_user.valid?
+          return render json: {
+            error: current_user.errors.full_messages.first,
+            errors: current_user.errors.to_hash
+          }, status: :unprocessable_entity
+        end
+
+        ActiveRecord::Base.transaction do
+          current_user.save!
+          current_user.revoke_sessions!
+        end
+
+        render json: { message: "Password updated" }, status: :ok
+      end
+    end
+  end
+end
