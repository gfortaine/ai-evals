diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..6a65483
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,77 @@
+module Api
+  module V1
+    class AccountsController < BaseController
+      skip_before_action :require_account!, only: :create
+      skip_before_action :require_authentication!, only: :create
+      skip_before_action :require_active_account!, only: %i[create reactivate]
+      before_action :require_admin!, only: %i[cancel reactivate]
+
+      def create
+        account_params = params.require(:account)
+        admin_params = account_params.require(:admin)
+
+        account = Account.new(
+          name: account_params[:name],
+          subdomain: account_params[:subdomain]
+        )
+        admin = account.users.build(
+          name: admin_params[:name],
+          email: admin_params[:email],
+          password: admin_params[:password],
+          role: "admin"
+        )
+
+        unless account.valid? & admin.valid?
+          errors = collect_signup_errors(account, admin)
+          return render json: { error: errors.values.flatten.first || "Validation failed", errors: errors },
+                        status: :unprocessable_entity
+        end
+
+        verification_token = nil
+        ActiveRecord::Base.transaction do
+          account.save!
+          admin.save!
+          verification_token = admin.issue_email_verification_token!
+        end
+
+        UserMailer.email_verification(admin, verification_token).deliver_now
+
+        render json: {
+          account: serialize_account(account),
+          user: serialize_user(admin)
+        }, status: :created
+      end
+
+      def show
+        render json: { account: serialize_account(current_account) }, status: :ok
+      end
+
+      def cancel
+        current_account.cancel!
+        render json: { account: serialize_account(current_account) }, status: :ok
+      end
+
+      def reactivate
+        unless current_account.cancelled?
+          return render json: { error: "Account is not cancelled" }, status: :unprocessable_entity
+        end
+
+        unless current_account.within_reactivation_window?
+          return render json: { error: "Reactivation window has expired" }, status: :forbidden
+        end
+
+        current_account.reactivate!
+        render json: { account: serialize_account(current_account) }, status: :ok
+      end
+
+      private
+
+      def collect_signup_errors(account, admin)
+        errors = {}
+        account.errors.to_hash.each { |k, v| errors[k] = v }
+        admin.errors.to_hash.each { |k, v| errors[:"admin_#{k}"] = v }
+        errors
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..3dedb3e
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,98 @@
+module Api
+  module V1
+    class BaseController < ApplicationController
+      before_action :require_account!
+      before_action :require_authentication!
+      before_action :require_active_account!
+
+      rescue_from ActionController::ParameterMissing do |e|
+        render json: { error: e.message }, status: :bad_request
+      end
+
+      private
+
+      attr_reader :current_account, :current_session, :current_user
+
+      def require_account!
+        subdomain = request.headers["X-Helpdesk-Account"].to_s.strip.downcase
+        if subdomain.blank?
+          return render json: { error: "X-Helpdesk-Account header is required" }, status: :bad_request
+        end
+
+        @current_account = Account.find_by(subdomain: subdomain)
+        if @current_account.nil?
+          render json: { error: "Account not found" }, status: :not_found
+        end
+      end
+
+      def require_authentication!
+        token = bearer_token
+        @current_session = Session.find_by_token(token, account: current_account)
+        if @current_session.nil?
+          return render json: { error: "Unauthorized" }, status: :unauthorized
+        end
+
+        @current_user = @current_session.user
+      end
+
+      def require_active_account!
+        return unless @current_account&.cancelled?
+
+        render json: { error: "Account is cancelled" }, status: :forbidden
+      end
+
+      def require_admin!
+        return if current_user&.admin?
+
+        render json: { error: "Forbidden" }, status: :forbidden
+      end
+
+      def bearer_token
+        header = request.headers["Authorization"].to_s
+        match = header.match(/\ABearer\s+(.+)\z/i)
+        match ? match[1].strip : nil
+      end
+
+      def serialize_account(account)
+        {
+          id: account.id,
+          name: account.name,
+          subdomain: account.subdomain,
+          cancelled_at: account.cancelled_at,
+          created_at: account.created_at,
+          updated_at: account.updated_at
+        }
+      end
+
+      def serialize_portal(account)
+        {
+          name: account.name,
+          subdomain: account.subdomain
+        }
+      end
+
+      def serialize_user(user)
+        {
+          id: user.id,
+          account_id: user.account_id,
+          name: user.name,
+          email: user.email,
+          role: user.role,
+          verified: user.verified?,
+          verified_at: user.verified_at,
+          created_at: user.created_at,
+          updated_at: user.updated_at
+        }
+      end
+
+      def serialize_session(session, raw_token)
+        {
+          id: session.id,
+          token: raw_token,
+          created_at: session.created_at,
+          updated_at: session.updated_at
+        }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
new file mode 100644
index 0000000..da3b788
--- /dev/null
+++ b/app/controllers/api/v1/email_verifications_controller.rb
@@ -0,0 +1,46 @@
+module Api
+  module V1
+    class EmailVerificationsController < BaseController
+      skip_before_action :require_authentication!
+
+      def create
+        attrs = params.require(:email_verification).permit(:email)
+        email = attrs[:email].to_s.strip.downcase
+
+        if email.blank?
+          return render json: {
+            error: "Email can't be blank",
+            errors: { email: [ "can't be blank" ] }
+          }, status: :unprocessable_entity
+        end
+
+        user = current_account.users.find_by(email: email)
+        if user && !user.verified?
+          token = user.issue_email_verification_token!
+          UserMailer.email_verification(user, token).deliver_now
+        end
+
+        render json: {
+          message: "If an unverified account exists for that email, a verification link has been sent."
+        }, status: :ok
+      end
+
+      def confirm
+        attrs = params.require(:email_verification).permit(:token)
+        token_record = UserToken.find_active(attrs[:token], purpose: "email_verification", account: current_account)
+
+        if token_record.nil?
+          return render json: { error: "Invalid or expired verification token" }, status: :unprocessable_entity
+        end
+
+        user = token_record.user
+        ActiveRecord::Base.transaction do
+          user.verify_email!
+          UserToken.where(user_id: user.id, purpose: "email_verification").delete_all
+        end
+
+        render json: { user: serialize_user(user) }, status: :ok
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/password_resets_controller.rb b/app/controllers/api/v1/password_resets_controller.rb
new file mode 100644
index 0000000..f8664da
--- /dev/null
+++ b/app/controllers/api/v1/password_resets_controller.rb
@@ -0,0 +1,63 @@
+module Api
+  module V1
+    class PasswordResetsController < BaseController
+      skip_before_action :require_authentication!
+
+      def create
+        attrs = params.require(:password_reset).permit(:email)
+        email = attrs[:email].to_s.strip.downcase
+
+        if email.blank?
+          return render json: {
+            error: "Email can't be blank",
+            errors: { email: [ "can't be blank" ] }
+          }, status: :unprocessable_entity
+        end
+
+        user = current_account.users.find_by(email: email)
+        if user
+          token = user.issue_password_reset_token!
+          UserMailer.password_reset(user, token).deliver_now
+        end
+
+        render json: {
+          message: "If an account exists for that email, a password reset link has been sent."
+        }, status: :ok
+      end
+
+      def confirm
+        attrs = params.require(:password_reset).permit(:token, :password)
+        token_record = UserToken.find_active(attrs[:token], purpose: "password_reset", account: current_account)
+
+        if token_record.nil?
+          return render json: { error: "Invalid or expired password reset token" }, status: :unprocessable_entity
+        end
+
+        new_password = attrs[:password]
+        if new_password.blank?
+          return render json: {
+            error: "Password can't be blank",
+            errors: { password: [ "can't be blank" ] }
+          }, status: :unprocessable_entity
+        end
+
+        user = token_record.user
+        user.password = new_password
+        unless user.valid?
+          return render json: {
+            error: user.errors.full_messages.first,
+            errors: user.errors.to_hash
+          }, status: :unprocessable_entity
+        end
+
+        ActiveRecord::Base.transaction do
+          user.save!
+          UserToken.where(user_id: user.id, purpose: "password_reset").delete_all
+          user.revoke_sessions!
+        end
+
+        render json: { message: "Password has been reset" }, status: :ok
+      end
+    end
+  end
+end
