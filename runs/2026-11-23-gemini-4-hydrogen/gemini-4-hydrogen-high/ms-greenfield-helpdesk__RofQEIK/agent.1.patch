@@ -0,0 +1,45 @@
+class User < ApplicationRecord
+  ROLES = %w[admin agent customer].freeze
+
+  belongs_to :account
+  has_many :sessions, dependent: :destroy
+  has_many :user_tokens, dependent: :destroy
+
+  has_secure_password
+
+  normalizes :name, with: ->(value) { value.to_s.strip }
+  normalizes :email, with: ->(value) { value.to_s.strip.downcase }
+
+  validates :name, presence: true
+  validates :email,
+            presence: true,
+            format: { with: URI::MailTo::EMAIL_REGEXP },
+            uniqueness: { scope: :account_id, case_sensitive: false }
+  validates :role, presence: true, inclusion: { in: ROLES }
+  validates :password, length: { minimum: 8 }, if: -> { password.present? }
+
+  def admin?
+    role == "admin"
+  end
+
+  def verified?
+    verified_at.present?
+  end
+  alias_method :verified, :verified?
+
+  def verify_email!
+    update!(verified_at: verified_at || Time.current)
+  end
+
+  def revoke_sessions!
+    sessions.destroy_all
+  end
+
+  def issue_email_verification_token!
+    UserToken.issue_for!(self, purpose: "email_verification", ttl: 48.hours)
+  end
+
+  def issue_password_reset_token!
+    UserToken.issue_for!(self, purpose: "password_reset", ttl: 2.hours)
+  end
+end
diff --git a/app/models/user_token.rb b/app/models/user_token.rb
new file mode 100644
index 0000000..9bbd456
--- /dev/null
+++ b/app/models/user_token.rb
@@ -0,0 +1,40 @@
+require "digest"
+require "securerandom"
+
+class UserToken < ApplicationRecord
+  PURPOSES = %w[email_verification password_reset].freeze
+
+  belongs_to :user
+
+  validates :purpose, presence: true, inclusion: { in: PURPOSES }
+  validates :token_digest, presence: true, uniqueness: true
+  validates :expires_at, presence: true
+
+  def self.digest(raw_token)
+    Digest::SHA256.hexdigest(raw_token.to_s)
+  end
+
+  def self.issue_for!(user, purpose:, ttl:)
+    raw_token = SecureRandom.urlsafe_base64(32, false)
+    transaction do
+      where(user_id: user.id, purpose: purpose).delete_all
+      create!(
+        user: user,
+        purpose: purpose,
+        token_digest: digest(raw_token),
+        expires_at: Time.current + ttl
+      )
+    end
+    raw_token
+  end
+
+  def self.find_active(raw_token, purpose:, account:)
+    return nil if raw_token.blank? || account.nil?
+
+    joins(:user)
+      .includes(:user)
+      .where(users: { account_id: account.id }, purpose: purpose, token_digest: digest(raw_token))
+      .where("user_tokens.expires_at > ?", Time.current)
+      .first
+  end
+end
