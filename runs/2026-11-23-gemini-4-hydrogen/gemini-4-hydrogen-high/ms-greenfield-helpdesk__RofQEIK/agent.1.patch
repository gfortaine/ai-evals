@@ -0,0 +1,33 @@
+require "cgi"
+
+class UserMailer < ApplicationMailer
+  def email_verification(user, token)
+    @user = user
+    @account = user.account
+    @verification_url = frontend_url("/verify-email", account: @account.subdomain, token: token)
+
+    mail(
+      to: @user.email,
+      subject: "Verify your email for #{@account.name}"
+    )
+  end
+
+  def password_reset(user, token)
+    @user = user
+    @account = user.account
+    @reset_url = frontend_url("/reset-password", account: @account.subdomain, token: token)
+
+    mail(
+      to: @user.email,
+      subject: "Reset your password for #{@account.name}"
+    )
+  end
+
+  private
+
+  def frontend_url(path, account:, token:)
+    base = ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001").presence || "http://localhost:3001"
+    base = base.chomp("/")
+    "#{base}#{path}?account=#{CGI.escape(account)}&token=#{CGI.escape(token)}"
+  end
+end
