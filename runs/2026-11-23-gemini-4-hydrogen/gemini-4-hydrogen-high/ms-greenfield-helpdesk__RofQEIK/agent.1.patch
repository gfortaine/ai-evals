+require "test_helper"
+
+class AccountCancellationTest < ActionDispatch::IntegrationTest
+  test "owner cancels account, loses business access, signs in to reactivate within 90 days" do
+    account = create_verified_account(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    agent = account.users.create!(
+      name: "Sam Agent",
+      email: "sam@acme.test",
+      password: "agent-password-123",
+      role: "agent",
+      verified_at: Time.current
+    )
+
+    owner_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    agent_token = sign_in(subdomain: "acme", email: "sam@acme.test", password: "agent-password-123")
+
+    # Non-owner cannot cancel
+    post "/api/v1/account/cancel", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{agent_token}" }
+    assert_response :forbidden
+
+    # Owner cancels
+    post "/api/v1/account/cancel", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+    assert_not_nil json_body.dig("account", "cancelled_at")
+
+    # Existing sessions are revoked
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :unauthorized
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{agent_token}" }
+    assert_response :unauthorized
+
+    # Ordinary business access stopped
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :forbidden
+
+    # Agent cannot sign in
+    post "/api/v1/sessions",
+         params: { session: { email: "sam@acme.test", password: "agent-password-123" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :forbidden
+
+    # Owner can still sign in to reactivate
+    reactivate_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+
+    # Ordinary business endpoints blocked until reactivated
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{reactivate_token}" }
+    assert_response :forbidden
+    get "/api/v1/account", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{reactivate_token}" }
+    assert_response :forbidden
+
+    # Travel 89 days (within 90 days) and reactivate
+    travel 89.days do
+      post "/api/v1/account/reactivate",
+           headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{reactivate_token}" }
+      assert_response :ok
+      assert_nil json_body.dig("account", "cancelled_at")
+    end
+
+    # Business access restored
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :ok
+    get "/api/v1/account", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{reactivate_token}" }
+    assert_response :ok
+    sign_in(subdomain: "acme", email: agent.email, password: "agent-password-123")
+  end
+
+  test "cannot reactivate after 90 days and purge removes expired cancelled accounts and all data" do
+    expired = create_verified_account(name: "OldCo", subdomain: "oldco", email: "old@oldco.test", password: "my-first-password")
+    recent = create_verified_account(name: "RecentCo", subdomain: "recentco", email: "rec@recentco.test", password: "my-first-password")
+    active = create_verified_account(name: "ActiveCo", subdomain: "activeco", email: "act@activeco.test", password: "my-first-password")
+
+    old_token = sign_in(subdomain: "oldco", email: "old@oldco.test", password: "my-first-password")
+    expired.cancel!(at: 91.days.ago)
+    recent.cancel!(at: 30.days.ago)
+
+    # Owner cannot sign in or reactivate after 90 days
+    post "/api/v1/sessions",
+         params: { session: { email: "old@oldco.test", password: "my-first-password" } },
+         headers: { "X-Helpdesk-Account" => "oldco" },
+         as: :json
+    assert_response :forbidden
+
+    # Even with an old token (none left since cancel! revoked, but also verify window check)
+    session, raw = Session.issue_for!(expired.users.first)
+    assert session.persisted?
+    post "/api/v1/account/reactivate",
+         headers: { "X-Helpdesk-Account" => "oldco", "Authorization" => "Bearer #{raw}" }
+    assert_response :forbidden
+    assert_not_nil old_token
+
+    purged = Account.purge_expired_cancellations!
+    assert_equal 1, purged
+
+    assert_nil Account.find_by(id: expired.id)
+    assert_equal 0, User.where(account_id: expired.id).count
+    assert_equal 0, Session.where(account_id: expired.id).count
+    assert_equal 0, UserToken.joins(:user).where(users: { account_id: expired.id }).count
+
+    assert Account.exists?(recent.id)
+    assert Account.exists?(active.id)
+  end
+end
