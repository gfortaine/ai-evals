new file mode 100644
index 0000000..feefe9a
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,52 @@
+module Api
+  module V1
+    class InvitationAcceptancesController < BaseController
+      skip_before_action :require_authentication!
+
+      def create
+        attrs = params.require(:invitation_acceptance).permit(:token, :name, :password)
+        invitation = Invitation.find_pending(attrs[:token], account: current_account)
+
+        if invitation.nil?
+          return render json: { error: "Invalid or expired invitation token" }, status: :unprocessable_entity
+        end
+
+        user = current_account.users.build(
+          name: attrs[:name],
+          email: invitation.email,
+          password: attrs[:password],
+          role: invitation.role,
+          verified_at: Time.current
+        )
+
+        unless user.valid?
+          return render json: {
+            error: user.errors.full_messages.first,
+            errors: user.errors.to_hash
+          }, status: :unprocessable_entity
+        end
+
+        accepted = false
+        ActiveRecord::Base.transaction do
+          invitation.lock!
+          unless invitation.pending?
+            raise ActiveRecord::Rollback
+          end
+
+          user.save!
+          invitation.update!(accepted_at: Time.current)
+          accepted = true
+        end
+
+        unless accepted
+          return render json: { error: "Invalid or expired invitation token" }, status: :unprocessable_entity
+        end
+
+        render json: {
+          user: serialize_user(user),
+          account: serialize_account(current_account)
+        }, status: :created
+      end
+    end
+  end
+end
