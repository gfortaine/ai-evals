+require "test_helper"
+
+class TicketsMergeTest < ActionDispatch::IntegrationTest
+  setup do
+    @previous_password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"]
+    @previous_domain = ENV["HELPDESK_SUPPORT_DOMAIN"]
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = "test-inbound-secret"
+    ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+
+    @acme = create_verified_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    @jo = @acme.users.find_by!(email: "jo@acme.test")
+    @sam = @acme.users.create!(name: "Sam Agent", email: "sam@acme.test", password: "agent-password-123", role: "agent", verified_at: Time.current)
+    @pat = @acme.users.create!(name: "Pat Agent", email: "pat@acme.test", password: "agent-password-123", role: "agent", verified_at: Time.current)
+    @avery = @acme.users.create!(name: "Avery", email: "avery@example.test", password: "cust-password-123", role: "customer", verified_at: Time.current)
+    @blair = @acme.users.create!(name: "Blair", email: "blair@example.test", password: "cust-password-123", role: "customer", verified_at: Time.current)
+
+    @beta = create_verified_account(name: "Beta", subdomain: "beta", admin_name: "Bo", email: "bo@beta.test", password: "beta-first-password")
+    @casey = @beta.users.create!(name: "Casey", email: "casey@example.test", password: "cust-password-123", role: "customer", verified_at: Time.current)
+
+    @jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    @avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "cust-password-123")
+    @sam_token = sign_in(subdomain: "acme", email: "sam@acme.test", password: "agent-password-123")
+    @avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "cust-password-123")
+    @blair_token = sign_in(subdomain: "acme", email: "blair@example.test", password: "cust-password-123")
+    @bo_token = sign_in(subdomain: "beta", email: "bo@beta.test", password: "beta-first-password")
+    @casey_token = sign_in(subdomain: "beta", email: "casey@example.test", password: "cust-password-123")
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  teardown do
+    if @previous_password.nil?
+      ENV.delete("RAILS_INBOUND_EMAIL_PASSWORD")
+    else
+      ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @previous_password
+    end
+
+    if @previous_domain.nil?
+      ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+    else
+      ENV["HELPDESK_SUPPORT_DOMAIN"] = @previous_domain
+    end
+  end
+
+  test "staff merges duplicate ticket with default private notes, preserves target state and old comments, and both views filter closed" do
+    billing = @acme.groups.create!(name: "Billing")
+    @acme.group_memberships.create!(group: billing, user: @sam, default: true)
+
+    source_id = create_request(token: @avery_token, subject: "Duplicate invoice issue", body: "Source original message", at: "2026-11-10 10:00:00 UTC")
