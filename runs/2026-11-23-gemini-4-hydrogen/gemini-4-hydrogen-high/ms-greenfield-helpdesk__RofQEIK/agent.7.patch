         render json: { ticket: serialize_ticket(ticket) }, status: :ok
       end
+
+      def merge
+        source = current_account.tickets.includes(:requester, :assignee, :group).find(params[:id])
+        merge_params = params.require(:merge)
+
+        has_source_comment = merge_params.key?(:source_comment) && !merge_params[:source_comment].nil?
+        source_comment_attrs = if has_source_comment
+                                 merge_params[:source_comment].is_a?(ActionController::Parameters) ? merge_params[:source_comment] : nil
+                               else
+                                 ActionController::Parameters.new
+                               end
+
+        has_target_comment = merge_params.key?(:target_comment) && !merge_params[:target_comment].nil?
+        target_comment_attrs = if has_target_comment
+                                 merge_params[:target_comment].is_a?(ActionController::Parameters) ? merge_params[:target_comment] : nil
+                               else
+                                 ActionController::Parameters.new
+                               end
+
+        if has_source_comment && source_comment_attrs.nil?
+          return render json: {
+            error: "Source comment is invalid",
+            errors: { source_comment: [ "is invalid" ] }
+          }, status: :unprocessable_entity
+        end
+
+        if has_target_comment && target_comment_attrs.nil?
+          return render json: {
+            error: "Target comment is invalid",
+            errors: { target_comment: [ "is invalid" ] }
+          }, status: :unprocessable_entity
+        end
+
+        raw_target_id = merge_params[:target_id].to_s.strip
+        target = nil
+        validation_errors = nil
+
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          source.reload
+          target = if raw_target_id.match?(/\A\d+\z/)
+                     current_account.tickets.includes(:requester, :assignee, :group).find_by(id: raw_target_id.to_i)
+                   end
+
+          errors = {}
+          if source.closed?
+            errors[:status] = [ "cannot merge a closed ticket" ]
+          end
+
+          if target.nil?
+            errors[:target_id] = [ "must exist" ]
+          elsif target.id == source.id
+            errors[:target_id] = [ "cannot be the same as the source ticket" ]
+          elsif target.closed?
+            errors[:target_id] = [ "cannot merge into a closed ticket" ]
+          elsif target.requester_id != source.requester_id
+            errors[:target_id] = [ "must belong to the same customer" ]
+          end
+
+          if errors.any?
+            validation_errors = {
+              error: errors.values.flatten.first,
+              errors: errors
+            }
+            raise ActiveRecord::Rollback
+          end
+
+          source_body = if source_comment_attrs.key?(:body)
+                          source_comment_attrs[:body]
+                        else
+                          "Merged into ticket ##{target.id}."
+                        end
+          source_public = if source_comment_attrs.key?(:public) && !source_comment_attrs[:public].nil?
+                            ActiveModel::Type::Boolean.new.cast(source_comment_attrs[:public])
+                          else
+                            false
+                          end
+
+          target_body = if target_comment_attrs.key?(:body)
+                          target_comment_attrs[:body]
+                        else
+                          "Ticket ##{source.id} was merged into this ticket."
+                        end
+          target_public = if target_comment_attrs.key?(:public) && !target_comment_attrs[:public].nil?
+                            ActiveModel::Type::Boolean.new.cast(target_comment_attrs[:public])
+                          else
+                            false
+                          end
+
+          source_comment = source.comments.build(
+            author: current_user,
+            body: source_body,
+            public: source_public
+          )
+          target_comment = target.comments.build(
+            author: current_user,
+            body: target_body,
+            public: target_public
+          )
+
+          source_valid = source_comment.valid?
+          target_valid = target_comment.valid?
+
+          unless source_valid && target_valid
+            comment_errors = {}
+            source_comment.errors.to_hash.each { |k, v| comment_errors[:"source_comment_#{k}"] = v }
+            target_comment.errors.to_hash.each { |k, v| comment_errors[:"target_comment_#{k}"] = v }
+            validation_errors = {
+              error: comment_errors.values.flatten.first || "Validation failed",
+              errors: comment_errors
+            }
+            raise ActiveRecord::Rollback
+          end
+
+          source_comment.save!
+          source.update!(status: "closed", merged_into: target)
+          target_comment.save!
+        end
+
+        if validation_errors
+          return render json: validation_errors, status: :unprocessable_entity
+        end
+
+        source.reload
+        target.reload
+
+        render json: {
+          source: serialize_ticket(source),
+          target: serialize_ticket(target)
+        }, status: :ok
+      end
     end
   end
 end
