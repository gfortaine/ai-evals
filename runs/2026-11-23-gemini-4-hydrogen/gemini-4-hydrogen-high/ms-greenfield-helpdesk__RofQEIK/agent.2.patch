diff --git a/app/controllers/api/v1/registrations_controller.rb b/app/controllers/api/v1/registrations_controller.rb
new file mode 100644
index 0000000..45fdf41
--- /dev/null
+++ b/app/controllers/api/v1/registrations_controller.rb
@@ -0,0 +1,35 @@
+module Api
+  module V1
+    class RegistrationsController < BaseController
+      skip_before_action :require_authentication!
+
+      def create
+        attrs = params.require(:user).permit(:name, :email, :password)
+
+        user = current_account.users.build(
+          name: attrs[:name],
+          email: attrs[:email],
+          password: attrs[:password],
+          role: "customer"
+        )
+
+        unless user.valid?
+          return render json: {
+            error: user.errors.full_messages.first,
+            errors: user.errors.to_hash
+          }, status: :unprocessable_entity
+        end
+
+        verification_token = nil
+        ActiveRecord::Base.transaction do
+          user.save!
+          verification_token = user.issue_email_verification_token!
+        end
+
+        UserMailer.email_verification(user, verification_token).deliver_now
+
+        render json: { user: serialize_user(user) }, status: :created
+      end
+    end
+  end
+end
