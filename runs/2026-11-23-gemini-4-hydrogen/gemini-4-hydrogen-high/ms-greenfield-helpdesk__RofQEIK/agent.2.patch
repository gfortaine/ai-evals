+  test "purging expired cancelled account also removes tickets and comments" do
+    post "/api/v1/requests",
+         params: { request: { subject: "Cleanup test", comment: { body: "Will be purged" } } },
+         headers: auth_headers("acme", @avery_token),
+         as: :json
+    assert_response :created
+    ticket_id = json_body.dig("request", "id")
+
+    @acme.cancel!(at: 91.days.ago)
+    Account.purge_expired_cancellations!
+
+    assert_nil Account.find_by(id: @acme.id)
+    assert_equal 0, Ticket.where(id: ticket_id).count
+    assert_equal 0, Comment.where(ticket_id: ticket_id).count
+  end
