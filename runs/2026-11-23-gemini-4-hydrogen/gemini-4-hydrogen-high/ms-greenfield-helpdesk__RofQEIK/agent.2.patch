+  test "staff and customer reply status rules and public vs private comments" do
+    post "/api/v1/requests",
+         params: { request: { subject: "Receipt issue", comment: { body: "Initial message" } } },
+         headers: auth_headers("acme", @avery_token),
+         as: :json
+    assert_response :created
+    ticket_id = json_body.dig("request", "id")
+
+    ActionMailer::Base.deliveries.clear
+
+    # Posting a staff reply by itself does NOT change status (open -> open)
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { comment: { body: "Looking into it now." } } },
+          headers: auth_headers("acme", @agent_token),
+          as: :json
+    assert_response :ok
+    assert_equal "open", json_body.dig("ticket", "status")
+
+    # Owner answers and marks ticket pending
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { comment: { body: "Please try again now." }, status: "pending" } },
+          headers: auth_headers("acme", @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal "pending", json_body.dig("ticket", "status")
+
+    # Staff reply on pending without status leaves it pending
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { comment: { body: "Checking billing logs", public: false } } },
+          headers: auth_headers("acme", @agent_token),
+          as: :json
+    assert_response :ok
+    assert_equal "pending", json_body.dig("ticket", "status")
+
+    # Staff sees private comment, customer does NOT
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: auth_headers("acme", @agent_token)
+    assert_response :ok
+    assert_equal 4, json_body["count"]
+    assert_equal [ true, true, true, false ], json_body["comments"].map { |c| c["public"] }
+    assert_equal [ "Initial message", "Looking into it now.", "Please try again now.", "Checking billing logs" ],
+                 json_body["comments"].map { |c| c["body"] }
+
+    get "/api/v1/requests/#{ticket_id}/comments", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    assert_equal 3, json_body["count"]
+    assert_equal [ "Initial message", "Looking into it now.", "Please try again now." ],
+                 json_body["comments"].map { |c| c["body"] }
+
+    # Customer cannot mark request pending
+    patch "/api/v1/requests/#{ticket_id}",
+          params: { request: { status: "pending" } },
+          headers: auth_headers("acme", @avery_token),
+          as: :json
+    assert_response :unprocessable_entity
+
+    # Customer reply reopens pending request
+    patch "/api/v1/requests/#{ticket_id}",
+          params: { request: { comment: { body: "Still broken!" } } },
+          headers: auth_headers("acme", @avery_token),
+          as: :json
+    assert_response :ok
+    assert_equal "open", json_body.dig("request", "status")
+
+    # Staff marks solved
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { status: "solved" } },
+          headers: auth_headers("acme", @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("ticket", "status")
+
+    # Staff reply on solved without status leaves it solved
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { comment: { body: "Closing notes" } } },
+          headers: auth_headers("acme", @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("ticket", "status")
+
+    # Customer reply reopens solved request
+    patch "/api/v1/requests/#{ticket_id}",
+          params: { request: { comment: { body: "Wait, one more thing" } } },
+          headers: auth_headers("acme", @avery_token),
+          as: :json
+    assert_response :ok
+    assert_equal "open", json_body.dig("request", "status")
+
+    # Customer marks solved, then replies while marking solved in the same update -> stays solved
+    patch "/api/v1/requests/#{ticket_id}",
+          params: { request: { status: "solved" } },
+          headers: auth_headers("acme", @avery_token),
+          as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("request", "status")
+
+    patch "/api/v1/requests/#{ticket_id}",
+          params: { request: { comment: { body: "All good now, thanks!" }, status: "solved" } },
+          headers: auth_headers("acme", @avery_token),
+          as: :json
+    assert_response :ok
+    assert_equal "solved", json_body.dig("request", "status")
+
+    # Atomic rollback: invalid comment does not change status; invalid status does not save comment
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { comment: { body: "" }, status: "open" } },
+          headers: auth_headers("acme", @owner_token),
+          as: :json
+    assert_response :unprocessable_entity
+    assert_equal "solved", Ticket.find(ticket_id).status
+
+    comments_before = Comment.where(ticket_id: ticket_id).count
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { comment: { body: "Should not persist" }, status: "bogus" } },
+          headers: auth_headers("acme", @owner_token),
+          as: :json
+    assert_response :unprocessable_entity
+    assert_equal comments_before, Comment.where(ticket_id: ticket_id).count
+
+    # Portal-only: no emails sent for any replies
+    assert_equal 0, ActionMailer::Base.deliveries.size
+  end
+
+  test "ordering and pagination for requests, tickets, and comments" do
+    # Create 3 requests at staggered times
+    t1 = t2 = t3 = nil
+    travel_to Time.zone.parse("2026-11-10 10:00:00 UTC") do
+      post "/api/v1/requests",
+           params: { request: { subject: "First", comment: { body: "C1" } } },
+           headers: auth_headers("acme", @avery_token),
+           as: :json
+      assert_response :created
+      t1 = json_body.dig("request", "id")
+    end
+
+    travel_to Time.zone.parse("2026-11-10 10:01:00 UTC") do
+      post "/api/v1/requests",
+           params: { request: { subject: "Second", comment: { body: "C1" } } },
+           headers: auth_headers("acme", @avery_token),
+           as: :json
+      assert_response :created
+      t2 = json_body.dig("request", "id")
+    end
+
+    travel_to Time.zone.parse("2026-11-10 10:02:00 UTC") do
+      post "/api/v1/requests",
+           params: { request: { subject: "Third", comment: { body: "C1" } } },
+           headers: auth_headers("acme", @blair_token),
+           as: :json
+      assert_response :created
+      t3 = json_body.dig("request", "id")
+    end
+
+    # Staff reply on First (without changing status) makes First most recently active
+    travel_to Time.zone.parse("2026-11-10 10:05:00 UTC") do
+      patch "/api/v1/tickets/#{t1}",
+            params: { ticket: { comment: { body: "Reply on first" } } },
+            headers: auth_headers("acme", @agent_token),
+            as: :json
+      assert_response :ok
+    end
+
+    # Staff sees [t1, t3, t2] with default pagination
+    get "/api/v1/tickets", headers: auth_headers("acme", @owner_token)
+    assert_response :ok
+    assert_equal [ t1, t3, t2 ], json_body["tickets"].map { |t| t["id"] }
+    assert_equal 3, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_nil json_body["next_page"]
+    assert_nil json_body["previous_page"]
+
+    # Avery sees [t1, t2]
+    get "/api/v1/requests", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    assert_equal [ t1, t2 ], json_body["requests"].map { |r| r["id"] }
+
+    # Paginate tickets with per_page=1
+    get "/api/v1/tickets?page=1&per_page=1", headers: auth_headers("acme", @owner_token)
+    assert_response :ok
+    assert_equal [ t1 ], json_body["tickets"].map { |t| t["id"] }
+    assert_equal 3, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 1, json_body["per_page"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+
+    get "/api/v1/tickets?page=2&per_page=1", headers: auth_headers("acme", @owner_token)
+    assert_response :ok
+    assert_equal [ t3 ], json_body["tickets"].map { |t| t["id"] }
+    assert_equal 3, json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+
+    get "/api/v1/tickets?page=3&per_page=1", headers: auth_headers("acme", @owner_token)
+    assert_response :ok
+    assert_equal [ t2 ], json_body["tickets"].map { |t| t["id"] }
+    assert_nil json_body["next_page"]
+    assert_equal 2, json_body["previous_page"]
+
+    # Comments oldest first & paginated
+    travel_to Time.zone.parse("2026-11-10 10:06:00 UTC") do
+      patch "/api/v1/requests/#{t1}",
+            params: { request: { comment: { body: "Customer follow-up" } } },
+            headers: auth_headers("acme", @avery_token),
+            as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests/#{t1}/comments?page=1&per_page=2", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    assert_equal [ "C1", "Reply on first" ], json_body["comments"].map { |c| c["body"] }
+    assert_equal 3, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 2, json_body["per_page"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+
+    get "/api/v1/requests/#{t1}/comments?page=2&per_page=2", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    assert_equal [ "Customer follow-up" ], json_body["comments"].map { |c| c["body"] }
+    assert_nil json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+  end
