diff --git a/test/integration/customer_registration_test.rb b/test/integration/customer_registration_test.rb
new file mode 100644
index 0000000..e112262
--- /dev/null
+++ b/test/integration/customer_registration_test.rb
@@ -0,0 +1,150 @@
+require "test_helper"
+
+class CustomerRegistrationTest < ActionDispatch::IntegrationTest
+  test "customer registration, verification, login, profile, password management, and recovery" do
+    create_verified_account(name: "Acme", subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    ActionMailer::Base.deliveries.clear
+
+    # Missing tenant header -> 400
+    post "/api/v1/registrations",
+         params: { user: { name: "Avery", email: "avery@example.test", password: "my-customer-password" } },
+         as: :json
+    assert_response :bad_request
+
+    # Invalid payload -> 422
+    post "/api/v1/registrations",
+         params: { user: { name: "", email: "bad-email", password: "short" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+    assert json_body["errors"].present?
+
+    # Valid customer registration -> 201, always role=customer even if role param passed
+    post "/api/v1/registrations",
+         params: {
+           user: {
+             name: "Avery",
+             email: "avery@example.test",
+             password: "my-customer-password",
+             role: "admin"
+           }
+         },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :created
+    assert_equal "Avery", json_body.dig("user", "name")
+    assert_equal "avery@example.test", json_body.dig("user", "email")
+    assert_equal "customer", json_body.dig("user", "role")
+    assert_equal false, json_body.dig("user", "verified")
+    assert_nil json_body.dig("user", "password_digest")
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    token1 = extract_token_from_email(ActionMailer::Base.deliveries.last)
+
+    # Duplicate email on same account -> 422
+    post "/api/v1/registrations",
+         params: { user: { name: "Avery 2", email: "AVERY@example.test", password: "my-customer-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    # Unverified customer cannot sign in
+    post "/api/v1/sessions",
+         params: { session: { email: "avery@example.test", password: "my-customer-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :forbidden
+
+    # Resend verification replaces old token
+    post "/api/v1/email_verifications",
+         params: { email_verification: { email: "avery@example.test" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :ok
+    token2 = extract_token_from_email(ActionMailer::Base.deliveries.last)
+    assert_not_equal token1, token2
+
+    # Confirm verification
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: token2 } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "verified")
+
+    # Sign in
+    customer_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")
+
+    # Profile view and update (role cannot be escalated)
+    get "/api/v1/me",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{customer_token}" }
+    assert_response :ok
+    assert_equal "Avery", json_body.dig("user", "name")
+    assert_equal "customer", json_body.dig("user", "role")
+
+    patch "/api/v1/me",
+          params: { user: { name: "Avery Chen", role: "admin" } },
+          headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{customer_token}" },
+          as: :json
+    assert_response :ok
+    assert_equal "Avery Chen", json_body.dig("user", "name")
+    assert_equal "customer", json_body.dig("user", "role")
+
+    # Change password
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-customer-password", password: "updated-customer-password" } },
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{customer_token}" },
+        as: :json
+    assert_response :ok
+
+    # Password reset recovery flow
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "avery@example.test" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :ok
+    reset_token = extract_token_from_email(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: reset_token, password: "recovered-customer-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :ok
+
+    new_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "recovered-customer-password")
+
+    # Sign out
+    delete "/api/v1/session",
+           headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{new_token}" }
+    assert_response :no_content
+
+    get "/api/v1/me",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{new_token}" }
+    assert_response :unauthorized
+  end
+
+  test "same customer email can register on different businesses and cancelled business blocks registration" do
+    create_verified_account(name: "Acme", subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    beta = create_verified_account(name: "Beta", subdomain: "beta", email: "bo@beta.test", password: "my-first-password")
+
+    post "/api/v1/registrations",
+         params: { user: { name: "Avery", email: "avery@example.test", password: "my-customer-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :created
+
+    post "/api/v1/registrations",
+         params: { user: { name: "Avery Beta", email: "avery@example.test", password: "my-customer-password" } },
+         headers: { "X-Helpdesk-Account" => "beta" },
+         as: :json
+    assert_response :created
+
+    beta.cancel!
+    post "/api/v1/registrations",
+         params: { user: { name: "New", email: "new@example.test", password: "my-customer-password" } },
+         headers: { "X-Helpdesk-Account" => "beta" },
+         as: :json
+    assert_response :forbidden
+  end
+end
diff --git a/test/integration/requests_and_tickets_test.rb b/test/integration/requests_and_tickets_test.rb
new file mode 100644
index 0000000..5324316
--- /dev/null
+++ b/test/integration/requests_and_tickets_test.rb
@@ -0,0 +1,412 @@
+require "test_helper"
+
+class RequestsAndTicketsTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme = create_verified_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    @agent = @acme.users.create!(
+      name: "Sam Agent",
+      email: "sam@acme.test",
+      password: "agent-password-123",
+      role: "agent",
+      verified_at: Time.current
+    )
+    @avery = register_and_verify_customer(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    @blair = register_and_verify_customer(subdomain: "acme", name: "Blair", email: "blair@example.test", password: "my-customer-password")
+
+    @beta = create_verified_account(name: "Beta", subdomain: "beta", admin_name: "Bo", email: "bo@beta.test", password: "my-first-password")
+    @beta_customer = register_and_verify_customer(subdomain: "beta", name: "Casey", email: "casey@example.test", password: "my-customer-password")
+
+    @owner_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    @agent_token = sign_in(subdomain: "acme", email: "sam@acme.test", password: "agent-password-123")
+    @avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")
+    @blair_token = sign_in(subdomain: "acme", email: "blair@example.test", password: "my-customer-password")
+    @beta_owner_token = sign_in(subdomain: "beta", email: "bo@beta.test", password: "my-first-password")
+    @beta_customer_token = sign_in(subdomain: "beta", email: "casey@example.test", password: "my-customer-password")
+  end
+
+  test "customer opens request, views request and comments, and cannot access staff routes or other customers" do
+    ActionMailer::Base.deliveries.clear
+
+    # Unauthenticated rejected
+    post "/api/v1/requests",
+         params: { request: { subject: "Help", comment: { body: "Details" } } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unauthorized
+
+    # Validation errors on create
+    post "/api/v1/requests",
+         params: { request: { subject: "", comment: { body: "" } } },
+         headers: auth_headers("acme", @avery_token),
+         as: :json
+    assert_response :unprocessable_entity
+    assert json_body["errors"].present?
+
+    # Open a request (status forced to open even if status param passed)
+    post "/api/v1/requests",
+         params: {
+           request: {
+             subject: "Cannot download my receipt",
+             status: "solved",
+             comment: { body: "The download button does nothing.", public: false }
+           }
+         },
+         headers: auth_headers("acme", @avery_token),
+         as: :json
+    assert_response :created
+    req = json_body["request"]
+    assert_not_nil req["id"]
+    assert_equal "Cannot download my receipt", req["subject"]
+    assert_equal "open", req["status"]
+    assert_equal @avery.id, req["requester_id"]
+    assert_not_nil req["created_at"]
+    assert_not_nil req["updated_at"]
+    assert_nil req["requester"]
+
+    # Portal-only: no email sent
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    ticket_id = req["id"]
+
+    # Customer lists own requests
+    get "/api/v1/requests", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    assert_equal 1, json_body["requests"].size
+    assert_equal ticket_id, json_body["requests"].first["id"]
+    assert_equal 1, json_body["count"]
+
+    # Other customer cannot see it in list, show, update, or comments
+    get "/api/v1/requests", headers: auth_headers("acme", @blair_token)
+    assert_response :ok
+    assert_equal [], json_body["requests"]
+    assert_equal 0, json_body["count"]
+
+    get "/api/v1/requests/#{ticket_id}", headers: auth_headers("acme", @blair_token)
+    assert_response :not_found
+
+    patch "/api/v1/requests/#{ticket_id}",
+          params: { request: { comment: { body: "Snooping" } } },
+          headers: auth_headers("acme", @blair_token),
+          as: :json
+    assert_response :not_found
+
+    get "/api/v1/requests/#{ticket_id}/comments", headers: auth_headers("acme", @blair_token)
+    assert_response :not_found
+
+    # Customer cannot access /tickets routes
+    get "/api/v1/tickets", headers: auth_headers("acme", @avery_token)
+    assert_response :forbidden
+    get "/api/v1/tickets/#{ticket_id}", headers: auth_headers("acme", @avery_token)
+    assert_response :forbidden
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { status: "solved" } },
+          headers: auth_headers("acme", @avery_token),
+          as: :json
+    assert_response :forbidden
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: auth_headers("acme", @avery_token)
+    assert_response :forbidden
+
+    # Customer reads own request and its comments
+    get "/api/v1/requests/#{ticket_id}", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    assert_equal ticket_id, json_body.dig("request", "id")
+
+    get "/api/v1/requests/#{ticket_id}/comments", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    assert_equal 1, json_body["comments"].size
+    comment = json_body["comments"].first
+    assert_equal "The download button does nothing.", comment["body"]
+    assert_equal true, comment["public"]
+    assert_equal({ "id" => @avery.id, "name" => "Avery" }, comment["author"])
+    assert_not_nil comment["created_at"]
+
+    # Staff sees ticket with requester object
+    get "/api/v1/tickets", headers: auth_headers("acme", @agent_token)
+    assert_response :ok
+    assert_equal 1, json_body["tickets"].size
+    ticket = json_body["tickets"].first
+    assert_equal ticket_id, ticket["id"]
+    assert_equal(
+      { "id" => @avery.id, "name" => "Avery", "email" => "avery@example.test" },
+      ticket["requester"]
+    )
+
+    get "/api/v1/tickets/#{ticket_id}", headers: auth_headers("acme", @owner_token)
+    assert_response :ok
+    assert_equal(
+      { "id" => @avery.id, "name" => "Avery", "email" => "avery@example.test" },
+      json_body.dig("ticket", "requester")
+    )
+
+    # Tenant isolation: Beta staff cannot access Acme ticket
+    get "/api/v1/tickets/#{ticket_id}", headers: auth_headers("beta", @beta_owner_token)
+    assert_response :not_found
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: auth_headers("beta", @beta_owner_token)
+    assert_response :not_found
