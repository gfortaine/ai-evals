+require "test_helper"
+
+class TicketsPriorityAndFilteringTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme = create_verified_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    @jo = @acme.users.find_by!(email: "jo@acme.test")
+    @sam = @acme.users.create!(name: "Sam Agent", email: "sam@acme.test", password: "agent-password-123", role: "agent", verified_at: Time.current)
+    @avery = @acme.users.create!(name: "Avery", email: "avery@example.test", password: "cust-password-123", role: "customer", verified_at: Time.current)
+    @blair = @acme.users.create!(name: "Blair", email: "blair@example.test", password: "cust-password-123", role: "customer", verified_at: Time.current)
+
+    @beta = create_verified_account(name: "Beta", subdomain: "beta", admin_name: "Bo", email: "bo@beta.test", password: "beta-first-password")
+    @bo = @beta.users.find_by!(email: "bo@beta.test")
+    @casey = @beta.users.create!(name: "Casey", email: "casey@example.test", password: "cust-password-123", role: "customer", verified_at: Time.current)
+
+    @jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    @sam_token = sign_in(subdomain: "acme", email: "sam@acme.test", password: "agent-password-123")
+    @avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "cust-password-123")
+    @blair_token = sign_in(subdomain: "acme", email: "blair@example.test", password: "cust-password-123")
+    @casey_token = sign_in(subdomain: "beta", email: "casey@example.test", password: "cust-password-123")
+  end
+
+  test "priority defaults to normal, staff can update it, and priority remains internal to staff" do
+    initial_request = nil
+    travel_to Time.zone.parse("2026-11-10 10:00:00 UTC") do
+      post "/api/v1/requests",
+           params: {
+             request: {
+               subject: "Billing question",
+               priority: "high",
+               comment: { body: "Please check my bill" }
+             }
+           },
+           headers: auth_headers("acme", @avery_token),
+           as: :json
+      assert_response :created
+      initial_request = json_body["request"]
+      assert_not initial_request.key?("priority")
+    end
+
+    ticket_id = initial_request["id"]
+    second_id = create_ticket(token: @avery_token, subject: "Second request", body: "Second body", at: "2026-11-10 10:01:00 UTC")
+
+    # Default priority is normal in staff show and index
+    get "/api/v1/tickets/#{ticket_id}", headers: auth_headers("acme", @sam_token)
+    assert_response :ok
+    assert_equal "normal", json_body.dig("ticket", "priority")
+
+    get "/api/v1/tickets", headers: auth_headers("acme", @sam_token)
+    assert_response :ok
+    assert_equal "normal", json_body["tickets"].first["priority"]
+
+    # Customer cannot change priority on request update, and never sees priority
+    patch "/api/v1/requests/#{ticket_id}",
+          params: { request: { priority: "high", comment: { body: "Following up" } } },
+          headers: auth_headers("acme", @avery_token),
+          as: :json
+    assert_response :ok
+    assert_not json_body["request"].key?("priority")
+    assert_equal "normal", Ticket.find(ticket_id).priority
+
+    # Capture customer-facing state before staff sets priority to high
+    get "/api/v1/requests/#{ticket_id}", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    before_customer_view = json_body["request"]
+
+    get "/api/v1/requests", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    before_customer_order = json_body["requests"].map { |r| r["id"] }
+
+    # Staff marks ticket high priority
+    travel_to Time.zone.parse("2026-11-10 10:05:00 UTC") do
+      patch "/api/v1/tickets/#{ticket_id}",
+            params: { ticket: { priority: "high" } },
+            headers: auth_headers("acme", @sam_token),
+            as: :json
+      assert_response :ok
+      assert_equal "high", json_body.dig("ticket", "priority")
+    end
+
+    # Customer-facing request and ordering are completely unchanged (no priority field, updated_at unchanged)
+    get "/api/v1/requests/#{ticket_id}", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    assert_equal before_customer_view, json_body["request"]
+    assert_not json_body["request"].key?("priority")
+
+    get "/api/v1/requests", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    assert_equal before_customer_order, json_body["requests"].map { |r| r["id"] }
+
+    # Empty string priority is rejected with 422
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { priority: "" } },
+          headers: auth_headers("acme", @jo_token),
+          as: :json
+    assert_response :unprocessable_entity
+    assert json_body["errors"]["priority"].present?
+
+    # Invalid priority rejected atomically without saving comment or other fields
+    comments_before = Comment.where(ticket_id: ticket_id).count
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { priority: "urgent", status: "pending", comment: { body: "Should not persist" } } },
+          headers: auth_headers("acme", @jo_token),
+          as: :json
+    assert_response :unprocessable_entity
+    assert json_body["errors"]["priority"].present?
+    ticket = Ticket.find(ticket_id)
+    assert_equal "high", ticket.priority
+    assert_equal "open", ticket.status
+    assert_equal comments_before, Comment.where(ticket_id: ticket_id).count
+
+    # Staff can set priority back to normal along with other fields
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { priority: "normal", status: "pending" } },
+          headers: auth_headers("acme", @jo_token),
+          as: :json
+    assert_response :ok
+    assert_equal "normal", json_body.dig("ticket", "priority")
+    assert_equal "pending", json_body.dig("ticket", "status")
+    assert_not_nil second_id
+  end
+
+  test "staff filters tickets by status, assignee_id, requester_id, priority, and literal q" do
+    t1 = create_ticket(token: @avery_token, subject: "Cannot download my RECEIPT", body: "Initial receipt body", at: "2026-11-10 10:00:00 UTC")
+    t2 = create_ticket(token: @avery_token, subject: "Login issue", body: "Need help with password", at: "2026-11-10 10:01:00 UTC")
+    t3 = create_ticket(token: @blair_token, subject: "Refund 100% needed", body: "Looking for receipt_2026 and path C:\\temp\\file", at: "2026-11-10 10:02:00 UTC")
+    t4 = create_ticket(token: @blair_token, subject: "Refund 1000 needed", body: "Looking for receiptX2026 and path C:tempfile", at: "2026-11-10 10:03:00 UTC")
+    t5 = create_ticket(token: @avery_token, subject: "Secret internal check", body: "Nothing special publicly", at: "2026-11-10 10:04:00 UTC")
+
+    # Cross-tenant ticket with matching attributes should never appear in Acme
+    beta_t = create_ticket(token: @casey_token, subdomain: "beta", subject: "Missing receipt", body: "Beta receipt", at: "2026-11-10 10:05:00 UTC")
+    Ticket.find(beta_t).update!(priority: "high")
+
+    # Configure Acme tickets
+    # t1: open, unassigned, high, subject has RECEIPT
+    patch "/api/v1/tickets/#{t1}",
+          params: { ticket: { priority: "high" } },
+          headers: auth_headers("acme", @jo_token),
+          as: :json
+    assert_response :ok
+
+    # t2: pending, assigned to Sam, high, public comment mentions "receipt" twice
+    patch "/api/v1/tickets/#{t2}",
+          params: { ticket: { status: "pending", assignee_id: @sam.id, priority: "high", comment: { body: "Attached your RECEIPT copy", public: true } } },
+          headers: auth_headers("acme", @sam_token),
+          as: :json
+    assert_response :ok
+    patch "/api/v1/tickets/#{t2}",
+          params: { ticket: { comment: { body: "Another receipt note", public: true } } },
+          headers: auth_headers("acme", @sam_token),
+          as: :json
+    assert_response :ok
+
+    # t3: open, assigned to Jo, normal, subject has "100%", public comment has "receipt_2026" and "C:\temp\file"
+    patch "/api/v1/tickets/#{t3}",
+          params: { ticket: { assignee_id: @jo.id } },
+          headers: auth_headers("acme", @jo_token),
+          as: :json
+    assert_response :ok
+
+    # t4: solved, unassigned, high
+    patch "/api/v1/tickets/#{t4}",
+          params: { ticket: { status: "solved", priority: "high" } },
+          headers: auth_headers("acme", @jo_token),
+          as: :json
+    assert_response :ok
+
+    # t5: open, unassigned, high, ONLY private comment mentions "receipt"
+    patch "/api/v1/tickets/#{t5}",
+          params: { ticket: { priority: "high", comment: { body: "Private receipt audit", public: false } } },
+          headers: auth_headers("acme", @jo_token),
+          as: :json
+    assert_response :ok
+
+    # Filter by status
+    get "/api/v1/tickets?status=open", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [ t5, t3, t1 ].sort, json_body["tickets"].map { |t| t["id"] }.sort
+
+    # Filter by priority
+    get "/api/v1/tickets?priority=normal", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [ t3 ], json_body["tickets"].map { |t| t["id"] }
+
+    # Filter by assignee_id=unassigned
+    get "/api/v1/tickets?assignee_id=unassigned", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [ t5, t4, t1 ].sort, json_body["tickets"].map { |t| t["id"] }.sort
+
+    # Filter by specific assignee_id
+    get "/api/v1/tickets?assignee_id=#{@sam.id}", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [ t2 ], json_body["tickets"].map { |t| t["id"] }
+
+    # Filter by requester_id
+    get "/api/v1/tickets?requester_id=#{@blair.id}", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [ t4, t3 ].sort, json_body["tickets"].map { |t| t["id"] }.sort
+
+    # Search q: case-insensitive across subjects and public comments, NOT private comments, no duplicates
+    get "/api/v1/tickets?q=receipt", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    matched_ids = json_body["tickets"].map { |t| t["id"] }
+    assert_equal [ t4, t3, t2, t1 ].sort, matched_ids.sort
+    assert_equal 4, json_body["count"]
+    assert_not_includes matched_ids, t5
+    assert_not_includes matched_ids, beta_t
+
+    # Combined filters (exact example from requirements)
+    get "/api/v1/tickets?status=open&assignee_id=unassigned&priority=high&q=receipt", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [ t1 ], json_body["tickets"].map { |t| t["id"] }
+    assert_equal 1, json_body["count"]
+
+    # Combined filters including requester_id and pagination
+    get "/api/v1/tickets?priority=high&requester_id=#{@avery.id}&per_page=1&page=1", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal 3, json_body["count"]
+    assert_equal 2, json_body["next_page"]
+
+    # Literal text search for LIKE/ILIKE special characters: %, _, \
+    get "/api/v1/tickets", params: { q: "100%" }, headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [ t3 ], json_body["tickets"].map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { q: "receipt_2026" }, headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [ t3 ], json_body["tickets"].map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { q: 'C:\temp\file' }, headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [ t3 ], json_body["tickets"].map { |t| t["id"] }
+
+    # Regex metacharacters and SQL-like strings are treated as literal text
+    get "/api/v1/tickets", params: { q: "100." }, headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+
+    get "/api/v1/tickets", params: { q: "' OR 1=1 --" }, headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+
+    # Non-numeric / invalid filter values return empty cleanly (200)
+    get "/api/v1/tickets?assignee_id=notanumber", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+
+    get "/api/v1/tickets?requester_id=unassigned", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+
+    get "/api/v1/tickets?status=bogus", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+
+    get "/api/v1/tickets?priority=urgent", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+
+    # Cross-account person IDs return empty
+    get "/api/v1/tickets?assignee_id=#{@bo.id}", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+
+    get "/api/v1/tickets?requester_id=#{@casey.id}", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [], json_body["tickets"]
+
+    # Blank q does not filter out tickets
+    get "/api/v1/tickets?q=", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal 5, json_body["count"]
+  end
+
+  test "customers can filter own requests by status and cannot filter or infer priority" do
+    r1 = create_ticket(token: @avery_token, subject: "Open req 1", body: "Body 1", at: "2026-11-10 10:00:00 UTC")
+    r2 = create_ticket(token: @avery_token, subject: "Pending req", body: "Body 2", at: "2026-11-10 10:01:00 UTC")
+    r3 = create_ticket(token: @avery_token, subject: "Solved req", body: "Body 3", at: "2026-11-10 10:02:00 UTC")
+    r_blair = create_ticket(token: @blair_token, subject: "Blair open req", body: "Body 4", at: "2026-11-10 10:03:00 UTC")
+
+    patch "/api/v1/tickets/#{r1}", params: { ticket: { priority: "high" } }, headers: auth_headers("acme", @jo_token), as: :json
+    assert_response :ok
+    patch "/api/v1/tickets/#{r2}", params: { ticket: { status: "pending" } }, headers: auth_headers("acme", @jo_token), as: :json
+    assert_response :ok
+    patch "/api/v1/tickets/#{r3}", params: { ticket: { status: "solved" } }, headers: auth_headers("acme", @jo_token), as: :json
+    assert_response :ok
+
+    get "/api/v1/requests?status=open", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    assert_equal [ r1 ], json_body["requests"].map { |r| r["id"] }
+    assert_equal 1, json_body["count"]
+    assert_not json_body["requests"].first.key?("priority")
+
+    get "/api/v1/requests?status=pending", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    assert_equal [ r2 ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests?status=solved", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    assert_equal [ r3 ], json_body["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests?status=unknown", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    assert_equal [], json_body["requests"]
+
+    # Priority filter param is ignored on customer requests endpoint (priority is internal)
+    get "/api/v1/requests?priority=high", headers: auth_headers("acme", @avery_token)
+    assert_response :ok
+    assert_equal [ r3, r2, r1 ].sort, json_body["requests"].map { |r| r["id"] }.sort
+    json_body["requests"].each do |req|
+      assert_not req.key?("priority")
+    end
+
+    # Other customer's requests never included
+    assert_not_includes json_body["requests"].map { |r| r["id"] }, r_blair
+  end
+
+  private
+
+  def create_ticket(token:, subject:, body:, at:, subdomain: "acme")
+    travel_to Time.zone.parse(at) do
+      post "/api/v1/requests",
+           params: { request: { subject: subject, comment: { body: body } } },
+           headers: auth_headers(subdomain, token),
+           as: :json
+      assert_response :created
+      json_body.dig("request", "id")
+    end
+  end
+
+  def auth_headers(subdomain, token)
+    {
+      "X-Helpdesk-Account" => subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+end
