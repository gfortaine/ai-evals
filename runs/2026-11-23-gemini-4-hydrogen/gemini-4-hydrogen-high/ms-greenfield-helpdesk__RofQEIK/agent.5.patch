index 0000000..5a5345a
--- /dev/null
+++ b/app/mailers/ticket_mailer.rb
@@ -0,0 +1,18 @@
+class TicketMailer < ApplicationMailer
+  def staff_reply(ticket, comment)
+    @ticket = ticket
+    @comment = comment
+    @account = ticket.account
+    @requester = ticket.requester
+    @author = comment.author
+
+    reply_subject = @ticket.subject.match?(/\ARe:\s*/i) ? @ticket.subject : "Re: #{@ticket.subject}"
+
+    mail(
+      from: email_address_with_name(@account.support_address, @account.name),
+      reply_to: @ticket.reply_address,
+      to: @requester.email,
+      subject: reply_subject
+    )
+  end
+end
