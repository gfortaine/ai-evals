+require "test_helper"
+
+class EmailSupportTest < ActionDispatch::IntegrationTest
+  setup do
+    @previous_password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"]
+    @previous_domain = ENV["HELPDESK_SUPPORT_DOMAIN"]
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = "test-inbound-secret"
+    ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+
+    @acme = create_verified_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    @beta = create_verified_account(name: "Beta", subdomain: "beta", admin_name: "Bo", email: "bo@beta.test", password: "my-first-password")
+    @owner_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    ActionMailer::Base.deliveries.clear
+  end
+
+  teardown do
+    if @previous_password.nil?
+      ENV.delete("RAILS_INBOUND_EMAIL_PASSWORD")
+    else
+      ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @previous_password
+    end
+
+    if @previous_domain.nil?
+      ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+    else
+      ENV["HELPDESK_SUPPORT_DOMAIN"] = @previous_domain
+    end
+  end
+
+  test "relay ingress requires basic auth and message/rfc822 content type" do
+    raw = build_raw_email(
+      from: "Avery <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Auth check",
+      body: "Hello"
+    )
+
+    # Missing credentials -> 401
+    post "/rails/action_mailbox/relay/inbound_emails",
+         params: raw,
+         headers: { "Content-Type" => "message/rfc822" }
+    assert_response :unauthorized
+
+    # Wrong password -> 401
+    post "/rails/action_mailbox/relay/inbound_emails",
+         params: raw,
+         headers: {
+           "Content-Type" => "message/rfc822",
+           "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("actionmailbox", "wrong")
+         }
+    assert_response :unauthorized
+
+    # Wrong content type -> 415
+    post "/rails/action_mailbox/relay/inbound_emails",
+         params: raw,
+         headers: relay_headers.merge("Content-Type" => "text/plain")
+    assert_response :unsupported_media_type
+
+    assert_equal 0, @acme.tickets.count
+  end
+
+  test "incoming email creates ticket with subject and plain-text body, creates unverified customer, sends verification email, and processes synchronously" do
+    raw = build_multipart_email(
+      from: "Avery Customer <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Cannot export CSV",
+      text_body: "Export button fails with 500.",
+      html_body: "<p><strong>Export</strong> button fails with 500.</p>",
+      message_id: "<open-1@example.test>"
+    )
+
+    post_relay(raw)
+    assert_response :no_content
+
+    # Processed before request returns
+    customer = @acme.users.find_by!(email: "avery@example.test")
+    assert_equal "Avery Customer", customer.name
+    assert_equal "customer", customer.role
+    assert_not customer.verified?
+    assert_nil customer.verified_at
+
+    assert_equal 1, @acme.tickets.count
+    ticket = @acme.tickets.first
+    assert_equal "Cannot export CSV", ticket.subject
+    assert_equal "open", ticket.status
+    assert_equal "email", ticket.origin
+    assert_equal customer.id, ticket.requester_id
+
+    assert_equal 1, ticket.comments.count
+    comment = ticket.comments.first
+    assert_equal "Export button fails with 500.", comment.body
+    assert comment.public?
+    assert_equal customer.id, comment.author_id
+
+    # Verification email sent so customer can later use the portal
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    verification_mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "avery@example.test" ], verification_mail.to
+    token = extract_token_from_email(verification_mail)
+
+    # Confirm verification works on portal
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: token } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :ok
+    assert customer.reload.verified?
+  end
+
+  test "reuses existing customer without verifying or resending verification email" do
+    existing = @acme.users.create!(
+      name: "Unverified Existing",
+      email: "existing@example.test",
+      password: "customer-password-123",
+      role: "customer"
+    )
+    assert_not existing.verified?
+
+    raw = build_raw_email(
+      from: "existing@example.test",
+      to: "acme@support.example.test",
+      subject: "Follow up question",
+      body: "Still waiting on invoice.",
+      message_id: "<existing-1@example.test>"
+    )
+
+    post_relay(raw)
+    assert_response :no_content
+
+    assert_equal 0, ActionMailer::Base.deliveries.size
+    assert_not existing.reload.verified?
+    assert_equal 1, @acme.tickets.where(requester_id: existing.id).count
+  end
+
+  test "finds business from Cc, respects HELPDESK_SUPPORT_DOMAIN, and ignores multiple businesses or unknown/cancelled accounts" do
+    # Business in Cc
+    post_relay build_raw_email(
+      from: "cc-user@example.test",
+      to: "colleague@external.test",
+      cc: "Acme Support <acme@support.example.test>",
+      subject: "Via CC",
+      body: "Found via Cc.",
+      message_id: "<cc-1@example.test>"
+    )
+    assert_response :no_content
+    assert_equal 1, @acme.tickets.count
+    assert_equal "Via CC", @acme.tickets.first.subject
+
+    # Multiple businesses (To + Cc) -> ignored
+    post_relay build_raw_email(
+      from: "multi@example.test",
+      to: "acme@support.example.test",
+      cc: "beta@support.example.test",
+      subject: "To both",
+      body: "Should be ignored",
+      message_id: "<multi-1@example.test>"
+    )
+    assert_response :no_content
+    assert_equal 1, @acme.tickets.count
+    assert_equal 0, @beta.tickets.count
+    assert_nil @acme.users.find_by(email: "multi@example.test")
+
+    # Unknown business -> ignored
+    post_relay build_raw_email(
+      from: "unknown-biz@example.test",
+      to: "nobody@support.example.test",
+      subject: "Unknown",
+      body: "Should be ignored",
+      message_id: "<unknown-1@example.test>"
+    )
+    assert_response :no_content
+    assert_equal 0, Ticket.where(subject: "Unknown").count
+
+    # Cancelled business -> ignored
+    @beta.cancel!
+    post_relay build_raw_email(
+      from: "cancelled-biz@example.test",
+      to: "beta@support.example.test",
+      subject: "Cancelled",
+      body: "Should be ignored",
+      message_id: "<cancelled-1@example.test>"
+    )
+    assert_response :no_content
+    assert_equal 0, @beta.tickets.count
+
+    # Custom HELPDESK_SUPPORT_DOMAIN
+    ENV["HELPDESK_SUPPORT_DOMAIN"] = "mail.custom-help.test"
+    ActionMailer::Base.deliveries.clear
+
+    post_relay build_raw_email(
+      from: "custom@example.test",
+      to: "acme@support.example.test",
+      subject: "Old domain",
+      body: "Should be ignored",
+      message_id: "<custom-old@example.test>"
+    )
+    assert_response :no_content
+    assert_equal 1, @acme.tickets.count
+
+    post_relay build_raw_email(
+      from: "custom@example.test",
+      to: "acme@mail.custom-help.test",
+      subject: "Custom domain ticket",
+      body: "Works with custom domain",
+      message_id: "<custom-new@example.test>"
+    )
+    assert_response :no_content
+    assert_equal 2, @acme.tickets.count
+  end
+
+  test "staff public reply emails requester with private reply address, customer replies reopen ticket, and plain support opens new ticket" do
+    # Customer opens email-origin ticket
+    post_relay build_raw_email(
+      from: "Avery <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Broken widget",
+      body: "It does not turn on.",
+      message_id: "<conv-1@example.test>"
+    )
+    assert_response :no_content
+    ticket = @acme.tickets.first
+    requester = ticket.requester
+    assert_not requester.verified?
+    ActionMailer::Base.deliveries.clear
+
+    # Staff posts internal note -> NO email sent
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { comment: { body: "Internal check", public: false }, status: "pending" } },
+          headers: auth_headers("acme", @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal 0, ActionMailer::Base.deliveries.size
+    assert_equal "pending", ticket.reload.status
+
+    # Staff posts public reply -> emails requester with ticket's private reply address
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { comment: { body: "Have you tried plugging it in?", public: true } } },
+          headers: auth_headers("acme", @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    reply_mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "avery@example.test" ], reply_mail.to
+    assert_equal "Re: Broken widget", reply_mail.subject
+    assert_includes reply_mail.text_part.body.decoded, "Have you tried plugging it in?"
+    assert_equal 1, reply_mail.reply_to.size
+    reply_address = reply_mail.reply_to.first
+    assert reply_address.end_with?("@support.example.test")
+    assert_not_equal "acme@support.example.test", reply_address
+
+    # Non-requester cannot reply to private reply address
+    post_relay build_raw_email(
+      from: "Intruder <intruder@example.test>",
+      to: reply_address,
+      subject: "Re: Broken widget",
+      body: "Hijack attempt",
+      message_id: "<hijack-1@example.test>"
+    )
+    assert_response :no_content
+    assert_equal 3, ticket.comments.count
+    assert_equal "pending", ticket.reload.status
+    assert_nil @acme.users.find_by(email: "intruder@example.test")
+
+    # Even staff cannot reply to private reply address on behalf of requester
+    post_relay build_raw_email(
+      from: "Jo <jo@acme.test>",
+      to: reply_address,
+      subject: "Re: Broken widget",
+      body: "Staff via email",
+      message_id: "<staff-hijack@example.test>"
+    )
+    assert_response :no_content
+    assert_equal 3, ticket.comments.count
+
+    # Requester replies to private reply address -> adds comment and reopens pending ticket
+    post_relay build_raw_email(
+      from: "avery@example.test",
+      to: reply_address,
+      subject: "Re: Broken widget",
+      body: "Yes, still broken!",
+      message_id: "<conv-2@example.test>"
+    )
+    assert_response :no_content
+    assert_equal 4, ticket.comments.count
+    assert_equal "Yes, still broken!", ticket.comments.order(:id).last.body
+    assert_equal "open", ticket.reload.status
+    assert_not requester.reload.verified?
+
+    # Staff marks solved, requester replies via Reply-All (private reply + plain support) -> reopens solved ticket
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { status: "solved" } },
+          headers: auth_headers("acme", @owner_token),
+          as: :json
+    assert_response :ok
+    assert_equal "solved", ticket.reload.status
+
+    post_relay build_raw_email(
+      from: "avery@example.test",
+      to: reply_address,
+      cc: "acme@support.example.test",
+      subject: "Re: Broken widget",
+      body: "One more thing, it sparked!",
+      message_id: "<conv-3@example.test>"
+    )
+    assert_response :no_content
+    assert_equal 1, @acme.tickets.count
+    assert_equal 5, ticket.comments.count
+    assert_equal "open", ticket.reload.status
+
+    # Invalid private reply token does not open a new ticket
+    post_relay build_raw_email(
+      from: "avery@example.test",
+      to: "acme+nonexistenttoken123@support.example.test",
+      subject: "Re: Broken widget",
+      body: "Wrong token",
+      message_id: "<bad-token@example.test>"
+    )
+    assert_response :no_content
+    assert_equal 1, @acme.tickets.count
+
+    # New message to plain support address opens a NEW ticket
+    post_relay build_raw_email(
+      from: "avery@example.test",
+      to: "acme@support.example.test",
+      subject: "Separate billing issue",
+      body: "Need a refund.",
+      message_id: "<new-ticket-2@example.test>"
+    )
+    assert_response :no_content
+    assert_equal 2, @acme.tickets.count
+    new_ticket = @acme.tickets.order(:id).last
+    assert_not_equal ticket.id, new_ticket.id
+    assert_not_equal ticket.reply_address, new_ticket.reply_address
+  end
+
+  test "deduplicates by Message-ID and allows valid retry after invalid delivery" do
+    # 1. Exact duplicate and modified-header duplicate with same Message-ID
+    raw1 = build_raw_email(
+      from: "dup@example.test",
+      to: "acme@support.example.test",
+      subject: "First delivery",
+      body: "Hello once",
+      message_id: "<dedup-1@example.test>"
+    )
+    raw1_modified = "X-Relay-Hop: hop2\r\n" + raw1
+
+    post_relay(raw1)
+    assert_response :no_content
+    assert_equal 1, @acme.tickets.count
+    assert_equal 1, ActionMailer::Base.deliveries.size
+
+    # Exact retry
+    post_relay(raw1)
+    assert_response :no_content
+    assert_equal 1, @acme.tickets.count
+    assert_equal 1, ActionMailer::Base.deliveries.size
+
+    # Different raw bytes, same Message-ID
+    post_relay(raw1_modified)
+    assert_response :no_content
+    assert_equal 1, @acme.tickets.count
+    assert_equal 1, ActionMailer::Base.deliveries.size
+
+    # 2. Invalid delivery (blank body) MUST NOT block a later valid retry with same Message-ID
+    invalid_raw = build_raw_email(
+      from: "retry@example.test",
+      to: "acme@support.example.test",
+      subject: "Retry subject",
+      body: "   ",
+      message_id: "<retry-valid@example.test>"
+    )
+    post_relay(invalid_raw)
+    assert_response :no_content
+    assert_equal 1, @acme.tickets.count
+    assert_nil @acme.users.find_by(email: "retry@example.test")
+
+    valid_retry = build_raw_email(
+      from: "retry@example.test",
+      to: "acme@support.example.test",
+      subject: "Retry subject",
+      body: "Actual problem description",
+      message_id: "<retry-valid@example.test>"
+    )
+    post_relay(valid_retry)
+    assert_response :no_content
+    assert_equal 2, @acme.tickets.count
+    assert_equal "Actual problem description", @acme.tickets.order(:id).last.comments.first.body
+
+    # 3. Invalid delivery (exact bytes) retried after account becomes valid
+    exact_retry_raw = build_raw_email(
+      from: "exact-retry@example.test",
+      to: "gamma@support.example.test",
+      subject: "Before gamma exists",
+      body: "Wait for gamma",
+      message_id: "<exact-retry@example.test>"
+    )
+    post_relay(exact_retry_raw)
+    assert_response :no_content
+    assert_nil Account.find_by(subdomain: "gamma")
+
+    gamma = create_verified_account(name: "Gamma", subdomain: "gamma", admin_name: "Ga", email: "ga@gamma.test", password: "my-first-password")
+    post_relay(exact_retry_raw)
+    assert_response :no_content
+    assert_equal 1, gamma.tickets.count
+    assert_equal "Before gamma exists", gamma.tickets.first.subject
+  end
+
+  test "ignores automated and mailing list mail while accepting Auto-Submitted: no" do
+    automated_headers_list = [
+      { "Auto-Submitted" => "auto-replied" },
+      { "Auto-Submitted" => "auto-generated" },
+      { "Precedence" => "bulk" },
+      { "Precedence" => "list" },
+      { "Precedence" => "junk" },
+      { "List-Id" => "<newsletter.example.test>" },
+      { "List-Unsubscribe" => "<mailto:unsub@example.test>" },
+      { "X-Autoreply" => "yes" },
+      { "X-Autorespond" => "yes" },
+      { "Return-Path" => "<>" }
+    ]
+
+    automated_headers_list.each_with_index do |extra_headers, idx|
+      post_relay build_raw_email(
+        from: "auto#{idx}@example.test",
+        to: "acme@support.example.test",
+        subject: "Automated #{idx}",
+        body: "Out of office",
+        message_id: "<auto-#{idx}@example.test>",
+        extra_headers: extra_headers
+      )
+      assert_response :no_content
+    end
+
+    # Automated sender local part
+    post_relay build_raw_email(
+      from: "MAILER-DAEMON@example.test",
+      to: "acme@support.example.test",
+      subject: "Delivery Status Notification",
+      body: "Undelivered mail",
+      message_id: "<daemon-1@example.test>"
+    )
+    assert_response :no_content
+
+    post_relay build_raw_email(
+      from: "noreply@example.test",
+      to: "acme@support.example.test",
+      subject: "Automated notification",
+      body: "Do not reply",
+      message_id: "<noreply-1@example.test>"
+    )
+    assert_response :no_content
+
+    # Multipart/report (DSN)
+    dsn = Mail.new do
+      from "postmaster@example.test"
+      to "acme@support.example.test"
+      subject "Undeliverable"
+      message_id "<dsn-1@example.test>"
+      content_type "multipart/report; report-type=delivery-status"
+      part content_type: "text/plain", body: "Failed delivery"
+    end
+    post_relay(dsn.to_s)
+    assert_response :no_content
+
+    assert_equal 0, @acme.tickets.count
+
+    # Auto-Submitted: no is explicitly human-submitted and MUST be accepted
+    post_relay build_raw_email(
+      from: "human@example.test",
+      to: "acme@support.example.test",
+      subject: "Human message",
+      body: "Real request",
+      message_id: "<human-1@example.test>",
+      extra_headers: { "Auto-Submitted" => "no" }
+    )
+    assert_response :no_content
+    assert_equal 1, @acme.tickets.count
+  end
