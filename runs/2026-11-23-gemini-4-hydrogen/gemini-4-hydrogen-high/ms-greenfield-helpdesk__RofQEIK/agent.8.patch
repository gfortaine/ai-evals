@@ -0,0 +1,611 @@
+require "test_helper"
+require "uri"
+require "rack/utils"
+
+class CursorPaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme = create_verified_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    @jo = @acme.users.find_by!(email: "jo@acme.test")
+    @agent = @acme.users.create!(name: "Sam Agent", email: "sam@acme.test", password: "agent-password-123", role: "agent", verified_at: Time.current)
+    @avery = @acme.users.create!(name: "Avery", email: "avery@example.test", password: "cust-password-123", role: "customer", verified_at: Time.current)
+    @blair = @acme.users.create!(name: "Blair", email: "blair@example.test", password: "cust-password-123", role: "customer", verified_at: Time.current)
+
+    @beta = create_verified_account(name: "Beta", subdomain: "beta", admin_name: "Bo", email: "bo@beta.test", password: "beta-first-password")
+    @bo = @beta.users.find_by!(email: "bo@beta.test")
+
+    @jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    @agent_token = sign_in(subdomain: "acme", email: "sam@acme.test", password: "agent-password-123")
+    @avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "cust-password-123")
+    @blair_token = sign_in(subdomain: "acme", email: "blair@example.test", password: "cust-password-123")
+    @bo_token = sign_in(subdomain: "beta", email: "bo@beta.test", password: "beta-first-password")
+  end
+
+  test "empty collection returns expected cursor pagination shape" do
+    get "/api/v1/tickets?page[size]=25&status=open", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+
+    assert_equal({
+      "tickets" => [],
+      "meta" => {
+        "has_more" => false,
+        "after_cursor" => nil,
+        "before_cursor" => nil
+      },
+      "links" => {
+        "next" => nil,
+        "prev" => nil
+      }
+    }, json_body)
+  end
+
+  test "tickets forward and backward navigation via links and manual cursors preserves filters" do
+    t1 = create_ticket(token: @avery_token, subject: "Billing 1", body: "Need invoice", at: "2026-11-10 10:00:00 UTC")
+    t2 = create_ticket(token: @avery_token, subject: "Billing 2", body: "Need receipt", at: "2026-11-10 10:01:00 UTC")
+    t3 = create_ticket(token: @blair_token, subject: "Billing 3", body: "Charge issue", at: "2026-11-10 10:02:00 UTC")
+    t4 = create_ticket(token: @avery_token, subject: "Billing 4", body: "Refund check", at: "2026-11-10 10:03:00 UTC")
+    t5 = create_ticket(token: @blair_token, subject: "Billing 5", body: "Card update", at: "2026-11-10 10:04:00 UTC")
+    # Non-matching status ticket should be excluded by status=open
+    t_solved = create_ticket(token: @avery_token, subject: "Billing solved", body: "Done", at: "2026-11-10 10:05:00 UTC")
+    patch "/api/v1/tickets/#{t_solved}",
+          params: { ticket: { status: "solved" } },
+          headers: auth_headers("acme", @jo_token),
+          as: :json
+    assert_response :ok
+
+    # Page 1: [t5, t4]
+    get "/api/v1/tickets?page[size]=2&status=open&q=Billing", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [ t5, t4 ], json_body["tickets"].map { |t| t["id"] }
+    assert_equal true, json_body.dig("meta", "has_more")
+    assert_not_nil json_body.dig("meta", "before_cursor")
+    assert_not_nil json_body.dig("meta", "after_cursor")
+    assert_nil json_body.dig("links", "prev")
+    assert_not_nil json_body.dig("links", "next")
+    assert_not json_body.key?("count")
+    assert_not json_body.key?("page")
+
+    next_uri = URI.parse(json_body.dig("links", "next"))
+    next_query = Rack::Utils.parse_nested_query(next_uri.query)
+    assert_equal "/api/v1/tickets", next_uri.path
+    assert_equal "open", next_query["status"]
+    assert_equal "Billing", next_query["q"]
+    assert_equal "2", next_query.dig("page", "size")
+    assert_equal json_body.dig("meta", "after_cursor"), next_query.dig("page", "after")
+    assert_nil next_query.dig("page", "before")
+
+    # Page 2 via links.next: [t3, t2]
+    get json_body.dig("links", "next"), headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal [ t3, t2 ], json_body["tickets"].map { |t| t["id"] }
+    assert_equal true, json_body.dig("meta", "has_more")
+    assert_not_nil json_body.dig("links", "next")
+    assert_not_nil json_body.dig("links", "prev")
+    p2_before_cursor = json_body.dig("meta", "before_cursor")
+
+    # Page 3 via links.next: [t1]
+    get json_body.dig("links", "next"), headers: auth_headers("acme", @jo_token)
+    assert_response :ok
