+    assert_equal ids_desc.last(5), json_body["tickets"].map { |t| t["id"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+
+    # page[size] > 1000 clamps to 1000
+    get "/api/v1/tickets?page[size]=5000", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal 30, json_body["tickets"].size
+    assert_equal false, json_body.dig("meta", "has_more")
+
+    # Partial backward page: ask for size 5 before the 3rd record -> returns first 2 records with has_more: false
+    get "/api/v1/tickets?page[size]=2", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    get json_body.dig("links", "next"), headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    third_cursor = json_body.dig("meta", "before_cursor")
+
+    get "/api/v1/tickets?page[before]=#{third_cursor}&page[size]=5", headers: auth_headers("acme", @jo_token)
+    assert_response :ok
+    assert_equal ids_desc.first(2), json_body["tickets"].map { |t| t["id"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+    assert_nil json_body.dig("links", "prev")
+    assert_not_nil json_body.dig("links", "next")
+  end
+
+  test "concurrent comment additions and deleted boundary group do not break cursor navigation" do
+    t1 = create_ticket(token: @avery_token, subject: "Thread", body: "C1", at: "2026-11-10 10:00:00 UTC")
+    travel_to Time.zone.parse("2026-11-10 10:01:00 UTC") do
+      patch "/api/v1/tickets/#{t1}", params: { ticket: { comment: { body: "C2", public: true } } }, headers: auth_headers("acme", @agent_token), as: :json
+      assert_response :ok
+    end
+    travel_to Time.zone.parse("2026-11-10 10:02:00 UTC") do
+      patch "/api/v1/requests/#{t1}", params: { request: { comment: { body: "C3" } } }, headers: auth_headers("acme", @avery_token), as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/tickets/#{t1}/comments?page[size]=2", headers: auth_headers("acme", @agent_token)
+    assert_response :ok
+    assert_equal [ "C1", "C2" ], json_body["comments"].map { |c| c["body"] }
+    next_comments = json_body.dig("links", "next")
+
+    # Add C4 concurrently
+    travel_to Time.zone.parse("2026-11-10 10:03:00 UTC") do
+      patch "/api/v1/tickets/#{t1}", params: { ticket: { comment: { body: "C4", public: true } } }, headers: auth_headers("acme", @agent_token), as: :json
+      assert_response :ok
+    end
+
+    get next_comments, headers: auth_headers("acme", @agent_token)
+    assert_response :ok
+    assert_equal [ "C3", "C4" ], json_body["comments"].map { |c| c["body"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+
+    # Deleting boundary group while paging groups
+    g1 = @acme.groups.create!(name: "G1")
+    g2 = @acme.groups.create!(name: "G2")
+    g3 = @acme.groups.create!(name: "G3")
+
+    get "/api/v1/groups?page[size]=2", headers: auth_headers("acme", @agent_token)
+    assert_response :ok
+    assert_equal [ g1.id, g2.id ], json_body["groups"].map { |g| g["id"] }
+    groups_next = json_body.dig("links", "next")
+
+    delete "/api/v1/groups/#{g2.id}", headers: auth_headers("acme", @jo_token)
+    assert_response :no_content
+
+    get groups_next, headers: auth_headers("acme", @agent_token)
+    assert_response :ok
+    assert_equal [ g3.id ], json_body["groups"].map { |g| g["id"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+  end
+
+  private
+
+  def create_ticket(token:, subject:, body:, at:, subdomain: "acme")
+    travel_to Time.zone.parse(at) do
+      post "/api/v1/requests",
+           params: { request: { subject: subject, comment: { body: body } } },
+           headers: auth_headers(subdomain, token),
+           as: :json
+      assert_response :created
+      json_body.dig("request", "id")
+    end
+  end
+
+  def auth_headers(subdomain, token)
+    {
+      "X-Helpdesk-Account" => subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+end
