+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @david = users(:david)
+    @jz = users(:jz)
+    Current.account = @account
+    Current.user = @david
+  end
+
+  test "exports only cards the user can see as JSON with comments and attachments" do
+    secret_board = @account.boards.create!(name: "Secret Board", all_access: false, creator: @david)
+    secret_board.accesses.grant_to(@david)
+    secret_card = secret_board.cards.create!(title: "Secret Card", status: "published", creator: @david)
+
+    visible_card = cards(:logo)
+    visible_card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("avatar.png")),
+      filename: "diagram.png",
+      content_type: "image/png"
+    )
+    visible_card.update!(description: "<p>See #{ActionText::Attachment.from_attachable(embed_blob).to_html}</p>")
+
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("attached pdf bytes"),
+      filename: "spec.pdf",
+      content_type: "application/pdf"
+    )
+    visible_card.comments.create!(
+      creator: @david,
+      body: "<p>Comment with file #{ActionText::Attachment.from_attachable(comment_blob).to_html}</p>"
+    )
+
+    export = @jz.data_exports.create!(account: @account)
+
+    assert_emails 1 do
+      export.build_now
+    end
+
+    assert export.completed?
+    assert export.available?
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @jz.identity.email_address ], email.to
+    assert_match Rails.application.routes.url_helpers.user_data_export_path(@jz, export, script_name: @account.slug), email.body.encoded
+
+    ZipFile.read_for(export.file) do |zip|
+      assert zip.exists?("#{visible_card.number}.json")
+      assert_not zip.exists?("#{secret_card.number}.json")
+
+      card_data = JSON.parse(zip.read("#{visible_card.number}.json"))
+      assert_equal visible_card.title, card_data["title"]
+      assert_equal visible_card.comments.count, card_data["comments"].size
+
+      image_path = card_data.dig("image", "path")
+      assert image_path.present?
+      assert zip.exists?(image_path)
+      assert_equal file_fixture("moon.jpg").binread, zip.read(image_path).b
+
+      desc_attachment_path = card_data["attachments"].first["path"]
+      assert zip.exists?(desc_attachment_path)
+      assert_equal file_fixture("avatar.png").binread, zip.read(desc_attachment_path).b
+
+      comment_with_file = card_data["comments"].find { |c| c["attachments"].any? }
+      assert comment_with_file.present?
+      comment_file_path = comment_with_file["attachments"].first["path"]
+      assert zip.exists?(comment_file_path)
+      assert_equal "attached pdf bytes", zip.read(comment_file_path)
+    end
+  end
+
+  test "excludes other users drafted cards" do
+    draft_card = boards(:writebook).cards.create!(title: "David Private Draft", status: :drafted, creator: @david)
+    own_draft = boards(:writebook).cards.create!(title: "JZ Own Draft", status: :drafted, creator: @jz)
+
+    export = @jz.data_exports.create!(account: @account)
+    export.build_now
+
+    ZipFile.read_for(export.file) do |zip|
+      assert_not zip.exists?("#{draft_card.number}.json")
+      assert zip.exists?("#{own_draft.number}.json"), "Expected #{own_draft.number}.json (status=#{own_draft.status} creator=#{own_draft.creator_id} jz=#{@jz.id}) in #{zip.glob("*")}"
+    end
+  end
+end
