+
+    def export_records
+      batch_index = 0
+
+      if records.respond_to?(:find_in_batches)
+        records.find_in_batches(batch_size: BATCH_SIZE) do |batch|
+          batch_index += 1
+          rows = serialize_batch(batch)
+          write_batch(batch_index, rows) if rows.any?
+        end
+      else
+        rows = records.map { |record| serialize_record(record) }
+        write_batch(1, rows) if rows.any?
+      end
+    end
+
+    def serialize_batch(relation)
+      relation.map { |record| serialize_record(record) }
+    end
+
+    def serialize_record(record)
+      record.attributes.slice(*attributes)
+    end
+
+    def write_batch(batch_index, rows)
+      path = format("%s/%06d.json", model_dir, batch_index)
+      zip.add_file(path, JSON.generate(rows))
+    end
+
+    def import_records(context)
+      zip.glob("#{model_dir}/*.json").each do |path|
+        rows = parse_json_array(path)
+        next if rows.empty?
+
+        mapped_rows = rows.map do |row|
+          new_id = ActiveRecord::Type::Uuid.generate
+          context.id_map[model.name][row["id"]] = new_id if row.key?("id")
+          import_attributes(row, context, new_id)
+        end
+
+        insert_batch(mapped_rows, context)
+      end
+    end
+
+    def parse_json_array(path)
+      data = JSON.parse(zip.read(path))
+      unless data.is_a?(Array)
+        raise Account::DataTransfer::ImportError, "Invalid data format in #{path}."
+      end
+
+      data
+    rescue JSON::ParserError => e
+      raise Account::DataTransfer::ImportError, "Invalid JSON in #{path}: #{e.message}"
+    end
+
+    def import_attributes(row, context, new_id)
+      attrs = row.slice(*model.column_names)
+      attrs["id"] = new_id if model.column_names.include?("id")
+      attrs["account_id"] = context.new_account.id if model.column_names.include?("account_id")
+
+      remap_foreign_keys!(attrs, context)
+      cast_datetimes!(attrs)
+      attrs
+    end
+
+    def remap_foreign_keys!(attrs, context)
+      belongs_to_associations.each do |association|
+        next if association.name == :account
+
+        foreign_key = association.foreign_key.to_s
+        next unless attrs.key?(foreign_key) && attrs[foreign_key].present?
+
+        if association.polymorphic?
+          target_type = attrs[association.foreign_type.to_s]
+          attrs[foreign_key] = context.remap_id!(target_type, attrs[foreign_key]) if target_type.present?
+        else
+          attrs[foreign_key] = context.remap_id!(association.klass.name, attrs[foreign_key])
+        end
+      end
+    end
+
+    def belongs_to_associations
+      @belongs_to_associations ||= model.reflect_on_all_associations(:belongs_to)
+    end
+
+    def cast_datetimes!(attrs)
+      model.columns_hash.each do |name, column|
+        if column.type == :datetime && attrs[name].is_a?(String)
+          attrs[name] = ActiveSupport::TimeZone["UTC"].parse(attrs[name])
+        end
+      end
+    end
+
+    def insert_batch(rows, _context)
+      model.insert_all!(rows)
+    end
 end
