+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+
+  layout "public"
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    @import = Current.identity.account_imports.new(import_params)
+
+    if @import.save
+      @import.process_later
+
+      respond_to do |format|
+        format.html { redirect_to new_account_import_path(script_name: nil), notice: "We’ve started importing your account. You’ll receive an email when it’s ready." }
+        format.json { render json: { id: @import.id, status: @import.status }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: { errors: @import.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  private
+    def import_params
+      params.fetch(:account_import, {}).permit(:file)
+    end
+end
