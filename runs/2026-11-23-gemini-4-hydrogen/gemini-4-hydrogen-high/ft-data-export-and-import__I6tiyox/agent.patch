diff --git a/app/models/account/data_transfer/action_text/rich_text_record_set.rb b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
index 76411f2..44c346b 100644
--- a/app/models/account/data_transfer/action_text/rich_text_record_set.rb
+++ b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
@@ -8,4 +8,93 @@ class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransf
       ::ActionText::RichText.where(account: account)
     end
 
+    def serialize_record(record)
+      attrs = super
+      raw_body = record.read_attribute_before_type_cast("body")
+      attrs["body"] = raw_body.present? ? export_body(raw_body.to_s) : raw_body
+      attrs
+    end
+
+    def import_records(context)
+      @attachable_cache = {}
+      super
+    ensure
+      @attachable_cache = nil
+    end
+
+    def import_attributes(row, context, new_id)
+      attrs = super
+      attrs["body"] = import_body(attrs["body"], context) if attrs["body"].present?
+      attrs
+    end
+
+    def export_body(html)
+      fragment = Nokogiri::HTML5.fragment(html)
+      changed = false
+
+      fragment.css("action-text-attachment").each do |node|
+        next if node["sgid"].blank?
+
+        attachable = ::ActionText::Attachable.from_attachable_sgid(node["sgid"])
+        if attachable.respond_to?(:to_gid)
+          node["sgid"] = attachable.to_gid.to_s
+          changed = true
+        end
+      rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+        next
+      end
+
+      changed ? fragment.to_html : html
+    end
+
+    def import_body(html, context)
+      fragment = Nokogiri::HTML5.fragment(html)
+      changed = false
+
+      fragment.css("action-text-attachment").each do |node|
+        next if node["sgid"].blank?
+
+        gid = parse_gid(node["sgid"])
+        next unless gid
+
+        new_target_id = context.id_map[gid.model_name]&.[](gid.model_id)
+        next unless new_target_id
+
+        attachable = find_attachable(gid.model_name, new_target_id)
+        next unless attachable
+
+        node["sgid"] = attachable.attachable_sgid
+        if attachable.is_a?(::ActiveStorage::Blob) && node["url"].to_s.include?("/rails/active_storage/")
+          node["url"] = Rails.application.routes.url_helpers.polymorphic_url(
+            attachable,
+            only_path: true,
+            script_name: context.new_account.slug
+          )
+        end
+        changed = true
+      end
+
+      changed ? fragment.to_html : html
+    end
+
+    def parse_gid(sgid_or_gid)
+      if sgid_or_gid.start_with?("gid://")
+        GlobalID.parse(sgid_or_gid)
+      else
+        payload = sgid_or_gid.split("--").first
+        data = JSON.parse(Base64.decode64(payload)).dig("_rails", "data")
+        GlobalID.parse(data) if data.is_a?(String)
+      end
+    rescue StandardError
+      nil
+    end
+
+    def find_attachable(model_name, id)
+      @attachable_cache[[ model_name, id ]] ||= case model_name
+      when "User"
+        ::User.find_by(id: id)
+      when "ActiveStorage::Blob"
+        ::ActiveStorage::Blob.find_by(id: id)
+      end
+    end
 end
