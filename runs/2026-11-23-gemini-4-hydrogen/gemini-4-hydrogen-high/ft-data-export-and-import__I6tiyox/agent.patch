+class Users::DataExportsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    export = @user.data_exports.create!(account: Current.account)
+    export.build_later
+
+    respond_to do |format|
+      format.html { redirect_to @user, notice: "We’ve started exporting your data. You’ll receive an email when it’s ready." }
+      format.json { render json: { id: export.id, status: export.status }, status: :created }
+    end
+  end
+
+  def show
+    @export = @user.data_exports.find_by(id: params[:id])
+
+    if @export&.available?
+      redirect_to rails_blob_path(@export.file, disposition: "attachment")
+    elsif @export&.pending? || @export&.processing?
+      respond_to do |format|
+        format.html { render "exports/pending", status: :accepted }
+        format.json { render json: { status: @export.status }, status: :accepted }
+      end
+    elsif @export&.expired?
+      respond_to do |format|
+        format.html { render "exports/expired", status: :gone }
+        format.json { head :gone }
+      end
+    else
+      respond_to do |format|
+        format.html { render "exports/expired", status: :not_found }
+        format.json { head :not_found }
+      end
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless Current.user == @user
+    end
+end
