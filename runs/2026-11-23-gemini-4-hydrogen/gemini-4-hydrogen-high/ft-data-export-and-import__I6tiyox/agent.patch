diff --git a/test/models/account/export_test.rb b/test/models/account/export_test.rb
new file mode 100644
index 0000000..dee6766
--- /dev/null
+++ b/test/models/account/export_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @admin = users(:jason)
+    Current.account = @account
+    Current.user = @admin
+  end
+
+  test "build_now creates a zip containing all account data and sends email" do
+    card = cards(:logo)
+    card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("avatar.png")),
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+    embed_html = ActionText::Attachment.from_attachable(embed_blob).to_html
+    card.update!(description: "<p>Check #{embed_html} and #{ActionText::Attachment.from_attachable(users(:david)).to_html}</p>")
+
+    export = @account.exports.create!(user: @admin)
+
+    assert_emails 1 do
+      export.build_now
+    end
+
+    assert export.completed?
+    assert export.available?
+    assert export.file.attached?
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @admin.identity.email_address ], email.to
+    assert_match Rails.application.routes.url_helpers.account_export_path(export, script_name: @account.slug), email.body.encoded
+    assert_match /1 day/i, email.body.encoded
+
+    ZipFile.read_for(export.file) do |zip|
+      assert zip.exists?("accounts/000001.json")
+      assert zip.exists?("users/000001.json")
+      assert zip.exists?("boards/000001.json")
+      assert zip.exists?("cards/000001.json")
+      assert zip.exists?("comments/000001.json")
+      assert zip.exists?("active_storage_blobs/000001.json")
+      assert zip.exists?("active_storage_attachments/000001.json")
+      assert zip.exists?("action_text_rich_texts/000001.json")
+      assert zip.exists?("active_storage_files/#{card.image.blob.id}")
+      assert zip.exists?("active_storage_files/#{embed_blob.id}")
+      assert_not zip.exists?("active_storage_files/#{export.file.blob.id}")
+
+      blobs_json = JSON.parse(zip.read("active_storage_blobs/000001.json"))
+      blob_ids = blobs_json.map { |b| b["id"] }
+      assert_not_includes blob_ids, export.file.blob.id
+
+      rich_texts_json = JSON.parse(zip.read("action_text_rich_texts/000001.json"))
+      card_rt = rich_texts_json.find { |rt| rt["record_type"] == "Card" && rt["record_id"] == card.id }
+      assert_includes card_rt["body"], embed_blob.to_gid.to_s
+      assert_includes card_rt["body"], users(:david).to_gid.to_s
+    end
+  end
+
+  test "export expires after 1 day and cleanup removes expired exports" do
+    export = @account.exports.create!(user: @admin)
+    export.build_now
+
+    assert export.available?
+    assert_not export.expired?
+
+    travel 25.hours do
+      assert export.expired?
+      assert_not export.available?
+
+      assert_difference -> { Export.count }, -1 do
+        Export.cleanup
+      end
+    end
+  end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..65c3614
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,306 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @admin = users(:jason)
+    Current.account = @account
+    Current.user = @admin
+  end
+
+  test "full account export and import creates a new account with everything in it" do
+    card = cards(:logo)
+    card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("avatar.png")),
+      filename: "diagram.png",
+      content_type: "image/png"
+    )
+    mention_html = ActionText::Attachment.from_attachable(users(:david)).to_html
+    embed_html = ActionText::Attachment.from_attachable(embed_blob).to_html
+    card.update!(description: "<p>Hello #{mention_html} see #{embed_html}</p>")
+
+    users(:david).avatar.attach(io: File.open(file_fixture("avatar.png")), filename: "avatar.png", content_type: "image/png")
+
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("comment attachment data"),
+      filename: "notes.txt",
+      content_type: "text/plain"
+    )
+    comment = card.comments.create!(
+      creator: users(:kevin),
+      body: "<p>Attached #{ActionText::Attachment.from_attachable(comment_blob).to_html}</p>"
+    )
+
+    board = boards(:writebook)
+    board.publish
+
+    # Export original account
+    export = @account.exports.create!(user: @admin)
+    export.build_now
+
+    # Import into a new account by a signed-in identity
+    importing_identity = identities(:jason)
+    import = importing_identity.account_imports.new
+    import.file.attach(io: StringIO.new(export.file.download), filename: "export.zip", content_type: "application/zip")
+    import.save!
+
+    assert_difference -> { Account.count }, +1 do
+      assert_emails 1 do
+        import.process_now
+      end
+    end
+
+    assert import.completed?
+    new_account = import.account
+    assert_not_nil new_account
+    assert_not_equal @account.id, new_account.id
+    assert_not_equal @account.external_account_id, new_account.external_account_id
+    assert_equal @account.name, new_account.name
+
+    # Email sent when done
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ importing_identity.email_address ], email.to
+    assert_match Rails.application.routes.url_helpers.landing_path(script_name: new_account.slug), email.body.encoded
+
+    # People preserved (active, inactive, system)
+    assert_equal @account.users.count, new_account.users.count
+    new_david = new_account.users.find_by!(identity: identities(:david))
+    assert new_david.avatar.attached?
+    assert_equal file_fixture("avatar.png").binread, new_david.avatar.download
+
+    # Boards, columns, publications, cards, comments, tags, steps preserved
+    assert_equal @account.boards.count, new_account.boards.count
+    new_board = new_account.boards.find_by!(name: board.name)
+    assert new_board.publication.present?
+    assert_not_equal board.publication.key, new_board.publication.key
+
+    new_card = new_account.cards.find_by!(number: card.number)
+    assert_equal card.title, new_card.title
