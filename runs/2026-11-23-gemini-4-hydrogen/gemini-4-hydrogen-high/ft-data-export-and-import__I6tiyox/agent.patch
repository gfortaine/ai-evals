diff --git a/app/models/user/data_export.rb b/app/models/user/data_export.rb
new file mode 100644
index 0000000..9d396d8
--- /dev/null
+++ b/app/models/user/data_export.rb
@@ -0,0 +1,126 @@
+class User::DataExport < Export
+  def accessible_to?(user)
+    user.present? && user == self.user
+  end
+
+  private
+    def generate_export
+      ZipFile.create_for(file, filename: filename) do |zip|
+        export_cards(zip)
+      end
+    end
+
+    def deliver_email
+      AccountMailer.export_ready(self).deliver_now
+    end
+
+    def filename
+      "fizzy-cards-#{user.name.parameterize.presence || user.id}-#{Date.current}.zip"
+    end
+
+    def export_cards(zip)
+      visible_cards.find_each(batch_size: 100) do |card|
+        export_card(zip, card)
+      end
+    end
+
+    def visible_cards
+      Card.where(board_id: user.board_ids)
+          .where(status: "published")
+          .or(Card.where(board_id: user.board_ids, creator_id: user.id))
+          .includes(
+            :board, :column, :creator, :tags, :steps, :assignees, :closure, :goldness, :not_now,
+            { image_attachment: :blob },
+            { rich_text_description: { embeds_attachments: :blob } },
+            { comments: [ :creator, { rich_text_body: { embeds_attachments: :blob } } ] }
+          )
+    end
+
+    def export_card(zip, card)
+      image_metadata = export_card_image(zip, card)
+      description_attachments = export_rich_text_attachments(zip, card, card.description)
+
+      comments_json = card.comments.sort_by(&:created_at).map do |comment|
+        comment_attachments = export_rich_text_attachments(zip, card, comment.body)
+        serialize_comment(comment, comment_attachments)
+      end
+
+      payload = serialize_card(card, image_metadata, description_attachments, comments_json)
+      zip.add_file("#{card.number}.json", JSON.pretty_generate(payload))
+    end
+
+    def export_card_image(zip, card)
+      return nil unless card.image.attached?
+
+      export_blob(zip, card, card.image.blob)
+    end
+
+    def export_rich_text_attachments(zip, card, rich_text)
+      return [] unless rich_text&.embeds&.attached?
+
+      rich_text.embeds.map do |embed|
+        export_blob(zip, card, embed.blob)
+      end
+    end
+
+    def export_blob(zip, card, blob)
+      path = "#{card.number}/#{blob.id}-#{sanitize_filename(blob.filename.to_s)}"
+
+      unless zip.exists?(path)
+        zip.add_file(path, compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+
+      {
+        "filename" => blob.filename.to_s,
+        "content_type" => blob.content_type,
+        "byte_size" => blob.byte_size,
+        "path" => path
+      }
+    end
+
+    def sanitize_filename(filename)
+      filename.tr("/\\", "_").presence || "file"
+    end
+
+    def serialize_card(card, image_metadata, attachments, comments)
+      {
+        "id" => card.id,
+        "number" => card.number,
+        "title" => card.title,
+        "status" => card.status,
+        "board" => { "id" => card.board_id, "name" => card.board.name },
+        "column" => card.column && { "id" => card.column_id, "name" => card.column.name },
+        "creator" => { "id" => card.creator_id, "name" => card.creator.name },
+        "assignees" => card.assignees.map { |u| { "id" => u.id, "name" => u.name } },
+        "tags" => card.tags.map(&:title).sort,
+        "steps" => card.steps.map { |s| { "id" => s.id, "content" => s.content, "completed" => s.completed } },
+        "closed" => card.closed?,
+        "postponed" => card.postponed?,
+        "golden" => card.golden?,
+        "description" => card.description.to_plain_text,
+        "description_html" => card.description.to_s,
+        "image" => image_metadata,
+        "attachments" => attachments,
+        "created_at" => card.created_at.utc.iso8601,
+        "last_active_at" => card.last_active_at.utc.iso8601,
+        "updated_at" => card.updated_at.utc.iso8601,
+        "comments" => comments
+      }
+    end
+
+    def serialize_comment(comment, attachments)
+      {
+        "id" => comment.id,
+        "creator" => { "id" => comment.creator_id, "name" => comment.creator.name },
+        "body" => {
+          "plain_text" => comment.body.to_plain_text,
+          "html" => comment.body.to_s
+        },
+        "attachments" => attachments,
+        "created_at" => comment.created_at.utc.iso8601,
+        "updated_at" => comment.updated_at.utc.iso8601
+      }
+    end
+end
