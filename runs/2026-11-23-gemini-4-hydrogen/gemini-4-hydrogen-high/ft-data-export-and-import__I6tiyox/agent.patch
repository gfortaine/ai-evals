diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..850d2bc
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,64 @@
+class ZipFile::Reader
+  CHUNK_SIZE = 1.megabyte
+
+  def initialize(io)
+    @io = io
+    @entries_by_name = nil
+  end
+
+  def glob(pattern)
+    entries_by_name.keys.select { |name| File.fnmatch(pattern, name) }.sort
+  end
+
+  def exists?(path)
+    entries_by_name.key?(path)
+  end
+
+  def entry(path)
+    entries_by_name.fetch(path) do
+      raise ZipFile::InvalidError, "Missing entry in archive: #{path}"
+    end
+  end
+
+  def read(path)
+    buffer = +""
+    extract(path) { |chunk| buffer << chunk }
+    buffer
+  end
+
+  def extract(path)
+    raise ArgumentError, "No block given" unless block_given?
+
+    zip_entry = entry(path)
+    extractor = zip_entry.extractor_from(@io)
+
+    until extractor.eof?
+      chunk = extractor.extract(CHUNK_SIZE)
+      yield chunk if chunk && !chunk.empty?
+    end
+  rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::UnsupportedFeature,
+         ZipKit::FileReader::LocalHeaderPending, Zlib::Error => e
+    raise ZipFile::InvalidError, "Corrupted entry #{path}: #{e.message}"
+  end
+
+  private
+    def entries_by_name
+      @entries_by_name ||= begin
+        entries = ZipKit::FileReader.read_zip_structure(io: @io)
+        entries.each_with_object({}) do |entry, map|
+          validate_entry_path!(entry.filename)
+          map[entry.filename] = entry
+        end
+      rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD,
+             ZipKit::FileReader::UnsupportedFeature, ZipKit::FileReader::InvalidStructure,
+             ArgumentError, EOFError => e
+        raise ZipFile::InvalidError, "Invalid ZIP archive: #{e.message}"
+      end
+    end
+
+    def validate_entry_path!(filename)
+      if filename.start_with?("/") || filename.split("/").include?("..")
+        raise ZipFile::InvalidError, "Unsafe path in ZIP archive: #{filename}"
+      end
+    end
+end
diff --git a/app/models/zip_file/remote_io.rb b/app/models/zip_file/remote_io.rb
new file mode 100644
index 0000000..b833cc5
--- /dev/null
+++ b/app/models/zip_file/remote_io.rb
@@ -0,0 +1,89 @@
+require "net/http/persistent"
+
+class ZipFile::RemoteIO
+  def initialize(url)
+    @pos = 0
+    @uri = URI(url)
+    @remote_size = nil
+    @http = Net::HTTP::Persistent.new(name: "zip_file_remote_io")
+  end
+
+  def seek(offset, mode = IO::SEEK_SET)
+    raise ZipFile::Error, "Unsupported seek mode #{mode}" unless mode == IO::SEEK_SET
+
+    @remote_size ||= request_object_size
+    @pos = clamp(0, offset, @remote_size)
+    0
+  end
+
+  def size
+    @remote_size ||= request_object_size
+  end
+
+  def read(n_bytes = nil)
+    return if size.zero?
+
+    maximum_available = size - @pos
+    n_bytes ||= maximum_available
+    return +"" if n_bytes.zero?
+    raise ArgumentError, "No negative reads(#{n_bytes})" if n_bytes < 0
+
+    n_bytes = clamp(0, n_bytes, maximum_available)
+    http_range = (@pos..(@pos + n_bytes - 1))
+
+    request_range(http_range).tap do |data|
+      if data.bytesize != n_bytes
+        raise ZipFile::Error, "Remote read returned #{data.bytesize} bytes instead of #{n_bytes} as requested"
+      end
+
+      @pos = clamp(0, @pos + data.bytesize, size)
+    end
+  end
+
+  def tell
+    @pos
+  end
+
+  def close
+    @http.shutdown
+  end
+
+  private
+    def request_range(range)
+      request = Net::HTTP::Get.new(@uri)
+      request.range = range
+      response = @http.request(@uri, request)
+
+      case response.code
+      when "206", "200"
+        response.body.b
+      else
+        raise ZipFile::Error, "Remote at #{@uri.host} replied with HTTP #{response.code}"
+      end
+    end
+
+    def request_object_size
+      request = Net::HTTP::Get.new(@uri)
+      request.range = 0..0
+      response = @http.request(@uri, request)
+
+      case response.code
+      when "206"
+        response["Content-Range"].split("/").last.to_i
+      when "200"
+        response["Content-Length"].to_i
+      else
+        raise ZipFile::Error, "Remote at #{@uri.host} replied with HTTP #{response.code}"
+      end
+    end
+
+    def clamp(min, value, max)
+      if value < min
+        min
+      elsif value > max
+        max
+      else
+        value
+      end
+    end
+end
