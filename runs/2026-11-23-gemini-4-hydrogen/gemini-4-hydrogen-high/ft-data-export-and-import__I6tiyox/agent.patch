+class Export < ApplicationRecord
+  EXPIRATION_DURATION = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  scope :expired, -> { where(completed_at: ...EXPIRATION_DURATION.ago) }
+
+  def self.cleanup
+    expired.find_each(&:destroy)
+  end
+
+  def build_later
+    ExportJob.perform_later(self)
+  end
+
+  def build_now
+    processing!
+    generate_export
+    update!(status: :completed, completed_at: Time.current)
+    deliver_email
+  rescue StandardError
+    failed!
+    raise
+  end
+
+  def expired?
+    completed_at.present? && completed_at <= EXPIRATION_DURATION.ago
+  end
+
+  def available?
+    completed? && !expired? && file.attached?
+  end
+
+  def accessible_to?(_user)
+    false
+  end
+
+  private
+    def generate_export
+      raise NotImplementedError
+    end
+
+    def deliver_email
+      raise NotImplementedError
+    end
+end
