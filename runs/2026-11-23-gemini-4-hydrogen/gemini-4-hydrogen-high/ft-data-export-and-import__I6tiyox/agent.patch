+class Account::ImportEdgeCasesTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @admin = users(:jason)
+    Current.account = @account
+    Current.user = @admin
+  end
+
+  test "preserves filters, events with particulars, tags, steps, reactions, webhooks, and entropy" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    tag = @account.tags.create!(title: "urgent")
+    card.tags << tag
+    step = card.steps.create!(content: "First step", completed: true)
+    card.reactions.create!(content: "👍", reacter: users(:david))
+    filter = users(:david).filters.create!(
+      account: @account,
+      boards: [ board ],
+      tags: [ tag ],
+      assignees: [ users(:jz) ],
+      card_ids: [ card.id ]
+    )
+    webhook = board.webhooks.create!(
+      name: "Hooks",
+      url: "https://example.com/hook",
+      signing_secret: "secret",
+      subscribed_actions: %w[card_published]
+    )
+
+    export = @account.exports.create!(user: @admin)
+    export.build_now
+
+    import = identities(:jason).account_imports.new
+    import.file.attach(io: StringIO.new(export.file.download), filename: "export.zip", content_type: "application/zip")
+    import.save!
+    import.process_now
+
+    assert import.completed?
+    new_account = import.account
+    new_board = new_account.boards.find_by!(name: board.name)
+    new_card = new_account.cards.find_by!(number: card.number)
+    new_david = new_account.users.find_by!(identity: identities(:david))
+    new_jz = new_account.users.find_by!(identity: identities(:jz))
+
+    assert_equal [ "urgent", "web" ], new_card.tags.pluck(:title).sort
+    assert_equal [ [ "First step", true ] ], new_card.steps.pluck(:content, :completed)
+    assert new_card.reactions.exists?(content: "👍", reacter: new_david)
+    assert new_board.webhooks.exists?(name: "Hooks", url: "https://example.com/hook")
+
+    new_filter = new_david.filters.find { |f| f.card_ids.present? }
+    assert_not_nil new_filter
+    assert_equal [ new_board.id ], new_filter.boards.ids
+    assert_equal [ new_account.tags.find_by!(title: "urgent").id ], new_filter.tags.ids
+    assert_equal [ new_jz.id ], new_filter.assignees.ids
+    assert_equal [ new_card.id ], new_filter.card_ids
+
+    assignment_event = new_board.events.find_by(action: "card_assigned")
+    assert_not_nil assignment_event
+    assert_includes assignment_event.assignee_ids, new_jz.id
+  end
+
+  test "importing a user card export zip fails cleanly with explanation and leaves nothing behind" do
+    user_export = users(:david).data_exports.create!(account: @account)
+    user_export.build_now
+
+    import = identities(:jason).account_imports.new
+    import.file.attach(io: StringIO.new(user_export.file.download), filename: "cards.zip", content_type: "application/zip")
+    import.save!
+
+    assert_no_difference [ -> { Account.count }, -> { Board.count }, -> { Card.count } ] do
+      assert_emails 1 do
+        import.process_now
+      end
+    end
+
+    assert import.failed?
+    assert_match /missing account data/i, import.error_message
+  end
+
+  test "cleans up already-uploaded blob files from storage when a later blob fails" do
+    card1 = cards(:logo)
+    card1.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+    card2 = cards(:layout)
+    card2.image.attach(io: File.open(file_fixture("avatar.png")), filename: "avatar.png", content_type: "image/png")
+
+    export = @account.exports.create!(user: @admin)
+    export.build_now
+
+    # Remove only the second blob file so the first blob uploads and then the second fails!
+    second_blob_id = card2.image.blob.id
+    partial_zip = Tempfile.new([ "partial", ".zip" ])
+    partial_zip.binmode
+    ZipFile.read_for(export.file) do |reader|
+      writer = ZipFile::Writer.new(partial_zip)
+      reader.glob("*/*").each do |path|
+        next if path == "active_storage_files/#{second_blob_id}"
+
+        writer.add_file(path, reader.read(path), compress: !path.start_with?("active_storage_files/"))
+      end
+      writer.close
+    end
+    partial_zip.rewind
+
+    storage_root = ActiveStorage::Blob.service.root
+    files_before = Dir.glob(File.join(storage_root, "**", "*")).select { |p| File.file?(p) }.sort
+
+    import = identities(:jason).account_imports.new
+    import.file.attach(io: partial_zip, filename: "partial.zip", content_type: "application/zip")
+    import.save!
+    import.process_now
+
+    assert import.failed?
+    files_after = Dir.glob(File.join(storage_root, "**", "*")).select { |p| File.file?(p) }.sort
+    assert_equal files_before, files_after
+  ensure
+    partial_zip&.close
+    partial_zip&.unlink
+  end
+end
