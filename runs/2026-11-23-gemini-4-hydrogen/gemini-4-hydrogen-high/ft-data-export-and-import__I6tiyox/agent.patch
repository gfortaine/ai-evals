index 0000000..e47aa4e
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @admin = users(:jason)
+    @member = users(:david)
+  end
+
+  test "admin sees export button on account settings" do
+    sign_in_as @admin
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action='#{account_exports_path}']"
+  end
+
+  test "non-admin does not see export button on account settings" do
+    sign_in_as @member
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action='#{account_exports_path}']", count: 0
+  end
+
+  test "admin can create and download account export" do
+    sign_in_as @admin
+
+    assert_difference -> { Account::Export.count }, +1 do
+      assert_enqueued_with job: ExportJob do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    export = Account::Export.last
+
+    perform_enqueued_jobs(only: ExportJob)
+    assert export.reload.completed?
+    assert_emails 1
+
+    get account_export_path(export)
+    assert_redirected_to rails_blob_url(export.file, disposition: "attachment")
+
+    follow_redirect!
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+  end
+
+  test "non-admin cannot create or download account export" do
+    sign_in_as @admin
+    export = @account.exports.create!(user: @admin)
+    export.build_now
+
+    logout_and_sign_in_as @member
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_path
+    end
+    assert_response :forbidden
+
+    get account_export_path(export)
+    assert_response :forbidden
+  end
+
+  test "download link expires after 1 day" do
+    sign_in_as @admin
+    export = @account.exports.create!(user: @admin)
+    export.build_now
+
+    travel 25.hours do
+      get account_export_path(export)
+      assert_response :gone
+    end
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..a11c217
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @admin = users(:jason)
+  end
+
+  test "unauthenticated user is redirected to login" do
+    untenanted do
+      get new_account_import_path
+    end
+    assert_response :redirect
+  end
+
+  test "signed-in user can view new import form without account scope" do
+    sign_in_as @admin
+
+    untenanted do
+      get new_account_import_path
+    end
+    assert_response :success
+    assert_select "input[type=file]"
+  end
+
+  test "submitting without a file returns unprocessable entity" do
+    sign_in_as @admin
+
+    untenanted do
+      assert_no_difference -> { Account::Import.count } do
+        post account_imports_path
+      end
+    end
+    assert_response :unprocessable_entity
+  end
+
+  test "signed-in user can import an exported account zip" do
+    export = @account.exports.create!(user: @admin)
+    export.build_now
+
+    tempfile = Tempfile.new([ "export", ".zip" ])
+    tempfile.binmode
+    tempfile.write(export.file.download)
+    tempfile.rewind
+
+    sign_in_as @admin
+
+    untenanted do
+      assert_difference -> { Account::Import.count }, +1 do
+        assert_enqueued_with job: Account::ImportJob do
+          post account_imports_path, params: {
+            account_import: {
+              file: Rack::Test::UploadedFile.new(tempfile.path, "application/zip", true)
+            }
+          }
+        end
+      end
+      assert_redirected_to new_account_import_path
+    end
+
+    assert_difference -> { Account.count }, +1 do
+      assert_emails 1 do
+        perform_enqueued_jobs(only: Account::ImportJob)
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @admin.identity.email_address ], email.to
+    assert_match /import is complete/i, email.subject
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  test "submitting an invalid zip sends failure email and leaves nothing behind" do
+    tempfile = Tempfile.new([ "bad", ".zip" ])
+    tempfile.binmode
+    tempfile.write("definitely not a zip")
+    tempfile.rewind
+
+    sign_in_as @admin
+
+    untenanted do
+      post account_imports_path, params: {
+        account_import: {
+          file: Rack::Test::UploadedFile.new(tempfile.path, "application/zip", true)
+        }
+      }
+      assert_redirected_to new_account_import_path
+    end
+
+    assert_no_difference [ -> { Account.count }, -> { Board.count }, -> { Card.count }, -> { User.count } ] do
+      assert_emails 1 do
+        perform_enqueued_jobs(only: Account::ImportJob)
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @admin.identity.email_address ], email.to
+    assert_match /failed/i, email.subject
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+end
