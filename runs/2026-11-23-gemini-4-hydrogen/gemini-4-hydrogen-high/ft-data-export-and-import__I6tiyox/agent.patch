diff --git a/app/models/account/data_transfer/context.rb b/app/models/account/data_transfer/context.rb
new file mode 100644
index 0000000..43cb232
--- /dev/null
+++ b/app/models/account/data_transfer/context.rb
@@ -0,0 +1,30 @@
+class Account::DataTransfer::ImportError < StandardError; end
+
+class Account::DataTransfer::Context
+  attr_accessor :new_account
+  attr_reader :importing_identity, :id_map, :blob_info_map, :uploaded_blob_keys
+
+  def initialize(importing_identity:)
+    @importing_identity = importing_identity
+    @id_map = Hash.new { |h, k| h[k] = {} }
+    @blob_info_map = {}
+    @uploaded_blob_keys = []
+  end
+
+  def remap_id!(model_name, old_id)
+    return nil if old_id.nil?
+
+    id_map[model_name].fetch(old_id) do
+      raise Account::DataTransfer::ImportError, "Missing referenced #{model_name} (#{old_id}) in export archive."
+    end
+  end
+
+  def cleanup_uploaded_blobs
+    service = ::ActiveStorage::Blob.service
+    uploaded_blob_keys.each do |key|
+      service.delete(key)
+    rescue StandardError => e
+      Rails.logger.warn("Failed to clean up uploaded blob #{key}: #{e.message}")
+    end
+  end
+end
