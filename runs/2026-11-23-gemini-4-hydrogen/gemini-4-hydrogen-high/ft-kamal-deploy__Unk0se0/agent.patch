diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..34f34bc
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,72 @@
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image.
+image: fizzy
+
+# Deploy to these servers.
+servers:
+  web:
+    - your-server-ip-or-hostname
+
+# Enable SSL auto certification via Let's Encrypt and allow for multiple apps on a single web server.
+# If using Cloudflare, set encryption mode in SSL/TLS setting to "Full" to enable CF-to-app encryption.
+proxy:
+  ssl: true
+  host: your-domain.example.com
+
+# Credentials for your image host.
+# By default, Kamal starts a local Docker registry on localhost:5555 so you don't need an external registry.
+registry:
+  server: localhost:5555
+
+# Configure builder setup.
+builder:
+  arch: amd64
+  # Change to arm64 if deploying to an ARM server:
+  # arch: arm64
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    # Hostname used for links in emails, push notifications, and webhooks.
+    # Should match proxy.host above.
+    APP_HOST: your-domain.example.com
+
+    # Run background jobs (Solid Queue) inside the Puma web container.
+    SOLID_QUEUE_IN_PUMA: "true"
+    JOB_CONCURRENCY: "1"
+
+    # Outbound email settings (SMTP).
+    MAILER_FROM_ADDRESS: Fizzy <noreply@your-domain.example.com>
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_USERNAME: your-smtp-username
+    # SMTP_DOMAIN: your-domain.example.com
+    # SMTP_AUTHENTICATION: plain
+    # SMTP_ENABLE_STARTTLS_AUTO: "true"
+    # SMTP_TLS: "false"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# Use a persistent storage volume for SQLite databases and Active Storage uploads.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests.
+asset_path: /rails/public/assets
+
+# Use a different ssh user than root if needed.
+# ssh:
+#   user: app
+
+# Aliases are triggered with "bin/kamal <alias>".
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
