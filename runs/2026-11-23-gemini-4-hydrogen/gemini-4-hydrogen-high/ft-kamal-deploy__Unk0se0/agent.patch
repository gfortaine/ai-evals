+# Secrets defined here are available for reference under env/secret in config/deploy.yml.
+# All secrets should be pulled from either a password manager, ENV, or a file.
+# DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
+#
+# Generate SECRET_KEY_BASE with:
+#   bin/rails secret
+#
+# Generate VAPID keys for web push notifications with:
+#   bin/rails runner 'k = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{k.public_key}\nVAPID_PRIVATE_KEY=#{k.private_key}"'
+#
+# Option 1: Read secrets from the environment
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+SMTP_PASSWORD=$SMTP_PASSWORD
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+
+# Option 2: Read secrets via a password manager (1Password, Bitwarden, LastPass, etc.)
+# SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from MyVault/Fizzy SECRET_KEY_BASE SMTP_PASSWORD VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY)
+# SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
+# SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD $SECRETS)
+# VAPID_PUBLIC_KEY=$(kamal secrets extract VAPID_PUBLIC_KEY $SECRETS)
+# VAPID_PRIVATE_KEY=$(kamal secrets extract VAPID_PRIVATE_KEY $SECRETS)
