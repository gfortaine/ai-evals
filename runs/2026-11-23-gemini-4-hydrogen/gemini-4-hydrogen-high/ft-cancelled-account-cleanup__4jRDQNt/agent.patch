diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..0e3759f 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,120 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  FILTER_JOIN_TABLES = %w[
+    assignees_filters
+    assigners_filters
+    boards_filters
+    closers_filters
+    creators_filters
+    filters_tags
+  ].freeze
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+
+    define_callbacks :incinerate
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def due_for_incineration?
+    cancelled? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+  end
+
+  def incinerate
+    return if destroyed?
+
+    run_callbacks :incinerate do
+      purge_attachments
+
+      transaction do
+        delete_search_records
+        delete_filters
+        delete_storage_totals
+        delete_account_scoped_records
+        delete
+      end
+    end
+  end
+
+  private
+    def purge_attachments
+      ActiveStorage::Attachment.where(account_id: id).in_batches.delete_all
+      ActiveStorage::VariantRecord.where(account_id: id).in_batches.delete_all
+      ActiveStorage::Blob.where(account_id: id).where.missing(:attachments).find_each(&:purge)
+    end
+
+    def delete_search_records
+      Search::Record.delete_for_account(id)
+    end
+
+    def delete_filters
+      Filter.where(account_id: id).in_batches do |batch|
+        subquery_sql = batch.select(:id).to_sql
+        FILTER_JOIN_TABLES.each do |table|
+          Filter.connection.delete("DELETE FROM #{table} WHERE filter_id IN (#{subquery_sql})")
+        end
+        batch.delete_all
+      end
+    end
+
+    def delete_storage_totals
+      Storage::Total.where(owner_type: "Account", owner_id: id).delete_all
+      Board.where(account_id: id).in_batches do |batch|
+        Storage::Total.where(owner_type: "Board", owner_id: batch.select(:id)).delete_all
+      end
+    end
+
+    def delete_account_scoped_records
+      account_scoped_models.each do |model|
+        model.where(account_id: id).in_batches.delete_all
+      end
+    end
+
+    def account_scoped_models
+      [
+        ActionText::RichText,
+        Search::Query,
+        Webhook::Delivery,
+        Webhook::DelinquencyTracker,
+        Webhook,
+        Notification,
+        Notification::Bundle,
+        Event,
+        Reaction,
+        Mention,
+        Step,
+        Assignment,
+        Tagging,
+        Closure,
+        Card::ActivitySpike,
+        Card::Goldness,
+        Card::NotNow,
+        Watch,
+        Pin,
+        Comment,
+        Card,
+        Board::Publication,
+        Access,
+        Column,
+        Board,
+        Tag,
+        Entropy,
+        Push::Subscription,
+        User::Settings,
+        Export,
+        Account::Import,
+        User,
+        Account::JoinCode,
+        Account::Cancellation,
+        Storage::Entry
+      ]
+    end
 end
