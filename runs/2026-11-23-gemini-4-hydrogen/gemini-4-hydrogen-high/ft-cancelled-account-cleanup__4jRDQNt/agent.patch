diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..368313c
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago and keeps others" do
+    due_account = accounts("37s")
+    recent_account = accounts(:initech)
+    active_account = accounts(:acme)
+
+    due_account.cancel(initiated_by: users(:david))
+    due_account.cancellation.update!(created_at: 31.days.ago)
+
+    recent_account.cancel(initiated_by: users(:mike))
+    recent_account.cancellation.update!(created_at: 29.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(recent_account.id)
+    assert Account.exists?(active_account.id)
+  end
+
+  test "is configured as a recurring job" do
+    config = ActiveSupport::ConfigurationFile.parse(Rails.root.join("config/recurring.yml"))
+    task = config.dig("production", "incinerate_due_accounts")
+
+    assert_not_nil task
+    assert_equal "Account::IncinerateDueJob", task["class"]
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..ac446ec
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,208 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @other_account = accounts(:initech)
+    stub_web_push_dns_resolution
+  end
+
+  test "due_for_incineration scope includes accounts cancelled more than 30 days ago" do
+    freeze_time do
+      @account.cancel(initiated_by: users(:david))
+      @account.cancellation.update!(created_at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.second).ago)
+
+      assert_includes Account.due_for_incineration, @account
+      assert @account.due_for_incineration?
+    end
+  end
+
+  test "due_for_incineration scope excludes accounts cancelled 30 days ago or less" do
+    freeze_time do
+      @account.cancel(initiated_by: users(:david))
+
+      @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago)
+      assert_not_includes Account.due_for_incineration, @account
+      assert_not @account.due_for_incineration?
+
+      @account.cancellation.update!(created_at: 29.days.ago)
+      assert_not_includes Account.due_for_incineration, @account
+      assert_not @account.due_for_incineration?
+    end
+  end
+
+  test "due_for_incineration scope excludes active and reactivated accounts" do
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.due_for_incineration?
+
+    @account.cancel(initiated_by: users(:david))
+    @account.cancellation.update!(created_at: 31.days.ago)
+    assert_includes Account.due_for_incineration, @account
+
+    @account.reactivate
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.reload.due_for_incineration?
+  end
+
+  test "incinerate permanently removes all account data and preserves global identities and other accounts" do
+    user = users(:david)
+    identity = user.identity
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    Current.with_account(@account) do
+      Current.user = user
+
+      # Attachments, variants, rich text embeds, and unattached blobs
+      user.avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+      user.avatar_thumbnail.processed
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+      embed_blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "embed.jpg",
+        content_type: "image/jpeg"
+      )
+      card.update!(description: "<p>Hello #{ActionText::Attachment.from_attachable(embed_blob).to_html}</p>")
+      board.update!(public_description: "<p>Public board</p>")
+      board.publish
+
+      comment = card.comments.create!(body: "<p>Comment body</p>", creator: user)
+      comment.reactions.create!(content: "👍", reacter: user)
+
+      card.steps.create!(content: "Step 1")
+      cards(:layout).postpone(user: user)
+      cards(:text).create_activity_spike!
+      card.close(user: user)
+
+      user.filters.create!(
+        boards: [ board ],
+        tags: [ tags(:web) ],
+        assignees: [ user ],
+        creators: [ user ],
+        closers: [ user ]
+      )
+
+      user.search_queries.create!(terms: "logo")
+      user.notification_bundles.create!(starts_at: 1.hour.ago, ends_at: Time.current)
+      user.push_subscriptions.create!(
+        endpoint: "https://fcm.googleapis.com/fcm/send/test-endpoint",
+        p256dh_key: "p256dh",
+        auth_key: "auth"
+      )
+
+      Account::Import.create!(identity: identity, account: @account)
+      User::DataExport.create!(account: @account, user: user)
+
+      # Unattached blob belonging to the account
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("orphan"),
+        filename: "orphan.txt",
+        content_type: "text/plain"
+      )
+
+      @account.materialize_storage
+      board.materialize_storage
+      @account.cancel(initiated_by: user)
+    end
+
+    account_id = @account.id
+    board_ids = @account.boards.ids
+    filter_ids = Filter.where(account_id: account_id).ids
+    blob_keys = ActiveStorage::Blob.where(account_id: account_id).pluck(:key)
+    assert blob_keys.any?
+    assert filter_ids.any?
+
+    other_card = Current.with_account(@other_account) do
+      boards(:miltons_wish_list).cards.create!(title: "Other account searchable", number: 99, status: "published", creator: users(:mike))
+    end
+
+    # Ensure search records, variant records, storage entries & totals exist
+    search_record_ids = Search::Record.for(account_id).where(account_id: account_id).ids
+    assert search_record_ids.any?
+    assert ActiveStorage::VariantRecord.where(account_id: account_id).exists?
+    assert Storage::Entry.where(account_id: account_id).exists?
+    assert Storage::Total.where(owner_type: "Account", owner_id: account_id).exists?
+    assert Storage::Total.where(owner_type: "Board", owner_id: board_ids).exists?
+
+    other_account_boards_count = @other_account.boards.count
+    other_account_users_count = @other_account.users.count
+    identity_sessions_count = identity.sessions.count
+
+    assert_no_enqueued_jobs(only: [ Storage::MaterializeJob, Board::CleanInaccessibleDataJob ]) do
+      @account.incinerate
+    end
+
+    # Account and all account-scoped records are gone
+    assert_not Account.exists?(account_id)
+    assert_empty Account::Cancellation.where(account_id: account_id)
+    assert_empty Account::JoinCode.where(account_id: account_id)
+    assert_empty Account::Import.where(account_id: account_id)
+    assert_empty Export.where(account_id: account_id)
+    assert_empty User.where(account_id: account_id)
+    assert_empty User::Settings.where(account_id: account_id)
+    assert_empty Push::Subscription.where(account_id: account_id)
+    assert_empty Board.where(account_id: account_id)
+    assert_empty Board::Publication.where(account_id: account_id)
+    assert_empty Access.where(account_id: account_id)
+    assert_empty Column.where(account_id: account_id)
+    assert_empty Tag.where(account_id: account_id)
+    assert_empty Entropy.where(account_id: account_id)
+    assert_empty Card.where(account_id: account_id)
+    assert_empty Card::ActivitySpike.where(account_id: account_id)
+    assert_empty Card::Goldness.where(account_id: account_id)
+    assert_empty Card::NotNow.where(account_id: account_id)
+    assert_empty Closure.where(account_id: account_id)
+    assert_empty Step.where(account_id: account_id)
+    assert_empty Assignment.where(account_id: account_id)
+    assert_empty Tagging.where(account_id: account_id)
+    assert_empty Watch.where(account_id: account_id)
+    assert_empty Pin.where(account_id: account_id)
+    assert_empty Comment.where(account_id: account_id)
+    assert_empty Reaction.where(account_id: account_id)
+    assert_empty Mention.where(account_id: account_id)
+    assert_empty Event.where(account_id: account_id)
+    assert_empty Notification.where(account_id: account_id)
+    assert_empty Notification::Bundle.where(account_id: account_id)
+    assert_empty Webhook.where(account_id: account_id)
+    assert_empty Webhook::Delivery.where(account_id: account_id)
+    assert_empty Webhook::DelinquencyTracker.where(account_id: account_id)
+    assert_empty Filter.where(account_id: account_id)
+    assert_empty Search::Query.where(account_id: account_id)
+    assert_empty Search::Record.for(account_id).where(account_id: account_id)
+    if Search::Record.connection.adapter_name == "SQLite"
+      assert_equal 0, Search::Record::SQLite::Fts.where(rowid: search_record_ids).count
+      other_search_record = Search::Record.find_by!(account_id: @other_account.id, searchable_id: other_card.id)
+      assert Search::Record::SQLite::Fts.exists?(rowid: other_search_record.id)
+    end
+    assert_empty ActionText::RichText.where(account_id: account_id)
+    assert_empty ActiveStorage::Attachment.where(account_id: account_id)
+    assert_empty ActiveStorage::VariantRecord.where(account_id: account_id)
+    assert_empty ActiveStorage::Blob.where(account_id: account_id)
+    assert_empty Storage::Entry.where(account_id: account_id)
+    assert_empty Storage::Total.where(owner_type: "Account", owner_id: account_id)
+    assert_empty Storage::Total.where(owner_type: "Board", owner_id: board_ids)
+
+    Account::Incineratable::FILTER_JOIN_TABLES.each do |join_table|
+      subquery = Filter.where(id: filter_ids).select(:id).to_sql
+      count = Filter.connection.select_value("SELECT COUNT(*) FROM #{join_table} WHERE filter_id IN (#{subquery})")
+      assert_equal 0, count, "Expected #{join_table} to be empty for incinerated account filters"
+    end
+
+    blob_keys.each do |key|
+      assert_not ActiveStorage::Blob.service.exist?(key), "Expected blob file #{key} to be purged from storage"
+    end
+
+    # Global identities and other accounts are untouched
+    assert Identity.exists?(identity.id)
+    assert_equal identity_sessions_count, identity.sessions.count
+    assert Account.exists?(@other_account.id)
+    assert_equal other_account_boards_count, @other_account.boards.count
+    assert_equal other_account_users_count, @other_account.users.count
+  end
+
+  test "incinerate is idempotent when called multiple times" do
+    @account.incinerate
+    assert_nothing_raised { @account.incinerate }
+  end
+end
