diff --git a/app/models/user/authoring.rb b/app/models/user/authoring.rb
index bc70db7..7b05006 100644
--- a/app/models/user/authoring.rb
+++ b/app/models/user/authoring.rb
@@ -3,8 +3,51 @@ module User::Authoring
 
   included do
     has_many :created_books, class_name: "Book", foreign_key: :creator_id,
-      inverse_of: :creator, dependent: :destroy
+      inverse_of: :creator
 
-    has_many :reading_marks
+    has_many :reading_marks, dependent: :delete_all
+
+    before_destroy :anonymize_or_destroy_created_books
+    after_destroy :purge_destroyed_book_blobs
   end
+
+  private
+    def anonymize_or_destroy_created_books
+      created_books.with_everyone_access.find_each do |book|
+        book.update!(creator: nil, author: "Deleted author")
+      end
+
+      private_books = created_books.where(everyone_access: false)
+      @destroyed_book_blob_ids = collect_blob_ids_for(private_books)
+      private_books.find_each(&:destroy!)
+    end
+
+    def purge_destroyed_book_blobs
+      return if @destroyed_book_blob_ids.blank?
+
+      ActiveStorage::Blob.where(id: @destroyed_book_blob_ids).find_each do |blob|
+        blob.purge if blob.attachments.none?
+      end
+    ensure
+      @destroyed_book_blob_ids = nil
+    end
+
+    def collect_blob_ids_for(books)
+      book_ids = books.pluck(:id)
+      return [] if book_ids.empty?
+
+      leaf_ids = Leaf.where(book_id: book_ids).pluck(:id)
+      leafable_pairs = Leaf.where(id: leaf_ids).pluck(:leafable_type, :leafable_id) +
+        Edit.where(leaf_id: leaf_ids).pluck(:leafable_type, :leafable_id)
+
+      picture_ids = leafable_pairs.filter_map { |type, id| id if type == "Picture" }.uniq
+      page_ids = leafable_pairs.filter_map { |type, id| id if type == "Page" }.uniq
+      markdown_ids = page_ids.any? ? ActionText::Markdown.where(record_type: "Page", record_id: page_ids).pluck(:id) : []
+
+      attachment_scope = ActiveStorage::Attachment.where(record_type: "Book", record_id: book_ids)
+      attachment_scope = attachment_scope.or(ActiveStorage::Attachment.where(record_type: "Picture", record_id: picture_ids)) if picture_ids.any?
+      attachment_scope = attachment_scope.or(ActiveStorage::Attachment.where(record_type: "ActionText::Markdown", record_id: markdown_ids)) if markdown_ids.any?
+
+      attachment_scope.distinct.pluck(:blob_id)
+    end
 end
