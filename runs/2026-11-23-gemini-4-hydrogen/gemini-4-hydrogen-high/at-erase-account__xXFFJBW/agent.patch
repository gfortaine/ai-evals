   private
+    DEACTIVATED_UUID_PATTERN = /(-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})+(?=@)/i
+
+    def erase_sign_in_events
