+    @export = @user.data_exports.create!(account: Current.account)
+    @export.build_later
+
+    respond_to do |format|
+      format.html { redirect_to @user, notice: "We're preparing your export. We'll email you a download link when it's ready." }
+      format.json { render json: { id: @export.id, status: @export.status }, status: :created }
+    end
+  end
+
+  def show
+    if !@export.accessible_to?(Current.user)
+      head :forbidden
+    elsif @export.expired?
+      respond_to do |format|
+        format.html { render "exports/expired", status: :gone, layout: "public" }
