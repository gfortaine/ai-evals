+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  test "unauthenticated user is redirected to login" do
+    get new_account_import_path(script_name: nil)
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "signed-in user can view /account/imports/new" do
+    sign_in_as :david
+
+    get new_account_import_path(script_name: nil)
+    assert_response :success
+    assert_select "form[action=?]", account_imports_path(script_name: nil)
+  end
+
+  test "signed-in user can import an account export and access the new account" do
+    account = accounts("37s")
+    export = Account::Export.create!(account: account, user: users(:kevin))
+    export.build_now
+
+    zip_tempfile = Tempfile.new([ "upload", ".zip" ])
+    zip_tempfile.binmode
+    zip_tempfile.write(export.file.download)
+    zip_tempfile.rewind
+
+    sign_in_as :mike # signed into initech, importing 37s
+    clear_enqueued_jobs
+
+    assert_difference -> { Account.count }, +1 do
+      perform_enqueued_jobs do
+        post account_imports_path(script_name: nil), params: {
+          account_import: {
+            file: Rack::Test::UploadedFile.new(zip_tempfile.path, "application/zip", true)
+          }
+        }
+        assert_response :redirect
+      end
+    end
+
+    import = Account::Import.order(:created_at).last
+    assert import.completed?
+    assert_not_nil import.account
+
+    email = ActionMailer::Base.deliveries.last
+    assert_not_nil email
+    assert_equal [ identities(:mike).email_address ], email.to
+    assert_match /complete/i, email.subject
+    assert_includes email.body.encoded, landing_url(script_name: import.account.slug, host: "example.com")
+
+    # Mike can open the newly imported account
+    get landing_path(script_name: import.account.slug)
+    follow_redirect!
+    assert_response :success
+  ensure
+    zip_tempfile&.close
+    zip_tempfile&.unlink
+  end
+
+  test "submitting without a file renders new with unprocessable_entity" do
+    sign_in_as :david
+
+    assert_no_difference "Account::Import.count" do
+      post account_imports_path(script_name: nil), params: {}
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "uploading invalid zip sends failure email and leaves nothing behind" do
+    sign_in_as :david
+    clear_enqueued_jobs
+
+    bad_file = Tempfile.new([ "bad", ".zip" ])
+    bad_file.write("corrupt data")
+    bad_file.rewind
+
+    assert_no_difference "Account.count" do
+      perform_enqueued_jobs do
+        post account_imports_path(script_name: nil), params: {
+          account_import: {
+            file: Rack::Test::UploadedFile.new(bad_file.path, "application/zip", true)
+          }
+        }
+        assert_response :redirect
+      end
+    end
+
+    import = Account::Import.order(:created_at).last
+    assert import.failed?
+    assert_nil import.account_id
+
+    email = ActionMailer::Base.deliveries.last
+    assert_not_nil email
+    assert_equal [ identities(:david).email_address ], email.to
+    assert_match /failed/i, email.subject
+    assert_includes email.body.encoded, import.error_message
+  ensure
+    bad_file&.close
+    bad_file&.unlink
+  end
+end
