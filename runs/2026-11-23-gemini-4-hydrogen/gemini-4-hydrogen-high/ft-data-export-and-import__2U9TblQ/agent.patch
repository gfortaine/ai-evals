diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..1f866b0
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @admin = users(:kevin)
+    @member = users(:david)
+  end
+
+  test "account settings shows export option to admin" do
+    sign_in_as @admin
+
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action=?]", account_exports_path
+  end
+
+  test "account settings hides export option from member" do
+    sign_in_as @member
+
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action=?]", account_exports_path, count: 0
+  end
+
+  test "admin can create account export and download via emailed link within 1 day" do
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    assert_enqueued_with job: ExportJob do
+      post account_exports_path
+    end
+    assert_redirected_to account_settings_path
+
+    export = Account::Export.order(:created_at).last
+    assert_equal @admin, export.user
+    assert_equal @account, export.account
+
+    perform_enqueued_jobs
+    perform_enqueued_jobs
+
+    email = ActionMailer::Base.deliveries.last
+    assert_not_nil email
+    assert_equal [ @admin.identity.email_address ], email.to
+    assert_includes email.body.encoded, account_export_url(export, script_name: @account.slug, host: "example.com")
+
+    # Valid within 1 day
+    get account_export_path(export)
+    assert_response :redirect
+    follow_redirect!
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_equal "application/zip", response.content_type
+  end
+
+  test "download link expires after 1 day" do
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    perform_enqueued_jobs do
+      post account_exports_path
+    end
+
+    export = Account::Export.order(:created_at).last
+
+    travel 25.hours do
+      get account_export_path(export)
+      assert_response :gone
+    end
+  end
+
+  test "non-admin member cannot create or download account export" do
+    sign_in_as @member
+
+    assert_no_difference "Export.count" do
+      post account_exports_path
+    end
+    assert_response :forbidden
+
+    export = Account::Export.create!(account: @account, user: @admin)
+    export.build_now
+
+    get account_export_path(export)
+    assert_response :forbidden
+  end
+
+  test "other admin cannot download another admin's export" do
+    export = Account::Export.create!(account: @account, user: users(:jason))
+    export.build_now
+
+    sign_in_as @admin
+    get account_export_path(export)
+    assert_response :forbidden
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..5835736
