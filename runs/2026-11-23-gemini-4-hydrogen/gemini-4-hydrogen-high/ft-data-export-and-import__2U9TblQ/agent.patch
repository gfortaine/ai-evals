+class Export < ApplicationRecord
+  EXPIRATION_TIME = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: "pending"
+
+  scope :expired, -> { where(completed_at: ...EXPIRATION_TIME.ago) }
+
+  def self.cleanup
+    expired.find_each(&:destroy)
+  end
+
+  def build_later
+    ExportJob.perform_later(self)
+  end
+
+  def build_now
+    processing!
+    ZipFile.create_for(file, filename: filename) do |zip|
+      populate_zip(zip)
+    end
+    update!(status: :completed, completed_at: Time.current)
+    notify_user
+  rescue StandardError
+    failed!
+    raise
+  end
+
+  def expired?
+    completed_at.present? && completed_at <= EXPIRATION_TIME.ago
+  end
+
+  def downloadable?
+    completed? && file.attached? && !expired?
+  end
+
+  def accessible_to?(user)
+    false
+  end
+
+  private
+    def filename
+      "fizzy-export-#{id}.zip"
+    end
+
+    def populate_zip(zip)
+      raise NotImplementedError
+    end
+
+    def notify_user
+      raise NotImplementedError
+    end
+end
