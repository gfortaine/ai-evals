+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  layout "public"
+
+  before_action :set_import, only: :show
+
+  def new
+    @import = Current.identity.account_imports.build
+  end
+
+  def create
+    @import = Current.identity.account_imports.build(import_params)
+
+    if @import.save
+      @import.process_later
+
+      respond_to do |format|
+        format.html { redirect_to account_import_path(@import, script_name: nil) }
+        format.json { render json: { id: @import.id, status: @import.status }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: { errors: @import.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def show
+  end
+
+  private
+    def set_import
+      @import = Current.identity.account_imports.find(params[:id])
+    end
+
+    def import_params
+      params.fetch(:account_import, {}).permit(:file)
+    end
+end
