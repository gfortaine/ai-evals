index 0000000..0c6e117
--- /dev/null
+++ b/test/models/user/data_export_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @david = users(:david)
+    @kevin = users(:kevin)
+    Current.account = @account
+    Current.user = @david
+  end
+
+  test "exports only cards the user can see with comments and all attached files" do
+    visible_card = cards(:logo)
+    visible_card.image.attach(io: file_fixture("moon.jpg").open, filename: "header.jpg", content_type: "image/jpeg")
+
+    desc_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("spec document bytes"),
+      filename: "spec.txt",
+      content_type: "text/plain"
+    )
+    visible_card.update!(description: "<p>See #{ActionText::Attachment.from_attachable(desc_blob).to_html}</p>")
+
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "header.jpg", # intentional duplicate filename on same card
+      content_type: "image/jpeg"
+    )
+    visible_card.comments.create!(
+      creator: @kevin,
+      body: "<p>Attached #{ActionText::Attachment.from_attachable(comment_blob).to_html}</p>"
+    )
+
+    # Card on a private board David cannot access
+    private_card = boards(:private).cards.create!(title: "Secret Card", creator: @kevin, status: :published)
+    # Drafted card on accessible board
+    draft_card = boards(:writebook).cards.create!(title: "Draft Card", creator: @kevin, status: :drafted)
+
+    export = @david.data_exports.create!(account: @account)
+
+    assert_enqueued_emails 1 do
+      export.build_now
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+
+    ZipFile.read_for(export.file) do |zip|
+      assert zip.exists?("cards/#{visible_card.number}.json")
+      assert_not zip.exists?("cards/#{private_card.number}.json")
+      assert_not zip.exists?("cards/#{draft_card.number}.json")
+
+      card_data = JSON.parse(zip.read("cards/#{visible_card.number}.json"))
+      assert_equal visible_card.title, card_data["title"]
+      assert_equal visible_card.number, card_data["number"]
+      assert_not_nil card_data["image"]
+      assert zip.exists?(card_data["image"]["path"])
+      assert_equal file_fixture("moon.jpg").binread, zip.read(card_data["image"]["path"])
+
+      assert_equal 1, card_data["attachments"].size
+      desc_attachment = card_data["attachments"].first
+      assert_equal "spec.txt", desc_attachment["filename"]
+      assert_equal "spec document bytes", zip.read(desc_attachment["path"])
+
+      exported_comment = card_data["comments"].find { |c| c["attachments"].any? }
+      assert_not_nil exported_comment
+      comment_attachment = exported_comment["attachments"].first
+      assert_equal "header.jpg", comment_attachment["filename"]
+      assert_not_equal card_data["image"]["path"], comment_attachment["path"]
+      assert_equal file_fixture("moon.jpg").binread, zip.read(comment_attachment["path"])
+    end
+  end
+  test "exports cleanly when user has no accessible cards" do
+    @david.accesses.destroy_all
+    export = @david.data_exports.create!(account: @account)
+
+    assert_enqueued_emails 1 do
+      export.build_now
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+
+    ZipFile.read_for(export.file) do |zip|
+      assert_empty zip.entries
+    end
+  end
+end
