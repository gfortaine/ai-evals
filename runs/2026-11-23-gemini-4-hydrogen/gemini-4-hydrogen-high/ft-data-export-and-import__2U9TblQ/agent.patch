+class Account::DataTransfer::Context
+  attr_reader :identity, :id_map, :blob_info, :uploaded_keys
+  attr_accessor :account
+
+  def initialize(identity:)
+    @identity = identity
+    @account = nil
+    @id_map = Hash.new do |hash, key|
+      hash[key] = ActiveRecord::Type::Uuid.generate if key.present?
+    end
+    @blob_info = {}
+    @uploaded_keys = []
+  end
+
+  def cleanup_on_failure
+    uploaded_keys.each do |key|
+      ::ActiveStorage::Blob.service.delete(key)
+    rescue StandardError
+      # Best-effort cleanup of uploaded files
+    end
+  end
+end
