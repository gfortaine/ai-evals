@@ -1,4 +1,101 @@
 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    Current.account = @account
+    Current.user = @user
+  end
+
+  test "export adds portable gid and import remaps user mentions and blob embeds across instances" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    mention_html = %(<action-text-attachment sgid="#{@user.attachable_sgid}" content-type="application/vnd.actiontext.mention"><img title="#{@user.name}" src="/#{@account.external_account_id}/users/#{@user.id}/avatar" width="48" height="48">#{@user.first_name}</action-text-attachment>)
+    blob_html = ActionText::Attachment.from_attachable(blob).to_html
+    @card.update!(description: "<p>Hello #{mention_html} and #{blob_html}</p>")
+
+    tempfile = Tempfile.new([ "rich-text-test", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(@account).export(to: writer)
+    writer.close
+
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+    exported_json = JSON.parse(reader.read("action_text_rich_texts/000001.json"))
+    exported_rt = exported_json.find { |r| r["record_id"] == @card.id && r["name"] == "description" }
+    assert_not_nil exported_rt
+
+    exported_fragment = Nokogiri::HTML::DocumentFragment.parse(exported_rt["body"])
+    gids = exported_fragment.css("action-text-attachment").map { |n| n["gid"] }
+    assert_includes gids, @user.to_global_id.to_s
+    assert_includes gids, blob.to_global_id.to_s
+
+    # Simulate an export from another instance whose sgid cannot be verified with our secret_key_base
+    tampered_rows = exported_json.map do |row|
+      next row unless row["id"] == exported_rt["id"]
+      frag = Nokogiri::HTML::DocumentFragment.parse(row["body"])
+      frag.css("action-text-attachment").each { |n| n["sgid"] = "invalid-foreign-sgid--deadbeef" }
+      row.merge("body" => frag.to_html)
+    end
+
+    import_zip = Tempfile.new([ "rich-text-import", ".zip" ])
+    import_zip.binmode
+    w2 = ZipFile::Writer.new(import_zip)
+    w2.add_file("action_text_rich_texts/000001.json", tampered_rows.to_json)
+    w2.close
+    import_zip.rewind
+
+    new_account = Account.create!(name: "Imported 37s")
+    context = Account::DataTransfer::Context.new(identity: identities(:david))
+    context.account = new_account
+
+    new_user = new_account.users.create!(
+      id: context.id_map[@user.id],
+      identity: identities(:david),
+      name: @user.name,
+      role: :owner
+    )
+    new_blob = ActiveStorage::Blob.create!(
+      id: context.id_map[blob.id],
+      account: new_account,
+      key: ActiveStorage::Blob.generate_unique_secure_token,
+      filename: blob.filename.to_s,
+      content_type: blob.content_type,
+      byte_size: blob.byte_size,
+      checksum: blob.checksum,
+      service_name: ActiveStorage::Blob.service.name.to_s
+    )
+    new_card_id = context.id_map[@card.id]
+
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(nil).import(from: ZipFile::Reader.new(import_zip), context: context)
+
+    imported_rt = ActionText::RichText.find_by!(record_type: "Card", record_id: new_card_id, name: "description")
+    assert_equal new_account.id, imported_rt.account_id
+
+    imported_fragment = Nokogiri::HTML::DocumentFragment.parse(imported_rt.body.to_html)
+    attachments = imported_fragment.css("action-text-attachment")
+    assert_equal 2, attachments.size
+    attachments.each { |n| assert_nil n["gid"] }
+
+    mention_node = attachments.find { |n| n["content-type"] == "application/vnd.actiontext.mention" }
+    assert_equal new_user.attachable_sgid, mention_node["sgid"]
+    assert_equal [ new_user, new_blob ], imported_rt.body.attachables
+
+    blob_node = attachments.find { |n| n["content-type"] == "image/jpeg" }
+    assert_equal new_blob.attachable_sgid, blob_node["sgid"]
+    assert_includes blob_node["url"], "/#{new_account.external_account_id}/rails/active_storage/blobs/redirect/"
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+    import_zip&.close
+    import_zip&.unlink
+  end
 end
