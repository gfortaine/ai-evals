+<% @page_title = "Import an account" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] || @import.errors.any? %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <%= form_with model: @import, url: account_imports_path(script_name: nil), scope: :account_import, class: "flex flex-column gap", data: { controller: "form", turbo: false } do |form| %>
+    <p class="margin-none">Select a Fizzy account export <code>.zip</code> file to create a new account with all of its boards, cards, comments, files, and people.</p>
+
+    <%= form.file_field :file, accept: ".zip,application/zip", direct_upload: true, required: true, class: "input full-width" %>
+
+    <% if @import.errors.any? %>
+      <div class="margin-block-half txt-negative txt-small" style="text-align: left;">
+        <p class="margin-block-none font-weight-bold">Your import couldn’t be started:</p>
+        <ul class="margin-block-none">
+          <% @import.errors.full_messages.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <button type="submit" class="btn btn--link center" data-form-target="submit">
+      <span>Import account</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
