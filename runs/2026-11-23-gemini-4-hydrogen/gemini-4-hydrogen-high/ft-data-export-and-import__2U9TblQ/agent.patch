+    assert_equal 4, reader.size_of("files/raw.bin")
+
+    reader.extract_to_tempfile("docs/guide.txt") do |extracted|
+      assert_equal "Guide content", extracted.read
+    end
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  test "remote_io reads zip from blob via download_chunk" do
+    tempfile = Tempfile.new([ "test", ".zip" ])
+    tempfile.binmode
+
+    large_payload = ("abcdef0123456789" * 1000)
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("a.json", '{"ok":true}', compress: true)
+    writer.add_file("b.bin", large_payload, compress: false)
+    writer.close
+
+    tempfile.rewind
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: tempfile,
+      filename: "archive.zip",
+      content_type: "application/zip"
+    )
+
+    io = ZipFile::RemoteIO.new(blob, chunk_size: 4096)
+    reader = ZipFile::Reader.new(io)
+
+    assert_equal '{"ok":true}', reader.read("a.json")
+    assert_equal large_payload, reader.read("b.bin")
+  ensure
+    tempfile&.close
+    tempfile&.unlink
   end
 end
