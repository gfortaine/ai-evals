+
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("docs/readme.txt", "Readme content", compress: true)
+    writer.add_file("docs/guide.txt", "Guide content", compress: true)
+    writer.add_file("files/raw.bin", "\x00\x01\x02\x03".b, compress: false)
+    writer.close
+
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+
+    assert_equal [ "docs/guide.txt", "docs/readme.txt" ], reader.glob("docs/*.txt")
