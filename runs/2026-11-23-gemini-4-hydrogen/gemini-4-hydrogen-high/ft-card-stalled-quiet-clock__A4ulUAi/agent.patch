+        assert_response :success
+        get cards_path
+        assert_response :success
+        assert_select "#bubble_card_#{card.id}[data-bubble-stalled-value]"
+      end
+
+      get cards_path
+      assert_response :success
+      assert_select "#bubble_card_#{card.id}[data-bubble-stalled-value]"
+
+      put card_path(card, format: :json), params: { card: { title: "Reset activity" } }
+      assert_response :success
+      get cards_path
+      assert_response :success
+      assert_select "#bubble_card_#{card.id}[data-bubble-stalled-value]", count: 0
+    end
+  end
 end
