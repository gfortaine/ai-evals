diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..27cfe50
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,265 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "card is stalled 2 weeks after a comment burst from at least two people within a third of the board auto-close period" do
+    card = create_published_card
+    card.board.update!(auto_postpone_period: 30.days)
+
+    travel_to 3.weeks.ago do
+      card.comments.create!(creator: users(:david), body: "First comment")
+      travel 4.days
+      card.comments.create!(creator: users(:kevin), body: "Second comment")
+      travel 5.days # 9 days total <= 10 days (1/3 of 30 days)
+      card.comments.create!(creator: users(:david), body: "Third comment")
+    end
+
+    assert_not card.reload.stalled?
+
+    # 9 days into the 3-week-ago timeline -> 12 days ago (< 2 weeks)
+    travel_to 1.day.from_now do
+      assert_not card.reload.stalled?
+      assert_not_includes Card.stalled, card
+    end
+
+    # 3 days later -> 15 days since last comment (>= 2 weeks)
+    travel_to 3.days.from_now do
+      assert card.reload.stalled?
+      assert_includes Card.stalled, card
+    end
+  end
+
+  test "comment burst uses account default auto-close period when board has no entropy override" do
+    card = create_published_card
+    entropies(:writebook_board).destroy!
+    entropies("37s_account").update!(auto_postpone_period: 30.days)
+
+    travel_to 4.weeks.ago do
+      card.comments.create!(creator: users(:david), body: "One")
+      travel 5.days
+      card.comments.create!(creator: users(:kevin), body: "Two")
+      travel 4.days # 9 days <= 10 days
+      card.comments.create!(creator: users(:david), body: "Three")
+    end
+
+    assert card.reload.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "three comments from a single person do not cause a burst" do
+    card = create_published_card
+    card.board.update!(auto_postpone_period: 30.days)
+
+    travel_to 3.weeks.ago do
+      card.comments.create!(creator: users(:david), body: "One")
+      card.comments.create!(creator: users(:david), body: "Two")
+      card.comments.create!(creator: users(:david), body: "Three")
+    end
+
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "three comments from two people spread beyond a third of auto-close period do not cause a burst" do
+    card = create_published_card
+    card.board.update!(auto_postpone_period: 30.days)
+
+    travel_to 4.weeks.ago do
+      card.comments.create!(creator: users(:david), body: "One")
+      travel 6.days
+      card.comments.create!(creator: users(:kevin), body: "Two")
+      travel 5.days # 11 days since first > 10 days (1/3 of 30 days)
+      card.comments.create!(creator: users(:david), body: "Three")
+    end
+
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "system comments do not count toward comment bursts" do
+    card = create_published_card
+    card.board.update!(auto_postpone_period: 30.days)
+
+    travel_to 3.weeks.ago do
+      card.comments.create!(creator: users(:david), body: "One")
+      card.comments.create!(creator: users(:kevin), body: "Two")
+      card.comments.create!(creator: accounts("37s").system_user, body: "System comment")
+    end
+
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "assigning someone to a card causes a burst and stalls after two weeks of inactivity" do
+    card = create_published_card
+
+    travel_to 2.weeks.ago - 1.minute do
+      card.toggle_assignment(users(:david))
+    end
+
+    assert card.reload.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "unassigning someone does not cause a burst" do
+    card = cards(:logo)
+    assert card.assigned_to?(users(:kevin))
+
+    travel_to 3.weeks.ago do
+      card.toggle_assignment(users(:kevin))
+    end
+
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "reopening a card causes a burst and stalls after two weeks of inactivity" do
+    card = cards(:shipping)
+    assert card.closed?
+
+    travel_to 2.weeks.ago - 1.minute do
+      card.reopen
+    end
+
+    assert card.reload.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "card is not stalled before two weeks have elapsed after a burst" do
+    card = create_published_card
+
+    travel_to 2.weeks.ago + 1.minute do
+      card.toggle_assignment(users(:david))
+    end
+
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "card without a burst is not stalled after two weeks of inactivity" do
+    card = create_published_card
+    card.update!(last_active_at: 3.weeks.ago)
+
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "any activity on a stalled card resets it and prevents re-stalling without a new burst" do
+    card = create_published_card
+
+    travel_to 3.weeks.ago do
+      card.toggle_assignment(users(:david))
+    end
+    assert card.reload.stalled?
+
+    # Non-burst comment resets it
+    card.comments.create!(creator: users(:kevin), body: "Any update?")
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+
+    # Two more weeks without activity -> still NOT stalled because burst was reset
+    travel 3.weeks do
+      assert_not card.reload.stalled?
+      assert_not_includes Card.stalled, card
+    end
+  end
+
+  test "activity before two weeks elapse resets the burst" do
+    card = create_published_card
+
+    travel_to 3.weeks.ago do
+      card.toggle_assignment(users(:david))
+    end
+
+    travel_to 2.weeks.ago - 1.day do
+      card.update!(title: "Updated title")
+    end
+
+    # Now at 2 weeks+ since the title change, should NOT be stalled
+    travel 1.week do
+      assert_not card.reload.stalled?
+      assert_not_includes Card.stalled, card
+    end
+  end
+
+  test "reactions, column moves, and unassignments reset stalled state" do
+    [
+      ->(card) { card.reactions.create!(content: "👍", reacter: users(:kevin)) },
+      ->(card) { card.triage_into(columns(:writebook_in_progress)) },
+      ->(card) { card.send_back_to_triage },
+      ->(card) { card.toggle_assignment(users(:david)) },
+      ->(card) { card.move_to(boards(:private)) }
+    ].each do |activity|
+      card = create_published_card
+      travel_to 3.weeks.ago do
+        card.toggle_assignment(users(:david))
+      end
+      assert card.reload.stalled?
+
+      activity.call(card)
+      assert_not card.reload.stalled?
+      assert_nil card.activity_spike
+
+      travel 3.weeks do
+        assert_not card.reload.stalled?
+      end
+    end
+  end
+
+  test "closing or postponing a card resets stalled state" do
+    card = create_published_card
+    travel_to 3.weeks.ago do
+      card.toggle_assignment(users(:david))
+    end
+    assert card.reload.stalled?
+
+    card.close
+    assert_not card.reload.stalled?
+    assert_nil card.activity_spike
+
+    card2 = create_published_card
+    travel_to 3.weeks.ago do
+      card2.toggle_assignment(users(:david))
+    end
+    assert card2.reload.stalled?
+
+    card2.postpone
+    assert_not card2.reload.stalled?
+    assert_nil card2.activity_spike
+  end
+
+  test "burst activity on a stalled card starts a fresh burst" do
+    card = create_published_card
+
+    travel_to 3.weeks.ago do
+      card.toggle_assignment(users(:david))
+    end
+    assert card.reload.stalled?
+
+    # Assign someone else -> resets old spike, records new spike, not stalled yet
+    card.toggle_assignment(users(:jz))
+    assert_not card.reload.stalled?
+    assert card.activity_spike.present?
+
+    travel 2.weeks + 1.minute do
+      assert card.reload.stalled?
+      assert_includes Card.stalled, card
+    end
+  end
+
+  test "drafted cards are never stalled" do
+    card = boards(:writebook).cards.create!(title: "Draft", creator: users(:david), status: :drafted, last_active_at: 3.weeks.ago)
+    card.remember_activity_spike
+
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  private
+    def create_published_card
+      boards(:writebook).cards.create!(title: "Test card", creator: users(:david), status: :published)
+    end
+end
