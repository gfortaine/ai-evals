diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..3b40b2d
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,70 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    has_one :activity_spike, dependent: :destroy, class_name: "Card::ActivitySpike"
+
+    scope :stalled, -> { active.joins(:activity_spike).where(cards: { last_active_at: ..STALLED_AFTER.ago }) }
+
+    after_update :reset_activity_spike, if: :last_active_at_advanced?
+  end
+
+  def stalled?
+    active? && activity_spike.present? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def stalled_at
+    if activity_spike.present? && active?
+      last_active_at + STALLED_AFTER
+    end
+  end
+
+  def days_stalled
+    if stalled?
+      ((Time.current - last_active_at) / 1.day).floor
+    else
+      0
+    end
+  end
+
+  def detect_activity_spikes_from_comment(comment)
+    if comment_burst_around?(comment)
+      remember_activity_spike
+    end
+  end
+
+  def detect_activity_spikes_from_event(event)
+    if event.action.card_assigned? || event.action.card_reopened?
+      remember_activity_spike
+    end
+  end
+
+  def remember_activity_spike
+    create_activity_spike! unless activity_spike.present?
+  rescue ActiveRecord::RecordNotUnique
+    association(:activity_spike).reload
+  end
+
+  def reset_activity_spike
+    if activity_spike.present?
+      activity_spike.destroy
+      association(:activity_spike).reset
+    end
+  end
+
+  private
+    def last_active_at_advanced?
+      saved_change_to_last_active_at? &&
+        last_active_at_before_last_save.present? &&
+        last_active_at > last_active_at_before_last_save
+    end
+
+    def comment_burst_around?(comment)
+      burst_window = (auto_postpone_period / 3.0).seconds
+      recent_comments = comments.by_user.where(comments: { created_at: (comment.created_at - burst_window)..comment.created_at })
+
+      recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+    end
+end
