+++ b/test/system/stalled_cards_test.rb
@@ -0,0 +1,42 @@
+require "application_system_test_case"
+
+class StalledCardsTest < ApplicationSystemTestCase
+  test "stalled card shows bubble wherever cards are shown and resets on activity" do
+    card = cards(:buy_domain)
+    travel_to 3.weeks.ago do
+      with_current_user(:david) { card.toggle_assignment(users(:david)) }
+    end
+
+    sign_in_as(users(:david))
+
+    # Cards index with indexed_by=stalled
+    visit cards_url(indexed_by: :stalled)
+    within "#article_card_#{card.id}" do
+      assert_selector "#bubble_card_#{card.id}:not([hidden])"
+      assert_text(/Stalled for/i)
+      assert_text "21"
+      assert_text(/days/i)
+    end
+
+    # Board view (Maybe? stream)
+    visit board_url(boards(:writebook))
+    within "#article_card_#{card.id}" do
+      assert_selector "#bubble_card_#{card.id}:not([hidden])"
+      assert_text(/Stalled for/i)
+    end
+
+    # Card show page
+    visit card_url(card)
+    assert_selector "#bubble_card_#{card.id}:not([hidden])"
+    assert_text(/Stalled for/i)
+    assert_text "21"
+    assert_text(/days/i)
+
+    # Activity on the card resets it
+    fill_in_lexxy with: "Picking this back up!"
+    click_on "Post"
+    assert_text "Picking this back up!"
+    assert_no_selector "#bubble_card_#{card.id}:not([hidden])"
+    assert_not card.reload.stalled?
+  end
+end
