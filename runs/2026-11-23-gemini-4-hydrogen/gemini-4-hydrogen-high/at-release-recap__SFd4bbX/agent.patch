diff --git a/test/controllers/books/releases_controller_test.rb b/test/controllers/books/releases_controller_test.rb
new file mode 100644
index 0000000..9bda734
--- /dev/null
+++ b/test/controllers/books/releases_controller_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    @book = books(:manual)
+    sign_in :david
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "releasing a book shows the released title and published status in recently updated" do
+    patch book_path(@book), params: { book: { title: "Working Title" } }
+    assert_redirected_to book_slug_path(@book)
+
+    patch book_release_path(@book), params: { book: { title: "Final Published Title", subtitle: "v1.0" } }
+    assert_redirected_to root_path
+
+    follow_redirect!
+    assert_response :success
+    assert_in_body "Recently updated"
+    assert_in_body "Final Published Title"
+    assert_in_body "Published"
+    assert_not_in_body "Working Title"
+  end
+
+  test "releasing an already published book redirects to book without modifying it" do
+    @book.update!(published: true)
+
+    patch book_release_path(@book), params: { book: { title: "Ignored Title" } }
+    assert_redirected_to book_slug_path(@book)
+    assert_equal "Manual", @book.reload.title
+  end
+
+  test "non-editor cannot release a book" do
+    sign_in :jz
+
+    patch book_release_path(@book), params: { book: { title: "Hacked Title" } }
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/book/recap_test.rb b/test/models/book/recap_test.rb
new file mode 100644
index 0000000..64e5f8b
--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "updating a book writes its recap" do
+    books(:handbook).update!(title: "Updated Handbook")
+
+    assert_equal({ title: "Updated Handbook", published: false }, books(:handbook).cached_recap)
+  end
+
+  test "saving one book never overwrites another book's recap" do
+    books(:handbook).update!(title: "Updated Handbook", published: true)
+    books(:manual).update!(title: "Updated Manual")
+
+    assert_equal({ title: "Updated Handbook", published: true }, books(:handbook).cached_recap)
+    assert_equal({ title: "Updated Manual", published: false }, books(:manual).cached_recap)
+  end
+
+  test "recaps expire on the configured schedule" do
+    books(:handbook).update!(title: "Updated Handbook")
+    assert_not_nil books(:handbook).cached_recap
+
+    travel Rails.application.config.x.recap.expires_in + 1.second do
+      assert_nil books(:handbook).cached_recap
+    end
+  end
+
+  test "updating separate instances of the same book in a transaction writes committed attributes" do
+    book = books(:manual)
+    marker = ReleaseMarker.for(book.id)
+
+    Book.transaction do
+      book.update!(title: "Published Manual")
+      marker.publish!
+    end
+
+    assert_equal({ title: "Published Manual", published: true }, book.cached_recap)
+  end
+end
diff --git a/test/models/book/release_test.rb b/test/models/book/release_test.rb
new file mode 100644
index 0000000..befe2ea
--- /dev/null
+++ b/test/models/book/release_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Book::ReleaseTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "finalize_release updates the book and writes the released title and published status to recap" do
+    book = books(:manual)
+    book.update!(title: "Working Title")
+
+    assert Book.finalize_release(book.id, title: "Final Manual", subtitle: "First Edition")
+
+    book.reload
+    assert_equal "Final Manual", book.title
+    assert_equal "First Edition", book.subtitle
+    assert book.published?
+    assert_equal({ title: "Final Manual", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release returns false for an already published book" do
+    book = books(:handbook)
+    book.update!(published: true)
+
+    assert_not Book.finalize_release(book.id, title: "Different Title")
+    assert_equal "Handbook", book.reload.title
+    assert_equal({ title: "Handbook", published: true }, book.cached_recap)
+  end
+end
