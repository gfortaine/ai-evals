diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..3bbbc63
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,293 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "container", "item" ]
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  connect() {
+    this.mediaQuery = window.matchMedia(this.desktopBreakpointValue)
+    this.handlePlatformChange = this.#updateDraggable.bind(this)
+    this.mediaQuery.addEventListener("change", this.handlePlatformChange)
+    this.#updateDraggable()
+  }
+
+  disconnect() {
+    this.mediaQuery?.removeEventListener("change", this.handlePlatformChange)
+    this.#resetDragState()
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = this.#isDesktop
+  }
+
+  refreshDraggable() {
+    this.#updateDraggable()
+  }
+
+  dragStart(event) {
+    if (!this.#isDesktop) return
+
+    const item = event.target.closest('[data-drag-and-drop-target~="item"]')
+    if (!item || !this.element.contains(item)) return
+
+    const sourceContainer = this.#containerFor(item)
+    if (!sourceContainer) return
+
+    this.draggedItem = item
+    this.sourceContainer = sourceContainer
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id || "card")
+
+    requestAnimationFrame(() => {
+      if (this.draggedItem === item) {
+        item.classList.add(this.draggedItemClass)
+      }
+    })
+  }
+
+  dragEnter(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#containerFor(event.target)
+    if (container && container !== this.sourceContainer) {
+      event.preventDefault()
+      this.#highlightContainer(container)
+    } else {
+      this.#clearHoveredContainer()
+    }
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#containerFor(event.target)
+    if (container && container !== this.sourceContainer) {
+      event.preventDefault()
+      if (event.dataTransfer) {
+        event.dataTransfer.dropEffect = "move"
+      }
+      this.#highlightContainer(container)
+    } else {
+      this.#clearHoveredContainer()
+    }
+  }
+
+  dragLeave(event) {
+    if (!this.draggedItem) return
+
+    if (event.target === document.documentElement || event.target === document || (event.relatedTarget && !this.element.contains(event.relatedTarget))) {
+      this.#clearHoveredContainer()
+    }
+  }
+
+  drop(event) {
+    if (!this.draggedItem) return
+
+    const targetContainer = this.#containerFor(event.target)
+    if (!targetContainer || targetContainer === this.sourceContainer) return
+
+    event.preventDefault()
+
+    const item = this.draggedItem
+    const sourceContainer = this.sourceContainer
+
+    this.#resetDragState()
+    this.#moveItem(item, sourceContainer, targetContainer)
+  }
+
+  dragEnd() {
+    this.#resetDragState()
+  }
+
+  // Private
+
+  get #isDesktop() {
+    return this.mediaQuery?.matches ?? false
+  }
+
+  #updateDraggable() {
+    const draggable = this.#isDesktop
+    this.itemTargets.forEach(item => {
+      item.draggable = draggable
+    })
+  }
+
+  #containerFor(element) {
+    const container = element?.closest?.('[data-drag-and-drop-target~="container"]')
+    if (container && this.containerTargets.includes(container)) {
+      return container
+    }
+    return null
+  }
+
+  #highlightContainer(container) {
+    if (this.hoveredContainer === container) return
+
+    this.#clearHoveredContainer()
+    this.hoveredContainer = container
+    container.classList.add(this.hoverContainerClass)
+  }
+
+  #clearHoveredContainer() {
+    if (this.hoveredContainer) {
+      this.hoveredContainer.classList.remove(this.hoverContainerClass)
+      this.hoveredContainer = null
+    }
+  }
+
+  #resetDragState() {
+    this.#clearHoveredContainer()
+    if (this.draggedItem) {
+      this.draggedItem.classList.remove(this.draggedItemClass)
+      this.draggedItem = null
+    }
+    this.sourceContainer = null
+  }
+
+  async #moveItem(item, sourceContainer, targetContainer) {
+    const snapshot = this.#captureSnapshot(item)
+
+    this.#insertItem(item, targetContainer)
+    item.removeAttribute("aria-selected")
+    if (document.activeElement && item.contains(document.activeElement)) {
+      document.activeElement.blur()
+    }
+    this.#updateItemAppearance(item, targetContainer)
+    this.#adjustCount(sourceContainer, -1)
+    this.#adjustCount(targetContainer, +1)
+
+    const response = await this.#persistMove(item, targetContainer)
+    if (!response?.ok) {
+      this.#restoreSnapshot(item, snapshot, sourceContainer, targetContainer)
+    }
+  }
+
+  #insertItem(item, targetContainer) {
+    const list = targetContainer.querySelector(".cards__list")
+    if (!list) return
+
+    const cards = Array.from(list.querySelectorAll(".card"))
+    if (cards.length === 0) {
+      list.prepend(item)
+      return
+    }
+
+    const sortsGoldenFirst = this.#sortsGoldenFirst(targetContainer)
+    const isGolden = item.classList.contains("golden-effect")
+
+    if (!sortsGoldenFirst || isGolden) {
+      cards[0].before(item)
+    } else {
+      const lastGolden = cards.findLast(card => card.classList.contains("golden-effect"))
+      if (lastGolden) {
+        lastGolden.after(item)
+      } else {
+        cards[0].before(item)
+      }
+    }
+  }
+
+  #sortsGoldenFirst(container) {
+    const kind = container.dataset.dragAndDropKind
+    return kind !== "not_now" && kind !== "closed"
+  }
+
+  #updateItemAppearance(item, targetContainer) {
+    const kind = targetContainer.dataset.dragAndDropKind
+
+    if (kind === "not_now") {
+      item.classList.remove("card--active")
+      item.classList.add("card--postponed")
+      item.style.setProperty("--card-color", "var(--color-card-complete)")
+    } else if (kind === "closed") {
+      item.classList.remove("card--active", "card--postponed")
+      item.style.setProperty("--card-color", "var(--color-card-complete)")
+    } else {
+      item.classList.add("card--active")
+      item.classList.remove("card--postponed")
+      item.querySelector(".card__closed")?.remove()
+      const color = targetContainer.style.getPropertyValue("--card-color") || "var(--color-card-default)"
+      item.style.setProperty("--card-color", color)
+    }
+
+    item.querySelector(".bubble")?.remove()
+  }
+
+  #adjustCount(container, delta) {
+    const countElement = container.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const text = countElement.textContent.trim()
+    if (text === "99+") return
+
+    const current = parseInt(text, 10)
+    if (Number.isNaN(current)) return
+
+    const next = Math.max(0, current + delta)
+    countElement.textContent = next > 99 ? "99+" : String(next)
+  }
+
+  async #persistMove(item, targetContainer) {
+    try {
+      const kind = targetContainer.dataset.dragAndDropKind
+      if (kind === "not_now") {
+        return await post(item.dataset.cardNotNowUrl, { responseKind: "json" })
+      } else if (kind === "closed") {
+        return await post(item.dataset.cardClosureUrl, { responseKind: "json" })
+      } else if (kind === "maybe") {
+        return await destroy(item.dataset.cardTriageUrl, { responseKind: "json" })
+      } else if (targetContainer.dataset.dragAndDropColumnId) {
+        return await post(item.dataset.cardTriageUrl, {
+          body: { column_id: targetContainer.dataset.dragAndDropColumnId },
+          responseKind: "json"
+        })
+      }
+    } catch {
+      return null
+    }
+  }
+
+  #captureSnapshot(item) {
+    const stamp = item.querySelector(".card__closed")
+    const bubble = item.querySelector(".bubble")
+
+    return {
+      parent: item.parentElement,
+      nextSibling: item.nextElementSibling,
+      className: item.className,
+      cardColor: item.style.getPropertyValue("--card-color"),
+      stamp,
+      stampParent: stamp?.parentElement,
+      stampNextSibling: stamp?.nextElementSibling,
+      bubble,
+      bubbleParent: bubble?.parentElement,
+      bubbleNextSibling: bubble?.nextElementSibling
+    }
+  }
+
+  #restoreSnapshot(item, snapshot, sourceContainer, targetContainer) {
+    if (snapshot.parent) {
+      snapshot.parent.insertBefore(item, snapshot.nextSibling)
+    }
+    item.className = snapshot.className
+    if (snapshot.cardColor) {
+      item.style.setProperty("--card-color", snapshot.cardColor)
+    } else {
+      item.style.removeProperty("--card-color")
+    }
+    if (snapshot.stamp && snapshot.stampParent && !item.contains(snapshot.stamp)) {
+      snapshot.stampParent.insertBefore(snapshot.stamp, snapshot.stampNextSibling)
+    }
+    if (snapshot.bubble && snapshot.bubbleParent && !item.contains(snapshot.bubble)) {
+      snapshot.bubbleParent.insertBefore(snapshot.bubble, snapshot.bubbleNextSibling)
+    }
+
+    this.#adjustCount(sourceContainer, +1)
+    this.#adjustCount(targetContainer, -1)
+  }
+}
