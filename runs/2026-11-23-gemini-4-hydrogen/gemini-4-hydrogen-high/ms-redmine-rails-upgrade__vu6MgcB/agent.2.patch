+      expires_at: 30.days.from_now,
+      url_safe: true
+    )
+    assert_equal({'user_id' => user.id, 'issue_id' => issue.id}, Mailer.verify_mail_link(urlsafe_token, :unwatch))
+
+    expired_token = build_rails72_mail_link_token(
+      sha256_secret,
+      {'user_id' => user.id, 'issue_id' => issue.id},
+      purpose: :unwatch,
+      expires_at: 1.minute.ago
+    )
+    assert_raises(ActiveSupport::MessageVerifier::InvalidSignature) do
+      Mailer.verify_mail_link(expired_token, :unwatch)
+    end
+
+    wrong_purpose_token = build_rails72_mail_link_token(
+      sha256_secret,
+      {'user_id' => user.id, 'issue_id' => issue.id},
+      purpose: :other,
+      expires_at: 30.days.from_now
+    )
+    assert_raises(ActiveSupport::MessageVerifier::InvalidSignature) do
+      Mailer.verify_mail_link(wrong_purpose_token, :unwatch)
+    end
+
+    tampered_token = urlsafe_token + 'tamper'
+    assert_raises(ActiveSupport::MessageVerifier::InvalidSignature) do
+      Mailer.verify_mail_link(tampered_token, :unwatch)
+    end
+  end
+
+  def test_generated_mail_link_token_uses_legacy_envelope_for_rollback_and_forward_compat
+    token = Mailer.mail_link_token(:unwatch, 'user_id' => 3, 'issue_id' => 2)
+    encoded_data = token.split('--').first
+    envelope = ActiveSupport::JSON.decode(Base64.strict_decode64(encoded_data))
+
+    assert envelope.key?('_rails')
+    assert envelope['_rails'].key?('message'), 'Release 1 (Rails 6.1) requires legacy _rails.message envelope on rollback'
+    assert_equal 'unwatch', envelope['_rails']['pur']
+  end
