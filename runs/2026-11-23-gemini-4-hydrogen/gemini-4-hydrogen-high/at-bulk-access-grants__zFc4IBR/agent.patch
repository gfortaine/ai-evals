diff --git a/app/models/book/access_import.rb b/app/models/book/access_import.rb
index 4d920cf..06f918a 100644
--- a/app/models/book/access_import.rb
+++ b/app/models/book/access_import.rb
@@ -6,20 +6,63 @@ class Book::AccessImport
   end
 
   def import
-    accesses = []
-    duplicate_index = nil
-
-    Access.transaction do
-      @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
-      rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
-      end
+    grants = @grants.to_a
+    return Result.new([], nil) if grants.empty?
+
+    if (invalid_index = first_invalid_index(grants))
+      return Result.new([], invalid_index)
+    end
+
+    rows = grants.map do |grant|
+      { user_id: cast_user_id(grant[:user_id]), level: grant[:level].to_s }
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
+    accesses = insert_accesses(rows, grants)
+    return Result.new([], duplicate_index_from_db(grants)) unless accesses
+
+    accesses.each do |access|
+      Book::AccessNotificationJob.perform_later(access)
+    end
+
+    Result.new(accesses, nil)
   end
+
+  private
+    def first_invalid_index(grants)
+      user_ids = grants.filter_map { |grant| cast_user_id(grant[:user_id]) }.uniq
+      existing_user_ids = user_ids.empty? ? Set.new : @book.accesses.where(user_id: user_ids).pluck(:user_id).to_set
+      seen_user_ids = Set.new
+
+      grants.each_with_index do |grant, index|
+        return index unless Access.levels.key?(grant[:level].to_s)
+
+        user_id = cast_user_id(grant[:user_id])
+        return index if user_id && (existing_user_ids.include?(user_id) || !seen_user_ids.add?(user_id))
+      end
+
+      nil
+    end
+
+    def insert_accesses(rows, grants)
+      ids = nil
+
+      Access.transaction(requires_new: true) do
+        ids = @book.accesses.insert_all!(rows).rows.flatten
+      end
+
+      accesses_by_user_id = @book.accesses.where(id: ids).index_by(&:user_id)
+      grants.map { |grant| accesses_by_user_id.fetch(cast_user_id(grant[:user_id])) }
+    rescue ActiveRecord::RecordNotUnique
+      nil
+    end
+
+    def duplicate_index_from_db(grants)
+      user_ids = grants.filter_map { |grant| cast_user_id(grant[:user_id]) }.uniq
+      existing_user_ids = @book.accesses.where(user_id: user_ids).pluck(:user_id).to_set
+      grants.index { |grant| existing_user_ids.include?(cast_user_id(grant[:user_id])) }
+    end
+
+    def cast_user_id(user_id)
+      Access.type_for_attribute(:user_id).cast(user_id)
+    end
 end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..1ba8059
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,200 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "imports grants, returns persisted accesses in order, and notifies each person" do
+    book = Book.create!(title: "Fresh Book", everyone_access: false)
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: "editor" }
+    ]
+
+    result = nil
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, grants).import
+    end
+
+    assert_instance_of Book::AccessImport::Result, result
+    assert_nil result.duplicate_index
+    assert_equal 2, result.accesses.size
+    assert_equal [ users(:kevin).id, users(:jz).id ], result.accesses.map(&:user_id)
+    assert_equal %w[ reader editor ], result.accesses.map(&:level)
+    assert result.accesses.all?(&:persisted?)
+    assert_equal 2, book.accesses.count
+
+    result.accesses.each do |access|
+      assert_enqueued_with(job: Book::AccessNotificationJob, args: [ access ])
+    end
+  end
+
+  test "returns empty accesses and nil duplicate_index for empty grants" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs do
+      result = Book::AccessImport.new(book, []).import
+      assert_equal [], result.accesses
+      assert_nil result.duplicate_index
+    end
+  end
+
+  test "rejects duplicate within grants without creating accesses or notifying anyone" do
+    book = Book.create!(title: "Fresh Book", everyone_access: false)
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :editor },
+      { user_id: users(:kevin).id, level: :editor }
+    ]
+
+    assert_no_difference -> { book.accesses.count } do
+      assert_no_enqueued_jobs do
+        result = Book::AccessImport.new(book, grants).import
+        assert_equal [], result.accesses
+        assert_equal 2, result.duplicate_index
+      end
+    end
+  end
+
+  test "rejects duplicate against existing book access without creating accesses or notifying anyone" do
+    book = books(:manual)
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :editor }
+    ]
+
+    assert_no_difference -> { book.accesses.count } do
+      assert_no_enqueued_jobs do
+        result = Book::AccessImport.new(book, grants).import
+        assert_equal [], result.accesses
+        assert_equal 1, result.duplicate_index
+      end
+    end
+  end
+
+  test "rejects unknown, nil, or blank level like any other bad row without blowing up or notifying" do
+    [ :owner, "admin", nil, "" ].each do |bad_level|
+      book = Book.create!(title: "Fresh Book", everyone_access: false)
+      grants = [
+        { user_id: users(:kevin).id, level: :reader },
+        { user_id: users(:jz).id, level: bad_level },
+        { user_id: users(:david).id, level: :editor }
+      ]
+
+      assert_no_difference -> { book.accesses.count } do
+        assert_no_enqueued_jobs do
+          result = Book::AccessImport.new(book, grants).import
+          assert_equal [], result.accesses
+          assert_equal 1, result.duplicate_index
+        end
+      end
+    end
+  end
+
+  test "returns index of first bad row when both duplicate and unknown level exist" do
+    book = books(:manual)
+
+    result_unknown_first = Book::AccessImport.new(book, [
+      { user_id: users(:kevin).id, level: :bogus },
+      { user_id: users(:jz).id, level: :reader }
+    ]).import
+    assert_equal [], result_unknown_first.accesses
+    assert_equal 0, result_unknown_first.duplicate_index
+
+    result_duplicate_first = Book::AccessImport.new(book, [
+      { user_id: users(:jz).id, level: :reader },
+      { user_id: users(:kevin).id, level: :bogus }
+    ]).import
+    assert_equal [], result_duplicate_first.accesses
+    assert_equal 0, result_duplicate_first.duplicate_index
+  end
+
+  test "sixteen grants cost the same database round trips as four when accepted" do
+    users = 16.times.map do |i|
+      User.create!(
+        name: "Scale Accept #{i}",
+        email_address: "scale-accept-#{i}@example.com",
+        password: "password123456",
+        role: :member
+      )
+    end
+
+    book_four = Book.create!(title: "Four Book", everyone_access: false)
+    book_sixteen = Book.create!(title: "Sixteen Book", everyone_access: false)
+
+    four_grants = users.first(4).map { |user| { user_id: user.id, level: :reader } }
+    sixteen_grants = users.map { |user| { user_id: user.id, level: :reader } }
+
+    four_queries = capture_non_transaction_queries do
+      result = Book::AccessImport.new(book_four, four_grants).import
+      assert_equal 4, result.accesses.size
+    end
+
+    sixteen_queries = capture_non_transaction_queries do
+      result = Book::AccessImport.new(book_sixteen, sixteen_grants).import
+      assert_equal 16, result.accesses.size
+    end
+
+    assert_equal four_queries.size, sixteen_queries.size
+    assert_equal four_queries.count { it.start_with?("INSERT") }, sixteen_queries.count { it.start_with?("INSERT") }
+  end
+
+  test "sixteen grants cost the same database round trips as four when rejected" do
+    users = 16.times.map do |i|
+      User.create!(
+        name: "Scale Reject #{i}",
+        email_address: "scale-reject-#{i}@example.com",
+        password: "password123456",
+        role: :member
+      )
+    end
+
+    book_four = Book.create!(title: "Four Reject Book", everyone_access: false)
+    book_sixteen = Book.create!(title: "Sixteen Reject Book", everyone_access: false)
+
+    four_bad = users.first(3).map { |user| { user_id: user.id, level: :reader } } +
+               [ { user_id: users.first.id, level: :editor } ]
+    sixteen_bad = users.first(15).map { |user| { user_id: user.id, level: :reader } } +
+                  [ { user_id: users.first.id, level: :editor } ]
+
+    four_queries = capture_non_transaction_queries do
+      result = Book::AccessImport.new(book_four, four_bad).import
+      assert_equal 3, result.duplicate_index
+    end
+
+    sixteen_queries = capture_non_transaction_queries do
+      result = Book::AccessImport.new(book_sixteen, sixteen_bad).import
+      assert_equal 15, result.duplicate_index
+    end
+
+    assert_equal four_queries.size, sixteen_queries.size
+    assert_equal 0, four_queries.count { it.start_with?("INSERT") }
+    assert_equal 0, sixteen_queries.count { it.start_with?("INSERT") }
+  end
+
+  test "executes notification jobs cleanly after import" do
+    book = Book.create!(title: "Notify Book", everyone_access: false)
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :editor }
+    ]
+
+    perform_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, grants).import
+      assert_equal 2, result.accesses.size
+      assert_nil result.duplicate_index
+    end
+  end
+
+  private
+    def capture_non_transaction_queries(&block)
+      queries = []
+      callback = ->(_name, _start, _finish, _id, payload) {
+        next if payload[:name] == "SCHEMA" || payload[:name] == "TRANSACTION"
+        next if payload[:sql].start_with?("PRAGMA")
+
+        queries << payload[:sql]
+      }
+      ActiveSupport::Notifications.subscribed(callback, "sql.active_record", &block)
+      queries
+    end
+end
