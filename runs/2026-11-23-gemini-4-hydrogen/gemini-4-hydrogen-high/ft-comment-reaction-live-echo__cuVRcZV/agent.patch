@@ -0,0 +1,63 @@
+<%= turbo_frame_tag @comment, :new_reaction do %>
+  <div class="reaction reaction__form expanded" data-controller="morph-guard reaction-form">
+    <figure class="reaction__avatar flex-item-no-shrink" style="--avatar-size: auto;">
+      <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %>
+    </figure>
+
+    <%= form_with model: [ @card, @comment, @reaction ],
+          url: card_comment_reactions_path(@card, @comment),
+          class: "flex align-center gap-half",
+          data: {
+            controller: "form",
+            action: "submit->form#preventEmptySubmit submit->form#preventComposingSubmit keydown.esc->form#cancel:stop"
+          } do |form| %>
+      <label class="reaction__form-label flex align-center">
+        <%= form.text_field :content,
+              class: "reaction__input input txt-small",
+              maxlength: 16,
+              required: true,
+              autofocus: true,
+              autocomplete: "off",
+              placeholder: "React…",
+              aria: { label: "Reaction" },
+              data: {
+                form_target: "input",
+                reaction_form_target: "input",
+                "1p-ignore": "true",
+                action: "compositionstart->form#compositionStart compositionend->form#compositionEnd"
+              } %>
+      </label>
+
+      <div class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+        <button type="button" class="reaction__menu-btn btn btn--circle borderless" data-action="click->dialog#toggle:stop" aria-haspopup="true">
+          <%= icon_tag "reaction" %>
+          <span class="for-screen-reader">Pick an emoji</span>
+        </button>
+
+        <dialog class="reaction__popup popup panel shadow" data-dialog-target="dialog" data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
+          <div class="reaction__emoji-list">
+            <% EmojiHelper::REACTIONS.each do |emoji, title| %>
+              <button type="button" class="btn btn--circle borderless" title="<%= title %>"
+                      data-action="click->reaction-form#pickEmoji click->dialog#close"
+                      data-reaction-form-emoji-param="<%= emoji %>">
+                <%= emoji %>
+              </button>
+            <% end %>
+          </div>
+        </dialog>
+      </div>
+
+      <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle borderless" do %>
+        <%= icon_tag "check-circle" %>
+        <span class="for-screen-reader">Save reaction</span>
+      <% end %>
+
+      <%= link_to card_comment_reactions_path(@card, @comment),
+            class: "reaction__cancel-btn btn btn--circle borderless",
+            data: { form_target: "cancel" } do %>
+        <%= icon_tag "close-circle" %>
+        <span class="for-screen-reader">Cancel</span>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
