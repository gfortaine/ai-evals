diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..78149e5
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "validates presence and max length of content" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_not comment.reactions.build(content: "").valid?
+    assert_not comment.reactions.build(content: "   ").valid?
+    assert_not comment.reactions.build(content: "a" * 17).valid?
+
+    assert comment.reactions.build(content: "a" * 16).valid?
+    assert comment.reactions.build(content: "🔥").valid?
+  end
+
+  test "normalizes outer whitespace" do
+    reaction = comments(:logo_agreement_jz).reactions.create!(content: "  👍  ")
+    assert_equal "👍", reaction.content
+  end
+
+  test "all_emoji?" do
+    emoji_reaction = comments(:logo_agreement_jz).reactions.build(content: "🎉")
+    text_reaction = comments(:logo_agreement_jz).reactions.build(content: "Great 👍")
+
+    assert emoji_reaction.all_emoji?
+    assert_not text_reaction.all_emoji?
+  end
+
+  test "touches comment and card on create and destroy" do
+    comment = comments(:logo_agreement_jz)
+    card = comment.card
+
+    assert_changes -> { comment.reload.updated_at } do
+      assert_changes -> { card.reload.updated_at } do
+        @reaction = comment.reactions.create!(content: "🎉")
+      end
+    end
+
+    travel 1.second do
+      assert_changes -> { comment.reload.updated_at } do
+        assert_changes -> { card.reload.updated_at } do
+          @reaction.destroy!
+        end
+      end
+    end
+  end
+
+  test "broadcasts refresh to card on create and destroy" do
+    comment = comments(:logo_agreement_jz)
+    card = comment.card
+
+    assert_turbo_stream_broadcasts card, count: 1 do
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob do
+        @reaction = comment.reactions.create!(content: "🔥")
+      end
+    end
+
+    assert_turbo_stream_broadcasts card, count: 1 do
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob do
+        @reaction.destroy!
+      end
+    end
+  end
+
+  test "destroying comment destroys its reactions" do
+    comment = comments(:logo_agreement_jz)
+    reaction_ids = comment.reactions.pluck(:id)
+    assert_not_empty reaction_ids
+
+    comment.destroy!
+    assert_empty Reaction.where(id: reaction_ids)
+  end
+
+  test "invalidates comment cache key on create and destroy" do
+    comment = comments(:logo_agreement_jz)
+    initial_key = comment.cache_key_with_version
+
+    reaction = comment.reactions.create!(content: "✨")
+    assert_not_equal initial_key, comment.reload.cache_key_with_version
+
+    after_create_key = comment.cache_key_with_version
+    travel 1.second do
+      reaction.destroy!
+      assert_not_equal after_create_key, comment.reload.cache_key_with_version
+    end
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..7c6402b
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,210 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+    @other_comment = comments(:logo_agreement_kevin)
+  end
+
+  test "existing reactions show who left them and use emoji/text classes" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_selector ".reaction", text: "👍"
+      assert_selector ".reaction .reaction__avatar img[title='#{users(:kevin).name}']"
+      assert_selector ".reaction span.txt-small.txt-medium", text: "👍"
+    end
+
+    within "##{dom_id(@other_comment, :reactions)}" do
+      assert_selector ".reaction", text: "Nice!"
+      assert_selector ".reaction .reaction__avatar img[title='#{users(:jz).name}']"
+      assert_selector ".reaction span.txt-small:not(.txt-medium)", text: "Nice!"
+    end
+  end
+
+  test "adding, canceling, picking emoji, and adding another reaction" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      # Button turns into small input with confirm and cancel
+      find("a.reactions__trigger").click
+      assert_selector ".reaction__form"
+      assert_selector "input.reaction__input[maxlength='16']"
+      assert_selector "button.reaction__submit-btn"
+      assert_selector "a.reaction__cancel-btn"
+
+      # Cancel brings the button back without adding a reaction
+      find("a.reaction__cancel-btn").click
+      assert_no_selector ".reaction__form"
+      assert_selector "a.reactions__trigger"
+
+      # Open again, type text reaction, and confirm
+      find("a.reactions__trigger").click
+      find("input.reaction__input").fill_in with: "Ship it!"
+      find("button.reaction__submit-btn").click
+
+      # Reaction lands in strip, input is gone, button is back for the next one
+      assert_selector ".reactions__list .reaction", text: "Ship it!"
+      assert_no_selector ".reaction__form"
+      assert_selector "a.reactions__trigger"
+
+      # Open again, pick an emoji from the menu, and confirm
+      find("a.reactions__trigger").click
+      find("button.reaction__menu-btn").click
+      within ".reaction__emoji-list" do
+        find("button", text: "🎉").click
+      end
+      assert_equal "🎉", find("input.reaction__input").value
+      find("button.reaction__submit-btn").click
+
+      assert_selector ".reactions__list .reaction", text: "🎉"
+      assert_no_selector ".reaction__form"
+      assert_selector "a.reactions__trigger"
+    end
+  end
+
+  test "canceling reaction form with Escape key" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find("a.reactions__trigger").click
+      assert_selector ".reaction__form"
+
+      find("input.reaction__input").send_keys(:escape)
+      assert_no_selector ".reaction__form"
+      assert_selector "a.reactions__trigger"
+    end
+  end
+
+  test "clicking own reaction reveals delete button and removes it, while others' reactions cannot be deleted" do
+    visit card_url(@card)
+
+    # Own reaction
+    own_reaction = reactions(:kevin_thumbs_up)
+    within "##{dom_id(own_reaction)}" do
+      assert_no_selector "form.reaction__delete button", visible: true
+      find(".reaction__avatar").click
+      assert_selector "form.reaction__delete button", visible: true
+      find("form.reaction__delete button").click
+    end
+
+    assert_no_selector "##{dom_id(own_reaction)}"
+
+    # Another user's reaction
+    others_reaction = reactions(:jz_text)
+    within "##{dom_id(others_reaction)}" do
+      find(".reaction__avatar").click
+      assert_no_selector "form.reaction__delete button", visible: true
+    end
+  end
+
+  test "adding and deleting the only reaction on a comment without prior reactions" do
+    card = cards(:layout)
+    comment = comments(:layout_overflowing_david)
+    visit card_url(card)
+
+    within "##{dom_id(comment, :reactions)}" do
+      assert_no_selector ".reaction"
+      assert_selector "a.reactions__trigger img[src*='boost-color']"
+
+      find("a.reactions__trigger").click
+      assert_selector ".reaction__form"
+
+      # Empty submit should not create a reaction
+      find("button.reaction__submit-btn").click
+      assert_selector ".reaction__form"
+
+      find("input.reaction__input").fill_in with: "🙌"
+      find("button.reaction__submit-btn").click
+
+      assert_selector ".reactions__list .reaction", text: "🙌"
+      assert_no_selector ".reaction__form"
+      assert_selector "a.reactions__trigger"
+
+      # Check avatar renders as a square inside the reaction pill
+      avatar_rect = page.evaluate_script("document.querySelector('##{dom_id(comment, :reactions)} .reaction__avatar .avatar').getBoundingClientRect()")
+      assert_operator avatar_rect["width"], :>, 10
+      assert_in_delta avatar_rect["width"], avatar_rect["height"], 2.0
+
+      # Delete the reaction
+      find(".reactions__list .reaction .reaction__avatar").click
+      assert_selector "form.reaction__delete button", visible: true
+      find("form.reaction__delete button").click
+
+      assert_no_selector ".reactions__list .reaction"
+      assert_selector "a.reactions__trigger"
+    end
+  end
+
+  test "everyone looking at the card sees reactions land and disappear without reloading" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    # Create a reaction elsewhere as another user
+    new_reaction = @comment.reactions.create!(reacter: users(:david), content: "🔥")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_selector "##{dom_id(new_reaction)}", text: "🔥", wait: 5
+      assert_selector "##{dom_id(new_reaction)} .reaction__avatar img[title='#{users(:david).name}']"
+    end
+
+    # Destroy that reaction elsewhere
+    new_reaction.destroy!
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_no_selector "##{dom_id(new_reaction)}", wait: 5
+  end
+
+  test "broadcast refresh keeps own reaction deleteable and others non-deleteable" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    other_reaction = @comment.reactions.create!(reacter: users(:david), content: "👏")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_selector "##{dom_id(other_reaction)}", text: "👏", wait: 5
+
+      within "##{dom_id(other_reaction)}" do
+        find(".reaction__avatar").click
+        assert_no_selector "form.reaction__delete button", visible: true
+      end
+
+      within "##{dom_id(reactions(:kevin_thumbs_up))}" do
+        find(".reaction__avatar").click
+        assert_selector "form.reaction__delete button", visible: true
+      end
+    end
+  end
+
+  test "broadcast refresh preserves an in-progress reaction input" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find("a.reactions__trigger").click
+      find("input.reaction__input").fill_in with: "Draft"
+    end
+
+    # Another user adds a reaction to the same comment
+    other_reaction = @comment.reactions.create!(reacter: users(:david), content: "👀")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_selector "##{dom_id(other_reaction)}", text: "👀", wait: 5
+      assert_selector ".reaction__form input.reaction__input"
+      assert_equal "Draft", find("input.reaction__input").value
+    end
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
