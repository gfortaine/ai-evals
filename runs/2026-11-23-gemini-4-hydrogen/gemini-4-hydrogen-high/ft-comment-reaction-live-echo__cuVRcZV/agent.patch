@@ -0,0 +1,171 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "new renders reaction form inside turbo frame" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+
+    get new_card_comment_reaction_path(card, comment)
+
+    assert_response :success
+    assert_select "turbo-frame#new_reaction_comment_#{comment.id}" do
+      assert_select ".reaction.reaction__form.expanded"
+      assert_select "input.reaction__input[maxlength='16']"
+      assert_select "button.reaction__submit-btn"
+      assert_select "a.reaction__cancel-btn"
+    end
+  end
+
+  test "index as HTML restores reaction trigger inside turbo frame" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+
+    get card_comment_reactions_path(card, comment)
+
+    assert_response :success
+    assert_select "turbo-frame#new_reaction_comment_#{comment.id}" do
+      assert_select "a.reactions__trigger"
+    end
+  end
+
+  test "index as JSON" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+
+    get card_comment_reactions_path(card, comment), as: :json
+
+    assert_response :success
+    body = @response.parsed_body
+    assert_equal comment.reactions.count, body.size
+    assert_equal "👍", body.first["content"]
+    assert_equal users(:kevin).id, body.first.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(card, comment, reactions(:kevin_thumbs_up)), body.first["url"]
+  end
+
+  test "create as turbo_stream" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "🔥" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :append, target: dom_id(comment, :reactions_list)
+    assert_turbo_stream action: :update, target: dom_id(comment, :new_reaction)
+  end
+
+  test "create as JSON" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
+    reaction = comment.reactions.last
+    assert_equal card_comment_reaction_path(card, comment, reaction, format: :json), @response.headers["Location"]
+    assert_equal "Great 👍", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+  end
+
+  test "create as JSON with flat params" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(card, comment), params: { content: "LGTM" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "LGTM", comment.reactions.last.content
+  end
+
+  test "create with invalid content returns unprocessable" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "a" * 17 } }, as: :json
+    end
+    assert_response :unprocessable_entity
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "   " } }, as: :json
+    end
+    assert_response :unprocessable_entity
+  end
+
+  test "create on draft card is forbidden" do
+    draft_card = boards(:writebook).cards.create!(status: :drafted, creator: users(:kevin))
+    # Insert a comment directly to test the guard
+    draft_card.update_column(:status, "published")
+    comment = draft_card.comments.create!(creator: users(:kevin), body: "Hello")
+    draft_card.update_column(:status, "drafted")
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(draft_card, comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy own reaction as turbo_stream" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+    reaction = reactions(:kevin_thumbs_up)
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "destroy own reaction as JSON" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+    reaction = reactions(:kevin_thumbs_up)
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(card, comment, reaction), as: :json
+    end
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "cannot destroy another user's reaction" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+    reaction = reactions(:jz_text)
+
+    assert_no_difference -> { comment.reactions.count } do
+      delete card_comment_reaction_path(card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+    assert Reaction.exists?(reaction.id)
+  end
+
+  test "cannot react to comment on inaccessible card" do
+    card = boards(:private).cards.create!(creator: users(:kevin), title: "Private card")
+    comment = with_current_user(:kevin) do
+      card.publish
+      card.comments.create!(creator: users(:kevin), body: "Secret")
+    end
+
+    logout_and_sign_in_as :jz
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :not_found
+  end
+end
