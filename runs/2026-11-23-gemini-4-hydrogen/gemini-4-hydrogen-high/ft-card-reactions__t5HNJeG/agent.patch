diff --git a/test/system/card_reactions_test.rb b/test/system/card_reactions_test.rb
new file mode 100644
index 0000000..798b52b
--- /dev/null
+++ b/test/system/card_reactions_test.rb
@@ -0,0 +1,71 @@
+require "application_system_test_case"
+
+class CardReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:text)
+  end
+
+  test "reacting to a card from its detail view and showing boost count in board column preview" do
+    visit board_url(@card.board)
+    ensure_column_expanded(@card.column)
+
+    within("##{dom_id(@card, :article)}") do
+      assert_no_selector ".card__boosts"
+    end
+
+    visit card_url(@card)
+
+    within("##{dom_id(@card, :reacting)}") do
+      click_on "Add your own reaction"
+      click_on "Cancel"
+      assert_no_selector "form.reaction__form"
+
+      click_on "Add your own reaction"
+      fill_in "reaction[content]", with: "Ship it!"
+      click_on "Submit"
+
+      assert_selector ".reaction", text: "Ship it!"
+
+      click_on "Add your own reaction"
+      find(".reaction__menu-btn").click
+      assert_selector "dialog.reaction__popup[open]"
+      find(".reaction__emoji-btn[data-emoji='🎉']").click
+      click_on "Submit"
+
+      assert_selector ".reaction", text: "🎉"
+    end
+
+    visit board_url(@card.board)
+    ensure_column_expanded(@card.column)
+
+    within("##{dom_id(@card, :article)}") do
+      assert_selector ".card__boosts", text: "2"
+    end
+
+    visit card_url(@card)
+
+    within("##{dom_id(@card, :reacting)}") do
+      first(".reaction", text: "Ship it!").find("[data-reaction-delete-target='content']").click
+      first(".reaction", text: "Ship it!").find(".reaction__delete").click
+
+      assert_no_selector ".reaction", text: "Ship it!"
+      assert_selector ".reaction", text: "🎉"
+    end
+
+    visit board_url(@card.board)
+    ensure_column_expanded(@card.column)
+
+    within("##{dom_id(@card, :article)}") do
+      assert_selector ".card__boosts", text: "1"
+    end
+  end
+
+  private
+    def ensure_column_expanded(column)
+      expander = find("##{dom_id(column)} .cards__expander")
+      expander.click if expander["aria-expanded"] == "false"
+    end
+end
