+  def up
+    add_reference :reactions, :reactable, polymorphic: true, type: :uuid, index: { name: "index_reactions_on_reactable" }
+
+    execute <<~SQL
+      UPDATE reactions
+      SET reactable_type = 'Comment',
+          reactable_id = comment_id
+    SQL
+
+    change_column_null :reactions, :reactable_type, false
+    change_column_null :reactions, :reactable_id, false
+
+    remove_reference :reactions, :comment, type: :uuid
+  end
+
+  def down
+    add_reference :reactions, :comment, type: :uuid, index: { name: "index_reactions_on_comment_id" }
+
+    execute <<~SQL
+      UPDATE reactions
+      SET comment_id = reactable_id
+      WHERE reactable_type = 'Comment'
+    SQL
+
+    change_column_null :reactions, :comment_id, false
+
+    remove_reference :reactions, :reactable, polymorphic: true, type: :uuid
+  end
+end
