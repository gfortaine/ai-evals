diff --git a/app/controllers/concerns/reactable_actions.rb b/app/controllers/concerns/reactable_actions.rb
new file mode 100644
index 0000000..f519233
--- /dev/null
+++ b/app/controllers/concerns/reactable_actions.rb
@@ -0,0 +1,63 @@
+module ReactableActions
+  extend ActiveSupport::Concern
+
+  included do
+    wrap_parameters :reaction, include: %i[ content ]
+
+    include CardScoped
+
+    before_action :set_reactable
+    before_action :ensure_reactable, only: :create
+
+    with_options only: :destroy do
+      before_action :set_reaction
+      before_action :ensure_permission_to_administer_reaction
+    end
+  end
+
+  def index
+    respond_to do |format|
+      format.html { render "reactions/index" }
+      format.json { render "reactions/index" }
+    end
+  end
+
+  def new
+    render "reactions/new"
+  end
+
+  def create
+    @reaction = @reactable.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream { render "reactions/create" }
+      format.json { render "reactions/show", status: :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream { render "reactions/destroy" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_reaction
+      @reaction = @reactable.reactions.find(params[:id])
+    end
+
+    def ensure_reactable
+      head :forbidden unless @reactable.reactable?
+    end
+
+    def ensure_permission_to_administer_reaction
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: :content)
+    end
+end
diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..6d72fac
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,46 @@
+module ReactionsHelper
+  def reaction_path_for(reaction, **options)
+    case reaction.reactable
+    when Card
+      card_reaction_path(reaction.reactable, reaction, **options)
+    when Comment
+      card_comment_reaction_path(reaction.reactable.card, reaction.reactable, reaction, **options)
+    end
+  end
+
+  def reaction_url_for(reaction, **options)
+    case reaction.reactable
+    when Card
+      card_reaction_url(reaction.reactable, reaction, **options)
+    when Comment
+      card_comment_reaction_url(reaction.reactable.card, reaction.reactable, reaction, **options)
+    end
+  end
+
+  def reactions_path_for(reactable, **options)
+    case reactable
+    when Card
+      card_reactions_path(reactable, **options)
+    when Comment
+      card_comment_reactions_path(reactable.card, reactable, **options)
+    end
+  end
+
+  def new_reaction_path_for(reactable, **options)
+    case reactable
+    when Card
+      new_card_reaction_path(reactable, **options)
+    when Comment
+      new_card_comment_reaction_path(reactable.card, reactable, **options)
+    end
+  end
+
+  def reaction_form_model(reactable)
+    case reactable
+    when Card
+      [ reactable, Reaction.new ]
+    when Comment
+      [ reactable.card, reactable, Reaction.new ]
+    end
+  end
+end
