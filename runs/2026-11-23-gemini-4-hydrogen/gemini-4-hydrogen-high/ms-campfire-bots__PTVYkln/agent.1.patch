@@ -0,0 +1,213 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "account edit shows Set up chat bots link to all members" do
+    get edit_account_url
+    assert_response :ok
+    assert_select "a[href='#{bots_path}']", text: /Set up chat bots/
+    assert_select "a[href='#{edit_account_custom_styles_path}']", count: 0
+
+    sign_in :david
+    get edit_account_url
+    assert_response :ok
+    assert_select "a[href='#{bots_path}']", text: /Set up chat bots/
+    assert_select "a[href='#{edit_account_custom_styles_path}']", text: /Custom styles/
+  end
+
+  test "bots do not appear in account users list" do
+    bot = User.create!(name: "Hidden From People Bot", role: :bot, creator: users(:kevin))
+
+    sign_in :david
+    get edit_account_url
+    assert_response :ok
+    assert_no_match /Hidden From People Bot/, response.body
+
+    assert_raises(ActiveRecord::RecordNotFound) { delete account_user_url(bot) }
+  end
+
+  test "index requires authentication" do
+    delete session_url
+    get bots_url
+    assert_redirected_to new_session_url
+  end
+
+  test "member sees only bots they created, admin sees all bots" do
+    kevins_bot = User.create!(name: "Kevin Bot", role: :bot, creator: users(:kevin))
+    jzs_bot = User.create!(name: "JZ Bot", role: :bot, creator: users(:jz))
+
+    get bots_url
+    assert_response :ok
+    assert_select "li", text: /Kevin Bot/ do
+      assert_select "label", text: "Bot code"
+      assert_select "input[readonly][value='#{kevins_bot.bot_key}']"
+      assert_select "a[href='#{edit_bot_path(kevins_bot)}']", text: /Edit Kevin Bot/
+    end
+    assert_no_match /JZ Bot/, response.body
+    assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+
+    sign_in :david
+    get bots_url
+    assert_response :ok
+    assert_match /Kevin Bot/, response.body
+    assert_match /JZ Bot/, response.body
+  end
+
+  test "index renders all bots without pagination" do
+    25.times { |i| User.create!(name: "Bot #{i}", role: :bot, creator: users(:kevin)) }
+
+    get bots_url
+    assert_response :ok
+    25.times { |i| assert_match /Bot #{i}/, response.body }
+  end
+
+  test "new renders form with required name, optional avatar, and Save changes button" do
+    get new_bot_url
+    assert_response :ok
+    assert_select "form[action='#{bots_path}']" do
+      assert_select "input[type='file'][name='bot[avatar]']"
+      assert_select "input[name='bot[name]'][required][placeholder='Name the bot']"
+      assert_select "button[type='submit']", text: /Save changes/
+    end
+  end
+
+  test "create creates bot, joins open rooms, and redirects to bots index" do
+    assert_difference -> { User.active.bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Deploy Bot", avatar: fixture_file_upload("earth.png", "image/png") } }
+    end
+
+    assert_redirected_to bots_url
+    bot = User.bot.last
+    assert_equal "Deploy Bot", bot.name
+    assert_equal users(:kevin), bot.creator
+    assert bot.avatar.attached?
+    assert_equal Rooms::Open.order(:id).pluck(:id), bot.rooms.opens.order(:id).pluck(:id)
+
+    follow_redirect!
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "input[readonly][value='#{bot.bot_key}']"
+      assert_select "a[href='#{edit_bot_path(bot)}']", text: /Edit Deploy Bot/
+    end
+  end
+
+  test "create with blank name returns 422" do
+    assert_no_difference -> { User.bot.count } do
+      post bots_url, params: { bot: { name: "   " } }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "edit renders form and Delete this chat bot button with confirmation" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+
+    get edit_bot_url(bot)
+    assert_response :ok
+    assert_select "form[action='#{bot_path(bot)}']" do
+      assert_select "input[name='bot[name]'][value='Deploy Bot'][required]"
+      assert_select "button[type='submit']", text: /Save changes/
+    end
+    assert_select "form[action='#{bot_path(bot)}'] button", text: /Delete this chat bot/
+    assert_select "button[data-turbo-confirm]", text: /Delete this chat bot/
+  end
+
+  test "update edits bot name and avatar" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+
+    patch bot_url(bot), params: { bot: { name: "Release Bot", avatar: fixture_file_upload("moon.jpg", "image/jpeg") } }
+    assert_redirected_to bots_url
+
+    bot.reload
+    assert_equal "Release Bot", bot.name
+    assert bot.avatar.attached?
+  end
+
+  test "update with blank name returns 422" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+
+    patch bot_url(bot), params: { bot: { name: "" } }
+    assert_response :unprocessable_content
+    assert_equal "Deploy Bot", bot.reload.name
+  end
+
+  test "destroy deactivates bot and redirects to bots index" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+    old_key = bot.bot_key
+
+    assert_difference -> { User.active.bot.count }, -1 do
+      delete bot_url(bot)
+    end
+
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+    assert_nil User.authenticate_bot(old_key)
+
+    get edit_bot_url(bot)
+    assert_response :not_found
+  end
+
+  test "members cannot edit, update, or delete bots created by others, while admins can" do
+    jzs_bot = User.create!(name: "JZ Bot", role: :bot, creator: users(:jz))
+
+    get edit_bot_url(jzs_bot)
+    assert_response :forbidden
+
+    patch bot_url(jzs_bot), params: { bot: { name: "Hacked" } }
+    assert_response :forbidden
+    assert_equal "JZ Bot", jzs_bot.reload.name
+
+    delete bot_url(jzs_bot)
+    assert_response :forbidden
+    assert jzs_bot.reload.active?
+
+    sign_in :david
+    patch bot_url(jzs_bot), params: { bot: { name: "Admin Updated" } }
+    assert_redirected_to bots_url
+    assert_equal "Admin Updated", jzs_bot.reload.name
+
+    delete bot_url(jzs_bot)
+    assert_redirected_to bots_url
+    assert jzs_bot.reload.deactivated?
+  end
+
+  test "bots can be added to closed rooms just like people" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+    sign_in :david
+
+    get edit_rooms_closed_url(rooms(:watercooler))
+    assert_response :ok
+    assert_match /Deploy Bot/, response.body
+
+    put rooms_closed_url(rooms(:watercooler)), params: {
+      room: { name: rooms(:watercooler).name },
+      user_ids: rooms(:watercooler).user_ids + [ bot.id ]
+    }
+    assert_redirected_to room_url(rooms(:watercooler))
+    assert_includes rooms(:watercooler).reload.users, bot
+  end
+
+  test "bots cannot sign in via session or transfer link" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+
+    delete session_url
+    post session_url, params: { email_address: nil, password: "" }
+    assert_response :unauthorized
+
+    put session_transfer_url(bot.transfer_id)
+    assert_response :bad_request
+  end
+
+  test "viewing bot user profile works cleanly" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+
+    sign_in :david
+    get user_url(bot)
+    assert_response :ok
+    assert_match /Deploy Bot/, response.body
+    assert_no_match /session_transfer_url/, response.body
+    assert_no_match /Ban/, response.body
+  end
+end
