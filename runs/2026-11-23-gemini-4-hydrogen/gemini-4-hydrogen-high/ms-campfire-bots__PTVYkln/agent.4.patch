diff --git a/test/system/bots_limit_test.rb b/test/system/bots_limit_test.rb
new file mode 100644
index 0000000..fdc559b
--- /dev/null
+++ b/test/system/bots_limit_test.rb
@@ -0,0 +1,90 @@
+require "application_system_test_case"
+
+class BotsLimitTest < ApplicationSystemTestCase
+  test "admin configures Bots per member and member is capped" do
+    # Admin sets Bots per member to 2
+    sign_in "david@37signals.com"
+    visit edit_account_url
+    assert_field "Bots per member", with: "5"
+
+    # Submit via "Save changes" button
+    fill_in "Bots per member", with: "2"
+    click_on "Save changes"
+    assert_field "Bots per member", with: "2"
+    assert_equal 2, accounts(:signal).reload.settings.bots_per_member
+
+    # Submit via Enter key
+    fill_in "Bots per member", with: "3"
+    find_field("Bots per member").send_keys(:enter)
+    assert_field "Bots per member", with: "3"
+    assert_equal 3, accounts(:signal).reload.settings.bots_per_member
+
+    # Submit via the adjacent save button
+    fill_in "Bots per member", with: "2"
+    click_on "Save bots per member"
+    assert_field "Bots per member", with: "2"
+    assert_equal 2, accounts(:signal).reload.settings.bots_per_member
+
+    # Member creates 2 bots and hits limit
+    using_session("Kevin") do
+      sign_in "kevin@37signals.com"
+
+      # Member does not see Bots per member setting
+      visit edit_account_url
+      assert_no_field "Bots per member"
+
+      visit bots_url
+      assert_link "Add a chat bot"
+      assert_no_text "reached the limit"
+
+      click_on "Add a chat bot"
+      fill_in "Name the bot", with: "First Bot"
+      click_on "Save changes"
+      assert_text "First Bot"
+
+      click_on "Add a chat bot"
+      fill_in "Name the bot", with: "Second Bot"
+      click_on "Save changes"
+      assert_text "Second Bot"
+
+      assert_no_link "Add a chat bot"
+      assert_text "reached the limit"
+
+      # Direct visit to /bots/new is refused
+      visit new_bot_url
+      assert_no_field "Name the bot"
+      assert_text "reached the limit"
+
+      # Deleting a bot frees a slot
+      visit bots_url
+      click_on "Edit First Bot"
+      accept_confirm do
+        click_on "Delete this chat bot"
+      end
+      assert_no_text "First Bot"
+      assert_text "Second Bot"
+      assert_link "Add a chat bot"
+      assert_no_text "reached the limit"
+    end
+
+    # Admin lowers limit to 0: existing bot remains for member, member is blocked, admin is not limited
+    fill_in "Bots per member", with: "0"
+    click_on "Save bots per member"
+    assert_equal 0, accounts(:signal).reload.settings.bots_per_member
+
+    using_session("Kevin") do
+      visit bots_url
+      assert_text "Second Bot"
+      assert_no_link "Add a chat bot"
+      assert_text "reached the limit"
+    end
+
+    visit bots_url
+    assert_link "Add a chat bot"
+    assert_no_text "reached the limit"
+    click_on "Add a chat bot"
+    fill_in "Name the bot", with: "Admin Bot"
+    click_on "Save changes"
+    assert_text "Admin Bot"
+  end
+end
