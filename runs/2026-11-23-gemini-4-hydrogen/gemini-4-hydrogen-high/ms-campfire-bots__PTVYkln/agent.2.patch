+test "delivers real HTTP request to localhost webhook URL and posts synchronous reply" do
+  require "socket"
+  server = TCPServer.new("127.0.0.1", 0)
+  port = server.addr[1]
+  received_request = nil
+
+  thread = Thread.new do
+    socket = server.accept
+    request_line = socket.gets
+    headers = {}
+    while (line = socket.gets) && line != "\r\n"
+      key, value = line.split(":", 2)
+      headers[key.downcase] = value.strip
+    end
+    body = socket.read(headers["content-length"].to_i)
+    received_request = { request_line: request_line, headers: headers, body: JSON.parse(body) }
+
+    response_body = "Pong from localhost!"
+    socket.write "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: #{response_body.bytesize}\r\nConnection: close\r\n\r\n#{response_body}"
+    socket.close
+  end
+
+  @bot.update!(webhook_url: "http://127.0.0.1:#{port}/hook")
+  WebMock.allow_net_connect!
+
+  perform_enqueued_jobs only: Bot::WebhookJob do
+    @room.messages.create!(
+      body: "<div>#{mention_html_for(@bot)} ping</div>",
+      creator: @alice
+    )
+  end
+
+  thread.join(2)
+  assert_not_nil received_request
+  assert_match %r{^POST /hook HTTP/}, received_request[:request_line]
+  assert_equal "application/json", received_request[:headers]["content-type"]
+  assert_equal "ping", received_request[:body].dig("message", "body", "text")
+
+  reply = @room.messages.order(:id).last
+  assert_equal @bot, reply.creator
+  assert_equal "Pong from localhost!", reply.plain_text_body
+ensure
+  WebMock.disable_net_connect!
+  server&.close
+end
+
+private
+    def mention_html_for(user)
+      attachment_body = ApplicationController.render(partial: "users/mention", locals: { user: user })
+      "<action-text-attachment sgid=\"#{user.attachable_sgid}\" content-type=\"application/vnd.campfire.mention\" content=\"#{attachment_body.gsub('"', '&quot;')}\"></action-text-attachment>"
+    end
+end
