diff --git a/test/models/bot/webhook_test.rb b/test/models/bot/webhook_test.rb
new file mode 100644
index 0000000..5344092
--- /dev/null
+++ b/test/models/bot/webhook_test.rb
@@ -0,0 +1,302 @@
+require "test_helper"
+
+class Bot::WebhookTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper, ActionCable::TestHelper
+
+  setup do
+    @alice = users(:david)
+    @bob = users(:kevin)
+    @room = rooms(:hq)
+    @bot = User.create!(
+      name: "Deploy Bot",
+      role: :bot,
+      creator: @alice,
+      webhook_url: "https://bot.example.com/webhooks/campfire"
+    )
+    sign_in :david
+  end
+
+  test "mentioning a bot enqueues Bot::WebhookJob without performing HTTP inline" do
+    # WebMock has net connect disabled and no stub is registered: if posting tried
+    # to hit the webhook synchronously during the request, it would raise!
+    assert_enqueued_jobs 1, only: Bot::WebhookJob do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: {
+          body: "<div>#{mention_html_for(@bot)} restart the build please</div>",
+          client_message_id: "msg-1"
+        }
+      }
+      assert_response :success
+    end
+  end
+
+  test "mentioning a bot without a webhook URL does not enqueue Bot::WebhookJob" do
+    silent_bot = User.create!(name: "Silent Bot", role: :bot, creator: @alice)
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      @room.messages.create!(
+        body: "<div>#{mention_html_for(silent_bot)} hello</div>",
+        creator: @alice
+      )
+    end
+  end
+
+  test "mentioning a bot in a room it does not belong to does not enqueue Bot::WebhookJob" do
+    closed_room = rooms(:watercooler)
+    assert_not_includes closed_room.users, @bot
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      closed_room.messages.create!(
