+test "ten consecutive failed webhook deliveries suspend the bot, and any 2xx resets the count" do
+  # Mix of non-2xx statuses, timeouts, and connection errors (9 total)
+  WebMock.stub_request(:post, @bot.webhook_url)
+    .to_return(status: 500)
+    .then.to_return(status: 404)
+    .then.to_return(status: 302)
+    .then.to_timeout
+    .then.to_raise(Errno::ECONNREFUSED)
+    .then.to_raise(SocketError)
+    .then.to_raise(Net::ReadTimeout)
+    .then.to_return(status: 503)
+    .then.to_return(status: 400)
+
+  9.times do
+    perform_enqueued_jobs only: Bot::WebhookJob do
