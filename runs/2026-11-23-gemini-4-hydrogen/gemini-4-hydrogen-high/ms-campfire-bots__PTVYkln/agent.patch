diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..8c3cce3
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,88 @@
+class Bots::MessagesController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  before_action :authenticate_bot
+  before_action :reject_suspended_bot
+  before_action :set_room
+
+  def process_action(*)
+    unless request.media_type == "multipart/form-data"
+      request.set_header("action_dispatch.request.request_parameters", {})
+    end
+
+    super
+  end
+
+  def create
+    unless message_content?
+      if @bot.in_cooldown?
+        return handle_rate_limit_rejection(@bot.claim_post_slot!)
+      else
+        return head(:unprocessable_content)
+      end
+    end
+
+    result = @bot.claim_post_slot!
+    if result.allowed?
+      @message = create_message
+      @message.broadcast_create
+      head :created, location: message_path(@message)
+    else
+      handle_rate_limit_rejection(result)
+    end
+  end
+
+  private
+    def authenticate_bot
+      if @bot = User.authenticate_bot(params[:bot_key])
+        Current.user = @bot
+      else
+        head :unauthorized
+      end
+    end
+
+    def reject_suspended_bot
+      head :forbidden if @bot.suspended?
+    end
+
+    def set_room
+      @room = @bot.rooms.find_by(id: params[:room_id])
+      head :not_found unless @room
+    end
+
+    def message_content?
+      uploaded_attachment.present? || body.present?
+    end
+
+    def handle_rate_limit_rejection(result)
+      if result.suspended?
+        head :forbidden
+      else
+        response.set_header("Retry-After", result.retry_after.to_s)
+        head :too_many_requests
+      end
+    end
+
+    def create_message
+      if attachment = uploaded_attachment
+        @room.messages.create_with_attachment!(attachment: attachment, creator: @bot)
+      elsif body.present?
+        @room.messages.create!(body: body, creator: @bot)
+      end
+    end
+
+    def uploaded_attachment
+      return unless request.media_type == "multipart/form-data"
+
+      params[:attachment] if params[:attachment].respond_to?(:tempfile)
+    end
+
+    def body
+      return if request.media_type == "multipart/form-data"
+
+      @body ||= request.raw_post.dup.force_encoding("UTF-8").scrub
+    end
+end
