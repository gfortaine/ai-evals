+test "API posts and webhook replies share the 10 messages in 10s limit and cooldown blocks webhook replies" do
+  freeze_time do
+    WebMock.stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, body: "Webhook reply", headers: { "Content-Type" => "text/plain" })
