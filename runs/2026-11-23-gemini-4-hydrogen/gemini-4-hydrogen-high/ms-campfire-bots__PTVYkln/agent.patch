diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
new file mode 100644
index 0000000..a24de4c
--- /dev/null
+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,240 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "creating a bot generates a bot token and does not join open rooms by default" do
+    assert_no_difference -> { Membership.count } do
+      @bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+    end
+
+    assert @bot.bot?
+    assert @bot.active?
+    assert_not @bot.add_to_all_open_rooms?
+    assert @bot.bot_token.present?
+    assert_equal "#{@bot.id}-#{@bot.bot_token}", @bot.bot_key
+    assert_empty @bot.rooms
+  end
+
+  test "creating a bot with add_to_all_open_rooms grants membership to all open rooms" do
+    assert_difference -> { Membership.count }, +Rooms::Open.count do
+      @bot = User.create!(name: "Everyone Bot", role: :bot, creator: users(:kevin), add_to_all_open_rooms: true)
+    end
+
+    assert @bot.add_to_all_open_rooms?
+    assert_equal Rooms::Open.order(:id).pluck(:id), @bot.rooms.order(:id).pluck(:id)
+  end
+
+  test "toggling add_to_all_open_rooms grants open rooms on enable and keeps memberships on disable" do
+    bot = User.create!(name: "Toggle Bot", role: :bot, creator: users(:kevin))
+    rooms(:watercooler).memberships.grant_to(bot)
+    assert_equal [ rooms(:watercooler).id ], bot.room_ids
+
+    bot.update!(add_to_all_open_rooms: true)
+    expected_ids = (Rooms::Open.pluck(:id) + [ rooms(:watercooler).id ]).sort
+    assert_equal expected_ids, bot.rooms.reload.order(:id).pluck(:id)
+
+    new_open_room = Rooms::Open.create!(name: "New Open", creator: users(:david))
+    assert_includes bot.rooms.reload, new_open_room
+
+    bot.update!(add_to_all_open_rooms: false)
+    assert_equal (expected_ids + [ new_open_room.id ]).sort, bot.rooms.reload.order(:id).pluck(:id)
+
+    later_open_room = Rooms::Open.create!(name: "Later Open", creator: users(:david))
+    assert_not_includes bot.rooms.reload, later_open_room
+  end
+
+  test "bot requires a name" do
+    bot = User.new(name: "", role: :bot, creator: users(:kevin))
+    assert_not bot.valid?
+    assert bot.errors[:name].any?
+  end
+
+  test "webhook_url is optional, normalized, and validated as http/https" do
+    bot = User.create!(name: "Hook Bot", role: :bot, creator: users(:kevin), webhook_url: "  ")
+    assert_nil bot.webhook_url
+
+    bot.update!(webhook_url: " https://example.com/hook ")
+    assert_equal "https://example.com/hook", bot.webhook_url
+
+    bot.update!(webhook_url: "http://127.0.0.1:4567/callback")
+    assert_equal "http://127.0.0.1:4567/callback", bot.webhook_url
+
+    bot.update!(webhook_url: "")
+    assert_nil bot.webhook_url
+
+    [ "not-a-url", "ftp://example.com/hook", "javascript:alert(1)" ].each do |bad_url|
+      bot.webhook_url = bad_url
+      assert_not bot.valid?, "Expected #{bad_url} to be invalid"
+      assert bot.errors[:webhook_url].any?
+    end
+  end
+
+  test "authenticate_bot validates active bots with matching key" do
+    bot = User.create!(name: "CI Bot", role: :bot, creator: users(:kevin))
+
+    assert_equal bot, User.authenticate_bot(bot.bot_key)
+    assert_nil User.authenticate_bot("#{bot.id}-wrongtoken")
+    assert_nil User.authenticate_bot("999999-#{bot.bot_token}")
+    assert_nil User.authenticate_bot("invalid")
+    assert_nil User.authenticate_bot(nil)
+    assert_nil User.authenticate_bot("#{users(:david).id}-")
+  end
+
+  test "deactivating a bot revokes memberships and invalidates bot_key and webhook_url while preserving messages" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin), webhook_url: "https://example.com/hook", add_to_all_open_rooms: true)
+    bot_key = bot.bot_key
+    rooms(:watercooler).memberships.grant_to(bot)
+    message = rooms(:hq).messages.create!(body: "Deployed!", creator: bot)
+
+    bot.deactivate
+
+    assert bot.reload.deactivated?
+    assert_nil bot.bot_token
+    assert_nil bot.bot_key
+    assert_nil bot.webhook_url
+    assert_not bot.add_to_all_open_rooms?
+    assert_empty bot.memberships
+    assert_nil User.authenticate_bot(bot_key)
+    assert Message.exists?(message.id)
+  end
+
+  test "bot creation limit applies to members, ignores deactivated bots, and does not limit administrators" do
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+    kevin = users(:kevin)
+    david = users(:david)
+
+    assert kevin.can_create_bot?
+    assert_not kevin.bot_limit_reached?
+
+    bot1 = User.create!(name: "Bot 1", role: :bot, creator: kevin)
+    User.create!(name: "Bot 2", role: :bot, creator: kevin)
+    assert_not kevin.can_create_bot?
+    assert kevin.bot_limit_reached?
+
+    bot1.deactivate
+    assert kevin.can_create_bot?
+    assert_not kevin.bot_limit_reached?
+
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    assert kevin.bot_limit_reached?
+    assert david.can_create_bot?
+    assert_not david.bot_limit_reached?
+  end
+end
+
+# Bot moderation tests
+class User::BotModerationTest < ActiveSupport::TestCase
+  test "sliding window allows 10 posts in 10 seconds and enters 30s cooldown on 11th" do
+    bot = User.create!(name: "Rate Bot", role: :bot, creator: users(:kevin))
+
+    freeze_time do
+      10.times do
+        assert bot.claim_post_slot!.allowed?
+      end
+
+      result = bot.claim_post_slot!
+      assert result.cooldown?
+      assert_equal 30, result.retry_after
+      assert bot.in_cooldown?
+      assert_not bot.suspended?
+
+      travel 12.seconds
+      assert_equal 18, bot.cooldown_seconds_remaining
+
+      travel 18.seconds
+      assert_not bot.in_cooldown?
+      assert bot.claim_post_slot!.allowed?
+    end
+  end
+
+  test "sliding window ages out old timestamps after 10 seconds" do
+    bot = User.create!(name: "Sliding Bot", role: :bot, creator: users(:kevin))
+
+    freeze_time do
+      5.times { assert bot.claim_post_slot!.allowed? }
+      travel 6.seconds
+      5.times { assert bot.claim_post_slot!.allowed? }
+
+      travel 4.1.seconds # t = 10.1s; first 5 have aged out, 5 from t=6s remain
+      5.times { assert bot.claim_post_slot!.allowed? }
+
+      result = bot.claim_post_slot!
+      assert result.cooldown?
+      assert_equal 30, result.retry_after
+    end
+  end
+
+  test "five attempts during the same cooldown suspend the bot, and expiring cooldown resets attempt count" do
+    bot = User.create!(name: "Cooldown Bot", role: :bot, creator: users(:kevin))
+
+    freeze_time do
+      10.times { assert bot.claim_post_slot!.allowed? }
+      assert bot.claim_post_slot!.cooldown?
+
+      4.times do
+        result = bot.claim_post_slot!
+        assert result.cooldown?
+        assert_not bot.suspended?
+      end
+
+      # Let first cooldown expire before 5th attempt
+      travel 30.seconds
+      assert_not bot.in_cooldown?
+      assert bot.claim_post_slot!.allowed?
+
+      # Trigger a second cooldown: requires 5 fresh attempts to suspend
+      9.times { assert bot.claim_post_slot!.allowed? }
+      assert bot.claim_post_slot!.cooldown?
+
+      4.times do
+        result = bot.claim_post_slot!
+        assert result.cooldown?
+        assert_not bot.suspended?
+      end
+
+      result = bot.claim_post_slot!
+      assert result.suspended?
+      assert bot.suspended?
+      assert_equal User::Bot::FLOODING_REASON, bot.suspension_reason
+    end
+  end
+
+  test "suspended bot keeps rooms and messages, counts towards owner limit, and is excluded from with_webhook" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    kevin = users(:kevin)
+    bot = User.create!(name: "Limit Bot", role: :bot, creator: kevin, webhook_url: "https://example.com/hook")
+    rooms(:hq).memberships.grant_to(bot)
+    message = rooms(:hq).messages.create!(body: "Keep me", creator: bot)
+
+    assert_includes User.with_webhook, bot
+    assert kevin.bot_limit_reached?
+
+    bot.suspend!(reason: User::Bot::FLOODING_REASON)
+
+    assert bot.reload.suspended?
+    assert_not_includes User.with_webhook, bot
+    assert_includes bot.rooms, rooms(:hq)
+    assert Message.exists?(message.id)
+    assert kevin.bot_limit_reached?
+  end
+
+  test "reactivate! clears suspension, cooldown, failure counts, and rate-limit window" do
+    bot = User.create!(name: "Recover Bot", role: :bot, creator: users(:kevin))
+    freeze_time do
+      10.times { bot.claim_post_slot! }
+      bot.claim_post_slot! # cooldown
+      5.times { bot.claim_post_slot! } # suspended
+      assert bot.suspended?
+
+      bot.update_column(:consecutive_webhook_failures, 7)
+      bot.reactivate!
+
+      assert_not bot.suspended?
+      assert_nil bot.suspended_at
+      assert_nil bot.suspension_reason
+      assert_not bot.in_cooldown?
+      assert_equal 0, bot.cooldown_attempts
+      assert_equal 0, bot.consecutive_webhook_failures
+      assert bot.claim_post_slot!.allowed?
+    end
+  end
+end
diff --git a/test/system/bots_limit_test.rb b/test/system/bots_limit_test.rb
new file mode 100644
index 0000000..fdc559b
--- /dev/null
+++ b/test/system/bots_limit_test.rb
@@ -0,0 +1,90 @@
+require "application_system_test_case"
+
+class BotsLimitTest < ApplicationSystemTestCase
+  test "admin configures Bots per member and member is capped" do
+    # Admin sets Bots per member to 2
+    sign_in "david@37signals.com"
+    visit edit_account_url
+    assert_field "Bots per member", with: "5"
+
+    # Submit via "Save changes" button
+    fill_in "Bots per member", with: "2"
+    click_on "Save changes"
+    assert_field "Bots per member", with: "2"
+    assert_equal 2, accounts(:signal).reload.settings.bots_per_member
+
+    # Submit via Enter key
+    fill_in "Bots per member", with: "3"
+    find_field("Bots per member").send_keys(:enter)
+    assert_field "Bots per member", with: "3"
+    assert_equal 3, accounts(:signal).reload.settings.bots_per_member
+
+    # Submit via the adjacent save button
+    fill_in "Bots per member", with: "2"
+    click_on "Save bots per member"
+    assert_field "Bots per member", with: "2"
+    assert_equal 2, accounts(:signal).reload.settings.bots_per_member
+
+    # Member creates 2 bots and hits limit
+    using_session("Kevin") do
+      sign_in "kevin@37signals.com"
+
+      # Member does not see Bots per member setting
+      visit edit_account_url
+      assert_no_field "Bots per member"
+
+      visit bots_url
+      assert_link "Add a chat bot"
+      assert_no_text "reached the limit"
+
+      click_on "Add a chat bot"
+      fill_in "Name the bot", with: "First Bot"
+      click_on "Save changes"
+      assert_text "First Bot"
+
+      click_on "Add a chat bot"
+      fill_in "Name the bot", with: "Second Bot"
+      click_on "Save changes"
+      assert_text "Second Bot"
+
+      assert_no_link "Add a chat bot"
+      assert_text "reached the limit"
+
+      # Direct visit to /bots/new is refused
+      visit new_bot_url
+      assert_no_field "Name the bot"
+      assert_text "reached the limit"
+
+      # Deleting a bot frees a slot
+      visit bots_url
+      click_on "Edit First Bot"
+      accept_confirm do
+        click_on "Delete this chat bot"
+      end
+      assert_no_text "First Bot"
+      assert_text "Second Bot"
+      assert_link "Add a chat bot"
+      assert_no_text "reached the limit"
+    end
+
+    # Admin lowers limit to 0: existing bot remains for member, member is blocked, admin is not limited
+    fill_in "Bots per member", with: "0"
+    click_on "Save bots per member"
+    assert_equal 0, accounts(:signal).reload.settings.bots_per_member
+
+    using_session("Kevin") do
+      visit bots_url
+      assert_text "Second Bot"
+      assert_no_link "Add a chat bot"
+      assert_text "reached the limit"
+    end
+
+    visit bots_url
+    assert_link "Add a chat bot"
+    assert_no_text "reached the limit"
+    click_on "Add a chat bot"
+    fill_in "Name the bot", with: "Admin Bot"
+    click_on "Save changes"
+    assert_text "Admin Bot"
+  end
+end
