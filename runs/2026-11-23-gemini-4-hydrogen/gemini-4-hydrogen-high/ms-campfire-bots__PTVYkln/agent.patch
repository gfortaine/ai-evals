+    assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+      perform_enqueued_jobs only: Bot::WebhookJob do
+        @room.messages.create!(body: "<div>#{mention_html_for(@bot)} final</div>", creator: @alice)
+      end
+    end
+    assert @bot.reload.suspended?
+  end
