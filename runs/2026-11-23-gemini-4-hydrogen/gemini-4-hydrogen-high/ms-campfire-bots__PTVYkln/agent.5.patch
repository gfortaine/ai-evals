@@ -145,4 +145,95 @@ class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
     assert_response :unauthorized
     assert Message.exists?(message.id)
   end
+
+test "flooding over 10 messages in 10 seconds rejects the 11th message with 429 and Retry-After, then recovers after 30s" do
+  freeze_time do
+    assert_difference -> { @room.messages.count }, 10 do
+      10.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key), params: "Msg #{i}"
+        assert_response :created
+      end
+    end
+
+    assert_no_difference -> { @room.messages.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Msg 11"
+    end
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+    assert @bot.reload.in_cooldown?
+    assert_not @bot.suspended?
+
+    travel 12.seconds
+    assert_no_difference -> { @room.messages.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "During cooldown"
+    end
+    assert_response :too_many_requests
+    assert_equal "18", response.headers["Retry-After"]
+
+    travel 18.seconds
+    assert_difference -> { @room.messages.count }, 1 do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "After cooldown"
+    end
+    assert_response :created
+  end
+end
+
+test "five more attempts during the same cooldown suspend the bot and return 403 Forbidden" do
+  freeze_time do
+    10.times do |i|
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Msg #{i}"
+      assert_response :created
+    end
+
+    # 11th starts cooldown
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Trigger cooldown"
+    assert_response :too_many_requests
+    assert_not @bot.reload.suspended?
+
+    # 4 attempts during cooldown still get 429
+    4.times do |i|
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Retry #{i}"
+      assert_response :too_many_requests
+      assert_not @bot.reload.suspended?
+    end
+
+    # 5th attempt during cooldown suspends the bot
+    assert_no_difference -> { @room.messages.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Retry 5"
+    end
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+
+    # Subsequent requests also get 403 Forbidden
+    post room_bot_messages_url(@room, @bot.bot_key), params: "After suspension"
+    assert_response :forbidden
+  end
+end
+
+test "suspended bot gets 403 Forbidden even for rooms it does not belong to, while invalid key gets 401" do
+  @bot.suspend!(reason: User::Bot::FLOODING_REASON)
+
+  post room_bot_messages_url(@room, @bot.bot_key), params: "Hello"
+  assert_response :forbidden
+
+  post room_bot_messages_url(rooms(:watercooler), @bot.bot_key), params: "Hello"
