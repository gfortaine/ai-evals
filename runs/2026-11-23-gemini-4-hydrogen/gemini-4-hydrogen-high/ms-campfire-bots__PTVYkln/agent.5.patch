@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Bots::ReactivationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @owner = users(:kevin)
+    @admin = users(:david)
+    @bot = User.create!(name: "Bad Bot", role: :bot, creator: @owner, webhook_url: "https://bot.example.com/hook")
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    @message = @room.messages.create!(body: "Earlier message", creator: @bot)
+    @bot.suspend!(reason: User::Bot::FLOODING_REASON)
+  end
+
+  test "requires authentication" do
+    post bot_reactivation_url(@bot)
+    assert_redirected_to new_session_url
+    assert @bot.reload.suspended?
+  end
+
+  test "non-admin cannot reactivate a bot even if they own it" do
+    sign_in :kevin
+    post bot_reactivation_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "admin can reactivate a suspended bot and it can post and receive webhooks again while keeping rooms and messages" do
+    sign_in :david
+
+    post bot_reactivation_url(@bot)
+    assert_redirected_to bots_url
+
+    @bot.reload
+    assert_not @bot.suspended?
+    assert_nil @bot.suspended_at
+    assert_nil @bot.suspension_reason
+    assert_includes @bot.rooms, @room
+    assert Message.exists?(@message.id)
+
+    follow_redirect!
+    assert_select "li##{dom_id(@bot)}", text: /Bad Bot/ do
+      assert_select "*", text: /Suspended/, count: 0
+      assert_select "button", text: /Reactivate/, count: 0
+    end
+
+    # Bot can post through the API again
+    post room_bot_messages_url(@room, @bot.bot_key), params: "I am back!"
+    assert_response :created
+  end
+
+  test "reactivating a deactivated or non-existent bot returns 404" do
+    sign_in :david
+
+    @bot.deactivate
+    post bot_reactivation_url(@bot)
+    assert_response :not_found
+
+    post bot_reactivation_url(999_999)
+    assert_response :not_found
+  end
+end
