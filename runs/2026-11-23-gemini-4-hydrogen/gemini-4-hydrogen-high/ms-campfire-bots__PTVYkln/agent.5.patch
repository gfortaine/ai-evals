+    assert_select "*", text: /Suspended/
+    assert_select "*", text: /#{Regexp.escape(User::Bot::FLOODING_REASON)}/
+    assert_select "button", text: /Reactivate/, count: 0
+  end
+  assert_select "a[href='#{new_bot_path}']", count: 0
+  assert_match /reached the limit/, response.body
+
+  # Admin sees Suspended + reason AND Reactivate button with confirmation
+  sign_in :david
+  get bots_url
+  assert_response :ok
+  assert_select "li##{dom_id(bot)}", text: /Spammy Bot/ do
+    assert_select "*", text: /Suspended/
+    assert_select "*", text: /#{Regexp.escape(User::Bot::FLOODING_REASON)}/
+    assert_select "form[action='#{bot_reactivation_path(bot)}']" do
+      assert_select "button[data-turbo-confirm]", text: /Reactivate/
+    end
+  end
+end
 end
diff --git a/test/models/bot/webhook_test.rb b/test/models/bot/webhook_test.rb
index 4c4bc23..778c9b8 100644
--- a/test/models/bot/webhook_test.rb
+++ b/test/models/bot/webhook_test.rb
@@ -518,6 +518,138 @@ class Bot::WebhookTest < ActionDispatch::IntegrationTest
     end
   end
 
+
+test "API posts and webhook replies share the 10 messages in 10s limit and cooldown blocks webhook replies" do
+  freeze_time do
+    WebMock.stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, body: "Webhook reply", headers: { "Content-Type" => "text/plain" })
+
+    # 8 API posts
+    8.times do |i|
+      post room_bot_messages_url(@room, @bot.bot_key), params: "API #{i}"
+      assert_response :created
+    end
+
+    # 2 webhook replies -> total 10 messages
+    2.times do
+      assert_difference -> { @room.messages.where(creator: @bot).count }, 1 do
+        perform_enqueued_jobs only: Bot::WebhookJob do
+          @room.messages.create!(body: "<div>#{mention_html_for(@bot)} ping</div>", creator: @alice)
+        end
+      end
+    end
+
+    # 11th message via webhook reply is rejected and starts 30s cooldown
+    assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+      perform_enqueued_jobs only: Bot::WebhookJob do
+        @room.messages.create!(body: "<div>#{mention_html_for(@bot)} ping 11</div>", creator: @alice)
+      end
+    end
+    assert @bot.reload.in_cooldown?
+
+    # API sees 429 during cooldown (counts as attempt 1)
+    post room_bot_messages_url(@room, @bot.bot_key), params: "During cooldown"
+    assert_response :too_many_requests
+
+    # 3 more webhook replies during cooldown are not posted (attempts 2, 3, 4)
+    3.times do
+      assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+        perform_enqueued_jobs only: Bot::WebhookJob do
+          @room.messages.create!(body: "<div>#{mention_html_for(@bot)} ping</div>", creator: @alice)
+        end
+      end
+      assert_not @bot.reload.suspended?
+    end
+
+    # 204 response during cooldown does not count as a post attempt
+    WebMock.stub_request(:post, @bot.webhook_url).to_return(status: 204)
+    perform_enqueued_jobs only: Bot::WebhookJob do
+      @room.messages.create!(body: "<div>#{mention_html_for(@bot)} silent</div>", creator: @alice)
+    end
+    assert_not @bot.reload.suspended?
+
+    # 5th reply attempt during cooldown suspends the bot
+    WebMock.stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, body: "One too many", headers: { "Content-Type" => "text/plain" })
+    assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+      perform_enqueued_jobs only: Bot::WebhookJob do
+        @room.messages.create!(body: "<div>#{mention_html_for(@bot)} final</div>", creator: @alice)
+      end
+    end
+    assert @bot.reload.suspended?
+  end
+end
+
+test "ten consecutive failed webhook deliveries suspend the bot, and any 2xx resets the count" do
+  # Mix of non-2xx statuses, timeouts, and connection errors (9 total)
+  WebMock.stub_request(:post, @bot.webhook_url)
+    .to_return(status: 500)
+    .then.to_return(status: 404)
+    .then.to_return(status: 302)
+    .then.to_timeout
+    .then.to_raise(Errno::ECONNREFUSED)
+    .then.to_raise(SocketError)
+    .then.to_raise(Net::ReadTimeout)
+    .then.to_return(status: 503)
+    .then.to_return(status: 400)
+
+  9.times do
+    perform_enqueued_jobs only: Bot::WebhookJob do
+      @room.messages.create!(body: "<div>#{mention_html_for(@bot)} fail</div>", creator: @alice)
+    end
+  end
+
+  assert_equal 9, @bot.reload.consecutive_webhook_failures
+  assert_not @bot.suspended?
+
+  # A 2xx response resets consecutive failure count
+  WebMock.stub_request(:post, @bot.webhook_url).to_return(status: 204)
+  perform_enqueued_jobs only: Bot::WebhookJob do
+    @room.messages.create!(body: "<div>#{mention_html_for(@bot)} ok</div>", creator: @alice)
+  end
+
+  assert_equal 0, @bot.reload.consecutive_webhook_failures
+  assert_not @bot.suspended?
+
+  # Now 10 failures in a row suspend the bot
+  WebMock.stub_request(:post, @bot.webhook_url).to_return(status: 502)
+  9.times do
+    perform_enqueued_jobs only: Bot::WebhookJob do
+      @room.messages.create!(body: "<div>#{mention_html_for(@bot)} fail again</div>", creator: @alice)
+    end
+  end
+  assert_not @bot.reload.suspended?
+
+  perform_enqueued_jobs only: Bot::WebhookJob do
+    @room.messages.create!(body: "<div>#{mention_html_for(@bot)} 10th fail</div>", creator: @alice)
+  end
+  assert @bot.reload.suspended?
+  assert_equal User::Bot::WEBHOOK_FAILURE_REASON, @bot.suspension_reason
+end
+
+test "suspended bot receives no webhooks even for already enqueued jobs" do
+  # Enqueue a job before suspending
+  assert_enqueued_jobs 1, only: Bot::WebhookJob do
+    @room.messages.create!(body: "<div>#{mention_html_for(@bot)} queued</div>", creator: @alice)
+  end
+
+  @bot.suspend!(reason: User::Bot::WEBHOOK_FAILURE_REASON)
+
+  # Already enqueued job should not perform any HTTP request
+  perform_enqueued_jobs only: Bot::WebhookJob
+  assert_not_requested :post, @bot.webhook_url
+
+  # Subsequent mention does not even enqueue a job
+  assert_no_enqueued_jobs only: Bot::WebhookJob do
+    @room.messages.create!(body: "<div>#{mention_html_for(@bot)} after suspend</div>", creator: @alice)
+  end
+
+  # Subsequent room join does not enqueue a job
+  assert_no_enqueued_jobs only: Bot::WebhookJob do
+    rooms(:watercooler).memberships.grant_to(@bot)
+  end
+end
+
   private
     def mention_html_for(user)
       attachment_body = ApplicationController.render(partial: "users/mention", locals: { user: user })
diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
index 5e34221..a24de4c 100644
--- a/test/models/user/bot_test.rb
+++ b/test/models/user/bot_test.rb
@@ -120,3 +120,121 @@ class User::BotTest < ActiveSupport::TestCase
     assert_not david.bot_limit_reached?
   end
 end
+
+# Bot moderation tests
+class User::BotModerationTest < ActiveSupport::TestCase
+  test "sliding window allows 10 posts in 10 seconds and enters 30s cooldown on 11th" do
+    bot = User.create!(name: "Rate Bot", role: :bot, creator: users(:kevin))
+
+    freeze_time do
+      10.times do
+        assert bot.claim_post_slot!.allowed?
+      end
+
+      result = bot.claim_post_slot!
+      assert result.cooldown?
+      assert_equal 30, result.retry_after
+      assert bot.in_cooldown?
+      assert_not bot.suspended?
+
+      travel 12.seconds
+      assert_equal 18, bot.cooldown_seconds_remaining
+
+      travel 18.seconds
+      assert_not bot.in_cooldown?
+      assert bot.claim_post_slot!.allowed?
+    end
+  end
+
+  test "sliding window ages out old timestamps after 10 seconds" do
+    bot = User.create!(name: "Sliding Bot", role: :bot, creator: users(:kevin))
+
+    freeze_time do
+      5.times { assert bot.claim_post_slot!.allowed? }
+      travel 6.seconds
+      5.times { assert bot.claim_post_slot!.allowed? }
+
+      travel 4.1.seconds # t = 10.1s; first 5 have aged out, 5 from t=6s remain
+      5.times { assert bot.claim_post_slot!.allowed? }
+
+      result = bot.claim_post_slot!
+      assert result.cooldown?
+      assert_equal 30, result.retry_after
+    end
+  end
+
+  test "five attempts during the same cooldown suspend the bot, and expiring cooldown resets attempt count" do
+    bot = User.create!(name: "Cooldown Bot", role: :bot, creator: users(:kevin))
+
+    freeze_time do
+      10.times { assert bot.claim_post_slot!.allowed? }
+      assert bot.claim_post_slot!.cooldown?
+
+      4.times do
+        result = bot.claim_post_slot!
+        assert result.cooldown?
+        assert_not bot.suspended?
+      end
+
+      # Let first cooldown expire before 5th attempt
+      travel 30.seconds
+      assert_not bot.in_cooldown?
+      assert bot.claim_post_slot!.allowed?
+
+      # Trigger a second cooldown: requires 5 fresh attempts to suspend
+      9.times { assert bot.claim_post_slot!.allowed? }
+      assert bot.claim_post_slot!.cooldown?
+
+      4.times do
+        result = bot.claim_post_slot!
+        assert result.cooldown?
+        assert_not bot.suspended?
+      end
+
+      result = bot.claim_post_slot!
+      assert result.suspended?
+      assert bot.suspended?
+      assert_equal User::Bot::FLOODING_REASON, bot.suspension_reason
+    end
+  end
+
+  test "suspended bot keeps rooms and messages, counts towards owner limit, and is excluded from with_webhook" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    kevin = users(:kevin)
+    bot = User.create!(name: "Limit Bot", role: :bot, creator: kevin, webhook_url: "https://example.com/hook")
+    rooms(:hq).memberships.grant_to(bot)
+    message = rooms(:hq).messages.create!(body: "Keep me", creator: bot)
+
+    assert_includes User.with_webhook, bot
+    assert kevin.bot_limit_reached?
+
+    bot.suspend!(reason: User::Bot::FLOODING_REASON)
+
+    assert bot.reload.suspended?
+    assert_not_includes User.with_webhook, bot
+    assert_includes bot.rooms, rooms(:hq)
+    assert Message.exists?(message.id)
+    assert kevin.bot_limit_reached?
+  end
+
+  test "reactivate! clears suspension, cooldown, failure counts, and rate-limit window" do
+    bot = User.create!(name: "Recover Bot", role: :bot, creator: users(:kevin))
+    freeze_time do
+      10.times { bot.claim_post_slot! }
+      bot.claim_post_slot! # cooldown
+      5.times { bot.claim_post_slot! } # suspended
+      assert bot.suspended?
+
+      bot.update_column(:consecutive_webhook_failures, 7)
+      bot.reactivate!
+
+      assert_not bot.suspended?
+      assert_nil bot.suspended_at
+      assert_nil bot.suspension_reason
+      assert_not bot.in_cooldown?
+      assert_equal 0, bot.cooldown_attempts
+      assert_equal 0, bot.consecutive_webhook_failures
+      assert bot.claim_post_slot!.allowed?
+    end
+  end
+end
