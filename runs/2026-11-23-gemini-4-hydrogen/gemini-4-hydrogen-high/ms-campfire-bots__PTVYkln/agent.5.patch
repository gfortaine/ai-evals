+
+  PostAttemptResult = Data.define(:status, :retry_after) do
+    def initialize(status:, retry_after: nil)
+      super
+    end
+
+    def allowed?
+      status == :allowed
+    end
+
+    def cooldown?
+      status == :cooldown
+    end
+
+    def suspended?
+      status == :suspended
+    end
