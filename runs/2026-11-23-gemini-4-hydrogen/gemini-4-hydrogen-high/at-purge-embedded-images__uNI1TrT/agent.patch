diff --git a/test/controllers/action_text/markdown/uploads_controller_test.rb b/test/controllers/action_text/markdown/uploads_controller_test.rb
index 48141c1..e688755 100644
--- a/test/controllers/action_text/markdown/uploads_controller_test.rb
+++ b/test/controllers/action_text/markdown/uploads_controller_test.rb
@@ -31,4 +31,41 @@ class ActionText::Markdown::UploadsControllerTest < ActionDispatch::IntegrationT
     assert_response :redirect
     assert_match /\/rails\/active_storage\/.*\/reading\.webp/, @response.redirect_url
   end
+
+  test "upload an image, fetch it back, and purge it when the page is destroyed" do
+    page = pages(:welcome)
+
+    post action_text_markdown_uploads_path, params: {
+      record_gid: page.to_signed_global_id.to_s,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+
+    assert_response :created
+    file_url = JSON.parse(response.body)["fileUrl"]
+    assert file_url.start_with?("/")
+
+    get file_url
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_equal file_fixture("reading.webp").binread, response.body
+
+    attachment = page.reload.body.uploads.attachments.last
+    blob = attachment.blob
+    file_path = ActiveStorage::Blob.service.path_for(blob.key)
+    assert File.exist?(file_path)
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not Page.exists?(page.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not File.exist?(file_path)
+
+    get file_url
+    assert_response :not_found
+  end
 end
diff --git a/test/models/leaf/editable_test.rb b/test/models/leaf/editable_test.rb
index b654642..2490517 100644
--- a/test/models/leaf/editable_test.rb
+++ b/test/models/leaf/editable_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class Leaf::EditableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
   test "editing a leafable records the edit" do
     leaves(:welcome_page).edit leafable_params: { body: "New body" }
 
@@ -63,4 +65,46 @@ class Leaf::EditableTest < ActiveSupport::TestCase
     assert leaves(:welcome_page).edits.last.trash?
     assert_equal "This is _such_ a great handbook.", leaves(:welcome_page).edits.last.page.body.content
   end
+
+  test "destroying an edited leaf destroys previous revisions and purges their markdown uploads" do
+    leaf = leaves(:welcome_page)
+    original_page = leaf.page
+    original_page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    original_page.body.save!
+
+    attachment = original_page.body.uploads.attachments.last
+    blob = attachment.blob
+    file_path = ActiveStorage::Blob.service.path_for(blob.key)
+
+    leaf.edit leafable_params: { body: "Updated body with ![image](#{attachment.slug_path})" }
+
+    perform_enqueued_jobs do
+      leaf.destroy!
+    end
+
+    assert_not Page.exists?(original_page.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not File.exist?(file_path)
+  end
+
+  test "destroying a trashed leaf purges its markdown uploads" do
+    leaf = leaves(:welcome_page)
+    leaf.page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    leaf.page.body.save!
+
+    attachment = leaf.page.body.uploads.attachments.last
+    blob = attachment.blob
+    file_path = ActiveStorage::Blob.service.path_for(blob.key)
+
+    leaf.trashed!
+
+    perform_enqueued_jobs do
+      leaf.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not File.exist?(file_path)
+  end
 end
