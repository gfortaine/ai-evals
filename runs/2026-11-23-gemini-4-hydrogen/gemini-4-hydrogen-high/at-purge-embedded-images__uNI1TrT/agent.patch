+
   test "html preview" do
     page = Page.new(body: "# Hello\n\nWorld!")
 
@@ -26,4 +28,50 @@ class PageTest < ActiveSupport::TestCase
     assert_includes page.searchable_content, "5 &lt; 10 &amp; 10 &gt; 5"
     assert page.searchable_content.html_safe?
   end
+
+  test "destroying a page purges its markdown uploads" do
+    page = pages(:welcome)
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    page.body.save!
+
+    markdown = page.body
+    attachment = markdown.uploads.attachments.last
+    blob = attachment.blob
+    file_path = ActiveStorage::Blob.service.path_for(blob.key)
+
+    assert File.exist?(file_path)
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActionText::Markdown.exists?(markdown.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not File.exist?(file_path)
+  end
+
+  test "destroying a page with multiple markdown uploads purges all of them" do
+    page = pages(:welcome)
+    page.body.uploads.attach [
+      { io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp" },
+      { io: file_fixture("white-rabbit.webp").open, filename: "white-rabbit.webp", content_type: "image/webp" }
+    ]
+    page.body.save!
+
+    attachments = page.body.uploads.attachments.to_a
+    blobs = attachments.map(&:blob)
+    file_paths = blobs.map { |blob| ActiveStorage::Blob.service.path_for(blob.key) }
+
+    assert_equal 2, attachments.size
+    file_paths.each { |path| assert File.exist?(path) }
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    attachments.each { |attachment| assert_not ActiveStorage::Attachment.exists?(attachment.id) }
+    blobs.each { |blob| assert_not ActiveStorage::Blob.exists?(blob.id) }
+    file_paths.each { |path| assert_not File.exist?(path) }
+  end
 end
