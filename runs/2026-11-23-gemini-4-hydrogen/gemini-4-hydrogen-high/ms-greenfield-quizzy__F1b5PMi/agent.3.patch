diff --git a/app/models/game.rb b/app/models/game.rb
new file mode 100644
index 0000000..a2c51c5
--- /dev/null
+++ b/app/models/game.rb
@@ -0,0 +1,180 @@
+class Game < ApplicationRecord
+  CODE_ALPHABET = "ABCDEFGHJKMNPQRSTUVWXYZ23456789".chars.freeze
+  CODE_LENGTH = 5
+
+  belongs_to :quiz
+  has_many :game_questions, -> { order(:position, :id) }, dependent: :destroy
+  has_many :players, -> { order(:created_at, :id) }, dependent: :destroy
+
+  enum :status, {
+    lobby: "lobby",
+    question_open: "question_open",
+    question_closed: "question_closed",
+    finished: "finished"
+  }, validate: true
+
+  validates :code, presence: true, uniqueness: true
+  validates :quiz_title, presence: true
+  validates :current_question_index, numericality: { only_integer: true, greater_than_or_equal_to: 0 }
+
+  def self.stream_verifier
+    Rails.application.message_verifier(:game_stream)
+  end
+
+  def self.create_from_quiz(quiz)
+    active = quiz.active_questions.includes(:options).to_a
+    game = new(quiz: quiz, quiz_title: quiz.title, status: :lobby, current_question_index: 0)
+
+    if active.empty?
+      game.errors.add(:base, "Add at least one active question before starting a game")
+      return game
+    end
+
+    transaction do
+      game.code = generate_unique_code
+      game.save!
+
+      active.each_with_index do |q, q_idx|
+        gq = game.game_questions.create!(
+          question: q,
+          position: q_idx + 1,
+          body: q.body
+        )
+        q.options.each_with_index do |opt, o_idx|
+          gq.game_options.create!(
+            option: opt,
+            position: o_idx + 1,
+            body: opt.body,
+            correct: opt.correct?
+          )
+        end
+      end
+    end
+
+    game
+  end
+
+  def self.generate_unique_code
+    loop do
+      candidate = Array.new(CODE_LENGTH) { CODE_ALPHABET.sample }.join
+      return candidate unless exists?(code: candidate)
+    end
+  end
+
+  def current_question
+    game_questions.includes(:game_options).find_by(position: current_question_index + 1)
+  end
+
+  def current_question_number
+    current_question_index + 1
+  end
+
+  def total_questions
+    game_questions.count
+  end
+
+  def last_question?
+    current_question_index >= total_questions - 1
+  end
+
+  def players_count
+    players.count
+  end
+
+  def current_answers_count
+    q = game_questions.find_by(position: current_question_index + 1)
+    q ? q.answers.count : 0
+  end
+
+  def state_version_for_moderator
+    "#{status}:#{current_question_index}:#{players_count}:#{current_answers_count}"
+  end
+
+  def state_version_for_player(player)
+    return "guest:#{status}" if player.nil?
+    return "finished" if finished?
+    return "lobby" if lobby?
+
+    q = game_questions.find_by(position: current_question_index + 1)
+    picked_id = q&.answers&.find_by(player_id: player.id)&.game_option_id
+    "#{status}:#{current_question_index}:#{picked_id || 'none'}"
+  end
+
+  def start!
+    with_lock do
+      return false unless lobby?
+      return false if game_questions.empty?
+
+      update!(
+        status: :question_open,
+        current_question_index: 0,
+        started_at: Time.current
+      )
+      true
+    end
+  end
+
+  def finish_question!
+    with_lock do
+      return false unless question_open?
+
+      update!(status: :question_closed)
+      true
+    end
+  end
+
+  def next_question!
+    with_lock do
+      return false unless question_closed?
+
+      if last_question?
+        update!(status: :finished, finished_at: Time.current)
+      else
+        update!(
+          status: :question_open,
+          current_question_index: current_question_index + 1
+        )
+      end
+      true
+    end
+  end
+
+  def join_player(name:)
+    with_lock do
+      return nil if finished?
+
+      player = players.build(name: name)
+      player.save
+      player
+    end
+  end
+
+  def submit_answer!(player:, game_option_id:)
+    with_lock do
+      return false unless question_open?
+
+      question = current_question
+      return false unless question
+
+      option = question.game_options.find_by(id: game_option_id)
+      return false unless option
+
+      answer = Answer.find_or_initialize_by(player: player, game_question: question)
+      answer.game_option = option
+      answer.save!
+      true
+    end
+  end
+
+  def signed_moderator_stream_token
+    self.class.stream_verifier.generate({ "role" => "moderator", "game_id" => id })
+  end
+
+  def signed_player_stream_token(player)
+    self.class.stream_verifier.generate({ "role" => "player", "game_id" => id, "player_id" => player.id })
+  end
+
+  def signed_guest_stream_token
+    self.class.stream_verifier.generate({ "role" => "guest", "game_id" => id })
+  end
+end
diff --git a/app/models/game_broadcaster.rb b/app/models/game_broadcaster.rb
new file mode 100644
index 0000000..8ff78bb
--- /dev/null
+++ b/app/models/game_broadcaster.rb
@@ -0,0 +1,168 @@
+class GameBroadcaster
+  def self.broadcast_counts(game)
+    ActionCable.server.broadcast(
+      "game:#{game.id}:moderator",
+      {
+        type: "counts",
+        players_count: game.players_count,
+        answers_count: game.current_answers_count,
+        state_version: game.state_version_for_moderator
+      }
+    )
+  end
+
+  def self.broadcast_start(game)
+    broadcast_moderator_stage(game)
+    broadcast_shared_question_open(game)
+  end
+
+  def self.broadcast_next_question(game)
+    if game.finished?
+      broadcast_game_finished(game)
+    else
+      broadcast_moderator_stage(game)
+      broadcast_shared_question_open(game)
+    end
+  end
+
+  def self.broadcast_finish_question(game)
+    broadcast_moderator_stage(game)
+
+    question = game.current_question
+    return unless question
+
+    answers_by_player_id = question.answers.pluck(:player_id, :game_option_id).to_h
+    html_cache = {}
+
+    game.players.select(:id).find_each do |player|
+      picked_id = answers_by_player_id[player.id]
+      state_version = "question_closed:#{game.current_question_index}:#{picked_id || 'none'}"
+      html = html_cache[picked_id] ||= render_player_question_closed(game, question, picked_id, state_version)
+
+      ActionCable.server.broadcast(
+        "game:#{game.id}:player:#{player.id}",
+        {
+          type: "replace",
+          html: html,
+          state_version: state_version
+        }
+      )
+    end
+  end
+
+  def self.broadcast_game_finished(game)
+    broadcast_moderator_stage(game)
+
+    player_html = render_player_finished(game, "finished")
+    ActionCable.server.broadcast(
+      "game:#{game.id}:players",
+      {
+        type: "replace",
+        html: player_html,
+        state_version: "finished"
+      }
+    )
+
+    guest_html = render_player_finished(game, "guest:finished")
+    ActionCable.server.broadcast(
+      "game:#{game.id}:guests",
+      {
+        type: "replace",
+        html: guest_html,
+        state_version: "guest:finished"
+      }
+    )
+  end
+
+  def self.broadcast_moderator_stage(game)
+    ActionCable.server.broadcast(
+      "game:#{game.id}:moderator",
+      {
+        type: "replace",
+        html: render_moderator_stage(game),
+        state_version: game.state_version_for_moderator
+      }
+    )
+  end
+
+  def self.broadcast_shared_question_open(game)
+    question = game.current_question
+    return unless question
+
+    state_version = "question_open:#{game.current_question_index}:none"
+    html = ApplicationController.renderer.render(
+      partial: "play/stage",
+      locals: {
+        game: game,
+        player: :joined,
+        question: question,
+        picked_option_id: nil,
+        state_version: state_version
+      }
+    )
+
+    ActionCable.server.broadcast(
+      "game:#{game.id}:players",
+      {
+        type: "replace",
+        html: html,
+        state_version: state_version
+      }
+    )
+  end
+
+  def self.render_moderator_stage(game)
+    ApplicationController.renderer.render(
+      partial: "moderate/games/stage",
+      locals: {
+        game: game,
+        join_display_url: nil,
+        join_qr_svg: nil
+      }
+    )
+  end
+
+  def self.render_player_stage(game, player)
+    question = (game.question_open? || game.question_closed?) ? game.current_question : nil
+    picked_option_id = if player && question
+                         question.answers.find_by(player_id: player.id)&.game_option_id
+    end
+
+    ApplicationController.renderer.render(
+      partial: "play/stage",
+      locals: {
+        game: game,
+        player: player,
+        question: question,
+        picked_option_id: picked_option_id,
+        state_version: game.state_version_for_player(player)
+      }
+    )
+  end
+
+  def self.render_player_question_closed(game, question, picked_option_id, state_version)
+    ApplicationController.renderer.render(
+      partial: "play/stage",
+      locals: {
+        game: game,
+        player: :joined,
+        question: question,
+        picked_option_id: picked_option_id,
+        state_version: state_version
+      }
+    )
+  end
+
+  def self.render_player_finished(game, state_version)
+    ApplicationController.renderer.render(
+      partial: "play/stage",
+      locals: {
+        game: game,
+        player: nil,
+        question: nil,
+        picked_option_id: nil,
+        state_version: state_version
+      }
+    )
+  end
+end
