--- /dev/null
+++ b/test/system/live_game_test.rb
@@ -0,0 +1,244 @@
+require "application_system_test_case"
+
+class LiveGameTest < ApplicationSystemTestCase
+  setup do
+    @quiz = Quiz.create!(title: "Conference Talk Live")
+    q1 = @quiz.questions.create!(body: "Which status means Too Many Requests?", active: true, position: 1)
+    q1.options.create!(body: "418", correct: false, position: 1)
+    q1.options.create!(body: "429", correct: true, position: 2)
+    q1.options.create!(body: "503", correct: false, position: 3)
+
+    q_inactive = @quiz.questions.create!(body: "Inactive question must be skipped", active: false, position: 2)
+    q_inactive.options.create!(body: "Alpha", correct: true, position: 1)
+    q_inactive.options.create!(body: "Beta", correct: false, position: 2)
+
+    q2 = @quiz.questions.create!(body: "Pick a valid HTTP method", active: true, position: 3)
+    q2.options.create!(body: "GET", correct: true, position: 1)
+    q2.options.create!(body: "POST", correct: true, position: 2)
+    q2.options.create!(body: "FOO", correct: false, position: 3)
+  end
+
+  test "full live game across moderator big screen and multiple player phones" do
+    join_url = nil
+
+    Capybara.using_session(:moderator) do
+      authenticate_as_moderator
+      visit moderate_quiz_path(@quiz)
+      assert_button "Start a game"
+      click_button "Start a game"
+
+      assert_current_path %r{\A/moderate/games/\d+\z}
+      assert_text "Conference Talk Live"
+      assert_text "Players: 0"
+      assert_selector ".qr svg"
+      assert_button "Start"
+
+      join_text = find('[data-testid="join-link"]').text.strip
+      assert_match %r{/play/[A-Z2-9]{5}\z}, join_text
+      join_url = join_text.start_with?("http") ? join_text : "http://#{join_text}"
+    end
+
+    # Guest sitting on join screen without joining yet
+    Capybara.using_session(:guest_watcher) do
+      visit join_url
+      assert_field "Your name"
+      assert_button "Join"
+    end
+
+    # Alice joins
+    Capybara.using_session(:alice) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+
+      # Reopening join link in same browser remembers Alice
+      visit join_url
+      assert_text "Hi, Alice!"
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 1"
+    end
+
+    # Bob joins
+    Capybara.using_session(:bob) do
+      visit join_url
+      fill_in "Your name", with: "Bob"
+      click_button "Join"
+      assert_text "Hi, Bob!"
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 2"
+      click_button "Start"
+
+      assert_text "Question 1 of 2"
+      assert_text "Which status means Too Many Requests?"
+      assert_text "418"
+      assert_text "429"
+      assert_text "503"
+      assert_text "Answers: 0 / 2"
+      assert_button "Finish"
+    end
+
+    # Both phones update live without reload!
+    Capybara.using_session(:alice) do
+      assert_text "Which status means Too Many Requests?"
+      assert_no_text "Correct"
+      assert_no_selector ".is-correct"
+      assert_not_includes page.html, "is-correct"
+
+      click_button "418"
+      within("button", text: "418") do
+        assert_text "Your answer"
+      end
+
+      # Change answer before Finish
+      click_button "429"
+      within("button", text: "429") do
+        assert_text "Your answer"
+      end
+      within("button", text: "418") do
+        assert_no_text "Your answer"
+      end
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 1 / 2"
+    end
+
+    # Charlie joins mid-question!
+    Capybara.using_session(:charlie) do
+      visit join_url
+      fill_in "Your name", with: "Charlie"
+      click_button "Join"
+      assert_text "Which status means Too Many Requests?"
+      click_button "503"
+      within("button", text: "503") do
+        assert_text "Your answer"
+      end
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 2 / 3"
+      click_button "Finish"
+
+      assert_text "Question 1 of 2"
