diff --git a/app/views/play/_stage.html.erb b/app/views/play/_stage.html.erb
new file mode 100644
index 0000000..11f1000
--- /dev/null
+++ b/app/views/play/_stage.html.erb
@@ -0,0 +1,106 @@
+<% joined = player.present? %>
+
+<% if game.finished? %>
+  <div id="play-stage" class="play__body" data-live-play-target="stage" data-state-version="<%= state_version %>">
+    <div class="result-card">
+      <h1>The quiz is over</h1>
+    </div>
+  </div>
+
+<% elsif !joined %>
+  <div id="play-stage" class="play__body" data-live-play-target="stage" data-state-version="<%= state_version %>">
+    <h1 class="play-title"><%= game.quiz_title %></h1>
+    <p class="play-lead">Enter your name to join the quiz.</p>
+
+    <% if defined?(@player_errors) && @player_errors.present? %>
+      <div class="errors">
+        <ul>
+          <% @player_errors.each do |msg| %>
+            <li><%= msg %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <%= form_with url: join_play_path(game.code), method: :post, class: "join-form", data: { turbo: false } do %>
+      <label for="player_name" class="visually-hidden">Your name</label>
+      <input type="text"
+             name="player[name]"
+             id="player_name"
+             value="<%= defined?(@entered_name) ? @entered_name : "" %>"
+             placeholder="Your name"
+             class="input"
+             required
+             autofocus
+             autocomplete="name">
+      <button type="submit" class="btn btn--pink">Join</button>
+    <% end %>
+  </div>
+
+<% elsif game.lobby? %>
+  <div id="play-stage" class="play__body" data-live-play-target="stage" data-state-version="<%= state_version %>">
+    <div class="waiting">
+      <div class="waiting__gem">?</div>
+      <h1>Hi, <%= player.name %>!</h1>
+      <p class="play-lead">Waiting for the quiz to start…</p>
+    </div>
+  </div>
+
+<% elsif game.question_open? %>
+  <div id="play-stage" class="play__body play__body--top" data-live-play-target="stage" data-state-version="<%= state_version %>">
+    <div class="play-question__num">Question <%= game.current_question_number %> of <%= game.total_questions %></div>
+    <div class="play-question__body"><%= question.body %></div>
+
+    <div class="play-options">
+      <% question.game_options.each do |option| %>
+        <% picked = (picked_option_id == option.id) %>
+        <%= button_to answer_play_path(game.code),
+              method: :post,
+              params: { game_option_id: option.id },
+              class: "play-option #{'is-picked' if picked}" do %>
+          <span class="play-option__letter"><%= option.letter %></span>
+          <span class="play-option__title"><%= option.body %></span>
+          <% if picked %>
+            <span class="play-option__mark">Your answer</span>
+          <% end %>
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+
+<% elsif game.question_closed? %>
+  <%
+    picked_option = picked_option_id ? question.game_options.find { |o| o.id == picked_option_id } : nil
+    if picked_option.nil?
+      status_text = "No answer"
+      status_class = "play-status play-status--neutral"
+    elsif picked_option.correct?
+      status_text = "Correct!"
+      status_class = "play-status play-status--right"
+    else
+      status_text = "Wrong!"
+      status_class = "play-status play-status--wrong"
+    end
+  %>
+  <div id="play-stage" class="play__body play__body--top" data-live-play-target="stage" data-state-version="<%= state_version %>">
+    <div class="play-question__num">Question <%= game.current_question_number %> of <%= game.total_questions %></div>
+    <div class="play-question__body"><%= question.body %></div>
+
+    <div class="play-options is-locked is-revealed">
+      <% question.game_options.each do |option| %>
+        <% picked = (picked_option_id == option.id) %>
+        <button type="button"
+                disabled
+                class="play-option <%= 'is-picked' if picked %> <%= 'is-correct' if option.correct? %>">
+          <span class="play-option__letter"><%= option.letter %></span>
+          <span class="play-option__title"><%= option.body %></span>
+          <% if option.correct? %>
+            <span class="play-option__mark">✓</span>
+          <% end %>
+        </button>
+      <% end %>
+    </div>
+
+    <div class="<%= status_class %>"><%= status_text %></div>
+  </div>
+<% end %>
