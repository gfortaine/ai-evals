diff --git a/app/channels/game_channel.rb b/app/channels/game_channel.rb
new file mode 100644
index 0000000..354f0c1
--- /dev/null
+++ b/app/channels/game_channel.rb
@@ -0,0 +1,76 @@
+class GameChannel < ApplicationCable::Channel
+  def subscribed
+    payload = Game.stream_verifier.verified(params[:token])
+    if payload.blank?
+      reject
+      return
+    end
+
+    @role = payload["role"]
+    @game_id = payload["game_id"]
+    @player_id = payload["player_id"]
+
+    case @role
+    when "moderator"
+      stream_from "game:#{@game_id}:moderator"
+    when "player"
+      stream_from "game:#{@game_id}:players"
+      stream_from "game:#{@game_id}:player:#{@player_id}"
+    when "guest"
+      stream_from "game:#{@game_id}:guests"
+    else
+      reject
+    end
+  end
+
+  def sync(data)
+    game = Game.find_by(id: @game_id)
+    return unless game
+
+    client_version = data["state_version"].to_s
+
+    case @role
+    when "moderator"
+      server_version = game.state_version_for_moderator
+      return if client_version == server_version
+
+      if game.lobby?
+        transmit({
+          type: "counts",
+          players_count: game.players_count,
+          answers_count: 0,
+          state_version: server_version
+        })
+      else
+        transmit({
+          type: "replace",
+          html: GameBroadcaster.render_moderator_stage(game),
+          state_version: server_version
+        })
+      end
+    when "player"
+      player = game.players.find_by(id: @player_id)
+      return unless player
+
+      server_version = game.state_version_for_player(player)
+      return if client_version == server_version
+
+      transmit({
+        type: "replace",
+        html: GameBroadcaster.render_player_stage(game, player),
+        state_version: server_version
+      })
+    when "guest"
+      server_version = game.state_version_for_player(nil)
+      return if client_version == server_version
+
+      if game.finished?
+        transmit({
+          type: "replace",
+          html: GameBroadcaster.render_player_stage(game, nil),
+          state_version: server_version
+        })
+      end
+    end
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
new file mode 100644
index 0000000..3c33dab
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,108 @@
+require "rqrcode"
+
+module Moderate
+  class GamesController < BaseController
+    layout "screen"
+
+    before_action :set_quiz, only: :create
+    before_action :set_game, only: %i[show start finish next state]
+
+    def create
+      @game = Game.create_from_quiz(@quiz)
+      if @game.persisted?
+        redirect_to moderate_game_path(@game)
+      else
+        redirect_to moderate_quiz_path(@quiz), alert: @game.errors.full_messages.to_sentence
+      end
+    end
+
+    def show
+      if @game.lobby?
+        @join_display_url = "#{request.host_with_port}#{play_path(@game.code)}"
+        qr = RQRCode::QRCode.new(play_url(@game.code))
+        @join_qr_svg = qr.as_svg(
+          color: "0d0640",
+          shape_rendering: "crispEdges",
+          module_size: 6,
+          standalone: true,
+          use_path: true,
+          viewbox: true
+        ).sub(/\A<\?xml[^>]+\?>/, "").html_safe
+      end
+    end
+
+    def start
+      if @game.start!
+        GameBroadcaster.broadcast_start(@game)
+      end
+      respond_with_stage
+    end
+
+    def finish
+      if @game.finish_question!
+        GameBroadcaster.broadcast_finish_question(@game)
+      end
+      respond_with_stage
+    end
+
+    def next
+      if @game.next_question!
+        GameBroadcaster.broadcast_next_question(@game)
+      end
+      respond_with_stage
+    end
+
+    def state
+      server_version = @game.state_version_for_moderator
+      if params[:state_version].to_s == server_version
+        render json: { changed: false }
+      elsif @game.lobby?
+        render json: {
+          changed: true,
+          type: "counts",
+          players_count: @game.players_count,
+          answers_count: 0,
+          state_version: server_version
+        }
+      else
+        html = render_to_string(
+          partial: "moderate/games/stage",
+          locals: { game: @game, join_display_url: nil, join_qr_svg: nil }
+        )
+        render json: {
+          changed: true,
+          type: "replace",
+          html: html,
+          state_version: server_version
+        }
+      end
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_game
+      @game = Game.find(params[:id])
+    end
+
+    def respond_with_stage
+      respond_to do |format|
+        format.turbo_stream do
+          if @game.lobby?
+            redirect_to moderate_game_path(@game), status: :see_other
+          else
+            render turbo_stream: turbo_stream.replace(
+              "stage",
+              partial: "moderate/games/stage",
+              locals: { game: @game, join_display_url: nil, join_qr_svg: nil }
+            )
+          end
+        end
+        format.html { redirect_to moderate_game_path(@game), status: :see_other }
+      end
+    end
+  end
+end
diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
index 0000000..1b2a940
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,123 @@
+class PlayController < ApplicationController
+  before_action :set_game
+  before_action :load_player
+
+  def show
+    assign_stage_variables
+  end
+
+  def join
+    if @game.finished?
+      redirect_to play_path(@game.code), status: :see_other
+      return
+    end
+
+    if @player
+      redirect_to play_path(@game.code), status: :see_other
+      return
+    end
+
+    new_player = @game.join_player(name: params.dig(:player, :name))
+    if new_player.nil?
+      redirect_to play_path(@game.code), status: :see_other
+    elsif new_player.persisted?
+      cookies.signed[player_cookie_name(@game)] = {
+        value: new_player.token,
+        expires: 7.days.from_now,
+        httponly: true,
+        same_site: :lax
+      }
+      GameBroadcaster.broadcast_counts(@game)
+      redirect_to play_path(@game.code), status: :see_other
+    else
+      @player_errors = new_player.errors.full_messages
+      @entered_name = params.dig(:player, :name)
+      assign_stage_variables
+      render :show, status: :unprocessable_entity
+    end
+  end
+
+  def answer
+    if @player.nil?
+      redirect_to play_path(@game.code), status: :see_other
+      return
+    end
+
+    if @game.submit_answer!(player: @player, game_option_id: params[:game_option_id])
+      GameBroadcaster.broadcast_counts(@game)
+    end
+
+    @game.reload
+    assign_stage_variables
+
+    respond_to do |format|
+      format.turbo_stream do
+        render turbo_stream: turbo_stream.replace(
+          "play-stage",
+          partial: "play/stage",
+          locals: {
+            game: @game,
+            player: @player,
+            question: @question,
+            picked_option_id: @picked_option_id,
+            state_version: @game.state_version_for_player(@player)
+          }
+        )
+      end
+      format.html { redirect_to play_path(@game.code), status: :see_other }
+    end
+  end
+
+  def state
+    server_version = @game.state_version_for_player(@player)
+    if params[:state_version].to_s == server_version || (@player.nil? && !@game.finished?)
+      render json: { changed: false }
+      return
+    end
+
+    assign_stage_variables
+    html = render_to_string(
+      partial: "play/stage",
+      locals: {
+        game: @game,
+        player: @player,
+        question: @question,
+        picked_option_id: @picked_option_id,
+        state_version: server_version
+      }
+    )
+
+    render json: {
+      changed: true,
+      type: "replace",
+      html: html,
+      state_version: server_version
+    }
+  end
+
+  private
+
+  def set_game
+    code = params[:code].to_s.strip.upcase
+    @game = Game.find_by(code: code)
+    render :not_found, status: :not_found unless @game
+  end
+
+  def load_player
+    return unless @game
+
+    token = cookies.signed[player_cookie_name(@game)]
+    @player = token.present? ? @game.players.find_by(token: token) : nil
+  end
+
+  def player_cookie_name(game)
+    "quizzy_player_#{game.code}"
+  end
+
+  def assign_stage_variables
+    @question = (@game.question_open? || @game.question_closed?) ? @game.current_question : nil
+    @picked_option_id = if @player && @question
+                          @question.answers.find_by(player_id: @player.id)&.game_option_id
+    end
+  end
+end
diff --git a/app/javascript/controllers/live_play_controller.js b/app/javascript/controllers/live_play_controller.js
new file mode 100644
index 0000000..399904d
--- /dev/null
+++ b/app/javascript/controllers/live_play_controller.js
@@ -0,0 +1,122 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+let sharedConsumer = null
+function getConsumer() {
+  if (!sharedConsumer) sharedConsumer = createConsumer()
+  return sharedConsumer
+}
+
+export default class extends Controller {
+  static values = {
+    token: String,
+    stateUrl: String
+  }
+
+  static targets = ["stage"]
+
+  connect() {
+    this.isConnected = false
+    this.pollTimer = null
+    this.connectTimeout = null
+
+    this.onVisibilityChange = () => {
+      if (document.visibilityState === "visible") {
+        this.isConnected ? this.sync() : this.pollState()
+      }
+    }
+    this.onOnline = () => {
+      this.isConnected ? this.sync() : this.pollState()
+    }
+
+    document.addEventListener("visibilitychange", this.onVisibilityChange)
+    window.addEventListener("online", this.onOnline)
+
+    this.connectTimeout = setTimeout(() => {
+      if (!this.isConnected) this.startPolling()
+    }, 3000)
+
+    this.subscription = getConsumer().subscriptions.create(
+      { channel: "GameChannel", token: this.tokenValue },
+      {
+        connected: () => {
+          this.isConnected = true
+          if (this.connectTimeout) {
+            clearTimeout(this.connectTimeout)
+            this.connectTimeout = null
+          }
+          this.stopPolling()
+          this.sync()
+        },
+        disconnected: () => {
+          this.isConnected = false
+          this.startPolling()
+        },
+        rejected: () => {
+          this.isConnected = false
+          this.startPolling()
+        },
+        received: (data) => {
+          this.applyUpdate(data)
+        }
+      }
+    )
+  }
+
+  disconnect() {
+    document.removeEventListener("visibilitychange", this.onVisibilityChange)
+    window.removeEventListener("online", this.onOnline)
+    if (this.connectTimeout) clearTimeout(this.connectTimeout)
+    this.stopPolling()
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+  }
+
+  currentStateVersion() {
+    return this.hasStageTarget ? (this.stageTarget.dataset.stateVersion || "") : ""
+  }
+
+  sync() {
+    if (this.subscription && this.isConnected) {
+      this.subscription.perform("sync", { state_version: this.currentStateVersion() })
+    }
+  }
+
+  startPolling() {
+    if (this.pollTimer || !this.hasStateUrlValue) return
+    this.pollTimer = setInterval(() => this.pollState(), 2500)
+  }
+
+  stopPolling() {
+    if (this.pollTimer) {
+      clearInterval(this.pollTimer)
+      this.pollTimer = null
+    }
+  }
+
+  async pollState() {
+    if (!this.hasStateUrlValue) return
+    try {
+      const url = `${this.stateUrlValue}?state_version=${encodeURIComponent(this.currentStateVersion())}`
+      const response = await fetch(url, { headers: { Accept: "application/json" } })
+      if (!response.ok) return
+      const data = await response.json()
+      if (data && data.changed) {
+        this.applyUpdate(data)
+      }
+    } catch (_) {
+      // Network hiccup; retry on next tick or reconnect
+    }
+  }
+
+  applyUpdate(data) {
+    if (!data || !data.state_version) return
+    if (data.state_version === this.currentStateVersion()) return
+
+    if (data.type === "replace" && data.html && this.hasStageTarget) {
+      this.stageTarget.outerHTML = data.html
+    }
+  }
+}
