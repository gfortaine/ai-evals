diff --git a/docs/architecture.md b/docs/architecture.md
index 99b09a7..340640b 100644
--- a/docs/architecture.md
+++ b/docs/architecture.md
@@ -17,3 +17,11 @@
 ## Quiz Export & Import
 - Export (`GET /moderate/quizzes/:id/export`) serializes `Quiz#export_payload` with `JSON.pretty_generate` inside a single `<pre>` element, writing only `title`, `questions` (`text`, `active`, `options`), and `options` (`text`, `correct`) in preserved order.
 - Import (`GET /moderate/quizzes/import`, `POST /moderate/quizzes/import`) is handled by `QuizImport` (`ActiveModel::Model`), validating structure and question/option rules atomically inside a transaction so invalid payloads import nothing. `active` defaults to `true` and `correct` defaults to `false` when omitted.
+
+## Live Game (Release 2)
+- `Game` (`quiz_id`, `code`, `quiz_title`, `status`, `current_question_index`, `started_at`, `finished_at`) snapshots active questions and options into `GameQuestion` and `GameOption` via `Game.create_from_quiz`, skipping inactive questions and isolating running/past games from later quiz edits.
+- `Player` (`game_id`, `name`, `token`) is remembered per game via a signed HTTP-only cookie (`quizzy_player_<code>`).
+- `Answer` has a unique index on `[player_id, game_question_id]` so changing an answer updates the single row (`last pick counts`).
+- Moderator big screen lives at `/moderate/games/:id` (`Moderate::GamesController`, layout `screen`) and uses `rqrcode` (`RQRCode::QRCode`) to render the join link QR code as an inline `<svg>`.
+- Player flow lives at `/play/:code` (`PlayController`) and never renders `correct` / `is-correct` in HTML or ActionCable payloads while a question is open.
+- Live updates use `GameChannel` (authorized via signed `ActiveSupport::MessageVerifier` tokens) and `GameBroadcaster` (`async` adapter in `config/cable.yml`), paired with `live_screen_controller.js` / `live_play_controller.js` that sync state on WebSocket connect/reconnect/`visibilitychange`/`online` and fall back to `/state` JSON polling if WebSocket is disconnected on flaky conference Wi-Fi.
diff --git a/test/controllers/live_game_test.rb b/test/controllers/live_game_test.rb
new file mode 100644
index 0000000..cb59563
--- /dev/null
+++ b/test/controllers/live_game_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class LiveGameTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = Quiz.create!(title: "API Quiz")
+    @q1 = @quiz.questions.create!(body: "Secret question?", active: true)
+    @q1.options.create!(body: "Decoy", correct: false, position: 1)
+    @q1.options.create!(body: "SuperSecretAnswer", correct: true, position: 2)
+  end
+
+  test "moderator game endpoints require HTTP basic auth" do
+    post moderate_quiz_games_path(@quiz)
+    assert_response :unauthorized
+
+    game = Game.create_from_quiz(@quiz)
+    get moderate_game_path(game)
+    assert_response :unauthorized
+
+    patch start_moderate_game_path(game)
+    assert_response :unauthorized
+
+    patch finish_moderate_game_path(game)
+    assert_response :unauthorized
+
+    patch next_moderate_game_path(game)
+    assert_response :unauthorized
+  end
+
+  test "player page does not leak correct answer before question is closed" do
+    game = Game.create_from_quiz(@quiz)
+    game.start!
+
+    # Join as player
+    post join_play_path(game.code), params: { player: { name: "Alice" } }
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+
+    assert_includes response.body, "Secret question?"
+    assert_includes response.body, "Decoy"
+    assert_includes response.body, "SuperSecretAnswer"
+    assert_not_includes response.body, "is-correct"
+    assert_not_includes response.body, "Correct"
+
+    # Submit wrong answer via turbo_stream; response must still not leak correct option
+    wrong_opt = game.current_question.game_options.find_by!(body: "Decoy")
+    post answer_play_path(game.code),
+         params: { game_option_id: wrong_opt.id },
+         headers: { "Accept" => "text/vnd.turbo-stream.html" }
+    assert_response :success
+    assert_includes response.body, "Your answer"
+    assert_not_includes response.body, "is-correct"
+    assert_not_includes response.body, "Correct!"
+  end
+
+  test "lowercase code works, unknown code returns 404, and finished game rejects joins" do
+    game = Game.create_from_quiz(@quiz)
+    get play_path(game.code.downcase)
+    assert_response :success
+    assert_includes response.body, "API Quiz"
+
+    get play_path("ZZZZZ")
+    assert_response :not_found
+
+    game.start!
+    game.finish_question!
+    game.next_question!
+    assert game.finished?
+
+    post join_play_path(game.code), params: { player: { name: "Latecomer" } }
+    assert_redirected_to play_path(game.code)
+    follow_redirect!
+    assert_includes response.body, "The quiz is over"
+    assert_equal 0, game.players.count
+  end
+end
diff --git a/test/models/game_test.rb b/test/models/game_test.rb
new file mode 100644
index 0000000..565eee4
--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Ruby Conf")
+    @q1 = @quiz.questions.create!(body: "First active?", active: true)
+    @q1_a = @q1.options.create!(body: "Wrong", correct: false, position: 1)
+    @q1_b = @q1.options.create!(body: "Right", correct: true, position: 2)
+
+    @q_inactive = @quiz.questions.create!(body: "Skipped?", active: false)
+    @q_inactive.options.create!(body: "A", correct: true, position: 1)
+    @q_inactive.options.create!(body: "B", correct: false, position: 2)
+
+    @q2 = @quiz.questions.create!(body: "Second active?", active: true)
+    @q2_a = @q2.options.create!(body: "Yes", correct: true, position: 1)
+    @q2_b = @q2.options.create!(body: "No", correct: false, position: 2)
+  end
+
+  test "create_from_quiz snapshots active questions and skips inactive ones" do
+    game = Game.create_from_quiz(@quiz)
+    assert game.persisted?
+    assert game.lobby?
+    assert_equal "Ruby Conf", game.quiz_title
+    assert_match(/\A[A-Z2-9]{5}\z/, game.code)
+    assert_equal [ "First active?", "Second active?" ], game.game_questions.pluck(:body)
+
+    # Editing or destroying original quiz questions does not break the game
+    @q1.update!(body: "Edited later")
+    @q2.destroy!
+    game.reload
+    assert_equal [ "First active?", "Second active?" ], game.game_questions.pluck(:body)
+  end
+
+  test "create_from_quiz fails if there are no active questions" do
+    @quiz.questions.update_all(active: false)
+    game = Game.create_from_quiz(@quiz)
+    assert_not game.persisted?
+    assert_includes game.errors.full_messages.join(" "), "active question"
+  end
+
+  test "game lifecycle, joining, changing answers, and locking" do
+    game = Game.create_from_quiz(@quiz)
+    alice = game.join_player(name: "  Alice  ")
+    assert alice.persisted?
+    assert_equal "Alice", alice.name
+
+    # Cannot submit answer in lobby
+    gq1 = game.game_questions.first
+    opt_wrong = gq1.game_options.find_by(body: "Wrong")
+    opt_right = gq1.game_options.find_by(body: "Right")
+    assert_not game.submit_answer!(player: alice, game_option_id: opt_right.id)
+
+    assert game.start!
+    assert game.question_open?
+    assert_equal 1, game.current_question_number
+    assert_equal 2, game.total_questions
+    assert_not game.last_question?
+
+    # First pick and changing pick
+    assert game.submit_answer!(player: alice, game_option_id: opt_wrong.id)
+    assert game.submit_answer!(player: alice, game_option_id: opt_right.id)
+    assert_equal 1, gq1.answers.count
+    assert_equal opt_right.id, gq1.answers.find_by(player: alice).game_option_id
+
+    # Finish question locks answers
+    assert game.finish_question!
+    assert game.question_closed?
+    assert_not game.submit_answer!(player: alice, game_option_id: opt_wrong.id)
+    assert_equal opt_right.id, gq1.answers.find_by(player: alice).game_option_id
+
+    # Next question
+    assert game.next_question!
+    assert game.question_open?
+    assert_equal 2, game.current_question_number
+    assert game.last_question?
+
+    assert game.finish_question!
+    assert game.next_question!
+    assert game.finished?
+
+    # Cannot join after finished
+    assert_nil game.join_player(name: "Late")
+  end
+end
diff --git a/test/system/live_game_test.rb b/test/system/live_game_test.rb
