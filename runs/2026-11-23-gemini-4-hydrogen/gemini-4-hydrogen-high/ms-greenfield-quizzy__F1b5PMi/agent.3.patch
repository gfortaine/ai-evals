diff --git a/app/views/moderate/games/_stage.html.erb b/app/views/moderate/games/_stage.html.erb
new file mode 100644
index 0000000..ecc2c42
--- /dev/null
+++ b/app/views/moderate/games/_stage.html.erb
@@ -0,0 +1,86 @@
+<%
+  cover_class = case game.status
+                when "lobby" then "cover"
+                when "finished" then "cover cover--night"
+                else "cover cover--blue cover--calm"
+                end
+%>
+<div id="stage" data-live-screen-target="stage" data-state-version="<%= game.state_version_for_moderator %>">
+  <section class="<%= cover_class %>">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+        <span><%= game.quiz_title %></span>
+      </div>
+
+      <div class="screen__body">
+        <% if game.lobby? %>
+          <div class="lobby">
+            <div>
+              <h1 class="lobby__title"><%= game.quiz_title %></h1>
+              <div class="lobby__join">Join at</div>
+              <div class="lobby__url" data-testid="join-link"><%= join_display_url %></div>
+              <div class="counter-pill" id="lobby-players-count"><span>Players: <strong><%= game.players_count %></strong></span></div>
+            </div>
+            <div class="qr" aria-label="QR code for <%= join_display_url %>">
+              <%= join_qr_svg %>
+            </div>
+          </div>
+
+        <% elsif game.question_open? || game.question_closed? %>
+          <% question = game.current_question %>
+          <% counts = game.question_closed? ? question.answer_counts_by_option_id : {} %>
+          <% total_answers = counts.values.sum %>
+          <div class="stage-question__num">Question <%= game.current_question_number %> of <%= game.total_questions %></div>
+          <div class="stage-question__body"><%= question.body %></div>
+
+          <ol class="stage-options <%= "stage-options--results" if game.question_closed? %>">
+            <% question.game_options.each do |option| %>
+              <% if game.question_closed? %>
+                <% count = counts.fetch(option.id, 0) %>
+                <% share = total_answers > 0 ? (count * 100.0 / total_answers).round : 0 %>
+                <li class="stage-option <%= "is-correct" if option.correct? %>">
+                  <span class="stage-option__bar" style="--share: <%= share %>%"></span>
+                  <span class="stage-option__letter"><%= option.letter %></span>
+                  <span class="stage-option__title"><%= option.body %></span>
+                  <% if option.correct? %>
+                    <span class="stage-option__mark">Correct</span>
+                  <% end %>
+                  <span class="stage-option__count"><%= count %></span>
+                </li>
+              <% else %>
+                <li class="stage-option">
+                  <span class="stage-option__letter"><%= option.letter %></span>
+                  <span class="stage-option__title"><%= option.body %></span>
+                </li>
+              <% end %>
+            <% end %>
+          </ol>
+
+        <% elsif game.finished? %>
+          <div class="screen__kicker"><%= game.quiz_title %></div>
+          <h1 class="lobby__title">The quiz is over</h1>
+        <% end %>
+      </div>
+    </div>
+
+    <div class="screen-controls">
+      <div class="screen-controls__info">
+        <%= link_to "Back to quiz", moderate_quiz_path(game.quiz_id) %>
+        <% if game.question_open? || game.question_closed? %>
+          <span class="answers-counter" id="answers-counter">Answers: <%= game.current_answers_count %> / <%= game.players_count %></span>
+        <% end %>
+      </div>
+      <div class="buttons">
+        <% if game.lobby? %>
+          <%= button_to "Start", start_moderate_game_path(game), method: :patch, class: "btn btn--pink btn--lg" %>
+        <% elsif game.question_open? %>
+          <%= button_to "Finish", finish_moderate_game_path(game), method: :patch, class: "btn btn--pink btn--lg" %>
+        <% elsif game.question_closed? %>
+          <% next_label = game.last_question? ? "End quiz" : "Next" %>
+          <%= button_to next_label, next_moderate_game_path(game), method: :patch, class: "btn btn--pink btn--lg" %>
+        <% end %>
+      </div>
+    </div>
+  </section>
+</div>
