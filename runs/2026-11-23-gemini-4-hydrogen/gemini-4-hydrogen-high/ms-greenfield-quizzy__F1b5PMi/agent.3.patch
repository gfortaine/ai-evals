+    }
+  }
+
+  applyUpdate(data) {
+    if (!data || !data.state_version) return
+    if (data.state_version === this.currentStateVersion()) return
+
+    if (data.type === "counts") {
+      const lobbyCounter = document.getElementById("lobby-players-count")
+      if (lobbyCounter) {
+        lobbyCounter.innerHTML = ""
+        const span = document.createElement("span")
+        span.appendChild(document.createTextNode("Players: "))
+        const strong = document.createElement("strong")
+        strong.textContent = String(data.players_count)
+        span.appendChild(strong)
+        lobbyCounter.appendChild(span)
+      }
+      const answersCounter = document.getElementById("answers-counter")
+      if (answersCounter) {
+        answersCounter.textContent = `Answers: ${data.answers_count} / ${data.players_count}`
+      }
+      if (this.hasStageTarget) {
+        this.stageTarget.dataset.stateVersion = data.state_version
+      }
+    } else if (data.type === "replace" && data.html && this.hasStageTarget) {
+      this.stageTarget.outerHTML = data.html
+    }
+  }
+}
