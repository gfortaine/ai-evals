@@ -0,0 +1,65 @@
+require "application_system_test_case"
+
+class ExportImportTest < ApplicationSystemTestCase
+  test "moderator exports a quiz and imports it as a new quiz" do
+    authenticate_as_moderator
+
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+    q1 = quiz.questions.build(body: 'Which HTTP status code means "Too Many Requests"?', active: true)
+    q1.save_with_option_rows([
+      Question::OptionRow.new(id: nil, body: "418", correct: false),
+      Question::OptionRow.new(id: nil, body: "429", correct: true)
+    ])
+    q2 = quiz.questions.build(body: "Draft question <1 & 2>", active: false)
+    q2.save_with_option_rows([
+      Question::OptionRow.new(id: nil, body: "Yes", correct: true),
+      Question::OptionRow.new(id: nil, body: "No", correct: false)
+    ])
+
+    visit moderate_quiz_path(quiz)
+    click_link "Export"
+
+    pre_elements = all("pre")
+    assert_equal 1, pre_elements.size
+    exported_json = pre_elements.first.text
+
+    parsed = JSON.parse(exported_json)
+    assert_equal %w[title questions], parsed.keys
+    assert_equal "Frontend Fest 2026", parsed["title"]
+    assert_equal 2, parsed["questions"].size
+    assert_equal true, parsed["questions"][0]["active"]
+    assert_equal false, parsed["questions"][1]["active"]
+    assert_equal [
+      { "text" => "418", "correct" => false },
+      { "text" => "429", "correct" => true }
+    ], parsed["questions"][0]["options"]
+
+    visit "/moderate"
+    click_on "Import quiz"
+
+    # Invalid JSON shows error and imports nothing
+    fill_in "Quiz JSON", with: '{"title": "Broken", "questions": [{"text": "Q1", "options": [{"text": "A"}]}]}'
+    click_button "Import"
+    assert_text "Add at least two options"
+    assert_text "Mark at least one option as correct"
+    assert_equal 1, Quiz.count
+
+    # Valid exported JSON creates a new quiz even though title already exists, and opens its page
+    fill_in "Quiz JSON", with: exported_json
+    click_button "Import"
+
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_text "1 of 2 questions active"
+    assert_equal 2, Quiz.count
+    assert_not_equal moderate_quiz_path(quiz), current_path
+
+    items = all("ul.question-list > li")
+    assert_equal 2, items.size
+    assert_includes items[0].text, 'Which HTTP status code means "Too Many Requests"?'
+    assert_includes items[1].text, "Draft question <1 & 2>"
+
