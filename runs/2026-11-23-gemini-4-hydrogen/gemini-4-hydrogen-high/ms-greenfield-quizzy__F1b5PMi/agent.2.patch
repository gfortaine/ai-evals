@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Moderate::QuizExportImportTest < ActionDispatch::IntegrationTest
+  test "export and import endpoints require authentication" do
+    quiz = Quiz.create!(title: "Auth Quiz")
+
+    [
+      [ :get, export_moderate_quiz_path(quiz) ],
+      [ :get, import_moderate_quizzes_path ],
+      [ :post, import_moderate_quizzes_path ]
+    ].each do |method, path|
+      public_send(method, path)
+      assert_response :unauthorized
+
+      public_send(method, path, headers: moderator_auth_headers("wrong", "wrong"))
+      assert_response :unauthorized
+    end
+  end
+
+  test "export renders quiz JSON in a single pre element" do
+    quiz = Quiz.create!(title: "Exportable <Quiz> & \"More\"")
+    q = quiz.questions.build(body: "Pick one", active: false)
+    q.save_with_option_rows([
+      Question::OptionRow.new(id: nil, body: "First", correct: false),
+      Question::OptionRow.new(id: nil, body: "Second", correct: true)
+    ])
+
+    get export_moderate_quiz_path(quiz), headers: moderator_auth_headers
+    assert_response :ok
+
+    pres = css_select("pre")
+    assert_equal 1, pres.size
+    parsed = JSON.parse(pres.first.text)
+    assert_equal quiz.export_payload, parsed
+  end
+
+  test "import creates quiz and redirects to it, or renders errors with 422" do
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      post import_moderate_quizzes_path,
+           params: { quiz_import: { json: "{invalid" } },
+           headers: moderator_auth_headers
+    end
+    assert_response :unprocessable_entity
+    assert_includes response.body, "Invalid JSON"
+
+    valid_json = {
+      title: "Imported Talk",
+      questions: [
+        {
+          text: "Works?",
+          options: [
+            { text: "Yes", correct: true },
+            { text: "No" }
+          ]
+        }
+      ]
+    }.to_json
+
+    assert_difference "Quiz.count", 1 do
+      post import_moderate_quizzes_path,
+           params: { quiz_import: { json: valid_json } },
+           headers: moderator_auth_headers
+    end
+
+    created = Quiz.order(:id).last
+    assert_redirected_to moderate_quiz_path(created)
+  end
+end
diff --git a/test/models/quiz_import_test.rb b/test/models/quiz_import_test.rb
new file mode 100644
index 0000000..390dcd4
--- /dev/null
+++ b/test/models/quiz_import_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+class QuizImportTest < ActiveSupport::TestCase
+  test "exports exact keys and preserves question and option order" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+    q1 = quiz.questions.build(body: 'Which HTTP status code means "Too Many Requests"?', active: true)
+    q1.save_with_option_rows([
+      Question::OptionRow.new(id: nil, body: "418", correct: false),
+      Question::OptionRow.new(id: nil, body: "429", correct: true)
+    ])
+    q2 = quiz.questions.build(body: "Inactive question", active: false)
+    q2.save_with_option_rows([
+      Question::OptionRow.new(id: nil, body: "Alpha", correct: true),
+      Question::OptionRow.new(id: nil, body: "Beta", correct: true),
+      Question::OptionRow.new(id: nil, body: "Gamma", correct: false)
+    ])
+
+    q2.move_up!
+
+    payload = quiz.export_payload
+    assert_equal %w[title questions], payload.keys
+    assert_equal "Frontend Fest 2026", payload["title"]
+    assert_equal 2, payload["questions"].size
+
+    first_q = payload["questions"][0]
+    assert_equal %w[text active options], first_q.keys
+    assert_equal "Inactive question", first_q["text"]
+    assert_equal false, first_q["active"]
+    assert_equal [
+      { "text" => "Alpha", "correct" => true },
+      { "text" => "Beta", "correct" => true },
+      { "text" => "Gamma", "correct" => false }
+    ], first_q["options"]
+    first_q["options"].each { |opt| assert_equal %w[text correct], opt.keys }
+
+    second_q = payload["questions"][1]
+    assert_equal %w[text active options], second_q.keys
+    assert_equal 'Which HTTP status code means "Too Many Requests"?', second_q["text"]
+    assert_equal true, second_q["active"]
+    assert_equal [
+      { "text" => "418", "correct" => false },
+      { "text" => "429", "correct" => true }
+    ], second_q["options"]
+  end
+
+  test "imports valid quiz JSON with defaults for active and correct and allows duplicate titles" do
+    existing = Quiz.create!(title: "Conference Quiz")
+
+    json = <<~JSON
+      {
+        "title": "  Conference Quiz  ",
+        "questions": [
+          {
+            "text": "  Question One  ",
+            "options": [
+              {"text": "Wrong by default"},
+              {"text": "Right", "correct": true}
+            ]
+          },
+          {
+            "text": "Question Two",
+            "active": false,
+            "options": [
+              {"text": "A", "correct": true},
+              {"text": "B", "correct": false},
+              {"text": "C", "correct": true}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    import = QuizImport.new(json: json)
+    assert import.save, import.errors.full_messages.join(", ")
+
+    imported = import.quiz
+    assert_not_equal existing.id, imported.id
+    assert_equal "Conference Quiz", imported.title
+
+    questions = imported.questions.order(:position, :id).to_a
+    assert_equal [ "Question One", "Question Two" ], questions.map(&:body)
+    assert_equal [ true, false ], questions.map(&:active?)
+    assert_equal [ 1, 2 ], questions.map(&:position)
+
+    q1_opts = questions[0].options.order(:position, :id).to_a
+    assert_equal [ "Wrong by default", "Right" ], q1_opts.map(&:body)
+    assert_equal [ false, true ], q1_opts.map(&:correct?)
+    assert_equal [ 1, 2 ], q1_opts.map(&:position)
+
+    q2_opts = questions[1].options.order(:position, :id).to_a
+    assert_equal [ "A", "B", "C" ], q2_opts.map(&:body)
+    assert_equal [ true, false, true ], q2_opts.map(&:correct?)
+  end
+
+  test "imports quiz with empty questions array" do
+    import = QuizImport.new(json: '{"title": "Empty Quiz", "questions": []}')
+    assert import.save
+    assert_equal "Empty Quiz", import.quiz.title
+    assert_equal 0, import.quiz.questions.count
+  end
+
+  test "rejects invalid JSON or rule violations atomically without partial imports" do
+    invalid_payloads = [
+      "",
+      "   ",
+      "{not valid json",
+      "[]",
+      '"just a string"',
+      '{"questions": []}',
+      '{"title": "   ", "questions": []}',
+      '{"title": 123, "questions": []}',
+      '{"title": "No questions key"}',
+      '{"title": "Bad questions", "questions": {}}',
+      '{"title": "Bad question item", "questions": ["text"]}',
+      '{"title": "Blank question", "questions": [{"text": "  ", "options": [{"text": "A", "correct": true}, {"text": "B"}]}]}',
+      '{"title": "Bad active", "questions": [{"text": "Q1", "active": "yes", "options": [{"text": "A", "correct": true}, {"text": "B"}]}]}',
+      '{"title": "Missing options", "questions": [{"text": "Q1"}]}',
+      '{"title": "One option", "questions": [{"text": "Q1", "options": [{"text": "A", "correct": true}]}]}',
+      '{"title": "No correct option", "questions": [{"text": "Q1", "options": [{"text": "A", "correct": false}, {"text": "B"}]}]}',
+      '{"title": "Blank option", "questions": [{"text": "Q1", "options": [{"text": "A", "correct": true}, {"text": "   ", "correct": false}]}]}',
+      '{"title": "Bad correct", "questions": [{"text": "Q1", "options": [{"text": "A", "correct": "yes"}, {"text": "B", "correct": true}]}]}',
+      # First question valid, second question invalid -> nothing imported!
+      '{"title": "Partial fail", "questions": [{"text": "Good", "options": [{"text": "A", "correct": true}, {"text": "B"}]}, {"text": "Bad", "options": [{"text": "Only one", "correct": true}]}]}'
+    ]
+
+    invalid_payloads.each do |payload|
+      assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ], "Expected nothing created for: #{payload}" do
+        import = QuizImport.new(json: payload)
+        assert_not import.save, "Expected failure for: #{payload}"
+        assert import.errors.any?, "Expected errors for: #{payload}"
+      end
+    end
+  end
+end
