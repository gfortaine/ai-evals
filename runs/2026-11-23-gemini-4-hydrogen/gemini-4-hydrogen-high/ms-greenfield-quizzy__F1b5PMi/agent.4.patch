+
+class GameScoringAndPrizesTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Prizes Conf", winners_count: 2)
+    @q1 = @quiz.questions.create!(body: "Q1", active: true)
+    @q1.options.create!(body: "Right", correct: true, position: 1)
+    @q1.options.create!(body: "Wrong", correct: false, position: 2)
+
+    @q2 = @quiz.questions.create!(body: "Q2", active: true)
+    @q2.options.create!(body: "Right", correct: true, position: 1)
+    @q2.options.create!(body: "Wrong", correct: false, position: 2)
+  end
+
+  test "create_from_quiz snapshots winners_count" do
+    game = Game.create_from_quiz(@quiz)
+    assert_equal 2, game.winners_count
+
+    @quiz.update!(winners_count: 5)
+    assert_equal 2, game.reload.winners_count
+  end
+
+  test "scoring counts correct answers and ranks ties by total time of correct answers using last pick" do
+    game = Game.create_from_quiz(@quiz)
+    alice = game.join_player(name: "Alice")
+    bob = game.join_player(name: "Bob")
+    carol = game.join_player(name: "Carol")
+    dave = game.join_player(name: "Dave")
+
+    t0 = Time.zone.parse("2026-11-22 12:00:00.000")
+    travel_to(t0) { game.start! }
+    gq1 = game.game_questions.first
+    gq1_right = gq1.game_options.find_by!(correct: true)
+    gq1_wrong = gq1.game_options.find_by!(correct: false)
+
+    # Alice picks right at +1s, then changes to right (or wrong->right) at +5s -> Q1 time = 5s
+    travel_to(t0 + 1.second) { game.submit_answer!(player: alice, game_option_id: gq1_right.id) }
+    travel_to(t0 + 5.seconds) { game.submit_answer!(player: alice, game_option_id: gq1_right.id) }
+
+    # Bob picks wrong at +0.5s, then changes to right at +3s -> Q1 time = 3s
+    travel_to(t0 + 0.5.seconds) { game.submit_answer!(player: bob, game_option_id: gq1_wrong.id) }
+    travel_to(t0 + 3.seconds) { game.submit_answer!(player: bob, game_option_id: gq1_right.id) }
+
+    # Carol picks wrong at +0.2s -> 0 pts (this wrong answer's time must NOT count)
+    travel_to(t0 + 0.2.seconds) { game.submit_answer!(player: carol, game_option_id: gq1_wrong.id) }
+
+    # Dave picks wrong at +0.1s -> 0 pts
+    travel_to(t0 + 0.1.seconds) { game.submit_answer!(player: dave, game_option_id: gq1_wrong.id) }
+
+    game.finish_question!
+
+    t1 = t0 + 20.seconds
+    travel_to(t1) { game.next_question! }
+    gq2 = game.game_questions.second
+    gq2_right = gq2.game_options.find_by!(correct: true)
+    gq2_wrong = gq2.game_options.find_by!(correct: false)
+
+    # Q2: Alice picks right at +1s (total = 5 + 1 = 6s, 2 pts)
+    travel_to(t1 + 1.second) { game.submit_answer!(player: alice, game_option_id: gq2_right.id) }
+    # Q2: Bob picks right at +2s (total = 3 + 2 = 5s, 2 pts -> faster than Alice!)
+    travel_to(t1 + 2.seconds) { game.submit_answer!(player: bob, game_option_id: gq2_right.id) }
+    # Q2: Carol picks right at +10s (1 pt, 10s)
+    travel_to(t1 + 10.seconds) { game.submit_answer!(player: carol, game_option_id: gq2_right.id) }
+    # Q2: Dave picks wrong (0 pts)
+    travel_to(t1 + 0.5.seconds) { game.submit_answer!(player: dave, game_option_id: gq2_wrong.id) }
+
+    game.finish_question!
+    game.next_question!
+    assert game.finished?
+
+    lb = game.leaderboard
+    assert_equal [ "Bob", "Alice", "Carol", "Dave" ], lb.map(&:name)
+    assert_equal [ 1, 2, 3, 4 ], lb.map(&:place)
+    assert_equal [ 2, 2, 1, 0 ], lb.map(&:points)
+    assert_in_delta 5.0, lb[0].total_time, 0.05
+    assert_in_delta 6.0, lb[1].total_time, 0.05
+    assert_in_delta 10.0, lb[2].total_time, 0.05
+    assert_in_delta 0.0, lb[3].total_time, 0.05
+  end
+
+  test "pick_top_winners!, draw_winners!, and reset_winners! obey all winner rules" do
+    @quiz.update!(winners_count: 2)
+    game = Game.create_from_quiz(@quiz)
+    p1 = game.join_player(name: "P1") # 2 pts
+    p2 = game.join_player(name: "P2") # 1 pt, fast
+    p3 = game.join_player(name: "P3") # 1 pt, medium
+    p4 = game.join_player(name: "P4") # 1 pt, slow
+    p5 = game.join_player(name: "P5") # 0 pts
+
+    t0 = Time.zone.parse("2026-11-22 12:00:00.000")
+    travel_to(t0) { game.start! }
+    gq1 = game.game_questions.first
+    gq1_right = gq1.game_options.find_by!(correct: true)
+    travel_to(t0 + 1.second) { game.submit_answer!(player: p1, game_option_id: gq1_right.id) }
+    game.finish_question!
+
+    t1 = t0 + 10.seconds
+    travel_to(t1) { game.next_question! }
+    gq2 = game.game_questions.second
+    gq2_right = gq2.game_options.find_by!(correct: true)
+    travel_to(t1 + 1.second) { game.submit_answer!(player: p1, game_option_id: gq2_right.id) }
+    travel_to(t1 + 2.seconds) { game.submit_answer!(player: p2, game_option_id: gq2_right.id) }
+    travel_to(t1 + 3.seconds) { game.submit_answer!(player: p3, game_option_id: gq2_right.id) }
+    travel_to(t1 + 4.seconds) { game.submit_answer!(player: p4, game_option_id: gq2_right.id) }
+
+    # Cannot pick before finished
+    assert_not game.pick_top_winners!
+    assert_not game.draw_winners!
+
+    game.finish_question!
+    game.next_question!
+    assert game.finished?
+
+    # Top 2 -> P1 and P2
+    assert game.pick_top_winners!
+    assert_equal [ p1.id, p2.id ], game.players.where(winner: true).order(:id).pluck(:id)
+
+    # Reset winners
+    assert game.reset_winners!
+    assert_equal [], game.players.where(winner: true).pluck(:id)
+
+    # Draw -> P1 always wins (strictly > 1 pt), plus 1 of {P2, P3, P4}, never P5 (0 pts)
+    drawn_second_winners = Set.new
+    25.times do
+      assert game.draw_winners!
+      winners = game.players.where(winner: true).pluck(:id)
+      assert_equal 2, winners.size
+      assert_includes winners, p1.id
+      assert_not_includes winners, p5.id
+      other = (winners - [ p1.id ]).first
+      assert_includes [ p2.id, p3.id, p4.id ], other
+      drawn_second_winners << other
+    end
+    assert_operator drawn_second_winners.size, :>=, 2, "Expected random draw to vary among tied players"
+  end
+
+  test "players with 0 points never win and fewer than N scoring players all win" do
+    @quiz.update!(winners_count: 3)
+    game = Game.create_from_quiz(@quiz)
+    p1 = game.join_player(name: "Scorer1")
+    p2 = game.join_player(name: "Scorer2")
+    p3 = game.join_player(name: "Zero1")
+    p4 = game.join_player(name: "Zero2")
+
+    game.start!
+    gq1 = game.game_questions.first
+    gq1_right = gq1.game_options.find_by!(correct: true)
+    game.submit_answer!(player: p1, game_option_id: gq1_right.id)
+    game.submit_answer!(player: p2, game_option_id: gq1_right.id)
+    game.finish_question!
+    game.next_question!
+    game.finish_question!
+    game.next_question!
+
+    assert game.pick_top_winners!
+    assert_equal [ p1.id, p2.id ], game.players.where(winner: true).order(:id).pluck(:id)
+
+    assert game.reset_winners!
+    assert game.draw_winners!
+    assert_equal [ p1.id, p2.id ], game.players.where(winner: true).order(:id).pluck(:id)
+
+    # If nobody scored at all -> 0 winners
+    game.players.each { |p| p.answers.delete_all }
+    assert game.pick_top_winners!
+    assert_equal [], game.players.where(winner: true).pluck(:id)
+    assert game.draw_winners!
+    assert_equal [], game.players.where(winner: true).pluck(:id)
+  end
+end
