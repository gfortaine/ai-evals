diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..94e0cc3
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,117 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :notifications, class_name: "Notification", foreign_key: :bundle_id, dependent: :nullify
+
+  enum :status, %w[ pending processing delivered ].index_by(&:itself), default: :pending
+
+  scope :due, -> { pending.where(ends_at: ..Time.current) }
+
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_at_after_starts_at
+  validate :does_not_overlap_existing_bundles
+
+  class << self
+    def deliver_all_due
+      due.includes(:account).find_each do |bundle|
+        Current.with_account(bundle.account) do
+          bundle.deliver_later
+        end
+      end
+    end
+
+    def bundle(notification)
+      user = notification.user
+
+      user.with_lock do
+        notification = Notification.find_by(id: notification.id)
+        return unless notification
+        return if notification.read? || !eligible_for_bundling?(notification)
+
+        target = find_or_create_for(user, at: notification.updated_at)
+        notification.update_columns(bundle_id: target.id) if notification.bundle_id != target.id
+        target
+      end
+    end
+
+    private
+      def eligible_for_bundling?(notification)
+        user = notification.user
+
+        !notification.creator&.system? &&
+          user.active? &&
+          !user.system? &&
+          notification.account.active? &&
+          user.settings&.bundle_emails?
+      end
+
+      def find_or_create_for(user, at:)
+        if existing = user.notification_bundles.pending.where("ends_at > ?", at).order(:starts_at).first
+          existing
+        else
+          latest_end = user.notification_bundles.where("ends_at > ?", at).maximum(:ends_at)
+          starts_at = [ at, latest_end ].compact.max
+          ends_at = starts_at + user.settings.bundle_email_interval
+
+          user.notification_bundles.create!(
+            account: user.account,
+            starts_at: starts_at,
+            ends_at: ends_at
+          )
+        end
+      end
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliverJob.perform_later(self)
+  end
+
+  def deliver
+    should_deliver = user.with_lock do
+      reload
+      if pending?
+        processing!
+        true
+      else
+        false
+      end
+    end
+
+    return unless should_deliver
+
+    Current.with_account(account) do
+      NotificationMailer.bundle(self).deliver_later if deliverable?
+      delivered!
+    end
+  end
+
+  def deliverable?
+    user.active? &&
+      !user.system? &&
+      user.identity.present? &&
+      account.active? &&
+      user.settings&.bundle_emails? &&
+      notifications.unread.any?
+  end
+
+  private
+    def ends_at_after_starts_at
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after starts_at")
+      end
+    end
+
+    def does_not_overlap_existing_bundles
+      return if user.nil? || starts_at.nil? || ends_at.nil?
+
+      overlapping = user.notification_bundles
+        .where.not(id: id)
+        .where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+        .exists?
+
+      if overlapping
+        errors.add(:base, "Cannot overlap an existing notification bundle")
+      end
+    end
+end
