@@ -0,0 +1,42 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "bundle_email_frequency defaults to every_few_hours" do
+    user = User.create!(account: accounts("37s"), name: "New User")
+    assert_equal "every_few_hours", user.settings.bundle_email_frequency
+    assert user.settings.every_few_hours?
+    assert user.settings.bundle_emails?
+    assert_equal 4.hours, user.settings.bundle_email_interval
+  end
+
+  test "bundle_email_frequency options and intervals" do
+    settings = user_settings(:kevin_settings)
+
+    settings.update!(bundle_email_frequency: :never)
+    assert settings.never?
+    assert_not settings.bundle_emails?
+    assert_nil settings.bundle_email_interval
+
+    settings.update!(bundle_email_frequency: :every_few_hours)
+    assert settings.every_few_hours?
+    assert settings.bundle_emails?
+    assert_equal 4.hours, settings.bundle_email_interval
+
+    settings.update!(bundle_email_frequency: :daily)
+    assert settings.daily?
+    assert settings.bundle_emails?
+    assert_equal 1.day, settings.bundle_email_interval
