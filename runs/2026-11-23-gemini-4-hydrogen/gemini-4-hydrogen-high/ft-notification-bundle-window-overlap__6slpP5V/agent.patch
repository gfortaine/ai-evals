diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..c13c3ee
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,341 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @account = @user.account
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "first notification opens a 4-hour window starting when it lands for every_few_hours" do
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      notification = create_notification(card: cards(:logo), source: events(:logo_published))
+
+      assert_difference -> { @user.notification_bundles.count }, 1 do
+        Notification::Bundle.bundle(notification)
+      end
+
+      bundle = @user.notification_bundles.last
+      assert_equal Time.utc(2026, 7, 10, 10, 0, 0), bundle.starts_at
+      assert_equal Time.utc(2026, 7, 10, 14, 0, 0), bundle.ends_at
+      assert bundle.pending?
+      assert_equal bundle, notification.reload.bundle
+    end
+  end
+
+  test "daily frequency opens a 1-day window" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      notification = create_notification(card: cards(:logo), source: events(:logo_published))
+      bundle = Notification::Bundle.bundle(notification)
+
+      assert_equal Time.utc(2026, 7, 10, 10, 0, 0), bundle.starts_at
+      assert_equal Time.utc(2026, 7, 11, 10, 0, 0), bundle.ends_at
+    end
+  end
+
+  test "weekly frequency opens a 1-week window" do
+    @user.settings.update!(bundle_email_frequency: :weekly)
+
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      notification = create_notification(card: cards(:logo), source: events(:logo_published))
+      bundle = Notification::Bundle.bundle(notification)
+
+      assert_equal Time.utc(2026, 7, 10, 10, 0, 0), bundle.starts_at
+      assert_equal Time.utc(2026, 7, 17, 10, 0, 0), bundle.ends_at
+    end
+  end
+
+  test "never frequency does not create a bundle" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      notification = create_notification(card: cards(:logo), source: events(:logo_published))
+
+      assert_no_difference -> { @user.notification_bundles.count } do
+        assert_nil Notification::Bundle.bundle(notification)
+      end
+
+      assert_nil notification.reload.bundle_id
+    end
+  end
+
+  test "notifications within the same window join the existing bundle" do
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      n1 = create_notification(card: cards(:logo), source: events(:logo_published))
+      b1 = Notification::Bundle.bundle(n1)
+
+      travel 2.hours
+      n2 = create_notification(card: cards(:layout), source: events(:layout_commented))
+      b2 = Notification::Bundle.bundle(n2)
+
+      assert_equal b1, b2
+      assert_equal 1, @user.notification_bundles.count
+      assert_equal [ n1.id, n2.id ].sort, b1.notifications.pluck(:id).sort
+    end
+  end
+
+  test "notification after window ends opens a new non-overlapping window" do
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      n1 = create_notification(card: cards(:logo), source: events(:logo_published))
+      b1 = Notification::Bundle.bundle(n1)
+
+      travel_to Time.utc(2026, 7, 10, 14, 0, 0)
+      n2 = create_notification(card: cards(:layout), source: events(:layout_commented))
+      b2 = Notification::Bundle.bundle(n2)
+
+      assert_not_equal b1, b2
+      assert_equal Time.utc(2026, 7, 10, 14, 0, 0), b2.starts_at
+      assert_equal Time.utc(2026, 7, 10, 18, 0, 0), b2.ends_at
+      assert_equal 2, @user.notification_bundles.count
+    end
+  end
+
+  test "late-arriving notification before open window start joins the already-opened window without overlapping" do
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      n1 = create_notification(card: cards(:logo), source: events(:logo_published))
+      b1 = Notification::Bundle.bundle(n1)
+
+      n_late = create_notification(card: cards(:layout), source: events(:layout_commented))
+      n_late.update_columns(created_at: Time.utc(2026, 7, 10, 9, 50, 0), updated_at: Time.utc(2026, 7, 10, 9, 50, 0))
+
+      b_late = Notification::Bundle.bundle(n_late)
+
+      assert_equal b1, b_late
+      assert_equal 1, @user.notification_bundles.count
+      assert_equal Time.utc(2026, 7, 10, 10, 0, 0), b1.reload.starts_at
+      assert_equal Time.utc(2026, 7, 10, 14, 0, 0), b1.ends_at
+      assert_includes b1.notifications, n_late
+    end
+  end
+
+  test "late-arriving notification inside an already-delivered window creates a non-overlapping subsequent window" do
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      n1 = create_notification(card: cards(:logo), source: events(:logo_published))
+      b1 = Notification::Bundle.bundle(n1)
+
+      travel_to Time.utc(2026, 7, 10, 14, 5, 0)
+      perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+      assert b1.reload.delivered?
+
+      n_late = create_notification(card: cards(:layout), source: events(:layout_commented))
+      n_late.update_columns(created_at: Time.utc(2026, 7, 10, 13, 55, 0), updated_at: Time.utc(2026, 7, 10, 13, 55, 0))
+
+      b2 = Notification::Bundle.bundle(n_late)
+
+      assert_not_equal b1, b2
+      assert_equal Time.utc(2026, 7, 10, 14, 0, 0), b2.starts_at
+      assert_equal Time.utc(2026, 7, 10, 18, 0, 0), b2.ends_at
+      assert_operator b2.starts_at, :>=, b1.ends_at
+      assert_equal b2, n_late.reload.bundle
+    end
+  end
+
+  test "notification arriving while a bundle is processing joins a new non-overlapping window" do
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      n1 = create_notification(card: cards(:logo), source: events(:logo_published))
+      b1 = Notification::Bundle.bundle(n1)
+      b1.processing!
+
+      travel_to Time.utc(2026, 7, 10, 13, 55, 0)
+      n2 = create_notification(card: cards(:layout), source: events(:layout_commented))
+      b2 = Notification::Bundle.bundle(n2)
+
+      assert_not_equal b1, b2
+      assert_equal Time.utc(2026, 7, 10, 14, 0, 0), b2.starts_at
+      assert_equal Time.utc(2026, 7, 10, 18, 0, 0), b2.ends_at
+    end
+  end
+
+  test "updating an existing notification in a new window moves it to the new window" do
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      n1 = create_notification(card: cards(:logo), source: events(:logo_published))
+      b1 = Notification::Bundle.bundle(n1)
+
+      travel_to Time.utc(2026, 7, 10, 14, 5, 0)
+      perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+      assert b1.reload.delivered?
+
+      n1.source_type_will_change!
+      n1.update!(source: events(:logo_assignment_km), unread_count: 2)
+      b2 = Notification::Bundle.bundle(n1)
+
+      assert_not_equal b1, b2
+      assert_equal b2, n1.reload.bundle
+    end
+  end
+
+  test "validation rejects overlapping windows for the same user" do
+    @user.notification_bundles.create!(
+      starts_at: Time.utc(2026, 7, 10, 10, 0, 0),
+      ends_at: Time.utc(2026, 7, 10, 14, 0, 0)
+    )
+
+    overlapping = @user.notification_bundles.build(
+      starts_at: Time.utc(2026, 7, 10, 12, 0, 0),
+      ends_at: Time.utc(2026, 7, 10, 16, 0, 0)
+    )
+    assert_not overlapping.valid?
+
+    overlapping_earlier = @user.notification_bundles.build(
+      starts_at: Time.utc(2026, 7, 10, 8, 0, 0),
+      ends_at: Time.utc(2026, 7, 10, 10, 1, 0)
+    )
+    assert_not overlapping_earlier.valid?
+
+    adjacent = @user.notification_bundles.build(
+      starts_at: Time.utc(2026, 7, 10, 14, 0, 0),
+      ends_at: Time.utc(2026, 7, 10, 18, 0, 0)
+    )
+    assert adjacent.valid?
+  end
+
+  test "different users can have overlapping windows" do
+    @user.notification_bundles.create!(
+      starts_at: Time.utc(2026, 7, 10, 10, 0, 0),
+      ends_at: Time.utc(2026, 7, 10, 14, 0, 0)
+    )
+
+    other_bundle = users(:david).notification_bundles.build(
+      starts_at: Time.utc(2026, 7, 10, 11, 0, 0),
+      ends_at: Time.utc(2026, 7, 10, 15, 0, 0)
+    )
+    assert other_bundle.valid?
+  end
+
+  test "validation requires ends_at to be after starts_at" do
+    invalid = @user.notification_bundles.build(
+      starts_at: Time.utc(2026, 7, 10, 10, 0, 0),
+      ends_at: Time.utc(2026, 7, 10, 10, 0, 0)
+    )
+    assert_not invalid.valid?
+    assert_includes invalid.errors[:ends_at], "must be after starts_at"
+  end
+
+  test "deliver_all_due only delivers bundles whose window has ended" do
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      n1 = create_notification(card: cards(:logo), source: events(:logo_published))
+      b1 = Notification::Bundle.bundle(n1)
+
+      travel_to Time.utc(2026, 7, 10, 13, 59, 59)
+      assert_no_emails do
+        perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+      end
+      assert b1.reload.pending?
+
+      travel_to Time.utc(2026, 7, 10, 14, 0, 0)
+      assert_emails 1 do
+        perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+      end
+      assert b1.reload.delivered?
+
+      # Idempotent: does not send again
+      assert_no_emails do
+        perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+      end
+    end
+  end
+
+  test "deliver skips sending email when all notifications have been read" do
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      n1 = create_notification(card: cards(:logo), source: events(:logo_published))
+      b1 = Notification::Bundle.bundle(n1)
+
+      n1.read
+
+      travel_to Time.utc(2026, 7, 10, 14, 5, 0)
+      assert_no_emails do
+        perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+      end
+      assert b1.reload.delivered?
+    end
+  end
+
+  test "deliver skips sending email if user switched frequency to never" do
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      n1 = create_notification(card: cards(:logo), source: events(:logo_published))
+      b1 = Notification::Bundle.bundle(n1)
+
+      @user.settings.update!(bundle_email_frequency: :never)
+
+      travel_to Time.utc(2026, 7, 10, 14, 5, 0)
+      assert_no_emails do
+        perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+      end
+      assert b1.reload.delivered?
+    end
+  end
+
+  test "deliver skips sending email for deactivated user or cancelled account" do
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      n1 = create_notification(card: cards(:logo), source: events(:logo_published))
+      b1 = Notification::Bundle.bundle(n1)
+
+      @user.deactivate
+
+      travel_to Time.utc(2026, 7, 10, 14, 5, 0)
+      assert_no_emails do
+        perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+      end
+      assert b1.reload.delivered?
+    end
+  end
+
+test "skips bundling for system creator or system user" do
+  system_notification = Notification.create!(user: @user, card: cards(:logo), source: events(:logo_published), creator: users(:system), unread_count: 1)
+  assert_nil Notification::Bundle.bundle(system_notification)
+
+  system_user = users(:system)
+  user_notification = Notification.create!(user: system_user, card: cards(:logo), source: events(:logo_published), creator: users(:david), unread_count: 1)
+  assert_nil Notification::Bundle.bundle(user_notification)
+end
+
+test "late notification between a delivered window and an open window joins the open window" do
+  travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+    n1 = create_notification(card: cards(:logo), source: events(:logo_published))
+    b1 = Notification::Bundle.bundle(n1)
+
+    travel_to Time.utc(2026, 7, 10, 14, 5, 0)
+    perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+    assert b1.reload.delivered?
+
+    travel_to Time.utc(2026, 7, 10, 15, 0, 0)
+    n2 = create_notification(card: cards(:layout), source: events(:layout_commented))
+    b2 = Notification::Bundle.bundle(n2)
+
+    n_late = create_notification(card: cards(:buy_domain), source: events(:buy_domain_sent_back_to_triage))
+    n_late.update_columns(created_at: Time.utc(2026, 7, 10, 14, 30, 0), updated_at: Time.utc(2026, 7, 10, 14, 30, 0))
+
+    b_late = Notification::Bundle.bundle(n_late)
+    assert_equal b2, b_late
+    assert_equal 2, @user.notification_bundles.count
+  end
+end
+
+test "late notification with multiple pending windows joins the earliest matching pending window" do
+  travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+    n1 = create_notification(card: cards(:logo), source: events(:logo_published))
+    b1 = Notification::Bundle.bundle(n1)
+
+    travel_to Time.utc(2026, 7, 10, 14, 5, 0)
+    n2 = create_notification(card: cards(:layout), source: events(:layout_commented))
+    b2 = Notification::Bundle.bundle(n2)
+
+    n_late = create_notification(card: cards(:buy_domain), source: events(:buy_domain_sent_back_to_triage))
+    n_late.update_columns(created_at: Time.utc(2026, 7, 10, 13, 50, 0), updated_at: Time.utc(2026, 7, 10, 13, 50, 0))
+
+    assert_equal b1, Notification::Bundle.bundle(n_late)
+    assert_not_equal b2, n_late.reload.bundle
+  end
+end
+
+  private
+    def create_notification(card:, source:, creator: users(:david))
+      Notification.create!(user: @user, card: card, source: source, creator: creator, unread_count: 1)
+    end
+end
diff --git a/test/models/notification/bundling_test.rb b/test/models/notification/bundling_test.rb
