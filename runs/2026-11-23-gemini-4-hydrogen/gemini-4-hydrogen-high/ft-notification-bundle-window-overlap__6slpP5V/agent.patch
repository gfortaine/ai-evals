+  </h2>
+
+  <% notifications.each do |notification| %>
+    <% payload = notification.payload %>
+    <table class="notification">
+      <tr>
+        <td class="avatar__container">
+          <%= mail_avatar_tag(notification.creator) %>
+        </td>
+        <td>
+          <p class="card__title">
+            <%= link_to payload.title, payload.url %>
+          </p>
+          <p class="notification__author">
+            <%= notification.creator.name %>
+            <% if notification.source_type == "Mention" %>
+              <span class="notificaton__mention">@mentioned you</span>
+            <% end %>
+          </p>
+          <p class="notification__details">
+            <%= payload.body %>
+          </p>
+        </td>
+      </tr>
+    </table>
+  <% end %>
+<% end %>
+
+<p class="footer">
