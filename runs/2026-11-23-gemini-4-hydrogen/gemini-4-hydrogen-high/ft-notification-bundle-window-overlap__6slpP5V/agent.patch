+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @account = @user.account
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+  end
+
+  test "bundle with single notification" do
+    notification = Notification.create!(
+      user: @user,
+      card: cards(:logo),
+      source: events(:logo_assignment_km),
+      creator: users(:david),
+      unread_count: 1
+    )
+    bundle = Notification::Bundle.bundle(notification)
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal notification.payload.title, email.subject
+    assert_match cards(:logo).title, email.body.encoded
+    assert_match @account.slug, email.body.encoded
+    assert_match %r{/notifications/settings}, email.body.encoded
+  end
+
+  test "bundle with multiple notifications grouped across boards" do
+    n1 = Notification.create!(
+      user: @user,
+      card: cards(:logo),
+      source: events(:logo_assignment_km),
+      creator: users(:david),
+      unread_count: 1
+    )
+    n2 = Notification.create!(
+      user: @user,
+      card: cards(:layout),
+      source: events(:layout_commented),
+      creator: users(:jz),
+      unread_count: 1
+    )
+
+    bundle = Notification::Bundle.bundle(n1)
+    Notification::Bundle.bundle(n2)
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "#{@account.name}: 2 new notifications", email.subject
+    assert_match cards(:logo).title, email.body.encoded
+    assert_match cards(:layout).title, email.body.encoded
+    assert_match boards(:writebook).name, email.body.encoded
+  end
+
+  test "bundle excludes read notifications" do
+    n1 = Notification.create!(
+      user: @user,
+      card: cards(:logo),
+      source: events(:logo_assignment_km),
+      creator: users(:david),
+      unread_count: 1
+    )
+    n2 = Notification.create!(
+      user: @user,
+      card: cards(:layout),
+      source: events(:layout_commented),
+      creator: users(:jz),
+      unread_count: 1
+    )
+
+    bundle = Notification::Bundle.bundle(n1)
+    Notification::Bundle.bundle(n2)
+    n1.read
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal n2.payload.title, email.subject
+    assert_no_match(/#{Regexp.escape(cards(:logo).title)}/, email.body.encoded)
+    assert_match cards(:layout).title, email.body.encoded
+  end
+end
