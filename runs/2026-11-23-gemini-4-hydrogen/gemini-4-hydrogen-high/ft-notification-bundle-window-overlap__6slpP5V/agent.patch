@@ -0,0 +1,69 @@
+require "test_helper"
+
+class NotificationBundlingTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @assigner = users(:david)
+    @assignee = users(:kevin)
+    cards(:logo).assignments.destroy_all
+    @assignee.notifications.destroy_all
+    @assignee.notification_bundles.destroy_all
+    @assignee.settings.update!(bundle_email_frequency: :every_few_hours)
+    Current.user = @assigner
+  end
+
+  test "multiple notifications in one window produce a single digest email when the window closes" do
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      perform_enqueued_jobs only: [ NotifyRecipientsJob, Notification::BundleJob ] do
+        cards(:logo).toggle_assignment(@assignee)
+      end
+
+      assert_equal 1, @assignee.notification_bundles.count
+      assert_no_emails
+
+      travel 1.hour
+
+      perform_enqueued_jobs only: [ NotifyRecipientsJob, Notification::BundleJob ] do
+        cards(:layout).watch_by(@assignee)
+        cards(:layout).comments.create!(body: "Checking in on this", creator: @assigner)
+      end
+
+      assert_equal 1, @assignee.notification_bundles.count
+      assert_equal 2, @assignee.notification_bundles.reload.first.notifications.count
+
+      travel_to Time.utc(2026, 7, 10, 14, 1, 0)
+
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          Notification::Bundle.deliver_all_due
+        end
+      end
+
+      email = ActionMailer::Base.deliveries.last
+      assert_equal [ @assignee.identity.email_address ], email.to
+      assert_match cards(:logo).title, email.body.encoded
+      assert_match cards(:layout).title, email.body.encoded
+    end
+  end
+
+  test "concurrent bundling for the same user does not create overlapping windows" do
+    travel_to Time.utc(2026, 7, 10, 10, 0, 0) do
+      n1 = Notification.create!(user: @assignee, card: cards(:logo), source: events(:logo_published), creator: @assigner, unread_count: 1)
+      n2 = Notification.create!(user: @assignee, card: cards(:layout), source: events(:layout_commented), creator: @assigner, unread_count: 1)
+
+      threads = [ n1, n2 ].map do |notification|
+        Thread.new do
+          ActiveRecord::Base.connection_pool.with_connection do
+            Notification::Bundle.bundle(notification)
+          end
+        end
+      end
+      threads.each(&:join)
+
+      assert_equal 1, @assignee.notification_bundles.count
+      assert_equal @assignee.notification_bundles.first, n1.reload.bundle
+      assert_equal @assignee.notification_bundles.first, n2.reload.bundle
+    end
+  end
+end
