new file mode 100644
index 0000000..c6599ef
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,35 @@
+class NotificationMailer < ApplicationMailer
+  helper NotificationsHelper
+
+  def bundle(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.unread.preloaded.to_a
+
+    return if @notifications.empty? || !@user.active? || @user.identity.blank?
+
+    @grouped_notifications = @notifications.group_by { |notification| notification.card.board }
+
+    mail(
+      to: @user.identity.email_address,
+      subject: bundle_subject
+    )
+  end
+
+  private
+    def bundle_subject
+      if @notifications.one?
+        @notifications.first.payload.title
+      else
+        "#{@user.account.name}: #{@notifications.size} new notifications"
+      end
+    end
+
+    def default_url_options
+      if @user&.account
+        super.merge(script_name: @user.account.slug)
+      else
+        super
+      end
+    end
+end
