+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "compact_positions! preserves hand-arranged ordering and produces dense 1..n scores" do
+    book = books(:handbook)
+
+    leaves(:reading_picture).move_to_position(0)
+    leaves(:welcome_section).move_to_position(99)
+    leaves(:summary_page).update!(position_score: 100.5)
+
+    expected_order = book.leaves.positioned.to_a
+
+    book.compact_positions!
+
+    assert_equal expected_order, book.leaves.positioned.reload.to_a
+    assert_equal [ 1.0, 2.0, 3.0, 4.0 ], book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions! preserves relative position of trashed leaves so restoration keeps them in place" do
+    book = books(:handbook)
+
+    leaves(:reading_picture).move_to_position(0)
+    leaves(:welcome_section).move_to_position(99)
+    leaves(:welcome_page).trashed!
+
+    expected_order_when_restored = [
+      leaves(:reading_picture),
+      leaves(:welcome_page),
+      leaves(:summary_page),
+      leaves(:welcome_section)
+    ]
+
+    book.compact_positions!
+    leaves(:welcome_page).active!
+
+    assert_equal expected_order_when_restored, book.leaves.active.positioned.reload.to_a
+  end
+
+  test "compact_positions! breaks position_score ties by id" do
+    book = books(:handbook)
+
+    leaves(:summary_page).update!(position_score: 10)
+    leaves(:welcome_page).update!(position_score: 10)
+    leaves(:reading_picture).update!(position_score: 20)
+    leaves(:welcome_section).update!(position_score: 30)
+
+    expected_order = book.leaves.positioned.to_a
+
+    book.compact_positions!
+
+    assert_equal expected_order, book.leaves.positioned.reload.to_a
+    assert_equal [ 1.0, 2.0, 3.0, 4.0 ], book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions! only affects the target book and handles empty books" do
+    other_leaf = books(:manual).press Page.new(body: "Other"), title: "Other"
+    other_leaf.update!(position_score: 42.5)
+
+    books(:handbook).compact_positions!
+    assert_equal 42.5, other_leaf.reload.position_score
+
+    empty_book = Book.create!(title: "Empty")
+    assert_nothing_raised { empty_book.compact_positions! }
+  end
+
+  test "live_leaf_count returns count of non-trashed leaves for the book" do
+    book = books(:handbook)
+    assert_equal 4, book.live_leaf_count
+
+    leaves(:summary_page).trashed!
+    assert_equal 3, book.live_leaf_count
+  end
+end
