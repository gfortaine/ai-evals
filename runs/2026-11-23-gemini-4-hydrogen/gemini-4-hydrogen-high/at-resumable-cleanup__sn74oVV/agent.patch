diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..933590a
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,183 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  setup do
+    leaves(:welcome_section).update!(title: '""Welcome" Section"')
+    leaves(:welcome_page).update!(title: '"Welcome to "The Handbook"!"')
+    leaves(:summary_page).update!(title: '""Summary""')
+    leaves(:reading_picture).update!(title: '"Reading"')
+  end
+
+  test "cleans stray outer quotes from all leaf titles while keeping inner quotes intact" do
+    TitleCleanupJob.perform_now
+
+    assert_equal '"Welcome" Section', leaves(:welcome_section).reload.title
+    assert_equal 'Welcome to "The Handbook"!', leaves(:welcome_page).reload.title
+    assert_equal '"Summary"', leaves(:summary_page).reload.title
+    assert_equal "Reading", leaves(:reading_picture).reload.title
+  end
+
+  test "resumes from where it left off after a graceful continuation interruption" do
+    ordered_leaves = Leaf.order(:id).to_a
+    resume_at = ordered_leaves[1].id + 1
+
+    TitleCleanupJob.perform_later
+
+    interrupt_job_during_step(TitleCleanupJob, :cleanup, cursor: resume_at) do
+      perform_enqueued_jobs
+    end
+
+    assert_enqueued_jobs 1, only: TitleCleanupJob
+    assert_equal '"Welcome" Section', leaves(:welcome_section).reload.title
+    assert_equal 'Welcome to "The Handbook"!', leaves(:welcome_page).reload.title
+    assert_equal '""Summary""', leaves(:summary_page).reload.title
+    assert_equal '"Reading"', leaves(:reading_picture).reload.title
+
+    perform_enqueued_jobs
+
+    assert_no_enqueued_jobs
+    assert_equal '"Welcome" Section', leaves(:welcome_section).reload.title
+    assert_equal 'Welcome to "The Handbook"!', leaves(:welcome_page).reload.title
+    assert_equal '"Summary"', leaves(:summary_page).reload.title
+    assert_equal "Reading", leaves(:reading_picture).reload.title
+  end
+
+  test "resumes cleanly across multiple interruptions" do
+    ordered_leaves = Leaf.order(:id).to_a
+
+    TitleCleanupJob.perform_later
+
+    interrupt_job_during_step(TitleCleanupJob, :cleanup, cursor: ordered_leaves[0].id + 1) do
+      perform_enqueued_jobs
+    end
+    assert_enqueued_jobs 1, only: TitleCleanupJob
+
+    interrupt_job_during_step(TitleCleanupJob, :cleanup, cursor: ordered_leaves[2].id + 1) do
+      perform_enqueued_jobs
+    end
+    assert_enqueued_jobs 1, only: TitleCleanupJob
+
+    perform_enqueued_jobs
+
+    assert_no_enqueued_jobs
+    assert_equal '"Welcome" Section', leaves(:welcome_section).reload.title
+    assert_equal 'Welcome to "The Handbook"!', leaves(:welcome_page).reload.title
+    assert_equal '"Summary"', leaves(:summary_page).reload.title
+    assert_equal "Reading", leaves(:reading_picture).reload.title
+  end
+
+  test "resumes after a transient error without re-cleaning earlier leaves" do
+    ordered_leaves = Leaf.order(:id).to_a
+    target_id = ordered_leaves[2].id
+    failed_once = false
+
+    TitleCleanupJob.perform_later
+
+    hook = ->(leaf, original_update) do
+      if leaf.id == target_id && !failed_once
+        failed_once = true
+        raise ActiveRecord::Deadlocked, "transient deadlock"
+      end
+      original_update.call
+    end
+
+    with_leaf_update_hook(hook) do
+      # First run fails on leaf 3 after advancing cursor past leaves 1 and 2, so it re-enqueues
+      perform_enqueued_jobs
+    end
+    assert_enqueued_jobs 1, only: TitleCleanupJob
+
+    # Leaf 3 rolled back and leaves 1..2 are already cleaned once
+    assert_equal '"Welcome" Section', leaves(:welcome_section).reload.title
+    assert_equal 'Welcome to "The Handbook"!', leaves(:welcome_page).reload.title
+    assert_equal '"Reading"', leaves(:reading_picture).reload.title
+
+    # Second run completes from leaf 3 onward
+    perform_enqueued_jobs
+    assert_no_enqueued_jobs
+    assert_equal '"Welcome" Section', leaves(:welcome_section).reload.title
+    assert_equal 'Welcome to "The Handbook"!', leaves(:welcome_page).reload.title
+    assert_equal '"Summary"', leaves(:summary_page).reload.title
+    assert_equal "Reading", leaves(:reading_picture).reload.title
+  end
+
+  test "resumes on restart after an abrupt signal interruption mid-leaf without double cleaning" do
+    ordered_leaves = Leaf.order(:id).to_a
+    target_id = ordered_leaves[2].id
+    interrupted = false
+
+    hook = ->(leaf, original_update) do
+      if leaf.id == target_id && !interrupted
+        interrupted = true
+        # Simulate update failing mid-transaction before commit
+        original_update.call
+        raise SignalException, "TERM"
+      end
+      original_update.call
+    end
+
+    assert_raises(SignalException) do
+      with_leaf_update_hook(hook) do
+        TitleCleanupJob.perform_now
+      end
+    end
+
+    # Leaf 3 rolled back, leaves 1 and 2 committed
+    assert_equal '"Welcome" Section', leaves(:welcome_section).reload.title
+    assert_equal 'Welcome to "The Handbook"!', leaves(:welcome_page).reload.title
+    assert_equal '"Reading"', leaves(:reading_picture).reload.title
+
+    # Fresh restart picks up at leaf 3, redoing at most leaf 3 (which rolled back)
+    TitleCleanupJob.perform_now
+
+    assert_equal '"Welcome" Section', leaves(:welcome_section).reload.title
+    assert_equal 'Welcome to "The Handbook"!', leaves(:welcome_page).reload.title
+    assert_equal '"Summary"', leaves(:summary_page).reload.title
+    assert_equal "Reading", leaves(:reading_picture).reload.title
+    assert_nil JobCursor.cursor_for("TitleCleanupJob")
+  end
+
+  test "clears persisted cursor on completion so a subsequent run processes new leaves" do
+    TitleCleanupJob.perform_now
+    assert_nil JobCursor.cursor_for("TitleCleanupJob")
+
+    new_leaf = books(:handbook).press(Page.new, title: '""New" Leaf"')
+    TitleCleanupJob.perform_now
+
+    assert_equal '"New" Leaf', new_leaf.reload.title
+  end
+
+  test "handles empty leaf collection" do
+    Edit.delete_all
+    Leaf.delete_all
+
+    assert_nothing_raised { TitleCleanupJob.perform_now }
+    assert_nil JobCursor.cursor_for("TitleCleanupJob")
+  end
+
+  test "retry_job does not require scheduled enqueue_at support" do
+    ordered_leaves = Leaf.order(:id).to_a
+    TitleCleanupJob.perform_later
+
+    interrupt_job_during_step(TitleCleanupJob, :cleanup, cursor: ordered_leaves[0].id + 1) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal 1, enqueued_jobs.size
+    assert_nil enqueued_jobs.first[:at]
+  end
+
+  private
+    def with_leaf_update_hook(hook)
+      original_update = Leaf.instance_method(:update!)
+      Leaf.define_method(:update!) do |*args, **kwargs, &blk|
+        hook.call(self, -> { original_update.bind_call(self, *args, **kwargs, &blk) })
+      end
+      yield
+    ensure
+      Leaf.define_method(:update!, original_update)
+    end
+end
