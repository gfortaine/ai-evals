new file mode 100644
index 0000000..7c1a47c
--- /dev/null
+++ b/app/models/job_cursor.rb
@@ -0,0 +1,19 @@
+class JobCursor < ApplicationRecord
+  def self.cursor_for(job_class)
+    return unless table_exists?
+
+    where(job_class: job_class).pick(:cursor)
+  end
+
+  def self.advance!(job_class, to:)
+    return unless table_exists?
+
+    upsert({ job_class: job_class, cursor: to }, unique_by: :job_class)
+  end
+
+  def self.clear!(job_class)
+    return unless table_exists?
+
+    where(job_class: job_class).delete_all
+  end
+end
