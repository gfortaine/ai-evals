diff --git a/lib/rails_ext/active_storage_variation.rb b/lib/rails_ext/active_storage_variation.rb
new file mode 100644
index 0000000..d7b11a5
--- /dev/null
+++ b/lib/rails_ext/active_storage_variation.rb
@@ -0,0 +1,27 @@
+module ActiveStorage::VariationDigestNormalization
+  def digest
+    OpenSSL::Digest::SHA1.base64digest Marshal.dump(normalize_for_digest(transformations))
+  end
+
+  private
+    def normalize_for_digest(value)
+      case value
+      when Hash
+        value.transform_values { |v| normalize_for_digest(v) }
+      when Array
+        value.map { |v| normalize_for_digest(v) }
+      when Symbol
+        value.to_s.encode(Encoding::UTF_8)
+      when String
+        value.encoding == Encoding::UTF_8 ? value : value.encode(Encoding::UTF_8)
+      else
+        value
+      end
+    end
+end
+
+Rails.application.config.to_prepare do
+  unless ActiveStorage::Variation < ActiveStorage::VariationDigestNormalization
+    ActiveStorage::Variation.prepend ActiveStorage::VariationDigestNormalization
+  end
+end
diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..5e2b54c 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -38,4 +38,113 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "uploaded picture is derived once and reader requests do no image processing" do
+    book = books(:handbook)
+
+    perform_enqueued_jobs do
+      post book_pictures_path(book, format: :turbo_stream), params: {
+        leaf: { title: "Manual Cover" },
+        picture: {
+          image: Rack::Test::UploadedFile.new(Rails.root.join("app/assets/images/demo/writebook-manual.jpg"), "image/jpeg"),
+          caption: "Writebook manual"
+        }
+      }
+      assert_response :success
+    end
+
+    # Run any follow-up TransformJob enqueued by CreateVariantsJob
+    perform_enqueued_jobs
+
+    picture = Picture.order(:id).last
+    blob = picture.image.blob
+    variant_records = ActiveStorage::VariantRecord.where(blob: blob)
+    assert_equal 1, variant_records.count
+
+    derived_blob = variant_records.first.image.blob
+    expected_bytes = derived_blob.download
+    assert File.exist?(ActiveStorage::Blob.service.path_for(derived_blob.key))
+
+    sign_in :jz
+
+    transforms = 0
+    subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { transforms += 1 }
+
+    begin
+      assert_no_difference -> { ActiveStorage::VariantRecord.count } do
+        assert_no_difference -> { ActiveStorage::Blob.count } do
+          get book_slug_path(book)
+          assert_response :success
+
+          src = css_select("img").map { |el| el["src"] }.find { |s| s&.include?("writebook-manual.jpg") }
+          assert_not_nil src
+
+          get src
+          assert_response :redirect
+
+          get response.location
+          assert_response :success
+          assert_equal "image/webp", response.content_type
+          assert_equal expected_bytes.b, response.body.b
+
+          get leafable_slug_path(picture.leaf)
+          assert_response :success
+
+          leaf_src = css_select("figure img").first&.[]("src")
+          assert_equal src, leaf_src
+
+          get leaf_src
+          assert_response :redirect
+
+          get response.location
+          assert_response :success
+          assert_equal expected_bytes.b, response.body.b
+        end
+      end
+
+      assert_equal 0, transforms
+      assert_equal 1, ActiveStorage::VariantRecord.where(blob: blob).count
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+  end
+
+  test "editing picture caption after revision window does not re-derive variant" do
+    book = books(:handbook)
+
+    perform_enqueued_jobs do
+      post book_pictures_path(book, format: :turbo_stream), params: {
+        leaf: { title: "Manual Cover" },
+        picture: {
+          image: Rack::Test::UploadedFile.new(Rails.root.join("app/assets/images/demo/writebook-manual.jpg"), "image/jpeg"),
+          caption: "Initial caption"
+        }
+      }
+      assert_response :success
+    end
+    perform_enqueued_jobs
+
+    leaf = Picture.order(:id).last.leaf
+    blob = leaf.picture.image.blob
+    assert_equal 1, ActiveStorage::VariantRecord.where(blob: blob).count
+
+    travel 15.minutes do
+      transforms = 0
+      subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { transforms += 1 }
+
+      begin
+        assert_no_difference -> { ActiveStorage::VariantRecord.count } do
+          perform_enqueued_jobs do
+            put leafable_path(leaf), params: { picture: { caption: "Updated caption" } }
+            assert_response :no_content
+          end
+          perform_enqueued_jobs
+        end
+
+        assert_equal 0, transforms
+      ensure
+        ActiveSupport::Notifications.unsubscribe(subscriber)
+      end
+    end
+  end
 end
diff --git a/test/models/picture_test.rb b/test/models/picture_test.rb
index 18a2a56..b1caf21 100644
--- a/test/models/picture_test.rb
+++ b/test/models/picture_test.rb
@@ -23,4 +23,18 @@ class PictureTest < ActiveSupport::TestCase
 
     assert_equal picture.image, picture.large_image
   end
+
+  test "large_image variation digest matches decoded URL variation key" do
+    variation = pictures(:reading).large_image.variation
+    decoded = ActiveStorage::Variation.decode(variation.key)
+
+    assert_equal variation.digest, decoded.digest
+  end
+
+  test "variation digest is invariant to JSON roundtrip of symbol values" do
+    variation = ActiveStorage::Variation.new(resize_to_limit: [ 1500, 1500 ], format: :webp, saver: { strip: true })
+    decoded = ActiveStorage::Variation.decode(variation.key)
+
+    assert_equal variation.digest, decoded.digest
+  end
 end
