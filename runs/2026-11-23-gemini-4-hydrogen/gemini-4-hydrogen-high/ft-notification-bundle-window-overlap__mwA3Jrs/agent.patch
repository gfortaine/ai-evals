+require "test_helper"
+
+class Notification::PushTarget::EmailTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.notification_bundles.destroy_all
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "process bundles unread notification" do
+    assert_difference -> { @user.notification_bundles.count }, 1 do
+      Notification::PushTarget::Email.process(@notification)
+    end
+  end
+
+  test "process skips already-read notification" do
+    @notification.read
+
+    assert_no_difference -> { @user.notification_bundles.count } do
+      Notification::PushTarget::Email.process(@notification)
+    end
+  end
+
+  test "full notification flow batches into window and sends one digest email" do
+    @user.notifications.destroy_all
+    card = cards(:logo)
+    card.watch_by(@user)
+
+    travel_to Time.utc(2026, 5, 1, 10, 0, 0) do
+      assert_emails 0 do
+        perform_enqueued_jobs only: [ NotifyRecipientsJob, Notification::PushJob ] do
+          card.comments.create!(body: "First comment", creator: users(:david))
+          cards(:layout).comments.create!(body: "Second comment", creator: users(:david))
+        end
+      end
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_equal 2, @user.notification_bundles.reload.first.notifications.count
+    end
+
+    travel_to Time.utc(2026, 5, 1, 14, 1, 0) do
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          Notification::Bundle.deliver_all_due
+        end
+      end
+    end
+  end
+end
diff --git a/test/models/user/settings_test.rb b/test/models/user/settings_test.rb
new file mode 100644
index 0000000..756f7e1
--- /dev/null
+++ b/test/models/user/settings_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @settings = @user.settings
+  end
+
+  test "defaults bundle_email_frequency to every_few_hours" do
+    assert_equal "every_few_hours", @settings.bundle_email_frequency
+    assert @settings.every_few_hours?
+    assert @settings.bundling_emails?
+  end
+
+  test "supports never, every_few_hours, daily, weekly" do
+    %w[ never every_few_hours daily weekly ].each do |frequency|
+      @settings.update!(bundle_email_frequency: frequency)
+      assert_equal frequency, @settings.reload.bundle_email_frequency
+    end
+  end
+
+  test "rejects invalid bundle_email_frequency" do
+    assert_raises(ArgumentError) do
+      @settings.bundle_email_frequency = "hourly"
+    end
+  end
+
+  test "bundle_aggregation_window returns duration for active frequencies" do
+    @settings.bundle_email_frequency = "never"
+    assert_not @settings.bundling_emails?
+    assert_nil @settings.bundle_aggregation_window
+
+    @settings.bundle_email_frequency = "every_few_hours"
+    assert @settings.bundling_emails?
+    assert_equal 4.hours, @settings.bundle_aggregation_window
+
+    @settings.bundle_email_frequency = "daily"
+    assert @settings.bundling_emails?
+    assert_equal 1.day, @settings.bundle_aggregation_window
+
+    @settings.bundle_email_frequency = "weekly"
+    assert @settings.bundling_emails?
+    assert_equal 1.week, @settings.bundle_aggregation_window
+  end
+
+  test "changing bundle_email_frequency to never destroys pending bundles" do
+    bundle = @user.notification_bundles.create!(starts_at: Time.current, ends_at: 4.hours.from_now)
+
+    @settings.update!(bundle_email_frequency: "never")
+
+    assert_not Notification::Bundle.exists?(bundle.id)
+  end
+
+  test "changing bundle_email_frequency adjusts the open pending bundle ends_at" do
+    start_time = Time.utc(2026, 5, 1, 10, 0, 0)
+    bundle = @user.notification_bundles.create!(starts_at: start_time, ends_at: start_time + 4.hours)
+
+    @settings.update!(bundle_email_frequency: "daily")
+    assert_equal start_time + 1.day, bundle.reload.ends_at
+
+    @settings.update!(bundle_email_frequency: "weekly")
+    assert_equal start_time + 1.week, bundle.reload.ends_at
+
+    @settings.update!(bundle_email_frequency: "every_few_hours")
+    assert_equal start_time + 4.hours, bundle.reload.ends_at
+  end
+end
