diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..5c63624
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,37 @@
+class NotificationMailer < ApplicationMailer
+  helper NotificationsHelper, ExcerptHelper
+
+  def bundled_notifications(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.unread_notifications.preloaded.ordered.to_a
+
+    return if @notifications.empty?
+
+    @grouped_notifications = @notifications.group_by { |notification| notification.card.board }
+
+    Current.with_account(@bundle.account) do
+      mail(
+        to: @user.identity.email_address,
+        subject: subject_for(@notifications, @bundle.account)
+      )
+    end
+  end
+
+  private
+    def default_url_options
+      if @bundle
+        super.merge(script_name: @bundle.account.slug)
+      else
+        super
+      end
+    end
+
+    def subject_for(notifications, account)
+      if notifications.one?
+        "#{account.name}: #{notifications.first.payload.title}"
+      else
+        "#{account.name}: #{notifications.size} new notifications"
+      end
+    end
+end
