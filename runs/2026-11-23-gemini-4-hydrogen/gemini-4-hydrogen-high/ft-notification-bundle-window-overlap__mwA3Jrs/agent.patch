+<% @grouped_notifications.each_with_index do |(board, notifications), index| %>
+  <% if index > 0 %>
+    <hr class="notification__board-separator">
+  <% end %>
+
+  <h2 class="notification__board">
+    <%= link_to board.name, board_url(board) %>
+  </h2>
+
+  <% notifications.each do |notification| %>
+    <% payload = notification.payload %>
+    <table class="notification">
+      <tr>
+        <td class="avatar__container">
+          <%= mail_avatar_tag(notification.creator) %>
+        </td>
+        <td>
+          <h3 class="card__title">
+            <%= link_to payload.title, payload.url %>
+          </h3>
+          <p class="notification__author"><%= notification.creator.name %></p>
+          <p class="notification__details"><%= payload.body %></p>
+        </td>
+      </tr>
+    </table>
+  <% end %>
+<% end %>
+
+<p class="footer">
+  <%= link_to "View all notifications", notifications_url %>
+  &middot;
+  <%= link_to "Notification settings", notifications_settings_url %>
+</p>
