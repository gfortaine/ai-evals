 class User::Settings < ApplicationRecord
+  BUNDLE_FREQUENCY_WINDOWS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
   belongs_to :account, default: -> { user.account }
   belongs_to :user
 
+  enum :bundle_email_frequency, %w[ never every_few_hours daily weekly ].index_by(&:itself), default: :every_few_hours
+
