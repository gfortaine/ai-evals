       ActiveSupport::TimeZone[timezone_name] || default_timezone
@@ -10,8 +20,28 @@ class User::Settings < ApplicationRecord
     end
   end
 
+  def bundling_emails?
+    !never?
+  end
+
+  def bundle_aggregation_window
+    BUNDLE_FREQUENCY_WINDOWS[bundle_email_frequency]
+  end
+
   private
     def default_timezone
       ActiveSupport::TimeZone["UTC"]
     end
+
+    def reconcile_pending_bundles
+      if never?
+        user.notification_bundles.pending.destroy_all
+      elsif window = bundle_aggregation_window
+        user.with_lock do
+          if bundle = user.notification_bundles.pending.order(:starts_at).last
+            bundle.update!(ends_at: bundle.starts_at + window)
+          end
+        end
+      end
+    end
 end
