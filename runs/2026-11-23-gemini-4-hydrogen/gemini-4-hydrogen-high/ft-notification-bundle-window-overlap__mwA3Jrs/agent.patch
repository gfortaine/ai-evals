+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.notification_bundles.destroy_all
+    @n1 = notifications(:logo_assignment_kevin)
+    @n2 = notifications(:layout_commented_kevin)
+    @n3 = notifications(:buy_domain_sent_back_to_triage_kevin)
+  end
+
+  test "bundled_notifications sends one email with multiple notifications grouped by board" do
+    bundle = @user.notification_bundles.create!(starts_at: 4.hours.ago, ends_at: Time.current)
+    bundle.items.create!(notification: @n1)
+    bundle.items.create!(notification: @n2)
+
+    email = NotificationMailer.bundled_notifications(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "37signals: 2 new notifications", email.subject
+    assert email.html_part.present?
+    assert email.text_part.present?
+
+    assert_match boards(:writebook).name, email.html_part.body.decoded
+    assert_match @n1.payload.title, email.text_part.body.decoded
+    assert_match @n2.payload.title, email.html_part.body.decoded
+    assert_match @n1.payload.url, email.html_part.body.decoded
+    assert_match @n2.payload.url, email.html_part.body.decoded
+    assert_match Rails.application.routes.url_helpers.notifications_settings_path(script_name: @user.account.slug), email.html_part.body.decoded
+  end
+
+  test "bundled_notifications uses notification title in subject for single notification" do
+    bundle = @user.notification_bundles.create!(starts_at: 4.hours.ago, ends_at: Time.current)
+    bundle.items.create!(notification: @n1)
+
+    email = NotificationMailer.bundled_notifications(bundle)
+
+    assert_equal "37signals: #{@n1.payload.title}", email.subject
+  end
+
+  test "bundled_notifications handles mention notifications" do
+    david = users(:david)
+    david.notification_bundles.destroy_all
+    mention_notification = notifications(:logo_mentioned_david)
+    bundle = david.notification_bundles.create!(starts_at: 4.hours.ago, ends_at: Time.current)
+    bundle.items.create!(notification: mention_notification)
+
+    email = NotificationMailer.bundled_notifications(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ david.identity.email_address ], email.to
+    assert_match mention_notification.payload.title, email.body.encoded
+    assert_match mention_notification.payload.body, email.body.encoded
+  end
+
+  test "bundled_notifications produces no email when there are no unread notifications" do
+    bundle = @user.notification_bundles.create!(starts_at: 4.hours.ago, ends_at: Time.current)
+    bundle.items.create!(notification: @n1)
+    @n1.read
+
+    email = NotificationMailer.bundled_notifications(bundle)
+
+    assert_emails 0 do
+      email.deliver_now
+    end
+  end
+end
