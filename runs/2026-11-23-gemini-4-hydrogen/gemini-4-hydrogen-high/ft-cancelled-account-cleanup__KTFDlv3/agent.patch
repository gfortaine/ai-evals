diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..8c1b6e7
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago and leaves others intact" do
+    due_account = accounts("37s")
+    due_account.cancel(initiated_by: users(:david))
+    due_account.cancellation.update_column(:created_at, 31.days.ago)
+
+    recent_account = accounts(:initech)
+    recent_account.cancel(initiated_by: users(:mike))
+    recent_account.cancellation.update_column(:created_at, 29.days.ago)
+
+    active_account = Account.create!(name: "Active Account")
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(recent_account.id)
+    assert Account.exists?(active_account.id)
+  end
+
+  test "configured as a recurring job" do
+    require "fugit"
+
+    path = Rails.root.join("config/recurring.yml")
+    erb = ERB.new(File.read(path))
+    erb.filename = path.to_s
+    recurring = YAML.safe_load(erb.result, aliases: true)
+    task = recurring.dig("production", "incinerate_due_accounts")
+
+    assert_not_nil task
+    assert_equal "Account::IncinerateDueJob", task["class"]
+    assert_not_nil Fugit.parse(task["schedule"])
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..92f1d6c
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,173 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration includes accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_column(:created_at, 31.days.ago)
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes accounts cancelled less than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_column(:created_at, 29.days.ago)
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes active and reactivated accounts" do
+    other_account = accounts(:initech)
+    assert_not_includes Account.due_for_incineration, other_account
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_column(:created_at, 31.days.ago)
+    @account.reactivate
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "incinerate permanently removes all account data and keeps identities and other accounts intact" do
+    Push::Subscription.any_instance.stubs(:resolved_endpoint_ip).returns("1.2.3.4")
+
+    identity = identities(:david)
+    account = Account.create_with_owner(
+      account: { name: "Doomed Account" },
+      owner: { name: "Owner", identity: identity }
+    )
+    owner = account.users.owner.first
+    member = account.users.create!(name: "Member", role: :member, verified_at: Time.current)
+
+    Current.set(account: account, user: owner) do
+      owner.avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg")
+      owner.avatar.variant(:thumb).processed
+      owner.push_subscriptions.create!(endpoint: "https://fcm.googleapis.com/fcm/send/123", p256dh_key: "key", auth_key: "auth")
+      owner.remember_search("owner query")
+
+      user_export = User::DataExport.create!(account: account, user: owner)
+      user_export.file.attach(io: StringIO.new("zip"), filename: "user_export.zip", content_type: "application/zip")
+
+      account_export = Account::Export.create!(account: account, user: owner)
+      account_export.file.attach(io: StringIO.new("zip"), filename: "account_export.zip", content_type: "application/zip")
+
+      import = Account::Import.create!(account: account, identity: identity, status: :completed)
+      import.file.attach(io: StringIO.new("zip"), filename: "import.zip", content_type: "application/zip")
+
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("orphan"), filename: "orphan.txt", content_type: "text/plain")
+
+      board_embed_blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "board_embed.jpg", content_type: "image/jpeg")
+      board = account.boards.create!(
+        name: "Board 1",
+        creator: owner,
+        public_description: "<p>Hi #{ActionText::Attachment.from_attachable(board_embed_blob).to_html}</p>"
+      )
+      board.publish
+      board.create_entropy!(auto_postpone_period: 7.days, account: account)
+      column = board.columns.create!(name: "Doing")
+      board.accesses.grant_to(member)
+      webhook = board.webhooks.create!(name: "Hook", url: "https://example.com/hook", subscribed_actions: %w[ card_published ])
+
+      card_embed_blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "card_embed.jpg", content_type: "image/jpeg")
+      card = board.cards.create!(
+        title: "Card 1",
+        description: "<p>Desc #{ActionText::Attachment.from_attachable(card_embed_blob).to_html}</p>",
+        status: :published,
+        creator: owner,
+        column: column
+      )
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "card_img.jpg", content_type: "image/jpeg")
+      card.assignments.create!(assignee: member, assigner: owner)
+      tag = account.tags.create!(title: "urgent")
+      card.taggings.create!(tag: tag)
+      card.steps.create!(content: "Step 1")
+      card.reactions.create!(content: "👍", reacter: owner)
+      card.watches.create!(user: owner, watching: true)
+      card.pins.create!(user: owner)
+      card.create_closure!(user: owner)
+      card.create_goldness!
+      card.create_not_now!(user: owner)
+      card.create_activity_spike!
+
+      comment_embed_blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "comment_embed.jpg", content_type: "image/jpeg")
+      comment = card.comments.create!(
+        body: "<p>Comment #{ActionText::Attachment.from_attachable(comment_embed_blob).to_html}</p>",
+        creator: member
+      )
+      comment.reactions.create!(content: "🎉", reacter: owner)
+
+      mention = Mention.create!(source: comment, mentioner: member, mentionee: owner)
+      event = board.events.create!(action: "card_published", creator: owner, eventable: card)
+      Notification.create!(user: owner, creator: member, source: event)
+      Notification.create!(user: member, creator: owner, source: mention)
+      Webhook::Delivery.create!(webhook: webhook, event: event)
+
+      owner.filters.create!(
+        account: account,
+        boards: [ board ],
+        tags: [ tag ],
+        assignees: [ member ],
+        creators: [ owner ],
+        closers: [ owner ]
+      )
+
+      card.reindex
+      comment.reindex
+      account.materialize_storage
+      board.materialize_storage
+      account.cancel(initiated_by: owner)
+    end
+
+    account_id = account.id
+    board_ids = account.board_ids
+    filter_ids = account.filters.ids
+    search_ids = Search::Record.for(account_id).where(account_id: account_id).pluck(:id)
+
+    enqueued_jobs.clear
+
+    account.incinerate
+
+    assert_not Account.exists?(account_id)
+    assert Identity.exists?(identity.id)
+    assert Account.exists?(accounts("37s").id)
+
+    serialized_id = ActiveRecord::Type::Uuid.new.serialize(account_id)
+    quoted_id = ActiveRecord::Base.connection.quote(serialized_id)
+
+    ActiveRecord::Base.connection.tables.each do |table|
+      next unless ActiveRecord::Base.connection.columns(table).any? { it.name == "account_id" }
+
+      remaining = ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM #{table} WHERE account_id = #{quoted_id}")
+      assert_equal 0, remaining.to_i, "Expected 0 rows in #{table} for incinerated account"
+    end
+
+    assert_equal 0, Storage::Total.where(owner_type: "Account", owner_id: account_id).count
+    assert_equal 0, Storage::Total.where(owner_type: "Board", owner_id: board_ids).count
+
+    if filter_ids.any?
+      quoted_filter_ids = filter_ids.map { ActiveRecord::Base.connection.quote(ActiveRecord::Type::Uuid.new.serialize(it)) }.join(",")
+      %w[ assignees_filters boards_filters closers_filters creators_filters filters_tags ].each do |join_table|
+        remaining = ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM #{join_table} WHERE filter_id IN (#{quoted_filter_ids})")
+        assert_equal 0, remaining.to_i, "Expected 0 rows in #{join_table} for incinerated account"
+      end
+    end
+
+    if search_ids.any? && defined?(Search::Record::SQLite::Fts)
+      assert_equal 0, Search::Record::SQLite::Fts.where(rowid: search_ids).count
+    end
+
+    perform_enqueued_jobs
+  end
+
+  test "incinerate is safe when called on already destroyed account" do
+    account = Account.create!(name: "Temp Account")
+    account.incinerate
+
+    assert_nothing_raised do
+      account.incinerate
+    end
+  end
+end
