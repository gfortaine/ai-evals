diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..899b305
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "show renders HTML shelf report with formatted date and summary" do
+    book = books(:handbook)
+    leaves(:welcome_page).leafable.update!(body: "a" * 1200)
+    book.update!(updated_at: Time.zone.local(2026, 3, 15, 14, 30, 0))
+
+    get book_report_path(book)
+
+    assert_response :success
+    assert_in_body "Last updated March 15, 2026"
+    assert_in_body "Handbook — #{book.markable.length.to_fs(:delimited)} characters"
+  end
+
+  test "show renders text report card with formatted filename and contents" do
+    book = books(:handbook)
+    book.update!(
+      created_at: Time.zone.local(2026, 1, 5, 9, 15, 0),
+      updated_at: Time.zone.local(2026, 3, 15, 14, 30, 45)
+    )
+
+    get book_report_path(book, format: :text)
+
+    assert_response :success
+    assert_equal "attachment; filename=\"shelf-report-20260315143045.txt\"; filename*=UTF-8''shelf-report-20260315143045.txt",
+      response.headers["Content-Disposition"]
+    assert_in_body "Book: Handbook"
+    assert_in_body "Started: January 05, 2026 09:15"
+    assert_in_body "Updated: 15 Mar 14:30"
+    assert_in_body "Covers: #{book.leaves.active.positioned.pluck(:id).join(",")}"
+  end
+end
