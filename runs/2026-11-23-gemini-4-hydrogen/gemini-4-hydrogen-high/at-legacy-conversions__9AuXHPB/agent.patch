+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly formats published book dates as short" do
+    book = books(:manual)
+    book.update!(published: true, updated_at: Time.zone.local(2026, 3, 15, 14, 30, 0))
+
+    email = ReportDigestMailer.weekly(users(:kevin))
+
+    assert_equal [ users(:kevin).email_address ], email.to
+    assert_includes email.text_part ? email.text_part.body.to_s : email.body.to_s, "* Manual, last edited 15 Mar"
+  end
+end
