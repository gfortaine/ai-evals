diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..1a6aa60
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class ReportArchiveJobTest < ActiveJob::TestCase
+  setup do
+    @archive_dir = Rails.root.join(ReportArchiveJob::ARCHIVE_DIR)
+  end
+
+  teardown do
+    FileUtils.rm_rf(@archive_dir)
+  end
+
+  test "perform archives book with last_edited_at timestamp" do
+    book = books(:handbook)
+    edited_at = Time.zone.local(2026, 3, 15, 14, 30, 0)
+    book.leaves.active.update_all(updated_at: edited_at)
+
+    ReportArchiveJob.perform_now(book)
+
+    archive_path = @archive_dir.join("book-#{book.id}.txt")
+    assert File.exist?(archive_path)
+    content = File.read(archive_path)
+    assert_match(/\A# archived 2026-03-15 14:30:00 UTC\n\n/, content)
+    assert_includes content, book.markable
+  end
+
+  test "perform handles book with no active leaves" do
+    book = books(:manual)
+
+    ReportArchiveJob.perform_now(book)
+
+    archive_path = @archive_dir.join("book-#{book.id}.txt")
+    assert File.exist?(archive_path)
+    assert_equal "# archived \n\n", File.read(archive_path)
+  end
+end
diff --git a/test/lib/publishing/report_card_test.rb b/test/lib/publishing/report_card_test.rb
new file mode 100644
index 0000000..15de3df
--- /dev/null
+++ b/test/lib/publishing/report_card_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class Publishing::ReportCardTest < ActiveSupport::TestCase
+  test "to_text formats rows and active leaf ids" do
+    book = books(:handbook)
+    book.update!(
+      created_at: Time.zone.local(2026, 1, 5, 9, 15, 0),
+      updated_at: Time.zone.local(2026, 3, 15, 14, 30, 0)
+    )
+    ids = book.leaves.active.positioned.pluck(:id).join(",")
+
+    expected = <<~TEXT
+      Book: Handbook
+      Leaves: #{book.leaf_count}
+      Started: January 05, 2026 09:15
+      Updated: 15 Mar 14:30
+      Covers: #{ids}
+    TEXT
+
+    assert_equal expected, Publishing::ReportCard.new(book).to_text
+  end
+
+  test "to_text formats empty leaves list as null" do
+    book = books(:manual)
+    book.update!(
+      created_at: Time.zone.local(2026, 1, 5, 9, 15, 0),
+      updated_at: Time.zone.local(2026, 3, 15, 14, 30, 0)
+    )
+
+    assert_includes Publishing::ReportCard.new(book).to_text, "Covers: null\n"
+  end
+end
