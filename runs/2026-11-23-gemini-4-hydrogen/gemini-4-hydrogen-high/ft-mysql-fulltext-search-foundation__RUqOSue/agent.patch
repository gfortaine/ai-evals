+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlight_card_title wraps matched words in mark tags" do
+    card = cards(:logo)
+
+    assert_equal "The <mark>logo</mark> isn&#39;t <mark>big</mark> enough",
+      highlight_card_title(card, [ "logo", "big" ])
+  end
+
+  test "highlight_card_title preserves inline code spans and escapes HTML" do
+    card = cards(:logo).tap { |c| c.title = "Fix the `bug` in <script>" }
+
+    assert_equal "Fix the <code><mark>bug</mark></code> in &lt;<mark>script</mark>&gt;",
+      highlight_card_title(card, [ "bug", "script" ])
+  end
+
+  test "highlight_search_terms handles special regex characters and overlapping terms" do
+    assert_equal "Upgrade <mark>c++</mark> and <mark>logo</mark> <mark>log</mark>",
+      highlight_search_terms("Upgrade c++ and logo log", [ "c++", "log", "logo" ])
+  end
+
+  test "highlight_search_terms does not match HTML entities" do
+    assert_equal "Tom &amp; Jerry <mark>amp</mark>",
+      highlight_search_terms("Tom & Jerry amp", [ "amp" ])
+  end
+
+  test "search_description_excerpt centers around match in long description" do
+    card = cards(:logo)
+    card.update!(description: ("prefix " * 40) + "needle" + (" suffix" * 40))
+
+    excerpt = search_description_excerpt(card, [ "needle" ])
+
+    assert_not_nil excerpt
+    assert_includes excerpt, "<mark>needle</mark>"
+    assert excerpt.start_with?("…")
+    assert excerpt.end_with?("…")
+  end
+
+  test "search_matching_comments returns only comments matching terms" do
+    card = cards(:layout)
+    matching_comments = search_matching_comments(card, [ "overflowing" ])
+
+    assert_equal 1, matching_comments.size
+    comment, excerpt = matching_comments.first
+    assert_equal comments(:layout_overflowing_david), comment
+    assert_equal "The text is <mark>overflowing</mark> the container.", excerpt
+  end
+
+  test "search_description_excerpt includes distant matched terms" do
+    card = cards(:logo)
+    card.update!(description: "alpha " + ("filler " * 60) + "omega")
+
+    excerpt = search_description_excerpt(card, [ "alpha", "omega" ])
+
+    assert_includes excerpt, "<mark>alpha</mark>"
+    assert_includes excerpt, "<mark>omega</mark>"
+  end
+end
