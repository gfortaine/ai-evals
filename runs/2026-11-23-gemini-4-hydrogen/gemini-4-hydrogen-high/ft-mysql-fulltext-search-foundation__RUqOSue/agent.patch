+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "finds cards by title case-insensitively" do
+    results = Search.new(users(:david), "LOGO").cards
+
+    assert_equal [ cards(:logo) ], results.to_a
+  end
+
+  test "finds cards by description" do
+    cards(:logo).update!(description: "Please resize the vector illustration")
+
+    results = Search.new(users(:david), "illustration").cards
+
+    assert_equal [ cards(:logo) ], results.to_a
+  end
+
+  test "finds cards by any comment body" do
+    results = Search.new(users(:david), "overflowing").cards
+
+    assert_equal [ cards(:layout) ], results.to_a
+  end
+
+  test "finds cards matching multiple terms across title, description, and comments" do
+    cards(:logo).update!(description: "Vector artwork needs updating")
+    cards(:logo).comments.create!(body: "Check the homepage header", creator: users(:david))
+
+    assert_equal [ cards(:logo) ], Search.new(users(:david), "logo artwork header").cards.to_a
+    assert_empty Search.new(users(:david), "logo nonexistent").cards
+  end
+
+  test "orders results newest first" do
+    older = boards(:writebook).cards.create!(title: "Widget alpha", status: :published, creator: users(:david), created_at: 2.days.ago)
+    newer = boards(:writebook).cards.create!(title: "Widget beta", status: :published, creator: users(:david), created_at: 1.hour.ago)
+
+    results = Search.new(users(:david), "Widget").cards.to_a
+
+    assert_equal [ newer, older ], results
+  end
+
+  test "only returns cards from boards the user currently has access to" do
+    secret_card = boards(:private).cards.create!(title: "Secret roadmap item", status: :published, creator: users(:kevin))
+
+    assert_not_includes Search.new(users(:david), "Secret").cards, secret_card
+    assert_includes Search.new(users(:kevin), "Secret").cards, secret_card
+
+    boards(:private).accesses.grant_to(users(:david))
+    assert_includes Search.new(users(:david), "Secret").cards, secret_card
+
+    boards(:private).accesses.revoke_from(users(:david))
+    assert_not_includes Search.new(users(:david), "Secret").cards, secret_card
+  end
+
+  test "never leaks cards from other accounts" do
+    assert_empty Search.new(users(:david), "paycheck").cards
+    assert_equal [ cards(:paycheck) ], Search.new(users(:mike), "paycheck").cards.to_a
+  end
+
+  test "never returns draft cards or their comments even for the creator" do
+    draft = boards(:writebook).cards.create!(title: "Draft zeppelin plan", description: "Zeppelin description", status: :published, creator: users(:david))
+    draft.comments.create!(body: "Zeppelin comment", creator: users(:david))
+    draft.update_column(:status, "drafted")
+
+    assert_empty Search.new(users(:david), "Zeppelin").cards
+  end
+
+  test "does not match HTML tags or entities in rich text" do
+    cards(:logo).update!(description: "<p><strong>Tom &amp; Jerry</strong></p>")
+
+    assert_empty Search.new(users(:david), "strong").cards
+    assert_empty Search.new(users(:david), "amp").cards
+    assert_equal [ cards(:logo) ], Search.new(users(:david), "Tom & Jerry").cards.to_a
+  end
+
+  test "matches SQL wildcard characters literally" do
+    card_with_percent = boards(:writebook).cards.create!(title: "100% complete", status: :published, creator: users(:david))
+    boards(:writebook).cards.create!(title: "1000 complete", status: :published, creator: users(:david))
+
+    assert_equal [ card_with_percent ], Search.new(users(:david), "100%").cards.to_a
+  end
+
+  test "returns no cards for blank or invalid queries" do
+    assert_empty Search.new(users(:david), nil).cards
+    assert_empty Search.new(users(:david), "").cards
+    assert_empty Search.new(users(:david), "   ").cards
+    assert_empty Search.new(users(:david), [ "logo" ]).cards
+  end
+end
