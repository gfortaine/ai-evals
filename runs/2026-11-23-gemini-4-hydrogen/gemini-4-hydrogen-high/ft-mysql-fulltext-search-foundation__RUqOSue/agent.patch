diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..07d003c
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,124 @@
+module SearchesHelper
+  EXCERPT_RADIUS = 100
+  MAX_FULL_TEXT_LENGTH = 240
+
+  def highlight_card_title(card, terms)
+    return card_html_title(card) if card.title.blank? || terms.blank?
+
+    parts = card.title.split(/(`[^`]+`)/).map do |segment|
+      if segment.match?(/\A`[^`]+`\z/)
+        tag.code(highlight_search_terms(segment[1..-2], terms))
+      else
+        highlight_search_terms(segment, terms)
+      end
+    end
+
+    safe_join(parts)
+  end
+
+  def highlight_search_terms(text, terms)
+    return "".html_safe if text.blank?
+
+    pattern = search_terms_pattern(terms)
+    if pattern
+      parts = []
+      last_index = 0
+
+      text.scan(pattern) do
+        match = Regexp.last_match
+        parts << ERB::Util.html_escape(text[last_index...match.begin(0)])
+        parts << tag.mark(match[0])
+        last_index = match.end(0)
+      end
+
+      parts << ERB::Util.html_escape(text[last_index..])
+      safe_join(parts)
+    else
+      ERB::Util.html_escape(text)
+    end
+  end
+
+  def search_description_excerpt(card, terms)
+    search_rich_text_excerpt(card.description, terms)
+  end
+
+  def search_matching_comments(card, terms)
+    return [] if terms.blank?
+
+    card.comments.sort_by { |comment| [ comment.created_at, comment.id ] }.filter_map do |comment|
+      if excerpt = search_rich_text_excerpt(comment.body, terms)
+        [ comment, excerpt ]
+      end
+    end
+  end
+
+  private
+    def search_rich_text_excerpt(rich_text, terms)
+      return nil if rich_text.blank? || terms.blank?
+
+      text = rich_text.to_plain_text.gsub(/\s+/, " ").strip
+      return nil if text.blank?
+
+      pattern = search_terms_pattern(terms)
+      return nil unless pattern && text.match?(pattern)
+
+      snippet = extract_matching_snippet(text, terms, pattern)
+      highlight_search_terms(snippet, terms)
+    end
+
+    def extract_matching_snippet(text, terms, pattern)
+      if text.length <= MAX_FULL_TEXT_LENGTH
+        text
+      else
+        snippets = collect_term_snippets(text, terms, pattern)
+        snippets.join(" … ")
+      end
+    end
+
+    def collect_term_snippets(text, terms, pattern)
+      first_match = text.match(pattern)
+      ranges = [ snippet_range_around(text, first_match) ]
+      covered = text[ranges.first]
+
+      terms.each do |term|
+        term_pattern = Regexp.new(Regexp.escape(term), Regexp::IGNORECASE)
+        next if covered.match?(term_pattern)
+
+        if match = text.match(term_pattern)
+          range = snippet_range_around(text, match)
+          ranges << range
+          covered = "#{covered} #{text[range]}"
+        end
+      end
+
+      ranges.sort_by(&:begin).map do |range|
+        prefix = range.begin > 0 ? "…" : ""
+        suffix = range.end < text.length ? "…" : ""
+        "#{prefix}#{text[range].strip}#{suffix}"
+      end
+    end
+
+    def snippet_range_around(text, match)
+      start_index = [ match.begin(0) - EXCERPT_RADIUS, 0 ].max
+      end_index = [ match.end(0) + EXCERPT_RADIUS, text.length ].min
+
+      if start_index > 0
+        space = text.index(/\s/, start_index)
+        start_index = space + 1 if space && space < match.begin(0) && (space - start_index) < 20
+      end
+
+      if end_index < text.length
+        space = text.rindex(/\s/, end_index)
+        end_index = space if space && space > match.end(0) && (end_index - space) < 20
+      end
+
+      start_index...end_index
+    end
+
+    def search_terms_pattern(terms)
+      escaped_patterns = terms.compact_blank.sort_by { -it.length }.map { Regexp.escape(it) }
+      if escaped_patterns.any?
+        Regexp.new(escaped_patterns.join("|"), Regexp::IGNORECASE)
+      end
+    end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..14f53af
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,113 @@
+class Search
+  attr_reader :user, :query
+
+  def initialize(user, query)
+    @user = user
+    @query = normalize_query(query)
+  end
+
+  def blank?
+    terms.empty?
+  end
+
+  def present?
+    terms.any?
+  end
+
+  def terms
+    @terms ||= query.split.uniq(&:downcase)
+  end
+
+  def cards
+    @cards ||= if terms.any?
+      matching_cards
+    else
+      Card.none
+    end
+  end
+
+  private
+    def normalize_query(raw_query)
+      case raw_query
+      when String, Symbol, Numeric
+        raw_query.to_s.squish
+      else
+        ""
+      end
+    end
+
+    def matching_cards
+      ids = candidate_cards.select { |card| card_matches_all_terms?(card) }.map(&:id)
+
+      if ids.any?
+        accessible_published_cards
+          .where(id: ids)
+          .reverse_chronologically
+          .preloaded
+          .preload(comments: [ { creator: :avatar_attachment }, :rich_text_body ])
+      else
+        Card.none
+      end
+    end
+
+    def candidate_cards
+      scope = accessible_published_cards.reverse_chronologically
+      terms.each do |term|
+        scope = scope.where(sql_term_condition(term))
+      end
+      scope.preload(:rich_text_description, comments: :rich_text_body)
+    end
+
+    def accessible_published_cards
+      user.accessible_cards.published
+    end
+
+    def sql_term_condition(term)
+      title_pattern = like_pattern(term)
+      rich_text_patterns = rich_text_like_patterns(term)
+      rich_text_sql = rich_text_patterns.map { "LOWER(action_text_rich_texts.body) LIKE LOWER(?)" }.join(" OR ")
+
+      Card.sanitize_sql_array([
+        "(LOWER(cards.title) LIKE LOWER(?) OR " \
+        "EXISTS (SELECT 1 FROM action_text_rich_texts " \
+        "WHERE action_text_rich_texts.record_type = 'Card' " \
+        "AND action_text_rich_texts.record_id = cards.id " \
+        "AND action_text_rich_texts.name = 'description' " \
+        "AND (#{rich_text_sql})) OR " \
+        "EXISTS (SELECT 1 FROM comments " \
+        "INNER JOIN action_text_rich_texts " \
+        "ON action_text_rich_texts.record_type = 'Comment' " \
+        "AND action_text_rich_texts.record_id = comments.id " \
+        "AND action_text_rich_texts.name = 'body' " \
+        "WHERE comments.card_id = cards.id " \
+        "AND (#{rich_text_sql})))",
+        title_pattern, *rich_text_patterns, *rich_text_patterns
+      ])
+    end
+
+    def rich_text_like_patterns(term)
+      escaped = ERB::Util.html_escape(term)
+      if escaped == term
+        [ like_pattern(term) ]
+      else
+        [ like_pattern(term), like_pattern(escaped) ]
+      end
+    end
+
+    def like_pattern(term)
+      "%#{term.gsub(/[%_\\]/, "%")}%"
+    end
+
+    def card_matches_all_terms?(card)
+      searchable_texts = [
+        card.title,
+        card.description.to_plain_text,
+        *card.comments.map { |comment| comment.body.to_plain_text }
+      ]
+
+      terms.all? do |term|
+        needle = term.downcase
+        searchable_texts.any? { |text| text.present? && text.downcase.include?(needle) }
+      end
+    end
+end
