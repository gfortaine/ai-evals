+@layer components {
+  .search {
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space);
+    inline-size: 100%;
+    margin-inline: auto;
+    max-inline-size: 70ch;
+    padding-block: var(--block-space);
+    text-align: start;
+
+    mark {
+      background-color: var(--color-highlight);
+      border-radius: 0.2em;
+      color: inherit;
+      padding-inline: 0.15em;
+    }
+  }
+
+  .search__form {
+    display: flex;
+    gap: var(--inline-space-half);
+    inline-size: 100%;
+  }
+
+  .search__input {
+    flex: 1;
+    min-inline-size: 0;
+  }
+
+  .search__results {
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space);
+    inline-size: 100%;
+  }
+
+  .search__card {
+    .card__header .card__column-name--current {
+      --btn-padding: 0.1em 0.5em;
+
+      background: none;
+      border: 1px solid currentColor;
+      color: var(--card-color);
+      display: inline-flex;
+      flex: 0 1 auto;
+      inline-size: fit-content;
+      margin: 0 0 0 auto;
+    }
+  }
+
+  .search__excerpt {
+    color: var(--color-ink-darker);
+    font-size: var(--text-small);
+    line-height: 1.45;
+    margin-block: var(--block-space-half) 0;
+  }
+
+  .search__comments {
+    display: flex;
+    flex-direction: column;
+    gap: 0.4ch;
+    margin-block-start: var(--block-space-half);
+  }
+
+  .search__comment {
+    background-color: color-mix(in srgb, var(--color-canvas) 70%, transparent);
+    border-inline-start: 2px solid var(--card-color);
+    border-radius: 0 0.25em 0.25em 0;
+    color: var(--color-ink-darker);
+    display: block;
+    font-size: var(--text-small);
+    line-height: 1.4;
+    padding: 0.4em 0.75em;
+    position: relative;
+    text-decoration: none;
+    z-index: 1;
+
+    @media (any-hover: hover) {
+      &:hover {
+        background-color: var(--color-canvas);
+      }
+    }
+  }
+
+  .search__comment-author {
+    color: var(--color-ink);
+    font-weight: 600;
+    margin-inline-end: 0.4ch;
+  }
+}
