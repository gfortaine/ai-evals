diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..f7a7fde
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,135 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path(q: "logo")
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "renders search page without query" do
+    get search_path
+    assert_response :success
+    assert_select "input[type=search][name=q]"
+  end
+
+  test "finds cards by title with matched words wrapped in mark" do
+    get search_path, params: { q: "logo big" }
+    assert_response :success
+
+    assert_select ".search__card", count: 1
+    assert_select ".search__card mark", text: "logo"
+    assert_select ".search__card mark", text: "big"
+  end
+
+  test "finds cards by description with matched word wrapped in mark" do
+    cards(:shipping).update!(description: ("intro " * 50) + "deployment checklist" + (" outro" * 50))
+
+    get search_path, params: { q: "deployment" }
+    assert_response :success
+
+    assert_select ".search__card", count: 1
+    assert_select ".search__card .card__title", text: /We need to ship the app/
+    assert_select ".search__card .search__excerpt mark", text: "deployment"
+  end
+
+  test "finds cards by comment body with matched word wrapped in mark" do
+    get search_path, params: { q: "overflowing" }
+    assert_response :success
+
+    assert_select ".search__card", count: 1
+    assert_select ".search__card .card__title", text: /Layout is broken/
+    assert_select ".search__card .search__comment mark", text: "overflowing"
+  end
+
+  test "orders results newest first" do
+    older, newer = with_current_user(:david) do
+      [
+        boards(:writebook).cards.create!(title: "Launchpad one", status: :published, creator: users(:david), created_at: 3.days.ago),
+        boards(:writebook).cards.create!(title: "Launchpad two", status: :published, creator: users(:david), created_at: 1.minute.ago)
+      ]
+    end
+
+    get search_path, params: { q: "Launchpad" }
+    assert_response :success
+
+    titles = css_select(".search__card .card__title").map { |el| el.text.strip }
+    assert_equal [ newer.title, older.title ], titles
+  end
+
+  test "hides cards from boards user cannot access" do
+    with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Confidential launch", status: :published, creator: users(:kevin))
+    end
+
+    get search_path, params: { q: "Confidential" }
+    assert_response :success
+    assert_select ".search__card", count: 0
+
+    logout_and_sign_in_as :kevin
+    get search_path, params: { q: "Confidential" }
+    assert_response :success
+    assert_select ".search__card", count: 1
+  end
+
+  test "never shows draft cards or their comments" do
+    draft = with_current_user(:david) do
+      card = boards(:writebook).cards.create!(title: "Unpublished unicorn", description: "Unicorn details", status: :published, creator: users(:david))
+      card.comments.create!(body: "Unicorn comment", creator: users(:david))
+      card.update_column(:status, "drafted")
+      card
+    end
+
+    get search_path, params: { q: "Unicorn" }
+    assert_response :success
+    assert_select ".search__card", count: 0
+  end
+
+  test "supports JSON format" do
+    get search_path(format: :json), params: { q: "logo" }
+    assert_response :success
+
+    assert_equal [ cards(:logo).number ], @response.parsed_body.pluck("number")
+  end
+
+  test "handles non-string q param safely" do
+    get "#{search_path}?q[]=logo"
+    assert_response :success
+    assert_select ".search__card", count: 0
+  end
+
+  test "renders only matching comments on a card" do
+    with_current_user(:david) do
+      cards(:layout).comments.create!(body: "Unrelated comment body", creator: users(:david))
+      cards(:layout).comments.create!(body: "Another overflowing detail", creator: users(:david))
+    end
+
+    get search_path, params: { q: "overflowing" }
+    assert_response :success
+
+    assert_select ".search__comment", count: 2
+    assert_select ".search__comment", text: /Unrelated/, count: 0
+    assert_select ".search__comment mark", text: "overflowing", count: 2
+  end
+
+  test "paginates results across pages" do
+    with_current_user(:david) do
+      18.times do |i|
+        boards(:writebook).cards.create!(title: "Paginated item #{i}", status: :published, creator: users(:david), created_at: i.minutes.ago)
+      end
+    end
+
+    get search_path, params: { q: "Paginated" }
+    assert_response :success
+    assert_select ".search__card", count: 15
+    assert_select %(a.pagination-link[href*="page=2"])
+
+    get search_path, params: { q: "Paginated", page: 2 }
+    assert_response :success
+    assert_select ".search__card", count: 3
+  end
+end
diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
