@@ -0,0 +1,14 @@
+require "test_helper"
+
+class Book::ReportableTest < ActiveSupport::TestCase
+  test "report_summary formats character count with delimiter" do
+    leaves(:welcome_page).leafable.update!(body: "x" * 1_500)
+    book = books(:handbook)
+
+    summary = book.report_summary
+    expected_length = ActiveSupport::NumberHelper.number_to_delimited(book.markable.length)
+
+    assert_equal "#{book.title} — #{expected_length} characters", summary
+    assert_includes summary, ","
+  end
+end
