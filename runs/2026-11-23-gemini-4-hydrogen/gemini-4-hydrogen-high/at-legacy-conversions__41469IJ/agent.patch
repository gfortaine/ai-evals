diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..5d0bf21
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @book = books(:handbook)
+    sign_in :kevin
+  end
+
+  test "show renders html report with formatted date and delimited character count" do
+    leaves(:welcome_page).leafable.update!(body: "a" * 1_200)
+
+    get book_report_path(@book)
+
+    assert_response :success
+    assert_in_body "Last updated #{@book.updated_at.to_date.to_fs(:long)}"
+    assert_in_body "1,2"
+    assert_in_body "characters"
+  end
+
+  test "show renders text report card with numbered timestamp filename" do
+    get book_report_path(@book, format: :text)
+
+    assert_response :success
+    assert_equal "text/plain", response.media_type
+    assert_includes response.headers["Content-Disposition"], "shelf-report-#{@book.updated_at.to_fs(:number)}.txt"
+    assert_in_body "Book: #{@book.title}"
+    assert_in_body "Started: #{@book.created_at.to_fs(:long)}"
+    assert_in_body "Updated: #{@book.updated_at.to_fs(:short)}"
+    assert_in_body "Covers: #{@book.leaves.active.positioned.pluck(:id).join(",")}"
+  end
+end
diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..2d45599
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class ReportArchiveJobTest < ActiveJob::TestCase
+  setup do
+    @archived_paths = []
+  end
+
+  teardown do
+    @archived_paths.each { |path| FileUtils.rm_f(path) }
+  end
+
+  test "perform writes archive with last_edited_at timestamp" do
+    book = books(:handbook)
+    path = Rails.root.join(ReportArchiveJob::ARCHIVE_DIR, "book-#{book.id}.txt")
+    @archived_paths << path
+
+    ReportArchiveJob.perform_now(book)
+
+    assert File.exist?(path)
+    content = File.read(path)
+    assert_includes content, "# archived #{book.last_edited_at}\n\n"
+    assert_includes content, book.markable
+  end
+
+  test "perform writes archive when book has no active leaves" do
+    book = books(:manual)
+    path = Rails.root.join(ReportArchiveJob::ARCHIVE_DIR, "book-#{book.id}.txt")
+    @archived_paths << path
+
+    ReportArchiveJob.perform_now(book)
+
+    assert File.exist?(path)
+    assert_equal "# archived \n\n", File.read(path)
+  end
+end
diff --git a/test/lib/publishing/report_card_test.rb b/test/lib/publishing/report_card_test.rb
new file mode 100644
index 0000000..b92f9d2
--- /dev/null
+++ b/test/lib/publishing/report_card_test.rb
@@ -0,0 +1,24 @@
+require "test_helper"
+
+class Publishing::ReportCardTest < ActiveSupport::TestCase
+  test "to_text formats timestamps and active leaf ids" do
+    book = books(:handbook)
+    expected_ids = book.leaves.active.positioned.pluck(:id).join(",")
+
+    text = Publishing::ReportCard.new(book).to_text
+
+    assert_includes text, "Book: #{book.title}\n"
+    assert_includes text, "Leaves: #{book.leaf_count}\n"
+    assert_includes text, "Started: #{book.created_at.to_fs(:long)}\n"
+    assert_includes text, "Updated: #{book.updated_at.to_fs(:short)}\n"
+    assert_includes text, "Covers: #{expected_ids}\n"
+  end
+
+  test "to_text outputs null for covers when book has no active leaves" do
+    book = books(:manual)
+
+    text = Publishing::ReportCard.new(book).to_text
+
+    assert_includes text, "Covers: null\n"
+  end
+end
diff --git a/test/mailers/report_digest_mailer_test.rb b/test/mailers/report_digest_mailer_test.rb
new file mode 100644
index 0000000..c201ab2
--- /dev/null
+++ b/test/mailers/report_digest_mailer_test.rb
@@ -0,0 +1,14 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly formats published book dates with short format" do
+    book = books(:handbook)
+    book.update!(published: true)
+
+    mail = ReportDigestMailer.weekly(users(:david))
+
+    assert_equal [ users(:david).email_address ], mail.to
+    assert_equal "Your Writebook digest", mail.subject
+    assert_includes mail.body.encoded, "* #{book.title}, last edited #{book.updated_at.to_date.to_fs(:short)}"
+  end
+end
