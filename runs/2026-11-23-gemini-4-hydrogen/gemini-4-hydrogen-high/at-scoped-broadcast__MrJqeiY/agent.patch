diff --git a/test/channels/leaves/being_edited_channel_test.rb b/test/channels/leaves/being_edited_channel_test.rb
new file mode 100644
index 0000000..097262e
--- /dev/null
+++ b/test/channels/leaves/being_edited_channel_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class Leaves::BeingEditedChannelTest < ActionCable::Channel::TestCase
+  test "subscribes an editor to their user-scoped leaf stream" do
+    stub_connection current_user: users(:kevin)
+
+    subscribe signed_stream_name: signed_stream_for(leaves(:welcome_page), users(:kevin))
+
+    assert subscription.confirmed?
+    assert_has_stream_for [ leaves(:welcome_page), users(:kevin) ]
+  end
+
+  test "subscribes an administrator without an explicit access record" do
+    books(:handbook).access_for(user: users(:david)).destroy!
+    stub_connection current_user: users(:david)
+
+    subscribe signed_stream_name: signed_stream_for(leaves(:welcome_page), users(:david))
+
+    assert subscription.confirmed?
+    assert_has_stream_for [ leaves(:welcome_page), users(:david) ]
+  end
+
+  test "rejects a reader" do
+    stub_connection current_user: users(:jz)
+
+    subscribe signed_stream_name: signed_stream_for(leaves(:welcome_page), users(:jz))
+
+    assert subscription.rejected?
+  end
+
+  test "rejects a user without access to the book" do
+    books(:handbook).access_for(user: users(:kevin)).destroy!
+    stub_connection current_user: users(:kevin)
+
+    subscribe signed_stream_name: signed_stream_for(leaves(:welcome_page), users(:kevin))
+
+    assert subscription.rejected?
+  end
+
+  test "rejects a collaborator removed from the book even with a previously signed stream name" do
+    signed_name = signed_stream_for(leaves(:welcome_page), users(:kevin))
+    books(:handbook).update_access(editors: [ users(:david).id ], readers: [])
+
+    stub_connection current_user: users(:kevin)
+    subscribe signed_stream_name: signed_name
+
+    assert subscription.rejected?
+  end
+
+  test "rejects subscribing to another user's signed stream name" do
+    stub_connection current_user: users(:kevin)
+
+    subscribe signed_stream_name: signed_stream_for(leaves(:welcome_page), users(:david))
+
+    assert subscription.rejected?
+  end
+
+  test "rejects an inactive user" do
+    users(:kevin).deactivate
+    stub_connection current_user: users(:kevin)
+
+    subscribe signed_stream_name: signed_stream_for(leaves(:welcome_page), users(:kevin))
+
+    assert subscription.rejected?
+  end
+
+  test "rejects a trashed leaf" do
+    leaves(:welcome_page).trashed!
+    stub_connection current_user: users(:kevin)
+
+    subscribe signed_stream_name: signed_stream_for(leaves(:welcome_page), users(:kevin))
+
+    assert subscription.rejected?
+  end
+
+  test "rejects a shared or tampered stream name" do
+    stub_connection current_user: users(:kevin)
+
+    subscribe signed_stream_name: Leaves::BeingEditedChannel.signed_stream_name([ leaves(:welcome_page), :being_edited ])
+    assert subscription.rejected?
+
+    subscribe signed_stream_name: Leaves::BeingEditedChannel.signed_stream_name([ books(:handbook), :being_edited, users(:kevin) ])
+    assert subscription.rejected?
+
+    subscribe signed_stream_name: "invalid"
+    assert subscription.rejected?
+  end
+
+  private
+    def signed_stream_for(leaf, user)
+      Leaves::BeingEditedChannel.signed_stream_name([ leaf, :being_edited, user ])
+    end
+end
diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..c985487 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -1,6 +1,9 @@
 require "test_helper"
 
 class LeafablesControllerTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+  include ActiveJob::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -117,4 +120,87 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "edit subscribes to user-scoped being edited channel" do
+    get edit_book_page_path(books(:handbook), leaves(:welcome_page))
+
+    assert_response :success
+    expected_stream = Leaves::BeingEditedChannel.signed_stream_name([ leaves(:welcome_page), :being_edited, users(:kevin) ])
+    assert_select "turbo-cable-stream-source[channel=\"Leaves::BeingEditedChannel\"][signed-stream-name=\"#{expected_stream}\"]"
+  end
+
+  test "update broadcasts being edited indicator only to other current editors" do
+    perform_enqueued_jobs do
+      patch book_page_path(books(:handbook), leaves(:welcome_page), format: :turbo_stream), params: {
+        leaf: { title: "Updated" }, page: { body: "Updated body" }
+      }
+    end
+
+    assert_response :success
+
+    assert_equal 1, broadcasts_for(leaves(:welcome_page), users(:david)).size
+    assert_includes broadcasts_for(leaves(:welcome_page), users(:david)).first, "Kevin"
+
+    assert_equal 1, broadcasts_for(leaves(:welcome_page), users(:jason)).size
+    assert_includes broadcasts_for(leaves(:welcome_page), users(:jason)).first, "Kevin"
+
+    assert_empty broadcasts_for(leaves(:welcome_page), users(:kevin))
+    assert_empty broadcasts_for(leaves(:welcome_page), users(:jz))
+    assert_empty broadcasts(Turbo::StreamsChannel.verified_stream_name(Turbo::StreamsChannel.signed_stream_name([ leaves(:welcome_page), :being_edited ])))
+  end
+
+  test "update does not broadcast being edited indicator to collaborator removed from the book" do
+    books(:handbook).update_access(editors: [ users(:david).id, users(:jason).id ], readers: [])
+
+    sign_in :david
+
+    perform_enqueued_jobs do
+      patch book_page_path(books(:handbook), leaves(:welcome_page), format: :turbo_stream), params: {
+        leaf: { title: "Updated" }, page: { body: "Updated body" }
+      }
+    end
+
+    assert_response :success
+    assert_empty broadcasts_for(leaves(:welcome_page), users(:kevin))
+    assert_equal 1, broadcasts_for(leaves(:welcome_page), users(:jason)).size
+    assert_includes broadcasts_for(leaves(:welcome_page), users(:jason)).first, "David"
+  end
+
+  test "update does not broadcast being edited indicator to collaborator downgraded to reader or demoted admin" do
+    books(:handbook).update_access(editors: [ users(:david).id ], readers: [ users(:kevin).id ])
+    books(:handbook).access_for(user: users(:jason)).destroy!
+    users(:jason).update!(role: :member)
+
+    sign_in :david
+
+    perform_enqueued_jobs do
+      patch book_page_path(books(:handbook), leaves(:welcome_page), format: :turbo_stream), params: {
+        leaf: { title: "Updated" }, page: { body: "Updated body" }
+      }
+    end
+
+    assert_response :success
+    assert_empty broadcasts_for(leaves(:welcome_page), users(:kevin))
+    assert_empty broadcasts_for(leaves(:welcome_page), users(:jason))
+  end
+
+  test "update does not broadcast to collaborator removed before queued job runs" do
+    sign_in :david
+
+    patch book_page_path(books(:handbook), leaves(:welcome_page), format: :turbo_stream), params: {
+      leaf: { title: "Updated" }, page: { body: "Updated body" }
+    }
+    assert_response :success
+
+    books(:handbook).update_access(editors: [ users(:david).id, users(:jason).id ], readers: [])
+    perform_enqueued_jobs
+
+    assert_empty broadcasts_for(leaves(:welcome_page), users(:kevin))
+    assert_equal 1, broadcasts_for(leaves(:welcome_page), users(:jason)).size
+  end
+
+  private
+    def broadcasts_for(leaf, user)
+      broadcasts(Leaves::BeingEditedChannel.broadcasting_for([ leaf, user ]))
+    end
 end
