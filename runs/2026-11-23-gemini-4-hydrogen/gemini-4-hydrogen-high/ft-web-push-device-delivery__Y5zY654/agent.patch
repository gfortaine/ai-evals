diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..4171a74
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,32 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+
+    if subscription.update(push_subscription_params)
+      render json: { id: subscription.id }, status: :created
+    else
+      render json: subscription.errors, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..f12e476
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,224 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "toggle", "details", "explainer" ]
+  static classes = [ "on" ]
+  static values = {
+    subscriptionsUrl: String,
+    vapidPublicKey: String,
+    subscriptions: { type: Object, default: {} }
+  }
+
+  async connect() {
+    if (!this.#supported) {
+      this.#setOn(false)
+      this.toggleTarget.disabled = true
+      this.#showInstallOnly()
+      return
+    }
+
+    if (!this.vapidPublicKeyValue) {
+      this.#setOn(false)
+      this.toggleTarget.disabled = true
+      this.#hideDetails()
+      return
+    }
+
+    await this.#refresh()
+    this.#watchPermissionChanges()
+  }
+
+  disconnect() {
+    if (this.permissionStatus && this.onPermissionChange) {
+      this.permissionStatus.removeEventListener("change", this.onPermissionChange)
+    }
+  }
+
+  async toggle() {
+    this.toggleTarget.disabled = true
+
+    try {
+      if (this.toggleTarget.checked) {
+        await this.#enable()
+      } else {
+        await this.#disable()
+      }
+    } finally {
+      this.toggleTarget.disabled = false
+    }
+  }
+
+  async #enable() {
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") {
+      this.#setOn(false)
+      if (permission === "denied") this.#showDetails()
+      return
+    }
+
+    try {
+      const registration = await this.#serviceWorkerRegistration()
+      const subscription = await this.#subscribe(registration)
+      const { endpoint, p256dh_key, auth_key } = this.#serializeSubscription(subscription)
+
+      const response = await post(this.subscriptionsUrlValue, {
+        body: { push_subscription: { endpoint, p256dh_key, auth_key } },
+        responseKind: "json"
+      })
+
+      if (response.ok) {
+        const data = await response.json
+        this.subscriptionsValue = { ...this.subscriptionsValue, [endpoint]: data.id }
+        this.#setOn(true)
+        this.#hideDetails()
+      } else {
+        this.#setOn(false)
+      }
+    } catch (error) {
+      this.#setOn(false)
+      if (Notification.permission === "denied" || error.name === "NotAllowedError") {
+        this.#showDetails()
+      }
+    }
+  }
+
+  async #disable() {
+    const registration = await this.#serviceWorkerRegistration()
+    const subscription = await registration?.pushManager.getSubscription()
+
+    if (subscription) {
+      const id = this.subscriptionsValue[subscription.endpoint]
+      if (id) {
+        await destroy(`${this.subscriptionsUrlValue}/${id}`)
+        const updated = { ...this.subscriptionsValue }
+        delete updated[subscription.endpoint]
+        this.subscriptionsValue = updated
+      }
+
+      await subscription.unsubscribe()
+    }
+
+    this.#setOn(false)
+    this.#hideDetails()
+  }
+
+  async #refresh() {
+    if (Notification.permission === "denied") {
+      this.#setOn(false)
+      this.#showDetails()
+      return
+    }
+
+    const registration = await this.#serviceWorkerRegistration()
+    const subscription = await registration?.pushManager.getSubscription()
+
+    if (Notification.permission === "granted" && subscription && this.#isSubscribedOnServer(subscription)) {
+      this.#setOn(true)
+      this.#hideDetails()
+    } else {
+      this.#setOn(false)
+      this.#hideDetails()
+    }
+  }
+
+  async #watchPermissionChanges() {
+    try {
+      this.permissionStatus = await navigator.permissions?.query({ name: "notifications" })
+      if (this.permissionStatus) {
+        this.onPermissionChange = () => this.#refresh()
+        this.permissionStatus.addEventListener("change", this.onPermissionChange)
+      }
+    } catch {
+      // Some browsers don't support querying notification permissions
+    }
+  }
+
+  async #serviceWorkerRegistration() {
+    const existing = await navigator.serviceWorker.getRegistration()
+    if (!existing) {
+      await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    }
+    return await navigator.serviceWorker.ready
+  }
+
+  async #subscribe(registration) {
+    const applicationServerKey = this.#urlBase64ToUint8Array(this.vapidPublicKeyValue)
+    const existing = await registration.pushManager.getSubscription()
+
+    if (existing) {
+      if (this.#keysMatch(existing.options?.applicationServerKey, applicationServerKey)) {
+        return existing
+      }
+      await existing.unsubscribe()
+    }
+
+    return await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey
+    })
+  }
+
+  #keysMatch(existingKey, applicationServerKey) {
+    if (!existingKey) return true
+
+    const existingBytes = new Uint8Array(existingKey)
+    if (existingBytes.length !== applicationServerKey.length) return false
+
+    return existingBytes.every((byte, index) => byte === applicationServerKey[index])
+  }
+
+  #serializeSubscription(subscription) {
+    const json = subscription.toJSON()
+    const endpoint = json.endpoint || subscription.endpoint
+    const p256dh_key = json.keys?.p256dh || this.#encodeKey(subscription.getKey("p256dh"))
+    const auth_key = json.keys?.auth || this.#encodeKey(subscription.getKey("auth"))
+
+    return { endpoint, p256dh_key, auth_key }
+  }
+
+  #isSubscribedOnServer(subscription) {
+    return Object.hasOwn(this.subscriptionsValue, subscription.endpoint)
+  }
+
+  #setOn(enabled) {
+    this.toggleTarget.checked = enabled
+    this.element.classList.toggle(this.onClass, enabled)
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach((detail) => detail.hidden = false)
+    if (this.hasExplainerTarget) this.explainerTarget.hidden = false
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach((detail) => detail.hidden = true)
+    if (this.hasExplainerTarget) this.explainerTarget.hidden = true
+  }
+
+  #showInstallOnly() {
+    this.detailsTargets.forEach((detail) => detail.hidden = true)
+    if (this.hasExplainerTarget) {
+      this.explainerTarget.hidden = !this.explainerTarget.querySelector(".pwa__instructions")
+    }
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    return Uint8Array.from(rawData, (char) => char.charCodeAt(0))
+  }
+
+  #encodeKey(key) {
+    if (!key) return ""
+    return btoa(String.fromCharCode(...new Uint8Array(key)))
+      .replace(/\+/g, "-")
+      .replace(/\//g, "_")
+      .replace(/=+$/, "")
+  }
+
+  get #supported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+}
diff --git a/app/jobs/notification/push_job.rb b/app/jobs/notification/push_job.rb
