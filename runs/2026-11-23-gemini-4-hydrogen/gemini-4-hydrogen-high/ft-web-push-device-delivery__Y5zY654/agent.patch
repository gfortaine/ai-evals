diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..873cb76
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create registers a push subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/123",
+          p256dh_key: "p256dh-value",
+          auth_key: "auth-value"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal subscription.id, response.parsed_body["id"]
+    assert_equal "https://push.example.com/sub/123", subscription.endpoint
+    assert_equal "p256dh-value", subscription.p256dh_key
+    assert_equal "auth-value", subscription.auth_key
+  end
+
+  test "create updates existing subscription for the same endpoint" do
+    existing = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/123",
+      p256dh_key: "old-p256dh",
+      auth_key: "old-auth"
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/123",
+          p256dh_key: "new-p256dh",
+          auth_key: "new-auth"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    existing.reload
+    assert_equal existing.id, response.parsed_body["id"]
+    assert_equal "new-p256dh", existing.p256dh_key
+    assert_equal "new-auth", existing.auth_key
+  end
+
+  test "create with invalid params returns unprocessable entity" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "",
+          p256dh_key: "p256dh-value",
+          auth_key: "auth-value"
+        }
+      }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create for another user is forbidden" do
+    other_user = users(:kevin)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(other_user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/123",
+          p256dh_key: "p256dh-value",
+          auth_key: "auth-value"
+        }
+      }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy removes the push subscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/123",
+      p256dh_key: "p256dh-value",
+      auth_key: "auth-value"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy for another user is forbidden" do
+    other_user = users(:kevin)
+    subscription = other_user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/123",
+      p256dh_key: "p256dh-value",
+      auth_key: "auth-value"
+    )
+
+    assert_no_difference -> { Push::Subscription.count } do
+      delete user_push_subscription_path(other_user, subscription), as: :json
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/notification/pushing_test.rb b/test/models/notification/pushing_test.rb
new file mode 100644
index 0000000..a8a2f56
--- /dev/null
+++ b/test/models/notification/pushing_test.rb
@@ -0,0 +1,226 @@
+require "test_helper"
+
+class Notification::PushingTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @david = users(:david)
+    @vapid_key = WebPush.generate_key
+    @subscription = @kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/v1/kevin-phone",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "creating a notification for a user with push subscriptions enqueues Notification::PushJob" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    end
+  end
+
+  test "creating a notification for a user without push subscriptions does not enqueue Notification::PushJob" do
+    notifications(:logo_mentioned_david).destroy
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @david, source: events(:layout_commented), creator: @kevin)
+    end
+  end
+
+  test "updating a notification source enqueues Notification::PushJob" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_with(job: Notification::PushJob, args: [ notification ]) do
+      notification.update!(source: events(:logo_published), read_at: nil, unread_count: notification.unread_count + 1)
+    end
+  end
+
+  test "marking a notification as read or unread does not enqueue Notification::PushJob" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "pushes card event with tray title, body, and card URL" do
+    notifications(:logo_assignment_kevin).destroy
+    boards(:writebook).access_for(@kevin).watching!
+
+    delivered_payloads = []
+    WebPush.stubs(:payload_send).with do |args|
+      delivered_payloads << JSON.parse(args[:message])
+      true
+    end
+
+    with_env("VAPID_PUBLIC_KEY" => @vapid_key.public_key, "VAPID_PRIVATE_KEY" => @vapid_key.private_key) do
+      perform_enqueued_jobs do
+        Notification.create!(user: @kevin, source: events(:logo_published), creator: @david)
+      end
+    end
+
+    assert_equal 1, delivered_payloads.size
+    payload = delivered_payloads.first
+    card = cards(:logo)
+    assert_equal card.title, payload["title"]
+    assert_equal "Added by David", payload.dig("options", "body")
+    assert_equal "#{card.account.slug}/cards/#{card.number}", payload.dig("options", "data", "url")
+  end
+
+  test "pushes comment event with RE title, comment body, and card comment URL" do
+    notifications(:layout_commented_kevin).destroy
+
+    delivered_payloads = []
+    WebPush.stubs(:payload_send).with do |args|
+      delivered_payloads << JSON.parse(args[:message])
+      true
+    end
+
+    with_env("VAPID_PUBLIC_KEY" => @vapid_key.public_key, "VAPID_PRIVATE_KEY" => @vapid_key.private_key) do
+      perform_enqueued_jobs do
+        Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+      end
+    end
+
+    assert_equal 1, delivered_payloads.size
+    payload = delivered_payloads.first
+    comment = events(:layout_commented).eventable
+    assert_equal "RE: #{comment.card.title}", payload["title"]
+    assert_equal comment.body.to_plain_text.truncate(200), payload.dig("options", "body")
+    assert_equal "#{comment.account.slug}/cards/#{comment.card.number}#comment_#{comment.id}", payload.dig("options", "data", "url")
+  end
+
+  test "pushes mention with mentioner title, content body, and card URL" do
+    mention = mentions(:logo_card_david_mention_by_jz)
+    @david.push_subscriptions.create!(
+      endpoint: "https://push.example.com/v1/david-desktop",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+    notifications(:logo_mentioned_david).destroy
+
+    delivered_payloads = []
+    WebPush.stubs(:payload_send).with do |args|
+      delivered_payloads << JSON.parse(args[:message])
+      true
+    end
+
+    with_env("VAPID_PUBLIC_KEY" => @vapid_key.public_key, "VAPID_PRIVATE_KEY" => @vapid_key.private_key) do
+      perform_enqueued_jobs do
+        Notification.create!(user: @david, source: mention, creator: @david)
+      end
+    end
+
+    assert_equal 1, delivered_payloads.size
+    payload = delivered_payloads.first
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", payload["title"]
+    assert_equal mention.source.mentionable_content.truncate(200), payload.dig("options", "body")
+    assert_equal "#{mention.account.slug}/cards/#{mention.card.number}", payload.dig("options", "data", "url")
+  end
+
+  test "pushes to multiple devices for the same user" do
+    @kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/v1/kevin-desktop",
+      p256dh_key: "p256dh-key-2",
+      auth_key: "auth-key-2"
+    )
+    notifications(:layout_commented_kevin).destroy
+
+    endpoints = []
+    WebPush.stubs(:payload_send).with do |args|
+      endpoints << args[:endpoint]
+      true
+    end
+
+    with_env("VAPID_PUBLIC_KEY" => @vapid_key.public_key, "VAPID_PRIVATE_KEY" => @vapid_key.private_key) do
+      perform_enqueued_jobs do
+        Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+      end
+    end
+
+    assert_equal 2, endpoints.size
+    assert_includes endpoints, "https://push.example.com/v1/kevin-phone"
+    assert_includes endpoints, "https://push.example.com/v1/kevin-desktop"
+  end
+
+  test "does not call WebPush when VAPID keys are not configured" do
+    notifications(:layout_commented_kevin).destroy
+    WebPush.expects(:payload_send).never
+
+    with_env("VAPID_PUBLIC_KEY" => nil, "VAPID_PRIVATE_KEY" => nil) do
+      perform_enqueued_jobs do
+        Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+      end
+    end
+  end
+
+  test "does not push to deactivated users" do
+    notifications(:layout_commented_kevin).destroy
+    @kevin.deactivate
+
+    assert @kevin.push_subscriptions.empty?
+
+    WebPush.expects(:payload_send).never
+    with_env("VAPID_PUBLIC_KEY" => @vapid_key.public_key, "VAPID_PRIVATE_KEY" => @vapid_key.private_key) do
+      perform_enqueued_jobs do
+        Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+      end
+    end
+  end
+
+
+test "re-notifying a previously read notification via Notifier pushes again" do
+  notification = notifications(:logo_assignment_kevin)
+  notification.read
+  comment = cards(:logo).comments.create!(body: "New reply on logo", creator: @david)
+
+  delivered_payloads = []
+  WebPush.stubs(:payload_send).with do |args|
+    delivered_payloads << JSON.parse(args[:message])
+    true
+  end
+
+  with_env("VAPID_PUBLIC_KEY" => @vapid_key.public_key, "VAPID_PRIVATE_KEY" => @vapid_key.private_key) do
+    perform_enqueued_jobs do
+      Notifier.for(comment.events.last).notify
+    end
+  end
+
+  assert_equal 1, delivered_payloads.size
+  payload = delivered_payloads.first
+  assert_equal "RE: #{cards(:logo).title}", payload["title"]
+  assert_equal "New reply on logo", payload.dig("options", "body")
+  assert_equal "#{cards(:logo).account.slug}/cards/#{cards(:logo).number}#comment_#{comment.id}", payload.dig("options", "data", "url")
+end
+
+test "creating a comment on a watched card pushes to watchers" do
+  cards(:layout).watch_by(@kevin)
+  notifications(:layout_commented_kevin).destroy
+
+  delivered_payloads = []
+  WebPush.stubs(:payload_send).with do |args|
+    delivered_payloads << JSON.parse(args[:message])
+    true
+  end
+
+  with_env("VAPID_PUBLIC_KEY" => @vapid_key.public_key, "VAPID_PRIVATE_KEY" => @vapid_key.private_key) do
+    perform_enqueued_jobs do
+      cards(:layout).comments.create!(body: "Checking push delivery", creator: @david)
+    end
+  end
+
+  assert_equal 1, delivered_payloads.size
+  assert_equal "Checking push delivery", delivered_payloads.first.dig("options", "body")
+end
+
+  private
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
