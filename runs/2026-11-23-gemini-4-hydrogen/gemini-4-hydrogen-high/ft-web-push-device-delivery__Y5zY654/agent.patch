@@ -0,0 +1,99 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:david)
+    @vapid_key = WebPush.generate_key
+    @old_public = ENV["VAPID_PUBLIC_KEY"]
+    @old_private = ENV["VAPID_PRIVATE_KEY"]
+    ENV["VAPID_PUBLIC_KEY"] = @vapid_key.public_key
+    ENV["VAPID_PRIVATE_KEY"] = @vapid_key.private_key
+  end
+
+  teardown do
+    ENV["VAPID_PUBLIC_KEY"] = @old_public
+    ENV["VAPID_PRIVATE_KEY"] = @old_private
+  end
+
+  test "shows blocked help when browser denies notifications" do
+    sign_in_as(@user)
+    visit notifications_settings_url
+
+    assert_selector ".notifications__off-message", visible: true
+    assert_no_selector "[data-notifications-target='details']", visible: true
+
+    find(".switch__btn").click
+
+    assert_selector "[data-notifications-target='details']", visible: true
+    assert_selector ".notifications__off-message", visible: true
+  end
+
+  test "toggles push notifications on and off for the current device" do
+    sign_in_as(@user)
+    visit notifications_settings_url
+
+    assert_selector "[data-notifications-target='toggle']:not([disabled])", visible: :all
+
+    # Mock browser PushManager & Notification permission APIs in headless Chrome
+    page.execute_script(<<~JS)
+      let currentSubscription = null
+      const encoder = new TextEncoder()
+      const fakeSubscription = {
+        endpoint: "https://push.example.com/system-test-device",
+        options: null,
+        toJSON() {
+          return {
+            endpoint: this.endpoint,
+            keys: { p256dh: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM", auth: "tBHItJI5svbpez7KI4CCXg" }
+          }
+        },
+        async unsubscribe() {
+          currentSubscription = null
+          return true
+        }
+      }
+
+      Object.defineProperty(window, "Notification", {
+        configurable: true,
+        value: {
+          permission: "default",
+          async requestPermission() {
+            this.permission = "granted"
+            return "granted"
+          }
+        }
+      })
+
+      Object.defineProperty(navigator, "serviceWorker", {
+        configurable: true,
+        value: {
+          async getRegistration() { return this.ready },
+          async register() { return this.ready },
+          ready: Promise.resolve({
+            pushManager: {
+              async getSubscription() { return currentSubscription },
+              async subscribe() {
+                currentSubscription = fakeSubscription
+                return fakeSubscription
+              }
+            }
+          })
+        }
+      })
+    JS
+
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      find(".switch__btn").click
+      assert_selector ".notifications--on .notifications__on-message", visible: true
+    end
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/system-test-device", subscription.endpoint
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      find(".switch__btn").click
+      assert_selector ".notifications__off-message", visible: true
+      assert_no_selector ".notifications--on"
+    end
+  end
+end
