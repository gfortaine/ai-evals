+module Push
+  def self.table_name_prefix
+    "push_"
+  end
+
+  def self.vapid_public_key
+    ENV["VAPID_PUBLIC_KEY"].presence || Rails.application.credentials.dig(:vapid, :public_key)
+  end
+
+  def self.vapid_private_key
+    ENV["VAPID_PRIVATE_KEY"].presence || Rails.application.credentials.dig(:vapid, :private_key)
+  end
+
+  def self.vapid_configured?
+    vapid_public_key.present? && vapid_private_key.present?
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..9f1b284
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,37 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  def notification(title:, body:, url:, badge: nil)
+    payload = {
+      title: title,
+      options: {
+        body: body,
+        icon: "/app-icon-192.png",
+        data: { url: url }
+      }
+    }
+    payload[:badge] = badge if badge
+
+    WebPush.payload_send(
+      message: payload.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid_options
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def vapid_options
+      {
+        subject: ENV.fetch("VAPID_SUBJECT", "mailto:support@fizzy.do"),
+        public_key: Push.vapid_public_key,
+        private_key: Push.vapid_private_key
+      }
+    end
+end
