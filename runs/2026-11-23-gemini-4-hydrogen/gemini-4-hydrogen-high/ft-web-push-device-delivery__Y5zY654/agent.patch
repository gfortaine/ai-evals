+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/v1/abc123",
+      p256dh_key: "p256dh-test-key",
+      auth_key: "auth-test-key"
+    )
+    @vapid_key = WebPush.generate_key
+  end
+
+  test "validates required attributes" do
+    subscription = Push::Subscription.new(user: @user)
+
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "can't be blank"
+    assert_includes subscription.errors[:p256dh_key], "can't be blank"
+    assert_includes subscription.errors[:auth_key], "can't be blank"
+  end
+
+  test "account defaults to user's account" do
+    assert_equal @user.account, @subscription.account
+  end
+
+  test "notification sends payload with WebPush using configured VAPID keys" do
+    delivered = nil
+    WebPush.stubs(:payload_send).with do |args|
+      delivered = args
+      true
+    end
+
+    with_env("VAPID_PUBLIC_KEY" => @vapid_key.public_key, "VAPID_PRIVATE_KEY" => @vapid_key.private_key) do
+      @subscription.notification(
+        title: "RE: Layout is broken",
+        body: "I fixed the CSS",
+        url: "/897362094/cards/2#comment_123",
+        badge: 3
+      )
+    end
+
+    assert_not_nil delivered
+    assert_equal @subscription.endpoint, delivered[:endpoint]
+    assert_equal @subscription.p256dh_key, delivered[:p256dh]
+    assert_equal @subscription.auth_key, delivered[:auth]
+    assert_equal @vapid_key.public_key, delivered[:vapid][:public_key]
+    assert_equal @vapid_key.private_key, delivered[:vapid][:private_key]
+
+    payload = JSON.parse(delivered[:message])
+    assert_equal "RE: Layout is broken", payload["title"]
+    assert_equal "I fixed the CSS", payload.dig("options", "body")
+    assert_equal "/897362094/cards/2#comment_123", payload.dig("options", "data", "url")
+    assert_equal 3, payload["badge"]
+  end
+
+  test "destroys subscription on WebPush::ExpiredSubscription" do
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(stub(body: "Gone"), "push.example.com"))
+
+    with_env("VAPID_PUBLIC_KEY" => @vapid_key.public_key, "VAPID_PRIVATE_KEY" => @vapid_key.private_key) do
+      assert_difference -> { Push::Subscription.count }, -1 do
+        @subscription.notification(title: "Test", body: "Body", url: "/test")
+      end
+    end
+  end
+
+  test "destroys subscription on WebPush::InvalidSubscription" do
+    WebPush.stubs(:payload_send).raises(WebPush::InvalidSubscription.new(stub(body: "Not Found"), "push.example.com"))
+
+    with_env("VAPID_PUBLIC_KEY" => @vapid_key.public_key, "VAPID_PRIVATE_KEY" => @vapid_key.private_key) do
+      assert_difference -> { Push::Subscription.count }, -1 do
+        @subscription.notification(title: "Test", body: "Body", url: "/test")
+      end
+    end
+  end
+
+  test "does not destroy subscription on transient WebPush::PushServiceError" do
+    WebPush.stubs(:payload_send).raises(WebPush::PushServiceError.new(stub(body: "Unavailable"), "push.example.com"))
+
+    with_env("VAPID_PUBLIC_KEY" => @vapid_key.public_key, "VAPID_PRIVATE_KEY" => @vapid_key.private_key) do
+      assert_no_difference -> { Push::Subscription.count } do
+        assert_raises(WebPush::PushServiceError) do
+          @subscription.notification(title: "Test", body: "Body", url: "/test")
+        end
+      end
+    end
+  end
+
+  private
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
