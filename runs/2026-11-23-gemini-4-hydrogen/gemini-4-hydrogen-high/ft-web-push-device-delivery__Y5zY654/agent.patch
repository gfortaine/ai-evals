diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..756b892 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,40 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+self.addEventListener("push", (event) => {
+  if (!event.data) return
+
+  const { title, options, badge } = event.data.json()
+  event.waitUntil(showNotification(title, options, badge))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openURL(event.notification.data?.url))
+})
+
+async function showNotification(title, options, badge) {
+  await self.registration.showNotification(title, options)
+
+  if (badge && "setAppBadge" in self.navigator) {
+    await self.navigator.setAppBadge(badge)
+  }
+}
+
+async function openURL(url) {
+  if (!url) return
+
+  const targetURL = new URL(url, self.location.origin).href
+  const clientList = await clients.matchAll({ type: "window", includeUncontrolled: true })
+
+  for (const client of clientList) {
+    if (client.url === targetURL && "focus" in client) {
+      return client.focus()
+    }
+  }
+
+  if (clients.openWindow) {
+    return clients.openWindow(targetURL)
+  }
+}
