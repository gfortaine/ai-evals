@@ -30,4 +32,28 @@ class SessionsController < ApplicationController
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
     end
+
+    def safe_return_to
+      return_to = params[:return_to]
+      return unless return_to.is_a?(String) && return_to.valid_encoding?
+      return if return_to.match?(/[\x00-\x1F\x7F]/)
+
+      url = url_from(return_to)
+      return unless url
+
+      uri = URI.parse(url)
+      return unless uri.userinfo.nil?
+      return unless uri.scheme.nil? || %w[ http https ].include?(uri.scheme)
+      return if uri.host.present? && !allowed_return_to_port?(uri)
+
+      url
+    rescue ArgumentError, URI::Error
+      nil
+    end
+
+    def allowed_return_to_port?(uri)
+      uri.port.nil? || uri.port == request.port ||
+        (uri.scheme == "http" && uri.port == 80) ||
+        (uri.scheme == "https" && uri.port == 443)
+    end
 end
