+
+  test "filtering by mix of accessible and inaccessible board_ids returns only accessible activity" do
+    private_board = boards(:private)
+    Current.set(user: users(:kevin)) do
+      private_board.cards.create!(creator: users(:kevin), title: "Private Card", status: "published")
+    end
+
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id, private_board.id ] }
+    assert_response :success
+
+    assert @response.parsed_body.any?
