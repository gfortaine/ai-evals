diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..7b5b812 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,34 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def activity_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids || nested_particular("assignee_ids")) }
+    when "card_board_changed"
+      {
+        old_board: particular_string("old_board"),
+        new_board: particular_string("new_board")
+      }
+    when "card_title_changed"
+      {
+        old_title: particular_string("old_title"),
+        new_title: particular_string("new_title")
+      }
+    when "card_triaged"
+      { column: particular_string("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def particular_string(key)
+      (nested_particular(key) || particulars&.dig(key)).to_s
+    end
+
+    def nested_particular(key)
+      particulars&.dig("particulars", key)
+    end
 end
