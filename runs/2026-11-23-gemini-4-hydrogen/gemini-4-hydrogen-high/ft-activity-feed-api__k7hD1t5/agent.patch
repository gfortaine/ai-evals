+
+  test "ignores blank filter values" do
+    get activities_path(format: :json), params: { board_ids: [ "" ], creator_ids: "" }
+    assert_response :success
+
+    expected_ids = Event
+      .where(account: accounts("37s"), board: users(:kevin).boards, action: Event::ACTIVITY_ACTIONS)
+      .reverse_chronologically
+      .pluck(:id)
+
+    assert_equal expected_ids, @response.parsed_body.pluck("id")
+  end
+
+  test "paginates activities and preserves filters in Link header" do
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    20.times do |i|
+      board.events.create!(
+        creator: users(:kevin),
+        eventable: card,
+        action: "card_title_changed",
+        particulars: { "particulars" => { "old_title" => "Title #{i}", "new_title" => "Title #{i + 1}" } }
+      )
+    end
+
+    expected_ids = Event
+      .where(account: accounts("37s"), board: board, creator: users(:kevin), action: Event::ACTIVITY_ACTIONS)
+      .reverse_chronologically
+      .pluck(:id)
+
+    actual_ids = []
+    next_page = activities_path(format: :json, board_ids: [ board.id ], creator_ids: [ users(:kevin).id ])
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  private
+    def fetch_all_pages(path = activities_path(format: :json))
+      items = []
+      next_page = path
+
+      while next_page
+        get next_page, as: :json
+        assert_response :success
+        items.concat(@response.parsed_body)
+        next_page = next_page_from_link_header(@response.headers["Link"])
+      end
+
+      items
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
