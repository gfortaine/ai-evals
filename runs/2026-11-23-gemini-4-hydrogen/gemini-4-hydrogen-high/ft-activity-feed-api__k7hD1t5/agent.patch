+    end
+    private_event = private_board.events.last
+
+    get activities_path(format: :json), params: {
+      board_ids: [ private_board.id, boards(:writebook).id ],
+      creator_ids: [ users(:kevin).id ]
+    }
+    assert_response :success
+
+    expected_ids = Event
+      .where(account: accounts("37s"), board: [ private_board, boards(:writebook) ], creator: users(:kevin), action: Event::ACTIVITY_ACTIONS)
