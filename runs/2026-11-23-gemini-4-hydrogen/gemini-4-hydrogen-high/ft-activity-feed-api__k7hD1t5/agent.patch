@@ -0,0 +1,390 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns flat array newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    expected_ids = Event
+      .where(account: accounts("37s"), board: users(:kevin).boards, action: Event::ACTIVITY_ACTIONS)
+      .reverse_chronologically
+      .pluck(:id)
+
+    assert_equal expected_ids, @response.parsed_body.pluck("id")
+  end
+
+  test "index defaults to JSON and rejects HTML" do
+    get activities_path
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+  end
+
+  test "index works with bearer token authentication" do
+    sign_out
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert @response.parsed_body.any?
+  end
+
+  test "index requires authentication" do
+    sign_out
+
+    get activities_path(format: :json)
+
+    assert_response :redirect
+  end
+
+  test "index includes expected fields and existing API representations for card event" do
+    event = events(:logo_published)
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert_not_nil activity
+    assert_equal %w[ id action eventable_type created_at description particulars url eventable board creator ].sort, activity.keys.sort
+
+    assert_equal event.id, activity["id"]
+    assert_equal "card_published", activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(cards(:logo)), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal cards(:logo).number, activity.dig("eventable", "number")
+    assert_equal cards(:logo).title, activity.dig("eventable", "title")
+    assert_equal card_comments_url(cards(:logo)), activity.dig("eventable", "comments_url")
+
+    assert_equal event.board.id, activity.dig("board", "id")
+    assert_equal event.board.name, activity.dig("board", "name")
+    assert_equal board_url(event.board), activity.dig("board", "url")
+
+    assert_equal event.creator.id, activity.dig("creator", "id")
+    assert_equal event.creator.name, activity.dig("creator", "name")
+    assert_equal user_avatar_url(event.creator), activity.dig("creator", "avatar_url")
+  end
+
+  test "index includes comment event representation and comment anchor url" do
+    event = events(:layout_commented)
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert_not_nil activity
+
+    assert_equal "comment_created", activity["action"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), activity["url"]
+    assert_equal({}, activity["particulars"])
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal comment.body.to_plain_text, activity.dig("eventable", "body", "plain_text")
+    assert_equal comment.card_id, activity.dig("eventable", "card", "id")
+    assert_equal card_comment_url(comment.card, comment), activity.dig("eventable", "url")
+  end
+
+  test "omits card_collection_changed and includes card_title_changed" do
+    card = cards(:logo)
+    collection_event = boards(:writebook).events.create!(
+      creator: users(:david),
+      eventable: card,
+      action: "card_collection_changed",
+      particulars: { "particulars" => { "new_collection" => "New" } }
+    )
+    title_event = boards(:writebook).events.create!(
+      creator: users(:david),
+      eventable: card,
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old Title", "new_title" => "New Title" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    returned_ids = @response.parsed_body.pluck("id")
+    assert_not_includes returned_ids, collection_event.id
+    assert_includes returned_ids, title_event.id
+
+    title_activity = @response.parsed_body.find { |item| item["id"] == title_event.id }
+    assert_equal title_event.description_for(users(:kevin)).to_plain_text, title_activity["description"]
+    assert_equal card_url(card), title_activity["url"]
+  end
+
+  test "description uses plain text form for current user" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    kevin_assigned = @response.parsed_body.find { |item| item["id"] == events(:logo_assignment_km).id }
+    jz_assigned = @response.parsed_body.find { |item| item["id"] == events(:logo_assignment_jz).id }
+
+    assert_includes kevin_assigned["description"], "David will handle"
+    assert_includes jz_assigned["description"], "David assigned JZ to"
+    assert_no_match(/<span/, kevin_assigned["description"])
+  end
+
+  test "exposes particulars for assignment, board change, title change, triage, and defaults" do
+    card = cards(:logo)
+    board = boards(:writebook)
+
+    unassign_event = board.events.create!(
+      creator: users(:david),
+      eventable: card,
+      action: "card_unassigned",
+      particulars: { assignee_ids: [ users(:jz).id ] }
+    )
+    board_change_event = board.events.create!(
+      creator: users(:david),
+      eventable: card,
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Design", "new_board" => "Writebook" } }
+    )
+    missing_board_change_event = board.events.create!(
+      creator: users(:david),
+      eventable: card,
+      action: "card_board_changed",
+      particulars: {}
+    )
+    nil_particulars_title_event = board.events.create!(
+      creator: users(:david),
+      eventable: card,
+      action: "card_title_changed",
+      particulars: nil
+    )
+    title_change_event = board.events.create!(
+      creator: users(:david),
+      eventable: card,
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Before", "new_title" => "After" } }
+    )
+    missing_title_change_event = board.events.create!(
+      creator: users(:david),
+      eventable: card,
+      action: "card_title_changed",
+      particulars: {}
+    )
+    triage_event = board.events.create!(
+      creator: users(:david),
+      eventable: card,
+      action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In Progress" } }
+    )
+    missing_triage_event = board.events.create!(
+      creator: users(:david),
+      eventable: card,
+      action: "card_triaged",
+      particulars: {}
+    )
+    postponed_event = board.events.create!(
+      creator: users(:david),
+      eventable: card,
+      action: "card_postponed"
+    )
+    auto_postponed_event = board.events.create!(
+      creator: users(:system),
+      eventable: card,
+      action: "card_auto_postponed"
+    )
+    reopened_event = board.events.create!(
+      creator: users(:david),
+      eventable: card,
+      action: "card_reopened"
+    )
+
+    by_id = fetch_all_pages.index_by { |item| item["id"] }
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, by_id.dig(events(:logo_assignment_jz).id, "particulars"))
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, by_id.dig(unassign_event.id, "particulars"))
+    assert_equal({ "old_board" => "Design", "new_board" => "Writebook" }, by_id.dig(board_change_event.id, "particulars"))
+    assert_equal({ "old_board" => "", "new_board" => "" }, by_id.dig(missing_board_change_event.id, "particulars"))
+    assert_equal({ "old_title" => "", "new_title" => "" }, by_id.dig(nil_particulars_title_event.id, "particulars"))
+    assert_equal({ "old_title" => "Before", "new_title" => "After" }, by_id.dig(title_change_event.id, "particulars"))
+    assert_equal({ "old_title" => "", "new_title" => "" }, by_id.dig(missing_title_change_event.id, "particulars"))
+    assert_equal({ "column" => "In Progress" }, by_id.dig(triage_event.id, "particulars"))
+    assert_equal({ "column" => "" }, by_id.dig(missing_triage_event.id, "particulars"))
+    assert_equal({}, by_id.dig(postponed_event.id, "particulars"))
+    assert_equal({}, by_id.dig(auto_postponed_event.id, "particulars"))
+    assert_equal({}, by_id.dig(reopened_event.id, "particulars"))
+    assert_equal({}, by_id.dig(events(:shipping_closed).id, "particulars"))
+    assert_equal({}, by_id.dig(events(:buy_domain_sent_back_to_triage).id, "particulars"))
+  end
+
+  test "returns only activity the current user can access" do
+    private_board = boards(:private)
+    Current.set(user: users(:kevin)) do
+      private_board.cards.create!(creator: users(:kevin), title: "Secret Card", status: "published")
+    end
+    private_event = private_board.events.last
+
+    other_account_event = boards(:miltons_wish_list).events.create!(
+      account: accounts(:initech),
+      creator: users(:mike),
+      eventable: cards(:radio),
+      action: "card_published"
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_includes @response.parsed_body.pluck("id"), private_event.id
+    assert_not_includes @response.parsed_body.pluck("id"), other_account_event.id
+
+    logout_and_sign_in_as :david
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+    assert_not_includes @response.parsed_body.pluck("id"), other_account_event.id
+  end
+
+  test "filters by creator_ids" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |item| item.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "filters by board_ids" do
+    private_board = boards(:private)
+    Current.set(user: users(:kevin)) do
+      private_board.cards.create!(creator: users(:kevin), title: "Private Card", status: "published")
+    end
+    private_event = private_board.events.last
+
+    get activities_path(format: :json), params: { board_ids: [ private_board.id ] }
