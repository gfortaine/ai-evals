+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,47 @@
+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from activities
+      end
+    end
+  end
+
+  private
+    def activities
+      events = Event
+        .preloaded
+        .where(account: Current.account, board: boards, action: Event::ACTIVITY_ACTIONS)
+        .reverse_chronologically
+
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events
+    end
+
+    def boards
+      if board_ids.present?
+        Current.user.boards.where(id: board_ids)
+      else
+        Current.user.boards
+      end
+    end
+
+    def board_ids
+      @board_ids ||= array_param(:board_ids)
+    end
+
+    def creator_ids
+      @creator_ids ||= array_param(:creator_ids)
+    end
+
+    def array_param(key)
+      case value = params[key]
+      when Array
+        value.compact_blank
+      when String
+        value.present? ? [ value ] : []
+      else
+        []
+      end
+    end
+end
