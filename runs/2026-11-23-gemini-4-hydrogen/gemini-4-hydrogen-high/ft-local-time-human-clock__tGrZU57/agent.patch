+++ b/app/javascript/helpers/date_helpers.js
@@ -1,7 +1,103 @@
 import { getMetaContent } from "helpers/meta_helpers"
 
+const MS_PER_DAY = 1000 * 60 * 60 * 24
+
+const timeFormatter = new Intl.DateTimeFormat("en-US", { timeStyle: "short" })
+const shortDateFormatter = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" })
+const longDateFormatter = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" })
+const weekdayFormatter = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" })
+const weekdayWithYearFormatter = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" })
+const dateTimeFormatter = new Intl.DateTimeFormat("en-US", { dateStyle: "short", timeStyle: "short" })
+const fullDateTimeFormatter = new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeStyle: "short" })
+const relativeTimeFormatter = new Intl.RelativeTimeFormat("en-US", { numeric: "auto" })
+
+export function formatLocalTime(date, style = "time", now = new Date()) {
+  switch (style) {
+    case "time":
+      return normalizeSpaces(timeFormatter.format(date))
+    case "date":
+      return longDateFormatter.format(date)
+    case "shortdate":
+      return formatShortDate(date, now)
+    case "datetime":
+      return normalizeSpaces(dateTimeFormatter.format(date))
+    case "ago":
+      return formatAgo(date, now)
+    case "indays":
+      return formatInDays(date, now)
+    case "agoorweekday":
+      return formatAgoOrWeekday(date, now)
+    default:
+      return normalizeSpaces(timeFormatter.format(date))
+  }
+}
+
+export function formatFullDateTime(date) {
+  return normalizeSpaces(fullDateTimeFormatter.format(date))
+}
+
+export function formatShortDate(date, now = new Date()) {
+  if (date.getFullYear() === now.getFullYear()) {
+    return shortDateFormatter.format(date)
+  } else {
+    return longDateFormatter.format(date)
+  }
+}
+
+export function localDifferenceInDays(fromDate, toDate) {
+  return Math.round((localBeginningOfDay(toDate) - localBeginningOfDay(fromDate)) / MS_PER_DAY)
+}
+
+function localBeginningOfDay(date) {
+  return new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()))
+}
+
+function formatAgo(date, now) {
+  const daysAgo = localDifferenceInDays(date, now)
+
+  if (daysAgo === 0) {
+    return normalizeSpaces(timeFormatter.format(date))
+  } else if (daysAgo === 1) {
+    return relativeTimeFormatter.format(-1, "day")
+  } else if (daysAgo > 1 && daysAgo < 7) {
+    return relativeTimeFormatter.format(-daysAgo, "day")
+  } else if (daysAgo >= 7) {
+    return formatShortDate(date, now)
+  } else {
+    return relativeTimeFormatter.format(-daysAgo, "day")
+  }
+}
+
+function formatInDays(date, now) {
+  const daysUntil = localDifferenceInDays(now, date)
+
+  if (daysUntil <= 0) {
+    return relativeTimeFormatter.format(0, "day")
+  } else {
+    return relativeTimeFormatter.format(daysUntil, "day")
+  }
+}
+
+function formatAgoOrWeekday(date, now) {
+  const daysAgo = localDifferenceInDays(date, now)
+
+  if (daysAgo === 0) {
+    return relativeTimeFormatter.format(0, "day")
+  } else if (daysAgo === 1) {
+    return relativeTimeFormatter.format(-1, "day")
+  } else if (date.getFullYear() === now.getFullYear()) {
+    return weekdayFormatter.format(date)
+  } else {
+    return weekdayWithYearFormatter.format(date)
+  }
+}
+
+function normalizeSpaces(string) {
+  return string.replace(/\u202f/g, " ")
+}
+
 export function signedDifferenceInDays(fromDate, toDate) {
-  return Math.round((beginningOfDay(toDate) - beginningOfDay(fromDate)) / (1000 * 60 * 60 * 24))
+  return Math.round((beginningOfDay(toDate) - beginningOfDay(fromDate)) / MS_PER_DAY)
 }
 
 export function beginningOfDay(date) {
