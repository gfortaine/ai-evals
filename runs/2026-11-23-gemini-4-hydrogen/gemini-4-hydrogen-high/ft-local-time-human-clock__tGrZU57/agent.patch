diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..1a7f453
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,106 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatFullDateTime, formatLocalTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+const connectedControllers = new Set()
+let refreshTimer = null
+
+function startRefreshing() {
+  if (refreshTimer) return
+
+  refreshTimer = setInterval(refreshAll, REFRESH_INTERVAL)
+  document.addEventListener("visibilitychange", handleVisibilityChange)
+  document.addEventListener("turbo:before-morph-element", handleBeforeMorphElement)
+  document.addEventListener("turbo:morph", refreshAll)
+}
+
+function stopRefreshing() {
+  if (!refreshTimer) return
+
+  clearInterval(refreshTimer)
+  refreshTimer = null
+  document.removeEventListener("visibilitychange", handleVisibilityChange)
+  document.removeEventListener("turbo:before-morph-element", handleBeforeMorphElement)
+  document.removeEventListener("turbo:morph", refreshAll)
+}
+
+function handleVisibilityChange() {
+  if (document.visibilityState === "visible") {
+    refreshAll()
+  }
+}
+
+function handleBeforeMorphElement(event) {
+  const newElement = event.detail?.newElement
+  if (newElement?.dataset?.controller?.split(/\s+/).includes("local-time")) {
+    applyLocalTime(newElement)
+  }
+}
+
+function refreshAll() {
+  for (const controller of connectedControllers) {
+    controller.refresh()
+  }
+}
+
+function applyLocalTime(element) {
+  const rawDatetime = element.dataset.localTimeDatetimeValue || element.getAttribute("datetime")
+  if (!rawDatetime) return
+
+  const date = new Date(rawDatetime)
+  if (Number.isNaN(date.getTime())) return
+
+  const style = element.dataset.localTimeStyleValue || "time"
+  const formatted = formatLocalTime(date, style)
+  const targetAttribute = element.dataset.localTimeAttributeValue
+
+  if (targetAttribute) {
+    if (element.getAttribute(targetAttribute) !== formatted) {
+      element.setAttribute(targetAttribute, formatted)
+    }
+  } else {
+    if (element.textContent !== formatted) {
+      element.textContent = formatted
+    }
+    if (!element.hasAttribute("title") || element.dataset.localTimeTitled) {
+      const title = formatFullDateTime(date)
+      if (element.title !== title) {
+        element.title = title
+      }
+      element.dataset.localTimeTitled = "true"
+    }
+  }
+}
+
+export default class extends Controller {
+  static values = {
+    datetime: String,
+    style: { type: String, default: "time" },
+    attribute: String
+  }
+
+  connect() {
+    connectedControllers.add(this)
+    startRefreshing()
+    this.refresh()
+  }
+
+  disconnect() {
+    connectedControllers.delete(this)
+    if (connectedControllers.size === 0) {
+      stopRefreshing()
+    }
+  }
+
+  datetimeValueChanged() {
+    this.refresh()
+  }
+
+  styleValueChanged() {
+    this.refresh()
+  }
+
+  refresh() {
+    applyLocalTime(this.element)
+  }
+}
