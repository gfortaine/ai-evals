+class Admin::Accounts::OverriddenLimitsController < AdminController
+  before_action :set_account
+
+  def create
+    update_limits
+  end
+
+  def update
+    update_limits
+  end
+
+  def destroy
+    @account.reset_limits
+    redirect_to saas.admin_account_path(@account), notice: "Limits reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:account_id]) || Account.find_by!(external_account_id: params[:account_id])
+    end
+
+    def update_limits
+      @account.override_limits(**overridden_limit_params.to_h.symbolize_keys)
+      redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+    end
+
+    def overridden_limit_params
+      key = params.key?(:account_overridden_limit) ? :account_overridden_limit : :overridden_limit
+      params.require(key).permit(:card_count, :bytes_used)
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
