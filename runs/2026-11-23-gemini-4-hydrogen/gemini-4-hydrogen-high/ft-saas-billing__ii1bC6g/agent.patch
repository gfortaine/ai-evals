+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Blocked bearer API card" } },
+        headers: { "Authorization" => "Bearer #{token.token}" },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can create cards via JSON when under card limit" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 999)
+
+    assert_difference -> { Card.count }, +1 do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Allowed API card" } },
