+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <div class="flex justify-space-between align-center gap-half flex-wrap">
+      <%= form_with url: saas.admin_accounts_path, method: :get, class: "flex gap-half flex-item-grow" do |form| %>
+        <%= form.search_field :q, value: params[:q], placeholder: "Filter by name or ID…", class: "input" %>
+        <%= form.submit "Search", class: "btn" %>
+      <% end %>
+      <%= link_to "Stats", saas.admin_stats_path, class: "btn" %>
+    </div>
+
+    <ul class="margin-block-half flex flex-column gap-half list-style-none pad-none">
+      <% @accounts.each do |account| %>
+        <li class="flex align-center justify-space-between gap-half">
+          <div class="min-width overflow-ellipsis">
+            <strong><%= link_to account.name, saas.admin_account_path(account), class: "txt-link" %></strong>
+            <div class="txt-x-small txt-ink-medium">
+              #<%= account.external_account_id %>
+              • <%= account.plan.name %>
+              <% if account.comped? %>(Comped)<% end %>
+              <% if account.overridden_limit.present? %>(Overridden)<% end %>
+            </div>
+          </div>
+
+          <div class="txt-small txt-ink-medium" style="text-align: right">
+            <div><%= number_with_delimiter(account.card_count) %> cards</div>
+            <div><%= number_to_human_size(account.bytes_used) %></div>
+          </div>
+        </li>
+      <% end %>
+    </ul>
+  </div>
+</section>
diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..a4e5867
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,93 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to "Accounts", saas.admin_accounts_path, class: "btn" %>
+  </div>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Account</h2>
+      </header>
+      <div class="flex flex-column gap-quarter txt-small">
+        <div><strong>ID:</strong> #<%= @account.external_account_id %> (<%= @account.id %>)</div>
+        <div><strong>Owner:</strong> <%= @account.owner_name || "—" %> (<%= @account.owner_email || "—" %>)</div>
+        <div><strong>Status:</strong> <%= @account.active? ? "Active" : "Inactive" %></div>
+        <div><strong>Created:</strong> <%= @account.created_at.to_fs(:long) %></div>
+      </div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Plan &amp; Billing</h2>
+      </header>
+      <div class="flex flex-column gap-quarter txt-small">
+        <div>
+          <strong>Plan:</strong> <%= @account.plan.name %>
+          <% if @account.comped? %>
+            <span>(Comped)</span>
+          <% end %>
+        </div>
+        <% if @account.subscription.present? %>
+          <div><strong>Subscription status:</strong> <%= @account.subscription.status || "—" %></div>
+          <div><strong>Stripe customer:</strong> <%= @account.subscription.stripe_customer_id || "—" %></div>
+          <div><strong>Stripe subscription:</strong> <%= @account.subscription.stripe_subscription_id || "—" %></div>
+        <% end %>
+      </div>
+
+      <div class="flex gap-half">
+        <% if @account.comped? %>
+          <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn btn--negative" %>
+        <% else %>
+          <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn btn--link" %>
+        <% end %>
+      </div>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Usage &amp; Limits</h2>
+      </header>
+      <div class="flex flex-column gap-quarter txt-small">
+        <div>
+          <strong>Card count:</strong> <%= number_with_delimiter(@account.card_count) %>
+          <% if @account.overridden_limit&.card_count.present? %>
+            (actual: <%= number_with_delimiter(@account.cards_count) %>)
+          <% end %>
+          / <%= @account.card_limit.finite? ? number_with_delimiter(@account.card_limit) : "Unlimited" %>
+        </div>
+        <div>
+          <strong>Bytes used:</strong> <%= number_to_human_size(@account.bytes_used) %> (<%= number_with_delimiter(@account.bytes_used) %> bytes)
+          <% if @account.overridden_limit&.bytes_used.present? %>
+            (actual: <%= number_with_delimiter(@account.actual_bytes_used) %> bytes)
+          <% end %>
+          / <%= number_to_human_size(@account.storage_limit) %>
+        </div>
+      </div>
+
+      <%= form_with model: @overridden_limit, url: saas.admin_account_overridden_limit_path(@account), class: "flex flex-column gap" do |form| %>
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :card_count, "Card count", class: "txt-small font-weight-bold" %>
+          <%= form.number_field :card_count, min: 0, class: "input", placeholder: @account.cards_count %>
+        </div>
+
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :bytes_used, "Bytes used", class: "txt-small font-weight-bold" %>
+          <%= form.number_field :bytes_used, min: 0, class: "input", placeholder: @account.actual_bytes_used %>
+        </div>
+
+        <div class="flex gap-half">
+          <%= form.submit "Override", class: "btn btn--link" %>
+        </div>
+      <% end %>
+
+      <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account), method: :delete, class: "btn" %>
+    </section>
+  </div>
+</section>
