@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  test "admin can start checkout for Unlimited plan" do
+    sign_in_as :mike
+
+    with_env("STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited") do
+      checkout_session = stub(url: "https://checkout.stripe.com/pay/cs_test_123")
+      Stripe::Checkout::Session.expects(:create).with do |params|
+        params[:mode] == "subscription" &&
+          params[:line_items] == [ { price: "price_unlimited", quantity: 1 } ] &&
+          params[:client_reference_id] == accounts(:initech).id &&
+          params[:customer_email] == users(:mike).identity.email_address
+      end.returns(checkout_session)
+
+      post saas.account_subscription_path(script_name: accounts(:initech).slug),
+        params: { plan_key: Plan.unlimited.key }
+
+      assert_redirected_to "https://checkout.stripe.com/pay/cs_test_123"
+    end
+  end
+
+  test "admin can start checkout for Unlimited+ plan" do
+    sign_in_as :mike
+
+    with_env("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_unlimited_plus") do
+      checkout_session = stub(url: "https://checkout.stripe.com/pay/cs_test_456")
+      Stripe::Checkout::Session.expects(:create).with do |params|
+        params[:line_items] == [ { price: "price_unlimited_plus", quantity: 1 } ]
+      end.returns(checkout_session)
+
+      post saas.account_subscription_path(script_name: accounts(:initech).slug),
+        params: { plan_key: Plan.unlimited_plus.key }
+
+      assert_redirected_to "https://checkout.stripe.com/pay/cs_test_456"
+    end
+  end
+
+  test "non-admin cannot start checkout" do
+    sign_in_as :jz
+
+    post saas.account_subscription_path(script_name: accounts(:"37s").slug),
+      params: { plan_key: Plan.unlimited.key }
+
+    assert_response :forbidden
+  end
+
+  private
+    def with_env(vars)
+      previous = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      previous.each { |key, value| ENV[key] = value }
+    end
+end
