+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,26 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  def index
+    @accounts = Account.order(created_at: :desc).includes(:subscription, :billing_waiver, :overridden_limit)
+
+    if params[:q].present?
+      q = params[:q].strip
+      filtered = @accounts.where("name LIKE ?", "%#{Account.sanitize_sql_like(q)}%")
+      if q.match?(/\A\d+\z/)
+        filtered = filtered.or(@accounts.where(external_account_id: q.to_i))
+      end
+      @accounts = filtered
+    end
+  end
+
+  def show
+    @account = find_account
+    @overridden_limit = @account.overridden_limit || @account.build_overridden_limit
+  end
+
+  private
+    def find_account
+      Account.find_by(id: params[:id]) || Account.find_by!(external_account_id: params[:id])
+    end
+end
