@@ -0,0 +1,93 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "unauthenticated access is redirected" do
+    untenanted do
+      get saas.admin_accounts_path
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "non-staff cannot access admin accounts" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :forbidden
+
+      get saas.admin_account_path(accounts(:initech))
+      assert_response :forbidden
+
+      post saas.admin_account_billing_waiver_path(accounts(:initech))
+      assert_response :forbidden
+
+      post saas.admin_account_overridden_limit_path(accounts(:initech)),
+        params: { account_overridden_limit: { card_count: 10 } }
+      assert_response :forbidden
+    end
+  end
+
+  test "staff can list accounts with links to each account page" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      Account.find_each do |account|
+        assert_select "a[href=?]", saas.admin_account_path(account), text: account.name
+      end
+    end
+  end
+
+  test "staff can comp and uncomp an account" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      get saas.admin_account_path(account)
+      assert_response :success
+      assert_select "button", text: "Comp"
+
+      post saas.admin_account_billing_waiver_path(account)
+      assert_redirected_to saas.admin_account_path(account)
+      assert account.reload.comped?
+
+      follow_redirect!
+      assert_select "button", text: "Uncomp"
+
+      delete saas.admin_account_billing_waiver_path(account)
+      assert_redirected_to saas.admin_account_path(account)
+      assert_not account.reload.comped?
+    end
+  end
+
+  test "staff can override card count and bytes used and reset" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      get saas.admin_account_path(account)
+      assert_response :success
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[type=submit][value='Override']"
+      assert_select "button", text: "Reset"
+
+      post saas.admin_account_overridden_limit_path(account),
+        params: { account_overridden_limit: { card_count: 950, bytes_used: 2.gigabytes } }
+      assert_redirected_to saas.admin_account_path(account)
+
+      account.reload
+      assert_equal 950, account.card_count
+      assert_equal 2.gigabytes, account.bytes_used
+
+      delete saas.admin_account_overridden_limit_path(account)
+      assert_redirected_to saas.admin_account_path(account)
+
+      account.reload
+      assert_nil account.overridden_limit
+      assert_equal account.cards_count, account.card_count
+      assert_equal 0, account.bytes_used
+    end
+  end
+end
