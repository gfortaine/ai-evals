diff --git a/app/models/account/data_transfer/filter_record_set.rb b/app/models/account/data_transfer/filter_record_set.rb
new file mode 100644
index 0000000..a7472f4
--- /dev/null
+++ b/app/models/account/data_transfer/filter_record_set.rb
@@ -0,0 +1,88 @@
+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  JOIN_TABLES = {
+    "tag_ids" => { model: ::Filter.const_get(:HABTM_Tags), fk: "tag_id", target: "Tag" },
+    "board_ids" => { model: ::Filter.const_get(:HABTM_Boards), fk: "board_id", target: "Board" },
+    "assignee_ids" => { model: ::Filter.const_get(:HABTM_Assignees), fk: "assignee_id", target: "User" },
+    "creator_ids" => { model: ::Filter.const_get(:HABTM_Creators), fk: "creator_id", target: "User" },
+    "closer_ids" => { model: ::Filter.const_get(:HABTM_Closers), fk: "closer_id", target: "User" }
+  }.freeze
+
+  def initialize(account)
+    super(account: account, model: ::Filter)
+  end
+
+  def import(zip:, id_map:)
+    with_zip(zip) do
+      zip.glob("#{model_dir}/*.json").each do |path|
+        rows = parse_json(zip.read(path), path)
+        next if rows.empty?
+
+        join_rows = Hash.new { |h, k| h[k] = [] }
+        mapped_rows = rows.map do |row|
+          attrs = import_attributes(row, id_map)
+          collect_join_rows(row, attrs["id"], id_map, join_rows)
+          attrs
+        end
+
+        insert_records(mapped_rows)
+        insert_join_rows(join_rows)
+        recompute_digests(mapped_rows.map { |r| r["id"] })
+      end
+    end
+  end
+
+  private
+    def preload_batch(relation)
+      relation.includes(:tags, :boards, :assignees, :creators, :closers)
+    end
+
+    def serialize_record(record)
+      super.merge(
+        "tag_ids" => record.tag_ids,
+        "board_ids" => record.board_ids,
+        "assignee_ids" => record.assignee_ids,
+        "creator_ids" => record.creator_ids,
+        "closer_ids" => record.closer_ids
+      )
+    end
+
+    def import_attributes(row, id_map)
+      attrs = super
+      if attrs["fields"].is_a?(Hash)
+        fields = attrs["fields"].dup
+        if fields["card_ids"].is_a?(Array)
+          fields["card_ids"] = fields["card_ids"].map { |old_id| id_map.map("Card", old_id) }
+        end
+        if fields["column_ids"].is_a?(Array)
+          fields["column_ids"] = fields["column_ids"].map { |old_id| id_map.map("Column", old_id) }
+        end
+        attrs["fields"] = fields
+      end
+      attrs
+    end
+
+    def collect_join_rows(row, new_filter_id, id_map, join_rows)
+      JOIN_TABLES.each do |key, config|
+        Array(row[key]).each do |old_target_id|
+          join_rows[key] << {
+            "filter_id" => new_filter_id,
+            config[:fk] => id_map.map(config[:target], old_target_id)
+          }
+        end
+      end
+    end
+
+    def insert_join_rows(join_rows)
+      JOIN_TABLES.each do |key, config|
+        rows = join_rows[key]
+        config[:model].insert_all!(rows) if rows.any?
+      end
+    end
+
+    def recompute_digests(filter_ids)
+      ::Filter.where(id: filter_ids).includes(:tags, :boards, :assignees, :creators, :closers).find_each do |filter|
+        digest = ::Filter.digest_params(filter.as_params)
+        filter.update_column(:params_digest, digest)
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/id_map.rb b/app/models/account/data_transfer/id_map.rb
