 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    Current.account = @account
+  end
+
+  test "exports and imports rich text with blob attachments and user mentions using portable gids" do
+    card = cards(:logo)
+    user = users(:david)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    html = "<p>Hello #{ActionText::Attachment.from_attachable(user).to_html} check #{ActionText::Attachment.from_attachable(blob).to_html}</p>"
+    card.update!(description: html)
+
+    tempfile = Tempfile.new([ "rich_text_export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Manifest.new(@account).export(zip: writer)
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    rich_text_paths = reader.glob("action_text_rich_texts/*.json")
+    assert rich_text_paths.any?
+
+    exported_rows = rich_text_paths.flat_map { |p| JSON.parse(reader.read(p)) }
+    exported_card_rt = exported_rows.find { |r| r["record_type"] == "Card" && r["record_id"] == card.id }
+    assert_not_nil exported_card_rt
+    assert_includes exported_card_rt["body"], "gid://fizzy/User/#{user.id}"
+    assert_includes exported_card_rt["body"], "gid://fizzy/ActiveStorage::Blob/#{blob.id}"
+
+    new_account = Account::DataTransfer::Manifest.import(zip: reader, identity: identities(:jason))
+    imported_card = new_account.cards.find_by!(number: card.number)
+    imported_user = new_account.users.find_by!(identity: user.identity)
+
+    attachables = imported_card.description.body.attachments.map(&:attachable)
+    assert_includes attachables, imported_user
+    imported_blob = attachables.find { |a| a.is_a?(ActiveStorage::Blob) }
+    assert_not_nil imported_blob
+    assert_not_equal blob.id, imported_blob.id
+    assert_equal new_account.id, imported_blob.account_id
+    assert_equal file_fixture("moon.jpg").binread, imported_blob.download
+  ensure
+    tempfile&.close!
+  end
 end
