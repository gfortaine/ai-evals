@@ -0,0 +1,259 @@
+require "test_helper"
+
+class Account::DataTransfer::ManifestTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    Current.account = @account
+  end
+
+  test "full account export and import roundtrip creates a new account with all data" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "cover.jpg", content_type: "image/jpeg")
+    users(:david).avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+
+    tempfile = Tempfile.new([ "account_export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Manifest.new(@account).export(zip: writer)
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    new_account = Account::DataTransfer::Manifest.import(zip: reader, identity: identities(:jason))
+
+    assert_not_equal @account.id, new_account.id
+    assert_not_equal @account.external_account_id, new_account.external_account_id
+    assert_equal @account.name, new_account.name
+    assert_equal @account.cards_count, new_account.cards_count
+
+    assert_equal @account.users.count, new_account.users.count
+    assert_equal @account.boards.count, new_account.boards.count
+    assert_equal @account.columns.count, new_account.columns.count
+    assert_equal @account.cards.count, new_account.cards.count
+    assert_equal @account.tags.count, new_account.tags.count
+    assert_equal Comment.where(account: @account).count, Comment.where(account: new_account).count
+    assert_equal Step.where(account: @account).count, Step.where(account: new_account).count
+    assert_equal Event.where(account: @account).count, Event.where(account: new_account).count
+
+    imported_card = new_account.cards.find_by!(number: card.number)
+    assert imported_card.image.attached?
+    assert_equal "cover.jpg", imported_card.image.filename.to_s
+    assert_equal file_fixture("moon.jpg").binread, imported_card.image.download
+
+    imported_david = new_account.users.find_by!(identity: identities(:david))
+    assert imported_david.avatar.attached?
+    assert_equal file_fixture("avatar.png").binread, imported_david.avatar.download
+
+    # Search works on imported account
+    results = Search::Record.for(new_account.id).search(card.title.split.first, user: imported_david)
+    assert results.any?
+  ensure
+    tempfile&.close!
+  end
+
+  test "export excludes internal Export attachments and blobs" do
+    export = Export.create!(type: "Account::Export", account: @account, user: users(:jason))
+    export.file.attach(io: StringIO.new("fake zip"), filename: "old.zip", content_type: "application/zip")
+
+    tempfile = Tempfile.new([ "account_export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Manifest.new(@account).export(zip: writer)
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    assert_not reader.exists?("files/#{export.file.blob_id}")
+  ensure
+    tempfile&.close!
+  end
+
+  test "import adds importing identity as owner if not present in exported users" do
+    tempfile = Tempfile.new([ "account_export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Manifest.new(@account).export(zip: writer)
+    writer.close
+    tempfile.rewind
+
+    outsider = Identity.create!(email_address: "outsider@example.com")
+    reader = ZipFile::Reader.new(tempfile)
+    new_account = Account::DataTransfer::Manifest.import(zip: reader, identity: outsider)
+
+    imported_user = new_account.users.find_by(identity: outsider)
+    assert_not_nil imported_user
+    assert imported_user.admin?
+  ensure
+    tempfile&.close!
+  end
+
+  test "failed import rolls back everything and leaves no blobs or files behind" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "cover.jpg", content_type: "image/jpeg")
+
+    tempfile = Tempfile.new([ "broken_export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Manifest.new(@account).export(zip: writer)
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    broken_tempfile = Tempfile.new([ "broken", ".zip" ])
+    broken_tempfile.binmode
+    broken_writer = ZipFile::Writer.new(broken_tempfile)
+    reader.glob("**/*").each do |entry_name|
+      next if entry_name == "files/#{card.image.blob.id}"
+      broken_writer.add_file(entry_name, reader.read(entry_name))
+    end
+    broken_writer.close
+    broken_tempfile.rewind
+
+    broken_reader = ZipFile::Reader.new(broken_tempfile)
+
+    with_tracked_uploads do |uploaded_keys|
+      assert_no_difference [ "Account.count", "User.count", "Board.count", "Card.count", "ActiveStorage::Blob.count", "ActiveStorage::Attachment.count" ] do
+        error = assert_raises(Account::DataTransfer::Error) do
+          Account::DataTransfer::Manifest.import(zip: broken_reader, identity: identities(:jason))
+        end
+        assert_match(/Missing file/, error.message)
+      end
+
+      assert uploaded_keys.none? { |key| ActiveStorage::Blob.service.exist?(key) }
+    end
+  ensure
+    tempfile&.close!
+    broken_tempfile&.close!
+  end
+
+  test "export and import preserves filters, board publications, webhooks, entropies, events, and variants" do
+    board = boards(:writebook)
+    board.publish
+    board.update!(auto_postpone_period: 7.days)
+    users(:david).avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+
+    Filter.create!(
+      creator: users(:david),
+      account: @account,
+      boards: [ board ],
+      assignees: [ users(:david) ],
+      tags: [ tags(:mobile) ],
+      fields: { card_ids: [ cards(:logo).id ] }
+    )
+
+    board.webhooks.create!(
+      name: "Test Hook",
+      url: "https://example.com/hook",
+      subscribed_actions: [ "card_published" ]
+    )
+
+    Event.create!(
+      account: @account,
+      board: board,
+      creator: users(:david),
+      eventable: cards(:logo),
+      action: "card_assigned",
+      particulars: { "assignee_ids" => [ users(:jason).id ] }
+    )
+
+    tempfile = Tempfile.new([ "full_export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Manifest.new(@account).export(zip: writer)
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    new_account = Account::DataTransfer::Manifest.import(zip: reader, identity: identities(:jason))
+
+    imported_board = new_account.boards.find_by!(name: board.name)
+    assert imported_board.published?
+    assert_not_equal board.publication.key, imported_board.publication.key
+    assert_equal 7.days.to_i, imported_board.auto_postpone_period
+
+    imported_david = new_account.users.find_by!(identity: identities(:david))
+    imported_jason = new_account.users.find_by!(identity: identities(:jason))
+    assert imported_david.avatar.variant(:thumb).processed?
+
+    imported_card = new_account.cards.find_by!(number: cards(:logo).number)
+    imported_filter = Filter.where(account: new_account, creator: imported_david).detect { |f| f.card_ids.present? }
+    assert_not_nil imported_filter
+    assert_equal [ imported_board.id ], imported_filter.board_ids
+    assert_equal [ imported_david.id ], imported_filter.assignee_ids
+    assert_equal [ imported_card.id ], imported_filter.card_ids
+
+    imported_webhook = new_account.webhooks.find_by!(name: "Test Hook")
+    assert_equal [ "card_published" ], imported_webhook.subscribed_actions
+    assert_not_nil imported_webhook.delinquency_tracker
+
+    imported_events = Event.where(account: new_account, action: "card_assigned", eventable: imported_card, creator: imported_david)
+    assert imported_events.any? { |e| e.assignee_ids == [ imported_jason.id ] }
+  ensure
+    tempfile&.close!
+  end
+
+  test "failed import due to checksum mismatch cleans up previously uploaded files and rolls back DB" do
+    card1 = cards(:logo)
+    card1.image.attach(io: file_fixture("moon.jpg").open, filename: "first.jpg", content_type: "image/jpeg")
+
+    card2 = cards(:text)
+    card2.image.attach(io: file_fixture("avatar.png").open, filename: "second.png", content_type: "image/png")
+
+    tempfile = Tempfile.new([ "export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Manifest.new(@account).export(zip: writer)
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    tampered_tempfile = Tempfile.new([ "tampered", ".zip" ])
+    tampered_tempfile.binmode
+    tampered_writer = ZipFile::Writer.new(tampered_tempfile)
+    reader.glob("**/*").each do |entry_name|
+      if entry_name == "files/#{card2.image.blob.id}"
+        tampered_writer.add_file(entry_name, "corrupted bytes", compress: false)
+      else
+        tampered_writer.add_file(entry_name, reader.read(entry_name))
+      end
+    end
+    tampered_writer.close
+    tampered_tempfile.rewind
+
+    tampered_reader = ZipFile::Reader.new(tampered_tempfile)
+
+    with_tracked_uploads do |uploaded_keys|
+      assert_no_difference [ "Account.count", "Card.count", "ActiveStorage::Blob.count" ] do
+        error = assert_raises(Account::DataTransfer::Error) do
+          Account::DataTransfer::Manifest.import(zip: tampered_reader, identity: identities(:jason))
+        end
+        assert_match(/integrity/, error.message)
+      end
+
+      assert_operator uploaded_keys.size, :>=, 1
+      assert uploaded_keys.none? { |key| ActiveStorage::Blob.service.exist?(key) }
+    end
+  ensure
+    tempfile&.close!
+    tampered_tempfile&.close!
+  end
+
+  private
+    def with_tracked_uploads
+      uploaded_keys = []
+      service = ActiveStorage::Blob.service
+      singleton = service.singleton_class
+      singleton.alias_method :__orig_upload_for_test, :upload
+      singleton.define_method(:upload) do |key, io, **opts|
+        uploaded_keys << key
+        __orig_upload_for_test(key, io, **opts)
+      end
+
+      yield uploaded_keys
+    ensure
+      if singleton&.method_defined?(:__orig_upload_for_test)
+        singleton.alias_method :upload, :__orig_upload_for_test
+        singleton.remove_method :__orig_upload_for_test
+      end
+    end
+end
