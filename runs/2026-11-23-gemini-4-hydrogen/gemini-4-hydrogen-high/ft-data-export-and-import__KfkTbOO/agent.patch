+class Account::Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  validates :file, presence: true, on: :create
+
+  def process_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def process_now
+    processing!
+
+    imported_account = ZipFile.open(file.blob) do |zip|
+      Account::DataTransfer::Manifest.import(zip: zip, identity: identity)
+    end
+
+    update!(account: imported_account, status: :completed, completed_at: Time.current)
+    file.purge_later
+    AccountMailer.import_completed(self).deliver_later
+  rescue ZipFile::InvalidZipError, Account::DataTransfer::Error => error
+    fail_with_reason(error.message)
+  rescue StandardError => error
+    Rails.error.report(error, severity: :error)
+    fail_with_reason("Something went wrong while importing your account: #{error.message}")
+  end
+
+  def accessible_to?(user)
+    false
+  end
+
+  private
+    def fail_with_reason(reason)
+      update!(account: nil, status: :failed, error_message: reason)
+      file.purge if file.attached?
+      AccountMailer.import_failed(self).deliver_later
+    end
+end
