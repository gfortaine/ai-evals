@@ -0,0 +1,37 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:jason)
+  end
+
+  test "expired? is false within 1 day and true after 1 day" do
+    export = Account::Export.create!(account: @account, user: @user, status: :completed, completed_at: Time.current)
+
+    assert_not export.expired?
+    assert export.accessible_to?(@user)
+
+    travel 23.hours do
+      assert_not export.expired?
+      assert export.accessible_to?(@user)
+    end
+
+    travel 25.hours do
+      assert export.expired?
+      assert_not export.accessible_to?(@user)
+    end
+  end
+
+  test "cleanup destroys expired exports" do
+    fresh = Account::Export.create!(account: @account, user: @user, status: :completed, completed_at: 12.hours.ago)
+    expired = Account::Export.create!(account: @account, user: @user, status: :completed, completed_at: 25.hours.ago)
+    stuck = Account::Export.create!(account: @account, user: @user, status: :processing, created_at: 3.days.ago)
+
+    Export.cleanup
+
+    assert Export.exists?(fresh.id)
+    assert_not Export.exists?(expired.id)
+    assert_not Export.exists?(stuck.id)
+  end
+end
diff --git a/test/models/user/data_export_test.rb b/test/models/user/data_export_test.rb
new file mode 100644
index 0000000..871e16a
--- /dev/null
+++ b/test/models/user/data_export_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+    Current.account = @account
+    Current.user = @user
+  end
+
+  test "build_now exports accessible cards as JSON with comments and attachments" do
+    accessible_board = boards(:writebook)
+    assert accessible_board.accessible_to?(@user)
+
+    private_board = @account.boards.create!(name: "Secret Board", creator: users(:jason), all_access: false)
+    secret_card = private_board.cards.create!(title: "Secret Card", status: :published, creator: users(:jason))
+
+    other_draft = accessible_board.cards.create!(title: "Jason Draft", status: :drafted, creator: users(:jason))
+    own_draft = accessible_board.cards.create!(title: "David Draft", status: :drafted, creator: @user)
+
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "cover.jpg", content_type: "image/jpeg")
+
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "diagram.png",
+      content_type: "image/png"
+    )
+    card.update!(description: "<p>See #{ActionText::Attachment.from_attachable(embed_blob).to_html}</p>")
+
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "comment_photo.jpg",
+      content_type: "image/jpeg"
+    )
+    comment = card.comments.create!(
+      creator: users(:jason),
+      body: "<p>Reply #{ActionText::Attachment.from_attachable(comment_blob).to_html}</p>"
+    )
+
+    export = @user.data_exports.create!(account: @account)
+
+    assert_enqueued_emails 1 do
+      export.build_now
+    end
+
+    assert export.reload.completed?
+    assert export.file.attached?
+
+    ZipFile.open(export.file) do |zip|
+      assert zip.exists?("cards/#{card.number}.json")
+      assert zip.exists?("cards/#{own_draft.number}.json")
+      assert_not zip.exists?("cards/#{secret_card.number}.json")
+      assert_not zip.exists?("cards/#{other_draft.number}.json")
+
+      parsed = JSON.parse(zip.read("cards/#{card.number}.json"))
+      assert_equal card.id, parsed["id"]
+      assert_equal card.title, parsed["title"]
+      assert_equal "cover.jpg", parsed.dig("image", "filename")
+      assert_equal [ "diagram.png" ], parsed["attachments"].map { |a| a["filename"] }
+
+      exported_comment = parsed["comments"].find { |c| c["id"] == comment.id }
+      assert_not_nil exported_comment
+      assert_equal [ "comment_photo.jpg" ], exported_comment["attachments"].map { |a| a["filename"] }
+
+      assert zip.exists?(parsed.dig("image", "path"))
+      assert zip.exists?(parsed["attachments"].first["path"])
+      assert zip.exists?(exported_comment["attachments"].first["path"])
+
+      assert_equal file_fixture("moon.jpg").binread, zip.read(parsed.dig("image", "path"))
+      assert_equal file_fixture("avatar.png").binread, zip.read(parsed["attachments"].first["path"])
+      assert_equal file_fixture("moon.jpg").binread, zip.read(exported_comment["attachments"].first["path"])
+    end
+  end
+end
