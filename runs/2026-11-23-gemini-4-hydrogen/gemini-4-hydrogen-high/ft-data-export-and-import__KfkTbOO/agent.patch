@@ -8,4 +8,68 @@ class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransf
       ::ActionText::RichText.where(account: account)
     end
 
+    def serialize_record(record)
+      super.merge("body" => export_body(record.body&.to_html))
+    end
+
+    def import_attributes(row, id_map)
+      attrs = super
+      attrs["body"] = import_body(attrs["body"], id_map)
+      attrs
+    end
+
+    def export_body(html)
+      return html if html.blank?
+
+      fragment = Nokogiri::HTML.fragment(html)
+      fragment.css("action-text-attachment[sgid]").each do |node|
+        attachable = resolve_signed_attachable(node["sgid"])
+        if attachable.is_a?(::ActiveStorage::Blob) || attachable.is_a?(::User)
+          node["sgid"] = attachable.to_gid.to_s
+        end
+      end
+      fragment.to_html
+    end
+
+    def import_body(html, id_map)
+      return html if html.blank?
+
+      fragment = Nokogiri::HTML.fragment(html)
+      fragment.css("action-text-attachment[sgid]").each do |node|
+        attachable = resolve_imported_attachable(node["sgid"], id_map)
+        next unless attachable
+
+        node["sgid"] = attachable.attachable_sgid
+        if attachable.is_a?(::ActiveStorage::Blob) && node["url"].present? && id_map.account
+          node["url"] = Rails.application.routes.url_helpers.polymorphic_url(
+            attachable,
+            only_path: true,
+            script_name: id_map.account.slug
+          )
+        end
+      end
+      fragment.to_html
+    end
+
+    def resolve_signed_attachable(sgid)
+      ::ActionText::Attachable.from_attachable_sgid(sgid)
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    def resolve_imported_attachable(sgid_or_gid, id_map)
+      if sgid_or_gid.start_with?("gid://")
+        gid = GlobalID.parse(sgid_or_gid)
+        return nil unless gid && gid.model_name.in?(%w[ActiveStorage::Blob User])
+
+        new_id = id_map.fetch(gid.model_name, gid.model_id)
+        gid.model_name.constantize.find_by(id: new_id) if new_id
+      else
+        attachable = resolve_signed_attachable(sgid_or_gid)
+        if attachable.is_a?(::ActiveStorage::Blob) || attachable.is_a?(::User)
+          new_id = id_map.fetch(attachable.class, attachable.id)
+          attachable.class.find_by(id: new_id) if new_id
+        end
+      end
+    end
 end
