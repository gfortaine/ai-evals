+require "test_helper"
+
+class Users::DataExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @member = users(:david)
+    sign_in_as @member
+  end
+
+  test "any user can export accessible cards from their profile page and download for 1 day" do
+    get user_path(@member)
+    assert_response :ok
+    assert_select "form[action='#{user_data_exports_path(@member)}']"
+
+    assert_difference -> { User::DataExport.count }, +1 do
+      assert_enqueued_with job: ExportJob do
+        post user_data_exports_path(@member)
+      end
+    end
+
+    assert_redirected_to user_path(@member)
+    export = User::DataExport.last
+
+    perform_enqueued_jobs do
+      export.build_now
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @member.identity.email_address ], email.to
+    assert_includes email.body.encoded, user_data_export_path(@member, export, script_name: @account.slug)
+
+    get user_data_export_path(@member, export)
+    assert_response :redirect
+    assert_match %r{rails/active_storage}, response.location
+    follow_redirect!
+    follow_redirect!
+    assert_response :ok
+    assert_equal "application/zip", response.media_type
+
+    travel 25.hours do
+      get user_data_export_path(@member, export)
+      assert_response :gone
+    end
+  end
+
+  test "user cannot export or download another user's cards export" do
+    other = users(:jason)
+    export = other.data_exports.create!(account: @account, status: :completed, completed_at: Time.current)
+    export.file.attach(io: StringIO.new("zip"), filename: "export.zip", content_type: "application/zip")
+
+    get user_path(other)
+    assert_response :ok
+    assert_select "form[action='#{user_data_exports_path(other)}']", count: 0
+
+    assert_no_difference -> { User::DataExport.count } do
+      post user_data_exports_path(other)
+    end
+    assert_response :forbidden
+
+    get user_data_export_path(other, export)
+    assert_response :forbidden
+  end
+end
