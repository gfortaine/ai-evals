+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <p class="margin-block-start-none">Upload a Fizzy account export (.zip) to create a new account with all of your boards, cards, comments, files, and people. We’ll email you when it’s done.</p>
+
+  <%= form_with model: @import, url: account_imports_path(script_name: nil), class: "flex flex-column gap", data: { turbo: false } do |form| %>
+    <%= form.file_field :file, required: true, accept: ".zip,application/zip", class: "input" %>
+
+    <% if @import.errors.any? %>
+      <div class="margin-block-half txt-negative txt-small" style="text-align: left;">
+        <ul class="margin-block-none">
+          <% @import.errors.full_messages.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <button type="submit" class="btn btn--link center">
+      <span>Import account</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
