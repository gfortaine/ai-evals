+class Export < ApplicationRecord
+  EXPIRATION_DURATION = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  scope :expired, -> { completed.where(completed_at: ...EXPIRATION_DURATION.ago).or(where(status: %w[ pending processing failed ], created_at: ...2.days.ago)) }
+  scope :current, -> { completed.where(completed_at: EXPIRATION_DURATION.ago..) }
+
+  class << self
+    def cleanup
+      expired.find_each(&:destroy!)
+    end
+  end
+
+  def build_later
+    ExportJob.perform_later(self)
+  end
+
+  def build_now
+    processing!
+
+    Current.with_account(account) do
+      ZipFile.create_for(file, filename: filename) do |zip|
+        populate(zip)
+      end
+    end
+
+    update!(status: :completed, completed_at: Time.current)
+    notify_ready
+  rescue StandardError => error
+    failed!
+    raise error
+  end
+
+  def expired?
+    completed_at.present? && completed_at < EXPIRATION_DURATION.ago
+  end
+
+  def accessible_to?(accessor)
+    return false if expired? || accessor.blank?
+
+    accessor == user
+  end
+
+  private
+    def populate(zip)
+      raise NotImplementedError
+    end
+
+    def notify_ready
+      raise NotImplementedError
+    end
+
+    def filename
+      "fizzy-export-#{id}.zip"
+    end
+end
