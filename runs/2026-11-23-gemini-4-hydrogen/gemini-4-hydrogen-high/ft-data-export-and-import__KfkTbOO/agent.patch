+class ZipFileS3Test < ActiveSupport::TestCase
+  test "ZipFile.open reads from S3Service via RemoteIO using HTTP Range requests" do
+    require "active_storage/service/s3_service"
+
+    tempfile = Tempfile.new([ "s3_test", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("accounts/000001.json", '[{"id":"1","name":"Test"}]')
+    writer.close
+    tempfile.rewind
+    zip_bytes = tempfile.read
+
+    s3_url = "https://s3.example.com/bucket/test-key"
+    blob = ActiveStorage::Blob.new(key: "test-key", filename: "test.zip", content_type: "application/zip", byte_size: zip_bytes.bytesize)
+    s3_service = ActiveStorage::Service::S3Service.allocate
+    blob.stubs(:service).returns(s3_service)
+    blob.stubs(:url).with(expires_in: 1.day).returns(s3_url)
+
+    stub_request(:get, s3_url).to_return do |request|
+      range_header = request.headers["Range"]
+      if range_header && range_header =~ /bytes=(\d+)-(\d+)/
+        start_pos = Regexp.last_match(1).to_i
+        end_pos = [ Regexp.last_match(2).to_i, zip_bytes.bytesize - 1 ].min
+        body = zip_bytes.byteslice(start_pos..end_pos)
+        {
+          status: 206,
+          headers: { "Content-Range" => "bytes #{start_pos}-#{end_pos}/#{zip_bytes.bytesize}" },
+          body: body
+        }
+      else
+        { status: 200, headers: { "Content-Length" => zip_bytes.bytesize.to_s }, body: zip_bytes }
+      end
+    end
+
+    ZipFile.open(blob) do |reader|
+      assert reader.exists?("accounts/000001.json")
+      assert_equal '[{"id":"1","name":"Test"}]', reader.read("accounts/000001.json")
+    end
+  ensure
+    tempfile&.close!
   end
 end
