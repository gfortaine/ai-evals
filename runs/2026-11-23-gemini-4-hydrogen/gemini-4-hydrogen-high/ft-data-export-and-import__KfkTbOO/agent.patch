--- /dev/null
+++ b/app/models/account/data_transfer/id_map.rb
@@ -0,0 +1,32 @@
+class Account::DataTransfer::IdMap
+  attr_accessor :account
+  attr_reader :blob_entries, :uploaded_keys
+
+  def initialize
+    @maps = Hash.new { |h, k| h[k] = {} }
+    @blob_entries = {}
+    @uploaded_keys = []
+  end
+
+  def map(model, old_id, new_id = nil)
+    return nil if old_id.nil?
+
+    key = model_key(model)
+    if new_id
+      @maps[key][old_id] = new_id
+    else
+      @maps[key][old_id] ||= ActiveRecord::Type::Uuid.generate
+    end
+  end
+
+  def fetch(model, old_id)
+    return nil if old_id.nil?
+
+    @maps[model_key(model)][old_id]
+  end
+
+  private
+    def model_key(model)
+      model.respond_to?(:base_class) ? model.base_class.name : model.to_s
+    end
+end
