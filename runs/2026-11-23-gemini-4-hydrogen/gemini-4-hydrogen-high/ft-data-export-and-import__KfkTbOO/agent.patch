diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..9cb9158
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,125 @@
+class ZipFile::Reader
+  class MissingEntryError < StandardError; end
+
+  class EntryIO
+    CHUNK_SIZE = 64.kilobytes
+
+    def initialize(io, entry)
+      @io = io
+      @entry = entry
+      rewind
+    end
+
+    def size
+      @entry.uncompressed_size
+    end
+
+    def binmode
+      self
+    end
+
+    def eof?
+      @buffer.empty? && @extractor.eof?
+    end
+
+    def rewind
+      @buffer = +"".b
+      @extractor = @entry.extractor_from(@io)
+      0
+    end
+
+    def read(length = nil, outbuf = nil)
+      if length.nil?
+        result = @buffer.dup
+        @buffer.clear
+        until @extractor.eof?
+          chunk = @extractor.extract(CHUNK_SIZE)
+          result << chunk if chunk
+        end
+        if outbuf
+          outbuf.replace(result)
+          outbuf
+        else
+          result
+        end
+      elsif length.zero?
+        outbuf ? outbuf.clear : +"".b
+      else
+        while @buffer.bytesize < length && !@extractor.eof?
+          chunk = @extractor.extract(CHUNK_SIZE)
+          @buffer << chunk if chunk
+        end
+
+        if @buffer.empty?
+          outbuf&.clear
+          nil
+        else
+          chunk = @buffer.byteslice(0, length)
+          @buffer = @buffer.byteslice(length..) || +"".b
+          if outbuf
+            outbuf.replace(chunk)
+            outbuf
+          else
+            chunk
+          end
+        end
+      end
+    end
+
+    def close
+      @buffer.clear
+    end
+  end
+
+  def initialize(io)
+    @io = io
+    @file_reader = ZipKit::FileReader.new
+    @entries_by_name = parse_entries
+  end
+
+  def glob(pattern)
+    @entries_by_name.keys.select { |entry_name| File.fnmatch(pattern, entry_name) }.sort
+  end
+
+  def exists?(path)
+    @entries_by_name.key?(path)
+  end
+
+  def read(path)
+    open(path, &:read)
+  end
+
+  def open(path)
+    entry = @entries_by_name.fetch(path) do
+      raise MissingEntryError, "Missing archive entry: #{path}"
+    end
+
+    unless entry.known_offset?
+      entry.compressed_data_offset = @file_reader.get_compressed_data_offset(
+        io: @io,
+        local_file_header_offset: entry.local_file_header_offset
+      )
+    end
+
+    entry_io = EntryIO.new(@io, entry)
+    if block_given?
+      begin
+        yield entry_io
+      ensure
+        entry_io.close
+      end
+    else
+      entry_io
+    end
+  end
+
+  private
+    def parse_entries
+      entries = @file_reader.read_zip_structure(io: @io, read_local_headers: false)
+      entries.index_by(&:filename)
+    rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD,
+           ZipKit::FileReader::UnsupportedFeature, ZipKit::FileReader::InvalidStructure,
+           EOFError => error
+      raise ZipFile::InvalidZipError, error.message
+    end
+end
