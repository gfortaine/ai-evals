+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts("37s")
+    Current.account = @account
+    @identity = identities(:jason)
+  end
+
+  test "process_now imports account and sends completion email" do
+    export = @account.exports.create!(user: users(:jason))
+    perform_enqueued_jobs { export.build_now }
+
+    zip_tempfile = Tempfile.new([ "import_source", ".zip" ])
+    zip_tempfile.binmode
+    zip_tempfile.write(export.file.download)
+    zip_tempfile.rewind
+
+    import = @identity.account_imports.create!(
+      file: { io: zip_tempfile, filename: "export.zip", content_type: "application/zip" }
+    )
+
+    assert_difference -> { Account.count }, +1 do
+      assert_enqueued_emails 1 do
+        import.process_now
+      end
+    end
+
+    assert import.reload.completed?
+    assert_not_nil import.account
+    assert_not_equal @account.id, import.account.id
+    assert_equal @account.name, import.account.name
+  ensure
+    zip_tempfile&.close!
+  end
+
+  test "process_now with invalid zip fails cleanly, leaves nothing behind, and emails reason" do
+    import = @identity.account_imports.create!(
+      file: { io: StringIO.new("not a zip"), filename: "bad.zip", content_type: "application/zip" }
+    )
+
+    assert_no_difference [ "Account.count", "Board.count", "Card.count", "User.count" ] do
+      assert_enqueued_emails 1 do
+        import.process_now
+      end
+    end
+
+    assert import.reload.failed?
+    assert_nil import.account
+    assert import.error_message.present?
+    assert_not import.file.attached?
+  end
+end
