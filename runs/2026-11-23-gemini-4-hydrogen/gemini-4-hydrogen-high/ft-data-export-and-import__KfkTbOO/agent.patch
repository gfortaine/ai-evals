diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..7e417f9
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @admin = users(:jason)
+    sign_in_as @admin
+  end
+
+  test "admin can create an account export and receives email with working 1-day link" do
+    assert_difference -> { Account::Export.count }, +1 do
+      assert_enqueued_with job: ExportJob do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    export = Account::Export.last
+
+    perform_enqueued_jobs do
+      export.build_now
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @admin.identity.email_address ], email.to
+    assert_includes email.body.encoded, account_export_path(export, script_name: @account.slug)
+
+    get account_export_path(export)
+    assert_response :redirect
+    assert_match %r{rails/active_storage}, response.location
+    follow_redirect!
+    follow_redirect!
+    assert_response :ok
+    assert_equal "application/zip", response.media_type
+
+    travel 25.hours do
+      get account_export_path(export)
+      assert_response :gone
+    end
+  end
+
+  test "non-admin cannot create or download account export" do
+    export = @account.exports.create!(user: @admin, status: :completed, completed_at: Time.current)
+    export.file.attach(io: StringIO.new("zip"), filename: "export.zip", content_type: "application/zip")
+
+    logout_and_sign_in_as users(:david)
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_path
+    end
+    assert_response :forbidden
+
+    get account_export_path(export)
+    assert_response :forbidden
+  end
+
+  test "account settings shows export section for admin" do
+    get account_settings_path
+    assert_response :ok
+    assert_select "form[action='#{account_exports_path}']"
+  end
+
+  test "account settings hides export section for non-admin" do
+    logout_and_sign_in_as users(:david)
+    get account_settings_path
+    assert_response :ok
+    assert_select "form[action='#{account_exports_path}']", count: 0
+  end
+end
