diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..05c2633
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "non-staff cannot access admin accounts or support tools" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :forbidden
+
+      get saas.admin_account_path(@account)
+      assert_response :forbidden
+
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_response :forbidden
+
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_response :forbidden
+
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: 500 } }
+      assert_response :forbidden
+
+      delete saas.admin_account_overridden_limits_path(@account)
+      assert_response :forbidden
+    end
+  end
+
+  test "staff can list accounts and open account page" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href='#{saas.admin_account_path(@account)}']", text: @account.name
+
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "button", text: "Comp"
+      assert_select "button", text: "Uncomp"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[type=submit][value='Override']"
+      assert_select "button", text: "Reset"
+    end
+  end
+
+  test "staff can comp and uncomp an account" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert @account.reload.comped?
+      assert_equal Plan.unlimited, @account.plan
+
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_not @account.reload.comped?
+      assert_equal Plan.free, @account.plan
+    end
+  end
+
+  test "staff can override and reset account limits" do
+    sign_in_as :david
+
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(@account),
+        params: { overridden_limits: { card_count: "950", bytes_used: "2000000000" } }
+
+      assert_redirected_to saas.admin_account_path(@account)
+      @account.reload
+      assert_equal 950, @account.card_count
+      assert_equal 2_000_000_000, @account.bytes_used
+      assert @account.nearing_card_limit?
+      assert @account.exceeding_storage_limit?
+
+      delete saas.admin_account_overridden_limits_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      @account.reload
+      assert_nil @account.overridden_limits
+      assert_equal 0, @account.card_count
+      assert_equal 0, @account.bytes_used
+    end
+  end
+
+  test "staff can partially override only card_count without affecting bytes_used" do
+    sign_in_as :david
+
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(@account),
+        params: { overridden_limits: { card_count: "950", bytes_used: "" } }
+
+      assert_redirected_to saas.admin_account_path(@account)
+      @account.reload
+      assert_equal 950, @account.card_count
+      assert_equal 0, @account.bytes_used
+      assert_nil @account.overridden_limits.bytes_used
+    end
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..7ba17ed
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,127 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @draft = cards(:unfinished_thoughts)
+    sign_in_as :mike
+  end
+
+  test "free account below warning threshold shows create buttons without countdown" do
+    @account.update_column(:cards_count, 899)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_no_match(/cards? left/, response.body)
+  end
+
+  test "free account from 100 cards out shows countdown warning" do
+    @account.update_column(:cards_count, 950)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_match "50 cards left", response.body
+  end
+
+  test "free account with 1 card left uses singular card left" do
+    @account.update_column(:cards_count, 999)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+
+    assert_response :success
+    assert_match "1 card left", response.body
+  end
+
+  test "free account out of cards replaces create buttons with Upgrade pitch" do
+    @account.update_column(:cards_count, 1000)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__notch", text: /Upgrade/
+    assert_select "a[href='#{account_settings_path(script_name: @account.slug)}']", text: "Upgrade"
+  end
+
+  test "free account out of cards can still draft via HTML" do
+    @account.update_column(:cards_count, 1000)
+    @board.cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count }, 1 do
+      post board_cards_path(@board, script_name: @account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "free account out of cards refuses publishing via HTML and JSON" do
+    @account.update_column(:cards_count, 1000)
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+
+    post card_publish_path(@draft, script_name: @account.slug), as: :json
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+  end
+
+  test "free account out of cards refuses API card creation" do
+    @account.update_column(:cards_count, 1000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Blocked API card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "paid account can publish and create via API beyond 1000 cards" do
+    @account.update_column(:cards_count, 1500)
+    @account.create_subscription!(
+      stripe_customer_id: "cus_paid",
+      stripe_subscription_id: "sub_paid",
+      plan_key: Plan.unlimited.key,
+      status: "active"
+    )
+
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+
+    assert_difference -> { Card.count }, 1 do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Paid API card" } },
+        as: :json
+    end
+    assert_response :created
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+
+  test "comped account can publish and create via API beyond 1000 cards" do
+    @account.update_column(:cards_count, 1500)
+    @account.comp
+
+    assert_difference -> { Card.count }, 1 do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Comped API card" } },
+        as: :json
+    end
+    assert_response :created
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..ef20a23
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @webhook_secret = "whsec_test_secret"
+    @prev_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    @prev_monthly = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    @prev_extra = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+    ENV["STRIPE_WEBHOOK_SECRET"] = @webhook_secret
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_unlimited_plus"
+  end
+
+  teardown do
+    restore_env("STRIPE_WEBHOOK_SECRET", @prev_secret)
+    restore_env("STRIPE_MONTHLY_V1_PRICE_ID", @prev_monthly)
+    restore_env("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID", @prev_extra)
+  end
+
+  test "rejects invalid signature" do
+    untenanted do
+      post saas.stripe_webhooks_path,
+        params: { id: "evt_1", type: "customer.subscription.updated" }.to_json,
+        headers: { "CONTENT_TYPE" => "application/json", "HTTP_STRIPE_SIGNATURE" => "t=123,v1=invalid" }
+    end
+
+    assert_response :bad_request
+  end
+
+  test "checkout.session.completed activates subscription" do
+    payload = {
+      id: "evt_checkout",
+      type: "checkout.session.completed",
+      data: {
+        object: {
+          id: "cs_test_123",
+          mode: "subscription",
+          customer: "cus_checkout",
+          subscription: "sub_checkout",
+          client_reference_id: @account.id,
+          metadata: { account_id: @account.id, plan_key: Plan.unlimited.key }
+        }
+      }
+    }.to_json
+
+    post_signed_webhook(payload)
+
+    assert_response :ok
+    subscription = @account.reload.subscription
+    assert_not_nil subscription
+    assert_equal "cus_checkout", subscription.stripe_customer_id
+    assert_equal "sub_checkout", subscription.stripe_subscription_id
+    assert_equal Plan.unlimited, @account.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "customer.subscription.created and updated sync plan and storage allowance" do
+    period_end = 30.days.from_now.to_i
+
+    created_payload = {
+      id: "evt_sub_created",
+      type: "customer.subscription.created",
+      data: {
+        object: {
+          id: "sub_sync",
+          customer: "cus_sync",
+          status: "active",
+          metadata: { account_id: @account.id },
+          items: { data: [ { price: { id: "price_unlimited" }, current_period_end: period_end } ] }
+        }
+      }
+    }.to_json
+
+    post_signed_webhook(created_payload)
+    assert_response :ok
+    assert_equal Plan.unlimited, @account.reload.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    updated_payload = {
+      id: "evt_sub_updated",
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_sync",
+          customer: "cus_sync",
+          status: "active",
+          cancel_at: period_end,
+          items: { data: [ { price: { id: "price_unlimited_plus" }, current_period_end: period_end } ] }
+        }
+      }
+    }.to_json
+
+    post_signed_webhook(updated_payload)
+    assert_response :ok
+    assert_equal Plan.unlimited_plus, @account.reload.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert_not_nil @account.subscription.cancel_at
+  end
+
+  test "customer.subscription.deleted cancels subscription and reverts to free" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_del",
+      stripe_subscription_id: "sub_del",
+      plan_key: Plan.unlimited_plus.key,
+      status: "active"
+    )
+
+    payload = {
+      id: "evt_sub_deleted",
+      type: "customer.subscription.deleted",
+      data: {
+        object: {
+          id: "sub_del",
+          customer: "cus_del",
+          status: "canceled",
+          canceled_at: Time.current.to_i
+        }
+      }
+    }.to_json
+
+    post_signed_webhook(payload)
+
+    assert_response :ok
+    assert_equal "canceled", @account.reload.subscription.status
+    assert_equal Plan.free, @account.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_equal 1_000, @account.card_limit
+  end
+
+  private
+    def post_signed_webhook(payload)
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, @webhook_secret)
+      header = Stripe::Webhook::Signature.generate_header(timestamp, signature)
+
+      untenanted do
+        post saas.stripe_webhooks_path,
+          params: payload,
+          headers: { "CONTENT_TYPE" => "application/json", "HTTP_STRIPE_SIGNATURE" => header }
+      end
+    end
+
+    def restore_env(key, value)
+      value.nil? ? ENV.delete(key) : ENV[key] = value
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..c00b49a
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "default plan is free with 1000 cards and 1 GB storage" do
+    assert_equal Plan.free, @account.plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_not @account.comped?
+    assert_nil @account.active_subscription
+  end
+
+  test "active subscription brings its own plan and storage allowance" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      plan_key: Plan.unlimited.key,
+      status: "active"
+    )
+
+    assert_equal Plan.unlimited, @account.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_equal Float::INFINITY, @account.card_limit
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+
+    @account.subscription.update!(plan_key: Plan.unlimited_plus.key)
+    assert_equal Plan.unlimited_plus, @account.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "canceled subscription falls back to free plan" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      plan_key: Plan.unlimited_plus.key,
+      status: "canceled"
+    )
+
+    assert_nil @account.active_subscription
+    assert_equal Plan.free, @account.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_equal 1_000, @account.card_limit
+  end
+
+  test "comped account has unlimited plan" do
+    @account.comp
+    assert @account.comped?
+    assert_equal Plan.unlimited, @account.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+
+    @account.uncomp
+    assert_not @account.comped?
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "card limit countdown and exceeding thresholds" do
+    @account.update_column(:cards_count, 899)
+    assert_equal 101, @account.cards_remaining
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 900)
+    assert_equal 100, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 950)
+    assert_equal 50, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 1000)
+    assert_equal 0, @account.cards_remaining
+    assert_not @account.nearing_card_limit?
+    assert @account.exceeding_card_limit?
+  end
+
+  test "overridden limits override card_count and bytes_used including zero" do
+    @account.update_column(:cards_count, 50)
+    @account.override_limits(card_count: 950, bytes_used: 2.gigabytes)
+
+    assert_equal 950, @account.card_count
+    assert_equal 50, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.exceeding_storage_limit?
+
+    @account.override_limits(card_count: 0, bytes_used: 0)
+    assert_equal 0, @account.card_count
+    assert_equal 0, @account.bytes_used
+
+    @account.reset_overridden_limits
+    assert_nil @account.overridden_limits
+    assert_equal 50, @account.card_count
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "canceling account cancels active stripe subscription" do
+    subscription = @account.create_subscription!(
+      stripe_customer_id: "cus_cancel",
+      stripe_subscription_id: "sub_cancel",
+      plan_key: Plan.unlimited.key,
+      status: "active"
+    )
+
+    Stripe::Subscription.expects(:cancel).with("sub_cancel").once
+    @account.cancel(initiated_by: users(:mike))
+
+    assert @account.cancelled?
+    assert_equal "canceled", subscription.reload.status
+  end
+end
