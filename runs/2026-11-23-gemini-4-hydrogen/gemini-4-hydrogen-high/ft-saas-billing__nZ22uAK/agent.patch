+require "test_helper"
+
+class Account::SettingsBillingTest < ActionDispatch::IntegrationTest
+  test "admin sees Free plan and Upgrade options in settings" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "#subscription" do
+      assert_select "strong", text: "Free"
+      assert_select "strong", text: "Unlimited"
+      assert_select "strong", text: "Unlimited+"
+      assert_select "button", text: "Upgrade", count: 2
+    end
+  end
+
+  test "non-admin member does not see billing section in settings" do
+    sign_in_as :jz
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "#subscription", count: 0
+  end
+
+  test "admin on paid plan sees plan name and Manage billing button" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      stripe_customer_id: "cus_portal",
+      stripe_subscription_id: "sub_portal",
+      plan_key: Plan.unlimited_plus.key,
+      status: "active"
+    )
+    sign_in_as :mike
+
+    get account_settings_path(script_name: account.slug)
+
+    assert_response :success
+    assert_select "#subscription" do
+      assert_select "strong", text: "Unlimited+"
+      assert_select "button", text: "Manage billing"
+    end
+  end
+
+  test "admin can start stripe checkout for paid plan" do
+    account = accounts(:initech)
+    sign_in_as :mike
+
+    Stripe::Customer.expects(:create).returns(stub(id: "cus_new")).once
+    Stripe::Checkout::Session.expects(:create).with(has_entries(
+      customer: "cus_new",
+      mode: "subscription",
+      client_reference_id: account.id
+    )).returns(stub(url: "https://checkout.stripe.com/c/pay/cs_test_123")).once
+
+    post saas.account_subscription_path(script_name: account.slug), params: { plan_key: Plan.unlimited.key }
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_123"
+    assert_equal "cus_new", account.reload.subscription.stripe_customer_id
+  end
+
+  test "non-admin cannot start checkout or open billing portal" do
