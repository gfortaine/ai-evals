diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..e668914
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,115 @@
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  def create
+    event = construct_event
+    return head :bad_request unless event
+
+    case event.type
+    when "checkout.session.completed"
+      handle_checkout_session_completed(event.data.object)
+    when "customer.subscription.created", "customer.subscription.updated"
+      sync_subscription(event.data.object)
+    when "customer.subscription.deleted"
+      handle_subscription_deleted(event.data.object)
+    when "invoice.upcoming"
+      handle_invoice_upcoming(event.data.object)
+    end
+
+    head :ok
+  end
+
+  private
+    def construct_event
+      Stripe::Webhook.construct_event(
+        request.raw_post,
+        request.env["HTTP_STRIPE_SIGNATURE"],
+        ENV["STRIPE_WEBHOOK_SECRET"]
+      )
+    rescue JSON::ParserError, Stripe::SignatureVerificationError
+      nil
+    end
+
+    def handle_checkout_session_completed(session)
+      return unless session[:mode] == "subscription" && session[:subscription].present?
+
+      account = find_account_for_checkout(session)
+      return unless account
+
+      stripe_subscription = retrieve_stripe_subscription(session[:subscription])
+
+      if stripe_subscription
+        sync_subscription(stripe_subscription, account: account)
+      else
+        subscription = account.subscription || account.build_subscription
+        plan = Plan.find(session[:metadata]&.[](:plan_key))
+
+        subscription.update!(
+          stripe_customer_id: session[:customer],
+          stripe_subscription_id: session[:subscription],
+          plan_key: plan&.key || subscription.plan_key,
+          status: "active"
+        )
+      end
+    end
+
+    def find_account_for_checkout(session)
+      Account.find_by(id: session[:client_reference_id]) ||
+        Account.find_by(id: session[:metadata]&.[](:account_id)) ||
+        Account::Subscription.find_by(stripe_customer_id: session[:customer])&.account
+    end
+
+    def retrieve_stripe_subscription(subscription_id)
+      Stripe::Subscription.retrieve(subscription_id)
+    rescue Stripe::StripeError
+      nil
+    end
+
+    def sync_subscription(stripe_subscription, account: nil)
+      subscription = Account::Subscription.find_by(stripe_subscription_id: stripe_subscription[:id]) ||
+        Account::Subscription.find_by(stripe_customer_id: stripe_subscription[:customer])
+
+      account ||= subscription&.account || Account.find_by(id: stripe_subscription[:metadata]&.[](:account_id))
+      return unless account
+
+      subscription ||= account.subscription || account.build_subscription
+      price_id = stripe_subscription[:items]&.[](:data)&.first&.[](:price)&.[](:id) || stripe_subscription[:plan]&.[](:id)
+      plan = Plan.find_by_price_id(price_id) || Plan.find(stripe_subscription[:metadata]&.[](:plan_key))
+
+      period_end_ts = stripe_subscription[:current_period_end] ||
+        stripe_subscription[:items]&.[](:data)&.first&.[](:current_period_end)
+      cancel_at_ts = stripe_subscription[:cancel_at] ||
+        (stripe_subscription[:cancel_at_period_end] ? period_end_ts : nil)
+
+      subscription.update!(
+        stripe_customer_id: stripe_subscription[:customer],
+        stripe_subscription_id: stripe_subscription[:id],
+        status: stripe_subscription[:status],
+        plan_key: plan&.key || subscription.plan_key,
+        current_period_end: period_end_ts ? Time.at(period_end_ts) : subscription.current_period_end,
+        cancel_at: cancel_at_ts ? Time.at(cancel_at_ts) : nil
+      )
+    end
+
+    def handle_subscription_deleted(stripe_subscription)
+      subscription = Account::Subscription.find_by(stripe_subscription_id: stripe_subscription[:id]) ||
+        Account::Subscription.find_by(stripe_customer_id: stripe_subscription[:customer])
+      return unless subscription
+
+      canceled_at_ts = stripe_subscription[:canceled_at] || stripe_subscription[:ended_at]
+      subscription.update!(
+        status: stripe_subscription[:status].presence || "canceled",
+        cancel_at: canceled_at_ts ? Time.at(canceled_at_ts) : Time.current
+      )
+    end
+
+    def handle_invoice_upcoming(invoice)
+      subscription = Account::Subscription.find_by(stripe_subscription_id: invoice[:subscription]) ||
+        Account::Subscription.find_by(stripe_customer_id: invoice[:customer])
+      return unless subscription
+
+      subscription.update!(next_amount_due_in_cents: invoice[:amount_due])
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..0775ecc
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,100 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limits, class_name: "Account::OverriddenLimits", dependent: :destroy
+
+    set_callback :cancel, :after, :cancel_subscription
+  end
+
+  def plan
+    if active_subscription
+      active_subscription.plan
+    elsif comped?
+      Plan.unlimited
+    else
+      Plan.free
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    billing_waiver || create_billing_waiver!
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    association(:billing_waiver).reset
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    if card_count.nil? && bytes_used.nil?
+      reset_overridden_limits
+    elsif overridden_limits
+      overridden_limits.update!(card_count: card_count, bytes_used: bytes_used)
+    else
+      create_overridden_limits!(card_count: card_count, bytes_used: bytes_used)
+    end
+  end
+
+  def reset_overridden_limits
+    overridden_limits&.destroy!
+    association(:overridden_limits).reset
+  end
+
+  def card_count
+    overridden_limits&.card_count || cards_count
+  end
+
+  def bytes_used
+    overridden_limits&.bytes_used || super
+  end
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def cards_remaining
+    if plan.limited_cards?
+      [ card_limit - card_count, 0 ].max
+    else
+      Float::INFINITY
+    end
+  end
+
+  def exceeding_card_limit?
+    plan.limited_cards? && card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    plan.limited_cards? && !exceeding_card_limit? && cards_remaining <= Plan::CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  def find_or_create_stripe_customer_id(email:)
+    if subscription&.stripe_customer_id.present?
+      subscription.stripe_customer_id
+    else
+      customer = Stripe::Customer.create(
+        email: email,
+        name: name,
+        metadata: { account_id: id, external_account_id: external_account_id }
+      )
+      create_subscription!(stripe_customer_id: customer.id)
+      customer.id
+    end
+  end
+
+  private
+    def cancel_subscription
+      active_subscription&.cancel
+    end
+end
