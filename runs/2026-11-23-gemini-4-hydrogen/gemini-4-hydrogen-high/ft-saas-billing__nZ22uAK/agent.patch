diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..d8a84fc
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,31 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  scope :active, -> { where(status: ACTIVE_STATUSES) }
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def plan
+    if active?
+      Plan.find(plan_key) || Plan.unlimited
+    else
+      Plan.free
+    end
+  end
+
+  def cancel
+    if stripe_subscription_id.present? && active?
+      Stripe::Subscription.cancel(stripe_subscription_id)
+      update!(status: "canceled", cancel_at: Time.current)
+    end
+  rescue Stripe::StripeError => error
+    Rails.error.report(error, severity: :error)
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..ba2987f
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,113 @@
+class Plan
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  PLANS = {
+    free_v1: {
+      key: "free_v1",
+      name: "Free",
+      price: 0,
+      card_limit: 1_000,
+      storage_limit: 1.gigabyte,
+      stripe_price_id_env: nil
+    },
+    monthly_v1: {
+      key: "monthly_v1",
+      name: "Unlimited",
+      price: 20,
+      card_limit: Float::INFINITY,
+      storage_limit: 5.gigabytes,
+      stripe_price_id_env: "STRIPE_MONTHLY_V1_PRICE_ID"
+    },
+    monthly_extra_storage_v1: {
+      key: "monthly_extra_storage_v1",
+      name: "Unlimited+",
+      price: 25,
+      card_limit: Float::INFINITY,
+      storage_limit: 500.gigabytes,
+      stripe_price_id_env: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+    }
+  }.freeze
+
+  ALIASES = {
+    "free" => :free_v1,
+    "unlimited" => :monthly_v1,
+    "unlimited_plus" => :monthly_extra_storage_v1
+  }.freeze
+
+  attr_reader :key, :name, :price, :card_limit, :storage_limit
+
+  class << self
+    def all
+      @all ||= PLANS.values.map { |attrs| new(**attrs) }
+    end
+
+    def paid
+      all.select(&:paid?)
+    end
+
+    def free
+      @free ||= find(:free_v1)
+    end
+
+    def unlimited
+      @unlimited ||= find(:monthly_v1)
+    end
+
+    def unlimited_plus
+      @unlimited_plus ||= find(:monthly_extra_storage_v1)
+    end
+
+    def find(key)
+      return nil if key.blank?
+
+      normalized = key.to_s.downcase
+      canonical = ALIASES[normalized] || normalized.to_sym
+      all.find { |plan| plan.key == canonical.to_s }
+    end
+
+    alias_method :[], :find
+
+    def find_by_price_id(price_id)
+      return nil if price_id.blank?
+
+      all.find { |plan| plan.stripe_price_id == price_id }
+    end
+  end
+
+  def initialize(key:, name:, price:, card_limit:, storage_limit:, stripe_price_id_env:)
+    @key = key
+    @name = name
+    @price = price
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @stripe_price_id_env = stripe_price_id_env
+  end
+
+  def stripe_price_id
+    ENV[@stripe_price_id_env] if @stripe_price_id_env
+  end
+
+  def free?
+    price.zero?
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited_cards?
+    card_limit == Float::INFINITY
+  end
+
+  def limited_cards?
+    !unlimited_cards?
+  end
+
+  def to_param
+    key
+  end
+
+  def ==(other)
+    other.is_a?(Plan) && other.key == key
+  end
+end
diff --git a/saas/app/views/account/settings/saas/_subscription.html.erb b/saas/app/views/account/settings/saas/_subscription.html.erb
