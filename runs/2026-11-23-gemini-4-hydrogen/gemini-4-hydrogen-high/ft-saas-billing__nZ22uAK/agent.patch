@@ -0,0 +1,43 @@
+<section id="subscription" class="settings__section">
+  <header>
+    <h2 class="divider">Plan & Billing</h2>
+    <div>
+      Current plan: <strong><%= account.plan.name %></strong><% if account.comped? %> (Comped)<% end %>
+    </div>
+    <div class="txt-small txt-subtle">
+      <% if account.plan.limited_cards? %>
+        <%= number_with_delimiter(account.card_count) %> of <%= number_with_delimiter(account.card_limit) %> cards used
+      <% else %>
+        Unlimited cards (<%= number_with_delimiter(account.card_count) %> created)
+      <% end %>
+      ·
+      <%= number_to_human_size(account.bytes_used) %> of <%= number_to_human_size(account.storage_limit) %> storage used
+    </div>
+  </header>
+
+  <% if account.comped? %>
+    <p class="txt-small txt-subtle">This account has a complimentary Unlimited plan.</p>
+  <% elsif account.active_subscription %>
+    <% if account.active_subscription.cancel_at.present? %>
+      <p class="txt-small">
+        Your subscription will cancel on <strong><%= l(account.active_subscription.cancel_at.to_date, format: :long) %></strong>.
+      </p>
+    <% end %>
+
+    <%= button_to "Manage billing", saas.account_billing_portal_path, method: :post, class: "btn", form: { data: { turbo: false } } %>
+  <% else %>
+    <div class="flex flex-column gap-half">
+      <% Plan.paid.each do |plan| %>
+        <div class="flex align-center justify-space-between gap pad-inline pad-block-half border border-radius">
+          <div class="txt-align-start">
+            <strong><%= plan.name %></strong>
+            <div class="txt-small txt-subtle">
+              $<%= plan.price %>/month · Unlimited cards · <%= number_to_human_size(plan.storage_limit) %>
+            </div>
+          </div>
+          <%= button_to "Upgrade", saas.account_subscription_path(plan_key: plan.key), method: :post, class: "btn btn--link settings-subscription__button", form: { data: { turbo: false } } %>
+        </div>
+      <% end %>
+    </div>
+  <% end %>
+</section>
diff --git a/saas/app/views/admin/accounts/index.html.erb b/saas/app/views/admin/accounts/index.html.erb
new file mode 100644
index 0000000..47a67c2
--- /dev/null
+++ b/saas/app/views/admin/accounts/index.html.erb
@@ -0,0 +1,42 @@
+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow center" style="--panel-size: 100%; max-inline-size: 100%;">
+    <div class="flex align-center justify-space-between gap">
+      <h2 class="divider txt-medium flex-item-grow">All Accounts</h2>
+      <%= link_to "Stats", saas.admin_stats_path, class: "btn txt-small" %>
+    </div>
+
+    <%= form_with url: saas.admin_accounts_path, method: :get, class: "flex gap-half" do |form| %>
+      <%= form.search_field :q, value: params[:q], placeholder: "Search by name or ID…", class: "input flex-item-grow" %>
+      <%= form.submit "Search", class: "btn" %>
+    <% end %>
+
+    <ul class="list-style-none flex flex-column gap-half margin-none">
+      <% @accounts.each do |account| %>
+        <% owner = account.users.owner.first %>
+        <li class="flex align-center justify-space-between gap border-bottom pad-block-half">
+          <div class="txt-align-start min-width overflow-ellipsis">
+            <strong><%= link_to account.name, saas.admin_account_path(account), class: "txt-link" %></strong>
+            <div class="txt-x-small txt-subtle">
+              #<%= account.external_account_id %> ·
+              <%= owner&.identity&.email_address || "No owner" %> ·
+              <%= account.plan.name %>
+              <% if account.comped? %>· Comped<% end %>
+              <% if account.overridden_limits.present? %>· Overridden<% end %>
+            </div>
+          </div>
+
+          <div class="txt-small txt-align-end txt-nowrap">
+            <div><strong><%= number_with_delimiter(account.card_count) %></strong> cards</div>
+            <div class="txt-x-small txt-subtle"><%= number_to_human_size(account.bytes_used) %> / <%= number_to_human_size(account.storage_limit) %></div>
+          </div>
+        </li>
+      <% end %>
+    </ul>
+  </div>
+</section>
diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..86c1901
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,71 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <div class="flex align-center justify-space-between gap">
+      <h2 class="divider txt-medium flex-item-grow">Account Details</h2>
+      <%= link_to "All accounts", saas.admin_accounts_path, class: "btn txt-small" %>
+    </div>
+
+    <div class="flex flex-column gap-half txt-align-start">
+      <div><strong>ID:</strong> #<%= @account.external_account_id %> (<code><%= @account.id %></code>)</div>
+      <div><strong>Owner:</strong> <%= @account.owner_email || "None" %></div>
+      <div><strong>Plan:</strong> <%= @account.plan.name %></div>
+      <div><strong>Subscription status:</strong> <%= @account.subscription&.status || "None" %></div>
+      <div><strong>Comped:</strong> <%= @account.comped? ? "Yes" : "No" %></div>
+      <div><strong>Card count:</strong> <%= number_with_delimiter(@account.card_count) %> (actual: <%= number_with_delimiter(@account.cards_count) %>)</div>
+      <div><strong>Bytes used:</strong> <%= number_with_delimiter(@account.bytes_used) %> bytes (<%= number_to_human_size(@account.bytes_used) %>) of <%= number_to_human_size(@account.storage_limit) %></div>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider txt-medium">Billing Waiver</h2>
+        <div class="txt-small txt-subtle">
+          Status: <strong><%= @account.comped? ? "Comped" : "Not comped" %></strong>
+        </div>
+      </header>
+
+      <div class="flex gap-half">
+        <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn btn--link" %>
+        <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+      </div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider txt-medium">Override Limits</h2>
+        <% if @account.overridden_limits.present? %>
+          <div class="txt-small txt-subtle">
+            Active override — Card count: <%= @account.overridden_limits.card_count.inspect %>, Bytes used: <%= @account.overridden_limits.bytes_used.inspect %>
+          </div>
+        <% end %>
+      </header>
+
+      <%= form_with model: (@account.overridden_limits || @account.build_overridden_limits), scope: :overridden_limits, url: saas.admin_account_overridden_limits_path(@account), method: :patch, class: "flex flex-column gap-half" do |form| %>
+        <div class="flex flex-column gap-quarter txt-align-start">
+          <%= form.label :card_count, "Card count", class: "txt-small font-weight-semibold" %>
+          <%= form.number_field :card_count, min: 0, class: "input", placeholder: "Leave blank for actual (#{@account.cards_count})" %>
+        </div>
+
+        <div class="flex flex-column gap-quarter txt-align-start">
+          <%= form.label :bytes_used, "Bytes used", class: "txt-small font-weight-semibold" %>
+          <%= form.number_field :bytes_used, min: 0, class: "input", placeholder: "Leave blank for actual" %>
+        </div>
+
+        <div class="flex gap-half">
+          <%= form.submit "Override", class: "btn btn--link" %>
+        </div>
+      <% end %>
+
+      <div class="margin-block-start-half">
+        <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn" %>
+      </div>
+    </section>
+  </div>
+</section>
