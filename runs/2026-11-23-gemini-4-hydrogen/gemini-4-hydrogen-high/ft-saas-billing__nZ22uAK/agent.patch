@@ -0,0 +1,30 @@
+class Admin::Accounts::OverriddenLimitsController < AdminController
+  before_action :set_account
+
+  def update
+    @account.override_limits(**overridden_limits_params)
+    redirect_to saas.admin_account_path(@account), notice: "Account limits overridden"
+  end
+
+  def destroy
+    @account.reset_overridden_limits
+    redirect_to saas.admin_account_path(@account), notice: "Account limits reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:account_id]) || Account.find_by!(external_account_id: params[:account_id])
+    end
+
+    def overridden_limits_params
+      permitted = params.fetch(:overridden_limits, params).permit(:card_count, :bytes_used)
+      {
+        card_count: parse_optional_integer(permitted[:card_count]),
+        bytes_used: parse_optional_integer(permitted[:bytes_used])
+      }
+    end
+
+    def parse_optional_integer(value)
+      value.present? ? value.to_i : nil
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
