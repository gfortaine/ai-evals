+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "free plan attributes" do
+    plan = Plan.free
+    assert_equal "Free", plan.name
+    assert_equal 0, plan.price
+    assert_equal 1_000, plan.card_limit
+    assert_equal 1.gigabyte, plan.storage_limit
+    assert plan.free?
+    assert_not plan.paid?
+    assert plan.limited_cards?
+    assert_nil plan.stripe_price_id
+  end
+
+  test "unlimited plan attributes" do
+    with_env("STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited") do
+      plan = Plan.unlimited
+      assert_equal "Unlimited", plan.name
+      assert_equal 20, plan.price
+      assert_equal Float::INFINITY, plan.card_limit
+      assert_equal 5.gigabytes, plan.storage_limit
+      assert plan.paid?
+      assert_not plan.free?
+      assert plan.unlimited_cards?
+      assert_not plan.limited_cards?
+      assert_equal "price_unlimited", plan.stripe_price_id
+    end
+  end
+
+  test "unlimited+ plan attributes" do
+    with_env("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_unlimited_plus") do
+      plan = Plan.unlimited_plus
+      assert_equal "Unlimited+", plan.name
+      assert_equal 25, plan.price
+      assert_equal Float::INFINITY, plan.card_limit
+      assert_equal 500.gigabytes, plan.storage_limit
+      assert plan.paid?
+      assert plan.unlimited_cards?
+      assert_equal "price_unlimited_plus", plan.stripe_price_id
+    end
+  end
+
+  test "find by key and alias" do
+    assert_equal Plan.free, Plan.find("free")
+    assert_equal Plan.free, Plan.find("free_v1")
+    assert_equal Plan.unlimited, Plan.find("unlimited")
+    assert_equal Plan.unlimited, Plan.find("monthly_v1")
+    assert_equal Plan.unlimited_plus, Plan.find("unlimited_plus")
+    assert_equal Plan.unlimited_plus, Plan.find("monthly_extra_storage_v1")
+    assert_nil Plan.find(nil)
+    assert_nil Plan.find("nonexistent")
+  end
+
+  test "find_by_price_id" do
+    with_env("STRIPE_MONTHLY_V1_PRICE_ID" => "price_u", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_up") do
+      assert_equal Plan.unlimited, Plan.find_by_price_id("price_u")
+      assert_equal Plan.unlimited_plus, Plan.find_by_price_id("price_up")
+      assert_nil Plan.find_by_price_id(nil)
+      assert_nil Plan.find_by_price_id("")
+      assert_nil Plan.find_by_price_id("price_unknown")
+    end
+  end
+
+  private
+    def with_env(vars)
+      previous = vars.keys.index_with { |k| ENV[k] }
+      vars.each { |k, v| ENV[k] = v }
+      yield
+    ensure
+      previous.each { |k, v| v.nil? ? ENV.delete(k) : ENV[k] = v }
+    end
+end
