+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,22 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  def index
+    @accounts = Account.includes(:subscription, :billing_waiver, :overridden_limits, :storage_exception, users: :identity)
+      .order(created_at: :desc)
+
+    if params[:q].present?
+      term = params[:q].strip
+      query = "%#{Account.sanitize_sql_like(term)}%"
+      @accounts = if term.match?(/\A\d+\z/)
+        @accounts.where(external_account_id: term.to_i).or(@accounts.where("name LIKE ?", query))
+      else
+        @accounts.where("name LIKE ?", query)
+      end
+    end
+  end
+
+  def show
+    @account = Account.find_by(id: params[:id]) || Account.find_by!(external_account_id: params[:id])
+  end
+end
