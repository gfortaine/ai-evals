+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @david = users(:david)
+    @account = @kevin.account
+    @vapid_keys = WebPush.generate_key
+    @phone = Push::Subscription.create!(
+      user: @kevin,
+      endpoint: "https://push.example.com/phone",
+      p256dh_key: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+      auth_key: "tBHItJI5svbpez7KI4CCXg"
+    )
+    @desktop = Push::Subscription.create!(
+      user: @kevin,
+      endpoint: "https://push.example.com/desktop",
+      p256dh_key: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+      auth_key: "tBHItJI5svbpez7KI4CCXg"
+    )
+  end
+
+  test "creating a notification enqueues PushJob when user has subscriptions" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    end
+  end
+
+  test "creating a notification does not enqueue PushJob when user has no subscriptions" do
+    @kevin.push_subscriptions.destroy_all
+    notifications(:layout_commented_kevin).destroy
+
+    assert_no_enqueued_jobs(only: Notification::PushJob) do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    end
+  end
+
+  test "updating a notification with a new source enqueues PushJob" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_with(job: Notification::PushJob, args: [ notification ]) do
+      notification.update!(source: events(:logo_published), creator: @david, read_at: nil, unread_count: 3)
+    end
+  end
+
+  test "reading or unreading a notification does not enqueue PushJob" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_enqueued_jobs(only: Notification::PushJob) do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "push_now delivers comment notification to all user subscriptions with tray title, body, and card anchor path" do
+    notification = notifications(:layout_commented_kevin)
+    comment = notification.source.eventable
+    expected_path = Rails.application.routes.url_helpers.card_path(
+      comment.card,
+      script_name: @account.slug,
+      anchor: ActionView::RecordIdentifier.dom_id(comment)
+    )
+
+    deliveries = []
+    switch_env("VAPID_PUBLIC_KEY" => @vapid_keys.public_key, "VAPID_PRIVATE_KEY" => @vapid_keys.private_key) do
+      WebPush.stubs(:payload_send).with do |args|
+        deliveries << args
+        true
+      end
+
+      perform_enqueued_jobs only: Notification::PushJob do
+        notification.push_later
+      end
+    end
+
+    assert_equal 2, deliveries.size
+    assert_equal [ @phone.endpoint, @desktop.endpoint ].sort, deliveries.map { |d| d[:endpoint] }.sort
+
+    payload = JSON.parse(deliveries.first[:message])
+    assert_equal ApplicationController.helpers.event_notification_title(notification.source), payload["title"]
+    assert_equal ApplicationController.helpers.event_notification_body(notification.source), payload.dig("options", "body")
+    assert_equal expected_path, payload.dig("options", "data", "path")
+  end
+
+  test "push_now delivers mention notification with mentioner title and card path" do
+    mention_sub = Push::Subscription.create!(
+      user: @david,
+      endpoint: "https://push.example.com/david-laptop",
+      p256dh_key: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+      auth_key: "tBHItJI5svbpez7KI4CCXg"
+    )
+    notification = notifications(:logo_mentioned_david)
+    mention = notification.source
+    expected_path = Rails.application.routes.url_helpers.card_path(
+      notification.card,
+      script_name: @account.slug,
+      anchor: ActionView::RecordIdentifier.dom_id(mention.source)
+    )
+
+    deliveries = []
+    switch_env("VAPID_PUBLIC_KEY" => @vapid_keys.public_key, "VAPID_PRIVATE_KEY" => @vapid_keys.private_key) do
+      WebPush.stubs(:payload_send).with do |args|
+        deliveries << args
+        true
+      end
+
+      notification.push_now
+    end
+
+    assert_equal 1, deliveries.size
+    assert_equal mention_sub.endpoint, deliveries.first[:endpoint]
+
+    payload = JSON.parse(deliveries.first[:message])
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", payload["title"]
+    assert_equal mention.source.mentionable_content.truncate(200), payload.dig("options", "body")
+    assert_equal expected_path, payload.dig("options", "data", "path")
+  end
+
+  test "push_now delivers card event notification with card title, body, and card path" do
+    notification = notifications(:buy_domain_sent_back_to_triage_kevin)
+    expected_path = Rails.application.routes.url_helpers.card_path(
+      notification.card,
+      script_name: @account.slug
+    )
+
+    deliveries = []
+    switch_env("VAPID_PUBLIC_KEY" => @vapid_keys.public_key, "VAPID_PRIVATE_KEY" => @vapid_keys.private_key) do
+      WebPush.stubs(:payload_send).with do |args|
+        deliveries << args
+        true
+      end
+
+      notification.push_now
+    end
+
+    assert_equal 2, deliveries.size
+    payload = JSON.parse(deliveries.first[:message])
+    assert_equal ApplicationController.helpers.event_notification_title(notification.source), payload["title"]
+    assert_equal ApplicationController.helpers.event_notification_body(notification.source), payload.dig("options", "body")
+    assert_equal expected_path, payload.dig("options", "data", "path")
+  end
+
+  test "push_now continues delivering to remaining subscriptions if one fails" do
+    notification = notifications(:layout_commented_kevin)
+    response = stub(inspect: "503 Service Unavailable", body: "")
+
+    switch_env("VAPID_PUBLIC_KEY" => @vapid_keys.public_key, "VAPID_PRIVATE_KEY" => @vapid_keys.private_key) do
+      WebPush.expects(:payload_send).twice
+        .raises(WebPush::PushServiceError.new(response, "push.example.com"))
+        .then.returns(true)
+
+      assert_nothing_raised do
+        notification.push_now
+      end
+    end
+  end
+
+  test "push_now skips already read notifications" do
+    notification = notifications(:layout_commented_kevin)
+    notification.read
+
+    switch_env("VAPID_PUBLIC_KEY" => @vapid_keys.public_key, "VAPID_PRIVATE_KEY" => @vapid_keys.private_key) do
+      WebPush.expects(:payload_send).never
+      notification.push_now
+    end
+  end
+
+  private
+    def switch_env(vars)
+      previous = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      previous.each { |key, value| ENV[key] = value }
+    end
+end
