new file mode 100644
index 0000000..1ec9ce2
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,37 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @push_subscription.update!(push_subscription_params.merge(user_agent: request.user_agent&.first(4096)))
+
+    head :created
+  end
+
+  def destroy
+    if params[:id] == "unsubscribe" && params[:endpoint].present?
+      @user.push_subscriptions.where(endpoint: params[:endpoint]).destroy_all
+    else
+      @user.push_subscriptions.find(params[:id]).destroy!
+    end
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications disabled" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..26089c4
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,189 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "switch", "details", "explainer", "blocked" ]
+  static values = { subscriptionsUrl: String }
+
+  async connect() {
+    if (!this.#vapidPublicKey) {
+      this.#disableSwitch()
+      return
+    }
+
+    if (!this.#supported) {
+      this.#disableSwitch()
+      this.#showInstallOnly()
+      return
+    }
+
+    if (this.#denied) {
+      this.#disableSwitch()
+      this.#showBlockedHelp()
+      return
+    }
+
+    const subscription = await this.#currentSubscription()
+    const subscribed = Boolean(subscription) && Notification.permission === "granted"
+    this.#updateState(subscribed)
+  }
+
+  async toggle() {
+    if (!this.#supported || !this.#vapidPublicKey) return
+
+    this.switchTarget.disabled = true
+
+    try {
+      if (this.switchTarget.checked) {
+        await this.#subscribe()
+      } else {
+        await this.#unsubscribe()
+      }
+    } catch (error) {
+      console.error("Push notification toggle failed:", error)
+      this.#updateState(!this.switchTarget.checked)
+    } finally {
+      if (this.#supported && !this.#denied) {
+        this.switchTarget.disabled = false
+      }
+    }
+  }
+
+  async #subscribe() {
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") {
+      this.#updateState(false)
+      if (permission === "denied") {
+        this.#disableSwitch()
+        this.#showBlockedHelp()
+      }
+      return
+    }
+
+    const registration = await this.#serviceWorkerRegistration()
+    const applicationServerKey = this.#urlBase64ToUint8Array(this.#vapidPublicKey)
+
+    let subscription = await registration.pushManager.getSubscription()
+    if (subscription && !this.#matchingServerKey(subscription, applicationServerKey)) {
+      await subscription.unsubscribe()
+      subscription = null
+    }
+
+    if (!subscription) {
+      subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey
+      })
+    }
+
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+    const response = await post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint,
+          p256dh_key: p256dh,
+          auth_key: auth
+        }
+      },
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      this.#updateState(true)
+    } else {
+      this.#updateState(false)
+    }
+  }
+
+  async #unsubscribe() {
+    const subscription = await this.#currentSubscription()
+    if (subscription) {
+      const { endpoint } = subscription
+      await subscription.unsubscribe()
+      await destroy(`${this.subscriptionsUrlValue}/unsubscribe`, {
+        body: { endpoint },
+        responseKind: "json"
+      })
+    }
+
+    this.#updateState(false)
+  }
+
+  async #currentSubscription() {
+    try {
+      const registration = await navigator.serviceWorker.getRegistration("/")
+      return registration ? await registration.pushManager.getSubscription() : null
+    } catch {
+      return null
+    }
+  }
+
+  async #serviceWorkerRegistration() {
+    const existing = await navigator.serviceWorker.getRegistration("/")
+    if (!existing) {
+      await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    }
+    return await navigator.serviceWorker.ready
+  }
+
+  #updateState(subscribed) {
+    this.switchTarget.disabled = false
+    this.switchTarget.checked = subscribed
+    this.element.classList.toggle(this.onClass, subscribed)
+    this.#hideHelp()
+  }
+
+  #disableSwitch() {
+    this.switchTarget.checked = false
+    this.switchTarget.disabled = true
+    this.element.classList.remove(this.onClass)
+  }
+
+  #hideHelp() {
+    this.explainerTarget.hidden = true
+    this.blockedTarget.hidden = true
+    this.detailsTargets.forEach((detail) => { detail.hidden = true })
+  }
+
+  #showBlockedHelp() {
+    this.explainerTarget.hidden = false
+    this.blockedTarget.hidden = false
+    this.detailsTargets.forEach((detail) => { detail.hidden = false })
+  }
+
+  #showInstallOnly() {
+    this.explainerTarget.hidden = false
+    this.blockedTarget.hidden = true
+    this.detailsTargets.forEach((detail) => { detail.hidden = true })
+  }
+
+  #matchingServerKey(subscription, expectedKey) {
+    const currentKey = subscription.options?.applicationServerKey
+    if (!currentKey) return true
+
+    const currentBytes = new Uint8Array(currentKey)
+    if (currentBytes.length !== expectedKey.length) return false
+    return currentBytes.every((byte, index) => byte === expectedKey[index])
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = atob(base64)
+    return Uint8Array.from(rawData, (char) => char.charCodeAt(0))
+  }
+
+  get #vapidPublicKey() {
+    return getMetaContent("vapid-public-key")
+  }
+
+  get #supported() {
+    return "Notification" in window && "PushManager" in window && "serviceWorker" in navigator
+  }
+
+  get #denied() {
+    return Notification.permission === "denied"
+  }
+}
