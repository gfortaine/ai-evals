+++ b/test/system/push_notifications_test.rb
@@ -0,0 +1,120 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:david)
+    @vapid_keys = WebPush.generate_key
+    @previous_public = ENV["VAPID_PUBLIC_KEY"]
+    @previous_private = ENV["VAPID_PRIVATE_KEY"]
+    ENV["VAPID_PUBLIC_KEY"] = @vapid_keys.public_key
+    ENV["VAPID_PRIVATE_KEY"] = @vapid_keys.private_key
+
+    sign_in_as @user
+  end
+
+  teardown do
+    ENV["VAPID_PUBLIC_KEY"] = @previous_public
+    ENV["VAPID_PRIVATE_KEY"] = @previous_private
+  end
+
+  test "turning push notifications on and off from notification settings" do
+    install_push_api_stubs(permission: "default")
+
+    page.execute_script("Turbo.visit(arguments[0])", notifications_settings_path)
+
+    assert_selector ".notifications__off-message", text: "Push notifications are off"
+    assert_no_selector ".notifications--on"
+
+    find("label[for='push_notifications']").click
+
+    assert_selector ".notifications--on"
+    assert_selector ".notifications__on-message", text: "Push notifications are on"
+
+    subscription = @user.push_subscriptions.reload.last
+    assert_not_nil subscription
+    assert_equal "https://push.example.com/sub/system-test", subscription.endpoint
+    assert_equal "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM", subscription.p256dh_key
+    assert_equal "tBHItJI5svbpez7KI4CCXg", subscription.auth_key
+
+    find("label[for='push_notifications']").click
+
+    assert_no_selector ".notifications--on"
+    assert_selector ".notifications__off-message", text: "Push notifications are off"
+    assert_equal 0, @user.push_subscriptions.reload.count
+  end
+
+  test "shows help copy when browser blocks notifications" do
+    install_push_api_stubs(permission: "denied")
+
+    page.execute_script("Turbo.visit(arguments[0])", notifications_settings_path)
+
+    assert_selector "[data-notifications-target='explainer']", visible: true
+    assert_selector "[data-notifications-target='blocked']", text: "Notifications are blocked"
+    assert_selector "[data-notifications-target='details']", visible: true
+    assert find("#push_notifications", visible: :all).disabled?
+  end
+
+  private
+    def install_push_api_stubs(permission:)
+      page.execute_script(<<~JS, permission)
+        const initialPermission = arguments[0];
+        let currentPermission = initialPermission;
+        let currentSubscription = null;
+
+        const fakeSubscription = {
+          endpoint: "https://push.example.com/sub/system-test",
+          options: {},
+          toJSON() {
+            return {
+              endpoint: this.endpoint,
+              keys: {
+                p256dh: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+                auth: "tBHItJI5svbpez7KI4CCXg"
+              }
+            };
+          },
+          async unsubscribe() {
+            currentSubscription = null;
+            return true;
+          }
+        };
+
+        const fakeRegistration = {
+          pushManager: {
+            async getSubscription() {
+              return currentSubscription;
+            },
+            async subscribe() {
+              currentSubscription = fakeSubscription;
+              return fakeSubscription;
+            }
+          }
+        };
+
+        Object.defineProperty(window, "Notification", {
+          configurable: true,
+          value: {
+            get permission() { return currentPermission; },
+            async requestPermission() {
+              if (currentPermission === "default") currentPermission = "granted";
+              return currentPermission;
+            }
+          }
+        });
+
+        Object.defineProperty(window, "PushManager", {
+          configurable: true,
+          value: function PushManager() {}
+        });
+
+        Object.defineProperty(navigator, "serviceWorker", {
+          configurable: true,
+          value: {
+            async getRegistration() { return fakeRegistration; },
