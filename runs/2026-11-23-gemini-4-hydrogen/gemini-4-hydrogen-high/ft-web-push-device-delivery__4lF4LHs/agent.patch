+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,68 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit -> { push_later }, unless: :read?
+    after_update_commit -> { push_later }, if: :source_changed_and_unread?
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self) if pushable?
+  end
+
+  def push_now
+    return unless pushable?
+
+    payload = push_payload
+    user.push_subscriptions.find_each do |subscription|
+      subscription.notification(**payload)
+    rescue WebPush::ResponseError, Net::OpenTimeout, Net::ReadTimeout, SocketError, OpenSSL::SSL::SSLError => error
+      Rails.error.report(error, handled: true)
+    end
+  end
+
+  private
+    def source_changed_and_unread?
+      !read? && source_id_previously_changed?
+    end
+
+    def pushable?
+      !read? && source.present? && card.present? && user.active? && !user.system? && account.active? && user.push_subscriptions.exists?
+    end
+
+    def push_payload
+      {
+        title: push_title,
+        body: push_body,
+        path: push_path,
+        badge: user.notifications.unread.count
+      }
+    end
+
+    def push_title
+      case source
+      when Event
+        ApplicationController.helpers.event_notification_title(source)
+      when Mention
+        "#{source.mentioner.first_name} @mentioned you"
+      end
+    end
+
+    def push_body
+      case source
+      when Event
+        ApplicationController.helpers.event_notification_body(source)
+      when Mention
+        source.source.mentionable_content.truncate(200)
+      end
+    end
+
+    def push_path
+      case notifiable_target
+      when Comment
+        Rails.application.routes.url_helpers.card_path(card, script_name: account.slug, anchor: ActionView::RecordIdentifier.dom_id(notifiable_target))
+      else
+        Rails.application.routes.url_helpers.card_path(card, script_name: account.slug)
+      end
+    end
+end
