@@ -0,0 +1,142 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    @other_user = users(:kevin)
+    sign_in_as @user
+  end
+
+  test "create registers a push subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/123",
+          p256dh_key: "p256dh_test_key",
+          auth_key: "auth_test_key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/sub/123", subscription.endpoint
+    assert_equal "p256dh_test_key", subscription.p256dh_key
+    assert_equal "auth_test_key", subscription.auth_key
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create works with form-encoded params" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/form",
+          p256dh_key: "p256dh_form_key",
+          auth_key: "auth_form_key"
+        }
+      }
+    end
+
+    assert_response :created
+  end
+
+  test "create updates existing subscription for same user and endpoint" do
+    existing = Push::Subscription.create!(
+      user: @user,
+      endpoint: "https://push.example.com/sub/same",
+      p256dh_key: "old_p256dh",
+      auth_key: "old_auth"
+    )
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/same",
+          p256dh_key: "new_p256dh",
+          auth_key: "new_auth"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "new_p256dh", existing.reload.p256dh_key
+    assert_equal "new_auth", existing.auth_key
+  end
+
+  test "create forbids registering subscription for another user" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@other_user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/123",
+          p256dh_key: "p256dh_test_key",
+          auth_key: "auth_test_key"
+        }
+      }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create requires authentication" do
+    sign_out
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/123",
+          p256dh_key: "p256dh_test_key",
+          auth_key: "auth_test_key"
+        }
+      }, as: :json
+    end
+
+    assert_response :redirect
+  end
+
+  test "create rejects invalid endpoint" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "not-a-url",
+          p256dh_key: "p256dh_test_key",
+          auth_key: "auth_test_key"
+        }
+      }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy deletes subscription by id" do
+    subscription = Push::Subscription.create!(
+      user: @user,
+      endpoint: "https://push.example.com/sub/delete",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy deletes subscription by endpoint on unsubscribe" do
+    subscription = Push::Subscription.create!(
+      user: @user,
+      endpoint: "https://push.example.com/sub/unsubscribe",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, "unsubscribe"),
+        params: { endpoint: subscription.endpoint },
+        as: :json
+    end
+
+    assert_response :no_content
+  end
+end
