@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @subscription = Push::Subscription.create!(
+      user: @user,
+      endpoint: "https://push.example.com/subscriptions/abc123",
+      p256dh_key: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+      auth_key: "tBHItJI5svbpez7KI4CCXg"
+    )
+    @vapid_keys = WebPush.generate_key
+  end
+
+  test "validates endpoint, p256dh_key, and auth_key" do
+    subscription = Push::Subscription.new(user: @user)
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "can't be blank"
+    assert_includes subscription.errors[:p256dh_key], "can't be blank"
+    assert_includes subscription.errors[:auth_key], "can't be blank"
+
+    subscription = Push::Subscription.new(
+      user: @user,
+      endpoint: "ftp://push.example.com/123",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "must be a valid HTTP or HTTPS URL"
+
+    subscription.endpoint = "not a url"
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "not a URL"
+  end
+
+  test "notification sends encrypted web push payload when VAPID keys are configured" do
+    switch_env("VAPID_PUBLIC_KEY" => @vapid_keys.public_key, "VAPID_PRIVATE_KEY" => @vapid_keys.private_key) do
+      WebPush.expects(:payload_send).with do |args|
+        payload = JSON.parse(args[:message])
+        args[:endpoint] == @subscription.endpoint &&
+          args[:p256dh] == @subscription.p256dh_key &&
+          args[:auth] == @subscription.auth_key &&
+          args[:vapid][:public_key] == @vapid_keys.public_key &&
+          args[:vapid][:private_key] == @vapid_keys.private_key &&
+          payload["title"] == "RE: Layout" &&
+          payload.dig("options", "body") == "Looks great!" &&
+          payload.dig("options", "data", "path") == "/123/cards/1"
+      end
+
+      @subscription.notification(title: "RE: Layout", body: "Looks great!", path: "/123/cards/1")
+    end
+  end
+
+  test "notification does nothing when VAPID keys are missing" do
+    switch_env("VAPID_PUBLIC_KEY" => nil, "VAPID_PRIVATE_KEY" => nil) do
+      WebPush.expects(:payload_send).never
+      @subscription.notification(title: "RE: Layout", body: "Looks great!", path: "/123/cards/1")
+    end
+  end
+
+  test "notification destroys subscription on ExpiredSubscription" do
+    switch_env("VAPID_PUBLIC_KEY" => @vapid_keys.public_key, "VAPID_PRIVATE_KEY" => @vapid_keys.private_key) do
+      response = stub(inspect: "410 Gone", body: "")
+      WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.com"))
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        @subscription.notification(title: "Test", body: "Body", path: "/123/cards/1")
+      end
+    end
+  end
+
+  test "notification destroys subscription on InvalidSubscription" do
+    switch_env("VAPID_PUBLIC_KEY" => @vapid_keys.public_key, "VAPID_PRIVATE_KEY" => @vapid_keys.private_key) do
+      response = stub(inspect: "404 Not Found", body: "")
+      WebPush.stubs(:payload_send).raises(WebPush::InvalidSubscription.new(response, "push.example.com"))
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        @subscription.notification(title: "Test", body: "Body", path: "/123/cards/1")
+      end
+    end
+  end
+
+  private
+    def switch_env(vars)
+      previous = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      previous.each { |key, value| ENV[key] = value }
+    end
+end
