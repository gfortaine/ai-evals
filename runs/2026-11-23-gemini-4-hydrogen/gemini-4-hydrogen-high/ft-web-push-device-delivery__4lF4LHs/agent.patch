@@ -0,0 +1,40 @@
+module Push
+  def self.table_name_prefix
+    "push_"
+  end
+
+  def self.public_key
+    ENV["VAPID_PUBLIC_KEY"].presence ||
+      Rails.configuration.x.vapid.public_key.presence ||
+      Rails.application.credentials.dig(:vapid, :public_key)
+  end
+
+  def self.private_key
+    ENV["VAPID_PRIVATE_KEY"].presence ||
+      Rails.configuration.x.vapid.private_key.presence ||
+      Rails.application.credentials.dig(:vapid, :private_key)
+  end
+
+  def self.configured?
+    public_key.present? && private_key.present?
+  end
+
+  def self.vapid_options
+    {
+      subject: vapid_subject,
+      public_key: public_key,
+      private_key: private_key
+    }
+  end
+
+  def self.vapid_subject
+    ENV["VAPID_SUBJECT"].presence || "mailto:#{default_contact_email}"
+  end
+
+  private_class_method def self.default_contact_email
+    from = ENV.fetch("MAILER_FROM_ADDRESS", "support@fizzy.do")
+    Mail::Address.new(from).address
+  rescue Mail::Field::ParseError
+    "support@fizzy.do"
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..1321394
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,49 @@
+class Push::Subscription < ApplicationRecord
+  PERMITTED_SCHEMES = %w[ http https ].freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :validate_endpoint
+
+  def notification(title:, body:, path:, badge: nil)
+    return unless Push.configured?
+
+    WebPush.payload_send(
+      message: notification_payload(title:, body:, path:, badge:),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: Push.vapid_options,
+      open_timeout: 5,
+      read_timeout: 5
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def notification_payload(title:, body:, path:, badge:)
+      {
+        title: title,
+        options: {
+          body: body,
+          icon: "/app-icon-192.png",
+          data: { path: path, badge: badge }.compact
+        }
+      }.to_json
+    end
+
+    def validate_endpoint
+      return if endpoint.blank?
+
+      uri = URI.parse(endpoint)
+
+      if PERMITTED_SCHEMES.exclude?(uri.scheme) || uri.host.blank?
+        errors.add :endpoint, "must be a valid HTTP or HTTPS URL"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "not a URL"
+    end
+end
