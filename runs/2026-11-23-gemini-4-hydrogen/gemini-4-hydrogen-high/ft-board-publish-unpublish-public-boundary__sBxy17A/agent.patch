diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..2aec3bc
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_not @board.publicly_accessible?
+    assert_nil @board.publication
+  end
+
+  test "publish creates a publication with a secret key" do
+    publication = @board.publish
+
+    assert @board.published?
+    assert @board.publicly_accessible?
+    assert_equal @board, publication.board
+    assert_equal @board.account, publication.account
+    assert publication.key.present?
+    assert_equal publication.key, publication.to_param
+  end
+
+  test "publish is idempotent" do
+    first_publication = @board.publish
+    second_publication = @board.publish
+
+    assert_equal first_publication, second_publication
+    assert_equal first_publication.key, second_publication.key
+  end
+
+  test "unpublish destroys the publication" do
+    @board.publish
+    assert @board.published?
+
+    @board.unpublish
+
+    assert_not @board.published?
+    assert_not @board.publicly_accessible?
+    assert_nil @board.publication
+    assert_not Board::Publication.exists?(board_id: @board.id)
+  end
+
+  test "unpublish is a no-op when not published" do
+    assert_nothing_raised { @board.unpublish }
+    assert_not @board.published?
+  end
+
+  test "find_by_published_key! finds published board and raises for invalid key" do
+    publication = @board.publish
+
+    assert_equal @board, Board.find_by_published_key!(publication.key)
+
+    @board.unpublish
+    assert_raises(ActiveRecord::RecordNotFound) do
+      Board.find_by_published_key!(publication.key)
+    end
+  end
+
+  test "published scope returns only published boards" do
+    assert_not_includes Board.published, @board
+
+    @board.publish
+    assert_includes Board.published, @board
+  end
+
+  test "card and comment publicly_accessible? require published card and published board" do
+    published_card = cards(:logo)
+    drafted_card = @board.cards.create!(creator: users(:kevin), title: "Draft card", status: "drafted")
+    comment = comments(:logo_1)
+
+    assert_not published_card.publicly_accessible?
+    assert_not drafted_card.publicly_accessible?
+    assert_not comment.publicly_accessible?
+
+    @board.publish
+
+    assert published_card.reload.publicly_accessible?
+    assert_not drafted_card.reload.publicly_accessible?
+    assert comment.reload.publicly_accessible?
+
+    @board.unpublish
+
+    assert_not published_card.reload.publicly_accessible?
+    assert_not comment.reload.publicly_accessible?
+  end
+end
