+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.publish
+  end
+
+  test "show renders published card of published board without authentication" do
+    card = cards(:text)
+
+    get public_board_card_path(@publication, card)
+
+    assert_response :success
+    assert_in_body card.title
+  end
+
+  test "show renders card with steps, tags, comments, and reactions" do
+    card = cards(:logo)
+    card.steps.create!(content: "Test step", completed: true)
+
+    get public_board_card_path(@publication, card)
+
+    assert_response :success
+    assert_select "h1.card__title", text: /The logo isn't big enough/
+    assert_in_body "Test step"
+    assert_in_body comments(:logo_1).body.to_plain_text
+  end
+
+  test "show renders closed and postponed published cards" do
+    Current.set(user: users(:kevin)) do
+      closed_card = cards(:buy_domain)
+      closed_card.close(user: users(:kevin))
+
+      get public_board_card_path(@publication, closed_card)
+      assert_response :success
+      assert_in_body "Done"
+
+      postponed_card = cards(:shipping)
+      postponed_card.postpone(user: users(:kevin))
+
+      get public_board_card_path(@publication, postponed_card)
+      assert_response :success
+      assert_in_body "Not Now"
+    end
+  end
+
+  test "show returns not found for drafted card on published board" do
+    drafted_card = @board.cards.create!(creator: users(:kevin), title: "Secret draft", status: "drafted")
+    assert drafted_card.drafted?
+
+    get public_board_card_path(@publication, drafted_card)
+    assert_response :not_found
+  end
+
+  test "show returns not found for card belonging to a different board" do
+    other_board = boards(:private)
+    other_card = Current.set(user: users(:kevin)) do
+      other_board.cards.create!(creator: users(:kevin), title: "Private board card", status: "published")
+    end
+
+    get public_board_card_path(@publication, other_card)
+    assert_response :not_found
+  end
+
+test "show renders card with image attachment" do
+  card = cards(:logo)
+  Current.with(account: @board.account, session: sessions(:david)) do
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+  end
+
+  get public_board_card_path(@publication, card)
+  assert_response :success
+  assert_select "img[src*='moon.jpg']"
+end
+
+test "show returns not found when board is unpublished" do
+    key = @publication.key
+    @board.unpublish
+
+    get public_board_card_path(key, cards(:logo))
+    assert_response :not_found
+  end
+end
