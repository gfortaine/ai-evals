new file mode 100644
index 0000000..78db80f
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,29 @@
+<%= turbo_frame_tag board, :publication do %>
+  <section class="settings__section">
+    <header>
+      <h2 class="divider">Public link</h2>
+      <div>Share a read-only link to this board with anyone on the web.</div>
+    </header>
+
+    <div class="flex align-center gap-half">
+      <%= form_with url: board_publication_path(board), method: board.published? ? :delete : :post, data: { controller: "form" } do %>
+        <label class="switch">
+          <%= check_box_tag :published, "1", board.published?, class: "switch__input",
+                disabled: !Current.user.can_administer_board?(board),
+                data: { action: "change->form#submit" } %>
+          <span class="switch__btn round"></span>
+          <span class="for-screen-reader">Publish this board</span>
+        </label>
+      <% end %>
+
+      <% if board.published? %>
+        <% url = public_board_url(board.publication) %>
+        <input type="text" class="input flex-item-grow" value="<%= url %>" readonly>
+        <%= button_to_copy_to_clipboard(url) do %>
+          <%= icon_tag "copy-paste" %>
+          <span class="for-screen-reader">Copy public link</span>
+        <% end %>
+      <% end %>
+    </div>
+  </section>
+<% end %>
