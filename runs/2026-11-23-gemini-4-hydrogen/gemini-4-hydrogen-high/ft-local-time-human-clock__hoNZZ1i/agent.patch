diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..14eec23
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,152 @@
+import { Controller } from "@hotwired/stimulus"
+import {
+  signedDifferenceInDays,
+  formatTime,
+  formatDate,
+  formatShortDate,
+  formatWeekdayDate,
+  formatDateTime,
+  formatFullDateTime
+} from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute
+const activeControllers = new Set()
+let refreshTimer = null
+
+function startRefreshTimer() {
+  if (!refreshTimer) {
+    refreshTimer = setInterval(refreshAll, REFRESH_INTERVAL)
+    document.addEventListener("visibilitychange", handleVisibilityChange)
+  }
+}
+
+function stopRefreshTimer() {
+  if (refreshTimer && activeControllers.size === 0) {
+    clearInterval(refreshTimer)
+    refreshTimer = null
+    document.removeEventListener("visibilitychange", handleVisibilityChange)
+  }
+}
+
+function handleVisibilityChange() {
+  if (!document.hidden) refreshAll()
+}
+
+function refreshAll() {
+  for (const controller of activeControllers) {
+    controller.refresh()
+  }
+}
+
+export default class extends Controller {
+  static values = {
+    style: { type: String, default: "agoorago" }
+  }
+
+  #observer
+
+  connect() {
+    activeControllers.add(this)
+    startRefreshTimer()
+    this.refresh()
+    this.#observeMutations()
+  }
+
+  disconnect() {
+    this.#observer?.disconnect()
+    activeControllers.delete(this)
+    stopRefreshTimer()
+  }
+
+  styleValueChanged() {
+    this.refresh()
+  }
+
+  refresh() {
+    const date = this.#date
+    if (!date) return
+
+    const formatted = this.#format(date)
+    if (this.element.textContent !== formatted) {
+      this.element.textContent = formatted
+    }
+
+    const title = formatFullDateTime(date)
+    if (this.element.title !== title) {
+      this.element.title = title
+    }
+  }
+
+  get #date() {
+    const attr = this.element.getAttribute("datetime")
+    if (!attr) return null
+
+    const date = new Date(attr)
+    return isNaN(date.getTime()) ? null : date
+  }
+
+  #observeMutations() {
+    this.#observer = new MutationObserver(() => this.refresh())
+    this.#observer.observe(this.element, {
+      attributes: true,
+      attributeFilter: [ "datetime", "data-local-time-style-value" ],
+      childList: true
+    })
+  }
+
+  #format(date) {
+    const now = new Date()
+
+    switch (this.styleValue) {
+      case "time":
+        return formatTime(date)
+      case "date":
+        return formatDate(date)
+      case "shortdate":
+        return formatShortDate(date, now)
+      case "weekdaydate":
+        return formatWeekdayDate(date)
+      case "datetime":
+        return formatDateTime(date)
+      case "indays":
+        return this.#formatInDays(date, now)
+      case "agoorago":
+      default:
+        return this.#formatAgoOrAgo(date, now)
+    }
+  }
+
+  #formatInDays(date, now) {
+    const daysDiff = signedDifferenceInDays(now, date)
+
+    if (daysDiff <= 0) {
+      return "today"
+    } else if (daysDiff === 1) {
+      return "tomorrow"
+    } else {
+      return `in ${daysDiff} days`
+    }
+  }
+
+  #formatAgoOrAgo(date, now) {
+    const daysDiff = signedDifferenceInDays(now, date)
+
+    if (daysDiff > 1) {
+      return `in ${daysDiff} days`
+    } else if (daysDiff === 1) {
+      return "tomorrow"
+    } else if (daysDiff === 0) {
+      if (date.getTime() - now.getTime() > 60_000) {
+        return "today"
+      } else {
+        return formatTime(date)
+      }
+    } else if (daysDiff === -1) {
+      return "yesterday"
+    } else if (daysDiff >= -6) {
+      return `${Math.abs(daysDiff)} days ago`
+    } else {
+      return formatShortDate(date, now)
+    }
+  }
+}
