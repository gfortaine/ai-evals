+
+  test "destroy is allowed for editors" do
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(books(:handbook))
+    end
+
+    assert_redirected_to root_path
+  end
+
+  test "destroy is allowed for administrators" do
+    sign_in :david
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(books(:handbook))
+    end
+
+    assert_redirected_to root_path
+  end
+
+  test "destroy is forbidden for readers" do
+    sign_in :jz
