+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @vapid = WebPush.generate_key
+    @subscription_keys = WebPush.generate_key
+    @auth_key = Base64.urlsafe_encode64(Random.bytes(16))
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/123",
+      p256dh_key: @subscription_keys.public_key,
+      auth_key: @auth_key
+    )
+  end
+
+  test "validates presence of required attributes" do
+    subscription = Push::Subscription.new(user: @user)
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "can't be blank"
+    assert_includes subscription.errors[:p256dh_key], "can't be blank"
+    assert_includes subscription.errors[:auth_key], "can't be blank"
+  end
+
+  test "notification sends encrypted web push request when VAPID keys are configured" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 201)
+
+    with_vapid_keys(@vapid.public_key, @vapid.private_key) do
+      @subscription.notification(title: "New comment", body: "Hello!", path: "/123/cards/1", badge: 3)
+    end
+
+    assert_requested :post, @subscription.endpoint do |req|
+      assert req.headers["Authorization"].start_with?("vapid ")
+      assert_equal "aes128gcm", req.headers["Content-Encoding"]
+      assert_equal "application/octet-stream", req.headers["Content-Type"]
+    end
+  end
+
+  test "notification does nothing when VAPID keys are not configured" do
+    WebPush.expects(:payload_send).never
+
+    with_vapid_keys(nil, nil) do
+      @subscription.notification(title: "New comment", body: "Hello!", path: "/123/cards/1")
+    end
+  end
+
+  test "notification destroys expired subscription on 410 Gone" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 410)
+
+    with_vapid_keys(@vapid.public_key, @vapid.private_key) do
+      assert_difference -> { Push::Subscription.count }, -1 do
+        @subscription.notification(title: "New comment", body: "Hello!", path: "/123/cards/1")
+      end
+    end
+  end
+
+  test "notification destroys invalid subscription on 404 Not Found" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 404)
+
+    with_vapid_keys(@vapid.public_key, @vapid.private_key) do
+      assert_difference -> { Push::Subscription.count }, -1 do
+        @subscription.notification(title: "New comment", body: "Hello!", path: "/123/cards/1")
+      end
+    end
+  end
+
+  test "notification handles transient push service errors gracefully" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 503)
+
+    with_vapid_keys(@vapid.public_key, @vapid.private_key) do
+      assert_no_difference -> { Push::Subscription.count } do
+        assert_nothing_raised do
+          @subscription.notification(title: "New comment", body: "Hello!", path: "/123/cards/1")
+        end
+      end
+    end
+  end
+
+  private
+    def with_vapid_keys(public_key, private_key)
+      old_pub, old_priv = ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"]
+      ENV["VAPID_PUBLIC_KEY"] = public_key
+      ENV["VAPID_PRIVATE_KEY"] = private_key
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = old_pub
+      ENV["VAPID_PRIVATE_KEY"] = old_priv
+    end
+end
