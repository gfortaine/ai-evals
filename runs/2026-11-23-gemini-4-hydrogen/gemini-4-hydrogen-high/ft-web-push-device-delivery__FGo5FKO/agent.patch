+module Push
+  def self.table_name_prefix
+    "push_"
+  end
+
+  def self.vapid_public_key
+    ENV["VAPID_PUBLIC_KEY"].presence
+  end
+
+  def self.vapid_private_key
+    ENV["VAPID_PRIVATE_KEY"].presence
+  end
+
+  def self.vapid_subject
+    ENV.fetch("VAPID_SUBJECT") do
+      from = ENV.fetch("MAILER_FROM_ADDRESS", "support@fizzy.do")
+      email = from[/<([^>]+)>/, 1] || from
+      "mailto:#{email}"
+    end
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..c99b8b0
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,36 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  def notification(title:, body:, path:, badge: nil)
+    return unless Push.vapid_public_key && Push.vapid_private_key
+
+    WebPush.payload_send(
+      message: {
+        title: title,
+        options: {
+          body: body,
+          icon: "/app-icon-192.png",
+          data: {
+            path: path,
+            badge: badge
+          }.compact
+        }
+      }.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: {
+        subject: Push.vapid_subject,
+        public_key: Push.vapid_public_key,
+        private_key: Push.vapid_private_key
+      }
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPush::Error, Timeout::Error, IOError, SocketError, SystemCallError, OpenSSL::OpenSSLError => e
+    Rails.logger.warn("WebPush delivery failed for Push::Subscription #{id}: #{e.class} - #{e.message}")
+  end
+end
