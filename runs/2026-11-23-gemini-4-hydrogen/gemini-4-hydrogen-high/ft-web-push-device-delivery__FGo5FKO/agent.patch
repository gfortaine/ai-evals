@@ -0,0 +1,98 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:david)
+    @vapid = WebPush.generate_key
+    @old_pub, @old_priv = ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"]
+    ENV["VAPID_PUBLIC_KEY"] = @vapid.public_key
+    ENV["VAPID_PRIVATE_KEY"] = @vapid.private_key
+    sign_in_as @user
+  end
+
+  teardown do
+    ENV["VAPID_PUBLIC_KEY"] = @old_pub
+    ENV["VAPID_PRIVATE_KEY"] = @old_priv
+  end
+
+  test "shows help instructions when notifications are denied" do
+    visit notifications_settings_path
+
+    assert_selector "[data-notifications-target='switch']:not([disabled])", visible: :all
+    assert_text "Push notifications are off for this device."
+
+    # Headless Chrome runs with --deny-permission-prompts so clicking triggers requestPermission() -> "denied"
+    find("label.switch", match: :first).click
+
+    assert_selector ".notifications-help", visible: true
+    assert_text "Push notifications are blocked for this site."
+    assert_selector "[data-notifications-target='switch'][disabled]", visible: :all
+  end
+
+  test "enabling and disabling push notifications subscribes and unsubscribes the device" do
+    visit notifications_settings_path
+
+    assert_selector "[data-notifications-target='switch']:not([disabled])", visible: :all
+
+    # Stub browser Notification & PushManager APIs in the page and re-connect the controller
+    page.execute_script(<<~JS)
+      let currentSubscription = null
+      const endpoint = "https://push.example.com/sub/system-test"
+      const p256dh = "#{WebPush.generate_key.public_key}"
+      const auth = "#{Base64.urlsafe_encode64(Random.bytes(16))}"
+
+      Object.defineProperty(window, "Notification", {
+        configurable: true,
+        value: {
+          permission: "default",
+          requestPermission: async () => "granted"
+        }
+      })
+
+      const fakeRegistration = {
+        pushManager: {
+          getSubscription: async () => currentSubscription,
+          subscribe: async () => {
+            currentSubscription = {
+              endpoint,
+              toJSON: () => ({ endpoint, keys: { p256dh, auth } }),
+              unsubscribe: async () => { currentSubscription = null; return true }
+            }
+            return currentSubscription
+          }
+        }
+      }
+
+      Object.defineProperty(navigator, "serviceWorker", {
+        configurable: true,
+        value: {
+          getRegistration: async () => fakeRegistration,
+          register: async () => fakeRegistration,
+          ready: Promise.resolve(fakeRegistration)
+        }
+      })
+
+      const section = document.querySelector("[data-controller='notifications']")
+      section.removeAttribute("data-controller")
+      setTimeout(() => section.setAttribute("data-controller", "notifications"), 0)
+    JS
+
+    assert_selector "[data-notifications-target='switch']:not([disabled])", visible: :all
+    assert_text "Push notifications are off for this device."
+
+    find("label.switch", match: :first).click
+
+    assert_selector ".notifications--on"
+    assert_text "Push notifications are on for this device."
+
+    subscription = @user.push_subscriptions.reload.last
+    assert_not_nil subscription
+    assert_equal "https://push.example.com/sub/system-test", subscription.endpoint
+
+    find("label.switch", match: :first).click
+
+    assert_no_selector ".notifications--on"
+    assert_text "Push notifications are off for this device."
+    assert_equal 0, @user.push_subscriptions.reload.count
+  end
+end
