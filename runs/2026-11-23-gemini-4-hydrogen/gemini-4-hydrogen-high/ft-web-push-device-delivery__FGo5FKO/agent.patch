@@ -0,0 +1,150 @@
+require "test_helper"
+
+class Notification::PushingTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @david = users(:david)
+    @vapid = WebPush.generate_key
+    @sub_keys = WebPush.generate_key
+    @subscription = @kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/kevin",
+      p256dh_key: @sub_keys.public_key,
+      auth_key: Base64.urlsafe_encode64(Random.bytes(16))
+    )
+  end
+
+  test "creating a notification enqueues PushJob when user has subscriptions" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    end
+  end
+
+  test "creating a notification does not enqueue PushJob when user has no subscriptions" do
+    @kevin.push_subscriptions.delete_all
+    notifications(:layout_commented_kevin).destroy
+
+    assert_no_enqueued_jobs(only: Notification::PushJob) do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    end
+  end
+
+  test "pushes comment event with tray title, body, and card comment path" do
+    notifications(:layout_commented_kevin).destroy
+    event = events(:layout_commented)
+    expected_path = "/#{@kevin.account.external_account_id}/cards/#{cards(:layout).number}##{ActionView::RecordIdentifier.dom_id(event.eventable)}"
+
+    received_payloads = []
+    Push::Subscription.any_instance.stubs(:notification).with do |**kwargs|
+      received_payloads << kwargs
+      true
+    end
+
+    perform_enqueued_jobs do
+      Notification.create!(user: @kevin, source: event, creator: @david)
+    end
+
+    assert_equal 1, received_payloads.size
+    payload = received_payloads.first
+    assert_equal "RE: #{cards(:layout).title}", payload[:title]
+    assert_equal event.eventable.body.to_plain_text.truncate(200), payload[:body]
+    assert_equal expected_path, payload[:path]
+    assert_operator payload[:badge], :>=, 1
+  end
+
+  test "pushes card event with tray title, body, and card path" do
+    notifications(:logo_assignment_kevin).destroy
+    event = events(:logo_assignment_km)
+    expected_path = "/#{@kevin.account.external_account_id}/cards/#{cards(:logo).number}"
+
+    received_payloads = []
+    Push::Subscription.any_instance.stubs(:notification).with do |**kwargs|
+      received_payloads << kwargs
+      true
+    end
+
+    perform_enqueued_jobs do
+      Notification.create!(user: @kevin, source: event, creator: @david)
+    end
+
+    assert_equal 1, received_payloads.size
+    payload = received_payloads.first
+    assert_equal cards(:logo).title, payload[:title]
+    assert_equal "Assigned to Kevin", payload[:body]
+    assert_equal expected_path, payload[:path]
+  end
+
+  test "pushes mention notification with tray title, body, and card path" do
+    mention = mentions(:logo_card_david_mention_by_jz)
+    @david.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/david",
+      p256dh_key: @sub_keys.public_key,
+      auth_key: Base64.urlsafe_encode64(Random.bytes(16))
+    )
+    notifications(:logo_mentioned_david).destroy
+
+    received_payloads = []
+    Push::Subscription.any_instance.stubs(:notification).with do |**kwargs|
+      received_payloads << kwargs
+      true
+    end
+
+    perform_enqueued_jobs do
+      Notification.create!(user: @david, source: mention, creator: users(:jz))
+    end
+
+    assert_equal 1, received_payloads.size
+    payload = received_payloads.first
+    assert_equal "JZ @mentioned you", payload[:title]
+    assert_equal mention.source.mentionable_content.truncate(200), payload[:body]
+    assert_equal "/#{@david.account.external_account_id}/cards/#{cards(:logo).number}", payload[:path]
+  end
+
+  test "updating an existing notification with a new source enqueues a push" do
+    notifications(:layout_commented_kevin).destroy
+    notification = notifications(:logo_assignment_kevin)
+    notification.read
+
+    assert_enqueued_with(job: Notification::PushJob, args: [ notification ]) do
+      notification.source_type_will_change!
+      notification.update!(source: events(:layout_commented), creator: @david, read_at: nil, unread_count: 1)
+    end
+  end
+
+  test "marking a notification as read or unread does not enqueue a push" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_enqueued_jobs(only: Notification::PushJob) do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "pushes to all registered devices for the user" do
+    @kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/kevin-phone",
+      p256dh_key: @sub_keys.public_key,
+      auth_key: Base64.urlsafe_encode64(Random.bytes(16))
+    )
+    notifications(:layout_commented_kevin).destroy
+
+    WebPush.expects(:payload_send).twice
+    old_pub, old_priv = ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"]
+    ENV["VAPID_PUBLIC_KEY"] = @vapid.public_key
+    ENV["VAPID_PRIVATE_KEY"] = @vapid.private_key
+
+    perform_enqueued_jobs do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    end
+  ensure
+    ENV["VAPID_PUBLIC_KEY"] = old_pub
+    ENV["VAPID_PRIVATE_KEY"] = old_priv
+  end
+
+  test "deactivating user removes push subscriptions" do
+    assert_difference -> { @kevin.push_subscriptions.count }, -1 do
+      @kevin.deactivate
+    end
+  end
+end
