diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..711fd89
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,156 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static targets = [ "switch", "details", "explainer", "offMessage" ]
+  static classes = [ "on" ]
+  static values = {
+    subscriptionsUrl: String,
+    subscriptions: Object,
+    vapidPublicKey: String
+  }
+
+  async connect() {
+    await this.#refresh()
+  }
+
+  async toggle() {
+    this.switchTarget.disabled = true
+
+    try {
+      if (this.switchTarget.checked) {
+        await this.#subscribe()
+      } else {
+        await this.#unsubscribe()
+      }
+    } finally {
+      await this.#refresh()
+    }
+  }
+
+  async #refresh() {
+    if (!this.#isSupported) {
+      this.#setStatus({ on: false, disabled: true, showDetails: false, showExplainer: true, offMessage: "Push notifications aren’t supported in this browser." })
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#setStatus({ on: false, disabled: true, showDetails: true, showExplainer: true, offMessage: "Push notifications are blocked for this site." })
+      return
+    }
+
+    if (!this.#vapidKey) {
+      this.#setStatus({ on: false, disabled: true, showDetails: false, showExplainer: false, offMessage: "Push notifications are not configured for this server." })
+      return
+    }
+
+    const subscription = await this.#getSubscription()
+    const isSubscribed = Boolean(subscription && this.subscriptionsValue[subscription.endpoint])
+
+    this.#setStatus({ on: isSubscribed, disabled: false, showDetails: false, showExplainer: false, offMessage: "Push notifications are off for this device." })
+  }
+
+  #setStatus({ on, disabled, showDetails, showExplainer, offMessage }) {
+    this.switchTarget.checked = on
+    this.switchTarget.disabled = disabled
+    this.element.classList.toggle(this.onClass, on)
+    this.offMessageTarget.textContent = offMessage
+    this.detailsTargets.forEach(detail => detail.hidden = !showDetails)
+    if (this.hasExplainerTarget) {
+      this.explainerTarget.hidden = !showExplainer
+    }
+  }
+
+  async #subscribe() {
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") return
+
+    const registration = await this.#serviceWorkerRegistration()
+    const applicationServerKey = this.#urlBase64ToUint8Array(this.#vapidKey)
+    let subscription = await registration.pushManager.getSubscription()
+
+    if (subscription && !this.#keysEqual(subscription.options?.applicationServerKey, applicationServerKey)) {
+      await subscription.unsubscribe()
+      subscription = null
+    }
+
+    if (!subscription) {
+      subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey
+      })
+    }
+
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+
+    const response = await post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint,
+          p256dh_key: p256dh,
+          auth_key: auth
+        }
+      },
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      const { id } = await response.json
+      this.subscriptionsValue = { ...this.subscriptionsValue, [endpoint]: id }
+    }
+  }
+
+  async #unsubscribe() {
+    const subscription = await this.#getSubscription()
+    if (!subscription) return
+
+    const id = this.subscriptionsValue[subscription.endpoint]
+    if (!id) return
+
+    const response = await destroy(`${this.subscriptionsUrlValue}/${id}`)
+    if (response.ok) {
+      const updated = { ...this.subscriptionsValue }
+      delete updated[subscription.endpoint]
+      this.subscriptionsValue = updated
+    }
+  }
+
+  async #getSubscription() {
+    const registration = await navigator.serviceWorker.getRegistration("/")
+    if (!registration) return null
+
+    return await registration.pushManager.getSubscription()
+  }
+
+  async #serviceWorkerRegistration() {
+    const registration = await navigator.serviceWorker.getRegistration("/")
+    if (!registration) {
+      await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    }
+
+    return await navigator.serviceWorker.ready
+  }
+
+  get #isSupported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get #vapidKey() {
+    return this.vapidPublicKeyValue || getMetaContent("vapid-public-key")
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - base64String.length % 4) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    return Uint8Array.from([ ...rawData ].map(char => char.charCodeAt(0)))
+  }
+
+  #keysEqual(buffer, uint8Array) {
+    if (!buffer) return true
+    const existing = new Uint8Array(buffer)
+    if (existing.length !== uint8Array.length) return false
+    return existing.every((byte, index) => byte === uint8Array[index])
+  }
+}
