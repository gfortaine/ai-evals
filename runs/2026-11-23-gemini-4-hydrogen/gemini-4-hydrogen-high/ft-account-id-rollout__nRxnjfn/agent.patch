+      %i[ comments steps ].each do |table|
+        backfill_from_parent(table, :cards, :card_id, only_null: true)
+        drop_orphans(table)
+      end
+
+      %i[
+        assignments
+        card_activity_spikes
+        card_goldnesses
+        card_not_nows
+        closures
+        pins
+        watches
+        taggings
+      ].each do |table|
+        backfill_from_parent(table, :cards, :card_id, only_null: false)
+      end
+
+      execute <<~SQL
+        UPDATE tags
+        SET account_id = (
+          SELECT taggings.account_id
+          FROM taggings
+          WHERE taggings.tag_id = tags.id
+            AND taggings.account_id IS NOT NULL
+          LIMIT 1
+        )
+        WHERE account_id IS NULL
+      SQL
+      drop_orphans(:tags)
+
+      %i[
+        assignments
+        card_activity_spikes
+        card_goldnesses
+        card_not_nows
+        closures
+        pins
+        watches
+        taggings
+      ].each { |table| drop_orphans(table) }
+
+      execute <<~SQL
+        UPDATE notifications
+        SET account_id = COALESCE(
+          (SELECT users.account_id FROM users WHERE users.id = notifications.user_id),
+          (SELECT cards.account_id FROM cards WHERE cards.id = notifications.card_id)
+        )
+        WHERE account_id IS NULL
+      SQL
+      drop_orphans(:notifications)
+
+      %i[ webhook_delinquency_trackers webhook_deliveries ].each do |table|
+        backfill_from_parent(table, :webhooks, :webhook_id, only_null: false)
+        drop_orphans(table)
+      end
+
+      %i[
+        assignees_filters
+        assigners_filters
+        boards_filters
+        closers_filters
+        creators_filters
+        filters_tags
+      ].each do |table|
+        backfill_from_parent(table, :filters, :filter_id, only_null: false)
+        drop_orphans(table)
+      end
+
+      # Tier 4: Polymorphic children of boards, cards, comments
+      execute <<~SQL
+        UPDATE mentions
+        SET account_id = (SELECT cards.account_id FROM cards WHERE cards.id = mentions.source_id)
+        WHERE source_type = 'Card'
+      SQL
+      execute <<~SQL
+        UPDATE mentions
+        SET account_id = (SELECT comments.account_id FROM comments WHERE comments.id = mentions.source_id)
+        WHERE source_type = 'Comment'
+      SQL
+      drop_orphans(:mentions)
+
+      execute <<~SQL
+        UPDATE reactions
+        SET account_id = (SELECT cards.account_id FROM cards WHERE cards.id = reactions.reactable_id)
+        WHERE reactable_type = 'Card'
+      SQL
+      execute <<~SQL
+        UPDATE reactions
+        SET account_id = (SELECT comments.account_id FROM comments WHERE comments.id = reactions.reactable_id)
+        WHERE reactable_type = 'Comment'
+      SQL
+      drop_orphans(:reactions)
+
+      execute <<~SQL
+        UPDATE action_text_rich_texts
+        SET account_id = (SELECT boards.account_id FROM boards WHERE boards.id = action_text_rich_texts.record_id)
+        WHERE record_type = 'Board'
+      SQL
+      execute <<~SQL
+        UPDATE action_text_rich_texts
+        SET account_id = (SELECT cards.account_id FROM cards WHERE cards.id = action_text_rich_texts.record_id)
+        WHERE record_type = 'Card'
+      SQL
+      execute <<~SQL
+        UPDATE action_text_rich_texts
+        SET account_id = (SELECT comments.account_id FROM comments WHERE comments.id = action_text_rich_texts.record_id)
+        WHERE record_type = 'Comment'
+      SQL
+      drop_orphans(:action_text_rich_texts)
+
+      # Tier 5: ActiveStorage
+      {
+        "Card" => "cards",
+        "User" => "users",
+        "Export" => "exports",
+        "Account::Import" => "account_imports",
+        "ActionText::RichText" => "action_text_rich_texts"
+      }.each do |record_type, parent_table|
+        execute <<~SQL
+          UPDATE active_storage_attachments
+          SET account_id = (SELECT #{parent_table}.account_id FROM #{parent_table} WHERE #{parent_table}.id = active_storage_attachments.record_id)
+          WHERE record_type = '#{record_type}'
+        SQL
+      end
+
+      execute <<~SQL
+        UPDATE active_storage_blobs
+        SET account_id = (
+          SELECT active_storage_attachments.account_id
+          FROM active_storage_attachments
+          WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+            AND active_storage_attachments.account_id IS NOT NULL
+          LIMIT 1
+        )
+      SQL
+
+      backfill_from_parent(:active_storage_variant_records, :active_storage_blobs, :blob_id, only_null: false)
+
+      execute <<~SQL
+        UPDATE active_storage_attachments
+        SET account_id = (
+          SELECT active_storage_variant_records.account_id
+          FROM active_storage_variant_records
+          WHERE active_storage_variant_records.id = active_storage_attachments.record_id
+        )
+        WHERE record_type = 'ActiveStorage::VariantRecord'
+      SQL
+
+      execute <<~SQL
+        UPDATE active_storage_blobs
+        SET account_id = (
+          SELECT active_storage_attachments.account_id
+          FROM active_storage_attachments
+          WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+            AND active_storage_attachments.account_id IS NOT NULL
+          LIMIT 1
+        )
+        WHERE account_id IS NULL
+      SQL
+
+      %i[
+        active_storage_variant_records
+        active_storage_attachments
+        active_storage_blobs
+      ].each { |table| drop_orphans(table) }
+    end
+
+    def backfill_from_parent(table, parent_table, foreign_key, only_null:)
+      condition = only_null ? "WHERE #{table}.account_id IS NULL" : ""
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = (
+          SELECT #{parent_table}.account_id
+          FROM #{parent_table}
+          WHERE #{parent_table}.id = #{table}.#{foreign_key}
+        )
+        #{condition}
+      SQL
+    end
+
+    def drop_orphans(table)
+      execute <<~SQL
+        DELETE FROM #{table}
+        WHERE account_id IS NULL
+           OR NOT EXISTS (SELECT 1 FROM accounts WHERE accounts.id = #{table}.account_id)
+      SQL
+    end
+end
