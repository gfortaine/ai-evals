+require "test_helper"
+
+class MagicLinkMailerTest < ActionMailer::TestCase
+  test "sign_in_instructions includes code in subject and body" do
+    identity = identities(:kevin)
+    magic_link = identity.magic_links.create!
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identity.email_address ], email.to
+    assert_includes email.subject, magic_link.code
+    assert email.html_part.present?, "Email should have HTML part"
+    assert email.text_part.present?, "Email should have text part"
+    assert_includes email.html_part.body.to_s, magic_link.code
+    assert_includes email.text_part.body.to_s, magic_link.code
+    assert_match /15 minutes/i, email.text_part.body.to_s
+  end
+
+  test "sign_in_instructions for sign_up" do
+    identity = identities(:kevin)
+    magic_link = identity.magic_links.create!(purpose: :sign_up)
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_includes email.subject, magic_link.code
+    assert_match /sign-up/i, email.text_part.body.to_s
+  end
+end
