+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "show without pending authentication redirects to new session" do
+    untenanted do
+      get session_magic_link_path
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "show when already signed in without pending authentication redirects to root" do
+    sign_in_as @identity
+
+    untenanted do
+      get session_magic_link_path
+
+      assert_redirected_to root_url
+    end
+  end
+
+  test "show renders code field after requesting sign-in code" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      assert_redirected_to session_magic_link_path
+      follow_redirect!
+
+      assert_response :success
+      assert_select "input[name=code]"
+      assert_in_body @identity.email_address
+    end
+  end
+
+  test "create with valid code signs in and consumes code" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      code = extract_code_from_last_email
+
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+      assert_nil @identity.magic_links.find_by(code: code)
+    end
+  end
+
+  test "create works with lowercase and spaces in code" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      code = extract_code_from_last_email
+      formatted_code = " #{code[0..2].downcase} #{code[3..5].downcase} "
+
+      post session_magic_link_path, params: { code: formatted_code }
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with wrong code does not sign in and allows retry" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      code = extract_code_from_last_email
+
+      post session_magic_link_path, params: { code: "WRONGC" }
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+      assert_equal "Try another code.", flash[:alert]
+
+      post session_magic_link_path, params: { code: code }
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with expired code does not sign in" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      code = extract_code_from_last_email
+
+      travel MagicLink::EXPIRATION_TIME + 1.second
+
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create rejects another identity's code" do
+    other_magic_link = identities(:david).magic_links.create!
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      post session_magic_link_path, params: { code: other_magic_link.code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+      assert MagicLink.exists?(other_magic_link.id)
+    end
+  end
+
+  test "create via JSON" do
+    untenanted do
+      assert_emails 1 do
+        post session_path(format: :json), params: { email_address: @identity.email_address }
+      end
+
+      assert_response :created
+      token = @response.parsed_body["pending_authentication_token"]
+      assert token.present?
+
+      code = extract_code_from_last_email
+
+      post session_magic_link_path(format: :json), params: { code: code, pending_authentication_token: token }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "create with invalid code via JSON" do
+    untenanted do
+      assert_emails 1 do
+        post session_path(format: :json), params: { email_address: @identity.email_address }
+      end
+
+      token = @response.parsed_body["pending_authentication_token"]
+
+      post session_magic_link_path(format: :json), params: { code: "BADCOD", pending_authentication_token: token }
+
+      assert_response :unauthorized
+      assert_equal "Try another code.", @response.parsed_body["message"]
+    end
+  end
+
+  test "create is rate limited" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+
+      Rails.cache.stubs(:increment).returns(11)
+
+      post session_magic_link_path, params: { code: "ABC123" }
+
+      assert_redirected_to session_magic_link_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+
+test "create redirects to return_to_after_authenticating when present" do
+  card = cards(:logo)
+
+  get card_path(card)
+  assert_redirected_to new_session_path(script_name: nil)
+
+  untenanted do
+    assert_emails 1 do
+      post session_path(script_name: nil), params: { email_address: @identity.email_address }
+    end
+
+    code = extract_code_from_last_email
+
+    post session_magic_link_path(script_name: nil), params: { code: code }
+
+    assert_redirected_to card_url(card, script_name: card.account.slug)
+  end
+end
+
+test "abandoned join flow does not interfere with subsequent sign-in" do
+  account = accounts("37s")
+  join_code = account_join_codes(:"37s")
+  mike = identities(:mike)
+
+  assert_emails 1 do
+    post join_path(code: join_code.code, script_name: account.slug), params: { email_address: mike.email_address }
+  end
+
+  untenanted do
+    assert_emails 1 do
+      post session_path(script_name: nil), params: { email_address: mike.email_address }
+    end
+
+    code = extract_code_from_last_email
+
+    assert_no_difference -> { User.count } do
+      post session_magic_link_path(script_name: nil), params: { code: code }
+    end
+
+    assert_redirected_to landing_path(script_name: nil)
+  end
+end
+
+  private
+    def extract_code_from_last_email
+      email = ActionMailer::Base.deliveries.last
+      email.subject[/[0-9A-HJ-KM-NP-TV-Z]{6}/]
+    end
+end
