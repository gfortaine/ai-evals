diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..ebb108e
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "creates a 6-character code with a 15-minute expiration" do
+    freeze_time do
+      magic_link = @identity.magic_links.create!
+
+      assert_equal 6, magic_link.code.length
+      assert_match(/\A[0-9A-HJ-KM-NP-TV-Z]{6}\z/, magic_link.code)
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert magic_link.for_sign_in?
+    end
+  end
+
+  test "active and stale scopes respect 15-minute expiration" do
+    magic_link = @identity.magic_links.create!
+
+    assert_includes MagicLink.active, magic_link
+    assert_not_includes MagicLink.stale, magic_link
+
+    travel 15.minutes - 1.second
+    assert_includes MagicLink.active, magic_link
+    assert_not_includes MagicLink.stale, magic_link
+
+    travel 2.seconds
+    assert_not_includes MagicLink.active, magic_link
+    assert_includes MagicLink.stale, magic_link
+  end
+
+  test "consume finds and destroys active magic link" do
+    magic_link = @identity.magic_links.create!
+
+    assert_equal magic_link, MagicLink.consume(magic_link.code)
+    assert_nil MagicLink.find_by(id: magic_link.id)
+    assert_nil MagicLink.consume(magic_link.code)
+  end
+
+  test "consume normalizes case, whitespace, and lookalike characters" do
+    magic_link = @identity.magic_links.create!(code: "01AB23")
+
+    assert_equal magic_link, MagicLink.consume(" o l a b - 2 3 ")
+  end
+
+  test "consume does not return expired magic links" do
+    magic_link = @identity.magic_links.create!
+
+    travel MagicLink::EXPIRATION_TIME + 1.second
+    assert_nil MagicLink.consume(magic_link.code)
+    assert MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume scoped to identity does not consume another identity's magic link" do
+    other_magic_link = identities(:david).magic_links.create!
+
+    assert_nil @identity.magic_links.consume(other_magic_link.code)
+    assert MagicLink.exists?(other_magic_link.id)
+  end
+
+  test "cleanup removes stale magic links and preserves active ones" do
+    stale_link = @identity.magic_links.create!
+    travel 16.minutes
+    active_link = @identity.magic_links.create!
+
+    MagicLink.cleanup
+
+    assert_not MagicLink.exists?(stale_link.id)
+    assert MagicLink.exists?(active_link.id)
+  end
+
+  test "Identity#send_magic_link creates magic link and sends email" do
+    assert_emails 1 do
+      magic_link = @identity.send_magic_link(for: :sign_up)
+      assert magic_link.persisted?
+      assert magic_link.for_sign_up?
+    end
+  end
+end
