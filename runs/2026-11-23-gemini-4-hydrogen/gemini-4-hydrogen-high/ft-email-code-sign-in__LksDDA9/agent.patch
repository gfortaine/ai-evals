diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..49daca1
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,121 @@
+class Sessions::MagicLinksController < ApplicationController
+  include MagicLinkAuthentication
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 15.minutes, only: :create, with: :rate_limit_exceeded
+  before_action :ensure_email_address_pending_authentication
+
+  layout "public"
+
+  def show
+  end
+
+  def create
+    if magic_link = find_and_consume_magic_link
+      sign_in magic_link
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def ensure_email_address_pending_authentication
+      unless email_address_pending_authentication.present?
+        respond_to do |format|
+          format.html do
+            if authenticated?
+              redirect_to root_url
+            else
+              redirect_to new_session_path, alert: "Enter your email address to sign in."
+            end
+          end
+
+          format.json { render json: { message: "Enter your email address to sign in." }, status: :unauthorized }
+        end
+      end
+    end
+
+    def find_and_consume_magic_link
+      if identity = Identity.find_by(email_address: email_address_pending_authentication)
+        identity.magic_links.consume(code)
+      end
+    end
+
+    def code
+      params[:code]
+    end
+
+    def sign_in(magic_link)
+      clear_pending_authentication_token
+      terminate_session if Current.session
+      start_new_session_for magic_link.identity
+
+      if join_code = consume_pending_join_code
+        complete_join(join_code, magic_link.identity)
+      elsif magic_link.for_sign_up?
+        redirect_after_sign_up
+      else
+        redirect_after_sign_in
+      end
+    end
+
+    def complete_join(join_code, identity)
+      if join_code.active?
+        join_code.redeem_if { |account| identity.join(account) }
+      end
+
+      if user = User.active.find_by(account: join_code.account, identity: identity)
+        user.verify
+
+        respond_to do |format|
+          format.html do
+            if user.setup?
+              redirect_to landing_url(script_name: join_code.account.slug)
+            else
+              redirect_to new_users_join_url(script_name: join_code.account.slug)
+            end
+          end
+
+          format.json { render json: { session_token: session_token } }
+        end
+      else
+        respond_to do |format|
+          format.html { redirect_to join_url(code: join_code.code, script_name: join_code.account.slug) }
+          format.json { render json: { message: "That join code is no longer active." }, status: :gone }
+        end
+      end
+    end
+
+    def redirect_after_sign_up
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path }
+        format.json { render json: { session_token: session_token, requires_signup_completion: true } }
+      end
+    end
+
+    def redirect_after_sign_in
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def invalid_code
+      message = "Try another code."
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
