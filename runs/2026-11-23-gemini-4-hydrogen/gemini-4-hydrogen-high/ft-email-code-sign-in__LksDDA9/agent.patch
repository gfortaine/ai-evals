--- /dev/null
+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,69 @@
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  PENDING_AUTHENTICATION_EXPIRATION = 1.hour
+
+  included do
+    helper_method :email_address_pending_authentication
+  end
+
+  private
+    def redirect_to_session_magic_link(magic_link = nil, email_address: nil)
+      email_address ||= magic_link.identity.email_address
+      token = set_pending_authentication_token(email_address)
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_url(script_name: nil) }
+        format.json { render json: { pending_authentication_token: token }, status: :created }
+      end
+    end
+
+    def set_pending_authentication_token(email_address)
+      pending_authentication_verifier.generate(email_address, expires_in: PENDING_AUTHENTICATION_EXPIRATION).tap do |token|
+        cookies[:pending_authentication_token] = {
+          value: token,
+          path: "/",
+          httponly: true,
+          same_site: :lax,
+          expires: PENDING_AUTHENTICATION_EXPIRATION.from_now
+        }
+      end
+    end
+
+    def clear_pending_authentication_token
+      cookies.delete(:pending_authentication_token, path: "/")
+    end
+
+    def email_address_pending_authentication
+      @email_address_pending_authentication ||= pending_authentication_verifier.verified(pending_authentication_token)
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token] || params[:pending_authentication_token]
+    end
+
+    def pending_authentication_verifier
+      Rails.application.message_verifier(:pending_authentication)
+    end
+
+    def set_pending_join_code(join_code)
+      cookies.signed[:pending_join_code_id] = {
+        value: join_code.id,
+        path: "/",
+        httponly: true,
+        same_site: :lax,
+        expires: PENDING_AUTHENTICATION_EXPIRATION.from_now
+      }
+    end
+
+    def clear_pending_join_code
+      cookies.delete(:pending_join_code_id, path: "/")
+    end
+
+    def consume_pending_join_code
+      if join_code_id = cookies.signed[:pending_join_code_id]
+        clear_pending_join_code
+        Account::JoinCode.find_by(id: join_code_id)
+      end
+    end
+end
