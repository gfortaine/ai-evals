diff --git a/test/controllers/tenant_isolation_test.rb b/test/controllers/tenant_isolation_test.rb
new file mode 100644
index 0000000..12e75c0
--- /dev/null
+++ b/test/controllers/tenant_isolation_test.rb
@@ -0,0 +1,178 @@
+require "test_helper"
+
+class TenantIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+
+    @user_a = User.create!(name: "Alice A", email_address: "alice-a@example.com", password: "secret123456", tenant: @tenant_a)
+    @admin_a = User.create!(name: "Admin A", email_address: "admin-a@example.com", password: "secret123456", role: :administrator, tenant: @tenant_a)
+    @coworker_a = User.create!(name: "Coworker A", email_address: "coworker-a@example.com", password: "secret123456", tenant: @tenant_a)
+
+    @user_b = User.create!(name: "Bob B", email_address: "bob-b@example.com", password: "secret123456", tenant: @tenant_b)
+
+    @book_a = Book.create!(title: "Alpha Guide", tenant: @tenant_a, everyone_access: true)
+    @book_a.update_access(editors: [ @user_a.id ], readers: [])
+    @leaf_a = @book_a.press Page.new(body: "Alpha page body"), title: "Alpha Page"
+    @leaf_a.edit leafable_params: { body: "Alpha page updated" }
+
+    @book_b = Book.create!(title: "Beta Secret", tenant: @tenant_b, everyone_access: true, published: false)
+    @book_b.update_access(editors: [ @user_b.id ], readers: [])
+    @leaf_b = @book_b.press Page.new(body: "Beta page body"), title: "Beta Page"
+    @leaf_b.edit leafable_params: { body: "Beta page updated" }
+    @edit_b = @leaf_b.edits.last
+
+    @published_book_b = Book.create!(title: "Beta Published", tenant: @tenant_b, everyone_access: false, published: true)
+    @published_book_b.update_access(editors: [ @user_b.id ], readers: [])
+    @published_leaf_b = @published_book_b.press Page.new(body: "Published beta body"), title: "Published Beta Page"
+  end
+
+  test "new book created via controller lands in creator's tenant and ignores cross-tenant user ids" do
+    sign_in @user_a
+
+    get new_book_path
+    assert_response :success
+    assert_in_body @coworker_a.name
+    assert_not_in_body @user_b.name
+
+    assert_difference -> { Book.count }, +1 do
+      post books_path, params: {
+        book: { title: "Tenant A Created", everyone_access: false },
+        "editor_ids[]": @user_b.id,
+        "reader_ids[]": @user_b.id
+      }
+    end
+
+    created = Book.order(:id).last
+    assert_equal @tenant_a, created.tenant
+    assert created.editable?(user: @user_a)
+    assert_not created.accesses.exists?(user: @user_b)
+  end
+
+  test "another tenant's books are gone from library even if published or holding an access row" do
+    Access.create!(user: @user_a, book: @book_b, level: :editor)
+    Access.create!(user: @user_a, book: @published_book_b, level: :reader)
+
+    sign_in @user_a
+    get root_path
+
+    assert_response :success
+    assert_in_body "Alpha Guide"
+    assert_not_in_body "Beta Secret"
+    assert_not_in_body "Beta Published"
+  end
+
+  test "another tenant's books, pages, and edit histories answer 404 and user stays signed in" do
+    Access.create!(user: @user_a, book: @book_b, level: :editor)
+    Access.create!(user: @user_a, book: @published_book_b, level: :reader)
+
+    [ @user_a, @admin_a ].each do |actor|
+      sign_in actor
+
+      get book_slug_path(@book_b)
+      assert_response :not_found
+
+      get book_slug_path(@book_b, format: :md)
+      assert_response :not_found
+
+      get book_slug_path(@published_book_b)
+      assert_response :not_found
+
+      get edit_book_path(@book_b)
+      assert_response :not_found
+
+      patch book_path(@book_b), params: { book: { title: "Hijacked" } }
+      assert_response :not_found
+
+      delete book_path(@book_b)
+      assert_response :not_found
+
+      get book_publication_path(@book_b)
+      assert_response :not_found
+
+      get book_bookmark_path(@book_b)
+      assert_response :not_found
+
+      post book_search_path(@book_b), params: { search: "Beta" }
+      assert_response :not_found
+
+      post book_leaves_moves_path(@book_b), params: { id: @leaf_b.id, position: 0 }
+      assert_response :not_found
+
+      get leafable_slug_path(@leaf_b)
+      assert_response :not_found
+
+      get leafable_slug_path(@leaf_b, format: :md)
+      assert_response :not_found
+
+      get leafable_slug_path(@published_leaf_b)
+      assert_response :not_found
+
+      get edit_leafable_path(@leaf_b)
+      assert_response :not_found
+
+      post book_pages_path(@book_b, format: :turbo_stream), params: { leaf: { title: "Injected" }, page: { body: "x" } }
+      assert_response :not_found
+
+      get page_edit_path(@leaf_b, "latest")
+      assert_response :not_found
+
+      get page_edit_path(@leaf_b, @edit_b)
+      assert_response :not_found
+
+      # Stays signed in throughout
+      get book_slug_path(@book_a)
+      assert_response :success
+    end
+  end
+
+  test "within a tenant, own books, page histories, and everyone sharing keep working" do
+    sign_in @coworker_a
+
+    get root_path
+    assert_response :success
+    assert_in_body "Alpha Guide"
+
+    get book_slug_path(@book_a)
+    assert_response :success
+
+    get leafable_slug_path(@leaf_a)
+    assert_response :success
+    assert_in_body "Alpha page updated"
+
+    get page_edit_path(@leaf_a, "latest")
+    assert_response :success
+    assert_in_body "Alpha page body"
+  end
+
+  test "users index still lists everyone on the install" do
+    sign_in @user_a
+
+    get users_path
+    assert_response :success
+    assert_in_body @user_a.name
+    assert_in_body @user_b.name
+    assert_in_body @coworker_a.name
+  end
+
+  test "signed-out visitors see every published book across all tenants" do
+    published_book_a = Book.create!(title: "Alpha Published", tenant: @tenant_a, published: true)
+
+    get root_path
+    assert_response :success
+    assert_in_body "Alpha Published"
+    assert_in_body "Beta Published"
+    assert_not_in_body "Alpha Guide"
+    assert_not_in_body "Beta Secret"
+
+    get book_slug_path(published_book_a)
+    assert_response :success
+
+    get book_slug_path(@published_book_b)
+    assert_response :success
+
+    get leafable_slug_path(@published_leaf_b)
+    assert_response :success
+    assert_in_body "Published beta body"
+  end
+end
