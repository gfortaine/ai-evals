+class AddTenants < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    has_users = select_value("SELECT EXISTS(SELECT 1 FROM users)").to_i == 1
+    has_books = select_value("SELECT EXISTS(SELECT 1 FROM books)").to_i == 1
+
+    if has_users || has_books
+      name = select_value("SELECT name FROM accounts LIMIT 1") || "Default"
+      now = Time.current.utc.strftime("%Y-%m-%d %H:%M:%S.%6N")
+      execute <<~SQL.squish
+        INSERT INTO tenants (name, created_at, updated_at)
+        VALUES (#{quote(name)}, #{quote(now)}, #{quote(now)})
+      SQL
+      tenant_id = select_value("SELECT id FROM tenants ORDER BY id DESC LIMIT 1")
+      execute "UPDATE users SET tenant_id = #{tenant_id.to_i}"
+      execute "UPDATE books SET tenant_id = #{tenant_id.to_i}"
+    end
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+    drop_table :tenants
+  end
+end
