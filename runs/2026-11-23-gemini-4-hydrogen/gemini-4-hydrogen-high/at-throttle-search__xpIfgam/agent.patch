diff --git a/app/controllers/books/searches_controller.rb b/app/controllers/books/searches_controller.rb
index 5268c55..b4e689f 100644
--- a/app/controllers/books/searches_controller.rb
+++ b/app/controllers/books/searches_controller.rb
@@ -1,9 +1,44 @@
 class Books::SearchesController < ApplicationController
   allow_unauthenticated_access
 
+  RATE_LIMIT = 30
+  RATE_LIMIT_WINDOW = 60
+
+  before_action :enforce_rate_limit, only: :create
+
   include BookScoped
 
+  class << self
+    def fallback_rate_limit_store
+      @fallback_rate_limit_store ||= ActiveSupport::Cache::MemoryStore.new
+    end
+  end
+
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
+
+  private
+    def enforce_rate_limit
+      store = rate_limit_store
+      now = Time.current.to_i
+      keys = ((now - RATE_LIMIT_WINDOW + 1)..now).map { |second| rate_limit_key(second) }
+      total = store.read_multi(*keys, raw: true).values.sum(&:to_i)
+
+      if total >= RATE_LIMIT
+        head :too_many_requests
+      else
+        store.increment(rate_limit_key(now), 1, expires_in: (RATE_LIMIT_WINDOW + 1).seconds)
+      end
+    end
+
+    def rate_limit_key(second)
+      "books/searches:rate_limit:#{request.remote_ip}:#{second}"
+    end
+
+    def rate_limit_store
+      store = cache_store unless cache_store.is_a?(ActiveSupport::Cache::NullStore)
+      store ||= Rails.cache unless Rails.cache.is_a?(ActiveSupport::Cache::NullStore)
+      store || self.class.fallback_rate_limit_store
+    end
 end
