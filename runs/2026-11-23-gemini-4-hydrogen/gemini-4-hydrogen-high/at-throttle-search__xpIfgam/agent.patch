     sign_in :kevin
 
     Leaf.reindex_all
@@ -241,4 +243,105 @@ class Books::SearchesControllerTest < ActionDispatch::IntegrationTest
       end
     end
   end
+
+  test "rate limits unauthenticated search after 30 requests in one minute with 429 and recovers automatically" do
+    sign_out
+    books(:handbook).update!(published: true)
+    books(:manual).update!(published: true)
+
+    attacker_headers = { "REMOTE_ADDR" => "203.0.113.10" }
+    other_reader_headers = { "REMOTE_ADDR" => "203.0.113.20" }
+
+    15.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: attacker_headers
+      assert_response :success
+    end
+
+    15.times do
+      post book_search_path(books(:manual)), params: { search: "Manual" }, headers: attacker_headers
+      assert_response :success
+    end
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: attacker_headers
+    assert_response :too_many_requests
+
+    # Another unauthenticated reader at a different address still gets search results
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: other_reader_headers
+    assert_response :success
+    assert_select "a", text: /Thanks for reading/i
+
+    # The rate-limited address can still open the book and its pages
+    get book_slug_path(books(:handbook)), headers: attacker_headers
+    assert_response :success
+
+    get leafable_slug_path(leaves(:welcome_page)), headers: attacker_headers
+    assert_response :success
+
+    # After the burst stops, the address is served again within 5 minutes
+    travel 5.minutes do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: attacker_headers
+      assert_response :success
+      assert_select "a", text: /Thanks for reading/i
+    end
+  end
+
+  test "rate limit enforces 30 requests in any sliding one-minute stretch" do
+    sign_out
+    books(:handbook).update!(published: true)
+
+    headers = { "REMOTE_ADDR" => "203.0.113.30" }
+
+    travel_to Time.zone.local(2026, 1, 1, 12, 0, 0) do
+      10.times do
+        post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+        assert_response :success
+      end
+
+      travel 45.seconds
+      20.times do
+        post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+        assert_response :success
+      end
+
+      travel 20.seconds
+      # 10 requests from t=0 aged out, 20 from t=45s remain in the last minute -> 10 more allowed
+      10.times do
+        post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+        assert_response :success
+      end
+
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+      assert_response :too_many_requests
+
+      travel 61.seconds
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: headers
+      assert_response :success
+    end
+  end
+
+  test "rate limit distinguishes client addresses behind X-Forwarded-For and ignores refused bursts for recovery" do
+    sign_out
+    books(:handbook).update!(published: true)
+
+    ip1_headers = { "REMOTE_ADDR" => "127.0.0.1", "HTTP_X_FORWARDED_FOR" => "198.51.100.1" }
+    ip2_headers = { "REMOTE_ADDR" => "127.0.0.1", "HTTP_X_FORWARDED_FOR" => "198.51.100.2" }
+
+    30.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: ip1_headers
+      assert_response :success
+    end
+
+    10.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: ip1_headers
+      assert_response :too_many_requests
+    end
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: ip2_headers
+    assert_response :success
+
+    travel 5.minutes do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: ip1_headers
+      assert_response :success
+    end
+  end
 end
