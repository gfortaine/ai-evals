diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..7e20498
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,59 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+  COMMENT_BURST_MINIMUM = 3
+  COMMENT_BURST_AUTHORS_MINIMUM = 2
+
+  included do
+    scope :stalled, -> { active.where.not(last_burst_at: nil).where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def stalled?(as_of: Time.current)
+    active? && last_burst_at.present? && last_active_at <= as_of - STALL_PERIOD
+  end
+
+  def stalled_days(as_of: Time.current)
+    (as_of.in_time_zone.to_date - last_active_at.in_time_zone.to_date).to_i
+  end
+
+  def burst_pending_stall?
+    active? && last_burst_at.present?
+  end
+
+  def stalls_at
+    last_active_at + STALL_PERIOD if burst_pending_stall?
+  end
+
+  def record_burst(at: Time.current)
+    update!(last_active_at: at, last_burst_at: at)
+  end
+
+  def record_comment_activity(comment)
+    now = Time.current
+
+    if stalled?(as_of: now)
+      update!(last_active_at: now, last_burst_at: nil, burst_reset_at: comment.created_at)
+    elsif comment_burst?(comment)
+      update!(last_active_at: now, last_burst_at: now)
+    elsif last_burst_at.present?
+      update!(last_active_at: now, last_burst_at: nil, burst_reset_at: comment.created_at)
+    else
+      update!(last_active_at: now)
+    end
+  end
+
+  private
+    def comment_burst?(comment)
+      window_start = [ comment.created_at - comment_burst_window, burst_reset_at ].compact.max
+      count, authors_count = comments.by_user
+        .where(created_at: window_start..comment.created_at)
+        .pick(Arel.sql("COUNT(*)"), Arel.sql("COUNT(DISTINCT comments.creator_id)"))
+
+      (count || 0) >= COMMENT_BURST_MINIMUM && (authors_count || 0) >= COMMENT_BURST_AUTHORS_MINIMUM
+    end
+
+    def comment_burst_window
+      (auto_postpone_period / 3.0).seconds
+    end
+end
