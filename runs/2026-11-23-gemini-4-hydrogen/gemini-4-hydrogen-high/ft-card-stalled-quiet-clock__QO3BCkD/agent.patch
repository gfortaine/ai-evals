     assert_not_includes filter.board_titles, "Writebook"
     assert_not_includes filter.board_titles, "Private board"
   end
+
+  test "stalled index returns only accessible stalled cards" do
+    stalled_card = cards(:text)
+    travel_to 2.weeks.ago do
+      stalled_card.toggle_assignment(users(:david))
+    end
+
+    other_board = Board.create!(name: "Secret", creator: users(:david))
+    secret_stalled = other_board.cards.create!(title: "Secret stalled", status: :published, creator: users(:david))
+    travel_to 2.weeks.ago do
+      secret_stalled.toggle_assignment(users(:david))
+    end
