+    assert_equal "Stalled", david_filter.summary
+    assert david_filter.used?
+
+    kevin_filter = users(:kevin).filters.new(indexed_by: "stalled")
+    assert_equal [ stalled_card ], kevin_filter.cards.to_a
+  end
 end
diff --git a/test/system/stalled_cards_test.rb b/test/system/stalled_cards_test.rb
new file mode 100644
index 0000000..8734f3f
--- /dev/null
+++ b/test/system/stalled_cards_test.rb
@@ -0,0 +1,37 @@
+require "application_system_test_case"
+
+class StalledCardsTest < ApplicationSystemTestCase
+  test "listing stalled cards and resetting with activity" do
+    card = cards(:text)
+    travel_to 15.days.ago do
+      with_current_user(:david) { card.toggle_assignment(users(:kevin)) }
+    end
+
+    sign_in_as(users(:david))
+
+    visit cards_url(indexed_by: :stalled)
+    assert_selector "#article_card_#{card.id}"
+    within "#article_card_#{card.id} .bubble" do
+      assert_text(/Stalled for/i)
+      assert_text "15"
+      assert_text(/days/i)
+    end
+
+    click_on card.title
+    within ".card-perma .bubble" do
+      assert_text(/Stalled for/i)
+      assert_text "15"
+      assert_text(/days/i)
+    end
+
+    find("lexxy-editor").click
+    send_keys "Picking this back up"
+    click_on "Post"
+
+    assert_text "Picking this back up"
+    assert_no_selector ".card-perma .bubble:not([hidden])"
+
+    visit cards_url(indexed_by: :stalled)
+    assert_no_selector "#article_card_#{card.id}"
+  end
+end
