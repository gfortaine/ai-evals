diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..f5e0458
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,198 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  setup do
+    @ordered_leaves = Leaf.order(:id).to_a
+    @ordered_leaves[0].update!(title: %(""Quoted" Opening"))
+    @ordered_leaves[1].update!(title: %("Second Title"))
+    @ordered_leaves[2].update!(title: %(""Fully Quoted""))
+    @ordered_leaves[3].update!(title: %("Tail With "Quote""))
+  end
+
+  test "cleans stray outer quotes while preserving inner quotes" do
+    TitleCleanupJob.perform_now
+
+    assert_equal %("Quoted" Opening), @ordered_leaves[0].reload.title
+    assert_equal "Second Title", @ordered_leaves[1].reload.title
+    assert_equal %("Fully Quoted"), @ordered_leaves[2].reload.title
+    assert_equal %(Tail With "Quote"), @ordered_leaves[3].reload.title
+  end
+
+  test "resumes after stopping interruption without re-cleaning earlier titles" do
+    TitleCleanupJob.perform_later
+
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: @ordered_leaves[1].id.succ) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal %("Quoted" Opening), @ordered_leaves[0].reload.title
+    assert_equal "Second Title", @ordered_leaves[1].reload.title
+    assert_equal %(""Fully Quoted""), @ordered_leaves[2].reload.title
+    assert_equal %("Tail With "Quote""), @ordered_leaves[3].reload.title
+
+    assert_enqueued_with(job: TitleCleanupJob)
+
+    perform_enqueued_jobs
+
+    assert_equal %("Quoted" Opening), @ordered_leaves[0].reload.title
+    assert_equal "Second Title", @ordered_leaves[1].reload.title
+    assert_equal %("Fully Quoted"), @ordered_leaves[2].reload.title
+    assert_equal %(Tail With "Quote"), @ordered_leaves[3].reload.title
+  end
+
+  test "resumes across multiple interruptions" do
+    TitleCleanupJob.perform_later
+
+    3.times do
+      calls = 0
+      queue_adapter.with(stopping: -> { (calls += 1) >= 1 }) do
+        perform_enqueued_jobs
+      end
+      assert_enqueued_with(job: TitleCleanupJob)
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal %("Quoted" Opening), @ordered_leaves[0].reload.title
+    assert_equal "Second Title", @ordered_leaves[1].reload.title
+    assert_equal %("Fully Quoted"), @ordered_leaves[2].reload.title
+    assert_equal %(Tail With "Quote"), @ordered_leaves[3].reload.title
+  end
+
+  test "resumes after abrupt interruption mid-leaf without double-cleaning" do
+    third_leaf_id = @ordered_leaves[2].id
+    original_update = Leaf.instance_method(:update!)
+    failed_once = false
+
+    Leaf.define_method(:update!) do |*args, **kwargs|
+      if id == third_leaf_id && !failed_once
+        failed_once = true
+        original_update.bind_call(self, *args, **kwargs)
+        raise SignalException, "TERM"
+      end
+      original_update.bind_call(self, *args, **kwargs)
+    end
+
+    begin
+      assert_raises(SignalException) do
+        TitleCleanupJob.perform_now
+      end
+    ensure
+      Leaf.define_method(:update!, original_update)
+    end
+
+    TitleCleanupJob.perform_now
+
+    assert_equal %("Quoted" Opening), @ordered_leaves[0].reload.title
+    assert_equal "Second Title", @ordered_leaves[1].reload.title
+    assert_equal %("Fully Quoted"), @ordered_leaves[2].reload.title
+    assert_equal %(Tail With "Quote"), @ordered_leaves[3].reload.title
+  end
+
+  test "resumes after error right after commit without double-cleaning the committed leaf" do
+    third_leaf_id = @ordered_leaves[2].id
+    original_advance = ActiveJob::Continuation::Step.instance_method(:advance!)
+    failed_once = false
+
+    ActiveJob::Continuation::Step.define_method(:advance!) do |from: nil|
+      if from == third_leaf_id && !failed_once
+        failed_once = true
+        raise SignalException, "TERM"
+      end
+      original_advance.bind_call(self, from: from)
+    end
+
+    begin
+      assert_raises(SignalException) do
+        TitleCleanupJob.perform_now
+      end
+    ensure
+      ActiveJob::Continuation::Step.define_method(:advance!, original_advance)
+    end
+
+    TitleCleanupJob.perform_now
+
+    assert_equal %("Quoted" Opening), @ordered_leaves[0].reload.title
+    assert_equal "Second Title", @ordered_leaves[1].reload.title
+    assert_equal %("Fully Quoted"), @ordered_leaves[2].reload.title
+    assert_equal %(Tail With "Quote"), @ordered_leaves[3].reload.title
+  end
+
+  test "resumes after error before commit on a leaf" do
+    third_leaf_id = @ordered_leaves[2].id
+    original_update = Leaf.instance_method(:update!)
+    failed_once = false
+
+    Leaf.define_method(:update!) do |*args, **kwargs|
+      if id == third_leaf_id && !failed_once
+        failed_once = true
+        raise RuntimeError, "transient failure"
+      end
+      original_update.bind_call(self, *args, **kwargs)
+    end
+
+    begin
+      TitleCleanupJob.perform_later
+      perform_enqueued_jobs
+      perform_enqueued_jobs
+    ensure
+      Leaf.define_method(:update!, original_update)
+    end
+
+    assert_equal %("Quoted" Opening), @ordered_leaves[0].reload.title
+    assert_equal "Second Title", @ordered_leaves[1].reload.title
+    assert_equal %("Fully Quoted"), @ordered_leaves[2].reload.title
+    assert_equal %(Tail With "Quote"), @ordered_leaves[3].reload.title
+  end
+
+  test "handles non-contiguous leaf IDs when resuming" do
+    @ordered_leaves[1].destroy!
+    remaining = [ @ordered_leaves[0], @ordered_leaves[2], @ordered_leaves[3] ]
+
+    TitleCleanupJob.perform_later
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: remaining[0].id.succ) do
+      perform_enqueued_jobs
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal %("Quoted" Opening), remaining[0].reload.title
+    assert_equal %("Fully Quoted"), remaining[1].reload.title
+    assert_equal %(Tail With "Quote"), remaining[2].reload.title
+  end
+
+  test "handles empty leaves table" do
+    Leaf.delete_all
+
+    assert_nothing_raised do
+      TitleCleanupJob.perform_now
+    end
+  end
+
+  test "re-enqueues on ResqueAdapter without requiring resque-scheduler" do
+    adapter = ActiveJob::QueueAdapters::ResqueAdapter.new
+    enqueued_payloads = []
+    original_enqueue_to = Resque.method(:enqueue_to)
+
+    Resque.define_singleton_method(:enqueue_to) do |queue, klass, payload|
+      enqueued_payloads << [ queue, klass, payload ]
+    end
+
+    begin
+      job = TitleCleanupJob.new
+      job.scheduled_at = 1.second.from_now
+      job.define_singleton_method(:queue_adapter) { adapter }
+      adapter.stopping = true
+      job.perform_now
+    ensure
+      Resque.define_singleton_method(:enqueue_to, original_enqueue_to)
+    end
+
+    assert_equal 1, enqueued_payloads.size
+    resumed_data = enqueued_payloads.first.last
+    assert_equal @ordered_leaves[0].id.succ, resumed_data["continuation"]["current"].last
+  end
+end
