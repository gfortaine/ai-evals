@@ -1,7 +1,28 @@
 class TitleCleanupJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  self.resume_options = {}
+
+  before_perform { self.scheduled_at = nil }
+
+  class Checkpoint < ApplicationRecord
+    self.table_name = "title_cleanup_checkpoints"
+  end
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    step :clean_titles do |step|
+      start_id = [ step.cursor, persisted_cursor ].compact.max
+
+      Leaf.find_each(start: start_id, order: :asc) do |leaf|
+        Leaf.transaction do
+          leaf.update!(title: cleaned(leaf.title))
+          save_persisted_cursor!(leaf.id.succ)
+        end
+
+        step.advance! from: leaf.id
+      end
+
+      clear_persisted_cursor!
     end
   end
 
@@ -9,4 +30,20 @@ class TitleCleanupJob < ApplicationJob
     def cleaned(title)
       title.delete_prefix('"').delete_suffix('"')
     end
+
+    def checkpoint_available?
+      Checkpoint.table_exists?
+    end
+
+    def persisted_cursor
+      Checkpoint.where(id: 1).pick(:cursor) if checkpoint_available?
+    end
+
+    def save_persisted_cursor!(cursor)
+      Checkpoint.upsert({ id: 1, cursor: cursor }) if checkpoint_available?
+    end
+
+    def clear_persisted_cursor!
+      Checkpoint.where(id: 1).delete_all if checkpoint_available?
+    end
 end
