diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..6639890
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,64 @@
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image.
+image: fizzy
+
+# Deploy to this server. Background jobs run in the same container via Solid Queue.
+servers:
+  web:
+    - 192.0.2.1 # Replace with your server's IP address or hostname
+
+# Enable SSL auto certification via Let's Encrypt.
+# If using Cloudflare, set encryption mode in SSL/TLS setting to "Full" to enable CF-to-app encryption.
+proxy:
+  ssl: true
+  host: &host fizzy.example.com # Replace with your domain name
+
+# Uses Kamal's local registry (localhost:5555) so no external registry account is required.
+# To use Docker Hub, GHCR, or another registry instead, set server, username, and password.
+registry:
+  server: localhost:5555
+
+# Configure builder setup.
+builder:
+  arch: amd64 # Change to arm64 if deploying to an ARM server
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    APP_HOST: *host
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com> # Replace with your sender address
+    SMTP_ADDRESS: smtp.example.com # Replace with your mail server hostname
+    SMTP_PORT: "587"
+    SMTP_USERNAME: "" # Replace with your SMTP username (leave blank if unauthenticated)
+    # SMTP_DOMAIN: example.com # Defaults to APP_HOST
+    # SMTP_AUTHENTICATION: plain # Defaults to plain when SMTP_USERNAME is set
+    # SMTP_ENABLE_STARTTLS_AUTO: "true"
+    # SMTP_TLS: "true" # Set to "true" for implicit TLS (defaults to true on port 465)
+    # WEB_CONCURRENCY: "1"
+    # JOB_CONCURRENCY: "1"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# Persist SQLite databases and Active Storage uploads across deploys.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests.
+asset_path: /rails/public/assets
+
+# Use a different ssh user than root.
+# ssh:
+#   user: app
+
+# Aliases are triggered with "bin/kamal <alias>".
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
