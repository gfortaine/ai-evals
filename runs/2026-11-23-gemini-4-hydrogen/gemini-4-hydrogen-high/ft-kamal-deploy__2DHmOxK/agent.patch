+# Secrets defined here are available for reference under env/secret in config/deploy.yml.
+# All secrets should be pulled from either a password manager, ENV, or an untracked file.
+# DO NOT ENTER RAW CREDENTIALS HERE if committing to a public repository!
+#
+# Required:
+#   SECRET_KEY_BASE — generate with: bin/rails secret
+#   SMTP_PASSWORD   — your mail server password (leave empty if unauthenticated)
+#
+# Optional (required for browser Web Push notifications):
+#   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY — generate with:
+#     bin/rails runner 'k = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{k.public_key}\nVAPID_PRIVATE_KEY=#{k.private_key}"'
+
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+SMTP_PASSWORD=$SMTP_PASSWORD
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
