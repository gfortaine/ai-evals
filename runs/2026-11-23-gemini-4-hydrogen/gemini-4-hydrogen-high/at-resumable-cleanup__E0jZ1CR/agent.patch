diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..5a79c01
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,237 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  setup do
+    @leaves = Leaf.order(:id).to_a
+    @leaves[0].update!(title: '""Hello" is a greeting"')
+    @leaves[1].update!(title: '"Plain Title"')
+    @leaves[2].update!(title: '""Quoted" and "more""')
+    @leaves[3].update!(title: '"Trailing "quote""')
+  end
+
+  test "strips stray outer quotes while keeping inner quotes intact" do
+    TitleCleanupJob.perform_now
+
+    assert_equal '"Hello" is a greeting', @leaves[0].reload.title
+    assert_equal "Plain Title", @leaves[1].reload.title
+    assert_equal '"Quoted" and "more"', @leaves[2].reload.title
+    assert_equal 'Trailing "quote"', @leaves[3].reload.title
+    assert_equal 0, TitleCleanupJob::Checkpoint.count
+  end
+
+  test "resumes after continuation interruption during step without recleaning earlier leaves" do
+    processed_titles = []
+    original_cleaned = TitleCleanupJob.instance_method(:cleaned)
+
+    TitleCleanupJob.define_method(:cleaned) do |title|
+      processed_titles << title
+      original_cleaned.bind_call(self, title)
+    end
+
+    TitleCleanupJob.perform_later
+
+    interrupt_job_during_step(TitleCleanupJob, :cleanup_titles, cursor: @leaves[1].id + 1) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal [ '""Hello" is a greeting"', '"Plain Title"' ], processed_titles
+    assert_equal '"Hello" is a greeting', @leaves[0].reload.title
+    assert_equal "Plain Title", @leaves[1].reload.title
+    assert_equal '""Quoted" and "more""', @leaves[2].reload.title
+    assert_equal '"Trailing "quote""', @leaves[3].reload.title
+    assert_enqueued_jobs 1, only: TitleCleanupJob
+
+    perform_enqueued_jobs
+
+    assert_equal [
+      '""Hello" is a greeting"',
+      '"Plain Title"',
+      '""Quoted" and "more""',
+      '"Trailing "quote""'
+    ], processed_titles
+    assert_equal '"Hello" is a greeting', @leaves[0].reload.title
+    assert_equal "Plain Title", @leaves[1].reload.title
+    assert_equal '"Quoted" and "more"', @leaves[2].reload.title
+    assert_equal 'Trailing "quote"', @leaves[3].reload.title
+    assert_equal 0, TitleCleanupJob::Checkpoint.count
+  ensure
+    TitleCleanupJob.define_method(:cleaned, original_cleaned) if original_cleaned
+  end
+
+  test "resumes across multiple interruptions" do
+    TitleCleanupJob.perform_later
+
+    @leaves.each do |leaf|
+      interrupt_job_during_step(TitleCleanupJob, :cleanup_titles, cursor: leaf.id + 1) do
+        perform_enqueued_jobs
+      end
+    end
+
+    # Even if interrupted right after the final leaf, the next run finishes cleanly
+    assert_enqueued_jobs 1, only: TitleCleanupJob
+    perform_enqueued_jobs
+
+    assert_equal '"Hello" is a greeting', @leaves[0].reload.title
+    assert_equal "Plain Title", @leaves[1].reload.title
+    assert_equal '"Quoted" and "more"', @leaves[2].reload.title
+    assert_equal 'Trailing "quote"', @leaves[3].reload.title
+    assert_equal 0, TitleCleanupJob::Checkpoint.count
+  end
+
+  test "resumes after transient error on a leaf without skipping or double-cleaning it" do
+    TitleCleanupJob.perform_later
+
+    fail_once = true
+    original_cleaned = TitleCleanupJob.instance_method(:cleaned)
+
+    TitleCleanupJob.define_method(:cleaned) do |title|
+      if fail_once && title == '""Quoted" and "more""'
+        fail_once = false
+        raise "Simulated transient error"
+      end
+      original_cleaned.bind_call(self, title)
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal '"Hello" is a greeting', @leaves[0].reload.title
+    assert_equal "Plain Title", @leaves[1].reload.title
+    assert_equal '""Quoted" and "more""', @leaves[2].reload.title
+    assert_equal '"Trailing "quote""', @leaves[3].reload.title
+    assert_enqueued_jobs 1, only: TitleCleanupJob
+
+    perform_enqueued_jobs
+
+    assert_equal '"Hello" is a greeting', @leaves[0].reload.title
+    assert_equal "Plain Title", @leaves[1].reload.title
+    assert_equal '"Quoted" and "more"', @leaves[2].reload.title
+    assert_equal 'Trailing "quote"', @leaves[3].reload.title
+    assert_equal 0, TitleCleanupJob::Checkpoint.count
+  ensure
+    TitleCleanupJob.define_method(:cleaned, original_cleaned) if original_cleaned
+  end
+
+  test "resumes from persisted checkpoint after hard interruption and fresh restart" do
+    original_cleaned = TitleCleanupJob.instance_method(:cleaned)
+    calls = 0
+
+    TitleCleanupJob.define_method(:cleaned) do |title|
+      calls += 1
+      raise Resque::TermException.new("SIGTERM") if calls == 3
+      original_cleaned.bind_call(self, title)
+    end
+
+    assert_raises(Resque::TermException) do
+      TitleCleanupJob.perform_now
+    end
+
+    assert_equal '"Hello" is a greeting', @leaves[0].reload.title
+    assert_equal "Plain Title", @leaves[1].reload.title
+    assert_equal '""Quoted" and "more""', @leaves[2].reload.title
+    assert_equal '"Trailing "quote""', @leaves[3].reload.title
+
+    TitleCleanupJob.define_method(:cleaned, original_cleaned)
+    TitleCleanupJob.perform_now
+
+    assert_equal '"Hello" is a greeting', @leaves[0].reload.title
+    assert_equal "Plain Title", @leaves[1].reload.title
+    assert_equal '"Quoted" and "more"', @leaves[2].reload.title
+    assert_equal 'Trailing "quote"', @leaves[3].reload.title
+    assert_equal 0, TitleCleanupJob::Checkpoint.count
+  ensure
+    TitleCleanupJob.define_method(:cleaned, original_cleaned) if original_cleaned
+  end
+
+  test "does not re-clean a leaf if interrupted after its transaction commits" do
+    original_advance = ActiveJob::Continuation::Step.instance_method(:advance!)
+    calls = 0
+
+    ActiveJob::Continuation::Step.define_method(:advance!) do |from: nil|
+      calls += 1
+      raise Resque::TermException.new("SIGTERM") if calls == 2
+      original_advance.bind_call(self, from: from)
+    end
+
+    assert_raises(Resque::TermException) do
+      TitleCleanupJob.perform_now
+    end
+
+    assert_equal '"Hello" is a greeting', @leaves[0].reload.title
+    assert_equal "Plain Title", @leaves[1].reload.title
+    assert_equal '""Quoted" and "more""', @leaves[2].reload.title
+
+    ActiveJob::Continuation::Step.define_method(:advance!, original_advance)
+    TitleCleanupJob.perform_now
+
+    assert_equal '"Hello" is a greeting', @leaves[0].reload.title
+    assert_equal "Plain Title", @leaves[1].reload.title
+    assert_equal '"Quoted" and "more"', @leaves[2].reload.title
+    assert_equal 'Trailing "quote"', @leaves[3].reload.title
+  ensure
+    ActiveJob::Continuation::Step.define_method(:advance!, original_advance) if original_advance
+  end
+
+  test "handles non-contiguous leaf ids when resuming" do
+    @leaves[2].destroy!
+
+    TitleCleanupJob.perform_later
+    interrupt_job_during_step(TitleCleanupJob, :cleanup_titles, cursor: @leaves[1].id + 1) do
+      perform_enqueued_jobs
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal '"Hello" is a greeting', @leaves[0].reload.title
+    assert_equal "Plain Title", @leaves[1].reload.title
+    assert_equal 'Trailing "quote"', @leaves[3].reload.title
+  end
+
+  test "handles empty leaf collection" do
+    Leaf.delete_all
+
+    assert_nothing_raised do
+      TitleCleanupJob.perform_now
+    end
+    assert_equal 0, TitleCleanupJob::Checkpoint.count
+  end
+
+  test "clears checkpoint on completion so a subsequent run processes new work" do
+    TitleCleanupJob.perform_now
+    assert_equal 0, TitleCleanupJob::Checkpoint.count
+
+    @leaves[0].update!(title: '"Updated Title"')
+    @leaves[1].update!(title: "Already Clean")
+    @leaves[2].update!(title: "Already Clean")
+    @leaves[3].update!(title: "Already Clean")
+
+    TitleCleanupJob.perform_now
+    assert_equal "Updated Title", @leaves[0].reload.title
+  end
+
+  test "re-enqueues on resume without requiring delayed scheduling for resque compatibility" do
+    assert_equal({}, TitleCleanupJob.resume_options)
+
+    resque_adapter = ActiveJob::QueueAdapters::ResqueAdapter.new
+    resque_adapter.stopping = true
+    enqueued = []
+
+    original_enqueue_to = Resque.method(:enqueue_to)
+    Resque.define_singleton_method(:enqueue_to) do |queue, wrapper, payload|
+      enqueued << [ queue, wrapper, payload ]
+    end
+
+    job = TitleCleanupJob.new
+    original_queue_adapter = job.method(:queue_adapter)
+    job.define_singleton_method(:queue_adapter) { resque_adapter }
+    job.perform_now
+
+    assert_equal 1, enqueued.size
+    assert_equal [ "cleanup_titles", @leaves[0].id + 1 ], enqueued.first[2].dig("continuation", "current")
+  ensure
+    Resque.define_singleton_method(:enqueue_to, original_enqueue_to) if original_enqueue_to
+    job&.define_singleton_method(:queue_adapter, original_queue_adapter) if original_queue_adapter
+  end
+end
