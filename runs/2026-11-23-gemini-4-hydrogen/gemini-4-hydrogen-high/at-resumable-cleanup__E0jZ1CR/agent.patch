@@ -1,7 +1,27 @@
 class TitleCleanupJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  self.resume_options = {}
+
+  class Checkpoint < ApplicationRecord
+    self.table_name = "title_cleanup_checkpoints"
+  end
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    step :cleanup_titles do |step|
+      track_in_db = Checkpoint.table_exists?
+      start_id = [ step.cursor, last_cleaned_leaf_id(track_in_db)&.next ].compact.max
+
+      Leaf.find_each(start: start_id, order: :asc) do |leaf|
+        Leaf.transaction do
+          leaf.update!(title: cleaned(leaf.title))
+          Checkpoint.upsert({ id: 1, last_leaf_id: leaf.id }) if track_in_db
+        end
+
+        step.advance! from: leaf.id
+      end
+
+      Checkpoint.delete_all if track_in_db
     end
   end
 
@@ -9,4 +29,8 @@ class TitleCleanupJob < ApplicationJob
     def cleaned(title)
       title.delete_prefix('"').delete_suffix('"')
     end
+
+    def last_cleaned_leaf_id(track_in_db)
+      Checkpoint.pick(:last_leaf_id) if track_in_db
+    end
 end
