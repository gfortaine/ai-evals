+require "test_helper"
+
+class QuestionTest < ActiveSupport::TestCase
+  test "save_with_option_rows skips empty rows and validates rules" do
+    quiz = Quiz.create!(title: "Science")
+    q = quiz.questions.build
+
+    errors = q.save_with_option_rows(
+      body: "Planet?",
+      active: true,
+      option_rows: [
+        { body: "Mars", correct: true },
+        { body: "   ", correct: false },
+        { body: "", correct: false },
+        { body: "", correct: false }
+      ]
+    )
+    assert_includes errors, "Add at least two options"
+    assert_equal 0, quiz.questions.count
+
+    errors = q.save_with_option_rows(
+      body: "Planet?",
+      active: true,
+      option_rows: [
+        { body: "", correct: true },
+        { body: "Mars", correct: false },
+        { body: "Venus", correct: false }
+      ]
+    )
+    assert_includes errors, "Mark at least one option as correct"
+    assert_equal 0, quiz.questions.count
+
+    errors = q.save_with_option_rows(
+      body: "Gas giants?",
+      active: false,
+      option_rows: [
+        { body: "Jupiter", correct: true },
+        { body: "", correct: false },
+        { body: "Saturn", correct: true },
+        { body: "Earth", correct: false }
+      ]
+    )
+    assert_empty errors
+    assert_equal 1, quiz.questions.count
+    assert_equal false, q.active?
+    assert_equal [ "Jupiter", "Saturn", "Earth" ], q.options.pluck(:body)
+    assert_equal [ true, true, false ], q.options.pluck(:correct)
+  end
+end
