+require "test_helper"
+
+class QuizTest < ActiveSupport::TestCase
+  test "requires title" do
+    quiz = Quiz.new(title: "   ")
+    assert_not quiz.valid?
+    assert_includes quiz.errors[:title], "can't be blank"
+  end
+
+  test "strips title" do
+    quiz = Quiz.create!(title: "  Ruby Conf  ")
+    assert_equal "Ruby Conf", quiz.title
+  end
+
+  test "moves questions up and down" do
+    quiz = Quiz.create!(title: "Order Quiz")
+    q1 = quiz.questions.create!(body: "Q1", position: 1, active: true)
+    q2 = quiz.questions.create!(body: "Q2", position: 2, active: true)
+    q3 = quiz.questions.create!(body: "Q3", position: 3, active: false)
+
+    quiz.move_question_down!(q1)
+    assert_equal [ q2, q1, q3 ], quiz.questions.reload.to_a
+
+    quiz.move_question_up!(q3)
+    assert_equal [ q2, q3, q1 ], quiz.questions.reload.to_a
+  end
+end
diff --git a/test/system/moderator_flow_test.rb b/test/system/moderator_flow_test.rb
new file mode 100644
index 0000000..fec2189
--- /dev/null
+++ b/test/system/moderator_flow_test.rb
@@ -0,0 +1,262 @@
+require "application_system_test_case"
+
+class ModeratorFlowTest < ApplicationSystemTestCase
+  test "full moderator workflow: quizzes, questions, validation, reordering, toggle, delete, preview" do
+    sign_in_as_moderator
+
+    # List quizzes & create a quiz
+    visit "/moderate"
+    assert_text "Quizzes"
+    click_link "New quiz"
+
+    # Required title validation
+    click_button "Save quiz"
+    assert_text "Title can't be blank"
+
+    fill_in "Title", with: "Frontend Fest 2026"
+    click_button "Save quiz"
+
+    assert_current_path %r{/moderate/quizzes/\d+}
+    assert_text "Frontend Fest 2026"
+    assert_link "Settings"
+    assert_link "Preview"
+    assert_link "Add question"
+
+    # Go back to /moderate and verify quiz sits in its own list item
+    visit "/moderate"
+    within("ul.quiz-list li", text: "Frontend Fest 2026") do
+      click_link "Frontend Fest 2026"
+    end
+
+    # Add question - verify 4 empty rows and Active on by default
+    click_link "Add question"
+    assert_field "Option 1", with: ""
+    assert_field "Option 2", with: ""
+    assert_field "Option 3", with: ""
+    assert_field "Option 4", with: ""
+    assert_checked_field "Active"
+
+    # Test validation: < 2 options and preserves input
+    fill_in "Question", with: "Which planet is the largest?"
+    fill_in "Option 1", with: "Jupiter"
+    check "Option 1 is correct"
+    click_button "Save question"
+
+    assert_text "Add at least two options"
+    assert_field "Question", with: "Which planet is the largest?"
+    assert_field "Option 1", with: "Jupiter"
+    assert_checked_field "Option 1 is correct"
+
+    # Test validation: no correct option (and empty rows skipped even if checked)
+    uncheck "Option 1 is correct"
+    fill_in "Option 2", with: "Saturn"
+    check "Option 3 is correct" # Option 3 is blank -> skipped!
+    click_button "Add option"
+    assert_field "Option 5", with: ""
+    fill_in "Option 5", with: "Neptune"
+    uncheck "Active"
+    click_button "Save question"
+
+    assert_text "Mark at least one option as correct"
+    assert_field "Question", with: "Which planet is the largest?"
+    assert_field "Option 1", with: "Jupiter"
+    assert_field "Option 2", with: "Saturn"
+    assert_field "Option 5", with: "Neptune"
+    assert_unchecked_field "Active"
+
+    # Fix and save
+    check "Option 1 is correct"
+    check "Active"
+    click_button "Save question"
+
+    assert_text "Which planet is the largest?"
+    assert_text "1 of 1 question active"
+
+    # Add two more questions (multiple correct options on Q2, inactive Q3)
+    click_link "Add question"
+    fill_in "Question", with: "Which are HTTP methods?"
+    fill_in "Option 1", with: "GET"
+    check "Option 1 is correct"
+    fill_in "Option 2", with: "POST"
+    check "Option 2 is correct"
+    fill_in "Option 3", with: "FOOBAR"
+    click_button "Save question"
+
+    click_link "Add question"
+    fill_in "Question", with: "Inactive question?"
+    fill_in "Option 1", with: "Alpha"
+    check "Option 1 is correct"
+    fill_in "Option 2", with: "Beta"
+    uncheck "Active"
+    click_button "Save question"
+
+    assert_text "2 of 3 questions active"
+
+    # Verify each question sits in its own <li> with its buttons/links inside
+    items = all("ul.question-list > li")
+    assert_equal 3, items.size
+    assert_includes items[0].text, "Which planet is the largest?"
+    assert_includes items[1].text, "Which are HTTP methods?"
+    assert_includes items[2].text, "Inactive question?"
+
+    # Reorder: move Q2 up
+    within(items[1]) do
+      click_button "Move up"
+    end
+    items = all("ul.question-list > li")
+    assert_includes items[0].text, "Which are HTTP methods?"
+    assert_includes items[1].text, "Which planet is the largest?"
+
+    # Move Q1 back down
+    within(items[0]) do
+      click_button "Move down"
+    end
+    items = all("ul.question-list > li")
+    assert_includes items[0].text, "Which planet is the largest?"
+    assert_includes items[1].text, "Which are HTTP methods?"
+
+    # Toggle Active checkbox directly on quiz page (saves immediately)
+    within(items[2]) do
+      assert_unchecked_field "Active"
+      check "Active"
+    end
+    assert_text "3 of 3 questions active"
+
+    within(all("ul.question-list > li")[2]) do
+      uncheck "Active"
+    end
+    assert_text "2 of 3 questions active"
+
+    # Edit a question (note: existing question has 3 options; clicking Add option adds Option 4)
+    within("ul.question-list > li:first-child") do
+      click_link "Edit"
+    end
+    click_button "Add option"
+    fill_in "Option 4", with: "Earth"
+    click_button "Save question"
+    assert_text "Earth"
+
+    # Preview skips inactive question (only 2 active questions)
+    click_link "Preview"
+    assert_text "Question 1 of 2"
+    assert_text "Which planet is the largest?"
+    assert_no_text "Inactive question?"
+
+    # Pick right answer on Q1
+    click_button "Jupiter"
+    assert_text "Correct!"
+    click_button "Next question"
+
+    # Pick wrong answer on Q2
+    assert_text "Question 2 of 2"
+    assert_text "Which are HTTP methods?"
+    click_button "FOOBAR"
+    assert_text "Wrong!"
+    click_button "See score"
+
+    assert_text "Score: 1/2"
+
+    # Start over restarts preview
+    click_button "Start over"
+    assert_text "Question 1 of 2"
+    assert_text "Which planet is the largest?"
+
+    # Back to quiz
+    click_link "Back to quiz"
+    assert_text "Frontend Fest 2026"
+
+    # Delete a question with native confirm()
+    accept_confirm do
+      within(all("ul.question-list > li")[2]) do
+        click_button "Delete"
+      end
+    end
+    assert_no_text "Inactive question?"
+    assert_text "2 of 2 questions active"
+
+    # Settings: update title and then delete quiz with native confirm()
+    click_link "Settings"
+    fill_in "Title", with: "Backend Fest 2026"
+    click_button "Save quiz"
+    assert_text "Backend Fest 2026"
+
+    click_link "Settings"
+    accept_confirm do
+      click_button "Delete quiz"
+    end
+    assert_current_path "/moderate"
+    assert_no_text "Backend Fest 2026"
+  end
+
+  test "edge cases: dismiss confirm, edit validation rollback, multi-correct preview, zero active preview, remove option row" do
+    sign_in_as_moderator
+
+    quiz = Quiz.create!(title: "Edge Quiz")
+    q1 = quiz.questions.create!(body: "Pick a vowel", position: 1, active: true)
+    q1.options.create!(body: "A", correct: true, position: 1)
+    q1.options.create!(body: "B", correct: false, position: 2)
+    q1.options.create!(body: "E", correct: true, position: 3)
+
+    visit "/moderate/quizzes/#{quiz.id}"
+
+    # Dismissing delete question keeps it
+    dismiss_confirm do
+      within("ul.question-list > li:first-child") do
+        click_button "Delete"
+      end
+    end
+    assert_text "Pick a vowel"
+
+    # Edit validation failure keeps DB untouched and preserves typed inputs
+    within("ul.question-list > li:first-child") do
+      click_link "Edit"
+    end
+    fill_in "Question", with: "Changed text"
+    uncheck "Option 1 is correct"
+    uncheck "Option 3 is correct"
+    click_button "Save question"
+
+    assert_text "Mark at least one option as correct"
+    assert_field "Question", with: "Changed text"
+    assert_unchecked_field "Option 1 is correct"
+    assert_equal "Pick a vowel", q1.reload.body
+    assert_equal [ true, false, true ], q1.options.pluck(:correct)
+
+    # Remove an option row and renumber
+    within(all(".option-row")[1]) do
+      click_button "Remove option"
+    end
+    assert_field "Option 1", with: "A"
+    assert_field "Option 2", with: "E"
+    click_link "Cancel"
+
+    # Preview with multi-correct option: picking E gives Correct! and reveals A and E
+    click_link "Preview"
+    assert_text "Question 1 of 1"
+    click_button "E"
+    assert_text "Correct!"
+    assert_equal 2, all(".play-option.is-correct").size
+    click_button "See score"
+    assert_text "Score: 1/1"
+    click_link "Back to quiz"
+    assert_text "Edge Quiz"
+
+    # Toggle inactive -> preview with 0 active questions
+    within("ul.question-list > li:first-child") do
+      uncheck "Active"
+    end
+    assert_text "0 of 1 question active"
+    click_link "Preview"
+    assert_text "No active questions to preview."
+    click_link "Back to quiz"
+    assert_text "Edge Quiz"
+
+    # Dismissing delete quiz keeps quiz
+    click_link "Settings"
+    dismiss_confirm do
+      click_button "Delete quiz"
+    end
+    assert_current_path "/moderate/quizzes/#{quiz.id}/edit"
+    assert_equal 1, Quiz.where(id: quiz.id).count
+  end
+end
