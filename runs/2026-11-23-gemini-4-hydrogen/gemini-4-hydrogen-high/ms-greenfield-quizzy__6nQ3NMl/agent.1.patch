new file mode 100644
index 0000000..09b89b4
--- /dev/null
+++ b/test/application_system_test_case.rb
@@ -0,0 +1,14 @@
+require "test_helper"
+require "capybara/cuprite"
+
+class ApplicationSystemTestCase < ActionDispatch::SystemTestCase
+  driven_by :cuprite, screen_size: [ 1280, 900 ], options: {
+    browser_path: "/usr/bin/chromium",
+    headless: true,
+    browser_options: { "no-sandbox": nil }
+  }
+
+  def sign_in_as_moderator(username: ENV["QUIZZY_MODERATOR_USERNAME"], password: ENV["QUIZZY_MODERATOR_PASSWORD"])
+    page.driver.browser.network.authorize(user: username, password: password) { |r| r.continue }
+  end
+end
