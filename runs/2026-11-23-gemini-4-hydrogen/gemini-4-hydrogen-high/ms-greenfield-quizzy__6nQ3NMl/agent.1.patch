+++ b/app/controllers/moderate/questions_controller.rb
@@ -0,0 +1,103 @@
+module Moderate
+  class QuestionsController < BaseController
+    before_action :set_quiz
+    before_action :set_question, only: %i[edit update destroy move_up move_down toggle]
+
+    def new
+      @question = @quiz.questions.build(active: true)
+      @form_body = ""
+      @form_active = true
+      @option_rows = Array.new(4) { { body: "", correct: false } }
+      @form_errors = []
+    end
+
+    def create
+      @question = @quiz.questions.build
+      parse_question_form_params
+      @form_errors = @question.save_with_option_rows(
+        body: @form_body,
+        active: @form_active,
+        option_rows: @option_rows
+      )
+
+      if @form_errors.empty?
+        redirect_to moderate_quiz_path(@quiz)
+      else
+        render :new, status: :unprocessable_entity
+      end
+    end
+
+    def edit
+      @form_body = @question.body
+      @form_active = @question.active?
+      @option_rows = @question.options.map { |o| { body: o.body, correct: o.correct? } }
+      @option_rows = Array.new(4) { { body: "", correct: false } } if @option_rows.empty?
+      @form_errors = []
+    end
+
+    def update
+      parse_question_form_params
+      @form_errors = @question.save_with_option_rows(
+        body: @form_body,
+        active: @form_active,
+        option_rows: @option_rows
+      )
+
+      if @form_errors.empty?
+        redirect_to moderate_quiz_path(@quiz)
+      else
+        render :edit, status: :unprocessable_entity
+      end
+    end
+
+    def destroy
+      @question.destroy!
+      redirect_to moderate_quiz_path(@quiz), status: :see_other
+    end
+
+    def move_up
+      @quiz.move_question_up!(@question)
+      redirect_to moderate_quiz_path(@quiz), status: :see_other
+    end
+
+    def move_down
+      @quiz.move_question_down!(@question)
+      redirect_to moderate_quiz_path(@quiz), status: :see_other
+    end
+
+    def toggle
+      active = !!ActiveModel::Type::Boolean.new.cast(params[:active])
+      @question.update!(active: active)
+      redirect_to moderate_quiz_path(@quiz), status: :see_other
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_question
+      @question = @quiz.questions.find(params[:id])
+    end
+
+    def parse_question_form_params
+      question_params = params.fetch(:question, {})
+      @form_body = question_params[:body].to_s
+      @form_active = !!ActiveModel::Type::Boolean.new.cast(question_params[:active])
+
+      raw_rows = question_params[:option_rows]
+      @option_rows = if raw_rows.respond_to?(:keys)
+        raw_rows.keys.sort_by(&:to_i).map do |key|
+          row = raw_rows[key]
+          {
+            body: row[:body].to_s,
+            correct: !!ActiveModel::Type::Boolean.new.cast(row[:correct])
+          }
+        end
+      else
+        []
+      end
+    end
+  end
+end
