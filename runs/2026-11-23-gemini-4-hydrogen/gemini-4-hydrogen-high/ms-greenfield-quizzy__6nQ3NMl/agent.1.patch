@@ -0,0 +1,23 @@
+<% content_for :title, "Quizzy · Preview · #{@quiz.title}" %>
+
+<div class="preview-banner">
+  <span>Preview mode · Answers are not stored</span>
+  <%= link_to "Back to quiz", moderate_quiz_path(@quiz) %>
+</div>
+
+<main class="play"
+      data-controller="preview"
+      data-preview-questions-value="<%= @preview_questions.to_json %>">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span><%= @quiz.title %></span>
+  </div>
+
+  <div class="play__body play__body--top" data-preview-target="stage">
+    <% if @preview_questions.empty? %>
+      <div class="card empty">
+        <p>No active questions to preview.</p>
+      </div>
+    <% end %>
+  </div>
+</main>
diff --git a/app/views/moderate/questions/_form.html.erb b/app/views/moderate/questions/_form.html.erb
new file mode 100644
index 0000000..5d69448
--- /dev/null
+++ b/app/views/moderate/questions/_form.html.erb
@@ -0,0 +1,79 @@
+<div class="card">
+  <%= form_with url: (@question.persisted? ? moderate_quiz_question_path(@quiz, @question) : moderate_quiz_questions_path(@quiz)),
+                method: (@question.persisted? ? :patch : :post) do %>
+    <% if @form_errors.present? %>
+      <div class="errors">
+        <% if @form_errors.size == 1 %>
+          <%= @form_errors.first %>
+        <% else %>
+          <ul>
+            <% @form_errors.each do |err| %>
+              <li><%= err %></li>
+            <% end %>
+          </ul>
+        <% end %>
+      </div>
+    <% end %>
+
+    <div class="field">
+      <label class="field-label" for="question_body">Question</label>
+      <textarea class="input" rows="3" name="question[body]" id="question_body"><%= @form_body %></textarea>
+    </div>
+
+    <div data-controller="option-rows">
+      <div class="field">
+        <span class="field-label">Options</span>
+        <span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span>
+      </div>
+
+      <div class="option-rows" data-option-rows-target="list">
+        <% @option_rows.each_with_index do |row, idx| %>
+          <% num = idx + 1 %>
+          <div class="option-row" data-option-rows-target="row">
+            <label class="visually-hidden" for="question_option_rows_<%= idx %>_body">Option <%= num %></label>
+            <input class="input"
+                   type="text"
+                   name="question[option_rows][<%= idx %>][body]"
+                   id="question_option_rows_<%= idx %>_body"
+                   placeholder="Option <%= num %>"
+                   value="<%= row[:body] %>">
+            <span class="checkbox">
+              <input type="hidden" name="question[option_rows][<%= idx %>][correct]" value="0">
+              <input type="checkbox"
+                     name="question[option_rows][<%= idx %>][correct]"
+                     id="question_option_rows_<%= idx %>_correct"
+                     value="1"
+                     aria-label="Option <%= num %> is correct"
+                     <%= "checked" if row[:correct] %>>
+              <label class="visually-hidden" for="question_option_rows_<%= idx %>_correct">Option <%= num %> is correct</label>
+              <span aria-hidden="true" data-action="click->option-rows#toggleCorrect">Correct</span>
+            </span>
+            <button type="button"
+                    class="btn btn--danger btn--icon"
+                    aria-label="Remove option"
+                    title="Remove option"
+                    data-action="option-rows#remove">✕</button>
+          </div>
+        <% end %>
+      </div>
+
+      <div class="buttons" style="margin-bottom: 28px">
+        <button type="button" class="btn btn--ghost btn--sm" data-action="option-rows#add">Add option</button>
+      </div>
+    </div>
+
+    <div class="field">
+      <label class="checkbox" for="question_active">
+        <input type="hidden" name="question[active]" value="0">
+        <input type="checkbox" name="question[active]" id="question_active" value="1" <%= "checked" if @form_active %>>
+        Active
+      </label>
+      <span class="field-hint">Only active questions are played.</span>
+    </div>
+
+    <div class="buttons">
+      <button type="submit" class="btn btn--pink">Save question</button>
+      <%= link_to "Cancel", moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+    </div>
+  <% end %>
+</div>
