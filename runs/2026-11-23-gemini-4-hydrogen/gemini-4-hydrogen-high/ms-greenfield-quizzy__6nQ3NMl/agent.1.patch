--- /dev/null
+++ b/test/integration/moderate_auth_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class ModerateAuthTest < ActionDispatch::IntegrationTest
+  test "health check responds 200 without auth" do
+    get "/up"
+    assert_response :success
+  end
+
+  test "moderator routes require HTTP basic auth" do
+    quiz = Quiz.create!(title: "Auth Quiz")
+    q = quiz.questions.create!(body: "Q1", position: 1, active: true)
+    q.options.create!(body: "A", correct: true, position: 1)
+    q.options.create!(body: "B", correct: false, position: 2)
+
+    paths = [
+      [ :get, "/moderate" ],
+      [ :get, "/moderate/quizzes/new" ],
+      [ :post, "/moderate/quizzes" ],
+      [ :get, "/moderate/quizzes/#{quiz.id}" ],
+      [ :get, "/moderate/quizzes/#{quiz.id}/edit" ],
+      [ :patch, "/moderate/quizzes/#{quiz.id}" ],
+      [ :delete, "/moderate/quizzes/#{quiz.id}" ],
+      [ :get, "/moderate/quizzes/#{quiz.id}/preview" ],
+      [ :get, "/moderate/quizzes/#{quiz.id}/questions/new" ],
+      [ :post, "/moderate/quizzes/#{quiz.id}/questions" ],
+      [ :get, "/moderate/quizzes/#{quiz.id}/questions/#{q.id}/edit" ],
+      [ :patch, "/moderate/quizzes/#{quiz.id}/questions/#{q.id}" ],
+      [ :delete, "/moderate/quizzes/#{quiz.id}/questions/#{q.id}" ],
+      [ :patch, "/moderate/quizzes/#{quiz.id}/questions/#{q.id}/move_up" ],
+      [ :patch, "/moderate/quizzes/#{quiz.id}/questions/#{q.id}/move_down" ],
+      [ :patch, "/moderate/quizzes/#{quiz.id}/questions/#{q.id}/toggle" ]
+    ]
+
+    paths.each do |method, path|
+      send(method, path)
+      assert_response :unauthorized, "Expected 401 without auth for #{method.upcase} #{path}"
+
+      send(method, path, headers: basic_auth_headers("mod", "wrong"))
+      assert_response :unauthorized, "Expected 401 with wrong password for #{method.upcase} #{path}"
+
+      send(method, path, headers: basic_auth_headers("wrong", "secret123"))
+      assert_response :unauthorized, "Expected 401 with wrong username for #{method.upcase} #{path}"
+    end
+
+    get "/moderate", headers: basic_auth_headers
+    assert_response :success
+  end
+end
