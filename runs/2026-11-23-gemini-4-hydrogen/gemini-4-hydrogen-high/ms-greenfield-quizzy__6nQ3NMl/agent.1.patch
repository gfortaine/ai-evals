+module Moderate
+  class PreviewsController < BaseController
+    layout "application"
+
+    def show
+      @quiz = Quiz.find(params[:quiz_id])
+      @preview_questions = @quiz.questions.active.ordered.includes(:options).map do |q|
+        {
+          id: q.id,
+          body: q.body,
+          options: q.options.map do |o|
+            {
+              id: o.id,
+              body: o.body,
+              correct: o.correct?
+            }
+          end
+        }
+      end
+    end
+  end
+end
diff --git a/app/controllers/moderate/questions_controller.rb b/app/controllers/moderate/questions_controller.rb
