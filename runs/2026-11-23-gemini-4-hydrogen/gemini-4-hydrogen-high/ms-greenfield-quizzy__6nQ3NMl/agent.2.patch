diff --git a/test/models/quiz_test.rb b/test/models/quiz_test.rb
index 8da994e..39a8133 100644
--- a/test/models/quiz_test.rb
+++ b/test/models/quiz_test.rb
@@ -24,4 +24,130 @@ class QuizTest < ActiveSupport::TestCase
     quiz.move_question_up!(q3)
     assert_equal [ q2, q3, q1 ], quiz.questions.reload.to_a
   end
+
+  test "export_payload writes exact keys and preserves question and option order" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+    q1 = quiz.questions.create!(body: "First?", position: 1, active: true)
+    q1.options.create!(body: "418", correct: false, position: 1)
+    q1.options.create!(body: "429", correct: true, position: 2)
+
+    q2 = quiz.questions.create!(body: "Second?", position: 2, active: false)
+    q2.options.create!(body: "Alpha", correct: true, position: 1)
+    q2.options.create!(body: "Beta", correct: true, position: 2)
+    q2.options.create!(body: "Gamma", correct: false, position: 3)
+
+    quiz.move_question_up!(q2)
+
+    payload = JSON.parse(quiz.export_json)
+    assert_equal %w[title questions], payload.keys
+    assert_equal "Frontend Fest 2026", payload["title"]
+    assert_equal 2, payload["questions"].size
+
+    first = payload["questions"][0]
+    assert_equal %w[text active options], first.keys
+    assert_equal "Second?", first["text"]
+    assert_equal false, first["active"]
+    assert_equal [
+      { "text" => "Alpha", "correct" => true },
+      { "text" => "Beta", "correct" => true },
+      { "text" => "Gamma", "correct" => false }
+    ], first["options"]
+
+    second = payload["questions"][1]
+    assert_equal %w[text active options], second.keys
+    assert_equal "First?", second["text"]
+    assert_equal true, second["active"]
+    assert_equal [
+      { "text" => "418", "correct" => false },
+      { "text" => "429", "correct" => true }
+    ], second["options"]
+  end
+
+  test "import_from_json creates new quiz with defaults and preserves order" do
+    existing = Quiz.create!(title: "Frontend Fest 2026")
+
+    json = <<~JSON
+      {
+        "title": "  Frontend Fest 2026  ",
+        "questions": [
+          {
+            "text": "Q1?",
+            "options": [
+              {"text": "Opt A"},
+              {"text": "Opt B", "correct": true}
+            ]
+          },
+          {
+            "text": "Q2?",
+            "active": false,
+            "options": [
+              {"text": "X", "correct": true},
+              {"text": "Y", "correct": false},
+              {"text": "Z", "correct": true}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    quiz, errors = Quiz.import_from_json(json)
+    assert_empty errors
+    assert_not_nil quiz
+    assert_not_equal existing.id, quiz.id
+    assert_equal "Frontend Fest 2026", quiz.title
+
+    questions = quiz.questions.ordered.to_a
+    assert_equal [ "Q1?", "Q2?" ], questions.map(&:body)
+    assert_equal [ true, false ], questions.map(&:active?)
+    assert_equal [ 1, 2 ], questions.map(&:position)
+
+    assert_equal [ "Opt A", "Opt B" ], questions[0].options.pluck(:body)
+    assert_equal [ false, true ], questions[0].options.pluck(:correct)
+    assert_equal [ "X", "Y", "Z" ], questions[1].options.pluck(:body)
+    assert_equal [ true, false, true ], questions[1].options.pluck(:correct)
+  end
+
+  test "import_from_json rejects invalid inputs atomically" do
+    invalid_payloads = [
+      "",
+      "{not json",
+      "[]",
+      '{"title": "", "questions": []}',
+      '{"title": "Valid"}',
+      '{"title": "Valid", "questions": "nope"}',
+      '{"title": "Valid", "questions": [{"text": "", "options": [{"text": "A", "correct": true}, {"text": "B"}]}]}',
+      '{"title": "Valid", "questions": [{"text": "Q1", "options": [{"text": "A", "correct": true}]}]}',
+      '{"title": "Valid", "questions": [{"text": "Q1", "options": [{"text": "A"}, {"text": "B"}]}]}',
+      '{"title": "Valid", "questions": [{"text": "Q1", "options": [{"text": "A", "correct": true}, {"text": "  ", "correct": false}]}]}',
+      '{"title": "Valid", "questions": [{"text": "Q1", "active": "yes", "options": [{"text": "A", "correct": true}, {"text": "B"}]}]}',
+      '{"title": "Valid", "questions": [{"text": "Q1", "options": [{"text": "A", "correct": "yes"}, {"text": "B"}]}]}',
+      # Atomicity: Q1 valid, Q2 invalid
+      {
+        "title" => "Partial",
+        "questions" => [
+          {
+            "text" => "Good question",
+            "options" => [
+              { "text" => "Yes", "correct" => true },
+              { "text" => "No", "correct" => false }
+            ]
+          },
+          {
+            "text" => "Bad question",
+            "options" => [
+              { "text" => "Only one", "correct" => true }
+            ]
+          }
+        ]
+      }.to_json
+    ]
+
+    invalid_payloads.each do |payload|
+      assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+        quiz, errors = Quiz.import_from_json(payload)
+        assert_nil quiz, "Expected nil quiz for payload: #{payload}"
+        assert_not_empty errors, "Expected errors for payload: #{payload}"
+      end
+    end
+  end
 end
diff --git a/test/system/moderator_flow_test.rb b/test/system/moderator_flow_test.rb
index fec2189..4212fb0 100644
--- a/test/system/moderator_flow_test.rb
+++ b/test/system/moderator_flow_test.rb
@@ -259,4 +259,87 @@ class ModeratorFlowTest < ApplicationSystemTestCase
     assert_current_path "/moderate/quizzes/#{quiz.id}/edit"
     assert_equal 1, Quiz.where(id: quiz.id).count
   end
+
+test "export and import quiz workflow and error handling" do
+  sign_in_as_moderator
+
+  quiz = Quiz.create!(title: "Frontend Fest 2026")
+  q1 = quiz.questions.create!(body: 'Which HTTP status code means "Too Many Requests"?', position: 1, active: true)
+  q1.options.create!(body: "418", correct: false, position: 1)
+  q1.options.create!(body: "429", correct: true, position: 2)
+
+  q2 = quiz.questions.create!(body: "Draft question?", position: 2, active: false)
+  q2.options.create!(body: "Yes", correct: true, position: 1)
+  q2.options.create!(body: "No", correct: false, position: 2)
+
+  visit "/moderate/quizzes/#{quiz.id}"
+  assert_link "Export"
+  click_link "Export"
+
+  pres = all("pre")
+  assert_equal 1, pres.size
+  exported_json = pres.first.text
+  parsed = JSON.parse(exported_json)
+  assert_equal({
+    "title" => "Frontend Fest 2026",
+    "questions" => [
+      {
+        "text" => 'Which HTTP status code means "Too Many Requests"?',
+        "active" => true,
+        "options" => [
+          { "text" => "418", "correct" => false },
+          { "text" => "429", "correct" => true }
+        ]
+      },
+      {
+        "text" => "Draft question?",
+        "active" => false,
+        "options" => [
+          { "text" => "Yes", "correct" => true },
+          { "text" => "No", "correct" => false }
+        ]
+      }
+    ]
+  }, parsed)
+
+  # Import quiz from /moderate
+  visit "/moderate"
+  click_on "Import quiz"
+
+  # Invalid JSON shows error and preserves input
+  fill_in "Quiz JSON", with: "{bad json"
+  click_button "Import"
+  assert_text "Invalid JSON"
+  assert_field "Quiz JSON", with: "{bad json"
+  assert_equal 1, Quiz.count
+
+  # Rule violation on 2nd question imports nothing
+  partial_invalid = {
+    title: "Should Not Exist",
+    questions: [
+      { text: "Valid?", options: [ { text: "A", correct: true }, { text: "B" } ] },
+      { text: "Broken?", options: [ { text: "A" }, { text: "B" } ] }
+    ]
+  }.to_json
+  fill_in "Quiz JSON", with: partial_invalid
+  click_button "Import"
+  assert_text "Mark at least one option as correct"
+  assert_equal 1, Quiz.count
+  assert_equal 2, Question.count
+
+  # Valid import (even with same title) creates a new quiz and opens its page
+  fill_in "Quiz JSON", with: exported_json
+  click_button "Import"
+
+  assert_current_path %r{/moderate/quizzes/\d+}
+  imported_id = current_path.split("/").last.to_i
+  assert_not_equal quiz.id, imported_id
+  assert_text "Frontend Fest 2026"
+  assert_text "1 of 2 questions active"
+
+  items = all("ul.question-list > li")
+  assert_equal 2, items.size
+  assert_includes items[0].text, "Too Many Requests"
+  assert_includes items[1].text, "Draft question?"
+end
 end
