@@ -0,0 +1,32 @@
+<% content_for :title, "Quizzy · Import quiz" %>
+
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<div class="page-head"><h1>Import quiz</h1></div>
+
+<div class="card">
+  <%= form_with url: import_moderate_quizzes_path, method: :post do %>
+    <% if @import_errors.present? %>
+      <div class="errors">
+        <% if @import_errors.size == 1 %>
+          <%= @import_errors.first %>
+        <% else %>
+          <ul>
+            <% @import_errors.each do |err| %>
+              <li><%= err %></li>
+            <% end %>
+          </ul>
+        <% end %>
+      </div>
+    <% end %>
+
+    <div class="field">
+      <label class="field-label" for="quiz_json">Quiz JSON</label>
+      <textarea class="input input--code" rows="12" name="quiz_json" id="quiz_json" autofocus><%= @quiz_json %></textarea>
+    </div>
+
+    <div class="buttons">
+      <%= submit_tag "Import", class: "btn btn--pink" %>
+      <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+    </div>
+  <% end %>
+</div>
