diff --git a/test/models/game_test.rb b/test/models/game_test.rb
index 9ddec5c..624edbd 100644
--- a/test/models/game_test.rb
+++ b/test/models/game_test.rb
@@ -75,4 +75,174 @@ class GameTest < ActiveSupport::TestCase
     assert_equal({ accepted: false }, res3)
     assert_equal opt_b.id, game.answers.first.game_option_id
   end
+
+  test "scoring counts correct answers and ranks ties by total time of correct answers from open to last pick" do
+    quiz = Quiz.create!(title: "Speed Quiz", winners_count: 2)
+    q1 = quiz.questions.create!(body: "Q1", position: 1, active: true)
+    q1.options.create!(body: "Right1", correct: true, position: 1)
+    q1.options.create!(body: "Wrong1", correct: false, position: 2)
+
+    q2 = quiz.questions.create!(body: "Q2", position: 2, active: true)
+    q2.options.create!(body: "Right2", correct: true, position: 1)
+    q2.options.create!(body: "Wrong2", correct: false, position: 2)
+
+    game = quiz.start_game!
+    assert_equal 2, game.winners_count
+    quiz.update!(winners_count: 5)
+    assert_equal 2, game.reload.winners_count
+
+    alice, = game.join_player!(name: "Alice")
+    bob, = game.join_player!(name: "Bob")
+    carol, = game.join_player!(name: "Carol")
+    dave, = game.join_player!(name: "Dave")
+
+    # During lobby, players do not see points
+    assert_not game.player_payload(alice).key?(:points)
+    assert_not game.player_payload(alice).key?(:player_result)
+    assert_not game.player_public_payload.key?(:player_results)
+
+    game.start!
+    gq1 = game.current_question
+    r1, w1 = gq1.game_options.to_a
+
+    # Players do not see points during question_open
+    assert_not game.player_payload(alice).key?(:player_result)
+    assert_not game.player_public_payload.key?(:player_results)
+
+    # Alice: wrong at +0.5s, changes to right at +3.0s
+    # Bob: right at +1.0s
+    # Carol: right at +0.4s
+    # Dave: wrong at +0.1s
+    game.submit_answer!(player: alice, game_question_id: gq1.id, game_option_id: w1.id)
+    game.submit_answer!(player: bob, game_question_id: gq1.id, game_option_id: r1.id)
+    game.submit_answer!(player: carol, game_question_id: gq1.id, game_option_id: r1.id)
+    game.submit_answer!(player: dave, game_question_id: gq1.id, game_option_id: w1.id)
+    game.submit_answer!(player: alice, game_question_id: gq1.id, game_option_id: r1.id)
+
+    t_open1 = gq1.opened_at
+    game.answers.find_by!(player: alice, game_question: gq1).update_columns(answered_at: t_open1 + 3.0)
+    game.answers.find_by!(player: bob, game_question: gq1).update_columns(answered_at: t_open1 + 1.0)
+    game.answers.find_by!(player: carol, game_question: gq1).update_columns(answered_at: t_open1 + 0.4)
+    game.answers.find_by!(player: dave, game_question: gq1).update_columns(answered_at: t_open1 + 0.1)
+
+    game.finish_question!
+    assert_not game.player_payload(alice).key?(:player_result)
+
+    game.next_question!
+    gq2 = game.current_question
+    r2, w2 = gq2.game_options.to_a
+
+    # Q2:
+    # Alice: right at +1.0s => total 2 pts, 4.0s
+    # Bob: right at +1.5s => total 2 pts, 2.5s (faster than Alice!)
+    # Carol: wrong at +10.0s => total 1 pt, 0.4s (wrong time ignored!)
+    # Dave: wrong at +0.1s => total 0 pts
+    game.submit_answer!(player: alice, game_question_id: gq2.id, game_option_id: r2.id)
+    game.submit_answer!(player: bob, game_question_id: gq2.id, game_option_id: r2.id)
+    game.submit_answer!(player: carol, game_question_id: gq2.id, game_option_id: w2.id)
+    game.submit_answer!(player: dave, game_question_id: gq2.id, game_option_id: w2.id)
+
+    t_open2 = gq2.opened_at
+    game.answers.find_by!(player: alice, game_question: gq2).update_columns(answered_at: t_open2 + 1.0)
+    game.answers.find_by!(player: bob, game_question: gq2).update_columns(answered_at: t_open2 + 1.5)
+    game.answers.find_by!(player: carol, game_question: gq2).update_columns(answered_at: t_open2 + 10.0)
+    game.answers.find_by!(player: dave, game_question: gq2).update_columns(answered_at: t_open2 + 0.1)
+
+    game.finish_question!
+    game.end_quiz!
+
+    rows = game.standings
+    assert_equal [ "Bob", "Alice", "Carol", "Dave" ], rows.map { |r| r[:name] }
+    assert_equal [ 1, 2, 3, 4 ], rows.map { |r| r[:place] }
+    assert_equal [ 2, 2, 1, 0 ], rows.map { |r| r[:points] }
+    assert_in_delta 2.5, rows[0][:correct_time], 0.01
+    assert_in_delta 4.0, rows[1][:correct_time], 0.01
+    assert_in_delta 0.4, rows[2][:correct_time], 0.01
+    assert_in_delta 0.0, rows[3][:correct_time], 0.01
+
+    bob_result = game.player_payload(bob)[:player_result]
+    assert_equal({ place: 1, total_players: 4, points: 2, winner: false }, bob_result)
+  end
+
+  test "pick_top_winners, draw_winners, and reset_winners handle ties, 0 points, and fewer eligible than N" do
+    quiz = Quiz.create!(title: "Prize Draw", winners_count: 3)
+    q1 = quiz.questions.create!(body: "Q1", position: 1, active: true)
+    q1.options.create!(body: "R1", correct: true, position: 1)
+    q1.options.create!(body: "W1", correct: false, position: 2)
+    q2 = quiz.questions.create!(body: "Q2", position: 2, active: true)
+    q2.options.create!(body: "R2", correct: true, position: 1)
+    q2.options.create!(body: "W2", correct: false, position: 2)
+
+    game = quiz.start_game!
+    p1, = game.join_player!(name: "TopScorer")
+    p2, = game.join_player!(name: "TiedA")
+    p3, = game.join_player!(name: "TiedB")
+    p4, = game.join_player!(name: "TiedC")
+    p5, = game.join_player!(name: "Zero")
+
+    game.start!
+    gq1 = game.current_question
+    r1, w1 = gq1.game_options.to_a
+    [ p1, p2, p3, p4 ].each { |p| game.submit_answer!(player: p, game_question_id: gq1.id, game_option_id: r1.id) }
+    game.submit_answer!(player: p5, game_question_id: gq1.id, game_option_id: w1.id)
+    t1 = gq1.opened_at
+    game.answers.find_by!(player: p1, game_question: gq1).update_columns(answered_at: t1 + 1.0)
+    game.answers.find_by!(player: p2, game_question: gq1).update_columns(answered_at: t1 + 1.0)
+    game.answers.find_by!(player: p3, game_question: gq1).update_columns(answered_at: t1 + 2.0)
+    game.answers.find_by!(player: p4, game_question: gq1).update_columns(answered_at: t1 + 3.0)
+    game.finish_question!
+
+    game.next_question!
+    gq2 = game.current_question
+    r2, w2 = gq2.game_options.to_a
+    game.submit_answer!(player: p1, game_question_id: gq2.id, game_option_id: r2.id)
+    [ p2, p3, p4, p5 ].each { |p| game.submit_answer!(player: p, game_question_id: gq2.id, game_option_id: w2.id) }
+    game.finish_question!
+    game.end_quiz!
+
+    # Top 3: p1 (2 pts), p2 (1 pt, 1s), p3 (1 pt, 2s)
+    game.pick_top_winners!
+    assert_equal [ p1.id, p2.id, p3.id ].sort, game.players.where(winner: true).pluck(:id).sort
+
+    # Reset winners
+    game.reset_winners!
+    assert_equal 0, game.players.where(winner: true).count
+
+    # Draw: p1 ALWAYS wins (> cutoff 1 pt), and 2 drawn at random from {p2, p3, p4} regardless of speed
+    seen_tied_winners = Set.new
+    30.times do
+      game.draw_winners!
+      winner_ids = game.players.where(winner: true).pluck(:id)
+      assert_equal 3, winner_ids.size
+      assert_includes winner_ids, p1.id
+      assert_not_includes winner_ids, p5.id
+      (winner_ids - [ p1.id ]).each { |id| seen_tied_winners << id }
+    end
+    assert_equal [ p2.id, p3.id, p4.id ].to_set, seen_tied_winners
+
+    # Fewer than N players with > 0 points: 0-point players never win
+    game2 = quiz.start_game!
+    a, = game2.join_player!(name: "One")
+    b, = game2.join_player!(name: "Two")
+    c, = game2.join_player!(name: "Zero1")
+    d, = game2.join_player!(name: "Zero2")
+    game2.start!
+    g2q1 = game2.current_question
+    g2r1, g2w1 = g2q1.game_options.to_a
+    game2.submit_answer!(player: a, game_question_id: g2q1.id, game_option_id: g2r1.id)
+    game2.submit_answer!(player: b, game_question_id: g2q1.id, game_option_id: g2r1.id)
+    game2.submit_answer!(player: c, game_question_id: g2q1.id, game_option_id: g2w1.id)
+    game2.finish_question!
+    game2.next_question!
+    game2.finish_question!
+    game2.end_quiz!
+
+    game2.pick_top_winners!
+    assert_equal [ a.id, b.id ].sort, game2.players.where(winner: true).pluck(:id).sort
+
+    game2.reset_winners!
+    game2.draw_winners!
+    assert_equal [ a.id, b.id ].sort, game2.players.where(winner: true).pluck(:id).sort
+    assert_not d.reload.winner?
+  end
 end
