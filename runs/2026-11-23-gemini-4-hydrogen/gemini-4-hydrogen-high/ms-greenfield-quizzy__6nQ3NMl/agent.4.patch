+    q1.options.create!(body: "Osaka", correct: false, position: 2)
+
+    q2 = quiz.questions.create!(body: "2 * 3?", position: 2, active: true)
+    q2.options.create!(body: "6", correct: true, position: 1)
+    q2.options.create!(body: "7", correct: false, position: 2)
+
+    join_path = nil
+
+    Capybara.using_session(:moderator) do
+      sign_in_as_moderator
+      visit "/moderate/quizzes/#{quiz.id}"
+      click_button "Start a game"
+      join_path = URI.parse(find(".lobby__url").text.strip).path
+    end
+
+    %i[alice bob carol dave eve].each do |sym|
+      Capybara.using_session(sym) do
+        visit join_path
+        fill_in "Your name", with: sym.to_s.capitalize
+        click_button "Join"
+        assert_text "Hi, #{sym.to_s.capitalize}!"
+      end
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 5"
+      click_button "Start"
+      assert_text "Question 1 of 2"
+    end
+
+    # Q1: Bob and Carol answer Right immediately; Alice picks Wrong first then changes to Right later
+    Capybara.using_session(:bob) do
+      assert_text "Question 1 of 2"
+      click_button "Tokyo"
+      assert_no_text "point"
+    end
+    Capybara.using_session(:carol) do
+      assert_text "Question 1 of 2"
+      click_button "Tokyo"
+    end
+    Capybara.using_session(:dave) do
+      assert_text "Question 1 of 2"
+      click_button "Osaka"
+    end
+    Capybara.using_session(:eve) do
+      assert_text "Question 1 of 2"
+      click_button "Osaka"
+    end
+    Capybara.using_session(:alice) do
+      assert_text "Question 1 of 2"
+      click_button "Osaka"
+      sleep 0.35
+      click_button "Tokyo"
+      within("button.play-option", text: "Tokyo") { assert_text "Your answer" }
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 5 / 5"
+      click_button "Finish"
+      click_button "Next"
+      assert_text "Question 2 of 2"
+    end
+
+    # Q2: Bob answers Right quickly, Alice answers Right, Carol & Eve answer Wrong, Dave waits then answers Right (so Carol is faster than Dave)
+    Capybara.using_session(:bob) do
+      assert_text "Question 2 of 2"
+      click_button "6"
+    end
+    Capybara.using_session(:alice) do
+      assert_text "Question 2 of 2"
+      sleep 0.2
+      click_button "6"
+    end
+    Capybara.using_session(:carol) do
+      assert_text "Question 2 of 2"
+      click_button "7"
+    end
+    Capybara.using_session(:eve) do
+      assert_text "Question 2 of 2"
+      click_button "7"
+    end
+    Capybara.using_session(:dave) do
+      assert_text "Question 2 of 2"
+      sleep 0.45
+      click_button "6"
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 5 / 5"
+      click_button "Finish"
+      click_button "End quiz"
+
+      items = all("ol.leaderboard > li")
+      assert_equal 5, items.size
+
+      within(items[0]) { assert_text "1"; assert_text "Bob"; assert_text "2 points" }
+      within(items[1]) { assert_text "2"; assert_text "Alice"; assert_text "2 points" }
+      within(items[2]) { assert_text "3"; assert_text "Carol"; assert_text "1 point" }
+      within(items[3]) { assert_text "4"; assert_text "Dave"; assert_text "1 point" }
+      within(items[4]) { assert_text "5"; assert_text "Eve"; assert_text "0 points" }
+    end
+
+    # Phones update live with place and points
+    Capybara.using_session(:bob)   { assert_text "Place 1 of 5"; assert_text "2 points"; assert_no_text "You won!" }
+    Capybara.using_session(:alice) { assert_text "Place 2 of 5"; assert_text "2 points"; assert_no_text "You won!" }
+    Capybara.using_session(:carol) { assert_text "Place 3 of 5"; assert_text "1 point";  assert_no_text "You won!" }
+    Capybara.using_session(:dave)  { assert_text "Place 4 of 5"; assert_text "1 point";  assert_no_text "You won!" }
+    Capybara.using_session(:eve)   { assert_text "Place 5 of 5"; assert_text "0 points"; assert_no_text "You won!" }
+
+    # Top 3
+    Capybara.using_session(:moderator) do
+      click_button "Top 3"
+      items = all("ol.leaderboard > li")
+      within(items[0]) { assert_text "Winner" }
+      within(items[1]) { assert_text "Winner" }
+      within(items[2]) { assert_text "Winner" }
+      within(items[3]) { assert_no_text "Winner" }
+      within(items[4]) { assert_no_text "Winner" }
+    end
+
+    Capybara.using_session(:bob)   { assert_text "You won!" }
+    Capybara.using_session(:alice) { assert_text "You won!" }
+    Capybara.using_session(:carol) { assert_text "You won!" }
+    Capybara.using_session(:dave)  { assert_no_text "You won!" }
+    Capybara.using_session(:eve)   { assert_no_text "You won!" }
+
+    # Reload persistence on phone and big screen
+    Capybara.using_session(:bob) do
+      visit join_path
+      assert_text "Place 1 of 5"
+      assert_text "2 points"
+      assert_text "You won!"
+    end
+    Capybara.using_session(:moderator) do
+      visit current_path
+      assert_equal 3, all("ol.leaderboard > li", text: "Winner").size
+    end
+
+    # Reset winners updates live
+    Capybara.using_session(:moderator) do
+      click_button "Reset winners"
+      assert_equal 0, all("ol.leaderboard > li", text: "Winner").size
+    end
+    Capybara.using_session(:bob)   { assert_no_text "You won!" }
+    Capybara.using_session(:alice) { assert_no_text "You won!" }
+    Capybara.using_session(:carol) { assert_no_text "You won!" }
+
+    # Draw picks definite winners (Bob, Alice) + 1 random from tied 3rd-place points (Carol or Dave), never Eve
+    Capybara.using_session(:moderator) do
+      click_button "Draw"
+      items = all("ol.leaderboard > li")
+      within(items[0]) { assert_text "Winner" }
+      within(items[1]) { assert_text "Winner" }
+      within(items[4]) { assert_no_text "Winner" }
+      assert_equal 3, all("ol.leaderboard > li", text: "Winner").size
+    end
+    Capybara.using_session(:bob) { assert_text "You won!" }
+    Capybara.using_session(:alice) { assert_text "You won!" }
+    Capybara.using_session(:eve) { assert_no_text "You won!" }
+  end
 end
