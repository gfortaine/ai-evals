diff --git a/test/models/game_test.rb b/test/models/game_test.rb
new file mode 100644
index 0000000..9ddec5c
--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  test "create_for_quiz skips inactive questions and isolates games" do
+    quiz = Quiz.create!(title: "Ruby Talk")
+    q1 = quiz.questions.create!(body: "Active 1", position: 1, active: true)
+    q1.options.create!(body: "Yes", correct: true, position: 1)
+    q1.options.create!(body: "No", correct: false, position: 2)
+
+    q2 = quiz.questions.create!(body: "Inactive", position: 2, active: false)
+    q2.options.create!(body: "A", correct: true, position: 1)
+    q2.options.create!(body: "B", correct: false, position: 2)
+
+    q3 = quiz.questions.create!(body: "Active 2", position: 3, active: true)
+    q3.options.create!(body: "One", correct: false, position: 1)
+    q3.options.create!(body: "Two", correct: true, position: 2)
+
+    game1 = quiz.start_game!
+    game2 = quiz.start_game!
+
+    assert_not_equal game1.code, game2.code
+    assert_equal [ "Active 1", "Active 2" ], game1.ordered_questions.pluck(:body)
+
+    # Editing quiz afterwards doesn't change existing game snapshot
+    q1.update!(body: "Edited 1")
+    assert_equal [ "Active 1", "Active 2" ], game1.ordered_questions.pluck(:body)
+  end
+
+  test "player_public_payload omits correct flag while question is open" do
+    quiz = Quiz.create!(title: "Sec Quiz")
+    q1 = quiz.questions.create!(body: "Secret?", position: 1, active: true)
+    q1.options.create!(body: "Right", correct: true, position: 1)
+    q1.options.create!(body: "Wrong", correct: false, position: 2)
+
+    game = quiz.start_game!
+    game.start!
+
+    open_payload = game.player_public_payload
+    open_payload[:question][:options].each do |opt|
+      assert_not opt.key?(:correct), "Expected :correct to be omitted when question is open"
+    end
+
+    game.finish_question!
+    closed_payload = game.player_public_payload
+    assert_equal [ true, false ], closed_payload[:question][:options].map { |o| o[:correct] }
+  end
+
+  test "submit_answer allows changing answer while open and rejects after close" do
+    quiz = Quiz.create!(title: "Answer Quiz")
+    q1 = quiz.questions.create!(body: "Pick one", position: 1, active: true)
+    q1.options.create!(body: "Opt A", correct: true, position: 1)
+    q1.options.create!(body: "Opt B", correct: false, position: 2)
+
+    game = quiz.start_game!
+    player, err = game.join_player!(name: "Alice")
+    assert_nil err
+
+    gq = game.current_question
+    opt_a, opt_b = gq.game_options.to_a
+
+    # Rejected in lobby
+    assert_equal({ accepted: false }, game.submit_answer!(player: player, game_question_id: gq.id, game_option_id: opt_a.id))
+
+    game.start!
+    res1 = game.submit_answer!(player: player, game_question_id: gq.id, game_option_id: opt_a.id)
+    assert res1[:accepted]
+
+    res2 = game.submit_answer!(player: player, game_question_id: gq.id, game_option_id: opt_b.id)
+    assert res2[:accepted]
+    assert_equal 1, game.answers.count
+    assert_equal opt_b.id, game.answers.first.game_option_id
+
+    game.finish_question!
+    res3 = game.submit_answer!(player: player, game_question_id: gq.id, game_option_id: opt_a.id)
+    assert_equal({ accepted: false }, res3)
+    assert_equal opt_b.id, game.answers.first.game_option_id
+  end
+end
diff --git a/test/system/live_game_test.rb b/test/system/live_game_test.rb
new file mode 100644
index 0000000..3de698e
--- /dev/null
+++ b/test/system/live_game_test.rb
@@ -0,0 +1,282 @@
+require "application_system_test_case"
+
+class LiveGameTest < ApplicationSystemTestCase
+  test "full live game across moderator big screen and multiple players without page reloads" do
+    quiz = Quiz.create!(title: "Conf Talk 2026")
+    q1 = quiz.questions.create!(body: "Best status for Too Many Requests?", position: 1, active: true)
+    q1.options.create!(body: "418", correct: false, position: 1)
+    q1.options.create!(body: "429", correct: true, position: 2)
+
+    q_inactive = quiz.questions.create!(body: "Secret draft question?", position: 2, active: false)
+    q_inactive.options.create!(body: "Yes", correct: true, position: 1)
+    q_inactive.options.create!(body: "No", correct: false, position: 2)
+
+    q2 = quiz.questions.create!(body: "Which are Ruby web servers?", position: 3, active: true)
+    q2.options.create!(body: "Puma", correct: true, position: 1)
+    q2.options.create!(body: "Falcon", correct: true, position: 2)
+    q2.options.create!(body: "Nginx", correct: false, position: 3)
+
+    q3 = quiz.questions.create!(body: "Final question?", position: 4, active: true)
+    q3.options.create!(body: "Alpha", correct: true, position: 1)
+    q3.options.create!(body: "Beta", correct: false, position: 2)
+
+    join_path = nil
+
+    Capybara.using_session(:moderator) do
+      sign_in_as_moderator
+      visit "/moderate/quizzes/#{quiz.id}"
+      click_button "Start a game"
+
+      assert_current_path %r{/moderate/quizzes/#{quiz.id}/games/\d+}
+      assert_text "Conf Talk 2026"
+      assert_text "Players: 0"
+      assert_selector ".qr svg"
+
+      lobby_url_text = find(".lobby__url").text.strip
+      assert_match %r{/play/[A-Z0-9]+$}, lobby_url_text
+      join_path = URI.parse(lobby_url_text).path
+    end
+
+    # Alice joins
+    Capybara.using_session(:alice) do
+      visit join_path
+      assert_field "Your name"
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+
+      # Browser remembers Alice when opening the join link again
+      visit join_path
+      assert_text "Hi, Alice!"
+      assert_no_button "Join"
+    end
+
+    # Moderator sees Players: 1 without reload
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 1"
+    end
+
+    # Bob joins
+    Capybara.using_session(:bob) do
+      visit join_path
+      fill_in "Your name", with: "Bob"
+      click_button "Join"
+      assert_text "Hi, Bob!"
+    end
+
+    # Moderator sees Players: 2 without reload
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 2"
+      click_button "Start"
+
+      assert_text "Question 1 of 3"
+      assert_text "Best status for Too Many Requests?"
+      assert_text "Answers: 0 / 2"
+      assert_button "Finish"
+    end
+
+    # Alice and Bob see Question 1 live without reload, and correct answer is NOT in page source
+    Capybara.using_session(:alice) do
+      assert_text "Question 1 of 3"
+      assert_text "Best status for Too Many Requests?"
+      assert_not_includes page.html, '"correct"'
+
+      # Tap 418 then change mind to 429
+      click_button "418"
+      within("button.play-option", text: "418") do
+        assert_text "Your answer"
+      end
+
+      click_button "429"
+      within("button.play-option", text: "429") do
+        assert_text "Your answer"
+      end
+      within("button.play-option", text: "418") do
+        assert_no_text "Your answer"
+      end
+    end
+
+    # Moderator sees Answers: 1 / 2 (not 2 / 2 after changing answer)
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 1 / 2"
+      click_button "Finish"
+
+      within("ol.stage-options > li", text: "429") do
+        assert_text "Correct"
+        assert_text "1"
+      end
+      within("ol.stage-options > li", text: "418") do
+        assert_no_text "Correct"
+        assert_text "0"
+      end
+      assert_button "Next"
+    end
+
+    # Alice sees Correct!, Bob sees No answer — live without reload
+    Capybara.using_session(:alice) do
+      assert_text "Correct!"
+    end
+    Capybara.using_session(:bob) do
+      assert_text "No answer"
+    end
+
+    # Moderator advances to Question 2 (skips inactive question!)
+    Capybara.using_session(:moderator) do
+      click_button "Next"
+      assert_text "Question 2 of 3"
+      assert_text "Which are Ruby web servers?"
+      assert_no_text "Secret draft question?"
+      assert_text "Answers: 0 / 2"
+    end
+
+    # Carol joins mid-game while Question 2 is open
+    Capybara.using_session(:carol) do
+      visit join_path
+      fill_in "Your name", with: "Carol"
+      click_button "Join"
+      assert_text "Question 2 of 3"
+      assert_text "Which are Ruby web servers?"
+      click_button "Falcon"
+      within("button.play-option", text: "Falcon") do
+        assert_text "Your answer"
+      end
+    end
+
+    Capybara.using_session(:alice) do
+      assert_text "Question 2 of 3"
+      click_button "Nginx"
+    end
+
+    Capybara.using_session(:bob) do
+      assert_text "Question 2 of 3"
+      click_button "Puma"
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 3 / 3"
+      click_button "Finish"
+
+      within("ol.stage-options > li", text: "Puma") do
+        assert_text "Correct"
+        assert_text "1"
+      end
+      within("ol.stage-options > li", text: "Falcon") do
+        assert_text "Correct"
+        assert_text "1"
+      end
+      within("ol.stage-options > li", text: "Nginx") do
+        assert_no_text "Correct"
+        assert_text "1"
+      end
+    end
+
+    Capybara.using_session(:alice) { assert_text "Wrong!" }
+    Capybara.using_session(:bob) { assert_text "Correct!" }
+    Capybara.using_session(:carol) { assert_text "Correct!" }
+
+    # Last question -> button is End quiz after Finish
+    Capybara.using_session(:moderator) do
+      click_button "Next"
+      assert_text "Question 3 of 3"
+      assert_text "Final question?"
+      click_button "Finish"
+      assert_no_button "Next"
+      assert_button "End quiz"
+      click_button "End quiz"
+      assert_text "The quiz is over"
+    end
+
+    # All players see "The quiz is over" live without reload
+    Capybara.using_session(:alice) { assert_text "The quiz is over" }
+    Capybara.using_session(:bob) { assert_text "The quiz is over" }
+    Capybara.using_session(:carol) { assert_text "The quiz is over" }
+
+    # Dave visits join link after the end -> sees "The quiz is over" and cannot join
+    Capybara.using_session(:dave) do
+      visit join_path
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+
+    # Quiz can be played again as a brand new game
+    Capybara.using_session(:moderator) do
+      click_link "Back to quiz"
+      click_button "Start a game"
+      assert_text "Players: 0"
+      new_join_path = URI.parse(find(".lobby__url").text.strip).path
+      assert_not_equal join_path, new_join_path
+    end
+  end
+
+  test "single question game, reload persistence, and live end on join screen" do
+    quiz = Quiz.create!(title: "Lightning Quiz")
+    q1 = quiz.questions.create!(body: "2 + 2?", position: 1, active: true)
+    q1.options.create!(body: "4", correct: true, position: 1)
+    q1.options.create!(body: "5", correct: false, position: 2)
+
+    join_path = nil
+
+    Capybara.using_session(:moderator) do
+      sign_in_as_moderator
+      visit "/moderate/quizzes/#{quiz.id}"
+      click_button "Start a game"
+      join_path = URI.parse(find(".lobby__url").text.strip).path
+    end
+
+    Capybara.using_session(:alice) do
+      visit join_path
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    # Bob sits on the join form without joining yet
+    Capybara.using_session(:bob) do
+      visit join_path
+      assert_field "Your name"
+      assert_button "Join"
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 1"
+      click_button "Start"
+      assert_text "Question 1 of 1"
+    end
+
+    # Alice answers and reloads page -> remembers Alice and her answer
+    Capybara.using_session(:alice) do
+      assert_text "Question 1 of 1"
+      click_button "4"
+      within("button.play-option", text: "4") { assert_text "Your answer" }
+
+      visit join_path
+      assert_text "Question 1 of 1"
+      within("button.play-option", text: "4") { assert_text "Your answer" }
+    end
+
+    Capybara.using_session(:moderator) do
+      click_button "Finish"
+      assert_no_button "Next"
+      assert_button "End quiz"
+    end
+
+    # Reload after finish still shows Correct!
+    Capybara.using_session(:alice) do
+      assert_text "Correct!"
+      visit join_path
+      assert_text "Correct!"
+    end
+
+    Capybara.using_session(:moderator) do
+      click_button "End quiz"
+      assert_text "The quiz is over"
+    end
+
+    # Bob sitting on join form updates live to "The quiz is over"
+    Capybara.using_session(:bob) do
+      assert_text "The quiz is over"
+      assert_no_button "Join"
+    end
+  end
+end
