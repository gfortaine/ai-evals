--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,80 @@
+module Moderate
+  class GamesController < BaseController
+    layout "application"
+
+    before_action :set_quiz
+    before_action :set_game, only: %i[show start finish_question next_question end_quiz state]
+
+    def create
+      if @quiz.questions.active.empty?
+        redirect_to moderate_quiz_path(@quiz), alert: "Add at least one active question before starting a game"
+        return
+      end
+
+      game = @quiz.start_game!
+      redirect_to moderate_quiz_game_path(@quiz, game)
+    end
+
+    def show
+      @join_url = play_url(code: @game.code)
+      @qr_svg = RQRCode::QRCode.new(@join_url).as_svg(
+        color: "0d0640",
+        shape_rendering: "crispEdges",
+        module_size: 6,
+        standalone: true,
+        use_path: true,
+        viewbox: true
+      )
+      @moderator_token = Rails.application.message_verifier(:moderate_game).generate(
+        @game.id,
+        purpose: :moderate_game
+      )
+      @initial_state = @game.moderator_payload
+    end
+
+    def start
+      @game.start!
+      respond_with_state
+    end
+
+    def finish_question
+      @game.finish_question!
+      respond_with_state
+    end
+
+    def next_question
+      @game.next_question!
+      respond_with_state
+    end
+
+    def end_quiz
+      @game.end_quiz!
+      respond_with_state
+    end
+
+    def state
+      if params[:since_version].present? && params[:since_version].to_i >= @game.state_version
+        head :no_content
+      else
+        render json: @game.moderator_payload
+      end
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_game
+      @game = @quiz.games.find(params[:id])
+    end
+
+    def respond_with_state
+      respond_to do |format|
+        format.json { render json: @game.moderator_payload }
+        format.html { redirect_to moderate_quiz_game_path(@quiz, @game) }
+      end
+    end
+  end
+end
