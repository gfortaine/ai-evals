--- /dev/null
+++ b/app/channels/moderate_game_channel.rb
@@ -0,0 +1,22 @@
+class ModerateGameChannel < ApplicationCable::Channel
+  def subscribed
+    game = Game.find_by(code: params[:code].to_s.upcase)
+    unless game && valid_token?(game, params[:token].to_s)
+      reject
+      return
+    end
+
+    stream_from "moderate_game_#{game.id}"
+  end
+
+  private
+
+  def valid_token?(game, token)
+    return false if token.blank?
+
+    verified_id = Rails.application.message_verifier(:moderate_game).verify(token, purpose: :moderate_game)
+    verified_id == game.id
+  rescue ActiveSupport::MessageVerifier::InvalidSignature
+    false
+  end
+end
