+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,85 @@
+class PlayController < ApplicationController
+  before_action :set_game
+
+  def show
+    @player = current_player
+    @initial_state = @game.player_payload(@player)
+    @join_error = nil
+  end
+
+  def join
+    if @game.finished?
+      redirect_to play_path(@game.code)
+      return
+    end
+
+    player, error = @game.join_player!(name: params[:name])
+    if player
+      cookies.signed[player_cookie_name] = {
+        value: player.token,
+        httponly: true,
+        same_site: :lax,
+        expires: 1.week.from_now
+      }
+      redirect_to play_path(@game.code)
+    else
+      @player = nil
+      @initial_state = @game.player_payload(nil)
+      @join_error = error
+      render :show, status: :unprocessable_entity
+    end
+  end
+
+  def answer
+    player = current_player
+    unless player
+      render json: { error: "Player not joined" }, status: :unauthorized
+      return
+    end
+
+    result = @game.submit_answer!(
+      player: player,
+      game_question_id: params[:game_question_id],
+      game_option_id: params[:game_option_id]
+    )
+
+    if result[:accepted]
+      render json: {
+        accepted: true,
+        picked_option_id: result[:picked_option_id],
+        state: @game.player_payload(player)
+      }
+    else
+      render json: {
+        accepted: false,
+        state: @game.player_payload(player)
+      }, status: :conflict
+    end
+  end
+
+  def state
+    player = current_player
+    if params[:since_version].present? && params[:since_version].to_i >= @game.phase_version
+      head :no_content
+    else
+      render json: @game.player_payload(player)
+    end
+  end
+
+  private
+
+  def set_game
+    @game = Game.find_by!(code: params[:code].to_s.strip.upcase)
+  end
+
+  def current_player
+    return @current_player if defined?(@current_player)
+
+    token = cookies.signed[player_cookie_name]
+    @current_player = token.present? ? @game.players.find_by(token: token) : nil
+  end
+
+  def player_cookie_name
+    "quizzy_player_#{@game.code}"
+  end
+end
