diff --git a/test/integration/live_game_flow_test.rb b/test/integration/live_game_flow_test.rb
new file mode 100644
index 0000000..8b3fc5f
--- /dev/null
+++ b/test/integration/live_game_flow_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class LiveGameFlowTest < ActionDispatch::IntegrationTest
+  test "play endpoints enforce security and game lifecycle" do
+    quiz = Quiz.create!(title: "Security Check")
+    q1 = quiz.questions.create!(body: "Capital of France?", position: 1, active: true)
+    q1.options.create!(body: "Paris", correct: true, position: 1)
+    q1.options.create!(body: "Lyon", correct: false, position: 2)
+
+    game = quiz.start_game!
+    gq = game.ordered_questions.first
+    paris, lyon = gq.game_options.to_a
+
+    # Blank name rejected
+    post "/play/#{game.code}/join", params: { name: "   " }
+    assert_response :unprocessable_entity
+    assert_equal 0, game.players.count
+
+    # Valid join sets cookie and redirects
+    post "/play/#{game.code}/join", params: { name: "Alice" }
+    assert_redirected_to "/play/#{game.code}"
+    follow_redirect!
+    assert_response :success
+    assert_includes response.body, "Hi, Alice!"
+
+    # Start question -> page source must not contain correct answer flag
+    game.start!
+    get "/play/#{game.code}"
+    assert_response :success
+    assert_not_includes response.body, '"correct":true'
+    assert_not_includes response.body, '"correct":false'
+
+    get "/play/#{game.code}/state"
+    assert_response :success
+    state_json = JSON.parse(response.body)
+    state_json["question"]["options"].each do |opt|
+      assert_not opt.key?("correct")
+    end
+
+    # Conditional state check returns 204 when unchanged
+    get "/play/#{game.code}/state", params: { since_version: state_json["version"] }
+    assert_response :no_content
+
+    # Submit answer
+    post "/play/#{game.code}/answer", params: { game_question_id: gq.id, game_option_id: lyon.id }, as: :json
+    assert_response :success
+
+    # Change answer
+    post "/play/#{game.code}/answer", params: { game_question_id: gq.id, game_option_id: paris.id }, as: :json
+    assert_response :success
+
+    # Close question -> answer rejected with 409
+    game.finish_question!
+    post "/play/#{game.code}/answer", params: { game_question_id: gq.id, game_option_id: lyon.id }, as: :json
+    assert_response :conflict
+
+    # End game -> new visitor cannot join
+    game.end_quiz!
+    reset!
+    get "/play/#{game.code}"
+    assert_response :success
+    assert_includes response.body, "The quiz is over"
+    assert_not_includes response.body, "Your name"
+
+    post "/play/#{game.code}/join", params: { name: "Latecomer" }
+    assert_redirected_to "/play/#{game.code}"
+    assert_equal 1, game.players.count
+  end
+end
