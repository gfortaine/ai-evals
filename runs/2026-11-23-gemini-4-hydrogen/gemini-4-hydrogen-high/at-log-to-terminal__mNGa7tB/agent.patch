diff --git a/test/lib/library_report_test.rb b/test/lib/library_report_test.rb
new file mode 100644
index 0000000..f096857
--- /dev/null
+++ b/test/lib/library_report_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  SCRIPT = Rails.root.join("script/library_report.rb")
+
+  test "writes the report to both stdout and the environment log file" do
+    log_path = Rails.root.join("log/#{Rails.env}.log")
+    offset = File.exist?(log_path) ? File.size(log_path) : 0
+
+    stdout, stderr = capture_io do
+      load SCRIPT
+    end
+
+    assert_equal "", stderr
+
+    expected_lines = [ "Library report: 2 books" ]
+    Book.order(:id).each do |book|
+      if book.leaves.count.zero?
+        expected_lines << "Library report: #{book.title} has no pages"
+      else
+        expected_lines << "Library report: #{book.title} has #{book.leaves.count} #{"page".pluralize(book.leaves.count)}"
+      end
+    end
+    expected_lines << "Library report: done"
+
+    stdout_report_lines = stdout.lines(chomp: true).select { |line| line.start_with?("Library report:") }
+    assert_equal expected_lines, stdout_report_lines
+
+    log_tail = File.binread(log_path, nil, offset)
+    log_report_lines = log_tail.lines(chomp: true).select { |line| line.start_with?("Library report:") }
+    assert_equal expected_lines, log_report_lines
+  end
+
+  test "preserves log severities and respects logger level" do
+    original_level = Rails.logger.level
+    Rails.logger.level = Logger::WARN
+
+    stdout, = capture_io do
+      load SCRIPT
+    end
+
+    stdout_report_lines = stdout.lines(chomp: true).select { |line| line.start_with?("Library report:") }
+    assert_equal [ "Library report: Manual has no pages" ], stdout_report_lines
+  ensure
+    Rails.logger.level = original_level
+  end
+
+  test "does not duplicate output when Rails.logger already outputs to stdout" do
+    original_logger = Rails.logger
+    buffer = StringIO.new
+    previous_stdout = $stdout
+    $stdout = buffer
+
+    stdout_logger = ActiveSupport::Logger.new($stdout)
+    stdout_logger.formatter = original_logger.formatter
+    stdout_logger.level = Logger::INFO
+    Rails.logger = ActiveSupport::BroadcastLogger.new(stdout_logger)
+
+    load SCRIPT
+
+    report_lines = buffer.string.lines(chomp: true).select { |line| line.start_with?("Library report:") }
+    assert_equal 4, report_lines.size
+  ensure
+    $stdout = previous_stdout
+    Rails.logger = original_logger
+  end
+end
