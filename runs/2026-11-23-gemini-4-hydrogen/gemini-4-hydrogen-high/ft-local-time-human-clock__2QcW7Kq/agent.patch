diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..81873c8
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,116 @@
+import { Controller } from "@hotwired/stimulus"
+import {
+  formatDateTime,
+  formatFullDateTime,
+  formatRelativeDays,
+  formatShortDate,
+  formatTime,
+  formatWeekdayDate,
+  parseDatetime,
+  signedDifferenceInDays
+} from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+const activeControllers = new Set()
+let refreshTimer = null
+
+function refreshAll() {
+  for (const controller of activeControllers) {
+    controller.refresh()
+  }
+}
+
+function registerController(controller) {
+  activeControllers.add(controller)
+
+  if (activeControllers.size === 1) {
+    refreshTimer = setInterval(refreshAll, REFRESH_INTERVAL)
+    document.addEventListener("visibilitychange", handleVisibilityChange)
+  }
+}
+
+function unregisterController(controller) {
+  activeControllers.delete(controller)
+
+  if (activeControllers.size === 0) {
+    clearInterval(refreshTimer)
+    refreshTimer = null
+    document.removeEventListener("visibilitychange", handleVisibilityChange)
+  }
+}
+
+function handleVisibilityChange() {
+  if (!document.hidden) refreshAll()
+}
+
+export default class extends Controller {
+  static values = {
+    style: { type: String, default: "relative" }
+  }
+
+  connect() {
+    registerController(this)
+    this.refresh()
+  }
+
+  disconnect() {
+    unregisterController(this)
+  }
+
+  styleValueChanged() {
+    this.refresh()
+  }
+
+  refresh() {
+    const datetime = this.element.getAttribute("datetime")
+    if (!datetime) return
+
+    const date = parseDatetime(datetime)
+    if (Number.isNaN(date.getTime())) return
+
+    const now = new Date()
+    this.element.textContent = this.#format(date, now)
+
+    if (this.styleValue !== "daysdate") {
+      this.element.title = formatFullDateTime(date)
+    }
+  }
+
+  #format(date, now) {
+    switch (this.styleValue) {
+      case "time":
+        return formatTime(date)
+      case "date":
+        return formatShortDate(date, { includeYear: date.getFullYear() !== now.getFullYear() })
+      case "stamp":
+        return formatShortDate(date, { includeYear: true })
+      case "daysdate":
+        return formatWeekdayDate(date)
+      case "datetime":
+        return formatDateTime(date)
+      case "indays":
+        return this.#formatInDays(date, now)
+      case "relative":
+      default:
+        return this.#formatRelative(date, now)
+    }
+  }
+
+  #formatInDays(date, now) {
+    const days = signedDifferenceInDays(now, date)
+    return formatRelativeDays(Math.max(days, 0))
+  }
+
+  #formatRelative(date, now) {
+    const days = signedDifferenceInDays(now, date)
+
+    if (days === 0) {
+      return date > now ? formatRelativeDays(0) : formatTime(date)
+    } else if (days >= -6 && days <= 6) {
+      return formatRelativeDays(days)
+    } else {
+      return formatShortDate(date, { includeYear: date.getFullYear() !== now.getFullYear() })
+    }
+  }
+}
