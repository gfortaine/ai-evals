diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..4e6e32f 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,28 @@
 module TimeHelper
+  def local_datetime_tag(datetime, style: :relative, **attributes)
+    return if datetime.nil?
+
+    data = attributes.delete(:data) || {}
+
+    tag.time(
+      datetime: iso8601_for(datetime),
+      class: class_names("local-time-value", attributes.delete(:class)),
+      data: {
+        **data,
+        controller: token_list("local-time", data[:controller]),
+        action: token_list("turbo:morph-element->local-time#refresh:self", data[:action]),
+        local_time_style_value: style
+      },
+      **attributes
+    )
+  end
+
+  private
+    def iso8601_for(datetime)
+      if datetime.is_a?(Date) && !datetime.is_a?(Time) && !datetime.is_a?(DateTime)
+        datetime.iso8601
+      else
+        datetime.to_time.utc.iso8601
+      end
+    end
 end
