new file mode 100644
index 0000000..54c384c
--- /dev/null
+++ b/db/migrate/20260219000000_add_active_to_cards.rb
@@ -0,0 +1,19 @@
+class AddActiveToCards < ActiveRecord::Migration[8.2]
+  def change
+    add_column :cards, :active, :boolean, default: false, null: false
+
+    reversible do |dir|
+      dir.up do
+        execute(<<~SQL)
+          UPDATE cards
+          SET active = #{connection.quoted_true}
+          WHERE status = 'published'
+            AND NOT EXISTS (SELECT 1 FROM closures WHERE closures.card_id = cards.id)
+            AND NOT EXISTS (SELECT 1 FROM card_not_nows WHERE card_not_nows.card_id = cards.id)
+        SQL
+      end
+    end
+
+    add_index :cards, [ :active, :last_active_at ]
+  end
+end
