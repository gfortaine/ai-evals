diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
index c1e9c2f..626c02a 100644
--- a/test/models/account/import_test.rb
+++ b/test/models/account/import_test.rb
@@ -220,6 +220,63 @@ class Account::ImportTest < ActiveSupport::TestCase
     export_tempfile&.unlink
   end
 
+  test "export and import reconciles active cards for exports missing active attribute" do
+    source_account = accounts("37s")
+    exporter = users(:david)
+    identity = exporter.identity
+
+    Current.set(account: source_account, user: exporter) do
+      cards(:text).postpone
+    end
+
+    active_card_id = cards(:logo).id
+    closed_card_id = cards(:shipping).id
+    postponed_card_id = cards(:text).id
+
+    export = Account::Export.create!(account: source_account, user: exporter)
+    export.build
+
+    legacy_tempfile = Tempfile.new([ "legacy_export", ".zip" ])
+    legacy_tempfile.binmode
+    export.file.open do |f|
+      reader = ZipFile::Reader.new(f)
+      writer = ZipFile::Writer.new(legacy_tempfile)
+      reader.glob("**/*").each do |entry_path|
+        raw = reader.read(entry_path)
+        if entry_path.start_with?("data/cards/") && entry_path.end_with?(".json")
+          data = JSON.parse(raw)
+          data.delete("active")
+          writer.add_file(entry_path, data.to_json)
+        else
+          writer.add_file(entry_path, raw)
+        end
+      end
+      writer.close
+    end
+    legacy_tempfile.rewind
+
+    source_account.destroy!
+
+    target_account = Account.create_with_owner(account: { name: "Import Test" }, owner: { identity: identity, name: exporter.name })
+    import = Account::Import.create!(identity: identity, account: target_account)
+    Current.set(account: target_account) do
+      import.file.attach(io: File.open(legacy_tempfile.path), filename: "export.zip", content_type: "application/zip")
+    end
+
+    import.check
+    assert_not import.failed?
+
+    import.process
+    assert import.completed?
+
+    assert target_account.cards.find(active_card_id).active
+    assert_not target_account.cards.find(closed_card_id).active
+    assert_not target_account.cards.find(postponed_card_id).active
+  ensure
+    legacy_tempfile&.close
+    legacy_tempfile&.unlink
+  end
+
   private
     def account_digest(account)
       {
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..e1e345c 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,51 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "due_to_be_postponed excludes closed, postponed, and drafted cards" do
+    freeze_time
+
+    cards(:shipping).update!(last_active_at: 100.days.ago)
+    cards(:unfinished_thoughts).update!(last_active_at: 100.days.ago)
+    cards(:text).postpone
+    cards(:text).update!(last_active_at: 100.days.ago)
+
+    due = Card.due_to_be_postponed.to_a
+    assert_not_includes due, cards(:shipping)
+    assert_not_includes due, cards(:unfinished_thoughts)
+    assert_not_includes due, cards(:text)
+  end
+
+  test "due_to_be_postponed handles mixed entropy periods across boards" do
+    freeze_time
+
+    entropies(:writebook_board).update!(auto_postpone_period: 3.days)
+    entropies(:miltons_wish_list_board).update!(auto_postpone_period: 90.days)
+
+    cards(:logo).update!(last_active_at: 4.days.ago)
+    cards(:layout).update!(last_active_at: 2.days.ago)
+    cards(:radio).update!(last_active_at: 10.days.ago)
+    cards(:paycheck).update!(last_active_at: 91.days.ago)
+
+    due = Card.due_to_be_postponed.to_a
+    assert_includes due, cards(:logo)
+    assert_includes due, cards(:paycheck)
+    assert_not_includes due, cards(:layout)
+    assert_not_includes due, cards(:radio)
+  end
+
+  test "due_to_be_postponed handles empty entropies table" do
+    Entropy.delete_all
+    assert_empty Card.due_to_be_postponed
+  end
+
+  if ActiveRecord::Base.connection.adapter_name == "SQLite"
+    test "due_to_be_postponed batch query uses the active and last_active_at index" do
+      sql = Card.due_to_be_postponed.order(:id).limit(1000).to_sql
+      plan = ActiveRecord::Base.connection.exec_query("EXPLAIN QUERY PLAN #{sql}").map { |row| row["detail"] }.join("\n")
+
+      assert_includes plan, "index_cards_on_active_and_last_active_at"
+      assert_not_includes plan, "SCAN cards"
+    end
+  end
 end
diff --git a/test/models/card/postponable_test.rb b/test/models/card/postponable_test.rb
index 0bafd3e..ca000be 100644
--- a/test/models/card/postponable_test.rb
+++ b/test/models/card/postponable_test.rb
@@ -57,4 +57,42 @@ class Card::PostponableTest < ActiveSupport::TestCase
     assert_includes Card.active, text
     assert_not_includes Card.active, logo
   end
+
+  test "active column stays synchronized across lifecycle transitions" do
+    card = boards(:writebook).cards.create!(creator: users(:david), status: :drafted, title: "Draft card")
+    assert_not card.active
+    assert_not_includes Card.active, card
+
+    card.publish
+    assert card.active
+    assert_includes Card.active, card
+
+    card.close
+    assert_not card.active
+    assert_not card.reload.active
+    assert_not_includes Card.active, card
+
+    card.postpone
+    assert_not card.active
+    assert_not card.reload.active
+    assert_not_includes Card.active, card
+
+    card.resume
+    assert card.reload.active
+    assert_includes Card.active, card
+
+    card.postpone
+    assert_not card.reload.active
+
+    card.close
+    assert_not card.reload.active
+
+    card.reopen
+    assert card.reload.active
+    assert_includes Card.active, card
+
+    card.drafted!
+    assert_not card.reload.active
+    assert_not_includes Card.active, card
+  end
 end
