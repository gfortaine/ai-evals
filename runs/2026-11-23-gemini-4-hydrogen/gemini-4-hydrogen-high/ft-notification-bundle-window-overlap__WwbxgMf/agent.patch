@@ -0,0 +1,47 @@
+require "test_helper"
+
+class NotificationBundlesTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @sender = users(:david)
+    @recipient = users(:kevin)
+    @recipient.notifications.destroy_all
+    @recipient.notification_bundles.destroy_all
+    cards(:logo).assignments.where(assignee: @recipient).destroy_all
+
+    sign_in_as @recipient
+    patch notifications_settings_path, params: { user_settings: { bundle_email_frequency: "daily" } }
+    assert_redirected_to notifications_settings_path
+  end
+
+  test "batches card events and mentions into a single digest email per window" do
+    freeze_time
+
+    perform_enqueued_jobs only: [ Mention::CreateJob, NotifyRecipientsJob ] do
+      Current.set(user: @sender) do
+        cards(:logo).toggle_assignment(@recipient)
+        cards(:layout).comments.create!(body: "Checking on this", creator: @sender)
+      end
+    end
+
+    assert_equal 1, @recipient.notification_bundles.count
+    bundle = @recipient.notification_bundles.reload.sole
+    assert_equal 1.day.from_now, bundle.ends_at
+
+    travel 12.hours
+    assert_emails 0 do
+      Notification::Bundle.deliver_all_due
+    end
+
+    travel 12.hours
+    assert_emails 1 do
+      Notification::Bundle.deliver_all_due
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @recipient.identity.email_address ], email.to
+    assert_includes email.body.encoded, cards(:logo).title
+    assert_includes email.body.encoded, cards(:layout).title
+  end
+end
diff --git a/test/mailers/notification/bundle_mailer_test.rb b/test/mailers/notification/bundle_mailer_test.rb
new file mode 100644
index 0000000..2b4e32b
--- /dev/null
+++ b/test/mailers/notification/bundle_mailer_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Notification::BundleMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @account = @user.account
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "notification email renders HTML and text parts grouped by board" do
+    Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    mention = @user.mentioned_by(users(:david), at: cards(:logo))
+    Notification.create!(user: @user, source: mention, creator: users(:david))
+
+    bundle = @user.notification_bundles.sole
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "#{@account.name}: 2 new notifications", email.subject
+    assert email.html_part.present?
+    assert email.text_part.present?
+    assert_match boards(:writebook).name, email.body.encoded
+    assert_match cards(:layout).title, email.body.encoded
+    assert_match cards(:logo).title, email.body.encoded
+    assert_match @account.slug, email.body.encoded
+    assert_match "/notifications/settings", email.body.encoded
+  end
+
+  test "single notification uses notification payload title in subject" do
+    notification = Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    bundle = @user.notification_bundles.sole
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_equal "#{@account.name}: #{notification.payload.title}", email.subject
+  end
+
+  test "does not send email when bundle has no unread notifications" do
+    notification = Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    bundle = @user.notification_bundles.sole
+    notification.read
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_emails 0 do
+      email.deliver_now
+    end
+  end
+end
