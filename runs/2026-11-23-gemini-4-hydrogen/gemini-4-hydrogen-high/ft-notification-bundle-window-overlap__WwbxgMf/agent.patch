       ActiveSupport::TimeZone[timezone_name] || default_timezone
@@ -10,8 +16,26 @@ class User::Settings < ApplicationRecord
     end
   end
 
+  def bundling_emails?
+    !never?
+  end
+
+  def bundle_aggregation_period
+    Notification::Bundle::AGGREGATION_PERIODS[bundle_email_frequency.to_sym]
+  end
+
   private
     def default_timezone
       ActiveSupport::TimeZone["UTC"]
     end
+
+    def adjust_pending_bundles
+      if never?
+        user.notification_bundles.pending.destroy_all
+      elsif period = bundle_aggregation_period
+        if bundle = user.notification_bundles.pending.where("ends_at > ?", Time.current).order(:starts_at).last
