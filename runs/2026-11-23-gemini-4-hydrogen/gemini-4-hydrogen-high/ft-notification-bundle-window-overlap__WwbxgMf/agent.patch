diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..82a113f
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,251 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @creator = users(:david)
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "clock starts when the first notification lands for every_few_hours" do
+    freeze_time do
+      notification = Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+
+      bundle = @user.notification_bundles.sole
+      assert bundle.pending?
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 4.hours.from_now, bundle.ends_at
+      assert_equal bundle, notification.reload.bundle
+    end
+  end
+
+  test "clock starts when the first notification lands for daily" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+
+    freeze_time do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+
+      bundle = @user.notification_bundles.sole
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 1.day.from_now, bundle.ends_at
+    end
+  end
+
+  test "clock starts when the first notification lands for weekly" do
+    @user.settings.update!(bundle_email_frequency: :weekly)
+
+    freeze_time do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+
+      bundle = @user.notification_bundles.sole
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 1.week.from_now, bundle.ends_at
+    end
+  end
+
+  test "never frequency does not create bundles" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      notification = Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+      assert_nil notification.reload.bundle
+    end
+  end
+
+  test "multiple notifications within the open window batch into one bundle and send one email" do
+    freeze_time
+    Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+
+    travel 2.hours
+    Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+
+    assert_equal 1, @user.notification_bundles.count
+
+    travel 1.hour
+    assert_emails 0 do
+      Notification::Bundle.deliver_all_due
+    end
+
+    travel 1.hour
+    assert_emails 1 do
+      Notification::Bundle.deliver_all_due
+    end
+
+    assert @user.notification_bundles.sole.reload.delivered?
+
+    # Running again does not resend
+    assert_emails 0 do
+      Notification::Bundle.deliver_all_due
+    end
+  end
+
+  test "late notification arriving before open window starts_at belongs to the already opened window" do
+    freeze_time
+    first_bundle = Notification.create!(user: @user, source: events(:layout_commented), creator: @creator).reload.bundle
+
+    late_notification = Notification.create!(
+      user: @user,
+      source: events(:logo_published),
+      creator: @creator,
+      created_at: 30.minutes.ago,
+      updated_at: 30.minutes.ago
+    )
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal first_bundle, late_notification.reload.bundle
+
+    travel 4.hours
+    assert_emails 1 do
+      Notification::Bundle.deliver_all_due
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_includes email.body.encoded, cards(:layout).title
+    assert_includes email.body.encoded, cards(:logo).title
+  end
+
+  test "late notification arriving after window delivered opens a non-overlapping window and is still included" do
+    freeze_time
+    Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+    first_bundle = @user.notification_bundles.sole
+
+    travel 4.hours
+    assert_emails 1 do
+      Notification::Bundle.deliver_all_due
+    end
+    assert first_bundle.reload.delivered?
+
+    # Late notification with timestamp inside the already-delivered window
+    late_notification = Notification.create!(
+      user: @user,
+      source: events(:logo_published),
+      creator: @creator,
+      created_at: 10.minutes.ago,
+      updated_at: 10.minutes.ago
+    )
+
+    assert_equal 2, @user.notification_bundles.count
+    second_bundle = late_notification.reload.bundle
+    assert_not_equal first_bundle, second_bundle
+    assert_equal first_bundle.ends_at, second_bundle.starts_at
+    assert_equal first_bundle.ends_at + 4.hours, second_bundle.ends_at
+
+    travel 4.hours
+    assert_emails 1 do
+      Notification::Bundle.deliver_all_due
+    end
+  end
+
+  test "notification arriving after pending window ends opens next window without overlapping" do
+    freeze_time
+    Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+    first_bundle = @user.notification_bundles.sole
+
+    travel 4.hours + 10.minutes
+    second_notification = Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    second_bundle = second_notification.reload.bundle
+
+    assert_equal 2, @user.notification_bundles.count
+    assert_operator first_bundle.ends_at, :<=, second_bundle.starts_at
+
+    # A late notification with timestamp inside the still-pending first window belongs to the first window
+    late_notification = Notification.create!(
+      user: @user,
+      source: events(:buy_domain_sent_back_to_triage),
+      creator: @creator,
+      created_at: 20.minutes.ago,
+      updated_at: 20.minutes.ago
+    )
+    assert_equal first_bundle, late_notification.reload.bundle
+  end
+
+  test "validates against overlapping windows for the same user" do
+    freeze_time
+    Notification::Bundle.create!(user: @user, starts_at: Time.current, ends_at: 4.hours.from_now)
+
+    # Overlapping start
+    overlapping = Notification::Bundle.new(user: @user, starts_at: 2.hours.from_now, ends_at: 6.hours.from_now)
+    assert_not overlapping.valid?
+
+    # Enclosing
+    enclosing = Notification::Bundle.new(user: @user, starts_at: 1.hour.ago, ends_at: 5.hours.from_now)
+    assert_not enclosing.valid?
+
+    # Contained
+    contained = Notification::Bundle.new(user: @user, starts_at: 1.hour.from_now, ends_at: 3.hours.from_now)
+    assert_not contained.valid?
+
+    # Adjacent (non-overlapping) is valid
+    adjacent = Notification::Bundle.new(user: @user, starts_at: 4.hours.from_now, ends_at: 8.hours.from_now)
+    assert adjacent.valid?
+
+    # Overlapping window for a different user is valid
+    other_user_bundle = Notification::Bundle.new(user: users(:david), starts_at: Time.current, ends_at: 4.hours.from_now)
+    assert other_user_bundle.valid?
+  end
+
+  test "read notifications are excluded and empty bundles send no email" do
+    freeze_time
+    notification = Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+    notification.read
+
+    travel 4.hours
+    assert_emails 0 do
+      Notification::Bundle.deliver_all_due
+    end
+
+    assert @user.notification_bundles.sole.reload.delivered?
+  end
+
+  test "updating an existing card notification after delivery assigns it to a new bundle" do
+    freeze_time
+    notification = Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+    first_bundle = notification.reload.bundle
+
+    travel 4.hours
+    assert_emails 1 do
+      Notification::Bundle.deliver_all_due
+    end
+
+    travel 1.hour
+    comment = cards(:layout).comments.create!(body: "Follow up comment", creator: @creator)
+    new_event = boards(:writebook).events.create!(action: "comment_created", creator: @creator, eventable: comment)
+    notification.source_type_will_change!
+    notification.update!(source: new_event, creator: @creator, read_at: nil, unread_count: notification.unread_count + 1)
+
+    second_bundle = notification.reload.bundle
+    assert_not_equal first_bundle, second_bundle
+    assert second_bundle.pending?
+
+    travel 4.hours
+    assert_emails 1 do
+      Notification::Bundle.deliver_all_due
+    end
+  end
+
+  test "inactive users and cancelled accounts do not deliver bundle emails" do
+    freeze_time
+    Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+
+    @user.deactivate
+    travel 4.hours
+
+    assert_emails 0 do
+      Notification::Bundle.deliver_all_due
+    end
+  end
+
+  test "deliver_later enqueues Notification::Bundle::DeliverJob" do
+    freeze_time
+    Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+    bundle = @user.notification_bundles.sole
+
+    assert_enqueued_with(job: Notification::Bundle::DeliverJob, args: [ bundle ]) do
+      bundle.deliver_later
+    end
+  end
+end
diff --git a/test/models/user/settings_test.rb b/test/models/user/settings_test.rb
