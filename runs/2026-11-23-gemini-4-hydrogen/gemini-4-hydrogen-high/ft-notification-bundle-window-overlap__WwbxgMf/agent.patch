+++ b/test/models/user/settings_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @settings = @user.settings
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+  end
+
+  test "bundle_email_frequency defaults to every_few_hours" do
+    user = User.create!(account: accounts("37s"), name: "New User")
+    assert_equal "every_few_hours", user.settings.bundle_email_frequency
+    assert user.settings.every_few_hours?
+    assert user.settings.bundling_emails?
+  end
+
+  test "validates bundle_email_frequency" do
+    @settings.bundle_email_frequency = "invalid"
+    assert_not @settings.valid?
+    assert @settings.errors[:bundle_email_frequency].any?
+  end
+
+  test "switching to never destroys pending bundles" do
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+    Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    assert_equal 1, @user.notification_bundles.pending.count
+
+    @settings.update!(bundle_email_frequency: :never)
+    assert_equal 0, @user.notification_bundles.pending.count
+  end
+
+  test "switching between active frequencies updates open pending bundle ends_at" do
+    freeze_time
+    @settings.update!(bundle_email_frequency: :weekly)
+    Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    bundle = @user.notification_bundles.sole
+    assert_equal 1.week.from_now, bundle.ends_at
+
+    travel 2.hours
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+    assert_equal bundle.starts_at + 4.hours, bundle.reload.ends_at
+  end
+end
