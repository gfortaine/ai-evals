+<tr>
+  <td>
+    <% @notifications_by_board.each_with_index do |(board, notifications), index| %>
+      <% if index > 0 %>
+        <hr class="notification__board-separator">
+      <% end %>
+
+      <h2 class="notification__board">
+        <%= link_to board.name, board_url(board) %>
+      </h2>
+
+      <% notifications.each do |notification| %>
+        <% payload = notification.payload %>
+        <table class="notification">
+          <tr>
+            <td class="avatar__container">
+              <%= mail_avatar_tag(notification.creator) %>
+            </td>
+            <td>
