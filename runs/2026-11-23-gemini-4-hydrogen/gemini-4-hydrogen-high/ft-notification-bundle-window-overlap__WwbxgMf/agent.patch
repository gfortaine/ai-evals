new file mode 100644
index 0000000..a37f6a8
--- /dev/null
+++ b/app/mailers/notification/bundle_mailer.rb
@@ -0,0 +1,36 @@
+class Notification::BundleMailer < ApplicationMailer
+  helper NotificationsHelper, ExcerptHelper
+
+  def notification(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.notifications.unread.preloaded.ordered.to_a
+
+    return if @notifications.empty? || @user.identity&.email_address.blank?
+
+    @notifications_by_board = @notifications.group_by { |notification| notification.card.board }
+
+    mail(
+      to: @user.identity.email_address,
+      subject: subject_for(@notifications, @account)
+    )
+  end
+
+  private
+    def default_url_options
+      if @account
+        super.merge(script_name: @account.slug)
+      else
+        super
+      end
+    end
+
+    def subject_for(notifications, account)
+      if notifications.one?
+        "#{account.name}: #{notifications.first.payload.title}"
+      else
+        "#{account.name}: #{notifications.size} new notifications"
+      end
+    end
+end
