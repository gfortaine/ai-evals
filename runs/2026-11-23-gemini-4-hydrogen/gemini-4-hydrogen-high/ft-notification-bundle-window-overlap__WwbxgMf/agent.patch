+class Notification::BundleMailerPreview < ActionMailer::Preview
+  def notification
+    bundle = Notification::Bundle.joins(:notifications).first ||
+      Notification::Bundle.new(user: User.active.first, starts_at: 4.hours.ago, ends_at: Time.current)
+    Current.account = bundle.account
+    Notification::BundleMailer.notification(bundle)
+  end
+end
