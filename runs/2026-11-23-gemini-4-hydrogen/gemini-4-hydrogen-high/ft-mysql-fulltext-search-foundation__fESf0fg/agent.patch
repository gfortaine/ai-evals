diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..9357e30
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,55 @@
+<% matching_comments = matching_comments_for_search(card, terms) %>
+
+<%= tag.article id: dom_id(card, :search_result), class: "search__result", style: "--card-color: #{card.closed? ? "var(--color-card-complete)" : card.color};" do %>
+  <header class="search__result-header">
+    <div class="card__board">
+      <span class="card__id">
+        <span class="for-screen-reader">Card number</span>
+        <%= card.number %>
+      </span>
+      <span class="card__board-name">
+        <span class="overflow-ellipsis"><%= card.board.name %></span>
+      </span>
+    </div>
+
+    <div class="search__result-meta txt-x-small translucent">
+      <span><%= card.creator.familiar_name %></span>
+      <span><%= local_datetime_tag(card.created_at, style: :daysago) %></span>
+      <% if card.closed? %>
+        <span class="txt-uppercase">Done</span>
+      <% elsif card.postponed? %>
+        <span class="txt-uppercase">Not now</span>
+      <% elsif card.triaged? %>
+        <span class="txt-uppercase"><%= card.column.name %></span>
+      <% end %>
+    </div>
+  </header>
+
+  <h2 class="search__result-title">
+    <%= link_to card_path(card), class: "search__result-link", data: { turbo_frame: "_top" } do %>
+      <%= highlight_search_terms(card.title, terms) %>
+    <% end %>
+  </h2>
+
+  <% if card.description.present? && (search_text_matches?(card.description, terms) || matching_comments.empty?) %>
+    <p class="search__result-excerpt">
+      <%= search_excerpt(card.description, terms) %>
+    </p>
+  <% end %>
+
+  <% if matching_comments.any? %>
+    <ul class="search__result-comments" role="list">
+      <% matching_comments.each do |comment| %>
+        <li class="search__result-comment">
+          <%= link_to comment, class: "search__result-comment-link", data: { turbo_frame: "_top" } do %>
+            <span class="search__result-comment-author">
+              <%= icon_tag "comment" %>
+              <strong><%= comment.creator.familiar_name %></strong>:
+            </span>
+            <span><%= search_excerpt(comment.body, terms) %></span>
+          <% end %>
+        </li>
+      <% end %>
+    </ul>
+  <% end %>
+<% end %>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..67f829d
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,37 @@
+<% @page_title = @search.present? ? "Search: #{@search.query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get, class: "search__form", data: { turbo_frame: "_top" } do |form| %>
+    <%= form.search_field :q,
+          value: @search.query,
+          placeholder: "Search cards by title, description, or comments…",
+          autofocus: @search.query.blank?,
+          autocorrect: "off",
+          autocomplete: "off",
+          class: "input flex-item-grow",
+          aria: { label: "Search cards" } %>
+    <%= form.button "Search", name: nil, class: "btn btn--link" %>
+  <% end %>
+
+  <% if @search.present? %>
+    <% if @page.records.any? %>
+      <div class="search__results">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { terms: @search.terms } %>
+        <% end %>
+      </div>
+    <% else %>
+      <div class="blank-slate">No cards match “<%= @search.query %>”</div>
+    <% end %>
+  <% else %>
+    <div class="blank-slate">Type a word or phrase to search cards by title, description, or comments.</div>
+  <% end %>
+</section>
