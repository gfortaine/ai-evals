diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..11bd952
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,107 @@
+module SearchesHelper
+  def highlight_search_terms(text, terms)
+    str = text.to_s
+    return ERB::Util.html_escape(str) if str.blank? || terms.blank?
+
+    regex = search_terms_regex(terms)
+
+    parts = str.split(/(#{regex})/).filter_map do |part|
+      next if part.empty?
+
+      if part.match?(/\A#{regex}\z/)
+        tag.mark(part)
+      else
+        part
+      end
+    end
+
+    safe_join(parts)
+  end
+
+  def search_excerpt(content, terms, radius: 100)
+    text = normalized_plain_text(content)
+    return "".html_safe if text.blank?
+
+    snippet = if terms.present? && (match = text.match(search_terms_regex(terms)))
+      extract_snippet_around_match(text, match, radius)
+    else
+      text.truncate(radius * 2)
+    end
+
+    highlight_search_terms(snippet, terms)
+  end
+
+  def search_text_matches?(content, terms)
+    return false if terms.blank?
+
+    text = normalized_plain_text(content)
+    text.present? && text.match?(search_terms_regex(terms))
+  end
+
+  def matching_comments_for_search(card, terms, limit: 5)
+    return [] if terms.blank?
+
+    regexes = terms.map { |term| [ term, Regexp.new(Regexp.escape(term), Regexp::IGNORECASE) ] }
+    ordered_comments = card.comments.sort_by { |comment| [ comment.created_at, comment.id ] }
+
+    matching = ordered_comments.select do |comment|
+      plain_text = normalized_plain_text(comment.body)
+      regexes.any? { |_, regex| plain_text.match?(regex) }
+    end
+
+    return matching if matching.size <= limit
+
+    uncovered = regexes.dup
+    selected = []
+
+    matching.each do |comment|
+      break if selected.size >= limit || uncovered.empty?
+
+      plain_text = normalized_plain_text(comment.body)
+      newly_covered = uncovered.select { |_, regex| plain_text.match?(regex) }
+
+      if newly_covered.any?
+        selected << comment
+        uncovered -= newly_covered
+      end
+    end
+
+    (selected + (matching - selected)).first(limit)
+  end
+
+  private
+    def search_terms_regex(terms)
+      sorted_terms = terms.sort_by { |term| -term.length }
+      Regexp.union(sorted_terms.map { |term| Regexp.new(Regexp.escape(term), Regexp::IGNORECASE) })
+    end
+
+    def normalized_plain_text(content)
+      return "" if content.blank?
+
+      text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+      text.gsub(/\s+/, " ").strip
+    end
+
+    def extract_snippet_around_match(text, match, radius)
+      match_start = match.begin(0)
+      match_end = match.end(0)
+
+      start = [ match_start - radius, 0 ].max
+      finish = [ match_end + radius, text.length ].min
+
+      if start > 0
+        space_index = text.index(" ", start)
+        start = space_index + 1 if space_index && space_index < match_start && (space_index - start) < 20
+      end
+
+      if finish < text.length
+        space_index = text.rindex(" ", finish)
+        finish = space_index if space_index && space_index > match_end && (finish - space_index) < 20
+      end
+
+      snippet = text[start...finish]
+      snippet = "…#{snippet}" if start > 0
+      snippet = "#{snippet}…" if finish < text.length
+      snippet
+    end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..df1b596
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,143 @@
+class Search
+  BATCH_SIZE = 500
+
+  attr_reader :user, :query, :terms
+
+  def initialize(user:, query:)
+    @user = user
+    @query = query.to_s.strip
+    @terms = parse_terms(@query)
+  end
+
+  def cards
+    @cards ||= if terms.any?
+      matching_cards.preloaded.preload(comments: [ :creator, :rich_text_body ]).reverse_chronologically
+    else
+      Card.none
+    end
+  end
+
+  def present?
+    query.present?
+  end
+
+  private
+    def parse_terms(raw_query)
+      raw_query
+        .scan(/"([^"]*)"|(\S+)/)
+        .flatten
+        .compact
+        .reject(&:blank?)
+        .uniq(&:downcase)
+    end
+
+    def matching_cards
+      ids = verified_matching_card_ids
+      if ids.any?
+        base_cards.where(id: ids)
+      else
+        Card.none
+      end
+    end
+
+    def verified_matching_card_ids
+      candidate_ids = candidate_cards.pluck(:id)
+      return [] if candidate_ids.empty?
+
+      candidate_ids.each_slice(BATCH_SIZE).flat_map do |batch_ids|
+        filter_plain_text_matches(batch_ids)
+      end
+    end
+
+    def candidate_cards
+      terms.reduce(base_cards) do |relation, term|
+        term.split(/\s+/).reject(&:blank?).reduce(relation) do |scoped, word|
+          scoped.where(*word_sql_condition(word))
+        end
+      end.reverse_chronologically
+    end
+
+    def base_cards
+      user.accessible_cards.published.where(cards: { account_id: user.account_id })
+    end
+
+    def word_sql_condition(word)
+      pattern = like_pattern(word)
+      html_pattern = like_pattern(ERB::Util.html_escape(word))
+
+      rich_text_sql, rich_text_bindings = if html_pattern == pattern
+        [ "action_text_rich_texts.body LIKE ? ESCAPE '!'", [ pattern ] ]
+      else
+        [ "(action_text_rich_texts.body LIKE ? ESCAPE '!' OR action_text_rich_texts.body LIKE ? ESCAPE '!')", [ pattern, html_pattern ] ]
+      end
+
+      sql = <<~SQL.squish
+        (
+          cards.title LIKE ? ESCAPE '!'
+          OR EXISTS (
+            SELECT 1 FROM action_text_rich_texts
+            WHERE action_text_rich_texts.record_type = 'Card'
+              AND action_text_rich_texts.record_id = cards.id
+              AND action_text_rich_texts.name = 'description'
+              AND #{rich_text_sql}
+          )
+          OR EXISTS (
+            SELECT 1 FROM comments
+            INNER JOIN action_text_rich_texts
+              ON action_text_rich_texts.record_type = 'Comment'
+              AND action_text_rich_texts.record_id = comments.id
+              AND action_text_rich_texts.name = 'body'
+            WHERE comments.card_id = cards.id
+              AND #{rich_text_sql}
+          )
+        )
+      SQL
+
+      [ sql, pattern, *rich_text_bindings, *rich_text_bindings ]
+    end
+
+    def like_pattern(value)
+      "%#{ActiveRecord::Base.sanitize_sql_like(value, "!")}%"
+    end
+
+    def filter_plain_text_matches(batch_ids)
+      titles = Card.where(id: batch_ids).pluck(:id, :title).to_h
+
+      descriptions = ActionText::RichText
+        .where(record_type: "Card", record_id: batch_ids, name: "description")
+        .pluck(:record_id, :body)
+        .to_h { |id, body| [ id, plain_text_of(body) ] }
+
+      comments_by_card = Hash.new { |hash, key| hash[key] = [] }
+      Comment
+        .where(card_id: batch_ids)
+        .joins(:rich_text_body)
+        .pluck(:card_id, "action_text_rich_texts.body")
+        .each { |card_id, body| comments_by_card[card_id] << plain_text_of(body) }
+
+      term_regexes = terms.map { |term| Regexp.new(Regexp.escape(term), Regexp::IGNORECASE) }
+
+      batch_ids.select do |card_id|
+        texts = [
+          normalize_text(titles[card_id]),
+          descriptions[card_id].to_s,
+          *comments_by_card[card_id]
+        ]
+
+        term_regexes.all? do |regex|
+          texts.any? { |text| text.match?(regex) }
+        end
+      end
+    end
+
+    def plain_text_of(body)
+      return "" if body.blank?
+
+      content = body.respond_to?(:to_plain_text) ? body : ActionText::Content.new(body.to_s)
+      normalize_text(content.to_plain_text)
+    end
+
+    def normalize_text(text)
+      text.to_s.gsub(/\s+/, " ").strip
+    end
+end
