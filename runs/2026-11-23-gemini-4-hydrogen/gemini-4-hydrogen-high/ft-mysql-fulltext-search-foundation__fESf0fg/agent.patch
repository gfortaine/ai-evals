+  .search__result-meta {
+    display: flex;
+    flex-wrap: wrap;
+    gap: var(--inline-space);
+  }
+
+  .search__result-title {
+    font-size: var(--text-medium);
+    font-weight: 700;
+    line-height: 1.3;
+    margin: 0;
+  }
+
+  .search__result-link {
+    color: var(--color-ink);
+    text-decoration: none;
+
+    &:hover {
+      color: var(--color-link);
+      text-decoration: underline;
+    }
+  }
+
+  .search__result-excerpt {
+    color: var(--color-ink-darker);
+    font-size: var(--text-small);
+    line-height: 1.45;
+    margin: 0;
+  }
+
+  .search__result-comments {
+    border-block-start: 1px solid var(--color-ink-lighter);
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space-half);
+    margin-block-start: var(--block-space-half);
+    padding-block-start: var(--block-space-half);
+  }
+
+  .search__result-comment-link {
+    color: var(--color-ink-darker);
+    display: block;
+    font-size: var(--text-small);
+    line-height: 1.45;
+    text-decoration: none;
+
+    &:hover {
+      color: var(--color-ink);
+    }
+  }
+
+  .search__result-comment-author {
+    color: var(--color-ink);
+
+    .icon {
+      --icon-size: 0.9em;
+      margin-inline-end: 0.25ch;
+      vertical-align: text-top;
+    }
+  }
+}
