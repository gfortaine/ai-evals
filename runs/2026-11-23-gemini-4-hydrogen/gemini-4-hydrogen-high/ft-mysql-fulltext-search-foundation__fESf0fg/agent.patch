diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..9014729
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,214 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.session = sessions(:david)
+    @david = users(:david)
+    @kevin = users(:kevin)
+    @writebook = boards(:writebook)
+    @private_board = boards(:private)
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path(q: "logo")
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "show without query renders search form with no results" do
+    get search_path
+    assert_response :success
+    assert_select "form[action=?][method='get']", search_path
+    assert_select "input[name='q']"
+    assert_select ".search__result", count: 0
+  end
+
+  test "finds card by title and wraps matched words in mark" do
+    get search_path, params: { q: "logo" }
+    assert_response :success
+    assert_select ".search__result", count: 1
+    assert_select ".search__result mark", text: "logo"
+  end
+
+  test "finds card by description and wraps matched words in mark" do
+    @writebook.cards.create!(
+      title: "Performance tuning",
+      description: "Investigate database bottleneck in reports",
+      creator: @david,
+      status: :published
+    )
+
+    get search_path, params: { q: "bottleneck" }
+    assert_response :success
+    assert_select ".search__result", count: 1
+    assert_select ".search__result-title", text: /Performance tuning/
+    assert_select ".search__result mark", text: "bottleneck"
+  end
+
+  test "finds card by comment body and wraps matched words in mark" do
+    get search_path, params: { q: "overflowing" }
+    assert_response :success
+    assert_select ".search__result", count: 1
+    assert_select ".search__result-title", text: /Layout is broken/
+    assert_select ".search__result mark", text: "overflowing"
+  end
+
+  test "highlights matched words in long descriptions or comments" do
+    long_prefix = "word " * 100
+    @writebook.cards.create!(
+      title: "Long content card",
+      description: "#{long_prefix} needle #{long_prefix}",
+      creator: @david,
+      status: :published
+    )
+
+    get search_path, params: { q: "needle" }
+    assert_response :success
+    assert_select ".search__result mark", text: "needle"
+  end
+
+  test "preserves original casing inside mark tags" do
+    @writebook.cards.create!(title: "CamelCase Title", creator: @david, status: :published)
+
+    get search_path, params: { q: "camelcase" }
+    assert_response :success
+    assert_select ".search__result mark", text: "CamelCase"
+  end
+
+  test "highlights multiple matched words" do
+    @writebook.cards.create!(
+      title: "Broken widget",
+      description: "Needs urgent repair",
+      creator: @david,
+      status: :published
+    )
+
+    get search_path, params: { q: "broken repair" }
+    assert_response :success
+    assert_select ".search__result mark", text: "Broken"
+    assert_select ".search__result mark", text: "repair"
+  end
+
+  test "escapes HTML in card content and search terms" do
+    @writebook.cards.create!(
+      title: "<script>alert('xss')</script> widget",
+      creator: @david,
+      status: :published
+    )
+
+    get search_path, params: { q: "widget" }
+    assert_response :success
+    assert_no_match(/<script>alert/, response.body)
+    assert_select ".search__result mark", text: "widget"
+  end
+
+  test "orders results newest first" do
+    older = @writebook.cards.create!(title: "Ordercheck older", creator: @david, status: :published, created_at: 2.days.ago)
+    newer = @writebook.cards.create!(title: "Ordercheck newer", creator: @david, status: :published, created_at: 1.day.ago)
+
+    get search_path, params: { q: "Ordercheck" }
+    assert_response :success
+
+    body = response.body
+    assert body.index(dom_id(newer, :search_result)) < body.index(dom_id(older, :search_result))
+  end
+
+  test "enforces current board access" do
+    @private_board.cards.create!(title: "Secret board card", creator: @kevin, status: :published)
+
+    get search_path, params: { q: "Secret" }
+    assert_response :success
+    assert_select ".search__result", count: 0
+
+    @private_board.accesses.grant_to(@david)
+    get search_path, params: { q: "Secret" }
+    assert_response :success
+    assert_select ".search__result", count: 1
+
+    @private_board.accesses.revoke_from(@david)
+    get search_path, params: { q: "Secret" }
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "never turns up draft cards or their comments" do
+    draft = @writebook.cards.create!(
+      title: "Unpublished draft card",
+      description: "Hidden draft details",
+      creator: @david,
+      status: :drafted
+    )
+    Comment.insert_all!([
+      {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: @david.account_id,
+        card_id: draft.id,
+        creator_id: @david.id,
+        created_at: Time.current,
+        updated_at: Time.current
+      }
+    ])
+    ActionText::RichText.create!(
+      account_id: @david.account_id,
+      record: draft.comments.first!,
+      name: "body",
+      body: "Hidden draft comment"
+    )
+
+    get search_path, params: { q: "Unpublished" }
+    assert_response :success
+    assert_select ".search__result", count: 0
+
+    get search_path, params: { q: "Hidden draft comment" }
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "json format returns matching cards" do
+    get search_path(format: :json), params: { q: "logo" }
+    assert_response :success
+    json = JSON.parse(response.body)
+    assert_equal [ cards(:logo).id ], json.map { |card| card["id"] }
+  end
+
+  test "paginates results newest first across pages" do
+    cards = 18.times.map do |i|
+      @writebook.cards.create!(
+        title: "Paginated item #{i}",
+        creator: @david,
+        status: :published,
+        created_at: (20 - i).hours.ago
+      )
+    end
+
+    get search_path, params: { q: "Paginated" }
+    assert_response :success
+    assert_select ".search__result", count: 15
+    assert_includes response.body, dom_id(cards.last, :search_result)
+    assert_not_includes response.body, dom_id(cards.first, :search_result)
+
+    get search_path, params: { q: "Paginated", page: 2 }
+    assert_response :success
+    assert_select ".search__result", count: 3
+    assert_includes response.body, dom_id(cards.first, :search_result)
+  end
+
+  test "highlights matched terms when many comments match" do
+    card = @writebook.cards.create!(title: "Many comments card", creator: @david, status: :published)
+    6.times { card.comments.create!(body: "First keyword alpha", creator: @david) }
+    card.comments.create!(body: "Second keyword omega", creator: @david)
+
+    get search_path, params: { q: "alpha omega" }
+    assert_response :success
+    assert_select ".search__result mark", text: "alpha"
+    assert_select ".search__result mark", text: "omega"
+  end
+
+  test "displays empty state when no cards match" do
+    get search_path, params: { q: "zzzznonexistent" }
+    assert_response :success
+    assert_select ".search__result", count: 0
+    assert_select ".blank-slate", text: /zzzznonexistent/
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..0671e0b
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,211 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @david = users(:david)
+    @kevin = users(:kevin)
+    @writebook = boards(:writebook)
+    @private_board = boards(:private)
+  end
+
+  test "finds cards by title" do
+    results = @david.search("logo").cards
+    assert_includes results, cards(:logo)
+    assert_not_includes results, cards(:layout)
+  end
+
+  test "finds cards by description" do
+    card = @writebook.cards.create!(title: "Unrelated title", description: "Contains a secret pineapple recipe", creator: @david, status: :published)
+
+    results = @david.search("pineapple").cards
+    assert_equal [ card ], results.to_a
+  end
+
+  test "finds cards by any comment body" do
+    results = @david.search("overflowing").cards
+    assert_equal [ cards(:layout) ], results.to_a
+  end
+
+  test "finds cards case-insensitively" do
+    results = @david.search("LOGO").cards
+    assert_includes results, cards(:logo)
+  end
+
+  test "finds cards matching multiple words across title, description, and comments" do
+    card = @writebook.cards.create!(title: "Alpha feature", description: "Beta details", creator: @david, status: :published)
+    card.comments.create!(body: "Gamma discussion", creator: @david)
+
+    assert_equal [ card ], @david.search("alpha gamma").cards.to_a
+    assert_equal [ card ], @david.search("gamma beta alpha").cards.to_a
+    assert_empty @david.search("alpha nonexistent").cards
+  end
+
+  test "supports quoted phrases" do
+    matching = @writebook.cards.create!(title: "Big enough logo", creator: @david, status: :published)
+    non_matching = @writebook.cards.create!(title: "Enough big logo", creator: @david, status: :published)
+
+    results = @david.search('"big enough"').cards.to_a
+    assert_includes results, matching
+    assert_not_includes results, non_matching
+  end
+
+  test "does not match HTML tags or attributes inside rich text" do
+    card = @writebook.cards.create!(
+      title: "Plain title",
+      description: '<div class="custom-wrapper"><a href="https://example.com">Click here</a></div>',
+      creator: @david,
+      status: :published
+    )
+
+    assert_empty @david.search("div").cards
+    assert_empty @david.search("href").cards
+    assert_empty @david.search("custom-wrapper").cards
+    assert_equal [ card ], @david.search("Click").cards.to_a
+  end
+
+  test "handles special SQL LIKE and regex characters safely" do
+    card = @writebook.cards.create!(
+      title: "100% progress_check & (test)",
+      description: "Tom & Jerry <tag> [bracket]",
+      creator: @david,
+      status: :published
+    )
+
+    assert_equal [ card ], @david.search("100%").cards.to_a
+    assert_equal [ card ], @david.search("progress_check").cards.to_a
+    assert_equal [ card ], @david.search("(test)").cards.to_a
+    assert_equal [ card ], @david.search("Tom & Jerry").cards.to_a
+    assert_empty @david.search("%").cards.where.not(id: card.id)
+  end
+
+  test "orders results newest first" do
+    older = @writebook.cards.create!(title: "Chronology check", creator: @david, status: :published, created_at: 3.days.ago)
+    middle = @writebook.cards.create!(title: "Chronology check", creator: @david, status: :published, created_at: 2.days.ago)
+    newer = @writebook.cards.create!(title: "Chronology check", creator: @david, status: :published, created_at: 1.day.ago)
+
+    assert_equal [ newer, middle, older ], @david.search("Chronology").cards.to_a
+  end
+
+  test "does not return duplicate cards when term matches in multiple places" do
+    card = @writebook.cards.create!(title: "Duplicate check", description: "Duplicate check", creator: @david, status: :published)
+    card.comments.create!(body: "Duplicate check one", creator: @david)
+    card.comments.create!(body: "Duplicate check two", creator: @david)
+
+    results = @david.search("Duplicate").cards.to_a
+    assert_equal [ card ], results
+  end
+
+  test "only returns cards from boards the user currently has access to" do
+    private_card = @private_board.cards.create!(title: "Classified project", creator: @kevin, status: :published)
+
+    assert_includes @kevin.search("Classified").cards, private_card
+    assert_not_includes @david.search("Classified").cards, private_card
+
+    @private_board.accesses.grant_to(@david)
+    assert_includes @david.search("Classified").cards, private_card
+
+    @private_board.accesses.revoke_from(@david)
+    assert_not_includes @david.search("Classified").cards, private_card
+  end
+
+  test "reflects card board moves immediately in access checks" do
+    card = @writebook.cards.create!(title: "Relocated card", creator: @kevin, status: :published)
+    assert_includes @david.search("Relocated").cards, card
+
+    card.move_to(@private_board)
+    assert_not_includes @david.search("Relocated").cards, card
+    assert_includes @kevin.search("Relocated").cards, card
+  end
+
+  test "never returns cards from other accounts" do
+    results = @david.search("paycheck").cards
+    assert_empty results
+  end
+
+  test "never returns draft cards or comments on draft cards" do
+    draft = @writebook.cards.create!(
+      title: "Secret draft title",
+      description: "Secret draft description",
+      creator: @david,
+      status: :drafted
+    )
+    Comment.insert_all!([
+      {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: @david.account_id,
+        card_id: draft.id,
+        creator_id: @david.id,
+        created_at: Time.current,
+        updated_at: Time.current
+      }
+    ])
+    draft_comment = draft.comments.first!
+    ActionText::RichText.create!(
+      account_id: @david.account_id,
+      record: draft_comment,
+      name: "body",
+      body: "Secret draft comment body"
+    )
+
+    assert_empty @david.search("Secret").cards
+    assert_empty @david.search("draft title").cards
+    assert_empty @david.search("draft description").cards
+    assert_empty @david.search("draft comment").cards
+  end
+
+  test "includes published cards regardless of closed or postponed state" do
+    closed_card = @writebook.cards.create!(title: "Zebra closed", creator: @david, status: :published)
+    closed_card.close(user: @david)
+
+    postponed_card = @writebook.cards.create!(title: "Zebra postponed", creator: @david, status: :published)
+    postponed_card.postpone(user: @david)
+
+    results = @david.search("Zebra").cards.to_a
+    assert_includes results, closed_card
+    assert_includes results, postponed_card
+  end
+
+  test "blank query returns no cards" do
+    assert_empty @david.search("").cards
+    assert_empty @david.search("   ").cards
+    assert_empty @david.search(nil).cards
+  end
+
+  test "finds card after draft is published and orders by publish time" do
+    older_published = @writebook.cards.create!(title: "Launchpad alpha", creator: @david, status: :published, created_at: 2.days.ago)
+    draft = @writebook.cards.create!(title: "Launchpad beta", creator: @david, status: :drafted, created_at: 5.days.ago)
+
+    assert_equal [ older_published ], @david.search("Launchpad").cards.to_a
+
+    draft.publish
+    assert_equal [ draft, older_published ], @david.search("Launchpad").cards.to_a
+  end
+
+  test "reflects comment updates and deletions immediately" do
+    card = @writebook.cards.create!(title: "Mutable comment card", creator: @david, status: :published)
+    comment = card.comments.create!(body: "Initial xylophone mention", creator: @david)
+
+    assert_equal [ card ], @david.search("xylophone").cards.to_a
+
+    comment.update!(body: "Updated marimba mention")
+    assert_empty @david.search("xylophone").cards
+    assert_equal [ card ], @david.search("marimba").cards.to_a
+
+    comment.destroy!
+    assert_empty @david.search("marimba").cards
+  end
+
+  test "finds cards with rich formatted descriptions and UTF-8 characters" do
+    card = @writebook.cards.create!(
+      title: "Café menu",
+      description: '<p>Fix the <strong>broken</strong> <a href="https://example.com">navbar</a> 🚀</p>',
+      creator: @david,
+      status: :published
+    )
+
+    assert_equal [ card ], @david.search("broken navbar").cards.to_a
+    assert_equal [ card ], @david.search("Café").cards.to_a
+    assert_equal [ card ], @david.search("🚀").cards.to_a
+  end
+end
