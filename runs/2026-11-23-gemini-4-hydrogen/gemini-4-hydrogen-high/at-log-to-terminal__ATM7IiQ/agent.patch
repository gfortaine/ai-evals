+++ b/test/lib/runner_logger_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class RunnerLoggerTest < ActiveSupport::TestCase
+  test "load_runner broadcasts Rails.logger to stdout while keeping existing log target" do
+    existing_io = StringIO.new
+    captured_stdout = StringIO.new
+
+    existing_logger = ActiveSupport::Logger.new(existing_io)
+    existing_logger.level = Logger::INFO
+    broadcast = ActiveSupport::BroadcastLogger.new(existing_logger)
+
+    original_logger = Rails.logger
+    original_stdout = $stdout
+    begin
+      Rails.logger = broadcast
+      $stdout = captured_stdout
+
+      Rails.application.load_runner
+
+      assert_equal 2, Rails.logger.broadcasts.size
+      assert_equal Logger::INFO, Rails.logger.level
+
+      Rails.logger.debug "suppressed debug"
+      Rails.logger.info "Library report: 1 book"
+      Rails.logger.warn "Library report: Empty has no pages"
+
+      expected = "Library report: 1 book\nLibrary report: Empty has no pages\n"
+      assert_equal expected, captured_stdout.string
+      assert_equal expected, existing_io.string
+    ensure
+      $stdout = original_stdout
+      Rails.logger = original_logger
+    end
+  end
+
+  test "load_runner does not duplicate stdout when logger already outputs to stdout" do
+    stdout_logger = ActiveSupport::Logger.new(STDOUT)
+    broadcast = ActiveSupport::BroadcastLogger.new(stdout_logger)
+
+    original_logger = Rails.logger
+    begin
+      Rails.logger = broadcast
+      Rails.application.load_runner
+      assert_equal 1, Rails.logger.broadcasts.size
+    ensure
+      Rails.logger = original_logger
+    end
+  end
+end
