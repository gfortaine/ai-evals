+require "application_system_test_case"
+
+class ImportExportTest < ApplicationSystemTestCase
+  test "exporting a quiz as JSON and importing it as a new quiz" do
+    visit "/moderate"
+    click_button "New quiz"
+    fill_in "Title", with: "Frontend Fest 2026"
+    click_button "Save quiz"
+
+    click_button "Add question"
+    fill_in "Question", with: 'Which HTTP status code means "Too Many Requests"?'
+    fill_in "Option 1", with: "418"
+    fill_in "Option 2", with: "429"
+    check "Option 2 is correct"
+    click_button "Save question"
+
+    click_button "Add question"
+    fill_in "Question", with: "Hidden question?"
+    fill_in "Option 1", with: "Yes"
+    check "Option 1 is correct"
+    fill_in "Option 2", with: "No"
+    uncheck "Active"
+    click_button "Save question"
+
+    original_quiz = Quiz.find_by!(title: "Frontend Fest 2026")
+
+    click_link "Export"
+    assert_selector "pre", count: 1
+    exported_json = find("pre").text
+
+    parsed = JSON.parse(exported_json)
+    assert_equal [ "title", "questions" ], parsed.keys
+    assert_equal "Frontend Fest 2026", parsed["title"]
+    assert_equal 2, parsed["questions"].size
+    assert_equal(
+      {
+        "text" => 'Which HTTP status code means "Too Many Requests"?',
+        "active" => true,
+        "options" => [
+          { "text" => "418", "correct" => false },
+          { "text" => "429", "correct" => true }
+        ]
+      },
+      parsed["questions"][0]
+    )
+    assert_equal(
+      {
+        "text" => "Hidden question?",
+        "active" => false,
+        "options" => [
+          { "text" => "Yes", "correct" => true },
+          { "text" => "No", "correct" => false }
+        ]
+      },
+      parsed["questions"][1]
+    )
+
+    visit "/moderate"
+    click_button "Import quiz"
+
+    # Invalid JSON shows error and preserves input without creating a quiz
+    fill_in "Quiz JSON", with: "{invalid"
+    click_button "Import"
+    assert_selector ".errors"
+    assert_field "Quiz JSON", with: "{invalid"
+    assert_equal 1, Quiz.count
+
+    # Rule violation on second question imports nothing
+    partial_invalid = {
+      title: "Should Not Exist",
+      questions: [
+        { text: "Valid Q", options: [ { text: "A", correct: true }, { text: "B" } ] },
+        { text: "Invalid Q", options: [ { text: "Only A" }, { text: "Only B" } ] }
+      ]
+    }.to_json
+    fill_in "Quiz JSON", with: partial_invalid
+    click_button "Import"
+    assert_selector ".errors", text: "Mark at least one option as correct"
+    assert_field "Quiz JSON", with: partial_invalid
+    assert_equal 1, Quiz.count
+    assert_equal 2, Question.count
+
+    # Import exported JSON -> creates a brand new quiz with same title and opens its page
+    fill_in "Quiz JSON", with: exported_json
+    click_button "Import"
+
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_text "1 of 2 questions active"
+    assert_equal 2, Quiz.count
+    imported_quiz = Quiz.order(:id).last
+    assert_not_equal original_quiz.id, imported_quiz.id
+    assert_current_path "/moderate/quizzes/#{imported_quiz.id}"
+
+    items = all("ul.question-list > li")
+    assert_equal 2, items.size
+    within(items[0]) do
+      assert_text 'Which HTTP status code means "Too Many Requests"?'
+      assert_text "A. 418"
+      assert_text "B. 429"
+      assert_selector "li.is-correct", text: "B. 429"
+      assert_checked_field "Active"
+    end
+    within(items[1]) do
+      assert_text "Hidden question?"
+      assert_text "A. Yes"
+      assert_text "B. No"
+      assert_selector "li.is-correct", text: "A. Yes"
+      assert_no_checked_field "Active"
+    end
+  end
+
+  test "importing quiz JSON with optional active and correct omitted" do
+    visit "/moderate"
+    click_button "Import quiz"
+
+    minimal_json = {
+      title: "Minimal Quiz",
+      questions: [
+        {
+          text: "First question",
+          options: [
+            { text: "Option A" },
+            { text: "Option B", correct: true }
+          ]
+        }
+      ]
+    }.to_json
+
+    fill_in "Quiz JSON", with: minimal_json
+    click_button "Import"
