+class FinishExpiredQuestionJob < ApplicationJob
+  queue_as :default
+
+  def perform(game_id, game_question_id)
+    game = Game.find_by(id: game_id)
+    return unless game
+
+    if game.expire_question_if_needed!(expected_question_id: game_question_id)
+      GameBroadcaster.broadcast_moderator_stage(game)
+      GameBroadcaster.broadcast_players_stage(game)
+    end
+  end
+end
