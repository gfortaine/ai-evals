@@ -0,0 +1,121 @@
+require "application_system_test_case"
+
+class QuestionTimerTest < ApplicationSystemTestCase
+  setup do
+    @quiz = Quiz.create!(title: "Timed Talk Quiz")
+
+    @q1 = @quiz.questions.create!(body: "First timed question?", active: true)
+    @q1.assign_option_rows({
+      "0" => { "body" => "Alpha", "correct" => "1" },
+      "1" => { "body" => "Beta", "correct" => "0" }
+    })
+    @q1.save_with_options!
+
+    @q2 = @quiz.questions.create!(body: "Second timed question?", active: true)
+    @q2.assign_option_rows({
+      "0" => { "body" => "Gamma", "correct" => "1" },
+      "1" => { "body" => "Delta", "correct" => "0" }
+    })
+    @q2.save_with_options!
+  end
+
+  test "configuring timer, live M:SS countdown, reload persistence, auto-finish at 0:00, and early finish" do
+    visit moderate_quiz_path(@quiz)
+    click_link "Settings"
+
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+
+    fill_in "Timer minutes", with: "-1"
+    click_button "Save quiz"
+    assert_selector ".errors", text: "Timer minutes"
+
+    fill_in "Timer minutes", with: "0"
+    fill_in "Timer seconds", with: "4"
+    click_button "Save quiz"
+    assert_text "0:04 timer"
+
+    # Export format does not include timer settings
+    click_link "Export"
+    export_json = JSON.parse(find("pre.code-block").text)
+    assert_not export_json.key?("timer_minutes")
+    assert_not export_json.key?("timer_seconds")
+    assert_not export_json.key?("timer")
+
+    visit moderate_quiz_path(@quiz)
+    click_button "Start a game"
+    join_url = find(".lobby__url").text.strip
+
+    # Lobby has no timer
+    assert_no_selector "[role='timer']"
+
+    # Player joins
+    Capybara.using_session(:alice) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    assert_text "Players: 1"
+
+    # Start Q1 -> countdown in M:SS format shown on big screen, hidden from player
+    click_button "Start"
+    assert_text "Question 1 of 2"
+    timer_text = find("[role='timer']").text.strip
+    assert_match(/\A0:0[34]\z/, timer_text)
+
+    Capybara.using_session(:alice) do
+      assert_text "First timed question?"
+      assert_no_selector "[role='timer']"
+      assert_no_text "0:04"
+      assert_no_text "0:03"
+      click_button "Alpha"
+      within("button.play-option", text: "Alpha") { assert_text "Your answer" }
+    end
+
+    # Wait 1.5s then reload the moderator page -> timer must NOT reset back to 0:04
+    sleep 1.5
+    visit current_url
+    assert_text "Question 1 of 2"
+    reloaded_text = find("[role='timer']").text.strip
+    assert_match(/\A0:0[123]\z/, reloaded_text)
+    assert_operator reloaded_text, :<, "0:04"
+
+    # Wait for countdown to reach 0:00 and auto-finish without clicking "Finish"
+    assert_button "Next", wait: 6
+    assert_no_selector "[role='timer']"
+    within("li.stage-option", text: "Alpha") do
+      assert_text "Correct"
+      assert_text "1"
+    end
+
+    Capybara.using_session(:alice) do
+      assert_text "Correct!"
+    end
+
+    # Question 2: moderator can still click "Finish" early before timer expires
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30) # should not affect running game
+    click_button "Next"
+    assert_text "Question 2 of 2"
+    assert_match(/\A0:0[34]\z/, find("[role='timer']").text.strip)
+
+    click_button "Finish"
+    assert_button "End quiz"
+    assert_no_selector "[role='timer']"
+
+    Capybara.using_session(:alice) do
+      assert_text "No answer"
+    end
+  end
+
+  test "0 minutes and 0 seconds means no timer" do
+    visit moderate_quiz_path(@quiz)
+    click_button "Start a game"
+    click_button "Start"
+
+    assert_text "Question 1 of 2"
+    assert_no_selector "[role='timer']"
+    assert_button "Finish"
+  end
+end
