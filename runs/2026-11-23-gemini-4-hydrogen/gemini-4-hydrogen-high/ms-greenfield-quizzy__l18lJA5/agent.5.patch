@@ -0,0 +1,67 @@
+require "test_helper"
+
+class QuizTimerTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    @quiz = Quiz.create!(title: "Timer Quiz")
+    @q1 = @quiz.questions.create!(body: "Q1?", active: true)
+    @q1.assign_option_rows("0" => { "body" => "A", "correct" => "1" }, "1" => { "body" => "B", "correct" => "0" })
+    @q1.save_with_options!
+  end
+
+  test "timer defaults to 0 minutes and 0 seconds and rejects negative or non-integer values" do
+    assert_equal 0, @quiz.timer_minutes
+    assert_equal 0, @quiz.timer_seconds
+    assert_not @quiz.timer_enabled?
+
+    [ -1, 1.5, nil, "" ].each do |invalid|
+      @quiz.timer_minutes = invalid
+      assert_not @quiz.valid?
+    end
+
+    @quiz.timer_minutes = 1
+    [ -1, 1.5, nil, "" ].each do |invalid|
+      @quiz.timer_seconds = invalid
+      assert_not @quiz.valid?
+    end
+
+    @quiz.timer_seconds = 30
+    assert @quiz.valid?
+    assert @quiz.timer_enabled?
+    assert_equal 90, @quiz.question_timer_seconds
+    assert_equal "1:30", @quiz.formatted_timer
+  end
+
+  test "export_payload omits timer settings" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    payload = @quiz.export_payload
+    assert_equal [ :title, :questions ], payload.keys
+  end
+
+  test "game snapshots timer and schedules FinishExpiredQuestionJob only when timer is enabled" do
+    assert_no_enqueued_jobs(only: FinishExpiredQuestionJob) do
+      untimed = Game.create_from_quiz!(@quiz)
+      assert_equal 0, untimed.question_timer_seconds
+      assert_not untimed.timer_enabled?
+      untimed.start!
+    end
+
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    game = Game.create_from_quiz!(@quiz)
+    assert_equal 90, game.question_timer_seconds
+    assert game.timer_enabled?
+
+    # Editing quiz later does not alter existing game
+    @quiz.update!(timer_minutes: 0, timer_seconds: 5)
+    assert_equal 90, game.reload.question_timer_seconds
+
+    travel_to Time.zone.local(2026, 11, 23, 12, 0, 0) do
+      assert_enqueued_with(job: FinishExpiredQuestionJob) do
+        game.start!
+      end
+      assert_equal 90, game.timer_remaining_seconds
+    end
+  end
+end
