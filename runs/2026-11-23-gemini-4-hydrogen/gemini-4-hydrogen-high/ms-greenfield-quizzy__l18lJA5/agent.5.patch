+
+  setup do
+    @prev_user = ENV["QUIZZY_MODERATOR_USERNAME"]
+    @prev_pass = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "mod"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "secret"
+    @auth = { "Authorization" => "Basic #{Base64.strict_encode64("mod:secret")}" }
+
+    @quiz = Quiz.create!(title: "Timer Integration Quiz", timer_minutes: 1, timer_seconds: 30)
+    @q = @quiz.questions.create!(body: "Time check?", active: true)
+    @q.assign_option_rows({
+      "0" => { "body" => "Yes", "correct" => "1" },
+      "1" => { "body" => "No", "correct" => "0" }
+    })
+    @q.save_with_options!
+  end
+
+  teardown do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = @prev_user
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = @prev_pass
+  end
+
+  test "big screen shows M:SS countdown, player never sees timer, and late answers after expiry close question" do
+    game = Game.create_from_quiz!(@quiz)
+    post join_play_game_path(game.code), params: { name: "Alice" }
+    follow_redirect!
+    assert_response :success
+
+    travel_to Time.zone.local(2026, 11, 23, 12, 0, 0) do
+      post start_moderate_game_path(game), headers: @auth
+      assert_redirected_to moderate_game_path(game)
+
+      get moderate_game_path(game), headers: @auth
+      assert_response :success
+      assert_includes response.body, "1:30"
+      assert_includes response.body, 'role="timer"'
+
+      # Player page never shows timer
+      get play_game_path(game.code)
+      assert_response :success
+      assert_not_includes response.body, "1:30"
+      assert_not_includes response.body, 'role="timer"'
+      assert_not_includes response.body, "question-timer"
+
+      # 85 seconds later -> reload shows 0:05
+      travel 85.seconds
+      get moderate_game_path(game), headers: @auth
+      assert_response :success
+      assert_includes response.body, "0:05"
+
+      # 5 more seconds -> expired! Late answer attempt is rejected and question closes
+      travel 5.seconds
+      opt = game.reload.current_question.game_options.find_by!(correct: true)
+      post answer_play_game_path(game.code), params: {
+        game_question_id: game.current_question.id,
+        game_option_id: opt.id
+      }
+      assert game.reload.question_closed?
+      assert_equal 0, game.answers.count
+
+      # Reloading big screen shows closed state without timer
+      get moderate_game_path(game), headers: @auth
+      assert_response :success
+      assert_not_includes response.body, 'role="timer"'
+      assert_includes response.body, "End quiz"
+    end
+  end
+
+  test "quiz with 0 minutes and 0 seconds has no timer" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    game = Game.create_from_quiz!(@quiz)
+
+    post start_moderate_game_path(game), headers: @auth
+    get moderate_game_path(game), headers: @auth
+    assert_response :success
+    assert_not_includes response.body, 'role="timer"'
+    assert_not_includes response.body, "question-timer"
+  end
+end
diff --git a/test/jobs/finish_expired_question_job_test.rb b/test/jobs/finish_expired_question_job_test.rb
