diff --git a/app/javascript/controllers/question_timer_controller.js b/app/javascript/controllers/question_timer_controller.js
new file mode 100644
index 0000000..2b65d7d
--- /dev/null
+++ b/app/javascript/controllers/question_timer_controller.js
@@ -0,0 +1,96 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+
+export default class extends Controller {
+  static targets = ["display"]
+  static values = {
+    remainingMs: Number,
+    finishUrl: String
+  }
+
+  connect() {
+    this.finished = false
+    this.disconnected = false
+    this.retryTimer = null
+    this.deadline = performance.now() + Math.max(0, this.remainingMsValue)
+    this.tick()
+
+    if (!this.finished) {
+      this.interval = setInterval(() => this.tick(), 100)
+    }
+  }
+
+  disconnect() {
+    this.disconnected = true
+    if (this.interval) {
+      clearInterval(this.interval)
+      this.interval = null
+    }
+    if (this.retryTimer) {
+      clearTimeout(this.retryTimer)
+      this.retryTimer = null
+    }
+  }
+
+  tick() {
+    const remainingMs = Math.max(0, this.deadline - performance.now())
+    const remainingSeconds = Math.ceil(remainingMs / 1000)
+
+    if (this.hasDisplayTarget) {
+      this.displayTarget.textContent = this.formatTime(remainingSeconds)
+    }
+
+    if (remainingMs <= 0 && !this.finished) {
+      this.finished = true
+      if (this.interval) {
+        clearInterval(this.interval)
+        this.interval = null
+      }
+      this.finishQuestion()
+    }
+  }
+
+  formatTime(totalSeconds) {
+    const secs = Math.max(0, Math.floor(totalSeconds))
+    const minutes = Math.floor(secs / 60)
+    const seconds = secs % 60
+    return `${minutes}:${String(seconds).padStart(2, "0")}`
+  }
+
+  async finishQuestion() {
+    if (!this.hasFinishUrlValue || this.disconnected) return
+
+    const csrfToken = document.querySelector("meta[name='csrf-token']")?.content
+    try {
+      const headers = { Accept: "text/vnd.turbo-stream.html" }
+      if (csrfToken) headers["X-CSRF-Token"] = csrfToken
+
+      const response = await fetch(this.finishUrlValue, {
+        method: "POST",
+        headers,
+        credentials: "same-origin"
+      })
+
+      if (response.ok) {
+        const html = await response.text()
+        if (html.trim().length > 0) {
+          Turbo.renderStreamMessage(html)
+        }
+      } else if (!this.disconnected) {
+        this.scheduleRetry()
+      }
+    } catch (_error) {
+      if (!this.disconnected) {
+        this.scheduleRetry()
+      }
+    }
+  }
+
+  scheduleRetry() {
+    if (this.retryTimer || this.disconnected) return
+    this.retryTimer = setTimeout(() => {
+      this.retryTimer = null
+      this.finishQuestion()
+    }, 500)
+  }
+}
