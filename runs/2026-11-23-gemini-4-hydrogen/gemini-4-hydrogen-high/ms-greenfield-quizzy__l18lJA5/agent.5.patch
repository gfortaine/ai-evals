+++ b/test/jobs/finish_expired_question_job_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class FinishExpiredQuestionJobTest < ActiveSupport::TestCase
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    @quiz = Quiz.create!(title: "Timed Quiz", timer_minutes: 0, timer_seconds: 5)
+    @q1 = @quiz.questions.create!(body: "Q1?", active: true)
+    @q1.assign_option_rows("0" => { "body" => "A", "correct" => "1" }, "1" => { "body" => "B", "correct" => "0" })
+    @q1.save_with_options!
+
+    @q2 = @quiz.questions.create!(body: "Q2?", active: true)
+    @q2.assign_option_rows("0" => { "body" => "C", "correct" => "1" }, "1" => { "body" => "D", "correct" => "0" })
+    @q2.save_with_options!
+  end
+
+  test "closes expired question and ignores stale jobs from earlier questions" do
+    game = Game.create_from_quiz!(@quiz)
+
+    travel_to Time.zone.local(2026, 11, 23, 12, 0, 0) do
+      game.start!
+      q1 = game.current_question
+
+      # Before deadline -> job does not close question
+      travel 3.seconds
+      FinishExpiredQuestionJob.perform_now(game.id, q1.id)
+      assert game.reload.question_open?
+
+      # At/after deadline -> job closes q1
+      travel 2.seconds
+      FinishExpiredQuestionJob.perform_now(game.id, q1.id)
+      assert game.reload.question_closed?
+
+      # Move to q2; running q1's job again must not close q2
+      game.next_question!
+      assert game.reload.question_open?
+      travel 6.seconds
+      FinishExpiredQuestionJob.perform_now(game.id, q1.id)
+      assert game.reload.question_open?
+      assert_equal 1, game.current_question_index
+
+      # Running q2's job closes q2
+      FinishExpiredQuestionJob.perform_now(game.id, game.current_question.id)
+      assert game.reload.question_closed?
+    end
+  end
+end
