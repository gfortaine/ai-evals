diff --git a/app/views/moderate/games/_stage.html.erb b/app/views/moderate/games/_stage.html.erb
new file mode 100644
index 0000000..c8b687d
--- /dev/null
+++ b/app/views/moderate/games/_stage.html.erb
@@ -0,0 +1,94 @@
+<%
+  cover_class = if game.lobby?
+    "cover"
+  elsif game.finished?
+    "cover cover--night"
+  else
+    "cover cover--blue cover--calm"
+  end
+%>
+<section id="big_screen_stage" class="<%= cover_class %>">
+  <div class="screen">
+    <div class="screen__top">
+      <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span><%= game.quiz_title %></span>
+    </div>
+
+    <div class="screen__body">
+      <% if game.lobby? %>
+        <div class="lobby">
+          <div>
+            <h1 class="lobby__title"><%= game.quiz_title %></h1>
+            <div class="lobby__join">Join at</div>
+            <div class="lobby__url"><%= join_url %></div>
+            <%= render "moderate/games/lobby_players_count", game: game %>
+          </div>
+          <div class="qr" role="img" aria-label="QR code for <%= join_url %>">
+            <%= qr_code_svg(join_url) %>
+          </div>
+        </div>
+      <% elsif game.question_open? || game.question_closed? %>
+        <% current_q = game.current_question %>
+        <% total = game.total_questions %>
+        <% if current_q %>
+          <div class="stage-question__num">Question <%= game.current_question_index + 1 %> of <%= total %></div>
+          <div class="stage-question__body"><%= current_q.body %></div>
+
+          <% if game.question_open? %>
+            <ol class="stage-options">
+              <% current_q.game_options.each_with_index do |option, idx| %>
+                <li class="stage-option">
+                  <span class="stage-option__letter"><%= option_letter(idx) %></span>
+                  <span class="stage-option__title"><%= option.body %></span>
+                </li>
+              <% end %>
+            </ol>
+          <% else %>
+            <% counts = game.option_answer_counts(current_q) %>
+            <% total_answers = counts.values.sum %>
+            <ol class="stage-options stage-options--results">
+              <% current_q.game_options.each_with_index do |option, idx| %>
+                <% count = counts[option.id] || 0 %>
+                <% share = total_answers.positive? ? (count * 100.0 / total_answers).round(1) : 0 %>
+                <li class="stage-option <%= "is-correct" if option.correct? %>">
+                  <span class="stage-option__bar" style="--share: <%= share %>%"></span>
+                  <span class="stage-option__letter"><%= option_letter(idx) %></span>
+                  <span class="stage-option__title"><%= option.body %></span>
+                  <% if option.correct? %>
+                    <span class="stage-option__mark">Correct</span>
+                  <% end %>
+                  <span class="stage-option__count"><%= count %></span>
+                </li>
+              <% end %>
+            </ol>
+          <% end %>
+        <% end %>
+      <% else %>
+        <div class="screen__kicker"><%= game.quiz_title %></div>
+        <h1 class="lobby__title">The quiz is over</h1>
+      <% end %>
+    </div>
+  </div>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "Back to quiz", moderate_quiz_path(game.quiz) %>
+      <% if game.question_open? || game.question_closed? %>
+        <%= render "moderate/games/question_answers_counter", game: game %>
+      <% end %>
+    </div>
+    <div class="buttons">
+      <% if game.lobby? %>
+        <%= button_to "Start", start_moderate_game_path(game), method: :post, class: "btn btn--pink btn--lg" %>
+      <% elsif game.question_open? %>
+        <%= button_to "Finish", finish_question_moderate_game_path(game), method: :post, class: "btn btn--pink btn--lg" %>
+      <% elsif game.question_closed? %>
+        <% if game.last_question? %>
+          <%= button_to "End quiz", end_game_moderate_game_path(game), method: :post, class: "btn btn--pink btn--lg" %>
+        <% else %>
+          <%= button_to "Next", next_question_moderate_game_path(game), method: :post, class: "btn btn--pink btn--lg" %>
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+</section>
