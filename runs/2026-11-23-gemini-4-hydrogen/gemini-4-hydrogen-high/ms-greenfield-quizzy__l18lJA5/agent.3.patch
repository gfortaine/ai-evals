diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
new file mode 100644
index 0000000..6f80333
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,97 @@
+module Moderate
+  class GamesController < BaseController
+    layout "screen"
+
+    before_action :set_quiz, only: [ :create ]
+    before_action :set_game, only: [ :show, :start, :finish_question, :next_question, :end_game, :state ]
+
+    def create
+      game = Game.create_from_quiz!(@quiz)
+      redirect_to moderate_game_path(game), status: :see_other
+    end
+
+    def show
+      @join_url = join_url_for(@game)
+    end
+
+    def start
+      @game.start!
+      @game.reload
+      @join_url = join_url_for(@game)
+
+      GameBroadcaster.broadcast_moderator_stage(@game, join_url: @join_url)
+      GameBroadcaster.broadcast_players_stage(@game)
+
+      respond_to do |format|
+        format.turbo_stream
+        format.html { redirect_to moderate_game_path(@game), status: :see_other }
+      end
+    end
+
+    def finish_question
+      @game.finish_question!
+      @game.reload
+      @join_url = join_url_for(@game)
+
+      GameBroadcaster.broadcast_moderator_stage(@game, join_url: @join_url)
+      GameBroadcaster.broadcast_players_stage(@game)
+
+      respond_to do |format|
+        format.turbo_stream
+        format.html { redirect_to moderate_game_path(@game), status: :see_other }
+      end
+    end
+
+    def next_question
+      @game.next_question!
+      @game.reload
+      @join_url = join_url_for(@game)
+
+      GameBroadcaster.broadcast_moderator_stage(@game, join_url: @join_url)
+      GameBroadcaster.broadcast_players_stage(@game)
+
+      respond_to do |format|
+        format.turbo_stream
+        format.html { redirect_to moderate_game_path(@game), status: :see_other }
+      end
+    end
+
+    def end_game
+      @game.end_game!
+      @game.reload
+      @join_url = join_url_for(@game)
+
+      GameBroadcaster.broadcast_moderator_stage(@game, join_url: @join_url)
+      GameBroadcaster.broadcast_players_stage(@game)
+
+      respond_to do |format|
+        format.turbo_stream
+        format.html { redirect_to moderate_game_path(@game), status: :see_other }
+      end
+    end
+
+    def state
+      if params[:v].present? && params[:v] == @game.moderator_state_key
+        head :no_content
+        return
+      end
+
+      @join_url = join_url_for(@game)
+      render :state
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_game
+      @game = Game.find(params[:id])
+    end
+
+    def join_url_for(game)
+      play_game_url(game.code)
+    end
+  end
+end
diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
index 0000000..b672071
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,100 @@
+class PlayController < ApplicationController
+  before_action :set_game
+  before_action :set_player
+
+  def show
+    @player_answer = current_player_answer
+  end
+
+  def join
+    if @game.finished?
+      redirect_to play_game_path(@game.code), status: :see_other
+      return
+    end
+
+    if @player.present?
+      redirect_to play_game_path(@game.code), status: :see_other
+      return
+    end
+
+    @name_input = params[:name].to_s.strip
+    if @name_input.blank?
+      @join_error = "Please enter your name"
+      render :show, status: :unprocessable_entity
+      return
+    end
+
+    result = @game.join_player!(@name_input)
+    if result == :finished
+      redirect_to play_game_path(@game.code), status: :see_other
+      return
+    end
+
+    @player = result
+    cookies.signed[player_cookie_key(@game)] = {
+      value: @player.token,
+      httponly: true,
+      same_site: :lax
+    }
+
+    GameBroadcaster.broadcast_moderator_counters(@game)
+
+    redirect_to play_game_path(@game.code), status: :see_other
+  end
+
+  def answer
+    if @player.nil?
+      redirect_to play_game_path(@game.code), status: :see_other
+      return
+    end
+
+    result = @game.record_answer!(
+      player: @player,
+      game_question_id: params[:game_question_id],
+      game_option_id: params[:game_option_id]
+    )
+
+    @game.reload
+    @player_answer = current_player_answer
+
+    if result.is_a?(Answer)
+      GameBroadcaster.broadcast_moderator_counters(@game)
+    end
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to play_game_path(@game.code), status: :see_other }
+    end
+  end
+
+  def state
+    @player_answer = current_player_answer
+    if params[:v].present? && params[:v] == @game.player_state_key(@player, @player_answer)
+      head :no_content
+      return
+    end
+
+    render :state
+  end
+
+  private
+
+  def set_game
+    @game = Game.find_by!(code: params[:code].to_s.strip.upcase)
+  end
+
+  def set_player
+    token = cookies.signed[player_cookie_key(@game)]
+    @player = token.present? ? @game.players.find_by(token: token) : nil
+  end
+
+  def player_cookie_key(game)
+    "quizzy_player_#{game.id}"
+  end
+
+  def current_player_answer
+    return nil unless @player && (@game.question_open? || @game.question_closed?)
+
+    @player.answer_for(@game.current_question)
+  end
+end
