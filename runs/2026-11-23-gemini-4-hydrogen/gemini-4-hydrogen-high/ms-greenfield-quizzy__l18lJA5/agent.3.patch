diff --git a/app/views/play/_stage.html.erb b/app/views/play/_stage.html.erb
new file mode 100644
index 0000000..9db8103
--- /dev/null
+++ b/app/views/play/_stage.html.erb
@@ -0,0 +1,86 @@
+<% join_error ||= nil %>
+<% name_input ||= nil %>
+<% is_top = player.present? && !game.finished? && (game.question_open? || game.question_closed?) %>
+<div id="player_stage"
+     class="play__body <%= "play__body--top" if is_top %>"
+     data-live-game-target="state"
+     data-state-key="<%= game.player_state_key(player, player_answer) %>">
+  <% if game.finished? %>
+    <div class="card result-card">
+      <h2>The quiz is over</h2>
+    </div>
+  <% elsif player.nil? %>
+    <h1 class="play-title"><%= game.quiz_title %></h1>
+    <p class="play-lead">Enter your name to join the game.</p>
+
+    <% if join_error.present? %>
+      <div class="errors" role="alert"><%= join_error %></div>
+    <% end %>
+
+    <%= form_with url: join_play_game_path(game.code), method: :post, class: "join-form" do %>
+      <div class="field">
+        <%= label_tag :name, "Your name", class: "field-label" %>
+        <%= text_field_tag :name, name_input, id: "name", class: "input", placeholder: "Your name", required: true, autocomplete: "nickname", autofocus: true %>
+      </div>
+      <button type="submit" class="btn btn--pink">Join</button>
+    <% end %>
+  <% elsif game.lobby? %>
+    <div class="waiting">
+      <div class="waiting__gem" aria-hidden="true">?</div>
+      <h2>Hi, <%= player.name %>!</h2>
+      <p class="play-lead">You're in. Waiting for the host to start the quiz.</p>
+    </div>
+  <% elsif game.question_open? %>
+    <% current_q = game.current_question %>
+    <% if current_q %>
+      <div class="play-question__num">Question <%= game.current_question_index + 1 %> of <%= game.total_questions %></div>
+      <div class="play-question__body"><%= current_q.body %></div>
+
+      <%= form_with url: answer_play_game_path(game.code), method: :post, class: "play-options" do %>
+        <%= hidden_field_tag :game_question_id, current_q.id %>
+        <% current_q.game_options.each_with_index do |option, idx| %>
+          <% picked = player_answer&.game_option_id == option.id %>
+          <button type="submit" name="game_option_id" value="<%= option.id %>" class="play-option <%= "is-picked" if picked %>">
+            <span class="play-option__letter"><%= option_letter(idx) %></span>
+            <span class="play-option__title"><%= option.body %></span>
+            <% if picked %>
+              <span class="play-option__mark">Your answer</span>
+            <% end %>
+          </button>
+        <% end %>
+      <% end %>
+    <% end %>
+  <% elsif game.question_closed? %>
+    <% current_q = game.current_question %>
+    <% if current_q %>
+      <div class="play-question__num">Question <%= game.current_question_index + 1 %> of <%= game.total_questions %></div>
+      <div class="play-question__body"><%= current_q.body %></div>
+
+      <div class="play-options is-locked is-revealed">
+        <% current_q.game_options.each_with_index do |option, idx| %>
+          <% picked = player_answer&.game_option_id == option.id %>
+          <% classes = [ "play-option" ] %>
+          <% classes << "is-picked" if picked %>
+          <% classes << "is-correct" if option.correct? %>
+          <button type="button" disabled class="<%= classes.join(" ") %>">
+            <span class="play-option__letter"><%= option_letter(idx) %></span>
+            <span class="play-option__title"><%= option.body %></span>
+            <% if picked %>
+              <span class="play-option__mark">Your answer</span>
+            <% elsif option.correct? %>
+              <span class="play-option__mark">Correct</span>
+            <% end %>
+          </button>
+        <% end %>
+      </div>
+
+      <% if player_answer.nil? %>
+        <div class="play-status play-status--neutral">No answer</div>
+      <% elsif player_answer.game_option.correct? %>
+        <div class="play-status play-status--right">Correct!</div>
+      <% else %>
+        <div class="play-status play-status--wrong">Wrong!</div>
+      <% end %>
+    <% end %>
+  <% end %>
+</div>
