diff --git a/app/javascript/controllers/live_game_controller.js b/app/javascript/controllers/live_game_controller.js
new file mode 100644
index 0000000..b3523aa
--- /dev/null
+++ b/app/javascript/controllers/live_game_controller.js
@@ -0,0 +1,103 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+
+export default class extends Controller {
+  static targets = ["state"]
+  static values = { syncUrl: String }
+
+  connect() {
+    this.syncing = false
+    this.pollTimer = null
+    this.connectGraceTimer = null
+    this.streamSource = this.element.querySelector("turbo-cable-stream-source")
+
+    this.onVisibilityChange = () => {
+      if (!document.hidden) this.sync()
+    }
+    this.onOnline = () => this.sync()
+
+    document.addEventListener("visibilitychange", this.onVisibilityChange)
+    window.addEventListener("online", this.onOnline)
+
+    if (this.streamSource) {
+      this.observer = new MutationObserver(() => this.handleConnectionChange())
+      this.observer.observe(this.streamSource, {
+        attributes: true,
+        attributeFilter: ["connected"]
+      })
+
+      if (this.streamSource.hasAttribute("connected")) {
+        this.sync()
+      } else {
+        this.connectGraceTimer = setTimeout(() => {
+          if (this.streamSource && !this.streamSource.hasAttribute("connected")) {
+            this.startPolling()
+          }
+        }, 1500)
+      }
+    } else {
+      this.startPolling()
+    }
+  }
+
+  disconnect() {
+    document.removeEventListener("visibilitychange", this.onVisibilityChange)
+    window.removeEventListener("online", this.onOnline)
+    if (this.observer) this.observer.disconnect()
+    this.stopPolling()
+    if (this.connectGraceTimer) {
+      clearTimeout(this.connectGraceTimer)
+      this.connectGraceTimer = null
+    }
+  }
+
+  handleConnectionChange() {
+    if (!this.streamSource) return
+
+    if (this.streamSource.hasAttribute("connected")) {
+      this.stopPolling()
+      this.sync()
+    } else {
+      this.startPolling()
+    }
+  }
+
+  startPolling() {
+    if (this.pollTimer) return
+    this.pollTimer = setInterval(() => this.sync(), 2000)
+  }
+
+  stopPolling() {
+    if (this.pollTimer) {
+      clearInterval(this.pollTimer)
+      this.pollTimer = null
+    }
+  }
+
+  async sync() {
+    if (this.syncing || !this.hasSyncUrlValue || !this.hasStateTarget) return
+
+    this.syncing = true
+    try {
+      const stateKey = this.stateTarget.dataset.stateKey || ""
+      const separator = this.syncUrlValue.includes("?") ? "&" : "?"
+      const url = `${this.syncUrlValue}${separator}v=${encodeURIComponent(stateKey)}`
+
+      const response = await fetch(url, {
+        headers: { Accept: "text/vnd.turbo-stream.html" },
+        credentials: "same-origin"
+      })
+
+      if (response.status === 200) {
+        const html = await response.text()
+        if (html.trim().length > 0) {
+          Turbo.renderStreamMessage(html)
+        }
+      }
+    } catch (_error) {
+      // Transient network error on conference Wi-Fi; next reconnect or poll will retry.
+    } finally {
+      this.syncing = false
+    }
+  }
+}
