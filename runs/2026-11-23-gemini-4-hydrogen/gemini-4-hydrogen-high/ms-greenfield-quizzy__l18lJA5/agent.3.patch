+++ b/test/system/live_game_test.rb
@@ -0,0 +1,216 @@
+require "application_system_test_case"
+
+class LiveGameTest < ApplicationSystemTestCase
+  setup do
+    @quiz = Quiz.create!(title: "Conference Talk Live")
+
+    @q1 = @quiz.questions.create!(body: "Which protocol powers live updates?", active: true)
+    @q1.assign_option_rows({
+      "0" => { "body" => "WebSockets", "correct" => "1" },
+      "1" => { "body" => "FTP", "correct" => "0" },
+      "2" => { "body" => "SMTP", "correct" => "0" }
+    })
+    @q1.save_with_options!
+
+    @q2_inactive = @quiz.questions.create!(body: "Draft skipped question", active: false)
+    @q2_inactive.assign_option_rows({
+      "0" => { "body" => "Skip A", "correct" => "1" },
+      "1" => { "body" => "Skip B", "correct" => "0" }
+    })
+    @q2_inactive.save_with_options!
+
+    @q3 = @quiz.questions.create!(body: "Pick all dynamic languages", active: true)
+    @q3.assign_option_rows({
+      "0" => { "body" => "Ruby", "correct" => "1" },
+      "1" => { "body" => "Python", "correct" => "1" },
+      "2" => { "body" => "Rust", "correct" => "0" }
+    })
+    @q3.save_with_options!
+  end
+
+  test "full live game across moderator big screen and multiple player phones without reloads" do
+    # Moderator starts a game from the quiz page
+    visit moderate_quiz_path(@quiz)
+    click_button "Start a game"
+
+    assert_text "Conference Talk Live"
+    assert_text "Players: 0"
+    assert_selector ".qr svg"
+    assert_button "Start"
+
+    join_url = find(".lobby__url").text.strip
+    assert_match %r{/play/[A-Z2-9]{5}\z}, join_url
+
+    # Alice joins in her phone browser (no moderator Basic Auth)
+    Capybara.using_session(:alice) do
+      visit join_url
+      assert_field "Your name"
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    # Moderator sees Players: 1 live without reload
+    assert_text "Players: 1"
+
+    # Bob joins in his phone browser
+    Capybara.using_session(:bob) do
+      visit join_url
+      fill_in "Your name", with: "Bob"
+      click_button "Join"
+      assert_text "Hi, Bob!"
+    end
+
+    # Moderator sees Players: 2 live without reload
+    assert_text "Players: 2"
+
+    # Reopening join link in Alice's browser remembers Alice
+    Capybara.using_session(:alice) do
+      visit join_url
+      assert_text "Hi, Alice!"
+    end
+
+    # Moderator starts Question 1
+    click_button "Start"
+    assert_text "Question 1 of 2"
+    assert_text "Which protocol powers live updates?"
+    assert_text "Answers: 0 / 2"
+    assert_button "Finish"
+
+    # Alice & Bob receive Question 1 live without page reload, and no correct answer is leaked
+    Capybara.using_session(:alice) do
+      assert_text "Which protocol powers live updates?"
+      refute page.html.include?("is-correct")
+      refute_text "Correct"
+
+      # Tap wrong option first, then switch to right option
+      click_button "FTP"
+      within("button.play-option", text: "FTP") do
+        assert_text "Your answer"
+      end
+
+      click_button "WebSockets"
+      within("button.play-option", text: "WebSockets") do
+        assert_text "Your answer"
+      end
+      within("button.play-option", text: "FTP") do
+        assert_no_text "Your answer"
+      end
+    end
+
+    # Moderator sees Answers: 1 / 2 live
+    assert_text "Answers: 1 / 2"
+
+    Capybara.using_session(:bob) do
+      assert_text "Which protocol powers live updates?"
+      refute page.html.include?("is-correct")
+    end
+
+    # Moderator finishes Question 1
+    click_button "Finish"
+    assert_button "Next"
+    within("li.stage-option", text: "WebSockets") do
+      assert_text "Correct"
+      assert_text "1"
+    end
+    within("li.stage-option", text: "FTP") do
+      assert_no_text "Correct"
+      assert_text "0"
+    end
+
+    # Alice sees Correct!, Bob sees No answer (live without reload)
+    Capybara.using_session(:alice) do
+      assert_text "Correct!"
+    end
+
+    Capybara.using_session(:bob) do
+      assert_text "No answer"
+    end
+
+    # Charlie joins mid-game while Question 1 is closed
+    Capybara.using_session(:charlie) do
+      visit join_url
+      fill_in "Your name", with: "Charlie"
+      click_button "Join"
+      assert_text "No answer"
+    end
+
+    assert_text "Answers: 1 / 3"
+
+    # Moderator clicks Next -> skips inactive Q2, shows Q3 ("Question 2 of 2")
+    click_button "Next"
+    assert_text "Question 2 of 2"
+    assert_text "Pick all dynamic languages"
+    assert_no_text "Draft skipped question"
+    assert_text "Answers: 0 / 3"
+
+    Capybara.using_session(:alice) do
+      assert_text "Pick all dynamic languages"
+      click_button "Rust"
+      within("button.play-option", text: "Rust") { assert_text "Your answer" }
+    end
+
+    Capybara.using_session(:bob) do
+      assert_text "Pick all dynamic languages"
+      click_button "Ruby"
+    end
+
+    Capybara.using_session(:charlie) do
+      assert_text "Pick all dynamic languages"
+      click_button "Python"
+    end
+
+    assert_text "Answers: 3 / 3"
+
+    # Moderator finishes Question 2 -> shows "End quiz" instead of "Next"
+    click_button "Finish"
+    assert_no_button "Next"
+    assert_button "End quiz"
+
+    within("li.stage-option", text: "Ruby") do
+      assert_text "Correct"
+      assert_text "1"
+    end
+    within("li.stage-option", text: "Python") do
+      assert_text "Correct"
+      assert_text "1"
+    end
+    within("li.stage-option", text: "Rust") do
+      assert_no_text "Correct"
+      assert_text "1"
+    end
+
+    Capybara.using_session(:alice) { assert_text "Wrong!" }
+    Capybara.using_session(:bob) { assert_text "Correct!" }
+    Capybara.using_session(:charlie) { assert_text "Correct!" }
+
+    # Moderator ends the quiz
+    click_button "End quiz"
+    assert_text "The quiz is over"
+
+    Capybara.using_session(:alice) { assert_text "The quiz is over" }
+    Capybara.using_session(:bob) { assert_text "The quiz is over" }
+    Capybara.using_session(:charlie) { assert_text "The quiz is over" }
+
+    # Late visitor cannot join after the quiz is over
+    Capybara.using_session(:late) do
+      visit join_url
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+
+    # Moderator can start a second independent game of the same quiz
+    click_link "Back to quiz"
+    click_button "Start a game"
+    assert_text "Players: 0"
+    join_url_2 = find(".lobby__url").text.strip
+    assert_not_equal join_url, join_url_2
+
+    Capybara.using_session(:alice) do
+      visit join_url_2
+      assert_field "Your name"
+      assert_no_text "Hi, Alice!"
+    end
+  end
+end
