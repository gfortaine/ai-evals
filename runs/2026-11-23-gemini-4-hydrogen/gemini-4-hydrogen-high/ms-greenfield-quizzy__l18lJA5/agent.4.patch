+    all("ol.leaderboard > li").each do |li|
+      within(li) { assert_no_text "Winner" }
+    end
+    [ :bob, :alice, :charlie, :dave ].each do |session|
+      Capybara.using_session(session) { assert_no_text "You won!" }
