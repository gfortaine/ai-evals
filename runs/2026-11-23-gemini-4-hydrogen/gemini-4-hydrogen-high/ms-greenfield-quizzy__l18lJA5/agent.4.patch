+      "0" => { "body" => "C", "correct" => "1" },
+      "1" => { "body" => "Turtle", "correct" => "0" }
+    })
+    @q1.save_with_options!
+
+    @q2 = @quiz.questions.create!(body: "Web framework?", active: true)
+    @q2.assign_option_rows({
+      "0" => { "body" => "Rails", "correct" => "1" },
+      "1" => { "body" => "Pencil", "correct" => "0" }
+    })
+    @q2.save_with_options!
+  end
+
+  test "quiz settings validation, scoring by speed, leaderboard, and live winner picking" do
+    visit moderate_quiz_path(@quiz)
+    click_link "Settings"
+
+    assert_field "Number of winners", with: "3"
+
+    fill_in "Number of winners", with: "0"
+    click_button "Save quiz"
+    assert_selector ".errors", text: "Number of winners"
+
+    fill_in "Number of winners", with: "2"
+    click_button "Save quiz"
+    assert_text "2 winners"
+
+    click_button "Start a game"
+    join_url = find(".lobby__url").text.strip
+
+    # 4 players join
+    Capybara.using_session(:alice) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+    Capybara.using_session(:bob) do
+      visit join_url
+      fill_in "Your name", with: "Bob"
+      click_button "Join"
+      assert_text "Hi, Bob!"
+    end
+    Capybara.using_session(:charlie) do
+      visit join_url
+      fill_in "Your name", with: "Charlie"
+      click_button "Join"
+      assert_text "Hi, Charlie!"
+    end
+    Capybara.using_session(:dave) do
+      visit join_url
+      fill_in "Your name", with: "Dave"
+      click_button "Join"
+      assert_text "Hi, Dave!"
+    end
+
+    assert_text "Players: 4"
+
+    # Question 1: Alice answers fast (C), Bob answers slower (C), Charlie answers wrong (Turtle), Dave skips
+    click_button "Start"
+    assert_text "Question 1 of 2"
+
+    Capybara.using_session(:alice) do
+      assert_text "Fastest language?"
+      assert_no_text "point"
+      click_button "C"
+      within("button.play-option", text: "C") { assert_text "Your answer" }
+    end
+
+    sleep 0.25
+
+    Capybara.using_session(:bob) do
+      assert_text "Fastest language?"
+      click_button "C"
+      within("button.play-option", text: "C") { assert_text "Your answer" }
+    end
+
+    Capybara.using_session(:charlie) do
+      assert_text "Fastest language?"
+      click_button "Turtle"
+    end
+
+    assert_text "Answers: 3 / 4"
+    click_button "Finish"
+
+    # Players don't see points during closed question
+    Capybara.using_session(:alice) do
+      assert_text "Correct!"
+      assert_no_text "point"
+    end
+    Capybara.using_session(:charlie) do
+      assert_text "Wrong!"
+      assert_no_text "point"
+    end
+
+    # Question 2: Bob answers fast (Rails) -> 2 pts;
+    # Charlie answers slower (Rails) -> 1 pt (slower than Alice's Q1);
+    # Alice picks Rails then switches to Pencil -> 1 pt (from Q1 only);
+    # Dave still 0 pts
+    click_button "Next"
+    assert_text "Question 2 of 2"
+
+    Capybara.using_session(:bob) do
+      assert_text "Web framework?"
+      click_button "Rails"
+      within("button.play-option", text: "Rails") { assert_text "Your answer" }
+    end
+
+    Capybara.using_session(:alice) do
