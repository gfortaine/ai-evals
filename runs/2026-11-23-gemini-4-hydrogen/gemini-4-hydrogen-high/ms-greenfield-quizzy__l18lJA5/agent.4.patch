+      assert_text "1 point"
+      assert_no_text "You won!"
+    end
+    Capybara.using_session(:dave) do
+      assert_text "Place 4 of 4"
+      assert_text "0 points"
+      assert_no_text "You won!"
+    end
+
+    # Top 2 makes Bob and Alice winners live on big screen & phones
+    click_button "Top 2"
+
+    leaders = all("ol.leaderboard > li")
+    within(leaders[0]) { assert_text "Winner" }
+    within(leaders[1]) { assert_text "Winner" }
+    within(leaders[2]) { assert_no_text "Winner" }
+    within(leaders[3]) { assert_no_text "Winner" }
+
+    Capybara.using_session(:bob) { assert_text "You won!" }
+    Capybara.using_session(:alice) { assert_text "You won!" }
+    Capybara.using_session(:charlie) { assert_no_text "You won!" }
+    Capybara.using_session(:dave) { assert_no_text "You won!" }
+
+    # Reset winners removes winners live everywhere
+    click_button "Reset winners"
