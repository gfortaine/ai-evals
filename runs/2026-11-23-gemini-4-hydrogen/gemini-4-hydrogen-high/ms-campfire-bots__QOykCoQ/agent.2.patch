diff --git a/app/models/bot/webhook.rb b/app/models/bot/webhook.rb
new file mode 100644
index 0000000..68fcb4e
--- /dev/null
+++ b/app/models/bot/webhook.rb
@@ -0,0 +1,116 @@
+require "net/http"
+
+class Bot::Webhook
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 15
+  SUPPORTED_RESPONSE_CONTENT_TYPES = %w[ text/plain text/html ].freeze
+
+  attr_reader :bot, :message
+
+  def initialize(bot:, message:)
+    @bot = bot
+    @message = message
+  end
+
+  def deliver
+    return unless eligible?
+
+    response = post_payload
+    handle_response(response) if response
+  rescue StandardError => e
+    Rails.logger.warn "Failed to deliver webhook for bot #{bot.id} to #{bot.webhook_url}: #{e.class} #{e.message}"
+  end
+
+  private
+    def room
+      message.room
+    end
+
+    def eligible?
+      bot.active? && bot.bot? && bot.webhook_url.present? &&
+        message.creator_id != bot.id &&
+        room.users.exists?(bot.id)
+    end
+
+    def post_payload
+      uri = URI.parse(bot.webhook_url)
+      return unless uri.is_a?(URI::HTTP) && uri.host.present?
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = (uri.scheme == "https")
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri, {
+        "Content-Type" => "application/json",
+        "User-Agent" => "Campfire"
+      })
+      request.basic_auth(uri.user, uri.password) if uri.user
+      request.body = payload.to_json
+
+      http.request(request)
+    end
+
+    def payload
+      {
+        event: "mention",
+        author: {
+          id: message.creator.id,
+          name: message.creator.name
+        },
+        room: {
+          id: room.id,
+          name: room_name,
+          reply_to: url_helpers.room_bot_messages_path(room, bot.bot_token)
+        },
+        message: {
+          id: message.id,
+          body: {
+            text: message.plain_text_without_mention(bot),
+            html: message.body.body&.to_html.to_s
+          },
+          link: url_helpers.room_at_message_path(room, message)
+        }
+      }
+    end
+
+    def room_name
+      room.name.presence || room.users.without(bot).pluck(:name).to_sentence.presence
+    end
+
+    def handle_response(response)
+      return unless response.is_a?(Net::HTTPOK)
+
+      content_type = response.content_type&.downcase
+      return unless content_type.in?(SUPPORTED_RESPONSE_CONTENT_TYPES)
+
+      body = decode_body(response)
+      return if body.blank?
+
+      formatted_body = content_type == "text/plain" ? format_plain_text(body) : body
+      reply = room.messages.create!(creator: bot, body: formatted_body)
+      reply.broadcast_create
+    end
+
+    def decode_body(response)
+      charset = response.type_params["charset"]
+      body = response.body.to_s.dup
+
+      if charset.present?
+        body.force_encoding(charset).encode("UTF-8", invalid: :replace, undef: :replace)
+      else
+        body.force_encoding("UTF-8")
+        body.valid_encoding? ? body : body.encode("UTF-8", invalid: :replace, undef: :replace)
+      end
+    rescue ArgumentError, EncodingError
+      response.body.to_s.encode("UTF-8", invalid: :replace, undef: :replace)
+    end
+
+    def format_plain_text(body)
+      ERB::Util.html_escape(body).gsub(/\r?\n/, "<br>")
+    end
+
+    def url_helpers
+      Rails.application.routes.url_helpers
+    end
+end
