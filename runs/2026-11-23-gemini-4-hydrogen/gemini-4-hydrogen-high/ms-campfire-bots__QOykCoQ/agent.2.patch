diff --git a/test/models/bot/webhook_test.rb b/test/models/bot/webhook_test.rb
new file mode 100644
index 0000000..ca4dee0
--- /dev/null
+++ b/test/models/bot/webhook_test.rb
@@ -0,0 +1,166 @@
+require "test_helper"
+
+class Bot::WebhookTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @author = users(:david)
+    @room = rooms(:hq)
+    @bot = User.create!(
+      name: "Deploy Bot",
+      role: :bot,
+      creator: @author,
+      webhook_url: "https://bot.example.com/webhook"
+    )
+  end
+
+  test "delivers expected JSON payload and posts 200 text/plain response as bot message" do
+    captured_request = nil
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return do |request|
+        captured_request = request
+        {
+          status: 200,
+          headers: { "Content-Type" => "text/plain; charset=utf-8" },
+          body: "Build #42 started & running\nCheck logs <here>"
+        }
+      end
+
+    message = @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} restart the build please</div>",
+      client_message_id: "msg-1"
+    )
+
+    assert_difference -> { @room.messages.count }, 1 do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+
+    assert_equal "application/json", captured_request.headers["Content-Type"]
+    payload = JSON.parse(captured_request.body)
+
+    assert_equal "mention", payload["event"]
+    assert_equal({ "id" => @author.id, "name" => @author.name }, payload["author"])
+    assert_equal({
+      "id" => @room.id,
+      "name" => @room.name,
+      "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_token}/messages"
+    }, payload["room"])
+    assert_equal message.id, payload.dig("message", "id")
+    assert_equal "restart the build please", payload.dig("message", "body", "text")
+    assert_equal message.body.body.to_html, payload.dig("message", "body", "html")
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", payload.dig("message", "link")
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Build #42 started & running\nCheck logs <here>", reply.plain_text_body
+  end
+
+  test "posts 200 text/html response as rich-text bot message" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(
+        status: 200,
+        headers: { "Content-Type" => "text/html" },
+        body: "<div>Deploy <strong>succeeded</strong>!</div>"
+      )
+
+    @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} status</div>",
+      client_message_id: "msg-html"
+    )
+
+    assert_difference -> { @room.messages.count }, 1 do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Deploy succeeded!", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "<strong>succeeded</strong>"
+  end
+
+  test "204 response posts no message" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 204, body: "")
+
+    @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} ping</div>",
+      client_message_id: "msg-204"
+    )
+
+    assert_no_difference -> { @room.messages.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+
+  test "200 response with unsupported content type or blank body posts no message" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "application/json" }, body: '{"ok":true}')
+
+    @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} ping</div>",
+      client_message_id: "msg-json"
+    )
+
+    assert_no_difference -> { @room.messages.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "   \n  ")
+
+    @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} ping2</div>",
+      client_message_id: "msg-blank"
+    )
+
+    assert_no_difference -> { @room.messages.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+
+  test "network failures and 500 responses do not raise or post messages" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook").to_timeout
+
+    @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} ping</div>",
+      client_message_id: "msg-timeout"
+    )
+
+    assert_no_difference -> { @room.messages.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 500, headers: { "Content-Type" => "text/plain" }, body: "Internal Server Error")
+
+    @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} ping2</div>",
+      client_message_id: "msg-500"
+    )
+
+    assert_no_difference -> { @room.messages.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+
+  test "bot mentioning itself does not trigger its own webhook" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Should not run")
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      @room.messages.create!(
+        creator: @bot,
+        body: "<div>#{mention_attachment_for(@bot)} self ping</div>",
+        client_message_id: "msg-self"
+      )
+    end
+  end
+end
