     room.users.where(id: mentioned_users.map(&:id))
   end
 
+  def plain_text_without_mention(user)
+    return plain_text_body unless body.body
+
+    sgids = body.body.attachments.filter_map { |attachment|
+      attachment.node["sgid"] if attachment.attachable == user
+    }.uniq
+
+    return plain_text_body if sgids.empty?
+
+    stripped_fragment = body.body.fragment.replace("action-text-attachment") do |node|
+      sgids.include?(node["sgid"]) ? nil : node
+    end
+
+    ActionText::Content.new(stripped_fragment).to_plain_text
+      .gsub(/[[:space:]&&[^\n]]+/, " ")
+      .gsub(/^ +| +$/, "")
+      .strip
+  end
+
   private
     def mentioned_users
       if body.body
