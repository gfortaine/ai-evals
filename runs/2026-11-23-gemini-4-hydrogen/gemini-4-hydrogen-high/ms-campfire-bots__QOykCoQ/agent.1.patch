diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..fc48545
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,59 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+  before_action :ensure_can_administer, only: %i[ edit update destroy ]
+
+  def index
+    @bots = bots_scope.with_attached_avatar.ordered
+  end
+
+  def new
+    @bot = User.new(role: :bot, creator: Current.user)
+  end
+
+  def create
+    @bot = User.new(bot_params.merge(role: :bot, creator: Current.user))
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url
+  end
+
+  private
+    def bots_scope
+      if Current.user.administrator?
+        User.active.bot
+      else
+        Current.user.created_bots.active
+      end
+    end
+
+    def set_bot
+      @bot = User.active.bot.find(params[:id])
+    end
+
+    def ensure_can_administer
+      head :forbidden unless Current.user.can_administer?(@bot)
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
diff --git a/app/controllers/rooms/bot_messages_controller.rb b/app/controllers/rooms/bot_messages_controller.rb
new file mode 100644
index 0000000..7a66c1e
--- /dev/null
+++ b/app/controllers/rooms/bot_messages_controller.rb
@@ -0,0 +1,55 @@
+class Rooms::BotMessagesController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  before_action :authenticate_bot
+  before_action :set_room
+
+  def create
+    if create_message
+      @message.broadcast_create
+      head :created, location: message_path(@message)
+    else
+      head :unprocessable_content
+    end
+  end
+
+  private
+    def authenticate_bot
+      @bot = User.authenticate_bot(params[:bot_code])
+      head :unauthorized unless @bot
+    end
+
+    def set_room
+      @room = @bot.rooms.find_by(id: params[:room_id])
+      head :not_found unless @room
+    end
+
+    def create_message
+      if request.media_type == "multipart/form-data"
+        create_attachment_message
+      else
+        create_text_message
+      end
+    end
+
+    def create_attachment_message
+      return unless params[:attachment].respond_to?(:read)
+
+      @message = @room.messages.create_with_attachment!(creator: @bot, attachment: params[:attachment])
+    end
+
+    def create_text_message
+      body = raw_message_body
+      return if body.blank?
+
+      @message = @room.messages.create!(creator: @bot, body: body)
+    end
+
+    def raw_message_body
+      body = request.raw_post.dup.force_encoding("UTF-8")
+      body.valid_encoding? ? body : body.encode("UTF-8", invalid: :replace, undef: :replace)
+    end
+end
