@@ -0,0 +1,198 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @kevin = users(:kevin) # member
+    @jz = users(:jz)       # member
+    @david = users(:david) # administrator
+
+    @kevin_bot = User.create!(name: "Deploy Bot", role: :bot, creator: @kevin)
+    @jz_bot = User.create!(name: "Alert Bot", role: :bot, creator: @jz)
+  end
+
+  test "account edit page shows Set up chat bots link to any member" do
+    sign_in :kevin
+    get edit_account_url
+    assert_response :ok
+    assert_select "a[href='#{bots_path}'][aria-label='Set up chat bots']"
+    assert_select "strong", text: @kevin_bot.name, count: 0
+  end
+
+  test "index lists only bots created by current member without pagination" do
+    sign_in :kevin
+    get bots_url
+
+    assert_response :ok
+    assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "label", text: "Bot code"
+      assert_select "input[readonly][value='#{@kevin_bot.bot_token}']"
+      assert_select "a[href='#{edit_bot_path(@kevin_bot)}'][aria-label='Edit Deploy Bot']"
+    end
+    assert_select "li", text: /Alert Bot/, count: 0
+  end
+
+  test "index lists all bots for administrators" do
+    sign_in :david
+    get bots_url
+
+    assert_response :ok
+    assert_select "li", text: /Deploy Bot/
+    assert_select "li", text: /Alert Bot/
+  end
+
+  test "new renders bot creation form" do
+    sign_in :kevin
+    get new_bot_url
+
+    assert_response :ok
+    assert_select "input[type=file][name='bot[avatar]']"
+    assert_select "input[type=text][name='bot[name]'][required][aria-label='Name the bot']"
+    assert_select "button[type=submit][aria-label='Save changes']"
+  end
+
+  test "create creates a bot with optional avatar and redirects to bots index" do
+    sign_in :kevin
+
+    assert_difference -> { User.bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Build Bot", avatar: fixture_file_upload("moon.jpg", "image/jpeg") } }
+    end
+
+    assert_redirected_to bots_url
+    bot = User.bot.order(:id).last
+    assert_equal "Build Bot", bot.name
+    assert_equal @kevin, bot.creator
+    assert bot.avatar.attached?
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+  end
+
+  test "create rejects blank name" do
+    sign_in :kevin
+
+    assert_no_difference -> { User.bot.count } do
+      post bots_url, params: { bot: { name: "" } }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "edit renders form and Delete this chat bot button with confirmation" do
+    sign_in :kevin
+    get edit_bot_url(@kevin_bot)
+
+    assert_response :ok
+    assert_select "input[type=text][name='bot[name]'][value='Deploy Bot'][aria-label='Name the bot']"
+    assert_select "button[type=submit][aria-label='Save changes']"
+    assert_select "button[data-turbo-confirm]", text: /Delete this chat bot/
+  end
+
+  test "update changes bot name without changing bot code" do
+    sign_in :kevin
+    original_token = @kevin_bot.bot_token
+
+    patch bot_url(@kevin_bot), params: { bot: { name: "Release Bot" } }
+
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", @kevin_bot.reload.name
+    assert_equal original_token, @kevin_bot.bot_token
+  end
+
+  test "destroy deactivates bot and removes it from bots list" do
+    sign_in :kevin
+    token = @kevin_bot.bot_token
+
+    delete bot_url(@kevin_bot)
+
+    assert_redirected_to bots_url
+    assert @kevin_bot.reload.deactivated?
+    assert_nil User.authenticate_bot(token)
+
+    get bots_url
+    assert_select "li", text: /Deploy Bot/, count: 0
+  end
+
+  test "member cannot edit, update, or delete another member's bot" do
+    sign_in :kevin
+
+    get edit_bot_url(@jz_bot)
+    assert_response :forbidden
+
+    patch bot_url(@jz_bot), params: { bot: { name: "Hacked" } }
+    assert_response :forbidden
+    assert_equal "Alert Bot", @jz_bot.reload.name
+
+    delete bot_url(@jz_bot)
+    assert_response :forbidden
+    assert @jz_bot.reload.active?
+  end
+
+  test "administrator can edit, update, and delete any bot" do
+    sign_in :david
+
+    get edit_bot_url(@jz_bot)
+    assert_response :ok
+
+    patch bot_url(@jz_bot), params: { bot: { name: "Ops Bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Ops Bot", @jz_bot.reload.name
+
+    delete bot_url(@jz_bot)
+    assert_redirected_to bots_url
+    assert @jz_bot.reload.deactivated?
+  end
+
+  test "bots cannot sign in via session or transfer link" do
+    post session_url, params: { email_address: nil, password: "" }
+    assert_response :unauthorized
+
+    get session_transfer_url(@kevin_bot.transfer_id)
+    put session_transfer_url(@kevin_bot.transfer_id)
+    assert_response :bad_request
+  end
+
+  test "bots can be added to and removed from closed rooms" do
+    sign_in :david
+    designers = rooms(:designers)
+
+    get edit_rooms_closed_url(designers)
+    assert_response :ok
+    assert_select "input[type=checkbox][name='user_ids[]'][value='#{@kevin_bot.id}']"
+
+    put rooms_closed_url(designers), params: {
+      room: { name: designers.name },
+      user_ids: designers.user_ids + [ @kevin_bot.id ]
+    }
+    assert_includes designers.reload.users, @kevin_bot
+  end
+  test "update can attach a new avatar and avatar endpoint serves it" do
+    sign_in :kevin
+
+    patch bot_url(@kevin_bot), params: {
+      bot: { name: "Release Bot", avatar: fixture_file_upload("moon.jpg", "image/jpeg") }
+    }
+
+    assert_redirected_to bots_url
+    assert @kevin_bot.reload.avatar.attached?
+
+    get fresh_user_avatar_path(@kevin_bot)
+    assert_response :ok
+  end
+
+  test "bots index shows all bots on one page without pagination" do
+    sign_in :kevin
+    55.times { |i| User.create!(name: "Bot #{i}", role: :bot, creator: @kevin) }
+
+    get bots_url
+    assert_response :ok
+    assert_select "li", count: 56
+  end
+
+  test "viewing a bot profile does not expose bot code or transfer link" do
+    sign_in :david
+
+    get user_url(@kevin_bot)
+    assert_response :ok
+    assert_no_match @kevin_bot.bot_token, response.body
+    assert_select "input#session_transfer_url", count: 0
+  end
+end
diff --git a/test/controllers/rooms/bot_messages_controller_test.rb b/test/controllers/rooms/bot_messages_controller_test.rb
new file mode 100644
index 0000000..501f93f
--- /dev/null
+++ b/test/controllers/rooms/bot_messages_controller_test.rb
@@ -0,0 +1,146 @@
+require "test_helper"
+
+class Rooms::BotMessagesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    host! "once.campfire.test"
+    @bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+    @open_room = rooms(:hq)
+    @closed_room = rooms(:designers)
+  end
+
+  test "posting a raw text message creates message, returns 201 with Location, broadcasts, and pushes notifications" do
+    assert_enqueued_jobs 1, only: [ Room::PushMessageJob ] do
+      assert_difference -> { @open_room.messages.count }, 1 do
+        post room_bot_messages_url(@open_room, @bot.bot_token),
+          params: "Deploy of v1.2.3 finished ✅",
+          headers: {
+            "Content-Type" => "application/x-www-form-urlencoded",
+            "User-Agent" => "curl/8.5.0"
+          }
+      end
+    end
+
+    message = @open_room.messages.order(:id).last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal @bot, message.creator
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+  end
+
+  test "raw request body with &, =, and + is preserved without form-decoding mangling" do
+    raw = "1 + 1 = 2 & key=val"
+
+    post room_bot_messages_url(@open_room, @bot.bot_token),
+      params: raw,
+      headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+
+    assert_response :created
+    assert_equal raw, @open_room.messages.order(:id).last.plain_text_body
+  end
+
+  test "posting broadcasts turbo stream showing bot name as author and updates unread rooms" do
+    post room_bot_messages_url(@open_room, @bot.bot_token),
+      params: "Build green",
+      headers: { "Content-Type" => "text/plain" }
+
+    assert_rendered_turbo_stream_broadcast @open_room, :messages, action: "append", target: [ @open_room, :messages ] do
+      assert_select ".message__author", text: /Deploy Bot/
+      assert_select ".message__body", text: /Build green/
+    end
+
+    @open_room.users.each do |member|
+      assert_broadcasts UnreadRoomsChannel.stream_name_for(member.id), 1 do
+        post room_bot_messages_url(@open_room, @bot.bot_token),
+          params: "Build green #{member.id}",
+          headers: { "Content-Type" => "text/plain" }
+      end
+    end
+  end
+
+  test "posting triggers web push notifications for room members" do
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      WebPush.expects(:payload_send).times(Push::Subscription.count)
+      post room_bot_messages_url(@open_room, @bot.bot_token),
+        params: "Release ready",
+        headers: { "Content-Type" => "text/plain" }
+    end
+  end
+
+  test "posting a multipart attachment creates an attachment message" do
+    assert_difference -> { @open_room.messages.count }, 1 do
+      post room_bot_messages_url(@open_room, @bot.bot_token),
+        params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+    end
+
+    message = @open_room.messages.order(:id).last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert message.attachment?
+  end
+
+  test "empty body and no attachment returns 422 Unprocessable Content" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@open_room, @bot.bot_token),
+        params: "",
+        headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    end
+    assert_response :unprocessable_content
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@open_room, @bot.bot_token),
+        params: "   \n  ",
+        headers: { "Content-Type" => "text/plain" }
+    end
+    assert_response :unprocessable_content
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@open_room, @bot.bot_token),
+        params: { other: "value" },
+        headers: { "Content-Type" => "multipart/form-data" }
+    end
+    assert_response :unprocessable_content
+  end
+
+  test "invalid bot code returns 401 Unauthorized" do
+    post room_bot_messages_url(@open_room, "invalid-code"), params: "Hello"
+    assert_response :unauthorized
+  end
+
+  test "deleted bot can no longer post messages" do
+    token = @bot.bot_token
+    @bot.deactivate
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@open_room, token), params: "Hello"
+    end
+    assert_response :unauthorized
+  end
+
+  test "bad room id returns 404 Not Found" do
+    post "/rooms/999999/#{@bot.bot_token}/messages", params: "Hello"
+    assert_response :not_found
+  end
+
+  test "bot cannot post to closed room until added as a member" do
+    post room_bot_messages_url(@closed_room, @bot.bot_token), params: "Hello"
+    assert_response :not_found
+
+    @closed_room.memberships.grant_to(@bot)
+
+    post room_bot_messages_url(@closed_room, @bot.bot_token), params: "Now I am in!"
+    assert_response :created
+  end
+
+  test "posting without Content-Type header works and renders bot as author in room" do
+    post room_bot_messages_url(@open_room, @bot.bot_token), params: "Plain payload"
+    assert_response :created
+
+    sign_in :david
+    get room_url(@open_room)
+    assert_response :ok
+    assert_select ".message__author", text: /Deploy Bot/
+    assert_select ".message__body", text: /Plain payload/
+  end
+end
diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
new file mode 100644
index 0000000..316057b
--- /dev/null
+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "creating a bot generates a bot token and grants membership to open rooms" do
+    bot = nil
+
+    assert_difference -> { Membership.count }, +Rooms::Open.count do
+      bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+    end
+
+    assert bot.bot?
+    assert bot.active?
+    assert bot.bot_token.present?
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+  end
+
+  test "bot requires a name" do
+    bot = User.new(name: "", role: :bot, creator: users(:kevin))
+    assert_not bot.valid?
+    assert_includes bot.errors[:name], "can't be blank"
+  end
+
+  test "authenticate_bot returns active bot for valid token and nil for invalid or deactivated" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+    token = bot.bot_token
+
+    assert_equal bot, User.authenticate_bot(token)
+    assert_nil User.authenticate_bot("wrong-token")
+    assert_nil User.authenticate_bot("")
+    assert_nil User.authenticate_bot(nil)
+
+    bot.deactivate
+    assert_nil User.authenticate_bot(token)
+    assert_nil bot.reload.bot_token
+  end
+
+  test "deactivating a bot removes non-direct memberships and preserves messages" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+    room = rooms(:pets)
+    message = room.messages.create!(creator: bot, body: "Deploy finished")
+
+    assert_difference -> { Membership.count }, -bot.memberships.without_direct_rooms.count do
+      bot.deactivate
+    end
+
+    assert bot.reload.deactivated?
+    assert Message.exists?(message.id)
+    assert_equal "Deploy Bot", message.reload.creator.name
+  end
+end
