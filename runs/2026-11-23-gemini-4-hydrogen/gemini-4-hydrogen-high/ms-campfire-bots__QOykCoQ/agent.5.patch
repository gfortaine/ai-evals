+
+  test "suspended bot keeps rooms, messages, and counts toward owner bot limit" do
+    kevin = users(:kevin)
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    bot = User.create!(name: "Flood Bot", role: :bot, creator: kevin, webhook_url: "https://example.com/hook")
+    room = rooms(:pets)
+    room.memberships.grant_to(bot)
+    message = room.messages.create!(creator: bot, body: "Hello")
+
+    assert kevin.bot_limit_reached?
+
+    10.times { bot.record_webhook_failure! }
+
+    assert bot.reload.suspended?
+    assert_equal User::Bot::WEBHOOK_SUSPENSION_REASON, bot.suspension_reason
+    assert_includes bot.rooms, room
+    assert Message.exists?(message.id)
+    assert kevin.bot_limit_reached?
+  end
+
+  test "reactivate! clears suspension, cooldown, flood window, and webhook failures" do
+    bot = User.create!(name: "Reset Bot", role: :bot, creator: users(:kevin))
+
+    freeze_time do
+      10.times do |i|
+        status, = bot.attempt_message_post { "ok-#{i}" }
+        assert_equal :ok, status
+      end
+
+      status, retry_after = bot.attempt_message_post { "over" }
+      assert_equal :cooldown, status
+      assert_equal 30, retry_after
+
+      5.times { bot.attempt_message_post { "during-cooldown" } }
+      assert bot.reload.suspended?
+      assert_equal User::Bot::FLOOD_SUSPENSION_REASON, bot.suspension_reason
+
+      bot.reactivate!
+      assert_not bot.reload.suspended?
+      assert_nil bot.suspension_reason
+      assert_nil bot.cooldown_until
+      assert_equal 0, bot.cooldown_attempts
+      assert_equal 0, bot.webhook_failures_count
+      assert_equal [], bot.recent_post_timestamps
+
+      # Even within the same frozen second, reactivated bot starts with a fresh window
+      status, = bot.attempt_message_post { "fresh" }
+      assert_equal :ok, status
+    end
+  end
