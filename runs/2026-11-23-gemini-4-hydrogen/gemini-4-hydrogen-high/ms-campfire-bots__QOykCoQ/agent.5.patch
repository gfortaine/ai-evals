@@ -398,4 +398,121 @@ test "administrators are not limited by bots_per_member" do
   end
   assert_redirected_to bots_url
 end
+
+  test "suspended bot stays listed on bots page showing Suspended with reason, and only admins see Reactivate" do
+    @kevin_bot.update!(suspended_at: Time.current, suspension_reason: User::Bot::FLOOD_SUSPENSION_REASON)
+
+    # Member sees their suspended bot with Suspended and reason, but no Reactivate button
+    sign_in :kevin
+    get bots_url
+    assert_response :ok
+    assert_select "##{dom_id(@kevin_bot)}" do
+      assert_select "strong", text: "Deploy Bot"
+      assert_select "strong", text: "Suspended"
+      assert_match User::Bot::FLOOD_SUSPENSION_REASON, response.body
+      assert_select "button", text: "Reactivate", count: 0
+    end
+
+    # Administrator sees Suspended, reason, and Reactivate button with confirmation
+    sign_in :david
+    get bots_url
+    assert_response :ok
+    assert_select "##{dom_id(@kevin_bot)}" do
+      assert_select "strong", text: "Deploy Bot"
+      assert_select "strong", text: "Suspended"
+      assert_select "button[data-turbo-confirm]", text: "Reactivate"
+    end
+  end
+
+  test "only administrators can reactivate a suspended bot" do
+    @kevin_bot.update!(
+      suspended_at: Time.current,
+      suspension_reason: User::Bot::WEBHOOK_SUSPENSION_REASON,
+      webhook_failures_count: 10,
+      cooldown_until: 20.seconds.from_now,
+      cooldown_attempts: 3
+    )
+
+    # Non-admin creator cannot reactivate
+    sign_in :kevin
+    post bot_reactivation_url(@kevin_bot)
+    assert_response :forbidden
+    assert @kevin_bot.reload.suspended?
+
+    # Non-admin updating bot does not reactivate it
+    patch bot_url(@kevin_bot), params: { bot: { name: "Still Suspended Bot" } }
+    assert_redirected_to bots_url
+    assert @kevin_bot.reload.suspended?
+
+    # Admin can reactivate
+    sign_in :david
+    post bot_reactivation_url(@kevin_bot)
+    assert_redirected_to bots_url
+
+    @kevin_bot.reload
+    assert_not @kevin_bot.suspended?
+    assert_nil @kevin_bot.suspension_reason
+    assert_equal 0, @kevin_bot.webhook_failures_count
+    assert_nil @kevin_bot.cooldown_until
+    assert_equal 0, @kevin_bot.cooldown_attempts
+  end
+
+  test "suspended bot still counts toward member bot limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    @kevin_bot.update!(suspended_at: Time.current, suspension_reason: User::Bot::FLOOD_SUSPENSION_REASON)
+
+    sign_in :kevin
+    get bots_url
+    assert_response :ok
+    assert_match "reached the limit", response.body
+    assert_select "li", text: /Deploy Bot/
+
+    post bots_url, params: { bot: { name: "Blocked Bot" } }
+    assert_response :forbidden
+  end
+
+  test "end-to-end: suspended bot cannot post or receive webhooks until administrator reactivates it" do
+    @kevin_bot.update!(webhook_url: "https://bot.example.com/webhook")
+    room = rooms(:hq)
+    room.memberships.grant_to(@kevin_bot)
+    clear_enqueued_jobs
+
+    freeze_time do
+      # Flood to suspension
+      10.times do |i|
+        post room_bot_messages_url(room, @kevin_bot.bot_token), params: "Msg #{i}"
+        assert_response :created
+      end
+      post room_bot_messages_url(room, @kevin_bot.bot_token), params: "Over"
+      assert_response :too_many_requests
+      5.times do
+        post room_bot_messages_url(room, @kevin_bot.bot_token), params: "Cooldown"
+      end
+      assert @kevin_bot.reload.suspended?
+
+      # Suspended bot gets 403 and receives no webhooks
+      post room_bot_messages_url(room, @kevin_bot.bot_token), params: "Blocked"
+      assert_response :forbidden
+      assert_no_enqueued_jobs only: Bot::WebhookJob do
+        room.messages.create!(creator: @david, body: "<div>#{mention_attachment_for(@kevin_bot)} ping</div>", client_message_id: "while-suspended")
+      end
+
+      # Admin reactivates on bots page
+      sign_in :david
+      post bot_reactivation_url(@kevin_bot)
+      assert_redirected_to bots_url
+      assert_not @kevin_bot.reload.suspended?
+
+      # Bot can post and receive webhooks again
+      post room_bot_messages_url(room, @kevin_bot.bot_token), params: "Back online"
+      assert_response :created
+
+      WebMock.stub_request(:post, "https://bot.example.com/webhook").to_return(status: 204, body: "")
+      assert_enqueued_jobs 1, only: Bot::WebhookJob do
+        room.messages.create!(creator: @david, body: "<div>#{mention_attachment_for(@kevin_bot)} welcome back</div>", client_message_id: "after-reactivate")
+      end
+      perform_enqueued_jobs only: Bot::WebhookJob
+      assert_requested :post, "https://bot.example.com/webhook", times: 1
+    end
+  end
 end
diff --git a/test/controllers/rooms/bot_messages_controller_test.rb b/test/controllers/rooms/bot_messages_controller_test.rb
