diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
new file mode 100644
index 0000000..ba76031
--- /dev/null
+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,198 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "creating a bot generates a bot token and does not join open rooms by default" do
+    bot = nil
+
+    assert_no_difference -> { Membership.count } do
+      bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+    end
+
+    assert bot.bot?
+    assert bot.active?
+    assert bot.bot_token.present?
+    assert_not bot.add_to_all_open_rooms?
+    assert_empty bot.rooms
+  end
+
+  test "creating a bot with add_to_all_open_rooms grants membership to all existing open rooms and notifies webhook" do
+    bot = nil
+
+    assert_enqueued_jobs Rooms::Open.count, only: Bot::WebhookJob do
+      assert_difference -> { Membership.count }, +Rooms::Open.count do
+        bot = User.create!(
+          name: "Everyone Bot",
+          role: :bot,
+          creator: users(:kevin),
+          webhook_url: "https://example.com/hook",
+          add_to_all_open_rooms: true
+        )
+      end
+    end
+
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+  end
+
+  test "toggling add_to_all_open_rooms on joins remaining open rooms without duplicating existing rooms, and toggling off keeps memberships" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin), webhook_url: "https://example.com/hook")
+    rooms(:pets).memberships.grant_to(bot)
+    clear_enqueued_jobs
+
+    assert_enqueued_jobs Rooms::Open.count - 1, only: Bot::WebhookJob do
+      assert_difference -> { bot.memberships.count }, +(Rooms::Open.count - 1) do
+        bot.update!(add_to_all_open_rooms: true)
+      end
+    end
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+
+    # Updating other attributes while switch stays on does not re-notify
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      bot.update!(name: "Deploy Bot 2")
+    end
+
+    # Turning switch off keeps existing memberships
+    assert_no_difference -> { bot.memberships.count } do
+      bot.update!(add_to_all_open_rooms: false)
+    end
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+
+    # Future open rooms do not include the bot once switch is off
+    new_open = Rooms::Open.create!(name: "Later Room", creator: users(:david))
+    assert_not_includes new_open.users, bot
+  end
+
+  test "bot requires a name" do
+    bot = User.new(name: "", role: :bot, creator: users(:kevin))
+    assert_not bot.valid?
+    assert_includes bot.errors[:name], "can't be blank"
+  end
+
+  test "bot accepts optional valid webhook_url and normalizes blank to nil" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin), webhook_url: "  https://example.com/hook  ")
+    assert_equal "https://example.com/hook", bot.webhook_url
+
+    bot.update!(webhook_url: "   ")
+    assert_nil bot.reload.webhook_url
+
+    bot.update!(webhook_url: "http://127.0.0.1:3001/webhook")
+    assert_equal "http://127.0.0.1:3001/webhook", bot.reload.webhook_url
+  end
+
+  test "bot rejects invalid webhook_url" do
+    [ "not-a-url", "ftp://example.com/hook", "/relative/path", "http://" ].each do |invalid_url|
+      bot = User.new(name: "Deploy Bot", role: :bot, creator: users(:kevin), webhook_url: invalid_url)
+      assert_not bot.valid?, "Expected #{invalid_url.inspect} to be invalid"
+      assert_includes bot.errors[:webhook_url], "must be a valid HTTP or HTTPS URL"
+    end
+  end
+
+  test "authenticate_bot returns active bot for valid token and nil for invalid or deactivated" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin), webhook_url: "https://example.com/hook")
+    token = bot.bot_token
+
+    assert_equal bot, User.authenticate_bot(token)
+    assert_nil User.authenticate_bot("wrong-token")
+    assert_nil User.authenticate_bot("")
+    assert_nil User.authenticate_bot(nil)
+
+    bot.deactivate
+    assert_nil User.authenticate_bot(token)
+    assert_nil bot.reload.bot_token
+    assert_nil bot.webhook_url
+  end
+
+  test "deactivating a bot removes non-direct memberships and preserves messages" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin), add_to_all_open_rooms: true)
+    room = rooms(:pets)
+    message = room.messages.create!(creator: bot, body: "Deploy finished")
+
+    assert_difference -> { Membership.count }, -bot.memberships.without_direct_rooms.count do
+      bot.deactivate
+    end
+
+    assert bot.reload.deactivated?
+    assert_not bot.add_to_all_open_rooms?
+    assert Message.exists?(message.id)
+    assert_equal "Deploy Bot", message.reload.creator.name
+  end
+
+test "bot_limit_reached? checks active created bots against account limit for members only" do
+  kevin = users(:kevin)
+  david = users(:david)
+
+  accounts(:signal).update!(settings: { bots_per_member: 2 })
+
+  bot1 = User.create!(name: "Bot 1", role: :bot, creator: kevin)
+  assert_not kevin.bot_limit_reached?
+
+  bot2 = User.create!(name: "Bot 2", role: :bot, creator: kevin)
+  assert kevin.bot_limit_reached?
+
+  # Deleted (deactivated) bots do not count toward the limit
+  bot1.deactivate
+  assert_not kevin.bot_limit_reached?
+
+  # Lowering the limit below active bots does not remove existing bots
+  User.create!(name: "Bot 3", role: :bot, creator: kevin)
+  accounts(:signal).update!(settings: { bots_per_member: 1 })
+  assert kevin.bot_limit_reached?
+  assert_equal 2, kevin.created_bots.active.count
+  assert bot2.reload.active?
+
+  # Administrators are never limited
+  3.times { |i| User.create!(name: "Admin Bot #{i}", role: :bot, creator: david) }
+  assert_not david.bot_limit_reached?
+end
+
+  test "suspended bot keeps rooms, messages, and counts toward owner bot limit" do
+    kevin = users(:kevin)
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    bot = User.create!(name: "Flood Bot", role: :bot, creator: kevin, webhook_url: "https://example.com/hook")
+    room = rooms(:pets)
+    room.memberships.grant_to(bot)
+    message = room.messages.create!(creator: bot, body: "Hello")
+
+    assert kevin.bot_limit_reached?
+
+    10.times { bot.record_webhook_failure! }
+
+    assert bot.reload.suspended?
+    assert_equal User::Bot::WEBHOOK_SUSPENSION_REASON, bot.suspension_reason
+    assert_includes bot.rooms, room
+    assert Message.exists?(message.id)
+    assert kevin.bot_limit_reached?
+  end
+
+  test "reactivate! clears suspension, cooldown, flood window, and webhook failures" do
+    bot = User.create!(name: "Reset Bot", role: :bot, creator: users(:kevin))
+
+    freeze_time do
+      10.times do |i|
+        status, = bot.attempt_message_post { "ok-#{i}" }
+        assert_equal :ok, status
+      end
+
+      status, retry_after = bot.attempt_message_post { "over" }
+      assert_equal :cooldown, status
+      assert_equal 30, retry_after
+
+      5.times { bot.attempt_message_post { "during-cooldown" } }
+      assert bot.reload.suspended?
+      assert_equal User::Bot::FLOOD_SUSPENSION_REASON, bot.suspension_reason
+
+      bot.reactivate!
+      assert_not bot.reload.suspended?
+      assert_nil bot.suspension_reason
+      assert_nil bot.cooldown_until
+      assert_equal 0, bot.cooldown_attempts
+      assert_equal 0, bot.webhook_failures_count
+      assert_equal [], bot.recent_post_timestamps
+
+      # Even within the same frozen second, reactivated bot starts with a fresh window
+      status, = bot.attempt_message_post { "fresh" }
+      assert_equal :ok, status
+    end
+  end
+end
