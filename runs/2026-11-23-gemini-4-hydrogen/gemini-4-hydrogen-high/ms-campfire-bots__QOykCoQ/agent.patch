@@ -0,0 +1,12 @@
+class Bot::WebhookJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bot, target)
+    case target
+    when Message
+      Bot::Webhook.new(bot:, message: target, event: "mention").deliver
+    when Room
+      Bot::Webhook.new(bot:, room: target, event: "joined").deliver
+    end
+  end
+end
