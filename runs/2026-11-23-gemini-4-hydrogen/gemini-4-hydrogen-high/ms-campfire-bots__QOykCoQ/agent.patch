+      assert_enqueued_jobs 1, only: Bot::WebhookJob do
+        room.messages.create!(creator: @david, body: "<div>#{mention_attachment_for(@kevin_bot)} welcome back</div>", client_message_id: "after-reactivate")
+      end
+      perform_enqueued_jobs only: Bot::WebhookJob
+      assert_requested :post, "https://bot.example.com/webhook", times: 1
+    end
+  end
+end
