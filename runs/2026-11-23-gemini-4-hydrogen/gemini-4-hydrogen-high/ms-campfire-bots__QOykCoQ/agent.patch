+require "test_helper"
+
+class Rooms::BotMessagesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    host! "once.campfire.test"
+    @bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+    @open_room = rooms(:hq)
+    @closed_room = rooms(:designers)
+    @open_room.memberships.grant_to(@bot)
+  end
+
+  test "posting a raw text message creates message, returns 201 with Location, broadcasts, and pushes notifications" do
+    assert_enqueued_jobs 1, only: [ Room::PushMessageJob ] do
+      assert_difference -> { @open_room.messages.count }, 1 do
+        post room_bot_messages_url(@open_room, @bot.bot_token),
+          params: "Deploy of v1.2.3 finished ✅",
+          headers: {
+            "Content-Type" => "application/x-www-form-urlencoded",
+            "User-Agent" => "curl/8.5.0"
+          }
+      end
+    end
+
+    message = @open_room.messages.order(:id).last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal @bot, message.creator
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+  end
+
+  test "raw request body with &, =, and + is preserved without form-decoding mangling" do
+    raw = "1 + 1 = 2 & key=val"
+
+    post room_bot_messages_url(@open_room, @bot.bot_token),
+      params: raw,
+      headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+
+    assert_response :created
+    assert_equal raw, @open_room.messages.order(:id).last.plain_text_body
+  end
+
+  test "posting broadcasts turbo stream showing bot name as author and updates unread rooms" do
+    post room_bot_messages_url(@open_room, @bot.bot_token),
+      params: "Build green",
+      headers: { "Content-Type" => "text/plain" }
+
+    assert_rendered_turbo_stream_broadcast @open_room, :messages, action: "append", target: [ @open_room, :messages ] do
+      assert_select ".message__author", text: /Deploy Bot/
+      assert_select ".message__body", text: /Build green/
+    end
+
+    @open_room.users.each do |member|
+      assert_broadcasts UnreadRoomsChannel.stream_name_for(member.id), 1 do
+        post room_bot_messages_url(@open_room, @bot.bot_token),
+          params: "Build green #{member.id}",
+          headers: { "Content-Type" => "text/plain" }
+      end
+    end
+  end
+
+  test "posting triggers web push notifications for room members" do
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      WebPush.expects(:payload_send).times(Push::Subscription.count)
+      post room_bot_messages_url(@open_room, @bot.bot_token),
+        params: "Release ready",
+        headers: { "Content-Type" => "text/plain" }
+    end
+  end
+
+  test "posting a multipart attachment creates an attachment message" do
+    assert_difference -> { @open_room.messages.count }, 1 do
+      post room_bot_messages_url(@open_room, @bot.bot_token),
+        params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+    end
+
+    message = @open_room.messages.order(:id).last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert message.attachment?
+  end
+
+  test "empty body and no attachment returns 422 Unprocessable Content" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@open_room, @bot.bot_token),
+        params: "",
+        headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    end
+    assert_response :unprocessable_content
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@open_room, @bot.bot_token),
+        params: "   \n  ",
+        headers: { "Content-Type" => "text/plain" }
+    end
+    assert_response :unprocessable_content
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@open_room, @bot.bot_token),
+        params: { other: "value" },
+        headers: { "Content-Type" => "multipart/form-data" }
+    end
+    assert_response :unprocessable_content
+  end
+
+  test "invalid bot code returns 401 Unauthorized" do
+    post room_bot_messages_url(@open_room, "invalid-code"), params: "Hello"
+    assert_response :unauthorized
+  end
+
+  test "deleted bot can no longer post messages" do
+    token = @bot.bot_token
+    @bot.deactivate
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@open_room, token), params: "Hello"
+    end
+    assert_response :unauthorized
+  end
+
+  test "bad room id returns 404 Not Found" do
+    post "/rooms/999999/#{@bot.bot_token}/messages", params: "Hello"
+    assert_response :not_found
+  end
+
+  test "bot cannot post to closed room until added as a member" do
+    post room_bot_messages_url(@closed_room, @bot.bot_token), params: "Hello"
+    assert_response :not_found
+
+    @closed_room.memberships.grant_to(@bot)
+
+    post room_bot_messages_url(@closed_room, @bot.bot_token), params: "Now I am in!"
+    assert_response :created
+  end
+
+  test "bot cannot post to open room it is not a member of until added" do
+    post room_bot_messages_url(rooms(:pets), @bot.bot_token), params: "Hello"
+    assert_response :not_found
+
+    rooms(:pets).memberships.grant_to(@bot)
+
+    post room_bot_messages_url(rooms(:pets), @bot.bot_token), params: "Now I am in!"
+    assert_response :created
+  end
+
+  test "posting without Content-Type header works and renders bot as author in room" do
+    post room_bot_messages_url(@open_room, @bot.bot_token), params: "Plain payload"
+    assert_response :created
+
+    sign_in :david
+    get room_url(@open_room)
+    assert_response :ok
+    assert_select ".message__author", text: /Deploy Bot/
+    assert_select ".message__body", text: /Plain payload/
+  end
+
+  test "bot may post 10 messages in 10 seconds, 11th starts 30s cooldown with 429 and Retry-After, and 5 more attempts suspend" do
+    freeze_time do
+      10.times do |i|
+        post room_bot_messages_url(@open_room, @bot.bot_token), params: "Msg #{i}"
+        assert_response :created
+      end
+
+      # 11th message goes over the limit and starts a 30-second cooldown
+      assert_no_difference -> { Message.count } do
+        post room_bot_messages_url(@open_room, @bot.bot_token), params: "Msg 10"
+      end
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+      assert @bot.reload.in_cooldown?
+      assert_not @bot.suspended?
+
+      # 10 seconds into cooldown: 4 attempts return 429 with Retry-After = 20
+      travel 10.seconds
+      4.times do |i|
+        post room_bot_messages_url(@open_room, @bot.bot_token), params: "Cooldown #{i}"
+        assert_response :too_many_requests
+        assert_equal "20", response.headers["Retry-After"]
+        assert_not @bot.reload.suspended?
+      end
+
+      # 5th more attempt during the same cooldown suspends the bot
+      post room_bot_messages_url(@open_room, @bot.bot_token), params: "Cooldown 4"
+      assert_response :too_many_requests
+      assert @bot.reload.suspended?
+      assert_equal User::Bot::FLOOD_SUSPENSION_REASON, @bot.suspension_reason
+
+      # Suspended bot gets 403 Forbidden from posting endpoint
+      post room_bot_messages_url(@open_room, @bot.bot_token), params: "After suspend"
+      assert_response :forbidden
+    end
+  end
+
+  test "cooldown expires after 30 seconds if fewer than 5 attempts occurred and resets attempt counter for next cooldown" do
+    freeze_time do
+      10.times do |i|
+        post room_bot_messages_url(@open_room, @bot.bot_token), params: "Burst 1 - #{i}"
+        assert_response :created
+      end
+
+      # Start cooldown
+      post room_bot_messages_url(@open_room, @bot.bot_token), params: "Over 1"
+      assert_response :too_many_requests
+
+      # 4 attempts during cooldown (below 5)
+      4.times do |i|
+        post room_bot_messages_url(@open_room, @bot.bot_token), params: "Attempt #{i}"
+        assert_response :too_many_requests
+      end
+      assert_not @bot.reload.suspended?
+
+      # After 30 seconds, cooldown is over and bot can post again
+      travel 30.seconds
+      post room_bot_messages_url(@open_room, @bot.bot_token), params: "After cooldown"
+      assert_response :created
+
+      # Flooding again starts a fresh cooldown requiring 5 new attempts
+      9.times do |i|
+        post room_bot_messages_url(@open_room, @bot.bot_token), params: "Burst 2 - #{i}"
+        assert_response :created
+      end
+
+      post room_bot_messages_url(@open_room, @bot.bot_token), params: "Over 2"
+      assert_response :too_many_requests
+      assert_not @bot.reload.suspended?
+
+      4.times do
+        post room_bot_messages_url(@open_room, @bot.bot_token), params: "Burst 2 cooldown"
+        assert_response :too_many_requests
+        assert_not @bot.reload.suspended?
+      end
+
+      post room_bot_messages_url(@open_room, @bot.bot_token), params: "Burst 2 suspend"
+      assert @bot.reload.suspended?
+    end
+  end
+
+  test "sliding 10-second window allows posting as old messages age out" do
+  freeze_time do
+    post room_bot_messages_url(@open_room, @bot.bot_token), params: "First"
+    assert_response :created
+
+    travel 5.seconds
+    9.times do |i|
+      post room_bot_messages_url(@open_room, @bot.bot_token), params: "Later #{i}"
+      assert_response :created
+    end
+
+    # At t=10s, "First" (from t=0s) has aged out so 9 messages remain in the window
+    travel 5.seconds
+    post room_bot_messages_url(@open_room, @bot.bot_token), params: "Eleventh after First aged out"
+    assert_response :created
+
+    # Now 10 messages are in (t=0s, t=10s] (the 9 from t=5s + 1 at t=10s), so 12th goes over
+    post room_bot_messages_url(@open_room, @bot.bot_token), params: "Twelfth over limit"
+    assert_response :too_many_requests
+  end
+end
+
+  test "API messages and webhook replies share the same 10-message flooding limit" do
+    @bot.update!(webhook_url: "https://bot.example.com/webhook")
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Webhook reply")
+
+    freeze_time do
+      # 6 via API
+      6.times do |i|
+        post room_bot_messages_url(@open_room, @bot.bot_token), params: "API #{i}"
+        assert_response :created
+      end
+
+      # 4 via webhook reply (total 10)
+      4.times do |i|
+        @open_room.messages.create!(
+          creator: users(:david),
+          body: "<div>#{mention_attachment_for(@bot)} hi #{i}</div>",
+          client_message_id: "mix-#{i}"
+        )
+        assert_difference -> { @open_room.messages.count }, 1 do
+          perform_enqueued_jobs only: Bot::WebhookJob
+        end
+      end
+
+      # 11th via API is rejected with 429
+      post room_bot_messages_url(@open_room, @bot.bot_token), params: "Over mixed limit"
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+    end
+  end
+end
