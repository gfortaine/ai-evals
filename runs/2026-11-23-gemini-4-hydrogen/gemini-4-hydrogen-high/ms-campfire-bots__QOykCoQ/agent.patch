+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    @kevin = users(:kevin) # member
+    @jz = users(:jz)       # member
+    @david = users(:david) # administrator
+
+    @kevin_bot = User.create!(name: "Deploy Bot", role: :bot, creator: @kevin)
+    @jz_bot = User.create!(name: "Alert Bot", role: :bot, creator: @jz)
+  end
+
+  test "account edit page shows Set up chat bots link to any member" do
+    sign_in :kevin
+    get edit_account_url
+    assert_response :ok
+    assert_select "a[href='#{bots_path}'][aria-label='Set up chat bots']"
+    assert_select "strong", text: @kevin_bot.name, count: 0
+  end
+
+  test "index lists only bots created by current member without pagination" do
+    sign_in :kevin
+    get bots_url
+
+    assert_response :ok
+    assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "label", text: "Bot code"
+      assert_select "input[readonly][value='#{@kevin_bot.bot_token}']"
+      assert_select "a[href='#{edit_bot_path(@kevin_bot)}'][aria-label='Edit Deploy Bot']"
+    end
+    assert_select "li", text: /Alert Bot/, count: 0
+  end
+
+  test "index lists all bots for administrators" do
+    sign_in :david
+    get bots_url
+
+    assert_response :ok
+    assert_select "li", text: /Deploy Bot/
+    assert_select "li", text: /Alert Bot/
+  end
+
+  test "new renders bot creation form with Add to all open rooms switch off by default" do
+    sign_in :kevin
+    get new_bot_url
+
+    assert_response :ok
+    assert_select "input[type=file][name='bot[avatar]']"
+    assert_select "input[type=text][name='bot[name]'][required][aria-label='Name the bot']"
+    assert_select "label", text: "Add to all open rooms"
+    assert_select "input[type=checkbox][name='bot[add_to_all_open_rooms]']"
+    assert_select "input[type=checkbox][name='bot[add_to_all_open_rooms]'][checked]", count: 0
+    assert_select "button[type=submit][aria-label='Save changes']"
+  end
+
+  test "create creates a bot with optional avatar, does not join open rooms by default, and redirects to bots index" do
+    sign_in :kevin
+
+    assert_difference -> { User.bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Build Bot", avatar: fixture_file_upload("moon.jpg", "image/jpeg") } }
+    end
+
+    assert_redirected_to bots_url
+    bot = User.bot.order(:id).last
+    assert_equal "Build Bot", bot.name
+    assert_equal @kevin, bot.creator
+    assert bot.avatar.attached?
+    assert_not bot.add_to_all_open_rooms?
+    assert_empty bot.rooms
+  end
+
+  test "create with Add to all open rooms on joins all existing open rooms and enqueues joined webhooks" do
+    sign_in :kevin
+
+    assert_enqueued_jobs Rooms::Open.count, only: Bot::WebhookJob do
+      assert_difference -> { User.bot.count }, 1 do
+        post bots_url, params: {
+          bot: {
+            name: "Welcome Bot",
+            webhook_url: "https://example.com/hook",
+            add_to_all_open_rooms: "1"
+          }
+        }
+      end
+    end
+
+    assert_redirected_to bots_url
+    bot = User.bot.order(:id).last
+    assert bot.add_to_all_open_rooms?
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+  end
+
+  test "create rejects blank name" do
+    sign_in :kevin
+
+    assert_no_difference -> { User.bot.count } do
+      post bots_url, params: { bot: { name: "" } }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "edit renders form with Add to all open rooms switch and Delete this chat bot button with confirmation" do
+    sign_in :kevin
+    get edit_bot_url(@kevin_bot)
+
+    assert_response :ok
+    assert_select "input[type=text][name='bot[name]'][value='Deploy Bot'][aria-label='Name the bot']"
+    assert_select "label", text: "Add to all open rooms"
+    assert_select "input[type=checkbox][name='bot[add_to_all_open_rooms]']"
+    assert_select "input[type=checkbox][name='bot[add_to_all_open_rooms]'][checked]", count: 0
+    assert_select "button[type=submit][aria-label='Save changes']"
+    assert_select "button[data-turbo-confirm]", text: /Delete this chat bot/
+
+    @kevin_bot.update!(add_to_all_open_rooms: true)
+    get edit_bot_url(@kevin_bot)
+    assert_response :ok
+    assert_select "input[type=checkbox][name='bot[add_to_all_open_rooms]'][checked]"
+  end
+
+  test "update toggling Add to all open rooms on joins remaining open rooms and toggling off preserves memberships" do
