+++ b/test/models/bot/webhook_test.rb
@@ -0,0 +1,403 @@
+require "test_helper"
+
+class Bot::WebhookTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @author = users(:david)
+    @room = rooms(:hq)
+    @bot = User.create!(
+      name: "Deploy Bot",
+      role: :bot,
+      creator: @author,
+      webhook_url: "https://bot.example.com/webhook"
+    )
+    @room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+  end
+
+  test "delivers expected JSON payload and posts 200 text/plain response as bot message" do
+    captured_request = nil
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return do |request|
+        captured_request = request
+        {
+          status: 200,
+          headers: { "Content-Type" => "text/plain; charset=utf-8" },
+          body: "Build #42 started & running\nCheck logs <here>"
+        }
+      end
+
+    message = @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} restart the build please</div>",
+      client_message_id: "msg-1"
+    )
+
+    assert_difference -> { @room.messages.count }, 1 do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+
+    assert_equal "application/json", captured_request.headers["Content-Type"]
+    payload = JSON.parse(captured_request.body)
+
+    assert_equal "mention", payload["event"]
+    assert_equal({ "id" => @author.id, "name" => @author.name }, payload["author"])
+    assert_equal({
+      "id" => @room.id,
+      "name" => @room.name,
+      "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_token}/messages"
+    }, payload["room"])
+    assert_equal message.id, payload.dig("message", "id")
+    assert_equal "restart the build please", payload.dig("message", "body", "text")
+    assert_equal message.body.body.to_html, payload.dig("message", "body", "html")
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", payload.dig("message", "link")
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Build #42 started & running\nCheck logs <here>", reply.plain_text_body
+  end
+
+  test "posts 200 text/html response as rich-text bot message" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(
+        status: 200,
+        headers: { "Content-Type" => "text/html" },
+        body: "<div>Deploy <strong>succeeded</strong>!</div>"
+      )
+
+    @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} status</div>",
+      client_message_id: "msg-html"
+    )
+
+    assert_difference -> { @room.messages.count }, 1 do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Deploy succeeded!", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "<strong>succeeded</strong>"
+  end
+
+  test "204 response posts no message" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 204, body: "")
+
+    @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} ping</div>",
+      client_message_id: "msg-204"
+    )
+
+    assert_no_difference -> { @room.messages.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+
+  test "200 response with unsupported content type or blank body posts no message" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "application/json" }, body: '{"ok":true}')
+
+    @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} ping</div>",
+      client_message_id: "msg-json"
+    )
+
+    assert_no_difference -> { @room.messages.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "   \n  ")
+
+    @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} ping2</div>",
+      client_message_id: "msg-blank"
+    )
+
+    assert_no_difference -> { @room.messages.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+
+  test "network failures and 500 responses do not raise or post messages" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook").to_timeout
+
+    @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} ping</div>",
+      client_message_id: "msg-timeout"
+    )
+
+    assert_no_difference -> { @room.messages.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 500, headers: { "Content-Type" => "text/plain" }, body: "Internal Server Error")
+
+    @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} ping2</div>",
+      client_message_id: "msg-500"
+    )
+
+    assert_no_difference -> { @room.messages.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+
+  test "bot mentioning itself does not trigger its own webhook" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Should not run")
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      @room.messages.create!(
+        creator: @bot,
+        body: "<div>#{mention_attachment_for(@bot)} self ping</div>",
+        client_message_id: "msg-self"
+      )
+    end
+  end
+
+  test "adding a bot to a room delivers joined event JSON payload and posts 200 text/plain or text/html reply" do
+    closed_room = rooms(:designers)
+    captured_request = nil
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return do |request|
+        captured_request = request
+        {
+          status: 200,
+          headers: { "Content-Type" => "text/plain" },
+          body: "Hello Designers!"
+        }
+      end
+
+    assert_enqueued_with(job: Bot::WebhookJob, args: [ @bot, closed_room ]) do
+      assert_enqueued_jobs 1, only: Bot::WebhookJob do
+        closed_room.memberships.grant_to(@bot)
+      end
+    end
+
+    assert_difference -> { closed_room.messages.count }, 1 do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+
+    assert_equal "application/json", captured_request.headers["Content-Type"]
+    payload = JSON.parse(captured_request.body)
+    assert_equal({
+      "event" => "joined",
+      "room" => {
+        "id" => closed_room.id,
+        "name" => closed_room.name,
+        "reply_to" => "/rooms/#{closed_room.id}/#{@bot.bot_token}/messages"
+      }
+    }, payload)
+
+    reply = closed_room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Hello Designers!", reply.plain_text_body
+  end
+
+  test "joined event supports 200 text/html reply and ignores 204" do
+    ops = Rooms::Closed.create!(name: "Ops", creator: @author)
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(
+        status: 200,
+        headers: { "Content-Type" => "text/html" },
+        body: "<div>Hello <strong>Ops</strong>!</div>"
+      )
+
+    ops.memberships.grant_to(@bot)
+    assert_difference -> { ops.messages.count }, 1 do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+    reply = ops.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.body.to_html, "<strong>Ops</strong>"
+
+    watercooler = rooms(:watercooler)
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 204, body: "")
+
+    watercooler.memberships.grant_to(@bot)
+    assert_no_difference -> { watercooler.messages.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+
+  test "granting membership to a room the bot is already in does not trigger duplicate joined events" do
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      @room.memberships.grant_to(@bot)
+    end
+  end
+
+  test "direct conversations never trigger joined events" do
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      Current.user = @author
+      direct = Rooms::Direct.find_or_create_for([ @author, @bot ])
+      direct.memberships.grant_to(@bot)
+    end
+
+    other_direct = Rooms::Direct.create!(creator: @author)
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      other_direct.memberships.create!(user: @bot)
+    end
+  end
+
+  test "direct Membership.create! for non-direct room triggers joined once" do
+    closed_room = rooms(:watercooler)
+
+    assert_enqueued_with(job: Bot::WebhookJob, args: [ @bot, closed_room ]) do
+      assert_enqueued_jobs 1, only: Bot::WebhookJob do
+        closed_room.memberships.create!(user: @bot)
+      end
+    end
+  end
+
+  test "joined webhook is skipped if bot is removed from room before job executes" do
+    closed_room = rooms(:watercooler)
+    closed_room.memberships.grant_to(@bot)
+    closed_room.memberships.revoke_from(@bot)
+
+    stub = WebMock.stub_request(:post, "https://bot.example.com/webhook")
+    perform_enqueued_jobs only: Bot::WebhookJob
+    assert_not_requested stub
+  end
+
+  test "ten consecutive failed deliveries suspend the bot and a 2xx delivery resets the failure count" do
+    # Mix of non-2xx, timeout, and connection error
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 500).times(3)
+      .then.to_return(status: 404).times(2)
+      .then.to_return(status: 302).times(2)
+      .then.to_timeout.times(1)
+      .then.to_raise(Errno::ECONNREFUSED).times(1)
+
+    9.times do |i|
+      @room.messages.create!(
+        creator: @author,
+        body: "<div>#{mention_attachment_for(@bot)} fail #{i}</div>",
+        client_message_id: "fail-#{i}"
+      )
+      perform_enqueued_jobs only: Bot::WebhookJob
+      assert_not @bot.reload.suspended?
+      assert_equal i + 1, @bot.webhook_failures_count
+    end
+
+    # A 204 (2xx) resets the count
+    WebMock.stub_request(:post, "https://bot.example.com/webhook").to_return(status: 204, body: "")
+    @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} ok</div>",
+      client_message_id: "ok-reset"
+    )
+    perform_enqueued_jobs only: Bot::WebhookJob
+    assert_equal 0, @bot.reload.webhook_failures_count
+    assert_not @bot.suspended?
+
+    # Now 10 failures in a row suspend the bot
+    WebMock.stub_request(:post, "https://bot.example.com/webhook").to_return(status: 503)
+    10.times do |i|
+      @room.messages.create!(
+        creator: @author,
+        body: "<div>#{mention_attachment_for(@bot)} fail2-#{i}</div>",
+        client_message_id: "fail2-#{i}"
+      )
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+
+    assert @bot.reload.suspended?
+    assert_equal 10, @bot.webhook_failures_count
+    assert_equal User::Bot::WEBHOOK_SUSPENSION_REASON, @bot.suspension_reason
+  end
+
+  test "suspended bot receives no webhooks on mention, room join, or already-enqueued jobs" do
+    # Enqueue a job before suspension
+    @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} queued</div>",
+      client_message_id: "queued-before-suspend"
+    )
+
+    10.times { @bot.record_webhook_failure! }
+    assert @bot.reload.suspended?
+
+    stub = WebMock.stub_request(:post, "https://bot.example.com/webhook")
+
+    # Already-enqueued job should not deliver
+    perform_enqueued_jobs only: Bot::WebhookJob
+    assert_not_requested stub
+
+    # New mentions should not enqueue or deliver
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      @room.messages.create!(
+        creator: @author,
+        body: "<div>#{mention_attachment_for(@bot)} after suspend</div>",
+        client_message_id: "after-suspend"
+      )
+    end
+
+    # Joining a closed room or open room should not enqueue or deliver
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      rooms(:watercooler).memberships.grant_to(@bot)
+      rooms(:pets).memberships.create!(user: @bot)
+    end
+    assert_not_requested stub
+  end
+
+  test "webhook replies count toward flooding limit and are blocked during cooldown" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Pong")
+
+    freeze_time do
+      # 10 webhook replies succeed within 10 seconds
+      10.times do |i|
+        @room.messages.create!(
+          creator: @author,
+          body: "<div>#{mention_attachment_for(@bot)} ping #{i}</div>",
+          client_message_id: "wh-ping-#{i}"
+        )
+        assert_difference -> { @room.messages.count }, 1 do
+          perform_enqueued_jobs only: Bot::WebhookJob
+        end
+      end
+
+      # 11th webhook reply goes over limit -> not posted, starts 30s cooldown (webhook itself still succeeded -> 0 failures)
+      @room.messages.create!(
+        creator: @author,
+        body: "<div>#{mention_attachment_for(@bot)} ping 10</div>",
+        client_message_id: "wh-ping-10"
+      )
+      assert_no_difference -> { @room.messages.count } do
+        perform_enqueued_jobs only: Bot::WebhookJob
+      end
+      assert @bot.reload.in_cooldown?
+      assert_equal 0, @bot.webhook_failures_count
+      assert_not @bot.suspended?
+
+      # 5 more attempts via webhook replies during the same cooldown suspend the bot
+      5.times do |i|
+        @room.messages.create!(
+          creator: @author,
+          body: "<div>#{mention_attachment_for(@bot)} ping cooldown #{i}</div>",
+          client_message_id: "wh-cooldown-#{i}"
+        )
+        assert_no_difference -> { @room.messages.count } do
+          perform_enqueued_jobs only: Bot::WebhookJob
+        end
+      end
+
+      assert @bot.reload.suspended?
+      assert_equal User::Bot::FLOOD_SUSPENSION_REASON, @bot.suspension_reason
+    end
+  end
+end
