diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
index 7b5188c..0fa1ad8 100644
--- a/test/models/user/bot_test.rb
+++ b/test/models/user/bot_test.rb
@@ -117,4 +117,32 @@ class User::BotTest < ActiveSupport::TestCase
     assert Message.exists?(message.id)
     assert_equal "Deploy Bot", message.reload.creator.name
   end
+
+test "bot_limit_reached? checks active created bots against account limit for members only" do
+  kevin = users(:kevin)
+  david = users(:david)
+
+  accounts(:signal).update!(settings: { bots_per_member: 2 })
+
+  bot1 = User.create!(name: "Bot 1", role: :bot, creator: kevin)
+  assert_not kevin.bot_limit_reached?
+
+  bot2 = User.create!(name: "Bot 2", role: :bot, creator: kevin)
+  assert kevin.bot_limit_reached?
+
+  # Deleted (deactivated) bots do not count toward the limit
+  bot1.deactivate
+  assert_not kevin.bot_limit_reached?
+
+  # Lowering the limit below active bots does not remove existing bots
+  User.create!(name: "Bot 3", role: :bot, creator: kevin)
+  accounts(:signal).update!(settings: { bots_per_member: 1 })
+  assert kevin.bot_limit_reached?
+  assert_equal 2, kevin.created_bots.active.count
+  assert bot2.reload.active?
+
+  # Administrators are never limited
+  3.times { |i| User.create!(name: "Admin Bot #{i}", role: :bot, creator: david) }
+  assert_not david.bot_limit_reached?
+end
 end
