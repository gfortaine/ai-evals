diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
index 94ba96e..4715295 100644
--- a/test/controllers/bots_controller_test.rb
+++ b/test/controllers/bots_controller_test.rb
@@ -302,4 +302,100 @@ class BotsControllerTest < ActionDispatch::IntegrationTest
     assert_response :unprocessable_content
     assert_nil @kevin_bot.reload.webhook_url
   end
+
+test "member at bot limit does not see Add a chat bot, sees reached the limit, and cannot create bots" do
+  accounts(:signal).update!(settings: { bots_per_member: 2 })
+  User.create!(name: "Second Bot", role: :bot, creator: @kevin)
+
+  sign_in :kevin
+  get bots_url
+  assert_response :ok
+  assert_select "a[href=\x27#{new_bot_path}\x27]", count: 0
+  assert_no_match "Add a chat bot", response.body
+  assert_match "reached the limit", response.body
+  assert_select "li", text: /Deploy Bot/
+  assert_select "li", text: /Second Bot/
+
+  get new_bot_url
+  assert_response :forbidden
+
+  assert_no_difference -> { User.bot.count } do
+    post bots_url, params: { bot: { name: "Over Limit Bot" } }
+  end
+  assert_response :forbidden
+
+  # Other members below the limit are unaffected
+  sign_in :jz
+  get bots_url
+  assert_response :ok
+  assert_select "a[href=\x27#{new_bot_path}\x27]", text: /Add a chat bot/
+  assert_no_match "reached the limit", response.body
+end
+
+test "deleted bots do not count toward member bot limit" do
+  accounts(:signal).update!(settings: { bots_per_member: 1 })
+  sign_in :kevin
+
+  get bots_url
+  assert_match "reached the limit", response.body
+
+  delete bot_url(@kevin_bot)
+  assert_redirected_to bots_url
+
+  get bots_url
+  assert_response :ok
+  assert_select "a[href=\x27#{new_bot_path}\x27]", text: /Add a chat bot/
+  assert_no_match "reached the limit", response.body
+
+  assert_difference -> { User.active.bot.count }, 1 do
+    post bots_url, params: { bot: { name: "Replacement Bot" } }
+  end
+  assert_redirected_to bots_url
+end
+
+test "lowering bots_per_member preserves existing bots and allows editing or deleting them" do
+  User.create!(name: "Bot Two", role: :bot, creator: @kevin)
+  bot3 = User.create!(name: "Bot Three", role: :bot, creator: @kevin)
+  accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+  sign_in :kevin
+  get bots_url
+  assert_response :ok
+  assert_select "li", count: 3
+  assert_match "reached the limit", response.body
+  assert_no_match "Add a chat bot", response.body
+
+  assert_no_difference -> { User.bot.count } do
+    post bots_url, params: { bot: { name: "Blocked Bot" } }
+  end
+  assert_response :forbidden
+
+  # Existing bots can still be edited and deleted
+  patch bot_url(bot3), params: { bot: { name: "Bot Three Renamed" } }
+  assert_redirected_to bots_url
+  assert_equal "Bot Three Renamed", bot3.reload.name
+
+  delete bot_url(bot3)
+  assert_redirected_to bots_url
+  assert bot3.reload.deactivated?
+end
+
+test "administrators are not limited by bots_per_member" do
+  accounts(:signal).update!(settings: { bots_per_member: 0 })
+  User.create!(name: "Admin Bot", role: :bot, creator: @david)
+
+  sign_in :david
+  get bots_url
+  assert_response :ok
+  assert_select "a[href=\x27#{new_bot_path}\x27]", text: /Add a chat bot/
+  assert_no_match "reached the limit", response.body
+
+  get new_bot_url
+  assert_response :ok
+
+  assert_difference -> { User.bot.count }, 1 do
+    post bots_url, params: { bot: { name: "Another Admin Bot" } }
+  end
+  assert_redirected_to bots_url
+end
 end
