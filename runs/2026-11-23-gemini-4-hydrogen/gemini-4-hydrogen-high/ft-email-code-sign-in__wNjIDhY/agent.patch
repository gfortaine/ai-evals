+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <p class="margin-none-block-start">
+    Then enter the verification code we sent to
+    <strong><%= email_address_pending_authentication %></strong>:
+  </p>
+
+  <%= form_with url: session_magic_link_path, method: :post, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <div class="flex align-center justify-center gap">
+      <%= form.text_field :code, required: true, class: "input center", autofocus: true, autocomplete: "one-time-code", autocorrect: "off", autocapitalize: "characters", spellcheck: false, placeholder: "••••••" %>
+    </div>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small txt-subtle">The code will expire in <%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>.</p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
