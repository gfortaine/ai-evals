+require "test_helper"
+
+class MagicLinkMailerTest < ActionMailer::TestCase
+  test "sign_in_instructions for sign in" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_includes email.subject, magic_link.code
+    assert_match magic_link.code, email.html_part.body.encoded
+    assert_match magic_link.code, email.text_part.body.encoded
+    assert_match /15 minutes/, email.text_part.body.encoded
+    assert_match /sign-in/, email.text_part.body.encoded
+  end
+
+  test "sign_in_instructions for sign up" do
+    magic_link = MagicLink.create!(identity: identities(:kevin), purpose: :sign_up)
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_includes email.subject, magic_link.code
+    assert_match /sign-up/, email.text_part.body.encoded
+  end
+end
