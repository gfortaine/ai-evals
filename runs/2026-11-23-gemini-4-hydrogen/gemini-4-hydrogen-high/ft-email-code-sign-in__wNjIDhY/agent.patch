new file mode 100644
index 0000000..09782fe
--- /dev/null
+++ b/app/controllers/concerns/magic_link_auth.rb
@@ -0,0 +1,46 @@
+module MagicLinkAuth
+  extend ActiveSupport::Concern
+
+  included do
+    helper_method :email_address_pending_authentication
+  end
+
+  private
+    def redirect_to_session_magic_link(magic_link = nil, email_address: magic_link&.identity&.email_address)
+      set_pending_authentication_token(email_address)
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path(script_name: nil) }
+        format.json { render json: { pending_authentication_token: pending_authentication_token_for(email_address) }, status: :created }
+      end
+    end
+
+    def set_pending_authentication_token(email_address)
+      cookies[:pending_authentication_token] = {
+        value: pending_authentication_token_for(email_address),
+        httponly: true,
+        same_site: :lax,
+        expires: MagicLink::EXPIRATION_TIME.from_now
+      }
+    end
+
+    def clear_pending_authentication_token
+      cookies.delete(:pending_authentication_token)
+    end
+
+    def email_address_pending_authentication
+      @email_address_pending_authentication ||= begin
+        if token = cookies[:pending_authentication_token]
+          pending_authentication_token_verifier.verified(token)
+        end
+      end
+    end
+
+    def pending_authentication_token_for(email_address)
+      pending_authentication_token_verifier.generate(email_address, expires_in: MagicLink::EXPIRATION_TIME)
+    end
+
+    def pending_authentication_token_verifier
+      Rails.application.message_verifier(:pending_authentication)
+    end
+end
