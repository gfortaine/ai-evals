diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..19e435d
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "creates a 6-character code and 15-minute expiration" do
+    magic_link = MagicLink.create!(identity: @identity)
+
+    assert_equal 6, magic_link.code.length
+    assert_match(/\A[0-9A-Z]{6}\z/, magic_link.code)
+    assert_in_delta 15.minutes.from_now, magic_link.expires_at, 2.seconds
+    assert magic_link.for_sign_in?
+  end
+
+  test "active and stale scopes" do
+    magic_link = MagicLink.create!(identity: @identity)
+
+    assert_includes MagicLink.active, magic_link
+    assert_not_includes MagicLink.stale, magic_link
+
+    travel MagicLink::EXPIRATION_TIME - 1.second
+    assert_includes MagicLink.active, magic_link
+    assert_not_includes MagicLink.stale, magic_link
+
+    travel 2.seconds
+    assert_not_includes MagicLink.active, magic_link
+    assert_includes MagicLink.stale, magic_link
+  end
+
+  test "consume finds and destroys active magic link" do
+    magic_link = MagicLink.create!(identity: @identity)
+
+    consumed = MagicLink.consume(magic_link.code)
+    assert_equal magic_link, consumed
+    assert_not MagicLink.exists?(magic_link.id)
+
+    assert_nil MagicLink.consume(magic_link.code)
+  end
+
+  test "consume sanitizes code" do
+    magic_link = MagicLink.create!(identity: @identity, code: "AB12CD")
+
+    consumed = MagicLink.consume("  ab-12 cd ")
+    assert_equal magic_link, consumed
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume returns nil for expired magic link" do
+    magic_link = MagicLink.create!(identity: @identity)
+
+    travel MagicLink::EXPIRATION_TIME + 1.second
+    assert_nil MagicLink.consume(magic_link.code)
+    assert MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume returns nil for blank or unknown code" do
+    assert_nil MagicLink.consume(nil)
+    assert_nil MagicLink.consume("")
+    assert_nil MagicLink.consume("NOPE99")
+  end
+
+  test "cleanup removes stale magic links only" do
+    stale_link = MagicLink.create!(identity: @identity, expires_at: 1.minute.ago)
+    active_link = MagicLink.create!(identity: @identity)
+
+    MagicLink.cleanup
+
+    assert_not MagicLink.exists?(stale_link.id)
+    assert MagicLink.exists?(active_link.id)
+  end
+end
