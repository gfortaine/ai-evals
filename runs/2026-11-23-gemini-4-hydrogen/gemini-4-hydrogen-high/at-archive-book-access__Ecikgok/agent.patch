diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..f1b9a19 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,33 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy removes the book and archives current accesses" do
+    book = books(:handbook)
+
+    patch book_path(book), params: {
+      book: { everyone_access: false },
+      "editor_ids[]": users(:david).id,
+      "reader_ids[]": users(:jz).id
+    }
+    assert_redirected_to book_slug_path(book)
+    assert_equal 0, AccessArchive.count
+
+    assert_difference -> { Book.count }, -1 do
+      assert_difference -> { Access.count }, -3 do
+        assert_difference -> { AccessArchive.count }, +3 do
+          delete book_path(book)
+        end
+      end
+    end
+
+    assert_redirected_to root_path
+
+    archives = AccessArchive.where(book_id: book.id).index_by(&:user_id)
+    assert_equal [ users(:david).id, users(:jz).id, users(:kevin).id ].sort, archives.keys.sort
+    assert_equal "editor", archives[users(:kevin).id].level
+    assert_equal "editor", archives[users(:david).id].level
+    assert_equal "reader", archives[users(:jz).id].level
+    assert_nil archives[users(:jason).id]
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..428daab 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,79 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroying a book archives accesses as they stood at deletion" do
+    book = books(:handbook)
+    book.update!(everyone_access: false)
+    assert_equal 0, AccessArchive.count
+
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+    assert_equal 0, AccessArchive.count
+
+    assert_difference -> { Book.count }, -1 do
+      assert_difference -> { Access.count }, -2 do
+        assert_difference -> { AccessArchive.count }, +2 do
+          book.destroy!
+        end
+      end
+    end
+
+    archives = AccessArchive.where(book_id: book.id).index_by(&:user_id)
+    assert_equal 2, archives.size
+    assert_equal({ book_title: "Handbook", user_name: "Kevin", level: "editor" },
+                 archives[users(:kevin).id].slice(:book_title, :user_name, :level).symbolize_keys)
+    assert_equal({ book_title: "Handbook", user_name: "JZ", level: "reader" },
+                 archives[users(:jz).id].slice(:book_title, :user_name, :level).symbolize_keys)
+  end
+
+  test "destroying a book with loaded accesses reflects subsequent access updates and revocations" do
+    book = books(:manual)
+    book.update!(everyone_access: false)
+    book.accesses.load
+
+    book.update_access(editors: [ users(:jz).id ], readers: [ users(:kevin).id ])
+    assert_equal 0, AccessArchive.count
+
+    book.destroy!
+
+    archives = AccessArchive.where(book_id: book.id).index_by(&:user_id)
+    assert_equal [ users(:jz).id, users(:kevin).id ].sort, archives.keys.sort
+    assert_equal "editor", archives[users(:jz).id].level
+    assert_equal "reader", archives[users(:kevin).id].level
+    assert_nil archives[users(:david).id]
+    assert_nil archives[users(:jason).id]
+  end
+
+  test "destroying or deleting a book with no accesses writes no archive rows" do
+    book_without_access = Book.create!(title: "Lonely Book", everyone_access: false)
+    another_book_without_access = Book.create!(title: "Another Lonely Book", everyone_access: true)
+
+    assert_no_difference -> { AccessArchive.count } do
+      book_without_access.destroy!
+      another_book_without_access.delete
+    end
+
+    assert_not Book.exists?(book_without_access.id)
+    assert_not Book.exists?(another_book_without_access.id)
+  end
+
+  test "aborting book destruction writes no archive rows" do
+    book = books(:handbook)
+
+    Book.set_callback :destroy, :before, :abort_for_test
+    Book.define_method(:abort_for_test) { throw :abort }
+
+    begin
+      assert_no_difference -> { AccessArchive.count } do
+        assert_no_difference -> { Book.count } do
+          assert_no_difference -> { Access.count } do
+            assert_not book.destroy
+          end
+        end
+      end
+    ensure
+      Book.skip_callback :destroy, :before, :abort_for_test
+      Book.remove_method :abort_for_test
+    end
+  end
 end
