index 0000000..7e43a2b
--- /dev/null
+++ b/test/integration/with_raised_exceptions_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class WithRaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "raises exceptions inside the block and renders error pages outside" do
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "restores normal error rendering when an exception escapes the block" do
+    assert_raises RuntimeError do
+      with_raised_exceptions do
+        assert_raises ActiveRecord::RecordNotFound do
+          get book_slug_path(books(:manual))
+        end
+
+        raise "boom"
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "supports nested blocks" do
+    with_raised_exceptions do
+      with_raised_exceptions do
+        assert_raises ActiveRecord::RecordNotFound do
+          get book_slug_path(books(:manual))
+        end
+      end
+
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+end
