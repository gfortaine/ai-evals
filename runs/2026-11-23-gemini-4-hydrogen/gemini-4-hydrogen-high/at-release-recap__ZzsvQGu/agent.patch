index 0000000..001fe08
--- /dev/null
+++ b/test/controllers/books/releases_controller_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    @book = books(:manual)
+    sign_in :david
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "edit renders release form" do
+    get edit_book_release_path(@book)
+    assert_response :success
+  end
+
+  test "releasing a book shows the new published title in Recently updated on the library page" do
+    patch book_release_path(@book), params: { book: { title: "Official Manual", subtitle: "v1.0" } }
+
+    assert_redirected_to root_path
+    follow_redirect!
+
+    assert_response :success
+    assert_in_body "Recently updated"
+    assert_select ".library__recents strong", text: "Official Manual"
+    assert_select ".library__recents strong", text: "Manual", count: 0
+    assert_select ".library__recents span", text: "Published"
+  end
+
+  test "releasing an already published book redirects to the book" do
+    @book.update!(published: true)
+
+    patch book_release_path(@book), params: { book: { title: "Should Not Change" } }
+
+    assert_redirected_to book_slug_path(@book)
+    assert_equal "Manual", @book.reload.title
+  end
+end
diff --git a/test/models/book/recap_test.rb b/test/models/book/recap_test.rb
new file mode 100644
index 0000000..9ca2e06
--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "updating a book writes its recap to the cache" do
+    book = books(:manual)
+    book.update!(title: "Updated Manual", published: true)
+
+    assert_equal({ title: "Updated Manual", published: true }, book.cached_recap)
+  end
+
+  test "recaps are stored per book so saving one never overwrites another" do
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    handbook.update!(title: "Handbook Revised")
+    manual.update!(title: "Manual Revised", published: true)
+
+    assert_equal({ title: "Handbook Revised", published: false }, handbook.cached_recap)
+    assert_equal({ title: "Manual Revised", published: true }, manual.cached_recap)
+  end
+
+  test "recaps expire on the configured schedule" do
+    book = books(:manual)
+    book.update!(title: "Expiring Manual")
+
+    assert_not_nil book.cached_recap
+
+    travel Rails.application.config.x.recap.expires_in - 1.minute do
+      assert_not_nil book.cached_recap
+    end
+
+    travel Rails.application.config.x.recap.expires_in + 1.second do
+      assert_nil book.cached_recap
+    end
+  end
+
+  test "updating separate instances of the same book in a transaction writes committed values" do
+    book = books(:manual)
+    stale_copy = Book.find(book.id)
+
+    Book.transaction do
+      book.update!(title: "Committed Title")
+      stale_copy.update!(published: true)
+    end
+
+    assert_equal({ title: "Committed Title", published: true }, book.cached_recap)
+  end
+end
diff --git a/test/models/book/release_test.rb b/test/models/book/release_test.rb
new file mode 100644
index 0000000..875d555
--- /dev/null
+++ b/test/models/book/release_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Book::ReleaseTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "finalize_release publishes a draft book with new title and caches the new recap" do
+    book = books(:manual)
+
+    assert Book.finalize_release(book.id, title: "Published Manual", subtitle: "First Edition")
+
+    book.reload
+    assert_equal "Published Manual", book.title
+    assert_equal "First Edition", book.subtitle
+    assert book.published?
+    assert_equal({ title: "Published Manual", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release preserves existing subtitle when subtitle is nil" do
+    book = books(:manual)
+    book.update!(subtitle: "Original Subtitle")
+
+    assert Book.finalize_release(book.id, title: "Published Manual")
+
+    assert_equal "Original Subtitle", book.reload.subtitle
+  end
+
+  test "finalize_release returns false when book is already published" do
+    book = books(:manual)
+    book.update!(title: "Already Out", published: true)
+
+    assert_not Book.finalize_release(book.id, title: "Ignored Title")
+
+    assert_equal "Already Out", book.reload.title
+    assert_equal({ title: "Already Out", published: true }, book.cached_recap)
+  end
+end
