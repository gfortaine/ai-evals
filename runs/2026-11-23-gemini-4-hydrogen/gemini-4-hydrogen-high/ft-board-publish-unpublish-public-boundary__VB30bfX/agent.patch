+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.publish
+  end
+
+  test "show published card of a published board without authentication" do
+    card = cards(:logo)
+
+    get public_board_card_path(@publication.key, card)
+
+    assert_response :success
+    assert_select "h1", text: card.title
+    assert_in_body comments(:logo_agreement_kevin).body.to_plain_text
+  end
+
+  test "show closed card of a published board" do
+    card = cards(:layout)
+    card.close(user: users(:kevin))
+    assert card.closed?
+
+    get public_board_card_path(@publication.key, card)
+
+    assert_response :success
+    assert_select "h1", text: card.title
+    assert_in_body "Done"
+  end
+
+  test "show postponed card of a published board" do
+    card = cards(:layout)
+    card.postpone(user: users(:kevin))
+    assert card.postponed?
+
+    get public_board_card_path(@publication.key, card)
+
+    assert_response :success
+    assert_select "h1", text: card.title
+    assert_in_body "Not Now"
+  end
+
+  test "show card with steps and reactions" do
+    card = cards(:logo)
+    card.steps.create!(content: "Public step", completed: true)
+    Current.set(user: users(:kevin)) do
+      card.reactions.create!(content: "🎉", reacter: users(:kevin))
+    end
+
+    get public_board_card_path(@publication.key, card)
+
+    assert_response :success
+    assert_select "h1", text: card.title
+    assert_in_body "Public step"
+    assert_in_body "🎉"
+  end
+
+  test "show returns not found for drafted card" do
+    drafted_card = @board.cards.create!(creator: users(:david), title: "Secret Draft", status: "drafted")
+
+    get public_board_card_path(@publication.key, drafted_card)
+
+    assert_response :not_found
+  end
+
+  test "show returns not found for card from another board" do
+    other_card = Current.set(user: users(:kevin)) do
+      boards(:private).cards.create!(creator: users(:kevin), title: "Private Card", status: "published")
+    end
+
+    get public_board_card_path(@publication.key, other_card)
+
+    assert_response :not_found
+  end
+
+  test "show returns not found when board is unpublished" do
+    key = @publication.key
+    @board.unpublish
+
+    get public_board_card_path(key, cards(:layout))
+
+    assert_response :not_found
+  end
+
+  test "show returns not found for invalid key" do
+    get public_board_card_path("invalid-key", cards(:layout))
+
+    assert_response :not_found
+  end
+end
