new file mode 100644
index 0000000..e19f04a
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "create publishes board" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+  end
+
+  test "create as turbo_stream" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      post board_publication_path(@board), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@board, :publication)
+    assert @board.reload.published?
+  end
+
+  test "create as JSON" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    assert @board.reload.published?
+    assert_equal public_board_url(@board.publication.key, script_name: @board.account.slug), @response.parsed_body["public_url"]
+  end
+
+  test "destroy unpublishes board" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "destroy as turbo_stream" do
+    @board.publish
+
