diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..619ddde
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "boards are not published by default" do
+    board = boards(:writebook)
+
+    assert_not board.published?
+    assert_nil board.publication
+  end
+
+  test "publish creates a publication with a key and touches board" do
+    board = boards(:writebook)
+    original_updated_at = board.updated_at
+
+    travel 1.minute do
+      publication = board.publish
+
+      assert board.published?
+      assert_equal publication, board.publication
+      assert publication.key.present?
+      assert_operator board.updated_at, :>, original_updated_at
+    end
+  end
+
+  test "publish is idempotent" do
+    board = boards(:writebook)
+    first_publication = board.publish
+
+    assert_no_difference -> { Board::Publication.count } do
+      assert_equal first_publication, board.publish
+    end
+  end
+
+  test "unpublish destroys the publication and clears published state" do
+    board = boards(:writebook)
+    board.publish
+    assert board.published?
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      board.unpublish
+    end
+
+    assert_not board.published?
+    assert_nil board.publication
+  end
+
+  test "unpublish is a no-op when board is not published" do
+    board = boards(:writebook)
+
+    assert_no_difference -> { Board::Publication.count } do
+      board.unpublish
+    end
+
+    assert_not board.published?
+  end
+
+  test "published scope returns only published boards" do
+    writebook = boards(:writebook)
+    writebook.publish
+
+    assert_includes Board.published, writebook
+    assert_not_includes Board.published, boards(:private)
+  end
+
+  test "destroying a published board destroys its publication" do
+    board = boards(:writebook)
+    publication = board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      board.destroy!
+    end
+
+    assert_not Board::Publication.exists?(publication.id)
+  end
+end
