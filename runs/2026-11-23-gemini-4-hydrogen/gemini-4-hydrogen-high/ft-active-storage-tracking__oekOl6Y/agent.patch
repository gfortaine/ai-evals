--- /dev/null
+++ b/app/models/concerns/storage/trackable.rb
@@ -0,0 +1,18 @@
+module Storage::Trackable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :storage_total, as: :owner, class_name: "Storage::Total", dependent: :delete
+    has_many :storage_deltas, as: :owner, class_name: "Storage::Delta", dependent: :delete_all
+  end
+
+  def bytes_used
+    if new_record?
+      0
+    else
+      total = Storage::Total.where(owner: self).pick(:bytes_used) || 0
+      pending = Storage::Delta.where(owner: self).sum(:delta)
+      total + pending
+    end
+  end
+end
