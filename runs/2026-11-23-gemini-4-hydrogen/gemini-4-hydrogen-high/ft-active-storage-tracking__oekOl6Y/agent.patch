@@ -0,0 +1,25 @@
+module Storage::Tracked
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :remove_storage_later, unless: -> { destroyed_by_association.present? }
+  end
+
+  def sync_storage_later
+    Storage::SyncRecordJob.perform_later(self)
+  end
+
+  def sync_storage_now
+    Storage::Entry.sync(self)
+  end
+
+  private
+    def remove_storage_later
+      Storage::RemoveRecordJob.perform_later(record_type: self.class.name, record_id: id, account_id: account_id)
+    end
+
+  # Models must implement:
+  # - storage_bytes_used: integer byte count of counted attachments on this record
+  # - storage_board_id: board UUID for this record
+  # - storage_card_id: card UUID (or nil for Board)
+end
