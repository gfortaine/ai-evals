diff --git a/app/models/account/storage.rb b/app/models/account/storage.rb
new file mode 100644
index 0000000..c071c10
--- /dev/null
+++ b/app/models/account/storage.rb
@@ -0,0 +1,51 @@
+module Account::Storage
+  extend ActiveSupport::Concern
+  include ::Storage::Trackable
+
+  included do
+    after_destroy :delete_storage_records
+  end
+
+  def reconcile_storage_later
+    ::Storage::ReconcileAccountJob.perform_later(self)
+  end
+
+  def reconcile_storage_now
+    sync_attached_storage_entries
+    remove_orphaned_storage_entries
+    ::Storage::Total.materialize(self)
+    boards.find_each { |board| ::Storage::Total.materialize(board) }
+  end
+
+  private
+    def sync_attached_storage_entries
+      card_image_ids = ActiveStorage::Attachment.where(account_id: id, record_type: "Card", name: "image").distinct.pluck(:record_id)
+      cards.where(id: card_image_ids).find_each(&:sync_storage_now)
+
+      rich_text_records = ActionText::RichText.joins(:embeds_attachments)
+        .where(account_id: id, record_type: %w[ Board Card Comment ])
+        .distinct
+        .pluck(:record_type, :record_id)
+
+      rich_text_records.group_by(&:first).each do |record_type, pairs|
+        ids = pairs.map(&:last)
+        record_type.constantize.where(id: ids).find_each(&:sync_storage_now)
+      end
+    end
+
+    def remove_orphaned_storage_entries
+      ::Storage::Entry.where(account_id: id).find_each do |entry|
+        if entry.record.nil?
+          ::Storage::Entry.remove_record(record_type: entry.record_type, record_id: entry.record_id, account_id: id)
+        elsif entry.bytes_used != entry.record.storage_bytes_used || entry.board_id != entry.record.storage_board_id
+          entry.record.sync_storage_now
+        end
+      end
+    end
+
+    def delete_storage_records
+      ::Storage::Entry.where(account_id: id).delete_all
+      ::Storage::Delta.where(account_id: id).delete_all
+      ::Storage::Total.where(account_id: id).delete_all
+    end
+end
