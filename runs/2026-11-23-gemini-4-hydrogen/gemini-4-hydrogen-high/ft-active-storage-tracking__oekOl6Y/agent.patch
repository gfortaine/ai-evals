@@ -0,0 +1,62 @@
+module Card::Storage
+  extend ActiveSupport::Concern
+  include ::Storage::Tracked
+
+  included do
+    after_update :remember_board_change_for_storage, if: :saved_change_to_board_id?
+    after_update_commit :move_storage_later, if: :board_changed_for_storage?
+    after_rollback :clear_board_change_for_storage
+  end
+
+  def move_storage_later
+    clear_board_change_for_storage
+    ::Storage::MoveCardJob.perform_later(self)
+  end
+
+  def move_storage_now
+    ::Storage::Entry.move_card(self)
+  end
+
+  def storage_bytes_used
+    image_bytes + description_bytes
+  end
+
+  def storage_board_id
+    board_id
+  end
+
+  def storage_card_id
+    id
+  end
+
+  private
+    def remember_board_change_for_storage
+      @board_changed_for_storage = true
+    end
+
+    def board_changed_for_storage?
+      @board_changed_for_storage
+    end
+
+    def clear_board_change_for_storage
+      @board_changed_for_storage = false
+    end
+
+    def image_bytes
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "Card", record_id: id, name: "image")
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def description_bytes
+      ActionText::RichText
+        .joins(embeds_attachments: :blob)
+        .where(record_type: "Card", record_id: id, name: "description")
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def remove_storage_later
+      ::Storage::RemoveCardJob.perform_later(card_id: id, account_id: account_id)
+    end
+end
