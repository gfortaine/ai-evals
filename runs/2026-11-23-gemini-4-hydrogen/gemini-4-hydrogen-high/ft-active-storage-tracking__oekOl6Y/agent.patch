diff --git a/test/models/storage_tracking_test.rb b/test/models/storage_tracking_test.rb
new file mode 100644
index 0000000..d79f2a5
--- /dev/null
+++ b/test/models/storage_tracking_test.rb
@@ -0,0 +1,489 @@
+require "test_helper"
+
+class StorageTrackingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @other_account = accounts(:initech)
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @user = users(:david)
+    Current.session = sessions(:david)
+  end
+
+  test "bytes_used defaults to 0 for accounts and boards with no attachments" do
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, Account.new.bytes_used
+    assert_equal 0, Board.new.bytes_used
+  end
+
+  test "bytes_used is calculated in the background" do
+    blob = create_blob("card image data")
+    card = @board.cards.create!(title: "Image card", creator: @user, status: "published")
+
+    card.image.attach(blob)
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+  end
+
+  test "counts card images and embeds in board descriptions, card descriptions, and comments" do
+    board_blob = create_blob("board description file")
+    card_image_blob = create_blob("card cover image")
+    card_desc_blob = create_blob("card description attachment")
+    comment_blob_1 = create_blob("first comment attachment")
+    comment_blob_2 = create_blob("second comment attachment")
+    other_board_blob = create_blob("private board attachment")
+
+    perform_enqueued_jobs do
+      @board.update!(public_description: embed_html(board_blob))
+
+      card = @board.cards.create!(
+        title: "Full card",
+        creator: @user,
+        status: "published",
+        image: card_image_blob,
+        description: embed_html(card_desc_blob)
+      )
+
+      card.comments.create!(creator: @user, body: embed_html(comment_blob_1, comment_blob_2))
+
+      other_card = @other_board.cards.create!(
+        title: "Private card",
+        creator: @user,
+        status: "published",
+        image: other_board_blob
+      )
+      assert other_card.persisted?
+    end
+
+    expected_writebook = board_blob.byte_size + card_image_blob.byte_size + card_desc_blob.byte_size +
+      comment_blob_1.byte_size + comment_blob_2.byte_size
+    expected_private = other_board_blob.byte_size
+
+    assert_equal expected_writebook, @board.bytes_used
+    assert_equal expected_private, @other_board.bytes_used
+    assert_equal expected_writebook + expected_private, @account.bytes_used
+    assert_equal 0, @other_account.bytes_used
+  end
+
+  test "excludes avatars, exports, imports, variants, and remote media" do
+    image_blob = create_image_blob("moon.jpg", "image/jpeg")
+
+      # User avatar (excluded)
+      @user.avatar.attach(io: File.open(file_fixture("avatar.png")), filename: "avatar.png", content_type: "image/png")
+
+      # Export file (excluded)
+      export = Export.create!(account: @account, user: @user)
+      export.file.attach(io: StringIO.new("export zip data"), filename: "export.zip", content_type: "application/zip")
+
+      # Import file (excluded)
+      import = Account::Import.create!(account: @account, identity: @user.identity)
+      import.file.attach(io: StringIO.new("import zip data"), filename: "import.zip", content_type: "application/zip")
+
+      # Card with remote media only (excluded)
+      @board.cards.create!(
+        title: "Remote media",
+        creator: @user,
+        status: "published",
+        description: '<action-text-attachment url="https://example.com/video.mp4" content-type="video/mp4"></action-text-attachment>'
+      )
+
+      # Card with embedded image (only original blob counted, NOT variants!)
+      card = @board.cards.create!(title: "Embedded image", creator: @user, status: "published")
+      card.update!(description: embed_html(image_blob))
+
+      # Confirm variants actually exist in ActiveStorage
+      embed = card.rich_text_description.embeds.sole
+      assert embed.variant(:small).processed?
+    assert embed.variant(:large).processed?
+    perform_enqueued_jobs
+
+    assert_equal image_blob.byte_size, @board.bytes_used
+    assert_equal image_blob.byte_size, @account.bytes_used
+  end
+
+  test "updates bytes_used when card image is replaced, purged, detached, or cleared" do
+    blob1 = create_blob("first image")
+    blob2 = create_blob("second much larger image payload")
+    card = nil
+
+    perform_enqueued_jobs do
+      card = @board.cards.create!(title: "Card", creator: @user, status: "published", image: blob1)
+    end
+    assert_equal blob1.byte_size, @board.bytes_used
+    assert_equal blob1.byte_size, @account.bytes_used
+
+    # Replace image
+    perform_enqueued_jobs do
+      card.image.attach(blob2)
+    end
+    assert_equal blob2.byte_size, @board.bytes_used
+    assert_equal blob2.byte_size, @account.bytes_used
+
+    # Purge later
+    perform_enqueued_jobs do
+      card.image.purge_later
+    end
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    # Re-attach and purge synchronously
+    blob1b = create_blob("first image again")
+    perform_enqueued_jobs do
+      card.image.attach(blob1b)
+    end
+    assert_equal blob1b.byte_size, @board.bytes_used
+
+    perform_enqueued_jobs do
+      card.image.purge
+    end
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    # Re-attach and detach
+    blob3 = create_blob("third image")
+    perform_enqueued_jobs do
+      card.image.attach(blob3)
+    end
+    assert_equal blob3.byte_size, @board.bytes_used
+
+    perform_enqueued_jobs do
+      card.image.detach
+    end
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    # Re-attach and clear via update!(image: nil)
+    blob4 = create_blob("fourth image")
+    perform_enqueued_jobs do
+      card.image.attach(blob4)
+    end
+    assert_equal blob4.byte_size, @board.bytes_used
+
+    perform_enqueued_jobs do
+      card.update!(image: nil)
+    end
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "updates bytes_used when rich text embeds are edited or detached" do
+    blob1 = create_blob("embed one")
+    blob2 = create_blob("embed two is longer")
+    card = @board.cards.create!(title: "Rich text card", creator: @user, status: "published")
+
+    perform_enqueued_jobs do
+      card.update!(description: embed_html(blob1, blob2))
+    end
+    assert_equal blob1.byte_size + blob2.byte_size, @board.bytes_used
+
+    # Remove one embed
+    perform_enqueued_jobs do
+      card.update!(description: embed_html(blob2))
+    end
+    assert_equal blob2.byte_size, @board.bytes_used
+
+    # Detach remaining embeds via embeds.detach
+    perform_enqueued_jobs do
+      card.rich_text_description.embeds.detach
+    end
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "updates bytes_used when card moves to another board" do
+    image_blob = create_blob("card image")
+    desc_blob = create_blob("card desc")
+    comment_blob = create_blob("comment file")
+    board_blob = create_blob("board desc")
+
+    card = nil
+    perform_enqueued_jobs do
+      @board.update!(public_description: embed_html(board_blob))
+      card = @board.cards.create!(
+        title: "Movable card",
+        creator: @user,
+        status: "published",
+        image: image_blob,
+        description: embed_html(desc_blob)
+      )
+      card.comments.create!(creator: @user, body: embed_html(comment_blob))
+    end
+
+    card_total = image_blob.byte_size + desc_blob.byte_size + comment_blob.byte_size
+    assert_equal board_blob.byte_size + card_total, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal board_blob.byte_size + card_total, @account.bytes_used
+
+    perform_enqueued_jobs do
+      card.move_to(@other_board)
+    end
+
+    assert_equal board_blob.byte_size, @board.bytes_used
+    assert_equal card_total, @other_board.bytes_used
+    assert_equal board_blob.byte_size + card_total, @account.bytes_used
+  end
+
+  test "updates bytes_used when comment, card, or board is destroyed" do
+    board_blob = create_blob("board file")
+    image_blob = create_blob("card image")
+    desc_blob = create_blob("card desc")
+    comment_blob_1 = create_blob("comment 1")
+    comment_blob_2 = create_blob("comment 2")
+
+    card = nil
+    comment1 = nil
+
+    perform_enqueued_jobs do
+      @board.update!(public_description: embed_html(board_blob))
+      card = @board.cards.create!(
+        title: "Destroyable card",
+        creator: @user,
+        status: "published",
+        image: image_blob,
+        description: embed_html(desc_blob)
+      )
+      comment1 = card.comments.create!(creator: @user, body: embed_html(comment_blob_1))
+      card.comments.create!(creator: @user, body: embed_html(comment_blob_2))
+    end
+
+    total = board_blob.byte_size + image_blob.byte_size + desc_blob.byte_size + comment_blob_1.byte_size + comment_blob_2.byte_size
+    assert_equal total, @board.bytes_used
+    assert_equal total, @account.bytes_used
+
+    # Destroy single comment
+    perform_enqueued_jobs do
+      comment1.destroy!
+    end
+    expected_after_comment = total - comment_blob_1.byte_size
+    assert_equal expected_after_comment, @board.bytes_used
+    assert_equal expected_after_comment, @account.bytes_used
+
+    # Destroy card (with image, description, and remaining comment)
+    perform_enqueued_jobs do
+      card.destroy!
+    end
+    assert_equal board_blob.byte_size, @board.bytes_used
+    assert_equal board_blob.byte_size, @account.bytes_used
+
+    # Destroy board
+    perform_enqueued_jobs do
+      @board.destroy!
+    end
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, Storage::Entry.where(board_id: @board.id).count
+  end
+
+  test "destroying account cleans up all storage tracking records" do
+    blob = create_blob("account file")
+
+    perform_enqueued_jobs do
+      @board.cards.create!(title: "Card", creator: @user, status: "published", image: blob)
+    end
+
+    assert Storage::Entry.where(account_id: @account.id).exists?
+    assert Storage::Total.where(account_id: @account.id).exists?
+
+    perform_enqueued_jobs do
+      @account.destroy!
+    end
+
+    assert_not Storage::Entry.where(account_id: @account.id).exists?
+    assert_not Storage::Total.where(account_id: @account.id).exists?
+    assert_not Storage::Delta.where(account_id: @account.id).exists?
+  end
+
+  test "operations are idempotent when jobs run multiple times" do
+    blob = create_blob("idempotent file")
+    card = @board.cards.create!(title: "Card", creator: @user, status: "published", image: blob)
+
+    # Run sync multiple times
+    3.times { card.sync_storage_now }
+    Storage::Total.materialize(@board)
+    Storage::Total.materialize(@account)
+    Storage::Total.materialize(@board)
+    Storage::Total.materialize(@account)
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+
+    # Move card and run move multiple times
+    card.update!(board: @other_board)
+    3.times { card.move_storage_now }
+    Storage::Total.materialize(@board)
+    Storage::Total.materialize(@other_board)
+
+    assert_equal 0, @board.bytes_used
+    assert_equal blob.byte_size, @other_board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+
+    # Destroy card and run remove multiple times
+    card_id = card.id
+    card.destroy!
+    3.times { Storage::Entry.remove_card(card_id: card_id, account_id: @account.id) }
+    Storage::Total.materialize(@other_board)
+    Storage::Total.materialize(@account)
+
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "creating and destroying card before sync job runs results in zero usage" do
+    blob = create_blob("ephemeral file")
+
+    perform_enqueued_jobs do
+      card = @board.cards.create!(title: "Ephemeral", creator: @user, status: "published", image: blob)
+      card.destroy!
+    end
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "works when perform_enqueued_jobs runs a single batch without a block" do
+    blob = create_blob("single flush file")
+    @board.cards.create!(title: "Card", creator: @user, status: "published", image: blob)
+
+    assert_equal 0, @board.bytes_used
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+
+    # MaterializeAllJob compacts remaining deltas
+    Storage::MaterializeAllJob.perform_now
+    assert_equal 0, Storage::Delta.where(owner: [ @board, @account ]).count
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+  end
+
+  test "reconciles storage after account export and import" do
+    board_blob = create_blob("board export file")
+    card_blob = create_blob("card export file")
+    comment_blob = create_blob("comment export file")
+
+    perform_enqueued_jobs do
+      @board.update!(public_description: embed_html(board_blob))
+      card = @board.cards.create!(title: "Exported card", creator: @user, status: "published", image: card_blob)
+      card.comments.create!(creator: @user, body: embed_html(comment_blob))
+    end
+
+    expected_total = board_blob.byte_size + card_blob.byte_size + comment_blob.byte_size
+    assert_equal expected_total, @account.bytes_used
+
+    export = Account::Export.create!(account: @account, user: @user)
+    export.build
+
+    export_tempfile = Tempfile.new([ "export", ".zip" ])
+    export.file.open { |f| FileUtils.cp(f.path, export_tempfile.path) }
+
+    ActiveStorage::Attachment.where(account: @account).delete_all
+    ActiveStorage::Blob.where(account: @account).delete_all
+    @account.destroy!
+
+    target_account = Account.create_with_owner(account: { name: "Imported" }, owner: { identity: @user.identity, name: @user.name })
+    import = Account::Import.create!(identity: @user.identity, account: target_account)
+    Current.set(account: target_account) do
+      import.file.attach(io: File.open(export_tempfile.path), filename: "export.zip", content_type: "application/zip")
+    end
+
+    import.check
+    import.process
+
+    assert_equal expected_total, target_account.bytes_used
+    imported_board = target_account.boards.find_by!(name: @board.name)
+    assert_equal expected_total, imported_board.bytes_used
+  ensure
+    export_tempfile&.close
+    export_tempfile&.unlink
+  end
+
+  test "moving card off a board that is immediately destroyed preserves usage on destination board" do
+    board_blob = create_blob("board blob")
+    card_blob = create_blob("card blob")
+    comment_blob = create_blob("comment blob")
+
+    card = nil
+    perform_enqueued_jobs do
+      @board.update!(public_description: embed_html(board_blob))
+      card = @board.cards.create!(title: "Saved card", creator: @user, status: "published", image: card_blob)
+      card.comments.create!(creator: @user, body: embed_html(comment_blob))
+    end
+
+    # Move card and destroy old board before MoveCardJob runs; run RemoveBoardJob first
+    card.move_to(@other_board)
+    old_board_id = @board.id
+    @board.destroy!
+
+    Storage::RemoveBoardJob.perform_now(board_id: old_board_id, account_id: @account.id)
+    perform_enqueued_jobs
+
+    expected_card_total = card_blob.byte_size + comment_blob.byte_size
+    assert_equal expected_card_total, @other_board.bytes_used
+    assert_equal expected_card_total, @account.bytes_used
+  end
+
+  test "direct rich_text destruction updates bytes_used" do
+    blob = create_blob("rich text body")
+    card = nil
+
+    perform_enqueued_jobs do
+      card = @board.cards.create!(title: "RT card", creator: @user, status: "published", description: embed_html(blob))
+    end
+    assert_equal blob.byte_size, @board.bytes_used
+
+    perform_enqueued_jobs do
+      card.rich_text_description.destroy!
+    end
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "burst of multiple attachment changes coalesces deltas accurately" do
+    blobs = 10.times.map { |i| create_blob("attachment payload #{i} " * (i + 1)) }
+
+    perform_enqueued_jobs do
+      blobs.each_with_index do |blob, idx|
+        card = @board.cards.create!(title: "Burst #{idx}", creator: @user, status: "published", image: blob)
+        card.comments.create!(creator: @user, body: embed_html(blob))
+      end
+    end
+
+    expected = blobs.sum(&:byte_size) * 2
+    assert_equal expected, @board.bytes_used
+    assert_equal expected, @account.bytes_used
+    assert_equal 0, Storage::Delta.where(owner: [ @board, @account ]).count
+    assert_equal expected, Storage::Total.find_by!(owner: @board).bytes_used
+    assert_equal expected, Storage::Total.find_by!(owner: @account).bytes_used
+  end
+
+  private
+    def create_blob(content)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(content),
+        filename: "file_#{SecureRandom.hex(4)}.txt",
+        content_type: "text/plain"
+      )
+    end
+
+    def create_image_blob(fixture_name, content_type)
+      ActiveStorage::Blob.create_and_upload!(
+        io: File.open(file_fixture(fixture_name)),
+        filename: fixture_name,
+        content_type: content_type
+      )
+    end
+
+    def embed_html(*blobs)
+      blobs.map do |blob|
+        %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+      end.join
+    end
+end
