diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..59818fe
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class ReportArchiveJobTest < ActiveJob::TestCase
+  teardown do
+    FileUtils.rm_rf Rails.root.join(ReportArchiveJob::ARCHIVE_DIR)
+  end
+
+  test "writes archive file with last_edited_at timestamp header" do
+    book = books(:handbook)
+    leaves(:welcome_page).leafable.update!(body: "Archive content")
+
+    ReportArchiveJob.perform_now(book)
+
+    path = Rails.root.join(ReportArchiveJob::ARCHIVE_DIR, "book-#{book.id}.txt")
+    assert File.exist?(path)
+
+    content = File.read(path)
+    assert content.start_with?("# archived #{book.last_edited_at}\n\n")
+    assert_includes content, "Archive content"
+  end
+
+  test "writes archive file when book has no edited leaves" do
+    book = books(:manual)
+
+    ReportArchiveJob.perform_now(book)
+
+    path = Rails.root.join(ReportArchiveJob::ARCHIVE_DIR, "book-#{book.id}.txt")
+    assert File.exist?(path)
+    assert_equal "# archived \n\n", File.read(path)
+  end
+end
diff --git a/test/lib/publishing/report_card_test.rb b/test/lib/publishing/report_card_test.rb
new file mode 100644
index 0000000..2994beb
--- /dev/null
+++ b/test/lib/publishing/report_card_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class Publishing::ReportCardTest < ActiveSupport::TestCase
+  test "to_text formats book metadata, dates, and leaf list" do
+    book = books(:handbook)
+    expected_covers = book.leaves.active.positioned.pluck(:id).join(",")
+
+    text = Publishing::ReportCard.new(book).to_text
+
+    assert_includes text, "Book: #{book.title}\n"
+    assert_includes text, "Leaves: #{book.leaf_count}\n"
+    assert_includes text, "Started: #{book.created_at.to_fs(:long)}\n"
+    assert_includes text, "Updated: #{book.updated_at.to_fs(:short)}\n"
+    assert_includes text, "Covers: #{expected_covers}\n"
+  end
+
+  test "to_text formats empty leaf list as null" do
+    text = Publishing::ReportCard.new(books(:manual)).to_text
+
+    assert_includes text, "Leaves: 0\n"
+    assert_includes text, "Covers: null\n"
+  end
+end
diff --git a/test/mailers/report_digest_mailer_test.rb b/test/mailers/report_digest_mailer_test.rb
new file mode 100644
index 0000000..1c7878d
--- /dev/null
+++ b/test/mailers/report_digest_mailer_test.rb
@@ -0,0 +1,14 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest lists published books with short edited dates" do
+    book = books(:handbook)
+    book.update!(published: true)
+
+    email = ReportDigestMailer.weekly(users(:david))
+
+    assert_equal [ users(:david).email_address ], email.to
+    assert_equal "Your Writebook digest", email.subject
+    assert_includes email.body.encoded, "* #{book.title}, last edited #{book.updated_at.to_date.to_fs(:short)}"
+  end
+end
