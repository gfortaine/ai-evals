diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..8fa0fc7 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,73 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy archives accesses for all users who had access at deletion" do
+    book = books(:handbook)
+
+    assert_no_difference -> { AccessArchive.count } do
+      assert_equal 4, book.accesses.count
+    end
+
+    assert_difference -> { Book.count }, -1 do
+      assert_difference -> { Access.count }, -4 do
+        assert_difference -> { AccessArchive.count }, +4 do
+          delete book_path(book)
+        end
+      end
+    end
+
+    assert_redirected_to root_path
+
+    archives = AccessArchive.where(book_id: book.id).index_by(&:user_id)
+    assert_equal "editor", archives[users(:david).id].level
+    assert_equal "editor", archives[users(:jason).id].level
+    assert_equal "reader", archives[users(:jz).id].level
+    assert_equal "editor", archives[users(:kevin).id].level
+  end
+
+  test "destroy reflects updated accesses and excludes revoked users" do
+    sign_in :jason
+
+    assert_no_difference -> { AccessArchive.count } do
+      post books_path, params: {
+        book: { title: "Shared Book", everyone_access: false },
+        "editor_ids[]": users(:jz).id,
+        "reader_ids[]": users(:kevin).id
+      }
+    end
+
+    book = Book.order(:id).last
+
+    assert_no_difference -> { AccessArchive.count } do
+      patch book_path(book), params: {
+        book: { title: "Shared Book", everyone_access: false },
+        "reader_ids[]": users(:jz).id
+      }
+    end
+
+    assert_difference -> { Book.count }, -1 do
+      assert_difference -> { AccessArchive.count }, +2 do
+        delete book_path(book)
+      end
+    end
+
+    archives = AccessArchive.where(book_id: book.id).index_by(&:user_id)
+    assert_equal [ users(:jason).id, users(:jz).id ].sort, archives.keys.sort
+    assert_equal "editor", archives[users(:jason).id].level
+    assert_equal "reader", archives[users(:jz).id].level
+    assert_nil archives[users(:kevin).id]
+  end
+
+  test "destroy is forbidden for reader and writes no archive rows" do
+    sign_in :jz
+
+    assert_no_difference -> { Book.count } do
+      assert_no_difference -> { AccessArchive.count } do
+        delete book_path(books(:handbook))
+      end
+    end
+
+    assert_response :forbidden
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..c6f2076 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,57 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroying a book archives each user's access level and removes the book and accesses" do
+    book = books(:handbook)
+    assert_equal 0, AccessArchive.where(book_id: book.id).count
+
+    book.destroy!
+
+    assert_not Book.exists?(book.id)
+    assert_equal 0, Access.where(book_id: book.id).count
+
+    archives = AccessArchive.where(book_id: book.id).index_by(&:user_id)
+    assert_equal 4, archives.size
+
+    assert_equal({ "book_title" => "Handbook", "user_name" => "David", "level" => "editor" },
+      archives[users(:david).id].slice("book_title", "user_name", "level"))
+    assert_equal({ "book_title" => "Handbook", "user_name" => "Jason", "level" => "editor" },
+      archives[users(:jason).id].slice("book_title", "user_name", "level"))
+    assert_equal({ "book_title" => "Handbook", "user_name" => "JZ", "level" => "reader" },
+      archives[users(:jz).id].slice("book_title", "user_name", "level"))
+    assert_equal({ "book_title" => "Handbook", "user_name" => "Kevin", "level" => "editor" },
+      archives[users(:kevin).id].slice("book_title", "user_name", "level"))
+  end
+
+  test "destroying a book reflects updated access levels and excludes revoked users" do
+    book = books(:handbook)
+    book.update!(everyone_access: false)
+    book.update_access(editors: [ users(:david).id, users(:jason).id ], readers: [ users(:kevin).id ])
+
+    assert_equal 0, AccessArchive.where(book_id: book.id).count
+
+    book.destroy!
+
+    archives = AccessArchive.where(book_id: book.id).index_by(&:user_id)
+    assert_equal [ users(:david).id, users(:jason).id, users(:kevin).id ].sort, archives.keys.sort
+    assert_equal "editor", archives[users(:david).id].level
+    assert_equal "editor", archives[users(:jason).id].level
+    assert_equal "reader", archives[users(:kevin).id].level
+    assert_nil archives[users(:jz).id]
+  end
+
+  test "deleting a book nobody had access to writes no archive rows" do
+    book = Book.create!(title: "Lonely Book", everyone_access: false)
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+    assert_not Book.exists?(book.id)
+
+    other_book = Book.create!(title: "Another Lonely Book")
+    assert_no_difference -> { AccessArchive.count } do
+      other_book.delete
+    end
+    assert_not Book.exists?(other_book.id)
+  end
 end
