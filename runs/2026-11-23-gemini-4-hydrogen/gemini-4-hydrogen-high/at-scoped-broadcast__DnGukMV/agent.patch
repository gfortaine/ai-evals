diff --git a/test/channels/leaves/being_edited_channel_test.rb b/test/channels/leaves/being_edited_channel_test.rb
new file mode 100644
index 0000000..6fc751a
--- /dev/null
+++ b/test/channels/leaves/being_edited_channel_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Leaves::BeingEditedChannelTest < ActionCable::Channel::TestCase
+  test "subscribes to user-scoped stream when user can edit the book" do
+    leaf = leaves(:welcome_page)
+    stub_connection current_user: users(:kevin)
+
+    subscribe signed_stream_name: Turbo::StreamsChannel.signed_stream_name(leaf)
+
+    assert subscription.confirmed?
+    assert_has_stream Leaves::BeingEditedChannel.stream_name_for(leaf, users(:kevin))
+  end
+
+  test "subscribes when user is an administrator" do
+    leaf = leaves(:welcome_page)
+    stub_connection current_user: users(:david)
+
+    subscribe signed_stream_name: Turbo::StreamsChannel.signed_stream_name(leaf)
+
+    assert subscription.confirmed?
+    assert_has_stream Leaves::BeingEditedChannel.stream_name_for(leaf, users(:david))
+  end
+
+  test "rejects subscription when user only has read access" do
+    leaf = leaves(:welcome_page)
+    stub_connection current_user: users(:jz)
+
+    subscribe signed_stream_name: Turbo::StreamsChannel.signed_stream_name(leaf)
+
+    assert subscription.rejected?
+  end
+
+  test "rejects subscription after collaborator is removed from the book" do
+    leaf = leaves(:welcome_page)
+    signed_stream_name = Turbo::StreamsChannel.signed_stream_name(leaf)
+    books(:handbook).update_access(editors: [ users(:david).id, users(:jason).id ], readers: [])
+
+    stub_connection current_user: users(:kevin)
+    subscribe signed_stream_name: signed_stream_name
+
+    assert subscription.rejected?
+  end
+
+  test "rejects subscription for deactivated user" do
+    leaf = leaves(:welcome_page)
+    users(:kevin).deactivate
+
+    stub_connection current_user: users(:kevin)
+    subscribe signed_stream_name: Turbo::StreamsChannel.signed_stream_name(leaf)
+
+    assert subscription.rejected?
+  end
+
+  test "rejects subscription for trashed leaf" do
+    leaf = leaves(:welcome_page)
+    leaf.trashed!
+
+    stub_connection current_user: users(:kevin)
+    subscribe signed_stream_name: Turbo::StreamsChannel.signed_stream_name(leaf)
+
+    assert subscription.rejected?
+  end
+
+  test "rejects subscription with invalid or non-leaf signed stream name" do
+    stub_connection current_user: users(:kevin)
+
+    subscribe signed_stream_name: "invalid"
+    assert subscription.rejected?
+
+    subscribe signed_stream_name: Turbo::StreamsChannel.signed_stream_name(books(:handbook))
+    assert subscription.rejected?
+  end
+end
diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..81a68fd 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,105 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+test "edit renders user-authorized being edited channel stream source" do
+  get edit_leafable_path(leaves(:welcome_page))
+
+  assert_response :success
+  assert_select "turbo-cable-stream-source[channel=?][signed-stream-name=?]",
+    "Leaves::BeingEditedChannel",
+    Turbo::StreamsChannel.signed_stream_name(leaves(:welcome_page))
+end
+
+test "update broadcasts being edited indicator only to other active editors" do
+  leaf = leaves(:welcome_page)
+  sign_in :david
+
+  perform_enqueued_jobs do
+    put leafable_path(leaf), params: { leaf: { title: "Updated" }, page: { body: "New body." } }
+  end
+  assert_response :no_content
+
+  [ users(:jason), users(:kevin) ].each do |editor|
+    stream = Leaves::BeingEditedChannel.stream_name_for(leaf, editor)
+    assert_equal 1, broadcasts(stream).size
+    assert_includes broadcasts(stream).first, "David"
+  end
+
+  assert_empty broadcasts(Leaves::BeingEditedChannel.stream_name_for(leaf, users(:david)))
+  assert_empty broadcasts(Leaves::BeingEditedChannel.stream_name_for(leaf, users(:jz)))
+  assert_empty broadcasts(Turbo::StreamsChannel.send(:stream_name_from, [ leaf, :being_edited ]))
+end
+
+test "update does not broadcast being edited indicator to a removed collaborator" do
+  leaf = leaves(:welcome_page)
+  removed_stream = Leaves::BeingEditedChannel.stream_name_for(leaf, users(:kevin))
+
+  books(:handbook).update_access(editors: [ users(:david).id, users(:jason).id ], readers: [])
+
+  sign_in :david
+  perform_enqueued_jobs do
+    put leafable_path(leaf), params: { leaf: { title: "Updated" }, page: { body: "New body." } }
+  end
+  assert_response :no_content
+
+  assert_empty broadcasts(removed_stream)
+  assert_empty broadcasts(Turbo::StreamsChannel.send(:stream_name_from, [ leaf, :being_edited ]))
+
+  remaining_stream = Leaves::BeingEditedChannel.stream_name_for(leaf, users(:jason))
+  assert_equal 1, broadcasts(remaining_stream).size
+  assert_includes broadcasts(remaining_stream).first, "David"
+end
+
+test "update does not broadcast being edited indicator to a collaborator downgraded to reader" do
+  leaf = leaves(:welcome_page)
+  downgraded_stream = Leaves::BeingEditedChannel.stream_name_for(leaf, users(:kevin))
+
+  books(:handbook).access_for(user: users(:kevin)).update!(level: :reader)
+
+  sign_in :david
+  perform_enqueued_jobs do
+    put leafable_path(leaf), params: { leaf: { title: "Updated" }, page: { body: "New body." } }
+  end
+  assert_response :no_content
+
+  assert_empty broadcasts(downgraded_stream)
+  assert_equal 1, broadcasts(Leaves::BeingEditedChannel.stream_name_for(leaf, users(:jason))).size
+end
+
+test "update does not broadcast to collaborator removed via book update while indicator works for remaining editors" do
+  leaf = leaves(:welcome_page)
+
+  # Collaborator opens editor while they have access
+  get edit_leafable_path(leaf)
+  assert_response :success
+  assert_select "turbo-cable-stream-source[channel=?]", "Leaves::BeingEditedChannel"
+
+  kevin_stream = Leaves::BeingEditedChannel.stream_name_for(leaf, users(:kevin))
+  jason_stream = Leaves::BeingEditedChannel.stream_name_for(leaf, users(:jason))
+  plain_leaf_stream = Turbo::StreamsChannel.send(:stream_name_from, leaf)
+
+  # Admin removes kevin from the book
+  sign_in :david
+  put book_path(books(:handbook)), params: {
+    book: { everyone_access: false },
+    editor_ids: [ users(:jason).id ]
+  }
+  assert_redirected_to book_slug_path(books(:handbook))
+
+  # Admin saves the page
+  perform_enqueued_jobs do
+    put leafable_path(leaf), params: { leaf: { title: "Updated" }, page: { body: "New body." } }
+  end
+  assert_response :no_content
+
+  assert_empty broadcasts(kevin_stream)
+  assert_empty broadcasts(plain_leaf_stream)
+
+  assert_equal 1, broadcasts(jason_stream).size
+  payload = ActiveSupport::JSON.decode(broadcasts(jason_stream).first)
+  assert_includes payload, "action=\"append\""
+  assert_includes payload, "target=\"being_edited_leaf_#{leaf.id}\""
+  assert_includes payload, "David"
+end
 end
