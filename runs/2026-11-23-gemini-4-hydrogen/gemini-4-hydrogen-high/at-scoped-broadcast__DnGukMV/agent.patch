--- /dev/null
+++ b/app/channels/leaves/being_edited_channel.rb
@@ -0,0 +1,28 @@
+class Leaves::BeingEditedChannel < ApplicationCable::Channel
+  extend Turbo::Streams::Broadcasts, Turbo::Streams::StreamName
+  include Turbo::Streams::StreamName::ClassMethods
+
+  def self.stream_name_for(leaf, user)
+    stream_name_from([ leaf, user, :being_edited ])
+  end
+
+  def subscribed
+    if leaf = find_authorized_leaf
+      stream_from self.class.stream_name_for(leaf, current_user)
+    else
+      reject
+    end
+  end
+
+  private
+    def find_authorized_leaf
+      if verified_stream_name = verified_stream_name_from_params
+        leaf = GlobalID::Locator.locate(verified_stream_name, only: Leaf)
+        if leaf&.active? && current_user&.active? && leaf.book.editable?(user: current_user)
+          leaf
+        end
+      end
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+end
