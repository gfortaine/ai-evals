+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.publish
+  end
+
+  test "show published card on public board without authentication" do
+    card = cards(:logo)
+
+    get public_board_card_path(@publication.key, card)
+
+    assert_response :success
+    assert_select "h1", text: card.title
+    assert_in_body comments(:logo_1).body.to_plain_text
+    assert_no_match %r{/cards/#{card.number}/edit}, response.body
+  end
+
+  test "show returns 404 for drafted card on public board" do
+    drafted_card = @board.cards.create!(title: "Secret draft", status: :drafted, creator: users(:kevin))
+
+    get public_board_card_path(@publication.key, drafted_card)
+
+    assert_response :not_found
+  end
+
+  test "show returns 404 for card on another board" do
+    other_board = boards(:private)
+    other_card = Current.set(user: users(:kevin)) do
+      other_board.cards.create!(title: "Secret Card", status: :published, creator: users(:kevin))
+    end
+
+    get public_board_card_path(@publication.key, other_card)
+
+    assert_response :not_found
+  end
+
+  test "show returns 404 when board is unpublished" do
+    @board.unpublish
+
+    get public_board_card_path(@publication.key, cards(:logo))
+
+    assert_response :not_found
+  end
+
+  test "card image attachment on published card is publicly accessible, drafted card attachment is forbidden" do
+    published_card = cards(:logo)
+    published_card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    drafted_card = @board.cards.create!(title: "Secret draft", status: :drafted, creator: users(:kevin))
+    drafted_card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon2.jpg", content_type: "image/jpeg")
+
+    get rails_blob_path(published_card.image, disposition: "inline")
+    assert_response :redirect
+    assert_no_match %r{/session/new}, response.location
+
+    get rails_blob_path(drafted_card.image, disposition: "inline")
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+  test "show postponed and closed cards with steps, tags, reactions, and assignees" do
+    Current.with(user: users(:kevin)) do
+      closed_card = @board.cards.create!(title: "Closed card", status: :published, creator: users(:kevin))
+      closed_card.steps.create!(content: "Step 1", completed: true)
+      closed_card.tags << tags(:web)
+      closed_card.assignments.create!(assignee: users(:david), assigner: users(:kevin))
+      closed_card.reactions.create!(content: "👍", reacter: users(:david))
+      closed_card.close(user: users(:kevin))
+
+      get public_board_card_path(@publication.key, closed_card)
+      assert_response :success
+      assert_in_body "Closed card"
+      assert_in_body "Step 1"
+      assert_in_body tags(:web).title
+      assert_in_body "👍"
+      assert_in_body "Done"
+
+      postponed_card = @board.cards.create!(title: "Postponed card", status: :published, creator: users(:kevin))
+      postponed_card.postpone(user: users(:kevin))
+
+      get public_board_card_path(@publication.key, postponed_card)
+      assert_response :success
+      assert_in_body "Postponed card"
+      assert_in_body "Not Now"
+    end
+  end
+
+  test "rich text embeds on published card and comment are publicly accessible, drafted card embed is forbidden" do
+    published_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "published_embed.jpg",
+      content_type: "image/jpeg"
+    )
+    published_card = cards(:logo)
+    published_card.update!(description: "<action-text-attachment sgid=\"#{published_blob.attachable_sgid}\"></action-text-attachment>")
+
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "comment_embed.jpg",
+      content_type: "image/jpeg"
+    )
+    comment = comments(:logo_1)
+    comment.update!(body: "<action-text-attachment sgid=\"#{comment_blob.attachable_sgid}\"></action-text-attachment>")
+
+    drafted_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "drafted_embed.jpg",
+      content_type: "image/jpeg"
+    )
+    drafted_card = @board.cards.create!(title: "Secret draft", status: :drafted, creator: users(:kevin))
+    drafted_card.update!(description: "<action-text-attachment sgid=\"#{drafted_blob.attachable_sgid}\"></action-text-attachment>")
+
+    get rails_blob_path(published_blob, disposition: "inline")
+    assert_response :redirect
+    assert_no_match %r{/session/new}, response.location
+
+    get rails_blob_path(comment_blob, disposition: "inline")
+    assert_response :redirect
+    assert_no_match %r{/session/new}, response.location
+
+    get rails_blob_path(drafted_blob, disposition: "inline")
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+end
