diff --git a/app/views/boards/edit/_publish.html.erb b/app/views/boards/edit/_publish.html.erb
new file mode 100644
index 0000000..955db1a
--- /dev/null
+++ b/app/views/boards/edit/_publish.html.erb
@@ -0,0 +1,32 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <div class="flex align-center gap-half divider">
+      <h2 class="txt-large flex-item-grow margin-none">Public link</h2>
+      <%= form_with url: board_publication_path(board), method: board.published? ? :delete : :post, data: { controller: "form" } do %>
+        <label class="switch">
+          <%= check_box_tag :published, "1", board.published?, class: "switch__input",
+                disabled: !Current.user.can_administer_board?(board),
+                data: { action: "change->form#submit" } %>
+          <span class="switch__btn round"></span>
+          <span class="for-screen-reader"><%= board.published? ? "Turn off public link" : "Turn on public link" %></span>
+        </label>
+      <% end %>
+    </div>
+
+    <% if board.published? %>
+      <p class="margin-none-block-start">Anyone with this link can view this board:</p>
+      <% url = public_board_url(board.publication.key) %>
+      <div class="flex align-center gap-half">
+        <input type="text" class="input flex-item-grow" value="<%= url %>" readonly>
+        <%= tag.button type: "button", class: "btn btn--circle txt-small", title: "Copy public link", data: {
+              controller: "copy-to-clipboard tooltip", action: "copy-to-clipboard#copy",
+              copy_to_clipboard_success_class: "btn--success", copy_to_clipboard_content_value: url } do %>
+          <%= icon_tag "copy-paste" %>
+          <span class="for-screen-reader">Copy public link</span>
+        <% end %>
+      </div>
+    <% else %>
+      <p class="margin-none-block-start">Publish this board to share a read-only link with anyone.</p>
+    <% end %>
+  </div>
+<% end %>
