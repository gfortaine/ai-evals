diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..07f7867 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,56 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_save :record_publication_transition, if: :saved_change_to_published?
+    after_commit :announce_publication_if_newly_published
   end
 
   private
+    def record_publication_transition
+      tx = self.class.current_transaction
+      publication_transitions[id] ||= []
+      publication_transitions[id] << { tx_uuid: tx.uuid, from: published_before_last_save, to: published? }
+
+      register_publication_transaction_cleanup(tx)
+    end
+
+    def announce_publication_if_newly_published
+      transitions = publication_transitions.delete(id)
+      return if destroyed? || transitions.blank?
+
+      if !transitions.first[:from] && transitions.last[:to] && Book.published.exists?(id)
+        announce_publication
+      end
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
     end
+
+    def publication_transitions
+      ActiveSupport::IsolatedExecutionState[:book_publication_transitions] ||= {}
+    end
+
+    def register_publication_transaction_cleanup(tx)
+      return unless tx.open?
+
+      registered = (ActiveSupport::IsolatedExecutionState[:book_publication_registered_txs] ||= Set.new)
+      return if registered.include?(tx.uuid)
+
+      tx_uuid = tx.uuid
+      registered.add(tx_uuid)
+
+      tx.after_commit do
+        registered.delete(tx_uuid)
+      end
+
+      tx.after_rollback do
+        registered.delete(tx_uuid)
+        transitions = ActiveSupport::IsolatedExecutionState[:book_publication_transitions]
+        next unless transitions
+
+        transitions.each_value { |list| list.reject! { |entry| entry[:tx_uuid] == tx_uuid } }
+        transitions.delete_if { |_, list| list.empty? }
+      end
+    end
 end
