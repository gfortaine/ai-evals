diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..2a75115
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,161 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+  end
+
+  test "going live announces once" do
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ @book ]) do
+      assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+        @book.update!(published: true)
+      end
+    end
+  end
+
+  test "going live and adding a page in the same transaction announces once" do
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ @book ]) do
+      assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+        @book.transaction do
+          @book.update!(published: true)
+          @book.press Page.new(body: "Body"), title: "New Page"
+        end
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "going live with multiple updates and touches in the same transaction announces once" do
+    handbook = books(:handbook)
+
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ handbook ]) do
+      assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+        Book.transaction do
+          handbook.update!(published: true)
+          handbook.update!(title: "Updated Handbook")
+          leaves(:welcome_page).update!(title: "Updated Welcome")
+          Book.find(handbook.id).update!(slug: "updated-handbook")
+        end
+      end
+    end
+  end
+
+  test "taking a live book down does not announce" do
+    @book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update!(published: false)
+    end
+  end
+
+  test "saving an already-live book again does not announce" do
+    @book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update!(title: "New Title")
+      @book.update!(published: true, slug: "new-slug")
+      @book.press Page.new(body: "Body"), title: "Another Page"
+    end
+  end
+
+  test "saving a draft without going live does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update!(title: "Still Draft")
+      @book.press Page.new(body: "Body"), title: "Draft Page"
+    end
+  end
+
+  test "failing a transaction after marking live leaves a draft and no announcement" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises RuntimeError do
+        @book.transaction do
+          @book.update!(published: true)
+          raise "something went wrong"
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "rolling back a transaction after marking live leaves a draft and no announcement" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "marking live then back to draft in the same transaction does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.update!(published: false)
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "taking a live book down then back live in the same transaction does not announce" do
+    @book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: false)
+        @book.update!(published: true)
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "marking live then destroying in the same transaction does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.destroy!
+      end
+    end
+  end
+
+  test "savepoint rollback after marking live does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update!(title: "Outer")
+        Book.transaction(requires_new: true) do
+          @book.update!(published: true)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "creating a live book announces once even when touched in the same transaction" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        book = Book.create!(title: "Live from birth", published: true)
+        book.press Page.new(body: "Body"), title: "First Page"
+      end
+    end
+  end
+
+  test "publishing two books in the same transaction announces each once" do
+    handbook = books(:handbook)
+
+    assert_enqueued_jobs 2, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update!(published: true)
+        handbook.update!(published: true)
+      end
+    end
+  end
+end
