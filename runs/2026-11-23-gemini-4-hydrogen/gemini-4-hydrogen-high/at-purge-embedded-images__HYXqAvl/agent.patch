+
+    assert_equal 2, attachments.size
+    disk_paths.each { |path| assert File.exist?(path) }
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    attachments.each { |att| assert_not ActiveStorage::Attachment.exists?(att.id) }
+    blobs.each { |blob| assert_not ActiveStorage::Blob.exists?(blob.id) }
+    disk_paths.each { |path| assert_not File.exist?(path) }
+  end
