new file mode 100644
index 0000000..56d16f7
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,86 @@
+class Account < ApplicationRecord
+  CANCELLATION_RETENTION_PERIOD = 90.days
+
+  belongs_to :owner, class_name: "User", optional: true
+  has_many :users, dependent: :destroy
+  has_many :sessions, through: :users
+
+  normalizes :subdomain, with: ->(s) { s.to_s.strip.downcase }
+  normalizes :name, with: ->(n) { n.to_s.strip }
+
+  validates :name, presence: true
+  validates :subdomain,
+            presence: true,
+            uniqueness: { case_sensitive: false },
+            format: {
+              with: /\A[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\z/,
+              message: "must be lowercase alphanumeric and hyphens"
+            }
+
+  before_destroy :clear_owner_reference, prepend: true
+
+  scope :cancelled, -> { where.not(cancelled_at: nil) }
+  scope :purgeable, -> { where("cancelled_at < ?", CANCELLATION_RETENTION_PERIOD.ago) }
+
+  def self.purge_expired!
+    deleted_count = 0
+    purgeable.find_each do |account|
+      account.destroy!
+      deleted_count += 1
+    end
+    deleted_count
+  end
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  def active?
+    !cancelled?
+  end
+
+  def reactivable?
+    cancelled? && cancelled_at >= CANCELLATION_RETENTION_PERIOD.ago
+  end
+
+  def cancellation_expired?
+    cancelled? && cancelled_at < CANCELLATION_RETENTION_PERIOD.ago
+  end
+
+  def cancel!
+    transaction do
+      update!(cancelled_at: Time.current)
+      Session.where(user_id: users.select(:id)).delete_all
+    end
+  end
+
+  def reactivate!
+    update!(cancelled_at: nil)
+  end
+
+  def as_portal_json
+    {
+      name: name,
+      subdomain: subdomain
+    }
+  end
+
+  def as_api_json
+    {
+      id: id,
+      name: name,
+      subdomain: subdomain,
+      owner_id: owner_id,
+      cancelled: cancelled?,
+      cancelled_at: cancelled_at,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  private
+
+  def clear_owner_reference
+    update_columns(owner_id: nil) if owner_id.present?
+  end
+end
