new file mode 100644
index 0000000..1479e93
--- /dev/null
+++ b/test/test_helper.rb
@@ -0,0 +1,47 @@
+ENV["RAILS_ENV"] ||= "test"
+require_relative "../config/environment"
+require "rails/test_help"
+
+module ActiveSupport
+  class TestCase
+    parallelize(workers: :number_of_processors)
+
+    def json_response
+      ::JSON.parse(response.body)
+    end
+
+    def extract_token_from_email(mail, path)
+      text = mail.text_part ? mail.text_part.body.decoded : mail.body.decoded
+      match = text.match(%r{(https?://[^\s]+#{Regexp.escape(path)}\?account=([^&\s]+)&token=([^&\s]+))})
+      assert_not_nil match, "Expected link with #{path} in email body:\n#{text}"
+      { account: CGI.unescape(match[2]), token: CGI.unescape(match[3]), full_url: match[1] }
+    end
+
+    def create_and_verify_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+      ActionMailer::Base.deliveries.clear
+      post "/api/v1/account/create",
+           params: { account: { name: name, subdomain: subdomain, admin: { name: admin_name, email: email, password: password } } },
+           as: :json
+      assert_response :created
+      mail = ActionMailer::Base.deliveries.last
+      link = extract_token_from_email(mail, "/verify-email")
+
+      post "/api/v1/email_verifications/confirm",
+           params: { email_verification: { token: link[:token] } },
+           headers: { "X-Helpdesk-Account" => subdomain },
+           as: :json
+      assert_response :success
+
+      json_response
+    end
+
+    def sign_in(subdomain:, email:, password:)
+      post "/api/v1/sessions",
+           params: { session: { email: email, password: password } },
+           headers: { "X-Helpdesk-Account" => subdomain },
+           as: :json
+      assert_response :created
+      json_response
+    end
+  end
+end
