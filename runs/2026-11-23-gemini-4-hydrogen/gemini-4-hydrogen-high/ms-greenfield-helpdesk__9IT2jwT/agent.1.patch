diff --git a/test/integration/account_cancellation_test.rb b/test/integration/account_cancellation_test.rb
new file mode 100644
index 0000000..4721bd3
--- /dev/null
+++ b/test/integration/account_cancellation_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+require "rake"
+
+class AccountCancellationTest < ActionDispatch::IntegrationTest
+  test "owner can cancel and reactivate within 90 days; cancellation revokes sessions and stops ordinary access" do
+    created = create_and_verify_account
+    account = Account.find(created.dig("user", "account_id"))
+    account.users.create!(
+      name: "Agent",
+      email: "agent@acme.test",
+      password: "agent-password",
+      role: "agent",
+      verified_at: Time.current
+    )
+
+    owner_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    agent_token = sign_in(subdomain: "acme", email: "agent@acme.test", password: "agent-password").dig("session", "token")
+
+    # Non-owner cannot cancel
+    post "/api/v1/account/cancel",
+         headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{agent_token}" }
+    assert_response :forbidden
+
+    # Owner cancels
+    post "/api/v1/account/cancel",
+         headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :success
+    assert_not_nil json_response.dig("account", "cancelled_at")
+
+    # Existing sessions are revoked
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :unauthorized
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{agent_token}" }
+    assert_response :unauthorized
+
+    # Portal and verification/reset are unavailable while cancelled
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :forbidden
+
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "jo@acme.test" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :forbidden
+
+    # Non-owner cannot sign in while cancelled
+    post "/api/v1/sessions",
+         params: { session: { email: "agent@acme.test", password: "agent-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :forbidden
+
+    # Owner CAN sign in to reactivate
+    new_owner_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    # Ordinary business access is still blocked while cancelled
+    get "/api/v1/account", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{new_owner_token}" }
+    assert_response :forbidden
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{new_owner_token}" }
+    assert_response :forbidden
+    patch "/api/v1/me",
+          params: { user: { name: "Blocked" } },
+          headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{new_owner_token}" },
+          as: :json
+    assert_response :forbidden
+
+    # Owner can sign out while cancelled
+    temp_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    delete "/api/v1/session",
+           headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{temp_token}" }
+    assert_response :success
+
+    # Owner reactivates within 90 days
+    post "/api/v1/account/reactivate",
+         headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{new_owner_token}" }
+    assert_response :success
+    assert_nil json_response.dig("account", "cancelled_at")
+
+    # Access restored
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :success
+    get "/api/v1/account", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{new_owner_token}" }
+    assert_response :success
+    sign_in(subdomain: "acme", email: "agent@acme.test", password: "agent-password")
+  end
+
+  test "cannot reactivate after 90 days and purge task permanently deletes expired cancelled accounts" do
+    expired_data = create_and_verify_account(name: "Expired", subdomain: "expired", email: "jo@expired.test")
+    recent_data = create_and_verify_account(name: "Recent", subdomain: "recent", email: "jo@recent.test")
+    active_data = create_and_verify_account(name: "Active", subdomain: "active", email: "jo@active.test")
+
+    expired_account = Account.find(expired_data.dig("user", "account_id"))
+    recent_account = Account.find(recent_data.dig("user", "account_id"))
+    active_account = Account.find(active_data.dig("user", "account_id"))
+
+    expired_account.update!(cancelled_at: 91.days.ago)
+    recent_account.update!(cancelled_at: 89.days.ago)
+
+    # Owner cannot sign in after 90 days
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@expired.test", password: "my-first-password" } },
+         headers: { "X-Helpdesk-Account" => "expired" },
+         as: :json
+    assert_response :forbidden
+
+    # Also test reactivate fails if owner already had a session token when 90 days passed
+    expired_user = User.find(expired_data.dig("user", "id"))
+    _session, stale_token = Session.issue_for!(expired_user)
+    post "/api/v1/account/reactivate",
+         headers: { "X-Helpdesk-Account" => "expired", "Authorization" => "Bearer #{stale_token}" }
+    assert_response :unprocessable_entity
+
+    Rails.application.load_tasks if Rake::Task.tasks.empty?
+    Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+    Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+
+    assert_nil Account.find_by(id: expired_account.id)
+    assert_equal 0, User.where(account_id: expired_account.id).count
+    assert_equal 0, Session.where(user_id: expired_user.id).count
+
+    assert_not_nil Account.find_by(id: recent_account.id)
+    assert_not_nil Account.find_by(id: active_account.id)
+  end
+end
diff --git a/test/integration/account_signup_and_portal_test.rb b/test/integration/account_signup_and_portal_test.rb
new file mode 100644
index 0000000..b7b4552
--- /dev/null
+++ b/test/integration/account_signup_and_portal_test.rb
@@ -0,0 +1,144 @@
+require "test_helper"
+
+class AccountSignupAndPortalTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @orig_frontend = ENV["HELPDESK_FRONTEND_URL"]
+    @orig_mail_from = ENV["HELPDESK_MAIL_FROM"]
+  end
+
+  teardown do
+    ENV["HELPDESK_FRONTEND_URL"] = @orig_frontend
+    ENV["HELPDESK_MAIL_FROM"] = @orig_mail_from
+  end
+
+  test "signup creates account and unverified admin user and sends verification email" do
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "Acme",
+             admin: {
+               name: "Jo",
+               email: "Jo@Acme.test",
+               password: "my-first-password"
+             }
+           }
+         },
+         as: :json
+
+    assert_response :created
+    body = json_response
+
+    assert_equal "Acme", body.dig("account", "name")
+    assert_equal "acme", body.dig("account", "subdomain")
+    assert_not_nil body.dig("account", "id")
+    assert_not_nil body.dig("account", "created_at")
+    assert_not_nil body.dig("account", "updated_at")
+
+    assert_equal "Jo", body.dig("user", "name")
+    assert_equal "jo@acme.test", body.dig("user", "email")
+    assert_equal "admin", body.dig("user", "role")
+    assert_equal false, body.dig("user", "verified")
+    assert_not_nil body.dig("user", "id")
+    assert_equal body.dig("account", "id"), body.dig("user", "account_id")
+    assert_not_nil body.dig("user", "created_at")
+    assert_not_nil body.dig("user", "updated_at")
+    assert_nil body.dig("user", "password_digest")
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "support@example.test" ], mail.from
+    assert_equal [ "jo@acme.test" ], mail.to
+
+    link = extract_token_from_email(mail, "/verify-email")
+    assert_equal "acme", link[:account]
+    assert link[:full_url].start_with?("http://localhost:3001/verify-email?account=acme&token=")
+
+    # Unverified admin cannot sign in
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :forbidden
+  end
+
+  test "signup uses configured HELPDESK_FRONTEND_URL and HELPDESK_MAIL_FROM" do
+    ENV["HELPDESK_FRONTEND_URL"] = "https://app.helpdesk.test/"
+    ENV["HELPDESK_MAIL_FROM"] = "no-reply@helpdesk.test"
+
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Beta",
+             subdomain: "beta",
+             admin: { name: "Sam", email: "sam@beta.test", password: "my-first-password" }
+           }
+         },
+         as: :json
+
+    assert_response :created
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "no-reply@helpdesk.test" ], mail.from
+    link = extract_token_from_email(mail, "/verify-email")
+    assert link[:full_url].start_with?("https://app.helpdesk.test/verify-email?account=beta&token=")
+  end
+
+  test "signup rolls back account if admin validation fails and rejects duplicate subdomains" do
+    assert_no_difference [ "Account.count", "User.count" ] do
+      post "/api/v1/account/create",
+           params: {
+             account: {
+               name: "Bad",
+               subdomain: "bad",
+               admin: { name: "Jo", email: "not-an-email", password: "my-first-password" }
+             }
+           },
+           as: :json
+      assert_response :unprocessable_entity
+    end
+
+    create_and_verify_account(name: "Acme", subdomain: "acme", email: "jo@acme.test")
+
+    assert_no_difference [ "Account.count", "User.count" ] do
+      post "/api/v1/account/create",
+           params: {
+             account: {
+               name: "Acme 2",
+               subdomain: "acme",
+               admin: { name: "Other", email: "other@acme.test", password: "my-first-password" }
+             }
+           },
+           as: :json
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "portal is public and account requires authentication" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", email: "jo@acme.test")
+
+    get "/api/v1/portal"
+    assert_response :bad_request
+
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "unknown" }
+    assert_response :not_found
+
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :success
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, json_response)
+
+    get "/api/v1/account", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :unauthorized
+
+    login = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token = login.dig("session", "token")
+
+    get "/api/v1/account",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token}" }
+    assert_response :success
+    assert_equal "Acme", json_response.dig("account", "name")
+    assert_equal "acme", json_response.dig("account", "subdomain")
+    assert_not_nil json_response.dig("account", "id")
+    assert_not_nil json_response.dig("account", "created_at")
+  end
+end
diff --git a/test/integration/cors_test.rb b/test/integration/cors_test.rb
new file mode 100644
index 0000000..aefbaee
--- /dev/null
+++ b/test/integration/cors_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class CorsTest < ActionDispatch::IntegrationTest
+  setup do
+    @orig_frontend = ENV["HELPDESK_FRONTEND_URL"]
+  end
+
+  teardown do
+    ENV["HELPDESK_FRONTEND_URL"] = @orig_frontend
+  end
+
+  test "allows requests from configured frontend origin and blocks other origins" do
+    create_and_verify_account
+
+    options "/api/v1/portal",
+            headers: {
+              "Origin" => "http://localhost:3001",
+              "Access-Control-Request-Method" => "GET",
+              "Access-Control-Request-Headers" => "X-Helpdesk-Account, Authorization"
+            }
+    assert_response :no_content
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+    assert_includes response.headers["Access-Control-Allow-Headers"], "X-Helpdesk-Account"
+    assert_includes response.headers["Access-Control-Allow-Headers"], "Authorization"
+
+    get "/api/v1/portal",
+        headers: { "Origin" => "http://localhost:3001", "X-Helpdesk-Account" => "acme" }
+    assert_response :success
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+
+    get "/api/v1/portal",
+        headers: { "Origin" => "http://evil.test", "X-Helpdesk-Account" => "acme" }
+    assert_response :success
+    assert_nil response.headers["Access-Control-Allow-Origin"]
+
+    ENV["HELPDESK_FRONTEND_URL"] = "https://portal.acme.test:8443/app"
+    get "/api/v1/portal",
+        headers: { "Origin" => "https://portal.acme.test:8443", "X-Helpdesk-Account" => "acme" }
+    assert_response :success
+    assert_equal "https://portal.acme.test:8443", response.headers["Access-Control-Allow-Origin"]
+  end
+end
