+++ b/test/integration/edge_cases_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class EdgeCasesTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "expired verification and password reset tokens are rejected" do
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "acme",
+             admin: { name: "Jo", email: "jo@acme.test", password: "my-first-password" }
+           }
+         },
+         as: :json
+    assert_response :created
+    verify_token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/verify-email")[:token]
+
+    travel 25.hours do
+      post "/api/v1/email_verifications/confirm",
+           params: { email_verification: { token: verify_token } },
+           headers: { "X-Helpdesk-Account" => "acme" },
+           as: :json
+      assert_response :unprocessable_entity
+    end
+
+    # Request fresh verification and confirm
+    post "/api/v1/email_verifications",
+         params: { email_verification: { email: "jo@acme.test" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+    fresh_token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/verify-email")[:token]
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: fresh_token } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+
+    # Resending verification for already-verified user sends no email
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/email_verifications",
+         params: { email_verification: { email: "jo@acme.test" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    # Password reset token expires after 2 hours
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "jo@acme.test" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+    reset_token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/reset-password")[:token]
+
+    travel 3.hours do
+      post "/api/v1/password_resets/confirm",
+           params: { password_reset: { token: reset_token, password: "my-new-password" } },
+           headers: { "X-Helpdesk-Account" => "acme" },
+           as: :json
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "malformed JSON and missing parameters return 400 JSON errors" do
+    post "/api/v1/account/create",
+         params: "{not-json",
+         headers: { "CONTENT_TYPE" => "application/json" }
+    assert_response :bad_request
+    assert_not_nil json_response["error"]
+
+    post "/api/v1/account/create", params: {}, as: :json
+    assert_response :bad_request
+    assert_not_nil json_response["error"]
+  end
+end
diff --git a/test/integration/email_verification_and_auth_test.rb b/test/integration/email_verification_and_auth_test.rb
new file mode 100644
index 0000000..2f869cd
--- /dev/null
+++ b/test/integration/email_verification_and_auth_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class EmailVerificationAndAuthTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "resending email verification replaces previous link and confirms user" do
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "acme",
+             admin: { name: "Jo", email: "jo@acme.test", password: "my-first-password" }
+           }
+         },
+         as: :json
+    assert_response :created
+
+    first_mail = ActionMailer::Base.deliveries.last
+    first_token = extract_token_from_email(first_mail, "/verify-email")[:token]
+
+    post "/api/v1/email_verifications",
+         params: { email_verification: { email: "jo@acme.test" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+
+    second_mail = ActionMailer::Base.deliveries.last
+    second_token = extract_token_from_email(second_mail, "/verify-email")[:token]
+    assert_not_equal first_token, second_token
+
+    # Old token is invalid
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: first_token } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    # New token works
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: second_token } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+    assert_equal true, json_response.dig("user", "verified")
+
+    # Token cannot be reused
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: second_token } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+  end
+
+  test "login returns session token, user, account and DELETE /session signs out only that session" do
+    create_and_verify_account
+
+    # Wrong password
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "wrong" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unauthorized
+
+    login1 = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token1 = login1.dig("session", "token")
+    assert_not_nil token1
+    assert_equal "jo@acme.test", login1.dig("user", "email")
+    assert_equal "acme", login1.dig("account", "subdomain")
+
+    login2 = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token2 = login2.dig("session", "token")
+    assert_not_equal token1, token2
+
+    delete "/api/v1/session",
+           headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" }
+    assert_response :success
+
+    get "/api/v1/me",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" }
+    assert_response :unauthorized
+
+    get "/api/v1/me",
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token2}" }
+    assert_response :success
+  end
+end
