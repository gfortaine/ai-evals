+module Api
+  module V1
+    class ProfilesController < BaseController
+      before_action :require_account!
+      before_action :require_session!
+      before_action :require_active_account!
+
+      def show
+        render json: { user: current_user.as_api_json }, status: :ok
+      end
+
+      def update
+        user_params = params.require(:user).permit(:name)
+        current_user.update!(user_params)
+        render json: { user: current_user.as_api_json }, status: :ok
+      end
+
+      def update_password
+        password_params = params.require(:password_change).permit(:current_password, :password)
+
+        unless current_user.authenticate(password_params[:current_password].to_s)
+          return render json: { error: "Current password is incorrect" }, status: :unprocessable_entity
+        end
+
+        current_user.change_password!(password_params[:password])
+        render json: { message: "Password updated" }, status: :ok
+      end
+    end
+  end
+end
