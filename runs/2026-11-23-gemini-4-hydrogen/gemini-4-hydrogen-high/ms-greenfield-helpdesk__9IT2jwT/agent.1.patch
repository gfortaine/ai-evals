+++ b/app/controllers/api/v1/password_resets_controller.rb
@@ -0,0 +1,38 @@
+module Api
+  module V1
+    class PasswordResetsController < BaseController
+      before_action :require_account!
+      before_action :require_active_account!
+
+      def create
+        reset_params = params.require(:password_reset).permit(:email)
+        email = reset_params[:email].to_s.strip.downcase
+
+        if email.blank?
+          return render json: { error: "Email is required" }, status: :unprocessable_entity
+        end
+
+        user = current_account.users.find_by(email: email)
+        if user
+          raw_token = user.generate_password_reset_token!
+          UserMailer.password_reset(user, raw_token).deliver_now
+        end
+
+        render json: { message: "If that email is registered, a password reset link has been sent." }, status: :ok
+      end
+
+      def confirm
+        reset_params = params.require(:password_reset).permit(:token, :password)
+        raw_token = reset_params[:token].to_s
+
+        user = User.find_by_valid_password_reset_token(current_account, raw_token)
+        if user.nil?
+          return render json: { error: "Invalid or expired password reset token" }, status: :unprocessable_entity
+        end
+
+        user.reset_password!(reset_params[:password])
+        render json: { message: "Password has been reset" }, status: :ok
+      end
+    end
+  end
+end
