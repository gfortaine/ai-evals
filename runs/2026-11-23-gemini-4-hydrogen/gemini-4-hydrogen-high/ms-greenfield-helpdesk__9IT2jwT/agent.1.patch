@@ -0,0 +1,30 @@
+require "test_helper"
+
+class MultiTenancyTest < ActionDispatch::IntegrationTest
+  test "same email can exist in different businesses with isolated auth and tokens" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", admin_name: "Jo Acme", email: "jo@shared.test", password: "acme-password")
+    create_and_verify_account(name: "Globex", subdomain: "globex", admin_name: "Jo Globex", email: "jo@shared.test", password: "globex-password")
+
+    acme_token = sign_in(subdomain: "acme", email: "jo@shared.test", password: "acme-password").dig("session", "token")
+    globex_token = sign_in(subdomain: "globex", email: "jo@shared.test", password: "globex-password").dig("session", "token")
+
+    # Acme password fails on Globex
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@shared.test", password: "acme-password" } },
+         headers: { "X-Helpdesk-Account" => "globex" },
+         as: :json
+    assert_response :unauthorized
+
+    # Acme token fails on Globex
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "globex", "Authorization" => "Bearer #{acme_token}" }
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{acme_token}" }
+    assert_response :success
+    assert_equal "Jo Acme", json_response.dig("user", "name")
+
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "globex", "Authorization" => "Bearer #{globex_token}" }
+    assert_response :success
+    assert_equal "Jo Globex", json_response.dig("user", "name")
+  end
+end
diff --git a/test/integration/profile_and_password_test.rb b/test/integration/profile_and_password_test.rb
new file mode 100644
index 0000000..850e034
--- /dev/null
+++ b/test/integration/profile_and_password_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class ProfileAndPasswordTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "user can view and update name via GET /me and PATCH /me" do
+    create_and_verify_account
+    token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token}" }
+
+    get "/api/v1/me", headers: headers
+    assert_response :success
+    assert_equal "Jo", json_response.dig("user", "name")
+
+    patch "/api/v1/me",
+          params: { user: { name: "Jo Smith", role: "customer" } },
+          headers: headers,
+          as: :json
+    assert_response :success
+    assert_equal "Jo Smith", json_response.dig("user", "name")
+    assert_equal "admin", json_response.dig("user", "role")
+  end
+
+  test "changing password via PUT /me/password requires current_password and signs out existing sessions" do
+    create_and_verify_account
+    token1 = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    token2 = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    # Wrong current password
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "wrong", password: "my-new-password" } },
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" },
+        as: :json
+    assert_response :unprocessable_entity
+
+    # Valid password change
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+        headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" },
+        as: :json
+    assert_response :success
+
+    # All existing sessions signed out
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token1}" }
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token2}" }
+    assert_response :unauthorized
+
+    # Old password fails, new password succeeds
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unauthorized
+
+    sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-new-password")
+  end
+
+  test "password reset flow replaces old links, resets password, and signs out existing sessions" do
+    create_and_verify_account
+    token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "jo@acme.test" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+    first_reset_token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/reset-password")[:token]
+
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "jo@acme.test" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+    second_reset_token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/reset-password")[:token]
+    assert_not_equal first_reset_token, second_reset_token
+
+    # Old reset token fails
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: first_reset_token, password: "my-new-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    # Blank password fails without consuming valid token
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: second_reset_token, password: "" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    # Valid token and password succeeds
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: second_reset_token, password: "my-new-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+
+    # Existing session signed out
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token}" }
+    assert_response :unauthorized
+
+    # Can sign in with new password
+    sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-new-password")
+
+    # Reset token cannot be reused
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: second_reset_token, password: "another-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+  end
+end
