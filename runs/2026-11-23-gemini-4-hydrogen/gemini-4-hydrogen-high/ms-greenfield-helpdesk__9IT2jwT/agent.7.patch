+require "test_helper"
+
+class TicketMergingTest < ActionDispatch::IntegrationTest
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails".freeze
+  DEFAULT_INGRESS_PASSWORD = "test-inbound-secret".freeze
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @original_inbound_password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"]
+    @original_support_domain = ENV["HELPDESK_SUPPORT_DOMAIN"]
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = DEFAULT_INGRESS_PASSWORD
+    ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+  end
+
+  teardown do
+    if @original_inbound_password.nil?
+      ENV.delete("RAILS_INBOUND_EMAIL_PASSWORD")
+    else
+      ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @original_inbound_password
+    end
+
+    if @original_support_domain.nil?
+      ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+    else
+      ENV["HELPDESK_SUPPORT_DOMAIN"] = @original_support_domain
+    end
+  end
+
+  def create_verified_customer(subdomain:, name:, email:, password: "my-customer-password")
+    post "/api/v1/registrations",
+         params: { user: { name: name, email: email, password: password } },
+         headers: { "X-Helpdesk-Account" => subdomain },
+         as: :json
+    assert_response :created
+    token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/verify-email")[:token]
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: token } },
+         headers: { "X-Helpdesk-Account" => subdomain },
+         as: :json
+    assert_response :success
+    json_response["user"]
+  end
+
+  def invite_and_accept(subdomain:, admin_token:, email:, role:, name:, password: "team-password")
+    post "/api/v1/invitations",
+         params: { invitation: { email: email, role: role } },
+         headers: auth_headers(subdomain, admin_token),
+         as: :json
+    assert_response :created
+    token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/accept-invitation")[:token]
+
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: token, name: name, password: password } },
+         headers: { "X-Helpdesk-Account" => subdomain },
+         as: :json
+    assert_response :created
+    json_response["user"]
+  end
+
+  def auth_headers(subdomain, token)
+    { "X-Helpdesk-Account" => subdomain, "Authorization" => "Bearer #{token}" }
+  end
+
+  def build_rfc822(from:, to:, subject:, body:, message_id:)
+    mail = Mail.new do
+      from from
+      to to
+      subject subject
+      message_id message_id
+      body body
+    end
+    mail.to_s
+  end
+
+  def post_raw_email(raw_email)
+    encoded = Base64.strict_encode64("actionmailbox:#{DEFAULT_INGRESS_PASSWORD}")
+    post RELAY_PATH,
+         params: raw_email,
+         headers: {
+           "CONTENT_TYPE" => "message/rfc822",
+           "HTTP_AUTHORIZATION" => "Basic #{encoded}"
+         }
+  end
+
+  test "staff merges duplicate ticket into surviving ticket with default private notes, preserving target state and filtering" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    agent = invite_and_accept(subdomain: "acme", admin_token: jo_token, email: "sam@acme.test", role: "agent", name: "Sam")
+    agent_token = sign_in(subdomain: "acme", email: "sam@acme.test", password: "team-password").dig("session", "token")
+
+    post "/api/v1/groups", params: { group: { name: "Support" } }, headers: auth_headers("acme", jo_token), as: :json
+    assert_response :created
+    support_group_id = json_response.dig("group", "id")
+
+    post "/api/v1/group_memberships",
+         params: { group_membership: { group_id: support_group_id, user_id: agent["id"], default: true } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :created
+
+    create_verified_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+
+    source_id = nil
+    target_id = nil
+    target_initial_updated_at = nil
+
+    travel_to Time.zone.parse("2026-11-15 10:00:00 UTC") do
+      post "/api/v1/requests",
+           params: { request: { subject: "Duplicate charge", comment: { body: "Original duplicate ticket body" } } },
+           headers: auth_headers("acme", avery_token),
+           as: :json
+      assert_response :created
+      source_id = json_response.dig("request", "id")
+      assert_nil json_response.dig("request", "merged_into_id")
+      assert json_response["request"].key?("merged_into_id")
+
+      travel 5.minutes
+      post "/api/v1/requests",
+           params: { request: { subject: "Billing question", comment: { body: "Main ticket body" } } },
+           headers: auth_headers("acme", avery_token),
+           as: :json
+      assert_response :created
+      target_id = json_response.dig("request", "id")
+
+      # Assign target ticket, put it in solved status, and verify unmerged pointer is null
+      patch "/api/v1/tickets/#{target_id}",
+            params: { ticket: { status: "solved", assignee_id: agent["id"], priority: "high" } },
+            headers: auth_headers("acme", agent_token),
+            as: :json
+      assert_response :success
+      assert_nil json_response.dig("ticket", "merged_into_id")
+      assert json_response["ticket"].key?("merged_into_id")
+      target_initial_updated_at = json_response.dig("ticket", "updated_at")
+    end
+
+    target_before = Ticket.find(target_id)
+    target_reply_token = target_before.reply_token
+
+    ActionMailer::Base.deliveries.clear
+
+    travel_to Time.zone.parse("2026-11-15 11:00:00 UTC") do
+      post "/api/v1/tickets/#{source_id}/merge",
+           params: { merge: { target_id: target_id } },
+           headers: auth_headers("acme", agent_token),
+           as: :json
+      assert_response :success
+    end
+
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    source_json = json_response["source"]
+    target_json = json_response["target"]
+    assert_equal source_id, source_json["id"]
+    assert_equal "closed", source_json["status"]
+    assert_equal target_id, source_json["merged_into_id"]
+
+    assert_equal target_id, target_json["id"]
+    assert_equal "solved", target_json["status"]
+    assert_equal agent["id"], target_json["assignee_id"]
+    assert_equal support_group_id, target_json["group_id"]
+    assert_equal "high", target_json["priority"]
+    assert_nil target_json["merged_into_id"]
+    assert_equal target_initial_updated_at, target_json["updated_at"]
+
+    # Surviving ticket email identity unchanged
+    target_after = Ticket.find(target_id)
+    assert_equal "portal", target_after.origin
+    assert_equal target_reply_token, target_after.reply_token
+
+    # Old comments remain on source; private merge notes added to both sides
+    get "/api/v1/tickets/#{source_id}/comments", headers: auth_headers("acme", agent_token)
+    assert_response :success
+    source_comments = json_response["comments"]
+    assert_equal 2, source_comments.size
+    assert_equal "Original duplicate ticket body", source_comments[0]["body"]
+    assert_equal true, source_comments[0]["public"]
+    assert_equal false, source_comments[1]["public"]
+    assert_includes source_comments[1]["body"], target_id.to_s
+    assert_equal agent["id"], source_comments[1].dig("author", "id")
+
+    get "/api/v1/tickets/#{target_id}/comments", headers: auth_headers("acme", agent_token)
+    assert_response :success
+    target_comments = json_response["comments"]
+    assert_equal 2, target_comments.size
+    assert_equal "Main ticket body", target_comments[0]["body"]
+    assert_equal false, target_comments[1]["public"]
+    assert_includes target_comments[1]["body"], source_id.to_s
+    assert_equal agent["id"], target_comments[1].dig("author", "id")
+
+    # Customer can still read closed source ticket and sees merged_into_id, but not private merge notes
+    get "/api/v1/requests/#{source_id}", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal "closed", json_response.dig("request", "status")
+    assert_equal target_id, json_response.dig("request", "merged_into_id")
+
+    get "/api/v1/requests/#{source_id}/comments", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal [ "Original duplicate ticket body" ], json_response["comments"].map { |c| c["body"] }
+
+    get "/api/v1/requests/#{target_id}/comments", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal [ "Main ticket body" ], json_response["comments"].map { |c| c["body"] }
+
+    # Both views can filter for closed tickets and include null on unmerged records
+    get "/api/v1/tickets?status=closed", headers: auth_headers("acme", agent_token)
+    assert_response :success
+    assert_equal [ source_id ], json_response["tickets"].map { |t| t["id"] }
+    assert_equal [ target_id ], json_response["tickets"].map { |t| t["merged_into_id"] }
+
+    get "/api/v1/requests?status=closed", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal [ source_id ], json_response["requests"].map { |r| r["id"] }
+    assert_equal [ target_id ], json_response["requests"].map { |r| r["merged_into_id"] }
+
+    get "/api/v1/requests?status=solved", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal [ target_id ], json_response["requests"].map { |r| r["id"] }
+    assert_equal [ nil ], json_response["requests"].map { |r| r["merged_into_id"] }
+  end
+
+  test "custom source and target merge notes support public or private visibility without sending email" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    acme = Account.find_by!(subdomain: "acme")
+    jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    # Create two email-origin tickets for the same customer
+    post_raw_email(build_rfc822(
+      from: "Avery <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Email issue 1",
+      body: "First email body",
+      message_id: "<merge-email-1@example.test>"
+    ))
+    assert_response :no_content
+
+    post_raw_email(build_rfc822(
+      from: "Avery <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Email issue 2",
+      body: "Second email body",
+      message_id: "<merge-email-2@example.test>"
+    ))
+    assert_response :no_content
+
+    source_ticket = acme.tickets.find_by!(subject: "Email issue 1")
+    target_ticket = acme.tickets.find_by!(subject: "Email issue 2")
+    avery = acme.users.find_by!(email: "avery@example.test")
+    avery.verify_email!
+    avery.update!(password: "my-customer-password")
+    avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+
+    ActionMailer::Base.deliveries.clear
+
+    # Merge with public source note and private target note
+    post "/api/v1/tickets/#{source_ticket.id}/merge",
+         params: {
+           merge: {
+             target_id: target_ticket.id,
+             source_comment: { body: "Continuing in ticket #{target_ticket.id}.", public: true },
+             target_comment: { body: "Duplicate checked.", public: false }
+           }
+         },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :success
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    # Customer sees public merge note on source, does not see private merge note on target
+    get "/api/v1/requests/#{source_ticket.id}/comments", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal [ "First email body", "Continuing in ticket #{target_ticket.id}." ], json_response["comments"].map { |c| c["body"] }
+
+    get "/api/v1/requests/#{target_ticket.id}/comments", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal [ "Second email body" ], json_response["comments"].map { |c| c["body"] }
+
+    # Staff sees private target note
+    get "/api/v1/tickets/#{target_ticket.id}/comments", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ "Second email body", "Duplicate checked." ], json_response["comments"].map { |c| c["body"] }
+    assert_equal [ true, false ], json_response["comments"].map { |c| c["public"] }
+
+    # Closed source ticket rejects incoming email replies
+    post_raw_email(build_rfc822(
+      from: "avery@example.test",
+      to: source_ticket.reply_address,
+      subject: "Re: Email issue 1",
+      body: "Replying to closed ticket",
+      message_id: "<reply-closed-source@example.test>"
+    ))
+    assert_response :no_content
+    assert_equal "bounced", ActionMailbox::InboundEmail.last.status
+    assert_equal "closed", source_ticket.reload.status
+    assert_equal 2, source_ticket.comments.count
+    assert_equal 2, target_ticket.comments.count
+
+    # Surviving target ticket still accepts incoming email replies and sends staff email replies
+    post_raw_email(build_rfc822(
+      from: "avery@example.test",
+      to: target_ticket.reply_address,
+      subject: "Re: Email issue 2",
+      body: "Replying to surviving ticket",
+      message_id: "<reply-open-target@example.test>"
+    ))
+    assert_response :no_content
+    assert_equal "delivered", ActionMailbox::InboundEmail.last.status
+    assert_equal 3, target_ticket.comments.count
+
+    patch "/api/v1/tickets/#{target_ticket.id}",
+          params: { ticket: { comment: { body: "Staff reply after merge", public: true } } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    assert_equal [ target_ticket.reply_address ], ActionMailer::Base.deliveries.last.reply_to
+  end
+
+  test "public target merge note touches target and omits sending email" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    acme = Account.find_by!(subdomain: "acme")
+    jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    post_raw_email(build_rfc822(
+      from: "avery@example.test",
+      to: "acme@support.example.test",
+      subject: "T1",
+      body: "Body 1",
+      message_id: "<pub-target-1@example.test>"
+    ))
+    post_raw_email(build_rfc822(
+      from: "avery@example.test",
+      to: "acme@support.example.test",
+      subject: "T2",
+      body: "Body 2",
+      message_id: "<pub-target-2@example.test>"
+    ))
+
+    t1 = acme.tickets.find_by!(subject: "T1")
+    t2 = acme.tickets.find_by!(subject: "T2")
+    avery = acme.users.find_by!(email: "avery@example.test")
+    avery.verify_email!
+    avery.update!(password: "my-customer-password")
+    avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+
+    t2_before_updated_at = t2.updated_at
+    ActionMailer::Base.deliveries.clear
+
+    travel 10.minutes do
