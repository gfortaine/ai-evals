+  test "chained merges preserve original merged_into_id links rather than rewriting history" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    create_verified_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+
+    ids = 3.times.map do |i|
+      post "/api/v1/requests",
+           params: { request: { subject: "Ticket #{i + 1}", comment: { body: "Body #{i + 1}" } } },
+           headers: auth_headers("acme", avery_token),
+           as: :json
+      assert_response :created
+      json_response.dig("request", "id")
+    end
+    t1_id, t2_id, t3_id = ids
+
+    # Merge T1 -> T2
+    post "/api/v1/tickets/#{t1_id}/merge",
+         params: { merge: { target_id: t2_id } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :success
+
+    # Later merge surviving T2 -> T3
+    post "/api/v1/tickets/#{t2_id}/merge",
+         params: { merge: { target_id: t3_id } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :success
+    assert_equal "closed", json_response.dig("source", "status")
+    assert_equal t3_id, json_response.dig("source", "merged_into_id")
+    assert_nil json_response.dig("target", "merged_into_id")
+
+    # T1 still points to T2 (not rewritten to T3)
+    get "/api/v1/tickets/#{t1_id}", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal "closed", json_response.dig("ticket", "status")
+    assert_equal t2_id, json_response.dig("ticket", "merged_into_id")
+
+    get "/api/v1/requests/#{t1_id}", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal t2_id, json_response.dig("request", "merged_into_id")
+  end
