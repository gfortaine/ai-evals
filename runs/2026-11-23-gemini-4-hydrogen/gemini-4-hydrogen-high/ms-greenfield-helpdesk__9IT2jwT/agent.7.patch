+    create_verified_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+
+    post "/api/v1/groups", params: { group: { name: "Billing" } }, headers: auth_headers("acme", jo_token), as: :json
+    billing_id = json_response.dig("group", "id")
+
+    post "/api/v1/group_memberships",
+         params: { group_membership: { group_id: billing_id, user_id: sam["id"], default: true } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    sam_membership_id = json_response.dig("group_membership", "id")
+
+    post "/api/v1/group_memberships",
+         params: { group_membership: { group_id: billing_id, user_id: alex["id"], default: true } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :created
+
+    t1, t2, t3 = 3.times.map do |i|
+      post "/api/v1/requests",
+           params: { request: { subject: "Cleanup #{i}", comment: { body: "Body #{i}" } } },
+           headers: auth_headers("acme", avery_token),
+           as: :json
+      json_response.dig("request", "id")
+    end
+
+    patch "/api/v1/tickets/#{t1}", params: { ticket: { group_id: billing_id, assignee_id: sam["id"] } }, headers: auth_headers("acme", jo_token), as: :json
+    assert_response :success
+    patch "/api/v1/tickets/#{t2}", params: { ticket: { group_id: billing_id, assignee_id: alex["id"] } }, headers: auth_headers("acme", jo_token), as: :json
+    assert_response :success
+
+    # Merge t1 -> t3 and t2 -> t3 so t1 and t2 are closed with group/assignee set
+    post "/api/v1/tickets/#{t1}/merge", params: { merge: { target_id: t3 } }, headers: auth_headers("acme", jo_token), as: :json
+    assert_response :success
+    post "/api/v1/tickets/#{t2}/merge", params: { merge: { target_id: t3 } }, headers: auth_headers("acme", jo_token), as: :json
+    assert_response :success
+
+    # 1. Remove Sam from Billing -> t1 assignee_id cleared, group_id kept
+    delete "/api/v1/group_memberships/#{sam_membership_id}", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_nil Ticket.find(t1).assignee_id
+    assert_equal billing_id, Ticket.find(t1).group_id
+
+    # 2. Suspend Alex -> t2 assignee_id cleared, group_id kept
+    patch "/api/v1/users/#{alex["id"]}",
+          params: { user: { suspended: true } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+    assert_nil Ticket.find(t2).assignee_id
+    assert_equal billing_id, Ticket.find(t2).group_id
+
+    # 3. Delete Billing group -> group_id cleared on closed t1 and t2
+    delete "/api/v1/groups/#{billing_id}", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_nil Ticket.find(t1).group_id
+    assert_nil Ticket.find(t2).group_id
+
+    # Account purge handles merged tickets without FK errors
+    acme.cancel!
+    acme.update!(cancelled_at: 91.days.ago)
+    assert_equal 1, Account.purge_expired!
+    assert_nil Ticket.find_by(id: t1)
+    assert_nil Ticket.find_by(id: t3)
+  end
