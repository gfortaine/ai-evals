+  test "navigation stays stable while other people work (create, update, bump, delete, tie-break)" do
+    acme = setup_acme
+    jo_token = acme[:token]
+    avery = register_customer(subdomain: "acme", name: "Avery", email: "avery@example.com")
+
+    base_time = Time.utc(2026, 11, 20, 10, 0, 0)
+    ids = (1..6).map do |i|
+      post "/api/v1/requests",
+           params: { request: { subject: "T#{i}", comment: { body: "B#{i}" } } },
+           headers: auth_headers("acme", avery[:token]),
+           as: :json
+      assert_response :created
+      tid = json_response.dig("request", "id")
+      # Set T3 and T4 to identical updated_at to verify id tie-breaker
+      ts = (i == 3 || i == 4) ? base_time + 3.minutes : base_time + i.minutes
+      Ticket.where(id: tid).update_all(updated_at: ts)
+      tid
+    end
+    # Order: [T6, T5, T4, T3, T2, T1]
+
+    # Fetch Page 1 (size 2): [T6, T5]
+    get "/api/v1/tickets?page[size]=2&status=open", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ ids[5], ids[4] ], json_response["tickets"].map { |t| t["id"] }
+    p1_next = json_response.dig("links", "next")
+
+    # Concurrent work while client reads Page 1:
+    # 1) Create T7 at the top
+    post "/api/v1/requests",
+         params: { request: { subject: "T7", comment: { body: "B7" } } },
+         headers: auth_headers("acme", avery[:token]),
+         as: :json
+    t7_id = json_response.dig("request", "id")
+    Ticket.where(id: t7_id).update_all(updated_at: base_time + 20.minutes)
+
+    # 2) Update T5 (the boundary cursor record!) so its updated_at jumps to the very top
+    patch "/api/v1/tickets/#{ids[4]}",
+          params: { ticket: { comment: { body: "Bump T5", public: true } } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+
+    # 3) Solve T2 (which is on Page 3), removing it from status=open
+    patch "/api/v1/tickets/#{ids[1]}",
+          params: { ticket: { status: "solved" } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+
+    # Follow Page 1's next link -> MUST yield [T4, T3] with zero duplicates and zero skipped items!
+    get p1_next, headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ ids[3], ids[2] ], json_response["tickets"].map { |t| t["id"] }
+    assert_equal true, json_response.dig("meta", "has_more")
+    p2_next = json_response.dig("links", "next")
+
+    # Also verify tie-breaking when size=1 across T4 and T3 (same updated_at)
+    get "/api/v1/tickets",
+        params: { page: { size: 1, after: json_response.dig("meta", "before_cursor") }, status: "open" },
+        headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ ids[2] ], json_response["tickets"].map { |t| t["id"] }
+
+    # Follow Page 2's next link -> T2 was solved, so only [T1] remains!
+    get p2_next, headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ ids[0] ], json_response["tickets"].map { |t| t["id"] }
+    assert_equal false, json_response.dig("meta", "has_more")
+    assert_nil json_response.dig("links", "next")
+
+    # Delete T4 (cursor boundary!) and navigate forward from T5's old cursor -> still starts cleanly at T3
+    Ticket.where(id: ids[3]).delete_all
+    get p1_next, headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ ids[2], ids[0] ], json_response["tickets"].map { |t| t["id"] }
+    assert_equal false, json_response.dig("meta", "has_more")
+
+    # If all preceding open tickets before T3 were closed, links.prev becomes nil accurately
+    Ticket.where(id: [ t7_id, ids[5], ids[4] ]).update_all(status: "closed")
+    get p1_next, headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ ids[2], ids[0] ], json_response["tickets"].map { |t| t["id"] }
+    assert_nil json_response.dig("links", "prev")
+  end
+
+  test "invalid cursor parameters and mismatched cursor types return 422 and cursor mode avoids count/offset" do
+    acme = setup_acme
+    jo_token = acme[:token]
+    avery = register_customer(subdomain: "acme", name: "Avery", email: "avery@example.com")
+
+    post "/api/v1/requests",
+         params: { request: { subject: "Ticket 1", comment: { body: "Body 1" } } },
+         headers: auth_headers("acme", avery[:token]),
+         as: :json
+    assert_response :created
+    tid = json_response.dig("request", "id")
+
+    get "/api/v1/tickets?page[size]=1", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    ticket_cursor = json_response.dig("meta", "after_cursor")
+
+    get "/api/v1/users?page[size]=1", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    user_cursor = json_response.dig("meta", "after_cursor")
+
+    get "/api/v1/tickets/#{tid}/comments?page[size]=1", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    comment_cursor = json_response.dig("meta", "after_cursor")
+
+    # Invalid inputs -> 422
+    [
+      "/api/v1/tickets?page[size]=0",
+      "/api/v1/tickets?page[size]=-5",
+      "/api/v1/tickets?page[size]=abc",
+      "/api/v1/tickets?page[after]=not-base64!",
+      "/api/v1/tickets?page[before]=#{Base64.urlsafe_encode64("{}", padding: false)}",
+      "/api/v1/tickets?page[after]=#{ticket_cursor}&page[before]=#{ticket_cursor}",
+      "/api/v1/tickets?page[after]=#{user_cursor}",
+      "/api/v1/tickets?page[after]=#{comment_cursor}",
+      "/api/v1/users?page[after]=#{ticket_cursor}",
+      "/api/v1/tickets/#{tid}/comments?page[after]=#{ticket_cursor}",
+      "/api/v1/tickets?page[number]=2"
+    ].each do |bad_url|
+      get bad_url, headers: auth_headers("acme", jo_token)
+      assert_response :unprocessable_entity, "Expected 422 for #{bad_url}"
+      assert_not_nil json_response["error"]
+    end
+
+    # Default size without page[size] works and page[size] > 100 clamps to 100
+    get "/api/v1/tickets?page[after]=#{ticket_cursor}", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [], json_response["tickets"]
+
+    get "/api/v1/tickets?page[size]=500", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal 1, json_response["tickets"].size
+
+    # Verify SQL queries in cursor mode do not use COUNT(*) or OFFSET
+    queries = []
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |_name, _start, _finish, _id, payload|
+      queries << payload[:sql] unless payload[:name] == "SCHEMA"
+    end
+    begin
+      get "/api/v1/tickets?page[size]=2&page[after]=#{ticket_cursor}", headers: auth_headers("acme", jo_token)
+      assert_response :success
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+
+    ticket_queries = queries.select { |q| q.include?("FROM \"tickets\"") }
+    assert_not_empty ticket_queries
+    ticket_queries.each do |sql|
+      assert_no_match(/COUNT\(/i, sql, "Cursor pagination must not run COUNT(*): #{sql}")
+      assert_no_match(/\bOFFSET\b/i, sql, "Cursor pagination must not use OFFSET: #{sql}")
+    end
+  end
+end
