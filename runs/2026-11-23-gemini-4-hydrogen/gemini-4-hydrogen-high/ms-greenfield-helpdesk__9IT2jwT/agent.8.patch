+require "test_helper"
+require "base64"
+require "json"
+
+class CursorPaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def auth_headers(subdomain, token)
+    {
+      "X-Helpdesk-Account" => subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+
+  def setup_acme
+    res = create_and_verify_account
+    jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    { user: res["user"], token: jo_token }
+  end
+
+  def invite_and_accept(subdomain:, admin_token:, email:, role:, name:, password: "staff-password-1")
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/invitations",
+         params: { invitation: { email: email, role: role } },
+         headers: auth_headers(subdomain, admin_token),
+         as: :json
+    assert_response :created
+    invite_id = json_response.dig("invitation", "id")
+
+    token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/accept-invitation")[:token]
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: token, name: name, password: password } },
+         headers: { "X-Helpdesk-Account" => subdomain },
+         as: :json
+    assert_response :created
+    user = json_response["user"]
+    session_token = json_response.dig("session", "token") ||
+      sign_in(subdomain: subdomain, email: email, password: password).dig("session", "token")
+    { user: user, token: session_token, invitation_id: invite_id }
+  end
+
+  def register_customer(subdomain:, name:, email:, password: "cust-password-1")
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/registrations",
+         params: { user: { name: name, email: email, password: password } },
+         headers: { "X-Helpdesk-Account" => subdomain },
+         as: :json
+    assert_response :created
+    verify_token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/verify-email")[:token]
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: verify_token } },
+         headers: { "X-Helpdesk-Account" => subdomain },
+         as: :json
+    assert_response :success
+    user = json_response["user"]
+    session_token = sign_in(subdomain: subdomain, email: email, password: password).dig("session", "token")
+    { user: user, token: session_token }
+  end
+
+  test "empty collection cursor response matches exact specification and page-number API remains intact" do
+    acme = setup_acme
+    jo_token = acme[:token]
+
+    # Cursor response on empty tickets
+    get "/api/v1/tickets?page[size]=25&status=open", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal(
+      {
+        "tickets" => [],
+        "meta" => {
+          "has_more" => false,
+          "after_cursor" => nil,
+          "before_cursor" => nil
+        },
+        "links" => {
+          "next" => nil,
+          "prev" => nil
+        }
+      },
+      json_response
+    )
+
+    # Empty invitations cursor response
+    get "/api/v1/invitations?page[size]=10", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal(
+      {
+        "invitations" => [],
+        "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+        "links" => { "next" => nil, "prev" => nil }
+      },
+      json_response
+    )
+
+    # Existing page-number API still returns count/page/per_page/next_page/previous_page
+    get "/api/v1/tickets", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [], json_response["tickets"]
+    assert_equal 0, json_response["count"]
+    assert_equal 1, json_response["page"]
+    assert_equal 25, json_response["per_page"]
+    assert_nil json_response["next_page"]
+    assert_nil json_response["previous_page"]
+    assert_not json_response.key?("meta")
+    assert_not json_response.key?("links")
+  end
+
+  test "forward and backward cursor navigation on tickets and requests with filters" do
+    acme = setup_acme
+    jo_token = acme[:token]
+    jo_id = acme.dig(:user, "id")
+
+    avery = register_customer(subdomain: "acme", name: "Avery", email: "avery@example.com")
+    avery_token = avery[:token]
+
+    # Create 5 open tickets and 1 solved ticket
+    ticket_ids = []
+    base_time = Time.utc(2026, 11, 20, 12, 0, 0)
+    5.times do |i|
+      post "/api/v1/requests",
+           params: { request: { subject: "Open ticket #{i + 1}", comment: { body: "Receipt body #{i + 1}" } } },
+           headers: auth_headers("acme", avery_token),
+           as: :json
+      assert_response :created
+      tid = json_response.dig("request", "id")
+      Ticket.where(id: tid).update_all(updated_at: base_time + (i + 1).minutes)
+      ticket_ids << tid
+    end
+
+    # Extra solved ticket (newest) that should be excluded when filtering status=open
+    post "/api/v1/requests",
+         params: { request: { subject: "Solved ticket", comment: { body: "Receipt solved" } } },
+         headers: auth_headers("acme", avery_token),
+         as: :json
+    solved_id = json_response.dig("request", "id")
+    patch "/api/v1/tickets/#{solved_id}",
+          params: { ticket: { status: "solved", assignee_id: jo_id } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+    Ticket.where(id: solved_id).update_all(updated_at: base_time + 10.minutes)
+
+    # Recently active first for status=open: [5, 4, 3, 2, 1]
+    expected_ids = ticket_ids.reverse
+
+    # Page 1: [5, 4]
+    get "/api/v1/tickets?page[size]=2&status=open&q=Receipt", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal expected_ids[0..1], json_response["tickets"].map { |t| t["id"] }
+    assert_equal true, json_response.dig("meta", "has_more")
+    assert_not_nil json_response.dig("meta", "after_cursor")
+    assert_not_nil json_response.dig("meta", "before_cursor")
+    assert_not_nil json_response.dig("links", "next")
+    assert_nil json_response.dig("links", "prev")
+    assert_not json_response.key?("count")
+
+    p1_after = json_response.dig("meta", "after_cursor")
+    next_link_1 = json_response.dig("links", "next")
+    parsed_next_1 = Rack::Utils.parse_nested_query(URI.parse(next_link_1).query)
+    assert_equal "open", parsed_next_1["status"]
+    assert_equal "Receipt", parsed_next_1["q"]
+    assert_equal "2", parsed_next_1.dig("page", "size")
+    assert_equal p1_after, parsed_next_1.dig("page", "after")
+    assert_nil parsed_next_1.dig("page", "before")
+
+    # Follow links.next -> Page 2: [3, 2]
+    get next_link_1, headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal expected_ids[2..3], json_response["tickets"].map { |t| t["id"] }
+    assert_equal true, json_response.dig("meta", "has_more")
+    assert_not_nil json_response.dig("links", "next")
+    assert_not_nil json_response.dig("links", "prev")
+    p2_next = json_response.dig("links", "next")
+
+    # Follow links.next -> Page 3: [1]
+    get p2_next, headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ expected_ids[4] ], json_response["tickets"].map { |t| t["id"] }
+    assert_equal false, json_response.dig("meta", "has_more")
+    assert_equal json_response.dig("meta", "after_cursor"), json_response.dig("meta", "before_cursor")
+    assert_nil json_response.dig("links", "next")
+    assert_not_nil json_response.dig("links", "prev")
+    p3_prev = json_response.dig("links", "prev")
+
+    # Follow links.prev from Page 3 -> back to Page 2: [3, 2], has_more=true (more before [3,2])
+    get p3_prev, headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal expected_ids[2..3], json_response["tickets"].map { |t| t["id"] }
+    assert_equal true, json_response.dig("meta", "has_more")
+    assert_not_nil json_response.dig("links", "next")
+    assert_not_nil json_response.dig("links", "prev")
+    p2_prev = json_response.dig("links", "prev")
+
+    # Follow links.prev from Page 2 -> back to Page 1: [5, 4], has_more=false (no more before [5,4])
+    get p2_prev, headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal expected_ids[0..1], json_response["tickets"].map { |t| t["id"] }
+    assert_equal false, json_response.dig("meta", "has_more")
+    assert_not_nil json_response.dig("links", "next")
+    assert_nil json_response.dig("links", "prev")
+
+    # Customer requests collection with cursor & status filter
+    get "/api/v1/requests?page[size]=2&status=open", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal expected_ids[0..1], json_response["requests"].map { |r| r["id"] }
+    assert_equal true, json_response.dig("meta", "has_more")
+
+    get json_response.dig("links", "next"), headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal expected_ids[2..3], json_response["requests"].map { |r| r["id"] }
+
+    # Manual page[after] past the end returns empty populated=false response
+    get "/api/v1/tickets?page[size]=10", headers: auth_headers("acme", jo_token)
+    last_after = json_response.dig("meta", "after_cursor")
+    get "/api/v1/tickets", params: { page: { after: last_after, size: 2 } }, headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [], json_response["tickets"]
+    assert_equal false, json_response.dig("meta", "has_more")
+    assert_nil json_response.dig("meta", "after_cursor")
+    assert_nil json_response.dig("meta", "before_cursor")
+    assert_nil json_response.dig("links", "next")
+    assert_nil json_response.dig("links", "prev")
+  end
+
+  test "cursor pagination works on all remaining collections (comments, users, staff, invitations, groups, group_memberships)" do
+    acme = setup_acme
+    jo_token = acme[:token]
+    jo_id = acme.dig(:user, "id")
+
+    sam = invite_and_accept(subdomain: "acme", admin_token: jo_token, email: "sam@acme.test", role: "agent", name: "Sam")
+    pat = invite_and_accept(subdomain: "acme", admin_token: jo_token, email: "pat@acme.test", role: "agent", name: "Pat")
+    avery = register_customer(subdomain: "acme", name: "Avery", email: "avery@example.com")
+
+    # Extra pending invitations so invitations has 4 records total
+    post "/api/v1/invitations",
+         params: { invitation: { email: "pending1@acme.test", role: "agent" } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :created
+    post "/api/v1/invitations",
+         params: { invitation: { email: "pending2@acme.test", role: "admin" } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :created
+
+    # 1. Users (4 users: Jo, Sam, Pat, Avery)
+    get "/api/v1/users?page[size]=2", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ jo_id, sam[:user]["id"] ], json_response["users"].map { |u| u["id"] }
+    assert_equal true, json_response.dig("meta", "has_more")
+    get json_response.dig("links", "next"), headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ pat[:user]["id"], avery[:user]["id"] ], json_response["users"].map { |u| u["id"] }
+    assert_equal false, json_response.dig("meta", "has_more")
+    get json_response.dig("links", "prev"), headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ jo_id, sam[:user]["id"] ], json_response["users"].map { |u| u["id"] }
+    assert_equal false, json_response.dig("meta", "has_more")
+
+    # 2. Staff (3 staff: Jo, Sam, Pat)
+    get "/api/v1/staff?page[size]=2", headers: auth_headers("acme", sam[:token])
+    assert_response :success
+    assert_equal [ jo_id, sam[:user]["id"] ], json_response["staff"].map { |u| u["id"] }
+    assert_equal true, json_response.dig("meta", "has_more")
+    get json_response.dig("links", "next"), headers: auth_headers("acme", sam[:token])
+    assert_response :success
+    assert_equal [ pat[:user]["id"] ], json_response["staff"].map { |u| u["id"] }
+    assert_equal false, json_response.dig("meta", "has_more")
+
+    # 3. Invitations (4 total; 2 pending)
+    get "/api/v1/invitations?page[size]=2&status=pending", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal 2, json_response["invitations"].size
+    assert_equal false, json_response.dig("meta", "has_more")
+    assert_nil json_response.dig("links", "next")
+
+    get "/api/v1/invitations?page[size]=2", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal 2, json_response["invitations"].size
+    assert_equal true, json_response.dig("meta", "has_more")
+    get json_response.dig("links", "next"), headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal 2, json_response["invitations"].size
+    assert_equal false, json_response.dig("meta", "has_more")
+
+    # 4. Groups (3 groups)
+    group_ids = %w[Billing Sales Support].map do |gname|
+      post "/api/v1/groups", params: { group: { name: gname } }, headers: auth_headers("acme", jo_token), as: :json
+      assert_response :created
+      json_response.dig("group", "id")
+    end
+    get "/api/v1/groups?page[size]=2", headers: auth_headers("acme", jo_token)
+    assert_response :success
