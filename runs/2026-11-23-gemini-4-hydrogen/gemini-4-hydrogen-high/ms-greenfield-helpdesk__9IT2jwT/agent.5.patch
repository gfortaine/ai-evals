index 0000000..4dfe9c9
--- /dev/null
+++ b/test/integration/email_support_test.rb
@@ -0,0 +1,652 @@
+require "test_helper"
+
+class EmailSupportTest < ActionDispatch::IntegrationTest
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails".freeze
+  DEFAULT_INGRESS_PASSWORD = "test-inbound-secret".freeze
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @original_inbound_password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"]
+    @original_support_domain = ENV["HELPDESK_SUPPORT_DOMAIN"]
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = DEFAULT_INGRESS_PASSWORD
+    ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+  end
+
+  teardown do
+    if @original_inbound_password.nil?
+      ENV.delete("RAILS_INBOUND_EMAIL_PASSWORD")
+    else
+      ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @original_inbound_password
+    end
+
+    if @original_support_domain.nil?
+      ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+    else
+      ENV["HELPDESK_SUPPORT_DOMAIN"] = @original_support_domain
+    end
+  end
+
+  def auth_headers(subdomain, token)
+    { "X-Helpdesk-Account" => subdomain, "Authorization" => "Bearer #{token}" }
+  end
+
+  def relay_headers(password: DEFAULT_INGRESS_PASSWORD, content_type: "message/rfc822")
+    headers = { "CONTENT_TYPE" => content_type }
+    if password
+      encoded = Base64.strict_encode64("actionmailbox:#{password}")
+      headers["HTTP_AUTHORIZATION"] = "Basic #{encoded}"
+    end
+    headers
+  end
+
+  def post_raw_email(raw_rfc822, password: DEFAULT_INGRESS_PASSWORD, content_type: "message/rfc822")
+    post RELAY_PATH, params: raw_rfc822, headers: relay_headers(password: password, content_type: content_type)
+  end
+
+  def build_rfc822(from:, to:, subject:, body:, cc: nil, message_id: nil, headers: {})
+    mail = Mail.new
+    mail.from = from if from
+    mail.to = to if to
+    mail.cc = cc if cc
+    mail.subject = subject if subject
+    mail.message_id = message_id if message_id
+    mail.body = body if body
+    headers.each { |k, v| mail.header[k] = v }
+    mail.to_s
+  end
+
+  test "relay ingress requires HTTP basic auth with RAILS_INBOUND_EMAIL_PASSWORD and message/rfc822" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    raw = build_rfc822(
+      from: "alice@example.test",
+      to: "acme@support.example.test",
+      subject: "Auth check",
+      body: "Testing auth",
+      message_id: "<auth-1@example.test>"
+    )
+
+    post_raw_email(raw, password: nil)
+    assert_response :unauthorized
+
+    post_raw_email(raw, password: "wrong-password")
+    assert_response :unauthorized
+
+    post_raw_email(raw, content_type: "application/json")
+    assert_response :unsupported_media_type
+
+    assert_equal 0, Ticket.count
+
+    post_raw_email(raw)
+    assert_response :no_content
+    assert_equal 1, Ticket.count
+  end
+
+  test "incoming email opens ticket, creates unverified customer with verification email, and allows later portal login after verification" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    acme = Account.find_by!(subdomain: "acme")
+    ActionMailer::Base.deliveries.clear
+
+    raw = build_rfc822(
+      from: "Alice Customer <alice@customer.test>",
+      to: "acme@support.example.test",
+      subject: "Cannot export invoice",
+      body: "When I click export, nothing downloads.",
+      message_id: "<open-1@customer.test>"
+    )
+
+    post_raw_email(raw)
+    assert_response :no_content
+
+    ticket = acme.tickets.last
+    assert_not_nil ticket
+    assert_equal "Cannot export invoice", ticket.subject
+    assert_equal "open", ticket.status
+    assert_equal "email", ticket.origin
+
+    requester = ticket.requester
+    assert_equal "alice@customer.test", requester.email
+    assert_equal "Alice Customer", requester.name
+    assert_equal "customer", requester.role
+    assert_not requester.verified?
+
+    assert_equal 1, ticket.comments.count
+    comment = ticket.comments.first
