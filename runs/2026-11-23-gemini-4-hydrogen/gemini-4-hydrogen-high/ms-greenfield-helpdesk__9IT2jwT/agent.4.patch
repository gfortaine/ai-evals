+++ b/test/integration/ticket_priority_and_filtering_test.rb
@@ -0,0 +1,402 @@
+require "test_helper"
+
+class TicketPriorityAndFilteringTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def create_verified_customer(subdomain:, name:, email:, password: "my-customer-password")
+    post "/api/v1/registrations",
+         params: { user: { name: name, email: email, password: password } },
+         headers: { "X-Helpdesk-Account" => subdomain },
+         as: :json
+    assert_response :created
+    token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/verify-email")[:token]
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: token } },
+         headers: { "X-Helpdesk-Account" => subdomain },
+         as: :json
+    assert_response :success
+    json_response["user"]
+  end
+
+  def auth_headers(subdomain, token)
+    { "X-Helpdesk-Account" => subdomain, "Authorization" => "Bearer #{token}" }
+  end
+
+  test "ticket priority defaults to normal, is internal, and can be updated by staff without bumping customer activity" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    acme = Account.find_by!(subdomain: "acme")
+    agent = acme.users.create!(
+      name: "Sam Agent",
+      email: "sam@acme.test",
+      password: "agent-password",
+      role: "agent",
+      verified_at: Time.current
+    )
+
+    avery = create_verified_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+    jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    agent_token = sign_in(subdomain: "acme", email: "sam@acme.test", password: "agent-password").dig("session", "token")
+
+    ticket1_id = nil
+    ticket2_id = nil
+
+    travel_to Time.zone.parse("2026-11-10 10:00:00 UTC") do
+      # Customer attempts to send priority on request creation; ignored and defaults to normal
+      post "/api/v1/requests",
+           params: { request: { subject: "First issue", priority: "high", comment: { body: "Help please" } } },
+           headers: auth_headers("acme", avery_token),
+           as: :json
+      assert_response :created
+      assert_not json_response["request"].key?("priority")
+      ticket1_id = json_response.dig("request", "id")
+
+      travel 5.minutes
+      post "/api/v1/requests",
+           params: { request: { subject: "Second issue", comment: { body: "Another one" } } },
+           headers: auth_headers("acme", avery_token),
+           as: :json
+      assert_response :created
+      ticket2_id = json_response.dig("request", "id")
+    end
+
+    get "/api/v1/requests/#{ticket1_id}", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    initial_request_json = json_response["request"]
+    assert_not initial_request_json.key?("priority")
+
+    # Staff sees default priority "normal" in list and show
+    get "/api/v1/tickets", headers: auth_headers("acme", agent_token)
+    assert_response :success
+    assert_equal %w[normal normal], json_response["tickets"].map { |t| t["priority"] }
+
+    get "/api/v1/tickets/#{ticket1_id}", headers: auth_headers("acme", agent_token)
+    assert_response :success
+    assert_equal "normal", json_response.dig("ticket", "priority")
+
+    # Customer cannot update priority on tickets or requests
+    patch "/api/v1/tickets/#{ticket1_id}",
+          params: { ticket: { priority: "high" } },
+          headers: auth_headers("acme", avery_token),
+          as: :json
+    assert_response :forbidden
+
+    patch "/api/v1/requests/#{ticket1_id}",
+          params: { request: { priority: "high", comment: { body: "Bump" } } },
+          headers: auth_headers("acme", avery_token),
+          as: :json
+    assert_response :success
+    assert_not json_response["request"].key?("priority")
+
+    get "/api/v1/tickets/#{ticket1_id}", headers: auth_headers("acme", agent_token)
+    assert_response :success
+    assert_equal "normal", json_response.dig("ticket", "priority")
+
+    # Invalid priority updates rejected
+    [ "urgent", "low", "", nil ].each do |bad_priority|
+      patch "/api/v1/tickets/#{ticket1_id}",
+            params: { ticket: { priority: bad_priority } },
+            headers: auth_headers("acme", agent_token),
+            as: :json
+      assert_response :unprocessable_entity
+    end
+
+    # Capture current request JSON and ordering before internal priority change
+    get "/api/v1/requests/#{ticket2_id}", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    ticket2_request_before = json_response["request"]
+
+    get "/api/v1/requests/#{ticket1_id}", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    ticket1_request_before = json_response["request"]
+
+    get "/api/v1/requests", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal [ ticket1_id, ticket2_id ], json_response["requests"].map { |r| r["id"] }
+
+    # Staff sets ticket2 priority to high (without status change or public comment) -> does not bump updated_at
+    travel_to Time.zone.parse("2026-11-10 12:00:00 UTC") do
+      patch "/api/v1/tickets/#{ticket2_id}",
+            params: { ticket: { priority: "high" } },
+            headers: auth_headers("acme", agent_token),
+            as: :json
+      assert_response :success
+      assert_equal "high", json_response.dig("ticket", "priority")
+
+      # Changing priority + assignee + private note also does not bump updated_at
+      patch "/api/v1/tickets/#{ticket2_id}",
+            params: {
+              ticket: {
+                priority: "normal",
+                assignee_id: agent.id,
+                comment: { body: "Internal triage note", public: false }
+              }
+            },
+            headers: auth_headers("acme", jo_token),
+            as: :json
+      assert_response :success
+      assert_equal "normal", json_response.dig("ticket", "priority")
+      assert_equal agent.id, json_response.dig("ticket", "assignee_id")
+
+      # Set back to high for verification
+      patch "/api/v1/tickets/#{ticket2_id}",
+            params: { ticket: { priority: "high" } },
+            headers: auth_headers("acme", jo_token),
+            as: :json
+      assert_response :success
+      assert_equal "high", json_response.dig("ticket", "priority")
+    end
+
+    # Customer-facing request and order did NOT change
+    get "/api/v1/requests/#{ticket2_id}", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal ticket2_request_before, json_response["request"]
+
+    get "/api/v1/requests/#{ticket1_id}", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal ticket1_request_before, json_response["request"]
+
+    get "/api/v1/requests", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal [ ticket1_id, ticket2_id ], json_response["requests"].map { |r| r["id"] }
+  end
+
+  test "staff can combine status, assignee_id, requester_id, priority, and literal search q filters; customers can filter requests by status only" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    create_and_verify_account(name: "Globex", subdomain: "globex", admin_name: "Gabe", email: "gabe@globex.test")
+
+    acme = Account.find_by!(subdomain: "acme")
+    sam = acme.users.create!(
+      name: "Sam Agent",
+      email: "sam@acme.test",
+      password: "agent-password",
+      role: "agent",
+      verified_at: Time.current
+    )
+    jo = acme.users.find_by!(email: "jo@acme.test")
+
+    avery = create_verified_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    blake = create_verified_customer(subdomain: "acme", name: "Blake", email: "blake@example.test")
+    globex_cust = create_verified_customer(subdomain: "globex", name: "G Cust", email: "gcust@example.test")
+
+    jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    sam_token = sign_in(subdomain: "acme", email: "sam@acme.test", password: "agent-password").dig("session", "token")
+    avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+    blake_token = sign_in(subdomain: "acme", email: "blake@example.test", password: "my-customer-password").dig("session", "token")
+    globex_cust_token = sign_in(subdomain: "globex", email: "gcust@example.test", password: "my-customer-password").dig("session", "token")
+
+    t1 = t2 = t3 = t4 = t5 = t6 = nil
+
+    travel_to Time.zone.parse("2026-11-11 09:00:00 UTC") do
+      # t1: open, unassigned, high, subject contains "Receipt" (Avery)
+      post "/api/v1/requests",
+           params: { request: { subject: "Missing Receipt for April", comment: { body: "Please send PDF." } } },
+           headers: auth_headers("acme", avery_token),
+           as: :json
+      assert_response :created
+      t1 = json_response.dig("request", "id")
+
+      travel 1.minute
+      # t2: open, unassigned, high, subject unrelated, PUBLIC comments contain "receipt" twice (Blake)
+      post "/api/v1/requests",
+           params: { request: { subject: "Billing question", comment: { body: "I lost my RECEIPT yesterday." } } },
+           headers: auth_headers("acme", blake_token),
+           as: :json
+      assert_response :created
+      t2 = json_response.dig("request", "id")
+
+      travel 1.minute
+      # t3: open, assigned to Sam, high, subject contains "receipt" (Avery)
+      post "/api/v1/requests",
+           params: { request: { subject: "Duplicate receipt charge", comment: { body: "Charged twice." } } },
+           headers: auth_headers("acme", avery_token),
+           as: :json
+      assert_response :created
+      t3 = json_response.dig("request", "id")
+
+      travel 1.minute
+      # t4: open, unassigned, normal, subject contains "receipt" (Avery)
+      post "/api/v1/requests",
+           params: { request: { subject: "100% receipt_id\\check", comment: { body: "Special chars test." } } },
+           headers: auth_headers("acme", avery_token),
+           as: :json
+      assert_response :created
+      t4 = json_response.dig("request", "id")
+
+      travel 1.minute
+      # t5: pending, unassigned, high, ONLY PRIVATE comment contains "receipt" (Blake)
+      post "/api/v1/requests",
+           params: { request: { subject: "Account access issue", comment: { body: "Cannot sign in." } } },
+           headers: auth_headers("acme", blake_token),
+           as: :json
+      assert_response :created
+      t5 = json_response.dig("request", "id")
+
+      travel 1.minute
+      # t6: solved, assigned to Jo, normal, body has "1000 receiptXidYcheck" to test literal % and _ and \ (Avery)
+      post "/api/v1/requests",
+           params: { request: { subject: "1000 receiptXidYcheck", comment: { body: "All good." } } },
+           headers: auth_headers("acme", avery_token),
+           as: :json
+      assert_response :created
+      t6 = json_response.dig("request", "id")
+
+      # Globex ticket with "receipt" must never appear in Acme search
+      post "/api/v1/requests",
+           params: { request: { subject: "Globex receipt", comment: { body: "Cross-tenant check" } } },
+           headers: auth_headers("globex", globex_cust_token),
+           as: :json
+      assert_response :created
+    end
+
+    # Second public comment matching "receipt" on t2 (verify no duplicate row in results/count)
+    patch "/api/v1/tickets/#{t2}",
+          params: { ticket: { priority: "high", comment: { body: "Re-sending your receipt now." } } },
+          headers: auth_headers("acme", sam_token),
+          as: :json
+    assert_response :success
+
+    patch "/api/v1/tickets/#{t1}",
+          params: { ticket: { priority: "high" } },
+          headers: auth_headers("acme", sam_token),
+          as: :json
+    assert_response :success
+
+    patch "/api/v1/tickets/#{t3}",
+          params: { ticket: { priority: "high", assignee_id: sam.id } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+
+    patch "/api/v1/tickets/#{t5}",
+          params: {
+            ticket: {
+              status: "pending",
+              priority: "high",
+              comment: { body: "Internal note: customer actually wants a receipt", public: false }
+            }
+          },
+          headers: auth_headers("acme", sam_token),
+          as: :json
+    assert_response :success
+
+    patch "/api/v1/tickets/#{t6}",
+          params: { ticket: { status: "solved", assignee_id: jo.id } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+
+    # Combined filter from prompt example: status=open&assignee_id=unassigned&priority=high&q=receipt
+    get "/api/v1/tickets?status=open&assignee_id=unassigned&priority=high&q=receipt",
+        headers: auth_headers("acme", sam_token)
+    assert_response :success
+    assert_equal 2, json_response["count"]
+    assert_equal [ t2, t1 ], json_response["tickets"].map { |t| t["id"] }
+
+    # Adding requester_id narrows down to Avery only
+    get "/api/v1/tickets?status=open&assignee_id=unassigned&priority=high&q=receipt&requester_id=#{avery["id"]}",
+        headers: auth_headers("acme", sam_token)
+    assert_response :success
+    assert_equal 1, json_response["count"]
+    assert_equal [ t1 ], json_response["tickets"].map { |t| t["id"] }
+
+    # Private comments are NOT searched by q
+    get "/api/v1/tickets?q=receipt", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    returned_ids = json_response["tickets"].map { |t| t["id"] }
+    assert_not_includes returned_ids, t5
+    assert_equal 5, json_response["count"]
+    assert_equal [ t6, t2, t4, t3, t1 ], returned_ids
+
+    # Literal search: %, _, and \ are treated as literal characters, not SQL wildcards
+    get "/api/v1/tickets", params: { q: "100%" }, headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ t4 ], json_response["tickets"].map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { q: "receipt_id\\check" }, headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ t4 ], json_response["tickets"].map { |t| t["id"] }
+
+    # Individual filters
+    get "/api/v1/tickets?assignee_id=#{sam.id}", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ t3 ], json_response["tickets"].map { |t| t["id"] }
+
+    get "/api/v1/tickets?status=pending", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ t5 ], json_response["tickets"].map { |t| t["id"] }
+
+    get "/api/v1/tickets?status=solved&assignee_id=#{jo.id}", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ t6 ], json_response["tickets"].map { |t| t["id"] }
+
+    get "/api/v1/tickets?requester_id=#{blake["id"]}", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ t5, t2 ], json_response["tickets"].map { |t| t["id"] }
+
+    # Cross-account requester_id or assignee_id yields empty list
+    get "/api/v1/tickets?requester_id=#{globex_cust["id"]}", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [], json_response["tickets"]
+    assert_equal 0, json_response["count"]
+
+    # Blank q returns all account tickets
+    get "/api/v1/tickets?q=%20%20", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal 6, json_response["count"]
+
+    # Pagination with filters
+    get "/api/v1/tickets?requester_id=#{avery["id"]}&page=2&per_page=2", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal 4, json_response["count"]
+    assert_equal 2, json_response["page"]
+    assert_equal 2, json_response["per_page"]
+    assert_nil json_response["next_page"]
+    assert_equal 1, json_response["previous_page"]
+    assert_equal [ t3, t1 ], json_response["tickets"].map { |t| t["id"] }
+
+    # Invalid staff filters return 422
+    [
+      "/api/v1/tickets?status=closed",
+      "/api/v1/tickets?priority=urgent",
+      "/api/v1/tickets?assignee_id=nobody",
+      "/api/v1/tickets?assignee_id=0",
+      "/api/v1/tickets?assignee_id=-5",
+      "/api/v1/tickets?requester_id=unassigned",
+      "/api/v1/tickets?requester_id=abc",
+      "/api/v1/tickets?requester_id=0"
+    ].each do |bad_url|
+      get bad_url, headers: auth_headers("acme", jo_token)
+      assert_response :unprocessable_entity, "Expected 422 for #{bad_url}"
+    end
+
+    # Customer can filter own requests by status
+    get "/api/v1/requests?status=open", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal [ t4, t3, t1 ], json_response["requests"].map { |r| r["id"] }
+    assert_equal 3, json_response["count"]
+
+    get "/api/v1/requests?status=solved", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal [ t6 ], json_response["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests?status=pending", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal [], json_response["requests"]
+
+    # Customer invalid status returns 422
+    get "/api/v1/requests?status=bogus", headers: auth_headers("acme", avery_token)
+    assert_response :unprocessable_entity
+
+    # Priority filter is ignored on customer requests (cannot probe internal priority)
+    get "/api/v1/requests?priority=high", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal 4, json_response["count"]
+    json_response["requests"].each do |req|
+      assert_not req.key?("priority")
+    end
+  end
+end
