+      # Invalid status filter returns 422
+      get "/api/v1/invitations?status=bogus", headers: auth_headers("acme", jo_token)
+      assert_response :unprocessable_entity
+
+      # Can invite expired email again without competing invite error
+      post "/api/v1/invitations",
+           params: { invitation: { email: "four@example.test", role: "admin" } },
+           headers: auth_headers("acme", jo_token),
+           as: :json
+      assert_response :created
+      assert_equal "pending", json_response.dig("invitation", "status")
+    end
+  end
+end
diff --git a/test/integration/users_suspension_and_assignment_test.rb b/test/integration/users_suspension_and_assignment_test.rb
