diff --git a/app/models/invitation.rb b/app/models/invitation.rb
new file mode 100644
index 0000000..aac8668
--- /dev/null
+++ b/app/models/invitation.rb
@@ -0,0 +1,196 @@
+require "digest"
+
+class Invitation < ApplicationRecord
+  ROLES = %w[admin agent].freeze
+  STATUSES = %w[pending accepted revoked expired].freeze
+  EXPIRY = 7.days
+
+  belongs_to :account
+  belongs_to :invited_by, class_name: "User", optional: true
+
+  normalizes :email, with: ->(e) { e.to_s.strip.downcase }
+
+  validates :email, presence: true, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :role, presence: true, inclusion: { in: ROLES }
+  validates :expires_at, presence: true
+  validates :token_digest, uniqueness: { scope: :account_id }, allow_nil: true
+  validate :email_not_already_registered, on: :create
+  validate :no_competing_pending_invitation, on: :create
+  validate :invited_by_belongs_to_account
+
+  scope :by_id_asc, -> { order(id: :asc) }
+  scope :pending, -> { where(accepted_at: nil, revoked_at: nil).where("expires_at > ?", Time.current) }
+  scope :accepted, -> { where.not(accepted_at: nil) }
+  scope :revoked, -> { where(accepted_at: nil).where.not(revoked_at: nil) }
+  scope :expired, -> { where(accepted_at: nil, revoked_at: nil).where("expires_at <= ?", Time.current) }
+
+  def self.digest_token(raw_token)
+    Digest::SHA256.hexdigest(raw_token.to_s)
+  end
+
+  def self.find_by_valid_token(account, raw_token)
+    return nil if account.nil? || raw_token.blank?
+
+    account.invitations.pending.find_by(token_digest: digest_token(raw_token))
+  end
+
+  def status
+    if accepted?
+      "accepted"
+    elsif revoked?
+      "revoked"
+    elsif expired?
+      "expired"
+    else
+      "pending"
+    end
+  end
+
+  def pending?
+    accepted_at.nil? && revoked_at.nil? && expires_at.present? && expires_at > Time.current
+  end
+
+  def accepted?
+    accepted_at.present?
+  end
+
+  def revoked?
+    accepted_at.nil? && revoked_at.present?
+  end
+
+  def expired?
+    accepted_at.nil? && revoked_at.nil? && expires_at.present? && expires_at <= Time.current
+  end
+
+  def assign_fresh_token
+    raw_token = SecureRandom.urlsafe_base64(32)
+    self.token_digest = self.class.digest_token(raw_token)
+    self.expires_at = EXPIRY.from_now
+    raw_token
+  end
+
+  def resend!
+    if accepted?
+      errors.add(:base, "Invitation has already been accepted")
+      raise ActiveRecord::RecordInvalid, self
+    end
+
+    if revoked?
+      errors.add(:base, "Invitation has been revoked")
+      raise ActiveRecord::RecordInvalid, self
+    end
+
+    transaction do
+      account.lock!
+      if account.users.exists?(email: email)
+        errors.add(:email, "is already registered on this account")
+        raise ActiveRecord::RecordInvalid, self
+      end
+
+      if account.invitations.pending.where.not(id: id).exists?(email: email)
+        errors.add(:email, "already has a pending invitation")
+        raise ActiveRecord::RecordInvalid, self
+      end
+
+      raw_token = assign_fresh_token
+      save!
+      raw_token
+    end
+  end
+
+  def revoke!
+    unless pending?
+      if accepted?
+        errors.add(:base, "Invitation has already been accepted")
+      elsif revoked?
+        errors.add(:base, "Invitation has already been revoked")
+      else
+        errors.add(:base, "Invitation has expired")
+      end
+      raise ActiveRecord::RecordInvalid, self
+    end
+
+    update!(revoked_at: Time.current, token_digest: nil)
+  end
+
+  def accept!(name:, password:)
+    transaction do
+      account.lock!
+      lock!
+
+      unless pending?
+        errors.add(:base, "Invalid or expired invitation token")
+        raise ActiveRecord::RecordInvalid, self
+      end
+
+      if password.blank?
+        user = account.users.build(name: name, email: email, role: role)
+        user.errors.add(:password, "can't be blank")
+        raise ActiveRecord::RecordInvalid, user
+      end
+
+      user = account.users.create!(
+        name: name,
+        email: email,
+        password: password,
+        role: role,
+        verified_at: Time.current,
+        suspended: false
+      )
+      update!(accepted_at: Time.current, token_digest: nil)
+      user
+    end
+  end
+
+  def as_api_json
+    {
+      id: id,
+      account_id: account_id,
+      email: email,
+      role: role,
+      status: status,
+      invited_by_id: invited_by_id,
+      expires_at: expires_at,
+      accepted_at: accepted_at,
+      revoked_at: revoked_at,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  def as_preview_json
+    {
+      email: email,
+      role: role,
+      business_name: account.name,
+      subdomain: account.subdomain,
+      expires_at: expires_at
+    }
+  end
+
+  private
+
+  def email_not_already_registered
+    return if account.nil? || email.blank?
+    return unless account.users.exists?(email: email)
+
+    errors.add(:email, "is already registered on this account")
+  end
+
+  def no_competing_pending_invitation
+    return if account.nil? || email.blank?
+
+    scope = account.invitations.pending
+    scope = scope.where.not(id: id) if persisted?
+    return unless scope.exists?(email: email)
+
+    errors.add(:email, "already has a pending invitation")
+  end
+
+  def invited_by_belongs_to_account
+    return if invited_by.nil? || account.nil?
+    return if invited_by.account_id == account_id
+
+    errors.add(:invited_by, "must belong to the same account")
+  end
+end
