+require "test_helper"
+
+class UsersSuspensionAndAssignmentTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def auth_headers(subdomain, token)
+    { "X-Helpdesk-Account" => subdomain, "Authorization" => "Bearer #{token}" }
+  end
+
+  def create_verified_customer(subdomain:, name:, email:, password: "my-customer-password")
+    post "/api/v1/registrations",
+         params: { user: { name: name, email: email, password: password } },
+         headers: { "X-Helpdesk-Account" => subdomain },
+         as: :json
+    assert_response :created
+    token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/verify-email")[:token]
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: token } },
+         headers: { "X-Helpdesk-Account" => subdomain },
+         as: :json
+    assert_response :success
+    json_response["user"]
+  end
+
+  def invite_and_accept(subdomain:, admin_token:, email:, role:, name:, password: "team-password")
+    post "/api/v1/invitations",
+         params: { invitation: { email: email, role: role } },
+         headers: auth_headers(subdomain, admin_token),
+         as: :json
+    assert_response :created
+    token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/accept-invitation")[:token]
+
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: token, name: name, password: password } },
+         headers: { "X-Helpdesk-Account" => subdomain },
+         as: :json
+    assert_response :created
+    json_response["user"]
+  end
+
+  test "users listing, filtering, suspension, session revocation, assignment clearing, and last active admin guard" do
+    acme_data = create_and_verify_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    jo_id = acme_data.dig("user", "id")
+    jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    # Cannot suspend last active admin
+    patch "/api/v1/users/#{jo_id}",
+          params: { user: { suspended: true } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :unprocessable_entity
+
+    # Add second admin, an agent, and a customer
+    admin2 = invite_and_accept(subdomain: "acme", admin_token: jo_token, email: "alex@acme.test", role: "admin", name: "Alex")
+    agent = invite_and_accept(subdomain: "acme", admin_token: jo_token, email: "sam@acme.test", role: "agent", name: "Sam")
+    cust = create_verified_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    alex_token = sign_in(subdomain: "acme", email: "alex@acme.test", password: "team-password").dig("session", "token")
+    sam_token = sign_in(subdomain: "acme", email: "sam@acme.test", password: "team-password").dig("session", "token")
+    avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+
+    # Customer creates a ticket and agent gets assigned to it
+    post "/api/v1/requests",
+         params: { request: { subject: "Need help", comment: { body: "Please help" } } },
+         headers: auth_headers("acme", avery_token),
+         as: :json
+    assert_response :created
+    ticket_id = json_response.dig("request", "id")
+
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { assignee_id: agent["id"] } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+    assert_equal agent["id"], json_response.dig("ticket", "assignee_id")
+
+    # List all users by ID ascending
+    get "/api/v1/users", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ jo_id, admin2["id"], agent["id"], cust["id"] ], json_response["users"].map { |u| u["id"] }
+    assert_equal [ false, false, false, false ], json_response["users"].map { |u| u["suspended"] }
+
+    # Show single user
+    get "/api/v1/users/#{agent["id"]}", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal "Sam", json_response.dig("user", "name")
+    assert_equal false, json_response.dig("user", "suspended")
+
+    # Agent and customer cannot access /users
+    get "/api/v1/users", headers: auth_headers("acme", sam_token)
+    assert_response :forbidden
+    patch "/api/v1/users/#{cust["id"]}",
+          params: { user: { suspended: true } },
+          headers: auth_headers("acme", sam_token),
+          as: :json
+    assert_response :forbidden
+    get "/api/v1/users", headers: auth_headers("acme", avery_token)
+    assert_response :forbidden
+
+    # GET /staff returns active staff (admins + agents) ordered by ID ascending; customer is forbidden
+    get "/api/v1/staff", headers: auth_headers("acme", avery_token)
+    assert_response :forbidden
+
+    get "/api/v1/staff", headers: auth_headers("acme", sam_token)
+    assert_response :success
+    assert_equal [ jo_id, admin2["id"], agent["id"] ], json_response["staff"].map { |u| u["id"] }
+
+    # Suspend agent: revokes sessions, clears assignments, removes from /staff, blocks sign in
+    patch "/api/v1/users/#{agent["id"]}",
+          params: { user: { suspended: true } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+    assert_equal true, json_response.dig("user", "suspended")
+
+    get "/api/v1/me", headers: auth_headers("acme", sam_token)
+    assert_response :unauthorized
+
+    post "/api/v1/sessions",
+         params: { session: { email: "sam@acme.test", password: "team-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :forbidden
+
+    get "/api/v1/tickets/#{ticket_id}", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_nil json_response.dig("ticket", "assignee_id")
+    assert_nil json_response.dig("ticket", "assignee")
+
+    get "/api/v1/staff", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ jo_id, admin2["id"] ], json_response["staff"].map { |u| u["id"] }
+
+    # Suspend second admin (allowed because Jo is active), then suspending Jo fails
+    patch "/api/v1/users/#{admin2["id"]}",
+          params: { user: { suspended: true } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+
+    get "/api/v1/me", headers: auth_headers("acme", alex_token)
+    assert_response :unauthorized
+
+    patch "/api/v1/users/#{jo_id}",
+          params: { user: { suspended: true } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :unprocessable_entity
+
+    # Filter users by role and suspended
+    get "/api/v1/users?role=admin", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ jo_id, admin2["id"] ], json_response["users"].map { |u| u["id"] }
+
+    get "/api/v1/users?suspended=true", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ admin2["id"], agent["id"] ], json_response["users"].map { |u| u["id"] }
+
+    get "/api/v1/users?role=admin&suspended=false", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ jo_id ], json_response["users"].map { |u| u["id"] }
+
+    # Unsuspend agent restores sign-in and /staff presence
+    patch "/api/v1/users/#{agent["id"]}",
+          params: { user: { suspended: false } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+    assert_equal false, json_response.dig("user", "suspended")
+
+    sign_in(subdomain: "acme", email: "sam@acme.test", password: "team-password")
+    get "/api/v1/staff", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ jo_id, agent["id"] ], json_response["staff"].map { |u| u["id"] }
+  end
+
+  test "ticket assignment, private notes, and isolation of customer-facing requests" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    create_and_verify_account(name: "Globex", subdomain: "globex", admin_name: "Gabe", email: "gabe@globex.test")
+
+    jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    gabe_token = sign_in(subdomain: "globex", email: "gabe@globex.test", password: "my-first-password").dig("session", "token")
+
+    agent = invite_and_accept(subdomain: "acme", admin_token: jo_token, email: "sam@acme.test", role: "agent", name: "Sam")
+    suspended_agent = invite_and_accept(subdomain: "acme", admin_token: jo_token, email: "pat@acme.test", role: "agent", name: "Pat")
+    patch "/api/v1/users/#{suspended_agent["id"]}",
+          params: { user: { suspended: true } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+
+    globex_agent = invite_and_accept(subdomain: "globex", admin_token: gabe_token, email: "gagent@globex.test", role: "agent", name: "GAgent")
+    cust = create_verified_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    agent_token = sign_in(subdomain: "acme", email: "sam@acme.test", password: "team-password").dig("session", "token")
+    avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+
+    # Customer creates two requests
+    travel_to Time.zone.parse("2026-11-10 10:00:00 UTC") do
+      post "/api/v1/requests",
+           params: { request: { subject: "First issue", comment: { body: "First body" } } },
+           headers: auth_headers("acme", avery_token),
+           as: :json
+      assert_response :created
+      @ticket1_id = json_response.dig("request", "id")
+
+      travel 5.minutes
+      post "/api/v1/requests",
+           params: { request: { subject: "Second issue", comment: { body: "Second body" } } },
+           headers: auth_headers("acme", avery_token),
+           as: :json
+      assert_response :created
+      @ticket2_id = json_response.dig("request", "id")
+    end
+
+    get "/api/v1/requests/#{@ticket1_id}", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    initial_request_json = json_response["request"]
+    assert_not initial_request_json.key?("assignee_id")
+    assert_not initial_request_json.key?("assignee")
+
+    # Invalid assignments rejected
+    [ cust["id"], suspended_agent["id"], globex_agent["id"], 999999 ].each do |bad_id|
+      patch "/api/v1/tickets/#{@ticket1_id}",
+            params: { ticket: { assignee_id: bad_id } },
+            headers: auth_headers("acme", agent_token),
+            as: :json
+      assert_response :unprocessable_entity
+    end
+
+    # Later, agent assigns ticket 1 and adds a private note
+    travel_to Time.zone.parse("2026-11-10 11:00:00 UTC") do
+      patch "/api/v1/tickets/#{@ticket1_id}",
+            params: { ticket: { assignee_id: agent["id"] } },
+            headers: auth_headers("acme", agent_token),
+            as: :json
+      assert_response :success
+      assert_equal agent["id"], json_response.dig("ticket", "assignee_id")
+      assert_equal({ "id" => agent["id"], "name" => "Sam" }, json_response.dig("ticket", "assignee"))
+
+      patch "/api/v1/tickets/#{@ticket1_id}",
+            params: { ticket: { comment: { body: "Checking this with billing.", public: false } } },
+            headers: auth_headers("acme", agent_token),
+            as: :json
+      assert_response :success
+    end
+
+    # Customer-facing request and listing order MUST NOT change due to internal activity
+    get "/api/v1/requests/#{@ticket1_id}", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal initial_request_json, json_response["request"]
+
+    get "/api/v1/requests", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal [ @ticket2_id, @ticket1_id ], json_response["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests/#{@ticket1_id}/comments", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal [ "First body" ], json_response["comments"].map { |c| c["body"] }
+
+    # Staff sees private note and assignee in tickets list and comments
+    get "/api/v1/tickets/#{@ticket1_id}/comments", headers: auth_headers("acme", agent_token)
+    assert_response :success
+    assert_equal [ "First body", "Checking this with billing." ], json_response["comments"].map { |c| c["body"] }
+    assert_equal [ true, false ], json_response["comments"].map { |c| c["public"] }
+
+    get "/api/v1/tickets", headers: auth_headers("acme", agent_token)
+    assert_response :success
+    ticket1_row = json_response["tickets"].find { |t| t["id"] == @ticket1_id }
+    assert_equal agent["id"], ticket1_row["assignee_id"]
+    assert_equal({ "id" => agent["id"], "name" => "Sam" }, ticket1_row["assignee"])
+
+    # Clear assignee with null
+    patch "/api/v1/tickets/#{@ticket1_id}",
+          params: { ticket: { assignee_id: nil } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+    assert_nil json_response.dig("ticket", "assignee_id")
+    assert_nil json_response.dig("ticket", "assignee")
+
+    # Request still unchanged
+    get "/api/v1/requests/#{@ticket1_id}", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal initial_request_json, json_response["request"]
+  end
+end
