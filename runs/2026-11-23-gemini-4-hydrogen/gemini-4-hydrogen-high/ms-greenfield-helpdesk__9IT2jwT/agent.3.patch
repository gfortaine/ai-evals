diff --git a/app/controllers/api/v1/invitations_controller.rb b/app/controllers/api/v1/invitations_controller.rb
new file mode 100644
index 0000000..bb5ef0b
--- /dev/null
+++ b/app/controllers/api/v1/invitations_controller.rb
@@ -0,0 +1,72 @@
+module Api
+  module V1
+    class InvitationsController < BaseController
+      before_action :require_account!
+      before_action :require_session!
+      before_action :require_active_account!
+      before_action :require_admin!
+
+      def index
+        scope = current_account.invitations.by_id_asc
+
+        if params[:status].present?
+          status_filter = params[:status].to_s
+          unless Invitation::STATUSES.include?(status_filter)
+            return render json: { error: "Invalid status filter" }, status: :unprocessable_entity
+          end
+          scope = scope.public_send(status_filter)
+        end
+
+        result = paginate(scope)
+        render json: result[:meta].merge(
+          invitations: result[:records].map(&:as_api_json)
+        ), status: :ok
+      end
+
+      def show
+        invitation = current_account.invitations.find(params[:id])
+        render json: { invitation: invitation.as_api_json }, status: :ok
+      end
+
+      def create
+        invitation_attrs = params.require(:invitation)
+        unless invitation_attrs.is_a?(ActionController::Parameters)
+          return render json: { error: "Invalid invitation payload" }, status: :bad_request
+        end
+
+        permitted = invitation_attrs.permit(:email, :role)
+        invitation = current_account.invitations.build(
+          email: permitted[:email],
+          role: permitted[:role],
+          invited_by: current_user
+        )
+
+        raw_token = nil
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          raw_token = invitation.assign_fresh_token
+          invitation.save!
+        end
+
+        UserMailer.invitation(invitation, raw_token).deliver_now
+
+        render json: { invitation: invitation.as_api_json }, status: :created
+      end
+
+      def resend
+        invitation = current_account.invitations.find(params[:id])
+        raw_token = invitation.resend!
+        UserMailer.invitation(invitation, raw_token).deliver_now
+
+        render json: { invitation: invitation.reload.as_api_json }, status: :ok
+      end
+
+      def destroy
+        invitation = current_account.invitations.find(params[:id])
+        invitation.revoke!
+
+        render json: { invitation: invitation.reload.as_api_json }, status: :ok
+      end
+    end
+  end
+end
