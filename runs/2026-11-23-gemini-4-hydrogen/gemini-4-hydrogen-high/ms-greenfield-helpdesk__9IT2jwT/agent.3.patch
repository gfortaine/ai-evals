+require "test_helper"
+
+class InvitationsAndTeamTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def auth_headers(subdomain, token)
+    { "X-Helpdesk-Account" => subdomain, "Authorization" => "Bearer #{token}" }
+  end
+
+  test "admin invites agent and admin, previews, accepts, and new staff can sign in without verification email" do
+    acme_data = create_and_verify_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    acme_id = acme_data.dig("user", "account_id")
+    jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    ActionMailer::Base.deliveries.clear
+
+    # Invite an agent
+    post "/api/v1/invitations",
+         params: { invitation: { email: "Sam@Example.test", role: "agent" } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :created
+
+    agent_invite = json_response["invitation"]
+    assert_not_nil agent_invite["id"]
+    assert_equal acme_id, agent_invite["account_id"]
+    assert_equal "sam@example.test", agent_invite["email"]
+    assert_equal "agent", agent_invite["role"]
+    assert_equal "pending", agent_invite["status"]
+    assert_not_nil agent_invite["expires_at"]
+    assert_nil agent_invite["token_digest"]
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "sam@example.test" ], mail.to
+    link = extract_token_from_email(mail, "/accept-invitation")
+    assert_equal "acme", link[:account]
+    assert link[:full_url].start_with?("http://localhost:3001/accept-invitation?account=acme&token=")
+
+    # Preview invitation
+    post "/api/v1/invitation_previews",
+         params: { invitation_preview: { token: link[:token] } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+    preview = json_response["invitation_preview"]
+    assert_equal "sam@example.test", preview["email"]
+    assert_equal "agent", preview["role"]
+    assert_equal "Acme", preview["business_name"]
+    assert_equal "acme", preview["subdomain"]
+    assert_not_nil preview["expires_at"]
+
+    # Accept invitation
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/invitation_acceptances",
+         params: {
+           invitation_acceptance: {
+             token: link[:token],
+             name: "Sam",
+             password: "my-team-password"
+           }
+         },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :created
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    sam = json_response["user"]
+    assert_equal "Sam", sam["name"]
+    assert_equal "sam@example.test", sam["email"]
+    assert_equal "agent", sam["role"]
+    assert_equal true, sam["verified"]
+    assert_equal false, sam["suspended"]
+    assert_equal "Acme", json_response.dig("account", "name")
+    assert_equal "acme", json_response.dig("account", "subdomain")
+
+    # Sam can sign in immediately without verification email
+    sam_token = sign_in(subdomain: "acme", email: "sam@example.test", password: "my-team-password").dig("session", "token")
+    assert_not_nil sam_token
+
+    # Token cannot be previewed or accepted again
+    post "/api/v1/invitation_previews",
+         params: { invitation_preview: { token: link[:token] } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: link[:token], name: "Sam", password: "my-team-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    # Accepted invitation shows accepted status
+    get "/api/v1/invitations/#{agent_invite["id"]}", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal "accepted", json_response.dig("invitation", "status")
+    assert_not_nil json_response.dig("invitation", "accepted_at")
+
+    # Sam (agent) cannot manage invitations or users
+    post "/api/v1/invitations",
+         params: { invitation: { email: "other@example.test", role: "agent" } },
+         headers: auth_headers("acme", sam_token),
+         as: :json
+    assert_response :forbidden
+
+    get "/api/v1/invitations", headers: auth_headers("acme", sam_token)
+    assert_response :forbidden
+
+    get "/api/v1/users", headers: auth_headers("acme", sam_token)
+    assert_response :forbidden
+
+    # Jo invites another admin; invited admin CAN manage invitations and users
+    post "/api/v1/invitations",
+         params: { invitation: { email: "alex@example.test", role: "admin" } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :created
+    alex_token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/accept-invitation")[:token]
+
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: alex_token, name: "Alex", password: "alex-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :created
+    assert_equal "admin", json_response.dig("user", "role")
+
+    alex_session = sign_in(subdomain: "acme", email: "alex@example.test", password: "alex-password").dig("session", "token")
+    get "/api/v1/invitations", headers: auth_headers("acme", alex_session)
+    assert_response :success
+    assert_equal 2, json_response["invitations"].size
+    assert_equal [ agent_invite["id"], json_response["invitations"].last["id"] ].sort,
+                 json_response["invitations"].map { |i| i["id"] }
+  end
+
+  test "invitation lifecycle: list, filter by status, resend, revoke, expire, competing invites, and customer registration lock" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    create_and_verify_account(name: "Globex", subdomain: "globex", admin_name: "Gabe", email: "gabe@globex.test")
+    jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    gabe_token = sign_in(subdomain: "globex", email: "gabe@globex.test", password: "my-first-password").dig("session", "token")
+
+    # Cannot invite customer role or existing user
+    post "/api/v1/invitations",
+         params: { invitation: { email: "cust@example.test", role: "customer" } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/invitations",
+         params: { invitation: { email: "jo@acme.test", role: "agent" } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :unprocessable_entity
+
+    # Create pending invitation 1
+    post "/api/v1/invitations",
+         params: { invitation: { email: "one@example.test", role: "agent" } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :created
+    inv1_id = json_response.dig("invitation", "id")
+    token1 = extract_token_from_email(ActionMailer::Base.deliveries.last, "/accept-invitation")[:token]
+
+    # Competing invitation in same account is rejected
+    post "/api/v1/invitations",
+         params: { invitation: { email: "ONE@example.test", role: "admin" } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :unprocessable_entity
+
+    # Customer registration cannot take a pending invite's email in same account
+    post "/api/v1/registrations",
+         params: { user: { name: "Sneaky", email: "one@example.test", password: "password123" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    # Different account CAN invite or register the same email (multi-tenancy)
+    post "/api/v1/invitations",
+         params: { invitation: { email: "one@example.test", role: "agent" } },
+         headers: auth_headers("globex", gabe_token),
+         as: :json
+    assert_response :created
+
+    # Globex cannot inspect Acme's invitation
+    get "/api/v1/invitations/#{inv1_id}", headers: auth_headers("globex", gabe_token)
+    assert_response :not_found
+
+    # Resend replaces token and invalidates old token
+    post "/api/v1/invitations/#{inv1_id}/resend", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    token1_resent = extract_token_from_email(ActionMailer::Base.deliveries.last, "/accept-invitation")[:token]
+    assert_not_equal token1, token1_resent
+
+    post "/api/v1/invitation_previews",
+         params: { invitation_preview: { token: token1 } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/invitation_previews",
+         params: { invitation_preview: { token: token1_resent } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+
+    # Create invitation 2 and revoke it
+    post "/api/v1/invitations",
+         params: { invitation: { email: "two@example.test", role: "agent" } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :created
+    inv2_id = json_response.dig("invitation", "id")
+    token2 = extract_token_from_email(ActionMailer::Base.deliveries.last, "/accept-invitation")[:token]
+
+    delete "/api/v1/invitations/#{inv2_id}", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal "revoked", json_response.dig("invitation", "status")
+    assert_not_nil json_response.dig("invitation", "revoked_at")
+
+    # Revoked token cannot be previewed, accepted, resent, or revoked again
+    post "/api/v1/invitation_previews",
+         params: { invitation_preview: { token: token2 } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/invitations/#{inv2_id}/resend", headers: auth_headers("acme", jo_token)
+    assert_response :unprocessable_entity
+
+    delete "/api/v1/invitations/#{inv2_id}", headers: auth_headers("acme", jo_token)
+    assert_response :unprocessable_entity
+
+    # Customer registration IS allowed once invitation is revoked
+    post "/api/v1/registrations",
+         params: { user: { name: "Two", email: "two@example.test", password: "password123" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :created
+
+    # Create invitation 3 and accept it
+    post "/api/v1/invitations",
+         params: { invitation: { email: "three@example.test", role: "agent" } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :created
+    inv3_id = json_response.dig("invitation", "id")
+    token3 = extract_token_from_email(ActionMailer::Base.deliveries.last, "/accept-invitation")[:token]
+
+    # Blank password on acceptance does not consume invitation
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: token3, name: "Three", password: "   " } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: token3, name: "Three", password: "password123" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :created
+
+    # Accepted invitation cannot be resent or revoked
+    post "/api/v1/invitations/#{inv3_id}/resend", headers: auth_headers("acme", jo_token)
+    assert_response :unprocessable_entity
+    delete "/api/v1/invitations/#{inv3_id}", headers: auth_headers("acme", jo_token)
+    assert_response :unprocessable_entity
+
+    # Create invitation 4 and let it expire
+    post "/api/v1/invitations",
+         params: { invitation: { email: "four@example.test", role: "agent" } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :created
+    inv4_id = json_response.dig("invitation", "id")
+    token4 = extract_token_from_email(ActionMailer::Base.deliveries.last, "/accept-invitation")[:token]
+
+    travel 8.days do
+      # Invitation 1 and 4 are now expired (both had 7-day expiry)
+      post "/api/v1/invitation_previews",
+           params: { invitation_preview: { token: token4 } },
+           headers: { "X-Helpdesk-Account" => "acme" },
+           as: :json
+      assert_response :unprocessable_entity
+
+      post "/api/v1/invitation_acceptances",
+           params: { invitation_acceptance: { token: token4, name: "Four", password: "password123" } },
+           headers: { "X-Helpdesk-Account" => "acme" },
+           as: :json
+      assert_response :unprocessable_entity
+
+      # List all invitations by ID ascending
+      get "/api/v1/invitations", headers: auth_headers("acme", jo_token)
+      assert_response :success
+      assert_equal [ inv1_id, inv2_id, inv3_id, inv4_id ], json_response["invitations"].map { |i| i["id"] }
+      assert_equal %w[expired revoked accepted expired], json_response["invitations"].map { |i| i["status"] }
+
+      # Filter by status
+      get "/api/v1/invitations?status=expired", headers: auth_headers("acme", jo_token)
+      assert_response :success
+      assert_equal [ inv1_id, inv4_id ], json_response["invitations"].map { |i| i["id"] }
+
+      get "/api/v1/invitations?status=revoked", headers: auth_headers("acme", jo_token)
+      assert_response :success
+      assert_equal [ inv2_id ], json_response["invitations"].map { |i| i["id"] }
+
+      get "/api/v1/invitations?status=accepted", headers: auth_headers("acme", jo_token)
+      assert_response :success
+      assert_equal [ inv3_id ], json_response["invitations"].map { |i| i["id"] }
+
+      get "/api/v1/invitations?status=pending", headers: auth_headers("acme", jo_token)
+      assert_response :success
+      assert_equal [], json_response["invitations"]
