+  test "cancelled account blocks group endpoints and purge_expired deletes groups and memberships cleanly" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    jo = User.find_by!(email: "jo@acme.test")
+
+    post "/api/v1/groups", params: { group: { name: "Billing" } }, headers: auth_headers("acme", jo_token), as: :json
+    assert_response :created
+    billing_id = json_response.dig("group", "id")
+
+    post "/api/v1/group_memberships",
+         params: { group_membership: { group_id: billing_id, user_id: jo.id } },
+         headers: auth_headers("acme", jo_token),
+         as: :json
+    assert_response :created
+    membership_id = json_response.dig("group_membership", "id")
+
+    post "/api/v1/account/cancel", headers: auth_headers("acme", jo_token)
+    assert_response :success
+
+    new_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    get "/api/v1/groups", headers: auth_headers("acme", new_token)
+    assert_response :forbidden
+
+    get "/api/v1/group_memberships", headers: auth_headers("acme", new_token)
+    assert_response :forbidden
+
+    Account.find_by!(subdomain: "acme").update!(cancelled_at: 91.days.ago)
+    assert_equal 1, Account.purge_expired!
+    assert_nil Group.find_by(id: billing_id)
+    assert_nil GroupMembership.find_by(id: membership_id)
+  end
+
+  test "pagination, combined filters, and simultaneous group_id and assignee_id edge cases" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    jo_token = sign_in(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    sam = invite_and_accept(subdomain: "acme", admin_token: jo_token, email: "sam@acme.test", role: "agent", name: "Sam")
+    pat = invite_and_accept(subdomain: "acme", admin_token: jo_token, email: "pat@acme.test", role: "agent", name: "Pat")
+    create_verified_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_token = sign_in(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+
+    group_ids = %w[Billing Sales Support].map do |name|
+      post "/api/v1/groups", params: { group: { name: name } }, headers: auth_headers("acme", jo_token), as: :json
+      assert_response :created
+      json_response.dig("group", "id")
+    end
+    billing_id, sales_id, support_id = group_ids
+
+    # Paginate groups (per_page=2, ordered by id ascending)
+    get "/api/v1/groups?page=1&per_page=2", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal 3, json_response["count"]
+    assert_equal 2, json_response["next_page"]
+    assert_equal [ billing_id, sales_id ], json_response["groups"].map { |g| g["id"] }
+
+    get "/api/v1/groups?page=2&per_page=2", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ support_id ], json_response["groups"].map { |g| g["id"] }
+    assert_nil json_response["next_page"]
+    assert_equal 1, json_response["previous_page"]
+
+    # Add Sam to Billing (default) and Sales; Pat has no groups
+    membership_ids = [ billing_id, sales_id ].map do |gid|
+      post "/api/v1/group_memberships",
+           params: { group_membership: { group_id: gid, user_id: sam["id"] } },
+           headers: auth_headers("acme", jo_token),
+           as: :json
+      assert_response :created
+      json_response.dig("group_membership", "id")
+    end
+
+    # Paginate memberships
+    get "/api/v1/group_memberships?page=1&per_page=1", headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal 2, json_response["count"]
+    assert_equal [ membership_ids[0] ], json_response["group_memberships"].map { |m| m["id"] }
+
+    # Create tickets
+    post "/api/v1/requests",
+         params: { request: { subject: "Invoice issue", comment: { body: "Need refund" } } },
+         headers: auth_headers("acme", avery_token),
+         as: :json
+    t1 = json_response.dig("request", "id")
+
+    post "/api/v1/requests",
+         params: { request: { subject: "Login issue", comment: { body: "Cannot sign in" } } },
+         headers: auth_headers("acme", avery_token),
+         as: :json
+    t2 = json_response.dig("request", "id")
+
+    # Simultaneous group_id: nil and assignee_id: sam on ungrouped t1 -> uses Sam default group (Billing)
+    patch "/api/v1/tickets/#{t1}",
+          params: { ticket: { group_id: nil, assignee_id: sam["id"], priority: "high" } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+    assert_equal billing_id, json_response.dig("ticket", "group_id")
+    assert_equal sam["id"], json_response.dig("ticket", "assignee_id")
+
+    # Simultaneous group_id: support_id (not Sam group) and assignee_id: sam -> 422, t1 stays in Billing with Sam
+    patch "/api/v1/tickets/#{t1}",
+          params: { ticket: { group_id: support_id, assignee_id: sam["id"] } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :unprocessable_entity
+
+    get "/api/v1/tickets/#{t1}", headers: auth_headers("acme", jo_token)
+    assert_equal billing_id, json_response.dig("ticket", "group_id")
+    assert_equal sam["id"], json_response.dig("ticket", "assignee_id")
+
+    # Simultaneous group_id: nil and assignee_id: sam on grouped t1 -> 422 (cannot clear group while assigning grouped user)
+    patch "/api/v1/tickets/#{t1}",
+          params: { ticket: { group_id: nil, assignee_id: sam["id"] } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :unprocessable_entity
+
+    # Simultaneous group_id: nil and assignee_id: pat (no groups) on grouped t1 -> allowed
+    patch "/api/v1/tickets/#{t1}",
+          params: { ticket: { group_id: nil, assignee_id: pat["id"] } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+    assert_nil json_response.dig("ticket", "group_id")
+    assert_equal pat["id"], json_response.dig("ticket", "assignee_id")
+
+    # Move t1 back to Billing with Sam, and test combined filters
+    patch "/api/v1/tickets/#{t1}",
+          params: { ticket: { group_id: billing_id, assignee_id: sam["id"] } },
+          headers: auth_headers("acme", jo_token),
+          as: :json
+    assert_response :success
+
+    get "/api/v1/tickets?group_id=#{billing_id}&status=open&priority=high&assignee_id=#{sam["id"]}&q=refund",
+        headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ t1 ], json_response["tickets"].map { |t| t["id"] }
+
+    get "/api/v1/tickets?group_id=unassigned&assignee_id=unassigned",
+        headers: auth_headers("acme", jo_token)
+    assert_response :success
+    assert_equal [ t2 ], json_response["tickets"].map { |t| t["id"] }
+  end
+end
