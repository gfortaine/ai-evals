index 0000000..191153a
--- /dev/null
+++ b/app/controllers/api/v1/group_memberships_controller.rb
@@ -0,0 +1,98 @@
+module Api
+  module V1
+    class GroupMembershipsController < BaseController
+      before_action :require_account!
+      before_action :require_session!
+      before_action :require_active_account!
+      before_action :require_staff!, only: [ :index, :show ]
+      before_action :require_admin!, only: [ :create, :destroy, :make_default ]
+
+      def index
+        scope = current_account.group_memberships.includes(:group, :user).by_id_asc
+
+        if params[:group_id].present?
+          group_id = parse_filter_id(params[:group_id].to_s)
+          if group_id.nil?
+            return render json: { error: "Invalid group_id filter" }, status: :unprocessable_entity
+          end
+          scope = scope.where(group_id: group_id)
+        end
+
+        if params[:user_id].present?
+          user_id = parse_filter_id(params[:user_id].to_s)
+          if user_id.nil?
+            return render json: { error: "Invalid user_id filter" }, status: :unprocessable_entity
+          end
+          scope = scope.where(user_id: user_id)
+        end
+
+        result = paginate(scope)
+        render json: result[:meta].merge(
+          group_memberships: result[:records].map(&:as_api_json)
+        ), status: :ok
+      end
+
+      def show
+        membership = current_account.group_memberships.includes(:group, :user).find(params[:id])
+        render json: { group_membership: membership.as_api_json }, status: :ok
+      end
+
+      def create
+        membership_attrs = params.require(:group_membership)
+        unless membership_attrs.is_a?(ActionController::Parameters)
+          return render json: { error: "Invalid group_membership payload" }, status: :bad_request
+        end
+
+        permitted = membership_attrs.permit(:group_id, :user_id, :default)
+        wants_default = if permitted.key?(:default) && !permitted[:default].nil?
+                          ActiveModel::Type::Boolean.new.cast(permitted[:default])
+                        else
+                          false
+                        end
+        wants_default = false if wants_default.nil?
+
+        membership = GroupMembership.new(
+          group_id: permitted[:group_id],
+          user_id: permitted[:user_id],
+          default: wants_default
+        )
+        membership.expected_account_id = current_account.id
+
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          membership.save!
+        end
+
+        render json: { group_membership: membership.reload.as_api_json }, status: :created
+      end
+
+      def make_default
+        membership = current_account.group_memberships.find(params[:id])
+        membership.make_default!
+
+        render json: { group_membership: membership.reload.as_api_json }, status: :ok
+      end
+
+      def destroy
+        membership = current_account.group_memberships.find(params[:id])
+
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          membership.reload
+          membership.destroy!
+        end
+
+        render json: { message: "Group membership deleted" }, status: :ok
+      end
+
+      private
+
+      def parse_filter_id(raw)
+        return nil unless raw.match?(/\A\d+\z/)
+
+        parsed = raw.to_i
+        parsed >= 1 ? parsed : nil
+      end
+    end
+  end
+end
