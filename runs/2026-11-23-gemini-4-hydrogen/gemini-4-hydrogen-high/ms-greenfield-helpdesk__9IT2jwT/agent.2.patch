+    assert_equal agent.id, json_response["comments"].last.dig("author", "id")
+    assert_equal "Sam Agent", json_response["comments"].last.dig("author", "name")
+
+    get "/api/v1/requests/#{ticket_id}/comments", headers: auth_headers("acme", avery_token)
+    assert_response :success
+    assert_equal 3, json_response["count"]
+    assert_equal [ "The download button does nothing.", "Please try again now.", "Checking one more thing." ],
+                 json_response["comments"].map { |c| c["body"] }
+
+    # Customer reply reopens pending request
+    patch "/api/v1/requests/#{ticket_id}",
+          params: { request: { comment: { body: "Still getting an error." } } },
+          headers: auth_headers("acme", avery_token),
+          as: :json
+    assert_response :success
+    assert_equal "open", json_response.dig("request", "status")
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    # Staff marks ticket solved
