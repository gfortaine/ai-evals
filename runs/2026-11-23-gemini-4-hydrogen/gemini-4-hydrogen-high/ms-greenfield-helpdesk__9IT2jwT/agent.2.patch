diff --git a/test/integration/customer_registration_and_auth_test.rb b/test/integration/customer_registration_and_auth_test.rb
new file mode 100644
index 0000000..4b0e00e
--- /dev/null
+++ b/test/integration/customer_registration_and_auth_test.rb
@@ -0,0 +1,154 @@
+require "test_helper"
+
+class CustomerRegistrationAndAuthTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def register_customer(subdomain:, name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    post "/api/v1/registrations",
+         params: { user: { name: name, email: email, password: password } },
+         headers: { "X-Helpdesk-Account" => subdomain },
+         as: :json
+  end
+
+  test "customer registers, verifies email, signs in, updates profile, changes and resets password" do
+    create_and_verify_account(name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    ActionMailer::Base.deliveries.clear
+
+    # Registration ignores injected role and creates unverified customer
+    post "/api/v1/registrations",
+         params: {
+           user: {
+             name: "Avery",
+             email: "Avery@Example.test",
+             password: "my-customer-password",
+             role: "admin"
+           }
+         },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+
+    assert_response :created
+    assert_equal "Avery", json_response.dig("user", "name")
+    assert_equal "avery@example.test", json_response.dig("user", "email")
+    assert_equal "customer", json_response.dig("user", "role")
+    assert_equal false, json_response.dig("user", "verified")
+    assert_nil json_response.dig("user", "password_digest")
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "avery@example.test" ], mail.to
+    link = extract_token_from_email(mail, "/verify-email")
+    assert_equal "acme", link[:account]
+
+    # Unverified customer cannot sign in
+    post "/api/v1/sessions",
+         params: { session: { email: "avery@example.test", password: "my-customer-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :forbidden
+
+    # Resend verification and confirm
+    post "/api/v1/email_verifications",
+         params: { email_verification: { email: "avery@example.test" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+    fresh_token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/verify-email")[:token]
+
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: fresh_token } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+    assert_equal true, json_response.dig("user", "verified")
+
+    # Sign in and manage profile
+    token = sign_in(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+    headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token}" }
+
+    get "/api/v1/me", headers: headers
+    assert_response :success
+    assert_equal "Avery", json_response.dig("user", "name")
+    assert_equal "customer", json_response.dig("user", "role")
+
+    patch "/api/v1/me",
+          params: { user: { name: "Avery Lee", role: "admin" } },
+          headers: headers,
+          as: :json
+    assert_response :success
+    assert_equal "Avery Lee", json_response.dig("user", "name")
+    assert_equal "customer", json_response.dig("user", "role")
+
+    # Change password
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-customer-password", password: "new-customer-password" } },
+        headers: headers,
+        as: :json
+    assert_response :success
+
+    get "/api/v1/me", headers: headers
+    assert_response :unauthorized
+
+    # Reset password
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "avery@example.test" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+    reset_token = extract_token_from_email(ActionMailer::Base.deliveries.last, "/reset-password")[:token]
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: reset_token, password: "reset-customer-password" } },
+         headers: { "X-Helpdesk-Account" => "acme" },
+         as: :json
+    assert_response :success
+
