diff --git a/app/models/comment.rb b/app/models/comment.rb
new file mode 100644
index 0000000..7e09cd0
--- /dev/null
+++ b/app/models/comment.rb
@@ -0,0 +1,33 @@
+class Comment < ApplicationRecord
+  belongs_to :ticket, touch: true
+  belongs_to :author, class_name: "User"
+
+  validates :body, presence: true
+  validates :public, inclusion: { in: [ true, false ] }
+  validate :author_belongs_to_ticket_account
+
+  scope :public_only, -> { where(public: true) }
+  scope :oldest_first, -> { order(created_at: :asc, id: :asc) }
+
+  def as_api_json
+    {
+      id: id,
+      body: body,
+      public: public?,
+      author: {
+        id: author.id,
+        name: author.name
+      },
+      created_at: created_at
+    }
+  end
+
+  private
+
+  def author_belongs_to_ticket_account
+    return if author.nil? || ticket.nil?
+    return if author.account_id == ticket.account_id
+
+    errors.add(:author, "must belong to the same account")
+  end
+end
diff --git a/app/models/ticket.rb b/app/models/ticket.rb
new file mode 100644
index 0000000..27359f2
--- /dev/null
+++ b/app/models/ticket.rb
@@ -0,0 +1,51 @@
+class Ticket < ApplicationRecord
+  STATUSES = %w[open pending solved].freeze
+
+  belongs_to :account
+  belongs_to :requester, class_name: "User"
+  has_many :comments, dependent: :destroy
+
+  normalizes :subject, with: ->(s) { s.to_s.strip }
+
+  validates :subject, presence: true
+  validates :status, presence: true, inclusion: { in: STATUSES }
+  validate :requester_belongs_to_account
+
+  scope :recently_active_first, -> { order(updated_at: :desc, id: :desc) }
+
+  def as_request_json
+    {
+      id: id,
+      subject: subject,
+      status: status,
+      requester_id: requester_id,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  def as_ticket_json
+    {
+      id: id,
+      subject: subject,
+      status: status,
+      requester_id: requester_id,
+      requester: {
+        id: requester.id,
+        name: requester.name,
+        email: requester.email
+      },
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  private
+
+  def requester_belongs_to_account
+    return if requester.nil? || account.nil?
+    return if requester.account_id == account_id
+
+    errors.add(:requester, "must belong to the same account")
+  end
+end
