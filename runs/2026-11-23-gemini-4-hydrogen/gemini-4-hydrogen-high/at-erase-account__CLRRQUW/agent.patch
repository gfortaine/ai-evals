+    def erase_sign_in_events
+      addresses = sign_in_event_email_addresses
+      return if addresses.empty?
+
+      SignInEvent.where("lower(email_address) IN (?)", addresses.map(&:downcase)).delete_all
+    end
+
+    def sign_in_event_email_addresses
+      [ email_address, unscrambled_email_address ].compact.uniq
