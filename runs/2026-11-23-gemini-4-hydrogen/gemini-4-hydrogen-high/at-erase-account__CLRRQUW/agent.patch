+
+      if email_address.match?(DEACTIVATED_UUID_EMAIL_PATTERN)
+        email_address.gsub(DEACTIVATED_UUID_EMAIL_PATTERN, "@")
+      elsif !active? && email_address.include?("-deactivated-")
+        email_address.sub(/-deactivated-[^@]+@/, "@")
+      end
+    end
