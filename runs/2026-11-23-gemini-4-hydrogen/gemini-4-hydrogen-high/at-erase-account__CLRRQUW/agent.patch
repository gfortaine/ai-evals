diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..e07339a 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,93 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "destroying a user erases all their data except shared books which get Deleted author byline" do
+    alice = User.create!(email_address: "alice@example.com", name: "Alice", password: "secret123456")
+    bob = users(:david)
+
+    session = alice.sessions.start!(user_agent: "TestBrowser", ip_address: "127.0.0.1")
+    session.destroy!
+    alice.sessions.start!(user_agent: "TestBrowser", ip_address: "127.0.0.1")
+    bob.sessions.start!(user_agent: "BobBrowser", ip_address: "127.0.0.2")
+
+    shared_book = Book.create!(title: "Everyone Guide", author: "Alice", everyone_access: true, creator: alice)
+    shared_book.update_access(editors: [ alice.id ], readers: [ bob.id ])
+    shared_leaf = shared_book.press(Page.new(body: "Shared wisdom for all"), title: "Shared Chapter")
+    shared_leaf.reindex
+
+    private_book = Book.create!(title: "Alice Private Journal", author: "Alice", everyone_access: false, creator: alice)
+    private_book.cover.attach(io: File.open(file_fixture("reading.webp")), filename: "reading.webp")
+    private_page_leaf = private_book.press(Page.new(body: "Private diary secret"), title: "Private Page")
+    private_page_leaf.page.body.uploads.attach(io: File.open(file_fixture("white-rabbit.webp")), filename: "white-rabbit.webp")
+    old_revision_page = Page.create!(body: "Old private revision secret")
+    private_page_leaf.edits.revision.create!(leafable: old_revision_page)
+    private_page_leaf.reindex
+
+    private_picture_leaf = private_book.press(Picture.new(caption: "Secret pic"), title: "Secret Pic")
+    private_picture_leaf.picture.image.attach(io: File.open(file_fixture("pixel.bmp")), filename: "pixel.bmp")
+    private_picture_leaf.edit(leaf_params: { title: "Updated Secret Pic" })
+    private_picture_leaf.trashed!
+
+    ReadingMark.remember(private_page_leaf, user: alice)
+    ReadingMark.remember(shared_leaf, user: alice)
+    ReadingMark.remember(shared_leaf, user: bob)
+    ReadingMark.remember(leaves(:welcome_page), user: alice)
+
+    erased_blob_ids = [
+      private_book.cover.blob.id,
+      private_page_leaf.page.body.uploads.first.blob.id,
+      private_picture_leaf.picture.image.blob.id
+    ]
+
+    alice.destroy!
+
+    assert_nil User.find_by(id: alice.id)
+    assert_empty Session.where(user_id: alice.id)
+    assert_empty Access.where(user_id: alice.id)
+    assert_empty ReadingMark.where(user_id: alice.id)
+    assert_empty SignInEvent.for_address("alice@example.com")
+    assert SignInEvent.for_address(bob.email_address).exists?
+
+    assert_nil Book.find_by(id: private_book.id)
+    assert_nil Leaf.find_by(id: private_page_leaf.id)
+    assert_nil Leaf.find_by(id: private_picture_leaf.id)
+    assert_nil Page.find_by(id: old_revision_page.id)
+    assert_empty ActionText::Markdown.where(record_type: "Page", record_id: old_revision_page.id)
+    assert_empty ActiveStorage::Blob.where(id: erased_blob_ids)
+    assert_empty Leaf.search("Private diary secret")
+    assert_empty Leaf.connection.select_all(
+      Leaf.sanitize_sql([ "SELECT rowid FROM leaf_search_index WHERE rowid = ?", private_page_leaf.id ])
+    )
+
+    assert Book.exists?(shared_book.id)
+    shared_book.reload
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+    assert shared_book.accessable?(user: bob)
+    assert ReadingMark.exists?(user: bob, leaf: shared_leaf)
+    assert_includes Leaf.search("Shared wisdom"), shared_leaf
+  end
+
+  test "destroying an already-deactivated user erases them and their sign-in events under original email" do
+    alice = User.create!(email_address: "alice-smith+notes@example.com", name: "Alice", password: "secret123456")
+    bob = users(:david)
+
+    session = alice.sessions.start!(user_agent: "TestBrowser", ip_address: "127.0.0.1")
+    session.destroy!
+    bob.sessions.start!(user_agent: "BobBrowser", ip_address: "127.0.0.2")
+
+    assert_equal 2, SignInEvent.for_address("alice-smith+notes@example.com").count
+
+    alice.deactivate
+    assert_not alice.reload.active?
+    assert_match(/\Aalice-smith\+notes-deactivated-.*@example\.com\z/, alice.email_address)
+
+    alice.destroy!
+
+    assert_nil User.find_by(id: alice.id)
+    assert_empty SignInEvent.for_address("alice-smith+notes@example.com")
+    assert_empty SignInEvent.for_address(alice.email_address)
+    assert SignInEvent.for_address(bob.email_address).exists?
+  end
 end
