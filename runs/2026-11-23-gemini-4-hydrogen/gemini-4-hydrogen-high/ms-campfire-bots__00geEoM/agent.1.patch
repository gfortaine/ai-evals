diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..abe7314
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,65 @@
+class Bots::MessagesController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  before_action :authenticate_bot
+  before_action :set_room
+
+  def create
+    @message = create_message
+
+    if @message
+      @message.broadcast_create
+      head :created, location: message_path(@message)
+    else
+      head :unprocessable_content
+    end
+  end
+
+  private
+    def process_action(*)
+      request.request_parameters = {} unless request.media_type == "multipart/form-data"
+      super
+    end
+
+    def authenticate_bot
+      if @bot = User.find_by_bot_token(request.path_parameters[:bot_token])
+        Current.user = @bot
+      else
+        head :unauthorized
+      end
+    end
+
+    def set_room
+      @room = @bot.rooms.find_by(id: request.path_parameters[:room_id])
+      head :not_found unless @room
+    end
+
+    def create_message
+      if attachment = uploaded_attachment
+        @room.messages.create_with_attachment!(creator: @bot, attachment: attachment)
+      elsif (body = formatted_raw_body).present?
+        @room.messages.create!(creator: @bot, body: body)
+      end
+    end
+
+    def uploaded_attachment
+      return unless request.media_type == "multipart/form-data"
+
+      file = params[:attachment].presence || params[:file].presence
+      file if file.respond_to?(:original_filename)
+    end
+
+    def formatted_raw_body
+      return if request.media_type == "multipart/form-data"
+
+      raw_body = request.raw_post.dup.force_encoding("UTF-8")
+      raw_body = raw_body.scrub unless raw_body.valid_encoding?
+      return if raw_body.blank?
+
+      escaped = ERB::Util.html_escape(raw_body.chomp).gsub(/\r?\n/, "<br>")
+      "<div>#{escaped}</div>"
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..22c4b0a
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,63 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ show edit update destroy ]
+  before_action :ensure_can_administer, only: %i[ show edit update destroy ]
+
+  def index
+    @bots = bots_scope.with_attached_avatar.ordered
+  end
+
+  def show
+    redirect_to edit_bot_url(@bot)
+  end
+
+  def new
+    @bot = User.new(role: :bot)
+  end
+
+  def create
+    @bot = User.new(bot_params.merge(role: :bot, creator: Current.user))
+
+    if @bot.save
+      redirect_to bots_url, notice: "✓"
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url, notice: "✓"
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url, notice: "✓"
+  end
+
+  private
+    def bots_scope
+      if Current.user.administrator?
+        User.bots
+      else
+        Current.user.created_bots.active
+      end
+    end
+
+    def set_bot
+      @bot = User.bots.find(params[:id])
+    end
+
+    def ensure_can_administer
+      head :forbidden unless Current.user.can_administer?(@bot)
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
