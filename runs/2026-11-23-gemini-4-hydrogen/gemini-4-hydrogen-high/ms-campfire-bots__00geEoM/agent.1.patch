diff --git a/app/models/user/bot.rb b/app/models/user/bot.rb
new file mode 100644
index 0000000..c73d5bb
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,37 @@
+module User::Bot
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :created_bots, -> { bot }, class_name: "User", foreign_key: :creator_id
+
+    validates :name, presence: true, if: :bot?
+
+    before_validation :ensure_password_digest, if: :bot?
+    before_create :generate_bot_token, if: :bot?
+
+    scope :bots, -> { active.bot }
+    scope :without_bots, -> { where.not(role: :bot) }
+  end
+
+  class_methods do
+    def find_by_bot_token(token)
+      return if token.blank?
+
+      bots.find_by(bot_token: token)
+    end
+  end
+
+  def bot_code
+    bot_token
+  end
+
+  private
+    def ensure_password_digest
+      self.password_digest ||= ""
+    end
+
+    def generate_bot_token
+      self.bot_token ||= SecureRandom.base58(24)
+    end
+end
