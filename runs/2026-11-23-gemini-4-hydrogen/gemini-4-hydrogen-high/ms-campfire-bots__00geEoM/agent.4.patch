diff --git a/docs/bots.md b/docs/bots.md
index 15faede..87cb415 100644
--- a/docs/bots.md
+++ b/docs/bots.md
@@ -14,6 +14,9 @@
 - `BotsController` (`/bots`, `/bots/new`, `/bots/:id/edit`) lists `Current.user.created_bots.active` for members and all `User.bots` for administrators on a single unpaginated page.
 - Bot forms (`app/views/bots/_form.html.erb`) expose `"Name the bot"`, optional `"Webhook URL"`, and the `"Add to all open rooms"` checkbox switch (off by default).
 - `edit`, `update`, and `destroy` require `Current.user.can_administer?(@bot)` (creator or administrator).
+- `Account#settings` includes `bots_per_member` (integer, default `5`, validated `>= 0`), configurable by administrators on `/account/edit` under `"Bots per member"`.
+- `User::Bot#bot_limit_reached?` counts `created_bots.active` (deactivated/deleted bots do not count) against `Account#settings.bots_per_member`; administrators are exempt.
+- At or above the limit, `/bots` hides `"Add a chat bot"` and states the member has `"reached the limit"`. `BotsController#new` and `#create` return `403 Forbidden`, and `User::Bot` validates the limit `on: :create` so lowering the limit blocks new bots without removing or blocking edits/deletions of existing bots.
 
 ## HTTP Message API
 - `POST /rooms/:room_id/:bot_token/messages` (`Bots::MessagesController#create`) authenticates via `User.find_by_bot_token` and scopes the room to `@bot.rooms`.
diff --git a/test/controllers/accounts_controller_test.rb b/test/controllers/accounts_controller_test.rb
index 8292c6f..c27c56e 100644
--- a/test/controllers/accounts_controller_test.rb
+++ b/test/controllers/accounts_controller_test.rb
@@ -58,4 +58,36 @@ class AccountsControllerTest < ActionDispatch::IntegrationTest
     put account_url, params: { account: { name: "Different" } }
     assert_response :forbidden
   end
+  test "edit shows Bots per member setting for administrators only and defaults to 5" do
+    get edit_account_url
+    assert_response :ok
+    assert_select "label", text: /Bots per member/
+    assert_select "input[type='number'][name='account[settings][bots_per_member]'][value='5']"
+
+    sign_in :kevin
+    get edit_account_url
+    assert_response :ok
+    assert_select "input[name='account[settings][bots_per_member]']", count: 0
+  end
+
+  test "admin can update Bots per member setting and invalid values are rejected" do
+    put account_url, params: { account: { settings: { bots_per_member: "3" } } }
+    assert_redirected_to edit_account_url
+    assert_equal 3, accounts(:signal).reload.settings.bots_per_member
+
+    put account_url, params: { account: { settings: { bots_per_member: "-1" } } }
+    assert_response :unprocessable_content
+    assert_equal 3, accounts(:signal).reload.settings.bots_per_member
+
+    put account_url, params: { account: { settings: { bots_per_member: "" } } }
+    assert_response :unprocessable_content
+    assert_equal 3, accounts(:signal).reload.settings.bots_per_member
+  end
+
+  test "non-admins cannot update Bots per member setting" do
+    sign_in :kevin
+    put account_url, params: { account: { settings: { bots_per_member: "10" } } }
+    assert_response :forbidden
+    assert_equal 5, accounts(:signal).reload.settings.bots_per_member
+  end
 end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
index f052f16..25b8e64 100644
--- a/test/controllers/bots_controller_test.rb
+++ b/test/controllers/bots_controller_test.rb
@@ -247,4 +247,72 @@ class BotsControllerTest < ActionDispatch::IntegrationTest
     put session_transfer_url(bot.transfer_id)
     assert_response :bad_request
   end
+  test "member at bot limit does not see Add a chat bot, sees reached the limit, and cannot create new bots" do
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+    bot1 = User.create!(name: "Bot 1", role: :bot, creator: users(:kevin))
+    bot2 = User.create!(name: "Bot 2", role: :bot, creator: users(:kevin))
+
+    get bots_url
+    assert_response :success
+    assert_select "a[href='#{new_bot_path}']", count: 0
+    assert_select "*", text: /Add a chat bot/, count: 0
+    assert_select "p", text: /reached the limit/
+
+    get new_bot_url
+    assert_response :forbidden
+
+    assert_no_difference -> { User.bots.count } do
+      post bots_url, params: { bot: { name: "Bot 3" } }
+    end
+    assert_response :forbidden
+
+    # Existing bots can still be edited and deleted when at or over the limit
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    get bots_url
+    assert_response :success
+    assert_select "li", text: /Bot 1/
+    assert_select "li", text: /Bot 2/
+
+    get edit_bot_url(bot1)
+    assert_response :success
+
+    patch bot_url(bot1), params: { bot: { name: "Bot 1 Renamed" } }
+    assert_redirected_to bots_url
+    assert_equal "Bot 1 Renamed", bot1.reload.name
+
+    # Deleting bots brings member back below limit
+    delete bot_url(bot1)
+    assert_redirected_to bots_url
+    get bots_url
+    assert_select "p", text: /reached the limit/
+
+    delete bot_url(bot2)
+    assert_redirected_to bots_url
+    get bots_url
+    assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+    assert_select "*", text: /reached the limit/, count: 0
+
+    get new_bot_url
+    assert_response :success
+  end
+
+  test "administrators are not limited by bots_per_member" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    User.create!(name: "Admin Bot 1", role: :bot, creator: users(:david))
+    User.create!(name: "Admin Bot 2", role: :bot, creator: users(:david))
+
+    sign_in :david
+    get bots_url
+    assert_response :success
+    assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+    assert_select "*", text: /reached the limit/, count: 0
+
+    get new_bot_url
+    assert_response :success
+
+    assert_difference -> { User.bots.count }, 1 do
+      post bots_url, params: { bot: { name: "Admin Bot 3" } }
+    end
+    assert_redirected_to bots_url
+  end
 end
