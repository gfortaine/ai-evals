@@ -0,0 +1,333 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    host! "once.campfire.test"
+    @bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin), add_to_all_open_rooms: true)
+    @room = rooms(:hq)
+  end
+
+  test "posting a raw text message creates message, broadcasts it, and returns 201 with Location" do
+    assert_difference -> { @room.messages.count }, 1 do
+      post room_bot_messages_url(@room, @bot.bot_code),
+        params: "Deploy of v1.2.3 finished ✅",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+
+    message = @room.messages.ordered.last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal @bot, message.creator
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+  end
+
+  test "raw body preserves special characters, ampersands, angle brackets, and newlines safely" do
+    raw = "Build 100% ok: a=1 & b=2\nExpected <int> got <nil>\nhttps://example.com"
+
+    post room_bot_messages_url(@room, @bot.bot_code),
+      params: raw,
+      headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+
+    assert_response :created
+    message = @room.messages.ordered.last
+    assert_equal raw, message.plain_text_body
+  end
+
+  test "raw body works even when Content-Type is application/json with non-JSON text" do
+    post room_bot_messages_url(@room, @bot.bot_code),
+      params: "Plain text despite json content type",
+      headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :created
+    assert_equal "Plain text despite json content type", @room.messages.ordered.last.plain_text_body
+  end
+
+  test "posting an attachment creates an attachment message and returns 201 with Location" do
+    assert_difference -> { @room.messages.count }, 1 do
+      post room_bot_messages_url(@room, @bot.bot_code),
+        params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+    end
+
+    message = @room.messages.ordered.last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert message.attachment.attached?
+    assert_equal @bot, message.creator
+  end
+
+  test "empty body and no attachment returns 422 Unprocessable Content" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_code), params: ""
+    end
+    assert_response :unprocessable_content
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "   \n  "
+    end
+    assert_response :unprocessable_content
+  end
+
+  test "bad room id returns 404 Not Found" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(999_999, @bot.bot_code), params: "Hello"
+    end
+
+    assert_response :not_found
+  end
+
+  test "closed room without bot membership returns 404 until bot is added" do
+    closed_room = rooms(:designers)
+    assert_not_includes closed_room.users, @bot
+
+    post room_bot_messages_url(closed_room, @bot.bot_code), params: "Hello closed room"
+    assert_response :not_found
+
+    closed_room.memberships.grant_to(@bot)
+    post room_bot_messages_url(closed_room, @bot.bot_code), params: "Hello closed room"
+    assert_response :created
+  end
+
+  test "invalid bot code returns 401 Unauthorized" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, "invalid-bot-code"), params: "Hello"
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "deleted bot can no longer post messages and returns 401 Unauthorized" do
+    code = @bot.bot_code
+    @bot.deactivate
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, code), params: "Hello from beyond"
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "creating a bot message broadcasts to room with bot name and unread to room members" do
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Deploy finished"
+
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author", text: /Deploy Bot/
+      assert_select ".message__body", text: /Deploy finished/
+    end
+
+    @room.users.each do |member|
+      assert_broadcasts UnreadRoomsChannel.stream_name_for(member.id), 1 do
+        post room_bot_messages_url(@room, @bot.bot_code), params: "Ping #{member.id}"
+      end
+    end
+
+    closed_room = rooms(:designers)
+    closed_room.memberships.grant_to(@bot)
+    outsiders = User.where.not(id: closed_room.users.map(&:id))
+    assert outsiders.any?
+    outsiders.each do |outsider|
+      assert_no_broadcasts UnreadRoomsChannel.stream_name_for(outsider.id) do
+        post room_bot_messages_url(closed_room, @bot.bot_code), params: "Closed room ping"
+      end
+    end
+  end
+
+  test "creating a bot message enqueues and triggers push notifications" do
+    closed_room = rooms(:designers)
+    closed_room.memberships.grant_to(@bot)
+
+    assert_enqueued_jobs 1, only: [ Room::PushMessageJob ] do
+      post room_bot_messages_url(closed_room, @bot.bot_code), params: "Alert!"
+    end
+
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      WebPush.expects(:payload_send).times(2)
+      post room_bot_messages_url(closed_room, @bot.bot_code), params: "Alert again!"
+    end
+  end
+
+test "bot message renders in the room with the bot name as author" do
+  post room_bot_messages_url(@room, @bot.bot_code), params: "Deploy of v1.2.3 finished ✅"
+  assert_response :created
+
+  sign_in :kevin
+  get room_url(@room)
+  assert_response :success
+  assert_select ".message__author", text: /Deploy Bot/
+  assert_select ".message__body", text: /Deploy of v1.2.3 finished ✅/
+end
+
+  test "open room without bot membership returns 404 until bot joins" do
+    manual_bot = User.create!(name: "Manual Bot", role: :bot, creator: users(:kevin))
+    assert_not_includes @room.users, manual_bot
+
+    post room_bot_messages_url(@room, manual_bot.bot_code), params: "Hello open room"
+    assert_response :not_found
+
+    manual_bot.update!(add_to_all_open_rooms: true)
+    post room_bot_messages_url(@room, manual_bot.bot_code), params: "Hello open room"
+    assert_response :created
+  end
+test "allows up to 10 messages in any 10 seconds, rejects 11th with 429 and Retry-After, and cools down for 30 seconds" do
+  freeze_time do
+    10.times do |i|
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Message #{i}"
+      assert_response :created
+    end
+
+    assert_no_difference -> { @room.messages.count } do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Message 11"
+    end
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+    assert_not @bot.reload.suspended?
+
+    travel 12.seconds
+    assert_no_difference -> { @room.messages.count } do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "During cooldown"
+    end
+    assert_response :too_many_requests
+    assert_equal "18", response.headers["Retry-After"]
+
+    travel 18.seconds
+    assert_difference -> { @room.messages.count }, 1 do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "After cooldown"
+    end
+    assert_response :created
+  end
+end
+
+test "sliding 10-second window allows messages as older ones age out" do
+  freeze_time do
+    6.times do |i|
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Batch 1 - #{i}"
+      assert_response :created
+    end
+
+    travel 6.seconds
+    4.times do |i|
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Batch 2 - #{i}"
+      assert_response :created
+    end
+
+    travel 4.seconds
+    6.times do |i|
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Batch 3 - #{i}"
+      assert_response :created
+    end
+
+    assert_no_difference -> { @room.messages.count } do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Overflow"
+    end
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+  end
+end
+
+test "five more attempts during the same cooldown suspend the bot, and suspended bot gets 403 Forbidden" do
+  freeze_time do
+    10.times do |i|
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Msg #{i}"
+      assert_response :created
+    end
+
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Over limit"
+    assert_response :too_many_requests
+
+    4.times do |i|
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Cooldown attempt #{i + 1}"
+      assert_response :too_many_requests
+      assert_not @bot.reload.suspended?
+    end
+
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Cooldown attempt 5"
+    assert_response :too_many_requests
+    assert @bot.reload.suspended?
+    assert_match(/flood/i, @bot.suspension_reason)
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "After suspension"
+    end
+    assert_response :forbidden
+
+    post room_bot_messages_url(rooms(:designers), @bot.bot_code), params: "Closed room after suspension"
+    assert_response :forbidden
+  end
+end
+
+test "cooldown attempt count resets across separate cooldowns" do
+  freeze_time do
+    10.times { |i| post room_bot_messages_url(@room, @bot.bot_code), params: "Msg #{i}" }
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Trigger 1"
+    assert_response :too_many_requests
+
+    4.times do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Attempt in cooldown 1"
+      assert_response :too_many_requests
+    end
+    assert_not @bot.reload.suspended?
+
+    travel 30.seconds
+
+    10.times do |i|
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Round 2 - #{i}"
+      assert_response :created
+    end
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Trigger 2"
+    assert_response :too_many_requests
+
+    4.times do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Attempt in cooldown 2"
+      assert_response :too_many_requests
+    end
+    assert_not @bot.reload.suspended?
+
+    post room_bot_messages_url(@room, @bot.bot_code), params: "5th attempt in cooldown 2"
+    assert @bot.reload.suspended?
+  end
+end
+
+test "API messages and webhook replies both count toward flooding limit and cooldown attempts" do
+  @bot.update!(webhook_url: "https://bot.example.com/webhook")
+
+  freeze_time do
+    6.times do |i|
+      post room_bot_messages_url(@room, @bot.bot_code), params: "API #{i}"
+      assert_response :created
+    end
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Webhook reply")
+
+    4.times do |i|
+      trigger = @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(@bot)} ping #{i}</div>")
+      assert_difference -> { @room.messages.count }, 1 do
+        User::Bot::Webhook.new(bot: @bot, message: trigger, event: "mention").deliver
+      end
+    end
+
+    trigger_11 = @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(@bot)} ping 11</div>")
+    assert_no_difference -> { @room.messages.count } do
+      User::Bot::Webhook.new(bot: @bot, message: trigger_11, event: "mention").deliver
+    end
+    assert @bot.reload.in_cooldown?
+
+    3.times do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "During cooldown"
+      assert_response :too_many_requests
+    end
+
+    2.times do |i|
+      t = @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(@bot)} cd #{i}</div>")
+      assert_no_difference -> { @room.messages.count } do
+        User::Bot::Webhook.new(bot: @bot, message: t, event: "mention").deliver
+      end
+    end
+
+    assert @bot.reload.suspended?
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Suspended"
+    assert_response :forbidden
+  end
+end
+end
diff --git a/test/controllers/bots/reactivations_controller_test.rb b/test/controllers/bots/reactivations_controller_test.rb
