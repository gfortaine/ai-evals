diff --git a/app/models/user/bot.rb b/app/models/user/bot.rb
new file mode 100644
index 0000000..4b897cc
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,194 @@
+module User::Bot
+  extend ActiveSupport::Concern
+
+  RATE_LIMIT_WINDOW = 10.seconds
+  RATE_LIMIT_MAX_MESSAGES = 10
+  COOLDOWN_DURATION = 30.seconds
+  COOLDOWN_MAX_ATTEMPTS = 5
+  MAX_CONSECUTIVE_WEBHOOK_FAILURES = 10
+
+  FLOODING_SUSPENSION_REASON = "Flooding: too many post attempts during cooldown"
+  WEBHOOK_SUSPENSION_REASON = "Failing webhooks: 10 consecutive failed deliveries"
+
+  included do
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :created_bots, -> { bot }, class_name: "User", foreign_key: :creator_id
+
+    normalizes :webhook_url, with: ->(url) { url.strip.presence }
+
+    validates :name, presence: true, if: :bot?
+    validate :validate_webhook_url, if: -> { bot? && webhook_url.present? }
+    validate :validate_bot_limit, on: :create, if: :bot?
+
+    before_validation :ensure_password_digest, if: :bot?
+    before_create :generate_bot_token, if: :bot?
+    after_save_commit :sync_open_room_memberships, if: :should_sync_open_room_memberships?
+
+    scope :bots, -> { active.bot }
+    scope :without_bots, -> { where.not(role: :bot) }
+    scope :unsuspended, -> { where(suspended_at: nil) }
+    scope :suspended, -> { where.not(suspended_at: nil) }
+  end
+
+  class_methods do
+    def find_by_bot_token(token)
+      return if token.blank?
+
+      bots.find_by(bot_token: token)
+    end
+  end
+
+  def bot_code
+    bot_token
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def in_cooldown?(now = Time.current)
+    cooldown_until.present? && now < cooldown_until
+  end
+
+  def cooldown_retry_after(now = Time.current)
+    return 0 unless in_cooldown?(now)
+
+    (cooldown_until - now).ceil.clamp(1, COOLDOWN_DURATION.to_i)
+  end
+
+  def bot_limit_reached?(account = Current.account)
+    return false if administrator? || account.nil?
+
+    created_bots.active.count >= account.settings.bots_per_member
+  end
+
+  def deliver_webhook_later(message)
+    User::Bot::WebhookJob.perform_later(self, message) if active? && !suspended? && bot? && webhook_url.present?
+  end
+
+  def deliver_joined_webhook_later(room)
+    if active? && !suspended? && bot? && webhook_url.present? && !room.direct?
+      User::Bot::WebhookJob.perform_later(self, room, event: "joined")
+    end
+  end
+
+  def post_message_with_rate_limit(has_content: true)
+    with_lock do
+      now = Time.current
+      return [ :suspended, nil ] if suspended?
+
+      if in_cooldown?(now)
+        attempts = cooldown_attempts + 1
+        retry_after = cooldown_retry_after(now)
+
+        if attempts >= COOLDOWN_MAX_ATTEMPTS
+          update!(
+            cooldown_attempts: attempts,
+            suspended_at: now,
+            suspension_reason: FLOODING_SUSPENSION_REASON
+          )
+        else
+          update!(cooldown_attempts: attempts)
+        end
+
+        return [ :cooldown, retry_after ]
+      end
+
+      return [ :unprocessable, nil ] unless has_content
+
+      if flooding?(now)
+        update!(cooldown_until: now + COOLDOWN_DURATION, cooldown_attempts: 0)
+        return [ :cooldown, COOLDOWN_DURATION.to_i ]
+      end
+
+      if cooldown_until.present? || cooldown_attempts.positive?
+        update!(cooldown_until: nil, cooldown_attempts: 0)
+      end
+
+      message = yield
+      [ :ok, message ]
+    end
+  end
+
+  def record_webhook_delivery!(success:)
+    with_lock do
+      return if suspended?
+
+      if success
+        update!(consecutive_webhook_failures: 0) if consecutive_webhook_failures.positive?
+      else
+        failures = consecutive_webhook_failures + 1
+        if failures >= MAX_CONSECUTIVE_WEBHOOK_FAILURES
+          update!(
+            consecutive_webhook_failures: failures,
+            suspended_at: Time.current,
+            suspension_reason: WEBHOOK_SUSPENSION_REASON
+          )
+        else
+          update!(consecutive_webhook_failures: failures)
+        end
+      end
+    end
+  end
+
+  def reactivate
+    with_lock do
+      update!(
+        suspended_at: nil,
+        suspension_reason: nil,
+        cooldown_until: nil,
+        cooldown_attempts: 0,
+        consecutive_webhook_failures: 0,
+        flood_reset_message_id: messages.maximum(:id) || 0
+      )
+    end
+  end
+
+  private
+    def flooding?(now = Time.current)
+      scope = messages.where("created_at > ?", now - RATE_LIMIT_WINDOW)
+      scope = scope.where("id > ?", flood_reset_message_id) if flood_reset_message_id.present?
+      scope.count >= RATE_LIMIT_MAX_MESSAGES
+    end
+
+    def ensure_password_digest
+      self.password_digest ||= ""
+    end
+
+    def generate_bot_token
+      self.bot_token ||= SecureRandom.base58(24)
+    end
+
+    def should_sync_open_room_memberships?
+      bot? && active? && add_to_all_open_rooms? && (previously_new_record? || add_to_all_open_rooms_previously_changed?)
+    end
+
+    def sync_open_room_memberships
+      open_room_ids = Rooms::Open.pluck(:id)
+      return if open_room_ids.empty?
+
+      inserted = Membership.insert_all(
+        open_room_ids.collect { |room_id| { room_id: room_id, user_id: id } },
+        returning: %i[ room_id ]
+      )
+
+      Rooms::Open.where(id: inserted.rows.flatten).find_each do |room|
+        deliver_joined_webhook_later(room)
+      end
+    end
+
+    def validate_webhook_url
+      uri = URI.parse(webhook_url)
+      unless uri.is_a?(URI::HTTP) && uri.host.present?
+        errors.add(:webhook_url, "is invalid")
+      end
+    rescue URI::InvalidURIError
+      errors.add(:webhook_url, "is invalid")
+    end
+
+    def validate_bot_limit
+      if creator&.bot_limit_reached?
+        errors.add(:base, "You have reached the limit of #{Current.account.settings.bots_per_member} bots")
+      end
+    end
+end
diff --git a/app/models/user/bot/webhook.rb b/app/models/user/bot/webhook.rb
new file mode 100644
index 0000000..261486d
--- /dev/null
+++ b/app/models/user/bot/webhook.rb
@@ -0,0 +1,150 @@
+require "net/http"
+
+class User::Bot::Webhook
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+
+  attr_reader :bot, :event, :message
+
+  def initialize(bot:, message: nil, room: nil, event: message ? "mention" : "joined")
+    @bot = bot
+    @message = message
+    @room = room || message&.room
+    @event = event
+  end
+
+  def deliver
+    return unless deliverable?
+
+    response = post_payload
+    bot.record_webhook_delivery!(success: response.is_a?(Net::HTTPSuccess))
+    handle_response(response) if response
+  end
+
+  def payload
+    case event
+    when "mention"
+      mention_payload
+    when "joined"
+      joined_payload
+    end
+  end
+
+  private
+    def room
+      @room
+    end
+
+    def room_name
+      room.name.presence || room.users.without(bot).pluck(:name).to_sentence.presence
+    end
+
+    def deliverable?
+      return false unless bot.active? && !bot.suspended? && bot.bot? && bot.webhook_url.present?
+      return false unless room && room.users.exists?(bot.id)
+
+      case event
+      when "mention"
+        message.present? && message.creator_id != bot.id
+      when "joined"
+        !room.direct?
+      else
+        false
+      end
+    end
+
+    def mention_payload
+      {
+        event: "mention",
+        author: {
+          id: message.creator_id,
+          name: message.creator.name
+        },
+        room: room_payload,
+        message: {
+          id: message.id,
+          body: {
+            text: stripped_plain_text_body,
+            html: message.body.body&.to_html.to_s
+          },
+          link: routes.room_at_message_path(room, message)
+        }
+      }
+    end
+
+    def joined_payload
+      {
+        event: "joined",
+        room: room_payload
+      }
+    end
+
+    def room_payload
+      {
+        id: room.id,
+        name: room_name,
+        reply_to: routes.room_bot_messages_path(room, bot.bot_code)
+      }
+    end
+
+    def post_payload
+      uri = URI.parse(bot.webhook_url)
+      return nil unless uri.is_a?(URI::HTTP) && uri.host.present?
+
+      request = Net::HTTP::Post.new(uri)
+      request["Content-Type"] = "application/json"
+      request.body = payload.to_json
+
+      Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT) do |http|
+        http.request(request)
+      end
+    rescue StandardError => e
+      Rails.logger.warn "Failed to deliver webhook for bot #{bot.id} to #{bot.webhook_url}: #{e.class} #{e.message}"
+      nil
+    end
+
+    def handle_response(response)
+      return unless response.is_a?(Net::HTTPOK)
+
+      body = formatted_reply_body(response)
+      return if body.blank?
+
+      status, reply = bot.post_message_with_rate_limit do
+        room.messages.create!(creator: bot, body: body)
+      end
+
+      reply.broadcast_create if status == :ok && reply
+    end
+
+    def formatted_reply_body(response)
+      raw_body = response.body.to_s.dup.force_encoding("UTF-8")
+      raw_body = raw_body.scrub unless raw_body.valid_encoding?
+      return if raw_body.blank?
+
+      case response.content_type&.downcase
+      when "text/plain"
+        escaped = ERB::Util.html_escape(raw_body.chomp).gsub(/\r?\n/, "<br>")
+        "<div>#{escaped}</div>"
+      when "text/html"
+        raw_body
+      end
+    end
+
+    def stripped_plain_text_body
+      return "" unless message.body.body
+
+      rendered = message.body.body.render_attachments do |attachment|
+        attachment.attachable == bot ? "" : attachment.to_plain_text
+      end
+
+      rendered.to_plain_text
+        .gsub(/\u00A0/, " ")
+        .gsub(/[^\S\n]+/, " ")
+        .gsub(/ *\n */, "\n")
+        .strip
+    end
+
+    def routes
+      Rails.application.routes.url_helpers
+    end
+end
