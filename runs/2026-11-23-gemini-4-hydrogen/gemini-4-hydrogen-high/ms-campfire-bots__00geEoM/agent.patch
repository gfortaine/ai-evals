+require "test_helper"
+
+class User::Bot::WebhookTest < ActionDispatch::IntegrationTest
+  setup do
+    @room = rooms(:hq)
+    @bot = User.create!(
+      name: "Deploy Bot",
+      role: :bot,
+      creator: users(:kevin),
+      webhook_url: "https://bot.example.com/webhook"
+    )
+    @room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+    sign_in :david
+  end
+
+  test "mentioning a bot with a webhook enqueues User::Bot::WebhookJob without making synchronous HTTP calls" do
+    assert_enqueued_jobs 1, only: User::Bot::WebhookJob do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(@bot)} restart the build please</div>" }
+      }
+      assert_response :success
+    end
+  end
+
+  test "mentioning a bot without a webhook URL does not enqueue User::Bot::WebhookJob" do
+    @bot.update!(webhook_url: nil)
+
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+      @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(@bot)} hello</div>"
+      )
+    end
+  end
+
+  test "mentioning a human user does not enqueue User::Bot::WebhookJob" do
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+      @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(:jason)} hello</div>"
+      )
+    end
+  end
+
+  test "mentioning the same bot twice in one message enqueues only one webhook job" do
+    assert_enqueued_jobs 1, only: User::Bot::WebhookJob do
+      @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(@bot)} check #{mention_attachment_for(@bot)}</div>"
+      )
+    end
+  end
+
+  test "mentioning a bot in a closed room it does not belong to does not trigger its webhook" do
+    closed_room = rooms(:designers)
+    assert_not_includes closed_room.users, @bot
+
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
