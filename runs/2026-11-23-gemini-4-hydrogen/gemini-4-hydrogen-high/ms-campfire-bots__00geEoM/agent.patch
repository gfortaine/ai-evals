+  User::Bot::Webhook.new(bot: @bot, message: message, event: "mention").deliver
+  assert_equal 0, @bot.reload.consecutive_webhook_failures
+  assert_not @bot.suspended?
+
+  # 9 more failures still don't suspend; 10th suspends
+  WebMock.stub_request(:post, "https://bot.example.com/webhook").to_return(status: 500)
+  9.times do
