diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..4b391fb
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,78 @@
+class Bots::MessagesController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  before_action :authenticate_bot
+  before_action :ensure_not_suspended
+  before_action :set_room
+
+  def create
+    attachment = uploaded_attachment
+    body = attachment ? nil : formatted_raw_body
+
+    status, result = @bot.post_message_with_rate_limit(has_content: attachment.present? || body.present?) do
+      if attachment
+        @room.messages.create!(creator: @bot, attachment: attachment)
+      else
+        @room.messages.create!(creator: @bot, body: body)
+      end
+    end
+
+    case status
+    when :ok
+      result.process_attachment if attachment
+      result.broadcast_create
+      head :created, location: message_path(result)
+    when :cooldown
+      response.set_header("Retry-After", result.to_s)
+      head :too_many_requests
+    when :suspended
+      head :forbidden
+    when :unprocessable
+      head :unprocessable_content
+    end
+  end
+
+  private
+    def process_action(*)
+      request.request_parameters = {} unless request.media_type == "multipart/form-data"
+      super
+    end
+
+    def authenticate_bot
+      if @bot = User.find_by_bot_token(request.path_parameters[:bot_token])
+        Current.user = @bot
+      else
+        head :unauthorized
+      end
+    end
+
+    def ensure_not_suspended
+      head :forbidden if @bot.suspended?
+    end
+
+    def set_room
+      @room = @bot.rooms.find_by(id: request.path_parameters[:room_id])
+      head :not_found unless @room
+    end
+
+    def uploaded_attachment
+      return unless request.media_type == "multipart/form-data"
+
+      file = params[:attachment].presence || params[:file].presence
+      file if file.respond_to?(:original_filename)
+    end
+
+    def formatted_raw_body
+      return if request.media_type == "multipart/form-data"
+
+      raw_body = request.raw_post.dup.force_encoding("UTF-8")
+      raw_body = raw_body.scrub unless raw_body.valid_encoding?
+      return if raw_body.blank?
+
+      escaped = ERB::Util.html_escape(raw_body.chomp).gsub(/\r?\n/, "<br>")
+      "<div>#{escaped}</div>"
+    end
+end
