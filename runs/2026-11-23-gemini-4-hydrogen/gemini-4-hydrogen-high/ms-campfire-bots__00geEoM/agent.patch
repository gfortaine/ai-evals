@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Bots::ReactivationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = User.create!(
+      name: "Deploy Bot",
+      role: :bot,
+      creator: users(:kevin),
+      add_to_all_open_rooms: true,
+      webhook_url: "https://bot.example.com/webhook",
+      suspended_at: Time.current,
+      suspension_reason: User::Bot::WEBHOOK_SUSPENSION_REASON,
+      consecutive_webhook_failures: 10,
+      cooldown_until: 30.seconds.from_now,
+      cooldown_attempts: 5
+    )
+  end
+
+  test "non-administrators including bot creator receive 403 Forbidden and cannot reactivate" do
+    sign_in :kevin
+
+    post bot_reactivation_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "administrators can reactivate a suspended bot and it can post and receive webhooks again" do
+    sign_in :david
+
+    post bot_reactivation_url(@bot)
+    assert_redirected_to bots_url
+    assert_not @bot.reload.suspended?
+    assert_nil @bot.suspension_reason
+    assert_equal 0, @bot.consecutive_webhook_failures
+
+    get bots_url
+    assert_response :success
+    assert_select "li##{dom_id(@bot)}" do
+      assert_select "*", text: /Suspended/, count: 0
+      assert_select "button", text: /Reactivate/, count: 0
+    end
+
+    # Posting endpoint works immediately
+    post room_bot_messages_url(rooms(:hq), @bot.bot_code), params: "I am back!"
+    assert_response :created
+
+    # Webhooks work again
+    WebMock.stub_request(:post, "https://bot.example.com/webhook").to_return(status: 204)
+    assert_enqueued_jobs 1, only: User::Bot::WebhookJob do
+      rooms(:hq).messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(@bot)} welcome back</div>")
+    end
+    perform_enqueued_jobs only: User::Bot::WebhookJob
+    assert_requested :post, "https://bot.example.com/webhook"
+  end
+end
