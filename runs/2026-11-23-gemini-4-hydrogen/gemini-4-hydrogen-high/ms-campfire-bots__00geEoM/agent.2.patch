@@ -0,0 +1,298 @@
+require "test_helper"
+
+class User::Bot::WebhookTest < ActionDispatch::IntegrationTest
+  setup do
+    @room = rooms(:hq)
+    @bot = User.create!(
+      name: "Deploy Bot",
+      role: :bot,
+      creator: users(:kevin),
+      webhook_url: "https://bot.example.com/webhook"
+    )
+    sign_in :david
+  end
+
+  test "mentioning a bot with a webhook enqueues User::Bot::WebhookJob without making synchronous HTTP calls" do
+    assert_enqueued_jobs 1, only: User::Bot::WebhookJob do
+      post room_messages_url(@room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_attachment_for(@bot)} restart the build please</div>" }
+      }
+      assert_response :success
+    end
+  end
+
+  test "mentioning a bot without a webhook URL does not enqueue User::Bot::WebhookJob" do
+    @bot.update!(webhook_url: nil)
+
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+      @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(@bot)} hello</div>"
+      )
+    end
+  end
+
+  test "mentioning a human user does not enqueue User::Bot::WebhookJob" do
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+      @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(:jason)} hello</div>"
+      )
+    end
+  end
+
+  test "mentioning the same bot twice in one message enqueues only one webhook job" do
+    assert_enqueued_jobs 1, only: User::Bot::WebhookJob do
+      @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(@bot)} check #{mention_attachment_for(@bot)}</div>"
+      )
+    end
+  end
+
+  test "mentioning a bot in a closed room it does not belong to does not trigger its webhook" do
+    closed_room = rooms(:designers)
+    assert_not_includes closed_room.users, @bot
+
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+      closed_room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(@bot)} secret</div>"
+      )
+    end
+  end
+
+  test "webhook delivers expected JSON payload with bot mention stripped from text" do
+    captured_payload = nil
+    captured_headers = nil
+
+    stub = WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .with { |req|
+        captured_headers = req.headers
+        captured_payload = JSON.parse(req.body)
+        true
+      }
+      .to_return(status: 204)
+
+    message = nil
+    perform_enqueued_jobs only: User::Bot::WebhookJob do
+      message = @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(@bot)}&nbsp;restart <strong>the build</strong> please</div>"
+      )
+    end
+
+    assert_requested stub
+    assert_equal "application/json", captured_headers["Content-Type"]
+    assert_equal "mention", captured_payload["event"]
+    assert_equal({ "id" => users(:david).id, "name" => "David" }, captured_payload["author"])
+    assert_equal({
+      "id" => @room.id,
+      "name" => @room.name,
+      "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_code}/messages"
+    }, captured_payload["room"])
+    assert_equal message.id, captured_payload.dig("message", "id")
+    assert_equal "restart the build please", captured_payload.dig("message", "body", "text")
+    assert_includes captured_payload.dig("message", "body", "html"), "<strong>the build</strong>"
+    assert_includes captured_payload.dig("message", "body", "html"), @bot.attachable_sgid
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", captured_payload.dig("message", "link")
+  end
+
+  test "mentioning two bots strips only each bot's own mention from its payload" do
+    other_bot = User.create!(
+      name: "Ops Bot",
+      role: :bot,
+      creator: users(:kevin),
+      webhook_url: "https://ops.example.com/webhook"
+    )
+
+    payloads = {}
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .with { |req| payloads[:deploy] = JSON.parse(req.body); true }
+      .to_return(status: 204)
+    WebMock.stub_request(:post, "https://ops.example.com/webhook")
+      .with { |req| payloads[:ops] = JSON.parse(req.body); true }
+      .to_return(status: 204)
+
+    perform_enqueued_jobs only: User::Bot::WebhookJob do
+      @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(@bot)} #{mention_attachment_for(other_bot)} status check</div>"
+      )
+    end
+
+    assert_equal "@Ops Bot status check", payloads[:deploy].dig("message", "body", "text")
+    assert_equal "/rooms/#{@room.id}/#{@bot.bot_code}/messages", payloads[:deploy].dig("room", "reply_to")
+
+    assert_equal "@Deploy Bot status check", payloads[:ops].dig("message", "body", "text")
+    assert_equal "/rooms/#{@room.id}/#{other_bot.bot_code}/messages", payloads[:ops].dig("room", "reply_to")
+  end
+
+  test "stripping mention handles middle, end, bare mention, and multiline messages" do
+    cases = [
+      [ "<div>hey #{mention_attachment_for(@bot)} restart now</div>", "hey restart now" ],
+      [ "<div>restart now #{mention_attachment_for(@bot)}</div>", "restart now" ],
+      [ "<div>#{mention_attachment_for(@bot)}</div>", "" ],
+      [ "<div>#{mention_attachment_for(@bot)}</div><div>line 1</div><div>line 2</div>", "line 1\nline 2" ]
+    ]
+
+    cases.each do |html, expected_text|
+      message = @room.messages.create!(creator: users(:david), body: html)
+      payload = User::Bot::Webhook.new(bot: @bot, message: message).payload
+      assert_equal expected_text, payload.dig(:message, :body, :text)
+    end
+  end
+
+  test "200 text/plain response posts reply into the room as the bot and broadcasts it" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(
+        status: 200,
+        headers: { "Content-Type" => "text/plain; charset=utf-8" },
+        body: "Build 100% ok: <ready>\nLine 2"
+      )
+
+    assert_difference -> { @room.messages.count }, 2 do
+      perform_enqueued_jobs only: User::Bot::WebhookJob do
+        @room.messages.create!(
+          creator: users(:david),
+          body: "<div>#{mention_attachment_for(@bot)} status</div>"
+        )
+      end
+    end
+
+    reply = @room.messages.ordered.last
+    assert_equal @bot, reply.creator
+    assert_equal "Build 100% ok: <ready>\nLine 2", reply.plain_text_body
+
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author", text: /Deploy Bot/
+    end
+  end
+
+  test "200 text/html response posts rich HTML reply into the room as the bot" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(
+        status: 200,
+        headers: { "Content-Type" => "text/html; charset=utf-8" },
+        body: "<div>Build <strong>#42</strong> restarted!</div>"
+      )
+
+    assert_difference -> { @room.messages.count }, 2 do
+      perform_enqueued_jobs only: User::Bot::WebhookJob do
+        @room.messages.create!(
+          creator: users(:david),
+          body: "<div>#{mention_attachment_for(@bot)} restart</div>"
+        )
+      end
+    end
+
+    reply = @room.messages.ordered.last
+    assert_equal @bot, reply.creator
+    assert_equal "Build #42 restarted!", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "<strong>#42</strong>"
+  end
+
+  test "204 response does not post any message" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 204)
+
+    assert_difference -> { @room.messages.count }, 1 do
+      perform_enqueued_jobs only: User::Bot::WebhookJob do
+        @room.messages.create!(
+          creator: users(:david),
+          body: "<div>#{mention_attachment_for(@bot)} ping</div>"
+        )
+      end
+    end
+  end
+
+  test "200 with blank body or unsupported content type does not post any message" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "   ")
+
+    assert_difference -> { @room.messages.count }, 1 do
+      perform_enqueued_jobs only: User::Bot::WebhookJob do
+        @room.messages.create!(
+          creator: users(:david),
+          body: "<div>#{mention_attachment_for(@bot)} ping</div>"
+        )
+      end
+    end
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "application/json" }, body: '{"ok":true}')
+
+    assert_difference -> { @room.messages.count }, 1 do
+      perform_enqueued_jobs only: User::Bot::WebhookJob do
+        @room.messages.create!(
+          creator: users(:david),
+          body: "<div>#{mention_attachment_for(@bot)} ping</div>"
+        )
+      end
+    end
+  end
+
+  test "webhook network failure or 500 error does not raise or post a message" do
+    WebMock.stub_request(:post, "https://bot.example.com/webhook").to_timeout
+
+    assert_difference -> { @room.messages.count }, 1 do
+      perform_enqueued_jobs only: User::Bot::WebhookJob do
+        @room.messages.create!(
+          creator: users(:david),
+          body: "<div>#{mention_attachment_for(@bot)} ping</div>"
+        )
+      end
+    end
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook").to_return(status: 500, body: "Internal error")
+
+    assert_difference -> { @room.messages.count }, 1 do
+      perform_enqueued_jobs only: User::Bot::WebhookJob do
+        @room.messages.create!(
+          creator: users(:david),
+          body: "<div>#{mention_attachment_for(@bot)} ping</div>"
+        )
+      end
+    end
+  end
+
+  test "bot can return 204 and reply asynchronously later using room.reply_to from payload" do
+    captured_reply_to = nil
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .with { |req| captured_reply_to = JSON.parse(req.body).dig("room", "reply_to"); true }
+      .to_return(status: 204)
+
+    perform_enqueued_jobs only: User::Bot::WebhookJob do
+      @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(@bot)} deploy async</div>"
+      )
+    end
+
+    assert_difference -> { @room.messages.count }, 1 do
+      post captured_reply_to, params: "Deploy finished asynchronously!"
+      assert_response :created
+    end
+
+    reply = @room.messages.ordered.last
+    assert_equal @bot, reply.creator
+    assert_equal "Deploy finished asynchronously!", reply.plain_text_body
+  end
+
+  test "deactivated bot or deleted message is ignored when job runs" do
+    message = @room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} hello</div>"
+    )
+
+    @bot.deactivate
+    assert_no_difference -> { @room.messages.count } do
+      perform_enqueued_jobs only: User::Bot::WebhookJob
+    end
+
+    message.destroy!
+    assert_nothing_raised do
+      perform_enqueued_jobs only: User::Bot::WebhookJob
+    end
+  end
+end
