diff --git a/test/models/user/bot/webhook_test.rb b/test/models/user/bot/webhook_test.rb
index 5ae808f..3d51a24 100644
--- a/test/models/user/bot/webhook_test.rb
+++ b/test/models/user/bot/webhook_test.rb
@@ -533,4 +533,90 @@ class User::Bot::WebhookTest < ActionDispatch::IntegrationTest
       perform_enqueued_jobs only: User::Bot::WebhookJob
     end
   end
+test "10 consecutive failed webhook deliveries suspend the bot, and a 2xx delivery resets the count" do
+  message = @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+
+  WebMock.stub_request(:post, "https://bot.example.com/webhook")
+    .to_return(
+      { status: 500 },
+      { status: 404 },
+      { status: 302 },
+      { status: 400 },
+      { status: 502 },
+      { status: 503 },
+      { status: 429 }
+    )
+    .then.to_timeout
+    .then.to_raise(Errno::ECONNREFUSED)
+
+  9.times do
+    User::Bot::Webhook.new(bot: @bot, message: message, event: "mention").deliver
+    assert_not @bot.reload.suspended?
+  end
+  assert_equal 9, @bot.consecutive_webhook_failures
+
+  # Any 2xx resets the failure count
+  WebMock.stub_request(:post, "https://bot.example.com/webhook").to_return(status: 204)
+  User::Bot::Webhook.new(bot: @bot, message: message, event: "mention").deliver
+  assert_equal 0, @bot.reload.consecutive_webhook_failures
+  assert_not @bot.suspended?
+
+  # 9 more failures still don't suspend; 10th suspends
+  WebMock.stub_request(:post, "https://bot.example.com/webhook").to_return(status: 500)
+  9.times do
+    User::Bot::Webhook.new(bot: @bot, message: message, event: "mention").deliver
+    assert_not @bot.reload.suspended?
+  end
+
+  User::Bot::Webhook.new(bot: @bot, message: message, event: "mention").deliver
+  assert @bot.reload.suspended?
+  assert_equal 10, @bot.consecutive_webhook_failures
+  assert_match(/webhook/i, @bot.suspension_reason)
+end
+
+test "suspended bot receives no webhooks even if previously enqueued" do
+  closed = rooms(:designers)
+  closed.memberships.grant_to(@bot)
+  mention_msg = @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(@bot)} hello</div>")
+  assert_enqueued_jobs 2, only: User::Bot::WebhookJob
+
+  @bot.update!(suspended_at: Time.current, suspension_reason: "Failing webhooks")
+
+  # Previously enqueued jobs do not make HTTP calls when performed
+  perform_enqueued_jobs only: User::Bot::WebhookJob
+  assert_not_requested :post, "https://bot.example.com/webhook"
+
+  # New mentions or room joins do not even enqueue WebhookJob
+  assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+    @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(@bot)} again</div>")
+    rooms(:watercooler).memberships.grant_to(@bot)
+  end
+end
+
+test "webhook replies are not posted during cooldown and 204 does not count as post attempt" do
+  WebMock.stub_request(:post, "https://bot.example.com/webhook")
+    .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Reply")
+
+  freeze_time do
+    10.times do |i|
+      msg = @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(@bot)} #{i}</div>")
+      User::Bot::Webhook.new(bot: @bot, message: msg, event: "mention").deliver
+    end
+
+    # 11th reply triggers cooldown
+    msg11 = @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(@bot)} 11</div>")
+    assert_no_difference -> { @room.messages.count } do
+      User::Bot::Webhook.new(bot: @bot, message: msg11, event: "mention").deliver
+    end
+    assert @bot.reload.in_cooldown?
+
+    # 204 response during cooldown is not a post attempt and does not suspend
+    WebMock.stub_request(:post, "https://bot.example.com/webhook").to_return(status: 204)
+    5.times do |i|
+      msg = @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(@bot)} noop #{i}</div>")
+      User::Bot::Webhook.new(bot: @bot, message: msg, event: "mention").deliver
+    end
+    assert_not @bot.reload.suspended?
+  end
+end
 end
