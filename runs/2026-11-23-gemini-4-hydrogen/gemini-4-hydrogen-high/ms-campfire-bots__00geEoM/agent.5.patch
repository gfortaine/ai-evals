+  def post_message_with_rate_limit(has_content: true)
+    with_lock do
+      now = Time.current
+      return [ :suspended, nil ] if suspended?
+
+      if in_cooldown?(now)
+        attempts = cooldown_attempts + 1
+        retry_after = cooldown_retry_after(now)
+
+        if attempts >= COOLDOWN_MAX_ATTEMPTS
+          update!(
+            cooldown_attempts: attempts,
+            suspended_at: now,
+            suspension_reason: FLOODING_SUSPENSION_REASON
+          )
+        else
+          update!(cooldown_attempts: attempts)
+        end
+
+        return [ :cooldown, retry_after ]
+      end
+
+      return [ :unprocessable, nil ] unless has_content
+
+      if flooding?(now)
+        update!(cooldown_until: now + COOLDOWN_DURATION, cooldown_attempts: 0)
+        return [ :cooldown, COOLDOWN_DURATION.to_i ]
+      end
+
+      if cooldown_until.present? || cooldown_attempts.positive?
+        update!(cooldown_until: nil, cooldown_attempts: 0)
+      end
+
+      message = yield
+      [ :ok, message ]
+    end
+  end
+
+  def record_webhook_delivery!(success:)
+    with_lock do
+      return if suspended?
+
+      if success
+        update!(consecutive_webhook_failures: 0) if consecutive_webhook_failures.positive?
+      else
+        failures = consecutive_webhook_failures + 1
+        if failures >= MAX_CONSECUTIVE_WEBHOOK_FAILURES
+          update!(
+            consecutive_webhook_failures: failures,
+            suspended_at: Time.current,
+            suspension_reason: WEBHOOK_SUSPENSION_REASON
+          )
+        else
+          update!(consecutive_webhook_failures: failures)
+        end
+      end
+    end
+  end
+
+  def reactivate
+    with_lock do
+      update!(
+        suspended_at: nil,
+        suspension_reason: nil,
+        cooldown_until: nil,
+        cooldown_attempts: 0,
+        consecutive_webhook_failures: 0,
+        flood_reset_message_id: messages.maximum(:id) || 0
+      )
+    end
+  end
+
   private
+    def flooding?(now = Time.current)
+      scope = messages.where("created_at > ?", now - RATE_LIMIT_WINDOW)
+      scope = scope.where("id > ?", flood_reset_message_id) if flood_reset_message_id.present?
+      scope.count >= RATE_LIMIT_MAX_MESSAGES
+    end
