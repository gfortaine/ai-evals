+module Card::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    around_destroy :suppress_storage_tracking
+    after_update :mark_board_change_for_storage, if: :saved_change_to_board_id?
+    after_update_commit :sync_board_change_storage_later
+    after_destroy :mark_storage_cleanup
+    after_destroy_commit :cleanup_storage_later
+  end
+
+  def sync_storage_later
+    ::Storage.sync_later(self)
+  end
+
+  def sync_storage_now
+    ::Storage::TrackedRecord.sync_card_now(id)
+  end
+
+  def storage_bytes_used
+    image_bytes + description_embeds_bytes
+  end
+
+  private
+    def image_bytes
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record: self, name: "image")
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def description_embeds_bytes
+      ActionText::RichText
+        .where(record: self, name: "description")
+        .joins(embeds_attachments: :blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def mark_board_change_for_storage
+      @board_changed_for_storage = ::Storage::TrackedRecord.where(card_id: id).exists?
+    end
+
+    def sync_board_change_storage_later
+      if @board_changed_for_storage
+        @board_changed_for_storage = false
+        sync_storage_later
+      end
+    end
+
+    def suppress_storage_tracking(&block)
+      ::Storage.suppressing_destroy(self, &block)
+    end
+
+    def mark_storage_cleanup
+      @enqueue_storage_cleanup = !::Storage.suppressed_by_parent?(self) &&
+        ::Storage::TrackedRecord.where(card_id: id).lock.any?
+    end
+
+    def cleanup_storage_later
+      if @enqueue_storage_cleanup
+        @enqueue_storage_cleanup = false
+        ::Storage::CleanupJob.perform_later("Card", id, account_id)
+      end
+    end
+end
