+require "test_helper"
+
+class StorageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @other_account = accounts(:initech)
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    Current.session = sessions(:david)
+  end
+
+  test "bytes_used defaults to zero for accounts and boards" do
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "tracks card images in the background" do
+    blob = upload_blob("moon.jpg", "image/jpeg")
+
+    card = nil
+    assert_enqueued_with(job: Storage::SyncJob) do
+      card = @board.cards.create!(title: "Image card", status: :published, image: blob)
+    end
+
+    # Not calculated synchronously in the request
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 0, @other_account.bytes_used
+  end
+
+  test "tracks replacing and removing card images via update, purge_later, purge, and detach" do
+    blob1 = upload_blob("moon.jpg", "image/jpeg")
+    blob2 = upload_blob("avatar.png", "image/png")
+
+    card = @board.cards.create!(title: "Image card", status: :published, image: blob1)
+    perform_enqueued_jobs
+    assert_equal blob1.byte_size, @board.bytes_used
+
+    # Replace image
+    card.update!(image: blob2)
+    perform_enqueued_jobs
+    assert_equal blob2.byte_size, @board.bytes_used
+    assert_equal blob2.byte_size, @account.bytes_used
+
+    # Purge later (used by Cards::ImagesController#destroy)
+    card.image.purge_later
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    # Re-attach and purge synchronously
+    blob3 = upload_blob("moon.jpg", "image/jpeg")
+    card.image.attach(blob3)
+    perform_enqueued_jobs
+    assert_equal blob3.byte_size, @board.bytes_used
+
+    card.image.purge
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+
+    # Re-attach and detach
+    blob4 = upload_blob("avatar.png", "image/png")
+    card.image.attach(blob4)
+    perform_enqueued_jobs
+    assert_equal blob4.byte_size, @board.bytes_used
+
+    card.image.detach
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    # Re-attach and clear via image: nil
+    blob5 = upload_blob("moon.jpg", "image/jpeg")
+    card.image.attach(blob5)
+    perform_enqueued_jobs
+    assert_equal blob5.byte_size, @board.bytes_used
+
+    card.update!(image: nil)
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "tracks files embedded in board descriptions, card descriptions, and comments" do
+    board_blob = upload_blob("moon.jpg", "image/jpeg")
+    card_blob = upload_blob("avatar.png", "image/png")
+    comment_blob = upload_blob("avatar.svg", "image/svg+xml")
+
+    @board.update!(public_description: rich_text_with(board_blob))
+    perform_enqueued_jobs
+    assert_equal board_blob.byte_size, @board.bytes_used
+    assert_equal board_blob.byte_size, @account.bytes_used
+
+    card = @board.cards.create!(title: "Rich card", status: :published, description: rich_text_with(card_blob))
+    perform_enqueued_jobs
+    expected = board_blob.byte_size + card_blob.byte_size
+    assert_equal expected, @board.bytes_used
+    assert_equal expected, @account.bytes_used
+
+    comment = card.comments.create!(body: rich_text_with(comment_blob))
+    perform_enqueued_jobs
+    expected += comment_blob.byte_size
+    assert_equal expected, @board.bytes_used
+    assert_equal expected, @account.bytes_used
+
+    # Updating description and comment to remove embeds subtracts them
+    card.update!(description: "Plain text now")
+    comment.update!(body: "Plain comment now")
+    @board.update!(public_description: "Plain board description")
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "includes drafted cards and sums across multiple boards in account" do
+    blob1 = upload_blob("moon.jpg", "image/jpeg")
+    blob2 = upload_blob("avatar.png", "image/png")
+
+    @board.cards.create!(title: "Draft card", status: :drafted, image: blob1)
+    @other_board.cards.create!(title: "Published card", status: :published, image: blob2)
+    perform_enqueued_jobs
+
+    assert_equal blob1.byte_size, @board.bytes_used
+    assert_equal blob2.byte_size, @other_board.bytes_used
+    assert_equal blob1.byte_size + blob2.byte_size, @account.bytes_used
+  end
+
+  test "excludes avatars, exports, imports, remote attachments, mentions, variants, and unattached blobs" do
+    # User avatar
+    users(:david).avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    # Export file
+    export = Account::Export.create!(account: @account, user: users(:david))
+    export.file.attach(io: StringIO.new("zip data"), filename: "export.zip", content_type: "application/zip")
+    # Import file
+    import = Account::Import.create!(account: @account, identity: identities(:david))
+    import.file.attach(io: StringIO.new("zip data"), filename: "import.zip", content_type: "application/zip")
+    # Unattached blob
+    upload_blob("moon.jpg", "image/jpeg")
+
+    # Card with remote image and user mention (no blob attachments)
+    mention_html = ActionText::Attachment.from_attachable(users(:david)).to_html
+    remote_html = '<action-text-attachment url="https://example.com/demo.gif" content-type="image/*"></action-text-attachment>'
+    card = @board.cards.create!(title: "Remote and mention", status: :published, description: "#{mention_html} #{remote_html}")
+
+    # Card comment with an embedded image (which generates small & large variants automatically)
+    embed_blob = upload_blob("moon.jpg", "image/jpeg")
+    card.comments.create!(body: rich_text_with(embed_blob))
+
+    perform_enqueued_jobs
+
+    # Only the original embed_blob is counted (not variants, avatars, exports, imports, or unattached blob)
+    assert_equal embed_blob.byte_size, @board.bytes_used
+    assert_equal embed_blob.byte_size, @account.bytes_used
+  end
+
+  test "moving a card between boards updates both boards and preserves account total" do
+    card_image = upload_blob("moon.jpg", "image/jpeg")
+    card_embed = upload_blob("avatar.png", "image/png")
+    comment_embed = upload_blob("avatar.svg", "image/svg+xml")
+
+    card = @board.cards.create!(title: "Movable", status: :published, image: card_image, description: rich_text_with(card_embed))
+    card.comments.create!(body: rich_text_with(comment_embed))
+    perform_enqueued_jobs
+
+    card_total = card_image.byte_size + card_embed.byte_size + comment_embed.byte_size
+    assert_equal card_total, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal card_total, @account.bytes_used
+
+    card.move_to(@other_board)
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal card_total, @other_board.bytes_used
+    assert_equal card_total, @account.bytes_used
+  end
+
+  test "rapid consecutive card moves settle on accurate board totals" do
+    third_board = @account.boards.create!(name: "Third Board", creator: users(:david))
+    blob = upload_blob("moon.jpg", "image/jpeg")
+
+    card = @board.cards.create!(title: "Movable", status: :published, image: blob)
+    perform_enqueued_jobs
+
+    # Move twice before background jobs run
+    card.move_to(@other_board)
+    card.move_to(third_board)
+
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal blob.byte_size, third_board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+  end
+
+  test "destroying a comment subtracts its usage" do
+    blob = upload_blob("moon.jpg", "image/jpeg")
+    card = @board.cards.create!(title: "Card", status: :published)
+    comment = card.comments.create!(body: rich_text_with(blob))
+    perform_enqueued_jobs
+    assert_equal blob.byte_size, @board.bytes_used
+
+    comment.destroy!
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "destroying a card subtracts card and all comment usage with a single cleanup job" do
+    card_blob = upload_blob("moon.jpg", "image/jpeg")
+    comment_blob1 = upload_blob("avatar.png", "image/png")
+    comment_blob2 = upload_blob("avatar.svg", "image/svg+xml")
+
+    card = @board.cards.create!(title: "Doomed card", status: :published, image: card_blob)
+    card.comments.create!(body: rich_text_with(comment_blob1))
+    card.comments.create!(body: rich_text_with(comment_blob2))
+    perform_enqueued_jobs
+
+    total = card_blob.byte_size + comment_blob1.byte_size + comment_blob2.byte_size
+    assert_equal total, @board.bytes_used
+    assert_equal total, @account.bytes_used
+
+    assert_enqueued_jobs 1, only: Storage::CleanupJob do
+      assert_no_enqueued_jobs only: Storage::SyncJob do
+        card.destroy!
+      end
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+    assert_empty Storage::TrackedRecord.where(card_id: card.id)
+  end
+
+  test "destroying a board subtracts all board and card usage from account with a single cleanup job" do
+    board_blob = upload_blob("moon.jpg", "image/jpeg")
+    card_blob = upload_blob("avatar.png", "image/png")
+    other_board_blob = upload_blob("avatar.svg", "image/svg+xml")
+
+    @board.update!(public_description: rich_text_with(board_blob))
+    card = @board.cards.create!(title: "Card on doomed board", status: :published, image: card_blob)
+    card.comments.create!(body: rich_text_with(board_blob))
+    @other_board.cards.create!(title: "Card on surviving board", status: :published, image: other_board_blob)
+    perform_enqueued_jobs
+
+    doomed_total = (board_blob.byte_size * 2) + card_blob.byte_size
+    assert_equal doomed_total, @board.bytes_used
+    assert_equal doomed_total + other_board_blob.byte_size, @account.bytes_used
+
+    assert_enqueued_jobs 1, only: Storage::CleanupJob do
+      assert_no_enqueued_jobs only: Storage::SyncJob do
+        @board.destroy!
+      end
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal other_board_blob.byte_size, @other_board.bytes_used
+    assert_equal other_board_blob.byte_size, @account.bytes_used
+    assert_empty Storage::TrackedRecord.where(board_id: @board.id)
+    assert_empty Storage::Entry.where(owner: @board)
+  end
+
+  test "moving a card off a board right before destroying the board preserves the moved card usage on account" do
+    blob = upload_blob("moon.jpg", "image/jpeg")
+
+    card = @board.cards.create!(title: "Saved card", status: :published, image: blob)
+    perform_enqueued_jobs
+
+    card.move_to(@other_board)
+    @board.destroy!
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @other_board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+  end
+
+  test "text-only updates and card touches do not enqueue storage sync jobs" do
+    card = @board.cards.create!(title: "Plain card", status: :published, description: "Initial")
+
+    assert_no_enqueued_jobs only: Storage::SyncJob do
+      card.update!(title: "Updated title", description: "Still plain text")
+      card.comments.create!(body: "Plain text comment")
+      card.touch
+      card.close
+    end
+  end
+
+  test "sync_storage_now is idempotent across duplicate runs" do
+    blob = upload_blob("moon.jpg", "image/jpeg")
+    card = @board.cards.create!(title: "Idempotent card", status: :published, image: blob)
+
+    3.times { card.sync_storage_now }
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+  end
+
+  test "tracking works when Current.account is different or nil" do
+    initech_board = boards(:miltons_wish_list)
+    blob = Current.set(account: @other_account) { upload_blob("moon.jpg", "image/jpeg") }
+
+    card = initech_board.cards.create!(title: "Initech card", status: :published, number: 999, creator: users(:mike), image: blob)
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, initech_board.bytes_used
+    assert_equal blob.byte_size, @other_account.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "reconcile_storage_now backfills and fixes stale tracked records" do
+    blob1 = upload_blob("moon.jpg", "image/jpeg")
+    blob2 = upload_blob("avatar.png", "image/png")
+
+    card = @board.cards.create!(title: "Un-synced", status: :published)
+    ActiveStorage::Attachment.insert_all!([
+      {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: @account.id,
+        name: "image",
+        record_type: "Card",
+        record_id: card.id,
+        blob_id: blob1.id
+      }
+    ])
+
+    # Simulate an existing stale tracked record for a deleted comment
+    stale_comment_id = ActiveRecord::Type::Uuid.generate
+    Storage::TrackedRecord.create!(
+      account_id: @account.id,
+      board_id: @board.id,
+      card_id: card.id,
+      record_type: "Comment",
+      record_id: stale_comment_id,
+      bytes_used: blob2.byte_size
+    )
+    Storage::Entry.record(account_id: @account.id, board_id: @board.id, delta: blob2.byte_size)
+
+    assert_equal blob2.byte_size, @board.bytes_used
+
+    @account.reconcile_storage_now
+
+    assert_equal blob1.byte_size, @board.bytes_used
+    assert_equal blob1.byte_size, @account.bytes_used
+    assert_not Storage::TrackedRecord.exists?(record_type: "Comment", record_id: stale_comment_id)
+  end
+
+  test "export and import round-trip preserves bytes_used on imported account and boards" do
+    blob = upload_blob("moon.jpg", "image/jpeg")
+    @board.cards.create!(title: "Exported card", status: :published, image: blob)
+    perform_enqueued_jobs
+    assert_equal blob.byte_size, @account.bytes_used
+
+    exporter = users(:david)
+    export = Account::Export.create!(account: @account, user: exporter)
+    export.build
+
+    export_tempfile = Tempfile.new([ "export", ".zip" ])
+    export.file.open { |f| FileUtils.cp(f.path, export_tempfile.path) }
+
+    ActiveStorage::Blob.where(account: @account).delete_all
+    @account.destroy!
+
+    target_account = Account.create_with_owner(account: { name: "Imported" }, owner: { identity: exporter.identity, name: exporter.name })
+    import = Account::Import.create!(identity: exporter.identity, account: target_account)
+    Current.set(account: target_account) do
+      import.file.attach(io: File.open(export_tempfile.path), filename: "export.zip", content_type: "application/zip")
+    end
+
+    import.check
+    import.process
+
+    assert_equal blob.byte_size, target_account.bytes_used
+    imported_board = target_account.boards.find_by!(name: @board.name)
+    assert_equal blob.byte_size, imported_board.bytes_used
+  ensure
+    export_tempfile&.close
+    export_tempfile&.unlink
+  end
+
+  private
+    def upload_blob(fixture_name, content_type)
+      ActiveStorage::Blob.create_and_upload!(
+        io: File.open(file_fixture(fixture_name)),
+        filename: fixture_name,
+        content_type: content_type
+      )
+    end
+
+    def rich_text_with(*blobs)
+      ActionText::Content.new("").append_attachables(blobs).to_html
+    end
+end
