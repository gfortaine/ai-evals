diff --git a/test/integration/locale_switching_test.rb b/test/integration/locale_switching_test.rb
new file mode 100644
index 0000000..a3ab32b
--- /dev/null
+++ b/test/integration/locale_switching_test.rb
@@ -0,0 +1,217 @@
+require "test_helper"
+
+class LocaleSwitchingTest < ActionDispatch::IntegrationTest
+  test "people who never chose a locale continue seeing English" do
+    sign_in_as :david
+
+    get board_path(boards(:writebook))
+    assert_response :success
+    assert_includes response.body, '<html lang="en">'
+    assert_nil identities(:david).reload.locale
+  end
+
+  test "opening any page with ?locale=ja switches to Japanese and persists across session and clean browser sign-in" do
+    sign_in_as :david
+
+    get board_path(boards(:writebook), locale: "ja")
+    assert_response :success
+    assert_includes response.body, '<html lang="ja">'
+    assert_includes response.body, "検討中？"
+    assert_includes response.body, "あとで"
+    assert_includes response.body, "完了"
+    assert_equal "ja", identities(:david).reload.locale
+
+    # Subsequent request without ?locale=ja stays Japanese
+    get account_settings_path
+    assert_response :success
+    assert_includes response.body, '<html lang="ja">'
+    assert_includes response.body, "アカウント設定"
+
+    # Signing out restores default English for the browser
+    sign_out
+    untenanted do
+      get new_session_path
+    end
+    assert_response :success
+    assert_includes response.body, '<html lang="en">'
+    assert_includes response.body, "Get into Fizzy"
+
+    # Clean browser (new session with no cookies) signing in again gets Japanese
+    reset!
+    integration_session.default_url_options[:script_name] = "/#{ActiveRecord::FixtureSet.identify("37signals")}"
+
+    assert_emails 0
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identities(:david).email_address }
+      end
+    end
+
+    # Even the magic link sign-in email is in Japanese!
+    magic_link_email = ActionMailer::Base.deliveries.last
+    assert_not_nil magic_link_email
+    assert_match(/Fizzy認証コード/, magic_link_email.subject)
+    assert_match(/6文字の認証コード/, magic_link_email.text_part.body.decoded)
+
+    magic_link = identities(:david).magic_links.order(id: :desc).first
+    untenanted do
+      post session_magic_link_url, params: { code: magic_link.code }
+    end
+    assert_response :redirect
+
+    get account_settings_path
+    assert_response :success
+    assert_includes response.body, '<html lang="ja">'
+    assert_includes response.body, "アカウント設定"
+  end
+
+  test "unsupported locale parameter does not break a page or switch locale" do
+    sign_in_as :david
+
+    get board_path(boards(:writebook), locale: "xx")
+    assert_response :success
+    assert_includes response.body, '<html lang="en">'
+    assert_nil identities(:david).reload.locale
+
+    # Also doesn't break or reset when already in Japanese
+    get board_path(boards(:writebook), locale: "ja")
+    assert_response :success
+    assert_includes response.body, '<html lang="ja">'
+
+    get board_path(boards(:writebook), locale: "xx")
+    assert_response :success
+    assert_includes response.body, '<html lang="ja">'
+    assert_equal "ja", identities(:david).reload.locale
+  end
+
+  test "fragment cache is isolated between English and Japanese users" do
+    with_caching do
+      sign_in_as :david
+      get card_path(cards(:logo))
+      assert_response :success
+      assert_includes response.body, "Mark as Done"
+      assert_not_includes response.body, "完了にする"
+
+      get card_path(cards(:logo), locale: "ja")
+      assert_response :success
+      assert_includes response.body, "完了にする"
+      assert_not_includes response.body, "Mark as Done"
+
+      # Switching back to English still gets English (not cached Japanese)
+      get card_path(cards(:logo), locale: "en")
+      assert_response :success
+      assert_includes response.body, "Mark as Done"
+      assert_not_includes response.body, "完了にする"
+    end
+  end
+
+  test "visiting redirected page with ?locale=ja still persists choice" do
+    sign_in_as :david
+
+    untenanted do
+      get root_path(locale: "ja")
+    end
+    assert_response :redirect
+    assert_equal "ja", identities(:david).reload.locale
+
+    get board_path(boards(:writebook))
+    assert_response :success
+    assert_includes response.body, '<html lang="ja">'
+  end
+
+  test "unauthenticated visitor choosing ?locale=ja keeps it for session and after sign-in" do
+    untenanted do
+      get new_session_path(locale: "ja")
+    end
+    assert_response :success
+    assert_includes response.body, '<html lang="ja">'
+    assert_includes response.body, "Fizzyにサインイン"
+
+    # Subsequent unauthenticated page keeps Japanese
+    untenanted do
+      get new_signup_path
+    end
+    assert_response :success
+    assert_includes response.body, '<html lang="ja">'
+    assert_includes response.body, "新規登録"
+  end
+
+  test "static error pages render in both English and Japanese" do
+    %w[ 400.html 404.html 406-unsupported-browser.html 422.html 500.html ].each do |filename|
+      html = File.read(Rails.root.join("public", filename))
+      assert_match(/Back home/, html, "#{filename} missing English")
+      assert_match(/ホームに戻る/, html, "#{filename} missing Japanese")
+      assert_match(/lang="ja"/, html, "#{filename} missing lang=\"ja\"")
+    end
+  end
+
+  test "all major screens render cleanly in Japanese without missing translations" do
+    sign_in_as :kevin
+    get board_path(boards(:writebook), locale: "ja")
+    assert_response :success
+
+    boards(:writebook).publish
+
+    paths = [
+      root_path,
+      board_path(boards(:writebook)),
+      edit_board_path(boards(:writebook)),
+      new_board_path,
+      board_columns_not_now_path(boards(:writebook)),
+      board_columns_stream_path(boards(:writebook)),
+      board_columns_closed_path(boards(:writebook)),
+      board_column_path(boards(:writebook), columns(:writebook_triage)),
+      cards_path,
+      card_path(cards(:logo)),
+      edit_card_path(cards(:logo)),
+      new_card_assignment_path(cards(:logo)),
+      edit_card_board_path(cards(:logo)),
+      new_card_tagging_path(cards(:logo)),
+      card_reactions_path(cards(:logo)),
+      new_card_reaction_path(cards(:logo)),
+      notifications_path,
+      notifications_settings_path,
+      tray_notifications_path,
+      account_settings_path,
+      account_join_code_path,
+      edit_account_join_code_path,
+      user_path(users(:kevin)),
+      edit_user_path(users(:kevin)),
+      new_user_email_address_path(users(:kevin)),
+      my_passkeys_path,
+      my_access_tokens_path,
+      new_my_access_token_path,
+      my_menu_path,
+      my_pins_path,
+      search_path(q: "logo"),
+      board_webhooks_path(boards(:writebook)),
+      new_board_webhook_path(boards(:writebook)),
+      board_webhook_path(boards(:writebook), webhooks(:active)),
+      edit_board_webhook_path(boards(:writebook), webhooks(:active)),
+      public_board_path(boards(:writebook).publication.key),
+      public_board_card_path(boards(:writebook).publication.key, cards(:logo)),
+      pwa_manifest_path(format: :json)
+    ]
+
+    old_handler = I18n.exception_handler
+    I18n.exception_handler = ->(exception, locale, key, options) { raise exception.to_exception }
+
+    paths.each do |path|
+      get path
+      assert_response :success, "Expected 200 for #{path}, got #{response.status}"
+      assert_not_includes response.body, "translation_missing", "Missing translation on #{path}"
+      assert_not_includes response.body, "Translation missing", "Missing translation on #{path}"
+    end
+  ensure
+    I18n.exception_handler = old_handler
+  end
+
+  private
+    def with_caching
+      original = ActionController::Base.perform_caching
+      ActionController::Base.perform_caching = true
+      yield
+    ensure
+      ActionController::Base.perform_caching = original
+    end
+end
diff --git a/test/mailers/locale_mailer_test.rb b/test/mailers/locale_mailer_test.rb
new file mode 100644
index 0000000..d5f2ad7
--- /dev/null
+++ b/test/mailers/locale_mailer_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class LocaleMailerTest < ActionMailer::TestCase
+  test "MagicLinkMailer renders in Japanese when identity locale is ja" do
+    identities(:kevin).update!(locale: "ja")
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+    assert_equal "Fizzy認証コード: #{magic_link.code}", email.subject
+    assert_match(/6文字の認証コード/, email.html_part.body.decoded)
+    assert_match(/15分/, email.html_part.body.decoded)
+    assert_match(/6文字の認証コード/, email.text_part.body.decoded)
+  end
+
+  test "ExportMailer renders in Japanese when user identity locale is ja" do
+    identities(:david).update!(locale: "ja")
+    export = Account::Export.create!(account: Current.account, user: users(:david))
+
+    email = ExportMailer.completed(export)
+    assert_equal "Fizzyデータのエクスポートをダウンロードできます", email.subject
+    assert_match(/データをダウンロード/, email.html_part.body.decoded)
+    assert_match(/データをダウンロード/, email.text_part.body.decoded)
+  end
+
+  test "ImportMailer renders in Japanese when identity locale is ja" do
+    identities(:david).update!(locale: "ja")
+
+    completed = ImportMailer.completed(identities(:david), accounts(:"37s"))
+    assert_equal "Fizzyアカウントのインポートが完了しました", completed.subject
+    assert_match(/インポートが完了しました/, completed.html_part.body.decoded)
+
+    import = Account::Import.create!(account: Current.account, identity: identities(:david), status: :failed, failure_reason: :conflict)
+    failed = ImportMailer.failed(import)
+    assert_equal "Fizzyアカウントのインポートに失敗しました", failed.subject
+    assert_match(/すでに存在するようです/, failed.html_part.body.decoded)
+  end
+
+  test "AccountMailer renders in Japanese when user identity locale is ja" do
+    identities(:david).update!(locale: "ja")
+    accounts(:"37s").cancel(initiated_by: users(:david))
+
+    email = AccountMailer.cancellation(accounts(:"37s").cancellation)
+    assert_equal "Fizzyアカウントが削除されました", email.subject
+    assert_match(/削除されました/, email.html_part.body.decoded)
+    assert_match(/約1か月/, email.html_part.body.decoded)
+  end
+
+  test "UserMailer renders in Japanese when user identity locale is ja" do
+    identities(:david).update!(locale: "ja")
+
+    email = UserMailer.email_change_confirmation(email_address: "new@example.com", token: "tok", user: users(:david))
+    assert_equal "新しいメールアドレスを確認してください", email.subject
+    assert_match(/はい、このメールアドレスを使用します/, email.body.decoded)
+  end
+
+  test "Notification::BundleMailer renders in Japanese including localized dates" do
+    identities(:david).update!(locale: "ja")
+    user = users(:david)
+    user.notifications.destroy_all
+
+    bundle = Notification::Bundle.create!(
+      user: user,
+      starts_at: Time.zone.local(2026, 5, 10, 9, 30),
+      ends_at: Time.zone.local(2026, 5, 10, 13, 30)
+    )
+    Notification.create!(user: user, creator: users(:kevin), source: events(:logo_published), created_at: Time.zone.local(2026, 5, 10, 10, 0), updated_at: Time.zone.local(2026, 5, 10, 10, 0))
+
+    email = Notification::BundleMailer.notification(bundle)
+    assert_equal "Fizzy: 新しい通知", email.subject
+    assert_match(/5月10日/, email.html_part.body.decoded)
+    assert_match(/1件の新しい通知/, email.html_part.body.decoded)
+    assert_match(/5月10日/, email.text_part.body.decoded)
+    assert_match(/1件の新しい通知/, email.text_part.body.decoded)
+  end
+end
diff --git a/test/models/i18n_completeness_test.rb b/test/models/i18n_completeness_test.rb
new file mode 100644
index 0000000..e03974c
--- /dev/null
+++ b/test/models/i18n_completeness_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class I18nCompletenessTest < ActiveSupport::TestCase
+  test "all en.yml keys exist in ja.yml" do
+    en = flatten_keys(YAML.load_file(Rails.root.join("config/locales/en.yml"))["en"])
+    ja = flatten_keys(YAML.load_file(Rails.root.join("config/locales/ja.yml"))["ja"])
+
+    missing = en.keys - ja.keys
+    assert_empty missing, "Missing Japanese translations for: #{missing.join(', ')}"
+  end
+
+  test "Event::Description renders in Japanese" do
+    I18n.with_locale(:ja) do
+      description = events(:logo_published).description_for(users(:jz))
+      assert_includes description.to_plain_text, "David が"
+      assert_includes description.to_plain_text, "を追加しました"
+    end
+  end
+
+  test "SystemCommenter creates Japanese system comment in ja locale" do
+    Current.session = sessions(:david)
+    I18n.with_locale(:ja) do
+      cards(:text).close
+      comment = cards(:text).comments.last
+      assert_includes comment.body.to_plain_text, "完了"
+      assert_includes comment.body.to_plain_text, "移動しました"
+    end
+  end
+
+  test "Filter#summary renders in Japanese" do
+    I18n.with_locale(:ja) do
+      assert_equal "新しい順、#mobile、担当者: JZ", filters(:jz_assignments).summary
+    end
+  end
+
+  test "TimeWindowParser.human_name_for renders in Japanese" do
+    I18n.with_locale(:ja) do
+      assert_equal "今日", TimeWindowParser.human_name_for("today")
+      assert_equal "今週", TimeWindowParser.human_name_for("thisweek")
+    end
+  end
+
+  test "Notification push payloads render in Japanese" do
+    identities(:kevin).update!(locale: "ja")
+    notification = notifications(:logo_assignment_kevin)
+    I18n.with_locale(:ja) do
+      assert_includes notification.payload.body, "担当者に割り当てました"
+    end
+  end
+
+  test "Account::Seeder seeds Playground board and cards in Japanese" do
+    I18n.with_locale(:ja) do
+      account = Account.create!(name: "Tokyo Test")
+      owner = account.users.create!(name: "Taro", role: :owner, identity: identities(:david))
+      Account::Seeder.new(account, owner).seed
+      board = account.boards.find_by!(name: "プレイグラウンド")
+      assert board.cards.any?
+      assert board.cards.pluck(:title).any? { |t| t.include?("パスキー") }
+    end
+  end
+
+  private
+    def flatten_keys(hash, prefix = nil)
+      hash.each_with_object({}) do |(k, v), acc|
+        key = prefix ? "#{prefix}.#{k}" : k.to_s
+        if v.is_a?(Hash)
+          acc.merge!(flatten_keys(v, key))
+        else
+          acc[key] = v
+        end
+      end
+    end
+end
diff --git a/test/system/locale_test.rb b/test/system/locale_test.rb
new file mode 100644
index 0000000..9d56fe2
--- /dev/null
+++ b/test/system/locale_test.rb
@@ -0,0 +1,29 @@
+require "application_system_test_case"
+
+class LocaleTest < ApplicationSystemTestCase
+  test "switching to Japanese localizes UI, screen reader labels, and JS dates" do
+    sign_in_as users(:david)
+
+    visit board_url(boards(:writebook), locale: "ja")
+    assert_selector "html[lang='ja']"
+    assert_text "検討中？"
+    assert_text "あとで"
+    assert_text "完了"
+
+    # JS local-time controller formats dates in Japanese
+    visit card_url(cards(:logo))
+    assert_selector "html[lang='ja']"
+    assert_text "戻る"
+    assert_text "完了にする"
+
+    # Relative days in card meta should be rendered in Japanese (今日 / 昨日 / 日前)
+    within("##{dom_id(cards(:logo), :meta)}") do
+      assert_match(/今日|昨日|\d+日前/, text)
+    end
+
+    # Invalid locale keeps Japanese and does not break the page
+    visit board_url(boards(:writebook), locale: "xx")
+    assert_selector "html[lang='ja']"
+    assert_text "検討中？"
+  end
+end
