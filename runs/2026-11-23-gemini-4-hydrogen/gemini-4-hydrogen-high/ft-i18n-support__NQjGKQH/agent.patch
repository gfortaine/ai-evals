diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..154457e
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,54 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :set_current_locale
+
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def set_current_locale(&)
+      locale = resolve_current_locale
+      I18n.with_locale(locale, &)
+    end
+
+    def resolve_current_locale
+      identity = current_identity_for_locale
+
+      if requested_locale = valid_locale_param
+        session[:locale] = requested_locale
+        persist_identity_locale(identity, requested_locale)
+        requested_locale
+      elsif session[:locale].present? && valid_locale?(session[:locale])
+        persist_identity_locale(identity, session[:locale])
+        session[:locale]
+      elsif identity&.locale.present? && valid_locale?(identity.locale)
+        identity.locale
+      else
+        I18n.default_locale
+      end
+    end
+
+    def current_identity_for_locale
+      Current.identity || find_session_by_cookie&.identity
+    end
+
+    def persist_identity_locale(identity, locale)
+      if identity && identity.locale != locale.to_s
+        ActiveRecord::Base.connected_to(role: :writing) do
+          identity.update!(locale: locale.to_s)
+        end
+      end
+    end
+
+    def valid_locale_param
+      locale = params[:locale]
+      locale if locale.is_a?(String) && valid_locale?(locale)
+    end
+
+    def valid_locale?(locale)
+      I18n.available_locales.map(&:to_s).include?(locale.to_s)
+    end
+end
