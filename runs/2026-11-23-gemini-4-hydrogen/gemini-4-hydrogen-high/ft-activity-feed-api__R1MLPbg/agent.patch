diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..7968963 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,24 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def particulars_summary
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: nested_particular("old_board").to_s, new_board: nested_particular("new_board").to_s }
+    when "card_title_changed"
+      { old_title: nested_particular("old_title").to_s, new_title: nested_particular("new_title").to_s }
+    when "card_triaged"
+      { column: nested_particular("column").to_s }
+    else
+      {}
+    end
+  end
+
+  private
+    def nested_particular(key)
+      particulars&.dig("particulars", key) || particulars&.dig(key)
+    end
 end
