diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..00f1a0d
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,317 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns flat array of activities newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    timestamps = @response.parsed_body.map { |entry| Time.iso8601(entry["created_at"]) }
+    assert_equal timestamps.sort.reverse, timestamps
+  end
+
+  test "index defaults to JSON and rejects HTML" do
+    get activities_path
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+  end
+
+  test "index authenticates with bearer token" do
+    sign_out
+
+    token = identity_access_tokens(:davids_api_token).token
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer #{token}" }
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer invalid" }
+    assert_response :unauthorized
+  end
+
+  test "index includes expected fields and representations for card and comment events" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    card_event = events(:logo_published)
+    card_entry = @response.parsed_body.find { |entry| entry["id"] == card_event.id }
+
+    assert_not_nil card_entry
+    assert_equal "card_published", card_entry["action"]
+    assert_equal card_event.created_at.utc.iso8601(3), card_entry["created_at"]
+    assert_equal card_event.description_for(users(:kevin)).to_plain_text, card_entry["description"]
+    assert_equal({}, card_entry["particulars"])
+    assert_equal card_url(cards(:logo)), card_entry["url"]
+    assert_equal "Card", card_entry["eventable_type"]
+    assert_equal cards(:logo).id, card_entry.dig("eventable", "id")
+    assert_equal cards(:logo).number, card_entry.dig("eventable", "number")
+    assert_equal cards(:logo).title, card_entry.dig("eventable", "title")
+    assert_equal boards(:writebook).id, card_entry.dig("board", "id")
+    assert_equal boards(:writebook).name, card_entry.dig("board", "name")
+    assert_equal users(:david).id, card_entry.dig("creator", "id")
+    assert_equal users(:david).name, card_entry.dig("creator", "name")
+
+    comment_event = events(:layout_commented)
+    comment = comments(:layout_overflowing_david)
+    comment_entry = @response.parsed_body.find { |entry| entry["id"] == comment_event.id }
+
+    assert_not_nil comment_entry
+    assert_equal "comment_created", comment_entry["action"]
+    assert_equal comment_event.description_for(users(:kevin)).to_plain_text, comment_entry["description"]
+    assert_equal({}, comment_entry["particulars"])
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), comment_entry["url"]
+    assert_equal "Comment", comment_entry["eventable_type"]
+    assert_equal comment.id, comment_entry.dig("eventable", "id")
+    assert_equal comment.body.to_plain_text, comment_entry.dig("eventable", "body", "plain_text")
+    assert_equal comment.card_id, comment_entry.dig("eventable", "card", "id")
+  end
+
+  test "index personalizes plain-text description for current user" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    km_assignment = @response.parsed_body.find { |entry| entry["id"] == events(:logo_assignment_km).id }
+    assert_includes km_assignment["description"], "will handle"
+
+    jz_assignment = @response.parsed_body.find { |entry| entry["id"] == events(:logo_assignment_jz).id }
+    assert_includes jz_assignment["description"], "assigned JZ to"
+  end
+
+  test "index omits deprecated card_collection_changed and includes card_title_changed" do
+    collection_event = boards(:writebook).events.create!(
+      action: "card_collection_changed",
+      creator: users(:david),
+      eventable: cards(:logo),
+      particulars: { "particulars" => { "old_collection" => "Old", "new_collection" => "New" } }
+    )
+
+    title_event = boards(:writebook).events.create!(
+      action: "card_title_changed",
+      creator: users(:david),
+      eventable: cards(:logo),
+      particulars: { "particulars" => { "old_title" => "Old Title", "new_title" => "New Title" } }
+    )
+
+    other_event = boards(:writebook).events.create!(
+      action: "card_unknown_action",
+      creator: users(:david),
+      eventable: cards(:logo)
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    returned_ids = @response.parsed_body.pluck("id")
+    assert_not_includes returned_ids, collection_event.id
+    assert_not_includes returned_ids, other_event.id
+    assert_includes returned_ids, title_event.id
+
+    title_entry = @response.parsed_body.find { |entry| entry["id"] == title_event.id }
+    assert_equal({ "old_title" => "Old Title", "new_title" => "New Title" }, title_entry["particulars"])
+  end
+
+  test "index includes all supported timeline event actions" do
+    with_current_user(:kevin) do
+      cards(:logo).toggle_assignment(users(:david)) # unassign
+      cards(:logo).toggle_assignment(users(:david)) # assign
+      cards(:logo).update!(title: "Updated Logo")
+      cards(:logo).triage_into(columns(:writebook_in_progress))
+      cards(:logo).send_back_to_triage
+      cards(:logo).postpone
+      cards(:logo).auto_postpone(user: accounts("37s").system_user)
+      cards(:logo).close
+      cards(:logo).reopen
+      cards(:logo).comments.create!(body: "New comment")
+      cards(:logo).move_to(boards(:private))
+    end
+
+    actions = []
+    next_page = activities_path(format: :json)
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+      actions.concat(@response.parsed_body.pluck("action"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    %w[
+      card_assigned
+      card_unassigned
+      card_published
+      card_closed
+      card_reopened
+      card_board_changed
+      card_postponed
+      card_auto_postponed
+      card_triaged
+      card_sent_back_to_triage
+      card_title_changed
+      comment_created
+    ].each do |expected_action|
+      assert_includes actions, expected_action
+    end
+  end
+
+  test "index exposes particulars for assignment, board change, title change, and triage events" do
+    board_event = boards(:writebook).events.create!(
+      action: "card_board_changed",
+      creator: users(:david),
+      eventable: cards(:logo),
+      particulars: { "particulars" => { "old_board" => "Old Board", "new_board" => "Writebook" } }
+    )
+    triage_event = boards(:writebook).events.create!(
+      action: "card_triaged",
+      creator: users(:david),
+      eventable: cards(:logo),
+      particulars: { "particulars" => { "column" => "In Progress" } }
+    )
+    missing_board_event = boards(:writebook).events.create!(
+      action: "card_board_changed",
+      creator: users(:david),
+      eventable: cards(:logo),
+      particulars: {}
+    )
+    missing_title_event = boards(:writebook).events.create!(
+      action: "card_title_changed",
+      creator: users(:david),
+      eventable: cards(:logo),
+      particulars: {}
+    )
+    missing_triage_event = boards(:writebook).events.create!(
+      action: "card_triaged",
+      creator: users(:david),
+      eventable: cards(:logo),
+      particulars: {}
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    entries_by_id = @response.parsed_body.index_by { |entry| entry["id"] }
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, entries_by_id[events(:logo_assignment_jz).id]["particulars"])
+    assert_equal({ "old_board" => "Old Board", "new_board" => "Writebook" }, entries_by_id[board_event.id]["particulars"])
+    assert_equal({ "column" => "In Progress" }, entries_by_id[triage_event.id]["particulars"])
+    assert_equal({ "old_board" => "", "new_board" => "" }, entries_by_id[missing_board_event.id]["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, entries_by_id[missing_title_event.id]["particulars"])
+    assert_equal({ "column" => "" }, entries_by_id[missing_triage_event.id]["particulars"])
+  end
+
+  test "index can filter by creator_ids and board_ids" do
+    private_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Secret Card", creator: users(:kevin), status: :published)
+    end
+    private_event = private_card.events.find_by!(action: "card_published")
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |entry| entry.dig("creator", "id") == users(:kevin).id }
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ], board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "index only returns activity from boards the current user can access" do
+    private_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Secret Card", creator: users(:kevin), status: :published)
+    end
+    private_event = private_card.events.find_by!(action: "card_published")
+
+    other_account_event = Current.set(account: accounts(:initech)) do
+      with_current_user(:mike) do
+        cards(:radio).close
+        cards(:radio).events.find_by!(action: "card_closed")
+      end
+    end
+
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+    assert_response :success
+    returned_ids = @response.parsed_body.pluck("id")
+    assert_not_includes returned_ids, private_event.id
+    assert_not_includes returned_ids, other_account_event.id
+    assert_includes returned_ids, events(:logo_published).id
+
+    # Filtering explicitly by an inaccessible board returns empty, not all boards
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+
+    # Filtering by a mix of accessible and inaccessible boards only returns accessible ones
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id, boards(:writebook).id ] }
+    assert_response :success
+    assert @response.parsed_body.all? { |entry| entry.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "index paginates newest first using Link header and preserves filters" do
+    20.times do |i|
+      boards(:writebook).events.create!(
+        action: "card_published",
+        creator: users(:kevin),
+        eventable: cards(:logo),
+        created_at: Time.current + i.seconds
+      )
+    end
+
+    expected_ids = users(:kevin).accessible_events
+      .where(action: ActivitiesController::ACTIVITY_ACTIONS, creator_id: users(:kevin).id)
+      .reverse_chronologically
+      .pluck(:id)
+
+    actual_ids = []
+    next_page = activities_path(format: :json, creator_ids: [ users(:kevin).id ])
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.map { |entry| entry["id"] })
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+
+test "index can filter by multiple creator_ids and multiple board_ids" do
+  private_card = with_current_user(:kevin) do
+    boards(:private).cards.create!(title: "Secret Card", creator: users(:kevin), status: :published)
+  end
+  private_event = private_card.events.find_by!(action: "card_published")
+
+  get activities_path(format: :json), params: { creator_ids: [ users(:david).id, users(:kevin).id ] }
+  assert_response :success
+  creator_ids = @response.parsed_body.map { |entry| entry.dig("creator", "id") }.uniq
+  assert_includes creator_ids, users(:david).id
+  assert_includes creator_ids, users(:kevin).id
+
+  get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id, boards(:private).id ] }
+  assert_response :success
+  returned_ids = @response.parsed_body.pluck("id")
+  assert_includes returned_ids, private_event.id
+  assert_includes returned_ids, events(:logo_published).id
+end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
diff --git a/test/models/event/particulars_test.rb b/test/models/event/particulars_test.rb
new file mode 100644
index 0000000..2fe4482
--- /dev/null
+++ b/test/models/event/particulars_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "particulars_summary for assignment and unassignment events" do
+    assigned = events(:logo_assignment_jz)
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, assigned.particulars_summary)
+
+    unassigned = events(:logo_assignment_jz).dup
+    unassigned.action = "card_unassigned"
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, unassigned.particulars_summary)
+
+    missing_assignees = Event.new(action: "card_assigned", particulars: {})
+    assert_equal({ assignee_ids: [] }, missing_assignees.particulars_summary)
+  end
+
+  test "particulars_summary for board changes" do
+    event = Event.new(
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Inbox", "new_board" => "Writebook" } }
+    )
+    assert_equal({ old_board: "Inbox", new_board: "Writebook" }, event.particulars_summary)
+
+    missing = Event.new(action: "card_board_changed", particulars: {})
+    assert_equal({ old_board: "", new_board: "" }, missing.particulars_summary)
+  end
+
+  test "particulars_summary for title changes" do
+    event = Event.new(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } }
+    )
+    assert_equal({ old_title: "Old", new_title: "New" }, event.particulars_summary)
+
+    missing = Event.new(action: "card_title_changed", particulars: { "particulars" => { "old_title" => nil } })
+    assert_equal({ old_title: "", new_title: "" }, missing.particulars_summary)
+  end
+
+  test "particulars_summary for triage events" do
+    event = Event.new(
+      action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In Progress" } }
+    )
+    assert_equal({ column: "In Progress" }, event.particulars_summary)
+
+    missing = Event.new(action: "card_triaged", particulars: {})
+    assert_equal({ column: "" }, missing.particulars_summary)
+  end
+
+  test "particulars_summary returns empty hash for other events" do
+    %w[
+      card_published
+      card_closed
+      card_reopened
+      card_postponed
+      card_auto_postponed
+      card_sent_back_to_triage
+      comment_created
+    ].each do |action|
+      event = Event.new(action: action, particulars: { "particulars" => { "extra" => "ignored" } })
+      assert_equal({}, event.particulars_summary, "Expected empty particulars for #{action}")
+    end
+  end
+end
