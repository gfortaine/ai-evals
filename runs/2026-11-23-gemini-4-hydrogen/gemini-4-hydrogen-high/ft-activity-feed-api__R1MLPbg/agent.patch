@@ -0,0 +1,52 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from filtered_activities
+      end
+    end
+  end
+
+  private
+    def filtered_activities
+      events = Current.user.accessible_events
+        .where(action: ACTIVITY_ACTIONS)
+        .reverse_chronologically
+        .preloaded
+
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events = events.where(board_id: board_ids) if board_ids.present?
+      events
+    end
+
+    def creator_ids
+      filter_ids(:creator_ids)
+    end
+
+    def board_ids
+      filter_ids(:board_ids)
+    end
+
+    def filter_ids(key)
+      case value = params[key]
+      when Array then value.compact_blank
+      when String then [ value ].compact_blank
+      else []
+      end
+    end
+end
