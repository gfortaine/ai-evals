+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @draft = cards(:unfinished_thoughts)
+    sign_in_as :mike
+  end
+
+  test "free account out of cards can still draft" do
+    @account.override_limits(card_count: 1_000)
+    @account.update_column(:cards_count, 100)
+    @board.cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug)
+    end
+
+    assert_redirected_to card_draft_path(Card.last, script_name: @account.slug)
+    assert Card.last.drafted?
+  end
+
+  test "free account out of cards cannot publish" do
+    @account.override_limits(card_count: 1_000)
+
+    post card_publish_path(@draft, script_name: @account.slug)
+
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+  end
+
+  test "free account out of cards cannot create through the API" do
+    @account.override_limits(card_count: 1_000)
+    @account.update_column(:cards_count, 100)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Blocked API card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "draft card replaces create buttons with Upgrade pitch when out of cards" do
+    @account.override_limits(card_count: 1_000)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__notch a", text: "Upgrade"
+  end
+
+  test "draft card shows countdown warning from 100 cards out" do
+    @account.override_limits(card_count: 899)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch", text: /cards left/, count: 0
+
+    @account.override_limits(card_count: 950)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch", text: /50 cards left/
+    assert_select ".card-perma__notch-new-card-buttons"
+
+    @account.override_limits(card_count: 999)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch", text: /1 card left/
+  end
+
+  test "paid account with 1000+ cards can publish, create via API, and sees no warning" do
+    @account.create_subscription!(
+      plan_key: Plan.unlimited.key,
+      stripe_customer_id: "cus_paid",
+      stripe_subscription_id: "sub_paid",
+      status: "active"
+    )
+    @account.override_limits(card_count: 1_500)
+    @account.update_column(:cards_count, 100)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_select ".card-perma__notch", text: /cards left/, count: 0
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Unlimited API card" } },
+        as: :json
+    end
+    assert_response :created
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+end
diff --git a/saas/test/controllers/stripe_webhooks_controller_test.rb b/saas/test/controllers/stripe_webhooks_controller_test.rb
