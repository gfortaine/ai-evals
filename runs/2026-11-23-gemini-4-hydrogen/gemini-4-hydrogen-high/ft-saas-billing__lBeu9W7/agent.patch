diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..a9123a9
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,68 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  scope :active, -> { where(status: ACTIVE_STATUSES) }
+
+  def self.find_or_build_for_stripe_subscription(stripe_subscription)
+    existing = find_by(stripe_subscription_id: stripe_subscription[:id]) ||
+      find_by(stripe_customer_id: stripe_subscription[:customer])
+
+    if existing
+      existing
+    elsif account_id = stripe_subscription[:metadata]&.[](:account_id)
+      if account = Account.find_by(id: account_id)
+        account.subscription || account.build_subscription
+      end
+    end
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def canceling?
+    active? && cancel_at.present?
+  end
+
+  def canceled?
+    status == "canceled"
+  end
+
+  def past_due?
+    status == "past_due"
+  end
+
+  def plan
+    Plan[plan_key] || Plan.free
+  end
+
+  def sync_from_stripe(stripe_subscription)
+    price = stripe_subscription[:items]&.data&.first&.[](:price)
+    price_id = price.respond_to?(:id) ? price.id : price
+    matched_plan = Plan.find_by_price_id(price_id)
+    period_end = stripe_subscription[:current_period_end] ||
+      stripe_subscription[:items]&.data&.first&.to_h&.dig(:current_period_end)
+
+    update!(
+      stripe_customer_id: stripe_subscription[:customer] || stripe_customer_id,
+      stripe_subscription_id: stripe_subscription[:id],
+      status: stripe_subscription[:status],
+      plan_key: matched_plan&.key || plan_key,
+      current_period_end: period_end ? Time.zone.at(period_end) : nil,
+      cancel_at: stripe_subscription[:cancel_at] ? Time.zone.at(stripe_subscription[:cancel_at]) : nil
+    )
+  end
+
+  def cancel
+    if stripe_subscription_id.present? && active?
+      Stripe::Subscription.cancel(stripe_subscription_id)
+      update!(status: "canceled")
+    end
+  rescue Stripe::InvalidRequestError => error
+    raise unless error.http_status == 404
+
+    update!(status: "canceled")
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..74570dc
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,92 @@
+class Plan
+  attr_reader :key, :name, :price, :card_limit, :storage_limit
+
+  class << self
+    def all
+      PLANS.values
+    end
+
+    def paid_plans
+      [ unlimited, unlimited_plus ]
+    end
+
+    def free
+      PLANS[:free_v1]
+    end
+
+    def unlimited
+      PLANS[:monthly_v1]
+    end
+    alias_method :paid, :unlimited
+
+    def unlimited_plus
+      PLANS[:monthly_extra_storage_v1]
+    end
+
+    def [](key)
+      PLANS[key&.to_sym]
+    end
+
+    def find_by_price_id(price_id)
+      return if price_id.blank?
+
+      all.find { |plan| plan.stripe_price_id == price_id }
+    end
+  end
+
+  def initialize(key:, name:, price:, card_limit:, storage_limit:, stripe_price_id:)
+    @key = key
+    @name = name
+    @price = price
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @stripe_price_id = stripe_price_id
+  end
+
+  def stripe_price_id
+    @stripe_price_id.call
+  end
+
+  def free?
+    price.zero?
+  end
+
+  def paid?
+    !free?
+  end
+
+  def limit_cards?
+    card_limit.finite?
+  end
+
+  def unlimited_cards?
+    !limit_cards?
+  end
+
+  PLANS = {
+    free_v1: new(
+      key: "free_v1",
+      name: "Free",
+      price: 0,
+      card_limit: 1_000,
+      storage_limit: 1.gigabyte,
+      stripe_price_id: -> { nil }
+    ),
+    monthly_v1: new(
+      key: "monthly_v1",
+      name: "Unlimited",
+      price: 20,
+      card_limit: Float::INFINITY,
+      storage_limit: 5.gigabytes,
+      stripe_price_id: -> { ENV["STRIPE_MONTHLY_V1_PRICE_ID"] }
+    ),
+    monthly_extra_storage_v1: new(
+      key: "monthly_extra_storage_v1",
+      name: "Unlimited+",
+      price: 25,
+      card_limit: Float::INFINITY,
+      storage_limit: 500.gigabytes,
+      stripe_price_id: -> { ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] }
+    )
+  }.freeze
+end
