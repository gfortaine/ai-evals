index 0000000..9d7ce3e
--- /dev/null
+++ b/saas/test/controllers/stripe_webhooks_controller_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class StripeWebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @previous_unlimited_price = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    @previous_plus_price = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited_wh"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_plus_wh"
+  end
+
+  teardown do
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = @previous_unlimited_price
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = @previous_plus_price
+  end
+
+  test "rejects invalid webhook signature" do
+    untenanted do
+      post "/stripe/webhooks",
+        params: { id: "evt_bad", type: "customer.subscription.updated" }.to_json,
+        headers: { "CONTENT_TYPE" => "application/json", "HTTP_STRIPE_SIGNATURE" => "t=123,v1=bad" }
+    end
+
+    assert_response :bad_request
+  end
+
+  test "checkout.session.completed activates subscription" do
+    post_webhook("checkout.session.completed", {
+      id: "cs_123",
+      object: "checkout.session",
+      mode: "subscription",
+      payment_status: "paid",
+      customer: "cus_wh_1",
+      subscription: "sub_wh_1",
+      client_reference_id: @account.id,
+      metadata: { account_id: @account.id, plan_key: Plan.unlimited.key }
+    })
+
+    assert_response :ok
+    assert_equal Plan.unlimited, @account.reload.plan
+    assert_equal "cus_wh_1", @account.subscription.stripe_customer_id
+    assert_equal "sub_wh_1", @account.subscription.stripe_subscription_id
+    assert @account.active_subscription.present?
+  end
+
+  test "subscription created, upgraded to Unlimited+, and deleted updates plan and storage allowance" do
+    post_webhook("customer.subscription.created", {
+      id: "sub_wh_2",
+      object: "subscription",
+      customer: "cus_wh_2",
+      status: "active",
+      current_period_end: 1.month.from_now.to_i,
+      metadata: { account_id: @account.id },
+      items: { data: [ { price: { id: "price_unlimited_wh" } } ] }
+    })
+
+    assert_response :ok
+    assert_equal Plan.unlimited, @account.reload.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    post_webhook("customer.subscription.updated", {
+      id: "sub_wh_2",
+      object: "subscription",
+      customer: "cus_wh_2",
+      status: "active",
+      current_period_end: 1.month.from_now.to_i,
+      cancel_at: 2.weeks.from_now.to_i,
+      items: { data: [ { price: { id: "price_plus_wh" } } ] }
+    })
+
+    assert_response :ok
+    assert_equal Plan.unlimited_plus, @account.reload.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert @account.subscription.canceling?
+
+    post_webhook("customer.subscription.deleted", {
+      id: "sub_wh_2",
+      object: "subscription",
+      customer: "cus_wh_2",
+      status: "canceled",
+      items: { data: [ { price: { id: "price_plus_wh" } } ] }
+    })
+
+    assert_response :ok
+    assert_equal Plan.free, @account.reload.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_nil @account.active_subscription
+  end
+
+  private
+    def post_webhook(type, object)
+      payload = {
+        id: "evt_#{SecureRandom.hex(8)}",
+        type: type,
+        data: { object: object }
+      }.to_json
+
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, ENV["STRIPE_WEBHOOK_SECRET"])
+
+      untenanted do
+        post "/stripe/webhooks",
+          params: payload,
+          headers: {
+            "CONTENT_TYPE" => "application/json",
+            "HTTP_STRIPE_SIGNATURE" => "t=#{timestamp.to_i},v1=#{signature}"
+          }
+      end
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..3d99a9c
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,139 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "defaults to Free plan" do
+    assert_equal Plan.free, @account.plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "active Unlimited subscription brings 5 GB storage and unlimited cards" do
+    @account.create_subscription!(
+      plan_key: Plan.unlimited.key,
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      status: "active"
+    )
+
+    assert_equal Plan.unlimited, @account.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+
+    @account.override_limits(card_count: 2_000)
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "active Unlimited+ subscription brings 500 GB storage" do
+    @account.create_subscription!(
+      plan_key: Plan.unlimited_plus.key,
+      stripe_customer_id: "cus_456",
+      stripe_subscription_id: "sub_456",
+      status: "active"
+    )
+
+    assert_equal Plan.unlimited_plus, @account.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    @account.override_limits(bytes_used: 100.gigabytes)
+    assert_not @account.exceeding_storage_limit?
+
+    @account.override_limits(bytes_used: 500.gigabytes + 1)
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "canceled subscription falls back to Free plan" do
+    @account.create_subscription!(
+      plan_key: Plan.unlimited_plus.key,
+      stripe_customer_id: "cus_789",
+      stripe_subscription_id: "sub_789",
+      status: "canceled"
+    )
+
+    assert_nil @account.active_subscription
+    assert_equal Plan.free, @account.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comp and uncomp toggle billing waiver and plan" do
+    assert_not @account.comped?
+
+    @account.comp
+    assert @account.comped?
+    assert_equal Plan.paid, @account.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.override_limits(card_count: 1_500)
+    assert_not @account.exceeding_card_limit?
+
+    @account.uncomp
+    assert_not @account.comped?
+    assert_equal Plan.free, @account.plan
+    assert @account.exceeding_card_limit?
+  end
+
+  test "nearing and exceeding card limits" do
+    @account.override_limits(card_count: 899)
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+    assert_equal 101, @account.cards_remaining
+
+    @account.override_limits(card_count: 900)
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+    assert_equal 100, @account.cards_remaining
+
+    @account.override_limits(card_count: 950)
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+
+    @account.override_limits(card_count: 999)
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+    assert_equal 1, @account.cards_remaining
+
+    @account.override_limits(card_count: 1_000)
+    assert_not @account.nearing_card_limit?
+    assert @account.exceeding_card_limit?
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "override_limits and reset_limits" do
+    actual_cards = @account.cards.published.count
+
+    @account.override_limits(card_count: 0, bytes_used: 0)
+    assert_equal 0, @account.card_count
+    assert_equal 0, @account.bytes_used
+
+    @account.override_limits(card_count: 950, bytes_used: 2.gigabytes)
+    assert_equal 950, @account.card_count
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.exceeding_storage_limit?
+
+    @account.reset_limits
+    assert_nil @account.overridden_limits
+    assert_equal actual_cards, @account.card_count
+    assert_not @account.exceeding_storage_limit?
+  end
+
+  test "cancelling an account with an active subscription cancels the Stripe subscription" do
+    @account.create_subscription!(
+      plan_key: Plan.unlimited.key,
+      stripe_customer_id: "cus_cancel",
+      stripe_subscription_id: "sub_cancel",
+      status: "active"
+    )
+
+    Stripe::Subscription.expects(:cancel).with("sub_cancel").once
+
+    perform_enqueued_jobs do
+      @account.cancel(initiated_by: users(:mike))
+    end
+
+    assert_equal "canceled", @account.subscription.reload.status
+  end
+end
