@@ -0,0 +1,45 @@
+<section class="settings__section">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <div>
+      Your account is on the <strong><%= account.plan.name %></strong> plan<% if account.comped? && !account.active_subscription %> (Comped)<% end %>.
+    </div>
+  </header>
+
+  <div class="txt-small txt-ink-medium">
+    <% if account.plan.limit_cards? %>
+      <%= number_with_delimiter(account.card_count) %> of <%= number_with_delimiter(account.card_limit) %> cards used •
+    <% else %>
+      Unlimited cards •
+    <% end %>
+    <%= number_to_human_size(account.bytes_used) %> of <%= number_to_human_size(account.storage_limit) %> storage used
+  </div>
+
+  <% if account.active_subscription %>
+    <% if account.active_subscription.canceling? %>
+      <div class="txt-small">
+        Your subscription will be canceled on <%= l(account.active_subscription.cancel_at.to_date, format: :long) %>.
+      </div>
+    <% elsif account.active_subscription.current_period_end %>
+      <div class="txt-small">
+        Renews on <%= l(account.active_subscription.current_period_end.to_date, format: :long) %>.
+      </div>
+    <% end %>
+
+    <div class="flex gap-half justify-center">
+      <%= button_to "Manage subscription", saas.account_billing_portal_path, method: :post, class: "btn settings-subscription__button", data: { turbo: false } %>
+    </div>
+  <% elsif !account.comped? %>
+    <div class="flex flex-column gap-half">
+      <% Plan.paid_plans.each do |plan| %>
+        <div class="flex align-center justify-space-between gap-half">
+          <div class="txt-align-start">
+            <strong><%= plan.name %></strong>
+            <div class="txt-small txt-ink-medium">$<%= plan.price %>/month • Unlimited cards • <%= number_to_human_size(plan.storage_limit) %> storage</div>
+          </div>
+          <%= button_to "Upgrade", saas.account_subscription_path(plan_key: plan.key), method: :post, class: "btn btn--link settings-subscription__button", data: { turbo: false } %>
+        </div>
+      <% end %>
+    </div>
+  <% end %>
+</section>
diff --git a/saas/app/views/admin/accounts/index.html.erb b/saas/app/views/admin/accounts/index.html.erb
new file mode 100644
index 0000000..8e66bab
--- /dev/null
+++ b/saas/app/views/admin/accounts/index.html.erb
@@ -0,0 +1,47 @@
+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <div class="flex align-center justify-space-between gap-half">
+      <h2 class="txt-medium">All Accounts (<%= @accounts.count %>)</h2>
+      <%= link_to "Stats", saas.admin_stats_path, class: "btn txt-small" %>
+    </div>
+
+    <%= form_with url: saas.admin_accounts_path, method: :get, class: "flex gap-half margin-block-half" do |form| %>
+      <%= form.search_field :q, value: params[:q], placeholder: "Search by name or account ID…", class: "input flex-item-grow" %>
+      <%= form.submit "Search", class: "btn" %>
+    <% end %>
+
+    <ul class="margin-block-half">
+      <% @accounts.each do |account| %>
+        <% owner = account.users.find(&:owner?) %>
+        <li class="flex align-center justify-space-between gap-half margin-block-start-half">
+          <div class="flex-item-grow min-width overflow-ellipsis txt-align-start">
+            <strong><%= link_to account.name, saas.admin_account_path(account), class: "txt-ink txt-underline" %></strong>
+            <div class="txt-x-small txt-ink-medium">
+              #<%= account.external_account_id %> •
+              <%= owner&.identity&.email_address || "No owner" %>
+            </div>
+          </div>
+
+          <div class="txt-small txt-align-end">
+            <div>
+              <strong><%= account.plan.name %></strong>
+              <% if account.comped? %>
+                <span class="txt-x-small">(Comped)</span>
+              <% end %>
+            </div>
+            <div class="txt-x-small txt-ink-medium">
+              <%= number_with_delimiter(account.card_count) %> cards •
+              <%= number_to_human_size(account.bytes_used) %>
+            </div>
+          </div>
+        </li>
+      <% end %>
+    </ul>
+  </div>
+</section>
diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..dc9e584
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,86 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to saas.admin_accounts_path, class: "btn btn--back" do %>
+      <%= icon_tag "arrow-left" %>
+      <strong>Accounts</strong>
+    <% end %>
+  </div>
+
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Account details</h2>
+      </header>
+
+      <div class="flex flex-column gap-quarter txt-small txt-align-start">
+        <div><strong>Account ID:</strong> #<%= @account.external_account_id %></div>
+        <div><strong>Owner:</strong> <%= @account.owner_name %> (<%= @account.owner_email %>)</div>
+        <div>
+          <strong>Plan:</strong>
+          <%= @account.plan.name %>
+          <% if @account.comped? %>
+            <span>(Comped)</span>
+          <% end %>
+        </div>
+        <% if @account.subscription %>
+          <div><strong>Subscription status:</strong> <%= @account.subscription.status || "none" %></div>
+          <div><strong>Stripe customer:</strong> <%= @account.subscription.stripe_customer_id %></div>
+        <% end %>
+        <div><strong>Card count:</strong> <%= number_with_delimiter(@account.card_count) %> (<%= number_with_delimiter(@account.cards.published.count) %> actual)</div>
+        <div><strong>Bytes used:</strong> <%= number_to_human_size(@account.bytes_used) %> (<%= number_with_delimiter(@account.bytes_used) %> bytes)</div>
+        <div><strong>Storage limit:</strong> <%= number_to_human_size(@account.storage_limit) %></div>
+      </div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Billing waiver</h2>
+      </header>
+
+      <div class="flex gap-half justify-center">
+        <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn", disabled: @account.comped? %>
+        <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn", disabled: !@account.comped? %>
+      </div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Limit overrides</h2>
+      </header>
+
+      <% if @overridden_limits.errors.any? %>
+        <ul class="txt-negative txt-small">
+          <% @overridden_limits.errors.full_messages.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      <% end %>
+
+      <%= form_with model: @overridden_limits, url: saas.admin_account_overridden_limits_path(@account), method: :post, class: "flex flex-column gap-half txt-align-start" do |form| %>
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :card_count, "Card count", class: "txt-small font-weight-bold" %>
+          <%= form.number_field :card_count, class: "input", min: 0, placeholder: @account.cards.published.count %>
+        </div>
+
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :bytes_used, "Bytes used", class: "txt-small font-weight-bold" %>
+          <%= form.number_field :bytes_used, class: "input", min: 0, placeholder: @account.storage_total&.bytes_stored || 0 %>
+        </div>
+
+        <div class="flex gap-half justify-center">
+          <%= form.submit "Override", class: "btn btn--link" %>
+        </div>
+      <% end %>
+
+      <div class="flex justify-center margin-block-start-half">
+        <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn" %>
+      </div>
+    </section>
+  </div>
+</section>
