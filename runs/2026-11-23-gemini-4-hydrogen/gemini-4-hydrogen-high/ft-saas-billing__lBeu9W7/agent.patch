+class Admin::Accounts::OverriddenLimitsController < AdminController
+  layout "public"
+
+  before_action :set_account
+
+  def create
+    @account.override_limits(**limit_params)
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+  rescue ActiveRecord::RecordInvalid => error
+    @overridden_limits = error.record
+    render "admin/accounts/show", status: :unprocessable_entity
+  end
+
+  def destroy
+    @account.reset_limits
+    redirect_to saas.admin_account_path(@account), notice: "Limits reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:account_id]) || Account.find_by!(external_account_id: params[:account_id])
+    end
+
+    def limit_params
+      raw = params[:account_overridden_limits] || params
+      permitted = raw.permit(:card_count, :bytes_used)
+      {
+        card_count: permitted[:card_count].presence&.to_i,
+        bytes_used: permitted[:bytes_used].presence&.to_i
+      }
+    end
+end
