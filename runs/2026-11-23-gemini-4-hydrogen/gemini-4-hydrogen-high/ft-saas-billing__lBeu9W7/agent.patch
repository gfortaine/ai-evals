diff --git a/saas/app/controllers/stripe_webhooks_controller.rb b/saas/app/controllers/stripe_webhooks_controller.rb
new file mode 100644
index 0000000..a7180f1
--- /dev/null
+++ b/saas/app/controllers/stripe_webhooks_controller.rb
@@ -0,0 +1,75 @@
+class StripeWebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    event = construct_event
+    handle_event(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def construct_event
+      payload = request.body.read
+      signature = request.env["HTTP_STRIPE_SIGNATURE"]
+      Stripe::Webhook.construct_event(payload, signature, ENV["STRIPE_WEBHOOK_SECRET"])
+    end
+
+    def handle_event(event)
+      case event.type
+      when "checkout.session.completed"
+        handle_checkout_session_completed(event.data.object)
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        handle_subscription_change(event.data.object)
+      when "invoice.upcoming"
+        handle_invoice_upcoming(event.data.object)
+      end
+    end
+
+    def handle_checkout_session_completed(session)
+      return unless session[:mode] == "subscription"
+
+      account = find_account_for_checkout_session(session)
+      return unless account
+
+      subscription = account.subscription || account.build_subscription
+      subscription.stripe_customer_id = session[:customer] if session[:customer].present?
+      subscription.stripe_subscription_id = session[:subscription] if session[:subscription].present?
+
+      if (plan_key = session[:metadata]&.[](:plan_key)).present? && subscription.plan_key.blank?
+        subscription.plan_key = plan_key
+      end
+
+      if subscription.status.blank? && session[:payment_status].in?(%w[ paid no_payment_required ])
+        subscription.status = "active"
+      end
+
+      subscription.save!
+    end
+
+    def handle_subscription_change(stripe_subscription)
+      if subscription = Account::Subscription.find_or_build_for_stripe_subscription(stripe_subscription)
+        subscription.sync_from_stripe(stripe_subscription)
+      end
+    end
+
+    def handle_invoice_upcoming(invoice)
+      if subscription_id = invoice[:subscription]
+        if subscription = Account::Subscription.find_by(stripe_subscription_id: subscription_id)
+          subscription.update!(next_amount_due_in_cents: invoice[:amount_due]) if invoice[:amount_due]
+        end
+      end
+    end
+
+    def find_account_for_checkout_session(session)
+      account_id = session[:metadata]&.[](:account_id) || session[:client_reference_id]
+      if account_id.present?
+        Account.find_by(id: account_id)
+      elsif session[:customer].present?
+        Account::Subscription.find_by(stripe_customer_id: session[:customer])&.account
+      end
+    end
+end
