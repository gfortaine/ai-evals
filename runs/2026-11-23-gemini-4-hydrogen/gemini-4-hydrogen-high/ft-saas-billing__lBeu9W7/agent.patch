diff --git a/saas/app/controllers/account/subscriptions_controller.rb b/saas/app/controllers/account/subscriptions_controller.rb
new file mode 100644
index 0000000..96bab37
--- /dev/null
+++ b/saas/app/controllers/account/subscriptions_controller.rb
@@ -0,0 +1,49 @@
+class Account::SubscriptionsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    if Current.account.active_subscription
+      redirect_to_billing_portal
+    else
+      plan = Plan[params[:plan_key]] || Plan.paid
+
+      if plan.free? || plan.stripe_price_id.blank?
+        redirect_to main_app.account_settings_path, alert: "Unable to start checkout for this plan."
+      else
+        redirect_to_checkout(plan)
+      end
+    end
+  end
+
+  private
+    def redirect_to_checkout(plan)
+      session_params = {
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        client_reference_id: Current.account.id,
+        metadata: { account_id: Current.account.id, plan_key: plan.key },
+        subscription_data: {
+          metadata: { account_id: Current.account.id }
+        },
+        success_url: main_app.account_settings_url(checkout: "success"),
+        cancel_url: main_app.account_settings_url
+      }
+
+      if customer_id = Current.account.subscription&.stripe_customer_id
+        session_params[:customer] = customer_id
+      else
+        session_params[:customer_email] = Current.user.identity.email_address
+      end
+
+      checkout_session = Stripe::Checkout::Session.create(session_params)
+      redirect_to checkout_session.url, allow_other_host: true
+    end
+
+    def redirect_to_billing_portal
+      portal_session = Stripe::BillingPortal::Session.create(
+        customer: Current.account.subscription.stripe_customer_id,
+        return_url: main_app.account_settings_url
+      )
+      redirect_to portal_session.url, allow_other_host: true
+    end
+end
