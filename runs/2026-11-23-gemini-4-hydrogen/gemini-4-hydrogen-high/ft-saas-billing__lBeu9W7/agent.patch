+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "free plan has 1000 cards and 1 GB storage" do
+    plan = Plan.free
+
+    assert_equal "Free", plan.name
+    assert_equal 0, plan.price
+    assert_equal 1_000, plan.card_limit
+    assert_equal 1.gigabyte, plan.storage_limit
+    assert plan.free?
+    assert_not plan.paid?
+    assert plan.limit_cards?
+  end
+
+  test "unlimited plan is $20/month with 5 GB storage and unlimited cards" do
+    plan = Plan.unlimited
+
+    assert_equal "Unlimited", plan.name
+    assert_equal 20, plan.price
+    assert plan.unlimited_cards?
+    assert_not plan.limit_cards?
+    assert_equal 5.gigabytes, plan.storage_limit
+    assert plan.paid?
+  end
+
+  test "unlimited+ plan is $25/month with 500 GB storage and unlimited cards" do
+    plan = Plan.unlimited_plus
+
+    assert_equal "Unlimited+", plan.name
+    assert_equal 25, plan.price
+    assert plan.unlimited_cards?
+    assert_not plan.limit_cards?
+    assert_equal 500.gigabytes, plan.storage_limit
+    assert plan.paid?
+  end
+
+  test "find_by_price_id matches configured Stripe price IDs" do
+    with_env("STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus") do
+      assert_equal Plan.unlimited, Plan.find_by_price_id("price_unlimited")
+      assert_equal Plan.unlimited_plus, Plan.find_by_price_id("price_plus")
+      assert_nil Plan.find_by_price_id("price_unknown")
+      assert_nil Plan.find_by_price_id(nil)
+      assert_nil Plan.find_by_price_id("")
+    end
+  end
+
+  private
+    def with_env(vars)
+      previous = vars.keys.index_with { |k| ENV[k] }
+      vars.each { |k, v| ENV[k] = v }
+      yield
+    ensure
+      previous.each { |k, v| ENV[k] = v }
+    end
+end
