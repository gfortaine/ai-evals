@@ -0,0 +1,36 @@
+require "application_system_test_case"
+
+class StalledCardsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "viewing stalled cards and resetting via comment" do
+    card = cards(:logo)
+    card.update!(burst_at: 3.weeks.ago, last_active_at: 15.days.ago)
+
+    visit cards_url(indexed_by: :stalled)
+    assert_selector "article.card--stalled", text: card.title
+    within "article.card--stalled" do
+      assert_selector ".bubble:not([hidden])"
+      assert_text(/Stalled for/i)
+      assert_text "15"
+    end
+
+    click_on card.title
+    assert_selector ".card-perma .bubble:not([hidden])"
+    assert_text(/Stalled for/i)
+    assert_text "15"
+
+    assert_selector "lexxy-editor [contenteditable='true']"
+    fill_in_lexxy with: "Picking this back up"
+    assert_selector "button:not([disabled])", text: "Post"
+    click_on "Post"
+
+    assert_text "Picking this back up"
+    assert_no_selector ".card-perma .bubble:not([hidden])"
+
+    visit cards_url(indexed_by: :stalled)
+    assert_no_text card.title
+  end
+end
