diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..7ecb626 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -76,7 +76,9 @@ class Card::EntropicTest < ActiveSupport::TestCase
     Card.auto_postpone_all_due
 
     assert cards(:logo).reload.postponed?
+    assert_equal accounts("37s").system_user, cards(:logo).postponed_by
     assert cards(:radio).reload.postponed?
+    assert_equal accounts("initech").system_user, cards(:radio).postponed_by
   end
 
   test "postponing_soon scope works properly cross-account" do
@@ -85,4 +87,39 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "due_to_be_postponed excludes drafted, closed, and already postponed cards" do
+    cutoff_past = entropies(:writebook_board).auto_postpone_period.seconds.ago - 2.days
+
+    cards(:logo).update!(last_active_at: cutoff_past)
+    cards(:shipping).update!(last_active_at: cutoff_past) # closed via fixture
+    cards(:layout).postpone(user: users(:david))
+    cards(:layout).update!(last_active_at: cutoff_past)
+    cards(:unfinished_thoughts).update!(last_active_at: 400.days.ago) # drafted
+
+    due = Card.due_to_be_postponed.to_a
+    assert_includes due, cards(:logo)
+    assert_not_includes due, cards(:shipping)
+    assert_not_includes due, cards(:layout)
+    assert_not_includes due, cards(:unfinished_thoughts)
+  end
+
+  test "due_to_be_postponed ignores boards without board or account entropy" do
+    entropies(:writebook_board).destroy
+    entropies("37s_account").destroy
+    cards(:logo).update!(last_active_at: 400.days.ago)
+
+    assert_not_includes Card.due_to_be_postponed, cards(:logo)
+  end
+
+  test "due_to_be_postponed composes with association scopes and batching" do
+    cards(:logo).update!(last_active_at: entropies(:writebook_board).auto_postpone_period.seconds.ago - 2.days)
+    cards(:radio).update!(last_active_at: entropies(:miltons_wish_list_board).auto_postpone_period.seconds.ago - 2.days)
+
+    assert_equal [ cards(:logo) ], boards(:writebook).cards.due_to_be_postponed.to_a
+    assert_equal [ cards(:logo) ], accounts("37s").cards.due_to_be_postponed.to_a
+    assert_equal [ cards(:logo) ], users(:david).accessible_cards.due_to_be_postponed.to_a
+    assert_equal 2, Card.due_to_be_postponed.count
+    assert_equal cards(:logo, :radio).to_set, Card.due_to_be_postponed.find_each.to_set
+  end
 end
