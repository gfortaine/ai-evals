index 0000000..f6ce633
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlight_search_terms wraps matched words in mark preserving case" do
+    assert_equal "The <mark>logo</mark> isn&#39;t big enough", highlight_search_terms("The logo isn't big enough", [ "logo" ])
+    assert_equal "<mark>LOGO</mark> needs work", highlight_search_terms("LOGO needs work", [ "logo" ])
+    assert_equal "The <mark>logo</mark> isn&#39;t <mark>big</mark> enough", highlight_search_terms("The logo isn't big enough", [ "logo", "big" ])
+  end
+
+  test "highlight_search_terms escapes HTML safely without corrupting entities or mark tags" do
+    assert_equal "&lt;<mark>script</mark>&gt;alert(1)&lt;/<mark>script</mark>&gt;",
+      highlight_search_terms("<script>alert(1)</script>", [ "script" ])
+
+    assert_equal "Tom &amp; Jerry",
+      highlight_search_terms("Tom & Jerry", [ "amp" ])
+
+    assert_equal "Check <mark>mark</mark>",
+      highlight_search_terms("Check mark", [ "mark" ])
+  end
+
+  test "highlight_search_terms handles regex metacharacters" do
+    assert_equal "Using <mark>C++</mark> and <mark>(test)</mark>",
+      highlight_search_terms("Using C++ and (test)", [ "C++", "(test)" ])
+  end
+
+  test "highlight_card_title highlights matches and preserves inline code" do
+    card = cards(:logo)
+    card.title = "Fix the `bug` in production"
+
+    assert_equal "Fix the <code><mark>bug</mark></code> in production",
+      highlight_card_title(card, [ "bug" ])
+    assert_equal "Fix the <code>bug</code> in production",
+      highlight_card_title(card, [ "code" ])
+  end
+
+  test "search_excerpt windows around match in long content" do
+    long_text = "#{'filler ' * 40}critical needle here#{' trailing' * 40}"
+    result = search_excerpt(long_text, [ "needle" ], length: 80)
+
+    assert_includes result, "<mark>needle</mark>"
+    assert result.start_with?("…")
+    assert result.end_with?("…")
+  end
+end
