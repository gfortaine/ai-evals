+<% @page_title = @search.blank? ? "Search" : "Search: #{@search.query}" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get, class: "search__form flex align-center gap-half center margin-block-end" do |form| %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards by title, description, or comments…", class: "input full-width", autofocus: @search.blank?, autocorrect: "off", autocomplete: "off", data: { "1p-ignore": "true" } %>
+    <%= form.button type: "submit", class: "btn btn--reversed" do %>
+      <%= icon_tag "search" %>
+      <span>Search</span>
+    <% end %>
+  <% end %>
+
+  <% if @search.blank? %>
+    <div class="blank-slate">Search cards by title, description, or comments</div>
+  <% else %>
+    <section class="cards cards--grid">
+      <div class="cards__list hide-scrollbar">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "searches/card", collection: @page.records, as: :card, locals: { search: @search } %>
+        <% end %>
+        <div class="blank-slate">No cards match “<%= @search.query %>”</div>
+      </div>
+    </section>
+  <% end %>
+</section>
