diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..f4427ed
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path(q: "logo")
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "show without query renders empty prompt" do
+    get search_path
+    assert_response :success
+    assert_select "form[action=?][method='get'] input[name='q']", search_path
+    assert_select ".blank-slate", text: /Search cards/
+  end
+
+  test "finds cards by title with matched words wrapped in mark" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "article.card", count: 1
+    assert_select "h3.card__title mark", text: "logo"
+    assert_select "a.card__link[href=?]", card_path(cards(:logo))
+  end
+
+  test "finds cards by description with matched words wrapped in mark" do
+    cards(:buy_domain).update!(description: "Check DNS propagation after purchasing")
+
+    get search_path(q: "propagation")
+    assert_response :success
+
+    assert_select "article.card", count: 1
+    assert_select ".search__excerpt mark", text: "propagation"
+  end
+
+  test "finds cards by comment body with matched words wrapped in mark" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select "article.card", count: 1
+    assert_select "a.card__link[href=?]", card_path(cards(:layout))
+    assert_select ".search__comment-body mark", text: "overflowing"
+  end
+
+  test "orders results newest first" do
+    older, newer = with_current_user(:david) do
+      [
+        boards(:writebook).cards.create!(title: "First milestone", status: :published, creator: users(:david), created_at: 2.days.ago),
+        boards(:writebook).cards.create!(title: "Second milestone", status: :published, creator: users(:david), created_at: 1.hour.ago)
+      ]
+    end
+
+    get search_path(q: "milestone")
+    assert_response :success
+
+    links = css_select("article.card a.card__link").map { |el| el["href"] }
+    assert_equal [ card_path(newer), card_path(older) ], links
+  end
+
+  test "excludes draft cards and their comments" do
+    with_current_user(:david) do
+      draft = boards(:writebook).cards.create!(title: "Draft zeppelin", description: "Zeppelin description", status: :published, creator: users(:david))
+      draft.comments.create!(body: "Zeppelin comment", creator: users(:david))
+      draft.update_column(:status, "drafted")
+    end
+
+    get search_path(q: "zeppelin")
+    assert_response :success
+
+    assert_select "article.card", count: 0
+    assert_select ".blank-slate", text: /No cards match/
+  end
+
+  test "only shows results from boards the user currently has access to" do
+    private_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Secret submarine", status: :published, creator: users(:kevin))
+    end
+
+    get search_path(q: "submarine")
+    assert_response :success
+    assert_select "article.card", count: 0
+
+    logout_and_sign_in_as :kevin
+    get search_path(q: "submarine")
+    assert_response :success
+    assert_select "article.card", count: 1
+    assert_select "a.card__link[href=?]", card_path(private_card)
+
+    boards(:private).accesses.revoke_from(users(:kevin))
+    get search_path(q: "submarine")
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+
+  test "includes closed and postponed cards on accessible boards" do
+    with_current_user(:david) do
+      cards(:shipping).postpone
+    end
+
+    get search_path(q: "ship")
+    assert_response :success
+    assert_select "a.card__link[href=?]", card_path(cards(:shipping))
+  end
+
+  test "escapes HTML in query and results" do
+    with_current_user(:david) do
+      boards(:writebook).cards.create!(title: "<script>alert(1)</script> issue", status: :published, creator: users(:david))
+    end
+
+    get search_path(q: "<script>")
+    assert_response :success
+    assert_no_match(/<script>alert/, response.body)
+    assert_select "h3.card__title mark", text: "<script>"
+  end
+
+  test "paginates results preserving query parameter" do
+    with_current_user(:david) do
+      20.times do |i|
+        boards(:writebook).cards.create!(title: "Paginated item #{i}", status: :published, creator: users(:david))
+      end
+    end
+
+    get search_path(q: "Paginated")
+    assert_response :success
+    assert_select "article.card", count: 15
+    assert_select "a.pagination-link[href*=?]", "q=Paginated"
+
+    get search_path(q: "Paginated", page: 2)
+    assert_response :success
+    assert_select "article.card", count: 5
+  end
+
+  test "handles malformed array query parameter safely" do
+    get search_path, params: { q: [ "logo" ] }
+    assert_response :success
+    assert_select ".blank-slate", text: /Search cards/
+  end
+end
diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
