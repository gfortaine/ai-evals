diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..3eaf0f8
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,92 @@
+module SearchesHelper
+  def highlight_search_terms(text, terms)
+    if text.blank?
+      ""
+    elsif terms.blank?
+      ERB::Util.html_escape(text)
+    else
+      highlight_plain_text(text.to_s, terms).html_safe
+    end
+  end
+
+  def highlight_card_title(card, terms)
+    return card.title if card.title.blank?
+
+    card.title.split(/(`[^`]+`)/).map do |part|
+      if part.start_with?("`") && part.end_with?("`") && part.length >= 2
+        "<code>#{highlight_search_terms(part[1..-2], terms)}</code>"
+      else
+        highlight_search_terms(part, terms)
+      end
+    end.join.html_safe
+  end
+
+  def search_excerpt(content, terms, length: 240)
+    text = normalize_search_text(content)
+    if text.blank?
+      ""
+    else
+      highlight_search_terms(excerpt_around_match(text, terms, length: length), terms)
+    end
+  end
+
+  private
+    def highlight_plain_text(text, terms)
+      pattern = search_terms_regexp(terms)
+      result = +""
+      last_index = 0
+
+      text.scan(pattern) do
+        match = Regexp.last_match
+        result << ERB::Util.html_escape(text[last_index...match.begin(0)])
+        result << "<mark>#{ERB::Util.html_escape(match[0])}</mark>"
+        last_index = match.end(0)
+      end
+
+      result << ERB::Util.html_escape(text[last_index..])
+      result
+    end
+
+    def normalize_search_text(content)
+      raw = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+      raw.gsub(/\s+/, " ").strip
+    end
+
+    def excerpt_around_match(text, terms, length:)
+      return text if text.length <= length
+
+      match = terms.present? ? text.match(search_terms_regexp(terms)) : nil
+      if match
+        window_around_match(text, match.begin(0), match.end(0), length)
+      else
+        text.truncate(length)
+      end
+    end
+
+    def window_around_match(text, match_start, match_end, length)
+      half = length / 2
+      start = [ match_start - half, 0 ].max
+      finish = [ start + length, text.length ].min
+      start = [ finish - length, 0 ].max
+
+      if start > 0
+        space = text.index(" ", start)
+        start = space + 1 if space && space < match_start
+      end
+
+      if finish < text.length
+        space = text.rindex(" ", finish)
+        finish = space if space && space >= match_end
+      end
+
+      snippet = text[start...finish]
+      snippet = "…#{snippet}" if start > 0
+      snippet = "#{snippet}…" if finish < text.length
+      snippet
+    end
+
+    def search_terms_regexp(terms)
+      escaped = terms.sort_by { |term| -term.length }.map { |term| Regexp.new(Regexp.escape(term), Regexp::IGNORECASE) }
+      Regexp.union(escaped)
+    end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..dc18127
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,96 @@
+class Search
+  attr_reader :user, :query
+
+  def initialize(user, query)
+    @user = user
+    @query = query.is_a?(String) ? query.strip : ""
+  end
+
+  def terms
+    @terms ||= query.split(/\s+/).uniq(&:downcase)
+  end
+
+  def blank?
+    terms.empty?
+  end
+
+  def cards
+    @cards ||= if blank?
+      Card.none
+    else
+      matching_cards.preloaded.preload(comments: [ :creator, :rich_text_body ]).reverse_chronologically
+    end
+  end
+
+  def description_matches?(card)
+    text_matches_any_term?(card.description.to_plain_text)
+  end
+
+  def matching_comments(card)
+    card.comments
+      .sort_by { |comment| [ comment.created_at, comment.id ] }
+      .select { |comment| text_matches_any_term?(comment.body.to_plain_text) }
+  end
+
+  private
+    def matching_cards
+      candidates = user.accessible_cards.published
+      terms.each do |term|
+        candidates = candidates.merge(term_scope(term))
+      end
+
+      matching_ids = candidates
+        .preload(:rich_text_description, comments: :rich_text_body)
+        .select { |card| card_matches_all_terms?(card) }
+        .map(&:id)
+
+      user.accessible_cards.published.where(id: matching_ids)
+    end
+
+    def term_scope(term)
+      pattern = like_pattern(term)
+      rich_text_patterns = [ pattern, like_pattern(ERB::Util.html_escape(term)) ].uniq
+      rich_text_condition = rich_text_patterns.map { "LOWER(action_text_rich_texts.body) LIKE LOWER(?) ESCAPE '!'" }.join(" OR ")
+
+      title_match = Card.where("LOWER(cards.title) LIKE LOWER(?) ESCAPE '!'", pattern)
+      description_match = Card.where(
+        id: ActionText::RichText
+          .where(account_id: user.account_id, record_type: "Card", name: "description")
+          .where(rich_text_condition, *rich_text_patterns)
+          .select(:record_id)
+      )
+      comment_match = Card.where(
+        id: Comment
+          .joins(:rich_text_body)
+          .where(account_id: user.account_id)
+          .where(rich_text_condition, *rich_text_patterns)
+          .select(:card_id)
+      )
+
+      title_match.or(description_match).or(comment_match)
+    end
+
+    def like_pattern(term)
+      "%#{ActiveRecord::Base.sanitize_sql_like(term, "!")}%"
+    end
+
+    def card_matches_all_terms?(card)
+      searchable_texts = [
+        card.title.to_s,
+        card.description.to_plain_text,
+        *card.comments.map { |comment| comment.body.to_plain_text }
+      ]
+
+      terms.all? do |term|
+        searchable_texts.any? { |text| text_includes_term?(text, term) }
+      end
+    end
+
+    def text_matches_any_term?(text)
+      text.present? && !blank? && terms.any? { |term| text_includes_term?(text, term) }
+    end
+
+    def text_includes_term?(text, term)
+      text.downcase.include?(term.downcase)
+    end
+end
