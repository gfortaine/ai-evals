+++ b/test/models/search_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "finds cards by title" do
+    results = Search.new(users(:david), "logo").cards
+    assert_equal [ cards(:logo) ], results.to_a
+  end
+
+  test "finds cards by description" do
+    cards(:buy_domain).update!(description: "Register the primary domain before launch")
+
+    results = Search.new(users(:david), "register").cards
+    assert_equal [ cards(:buy_domain) ], results.to_a
+  end
+
+  test "finds cards by comment body" do
+    results = Search.new(users(:david), "overflowing").cards
+    assert_equal [ cards(:layout) ], results.to_a
+  end
+
+  test "search is case-insensitive" do
+    assert_equal [ cards(:logo) ], Search.new(users(:david), "LOGO").cards.to_a
+    assert_equal [ cards(:layout) ], Search.new(users(:david), "OVERFLOWING").cards.to_a
+  end
+
+  test "orders results newest first by created_at" do
+    older_card = boards(:writebook).cards.create!(title: "Alpha widget", status: :published, creator: users(:david), created_at: 3.days.ago, last_active_at: 1.minute.ago)
+    newer_card = boards(:writebook).cards.create!(title: "Beta widget", status: :published, creator: users(:david), created_at: 1.day.ago, last_active_at: 2.days.ago)
+    newest_card = boards(:writebook).cards.create!(title: "Gamma widget", status: :published, creator: users(:david), created_at: 1.hour.ago, last_active_at: 3.days.ago)
+
+    results = Search.new(users(:david), "widget").cards.to_a
+    assert_equal [ newest_card, newer_card, older_card ], results
+  end
+
+  test "matches multiple words across title, description, and comments" do
+    card = boards(:writebook).cards.create!(
+      title: "Checkout flow",
+      description: "<p>Needs better <strong>validation</strong></p>",
+      status: :published,
+      creator: users(:david)
+    )
+    card.comments.create!(body: "Tested on mobile Safari")
+
+    assert_equal [ card ], Search.new(users(:david), "checkout validation safari").cards.to_a
+    assert_empty Search.new(users(:david), "checkout nonexistent").cards.to_a
+  end
+
+  test "does not match HTML tags or attributes in rich text" do
+    boards(:writebook).cards.create!(
+      title: "Plain card",
+      description: '<p>See <a href="https://example.com">example</a> and <strong>bold</strong></p>',
+      status: :published,
+      creator: users(:david)
+    )
+
+    assert_empty Search.new(users(:david), "strong").cards.to_a
+    assert_empty Search.new(users(:david), "href").cards.to_a
+  end
+
+  test "handles special characters and SQL LIKE wildcards safely" do
+    card = boards(:writebook).cards.create!(
+      title: "100% test_case",
+      description: "<p>Tom & Jerry</p>",
+      status: :published,
+      creator: users(:david)
+    )
+    other = boards(:writebook).cards.create!(
+      title: "1000 testXcase",
+      status: :published,
+      creator: users(:david)
+    )
+
+    assert_equal [ card ], Search.new(users(:david), "100%").cards.to_a
+    assert_equal [ card ], Search.new(users(:david), "test_case").cards.to_a
+    assert_equal [ card ], Search.new(users(:david), "Tom & Jerry").cards.to_a
+    assert_not_includes Search.new(users(:david), "100%").cards.to_a, other
+  end
+
+  test "never returns draft cards or their comments" do
+    draft = boards(:writebook).cards.create!(
+      title: "Secret draft unicorn",
+      description: "Draft description unicorn",
+      status: :published,
+      creator: users(:david)
+    )
+    draft.comments.create!(body: "Draft comment unicorn", creator: users(:david))
+    draft.update_column(:status, "drafted")
+
+    assert_empty Search.new(users(:david), "unicorn").cards.to_a
+  end
+
+  test "only returns cards from boards the user currently has access to" do
+    private_card = boards(:private).cards.create!(
+      title: "Private board roadmap",
+      description: "Confidential details",
+      status: :published,
+      creator: users(:kevin)
+    )
+    private_card.comments.create!(body: "Private comment note", creator: users(:kevin))
+
+    assert_equal [ private_card ], Search.new(users(:kevin), "roadmap").cards.to_a
+    assert_equal [ private_card ], Search.new(users(:kevin), "Confidential").cards.to_a
+    assert_equal [ private_card ], Search.new(users(:kevin), "note").cards.to_a
+
+    assert_empty Search.new(users(:david), "roadmap").cards.to_a
+    assert_empty Search.new(users(:david), "Confidential").cards.to_a
+    assert_empty Search.new(users(:david), "note").cards.to_a
+
+    # Granting access makes results visible; revoking removes them
+    boards(:private).accesses.grant_to(users(:david))
+    assert_equal [ private_card ], Search.new(users(:david), "roadmap").cards.to_a
+
+    boards(:private).accesses.revoke_from(users(:david))
+    assert_empty Search.new(users(:david), "roadmap").cards.to_a
+  end
+
+  test "never returns cards from other accounts" do
+    assert_empty Search.new(users(:david), "radio").cards.to_a
+    assert_empty Search.new(users(:david), "paycheck").cards.to_a
+  end
+
+  test "returns no cards when query is blank" do
+    assert_empty Search.new(users(:david), "").cards.to_a
+    assert_empty Search.new(users(:david), "   ").cards.to_a
+    assert_empty Search.new(users(:david), nil).cards.to_a
+  end
+
+  test "description_matches? and matching_comments identify matching parts" do
+    card = boards(:writebook).cards.create!(
+      title: "Card title",
+      description: "Fixing the header spacing",
+      status: :published,
+      creator: users(:david)
+    )
+    matching = card.comments.create!(body: "Header looks clipped on mobile", creator: users(:david))
+    non_matching = card.comments.create!(body: "Looks good otherwise", creator: users(:kevin))
+
+    search = Search.new(users(:david), "header")
+    assert search.description_matches?(card)
+    assert_equal [ matching ], search.matching_comments(card)
+    assert_not_includes search.matching_comments(card), non_matching
+  end
+end
