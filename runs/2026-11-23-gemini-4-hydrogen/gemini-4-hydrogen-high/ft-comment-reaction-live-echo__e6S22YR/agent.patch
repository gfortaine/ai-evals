+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,171 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    Current.user = users(:david)
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "existing reactions show content, emoji styling, and who left each one" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      within "##{dom_id(reactions(:kevin_thumbs_up))}" do
+        assert_selector "span.txt-small.txt-medium", text: "👍"
+        assert_selector "img[title='Kevin']"
+      end
+    end
+  end
+
+  test "adding, canceling, and removing reactions on a comment" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      # Open the input by clicking the add reaction button
+      find(".reactions__trigger").click
+      assert_no_selector ".reactions__trigger"
+      assert_selector ".reaction__form .reaction__input"
+
+      # Cancel brings back the button without creating a reaction
+      find(".reaction__cancel-btn").click
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction__form"
+
+      # Pressing Escape also cancels without leaving the page
+      find(".reactions__trigger").click
+      find(".reaction__input").send_keys("Nevermind", :escape)
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction__form"
+
+      # Empty submit is prevented
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "   "
+      find(".reaction__submit-btn").click
+      assert_selector ".reaction__form"
+
+      # Submit a short text reaction with Enter
+      find(".reaction__input").fill_in with: "LGTM!"
+      find(".reaction__input").send_keys(:enter)
+
+      # New reaction appears in the strip without txt-medium (since it's text), input is gone, trigger button is back
+      assert_selector ".reactions__list .reaction span.txt-small:not(.txt-medium)", text: "LGTM!"
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__trigger"
+
+      # Can add another reaction right after using the emoji picker
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      find(".reaction__emoji-list button[data-emoji='🎉']").click
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reactions__list .reaction span.txt-small.txt-medium", text: "🎉"
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__trigger"
+
+      # Clicking own reaction reveals delete button; clicking outside hides it again
+      own_reaction = find(".reactions__list .reaction.reaction--deleteable", text: "LGTM!")
+      own_reaction.click
+      within own_reaction do
+        assert_selector ".reaction__delete"
+      end
+
+      find("##{dom_id(reactions(:kevin_thumbs_up))}").click
+      within own_reaction do
+        assert_no_selector ".reaction__delete"
+      end
+
+      # Clicking own reaction again and clicking delete removes it
+      own_reaction.click
+      within own_reaction do
+        find(".reaction__delete").click
+      end
+
+      assert_no_selector ".reactions__list .reaction", text: "LGTM!"
+
+      # Clicking someone else's reaction does NOT reveal a delete button
+      other_reaction = find("##{dom_id(reactions(:kevin_thumbs_up))}")
+      assert_not other_reaction[:class].include?("reaction--deleteable")
+      other_reaction.click
+      within other_reaction do
+        assert_no_selector ".reaction__delete"
+      end
+    end
+  end
+
+  test "comment with zero reactions transitions cleanly from empty to reacted and back to empty" do
+    empty_card = cards(:layout)
+    empty_comment = comments(:layout_overflowing_david)
+
+    visit card_url(empty_card)
+
+    within "##{dom_id(empty_comment, :reactions)}" do
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reactions__list"
+
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "🙌"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reactions__list .reaction", text: "🙌"
+      assert_selector ".reactions__trigger"
+
+      find(".reactions__list .reaction.reaction--deleteable", text: "🙌").click
+      find(".reaction__delete").click
+
+      assert_no_selector ".reactions__list"
+      assert_selector ".reactions__trigger"
+    end
+  end
+
+  test "input enforces 16 character limit" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find(".reactions__trigger").click
+      input = find(".reaction__input")
+      input.fill_in with: "12345678901234567890"
+      assert_equal "1234567890123456", input.value
+    end
+  end
+
+  test "everyone looking at the card sees reactions land and vanish without reloading" do
+    visit card_url(@card)
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+    assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+
+    reaction = @comment.reactions.create!(reacter: users(:jz), content: "Ship it!")
+
+    within "##{dom_id(@comment, :reactions_list)}" do
+      assert_selector ".reaction", text: "Ship it!", wait: 5
+      assert_selector "img[title='JZ']"
+    end
+
+    reaction.destroy!
+
+    within "##{dom_id(@comment, :reactions_list)}" do
+      assert_no_selector ".reaction", text: "Ship it!", wait: 5
+    end
+  end
+
+  test "live broadcast preserves an open reaction input in progress" do
+    visit card_url(@card)
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+    assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "Typing"
+    end
+
+    @comment.reactions.create!(reacter: users(:jz), content: "🔥")
+
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_selector ".reactions__list .reaction", text: "🔥", wait: 5
+      assert_equal "Typing", find(".reaction__input").value
+    end
+  end
+end
