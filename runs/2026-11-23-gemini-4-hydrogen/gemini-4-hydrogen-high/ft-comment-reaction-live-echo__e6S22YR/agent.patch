diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..3235d1e
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,56 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_reacter, only: :destroy
+  before_action :ensure_card_is_commentable, only: :create
+
+  def index
+    @reactions = @comment.reactions.chronologically
+    fresh_when etag: @reactions
+  end
+
+  def show
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..47b360a
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,39 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { reacterId: String }
+  static classes = [ "deleteable", "expanded", "deleting" ]
+
+  connect() {
+    if (this.reacterIdValue === window.Current?.user?.id) {
+      this.element.classList.add(this.deleteableClass)
+    }
+  }
+
+  toggle(event) {
+    if (this.reacterIdValue !== window.Current?.user?.id) return
+    if (event.target.closest("form")) return
+
+    this.element.classList.toggle(this.expandedClass)
+  }
+
+  delete(event) {
+    event.stopPropagation()
+  }
+
+  deleting() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  closeOnClickOutside({ target }) {
+    if (!this.element.contains(target)) {
+      this.element.classList.remove(this.expandedClass)
+    }
+  }
+
+  preventClassMorphing(event) {
+    if (event.detail?.attributeName === "class") {
+      event.preventDefault()
+    }
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..a5029d9
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,59 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "template", "container", "form", "input" ]
+
+  open() {
+    if (this.hasContainerTarget) return
+
+    this.triggerTarget.hidden = true
+    this.element.setAttribute("data-turbo-permanent", "")
+
+    const fragment = this.templateTarget.content.cloneNode(true)
+    this.element.appendChild(fragment)
+
+    this.resize()
+    this.inputTarget.focus()
+  }
+
+  close() {
+    this.element.removeAttribute("data-turbo-permanent")
+    if (this.hasContainerTarget) {
+      this.containerTarget.remove()
+    }
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  submitting() {
+    this.element.removeAttribute("data-turbo-permanent")
+  }
+
+  submitted(event) {
+    if (event.detail.success && this.element.isConnected) {
+      this.close()
+    } else if (this.hasContainerTarget) {
+      this.element.setAttribute("data-turbo-permanent", "")
+    }
+  }
+
+  pickEmoji(event) {
+    const emoji = event.currentTarget.dataset.emoji
+    const input = this.inputTarget
+    const chars = Array.from(input.value + emoji)
+
+    if (chars.length <= 16) {
+      input.value = chars.join("")
+    }
+
+    this.resize()
+    input.focus()
+  }
+
+  resize() {
+    if (!this.hasInputTarget) return
+
+    const length = Math.max(this.inputTarget.value.length, 5)
+    this.inputTarget.style.inlineSize = `${Math.min(length + 1, 16)}ch`
+  }
+}
