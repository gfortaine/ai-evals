+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "validates content presence and 16 character max length" do
+    comment = comments(:logo_agreement_jz)
+
+    blank_reaction = comment.reactions.build(content: "   ")
+    assert_not blank_reaction.valid?
+    assert_predicate blank_reaction.errors[:content], :any?
+
+    max_reaction = comment.reactions.build(content: "a" * 16)
+    assert max_reaction.valid?
+
+    too_long_reaction = comment.reactions.build(content: "a" * 17)
+    assert_not too_long_reaction.valid?
+    assert_predicate too_long_reaction.errors[:content], :any?
+  end
+
+  test "strips surrounding whitespace from content" do
+    reaction = comments(:logo_agreement_jz).reactions.create!(content: "  LGTM  ")
+    assert_equal "LGTM", reaction.content
+  end
+
+  test "all_emoji?" do
+    assert reactions(:kevin_thumbs_up).all_emoji?
+    assert_not comments(:logo_agreement_jz).reactions.build(content: "Great 👍").all_emoji?
+    assert_not comments(:logo_agreement_jz).reactions.build(content: "LGTM").all_emoji?
+  end
+
+  test "touches comment and broadcasts card refresh on create and destroy" do
+    comment = comments(:logo_agreement_jz)
+    card = comment.card
+
+    assert_turbo_stream_broadcasts(card, count: 1) do
+      reaction = comment.reactions.create!(content: "🎉")
+      assert_equal users(:david), reaction.reacter
+    end
+
+    reaction = comment.reactions.last
+    assert_turbo_stream_broadcasts(card, count: 1) do
+      reaction.destroy!
+    end
+  end
+
+  test "destroying comment cleans up reactions without error" do
+    comment = comments(:logo_agreement_jz)
+    assert comment.reactions.any?
+
+    assert_nothing_raised do
+      comment.destroy!
+    end
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
