diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..ebde1e1
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,30 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { reactable.account }
+  belongs_to :reactable, polymorphic: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  normalizes :content, with: ->(content) { content.strip }
+
+  after_commit :broadcast_refresh, on: %i[ create destroy ]
+
+  delegate :card, :publicly_accessible?, :accessible_to?, to: :reactable
+
+  def all_emoji?
+    content.all_emoji?
+  end
+
+  def to_partial_path
+    "cards/comments/reactions/reaction"
+  end
+
+  private
+    def broadcast_refresh
+      if reactable.present? && !reactable.destroyed? && card.present? && !card.destroyed? && !card.suppressed_turbo_broadcasts?
+        Turbo::StreamsChannel.broadcast_refresh_to(card, request_id: Turbo.current_request_id)
+      end
+    end
+end
