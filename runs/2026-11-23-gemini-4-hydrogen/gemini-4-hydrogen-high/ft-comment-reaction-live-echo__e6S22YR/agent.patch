+<div id="<%= dom_id(comment, :new_reaction) %>"
+     data-controller="reaction-form">
+  <button type="button"
+          class="reactions__trigger btn btn--circle"
+          data-controller="tooltip"
+          data-reaction-form-target="trigger"
+          data-action="click->reaction-form#open">
+    <%= image_tag "boost-color.svg", aria: { hidden: true }, alt: "" %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <template data-reaction-form-target="template">
+    <div class="reaction reaction__form expanded" data-reaction-form-target="container">
+      <div class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+        <button type="button"
+                class="btn btn--circle borderless reaction__menu-btn"
+                data-action="click->dialog#open:stop"
+                aria-label="Pick an emoji">
+          <%= icon_tag "reaction" %>
+        </button>
+
+        <dialog class="reaction__popup popup popup--align-right panel fill-white shadow" data-dialog-target="dialog">
+          <div class="reaction__emoji-list">
+            <% EmojiHelper::REACTIONS.each do |emoji, title| %>
+              <button type="button"
+                      class="btn btn--plain"
+                      title="<%= title %>"
+                      data-action="click->reaction-form#pickEmoji click->dialog#close"
+                      data-emoji="<%= emoji %>">
+                <%= emoji %>
+              </button>
+            <% end %>
+          </div>
+        </dialog>
+      </div>
+
+      <%= form_with model: Reaction.new,
+            url: card_comment_reactions_path(comment.card, comment),
+            class: "flex align-center gap-half",
+            data: {
+              controller: "form",
+              reaction_form_target: "form",
+              action: "submit->form#preventEmptySubmit submit->form#preventComposingSubmit turbo:submit-start->reaction-form#submitting turbo:submit-end->reaction-form#submitted keydown.esc->reaction-form#close:stop"
+            } do |form| %>
+        <label class="reaction__form-label flex align-center">
+          <%= form.text_field :content,
+                class: "input reaction__input txt-small",
+                maxlength: 16,
+                required: true,
+                autocomplete: "off",
+                placeholder: "React…",
+                aria: { label: "Reaction" },
+                data: {
+                  form_target: "input",
+                  reaction_form_target: "input",
+                  action: "input->reaction-form#resize"
+                } %>
+        </label>
+
+        <%= form.button type: :submit,
+              class: "btn btn--circle borderless reaction__submit-btn",
+              aria: { label: "Confirm reaction" } do %>
+          <%= icon_tag "check-circle" %>
+          <span class="for-screen-reader">Confirm</span>
+        <% end %>
+
+        <button type="button"
+                class="btn btn--circle borderless reaction__cancel-btn"
+                data-action="click->reaction-form#close"
+                aria-label="Cancel reaction">
+          <%= icon_tag "close-circle" %>
+          <span class="for-screen-reader">Cancel</span>
+        </button>
+      <% end %>
+    </div>
+  </template>
