+    end
+
+    assert_response :forbidden
+  end
+
+  test "cannot access reactions on inaccessible card" do
+    private_board = boards(:private)
+    private_card, private_comment = Current.set(account: private_board.account, user: users(:kevin)) do
+      card = private_board.cards.create!(title: "Secret", status: :published, creator: users(:kevin))
+      [ card, card.comments.create!(creator: users(:kevin), body: "Secret comment") ]
+    end
+    logout_and_sign_in_as :david
+
+    post card_comment_reactions_path(private_card, private_comment), params: { reaction: { content: "👍" } }, as: :json
+
+    assert_response :not_found
+  end
+
+  test "destroy own reaction via turbo_stream" do
+    reaction = reactions(:kevin_thumbs_up)
+    comment = reaction.reactable
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy own reaction as JSON" do
+    reaction = reactions(:kevin_thumbs_up)
+    comment = reaction.reactable
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "cannot destroy another user's reaction" do
+    reaction = reactions(:david_clap)
+    comment = reaction.reactable
+
+    assert_no_difference -> { comment.reactions.count } do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+    assert Reaction.exists?(reaction.id)
+  end
+end
