+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    comment = comments(:logo_agreement_jz)
+
+    get card_comment_reactions_path(comment.card, comment), as: :json
+
+    assert_response :success
+    assert_equal comment.reactions.count, @response.parsed_body.count
+    assert_equal reactions(:kevin_thumbs_up).id, @response.parsed_body.first["id"]
+    assert_equal "👍", @response.parsed_body.first["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.first.dig("reacter", "id")
+  end
+
+  test "show as JSON" do
+    reaction = reactions(:kevin_thumbs_up)
+    comment = reaction.reactable
+
+    get card_comment_reaction_path(comment.card, comment, reaction), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal "👍", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+  end
+
+  test "create via turbo_stream" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "Nice!" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal "Nice!", Reaction.last.content
+    assert_equal users(:kevin), Reaction.last.reacter
+  end
+
+  test "create as JSON" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal card_comment_reaction_path(comment.card, comment, Reaction.last, format: :json), @response.headers["Location"]
+    assert_equal "Great 👍", @response.parsed_body["content"]
+  end
+
+  test "create as JSON with flat params" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment), params: { content: "🎉" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "🎉", @response.parsed_body["content"]
+  end
+
+  test "create rejects content longer than 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "a" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create rejects blank content" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "   " } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create on draft card is forbidden" do
+    draft_card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+    draft_card.update!(status: :drafted)
+
+    assert_no_difference -> { comment.reactions.count } do
