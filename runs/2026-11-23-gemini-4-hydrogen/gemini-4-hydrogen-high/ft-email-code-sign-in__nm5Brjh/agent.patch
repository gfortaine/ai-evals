diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..01e35dc
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,58 @@
+class MagicLink < ApplicationRecord
+  CODE_ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ".chars.freeze
+  CODE_LENGTH = 6
+  EXPIRATION_TIME = 15.minutes
+
+  belongs_to :identity
+
+  enum :purpose, %w[ sign_in sign_up ].index_by(&:itself), prefix: :for, default: :sign_in
+
+  scope :active, -> { where("expires_at > ?", Time.current) }
+  scope :stale, -> { where(expires_at: ..Time.current) }
+
+  before_validation :generate_code, on: :create, if: -> { code.blank? }
+  before_validation :set_expiration, on: :create, if: -> { expires_at.blank? }
+
+  validates :code, presence: true, uniqueness: true
+
+  class << self
+    def consume(code)
+      active.find_by(code: sanitize(code))&.consume
+    end
+
+    def cleanup
+      stale.delete_all
+    end
+
+    def sanitize(code)
+      code.to_s.upcase.gsub(/[^A-Z0-9]/, "")
+    end
+  end
+
+  def consume
+    with_lock do
+      unless destroyed? || expired?
+        destroy!
+        self
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    nil
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  private
+    def generate_code
+      self.code = loop do
+        candidate = Array.new(CODE_LENGTH) { CODE_ALPHABET[SecureRandom.random_number(CODE_ALPHABET.length)] }.join
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+
+    def set_expiration
+      self.expires_at = EXPIRATION_TIME.from_now
+    end
+end
