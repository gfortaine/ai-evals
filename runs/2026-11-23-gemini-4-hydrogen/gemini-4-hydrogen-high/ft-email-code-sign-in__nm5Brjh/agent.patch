+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "show requires pending_authentication_token" do
+    untenanted do
+      get session_magic_link_path
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "show renders code form posting as code" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      assert_redirected_to session_magic_link_path
+
+      get session_magic_link_path
+      assert_response :success
+      assert_select "form[action=?]", session_magic_link_path do
+        assert_select "input[name='code']"
+      end
+    end
+  end
+
+  test "create signs in user with valid code and consumes magic link" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      magic_link = @identity.magic_links.last
+      assert_not_nil magic_link
+
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+      assert_not MagicLink.exists?(magic_link.id)
+    end
+  end
+
+  test "create accepts lowercase and spaced code" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      magic_link = @identity.magic_links.last
+
+      post session_magic_link_path, params: { code: " #{magic_link.code.downcase.insert(3, ' ')} " }
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create rejects invalid code and allows retry" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      magic_link = @identity.magic_links.last
+
+      post session_magic_link_path, params: { code: "WRONG1" }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+      assert cookies[:pending_authentication_token].present?
+      assert MagicLink.exists?(magic_link.id)
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+    end
+  end
+
+  test "create rejects expired code after 15 minutes" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      magic_link = @identity.magic_links.last
+
+      travel 15.minutes + 1.second do
+        post session_magic_link_path, params: { code: magic_link.code }
+
+        assert_redirected_to new_session_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create rejects expired magic link even if cookie is still valid" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      magic_link = @identity.magic_links.last
+      magic_link.update!(expires_at: 1.minute.ago)
+
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create cannot use another identity's code" do
+    other_magic_link = MagicLink.create!(identity: identities(:david))
+
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+
+      post session_magic_link_path, params: { code: other_magic_link.code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+      assert MagicLink.exists?(other_magic_link.id)
+    end
+  end
+
+  test "create via JSON" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: @identity.email_address }
+      assert_response :created
+      assert @response.parsed_body["pending_authentication_token"].present?
+
+      magic_link = @identity.magic_links.last
+      post session_magic_link_path(format: :json), params: { code: magic_link.code }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "create via JSON with invalid code returns unauthorized" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: @identity.email_address }
+
+      post session_magic_link_path(format: :json), params: { code: "NOPE00" }
+
+      assert_response :unauthorized
+      assert @response.parsed_body["message"].present?
+    end
+  end
+
+  test "create via JSON without pending_authentication_token returns unauthorized" do
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "ABC123" }
+
+      assert_response :unauthorized
+      assert @response.parsed_body["message"].present?
+    end
+  end
+
+  test "create is rate limited" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+
+      Rails.cache.stubs(:increment).returns(11)
+      post session_magic_link_path, params: { code: "ABC123" }
+
+      assert_redirected_to session_magic_link_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+
+test "create redirects back to protected URL after signing in" do
+  protected_url = board_url(boards(:writebook), script_name: accounts("37s").slug)
+  get protected_url
+  assert_redirected_to new_session_path(script_name: nil)
+
+  untenanted do
+    post session_path(script_name: nil), params: { email_address: @identity.email_address }
+    magic_link = @identity.magic_links.last
+
+    post session_magic_link_path(script_name: nil), params: { code: magic_link.code }
+    assert_redirected_to protected_url
+  end
+end
+end
