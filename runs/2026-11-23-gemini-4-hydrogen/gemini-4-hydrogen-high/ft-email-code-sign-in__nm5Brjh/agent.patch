--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,95 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+  before_action :ensure_that_email_address_pending_authentication_is_present
+
+  layout "public"
+
+  def show
+  end
+
+    def create
+    if magic_link = find_and_consume_magic_link
+      authenticate(magic_link)
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def ensure_that_email_address_pending_authentication_is_present
+      unless email_address_pending_authentication.present?
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Enter your email address to sign in." }
+          format.json { render json: { message: "Invalid or expired authentication token." }, status: :unauthorized }
+        end
+      end
+    end
+
+    def find_and_consume_magic_link
+      if identity = Identity.find_by(email_address: email_address_pending_authentication)
+        identity.magic_links.consume(code)
+      end
+    end
+
+    def code
+      params[:code]
+    end
+
+    def authenticate(magic_link)
+      clear_pending_authentication_token
+      terminate_session if Current.session
+      start_new_session_for magic_link.identity
+
+      respond_to do |format|
+        format.html { redirect_to after_magic_link_authentication_url(magic_link) }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def after_magic_link_authentication_url(magic_link)
+      if join_code_id = session.delete(:pending_join_code_id)
+        redeem_join_code(join_code_id, magic_link.identity)
+      elsif magic_link.for_sign_up?
+        new_signup_completion_path
+      else
+        after_authentication_url
+      end
+    end
+
+    def redeem_join_code(join_code_id, identity)
+      if join_code = Account::JoinCode.find_by(id: join_code_id)
+        if join_code.active?
+          join_code.redeem_if { |account| identity.join(account) }
+          user = User.active.find_by!(account: join_code.account, identity: identity)
+
+          if user.setup?
+            landing_url(script_name: join_code.account.slug)
+          else
+            new_users_verification_url(script_name: join_code.account.slug)
+          end
+        else
+          join_url(code: join_code.code, script_name: join_code.account.slug)
+        end
+      else
+        after_authentication_url
+      end
+    end
+
+    def invalid_code
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
