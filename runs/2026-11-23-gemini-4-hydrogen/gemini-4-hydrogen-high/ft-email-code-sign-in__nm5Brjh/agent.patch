diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..c41bbbe
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "generates a 6-character uppercase alphanumeric code and 15-minute expiration on create" do
+    freeze_time do
+      magic_link = MagicLink.create!(identity: identities(:kevin))
+
+      assert_match /\A[A-Z0-9]{6}\z/, magic_link.code
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert magic_link.for_sign_in?
+    end
+  end
+
+  test "active and stale scopes" do
+    active_link = MagicLink.create!(identity: identities(:kevin))
+    expired_link = MagicLink.create!(identity: identities(:david), expires_at: 1.minute.ago)
+
+    assert_includes MagicLink.active, active_link
+    assert_not_includes MagicLink.active, expired_link
+
+    assert_includes MagicLink.stale, expired_link
+    assert_not_includes MagicLink.stale, active_link
+
+    travel 15.minutes + 1.second do
+      assert_not_includes MagicLink.active, active_link
+      assert_includes MagicLink.stale, active_link
+    end
+  end
+
+  test "consume finds active link, sanitizes code, and destroys it" do
+    identity = identities(:kevin)
+    magic_link = MagicLink.create!(identity: identity)
+
+    consumed = identity.magic_links.consume("  #{magic_link.code.downcase.insert(3, '-')}  ")
+    assert_equal magic_link, consumed
+    assert_not MagicLink.exists?(magic_link.id)
+
+    assert_nil identity.magic_links.consume(magic_link.code)
+  end
+
+  test "consume returns nil for expired code" do
+    identity = identities(:kevin)
+    magic_link = MagicLink.create!(identity: identity)
+
+    travel 15.minutes + 1.second do
+      assert_nil identity.magic_links.consume(magic_link.code)
+      assert MagicLink.exists?(magic_link.id)
+    end
+  end
+
+  test "consume scoped to identity does not consume another identity's code" do
+    kevins_link = MagicLink.create!(identity: identities(:kevin))
+
+    assert_nil identities(:david).magic_links.consume(kevins_link.code)
+    assert MagicLink.exists?(kevins_link.id)
+  end
+
+  test "cleanup removes stale magic links and preserves active ones" do
+    active_link = MagicLink.create!(identity: identities(:kevin))
+    stale_link = MagicLink.create!(identity: identities(:david), expires_at: 1.second.ago)
+
+    MagicLink.cleanup
+
+    assert MagicLink.exists?(active_link.id)
+    assert_not MagicLink.exists?(stale_link.id)
+  end
+end
