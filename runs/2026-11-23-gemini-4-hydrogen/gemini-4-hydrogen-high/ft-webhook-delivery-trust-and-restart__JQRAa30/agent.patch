+    assert_equal event.created_at.utc.iso8601, delivery.request.dig("headers", "X-Webhook-Timestamp")
+
+    expected_signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, captured_body)
+    assert_equal expected_signature, captured_headers["X-Webhook-Signature"]
+
+    parsed_body = JSON.parse(captured_body)
+    assert_equal event.id, parsed_body["id"]
+    assert_equal "card_published", parsed_body["action"]
+    assert_equal cards(:logo).id, parsed_body.dig("eventable", "id")
+    assert_equal boards(:writebook).id, parsed_body.dig("board", "id")
+    assert_equal users(:david).id, parsed_body.dig("creator", "id")
+  end
+
+  test "deliver records non-2xx responses as completed and failed" do
+    webhook = webhooks(:active)
+    event = events(:logo_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub_request(:post, webhook.url).to_return(status: 422, body: "unprocessable")
+
+    delivery.deliver
+    delivery.reload
+
+    assert delivery.completed?
+    assert delivery.failed?
+    assert_not delivery.succeeded?
+    assert_equal 422, delivery.response[:code]
+  end
+
+  test "deliver records network errors as errored" do
+    webhook = webhooks(:active)
+    event = events(:logo_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub_request(:post, webhook.url).to_timeout
+
+    delivery.deliver
+    delivery.reload
+
+    assert delivery.errored?
+    assert delivery.failed?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "deliver executes exactly once even if called multiple times" do
+    webhook = webhooks(:active)
+    event = events(:logo_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    request_stub = stub_request(:post, webhook.url).to_return(status: 500)
+
+    delivery.deliver
+    delivery.deliver
+    Webhook::Delivery.find(delivery.id).deliver
+
+    assert_requested request_stub, times: 1
+    assert_equal 1, webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "deliver skips already in_progress delivery" do
+    webhook = webhooks(:active)
+    delivery = webhook_deliveries(:in_progress)
+
+    request_stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    delivery.deliver
+
+    assert_not_requested request_stub
+    assert delivery.reload.in_progress?
+  end
+
+  test "deliver skips inactive webhook" do
+    webhook = webhooks(:inactive)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:logo_published))
+
+    request_stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    delivery.deliver
+
+    assert_not_requested request_stub
+    assert delivery.reload.pending?
+  end
+
+  test "deliver formats payload for Slack" do
+    webhook = Webhook.create!(
+      name: "Slack",
+      url: "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx", # gitleaks:allow
+      board: boards(:writebook),
+      subscribed_actions: %w[ card_published ]
+    )
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:logo_published))
+
+    captured_body = nil
+    captured_content_type = nil
+    stub_request(:post, webhook.url).to_return do |request|
+      captured_body = request.body
+      captured_content_type = request.headers["Content-Type"]
