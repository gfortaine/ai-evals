diff --git a/test/integration/webhooks_test.rb b/test/integration/webhooks_test.rb
new file mode 100644
index 0000000..1635ae3
--- /dev/null
+++ b/test/integration/webhooks_test.rb
@@ -0,0 +1,135 @@
+require "test_helper"
+
+class WebhooksIntegrationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "board event delivers POST to subscribed active webhook and logs outcome" do
+    board = boards(:writebook)
+    webhook = Webhook.create!(
+      name: "Integration Receiver",
+      url: "https://receiver.example.com/hook",
+      board: board,
+      subscribed_actions: %w[ card_published comment_created ]
+    )
+
+    stub_request(:post, webhooks(:active).url).to_return(status: 200)
+    receiver_stub = stub_request(:post, webhook.url).to_return(status: 201)
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      Current.set(user: users(:kevin)) do
+        board.cards.create!(title: "New Webhook Card", status: :published, creator: users(:kevin))
+      end
+    end
+
+    assert_requested receiver_stub, times: 1
+
+    delivery = webhook.deliveries.last
+    assert_not_nil delivery
+    assert delivery.completed?
+    assert delivery.succeeded?
+    assert_equal 201, delivery.response[:code]
+
+    get board_webhook_path(board, webhook)
+    assert_response :success
+    assert_includes @response.body, "completed"
+    assert_includes @response.body, "201"
+    assert_includes @response.body, "Card added"
+
+    get board_webhook_deliveries_path(board, webhook), as: :json
+    assert_response :success
+    logged = @response.parsed_body.find { |record| record["id"] == delivery.id }
+    assert_equal "completed", logged["state"]
+    assert_equal 201, logged.dig("response", "code")
+    assert_equal "card_published", logged.dig("event", "action")
+  end
+
+  test "unsubscribed events and other boards do not trigger webhook" do
+    other_board_webhook = Webhook.create!(
+      name: "Private Board Hook",
+      url: "https://other.example.com/hook",
+      board: boards(:private),
+      subscribed_actions: %w[ card_published ]
+    )
+    unsubscribed_webhook = Webhook.create!(
+      name: "Comment Only Hook",
+      url: "https://comments.example.com/hook",
+      board: boards(:writebook),
+      subscribed_actions: %w[ comment_created ]
+    )
+
+    stub_request(:post, webhooks(:active).url).to_return(status: 200)
+    other_stub = stub_request(:post, other_board_webhook.url).to_return(status: 200)
+    unsubscribed_stub = stub_request(:post, unsubscribed_webhook.url).to_return(status: 200)
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      Current.set(user: users(:kevin)) do
+        boards(:writebook).cards.create!(title: "Published Only", status: :published, creator: users(:kevin))
+      end
+    end
+
+    assert_not_requested other_stub
+    assert_not_requested unsubscribed_stub
+  end
+
+  test "failing webhook switches off after 10 failures over an hour and can be reactivated" do
+    board = boards(:writebook)
+    webhook = Webhook.create!(
+      name: "Failing Receiver",
+      url: "https://failing.example.com/hook",
+      board: board,
+      subscribed_actions: %w[ card_published ]
+    )
+
+    stub_request(:post, webhooks(:active).url).to_return(status: 200)
+    failing_stub = stub_request(:post, webhook.url).to_return(status: 500)
+
+    start_time = 2.hours.ago.change(usec: 0)
+
+    travel_to start_time do
+      9.times do |i|
+        perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+          Current.set(user: users(:kevin)) do
+            board.cards.create!(title: "Fail #{i}", status: :published, creator: users(:kevin))
+          end
+        end
+      end
+      assert webhook.reload.active?
+    end
+
+    travel_to start_time + 61.minutes do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        Current.set(user: users(:kevin)) do
+          board.cards.create!(title: "Fail 10", status: :published, creator: users(:kevin))
+        end
+      end
+
+      assert_not webhook.reload.active?
+
+      # Subsequent event does not deliver while switched off
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        Current.set(user: users(:kevin)) do
+          board.cards.create!(title: "After Deactivation", status: :published, creator: users(:kevin))
+        end
+      end
+
+      assert_requested failing_stub, times: 10
+    end
+
+    # Admin reactivates and webhook resumes working cleanly
+    post board_webhook_activation_path(board, webhook)
+    assert_redirected_to board_webhook_path(board, webhook)
+    assert webhook.reload.active?
+
+    stub_request(:post, webhook.url).to_return(status: 200)
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      Current.set(user: users(:kevin)) do
+        board.cards.create!(title: "Recovered", status: :published, creator: users(:kevin))
+      end
+    end
+
+    assert webhook.deliveries.ordered.first.succeeded?
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..fa68cc5
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,120 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = Webhook.create!(
+      name: "Tracker Test",
+      url: "https://example.com/webhook",
+      board: boards(:writebook),
+      subscribed_actions: %w[ card_published ]
+    )
+    @tracker = @webhook.delinquency_tracker
+    @event = events(:logo_published)
+  end
+
+  test "deactivates webhook after 10 consecutive failures over an hour" do
+    first_time = Time.current.change(usec: 0)
+
+    travel_to first_time do
+      9.times do
+        @tracker.record_delivery_of(failed_delivery)
+        assert @webhook.reload.active?
+      end
+
+      assert_equal 9, @tracker.reload.consecutive_failures_count
+      assert_equal first_time, @tracker.first_failure_at
+    end
+
+    # 10th failure before 1 hour has elapsed should not deactivate yet
+    travel_to first_time + 59.minutes do
+      @tracker.record_delivery_of(failed_delivery)
+      assert @webhook.reload.active?
+      assert_equal 10, @tracker.reload.consecutive_failures_count
+    end
+
+    # Next failure after 1 hour has elapsed deactivates the webhook
+    travel_to first_time + 61.minutes do
+      @tracker.record_delivery_of(failed_delivery)
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "deactivates on 10th failure when 10th failure is at least 1 hour after first failure" do
+    first_time = Time.current.change(usec: 0)
+
+    travel_to first_time do
+      @tracker.record_delivery_of(failed_delivery)
+    end
+
+    travel_to first_time + 30.minutes do
+      8.times { @tracker.record_delivery_of(failed_delivery) }
+      assert @webhook.reload.active?
+    end
+
+    travel_to first_time + 1.hour do
+      @tracker.record_delivery_of(failed_delivery)
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "does not deactivate with fewer than 10 failures even over an hour" do
+    first_time = Time.current.change(usec: 0)
+
+    travel_to first_time do
+      5.times { @tracker.record_delivery_of(failed_delivery) }
+    end
+
+    travel_to first_time + 2.hours do
+      4.times { @tracker.record_delivery_of(failed_delivery) }
+      assert @webhook.reload.active?
+      assert_equal 9, @tracker.reload.consecutive_failures_count
+    end
+  end
+
+  test "resets streak on a successful delivery" do
+    first_time = Time.current.change(usec: 0)
+
+    travel_to first_time do
+      9.times { @tracker.record_delivery_of(failed_delivery) }
+      assert_equal 9, @tracker.reload.consecutive_failures_count
+    end
+
+    travel_to first_time + 2.hours do
+      @tracker.record_delivery_of(succeeded_delivery)
+      assert_equal 0, @tracker.reload.consecutive_failures_count
+      assert_nil @tracker.first_failure_at
+      assert @webhook.reload.active?
+
+      @tracker.record_delivery_of(failed_delivery)
+      assert @webhook.reload.active?
+      assert_equal 1, @tracker.reload.consecutive_failures_count
+    end
+  end
+
+  test "counts errored deliveries as failures" do
+    first_time = Time.current.change(usec: 0)
+
+    travel_to first_time do
+      @tracker.record_delivery_of(errored_delivery)
+      assert_equal 1, @tracker.reload.consecutive_failures_count
+    end
+
+    travel_to first_time + 1.hour do
+      9.times { @tracker.record_delivery_of(errored_delivery) }
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  private
+    def failed_delivery
+      Webhook::Delivery.new(webhook: @webhook, event: @event, state: :completed, response: { code: 500 })
+    end
+
+    def errored_delivery
+      Webhook::Delivery.new(webhook: @webhook, event: @event, state: :errored, response: { error: :destination_unreachable })
+    end
+
+    def succeeded_delivery
+      Webhook::Delivery.new(webhook: @webhook, event: @event, state: :completed, response: { code: 200 })
+    end
+end
