+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self) if board.webhooks.active.exists?
+  end
+
+  def relay_now
+    Current.with_account(account) do
+      board.webhooks.active.each do |webhook|
+        webhook.trigger(self)
+      end
+    end
+  end
+end
