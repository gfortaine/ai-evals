@@ -1,4 +1,26 @@
+require "net/http"
+
 class Webhook::Delivery < ApplicationRecord
+  STALE_AFTER = 1.week
+  HTTP_TIMEOUT = 5.seconds
+
+  HTTP_ERRORS = [
+    SocketError,
+    Timeout::Error,
+    Net::OpenTimeout,
+    Net::ReadTimeout,
+    Net::WriteTimeout,
+    OpenSSL::SSL::SSLError,
+    SystemCallError,
+    IOError,
+    EOFError,
+    Net::HTTPBadResponse,
+    Net::HTTPHeaderSyntaxError,
+    Net::ProtocolError,
+    Net::HTTPError,
+    URI::InvalidURIError
+  ].freeze
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +31,15 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where(created_at: ...STALE_AFTER.ago) }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def cleanup
+      stale.delete_all
+    end
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +60,127 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver
+    return unless webhook.active?
+    return unless claim_for_delivery
+
+    Current.with_account(account) do
+      perform_delivery
+    end
+
+    webhook.record_delivery_outcome(self)
+  end
+
+  private
+    def claim_for_delivery
+      if pending? && self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+        reload
+        true
+      else
+        false
+      end
+    end
+
+    def perform_delivery
+      body, content_type = build_payload
+      headers = build_headers(body, content_type)
+
+      begin
+        http_response = send_http_request(body, headers)
+        update!(state: :completed, request: { headers: headers }, response: { code: http_response.code.to_i })
+      rescue *HTTP_ERRORS
+        update!(state: :errored, request: { headers: headers }, response: { error: :destination_unreachable })
+      end
+    end
+
+    def build_payload
+      if webhook.for_slack?
+        [ slack_payload, "application/json" ]
+      elsif webhook.for_basecamp?
+        [ basecamp_payload, "application/json" ]
+      elsif webhook.for_campfire?
+        [ html_payload, "text/html" ]
+      else
+        [ json_payload, "application/json" ]
+      end
+    end
+
+    def slack_payload
+      text = CGI.unescapeHTML(event.description_for(nil).to_plain_text.to_s)
+      if event.eventable
+        url = Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options)
+        text = "#{text} <#{url}|↗︎>"
+      end
+
+      { text: text }.to_json
+    end
+
+    def basecamp_payload
+      { content: html_payload }.to_json
+    end
+
+    def html_payload
+      render_event(formats: :html, layout: false).strip
+    end
+
+    def json_payload
+      render_event(formats: :json)
+    end
+
+    def render_event(**options)
+      Current.set(user: nil) do
+        renderer.render(template: "webhooks/event", assigns: { event: event }, **options)
+      end
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(
+        script_name: account.slug,
+        http_host: url_options_host,
+        https: url_options[:protocol] == "https"
+      )
+    end
+
+    def url_options_host
+      host = url_options[:host] || "example.com"
+      url_options[:port] ? "#{host}:#{url_options[:port]}" : host
+    end
+
+    def url_options
+      @url_options ||= begin
+        base_options = Rails.application.routes.default_url_options.presence ||
+          Rails.application.config.action_mailer.default_url_options ||
+          { host: "example.com" }
+        base_options.merge(script_name: account.slug)
+      end
+    end
+
+    def build_headers(body, content_type)
+      {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => content_type,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+    end
+
+    def send_http_request(body, headers)
+      uri = URI.parse(webhook.url)
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = HTTP_TIMEOUT
+      http.read_timeout = HTTP_TIMEOUT
+      http.write_timeout = HTTP_TIMEOUT if http.respond_to?(:write_timeout=)
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      http.request(request)
+    end
 end
