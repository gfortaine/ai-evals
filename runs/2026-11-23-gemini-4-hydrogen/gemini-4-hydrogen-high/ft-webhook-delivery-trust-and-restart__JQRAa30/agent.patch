+    end
+
+    delivery.deliver
+
+    assert_equal "application/json", captured_content_type
+    payload = JSON.parse(captured_body)
+    assert_includes payload["text"], "David added \"The logo isn't big enough\""
+    assert_includes payload["text"], "/cards/#{cards(:logo).number}|↗︎>"
+  end
+
+  test "deliver formats payload for Basecamp" do
+    webhook = Webhook.create!(
+      name: "Basecamp",
+      url: "https://3.basecamp.com/999/integrations/some-token/buckets/111/chats/222/lines",
+      board: boards(:writebook),
+      subscribed_actions: %w[ card_published ]
+    )
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event = events(:logo_published))
+
+    captured_body = nil
+    captured_content_type = nil
+    stub_request(:post, webhook.url).to_return do |request|
+      captured_body = request.body
+      captured_content_type = request.headers["Content-Type"]
+      { status: 201 }
+    end
+
+    delivery.deliver
+
+    assert_equal "application/json", captured_content_type
+    payload = JSON.parse(captured_body)
+    assert_includes payload["content"], "David added &quot;The logo isn&#39;t big enough&quot;"
+    assert_includes payload["content"], "/cards/#{cards(:logo).number}"
+  end
+
+  test "deliver formats payload for Campfire" do
+    webhook = Webhook.create!(
+      name: "Campfire",
+      url: "https://chat.example.com/rooms/123/456-room/messages",
+      board: boards(:writebook),
+      subscribed_actions: %w[ card_published ]
+    )
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:logo_published))
