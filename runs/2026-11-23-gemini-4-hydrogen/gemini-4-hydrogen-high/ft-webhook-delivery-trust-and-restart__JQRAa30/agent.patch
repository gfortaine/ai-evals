+      captured_content_type = request.headers["Content-Type"]
+      { status: 201 }
+    end
+
+    delivery.deliver
+
+    assert_equal "text/html", captured_content_type
+    assert_includes captured_body, "David added &quot;The logo isn&#39;t big enough&quot;"
+    assert_includes captured_body, "/cards/#{cards(:logo).number}"
+  end
+
+  test "cleanup removes deliveries older than one week and keeps newer ones" do
+    old_delivery = webhook_deliveries(:successfully_completed)
+    old_errored = webhook_deliveries(:errored)
+    recent_delivery = webhook_deliveries(:unsuccessfully_completed)
+    pending_delivery = webhook_deliveries(:pending)
+
+    old_delivery.update_columns(created_at: 8.days.ago)
+    old_errored.update_columns(created_at: 1.week.ago - 1.minute)
+    recent_delivery.update_columns(created_at: 1.week.ago + 1.hour)
+    pending_delivery.update_columns(created_at: 2.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert_not Webhook::Delivery.exists?(old_errored.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+    assert Webhook::Delivery.exists?(pending_delivery.id)
+  end
