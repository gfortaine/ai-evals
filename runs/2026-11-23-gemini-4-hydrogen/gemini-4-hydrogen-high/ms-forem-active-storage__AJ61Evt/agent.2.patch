@@ -0,0 +1,10 @@
+namespace :profile_images do
+  desc "Copy existing CarrierWave user and organization profile images into Active Storage"
+  task copy: :environment do
+    summary = Images::CopyProfileImages.call
+    users = summary[:users]
+    organizations = summary[:organizations]
+    puts "Copied #{users[:copied]} user profile images (skipped #{users[:skipped]})"
+    puts "Copied #{organizations[:copied]} organization profile images (skipped #{organizations[:skipped]})"
+  end
+end
