+require "rails_helper"
+require "rake"
+
+RSpec.describe "profile_images:copy", type: :task do
+  let(:task) { Rake::Task["profile_images:copy"] }
+
+  before do
+    Rails.application.load_tasks unless Rake::Task.task_defined?("profile_images:copy")
+  end
+
+  after do
+    task.reenable
+    FileUtils.rm_rf(Rails.public_path.join("uploads/user"))
+    FileUtils.rm_rf(Rails.public_path.join("uploads/organization"))
+  end
+
+  it "copies legacy CarrierWave profile images into Active Storage" do
+    jpg_bytes = Rails.root.join("spec/fixtures/files/800x600.jpg").binread
+    user = create(:user, profile_image: nil)
+    uploader = ProfileImageUploader.new(user, :profile_image)
+    path = Rails.public_path.join(uploader.store_dir, "rake-avatar.jpg")
+    FileUtils.mkdir_p(path.dirname)
+    File.binwrite(path, jpg_bytes)
+    user.update_columns(profile_image: "rake-avatar.jpg")
+
+    expect { task.invoke }.to output(/Copied 1 user profile images/).to_stdout
+
+    expect(user.reload.profile_image).to be_attached
+    expect(user.profile_image.download).to eq(jpg_bytes)
+    expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/redirect/")
+  end
+end
