+class AddTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    reversible do |dir|
+      dir.up do
+        tenant_class = Class.new(ActiveRecord::Base) { self.table_name = "tenants" }
+        user_class = Class.new(ActiveRecord::Base) { self.table_name = "users" }
+        book_class = Class.new(ActiveRecord::Base) { self.table_name = "books" }
+        account_class = Class.new(ActiveRecord::Base) { self.table_name = "accounts" }
+
+        if user_class.exists? || book_class.exists?
+          tenant = tenant_class.create!(name: account_class.first&.name || "Default")
+          user_class.update_all(tenant_id: tenant.id)
+          book_class.update_all(tenant_id: tenant.id)
+        end
+      end
+    end
+  end
+end
