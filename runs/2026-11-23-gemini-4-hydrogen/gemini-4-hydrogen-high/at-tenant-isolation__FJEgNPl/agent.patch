diff --git a/test/integration/tenancy_test.rb b/test/integration/tenancy_test.rb
new file mode 100644
index 0000000..6b54d26
--- /dev/null
+++ b/test/integration/tenancy_test.rb
@@ -0,0 +1,224 @@
+require "test_helper"
+
+class TenancyTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+
+    @alice = User.create!(name: "Alice A", email_address: "alice@a.example.com", password: "secret123456", role: :member, tenant: @tenant_a)
+    @admin_a = User.create!(name: "Admin A", email_address: "admin@a.example.com", password: "secret123456", role: :administrator, tenant: @tenant_a)
+    @bob = User.create!(name: "Bob B", email_address: "bob@b.example.com", password: "secret123456", role: :member, tenant: @tenant_b)
+
+    @book_a = Book.create!(title: "Alpha Book", everyone_access: true, tenant: @tenant_a)
+    @book_a.update_access(editors: [ @alice.id ], readers: [])
+    @leaf_a = @book_a.press(Page.new(body: "Alpha v1"), title: "Alpha Page")
+    @leaf_a.edit(leafable_params: { body: "Alpha v2" })
+
+    @book_b_private = Book.create!(title: "Beta Private", everyone_access: false, published: false, tenant: @tenant_b)
+    @book_b_private.update_access(editors: [ @bob.id ], readers: [])
+    @leaf_b_private = @book_b_private.press(Page.new(body: "Beta secret v1"), title: "Beta Private Page")
+    @leaf_b_private.edit(leafable_params: { body: "Beta secret v2" })
+
+    @book_b_published = Book.create!(title: "Beta Published", everyone_access: true, published: true, tenant: @tenant_b)
+    @book_b_published.update_access(editors: [ @bob.id ], readers: [])
+    @leaf_b_published = @book_b_published.press(Page.new(body: "Beta public v1"), title: "Beta Public Page")
+    @leaf_b_published.edit(leafable_params: { body: "Beta public v2" })
+
+    # Simulate legacy cross-tenant access row from pre-tenant sharing with everyone
+    Access.create!(user: @alice, book: @book_b_private, level: :reader)
+    Access.create!(user: @alice, book: @book_b_published, level: :editor)
+    Access.create!(user: @admin_a, book: @book_b_private, level: :reader)
+  end
+
+  test "new books land in their creator's tenant and sharing with everyone stays within the tenant" do
+    sign_in @alice
+
+    assert_difference -> { Book.count }, 1 do
+      post books_path, params: { book: { title: "Alice New Book", everyone_access: true } }
+    end
+
+    book = Book.order(:id).last
+    assert_equal @tenant_a, book.tenant
+
+    access_user_ids = book.accesses.pluck(:user_id)
+    assert_includes access_user_ids, @alice.id
+    assert_includes access_user_ids, @admin_a.id
+    assert_not_includes access_user_ids, @bob.id
+    assert_not_includes access_user_ids, users(:kevin).id
+  end
+
+  test "new user only gets reader access to everyone books in their own tenant" do
+    carol = User.create!(name: "Carol A", email_address: "carol@a.example.com", password: "secret123456", tenant: @tenant_a)
+
+    assert @book_a.accessable?(user: carol)
+    assert_not @book_b_published.accessable?(user: carol)
+    assert_not_includes carol.books, @book_b_published
+  end
+
+  test "book form and update_access ignore users from other tenants" do
+    sign_in @alice
+
+    get new_book_path
+    assert_response :success
+    assert_in_body @admin_a.name
+    assert_not_in_body @bob.name
+
+    get edit_book_path(@book_a)
+    assert_response :success
+    assert_in_body @admin_a.name
+    assert_not_in_body @bob.name
+
+    patch book_path(@book_a), params: {
+      book: { title: "Alpha Book", everyone_access: false },
+      editor_ids: [ @bob.id ],
+      reader_ids: [ @bob.id ]
+    }
+    assert_redirected_to book_slug_path(@book_a)
+    assert_not @book_a.accesses.exists?(user: @bob)
+  end
+
+  test "another tenant's books are absent from the library, published or not, even with an access row" do
+    sign_in @alice
+
+    get root_path
+    assert_response :success
+    assert_select "h2", text: "Alpha Book"
+    assert_select "h2", text: "Beta Private", count: 0
+    assert_select "h2", text: "Beta Published", count: 0
+  end
+
+  test "another tenant's books, pages, and edit histories return 404 everywhere while keeping the user signed in" do
+    [ @alice, @admin_a ].each do |user|
+      sign_in user
+
+      [ @book_b_private, @book_b_published ].each do |book|
+        get book_slug_path(book)
+        assert_response :not_found
+
+        get book_slug_path(book, format: :md)
+        assert_response :not_found
+
+        get edit_book_path(book)
+        assert_response :not_found
+
+        patch book_path(book), params: { book: { title: "Hacked" } }
+        assert_response :not_found
+
+        delete book_path(book)
+        assert_response :not_found
+
+        get book_publication_path(book)
+        assert_response :not_found
+
+        get edit_book_publication_path(book)
+        assert_response :not_found
+
+        patch book_publication_path(book), params: { book: { published: "0" } }
+        assert_response :not_found
+
+        get book_bookmark_path(book)
+        assert_response :not_found
+
+        post book_search_path(book), params: { search: "Beta" }
+        assert_response :not_found
+
+        get new_book_page_path(book)
+        assert_response :not_found
+
+        post book_pages_path(book, format: :turbo_stream), params: { leaf: { title: "X" }, page: { body: "Y" } }
+        assert_response :not_found
+      end
+
+      [ @leaf_b_private, @leaf_b_published ].each do |leaf|
+        get leafable_slug_path(leaf)
+        assert_response :not_found
+
+        get leafable_slug_path(leaf, format: :md)
+        assert_response :not_found
+
+        get edit_leafable_path(leaf)
+        assert_response :not_found
+
+        patch leafable_path(leaf), params: { leaf: { title: "Hacked" } }
+        assert_response :not_found
+
+        delete leafable_path(leaf)
+        assert_response :not_found
+
+        post book_leaves_moves_path(leaf.book), params: { id: leaf.id, position: 0 }
+        assert_response :not_found
+
+        get page_edit_path(leaf, "latest")
+        assert_response :not_found
+
+        get page_edit_path(leaf, leaf.edits.last)
+        assert_response :not_found
+      end
+
+      # User remains signed in throughout
+      get root_path
+      assert_response :success
+      assert_select "h2", text: "Alpha Book"
+      assert cookies[:session_token].present?
+
+      sign_out
+    end
+  end
+
+  test "model access helpers deny cross-tenant access even with an access row or admin role" do
+    assert_not @book_b_private.accessable?(user: @alice)
+    assert_not @book_b_published.accessable?(user: @alice)
+    assert_not @book_b_published.editable?(user: @alice)
+    assert_not @book_b_private.accessable?(user: @admin_a)
+    assert_not @book_b_private.editable?(user: @admin_a)
+    assert_not_includes @alice.books, @book_b_private
+    assert_not_includes @alice.books, @book_b_published
+  end
+
+  test "within a tenant, books, page histories, and sharing keep working" do
+    sign_in @alice
+
+    get book_slug_path(@book_a)
+    assert_response :success
+
+    get leafable_slug_path(@leaf_a)
+    assert_response :success
+    assert_in_body "Alpha v2"
+
+    get page_edit_path(@leaf_a, "latest")
+    assert_response :success
+    assert_in_body "Alpha v1"
+    assert_in_body "Alpha v2"
+  end
+
+  test "/users still lists everyone on the install" do
+    sign_in @alice
+
+    get users_path
+    assert_response :success
+    assert_in_body @alice.name
+    assert_in_body @bob.name
+    assert_in_body users(:david).name
+  end
+
+  test "signed-out visitors still see every published book across all tenants" do
+    books(:handbook).update!(published: true)
+
