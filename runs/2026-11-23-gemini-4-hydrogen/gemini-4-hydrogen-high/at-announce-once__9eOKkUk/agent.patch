diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..3ef15d8
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,161 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+  end
+
+  test "going live announces once" do
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ @book ]) do
+      @book.update!(published: true)
+    end
+  end
+
+  test "going live and adding a page in the same transaction announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.press Page.new(body: "Hello"), title: "Introduction"
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "going live with multiple book updates in the same transaction announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.update!(slug: "updated-manual")
+        @book.update!(published: false)
+        @book.update!(published: true)
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "going live across separate instances in the same transaction announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        first = Book.find(@book.id)
+        first.update!(published: true)
+
+        second = Book.find(@book.id)
+        second.update!(title: "Updated Manual")
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "already-live book saved again does not announce" do
+    @book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true, slug: "new-slug")
+        @book.press Page.new(body: "More"), title: "Chapter 2"
+      end
+    end
+  end
+
+  test "already-live book toggled down and back live in the same transaction does not announce" do
+    @book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: false)
+        @book.update!(published: true)
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "taking a live book down does not announce" do
+    @book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update!(published: false)
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "saving a draft book without going live does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(slug: "still-a-draft")
+        @book.press Page.new(body: "Draft"), title: "Draft page"
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "draft book toggled live then back to draft in the same transaction does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.update!(published: false)
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "failed transaction after marking book live leaves a draft and announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises(ActiveRecord::RecordNotFound) do
+        @book.transaction do
+          @book.update!(published: true)
+          @book.leaves.find(-1)
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "rolled back nested savepoint does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.transaction(requires_new: true) do
+          @book.update!(published: true)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "rolled back nested savepoint after outer publish still announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.transaction(requires_new: true) do
+          @book.update!(published: false)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "creating a book directly as live announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.create!(title: "Born Live", published: true)
+    end
+  end
+
+  test "creating a draft book does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.create!(title: "Born Draft")
+    end
+  end
+end
