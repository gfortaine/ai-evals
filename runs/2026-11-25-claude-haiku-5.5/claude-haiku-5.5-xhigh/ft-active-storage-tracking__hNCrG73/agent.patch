--- /dev/null
+++ b/test/models/board/storage_test.rb
@@ -0,0 +1,176 @@
+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  include StorageTestHelper
+
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "bytes used is zero when a board has no counted content" do
+    assert_equal 0, boards(:private).bytes_used
+  end
+
+  test "counts card images" do
+    blob = upload_blob
+
+    @card.image.attach(blob)
+    perform_bytes_used_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in card descriptions" do
+    blob = upload_blob
+
+    @card.update!(description: embed_html(blob))
+    perform_bytes_used_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in comments on the board's cards" do
+    blob = upload_blob
+
+    @card.comments.create!(body: embed_html(blob))
+    perform_bytes_used_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in the board description" do
+    blob = upload_blob
+
+    @board.update!(public_description: embed_html(blob))
+    perform_bytes_used_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "sums everything counted on the board and its cards" do
+    image = upload_blob("moon.jpg")
+    embedded = upload_blob("avatar.png")
+
+    @card.image.attach(image)
+    @card.update!(description: embed_html(embedded))
+    @card.comments.create!(body: embed_html(embedded))
+    perform_bytes_used_jobs
+
+    assert_equal image.byte_size + 2 * embedded.byte_size, @board.reload.bytes_used
+  end
+
+  test "ignores attachments that are not card images or embeds" do
+    avatar = upload_blob("avatar.png")
+
+    users(:david).avatar.attach(avatar)
+    perform_bytes_used_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "does not count content from other boards" do
+    blob = upload_blob
+    other_card = boards(:private).cards.create!(title: "Private card")
+
+    other_card.image.attach(blob)
+    perform_bytes_used_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal blob.byte_size, boards(:private).reload.bytes_used
+  end
+
+  test "usage is calculated in the background" do
+    blob = upload_blob
+
+    assert_enqueued_with(job: Board::RecalculateBytesUsedJob, args: [ @board ]) do
+      @card.image.attach(blob)
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "updates when a card image is removed" do
+    blob = upload_blob
+    @card.image.attach(blob)
+    perform_bytes_used_jobs
+
+    @card.update!(image: nil)
+    perform_bytes_used_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "replacing a card image counts only the new image" do
+    old_image = upload_blob("moon.jpg")
+    new_image = upload_blob("avatar.png")
+    @card.image.attach(old_image)
+    perform_bytes_used_jobs
+
+    @card.image.attach(new_image)
+    perform_bytes_used_jobs
+
+    assert_equal new_image.byte_size, @board.reload.bytes_used
+  end
+
+  test "updates when an embedded file is removed from a card description" do
+    blob = upload_blob
+    @card.update!(description: embed_html(blob))
+    perform_bytes_used_jobs
+
+    @card.update!(description: "No files anymore")
+    perform_bytes_used_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "updates when a comment with files is deleted" do
+    blob = upload_blob
+    comment = @card.comments.create!(body: embed_html(blob))
+    perform_bytes_used_jobs
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    comment.destroy!
+    perform_bytes_used_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "updates when a card with files is deleted" do
+    blob = upload_blob
+    @card.image.attach(blob)
+    perform_bytes_used_jobs
+
+    @card.destroy!
+    perform_bytes_used_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "moves usage with a card that changes boards" do
+    blob = upload_blob
+    @card.image.attach(blob)
+    perform_bytes_used_jobs
+
+    @card.move_to(boards(:private))
+    perform_bytes_used_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal blob.byte_size, boards(:private).reload.bytes_used
+  end
+
+  test "recalculating does not change the board's updated_at or enqueue needless account updates" do
+    blob = upload_blob
+    @card.image.attach(blob)
+    perform_bytes_used_jobs
+    updated_at = @board.reload.updated_at
+
+    assert_no_enqueued_jobs(only: Account::RecalculateBytesUsedJob) do
+      @board.recalculate_bytes_used_now
+    end
+
+    assert_equal updated_at, @board.reload.updated_at
+  end
+end
diff --git a/test/test_helpers/storage_test_helper.rb b/test/test_helpers/storage_test_helper.rb
