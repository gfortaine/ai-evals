+require "test_helper"
+
+class Account::DataTransfer::BoardRecordSetTest < ActiveSupport::TestCase
+  test "bytes used is not part of the transferred attributes" do
+    record_set = Account::DataTransfer::BoardRecordSet.new(accounts("37s"))
+
+    assert_includes record_set.attributes, "name"
+    assert_not_includes record_set.attributes, "bytes_used"
+  end
+
+  test "check accepts board exports written before bytes used was tracked" do
+    data = boards(:writebook).attributes.except("bytes_used").merge(
+      "id" => "legacy_board_id_0123456789012",
+      "account_id" => "nonexistent_account_id_1234567",
+      "creator_id" => "nonexistent_user_id_123456789"
+    )
+    record_set = Account::DataTransfer::BoardRecordSet.new(accounts("37s"))
+
+    assert_nothing_raised do
+      record_set.check(from: build_reader(data))
+    end
+  end
+
+  private
+    def build_reader(data)
+      tempfile = Tempfile.new([ "board_export", ".zip" ])
+      tempfile.binmode
+
+      writer = ZipFile::Writer.new(tempfile)
+      writer.add_file("data/boards/#{data['id']}.json", data.to_json)
+      writer.close
+      tempfile.rewind
+
+      @tempfiles ||= []
+      @tempfiles << tempfile
+
+      ZipFile::Reader.new(tempfile)
+    end
+
+    def teardown
+      @tempfiles&.each { |f| f.close; f.unlink }
+    end
+end
