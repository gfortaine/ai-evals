+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  include StorageTestHelper
+
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+  end
+
+  test "bytes used is zero for an account without counted content" do
+    assert_equal 0, accounts(:initech).bytes_used
+  end
+
+  test "sums the usage of all boards" do
+    writebook_blob = upload_blob("moon.jpg")
+    private_blob = upload_blob("avatar.png")
+    private_card = boards(:private).cards.create!(title: "Private card")
+
+    cards(:logo).image.attach(writebook_blob)
+    private_card.image.attach(private_blob)
+    perform_bytes_used_jobs
+
+    assert_equal writebook_blob.byte_size, boards(:writebook).reload.bytes_used
+    assert_equal private_blob.byte_size, boards(:private).reload.bytes_used
+    assert_equal writebook_blob.byte_size + private_blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "usage is recalculated in the background" do
+    blob = upload_blob
+
+    assert_enqueued_with(job: Board::RecalculateBytesUsedJob, args: [ boards(:writebook) ]) do
+      cards(:logo).image.attach(blob)
+    end
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "removing a board removes its usage from the account" do
+    writebook_blob = upload_blob("moon.jpg")
+    private_blob = upload_blob("avatar.png")
+    private_card = boards(:private).cards.create!(title: "Private card")
+
+    cards(:logo).image.attach(writebook_blob)
+    private_card.image.attach(private_blob)
+    perform_bytes_used_jobs
+
+    boards(:writebook).destroy!
+    perform_bytes_used_jobs
+
+    assert_equal private_blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "recalculating sums the board values" do
+    boards(:writebook).update_columns(bytes_used: 10)
+    boards(:private).update_columns(bytes_used: 32)
+
+    @account.recalculate_bytes_used_now
+
+    assert_equal 42, @account.reload.bytes_used
+  end
+end
diff --git a/test/models/board/storage_test.rb b/test/models/board/storage_test.rb
new file mode 100644
