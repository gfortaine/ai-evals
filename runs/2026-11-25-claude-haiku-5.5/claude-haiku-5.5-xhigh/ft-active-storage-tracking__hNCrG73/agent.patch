index 0000000..90929e9
--- /dev/null
+++ b/app/jobs/board/recalculate_bytes_used_job.rb
@@ -0,0 +1,12 @@
+class Board::RecalculateBytesUsedJob < ApplicationJob
+  # Recalculations for the same board run one at a time, so a slow, older calculation can never
+  # overwrite the result of a newer one. Concurrency is limited on the board rather than on a database
+  # row lock, so the calculation doesn't block writers while it runs.
+  limits_concurrency key: ->(board) { board }
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(board)
+    board.recalculate_bytes_used_now
+  end
+end
