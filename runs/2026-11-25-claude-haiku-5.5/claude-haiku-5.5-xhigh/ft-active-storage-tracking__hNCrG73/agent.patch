diff --git a/lib/rails_ext/active_storage_attachment_bytes_used.rb b/lib/rails_ext/active_storage_attachment_bytes_used.rb
new file mode 100644
index 0000000..520c8d7
--- /dev/null
+++ b/lib/rails_ext/active_storage_attachment_bytes_used.rb
@@ -0,0 +1,51 @@
+# Keeps Board#bytes_used current as counted files are added and removed. Counted files are card images
+# and files embedded in card descriptions, comments, and board descriptions.
+#
+# Recalculations are enqueued after commit so they always see the committed change. Removals that skip
+# callbacks (attachment.purge, purge_later, or delete) don't reach this hook and must enqueue their own
+# recalculation.
+module ActiveStorageAttachmentBytesUsed
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :recalculate_board_bytes_used_later
+
+    # The board is remembered before the rows are deleted, so a cascading destroy (for example, deleting
+    # a card along with its comments) can still recalculate it after the commit.
+    before_destroy :remember_board_for_bytes_used
+    after_destroy_commit :recalculate_remembered_board_bytes_used_later
+  end
+
+  private
+    def recalculate_board_bytes_used_later
+      board_for_bytes_used&.recalculate_bytes_used_later
+    end
+
+    def remember_board_for_bytes_used
+      @board_id_for_bytes_used = board_for_bytes_used&.id
+    end
+
+    def recalculate_remembered_board_bytes_used_later
+      Board.find_by(id: @board_id_for_bytes_used)&.recalculate_bytes_used_later
+    end
+
+    def board_for_bytes_used
+      if record_type == "Card" && name == "image"
+        record&.board
+      elsif record_type == "ActionText::RichText" && name == "embeds"
+        board_for_rich_text_owner(record&.record)
+      end
+    end
+
+    def board_for_rich_text_owner(owner)
+      case owner
+      when Board then owner
+      when Card then owner.board
+      when Comment then owner.card&.board
+      end
+    end
+end
+
+ActiveSupport.on_load :active_storage_attachment do
+  include ActiveStorageAttachmentBytesUsed
+end
