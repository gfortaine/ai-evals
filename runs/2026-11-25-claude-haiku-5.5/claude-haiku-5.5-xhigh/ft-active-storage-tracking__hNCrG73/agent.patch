diff --git a/app/models/board/storage.rb b/app/models/board/storage.rb
new file mode 100644
index 0000000..43264aa
--- /dev/null
+++ b/app/models/board/storage.rb
@@ -0,0 +1,43 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :recalculate_account_bytes_used_later
+  end
+
+  def recalculate_bytes_used_later
+    Board::RecalculateBytesUsedJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used_now
+    bytes = calculated_bytes_used
+
+    if Board.where(id: id).where.not(bytes_used: bytes).update_all(bytes_used: bytes).positive?
+      account.recalculate_bytes_used_later
+    end
+  end
+
+  private
+    def recalculate_account_bytes_used_later
+      Account.find_by(id: account_id)&.recalculate_bytes_used_later
+    end
+
+    def calculated_bytes_used
+      counted_attachments.joins(:blob).sum("active_storage_blobs.byte_size")
+    end
+
+    def counted_attachments
+      card_images = ActiveStorage::Attachment.where(record_type: "Card", name: "image", record_id: cards.select(:id))
+      embedded_files = ActiveStorage::Attachment.where(record_type: "ActionText::RichText", name: "embeds", record_id: counted_rich_texts.select(:id))
+
+      card_images.or(embedded_files)
+    end
+
+    def counted_rich_texts
+      board_descriptions = ActionText::RichText.where(record_type: "Board", name: "public_description", record_id: id)
+      card_descriptions = ActionText::RichText.where(record_type: "Card", name: "description", record_id: cards.select(:id))
+      comments = ActionText::RichText.where(record_type: "Comment", name: "body", record_id: Comment.where(card_id: cards.select(:id)).select(:id))
+
+      board_descriptions.or(card_descriptions).or(comments)
+    end
+end
