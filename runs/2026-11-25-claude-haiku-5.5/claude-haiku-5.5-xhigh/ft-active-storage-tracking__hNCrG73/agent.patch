+++ b/test/test_helpers/storage_test_helper.rb
@@ -0,0 +1,23 @@
+module StorageTestHelper
+  BYTES_USED_JOBS = [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ].freeze
+
+  def upload_blob(filename = "moon.jpg")
+    ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture(filename).open,
+      filename: filename,
+      content_type: "image/jpeg"
+    )
+  end
+
+  def embed_html(blob)
+    %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+  end
+
+  # Runs pending bytes used recalculations, including the account recalculations that board
+  # recalculations enqueue, and leaves unrelated jobs alone.
+  def perform_bytes_used_jobs
+    while enqueued_jobs.any? { |job| BYTES_USED_JOBS.include?(job[:job]) }
+      perform_enqueued_jobs only: BYTES_USED_JOBS
+    end
+  end
+end
