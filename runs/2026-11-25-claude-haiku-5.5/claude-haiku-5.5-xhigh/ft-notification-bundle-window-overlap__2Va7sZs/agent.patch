index 0000000..52d199d
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,21 @@
+class NotificationMailer < ApplicationMailer
+  helper_method :digest_time
+
+  def bundle(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.order(updated_at: :desc).to_a
+    @notifications_by_board = @notifications.group_by { |notification| notification.card.board }
+
+    mail to: @user.identity.email_address, subject: subject
+  end
+
+  private
+    def subject
+      "You have #{@notifications.size} new #{"notification".pluralize(@notifications.size)} in Fizzy"
+    end
+
+    def digest_time(time)
+      time.in_time_zone(@user.timezone).strftime("%b %-d at %-l:%M %p %Z")
+    end
+end
