+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "daily")
+
+    @t0 = Time.zone.parse("2026-11-19 10:00:00")
+    Notification::Bundle.collect(notifications(:logo_assignment_kevin), arrived_at: @t0)
+    Notification::Bundle.collect(notifications(:buy_domain_sent_back_to_triage_kevin), arrived_at: @t0)
+    Notification::Bundle.collect(notifications(:layout_commented_kevin), arrived_at: @t0)
+
+    @bundle = @user.notification_bundles.sole
+  end
+
+  test "bundle goes to the person" do
+    email = NotificationMailer.bundle(@bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+  end
+
+  test "subject counts the notifications in the bundle" do
+    email = NotificationMailer.bundle(@bundle)
+
+    assert_equal "You have 3 new notifications in Fizzy", email.subject
+  end
+
+  test "has both HTML and text parts" do
+    email = NotificationMailer.bundle(@bundle)
+
+    assert email.html_part.present?, "Email should have HTML part"
+    assert email.text_part.present?, "Email should have text part"
+  end
+
+  test "lists every notification with a link to its card" do
+    email = NotificationMailer.bundle(@bundle)
+
+    [ cards(:logo), cards(:buy_domain), cards(:layout) ].each do |card|
+      assert_includes email.html_part.body.encoded, ERB::Util.html_escape(card.title)
+      assert_includes email.text_part.body.encoded, card.title
+      assert_match %r{/cards/#{card.number}}, email.html_part.body.encoded
+    end
+  end
+
+  test "groups notifications under the board they belong to" do
+    email = NotificationMailer.bundle(@bundle)
+
+    assert_includes email.html_part.body.encoded, boards(:writebook).name
+  end
+
+  test "says why the person is receiving the digest" do
+    email = NotificationMailer.bundle(@bundle)
+
+    assert_includes email.text_part.body.encoded, "email digests are turned on for your account"
+    assert_includes email.html_part.body.encoded, "email digests are turned on for your account"
+  end
+end
