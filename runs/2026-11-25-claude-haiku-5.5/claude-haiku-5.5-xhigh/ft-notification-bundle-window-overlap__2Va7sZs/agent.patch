+++ b/test/models/user/settings_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "bundle_email_frequency defaults to never" do
+    assert_equal "never", users(:kevin).settings.bundle_email_frequency
+    assert_nil users(:kevin).settings.bundle_window
+  end
+
+  test "bundle_window maps each frequency to its window" do
+    settings = users(:kevin).settings
+
+    settings.bundle_email_frequency = "every_few_hours"
+    assert_equal 4.hours, settings.bundle_window
+
+    settings.bundle_email_frequency = "daily"
+    assert_equal 1.day, settings.bundle_window
+
+    settings.bundle_email_frequency = "weekly"
+    assert_equal 1.week, settings.bundle_window
+
+    settings.bundle_email_frequency = "never"
+    assert_nil settings.bundle_window
+  end
+
+  test "bundle_email_frequency only accepts the supported frequencies" do
+    assert_raises(ArgumentError) do
+      users(:kevin).settings.bundle_email_frequency = "hourly"
+    end
+  end
+end
