+# frozen_string_literal: true
+
+# Inputs for the upgrade compatibility goldens (see docs/UPGRADE.md).
+#
+# Shared by test/fixtures/upgrade/generate_goldens.rb and by
+# test/integration/rails_upgrade_compatibility_test.rb. Changing these inputs
+# invalidates the golden files, so regenerate them if you ever need to.
+module UpgradeGoldens
+  # Value stored in the session cookie and in the matching `tokens` row.
+  SESSION_TOKEN = '6b3f1e2a9c0d4e8f7a5b3c1d2e4f6a8b'
+  SESSION_ID = '0f1e2d3c4b5a69788796a5b4c3d2e1f0'
+  SESSION_CSRF_TOKEN = 'Zm9vYmFyYmF6cXV4MTIzNDU2Nzg5MGFiY2RlZmdoaWo='
+  SESSION_USER_ID = 2 # jsmith in the fixtures
+
+  # Mail links are time-limited (30 days); generate and verify them at this instant.
+  TRAVEL_TO = Time.utc(2025, 1, 15, 10, 0, 0)
+
+  SESSION_COOKIE_FILES = {
+    prod: 'session_cookie_prod.json',
+    next: 'session_cookie_next.json'
+  }.freeze
+  MAIL_LINKS_FILE = 'mail_links.json'
+
+  # Query parameters of an issue list link; the keys are literal strings, as in a URL.
+  ISSUES_QUERY = {
+    'f[]' => ['status_id', 'subject'],
+    'op[status_id]' => 'o',
+    'v[subject][]' => ['a b', 'c&d']
+  }.freeze
+
+  def self.session_data
+    {
+      'session_id' => SESSION_ID,
+      'user_id' => SESSION_USER_ID,
+      'tk' => SESSION_TOKEN,
+      '_csrf_token' => SESSION_CSRF_TOKEN
+    }
+  end
+
+  # Every link shape that Redmine puts into outgoing mails, plus an unwatch token.
+  def self.mail_links
+    helpers = Rails.application.routes.url_helpers
+    base = { host: 'redmine.example.com', protocol: 'https', only_path: false, script_name: '/redmine' }
+    links = {
+      'issue show' => helpers.url_for(base.merge(controller: 'issues', action: 'show', id: 12)),
+      'issue journal anchor' => helpers.url_for(base.merge(controller: 'issues', action: 'show', id: 12, anchor: 'change-34')),
+      'lost_password' => helpers.url_for(base.merge(controller: 'account', action: 'lost_password', token: 'Ab+c/d==XyZ_-')),
+      'activate' => helpers.url_for(base.merge(controller: 'account', action: 'activate', token: 'Ab+c/d==XyZ_-')),
+      'attachment download unicode name' => helpers.url_for(base.merge(controller: 'attachments', action: 'download', id: 7, filename: 'résumé (final) #1 ü+plus&amp.pdf')),
+      'attachment download plain' => helpers.url_for(base.merge(controller: 'attachments', action: 'download', id: 7, filename: 'spec.txt')),
+      'attachment show space' => helpers.url_for(base.merge(controller: 'attachments', action: 'show', id: 7, filename: 'my file v2.odt')),
+      'wiki page special' => helpers.url_for(base.merge(controller: 'wiki', action: 'show', project_id: 'ecookbook', id: 'Wiki page (x) + y/z')),
+      'issues query' => helpers.url_for(base.merge(controller: 'issues', action: 'index', project_id: 'ecookbook', set_filter: 1).merge(ISSUES_QUERY)),
+      'news show' => helpers.url_for(base.merge(controller: 'news', action: 'show', id: 3)),
+      'mail unwatch' => helpers.url_for(base.merge(controller: 'mail_links', action: 'unwatch', token: 'eyJfcmFpbHMiOnsibWVzc2FnZSI6IkFBPT0ifX0=--0123abcdef+/==')),
+      'my password' => helpers.url_for(base.merge(controller: 'my', action: 'password')),
+      'login' => helpers.url_for(base.merge(controller: 'account', action: 'login')),
+      'root' => helpers.url_for(base.merge(controller: 'welcome'))
+    }
+    travel_to_golden_time do
+      links['unwatch token'] = Mailer.mail_link_token(:unwatch, 'user_id' => 2, 'issue_id' => 1)
+    end
+    links
+  end
+
+  # Minimal stand-in for ActiveSupport::Testing::TimeHelpers#travel_to, usable from runner scripts.
+  def self.travel_to_golden_time(&block)
+    require 'active_support/testing/time_helpers'
+    helper = Object.new.extend(ActiveSupport::Testing::TimeHelpers)
+    helper.travel_to(TRAVEL_TO, &block)
+  end
+end
