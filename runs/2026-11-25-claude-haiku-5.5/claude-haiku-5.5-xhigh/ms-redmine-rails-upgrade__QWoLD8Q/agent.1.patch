+    # Framework settings pinned to the values production already runs with.
+    #
+    # Rails 7.0 (the next release, see Gemfile.next) changes these defaults,
+    # either through `load_defaults "7.0"` or through its own class defaults.
+    # Each change would sign users out, break unwatch links in mails already
+    # sent, or make a Rails 6.1 rollback unable to read what the next release
+    # wrote. Keep these pinned until docs/UPGRADE.md says otherwise.
+    #
+    # Cookie session format: Rails 7.0 defaults to :json, which cannot read the
+    # Marshal sessions that are already in browsers.
+    config.action_dispatch.cookies_serializer = :marshal
+    # Cookie encryption: keep writing AES-256-CBC. Rails 6.1 still reads
+    # AES-256-GCM cookies written by Rails 7.0 (prepared rotation in
+    # ActionDispatch::Cookies).
+    config.action_dispatch.use_authenticated_cookie_encryption = false
+    config.action_dispatch.use_cookies_with_metadata = false
+    # Derived secrets (cookies and Mailer.mail_link_token): Rails 7.0 load_defaults
+    # sets SHA256; that would change every derived key. Rails 6.1 hard-codes SHA1,
+    # so this line only takes effect once the app runs on Rails 7.0.
+    config.active_support.key_generator_hash_digest_class = OpenSSL::Digest::SHA1
+    # CSRF tokens: Rails 7.0 defaults urlsafe_csrf_tokens to true. Redmine logs
+    # users out on an invalid token, so the token format must not change.
+    config.action_controller.urlsafe_csrf_tokens = false
+    # Per-form tokens are rejected by Rails 6.1 (the rollback target), and origin
+    # checks would reject requests that currently succeed. Both are 7.0 load_defaults.
+    config.action_controller.per_form_csrf_tokens = false
+    config.action_controller.forgery_protection_origin_check = false
+
