+require "test_helper"
+
+class Export::CardsArchiveTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @card = cards(:logo)
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    @diagram = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "diagram.png", content_type: "image/png")
+    @card.update!(description: "<p>See #{embed_for(@diagram)}</p>")
+    @card.comments.create!(creator: users(:kevin), body: "<p>Looks fine to me</p>")
+    @card.steps.create!(content: "Check the logo", completed: true)
+  end
+
+  test "writes one JSON file per card the person can see" do
+    names = archive_names(@user)
+
+    expected = @user.accessible_cards.published.pluck(:number).map { |number| "cards/#{number}.json" }
+    assert_equal expected.sort, names.grep(%r{\Acards/}).sort
+    assert_includes names, "cards/#{@card.number}.json"
+  end
+
+  test "leaves out cards on boards the person can't see, and drafts" do
+    private_card = create_card(boards(:private), title: "Private plans", status: "published")
+    create_card(boards(:private), title: "Still a draft", status: "drafted")
+
+    names = archive_names(users(:jz))
+
+    assert_not_includes @user.accessible_cards.pluck(:id), private_card.id
+    assert_equal users(:jz).accessible_cards.published.count, names.grep(%r{\Acards/}).size
+  end
+
+  test "each card carries its details, description, people, tags, steps and comments" do
+    card_json = read_card(@user, @card)
+
+    assert_equal @card.title, card_json["title"]
+    assert_equal @card.board.name, card_json["board"]
+    assert_equal @card.column.name, card_json["column"]
+    assert_equal @user.name, card_json["creator"]["name"]
+    assert_equal "david@37signals.com", card_json["creator"]["email_address"]
+    assert_equal [ "Check the logo" ], card_json["steps"].map { |step| step["content"] }
+    assert_equal true, card_json["steps"].first["completed"]
+    assert_includes card_json["description"], "diagram.png"
+
+    comment = card_json["comments"].find { |c| c["body"].include?("Looks fine") }
+    assert_equal users(:kevin).name, comment["creator"]["name"]
+    assert_equal [], comment["attachments"]
+  end
+
+  test "the files attached to a card and its comments are in the archive, and the card points to them" do
+    archive = write_archive(@user)
+    card_json = read_card(@user, @card, archive: archive)
+    reader = ZipFile::Reader.new(archive)
+
+    image = card_json["image"]
+    assert_equal "moon.jpg", image["filename"]
+    assert_equal "image/jpeg", image["content_type"]
+    assert_equal file_fixture("moon.jpg").binread, reader.read(image["file"], limit: 10.megabytes)
+
+    embedded = card_json["attachments"].first
+    assert_equal "diagram.png", embedded["filename"]
+    assert_equal file_fixture("avatar.png").binread, reader.read(embedded["file"], limit: 10.megabytes)
+  end
+
+  test "a file used in more than one place on a card is written once" do
+    @card.comments.create!(creator: users(:kevin), body: "<p>Same diagram again: #{embed_for(@diagram)}</p>")
+
+    names = archive_names(@user)
+
+    assert_equal 1, names.grep(%r{\Afiles/#{@diagram.id}/}).size
+  end
+
+  private
+    def write_archive(user)
+      tempfile = Tempfile.new([ "cards", ".zip" ])
+      tempfile.binmode
+
+      writer = ZipFile::Writer.new(tempfile)
+      Current.with_account(user.account) { Export::CardsArchive.new(user).write_to(writer) }
+      writer.close
+
+      tempfile.flush
+      tempfile.rewind
+      tempfile
+    end
+
+    def archive_names(user)
+      archive = write_archive(user)
+      ZipFile::Reader.new(archive).names
+    ensure
+      archive&.close!
+    end
+
+    def read_card(user, card, archive: write_archive(user))
+      JSON.parse(ZipFile::Reader.new(archive).read("cards/#{card.number}.json", limit: 10.megabytes))
+    end
+
+    def embed_for(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+
+    def create_card(board, **attributes)
+      Current.set(user: users(:kevin)) do
+        board.cards.create!(creator: users(:kevin), **attributes)
+      end
+    end
+end
diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..5021a54
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @creator = users(:jason)
+  end
+
+  test "building an account export attaches a zip and emails a download link" do
+    export = @account.exports.create!(kind: :account, creator: @creator)
+
+    build_export(export)
+
+    assert export.reload.completed?
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+    assert_not_nil export.completed_at
+    assert_in_delta 1.day.from_now, export.expires_at, 1.minute
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @creator.identity.email_address ], email.to
+    assert_match "account export is ready", email.subject
+    assert_match %r{/exports/[^/\s"]+}, email.body.encoded
+  end
+
+  test "building a cards export attaches a zip of the cards the creator can see" do
+    export = @account.exports.create!(kind: :cards, creator: users(:david))
+
+    build_export(export)
+
+    assert export.reload.completed?
+    assert export.file.attached?
+    assert_match "cards export is ready", ActionMailer::Base.deliveries.last.subject
+  end
+
+  test "a failed export is marked failed, and its creator is told" do
+    export = @account.exports.create!(kind: :account, creator: @creator)
+
+    Account::DataTransfer::Exporter.any_instance.stubs(:write_to).raises(StandardError, "disk full")
+    Rails.error.expects(:report)
+
+    build_export(export)
+
+    assert export.reload.failed?
+    assert_not export.file.attached?
+    assert_match "couldn't be created", ActionMailer::Base.deliveries.last.subject
+  end
+
+  test "download tokens work for a day" do
+    export = completed_export
+
+    token = export.download_token
+
+    assert_equal export, Export.find_signed(token, purpose: :download)
+
+    travel 2.days do
+      assert_nil Export.find_signed(token, purpose: :download)
+    end
+  end
+
+  test "download tokens aren't accepted for anything else" do
+    export = completed_export
+
+    assert_nil Export.find_signed(export.signed_id(purpose: :something_else), purpose: :download)
+  end
+
+  test "someone who has left the account since asking isn't emailed, but the export is still built" do
+    export = @account.exports.create!(kind: :account, creator: users(:kevin))
+    users(:kevin).update_column(:identity_id, nil)
+
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      Export::BuildJob.perform_now(export)
+      perform_enqueued_jobs
+    end
+
+    assert export.reload.completed?
+  end
+
+  test "cleanup removes exports past their download window, and keeps the rest" do
+    fresh = completed_export
+    stale = completed_export
+    stale.update!(expires_at: 1.minute.ago)
+
+    Export.cleanup
+
+    assert Export.exists?(fresh.id)
+    assert_not Export.exists?(stale.id)
+    assert_not ActiveStorage::Blob.exists?(stale.file.blob_id)
+  end
+
+  test "cleanup removes exports that never finished, once they're a day old" do
+    stuck = @account.exports.create!(kind: :account, creator: @creator)
+    stuck.update_column(:created_at, 2.days.ago)
+
+    Export.cleanup
+
+    assert_not Export.exists?(stuck.id)
+  end
+
+  test "exports belong to their account and go with it" do
+    export = completed_export
+
+    assert_equal @account, export.account
+    assert_includes @account.exports, export
+  end
+
+  private
+    # Runs the job the way it runs in production, then delivers the emails it queued.
+    def build_export(export)
+      Export::BuildJob.perform_now(export)
+      perform_enqueued_jobs
+    end
+
+    def completed_export
+      @account.exports.create!(kind: :account, creator: @creator).tap do |export|
+        build_export(export)
+      end.reload
+    end
+end
diff --git a/test/models/import_test.rb b/test/models/import_test.rb
new file mode 100644
index 0000000..45c163c
--- /dev/null
+++ b/test/models/import_test.rb
@@ -0,0 +1,167 @@
+require "test_helper"
+
+class ImportTest < ActiveSupport::TestCase
+  setup do
+    @source = accounts("37s")
+    @identity = identities(:mike)
+  end
+
+  test "uploading an export reserves an account named after it, to hold the import" do
+    archive = export_archive(@source)
+
+    assert_difference -> { Account.count }, +1 do
+      @import = Import.create_for(file: uploaded_archive(archive), identity: @identity)
+    end
+
+    assert @import.pending?
+    assert_equal @identity, @import.identity
+    assert_equal @source.name, @import.account.name
+    assert_equal 0, @import.account.users.count
+    assert @import.file.attached?
+    assert_equal "application/zip", @import.file.content_type
+  ensure
+    archive&.close!
+  end
+
+  test "uploading something that isn't a zip is refused, and leaves no account behind" do
+    not_an_export = Tempfile.new([ "text", ".zip" ]).tap { |file| file.write("hello there, this is a text file"); file.rewind }
+
+    assert_no_difference -> { Account.count } do
+      error = assert_raises(Account::DataTransfer::Error) do
+        Import.create_for(file: uploaded_archive(not_an_export), identity: @identity)
+      end
+
+      assert_equal "This isn't a Fizzy account export.", error.message
+    end
+  ensure
+    not_an_export&.close!
+  end
+
+  test "uploading a zip that isn't an account export is refused" do
+    archive = archive_with_manifest({ format: "something-else", version: 1 })
+
+    error = assert_raises(Account::DataTransfer::Error) do
+      Import.create_for(file: uploaded_archive(archive), identity: @identity)
+    end
+
+    assert_equal "This isn't a Fizzy account export.", error.message
+  ensure
+    archive&.close!
+  end
+
+  test "uploading an export from a newer version of Fizzy is refused with a way forward" do
+    archive = archive_with_manifest({
+      format: Account::DataTransfer::Manifest::FORMAT,
+      version: Account::DataTransfer::Manifest::VERSION + 1,
+      account: { id: "03ayaunetv3z4n681d58wdysd", name: "Future" },
+      record_counts: {}
+    })
+
+    error = assert_raises(Account::DataTransfer::Error) do
+      Import.create_for(file: uploaded_archive(archive), identity: @identity)
+    end
+
+    assert_match "newer version of Fizzy", error.message
+  ensure
+    archive&.close!
+  end
+
+  test "an export without its account details is refused" do
+    archive = archive_with_manifest({
+      format: Account::DataTransfer::Manifest::FORMAT,
+      version: Account::DataTransfer::Manifest::VERSION,
+      record_counts: {}
+    })
+
+    error = assert_raises(Account::DataTransfer::Error) do
+      Import.create_for(file: uploaded_archive(archive), identity: @identity)
+    end
+
+    assert_match "account details", error.message
+  ensure
+    archive&.close!
+  end
+
+  test "an export whose account details aren't an object is refused, rather than failing unexpectedly" do
+    archive = archive_with_manifest({
+      format: Account::DataTransfer::Manifest::FORMAT,
+      version: Account::DataTransfer::Manifest::VERSION,
+      account: "37signals",
+      record_counts: {}
+    })
+
+    error = assert_raises(Account::DataTransfer::Error) do
+      Import.create_for(file: uploaded_archive(archive), identity: @identity)
+    end
+
+    assert_match "account details", error.message
+  ensure
+    archive&.close!
+  end
+
+  test "processing is queued in the context of the account it will create" do
+    archive = export_archive(@source)
+    import = Import.create_for(file: uploaded_archive(archive), identity: @identity)
+
+    assert_enqueued_with(job: Import::ProcessJob) do
+      import.process_later
+    end
+
+    assert_equal import.account.to_gid.to_s, enqueued_jobs.last["account"].to_s
+  ensure
+    archive&.close!
+  end
+
+  test "a successful import removes its upload and its own record, and tells the person who started it" do
+    archive = export_archive(@source)
+    import = Import.create_for(file: uploaded_archive(archive), identity: @identity)
+    account = import.account
+    upload_blob_id = import.file.blob_id
+
+    perform_enqueued_jobs do
+      import.process_now
+    end
+
+    assert_not Import.exists?(import.id)
+    assert_not ActiveStorage::Blob.exists?(upload_blob_id)
+    assert account.reload.users.exists?(identity: @identity)
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @identity.email_address ], email.to
+    assert_equal "Your Fizzy account is ready", email.subject
+    assert_match "/#{account.slug.delete_prefix("/")}", email.body.encoded
+  ensure
+    archive&.close!
+  end
+
+  test "an import that finds itself already processing was interrupted, so it's cleared away and reported" do
+    archive = export_archive(@source)
+    import = Import.create_for(file: uploaded_archive(archive), identity: @identity)
+    account_id = import.account_id
+    import.processing!
+
+    perform_enqueued_jobs do
+      import.process_now
+    end
+
+    assert_nil Account.find_by(id: account_id)
+    assert_not Import.exists?(import.id)
+
+    email = ActionMailer::Base.deliveries.last
+    assert_match "interrupted", email.body.encoded
+  ensure
+    archive&.close!
+  end
+
+  private
+    def archive_with_manifest(header)
+      tempfile = Tempfile.new([ "header", ".zip" ])
+      tempfile.binmode
+      writer = ZipFile::Writer.new(tempfile)
+      writer.add_file("manifest.json", header.to_json)
+      writer.close
+      tempfile.flush
+      tempfile.rewind
+      tempfile
+    end
+end
