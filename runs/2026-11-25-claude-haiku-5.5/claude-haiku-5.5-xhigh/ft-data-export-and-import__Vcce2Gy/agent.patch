diff --git a/app/models/zip_file/blob_io.rb b/app/models/zip_file/blob_io.rb
new file mode 100644
index 0000000..c9c9dc5
--- /dev/null
+++ b/app/models/zip_file/blob_io.rb
@@ -0,0 +1,40 @@
+# A read-only, seekable IO over an Active Storage blob. Each read is a ranged request to the
+# storage service, so a zip can be read straight from storage without being downloaded first.
+class ZipFile::BlobIO
+  attr_reader :blob
+
+  def initialize(blob)
+    @blob = blob
+    @position = 0
+  end
+
+  def size
+    blob.byte_size
+  end
+
+  def tell
+    @position
+  end
+
+  def seek(offset, whence = IO::SEEK_SET)
+    @position = case whence
+    when IO::SEEK_CUR then @position + offset
+    when IO::SEEK_END then size + offset
+    else offset
+    end
+
+    0
+  end
+
+  def read(length = nil)
+    last = length ? [ @position + length, size ].min : size
+
+    if last > @position
+      blob.service.download_chunk(blob.key, @position...last).tap do |chunk|
+        @position += chunk.bytesize
+      end
+    elsif length.to_i.zero?
+      "".b
+    end
+  end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..244bb3c
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,119 @@
+# Reads entries from a zip file without extracting it. Works from any seekable IO, so
+# archives can be far larger than memory: entries are streamed in chunks.
+#
+# The archive is untrusted input (it comes from users), so reads are bounded by the sizes
+# declared in the central directory and by MAX_LINE_BYTES.
+class ZipFile::Reader
+  class InvalidArchive < StandardError; end
+
+  # Deflated data can expand about a thousand times, so its chunks are kept small to bound how much
+  # memory a single read can take. Stored data doesn't expand, so it can be read in bigger pieces.
+  DEFLATED_CHUNK_BYTES = 64.kilobytes
+  STORED_CHUNK_BYTES = 1.megabyte
+  MAX_LINE_BYTES = 64.megabytes
+  LOCAL_HEADER_BYTES = 30
+  LOCAL_HEADER_SIGNATURE = "PK\x03\x04".b
+  STORED = 0
+  DEFLATED = 8
+  SUPPORTED_STORAGE_MODES = [ STORED, DEFLATED ].freeze
+
+  attr_reader :io
+
+  def initialize(io)
+    @io = io
+    @entries = read_entries
+  end
+
+  def names
+    @entries.keys
+  end
+
+  def entry?(name)
+    @entries.key?(name)
+  end
+
+  def read(name, limit:)
+    output = "".b
+
+    each_chunk(name) do |chunk|
+      output << chunk
+      raise InvalidArchive, "#{name} is too large" if output.bytesize > limit
+    end
+
+    output
+  end
+
+  def each_chunk(name)
+    entry = fetch(name)
+    extractor = entry.extractor_from(io)
+    chunk_bytes = entry.storage_mode == DEFLATED ? DEFLATED_CHUNK_BYTES : STORED_CHUNK_BYTES
+    bytes = 0
+
+    until extractor.eof?
+      chunk = extractor.extract(chunk_bytes)
+      raise InvalidArchive, "#{name} is truncated" if chunk.nil?
+
+      bytes += chunk.bytesize
+      raise InvalidArchive, "#{name} is larger than declared" if bytes > entry.uncompressed_size
+
+      yield chunk.b unless chunk.empty?
+    end
+
+    raise InvalidArchive, "#{name} is smaller than declared" unless bytes == entry.uncompressed_size
+  rescue Zlib::Error, EOFError, IOError
+    raise InvalidArchive, "#{name} is corrupted"
+  end
+
+  def each_line(name)
+    pending = "".b
+
+    each_chunk(name) do |chunk|
+      pending << chunk
+      start = 0
+
+      while (newline = pending.index("\n", start))
+        yield pending.byteslice(start, newline - start).force_encoding(Encoding::UTF_8)
+        start = newline + 1
+      end
+
+      pending = pending.byteslice(start, pending.bytesize - start)
+      raise InvalidArchive, "#{name} has a line that is too long" if pending.bytesize > MAX_LINE_BYTES
+    end
+
+    yield pending.force_encoding(Encoding::UTF_8) unless pending.empty?
+  end
+
+  private
+    def fetch(name)
+      @entries.fetch(name) { raise InvalidArchive, "#{name} is missing from the archive" }
+    end
+
+    def read_entries
+      entries = ZipKit::FileReader.read_zip_structure(io: io, read_local_headers: false)
+
+      entries.each_with_object({}) do |entry, index|
+        raise InvalidArchive, "#{entry.filename} appears more than once" if index.key?(entry.filename)
+        raise InvalidArchive, "#{entry.filename} is compressed in a way that isn't supported" unless SUPPORTED_STORAGE_MODES.include?(entry.storage_mode)
+
+        entry.compressed_data_offset = compressed_data_offset(entry)
+        index[entry.filename] = entry
+      end
+    rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::UnsupportedFeature, ZipKit::FileReader::MissingEOCD,
+      ZipKit::FileReader::InvalidStructure, Zlib::Error, EOFError
+      raise InvalidArchive, "The file is not a valid zip archive"
+    end
+
+    # The central directory doesn't say where an entry's data starts, only where its local
+    # header is. Reading the header on demand avoids one request per entry up front.
+    def compressed_data_offset(entry)
+      io.seek(entry.local_file_header_offset, IO::SEEK_SET)
+      header = io.read(LOCAL_HEADER_BYTES).to_s.b
+
+      unless header.bytesize == LOCAL_HEADER_BYTES && header.start_with?(LOCAL_HEADER_SIGNATURE)
+        raise InvalidArchive, "#{entry.filename} has a corrupt local header"
+      end
+
+      name_length, extra_length = header.unpack("@26vv")
+      entry.local_file_header_offset + LOCAL_HEADER_BYTES + name_length + extra_length
+    end
+end
