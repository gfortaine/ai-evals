@@ -0,0 +1,72 @@
+require "test_helper"
+
+class ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @export = build_export
+  end
+
+  test "a valid link redirects to the file" do
+    untenanted do
+      get export_path(@export.download_token)
+
+      assert_response :redirect
+      assert_includes response.location, "/rails/active_storage/"
+    end
+  end
+
+  test "a link doesn't need anyone to be signed in" do
+    untenanted do
+      get export_path(@export.download_token)
+
+      assert_response :redirect
+    end
+  end
+
+  test "a link stops working after a day" do
+    token = @export.download_token
+
+    travel 2.days do
+      untenanted do
+        get export_path(token)
+
+        assert_response :not_found
+      end
+    end
+  end
+
+  test "a made-up link is refused" do
+    untenanted do
+      get export_path("not-a-real-token")
+
+      assert_response :not_found
+    end
+  end
+
+  test "a link for an export that has been cleaned up is refused" do
+    token = @export.download_token
+    @export.destroy
+
+    untenanted do
+      get export_path(token)
+
+      assert_response :not_found
+    end
+  end
+
+  test "a link for an export that failed is refused" do
+    @export.update!(status: :failed)
+
+    untenanted do
+      get export_path(@export.download_token)
+
+      assert_response :not_found
+    end
+  end
+
+  private
+    def build_export
+      accounts("37s").exports.create!(kind: :account, creator: users(:jason)).tap do |export|
+        Export::BuildJob.perform_now(export)
+      end.reload
+    end
+end
