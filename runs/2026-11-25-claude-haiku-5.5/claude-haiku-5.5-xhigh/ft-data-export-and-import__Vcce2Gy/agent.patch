+require "test_helper"
+
+class AccountDataTransferTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+  end
+
+  test "an owner exports the account, and the emailed link downloads it as a zip" do
+    sign_in_as users(:jason)
+
+    perform_enqueued_jobs do
+      post account_exports_path
+    end
+
+    link = emailed_link(ActionMailer::Base.deliveries.last)
+    assert_match %r{\A/exports/}, URI.parse(link).path
+
+    untenanted do
+      get URI.parse(link).path
+      assert_response :redirect
+      follow_redirect!
+    end
+
+    assert_response :success
+    assert_equal "PK\x03\x04".b, response.body.byteslice(0, 4)
+    archive = Tempfile.new([ "download", ".zip" ]).tap { |file| file.binmode; file.write(response.body); file.flush }
+    assert_equal @account.name, JSON.parse(ZipFile::Reader.new(archive).read("manifest.json", limit: 1.megabyte)).dig("account", "name")
+  ensure
+    archive&.close!
+  end
+
+  test "a member downloads the cards they can see from their profile, through the emailed link" do
+    sign_in_as users(:david)
+
+    perform_enqueued_jobs do
+      post user_exports_path(users(:david))
+    end
+
+    untenanted do
+      get URI.parse(emailed_link(ActionMailer::Base.deliveries.last)).path
+      follow_redirect!
+    end
+
+    assert_response :success
+    archive = Tempfile.new([ "cards", ".zip" ]).tap { |file| file.binmode; file.write(response.body); file.flush }
+    names = ZipFile::Reader.new(archive).names
+    assert_includes names, "cards/#{cards(:logo).number}.json"
+    assert_match "cards export is ready", ActionMailer::Base.deliveries.last.subject
+  ensure
+    archive&.close!
+  end
+
+  test "someone signed in brings an export in and gets a new account they can open" do
+    archive = export_archive(@account)
+    sign_in_as identities(:mike)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post account_imports_path, params: { import: { file: Rack::Test::UploadedFile.new(archive.path, "application/zip", true, original_filename: "export.zip") } }
+      end
+    end
+
+    imported = Account.where(name: @account.name).where.not(id: @account.id).sole
+    assert identities(:mike).accounts.include?(imported)
+    assert imported.users.exists?(identity: identities(:mike), role: :owner)
+    assert_equal @account.cards.count, imported.cards.count
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal "Your Fizzy account is ready", email.subject
+    assert_equal "#{imported.slug}/", URI.parse(emailed_link(email)).path
+
+    get "#{imported.slug}/"
+    assert_response :success
+  ensure
+    archive&.close!
+  end
+
+  private
+    def emailed_link(email)
+      email.body.encoded[%r{https?://[^"\s<]+}]
+    end
+end
diff --git a/test/mailers/export_mailer_test.rb b/test/mailers/export_mailer_test.rb
