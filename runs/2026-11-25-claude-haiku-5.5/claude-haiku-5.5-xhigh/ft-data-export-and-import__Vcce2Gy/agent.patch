@@ -8,4 +8,29 @@ class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransf
       ::ActionText::RichText.where(account: account)
     end
 
+    # Images and files embedded in rich text are referenced by a signed global id. The signature
+    # was made with the secret of the instance that wrote the text, so it has to be made again
+    # with this instance's secret, pointing at the blob's new id.
+    def import_row(record, importer)
+      super.merge("body" => reattach_embeds(record["body"], importer))
+    end
+
+    def reattach_embeds(html, importer)
+      return html if html.blank?
+
+      fragment = ::ActionText::Fragment.wrap(html)
+
+      fragment.find_all(::ActionText::Attachment.tag_name).each do |node|
+        next unless node["sgid"]
+
+        blob = importer.blob_for_sgid(node["sgid"])
+        next unless blob
+
+        attributes = blob.to_rich_text_attributes
+        node["sgid"] = attributes[:sgid]
+        node["url"] = attributes[:url] if attributes[:url]
+      end
+
+      fragment.to_html
+    end
 end
