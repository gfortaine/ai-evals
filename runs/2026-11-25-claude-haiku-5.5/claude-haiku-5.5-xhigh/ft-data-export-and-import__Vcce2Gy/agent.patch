@@ -0,0 +1,112 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @source = accounts("37s")
+  end
+
+  test "the import page is available to someone signed in, without an account in the URL" do
+    sign_in_as identities(:mike)
+
+    untenanted do
+      get new_account_import_path
+
+      assert_response :success
+      assert_select "form[action='#{account_imports_path}'][enctype='multipart/form-data']" do
+        assert_select "input[type=file][name='import[file]']"
+      end
+    end
+  end
+
+  test "the import page sends people who aren't signed in to sign in" do
+    untenanted do
+      get new_account_import_path
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "uploading an export reserves a new account and starts the import" do
+    archive = export_archive(@source)
+
+    untenanted do
+      sign_in_as identities(:mike)
+
+      assert_difference -> { Account.count }, +1 do
+        assert_enqueued_with(job: Import::ProcessJob) do
+          post account_imports_path, params: { import: { file: upload(archive) } }
+        end
+      end
+
+      assert_redirected_to new_account_import_path
+      assert_match "We'll email you when it's ready", flash[:notice]
+    end
+  ensure
+    archive&.close!
+  end
+
+  test "uploading something that isn't an export says so, and creates nothing" do
+    not_an_export = Tempfile.new([ "text", ".zip" ]).tap { |file| file.write("definitely not a zip"); file.rewind }
+
+    untenanted do
+      sign_in_as identities(:mike)
+
+      assert_no_difference -> { Account.count } do
+        post account_imports_path, params: { import: { file: upload(not_an_export) } }
+      end
+
+      assert_redirected_to new_account_import_path
+      assert_equal "This isn't a Fizzy account export.", flash[:alert]
+    end
+  ensure
+    not_an_export&.close!
+  end
+
+  test "posting without a file says so" do
+    untenanted do
+      sign_in_as identities(:mike)
+
+      post account_imports_path, params: { import: { file: "not a file" } }
+
+      assert_redirected_to new_account_import_path
+      assert_equal "Choose an account export to import.", flash[:alert]
+    end
+  end
+
+  test "when new accounts can't be created here, the import is refused" do
+    archive = export_archive(@source)
+
+    untenanted do
+      sign_in_as identities(:mike)
+
+      with_multi_tenant_mode(false) do
+        assert_no_difference -> { Account.count } do
+          post account_imports_path, params: { import: { file: upload(archive) } }
+        end
+
+        assert_redirected_to session_menu_path(script_name: nil)
+      end
+    end
+  ensure
+    archive&.close!
+  end
+
+  test "importing requires sign in" do
+    archive = export_archive(@source)
+
+    untenanted do
+      assert_no_difference -> { Account.count } do
+        post account_imports_path, params: { import: { file: upload(archive) } }
+      end
+
+      assert_redirected_to new_session_path
+    end
+  ensure
+    archive&.close!
+  end
+
+  private
+    def upload(tempfile)
+      Rack::Test::UploadedFile.new(tempfile.path, "application/zip", true, original_filename: "export.zip")
+    end
+end
diff --git a/test/controllers/exports_controller_test.rb b/test/controllers/exports_controller_test.rb
