@@ -1,4 +1,76 @@
 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @card = cards(:logo)
+    @blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+  end
+
+  test "exports the rich text of every record in the account, but none from elsewhere" do
+    @card.update!(description: "<p>Hello</p>")
+    archive = export_archive(@account)
+    rows = read_rows(archive, "records/action_text_rich_texts.ndjson")
+
+    assert_equal ActionText::RichText.where(account: @account).count, rows.size
+    assert rows.all? { |row| row["account_id"] == @account.id }
+  ensure
+    archive&.close!
+  end
+
+  test "an embedded image points at the copy in the new account, so it still shows" do
+    @card.update!(description: "<p>Look: #{embed_html(@blob)}</p>")
+
+    account = import_archive(export_archive(@account))
+    description = account.cards.find_by!(number: @card.number).description
+
+    sgid = Nokogiri::HTML.fragment(description.body.to_html).at_css("action-text-attachment")["sgid"]
+    embedded = ActionText::Attachable.from_attachable_sgid(sgid)
+
+    assert_equal "moon.jpg", embedded.filename.to_s
+    assert_equal account, embedded.account
+    assert_not_equal @blob.id, embedded.id
+  end
+
+  test "an embed whose file isn't in the export is left as it was" do
+    orphan_sgid = Base64.strict_encode64({ _rails: { data: "gid://fizzy/ActiveStorage::Blob/#{ActiveRecord::Type::Uuid.generate}", pur: "attachable" } }.to_json) + "--0000"
+    @card.update!(description: "<p>placeholder</p>")
+    ActionText::RichText.where(record: @card, name: "description").update_all(body: "<p><action-text-attachment sgid=\"#{orphan_sgid}\"></action-text-attachment></p>")
+
+    account = import_archive(export_archive(@account))
+    body = account.cards.find_by!(number: @card.number).description.body.to_html
+
+    assert_includes body, "sgid=\"#{orphan_sgid}\""
+  end
+
+  test "a remote image is left as it was" do
+    url = "https://example.com/picture.png"
+    @card.update!(description: "<p>placeholder</p>")
+    ActionText::RichText.where(record: @card, name: "description").update_all(body: "<p><action-text-attachment url=\"#{url}\" content-type=\"image/png\"></action-text-attachment></p>")
+
+    account = import_archive(export_archive(@account))
+    body = account.cards.find_by!(number: @card.number).description.body.to_html
+
+    assert_includes body, url
+  end
+
+  test "text without embeds comes through unchanged" do
+    @card.update!(description: "<p>Plain <em>text</em> with a <a href=\"https://example.com\">link</a></p>")
+
+    account = import_archive(export_archive(@account))
+    body = account.cards.find_by!(number: @card.number).description.body.to_html
+
+    assert_equal "<p>Plain <em>text</em> with a <a href=\"https://example.com\">link</a></p>", body
+  end
+
+  private
+    def embed_html(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+
+    def read_rows(archive, path)
+      rows = []
+      ZipFile::Reader.new(archive).each_line(path) { |line| rows << JSON.parse(line) }
+      rows
+    end
 end
diff --git a/test/models/account/data_transfer/exporter_test.rb b/test/models/account/data_transfer/exporter_test.rb
new file mode 100644
index 0000000..4571d00
--- /dev/null
+++ b/test/models/account/data_transfer/exporter_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class Account::DataTransfer::ExporterTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    @archive = export_archive(@account)
+    @reader = ZipFile::Reader.new(@archive)
+    @header = JSON.parse(@reader.read("manifest.json", limit: 1.megabyte))
+  end
+
+  teardown do
+    @archive&.close!
+  end
+
+  test "the header says what it is, who it's from, and how many records each table holds" do
+    assert_equal Account::DataTransfer::Manifest::FORMAT, @header["format"]
+    assert_equal Account::DataTransfer::Manifest::VERSION, @header["version"]
+    assert_equal @account.id, @header.dig("account", "id")
+    assert_equal @account.name, @header.dig("account", "name")
+    assert_equal Account.where(id: @account.id).count, @header["record_counts"]["records/accounts.ndjson"]
+    assert_equal Card.where(account: @account).count, @header["record_counts"]["records/cards.ndjson"]
+    assert_equal Comment.where(account: @account).count, @header["record_counts"]["records/comments.ndjson"]
+  end
+
+  test "every table has an entry, even when empty, so an import can tell the export is complete" do
+    @header["record_counts"].each_key do |path|
+      assert @reader.entry?(path), "#{path} is in the header but not the archive"
+    end
+  end
+
+  test "the archive holds the contents of every stored file" do
+    blob_ids = ActiveStorage::Blob.where(account: @account).ids
+    assert blob_ids.any?
+
+    blob_ids.each do |id|
+      assert @reader.entry?("files/#{id}"), "files/#{id} is missing"
+    end
+  end
+
+  test "saved filters are exported with the tags and people they select" do
+    assert @reader.entry?("records/filters_tags.ndjson")
+    assert @reader.entry?("records/assignees_filters.ndjson")
+    assert_equal Filter.where(account: @account).count, @header["record_counts"]["records/filters.ndjson"]
+  end
+
+  test "records are written as one JSON object per line, with their ids" do
+    cards = []
+    @reader.each_line("records/cards.ndjson") { |line| cards << JSON.parse(line) }
+
+    assert_equal Card.where(account: @account).count, cards.size
+    assert cards.all? { |card| card["id"].is_a?(String) && card["account_id"] == @account.id }
+    assert cards.all? { |card| Time.iso8601(card["created_at"]) }
+  end
+
+  test "rich text is exported as the HTML it's stored as" do
+    card = cards(:logo)
+    card.update!(description: "<p>Plain <strong>HTML</strong></p>")
+
+    archive = export_archive(@account)
+    rich_texts = []
+    ZipFile::Reader.new(archive).each_line("records/action_text_rich_texts.ndjson") { |line| rich_texts << JSON.parse(line) }
+    archive.close!
+
+    description = rich_texts.find { |row| row["record_id"] == card.id && row["name"] == "description" }
+    assert_equal "<p>Plain <strong>HTML</strong></p>", description["body"]
+  end
+
+  test "tables that other tables refer to come before the tables that refer to them" do
+    paths = []
+    Account::DataTransfer::Manifest.new(@account).each_record_set { |record_set| paths << record_set.path }
+    paths.compact!
+    position = ->(table) { paths.index("records/#{table}.ndjson") }
+
+    assert position.("accounts") < position.("users")
+    assert position.("users") < position.("cards")
+    assert position.("boards") < position.("cards")
+    assert position.("columns") < position.("cards")
+    assert position.("cards") < position.("comments")
+    assert position.("comments") < position.("events")
+    assert position.("filters") < position.("filters_tags")
+    assert position.("active_storage_blobs") < position.("action_text_rich_texts")
+    assert position.("action_text_rich_texts") < position.("active_storage_attachments")
+    assert position.("active_storage_variant_records") < position.("active_storage_attachments")
+  end
+
+  test "nothing from the export machinery itself is included" do
+    export = @account.exports.create!(kind: :account, creator: users(:jason))
+    export.file.attach(io: StringIO.new("previous export"), filename: "old.zip", content_type: "application/zip")
+
+    archive = export_archive(@account)
+    names = ZipFile::Reader.new(archive).names
+    archive.close!
+
+    assert_not names.any? { |name| name.include?(export.file.blob_id) }
+    assert_not names.include?("records/exports.ndjson")
+  end
+end
