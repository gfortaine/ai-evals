+require "test_helper"
+
+class Account::DataTransfer::ImporterTest < ActiveSupport::TestCase
+  setup do
+    @source = accounts("37s")
+    @card = cards(:logo)
+    @image = attach_image_to(@card)
+    @embed_blob = create_blob("embedded.jpg")
+    @card.update!(description: "<p>Layout notes #{embed_for(@embed_blob)}</p>")
+    @comment = @card.comments.create!(creator: users(:kevin), body: "<p>Screenshot #{embed_for(create_blob("comment.jpg"))}</p>")
+    @publication = boards(:writebook).publish
+    @archive = export_archive(@source)
+  end
+
+  teardown do
+    @archive&.close!
+  end
+
+  test "imports every kind of record into a new account" do
+    account = import_archive(@archive)
+
+    assert_not_equal @source.id, account.id
+
+    [ Board, Column, Card, Comment, Tag, Tagging, Step, Assignment, Access, Watch, Pin, Reaction,
+      Mention, Event, Notification, Filter, Webhook, Closure, User, Entropy, Board::Publication,
+      ActionText::RichText, ActiveStorage::Attachment, ActiveStorage::Blob ].each do |model|
+      assert_equal record_count(model, @source), record_count(model, account), "#{model.name} count"
+    end
+  end
+
+  test "gives every record a new id but keeps card numbers and timestamps" do
+    account = import_archive(@archive)
+    new_card = account.cards.find_by!(number: @card.number)
+
+    assert_not_equal @card.id, new_card.id
+    assert_equal @card.title, new_card.title
+    assert_equal @card.created_at.to_i, new_card.created_at.to_i
+    assert_equal account, new_card.account
+    assert_equal @source.cards_count, account.cards_count
+  end
+
+  test "keeps the references between records within the new account" do
+    account = import_archive(@archive)
+    new_card = account.cards.find_by!(number: @card.number)
+    new_comment = new_card.comments.find_by!(creator: account.users.find_by!(name: users(:kevin).name))
+
+    assert_equal account.boards.find_by!(name: boards(:writebook).name), new_card.board
+    assert_equal account.columns.find_by!(name: @card.column.name), new_card.column
+    assert_equal account.users.find_by!(name: users(:david).name), new_card.creator
+    assert_equal new_card, new_comment.card
+    assert_equal account, new_comment.account
+  end
+
+  test "copies the files attached to cards" do
+    account = import_archive(@archive)
+    new_card = account.cards.find_by!(number: @card.number)
+
+    assert_equal @image.byte_size, new_card.image.blob.byte_size
+    assert_equal @image.checksum, new_card.image.blob.checksum
+    assert_equal file_fixture("moon.jpg").binread, new_card.image.download
+  end
+
+  test "points embedded images at the copies, so they still resolve" do
+    account = import_archive(@archive)
+    new_card = account.cards.find_by!(number: @card.number)
+    embedded = new_card.description.embeds.first.blob
+
+    assert_equal "embedded.jpg", embedded.filename.to_s
+    assert_equal account, embedded.account
+    assert_not_equal @embed_blob.id, embedded.id
+    assert_equal file_fixture("moon.jpg").binread, embedded.download
+
+    sgid = Nokogiri::HTML.fragment(new_card.description.body.to_html).at_css("action-text-attachment")["sgid"]
+    assert_equal embedded, ActionText::Attachable.from_attachable_sgid(sgid)
+  end
+
+  test "makes the importer an owner, using their existing place in the export" do
+    account = import_archive(@archive, identity: identities(:david))
+    user = account.users.find_by!(identity: identities(:david))
+
+    assert user.owner?
+    assert user.verified?
+    assert_equal users(:david).name, user.name
+    assert_equal 1, account.users.where(identity: identities(:david)).count
+  end
+
+  test "adds an importer who isn't in the export as a new owner, named as they are elsewhere" do
+    account = import_archive(@archive, identity: identities(:mike))
+    user = account.users.find_by!(identity: identities(:mike))
+
+    assert user.owner?
+    assert_equal users(:mike).name, user.name
+    assert_equal @source.users.count + 1, account.users.count
+  end
+
+  test "reuses existing identities for the people in the export" do
+    assert_no_difference "Identity.count" do
+      import_archive(@archive, identity: identities(:mike))
+    end
+  end
+
+  test "creates identities for people who have never signed in here" do
+    archive = archive_with_person_unknown_here("newcomer@example.com")
+
+    account = nil
+    assert_difference "Identity.count", 1 do
+      account = import_archive(archive)
+    end
+
+    newcomer = account.users.find_by!(name: "Newcomer")
+
+    assert_equal "newcomer@example.com", newcomer.identity.email_address
+    assert newcomer.member?
+    assert newcomer.verified?
+  ensure
+    archive&.close!
+  end
+
+  test "gives public board links new keys, so the original links keep working" do
+    account = import_archive(@archive)
+    new_board = account.boards.find_by!(name: boards(:writebook).name)
+    new_publication = new_board.publication
+
+    assert_not_equal @publication.key, new_publication.key
+    assert_equal @publication.reload.key, Board::Publication.find_by!(board: boards(:writebook)).key
+  end
+
+  test "keeps saved filters selecting the same tags and people, under their new ids" do
+    account = import_archive(@archive)
+    new_filter = Filter.find_by!(account: account, creator: account.users.find_by!(name: users(:david).name))
+
+    assert_equal [ account.tags.find_by!(title: tags(:mobile).title) ], new_filter.tags.to_a
+    assert_equal [ account.users.find_by!(name: users(:jz).name) ], new_filter.assignees.to_a
+    assert_equal Filter.digest_params(new_filter.as_params), new_filter.params_digest
+  end
+
+  test "digests waiting to be sent are imported as already sent, so the new account doesn't email them" do
+    bundle = Notification::Bundle.create!(user: users(:david), starts_at: 2.hours.ago, ends_at: 1.hour.ago, status: :pending)
+
+    account = import_archive(export_archive(@source))
+    imported = Notification::Bundle.where(account: account).sole
+
+    assert imported.delivered?
+    assert_not_equal bundle.id, imported.id
+    assert_empty Notification::Bundle.where(account: account).due
+  end
+
+  test "reconciles storage, so the new account uses as much space as the original" do
+    account = import_archive(@archive)
+
+    assert account.bytes_used_exact > 0
+    assert_equal @source.bytes_used_exact, account.bytes_used_exact
+  end
+
+  test "reindexes cards and comments, so search finds them in the new account" do
+    account = import_archive(@archive)
+    new_card = account.cards.find_by!(number: @card.number)
+
+    search_records = Search::Record.for(account.id).where(account_id: account.id)
+
+    assert_equal account.cards.published.count, search_records.where(searchable_type: "Card").count
+    assert_equal Comment.where(account: account).count, search_records.where(searchable_type: "Comment").count
+    assert search_records.exists?(searchable_type: "Card", searchable_id: new_card.id)
+  end
+
+  test "importing the same archive again creates a second, separate account" do
+    first = import_archive(@archive)
+    second = import_archive(@archive)
+
+    assert_not_equal first.id, second.id
+    assert_equal first.cards.count, second.cards.count
+    assert_not_equal first.cards.find_by!(number: @card.number).id, second.cards.find_by!(number: @card.number).id
+  end
+
+  test "an export that doesn't list every table's count still imports" do
+    archive = archive_without_count("records/webhooks.ndjson")
+
+    account = import_archive(archive)
+
+    assert_equal record_count(Webhook, @source), record_count(Webhook, account)
+  ensure
+    archive&.close!
+  end
+
+  test "an export whose table is short of the count it lists is refused" do
+    archive = archive_with_count_changed("records/comments.ndjson", 1)
+    import = Import.create_for(file: uploaded_archive(archive), identity: identities(:mike))
+
+    import.process_now
+
+    assert_equal 0, Account.where(name: @source.name).where.not(id: @source.id).count
+  ensure
+    archive&.close!
+  end
+
+  test "a failed import leaves nothing behind" do
+    corrupt = corrupt_archive_line(@archive, "records/comments.ndjson", '{"id":')
+
+    accounts_before = Account.count
+    users_before = User.count
+    identities_before = Identity.count
+    blobs_before = ActiveStorage::Blob.count
+
+    Import.create_for(file: uploaded_archive(corrupt), identity: identities(:mike)).process_now
+
+    assert_equal accounts_before, Account.count
+    assert_equal users_before, User.count
+    assert_equal identities_before, Identity.count
+    assert_equal blobs_before, ActiveStorage::Blob.count
+    assert_equal 0, Import.count
+  ensure
+    corrupt&.close!
+  end
+
+  test "a failed import removes the files it had already stored" do
+    last_blob_id = last_blob_in(@archive)
+    corrupt = archive_with_entry_changed(@archive, "files/#{last_blob_id}") { |content| content.bytes.map { |byte| byte ^ 0xFF }.pack("C*") }
+
+    stored_keys = []
+    subscriber = ActiveSupport::Notifications.subscribe("service_upload.active_storage") do |*, payload|
+      stored_keys << payload[:key]
+    end
+
+    Import.create_for(file: uploaded_archive(corrupt), identity: identities(:mike)).process_now
+
+    assert_predicate stored_keys, :any?, "some files should have been stored before the failure"
+    stored_keys.each do |key|
+      assert_not ActiveStorage::Blob.service.exist?(key), "#{key} was left behind"
+    end
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+    corrupt&.close!
+  end
+
+  test "a failed import tells the person who started it why" do
+    corrupt = corrupt_archive_line(@archive, "records/comments.ndjson", '{"id":')
+    import = Import.create_for(file: uploaded_archive(corrupt), identity: identities(:mike))
+
+    perform_enqueued_jobs do
+      import.process_now
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:mike).email_address ], email.to
+    assert_equal "We couldn't import your Fizzy account", email.subject
+    assert_match "invalid data", email.body.encoded
+  ensure
+    corrupt&.close!
+  end
+
+  test "a failed import doesn't keep the identities it created" do
+    archive = archive_with_person_unknown_here("temporary@example.com")
+    corrupt = corrupt_archive_line(archive, "records/comments.ndjson", '{"id":')
+
+    assert_no_difference "Identity.count" do
+      Import.create_for(file: uploaded_archive(corrupt), identity: identities(:mike)).process_now
+    end
+
+    assert_nil Identity.find_by(email_address: "temporary@example.com")
+  ensure
+    archive&.close!
+    corrupt&.close!
+  end
+
+  private
+    def attach_image_to(card)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      card.image.blob
+    end
+
+    def create_blob(filename)
+      ActiveStorage::Blob.create_and_upload! io: file_fixture("moon.jpg").open, filename: filename, content_type: "image/jpeg"
+    end
+
+    def embed_for(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+
+    # An export containing a person whose identity doesn't exist in this instance yet: the identity
+    # is removed after exporting, as it would be on an instance that has never seen them.
+    def archive_with_person_unknown_here(email_address)
+      identity = Identity.create!(email_address: email_address)
+      @source.users.create!(name: "Newcomer", identity: identity, role: :member, verified_at: Time.current)
+
+      archive = export_archive(@source)
+      Identity.where(id: identity.id).delete_all
+      archive
+    end
+
+    def archive_without_count(path)
+      archive_with_header_changed { |header| header["record_counts"].delete(path) }
+    end
+
+    def archive_with_count_changed(path, count)
+      archive_with_header_changed { |header| header["record_counts"][path] = count }
+    end
+
+    def archive_with_header_changed
+      archive_with_entry_changed(@archive, "manifest.json") do |content|
+        header = JSON.parse(content)
+        yield header
+        header.to_json
+      end
+    end
+
+    # Returns a copy of an archive with one line of one entry replaced.
+    def corrupt_archive_line(source_archive, entry_path, replacement)
+      archive_with_entry_changed(source_archive, entry_path) do |content|
+        lines = content.lines
+        lines[0] = "#{replacement}\n"
+        lines.join
+      end
+    end
+
+    # Returns a copy of an archive with one entry's content transformed.
+    def archive_with_entry_changed(source_archive, entry_path)
+      entries = read_entries(source_archive)
+      entries[entry_path] = yield(entries[entry_path])
+      rebuild_archive(entries)
+    end
+
+    def read_entries(archive)
+      reader = ZipFile::Reader.new(archive)
+      entries = reader.names.index_with { |name| reader.read(name, limit: 1.gigabyte) }
+      archive.rewind
+      entries
+    end
+
+    def rebuild_archive(entries)
+      tempfile = Tempfile.new([ "rebuilt", ".zip" ])
+      tempfile.binmode
+
+      writer = ZipFile::Writer.new(tempfile)
+      entries.each { |name, content| writer.add_file(name, content, compress: !name.start_with?("files/")) }
+      writer.close
+
+      tempfile.flush
+      tempfile.rewind
+      tempfile
+    end
+
+    def last_blob_in(archive)
+      rows = []
+      ZipFile::Reader.new(archive).each_line("records/active_storage_blobs.ndjson") { |line| rows << JSON.parse(line) }
+      archive.rewind
+      rows.last.fetch("id")
+    end
+end
diff --git a/test/models/export/cards_archive_test.rb b/test/models/export/cards_archive_test.rb
