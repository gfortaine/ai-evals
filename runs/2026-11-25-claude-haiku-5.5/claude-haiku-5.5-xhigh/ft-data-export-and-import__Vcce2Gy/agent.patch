     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
 end
+
+class ZipFileCreateForTest < ActiveSupport::TestCase
+  # Stands in for an S3 object: uploads stream into a buffer, and ranged reads come back from it.
+  class FakeS3Object
+    attr_reader :buffer
+
+    def initialize
+      @buffer = StringIO.new("".b)
+    end
+
+    def upload_stream(content_type:, part_size:)
+      yield buffer
+    end
+
+    def get(range:)
+      first, last = range.delete_prefix("bytes=").split("-").map(&:to_i)
+      Struct.new(:body).new(Struct.new(:string).new(buffer.string.byteslice(first, last - first + 1)))
+    end
+  end
+
+  setup do
+    require "active_storage/service/s3_service"
+
+    @s3_object = FakeS3Object.new
+    @s3_service = ActiveStorage::Service::S3Service.new(bucket: "fizzy-test", region: "us-east-1", access_key_id: "x", secret_access_key: "y")
+    @s3_service.stubs(:object_for).returns(@s3_object)
+
+    registry = stub(names: [ ActiveStorage::Blob.service.name.to_s ], fetch: @s3_service)
+    ActiveStorage::Blob.stubs(:services).returns(registry)
+  end
+
+  test "creates an archive by streaming it into S3, and attaches it" do
+    export = accounts("37s").exports.create!(kind: :account, creator: users(:jason))
+
+    ZipFile.create_for(export.file, filename: "export.zip") do |zip|
+      zip.add_file("hello.txt", "Hello from S3")
+    end
+
+    output = @s3_object.buffer.string
+    blob = export.file.blob
+
+    assert export.file.attached?
+    assert_equal output.bytesize, blob.byte_size
+    assert_equal Base64.strict_encode64(Digest::MD5.digest(output)), blob.checksum
+    assert_equal "Hello from S3", ZipFile::Reader.new(StringIO.new(output)).read("hello.txt", limit: 1.kilobyte)
+  end
+end
