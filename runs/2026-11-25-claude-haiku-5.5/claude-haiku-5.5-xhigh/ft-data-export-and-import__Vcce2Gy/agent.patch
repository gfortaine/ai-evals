diff --git a/app/models/account/data_transfer/archive.rb b/app/models/account/data_transfer/archive.rb
new file mode 100644
index 0000000..6cce198
--- /dev/null
+++ b/app/models/account/data_transfer/archive.rb
@@ -0,0 +1,78 @@
+# The reading side of an account export: a zip whose header has been checked to be one we
+# can import. Records are streamed one line at a time, so the archive never has to fit in
+# memory.
+class Account::DataTransfer::Archive
+  MAX_HEADER_BYTES = 1.megabyte
+
+  attr_reader :reader, :header
+
+  def initialize(io)
+    @reader = open_reader(io)
+    @header = read_header
+  end
+
+  def account_id
+    header.dig("account", "id")
+  end
+
+  def account_name
+    header.dig("account", "name")
+  end
+
+  def record_count(path)
+    header.dig("record_counts", path)
+  end
+
+  def entry?(path)
+    reader.entry?(path)
+  end
+
+  def each_record(path)
+    return unless reader.entry?(path)
+
+    reader.each_line(path) do |line|
+      yield parse_record(line, path), line.bytesize
+    end
+  end
+
+  private
+    def open_reader(io)
+      ZipFile::Reader.new(io)
+    rescue ZipFile::Reader::InvalidArchive
+      raise Account::DataTransfer::Error, "This isn't a Fizzy account export."
+    end
+
+    def read_header
+      header = JSON.parse(reader.read("manifest.json", limit: MAX_HEADER_BYTES))
+      validate_header!(header)
+      header
+    rescue ZipFile::Reader::InvalidArchive, JSON::ParserError
+      raise Account::DataTransfer::Error, "This isn't a Fizzy account export."
+    end
+
+    def parse_record(line, path)
+      JSON.parse(line)
+    rescue JSON::ParserError
+      raise Account::DataTransfer::Error, "The export is corrupted: #{path} contains invalid data."
+    end
+
+    def validate_header!(header)
+      unless header.is_a?(Hash) && header["format"] == Account::DataTransfer::Manifest::FORMAT && header["version"].is_a?(Integer) && header["version"] >= 1
+        raise Account::DataTransfer::Error, "This isn't a Fizzy account export."
+      end
+
+      if header["version"] > Account::DataTransfer::Manifest::VERSION
+        raise Account::DataTransfer::Error, "This export was made by a newer version of Fizzy. Update Fizzy and try again."
+      end
+
+      account = header["account"]
+
+      unless account.is_a?(Hash) && account["id"].is_a?(String) && account["name"].is_a?(String)
+        raise Account::DataTransfer::Error, "The export is missing its account details."
+      end
+
+      unless header["record_counts"].is_a?(Hash)
+        raise Account::DataTransfer::Error, "The export is missing its record counts."
+      end
+    end
+end
