+require "test_helper"
+
+class ExportMailerTest < ActionMailer::TestCase
+  setup do
+    @export = accounts("37s").exports.create!(kind: :account, creator: users(:jason))
+    Export::BuildJob.perform_now(@export)
+    @export.reload
+  end
+
+  test "the ready email goes to the person who asked for the export" do
+    email = ExportMailer.ready(@export)
+
+    assert_equal [ users(:jason).identity.email_address ], email.to
+    assert_equal "Your Fizzy account export is ready", email.subject
+  end
+
+  test "the download link isn't under the account, so it works without one in the URL" do
+    email = ExportMailer.ready(@export)
+    link = URI.parse(email.body.encoded[%r{https?://[^"\s<]+/exports/[^"\s<]+}])
+
+    assert_match %r{\A/exports/[^/]+\z}, link.path
+    assert_not link.path.start_with?(@export.account.slug)
+  end
+
+  test "the download link is still tenant-free when the email is written inside an account" do
+    Current.with_account(@export.account) do
+      email = ExportMailer.ready(@export)
+
+      assert_match %r{/exports/}, email.body.encoded
+      assert_no_match %r{#{Regexp.escape(@export.account.slug)}/exports/}, email.body.encoded
+    end
+  end
+
+  test "the link it contains is one that downloads the file" do
+    email = ExportMailer.ready(@export)
+
+    token = email.body.encoded[%r{/exports/([^"\s<?]+)}, 1]
+    assert_equal @export, Export.find_signed(token, purpose: :download)
+  end
+
+  test "the ready email says how long the link works for" do
+    email = ExportMailer.ready(@export)
+
+    assert_match "1 day", email.text_part.body.to_s
+  end
+
+  test "a cards export says so" do
+    cards_export = accounts("37s").exports.create!(kind: :cards, creator: users(:jason))
+    Export::BuildJob.perform_now(cards_export)
+
+    assert_equal "Your Fizzy cards export is ready", ExportMailer.ready(cards_export.reload).subject
+  end
+
+  test "the failure email says the export couldn't be made" do
+    email = ExportMailer.failed(@export)
+
+    assert_equal [ users(:jason).identity.email_address ], email.to
+    assert_match "couldn't be created", email.subject
+  end
+end
