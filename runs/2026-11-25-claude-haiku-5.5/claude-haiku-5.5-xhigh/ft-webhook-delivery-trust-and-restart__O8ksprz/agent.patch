diff --git a/test/jobs/webhook/delivery_job_test.rb b/test/jobs/webhook/delivery_job_test.rb
new file mode 100644
index 0000000..25aad3c
--- /dev/null
+++ b/test/jobs/webhook/delivery_job_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveJob::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @delivery = Webhook::Delivery.create!(webhook: @webhook, event: events(:text_published))
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  test "runs on the webhooks queue" do
+    assert_equal "webhooks", Webhook::DeliveryJob.new.queue_name
+  end
+
+  test "delivers the event to the receiver" do
+    stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    Webhook::DeliveryJob.perform_now(@delivery)
+
+    assert_requested :post, @webhook.url, times: 1
+    assert @delivery.reload.completed?
+  end
+
+  test "a queued delivery is sent exactly once" do
+    stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    Webhook::DeliveryJob.perform_later(@delivery)
+    Webhook::DeliveryJob.perform_later(@delivery)
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert_requested :post, @webhook.url, times: 1
+  end
+
+  test "a failed delivery is not re-enqueued" do
+    stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 503)
+
+    Webhook::DeliveryJob.perform_later(@delivery)
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert @delivery.reload.failed?
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob
+  end
+
+  test "a delivery deleted before its job runs is dropped quietly" do
+    stub_request(:post, @webhook.url)
+    Webhook::DeliveryJob.perform_later(@delivery)
+    @delivery.delete
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Webhook::DeliveryJob
+    end
+
+    assert_not_requested :post, @webhook.url
+  end
+end
diff --git a/test/models/event/webhook_deliveries_test.rb b/test/models/event/webhook_deliveries_test.rb
new file mode 100644
index 0000000..d7e5cdc
--- /dev/null
+++ b/test/models/event/webhook_deliveries_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Event::WebhookDeliveriesTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "creating an event queues a delivery for each active webhook subscribed to its action" do
+    subscribed = @board.webhooks.create!(name: "Subscribed", url: "https://example.com/hook", subscribed_actions: %w[ card_published ])
+
+    event = track_published_event
+
+    assert_equal [ subscribed, webhooks(:active) ].map(&:id).sort, event.webhook_deliveries.pluck(:webhook_id).sort
+    assert event.webhook_deliveries.all?(&:pending?)
+  end
+
+  test "skips webhooks that aren't subscribed to the action" do
+    @board.webhooks.create!(name: "Closed only", url: "https://example.com/hook", subscribed_actions: %w[ card_closed ])
+
+    event = track_published_event
+
+    assert_not event.webhook_deliveries.exists?(webhook: @board.webhooks.find_by(name: "Closed only"))
+  end
+
+  test "skips switched-off webhooks" do
+    webhooks(:active).deactivate
+
+    event = track_published_event
+
+    assert_empty event.webhook_deliveries
+  end
+
+  test "a board without webhooks produces no deliveries" do
+    board = boards(:miltons_wish_list)
+    assert_empty board.webhooks
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      board.events.create!(action: "card_published", creator: users(:david), eventable: cards(:radio), account: accounts("37s"))
+    end
+  end
+
+  test "queues one job per delivery once the event is committed" do
+    Webhook.create!(board: @board, name: "Subscribed", url: "https://example.com/hook", subscribed_actions: %w[ card_published ])
+
+    assert_enqueued_jobs 2, only: Webhook::DeliveryJob do
+      track_published_event
+    end
+    assert_enqueued_with(job: Webhook::DeliveryJob, queue: "webhooks")
+  end
+
+  test "an event that rolls back creates no deliveries and queues no jobs" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference -> { Webhook::Delivery.count } do
+        Event.transaction(requires_new: true) do
+          track_published_event
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  private
+    def track_published_event
+      @board.events.create!(action: "card_published", creator: users(:david), eventable: @card, account: accounts("37s"))
+    end
+end
