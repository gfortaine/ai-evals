+
+  test "deliver connects directly to the vetted address even when an HTTP proxy is configured" do
+    server = TCPServer.new("127.0.0.1", 0)
+    received = Queue.new
+    listener = Thread.new do
+      client = server.accept
+      received << client.gets
+      client.write "HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
+      client.close
+    end
+
+    webhook = webhooks(:active)
+    webhook.update_columns(url: "http://api.example.com:#{server.addr[1]}/hook")
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    SsrfProtection.stubs(:resolve_public_ip).with("api.example.com").returns("127.0.0.1")
+
+    # A proxy that nothing listens on: any use of it would fail the delivery.
