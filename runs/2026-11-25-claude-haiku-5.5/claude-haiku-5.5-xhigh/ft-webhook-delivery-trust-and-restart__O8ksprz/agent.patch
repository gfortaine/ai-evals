+  end
+
+  test "creating a webhook creates its tracker" do
+    webhook = Webhook.create!(name: "New", url: "https://example.com/webhook", board: boards(:writebook))
+
+    assert webhook.delinquency_tracker.present?
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "record_failure starts the streak on the first failure and counts the rest" do
+    freeze_time do
+      @tracker.record_failure
+      @tracker.record_failure
+
+      assert_equal 2, @tracker.reload.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+    end
+  end
+
+  test "the streak start doesn't move on later failures" do
+    first_failure = 2.hours.ago
+    @tracker.update!(consecutive_failures_count: 3, first_failure_at: first_failure)
+
+    @tracker.record_failure
+
+    assert_equal first_failure.to_i, @tracker.reload.first_failure_at.to_i
+  end
+
+  test "switches the webhook off after ten failures in a row spanning an hour" do
+    @tracker.update!(consecutive_failures_count: 9, first_failure_at: 1.hour.ago)
+
+    assert_changes -> { @webhook.reload.active? }, from: true, to: false do
+      @tracker.record_failure
+    end
+  end
+
+  test "keeps the webhook on for ten failures in under an hour" do
+    @tracker.update!(consecutive_failures_count: 9, first_failure_at: 59.minutes.ago)
+
+    @tracker.record_failure
+
+    assert @webhook.reload.active?
+  end
+
+  test "keeps the webhook on for failures spanning an hour when there are fewer than ten" do
+    @tracker.update!(consecutive_failures_count: 8, first_failure_at: 2.hours.ago)
+
+    @tracker.record_failure
+
+    assert @webhook.reload.active?
+  end
+
+  test "reset ends the streak" do
+    @tracker.update!(consecutive_failures_count: 4, first_failure_at: 30.minutes.ago)
+
+    @tracker.reset
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "reset does nothing when there is no streak" do
+    assert_no_changes -> { @tracker.reload.updated_at } do
+      @tracker.reset
+    end
+  end
+
+  test "activating a switched-off webhook starts a new streak" do
+    webhook = webhooks(:inactive)
+    tracker = webhook.delinquency_tracker
+    tracker.update!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+
+    webhook.activate
+
+    assert webhook.reload.active?
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+end
diff --git a/test/models/webhook/delivery_test.rb b/test/models/webhook/delivery_test.rb
index b51445b..cff683b 100644
--- a/test/models/webhook/delivery_test.rb
+++ b/test/models/webhook/delivery_test.rb
@@ -77,4 +77,332 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
 
     assert_nil delivery.response_summary
   end
+
+  # Stubs the receiver and returns a holder for the request it received.
+  def stub_receiver(webhook, status: 200, address: "93.184.216.34", &block)
+    received = nil
+    stub_dns_resolution(address)
+    stub_request(:post, webhook.url).with(ipaddr: address).to_return do |request|
+      received = request
+      block ? block.call : { status: status }
+    end
+    -> { received }
+  end
+
+  test "deliver posts the event to the receiver" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    received = stub_receiver(webhook)
+
+    delivery.deliver
+
+    assert_requested :post, webhook.url, times: 1
+    assert received.call.present?
+    assert delivery.reload.completed?
+    assert_equal 200, delivery.response[:code]
+    assert delivery.succeeded?
+  end
+
+  test "deliver signs the body and sends the event timestamp" do
+    webhook = webhooks(:active)
+    event = events(:text_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+    received = stub_receiver(webhook)
+
+    delivery.deliver
+
+    request = received.call
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, request.body), request.headers["X-Webhook-Signature"]
+    assert_equal event.created_at.utc.iso8601(3), request.headers["X-Webhook-Timestamp"]
+    assert_equal "application/json", request.headers["Content-Type"]
+    assert_equal "fizzy/1.0.0 Webhook", request.headers["User-Agent"]
+    assert_equal request.headers.slice("User-Agent", "Content-Type", "X-Webhook-Timestamp", "X-Webhook-Signature"), delivery.reload.request[:headers]
+  end
+
+  test "deliver sends the event as JSON" do
+    webhook = webhooks(:active)
+    event = events(:text_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+    received = stub_receiver(webhook)
+
+    delivery.deliver
+
+    payload = JSON.parse(received.call.body)
+    assert_equal event.id, payload["id"]
+    assert_equal event.action, payload["action"]
+    assert_equal event.eventable.id, payload.dig("eventable", "id")
+    assert_equal event.board.id, payload.dig("board", "id")
+    assert_equal event.creator.id, payload.dig("creator", "id")
+    assert payload.dig("eventable", "url").include?(event.account.slug), "links should be scoped to the account"
+  end
+
+  test "deliver links the payload to the configured base URL" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    Rails.application.routes.stubs(:default_url_options).returns(host: "fizzy.example.test", protocol: "https")
+    received = stub_receiver(webhook)
+
+    delivery.deliver
+
+    assert JSON.parse(received.call.body).dig("eventable", "url").start_with?("https://fizzy.example.test/")
+  end
+
+  test "deliver records a non-2xx response as a failed delivery" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_receiver(webhook, status: 422)
+
+    delivery.deliver
+
+    assert delivery.reload.completed?
+    assert_equal 422, delivery.response[:code]
+    assert delivery.failed?
+    assert_not delivery.succeeded?
+  end
+
+  test "deliver doesn't follow redirects" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_receiver(webhook, status: 302)
+
+    delivery.deliver
+
+    assert_requested :post, webhook.url, times: 1
+    assert_equal 302, delivery.reload.response[:code]
+    assert delivery.failed?
+  end
+
+  test "deliver records an unreachable receiver as errored" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_receiver(webhook) { raise Errno::ECONNREFUSED }
+
+    delivery.deliver
+
+    assert delivery.reload.errored?
+    assert_equal({ "error" => "destination_unreachable" }, delivery.response)
+    assert delivery.failed?
+  end
+
+  test "deliver records a timeout as errored" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_receiver(webhook) { raise Net::ReadTimeout }
+
+    delivery.deliver
+
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "deliver doesn't connect to a receiver that resolves to a private address" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_dns_resolution("10.0.0.5")
+    stub_request(:post, webhook.url)
+
+    delivery.deliver
+
+    assert_not_requested :post, webhook.url
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "deliver records a receiver that can't be resolved as errored" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    Resolv::DNS.stubs(:open).raises(Resolv::ResolvError)
+    stub_request(:post, webhook.url)
+
+    delivery.deliver
+
+    assert_not_requested :post, webhook.url
+    assert_equal "destination_unreachable", delivery.reload.response[:error]
+  end
+
+  test "deliver sends at most once, even from a stale copy or a second worker" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stale_copy = Webhook::Delivery.find(delivery.id)
+    stub_receiver(webhook)
+
+    delivery.deliver
+    stale_copy.deliver
+    Webhook::Delivery.find(delivery.id).deliver
+
+    assert_requested :post, webhook.url, times: 1
+  end
+
+  test "deliver does nothing when the delivery is already in progress or finished" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_receiver(webhook)
+
+    delivery.update_columns(state: "in_progress")
+    delivery.deliver
+    delivery.update_columns(state: "completed")
+    delivery.deliver
+
+    assert_not_requested :post, webhook.url
+  end
+
+  test "deliver doesn't send to a switched-off webhook" do
+    webhook = webhooks(:inactive)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_request(:post, webhook.url)
+
+    delivery.deliver
+
+    assert_not_requested :post, webhook.url
+    assert delivery.reload.errored?
+    assert_equal "webhook_inactive", delivery.response[:error]
+  end
+
+  test "deliver doesn't retry a failed delivery" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_receiver(webhook, status: 500)
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      delivery.deliver
+    end
+  end
+
+  test "a failed delivery counts against the webhook's streak" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_receiver(webhook, status: 500)
+
+    delivery.deliver
+
+    assert_equal 1, webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "a successful delivery ends the webhook's failure streak" do
+    webhook = webhooks(:active)
+    webhook.delinquency_tracker.update!(consecutive_failures_count: 4, first_failure_at: 30.minutes.ago)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_receiver(webhook, status: 204)
+
+    delivery.deliver
+
+    assert_equal 0, webhook.delinquency_tracker.reload.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "a receiver that keeps failing for an hour is switched off" do
+    webhook = webhooks(:active)
+    webhook.delinquency_tracker.update!(consecutive_failures_count: 9, first_failure_at: 1.hour.ago)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_receiver(webhook, status: 500)
+
+    delivery.deliver
+
+    assert_not webhook.reload.active?
+  end
+
+  test "a delivery whose webhook is deleted mid-request leaves no tracker behind" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_receiver(webhook) do
+      Webhook.find(webhook.id).destroy!
