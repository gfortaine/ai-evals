diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..05618cc
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,35 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  MAX_CONSECUTIVE_FAILURES = 10
+  MIN_FAILURE_STREAK_DURATION = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_delivery(delivery)
+    with_lock do
+      if delivery.succeeded?
+        reset
+      else
+        record_failure
+      end
+    end
+  end
+
+  def reset
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+
+  def delinquent?
+    consecutive_failures_count >= MAX_CONSECUTIVE_FAILURES &&
+      first_failure_at.present? && first_failure_at <= MIN_FAILURE_STREAK_DURATION.ago
+  end
+
+  private
+    def record_failure
+      self.first_failure_at = Time.current if consecutive_failures_count.zero?
+      self.consecutive_failures_count += 1
+      save!
+
+      webhook.deactivate if delinquent?
+    end
+end
