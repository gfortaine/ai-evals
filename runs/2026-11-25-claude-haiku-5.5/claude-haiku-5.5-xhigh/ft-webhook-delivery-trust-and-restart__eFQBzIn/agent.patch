diff --git a/test/models/event/webhook_dispatching_test.rb b/test/models/event/webhook_dispatching_test.rb
new file mode 100644
index 0000000..5352f55
--- /dev/null
+++ b/test/models/event/webhook_dispatching_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class Event::WebhookDispatchingTest < ActiveSupport::TestCase
+  PUBLIC_ADDRESS = "93.184.216.34"
+
+  setup do
+    @board = boards(:writebook)
+    @webhook = webhooks(:active) # subscribed to card_published, card_assigned and card_closed
+  end
+
+  test "creating an event queues dispatch to its webhooks" do
+    assert_enqueued_with job: Webhook::DispatchJob do
+      create_event("card_closed")
+    end
+  end
+
+  test "dispatching creates one pending delivery per subscribed active webhook" do
+    event = create_event("card_closed")
+
+    assert_difference -> { Webhook::Delivery.count }, 1 do
+      event.dispatch_webhooks_now
+    end
+
+    delivery = Webhook::Delivery.find_by!(event: event)
+    assert_equal @webhook, delivery.webhook
+    assert_predicate delivery, :pending?
+    assert_enqueued_with job: Webhook::DeliveryJob, args: [ delivery ]
+  end
+
+  test "webhooks not subscribed to the action get no delivery" do
+    event = create_event("card_postponed")
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.dispatch_webhooks_now
+    end
+  end
+
+  test "inactive webhooks get no delivery" do
+    @webhook.deactivate
+    event = create_event("card_closed")
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.dispatch_webhooks_now
+    end
+  end
+
+  test "webhooks on other boards get no delivery" do
+    other = Webhook.create!(name: "Elsewhere", url: "https://example.com/other", board: boards(:private), subscribed_actions: [ "card_closed" ])
+    event = create_event("card_closed")
+
+    event.dispatch_webhooks_now
+
+    assert_not Webhook::Delivery.exists?(webhook: other, event: event)
+  end
+
+  test "dispatching the same event twice creates a single delivery" do
+    event = create_event("card_closed")
+
+    event.dispatch_webhooks_now
+    event.dispatch_webhooks_now
+
+    assert_equal 1, Webhook::Delivery.where(webhook: @webhook, event: event).count
+  end
+
+  test "an event is delivered exactly once to a receiver" do
+    stub_dns_resolution(PUBLIC_ADDRESS)
+    bodies = []
+    stub = stub_request(:post, @webhook.url)
+      .with(ipaddr: PUBLIC_ADDRESS) { |request| bodies << request.body }
+      .to_return(status: 200)
+
+    event = create_event("card_closed")
+    perform_enqueued_jobs
+    perform_enqueued_jobs # a second pass must not resend
+
+    assert_requested stub, times: 1
+    assert_equal event.id, JSON.parse(bodies.first)["id"]
+    assert_predicate Webhook::Delivery.find_by!(event: event), :completed?
+  end
+
+  private
+    def create_event(action)
+      @board.events.create!(
+        action: action,
+        creator: users(:david),
+        eventable: cards(:logo),
+        account: accounts("37s"),
+        particulars: {}
+      )
+    end
+
+
+  test "a delinquent webhook is switched off when the next event arrives, without sending it" do
+    start = Time.current
+    tracker = @webhook.delinquency_tracker
+
+    travel_to start do
+      10.times { tracker.record_delivery(stub(succeeded?: false)) }
+    end
+
+    travel_to start + 2.hours do
+      event = create_event("card_closed")
+
+      assert_no_difference -> { Webhook::Delivery.count } do
+        event.dispatch_webhooks_now
+      end
+    end
+
+    assert_not @webhook.reload.active?
+  end
+
+
+  test "events on boards without webhooks do not queue dispatch" do
+    board = boards(:miltons_wish_list)
+    assert_not board.webhooks.exists?
+
+    assert_no_enqueued_jobs only: Webhook::DispatchJob do
+      board.events.create!(action: "card_closed", creator: users(:david), eventable: cards(:logo), account: accounts("37s"), particulars: {})
+    end
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..06bc7ac
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+    @start = Time.current
+  end
+
+  test "a failure starts a streak" do
+    travel_to @start do
+      record_failure
+    end
+
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+    assert_equal @start.to_i, @tracker.first_failure_at.to_i
+    assert @webhook.reload.active?
+  end
+
+  test "ten failures within the hour do not deactivate the webhook" do
+    travel_to @start do
+      10.times { record_failure }
+    end
+
+    assert_equal 10, @tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "ten consecutive failures spanning an hour deactivate the webhook" do
+    travel_to @start do
+      record_failure
+    end
+
+    travel_to @start + 1.hour + 1.second do
+      9.times { record_failure }
+    end
+
+    assert_not @webhook.reload.active?
+  end
+
+  test "the streak must span an hour, not just ten failures" do
+    travel_to @start do
+      10.times { record_failure }
+    end
+
+    travel_to @start + 59.minutes do
+      record_failure
+    end
+
+    assert @webhook.reload.active?
+  end
+
+  test "fewer than ten failures do not deactivate the webhook, even over an hour" do
+    travel_to @start do
+      8.times { record_failure }
+    end
+
+    travel_to @start + 2.hours do
+      record_failure
+    end
+
+    assert_equal 9, @tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "a success resets the streak" do
+    travel_to @start do
+      9.times { record_failure }
+    end
+
+    travel_to @start + 1.minute do
+      record_success
+    end
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+
+    travel_to @start + 2.hours do
+      9.times { record_failure }
+    end
+
+    assert_equal 9, @tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "reactivating the webhook starts a fresh streak" do
+    travel_to @start do
+      10.times { record_failure }
+    end
+
+    travel_to @start + 1.hour + 1.second do
+      record_failure
+    end
+    assert_not @webhook.reload.active?
+
+    @webhook.activate
+
+    assert @webhook.reload.active?
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  private
+    def record_failure
+      @tracker.record_delivery(stub(succeeded?: false))
+    end
+
+    def record_success
+      @tracker.record_delivery(stub(succeeded?: true))
+    end
+end
