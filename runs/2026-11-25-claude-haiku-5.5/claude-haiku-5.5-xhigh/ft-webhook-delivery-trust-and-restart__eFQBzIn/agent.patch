@@ -1,4 +1,10 @@
 class Webhook::Delivery < ApplicationRecord
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  RETENTION = 1.week
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+  WRITE_TIMEOUT = 10
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +16,28 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  class << self
+    def cleanup
+      where(created_at: ...RETENTION.ago).in_batches.delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  # Each delivery is attempted once. The pending -> in_progress claim makes a
+  # duplicate job a no-op, so a receiver never gets the same event twice.
+  def deliver_now
+    if claim
+      if webhook.active?
+        post_and_record_outcome
+      else
+        update!(state: :errored, response: { error: "webhook_inactive" })
+      end
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -29,4 +57,73 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      self.class.pending.where(id: id).update_all(state: :in_progress, updated_at: Time.current) == 1
+    end
+
+    def post_and_record_outcome
+      body = payload
+      headers = request_headers(body)
+      outcome = post(body, headers)
+
+      transaction do
+        update!(state: outcome[:error] ? :errored : :completed, request: { headers: headers }, response: outcome)
+        webhook.record_delivery(self)
+      end
+    end
+
+    def payload
+      ApplicationController.renderer.new(script_name: account.slug).render(
+        template: "webhooks/event", formats: :json, assigns: { event: event }
+      )
+    end
+
+    def request_headers(body)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3),
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+
+      if address = public_address_for(uri)
+        request_to(uri, address, body, headers)
+      else
+        { error: "destination_unreachable" }
+      end
+    rescue Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout
+      { error: "timeout" }
+    rescue OpenSSL::SSL::SSLError
+      { error: "ssl_error" }
+    rescue Net::ProtocolError, Net::HTTPBadResponse
+      { error: "protocol_error" }
+    rescue Resolv::ResolvError, Resolv::ResolvTimeout, SocketError, SystemCallError, IOError
+      { error: "destination_unreachable" }
+    end
+
+    # Resolve once, check the address is public, then connect to that exact
+    # address so a second DNS lookup can't point the request somewhere else.
+    def public_address_for(uri)
+      SsrfProtection.resolve_public_ip(uri.host) if uri.host.present?
+    end
+
+    def request_to(uri, address, body, headers)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.ipaddr = address
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+      http.write_timeout = WRITE_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      { code: http.request(request).code.to_i }
+    end
 end
