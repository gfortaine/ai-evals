+module Event::WebhookDispatching
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :dispatch_webhooks_later, if: -> { board.webhooks.any? }
+  end
+
+  def dispatch_webhooks_later
+    Webhook::DispatchJob.perform_later(self)
+  end
+
+  def dispatch_webhooks_now
+    board.webhooks.active.find_each do |webhook|
+      webhook.dispatch(self)
+    end
+  end
+end
