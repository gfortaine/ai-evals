+    assert_equal @bot.user, reply.creator
+    assert_equal "All good <b>really</b>\n\nDone", reply.plain_text_body
+    assert_no_match %r{<b>}, reply.body.body.to_html
+  end
+
+  test "a 200 text/plain answer is broadcast to the room like any message" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_webhook_answer status: 200, content_type: "text/plain", body: "All good"
+
+    assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+      Bot::Webhook.new(@bot, message).deliver
+    end
+  end
+
+  test "a 200 text/html answer is posted as the bot's rich text" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_webhook_answer status: 200, content_type: "text/html", body: "<div>Build <strong>passed</strong></div>"
+
+    Bot::Webhook.new(@bot, message).deliver
+
+    reply = @room.messages.ordered.last
+    assert_equal @bot.user, reply.creator
+    assert_equal "Build passed", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "<strong>passed</strong>"
+  end
+
+  test "a text/html answer can't run script or load images" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_webhook_answer status: 200, content_type: "text/html",
+      body: "<div>Fine<script>alert(1)</script><img src=\"https://evil.example/x.png\" onerror=\"alert(2)\"></div>"
+
+    Bot::Webhook.new(@bot, message).deliver
+
+    stored = @room.messages.ordered.last.body.body.to_html
+    assert_includes stored, "Fine"
+    assert_no_match %r{<script|<img|onerror|alert}, stored
+  end
+
+  test "a text/html answer can't mention people or attach anything, since that would notify them as if they had written it" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_webhook_answer status: 200, content_type: "text/html",
+      body: "<div>Hey #{mention_attachment_for(users(:david))} look</div>"
+
+    Bot::Webhook.new(@bot, message).deliver
+
+    reply = @room.messages.ordered.last
+    assert_empty reply.mentionees
+    assert_empty reply.body.body.attachables
+    assert_equal "Hey look", reply.plain_text_body.squish
+  end
+
+  test "an answer with a charset is read in that charset" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_webhook_answer status: 200, content_type: "text/plain; charset=ISO-8859-1", body: "caf\xE9 ready".b
+
+    Bot::Webhook.new(@bot, message).deliver
+
+    assert_equal "café ready", @room.messages.ordered.last.plain_text_body
+  end
+
+  test "an answer that isn't valid text in its charset posts nothing" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_webhook_answer status: 200, content_type: "text/plain", body: "bad \xFF bytes".b
+
+    assert_no_difference -> { Message.count } do
+      Bot::Webhook.new(@bot, message).deliver
+    end
+  end
+
+  test "a blank answer posts nothing" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_webhook_answer status: 200, content_type: "text/plain", body: " \n\t "
+
+    assert_no_difference -> { Message.count } do
+      Bot::Webhook.new(@bot, message).deliver
+    end
+  end
+
+  test "a 204 posts nothing" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_webhook_answer status: 204, content_type: nil, body: nil
+
+    assert_no_difference -> { Message.count } do
+      Bot::Webhook.new(@bot, message).deliver
+    end
+  end
+
+  test "other statuses and other content types post nothing" do
+    message = create_message_mentioning(@bot.user, " status?")
+
+    [
+      [ 200, "application/json", "{\"ok\":true}" ],
+      [ 201, "text/plain", "Created" ],
+      [ 500, "text/plain", "Oops" ],
+      [ 404, "text/html", "<p>Not here</p>" ]
+    ].each do |status, content_type, body|
+      stub_webhook_answer status: status, content_type: content_type, body: body
+
+      assert_no_difference -> { Message.count }, "#{status} #{content_type}" do
+        Bot::Webhook.new(@bot, message).deliver
+      end
+    end
+  end
+
+  test "a redirect isn't followed, and posts nothing" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_webhook_answer status: 302, content_type: "text/plain", body: "moved", headers: { location: "https://elsewhere.example/x" }
+
+    assert_no_difference -> { Message.count } do
+      Bot::Webhook.new(@bot, message).deliver
+    end
+    assert_not_requested :get, "https://elsewhere.example/x"
+  end
+
+  test "an answer larger than a reply can be posts nothing" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_webhook_answer status: 200, content_type: "text/plain", body: "x" * (Bot::Webhook::MAX_REPLY_SIZE + 1)
+
+    assert_no_difference -> { Message.count } do
+      Bot::Webhook.new(@bot, message).deliver
+    end
+  end
+
+  test "the webhook is sent the payload as JSON" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_webhook_answer status: 204, content_type: nil, body: nil
+
+    Bot::Webhook.new(@bot, message).deliver
+
+    assert_requested :post, WEBHOOK_URL, headers: { "Content-Type" => "application/json" } do |request|
+      JSON.parse(request.body) == JSON.parse(Bot::Webhook.new(@bot, message).payload.to_json)
+    end
+  end
+
+  test "a webhook at a private or internal address isn't contacted, and posts nothing" do
+    RestrictedHTTP::PrivateNetworkGuard.unstub(:resolve)
+    @bot.update!(webhook_url: "http://127.0.0.1:9000/hook")
+    message = create_message_mentioning(@bot.user, " status?")
+
+    assert_no_difference -> { Message.count } do
+      Bot::Webhook.new(@bot, message).deliver
+    end
+  end
+
+  test "a webhook at a public IPv6 address is reached at that address" do
+    RestrictedHTTP::PrivateNetworkGuard.unstub(:resolve)
+    RestrictedHTTP::PrivateNetworkGuard.expects(:resolve).with("2606:4700:4700::1111").returns("2606:4700:4700::1111")
+    @bot.update!(webhook_url: "https://[2606:4700:4700::1111]/hook")
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_request(:post, "https://[2606:4700:4700::1111]/hook").to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Up")
+
+    Bot::Webhook.new(@bot, message).deliver
+
+    assert_equal "Up", @room.messages.ordered.last.plain_text_body
+  end
+
+  test "a webhook whose host doesn't resolve posts nothing" do
+    RestrictedHTTP::PrivateNetworkGuard.unstub(:resolve)
+    Resolv.stubs(:getaddresses).with("nowhere.example").returns([])
+    @bot.update!(webhook_url: "https://nowhere.example/hook")
+    message = create_message_mentioning(@bot.user, " status?")
+
+    assert_no_difference -> { Message.count } do
+      Bot::Webhook.new(@bot, message).deliver
+    end
+  end
+
+  test "a webhook that times out posts nothing and doesn't raise" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_request(:post, WEBHOOK_URL).to_timeout
+
+    assert_no_difference -> { Message.count } do
+      assert_nothing_raised { Bot::Webhook.new(@bot, message).deliver }
+    end
+  end
+
+  test "a webhook that can't be reached posts nothing and doesn't raise" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_request(:post, WEBHOOK_URL).to_raise(Errno::ECONNREFUSED)
+
+    assert_no_difference -> { Message.count } do
+      assert_nothing_raised { Bot::Webhook.new(@bot, message).deliver }
+    end
+  end
+
+  test "an answer after the bot has left the room posts nothing" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_request(:post, WEBHOOK_URL).to_return do
+      @room.memberships.where(user: @bot.user).delete_all
+      { status: 200, headers: { "Content-Type" => "text/plain" }, body: "Still here?" }
+    end
+
+    assert_no_difference -> { Message.count } do
+      Bot::Webhook.new(@bot, message).deliver
+    end
+  end
+
+  test "a bot that has left the room since the mention isn't asked" do
+    message = create_message_mentioning(@bot.user, " status?")
+    @room.memberships.where(user: @bot.user).delete_all
+
+    assert_not_requested :post, WEBHOOK_URL do
+      Bot::Webhook.new(@bot, message).deliver
+    end
+  end
+
+  test "a bot that was deactivated since the mention isn't asked" do
+    message = create_message_mentioning(@bot.user, " status?")
+    @bot.user.deactivate
+
+    assert_not_requested :post, WEBHOOK_URL do
+      Bot::Webhook.new(@bot.reload, message).deliver
+    end
+  end
+
+  test "a bot without a webhook isn't asked" do
+    message = create_message_mentioning(@bot.user, " status?")
+    @bot.update!(webhook_url: nil)
+
+    assert_not_requested :post, WEBHOOK_URL do
+      Bot::Webhook.new(@bot.reload, message).deliver
+    end
+  end
+
+  private
+    def create_message_mentioning(user, *parts)
+      Message.create!(room: @room, creator: @author, body: "<div>#{mention_attachment_for(user)}#{parts.join}</div>")
+    end
+
+    def stub_webhook_answer(status:, content_type:, body:, headers: {})
+      response_headers = headers.merge(content_type ? { "Content-Type" => content_type } : {})
+
+      stub_request(:post, WEBHOOK_URL).to_return(status: status, headers: response_headers, body: body)
+    end
+end
