diff --git a/test/models/message_test.rb b/test/models/message_test.rb
index 3cd12c1..4e73a01 100644
--- a/test/models/message_test.rb
+++ b/test/models/message_test.rb
@@ -27,6 +27,67 @@ class MessageTest < ActiveSupport::TestCase
     assert_equal [], message_mentioning_a_non_member.mentionees
   end
 
+  test "mentioning a bot that has a webhook asks the webhook later, in a job of its own" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://hooks.example.com/deploy")
+    rooms(:hq).memberships.grant_to(bot.user)
+
+    message = rooms(:hq).messages.create!(creator: users(:jason), body: "<div>#{mention_attachment_for(bot.user)} hi</div>")
+
+    assert_enqueued_jobs 1, only: Room::AskMentionedBotsJob
+    perform_enqueued_jobs only: Room::AskMentionedBotsJob
+    assert_enqueued_with job: Bot::WebhookJob, args: [ bot, message ]
+    assert_equal [ bot ], message.mentioned_bots.to_a
+  end
+
+  test "a bot without a webhook isn't asked about mentions" do
+    bot = Bot.create!(name: "Quiet Bot", creator: users(:david))
+    rooms(:hq).memberships.grant_to(bot.user)
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      rooms(:hq).messages.create!(creator: users(:jason), body: "<div>#{mention_attachment_for(bot.user)} hi</div>")
+      perform_enqueued_jobs only: Room::AskMentionedBotsJob
+    end
+  end
+
+  test "a bot is only asked about messages in rooms it's a member of" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://hooks.example.com/deploy")
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      rooms(:watercooler).messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(bot.user)} hi</div>")
+      perform_enqueued_jobs only: Room::AskMentionedBotsJob
+    end
+  end
+
+  test "a message that doesn't mention a bot doesn't ask any webhook" do
+    Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://hooks.example.com/deploy")
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      rooms(:hq).messages.create!(creator: users(:jason), body: "Hello everyone")
+      perform_enqueued_jobs only: Room::AskMentionedBotsJob
+    end
+  end
+
+  test "a bot's own message doesn't ask other bots, so two bots can't keep each other talking" do
+    other = Bot.create!(name: "Other Bot", creator: users(:david), webhook_url: "https://hooks.example.com/other")
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://hooks.example.com/deploy")
+    rooms(:hq).memberships.grant_to(other.user)
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      rooms(:hq).messages.create!(creator: bot.user, body: "<div>#{mention_attachment_for(other.user)} ping</div>")
+      perform_enqueued_jobs only: Room::AskMentionedBotsJob
+    end
+  end
+
+  test "mentionees only include bots that are mentioned and have webhooks" do
+    asked = Bot.create!(name: "Asked Bot", creator: users(:david), webhook_url: "https://hooks.example.com/asked")
+    quiet = Bot.create!(name: "Quiet Bot", creator: users(:david))
+    rooms(:hq).memberships.grant_to([ asked.user, quiet.user ])
+
+    message = Message.new room: rooms(:hq), creator: users(:jason), body: "<div>#{mention_attachment_for(asked.user)} #{mention_attachment_for(quiet.user)} #{mention_attachment_for(users(:david))}</div>"
+
+    assert_equal [ asked ], message.mentioned_bots.to_a
+  end
+
   private
     def create_new_message_in(room)
