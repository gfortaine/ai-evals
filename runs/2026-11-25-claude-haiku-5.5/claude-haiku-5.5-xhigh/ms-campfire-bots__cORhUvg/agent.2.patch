diff --git a/app/jobs/bot/webhook_job.rb b/app/jobs/bot/webhook_job.rb
new file mode 100644
index 0000000..5b871cb
--- /dev/null
+++ b/app/jobs/bot/webhook_job.rb
@@ -0,0 +1,8 @@
+class Bot::WebhookJob < ApplicationJob
+  # The bot or the message may be deleted before the job runs. Then there's nothing to ask.
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bot, message)
+    Bot::Webhook.new(bot, message).deliver
+  end
+end
