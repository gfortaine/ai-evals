@@ -0,0 +1,272 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  # curl sends form-encoded bodies by default, so the tests post the same way
+  FORM_CONTENT_TYPE = { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+
+  setup do
+    host! "once.campfire.test"
+
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david), join_all_open_rooms: true)
+    @room = rooms(:hq) # an open room, which the bot joins because it's set to join all open rooms
+  end
+
+  test "posting the raw body as a message from the bot" do
+    assert_difference -> { @room.messages.count }, +1 do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Deploy of v1.2.3 finished ✅", headers: FORM_CONTENT_TYPE
+    end
+
+    assert_response :created
+
+    message = @room.messages.ordered.last
+    assert_equal @bot.user, message.creator
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+  end
+
+  test "the Location header points at the new message" do
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE
+
+    assert_equal "/messages/#{Message.last.id}", response.headers["Location"]
+  end
+
+  test "a body that isn't valid form encoding is still the message text" do
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Disk usage at 100% and %zz", headers: FORM_CONTENT_TYPE
+
+    assert_response :created
+    assert_equal "Disk usage at 100% and %zz", Message.last.plain_text_body
+  end
+
+  test "a body with form-looking fields is posted verbatim, not parsed" do
+    post room_bot_messages_url(@room, @bot.bot_key), params: "status=ok&build=42", headers: FORM_CONTENT_TYPE
+
+    assert_response :created
+    assert_equal "status=ok&build=42", Message.last.plain_text_body
+  end
+
+  test "markup in the text is shown as text, not rendered" do
+    post room_bot_messages_url(@room, @bot.bot_key), params: "<b>bold?</b> & more", headers: FORM_CONTENT_TYPE
+
+    assert_response :created
+    assert_equal "<b>bold?</b> & more", Message.last.plain_text_body
+    assert_no_match %r{<b>}, Message.last.body.body.to_html
+  end
+
+  test "line breaks in the text are kept" do
+    post room_bot_messages_url(@room, @bot.bot_key), params: "first line\nsecond line\n\nafter a gap", headers: FORM_CONTENT_TYPE
+
+    assert_response :created
+    assert_equal "first line\nsecond line\n\nafter a gap", Message.last.plain_text_body
+  end
+
+  test "an empty body is unprocessable and posts nothing" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "", headers: FORM_CONTENT_TYPE
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "a whitespace-only body is unprocessable" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: " \n\t ", headers: FORM_CONTENT_TYPE
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "a body that isn't valid UTF-8 is unprocessable" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "bad \xFF bytes".b, headers: FORM_CONTENT_TYPE
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "an unknown bot key is unauthorized and posts nothing" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, "not-a-real-bot-key"), params: "Hello", headers: FORM_CONTENT_TYPE
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "a deleted bot can no longer post" do
+    bot_key = @bot.bot_key
+    @bot.deactivate
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, bot_key), params: "Hello", headers: FORM_CONTENT_TYPE
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "a bot whose user has been deactivated is unauthorized" do
+    @bot.user.deactivate
+
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE
+
+    assert_response :unauthorized
+  end
+
+  test "a room id that doesn't exist is not found" do
+    post room_bot_messages_url(room_id: 0, bot_key: @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE
+
+    assert_response :not_found
+  end
+
+  test "a room the bot isn't a member of is not found" do
+    closed_room = rooms(:watercooler)
+    assert_not closed_room.users.include?(@bot.user)
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(closed_room, @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE
+    end
+
+    assert_response :not_found
+  end
+
+  test "a bot can post to a closed room once it has been granted access" do
+    closed_room = rooms(:watercooler)
+    closed_room.memberships.grant_to(@bot.user)
+
+    post room_bot_messages_url(closed_room, @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE
+
+    assert_response :created
+  end
+
+  test "a bot's message is broadcast to the room like a human's" do
+    assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Hello room", headers: FORM_CONTENT_TYPE
+    end
+
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__body", text: /Hello room/
+      assert_select ".message__author strong", text: "Deploy Bot"
+    end
+  end
+
+  test "a bot's message updates unread rooms for each member" do
+    @room.users.each do |member|
+      assert_broadcasts UnreadRoomsChannel.stream_name_for(member.id), 1 do
+        post room_bot_messages_url(@room, @bot.bot_key), params: "Hello #{member.id}", headers: FORM_CONTENT_TYPE
+      end
+    end
+  end
+
+  test "a bot's message triggers push notifications like a human's" do
+    assert_enqueued_with job: Room::PushMessageJob do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE
+    end
+  end
+
+  test "a bot's message shows the bot as its author" do
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE
+
+    sign_in :david
+    get room_messages_url(@room)
+
+    assert_response :success
+    assert_select ".message__author strong", text: "Deploy Bot"
+  end
+
+  test "a bot that doesn't join open rooms gets not found for them until it's added to one" do
+    quiet = Bot.create!(name: "Quiet Bot", creator: users(:david))
+
+    post room_bot_messages_url(@room, quiet.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE
+    assert_response :not_found
+
+    @room.memberships.grant_to(quiet.user)
+
+    post room_bot_messages_url(@room, quiet.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE
+    assert_response :created
+  end
+
+  test "a message over the limit gets 429 Too Many Requests, with the seconds left in Retry-After, and posts nothing" do
+    10.times { post room_bot_messages_url(@room, @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE }
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "One too many", headers: FORM_CONTENT_TYPE
+    end
+
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+  end
+
+  test "during the cooldown, the seconds left in Retry-After count down, and nothing is posted" do
+    10.times { post room_bot_messages_url(@room, @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE }
+    post room_bot_messages_url(@room, @bot.bot_key), params: "One too many", headers: FORM_CONTENT_TYPE
+
+    travel_to Time.current + 10.seconds, with_usec: true
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Still too many", headers: FORM_CONTENT_TYPE
+    end
+
+    assert_response :too_many_requests
+    assert_equal "20", response.headers["Retry-After"]
+  end
+
+  test "once the cooldown is over, the bot can post again" do
+    10.times { post room_bot_messages_url(@room, @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE }
+    post room_bot_messages_url(@room, @bot.bot_key), params: "One too many", headers: FORM_CONTENT_TYPE
+
+    travel_to Time.current + 31.seconds, with_usec: true
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Back", headers: FORM_CONTENT_TYPE
+
+    assert_response :created
+  end
+
+  test "a refused message isn't broadcast to the room" do
+    10.times { post room_bot_messages_url(@room, @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE }
+
+    assert_turbo_stream_broadcasts [ @room, :messages ], count: 0 do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "One too many", headers: FORM_CONTENT_TYPE
+    end
+  end
+
+  test "the fifth attempt during the cooldown suspends the bot, and the attempt after it gets 403 Forbidden" do
+    10.times { post room_bot_messages_url(@room, @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE }
+
+    # The first refusal starts the cooldown, and four more attempts during it leave the bot in good standing.
+    5.times { post room_bot_messages_url(@room, @bot.bot_key), params: "Too many", headers: FORM_CONTENT_TYPE }
+    assert_not @bot.reload.suspended?
+
+    # The fifth attempt during the cooldown is refused as a cooldown, and it's the one that suspends the bot.
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Too many", headers: FORM_CONTENT_TYPE
+
+    assert_response :too_many_requests
+    assert @bot.reload.suspended?
+
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Still going", headers: FORM_CONTENT_TYPE
+
+    assert_response :forbidden
+    assert_nil response.headers["Retry-After"]
+  end
+
+  test "a suspended bot gets 403 Forbidden and posts nothing, even to a room it's a member of" do
+    @bot.suspend!(:flooding)
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE
+    end
+
+    assert_response :forbidden
+  end
+
+  test "a suspended bot is forbidden before its room is looked up" do
+    @bot.suspend!(:failing_webhook)
+
+    post room_bot_messages_url(room_id: 0, bot_key: @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE
+
+    assert_response :forbidden
+  end
+
+  test "a suspended bot's key still identifies it, so a refusal isn't mistaken for an unknown key" do
+    @bot.suspend!(:failing_webhook)
+
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Hello", headers: FORM_CONTENT_TYPE
+
+    assert_response :forbidden
+    assert_nil response.headers["WWW-Authenticate"]
+  end
+end
diff --git a/test/controllers/bots/reactivations_controller_test.rb b/test/controllers/bots/reactivations_controller_test.rb
new file mode 100644
index 0000000..f3b54cd
--- /dev/null
+++ b/test/controllers/bots/reactivations_controller_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Bots::ReactivationsControllerTest < ActionDispatch::IntegrationTest
+  FORM_CONTENT_TYPE = { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:kevin), join_all_open_rooms: true)
+    @bot.suspend!(:failing_webhook)
+    @room = rooms(:hq)
+  end
+
+  test "an administrator reactivates a suspended bot, and is taken back to the bots page" do
+    sign_in :jason
+
+    post bot_reactivation_url(@bot)
+
+    assert_redirected_to bots_url
+    assert_not @bot.reload.suspended?
+  end
+
+  test "a reactivated bot can post again" do
+    sign_in :jason
+    post bot_reactivation_url(@bot)
+
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Back", headers: FORM_CONTENT_TYPE
+
+    assert_response :created
+  end
+
+  test "a member can't reactivate the bot they created, and it stays suspended" do
+    sign_in :kevin
+
+    post bot_reactivation_url(@bot)
+
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "a member can't reactivate a bot created by someone else" do
+    sign_in :bender
+
+    post bot_reactivation_url(@bot)
+
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "a suspended bot stays refused for a member's reactivation attempt" do
+    sign_in :kevin
+    post bot_reactivation_url(@bot)
+
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Still here?", headers: FORM_CONTENT_TYPE
+
+    assert_response :forbidden
+  end
+
+  test "reactivation requires a signed in user" do
+    reset!
+
+    post bot_reactivation_url(@bot)
+
+    assert_redirected_to new_session_url
+    assert @bot.reload.suspended?
+  end
+end
