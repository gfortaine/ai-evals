@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Bot::WebhookJobTest < ActiveSupport::TestCase
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://hooks.example.com/deploy", join_all_open_rooms: true)
+    @message = rooms(:hq).messages.create!(creator: users(:jason), body: "<div>#{mention_attachment_for(@bot.user)} hi</div>")
+  end
+
+  test "the job asks the bot's webhook about the message" do
+    Bot::Webhook.any_instance.expects(:deliver).once
+
+    Bot::WebhookJob.perform_now(@bot, @message)
+  end
+
+  test "the job asks the bot's webhook about a room the bot has joined" do
+    Bot::Webhook.any_instance.expects(:deliver).once
+
+    Bot::WebhookJob.perform_now(@bot, rooms(:hq))
+  end
+
+  test "a bot deleted before its job runs is quietly dropped" do
+    clear_enqueued_jobs
+    Bot::WebhookJob.perform_later(@bot, @message)
+    @bot.delete
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+
+  test "a room deleted before its joined job runs is quietly dropped" do
+    room = Rooms::Open.create!(name: "Short-lived", creator: users(:david))
+    clear_enqueued_jobs
+    Bot::WebhookJob.perform_later(@bot, room)
+    room.destroy
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+end
diff --git a/test/jobs/room/ask_mentioned_bots_job_test.rb b/test/jobs/room/ask_mentioned_bots_job_test.rb
new file mode 100644
index 0000000..a6a2458
--- /dev/null
+++ b/test/jobs/room/ask_mentioned_bots_job_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class Room::AskMentionedBotsJobTest < ActiveSupport::TestCase
+  setup do
+    @room = rooms(:hq)
+    @author = users(:jason)
+  end
+
+  test "each mentioned bot with a webhook gets a webhook job of its own" do
+    first = create_bot("First Bot", "https://hooks.example.com/first")
+    second = create_bot("Second Bot", "https://hooks.example.com/second")
+    message = create_message_mentioning(first.user, second.user)
+
+    assert_enqueued_with job: Bot::WebhookJob, args: [ first, message ] do
+      assert_enqueued_with job: Bot::WebhookJob, args: [ second, message ] do
+        Room::AskMentionedBotsJob.perform_now(message)
+      end
+    end
+  end
+
+  test "a suspended bot isn't asked about mentions, so no webhook job is queued for it" do
+    bot = create_bot("Deploy Bot", "https://hooks.example.com/deploy")
+    bot.suspend!(:failing_webhook)
+    message = create_message_mentioning(bot.user)
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      Room::AskMentionedBotsJob.perform_now(message)
+    end
+  end
+
+  test "a message deleted before the job runs is quietly dropped" do
+    message = create_message_mentioning(create_bot("Deploy Bot", "https://hooks.example.com/deploy").user)
+    Room::AskMentionedBotsJob.perform_later(message)
+    message.delete
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Room::AskMentionedBotsJob
+    end
+  end
+
+  private
+    def create_bot(name, webhook_url)
+      Bot.create!(name: name, creator: users(:david), webhook_url: webhook_url).tap do |bot|
+        @room.memberships.grant_to(bot.user)
+      end
+    end
+
+    def create_message_mentioning(*users)
+      mentions = users.map { |user| mention_attachment_for(user) }.join(" ")
+      Message.create!(room: @room, creator: @author, body: "<div>#{mentions} hi</div>")
+    end
+end
diff --git a/test/lib/rails_ext/filtered_bot_path_test.rb b/test/lib/rails_ext/filtered_bot_path_test.rb
