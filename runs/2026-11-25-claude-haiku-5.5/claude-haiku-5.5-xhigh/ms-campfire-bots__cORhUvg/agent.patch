diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..1c8d535
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,127 @@
+# A bot is a user that a person set up to post messages over HTTP. Its name and avatar live on its user, so it
+# shows up in rooms, mentions and messages exactly like a person. The bot key is the credential its API requests
+# are authenticated with: it's only shown to the bot's creator and administrators, and it's masked in request logs and
+# error reports.
+#
+# A bot may also have a webhook URL. Mentions of the bot are sent there, and the bot can answer in the response.
+#
+# Bots don't join open rooms on their own. With "join all open rooms" on, a bot is a member of every open room: the
+# ones that exist when the switch is turned on, and the ones created later. Turning it off keeps its memberships.
+#
+# A bot that floods a room or whose webhook keeps failing is suspended (see Bot::Suspendable and Bot::Throttle).
+class Bot < ApplicationRecord
+  include Suspendable
+
+  has_secure_token :bot_key
+
+  # Raised when a bot may not post because it's suspended. The posting endpoint answers 403 Forbidden.
+  class Suspended < StandardError; end
+
+  # Raised when a bot may not post because it's cooling down after flooding. The posting endpoint answers 429 Too Many
+  # Requests, with retry_after as the Retry-After header.
+  class CoolingDown < StandardError
+    attr_reader :retry_after
+
+    def initialize(retry_after)
+      @retry_after = retry_after
+      super("Cooling down for #{retry_after} more seconds")
+    end
+  end
+
+  belongs_to :user, autosave: true
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  # A blank webhook URL means the bot has no webhook.
+  normalizes :webhook_url, with: ->(url) { url.strip.presence }
+
+  validates :name, presence: true
+  validate :webhook_url_must_be_http_url
+  validate :creator_must_be_under_bot_limit, on: :create
+
+  after_save :join_open_rooms, if: -> { saved_change_to_join_all_open_rooms?(to: true) }
+
+  scope :ordered, -> { joins(:user).order("LOWER(users.name)") }
+  scope :active, -> { joins(:user).merge(User.active) }
+  scope :created_by, ->(user) { where(creator: user) }
+  scope :with_webhook, -> { where.not(webhook_url: nil) }
+
+  # The bots that get webhooks: their user is active, they have a webhook URL, and they aren't suspended.
+  scope :receiving_webhooks, -> { active.with_webhook.not_suspended }
+
+  # Bot keys travel in the path of the message endpoint, so anything that records request paths (logs, error
+  # reports) runs them through here to mask the key.
+  def self.filter_path(path)
+    path.sub(%r{(/rooms/[^/?]+/)[^/?]+(/messages)(?=\?|\z)}, '\1[FILTERED]\2')
+  end
+
+  def name
+    user&.name
+  end
+
+  def name=(name)
+    bot_user.name = name
+  end
+
+  def avatar=(avatar)
+    bot_user.avatar = avatar
+  end
+
+  # Posts text from the bot into a room. Line breaks are kept and markup is shown as text.
+  def post_text(room, text)
+    post_html(room, html_from_text(text))
+  end
+
+  # Posts HTML from the bot into a room, as its own message. Callers are responsible for what the HTML contains.
+  # Raises Bot::Suspended or Bot::CoolingDown when the bot may not post right now (see Bot::Throttle).
+  def post_html(room, html)
+    Bot::Throttle.new(self).post { room.messages.create!(creator: user, body: html) }.tap(&:broadcast_create)
+  end
+
+  # Removing a bot keeps its messages, just as deactivating a person does, but its user stops being a member
+  # of anything and its bot key stops working.
+  def deactivate
+    transaction do
+      user.deactivate
+      destroy!
+    end
+  end
+
+  private
+    # A bot never signs in, so nobody gets to know its password. The password digest column is required,
+    # so the bot's user gets a random one that's thrown away.
+    def bot_user
+      user || build_user(password: SecureRandom.base58(64))
+    end
+
+    # Joins every open room that exists now. Rooms opened later add the bot when they're created (see Rooms::Open).
+    # This runs in the same transaction as the save, so the bot's memberships are all or nothing.
+    def join_open_rooms
+      return unless user.active?
+
+      Rooms::Open.find_each { |room| room.memberships.grant_to(user) }
+    end
+
+    # Laid out the way the composer lays out a typed message: one block, line breaks kept, markup escaped.
+    def html_from_text(text)
+      lines = text.lines(chomp: true).map { |line| ERB::Util.html_escape(line) }
+
+      "<div>#{lines.join("<br>")}</div>"
+    end
+
+    # Checked when a bot is created, not when it's changed, so lowering the limit leaves existing bots alone. Checking
+    # here rather than only in the controller means nothing else can create a bot past the limit.
+    def creator_must_be_under_bot_limit
+      return if creator.nil? || creator.can_create_bot?
+
+      errors.add :creator, "has reached the limit of #{Current.account.settings.bots_per_member} chat bots"
+    end
+
+    def webhook_url_must_be_http_url
+      return if webhook_url.nil?
+
+      uri = URI.parse(webhook_url)
+      errors.add :webhook_url, :invalid unless uri.is_a?(URI::HTTP) && uri.host.present?
+    rescue URI::InvalidURIError
+      errors.add :webhook_url, :invalid
+    end
+end
diff --git a/app/models/bot/suspendable.rb b/app/models/bot/suspendable.rb
new file mode 100644
index 0000000..f8037db
--- /dev/null
+++ b/app/models/bot/suspendable.rb
@@ -0,0 +1,53 @@
+# A suspended bot can't post and gets no webhooks, but it keeps its rooms and messages, and it still counts towards its
+# owner's bot limit. Suspension comes from flooding (see Bot::Throttle) or from a webhook that keeps failing, which is
+# counted here. Only administrators reactivate a bot (see Bots::ReactivationsController), so a bot never comes back on
+# its own.
+module Bot::Suspendable
+  extend ActiveSupport::Concern
+
+  # Ten failed deliveries in a row suspend a bot. A delivery that gets a 2xx resets the count.
+  FAILED_DELIVERY_LIMIT = 10
+
+  REASONS = {
+    flooding: "Flooding: it posted more than 10 messages in 10 seconds, and kept posting during its cooldown.",
+    failing_webhook: "Its webhook failed #{FAILED_DELIVERY_LIMIT} times in a row."
+  }.freeze
+
+  included do
+    scope :not_suspended, -> { where(suspended_at: nil) }
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def suspension_reason_text
+    REASONS[suspension_reason&.to_sym]
+  end
+
+  def suspend!(reason)
+    update!(suspended_at: Time.current, suspension_reason: reason.to_s)
+    Rails.logger.warn "Bot #{id} suspended: #{reason}"
+  end
+
+  # Clears the suspension along with the counts that led to it, so the bot starts afresh. Locking reloads the bot first:
+  # a copy loaded before the suspension would otherwise think the values it's clearing are already clear, and skip them.
+  def reactivate!
+    with_lock do
+      update!(suspended_at: nil, suspension_reason: nil, consecutive_webhook_failures: 0, cooldown_until: nil, cooldown_attempts: 0)
+    end
+  end
+
+  # Locks the bot so the count is read and written against its latest state.
+  def record_webhook_success
+    with_lock { update!(consecutive_webhook_failures: 0) }
+  end
+
+  def record_webhook_failure
+    with_lock do
+      update!(consecutive_webhook_failures: consecutive_webhook_failures + 1)
+
+      suspend!(:failing_webhook) if consecutive_webhook_failures >= FAILED_DELIVERY_LIMIT && !suspended?
+    end
+  end
+end
diff --git a/app/models/bot/throttle.rb b/app/models/bot/throttle.rb
new file mode 100644
index 0000000..b6de4c9
--- /dev/null
+++ b/app/models/bot/throttle.rb
@@ -0,0 +1,76 @@
+# Stops a bot that floods a room. A bot may post at most MESSAGES messages in any WINDOW, and messages from the message
+# API and from webhook replies count alike. The message that goes over the limit is refused and starts a COOLDOWN. Every
+# attempt to post during the cooldown is refused too, and the ATTEMPTS-th of them suspends the bot.
+#
+# The limits are fixed in code. A refusal is raised only after the bot's state is saved, so a refused attempt still
+# counts. The bot is locked for the whole check and post, so two requests can't both pass the count.
+class Bot::Throttle
+  MESSAGES = 10
+  WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  ATTEMPTS = 5
+
+  attr_reader :bot
+
+  def initialize(bot)
+    @bot = bot
+  end
+
+  # Yields to create the message if the bot may post now, and returns what the block returns. Otherwise raises
+  # Bot::Suspended, or Bot::CoolingDown with the seconds left.
+  def post
+    refusal = nil
+    message = nil
+
+    bot.with_lock do
+      refusal = refuse_attempt
+      message = yield unless refusal
+    end
+
+    raise refusal if refusal
+
+    message
+  end
+
+  private
+    # Returns the refusal for this attempt, after recording the attempt, or nil when the bot may post.
+    def refuse_attempt
+      if bot.suspended?
+        Bot::Suspended.new
+      elsif cooling_down?
+        attempt_during_cooldown
+      elsif flooding?
+        start_cooldown
+      end
+    end
+
+    def cooling_down?
+      bot.cooldown_until&.future?
+    end
+
+    # Counted from the messages themselves, so the window includes every message the bot has posted, and a message
+    # counts whether it came from the API or a webhook. A message counts while it's less than WINDOW old.
+    def flooding?
+      bot.user.messages.where("messages.created_at > ?", WINDOW.ago).count >= MESSAGES
+    end
+
+    def start_cooldown
+      bot.update!(cooldown_until: COOLDOWN.from_now, cooldown_attempts: 0)
+
+      Bot::CoolingDown.new(retry_after)
+    end
+
+    # The attempt that reaches ATTEMPTS is still refused with the cooldown. The bot is suspended from then on, so the
+    # next attempt is refused as a suspension.
+    def attempt_during_cooldown
+      bot.update!(cooldown_attempts: bot.cooldown_attempts + 1)
+      bot.suspend!(:flooding) if bot.cooldown_attempts >= ATTEMPTS
+
+      Bot::CoolingDown.new(retry_after)
+    end
+
+    # Whole seconds left, rounded up, so that a client waiting this long is let in.
+    def retry_after
+      (bot.cooldown_until - Time.current).ceil
+    end
+end
diff --git a/app/models/bot/webhook.rb b/app/models/bot/webhook.rb
new file mode 100644
index 0000000..6a3c86a
--- /dev/null
+++ b/app/models/bot/webhook.rb
@@ -0,0 +1,226 @@
+require "net/http"
+require "zlib"
+require "restricted_http/private_network_guard"
+
+# Tells a bot's webhook about something that happened to it, and posts the bot's answer into the room when it gives one.
+# Two things are told: a mention of the bot, given as the Message that mentions it, and the bot joining a room, given as
+# the Room. Both are sent as a JSON POST, and both are answered the same way:
+#
+# - 200 with a text/plain or text/html body: the body is posted into the room as the bot's message.
+# - 204, or any other 2xx response: nothing is posted. Redirects aren't followed.
+#
+# A delivery that gets a 2xx counts as a success. Anything else (a non-2xx response, a timeout, or a connection error)
+# is a failed delivery, and too many in a row suspend the bot (see Bot::Suspendable).
+#
+# Webhook URLs are set by members, so they're fetched the way link unfurling fetches URLs: addresses that are private
+# or internal are refused, and the checked address is the one connected to, so a DNS change can't redirect the request.
+#
+# This runs in a job, so the person who posted the message never waits on the bot.
+class Bot::Webhook
+  OPEN_TIMEOUT = 5 # seconds to connect
+  READ_TIMEOUT = 15 # seconds between reads
+  DEADLINE = 30 # seconds for the whole exchange, so a bot can't drip out its answer and hold a worker
+
+  MAX_REPLY_SIZE = 64.kilobytes
+  REPLY_CONTENT_TYPES = %w[ text/plain text/html ]
+
+  # A response that isn't 2xx. Nothing is read from it, and it counts as a failed delivery.
+  class NotSuccessful < StandardError; end
+
+  # Ways a webhook can fail that aren't a bug here: refused addresses, unreachable or misbehaving servers, responses
+  # that aren't 2xx, and responses that can't be read. Anything else is left to raise, so it reaches the job's error
+  # reporting.
+  FAILURES = [
+    RestrictedHTTP::Violation, Surfguard::Unresolvable, URI::InvalidURIError, Timeout::Error,
+    SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::ProtocolError, Net::HTTPBadResponse,
+    Net::HTTPHeaderSyntaxError, Zlib::Error, NotSuccessful
+  ]
+
+  # Content from a bot is sanitized the same way as the room's messages. The same filters run when a message is
+  # displayed, so storing clean content doesn't change what people see.
+  SANITIZE = ActionText::Content::Filters.new(ContentFilters::SanitizeTags, ContentFilters::SanitizeAttributes)
+
+  attr_reader :bot, :message, :room
+
+  # The subject is a Message that mentions the bot, or a Room that the bot has just joined.
+  def initialize(bot, subject)
+    @bot = bot
+    @message = subject if subject.is_a?(Message)
+    @room = subject.is_a?(Room) ? subject : subject.room
+  end
+
+  def deliver
+    return unless deliverable?
+
+    reply = ask_webhook
+    post_reply(*reply) if reply
+  end
+
+  # The JSON sent to the webhook. Paths are relative: the bot knows its Campfire origin.
+  def payload
+    message ? mention_payload : joined_payload
+  end
+
+  private
+    def mention_payload
+      {
+        event: "mention",
+        author: { id: message.creator.id, name: message.creator.name },
+        room: room_json,
+        message: {
+          id: message.id,
+          body: { text: text, html: html },
+          link: routes.room_at_message_path(room, message)
+        }
+      }
+    end
+
+    def joined_payload
+      { event: "joined", room: room_json }
+    end
+
+    def room_json
+      { id: room.id, name: room_name, reply_to: routes.room_bot_messages_path(room, bot.bot_key) }
+    end
+
+    def routes
+      Rails.application.routes.url_helpers
+    end
+
+    # The bot may have been removed from the room after the message was posted.
+    def member_of_room?
+      room.users.exists?(bot.user_id)
+    end
+
+    # A suspended bot gets no webhooks, and neither does a bot whose user has gone, or one that has left the room.
+    def deliverable?
+      bot.user.active? && bot.webhook_url && !bot.suspended? && member_of_room?
+    end
+
+    def uri
+      @uri ||= URI.parse(bot.webhook_url)
+    end
+
+    # Returns the answer to post as [content type, text], or nil. A 2xx counts as a successful delivery, and any failure
+    # counts against the bot.
+    def ask_webhook
+      fetch_reply.tap { bot.record_webhook_success }
+    rescue *FAILURES => e
+      Rails.logger.warn "Webhook for bot #{bot.id} failed without a reply: #{e.class}"
+      bot.record_webhook_failure
+      nil
+    end
+
+    def room_name
+      if room.direct?
+        room.users.where.not(id: bot.user_id).pluck(:name).to_sentence.presence || bot.name
+      else
+        room.name
+      end
+    end
+
+    # The message as text, with this bot's own @mention taken out, so that it reads as the command addressed to the bot.
+    def text
+      @text ||= content_without_bot_mention.to_plain_text.gsub(/[ \t]{2,}/, " ").strip
+    end
+
+    def content_without_bot_mention
+      fragment = message.body.body.fragment.replace(ActionText::Attachment.tag_name) do |node|
+        ActionText::Attachable.from_node(node) == bot.user ? nil : node
+      end
+
+      ActionText::Content.new(fragment, canonicalize: false)
+    end
+
+    # The whole message as rich text, mentions included.
+    def html
+      @html ||= SANITIZE.apply(message.body.body).to_html
+    end
+
+    # Returns [content type, text] for an answer that should be posted, or nil. Raises for a failed delivery.
+    def fetch_reply
+      Timeout.timeout(DEADLINE) do
+        address = RestrictedHTTP::PrivateNetworkGuard.resolve(uri.hostname)
+
+        Net::HTTP.start(uri.hostname, uri.port, ipaddr: address, use_ssl: uri.scheme == "https",
+            open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT) do |http|
+          http.request(post_request) do |response|
+            # Returning from inside the block leaves the response unread, so a large or endless body isn't downloaded.
+            return reply_from(response)
+          end
+        end
+      end
+    end
+
+    def post_request
+      Net::HTTP::Post.new(uri.request_uri, "Content-Type" => "application/json").tap do |request|
+        request.body = payload.to_json
+      end
+    end
+
+    def reply_from(response)
+      raise NotSuccessful unless response.is_a?(Net::HTTPSuccess)
+
+      content_type = response.content_type.to_s.downcase
+
+      return unless response.is_a?(Net::HTTPOK) && REPLY_CONTENT_TYPES.include?(content_type)
+
+      if body = read_capped_body(response)
+        [ content_type, decode(body, response.type_params["charset"]) ]
+      end
+    end
+
+    # Nil if the body is larger than a reply can be.
+    def read_capped_body(response)
+      body = String.new
+
+      response.read_body do |chunk|
+        body << chunk
+        return if body.bytesize > MAX_REPLY_SIZE
+      end
+
+      body
+    end
+
+    # The body as UTF-8 text, or nil when it isn't valid in its charset. A reply that doesn't name one is UTF-8.
+    def decode(body, charset)
+      text = body.force_encoding(charset || Encoding::UTF_8).encode(Encoding::UTF_8)
+      text if text.valid_encoding?
+    rescue EncodingError, ArgumentError
+      nil
+    end
+
+    # A reply is an attempt to post like any other, so it's refused while the bot is cooling down or suspended.
+    def post_reply(content_type, text)
+      return if text.nil?
+
+      # The bot may have left the room while its webhook was answering.
+      return unless member_of_room?
+
+      if content_type == "text/html"
+        post_html_reply(text)
+      else
+        post_text_reply(text)
+      end
+    rescue Bot::CoolingDown, Bot::Suspended => e
+      Rails.logger.info "Webhook reply for bot #{bot.id} not posted: #{e.class}"
+    end
+
+    def post_text_reply(text)
+      text = text.strip
+      bot.post_text(room, text) if text.present?
+    end
+
+    def post_html_reply(html)
+      content = sanitized_reply(html)
+      bot.post_html(room, content.to_html) if content.to_plain_text.present?
+    end
+
+    # A bot's HTML is posted without attachments. A mention or other attachment would notify people, and trigger
+    # bots, as though a person had written it.
+    def sanitized_reply(html)
+      fragment = ActionText::Fragment.from_html(html).replace(ActionText::Attachment.tag_name) { nil }
+
+      SANITIZE.apply(ActionText::Content.new(fragment, canonicalize: false))
+    end
+end
