+        <span class="switch__btn round"></span>
+      </span>
+    </label>
+
+    <p class="txt-subtle txt-small margin-none">The bot joins every open room, including rooms created later. Turning this off leaves it in the rooms it's already in.</p>
+  </div>
+
+  <%= form.button class: "btn btn--reversed center txt-large", type: "submit" do %>
+    <%= image_tag "check.svg", aria: { hidden: "true" }, size: 20 %>
+    <span class="for-screen-reader">Save changes</span>
+  <% end %>
+<% end %>
