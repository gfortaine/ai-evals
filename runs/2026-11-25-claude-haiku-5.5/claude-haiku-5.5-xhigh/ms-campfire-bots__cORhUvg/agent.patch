diff --git a/test/models/bot/suspendable_test.rb b/test/models/bot/suspendable_test.rb
new file mode 100644
index 0000000..745db7e
--- /dev/null
+++ b/test/models/bot/suspendable_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Bot::SuspendableTest < ActiveSupport::TestCase
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://hooks.example.com/deploy")
+  end
+
+  test "a new bot isn't suspended" do
+    assert_not @bot.suspended?
+    assert_nil @bot.suspension_reason_text
+  end
+
+  test "suspending a bot records the reason, and the reason is shown as text" do
+    @bot.suspend!(:flooding)
+
+    assert @bot.reload.suspended?
+    assert_equal "flooding", @bot.suspension_reason
+    assert_match(/\AFlooding: it posted more than 10 messages/, @bot.suspension_reason_text)
+  end
+
+  test "suspending a bot keeps its rooms, its messages and its bot key" do
+    room = rooms(:hq)
+    room.memberships.grant_to(@bot.user)
+    message = room.messages.create!(creator: @bot.user, body: "<div>Before</div>")
+    bot_key = @bot.bot_key
+
+    @bot.suspend!(:failing_webhook)
+
+    assert_includes room.reload.users, @bot.user
+    assert_equal message, @bot.user.messages.find(message.id)
+    assert_equal bot_key, @bot.reload.bot_key
+  end
+
+  test "ten failed deliveries in a row suspend the bot, and nine don't" do
+    9.times { @bot.record_webhook_failure }
+    assert_not @bot.reload.suspended?
+
+    @bot.record_webhook_failure
+
+    assert @bot.reload.suspended?
+    assert_equal "failing_webhook", @bot.suspension_reason
+    assert_match(/failed 10 times in a row/, @bot.suspension_reason_text)
+  end
+
+  test "a successful delivery resets the count of failed deliveries" do
+    9.times { @bot.record_webhook_failure }
+    @bot.record_webhook_success
+
+    9.times { @bot.record_webhook_failure }
+
+    assert_not @bot.reload.suspended?
+    assert_equal 9, @bot.consecutive_webhook_failures
+  end
+
+  test "failed deliveries are counted against the bot's latest state, not a stale copy of it" do
+    stale = Bot.find(@bot.id)
+    9.times { @bot.record_webhook_failure }
+
+    stale.record_webhook_failure
+
+    assert stale.reload.suspended?
+    assert_equal 10, stale.consecutive_webhook_failures
+  end
+
+  test "reactivating a bot clears the suspension and the counts behind it" do
+    10.times { @bot.record_webhook_failure }
+    assert @bot.reload.suspended?
+
+    @bot.reactivate!
+
+    assert_not @bot.reload.suspended?
+    assert_nil @bot.suspension_reason
+    assert_nil @bot.suspension_reason_text
+    assert_equal 0, @bot.consecutive_webhook_failures
+    assert_nil @bot.cooldown_until
+    assert_equal 0, @bot.cooldown_attempts
+  end
+
+  test "reactivating through a copy of the bot loaded before the suspension still clears it" do
+    stale = Bot.find(@bot.id)
+    10.times { @bot.record_webhook_failure }
+    assert @bot.reload.suspended?
+
+    stale.reactivate!
+
+    assert_not @bot.reload.suspended?
+    assert_equal 0, @bot.consecutive_webhook_failures
+  end
+
+  test "a reactivated bot can post again" do
+    room = rooms(:hq)
+    room.memberships.grant_to(@bot.user)
+    @bot.suspend!(:flooding)
+
+    @bot.reactivate!
+
+    assert_difference -> { room.messages.count }, +1 do
+      @bot.post_text(room, "Back again")
+    end
+  end
+
+  test "suspended bots are left out of the bots that get webhooks" do
+    assert_includes Bot.receiving_webhooks, @bot
+
+    @bot.suspend!(:flooding)
+
+    assert_not_includes Bot.receiving_webhooks, @bot
+    assert_not_includes Bot.not_suspended, @bot
+  end
+
+  test "a suspended bot still counts towards its owner's bot limit" do
+    @bot.suspend!(:flooding)
+
+    assert_equal 1, Bot.created_by(users(:david)).count
+  end
+end
diff --git a/test/models/bot/throttle_test.rb b/test/models/bot/throttle_test.rb
new file mode 100644
index 0000000..71aee74
--- /dev/null
+++ b/test/models/bot/throttle_test.rb
@@ -0,0 +1,154 @@
+require "test_helper"
+
+class Bot::ThrottleTest < ActiveSupport::TestCase
+  setup do
+    @bot = Bot.create!(name: "Flood Bot", creator: users(:david), join_all_open_rooms: true)
+    @room = rooms(:hq)
+  end
+
+  test "a bot may post ten messages in ten seconds" do
+    assert_difference -> { @bot.user.messages.count }, +10 do
+      10.times { |i| post_as_bot "message #{i}" }
+    end
+  end
+
+  test "the message over the limit is refused, and posts nothing" do
+    10.times { post_as_bot "ok" }
+
+    assert_no_difference -> { Message.count } do
+      assert_raises(Bot::CoolingDown) { post_as_bot "one too many" }
+    end
+  end
+
+  test "the refusal says the cooldown lasts thirty seconds" do
+    10.times { post_as_bot "ok" }
+
+    error = assert_raises(Bot::CoolingDown) { post_as_bot "one too many" }
+
+    assert_equal 30, error.retry_after
+  end
+
+  test "the seconds left count down through the cooldown, and the bot may post again once it's over" do
+    10.times { post_as_bot "ok" }
+    assert_raises(Bot::CoolingDown) { post_as_bot "one too many" }
+
+    travel_by 10.seconds
+    error = assert_raises(Bot::CoolingDown) { post_as_bot "still cooling" }
+    assert_equal 20, error.retry_after
+
+    travel_by 21.seconds
+    assert_nothing_raised { post_as_bot "allowed again" }
+  end
+
+  test "the seconds left are rounded up, so a client that waits them out is let in" do
+    10.times { post_as_bot "ok" }
+    assert_raises(Bot::CoolingDown) { post_as_bot "one too many" }
+
+    travel_by 10.5.seconds
+    error = assert_raises(Bot::CoolingDown) { post_as_bot "still cooling" }
+
+    assert_equal 20, error.retry_after
+  end
+
+  test "attempts during the cooldown don't extend it" do
+    10.times { post_as_bot "ok" }
+    assert_raises(Bot::CoolingDown) { post_as_bot "one too many" }
+
+    travel_by 25.seconds
+    assert_raises(Bot::CoolingDown) { post_as_bot "during" }
+    travel_by 6.seconds
+
+    assert_nothing_raised { post_as_bot "after the first cooldown" }
+  end
+
+  test "a message stops counting once it's ten seconds old" do
+    start = Time.current
+    5.times { post_as_bot "first" }
+
+    travel_to start + 6, with_usec: true
+    5.times { post_as_bot "second" }
+
+    # The first batch is now eleven seconds old, so only the second batch counts: five messages.
+    travel_to start + 11, with_usec: true
+    assert_nothing_raised { 5.times { post_as_bot "third" } }
+    assert_raises(Bot::CoolingDown) { post_as_bot "over" }
+  end
+
+  test "messages posted to any of the bot's rooms count together" do
+    watercooler = rooms(:watercooler)
+    watercooler.memberships.grant_to(@bot.user)
+
+    5.times { post_as_bot "here" }
+    5.times { |i| post_as_bot "there #{i}", room: watercooler }
+
+    assert_raises(Bot::CoolingDown) { post_as_bot "over", room: watercooler }
+  end
+
+  test "messages from people don't count against the bot" do
+    10.times { Message.create!(room: @room, creator: users(:jason), body: "<div>hi</div>") }
+
+    assert_nothing_raised { 10.times { post_as_bot "ok" } }
+  end
+
+  test "the cooldown starts from the message over the limit, and the limit counts from there" do
+    10.times { post_as_bot "ok" }
+    assert_raises(Bot::CoolingDown) { post_as_bot "over" }
+
+    assert_not_nil @bot.reload.cooldown_until
+    assert_in_delta 30, @bot.cooldown_until - Time.current, 1
+  end
+
+  test "five attempts during the cooldown suspend the bot, and the attempt after them is forbidden" do
+    10.times { post_as_bot "ok" }
+    assert_raises(Bot::CoolingDown) { post_as_bot "over" }
+
+    4.times { assert_raises(Bot::CoolingDown) { post_as_bot "during" } }
+    assert_not @bot.reload.suspended?
+
+    # The fifth attempt during the cooldown is refused as a cooldown, and it's the one that suspends the bot.
+    assert_raises(Bot::CoolingDown) { post_as_bot "fifth" }
+    assert @bot.reload.suspended?
+    assert_equal "flooding", @bot.suspension_reason
+
+    assert_raises(Bot::Suspended) { post_as_bot "sixth" }
+  end
+
+  test "the attempts during a cooldown are counted from its start, so an earlier cooldown's attempts don't carry over" do
+    10.times { post_as_bot "ok" }
+    assert_raises(Bot::CoolingDown) { post_as_bot "over" }
+    4.times { assert_raises(Bot::CoolingDown) { post_as_bot "during" } }
+
+    travel_by 31.seconds
+    10.times { post_as_bot "ok again" }
+    assert_raises(Bot::CoolingDown) { post_as_bot "over again" }
+    4.times { assert_raises(Bot::CoolingDown) { post_as_bot "during again" } }
+
+    assert_not @bot.reload.suspended?
+  end
+
+  test "a suspended bot can't post at all" do
+    @bot.suspend!(:flooding)
+
+    assert_no_difference -> { Message.count } do
+      assert_raises(Bot::Suspended) { post_as_bot "Hello" }
+    end
+  end
+
+  test "a bot's posts are refused only while it's cooling down, not for other bots" do
+    other = Bot.create!(name: "Other Bot", creator: users(:david), join_all_open_rooms: true)
+    10.times { post_as_bot "ok" }
+    assert_raises(Bot::CoolingDown) { post_as_bot "over" }
+
+    assert_nothing_raised { other.post_text(@room, "Hello from elsewhere") }
+  end
+
+  private
+    # Keeps microseconds, so the seconds left in a cooldown are exact rather than truncated.
+    def travel_by(duration)
+      travel_to Time.current + duration, with_usec: true
+    end
+
+    def post_as_bot(text, room: @room)
+      @bot.post_text(room, text)
+    end
+end
