+
+    assert_no_difference -> { Message.count } do
+      Bot::Webhook.new(@bot.reload, message).deliver
+    end
+    assert @bot.reload.cooldown_until.future?
+  end
+
+  test "webhook replies count towards the limit, so ten of them then an API post go over it" do
+    message = create_message_mentioning(@bot.user, " status?")
+
+    10.times do |i|
+      stub_webhook_answer status: 200, content_type: "text/plain", body: "Reply #{i}"
+      Bot::Webhook.new(@bot.reload, message).deliver
+    end
+    assert_equal 10, @bot.user.messages.count
+
+    assert_raises(Bot::CoolingDown) { @bot.post_text(@room, "Over the limit") }
+  end
+
+  private
+    def create_message_mentioning(user, *parts)
+      Message.create!(room: @room, creator: @author, body: "<div>#{mention_attachment_for(user)}#{parts.join}</div>")
+    end
+
+    def stub_webhook_answer(status:, content_type:, body:, headers: {})
+      response_headers = headers.merge(content_type ? { "Content-Type" => content_type } : {})
+
+      stub_request(:post, WEBHOOK_URL).to_return(status: status, headers: response_headers, body: body)
+    end
+end
diff --git a/test/models/bot_test.rb b/test/models/bot_test.rb
