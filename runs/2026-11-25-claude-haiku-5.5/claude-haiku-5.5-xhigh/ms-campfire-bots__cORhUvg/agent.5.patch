+require "test_helper"
+
+class Bot::SuspendableTest < ActiveSupport::TestCase
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://hooks.example.com/deploy")
+  end
+
+  test "a new bot isn't suspended" do
+    assert_not @bot.suspended?
+    assert_nil @bot.suspension_reason_text
+  end
+
+  test "suspending a bot records the reason, and the reason is shown as text" do
+    @bot.suspend!(:flooding)
+
+    assert @bot.reload.suspended?
+    assert_equal "flooding", @bot.suspension_reason
+    assert_match(/\AFlooding: it posted more than 10 messages/, @bot.suspension_reason_text)
+  end
+
+  test "suspending a bot keeps its rooms, its messages and its bot key" do
+    room = rooms(:hq)
+    room.memberships.grant_to(@bot.user)
+    message = room.messages.create!(creator: @bot.user, body: "<div>Before</div>")
+    bot_key = @bot.bot_key
+
+    @bot.suspend!(:failing_webhook)
+
+    assert_includes room.reload.users, @bot.user
+    assert_equal message, @bot.user.messages.find(message.id)
+    assert_equal bot_key, @bot.reload.bot_key
+  end
+
+  test "ten failed deliveries in a row suspend the bot, and nine don't" do
+    9.times { @bot.record_webhook_failure }
+    assert_not @bot.reload.suspended?
+
+    @bot.record_webhook_failure
+
+    assert @bot.reload.suspended?
+    assert_equal "failing_webhook", @bot.suspension_reason
+    assert_match(/failed 10 times in a row/, @bot.suspension_reason_text)
+  end
+
+  test "a successful delivery resets the count of failed deliveries" do
+    9.times { @bot.record_webhook_failure }
+    @bot.record_webhook_success
+
+    9.times { @bot.record_webhook_failure }
+
+    assert_not @bot.reload.suspended?
+    assert_equal 9, @bot.consecutive_webhook_failures
+  end
+
+  test "failed deliveries are counted against the bot's latest state, not a stale copy of it" do
+    stale = Bot.find(@bot.id)
+    9.times { @bot.record_webhook_failure }
+
+    stale.record_webhook_failure
+
+    assert stale.reload.suspended?
+    assert_equal 10, stale.consecutive_webhook_failures
+  end
+
+  test "reactivating a bot clears the suspension and the counts behind it" do
+    10.times { @bot.record_webhook_failure }
+    assert @bot.reload.suspended?
+
+    @bot.reactivate!
+
+    assert_not @bot.reload.suspended?
+    assert_nil @bot.suspension_reason
+    assert_nil @bot.suspension_reason_text
+    assert_equal 0, @bot.consecutive_webhook_failures
+    assert_nil @bot.cooldown_until
+    assert_equal 0, @bot.cooldown_attempts
+  end
+
+  test "reactivating through a copy of the bot loaded before the suspension still clears it" do
+    stale = Bot.find(@bot.id)
+    10.times { @bot.record_webhook_failure }
+    assert @bot.reload.suspended?
+
+    stale.reactivate!
+
+    assert_not @bot.reload.suspended?
+    assert_equal 0, @bot.consecutive_webhook_failures
+  end
+
+  test "a reactivated bot can post again" do
+    room = rooms(:hq)
+    room.memberships.grant_to(@bot.user)
+    @bot.suspend!(:flooding)
+
+    @bot.reactivate!
+
+    assert_difference -> { room.messages.count }, +1 do
+      @bot.post_text(room, "Back again")
+    end
+  end
+
+  test "suspended bots are left out of the bots that get webhooks" do
+    assert_includes Bot.receiving_webhooks, @bot
+
+    @bot.suspend!(:flooding)
+
+    assert_not_includes Bot.receiving_webhooks, @bot
+    assert_not_includes Bot.not_suspended, @bot
+  end
+
+  test "a suspended bot still counts towards its owner's bot limit" do
+    @bot.suspend!(:flooding)
+
+    assert_equal 1, Bot.created_by(users(:david)).count
+  end
+end
