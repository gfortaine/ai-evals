@@ -363,6 +363,153 @@ class Bot::WebhookTest < ActiveSupport::TestCase
     end
   end
 
+  test "a 2xx answer that posts nothing is still a successful delivery, which resets the failures" do
+    @bot.update!(consecutive_webhook_failures: 9)
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_webhook_answer status: 204, content_type: nil, body: nil
+
+    Bot::Webhook.new(@bot, message).deliver
+
+    assert_equal 0, @bot.reload.consecutive_webhook_failures
+  end
+
+  test "any 2xx counts as a successful delivery, even one that isn't a reply" do
+    message = create_message_mentioning(@bot.user, " status?")
+
+    [ 201, 202, 203, 205 ].each do |status|
+      @bot.update!(consecutive_webhook_failures: 5)
+      stub_webhook_answer status: status, content_type: "text/plain", body: "Queued"
+
+      Bot::Webhook.new(@bot, message).deliver
+
+      assert_equal 0, @bot.reload.consecutive_webhook_failures, "#{status} should count as a success"
+    end
+  end
+
+  test "a response that isn't 2xx is a failed delivery" do
+    message = create_message_mentioning(@bot.user, " status?")
+
+    [ 302, 400, 404, 500, 503 ].each_with_index do |status, index|
+      stub_webhook_answer status: status, content_type: "text/plain", body: "No"
+
+      Bot::Webhook.new(@bot, message).deliver
+
+      assert_equal index + 1, @bot.reload.consecutive_webhook_failures, "#{status} should count as a failure"
+    end
+  end
+
+  test "a timeout and a connection error are failed deliveries" do
+    message = create_message_mentioning(@bot.user, " status?")
+
+    stub_request(:post, WEBHOOK_URL).to_timeout
+    Bot::Webhook.new(@bot, message).deliver
+    assert_equal 1, @bot.reload.consecutive_webhook_failures
+
+    stub_request(:post, WEBHOOK_URL).to_raise(Errno::ECONNREFUSED)
+    Bot::Webhook.new(@bot, message).deliver
+    assert_equal 2, @bot.reload.consecutive_webhook_failures
+  end
+
+  test "a webhook at an address that's refused counts as a failed delivery" do
+    RestrictedHTTP::PrivateNetworkGuard.unstub(:resolve)
+    @bot.update!(webhook_url: "http://127.0.0.1:9000/hook")
+    message = create_message_mentioning(@bot.user, " status?")
+
+    Bot::Webhook.new(@bot, message).deliver
+
+    assert_equal 1, @bot.reload.consecutive_webhook_failures
+  end
+
+  test "a delivery that isn't made, because the bot isn't in the room, isn't a failure" do
+    message = create_message_mentioning(@bot.user, " status?")
+    @room.memberships.where(user: @bot.user).delete_all
+
+    Bot::Webhook.new(@bot, message).deliver
+
+    assert_equal 0, @bot.reload.consecutive_webhook_failures
+  end
+
+  test "ten failed deliveries in a row suspend the bot, and no webhook is sent afterwards" do
+    message = create_message_mentioning(@bot.user, " status?")
+    stub_request(:post, WEBHOOK_URL).to_return(status: 500)
+
+    10.times { Bot::Webhook.new(@bot.reload, message).deliver }
+
+    assert @bot.reload.suspended?
+    assert_equal "failing_webhook", @bot.suspension_reason
+
+    assert_not_requested :post, WEBHOOK_URL do
+      Bot::Webhook.new(@bot.reload, message).deliver
+    end
+  end
+
+  test "a successful delivery in between failures keeps the bot from being suspended" do
+    message = create_message_mentioning(@bot.user, " status?")
+
+    9.times do
+      stub_webhook_answer status: 500, content_type: "text/plain", body: "Oops"
+      Bot::Webhook.new(@bot.reload, message).deliver
+    end
+    stub_webhook_answer status: 204, content_type: nil, body: nil
+    Bot::Webhook.new(@bot.reload, message).deliver
+    9.times do
+      stub_webhook_answer status: 500, content_type: "text/plain", body: "Oops"
+      Bot::Webhook.new(@bot.reload, message).deliver
+    end
+
+    assert_not @bot.reload.suspended?
+  end
+
+  test "a suspended bot receives no mention and no joined event" do
+    message = create_message_mentioning(@bot.user, " status?")
+    @bot.suspend!(:flooding)
+
+    assert_not_requested :post, WEBHOOK_URL do
+      Bot::Webhook.new(@bot.reload, message).deliver
+      Bot::Webhook.new(@bot.reload, @room).deliver
+    end
+  end
+
+  test "webhook replies refused for a cooldown aren't posted, and five of them suspend the bot like any other attempts" do
+    message = create_message_mentioning(@bot.user, " status?")
+    10.times { @bot.post_text(@room, "Earlier") }
+    assert_raises(Bot::CoolingDown) { @bot.post_text(@room, "Over the limit") }
+    stub_webhook_answer status: 200, content_type: "text/plain", body: "Too late"
+
+    assert_no_difference -> { Message.count } do
+      4.times { Bot::Webhook.new(@bot.reload, message).deliver }
+    end
+    assert_not @bot.reload.suspended?
+
+    Bot::Webhook.new(@bot.reload, message).deliver
+
+    assert @bot.reload.suspended?
+    assert_equal "flooding", @bot.suspension_reason
+  end
+
+  test "a webhook reply that goes over the limit starts the cooldown, and isn't posted" do
+    message = create_message_mentioning(@bot.user, " status?")
+    10.times { @bot.post_text(@room, "Earlier") }
+    stub_webhook_answer status: 200, content_type: "text/plain", body: "One more"
+
+    assert_no_difference -> { Message.count } do
+      Bot::Webhook.new(@bot.reload, message).deliver
+    end
+    assert @bot.reload.cooldown_until.future?
+  end
+
+  test "webhook replies count towards the limit, so ten of them then an API post go over it" do
+    message = create_message_mentioning(@bot.user, " status?")
+
+    10.times do |i|
+      stub_webhook_answer status: 200, content_type: "text/plain", body: "Reply #{i}"
+      Bot::Webhook.new(@bot.reload, message).deliver
+    end
+    assert_equal 10, @bot.user.messages.count
+
+    assert_raises(Bot::CoolingDown) { @bot.post_text(@room, "Over the limit") }
+  end
+
   private
     def create_message_mentioning(user, *parts)
       Message.create!(room: @room, creator: @author, body: "<div>#{mention_attachment_for(user)}#{parts.join}</div>")
