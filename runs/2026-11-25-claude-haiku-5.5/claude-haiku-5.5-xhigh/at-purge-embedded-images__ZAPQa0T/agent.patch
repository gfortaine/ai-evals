diff --git a/test/controllers/action_text/markdown/uploads_controller_test.rb b/test/controllers/action_text/markdown/uploads_controller_test.rb
index 48141c1..45b694c 100644
--- a/test/controllers/action_text/markdown/uploads_controller_test.rb
+++ b/test/controllers/action_text/markdown/uploads_controller_test.rb
@@ -31,4 +31,21 @@ class ActionText::Markdown::UploadsControllerTest < ActionDispatch::IntegrationT
     assert_response :redirect
     assert_match /\/rails\/active_storage\/.*\/reading\.webp/, @response.redirect_url
   end
+
+  test "fetch a file that was just uploaded" do
+    post action_text_markdown_uploads_path, params: {
+      record_gid: pages(:welcome).to_signed_global_id.to_s,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+    assert_response :success
+
+    get JSON.parse(response.body)["fileUrl"]
+    assert_response :redirect
+
+    follow_redirect!
+    assert_response :ok
+    assert_equal "image/webp", response.media_type
+    assert_equal file_fixture("reading.webp").binread, response.body.b
+  end
 end
diff --git a/test/models/leaf/editable_test.rb b/test/models/leaf/editable_test.rb
index b654642..0f63e7f 100644
--- a/test/models/leaf/editable_test.rb
+++ b/test/models/leaf/editable_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class Leaf::EditableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
   test "editing a leafable records the edit" do
     leaves(:welcome_page).edit leafable_params: { body: "New body" }
 
@@ -63,4 +65,37 @@ class Leaf::EditableTest < ActiveSupport::TestCase
     assert leaves(:welcome_page).edits.last.trash?
     assert_equal "This is _such_ a great handbook.", leaves(:welcome_page).edits.last.page.body.content
   end
+
+  test "destroying a leaf purges the images embedded in its earlier revisions" do
+    leaf = leaves(:welcome_page)
+    leaf.leafable.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    attachment = leaf.leafable.body.uploads.attachments.last
+    blob = attachment.blob
+
+    leaf.edit leafable_params: { body: "New body" }
+    revision = leaf.edits.last
+    assert revision.revision?
+
+    perform_enqueued_jobs { leaf.destroy! }
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+    assert_not Page.exists?(revision.leafable_id)
+  end
+
+  test "destroying a trashed leaf purges the images embedded in its page" do
+    leaf = leaves(:welcome_page)
+    leaf.leafable.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    attachment = leaf.leafable.body.uploads.attachments.last
+    blob = attachment.blob
+
+    leaf.trashed!
+
+    perform_enqueued_jobs { leaf.reload.destroy! }
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
 end
