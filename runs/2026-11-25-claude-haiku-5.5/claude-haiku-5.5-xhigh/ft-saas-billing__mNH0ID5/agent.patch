+  test "publishing is refused when out of cards and the card stays a draft" do
+    sign_in_as :mike
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+
+    post card_publish_path(@draft, script_name: @slug)
+
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+  end
+
+  test "publishing is allowed while cards remain" do
+    sign_in_as :mike
+    @account.override_limits(card_count: 999, bytes_used: nil)
+
+    post card_publish_path(@draft, script_name: @slug)
+
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+
+  test "publishing is allowed on a paid plan even past the free card count" do
+    sign_in_as :mike
+    @account.comp
+    @account.override_limits(card_count: 5_000, bytes_used: nil)
+
+    post card_publish_path(@draft, script_name: @slug)
+
+    assert @draft.reload.published?
+  end
+
+  test "creating a card through the API is refused when out of cards" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 100)
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @slug),
+        params: { card: { title: "Blocked" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "creating a card through the API works while cards remain" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 100)
+    @account.override_limits(card_count: 999, bytes_used: nil)
+
+    assert_difference -> { Card.count }, 1 do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @slug),
+        params: { card: { title: "Allowed" } }, as: :json
+    end
