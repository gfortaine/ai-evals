index 0000000..803a632
--- /dev/null
+++ b/saas/test/controllers/admin/accounts/overrides_controller_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Admin::Accounts::OverridesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "override sets the card count and bytes used" do
+    sign_in_as :david
+
+    untenanted { post saas.admin_account_override_path(@account), params: { card_count: "123", bytes_used: "4096" } }
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: "")
+    limit = @account.reload.overridden_limit
+    assert_equal 123, limit.card_count
+    assert_equal 4096, limit.bytes_used
+    assert_equal 123, @account.effective_card_count
+  end
+
+  test "override with a blank field leaves that field measured" do
+    sign_in_as :david
+
+    untenanted { post saas.admin_account_override_path(@account), params: { card_count: "", bytes_used: "4096" } }
+
+    assert_nil @account.reload.overridden_limit.card_count
+    assert_equal 4096, @account.effective_bytes_used
+  end
+
+  test "invalid input is refused with a message and nothing is stored" do
+    sign_in_as :david
+
+    untenanted { post saas.admin_account_override_path(@account), params: { card_count: "lots", bytes_used: "" } }
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: "")
+    assert flash[:alert].present?
+    assert_nil @account.reload.overridden_limit
+  end
+
+  test "reset drops the override" do
+    sign_in_as :david
+    untenanted { post saas.admin_account_override_path(@account), params: { card_count: "123" } }
+
+    untenanted { delete saas.admin_account_override_path(@account) }
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: "")
+    assert_nil @account.reload.overridden_limit
+  end
+
+  test "non-staff can't override limits" do
+    sign_in_as :jz
+
+    untenanted { post saas.admin_account_override_path(@account), params: { card_count: "1" } }
+
+    assert_response :forbidden
+    assert_nil @account.reload.overridden_limit
+  end
+end
