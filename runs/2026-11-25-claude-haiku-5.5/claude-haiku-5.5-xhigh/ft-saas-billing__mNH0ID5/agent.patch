+<% @page_title = "Upgrade" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <div class="flex flex-column gap">
+      <p class="margin-none">This account is on the <strong><%= @current_plan.name %></strong> plan.</p>
+
+      <% if @subscription %>
+        <p class="margin-none">Change or cancel your subscription in billing.</p>
+        <%= button_to "Manage billing", saas.account_billing_portal_path(script_name: Current.account.slug), method: :post, class: "btn",
+              form: { data: { turbo: false } } %>
+      <% else %>
+        <% @plans.each do |plan| %>
+          <div class="flex flex-column gap-half">
+            <h2 class="txt-medium margin-none"><%= plan.name %> &middot; <%= plan.price_label %></h2>
+            <div class="txt-small txt-ink-medium"><%= plan.card_allowance %> &middot; <%= plan.storage_allowance %> storage</div>
+            <%= button_to "Upgrade to #{plan.name}", saas.account_checkout_path(plan: plan.key, script_name: Current.account.slug), method: :post, class: "btn",
+                  form: { data: { turbo: false } } %>
+          </div>
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+</section>
