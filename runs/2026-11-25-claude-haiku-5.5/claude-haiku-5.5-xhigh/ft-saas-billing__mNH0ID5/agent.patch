+<% @page_title = @account.name %>
+<% plan = @account.current_plan %>
+<% overridden = @account.overridden_limit %>
+
+<% content_for :header do %>
+  <h1 class="header__title">
+    <%= link_to "Accounts", saas.admin_accounts_path, class: "txt-link" %> / <%= @account.name %>
+  </h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Plan</h2>
+    </header>
+
+    <ul class="list-unindented">
+      <li>Account <strong>#<%= @account.external_account_id %></strong></li>
+      <li>Plan <strong><%= plan.name %></strong><% if plan.paid? %> (<%= plan.price_label %>)<% end %></li>
+      <li>Comped <strong><%= @account.comped? ? "Yes" : "No" %></strong></li>
+    </ul>
+
+    <div class="flex gap-half">
+      <%= button_to "Comp", saas.admin_account_comp_path(@account), method: :post, class: "btn",
+            disabled: @account.comped? %>
+      <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn",
+            disabled: !@account.comped? %>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Limits</h2>
+    </header>
+
+    <ul class="list-unindented">
+      <li>
+        Cards <strong><%= number_with_delimiter(@account.effective_card_count) %></strong>
+        of <%= @account.card_limit ? number_with_delimiter(@account.card_limit) : "unlimited" %>
+        <% if overridden&.card_count %>(overridden; measured <%= number_with_delimiter(@account.cards.published.count) %>)<% end %>
+      </li>
+      <li>
+        Bytes used <strong><%= number_to_human_size(@account.effective_bytes_used) %></strong>
+        of <%= number_to_human_size(@account.storage_limit) %>
+        <% if overridden&.bytes_used %>(overridden; measured <%= number_to_human_size(@account.bytes_used) %>)<% end %>
+      </li>
+    </ul>
+
+    <%= form_with url: saas.admin_account_override_path(@account), method: :post, class: "flex flex-column gap-half" do %>
+      <%= label_tag :card_count, "Card count" %>
+      <%= number_field_tag :card_count, overridden&.card_count, min: 0, class: "input" %>
+
+      <%= label_tag :bytes_used, "Bytes used" %>
+      <%= number_field_tag :bytes_used, overridden&.bytes_used, min: 0, class: "input" %>
+
+      <div class="flex gap-half">
+        <%= button_tag "Override", type: "submit", class: "btn" %>
+      </div>
+    <% end %>
+
+    <%= button_to "Reset", saas.admin_account_override_path(@account), method: :delete, class: "btn" %>
+  </div>
+</section>
