diff --git a/saas/test/controllers/account/billing_portals_controller_test.rb b/saas/test/controllers/account/billing_portals_controller_test.rb
new file mode 100644
index 0000000..6546401
--- /dev/null
+++ b/saas/test/controllers/account/billing_portals_controller_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Account::BillingPortalsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "admins are sent to the Stripe billing portal for their customer" do
+    AccountSubscription.create!(
+      account: @account, plan_key: "unlimited", stripe_customer_id: "cus_portal",
+      stripe_subscription_id: "sub_portal", status: "active"
+    )
+    Stripe::BillingPortal::Session.expects(:create)
+      .with(has_entries(customer: "cus_portal"))
+      .returns(stub(url: "https://billing.stripe.com/p/session/portal"))
+    sign_in_as :mike
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to "https://billing.stripe.com/p/session/portal"
+    assert_response :see_other
+  end
+
+  test "an account with no Stripe customer is sent to upgrade instead" do
+    Stripe::BillingPortal::Session.expects(:create).never
+    sign_in_as :mike
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to saas.account_upgrade_path(script_name: @account.slug)
+    assert_equal "Subscribe to a plan to manage billing", flash[:alert]
+  end
+
+  test "members can't open billing" do
+    Stripe::BillingPortal::Session.expects(:create).never
+    sign_in_as :jz
+
+    post saas.account_billing_portal_path(script_name: accounts(:"37s").slug)
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/account/checkouts_controller_test.rb b/saas/test/controllers/account/checkouts_controller_test.rb
new file mode 100644
index 0000000..de5ff6d
--- /dev/null
+++ b/saas/test/controllers/account/checkouts_controller_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Account::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    Plan::UNLIMITED.stubs(:stripe_price_id).returns("price_unlimited")
+    Plan::UNLIMITED_PLUS.stubs(:stripe_price_id).returns("price_unlimited_plus")
+  end
+
+  test "admins are sent to Stripe Checkout for the chosen plan" do
+    Stripe::Checkout::Session.expects(:create).with(has_entries(
+      mode: "subscription",
+      line_items: [ { price: "price_unlimited_plus", quantity: 1 } ],
+      client_reference_id: @account.id,
+      metadata: { account_id: @account.id }
+    )).returns(stub(url: "https://checkout.stripe.com/c/pay/cs_test_plus"))
+    sign_in_as :mike
+
+    post saas.account_checkout_path(plan: "unlimited_plus", script_name: @account.slug)
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_plus"
+    assert_response :see_other
+  end
+
+  test "an existing Stripe customer is reused" do
+    AccountSubscription.create!(
+      account: @account, plan_key: "unlimited", stripe_customer_id: "cus_existing",
+      stripe_subscription_id: "sub_old", status: "canceled"
+    )
+    Stripe::Checkout::Session.expects(:create).with(has_entry(customer: "cus_existing")).returns(stub(url: "https://checkout.stripe.com/x"))
+    sign_in_as :mike
+
+    post saas.account_checkout_path(plan: "unlimited", script_name: @account.slug)
+
+    assert_response :see_other
+  end
+
+  test "members can't start checkout" do
+    Stripe::Checkout::Session.expects(:create).never
+    sign_in_as :jz
+
+    post saas.account_checkout_path(plan: "unlimited", script_name: accounts(:"37s").slug)
+
+    assert_response :forbidden
+  end
+
+  test "an unknown plan goes back to the upgrade page" do
+    Stripe::Checkout::Session.expects(:create).never
+    sign_in_as :mike
+
+    post saas.account_checkout_path(plan: "free", script_name: @account.slug)
+
+    assert_redirected_to saas.account_upgrade_path(script_name: @account.slug)
+    assert_equal "Choose a plan to continue", flash[:alert]
+  end
+
+  test "an account that already subscribes is not sent to checkout again" do
+    AccountSubscription.create!(
+      account: @account, plan_key: "unlimited", stripe_customer_id: "cus_1",
+      stripe_subscription_id: "sub_1", status: "active"
+    )
+    Stripe::Checkout::Session.expects(:create).never
+    sign_in_as :mike
+
+    post saas.account_checkout_path(plan: "unlimited_plus", script_name: @account.slug)
+
+    assert_redirected_to saas.account_upgrade_path(script_name: @account.slug)
+    assert_match(/already has a subscription/, flash[:alert])
+  end
+
+  test "a plan with no configured price tells the admin to try again" do
+    Plan::UNLIMITED_PLUS.stubs(:stripe_price_id).returns(nil)
+    Stripe::Checkout::Session.expects(:create).never
+    sign_in_as :mike
+
+    post saas.account_checkout_path(plan: "unlimited_plus", script_name: @account.slug)
+
+    assert_redirected_to saas.account_upgrade_path(script_name: @account.slug)
+    assert_equal "We couldn't start checkout. Please try again.", flash[:alert]
+  end
+
+  test "a Stripe error goes back to the upgrade page" do
+    Stripe::Checkout::Session.stubs(:create).raises(Stripe::APIConnectionError.new("down"))
+    sign_in_as :mike
+
+    post saas.account_checkout_path(plan: "unlimited", script_name: @account.slug)
+
+    assert_redirected_to saas.account_upgrade_path(script_name: @account.slug)
+    assert_equal "We couldn't start checkout. Please try again.", flash[:alert]
+  end
+end
diff --git a/saas/test/controllers/account/settings_plan_test.rb b/saas/test/controllers/account/settings_plan_test.rb
new file mode 100644
index 0000000..988b8af
--- /dev/null
+++ b/saas/test/controllers/account/settings_plan_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Account::SettingsPlanTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    Plan::UNLIMITED.stubs(:stripe_price_id).returns("price_unlimited")
+  end
+
+  test "admins see their plan and an upgrade link on a free account" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "h2", text: "Plan"
+    assert_select "strong", text: "Free"
+    assert_select "a[href=?]", saas_upgrade_path_for(@account), text: "Upgrade"
+    assert_select "button", text: "Manage billing", count: 0
+  end
+
+  test "admins on a subscription see manage billing instead of an upgrade link" do
+    AccountSubscription.create!(
+      account: @account, plan_key: "unlimited", stripe_customer_id: "cus_settings",
+      stripe_subscription_id: "sub_settings", status: "active"
+    )
+    sign_in_as :mike
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "strong", text: "Unlimited"
+    assert_select "strong", text: "$20/month"
+    assert_select "button", text: "Manage billing"
+    assert_select "a[href=?]", saas_upgrade_path_for(@account), count: 0
+  end
+
+  test "a comped account shows the plan it's granted" do
+    @account.comp
+    sign_in_as :mike
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_select "strong", text: "Unlimited"
+    assert_match "(comped)", response.body
+  end
+
+  test "members don't see the plan section" do
+    @account.users.create!(identity: identities(:jz), name: "JZ", role: :member, verified_at: Time.current)
+    sign_in_as :jz
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "h2", text: "Plan", count: 0
+  end
+
+  private
+    def saas_upgrade_path_for(account)
+      Fizzy::Saas::Engine.routes.url_helpers.account_upgrade_path(script_name: account.slug)
+    end
+end
