@@ -0,0 +1,25 @@
+class Account::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = Plan.find_paid(params[:plan])
+    return redirect_to saas.account_upgrade_path(script_name: Current.account.slug), alert: "Choose a plan to continue" unless plan
+
+    # A second Checkout would create a second subscription. Plan changes go through the portal.
+    if Current.account.active_subscription
+      return redirect_to saas.account_upgrade_path(script_name: Current.account.slug), alert: "This account already has a subscription. Manage it in billing."
+    end
+
+    checkout_url = StripeGateway.checkout_url(
+      account: Current.account,
+      plan: plan,
+      success_url: account_settings_url,
+      cancel_url: saas.account_upgrade_url(script_name: Current.account.slug)
+    )
+
+    redirect_to checkout_url, allow_other_host: true, status: :see_other
+  rescue StripeGateway::PlanUnavailable, Stripe::StripeError => error
+    Rails.error.report(error, handled: true)
+    redirect_to saas.account_upgrade_path(script_name: Current.account.slug), alert: "We couldn't start checkout. Please try again."
+  end
+end
