+<% plan = account.current_plan %>
+<% subscription = account.active_subscription %>
+
+<section class="settings__section">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <div>
+      This account is on the <strong><%= plan.name %></strong> plan<% if account.comped? && subscription.nil? %> (comped)<% end %>.
+    </div>
+  </header>
+
+  <ul class="list-unindented">
+    <li>
+      <% if plan.paid? %>
+        <strong><%= plan.price_label %></strong>
+      <% else %>
+        <strong>Free</strong>
+      <% end %>
+    </li>
+    <li><%= plan.card_allowance %><% unless plan.unlimited_cards? %> &middot; <%= number_with_delimiter(account.effective_card_count) %> used<% end %></li>
+    <li><%= plan.storage_allowance %> storage &middot; <%= number_to_human_size(account.effective_bytes_used) %> used</li>
+    <% if subscription&.cancel_at %>
+      <li>Cancels on <%= local_datetime_tag subscription.cancel_at, style: :date %></li>
+    <% elsif subscription&.current_period_end %>
+      <li>Renews on <%= local_datetime_tag subscription.current_period_end, style: :date %></li>
+    <% end %>
+  </ul>
+
+  <div class="flex gap-half">
+    <% if subscription %>
+      <%= button_to "Manage billing", saas.account_billing_portal_path(script_name: Current.account.slug), method: :post, class: "btn",
+            form: { data: { turbo: false } } %>
+    <% end %>
+
+    <% if plan != Plan::UNLIMITED_PLUS && subscription.nil? %>
+      <%= link_to "Upgrade", saas.account_upgrade_path(script_name: Current.account.slug), class: "btn btn--reversed" %>
+    <% end %>
+  </div>
+</section>
