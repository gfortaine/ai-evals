diff --git a/saas/test/controllers/admin/accounts/comps_controller_test.rb b/saas/test/controllers/admin/accounts/comps_controller_test.rb
new file mode 100644
index 0000000..783d836
--- /dev/null
+++ b/saas/test/controllers/admin/accounts/comps_controller_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Admin::Accounts::CompsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "comp grants the account the unlimited plan" do
+    sign_in_as :david
+
+    untenanted { post saas.admin_account_comp_path(@account) }
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: "")
+    assert @account.reload.comped?
+    assert_equal Plan::UNLIMITED, @account.current_plan
+  end
+
+  test "uncomp returns the account to its real plan" do
+    sign_in_as :david
+    @account.comp
+
+    untenanted { delete saas.admin_account_comp_path(@account) }
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: "")
+    assert_not @account.reload.comped?
+    assert_equal Plan::FREE, @account.current_plan
+  end
+
+  test "comping twice doesn't duplicate the comp" do
+    sign_in_as :david
+    untenanted { post saas.admin_account_comp_path(@account) }
+
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      untenanted { post saas.admin_account_comp_path(@account) }
+    end
+  end
+
+  test "non-staff can't comp" do
+    sign_in_as :jz
+
+    untenanted { post saas.admin_account_comp_path(@account) }
+
+    assert_response :forbidden
+    assert_not @account.reload.comped?
+  end
+end
diff --git a/saas/test/controllers/admin/accounts/overrides_controller_test.rb b/saas/test/controllers/admin/accounts/overrides_controller_test.rb
