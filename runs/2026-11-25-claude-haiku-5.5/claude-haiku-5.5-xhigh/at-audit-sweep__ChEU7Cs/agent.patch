diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..18f455b
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "show finds pages by title" do
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Welcome to The Handbook!/
+  end
+
+  test "show allows searching published books without being logged in" do
+    sign_out
+    get library_search_path, params: { q: "Welcome" }
+    assert_select "p", text: /no matches/i
+
+    books(:handbook).update!(published: true)
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Welcome to The Handbook!/
+  end
+
+  test "show does not find trashed pages" do
+    leaves(:welcome_page).trashed!
+
+    get library_search_path, params: { q: "Welcome to" }
+
+    assert_response :success
+    assert_select "p", text: /no matches/i
+  end
+
+  test "show does not return pages from books the user cannot read" do
+    books(:manual).press Page.new(body: "Restricted"), title: "Confidential plans"
+
+    get library_search_path, params: { q: "Confidential" }
+
+    assert_response :success
+    assert_select "p", text: /no matches/i
+    assert_not_in_body "Confidential plans"
+  end
+
+  test "show treats the term as data, not SQL" do
+    books(:manual).press Page.new(body: "Restricted"), title: "Confidential plans"
+
+    get library_search_path, params: { q: "x' or 1=1 or leaves.title like '" }
+
+    assert_response :success
+    assert_select "p", text: /no matches/i
+    assert_not_in_body "Confidential plans"
+  end
+
+  test "show returns matches for punctuation rather than an error" do
+    leaves(:summary_page).update!(title: "O'Brien's Notes")
+
+    get library_search_path, params: { q: "O'Brien" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /O'Brien's Notes/
+  end
+
+  test "show copes with quotes, backslashes and wildcards in the term" do
+    [ "\"", "\\", "'", "%_\\", "a' OR '1'='1" ].each do |term|
+      get library_search_path, params: { q: term }
+
+      assert_response :success
+    end
+  end
+
+  test "show matches a per cent sign literally" do
+    leaves(:summary_page).update!(title: "Save 50% off")
+
+    get library_search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_select "a.search__result", text: /Save 50% off/
+  end
+
+  test "show still finds a title containing a per cent sign by its text" do
+    leaves(:summary_page).update!(title: "Save 50% off")
+
+    get library_search_path, params: { q: "50%" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_select "a.search__result", text: /Save 50% off/
+  end
+
+  test "show matches an underscore literally" do
+    leaves(:summary_page).update!(title: "snake_case notes")
+
+    get library_search_path, params: { q: "_" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_select "a.search__result", text: /snake_case notes/
+  end
+end
