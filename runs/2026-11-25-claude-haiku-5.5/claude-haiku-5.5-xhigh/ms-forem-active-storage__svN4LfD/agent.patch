+        bytes = original.call(record, identifier)
+        record.update!(profile_image: jpeg_path.open) # a new picture, uploaded through the app
+        bytes
+      end
+
+      report = service.call
+
+      expect(report.skipped).to eq(1)
+      expect(user.reload.profile_image_file.download).to eq(jpeg_bytes)
+      expect(ActiveStorage::Blob.count).to eq(1)
+    end
+
+    it "does not attach a CarrierWave picture that changed while it was being read" do
+      user = create(:user).tap { |record| carrierwave_picture_only(record) }
+      service = described_class.new(output: output)
+      allow(service).to receive(:read_carrierwave_file).and_wrap_original do |original, record, identifier|
+        bytes = original.call(record, identifier)
+        record.update_column(:profile_image, "replaced-#{SecureRandom.hex(4)}.png")
+        bytes
+      end
+
+      report = service.call
+
+      expect(report.skipped).to eq(1)
+      expect(report.copied).to eq(0)
+      expect(user.reload.profile_image_file).not_to be_attached
+      expect(output.string).to include("skipped, changed while copying, run again: User #{user.id}")
+    end
+
+    context "with CarrierWave storing pictures in S3, through Fog" do
+      let(:credentials) do
+        { provider: "AWS", aws_access_key_id: "AKIDCOPY", aws_secret_access_key: "copy-secret", region: "us-east-1" }
+      end
+
+      around do |example|
+        Fog.mock!
+        Fog::Storage.new(credentials).put_bucket("copy-test-bucket")
+        ProfileImageUploader.storage :fog
+        ProfileImageUploader.fog_directory = "copy-test-bucket"
+        ProfileImageUploader.fog_credentials = credentials
+        example.run
+      ensure
+        ProfileImageUploader.storage :file
+        ProfileImageUploader.fog_directory = nil
+        ProfileImageUploader.fog_credentials = nil
+        Fog::Mock.reset
+        Fog.unmock!
+      end
+
+      it "copies the S3-stored picture into Active Storage" do
+        user = create(:user).tap { |record| carrierwave_picture_only(record) }
+
+        report = run_copy
+
+        expect(report.copied).to eq(1)
+        expect(user.reload.profile_image_file.download).to eq(png_bytes)
+      end
+
+      it "reports a picture missing from S3 as missing" do
+        user = create(:user).tap { |record| carrierwave_picture_only(record) }
+        user.update_column(:profile_image, "absent-#{SecureRandom.hex(4)}.png")
