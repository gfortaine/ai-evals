+namespace :profile_images do
+  desc "Copy profile pictures of users and organizations from CarrierWave into Active Storage. Safe to re-run."
+  task copy: :environment do
+    report = ProfileImages::CopyToActiveStorage.call
+
+    puts "Profile pictures: copied #{report.copied}, skipped #{report.skipped}, " \
+         "missing from CarrierWave #{report.missing}, failed #{report.failed}."
+
+    if report.failed.positive?
+      abort("#{report.failed} profile pictures failed to copy. Run this task again to retry them.")
+    end
+  end
+end
