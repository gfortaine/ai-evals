+require "rails_helper"
+
+RSpec.describe "Profile pictures stored in Active Storage" do
+  include ActiveSupport::Testing::TimeHelpers
+
+  let(:user) { create(:user) }
+  let(:png_path) { Rails.root.join("spec/fixtures/files/800x600.png") }
+  let(:uploaders) { [] }
+
+  after { uploaders.each(&:remove!) }
+
+  it "serves the picture from the URL stored on the record, long after a plain storage link would expire" do
+    url = user.profile_image_url
+
+    travel_to(1.year.from_now) do
+      get URI.parse(url).request_uri
+    end
+
+    expect(response).to have_http_status(:ok)
+    expect(response.body).to eq(user.profile_image_file.download)
+  end
+
+  it "serves the picture publicly and for caching, so a CDN in front of the app can keep it" do
+    get URI.parse(user.profile_image_url).path
+
+    expect(response.headers["Cache-Control"]).to include("public")
+    expect(response.headers["Cache-Control"]).to include("max-age")
+  end
+
+  it "returns the new picture's URL in the user JSON that the onboarding screen reads" do
+    sign_in user
+
+    put "/users/#{user.id}",
+        params: { user: { profile_image: Rack::Test::UploadedFile.new(png_path, "image/png") } },
+        headers: { "Accept" => "application/json" }
+
+    expect(response).to have_http_status(:ok)
+    expect(response.parsed_body.dig("user", "profile_image", "url")).to eq(user.reload.profile_image_url)
+  end
+
+  describe "across the deploy that moves a picture from CarrierWave to Active Storage" do
+    before do
+      # The picture as it was before Active Storage: in CarrierWave only.
+      user.profile_image_file.purge
+      uploader = ProfileImageUploader.new(user, :profile_image)
+      uploaders << uploader
+      File.open(png_path) { |file| uploader.store!(file) }
+      user.update_column(:profile_image, uploader.identifier)
+      user.reload
+    end
+
+    it "serves the same bytes from the copy as CarrierWave stored, and keeps the CarrierWave file" do
+      stored = ProfileImageUploader.new(user, :profile_image).tap do |uploader|
+        uploader.retrieve_from_store!(user.read_attribute(:profile_image))
+      end
+      expect(stored.read).to eq(File.binread(png_path))
+
+      ProfileImages::CopyToActiveStorage.call(models: [User], output: StringIO.new)
+
+      after_copy = URI.parse(user.reload.profile_image_url).path
+      expect(after_copy).to include("/rails/active_storage/blobs/proxy/")
+
+      get after_copy
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to eq(File.binread(png_path))
+      expect(stored.file.exists?).to be(true)
+    end
+  end
+end
