+require "rails_helper"
+
+RSpec.describe "Profile images tasks", type: :task do
+  before { Rake.application["profile_images:copy"].reenable }
+
+  describe "profile_images:copy" do
+    let(:user) { create(:user) }
+
+    before do
+      # Only in CarrierWave, as before Active Storage.
+      user.profile_image_file.purge
+      uploader = ProfileImageUploader.new(user, :profile_image)
+      Rails.root.join("spec/fixtures/files/800x600.png").open { |file| uploader.store!(file) }
+      user.update_column(:profile_image, uploader.identifier)
+    end
+
+    after { ProfileImageUploader.new(user, :profile_image).remove! }
+
+    it "copies the pictures and reports the counts" do
+      expect { Rake::Task["profile_images:copy"].invoke }.to output(
+        "Profile pictures: copied 1, skipped 0, missing from CarrierWave 0, failed 0.\n",
+      ).to_stdout
+
+      expect(user.reload.profile_image_file).to be_attached
+    end
+
+    it "exits with an error, so a re-run is prompted, when a picture fails to copy" do
+      allow(ActiveStorage::Blob).to receive(:create_and_upload!).and_raise(Errno::ECONNRESET)
+
+      expect { Rake::Task["profile_images:copy"].invoke }.to raise_error(SystemExit, /failed to copy/)
+        .and output(/failed: User #{user.id}/).to_stdout
+    end
+  end
+end
