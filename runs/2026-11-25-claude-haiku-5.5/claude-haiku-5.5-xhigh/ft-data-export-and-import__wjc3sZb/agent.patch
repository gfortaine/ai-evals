@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  include DataTransferTestHelper
+
+  setup do
+    @identity = identities(:mike)
+    @export = build_export_file
+  end
+
+  test "the import page needs sign in" do
+    untenanted do
+      get new_account_import_url
+    end
+
+    assert_response :redirect
+    assert_no_match "Import an account", response.body
+  end
+
+  test "the import page is shown to someone signed in" do
+    sign_in_as @identity
+
+    untenanted do
+      get new_account_import_url
+    end
+
+    assert_response :success
+    assert_select "input[type=file][name=?]", "account_import[file]"
+  end
+
+  test "uploading an export starts an import" do
+    sign_in_as @identity
+
+    assert_difference -> { Account::Import.count }, 1 do
+      assert_enqueued_with(job: Account::Import::ProcessJob) do
+        untenanted do
+          post account_imports_url, params: { account_import: { file: upload(@export) } }
+        end
+      end
+    end
+
+    import = Account::Import.last
+    assert_equal @identity, import.identity
+    assert import.pending?
+    assert_match "email you", flash[:notice]
+  end
+
+  test "an upload that isn't a zip file is refused" do
+    sign_in_as @identity
+
+    assert_no_difference -> { Account::Import.count } do
+      untenanted do
+        post account_imports_url, params: { account_import: { file: upload_text("not a zip") } }
+      end
+    end
+
+    assert_match "Choose a Fizzy account export", flash[:alert]
+  end
+
+  test "importing isn't offered on an instance that already has an account" do
+    sign_in_as @identity
+
+    with_multi_tenant_mode(false) do
+      Account.stubs(:none?).returns(false)
+
+      untenanted do
+        get new_account_import_url
+      end
+    end
+
+    assert_redirected_to session_menu_path(script_name: nil)
+  end
+
+  test "importing an account is refused when accounts aren't accepted" do
+    sign_in_as @identity
+
+    with_multi_tenant_mode(false) do
+      Account.stubs(:none?).returns(false)
+
+      assert_no_difference -> { Account::Import.count } do
+        untenanted do
+          post account_imports_url, params: { account_import: { file: upload(@export) } }
+        end
+      end
+    end
+
+    assert_redirected_to session_menu_path(script_name: nil)
+  end
+
+  test "a tenanted request to the import page is sent away from the account" do
+    sign_in_as identities(:david)
+
+    get new_account_import_url
+
+    assert_redirected_to root_url
+  end
+
+  private
+    def build_export_file
+      export = build_export(accounts(:"37s"), by: users(:kevin))
+      export_archive(export)
+    end
+
+    def upload(io)
+      Rack::Test::UploadedFile.new(io.path, "application/zip")
+    end
+
+    def upload_text(text)
+      file = Tempfile.new([ "not", ".zip" ])
+      file.write(text)
+      file.rewind
+      Rack::Test::UploadedFile.new(file.path, "application/zip")
+    end
+end
