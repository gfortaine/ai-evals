diff --git a/app/models/account/data_transfer/action_text/body_rewriter.rb b/app/models/account/data_transfer/action_text/body_rewriter.rb
new file mode 100644
index 0000000..b304381
--- /dev/null
+++ b/app/models/account/data_transfer/action_text/body_rewriter.rb
@@ -0,0 +1,66 @@
+# Points a rich text body at the records it was imported with.
+#
+# Attachments are referenced by signed global IDs. Those signatures only verify on the
+# instance that made them, so each reference is re-signed for the record's new ID. Links
+# to records in the account carry the account slug, so the slug is replaced too.
+class Account::DataTransfer::ActionText::BodyRewriter
+  ATTACHABLE_MODELS = %w[ ActiveStorage::Blob User ].freeze
+  GLOBAL_ID_FORMAT = %r{\Agid://[^/]+/([^/?]+)/([^/?]+)}
+
+  def initialize(importer)
+    @importer = importer
+  end
+
+  def rewrite(html)
+    fragment = Nokogiri::HTML5.fragment(html)
+    fragment.css("action-text-attachment[sgid]").each { |node| rewrite_attachment(node) }
+    fragment.css("a[href]").each { |node| rewrite_link(node) }
+    fragment.to_html
+  end
+
+  private
+    def rewrite_attachment(node)
+      model, old_id = target_of(node["sgid"])
+      return unless model.in?(ATTACHABLE_MODELS)
+
+      new_id = @importer.id_for(old_id)
+      node["sgid"] = model.constantize.new(id: new_id).attachable_sgid
+
+      rewrite_url(node, new_id) if model == "ActiveStorage::Blob" && node.key?("url")
+    end
+
+    # A picture's URL includes the account's slug and a signed reference to its blob, so it
+    # is built again from the imported blob. The blob is saved before rich text is imported.
+    def rewrite_url(node, blob_id)
+      blob = ::ActiveStorage::Blob.find_by(id: blob_id)
+
+      if blob
+        node["url"] = Rails.application.routes.url_helpers.rails_blob_path(blob, only_path: true, script_name: @importer.slug)
+      else
+        node.remove_attribute("url")
+      end
+    end
+
+    def rewrite_link(node)
+      old_prefix = @importer.old_slug
+      href = node["href"].to_s
+      return if old_prefix.blank?
+
+      if href == old_prefix || href.start_with?("#{old_prefix}/")
+        node["href"] = @importer.slug + href.delete_prefix(old_prefix)
+      end
+    end
+
+    # Reads which record a signed global ID points at, without checking its signature.
+    # That's safe here: the target is only used to look up the record in this import.
+    def target_of(sgid)
+      return unless sgid.is_a?(String) && sgid.include?("--")
+
+      payload = sgid.split("--", 2).first
+      global_id = JSON.parse(Base64.decode64(payload)).dig("_rails", "data").to_s
+      match = GLOBAL_ID_FORMAT.match(global_id)
+      [ match[1], match[2] ] if match
+    rescue JSON::ParserError, TypeError
+      nil
+    end
+end
