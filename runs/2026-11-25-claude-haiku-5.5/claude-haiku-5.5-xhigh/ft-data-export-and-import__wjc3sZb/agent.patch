diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..13f7065
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,107 @@
+# Reads a ZIP archive from a seekable IO, looking entries up through the central
+# directory. Entries can be read in any order, and nothing is loaded whole: an
+# archive of hundreds of gigabytes can be read through a window of a few megabytes.
+#
+# The archive comes from outside, so reads are bounded: an entry can't produce more
+# data than its header declares, and a line of text can't grow past MAX_LINE_SIZE.
+class ZipFile::Reader
+  CHUNK_SIZE = 64.kilobytes
+  MAX_LINE_SIZE = 64.megabytes
+
+  class MissingEntry < StandardError; end
+
+  # A read-only IO over one entry's uncompressed content.
+  class EntryIO
+    attr_reader :size
+
+    def initialize(entry, io)
+      @entry = entry
+      @io = io
+      @size = entry.uncompressed_size
+      rewind
+    end
+
+    # Follows IO#read: with a length, returns up to that many bytes, or nil at the end;
+    # without one, returns everything that remains. Fills outbuf when given.
+    def read(length = nil, outbuf = nil)
+      data = read_data(length)
+      outbuf ? outbuf.replace(data.to_s) : data
+    end
+
+    # Starts the entry again from its first byte, for consumers that need to read it twice.
+    def rewind
+      @extractor = @entry.extractor_from(@io)
+      @produced = 0
+      @buffer = String.new(encoding: Encoding::BINARY)
+      0
+    end
+
+    private
+      def read_data(length)
+        return "".b if length&.zero?
+
+        until (length && @buffer.bytesize >= length) || @extractor.eof?
+          @buffer << next_chunk
+        end
+
+        if length.nil?
+          @buffer.slice!(0..)
+        elsif @buffer.empty?
+          nil
+        else
+          @buffer.slice!(0, length)
+        end
+      end
+
+      def next_chunk
+        chunk = @extractor.extract(CHUNK_SIZE) or raise ZipKit::FileReader::ReadError, "Entry data ended early"
+
+        @produced += chunk.bytesize
+        raise ZipKit::FileReader::ReadError, "Entry data is longer than its header says" if @produced > @size
+
+        chunk
+      end
+  end
+
+  attr_reader :entries
+
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io).index_by(&:filename)
+  end
+
+  def names
+    entries.keys
+  end
+
+  def entry?(name)
+    entries.key?(name)
+  end
+
+  def open(name)
+    EntryIO.new(fetch(name), @io)
+  end
+
+  # Yields each line of a text entry, without its line ending.
+  def each_line(name)
+    pending = String.new(encoding: Encoding::BINARY)
+    io = open(name)
+
+    while (chunk = io.read(CHUNK_SIZE))
+      pending << chunk
+
+      while (newline = pending.index("\n"))
+        yield pending.slice!(0..newline).chomp
+      end
+
+      raise ZipKit::FileReader::ReadError, "A line is too long to be a record" if pending.bytesize > MAX_LINE_SIZE
+    end
+
+    yield pending unless pending.empty?
+  end
+
+  private
+    def fetch(name)
+      entries.fetch(name) { raise MissingEntry, name }
+    end
+end
diff --git a/app/models/zip_file/storage_io.rb b/app/models/zip_file/storage_io.rb
new file mode 100644
index 0000000..99d654f
--- /dev/null
+++ b/app/models/zip_file/storage_io.rb
@@ -0,0 +1,74 @@
+# A read-only, seekable IO over an object in an Active Storage service. Reads are served
+# by ranged requests through a small read-ahead window, so a ZIP archive is read in place
+# rather than downloaded first. Works with any service that supports download_chunk.
+class ZipFile::StorageIO
+  WINDOW_SIZE = 8.megabytes
+
+  attr_reader :size
+
+  def initialize(service, key, size)
+    @service = service
+    @key = key
+    @size = size
+    @position = 0
+    @window = "".b
+    @window_offset = 0
+  end
+
+  def tell
+    @position
+  end
+
+  def seek(offset, whence = IO::SEEK_SET)
+    @position = case whence
+    when IO::SEEK_CUR then @position + offset
+    when IO::SEEK_END then size + offset
+    else offset
+    end
+  end
+
+  # Follows IO#read; fills outbuf when given.
+  def read(length = nil, outbuf = nil)
+    data = read_data(length)
+    outbuf ? outbuf.replace(data.to_s) : data
+  end
+
+  private
+    def read_data(length)
+      if length.nil?
+        read_remaining
+      elsif length.zero?
+        "".b
+      elsif @position >= size
+        nil
+      else
+        read_window(length)
+      end
+    end
+
+    def read_remaining
+      data = "".b
+      while (chunk = read_data(WINDOW_SIZE))
+        data << chunk
+      end
+      data
+    end
+
+    def read_window(length)
+      fill_window(length) unless window_covers?(length)
+
+      data = @window.byteslice(@position - @window_offset, length)
+      @position += data.bytesize
+      data
+    end
+
+    def window_covers?(length)
+      @position >= @window_offset && @position + length <= @window_offset + @window.bytesize
+    end
+
+    def fill_window(length)
+      last = [ @position + [ length, WINDOW_SIZE ].max, size ].min - 1
+      @window = @service.download_chunk(@key, @position..last).b
+      @window_offset = @position
+    end
+end
