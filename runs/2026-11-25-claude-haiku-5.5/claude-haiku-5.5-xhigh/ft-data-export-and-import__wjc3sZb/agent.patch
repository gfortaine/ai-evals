diff --git a/app/models/account/export.rb b/app/models/account/export.rb
new file mode 100644
index 0000000..fc07396
--- /dev/null
+++ b/app/models/account/export.rb
@@ -0,0 +1,68 @@
+# A request for a copy of data, built in the background and kept for a day.
+#
+# A "account" export is everything in the account, and only admins can ask for one. A
+# "cards" export is the published cards the requester can see, with comments and files.
+class Account::Export < ApplicationRecord
+  EXPIRATION_TIME = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %w[ account cards ].index_by(&:itself), scopes: false
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), scopes: false
+
+  scope :expired, -> { where(expires_at: ...Time.current) }
+
+  class << self
+    def delete_expired
+      expired.find_each(&:destroy)
+    end
+  end
+
+  def build_later
+    Account::Export::BuildJob.perform_later(self)
+  end
+
+  def build_now
+    processing!
+
+    begin
+      Current.with_account(account) do
+        ZipFile.create_for(file, filename: archive_filename) do |zip|
+          archive.write_to(zip)
+        end
+      end
+    rescue StandardError => error
+      failed!
+      Rails.error.report(error, handled: true, severity: :error, context: { export_id: id })
+      ExportMailer.failed(self).deliver_later
+    else
+      update!(status: :completed, expires_at: EXPIRATION_TIME.from_now)
+      ExportMailer.ready(self).deliver_later
+    end
+  end
+
+  def downloadable?
+    completed? && file.attached? && expires_at.future?
+  end
+
+  def accessible_to?(person)
+    downloadable? && person == user && (!account? || person.admin?)
+  end
+
+  private
+    def archive
+      if account?
+        Account::DataTransfer::Exporter.new(account)
+      else
+        Account::Export::CardsArchive.new(user)
+      end
+    end
+
+    def archive_filename
+      name = account? ? account.name : user.name
+      "#{name.parameterize.presence || "fizzy"}-#{kind}-#{Date.current.iso8601}.zip"
+    end
+end
diff --git a/app/models/account/export/cards_archive.rb b/app/models/account/export/cards_archive.rb
new file mode 100644
index 0000000..2620c71
--- /dev/null
+++ b/app/models/account/export/cards_archive.rb
@@ -0,0 +1,105 @@
+# The cards a person can see, one JSON file per card, with its comments and every picture
+# and file attached to it. Each file is written once, however many cards it's attached to.
+class Account::Export::CardsArchive
+  def initialize(user)
+    @user = user
+  end
+
+  def write_to(zip)
+    @zip = zip
+    @written_files = Set.new
+
+    cards.find_each do |card|
+      zip.add_file("cards/#{card.number}.json", JSON.pretty_generate(card_json(card)))
+    end
+  end
+
+  private
+    def cards
+      @user.accessible_cards.published.includes(:board, :column, :tags, :steps, :creator, :assignees)
+    end
+
+    def card_json(card)
+      attachments = attachments_by_record(card)
+
+      {
+        number: card.number,
+        title: card.title,
+        board: card.board.name,
+        column: card.column&.name,
+        status: card.status,
+        closed: card.closed?,
+        postponed: card.postponed?,
+        golden: card.golden?,
+        due_on: card.due_on,
+        created_at: card.created_at.iso8601,
+        last_active_at: card.last_active_at.iso8601,
+        creator: person(card.creator),
+        assignees: card.assignees.map { person(it) },
+        tags: card.tags.map(&:title),
+        steps: card.steps.map { { content: it.content, completed: it.completed? } },
+        description: body(card.rich_text_description, attachments),
+        image: image_for(card, attachments),
+        comments: card.comments.chronologically.map { |comment| comment_json(comment, attachments) }
+      }
+    end
+
+    def comment_json(comment, attachments)
+      {
+        creator: person(comment.creator),
+        created_at: comment.created_at.iso8601,
+        body: body(comment.rich_text_body, attachments)
+      }
+    end
+
+    def body(rich_text, attachments)
+      return { html: nil, files: [] } unless rich_text
+
+      {
+        html: rich_text.read_attribute_before_type_cast(:body),
+        files: files_for(attachments.fetch(rich_text, []))
+      }
+    end
+
+    def image_for(card, attachments)
+      files_for(attachments.fetch(card, []).select { it.name == "image" }).first
+    end
+
+    def files_for(attachments)
+      attachments.map do |attachment|
+        write_file(attachment.blob)
+      end
+    end
+
+    def write_file(blob)
+      path = "files/#{blob.key}/#{blob.filename}"
+
+      unless @written_files.include?(blob.key)
+        @written_files << blob.key
+        @zip.add_file(path, compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+
+      { name: blob.filename.to_s, content_type: blob.content_type, byte_size: blob.byte_size, path: path }
+    end
+
+    # Attachments for a card and for its rich text bodies, keyed by the record they belong to.
+    def attachments_by_record(card)
+      rich_texts = ActionText::RichText.where(record: [ card, *card.comments ]).to_a
+      rich_texts_by_id = rich_texts.index_by(&:id)
+      attachments = ActiveStorage::Attachment.where(record: [ card, *rich_texts ]).includes(:blob).to_a
+
+      attachments.group_by do |attachment|
+        if attachment.record_type == "ActionText::RichText"
+          rich_texts_by_id[attachment.record_id]
+        else
+          card
+        end
+      end
+    end
+
+    def person(user)
+      { name: user.name, email: user.identity&.email_address }
+    end
+end
diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..b439e37
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,85 @@
+# A request to bring an account export back in as a new account.
+#
+# The archive is stored outside any account while the import runs, because the account
+# doesn't exist yet. The import either completes, or is rolled back completely and the
+# person who asked is emailed why.
+class Account::Import < ApplicationRecord
+  STALE_AFTER = 12.hours
+
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), scopes: false
+
+  scope :stale, -> { where(status: %w[ pending processing ]).where(updated_at: ...STALE_AFTER.ago) }
+
+  class << self
+    def create_from_upload!(identity:, io:)
+      key = ActiveStorage::Blob.generate_unique_secure_token
+      ActiveStorage::Blob.service.upload(key, io, checksum: nil)
+
+      create!(identity: identity, storage_key: key, byte_size: io.size)
+    end
+
+    # Imports that never finished, such as after a worker crashed, are rolled back.
+    def abandon_stale
+      stale.find_each do |import|
+        import.abandon("The import didn't finish, so nothing was kept. Please try again.")
+      end
+    end
+  end
+
+  def process_later
+    Account::Import::ProcessJob.perform_later(self)
+  end
+
+  def process_now
+    return unless pending?
+
+    processing!
+    importer = Account::DataTransfer::Importer.new(self)
+
+    begin
+      importer.import
+    rescue StandardError => error
+      importer.rollback
+      fail_with(error)
+    else
+      complete
+    end
+  end
+
+  def abandon(message)
+    Account::DataTransfer::Importer.new(self).rollback
+    fail_with(Account::DataTransfer::InvalidArchive.new(message))
+  end
+
+  private
+    def complete
+      completed!
+      discard_archive
+      ImportMailer.completed(self).deliver_later
+    end
+
+    def fail_with(error)
+      unless error.is_a?(Account::DataTransfer::InvalidArchive)
+        Rails.error.report(error, handled: true, severity: :error, context: { import_id: id })
+      end
+
+      update!(status: :failed, account: nil, error_message: error_message_for(error))
+      discard_archive
+      ImportMailer.failed(self).deliver_later
+    end
+
+    def error_message_for(error)
+      if error.is_a?(Account::DataTransfer::InvalidArchive)
+        error.message
+      else
+        "Something went wrong while importing the account, so nothing was kept. Please try again, or contact support if it keeps happening."
+      end
+    end
+
+    def discard_archive
+      ActiveStorage::Blob.service.delete(storage_key)
+    end
+end
