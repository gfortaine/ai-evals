+require "test_helper"
+
+class AccountDataTransferTest < ActionDispatch::IntegrationTest
+  include DataTransferTestHelper
+
+  test "an admin exports the account, is emailed a link, and downloads it" do
+    sign_in_as users(:kevin)
+
+    perform_enqueued_jobs do
+      post account_exports_url
+    end
+
+    export = Account::Export.where(kind: :account).last
+    assert export.completed?
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:kevin).email_address ], email.to
+    link = email.body.encoded[%r{https?://\S+/exports/\S+}]
+    assert link, "the email should link to the download"
+
+    get export_url(export)
+    assert_response :redirect
+    assert_match "active_storage", response.location
+  end
+
+  test "an export that was imported elsewhere comes back as a new account" do
+    export = build_export(accounts(:"37s"), by: users(:kevin))
+    archive = export_archive(export)
+
+    logout_and_sign_in_as identities(:mike)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post account_imports_url, params: { account_import: { file: Rack::Test::UploadedFile.new(archive.path, "application/zip") } }
+      end
+    end
+
+    import = Account::Import.order(:created_at).last
+    assert import.completed?
+    assert import.account.users.exists?(identity: identities(:mike), role: :owner)
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:mike).email_address ], email.to
+    assert_match "ready", email.subject
+  end
+end
