index 0000000..72ecb5c
--- /dev/null
+++ b/test/test_helpers/data_transfer_test_helper.rb
@@ -0,0 +1,73 @@
+module DataTransferTestHelper
+  MOON = Rails.root.join("test/fixtures/files/moon.jpg")
+
+  def build_export(account, by:, kind: :account)
+    export = Account::Export.create!(account: account, user: by, kind: kind)
+    export.build_now
+    assert export.reload.completed?, "expected the export to complete"
+    export
+  end
+
+  def export_archive(export)
+    tempfile = Tempfile.new([ "export", ".zip" ])
+    tempfile.binmode
+    tempfile.write(export.file.download)
+    tempfile.rewind
+    tempfile
+  end
+
+  def archive_names(io)
+    ZipFile::Reader.new(io).names
+  end
+
+  def archive_json(io, name)
+    JSON.parse(ZipFile::Reader.new(io).open(name).read.force_encoding(Encoding::UTF_8))
+  end
+
+  # Copies an archive, leaving out some entries and replacing the contents of others.
+  def rebuild_archive(io, skip: [], replace: {})
+    reader = ZipFile::Reader.new(io)
+    tempfile = Tempfile.new([ "rebuilt", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    reader.names.each do |name|
+      next if skip.include?(name)
+
+      if replace.key?(name)
+        writer.add_file(name, replace[name], compress: false)
+      else
+        writer.add_file(name, reader.open(name).read, compress: false)
+      end
+    end
+    writer.close
+
+    tempfile.rewind
+    tempfile
+  end
+
+  def import_archive(io, identity:)
+    import = Account::Import.create_from_upload!(identity: identity, io: io)
+    import.process_now
+    import.reload
+  end
+
+  def attach_image(card)
+    card.image.attach(io: File.open(MOON, "rb"), filename: "moon.jpg", content_type: "image/jpeg")
+    card.reload.image.blob
+  end
+
+  def image_blob
+    File.open(MOON, "rb") do |file|
+      ActiveStorage::Blob.create_and_upload!(io: file, filename: "moon.jpg", content_type: "image/jpeg")
+    end
+  end
+
+  # Adds a picture embedded in a card description, and a mention of a person in a comment.
+  def embed_picture_and_mention(card, mentioned:, commenter:)
+    blob = image_blob
+    card.update!(description: %(<p>See this</p><action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>))
+    comment = card.comments.create!(creator: commenter, body: %(<p>Hi <action-text-attachment sgid="#{mentioned.attachable_sgid}" content-type="text/html"></action-text-attachment></p>))
+    [ blob, comment ]
+  end
+end
