diff --git a/app/models/account/data_transfer/exporter.rb b/app/models/account/data_transfer/exporter.rb
new file mode 100644
index 0000000..898b004
--- /dev/null
+++ b/app/models/account/data_transfer/exporter.rb
@@ -0,0 +1,32 @@
+# Writes a whole account to a ZIP file: a header, one JSON Lines entry for each table,
+# and the bytes of every file. Every entry is streamed, so the account is never held in
+# memory.
+class Account::DataTransfer::Exporter
+  FORMAT = "fizzy-account-export".freeze
+  VERSION = 1
+  HEADER_PATH = "export.json".freeze
+
+  attr_reader :account
+
+  def initialize(account)
+    @account = account
+  end
+
+  def write_to(zip)
+    zip.add_file(HEADER_PATH, header.to_json)
+
+    Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+      record_set.export_to(zip)
+    end
+  end
+
+  private
+    def header
+      {
+        format: FORMAT,
+        version: VERSION,
+        exported_at: Time.current.iso8601,
+        account: { name: account.name, external_account_id: account.external_account_id }
+      }
+    end
+end
