+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include DataTransferTestHelper
+
+  setup do
+    @source = accounts(:"37s")
+    @admin = users(:kevin)
+  end
+
+  test "an export imports as a new account with the same boards, cards, comments, and people" do
+    export = build_export(@source, by: @admin)
+
+    import = import_archive(export_archive(export), identity: identities(:kevin))
+
+    assert import.completed?
+    account = import.account
+    assert_not_equal @source, account
+    assert_not_equal @source.external_account_id, account.external_account_id
+
+    assert_equal @source.name, account.name
+    assert_equal @source.cards_count, account.cards_count
+    assert_equal @source.boards.count, account.boards.count
+    assert_equal @source.cards.order(:number).pluck(:number), account.cards.order(:number).pluck(:number)
+    assert_equal Comment.where(account_id: @source.id).count, Comment.where(account_id: account.id).count
+    assert_equal @source.users.pluck(:name).sort, account.users.pluck(:name).sort
+  end
+
+  test "imported records belong to the new account, not the original" do
+    account = import_archive(export_archive(build_export(@source, by: @admin)), identity: identities(:kevin)).account
+
+    assert_empty Card.where(account_id: account.id).where(id: @source.cards.select(:id))
+    assert_equal account.id, Board.where(account_id: account.id).first.account_id
+  end
+
+  test "the person who imports owns the new account, even if they were a member in the export" do
+    account = import_archive(export_archive(build_export(@source, by: @admin)), identity: identities(:kevin)).account
+
+    assert account.users.find_by(identity: identities(:kevin)).owner?
+  end
+
+  test "a person who imports without being in the export becomes the owner of a new user" do
+    import = import_archive(export_archive(build_export(@source, by: @admin)), identity: identities(:mike))
+
+    assert import.completed?
+    owner = import.account.users.find_by(identity: identities(:mike))
+    assert owner.owner?
+    assert_equal users(:mike).name, owner.name
+    assert owner.verified?
+  end
+
+  test "people from the export who have no identity here get one" do
+    newcomer = Identity.create!(email_address: "newcomer@example.com")
+    User.create!(account: @source, identity: newcomer, name: "Newcomer", role: :member, verified_at: Time.current)
+    export = build_export(@source, by: @admin)
+
+    assert_difference -> { Identity.where(email_address: "newcomer@example.com").count }, 0 do
+      account = import_archive(export_archive(export), identity: identities(:kevin)).account
+      assert account.users.exists?(identity: newcomer)
+    end
+  end
+
+  test "importing an export twice makes two separate accounts" do
+    export = build_export(@source, by: @admin)
+    first = import_archive(export_archive(export), identity: identities(:kevin)).account
+    second = import_archive(export_archive(export), identity: identities(:kevin)).account
+
+    assert_not_equal first.id, second.id
+    assert_equal first.cards.count, second.cards.count
+    assert_equal @source.cards.count, Card.where(account_id: @source.id).count
+  end
+
+  test "pictures and files come through with their contents" do
+    card = cards(:logo)
+    attach_image(card)
+    original = card.image.download
+
+    account = import_archive(export_archive(build_export(@source, by: @admin)), identity: identities(:kevin)).account
+
+    imported = account.cards.find_by!(number: card.number)
+    assert imported.image.attached?
+    assert_equal original, imported.image.download
+    assert_equal account.id, imported.image.blob.account_id
+    assert_not_equal card.image.blob.key, imported.image.blob.key
+  end
+
+  test "pictures embedded in descriptions and mentions in comments point at the new records" do
+    card = cards(:logo)
+    blob, _comment = embed_picture_and_mention(card, mentioned: users(:jz), commenter: @admin)
+
+    account = import_archive(export_archive(build_export(@source, by: @admin)), identity: identities(:kevin)).account
+
+    imported_card = account.cards.find_by!(number: card.number)
+    embedded = imported_card.description.embeds.first
+    assert_equal account.id, embedded.blob.account_id
+    assert_equal blob.checksum, embedded.blob.checksum
+    assert_equal blob.download, embedded.blob.download
+
+    description_sgid = Nokogiri::HTML5.fragment(imported_card.description.body.to_html).at_css("action-text-attachment")["sgid"]
+    assert_equal embedded.blob, GlobalID::Locator.locate_signed(description_sgid, for: "attachable")
+
+    imported_comment = Comment.where(account_id: account.id).detect { it.body.body&.to_html.to_s.include?("action-text-attachment") }
+    mention_sgid = Nokogiri::HTML5.fragment(imported_comment.body.body.to_html).at_css("action-text-attachment")["sgid"]
+    mentioned = GlobalID::Locator.locate_signed(mention_sgid, for: "attachable")
+    assert_kind_of User, mentioned
+    assert_equal account.id, mentioned.account_id
+    assert_equal "JZ", mentioned.name
+  end
+
+  test "links to cards in the account point at the new account" do
+    card = cards(:logo)
+    card.comments.create!(creator: @admin, body: %(<p><a href="#{@source.slug}/cards/#{card.number}">see the logo card</a></p>))
+
+    account = import_archive(export_archive(build_export(@source, by: @admin)), identity: identities(:kevin)).account
+
+    imported = Comment.where(account_id: account.id).detect { it.body.body&.to_html.to_s.include?("see the logo card") }
+    assert imported, "the comment should have been imported"
+
+    html = imported.body.body.to_html
+    assert_includes html, %(href="#{account.slug}/cards/#{card.number}")
+    assert_not_includes html, @source.slug
+  end
+
+  test "imported publication links get new keys" do
+    board = boards(:writebook)
+    publication = Board::Publication.create!(board: board)
+
+    account = import_archive(export_archive(build_export(@source, by: @admin)), identity: identities(:kevin)).account
+
+    imported = Board::Publication.find_by!(board: account.boards.find_by!(name: board.name))
+    assert_not_equal publication.key, imported.key
+  end
+
+  test "imported cards are searchable" do
+    account = import_archive(export_archive(build_export(@source, by: @admin)), identity: identities(:kevin)).account
+
+    card = account.cards.published.first
+    assert Search::Record.for(account.id).exists?(searchable_type: "Card", searchable_id: card.id)
+  end
+
+  test "an imported account gets a join code of its own" do
+    account = import_archive(export_archive(build_export(@source, by: @admin)), identity: identities(:kevin)).account
+
+    assert account.join_code.present?
+    assert_not_equal @source.join_code.code, account.join_code.code
+  end
+
+  test "a completed import is kept even if the email about it can't be sent" do
+    import = Account::Import.create_from_upload!(identity: identities(:kevin), io: export_archive(build_export(@source, by: @admin)))
+    ImportMailer.stubs(:completed).raises(RuntimeError, "mail server unavailable")
+
+    assert_raises RuntimeError do
+      import.process_now
+    end
+
+    assert import.reload.completed?
+    assert import.account.present?
+  end
+
+  test "the imported account uses the same storage as the original" do
+    attach_image(cards(:logo))
+    embed_picture_and_mention(cards(:logo), mentioned: users(:jz), commenter: @admin)
+    original_bytes = @source.reload.bytes_used_exact
+    assert_operator original_bytes, :>, 0
+
+    account = import_archive(export_archive(build_export(@source, by: @admin)), identity: identities(:kevin)).account
+
+    assert_equal original_bytes, account.bytes_used_exact
+    assert_equal @source.boards.first.bytes_used_exact, account.boards.find_by!(name: @source.boards.first.name).bytes_used_exact
+  end
+
+  test "an empty account exports and imports" do
+    empty = Account.create_with_owner(account: { name: "Empty" }, owner: { name: "Owner", identity: identities(:mike) })
+    export = build_export(empty, by: empty.users.owner.first)
+
+    import = import_archive(export_archive(export), identity: identities(:mike))
+
+    assert import.completed?
+    assert_equal "Empty", import.account.name
+    assert_equal 0, import.account.cards.count
+    assert import.account.users.exists?(identity: identities(:mike))
+  end
+
+  test "the import emails the person who asked when it completes" do
+    import = Account::Import.create_from_upload!(identity: identities(:kevin), io: export_archive(build_export(@source, by: @admin)))
+
+    ImportMailer.expects(:completed).with(import).returns(stub(deliver_later: nil))
+
+    import.process_now
+  end
+
+  test "an import that isn't a zip file fails with a reason and keeps nothing" do
+    not_a_zip = Tempfile.new([ "bad", ".zip" ])
+    not_a_zip.write("hello")
+    not_a_zip.rewind
+
+    assert_nothing_left_behind do
+      import = import_archive(not_a_zip, identity: identities(:kevin))
+
+      assert import.failed?
+      assert_nil import.account
+      assert_equal "This isn't a valid Fizzy export", import.error_message
+    end
+  end
+
+  test "an export missing its data fails and nothing is left behind" do
+    attach_image(cards(:logo))
+    broken = rebuild_archive(export_archive(build_export(@source, by: @admin)), skip: [ "data/cards.jsonl" ])
+
+    assert_nothing_left_behind do
+      import = import_archive(broken, identity: identities(:kevin))
+
+      assert import.failed?
+      assert_equal "The export is missing data/cards.jsonl", import.error_message
+    end
+  end
+
+  test "an export missing a file fails and nothing is left behind" do
+    attach_image(cards(:logo))
+    export = build_export(@source, by: @admin)
+    file_entry = archive_names(export_archive(export)).find { it.start_with?("files/") }
+    broken = rebuild_archive(export_archive(export), skip: [ file_entry ])
+
+    assert_nothing_left_behind do
+      import = import_archive(broken, identity: identities(:kevin))
+
+      assert import.failed?
+      assert_match "missing", import.error_message
+    end
+  end
+
+  test "a file that doesn't match its checksum fails and nothing is left behind" do
+    attach_image(cards(:logo))
+    export = build_export(@source, by: @admin)
+    file_entry = archive_names(export_archive(export)).find { it.start_with?("files/") }
+    size = ZipFile::Reader.new(export_archive(export)).open(file_entry).size
+    corrupted = rebuild_archive(export_archive(export), replace: { file_entry => "x" * size })
+
+    assert_nothing_left_behind do
+      import = import_archive(corrupted, identity: identities(:kevin))
+
+      assert import.failed?
+      assert_match "checksum", import.error_message
+    end
+  end
+
+  test "an import that was interrupted is rolled back when it's found stale" do
+    import = Account::Import.create_from_upload!(identity: identities(:kevin), io: export_archive(build_export(@source, by: @admin)))
+    import.update!(status: :processing, updated_at: 13.hours.ago)
+    archive_key = import.storage_key
+
+    assert_nothing_left_behind do
+      Account::Import.abandon_stale
+    end
+
+    assert import.reload.failed?
+    assert_match "didn't finish", import.error_message
+    assert_not ActiveStorage::Blob.service.exist?(archive_key)
+  end
+
+  test "an import that is still running isn't touched" do
+    import = Account::Import.create_from_upload!(identity: identities(:kevin), io: export_archive(build_export(@source, by: @admin)))
+    import.update!(status: :processing)
+
+    Account::Import.abandon_stale
+
+    assert import.reload.processing?
+  end
+
+  test "processing an import later runs it in the background" do
+    import = Account::Import.create_from_upload!(identity: identities(:kevin), io: export_archive(build_export(@source, by: @admin)))
+
+    assert_enqueued_with(job: Account::Import::ProcessJob, args: [ import ]) do
+      import.process_later
+    end
+  end
+
+  private
+    # Checks that a failed import leaves the database and stored files as they were.
+    def assert_nothing_left_behind(&)
+      models = account_scoped_models
+      before = counts_for(models)
+      uploads = []
+      subscriber = ActiveSupport::Notifications.subscribe("service_upload.active_storage") { |*, payload| uploads << payload[:key] }
+
+      yield
+
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+      assert_equal before, counts_for(models), "a failed import should leave no records behind"
+
+      uploads.each do |key|
+        assert_not ActiveStorage::Blob.service.exist?(key), "stored file #{key} should have been removed"
+      end
+    end
+
+    def account_scoped_models
+      models = [ Account, Identity, Storage::Entry ]
+      Account::DataTransfer::Manifest.new(nil).each_record_set do |record_set|
+        models << record_set.model if record_set.model.column_names.include?("account_id")
+      end
+      models.uniq
+    end
+
+    def counts_for(models)
+      models.to_h { [ it.name || it.table_name, it.count ] }
+    end
+end
diff --git a/test/models/zip_file/reader_test.rb b/test/models/zip_file/reader_test.rb
new file mode 100644
index 0000000..3cb8716
--- /dev/null
+++ b/test/models/zip_file/reader_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class ZipFile::ReaderTest < ActiveSupport::TestCase
+  PATTERN = "\x00\x01\x02".b
+
+  setup do
+    @tempfile = Tempfile.new([ "archive", ".zip" ])
+    @tempfile.binmode
+
+    writer = ZipFile::Writer.new(@tempfile)
+    writer.add_file("notes.txt", "first line\nsecond line\n\nlast line without newline")
+    writer.add_file("images/photo.bin", PATTERN * 50_000, compress: false)
+    writer.close
+    @tempfile.flush
+    @tempfile.rewind
+  end
+
+  teardown do
+    @tempfile.close!
+  end
+
+  test "lists the entries in the archive" do
+    reader = ZipFile::Reader.new(@tempfile)
+
+    assert_equal [ "notes.txt", "images/photo.bin" ], reader.names
+    assert reader.entry?("notes.txt")
+    assert_not reader.entry?("missing.txt")
+  end
+
+  test "yields each line of a text entry without its line ending" do
+    lines = []
+    ZipFile::Reader.new(@tempfile).each_line("notes.txt") { lines << it }
+
+    assert_equal [ "first line", "second line", "", "last line without newline" ], lines
+  end
+
+  test "reads a stored entry a few bytes at a time" do
+    io = ZipFile::Reader.new(@tempfile).open("images/photo.bin")
+
+    assert_equal PATTERN.bytesize * 50_000, io.size
+    assert_equal PATTERN, io.read(3)
+    assert_equal PATTERN + PATTERN[0], io.read(4)
+  end
+
+  test "reads the whole of an entry when no length is given" do
+    data = ZipFile::Reader.new(@tempfile).open("images/photo.bin").read
+
+    assert_equal PATTERN * 50_000, data
+  end
+
+  test "returns nil at the end of an entry when a length is given" do
+    io = ZipFile::Reader.new(@tempfile).open("notes.txt")
+    io.read
+
+    assert_nil io.read(10)
+  end
+
+  test "fills the given buffer when one is passed" do
+    buffer = +""
+    ZipFile::Reader.new(@tempfile).open("notes.txt").read(5, buffer)
+
+    assert_equal "first", buffer
+  end
+
+  test "an entry can be read again from the start" do
+    io = ZipFile::Reader.new(@tempfile).open("notes.txt")
+    first = io.read(10)
+
+    io.rewind
+
+    assert_equal first, io.read(10)
+  end
+
+  test "raises for an entry the archive doesn't have" do
+    assert_raises ZipFile::Reader::MissingEntry do
+      ZipFile::Reader.new(@tempfile).open("missing.txt")
+    end
+  end
+
+  test "reads an archive stored in a storage service" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: @tempfile, filename: "archive.zip", content_type: "application/zip")
+    io = ZipFile::StorageIO.new(ActiveStorage::Blob.service, blob.key, blob.byte_size)
+
+    lines = []
+    ZipFile::Reader.new(io).each_line("notes.txt") { lines << it }
+
+    assert_equal "first line", lines.first
+    assert_equal 4, lines.size
+  end
+
+  test "an entry can't produce more data than its header declares" do
+    entry = ZipFile::Reader.new(@tempfile).entries.fetch("images/photo.bin")
+    entry.uncompressed_size = 10
+    io = ZipFile::Reader::EntryIO.new(entry, @tempfile)
+
+    assert_raises ZipKit::FileReader::ReadError do
+      io.read
+    end
+  end
+end
diff --git a/test/test_helpers/data_transfer_test_helper.rb b/test/test_helpers/data_transfer_test_helper.rb
