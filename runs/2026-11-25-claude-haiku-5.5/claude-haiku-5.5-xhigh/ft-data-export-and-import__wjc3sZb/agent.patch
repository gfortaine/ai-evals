+
+  test "only admins can download an account export" do
+    export = build_export(@account, by: @admin)
+
+    assert export.accessible_to?(@admin)
+    assert_not export.accessible_to?(@member)
+  end
+
+  test "only the person who asked can download an export" do
+    export = build_export(@account, by: @member, kind: :cards)
+
+    assert export.accessible_to?(@member)
+    assert_not export.accessible_to?(users(:jz))
+  end
+
+  test "an expired export can't be downloaded" do
+    export = build_export(@account, by: @admin)
+
+    travel 2.days do
+      assert_not export.downloadable?
+      assert_not export.accessible_to?(@admin)
