@@ -0,0 +1,141 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  include DataTransferTestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+    @member = users(:david)
+  end
+
+  test "an account export is a zip with a header, every table, and the files" do
+    attach_image(cards(:logo))
+
+    export = build_export(@account, by: @admin)
+    names = archive_names(export_archive(export))
+
+    assert_includes names, "export.json"
+    assert_includes names, "data/accounts.jsonl"
+    assert_includes names, "data/cards.jsonl"
+    assert_includes names, "data/users.jsonl"
+    assert names.any? { it.start_with?("files/") }, "expected the attached image to be in the archive"
+  end
+
+  test "the header records the format and the account it came from" do
+    export = build_export(@account, by: @admin)
+
+    header = archive_json(export_archive(export), "export.json")
+
+    assert_equal Account::DataTransfer::Exporter::FORMAT, header["format"]
+    assert_equal Account::DataTransfer::Exporter::VERSION, header["version"]
+    assert_equal @account.external_account_id, header.dig("account", "external_account_id")
+  end
+
+  test "an export can be downloaded for a day" do
+    freeze_time do
+      export = build_export(@account, by: @admin)
+
+      assert_equal 1.day.from_now, export.expires_at
+      assert export.downloadable?
+    end
+  end
+
+  test "a card export has one JSON file per visible card, with its comments and files" do
+    card = cards(:logo)
+    attach_image(card)
+    card.comments.create!(creator: @member, body: "Looks good")
+
+    export = build_export(@account, by: @member, kind: :cards)
+    archive = export_archive(export)
+    card_files = archive_names(archive).grep(%r{\Acards/})
+
+    assert_equal @member.accessible_cards.published.count, card_files.size
+
+    logo = archive_json(archive, "cards/#{card.number}.json")
+    assert_equal card.title, logo["title"]
+
+    bodies = logo["comments"].map { it.dig("body", "html").to_s.gsub(/<[^>]+>/, "") }
+    assert_includes bodies, "Looks good"
+
+    assert_equal "moon.jpg", logo["image"]["name"]
+    assert_includes archive_names(archive), logo["image"]["path"]
+  end
+
+  test "a card export includes only published cards" do
+    draft = @account.cards.create!(creator: @member, board: boards(:writebook), title: "Not yet", status: "drafted")
+
+    names = archive_names(export_archive(build_export(@account, by: @member, kind: :cards)))
+
+    assert_not_includes names, "cards/#{draft.number}.json"
+  end
+
+  test "a card export has each file once, even when several cards embed it" do
+    blob = image_blob
+    html = %(<p><action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment></p>)
+    cards(:logo).update!(description: html)
+    cards(:layout).update!(description: html)
