diff --git a/test/models/account/data_transfer/action_text/body_rewriter_test.rb b/test/models/account/data_transfer/action_text/body_rewriter_test.rb
new file mode 100644
index 0000000..6853a11
--- /dev/null
+++ b/test/models/account/data_transfer/action_text/body_rewriter_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Account::DataTransfer::ActionText::BodyRewriterTest < ActiveSupport::TestCase
+  # Maps IDs the way the importer does, but keeps the blob's ID so the saved blob can be found.
+  Importer = Struct.new(:old_slug, :slug) do
+    def id_for(old_id)
+      old_id
+    end
+  end
+
+  setup do
+    @importer = Importer.new("/897362094", "/123456789")
+    @user = users(:jz)
+    @blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("image bytes"), filename: "photo.png", content_type: "image/png")
+  end
+
+  test "re-signs an attachment for the record it's imported as, and keeps its other attributes" do
+    html = %(<action-text-attachment sgid="#{@user.attachable_sgid}" content-type="text/html" caption="Hi"></action-text-attachment>)
+
+    node = Nokogiri::HTML5.fragment(rewrite(html)).at_css("action-text-attachment")
+
+    assert_equal "text/html", node["content-type"]
+    assert_equal "Hi", node["caption"]
+    assert_equal "gid://fizzy/User/#{@user.id}", decoded_gid(node["sgid"]).split("?").first
+  end
+
+  test "points a picture's url at the account it's imported into" do
+    html = %(<action-text-attachment sgid="#{@blob.attachable_sgid}" url="/897362094/rails/active_storage/blobs/redirect/old/photo.png" filename="photo.png"></action-text-attachment>)
+
+    node = Nokogiri::HTML5.fragment(rewrite(html)).at_css("action-text-attachment")
+
+    assert_equal "gid://fizzy/ActiveStorage::Blob/#{@blob.id}", decoded_gid(node["sgid"]).split("?").first
+    assert node["url"].start_with?("/123456789/rails/active_storage/blobs/redirect/")
+    assert node["url"].end_with?("/photo.png")
+  end
+
+  test "removes the url of a picture whose blob isn't in the import" do
+    ActiveStorage::Blob.where(id: @blob.id).delete_all
+    html = %(<action-text-attachment sgid="#{@blob.attachable_sgid}" url="/897362094/rails/active_storage/blobs/redirect/old/photo.png"></action-text-attachment>)
+
+    node = Nokogiri::HTML5.fragment(rewrite(html)).at_css("action-text-attachment")
+
+    assert_nil node["url"]
+  end
+
+  test "points links to the old account at the new one, and leaves other links alone" do
+    html = %(<p><a href="/897362094/cards/4">card</a> <a href="/8973620940/cards/4">other</a> <a href="https://example.com/897362094/x">site</a></p>)
+
+    hrefs = Nokogiri::HTML5.fragment(rewrite(html)).css("a").map { it["href"] }
+
+    assert_equal [ "/123456789/cards/4", "/8973620940/cards/4", "https://example.com/897362094/x" ], hrefs
+  end
+
+  test "leaves attachments it can't read as they were" do
+    html = %(<action-text-attachment sgid="not-a-signed-id"></action-text-attachment>)
+
+    node = Nokogiri::HTML5.fragment(rewrite(html)).at_css("action-text-attachment")
+
+    assert_equal "not-a-signed-id", node["sgid"]
+  end
+
+  test "leaves links alone when the old account's ID is unknown" do
+    importer = Importer.new(nil, "/123456789")
+    html = %(<a href="/897362094/cards/4">card</a>)
+
+    assert_includes Account::DataTransfer::ActionText::BodyRewriter.new(importer).rewrite(html), %(href="/897362094/cards/4")
+  end
+
+  private
+    def rewrite(html)
+      Account::DataTransfer::ActionText::BodyRewriter.new(@importer).rewrite(html)
+    end
+
+    def decoded_gid(sgid)
+      JSON.parse(Base64.decode64(sgid.split("--").first)).dig("_rails", "data")
+    end
+end
diff --git a/test/models/account/data_transfer/id_mapper_test.rb b/test/models/account/data_transfer/id_mapper_test.rb
new file mode 100644
index 0000000..e949a30
--- /dev/null
+++ b/test/models/account/data_transfer/id_mapper_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Account::DataTransfer::IdMapperTest < ActiveSupport::TestCase
+  setup do
+    @old_id = accounts(:"37s").id
+  end
+
+  test "maps an ID to the same new ID every time within one import" do
+    mapper = Account::DataTransfer::IdMapper.new(salt: "import-1")
+
+    assert_equal mapper.map(@old_id), mapper.map(@old_id)
+  end
+
+  test "maps the same ID to a different new ID in a different import" do
+    first = Account::DataTransfer::IdMapper.new(salt: "import-1").map(@old_id)
+    second = Account::DataTransfer::IdMapper.new(salt: "import-2").map(@old_id)
+
+    assert_not_equal @old_id, first
+    assert_not_equal first, second
+  end
+
+  test "maps different IDs to different new IDs" do
+    mapper = Account::DataTransfer::IdMapper.new
+
+    ids = [ accounts(:"37s").id, accounts(:initech).id, cards(:logo).id, boards(:writebook).id ]
+
+    assert_equal ids.size, ids.map { mapper.map(it) }.uniq.size
+  end
+
+  test "new IDs are valid base36 UUIDs in the same format" do
+    new_id = Account::DataTransfer::IdMapper.new.map(@old_id)
+
+    assert_match Account::DataTransfer::IdMapper::ID_FORMAT, new_id
+  end
+
+  test "new IDs keep the timestamp of the original UUIDv7" do
+    new_id = Account::DataTransfer::IdMapper.new.map(@old_id)
+
+    assert_equal ActiveRecord::Type::Uuid.base36_to_hex(@old_id)[0, 12], ActiveRecord::Type::Uuid.base36_to_hex(new_id)[0, 12]
+  end
+
+  test "rejects IDs that aren't in the UUID format" do
+    mapper = Account::DataTransfer::IdMapper.new
+
+    assert_raises Account::DataTransfer::InvalidArchive do
+      mapper.map("not-an-id")
+    end
+
+    assert_raises Account::DataTransfer::InvalidArchive do
+      mapper.map(nil)
+    end
+  end
+
+  test "derives blob keys deterministically within one import" do
+    mapper = Account::DataTransfer::IdMapper.new(salt: "import-1")
+
+    assert_equal 28, mapper.key("abcdefghijklmnopqrstuvwxyz12").size
+    assert_equal mapper.key("abcdefghijklmnopqrstuvwxyz12"), mapper.key("abcdefghijklmnopqrstuvwxyz12")
+    assert_not_equal mapper.key("abcdefghijklmnopqrstuvwxyz12"), Account::DataTransfer::IdMapper.new(salt: "import-2").key("abcdefghijklmnopqrstuvwxyz12")
+  end
+end
diff --git a/test/models/account/export_test.rb b/test/models/account/export_test.rb
