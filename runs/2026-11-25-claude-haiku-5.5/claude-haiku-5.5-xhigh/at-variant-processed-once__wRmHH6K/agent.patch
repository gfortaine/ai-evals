diff --git a/app/models/picture.rb b/app/models/picture.rb
index 9bcf18f..35e97a1 100644
--- a/app/models/picture.rb
+++ b/app/models/picture.rb
@@ -1,8 +1,11 @@
 class Picture < ApplicationRecord
   include Leafable
 
+  # Variant records are found by a digest of their transformations, and readers rebuild those from
+  # the signed variation key, which is JSON. Keep option values JSON-native ("webp", not :webp), or
+  # the background job stores a copy that readers never find and the first reader creates another.
   has_one_attached :image do |attachable|
-    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: :webp, process: :later
+    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: "webp", process: :later
   end
 
   def large_image
diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..39ccab6 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -38,4 +38,35 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "an uploaded picture is derived once, and readers are served that copy" do
+    leaf = leaves(:reading_picture)
+
+    assert_difference "ActiveStorage::VariantRecord.count", 1 do
+      perform_enqueued_jobs do
+        put leafable_path(leaf), params: {
+          picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") } }
+      end
+    end
+
+    assert_response :no_content
+
+    transformations = []
+    callback = ->(*, payload) { transformations << payload }
+
+    ActiveSupport::Notifications.subscribed(callback, "transform.active_storage") do
+      assert_no_difference [ "ActiveStorage::Blob.count", "ActiveStorage::VariantRecord.count" ] do
+        get book_slug_path(books(:handbook))
+        assert_response :ok
+
+        get leafable_path(leaf)
+        assert_response :ok
+
+        get response.parsed_body.at_css("figure img")["src"]
+        assert_response :redirect
+      end
+    end
+
+    assert_empty transformations
+  end
 end
diff --git a/test/models/picture_test.rb b/test/models/picture_test.rb
index 18a2a56..8ce9a0f 100644
--- a/test/models/picture_test.rb
+++ b/test/models/picture_test.rb
@@ -23,4 +23,13 @@ class PictureTest < ActiveSupport::TestCase
 
     assert_equal picture.image, picture.large_image
   end
+
+  test "readers are served the variant processed in the background, without processing it again" do
+    picture = pictures(:reading)
+    picture.large_image.processed
+
+    assert_no_difference "ActiveStorage::VariantRecord.count" do
+      picture.image.blob.representation(picture.large_image.variation.key).processed
+    end
+  end
 end
