diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..3dee31a
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,233 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+// Moves cards between the board's zones (columns, Maybe?, Not Now and Done) by
+// dragging them. Columns keep their own order, so dropping never reorders cards
+// within a zone.
+//
+// The move is applied as soon as the card is dropped, and the save runs in the
+// background. Nothing is re-rendered when the save completes, so nothing shifts
+// after the drop. If the save fails, the board reloads to show what was saved.
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  #draggedCard = null
+  #sourceZone = null
+  #hoveredZone = null
+  #saves = Promise.resolve()
+
+  dragStart(event) {
+    const card = event.target
+    if (!card.matches?.("article.card") || !this.#zoneFrom(card)) return
+
+    this.#draggedCard = card
+    this.#sourceZone = this.#zoneFrom(card)
+    this.#clearSelectionIn(this.#sourceZone)
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id) // Firefox won't start a drag without data
+
+    // Dim the card only after the browser has captured the drag image
+    requestAnimationFrame(() => {
+      if (this.#draggedCard === card) card.classList.add(this.draggedItemClass)
+    })
+  }
+
+  dragOver(event) {
+    if (!this.#draggedCard) return
+
+    const zone = this.#zoneFrom(event.target)
+    if (this.#canDropInto(zone)) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(zone)
+    } else {
+      this.#highlight(null)
+    }
+  }
+
+  dragLeave(event) {
+    if (!this.#hoveredZone?.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    if (!this.#draggedCard) return
+
+    const zone = this.#zoneFrom(event.target)
+    if (this.#canDropInto(zone)) {
+      event.preventDefault()
+      this.#moveCard(this.#draggedCard, zone)
+      this.#endDrag()
+    }
+  }
+
+  dragEnd() {
+    this.#endDrag()
+  }
+
+  // Private
+
+  #moveCard(card, zone) {
+    const request = this.#requestFor(card, zone)
+
+    this.#placeCard(card, zone)
+    this.#updateCardState(card, zone)
+    this.#adjustCount(this.#sourceZone, -1)
+    this.#adjustCount(zone, 1)
+
+    this.#enqueueSave(request)
+  }
+
+  #requestFor(card, zone) {
+    switch (zone.dataset.dropZone) {
+      case "column":
+        return { send: post, url: card.dataset.cardTriageUrl, query: { column_id: zone.dataset.columnId } }
+      case "maybe":
+        return { send: destroy, url: card.dataset.cardTriageUrl }
+      case "not-now":
+        return { send: post, url: card.dataset.cardNotNowUrl }
+      case "done":
+        return { send: post, url: card.dataset.cardClosureUrl }
+    }
+  }
+
+  #endDrag() {
+    this.#draggedCard?.classList.remove(this.draggedItemClass)
+    this.#highlight(null)
+    this.#draggedCard = null
+    this.#sourceZone = null
+  }
+
+  #enqueueSave(request) {
+    // One save at a time, so quick successive moves of a card reach the server in order
+    this.#saves = this.#saves.then(() => this.#save(request))
+  }
+
+  async #save(request) {
+    try {
+      const response = await request.send(request.url, { query: request.query, responseKind: "json" })
+      if (!response.ok) this.#reload()
+    } catch {
+      this.#reload()
+    }
+  }
+
+  #reload() {
+    Turbo.visit(window.location.href, { action: "replace" })
+  }
+
+  // The server sorts cards by last activity, and a move counts as activity, so a
+  // moved card goes first. Columns and Maybe? also list golden cards before the rest.
+  #placeCard(card, zone) {
+    const cards = [ ...zone.querySelectorAll("article.card") ]
+    const firstCard = this.#sortsGoldenFirst(zone) && !this.#isGolden(card)
+      ? cards.find(other => !this.#isGolden(other))
+      : cards[0]
+
+    if (firstCard) {
+      firstCard.before(card)
+    } else if (cards.length > 0) {
+      cards.at(-1).after(card)
+    } else {
+      zone.querySelector(".cards__list").append(card)
+    }
+  }
+
+  #updateCardState(card, zone) {
+    const kind = zone.dataset.dropZone
+
+    card.classList.toggle("card--active", kind === "column" || kind === "maybe")
+    card.classList.toggle("card--postponed", kind === "not-now")
+
+    // Cards take the color of their column; Not Now and Done are tinted by their own styles
+    if (zone.dataset.cardColor) card.style.setProperty("--card-color", zone.dataset.cardColor)
+
+    // Only open cards are selected on hover; Done cards are closed
+    if (kind === "done") {
+      card.removeAttribute("data-action")
+    } else {
+      card.setAttribute("data-action", "mouseenter->navigable-list#hoverSelect")
+    }
+
+    card.querySelector(".card__closed")?.remove()
+    card.querySelector(".card__header .card__column-name--current")?.remove()
+
+    if (kind === "column") {
+      card.querySelector(".card__header").append(this.#columnLabel(zone))
+    }
+
+    // Columns hide the stamp, but its presence is what tints a Done card
+    if (kind === "not-now" || kind === "done") {
+      card.querySelector(".card__body").append(this.#stamp(kind))
+    }
+  }
+
+  #columnLabel(zone) {
+    const label = document.createElement("span")
+    label.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+
+    const name = document.createElement("span")
+    name.className = "overflow-ellipsis"
+    name.textContent = zone.dataset.columnName
+
+    label.append(name)
+    return label
+  }
+
+  #stamp(kind) {
+    const stamp = document.createElement("div")
+    stamp.className = "card__closed"
+
+    const title = document.createElement("span")
+    title.className = "card__closed-title"
+    title.textContent = kind === "done" ? "Done" : "Not Now"
+
+    stamp.append(title)
+    return stamp
+  }
+
+  // Hovering a card selects it, and a dragged card shouldn't stay selected once it has moved
+  #clearSelectionIn(zone) {
+    const list = zone.querySelector(".cards__transition-container")
+    if (list) this.application.getControllerForElementAndIdentifier(list, "navigable-list")?.clearSelection()
+  }
+
+  #adjustCount(zone, delta) {
+    const counter = zone.querySelector(".cards__expander-count")
+    if (!counter || counter.textContent.includes("+")) return // "99+" can't be adjusted exactly
+
+    const count = Number(counter.textContent) + delta
+    counter.textContent = count > 99 ? "99+" : count
+  }
+
+  #highlight(zone) {
+    if (zone === this.#hoveredZone) return
+
+    this.#hoveredZone?.classList.remove(this.hoverContainerClass)
+    zone?.classList.add(this.hoverContainerClass)
+    this.#hoveredZone = zone
+  }
+
+  #canDropInto(zone) {
+    return zone !== null && zone !== this.#sourceZone && zone.querySelector(".cards__list") !== null
+  }
+
+  #sortsGoldenFirst(zone) {
+    return [ "column", "maybe" ].includes(zone.dataset.dropZone)
+  }
+
+  #isGolden(card) {
+    return card.classList.contains("golden-effect")
+  }
+
+  #zoneFrom(node) {
+    return node.closest?.("[data-drop-zone]") ?? null
+  }
+}
