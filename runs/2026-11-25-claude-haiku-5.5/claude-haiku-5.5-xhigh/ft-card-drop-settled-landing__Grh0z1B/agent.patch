diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..ef3ce3c
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,329 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  # What a card looks like on the board. Selection is left out: it follows the pointer.
+  CARD_LOOK = <<~JS
+    (id) => {
+      const card = document.getElementById(id)
+      const label = card.querySelector(".card__header .card__column-name--current")
+      const style = getComputedStyle(card)
+      return {
+        classes: [ ...card.classList ].filter(name => name.startsWith("card") || name === "golden-effect").sort(),
+        hovers: card.getAttribute("data-action"),
+        label: label?.textContent.trim() ?? null,
+        stamp: card.querySelector(".card__closed") !== null,
+        color: style.getPropertyValue("--card-color").trim(),
+        background: style.backgroundColor
+      }
+    }
+  JS
+
+  setup do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+  end
+
+  test "dropping a card into a column places it first, immediately, and saves it" do
+    card = cards(:buy_domain)
+
+    drag card, to: column(columns(:writebook_in_progress))
+
+    # No waiting: the board already shows the move when the drop finishes
+    assert_equal article_ids([ card, cards(:text) ]), card_ids_in(column(columns(:writebook_in_progress)), wait: 0)
+    assert_no_selector "#maybe #{article(card)}", visible: :all, wait: 0
+    assert_saved { card.reload.column == columns(:writebook_in_progress) }
+  end
+
+  test "dropping a card into an empty column hides its placeholder" do
+    card = cards(:buy_domain)
+    on_hold = column(columns(:writebook_on_hold))
+    expand on_hold
+    assert_selector "#{on_hold} .blank-slate--drag"
+
+    drag card, to: on_hold
+
+    assert_equal article_ids([ card ]), card_ids_in(on_hold, wait: 0)
+    assert_no_selector "#{on_hold} .blank-slate", wait: 0
+    assert_saved { card.reload.column == columns(:writebook_on_hold) }
+  end
+
+  test "the board shows the move while the save is still in flight" do
+    hold_saves
+    card = cards(:buy_domain)
+
+    drag card, to: column(columns(:writebook_in_progress))
+
+    assert_equal article_ids([ card, cards(:text) ]), card_ids_in(column(columns(:writebook_in_progress)), wait: 0)
+    assert_nil card.reload.column
+
+    release_saves
+    assert_saved { card.reload.column == columns(:writebook_in_progress) }
+  end
+
+  test "a card moved into a column lands after its golden cards" do
+    card = cards(:shipping)
+    expand "closed-cards"
+
+    drag card, to: column(columns(:writebook_triage))
+
+    assert_equal article_ids([ cards(:logo), card, cards(:layout) ]), card_ids_in(column(columns(:writebook_triage)), wait: 0)
+    assert_saved { card.reload.open? && card.column == columns(:writebook_triage) }
+  end
+
+  test "dragging a card to Not Now" do
+    card = cards(:text)
+    expand column(columns(:writebook_in_progress))
+
+    drag card, to: "not-now"
+
+    assert_equal article_ids([ card ]), card_ids_in("not-now", wait: 0)
+    assert_selector "#{article(card)}.card--postponed", visible: :all, wait: 0
+    assert_selector "#{article(card)} .card__closed", visible: :all, wait: 0
+    assert_saved { card.reload.postponed? }
+  end
+
+  test "dragging a card to Maybe?" do
+    card = cards(:layout)
+    expand column(columns(:writebook_triage))
+
+    drag card, to: "maybe"
+
+    assert_equal article_ids([ card, cards(:buy_domain) ]), card_ids_in("maybe", wait: 0)
+    assert_selector "#{article(card)}.card--active", visible: :all, wait: 0
+    assert_saved { card.reload.awaiting_triage? }
+  end
+
+  test "dragging a card to Done" do
+    card = cards(:layout)
+    expand column(columns(:writebook_triage))
+
+    drag card, to: "closed-cards"
+
+    assert_equal article_ids([ card, cards(:shipping) ]), card_ids_in("closed-cards", wait: 0)
+    assert_selector "#{article(card)} .card__closed", visible: :all, wait: 0
+    assert_saved { card.reload.closed? }
+  end
+
+  test "dragging a card out of Done reopens it into a column" do
+    card = cards(:shipping)
+    expand "closed-cards"
+
+    drag card, to: column(columns(:writebook_in_progress))
+
+    assert_equal article_ids([ card, cards(:text) ]), card_ids_in(column(columns(:writebook_in_progress)), wait: 0)
+    assert_saved { card.reload.open? && card.column == columns(:writebook_in_progress) }
+  end
+
+  test "dropping a card onto its own column changes nothing" do
+    card = cards(:layout)
+    expand column(columns(:writebook_triage))
+    order = card_ids_in(column(columns(:writebook_triage)))
+    last_active_at = card.reload.last_active_at
+
+    drag card, to: column(columns(:writebook_triage))
+
+    assert_equal order, card_ids_in(column(columns(:writebook_triage)), wait: 0)
+    sleep 0.5 # long enough for a save to have landed
+    assert_equal last_active_at, card.reload.last_active_at
+    assert_equal columns(:writebook_triage), card.column
+  end
+
+  test "the moved card is not re-rendered when the save lands" do
+    card = cards(:buy_domain)
+    drag card, to: column(columns(:writebook_in_progress))
+
+    page.execute_script("document.getElementById(arguments[0]).dataset.marker = 'kept'", dom_id(card, :article))
+    assert_saved { card.reload.column == columns(:writebook_in_progress) }
+    sleep 0.5
+
+    assert_equal "kept", find(article(card), visible: :all)["data-marker"]
+    assert_equal article_ids([ card, cards(:text) ]), card_ids_in(column(columns(:writebook_in_progress)), wait: 0)
+  end
+
+  test "counts follow the cards" do
+    card = cards(:buy_domain)
+
+    drag card, to: column(columns(:writebook_in_progress))
+
+    assert_equal "0", find("#maybe .cards__expander-count", visible: :all, wait: 0).text(:all)
+    assert_equal "2", find("#{column(columns(:writebook_in_progress))} .cards__expander-count", visible: :all, wait: 0).text(:all)
+  end
+
+  test "a failed save reloads the board to show what was saved" do
+    card = cards(:buy_domain)
+    card.destroy! # the server can no longer find the card, so the save fails
+
+    drag card, to: column(columns(:writebook_in_progress))
+
+    assert_no_selector article(card), visible: :all, wait: 5
+    assert_selector "#maybe"
+  end
+
+  test "quick successive moves of a card are saved in order" do
+    card = cards(:buy_domain)
+    drag card, to: column(columns(:writebook_in_progress))
+    expand column(columns(:writebook_in_progress))
+
+    drag card, to: "not-now"
+
+    assert_saved { card.reload.postponed? }
+    sleep 0.5
+    assert_nil card.reload.column
+  end
+
+  test "a card dropped into a column looks the same after a reload" do
+    card = cards(:buy_domain)
+
+    drag card, to: column(columns(:writebook_in_progress))
+
+    assert_looks_the_same_after_reload(card) { card.reload.column == columns(:writebook_in_progress) }
+  end
+
+  test "a card dropped on Not Now looks the same after a reload" do
+    card = cards(:text)
+    expand column(columns(:writebook_in_progress))
+
+    drag card, to: "not-now"
+
+    assert_looks_the_same_after_reload(card) { card.reload.postponed? }
+  end
+
+  test "a card dropped on Done looks the same after a reload" do
+    card = cards(:layout)
+    expand column(columns(:writebook_triage))
+
+    drag card, to: "closed-cards"
+
+    assert_looks_the_same_after_reload(card) { card.reload.closed? }
+  end
+
+  test "a card dropped on Maybe? looks the same after a reload" do
+    card = cards(:layout)
+    expand column(columns(:writebook_triage))
+
+    drag card, to: "maybe"
+
+    assert_looks_the_same_after_reload(card) { card.reload.awaiting_triage? }
+  end
+
+  test "a card dragged out of Done looks the same after a reload" do
+    card = cards(:shipping)
+    expand "closed-cards"
+
+    drag card, to: column(columns(:writebook_in_progress))
+
+    assert_looks_the_same_after_reload(card) { card.reload.open? && card.column == columns(:writebook_in_progress) }
+  end
+
+  test "the dragged card is dimmed and the column under the pointer lights up" do
+    card = cards(:buy_domain)
+
+    dispatch_drag_event article(card), "dragstart"
+    assert_selector "#{article(card)}.drag-and-drop__dragged-item", visible: :all
+
+    dispatch_drag_event column(columns(:writebook_in_progress)), "dragover"
+    assert_selector "#{column(columns(:writebook_in_progress))}.drag-and-drop__hover-container", visible: :all
+
+    dispatch_drag_event "#maybe", "dragover"
+    assert_no_selector "#{column(columns(:writebook_in_progress))}.drag-and-drop__hover-container", visible: :all
+    dispatch_drag_event article(card), "dragend"
+    assert_no_selector "#{article(card)}.drag-and-drop__dragged-item", visible: :all
+  end
+
+  test "the column under the pointer stays lit while the pointer moves within it" do
+    card = cards(:buy_domain)
+    in_progress = column(columns(:writebook_in_progress))
+
+    dispatch_drag_event article(card), "dragstart"
+    dispatch_drag_event in_progress, "dragover"
+    # Moving onto a child of the column fires dragleave on the column, with the child as the new target
+    dispatch_drag_event in_progress, "dragleave", related_target: "#{in_progress} .cards__header"
+    assert_selector "#{in_progress}.drag-and-drop__hover-container", visible: :all
+
+    dispatch_drag_event article(card), "dragend"
+  end
+
+  private
+    def column(column)
+      "##{dom_id(column)}"
+    end
+
+    def article(card)
+      "##{dom_id(card, :article)}"
+    end
+
+    def article_ids(cards)
+      cards.map { |card| dom_id(card, :article) }
+    end
+
+    def zone_selector(zone)
+      zone.start_with?("#") ? zone : "##{zone}"
+    end
+
+    def expand(zone)
+      find("#{zone_selector(zone)} .cards__expander").click
+      assert_selector "#{zone_selector(zone)}.is-expanded"
+    end
+
+    def drag(card, to:)
+      find(article(card)).drag_to(find(zone_selector(to)))
+    end
+
+    def card_ids_in(zone, wait: Capybara.default_max_wait_time)
+      all("#{zone_selector(zone)} article.card", visible: :all, wait: wait).map { |node| node[:id] }
+    end
+
+    def assert_saved(timeout: 5)
+      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
+      until yield
+        flunk "the move was never saved" if Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
+        sleep 0.05
+      end
+    end
+
+    def assert_looks_the_same_after_reload(card)
+      optimistic = card_look(card)
+      assert_saved { yield }
+
+      visit board_url(boards(:writebook))
+      assert_selector article(card), visible: :all
+      assert_equal optimistic, card_look(card)
+    end
+
+    def card_look(card)
+      page.evaluate_script("(#{CARD_LOOK})(#{dom_id(card, :article).to_json})")
+    end
+
+    # request.js waits on its interceptor before sending each request
+    def hold_saves
+      evaluate_async_script(<<~JS)
+        const done = arguments[0]
+        import("@rails/request.js").then(({ RequestInterceptor }) => {
+          window.heldSaves = []
+          RequestInterceptor.register(() => new Promise(resolve => window.heldSaves.push(resolve)))
+          done()
+        })
+      JS
+    end
+
+    def release_saves
+      execute_script(<<~JS)
+        import("@rails/request.js").then(({ RequestInterceptor }) => {
+          RequestInterceptor.reset()
+          window.heldSaves.forEach(resolve => resolve())
+        })
+      JS
+    end
+
+    def dispatch_drag_event(selector, type, related_target: nil)
+      page.execute_script(<<~JS, selector, type, related_target)
+        const [ selector, type, relatedSelector ] = arguments
+        const element = document.querySelector(selector)
+        const relatedTarget = relatedSelector ? document.querySelector(relatedSelector) : null
+        const dataTransfer = new DataTransfer()
+        element.dispatchEvent(new DragEvent(type, { bubbles: true, cancelable: true, dataTransfer, relatedTarget }))
+      JS
+    end
+end
