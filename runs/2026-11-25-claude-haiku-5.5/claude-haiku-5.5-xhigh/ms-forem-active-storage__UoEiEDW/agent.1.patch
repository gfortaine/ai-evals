@@ -0,0 +1,43 @@
+require "rails_helper"
+
+RSpec.describe "Profile pictures in Active Storage" do
+  let(:image_path) { Rails.root.join("spec/fixtures/files/800x600.jpg") }
+
+  describe "serving a stored picture" do
+    it "serves the picture from its URL, not from a Forem page" do
+      user = create(:user, profile_image: Rack::Test::UploadedFile.new(image_path, "image/jpeg"))
+
+      get user.profile_image_url
+
+      expect(response).to have_http_status(:ok)
+      expect(response.media_type).to eq("image/jpeg")
+      expect(response.body).to eq(File.binread(image_path))
+    end
+
+    it "serves an organization's picture from its URL" do
+      organization = create(:organization, profile_image: Rack::Test::UploadedFile.new(image_path, "image/jpeg"))
+
+      get organization.profile_image_url
+
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to eq(File.binread(image_path))
+    end
+  end
+
+  describe "direct uploads" do
+    # Forem doesn't use Active Storage direct uploads, which would let anyone create blob records
+    it "does not accept requests to create a direct upload" do
+      blob_params = { filename: "x.png", byte_size: 1, checksum: "x", content_type: "image/png" }
+      post "/rails/active_storage/direct_uploads", params: { blob: blob_params }
+
+      expect(response).to have_http_status(:not_found)
+      expect(ActiveStorage::Blob.count).to eq(0)
+    end
+
+    it "does not accept uploads to the Disk service" do
+      put "/rails/active_storage/disk/not-a-real-token", params: "data"
+
+      expect(response).to have_http_status(:not_found)
+    end
+  end
+end
