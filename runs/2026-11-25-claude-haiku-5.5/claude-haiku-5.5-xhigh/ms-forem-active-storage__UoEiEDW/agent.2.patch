+require "rails_helper"
+
+RSpec.describe "profile_images:copy", type: :task do
+  include_context "with a CarrierWave profile picture"
+
+  before do
+    Rake::Task["profile_images:copy"].reenable
+  end
+
+  def run_copy
+    Rake::Task["profile_images:copy"].reenable
+    Rake::Task["profile_images:copy"].invoke
+  end
+
+  def legacy_user
+    create(:user).tap { |user| store_carrierwave_picture(user) }
+  end
+
+  def legacy_organization
+    create(:organization).tap { |organization| store_carrierwave_picture(organization) }
+  end
+
+  it "copies the CarrierWave pictures of users and organizations" do
+    users = [legacy_user, legacy_user]
+    organization = legacy_organization
+
+    expect { run_copy }.to output(/Profile pictures copied to Active Storage: 3/).to_stdout
+
+    (users + [organization]).each do |record|
+      expect(record.reload.profile_picture.download).to eq(legacy_image_bytes)
+    end
+  end
+
+  it "copies nothing new when it is run again" do
+    legacy_user
+    run_copy
+    blob_ids = ActiveStorage::Blob.ids
+
+    expect { run_copy }.to output(/copied to Active Storage: 0/).to_stdout
+
+    expect(ActiveStorage::Blob.ids).to eq(blob_ids)
+  end
+
+  it "skips records that already have an Active Storage picture without loading them" do
+    attached_user = create(:user)
+    attached_user.update_columns(profile_image: "legacy.jpg")
+    allow(Images::ProfilePictureCopier).to receive(:call).and_call_original
+
+    run_copy
+
+    expect(Images::ProfilePictureCopier).not_to have_received(:call).with(having_attributes(id: attached_user.id))
+  end
+
+  it "can be resumed after an interruption" do
+    users = [legacy_user, legacy_user, legacy_user]
+    calls = 0
+    allow(Images::ProfilePictureCopier).to receive(:call).and_wrap_original do |original, record|
+      calls += 1
+      raise Interrupt if calls == 2
+
+      original.call(record)
+    end
+
+    expect { run_copy }.to raise_error(Interrupt)
+    expect(users.count { |user| user.reload.profile_picture.attached? }).to eq(1)
+
+    allow(Images::ProfilePictureCopier).to receive(:call).and_call_original
+    run_copy
+
+    users.each do |user|
+      expect(user.reload.profile_picture.download).to eq(legacy_image_bytes)
+    end
+  end
+
+  it "keeps copying after one record fails, then reports the failure" do
+    failing = legacy_user
+    working = legacy_user
+    allow(Images::ProfilePictureCopier).to receive(:call).and_wrap_original do |original, record|
+      raise Errno::EIO, "storage timeout" if record.id == failing.id
+
+      original.call(record)
+    end
+
+    expect { run_copy }.to raise_error(RuntimeError, /1 profile pictures failed to copy/)
+
+    expect(working.reload.profile_picture).to be_attached
+    expect(failing.reload.profile_picture).not_to be_attached
+  end
+
+  it "retries the failed record when the task runs again" do
+    failing = legacy_user
+    allow(Images::ProfilePictureCopier).to receive(:call).and_wrap_original do |original, record|
+      raise Errno::EIO, "storage timeout" if record.id == failing.id
+
+      original.call(record)
+    end
+    expect { run_copy }.to raise_error(RuntimeError)
+
+    allow(Images::ProfilePictureCopier).to receive(:call).and_call_original
+    run_copy
+
+    expect(failing.reload.profile_picture.download).to eq(legacy_image_bytes)
+  end
+
+  it "lists pictures that are missing from storage without failing" do
+    missing = create(:user)
+    missing.profile_picture.detach
+    missing.update_columns(profile_image: "gone.jpg")
+
+    expect { run_copy }.to output(/missing from storage: User##{missing.id}/).to_stdout
+    expect(missing.reload.profile_picture).not_to be_attached
+  end
+end
