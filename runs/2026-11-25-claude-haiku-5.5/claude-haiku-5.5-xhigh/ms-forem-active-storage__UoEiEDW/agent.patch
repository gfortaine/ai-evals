diff --git a/spec/services/images/profile_picture_copier_spec.rb b/spec/services/images/profile_picture_copier_spec.rb
new file mode 100644
index 0000000..5424997
--- /dev/null
+++ b/spec/services/images/profile_picture_copier_spec.rb
@@ -0,0 +1,139 @@
+require "rails_helper"
+
+RSpec.describe Images::ProfilePictureCopier do
+  shared_examples "a copied profile picture" do |factory|
+    include_context "with a CarrierWave profile picture"
+
+    let(:record) { create(factory) }
+
+    context "when the picture is only in CarrierWave" do
+      before { store_carrierwave_picture(record) }
+
+      it "stores the same bytes in Active Storage" do
+        expect(described_class.call(record)).to eq(:copied)
+
+        record.reload
+        expect(record.profile_picture).to be_attached
+        expect(record.profile_picture.download).to eq(legacy_image_bytes)
+        expect(record.profile_picture.blob.content_type).to eq("image/jpeg")
+      end
+
+      it "serves the picture from Active Storage afterwards" do
+        described_class.call(record)
+
+        expect(record.reload.profile_image_url).to include("/rails/active_storage/")
+      end
+
+      it "leaves the CarrierWave column and file in place" do
+        column = record.read_attribute(:profile_image)
+        stored_file = Rails.public_path.join(ProfileImageUploader.new(record, :profile_image).store_dir, column)
+
+        described_class.call(record)
+
+        expect(record.reload.read_attribute(:profile_image)).to eq(column)
+        expect(File.binread(stored_file)).to eq(legacy_image_bytes)
+      end
+
+      it "does not save the record or run its callbacks" do
+        updated_at = record.updated_at
+        allow(Images::SocialImageWorker).to receive(:perform_async)
+        allow(Users::BustProfileImageCacheWorker).to receive(:perform_async) if factory == :user
+
+        described_class.call(record)
+
+        expect(record.reload.updated_at).to eq(updated_at)
+        expect(Images::SocialImageWorker).not_to have_received(:perform_async)
+        expect(Users::BustProfileImageCacheWorker).not_to have_received(:perform_async) if factory == :user
+      end
+
+      it "does nothing when run again" do
+        described_class.call(record)
+        blob_ids = ActiveStorage::Blob.ids
+        attachment_id = record.profile_picture.attachment.id
+
+        expect(described_class.call(record)).to eq(:already_in_active_storage)
+
+        expect(ActiveStorage::Blob.ids).to eq(blob_ids)
+        expect(record.reload.profile_picture.attachment.id).to eq(attachment_id)
+      end
+
+      it "does not replace a newer picture uploaded after the deploy" do
+        newer_path = Rails.root.join("spec/fixtures/files/800x600.png")
+        record.update!(profile_image: Rack::Test::UploadedFile.new(newer_path, "image/png"))
+        uploaded_blob_id = record.reload.profile_picture.blob.id
+
+        expect(described_class.call(record)).to eq(:already_in_active_storage)
+
+        expect(record.reload.profile_picture.blob.id).to eq(uploaded_blob_id)
+        expect(record.profile_picture.download).to eq(File.binread(newer_path))
+      end
+
+      it "leaves nothing behind when the attachment can't be saved" do
+        blob_ids = ActiveStorage::Blob.ids
+        allow(ActiveStorage::Attachment).to receive(:insert!).and_raise(ActiveRecord::StatementInvalid, "boom")
+
+        expect { described_class.call(record) }.to raise_error(ActiveRecord::StatementInvalid)
+
+        expect(record.reload.profile_picture).not_to be_attached
+        expect(ActiveStorage::Blob.ids).to eq(blob_ids)
+      end
+
+      it "leaves nothing behind when the upload fails" do
+        blob_ids = ActiveStorage::Blob.ids
+        allow(ActiveStorage::Blob.service).to receive(:upload).and_raise(Errno::EIO)
+
+        expect { described_class.call(record) }.to raise_error(Errno::EIO)
+
+        expect(record.reload.profile_picture).not_to be_attached
+        expect(ActiveStorage::Blob.ids).to eq(blob_ids)
+      end
+
+      it "keeps the newer picture when one is attached while the copy is running" do
+        allow(ActiveStorage::Attachment).to receive(:exists?).and_return(true)
+        blob_ids = ActiveStorage::Blob.ids
+
+        expect(described_class.call(record)).to eq(:already_in_active_storage)
+
+        expect(ActiveStorage::Blob.ids).to eq(blob_ids)
+        expect(record.reload.profile_picture).not_to be_attached
+      end
+    end
+
+    it "reports a record with no picture and stores nothing" do
+      record.profile_picture.detach
+      record.update_columns(profile_image: nil)
+      blob_ids = ActiveStorage::Blob.ids
+
+      expect(described_class.call(record.reload)).to eq(:no_picture)
+      expect(ActiveStorage::Blob.ids).to eq(blob_ids)
+    end
+
+    it "skips a column that is a URL rather than a stored file, such as the default picture" do
+      record.profile_picture.detach
+      record.update_columns(profile_image: "https://thepracticaldev.s3.amazonaws.com/i/99mvlsfu5tfj9m7ku25d.png")
+      blob_ids = ActiveStorage::Blob.ids
+
+      expect(described_class.call(record.reload)).to eq(:not_a_stored_file)
+      expect(record.profile_picture).not_to be_attached
+      expect(ActiveStorage::Blob.ids).to eq(blob_ids)
+    end
+
+    it "reports a CarrierWave file that is not in storage and stores nothing" do
+      record.profile_picture.detach
+      record.update_columns(profile_image: "not_uploaded.jpg")
+      blob_ids = ActiveStorage::Blob.ids
+
+      expect(described_class.call(record.reload)).to eq(:missing_from_storage)
+      expect(record.profile_picture).not_to be_attached
+      expect(ActiveStorage::Blob.ids).to eq(blob_ids)
+    end
+  end
+
+  describe "User" do
+    it_behaves_like "a copied profile picture", :user
+  end
+
+  describe "Organization" do
+    it_behaves_like "a copied profile picture", :organization
+  end
+end
diff --git a/spec/services/images/profile_picture_sanitizer_spec.rb b/spec/services/images/profile_picture_sanitizer_spec.rb
