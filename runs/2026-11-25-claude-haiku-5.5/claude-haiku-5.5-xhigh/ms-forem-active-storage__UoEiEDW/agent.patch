+    end
+
+    # Forem doesn't use Active Storage direct uploads. The endpoints would let anyone create blob
+    # records and, with the Disk service, upload files, so answer them with 404.
+    not_found = ->(_env) { [404, { "Content-Type" => "text/plain" }, ["Not Found"]] }
