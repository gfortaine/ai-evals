diff --git a/spec/db/migrate/copy_profile_pictures_to_active_storage_spec.rb b/spec/db/migrate/copy_profile_pictures_to_active_storage_spec.rb
new file mode 100644
index 0000000..9a49d19
--- /dev/null
+++ b/spec/db/migrate/copy_profile_pictures_to_active_storage_spec.rb
@@ -0,0 +1,89 @@
+require "rails_helper"
+require Rails.root.join("db/migrate/20261123062027_copy_profile_pictures_to_active_storage.rb")
+
+RSpec.describe CopyProfilePicturesToActiveStorage do
+  include_context "with a CarrierWave profile picture"
+
+  let(:migration) { described_class.new }
+
+  def run_migration
+    migration.suppress_messages { migration.up }
+  end
+
+  def legacy_user
+    create(:user).tap { |user| store_carrierwave_picture(user) }
+  end
+
+  it "copies the CarrierWave pictures of users and organizations, so they keep showing" do
+    user = legacy_user
+    organization = create(:organization).tap { |record| store_carrierwave_picture(record) }
+    user_url_before = user.profile_image_url
+
+    run_migration
+
+    [user, organization].each do |record|
+      expect(record.reload.profile_picture.download).to eq(legacy_image_bytes)
+      expect(record.profile_image_url).to include("/rails/active_storage/")
+    end
+    expect(user.reload.profile_image_url).not_to eq(user_url_before)
+  end
+
+  it "keeps the CarrierWave files, so cached URLs still work" do
+    user = legacy_user
+    stored_file = Rails.public_path.join(ProfileImageUploader.new(user, :profile_image).store_dir,
+                                         user.read_attribute(:profile_image))
+
+    run_migration
+
+    expect(File.binread(stored_file)).to eq(legacy_image_bytes)
+  end
+
+  it "leaves a picture that is already in Active Storage alone when it is run again" do
+    user = legacy_user
+    run_migration
+    blob_id = user.reload.profile_picture.blob.id
+
+    expect { run_migration }.not_to raise_error
+
+    expect(user.reload.profile_picture.blob.id).to eq(blob_id)
+  end
+
+  it "does not replace a newer upload with a CarrierWave picture that is still in the column" do
+    user = legacy_user
+    newer_path = Rails.root.join("spec/fixtures/files/800x600.png")
+    user.update!(profile_image: Rack::Test::UploadedFile.new(newer_path, "image/png"))
+
+    run_migration
+
+    expect(user.reload.profile_picture.download).to eq(File.binread(newer_path))
+  end
+
+  it "does not stop when a CarrierWave file is missing from storage, since it can't be shown either" do
+    missing = create(:user)
+    missing.profile_picture.detach
+    missing.update_columns(profile_image: "gone.jpg")
+
+    expect { run_migration }.not_to raise_error
+
+    expect(missing.reload.profile_picture).not_to be_attached
+  end
+
+  it "stops the deploy when a picture can't be copied, after copying the others" do
+    failing = legacy_user
+    working = legacy_user
+    allow(Images::ProfilePictureCopier).to receive(:call).and_wrap_original do |original, record|
+      raise Errno::EIO, "storage timeout" if record.id == failing.id
+
+      original.call(record)
+    end
+
+    expect { run_migration }.to raise_error(RuntimeError, /1 profile pictures failed to copy to Active Storage/)
+
+    expect(working.reload.profile_picture).to be_attached
+    expect(failing.reload.profile_picture).not_to be_attached
+  end
+
+  it "does nothing when there are no CarrierWave pictures" do
+    expect { run_migration }.not_to raise_error
+  end
+end
