diff --git a/app/models/card/bursting.rb b/app/models/card/bursting.rb
new file mode 100644
index 0000000..e94ef5d
--- /dev/null
+++ b/app/models/card/bursting.rb
@@ -0,0 +1,52 @@
+# A card bursts when it draws a flurry of human attention: three or more comments from at
+# least two people within a third of the board's auto-close period, or when someone is
+# assigned to it or reopens it. Once it has burst, its stall clock starts and runs from the
+# last human activity. A card whose clock is two weeks old is stalled.
+module Card::Bursting
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+  BURST_COMMENT_COUNT = 3
+  BURST_PEOPLE_COUNT = 2
+
+  included do
+    scope :stalled, -> do
+      open.published.where.not(stall_clock_at: nil).where(stall_clock_at: ..STALL_PERIOD.ago)
+    end
+  end
+
+  def bursted?
+    stall_clock_at.present?
+  end
+
+  def stalled?
+    open? && published? && bursted? && stall_clock_at <= STALL_PERIOD.ago
+  end
+
+  def detect_burst_from_comment(comment)
+    if !bursted? && comment_burst?(comment.created_at)
+      record_burst
+    end
+  end
+
+  def detect_burst_from_event(event)
+    if !bursted? && (event.action.card_assigned? || event.action.card_reopened?)
+      record_burst
+    end
+  end
+
+  private
+    def comment_burst?(at)
+      recent = comments.by_user.where(created_at: (at - burst_window)..at)
+      recent.count >= BURST_COMMENT_COUNT && recent.distinct.count(:creator_id) >= BURST_PEOPLE_COUNT
+    end
+
+    def burst_window
+      (auto_postpone_period / 3).seconds
+    end
+
+    # The stall clock starts at the burst. Human activity restarts it via touch_last_active_at.
+    def record_burst
+      update! stall_clock_at: Time.current
+    end
+end
