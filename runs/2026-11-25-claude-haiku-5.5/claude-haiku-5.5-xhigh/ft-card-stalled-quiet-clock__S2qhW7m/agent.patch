diff --git a/test/models/card/bursting_test.rb b/test/models/card/bursting_test.rb
new file mode 100644
index 0000000..3a4a27e
--- /dev/null
+++ b/test/models/card/bursting_test.rb
@@ -0,0 +1,186 @@
+require "test_helper"
+
+class Card::BurstingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:buy_domain)
+  end
+
+  test "three comments from two people within a third of the auto-close period burst the card" do
+    @card.comments.create!(creator: users(:kevin), body: "One")
+    @card.comments.create!(creator: users(:david), body: "Two")
+    assert_not @card.reload.bursted?
+
+    @card.comments.create!(creator: users(:kevin), body: "Three")
+    assert @card.reload.bursted?
+  end
+
+  test "comments from a single person do not burst the card" do
+    3.times { |i| @card.comments.create!(creator: users(:kevin), body: "Solo #{i}") }
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "fewer than three comments do not burst the card" do
+    @card.comments.create!(creator: users(:kevin), body: "One")
+    @card.comments.create!(creator: users(:david), body: "Two")
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "comments outside a third of the auto-close period do not count together" do
+    # Writebook defaults to 90 days, so the burst window is 30 days.
+    @card.comments.create!(creator: users(:david), body: "Old", created_at: 31.days.ago)
+    @card.comments.create!(creator: users(:kevin), body: "Middle", created_at: 2.days.ago)
+    @card.comments.create!(creator: users(:david), body: "Now")
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "comments within a third of the auto-close period count together" do
+    @card.comments.create!(creator: users(:david), body: "Old", created_at: 29.days.ago)
+    @card.comments.create!(creator: users(:kevin), body: "Middle", created_at: 2.days.ago)
+    @card.comments.create!(creator: users(:david), body: "Now")
+
+    assert @card.reload.bursted?
+  end
+
+  test "the burst window follows the board's auto-close period" do
+    @card.board.update! auto_postpone_period: 30.days
+
+    # 30-day board: the burst window is 10 days.
+    @card.comments.create!(creator: users(:david), body: "Old", created_at: 11.days.ago)
+    @card.comments.create!(creator: users(:kevin), body: "Middle", created_at: 2.days.ago)
+    @card.comments.create!(creator: users(:david), body: "Now")
+    assert_not @card.reload.bursted?
+
+    @card.comments.create!(creator: users(:david), body: "Inside", created_at: 9.days.ago)
+    @card.comments.create!(creator: users(:kevin), body: "Latest")
+    assert @card.reload.bursted?
+  end
+
+  test "system comments do not count toward a burst" do
+    @card.comments.create!(creator: users(:kevin), body: "One")
+    @card.comments.create!(creator: users(:system), body: "System")
+    @card.comments.create!(creator: users(:david), body: "Two")
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "assigning someone bursts the card" do
+    card = cards(:text)
+    assert_not card.assigned_to?(users(:jz))
+
+    card.toggle_assignment(users(:jz))
+
+    assert card.reload.bursted?
+  end
+
+  test "unassigning someone does not burst the card" do
+    card = cards(:logo)
+    assert card.assigned_to?(users(:jz))
+
+    card.toggle_assignment(users(:jz))
+
+    assert_not card.reload.bursted?
+  end
+
+  test "reopening bursts the card" do
+    card = cards(:shipping)
+    assert card.closed?
+
+    card.reopen
+
+    assert card.reload.bursted?
+  end
+
+  test "a card is stalled two weeks after its last activity following a burst" do
+    freeze_time
+    @card.toggle_assignment(users(:jz))
+    assert @card.reload.bursted?
+
+    travel 13.days
+    assert_not @card.stalled?
+
+    travel 1.day
+    assert @card.stalled?
+  end
+
+  test "a card that never burst is not stalled" do
+    freeze_time
+    travel 3.weeks
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "any activity resets the stall timer" do
+    freeze_time
+    @card.toggle_assignment(users(:jz))
+
+    travel 10.days
+    @card.comments.create!(creator: users(:kevin), body: "Still here")
+
+    travel 13.days
+    assert_not @card.reload.stalled?
+
+    travel 1.day
+    assert @card.reload.stalled?
+  end
+
+  test "reactions are activity and reset the stall timer" do
+    freeze_time
+    burst_card_with_comments(@card)
+    comment = @card.comments.chronologically.first
+
+    travel 10.days
+    comment.reactions.create!(reacter: users(:kevin), content: "👍")
+
+    travel 13.days
+    assert_not @card.reload.stalled?
+
+    travel 1.day
+    assert @card.reload.stalled?
+  end
+
+  test "auto postponing does not restart the stall timer" do
+    freeze_time
+    @card.toggle_assignment(users(:jz))
+
+    travel 31.days
+    @card.auto_postpone(user: users(:system))
+
+    assert @card.reload.postponed?
+    assert @card.stalled?
+  end
+
+  test "closed cards are not stalled" do
+    freeze_time
+    @card.toggle_assignment(users(:jz))
+    @card.close
+
+    travel 3.weeks
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "postponed cards can still be stalled" do
+    freeze_time
+    @card.toggle_assignment(users(:jz))
+    @card.postpone
+
+    travel 3.weeks
+
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "stalled scope only includes stalled cards" do
+    freeze_time
+    @card.toggle_assignment(users(:jz))
+    travel 3.weeks
+
+    assert_equal [ @card ], Card.stalled.to_a
+  end
+end
