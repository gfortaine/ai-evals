diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..df96c93 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,38 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :incineratable, -> {
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    }
+
+    before_destroy :remember_unattached_blob_ids
+    after_destroy_commit :purge_unattached_blobs_later
+  end
+
+  def incineratable?
+    cancellation.present? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+  end
+
+  # Permanently deletes the account and everything in it, but only if it is still
+  # cancelled and past the grace period (it may have been reactivated since it was selected).
+  def incinerate
+    with_lock do
+      destroy! if incineratable?
+    end
+  end
+
+  private
+    # Attachments purge their own blobs as they're destroyed. Blobs that were never attached
+    # (e.g. abandoned direct uploads) are only reachable through the account, and have to be
+    # found before the cascade runs, since destroying attachments makes their blobs look unattached.
+    def remember_unattached_blob_ids
+      @unattached_blob_ids = ActiveStorage::Blob.where(account_id: id).unattached.ids
+    end
+
+    def purge_unattached_blobs_later
+      ActiveStorage::Blob.where(id: @unattached_blob_ids).find_each(&:purge_later)
+    end
 end
