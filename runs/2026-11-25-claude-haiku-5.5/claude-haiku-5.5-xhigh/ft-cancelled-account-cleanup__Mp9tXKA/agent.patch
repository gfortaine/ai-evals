index 0000000..4301676
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @user = users(:david)
+  end
+
+  test "incinerates accounts cancelled more than the grace period ago" do
+    due = accounts("37s")
+    cancel_account(due, at: 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(due.id)
+  end
+
+  test "leaves accounts that are still within the grace period, or active, alone" do
+    recently_cancelled = accounts(:initech)
+    cancel_account(recently_cancelled, at: 29.days.ago)
+    active = accounts(:acme)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(recently_cancelled.id)
+    assert Account.exists?(active.id)
+  end
+
+  test "keeps going when one account fails to incinerate" do
+    cancel_account(accounts("37s"), at: 31.days.ago)
+    cancel_account(accounts(:initech), at: 31.days.ago)
+    Account.any_instance.expects(:incinerate).raises(ActiveRecord::StatementInvalid, "boom").twice
+
+    assert_nothing_raised do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  private
+    def cancel_account(account, at:)
+      account.cancel(initiated_by: @user)
+      account.cancellation.update!(created_at: at)
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..d42a005
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,159 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+  end
+
+  test "incineratable scope includes accounts cancelled more than the grace period ago" do
+    cancel_account(@account, at: 31.days.ago)
+
+    assert_includes Account.incineratable, @account
+  end
+
+  test "incineratable scope excludes accounts cancelled within the grace period" do
+    cancel_account(@account, at: 29.days.ago)
+
+    assert_not_includes Account.incineratable, @account
+  end
+
+  test "incineratable scope excludes active accounts" do
+    assert_not_includes Account.incineratable, @account
+    assert_not_includes Account.incineratable, accounts(:initech)
+  end
+
+  test "incineratable? only once the grace period has fully elapsed" do
+    travel_to Time.zone.local(2026, 1, 1, 12) do
+      cancel_account(@account)
+    end
+
+    travel_to Time.zone.local(2026, 1, 31, 12) do
+      assert_not @account.reload.incineratable?
+    end
+
+    travel_to Time.zone.local(2026, 1, 31, 12, 0, 1) do
+      assert @account.reload.incineratable?
+    end
+  end
+
+  test "incinerate permanently deletes the account and all of its data" do
+    add_account_data(@account)
+    cancel_account(@account, at: 31.days.ago)
+    blob_keys = ActiveStorage::Blob.where(account_id: @account.id).pluck(:key)
+    filter_ids = Filter.where(account: @account).ids
+    assert_not_empty blob_keys
+    assert_not_empty filter_join_rows(filter_ids)
+
+    perform_enqueued_jobs(only: ActiveStorage::PurgeJob) do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_no_data_left_for(@account)
+    assert_empty filter_join_rows(filter_ids)
+    blob_keys.each { |key| assert_not ActiveStorage::Blob.service.exist?(key) }
+  end
+
+  test "incinerate leaves accounts within the grace period alone" do
+    add_account_data(@account)
+    cancel_account(@account, at: 29.days.ago)
+
+    assert_no_changes -> { Card.where(account: @account).count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate leaves active accounts alone" do
+    add_account_data(@account)
+
+    @account.incinerate
+
+    assert Account.exists?(@account.id)
+    assert_not_empty Card.where(account: @account)
+  end
+
+  test "incinerate leaves reactivated accounts alone" do
+    cancel_account(@account, at: 31.days.ago)
+    @account.reactivate
+
+    @account.incinerate
+
+    assert Account.exists?(@account.id)
+    assert_not @account.reload.cancelled?
+  end
+
+  test "incinerate leaves other accounts' data alone" do
+    other = accounts(:initech)
+    cards_before = Card.where(account: other).pluck(:id)
+    cancel_account(@account, at: 31.days.ago)
+
+    @account.incinerate
+
+    assert_equal cards_before.sort, Card.where(account: other).pluck(:id).sort
+    assert Account.exists?(other.id)
+  end
+
+  private
+    def cancel_account(account, at: nil)
+      account.cancel(initiated_by: @user)
+      account.cancellation.update!(created_at: at) if at
+    end
+
+    # Populates the account with the kinds of records a real account accumulates,
+    # including the ones that don't hang directly off the account.
+    def add_account_data(account)
+      stub_web_push_dns_resolution
+      user = account.users.find_by!(role: :owner)
+
+      Current.set(account: account, user: user) do
+        board = Board.create!(name: "Incineration board", creator: user, account: account)
+        board.publish
+
+        card = board.cards.create!(title: "Incineration card", creator: user, status: "published")
+        card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+        card.update!(description: "<p>Some text</p>")
+        card.steps.create!(content: "A step")
+        card.comments.create!(creator: user, body: "A comment")
+        card.postpone(user: user)
+        card.create_activity_spike!
+
+        ActiveStorage::Blob.create_and_upload!(io: StringIO.new("never attached"), filename: "orphan.txt", content_type: "text/plain")
+
+        Push::Subscription.create!(user: user, endpoint: "https://fcm.googleapis.com/fcm/send/incineration", p256dh_key: "key", auth_key: "auth")
+        Notification::Bundle.create!(user: user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+        Search::Query.create!(user: user, terms: "incineration")
+        Account::Import.create!(account: account, identity: user.identity, status: :completed)
+        Filter.create!(creator: user, account: account, fields: { indexed_by: :all, sorted_by: :newest }, tag_ids: [ tags(:mobile).id ])
+
+        account.materialize_storage
+        board.materialize_storage
+      end
+    end
+
+    # Rows in the has_and_belongs_to_many join tables (e.g. filters_tags) for the given filters
+    def filter_join_rows(filter_ids)
+      connection = ActiveRecord::Base.connection
+      ids = filter_ids.map { |id| connection.quote(Filter.type_for_attribute("id").serialize(id)) }
+      return [] if ids.empty?
+
+      Filter.reflect_on_all_associations(:has_and_belongs_to_many).flat_map do |reflection|
+        connection.select_rows("SELECT * FROM #{connection.quote_table_name(reflection.join_table)} WHERE #{connection.quote_column_name(reflection.foreign_key)} IN (#{ids.join(', ')})")
+      end
+    end
+
+    # Every table with an account_id column must have no rows for the account
+    def assert_no_data_left_for(account)
+      connection = ActiveRecord::Base.connection
+      account_id = connection.quote(Account.type_for_attribute("id").serialize(account.id))
+
+      counts = connection.tables.select { |table| connection.column_exists?(table, :account_id) }.to_h do |table|
+        [ table, connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{account_id}").to_i ]
+      end
+
+      assert_equal({}, counts.select { |_, count| count.positive? }, "Rows left behind for the incinerated account")
+      assert_not Storage::Total.where(owner_type: "Account", owner_id: account.id).exists?
+    end
+end
