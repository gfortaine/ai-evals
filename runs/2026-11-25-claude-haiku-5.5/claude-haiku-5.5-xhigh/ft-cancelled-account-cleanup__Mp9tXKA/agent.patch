diff --git a/app/jobs/account/incinerate_due_job.rb b/app/jobs/account/incinerate_due_job.rb
new file mode 100644
index 0000000..45eba70
--- /dev/null
+++ b/app/jobs/account/incinerate_due_job.rb
@@ -0,0 +1,13 @@
+class Account::IncinerateDueJob < ApplicationJob
+  queue_as :backend
+
+  def perform
+    Account.incineratable.find_each do |account|
+      # One failing account shouldn't stop the others. Its transaction rolls back, so it stays
+      # cancelled and the next run retries it.
+      Rails.error.handle do
+        Current.with_account(account) { account.incinerate }
+      end
+    end
+  end
+end
