@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @david = users(:david)
+    sign_in_as @david
+  end
+
+  test "create registers the device for the current user" do
+    assert_difference -> { @david.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@david), params: { push_subscription: subscription_params }, as: :json, headers: { "User-Agent" => "Firefox/128.0" }
+    end
+
+    assert_response :created
+    subscription = @david.push_subscriptions.find(@response.parsed_body["id"])
+    assert_equal "https://push.example.com/new-device", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal @david.account, subscription.account
+    assert_equal "Firefox/128.0", subscription.user_agent
+  end
+
+  test "create from a form post, the way the browser hands over the subscription" do
+    assert_difference -> { @david.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@david), params: { push_subscription: subscription_params }
+    end
+
+    assert_response :created
+  end
+
+  test "create again for the same device does not duplicate it" do
+    post user_push_subscriptions_path(@david), params: { push_subscription: subscription_params }, as: :json
+    first_id = @response.parsed_body["id"]
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@david), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_equal first_id, @response.parsed_body["id"]
+  end
+
+  test "create rejects a subscription without its keys" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@david), params: { push_subscription: subscription_params.except(:auth_key) }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create rejects an endpoint that is not https" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@david), params: { push_subscription: subscription_params.merge(endpoint: "http://push.example.com/new-device") }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create is forbidden for another user" do
+    kevin = users(:kevin)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(kevin), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy removes one of the current user's devices" do
+    subscription = push_subscriptions(:david_phone)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      delete user_push_subscription_path(@david, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy does not remove another user's device" do
+    subscription = push_subscriptions(:kevin_laptop)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      delete user_push_subscription_path(@david, subscription), as: :json
+    end
+
+    assert_response :not_found
+  end
+
+  test "destroy is forbidden for another user" do
+    subscription = push_subscriptions(:kevin_laptop)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      delete user_push_subscription_path(users(:kevin), subscription), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  private
+    def subscription_params
+      { endpoint: "https://push.example.com/new-device", p256dh_key: "p256dh-key", auth_key: "auth-key" }
+    end
+end
