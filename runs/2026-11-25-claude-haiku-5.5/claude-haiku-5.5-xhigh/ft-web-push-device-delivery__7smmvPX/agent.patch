diff --git a/app/models/notification/pushing.rb b/app/models/notification/pushing.rb
new file mode 100644
index 0000000..e90d743
--- /dev/null
+++ b/app/models/notification/pushing.rb
@@ -0,0 +1,57 @@
+module Notification::Pushing
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit -> { push_later }
+    after_update_commit -> { push_later }, if: :saved_change_to_source_id?
+  end
+
+  def push_later
+    if Push::Subscription.enabled? && user.push_subscriptions.exists?
+      Notification::PushJob.perform_later(self)
+    end
+  end
+
+  def push_now
+    message = push_message
+
+    user.push_subscriptions.each do |subscription|
+      subscription.push(message)
+    rescue StandardError => error
+      # One device failing shouldn't keep the others from getting the notification.
+      Rails.error.report(error, context: { push_subscription_id: subscription.id })
+    end
+  end
+
+  private
+    def push_message
+      { title: push_title, body: push_body, url: push_url, tag: id }
+    end
+
+    def push_title
+      case source
+      when Event then notification_helpers.event_notification_title(source)
+      when Mention then notification_helpers.mention_notification_title(source)
+      end
+    end
+
+    def push_body
+      case source
+      when Event then notification_helpers.event_notification_body(source)
+      when Mention then notification_helpers.mention_notification_body(source)
+      end
+    end
+
+    def push_url
+      Rails.application.routes.url_helpers.card_url(card, **base_url_options, script_name: account.slug)
+    end
+
+    def base_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options
+    end
+
+    def notification_helpers
+      ApplicationController.helpers
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..c5e3f84
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,72 @@
+class Push::Subscription < ApplicationRecord
+  self.table_name = "push_subscriptions"
+
+  TTL = 1.day
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: true
+  validates :endpoint, format: { with: %r{\Ahttps://[^/\s]+(/\S*)?\z}, message: "must be an https URL" }, allow_blank: true
+
+  class << self
+    def enabled?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    # A browser has one push endpoint, so turning notifications on for a device
+    # moves that endpoint to whoever is signed in on it.
+    def register(user:, user_agent:, endpoint: nil, p256dh_key: nil, auth_key: nil)
+      find_or_initialize_by(endpoint: endpoint).tap do |subscription|
+        subscription.update!(
+          user: user, account: user.account, user_agent: user_agent,
+          p256dh_key: p256dh_key, auth_key: auth_key
+        )
+      end
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"]
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"]
+    end
+  end
+
+  def push(message)
+    # The endpoint comes from the browser, but we're the ones who connect to it, so never send to a private address.
+    return unless public_endpoint?
+
+    WebPush.payload_send(
+      message: message.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      ttl: TTL.to_i,
+      open_timeout: 5,
+      read_timeout: 10,
+      vapid: vapid
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    # The push service no longer knows this endpoint, so it will never deliver again.
+    destroy
+  end
+
+  private
+    def public_endpoint?
+      SsrfProtection.resolve_public_ip(URI(endpoint).host).present?
+    rescue Resolv::ResolvError, Resolv::ResolvTimeout
+      # Can't tell right now, so skip this device rather than fail delivery to the rest of the user's devices.
+      false
+    end
+
+    def vapid
+      { subject: vapid_subject, public_key: self.class.vapid_public_key, private_key: self.class.vapid_private_key }
+    end
+
+    def vapid_subject
+      "mailto:#{Mail::Address.new(ApplicationMailer.default_params[:from]).address}"
+    end
+end
