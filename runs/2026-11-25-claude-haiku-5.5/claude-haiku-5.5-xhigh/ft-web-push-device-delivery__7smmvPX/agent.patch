diff --git a/test/models/notification/pushing_test.rb b/test/models/notification/pushing_test.rb
new file mode 100644
index 0000000..41f0514
--- /dev/null
+++ b/test/models/notification/pushing_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class Notification::PushingTest < ActiveSupport::TestCase
+  setup do
+    Push::Subscription.stubs(:enabled?).returns(true)
+  end
+
+  test "a new notification is pushed to the user's devices" do
+    subscribe(users(:jz))
+
+    assert_enqueued_with job: Notification::PushJob do
+      Notification.create!(user: users(:jz), source: events(:logo_published), creator: users(:david))
+    end
+  end
+
+  test "a notification that lands in the tray again is pushed again" do
+    notification = notifications(:layout_commented_kevin)
+    notification.read
+
+    assert_enqueued_with job: Notification::PushJob, args: [ notification ] do
+      notification.update!(source: events(:layout_assignment_jz), read_at: nil)
+    end
+  end
+
+  test "marking a notification read or unread does not push" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "nothing is pushed when push is not configured" do
+    Push::Subscription.stubs(:enabled?).returns(false)
+    subscribe(users(:jz))
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: users(:jz), source: events(:logo_published), creator: users(:david))
+    end
+  end
+
+  test "nothing is pushed to users without a device subscribed" do
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: users(:jz), source: events(:logo_published), creator: users(:david))
+    end
+  end
+
+  test "a device that fails does not stop the others getting the notification" do
+    stub_dns_resolution("93.184.216.34")
+    subscribe(users(:kevin), endpoint: "https://push.example.com/kevin-phone")
+    notification = notifications(:layout_commented_kevin)
+    unavailable = WebPush::PushServiceError.new(stub(body: "", inspect: "503"), "push.example.com")
+
+    WebPush.expects(:payload_send).with { |options| options[:endpoint] == "https://push.example.com/kevin-laptop" }.raises(unavailable)
+    WebPush.expects(:payload_send).with { |options| options[:endpoint] == "https://push.example.com/kevin-phone" }.once
+    Rails.error.expects(:report).once
+
+    notification.push_now
+  end
+
+  test "push_now sends the tray's title and body for a comment, linking to the card" do
+    notification = notifications(:layout_commented_kevin)
+    expected = {
+      title: "RE: Layout is broken",
+      body: comments(:layout_overflowing_david).body.to_plain_text.truncate(200),
+      url: card_url_for(notification.card),
+      tag: notification.id
+    }
+
+    Push::Subscription.any_instance.expects(:push).with(expected)
+
+    notification.push_now
+  end
+
+  test "push_now sends the tray's title and body for a mention" do
+    notification = notifications(:logo_mentioned_david)
+    expected = {
+      title: "JZ @mentioned you",
+      body: notification.source.source.mentionable_content.truncate(200),
+      url: card_url_for(notification.card),
+      tag: notification.id
+    }
+
+    Push::Subscription.any_instance.expects(:push).with(expected)
+
+    notification.push_now
+  end
+
+  private
+    def subscribe(user, endpoint: "https://push.example.com/#{user.id}")
+      Push::Subscription.register(
+        user: user, user_agent: "Safari", endpoint: endpoint,
+        p256dh_key: "p256dh", auth_key: "auth"
+      )
+    end
+
+    def card_url_for(card)
+      Rails.application.routes.url_helpers.card_url(
+        card, **Rails.application.config.action_mailer.default_url_options, script_name: card.account.slug
+      )
+    end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..937433d
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,167 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @endpoint = "https://push.example.com/new-device"
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  test "enabled only when both VAPID keys are configured" do
+    with_vapid_keys(public_key: nil, private_key: "private") { assert_not Push::Subscription.enabled? }
+    with_vapid_keys(public_key: "public", private_key: nil) { assert_not Push::Subscription.enabled? }
+    with_vapid_keys(public_key: "public", private_key: "private") { assert Push::Subscription.enabled? }
+  end
+
+  test "register creates a subscription for the user in their account" do
+    assert_difference -> { @kevin.push_subscriptions.count }, 1 do
+      Push::Subscription.register(
+        user: @kevin, user_agent: "Firefox", endpoint: @endpoint, p256dh_key: "p256dh", auth_key: "auth"
+      )
+    end
+
+    subscription = @kevin.push_subscriptions.find_by!(endpoint: @endpoint)
+    assert_equal @kevin.account, subscription.account
+    assert_equal "p256dh", subscription.p256dh_key
+    assert_equal "auth", subscription.auth_key
+    assert_equal "Firefox", subscription.user_agent
+  end
+
+  test "register again for the same endpoint updates the existing subscription" do
+    existing = push_subscriptions(:kevin_laptop)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      Push::Subscription.register(
+        user: @kevin, user_agent: "Chrome 132", endpoint: existing.endpoint, p256dh_key: "new-p256dh", auth_key: "new-auth"
+      )
+    end
+
+    assert_equal "new-p256dh", existing.reload.p256dh_key
+    assert_equal "Chrome 132", existing.user_agent
+  end
+
+  test "register moves an endpoint to the user who turned notifications on for it" do
+    existing = push_subscriptions(:david_phone)
+
+    Push::Subscription.register(
+      user: @kevin, user_agent: "Safari", endpoint: existing.endpoint, p256dh_key: "p256dh", auth_key: "auth"
+    )
+
+    assert_equal @kevin, existing.reload.user
+    assert_equal @kevin.account, existing.account
+    assert_not users(:david).push_subscriptions.exists?(existing.id)
+  end
+
+  test "register requires an https endpoint" do
+    assert_raises ActiveRecord::RecordInvalid do
+      Push::Subscription.register(user: @kevin, user_agent: nil, endpoint: "http://push.example.com/x", p256dh_key: "p256dh", auth_key: "auth")
+    end
+  end
+
+  test "register requires the subscription keys" do
+    assert_raises ActiveRecord::RecordInvalid do
+      Push::Subscription.register(user: @kevin, user_agent: nil, endpoint: @endpoint, p256dh_key: "", auth_key: "")
+    end
+  end
+
+  test "push sends the message encrypted for the subscription, signed with VAPID" do
+    subscription = push_subscriptions(:kevin_laptop)
+    message = { title: "Layout is broken", body: "Moved to Done by David", url: "https://example.com/cards/2", tag: "abc" }
+
+    with_vapid_keys(public_key: "public", private_key: "private") do
+      WebPush.expects(:payload_send).with do |options|
+        options[:endpoint] == subscription.endpoint &&
+          options[:p256dh] == subscription.p256dh_key &&
+          options[:auth] == subscription.auth_key &&
+          JSON.parse(options[:message]) == message.stringify_keys &&
+          options[:vapid][:public_key] == "public" &&
+          options[:vapid][:private_key] == "private" &&
+          options[:vapid][:subject].start_with?("mailto:")
+      end
+
+      subscription.push(message)
+    end
+  end
+
+  test "push never connects to an endpoint that resolves to a private address" do
+    subscription = push_subscriptions(:kevin_laptop)
+    stub_dns_resolution("10.0.0.5")
+
+    with_vapid_keys(public_key: "public", private_key: "private") do
+      WebPush.expects(:payload_send).never
+
+      subscription.push({ title: "Hello" })
+    end
+
+    assert subscription.reload.persisted?
+  end
+
+  test "push skips a device when its address can't be looked up right now" do
+    subscription = push_subscriptions(:kevin_laptop)
+    Resolv::DNS.stubs(:open).raises(Resolv::ResolvTimeout)
+
+    with_vapid_keys(public_key: "public", private_key: "private") do
+      WebPush.expects(:payload_send).never
+
+      subscription.push({ title: "Hello" })
+    end
+
+    assert subscription.reload.persisted?
+  end
+
+  test "push never connects to a loopback endpoint" do
+    subscription = push_subscriptions(:kevin_laptop)
+    stub_dns_resolution("127.0.0.1")
+
+    with_vapid_keys(public_key: "public", private_key: "private") do
+      WebPush.expects(:payload_send).never
+
+      subscription.push({ title: "Hello" })
+    end
+  end
+
+  test "push removes a subscription the push service says is gone" do
+    subscription = push_subscriptions(:kevin_laptop)
+    gone = WebPush::ExpiredSubscription.new(stub(body: "", inspect: "410 Gone"), "push.example.com")
+    WebPush.stubs(:payload_send).raises(gone)
+
+    with_vapid_keys(public_key: "public", private_key: "private") do
+      assert_difference -> { Push::Subscription.count }, -1 do
+        subscription.push({ title: "Hello" })
+      end
+    end
+  end
+
+  test "push removes a subscription the push service no longer recognizes" do
+    subscription = push_subscriptions(:kevin_laptop)
+    not_found = WebPush::InvalidSubscription.new(stub(body: "", inspect: "404 Not Found"), "push.example.com")
+    WebPush.stubs(:payload_send).raises(not_found)
+
+    with_vapid_keys(public_key: "public", private_key: "private") do
+      assert_difference -> { Push::Subscription.count }, -1 do
+        subscription.push({ title: "Hello" })
+      end
+    end
+  end
+
+  test "push keeps the subscription and raises on other failures so they surface" do
+    subscription = push_subscriptions(:kevin_laptop)
+    unavailable = WebPush::PushServiceError.new(stub(body: "", inspect: "503"), "push.example.com")
+    WebPush.stubs(:payload_send).raises(unavailable)
+
+    with_vapid_keys(public_key: "public", private_key: "private") do
+      assert_no_difference -> { Push::Subscription.count } do
+        assert_raises WebPush::PushServiceError do
+          subscription.push({ title: "Hello" })
+        end
+      end
+    end
+  end
+
+  private
+    def with_vapid_keys(public_key:, private_key:, &block)
+      Push::Subscription.stubs(:vapid_public_key).returns(public_key)
+      Push::Subscription.stubs(:vapid_private_key).returns(private_key)
+      yield
+    end
+end
