@@ -0,0 +1,110 @@
+require "application_system_test_case"
+
+class NotificationsPushTest < ApplicationSystemTestCase
+  # The test browser can't reach a real push service, so this stands in for the
+  # browser's Push API and permission state. The subscription survives page loads.
+  FAKE_BROWSER_PUSH = <<~JS
+    (() => {
+      const key = "fake-browser-push-subscription"
+      const endpoint = "https://push.example.com/browser-device"
+
+      const subscriptionIfSubscribed = () => {
+        if (localStorage.getItem(key)) {
+          return {
+            endpoint,
+            toJSON() { return { endpoint, keys: { p256dh: "p256dh-from-browser", auth: "auth-from-browser" } } },
+            async unsubscribe() { localStorage.removeItem(key); return true }
+          }
+        }
+      }
+
+      Object.defineProperty(Notification, "permission", { configurable: true, get: () => "%<permission>s" })
+      Notification.requestPermission = async () => "%<permission>s"
+
+      if ("%<push_manager>s" === "true") {
+        PushManager.prototype.getSubscription = async function () { return subscriptionIfSubscribed() }
+        PushManager.prototype.subscribe = async function () { localStorage.setItem(key, "1"); return subscriptionIfSubscribed() }
+      } else {
+        delete window.PushManager
+      }
+    })()
+  JS
+
+  setup do
+    Push::Subscription.stubs(:enabled?).returns(true)
+    Push::Subscription.stubs(:vapid_public_key).returns("vapid-public-key")
+    sign_in_as(users(:david))
+    page.execute_script("localStorage.clear()")
+  end
+
+  teardown do
+    if @fake_browser_push_script_id
+      page.driver.browser.execute_cdp("Page.removeScriptToEvaluateOnNewDocument", identifier: @fake_browser_push_script_id)
+    end
+  end
+
+  test "turning notifications on for this device registers it, and off removes it" do
+    add_fake_browser_push
+
+    visit notifications_settings_path
+    wait_for_notifications_controller
+    assert_text "Notifications are off on this device."
+
+    click_on "Turn on"
+    assert_text "Notifications are on for this device.", wait: 10
+    assert_includes users(:david).push_subscriptions.reload.pluck(:endpoint), "https://push.example.com/browser-device"
+
+    click_on "Turn off"
+    assert_text "Notifications are off on this device.", wait: 10
+    assert_not_includes users(:david).push_subscriptions.reload.pluck(:endpoint), "https://push.example.com/browser-device"
+  end
+
+  test "a device that is already subscribed shows as on, and the server keeps its record" do
+    add_fake_browser_push
+
+    visit notifications_settings_path
+    wait_for_notifications_controller
+    click_on "Turn on"
+    assert_text "Notifications are on for this device.", wait: 10
+
+    users(:david).push_subscriptions.where(endpoint: "https://push.example.com/browser-device").delete_all
+
+    visit notifications_settings_path
+    wait_for_notifications_controller
+    assert_text "Notifications are on for this device.", wait: 10
+    assert_includes users(:david).push_subscriptions.reload.pluck(:endpoint), "https://push.example.com/browser-device"
+  end
+
+  test "a browser that blocks notifications is told how to allow them" do
+    add_fake_browser_push(permission: "denied")
+
+    visit notifications_settings_path
+    wait_for_notifications_controller
+
+    assert_text "Notifications are blocked for Fizzy in this browser."
+    assert_no_button "Turn on"
+    assert_text "Turn on notifications for this website."
+  end
+
+  test "browsers without web push do not offer the switch" do
+    add_fake_browser_push(push_manager: false)
+
+    visit notifications_settings_path
+    wait_for_notifications_controller
+
+    assert_no_text "Notifications are off on this device."
+    assert_no_button "Turn on"
+  end
+
+  private
+    def add_fake_browser_push(permission: "granted", push_manager: true)
+      script = FAKE_BROWSER_PUSH % { permission: permission, push_manager: push_manager }
+      @fake_browser_push_script_id = page.driver.browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: script)["identifier"]
+    end
+
+    def wait_for_notifications_controller
+      Timeout.timeout(10) do
+        sleep 0.1 until page.evaluate_script("!!Stimulus.getControllerForElementAndIdentifier(document.querySelector('[data-controller~=notifications]'), 'notifications')")
+      end
+    end
+end
