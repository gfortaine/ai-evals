--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,26 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :ensure_current_user
+
+  def create
+    subscription = Push::Subscription.register(
+      user: Current.user, user_agent: request.user_agent, **subscription_params.to_h.symbolize_keys
+    )
+
+    render json: { id: subscription.id }, status: :created
+  end
+
+  def destroy
+    Current.user.push_subscriptions.find(params[:id]).destroy
+
+    head :no_content
+  end
+
+  private
+    def ensure_current_user
+      head :forbidden unless params[:user_id] == Current.user.id
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
