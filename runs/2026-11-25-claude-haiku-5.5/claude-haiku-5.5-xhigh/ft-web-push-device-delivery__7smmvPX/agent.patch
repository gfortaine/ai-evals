diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..63c68dc
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,90 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "status", "turnOn", "turnOff", "blocked", "details" ]
+  static values = { vapidPublicKey: String, subscriptionsUrl: String }
+
+  connect() {
+    this.refresh()
+  }
+
+  async turnOn() {
+    this.turnOnTarget.disabled = true
+
+    try {
+      if (await Notification.requestPermission() === "granted") {
+        const registration = await navigator.serviceWorker.ready
+        const subscription = await registration.pushManager.getSubscription() ?? await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.vapidPublicKeyValue
+        })
+
+        await this.#register(subscription)
+      }
+    } finally {
+      this.turnOnTarget.disabled = false
+      await this.refresh()
+    }
+  }
+
+  async turnOff() {
+    this.turnOffTarget.disabled = true
+
+    try {
+      const subscription = await this.#currentSubscription()
+      await subscription?.unsubscribe()
+
+      if (this.subscriptionId) {
+        await destroy(`${this.subscriptionsUrlValue}/${this.subscriptionId}`, { responseKind: "json" })
+        this.subscriptionId = null
+      }
+    } finally {
+      this.turnOffTarget.disabled = false
+      await this.refresh()
+    }
+  }
+
+  async refresh() {
+    const blocked = this.#supported && Notification.permission === "denied"
+
+    this.statusTarget.hidden = !this.#supported
+    this.turnOnTarget.hidden = blocked
+    this.blockedTarget.hidden = !blocked
+    this.detailsTargets.forEach((element) => element.hidden = !(blocked || !this.#supported))
+
+    const subscription = await this.#currentSubscription()
+
+    // Keep the server's record for this device in step with the browser's, so turning off can find it.
+    if (subscription && !this.subscriptionId) {
+      await this.#register(subscription)
+    }
+
+    this.element.classList.toggle("notifications--on", Boolean(subscription))
+    this.turnOffTarget.hidden = !subscription
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  async #currentSubscription() {
+    if (this.#supported && Notification.permission === "granted") {
+      const registration = await navigator.serviceWorker.ready
+      return await registration.pushManager.getSubscription()
+    }
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      const { id } = await response.json
+      this.subscriptionId = id
+    }
+  }
+}
