diff --git a/spec/support/cached_password_digest.rb b/spec/support/cached_password_digest.rb
new file mode 100644
index 0000000..5d65b2e
--- /dev/null
+++ b/spec/support/cached_password_digest.rb
@@ -0,0 +1,15 @@
+# frozen_string_literal: true
+
+# Devise hashes the password on every assignment (`password=`). bcrypt cannot go
+# below its minimum cost of 4, so each fabricated user spends about 1 ms hashing
+# the same password. Memoize the digest per plaintext for the test process. The
+# value is still a real bcrypt hash of that password, so `valid_password?` works
+# as before. Only identical passwords now share a salt.
+module CachedPasswordDigest
+  def digest(klass, password)
+    @digests ||= {}
+    @digests[[klass.stretches, klass.pepper, password]] ||= super
+  end
+end
+
+Devise::Encryptor.singleton_class.prepend(CachedPasswordDigest)
diff --git a/spec/support/skip_unsubscribed_webhook_serialization.rb b/spec/support/skip_unsubscribed_webhook_serialization.rb
new file mode 100644
index 0000000..3fcf754
--- /dev/null
+++ b/spec/support/skip_unsubscribed_webhook_serialization.rb
@@ -0,0 +1,45 @@
+# frozen_string_literal: true
+
+# WebhookService serializes the whole event payload before it looks up which
+# enabled webhooks subscribe to the event. Specs create many local statuses and
+# accounts without any webhook, where that payload is computed and then thrown
+# away. Skip the serialization only when no enabled webhook subscribes to the
+# event: the subscriber lookup still runs and the enqueued jobs (and so the
+# observable behaviour) are unchanged. This is test-only; the production code is
+# not modified.
+#
+# Enabled per example for the example types listed below (see the around hook).
+module SkipUnsubscribedWebhookSerialization
+  TYPES = %i(model request).freeze
+
+  class << self
+    attr_accessor :enabled
+  end
+
+  private
+
+  def webhooks_for_event
+    return super unless SkipUnsubscribedWebhookSerialization.enabled
+
+    @webhooks_for_event ||= super
+  end
+
+  def serialize_event
+    return super unless SkipUnsubscribedWebhookSerialization.enabled
+    return super if webhooks_for_event.any?
+
+    nil
+  end
+end
+
+WebhookService.prepend(SkipUnsubscribedWebhookSerialization)
+
+RSpec.configure do |config|
+  config.around do |example|
+    previous = SkipUnsubscribedWebhookSerialization.enabled
+    SkipUnsubscribedWebhookSerialization.enabled = SkipUnsubscribedWebhookSerialization::TYPES.include?(example.metadata[:type])
+    example.run
+  ensure
+    SkipUnsubscribedWebhookSerialization.enabled = previous
+  end
+end
