diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..866897b 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -2,8 +2,14 @@ module Card::Entropic
   extend ActiveSupport::Concern
 
   included do
+    # Same cards as `active`, with the closed and postponed checks as NOT IN subqueries instead of
+    # LEFT OUTER JOIN ... IS NULL. On SQLite, that join can make the planner scan closures (or
+    # card_not_nows) once per card when its statistics are stale, which is quadratic on large
+    # installs. NOT IN subqueries are materialized once and probed by index instead.
     scope :due_to_be_postponed, -> do
-      active
+      published
+        .where.not(id: Closure.select(:card_id))
+        .where.not(id: Card::NotNow.select(:card_id))
         .joins(board: :account)
         .left_outer_joins(board: :entropy)
         .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..defe85d 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -59,6 +59,30 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_not cards(:shipping).reload.postponed?
   end
 
+  test "auto postpone all due skips closed cards" do
+    cards(:logo).close
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+
+    assert_not_includes Card.due_to_be_postponed, cards(:logo)
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.closed?
+    assert_not cards(:logo).postponed?
+  end
+
+  test "auto postpone all due skips cards that are already postponed" do
+    cards(:logo).postpone
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+    original_not_now = cards(:logo).not_now
+
+    assert_not_includes Card.due_to_be_postponed, cards(:logo)
+
+    Card.auto_postpone_all_due
+
+    assert_equal original_not_now, cards(:logo).reload.not_now
+  end
+
   test "postponing soon scope" do
     cards(:logo, :shipping).each(&:published!)
 
