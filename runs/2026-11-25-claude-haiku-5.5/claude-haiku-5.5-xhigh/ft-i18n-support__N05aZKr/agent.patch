diff --git a/app/javascript/helpers/translations.js b/app/javascript/helpers/translations.js
new file mode 100644
index 0000000..53c5c2d
--- /dev/null
+++ b/app/javascript/helpers/translations.js
@@ -0,0 +1,33 @@
+// Strings that JavaScript builds itself. The server renders the current
+// locale's strings into a <script id="js-translations"> element (see
+// javascript_translations_tag), so they follow the language the person chose.
+let source = null
+let strings = {}
+
+function loadedStrings() {
+  const element = document.getElementById("js-translations")
+  const text = element ? element.textContent : "{}"
+
+  if (text !== source) {
+    source = text
+    strings = JSON.parse(text)
+  }
+
+  return strings
+}
+
+// Looks up "time.ago.year" and fills in %{name} placeholders. A string with
+// `one` and `other` forms is chosen by `count`.
+export function translate(key, values = {}) {
+  let value = key.split(".").reduce((node, part) => node?.[part], loadedStrings())
+
+  if (value && typeof value === "object") {
+    value = value[values.count === 1 ? "one" : "other"]
+  }
+
+  return String(value ?? key).replace(/%\{(\w+)\}/g, (_match, name) => values[name] ?? "")
+}
+
+export function intlLocale() {
+  return translate("intl_locale")
+}
