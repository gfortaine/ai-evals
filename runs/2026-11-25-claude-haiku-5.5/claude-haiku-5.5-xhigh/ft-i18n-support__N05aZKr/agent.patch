diff --git a/config/initializers/rails_pwa_locale.rb b/config/initializers/rails_pwa_locale.rb
new file mode 100644
index 0000000..ef37bec
--- /dev/null
+++ b/config/initializers/rails_pwa_locale.rb
@@ -0,0 +1,6 @@
+# The web app manifest is rendered by Rails' own PWA controller, which doesn't
+# include ApplicationController. Give it the same locale handling so the
+# manifest's names and descriptions follow the person's chosen language.
+Rails.application.config.to_prepare do
+  Rails::PwaController.include CurrentLocale unless Rails::PwaController.include?(CurrentLocale)
+end
