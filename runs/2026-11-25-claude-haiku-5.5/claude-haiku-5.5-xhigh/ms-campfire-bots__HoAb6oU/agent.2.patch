--- /dev/null
+++ b/test/jobs/bot/webhook_job_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Bot::WebhookJobTest < ActiveJob::TestCase
+  setup do
+    @room = rooms(:watercooler)
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://bot.example.com/hook")
+    @bot.memberships.create!(room: @room)
+    @message = @room.messages.create!(creator: users(:jason), body: "<div>Hey #{mention_attachment_for(@bot)}</div>")
+
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "calls the bot's webhook about the message" do
+    stub_request(:post, "https://bot.example.com/hook").to_return(status: 204)
+
+    perform_enqueued_jobs only: Bot::WebhookJob do
+      Bot::WebhookJob.perform_later(@bot, @message)
+    end
+
+    assert_requested :post, "https://bot.example.com/hook", times: 1
+  end
+
+  test "uses the webhook as it is when the job runs, so a removed webhook isn't called" do
+    Bot::WebhookJob.perform_later(@bot, @message)
+    @bot.update! webhook_url: nil
+
+    perform_enqueued_jobs only: Bot::WebhookJob
+
+    assert_not_requested :post, "https://bot.example.com/hook"
+  end
+
+  test "a message deleted before the job runs is dropped without an error" do
+    Bot::WebhookJob.perform_later(@bot, @message)
+    @message.destroy
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+end
diff --git a/test/models/bot/webhook_test.rb b/test/models/bot/webhook_test.rb
new file mode 100644
index 0000000..9908d5d
--- /dev/null
+++ b/test/models/bot/webhook_test.rb
@@ -0,0 +1,214 @@
+require "test_helper"
+
+class Bot::WebhookTest < ActiveSupport::TestCase
+  WEBHOOK_URL = "https://bot.example.com/hook"
+
+  setup do
+    @room = rooms(:watercooler)
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: WEBHOOK_URL)
+    @bot.memberships.create!(room: @room)
+
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "the webhook is sent the mention as JSON, from the bot's point of view" do
+    message = create_message("<div>#{mention(@bot)} restart the build please</div>")
+    payload = nil
+    stub_webhook(status: 204).with(headers: { "Content-Type" => "application/json" }) { |request| payload = JSON.parse(request.body) }
+
+    deliver message
+
+    assert_equal "mention", payload["event"]
+    assert_equal({ "id" => users(:jason).id, "name" => "Jason" }, payload["author"])
+    assert_equal({ "id" => @room.id, "name" => @room.name, "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_key}/messages" }, payload["room"])
+    assert_equal message.id, payload["message"]["id"]
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", payload["message"]["link"]
+  end
+
+  test "the text is the message with the bot's own mention removed" do
+    assert_equal "restart the build please", payload_for("<div>#{mention(@bot)} restart the build please</div>")["message"]["body"]["text"]
+    assert_equal "Hey restart the build please", payload_for("<div>Hey #{mention(@bot)} restart the build please</div>")["message"]["body"]["text"]
+    assert_equal "restart the build", payload_for("<div>restart the build #{mention(@bot)}</div>")["message"]["body"]["text"]
+  end
+
+  test "mentions of other people stay in the text" do
+    text = payload_for("<div>#{mention(@bot)} ask #{mention(users(:kevin))} to check</div>")["message"]["body"]["text"]
+
+    assert_equal "ask @Kevin to check", text
+  end
+
+  test "the html is the whole rich text body, with the bot's mention in it" do
+    html = payload_for("<div>#{mention(@bot)} restart the build please</div>")["message"]["body"]["html"]
+
+    assert_includes html, %(<action-text-attachment sgid="#{@bot.attachable_sgid}")
+    assert_includes html, "restart the build please"
+  end
+
+  test "a webhook on plain HTTP is called without TLS" do
+    @bot.update! webhook_url: "http://bot.example.com/hook"
+    message = create_message("<div>#{mention(@bot)} ping</div>")
+    stub_request(:post, "http://bot.example.com/hook").to_return(status: 204)
+
+    deliver message
+
+    assert_requested :post, "http://bot.example.com/hook", times: 1
+  end
+
+  test "a 200 text/plain reply is posted into the room as the bot's message" do
+    message = create_message("<div>#{mention(@bot)} status?</div>")
+    stub_webhook(status: 200, body: "Build 42 is green ✅\n<b>Deployed</b> to staging", content_type: "text/plain; charset=utf-8")
+
+    assert_difference -> { @room.messages.count }, +1 do
+      deliver message
+    end
+
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal "Build 42 is green ✅\n<b>Deployed</b> to staging", reply.plain_text_body
+  end
+
+  test "a 200 text/html reply is posted as rich text into the room as the bot's message" do
+    message = create_message("<div>#{mention(@bot)} status?</div>")
+    stub_webhook(status: 200, body: "<div><strong>Build 42</strong> is green</div>", content_type: "text/html")
+
+    deliver message
+
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal "Build 42 is green", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "<strong>Build 42</strong>"
+  end
+
+  test "a 200 text/html reply is sanitized before it's stored" do
+    message = create_message("<div>#{mention(@bot)} status?</div>")
+    stub_webhook(status: 200, body: %(<div><strong>Build 42</strong><script>alert(1)</script><img src="x" onerror="alert(2)"> is green</div>), content_type: "text/html")
+
+    deliver message
+
+    stored = @room.messages.last.body.body.to_html
+    assert_includes stored, "<strong>Build 42</strong>"
+    assert_no_match(/script|onerror/, stored)
+  end
+
+  test "a reply is broadcast to the room and queues push notifications like any message" do
+    message = create_message("<div>#{mention(@bot)} status?</div>")
+    stub_webhook(status: 200, body: "Green", content_type: "text/plain")
+
+    assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+      assert_enqueued_with job: Room::PushMessageJob do
+        deliver message
+      end
+    end
+  end
+
+  test "a 204 posts nothing" do
+    message = create_message("<div>#{mention(@bot)} ping</div>")
+    stub_webhook(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      deliver message
+    end
+  end
+
+  test "a 200 that isn't text posts nothing" do
+    message = create_message("<div>#{mention(@bot)} ping</div>")
+    stub_webhook(status: 200, body: %({"text":"pong"}), content_type: "application/json")
+
+    assert_no_difference -> { Message.count } do
+      deliver message
+    end
+  end
+
+  test "a 200 with only whitespace posts nothing" do
+    message = create_message("<div>#{mention(@bot)} ping</div>")
+    stub_webhook(status: 200, body: " \n\t ", content_type: "text/plain")
+
+    assert_no_difference -> { Message.count } do
+      deliver message
+    end
+  end
+
+  test "errors and redirects post nothing, and redirects aren't followed" do
+    message = create_message("<div>#{mention(@bot)} ping</div>")
+    stub_webhook(status: 500, body: "pong", content_type: "text/plain")
+
+    assert_no_difference -> { Message.count } do
+      deliver message
+    end
+
+    stub_webhook(status: 302, headers: { "Location" => "https://elsewhere.example.com/hook" })
+    stub_request(:post, "https://elsewhere.example.com/hook").to_return(status: 200, body: "pong", headers: { "Content-Type" => "text/plain" })
+
+    assert_no_difference -> { Message.count } do
+      deliver message
+    end
+    assert_not_requested :post, "https://elsewhere.example.com/hook"
+  end
+
+  test "a reply that's too big to be a message posts nothing" do
+    message = create_message("<div>#{mention(@bot)} ping</div>")
+    stub_webhook(status: 200, body: "a" * (Bot::Webhook::MAX_REPLY_SIZE + 1), content_type: "text/plain")
+
+    assert_no_difference -> { Message.count } do
+      deliver message
+    end
+  end
+
+  test "a webhook that doesn't answer in time posts nothing and doesn't break delivery" do
+    message = create_message("<div>#{mention(@bot)} ping</div>")
+    stub_request(:post, WEBHOOK_URL).to_timeout
+
+    assert_no_difference -> { Message.count } do
+      assert_nothing_raised { deliver message }
+    end
+  end
+
+  test "webhooks on private networks are never called" do
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "127.0.0.1" ])
+    message = create_message("<div>#{mention(@bot)} ping</div>")
+    stub_webhook(status: 200, body: "pong", content_type: "text/plain")
+
+    assert_no_difference -> { Message.count } do
+      deliver message
+    end
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "a bot that has left the room isn't called" do
+    message = create_message("<div>#{mention(@bot)} ping</div>")
+    @bot.memberships.delete_all
+    stub_webhook(status: 200, body: "pong", content_type: "text/plain")
+
+    deliver message
+
+    assert_not_requested :post, WEBHOOK_URL
+    assert_equal 0, @room.messages.where(creator: @bot).count
+  end
+
+  private
+    def create_message(body)
+      @room.messages.create!(creator: users(:jason), body: body)
+    end
+
+    def deliver(message)
+      Bot::Webhook.new(bot: @bot, message: message).deliver
+    end
+
+    def mention(user)
+      mention_attachment_for(user)
+    end
+
+    def stub_webhook(status:, body: nil, content_type: nil, headers: {})
+      headers = headers.merge("Content-Type" => content_type) if content_type
+      stub_request(:post, WEBHOOK_URL).to_return(status: status, body: body, headers: headers)
+    end
+
+    def payload_for(body)
+      payload = nil
+      stub_webhook(status: 204).with { |request| payload = JSON.parse(request.body) }
+
+      deliver create_message(body)
+
+      payload
+    end
+end
