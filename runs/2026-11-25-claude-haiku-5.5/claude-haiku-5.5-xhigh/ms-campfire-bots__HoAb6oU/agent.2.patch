diff --git a/test/models/room/bot_webhooks_test.rb b/test/models/room/bot_webhooks_test.rb
new file mode 100644
index 0000000..bfaab62
--- /dev/null
+++ b/test/models/room/bot_webhooks_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Room::BotWebhooksTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @room = rooms(:watercooler)
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://bot.example.com/hook")
+    @bot.memberships.create!(room: @room)
+  end
+
+  test "mentioning a bot with a webhook queues a webhook call for that bot" do
+    message = nil
+
+    assert_enqueued_jobs 1, only: Bot::WebhookJob do
+      message = create_message("<div>Hey #{mention(@bot)}</div>")
+    end
+
+    assert_enqueued_with job: Bot::WebhookJob, args: [ @bot, message ]
+  end
+
+  test "mentioning several bots queues one webhook call for each" do
+    other_bot = Bot.create!(name: "Build Bot", creator: users(:david), webhook_url: "https://build.example.com/hook")
+    other_bot.memberships.create!(room: @room)
+
+    assert_enqueued_jobs 2, only: Bot::WebhookJob do
+      create_message("<div>#{mention(@bot)} and #{mention(other_bot)}</div>")
+    end
+  end
+
+  test "mentioning a person, or a bot without a webhook, queues nothing" do
+    bot_without_webhook = Bot.create!(name: "Quiet Bot", creator: users(:david))
+    bot_without_webhook.memberships.create!(room: @room)
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      create_message("<div>Hey #{mention(users(:kevin))} and #{mention(bot_without_webhook)}</div>")
+    end
+  end
+
+  test "mentioning a bot that isn't in the room queues nothing" do
+    bot_elsewhere = Bot.create!(name: "Pets Bot", creator: users(:david), webhook_url: "https://pets.example.com/hook")
+    bot_elsewhere.memberships.where(room: @room).delete_all
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      create_message("<div>Hey #{mention(bot_elsewhere)}</div>")
+    end
+  end
+
+  test "messages without a mention queue nothing" do
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      create_message("<div>Just talking</div>")
+    end
+  end
+
+  test "bots don't call webhooks for each other's messages, so they can't loop" do
+    other_bot = Bot.create!(name: "Build Bot", creator: users(:david), webhook_url: "https://build.example.com/hook")
+    other_bot.memberships.create!(room: @room)
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      @room.messages.create!(creator: @bot, body: "<div>Ping #{mention(other_bot)}</div>")
+    end
+  end
+
+  test "posting a mention doesn't call the webhook, which only the queued job does later" do
+    stub_request(:post, "https://bot.example.com/hook").to_return(status: 200, body: "pong", headers: { "Content-Type" => "text/plain" })
+
+    create_message("<div>Hey #{mention(@bot)}</div>")
+
+    assert_not_requested :post, "https://bot.example.com/hook"
+  end
+
+  private
+    def create_message(body)
+      @room.messages.create!(creator: users(:jason), body: body)
+    end
+
+    def mention(user)
+      mention_attachment_for(user)
+    end
+end
