+  end
+
+  test "index says so when you have no bots yet" do
+    sign_in :kevin
+
+    get bots_url
+
+    assert_select "#bots li", text: "No chat bots yet."
+  end
+
+  test "index doesn't list other people's bots" do
+    other_bot = Bot.create!(name: "Someone Else's Bot", creator: users(:kevin))
+
+    get bots_url
+
+    assert_select "li#bot_#{other_bot.id}", count: 0
+    assert_no_match other_bot.bot_key, response.body
+  end
+
+  test "index lists every bot for administrators" do
+    other_bot = Bot.create!(name: "Kevin's Bot", creator: users(:kevin))
+    sign_in :david
+
+    get bots_url
+
+    assert_select "li#bot_#{@bot.id}"
+    assert_select "li#bot_#{other_bot.id}"
+  end
+
+  test "index lists all of your bots on one page" do
+    30.times { |i| Bot.create!(name: "Bot #{i}", creator: users(:jz)) }
+
+    get bots_url
+
+    assert_select "li.membership-item", count: 31
+    assert_select "a[href*='page=']", count: 0
+  end
+
+  test "index isn't stored by browsers or caches, since it shows bot codes" do
+    get bots_url
+
+    assert_includes response.headers["Cache-Control"], "no-store"
+    assert_select "meta[name=?][content=?]", "turbo-cache-control", "no-cache"
+  end
+
+  test "index links to adding a bot and to editing each bot" do
+    get bots_url
+
+    assert_select "form[action=?][method=get] button", new_bot_path, text: /Add a chat bot/
+    assert_select "a[href=?][aria-label=?]", edit_bot_path(@bot), "Edit Deploy Bot"
+  end
+
+  test "new shows the bot form" do
+    get new_bot_url
+
+    assert_response :success
+    assert_select "form[action=?][method=post]", bots_path do
+      assert_select "input[type=file][name=?]", "bot[avatar]"
+      assert_select "input[name=?][required][placeholder=?]", "bot[name]", "Name the bot"
+      assert_select "button[type=submit]", text: /Save changes/
+    end
+  end
+
+  test "create adds a bot created by you and returns to the bots list" do
+    assert_difference -> { users(:jz).bots.count }, +1 do
+      post bots_url, params: { bot: { name: "Build Bot" } }
+    end
+
+    bot = Bot.find_by!(name: "Build Bot")
+    assert_redirected_to bots_url
+    assert_equal users(:jz), bot.creator
+    assert bot.bot_key.present?
+  end
+
+  test "create accepts an avatar" do
+    post bots_url, params: { bot: { name: "Build Bot", avatar: fixture_file_upload("moon.jpg", "image/jpeg") } }
+
+    assert Bot.find_by!(name: "Build Bot").avatar.attached?
+  end
+
+  test "create without a name shows the error and creates nothing" do
+    assert_no_difference -> { Bot.count } do
+      post bots_url, params: { bot: { name: "" } }
+    end
+
+    assert_response :unprocessable_content
+    assert_select "div.flash", text: /Name can't be blank/
+  end
+
+  test "edit shows the form and a delete button that asks for confirmation" do
+    get edit_bot_url(@bot)
+
+    assert_response :success
+    assert_select "input[name=?][value=?]", "bot[name]", "Deploy Bot"
+    assert_select "form[action=?] input[name=_method][value=delete]", bot_path(@bot)
+    assert_select "button[aria-label=?][data-turbo-confirm]", "Delete this chat bot", text: /Delete this chat bot/
+  end
+
+  test "edit doesn't show the bot code" do
+    get edit_bot_url(@bot)
+
+    assert_no_match @bot.bot_key, response.body
+  end
+
+  test "update changes the name" do
+    patch bot_url(@bot), params: { bot: { name: "Release Bot" } }
+
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", @bot.reload.name
+  end
+
+  test "update keeps the avatar when no new one is uploaded" do
+    @bot.update! avatar: fixture_file_upload("moon.jpg", "image/jpeg")
+
+    patch bot_url(@bot), params: { bot: { name: "Release Bot", avatar: "" } }
+
+    assert_redirected_to bots_url
+    assert @bot.reload.avatar.attached?
+  end
+
+  test "update with a blank name shows the error" do
+    patch bot_url(@bot), params: { bot: { name: "" } }
+
+    assert_response :unprocessable_content
+    assert_equal "Deploy Bot", @bot.reload.name
+  end
+
+  test "destroy deletes the bot's code and removes it from the list" do
+    bot_key = @bot.bot_key
+
+    delete bot_url(@bot)
+
+    assert_redirected_to bots_url
+    assert @bot.reload.deactivated?
+    assert_nil Bot.active.find_by(bot_key: bot_key)
+
+    get bots_url
+    assert_select "li#bot_#{@bot.id}", count: 0
+  end
+
+  test "you can't edit, update or delete someone else's bot" do
+    other_bot = Bot.create!(name: "Kevin's Bot", creator: users(:kevin))
+
+    assert_raises(ActiveRecord::RecordNotFound) { get edit_bot_url(other_bot) }
+
+    assert_raises(ActiveRecord::RecordNotFound) { patch bot_url(other_bot), params: { bot: { name: "Mine now" } } }
+    assert_equal "Kevin's Bot", other_bot.reload.name
+
+    assert_raises(ActiveRecord::RecordNotFound) { delete bot_url(other_bot) }
+    assert other_bot.reload.active?
+  end
+
+  test "administrators can manage any bot" do
+    other_bot = Bot.create!(name: "Kevin's Bot", creator: users(:kevin))
+    sign_in :david
+
+    patch bot_url(other_bot), params: { bot: { name: "Renamed" } }
+
+    assert_redirected_to bots_url
+    assert_equal "Renamed", other_bot.reload.name
+  end
+
+  test "account settings link to the bots page for every member" do
+    sign_in :kevin
+
+    get edit_account_url
+
+    assert_select "a[href=?][aria-label=?]", bots_path, "Set up chat bots"
+  end
+
+  test "the people list on account settings leaves bots out" do
+    Bot.create!(name: "Zeta Bot", creator: users(:jz))
+
+    get edit_account_url
+
+    assert_no_match "Zeta Bot", response.body
+  end
+end
