+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @room = rooms(:watercooler)
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+    @bot.memberships.create!(room: @room)
+  end
+
+  test "a raw request body is posted as the bot's message" do
+    assert_difference -> { @room.messages.count }, +1 do
+      post bot_messages_url(room_id: @room.id, bot_key: @bot.bot_key), params: "Deploy of v1.2.3 finished ✅",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    message = @room.messages.last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal @bot, message.creator
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+  end
+
+  test "curl's default form content type is still a raw message, even with characters forms would reject" do
+    post bot_messages_url(room_id: @room.id, bot_key: @bot.bot_key), params: "100% done, a=b&c=d",
+      headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded", "HTTP_USER_AGENT" => "curl/8.5.0" }
+
+    assert_response :created
+    assert_equal "100% done, a=b&c=d", @room.messages.last.plain_text_body
+  end
+
+  test "a JSON body is posted as text, without an envelope" do
+    post bot_messages_url(room_id: @room.id, bot_key: @bot.bot_key), params: %({"text":"hi"}),
+      headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :created
+    assert_equal %({"text":"hi"}), @room.messages.last.plain_text_body
+  end
+
+  test "markup in the body is shown as text and line breaks are kept" do
+    post bot_messages_url(room_id: @room.id, bot_key: @bot.bot_key), params: "<b>build</b> ok\nline two\r\nline three",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+
+    message = @room.messages.last
+    assert_equal "<b>build</b> ok\nline two\nline three", message.plain_text_body
+    assert_no_match %r{<b>}, message.body.to_s
+  end
+
+  test "posting broadcasts the message to the room, authored by the bot" do
+    post bot_messages_url(room_id: @room.id, bot_key: @bot.bot_key), params: "Deploy finished",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__body", text: /Deploy finished/
+      assert_select ".message__author strong", text: @bot.name
+    end
+  end
+
+  test "posting broadcasts unread room to each member other than the bot" do
+    @room.users.each do |member|
+      next if member == @bot
+
+      assert_broadcasts UnreadRoomsChannel.stream_name_for(member.id), 1 do
+        post bot_messages_url(room_id: @room.id, bot_key: @bot.bot_key), params: "Hello #{member.id}",
+          headers: { "CONTENT_TYPE" => "text/plain" }
+      end
+    end
+  end
+
+  test "posting queues push notifications just as a person's message does" do
+    assert_enqueued_with job: Room::PushMessageJob do
+      post bot_messages_url(room_id: @room.id, bot_key: @bot.bot_key), params: "Deploy finished",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+  end
+
+  test "a multipart upload posts its file as an attachment with the body field as text" do
+    file = fixture_file_upload("moon.jpg", "image/jpeg")
+
+    post bot_messages_url(room_id: @room.id, bot_key: @bot.bot_key), params: { attachment: file, body: "Build artifact" }
+
+    message = @room.messages.last
+    assert_response :created
+    assert_equal @bot, message.creator
+    assert message.attachment?
+    assert_equal "Build artifact", message.plain_text_body
+  end
+
+  test "a multipart upload can be an attachment without any text" do
+    post bot_messages_url(room_id: @room.id, bot_key: @bot.bot_key), params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+
+    assert_response :created
+    assert @room.messages.last.attachment?
+  end
+
+  test "an attachment-like string isn't treated as an upload" do
+    post bot_messages_url(room_id: @room.id, bot_key: @bot.bot_key), params: "attachment=not-a-file",
+      headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+
+    assert_response :created
+    assert_not @room.messages.last.attachment?
+  end
+
+  test "an empty body without an attachment is unprocessable" do
+    assert_no_difference -> { Message.count } do
+      post bot_messages_url(room_id: @room.id, bot_key: @bot.bot_key), params: "",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "a body of only whitespace is unprocessable" do
+    post bot_messages_url(room_id: @room.id, bot_key: @bot.bot_key), params: " \n\t ",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :unprocessable_content
+  end
+
+  test "an unknown bot code is unauthorized and posts nothing" do
+    assert_no_difference -> { Message.count } do
+      post bot_messages_url(room_id: @room.id, bot_key: "not-a-real-code"), params: "Hello",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "the code of a deleted bot is unauthorized" do
+    bot_key = @bot.bot_key
+    @bot.deactivate
+
+    post bot_messages_url(room_id: @room.id, bot_key: bot_key), params: "Hello",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :unauthorized
+  end
+
+  test "a room that doesn't exist is not found" do
+    post bot_messages_url(room_id: 0, bot_key: @bot.bot_key), params: "Hello",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :not_found
+  end
+
+  test "a room the bot isn't a member of is not found" do
+    closed_room = Rooms::Closed.create!(name: "Private", creator: users(:david))
+    assert_not closed_room.users.include?(@bot)
+
+    assert_no_difference -> { Message.count } do
+      post bot_messages_url(room_id: closed_room.id, bot_key: @bot.bot_key), params: "Hello",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    assert_response :not_found
+  end
+
+  test "bots post without a session or a CSRF token" do
+    with_forgery_protection do
+      post bot_messages_url(room_id: @room.id, bot_key: @bot.bot_key), params: "Hello",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    assert_response :created
+  end
+
+  test "bot codes are filtered from the parameters that get logged" do
+    post bot_messages_url(room_id: @room.id, bot_key: @bot.bot_key), params: "Hello",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_equal "[FILTERED]", request.filtered_parameters["bot_key"]
+    assert_not_includes request.filtered_path, @bot.bot_key
+  end
+
+  private
+    def with_forgery_protection
+      original, ActionController::Base.allow_forgery_protection = ActionController::Base.allow_forgery_protection, true
+      yield
+    ensure
+      ActionController::Base.allow_forgery_protection = original
+    end
+end
