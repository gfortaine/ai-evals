diff --git a/test/lib/middleware/bot_plain_text_bodies_test.rb b/test/lib/middleware/bot_plain_text_bodies_test.rb
new file mode 100644
index 0000000..81445f2
--- /dev/null
+++ b/test/lib/middleware/bot_plain_text_bodies_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class BotPlainTextBodiesTest < ActiveSupport::TestCase
+  setup do
+    @seen = nil
+    @app = ->(env) { @seen = env.slice("CONTENT_TYPE"); [ 200, {}, [] ] }
+    @middleware = BotPlainTextBodies.new(@app)
+  end
+
+  test "bot message posts are relabelled as plain text" do
+    call "POST", "/rooms/12/AbC123/messages", "application/x-www-form-urlencoded"
+
+    assert_equal "text/plain", @seen["CONTENT_TYPE"]
+  end
+
+  test "multipart uploads keep their label so their attachments can be parsed" do
+    call "POST", "/rooms/12/AbC123/messages", "multipart/form-data; boundary=xyz"
+
+    assert_equal "multipart/form-data; boundary=xyz", @seen["CONTENT_TYPE"]
+  end
+
+  test "other requests keep their label" do
+    call "POST", "/rooms/12/messages", "application/x-www-form-urlencoded"
+    assert_equal "application/x-www-form-urlencoded", @seen["CONTENT_TYPE"]
+
+    call "GET", "/rooms/12/AbC123/messages", "application/x-www-form-urlencoded"
+    assert_equal "application/x-www-form-urlencoded", @seen["CONTENT_TYPE"]
+  end
+
+  private
+    def call(method, path, content_type)
+      @middleware.call Rack::MockRequest.env_for(path, method: method, input: "100%", "CONTENT_TYPE" => content_type)
+    end
+end
