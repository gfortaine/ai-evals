+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+  end
+
+  test "bytes used is zero for an account without countable attachments" do
+    assert_equal 0, accounts(:initech).bytes_used
+  end
+
+  test "sums the usage of all boards of the account" do
+    cards(:logo).update!(description: embed(create_blob(1_000)))
+    cards(:buy_domain).update!(description: embed(create_blob(2_000)))
+    boards(:private).update!(public_description: embed(create_blob(4_000)))
+    perform_storage_refreshes
+
+    assert_equal 7_000, @account.reload.bytes_used
+  end
+
+  test "does not include usage from other accounts" do
+    cards(:radio).update!(description: embed(create_blob(1_000)))
+    perform_storage_refreshes
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "destroying the account leaves no refreshes to fail" do
+    cards(:logo).update!(description: embed(create_blob(1_000)))
+
+    assert_nothing_raised do
+      @account.destroy!
+      perform_storage_refreshes
+    end
+  end
+
+  test "refresh_bytes_used_now recalculates the stored value from the boards" do
+    boards(:writebook).update_column :bytes_used, 500
+    @account.update_column :bytes_used, 42
+
+    @account.refresh_bytes_used_now
+
+    assert_equal 500, @account.reload.bytes_used
+  end
+end
