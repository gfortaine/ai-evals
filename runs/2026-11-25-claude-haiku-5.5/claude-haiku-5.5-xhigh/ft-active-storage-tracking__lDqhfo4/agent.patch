+module StorageTestHelper
+  def create_blob(size)
+    ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x" * size), filename: "file.txt", content_type: "text/plain")
+  end
+
+  def embed(blob)
+    %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+  end
+
+  # Refreshing a board enqueues a refresh of its account, so storage refreshes are performed in two passes.
+  def perform_storage_refreshes
+    2.times { perform_enqueued_jobs(only: [ Board::RefreshBytesUsedJob, Account::RefreshBytesUsedJob ]) }
+  end
+end
