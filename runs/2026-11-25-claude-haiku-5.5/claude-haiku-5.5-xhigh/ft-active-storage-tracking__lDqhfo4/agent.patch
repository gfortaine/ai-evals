@@ -0,0 +1,205 @@
+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "bytes used is zero when nothing countable is attached" do
+    assert_equal 0, boards(:private).bytes_used
+  end
+
+  test "counts card images" do
+    image = file_fixture("moon.jpg")
+
+    @card.image.attach(io: image.open, filename: "moon.jpg")
+    perform_storage_refreshes
+
+    assert_equal image.size, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in card descriptions" do
+    @card.update!(description: embed(create_blob(1_000)))
+    perform_storage_refreshes
+
+    assert_equal 1_000, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in comments on the board's cards" do
+    @card.comments.create!(creator: users(:david), body: embed(create_blob(2_000)))
+    perform_storage_refreshes
+
+    assert_equal 2_000, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in the board description" do
+    @board.update!(public_description: embed(create_blob(3_000)))
+    perform_storage_refreshes
+
+    assert_equal 3_000, @board.reload.bytes_used
+  end
+
+  test "sums everything counted on the board and its cards" do
+    image = file_fixture("moon.jpg")
+    @card.image.attach(io: image.open, filename: "moon.jpg")
+    @card.update!(description: embed(create_blob(1_000)))
+    @card.comments.create!(creator: users(:david), body: embed(create_blob(2_000)))
+    @board.update!(public_description: embed(create_blob(4_000)))
+    perform_storage_refreshes
+
+    assert_equal image.size + 7_000, @board.reload.bytes_used
+  end
+
+  test "ignores attachments on other boards" do
+    other_card = cards(:radio)
+    other_card.update!(description: embed(create_blob(5_000)))
+    perform_storage_refreshes
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 5_000, other_card.board.reload.bytes_used
+  end
+
+  test "ignores attachments that are not card images or rich text" do
+    users(:david).avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png")
+    perform_storage_refreshes
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "stops counting files once they are removed from a description" do
+    @card.update!(description: embed(create_blob(1_000)))
+    perform_storage_refreshes
+    assert_equal 1_000, @board.reload.bytes_used
+
+    @card.update!(description: "No more files here")
+    perform_storage_refreshes
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "stops counting files once they are removed from a comment" do
+    comment = @card.comments.create!(creator: users(:david), body: embed(create_blob(2_000)))
+    perform_storage_refreshes
+    assert_equal 2_000, @board.reload.bytes_used
+
+    comment.update!(body: "Never mind")
+    perform_storage_refreshes
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "stops counting card images once removed" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    perform_storage_refreshes
+    assert_equal file_fixture("moon.jpg").size, @board.reload.bytes_used
+
+    @card.image_attachment.destroy
+    perform_storage_refreshes
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "purging a card image stops counting it" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    perform_storage_refreshes
+    assert_equal file_fixture("moon.jpg").size, @board.reload.bytes_used
+
+    @card.image.purge_later
+    perform_storage_refreshes
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "replacing a card image counts only the new image" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    perform_storage_refreshes
+
+    @card.image.attach(io: file_fixture("avatar.png").open, filename: "avatar.png")
+    perform_storage_refreshes
+
+    assert_equal file_fixture("avatar.png").size, @board.reload.bytes_used
+  end
+
+  test "counts many attachments across the board" do
+    25.times do |i|
+      @card.comments.create!(creator: users(:david), body: embed(create_blob(100 + i)))
+    end
+    perform_storage_refreshes
+
+    assert_equal((100...125).sum, @board.reload.bytes_used)
+  end
+
+  test "a rolled back change does not refresh the board" do
+    assert_no_enqueued_jobs only: Board::RefreshBytesUsedJob do
+      Board.transaction do
+        @card.update!(description: embed(create_blob(1_000)))
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "moving a card moves its usage to the new board" do
+    @card.update!(description: embed(create_blob(1_000)))
+    perform_storage_refreshes
+
+    @card.move_to(boards(:private))
+    perform_storage_refreshes
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 1_000, boards(:private).reload.bytes_used
+  end
+
+  test "destroying a card removes its usage, including its comments" do
+    @card.update!(description: embed(create_blob(1_000)))
+    @card.comments.create!(creator: users(:david), body: embed(create_blob(2_000)))
+    perform_storage_refreshes
+
+    @card.destroy!
+    perform_storage_refreshes
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "destroying a comment removes its usage" do
+    comment = @card.comments.create!(creator: users(:david), body: embed(create_blob(2_000)))
+    perform_storage_refreshes
+    assert_equal 2_000, @board.reload.bytes_used
+
+    comment.destroy!
+    perform_storage_refreshes
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "destroying the board removes its usage from the account" do
+    account = @board.account
+    @card.update!(description: embed(create_blob(1_000)))
+    perform_storage_refreshes
+    assert_equal 1_000, account.reload.bytes_used
+
+    @board.destroy!
+    perform_storage_refreshes
+
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  test "refresh_bytes_used_now recalculates the stored value from scratch" do
+    @card.update!(description: embed(create_blob(1_000)))
+    @board.update_column :bytes_used, 42
+
+    @board.refresh_bytes_used_now
+
+    assert_equal 1_000, @board.reload.bytes_used
+  end
+
+  test "refreshes for the same board share a concurrency key" do
+    key = Board::RefreshBytesUsedJob.new(@board).concurrency_key
+
+    assert_equal key, Board::RefreshBytesUsedJob.new(Board.find(@board.id)).concurrency_key
+    assert_not_equal key, Board::RefreshBytesUsedJob.new(boards(:private)).concurrency_key
+  end
+end
