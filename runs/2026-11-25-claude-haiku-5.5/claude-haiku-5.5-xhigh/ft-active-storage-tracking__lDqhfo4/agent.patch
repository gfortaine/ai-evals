+class Account::RefreshBytesUsedJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked, ActiveRecord::LockWaitTimeout, wait: :polynomially_longer
+
+  # Refreshes of the same account run one at a time, so an older refresh can't overwrite a newer one.
+  limits_concurrency to: 1, key: ->(account) { account }
+
+  def perform(account)
+    account.refresh_bytes_used_now
+  end
+end
