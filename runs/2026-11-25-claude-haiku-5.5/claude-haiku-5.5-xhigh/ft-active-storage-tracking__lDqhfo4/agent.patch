new file mode 100644
index 0000000..fe9c2f3
--- /dev/null
+++ b/app/models/board/storage.rb
@@ -0,0 +1,36 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy -> { account.refresh_bytes_used_later }, unless: :destroyed_by_association
+  end
+
+  def refresh_bytes_used_later
+    Board::RefreshBytesUsedJob.perform_later(self)
+  end
+
+  def refresh_bytes_used_now
+    update_column :bytes_used, storage_bytes
+    account.refresh_bytes_used_later
+  end
+
+  private
+    def storage_bytes
+      storage_attachment_groups.sum { |attachments| attachments.joins(:blob).sum("active_storage_blobs.byte_size") }
+    end
+
+    # One query per owner rather than a single query with OR conditions, so that each one can be
+    # answered from its own index instead of scanning the rich text and attachment tables.
+    def storage_attachment_groups
+      [
+        ActiveStorage::Attachment.where(record_type: "Card", name: "image", record_id: cards.select(:id)),
+        embeds_of(ActionText::RichText.where(record_type: "Board", record_id: id)),
+        embeds_of(ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id))),
+        embeds_of(ActionText::RichText.where(record_type: "Comment", record_id: Comment.where(card: cards).select(:id)))
+      ]
+    end
+
+    def embeds_of(rich_texts)
+      ActiveStorage::Attachment.where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_texts.select(:id))
+    end
+end
diff --git a/app/models/board/storage/attachment.rb b/app/models/board/storage/attachment.rb
new file mode 100644
index 0000000..7651423
--- /dev/null
+++ b/app/models/board/storage/attachment.rb
@@ -0,0 +1,33 @@
+# Refreshes the storage used by a board whenever an attachment that counts towards it is added or
+# removed: card images, and files embedded in card descriptions, comments and board descriptions.
+module Board::Storage::Attachment
+  extend ActiveSupport::Concern
+
+  prepended do
+    after_create :refresh_storage_of_board
+    after_destroy :refresh_storage_of_board
+  end
+
+  # Purging an attachment deletes it without running callbacks, so deleting it is covered here.
+  def delete
+    board = storage_board
+    super.tap { board&.refresh_bytes_used_later }
+  end
+
+  private
+    def refresh_storage_of_board
+      storage_board&.refresh_bytes_used_later
+    end
+
+    # Looked up while the owner still exists, as attachments are destroyed before the card, comment
+    # or board that owns them.
+    def storage_board
+      owner = record.is_a?(ActionText::RichText) ? record.record : record
+
+      case owner
+      when Board then owner
+      when Card then owner.board
+      when Comment then owner.card&.board
+      end
+    end
+end
