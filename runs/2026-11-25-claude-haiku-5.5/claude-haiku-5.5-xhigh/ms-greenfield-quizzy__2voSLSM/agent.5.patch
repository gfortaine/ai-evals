+
+  test "the big screen's poll does not redraw while the countdown runs" do
+    start_at
+    travel_to(OPENED) { get live_moderate_game_path(@game), headers: moderator_auth }
+    etag = response.headers["ETag"]
+
+    travel_to(OPENED + 20) do
