+    phone.assert_select "[role=timer]", count: 0
+    phone.assert_select "[data-controller=countdown]", count: 0
+    assert_no_match(/\b\d{1,2}:\d{2}\b/, phone.response.body, "players see no clock")
+    phone.assert_select "button.play-option", count: 2
+  end
+
+  test "a pick after the deadline is refused, and the phone then shows the question as closed" do
+    start_at
+    phone = open_session
+    travel_to(OPENED + 5) do
