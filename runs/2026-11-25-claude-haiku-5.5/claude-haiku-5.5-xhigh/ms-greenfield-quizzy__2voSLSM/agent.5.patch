+require "test_helper"
+
+# The timer, end to end over HTTP: the quiz settings, the countdown on the big screen (which players
+# never see), the question closing at 0:00, and the phones' answers after the deadline.
+class TimerIntegrationTest < ActionDispatch::IntegrationTest
+  OPENED = Time.zone.local(2026, 11, 19, 10, 0, 0)
+
+  setup do
+    @quiz = create_quiz("Frontend Fest 2026", questions: [
+      [ "Which HTTP status code means \"Too Many Requests\"?", [ [ "418", false ], [ "429", true ] ] ],
+      [ "Which protocol is two-way?", [ [ "WebSocket", true ], [ "SMTP", false ] ] ]
+    ])
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    @game = Game.create_from_quiz!(@quiz)
+  end
+
+  def start_at(time = OPENED)
+    travel_to(time) { post start_moderate_game_path(@game), headers: moderator_auth }
+  end
+
+  def big_screen_at(time)
+    travel_to(time) { get moderate_game_path(@game), headers: moderator_auth }
+  end
+
+  def option_id(text)
+    @game.game_questions.find_by!(position: 1).game_options.find_by!(text: text).id
+  end
+
+  test "the quiz settings have Timer minutes and Timer seconds, 0 by default" do
+    get new_moderate_quiz_path, headers: moderator_auth
+    assert_select "label", text: "Timer minutes"
+    assert_select "label", text: "Timer seconds"
+    assert_select "input[type=number][name='quiz[timer_minutes]'][value='0']"
+    assert_select "input[type=number][name='quiz[timer_seconds]'][value='0']"
+  end
+
+  test "the settings show and save the time per question" do
+    quiz = create_quiz("Timed")
+    get edit_moderate_quiz_path(quiz), headers: moderator_auth
+    assert_select "input[name='quiz[timer_minutes]'][value='0']"
+
+    patch moderate_quiz_path(quiz), params: { quiz: { title: "Timed", timer_minutes: "1", timer_seconds: "30" } }, headers: moderator_auth
+    assert_redirected_to moderate_quiz_path(quiz)
+    assert_equal 90, quiz.reload.time_per_question
+
+    get edit_moderate_quiz_path(quiz), headers: moderator_auth
+    assert_select "input[name='quiz[timer_minutes]'][value='1']"
+    assert_select "input[name='quiz[timer_seconds]'][value='30']"
+  end
+
+  test "a quiz page says what time each question gets" do
+    get moderate_quiz_path(@quiz), headers: moderator_auth
+    assert_select ".meta", text: /Time per question: 1:30/
+
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    get moderate_quiz_path(@quiz), headers: moderator_auth
+    assert_select ".meta", text: /Time per question: no timer/
+  end
+
+  test "seconds of 60 or more are refused with a message, and nothing is saved" do
+    patch moderate_quiz_path(@quiz), params: { quiz: { title: "Renamed", timer_minutes: "1", timer_seconds: "60" } }, headers: moderator_auth
+    assert_response :unprocessable_entity
