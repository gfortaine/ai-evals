--- /dev/null
+++ b/test/models/timer_test.rb
@@ -0,0 +1,203 @@
+require "test_helper"
+
+# The timer: the time per question is a setting of the quiz, copied into each game when it starts.
+# A question's countdown starts when the question opens, and at its deadline the question closes as
+# if "Finish" had been clicked. Times are set with travel_to.
+class GameTimerTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+
+  OPENED = Time.zone.local(2026, 11, 19, 10, 0, 0)
+
+  setup do
+    @quiz = create_quiz("Frontend Fest 2026", questions: [
+      [ "First?", [ [ "A1", false ], [ "A2", true ] ] ],
+      [ "Second?", [ [ "B1", true ], [ "B2", false ] ] ]
+    ])
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+  end
+
+  def start_at(game, time = OPENED)
+    travel_to(time) { assert game.start! }
+    game.reload
+  end
+
+  def game_stream(game, channel)
+    Turbo::StreamsChannel.send(:stream_name_from, [ game, channel ])
+  end
+
+  test "the time per question is minutes and seconds, 0 and 0 by default" do
+    quiz = create_quiz("No timer set")
+    assert_equal 0, quiz.timer_minutes
+    assert_equal 0, quiz.timer_seconds
+    assert_equal 0, quiz.time_per_question
+    assert_equal 90, @quiz.time_per_question
+  end
+
+  test "seconds are 0 to 59 and minutes are a whole number from 0" do
+    refute @quiz.update(timer_seconds: 60)
+    assert_includes @quiz.errors[:timer_seconds], "must be a whole number from 0 to 59"
+    refute @quiz.update(timer_seconds: -1)
+    refute @quiz.update(timer_minutes: -1)
+    refute @quiz.update(timer_minutes: 1.5)
+    refute @quiz.update(timer_minutes: nil)
+    assert @quiz.update(timer_minutes: 0, timer_seconds: 59)
+    assert_equal 59, @quiz.time_per_question
+  end
+
+  test "a game copies the time per question, and a later change to the quiz does not reach it" do
+    game = Game.create_from_quiz!(@quiz)
+    assert_equal 90, game.time_per_question
+    assert game.timed?
+
+    @quiz.update!(timer_minutes: 0, timer_seconds: 5)
+    assert_equal 90, game.reload.time_per_question
+    assert_equal 5, Game.create_from_quiz!(@quiz).time_per_question
+  end
+
+  test "without a timer there is no countdown and nothing closes on its own" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    game = start_at(Game.create_from_quiz!(@quiz))
+
+    refute game.timed?
+    assert_nil game.time_left(OPENED + 1)
+    assert_nil game.question_deadline
+    travel_to(OPENED + 3600) do
+      refute game.finish_if_time_is_up!
+    end
+    assert game.reload.open?
+  end
+
+  test "the time left counts down from the moment the question opens" do
+    game = start_at(Game.create_from_quiz!(@quiz))
+
+    assert_equal 90, game.time_left(OPENED)
+    assert_equal 60, game.time_left(OPENED + 30)
+    assert_equal 0, game.time_left(OPENED + 90)
+    assert_equal 0, game.time_left(OPENED + 500), "never below zero"
+  end
+
+  test "no countdown outside an open question" do
+    game = Game.create_from_quiz!(@quiz)
+    assert_nil game.time_left, "the lobby has no question open"
+
+    start_at(game)
+    travel_to(OPENED + 10) { game.finish_question! }
+    assert_nil game.reload.time_left(OPENED + 11), "a closed question has no countdown"
+  end
+
+  test "reading the game again does not restart the countdown" do
+    game = start_at(Game.create_from_quiz!(@quiz))
+
+    travel_to(OPENED + 40) do
+      fresh = Game.find(game.id)
+      assert_equal 50, fresh.time_left
+      assert_equal 50, Game.find(game.id).time_left, "a reload gets the same deadline"
+    end
+  end
+
+  test "the question closes by itself at its deadline, as Finish would" do
+    game = start_at(Game.create_from_quiz!(@quiz))
+
+    travel_to(OPENED + 89) { refute game.finish_if_time_is_up! }
+    assert game.reload.open?, "one second before the deadline the question is still open"
+
+    travel_to(OPENED + 90) { assert game.finish_if_time_is_up! }
+    game.reload
+    assert game.closed?
+    assert_equal OPENED + 90, game.current_question.closed_at
+    assert_equal 1, game.current_position
+  end
+
+  test "a question that is noticed late closes at its deadline, not at the moment it was noticed" do
+    game = start_at(Game.create_from_quiz!(@quiz))
+
+    travel_to(OPENED + 300) { assert game.finish_if_time_is_up! }
+    assert_equal OPENED + 90, game.reload.current_question.closed_at
+  end
+
+  test "the time's up closing bumps the revision and tells the screen and the phones" do
+    game = start_at(Game.create_from_quiz!(@quiz))
+    revision = game.revision
+
+    assert_broadcasts(game_stream(game, :screen), 1) do
+      assert_broadcasts(game_stream(game, :players), 1) do
+        travel_to(OPENED + 90) { game.finish_if_time_is_up! }
+      end
+    end
+    assert_equal revision + 1, game.reload.revision
+  end
+
+  test "nothing is announced or changed by a check before the deadline" do
+    game = start_at(Game.create_from_quiz!(@quiz))
+    revision = game.revision
+
+    assert_no_broadcasts(game_stream(game, :screen)) do
+      travel_to(OPENED + 10) { refute game.finish_if_time_is_up! }
+    end
+    assert_equal revision, game.reload.revision
+    assert game.open?
+  end
+
+  test "a pick before the deadline counts, and a pick after it is refused and not kept" do
+    game = start_at(Game.create_from_quiz!(@quiz))
+    player = game.join("Alice")
+    correct = game.current_question.game_options.find_by!(correct: true)
+
+    assert_equal :recorded, travel_to(OPENED + 89) { game.record_answer(player, correct.id) }
+    assert_equal :closed, travel_to(OPENED + 90) { game.record_answer(player, correct.id) }
+    assert_equal 1, Answer.count, "the pick made before the deadline is the only one"
+    assert_equal OPENED + 89, Answer.first.picked_at
+  end
+
+  test "a player's last pick before the deadline is the one that counts" do
+    game = start_at(Game.create_from_quiz!(@quiz))
+    player = game.join("Alice")
+    wrong, correct = game.current_question.game_options.order(:position).to_a.then { |a| [ a.first, a.last ] }
+
+    travel_to(OPENED + 10) { game.record_answer(player, correct.id) }
+    travel_to(OPENED + 20) { game.record_answer(player, wrong.id) }
+    travel_to(OPENED + 200) { game.finish_if_time_is_up! }
+
+    assert_equal wrong.id, player.answers.first.game_option_id
+    assert_equal 0, player.reload.score
+  end
+
+  test "Finish still works before the deadline, and closes the question at that moment" do
+    game = start_at(Game.create_from_quiz!(@quiz))
+
+    travel_to(OPENED + 12) { assert game.finish_question! }
+    assert game.reload.closed?
+    assert_equal OPENED + 12, game.current_question.closed_at
+    refute game.finish_if_time_is_up!, "nothing is left to close"
+  end
+
+  test "Finish after the deadline still closes a question that nothing has closed yet" do
+    game = start_at(Game.create_from_quiz!(@quiz))
+
+    travel_to(OPENED + 95) { assert game.finish_question! }
+    assert game.reload.closed?
+  end
+
+  test "the next question gets its own countdown from the moment it opens" do
+    game = start_at(Game.create_from_quiz!(@quiz))
+    travel_to(OPENED + 90) { game.finish_if_time_is_up! }
+
+    later = OPENED + 100
+    travel_to(later) { assert game.next_question! }
+    game.reload
+
+    assert_equal 2, game.current_position
+    assert_equal 90, game.time_left(later)
+    assert_equal 60, game.time_left(later + 30)
+    travel_to(later + 90) { assert game.finish_if_time_is_up! }
+    assert_equal later + 90, game.reload.game_questions.find_by!(position: 2).closed_at
+  end
+
+  test "a finished game has no countdown and nothing left to close" do
+    game = start_at(Game.create_from_quiz!(@quiz))
+    travel_to(OPENED + 5) { assert game.end_quiz! }
+
+    assert_nil game.reload.time_left(OPENED + 6)
+    refute game.finish_if_time_is_up!
+  end
+end
