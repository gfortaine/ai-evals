@@ -0,0 +1,75 @@
+require "application_system_test_case"
+
+# The timer in the browser: set in the quiz settings, counted down on the big screen, and the question
+# closes at 0:00 by itself, with nobody clicking "Finish". The phones follow it and never see a clock.
+class TimerFlowTest < ApplicationSystemTestCase
+  setup do
+    @quiz = create_quiz("Frontend Fest 2026", questions: [
+      [ "Which HTTP status code means \"Too Many Requests\"?", [ [ "418", false ], [ "429", true ] ] ],
+      [ "Which protocol is two-way?", [ [ "WebSocket", true ], [ "SMTP", false ] ] ]
+    ])
+  end
+
+  def assert_live_text(text)
+    using_wait_time(1.5) { assert_text(text) }
+  end
+
+  def countdown_text
+    find("[role=timer]").text
+  end
+
+  def countdown_seconds
+    minutes, seconds = countdown_text.split(":").map(&:to_i)
+    minutes * 60 + seconds
+  end
+
+  test "the settings have the timer fields, and a timed question counts down and closes by itself" do
+    visit edit_moderate_quiz_path(@quiz)
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+    fill_in "Timer minutes", with: "0"
+    fill_in "Timer seconds", with: "5"
+    click_button "Save quiz"
+    assert_text "Quiz saved."
+    assert_text "Time per question: 0:05"
+
+    visit moderate_quiz_path(@quiz)
+    click_on "Start a game"
+    join_url = find(".lobby__url").text
+    page.execute_script("window.screenMarker = 'same page'")
+
+    Capybara.using_session(:alice) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_on "Join"
+      assert_text "Hi, Alice!"
+    end
+    assert_live_text "Players: 1"
+
+    click_on "Start"
+    assert_selector "[role=timer]", text: /\A0:0[0-5]\z/
+    first_reading = countdown_seconds
+    sleep 1.5
+    assert_operator countdown_seconds, :<, first_reading, "the countdown runs down on the screen"
+    assert_equal "same page", page.evaluate_script("window.screenMarker"), "the big screen is not reloaded"
+
