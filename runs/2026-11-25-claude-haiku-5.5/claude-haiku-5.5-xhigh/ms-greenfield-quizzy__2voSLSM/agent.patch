+<% content_for :title, "Import quiz · Quizzy" %>
+
+<nav class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></nav>
+<div class="page-head"><h1>Import quiz</h1></div>
+
+<%# Turbo is off: a failed import re-renders the page with 422 and the pasted text. %>
+<%= form_with url: moderate_imports_path, method: :post, class: "card", data: { turbo: false } do %>
+  <% if @import&.errors&.any? %>
+    <div class="errors" role="alert">
+      <p>Nothing was imported.</p>
+      <ul>
+        <% @import.errors.full_messages.each do |message| %>
+          <li><%= message %></li>
