diff --git a/app/javascript/controllers/live_controller.js b/app/javascript/controllers/live_controller.js
new file mode 100644
index 0000000..ee0498e
--- /dev/null
+++ b/app/javascript/controllers/live_controller.js
@@ -0,0 +1,164 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Keeps the live region of a page (this element) in step with the server, without reloading the page.
+//
+// The server renders the whole region with an ETag for the state it shows. The region is asked for
+// again when:
+//   - the server pokes the page (the `quizzy:refresh` event, sent by a Turbo stream action): at once;
+//   - the timer fires (`poll`): this covers missed pokes and dropped connections;
+//   - the page becomes visible again, or the browser comes back online.
+// A 304 means nothing changed, and the DOM is left alone. Forms marked `data-live-form` are sent in
+// the background, and the page they lead to replaces the region.
+export default class extends Controller {
+  static values = { url: String, etag: String, poll: { type: Number, default: 3000 } }
+
+  connect() {
+    this.sequence = 0 // numbers every request, so that an older answer never overwrites a newer one
+    this.appliedSequence = 0
+    this.polling = false
+    this.pollAgain = false
+    this.posting = false
+    this.pendingPost = null
+
+    // A poke is refreshed at once: every phone must show a new question at the same moment, as speed
+    // decides ties. Pokes that arrive while a refresh is in flight are merged into one more refresh.
+    this.handlePoke = () => this.refresh()
+    this.handleVisible = () => {
+      if (document.visibilityState === "visible") this.refresh()
+    }
+    this.handleOnline = () => this.refresh()
+
+    window.addEventListener("quizzy:refresh", this.handlePoke)
+    document.addEventListener("visibilitychange", this.handleVisible)
+    window.addEventListener("online", this.handleOnline)
+    this.timer = window.setInterval(() => this.refresh(), this.pollValue)
+  }
+
+  disconnect() {
+    window.removeEventListener("quizzy:refresh", this.handlePoke)
+    document.removeEventListener("visibilitychange", this.handleVisible)
+    window.removeEventListener("online", this.handleOnline)
+    window.clearInterval(this.timer)
+  }
+
+  async refresh() {
+    if (this.polling) {
+      this.pollAgain = true
+      return
+    }
+    this.polling = true
+    const sequence = ++this.sequence
+    try {
+      const headers = { Accept: "text/html" }
+      if (this.etagValue) headers["If-None-Match"] = this.etagValue
+      const response = await fetch(this.urlValue, { headers, cache: "no-store", credentials: "same-origin" })
+      if (response.status === 200) this.apply(await response.text(), sequence)
+    } catch (_error) {
+      // Offline or a dropped connection: the next poll tries again.
+    } finally {
+      this.polling = false
+      if (this.pollAgain) {
+        this.pollAgain = false
+        this.refresh()
+      }
+    }
+  }
+
+  // Forms marked data-live-form are sent without leaving the page. The answer is the page the form
+  // redirects to, whose region replaces this one.
+  submit(event) {
+    const form = event.target
+    if (!(form instanceof HTMLFormElement) || !form.hasAttribute("data-live-form")) return
+
+    event.preventDefault()
+    const submitter = event.submitter
+    this.markPicked(submitter)
+    // Only the latest pick is sent when several arrive while one is still on its way: the last pick counts.
+    this.pendingPost = { url: form.action, body: new FormData(form, submitter) }
+    // A step or a join is sent once: its button waits until the page answers. Answers stay tappable.
+    if (submitter && !submitter.hasAttribute("data-live-pick")) submitter.disabled = true
+    this.sendPost()
+  }
+
+  async sendPost() {
+    if (this.posting || !this.pendingPost) return
+
+    const { url, body } = this.pendingPost
+    this.pendingPost = null
+    this.posting = true
+    const sequence = ++this.sequence
+    try {
+      const response = await fetch(url, {
+        method: "POST", body, headers: { Accept: "text/html" }, cache: "no-store", credentials: "same-origin"
+      })
+      if (!this.apply(await response.text(), sequence)) this.failed()
+    } catch (_error) {
+      // The request did not get through.
+      this.failed()
+    } finally {
+      this.posting = false
+      if (this.pendingPost) this.sendPost()
+    }
+  }
+
+  // The request did not get a region back: let the buttons be used again, and ask the server what it
+  // really has (a region that did not change is not redrawn, so the buttons must not stay disabled).
+  failed() {
+    this.element.querySelectorAll("button:disabled").forEach((button) => { button.disabled = false })
+    this.refresh()
+  }
+
+  // Shows the tapped option as picked straight away. The server's answer then confirms it.
+  markPicked(button) {
+    if (!button || !button.hasAttribute("data-live-pick")) return
+
+    this.element.querySelectorAll("[data-live-pick]").forEach((option) => {
+      option.classList.toggle("is-picked", option === button)
+      option.querySelectorAll(".play-option__mark").forEach((mark) => mark.remove())
+    })
+    const mark = document.createElement("span")
+    mark.className = "play-option__mark"
+    mark.textContent = "Your answer"
+    button.append(mark)
+  }
+
+  // Replaces the region with the one in `html`. Returns false when `html` has no region.
+  apply(html, sequence) {
+    const source = new DOMParser().parseFromString(html, "text/html").getElementById(this.element.id)
+    if (!source) return false
+    if (sequence < this.appliedSequence) return true
+
+    this.appliedSequence = sequence
+    const typed = this.typedValues()
+    const focused = this.focusedFieldName()
+    this.element.innerHTML = source.innerHTML
+    this.restoreTypedValues(typed, focused)
+    this.etagValue = source.dataset.liveEtagValue || ""
+    return true
+  }
+
+  // A player may be typing a name while the page refreshes: keep it.
+  typedValues() {
+    const values = new Map()
+    this.element.querySelectorAll("input[name]").forEach((input) => {
+      if (input.type === "text") values.set(input.name, input.value)
+    })
+    return values
+  }
+
+  focusedFieldName() {
+    const active = document.activeElement
+    return active && this.element.contains(active) && active.name ? active.name : null
+  }
+
+  restoreTypedValues(values, focusedName) {
+    this.element.querySelectorAll("input[name]").forEach((input) => {
+      const typed = values.get(input.name)
+      if (typed && !input.value) input.value = typed
+    })
+    if (focusedName) {
+      const field = this.element.querySelector(`[name="${CSS.escape(focusedName)}"]`)
+      if (field) field.focus({ preventScroll: true })
+    }
+  }
+}
