diff --git a/app/views/moderate/quizzes/preview.html.erb b/app/views/moderate/quizzes/preview.html.erb
new file mode 100644
index 0000000..b98ca98
--- /dev/null
+++ b/app/views/moderate/quizzes/preview.html.erb
@@ -0,0 +1,88 @@
+<% content_for :title, "Preview · #{@quiz.title} · Quizzy" %>
+
+<div class="preview-banner">
+  <span>Preview · nothing is saved</span>
+  <%= link_to "Back to quiz", moderate_quiz_path(@quiz) %>
+</div>
+
+<main class="play">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span><%= @quiz.title %></span>
+  </div>
+
+  <div class="play__body play__body--top">
+    <% if @preview.empty? %>
+      <h1 class="play-title">Nothing to play yet</h1>
+      <p class="play-lead">This quiz has no active questions. Activate a question on the quiz page to try it here.</p>
+
+    <% elsif @preview.finished? %>
+      <div class="result-card">
+        <p class="result-card__label">That's the end of the quiz</p>
+        <p class="result-card__score">Score: <%= @preview.score %>/<%= @preview.total %></p>
+      </div>
+
+    <% else %>
+      <% question = @preview.current_question %>
+      <div class="play-question__num">Question <%= @preview.number %> of <%= @preview.total %></div>
+      <div class="play-question__body"><%= question.text %></div>
+
+      <% if @preview.answered? %>
+        <% picked = @preview.picked_option %>
+        <div class="play-options is-locked is-revealed">
+          <% question.options.each_with_index do |option, index| %>
+            <div class="play-option<%= " is-picked" if option.id == picked.id %><%= " is-correct" if option.correct? %>">
+              <span class="play-option__letter" data-letter="<%= ("A".ord + index).chr %>" aria-hidden="true"></span>
+              <span class="play-option__title"><%= option.text %></span>
+              <% if option.correct? %>
+                <span class="play-option__mark">✓ Right answer</span>
+              <% elsif option.id == picked.id %>
+                <span class="play-option__mark">Your answer</span>
+              <% end %>
+            </div>
+          <% end %>
+        </div>
+
+        <% if picked.correct? %>
+          <div class="play-status play-status--right" role="status">Correct!</div>
+        <% else %>
+          <div class="play-status play-status--wrong" role="status">Wrong!</div>
+        <% end %>
+
+        <div class="buttons play-next">
+          <%= form_tag preview_moderate_quiz_path(@quiz), method: :get do %>
+            <% @preview.answers_with_pick.each do |answer| %>
+              <%= hidden_field_tag "answers[]", answer, id: nil %>
+            <% end %>
+            <% if @preview.last_question? %>
+              <%= button_tag "See score", type: "submit", class: "btn btn--pink btn--lg" %>
+            <% else %>
+              <%= button_tag "Next question", type: "submit", class: "btn btn--pink btn--lg" %>
+            <% end %>
+          <% end %>
+        </div>
+
+      <% else %>
+        <%= form_tag preview_moderate_quiz_path(@quiz), method: :get, class: "play-options-form" do %>
+          <% @preview.answers.each do |answer| %>
+            <%= hidden_field_tag "answers[]", answer, id: nil %>
+          <% end %>
+          <div class="play-options">
+            <% question.options.each_with_index do |option, index| %>
+              <%= button_tag type: "submit", name: "pick", value: option.id, class: "play-option" do %>
+                <span class="play-option__letter" data-letter="<%= ("A".ord + index).chr %>" aria-hidden="true"></span>
+                <span class="play-option__title"><%= option.text %></span>
+              <% end %>
+            <% end %>
+          </div>
+        <% end %>
+      <% end %>
+    <% end %>
+
+    <% unless @preview.empty? %>
+      <div class="buttons play-restart">
+        <%= button_to "Start over", preview_moderate_quiz_path(@quiz), method: :get, class: "btn btn--ghost" %>
+      </div>
+    <% end %>
+  </div>
+</main>
diff --git a/app/views/moderate/quizzes/show.html.erb b/app/views/moderate/quizzes/show.html.erb
new file mode 100644
index 0000000..ada4cbd
--- /dev/null
+++ b/app/views/moderate/quizzes/show.html.erb
@@ -0,0 +1,79 @@
+<% content_for :title, "#{@quiz.title} · Quizzy" %>
+
+<% active_count = @questions.count(&:active?) %>
+
+<nav class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></nav>
+
+<div class="page-head">
+  <div>
+    <h1><%= @quiz.title %></h1>
+    <div class="meta mt-2">
+      <% if @questions.any? %>
+        <%= active_count %> of <%= pluralize(@questions.size, "question") %> active ·
+      <% else %>
+        No questions yet ·
+      <% end %>
+      <% if @quiz.time_per_question.positive? %>
+        Time per question: <%= countdown_text(@quiz.time_per_question) %> ·
+      <% else %>
+        Time per question: no timer ·
+      <% end %>
+      <%= link_to "Settings", edit_moderate_quiz_path(@quiz) %>
+    </div>
+  </div>
+  <div class="buttons">
+    <%= button_to "Start a game", moderate_quiz_games_path(@quiz), class: "btn btn--pink" %>
+    <%= link_to "Export", export_moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+    <%= link_to "Preview", preview_moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+  </div>
+</div>
+
+<section class="section mt-0">
+  <div class="section-head">
+    <h2>Questions</h2>
+    <%= button_to "Add question", new_moderate_quiz_question_path(@quiz), method: :get, class: "btn" %>
+  </div>
+
+  <% if @questions.any? %>
+    <ol class="question-list">
+      <% active_number = 0 %>
+      <% @questions.each_with_index do |question, index| %>
+        <% number = question.active? ? (active_number += 1) : nil %>
+        <%= render "moderate/questions/item",
+              question: question,
+              number: number,
+              first: index.zero?,
+              last: index == @questions.size - 1 %>
+      <% end %>
+    </ol>
+  <% else %>
+    <p class="empty">No questions yet. Add the first question to this quiz.</p>
+  <% end %>
+</section>
+
+<section class="section">
+  <div class="section-head">
+    <h2>Games</h2>
+  </div>
+
+  <% if @games.any? %>
+    <table class="runs-table">
+      <thead>
+        <tr><th>Started</th><th>Status</th><th>Players</th><th><span class="visually-hidden">Actions</span></th></tr>
+      </thead>
+      <tbody>
+        <% @games.each do |game| %>
+          <% status = game.finished? ? [ "Finished", "badge--finished" ] : game.lobby? ? [ "Lobby", "" ] : [ "Running", "badge--running" ] %>
+          <tr>
+            <td><%= l(game.created_at, format: :short) %></td>
+            <td><span class="badge <%= status.last %>"><%= status.first %></span></td>
+            <td><%= game.players.size %></td>
+            <td><%= link_to "Open", moderate_game_path(game) %></td>
+          </tr>
+        <% end %>
+      </tbody>
+    </table>
+  <% else %>
+    <p class="empty">No games yet. Start a game to play this quiz on the big screen.</p>
+  <% end %>
+</section>
