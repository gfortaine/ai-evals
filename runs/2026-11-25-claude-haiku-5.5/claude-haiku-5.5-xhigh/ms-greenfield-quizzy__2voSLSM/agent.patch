diff --git a/app/views/play/_question.html.erb b/app/views/play/_question.html.erb
new file mode 100644
index 0000000..23f4517
--- /dev/null
+++ b/app/views/play/_question.html.erb
@@ -0,0 +1,48 @@
+<% question = @game.current_question %>
+<% answer = @player.answers.find_by(game_question: question) %>
+
+<div class="play-question__num">Question <%= @game.current_position %> of <%= @game.question_count %></div>
+<div class="play-question__body"><%= question.text %></div>
+
+<% if @game.open? %>
+  <%# While the question is open, the page carries no hint about which option is correct. %>
+  <%= form_with url: play_answers_path(@game.code), method: :post, class: "play-options-form",
+        data: { turbo: false, live_form: true } do %>
+    <div class="play-options">
+      <% question.game_options.each_with_index do |option, index| %>
+        <% picked = answer&.game_option_id == option.id %>
+        <button type="submit" name="option_id" value="<%= option.id %>" data-live-pick
+                class="play-option<%= " is-picked" if picked %>">
+          <span class="play-option__letter" data-letter="<%= ("A".ord + index).chr %>" aria-hidden="true"></span>
+          <span class="play-option__title"><%= option.text %></span>
+          <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+        </button>
+      <% end %>
+    </div>
+  <% end %>
+  <p class="play-lead">Tap an answer. You can change it until the question is closed.</p>
+<% else %>
+  <div class="play-options is-locked is-revealed">
+    <% question.game_options.each_with_index do |option, index| %>
+      <% picked = answer&.game_option_id == option.id %>
+      <div class="play-option<%= " is-picked" if picked %><%= " is-correct" if option.correct? %>">
+        <span class="play-option__letter" data-letter="<%= ("A".ord + index).chr %>" aria-hidden="true"></span>
+        <span class="play-option__title"><%= option.text %></span>
+        <% if picked %>
+          <span class="play-option__mark">Your answer</span>
+        <% elsif option.correct? %>
+          <span class="play-option__mark">✓ Right answer</span>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+
+  <% if answer.nil? %>
+    <div class="play-status play-status--neutral" role="status">No answer</div>
+  <% elsif answer.correct? %>
+    <div class="play-status play-status--right" role="status">Correct!</div>
+  <% else %>
+    <div class="play-status play-status--wrong" role="status">Wrong!</div>
+  <% end %>
+  <p class="play-lead">Waiting for the next question…</p>
+<% end %>
