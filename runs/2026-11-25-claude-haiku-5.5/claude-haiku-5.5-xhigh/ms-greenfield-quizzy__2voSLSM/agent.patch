diff --git a/config/routes.rb b/config/routes.rb
new file mode 100644
index 0000000..f5f1132
--- /dev/null
+++ b/config/routes.rb
@@ -0,0 +1,48 @@
+Rails.application.routes.draw do
+  # Health check for load balancers and uptime monitors: 200 when the app is ready.
+  get "up" => "rails/health#show", as: :rails_health_check
+
+  root to: redirect("/moderate")
+
+  # The phone side of a game. No account: the join link is the way in.
+  get "play/:code", to: "play#show", as: :play
+  get "play/:code/live", to: "play#live", as: :play_live
+  post "play/:code/join", to: "play#join", as: :play_join
+  post "play/:code/answers", to: "play#answer", as: :play_answers
+
+  namespace :moderate, path: "moderate" do
+    root "quizzes#index"
+
+    resources :quizzes do
+      get :preview, on: :member
+      get :export, on: :member
+      resources :questions, only: %i[new create]
+      # "Start a game": a new game of this quiz, opened on the big screen.
+      resources :games, only: %i[create]
+    end
+
+    # Importing always creates a new quiz from the JSON pasted into the form.
+    resources :imports, only: %i[new create]
+
+    resources :questions, only: %i[edit update destroy] do
+      member do
+        patch :move_up
+        patch :move_down
+        patch :activation
+      end
+    end
+
+    # The big screen of a game, and the moderator's steps through it.
+    resources :games, only: %i[show] do
+      get :live, on: :member
+      post :start, on: :member
+      post :finish, on: :member
+      post :next_question, on: :member
+      post :end_quiz, on: :member
+      # Winners, once the quiz is over: "Top N", "Draw" and "Reset winners".
+      post :top_winners, on: :member
+      post :draw_winners, on: :member
+      post :reset_winners, on: :member
+    end
+  end
+end
