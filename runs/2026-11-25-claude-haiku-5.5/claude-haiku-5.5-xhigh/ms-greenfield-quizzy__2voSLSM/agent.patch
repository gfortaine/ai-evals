+require "test_helper"
+
+class PreviewTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = create_quiz("Frontend Fest 2026", questions: [
+      [ "Which status code means Too Many Requests?", [ [ "418", false ], [ "429", true ], [ "503", false ] ] ],
+      [ "Inactive question", [ [ "x", true ], [ "y", false ] ], false ],
+      [ "Which protocol is two-way?", [ [ "WebSocket", true ], [ "SMTP", false ] ] ],
+      [ "What does CSS stand for?", [ [ "Cascading Style Sheets", true ], [ "Computer Style System", false ] ] ]
+    ])
+    @q1, _inactive, @q2, @q3 = @quiz.questions.to_a
+  end
+
+  def option_id(question, text)
+    question.options.find_by!(text: text).id
+  end
+
+  test "the preview starts at question 1 of the active questions and shows options as buttons" do
+    get preview_moderate_quiz_path(@quiz), headers: moderator_auth
+    assert_response :ok
+    assert_select ".play-question__num", text: "Question 1 of 3"
+    assert_select ".play-question__body", text: "Which status code means Too Many Requests?"
+    assert_select "button[name=pick]", count: 3
+    assert_select "button[name=pick]", text: "429"
+    assert_select "button", text: "Start over"
+  end
+
+  test "inactive questions are skipped" do
+    get preview_moderate_quiz_path(@quiz), params: { answers: [ option_id(@q1, "429").to_s ] }, headers: moderator_auth
+    assert_select ".play-question__num", text: "Question 2 of 3"
+    assert_select ".play-question__body", text: "Which protocol is two-way?"
+    assert_select ".play-question__body", text: /Inactive/, count: 0
+  end
+
+  test "picking a correct option says Correct! and reveals the correct option" do
+    get preview_moderate_quiz_path(@quiz), params: { pick: option_id(@q1, "429") }, headers: moderator_auth
+    assert_select ".play-status--right", text: "Correct!"
+    assert_select ".play-option.is-correct", text: /429/
+    assert_select "button[name=pick]", count: 0
+    assert_select "button", text: "Next question"
+  end
+
+  test "picking a wrong option says Wrong! and reveals the correct option" do
+    get preview_moderate_quiz_path(@quiz), params: { pick: option_id(@q1, "418") }, headers: moderator_auth
+    assert_select ".play-status--wrong", text: "Wrong!"
+    assert_select ".play-option.is-correct", text: /429/
+    assert_select ".play-option.is-picked", text: /418/
+  end
+
+  test "walking through the quiz ends with the score" do
+    get preview_moderate_quiz_path(@quiz), params: { pick: option_id(@q1, "429") }, headers: moderator_auth # right
+    answers = [ option_id(@q1, "429").to_s ]
+    get preview_moderate_quiz_path(@quiz), params: { answers: answers, pick: option_id(@q2, "SMTP") }, headers: moderator_auth
+    assert_select ".play-status--wrong", text: "Wrong!"
+
+    answers += [ option_id(@q2, "SMTP").to_s ]
+    get preview_moderate_quiz_path(@quiz), params: { answers: answers, pick: option_id(@q3, "Cascading Style Sheets") }, headers: moderator_auth
+    assert_select "button", text: "See score"
+    assert_select "button", text: "Next question", count: 0
+
+    answers += [ option_id(@q3, "Cascading Style Sheets").to_s ]
+    get preview_moderate_quiz_path(@quiz), params: { answers: answers }, headers: moderator_auth
+    assert_select ".result-card__score", text: "Score: 2/3"
+  end
+
+  test "the score counts only correct picks" do
+    answers = [ option_id(@q1, "418").to_s, option_id(@q2, "WebSocket").to_s, option_id(@q3, "Computer Style System").to_s ]
+    get preview_moderate_quiz_path(@quiz), params: { answers: answers }, headers: moderator_auth
+    assert_select ".result-card__score", text: "Score: 1/3"
+  end
+
+  test "Start over restarts the preview" do
+    get preview_moderate_quiz_path(@quiz), params: { answers: [ option_id(@q1, "429").to_s ], pick: option_id(@q2, "WebSocket") }, headers: moderator_auth
+    get preview_moderate_quiz_path(@quiz), headers: moderator_auth
+    assert_select ".play-question__num", text: "Question 1 of 3"
+  end
+
+  test "playing the preview stores nothing" do
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      get preview_moderate_quiz_path(@quiz), params: { answers: [ option_id(@q1, "429").to_s ], pick: option_id(@q2, "WebSocket") }, headers: moderator_auth
+    end
+  end
+
+  test "a quiz without active questions says so" do
+    quiz = create_quiz("Empty", questions: [ [ "Off", [ [ "a", true ], [ "b", false ] ], false ] ])
+    get preview_moderate_quiz_path(quiz), headers: moderator_auth
+    assert_response :ok
+    assert_select "h1", text: "Nothing to play yet"
+  end
+end
+
+class PreviewRevealTest < ActionDispatch::IntegrationTest
+  test "a revealed correct option is marked, and the feedback stays Correct! or Wrong!" do
+    quiz = create_quiz("Talk", questions: [ [ "Q", [ [ "A", true ], [ "B", false ] ] ] ])
+    wrong = quiz.questions.first.options.find_by!(text: "B").id
+    get preview_moderate_quiz_path(quiz), params: { pick: wrong }, headers: moderator_auth
+    assert_select ".play-status--wrong", text: "Wrong!"
+    assert_select ".play-option__mark", text: "✓ Right answer"
+    assert_select ".play-option__mark", text: "Your answer"
+    assert_select ".play-status--right", count: 0
+  end
+end
diff --git a/test/integration/questions_test.rb b/test/integration/questions_test.rb
new file mode 100644
index 0000000..a191efe
--- /dev/null
+++ b/test/integration/questions_test.rb
@@ -0,0 +1,189 @@
+require "test_helper"
+
+class QuestionsTest < ActionDispatch::IntegrationTest
+  def question_params(text: "Which planet is the largest?", active: nil, rows: nil)
+    rows ||= {
+      "0" => { "text" => "Jupiter", "correct" => "1" },
+      "1" => { "text" => "Saturn", "correct" => "0" },
+      "2" => { "text" => "", "correct" => "0" },
+      "3" => { "text" => "", "correct" => "0" }
+    }
+    params = { text: text, options: rows }
+    params[:active] = active unless active.nil?
+    { question: params }
+  end
+
+  setup { @quiz = create_quiz("Frontend Fest 2026") }
+
+  test "new question starts with four empty option rows, numbered, and Active on" do
+    get new_moderate_quiz_question_path(@quiz), headers: moderator_auth
+    assert_response :ok
+    assert_select "input[type=text][name^='question[options]']", count: 4
+    assert_select "label", text: "Option 1"
+    assert_select "label", text: "Option 4"
+    assert_select "label", text: "Option 1 is correct"
+    assert_select "label", text: "Option 4 is correct"
+    assert_select "input[type=checkbox][name='question[active]'][checked]"
+    assert_select "button", text: "Add option"
+    assert_select "button", text: "Save question"
+  end
+
+  test "Add option adds one row with the next number and saves nothing" do
+    rows = {
+      "0" => { "text" => "Jupiter", "correct" => "1" },
+      "1" => { "text" => "Saturn", "correct" => "0" },
+      "2" => { "text" => "", "correct" => "0" },
+      "3" => { "text" => "", "correct" => "0" }
+    }
+    assert_no_difference "Question.count" do
+      post moderate_quiz_questions_path(@quiz), params: question_params(rows: rows).merge(add_option: "1"), headers: moderator_auth
+    end
+    assert_response :ok
+    assert_select "label", text: "Option 5"
+    assert_select "input[type=text][name='question[options][0][text]'][value='Jupiter']"
+    assert_select "input[type=checkbox][name='question[options][0][correct]'][checked]"
+  end
+
+  test "a valid question is saved with its non-empty options, and empty rows are skipped" do
+    assert_difference({ "Question.count" => 1, "Option.count" => 2 }) do
+      post moderate_quiz_questions_path(@quiz), params: question_params, headers: moderator_auth
+    end
+    question = @quiz.questions.last
+    assert_redirected_to moderate_quiz_path(@quiz)
+    assert_equal "Which planet is the largest?", question.text
+    assert question.active?
+    assert_equal [ "Jupiter", "Saturn" ], question.options.map(&:text)
+    assert_equal [ true, false ], question.options.map(&:correct?)
+  end
+
+  test "a question needs at least two options" do
+    rows = { "0" => { "text" => "Jupiter", "correct" => "1" }, "1" => { "text" => "", "correct" => "0" } }
+    assert_no_difference "Question.count" do
+      post moderate_quiz_questions_path(@quiz), params: question_params(rows: rows), headers: moderator_auth
+    end
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Add at least two options"
+    # what the moderator typed is kept
+    assert_select "input[name='question[text]'], textarea[name='question[text]']", text: "Which planet is the largest?"
+    assert_select "input[type=text][value='Jupiter']"
+  end
+
+  test "at least one option must be correct" do
+    rows = { "0" => { "text" => "Jupiter", "correct" => "0" }, "1" => { "text" => "Saturn", "correct" => "0" } }
+    assert_no_difference "Question.count" do
+      post moderate_quiz_questions_path(@quiz), params: question_params(rows: rows), headers: moderator_auth
+    end
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Mark at least one option as correct"
+    assert_select "input[type=text][value='Saturn']"
+  end
+
+  test "several correct options are fine" do
+    rows = { "0" => { "text" => "Jupiter", "correct" => "1" }, "1" => { "text" => "Saturn", "correct" => "1" } }
+    post moderate_quiz_questions_path(@quiz), params: question_params(rows: rows), headers: moderator_auth
+    assert_equal 2, @quiz.questions.last.options.count(&:correct?)
+  end
+
+  test "question text is required" do
+    assert_no_difference "Question.count" do
+      post moderate_quiz_questions_path(@quiz), params: question_params(text: "  "), headers: moderator_auth
+    end
+    assert_select ".errors li", text: "Question can't be blank"
+  end
+
+  test "an inactive question is saved when Active is unchecked" do
+    post moderate_quiz_questions_path(@quiz), params: question_params(active: "0"), headers: moderator_auth
+    refute @quiz.questions.last.active?
+  end
+
+  test "editing replaces the options and keeps the position" do
+    quiz = create_quiz(questions: [ [ "Old", [ [ "A", true ], [ "B", false ] ] ], [ "Second", [ [ "C", true ], [ "D", false ] ] ] ])
+    question = quiz.questions.first
+    get edit_moderate_question_path(question), headers: moderator_auth
+    assert_response :ok
+    assert_select "input[type=text][value='A']"
+
+    patch moderate_question_path(question), params: question_params(text: "New", rows: {
+      "0" => { "text" => "X", "correct" => "0" }, "1" => { "text" => "Y", "correct" => "1" }, "2" => { "text" => "Z", "correct" => "0" }
+    }), headers: moderator_auth
+    assert_redirected_to moderate_quiz_path(quiz)
+    question.reload
+    assert_equal "New", question.text
+    assert_equal %w[X Y Z], question.options.map(&:text)
+    assert_equal 1, question.position
+  end
+
+  test "a failed edit leaves the stored question untouched" do
+    quiz = create_quiz(questions: [ [ "Old", [ [ "A", true ], [ "B", false ] ] ] ])
+    question = quiz.questions.first
+    patch moderate_question_path(question), params: question_params(text: "Changed", rows: {
+      "0" => { "text" => "A", "correct" => "0" }, "1" => { "text" => "B", "correct" => "0" }
+    }), headers: moderator_auth
+    assert_response :unprocessable_entity
+    assert_equal "Old", question.reload.text
+    assert_equal [ true, false ], question.options.map(&:correct?)
+  end
+
+  test "move up and move down swap neighbours" do
+    quiz = create_quiz(questions: [
+      [ "One", [ [ "A", true ], [ "B", false ] ] ],
+      [ "Two", [ [ "A", true ], [ "B", false ] ] ],
+      [ "Three", [ [ "A", true ], [ "B", false ] ] ]
+    ])
+    one, two, three = quiz.questions.to_a
+
+    patch move_down_moderate_question_path(one), headers: moderator_auth
+    assert_equal [ "Two", "One", "Three" ], quiz.questions.reload.map(&:text)
+
+    patch move_up_moderate_question_path(three), headers: moderator_auth
+    assert_equal [ "Two", "Three", "One" ], quiz.questions.reload.map(&:text)
+
+    # moving the first one up does nothing
+    patch move_up_moderate_question_path(two), headers: moderator_auth
+    assert_equal [ "Two", "Three", "One" ], quiz.questions.reload.map(&:text)
+  end
+
+  test "activation toggles the question and keeps it on the quiz page" do
+    quiz = create_quiz(questions: [ [ "Q", [ [ "A", true ], [ "B", false ] ] ] ])
+    question = quiz.questions.first
+    patch activation_moderate_question_path(question), params: { active: "0" }, headers: moderator_auth
+    refute question.reload.active?
+    patch activation_moderate_question_path(question), params: { active: "1" }, headers: moderator_auth
+    assert question.reload.active?
+  end
+
+  test "delete removes the question and its options" do
+    quiz = create_quiz(questions: [ [ "Q", [ [ "A", true ], [ "B", false ] ] ] ])
+    question = quiz.questions.first
+    assert_difference({ "Question.count" => -1, "Option.count" => -2 }) do
+      delete moderate_question_path(question), headers: moderator_auth
+    end
+    assert_redirected_to moderate_quiz_path(quiz)
+  end
+
+  test "inactive questions are shown without a number, and the count reflects active ones" do
+    quiz = create_quiz("Talk", questions: [
+      [ "Active one", [ [ "A", true ], [ "B", false ] ] ],
+      [ "Inactive", [ [ "A", true ], [ "B", false ] ], false ],
+      [ "Active two", [ [ "A", true ], [ "B", false ] ] ]
+    ])
+    get moderate_quiz_path(quiz), headers: moderator_auth
+    assert_select "li.question-item--inactive", count: 1
+    assert_select "li.question-item--inactive .question-item__num", text: "—"
+    assert_select "li:not(.question-item--inactive) .question-item__num", text: "1"
+    assert_select "li:not(.question-item--inactive) .question-item__num", text: "2"
+    assert_select ".meta", text: /2 of 3 questions active/
+  end
+end
+
+class QuestionOptionLengthTest < ActionDispatch::IntegrationTest
+  test "a too long option shows an error and saves nothing" do
+    quiz = create_quiz("Talk")
+    rows = { "0" => { "text" => "x" * 201, "correct" => "1" }, "1" => { "text" => "B", "correct" => "0" } }
+    assert_no_difference "Question.count" do
+      post moderate_quiz_questions_path(quiz), params: { question: { text: "Q", options: rows } }, headers: moderator_auth
+    end
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Options can be at most 200 characters long"
+  end
+end
diff --git a/test/integration/quiz_export_test.rb b/test/integration/quiz_export_test.rb
new file mode 100644
index 0000000..97bcfd0
--- /dev/null
+++ b/test/integration/quiz_export_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class QuizExportTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = create_quiz("Frontend Fest 2026", questions: [
+      [ "Which HTTP status code means \"Too Many Requests\"?", [ [ "418", false ], [ "429", true ] ] ],
+      [ "Inactive question", [ [ "Yes", true ], [ "No", false ] ], false ],
+      [ "Which protocol is two-way?", [ [ "WebSocket", true ], [ "SMTP", false ] ] ]
+    ])
+  end
+
+  def exported
+    JSON.parse(css_select("pre").text)
+  end
+
+  test "the quiz page has an Export link to the export page" do
+    get moderate_quiz_path(@quiz), headers: moderator_auth
+    assert_response :ok
+    assert_select "a[href='#{export_moderate_quiz_path(@quiz)}']", text: "Export"
+  end
+
+  test "the export page needs moderator credentials" do
+    get export_moderate_quiz_path(@quiz)
+    assert_response :unauthorized
+  end
+
+  test "the export page shows the quiz JSON in the only pre element" do
+    get export_moderate_quiz_path(@quiz), headers: moderator_auth
+    assert_response :ok
+    assert_select "pre", count: 1
+  end
+
+  test "export writes the title and the questions in order, with active and correct always written" do
+    get export_moderate_quiz_path(@quiz), headers: moderator_auth
+    assert_equal({
+      "title" => "Frontend Fest 2026",
+      "questions" => [
+        { "text" => "Which HTTP status code means \"Too Many Requests\"?", "active" => true,
+          "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ] },
+        { "text" => "Inactive question", "active" => false,
+          "options" => [ { "text" => "Yes", "correct" => true }, { "text" => "No", "correct" => false } ] },
+        { "text" => "Which protocol is two-way?", "active" => true,
+          "options" => [ { "text" => "WebSocket", "correct" => true }, { "text" => "SMTP", "correct" => false } ] }
+      ]
+    }, exported)
+  end
+
+  test "export writes exactly the keys of the format and nothing about the database" do
+    get export_moderate_quiz_path(@quiz), headers: moderator_auth
+    data = exported
+    assert_equal %w[questions title], data.keys.sort
+    data["questions"].each do |question|
+      assert_equal %w[active options text], question.keys.sort
+      question["options"].each { |option| assert_equal %w[correct text], option.keys.sort }
+    end
+  end
+
+  test "an empty quiz exports an empty question list" do
+    empty = create_quiz("Nothing yet")
+    get export_moderate_quiz_path(empty), headers: moderator_auth
+    assert_equal({ "title" => "Nothing yet", "questions" => [] }, exported)
+  end
+
+  test "quote and angle characters are escaped in the page but the JSON is still exact" do
+    quiz = create_quiz("<b>Bold</b> & \"quoted\"", questions: [ [ "<i>x</i>", [ [ "a < b", true ], [ "c", false ] ] ] ])
+    get export_moderate_quiz_path(quiz), headers: moderator_auth
+    assert_equal "<b>Bold</b> & \"quoted\"", exported["title"]
+    assert_equal "<i>x</i>", exported["questions"].first["text"]
+    assert_equal "a < b", exported["questions"].first["options"].first["text"]
+  end
+end
diff --git a/test/integration/quiz_import_test.rb b/test/integration/quiz_import_test.rb
new file mode 100644
index 0000000..2ce59c6
--- /dev/null
+++ b/test/integration/quiz_import_test.rb
@@ -0,0 +1,223 @@
+require "test_helper"
+
+class QuizImportTest < ActionDispatch::IntegrationTest
+  def question(text, options, active: nil)
+    data = { "text" => text, "options" => options.map { |option_text, correct| { "text" => option_text, "correct" => correct } } }
+    data["active"] = active unless active.nil?
+    data
+  end
+
+  def document(title: "Frontend Fest 2026", questions: [ question("Which HTTP status code means \"Too Many Requests\"?", [ [ "418", false ], [ "429", true ] ]) ])
+    { "title" => title, "questions" => questions }
+  end
+
+  def import_text(text)
+    post moderate_imports_path, params: { quiz_json: text }, headers: moderator_auth
+  end
+
+  def import_data(data)
+    import_text(data.is_a?(String) ? data : data.to_json)
+  end
+
+  def assert_nothing_imported
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+    assert_equal 0, Option.count
+  end
+
+  test "the moderate page has an Import quiz button that opens the import page" do
+    get moderate_root_url, headers: moderator_auth
+    assert_response :ok
+    assert_select "form[action='#{new_moderate_import_path}'] button", text: "Import quiz"
+  end
+
+  test "the import page has a Quiz JSON text area and an Import button" do
+    get new_moderate_import_path, headers: moderator_auth
+    assert_response :ok
+    assert_select "label[for='quiz_json']", text: "Quiz JSON"
+    assert_select "textarea#quiz_json[name='quiz_json']"
+    assert_select "button", text: "Import"
+  end
+
+  test "importing creates a new quiz with its questions and options in order and opens its page" do
+    data = document(questions: [
+      question("First", [ [ "A", true ], [ "B", false ] ], active: true),
+      question("Second", [ [ "C", false ], [ "D", true ] ], active: false)
+    ])
+    assert_difference({ "Quiz.count" => 1, "Question.count" => 2, "Option.count" => 4 }) do
+      import_data(data)
+    end
+    quiz = Quiz.order(:id).last
+    assert_redirected_to moderate_quiz_path(quiz)
+    assert_equal "Frontend Fest 2026", quiz.title
+    assert_equal [ "First", "Second" ], quiz.questions.map(&:text)
+    assert_equal [ true, false ], quiz.questions.map(&:active?)
+    assert_equal [ [ "A", "B" ], [ "C", "D" ] ], quiz.questions.map { |q| q.options.map(&:text) }
+    assert_equal [ [ true, false ], [ false, true ] ], quiz.questions.map { |q| q.options.map(&:correct?) }
+  end
+
+  test "active defaults to true and correct defaults to false" do
+    data = { "title" => "Defaults", "questions" => [
+      { "text" => "Q", "options" => [ { "text" => "A" }, { "text" => "B", "correct" => true } ] }
+    ] }
+    import_data(data)
+    question = Quiz.find_by!(title: "Defaults").questions.first
+    assert question.active?
+    assert_equal [ false, true ], question.options.map(&:correct?)
+  end
+
+  test "importing a title that already exists still creates a new quiz" do
+    create_quiz("Frontend Fest 2026")
+    assert_difference "Quiz.count", 1 do
+      import_data(document)
+    end
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+  end
+
+  test "a quiz without questions can be imported" do
+    assert_difference "Quiz.count", 1 do
+      import_data(document(questions: []))
+    end
+    assert_empty Quiz.order(:id).last.questions
+  end
+
+  test "blank option rows are skipped, as in the question form" do
+    data = document(questions: [ question("Q", [ [ "", true ], [ "A", true ], [ "  ", false ], [ "B", false ] ]) ])
+    import_data(data)
+    assert_equal [ "A", "B" ], Quiz.order(:id).last.questions.first.options.map(&:text)
+  end
+
+  test "the moderator credentials are required" do
+    assert_no_difference "Quiz.count" do
+      post moderate_imports_path, params: { quiz_json: document.to_json }
+    end
+    assert_response :unauthorized
+  end
+
+  test "invalid JSON shows an error, keeps the text, and imports nothing" do
+    text = "{\"title\": \"Broken\", \"questions\": [}"
+    import_text(text)
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Quiz JSON is not valid JSON"
+    assert_select "textarea#quiz_json", text: text
+    assert_nothing_imported
+  end
+
+  test "empty input shows an error and imports nothing" do
+    import_text("   ")
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Paste the quiz JSON to import"
+    assert_nothing_imported
+  end
+
+  test "JSON that is not an object is rejected" do
+    import_data("[1, 2, 3]")
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: /must be an object/
+    assert_nothing_imported
+  end
+
+  test "questions must be a list" do
+    import_data({ "title" => "T", "questions" => "nope" })
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: /needs a list of questions/
+    assert_nothing_imported
+  end
+
+  test "a missing title is rejected" do
+    import_data(document(title: "  "))
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Title can't be blank"
+    assert_nothing_imported
+  end
+
+  test "a title that is not text is rejected" do
+    import_data(document(title: 42))
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: /Title must be a string/
+    assert_nothing_imported
+  end
+
+  test "one question that breaks a rule imports nothing, not even the valid questions" do
+    data = document(questions: [
+      question("Fine", [ [ "A", true ], [ "B", false ] ]),
+      question("Too few", [ [ "Only", true ] ])
+    ])
+    import_data(data)
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Question 2: Add at least two options"
+    assert_nothing_imported
+  end
+
+  test "the question rules of the question form apply to imported questions" do
+    cases = {
+      "Question 1: Mark at least one option as correct" => document(questions: [ question("Q", [ [ "A", false ], [ "B", false ] ]) ]),
+      "Question 1: Question can't be blank" => document(questions: [ question("   ", [ [ "A", true ], [ "B", false ] ]) ]),
+      "Question 1: Options can be at most 200 characters long" => document(questions: [ question("Q", [ [ "x" * 201, true ], [ "B", false ] ]) ]),
+      "Question 1: Question is too long (maximum is 500 characters)" => document(questions: [ question("q" * 501, [ [ "A", true ], [ "B", false ] ]) ])
+    }
+    cases.each do |message, data|
+      import_data(data)
+      assert_response :unprocessable_entity, message
+      assert_select ".errors li", text: message
+    end
+    assert_nothing_imported
+  end
+
+  test "a correct box on a blank option does not count" do
+    data = document(questions: [ question("Q", [ [ "A", false ], [ "B", false ], [ "", true ] ]) ])
+    import_data(data)
+    assert_select ".errors li", text: "Question 1: Mark at least one option as correct"
+    assert_nothing_imported
+  end
+
+  test "active and correct must be true or false" do
+    bad_active = document(questions: [ { "text" => "Q", "active" => "yes", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] } ])
+    import_data(bad_active)
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: /Question 1: active must be true or false/
+
+    bad_correct = document(questions: [ { "text" => "Q", "options" => [ { "text" => "A", "correct" => 1 }, { "text" => "B" } ] } ])
+    import_data(bad_correct)
+    assert_select ".errors li", text: /option 1 correct must be true or false/
+    assert_nothing_imported
+  end
+
+  test "a format error is reported alone, without the rule errors it would cause" do
+    data = document(questions: [ { "text" => "Q", "options" => [ { "text" => "A", "correct" => "yes" }, { "text" => "B" } ] } ])
+    import_data(data)
+    assert_response :unprocessable_entity
+    assert_select ".errors li", count: 1
+    assert_select ".errors li", text: /option 1 correct must be true or false/
+    assert_nothing_imported
+  end
+
+  test "option text must be a string" do
+    data = document(questions: [ { "text" => "Q", "options" => [ { "text" => 418, "correct" => true }, { "text" => "B" } ] } ])
+    import_data(data)
+    assert_select ".errors li", text: /option 1 text must be a string/
+    assert_nothing_imported
+  end
+
+  test "the round trip of an export imports the same quiz again" do
+    source = create_quiz("Source", questions: [
+      [ "One", [ [ "A", true ], [ "B", false ] ] ],
+      [ "Two", [ [ "C", false ], [ "D", true ] ], false ]
+    ])
+    get export_moderate_quiz_path(source), headers: moderator_auth
+    exported = JSON.parse(css_select("pre").text)
+
+    import_data(exported)
+    copy = Quiz.order(:id).last
+    assert_redirected_to moderate_quiz_path(copy)
+    assert_not_equal source.id, copy.id
+
+    get export_moderate_quiz_path(copy), headers: moderator_auth
+    assert_equal exported, JSON.parse(css_select("pre").text)
+  end
+
+  test "a UTF-8 byte order mark at the start of the file is accepted" do
+    import_text("\uFEFF" + document.to_json)
+    assert_redirected_to moderate_quiz_path(Quiz.order(:id).last)
+  end
+end
diff --git a/test/integration/quizzes_test.rb b/test/integration/quizzes_test.rb
