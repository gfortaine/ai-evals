@@ -0,0 +1,32 @@
+# A participant in one game. Players need no account: the browser that joined keeps the token in a
+# cookie, and opening the join link again from that browser continues as the same player.
+class Player < ApplicationRecord
+  NAME_LENGTH = 40
+
+  belongs_to :game
+  has_many :answers, dependent: :destroy
+
+  normalizes :name, with: ->(name) { name.to_s.strip }
+
+  before_validation :assign_token, on: :create
+
+  validates :name,
+    presence: { message: "Enter your name" },
+    length: { maximum: NAME_LENGTH, message: "Keep your name to #{NAME_LENGTH} characters" }
+  validates :token, presence: true, uniqueness: true
+
+  # Points from the questions that were closed: one per correct pick.
+  def score
+    answers
+      .joins(:game_question, :game_option)
+      .where.not(game_questions: { closed_at: nil })
+      .where(game_options: { correct: true })
+      .count
+  end
+
+  private
+
+  def assign_token
+    self.token ||= SecureRandom.urlsafe_base64(24)
+  end
+end
