+<li id="<%= dom_id(question) %>" class="card question-item<%= " question-item--inactive" unless question.active? %>">
+  <div class="question-item__num"><%= number || "—" %></div>
+
+  <div>
+    <div class="question-item__body"><%= question.text %></div>
+    <ul class="question-item__options">
+      <% question.options.each_with_index do |option, index| %>
+        <%= tag.li class: ("is-correct" if option.correct?), data: { letter: ("A".ord + index).chr } do %>
+          <%= option.text %><% if option.correct? %><span class="visually-hidden"> (correct)</span><% end %>
+        <% end %>
+      <% end %>
+    </ul>
+  </div>
+
+  <div class="question-item__actions">
+    <div class="buttons">
+      <%= button_to "Move up", move_up_moderate_question_path(question), method: :patch,
+            class: "btn btn--ghost btn--sm", disabled: first %>
+      <%= button_to "Move down", move_down_moderate_question_path(question), method: :patch,
+            class: "btn btn--ghost btn--sm", disabled: last %>
+    </div>
+
+    <%# Saves on change: the checkbox submits its own form (see auto_submit_controller.js). %>
+    <%= form_with url: activation_moderate_question_path(question), method: :patch, class: "inline-form",
+          data: { controller: "auto-submit" } do %>
+      <%= hidden_field_tag "active", "0", id: nil %>
+      <label class="checkbox">
+        <%= check_box_tag "active", "1", question.active?, id: dom_id(question, :active),
+              data: { action: "change->auto-submit#submit" } %>
+        Active
+      </label>
+    <% end %>
+
+    <div class="buttons">
+      <%= link_to "Edit", edit_moderate_question_path(question), class: "btn btn--sm" %>
+      <%= button_to "Delete", moderate_question_path(question), method: :delete, class: "btn btn--sm btn--danger",
+            form: { data: { turbo_confirm: "Delete this question?" } } %>
+    </div>
+  </div>
+</li>
