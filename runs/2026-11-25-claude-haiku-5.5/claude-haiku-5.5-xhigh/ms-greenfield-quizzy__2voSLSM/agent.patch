@@ -0,0 +1,56 @@
+require "test_helper"
+
+class AnswerTest < ActiveSupport::TestCase
+  setup do
+    quiz = create_quiz("Talk", questions: [
+      [ "One?", [ [ "a", true ], [ "b", false ] ] ],
+      [ "Two?", [ [ "c", false ], [ "d", true ] ] ]
+    ])
+    @game = Game.create_from_quiz!(quiz)
+    @game.start!
+    @game.reload
+    @player = @game.join("Alice")
+    @first_question, @second_question = @game.game_questions.to_a
+  end
+
+  test "an answer must pick an option of its own question" do
+    answer = Answer.new(player: @player, game_question: @first_question, game_option: @second_question.game_options.first)
+
+    refute answer.valid?
+    assert_includes answer.errors[:game_option], "is not an option of this question"
+  end
+
+  test "an answer must belong to a question of the player's game" do
+    other = Game.create_from_quiz!(@game.quiz)
+    answer = Answer.new(player: @player, game_question: other.game_questions.first, game_option: other.game_questions.first.game_options.first)
+
+    refute answer.valid?
+    assert_includes answer.errors[:game_question], "is not part of this player's game"
+  end
+
+  test "one answer per player and question" do
+    option = @first_question.game_options.first
+    Answer.create!(player: @player, game_question: @first_question, game_option: option)
+
+    assert_raises(ActiveRecord::RecordNotUnique) do
+      Answer.create!(player: @player, game_question: @first_question, game_option: option)
+    end
+  end
+
+  test "a pick is stamped with the time it was made, and a new pick on the same question moves the stamp" do
+    option = @first_question.game_options.first
+    travel_to(Time.zone.local(2026, 11, 19, 10, 0, 5)) { @game.record_answer(@player, option.id) }
+    answer = Answer.find_by!(player: @player, game_question: @first_question)
+    assert_equal Time.zone.local(2026, 11, 19, 10, 0, 5), answer.picked_at
+
+    travel_to(Time.zone.local(2026, 11, 19, 10, 0, 9)) { @game.record_answer(@player, option.id) }
+    assert_equal Time.zone.local(2026, 11, 19, 10, 0, 9), answer.reload.picked_at, "the same option picked again still moves the stamp"
+  end
+
+  test "a player's name is stripped and tokens are unique and secret-looking" do
+    bob = @game.join("  Bob ")
+    assert_equal "Bob", bob.name
+    assert_operator bob.token.length, :>=, 30
+    refute_equal @player.token, bob.token
+  end
+end
diff --git a/test/models/game_test.rb b/test/models/game_test.rb
new file mode 100644
index 0000000..7976a7b
--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,393 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+
+  setup do
+    @quiz = create_quiz("Frontend Fest 2026", questions: [
+      [ "First?", [ [ "A1", false ], [ "A2", true ] ] ],
+      [ "Inactive?", [ [ "B1", true ], [ "B2", false ] ], false ],
+      [ "Third?", [ [ "C1", true ], [ "C2", false ] ] ]
+    ])
+  end
+
+  def started_game
+    game = Game.create_from_quiz!(@quiz)
+    assert game.start!
+    game.reload
+  end
+
+  test "a game copies the active questions in quiz order and skips inactive ones" do
+    game = Game.create_from_quiz!(@quiz)
+
+    assert_equal [ "First?", "Third?" ], game.game_questions.map(&:text)
+    assert_equal [ 1, 2 ], game.game_questions.map(&:position)
+    assert_equal [ "A1", "A2" ], game.game_questions.first.game_options.map(&:text)
+    assert_equal [ false, true ], game.game_questions.first.game_options.map(&:correct)
+    assert_equal 2, game.question_count
+    assert game.lobby?
+  end
+
+  test "editing the quiz afterwards does not change a game" do
+    game = Game.create_from_quiz!(@quiz)
+    @quiz.questions.first.update!(text: "Changed")
+    @quiz.questions.first.options.first.update!(correct: true)
+
+    assert_equal "First?", game.game_questions.first.text
+    assert_equal false, game.game_questions.first.game_options.first.correct
+  end
+
+  test "each game of a quiz is separate, with its own players and answers" do
+    first = Game.create_from_quiz!(@quiz)
+    second = Game.create_from_quiz!(@quiz)
+
+    refute_equal first.id, second.id
+    refute_equal first.code, second.code
+    assert_equal 2, @quiz.games.count
+    assert_equal 2, first.question_count
+    assert_not_equal first.game_questions.first.id, second.game_questions.first.id
+  end
+
+  test "join codes are five characters from the unambiguous alphabet" do
+    20.times { Game.create_from_quiz!(@quiz) }
+
+    Game.all.each do |game|
+      assert_match(/\A[2-9A-HJKMNP-Z]{5}\z/, game.code)
+    end
+    assert_equal Game.count, Game.distinct.count(:code)
+  end
+
+  test "start opens the first question, and only from the lobby" do
+    game = Game.create_from_quiz!(@quiz)
+
+    assert game.start!
+    game.reload
+    assert game.open?
+    assert_equal 1, game.current_position
+    assert_equal "First?", game.current_question.text
+    assert game.current_question.opened_at
+    refute game.start!, "a second start changes nothing"
+  end
+
+  test "a game without questions cannot start" do
+    empty = create_quiz("Empty", questions: [])
+    game = Game.create_from_quiz!(empty)
+
+    refute game.start!
+    assert game.lobby?
+  end
+
+  test "finish closes the question, and only an open question can be finished" do
+    game = started_game
+
+    assert game.finish_question!
+    game.reload
+    assert game.closed?
+    assert game.current_question.closed_at
+    refute game.finish_question!
+  end
+
+  test "next moves to the next game question, skipping inactive quiz questions" do
+    game = started_game
+    game.finish_question!
+
+    assert game.next_question!
+    game.reload
+    assert game.open?
+    assert_equal 2, game.current_position
+    assert_equal "Third?", game.current_question.text
+  end
+
+  test "next is refused while the question is still open or on the last question" do
+    game = started_game
+    refute game.next_question!, "no next question while one is open"
+
+    game.finish_question!
+    game.next_question!
+    game.reload
+    game.finish_question!
+    refute game.reload.next_question!, "the last question has no next"
+    assert game.closed?
+  end
+
+  test "end quiz finishes the game from any phase, closing an open question" do
+    game = started_game
+
+    assert game.end_quiz!
+    game.reload
+    assert game.finished?
+    assert game.finished_at
+    assert game.current_question.closed_at, "the open question is closed"
+    refute game.end_quiz!
+  end
+
+  test "every phase change bumps the revision and tells the screen and the phones" do
+    game = Game.create_from_quiz!(@quiz)
+
+    assert_broadcasts(game_stream(game, :screen), 1) do
+      assert_broadcasts(game_stream(game, :players), 1) do
+        game.start!
+      end
+    end
+    assert_equal 1, game.reload.revision
+  end
+
+  test "a refused transition does not bump the revision or broadcast" do
+    game = Game.create_from_quiz!(@quiz)
+
+    assert_no_broadcasts(game_stream(game, :players)) do
+      refute game.finish_question!
+    end
+    assert_equal 0, game.reload.revision
+  end
+
+  test "a join appears on the screen only, not on the phones" do
+    game = Game.create_from_quiz!(@quiz)
+
+    assert_broadcasts(game_stream(game, :screen), 1) do
+      assert_no_broadcasts(game_stream(game, :players)) do
+        game.join("Alice")
+      end
+    end
+  end
+
+  test "join adds a player, and a finished game does not let anyone join" do
+    game = Game.create_from_quiz!(@quiz)
+
+    player = game.join("  Alice  ")
+    assert player.persisted?
+    assert_equal "Alice", player.name
+    assert player.token.present?
+
+    game.end_quiz!
+    assert_nil game.reload.join("Bob")
+    assert_equal 1, game.players.count
+  end
+
+  test "a blank or over-long name is refused with a message" do
+    game = Game.create_from_quiz!(@quiz)
+
+    blank = game.join("   ")
+    refute blank.persisted?
+    assert_equal [ "Enter your name" ], blank.errors[:name]
+
+    long = game.join("x" * (Player::NAME_LENGTH + 1))
+    refute long.persisted?
+    assert long.errors[:name].any?
+    assert_equal 0, game.players.count
+  end
+
+  test "a pick is recorded, and the last pick counts" do
+    game = started_game
+    alice = game.join("Alice")
+    question = game.current_question
+    wrong, right = question.game_options.to_a
+
+    assert_equal :recorded, game.record_answer(alice, wrong.id)
+    assert_equal :recorded, game.record_answer(alice, right.id)
+
+    assert_equal 1, Answer.where(player: alice, game_question: question).count
+    assert_equal right, Answer.find_by(player: alice, game_question: question).game_option
+  end
+
+  test "a pick is refused when the question was closed after the pick's request loaded the game" do
+    game = started_game
+    alice = game.join("Alice")
+    option = game.current_question.game_options.find_by!(correct: true)
+    request_copy = Game.find(game.id) # what a pick's request holds while the moderator closes the question
+
+    game.finish_question!
+    assert_equal :closed, request_copy.record_answer(alice, option.id)
+    assert_equal 0, Answer.where(player: alice).count
+  end
+
+  test "a pick is refused when the question is not open, or the option is not of this question" do
+    game = started_game
+    alice = game.join("Alice")
+    other_question_option = game.game_questions.last.game_options.first
+
+    assert_equal :unknown_option, game.record_answer(alice, other_question_option.id)
+    assert_equal :unknown_option, game.record_answer(alice, "nope")
+
+    game.finish_question!
+    assert_equal :closed, game.reload.record_answer(alice, game.game_questions.first.game_options.first.id)
+    assert_equal 0, Answer.count
+  end
+
+  test "a pick from someone who did not join this game is refused" do
+    game = started_game
+    other_game = Game.create_from_quiz!(@quiz)
+    stranger = other_game.join("Stranger")
+    option = game.current_question.game_options.first
+
+    assert_equal :not_joined, game.record_answer(stranger, option.id)
+    assert_equal :not_joined, game.record_answer(nil, option.id)
+  end
+
+  test "the screen and the phones fingerprints change when the game changes" do
+    game = started_game
+    alice = game.join("Alice")
+    before_pick = game.player_fingerprint(alice)
+    screen_before = game.screen_fingerprint
+
+    game.record_answer(alice, game.current_question.game_options.first.id)
+    assert_equal before_pick.first, game.reload.player_fingerprint(alice).first
+    assert_not_equal before_pick, game.player_fingerprint(alice)
+    assert_not_equal screen_before, game.screen_fingerprint
+  end
+
+  test "a player's score counts correct picks on closed questions only" do
+    game = started_game
+    alice = game.join("Alice")
+    game.record_answer(alice, game.current_question.game_options.find_by(correct: true).id)
+    game.finish_question!
+    game.next_question!
+    game.reload
+    game.record_answer(alice, game.current_question.game_options.find_by(correct: false).id)
+
+    assert_equal 1, alice.score, "the open question does not count yet"
+
+    game.finish_question!
+    assert_equal 1, alice.reload.score
+    assert_equal 2, game.reload.played_question_count
+  end
+
+  # Points on the two active questions. Correct picks are made on both unless noted.
+  def pick(game, name, correct:)
+    game.record_answer(game.players.find_by!(name: name), game.current_question.game_options.find_by!(correct: correct).id)
+  end
+
+  # Alice 2 points, Bob 1 point, Cara 1 point, and the quiz is over.
+  def finished_game_with_tie_for_second
+    game = Game.create_from_quiz!(@quiz)
+    %w[ Alice Bob Cara ].each { |name| game.join(name) }
+    game.start!
+    pick(game, "Alice", correct: true)
+    pick(game, "Bob", correct: false)
+    pick(game, "Cara", correct: false)
+    game.finish_question!
+    game.next_question!
+    pick(game, "Alice", correct: true)
+    pick(game, "Bob", correct: true)
+    pick(game, "Cara", correct: true)
+    game.end_quiz!
+    game.reload
+  end
+
+  # Alice 2 points, Bob 1 point, Cara none, and the quiz is over.
+  def finished_game
+    game = Game.create_from_quiz!(@quiz)
+    %w[ Alice Bob Cara ].each { |name| game.join(name) }
+    game.start!
+    pick(game, "Alice", correct: true)
+    pick(game, "Bob", correct: false)
+    pick(game, "Cara", correct: false)
+    game.finish_question!
+    game.next_question!
+    pick(game, "Alice", correct: true)
+    pick(game, "Bob", correct: true)
+    game.end_quiz!
+    game.reload
+  end
+
+  test "a game copies the quiz's number of winners, and later changes to the quiz do not reach it" do
+    game = Game.create_from_quiz!(@quiz)
+    assert_equal 3, game.winner_count
+
+    @quiz.update!(winner_count: 5)
+    assert_equal 3, game.reload.winner_count
+    assert_equal 5, Game.create_from_quiz!(@quiz).winner_count
+  end
+
+  test "winners are picked only once the quiz is over" do
+    game = started_game
+    revision = game.revision
+
+    refute game.pick_top_winners!
+    refute game.draw_winners!
+    refute game.reset_winners!
+    assert_equal revision, game.reload.revision
+    assert_equal 0, game.winners.count
+  end
+
+  test "Top N picks the first N players with points, and bumps the revision" do
+    game = finished_game
+    revision = game.revision
+
+    assert game.pick_top_winners!
+    game.reload
+    assert_equal %w[ Alice Bob ], game.winners.map(&:name), "Cara has no points, so Top 3 leaves her out"
+    assert_equal revision + 1, game.revision
+  end
+
+  test "Top N uses the number of winners the game was started with" do
+    game = finished_game
+    game.update!(winner_count: 1)
+
+    assert game.pick_top_winners!
+    assert_equal %w[ Alice ], game.reload.winners.map(&:name)
+  end
+
+  test "each draw picks again: the players above the N-th place stay, the other prize is redrawn" do
+    game = finished_game_with_tie_for_second
+    game.update!(winner_count: 2)
+    revision = game.revision
+
+    drawn = (1..30).map do |seed|
+      assert game.draw_winners!(random: Random.new(seed))
+      winners = game.reload.winners.map(&:name)
+      assert_equal 2, winners.size
+      assert_includes winners, "Alice", "Alice has more points than the 2nd place"
+      winners.last
+    end
+
+    assert_equal %w[ Bob Cara ], drawn.uniq.sort, "either player level with the 2nd place can be drawn"
+    assert_equal revision + 30, game.revision, "every click is a change the pages follow"
+  end
+
+  test "a winner pick tells the screen and the phones, and changes their fingerprints" do
+    game = finished_game
+    screen = game_stream(game, :screen)
+    players = game_stream(game, :players)
+    before_screen = game.screen_fingerprint
+    before_phone = game.player_fingerprint(game.players.first)
+
+    assert_broadcasts(screen, 1) do
+      assert_broadcasts(players, 1) do
+        game.pick_top_winners!
+      end
+    end
+    game.reload
+    assert_not_equal before_screen, game.screen_fingerprint
+    assert_not_equal before_phone, game.player_fingerprint(game.players.first)
+  end
+
+  test "reset removes the winners, and is refused when there are none" do
+    game = finished_game
+    game.pick_top_winners!
+    assert_equal 2, game.reload.winners.count
+
+    assert game.reset_winners!
+    assert_equal 0, game.reload.winners.count
+    refute game.reset_winners!, "nothing left to reset"
+  end
+
+  test "with no players who have points, a pick leaves nobody a winner" do
+    game = Game.create_from_quiz!(@quiz)
+    game.join("Ann")
+    game.start!
+    game.end_quiz!
+
+    assert game.reload.pick_top_winners!
+    assert_equal 0, game.winners.count
+    assert game.draw_winners!
+    assert_equal 0, game.winners.count
+  end
+
+  private
+
+  def game_stream(game, channel)
+    # The raw name that `turbo_stream_from` subscribes to (broadcasting_for adds a prefix).
+    Turbo::StreamsChannel.send(:stream_name_from, [ game, channel ])
+  end
+end
diff --git a/test/models/leaderboard_test.rb b/test/models/leaderboard_test.rb
new file mode 100644
index 0000000..932470b
--- /dev/null
+++ b/test/models/leaderboard_test.rb
@@ -0,0 +1,209 @@
+require "test_helper"
+
+# Points, speed and winners. Times are set exactly with travel_to: a question opens at its slot in
+# the timeline, and each pick is made a given number of seconds after that.
+class LeaderboardTest < ActiveSupport::TestCase
+  T0 = Time.zone.local(2026, 11, 19, 10, 0, 0)
+  GAP = 100 # seconds between the openings of two questions
+
+  setup do
+    @quiz = create_quiz("Talk", questions: [
+      [ "Q1", [ [ "wrong", false ], [ "right", true ] ] ],
+      [ "Q2", [ [ "wrong", false ], [ "right", true ] ] ],
+      [ "Q3", [ [ "wrong", false ], [ "right", true ] ] ]
+    ])
+  end
+
+  # Plays a game. `picks` maps each player's name to one list per question, in order. Each list holds
+  # picks as [seconds after the question opened, correct?]; a later pick replaces an earlier one.
+  # Players join in the order of the hash.
+  def play(picks)
+    game = Game.create_from_quiz!(@quiz)
+    players = picks.keys.index_with { |name| game.join(name) }
+    question_count = game.question_count
+
+    question_count.times do |index|
+      opened = T0 + index * GAP
+      travel_to(opened) { index.zero? ? game.start! : game.next_question! }
+
+      picks.each do |name, per_question|
+        Array(per_question[index]).each do |seconds, correct|
+          travel_to(opened + seconds) do
+            option = game.game_questions.find_by!(position: index + 1).game_options.find_by!(correct: correct)
+            assert_equal :recorded, game.record_answer(players[name], option.id)
+          end
+        end
+      end
+
+      travel_to(opened + GAP - 1) { game.finish_question! }
+    end
+    travel_to(T0 + question_count * GAP) { game.end_quiz! }
+    game.reload
+  end
+
+  def names(game)
+    game.leaderboard.standings.map { |standing| standing.player.name }
+  end
+
+  def points(game)
+    game.leaderboard.standings.map(&:points)
+  end
+
+  test "each correct pick is one point, and places follow the order" do
+    game = play(
+      "Alice" => [ [ [ 10, true ] ], [ [ 10, true ] ], [ [ 10, false ] ] ],
+      "Bob" => [ [ [ 10, true ] ], [ [ 10, false ] ], [] ],
+      "Cara" => [ [], [], [] ]
+    )
+
+    standings = game.leaderboard.standings
+    assert_equal %w[ Alice Bob Cara ], standings.map { |standing| standing.player.name }
+    assert_equal [ 2, 1, 0 ], standings.map(&:points)
+    assert_equal [ 1, 2, 3 ], standings.map(&:place)
+  end
+
+  test "players level on points are ranked by the total time of their correct picks" do
+    game = play(
+      "Alice" => [ [ [ 10, true ] ], [ [ 20, true ] ], [] ],   # 30 seconds
+      "Bob" => [ [ [ 5, true ] ], [ [ 23, true ] ], [] ]       # 28 seconds: quicker, so first
+    )
+
+    assert_equal %w[ Bob Alice ], names(game)
+    assert_equal [ 2, 2 ], points(game)
+    assert_in_delta 28.0, game.leaderboard.standing_for(game.players.find_by(name: "Bob")).seconds
+  end
+
+  test "points come before speed: a slower player with more points is ahead" do
+    game = play(
+      "Slow" => [ [ [ 50, true ] ], [ [ 50, true ] ], [ [ 50, true ] ] ],  # 3 points, 150 seconds
+      "Quick" => [ [ [ 1, true ] ], [ [ 1, true ] ], [] ]                 # 2 points, 2 seconds
+    )
+
+    assert_equal %w[ Slow Quick ], names(game)
+  end
+
+  test "a wrong pick costs no time, and only the last pick on a question counts" do
+    game = play(
+      # Alice's first pick is right and quick, her last pick on Q1 is wrong: no point, no time.
+      "Alice" => [ [ [ 2, true ], [ 40, false ] ], [ [ 30, true ] ], [] ],
+      # Bob: right, but slower than Alice's Q2 pick would be.
+      "Bob" => [ [ [ 60, true ] ], [ [ 60, true ] ], [] ]
+    )
+
+    assert_equal %w[ Bob Alice ], names(game), "Alice has one point; Bob has two"
+    assert_equal [ 2, 1 ], points(game)
+
+    # The time runs to the last pick: Alice's Q1 pick at 90 s counts, not the one at 5 s.
+    # Alice: 90 + 30 = 120 seconds. Bob: 40 + 60 = 100 seconds, so Bob is quicker.
+    late = play(
+      "Alice" => [ [ [ 5, true ], [ 90, true ] ], [ [ 30, true ] ], [] ],
+      "Bob" => [ [ [ 40, true ] ], [ [ 60, true ] ], [] ]
+    )
+    assert_equal %w[ Bob Alice ], names(late)
+    assert_in_delta 120.0, late.leaderboard.standing_for(late.players.find_by(name: "Alice")).seconds
+  end
+
+  test "players level on points and time keep their join order" do
+    game = play(
+      "Dan" => [ [ [ 10, true ] ], [ [ 10, true ] ], [] ],
+      "Eve" => [ [ [ 10, true ] ], [ [ 10, true ] ], [] ]
+    )
+
+    assert_equal %w[ Dan Eve ], names(game)
+  end
+
+  test "players without points come last, in join order" do
+    game = play(
+      "Ann" => [ [], [], [] ],
+      "Ben" => [ [ [ 4, true ] ], [], [] ],
+      "Cy" => [ [ [ 1, false ] ], [], [] ],
+      "Di" => [ [], [], [] ]
+    )
+
+    assert_equal %w[ Ben Ann Cy Di ], names(game)
+    assert_equal [ 1, 0, 0, 0 ], points(game)
+    assert_equal [ 1, 2, 3, 4 ], game.leaderboard.standings.map(&:place)
+  end
+
+  test "top N is the first N players of the leaderboard, leaving out players without points" do
+    game = play(
+      "Alice" => [ [ [ 1, true ] ], [ [ 1, true ] ], [ [ 1, true ] ] ],
+      "Bob" => [ [ [ 1, true ] ], [ [ 1, true ] ], [] ],
+      "Cara" => [ [ [ 1, true ] ], [], [] ],
+      "Dan" => [ [], [], [] ]
+    )
+    board = game.leaderboard
+
+    assert_equal %w[ Alice Bob ], board.top(2).map(&:name)
+    assert_equal %w[ Alice Bob Cara ], board.top(3).map(&:name)
+    assert_equal %w[ Alice Bob Cara ], board.top(10).map(&:name), "fewer players with points than N: all of them win"
+  end
+
+  test "draw: players above the N-th place win, and the rest are drawn among the players level with it" do
+    game = play(
+      "Alice" => [ [ [ 1, true ] ], [ [ 1, true ] ], [ [ 1, true ] ] ],  # 3
+      "Bob" => [ [ [ 1, true ] ], [ [ 1, true ] ], [] ],                # 2
+      "Cara" => [ [ [ 2, true ] ], [ [ 2, true ] ], [] ],               # 2
+      "Dan" => [ [ [ 3, true ] ], [ [ 3, true ] ], [] ],                # 2
+      "Eve" => [ [ [ 1, true ] ], [], [] ]                              # 1
+    )
+    board = game.leaderboard
+    assert_equal [ 3, 2, 2, 2, 1 ], board.standings.map(&:points)
+
+    drawn = (1..60).map do |seed|
+      winners = board.draw(2, random: Random.new(seed)).map(&:name)
+      assert_equal 2, winners.size
+      assert_includes winners, "Alice", "more points than the 2nd place always wins"
+      winners.last
+    end
+
+    assert_equal %w[ Bob Cara Dan ], drawn.uniq.sort, "every player level with the 2nd place can be drawn"
+    assert_not_includes drawn, "Eve"
+  end
+
+  test "draw: a player level with the N-th place is drawn, but the players below it are not" do
+    game = play(
+      "Alice" => [ [ [ 1, true ] ], [ [ 1, true ] ], [] ],
+      "Bob" => [ [ [ 1, true ] ], [], [] ],
+      "Cara" => [ [ [ 1, true ] ], [], [] ]
+    )
+    winners = game.leaderboard.draw(2, random: Random.new(7)).map(&:name)
+
+    assert_equal 2, winners.size
+    assert_includes winners, "Alice", "more points than the 2nd place always wins"
+    assert_equal 1, (winners & %w[ Bob Cara ]).size, "the other prize goes to Bob or Cara, who are level"
+    seen = (1..40).map { |seed| game.leaderboard.draw(2, random: Random.new(seed)).map(&:name).last }
+    assert_equal %w[ Bob Cara ], seen.uniq.sort
+  end
+
+  test "draw: when the N-th place has no points, every player with points wins" do
+    game = play(
+      "Alice" => [ [ [ 1, true ] ], [ [ 1, true ] ], [] ],
+      "Bob" => [ [ [ 1, true ] ], [], [] ],
+      "Cara" => [ [], [], [] ],
+      "Dan" => [ [], [], [] ]
+    )
+
+    assert_equal %w[ Alice Bob ], game.leaderboard.draw(3).map(&:name)
+    assert_equal %w[ Alice Bob ], game.leaderboard.draw(4).map(&:name)
+  end
+
+  test "draw: a clear leaderboard gives the same winners every time" do
+    game = play(
+      "Alice" => [ [ [ 1, true ] ], [ [ 1, true ] ], [ [ 1, true ] ] ],
+      "Bob" => [ [ [ 1, true ] ], [ [ 1, true ] ], [] ],
+      "Cara" => [ [ [ 1, true ] ], [], [] ]
+    )
+
+    5.times do |seed|
+      assert_equal %w[ Alice Bob ], game.leaderboard.draw(2, random: Random.new(seed)).map(&:name)
+    end
+  end
+
+  test "draw: with no players who have points, nobody wins" do
+    game = play("Ann" => [ [], [], [] ], "Ben" => [ [], [], [] ])
+
+    assert_empty game.leaderboard.draw(2)
+    assert_empty game.leaderboard.top(2)
+  end
+end
diff --git a/test/models/question_test.rb b/test/models/question_test.rb
new file mode 100644
index 0000000..cbd37dd
--- /dev/null
+++ b/test/models/question_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class QuestionTest < ActiveSupport::TestCase
+  setup { @quiz = create_quiz }
+
+  def build_question(rows, text: "Q")
+    question = Question.new(quiz: @quiz, text: text, active: true)
+    question.option_rows = rows
+    question
+  end
+
+  test "empty rows are skipped and the rest is saved in order" do
+    question = build_question([
+      { text: "", correct: true }, { text: "A", correct: false }, { text: "  ", correct: false }, { text: "B", correct: true }
+    ])
+    assert question.save
+    assert_equal %w[A B], question.options.map(&:text)
+    assert_equal [ 1, 2 ], question.options.map(&:position)
+  end
+
+  test "option rules" do
+    refute build_question([ { text: "A", correct: true } ]).valid?
+    single = build_question([ { text: "A", correct: true } ])
+    single.valid?
+    assert_includes single.errors.full_messages, "Add at least two options"
+
+    question = build_question([ { text: "A", correct: false }, { text: "B", correct: false } ])
+    refute question.valid?
+    assert_equal [ "Mark at least one option as correct" ], question.errors.full_messages
+
+    assert build_question([ { text: "A", correct: true }, { text: "B", correct: true } ]).valid?
+  end
+
+  test "a correct box on an empty row does not count" do
+    question = build_question([ { text: "A", correct: false }, { text: "B", correct: false }, { text: "", correct: true } ])
+    refute question.valid?
+    assert_includes question.errors.full_messages, "Mark at least one option as correct"
+  end
+
+  test "form rows pad to four and keep typed rows" do
+    question = Question.new(quiz: @quiz)
+    assert_equal 4, question.form_option_rows.size
+    question.option_rows = [ { text: "A", correct: true } ]
+    assert_equal [ "A" ], question.form_option_rows.map { |row| row[:text] }
+  end
+
+  test "stored question keeps its options when only Active changes" do
+    question = build_question([ { text: "A", correct: true }, { text: "B", correct: false } ])
+    question.save!
+    question.update!(active: false)
+    assert_equal [ "A", "B" ], question.reload.options.map(&:text)
+  end
+
+  test "move_up and move_down swap positions with neighbours" do
+    a = build_question([ { text: "A", correct: true }, { text: "B", correct: false } ], text: "a").tap(&:save!)
+    b = build_question([ { text: "A", correct: true }, { text: "B", correct: false } ], text: "b").tap(&:save!)
+    assert b.move_up
+    assert_equal %w[b a], @quiz.questions.reload.map(&:text)
+    refute b.move_up
+    assert a.move_down == false
+    assert_equal %w[b a], @quiz.questions.reload.map(&:text)
+  end
+end
diff --git a/test/models/quiz_import_test.rb b/test/models/quiz_import_test.rb
new file mode 100644
index 0000000..44886c3
--- /dev/null
+++ b/test/models/quiz_import_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class QuizImportServiceTest < ActiveSupport::TestCase
+  def valid_json
+    {
+      "title" => "Talk",
+      "questions" => [
+        { "text" => "One", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+        { "text" => "Two", "active" => false, "options" => [ { "text" => "C" }, { "text" => "D", "correct" => true } ] }
+      ]
+    }.to_json
+  end
+
+  def counts
+    [ Quiz.count, Question.count, Option.count ]
+  end
+
+  test "a valid document creates the quiz, its questions and options, in order" do
+    import = QuizImport.new(valid_json)
+    before = counts
+    assert import.save
+    assert_equal [ before[0] + 1, before[1] + 2, before[2] + 4 ], counts
+    quiz = import.quiz
+    assert quiz.persisted?
+    assert_equal [ "One", "Two" ], quiz.questions.map(&:text)
+    assert_equal [ 1, 2 ], quiz.questions.map(&:position)
+    assert_equal [ true, false ], quiz.questions.map(&:active?)
+    assert_equal [ [ "A", "B" ], [ "C", "D" ] ], quiz.questions.map { |q| q.options.map(&:text) }
+  end
+
+  test "several broken questions are all reported and nothing is saved" do
+    json = {
+      "title" => "Talk",
+      "questions" => [
+        { "text" => "", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+        { "text" => "Two", "options" => [ { "text" => "C" } ] }
+      ]
+    }.to_json
+    import = QuizImport.new(json)
+    before = counts
+    refute import.save
+    assert_equal before, counts
+    assert_equal [
+      "Question 1: Question can't be blank",
+      "Question 2: Add at least two options",
+      "Question 2: Mark at least one option as correct"
+    ], import.errors.full_messages
+  end
+
+  test "saving twice imports once" do
+    import = QuizImport.new(valid_json)
+    before = counts
+    assert import.save
+    assert import.save
+    assert_equal before.zip([ 1, 2, 4 ]).map(&:sum), counts
+  end
+
+  test "checking twice does not build the questions twice" do
+    import = QuizImport.new(valid_json)
+    assert import.valid?
+    assert import.valid?
+    assert import.save
+    assert_equal 2, import.quiz.questions.count
+  end
+
+  test "text that is not valid UTF-8 is reported, not raised" do
+    import = QuizImport.new("{\"title\": \"\xff\"}".dup.force_encoding("UTF-8"))
+    refute import.save
+    assert_equal [ "Quiz JSON is not valid JSON" ], import.errors.full_messages
+  end
+
+  test "an empty title, with questions that are fine, is reported and imports nothing" do
+    json = { "title" => "", "questions" => [ { "text" => "Q", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] } ] }.to_json
+    import = QuizImport.new(json)
+    before = counts
+    refute import.save
+    assert_equal [ "Title can't be blank" ], import.errors.full_messages
+    assert_equal before, counts
+  end
+
+  test "surrounding whitespace is trimmed from the title, the question and the options" do
+    json = { "title" => "  Padded  ", "questions" => [ { "text" => " Q ", "options" => [ { "text" => " A ", "correct" => true }, { "text" => "B" } ] } ] }.to_json
+    import = QuizImport.new(json)
+    assert import.save
+    assert_equal "Padded", import.quiz.title
+    assert_equal "Q", import.quiz.questions.first.text
+    assert_equal [ "A", "B" ], import.quiz.questions.first.options.map(&:text)
+  end
+end
diff --git a/test/models/quiz_preview_test.rb b/test/models/quiz_preview_test.rb
