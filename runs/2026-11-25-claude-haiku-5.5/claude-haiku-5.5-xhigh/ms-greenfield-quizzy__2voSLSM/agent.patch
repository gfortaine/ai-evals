diff --git a/app/views/moderate/games/_question.html.erb b/app/views/moderate/games/_question.html.erb
new file mode 100644
index 0000000..5bcbadd
--- /dev/null
+++ b/app/views/moderate/games/_question.html.erb
@@ -0,0 +1,40 @@
+<% question = @game.current_question %>
+<% counts = question.answers.group(:game_option_id).count %>
+<% answered = counts.values.sum %>
+<% players = @game.players.count %>
+
+<div class="stage-question__head">
+  <div class="stage-question__num">Question <%= @game.current_position %> of <%= @game.question_count %></div>
+  <%# Only while the question is open, and only with a timer. The countdown runs on this page; see countdown_controller.js. %>
+  <% time_left = @game.time_left %>
+  <% if time_left %>
+    <div class="timer" role="timer" aria-label="Time left" data-controller="countdown"
+         data-countdown-ms-value="<%= (time_left * 1000).round %>">
+      <span data-countdown-target="display"><%= countdown_text(time_left) %></span>
+    </div>
+  <% end %>
+</div>
+<div class="stage-question__body"><%= question.text %></div>
+
+<ol class="stage-options<%= " stage-options--results" if @game.closed? %>">
+  <% question.game_options.each_with_index do |option, index| %>
+    <% if @game.closed? %>
+      <% count = counts.fetch(option.id, 0) %>
+      <% share = answered.zero? ? 0 : (count * 100.0 / answered).round %>
+      <li class="stage-option<%= " is-correct" if option.correct? %>" style="--share: <%= share %>%">
+        <span class="stage-option__bar" aria-hidden="true"></span>
+        <span class="stage-option__letter" aria-hidden="true"><%= ("A".ord + index).chr %></span>
+        <span class="stage-option__title"><%= option.text %></span>
+        <span class="stage-option__count"><%= count %></span>
+        <% if option.correct? %><span class="mark mark--right">Correct</span><% end %>
+      </li>
+    <% else %>
+      <li class="stage-option">
+        <span class="stage-option__letter" aria-hidden="true"><%= ("A".ord + index).chr %></span>
+        <span class="stage-option__title"><%= option.text %></span>
+      </li>
+    <% end %>
+  <% end %>
+</ol>
+
+<p class="answers-counter">Answers: <%= answered %> / <%= players %></p>
