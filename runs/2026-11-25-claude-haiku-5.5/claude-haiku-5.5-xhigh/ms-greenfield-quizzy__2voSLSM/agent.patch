+    <span class="field-hint">Paste the JSON from a quiz’s Export page. Importing always creates a new quiz.</span>
+    <%= text_area_tag :quiz_json, @json, class: "input input--code", rows: 16, spellcheck: "false", autofocus: true %>
+  </div>
+
+  <div class="buttons">
+    <button type="submit" class="btn btn--pink">Import</button>
+    <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+  </div>
+<% end %>
diff --git a/app/views/moderate/questions/_form.html.erb b/app/views/moderate/questions/_form.html.erb
new file mode 100644
index 0000000..7803c70
--- /dev/null
+++ b/app/views/moderate/questions/_form.html.erb
@@ -0,0 +1,66 @@
+<% url = question.new_record? ? moderate_quiz_questions_path(question.quiz) : moderate_question_path(question) %>
+<% method = question.new_record? ? :post : :patch %>
+<% rows = question.form_option_rows %>
+
+<%# Turbo is off for this form: "Add option" re-renders the page without saving, and
+    validation errors are plain 422 pages with the typed values. %>
+<%= form_with model: question, url: url, method: method, scope: :question, class: "card", data: { turbo: false } do |f| %>
+  <%# Enter in a text field submits through the first submit button, so the real "Save question" must come first. %>
+  <button type="submit" name="save" value="1" hidden></button>
+
+  <% if question.errors.any? %>
+    <div class="errors">
+      <ul>
+        <% question.errors.full_messages.each do |message| %>
+          <li><%= message %></li>
+        <% end %>
+      </ul>
+    </div>
+  <% end %>
+
+  <div class="field">
+    <%= f.label :text, "Question", class: "field-label" %>
+    <%= f.text_area :text, rows: 3, class: "input", required: true, maxlength: 500, autofocus: true %>
+  </div>
+
+  <fieldset class="field option-field">
+    <legend class="field-label">Options</legend>
+    <span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span>
+
+    <div class="option-rows">
+      <% rows.each_with_index do |row, index| %>
+        <% number = index + 1 %>
+        <div class="option-row">
+          <label class="visually-hidden" for="question_options_<%= index %>_text">Option <%= number %></label>
+          <input class="input" type="text" id="question_options_<%= index %>_text"
+                 name="question[options][<%= index %>][text]" value="<%= row[:text] %>"
+                 placeholder="Option text" maxlength="200">
+
+          <label class="checkbox">
+            <input type="checkbox" id="question_options_<%= index %>_correct"
+                   name="question[options][<%= index %>][correct]" value="1"<%= " checked" if row[:correct] %>>
+            Option <%= number %> is correct
+          </label>
+        </div>
+      <% end %>
+    </div>
+
+    <div class="buttons option-add">
+      <button type="submit" name="add_option" value="1" formnovalidate class="btn btn--ghost btn--sm">Add option</button>
+    </div>
+  </fieldset>
+
+  <div class="field">
+    <%= hidden_field_tag "question[active]", "0", id: nil %>
+    <label class="checkbox">
+      <%= check_box_tag "question[active]", "1", question.active?, id: "question_active" %>
+      Active
+    </label>
+    <span class="field-hint">Only active questions are played.</span>
+  </div>
+
+  <div class="buttons">
+    <button type="submit" class="btn btn--pink">Save question</button>
+    <%= link_to "Cancel", moderate_quiz_path(question.quiz), class: "btn btn--ghost" %>
+  </div>
+<% end %>
diff --git a/app/views/moderate/questions/_item.html.erb b/app/views/moderate/questions/_item.html.erb
