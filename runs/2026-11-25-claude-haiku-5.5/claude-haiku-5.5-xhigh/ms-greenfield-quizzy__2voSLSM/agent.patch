+ENV["RAILS_ENV"] ||= "test"
+require_relative "../config/environment"
+require "rails/test_help"
+
+# Moderator credentials used by the test suite.
+ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+ENV["QUIZZY_MODERATOR_PASSWORD"] = "test-password"
+
+module ModeratorHelpers
+  def moderator_auth
+    { "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "test-password") }
+  end
+
+  # Creates a quiz with the given questions, each as [text, [[option_text, correct?], ...], active?].
+  def create_quiz(title = "Frontend Fest 2026", questions: [])
+    quiz = Quiz.create!(title: title)
+    questions.each do |text, options, active = true|
+      question = Question.new(quiz: quiz, text: text, active: active)
+      question.option_rows = options.map { |option_text, correct| { text: option_text, correct: correct } }
+      question.save!
+    end
+    quiz
+  end
+end
+
+class ActiveSupport::TestCase
+  include ModeratorHelpers
+end
+
+class ActionDispatch::IntegrationTest
+  include ModeratorHelpers
+end
