+require "test_helper"
+require "capybara/cuprite"
+
+# Browser tests run on the local Chromium through Cuprite (no chromedriver download needed).
+class ApplicationSystemTestCase < ActionDispatch::SystemTestCase
+  driven_by :cuprite, screen_size: [ 1280, 1000 ], options: {
+    browser_path: ENV.fetch("CHROME_BIN", "/usr/bin/chromium"),
+    headless: true,
+    js_errors: true,
+    timeout: 15,
+    process_timeout: 60,
+    browser_options: { "no-sandbox" => nil, "disable-gpu" => nil }
+  }
+
+  setup do
+    # Every request from the browser carries the moderator's credentials.
+    page.driver.browser.headers.set({ "Authorization" => moderator_auth["Authorization"] })
+  end
+end
