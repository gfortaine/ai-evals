diff --git a/app/javascript/controllers/countdown_controller.js b/app/javascript/controllers/countdown_controller.js
new file mode 100644
index 0000000..a053739
--- /dev/null
+++ b/app/javascript/controllers/countdown_controller.js
@@ -0,0 +1,39 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Counts the open question's time down on the big screen, as M:SS, to 0:00.
+//
+// The server gives the time left when it draws the region (`data-countdown-ms-value`). This counts
+// down from that moment on this page, so no request is needed each second, and a throttled timer
+// cannot make it drift: the time is read from the clock each time. The countdown starts when the
+// response arrives, which is after the server measured the time left, so reaching zero here is never
+// before the server's deadline. At zero it asks the live region for a fresh state (the
+// `quizzy:refresh` event). The server then ends the question, as "Finish" would.
+export default class extends Controller {
+  static values = { ms: Number }
+  static targets = [ "display" ]
+
+  connect() {
+    this.endsAt = performance.now() + this.msValue
+    this.askedForRefresh = false
+    this.tick()
+    this.timer = window.setInterval(() => this.tick(), 250)
+  }
+
+  disconnect() {
+    window.clearInterval(this.timer)
+  }
+
+  tick() {
+    const seconds = Math.max(0, Math.ceil((this.endsAt - performance.now()) / 1000))
+    this.displayTarget.textContent = formatSeconds(seconds)
+
+    if (seconds === 0 && !this.askedForRefresh) {
+      this.askedForRefresh = true
+      window.dispatchEvent(new CustomEvent("quizzy:refresh"))
+    }
+  }
+}
+
+function formatSeconds(seconds) {
+  return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`
+}
