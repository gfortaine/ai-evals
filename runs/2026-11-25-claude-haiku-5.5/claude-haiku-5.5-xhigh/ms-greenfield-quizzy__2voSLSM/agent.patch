--- /dev/null
+++ b/test/integration/quizzes_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class QuizzesTest < ActionDispatch::IntegrationTest
+  test "new quiz form has one Title field and a Save quiz button" do
+    get new_moderate_quiz_path, headers: moderator_auth
+    assert_response :ok
+    assert_select "label", text: "Title"
+    assert_select "input[type=text][name='quiz[title]'][required]"
+    assert_select "button", text: "Save quiz"
+  end
+
+  test "creating a quiz opens the quiz page" do
+    post moderate_quizzes_path, params: { quiz: { title: "Frontend Fest 2026" } }, headers: moderator_auth
+    quiz = Quiz.find_by!(title: "Frontend Fest 2026")
+    assert_redirected_to moderate_quiz_path(quiz)
+  end
+
+  test "a blank title is rejected and nothing is saved" do
+    assert_no_difference "Quiz.count" do
+      post moderate_quizzes_path, params: { quiz: { title: "   " } }, headers: moderator_auth
+    end
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Title can't be blank"
+  end
+
+  test "quiz page shows title, questions in order, and the actions" do
+    quiz = create_quiz("Frontend Fest 2026", questions: [
+      [ "First question", [ [ "A", true ], [ "B", false ] ] ],
+      [ "Second question", [ [ "C", false ], [ "D", true ] ] ]
+    ])
+    get moderate_quiz_path(quiz), headers: moderator_auth
+    assert_response :ok
+    assert_select "h1", text: "Frontend Fest 2026"
+    assert_select "ol.question-list > li", count: 2
+    assert_select "ol.question-list > li:first-child", text: /First question/
+    assert_select "button", text: "Add question"
+    assert_select "a", text: "Settings"
+    assert_select "a", text: "Preview"
+    assert_select "li.question-item li.is-correct", text: /A/
+  end
+
+  test "settings shows the same form and a Delete quiz button" do
+    quiz = create_quiz("Old title")
+    get edit_moderate_quiz_path(quiz), headers: moderator_auth
+    assert_response :ok
+    assert_select "input[name='quiz[title]'][value='Old title']"
+    assert_select "button", text: "Save quiz"
+    assert_select "button", text: "Delete quiz"
+  end
+
+  test "updating the title" do
+    quiz = create_quiz("Old")
+    patch moderate_quiz_path(quiz), params: { quiz: { title: "New" } }, headers: moderator_auth
+    assert_redirected_to moderate_quiz_path(quiz)
+    assert_equal "New", quiz.reload.title
+  end
+
+  test "deleting a quiz removes its questions" do
+    quiz = create_quiz(questions: [ [ "Q", [ [ "A", true ], [ "B", false ] ] ] ])
+    assert_difference({ "Quiz.count" => -1, "Question.count" => -1, "Option.count" => -2 }) do
+      delete moderate_quiz_path(quiz), headers: moderator_auth
+    end
+    assert_redirected_to moderate_quizzes_path
+  end
+end
diff --git a/test/integration/timer_test.rb b/test/integration/timer_test.rb
new file mode 100644
index 0000000..e5eb02d
--- /dev/null
+++ b/test/integration/timer_test.rb
@@ -0,0 +1,216 @@
+require "test_helper"
+
+# The timer, end to end over HTTP: the quiz settings, the countdown on the big screen (which players
+# never see), the question closing at 0:00, and the phones' answers after the deadline.
+class TimerIntegrationTest < ActionDispatch::IntegrationTest
+  OPENED = Time.zone.local(2026, 11, 19, 10, 0, 0)
+
+  setup do
+    @quiz = create_quiz("Frontend Fest 2026", questions: [
+      [ "Which HTTP status code means \"Too Many Requests\"?", [ [ "418", false ], [ "429", true ] ] ],
+      [ "Which protocol is two-way?", [ [ "WebSocket", true ], [ "SMTP", false ] ] ]
+    ])
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    @game = Game.create_from_quiz!(@quiz)
+  end
+
+  def start_at(time = OPENED)
+    travel_to(time) { post start_moderate_game_path(@game), headers: moderator_auth }
+  end
+
+  def big_screen_at(time)
+    travel_to(time) { get moderate_game_path(@game), headers: moderator_auth }
+  end
+
+  def option_id(text)
+    @game.game_questions.find_by!(position: 1).game_options.find_by!(text: text).id
+  end
+
+  test "the quiz settings have Timer minutes and Timer seconds, 0 by default" do
+    get new_moderate_quiz_path, headers: moderator_auth
+    assert_select "label", text: "Timer minutes"
+    assert_select "label", text: "Timer seconds"
+    assert_select "input[type=number][name='quiz[timer_minutes]'][value='0']"
+    assert_select "input[type=number][name='quiz[timer_seconds]'][value='0']"
+  end
+
+  test "the settings show and save the time per question" do
+    quiz = create_quiz("Timed")
+    get edit_moderate_quiz_path(quiz), headers: moderator_auth
+    assert_select "input[name='quiz[timer_minutes]'][value='0']"
+
+    patch moderate_quiz_path(quiz), params: { quiz: { title: "Timed", timer_minutes: "1", timer_seconds: "30" } }, headers: moderator_auth
+    assert_redirected_to moderate_quiz_path(quiz)
+    assert_equal 90, quiz.reload.time_per_question
+
+    get edit_moderate_quiz_path(quiz), headers: moderator_auth
+    assert_select "input[name='quiz[timer_minutes]'][value='1']"
+    assert_select "input[name='quiz[timer_seconds]'][value='30']"
+  end
+
+  test "a quiz page says what time each question gets" do
+    get moderate_quiz_path(@quiz), headers: moderator_auth
+    assert_select ".meta", text: /Time per question: 1:30/
+
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    get moderate_quiz_path(@quiz), headers: moderator_auth
+    assert_select ".meta", text: /Time per question: no timer/
+  end
+
+  test "seconds of 60 or more are refused with a message, and nothing is saved" do
+    patch moderate_quiz_path(@quiz), params: { quiz: { title: "Renamed", timer_minutes: "1", timer_seconds: "60" } }, headers: moderator_auth
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Timer seconds must be a whole number from 0 to 59"
+    assert_equal 30, @quiz.reload.timer_seconds
+    assert_equal "Frontend Fest 2026", @quiz.title
+  end
+
+  test "the export has no timer: the timer is a setting of this Quizzy" do
+    get export_moderate_quiz_path(@quiz), headers: moderator_auth
+    exported = JSON.parse(css_select("pre").text)
+    assert_equal %w[questions title], exported.keys.sort
+    assert_no_match(/timer/i, css_select("pre").text)
+  end
+
+  test "importing a quiz with timer keys does not set a timer" do
+    document = { title: "From file", timer_minutes: 5, timer_seconds: 0, questions: [] }
+    post moderate_imports_path, params: { quiz_json: document.to_json }, headers: moderator_auth
+    imported = Quiz.find_by!(title: "From file")
+    assert_equal 0, imported.time_per_question
+  end
+
+  test "the big screen counts the open question down as M:SS, from the moment it opened" do
+    start_at
+    big_screen_at(OPENED)
+    assert_select "[role=timer]", text: "1:30"
+    assert_select "[data-controller=countdown][data-countdown-ms-value='90000']"
+
+    big_screen_at(OPENED + 20)
+    assert_select "[role=timer]", text: "1:10"
+    assert_select "[data-countdown-ms-value='70000']"
+  end
+
+  test "reloading the big screen does not restart the countdown" do
+    start_at
+    big_screen_at(OPENED + 45)
+    assert_select "[role=timer]", text: "0:45"
+
+    big_screen_at(OPENED + 46)
+    assert_select "[role=timer]", text: "0:44"
+  end
+
+  test "the lobby and a closed question show no countdown" do
+    big_screen_at(OPENED)
+    assert_select "[role=timer]", count: 0, message: "the lobby has no countdown"
+
+    start_at
+    travel_to(OPENED + 10) { post finish_moderate_game_path(@game), headers: moderator_auth }
+    big_screen_at(OPENED + 11)
+    assert_select "[role=timer]", count: 0, message: "a closed question has no countdown"
+  end
+
+  test "a game without a timer has no countdown" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    game = Game.create_from_quiz!(@quiz)
+    travel_to(OPENED) { post start_moderate_game_path(game), headers: moderator_auth }
+
+    travel_to(OPENED + 3600) { get moderate_game_path(game), headers: moderator_auth }
+    assert_select "[role=timer]", count: 0
+    assert_select "[data-controller=countdown]", count: 0
+    assert_select ".stage-question__num", text: "Question 1 of 2"
+    assert game.reload.open?, "nothing closes the question on its own"
+  end
+
+  test "the question closes by itself at 0:00: the screen and the phones show its results" do
+    start_at
+    travel_to(OPENED + 10) { get live_moderate_game_path(@game), headers: moderator_auth }
+    etag = response.headers["ETag"]
+
+    travel_to(OPENED + 90) do
+      get live_moderate_game_path(@game), headers: moderator_auth.merge("If-None-Match" => etag)
+    end
+    assert_response :ok
+    assert_select "[role=timer]", count: 0
+    assert_select "li.stage-option.is-correct", text: /429/
+    assert_select "button", text: "Next"
+    assert_select "button", text: "Finish", count: 0
+    assert @game.reload.closed?
+    assert_equal OPENED + 90, @game.current_question.closed_at
+  end
+
+  test "the big screen's poll does not redraw while the countdown runs" do
+    start_at
+    travel_to(OPENED) { get live_moderate_game_path(@game), headers: moderator_auth }
+    etag = response.headers["ETag"]
+
+    travel_to(OPENED + 20) do
+      get live_moderate_game_path(@game), headers: moderator_auth.merge("If-None-Match" => etag)
+    end
+    assert_response :not_modified
+  end
+
+  test "Finish works before the time is up, and the countdown ends with the question" do
+    start_at
+    travel_to(OPENED + 15) { post finish_moderate_game_path(@game), headers: moderator_auth }
+    assert @game.reload.closed?
+    assert_equal OPENED + 15, @game.current_question.closed_at
+
+    travel_to(OPENED + 100) { get moderate_game_path(@game), headers: moderator_auth }
+    assert_select "[role=timer]", count: 0
+  end
+
+  test "a phone shows no timer and no time, while the question is open" do
+    start_at
+    phone = open_session
+    travel_to(OPENED + 5) do
+      phone.post play_join_path(@game.code), params: { name: "Alice" }
+      phone.get play_path(@game.code)
+    end
+    phone.assert_select "[role=timer]", count: 0
+    phone.assert_select "[data-controller=countdown]", count: 0
+    assert_no_match(/\b\d{1,2}:\d{2}\b/, phone.response.body, "players see no clock")
+    phone.assert_select "button.play-option", count: 2
+  end
+
+  test "a pick after the deadline is refused, and the phone then shows the question as closed" do
+    start_at
+    phone = open_session
+    travel_to(OPENED + 5) do
+      phone.post play_join_path(@game.code), params: { name: "Alice" }
+    end
+
+    travel_to(OPENED + 95) do
+      phone.post play_answers_path(@game.code), params: { option_id: option_id("418") }
+      phone.assert_redirected_to play_path(@game.code)
+      phone.follow_redirect!
+    end
+    phone.assert_select ".flash", text: "This question is closed."
+    phone.assert_select ".play-status", text: "No answer"
+    assert_nil Answer.first, "the late pick is not kept"
+    assert @game.reload.closed?
+    assert_equal OPENED + 90, @game.current_question.closed_at
+  end
+
+  test "a phone's live poll after the deadline shows the question as closed" do
+    start_at
+    phone = open_session
+    travel_to(OPENED + 5) { phone.post play_join_path(@game.code), params: { name: "Alice" } }
+    travel_to(OPENED + 6) { phone.get play_live_path(@game.code) }
+    etag = phone.response.headers["ETag"]
+
+    travel_to(OPENED + 91) { phone.get play_live_path(@game.code), headers: { "If-None-Match" => etag } }
+    phone.assert_response :ok
+    phone.assert_select ".play-status", text: "No answer"
+    assert_includes phone.response.body, "Waiting for the next question"
+  end
+
+  test "a new question opened by Next gets a fresh countdown" do
+    start_at
+    travel_to(OPENED + 90) { post finish_moderate_game_path(@game), headers: moderator_auth }
+    travel_to(OPENED + 100) { post next_question_moderate_game_path(@game), headers: moderator_auth }
+
+    travel_to(OPENED + 130) { get moderate_game_path(@game), headers: moderator_auth }
+    assert_select ".stage-question__num", text: "Question 2 of 2"
+    assert_select "[role=timer]", text: "1:00"
+  end
+end
diff --git a/test/integration/winners_test.rb b/test/integration/winners_test.rb
new file mode 100644
index 0000000..7a4c46a
--- /dev/null
+++ b/test/integration/winners_test.rb
@@ -0,0 +1,259 @@
+require "test_helper"
+
+# The end of a game: the leaderboard on the big screen, the place and points on each phone, and the
+# winners picked by the moderator.
+class WinnersTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = create_quiz("Frontend Fest 2026", questions: [
+      [ "Which HTTP status code means \"Too Many Requests\"?", [ [ "418", false ], [ "429", true ] ] ],
+      [ "Which protocol is two-way?", [ [ "WebSocket", true ], [ "SMTP", false ] ] ]
+    ])
+  end
+
+  def pick(game, name, correct:)
+    game.record_answer(game.players.find_by!(name: name), game.current_question.game_options.find_by!(correct: correct).id)
+  end
+
+  # A phone that joined `game` under `name`, from its own browser session.
+  def phone_for(game, name)
+    session = open_session
+    session.post play_join_path(game.code), params: { name: name }
+    session
+  end
+
+  # Alice 2 points, Bob 1 point, Cara 1 point, Dan none: the quiz is over. Each player joins from a
+  # phone before the game starts; the phones are in @phones, by name.
+  def finished_game(winner_count: 3)
+    game = Game.create_from_quiz!(@quiz)
+    game.update!(winner_count: winner_count)
+    @phones = %w[ Alice Bob Cara Dan ].index_with { |name| phone_for(game, name) }
+    game.start!
+    pick(game, "Alice", correct: true)
+    pick(game, "Bob", correct: false)
+    pick(game, "Cara", correct: false)
+    game.finish_question!
+    game.next_question!
+    pick(game, "Alice", correct: true)
+    pick(game, "Bob", correct: true)
+    pick(game, "Cara", correct: true)
+    game.end_quiz!
+    game
+  end
+
+  test "the settings form has a Number of winners field, 3 by default, that saves a new number" do
+    get new_moderate_quiz_path, headers: moderator_auth
+    assert_select "label", text: "Number of winners"
+    assert_select "input[type=number][name='quiz[winner_count]'][value='3'][min='1'][required]"
+
+    post moderate_quizzes_path, params: { quiz: { title: "Talk", winner_count: 2 } }, headers: moderator_auth
+    assert_equal 2, Quiz.find_by!(title: "Talk").winner_count
+  end
+
+  test "the number of winners must be at least 1, and the form says so" do
+    quiz = create_quiz("Talk")
+
+    patch moderate_quiz_path(quiz), params: { quiz: { title: "Talk", winner_count: 0 } }, headers: moderator_auth
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Number of winners must be greater than or equal to 1"
+    assert_equal 3, quiz.reload.winner_count
+  end
+
+  test "the screen has no winner buttons until the quiz is over" do
+    game = Game.create_from_quiz!(@quiz)
+    get moderate_game_path(game), headers: moderator_auth
+    assert_select "button", text: "Top 3", count: 0
+    assert_select "button", text: "Draw", count: 0
+    assert_select "button", text: "Reset winners", count: 0
+
+    game.start!
+    get moderate_game_path(game), headers: moderator_auth
+    assert_select "button", text: "Top 3", count: 0
+  end
+
+  test "once the quiz is over the screen has Top N, Draw and Reset winners" do
+    game = finished_game(winner_count: 2)
+    get moderate_game_path(game), headers: moderator_auth
+
+    assert_select "form[action=?] button", top_winners_moderate_game_path(game), text: "Top 2"
+    assert_select "form[action=?] button", draw_winners_moderate_game_path(game), text: "Draw"
+    assert_select "form[action=?] button", reset_winners_moderate_game_path(game), text: "Reset winners"
+  end
+
+  test "the leaderboard has one list item per player, in order, with the place, the name and the points" do
+    game = finished_game
+    get moderate_game_path(game), headers: moderator_auth
+
+    assert_select "h1", text: "The quiz is over"
+    assert_select "ol.leaderboard > li", count: 4
+    assert_select "ol.leaderboard > li:nth-child(1)", text: /1\s*Alice\s*2 points/
+    assert_select "ol.leaderboard > li:nth-child(2)", text: /2\s*Bob\s*1 point\b/
+    assert_select "ol.leaderboard > li:nth-child(3)", text: /3\s*Cara\s*1 point\b/
+    assert_select "ol.leaderboard > li:nth-child(4)", text: /4\s*Dan\s*0 points/
+    assert_select "li .leader__badge", count: 0
+  end
+
+  test "the leaderboard is in speed order when points are level" do
+    game = finished_game
+    bob = game.players.find_by!(name: "Bob")
+    cara = game.players.find_by!(name: "Cara")
+    # Bob and Cara both have 1 point: Cara's correct pick is quicker than Bob's.
+    question = game.game_questions.last
+    question.answers.find_by!(player: cara).update_columns(picked_at: question.opened_at + 1)
+    question.answers.find_by!(player: bob).update_columns(picked_at: question.opened_at + 90)
+
+    get moderate_game_path(game), headers: moderator_auth
+    assert_select "ol.leaderboard > li:nth-child(2)", text: /Cara/
+    assert_select "ol.leaderboard > li:nth-child(3)", text: /Bob/
+  end
+
+  test "Top N marks the first N players with points as winners, and the screen shows the Winner mark" do
+    game = finished_game(winner_count: 3)
+    post top_winners_moderate_game_path(game), headers: moderator_auth
+    assert_redirected_to moderate_game_path(game)
+
+    get moderate_game_path(game), headers: moderator_auth
+    assert_select "ol.leaderboard > li.is-winner", count: 3
+    assert_select "ol.leaderboard > li:nth-child(1) .leader__badge", text: "Winner"
+    assert_select "ol.leaderboard > li:nth-child(3) .leader__badge", text: "Winner"
+    assert_select "ol.leaderboard > li:nth-child(4) .leader__badge", count: 0
+  end
+
+  test "Draw keeps the players above the N-th place and gives the other winner mark at random" do
+    game = finished_game(winner_count: 2)
+    post draw_winners_moderate_game_path(game), headers: moderator_auth
+    assert_redirected_to moderate_game_path(game)
+
+    winners = game.reload.winners.map(&:name)
+    assert_equal 2, winners.size
+    assert_includes winners, "Alice"
+    assert_equal 1, (winners & %w[ Bob Cara ]).size, "Bob and Cara are level for the second prize"
+    get moderate_game_path(game), headers: moderator_auth
+    assert_select "ol.leaderboard > li.is-winner", count: 2
+  end
+
+  test "Reset winners removes every Winner mark, and says so when there is nobody to reset" do
+    game = finished_game(winner_count: 2)
+    post top_winners_moderate_game_path(game), headers: moderator_auth
+    post reset_winners_moderate_game_path(game), headers: moderator_auth
+    assert_equal 0, game.reload.winners.count
+
+    get moderate_game_path(game), headers: moderator_auth
+    assert_select "ol.leaderboard > li.is-winner", count: 0
+    assert_select "li .leader__badge", count: 0
+
+    post reset_winners_moderate_game_path(game), headers: moderator_auth
+    get moderate_game_path(game), headers: moderator_auth
+    assert_select ".flash", text: "There are no winners to reset."
+  end
+
+  test "the winner steps are refused while the quiz is running, and say why" do
+    game = Game.create_from_quiz!(@quiz)
+    game.join("Alice")
+    game.start!
+
+    post top_winners_moderate_game_path(game), headers: moderator_auth
+    assert_redirected_to moderate_game_path(game)
+    get moderate_game_path(game), headers: moderator_auth
+    assert_select ".flash--alert", text: "Winners can be picked once the quiz is over."
+    assert_equal 0, game.reload.winners.count
+  end
+
+  test "a pick with nobody who has points says that nobody wins" do
+    game = Game.create_from_quiz!(@quiz)
+    game.join("Alice")
+    game.end_quiz!
+
+    post draw_winners_moderate_game_path(game), headers: moderator_auth
+    get moderate_game_path(game), headers: moderator_auth
+    assert_select ".flash", text: "Nobody has points, so nobody wins."
+    assert_equal 0, game.reload.winners.count
+  end
+
+  test "each winner step needs the moderator's credentials" do
+    game = finished_game
+    post top_winners_moderate_game_path(game)
+    assert_response :unauthorized
+    post draw_winners_moderate_game_path(game)
+    assert_response :unauthorized
+    post reset_winners_moderate_game_path(game)
+    assert_response :unauthorized
+    assert_equal 0, game.winners.count
+  end
+
+  test "every winner step pokes the screen and the phones" do
+    game = finished_game
+    screen = Turbo::StreamsChannel.send(:stream_name_from, [ game, :screen ])
+    players = Turbo::StreamsChannel.send(:stream_name_from, [ game, :players ])
+
+    assert_broadcasts(screen, 1) do
+      assert_broadcasts(players, 1) do
+        post top_winners_moderate_game_path(game), headers: moderator_auth
+      end
+    end
+  end
+
+  test "a phone shows its place and points once the quiz is over, and You won! for a winner" do
+    game = finished_game(winner_count: 2)
+    post top_winners_moderate_game_path(game), headers: moderator_auth
+    alice, bob, dan = @phones.values_at("Alice", "Bob", "Dan")
+
+    alice.get play_path(game.code)
+    alice.assert_select "h1", text: "The quiz is over"
+    alice.assert_select ".result-card__label", text: "Place 1 of 4"
+    alice.assert_select ".result-card__score", text: "2 points"
+    alice.assert_select ".winner-banner", text: "You won!"
+
+    bob.get play_path(game.code)
+    bob.assert_select ".result-card__label", text: "Place 2 of 4"
+    bob.assert_select ".result-card__score", text: "1 point"
+    bob.assert_select ".winner-banner", text: "You won!"
+
+    dan.get play_path(game.code)
+    dan.assert_select ".result-card__label", text: "Place 4 of 4"
+    dan.assert_select ".result-card__score", text: "0 points"
+    dan.assert_select ".winner-banner", count: 0
+  end
+
+  test "a phone that is not a winner does not see You won!" do
+    game = finished_game(winner_count: 1)
+    post top_winners_moderate_game_path(game), headers: moderator_auth
+    cara = @phones["Cara"]
+
+    cara.get play_path(game.code)
+    cara.assert_select ".result-card__label", text: "Place 3 of 4"
+    cara.assert_select ".winner-banner", count: 0
+    assert_no_match(/You won!/, cara.response.body)
+  end
+
+  test "during the game no phone shows points or a place" do
+    game = Game.create_from_quiz!(@quiz)
+    alice = phone_for(game, "Alice")
+    game.start!
+    alice.get play_path(game.code)
+    assert_no_match(/points?\b/, alice.response.body)
+    alice.assert_select ".result-card__label", count: 0
+
+    game.finish_question!
+    alice.get play_path(game.code)
+    assert_no_match(/points?\b/, alice.response.body)
+  end
+
+  test "winner changes reach a phone and the screen through their live fragments" do
+    game = finished_game(winner_count: 2)
+    alice = @phones["Alice"]
+    alice.get play_live_path(game.code)
+    phone_etag = alice.response.headers["ETag"]
+    get live_moderate_game_path(game), headers: moderator_auth
+    screen_etag = response.headers["ETag"]
+
+    post top_winners_moderate_game_path(game), headers: moderator_auth
+
+    alice.get play_live_path(game.code), headers: { "If-None-Match" => phone_etag }
+    alice.assert_response :ok, "the phone sees the new winners"
+    alice.assert_select ".winner-banner", text: "You won!"
+
+    get live_moderate_game_path(game), headers: moderator_auth.merge("If-None-Match" => screen_etag)
+    assert_response :ok, "the screen sees the new winners"
+    assert_select "li.is-winner", count: 2
+  end
+end
