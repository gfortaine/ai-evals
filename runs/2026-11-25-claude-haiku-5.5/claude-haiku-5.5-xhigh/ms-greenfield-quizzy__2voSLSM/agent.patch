@@ -0,0 +1,133 @@
+require "application_system_test_case"
+
+class ModeratorFlowTest < ApplicationSystemTestCase
+  test "prepare a quiz from scratch and play it in the preview" do
+    visit moderate_root_path
+    click_on "New quiz"
+    fill_in "Title", with: "Frontend Fest 2026"
+    click_on "Save quiz"
+    assert_text "Frontend Fest 2026"
+
+    click_on "Add question"
+    fill_in "Question", with: "Which HTTP status code means \"Too Many Requests\"?"
+    fill_in "Option 1", with: "418"
+    fill_in "Option 2", with: "429"
+    check "Option 2 is correct"
+    fill_in "Option 3", with: "503"
+    click_on "Save question"
+    assert_text "Question saved."
+    assert_css "li.question-item", count: 1
+
+    click_on "Add question"
+    fill_in "Question", with: "Which protocol is two-way?"
+    fill_in "Option 1", with: "WebSocket"
+    check "Option 1 is correct"
+    fill_in "Option 2", with: "SMTP"
+    click_on "Save question"
+
+    within(:css, "li.question-item", text: "Which protocol") do
+      assert_text "WebSocket"
+      assert_text "(correct)"
+    end
+
+    click_on "Preview"
+    assert_text "Question 1 of 2"
+    click_on "429"
+    assert_text "Correct!"
+    click_on "Next question"
+    assert_text "Question 2 of 2"
+    click_on "SMTP"
+    assert_text "Wrong!"
+    click_on "See score"
+    assert_text "Score: 1/2"
+    click_on "Start over"
+    assert_text "Question 1 of 2"
+  end
+
+  test "Enter in an option field saves the question instead of adding an option" do
+    quiz = create_quiz("Talk")
+    visit new_moderate_quiz_question_path(quiz)
+    fill_in "Question", with: "Pick one"
+    fill_in "Option 1", with: "Yes"
+    check "Option 1 is correct"
+    fill_in "Option 2", with: "No"
+    find_field("Option 2").send_keys(:enter)
+
+    assert_text "Question saved."
+    assert_equal [ "Yes", "No" ], quiz.questions.first.options.map(&:text)
+  end
+
+  test "Add option keeps what was typed and adds the next row without saving" do
+    quiz = create_quiz("Talk")
+    visit new_moderate_quiz_question_path(quiz)
+    fill_in "Question", with: "Typed question"
+    fill_in "Option 1", with: "Typed option"
+    click_on "Add option"
+
+    assert_field "Option 5"
+    assert_field "Option 1", with: "Typed option"
+    assert_field "Question", with: "Typed question"
+    assert_equal 0, quiz.questions.count
+  end
+
+  test "failed rules keep the typed values and show the message" do
+    quiz = create_quiz("Talk")
+    visit new_moderate_quiz_question_path(quiz)
+    fill_in "Question", with: "Only one"
+    fill_in "Option 1", with: "Alone"
+    check "Option 1 is correct"
+    click_on "Save question"
+
+    assert_text "Add at least two options"
+    assert_field "Question", with: "Only one"
+    assert_field "Option 1", with: "Alone"
+    assert_equal 0, quiz.questions.count
+  end
+
+  test "Active switch saves at once" do
+    quiz = create_quiz("Talk", questions: [ [ "Toggle me", [ [ "A", true ], [ "B", false ] ] ] ])
+    visit moderate_quiz_path(quiz)
+    within(:css, "li.question-item") do
+      uncheck "Active"
+    end
+    assert_css "li.question-item--inactive", text: "Toggle me"
+    refute quiz.questions.first.reload.active?
+  end
+
+  test "Delete asks with the native confirm dialog and can be cancelled" do
+    quiz = create_quiz("Talk", questions: [ [ "Keep me", [ [ "A", true ], [ "B", false ] ] ] ])
+    visit moderate_quiz_path(quiz)
+
+    dismiss_confirm("Delete this question?") do
+      click_on "Delete"
+    end
+    assert_text "Keep me"
+    assert_equal 1, quiz.questions.count
+
+    accept_confirm("Delete this question?") do
+      click_on "Delete"
+    end
+    assert_text "Question deleted."
+    assert_equal 0, quiz.questions.count
+  end
+
+  test "Delete quiz asks for confirmation on the settings page" do
+    quiz = create_quiz("Doomed")
+    visit edit_moderate_quiz_path(quiz)
+    accept_confirm do
+      click_on "Delete quiz"
+    end
+    assert_text "Quiz deleted."
+    assert_equal 0, Quiz.count
+  end
+
+  test "move up and move down reorder the questions" do
+    quiz = create_quiz("Talk", questions: [
+      [ "First", [ [ "A", true ], [ "B", false ] ] ],
+      [ "Second", [ [ "A", true ], [ "B", false ] ] ]
+    ])
+    visit moderate_quiz_path(quiz)
+    within(:css, "li.question-item", text: "Second") { click_on "Move up" }
+    assert_selector "li.question-item:first-child", text: "Second"
+  end
+end
