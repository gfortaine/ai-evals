+++ b/test/models/quiz_preview_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class QuizPreviewTest < ActiveSupport::TestCase
+  setup do
+    @quiz = create_quiz(questions: [
+      [ "One", [ [ "A", true ], [ "B", false ] ] ],
+      [ "Two", [ [ "C", false ], [ "D", true ] ] ]
+    ])
+    @one, @two = @quiz.questions.to_a
+  end
+
+  test "score counts correct answers and ignores unknown ids" do
+    preview = QuizPreview.new(@quiz, answers: [ @one.options.find_by(text: "A").id.to_s, "999" ])
+    assert preview.finished?
+    assert_equal 1, preview.score
+  end
+
+  test "answers beyond the number of questions are ignored" do
+    preview = QuizPreview.new(@quiz, answers: %w[1 2 3 4 5])
+    assert_equal 2, preview.answers.size
+  end
+
+  test "pick for a different question is ignored" do
+    other = @two.options.find_by(text: "D").id.to_s
+    preview = QuizPreview.new(@quiz, pick: other)
+    refute preview.answered?
+  end
+
+  test "empty quiz" do
+    preview = QuizPreview.new(create_quiz("Nothing"))
+    assert preview.empty?
+    refute preview.finished?
+    assert_nil preview.current_question
+  end
+end
