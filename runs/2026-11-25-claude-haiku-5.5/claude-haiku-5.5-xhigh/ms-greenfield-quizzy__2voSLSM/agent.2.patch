+require "test_helper"
+
+class QuizImportTest < ActionDispatch::IntegrationTest
+  def question(text, options, active: nil)
+    data = { "text" => text, "options" => options.map { |option_text, correct| { "text" => option_text, "correct" => correct } } }
+    data["active"] = active unless active.nil?
+    data
+  end
+
+  def document(title: "Frontend Fest 2026", questions: [ question("Which HTTP status code means \"Too Many Requests\"?", [ [ "418", false ], [ "429", true ] ]) ])
+    { "title" => title, "questions" => questions }
+  end
+
+  def import_text(text)
+    post moderate_imports_path, params: { quiz_json: text }, headers: moderator_auth
+  end
+
+  def import_data(data)
+    import_text(data.is_a?(String) ? data : data.to_json)
+  end
+
+  def assert_nothing_imported
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+    assert_equal 0, Option.count
+  end
+
+  test "the moderate page has an Import quiz button that opens the import page" do
+    get moderate_root_url, headers: moderator_auth
+    assert_response :ok
+    assert_select "form[action='#{new_moderate_import_path}'] button", text: "Import quiz"
+  end
+
+  test "the import page has a Quiz JSON text area and an Import button" do
+    get new_moderate_import_path, headers: moderator_auth
+    assert_response :ok
+    assert_select "label[for='quiz_json']", text: "Quiz JSON"
+    assert_select "textarea#quiz_json[name='quiz_json']"
+    assert_select "button", text: "Import"
+  end
+
+  test "importing creates a new quiz with its questions and options in order and opens its page" do
+    data = document(questions: [
+      question("First", [ [ "A", true ], [ "B", false ] ], active: true),
+      question("Second", [ [ "C", false ], [ "D", true ] ], active: false)
+    ])
+    assert_difference({ "Quiz.count" => 1, "Question.count" => 2, "Option.count" => 4 }) do
+      import_data(data)
+    end
+    quiz = Quiz.order(:id).last
+    assert_redirected_to moderate_quiz_path(quiz)
+    assert_equal "Frontend Fest 2026", quiz.title
+    assert_equal [ "First", "Second" ], quiz.questions.map(&:text)
+    assert_equal [ true, false ], quiz.questions.map(&:active?)
+    assert_equal [ [ "A", "B" ], [ "C", "D" ] ], quiz.questions.map { |q| q.options.map(&:text) }
+    assert_equal [ [ true, false ], [ false, true ] ], quiz.questions.map { |q| q.options.map(&:correct?) }
+  end
+
+  test "active defaults to true and correct defaults to false" do
+    data = { "title" => "Defaults", "questions" => [
+      { "text" => "Q", "options" => [ { "text" => "A" }, { "text" => "B", "correct" => true } ] }
+    ] }
+    import_data(data)
+    question = Quiz.find_by!(title: "Defaults").questions.first
+    assert question.active?
+    assert_equal [ false, true ], question.options.map(&:correct?)
+  end
+
+  test "importing a title that already exists still creates a new quiz" do
+    create_quiz("Frontend Fest 2026")
+    assert_difference "Quiz.count", 1 do
+      import_data(document)
+    end
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+  end
+
+  test "a quiz without questions can be imported" do
+    assert_difference "Quiz.count", 1 do
+      import_data(document(questions: []))
+    end
+    assert_empty Quiz.order(:id).last.questions
+  end
+
+  test "blank option rows are skipped, as in the question form" do
+    data = document(questions: [ question("Q", [ [ "", true ], [ "A", true ], [ "  ", false ], [ "B", false ] ]) ])
+    import_data(data)
+    assert_equal [ "A", "B" ], Quiz.order(:id).last.questions.first.options.map(&:text)
+  end
+
+  test "the moderator credentials are required" do
+    assert_no_difference "Quiz.count" do
+      post moderate_imports_path, params: { quiz_json: document.to_json }
+    end
+    assert_response :unauthorized
+  end
+
+  test "invalid JSON shows an error, keeps the text, and imports nothing" do
+    text = "{\"title\": \"Broken\", \"questions\": [}"
+    import_text(text)
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Quiz JSON is not valid JSON"
+    assert_select "textarea#quiz_json", text: text
+    assert_nothing_imported
+  end
+
+  test "empty input shows an error and imports nothing" do
+    import_text("   ")
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Paste the quiz JSON to import"
+    assert_nothing_imported
+  end
+
+  test "JSON that is not an object is rejected" do
+    import_data("[1, 2, 3]")
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: /must be an object/
+    assert_nothing_imported
+  end
+
+  test "questions must be a list" do
+    import_data({ "title" => "T", "questions" => "nope" })
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: /needs a list of questions/
+    assert_nothing_imported
+  end
+
+  test "a missing title is rejected" do
+    import_data(document(title: "  "))
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Title can't be blank"
+    assert_nothing_imported
+  end
+
+  test "a title that is not text is rejected" do
+    import_data(document(title: 42))
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: /Title must be a string/
+    assert_nothing_imported
+  end
+
+  test "one question that breaks a rule imports nothing, not even the valid questions" do
+    data = document(questions: [
+      question("Fine", [ [ "A", true ], [ "B", false ] ]),
+      question("Too few", [ [ "Only", true ] ])
+    ])
+    import_data(data)
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Question 2: Add at least two options"
+    assert_nothing_imported
+  end
+
+  test "the question rules of the question form apply to imported questions" do
+    cases = {
+      "Question 1: Mark at least one option as correct" => document(questions: [ question("Q", [ [ "A", false ], [ "B", false ] ]) ]),
+      "Question 1: Question can't be blank" => document(questions: [ question("   ", [ [ "A", true ], [ "B", false ] ]) ]),
+      "Question 1: Options can be at most 200 characters long" => document(questions: [ question("Q", [ [ "x" * 201, true ], [ "B", false ] ]) ]),
+      "Question 1: Question is too long (maximum is 500 characters)" => document(questions: [ question("q" * 501, [ [ "A", true ], [ "B", false ] ]) ])
+    }
+    cases.each do |message, data|
+      import_data(data)
+      assert_response :unprocessable_entity, message
+      assert_select ".errors li", text: message
+    end
+    assert_nothing_imported
+  end
+
+  test "a correct box on a blank option does not count" do
+    data = document(questions: [ question("Q", [ [ "A", false ], [ "B", false ], [ "", true ] ]) ])
+    import_data(data)
+    assert_select ".errors li", text: "Question 1: Mark at least one option as correct"
+    assert_nothing_imported
+  end
+
+  test "active and correct must be true or false" do
+    bad_active = document(questions: [ { "text" => "Q", "active" => "yes", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] } ])
+    import_data(bad_active)
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: /Question 1: active must be true or false/
+
+    bad_correct = document(questions: [ { "text" => "Q", "options" => [ { "text" => "A", "correct" => 1 }, { "text" => "B" } ] } ])
+    import_data(bad_correct)
+    assert_select ".errors li", text: /option 1 correct must be true or false/
+    assert_nothing_imported
+  end
+
+  test "a format error is reported alone, without the rule errors it would cause" do
+    data = document(questions: [ { "text" => "Q", "options" => [ { "text" => "A", "correct" => "yes" }, { "text" => "B" } ] } ])
+    import_data(data)
+    assert_response :unprocessable_entity
+    assert_select ".errors li", count: 1
+    assert_select ".errors li", text: /option 1 correct must be true or false/
+    assert_nothing_imported
+  end
+
+  test "option text must be a string" do
+    data = document(questions: [ { "text" => "Q", "options" => [ { "text" => 418, "correct" => true }, { "text" => "B" } ] } ])
+    import_data(data)
+    assert_select ".errors li", text: /option 1 text must be a string/
+    assert_nothing_imported
+  end
+
+  test "the round trip of an export imports the same quiz again" do
+    source = create_quiz("Source", questions: [
+      [ "One", [ [ "A", true ], [ "B", false ] ] ],
+      [ "Two", [ [ "C", false ], [ "D", true ] ], false ]
+    ])
+    get export_moderate_quiz_path(source), headers: moderator_auth
+    exported = JSON.parse(css_select("pre").text)
+
+    import_data(exported)
+    copy = Quiz.order(:id).last
+    assert_redirected_to moderate_quiz_path(copy)
+    assert_not_equal source.id, copy.id
+
+    get export_moderate_quiz_path(copy), headers: moderator_auth
+    assert_equal exported, JSON.parse(css_select("pre").text)
+  end
+
+  test "a UTF-8 byte order mark at the start of the file is accepted" do
+    import_text("\uFEFF" + document.to_json)
+    assert_redirected_to moderate_quiz_path(Quiz.order(:id).last)
+  end
+end
diff --git a/test/models/quiz_import_test.rb b/test/models/quiz_import_test.rb
new file mode 100644
index 0000000..44886c3
--- /dev/null
+++ b/test/models/quiz_import_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class QuizImportServiceTest < ActiveSupport::TestCase
+  def valid_json
+    {
+      "title" => "Talk",
+      "questions" => [
+        { "text" => "One", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+        { "text" => "Two", "active" => false, "options" => [ { "text" => "C" }, { "text" => "D", "correct" => true } ] }
+      ]
+    }.to_json
+  end
+
+  def counts
+    [ Quiz.count, Question.count, Option.count ]
+  end
+
+  test "a valid document creates the quiz, its questions and options, in order" do
+    import = QuizImport.new(valid_json)
+    before = counts
+    assert import.save
+    assert_equal [ before[0] + 1, before[1] + 2, before[2] + 4 ], counts
+    quiz = import.quiz
+    assert quiz.persisted?
+    assert_equal [ "One", "Two" ], quiz.questions.map(&:text)
+    assert_equal [ 1, 2 ], quiz.questions.map(&:position)
+    assert_equal [ true, false ], quiz.questions.map(&:active?)
+    assert_equal [ [ "A", "B" ], [ "C", "D" ] ], quiz.questions.map { |q| q.options.map(&:text) }
+  end
+
+  test "several broken questions are all reported and nothing is saved" do
+    json = {
+      "title" => "Talk",
+      "questions" => [
+        { "text" => "", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+        { "text" => "Two", "options" => [ { "text" => "C" } ] }
+      ]
+    }.to_json
+    import = QuizImport.new(json)
+    before = counts
+    refute import.save
+    assert_equal before, counts
+    assert_equal [
+      "Question 1: Question can't be blank",
+      "Question 2: Add at least two options",
+      "Question 2: Mark at least one option as correct"
+    ], import.errors.full_messages
+  end
+
+  test "saving twice imports once" do
+    import = QuizImport.new(valid_json)
+    before = counts
+    assert import.save
+    assert import.save
+    assert_equal before.zip([ 1, 2, 4 ]).map(&:sum), counts
+  end
+
+  test "checking twice does not build the questions twice" do
+    import = QuizImport.new(valid_json)
+    assert import.valid?
+    assert import.valid?
+    assert import.save
+    assert_equal 2, import.quiz.questions.count
+  end
+
+  test "text that is not valid UTF-8 is reported, not raised" do
+    import = QuizImport.new("{\"title\": \"\xff\"}".dup.force_encoding("UTF-8"))
+    refute import.save
+    assert_equal [ "Quiz JSON is not valid JSON" ], import.errors.full_messages
+  end
+
+  test "an empty title, with questions that are fine, is reported and imports nothing" do
+    json = { "title" => "", "questions" => [ { "text" => "Q", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] } ] }.to_json
+    import = QuizImport.new(json)
+    before = counts
+    refute import.save
+    assert_equal [ "Title can't be blank" ], import.errors.full_messages
+    assert_equal before, counts
+  end
+
+  test "surrounding whitespace is trimmed from the title, the question and the options" do
+    json = { "title" => "  Padded  ", "questions" => [ { "text" => " Q ", "options" => [ { "text" => " A ", "correct" => true }, { "text" => "B" } ] } ] }.to_json
+    import = QuizImport.new(json)
+    assert import.save
+    assert_equal "Padded", import.quiz.title
+    assert_equal "Q", import.quiz.questions.first.text
+    assert_equal [ "A", "B" ], import.quiz.questions.first.options.map(&:text)
+  end
+end
