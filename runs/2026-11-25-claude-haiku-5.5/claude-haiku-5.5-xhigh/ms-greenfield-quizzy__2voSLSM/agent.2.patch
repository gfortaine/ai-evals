@@ -0,0 +1,71 @@
+require "test_helper"
+
+class QuizExportTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = create_quiz("Frontend Fest 2026", questions: [
+      [ "Which HTTP status code means \"Too Many Requests\"?", [ [ "418", false ], [ "429", true ] ] ],
+      [ "Inactive question", [ [ "Yes", true ], [ "No", false ] ], false ],
+      [ "Which protocol is two-way?", [ [ "WebSocket", true ], [ "SMTP", false ] ] ]
+    ])
+  end
+
+  def exported
+    JSON.parse(css_select("pre").text)
+  end
+
+  test "the quiz page has an Export link to the export page" do
+    get moderate_quiz_path(@quiz), headers: moderator_auth
+    assert_response :ok
+    assert_select "a[href='#{export_moderate_quiz_path(@quiz)}']", text: "Export"
+  end
+
+  test "the export page needs moderator credentials" do
+    get export_moderate_quiz_path(@quiz)
+    assert_response :unauthorized
+  end
+
+  test "the export page shows the quiz JSON in the only pre element" do
+    get export_moderate_quiz_path(@quiz), headers: moderator_auth
+    assert_response :ok
+    assert_select "pre", count: 1
+  end
+
+  test "export writes the title and the questions in order, with active and correct always written" do
+    get export_moderate_quiz_path(@quiz), headers: moderator_auth
+    assert_equal({
+      "title" => "Frontend Fest 2026",
+      "questions" => [
+        { "text" => "Which HTTP status code means \"Too Many Requests\"?", "active" => true,
+          "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ] },
+        { "text" => "Inactive question", "active" => false,
+          "options" => [ { "text" => "Yes", "correct" => true }, { "text" => "No", "correct" => false } ] },
+        { "text" => "Which protocol is two-way?", "active" => true,
+          "options" => [ { "text" => "WebSocket", "correct" => true }, { "text" => "SMTP", "correct" => false } ] }
+      ]
+    }, exported)
+  end
+
+  test "export writes exactly the keys of the format and nothing about the database" do
+    get export_moderate_quiz_path(@quiz), headers: moderator_auth
+    data = exported
+    assert_equal %w[questions title], data.keys.sort
+    data["questions"].each do |question|
+      assert_equal %w[active options text], question.keys.sort
+      question["options"].each { |option| assert_equal %w[correct text], option.keys.sort }
+    end
+  end
+
+  test "an empty quiz exports an empty question list" do
+    empty = create_quiz("Nothing yet")
+    get export_moderate_quiz_path(empty), headers: moderator_auth
+    assert_equal({ "title" => "Nothing yet", "questions" => [] }, exported)
+  end
+
+  test "quote and angle characters are escaped in the page but the JSON is still exact" do
+    quiz = create_quiz("<b>Bold</b> & \"quoted\"", questions: [ [ "<i>x</i>", [ [ "a < b", true ], [ "c", false ] ] ] ])
+    get export_moderate_quiz_path(quiz), headers: moderator_auth
+    assert_equal "<b>Bold</b> & \"quoted\"", exported["title"]
+    assert_equal "<i>x</i>", exported["questions"].first["text"]
+    assert_equal "a < b", exported["questions"].first["options"].first["text"]
+  end
+end
