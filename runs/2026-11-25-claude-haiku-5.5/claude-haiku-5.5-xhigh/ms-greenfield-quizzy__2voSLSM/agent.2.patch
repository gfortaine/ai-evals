diff --git a/test/system/quiz_transfer_test.rb b/test/system/quiz_transfer_test.rb
new file mode 100644
index 0000000..6dc00fc
--- /dev/null
+++ b/test/system/quiz_transfer_test.rb
@@ -0,0 +1,33 @@
+require "application_system_test_case"
+
+class QuizTransferTest < ApplicationSystemTestCase
+  test "export a quiz, then import the JSON as a new quiz" do
+    quiz = create_quiz("Frontend Fest 2026", questions: [
+      [ "Which HTTP status code means \"Too Many Requests\"?", [ [ "418", false ], [ "429", true ] ] ]
+    ])
+
+    visit moderate_quiz_path(quiz)
+    click_on "Export"
+    json = find("pre").text
+    assert_equal "Frontend Fest 2026", JSON.parse(json)["title"]
+
+    visit moderate_root_path
+    click_on "Import quiz"
+    fill_in "Quiz JSON", with: json
+    click_on "Import"
+
+    assert_text "Quiz imported."
+    assert_css "h1", text: "Frontend Fest 2026"
+    assert_text "Which HTTP status code means"
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+  end
+
+  test "a broken import shows the error and creates nothing" do
+    visit new_moderate_import_path
+    fill_in "Quiz JSON", with: "{ not json"
+    click_on "Import"
+
+    assert_text "Quiz JSON is not valid JSON"
+    assert_equal 0, Quiz.count
+  end
+end
