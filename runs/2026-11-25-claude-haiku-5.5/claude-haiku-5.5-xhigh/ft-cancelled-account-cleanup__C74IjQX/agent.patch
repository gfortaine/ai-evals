diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..5f66ca1 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,32 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  class_methods do
+    def incinerate_due
+      cancelled_before(INCINERATION_GRACE_PERIOD.ago).find_each do |account|
+        account.incinerate
+      rescue StandardError => error
+        Rails.error.report(error, context: { account_id: account.id })
+      end
+    end
+
+    private
+      def cancelled_before(time)
+        joins(:cancellation).where(account_cancellations: { created_at: ...time })
+      end
+  end
+
+  def incinerate
+    with_lock do
+      destroy! if due_for_incineration?
+    end
+  end
+
+  private
+    # Re-checked under lock so an account reactivated after it was selected is left alone.
+    def due_for_incineration?
+      cancelled? && cancellation.created_at <= INCINERATION_GRACE_PERIOD.ago
+    end
 end
