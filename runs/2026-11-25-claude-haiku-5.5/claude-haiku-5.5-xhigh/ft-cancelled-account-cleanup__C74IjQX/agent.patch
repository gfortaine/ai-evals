diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..54b9577
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "destroys accounts cancelled more than 30 days ago" do
+    account = accounts("37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account.id)
+  end
+
+  test "leaves accounts cancelled within the grace period alone" do
+    account = accounts("37s")
+    account.cancel(initiated_by: users(:david))
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(account.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..82b9391
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @other_account = accounts(:initech)
+    @user = users(:david)
+  end
+
+  test "incinerate_due destroys accounts cancelled more than 30 days ago" do
+    cancel_at(@account, 31.days.ago)
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(@account.id)
+  end
+
+  test "incinerate_due keeps accounts cancelled within the grace period" do
+    cancel_at(@account, 29.days.ago)
+
+    Account.incinerate_due
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate_due keeps active accounts" do
+    Account.incinerate_due
+
+    assert Account.exists?(@account.id)
+    assert Account.exists?(@other_account.id)
+  end
+
+  test "incinerate_due keeps accounts that were reactivated" do
+    cancel_at(@account, 31.days.ago)
+    @account.reactivate
+
+    Account.incinerate_due
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate skips accounts reactivated after they were loaded" do
+    cancel_at(@account, 31.days.ago)
+    loaded = Account.find(@account.id)
+    @account.reactivate
+
+    loaded.incinerate
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate_due only incinerates due accounts" do
+    cancel_at(@account, 31.days.ago)
+    cancel_at(@other_account, 1.day.ago)
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(@other_account.id)
+  end
+
+  test "incinerate_due reports failures and still attempts the remaining accounts" do
+    cancel_at(@account, 31.days.ago)
+    cancel_at(@other_account, 31.days.ago)
+    Account.any_instance.stubs(:incinerate).raises(ActiveRecord::RecordNotDestroyed)
+
+    Rails.error.expects(:report).twice
+
+    assert_nothing_raised do
+      Account.incinerate_due
+    end
+  end
+
+  test "incinerate removes all data belonging to the account" do
+    cancel_at(@account, 31.days.ago)
+    populate_account_data(@account)
+    cards_on_other_account = @other_account.cards.count
+    assert_includes account_rows_by_table(@account), "storage_entries"
+    assert_includes account_rows_by_table(@account), "search_records"
+    assert_includes account_rows_by_table(@account), "active_storage_blobs"
+
+    perform_enqueued_jobs { Account.incinerate_due }
+
+    assert_not Account.exists?(@account.id)
+    assert_empty account_rows_by_table(@account)
+    assert_equal cards_on_other_account, @other_account.cards.count
+  end
+
+  test "incinerate does nothing for accounts that are not due" do
+    cancel_at(@account, 1.day.ago)
+
+    @account.incinerate
+
+    assert Account.exists?(@account.id)
+  end
+
+  private
+    def cancel_at(account, time)
+      account.cancel(initiated_by: @user)
+      account.cancellation.update!(created_at: time)
+    end
+
+    def populate_account_data(account)
+      Current.user = @user
+      board = boards(:writebook)
+
+      card = board.cards.create!(creator: @user, title: "Doomed card", description: "searchable text", status: :published)
+      card.image.attach io: StringIO.new("x" * 1024), filename: "doomed.png", content_type: "image/png"
+      card.comments.create!(creator: @user, body: "doomed comment")
+      card.toggle_tag_with("doomed-tag")
+      card.watch_by(@user)
+
+      account.materialize_storage
+      board.materialize_storage
+      Search::Query.create!(user: @user, terms: "doomed")
+      Account::Import.create!(account: account, identity: @user.identity, status: :completed, completed_at: Time.current)
+    end
+
+    def account_rows_by_table(account)
+      connection = ActiveRecord::Base.connection
+
+      connection.tables.select { |table| connection.column_exists?(table, :account_id) }.index_with do |table|
+        Class.new(ApplicationRecord) { self.table_name = table }.where(account_id: account.id).count
+      end.reject { |_, count| count.zero? }
+    end
+end
