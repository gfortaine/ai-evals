+module Push
+  def self.table_name_prefix
+    "push_"
+  end
+
+  class << self
+    def enabled?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].presence
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"].presence
+    end
+
+    def vapid_options
+      {
+        subject: "mailto:#{Mail::Address.new(ENV.fetch("MAILER_FROM_ADDRESS", "support@fizzy.do")).address}",
+        public_key: vapid_public_key,
+        private_key: vapid_private_key
+      }
+    end
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..fb0c93f
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,68 @@
+class Push::Subscription < ApplicationRecord
+  ENDPOINT_TIMEOUT = 7.seconds
+  MESSAGE_TTL = 1.day # A notification that's older than this isn't worth showing late
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, uniqueness: { scope: :user_id }
+  validates :p256dh_key, :auth_key, presence: true, format: { with: /\A[A-Za-z0-9_-]+\z/, allow_blank: true }
+  validate :endpoint_must_be_https
+
+  # A device that's unreachable, or whose keys can't be used, must not stop delivery to the user's other devices
+  def deliver(message)
+    ip_address = SsrfProtection.resolve_public_ip(uri.host)
+
+    if ip_address
+      handle_response(post_message(message, ip_address))
+    else
+      Rails.logger.warn "Push endpoint #{uri.host} does not resolve to a public address, skipping"
+    end
+  rescue Timeout::Error, Resolv::ResolvError, SocketError, SystemCallError, OpenSSL::OpenSSLError, ArgumentError => error
+    Rails.logger.warn "Push delivery to #{uri.host} failed: #{error.class}"
+  end
+
+  private
+    def endpoint_must_be_https
+      errors.add :endpoint, "must be an HTTPS URL" if endpoint.present? && !https_endpoint?
+    end
+
+    def https_endpoint?
+      uri.is_a?(URI::HTTPS) && uri.host.present?
+    rescue URI::InvalidURIError
+      false
+    end
+
+    def uri
+      URI.parse(endpoint)
+    end
+
+    def post_message(message, ip_address)
+      request = WebPush::Request.new(
+        message: message.to_json,
+        subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } },
+        vapid: Push.vapid_options,
+        ttl: MESSAGE_TTL.to_i
+      )
+
+      # Connect to the address we just checked rather than resolving the host again, so the
+      # endpoint can't be pointed at an internal address between the check and the request.
+      http = Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = ip_address
+        http.use_ssl = true
+        http.open_timeout = ENDPOINT_TIMEOUT
+        http.read_timeout = ENDPOINT_TIMEOUT
+      end
+
+      http.request(Net::HTTP::Post.new(uri.request_uri, request.headers).tap { |post| post.body = request.body })
+    end
+
+    def handle_response(response)
+      if response.is_a?(Net::HTTPGone) || response.is_a?(Net::HTTPNotFound)
+        # The browser unsubscribed, or the push service expired the subscription
+        destroy!
+      elsif !response.is_a?(Net::HTTPSuccess)
+        Rails.logger.warn "Push delivery to #{uri.host} failed with HTTP #{response.code}"
+      end
+    end
+end
