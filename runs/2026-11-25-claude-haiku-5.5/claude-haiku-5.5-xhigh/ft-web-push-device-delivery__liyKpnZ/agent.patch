diff --git a/test/models/notification/push_test.rb b/test/models/notification/push_test.rb
new file mode 100644
index 0000000..c936fdb
--- /dev/null
+++ b/test/models/notification/push_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+
+class Notification::PushTest < ActiveSupport::TestCase
+  PUBLIC_TEST_IP = "93.184.216.34" # example.com's real IP, used as a public IP stand-in
+  VAPID_KEY = WebPush.generate_key
+  P256DH_KEY = "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM"
+  AUTH_KEY = "tBHItJI5svbpez7KI4CCXg"
+
+  setup do
+    stub_dns_resolution(PUBLIC_TEST_IP)
+    Push.stubs(:vapid_public_key).returns(VAPID_KEY.public_key)
+    Push.stubs(:vapid_private_key).returns(VAPID_KEY.private_key)
+
+    @kevin = users(:kevin)
+    notifications(:layout_commented_kevin).destroy
+  end
+
+  test "a new notification enqueues a push for a user with a device to push to" do
+    create_subscription
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      create_notification
+    end
+  end
+
+  test "no push is enqueued for a user without a device to push to" do
+    assert_no_enqueued_jobs(only: Notification::PushJob) do
+      create_notification
+    end
+  end
+
+  test "no push is enqueued when push is not configured" do
+    create_subscription
+    Push.stubs(:enabled?).returns(false)
+
+    assert_no_enqueued_jobs(only: Notification::PushJob) do
+      create_notification
+    end
+  end
+
+  test "a new event landing on an existing notification enqueues a push" do
+    create_subscription
+    notification = create_notification
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      notification.update!(source: events(:layout_published), creator: users(:david), read_at: nil)
+    end
+  end
+
+  test "marking a notification read or unread does not enqueue a push" do
+    create_subscription
+    notification = create_notification
+
+    assert_no_enqueued_jobs(only: Notification::PushJob) do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "push delivers the tray's title and body, linking to the card, to each of the user's devices" do
+    create_subscription
+    create_subscription(endpoint: "https://updates.push.services.mozilla.com/wpush/v2/desktop")
+    notification = create_notification
+
+    Push::Subscription.any_instance.expects(:deliver).twice.with do |message|
+      message[:title] == "RE: Layout is broken" && message[:body].present? &&
+        message[:url].start_with?(card_url_for(notification.card)) &&
+        message[:tag] == "notification-#{notification.id}"
+    end
+
+    notification.push
+  end
+
+  test "a mention pushes the mention's text" do
+    notification = notifications(:logo_mentioned_david)
+    create_subscription(user: users(:david))
+
+    Push::Subscription.any_instance.expects(:deliver).with do |message|
+      message[:title] == "#{users(:jz).first_name} @mentioned you" && message[:body].present? &&
+        message[:url].start_with?("http://example.com/")
+    end
+
+    notification.push
+  end
+
+  test "push does nothing for notifications that have already been read" do
+    create_subscription
+    notification = create_notification
+    notification.read
+
+    Push::Subscription.any_instance.expects(:deliver).never
+
+    notification.push
+  end
+
+  test "push does nothing for users who have been deactivated" do
+    create_subscription
+    notification = create_notification
+    @kevin.update!(active: false)
+
+    Push::Subscription.any_instance.expects(:deliver).never
+
+    notification.push
+  end
+
+  test "pushing to a device that has since expired removes it" do
+    subscription = create_subscription
+    notification = create_notification
+    stub_request(:post, subscription.endpoint).to_return(status: 410)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      notification.push
+    end
+  end
+
+  private
+    def create_notification
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+
+    def create_subscription(endpoint: "https://fcm.googleapis.com/fcm/send/phone", user: @kevin)
+      user.push_subscriptions.create!(endpoint: endpoint, p256dh_key: P256DH_KEY, auth_key: AUTH_KEY)
+    end
+
+    def card_url_for(card)
+      Rails.application.routes.url_helpers.card_url(card, host: "example.com", script_name: card.account.slug)
+    end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..6b90263
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  PUBLIC_TEST_IP = "93.184.216.34" # example.com's real IP, used as a public IP stand-in
+  VAPID_KEY = WebPush.generate_key
+  MESSAGE = { title: "Hi", body: "There", url: "https://example.com/cards/1", tag: "notification-1" }
+
+  setup do
+    stub_dns_resolution(PUBLIC_TEST_IP)
+    Push.stubs(:vapid_public_key).returns(VAPID_KEY.public_key)
+    Push.stubs(:vapid_private_key).returns(VAPID_KEY.private_key)
+
+    @user = users(:david)
+    @subscription = create_subscription
+  end
+
+  test "belongs to the user's account" do
+    assert_equal @user.account, @subscription.account
+  end
+
+  test "requires an https endpoint" do
+    subscription = @user.push_subscriptions.new(endpoint: "http://push.example.com/abc", p256dh_key: "key", auth_key: "auth")
+
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "must be an HTTPS URL"
+  end
+
+  test "requires an endpoint and keys" do
+    subscription = @user.push_subscriptions.new
+
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "can't be blank"
+    assert_includes subscription.errors[:p256dh_key], "can't be blank"
+    assert_includes subscription.errors[:auth_key], "can't be blank"
+  end
+
+  test "an endpoint is only subscribed once per user" do
+    duplicate = @user.push_subscriptions.new(endpoint: @subscription.endpoint, p256dh_key: "key", auth_key: "auth")
+
+    assert_not duplicate.valid?
+  end
+
+  test "the same endpoint can be registered by another user on the same browser" do
+    other = users(:kevin).push_subscriptions.new(endpoint: @subscription.endpoint, p256dh_key: "key", auth_key: "auth")
+
+    assert other.valid?
+  end
+
+  test "deliver posts the encrypted message to the endpoint, pinned to the public address" do
+    request = stub_request(:post, @subscription.endpoint)
+      .with(ipaddr: PUBLIC_TEST_IP, headers: { "Content-Encoding" => "aes128gcm", "Ttl" => "86400", "Authorization" => /\Avapid t=.+,k=#{Regexp.escape(VAPID_KEY.public_key_for_push_header)}\z/ })
+      .to_return(status: 201)
+
+    @subscription.deliver(MESSAGE)
+
+    assert_requested request
+  end
+
+  test "deliver does nothing when the endpoint resolves to a private address" do
+    stub_dns_resolution("10.0.0.5")
+    request = stub_request(:post, @subscription.endpoint)
+
+    @subscription.deliver(MESSAGE)
+
+    assert_not_requested request
+    assert Push::Subscription.exists?(@subscription.id)
+  end
+
+  test "deliver ignores a subscription whose keys can't be used, so other devices still get the message" do
+    subscription = @user.push_subscriptions.create!(endpoint: "https://fcm.googleapis.com/fcm/send/other", p256dh_key: "abc", auth_key: "abc")
+    request = stub_request(:post, subscription.endpoint)
+
+    assert_nothing_raised do
+      subscription.deliver(MESSAGE)
+    end
+
+    assert_not_requested request
+  end
+
+  test "deliver removes a subscription the push service reports as gone" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 410)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver(MESSAGE)
+    end
+  end
+
+  test "deliver removes a subscription the push service no longer recognises" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 404)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver(MESSAGE)
+    end
+  end
+
+  test "deliver keeps the subscription when the push service fails" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 500)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      @subscription.deliver(MESSAGE)
+    end
+  end
+
+  test "deliver survives network failures" do
+    stub_request(:post, @subscription.endpoint).to_timeout
+
+    assert_nothing_raised do
+      @subscription.deliver(MESSAGE)
+    end
+
+    assert Push::Subscription.exists?(@subscription.id)
+  end
+
+  private
+    def create_subscription
+      @user.push_subscriptions.create!(
+        endpoint: "https://fcm.googleapis.com/fcm/send/abc123",
+        p256dh_key: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+        auth_key: "tBHItJI5svbpez7KI4CCXg"
+      )
+    end
+end
diff --git a/test/models/push_test.rb b/test/models/push_test.rb
new file mode 100644
index 0000000..3379cbc
--- /dev/null
+++ b/test/models/push_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class PushTest < ActiveSupport::TestCase
+  test "enabled only when both VAPID keys are configured" do
+    Push.stubs(:vapid_public_key).returns("public-key")
+    Push.stubs(:vapid_private_key).returns(nil)
+    assert_not Push.enabled?
+
+    Push.stubs(:vapid_private_key).returns("private-key")
+    assert Push.enabled?
+  end
+
+  test "the VAPID subject is the mailer's address" do
+    switch_env "MAILER_FROM_ADDRESS", "Fizzy <hello@example.org>" do
+      assert_equal "mailto:hello@example.org", Push.vapid_options[:subject]
+    end
+  end
+
+  private
+    def switch_env(key, value)
+      old, ENV[key] = ENV[key], value
+      yield
+    ensure
+      ENV[key] = old
+    end
+end
diff --git a/test/system/notifications_push_test.rb b/test/system/notifications_push_test.rb
new file mode 100644
index 0000000..ca63cca
--- /dev/null
+++ b/test/system/notifications_push_test.rb
@@ -0,0 +1,110 @@
+require "application_system_test_case"
+
+class NotificationsPushTest < ApplicationSystemTestCase
+  # Stands in for the PushSubscription the browser's push service would issue
+  DEVICE_SUBSCRIPTION = <<~JS
+    ({
+      endpoint: "https://fcm.googleapis.com/fcm/send/device-1",
+      toJSON() {
+        return {
+          endpoint: this.endpoint,
+          keys: {
+            p256dh: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+            auth: "tBHItJI5svbpez7KI4CCXg"
+          }
+        }
+      }
+    })
+  JS
+
+  setup do
+    Push.stubs(:enabled?).returns(true)
+    Push.stubs(:vapid_public_key).returns(WebPush.generate_key.public_key)
+    Push.stubs(:vapid_private_key).returns(WebPush.generate_key.private_key)
+
+    # The browser is shared between tests, so put back the notification permission an earlier test may have answered
+    set_notification_permission "prompt"
+
+    sign_in_as(users(:david))
+  end
+
+  teardown do
+    @init_script_ids&.each do |identifier|
+      page.driver.browser.execute_cdp("Page.removeScriptToEvaluateOnNewDocument", identifier: identifier)
+    end
+  end
+
+  test "where the browser blocks notifications, the page explains how to unblock them" do
+    set_notification_permission "denied"
+
+    visit notifications_settings_path
+
+    assert_selector "[data-notifications-target='details']", text: "Turn on notifications for this website"
+    assert_no_button "Turn on notifications"
+    assert_no_text "Notifications are on for this device."
+  end
+
+  test "turning notifications on registers this device for the signed-in user" do
+    visit notifications_settings_path
+    grant_permission_with_device_subscription
+
+    click_on "Turn on notifications"
+
+    assert_text "Notifications are on for this device."
+    assert_no_button "Turn on notifications"
+
+    subscription = users(:david).push_subscriptions.find_by!(endpoint: "https://fcm.googleapis.com/fcm/send/device-1")
+    assert_equal "tBHItJI5svbpez7KI4CCXg", subscription.auth_key
+    assert_equal accounts("37s"), subscription.account
+  end
+
+  test "a device that already has a subscription is registered for whoever is signed in" do
+    add_init_script <<~JS
+      Object.defineProperty(Notification, "permission", { get: () => "granted" })
+      PushManager.prototype.getSubscription = async () => (#{DEVICE_SUBSCRIPTION})
+    JS
+
+    assert_difference -> { users(:david).push_subscriptions.count }, 1 do
+      visit notifications_settings_path
+      assert_text "Notifications are on for this device."
+    end
+  end
+
+  test "this device still shows as on after Turbo refreshes the settings page" do
+    visit notifications_settings_path
+    grant_permission_with_device_subscription
+    click_on "Turn on notifications"
+    assert_text "Notifications are on for this device."
+
+    page.execute_script("window.morphed = false; document.addEventListener('turbo:morph', () => { window.morphed = true })")
+    page.execute_script("Turbo.visit(location.href, { action: 'replace' })")
+    Timeout.timeout(5) { sleep 0.05 until page.evaluate_script("window.morphed") }
+
+    assert_text "Notifications are on for this device."
+  end
+
+  private
+    def set_notification_permission(setting)
+      origin = "http://#{page.server.host}:#{page.server.port}"
+      page.driver.browser.execute_cdp("Browser.setPermission", origin: origin, permission: { name: "notifications" }, setting: setting)
+    end
+
+    # Once the browser is asked for permission it grants it, and then it has a subscription to hand over
+    def grant_permission_with_device_subscription
+      page.execute_script(<<~JS)
+        Notification.requestPermission = async () => {
+          Object.defineProperty(Notification, "permission", { get: () => "granted", configurable: true })
+          return "granted"
+        }
+        PushManager.prototype.subscribe = async () => (#{DEVICE_SUBSCRIPTION})
+        PushManager.prototype.getSubscription = async () => (Notification.permission === "granted" ? (#{DEVICE_SUBSCRIPTION}) : null)
+      JS
+    end
+
+    # Runs before any page script, so the browser looks like it already has permission and a subscription.
+    # The browser outlives each test, so the script is removed again in teardown.
+    def add_init_script(source)
+      @init_script_ids ||= []
+      @init_script_ids << page.driver.browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: source)["identifier"]
+    end
+end
