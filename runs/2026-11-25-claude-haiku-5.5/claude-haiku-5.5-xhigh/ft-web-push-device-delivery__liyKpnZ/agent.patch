+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,24 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    subscription.update!(subscription_params.merge(user_agent: request.user_agent))
+
+    head :created
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..9656031
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,103 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+// Turns on push notifications for the device this page is open on. The browser issues the push
+// subscription, and we register it for the current user so their notifications reach this device.
+export default class extends Controller {
+  static targets = [ "details", "enableButton" ]
+  static values = { vapidPublicKey: String, subscriptionsUrl: String }
+
+  connect() {
+    this.refresh()
+  }
+
+  // Turbo morphs the page in place, which resets the state we showed, so we show it again
+  async refresh() {
+    try {
+      this.#showState(await this.#restoreSubscription())
+    } catch (error) {
+      console.error("Couldn't check push notifications on this device", error)
+      this.#showState(false)
+    }
+  }
+
+  async enable() {
+    this.enableButtonTarget.disabled = true
+    let subscribed = false
+
+    try {
+      if (await Notification.requestPermission() === "granted") {
+        subscribed = await this.#register(await this.#subscribe())
+      }
+    } catch (error) {
+      console.error("Couldn't turn on push notifications", error)
+    }
+
+    this.enableButtonTarget.disabled = false
+    this.#showState(subscribed)
+  }
+
+  // The browser's subscription can outlive a session, and it may have been made by someone else
+  // who used this browser. Registering it again for the current user keeps the page truthful.
+  async #restoreSubscription() {
+    const subscription = await this.#existingSubscription()
+
+    return subscription ? this.#register(subscription) : false
+  }
+
+  async #existingSubscription() {
+    if (this.#supported && Notification.permission === "granted") {
+      const registration = await navigator.serviceWorker.ready
+      return registration.pushManager.getSubscription()
+    }
+  }
+
+  async #subscribe() {
+    const registration = await navigator.serviceWorker.ready
+
+    return registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: applicationServerKey(this.vapidPublicKeyValue)
+    })
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    try {
+      const response = await post(this.subscriptionsUrlValue, {
+        body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } }
+      })
+
+      return response.ok
+    } catch (error) {
+      console.error("Couldn't register this device for push notifications", error)
+      return false
+    }
+  }
+
+  #showState(subscribed) {
+    this.element.classList.toggle("notifications--on", subscribed)
+    this.enableButtonTarget.hidden = subscribed || !this.#supported || this.#blocked
+
+    this.detailsTargets.forEach((element) => {
+      element.hidden = !this.#blocked
+    })
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  // The browser refuses to ask again once notifications are blocked, so we explain how to unblock them
+  get #blocked() {
+    return this.#supported && Notification.permission === "denied"
+  }
+}
+
+// The VAPID public key arrives as URL-safe base64, and the push service wants its raw bytes
+function applicationServerKey(base64url) {
+  const base64 = base64url.replace(/-/g, "+").replace(/_/g, "/").padEnd(Math.ceil(base64url.length / 4) * 4, "=")
+
+  return Uint8Array.from(atob(base64), (character) => character.charCodeAt(0))
+}
