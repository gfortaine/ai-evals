diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..6073c45
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @user = users(:david)
+  end
+
+  test "create stores the subscription for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.find_by!(endpoint: subscription_params[:endpoint])
+    assert_equal subscription_params[:p256dh_key], subscription.p256dh_key
+    assert_equal subscription_params[:auth_key], subscription.auth_key
+    assert_equal accounts("37s"), subscription.account
+  end
+
+  test "create records the user agent of the device" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params },
+      headers: { "User-Agent" => "Mozilla/5.0 (Macintosh) Firefox/140.0" }, as: :json
+
+    assert_equal "Mozilla/5.0 (Macintosh) Firefox/140.0", @user.push_subscriptions.last.user_agent
+  end
+
+  test "create again for the same endpoint updates it rather than adding a second device" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user),
+        params: { push_subscription: subscription_params.merge(auth_key: "rotated-auth-key") }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "rotated-auth-key", @user.push_subscriptions.find_by!(endpoint: subscription_params[:endpoint]).auth_key
+  end
+
+  test "create accepts form-encoded subscriptions too" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }
+    end
+
+    assert_response :created
+  end
+
+  test "create rejects endpoints that are not https" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user),
+        params: { push_subscription: subscription_params.merge(endpoint: "http://push.example.com/abc") }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create requires the subscription keys" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user),
+        params: { push_subscription: { endpoint: subscription_params[:endpoint] } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create without a push_subscription is a bad request" do
+    post user_push_subscriptions_path(@user), params: {}, as: :json
+
+    assert_response :bad_request
+  end
+
+  test "create for another user is forbidden" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  private
+    def subscription_params
+      {
+        endpoint: "https://fcm.googleapis.com/fcm/send/abc123",
+        p256dh_key: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+        auth_key: "tBHItJI5svbpez7KI4CCXg"
+      }
+    end
+end
