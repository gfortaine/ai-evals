@@ -1,6 +1,9 @@
 module Card::Entropic
   extend ActiveSupport::Concern
 
+  AUTO_POSTPONE_BOARDS_PER_QUERY = 500
+  AUTO_POSTPONE_CARDS_PER_BATCH = 1000
+
   included do
     scope :due_to_be_postponed, -> do
       active
@@ -24,11 +27,43 @@ module Card::Entropic
   end
 
   class_methods do
+    # Same selection as #due_to_be_postponed, but resolved per board instead of per card.
+    #
+    # The effective period of each board is computed once (its own entropy, else the
+    # account's). Each query then filters cards by board and last_active_at only, so it
+    # can seek straight to the due cards instead of scanning and joining the whole cards
+    # table on every run.
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+
+      board_ids_by_auto_postpone_period.each do |period, board_ids|
+        cutoff = now - period
+
+        board_ids.each_slice(AUTO_POSTPONE_BOARDS_PER_QUERY) do |slice_board_ids|
+          due_card_ids = active.where(board_id: slice_board_ids).where(last_active_at: ..cutoff).pluck(:id)
+
+          # Re-check the due conditions when loading each batch: a card may have been
+          # closed, postponed or touched since its id was plucked.
+          due_card_ids.each_slice(AUTO_POSTPONE_CARDS_PER_BATCH) do |card_ids|
+            active.where(id: card_ids).where(last_active_at: ..cutoff).find_each do |card|
+              card.auto_postpone(user: card.account.system_user)
+            end
+          end
+        end
       end
     end
+
+    private
+      def board_ids_by_auto_postpone_period
+        rows = Board.joins(:account)
+          .left_outer_joins(:entropy)
+          .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
+          .pluck(:id, Arel.sql("COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)"))
+
+        rows.reject { |_, period| period.nil? }
+          .group_by(&:last)
+          .transform_values { |pairs| pairs.map(&:first) }
+      end
   end
 
   def entropy
