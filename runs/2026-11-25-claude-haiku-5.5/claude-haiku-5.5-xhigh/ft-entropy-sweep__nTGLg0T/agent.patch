diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..c5752ce 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,41 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due postpones exactly the cards due_to_be_postponed selects" do
+    freeze_time
+
+    cards(:logo).update!(last_active_at: 91.days.ago)
+    cards(:layout).update!(last_active_at: 89.days.ago)
+    cards(:radio).update!(last_active_at: 91.days.ago)
+    cards(:paycheck).update!(last_active_at: 10.days.ago)
+
+    expected = Card.due_to_be_postponed.pluck(:id)
+    assert_includes expected, cards(:logo).id
+    assert_includes expected, cards(:radio).id
+    assert_not_includes expected, cards(:layout).id
+
+    Card.auto_postpone_all_due
+
+    assert_equal expected.sort, Card.postponed.pluck(:id).sort
+  end
+
+  test "auto postpone all due leaves closed cards alone" do
+    cards(:logo).update!(last_active_at: 1.year.ago)
+    cards(:logo).close(user: users(:kevin))
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.closed?
+    assert_not cards(:logo).postponed?
+  end
+
+  test "auto postpone all due skips boards without any entropy configured" do
+    entropies(:writebook_board).destroy
+    entropies("37s_account").destroy
+    cards(:logo).update!(last_active_at: 1.year.ago)
+
+    assert_nothing_raised { Card.auto_postpone_all_due }
+    assert_not cards(:logo).reload.postponed?
+  end
 end
