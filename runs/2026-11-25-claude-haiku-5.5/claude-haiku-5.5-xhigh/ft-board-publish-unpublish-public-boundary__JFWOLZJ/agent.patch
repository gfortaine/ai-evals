diff --git a/test/models/board/publication_test.rb b/test/models/board/publication_test.rb
new file mode 100644
index 0000000..c83385b
--- /dev/null
+++ b/test/models/board/publication_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class Board::PublicationTest < ActiveSupport::TestCase
+  test "publish creates a publication with a secret key" do
+    board = boards(:writebook)
+    assert_not board.published?
+
+    board.publish
+
+    assert board.published?
+    assert_equal board, board.publication.board
+    assert_equal accounts("37s"), board.publication.account
+    assert_match(/\A[A-Za-z0-9]{24}\z/, board.publication.key)
+  end
+
+  test "publish is idempotent and keeps the existing key" do
+    board = boards(:writebook)
+    board.publish
+    key = board.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      board.publish
+    end
+
+    assert_equal key, board.reload.publication.key
+  end
+
+  test "unpublish removes the publication" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      board.unpublish
+    end
+
+    assert_not board.published?
+    assert_not board.reload.published?
+  end
+
+  test "unpublish is a no-op for an unpublished board" do
+    board = boards(:writebook)
+
+    assert_no_difference -> { Board::Publication.count } do
+      board.unpublish
+    end
+
+    assert_not board.published?
+  end
+
+  test "republishing issues a new key" do
+    board = boards(:writebook)
+    board.publish
+    old_key = board.publication.key
+
+    board.unpublish
+    board.publish
+
+    assert_not_equal old_key, board.reload.publication.key
+  end
+
+  test "keys are unique across boards" do
+    boards(:writebook).publish
+    boards(:private).publish
+
+    assert_not_equal boards(:writebook).publication.key, boards(:private).publication.key
+  end
+
+  test "publishing and unpublishing touch the board so its cached JSON is refreshed" do
+    board = boards(:writebook)
+    board.update_column(:updated_at, 1.day.ago)
+
+    board.publish
+    assert_operator board.reload.updated_at, :>, 1.hour.ago
+
+    board.update_column(:updated_at, 1.day.ago)
+    board.unpublish
+    assert_operator board.reload.updated_at, :>, 1.hour.ago
+  end
+
+  test "publishing and unpublishing touch the board's cards" do
+    card = cards(:logo)
+    card.update_column(:updated_at, 1.day.ago)
+
+    boards(:writebook).publish
+    assert_operator card.reload.updated_at, :>, 1.hour.ago
+
+    card.update_column(:updated_at, 1.day.ago)
+    boards(:writebook).reload.unpublish
+    assert_operator card.reload.updated_at, :>, 1.hour.ago
+  end
+
+  test "destroying the board destroys its publication" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      board.destroy
+    end
+  end
+end
