+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    boards(:writebook).publish
+    @key = boards(:writebook).publication.key
+  end
+
+  test "show a published card without signing in" do
+    card = cards(:logo)
+
+    get public_board_card_path(@key, card.number)
+
+    assert_response :success
+    assert_select "h1", text: card.title
+  end
+
+  test "show the card's description" do
+    card = cards(:logo)
+    card.update!(description: "The logo should be <strong>bigger</strong>")
+
+    get public_board_card_path(@key, card.number)
+
+    assert_select ".lexxy-content strong", text: "bigger"
+  end
+
+  test "show the card's image" do
+    card = cards(:logo)
+    card.update!(image: fixture_file_upload("moon.jpg", "image/jpeg"))
+
+    get public_board_card_path(@key, card.number)
+
+    assert_select "img[alt=?]", card.title
+  end
+
+  test "the card's image is publicly accessible while the board is published" do
+    card = cards(:logo)
+    card.update!(image: fixture_file_upload("moon.jpg", "image/jpeg"))
+    image_path = rails_blob_path(card.image, only_path: true)
+    sign_out
+
+    get image_path
+
+    assert_response :redirect
+    assert_match %r{/rails/active_storage/disk/}, response.location
+  end
+
+  test "the card's image requires signing in once the board is unpublished" do
+    card = cards(:logo)
+    card.update!(image: fixture_file_upload("moon.jpg", "image/jpeg"))
+    image_path = rails_blob_path(card.image, only_path: true)
+    boards(:writebook).unpublish
+    sign_out
+
+    get image_path
+
+    assert_response :redirect
+    assert_match %r{/session/new}, response.location
+  end
+
+  test "closed published cards can still be opened" do
+    get public_board_card_path(@key, cards(:shipping).number)
+
+    assert_response :success
+  end
+
+  test "drafted cards are not found" do
+    card = boards(:writebook).cards.create!(creator: users(:kevin), status: "drafted")
+
+    get public_board_card_path(@key, card.number)
+
+    assert_response :not_found
+  end
+
+  test "card of another board is not found" do
+    card = Current.set(user: users(:kevin)) do
+      boards(:private).cards.create!(creator: users(:kevin), status: "published", number: 999)
+    end
+
+    get public_board_card_path(@key, card.number)
+
+    assert_response :not_found
+  end
+
+  test "unknown card is not found" do
+    get public_board_card_path(@key, 999_999)
+
+    assert_response :not_found
+  end
+
+  test "card of an unpublished board is not found" do
+    boards(:writebook).unpublish
+
+    get public_board_card_path(@key, cards(:logo).number)
+
+    assert_response :not_found
+  end
+end
