index 0000000..23039e3
--- /dev/null
+++ b/app/controllers/concerns/public_board_scoped.rb
@@ -0,0 +1,24 @@
+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    allow_unauthenticated_access
+    layout "public"
+
+    before_action :ensure_account_active, :set_board
+  end
+
+  private
+    def set_board
+      @publication = Board::Publication.find_by!(key: publication_key, account: Current.account)
+      @board = @publication.board
+    end
+
+    def publication_key
+      params[:board_key]
+    end
+
+    def ensure_account_active
+      head :not_found unless Current.account.active?
+    end
+end
