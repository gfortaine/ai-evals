diff --git a/test/mailers/notification_mailer_test.rb b/test/mailers/notification_mailer_test.rb
new file mode 100644
index 0000000..07aa097
--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "daily")
+
+    @bundle = @user.notification_bundles.create!(starts_at: 1.day.ago, ends_at: Time.current)
+    @user.notifications.create!(source: events(:text_published), creator: users(:david)).update_columns(bundle_id: @bundle.id)
+    @user.notifications.create!(source: events(:shipping_published), creator: users(:jz)).update_columns(bundle_id: @bundle.id)
+  end
+
+  test "digest is sent to the user" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_equal [ @user.identity.email_address ], email.to
+  end
+
+  test "digest subject counts the notifications" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_equal "2 new notifications in Fizzy", email.subject
+  end
+
+  test "digest lists every notification in the window" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_match cards(:text).title, email.body.encoded
+    assert_match cards(:shipping).title, email.body.encoded
+  end
+
+  test "digest links each notification to its card" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_match Rails.application.routes.url_helpers.card_path(cards(:text), script_name: accounts("37s").slug), email.html_part.body.to_s.gsub("&amp;", "&")
+  end
+
+  test "digest has both HTML and text parts" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert email.html_part.present?, "Email should have HTML part"
+    assert email.text_part.present?, "Email should have text part"
+  end
+
+  test "digest does not include notifications from other windows" do
+    assert_nil notifications(:layout_commented_kevin).bundle
+
+    email = NotificationMailer.digest(@bundle)
+
+    assert_no_match cards(:layout).title, email.body.encoded
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..cc772c0
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,228 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @start = Time.utc(2026, 11, 2, 9)
+  end
+
+  test "window_for opens a window starting now and lasting one period" do
+    travel_to @start do
+      bundle = Notification::Bundle.window_for(@user, Time.current)
+
+      assert bundle.pending?
+      assert_equal @start, bundle.starts_at
+      assert_equal @start + 1.day, bundle.ends_at
+    end
+  end
+
+  test "window_for returns the window that is already open" do
+    travel_to @start do
+      first = Notification::Bundle.window_for(@user, Time.current)
+
+      travel 2.hours
+      assert_equal first, Notification::Bundle.window_for(@user, Time.current)
+      assert_equal 1, @user.notification_bundles.count
+    end
+  end
+
+  test "notifications arriving while a window is open all join it" do
+    travel_to @start do
+      first = create_notification(events(:text_published))
+      first.add_to_bundle
+
+      travel 2.hours
+      second = create_notification(events(:shipping_published))
+      second.add_to_bundle
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_equal first.reload.bundle, second.reload.bundle
+    end
+  end
+
+  test "a late notification joins the window that has already opened" do
+    travel_to @start do
+      late = create_notification(events(:text_published), happened_at: @start - 30.minutes)
+
+      travel 5.minutes
+      on_time = create_notification(events(:shipping_published))
+      on_time.add_to_bundle
+
+      late.add_to_bundle
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_equal on_time.reload.bundle, late.reload.bundle
+      assert_equal @start + 5.minutes, late.bundle.starts_at
+    end
+  end
+
+  test "an event that happened before a window ended joins it, even if it is processed after the window ended" do
+    window = nil
+    travel_to @start do
+      window = Notification::Bundle.window_for(@user, Time.current)
+    end
+
+    travel_to window.ends_at + 2.minutes do
+      late = create_notification(events(:text_published), happened_at: window.ends_at - 1.minute)
+      late.add_to_bundle
+
+      assert_equal window, late.reload.bundle
+      assert_equal 1, @user.notification_bundles.count
+    end
+  end
+
+  test "an event that happened after a window ended starts the next window, even if that window is not delivered yet" do
+    window = nil
+    travel_to @start do
+      window = Notification::Bundle.window_for(@user, Time.current)
+    end
+
+    travel_to window.ends_at + 2.minutes do
+      notification = create_notification(events(:text_published), happened_at: window.ends_at + 30.seconds)
+      notification.add_to_bundle
+
+      next_window = notification.reload.bundle
+      assert_not_equal window, next_window
+      assert_operator next_window.starts_at, :>=, window.ends_at
+      assert window.reload.pending?
+    end
+  end
+
+  test "a window opened after another ended starts after it, even if the earlier one was already delivered" do
+    travel_to @start do
+      delivered = @user.notification_bundles.create!(status: "delivered", starts_at: @start - 1.hour, ends_at: @start + 2.hours)
+
+      bundle = Notification::Bundle.window_for(@user, Time.current)
+
+      assert_equal delivered.ends_at, bundle.starts_at
+      assert_operator bundle.starts_at, :>=, delivered.ends_at
+    end
+  end
+
+  test "windows for one user never overlap across many arrivals" do
+    windows = []
+    travel_to @start do
+      20.times do
+        travel 6.hours
+        windows << Notification::Bundle.window_for(@user, Time.current)
+      end
+    end
+
+    windows.uniq!
+    assert_operator windows.size, :>=, 2
+
+    windows.sort_by(&:starts_at).each_cons(2) do |earlier, later|
+      assert_operator earlier.ends_at, :<=, later.starts_at
+    end
+  end
+
+  test "windows use the length for each frequency" do
+    travel_to @start do
+      { "every_few_hours" => 4.hours, "daily" => 1.day, "weekly" => 1.week }.each do |frequency, length|
+        @user.notification_bundles.destroy_all
+        @user.settings.update!(bundle_email_frequency: frequency)
+
+        bundle = Notification::Bundle.window_for(@user, Time.current)
+
+        assert_equal length, bundle.ends_at - bundle.starts_at
+      end
+    end
+  end
+
+  test "deliver_due enqueues delivery only for windows that have closed" do
+    closed = @user.notification_bundles.create!(starts_at: @start - 1.day, ends_at: @start - 1.hour)
+    @user.notification_bundles.create!(starts_at: @start - 1.hour, ends_at: @start + 1.day)
+
+    travel_to @start do
+      Notification::Bundle.deliver_due
+    end
+
+    assert_enqueued_jobs 1, only: Notification::Bundle::DeliveryJob
+    assert_enqueued_with(job: Notification::Bundle::DeliveryJob, args: [ closed ])
+  end
+
+  test "deliver sends one digest covering the window and closes it" do
+    bundle = open_window_with(events(:text_published), events(:shipping_published))
+
+    assert_emails 1 do
+      perform_enqueued_jobs { bundle.deliver }
+    end
+
+    assert bundle.reload.delivered?
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match "2 new notifications", email.subject
+    assert_includes email.body.encoded, cards(:text).title
+    assert_includes email.body.encoded, cards(:shipping).title
+  end
+
+  test "deliver only sends once for a window" do
+    bundle = open_window_with(events(:text_published))
+
+    perform_enqueued_jobs { bundle.deliver }
+
+    assert_no_emails do
+      perform_enqueued_jobs { bundle.deliver }
+    end
+  end
+
+  test "deliver_due delivers closed windows and leaves open ones alone" do
+    closed = open_window_with(events(:text_published))
+    still_open = @user.notification_bundles.create!(starts_at: closed.ends_at, ends_at: closed.ends_at + 1.day)
+
+    travel_to closed.ends_at + 1.minute do
+      assert_emails 1 do
+        perform_enqueued_jobs { Notification::Bundle.deliver_due }
+      end
+    end
+
+    assert closed.reload.delivered?
+    assert still_open.reload.pending?
+  end
+
+  test "deliver sends nothing if the user has turned digests off since the window opened" do
+    bundle = open_window_with(events(:text_published))
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_emails do
+      perform_enqueued_jobs { bundle.deliver }
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver sends nothing to deactivated users" do
+    bundle = open_window_with(events(:text_published))
+    @user.update!(active: false)
+
+    assert_no_emails do
+      perform_enqueued_jobs { bundle.deliver }
+    end
+  end
+
+  test "deliver sends nothing for an empty window" do
+    bundle = Notification::Bundle.window_for(@user, Time.current)
+
+    assert_no_emails do
+      perform_enqueued_jobs { bundle.deliver }
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  private
+    def create_notification(event, happened_at: Time.current)
+      event.update_column(:created_at, happened_at)
+      @user.notifications.create!(source: event, creator: users(:david))
+    end
+
+    def open_window_with(*events)
+      travel_to @start do
+        events.each { |event| create_notification(event).add_to_bundle }
+      end
+      @user.notification_bundles.sole
+    end
+end
diff --git a/test/models/notification/bundleable_test.rb b/test/models/notification/bundleable_test.rb
new file mode 100644
index 0000000..cf63b6f
--- /dev/null
+++ b/test/models/notification/bundleable_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class Notification::BundleableTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "daily")
+  end
+
+  test "bundle_later enqueues Notification::BundleJob after a notification is created" do
+    assert_enqueued_with(job: Notification::BundleJob) do
+      @user.notifications.create!(source: events(:text_published), creator: users(:david))
+    end
+  end
+
+  test "bundle_later is called when notification source changes" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_enqueued_with(job: Notification::BundleJob, args: [ notification ]) do
+      notification.update!(source: events(:layout_published))
+    end
+  end
+
+  test "bundle_later is not called for other updates" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_no_enqueued_jobs only: Notification::BundleJob do
+      notification.update!(unread_count: 5)
+    end
+  end
+
+  test "add_to_bundle puts the notification in the open window" do
+    notification = @user.notifications.create!(source: events(:text_published), creator: users(:david))
+
+    notification.add_to_bundle
+
+    assert_equal @user.notification_bundles.sole, notification.reload.bundle
+  end
+
+  test "add_to_bundle leaves notifications alone for users with digests off" do
+    @user.settings.update!(bundle_email_frequency: "never")
+    notification = @user.notifications.create!(source: events(:text_published), creator: users(:david))
+
+    notification.add_to_bundle
+
+    assert_nil notification.reload.bundle
+    assert_empty @user.notification_bundles
+  end
+
+  test "a notification that gets a new event after its window was delivered moves to the next window" do
+    notification = @user.notifications.create!(source: events(:text_published), creator: users(:david))
+    notification.add_to_bundle
+    delivered = notification.bundle
+    delivered.update!(status: "delivered")
+
+    notification.update!(source: events(:shipping_published))
+    notification.add_to_bundle
+
+    assert_not_equal delivered, notification.reload.bundle
+    assert notification.bundle.pending?
+  end
+
+  test "notifications created by the notifier are bundled for the recipient" do
+    boards(:writebook).access_for(@user).watching!
+
+    perform_enqueued_jobs only: Notification::BundleJob do
+      Notifier.for(events(:logo_published)).notify
+    end
+
+    notification = @user.notifications.find_by!(card: cards(:logo))
+    assert_equal @user.notification_bundles.sole, notification.reload.bundle
+  end
+
+  test "notifications from across a day become one digest email when the window closes" do
+    boards(:writebook).access_for(@user).watching!
+    events(:text_published, :shipping_published).each { |event| event.update!(creator: users(:david)) }
+    start = Time.utc(2026, 11, 2, 9)
+
+    travel_to start do
+      events(:text_published).update_column(:created_at, Time.current)
+      perform_enqueued_jobs(only: Notification::BundleJob) { Notifier.for(events(:text_published)).notify }
+    end
+
+    travel_to start + 3.hours do
+      events(:shipping_published).update_column(:created_at, Time.current)
+      perform_enqueued_jobs(only: Notification::BundleJob) { Notifier.for(events(:shipping_published)).notify }
+    end
+
+    travel_to start + 1.day + 5.minutes do
+      assert_emails 1 do
+        perform_enqueued_jobs { Notification::Bundle.deliver_due }
+      end
+    end
+
+    assert_equal 2, @user.notification_bundles.sole.notifications.count
+    assert @user.notification_bundles.sole.delivered?
+  end
+end
