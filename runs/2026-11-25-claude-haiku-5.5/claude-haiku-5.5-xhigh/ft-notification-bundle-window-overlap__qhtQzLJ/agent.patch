@@ -0,0 +1,42 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @settings = users(:kevin).settings
+  end
+
+  test "digest emails are off by default" do
+    user = User.create!(account: accounts("37s"), name: "New person")
+
+    assert user.settings.never?
+    assert_nil user.bundle_window
+  end
+
+  test "bundle_email_frequency accepts the four frequencies" do
+    %w[ never every_few_hours daily weekly ].each do |frequency|
+      @settings.bundle_email_frequency = frequency
+      assert @settings.valid?, "#{frequency} should be valid"
+    end
+  end
+
+  test "bundle_email_frequency rejects unknown frequencies" do
+    @settings.bundle_email_frequency = "hourly"
+
+    assert_not @settings.valid?
+    assert @settings.errors.of_kind?(:bundle_email_frequency, :inclusion)
+  end
+
+  test "bundle_window is the length of one digest window for each frequency" do
+    @settings.bundle_email_frequency = "every_few_hours"
+    assert_equal 4.hours, @settings.bundle_window
+
+    @settings.bundle_email_frequency = "daily"
+    assert_equal 1.day, @settings.bundle_window
+
+    @settings.bundle_email_frequency = "weekly"
+    assert_equal 1.week, @settings.bundle_window
+
+    @settings.bundle_email_frequency = "never"
+    assert_nil @settings.bundle_window
+  end
+end
