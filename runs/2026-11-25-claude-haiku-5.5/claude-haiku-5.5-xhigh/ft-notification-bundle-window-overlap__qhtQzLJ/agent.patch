diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..ee585ed
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,52 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, class_name: "Notification", dependent: :nullify
+
+  enum :status, %w[ pending delivered ].index_by(&:itself), default: :pending
+
+  scope :open_at, ->(time) { pending.where.not(ends_at: ..time) }
+  scope :due, ->(time = Time.current) { pending.where(ends_at: ..time) }
+
+  class << self
+    # Returns the window a notification belongs in. It joins the earliest pending
+    # window that had not ended when the notification happened, so late arrivals
+    # land in the window that has already opened. Otherwise a new window opens
+    # now, after the user's last window ended, so windows never overlap.
+    #
+    # Callers must hold the user's lock, see Notification::Bundleable.
+    def window_for(user, happened_at)
+      user.notification_bundles.open_at(happened_at).order(:ends_at).first || open_new_for(user)
+    end
+
+    def deliver_due
+      due.find_each do |bundle|
+        Current.with_account(bundle.account) { DeliveryJob.perform_later(bundle) }
+      end
+    end
+
+    private
+      def open_new_for(user)
+        starts_at = [ Time.current, user.notification_bundles.maximum(:ends_at) ].compact.max
+        user.notification_bundles.create!(starts_at: starts_at, ends_at: starts_at + user.bundle_window)
+      end
+  end
+
+  # Closes a pending window and emails what it collected. Only the first call
+  # does anything, so retries and duplicate jobs cannot send the email twice.
+  # Holds the user's lock, like adding to a window, so a notification cannot be
+  # attached to a window while it is being closed.
+  def deliver
+    user.with_lock do
+      if reload.pending?
+        update!(status: :delivered)
+        NotificationMailer.digest(self).deliver_later if deliverable?
+      end
+    end
+  end
+
+  private
+    def deliverable?
+      notifications.any? && user.active? && user.identity.present? && account.active? && user.bundle_window.present?
+    end
+end
diff --git a/app/models/notification/bundleable.rb b/app/models/notification/bundleable.rb
new file mode 100644
index 0000000..3e3f54f
--- /dev/null
+++ b/app/models/notification/bundleable.rb
@@ -0,0 +1,21 @@
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+
+    after_save_commit :bundle_later, if: :source_id_previously_changed?
+  end
+
+  def bundle_later
+    Notification::BundleJob.perform_later(self)
+  end
+
+  def add_to_bundle
+    if user.bundle_window
+      user.with_lock do
+        update_columns(bundle_id: Notification::Bundle.window_for(user, source.created_at).id)
+      end
+    end
+  end
+end
