diff --git a/app/models/leaf/editable.rb b/app/models/leaf/editable.rb
index d00f2a6..abd7084 100644
--- a/app/models/leaf/editable.rb
+++ b/app/models/leaf/editable.rb
@@ -4,7 +4,8 @@ module Leaf::Editable
   MINIMUM_TIME_BETWEEN_VERSIONS = 10.minutes
 
   included do
-    has_many :edits, dependent: :delete_all
+    # Revisions own their own leafables (and any images they embed), so destroy them rather than deleting rows.
+    has_many :edits, dependent: :destroy
 
     after_update :record_moved_to_trash, if: :was_trashed?
   end
diff --git a/lib/rails_ext/action_text_markdown.rb b/lib/rails_ext/action_text_markdown.rb
index fa0a622..631cb02 100644
--- a/lib/rails_ext/action_text_markdown.rb
+++ b/lib/rails_ext/action_text_markdown.rb
@@ -29,7 +29,8 @@ module ActionText::Markdown::Uploads
   extend ActiveSupport::Concern
 
   included do
-    has_many_attached :uploads, dependent: :destroy
+    # Purge (not just destroy) so the blob record and its file are removed along with the attachment.
+    has_many_attached :uploads, dependent: :purge_later
   end
 end
 
diff --git a/test/controllers/action_text/markdown/uploads_controller_test.rb b/test/controllers/action_text/markdown/uploads_controller_test.rb
index 48141c1..3ae8135 100644
--- a/test/controllers/action_text/markdown/uploads_controller_test.rb
+++ b/test/controllers/action_text/markdown/uploads_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class ActionText::Markdown::UploadsControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -31,4 +33,28 @@ class ActionText::Markdown::UploadsControllerTest < ActionDispatch::IntegrationT
     assert_response :redirect
     assert_match /\/rails\/active_storage\/.*\/reading\.webp/, @response.redirect_url
   end
+
+  test "file is removed along with the page that embeds it" do
+    post action_text_markdown_uploads_path, params: {
+      record_gid: pages(:welcome).to_signed_global_id.to_s,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+    file_url = JSON.parse(response.body)["fileUrl"]
+    attachment = ActiveStorage::Attachment.find_by!(slug: file_url.delete_prefix("/u/"))
+    blob = attachment.blob
+
+    get file_url
+    assert_response :redirect
+
+    pages(:welcome).destroy!
+    perform_enqueued_jobs
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+
+    get file_url
+    assert_response :not_found
+  end
 end
diff --git a/test/models/leaf/editable_test.rb b/test/models/leaf/editable_test.rb
index b654642..3df7c85 100644
--- a/test/models/leaf/editable_test.rb
+++ b/test/models/leaf/editable_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class Leaf::EditableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
   test "editing a leafable records the edit" do
     leaves(:welcome_page).edit leafable_params: { body: "New body" }
 
@@ -63,4 +65,38 @@ class Leaf::EditableTest < ActiveSupport::TestCase
     assert leaves(:welcome_page).edits.last.trash?
     assert_equal "This is _such_ a great handbook.", leaves(:welcome_page).edits.last.page.body.content
   end
+
+  test "destroying a leaf destroys its revisions along with the images they embed" do
+    leaf = leaves(:welcome_page)
+    leaf.leafable.body.tap(&:save!).uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    attachment = leaf.leafable.body.uploads.last
+    blob = attachment.blob
+
+    travel 1.hour
+    leaf.edit leafable_params: { body: "A newer version" }
+    assert_equal 1, leaf.edits.revision.count
+
+    leaf.destroy!
+    perform_enqueued_jobs
+
+    assert_equal 0, Edit.where(leaf_id: leaf.id).count
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+
+  test "destroying a leaf purges a picture revision's image once no reference to it remains" do
+    leaf = leaves(:reading_picture)
+    blob = leaf.picture.image.blob
+
+    travel 1.hour
+    leaf.edit leafable_params: { caption: "A newer caption" }
+    assert_equal 2, ActiveStorage::Attachment.where(blob: blob).count
+
+    leaf.destroy!
+    perform_enqueued_jobs
+
+    assert_equal 0, ActiveStorage::Attachment.where(blob: blob).count
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+  end
 end
