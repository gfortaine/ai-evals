diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..7b730e5 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,82 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroy archives every user who had access, with their level" do
+    book = books(:handbook)
+
+    assert_difference -> { AccessArchive.count }, +4 do
+      book.destroy
+    end
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal({ "David" => "editor", "Jason" => "editor", "JZ" => "reader", "Kevin" => "editor" },
+                 archives.to_h { [ it.user_name, it.level ] })
+    assert archives.all? { it.book_title == "Handbook" }
+    assert_equal [ users(:david), users(:jason), users(:jz), users(:kevin) ].map(&:id).sort, archives.map(&:user_id).sort
+  end
+
+  test "destroy removes the book and its access grants" do
+    book = books(:handbook)
+
+    assert_difference -> { Book.count }, -1 do
+      assert_difference -> { Access.count }, -4 do
+        book.destroy
+      end
+    end
+  end
+
+  test "revoking access does not write an archive row" do
+    book = books(:handbook)
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.update_access(editors: [ users(:david).id ], readers: [])
+    end
+  end
+
+  test "users whose access was revoked earlier are not archived" do
+    book = books(:handbook)
+    book.update!(everyone_access: false)
+    book.update_access(editors: [ users(:david).id ], readers: [ users(:jz).id ])
+
+    book.destroy
+
+    archived = AccessArchive.where(book_id: book.id)
+    assert_equal [ users(:david).id, users(:jz).id ].sort, archived.map(&:user_id).sort
+    assert_not_includes archived.map(&:user_name), "Jason"
+    assert_not_includes archived.map(&:user_name), "Kevin"
+  end
+
+  test "destroying a book nobody had access to archives nothing" do
+    book = books(:handbook)
+    book.accesses.delete_all
+
+    assert_no_difference -> { AccessArchive.count } do
+      assert_difference -> { Book.count }, -1 do
+        book.destroy
+      end
+    end
+  end
+
+test "a failed deletion leaves no archive rows behind" do
+  book = books(:handbook)
+  original_create = AccessArchive.method(:create!)
+  calls = 0
+
+  begin
+    AccessArchive.define_singleton_method(:create!) do |**attributes|
+      calls += 1
+      raise ActiveRecord::StatementInvalid, "boom" if calls == 3
+      original_create.call(**attributes)
+    end
+
+    assert_raises(ActiveRecord::StatementInvalid) { book.destroy }
+  ensure
+    AccessArchive.singleton_class.remove_method(:create!)
+  end
+
+  assert_equal 0, AccessArchive.where(book_id: book.id).count
+  assert Book.exists?(book.id)
+  assert_equal 4, Access.where(book_id: book.id).count
+end
 end
