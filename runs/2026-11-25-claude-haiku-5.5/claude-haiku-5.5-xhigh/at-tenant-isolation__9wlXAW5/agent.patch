diff --git a/test/controllers/tenancy_test.rb b/test/controllers/tenancy_test.rb
new file mode 100644
index 0000000..f410c7f
--- /dev/null
+++ b/test/controllers/tenancy_test.rb
@@ -0,0 +1,181 @@
+require "test_helper"
+
+class TenancyTest < ActionDispatch::IntegrationTest
+  setup do
+    @customer_a = Tenant.create!(name: "Customer A")
+    @customer_b = Tenant.create!(name: "Customer B")
+
+    users(:kevin).update!(tenant: @customer_a)
+    books(:handbook).update!(tenant: @customer_a)
+
+    users(:david).update!(tenant: @customer_b)
+    users(:jason).update!(tenant: @customer_b)
+    users(:jz).update!(tenant: @customer_b)
+    books(:manual).update!(tenant: @customer_b)
+
+    @leaf = books(:manual).press Page.new(body: "Customer B secret"), title: "Secret page"
+    @leaf.edit leafable_params: { body: "Customer B secret, revised" }
+
+    # The pilot merge: a customer A user holds an access row to a customer B book.
+    books(:manual).accesses.create!(user: users(:kevin), level: :reader)
+
+    sign_in :kevin
+  end
+
+  test "another tenant's books are missing from the library, published or not" do
+    get root_path
+    assert_select "h2", text: "Handbook"
+    assert_select "h2", text: "Manual", count: 0
+
+    books(:manual).update!(published: true)
+
+    get root_path
+    assert_select "h2", text: "Handbook"
+    assert_select "h2", text: "Manual", count: 0
+  end
+
+  test "another tenant's book answers 404, the same as a book that does not exist" do
+    get "/999999/manual"
+    assert_response :not_found
+
+    [ false, true ].each do |published|
+      books(:manual).update!(published: published)
+
+      get book_slug_path(books(:manual))
+      assert_response :not_found
+
+      get book_slug_path(books(:manual), format: :md)
+      assert_response :not_found
+    end
+  end
+
+  test "pages and edit history inside another tenant's book answer 404, as missing ones do" do
+    get "/pages/999999/edits/latest"
+    assert_response :not_found
+
+    [ leafable_slug_path(@leaf), leafable_slug_path(@leaf, format: :md), page_edit_path(@leaf, @leaf.edits.last), page_edit_path(@leaf, "latest") ].each do |path|
+      get path
+      assert_response :not_found, path
+    end
+  end
+
+  test "every other request into another tenant's book answers 404 and changes nothing" do
+    requests = [
+      [ :get,    edit_book_path(books(:manual)), {} ],
+      [ :patch,  book_path(books(:manual)), { book: { title: "Hijacked" } } ],
+      [ :delete, book_path(books(:manual)), {} ],
+      [ :get,    edit_book_publication_path(books(:manual)), {} ],
+      [ :patch,  book_publication_path(books(:manual)), { book: { published: "1" } } ],
+      [ :get,    book_bookmark_path(books(:manual)), {} ],
+      [ :post,   book_search_path(books(:manual)), { search: "Customer" } ],
+      [ :get,    new_book_page_path(books(:manual)), {} ],
+      [ :post,   book_pages_path(books(:manual)), { page: { body: "Injected" } } ],
+      [ :get,    edit_book_page_path(books(:manual), @leaf), {} ],
+      [ :patch,  book_page_path(books(:manual), @leaf), { page: { body: "Hijacked" } } ],
+      [ :delete, book_page_path(books(:manual), @leaf), {} ],
+      [ :post,   book_leaves_moves_path(books(:manual)), { id: [ @leaf.id ], position: 0 } ],
+      [ :get,    new_book_section_path(books(:manual)), {} ],
+      [ :post,   book_sections_path(books(:manual)), { section: { body: "Injected" }, leaf: { title: "Injected" } } ],
+      [ :post,   action_text_markdown_uploads_path, {
+        record_gid: @leaf.leafable.to_signed_global_id.to_s,
+        attribute_name: "body",
+        file: fixture_file_upload("reading.webp", "image/webp")
+      } ]
+    ]
+
+    assert_no_changes -> { [ books(:manual).reload.attributes, @leaf.reload.attributes, @leaf.leafable.reload.body.content.to_s, Leaf.count, Edit.count, ActiveStorage::Attachment.count ] } do
+      requests.each do |verb, path, params|
+        send verb, path, params: params
+        assert_response :not_found, "#{verb.upcase} #{path}"
+      end
+    end
+  end
+
+  test "a refused request does not sign the user out" do
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    get root_path
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+  end
+
+  test "signed out visitors still see every published book, whatever tenant it belongs to" do
+    sign_out
+    books(:manual).update!(published: true)
+
+    get root_path
+    assert_response :success
+    assert_select "h2", text: "Manual"
+
+    get book_slug_path(books(:manual))
+    assert_response :success
+
+    get leafable_slug_path(@leaf)
+    assert_response :success
+  end
+
+  test "a new book lands in its creator's tenant and only shares with that tenant" do
+    post books_path, params: { book: { title: "Kevin's Book", everyone_access: true }, "reader_ids[]": [ users(:david).id ] }
+
+    book = Book.find_by!(title: "Kevin's Book")
+    assert_equal @customer_a, book.tenant
+    assert_equal [ users(:kevin).id ], book.accesses.pluck(:user_id)
+  end
+
+  test "sharing only grants access to people in the book's tenant" do
+    patch book_path(books(:handbook)), params: {
+      book: { everyone_access: false },
+      "reader_ids[]": [ users(:david).id ],
+      "editor_ids[]": [ users(:jz).id ]
+    }
+
+    assert_equal [ users(:kevin).id ], books(:handbook).reload.accesses.pluck(:user_id)
+  end
+
+  test "the sharing checklist only lists people from the book's tenant" do
+    get new_book_path
+    assert_response :success
+
+    assert_select "legend", text: "Kevin"
+    assert_select "legend", text: "David", count: 0
+    assert_select "legend", text: "JZ", count: 0
+  end
+
+  test "an administrator only reaches their own tenant's books" do
+    books(:handbook).update!(published: true)
+    sign_in :david
+
+    get edit_book_path(books(:handbook))
+    assert_response :not_found
+
+    patch book_path(books(:handbook)), params: { book: { title: "Hijacked" } }
+    assert_response :not_found
+    assert_equal "Handbook", books(:handbook).reload.title
+
+    get edit_book_path(books(:manual))
+    assert_response :success
+  end
+
+  test "the people page still names everyone on the install" do
+    get users_path
+    assert_response :success
+
+    assert_in_body "David"
+    assert_in_body "JZ"
+  end
+
+  test "inside a tenant, pages, edit history and sharing keep working" do
+    leaves(:welcome_page).edit leafable_params: { body: "Updated inside the tenant" }
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+
+    get page_edit_path(leaves(:welcome_page), "latest")
+    assert_response :success
+
+    patch book_path(books(:handbook)), params: { book: { everyone_access: true } }
+    assert_redirected_to book_slug_path(books(:handbook))
+    assert_equal [ users(:kevin).id ], books(:handbook).reload.accesses.pluck(:user_id)
+  end
+end
