+++ b/test/models/book/tenancy_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Book::TenancyTest < ActiveSupport::TestCase
+  setup do
+    @customer_a = Tenant.create!(name: "Customer A")
+    @customer_b = Tenant.create!(name: "Customer B")
+
+    users(:kevin).update!(tenant: @customer_a)
+    users(:david).update!(tenant: @customer_b)
+
+    books(:handbook).update!(tenant: @customer_a, published: true)
+    books(:manual).update!(tenant: @customer_b, published: true)
+  end
+
+  test "accessable_or_published only offers a signed-in user books from their own tenant" do
+    books(:manual).accesses.create!(user: users(:kevin), level: :reader)
+
+    assert_equal [ books(:handbook) ], Book.accessable_or_published(user: users(:kevin)).to_a
+  end
+
+  test "accessable_or_published keeps unpublished books the user has access to, inside their tenant" do
+    books(:handbook).update!(published: false)
+
+    assert_equal [ books(:handbook) ], Book.accessable_or_published(user: users(:kevin)).to_a
+  end
+
+  test "access rows to another tenant's book grant nothing" do
+    # david holds an editor row to the handbook from the pilot merge, but the handbook is in customer A
+    assert books(:handbook).accesses.exists?(user: users(:david))
+
+    assert_empty Book.accessable_or_published(user: users(:david)).where(id: books(:handbook).id)
+    assert_not books(:handbook).editable?(user: users(:david))
+  end
+
+  test "signed-out visitors see every published book, whatever tenant it belongs to" do
+    assert_equal [ books(:handbook), books(:manual) ].sort_by(&:id),
+      Book.accessable_or_published(user: nil).sort_by(&:id)
+  end
+
+  test "a user without a tenant sees nothing from a tenanted book" do
+    assert_nil users(:jz).tenant
+    assert_empty Book.accessable_or_published(user: users(:jz))
+  end
+
+  test "editable? is false across tenants, even for administrators" do
+    assert users(:david).administrator?
+
+    assert_not books(:handbook).editable?(user: users(:david))
+    assert books(:manual).editable?(user: users(:david))
+  end
+
+  test "accessable? is false across tenants" do
+    books(:manual).accesses.create!(user: users(:kevin), level: :reader)
+
+    assert_not books(:manual).accessable?(user: users(:kevin))
+    assert books(:handbook).accessable?(user: users(:kevin))
+  end
+
+  test "update_access ignores people from another tenant" do
+    books(:handbook).update_access(editors: [ users(:kevin).id, users(:david).id ], readers: [ users(:david).id ])
+
+    assert_equal [ users(:kevin).id ], books(:handbook).accesses.pluck(:user_id)
+  end
+
+  test "sharing with everyone only grants people in the book's own tenant" do
+    books(:handbook).update_access(editors: [], readers: [])
+
+    assert_equal [ users(:kevin).id ], books(:handbook).accesses.pluck(:user_id)
+  end
+end
