+require "test_helper"
+
+class MagicLinkMailerTest < ActionMailer::TestCase
+  test "sign-in code has the code in the subject and both parts" do
+    email = MagicLinkMailer.code(email_address: "kevin@example.com", code: "ABC234", purpose: "sign_in")
+
+    assert_equal "ABC234 is your Fizzy sign-in code", email.subject
+    assert_equal [ "kevin@example.com" ], email.to
+    assert_match "ABC234", email.html_part.body.encoded
+    assert_match "ABC234", email.text_part.body.encoded
+  end
+
+  test "sign-up code has its own subject" do
+    email = MagicLinkMailer.code(email_address: "new@example.com", code: "ABC234", purpose: "sign_up")
+
+    assert_equal "ABC234 is your Fizzy sign-up code", email.subject
+  end
+
+  test "join code names the account and the subject leads with the code" do
+    email = MagicLinkMailer.code(email_address: "new@example.com", code: "ABC234", purpose: "join", account_name: "37signals")
+
+    assert_equal "ABC234 is your code to join 37signals in Fizzy", email.subject
+    assert_match "37signals", email.text_part.body.encoded
+  end
+
+  test "says how long the code works" do
+    email = MagicLinkMailer.code(email_address: "kevin@example.com", code: "ABC234", purpose: "sign_in")
+
+    assert_match "15 minutes", email.text_part.body.encoded
+  end
+end
