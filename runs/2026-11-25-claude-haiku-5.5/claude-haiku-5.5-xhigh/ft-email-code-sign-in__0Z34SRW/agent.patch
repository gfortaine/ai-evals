+
+        assert_redirected_to new_session_magic_link_path
+      end
+    end
+
+    assert_equal "That code didn't work. Check it and try again.", flash[:alert]
+  end
+
+  test "create with an expired code does not sign in" do
+    request_sign_in_code
+    code = magic_link_code_from_email
+
+    travel 15.minutes + 1.second do
+      assert_no_difference -> { Session.count } do
+        untenanted do
+          post session_magic_link_path, params: { code: code }
+
+          assert_redirected_to new_session_path
+        end
+      end
+    end
+
+    assert_match "expired", flash[:alert]
+  end
+
+  test "a code can only be used once" do
+    request_sign_in_code
+    code = magic_link_code_from_email
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+    end
+
+    assert_no_difference -> { Session.count } do
+      untenanted do
+        post session_magic_link_path, params: { code: code }
+
+        assert_redirected_to new_session_path
+      end
+    end
+  end
+
+  test "too many wrong codes lock the code" do
+    request_sign_in_code
+    code = magic_link_code_from_email
+
+    assert_no_difference -> { Session.count } do
+      untenanted do
+        MagicLink::MAX_ATTEMPTS.times { post session_magic_link_path, params: { code: wrong_code } }
+        post session_magic_link_path, params: { code: code }
+      end
+    end
+  end
+
+  test "create for an email without an account does not sign in or create one" do
+    untenanted do
+      perform_enqueued_jobs { post session_path, params: { email_address: "nobody@example.com" } }
+    end
+    code = magic_link_code_from_email
+
+    assert_no_difference -> { Identity.count } do
+      assert_no_difference -> { Session.count } do
+        untenanted do
+          post session_magic_link_path, params: { code: code }
+
+          assert_redirected_to new_session_path
+        end
+      end
+    end
+
+    assert_equal "There's no Fizzy account for that email address.", flash[:alert]
+  end
+
+  test "create via JSON returns a session token" do
+    request_sign_in_code
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: magic_link_code_from_email }
+
+      assert_response :success
+      assert_equal cookies[:session_token], JSON.parse(response.body)["session_token"]
+    end
+  end
+
+  test "create via JSON with a wrong code is unauthorized" do
+    request_sign_in_code
+
+    assert_no_difference -> { Session.count } do
+      untenanted do
+        post session_magic_link_path(format: :json), params: { code: wrong_code }
+
+        assert_response :unauthorized
+      end
+    end
+  end
+
+  test "create via JSON without a pending sign-in is unauthorized" do
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "ABC234" }
+
+      assert_response :unauthorized
+    end
+  end
+
+  test "create is rate limited" do
+    request_sign_in_code
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post session_magic_link_path, params: { code: wrong_code }
+
+      assert_redirected_to new_session_path
+    end
+
+    assert_equal "Try again later.", flash[:alert]
+  end
+
+  private
+    def request_sign_in_code
+      untenanted do
+        perform_enqueued_jobs { post session_path, params: { email_address: @identity.email_address } }
+      end
+    end
+
+    # Same length and alphabet as a real code, but guaranteed to differ from it
+    def wrong_code
+      code = magic_link_code_from_email
+      (code.start_with?("A") ? "B" : "A") + code[1..]
+    end
+end
