+  test "create for a new email sends a join code without joining yet" do
+    assert_no_difference -> { Identity.count } do
+      assert_no_difference -> { User.count } do
+        untenanted do
+          perform_enqueued_jobs { post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "newcomer@example.com" } }
+
+          assert_redirected_to new_session_magic_link_path
+        end
+      end
+    end
+
+    assert_equal "#{magic_link_code_from_email} is your code to join 37signals in Fizzy", ActionMailer::Base.deliveries.last.subject
+    assert_equal 0, @join_code.reload.usage_count
+  end
+
+  test "joining with the code adds the identity to the account and continues to verification" do
+    untenanted do
+      perform_enqueued_jobs { post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "newcomer@example.com" } }
+
+      assert_difference -> { User.count }, +1 do
+        post session_magic_link_path, params: { code: magic_link_code_from_email }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert User.exists?(account: @account, identity: Identity.find_by!(email_address: "newcomer@example.com"))
+    assert_equal 1, @join_code.reload.usage_count
+  end
+
