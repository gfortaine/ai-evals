diff --git a/app/mailers/magic_link_mailer.rb b/app/mailers/magic_link_mailer.rb
new file mode 100644
index 0000000..3651310
--- /dev/null
+++ b/app/mailers/magic_link_mailer.rb
@@ -0,0 +1,25 @@
+class MagicLinkMailer < ApplicationMailer
+  def code(email_address:, code:, purpose:, account_name: nil)
+    @code = code
+    @intro = intro_for(purpose, account_name)
+
+    mail to: email_address, subject: subject_for(purpose, code, account_name)
+  end
+
+  private
+    def subject_for(purpose, code, account_name)
+      case purpose
+      when "sign_in" then "#{code} is your Fizzy sign-in code"
+      when "sign_up" then "#{code} is your Fizzy sign-up code"
+      when "join" then "#{code} is your code to join #{account_name} in Fizzy"
+      end
+    end
+
+    def intro_for(purpose, account_name)
+      case purpose
+      when "sign_in" then "Enter this code to sign in to Fizzy:"
+      when "sign_up" then "Enter this code to finish signing up for Fizzy:"
+      when "join" then "Enter this code to join #{account_name} in Fizzy:"
+      end
+    end
+end
