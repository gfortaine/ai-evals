diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..5c1b094
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @email_address = "newperson@example.com"
+  end
+
+  test "creates a six character code from the unambiguous alphabet" do
+    magic_link = MagicLink.create!(email_address: @email_address, purpose: :sign_in)
+
+    assert_equal MagicLink::CODE_LENGTH, magic_link.code.length
+    assert_match(/\A[#{MagicLink::CODE_ALPHABET}]{6}\z/, magic_link.code)
+    assert_no_match(/[01OI]/, magic_link.code)
+  end
+
+  test "stores only a digest of the code" do
+    magic_link = MagicLink.create!(email_address: @email_address, purpose: :sign_in)
+
+    assert_not_equal magic_link.code, magic_link.code_digest
+    assert_equal MagicLink.digest(magic_link.code), magic_link.code_digest
+    assert_not_includes magic_link.reload.attributes.values, magic_link.code
+  end
+
+  test "emails the code in the subject" do
+    assert_emails 1 do
+      @magic_link = MagicLink.create!(email_address: @email_address, purpose: :sign_in)
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @email_address ], email.to
+    assert_equal "#{@magic_link.code} is your Fizzy sign-in code", email.subject
+  end
+
+  test "does not email when the link is invalid" do
+    assert_no_emails do
+      magic_link = MagicLink.create(email_address: "not-an-email", purpose: :sign_in)
+
+      assert_not magic_link.persisted?
+    end
+  end
+
+  test "a join link needs a join code" do
+    magic_link = MagicLink.create(email_address: @email_address, purpose: :join)
+
+    assert_not magic_link.persisted?
+    assert magic_link.errors.of_kind?(:join_code, :blank)
+  end
+
+  test "redeem accepts the right code once, in any case and ignoring spaces and dashes" do
+    magic_link = MagicLink.create!(email_address: @email_address, purpose: :sign_in)
+    typed = magic_link.code.downcase.scan(/./).join(" ")
+
+    assert magic_link.redeem(typed)
+    assert_not magic_link.active?
+    assert_not magic_link.redeem(magic_link.code), "a code can only be used once"
+  end
+
+  test "a wrong code is rejected and counts as an attempt" do
+    magic_link = MagicLink.create!(email_address: @email_address, purpose: :sign_in)
+
+    assert_not magic_link.redeem("ZZZZZZ")
+    assert_equal 1, magic_link.reload.attempts
+    assert magic_link.active?
+  end
+
+  test "the code stops working after too many wrong attempts, even when given correctly" do
+    magic_link = MagicLink.create!(email_address: @email_address, purpose: :sign_in)
+
+    MagicLink::MAX_ATTEMPTS.times { assert_not magic_link.redeem("ZZZZZZ") }
+
+    assert_not magic_link.active?
+    assert_not magic_link.redeem(magic_link.code)
+  end
+
+  test "a code works for fifteen minutes" do
+    magic_link = MagicLink.create!(email_address: @email_address, purpose: :sign_in)
+
+    travel 14.minutes do
+      assert magic_link.redeem(magic_link.code)
+    end
+
+    magic_link = MagicLink.create!(email_address: @email_address, purpose: :sign_in)
+
+    travel 15.minutes + 1.second do
+      assert_not magic_link.active?
+      assert_not magic_link.redeem(magic_link.code)
+    end
+  end
+
+  test "a sign-up link stops working once signups are closed" do
+    magic_link = MagicLink.create!(email_address: @email_address, purpose: :sign_up)
+    assert magic_link.active?
+
+    with_multi_tenant_mode(false) do
+      assert_not magic_link.active?
+      assert_not magic_link.redeem(magic_link.code)
+    end
+  end
+
+  test "a join link stops working once its join code is used up" do
+    join_code = account_join_codes(:"37s")
+    magic_link = MagicLink.create!(email_address: @email_address, purpose: :join, join_code: join_code)
+
+    join_code.update!(usage_count: join_code.usage_limit)
+
+    assert_not magic_link.active?
+    assert_not magic_link.redeem(magic_link.code)
+  end
+
+  test "the pending authentication token finds the link until it expires" do
+    magic_link = MagicLink.create!(email_address: @email_address, purpose: :sign_in)
+    token = magic_link.pending_authentication_token
+
+    assert_equal magic_link, MagicLink.find_by_pending_authentication_token(token)
+    assert_nil MagicLink.find_by_pending_authentication_token("tampered-token")
+    assert_nil MagicLink.find_by_pending_authentication_token(nil)
+
+    travel 15.minutes + 1.second do
+      assert_nil MagicLink.find_by_pending_authentication_token(token)
+    end
+  end
+
+  test "sign-in only finds an existing identity, while sign-up and join create one" do
+    assert_nil MagicLink.create!(email_address: @email_address, purpose: :sign_in).identity
+
+    assert_difference -> { Identity.count }, +1 do
+      MagicLink.create!(email_address: @email_address, purpose: :sign_up).identity
+    end
+
+    assert_equal identities(:kevin), MagicLink.create!(email_address: identities(:kevin).email_address, purpose: :sign_in).identity
+  end
+
+  test "cleanup removes expired links only" do
+    expired = MagicLink.create!(email_address: @email_address, purpose: :sign_in)
+    current = MagicLink.create!(email_address: @email_address, purpose: :sign_in)
+
+    travel 16.minutes do
+      current.update_columns(expires_at: 1.hour.from_now)
+      MagicLink.cleanup
+    end
+
+    assert_not MagicLink.exists?(expired.id)
+    assert MagicLink.exists?(current.id)
+  end
+end
