diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..efd475c
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,99 @@
+class MagicLink < ApplicationRecord
+  # Leaves out 0, 1, I and O so codes are hard to misread when typed from an email.
+  CODE_ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  MAX_ATTEMPTS = 5
+  PENDING_AUTHENTICATION_PURPOSE = :pending_authentication
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  enum :purpose, %w[ sign_in sign_up join ].index_by(&:itself), validate: true, scopes: false
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :join_code, presence: true, if: :join?
+
+  before_create :generate_code, :set_expiration
+  after_create_commit :deliver_code_later
+
+  # The plain code only exists on the instance that was just created. Only its digest is stored.
+  attr_reader :code
+
+  def self.find_by_pending_authentication_token(token)
+    find_signed(token, purpose: PENDING_AUTHENTICATION_PURPOSE)
+  end
+
+  def self.digest(code)
+    key = Rails.application.key_generator.generate_key("magic link codes")
+    OpenSSL::HMAC.hexdigest("SHA256", key, code.to_s.upcase.gsub(/[^A-Z0-9]/, ""))
+  end
+
+  def self.cleanup
+    where(expires_at: ...Time.current).delete_all
+  end
+
+  def pending_authentication_token
+    signed_id(purpose: PENDING_AUTHENTICATION_PURPOSE, expires_in: EXPIRATION)
+  end
+
+  def active?
+    consumed_at.nil? && attempts < MAX_ATTEMPTS && expires_at.future? && purpose_still_allowed?
+  end
+
+  def redeem(code)
+    with_lock do
+      if !active?
+        false
+      elsif matches?(code)
+        update!(consumed_at: Time.current)
+        true
+      else
+        increment!(:attempts)
+        false
+      end
+    end
+  end
+
+  def identity
+    if sign_in?
+      Identity.find_by(email_address: email_address)
+    else
+      Identity.find_or_create_by!(email_address: email_address)
+    end
+  end
+
+  private
+    def generate_code
+      @code = Array.new(CODE_LENGTH) { CODE_ALPHABET[SecureRandom.random_number(CODE_ALPHABET.length)] }.join
+      self.code_digest = self.class.digest(@code)
+    end
+
+    def set_expiration
+      self.expires_at = EXPIRATION.from_now
+    end
+
+    def matches?(code)
+      ActiveSupport::SecurityUtils.secure_compare(self.class.digest(code), code_digest)
+    end
+
+    def purpose_still_allowed?
+      if join?
+        join_code.present? && join_code.active?
+      elsif sign_up?
+        Account.accepting_signups?
+      else
+        true
+      end
+    end
+
+    def deliver_code_later
+      MagicLinkMailer.code(
+        email_address: email_address,
+        code: code,
+        purpose: purpose,
+        account_name: join_code&.account&.name
+      ).deliver_later
+    end
+end
