+      end
+    end
+
+    assert cookies[:session_token].present?
+    assert_not cookies[:pending_authentication_token].present?
+  end
+
+  test "create accepts the code in lower case and with spaces" do
+    request_sign_in_code
+    typed = magic_link_code_from_email.downcase.scan(/./).join(" ")
+
+    assert_difference -> { @identity.sessions.count }, +1 do
+      untenanted do
+        post session_magic_link_path, params: { code: typed }
+
+        assert_redirected_to landing_url
+      end
+    end
+  end
+
+  test "create with a wrong code does not sign in" do
+    request_sign_in_code
+
+    assert_no_difference -> { Session.count } do
