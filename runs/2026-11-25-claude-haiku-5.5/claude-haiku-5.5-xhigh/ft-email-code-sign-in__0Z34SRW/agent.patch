diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..f641872
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,117 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+  before_action :set_magic_link
+
+  layout "public"
+
+  helper_method :start_over_path
+
+  def new
+  end
+
+  def create
+    if @magic_link.redeem(params.expect(:code))
+      clear_pending_authentication
+
+      if identity = @magic_link.identity
+        if @magic_link.join?
+          join_and_sign_in identity
+        else
+          sign_in_and_redirect identity, sign_in_redirect_url
+        end
+      else
+        no_account_for_email
+      end
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def set_magic_link
+      @magic_link = MagicLink.find_by_pending_authentication_token(cookies[:pending_authentication_token])
+
+      unless @magic_link&.active?
+        clear_pending_authentication
+        expired_code
+      end
+    end
+
+    def sign_in_redirect_url
+      if @magic_link.sign_up?
+        new_signup_completion_path
+      else
+        after_authentication_url
+      end
+    end
+
+    def join_and_sign_in(identity)
+      join_code = @magic_link.join_code
+      join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: join_code.account, identity: identity)
+
+      if user.setup?
+        sign_in_and_redirect identity, landing_url(script_name: join_code.account.slug)
+      else
+        sign_in_and_redirect identity, new_users_verification_url(script_name: join_code.account.slug)
+      end
+    end
+
+    def sign_in_and_redirect(identity, redirect_url)
+      terminate_session if Current.session
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to redirect_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def start_over_path
+      if @magic_link&.sign_up?
+        new_signup_path(script_name: nil)
+      elsif @magic_link&.join? && @magic_link.join_code
+        join_path(code: @magic_link.join_code.code, script_name: @magic_link.join_code.account.slug)
+      else
+        new_session_path(script_name: nil)
+      end
+    end
+
+    def invalid_code
+      message = "That code didn't work. Check it and try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def expired_code
+      message = "That code has expired. Get a new one to keep going."
+
+      respond_to do |format|
+        format.html { redirect_to start_over_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def no_account_for_email
+      message = "There's no Fizzy account for that email address."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
