diff --git a/app/views/sessions/magic_links/new.html.erb b/app/views/sessions/magic_links/new.html.erb
new file mode 100644
index 0000000..98d23ab
--- /dev/null
+++ b/app/views/sessions/magic_links/new.html.erb
@@ -0,0 +1,32 @@
+<% if @magic_link.join? %>
+  <% @page_title = "Join #{@magic_link.join_code.account.name} in Fizzy" %>
+<% else %>
+  <% @page_title = "Enter your code" %>
+<% end %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= text_field_tag :code, nil, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, placeholder: "Enter your code…" %>
+      </label>
+    </div>
+
+    <p>We emailed a six-character code to <strong><%= @magic_link.email_address %></strong>. It works for <%= distance_of_time_in_words_to_now(MagicLink::EXPIRATION.from_now) %>.</p>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-medium center margin-block-start">
+    <%= link_to "Use a different email address", start_over_path, class: "txt-link" %>
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
