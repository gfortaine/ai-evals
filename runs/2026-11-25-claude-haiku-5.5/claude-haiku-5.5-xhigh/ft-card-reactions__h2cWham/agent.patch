diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
index 7f1dd39..59df048 100644
--- a/test/models/reaction_test.rb
+++ b/test/models/reaction_test.rb
@@ -10,4 +10,37 @@ class ReactionTest < ActiveSupport::TestCase
       comments(:logo_1).reactions.create!(content: "Nice!")
     end
   end
+
+  test "creating a card reaction touches the card activity" do
+    assert_changes -> { cards(:logo).reload.last_active_at } do
+      cards(:logo).reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "reacting to a card touches the card so its column preview is refreshed" do
+    assert_changes -> { cards(:logo).reload.updated_at } do
+      cards(:logo).reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "card reactions and comment reactions are kept apart" do
+    card_reaction = cards(:logo).reactions.create!(content: "Nice!")
+    comment_reaction = comments(:logo_1).reactions.create!(content: "Nice!")
+
+    assert_equal card_reaction.reactable, cards(:logo)
+    assert_equal comment_reaction.reactable, comments(:logo_1)
+    assert_equal [ card_reaction ], cards(:logo).reactions.to_a.select { |reaction| reaction.reactable_type == "Card" }
+    assert_not_includes cards(:logo).reactions, comment_reaction
+    assert_equal cards(:logo), card_reaction.card
+    assert_equal cards(:logo), comment_reaction.card
+  end
+
+  test "destroying a card destroys its reactions" do
+    card = cards(:logo)
+    reaction = card.reactions.create!(content: "Nice!")
+
+    card.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
 end
diff --git a/test/system/card_reactions_test.rb b/test/system/card_reactions_test.rb
new file mode 100644
index 0000000..8a22e5a
--- /dev/null
+++ b/test/system/card_reactions_test.rb
@@ -0,0 +1,47 @@
+require "application_system_test_case"
+
+class CardReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:logo)
+  end
+
+  test "react to a card from its detail view" do
+    visit card_url(@card)
+
+    within "turbo-frame##{dom_id(@card, :reacting)}" do
+      find(".reactions__trigger").click
+      find("input[aria-label='Add a reaction']").set("🎉")
+      click_button "Submit"
+
+      assert_selector ".reaction", text: "🎉"
+    end
+
+    assert_equal 1, @card.reactions.where(reacter: users(:david), content: "🎉").count
+  end
+
+  test "column previews show the boost count after reacting" do
+    @card.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    visit board_column_url(@card.board, @card.column)
+
+    assert_selector "##{dom_id(@card, :article)} .card__boosts strong", text: "1"
+  end
+
+  test "delete a card reaction you made" do
+    reaction = @card.reactions.create!(content: "🎉", reacter: users(:david))
+
+    visit card_url(@card)
+
+    within "turbo-frame##{dom_id(@card, :reacting)}" do
+      find("##{dom_id(reaction)} [data-reaction-delete-target='content']").click
+      click_button "Delete this reaction"
+
+      assert_no_selector "##{dom_id(reaction)}"
+    end
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
