+  def down
+    add_reference :reactions, :comment, type: :uuid, null: true
+
+    execute "UPDATE reactions SET comment_id = reactable_id WHERE reactable_type = 'Comment'"
+
+    # Card reactions have no comment to attach to, so they can't survive a rollback.
+    execute "DELETE FROM reactions WHERE reactable_type <> 'Comment'"
+
+    change_column_null :reactions, :comment_id, false
+
+    remove_reference :reactions, :reactable, type: :uuid, polymorphic: true
+  end
