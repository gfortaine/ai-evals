+++ b/app/models/reaction.rb
@@ -0,0 +1,34 @@
+class Reaction < ApplicationRecord
+  EMOJI_ONLY = /\A(?:\p{Extended_Pictographic}|\p{Emoji_Modifier}|\p{Regional_Indicator}|\u200D|\uFE0F|\u20E3)+\z/
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  normalizes :content, with: -> { it.strip }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { preload(reacter: :account) }
+
+  after_create_commit :broadcast_append
+  after_destroy_commit :broadcast_remove, unless: :destroyed_by_association
+
+  def to_partial_path
+    "cards/comments/#{super}"
+  end
+
+  def emoji_only?
+    content.match?(EMOJI_ONLY)
+  end
+
+  private
+    def broadcast_append
+      broadcast_append_to comment.card, target: ActionView::RecordIdentifier.dom_id(comment, :reactions_list)
+    end
+
+    def broadcast_remove
+      broadcast_remove_to comment.card
+    end
+end
