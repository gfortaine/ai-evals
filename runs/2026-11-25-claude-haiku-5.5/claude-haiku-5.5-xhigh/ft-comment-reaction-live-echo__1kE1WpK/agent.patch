diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..0bcf464
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,137 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal @comment.reactions.count, @response.parsed_body.count
+    assert_equal reactions(:logo_agreement_kevin_thumbs_up).id, @response.parsed_body.first["id"]
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal users(:kevin), @comment.reactions.chronologically.last.reacter
+  end
+
+  test "create appends the new reaction to the comment's reactions list" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+
+    assert_select "turbo-stream[action=append][target=?]", dom_id(@comment, :reactions_list) do
+      assert_select ".reaction", text: /🎉/
+    end
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    reaction = @comment.reactions.chronologically.last
+    assert_response :created
+    assert_equal card_comment_reaction_path(@card, @comment, reaction, format: :json), @response.headers["Location"]
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal "Great 👍", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+  end
+
+  test "create with flat JSON params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "Flat" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Flat", @comment.reactions.chronologically.last.content
+  end
+
+  test "create rejects blank content" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "   " } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create rejects content longer than 16 characters" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create on a card that does not accept comments is forbidden" do
+    @card.update_column :status, Card.statuses[:drafted]
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Nice" } }, as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy own reaction" do
+    reaction = reactions(:logo_agreement_kevin_agreed)
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action=remove][target=?]", dom_id(reaction)
+  end
+
+  test "destroy another user's reaction is forbidden" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy as JSON" do
+    reaction = reactions(:logo_agreement_kevin_agreed)
+
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "a new reaction shows on the next visit even though the comment is cached" do
+    with_actionview_partial_caching do
+      with_fragment_caching do
+        get card_path(@card)
+        assert_select "##{dom_id(@comment, :reactions_list)} .reaction", count: 2
+
+        @comment.reactions.create!(content: "Fresh", reacter: users(:jz))
+
+        get card_path(@card)
+        assert_select "##{dom_id(@comment, :reactions_list)} .reaction", count: 3
+      end
+    end
+  end
+
+  test "the card page shows each reaction and the add control" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions_list)} .reaction", count: @comment.reactions.count
+    assert_select "##{dom_id(@comment, :reactions_list)} .reaction[data-creator-id=?]", users(:jz).id.to_s
+    assert_select ".reactions__trigger", minimum: 1
+  end
+end
