diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..71d34ad
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "content is stripped of surrounding whitespace" do
+    reaction = @comment.reactions.create!(content: "  Nice  ", reacter: users(:jz))
+
+    assert_equal "Nice", reaction.content
+  end
+
+  test "content is required" do
+    reaction = @comment.reactions.new(content: "   ", reacter: users(:jz))
+
+    assert_not reaction.valid?
+    assert reaction.errors.of_kind?(:content, :blank)
+  end
+
+  test "content can be up to 16 characters" do
+    assert @comment.reactions.new(content: "a" * 16, reacter: users(:jz)).valid?
+    assert_not @comment.reactions.new(content: "a" * 17, reacter: users(:jz)).valid?
+  end
+
+  test "reacter defaults to the current user" do
+    Current.user = users(:jz)
+
+    assert_equal users(:jz), @comment.reactions.create!(content: "Nice").reacter
+  end
+
+  test "emoji_only? is true only when the content is nothing but emoji" do
+    assert build_reaction("👍").emoji_only?
+    assert build_reaction("❤️").emoji_only?
+    assert build_reaction("👨‍👩‍👧").emoji_only?
+    assert build_reaction("👍🏽").emoji_only?
+
+    assert_not build_reaction("Great 👍").emoji_only?
+    assert_not build_reaction("ok").emoji_only?
+  end
+
+  test "creating a reaction broadcasts it into the comment's reactions list" do
+    broadcasts = capture_turbo_stream_broadcasts(cards(:logo)) do
+      @comment.reactions.create!(content: "Nice", reacter: users(:jz))
+    end
+
+    assert_equal 1, broadcasts.size
+    assert_equal "append", broadcasts.first["action"]
+    assert_equal ActionView::RecordIdentifier.dom_id(@comment, :reactions_list), broadcasts.first["target"]
+    assert_includes broadcasts.first.to_s, "Nice"
+  end
+
+  test "destroying a reaction broadcasts its removal" do
+    reaction = reactions(:logo_agreement_kevin_agreed)
+
+    broadcasts = capture_turbo_stream_broadcasts(cards(:logo)) do
+      reaction.destroy!
+    end
+
+    assert_equal 1, broadcasts.size
+    assert_equal "remove", broadcasts.first["action"]
+    assert_equal ActionView::RecordIdentifier.dom_id(reaction), broadcasts.first["target"]
+  end
+
+  test "destroying a comment does not broadcast a removal for each of its reactions" do
+    assert_no_turbo_stream_broadcasts(cards(:logo)) do
+      @comment.destroy!
+    end
+  end
+
+  test "adding a reaction touches its comment so cached comment markup is refreshed" do
+    assert_changes -> { @comment.reload.updated_at } do
+      @comment.reactions.create!(content: "Nice", reacter: users(:jz))
+    end
+  end
+
+  test "destroying a user destroys the reactions they left on other people's comments" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+    kept = reactions(:logo_agreement_kevin_agreed)
+
+    assert_difference -> { Reaction.count }, -1 do
+      users(:jz).destroy!
+    end
+
+    assert_not Reaction.exists?(reaction.id)
+    assert Reaction.exists?(kept.id)
+  end
+
+  private
+    def build_reaction(content)
+      @comment.reactions.new(content: content, reacter: users(:jz))
+    end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..a23a05e
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,146 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    Current.user = users(:kevin)
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+    visit card_url(@card)
+  end
+
+  test "confirming a reaction puts it in the strip, removes the input, and brings the add button back" do
+    open_reaction_input
+    find("input.reaction__input").set("Nice work")
+    find("input.reaction__input").send_keys(:enter)
+
+    within_strip do
+      assert_selector ".reaction", text: "Nice work"
+      assert_no_selector "input.reaction__input"
+      assert_selector "button.reactions__trigger", visible: true
+    end
+  end
+
+  test "pressing enter twice posts only one reaction" do
+    open_reaction_input
+    find("input.reaction__input").send_keys("Double", :enter, :enter)
+
+    within_strip do
+      assert_selector ".reaction", text: "Double"
+      assert_no_selector "input.reaction__input"
+    end
+    assert_equal 1, Reaction.where(comment: @comment, content: "Double").count
+  end
+
+  test "the confirm button stays disabled until there is something to submit" do
+    open_reaction_input
+
+    within_strip do
+      find("input.reaction__input").set("   ")
+      assert_selector "button.reaction__submit-btn[disabled]"
+
+      find("input.reaction__input").set("ok")
+      assert_no_selector "button.reaction__submit-btn[disabled]"
+    end
+  end
+
+  test "cancel removes the input and brings the add button back without adding a reaction" do
+    open_reaction_input
+
+    within_strip do
+      find("button.reaction__cancel-btn").click
+
+      assert_no_selector "input.reaction__input"
+      assert_selector "button.reactions__trigger", visible: true
+      assert_no_selector ".reaction", text: "Nice"
+    end
+  end
+
+  test "escape cancels the input" do
+    open_reaction_input
+    find("input.reaction__input").send_keys(:escape)
+
+    within_strip do
+      assert_no_selector "input.reaction__input"
+      assert_selector "button.reactions__trigger", visible: true
+    end
+  end
+
+  test "a reaction left elsewhere shows up live without a reload" do
+    wait_for_cable_subscriptions
+    page.execute_script("window.__noReload = true")
+
+    Reaction.create!(comment: @comment, reacter: users(:jz), content: "On it")
+
+    within_strip do
+      assert_selector ".reaction", text: "On it", wait: 5
+    end
+    assert page.evaluate_script("window.__noReload === true")
+  end
+
+  test "a reaction removed elsewhere disappears live" do
+    wait_for_cable_subscriptions
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+
+    within_strip { assert_selector "##{dom_id(reaction)}" }
+    reaction.destroy!
+
+    assert_no_selector "##{dom_id(reaction)}", wait: 5
+  end
+
+  test "an input in progress survives a page refresh broadcast from elsewhere" do
+    wait_for_cable_subscriptions
+    open_reaction_input
+    find("input.reaction__input").set("Half-written")
+
+    @card.update!(title: "Retitled elsewhere")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_selector "h1", text: "Retitled elsewhere", wait: 5
+    within_strip do
+      assert_selector "input.reaction__input"
+      assert_equal "Half-written", find("input.reaction__input").value
+    end
+  end
+
+  test "clicking your own reaction reveals a way to remove it" do
+    own = find_reaction(reactions(:logo_agreement_kevin_agreed))
+    assert_no_selector "##{dom_id(reactions(:logo_agreement_kevin_agreed))} .reaction__delete", visible: true
+
+    own.click
+    assert_selector "##{dom_id(reactions(:logo_agreement_kevin_agreed))} .reaction__delete", visible: true
+
+    own.find(".reaction__delete").click
+    assert_no_selector "##{dom_id(reactions(:logo_agreement_kevin_agreed))}", wait: 5
+  end
+
+  test "other people's reactions can't be expanded to reveal a remove control" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+    find_reaction(reaction).click
+
+    assert_no_selector "##{dom_id(reaction)} .reaction__delete", visible: true
+    assert_no_selector "##{dom_id(reaction)}.expanded"
+  end
+
+  private
+    def within_strip(&block)
+      within "##{dom_id(@comment)} .reactions", &block
+    end
+
+    def open_reaction_input
+      within_strip { find("button.reactions__trigger").click }
+      assert_selector "input.reaction__input"
+    end
+
+    def find_reaction(reaction)
+      find("##{dom_id(reaction)}")
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
diff --git a/test/test_helpers/caching_test_helper.rb b/test/test_helpers/caching_test_helper.rb
index 90dab64..98fd2b3 100644
--- a/test/test_helpers/caching_test_helper.rb
+++ b/test/test_helpers/caching_test_helper.rb
@@ -11,4 +11,19 @@ module CachingTestHelper
       ApplicationController.perform_caching = was_perform_caching
     end
   end
+
+  # Fragment caching (<% cache %>) reads the controller's cache store, which is
+  # :null_store in tests. Swap in a real store so cached fragments actually persist.
+  def with_fragment_caching
+    was_cache_store = ActionController::Base.cache_store
+    was_perform_caching = ActionController::Base.perform_caching
+    begin
+      ActionController::Base.cache_store = ActiveSupport::Cache.lookup_store(:memory_store)
+      ActionController::Base.perform_caching = true
+      yield
+    ensure
+      ActionController::Base.cache_store = was_cache_store
+      ActionController::Base.perform_caching = was_perform_caching
+    end
+  end
 end
