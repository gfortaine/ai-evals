diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..9d46eb9
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  class Interrupted < StandardError; end
+
+  setup do
+    @originals = {}
+    Leaf.order(:id).each_with_index do |leaf, index|
+      # Titles that legitimately open with a quoted phrase, wrapped the way the legacy exporter did.
+      @originals[leaf.id] = %("Quoted" phrase #{index + 1})
+      leaf.update!(title: %("#{@originals[leaf.id]}"))
+    end
+    @wrapped = @originals.transform_values { |original| %("#{original}") }
+  end
+
+  test "strips the exporter's wrapper once and keeps inner quotes" do
+    TitleCleanupJob.perform_now
+
+    assert_equal @originals, titles
+  end
+
+  test "running again after completion changes nothing" do
+    TitleCleanupJob.perform_now
+    TitleCleanupJob.perform_now
+
+    assert_equal @originals, titles
+  end
+
+  test "an interrupted run resumes at the leaf it was on" do
+    ids = Leaf.order(:id).pluck(:id)
+
+    cleaned = []
+    assert_raises(Interrupted) { job_recording(cleaned, interrupt_after: 2).perform_now }
+    assert_equal ids.first(2), cleaned
+
+    resumed = []
+    job_recording(resumed).perform_now
+    assert_equal ids.drop(2), resumed
+    assert_equal @originals, titles
+  end
+
+  test "a title is only saved together with its progress" do
+    ids = Leaf.order(:id).pluck(:id)
+
+    # The second leaf's title is written, then saving its progress fails: a crash at that point.
+    # This happens inside a caller's transaction, which must not keep the title on its own.
+    Leaf.transaction do
+      with_progress_save_failing_for(ids.second) do
+        assert_raises(ActiveRecord::StatementInvalid) { TitleCleanupJob.perform_now }
+      end
+    end
+    assert_equal @wrapped.merge(ids.first => @originals[ids.first]), titles
+
+    TitleCleanupJob.perform_now
+    assert_equal @originals, titles
+  end
+
+  test "an overlapping run never cleans a leaf the cursor has already passed" do
+    ids = Leaf.order(:id).pluck(:id)
+    job = TitleCleanupJob.new
+    job.define_singleton_method(:clean) do |leaf|
+      # Another run finishes the whole collection after this run has loaded its batch.
+      TitleCleanupCursor.current.update!(leaf_id: ids.last)
+      super(leaf)
+    end
+
+    job.perform_now
+
+    assert_equal @wrapped, titles
+    assert_equal ids.last, TitleCleanupCursor.current.leaf_id
+  end
+
+  private
+    def titles
+      Leaf.pluck(:id, :title).to_h
+    end
+
+    # A job that records each leaf it cleans, and raises Interrupted before cleaning the next
+    # leaf once `interrupt_after` leaves have been cleaned.
+    def job_recording(cleaned, interrupt_after: nil)
+      TitleCleanupJob.new.tap do |job|
+        job.define_singleton_method(:clean) do |leaf|
+          raise Interrupted if cleaned.size == interrupt_after
+          cleaned << leaf.id
+          super(leaf)
+        end
+      end
+    end
+
+    def with_progress_save_failing_for(leaf_id)
+      ActiveRecord::Base.connection.execute <<~SQL
+        CREATE TRIGGER fail_title_cleanup_progress BEFORE UPDATE ON title_cleanup_cursors
+        WHEN NEW.leaf_id = #{Integer(leaf_id)}
+        BEGIN SELECT RAISE(ABORT, 'interrupted'); END
+      SQL
+      yield
+    ensure
+      ActiveRecord::Base.connection.execute "DROP TRIGGER IF EXISTS fail_title_cleanup_progress"
+    end
+end
