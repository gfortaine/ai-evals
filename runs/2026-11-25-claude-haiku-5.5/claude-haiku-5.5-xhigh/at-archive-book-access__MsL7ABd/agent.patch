diff --git a/app/models/book.rb b/app/models/book.rb
index 64a02da..8bcf9d1 100644
--- a/app/models/book.rb
+++ b/app/models/book.rb
@@ -4,7 +4,10 @@ class Book < ApplicationRecord
   has_many :leaves, dependent: :destroy
   has_one_attached :cover, dependent: :purge_later
 
-  before_destroy :archive_access_list
+  # Must run before the dependent destroy of accesses (declared in Book::Accessable),
+  # so the grants can still be read. The archive itself is written once the book is gone.
+  before_destroy :capture_access_list, prepend: true
+  after_destroy :archive_access_list
 
   scope :ordered, -> { order(:title) }
   scope :published, -> { where(published: true) }
@@ -20,15 +23,13 @@ class Book < ApplicationRecord
   end
 
   private
-    def archive_access_list
-      accesses.each do |access|
-        AccessArchive.create!(
-          book_id: id,
-          book_title: title,
-          user_id: access.user_id,
-          user_name: access.user.name,
-          level: access.level
-        )
+    def capture_access_list
+      @archivable_accesses = Access.where(book_id: id).includes(:user).map do |access|
+        { book_id: id, book_title: title, user_id: access.user_id, user_name: access.user.name, level: access.level }
       end
     end
+
+    def archive_access_list
+      Array(@archivable_accesses).each { |attributes| AccessArchive.create!(attributes) }
+    end
 end
diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..ae59b6d 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,19 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy removes the book and archives everyone who had access" do
+    book = books(:handbook)
+    expected = book.accesses.includes(:user).map { |access| [ access.user_id, access.user.name, access.level ] }
+
+    assert_difference -> { Book.count }, -1 do
+      assert_difference -> { AccessArchive.where(book_id: book.id).count }, expected.size do
+        delete book_path(book)
+      end
+    end
+
+    assert_redirected_to root_url
+    archived = AccessArchive.where(book_id: book.id).map { |row| [ row.user_id, row.user_name, row.level ] }
+    assert_equal expected.sort, archived.sort
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..382417e 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,55 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroying a book archives one row per person who had access" do
+    book = books(:handbook)
+    expected = book.accesses.includes(:user).map { |access| [ access.user_id, access.user.name, access.level ] }
+
+    assert_difference -> { AccessArchive.count }, expected.size do
+      book.destroy!
+    end
+
+    archived = AccessArchive.where(book_id: book.id).map { |row| [ row.user_id, row.user_name, row.level ] }
+    assert_equal expected.sort, archived.sort
+    assert_equal [ "Handbook" ], AccessArchive.where(book_id: book.id).distinct.pluck(:book_title)
+  end
+
+  test "destroying a book does not archive access that was revoked earlier" do
+    book = books(:handbook)
+    book.update!(everyone_access: false)
+    book.update_access(editors: [ users(:david).id ], readers: [ users(:jz).id ])
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.update_access(editors: [ users(:david).id ], readers: [ users(:jz).id ])
+    end
+
+    book.destroy!
+
+    archived = AccessArchive.where(book_id: book.id).map { |row| [ row.user_id, row.level ] }
+    assert_equal [ [ users(:david).id, "editor" ], [ users(:jz).id, "reader" ] ].sort, archived.sort
+  end
+
+  test "destroying a book nobody had access to archives nothing" do
+    book = books(:handbook)
+    book.accesses.delete_all
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+
+    assert_nil Book.find_by(id: book.id)
+  end
+
+  test "destroying a book from the console removes its grants and archives them" do
+    book = books(:manual)
+    grants = book.accesses.count
+
+    assert_difference -> { AccessArchive.where(book_id: book.id).count }, grants do
+      Book.find(book.id).destroy
+    end
+
+    assert_equal 0, Access.where(book_id: book.id).count
+    assert_nil Book.find_by(id: book.id)
+  end
 end
