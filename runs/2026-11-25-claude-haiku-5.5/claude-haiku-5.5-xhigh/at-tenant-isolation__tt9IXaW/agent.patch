@@ -0,0 +1,48 @@
+class CreateTenants < ActiveRecord::Migration[8.2]
+  # Lightweight models so this migration doesn't depend on the app's models.
+  class TenantRecord < ActiveRecord::Base
+    self.table_name = "tenants"
+  end
+
+  class UserRecord < ActiveRecord::Base
+    self.table_name = "users"
+  end
+
+  class BookRecord < ActiveRecord::Base
+    self.table_name = "books"
+  end
+
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    sweep_existing_rows_into_one_tenant
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+
+    drop_table :tenants
+  end
+
+  private
+    # Existing installs are a single customer: everyone and every book that
+    # predates tenants belongs to one tenant, so they keep working unchanged.
+    # A brand-new install has nothing to sweep and stays untenanted.
+    def sweep_existing_rows_into_one_tenant
+      return unless UserRecord.exists? || BookRecord.exists?
+
+      name = select_value("SELECT name FROM accounts LIMIT 1").presence || "Writebook"
+      tenant = TenantRecord.create!(name: name)
+
+      UserRecord.update_all(tenant_id: tenant.id)
+      BookRecord.update_all(tenant_id: tenant.id)
+    end
+end
