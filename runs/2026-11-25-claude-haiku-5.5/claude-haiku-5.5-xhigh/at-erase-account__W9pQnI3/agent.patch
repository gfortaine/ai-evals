+++ b/test/tasks/users_erase_task_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+require "rake"
+
+class UsersEraseTaskTest < ActiveSupport::TestCase
+  setup do
+    Rails.application.load_tasks unless Rake::Task.task_defined?("users:erase")
+  end
+
+  teardown do
+    ENV.delete("EMAIL")
+    ENV.delete("ID")
+  end
+
+  test "erases an account removed the old way by the address it signed in with" do
+    kevin = users(:kevin)
+    kevin.update!(active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com")
+    ENV["EMAIL"] = "kevin@example.com"
+
+    capture_io { run_task }
+
+    assert_not User.exists?(kevin.id)
+  end
+
+  test "refuses when the address matches more than one account, and ID picks one" do
+    kevin = users(:kevin)
+    kevin.update!(active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com")
+    lookalike = User.create!(name: "Kevin Again", email_address: "kevin@example.com", password: "secret123456")
+    ENV["EMAIL"] = "kevin@example.com"
+
+    _, err = capture_io do
+      assert_raises(SystemExit) { run_task }
+    end
+    assert_match "More than one account matches", err
+    assert User.exists?(kevin.id)
+    assert User.exists?(lookalike.id)
+
+    ENV.delete("EMAIL")
+    ENV["ID"] = kevin.id.to_s
+    capture_io { run_task }
+
+    assert_not User.exists?(kevin.id)
+    assert User.exists?(lookalike.id)
+  end
+
+  test "requires an address or an id" do
+    assert_raises(SystemExit) { capture_io { run_task } }
+  end
+
+  private
+    def run_task
+      Rake::Task["users:erase"].execute
+    end
+end
