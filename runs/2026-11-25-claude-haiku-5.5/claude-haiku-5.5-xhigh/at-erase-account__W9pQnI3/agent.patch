diff --git a/test/models/user/erasure_test.rb b/test/models/user/erasure_test.rb
new file mode 100644
index 0000000..d9b5bc0
--- /dev/null
+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,178 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+  end
+
+  test "erase removes the account" do
+    @kevin.erase
+
+    assert_not User.exists?(@kevin.id)
+  end
+
+  test "erase removes sessions, access grants and reading marks" do
+    @kevin.sessions.create!(user_agent: "test", ip_address: "127.0.0.1")
+    ReadingMark.remember(leaves(:welcome_page), user: @kevin)
+    ReadingMark.remember(leaves(:welcome_page), user: users(:david))
+    assert @kevin.accesses.any?
+
+    @kevin.erase
+
+    assert_not Session.exists?(user_id: @kevin.id)
+    assert_not Access.exists?(user_id: @kevin.id)
+    assert_not ReadingMark.exists?(user_id: @kevin.id)
+    assert ReadingMark.exists?(user_id: users(:david).id), "other people's reading marks are kept"
+    assert Access.exists?(user_id: users(:david).id), "other people's access is kept"
+  end
+
+  test "erase leaves no sign-in events for the address" do
+    @kevin.sessions.create!(user_agent: "test", ip_address: "127.0.0.1")
+    SignInEvent.create!(action: :signed_out, email_address: @kevin.email_address, ip_address: "127.0.0.1", user_agent: "test")
+    SignInEvent.create!(action: :signed_in, email_address: users(:david).email_address, ip_address: "127.0.0.1", user_agent: "test")
+
+    @kevin.erase
+
+    assert_not SignInEvent.exists?(email_address: "kevin@example.com")
+    assert SignInEvent.exists?(email_address: users(:david).email_address)
+  end
+
+  test "erase keeps books they created that are shared with everyone, with a generic byline" do
+    book = Book.create!(title: "Public book", author: "Kevin K", everyone_access: true, creator: @kevin)
+    leaf = book.press(Page.new(body: "public words"), title: "Public page")
+    before = book.updated_at
+
+    travel 1.minute do
+      @kevin.erase
+    end
+
+    book.reload
+    assert_nil book.creator_id
+    assert_equal "Deleted author", book.author
+    assert book.updated_at > before, "byline change must bust cached book fragments"
+    assert Leaf.exists?(leaf.id)
+    assert_includes Leaf.search("public"), leaf
+  end
+
+  test "erase destroys books they created that aren't shared with everyone, with their content" do
+    book = Book.create!(title: "Private book", everyone_access: false, creator: @kevin)
+    leaf = book.press(Page.new(body: "secret words"), title: "Secret page")
+    leaf.edit leafable_params: { body: "changed secret words" }
+    page_ids = [ leaf.leafable_id, leaf.edits.last.leafable_id ]
+    leaf_id = leaf.id
+    assert_includes Leaf.search("secret"), leaf
+
+    @kevin.erase
+
+    assert_not Book.exists?(book.id)
+    assert_not Leaf.exists?(leaf_id)
+    assert_empty Page.where(id: page_ids), "current and old versions of the page are gone"
+    assert_empty ActionText::Markdown.where(record_type: "Page", record_id: page_ids)
+    assert_equal 0, search_index_rows(leaf_id)
+    assert_empty Leaf.search("secret")
+  end
+
+  test "erase destroys a private book's reading marks and other people's access to it" do
+    book = Book.create!(title: "Private book", everyone_access: false, creator: @kevin)
+    leaf = book.press(Page.new(body: "words"), title: "Page")
+    book.update_access(editors: [], readers: [ users(:david).id ])
+    ReadingMark.remember(leaf, user: users(:david))
+
+    @kevin.erase
+
+    assert_not Access.exists?(book_id: book.id)
+    assert_not ReadingMark.exists?(leaf_id: leaf.id)
+  end
+
+  test "erase doesn't touch books other people created" do
+    assert_no_difference -> { Book.count } do
+      users(:kevin).erase
+    end
+
+    assert_equal "Handbook", books(:handbook).reload.title
+    assert_nil books(:handbook).creator_id
+    assert Access.exists?(user_id: users(:david).id, book_id: books(:handbook).id)
+  end
+
+  test "an account removed the old way can be erased by the address it signed in with" do
+    @kevin.update!(active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com")
+    SignInEvent.create!(action: :signed_in, email_address: "kevin@example.com", ip_address: "127.0.0.1", user_agent: "test")
+    SignInEvent.create!(action: :signed_in, email_address: users(:david).email_address, ip_address: "127.0.0.1", user_agent: "test")
+
+    assert_equal [ @kevin ], User.with_sign_in_address("kevin@example.com").to_a
+
+    @kevin.erase
+
+    assert_not User.exists?(@kevin.id)
+    assert_not SignInEvent.exists?(email_address: "kevin@example.com")
+    assert SignInEvent.exists?(email_address: users(:david).email_address)
+  end
+
+  test "an account removed the old way keeps its books and erases its private content" do
+    @kevin.update!(active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com")
+    book = Book.create!(title: "Private book", everyone_access: false, creator: @kevin)
+    book.press(Page.new(body: "secret"), title: "Page")
+
+    @kevin.erase
+
+    assert_not Book.exists?(book.id)
+  end
+
+  test "with_sign_in_address finds an active account by its current address" do
+    assert_equal [ users(:david) ], User.with_sign_in_address("david@example.com").to_a
+  end
+
+  test "with_sign_in_address only matches the exact original address of a removed account" do
+    @kevin.update!(active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com")
+
+    assert_empty User.with_sign_in_address("kevin@example.co")
+    assert_empty User.with_sign_in_address("kevin@example.com.au")
+    assert_empty User.with_sign_in_address("kevin-deactivated@example.com")
+    assert_equal [ @kevin ], User.with_sign_in_address("kevin@example.com").to_a
+  end
+
+  test "sign_in_addresses includes the address signed in with for removed accounts" do
+    @kevin.update!(active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com")
+
+    assert_equal [ @kevin.email_address, "kevin@example.com" ], @kevin.sign_in_addresses
+  end
+
+  private
+    def search_index_rows(leaf_id)
+      ActiveRecord::Base.connection.select_value("select count(*) from leaf_search_index where rowid = #{leaf_id.to_i}")
+    end
+end
+
+class User::ErasureAsAdminTest < ActiveSupport::TestCase
+  test "erasing someone as an admin doesn't make the admin the creator of their shared books" do
+    kevin = users(:kevin)
+    book = Book.create!(title: "Public book", author: "Kevin K", everyone_access: true, creator: kevin)
+
+    Current.set(user: users(:david)) do
+      kevin.erase
+    end
+
+    book.reload
+    assert_nil book.creator_id
+    assert_equal "Deleted author", book.author
+  end
+end
+
+class User::ErasureFilesTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "erase purges the files of pictures in books they created, including old versions sharing them" do
+    book = Book.create!(title: "Private book", everyone_access: false, creator: users(:kevin))
+    leaf = book.press(Picture.new(caption: "pic"), title: "Pic")
+    leaf.picture.image.attach(io: file_fixture("pixel.bmp").open, filename: "pixel.bmp", content_type: "image/bmp")
+    leaf.edit leafable_params: { caption: "changed" }
+    blob = leaf.picture.image.blob
+    key = blob.key
+    assert_equal 2, blob.attachments.count
+
+    perform_enqueued_jobs { users(:kevin).erase }
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Blob.service.exist?(key)
+  end
+end
