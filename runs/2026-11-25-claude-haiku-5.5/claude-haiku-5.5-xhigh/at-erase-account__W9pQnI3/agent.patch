diff --git a/lib/tasks/users.rake b/lib/tasks/users.rake
new file mode 100644
index 0000000..b72b079
--- /dev/null
+++ b/lib/tasks/users.rake
@@ -0,0 +1,23 @@
+namespace :users do
+  desc "Permanently erase a person and everything of theirs (EMAIL=address they signed in with, or ID=)"
+  task erase: :environment do
+    candidates = if ENV["ID"].present?
+      User.where(id: ENV["ID"])
+    elsif ENV["EMAIL"].present?
+      User.with_sign_in_address(ENV["EMAIL"])
+    else
+      abort "Pass EMAIL=<the address they signed in with> or ID=<user id>"
+    end
+
+    abort "No account found" if candidates.none?
+
+    if candidates.many?
+      listing = candidates.map { |user| "ID=#{user.id} #{user.email_address} (#{user.active? ? "active" : "removed"})" }
+      abort "More than one account matches; re-run with one of:\n  #{listing.join("\n  ")}"
+    end
+
+    user = candidates.first
+    user.erase
+    puts "Erased user ID=#{user.id}"
+  end
+end
