diff --git a/test/models/card/bursting_test.rb b/test/models/card/bursting_test.rb
new file mode 100644
index 0000000..373c383
--- /dev/null
+++ b/test/models/card/bursting_test.rb
@@ -0,0 +1,176 @@
+require "test_helper"
+
+class Card::BurstingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    # writebook has a 90-day auto-close period, so its burst window is 30 days.
+    @board = boards(:writebook)
+    @card = @board.cards.create!(creator: users(:david), status: "published", title: "Burst candidate")
+  end
+
+  test "three comments from two people within a third of the auto-close period burst the card" do
+    freeze_time
+
+    comment_on @card, users(:david), at: 3.days.ago
+    comment_on @card, users(:kevin), at: 2.days.ago
+    assert_not @card.reload.bursted?
+
+    comment_on @card, users(:david), at: 1.day.ago
+    assert @card.reload.bursted?
+  end
+
+  test "comments from a single person do not burst the card" do
+    freeze_time
+
+    3.times { |i| comment_on @card, users(:david), at: (i + 1).days.ago }
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "fewer than three comments do not burst the card" do
+    freeze_time
+
+    comment_on @card, users(:david), at: 2.days.ago
+    comment_on @card, users(:kevin), at: 1.day.ago
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "comments spread beyond a third of the auto-close period do not burst the card" do
+    freeze_time
+    window = @board.auto_postpone_period / 3
+
+    comment_on @card, users(:david), at: (window * 1.2).seconds.ago
+    comment_on @card, users(:kevin), at: (window * 0.6).seconds.ago
+    comment_on @card, users(:david), at: Time.current
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "the burst window follows the board's auto-close period" do
+    freeze_time
+    entropies(:writebook_board).update! auto_postpone_period: 3.days
+
+    comment_on @card, users(:david), at: 2.days.ago
+    comment_on @card, users(:kevin), at: 1.day.ago
+    comment_on @card, users(:david), at: Time.current
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "system comments do not count toward a burst" do
+    freeze_time
+
+    comment_on @card, users(:system), at: 2.hours.ago
+    comment_on @card, users(:system), at: 1.hour.ago
+    comment_on @card, users(:david), at: Time.current
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "assigning someone bursts the card" do
+    assert_not @card.bursted?
+
+    @card.toggle_assignment(users(:jz))
+
+    assert @card.reload.bursted?
+  end
+
+  test "reopening a card bursts it" do
+    card = cards(:shipping)
+    assert card.closed?
+
+    card.reopen
+
+    assert card.reload.bursted?
+  end
+
+  test "the first burst is kept" do
+    freeze_time
+    @card.toggle_assignment(users(:jz))
+    first_burst_at = @card.reload.burst_at
+
+    travel_to 1.day.from_now
+    @card.toggle_assignment(users(:kevin))
+
+    assert_equal first_burst_at, @card.reload.burst_at
+  end
+
+  test "a bursted card with no activity for two weeks is stalled" do
+    burst_with_comments @card
+
+    travel_to 13.days.from_now
+    assert_not @card.reload.stalled?
+
+    travel_to 14.days.from_now
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "activity on a stalled card resets the stall" do
+    burst_with_comments @card
+    travel_to 15.days.from_now
+    assert @card.reload.stalled?
+
+    comment_on @card, users(:kevin), at: Time.current
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel_to 13.days.from_now
+    assert_not @card.reload.stalled?
+  end
+
+  test "a card that never bursted is not stalled" do
+    travel_to 3.weeks.from_now
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "closed and postponed cards are not stalled" do
+    closed_card = boards(:writebook).cards.create!(creator: users(:david), status: "published", title: "Closed")
+    burst_with_comments closed_card
+    closed_card.close
+
+    postponed_card = boards(:writebook).cards.create!(creator: users(:david), status: "published", title: "Postponed")
+    burst_with_comments postponed_card
+    postponed_card.postpone
+
+    travel_to 15.days.from_now
+
+    assert_not closed_card.reload.stalled?
+    assert_not postponed_card.reload.stalled?
+    assert_not_includes Card.stalled, closed_card
+    assert_not_includes Card.stalled, postponed_card
+  end
+
+  test "the cache version changes when a card goes stalled" do
+    burst_with_comments @card
+    before = @card.cache_key_with_version
+
+    travel_to 15.days.from_now
+
+    assert_not_equal before, @card.reload.cache_key_with_version
+  end
+
+  test "indexed_by stalled lists the stalled cards" do
+    burst_with_comments @card
+    travel_to 15.days.from_now
+
+    assert_equal Card.stalled.to_a, Card.indexed_by("stalled").to_a
+    assert_includes Card.indexed_by("stalled"), @card
+  end
+
+  private
+    def comment_on(card, creator, at:)
+      card.comments.create!(creator: creator, body: "Hello", created_at: at)
+    end
+
+    def burst_with_comments(card)
+      comment_on card, users(:david), at: 2.days.ago
+      comment_on card, users(:kevin), at: 1.day.ago
+      comment_on card, users(:david), at: Time.current
+      card.reload
+    end
+end
