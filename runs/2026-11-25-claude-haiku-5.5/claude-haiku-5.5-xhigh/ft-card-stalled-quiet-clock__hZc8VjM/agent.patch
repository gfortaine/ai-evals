diff --git a/app/models/card/bursting.rb b/app/models/card/bursting.rb
new file mode 100644
index 0000000..89d4cef
--- /dev/null
+++ b/app/models/card/bursting.rb
@@ -0,0 +1,50 @@
+module Card::Bursting
+  extend ActiveSupport::Concern
+
+  BURST_MIN_COMMENTS = 3
+  BURST_MIN_PEOPLE = 2
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :bursted, -> { where.not(burst_at: nil) }
+    scope :stalled, -> { active.bursted.where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def bursted?
+    burst_at.present?
+  end
+
+  def stalled?
+    bursted? && last_active_at <= STALLED_AFTER.ago && active?
+  end
+
+  def record_burst
+    update!(burst_at: Time.current) unless bursted?
+  end
+
+  def record_comment_burst(comment)
+    if !bursted? && comments_burst?(comment.created_at)
+      record_burst
+    end
+  end
+
+  # Stalling is driven by the passage of time, which doesn't touch the card.
+  # Including it in the cache version keeps cached renderings from going stale.
+  def cache_version
+    "#{super}-#{stalled?}"
+  end
+
+  private
+    # Whether some window, a third of the board's auto-close period long, holds
+    # enough comments from enough people. A window that includes the new comment
+    # lies within one window length of it, so only those comments are loaded.
+    def comments_burst?(at)
+      window = auto_postpone_period / 3.0
+      recent = comments.by_user.where(created_at: (at - window)..(at + window)).order(:created_at).pluck(:created_at, :creator_id)
+
+      recent.any? do |(started_at, _)|
+        burst = recent.select { |(created_at, _)| created_at.between?(started_at, started_at + window) }
+        burst.size >= BURST_MIN_COMMENTS && burst.map(&:last).uniq.size >= BURST_MIN_PEOPLE
+      end
+    end
+end
