diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..cdbb9f3
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,51 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  # #deactivate rewrites alice@example.com to alice-deactivated-<uuid>@example.com.
+  # This matches that inserted part, so the original address can be recovered.
+  DEACTIVATED_ADDRESS_SUFFIX = /-deactivated-\h{8}-\h{4}-\h{4}-\h{4}-\h{12}(?=@)/
+
+  class_methods do
+    # Every account that has used +email_address+, either as its current address or
+    # as the address it was rewritten from on deactivation. Sign-in events are keyed
+    # by the address people signed in with, so this is how a request by address
+    # finds all of them.
+    def for_email_address(email_address)
+      local, domain = email_address.to_s.split("@", 2)
+      return [] unless domain
+
+      where(email_address: email_address)
+        .or(where("email_address LIKE ?", "#{local}-deactivated-%@#{domain}"))
+        .select { it.erasure_addresses.include?(email_address) }
+    end
+  end
+
+  def original_email_address
+    email_address.sub(DEACTIVATED_ADDRESS_SUFFIX, "")
+  end
+
+  def erasure_addresses
+    [ email_address, original_email_address ].uniq
+  end
+
+  # Permanently removes this person, whether or not they were deactivated.
+  #
+  # Books they created that are shared with everyone stay, with their name taken
+  # off. Any other book they created is erased along with its content.
+  def erase
+    transaction do
+      created_books.with_everyone_access.each do |book|
+        book.update! creator: nil, author: Book::DELETED_AUTHOR
+      end
+      created_books.where(everyone_access: false).each(&:erase)
+
+      # Sessions go in bulk: destroying each one would write a signed-out event under
+      # the address being erased. The sign-in log is cleared after that, and before
+      # destroy!, so nothing is written under the address once erase has run.
+      sessions.delete_all
+      SignInEvent.for_address(erasure_addresses).delete_all
+
+      destroy!
+    end
+  end
+end
diff --git a/script/admin/erase-user b/script/admin/erase-user
new file mode 100755
index 0000000..1638594
--- /dev/null
+++ b/script/admin/erase-user
@@ -0,0 +1,18 @@
+#!/usr/bin/env ruby
+require File.expand_path("../../config/environment", File.dirname(__FILE__))
+
+abort "Usage: #{$0} <email-address>" unless ARGV.length == 1
+
+# Matches accounts by current address and by the original address of accounts
+# that were deactivated (their address is rewritten, see User#deactivate).
+users = User.for_email_address(ARGV.first)
+
+if users.empty?
+  puts "User not found"
+  exit -1
+end
+
+users.each do |user|
+  user.erase
+  puts "Erased user #{user.id}"
+end
