@@ -16,4 +18,24 @@ class Book < ApplicationRecord
   def markable
     leaves.active.positioned.map { it.leafable.markable }.join("\n\n")
   end
+
+  # Destroys the book with all of its content. Leaf only destroys the current
+  # version of each page, so superseded revisions (kept in edits) are destroyed
+  # here as well, and search index entries are removed by leaf id.
+  def erase
+    transaction do
+      leaf_ids = leaves.ids
+      leafables = leaves.pluck(:leafable_type, :leafable_id) |
+        Edit.where(leaf_id: leaf_ids).pluck(:leafable_type, :leafable_id)
+
+      Leaf.delete_from_search_index(leaf_ids)
+      leaves.destroy_all
+
+      leafables.uniq.group_by(&:first).each do |type, pairs|
+        type.constantize.where(id: pairs.map(&:last)).destroy_all
+      end
+
+      destroy!
+    end
+  end
 end
