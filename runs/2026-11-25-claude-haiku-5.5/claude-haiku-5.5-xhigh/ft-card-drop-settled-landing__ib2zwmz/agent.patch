diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..dcc0058
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,229 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { destroy, post } from "@rails/request.js"
+
+const DESTINATION = "[data-drag-and-drop-destination]"
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+const DESKTOP = window.matchMedia("(min-width: 640px)") // Drag and drop is not offered on small screens
+
+// Lists of active cards (awaiting triage or in a column, so neither postponed nor closed).
+// The server lists these golden-first.
+const ACTIVE_DESTINATIONS = [ "column", "maybe" ]
+
+export default class extends Controller {
+  #observer
+  #dragged = null
+  #origin = null
+  #hovered = null
+  #saves = new WeakMap()
+
+  connect() {
+    this.#observer = new MutationObserver(() => this.#makeCardsDraggable())
+    this.#observer.observe(this.element, { childList: true, subtree: true, attributes: true, attributeFilter: [ "draggable" ] })
+    DESKTOP.addEventListener("change", this.#makeCardsDraggable)
+    this.#makeCardsDraggable()
+  }
+
+  disconnect() {
+    this.#observer.disconnect()
+    DESKTOP.removeEventListener("change", this.#makeCardsDraggable)
+    this.#endDrag()
+  }
+
+  dragStart(event) {
+    const card = event.target.closest(".card")
+
+    if (card?.closest(DESTINATION) && DESKTOP.matches) {
+      this.#startDrag(card, event)
+    }
+  }
+
+  dragOver(event) {
+    const destination = this.#destinationAt(event)
+
+    if (destination) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    this.#highlight(destination)
+  }
+
+  dragLeave(event) {
+    if (this.#hovered && !this.#isWithin(this.#hovered, event)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const destination = this.#destinationAt(event)
+
+    if (destination) {
+      event.preventDefault()
+      this.#moveCard(this.#dragged, destination)
+    }
+
+    this.#endDrag()
+  }
+
+  dragEnd(event) {
+    if (this.#dragged && event.dataTransfer.dropEffect === "none") this.#ignoreNextClick()
+    this.#endDrag()
+  }
+
+  // Private
+
+  // Cards can only be dragged where drag and drop is offered, so the attribute follows the screen size
+  #makeCardsDraggable = () => {
+    this.element.querySelectorAll(`${DESTINATION} .card`).forEach(card => {
+      if (card.draggable !== DESKTOP.matches) card.draggable = DESKTOP.matches
+    })
+  }
+
+  #startDrag(card, event) {
+    const { left, top } = card.getBoundingClientRect()
+
+    this.#dragged = card
+    this.#origin = card.closest(DESTINATION)
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id) // Firefox won't start a drag without some data
+    event.dataTransfer.setDragImage(card, event.clientX - left, event.clientY - top)
+
+    // Style after the browser has captured the drag image, so the image isn't dimmed
+    requestAnimationFrame(() => {
+      if (this.#dragged === card) card.classList.add(DRAGGED_CLASS)
+    })
+  }
+
+  #endDrag() {
+    this.#dragged?.classList.remove(DRAGGED_CLASS)
+    this.#dragged = null
+    this.#origin = null
+    this.#highlight(null)
+  }
+
+  // Dropping a card back into the list it came from isn't a move, so that list isn't a destination
+  #destinationAt(event) {
+    const section = event.target.closest(DESTINATION)
+
+    if (this.#dragged && section && section !== this.#origin && section.querySelector(".cards__list")) {
+      return section
+    } else {
+      return null
+    }
+  }
+
+  // A drag that nothing accepts is still released with a click on the link it started from, which
+  // would open the card. Ignore that click, up until the next press of the mouse.
+  #ignoreNextClick() {
+    const ignore = event => {
+      event.preventDefault()
+      event.stopPropagation()
+      forget()
+    }
+    const forget = () => {
+      window.removeEventListener("click", ignore, true)
+      window.removeEventListener("mousedown", forget, true)
+    }
+
+    window.addEventListener("click", ignore, true)
+    window.addEventListener("mousedown", forget, true)
+  }
+
+  #highlight(section) {
+    if (section !== this.#hovered) {
+      this.#hovered?.classList.remove(HOVER_CLASS)
+      section?.classList.add(HOVER_CLASS)
+      this.#hovered = section
+    }
+  }
+
+  #isWithin(section, { clientX, clientY }) {
+    const { left, right, top, bottom } = section.getBoundingClientRect()
+
+    return clientX >= left && clientX <= right && clientY >= top && clientY <= bottom
+  }
+
+  // The board changes straight away. The save follows in the background.
+  #moveCard(card, destination) {
+    const kind = destination.dataset.dragAndDropDestination
+    const isActive = ACTIVE_DESTINATIONS.includes(kind)
+
+    this.#adjustCount(this.#origin, -1)
+    this.#adjustCount(destination, 1)
+    this.#placeCard(card, destination.querySelector(".cards__list"), isActive)
+
+    card.classList.toggle("card--active", isActive)
+    card.classList.toggle("card--postponed", kind === "not-now")
+    if (destination.dataset.dragAndDropCardColor) {
+      card.style.setProperty("--card-color", destination.dataset.dragAndDropCardColor)
+    }
+
+    this.#save(card, destination)
+  }
+
+  // Put the card where the server will list it. The server lists the most recently active card first,
+  // but in golden-first lists a card that isn't golden goes after the golden cards.
+  #placeCard(card, list, goldenFirst) {
+    const cards = [ ...list.querySelectorAll(".card") ]
+    const lastGolden = goldenFirst && !card.classList.contains("golden-effect")
+      ? cards.findLast(item => item.classList.contains("golden-effect"))
+      : null
+
+    if (lastGolden) {
+      lastGolden.after(card)
+    } else if (cards.length > 0) {
+      cards[0].before(card)
+    } else {
+      list.append(card)
+    }
+  }
+
+  #adjustCount(section, delta) {
+    const counter = section.querySelector(".cards__expander-count")
+
+    if (counter && !counter.textContent.includes("+")) {
+      const count = Number(counter.textContent) + delta
+      counter.textContent = count > 99 ? "99+" : count
+    }
+  }
+
+  // Saves for a card run one after another, so a quick second drag can't overtake the first
+  #save(card, destination) {
+    const previous = this.#saves.get(card) ?? Promise.resolve()
+    const save = previous.then(() => this.#send(card, destination))
+
+    this.#saves.set(card, save.catch(() => {}))
+    save.catch(() => this.#resync())
+  }
+
+  async #send(card, destination) {
+    const response = await this.#requestFor(card, destination)
+
+    if (!response.ok) {
+      throw new Error(`Could not move card ${card.id}: ${response.statusCode}`)
+    }
+  }
+
+  #requestFor(card, destination) {
+    const options = { responseKind: "json" }
+
+    switch (destination.dataset.dragAndDropDestination) {
+      case "column":
+        return post(card.dataset.cardTriageUrl, { ...options, query: { column_id: destination.dataset.dragAndDropColumnId } })
+      case "maybe":
+        return destroy(card.dataset.cardTriageUrl, options)
+      case "not-now":
+        return post(card.dataset.cardNotNowUrl, options)
+      case "done":
+        return post(card.dataset.cardClosureUrl, options)
+    }
+  }
+
+  // When a save fails the board may no longer match the server, so reload it from the server
+  #resync() {
+    Turbo.visit(window.location.href, { action: "replace" })
+  }
+}
