diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..a1b8920
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "index as JSON lists reactions oldest first" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal @comment.reactions.map(&:id), @response.parsed_body.map { it["id"] }
+    assert_equal "👍", @response.parsed_body.first["content"]
+    assert_equal card_comment_reaction_url(@card, @comment, reactions(:logo_agreement_kevin_thumbs_up_jz)),
+      @response.parsed_body.first["url"]
+  end
+
+  test "index as turbo stream refreshes the reaction list" do
+    get card_comment_reactions_path(@card, @comment), as: :turbo_stream
+
+    assert_response :success
+    assert_includes @response.body, %(target="#{dom_id(@comment, :reaction_list)}")
+    assert_includes @response.body, "Agreed"
+  end
+
+  test "create adds the reaction to the list and clears the composer" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal users(:kevin), Reaction.last.reacter
+    assert_includes @response.body, %(target="#{dom_id(@comment, :reaction_list)}")
+    assert_includes @response.body, %(action="remove" target="#{dom_id(@comment, :new_reaction)}")
+  end
+
+  test "create with content that is too long re-renders the composer with the error" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+    assert_includes @response.body, %(action="replace" target="#{dom_id(@comment, :new_reaction)}")
+    assert_includes @response.body, "too long"
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Nice" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal card_comment_reaction_path(@card, @comment, Reaction.last, format: :json), @response.headers["Location"]
+    assert_equal "Nice", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "Flat" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Flat", Reaction.last.content
+  end
+
+  test "create as JSON with invalid content" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+    assert @response.parsed_body["content"].present?
+  end
+
+  test "create on a comment of a card that no longer accepts comments is forbidden" do
+    @card.update!(status: :drafted)
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy removes your own reaction" do
+    reaction = reactions(:logo_agreement_kevin_fire_kevin)
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_includes @response.body, %(action="remove" target="#{dom_id(reaction)}")
+  end
+
+  test "destroy as JSON removes your own reaction" do
+    reaction = reactions(:logo_agreement_kevin_fire_kevin)
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction, format: :json)
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy someone else's reaction is forbidden" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up_jz)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "reacting on a card you cannot access is not found" do
+    @card.board.update!(all_access: false)
+    @card.board.accesses.where(user: users(:jz)).delete_all
+    logout_and_sign_in_as :jz
+
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+
+    assert_response :not_found
+  end
+end
