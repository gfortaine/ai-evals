new file mode 100644
index 0000000..c62b918
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "creating a reaction defaults the reacter to the current user" do
+    reaction = @comment.reactions.create!(content: "👀")
+
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal @comment.card.account, reaction.account
+  end
+
+  test "content is required" do
+    reaction = @comment.reactions.build(content: "")
+
+    assert_not reaction.valid?
+    assert reaction.errors.of_kind?(:content, :blank)
+  end
+
+  test "whitespace around content is stripped and whitespace-only content is blank" do
+    assert_equal "Nice", @comment.reactions.create!(content: "  Nice  ").content
+
+    assert_not @comment.reactions.build(content: "   ").valid?
+  end
+
+  test "content may be up to 16 characters" do
+    assert @comment.reactions.build(content: "a" * 16).valid?
+    assert_not @comment.reactions.build(content: "a" * 17).valid?
+  end
+
+  test "emoji-only content is detected" do
+    assert Reaction.new(content: "👍").emoji_only?
+    assert Reaction.new(content: "👍👍").emoji_only?
+    assert Reaction.new(content: "❤️").emoji_only?
+    assert Reaction.new(content: "🇺🇸").emoji_only?
+    assert Reaction.new(content: "👨‍👩‍👧").emoji_only?
+    assert_not Reaction.new(content: "Agreed").emoji_only?
+    assert_not Reaction.new(content: "👍 nice").emoji_only?
+  end
+
+  test "reactions are listed oldest first on the comment" do
+    contents = comments(:logo_agreement_kevin).reactions.map(&:content)
+
+    assert_equal [ "👍", "Agreed", "🔥" ], contents
+  end
+
+  test "creating a reaction touches its comment so cached comment markup is rebuilt" do
+    assert_changes -> { @comment.reload.updated_at } do
+      @comment.reactions.create!(content: "🎉")
+    end
+  end
+
+  test "creating a reaction refreshes the card for everyone viewing it" do
+    assert_turbo_stream_broadcasts [ @comment.card ] do
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob do
+        @comment.reactions.create!(content: "🎉")
+      end
+    end
+  end
+
+  test "destroying a comment destroys its reactions" do
+    assert_difference -> { Reaction.count }, -comments(:logo_agreement_kevin).reactions.count do
+      comments(:logo_agreement_kevin).destroy!
+    end
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..d7f66cb
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,157 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "adding a reaction puts it in the strip and brings the button back" do
+    visit card_url(@card)
+
+    within_comment do
+      find(".reactions__trigger").click
+      assert_no_selector ".reactions__trigger"
+      fill_in "Reaction", with: "Ship it 🚀"
+      click_on "Add reaction"
+
+      assert_selector ".reaction", text: "Ship it 🚀"
+      assert_no_selector "input.reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+  end
+
+  test "cancelling discards the reaction and brings the button back" do
+    visit card_url(@card)
+
+    within_comment do
+      find(".reactions__trigger").click
+      fill_in "Reaction", with: "Never mind"
+      click_on "Cancel"
+
+      assert_no_selector "input.reaction__input"
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction", text: "Never mind"
+    end
+  end
+
+  test "escape cancels the input" do
+    visit card_url(@card)
+
+    within_comment do
+      find(".reactions__trigger").click
+      find("input.reaction__input").send_keys("Never mind", :escape)
+
+      assert_no_selector "input.reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+  end
+
+  test "a reaction longer than 16 characters is rejected in the composer" do
+    visit card_url(@card)
+
+    within_comment do
+      find(".reactions__trigger").click
+      fill_in "Reaction", with: "a" * 17
+      click_on "Add reaction"
+
+      assert_selector "[role=alert]", text: "too long"
+      assert_field "Reaction", with: "a" * 17
+      assert_no_selector ".reaction", text: "aaaaaaaaaaaaaaaaa"
+    end
+  end
+
+  test "you can remove your own reaction but not someone else's" do
+    visit card_url(@card)
+    own = reactions(:logo_agreement_kevin_fire_kevin)
+    theirs = reactions(:logo_agreement_kevin_thumbs_up_jz)
+
+    within_comment do
+      find("##{dom_id(theirs)}").click
+      assert_no_button "Remove reaction"
+
+      find("##{dom_id(own)}").click
+      find("##{dom_id(own)} .reaction__delete button").click
+
+      assert_no_selector "##{dom_id(own)}"
+      assert_selector "##{dom_id(theirs)}"
+    end
+  end
+
+  test "reactions added elsewhere appear without reloading" do
+    visit card_url(@card)
+    assert_selector ".reaction", text: "Agreed"
+
+    update_comment_elsewhere { @comment.reactions.create!(content: "Ship it", reacter: users(:jz)) }
+
+    within_comment { assert_selector ".reaction", text: "Ship it", wait: 5 }
+  end
+
+  test "your own reaction is not duplicated and stays removable after a refresh" do
+    visit card_url(@card)
+
+    within_comment do
+      find(".reactions__trigger").click
+      fill_in "Reaction", with: "Mine"
+      click_on "Add reaction"
+      assert_selector ".reaction", text: "Mine"
+    end
+
+    update_comment_elsewhere { @comment.reactions.create!(content: "Ship it", reacter: users(:jz)) }
+
+    within_comment do
+      assert_selector ".reaction", text: "Ship it", wait: 5
+      assert_selector ".reaction", text: "Mine", count: 1
+      assert_selector ".reaction--deleteable", text: "Mine"
+
+      find(".reaction", text: "Mine").click
+      assert_selector ".reaction.expanded", text: "Mine"
+      assert_button "Remove reaction"
+    end
+  end
+
+  test "a reaction being typed survives a refresh and the list catches up when it ends" do
+    visit card_url(@card)
+
+    within_comment do
+      find(".reactions__trigger").click
+      fill_in "Reaction", with: "Half typed"
+    end
+
+    update_comment_elsewhere do
+      @comment.reactions.create!(content: "Ship it", reacter: users(:jz))
+      @card.comments.create!(body: "Posted elsewhere", creator: users(:jz))
+    end
+
+    # The refresh has been applied once the other comment shows up
+    assert_text "Posted elsewhere", wait: 5
+
+    within_comment do
+      assert_field "Reaction", with: "Half typed"
+      assert_no_selector ".reaction", text: "Ship it"
+
+      click_on "Cancel"
+      assert_selector ".reaction", text: "Ship it", wait: 5
+    end
+  end
+
+  private
+    def within_comment(&block)
+      within "##{dom_id(@comment)}", &block
+    end
+
+    def update_comment_elsewhere(&block)
+      wait_for_cable_subscriptions
+      block.call
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
