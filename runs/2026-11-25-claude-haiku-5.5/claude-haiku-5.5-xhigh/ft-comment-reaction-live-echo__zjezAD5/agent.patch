+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,61 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reacter, only: :destroy
+  before_action :ensure_card_is_commentable, only: :create
+
+  def index
+    respond_to do |format|
+      format.turbo_stream
+      format.json
+    end
+  end
+
+  def create
+    @reaction = @comment.reactions.create(reaction_params)
+
+    respond_to do |format|
+      if @reaction.persisted?
+        format.turbo_stream
+        format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+      else
+        format.turbo_stream { render :create, status: :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..6c470a9
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,42 @@
+import { Controller } from "@hotwired/stimulus"
+
+// A single reaction. Only the person who left it can expand it to remove it.
+// Everyone else sees a plain pill. Ownership is decided here rather than in the
+// markup because comments are cached and shared between viewers.
+export default class extends Controller {
+  static values = { reacterId: String }
+
+  connect() {
+    if (this.#isOwnReaction) {
+      this.element.classList.add("reaction--deleteable")
+    }
+  }
+
+  // Morphs replace the class list with the server's, which would drop the
+  // classes managed here, so keep them through a refresh.
+  keepClasses(event) {
+    if (event.detail?.attributeName === "class") {
+      event.preventDefault()
+    }
+  }
+
+  toggle(event) {
+    if (!this.#isOwnReaction || event.target.closest(".reaction__delete")) return
+
+    this.element.classList.toggle("expanded")
+  }
+
+  deleting() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  deleteFinished(event) {
+    if (!event.detail.success) {
+      this.element.classList.remove("reaction--deleting")
+    }
+  }
+
+  get #isOwnReaction() {
+    return this.reacterIdValue === Current.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..26da333
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,41 @@
+import { Controller } from "@hotwired/stimulus"
+import { get } from "@rails/request.js"
+
+// Adds a reaction to one comment. The trigger button turns into a small input
+// while composing, and goes back once that input is gone.
+export default class extends Controller {
+  static targets = [ "trigger", "template", "form" ]
+  static values = { refreshUrl: String }
+
+  open() {
+    this.triggerTarget.before(this.templateTarget.content.cloneNode(true))
+  }
+
+  close() {
+    this.formTargets.forEach(form => form.remove())
+    this.#refresh()
+  }
+
+  formTargetConnected(form) {
+    this.#syncTrigger()
+    form.querySelector("input")?.focus()
+  }
+
+  formTargetDisconnected() {
+    this.#syncTrigger()
+
+    if (!this.hasFormTarget) {
+      this.triggerTarget.focus()
+    }
+  }
+
+  #syncTrigger() {
+    this.triggerTarget.hidden = this.hasFormTarget
+  }
+
+  // The card page holds back live refreshes while a reaction is being typed,
+  // so fetch the current list once composing ends.
+  async #refresh() {
+    await get(this.refreshUrlValue, { responseKind: "turbo-stream" })
+  }
+}
