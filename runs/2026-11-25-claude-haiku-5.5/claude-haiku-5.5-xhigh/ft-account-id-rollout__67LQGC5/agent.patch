diff --git a/test/models/tenant_tables_test.rb b/test/models/tenant_tables_test.rb
new file mode 100644
index 0000000..5c6f4eb
--- /dev/null
+++ b/test/models/tenant_tables_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class TenantTablesTest < ActiveSupport::TestCase
+  # Tables whose rows belong to an account. Each one requires account_id and indexes it, so
+  # account-scoped queries can use an index and no row can exist without an account.
+  # Identity, session and authentication tables are global and are not listed. Search index
+  # tables are sharded differently per database adapter and are left out.
+  TENANT_TABLES = %w[
+    accesses account_cancellations account_imports account_join_codes action_text_rich_texts
+    active_storage_attachments active_storage_blobs active_storage_variant_records assignments
+    board_publications boards card_activity_spikes card_goldnesses card_not_nows cards closures
+    columns comments entropies events exports filters mentions notification_bundles notifications
+    pins push_subscriptions reactions search_queries steps storage_entries storage_totals taggings
+    tags user_settings users watches webhook_delinquency_trackers webhook_deliveries webhooks
+  ].freeze
+
+  test "every tenant table requires account_id and indexes it" do
+    TENANT_TABLES.each do |table|
+      column = ActiveRecord::Base.connection.columns(table).find { |c| c.name == "account_id" }
+
+      assert column, "#{table} has no account_id"
+      assert_not column.null, "#{table}.account_id allows NULL"
+      assert indexed_on_account_id?(table), "#{table}.account_id is not indexed"
+    end
+  end
+
+  private
+    def indexed_on_account_id?(table)
+      ActiveRecord::Base.connection.indexes(table).any? { |index| index.columns.first == "account_id" }
+    end
+end
