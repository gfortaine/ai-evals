diff --git a/db/migrate/20261124120000_add_account_id_to_tenant_tables.rb b/db/migrate/20261124120000_add_account_id_to_tenant_tables.rb
new file mode 100644
index 0000000..1b77ab7
--- /dev/null
+++ b/db/migrate/20261124120000_add_account_id_to_tenant_tables.rb
@@ -0,0 +1,183 @@
+class AddAccountIdToTenantTables < ActiveRecord::Migration[8.2]
+  # Finishes the multi-tenant rollout: every table holding an account's data gets an
+  # account_id that is required and indexed.
+  #
+  # A row belongs to whatever account its owner belongs to: a card's is its board's, a
+  # comment's is its card's, an attachment's is its record's. Existing nullable account_id
+  # columns are only filled where they are empty. Rows that still have no account once
+  # that's done, or that point at an account which no longer exists, are orphans and are
+  # deleted.
+
+  # Tables that get a new account_id column.
+  NEW_COLUMN = %w[
+    accesses action_text_rich_texts active_storage_attachments active_storage_blobs
+    active_storage_variant_records assignments board_publications card_activity_spikes
+    card_goldnesses card_not_nows closures entropies mentions pins reactions search_queries
+    storage_totals taggings user_settings watches webhook_delinquency_trackers webhook_deliveries
+  ].freeze
+
+  # Tables that already have account_id, nullable.
+  NULLABLE_COLUMN = %w[
+    account_imports account_join_codes boards cards columns comments events filters
+    notification_bundles notifications push_subscriptions steps tags users webhooks
+  ].freeze
+
+  # table => [ owner table, foreign key on the table ]
+  OWNED_BY = {
+    "accesses" => [ "boards", "board_id" ],
+    "active_storage_variant_records" => [ "active_storage_blobs", "blob_id" ],
+    "assignments" => [ "cards", "card_id" ],
+    "board_publications" => [ "boards", "board_id" ],
+    "boards" => [ "users", "creator_id" ],
+    "card_activity_spikes" => [ "cards", "card_id" ],
+    "card_goldnesses" => [ "cards", "card_id" ],
+    "card_not_nows" => [ "cards", "card_id" ],
+    "cards" => [ "boards", "board_id" ],
+    "closures" => [ "cards", "card_id" ],
+    "columns" => [ "boards", "board_id" ],
+    "comments" => [ "cards", "card_id" ],
+    "events" => [ "boards", "board_id" ],
+    "filters" => [ "users", "creator_id" ],
+    "notification_bundles" => [ "users", "user_id" ],
+    "notifications" => [ "users", "user_id" ],
+    "pins" => [ "cards", "card_id" ],
+    "push_subscriptions" => [ "users", "user_id" ],
+    "search_queries" => [ "users", "user_id" ],
+    "steps" => [ "cards", "card_id" ],
+    "taggings" => [ "cards", "card_id" ],
+    "user_settings" => [ "users", "user_id" ],
+    "watches" => [ "cards", "card_id" ],
+    "webhook_deliveries" => [ "webhooks", "webhook_id" ],
+    "webhook_delinquency_trackers" => [ "webhooks", "webhook_id" ],
+    "webhooks" => [ "boards", "board_id" ]
+  }.freeze
+
+  # table => [ type column, id column, { type => owner table } ]. An owner of "accounts"
+  # means the row is the account itself.
+  OWNED_BY_POLYMORPHIC = {
+    "action_text_rich_texts" => [ "record_type", "record_id", { "Board" => "boards", "Card" => "cards", "Comment" => "comments" } ],
+    "active_storage_attachments" => [ "record_type", "record_id", {
+      "ActionText::RichText" => "action_text_rich_texts",
+      "ActiveStorage::VariantRecord" => "active_storage_variant_records",
+      "Account::Import" => "account_imports",
+      "Card" => "cards",
+      "Export" => "exports",
+      "User" => "users"
+    } ],
+    "entropies" => [ "container_type", "container_id", { "Account" => "accounts", "Board" => "boards" } ],
+    "mentions" => [ "source_type", "source_id", { "Card" => "cards", "Comment" => "comments" } ],
+    "reactions" => [ "reactable_type", "reactable_id", { "Card" => "cards", "Comment" => "comments" } ],
+    "storage_totals" => [ "owner_type", "owner_id", { "Account" => "accounts", "Board" => "boards" } ]
+  }.freeze
+
+  def up
+    NEW_COLUMN.each { |table| add_column table, :account_id, :uuid }
+
+    say_with_time "Filling account_id from owners" do
+      fill_account_ids
+    end
+
+    say_with_time "Deleting orphaned rows" do
+      (NEW_COLUMN + NULLABLE_COLUMN).each { |table| delete_orphans table }
+    end
+
+    # Tag titles are unique within an account, not across all accounts.
+    remove_index :tags, :title
+    add_index :tags, [ :account_id, :title ], unique: true
+
+    say_with_time "Requiring and indexing account_id" do
+      (NEW_COLUMN + NULLABLE_COLUMN).each { |table| require_account_id table }
+    end
+  end
+
+  def down
+    remove_index :tags, [ :account_id, :title ]
+    add_index :tags, :title, unique: true
+
+    # account_imports was already indexed on account_id before this migration.
+    (NEW_COLUMN + NULLABLE_COLUMN - %w[ account_imports ]).each do |table|
+      remove_index table, :account_id if index_exists?(table, :account_id)
+    end
+
+    NULLABLE_COLUMN.each { |table| change_column_null table, :account_id, true }
+    NEW_COLUMN.each { |table| remove_column table, :account_id }
+  end
+
+  private
+    def fill_account_ids
+      sources = account_sources
+
+      loop do
+        filled = sources.sum { |table, source| fill_account_id(table, source) }
+        break if filled.zero?
+      end
+    end
+
+    def account_sources
+      owned_by_owner = OWNED_BY.to_h { |table, (owner, fk)| [ table, owner_account(table, owner, fk) ] }
+      polymorphic = OWNED_BY_POLYMORPHIC.to_h { |table, (type, id, owners)| [ table, polymorphic_account(table, type, id, owners) ] }
+
+      owned_by_owner.merge(polymorphic).merge(
+        "active_storage_blobs" => blob_account,
+        "tags" => tag_account
+      )
+    end
+
+    # The account of the owner that +fk+ on +table+ points at.
+    def owner_account(table, owner, fk)
+      column = owner == "accounts" ? "id" : "account_id"
+      "SELECT #{owner}.#{column} FROM #{owner} WHERE #{owner}.id = #{table}.#{fk}"
+    end
+
+    def polymorphic_account(table, type_column, id_column, owners)
+      branches = owners.map { |type, owner| "WHEN '#{type}' THEN (#{owner_account(table, owner, id_column)})" }
+      "CASE #{table}.#{type_column} #{branches.join(" ")} END"
+    end
+
+    # A blob belongs to the account of the attachments that use it.
+    def blob_account
+      <<~SQL.squish
+        SELECT active_storage_attachments.account_id FROM active_storage_attachments
+        WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+          AND active_storage_attachments.account_id IS NOT NULL
+        LIMIT 1
+      SQL
+    end
+
+    # A tag belongs to the account of the cards it is on.
+    def tag_account
+      <<~SQL.squish
+        SELECT cards.account_id FROM taggings
+        INNER JOIN cards ON cards.id = taggings.card_id
+        WHERE taggings.tag_id = tags.id AND cards.account_id IS NOT NULL
+        LIMIT 1
+      SQL
+    end
+
+    def fill_account_id(table, source)
+      connection.update(<<~SQL)
+        UPDATE #{table}
+        SET account_id = (#{source})
+        WHERE account_id IS NULL AND (#{source}) IS NOT NULL
+      SQL
+    end
+
+    def delete_orphans(table)
+      deleted = connection.delete(<<~SQL)
+        DELETE FROM #{table}
+        WHERE account_id IS NULL
+          OR NOT EXISTS (SELECT 1 FROM accounts WHERE accounts.id = #{table}.account_id)
+      SQL
+
+      say "#{table}: deleted #{deleted} orphaned #{"row".pluralize(deleted)}" if deleted.positive?
+    end
+
+    def require_account_id(table)
+      change_column_null table, :account_id, false
+      add_index table, :account_id unless account_indexed?(table)
+    end
+
+    def account_indexed?(table)
+      indexes(table).any? { |index| index.columns.first == "account_id" }
+    end
+end
