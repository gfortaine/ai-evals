diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..b1a9db8
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+  end
+
+  test "going live announces the book once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "going live and adding a page in the same sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), title: "New page"
+      end
+    end
+
+    assert @book.reload.published?
+    assert_equal 1, @book.leaves.count
+  end
+
+  test "going live and saving again in the same sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! slug: "new-slug"
+        @book.press Page.new(body: ""), title: "New page"
+      end
+    end
+  end
+
+  test "going live and back down in the same sitting announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "going live, down, and live again in one sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "saving an already live book again announces nothing" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Manual, revised"
+      @book.press Page.new(body: ""), title: "New page"
+    end
+  end
+
+  test "taking a live book down announces nothing" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "a live book taken down and back up in one sitting announces nothing" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "saving a draft without taking it live announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Manual, revised"
+      @book.press Page.new(body: ""), title: "New page"
+    end
+  end
+
+  test "a sitting that fails after the book is marked live leaves a draft and announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises RuntimeError do
+        Book.transaction do
+          @book.update! published: true
+          @book.press Page.new(body: ""), title: "New page"
+          raise "Something went wrong"
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+    assert_equal 0, @book.leaves.count
+  end
+
+  test "a book whose failed sitting left it a draft can go live on a later sitting" do
+    assert_raises RuntimeError do
+      Book.transaction do
+        @book.update! published: true
+        raise "Something went wrong"
+      end
+    end
+
+    @book.reload
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "creating a live book announces it once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.create! title: "Live from the start", published: true
+    end
+  end
+
+  test "creating a draft book announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.create! title: "Still a draft"
+    end
+  end
+end
