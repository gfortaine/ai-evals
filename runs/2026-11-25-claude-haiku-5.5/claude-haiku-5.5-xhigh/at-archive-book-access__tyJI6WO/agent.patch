diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..6e68586 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,78 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroying a book archives each user who had access, with their level" do
+    book = books(:handbook)
+
+    book.destroy
+
+    archived = AccessArchive.where(book_id: book.id).pluck(:book_title, :user_id, :user_name, :level)
+    assert_equal [
+      [ "Handbook", users(:david).id, "David", "editor" ],
+      [ "Handbook", users(:jason).id, "Jason", "editor" ],
+      [ "Handbook", users(:jz).id, "JZ", "reader" ],
+      [ "Handbook", users(:kevin).id, "Kevin", "editor" ]
+    ].sort, archived.sort
+    assert_equal 0, Access.where(book_id: book.id).count
+    assert_not Book.exists?(book.id)
+  end
+
+  test "archive rows are written only after the book has been deleted" do
+    statements = []
+    subscriber = proc { |*, payload| statements << payload[:sql] }
+
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      books(:handbook).destroy
+    end
+
+    book_delete = statements.index { it.start_with?('DELETE FROM "books"') }
+    archive_insert = statements.index { it.start_with?('INSERT INTO "access_archives"') }
+    assert_not_nil book_delete
+    assert_not_nil archive_insert
+    assert book_delete < archive_insert
+  end
+
+  test "destroying a book does not archive access that was revoked earlier" do
+    book = books(:handbook)
+    book.update!(everyone_access: false)
+    book.accesses.load # hold a stale in-memory copy of the grants
+
+    book.update_access(editors: [ users(:kevin).id ], readers: [])
+    book.destroy
+
+    archived = AccessArchive.where(book_id: book.id).pluck(:user_name, :level)
+    assert_equal [ [ "Kevin", "editor" ] ], archived
+  end
+
+  test "destroying a book nobody had access to archives nothing" do
+    book = Book.create!(title: "Nobody's book", everyone_access: false)
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy
+    end
+    assert_not Book.exists?(book.id)
+  end
+
+  test "deleting a book nobody had access to archives nothing" do
+    book = Book.create!(title: "Nobody's book", everyone_access: false)
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.delete
+    end
+    assert_not Book.exists?(book.id)
+  end
+
+  test "destroying a book archives grants made after its access list was loaded" do
+    book = books(:manual)
+    book.accesses.load
+    Access.create!(book: book, user: users(:kevin), level: :reader)
+
+    book.destroy
+
+    archived = AccessArchive.where(book_id: book.id).pluck(:user_name, :level)
+    assert_equal [ [ "David", "editor" ], [ "Jason", "editor" ], [ "JZ", "reader" ], [ "Kevin", "reader" ] ].sort, archived.sort
+    assert_equal 0, Access.where(book_id: book.id).count
+    assert_not Book.exists?(book.id)
+  end
 end
