+++ b/.kamal/hooks/pre-connect
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+
+# Kamal runs this before it builds the image or connects to the server, with the
+# values from .kamal/secrets in its environment. Failing here is much cheaper than
+# failing after the image has been built and pushed.
+
+fail=0
+
+# Only the three values at the top of config/deploy.yml are placeholders. Match their assignments.
+if grep -qE "^[[:space:]]*(host|smtp_host|mail_from)[[:space:]]*=.*example\.com" config/deploy.yml; then
+  echo "config/deploy.yml still has example.com placeholders. Replace them with your hostname, mail server, and sender address." >&2
+  fail=1
+fi
+
+if [ -z "$SECRET_KEY_BASE" ]; then
+  echo "SECRET_KEY_BASE is not set. Generate one with 'bin/rails secret' and export it (see .kamal/secrets)." >&2
+  fail=1
+fi
+
+if [ -n "$SMTP_USERNAME" ] && [ -z "$SMTP_PASSWORD" ]; then
+  echo "SMTP_USERNAME is set but SMTP_PASSWORD is not." >&2
+  fail=1
+fi
+
+exit $fail
