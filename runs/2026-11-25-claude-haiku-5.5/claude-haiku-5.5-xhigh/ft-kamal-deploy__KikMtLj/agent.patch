new file mode 100644
index 0000000..49c067e
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,74 @@
+# Deploys Fizzy to one server with Kamal.
+#
+# One container runs everything: Puma serves the web app and Solid Queue runs the
+# background jobs in the same process. All SQLite databases, uploaded files, and
+# Solid Queue/Cache data live on the `fizzy_storage` Docker volume, which is not
+# touched by deploys. kamal-proxy serves HTTPS with a Let's Encrypt certificate.
+#
+# To run your own copy:
+#
+#   1. Replace the three placeholder values below with your hostname, mail server,
+#      and sender address. Change the arch if your server is ARM.
+#   2. Set the secrets listed in .kamal/secrets.
+#   3. bin/kamal setup    (first time: installs Docker, builds, and starts Fizzy)
+#      bin/kamal deploy   (for every release after that)
+#
+# See docs/deployment.md for the full walkthrough.
+
+<%
+  # Replace these three values with your own.
+  host = "fizzy.example.com"              # public hostname; its DNS must point at the server
+  smtp_host = "smtp.example.com"          # your outgoing mail server
+  mail_from = "Fizzy <fizzy@example.com>" # sender address your mail server accepts
+%>
+
+service: fizzy
+image: fizzy
+
+# SSH target. Kamal connects as root by default; set ssh: user: if you use another account.
+servers:
+  web:
+    hosts:
+      - <%= host %>
+
+# Kamal starts a registry on your machine and tunnels it to the server, so you
+# don't need a container registry account. The port is 5555 because macOS uses 5000.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64 # the server's CPU architecture: amd64 or arm64
+
+proxy:
+  host: <%= host %>
+  ssl: true
+  # kamal-proxy stops forwarding client IP headers when ssl is on. Rails needs them
+  # to record the real visitor address.
+  forward_headers: true
+
+# Every SQLite database, uploaded file, and Solid Queue/Cache table lives here. Deploys
+# replace the container but keep this volume.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Keeps assets from the previous container reachable while the new one starts.
+asset_path: /rails/public/assets
+
+# On first boot the container creates and migrates the SQLite databases before the
+# server starts, which can take longer than the default 30 seconds.
+deploy_timeout: 120
+
+env:
+  clear:
+    APP_HOST: "<%= host %>"
+    MAILER_FROM_ADDRESS: "<%= mail_from %>"
+    SMTP_ADDRESS: "<%= smtp_host %>"
+    SMTP_PORT: "587" # 587 (STARTTLS) or 465 (implicit TLS)
+    SOLID_QUEUE_IN_PUMA: "true" # run background jobs inside the web process
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+aliases:
+  console: app exec -i --reuse "bin/rails console"
