new file mode 100644
index 0000000..7248581
--- /dev/null
+++ b/.kamal/secrets
@@ -0,0 +1,17 @@
+# Secrets for `bin/kamal setup` and `bin/kamal deploy`. Listed under env: secret in
+# config/deploy.yml.
+#
+# This file is committed, so it only names the secrets; the values come from your
+# environment. Export them in your shell, or keep them in a git-ignored .env file (put
+# each value in single quotes) and load it before running kamal:
+#
+#   set -a; . ./.env; set +a
+#
+#   SECRET_KEY_BASE  Generate once with `bin/rails secret` (or `openssl rand -hex 64`).
+#                    Keep the same value for every deploy: changing it signs everyone out.
+#   SMTP_USERNAME    Only if your mail server requires a login.
+#   SMTP_PASSWORD    The password for SMTP_USERNAME.
+
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+SMTP_USERNAME=$SMTP_USERNAME
+SMTP_PASSWORD=$SMTP_PASSWORD
