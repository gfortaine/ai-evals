diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..b39896a
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+
+    books(:handbook).update!(created_at: Time.utc(2023, 11, 20, 9, 30), updated_at: Time.utc(2024, 3, 5, 14, 7, 9))
+  end
+
+  test "show reports when the book was last updated" do
+    get book_report_path(books(:handbook))
+
+    assert_response :success
+    assert_in_body "Last updated March 05, 2024"
+    assert_in_body "Handbook — #{books(:handbook).markable.length.to_fs(:delimited)} characters"
+  end
+
+  test "show offers a plain text card of the book" do
+    get book_report_path(books(:handbook), format: :text)
+
+    assert_response :success
+    assert_equal "text/plain", response.media_type
+    assert_includes response.headers["Content-Disposition"], "shelf-report-20240305140709.txt"
+
+    covers = books(:handbook).leaves.active.positioned.map(&:id).join(",")
+
+    assert_equal <<~CARD, response.body
+      Book: Handbook
+      Leaves: 4
+      Started: November 20, 2023 09:30
+      Updated: 05 Mar 14:07
+      Covers: #{covers}
+    CARD
+  end
+end
diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..43f0d36
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class ReportArchiveJobTest < ActiveJob::TestCase
+  setup do
+    @book = books(:handbook)
+    @book.leaves.update_all(updated_at: Time.utc(2024, 3, 5, 14, 7, 9))
+  end
+
+  teardown do
+    FileUtils.rm_f archive_path(@book)
+    FileUtils.rm_f archive_path(books(:manual))
+  end
+
+  test "archives the book with the time it was last edited" do
+    ReportArchiveJob.perform_now(@book)
+
+    assert_equal "# archived 2024-03-05 14:07:09 UTC\n\n#{@book.markable}", File.read(archive_path(@book))
+  end
+
+  test "archives a book without leaves with an empty timestamp" do
+    ReportArchiveJob.perform_now(books(:manual))
+
+    assert_equal "# archived \n\n", File.read(archive_path(books(:manual)))
+  end
+
+  private
+    def archive_path(book)
+      Rails.root.join(ReportArchiveJob::ARCHIVE_DIR, "book-#{book.id}.txt")
+    end
+end
diff --git a/test/lib/publishing/report_card_test.rb b/test/lib/publishing/report_card_test.rb
new file mode 100644
index 0000000..8c02d04
--- /dev/null
+++ b/test/lib/publishing/report_card_test.rb
@@ -0,0 +1,28 @@
+require "test_helper"
+
+class Publishing::ReportCardTest < ActiveSupport::TestCase
+  test "to_text lists the book, its leaves, dates and covers" do
+    books(:handbook).update!(created_at: Time.utc(2023, 11, 20, 9, 30), updated_at: Time.utc(2024, 3, 5, 14, 7, 9))
+    covers = books(:handbook).leaves.active.positioned.map(&:id).join(",")
+
+    assert_equal <<~CARD, Publishing::ReportCard.new(books(:handbook)).to_text
+      Book: Handbook
+      Leaves: 4
+      Started: November 20, 2023 09:30
+      Updated: 05 Mar 14:07
+      Covers: #{covers}
+    CARD
+  end
+
+  test "to_text shows no covers for a book without active leaves" do
+    books(:manual).update!(created_at: Time.utc(2023, 11, 20, 9, 30), updated_at: Time.utc(2024, 3, 5, 14, 7, 9))
+
+    assert_equal <<~CARD, Publishing::ReportCard.new(books(:manual)).to_text
+      Book: Manual
+      Leaves: 0
+      Started: November 20, 2023 09:30
+      Updated: 05 Mar 14:07
+      Covers: null
+    CARD
+  end
+end
