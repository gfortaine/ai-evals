@@ -0,0 +1,16 @@
+<li id="<%= dom_id(result.card, :search_result) %>" class="search-result flex flex-column gap-half pad">
+  <div class="flex align-center justify-space-between gap-half txt-small txt-subtle">
+    <span class="overflow-ellipsis">#<%= result.card.number %> in <%= result.card.board.name %></span>
+    <%= local_datetime_tag result.card.created_at, style: :agoorweekday %>
+  </div>
+
+  <%= link_to result.card, class: "txt-ink overflow-ellipsis" do %>
+    <%= highlight_terms(result.card.title, terms) %>
+  <% end %>
+
+  <% if result.excerpt %>
+    <p class="txt-small margin-none">
+      <%= link_to search_excerpt(result.excerpt, terms), result.comment || result.card, class: "txt-ink" %>
+    </p>
+  <% end %>
+</li>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..400db58
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,31 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide center borderless unpad flex flex-column gap-half margin-block-start">
+  <%= form_with url: search_path, method: :get, role: "search", class: "full-width" do |form| %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards and comments…", autofocus: true,
+          autocorrect: "off", autocomplete: "off", class: "input input--transparent full-width txt-small", data: { "1p-ignore": "true" } %>
+  <% end %>
+
+  <% if @search.terms.any? %>
+    <%= with_automatic_pagination :search_results, @page do %>
+      <% if @results.any? %>
+        <ul class="search-results list-style-none flex flex-column gap-half unpad">
+          <%= render partial: "searches/result", collection: @results, as: :result, locals: { terms: @search.terms } %>
+        </ul>
+      <% end %>
+
+      <% if @results.none? && @page.last? %>
+        <p class="txt-subtle txt-small center margin-block">No cards match “<%= @search.query %>”</p>
+      <% end %>
+    <% end %>
+  <% end %>
+</section>
