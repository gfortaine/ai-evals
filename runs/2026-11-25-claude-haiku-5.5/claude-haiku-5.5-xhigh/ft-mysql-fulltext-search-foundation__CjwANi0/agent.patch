diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..964a7ea
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,31 @@
+module SearchHelper
+  EXCERPT_CONTEXT = 80
+
+  # Escapes the text and wraps each matched term in <mark>. Plain text only, so the result is safe to render.
+  def highlight_terms(text, terms)
+    parts = text.split(term_pattern(terms))
+
+    safe_join parts.each_with_index.map { |part, index| index.odd? ? tag.mark(part) : part }
+  end
+
+  def search_excerpt(text, terms)
+    text = text.squish
+    match = term_pattern(terms).match(text)
+    from = [ (match&.begin(0) || 0) - EXCERPT_CONTEXT, 0 ].max
+    to = [ (match&.end(0) || 0) + EXCERPT_CONTEXT, text.length ].min
+    excerpt = text[from...to]
+
+    excerpt = "…#{excerpt}" if from > 0
+    excerpt = "#{excerpt}…" if to < text.length
+
+    highlight_terms(excerpt, terms)
+  end
+
+  private
+    # The capture group makes String#split keep the matches, at every odd index.
+    def term_pattern(terms)
+      alternatives = terms.sort_by { |term| -term.length }.map { |term| Regexp.escape(term) }
+
+      Regexp.new("(#{alternatives.join("|")})", Regexp::IGNORECASE)
+    end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..8092aa6
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,93 @@
+class Search
+  Result = Data.define(:card, :excerpt, :comment)
+  Passage = Data.define(:text, :comment)
+
+  ESCAPE = "\\"
+
+  attr_reader :user, :query
+
+  def initialize(user, query)
+    @user, @query = user, query.to_s.tr("\0", " ")
+  end
+
+  def terms
+    @terms ||= query.split.uniq(&:downcase)
+  end
+
+  # Candidate cards, newest first. This is only a rough filter: rich text is stored as HTML, so
+  # LIKE also matches tags and attributes. results_for confirms each candidate against the text.
+  def cards
+    if terms.any?
+      terms.inject(visible_cards) { |cards, term| cards.where(id: cards_containing(term).select(:id)) }
+    else
+      Card.none
+    end
+  end
+
+  def results_for(cards)
+    comments_by_card = comments_for(cards).group_by(&:card_id)
+
+    cards.filter_map do |card|
+      result_for(card, comments_by_card.fetch(card.id, []))
+    end
+  end
+
+  private
+    def visible_cards
+      user.accessible_cards.published.reverse_chronologically
+        .with_rich_text_description_and_embeds.preload(:board)
+    end
+
+    def cards_containing(term)
+      Card.where(account_id: user.account_id).where(title_matching(term))
+        .or(Card.where(id: rich_text_ids("Card", "description", [ term ])))
+        .or(Card.where(id: Comment.where(id: rich_text_ids("Comment", "body", [ term ])).select(:card_id)))
+    end
+
+    def comments_for(cards)
+      Comment.where(card_id: cards.map(&:id))
+        .where(id: rich_text_ids("Comment", "body", terms))
+        .with_rich_text_body_and_embeds
+        .order(created_at: :desc, id: :desc)
+    end
+
+    def result_for(card, comments)
+      passages = [ Passage.new(card.description.to_plain_text, nil) ] +
+        comments.map { |comment| Passage.new(comment.body.to_plain_text, comment) }
+      texts = [ card.title, *passages.map(&:text) ]
+
+      if terms.all? { |term| texts.any? { |text| includes?(text, term) } }
+        passage = passages.find { |candidate| terms.any? { |term| includes?(candidate.text, term) } }
+        Result.new(card: card, excerpt: passage&.text, comment: passage&.comment)
+      end
+    end
+
+    def includes?(text, term)
+      text.downcase.include?(term.downcase)
+    end
+
+    # The LIKE conditions are built as SQL strings on purpose. The body column is a serialized rich text
+    # attribute, and Arel would run each pattern through its HTML coder, which mangles any "<", "&" or ">".
+    def title_matching(term)
+      Card.sanitize_sql_array([ "cards.title LIKE ? ESCAPE ?", pattern(term), ESCAPE ])
+    end
+
+    # Scoped to the account so the scan covers only this tenant's rich text.
+    def rich_text_ids(record_type, name, words)
+      ActionText::RichText.where(account_id: user.account_id, record_type: record_type, name: name)
+        .where(body_matching(words))
+        .select(:record_id)
+    end
+
+    # Rich text is stored as HTML, so each term is looked for both as typed and in its escaped form ("<" is stored as "&lt;").
+    def body_matching(words)
+      patterns = words.flat_map { |word| [ word, ERB::Util.html_escape(word).to_s ].uniq }.map { |text| pattern(text) }
+      conditions = patterns.map { "action_text_rich_texts.body LIKE ? ESCAPE ?" }.join(" OR ")
+
+      ActionText::RichText.sanitize_sql_array([ conditions, *patterns.flat_map { |like| [ like, ESCAPE ] } ])
+    end
+
+    def pattern(text)
+      "%#{ActiveRecord::Base.sanitize_sql_like(text)}%"
+    end
+end
diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
