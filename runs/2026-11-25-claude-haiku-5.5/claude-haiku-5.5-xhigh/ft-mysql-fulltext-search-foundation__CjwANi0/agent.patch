diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..c17badf
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,185 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "finds cards by title" do
+    get search_path, params: { q: "layout" }
+
+    assert_response :success
+    assert_result_for cards(:layout)
+    assert_no_result_for cards(:logo)
+  end
+
+  test "finds cards by description" do
+    cards(:text).update!(description: "Gobbledygook everywhere")
+
+    get search_path, params: { q: "gobbledygook" }
+
+    assert_result_for cards(:text)
+    assert_select "##{result_id(cards(:text))} mark", text: "Gobbledygook"
+  end
+
+  test "finds cards by the body of any comment on them" do
+    get search_path, params: { q: "agree" }
+
+    assert_result_for cards(:logo)
+    assert_select "##{result_id(cards(:logo))} mark", text: "agree"
+    assert_select "##{result_id(cards(:logo))} a[href$=?]", "#" + ActionView::RecordIdentifier.dom_id(comments(:logo_agreement_jz))
+  end
+
+  test "every word must match, each in the title, description or a comment" do
+    get search_path, params: { q: "logo agree" }
+    assert_result_for cards(:logo)
+
+    get search_path, params: { q: "logo zebra" }
+    assert_empty result_ids
+  end
+
+  test "matching is case-insensitive and wraps the matched words in mark" do
+    get search_path, params: { q: "LAYOUT" }
+
+    assert_select "##{result_id(cards(:layout))} mark", text: "Layout"
+  end
+
+  test "results are newest first" do
+    older = create_card "zebra older", created_at: 2.days.ago
+    newer = create_card "zebra newer", created_at: 1.hour.ago
+
+    get search_path, params: { q: "zebra" }
+
+    assert_equal [ result_id(newer), result_id(older) ], result_ids
+  end
+
+  test "only shows cards on boards the user currently has access to" do
+    card = create_card "zebra private", board: boards(:private)
+
+    get search_path, params: { q: "zebra" }
+    assert_result_for card
+
+    logout_and_sign_in_as :david
+
+    get search_path, params: { q: "zebra" }
+    assert_empty result_ids
+  end
+
+  test "revoking access hides the board's cards" do
+    create_card "zebra private", board: boards(:private)
+    accesses(:private_kevin).destroy!
+
+    get search_path, params: { q: "zebra" }
+
+    assert_empty result_ids
+  end
+
+  test "draft cards and their comments never show up" do
+    draft = create_card "zebra draft"
+    draft.comments.create!(body: "zebra comment", creator: users(:kevin))
+    with_current_user(:kevin) { draft.update_column(:status, "drafted") }
+
+    get search_path, params: { q: "zebra" }
+
+    assert_empty result_ids
+  end
+
+  test "markup is not searched, only the text people see" do
+    cards(:text).comments.create!(body: "<p><strong>Bold</strong> claim</p>", creator: users(:kevin))
+
+    get search_path, params: { q: "strong" }
+    assert_empty result_ids
+
+    get search_path, params: { q: "bold" }
+    assert_result_for cards(:text)
+  end
+
+  test "html in titles and comments is escaped" do
+    card = create_card "<img src=x onerror=alert(1)> layout"
+
+    get search_path, params: { q: "layout" }
+
+    assert_result_for card
+    assert_select "##{result_id(card)} img", count: 0
+    assert_includes response.body, "&lt;img src=x onerror=alert(1)&gt;"
+  end
+
+  test "% and _ in the query match literally" do
+    percent = create_card "Hit 100% of the target"
+    lookalike = create_card "Hit 1000 of the target"
+    commented = create_card "Shipping"
+    commented.comments.create!(body: "<p>Hit 100% of the target</p>", creator: users(:kevin))
+
+    get search_path, params: { q: "100%" }
+
+    assert_result_for percent
+    assert_result_for commented
+    assert_no_result_for lookalike
+
+    underscore = create_card "snake_case works"
+    no_underscore = create_card "snakeXcase works"
+
+    get search_path, params: { q: "snake_case" }
+
+    assert_result_for underscore
+    assert_no_result_for no_underscore
+  end
+
+  test "says so when nothing matches" do
+    get search_path, params: { q: "zebra" }
+
+    assert_select "p", text: "No cards match “zebra”"
+  end
+
+  test "NUL bytes in the query are treated as spaces" do
+    get search_path, params: { q: "layout\0" }
+
+    assert_response :success
+    assert_result_for cards(:layout)
+  end
+
+  test "never shows cards from another account" do
+    get search_path, params: { q: "radio" }
+
+    assert_response :success
+    assert_no_result_for cards(:radio)
+  end
+
+  test "blank query shows no results" do
+    get search_path, params: { q: "   " }
+
+    assert_response :success
+    assert_empty result_ids
+  end
+
+  test "requires a signed-in user" do
+    sign_out
+
+    get search_path, params: { q: "layout" }
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  private
+    def create_card(title, board: boards(:writebook), **attributes)
+      with_current_user(:kevin) do
+        board.cards.create!(title: title, status: :published, creator: users(:kevin), **attributes)
+      end
+    end
+
+    def result_id(card)
+      ActionView::RecordIdentifier.dom_id(card, :search_result)
+    end
+
+    def result_ids
+      css_select("li.search-result").map { |node| node["id"] }
+    end
+
+    def assert_result_for(card)
+      assert_includes result_ids, result_id(card)
+    end
+
+    def assert_no_result_for(card)
+      assert_not_includes result_ids, result_id(card)
+    end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..e2dddf2
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+  end
+
+  test "terms are the query's words, without repeats" do
+    assert_equal %w[ logo Agree ], Search.new(@kevin, "  logo   Agree LOGO ").terms
+  end
+
+  test "no terms means no cards" do
+    assert_empty Search.new(@kevin, " ").cards
+  end
+
+  test "entities are searched as the characters they stand for" do
+    comment = cards(:text).comments.create!(body: "<p>Tom &amp; Jerry</p>", creator: @kevin)
+
+    assert_equal [ comment ], matching_comments("&")
+    assert_equal [ comment ], matching_comments("tom & jerry")
+    assert_empty matching_comments("amp")
+  end
+
+  test "text that looks like an entity is found as typed" do
+    comment = cards(:text).comments.create!(body: "<p>a&amp;amp;b</p>", creator: @kevin)
+
+    assert_equal [ comment ], matching_comments("a&amp;b")
+  end
+
+  test "characters that are escaped in the markup are still found" do
+    comment = cards(:text).comments.create!(body: "<p>2 &lt; 3</p>", creator: @kevin)
+
+    assert_equal [ comment ], matching_comments("<")
+  end
+
+  test "only published cards are candidates" do
+    draft = boards(:writebook).cards.create!(title: "zebra", status: :drafted, creator: @kevin)
+
+    assert_not_includes Search.new(@kevin, "zebra").cards, draft
+  end
+
+  test "a card matches when each word appears in different places" do
+    cards(:layout).update!(description: "Logo is off-centre")
+    search = Search.new(@kevin, "layout off-centre")
+
+    assert_equal [ cards(:layout) ], search.results_for(search.cards).map(&:card)
+  end
+
+  test "the excerpt comes from the newest comment containing a word" do
+    newest = cards(:logo).comments.create!(body: "<p>Agreed, the logo is fine</p>", creator: @kevin)
+
+    result = result_for(cards(:logo), "agree")
+
+    assert_equal "Agreed, the logo is fine", result.excerpt
+    assert_equal newest, result.comment
+  end
+
+  private
+    def matching_comments(query)
+      search = Search.new(@kevin, query)
+      search.results_for(search.cards).filter_map(&:comment)
+    end
+
+    def result_for(card, query)
+      search = Search.new(@kevin, query)
+      search.results_for(search.cards).find { |result| result.card == card }
+    end
+end
