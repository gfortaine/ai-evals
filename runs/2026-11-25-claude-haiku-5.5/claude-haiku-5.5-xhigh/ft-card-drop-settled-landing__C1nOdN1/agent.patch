diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..48eec59
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,210 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  MAYBE = "#maybe"
+  NOT_NOW = "#not-now"
+  DONE = "#closed-cards"
+
+  setup do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+  end
+
+  test "dropping a card on a column moves it there straight away and saves the move" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_on_hold)
+
+    drag_card card, onto: column_section(column)
+
+    assert_card_in column_section(column), card, wait: 0
+    assert_equal column.color.value, inline_style(card, "--card-color")
+    await_server { card.reload.column == column }
+  end
+
+  test "a dropped card lands where the column puts it, so nothing moves once it is saved" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_triage) # Logo is golden, so it stays on top
+
+    drag_card card, onto: column_section(column)
+    shown_order = card_order_in(column_section(column))
+
+    await_server { card.reload.column == column }
+    visit board_url(boards(:writebook))
+
+    assert_equal [ cards(:logo), card, cards(:layout) ].map { dom_id(it, :article) }, shown_order
+    assert_equal shown_order, card_order_in(column_section(column))
+  end
+
+  test "dropping a card on Done closes it, and it is first there, as the saved board shows it" do
+    card = cards(:buy_domain)
+
+    drag_card card, onto: DONE
+
+    assert_card_in DONE, card, wait: 0
+    assert_equal "var(--color-card-complete)", inline_style(card, "--card-color")
+    shown_order = card_order_in(DONE)
+
+    await_server { card.reload.closed? }
+    visit board_url(boards(:writebook))
+
+    assert_equal dom_id(card, :article), shown_order.first
+    assert_equal shown_order, card_order_in(DONE)
+  end
+
+  test "dropping a card on Not Now postpones it" do
+    card = cards(:buy_domain)
+
+    drag_card card, onto: NOT_NOW
+
+    assert_card_in NOT_NOW, card, wait: 0
+    assert_includes card_classes(card), "card--postponed"
+    await_server { card.reload.postponed? }
+  end
+
+  test "dropping a card on Maybe? sends it back to triage" do
+    card = cards(:layout)
+    expand_column column_section(columns(:writebook_triage))
+
+    drag_card card, onto: MAYBE
+
+    assert_card_in MAYBE, card, wait: 0
+    await_server { card.reload.awaiting_triage? }
+  end
+
+  test "dropping a closed card on a column reopens it there" do
+    card = cards(:shipping)
+    column = columns(:writebook_in_progress)
+    expand_column DONE
+
+    drag_card card, onto: column_section(column)
+
+    assert_card_in column_section(column), card, wait: 0
+    await_server { card.reload.triaged? && card.column == column }
+  end
+
+  test "dropping a card back where it already is does nothing" do
+    card = cards(:buy_domain)
+    order_before = card_order_in(MAYBE)
+    last_active_before = card.reload.last_active_at
+
+    drag_card card, onto: MAYBE
+    sleep 0.3
+
+    assert_equal order_before, card_order_in(MAYBE)
+    assert_equal last_active_before, card.reload.last_active_at
+  end
+
+  test "the counts on the columns follow the card" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_on_hold)
+    maybe_before = counter_in(MAYBE)
+    column_before = counter_in(column_section(column))
+
+    drag_card card, onto: column_section(column)
+
+    assert_equal maybe_before - 1, counter_in(MAYBE)
+    assert_equal column_before + 1, counter_in(column_section(column))
+  end
+
+  test "a column that empties shows its hint again, and a column that fills loses it" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_on_hold)
+    column_selector = column_section(column)
+
+    assert_hint_in column_selector
+
+    drag_card card, onto: column_selector
+    assert_no_hint_in column_selector
+
+    expand_column column_selector
+    drag_card card, onto: MAYBE
+    assert_hint_in column_selector
+  end
+
+  test "while dragging, the card dims and the column under the pointer lights up" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_on_hold)
+
+    hold_drag_over card, column_section(column) do
+      assert_selector ".drag-and-drop__dragged-item##{dom_id(card, :article)}"
+      assert_selector "#{column_section(column)}.drag-and-drop__hover-container"
+      assert_equal "dashed", computed_style("#{column_section(column)} .cards__transition-container", "outline-style")
+    end
+
+    assert_no_selector ".drag-and-drop__dragged-item"
+    assert_no_selector ".drag-and-drop__hover-container"
+  end
+
+  test "a save that fails reloads the board from the server" do
+    card = cards(:buy_domain)
+    card.destroy
+
+    drag_card card, onto: column_section(columns(:writebook_on_hold))
+
+    assert_no_selector "##{dom_id(card, :article)}", visible: :all
+  end
+
+  private
+    def column_section(column)
+      "##{dom_id(column)}"
+    end
+
+    def drag_card(card, onto:)
+      find("##{dom_id(card, :article)}").drag_to(find(onto, visible: :all))
+    end
+
+    def hold_drag_over(card, selector)
+      browser = page.driver.browser
+      source = find("##{dom_id(card, :article)}")
+      target = find(selector, visible: :all)
+
+      browser.action.click_and_hold(source.native).move_by(20, 5).perform
+      browser.action.move_to(target.native).perform
+      browser.action.move_to(target.native, 3, 3).perform
+      yield
+    ensure
+      browser.action.release.perform
+    end
+
+    def expand_column(selector)
+      find("#{selector} .cards__expander", visible: :all).click
+    end
+
+    def assert_card_in(section_selector, card, wait: Capybara.default_max_wait_time)
+      assert_selector "#{section_selector} ##{dom_id(card, :article)}", visible: :all, wait: wait
+    end
+
+    def await_server
+      Timeout.timeout(5) { sleep 0.05 until yield }
+    end
+
+    def card_order_in(section_selector)
+      page.evaluate_script("Array.from(document.querySelectorAll(#{"#{section_selector} .card".to_json})).map(el => el.id)")
+    end
+
+    def inline_style(card, property)
+      page.evaluate_script("document.getElementById(#{dom_id(card, :article).to_json}).style.getPropertyValue(#{property.to_json})")
+    end
+
+    def card_classes(card)
+      page.evaluate_script("document.getElementById('#{dom_id(card, :article)}').className").split
+    end
+
+    def counter_in(section_selector)
+      page.evaluate_script("document.querySelector(#{"#{section_selector} .cards__expander-count".to_json}).textContent").to_i
+    end
+
+    def computed_style(selector, property)
+      page.evaluate_script("getComputedStyle(document.querySelector(#{selector.to_json})).getPropertyValue(#{property.to_json})")
+    end
+
+    def assert_hint_in(section_selector)
+      assert_selector "#{section_selector} .cards__list > .blank-slate--drag", visible: :all, wait: 0
+    end
+
+    def assert_no_hint_in(section_selector)
+      assert_no_selector "#{section_selector} .cards__list > .blank-slate", visible: :all, wait: 0
+    end
+end
