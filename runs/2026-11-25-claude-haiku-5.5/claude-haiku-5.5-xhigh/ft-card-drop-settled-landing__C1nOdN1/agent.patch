diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..639d1ff
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,211 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+const CARD_DATA_TYPE = "application/x-card-id"
+// The color cards get when they have no column, as Column::Colored::DEFAULT_COLOR gives them
+const DEFAULT_CARD_COLOR = "var(--color-card-default)"
+
+// Changes a card's column or status by dragging it onto a column, Maybe?, Not Now or Done.
+//
+// The board changes the moment the card is dropped: the card moves, the counts follow, and the save
+// goes out in the background. The response isn't rendered. The save goes through Turbo, so the board
+// refresh it triggers is skipped for this page and nothing moves once it lands. A failed save reloads
+// the board, so it shows what the server has.
+//
+// Columns keep their own order, so the card lands where the server would put it, and dropping a card
+// where it already is does nothing.
+export default class extends Controller {
+  static targets = [ "placeholder" ]
+
+  #draggedCard = null
+  #highlightedSection = null
+  #pendingSaves = Promise.resolve()
+
+  disconnect() {
+    this.#clearDrag()
+  }
+
+  dragStart(event) {
+    const card = this.#cardFrom(event.target)
+    if (!card) return
+
+    this.#clearDrag()
+    this.#draggedCard = card
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData(CARD_DATA_TYPE, card.id) // Firefox won't start a drag without some data
+
+    const rect = card.getBoundingClientRect()
+    event.dataTransfer.setDragImage(card, event.clientX - rect.left, event.clientY - rect.top)
+
+    // Dim on the next frame so the drag image is taken from the card before it dims
+    requestAnimationFrame(() => {
+      if (this.#draggedCard === card) card.classList.add(DRAGGED_CLASS)
+    })
+  }
+
+  dragOver(event) {
+    const section = this.#sectionFrom(event.target)
+
+    if (this.#canDropOn(section)) {
+      event.preventDefault() // Allows the drop
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(section)
+    } else {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const section = this.#sectionFrom(event.target)
+    if (!this.#canDropOn(section)) return
+
+    event.preventDefault()
+    const card = this.#draggedCard
+    this.#clearDrag()
+
+    this.#moveCard(card, section)
+    this.#save(card, section)
+  }
+
+  dragEnd() {
+    this.#clearDrag()
+  }
+
+  // Private
+
+  #canDropOn(section) {
+    const card = this.#draggedCard
+    return Boolean(section && card?.isConnected && section !== this.#sectionOf(card))
+  }
+
+  #moveCard(card, section) {
+    const source = this.#sectionOf(card)
+
+    this.#placeCard(card, section)
+    this.#adjustCount(source, -1)
+    this.#adjustCount(section, +1)
+    this.#showEmptyHint(source)
+  }
+
+  #placeCard(card, section) {
+    const page = this.#pageOf(section)
+
+    this.#hideEmptyHint(section)
+    page.insertBefore(card, this.#insertionPointFor(card, section, page))
+
+    card.style.setProperty("--card-color", this.#cardColorOf(section))
+    card.classList.toggle("card--postponed", this.#destinationOf(section) === "not_now")
+    card.classList.toggle("card--active", [ "column", "maybe" ].includes(this.#destinationOf(section)))
+  }
+
+  // Columns and Maybe? list golden cards first, then the most recently active. Not Now and Done
+  // list only by recency, and a card dropped there has just become the most recent.
+  #insertionPointFor(card, section, page) {
+    const cards = Array.from(page.querySelectorAll(".card"))
+    const goldenFirst = [ "column", "maybe" ].includes(this.#destinationOf(section))
+    const first = goldenFirst && !isGolden(card) ? cards.find(other => !isGolden(other)) : cards[0]
+
+    return first ?? page.querySelector(":scope > .pagination-link")
+  }
+
+  // The frame holding the first page of a column's cards, where a card goes when it joins the column
+  #pageOf(section) {
+    const firstCard = section.querySelector(".card")
+    return firstCard?.parentElement ?? section.querySelector("[id$='pagination-contents-1']") ?? this.#listOf(section)
+  }
+
+  #listOf(section) {
+    return section.querySelector(".cards__list")
+  }
+
+  #cardColorOf(section) {
+    return section.style.getPropertyValue("--card-color") || DEFAULT_CARD_COLOR
+  }
+
+  #adjustCount(section, delta) {
+    const counter = section.querySelector(".cards__expander-count")
+    if (!counter || counter.textContent.includes("+")) return // Capped at 99+, so the true count isn't known
+
+    const count = Math.max(0, Number(counter.textContent) + delta)
+    counter.textContent = count > 99 ? "99+" : count
+  }
+
+  // Maybe? shows no empty-state hint; the other places show one, as the server renders them
+  #showEmptyHint(section) {
+    if (this.#destinationOf(section) === "maybe" || section.querySelector(".card")) return
+
+    this.#listOf(section).append(this.placeholderTarget.content.cloneNode(true))
+  }
+
+  #hideEmptyHint(section) {
+    this.#listOf(section).querySelectorAll(":scope > .blank-slate").forEach(hint => hint.remove())
+  }
+
+  #save(card, section) {
+    this.#pendingSaves = this.#pendingSaves
+      .then(() => this.#send(card, section))
+      .then(response => {
+        if (!response.ok) throw new Error(`Moving the card failed with status ${response.statusCode}`)
+      })
+      .catch(() => Turbo.visit(window.location.href, { action: "replace" }))
+  }
+
+  #send(card, section) {
+    switch (this.#destinationOf(section)) {
+      case "column":
+        return post(this.#triageUrlFor(card, section.dataset.dropColumnId), { responseKind: "json" })
+      case "maybe":
+        return destroy(card.dataset.cardTriageUrl, { responseKind: "json" })
+      case "not_now":
+        return post(card.dataset.cardPostponeUrl, { responseKind: "json" })
+      case "closed":
+        return post(card.dataset.cardCloseUrl, { responseKind: "json" })
+    }
+  }
+
+  #triageUrlFor(card, columnId) {
+    const url = new URL(card.dataset.cardTriageUrl, window.location.href)
+    url.searchParams.set("column_id", columnId)
+    return url.toString()
+  }
+
+  #highlight(section) {
+    if (section === this.#highlightedSection) return
+
+    this.#highlightedSection?.classList.remove(HOVER_CLASS)
+    section?.classList.add(HOVER_CLASS)
+    this.#highlightedSection = section
+  }
+
+  #clearDrag() {
+    this.#draggedCard?.classList.remove(DRAGGED_CLASS)
+    this.#draggedCard = null
+    this.#highlight(null)
+  }
+
+  #destinationOf(section) {
+    return section.dataset.dropInto
+  }
+
+  #sectionOf(card) {
+    return card.closest("[data-drop-into]")
+  }
+
+  #cardFrom(element) {
+    return this.#withinController(element?.closest?.(".card"))
+  }
+
+  #sectionFrom(element) {
+    return this.#withinController(element?.closest?.("[data-drop-into]"))
+  }
+
+  #withinController(element) {
+    return element && this.element.contains(element) ? element : null
+  }
+}
+
+function isGolden(card) {
+  return card.classList.contains("golden-effect")
+}
