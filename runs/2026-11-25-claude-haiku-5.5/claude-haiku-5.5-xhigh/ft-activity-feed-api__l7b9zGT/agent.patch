+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,253 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_equal users(:kevin).accessible_events.reverse_chronologically.pluck(:id), @response.parsed_body.pluck("id")
+
+    created_ats = @response.parsed_body.map { |activity| Time.iso8601(activity["created_at"]) }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "index defaults to JSON" do
+    get activities_path
+
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+  end
+
+  test "index rejects HTML" do
+    get activities_path(format: :html)
+
+    assert_response :not_acceptable
+  end
+
+  test "index as JSON includes the activity attributes" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["id"] == events(:logo_published).id }
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, activity.keys.sort
+    assert_equal "card_published", activity["action"]
+    assert_equal events(:logo_published).created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+  end
+
+  test "index as JSON returns the description in plain text" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["id"] == events(:logo_published).id }
+
+    assert_equal events(:logo_published).description_for(users(:kevin)).to_plain_text, activity["description"]
+  end
+
+  test "index as JSON omits deprecated collection changes" do
+    events(:logo_published).update_columns(action: "card_collection_changed", particulars: { "particulars" => { "new_collection" => "Writebook" } })
+
+    get activities_path, as: :json
+
+    assert_not_includes @response.parsed_body.pluck("id"), events(:logo_published).id
+    assert_not_includes @response.parsed_body.pluck("action"), "card_collection_changed"
+  end
+
+  test "index as JSON includes title changes" do
+    events(:layout_published).update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Layout", "new_title" => "Layout is broken" } })
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["id"] == events(:layout_published).id }
+
+    assert_equal "card_title_changed", activity["action"]
+    assert_equal({ "old_title" => "Layout", "new_title" => "Layout is broken" }, activity["particulars"])
+  end
+
+  test "index as JSON only includes activity on boards the user can access" do
+    events(:logo_published).update_columns(board_id: boards(:private).id)
+
+    get activities_path, as: :json
+    assert_includes @response.parsed_body.pluck("id"), events(:logo_published).id
+
+    logout_and_sign_in_as :jz
+
+    get activities_path, as: :json
+    assert_not_includes @response.parsed_body.pluck("id"), events(:logo_published).id
+    assert_equal users(:jz).accessible_events.reverse_chronologically.pluck(:id), @response.parsed_body.pluck("id")
+  end
+
+  test "index as JSON filters by creator_ids" do
+    get activities_path(format: :json, creator_ids: [ users(:david).id ])
+
+    expected_ids = users(:kevin).accessible_events.where(creator: users(:david)).reverse_chronologically.pluck(:id)
+
+    assert_response :success
+    assert_not_empty expected_ids
+    assert_equal expected_ids, @response.parsed_body.pluck("id")
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:david).id }
+  end
+
+  test "index as JSON filters by board_ids" do
+    events(:logo_published).update_columns(board_id: boards(:private).id)
+
