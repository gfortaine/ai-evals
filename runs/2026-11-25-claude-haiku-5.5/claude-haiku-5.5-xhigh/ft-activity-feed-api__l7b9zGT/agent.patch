new file mode 100644
index 0000000..7824505
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,22 @@
+class ActivitiesController < ApplicationController
+  include FilterScoped
+
+  # The timeline's actions, minus the deprecated collection changes, plus title changes
+  ACTIONS = (Event::TIMELINEABLE_ACTIONS - %w[ card_collection_changed ] + %w[ card_title_changed ]).freeze
+
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from activities
+      end
+    end
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events.preloaded.where(action: ACTIONS)
+      events = events.where(creator_id: @filter.creator_ids) if @filter.creator_ids.present?
+      events = events.where(board_id: @filter.board_ids) if @filter.board_ids.present?
+      events.reverse_chronologically
+    end
+end
