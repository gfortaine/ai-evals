@@ -0,0 +1,39 @@
+class ActivitiesController < ApplicationController
+  include FilterScoped
+
+  # Same kinds of events as the HTML timeline, except for the deprecated card_collection_changed,
+  # plus card_title_changed
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_title_changed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+  ]
+
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from activities
+      end
+    end
+  end
+
+  private
+    def activities
+      events = Event.preloaded.where(board: boards).where(action: ACTIVITY_ACTIONS).reverse_chronologically
+      events = events.where(creator_id: @filter.creators.ids) if @filter.creators.present?
+      events
+    end
+
+    def boards
+      @filter.boards.presence || Current.user.boards
+    end
+end
