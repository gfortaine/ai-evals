@@ -0,0 +1,21 @@
+module ActivitiesHelper
+  def activity_particulars(event)
+    case event.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(event.assignee_ids) }
+    when "card_board_changed"
+      { old_board: particular(event, :old_board), new_board: particular(event, :new_board) }
+    when "card_title_changed"
+      { old_title: particular(event, :old_title), new_title: particular(event, :new_title) }
+    when "card_triaged"
+      { column: particular(event, :column) }
+    else
+      {}
+    end
+  end
+
+  private
+    def particular(event, name)
+      event.particulars.dig("particulars", name.to_s).to_s
+    end
+end
