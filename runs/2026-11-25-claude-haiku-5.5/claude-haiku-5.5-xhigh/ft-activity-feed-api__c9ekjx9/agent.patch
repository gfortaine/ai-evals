@@ -0,0 +1,253 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_includes activity_ids, events(:logo_published).id
+  end
+
+  test "index rejects HTML" do
+    get activities_path(format: :html)
+
+    assert_response :not_acceptable
+  end
+
+  test "index requires authentication" do
+    sign_out
+
+    get activities_path, as: :json
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "index accepts a personal access token" do
+    sign_out
+
+    get activities_path(format: :json), headers: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  test "index includes the expected attributes" do
+    get activities_path, as: :json
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ],
+      activity(events(:logo_published)).keys
+  end
+
+  test "index returns newest activity first" do
+    get activities_path, as: :json
+
+    created_ats = @response.parsed_body.map { Time.iso8601(it["created_at"]) }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "index includes card and comment events" do
+    get activities_path, as: :json
+
+    assert_equal "card_assigned", activity(events(:logo_assignment_jz))["action"]
+    assert_equal "comment_created", activity(events(:layout_commented))["action"]
+  end
+
+  test "index omits deprecated card collection changes" do
+    events(:logo_published).update_columns(action: "card_collection_changed")
+
+    get activities_path, as: :json
+
+    assert_not_includes activity_ids, events(:logo_published).id
+  end
+
+  test "index includes card title changes" do
+    events(:logo_published).update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } })
+
+    get activities_path, as: :json
+
+    assert_includes activity_ids, events(:logo_published).id
+    assert_equal "card_title_changed", activity(events(:logo_published))["action"]
+  end
+
+  test "description is the plain text description for the current user" do
+    get activities_path, as: :json
+
+    expected = events(:logo_published).description_for(users(:kevin)).to_plain_text
+    assert_equal expected, activity(events(:logo_published))["description"]
+  end
+
+  test "description is written from the current user's point of view" do
+    get activities_path, as: :json
+
+    assert_includes activity(events(:logo_assignment_km))["description"], "will handle"
+    assert_includes activity(events(:logo_assignment_david))["description"], "assigned David to"
+  end
+
+  test "particulars for assignments contain the assignee ids" do
+    get activities_path, as: :json
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity(events(:logo_assignment_jz))["particulars"])
+  end
+
+  test "particulars for unassignments contain the assignee ids" do
+    events(:logo_assignment_jz).update_columns(action: "card_unassigned")
+
+    get activities_path, as: :json
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity(events(:logo_assignment_jz))["particulars"])
+  end
+
+  test "particulars for board changes contain the old and new board" do
+    events(:logo_published).update_columns(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "Writebook", "new_board" => "Private board" } })
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, activity(events(:logo_published))["particulars"])
+  end
+
+  test "particulars for title changes contain the old and new title" do
+    events(:logo_published).update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Logo", "new_title" => "Brand logo" } })
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_title" => "Logo", "new_title" => "Brand logo" }, activity(events(:logo_published))["particulars"])
+  end
+
+  test "particulars for triage contain the column" do
+    events(:logo_published).update_columns(action: "card_triaged", particulars: { "particulars" => { "column" => "In progress" } })
+
+    get activities_path, as: :json
+
+    assert_equal({ "column" => "In progress" }, activity(events(:logo_published))["particulars"])
+  end
+
+  test "particulars are empty for other events" do
+    get activities_path, as: :json
+
+    assert_equal({}, activity(events(:logo_published))["particulars"])
+    assert_equal({}, activity(events(:shipping_closed))["particulars"])
+    assert_equal({}, activity(events(:layout_commented))["particulars"])
+  end
+
+  test "missing board, title, and column values are empty strings" do
+    events(:logo_published).update_columns(action: "card_board_changed", particulars: {})
+    events(:layout_published).update_columns(action: "card_title_changed", particulars: {})
+    events(:text_published).update_columns(action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, activity(events(:logo_published))["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, activity(events(:layout_published))["particulars"])
+    assert_equal({ "column" => "" }, activity(events(:text_published))["particulars"])
+  end
+
+  test "url opens the card for card events" do
+    get activities_path, as: :json
+
+    assert_equal polymorphic_url(cards(:logo)), activity(events(:logo_published))["url"]
+  end
+
+  test "url opens the card and jumps to the comment for comment events" do
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path, as: :json
+
+    assert_equal polymorphic_url(comment), activity(events(:layout_commented))["url"]
+    assert_match %r{/cards/#{comment.card.number}#comment_#{comment.id}\z}, activity(events(:layout_commented))["url"]
+  end
+
+  test "eventable is the card representation for card events" do
+    get activities_path, as: :json
+
+    event = activity(events(:logo_published))
+    assert_equal "Card", event["eventable_type"]
+    assert_equal cards(:logo).id, event["eventable"]["id"]
+    assert_equal cards(:logo).number, event["eventable"]["number"]
+    assert_equal cards(:logo).title, event["eventable"]["title"]
+  end
+
+  test "eventable is the comment representation for comment events" do
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path, as: :json
+
+    event = activity(events(:layout_commented))
+    assert_equal "Comment", event["eventable_type"]
+    assert_equal comment.id, event["eventable"]["id"]
+    assert_equal comment.card_id, event["eventable"].dig("card", "id")
+  end
+
+  test "board and creator use the existing representations" do
+    get activities_path, as: :json
+
+    event = activity(events(:logo_published))
+    assert_equal boards(:writebook).id, event["board"]["id"]
+    assert_equal boards(:writebook).name, event["board"]["name"]
+    assert_equal users(:david).id, event["creator"]["id"]
+    assert_equal users(:david).name, event["creator"]["name"]
+    assert_includes event["creator"], "avatar_url"
+  end
+
+  test "index filters by creator ids" do
+    get activities_path(creator_ids: [ users(:kevin).id ]), as: :json
+
+    assert_response :success
+    assert_includes activity_ids, events(:shipping_published).id
+    assert_not_includes activity_ids, events(:logo_published).id
+    assert @response.parsed_body.all? { it.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "index filters by board ids" do
+    events(:logo_published).update_columns(board_id: boards(:private).id)
+
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+
+    assert_response :success
+    assert_equal [ events(:logo_published).id ], activity_ids
+  end
+
+  test "index only returns activity from boards the user can access" do
+    events(:logo_published).update_columns(board_id: boards(:private).id)
+
+    logout_and_sign_in_as :david
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_not_includes activity_ids, events(:logo_published).id
+    assert_includes activity_ids, events(:text_published).id
+  end
+
+  test "index paginates results" do
+    20.times do
+      Event.create!(board: boards(:writebook), creator: users(:david), eventable: comments(:layout_overflowing_david), action: "comment_created")
+    end
+
+    get activities_path, as: :json
+    first_page = activity_ids
+    total = @response.headers["X-Total-Count"].to_i
+
+    assert_response :success
+    assert_equal 15, first_page.size
+    assert_includes @response.headers["Link"], %(rel="next")
+
+    get activities_path(page: 2), as: :json
+    second_page = activity_ids
+
+    assert_empty first_page & second_page
+    assert_equal total, first_page.size + second_page.size
+  end
+
+  private
+    def activity_ids
+      @response.parsed_body.pluck("id")
+    end
+
+    def activity(event)
+      @response.parsed_body.find { it["id"] == event.id }
+    end
+end
