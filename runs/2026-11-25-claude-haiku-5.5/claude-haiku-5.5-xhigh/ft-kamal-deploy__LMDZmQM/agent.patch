@@ -0,0 +1,93 @@
+# Kamal configuration for running Fizzy on a single server.
+#
+# One container runs everything: the web app, background jobs (Solid Queue runs
+# inside Puma), and the SQLite databases. The databases live in the fizzy_storage
+# volume, so they survive every deploy. kamal-proxy terminates TLS with a
+# Let's Encrypt certificate.
+#
+# To run your own copy, change the values marked CHANGE ME, provide the secrets
+# listed in .kamal/secrets, then run `bin/kamal setup` the first time and
+# `bin/kamal deploy` after that. docs/self-hosting.md has the full walkthrough.
+
+<%
+  # CHANGE ME: the public hostname Fizzy is served at. Point its DNS record at the server.
+  app_host = "fizzy.example.com"
+
+  # CHANGE ME: the server to deploy to, as an IP address or a hostname that resolves to it.
+  server = "203.0.113.10"
+%>
+
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - <%= server %>
+
+# Kamal runs a small registry container on your machine and pushes the image there,
+# so no registry account is needed. To use a hosted registry instead, change this to
+# its address and add credentials.
+registry:
+  server: localhost:5555
+
+builder:
+  # The architecture of the server. Use arm64 if the server is ARM.
+  arch: amd64
+
+proxy:
+  ssl: true
+  host: <%= app_host %>
+  # With ssl enabled, kamal-proxy stops forwarding client headers by default.
+  # Forward them, so Rails sees real client IPs. Rate limiting depends on that.
+  forward_headers: true
+
+# The SQLite databases, uploaded files and other data Fizzy writes live in
+# /rails/storage. Keep this volume: it is what makes data survive deploys.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Assets are bridged between versions, so requests in flight during a deploy
+# don't get 404s for fingerprinted files.
+asset_path: /rails/public/assets
+
+# The first boot creates and migrates the SQLite databases, which takes longer
+# than the default 30 seconds.
+deploy_timeout: 120
+
+# Kamal logs in as root by default. To use another user, uncomment this and
+# make sure that user can run Docker.
+# ssh:
+#   user: deploy
+
+env:
+  clear:
+    # Run background jobs in the web process, so this one container does everything.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Puma workers and job processes. Each one uses memory, so lower these on a
+    # small server.
+    WEB_CONCURRENCY: "2"
+    JOB_CONCURRENCY: "1"
+
+    # The public hostname. Emails, notifications and webhooks link to it, so it
+    # must match proxy.host above.
+    APP_HOST: <%= app_host %>
+
+    # CHANGE ME: the From address on outgoing mail. Your mail server must be allowed to send as it.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+
+    # CHANGE ME: your SMTP server. Fizzy can't send sign-in emails without one.
+    # Port 587 uses STARTTLS. For port 465, set SMTP_TLS to "true" (implicit TLS).
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_TLS: "false"
+    # CHANGE ME: set SMTP_USERNAME if your server requires a login. Leave it empty if not.
+    SMTP_USERNAME: ""
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
