+      tls: ENV["SMTP_TLS"] == "true",                   # implicit TLS (SMTPS, usually port 465)
+      enable_starttls_auto: ENV["SMTP_TLS"] != "true"   # STARTTLS when offered (usually port 587)
+    }
+  end
