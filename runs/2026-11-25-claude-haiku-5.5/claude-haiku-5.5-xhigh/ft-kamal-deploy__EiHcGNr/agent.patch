new file mode 100644
index 0000000..19942d6
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,78 @@
+# Kamal config for running Fizzy on one server.
+#
+# One container runs the app, its background jobs (Solid Queue, inside Puma), and
+# its SQLite databases. kamal-proxy terminates HTTPS with a Let's Encrypt certificate.
+#
+# To deploy your own copy:
+#   1. Change the values marked CHANGE below.
+#   2. cp .kamal/secrets.example .kamal/secrets and fill it in.
+#   3. bin/kamal setup
+#
+# See docs/deployment.md for the full walkthrough.
+
+<%
+  # CHANGE: the public hostname for Fizzy. Point its DNS record at the server before the
+  # first deploy, or the proxy can't get a certificate. Also used as the SSH target below.
+  host = "fizzy.example.com"
+
+  # CHANGE: your outbound mail server (sign-in links and notifications are sent through it).
+  # Its username and password go in .kamal/secrets.
+  smtp_address = "smtp.example.com"
+  mail_from = "Fizzy <fizzy@example.com>"
+%>
+
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - <%= host %>   # SSH target. You can use the server's IP address here instead.
+
+proxy:
+  ssl: true         # Let's Encrypt certificate; plain HTTP redirects to HTTPS
+  host: <%= host %>
+  app_port: 80      # Thruster inside the container listens on port 80
+
+# Kamal runs a registry on your machine and tunnels it to the server over SSH, so you
+# don't need a registry account, and the image only goes to your server.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64       # CHANGE to arm64 if the server is ARM
+
+# Everything that must survive a deploy lives under /rails/storage: the SQLite databases
+# (production, cable, cache, queue) and Active Storage uploads. Docker keeps this named
+# volume across deploys, restarts, and `bin/kamal remove`.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Keeps the previous version's CSS and JS available while a new version rolls out.
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    # Public hostname. Used to build links in emails and notifications. Must match proxy.host.
+    APP_FQDN: <%= host %>
+    # Background jobs run inside the web container. Setting this to "false" without adding a
+    # jobs role (cmd: bin/jobs) means no background jobs run at all: no emails, no cleanup.
+    SOLID_QUEUE_IN_PUMA: "true"
+    # Outbound mail. Port 587 uses STARTTLS. For implicit TLS (usually port 465), set
+    # SMTP_PORT to "465" and uncomment SMTP_TLS.
+    SMTP_ADDRESS: <%= smtp_address %>
+    SMTP_PORT: "587"
+    # SMTP_TLS: "true"
+    MAILER_FROM_ADDRESS: "<%= mail_from %>"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# Kamal connects as root. To connect as another user (who must be able to run Docker), uncomment:
+# ssh:
+#   user: ubuntu
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
