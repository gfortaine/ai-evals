@@ -0,0 +1,20 @@
+# Template for the secrets that config/deploy.yml passes to the container.
+#
+# Copy this file to .kamal/secrets and fill in the values. .kamal/secrets is git-ignored,
+# so real values never get committed. Don't commit this file with real values either.
+#
+# Keep the values stable after the first deploy. Changing SECRET_KEY_BASE signs everyone
+# out, and changing the VAPID keys breaks existing push subscriptions.
+
+# Required. Signs sessions and cookies. Generate once with: bin/rails secret
+SECRET_KEY_BASE=
+
+# Login for your mail server. Leave both blank if it accepts mail without authentication.
+SMTP_USERNAME=
+SMTP_PASSWORD=
+
+# Browser push notifications. Generate once with:
+#   bundle exec ruby -rweb-push -e 'k = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{k.public_key}", "VAPID_PRIVATE_KEY=#{k.private_key}"'
+# Without them, push notifications don't work, but everything else does.
+VAPID_PUBLIC_KEY=
+VAPID_PRIVATE_KEY=
