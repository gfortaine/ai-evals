+  # Framework settings that decide the formats above. Rails 6.1 base defaults
+  # (no load_defaults) give these values. Rails 7.0 changes some of them through
+  # load_defaults 7.0, and the pins in config/application.rb restore them.
+  def test_persisted_format_settings_are_pinned
+    config = Rails.application.config.action_dispatch
+
+    assert_equal :marshal, config.cookies_serializer || :marshal
+    if ActiveSupport::KeyGenerator.respond_to?(:hash_digest_class) # Rails 7.0+
+      assert_equal OpenSSL::Digest::SHA1, ActiveSupport::KeyGenerator.hash_digest_class
+    end
+    if ActiveSupport::Cache.respond_to?(:format_version) # Rails 7.0+
+      assert_equal 6.1, ActiveSupport::Cache.format_version
+    end
+  end
