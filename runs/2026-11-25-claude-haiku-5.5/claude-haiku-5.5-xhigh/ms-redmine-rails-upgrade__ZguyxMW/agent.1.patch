+  def test_mail_link_token_is_generated_byte_for_byte_like_the_previous_release
+    token = Rails.application.message_verifier(:mail_links).generate(
+      {'user_id' => 3, 'issue_id' => 2}, :purpose => :unwatch, :expires_at => Time.utc(2100, 1, 1))
+
+    assert_equal PREVIOUS_RELEASE_MAIL_TOKEN, token
+  end
+
+  # Session cookies (cookie store, _redmine_session).
+  def test_session_cookie_from_previous_release_is_readable
+    payload = read_session_cookie(PREVIOUS_RELEASE_SESSION_COOKIE)
+
+    assert_equal 'golden0123456789abcdef', payload['session_id']
+    assert_equal 2, payload['user_id']
+    assert_equal 'golden-session-token', payload['tk']
+    # Symbol keys inside session data must survive; a JSON serializer would turn them into strings.
+    assert_equal({login: 'ldapuser', auth_source_id: 1}, payload['auth_source_registration'])
+  end
+
+  def test_session_cookie_from_rails_7_0_is_readable_on_this_release
+    payload = read_session_cookie(RAILS_7_0_SESSION_COOKIE)
+
+    assert_equal 2, payload['user_id']
+    assert_equal 'golden-session-token', payload['tk']
+    assert_equal({login: 'ldapuser', auth_source_id: 1}, payload['auth_source_registration'])
+  end
+
+  # Guard: a session cookie written now must stay in the format the previous
+  # release decrypts. This is AES-256-CBC with signed secret, Marshal payload and
+  # no purpose metadata. Switching the release to AES-256-GCM would sign users
+  # out on rollback.
+  def test_session_cookie_written_now_is_decryptable_by_the_previous_release_format
+    payload = {'session_id' => 'abc0123', 'user_id' => 2, 'tk' => 'rollback-token'}
+    request = ActionDispatch::Request.new(Rails.application.env_config.dup)
+    request.cookie_jar.signed_or_encrypted[SESSION_COOKIE_NAME] = {value: payload, path: '/', same_site: :lax}
+    headers = {}
+    request.cookie_jar.write(headers)
+    cookie_pair = Array(headers['Set-Cookie']).first.split(';').first
+
+    value = Rack::Utils.parse_cookies('HTTP_COOKIE' => cookie_pair)[SESSION_COOKIE_NAME]
+    secret = Rails.application.key_generator.generate_key('encrypted cookie', ActiveSupport::MessageEncryptor.key_len('aes-256-cbc'))
+    sign_secret = Rails.application.key_generator.generate_key('signed encrypted cookie')
+    previous_reader = ActiveSupport::MessageEncryptor.new(
+      secret, sign_secret, cipher: 'aes-256-cbc', serializer: Marshal)
+
+    assert_equal payload, previous_reader.decrypt_and_verify(value)
+  end
+
+  # Redmine stores repository and LDAP passwords encrypted in the database.
+  def test_database_cipher_text_from_previous_release_is_readable
+    Redmine::Configuration.with('database_cipher_key' => 'golden cipher key') do
+      assert_equal 'golden password', Redmine::Ciphering.decrypt_text(PREVIOUS_RELEASE_CIPHER_TEXT)
+    end
+  end
