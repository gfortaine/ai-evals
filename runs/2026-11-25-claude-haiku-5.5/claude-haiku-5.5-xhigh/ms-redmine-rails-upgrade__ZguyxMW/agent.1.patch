+  # Mail links (Mailer.mail_link_token) use this verifier. The same secret and
+  # serialization must keep producing these exact bytes.
+  def test_mail_link_token_from_previous_release_still_verifies
+    assert_equal({'user_id' => 3, 'issue_id' => 2},
+                 Mailer.verify_mail_link(PREVIOUS_RELEASE_MAIL_TOKEN, :unwatch))
+  end
+
