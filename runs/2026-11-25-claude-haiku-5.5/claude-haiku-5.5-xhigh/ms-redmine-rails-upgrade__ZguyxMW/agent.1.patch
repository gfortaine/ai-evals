+# * RAILS_7_0_SESSION_COOKIE was written by Rails 7.0.10 with load_defaults 7.0
+#   and the pins from config/application.rb. It uses AES-256-GCM cookies and
+#   purpose metadata.
+# * PREVIOUS_RELEASE_CSRF_* and RAILS_7_0_CSRF_* are form tokens from Rails
+#   6.1.7.10 and Rails 7.0.10 with base defaults. Token checks do not depend on
+#   the secret.
+#
+# They must keep verifying and decrypting on every release, and on both Rails
+# versions. Do not regenerate them to make a test pass. If one of these tests
+# fails, a persisted format changed and the change needs a rollback plan first.
+class RollbackCompatibilityTest < ActiveSupport::TestCase
+  PREVIOUS_RELEASE_MAIL_TOKEN = 'eyJfcmFpbHMiOnsibWVzc2FnZSI6IkJBaDdCMGtpREhWelpYSmZhV1FHT2daRlZHa0lTU0lOYVhOemRX' \
+    'VmZhV1FHT3dCVWFRYz0iLCJleHAiOiIyMTAwLTAxLTAxVDAwOjAwOjAwLjAwMFoiLCJwdXIiOiJ1bndh' \
