diff --git a/config/application.rb b/config/application.rb
index 5e93df1..2962b8b 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -93,6 +93,41 @@ module RedmineApp
       :same_site => :lax
     )
 
+    # Framework-default pins for rollback safety. Read docs/UPGRADE.md
+    # ("Framework defaults and rollback") before changing any of these.
+    #
+    # This release runs on Rails 6.1 without config.load_defaults, so the
+    # effective values are the Rails base defaults. The settings below make
+    # the values that touch persisted data explicit: session and cookie
+    # formats, mail-link tokens and the file cache. Rolling back to the
+    # previous release, or forward to the Rails 7.0 release, depends on these
+    # formats not changing. The 7.0 release must keep these values, because
+    # config.load_defaults 7.0 would change them.
+    #
+    # Session cookies are Marshal payloads. Rails 6.1 base defaults write them
+    # with AES-256-CBC and no purpose metadata. Rails 7.0 may write AES-256-GCM
+    # cookies with purpose metadata. This release reads both (see
+    # ActionDispatch::Cookies and test/unit/rollback_compatibility_test.rb),
+    # so those two settings are not pinned here.
+    config.action_dispatch.cookies_serializer = :marshal
+
+    # Key derivation for cookies and Rails.application.message_verifier(:mail_links).
+    # Rails 6.1 always derives keys with PBKDF2-HMAC-SHA1. Rails 7.0 with
+    # load_defaults 7.0 would switch to SHA256, which breaks existing sessions
+    # and mail links. Rails 6.1 ignores this key.
+    config.active_support.key_generator_hash_digest_class = OpenSSL::Digest::SHA1
+
+    # File cache entries (formatted text, i18n options). Rails 6.1 only reads
+    # the 6.1 format, so Rails 7.0 must keep writing it. Rails 6.1 ignores this key.
+    config.active_support.cache_format_version = 6.1
+
+    # Form tokens. Rails 7.0 with load_defaults 5.0 or later binds form tokens
+    # to the form's action and method. Rails 6.1 only accepts those tokens when
+    # this option is on, so a form rendered by the next release would be
+    # rejected after a rollback ("Invalid authenticity token"). Global tokens
+    # work on both versions (checked in test/unit/rollback_compatibility_test.rb).
+    config.action_controller.per_form_csrf_tokens = false
+
