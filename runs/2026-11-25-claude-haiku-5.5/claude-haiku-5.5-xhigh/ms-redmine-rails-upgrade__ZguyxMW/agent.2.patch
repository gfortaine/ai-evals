--- /dev/null
+++ b/lib/redmine/deprecation.rb
@@ -0,0 +1,24 @@
+# frozen_string_literal: true
+
+module Redmine
+  # Deprecation warnings for Redmine's own deprecated features.
+  #
+  # Rails 7.2 removed the class method ActiveSupport::Deprecation.warn. There,
+  # deprecators are instances, registered with the application, so that
+  # config.active_support.deprecation applies to them. Rails 7.0 keeps using the
+  # class method.
+  module Deprecation
+    def self.warn(message, callstack = nil)
+      if ActiveSupport::Deprecation.respond_to?(:warn)
+        ActiveSupport::Deprecation.warn(message, callstack)
+      else
+        deprecator.warn(message, callstack)
+      end
+    end
+
+    def self.deprecator
+      Rails.application.deprecators[:redmine] ||= ActiveSupport::Deprecation.new('6.0', 'Redmine')
+    end
+    private_class_method :deprecator
+  end
+end
