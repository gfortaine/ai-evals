diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..a74c9dd
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    books(:handbook).update_columns(created_at: Time.utc(2024, 1, 2, 3, 4, 5), updated_at: Time.utc(2024, 6, 19, 20, 2, 28))
+  end
+
+  test "show gives the date the book was last updated" do
+    get book_report_path(books(:handbook))
+
+    assert_response :success
+    assert_in_body "Last updated June 19, 2024"
+  end
+
+  test "text card lists the book's dates and leaves" do
+    get book_report_path(books(:handbook), format: :text)
+
+    assert_response :success
+    assert_equal "text/plain", response.media_type
+    assert_match %(filename="shelf-report-20240619200228.txt"), response.headers["Content-Disposition"]
+    assert_in_body "Started: January 02, 2024 03:04"
+    assert_in_body "Updated: 19 Jun 20:02"
+    assert_in_body "Covers: #{books(:handbook).leaves.active.positioned.map(&:id).join(",")}"
+  end
+end
