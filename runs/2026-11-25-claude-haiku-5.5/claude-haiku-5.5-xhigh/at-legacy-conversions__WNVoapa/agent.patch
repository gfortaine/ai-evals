diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..88d5f3a
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,20 @@
+require "test_helper"
+
+class ReportArchiveJobTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+    @path = Rails.root.join(ReportArchiveJob::ARCHIVE_DIR, "book-#{@book.id}.txt")
+  end
+
+  teardown do
+    FileUtils.rm_f @path
+  end
+
+  test "archive header carries the timestamp of the book's last edit" do
+    @book.leaves.active.update_all(updated_at: Time.utc(2024, 6, 19, 20, 2, 28))
+
+    ReportArchiveJob.perform_now(@book)
+
+    assert_match(/\A# archived 2024-06-19 20:02:28 UTC\n\n/, File.read(@path))
+  end
+end
diff --git a/test/lib/publishing/report_card_test.rb b/test/lib/publishing/report_card_test.rb
new file mode 100644
index 0000000..7c0309f
--- /dev/null
+++ b/test/lib/publishing/report_card_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class Publishing::ReportCardTest < ActiveSupport::TestCase
+  setup do
+    books(:handbook).update_columns(created_at: Time.utc(2024, 1, 2, 3, 4, 5), updated_at: Time.utc(2024, 6, 19, 20, 2, 28))
+  end
+
+  test "to_text lists the book's details" do
+    book = books(:handbook)
+    ids = book.leaves.active.positioned.map(&:id).join(",")
+
+    expected = <<~TEXT
+      Book: Handbook
+      Leaves: 4
+      Started: January 02, 2024 03:04
+      Updated: 19 Jun 20:02
+      Covers: #{ids}
+    TEXT
+
+    assert_equal expected, Publishing::ReportCard.new(book).to_text
+  end
+
+  test "to_text says there are no covers for a book without leaves" do
+    assert_includes Publishing::ReportCard.new(books(:manual)).to_text, "Covers: null\n"
+  end
+end
diff --git a/test/mailers/report_digest_mailer_test.rb b/test/mailers/report_digest_mailer_test.rb
new file mode 100644
index 0000000..d1f2d2d
--- /dev/null
+++ b/test/mailers/report_digest_mailer_test.rb
@@ -0,0 +1,12 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly lists each published book with the day it was last edited" do
+    books(:handbook).update!(published: true)
+    books(:handbook).update_columns(updated_at: Time.utc(2024, 6, 19, 20, 2, 28))
+
+    mail = ReportDigestMailer.weekly(users(:kevin))
+
+    assert_match "* Handbook, last edited 19 Jun", mail.body.to_s
+  end
+end
