diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..ed4a66d
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,56 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :items, class_name: "Notification::Bundle::Item", dependent: :delete_all
+  has_many :notifications, through: :items
+
+  scope :ongoing, ->(time = Time.current) { where("ends_at > ?", time) }
+  scope :due, ->(time = Time.current) { where(sent_at: nil, ends_at: ..time) }
+
+  class << self
+    # A notification joins the window still running when it lands, or opens a new one
+    # starting now if every window has ended. Windows are only opened under the user's
+    # row lock, and only once the previous one has ended, so they can't overlap, even if
+    # the clocks of different servers disagree a little.
+    def add(notification)
+      user = notification.user
+
+      if user.bundle_window
+        user.with_lock do
+          bundle = user.notification_bundles.ongoing.first || open_for(user)
+          bundle.items.find_or_create_by!(notification: notification)
+        end
+      end
+    end
+
+    def deliver_due
+      due.find_each do |bundle|
+        Current.with_account(bundle.account) { bundle.deliver }
+      end
+    end
+
+    private
+      def open_for(user)
+        now = Time.current
+        user.notification_bundles.create!(starts_at: now, ends_at: now + user.bundle_window)
+      end
+  end
+
+  # Closes the window and emails its notifications. Idempotent: a window is only
+  # ever closed once, and the check is repeated under the same lock `add` uses so
+  # no notification can land in it after it closes.
+  def deliver
+    user.with_lock do
+      if self.class.due.exists?(id)
+        update!(sent_at: Time.current)
+        NotificationMailer.digest(self).deliver_later if deliverable?
+      end
+    end
+  end
+
+  private
+    def deliverable?
+      user.active? && account.active? && user.bundle_window.present? && notifications.exists?
+    end
+end
