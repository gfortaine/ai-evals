diff --git a/test/mailers/notification_mailer_test.rb b/test/mailers/notification_mailer_test.rb
new file mode 100644
index 0000000..d8ea888
--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @bundle = @user.notification_bundles.create!(starts_at: Time.current, ends_at: 1.day.from_now)
+    @bundle.items.create!(notification: notifications(:logo_assignment_kevin))
+    @bundle.items.create!(notification: notifications(:layout_commented_kevin))
+  end
+
+  test "digest is sent to the user with a count of their notifications" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_equal "2 new notifications in Fizzy", email.subject
+  end
+
+  test "digest lists each notification with a link to its card" do
+    email = NotificationMailer.digest(@bundle)
+
+    html = email.html_part.body.decoded
+    text = email.text_part.body.decoded
+
+    assert_includes html, "Writebook"
+    assert_includes text, "Writebook"
+
+    [ cards(:logo), cards(:layout) ].each do |card|
+      assert_includes html, ERB::Util.html_escape(card.title)
+      assert_includes text, card.title
+      assert_includes text, "/cards/#{card.number}"
+    end
+  end
+
+  test "digest links to the notification settings so the frequency can be changed" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_includes email.html_part.body.decoded, "/notifications/settings"
+    assert_includes email.text_part.body.decoded, "/notifications/settings"
+  end
+
+  test "singular subject for one notification" do
+    @bundle.items.last.destroy!
+
+    email = NotificationMailer.digest(@bundle)
+
+    assert_equal "1 new notification in Fizzy", email.subject
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..e6b7932
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,274 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.create_settings!(bundle_email_frequency: "daily")
+
+    @first = notifications(:logo_assignment_kevin)
+    @second = notifications(:layout_commented_kevin)
+    @third = notifications(:buy_domain_sent_back_to_triage_kevin)
+  end
+
+  test "the first notification opens a window that starts when it lands" do
+    freeze_time
+
+    Notification::Bundle.add(@first)
+
+    bundle = @user.notification_bundles.sole
+    assert_equal Time.current, bundle.starts_at
+    assert_equal Time.current + 1.day, bundle.ends_at
+    assert_nil bundle.sent_at
+    assert_equal [ @first ], bundle.notifications.to_a
+  end
+
+  test "the window length follows the user's frequency" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    freeze_time
+
+    Notification::Bundle.add(@first)
+
+    assert_equal 4.hours, @user.notification_bundles.sole.ends_at - Time.current
+  end
+
+  test "nothing is bundled while digests are off" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      Notification::Bundle.add(@first)
+    end
+
+    assert_equal 0, Notification::Bundle::Item.count
+  end
+
+  test "nothing is bundled for users without settings" do
+    @user.settings.destroy!
+    @user.reload
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      Notification::Bundle.add(@first)
+    end
+  end
+
+  test "notifications landing while the window is open join it" do
+    freeze_time
+
+    Notification::Bundle.add(@first)
+    travel 2.hours
+    Notification::Bundle.add(@second)
+
+    bundle = @user.notification_bundles.sole
+    assert_equal [ @first, @second ].to_set, bundle.notifications.to_set
+  end
+
+  test "a notification landing again in the same window is only recorded once" do
+    Notification::Bundle.add(@first)
+    Notification::Bundle.add(@first)
+
+    assert_equal 1, @user.notification_bundles.sole.items.count
+  end
+
+  test "a notification landing after the window closes opens a new window" do
+    freeze_time
+
+    Notification::Bundle.add(@first)
+    travel 1.day
+    Notification::Bundle.add(@second)
+
+    previous, current = @user.notification_bundles.order(:starts_at).to_a
+    assert_equal [ @first ], previous.notifications.to_a
+    assert_equal [ @second ], current.notifications.to_a
+    assert_equal Time.current, current.starts_at
+    assert_operator current.starts_at, :>=, previous.ends_at
+  end
+
+  test "a server whose clock lags behind still joins the window another server opened" do
+    bundle = @user.notification_bundles.create!(starts_at: 1.second.from_now, ends_at: 1.day.from_now)
+
+    Notification::Bundle.add(@first)
+
+    assert_equal [ @first ], bundle.notifications.to_a
+    assert_equal 1, @user.notification_bundles.count
+  end
+
+  test "late notifications belong to the window that has already opened" do
+    freeze_time
+
+    Notification::Bundle.add(@first)
+    opened_at = Time.current
+
+    travel 1.hour
+    # This notification's event happened before the window opened, but it only lands now.
+    @second.update_column(:created_at, opened_at - 30.minutes)
+    Notification::Bundle.add(@second)
+
+    bundle = @user.notification_bundles.sole
+    assert_equal opened_at, bundle.starts_at
+    assert_equal [ @first, @second ].to_set, bundle.notifications.to_set
+  end
+
+  test "a notification landing just before its window closes still joins that window" do
+    freeze_time
+
+    Notification::Bundle.add(@first)
+    travel 1.day - 1.second
+    Notification::Bundle.add(@second)
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal [ @first, @second ].to_set, @user.notification_bundles.sole.notifications.to_set
+  end
+
+  test "notifier puts new notifications into the open window" do
+    notifications = Notifier.for(events(:layout_commented)).notify
+
+    bundle = @user.notification_bundles.sole
+    assert_equal notifications, bundle.notifications.to_a
+  end
+
+  test "a digest covers what the user was notified about during the window" do
+    freeze_time
+    Notifier.for(events(:layout_commented)).notify
+    travel 1.day
+
+    assert_emails 1 do
+      perform_enqueued_jobs { Notification::Bundle.deliver_due }
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_includes email.text_part.body.decoded, cards(:layout).title
+  end
+
+  test "deliver_due sends one digest per window that has closed" do
+    freeze_time
+    Notification::Bundle.add(@first)
+    Notification::Bundle.add(@second)
+    travel 1.day
+
+    assert_emails 1 do
+      perform_enqueued_jobs { Notification::Bundle.deliver_due }
+    end
+
+    assert @user.notification_bundles.sole.sent_at.present?
+  end
+
+  test "deliver_due leaves open windows alone" do
+    freeze_time
+    Notification::Bundle.add(@first)
+    travel 23.hours
+
+    assert_no_emails do
+      perform_enqueued_jobs { Notification::Bundle.deliver_due }
+    end
+
+    assert_nil @user.notification_bundles.sole.sent_at
+  end
+
+  test "each window is delivered only once" do
+    freeze_time
+    Notification::Bundle.add(@first)
+    travel 1.day
+
+    perform_enqueued_jobs { Notification::Bundle.deliver_due }
+
+    assert_no_emails do
+      perform_enqueued_jobs { Notification::Bundle.deliver_due }
+    end
+  end
+
+  test "a stale copy of a window that was already delivered sends nothing" do
+    freeze_time
+    Notification::Bundle.add(@first)
+    travel 1.day
+    stale = @user.notification_bundles.sole
+    perform_enqueued_jobs { Notification::Bundle.deliver_due }
+
+    assert_no_emails do
+      perform_enqueued_jobs { stale.deliver }
+    end
+  end
+
+  test "a window is closed without an email once the user turns digests off" do
+    freeze_time
+    Notification::Bundle.add(@first)
+    @user.settings.update!(bundle_email_frequency: "never")
+    travel 1.day
+
+    assert_no_emails do
+      perform_enqueued_jobs { Notification::Bundle.deliver_due }
+    end
+
+    assert @user.notification_bundles.sole.sent_at.present?
+  end
+
+  test "inactive users are not emailed" do
+    freeze_time
+    Notification::Bundle.add(@first)
+    @user.update!(active: false)
+    travel 1.day
+
+    assert_no_emails do
+      perform_enqueued_jobs { Notification::Bundle.deliver_due }
+    end
+  end
+
+  test "notifications removed before delivery are not emailed" do
+    freeze_time
+    Notification::Bundle.add(@first)
+    @first.destroy!
+    travel 1.day
+
+    assert_no_emails do
+      perform_enqueued_jobs { Notification::Bundle.deliver_due }
+    end
+
+    assert @user.notification_bundles.sole.sent_at.present?
+  end
+
+  test "notifications landing after delivery start a new window" do
+    freeze_time
+    Notification::Bundle.add(@first)
+    travel 1.day
+    perform_enqueued_jobs { Notification::Bundle.deliver_due }
+
+    Notification::Bundle.add(@second)
+
+    sent, open = @user.notification_bundles.order(:starts_at).to_a
+    assert_equal [ @first ], sent.notifications.to_a
+    assert_equal [ @second ], open.notifications.to_a
+    assert_nil open.sent_at
+  end
+
+  test "windows for a user never overlap, however landings and deliveries interleave" do
+    random = Random.new(42)
+    freeze_time
+
+    300.times do
+      if random.rand < 0.15
+        perform_enqueued_jobs { Notification::Bundle.deliver_due }
+      else
+        Notification::Bundle.add([ @first, @second, @third ].sample(random: random))
+      end
+
+      travel random.rand(0..(8 * 3600)).seconds
+    end
+
+    windows = @user.notification_bundles.order(:starts_at).to_a
+    assert_operator windows.size, :>, 1
+
+    windows.each_cons(2) do |earlier, later|
+      assert_operator later.starts_at, :>=, earlier.ends_at
+    end
+  end
+
+  test "removing a user removes their windows" do
+    Notification::Bundle.add(@first)
+
+    @user.destroy!
+
+    assert_equal 0, Notification::Bundle.where(user_id: @user.id).count
+    assert_equal 0, Notification::Bundle::Item.where(notification_id: @first.id).count
+  end
+end
