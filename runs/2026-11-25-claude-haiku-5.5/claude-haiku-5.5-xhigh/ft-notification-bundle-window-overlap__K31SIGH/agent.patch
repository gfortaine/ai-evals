@@ -0,0 +1,31 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @settings = users(:kevin).create_settings!
+  end
+
+  test "email digests are off by default" do
+    assert @settings.never?
+    assert_nil @settings.bundle_window
+  end
+
+  test "each digest frequency has a window length" do
+    @settings.update!(bundle_email_frequency: "every_few_hours")
+    assert_equal 4.hours, @settings.bundle_window
+
+    @settings.update!(bundle_email_frequency: "daily")
+    assert_equal 1.day, @settings.bundle_window
+
+    @settings.update!(bundle_email_frequency: "weekly")
+    assert_equal 1.week, @settings.bundle_window
+
+    @settings.update!(bundle_email_frequency: "never")
+    assert_nil @settings.bundle_window
+  end
+
+  test "rejects unknown frequencies" do
+    assert_not @settings.update(bundle_email_frequency: "hourly")
+    assert @settings.errors.of_kind?(:bundle_email_frequency, :inclusion)
+  end
+end
