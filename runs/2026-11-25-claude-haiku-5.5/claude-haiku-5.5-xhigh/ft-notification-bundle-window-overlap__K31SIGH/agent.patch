@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Notifications::BundleEmailFrequenciesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @settings = users(:kevin).create_settings!
+  end
+
+  test "update" do
+    patch notifications_bundle_email_frequency_path, params: { bundle_email_frequency: "daily" }
+
+    assert_redirected_to notifications_settings_path
+    assert @settings.reload.daily?
+  end
+
+  test "update can turn digests off" do
+    @settings.update!(bundle_email_frequency: "weekly")
+
+    patch notifications_bundle_email_frequency_path, params: { bundle_email_frequency: "never" }
+
+    assert_redirected_to notifications_settings_path
+    assert @settings.reload.never?
+  end
+
+  test "update rejects unknown frequencies" do
+    patch notifications_bundle_email_frequency_path, params: { bundle_email_frequency: "hourly" }
+
+    assert_response :unprocessable_entity
+    assert @settings.reload.never?
+  end
+end
