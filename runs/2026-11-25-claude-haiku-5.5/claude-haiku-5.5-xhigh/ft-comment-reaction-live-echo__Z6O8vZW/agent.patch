diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..2b2ba9c
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "content is required" do
+    reaction = @comment.reactions.build(content: "")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "whitespace-only content is blank" do
+    assert_not @comment.reactions.build(content: "   ").valid?
+  end
+
+  test "content is squished" do
+    reaction = @comment.reactions.create!(content: "  Great \n  👍  ")
+
+    assert_equal "Great 👍", reaction.content
+  end
+
+  test "content may be up to 16 characters" do
+    assert @comment.reactions.build(content: "a" * 16).valid?
+    assert_not @comment.reactions.build(content: "a" * 17).valid?
+  end
+
+  test "length counts characters, so emoji count as one" do
+    assert @comment.reactions.build(content: "👍" * 16).valid?
+    assert_not @comment.reactions.build(content: "👍" * 17).valid?
+  end
+
+  test "account comes from the comment" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "reacter defaults to the current user" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal users(:kevin), reaction.reacter
+  end
+
+  test "only the reacter can delete a reaction" do
+    reaction = reactions(:logo_agreement_kevin_jz)
+
+    assert reaction.deletable_by?(users(:jz))
+    assert_not reaction.deletable_by?(users(:kevin))
+  end
+
+  test "emoji_only?" do
+    assert @comment.reactions.build(content: "👍").emoji_only?
+    assert @comment.reactions.build(content: "❤️").emoji_only?
+    assert_not @comment.reactions.build(content: "Agreed").emoji_only?
+    assert_not @comment.reactions.build(content: "+1").emoji_only?
+  end
+
+  test "creating a reaction refreshes the card for viewers" do
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts(cards(:logo)) do
+        @comment.reactions.create!(content: "👍")
+      end
+    end
+  end
+
+  test "destroying the comment destroys its reactions" do
+    reaction_ids = @comment.reactions.pluck(:id)
+    assert_not_empty reaction_ids
+
+    @comment.destroy
+
+    assert_empty Reaction.where(id: reaction_ids)
+  end
+
+test "destroying the card destroys its comments and their reactions" do
+  card = cards(:logo)
+  reaction_ids = Reaction.joins(:comment).where(comments: { card_id: card.id }).pluck(:id)
+  assert_not_empty reaction_ids
+
+  card.destroy
+
+  assert_empty Reaction.where(id: reaction_ids)
+end
+
+  test "destroying the reacter destroys their reactions" do
+    reaction = reactions(:logo_agreement_kevin_jz)
+
+    users(:jz).destroy
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..a1d177e
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,117 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    Current.user = users(:kevin)
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "adding a reaction shows it in the strip and restores the button" do
+    visit card_url(@card)
+
+    within_strip do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("👍")
+      find(".reaction__input").send_keys(:enter)
+
+      assert_selector ".reaction", text: "👍"
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__trigger:focus"
+    end
+  end
+
+  test "cancelling or escaping the input discards the reaction" do
+    visit card_url(@card)
+
+    within_strip do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("Nope")
+      find(".reaction__cancel-btn").click
+
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__trigger"
+
+      find(".reactions__trigger").click
+      find(".reaction__input").set("Still nope")
+      find(".reaction__input").send_keys(:escape)
+
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_no_text "Nope"
+    assert_no_text "Still nope"
+  end
+
+  test "a reaction longer than 16 characters is refused and kept for editing" do
+    visit card_url(@card)
+
+    within_strip do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("a" * 17)
+      find(".reaction__input").send_keys(:enter)
+
+      assert_selector "[role=alert]", text: "too long"
+      assert_equal "a" * 17, find(".reaction__input").value
+    end
+  end
+
+  test "clicking your own reaction reveals a way to remove it" do
+    reaction = reactions(:logo_agreement_kevin_david)
+    visit card_url(@card)
+
+    within "##{dom_id(reaction)}" do
+      assert_no_button "Remove reaction"
+      find(".txt-small").click
+      click_button "Remove reaction"
+    end
+
+    assert_no_selector "##{dom_id(reaction)}"
+  end
+
+  test "a reaction made elsewhere appears without reloading" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    add_reaction_elsewhere("🙌")
+
+    assert_selector ".reaction", text: "🙌", wait: 5
+  end
+
+  test "a reaction made elsewhere keeps a reaction being typed" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    within_strip do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("Half-typed")
+    end
+
+    add_reaction_elsewhere("🙌")
+
+    assert_selector ".reaction", text: "🙌", wait: 5
+    within_strip do
+      assert_equal "Half-typed", find(".reaction__input").value
+    end
+  end
+
+  private
+    def within_strip(&block)
+      within "##{dom_id(@comment, :reactions)}", &block
+    end
+
+    def add_reaction_elsewhere(content)
+      @comment.reactions.create!(content: content)
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
