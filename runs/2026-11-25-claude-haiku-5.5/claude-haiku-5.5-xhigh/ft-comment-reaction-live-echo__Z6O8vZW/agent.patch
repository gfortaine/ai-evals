diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..a9893b5
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,64 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_card_is_commentable, only: :create
+  before_action :ensure_comment_is_reactable, only: :create
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = @comment.reactions
+  end
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params)
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { render :invalid, status: :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def ensure_comment_is_reactable
+      head :forbidden if @comment.creator.system?
+    end
+
+    def ensure_reacter
+      head :forbidden unless @reaction.deletable_by?(Current.user)
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_composer_controller.js b/app/javascript/controllers/reaction_composer_controller.js
new file mode 100644
index 0000000..35e1442
--- /dev/null
+++ b/app/javascript/controllers/reaction_composer_controller.js
@@ -0,0 +1,39 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Swaps the reaction button for an input and back. The open input is cloned
+// from a template and removed again on cancel, so the markup only contains a
+// .reaction while one is being composed (the strip's CSS keys off that).
+export default class extends Controller {
+  static targets = [ "trigger", "template", "form", "input" ]
+
+  #submitting = false
+
+  open() {
+    this.element.append(this.templateTarget.content.cloneNode(true))
+    this.triggerTarget.hidden = true
+  }
+
+  close() {
+    this.formTarget.remove()
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  submitting() {
+    this.#submitting = true
+  }
+
+  // The input is replaced by a fresh button once the reaction lands, so keep
+  // keyboard focus on it. Also runs when a failed submission re-renders the
+  // input open with its error, which takes focus instead (the button is hidden).
+  triggerTargetConnected(trigger) {
+    if (this.#submitting) {
+      trigger.focus()
+      this.#submitting = false
+    }
+  }
+
+  inputTargetConnected(input) {
+    input.focus()
+  }
+}
