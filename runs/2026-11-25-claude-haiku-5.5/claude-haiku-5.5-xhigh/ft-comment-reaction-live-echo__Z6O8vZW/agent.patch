+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal @comment.reactions.count, @response.parsed_body.count
+    assert_equal reactions(:logo_agreement_kevin_jz).id, @response.parsed_body.first["id"]
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal Reaction.last.content, "👍"
+    assert_equal users(:kevin), Reaction.last.reacter
+    assert_includes response.body, %(action="replace" target="#{dom_id(@comment, :reactions_list)}")
+    assert_includes response.body, %(action="update" target="#{dom_id(@comment, :reaction_composer)}")
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Agreed" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal card_comment_reaction_path(@card, @comment, Reaction.last, format: :json), @response.headers["Location"]
+    assert_equal Reaction.last.id, @response.parsed_body["id"]
+    assert_equal "Agreed", @response.parsed_body["content"]
+  end
+
+  test "create with content longer than 16 characters re-renders the composer with the error" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+    assert_includes response.body, %(action="update" target="#{dom_id(@comment, :reaction_composer)}")
+    assert_includes response.body, "is too long"
+    assert_includes response.body, %(value="#{"a" * 17}")
+  end
+
+  test "create with blank content as JSON is rejected" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "   " } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+    assert_includes @response.parsed_body["content"], "can't be blank"
+  end
+
+  test "create on a card that does not allow comments is forbidden" do
+    @card.update!(status: :drafted)
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+test "create on a system comment is forbidden" do
+  system_comment = comments(:logo_1)
+  assert system_comment.creator.system?
+
+  assert_no_difference -> { Reaction.count } do
+    post card_comment_reactions_path(@card, system_comment), params: { reaction: { content: "👍" } }, as: :json
+  end
+
+  assert_response :forbidden
+end
+
+  test "destroy own reaction" do
+    reaction = reactions(:logo_agreement_jz_kevin)
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(@card, comments(:logo_agreement_jz), reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_includes response.body, %(action="remove" target="#{dom_id(reaction)}")
+  end
+
+  test "destroy own reaction as JSON" do
+    reaction = reactions(:logo_agreement_jz_kevin)
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(@card, comments(:logo_agreement_jz), reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy someone else's reaction is forbidden" do
+    reaction = reactions(:logo_agreement_kevin_jz)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "the strip only offers removal for your own reactions" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(reactions(:logo_agreement_kevin_jz))}" do
+      assert_select ".reaction__delete", count: 0
+    end
+    assert_select "##{dom_id(reactions(:logo_agreement_jz_kevin))}" do
+      assert_select ".reaction__delete", count: 1
+    end
+  end
+
+  test "the strip shows the add button and each reacter" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)} .reactions__trigger", count: 1
+    assert_select "##{dom_id(reactions(:logo_agreement_kevin_david))} .reaction__avatar", count: 1
+  end
+end
