+    <figure class="reaction__avatar" aria-hidden="true">
+      <%= avatar_tag Current.user, hidden_for_screen_reader: true %>
+    </figure>
+
+    <%= form_with model: reaction, url: card_comment_reactions_path(comment.card, comment), id: dom_id(comment, :reaction_form),
