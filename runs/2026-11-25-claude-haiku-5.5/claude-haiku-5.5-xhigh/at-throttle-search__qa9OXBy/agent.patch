diff --git a/app/controllers/books/searches_controller.rb b/app/controllers/books/searches_controller.rb
index 5268c55..e7c92c1 100644
--- a/app/controllers/books/searches_controller.rb
+++ b/app/controllers/books/searches_controller.rb
@@ -3,7 +3,39 @@ class Books::SearchesController < ApplicationController
 
   include BookScoped
 
+  # Anyone can search a published book without signing in, so an address gets
+  # SEARCHES_PER_MINUTE searches in any one-minute stretch, across all books.
+  # Searches beyond that are refused until earlier ones age out of the window.
+  SEARCHES_PER_MINUTE = 30
+  THROTTLE_WINDOW = 60 # seconds
+
+  before_action :throttle_searches
+
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
+
+  private
+    # Each second has its own counter, bumped by every search attempt. An attempt
+    # is refused when the counters for the last minute, this attempt included,
+    # total more than the limit. Counters expire on their own, so an address that
+    # stops searching is served again within a minute.
+    def throttle_searches
+      if recent_search_attempts > SEARCHES_PER_MINUTE
+        response.headers["Retry-After"] = THROTTLE_WINDOW.to_s
+        render :throttled, status: :too_many_requests
+      end
+    end
+
+    def recent_search_attempts
+      now = Time.current.to_i
+      Rails.cache.increment(search_counter_key(now), 1, expires_in: THROTTLE_WINDOW)
+
+      keys = ((now - THROTTLE_WINDOW + 1)..now).map { |second| search_counter_key(second) }
+      Rails.cache.read_multi(*keys, raw: true).values.sum(&:to_i)
+    end
+
+    def search_counter_key(second)
+      "books/searches/#{request.remote_ip}/#{second}"
+    end
 end
