diff --git a/test/i18n/translations_test.rb b/test/i18n/translations_test.rb
new file mode 100644
index 0000000..7b28e80
--- /dev/null
+++ b/test/i18n/translations_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+# Keeps the translations complete: Japanese has every key English has, and every
+# translation key the code asks for exists in both languages.
+class TranslationsTest < ActiveSupport::TestCase
+  # The app's own strings. ja/rails.yml is Rails' Japanese defaults, checked separately.
+  LOCALE_FILES = ->(locale) { Dir[Rails.root.join("config/locales/#{locale}/**/*.yml")].reject { |file| file.end_with?("/rails.yml") } }
+
+  # Generic attribute names: English falls back to Rails' humanized names.
+  ENGLISH_DEFAULTS = /\Aattributes\./
+
+  test "Japanese has every key English has" do
+    english = keys_in(LOCALE_FILES.call("en"), "en")
+    japanese = keys_in(LOCALE_FILES.call("ja"), "ja")
+
+    assert_empty english - japanese, "Missing from ja: #{(english - japanese).first(20).join(", ")}"
+    assert_empty japanese.reject { |key| key.match?(ENGLISH_DEFAULTS) } - english, "Only in ja: #{(japanese - english).first(20).join(", ")}"
+  end
+
+  test "every key used by a template exists in English and Japanese" do
+    template_keys.each do |key|
+      assert I18n.exists?(key, :en), "Missing English translation for #{key}"
+      assert I18n.exists?(key, :ja), "Missing Japanese translation for #{key}"
+    end
+  end
+
+  test "every absolute translation key used by the code exists in English and Japanese" do
+    code_keys.each do |key|
+      assert I18n.exists?(key, :en), "Missing English translation for #{key}"
+      assert I18n.exists?(key, :ja), "Missing Japanese translation for #{key}"
+    end
+  end
+
+  private
+    def keys_in(files, locale)
+      files.flat_map do |file|
+        flatten(YAML.load_file(file).fetch(locale, {}))
+      end.sort.uniq
+    end
+
+    def flatten(hash, prefix = nil)
+      hash.flat_map do |key, value|
+        path = [ prefix, key ].compact.join(".")
+        value.is_a?(Hash) ? flatten(value, path) : path
+      end
+    end
+
+    # Views look keys up relative to where they live: app/views/boards/show/_column.html.erb
+    # asks for `boards.show.column.<key>`. Mailer views are relative to app/views/mailers.
+    def template_keys
+      view_roots.flat_map do |root|
+        Dir[root.join("**/*.erb")].flat_map do |file|
+          prefix = lazy_prefix(Pathname(file).relative_path_from(root))
+          File.read(file).scan(/\bt\(\s*"\.([a-z0-9_.]+)"/).flatten.map { |key| "#{prefix}.#{key}" }
+        end
+      end.uniq
+    end
+
+    def lazy_prefix(relative)
+      parts = relative.to_s.sub(%r{\Amailers/}, "").split("/")
+      parts[-1] = parts[-1].sub(/\A_/, "").sub(/\..*\z/, "")
+      parts.join(".")
+    end
+
+    def code_keys
+      Dir[Rails.root.join("{app,lib,saas/app,saas/lib}/**/*.{rb,erb}")].flat_map do |file|
+        File.read(file).scan(/(?<![\w.])(?:I18n\.)?t\(\s*"([a-z][a-z0-9_]*(?:\.[a-z0-9_]+)+)"/).flatten
+      end.uniq
+    end
+
+    def view_roots
+      [ Rails.root.join("app/views"), Rails.root.join("saas/app/views") ].select(&:exist?)
+    end
+end
diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..9b913a5
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,140 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  setup do
+    @slug = ActiveRecord::FixtureSet.identify("37signals")
+  end
+
+  test "a supported locale in the URL switches the page and is remembered for the browser session" do
+    untenanted do
+      get new_session_path(locale: "ja")
+
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_equal "ja", cookies[:locale]
+    end
+
+    untenanted do
+      get new_session_path
+
+      assert_select "html[lang=ja]"
+    end
+  end
+
+  test "an unsupported locale is ignored and never breaks the page" do
+    untenanted do
+      get new_session_path(locale: "xx")
+
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_nil cookies[:locale]
+    end
+  end
+
+  test "a malformed locale parameter is ignored" do
+    untenanted do
+      get new_session_path(locale: [ "ja", "xx" ])
+      assert_response :success
+      assert_select "html[lang=en]"
+
+      get new_session_path(locale: { nested: "ja" })
+      assert_response :success
+      assert_select "html[lang=en]"
+    end
+  end
+
+  test "people who never chose a language get English" do
+    untenanted { get new_session_path }
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_nil cookies[:locale]
+  end
+
+  test "a choice made while signed in is kept on the identity" do
+    sign_in_as :kevin
+
+    get "/#{@slug}/?locale=ja"
+
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "a choice made while signed in applies again from a clean browser" do
+    sign_in_as :kevin
+    get "/#{@slug}/?locale=ja"
+
+    reset!
+    sign_in_as :kevin
+
+    get "/#{@slug}/"
+    assert_select "html[lang=ja]"
+  end
+
+  test "choosing another language changes the one kept on the identity" do
+    sign_in_as :kevin
+    get "/#{@slug}/?locale=ja"
+    get "/#{@slug}/?locale=en"
+
+    assert_equal "en", identities(:kevin).reload.locale
+    assert_select "html[lang=en]"
+  end
+
+  test "a choice made before signing in carries over to the identity when signing in" do
+    untenanted { get new_session_path(locale: "ja") }
+    sign_in_as :kevin
+
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "an identity's language overrides the browser's leftover choice when signed in" do
+    identities(:kevin).update!(locale: "en")
+    sign_in_as :kevin
+    cookies[:locale] = "ja"
+
+    get "/#{@slug}/"
+    assert_select "html[lang=en]"
+  end
+end
+
+class LocaleInterfaceTest < ActionDispatch::IntegrationTest
+  setup do
+    @slug = ActiveRecord::FixtureSet.identify("37signals")
+  end
+
+  test "the page carries its strings for the scripts that render dates and labels" do
+    sign_in_as :kevin
+    get "/#{@slug}/?locale=ja"
+
+    strings = JSON.parse(Nokogiri::HTML5(response.body).at_css("script[data-translations]").text)
+    assert_equal "ja", strings["locale"]
+    assert_equal "%{count}日前", strings.dig("strings", "time", "ago", "day", "other")
+  end
+
+  test "public pages depend on the language, so shared caches must vary on cookies" do
+    board = boards(:writebook)
+    board.publish
+    untenanted { get "/#{@slug}/public/boards/#{board.reload.publication.key}?locale=ja" }
+
+    assert_response :success
+    assert_includes response.headers["Vary"].split(", "), "Cookie"
+    assert_select "html[lang=ja]"
+  end
+
+  test "the web app manifest is in the language of the person asking" do
+    sign_in_as :kevin
+    get "/#{@slug}/?locale=ja"
+
+    get "/manifest.json"
+
+    assert_response :success
+    assert_equal "プロジェクトの重要な課題を、カードで整理しましょう", JSON.parse(response.body)["description"]
+  end
+
+  test "the static error pages are written in both languages" do
+    %w[ 400 404 406-unsupported-browser 422 500 ].each do |page|
+      html = File.read(Rails.root.join("public", "#{page}.html"))
+      assert_match(/lang="ja"/, html, "#{page} needs Japanese")
+      assert_match(/lang="en"|<html lang="en">/, html, "#{page} needs English")
+    end
+  end
+end
diff --git a/test/mailers/localized_mailers_test.rb b/test/mailers/localized_mailers_test.rb
new file mode 100644
index 0000000..3963ce6
--- /dev/null
+++ b/test/mailers/localized_mailers_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class LocalizedMailersTest < ActionMailer::TestCase
+  test "a magic link is written in the language the person chose" do
+    identities(:kevin).update!(locale: "ja")
+    magic_link = identities(:kevin).magic_links.create!(purpose: "sign_in")
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Fizzyの確認コードは #{magic_link.code} です", email.subject
+    assert_match "確認コード", email.text_part.body.to_s
+    assert_equal "ja", Nokogiri::HTML5(email.html_part.body.to_s).at_css("html")["lang"]
+  end
+
+  test "a magic link for someone new is in the language they were browsing in" do
+    magic_link = identities(:kevin).magic_links.create!(purpose: "sign_up")
+
+    I18n.with_locale(:ja) do
+      email = MagicLinkMailer.sign_in_instructions(magic_link)
+      assert_match "Fizzyへようこそ", email.html_part.body.to_s
+    end
+  end
+
+  test "people who never chose a language get English" do
+    magic_link = identities(:kevin).magic_links.create!(purpose: "sign_in")
+
+    I18n.with_locale(:en) do
+      email = MagicLinkMailer.sign_in_instructions(magic_link)
+      assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+    end
+  end
+
+  test "notification digests are in the recipient's language, not the sender's" do
+    david = users(:david)
+    david.identity.update!(locale: "ja")
+    david.notifications.destroy_all
+    bundle = Notification::Bundle.create!(user: david, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+    Notification.create!(user: david, creator: users(:kevin), source: events(:logo_published), created_at: 30.minutes.ago)
+
+    email = I18n.with_locale(:en) { Notification::BundleMailer.notification(bundle) }
+
+    assert_equal "Fizzy: 新しい通知", email.subject
+    assert_match "新着通知", email.text_part.body.to_s
+  end
+
+  test "push notifications are in the recipient's language" do
+    david = users(:david)
+    david.identity.update!(locale: "ja")
+    david.notifications.destroy_all
+    notification = Notification.create!(user: david, creator: users(:kevin), source: events(:logo_published))
+
+    payload = Notification::PushTarget::Web.new(notification).send(:payload)
+
+    assert_match "さんが追加", payload[:body]
+  end
+end
