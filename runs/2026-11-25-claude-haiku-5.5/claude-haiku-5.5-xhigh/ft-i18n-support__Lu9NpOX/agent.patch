diff --git a/app/javascript/helpers/translations.js b/app/javascript/helpers/translations.js
new file mode 100644
index 0000000..164add0
--- /dev/null
+++ b/app/javascript/helpers/translations.js
@@ -0,0 +1,33 @@
+// The strings the page needs, translated into the locale the page was rendered
+// in. The server embeds them in <body> (see layouts/shared/_translations) and
+// Turbo replaces <body> on every visit, so they always match the current page.
+
+let cache = null
+
+export function locale() {
+  return translations().locale
+}
+
+// translate("time.ago.minute", { count: 2 }). Plural forms are keyed "one" and
+// "other", as in the locale files. Without the embedded strings, the key is
+// returned so the page still renders something readable.
+export function translate(key, values = {}) {
+  const found = key.split(".").reduce((node, part) => node?.[part], translations().strings)
+  const template = (found && typeof found === "object") ? found[values.count === 1 ? "one" : "other"] : found
+
+  return (template ?? key).replace(/%\{(\w+)\}/g, (_, name) => values[name] ?? "")
+}
+
+function translations() {
+  const element = document.querySelector("script[data-translations]")
+
+  if (!element) {
+    return { locale: "en", strings: {} }
+  }
+
+  if (!cache || cache.element !== element) {
+    cache = { element, data: JSON.parse(element.textContent) }
+  }
+
+  return cache.data
+}
