@@ -0,0 +1,39 @@
+require "application_system_test_case"
+
+class JapaneseTest < ApplicationSystemTestCase
+  test "a person who chose Japanese sees the board in Japanese, with Japanese times" do
+    sign_in_as(users(:david))
+
+    visit board_url(boards(:writebook), locale: "ja")
+
+    assert_selector "html[lang='ja']"
+    assert_no_text "Translation missing"
+    assert_selector ".card__meta-text--added", text: "追加"
+    assert_selector "time", text: /今日|昨日|日前|時間前|分前|たった今/
+  end
+
+  test "signing in in Japanese shows the sign-in page in Japanese" do
+    visit new_session_url(locale: "ja", script_name: nil)
+
+    assert_selector "html[lang='ja']"
+    assert_selector "h1", text: "Fizzyにログイン"
+    assert_selector "input[placeholder='メールアドレスを入力…']"
+  end
+end
+
+class JapaneseScriptsTest < ApplicationSystemTestCase
+  test "the interface's shared text helpers speak Japanese" do
+    visit new_session_url(locale: "ja", script_name: nil)
+
+    assert_equal "3分前", evaluate_async_script(<<~JS)
+      const done = arguments[arguments.length - 1]
+      import("helpers/translations").then(({ translate }) => done(translate("time.ago.minute", { count: 3 })))
+    JS
+    assert_equal "A、B、またはC", evaluate_async_script(<<~JS)
+      const done = arguments[arguments.length - 1]
+      Promise.all([import("helpers/text_helpers"), import("helpers/translations")]).then(([{ toSentence }, { translate }]) => {
+        done(toSentence(["A", "B", "C"], { two_words_connector: translate("sentence.or.two_words_connector"), last_word_connector: translate("sentence.or.last_word_connector") }))
+      })
+    JS
+  end
+end
