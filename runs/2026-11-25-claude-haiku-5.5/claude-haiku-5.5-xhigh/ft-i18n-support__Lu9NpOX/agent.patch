@@ -0,0 +1,62 @@
+# The Playground board every new account starts with. Its cards explain Fizzy
+# using the labels of the interface, so they are written for each language.
+ja:
+  seeds:
+    playground:
+      board: "Playground"
+      cards:
+        - title: "最後に、Fizzyのオリエンテーション動画を見てみましょう"
+          description: |
+            <p>Fizzyではほかにもさまざまなことができます。下の動画では、37signalsの創業者でCEOのJason Friedが、わずか17分で基本を説明します。</p>
+            <action-text-attachment url="https://videos.37signals.com/fizzy/assets/videos/fizzyorientation-4k.mp4" caption="Fizzyのオリエンテーション" content-type="video/mp4" filename="fizzyorientation-4k.mp4"></action-text-attachment>
+        - title: "次に、パスキーを設定しましょう"
+          description: |
+            <p>パスキーを使うと、パスワードやメールの確認コードを使わずに安全にログインできます。設定するには、Fizzyメニューを開き、「<b><strong>マイプロフィール > パスキーを管理</b></strong>」に移動してください。パスキーの利用は任意ですが、設定をおすすめします。</p>
+            <action-text-attachment url="https://videos.37signals.com/fizzy/assets/videos/creating_a_passkey.mp4" alt="パスキーの追加のデモ" caption="パスワードやメールの確認コードなしでログインできるよう、パスキーを作成しましょう" content-type="video/mp4" filename="creating_a_passkey.mp4"></action-text-attachment>
+        - title: "次に、招待リンクを取得して、ほかの人を招待しましょう"
+          description: |
+            <p>Fizzyメニューを開き、「<b><strong>+ メンバーを招待</b></strong>」を選択してから、招待リンクをコピーします。このリンクを相手に渡すと、相手はあなたのアカウントに自分用のログインを作成できます。</p>
+            <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/invite-link.gif" alt="招待リンクをコピーするデモ" caption="同僚を招待するためのリンクを取得" content-type="image/*" filename="invite-link.gif" presentation="gallery"></action-text-attachment>
+        - title: "次に、ホームに戻ってアクティビティを確認しましょう"
+          description: |
+            <p>「1」キーを押すか、Fizzyメニューを開いて「ホーム」を選択します。</p>
+            <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/back-to-home.gif" alt="ホームに移動するデモ" caption="最新のアクティビティを見るためにホームに戻る" content-type="image/*" filename="back-to-home.gif" presentation="gallery"></action-text-attachment>
+        - title: "次に、自分が担当しているカードをすべて確認しましょう"
+          description: |
+            <p>画面上部のFizzyメニューを開いて「<b><strong>自分が担当</b></strong>」を選択するか、いつでもキーボードの「2」キーを押してください。</p>
+            <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/all-assigned.gif" alt="「自分が担当」に移動するデモ" caption="自分が担当するすべてのカードを表示" content-type="image/*" filename="all-assigned.gif" presentation="gallery"></action-text-attachment>
+        - title: "次に、Fizzyメニューを開きましょう"
+          description: |
