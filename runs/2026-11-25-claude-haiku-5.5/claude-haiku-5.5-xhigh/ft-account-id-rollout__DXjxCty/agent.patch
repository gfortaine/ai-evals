+    # Fills in account_id for rows that don't point at a real account yet.
+    def derive(table, *owners)
+      value = owners.one? ? "(#{owners.first})" : "COALESCE(#{owners.map { |owner| "(#{owner})" }.join(", ")})"
+
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = #{value}
+        WHERE NOT EXISTS (SELECT 1 FROM accounts WHERE accounts.id = #{table}.account_id)
+      SQL
+    end
