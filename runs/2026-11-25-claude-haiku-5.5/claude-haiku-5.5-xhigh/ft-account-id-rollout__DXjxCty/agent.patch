+        owner_of("active_storage_attachments", "cards", "record_id", type: [ "record_type", "Card" ]),
+        owner_of("active_storage_attachments", "action_text_rich_texts", "record_id", type: [ "record_type", "ActionText::RichText" ]),
+        owner_of("active_storage_attachments", "users", "record_id", type: [ "record_type", "User" ]),
+        owner_of("active_storage_attachments", "exports", "record_id", type: [ "record_type", "Export" ]),
+        owner_of("active_storage_attachments", "account_imports", "record_id", type: [ "record_type", "Account::Import" ])
+      ]
+      variant_attachment_owner = owner_of("active_storage_attachments", "active_storage_variant_records", "record_id",
