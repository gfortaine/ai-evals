+    # Deletes rows still without a real account, plus any rows matching the extra orphan conditions.
+    def prune(table, *orphaned_when)
+      conditions = [ missing(table, "account_id", "accounts"), *orphaned_when ]
+
+      deleted = connection.delete(<<~SQL)
+        DELETE FROM #{table}
+        WHERE #{conditions.map { |condition| "(#{condition})" }.join(" OR ")}
+      SQL
+
+      say "#{table}: dropped #{deleted} orphaned row(s)" if deleted.positive?
+    end
+
+    # SQL yielding the account of the parent row that `column` on `child` points at.
+    def owner_of(child, parent, column, type: nil, account_column: "account_id")
+      condition = "#{parent}.id = #{child}.#{column}"
+      condition += " AND #{child}.#{type.first} = '#{type.last}'" if type
+
+      "SELECT #{parent}.#{account_column} FROM #{parent} WHERE #{condition}"
+    end
+
+    # SQL true for rows whose `column` points at a row that no longer exists.
+    def missing(child, column, parent)
+      "NOT EXISTS (SELECT 1 FROM #{parent} WHERE #{parent}.id = #{child}.#{column})"
