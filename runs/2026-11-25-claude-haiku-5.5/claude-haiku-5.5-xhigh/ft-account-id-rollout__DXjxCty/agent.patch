+      derive "active_storage_blobs", blob_owner
+      derive "active_storage_variant_records", owner_of("active_storage_variant_records", "active_storage_blobs", "blob_id")
+      derive "active_storage_attachments", *attachment_owners, variant_attachment_owner
+      derive "active_storage_blobs", blob_owner
+
+      prune "active_storage_attachments", missing("active_storage_attachments", "blob_id", "active_storage_blobs")
+      prune "active_storage_variant_records", missing("active_storage_variant_records", "blob_id", "active_storage_blobs")
+      prune "active_storage_blobs"
+    end
+
+    def settle(table, *owners, requires: [])
+      derive(table, *owners) if owners.any?
+      prune(table, *requires)
+    end
