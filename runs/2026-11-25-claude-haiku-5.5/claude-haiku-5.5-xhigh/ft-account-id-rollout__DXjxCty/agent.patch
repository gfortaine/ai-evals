+    settle "cards", owner_of("cards", "boards", "board_id")
+    settle "columns", owner_of("columns", "boards", "board_id")
+    settle "events", owner_of("events", "boards", "board_id")
+    settle "webhooks", owner_of("webhooks", "boards", "board_id")
+    settle "accesses", owner_of("accesses", "boards", "board_id"),
+      requires: [ missing("accesses", "user_id", "users") ]
+    settle "board_publications", owner_of("board_publications", "boards", "board_id")
+    settle "entropies",
+      owner_of("entropies", "accounts", "container_id", type: [ "container_type", "Account" ], account_column: "id"),
+      owner_of("entropies", "boards", "container_id", type: [ "container_type", "Board" ])
+    settle "storage_totals",
+      owner_of("storage_totals", "accounts", "owner_id", type: [ "owner_type", "Account" ], account_column: "id"),
+      owner_of("storage_totals", "boards", "owner_id", type: [ "owner_type", "Board" ])
+
+    settle "filters", owner_of("filters", "users", "creator_id")
+    settle "notifications", owner_of("notifications", "users", "user_id")
+    settle "notification_bundles", owner_of("notification_bundles", "users", "user_id")
+    settle "push_subscriptions", owner_of("push_subscriptions", "users", "user_id")
+    settle "user_settings", owner_of("user_settings", "users", "user_id")
+    settle "search_queries", owner_of("search_queries", "users", "user_id")
+
+    settle "comments", owner_of("comments", "cards", "card_id")
+    settle "steps", owner_of("steps", "cards", "card_id")
+    settle "assignments", owner_of("assignments", "cards", "card_id"),
+      requires: [ missing("assignments", "assignee_id", "users"), missing("assignments", "assigner_id", "users") ]
+    settle "card_activity_spikes", owner_of("card_activity_spikes", "cards", "card_id")
+    settle "card_goldnesses", owner_of("card_goldnesses", "cards", "card_id")
+    settle "card_not_nows", owner_of("card_not_nows", "cards", "card_id")
+    settle "closures", owner_of("closures", "cards", "card_id")
+    settle "pins", owner_of("pins", "cards", "card_id"),
+      requires: [ missing("pins", "user_id", "users") ]
+    settle "taggings", owner_of("taggings", "cards", "card_id"),
+      requires: [ missing("taggings", "tag_id", "tags") ]
+    settle "watches", owner_of("watches", "cards", "card_id"),
+      requires: [ missing("watches", "user_id", "users") ]
