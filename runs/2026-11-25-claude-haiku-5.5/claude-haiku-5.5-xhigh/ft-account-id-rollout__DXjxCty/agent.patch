diff --git a/test/models/tenant_tables_test.rb b/test/models/tenant_tables_test.rb
new file mode 100644
index 0000000..7b09f0a
--- /dev/null
+++ b/test/models/tenant_tables_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class TenantTablesTest < ActiveSupport::TestCase
+  # Every table that holds an account's data. Each one requires account_id and indexes it.
+  TENANT_TABLES = %w[
+    account_cancellations
+    account_imports
+    account_join_codes
+    action_text_rich_texts
+    active_storage_attachments
+    active_storage_blobs
+    active_storage_variant_records
+    accesses
+    assignments
+    board_publications
+    boards
+    card_activity_spikes
+    card_goldnesses
+    card_not_nows
+    cards
+    closures
+    columns
+    comments
+    entropies
+    events
+    exports
+    filters
+    mentions
+    notification_bundles
+    notifications
+    pins
+    push_subscriptions
+    reactions
+    search_queries
+    steps
+    storage_entries
+    storage_totals
+    taggings
+    tags
+    user_settings
+    users
+    watches
+    webhook_deliveries
+    webhook_delinquency_trackers
+    webhooks
+  ].freeze
+
+  test "account_id is required on every tenant table" do
+    TENANT_TABLES.each do |table|
+      column = ActiveRecord::Base.connection.columns(table).find { |c| c.name == "account_id" }
+
+      assert column, "#{table} has no account_id column"
+      assert_not column.null, "#{table}.account_id should be NOT NULL"
+    end
+  end
+
+  test "account_id is indexed on every tenant table" do
+    TENANT_TABLES.each do |table|
+      indexed = ActiveRecord::Base.connection.indexes(table).any? { |index| index.columns.first == "account_id" }
+
+      assert indexed, "#{table} has no index leading with account_id"
+    end
+  end
+end
