+      owner_of("action_text_rich_texts", "comments", "record_id", type: [ "record_type", "Comment" ]),
+      owner_of("action_text_rich_texts", "boards", "record_id", type: [ "record_type", "Board" ])
+
+    settle "mentions",
+      owner_of("mentions", "cards", "source_id", type: [ "source_type", "Card" ]),
+      owner_of("mentions", "comments", "source_id", type: [ "source_type", "Comment" ]),
+      requires: [ missing("mentions", "mentioner_id", "users"), missing("mentions", "mentionee_id", "users") ]
+
