diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..6600c57
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  include DataTransferTestHelper
+
+  setup do
+    @archive = export_account_to_file(accounts("37s"))
+  end
+
+  test "the import page is available to anyone signed in, outside any account" do
+    sign_in_as :kevin
+
+    with_multi_tenant_mode(true) { untenanted { get new_account_import_path } }
+
+    assert_response :ok
+    assert_select "input[type=file][name=file]"
+    assert_select "form[action=?]", account_imports_path(script_name: nil)
+  end
+
+  test "the import page asks people to sign in first" do
+    untenanted { get new_account_import_path }
+
+    assert_redirected_to %r{/session/new}
+  end
+
+  test "uploading an export starts an import for the signed-in person" do
+    sign_in_as :kevin
+
+    assert_difference -> { Account::Import.count }, 1 do
+      assert_enqueued_with(job: Account::Import::ProcessJob) do
+        with_multi_tenant_mode(true) { untenanted { post account_imports_path, params: { file: uploaded_zip(@archive) } } }
+      end
+    end
+
+    import = Account::Import.last
+    assert_equal identities(:kevin), import.identity
+    assert import.pending?
+    assert_equal "export.zip", import.filename
+    assert_redirected_to session_menu_path(script_name: nil)
+    assert_match "email you", flash[:notice]
+  end
+
+  test "uploading something that isn't a zip is turned away" do
+    sign_in_as :kevin
+    text = Rack::Test::UploadedFile.new(StringIO.new("hello"), "text/plain", original_filename: "notes.txt")
+
+    assert_no_difference -> { Account::Import.count } do
+      untenanted { post account_imports_path, params: { file: text } }
+    end
+
+    assert_redirected_to new_account_import_path(script_name: nil)
+    assert_match "exported from Fizzy", flash[:alert]
+  end
+
+  test "a single-tenant Fizzy that already has an account doesn't take another one" do
+    sign_in_as :kevin
+
+    with_multi_tenant_mode(false) do
+      assert_no_difference -> { Account::Import.count } do
+        untenanted { post account_imports_path, params: { file: uploaded_zip(@archive) } }
+      end
+
+      untenanted { get new_account_import_path }
+    end
+
+    assert_redirected_to session_menu_path(script_name: nil)
+    assert_match "isn't accepting new accounts", flash[:alert]
+  end
+
+  test "the import form is only for people who are signed in" do
+    assert_no_difference -> { Account::Import.count } do
+      untenanted { post account_imports_path, params: { file: uploaded_zip(@archive) } }
+    end
+
+    assert_response :redirect
+  end
+
+  private
+    def uploaded_zip(archive)
+      Rack::Test::UploadedFile.new(archive.path, "application/zip", original_filename: "export.zip")
+    end
+end
