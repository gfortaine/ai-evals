@@ -0,0 +1,77 @@
+require "test_helper"
+
+class User::ExportTest < ActiveSupport::TestCase
+  include DataTransferTestHelper
+
+  setup do
+    Current.session = sessions(:david)
+
+    @david = users(:david)
+    @card = cards(:logo)
+    @picture = "the logo, as a picture"
+    @card.image.attach io: StringIO.new(@picture), filename: "logo.png", content_type: "image/png"
+
+    @note = "a note attached to a comment"
+    @note_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new(@note), filename: "note.txt", content_type: "text/plain")
+    @comment = @card.comments.create!(creator: users(:kevin), body: %(<div>See #{ActionText::Attachment.from_attachable(@note_blob).to_html}</div>))
+  end
+
+  test "exports the published cards this person can see, as one JSON file per card" do
+    entries = archive_entries(export_cards_to_file(@david))
+
+    assert_equal "manifest.json", entries.first
+    assert_includes entries, "cards/#{@card.number}.json"
+    assert_includes entries, "cards/#{cards(:layout).number}.json"
+  end
+
+  test "leaves out cards on boards this person doesn't have access to" do
+    private_card = boards(:private).cards.create!(title: "Secret plans", creator: users(:kevin), status: "published")
+    archive = export_cards_to_file(@david)
+
+    assert_not_includes archive_entries(archive), "cards/#{private_card.number}.json"
+  end
+
+  test "each card includes its details and its comments" do
+    card_json = JSON.parse(read_archive_entry(export_cards_to_file(@david), "cards/#{@card.number}.json"))
+
+    assert_equal @card.title, card_json["title"]
+    assert_equal "Writebook", card_json["board"]
+    assert_equal @card.creator.name, card_json["creator"]
+
+    comment = card_json["comments"].find { it["body_text"].include?("[note.txt]") }
+    assert_equal "Kevin", comment["creator"]
+    assert_equal [ "note.txt" ], comment["attachments"].map { it["filename"] }
+    assert_includes card_json["comments"].map { it["body_text"] }.join, "[note.txt]"
+  end
+
+  test "every picture and file attached to a card or its comments is included" do
+    archive = export_cards_to_file(@david)
+    card_json = JSON.parse(read_archive_entry(archive, "cards/#{@card.number}.json"))
+
+    picture = card_json["attachments"].find { it["filename"] == "logo.png" }
+    note = card_json["comments"].flat_map { it["attachments"] }.find { it["filename"] == "note.txt" }
+
+    assert picture, "the card's picture should be listed"
+    assert note, "the file embedded in a comment should be listed"
+    assert_equal @picture, read_archive_entry(archive, picture["path"])
+    assert_equal @note, read_archive_entry(archive, note["path"])
+  end
+
+  test "a file that is embedded more than once is written to the archive once" do
+    cards(:layout).comments.create!(creator: users(:kevin), body: %(<div>Same note: #{ActionText::Attachment.from_attachable(@note_blob).to_html}</div>))
+
+    entries = archive_entries(export_cards_to_file(@david))
+
+    assert_equal 1, entries.grep(%r{\Afiles/#{@note_blob.id}/}).size
+  end
+
+  test "the person who asked is emailed a link, which works only for them and for a day" do
+    export = User::Export.create!(user: @david, account: @david.account)
+    export.process_now
+
+    assert export.completed?
+    assert export.accessible_to?(@david)
+    assert_not export.accessible_to?(users(:kevin))
+    assert_in_delta 1.day.from_now, export.expires_at, 1.minute
+  end
+end
