diff --git a/app/models/account/data_transfer/purge.rb b/app/models/account/data_transfer/purge.rb
new file mode 100644
index 0000000..e088467
--- /dev/null
+++ b/app/models/account/data_transfer/purge.rb
@@ -0,0 +1,70 @@
+# Removes everything stored for an account, including its files. Used to roll back an import that
+# couldn't be completed, so nothing is left behind. Rows are deleted by account ID rather than through
+# the models, so nothing else runs as a side effect.
+class Account::DataTransfer::Purge
+  # The import record keeps track of the account it created, so it has to outlive the purge.
+  KEPT_TABLES = %w[ account_imports ].freeze
+
+  attr_reader :account_id
+
+  def initialize(account_id)
+    @account_id = account_id
+  end
+
+  def call
+    files = ::ActiveStorage::Blob.where(account_id: account_id).pluck(:service_name, :key)
+
+    ApplicationRecord.transaction do
+      delete_storage_totals
+      delete_search_index
+      account_tables.each { |table| delete_rows(table) }
+      connection.delete("DELETE FROM #{connection.quote_table_name("accounts")} WHERE id = #{quoted_account_id}")
+    end
+
+    files.each { |service_name, key| delete_file(service_name, key) }
+  end
+
+  private
+    def connection
+      ApplicationRecord.connection
+    end
+
+    # Hex literals are the same in SQLite and MySQL, and keep the statement free of binary strings.
+    def quoted_account_id
+      "X'#{ActiveRecord::Type::Uuid.base36_to_hex(account_id)}'"
+    end
+
+    def delete_storage_totals
+      board_ids = Board.where(account_id: account_id).select(:id)
+
+      Storage::Total.where(owner_type: "Account", owner_id: account_id).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: board_ids).delete_all
+    end
+
+    # SQLite keeps full-text search in a separate table keyed by the search record's ID, which has to go first.
+    def delete_search_index
+      return unless Fizzy.db_adapter.sqlite?
+
+      connection.delete(
+        "DELETE FROM search_records_fts WHERE rowid IN (SELECT id FROM search_records WHERE account_id = #{quoted_account_id})"
+      )
+    end
+
+    def account_tables
+      connection.tables.reject { |table| KEPT_TABLES.include?(table) }.select do |table|
+        connection.columns(table).any? { |column| column.name == "account_id" }
+      end
+    end
+
+    def delete_rows(table)
+      connection.delete(
+        "DELETE FROM #{connection.quote_table_name(table)} WHERE #{connection.quote_column_name("account_id")} = #{quoted_account_id}"
+      )
+    end
+
+    def delete_file(service_name, key)
+      ::ActiveStorage::Blob.services.fetch(service_name).delete(key)
+    rescue StandardError => error
+      Rails.error.report(error, handled: true, severity: :warning)
+    end
+end
