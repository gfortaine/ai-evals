+# Everything in an account, as an archive that can be imported into any Fizzy instance.
+class Account::Export < Export
+  private
+    def write_archive(zip)
+      Account::DataTransfer::Manifest.new(account).write_to(zip)
+    end
+
+    def archive_name
+      "#{account.name.parameterize.presence || "account"}-export"
