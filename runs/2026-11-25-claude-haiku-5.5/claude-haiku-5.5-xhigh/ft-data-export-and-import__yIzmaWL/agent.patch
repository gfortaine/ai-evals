+class ExportMailer < ApplicationMailer
+  def completed(export)
+    @export = export
+    @account = export.account
+    @download_url = export_url(export, script_name: @account.slug)
+    @expires_at = export.expires_at
+
+    mail to: export.user.identity.email_address, subject: subject_for(export, ready: true)
+  end
+
+  def failed(export)
+    @export = export
+    @account = export.account
+
+    mail to: export.user.identity.email_address, subject: subject_for(export, ready: false)
+  end
+
+  private
+    def subject_for(export, ready:)
+      kind = export.is_a?(Account::Export) ? "account" : "cards"
+
+      if ready
+        "Your Fizzy #{kind} export is ready to download"
+      else
+        "Your Fizzy #{kind} export couldn't be created"
+      end
+    end
+end
