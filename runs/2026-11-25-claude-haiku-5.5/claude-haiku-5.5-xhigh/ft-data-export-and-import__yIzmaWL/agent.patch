+# Public board links are identified by a key that has to be unique, so an imported board keeps its
+# key unless this instance already uses it.
+class Account::DataTransfer::BoardPublicationRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account)
+    super(account: account, model: Board::Publication)
+  end
+
+  private
+    def import_row(data, import)
+      super.tap do |row|
+        row["key"] = fresh_key(row["key"])
+      end
+    end
+
+    def fresh_key(key)
+      key = SecureRandom.base58(24) while Board::Publication.exists?(key: key)
+      key
+    end
+end
