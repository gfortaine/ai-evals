+      end
+
+      # Returns up to +length+ decompressed bytes, or nil once the entry is exhausted.
+      def read(length = nil)
+        if length
+          fill until @pending.bytesize >= length || @finished
+          return nil if @pending.empty? && length.positive?
+
+          @pending.slice!(0, length)
+        else
+          fill until @finished
+          @pending.slice!(0, @pending.bytesize)
+        end
+      end
+
+      def readpartial(maxlen, outbuf = nil)
+        read(maxlen).tap do |bytes|
+          raise EOFError, "end of entry" if bytes.nil?
+          outbuf&.replace(bytes)
+        end
+      end
+
+      def each_line
+        buffer = "".b
+
+        while (chunk = read(CHUNK_SIZE))
+          lines = (buffer + chunk).split("\n", -1)
+          buffer = lines.pop.b
+          lines.each { |line| yield line.force_encoding(Encoding::UTF_8) }
+        end
+
+        yield buffer.force_encoding(Encoding::UTF_8) unless buffer.empty?
+      end
+
+      # Discards whatever is left of this entry so the reader can move on to the next one.
+      def skip
+        while read(CHUNK_SIZE)
+        end
+      end
+
+      # Wraps the entry as an IO-like object that reports its size, for services that need it.
+      def with_size(size)
+        SizedEntry.new(self, size)
+      end
+
+      private
+        def fill
+          return if @finished
+
+          if @method == STORED
+            fill_stored
+          else
+            fill_deflated
+          end
+        end
+
+        def fill_stored
+          remaining = @expected_uncompressed_size - @uncompressed_total
+          return finish if remaining.zero?
+
+          chunk = @reader.read_up_to([ remaining, CHUNK_SIZE ].min)
+          raise ZipFile::InvalidArchive, "#{name} is truncated" if chunk.empty?
+
+          @compressed_total += chunk.bytesize
