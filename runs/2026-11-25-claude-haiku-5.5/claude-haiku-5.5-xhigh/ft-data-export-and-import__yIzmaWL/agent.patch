@@ -0,0 +1,87 @@
+# The cards a person can see, as JSON with their comments, plus every picture and file attached to them.
+class User::Export < Export
+  FORMAT = "fizzy-cards-export".freeze
+  VERSION = 1
+
+  private
+    def write_archive(zip)
+      zip.add_file("manifest.json", JSON.pretty_generate(manifest))
+
+      cards.find_each do |card|
+        zip.add_file("cards/#{card.number}.json", JSON.pretty_generate(card_json(card, zip)))
+      end
+    end
+
+    def cards
+      user.accessible_cards.published.includes(
+        :board, :column, :creator, :assignees, :tags, :steps, :image_attachment, :closure, :goldness, :not_now,
+        rich_text_description: { embeds_attachments: :blob },
+        comments: [ :creator, { rich_text_body: { embeds_attachments: :blob } } ]
+      )
+    end
+
+    def manifest
+      {
+        format: FORMAT,
+        version: VERSION,
+        exported_at: Time.current.utc.iso8601,
+        account_name: account.name,
+        user_name: user.name,
+        cards: cards.count
+      }
+    end
+
+    def card_json(card, zip)
+      {
+        number: card.number,
+        title: card.title,
+        board: card.board.name,
+        column: card.column&.name,
+        closed: card.closed?,
+        postponed: card.postponed?,
+        golden: card.golden?,
+        creator: card.creator.name,
+        created_at: card.created_at.utc.iso8601,
+        last_active_at: card.last_active_at.utc.iso8601,
+        due_on: card.due_on&.iso8601,
+        assignees: card.assignees.map(&:name).sort,
+        tags: card.tags.map(&:title).sort,
+        steps: card.steps.map { |step| { content: step.content, completed: step.completed? } },
+        description_html: card.description.body&.to_html,
+        description_text: card.description.to_plain_text,
+        attachments: card_attachments(card).map { |blob| attachment_json(blob, zip) },
+        comments: card.comments.sort_by { |comment| [ comment.created_at, comment.id ] }.map { |comment| comment_json(comment, zip) }
+      }
+    end
+
+    def comment_json(comment, zip)
+      {
+        creator: comment.creator.name,
+        created_at: comment.created_at.utc.iso8601,
+        body_html: comment.body.body&.to_html,
+        body_text: comment.body.to_plain_text,
+        attachments: comment.body.embeds.map { |attachment| attachment_json(attachment.blob, zip) }
+      }
+    end
+
+    def card_attachments(card)
+      blobs = card.image.attached? ? [ card.image.blob ] : []
+      blobs + card.description.embeds.map(&:blob)
+    end
+
+    def attachment_json(blob, zip)
+      path = Account::DataTransfer::ActiveStorage::FileRecordSet.path_for(blob)
+      zip.add_file(path) { |sink| blob.download { |chunk| sink.write(chunk) } } unless zip.exists?(path)
+
+      {
+        filename: blob.filename.to_s,
+        content_type: blob.content_type,
+        byte_size: blob.byte_size,
+        path: path
+      }
+    end
+
+    def archive_name
+      "#{user.name.parameterize.presence || "person"}-cards-export"
+    end
+end
