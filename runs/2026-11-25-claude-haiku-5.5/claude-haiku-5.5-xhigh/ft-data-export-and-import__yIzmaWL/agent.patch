@@ -0,0 +1,25 @@
+<% @page_title = "Import an account" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <%= form_with url: account_imports_path(script_name: nil), method: :post, multipart: true, class: "flex flex-column gap", data: { turbo: false } do |form| %>
+    <p class="margin-none">Choose a <strong>.zip</strong> file exported from a Fizzy account. Its boards, cards, comments, files and people will be added to a new account for you.</p>
+
+    <label class="flex flex-column gap-half">
+      <span class="txt-small font-weight-bold">Account export file</span>
+      <%= form.file_field :file, accept: ".zip,application/zip", required: true, class: "input" %>
+    </label>
+
+    <p class="txt-small txt-tinted margin-none">Large files can take a while to upload. We'll email you when the import is done, or if it can't be completed.</p>
+
+    <button type="submit" class="btn btn--link center">
+      <span>Import account</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
