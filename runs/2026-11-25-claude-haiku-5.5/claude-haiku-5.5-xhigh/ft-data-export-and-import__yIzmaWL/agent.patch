diff --git a/app/models/zip_file/chunked_input.rb b/app/models/zip_file/chunked_input.rb
new file mode 100644
index 0000000..fa64424
--- /dev/null
+++ b/app/models/zip_file/chunked_input.rb
@@ -0,0 +1,25 @@
+# Adapts a push-style stream (such as ActiveStorage's #download with a block) into
+# a pull-style reader, so a ZIP can be parsed as it arrives without buffering the
+# whole file in memory or on disk.
+class ZipFile::ChunkedInput
+  def initialize(&stream)
+    @chunks = Enumerator.new { |yielder| stream.call { |chunk| yielder << chunk } }
+    @buffer = "".b
+  end
+
+  # Returns up to +length+ bytes, or nil once the stream is exhausted.
+  def read(length)
+    while @buffer.bytesize < length && append_next_chunk
+    end
+
+    @buffer.empty? ? nil : @buffer.slice!(0, length)
+  end
+
+  private
+    def append_next_chunk
+      @buffer << @chunks.next.b
+      true
+    rescue StopIteration
+      false
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..e794e99
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,319 @@
+# Reads a ZIP archive front to back from a stream, without seeking or needing the
+# central directory up front. Entries are yielded in the order they were written,
+# so large archives never have to fit in memory or on disk.
+#
+# Supports deflated entries (with or without data descriptors) and stored entries
+# whose sizes are known in their local header, which covers everything ZipFile::Writer
+# produces. Each entry's CRC and sizes are verified as it's read.
+class ZipFile::Reader
+  LOCAL_FILE_HEADER = "PK\x03\x04".b
+  DATA_DESCRIPTOR = "PK\x07\x08".b
+  END_OF_ARCHIVE_MARKERS = [ "PK\x01\x02", "PK\x05\x06", "PK\x06\x06" ].map(&:b).freeze
+
+  CHUNK_SIZE = 64.kilobytes
+  STORED = 0
+  DEFLATED = 8
+  ZIP64_EXTRA_FIELD = 0x0001
+  ZIP64_SENTINEL = 0xFFFFFFFF
+  ENCRYPTED_FLAG = 0x01
+  DATA_DESCRIPTOR_FLAG = 0x08
+
+  def initialize(input)
+    @input = input
+    @buffer = "".b
+  end
+
+  def each_entry
+    found_end = false
+
+    while (signature = read_up_to(4)).bytesize == 4
+      if signature == LOCAL_FILE_HEADER
+        entry = read_local_file_header
+        yield entry
+        entry.skip
+      elsif END_OF_ARCHIVE_MARKERS.include?(signature)
+        found_end = true
+        break
+      else
+        raise ZipFile::InvalidArchive, "The file isn't a valid ZIP archive"
+      end
+    end
+
+    raise ZipFile::InvalidArchive, "The ZIP archive is incomplete" unless found_end
+
+    drain
+  end
+
+  # Used by ZipFile::Reader::Entry to give back bytes it read past the end of its data.
+  def unread(bytes)
+    @buffer.prepend(bytes.b)
+  end
+
+  # Returns exactly +length+ bytes, or fewer only at the end of the stream.
+  def read_up_to(length)
+    fill(length)
+    @buffer.slice!(0, length)
+  end
+
+  def read_exact(length)
+    read_up_to(length).tap do |bytes|
+      raise ZipFile::InvalidArchive, "The ZIP archive is incomplete" if bytes.bytesize < length
+    end
+  end
+
+  private
+    def fill(length)
+      while @buffer.bytesize < length && (chunk = @input.read(CHUNK_SIZE))
+        @buffer << chunk.b
+      end
+    end
+
+    def drain
+      while read_up_to(CHUNK_SIZE).bytesize > 0
+      end
+    end
+
+    def read_local_file_header
+      fields = read_exact(26).unpack("vvvvvVVVvv")
+      _version, flags, method, _time, _date, crc, compressed_size, uncompressed_size, name_length, extra_length = fields
+
+      name = read_exact(name_length).force_encoding(Encoding::UTF_8)
+      extra = read_exact(extra_length)
+
+      raise ZipFile::InvalidArchive, "#{name} is encrypted, which isn't supported" if flags.anybits?(ENCRYPTED_FLAG)
+      raise ZipFile::InvalidArchive, "#{name} uses an unsupported compression method" unless [ STORED, DEFLATED ].include?(method)
+
+      if flags.anybits?(DATA_DESCRIPTOR_FLAG)
+        raise ZipFile::InvalidArchive, "#{name} uses an unsupported layout" if method == STORED
+
+        Entry.new(self, name: name, method: method, crc: nil, compressed_size: nil, uncompressed_size: nil)
+      else
+        compressed_size, uncompressed_size = zip64_sizes(extra, compressed_size, uncompressed_size)
+        raise ZipFile::InvalidArchive, "#{name} uses an unsupported layout" if method == STORED && compressed_size != uncompressed_size
+
+        Entry.new(self, name: name, method: method, crc: crc, compressed_size: compressed_size, uncompressed_size: uncompressed_size)
+      end
+    end
+
+    def zip64_sizes(extra, compressed_size, uncompressed_size)
+      return [ compressed_size, uncompressed_size ] unless compressed_size == ZIP64_SENTINEL || uncompressed_size == ZIP64_SENTINEL
+
+      values = []
+      offset = 0
+      while offset + 4 <= extra.bytesize
+        id, size = extra.byteslice(offset, 4).unpack("vv")
+        if id == ZIP64_EXTRA_FIELD
+          values = extra.byteslice(offset + 4, size).unpack("Q<*")
+          break
+        end
+        offset += 4 + size
+      end
+
+      uncompressed_size = values.shift || uncompressed_size if uncompressed_size == ZIP64_SENTINEL
+      compressed_size = values.shift || compressed_size if compressed_size == ZIP64_SENTINEL
+      [ compressed_size, uncompressed_size ]
+    end
+
+    class Entry
+      # Data descriptors are either signed or not, with 4- or 8-byte sizes.
+      DESCRIPTOR_LAYOUTS = [ [ true, 4 ], [ true, 8 ], [ false, 4 ], [ false, 8 ] ].freeze
+
+      attr_reader :name
+
+      def initialize(reader, name:, method:, crc:, compressed_size:, uncompressed_size:)
+        @reader = reader
+        @name = name
+        @method = method
+        @expected_crc = crc
+        @expected_compressed_size = compressed_size
+        @expected_uncompressed_size = uncompressed_size
+
+        @inflater = Zlib::Inflate.new(-Zlib::MAX_WBITS) if method == DEFLATED
+        @pending = "".b
+        @finished = false
+        @crc = 0
+        @compressed_total = 0
+        @uncompressed_total = 0
+      end
+
+      # Bytes read so far after decompression; the whole entry once it has been read to the end.
+      def decompressed_size
