diff --git a/app/models/account/data_transfer/identifier_map.rb b/app/models/account/data_transfer/identifier_map.rb
new file mode 100644
index 0000000..7b9b51a
--- /dev/null
+++ b/app/models/account/data_transfer/identifier_map.rb
@@ -0,0 +1,28 @@
+# Gives every record in an imported account a new ID, derived from the exported ID and a
+# per-import seed. The same exported ID always maps to the same new ID within one import,
+# so references between records stay intact without keeping a lookup table in memory, and
+# importing the same file twice (even into the same database) can't collide.
+class Account::DataTransfer::IdentifierMap
+  def initialize(seed)
+    @seed = [ ActiveRecord::Type::Uuid.base36_to_hex(seed) ].pack("H*")
+  end
+
+  def map(id)
+    digest = Digest::SHA256.digest(@seed + [ ActiveRecord::Type::Uuid.base36_to_hex(id) ].pack("H*"))
+    ActiveRecord::Type::Uuid.hex_to_base36(digest.byteslice(0, 16).unpack1("H*"))
+  end
+
+  # Rich text references people, attachments and other records by a signed global ID. The signature
+  # belongs to the instance that exported it, so we read the ID (without verifying it), map it, and
+  # sign it again with this instance's key. Returns nil when the reference can't be understood.
+  def map_sgid(sgid)
+    payload = sgid.rpartition("--").first
+    global_id = GlobalID.parse(JSON.parse(Base64.decode64(payload)).dig("_rails", "data").split("?").first)
+    return unless global_id
+
+    mapped = "gid://#{GlobalID.app}/#{global_id.model_name}/#{map(global_id.model_id)}"
+    SignedGlobalID.new(mapped, for: ActionText::Attachable::LOCATOR_NAME).to_s
+  rescue JSON::ParserError, ArgumentError, NoMethodError, TypeError
+    nil
+  end
+end
