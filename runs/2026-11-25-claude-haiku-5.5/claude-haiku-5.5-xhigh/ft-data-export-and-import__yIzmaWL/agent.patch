+++ b/test/models/account/import_test.rb
@@ -0,0 +1,302 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper, DataTransferTestHelper
+
+  setup do
+    # Each test keeps its files in a directory of its own, so the file counts below aren't affected by other tests.
+    @storage_root = Dir.mktmpdir
+    ActiveStorage::Blob.service.stubs(:root).returns(@storage_root)
+
+    Current.session = sessions(:david)
+
+    @source = accounts("37s")
+    @card = cards(:logo)
+    @picture = "picture bytes for the logo"
+    @card.image.attach io: StringIO.new(@picture), filename: "logo.png", content_type: "image/png"
+
+    @note = "a note from the comment"
+    note_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new(@note), filename: "note.txt", content_type: "text/plain")
+    body = %(<div>Please see #{ActionText::Attachment.from_attachable(note_blob).to_html} and ping #{ActionText::Attachment.from_attachable(users(:kevin)).to_html}</div>)
+    @card.comments.create!(creator: users(:david), body: body)
+
+    ActionMailer::Base.deliveries.clear
+  end
+
+  teardown do
+    FileUtils.remove_entry(@storage_root) if @storage_root
+  end
+
+  test "imports the account's boards, cards, comments and tags as a new account" do
+    import = import_archive(export_account_to_file(@source))
+
+    assert import.completed?, import.error_message
+    new_account = new_account_from(import)
+
+    assert_not_equal @source.id, new_account.id
+    assert_equal @source.name, new_account.name
+    assert_equal @source.boards.pluck(:name).sort, new_account.boards.pluck(:name).sort
+    assert_equal @source.cards.order(:number).pluck(:number, :title), new_account.cards.order(:number).pluck(:number, :title)
+    assert_equal @source.tags.pluck(:title).sort, new_account.tags.pluck(:title).sort
+    assert_equal comment_texts(@source), comment_texts(new_account)
+  end
+
+  test "keeps the card's picture and the files in comments, byte for byte" do
+    new_account = new_account_from(import_archive(export_account_to_file(@source)))
+
+    imported_card = new_account.cards.find_by!(number: @card.number)
+    assert imported_card.image.attached?
+    assert_equal @picture, imported_card.image.download
+    assert_not_equal @card.image.blob.key, imported_card.image.blob.key
+    assert_equal new_account.id, imported_card.image.blob.account_id
+
+    imported_note = ActiveStorage::Attachment.where(account: new_account, record_type: "ActionText::RichText", name: "embeds").first
+    assert_equal @note, imported_note.blob.download
+    assert_equal @source.bytes_used_exact, new_account.bytes_used_exact, "the imported account should account for its files the same way"
+  end
+
+  test "mentions and embeds in comments point at the imported records, not the originals" do
+    new_account = new_account_from(import_archive(export_account_to_file(@source)))
+
+    imported = Comment.where(account: new_account).detect { |comment| comment.body.to_plain_text.include?("ping") }
+    assert imported, "the comment with a mention and an embed should be imported"
+
+    stored_body = imported.rich_text_body.read_attribute_before_type_cast("body")
+    references = stored_body.scan(/sgid="([^"]+)"/).flatten.map do |sgid|
+      GlobalID::Locator.locate_signed(sgid, for: ActionText::Attachable::LOCATOR_NAME)
+    end
+
+    assert_includes references, new_account.users.find_by!(name: "Kevin")
+    assert(references.any? { |record| record.is_a?(ActiveStorage::Blob) && record.account_id == new_account.id })
+    assert_not(references.any? { |record| record.respond_to?(:account_id) && record.account_id == @source.id })
+  end
+
+  test "people in the archive keep their roles, and the person importing becomes the owner" do
+    new_account = new_account_from(import_archive(export_account_to_file(@source), identity: identities(:kevin)))
+
+    kevin = new_account.users.find_by!(identity: identities(:kevin))
+    assert kevin.owner?
+    assert kevin.verified?
+    assert_equal 1, new_account.users.where(identity: identities(:kevin)).count
+
+    assert_equal "member", new_account.users.find_by!(name: "David").role
+    assert_equal "owner", new_account.users.find_by!(name: "Jason").role
+  end
+
+  test "people who aren't on this instance yet are added as unverified members" do
+    @source.users.create!(name: "Newcomer", identity: Identity.create!(email_address: "newcomer@example.com"), role: :member)
+    archive = export_account_to_file(@source)
+    Identity.where(email_address: "newcomer@example.com").delete_all
+
+    new_account = new_account_from(import_archive(archive))
+    imported = new_account.users.find_by!(name: "Newcomer")
+
+    assert_equal "newcomer@example.com", imported.identity.email_address
+    assert_not imported.verified?
+    assert_equal "member", imported.role
+    assert_equal 1, Identity.where(email_address: "newcomer@example.com").count
+  end
+
+  test "a person who imports an archive they aren't in becomes its owner" do
+    stranger = Identity.create!(email_address: "stranger@example.com")
+
+    new_account = new_account_from(import_archive(export_account_to_file(@source), identity: stranger))
+
+    owner = new_account.users.find_by!(identity: stranger)
+    assert owner.owner?
+    assert owner.verified?
+    assert_equal "stranger", owner.name
+  end
+
+  test "keeps the card count, the card numbers and the account's auto-close period" do
+    @source.entropy.update!(auto_postpone_period: 7.days)
+
+    new_account = new_account_from(import_archive(export_account_to_file(@source)))
+
+    assert_equal @source.cards_count, new_account.cards_count
+    assert_equal 7.days.to_i, new_account.entropy.auto_postpone_period
+  end
+
+  test "keeps dates, webhook settings and file details exactly as they were" do
+    webhook = @source.webhooks.first
+    webhook.update!(subscribed_actions: %w[ card_published comment_created ], name: "Chat")
+    new_account = new_account_from(import_archive(export_account_to_file(@source)))
+
+    assert_equal @source.cards.order(:number).pluck(:created_at).map { it.to_fs(:usec) }, new_account.cards.order(:number).pluck(:created_at).map { it.to_fs(:usec) }
+    imported_webhook = new_account.webhooks.find_by!(name: "Chat")
+    assert_equal %w[ card_published comment_created ], imported_webhook.subscribed_actions
+    assert_equal webhook.signing_secret, imported_webhook.signing_secret
+    assert_equal @picture.bytesize, new_account.cards.find_by!(number: @card.number).image.blob.byte_size
+    assert_equal @card.image.blob.metadata, new_account.cards.find_by!(number: @card.number).image.blob.metadata
+  end
+
+  test "rebuilds search so the imported cards and comments can be found" do
+    new_account = new_account_from(import_archive(export_account_to_file(@source)))
+
+    search = Search::Record.for(new_account.id)
+    assert_equal new_account.cards.published.count, search.where(account_id: new_account.id, searchable_type: "Card").count
+    assert_equal Comment.where(account: new_account).count, search.where(account_id: new_account.id, searchable_type: "Comment").count
+  end
+
+  test "importing the same archive twice gives two independent accounts" do
+    archive = export_account_to_file(@source)
+
+    first = new_account_from(import_archive(archive))
+    second = new_account_from(import_archive(archive))
+
+    assert_not_equal first.id, second.id
+    assert_equal first.cards.order(:number).pluck(:number, :title), second.cards.order(:number).pluck(:number, :title)
+    assert_equal first.cards.count, second.cards.count
+    assert_equal first.users.count, second.users.count
+    assert_empty ActiveStorage::Blob.where(account: first).where(key: ActiveStorage::Blob.where(account: second).select(:key))
+  end
+
+  test "the person who imported the archive is emailed a link into the new account when it's done" do
+    import = import_archive(export_account_to_file(@source), identity: identities(:kevin))
+    perform_enqueued_jobs
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_match "imported", email.subject
+    assert_match import.account.slug, email.html_part.body.to_s
+  end
+
+  test "a file that isn't a zip creates nothing, and the person is told why" do
+    not_a_zip = Tempfile.new([ "notes", ".zip" ]).tap { it.binmode; it.write("just some text"); it.flush; it.rewind }
+
+    assert_no_difference -> { Account.count } do
+      import = import_archive(not_a_zip)
+
+      assert import.failed?
+      assert_nil import.account_id
+      assert_match "isn't a valid ZIP archive", import.error_message
+    end
+
+    perform_enqueued_jobs
+    assert_match "isn't a valid ZIP archive", ActionMailer::Base.deliveries.last.text_part.body.to_s
+  end
+
+  test "a zip that isn't an account export creates nothing" do
+    archive = build_archive("hello.txt" => "hello")
+
+    assert_no_difference -> { Account.count } do
+      import = import_archive(archive)
+
+      assert import.failed?
+      assert_match "isn't a Fizzy account export", import.error_message
+    end
+  end
+
+  test "an archive from a newer version of Fizzy is refused with a clear reason" do
+    manifest = { format: Account::DataTransfer::Manifest::FORMAT, version: Account::DataTransfer::Manifest::VERSION + 1 }
+    archive = build_archive("manifest.json" => manifest.to_json)
+
+    import = import_archive(archive)
+
+    assert import.failed?
+    assert_match "newer version of Fizzy", import.error_message
+  end
+
+  test "an export that's cut short leaves nothing behind" do
+    @card.image.attach io: StringIO.new(Random.bytes(2.megabytes)), filename: "big.bin", content_type: "application/octet-stream"
+    archive = export_account_to_file(@source)
+    cut = build_archive_from_bytes(File.binread(archive.path).byteslice(0, (File.size(archive.path) * 0.9).to_i))
+
+    snapshot = footprint
+    import = import_archive(cut)
+
+    assert import.failed?
+    assert_nil import.account_id
+    assert import.error_message.present?
+    assert_equal snapshot, footprint
+    assert_not ActiveStorage::Blob.service.exist?(import.storage_key)
+  end
+
+  test "a file whose contents don't match its checksum leaves nothing behind" do
+    archive = export_account_to_file(@source)
+    snapshot = footprint
+    import = upload_import(archive)
+    ActiveStorage::Blob.service.stubs(:upload).raises(ActiveStorage::IntegrityError)
+
+    import.process_now
+
+    assert import.reload.failed?
+    assert_match "Something went wrong", import.error_message
+    assert_equal snapshot, footprint
+  end
+
+  test "a failure partway through the people step leaves no people, identities or storage behind" do
+    archive = export_account_to_file(@source)
+    snapshot = footprint
+    Account.any_instance.stubs(:reconcile_storage).raises(StandardError, "boom")
+
+    import = import_archive(archive)
+
+    assert import.failed?
+    assert_equal snapshot, footprint
+    assert_not ActiveStorage::Blob.service.exist?(import.storage_key)
+  end
+
+  test "a failure after the search index is built still leaves nothing behind" do
+    archive = export_account_to_file(@source)
+    snapshot = footprint
+    ImportMailer.stubs(:completed).raises(StandardError, "mail server down")
+
+    import = import_archive(archive)
+
+    assert import.failed?
+    assert_equal snapshot, footprint
+  end
+
+  test "stale imports that stopped part way are rolled back" do
+    half_done = Account.create!(name: "Half imported")
+    import = upload_import(export_account_to_file(@source))
+    import.update_columns(status: "processing", account_id: half_done.id, updated_at: 2.days.ago)
+
+    Account::Import.cleanup_stale
+
+    assert_not Account.exists?(half_done.id)
+    assert import.reload.failed?
+    assert_nil import.account_id
+    assert_not ActiveStorage::Blob.service.exist?(import.storage_key)
+  end
+
+  private
+    def comment_texts(account)
+      Comment.where(account: account).map { |comment| comment.body.to_plain_text }.sort
+    end
+
+    def footprint
+      {
+        accounts: Account.count,
+        boards: Board.count,
+        cards: Card.count,
+        comments: Comment.count,
+        users: User.count,
+        identities: Identity.count,
+        blobs: ActiveStorage::Blob.count,
+        storage_entries: Storage::Entry.count,
+        search_records: Search::Record.count,
+        search_index: ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM search_records_fts").to_i,
+        files: storage_file_count
+      }
+    end
+
+    def build_archive(files)
+      writer_file = Tempfile.new([ "built", ".zip" ]).tap(&:binmode)
+      writer = ZipFile::Writer.new(writer_file)
+      files.each { |name, content| writer.add_file(name, content) }
+      writer.close
+      writer_file.flush
+      writer_file.rewind
+      writer_file
+    end
+
+    def build_archive_from_bytes(bytes)
+      file = Tempfile.new([ "cut", ".zip" ]).tap(&:binmode)
+      file.write(bytes)
+      file.flush
+      file.rewind
+      file
+    end
+end
