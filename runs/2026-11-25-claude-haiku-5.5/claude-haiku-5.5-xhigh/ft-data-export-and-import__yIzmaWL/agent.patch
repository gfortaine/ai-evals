+        end
+
+        def accept(bytes)
+          return if bytes.nil? || bytes.empty?
+
+          @pending << bytes.b
+          @uncompressed_total += bytes.bytesize
+          @crc = Zlib.crc32(bytes, @crc)
+        end
+
+        def finish
+          @finished = true
+
+          if @expected_compressed_size
+            verify_known_sizes
+          else
+            read_data_descriptor
+          end
+        end
+
+        def verify_known_sizes
+          unless @compressed_total == @expected_compressed_size && @uncompressed_total == @expected_uncompressed_size && @crc == @expected_crc
+            raise ZipFile::InvalidArchive, "#{name} is damaged"
+          end
+        end
+
+        # Data descriptors may or may not start with their signature, and their sizes are 4 or
+        # 8 bytes depending on the entry size, so accept whichever layout matches what we read.
+        def read_data_descriptor
+          bytes = @reader.read_up_to(24)
+
+          layout = DESCRIPTOR_LAYOUTS.find do |signed, width|
+            length = descriptor_length(signed, width)
+            next false if bytes.bytesize < length
+            next false if signed && bytes.byteslice(0, 4) != DATA_DESCRIPTOR
+
+            crc, compressed, uncompressed = descriptor_fields(bytes, signed, width)
+            crc == @crc && compressed == @compressed_total && uncompressed == @uncompressed_total
+          end
+
+          raise ZipFile::InvalidArchive, "#{name} is damaged" unless layout
+
+          signed, width = layout
+          @reader.unread(bytes.byteslice(descriptor_length(signed, width)..))
+        end
+
+        def descriptor_length(signed, width)
+          (signed ? 4 : 0) + 4 + 2 * width
+        end
+
+        def descriptor_fields(bytes, signed, width)
+          body = signed ? bytes.byteslice(4, descriptor_length(signed, width) - 4) : bytes.byteslice(0, descriptor_length(signed, width))
+          body.unpack(width == 4 ? "VVV" : "VQ<Q<")
+        end
+    end
+
+    # Gives an entry the size its record declares, and refuses to read past it, so a damaged or hostile
+    # archive can't write more data than the import expects.
+    class SizedEntry
+      attr_reader :size
+
+      def initialize(entry, size)
+        @entry = entry
+        @size = size
+        @bytes_read = 0
+      end
+
+      def read(length = nil, outbuf = nil)
+        bytes = @entry.read(length)
+        count(bytes)
+        outbuf&.replace(bytes || "")
+        bytes
+      end
+
+      def readpartial(maxlen, outbuf = nil)
+        bytes = @entry.readpartial(maxlen)
+        count(bytes)
+        outbuf&.replace(bytes)
+        bytes
+      end
+
+      private
+        def count(bytes)
+          @bytes_read += bytes.to_s.bytesize
+          raise ZipFile::InvalidArchive, "#{@entry.name} is larger than its record says" if @bytes_read > @size
+        end
+    end
+end
