+require "test_helper"
+
+class ZipFile::ChunkedInputTest < ActiveSupport::TestCase
+  test "reads across chunk boundaries and returns nil at the end" do
+    input = ZipFile::ChunkedInput.new { |&block| [ "abc", "", "defg" ].each(&block) }
+
+    assert_equal "ab", input.read(2)
+    assert_equal "cdef", input.read(4)
+    assert_equal "g", input.read(10)
+    assert_nil input.read(1)
+  end
+end
diff --git a/test/models/zip_file/reader_test.rb b/test/models/zip_file/reader_test.rb
