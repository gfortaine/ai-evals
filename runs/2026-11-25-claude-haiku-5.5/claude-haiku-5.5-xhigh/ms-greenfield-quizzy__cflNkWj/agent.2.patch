+++ b/test/models/quiz_export_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class QuizExportTest < ActiveSupport::TestCase
+  test "writes exactly the title and the questions, in order" do
+    quiz = build_quiz(title: "Frontend Fest 2026")
+    build_question(quiz, text: "First?", options: [ [ "418", false ], [ "429", true ] ])
+    build_question(quiz, text: "Second?", options: [ [ "Yes", true ], [ "No", false ] ], active: false)
+
+    assert_equal(
+      {
+        "title" => "Frontend Fest 2026",
+        "questions" => [
+          {
+            "text" => "First?",
+            "active" => true,
+            "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ]
+          },
+          {
+            "text" => "Second?",
+            "active" => false,
+            "options" => [ { "text" => "Yes", "correct" => true }, { "text" => "No", "correct" => false } ]
+          }
+        ]
+      },
+      QuizExport.new(quiz.reload).to_h
+    )
+  end
+
+  test "the questions and options keep their moved order" do
+    quiz = build_quiz
+    first = build_question(quiz, text: "First", options: [ [ "a", true ], [ "b", false ] ])
+    build_question(quiz, text: "Second", options: [ [ "c", false ], [ "d", true ] ])
+    quiz.move_question(first, "down")
+
+    exported = QuizExport.new(quiz.reload).to_h
+    assert_equal [ "Second", "First" ], exported["questions"].map { |question| question["text"] }
+  end
+
+  test "an empty quiz exports an empty list" do
+    quiz = build_quiz(title: "Nothing yet")
+
+    assert_equal({ "title" => "Nothing yet", "questions" => [] }, QuizExport.new(quiz).to_h)
+  end
+
+  test "the pretty JSON parses back to the same hash" do
+    quiz = build_quiz
+    build_question(quiz, text: "Quotes \"and\" <tags> & more", options: [ [ "A", true ], [ "B", false ] ])
+
+    exporter = QuizExport.new(quiz)
+    assert_equal exporter.to_h, JSON.parse(exporter.to_pretty_json)
+    assert_includes exporter.to_pretty_json, "\n  \"title\""
+  end
+end
diff --git a/test/models/quiz_import_test.rb b/test/models/quiz_import_test.rb
new file mode 100644
index 0000000..15d3fff
--- /dev/null
+++ b/test/models/quiz_import_test.rb
@@ -0,0 +1,302 @@
+require "test_helper"
+
+class QuizImportTest < ActiveSupport::TestCase
+  def json(data)
+    data.is_a?(String) ? data : JSON.generate(data)
+  end
+
+  def valid_quiz_data(**overrides)
+    {
+      "title" => "Frontend Fest 2026",
+      "questions" => [
+        {
+          "text" => "Which HTTP status code means \"Too Many Requests\"?",
+          "active" => true,
+          "options" => [
+            { "text" => "418", "correct" => false },
+            { "text" => "429", "correct" => true }
+          ]
+        }
+      ]
+    }.merge(overrides.transform_keys(&:to_s))
+  end
+
+  def import(data)
+    importer = QuizImport.new(json(data))
+    [ importer.save, importer ]
+  end
+
+  def assert_nothing_imported
+    assert_equal 0, Quiz.count, "no quiz should exist"
+    assert_equal 0, Question.count, "no question should exist"
+    assert_equal 0, Option.count, "no option should exist"
+  end
+
+  test "creates the quiz, its questions and options in order" do
+    saved, importer = import(valid_quiz_data)
+
+    assert saved, importer.errors.inspect
+    quiz = importer.quiz
+    assert quiz.persisted?
+    assert_equal "Frontend Fest 2026", quiz.reload.title
+    question = quiz.questions.first
+    assert_equal "Which HTTP status code means \"Too Many Requests\"?", question.text
+    assert_equal [ "418", "429" ], question.options.map(&:text)
+    assert_equal [ false, true ], question.options.map(&:correct)
+    assert question.active
+  end
+
+  test "active defaults to true and correct to false" do
+    data = {
+      "title" => "Defaults",
+      "questions" => [
+        { "text" => "Q?", "options" => [ { "text" => "A" }, { "text" => "B", "correct" => true } ] }
+      ]
+    }
+    saved, importer = import(data)
+
+    assert saved, importer.errors.inspect
+    question = importer.quiz.questions.first
+    assert question.active
+    assert_equal [ false, true ], question.options.map(&:correct)
+  end
+
+  test "active false is kept" do
+    data = valid_quiz_data
+    data["questions"][0]["active"] = false
+    saved, importer = import(data)
+
+    assert saved, importer.errors.inspect
+    assert_equal false, importer.quiz.questions.first.active
+  end
+
+  test "importing a title that already exists still creates a new quiz" do
+    build_quiz(title: "Frontend Fest 2026")
+    saved, importer = import(valid_quiz_data)
+
+    assert saved, importer.errors.inspect
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+    assert_not_equal Quiz.first.id, importer.quiz.id
+  end
+
+  test "a quiz without questions can be imported" do
+    saved, importer = import("title" => "Empty", "questions" => [])
+
+    assert saved, importer.errors.inspect
+    assert_equal 0, importer.quiz.questions.count
+  end
+
+  test "unknown keys are ignored" do
+    data = valid_quiz_data("id" => 99, "note" => "hi")
+    data["questions"][0]["position"] = 7
+    saved, importer = import(data)
+
+    assert saved, importer.errors.inspect
+    assert_equal 1, importer.quiz.questions.count
+  end
+
+  test "blank option rows are skipped, and a correct box on one does not count" do
+    data = valid_quiz_data
+    data["questions"][0]["options"] = [
+      { "text" => "  ", "correct" => true },
+      { "text" => " 429 ", "correct" => true },
+      { "text" => "", "correct" => false },
+      { "text" => "418" }
+    ]
+    saved, importer = import(data)
+
+    assert saved, importer.errors.inspect
+    assert_equal [ "429", "418" ], importer.quiz.questions.first.options.map(&:text)
+    assert_equal [ true, false ], importer.quiz.questions.first.options.map(&:correct)
+  end
+
+  test "null for active or correct counts as left out" do
+    data = valid_quiz_data
+    data["questions"][0]["active"] = nil
+    data["questions"][0]["options"][0]["correct"] = nil
+    saved, importer = import(data)
+
+    assert saved, importer.errors.inspect
+    assert importer.quiz.questions.first.active
+    assert_equal [ false, true ], importer.quiz.questions.first.options.map(&:correct)
+  end
+
+  test "a byte-order mark before the JSON is ignored" do
+    saved, importer = import("\uFEFF" + json(valid_quiz_data))
+
+    assert saved, importer.errors.inspect
+  end
+
+  test "questions keep their order" do
+    data = valid_quiz_data
+    data["questions"] = %w[Third First Second].map do |text|
+      { "text" => text, "options" => [ { "text" => "a", "correct" => true }, { "text" => "b" } ] }
+    end
+    saved, importer = import(data)
+
+    assert saved, importer.errors.inspect
+    assert_equal %w[Third First Second], importer.quiz.questions.map(&:text)
+    assert_equal [ 1, 2, 3 ], importer.quiz.questions.map(&:position)
+  end
+
+  test "invalid JSON imports nothing" do
+    saved, importer = import("{\"title\": \"Broken\", ")
+
+    assert_not saved
+    assert_match(/not valid JSON/, importer.errors.first)
+    assert_nothing_imported
+  end
+
+  test "blank input says what is missing" do
+    saved, importer = import("   ")
+
+    assert_not saved
+    assert_equal [ "Paste the quiz JSON to import." ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "the top level must be an object" do
+    saved, importer = import("[1, 2]")
+
+    assert_not saved
+    assert_match(/must be an object/, importer.errors.first)
+    assert_nothing_imported
+  end
+
+  test "questions must be a list" do
+    saved, importer = import("title" => "No list")
+
+    assert_not saved
+    assert_equal [ "Questions must be a list." ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "a question must be an object with an options list" do
+    saved, importer = import(valid_quiz_data.merge("questions" => [ "just text" ]))
+    assert_not saved
+    assert_equal [ "Question 1 must be an object." ], importer.errors
+
+    data = valid_quiz_data
+    data["questions"][0].delete("options")
+    saved, importer = import(data)
+    assert_not saved
+    assert_equal [ "Question 1: options must be a list." ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "an option must be an object" do
+    data = valid_quiz_data
+    data["questions"][0]["options"] = [ "418", { "text" => "429", "correct" => true } ]
+    saved, importer = import(data)
+
+    assert_not saved
+    assert_equal [ "Question 1, option 1 must be an object." ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "types are checked strictly" do
+    data = valid_quiz_data(title: 42)
+    saved, importer = import(data)
+    assert_not saved
+    assert_equal [ "Title must be a string." ], importer.errors
+
+    data = valid_quiz_data
+    data["questions"][0]["text"] = 7
+    saved, importer = import(data)
+    assert_not saved
+    assert_equal [ "Question 1: text must be a string." ], importer.errors
+
+    data = valid_quiz_data
+    data["questions"][0]["active"] = "yes"
+    saved, importer = import(data)
+    assert_not saved
+    assert_equal [ "Question 1: active must be true or false." ], importer.errors
+
+    data = valid_quiz_data
+    data["questions"][0]["options"][1]["correct"] = "true"
+    saved, importer = import(data)
+    assert_not saved
+    assert_equal [ "Question 1, option 2: correct must be true or false." ], importer.errors
+
+    data = valid_quiz_data
+    data["questions"][0]["options"][1]["text"] = 429
+    saved, importer = import(data)
+    assert_not saved
+    assert_equal [ "Question 1, option 2: text must be a string." ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "a missing title is the same rule as the quiz form" do
+    saved, importer = import(valid_quiz_data(title: "  "))
+
+    assert_not saved
+    assert_equal [ "Title can't be blank" ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "question rules are the question form's rules, and one bad question imports nothing" do
+    data = valid_quiz_data
+    data["questions"] << {
+      "text" => "Only one option?",
+      "options" => [ { "text" => "Alone", "correct" => true } ]
+    }
+    saved, importer = import(data)
+
+    assert_not saved
+    assert_equal [ "Question 2: Add at least two options" ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "a question needs a correct option" do
+    data = valid_quiz_data
+    data["questions"][0]["options"].each { |option| option["correct"] = false }
+    saved, importer = import(data)
+
+    assert_not saved
+    assert_equal [ "Question 1: Mark at least one option as correct" ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "a question needs text" do
+    data = valid_quiz_data
+    data["questions"][0]["text"] = "   "
+    saved, importer = import(data)
+
+    assert_not saved
+    assert_equal [ "Question 1: Question can't be blank" ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "every broken question is reported, and nothing is imported" do
+    data = valid_quiz_data(title: "")
+    data["questions"] << { "text" => "", "options" => [] }
+    saved, importer = import(data)
+
+    assert_not saved
+    assert_includes importer.errors, "Title can't be blank"
+    assert_includes importer.errors, "Question 2: Add at least two options"
+    assert_includes importer.errors, "Question 2: Mark at least one option as correct"
+    assert_nothing_imported
+  end
+
+  test "several correct options are fine" do
+    data = valid_quiz_data
+    data["questions"][0]["options"] = [ { "text" => "2", "correct" => true }, { "text" => "3", "correct" => true } ]
+    saved, _importer = import(data)
+
+    assert saved
+  end
+
+  test "an export imports back to the same contents" do
+    quiz = build_quiz(title: "Round trip")
+    build_question(quiz, text: "One", options: [ [ "a", true ], [ "b", false ] ])
+    build_question(quiz, text: "Two", options: [ [ "c", false ], [ "d", true ], [ "e", true ] ], active: false)
+    exported = QuizExport.new(quiz).to_pretty_json
+
+    saved, importer = import(exported)
+
+    assert saved, importer.errors.inspect
+    assert_equal QuizExport.new(quiz.reload).to_h, QuizExport.new(importer.quiz.reload).to_h
+    assert_equal 2, Quiz.count
+  end
+end
