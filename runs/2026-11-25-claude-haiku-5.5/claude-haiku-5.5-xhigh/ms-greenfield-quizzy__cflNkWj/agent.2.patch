@@ -0,0 +1,143 @@
+require "test_helper"
+require "support/moderator_helpers"
+
+class QuizTransferTest < ActionDispatch::IntegrationTest
+  include ModeratorHelpers
+
+  setup do
+    sign_in_as_moderator
+    @quiz = build_quiz(title: "Frontend Fest 2026")
+    build_question(@quiz, text: "Which HTTP status code means \"Too Many Requests\"?",
+                   options: [ [ "418", false ], [ "429", true ] ])
+    build_question(@quiz, text: "Hidden", options: [ [ "X", true ], [ "Y", false ] ], active: false)
+  end
+
+  def exported_json
+    JSON.parse(page.find("pre").text)
+  end
+
+  test "the quiz page links to the export" do
+    visit "/moderate/quizzes/#{@quiz.id}"
+
+    click_link "Export"
+    assert_current_path "/moderate/quizzes/#{@quiz.id}/export"
+  end
+
+  test "the export page shows the quiz as JSON in the only pre element" do
+    visit "/moderate/quizzes/#{@quiz.id}/export"
+
+    assert_status 200
+    assert_equal 1, page.all("pre").size
+    assert_equal({
+      "title" => "Frontend Fest 2026",
+      "questions" => [
+        {
+          "text" => "Which HTTP status code means \"Too Many Requests\"?",
+          "active" => true,
+          "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ]
+        },
+        {
+          "text" => "Hidden",
+          "active" => false,
+          "options" => [ { "text" => "X", "correct" => true }, { "text" => "Y", "correct" => false } ]
+        }
+      ]
+    }, exported_json)
+  end
+
+  test "the moderator list has an Import quiz button that opens the import page" do
+    visit "/moderate"
+    click_button "Import quiz"
+
+    assert_current_path "/moderate/imports/new"
+    assert_field "Quiz JSON"
+    assert_button "Import"
+  end
+
+  test "a valid import creates a new quiz and opens its page" do
+    visit "/moderate/imports/new"
+    fill_in "Quiz JSON", with: JSON.generate(
+      "title" => "Frontend Fest 2026",
+      "questions" => [ { "text" => "Imported?", "options" => [ { "text" => "Yes", "correct" => true }, { "text" => "No" } ] } ]
+    )
+    click_button "Import"
+
+    imported = Quiz.order(:id).last
+    assert_current_path "/moderate/quizzes/#{imported.id}"
+    assert_text "Quiz imported."
+    assert_text "Imported?"
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+  end
+
+  test "an invalid import shows the error, keeps the text and imports nothing" do
+    visit "/moderate/imports/new"
+    broken = JSON.generate(
+      "title" => "Half",
+      "questions" => [
+        { "text" => "Fine?", "options" => [ { "text" => "Yes", "correct" => true }, { "text" => "No" } ] },
+        { "text" => "Broken?", "options" => [ { "text" => "Only", "correct" => true } ] }
+      ]
+    )
+    fill_in "Quiz JSON", with: broken
+    click_button "Import"
+
+    assert_status 422
+    assert_text "Question 2: Add at least two options"
+    assert_field "Quiz JSON", with: broken
+    assert_equal 1, Quiz.count
+    assert_equal 2, Question.count
+  end
+
+  test "text that is not JSON is an error, not a crash" do
+    visit "/moderate/imports/new"
+    fill_in "Quiz JSON", with: "{ not json"
+    click_button "Import"
+
+    assert_status 422
+    assert_text "not valid JSON"
+    assert_equal 1, Quiz.count
+  end
+
+  test "an export can be imported back" do
+    visit "/moderate/quizzes/#{@quiz.id}/export"
+    exported = page.find("pre").text
+
+    visit "/moderate/imports/new"
+    fill_in "Quiz JSON", with: exported
+    click_button "Import"
+
+    assert_equal 2, Quiz.count
+    assert_equal QuizExport.new(@quiz.reload).to_h, QuizExport.new(Quiz.order(:id).last).to_h
+  end
+end
+
+class QuizTransferAccessTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = build_quiz
+  end
+
+  def auth
+    { "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "letmein") }
+  end
+
+  test "the export page needs moderator credentials" do
+    get "/moderate/quizzes/#{@quiz.id}/export"
+
+    assert_response :unauthorized
+  end
+
+  test "the import pages need moderator credentials" do
+    get "/moderate/imports/new"
+    assert_response :unauthorized
+
+    post "/moderate/imports", params: { quiz_json: JSON.generate(title: "Sneaky", questions: []) }
+    assert_response :unauthorized
+    assert_equal 1, Quiz.count
+  end
+
+  test "the import page answers with credentials" do
+    get "/moderate/imports/new", headers: auth
+
+    assert_response :success
+  end
+end
