@@ -0,0 +1,39 @@
+require "application_system_test_case"
+
+class QuizTransferBrowserTest < ApplicationSystemTestCase
+  setup do
+    @quiz = build_quiz(title: "Frontend Fest 2026")
+    build_question(@quiz, text: "Which HTTP status code means \"Too Many Requests\"?",
+                   options: [ [ "418", false ], [ "429", true ] ])
+  end
+
+  test "export from the quiz page, then import the text as a new quiz" do
+    visit "/moderate/quizzes/#{@quiz.id}"
+    click_link "Export"
+
+    assert_selector "pre", count: 1
+    exported = find("pre").text
+    assert_equal "Frontend Fest 2026", JSON.parse(exported)["title"]
+
+    visit "/moderate"
+    click_button "Import quiz"
+    fill_in "Quiz JSON", with: exported
+    click_button "Import"
+
+    assert_text "Quiz imported."
+    assert_text "Frontend Fest 2026"
+    assert_text "Which HTTP status code means \"Too Many Requests\"?"
+    assert_equal 2, Quiz.count
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+  end
+
+  test "a rejected import shows the error in the browser and imports nothing" do
+    visit "/moderate/imports/new"
+    fill_in "Quiz JSON", with: '{"title": "Nope", "questions": [{"text": "One option", "options": [{"text": "A", "correct": true}]}]}'
+    click_button "Import"
+
+    assert_text "Question 1: Add at least two options"
+    assert_field "Quiz JSON"
+    assert_equal 1, Quiz.count
+  end
+end
