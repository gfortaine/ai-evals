@@ -0,0 +1,69 @@
+require "application_system_test_case"
+
+# The timer in real browsers: the moderator sets it in the settings, the big screen
+# counts down, and the question finishes by itself while a phone is answering.
+class TimerBrowserTest < ApplicationSystemTestCase
+  setup do
+    @quiz = build_quiz(title: "Frontend Fest 2026")
+    build_question(@quiz, text: "Largest planet?", options: [ [ "Jupiter", true ], [ "Mars", false ] ])
+    build_question(@quiz, text: "Which protocol?", options: [ [ "WebSocket", true ], [ "FTP", false ] ])
+  end
+
+  def join_phone(name, code)
+    Capybara.using_session(:phone) do
+      visit "/play/#{code}"
+      fill_in "Your name", with: name
+      click_button "Join"
+      assert_text "Hi, #{name}!"
+    end
+  end
+
+  test "the moderator sets the timer in the settings, and the question finishes by itself at 0:00" do
+    visit "/moderate/quizzes/#{@quiz.id}/edit"
+    fill_in "Timer minutes", with: "0"
+    fill_in "Timer seconds", with: "5"
+    click_button "Save quiz"
+    assert_text "0:05 per question"
+
+    click_button "Start a game"
+    code = find(".lobby__url").text[%r{/play/(\w+)\z}, 1]
+    join_phone("Alice", code)
+
+    click_button "Start"
+    assert_css ".stage-timer[role='timer']", text: /\A0:0[45]\z/
+    assert_button "Finish"
+
+    Capybara.using_session(:phone) do
+      assert_text "Largest planet?"
+      refute_css "[role='timer'], .stage-timer"
+      refute_text(/\b\d:\d\d\b/)
+      click_button "Mars"
+      assert_text "Your answer"
+    end
+
+    # Nobody clicks anything: the countdown runs out and the question closes.
+    assert_button "Next", wait: 10
+    refute_button "Finish"
+    refute_css ".stage-timer"
+    assert_text "1 answer"
+
+    Capybara.using_session(:phone) do
+      assert_text "Wrong!", wait: 10
+      refute_css "[role='timer'], .stage-timer"
+    end
+  end
+
+  test "reloading the big screen keeps counting from the moment the question opened" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 8)
+
+    visit "/moderate/quizzes/#{@quiz.id}"
+    click_button "Start a game"
+    click_button "Start"
+    assert_css ".stage-timer", text: /\A0:0[5-8]\z/
+
+    sleep 2
+    visit current_path
+    assert_css ".stage-timer", text: /\A0:0[0-5]\z/
+    assert_button "Next", wait: 10
+  end
+end
