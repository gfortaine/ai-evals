index 0000000..7798450
--- /dev/null
+++ b/test/system/moderator_browser_test.rb
@@ -0,0 +1,109 @@
+require "application_system_test_case"
+
+class ModeratorBrowserTest < ApplicationSystemTestCase
+  setup do
+    @quiz = build_quiz(title: "Frontend Fest 2026")
+  end
+
+  test "the Active checkbox saves at once, with no extra button" do
+    question = build_question(@quiz, text: "Toggle me", options: [ [ "A", true ], [ "B", false ] ])
+    visit "/moderate/quizzes/#{@quiz.id}"
+
+    assert_text "1 of 1 questions active"
+    within("li.question-item", text: "Toggle me") { uncheck "Active" }
+
+    assert_text "0 of 1 questions active"
+    assert_equal false, question.reload.active
+    assert_no_button "Save"
+  end
+
+  test "Delete asks for confirmation and removes the question when accepted" do
+    build_question(@quiz, text: "Doomed question")
+    visit "/moderate/quizzes/#{@quiz.id}"
+
+    dismiss_confirm("Delete this question?") do
+      within("li.question-item", text: "Doomed question") { click_button "Delete" }
+    end
+    assert_text "Doomed question"
+
+    accept_confirm("Delete this question?") do
+      within("li.question-item", text: "Doomed question") { click_button "Delete" }
+    end
+    assert_no_text "Doomed question"
+    assert_equal 0, Question.count
+  end
+
+  test "deleting a quiz from its settings asks for confirmation" do
+    visit "/moderate/quizzes/#{@quiz.id}/edit"
+
+    dismiss_confirm { click_button "Delete quiz" }
+    assert_equal 1, Quiz.count
+
+    accept_confirm { click_button "Delete quiz" }
+    assert_current_path "/moderate"
+    assert_equal 0, Quiz.count
+  end
+
+  test "Enter in an option field saves the question, it does not add an option" do
+    visit "/moderate/quizzes/#{@quiz.id}/questions/new"
+    fill_in "Question", with: "Enter saves?"
+    fill_in "Option 1", with: "Yes"
+    check "Option 1 is correct"
+    fill_in "Option 2", with: "No"
+    find_field("Option 2").send_keys(:enter)
+
+    assert_text "Enter saves?"
+    assert_equal %w[Yes No], Question.last.options.map(&:text)
+  end
+
+  test "Add option adds a row without saving the question" do
+    visit "/moderate/quizzes/#{@quiz.id}/questions/new"
+    fill_in "Question", with: "Still typing"
+    fill_in "Option 1", with: "Kept"
+    click_button "Add option"
+
+    assert_field "Question", with: "Still typing"
+    assert_field "Option 1", with: "Kept"
+    assert_field "Option 5", with: ""
+    assert_equal 0, Question.count
+  end
+
+  test "a rule failure in the browser shows the message and keeps the input" do
+    visit "/moderate/quizzes/#{@quiz.id}/questions/new"
+    fill_question_form(text: "Need two?", options: [ [ "Only", true ] ])
+    click_button "Save question"
+
+    assert_text "Add at least two options"
+    assert_field "Question", with: "Need two?"
+    assert_field "Option 1", with: "Only"
+    assert_equal 0, Question.count
+  end
+
+  test "a full preview run in the browser" do
+    build_question(@quiz, text: "First?", options: [ [ "Right", true ], [ "Wrong", false ] ])
+    build_question(@quiz, text: "Second?", options: [ [ "Nope", false ], [ "Yep", true ] ])
+    visit "/moderate/quizzes/#{@quiz.id}"
+    click_link "Preview"
+
+    assert_text "Question 1 of 2"
+    click_button "Wrong"
+    assert_text "Wrong!"
+    click_button "Next question"
+    assert_text "Question 2 of 2"
+    click_button "Yep"
+    assert_text "Correct!"
+    click_button "See score"
+    assert_text "Score: 1/2"
+    click_button "Start over"
+    assert_text "Question 1 of 2"
+  end
+
+test "the design stylesheet and its Inter font load in the browser" do
+  visit "/moderate"
+  font_statuses = page.evaluate_script("(async () => { await document.fonts.ready; return [...document.fonts].map((f) => f.family + ':' + f.status) })()")
+  background = page.evaluate_script("getComputedStyle(document.body).backgroundColor")
+
+  assert_includes font_statuses, "Inter:loaded"
+  assert_equal "rgb(233, 230, 255)", background # the design's lavender page color
+end
+end
