diff --git a/app/views/moderate/quizzes/preview.html.erb b/app/views/moderate/quizzes/preview.html.erb
new file mode 100644
index 0000000..808ed56
--- /dev/null
+++ b/app/views/moderate/quizzes/preview.html.erb
@@ -0,0 +1,73 @@
+<% page_title "Preview · #{@quiz.title}" %>
+<% preview = @preview %>
+
+<div class="preview-banner">
+  <span>Preview: answers are not saved</span>
+  <div class="buttons">
+    <%= button_to "Start over", preview_moderate_quiz_path(@quiz), method: :get, class: "btn btn--light btn--sm" %>
+    <%= link_to "Back to quiz", moderate_quiz_path(@quiz) %>
+  </div>
+</div>
+
+<div class="play">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span><%= @quiz.title %></span>
+  </div>
+
+  <div class="play__body play__body--top">
+    <% if preview.total.zero? %>
+      <div class="empty">No active questions to preview. Activate a question on the quiz page.</div>
+
+    <% elsif preview.finished? %>
+      <div class="card result-card">
+        <div class="result-card__label">That's the end of the quiz.</div>
+        <div class="result-card__score">Score: <%= preview.score %>/<%= preview.total %></div>
+      </div>
+
+    <% else %>
+      <% question = preview.current_question %>
+      <% picked = preview.picked_option %>
+
+      <div class="play-question__num">Question <%= preview.position %> of <%= preview.total %></div>
+      <div class="play-question__body"><%= question.text %></div>
+
+      <% if picked %>
+        <div class="play-options is-revealed">
+          <% question.options.each_with_index do |option, index| %>
+            <div class="play-option<%= " is-picked" if option == picked %><%= " is-correct" if option.correct? %>">
+              <span class="play-option__letter"><%= option_letter(index) %></span>
+              <span class="play-option__title"><%= option.text %></span>
+              <% if option.correct? %><span class="play-option__mark">Correct answer</span><% end %>
+            </div>
+          <% end %>
+        </div>
+
+        <% if picked.correct? %>
+          <div class="play-status play-status--right">Correct!</div>
+        <% else %>
+          <div class="play-status play-status--wrong">Wrong!</div>
+        <% end %>
+
+        <% if preview.last_question? %>
+          <%= button_to "See score", preview_moderate_quiz_path(@quiz), method: :get,
+                params: { answers: preview.answers_param_after_pick }, class: "btn btn--pink btn--lg" %>
+        <% else %>
+          <%= button_to "Next question", preview_moderate_quiz_path(@quiz), method: :get,
+                params: { answers: preview.answers_param_after_pick }, class: "btn btn--pink btn--lg" %>
+        <% end %>
+
+      <% else %>
+        <%= form_with url: preview_moderate_quiz_path(@quiz), method: :get, class: "play-options", data: { turbo: false } do %>
+          <%= hidden_field_tag :answers, preview.answers_param, id: nil %>
+          <% question.options.each_with_index do |option, index| %>
+            <button type="submit" name="pick" value="<%= option.id %>" class="play-option">
+              <span class="play-option__letter"><%= option_letter(index) %></span>
+              <span class="play-option__title"><%= option.text %></span>
+            </button>
+          <% end %>
+        <% end %>
+      <% end %>
+    <% end %>
+  </div>
+</div>
diff --git a/app/views/moderate/quizzes/show.html.erb b/app/views/moderate/quizzes/show.html.erb
new file mode 100644
index 0000000..f29c0c1
--- /dev/null
+++ b/app/views/moderate/quizzes/show.html.erb
@@ -0,0 +1,70 @@
+<% page_title @quiz.title %>
+
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+
+<div class="page-head">
+  <div>
+    <h1><%= @quiz.title %></h1>
+    <div class="meta mt-2">
+      <%= @questions.count(&:active?) %> of <%= @questions.size %> questions active ·
+      <%= time_per_question_text(@quiz) %> ·
+      <%= link_to "Settings", edit_moderate_quiz_path(@quiz) %>
+    </div>
+  </div>
+  <div class="buttons">
+    <%= button_to "Start a game", moderate_quiz_games_path(@quiz), class: "btn btn--pink", form: { data: { turbo: false } } %>
+    <%= link_to "Preview", preview_moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+    <%= link_to "Export", export_moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+  </div>
+</div>
+
+<section class="section mt-0">
+  <div class="section-head">
+    <h2>Questions</h2>
+    <%= button_to "Add question", new_moderate_quiz_question_path(@quiz), method: :get, class: "btn" %>
+  </div>
+
+  <% if @questions.any? %>
+    <ol class="question-list">
+      <% active_number = 0 %>
+      <% @questions.each_with_index do |question, index| %>
+        <% active_number += 1 if question.active? %>
+        <%= render "moderate/questions/item",
+              quiz: @quiz,
+              question: question,
+              number: (question.active? ? active_number : nil),
+              first: index.zero?,
+              last: index == @questions.size - 1 %>
+      <% end %>
+    </ol>
+  <% else %>
+    <div class="empty">No questions yet. Add the first question to start the quiz.</div>
+  <% end %>
+</section>
+
+<section class="section">
+  <div class="section-head">
+    <h2>Games</h2>
+  </div>
+
+  <% if @games.any? %>
+    <ul class="game-list">
+      <% @games.each do |game| %>
+        <li class="card game-item">
+          <div>
+            <div class="game-item__title">Game <%= game.code %> · started <%= l(game.created_at, format: :short) %></div>
+            <div class="meta mt-2">
+              <span class="badge<%= { "Running" => " badge--running", "Finished" => " badge--finished" }[game.status_label] %>"><%= game.status_label %></span>
+              · <%= pluralize(game.players.size, "player") %>
+            </div>
+          </div>
+          <div class="buttons">
+            <%= link_to "Open", moderate_game_path(game), class: "btn btn--sm" %>
+          </div>
+        </li>
+      <% end %>
+    </ul>
+  <% else %>
+    <div class="empty">No games yet. "Start a game" opens the big screen for this quiz.</div>
+  <% end %>
+</section>
diff --git a/app/views/play/_screen.html.erb b/app/views/play/_screen.html.erb
new file mode 100644
index 0000000..4338c3b
--- /dev/null
+++ b/app/views/play/_screen.html.erb
@@ -0,0 +1,106 @@
+<%# One phone's view of the game. The live controller fetches this partial again when the game changes. %>
+<% game = screen.game %>
+<main id="player-screen" class="play"
+      data-controller="live"
+      data-live-url-value="<%= play_state_path(game.code) %>"
+      data-live-version-value="<%= screen.version %>"
+      data-live-interval-value="5000"
+      data-action="live:refresh->live#refresh">
+
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span><%= game.quiz.title %></span>
+  </div>
+
+  <div class="play__body play__body--top">
+    <% if local_assigns[:message].present? %>
+      <p class="errors" role="alert"><%= message %></p>
+    <% end %>
+
+    <% if screen.joined? && screen.phase != :join %>
+      <h1 class="play-title">Hi, <%= screen.player.name %>!</h1>
+    <% end %>
+
+    <% case screen.phase %>
+    <% when :join %>
+      <h1 class="play-title"><%= game.quiz.title %></h1>
+      <p class="play-lead">Join the quiz with your name.</p>
+
+      <%= form_with url: join_play_path(game.code), method: :post, class: "join-form", data: { turbo: false } do |form| %>
+        <%= form.label :name, "Your name", for: "player_name", class: "field-label" %>
+        <%= form.text_field :name, id: "player_name", class: "input", maxlength: Player::NAME_MAX_LENGTH,
+              autocomplete: "nickname", autofocus: true, required: true %>
+        <% if local_assigns[:join_error].present? %>
+          <p class="errors" role="alert"><%= join_error %></p>
+        <% end %>
+        <%= form.submit "Join", class: "btn btn--pink" %>
+      <% end %>
+
+    <% when :over %>
+      <h2 class="play-title">The quiz is over</h2>
+
+      <% if screen.standing %>
+        <div class="result-card">
+          <p class="result-card__label">Place <%= screen.standing.place %> of <%= screen.leaderboard.player_count %></p>
+          <p class="result-card__score"><%= pluralize(screen.standing.points, "point") %></p>
+        </div>
+        <% if screen.winner? %>
+          <p class="winner-banner" role="status">You won!</p>
+        <% end %>
+      <% end %>
+
+    <% when :waiting %>
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <p class="play-lead">Waiting for the quiz to start</p>
+      </div>
+
+    <% when :open %>
+      <div class="play-question__num">Question <%= screen.position %> of <%= screen.total %></div>
+      <div class="play-question__body"><%= screen.question.text %></div>
+
+      <div class="play-options">
+        <% screen.option_rows.each do |row| %>
+          <%= button_to answer_play_path(game.code), params: { option_id: row.option.id },
+                class: "play-option#{' is-picked' if row.picked}", form_class: "play-option-form" do %>
+            <span class="play-option__letter"><%= option_letter(row.index) %></span>
+            <span class="play-option__title"><%= row.option.text %></span>
+            <% if row.picked %><span class="play-option__mark">Your answer</span><% end %>
+          <% end %>
+        <% end %>
+      </div>
+
+      <p class="play-status play-status--neutral">
+        <% if screen.picked_option %>
+          Your answer is saved. You can change it until the question closes.
+        <% else %>
+          Tap an answer. You can change it until the question closes.
+        <% end %>
+      </p>
+
+    <% when :closed %>
+      <div class="play-question__num">Question <%= screen.position %> of <%= screen.total %></div>
+      <div class="play-question__body"><%= screen.question.text %></div>
+
+      <div class="play-options is-revealed">
+        <% screen.option_rows.each do |row| %>
+          <div class="play-option<%= ' is-picked' if row.picked %><%= ' is-correct' if row.correct %>">
+            <span class="play-option__letter"><%= option_letter(row.index) %></span>
+            <span class="play-option__title"><%= row.option.text %></span>
+            <% if row.picked %><span class="play-option__mark">Your answer</span><% end %>
+            <% if row.correct %><span class="play-option__mark">Right answer</span><% end %>
+          </div>
+        <% end %>
+      </div>
+
+      <% case screen.result %>
+      <% when :right %>
+        <div class="play-status play-status--right">Correct!</div>
+      <% when :wrong %>
+        <div class="play-status play-status--wrong">Wrong!</div>
+      <% else %>
+        <div class="play-status play-status--neutral">No answer</div>
+      <% end %>
+    <% end %>
+  </div>
+</main>
