+# A question as the game plays it: a copy taken when the game started.
+class GameQuestion < ApplicationRecord
+  belongs_to :game
+  has_many :options, -> { order(:position, :id) }, class_name: "GameOption", dependent: :destroy, inverse_of: :game_question
+  has_many :answers, dependent: :destroy
