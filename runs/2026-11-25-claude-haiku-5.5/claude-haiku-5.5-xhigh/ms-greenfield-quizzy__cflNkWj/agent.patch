diff --git a/test/models/game_prizes_test.rb b/test/models/game_prizes_test.rb
new file mode 100644
index 0000000..c877480
--- /dev/null
+++ b/test/models/game_prizes_test.rb
@@ -0,0 +1,168 @@
+require "test_helper"
+
+# Picking winners after the end: Top N, Draw, Reset winners.
+class GamePrizesTest < ActiveSupport::TestCase
+  OPENED = Time.zone.local(2026, 11, 23, 10, 0, 0)
+
+  setup do
+    @quiz = build_quiz
+    3.times { |i| build_question(@quiz, text: "Question #{i + 1}?", options: [ [ "Right", true ], [ "Wrong", false ] ]) }
+    @game = @quiz.games.create!
+    travel_to(OPENED) { @game.start }
+    @ann = @game.players.create!(name: "Ann")
+    @ben = @game.players.create!(name: "Ben")
+    @cy = @game.players.create!(name: "Cy")
+    @dee = @game.players.create!(name: "Dee")
+    # Points: Ann 3, Ben 2, Cy 1, Dee 0.
+    @answers = {
+      @ann => %w[Right Right Right],
+      @ben => %w[Right Right Wrong],
+      @cy => %w[Right Wrong Wrong],
+      @dee => %w[Wrong Wrong Wrong]
+    }
+    # Questions 1 and 2 are answered and closed. Question 3 is answered but still open.
+    answer_question(1)
+    finish_question(1)
+    next_question(1)
+    answer_question(2)
+    finish_question(2)
+    next_question(2)
+    answer_question(3)
+  end
+
+  teardown { travel_back }
+
+  # Every player answers the question at this position, one second after it opened.
+  def answer_question(position)
+    game_question = @game.game_questions.find_by!(position: position)
+    @answers.each do |player, texts|
+      option = game_question.options.find_by!(text: texts[position - 1])
+      travel_to(game_question.opened_at + 1) { assert player.pick(option) }
+    end
+  end
+
+  def finish_question(position)
+    travel_to(OPENED + position * 10) { assert @game.finish_question }
+  end
+
+  def next_question(position)
+    travel_to(OPENED + position * 10 + 5) { assert @game.next_question }
+  end
+
+  # Closes the last question and ends the quiz.
+  def end_game
+    finish_question(3)
+    travel_to(OPENED + 100) { assert @game.end_quiz }
+    @game.reload
+  end
+
+  def winner_names
+    @game.winners.map(&:name)
+  end
+
+  test "winners can only be picked once the quiz has ended" do
+    refute @game.pick_top_winners
+    assert_includes @game.errors.full_messages, "End the quiz before picking winners."
+
+    refute @game.draw_winners
+    refute @game.reset_winners
+    assert_empty winner_names
+  end
+
+  test "Top N makes the first N players of the leaderboard the winners" do
+    end_game
+
+    assert @game.pick_top_winners
+    assert_equal %w[Ann Ben Cy], winner_names.sort
+  end
+
+  test "Top N uses the number of winners the quiz has now" do
+    end_game
+    @quiz.update!(winner_count: 1)
+
+    assert @game.pick_top_winners
+    assert_equal %w[Ann], winner_names
+  end
+
+  test "Top N never gives a prize to a player with 0 points, even with more prizes than scorers" do
+    @quiz.update!(winner_count: 10)
+    end_game
+
+    assert @game.pick_top_winners
+    refute_includes winner_names, "Dee"
+    assert_equal %w[Ann Ben Cy], winner_names.sort
+  end
+
+  test "Draw: players ahead of the N-th place win, and the N-th place is drawn from its tie" do
+    end_game
+
+    # 2 prizes: the 2nd place is Ben with 2 points. Ann has more, so she wins; Ben is the
+    # only player with exactly 2 points, so he is drawn.
+    @quiz.update!(winner_count: 2)
+    assert @game.draw_winners
+    assert_equal %w[Ann Ben], winner_names.sort
+
+    # 3 prizes: the 3rd place is Cy with 1 point. Ann and Ben are ahead of him.
+    @quiz.update!(winner_count: 3)
+    assert @game.draw_winners
+    assert_equal %w[Ann Ben Cy], winner_names.sort
+  end
+
+  test "Draw with more prizes than scorers gives every scorer a prize and nobody with 0 points" do
+    end_game
+    @quiz.update!(winner_count: 4)
+
+    assert @game.draw_winners
+    assert_equal %w[Ann Ben Cy], winner_names.sort
+  end
+
+  test "each pick replaces the previous winners" do
+    end_game
+    @quiz.update!(winner_count: 3)
+
+    assert @game.pick_top_winners
+    assert_equal %w[Ann Ben Cy], winner_names.sort
+    assert @game.reset_winners
+    assert_empty winner_names
+    assert @game.draw_winners
+    assert_equal %w[Ann Ben Cy], winner_names.sort
+  end
+
+  test "Reset winners removes the winners" do
+    end_game
+    @game.pick_top_winners
+    assert_equal 3, winner_names.size
+
+    assert @game.reset_winners
+    assert_empty winner_names
+  end
+
+  test "a player who lost the prize in a later pick is no longer marked" do
+    @quiz.update!(winner_count: 1)
+    end_game
+    @game.pick_top_winners
+    assert_equal %w[Ann], winner_names
+
+    @quiz.update!(winner_count: 2)
+    @game.pick_top_winners
+    assert_equal %w[Ann Ben], winner_names.sort
+  end
+
+  test "a pick sends one refresh to the big screen and one to the phones" do
+    end_game
+
+    assert_turbo_stream_broadcasts [ @game, :screen ], count: 1 do
+      assert_turbo_stream_broadcasts [ @game, :players ], count: 1 do
+        @game.pick_top_winners
+      end
+    end
+  end
+
+  test "a pick changes the game's version, so the screens fetch the new marks" do
+    end_game
+    before = @game.state_version
+
+    @game.pick_top_winners
+    assert_equal before + 1, @game.state_version
+  end
+end
diff --git a/test/models/game_screen_test.rb b/test/models/game_screen_test.rb
new file mode 100644
index 0000000..93432da
--- /dev/null
+++ b/test/models/game_screen_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class GameScreenTest < ActiveSupport::TestCase
+  setup do
+    @quiz = build_quiz(title: "Frontend Fest")
+    build_question(@quiz, text: "Largest planet?", options: [ [ "Jupiter", true ], [ "Mars", false ] ])
+    build_question(@quiz, text: "Second?", options: [ [ "A", false ], [ "B", true ] ])
+    @game = @quiz.games.create!
+    @screen = -> { GameScreen.new(@game.reload, join_url: "http://localhost:3000/play/#{@game.code}") }
+  end
+
+  test "the lobby shows the players waiting, and the join link" do
+    @game.players.create!(name: "Alice")
+    @game.players.create!(name: "Bob")
+
+    assert_equal :lobby, @screen.call.phase
+    assert_equal 2, @screen.call.players_count
+    assert_equal "http://localhost:3000/play/#{@game.code}", @screen.call.join_url
+  end
+
+  test "an open question has no correct flags and counts no answers on the screen" do
+    @game.start
+
+    screen = @screen.call
+    assert_equal :open, screen.phase
+    assert_equal "Largest planet?", screen.question.text
+    assert_equal 1, screen.position
+    assert_equal 2, screen.total
+    assert screen.option_rows.all? { |row| row.correct.nil? }
+    assert_equal [ 0 ], [ screen.answers_count ]
+  end
+
+  test "answers are counted per player for the open question" do
+    alice = @game.players.create!(name: "Alice")
+    bob = @game.players.create!(name: "Bob")
+    @game.players.create!(name: "Cara")
+    @game.start
+    alice.pick(@game.current_game_question.options.first)
+    bob.pick(@game.current_game_question.options.last)
+    bob.pick(@game.current_game_question.options.first)
+
+    screen = @screen.call
+    assert_equal 2, screen.answers_count
+    assert_equal 3, screen.players_count
+  end
+
+  test "once closed, correct options are revealed with the count per option" do
+    alice = @game.players.create!(name: "Alice")
+    @game.start
+    alice.pick(@game.current_game_question.options.first)
+    @game.finish_question
+
+    screen = @screen.call
+    assert_equal :closed, screen.phase
+    jupiter = screen.option_rows.find { |row| row.option.text == "Jupiter" }
+    mars = screen.option_rows.find { |row| row.option.text == "Mars" }
+    assert_equal true, jupiter.correct
+    assert_equal false, mars.correct
+    assert_equal 1, jupiter.count
+    assert_equal 0, mars.count
+    assert_equal 100, jupiter.share
+  end
+
+  test "the last question is recognised so the button can say End quiz" do
+    @game.start
+    @game.finish_question
+    refute @screen.call.last_question?
+
+    @game.next_question
+    @game.finish_question
+    assert @screen.call.last_question?
+  end
+
+  test "after the end the screen says the quiz is over" do
+    @game.start
+    @game.finish_question
+    @game.next_question
+    @game.finish_question
+    @game.end_quiz
+
+    assert_equal :finished, @screen.call.phase
+  end
+
+  test "the version changes with the game, the players and the answers" do
+    version = @screen.call.version
+    @game.players.create!(name: "Late")
+    refute_equal version, @screen.call.version
+
+    @game.start
+    version = @screen.call.version
+    @game.current_game_question.options.first.answers.create!(player: @game.players.first, game_question: @game.current_game_question)
+    refute_equal version, @screen.call.version
+  end
+end
diff --git a/test/models/game_test.rb b/test/models/game_test.rb
new file mode 100644
index 0000000..7b5264a
--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,220 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  setup do
+    @quiz = build_quiz
+    @first = build_question(@quiz, text: "First?", options: [ [ "Yes", true ], [ "No", false ] ])
+    @second = build_question(@quiz, text: "Second?", options: [ [ "A", false ], [ "B", true ] ])
+    @skipped = build_question(@quiz, text: "Skipped?", active: false)
+    @game = @quiz.games.create!
+  end
+
+  test "a new game gets a five character join code from the readable alphabet" do
+    assert_match Game::CODE_FORMAT, @game.code
+    assert_equal 5, @game.code.length
+    refute_match(/[ILO01]/, @game.code)
+  end
+
+  test "each game has its own code, even for the same quiz" do
+    other = @quiz.games.create!
+    refute_equal @game.code, other.code
+  end
+
+  test "a new game is in the lobby with no questions copied yet" do
+    assert @game.lobby?
+    refute @game.running?
+    refute @game.finished?
+    assert_equal 0, @game.total_questions
+    assert_nil @game.current_game_question
+    assert_equal "Waiting to start", @game.status_label
+  end
+
+  test "start copies only the active questions, in order, with their options" do
+    assert @game.start
+
+    assert_equal %w[First? Second?], @game.game_questions.map(&:text)
+    assert_equal [ 1, 2 ], @game.game_questions.map(&:position)
+    assert_equal [ [ "Yes", true ], [ "No", false ] ], @game.game_questions.first.options.map { |o| [ o.text, o.correct ] }
+    assert_equal 1, @game.current_position
+    assert @game.running?
+    assert_equal "Running", @game.status_label
+  end
+
+  test "start opens the first question and nothing else" do
+    @game.start
+
+    assert @game.game_questions.first.open?
+    assert @game.game_questions.second.pending?
+  end
+
+  test "start without any active question is refused and leaves the game in the lobby" do
+    @quiz.questions.update_all(active: false)
+
+    refute @game.start
+    assert_includes @game.errors.full_messages, "Activate at least one question before starting the game."
+    assert @game.lobby?
+    assert_equal 0, @game.game_questions.count
+  end
+
+  test "a game cannot be started twice" do
+    @game.start
+
+    refute @game.start
+    assert_includes @game.errors.full_messages, "The quiz has already started."
+  end
+
+  test "finish closes the open question and next opens the following one" do
+    @game.start
+
+    assert @game.finish_question
+    assert @game.question_closed?
+    assert @game.current_game_question.closed?
+
+    assert @game.next_question
+    assert_equal 2, @game.current_position
+    assert @game.question_open?
+    assert @game.game_questions.first.reload.closed?
+  end
+
+  test "finish is refused when no question is open" do
+    refute @game.finish_question
+    assert_includes @game.errors.full_messages, "Start the quiz first."
+
+    @game.start
+    @game.finish_question
+    refute @game.finish_question
+    assert_includes @game.errors.full_messages, "No question is open."
+  end
+
+  test "next is refused while the question is still open" do
+    @game.start
+
+    refute @game.next_question
+    assert_includes @game.errors.full_messages, "Finish the question before going on."
+    assert_equal 1, @game.current_position
+  end
+
+  test "the last question is ended with end_quiz, not next" do
+    @game.start
+    @game.finish_question
+    @game.next_question
+    @game.finish_question
+
+    assert @game.last_question?
+    refute @game.next_question
+    refute @game.end_quiz.nil?
+    assert @game.finished?
+    assert_equal "Finished", @game.status_label
+  end
+
+  test "end_quiz is refused before the last question is finished" do
+    @game.start
+
+    refute @game.end_quiz
+    assert_includes @game.errors.full_messages, "Finish the question before ending the quiz."
+
+    @game.finish_question
+    refute @game.end_quiz
+    assert_includes @game.errors.full_messages, "There are more questions to show."
+  end
+
+  test "the moderator is told why a button cannot work in the lobby or after the end" do
+    refute @game.finish_question
+    assert_includes @game.errors.full_messages, "Start the quiz first."
+    refute @game.next_question
+    assert_includes @game.errors.full_messages, "Start the quiz first."
+
+    @game.start
+    @game.finish_question
+    @game.next_question
+    @game.finish_question
+    @game.end_quiz
+    refute @game.next_question
+    assert_includes @game.errors.full_messages, "The quiz has ended."
+    refute @game.end_quiz
+    assert_includes @game.errors.full_messages, "The quiz has ended."
+  end
+
+  test "a finished game cannot move on" do
+    @game.start
+    @game.finish_question
+    @game.next_question
+    @game.finish_question
+    @game.end_quiz
+
+    refute @game.finish_question
+    refute @game.next_question
+  end
+
+  test "editing the quiz after the start does not change the running game" do
+    @game.start
+    @first.update!(text: "Changed?")
+    build_question(@quiz, text: "Late addition?")
+
+    assert_equal %w[First? Second?], @game.game_questions.map(&:text)
+  end
+
+  test "every state change bumps the version that live views compare" do
+    version = @game.state_version
+    @game.start
+    assert_operator @game.state_version, :>, version
+
+    version = @game.state_version
+    @game.finish_question
+    assert_operator @game.state_version, :>, version
+  end
+
+  test "a stale moderator click cannot move the game twice" do
+    @game.start
+    stale = Game.find(@game.id)
+
+    assert @game.finish_question
+    assert @game.next_question
+
+    refute stale.finish_question
+    assert_includes stale.errors.full_messages, "No question is open."
+    refute stale.next_question
+    assert_equal 2, @game.reload.current_position
+  end
+
+  test "a double click on Finish closes the question once" do
+    @game.start
+    first_tab = Game.find(@game.id)
+    second_tab = Game.find(@game.id)
+
+    assert first_tab.finish_question
+    refute second_tab.finish_question
+  end
+
+  test "a successful change tells the big screen and the phones to refresh" do
+    assert_turbo_stream_broadcasts [ @game, :screen ], count: 1 do
+      assert_turbo_stream_broadcasts [ @game, :players ], count: 1 do
+        @game.start
+      end
+    end
+  end
+
+  test "a refused change sends no signal" do
+    assert_turbo_stream_broadcasts [ @game, :screen ], count: 0 do
+      @game.finish_question
+    end
+  end
+
+  test "joining is one of the ways a game is found by its code" do
+    assert_equal @game, Game.with_join_code(@game.code.downcase)
+    assert_nil Game.with_join_code("ZZZZZ")
+  end
+
+  test "deleting the quiz deletes its games, players and answers" do
+    @game.start
+    player = @game.players.create!(name: "Alice")
+    player.pick(@game.current_game_question.options.first)
+
+    assert_difference -> { Game.count }, -1 do
+      @quiz.destroy!
+    end
+    assert_equal 0, Player.count
+    assert_equal 0, Answer.count
+    assert_equal 0, GameOption.count
+  end
+end
diff --git a/test/models/game_timer_test.rb b/test/models/game_timer_test.rb
new file mode 100644
index 0000000..8c3c4fd
--- /dev/null
+++ b/test/models/game_timer_test.rb
@@ -0,0 +1,237 @@
+require "test_helper"
+
+# The per-question timer: the deadline is opened_at + the time limit copied when the
+# game started, and a question whose time is up closes at its deadline.
+class GameTimerTest < ActiveSupport::TestCase
+  OPENED = Time.utc(2026, 11, 23, 9, 0, 0)
+
+  setup do
+    @quiz = build_quiz
+    @first = build_question(@quiz, text: "First?", options: [ [ "Yes", true ], [ "No", false ] ])
+    @second = build_question(@quiz, text: "Second?", options: [ [ "A", false ], [ "B", true ] ])
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    @game = @quiz.games.create!
+  end
+
+  # travel_to drops sub-second time unless asked, and the countdown is in milliseconds.
+  def at(time, &block)
+    travel_to(time, with_usec: true, &block)
+  end
+
+  def start_at(time = OPENED)
+    at(time) { assert @game.start }
+    @game.reload
+  end
+
+  test "start copies the quiz's time per question into the game" do
+    start_at
+
+    assert_equal 90, @game.time_limit_seconds
+  end
+
+  test "a later change to the quiz does not change a game that has started" do
+    start_at
+    @quiz.update!(timer_minutes: 5, timer_seconds: 0)
+
+    assert_equal 90, Game.find(@game.id).time_limit_seconds
+  end
+
+  test "a game started after the quiz changed plays with the new time" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 20)
+    start_at
+
+    assert_equal 20, @game.time_limit_seconds
+  end
+
+  test "without a timer there is no deadline and nothing closes by itself" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    start_at
+
+    assert_nil @game.question_deadline
+    at(OPENED + 10_000) do
+      refute @game.close_expired_question
+      assert @game.question_open?
+    end
+  end
+
+  test "the deadline is the moment the question opened plus the time limit" do
+    start_at
+
+    assert_equal OPENED + 90, @game.question_deadline
+    assert_equal OPENED, @game.current_game_question.opened_at
+  end
+
+  test "the deadline restarts with each question, when it opens" do
+    start_at
+    at(OPENED + 40) { assert @game.finish_question }
+    at(OPENED + 45) { assert @game.next_question }
+    @game.reload
+
+    assert_equal OPENED + 45 + 90, @game.question_deadline
+  end
+
+  test "reloading the game does not move the deadline" do
+    start_at
+    deadline = @game.question_deadline
+
+    at(OPENED + 30) do
+      assert_equal deadline, Game.find(@game.id).question_deadline
+    end
+  end
+
+  test "time is up exactly at the deadline, not before" do
+    start_at
+
+    at(OPENED + 89.999) { refute @game.time_up? }
+    at(OPENED + 90) { assert @game.time_up? }
+  end
+
+  test "close_expired_question does nothing before the deadline" do
+    start_at
+
+    at(OPENED + 89) do
+      refute @game.close_expired_question
+    end
+    assert @game.reload.question_open?
+    assert_nil @game.current_game_question.closed_at
+  end
+
+  test "close_expired_question closes the question at its deadline, as Finish would" do
+    start_at
+
+    at(OPENED + 95) do
+      assert @game.close_expired_question
+    end
+    game_question = @game.game_questions.first.reload
+
+    assert game_question.closed?
+    assert_equal OPENED + 90, game_question.closed_at
+    assert @game.question_closed?
+    assert_equal 1, @game.current_position
+    refute @game.finished?
+  end
+
+  test "the closing happens once, and a second check does nothing" do
+    start_at
+
+    at(OPENED + 91) do
+      assert @game.close_expired_question
+      refute Game.find(@game.id).close_expired_question
+    end
+  end
+
+  test "a question that closed by the timer counts as closed for the next step" do
+    start_at
+
+    at(OPENED + 91) do
+      assert @game.next_question
+    end
+    @game.reload
+
+    assert_equal 2, @game.current_position
+    assert @game.question_open?
+    assert_equal OPENED + 91 + 90, @game.question_deadline
+  end
+
+  test "the last question closes by the timer and then the quiz can end" do
+    start_at
+    at(OPENED + 10) { assert @game.finish_question && @game.next_question }
+
+    at(OPENED + 200) do
+      assert @game.end_quiz
+    end
+    @game.reload
+
+    assert @game.finished?
+    assert_equal OPENED + 10 + 90, @game.game_questions.last.closed_at
+  end
+
+  test "Finish before the deadline closes the question at that moment" do
+    start_at
+
+    at(OPENED + 30) { assert @game.finish_question }
+
+    assert_equal OPENED + 30, @game.game_questions.first.reload.closed_at
+  end
+
+  test "Finish after the deadline has passed finds the question already closed by the timer" do
+    start_at
+
+    at(OPENED + 100) do
+      refute @game.finish_question
+      assert_includes @game.errors.full_messages, "No question is open."
+    end
+    assert_equal OPENED + 90, @game.game_questions.first.reload.closed_at
+  end
+
+  test "a pick after the deadline is refused and closes the question at its deadline" do
+    start_at
+    player = @game.players.create!(name: "Alice")
+    option = @game.game_questions.first.options.first
+
+    at(OPENED + 100) do
+      refute player.pick(option)
+      assert_includes player.errors.full_messages, "This question is closed."
+    end
+
+    assert_equal OPENED + 90, @game.game_questions.first.reload.closed_at
+    assert_nil player.answer_for(@game.game_questions.first)
+  end
+
+  test "a pick before the deadline is accepted" do
+    start_at
+    player = @game.players.create!(name: "Alice")
+    option = @game.game_questions.first.options.first
+
+    at(OPENED + 89) { assert player.pick(option) }
+    assert_equal OPENED + 89, player.answer_for(@game.game_questions.first).picked_at
+  end
+
+  test "a refused late pick tells the big screen to refresh" do
+    start_at
+    player = @game.players.create!(name: "Alice")
+    option = @game.game_questions.first.options.first
+
+    assert_turbo_stream_broadcasts([ @game, :screen ], count: 1) do
+      at(OPENED + 100) { refute player.pick(option) }
+    end
+  end
+
+  test "closing by the timer tells the big screen and the phones to refresh" do
+    start_at
+
+    assert_turbo_stream_broadcasts([ @game, :screen ], count: 1) do
+      assert_turbo_stream_broadcasts([ @game, :players ], count: 1) do
+        at(OPENED + 90) { assert @game.close_expired_question }
+      end
+    end
+  end
+
+  test "the countdown on the big screen is the time left, rounded up to whole milliseconds" do
+    start_at
+
+    at(OPENED + 30.25) do
+      screen = GameScreen.new(Game.find(@game.id), join_url: "http://x/play/ABCDE")
+
+      assert_equal 59_750, screen.countdown_ms
+    end
+  end
+
+  test "the countdown is gone once the question is closed, and before it opens" do
+    lobby_screen = GameScreen.new(@game, join_url: "http://x/play/ABCDE")
+    assert_nil lobby_screen.countdown_ms
+
+    start_at
+    at(OPENED + 90) { @game.close_expired_question }
+
+    assert_nil GameScreen.new(@game.reload, join_url: "http://x/play/ABCDE").countdown_ms
+  end
+
+  test "the countdown never goes below zero" do
+    start_at
+
+    at(OPENED + 120) do
+      assert_equal 0, GameScreen.new(Game.find(@game.id), join_url: "http://x/play/ABCDE").countdown_ms
+    end
+  end
+end
diff --git a/test/models/leaderboard_test.rb b/test/models/leaderboard_test.rb
new file mode 100644
index 0000000..6dad7ae
--- /dev/null
+++ b/test/models/leaderboard_test.rb
@@ -0,0 +1,247 @@
+require "test_helper"
+
+# Points and speed: the order of the standings, the places, and who may win.
+class LeaderboardTest < ActiveSupport::TestCase
+  OPENED = Time.zone.local(2026, 11, 23, 10, 0, 0)
+
+  setup do
+    @quiz = build_quiz
+    3.times { |i| build_question(@quiz, text: "Question #{i + 1}?", options: [ [ "Right", true ], [ "Wrong", false ] ]) }
+    @game = @quiz.games.create!
+    travel_to(OPENED) { @game.start }
+    @ann = @game.players.create!(name: "Ann")
+    @ben = @game.players.create!(name: "Ben")
+    @cy = @game.players.create!(name: "Cy")
+  end
+
+  teardown { travel_back }
+
+  # Picks the option with this text on the open question, `after` seconds after it opened.
+  def pick(player, text, after:)
+    question = @game.current_game_question
+    option = question.options.find_by!(text: text)
+    travel_to(question.opened_at + after) { assert player.pick(option) }
+  end
+
+  # Finishes the open question at `at` and opens the next one at the same moment.
+  def finish_and_next(at)
+    travel_to(at) do
+      assert @game.finish_question
+      assert @game.next_question
+    end
+  end
+
+  def finish_at(at)
+    travel_to(at) { assert @game.finish_question }
+  end
+
+  def board
+    Leaderboard.new(@game)
+  end
+
+  def order_of(entries)
+    entries.map { |entry| entry.player.name }
+  end
+
+  test "a correct answer is one point, a wrong answer none" do
+    pick(@ann, "Right", after: 1)
+    pick(@ben, "Wrong", after: 1)
+    finish_at(OPENED + 10)
+
+    ann = board.entry_for(@ann)
+    ben = board.entry_for(@ben)
+    assert_equal 1, ann.points
+    assert_equal 0, ben.points
+  end
+
+  test "every joined player is on the board, even without an answer" do
+    pick(@ann, "Right", after: 1)
+    finish_at(OPENED + 10)
+
+    assert_equal 3, board.player_count
+    assert_equal [ "Ann", "Ben", "Cy" ], board.entries.map { |entry| entry.player.name }.sort
+  end
+
+  test "more points rank higher, whatever the speed" do
+    pick(@ben, "Right", after: 0.5)   # fast, one point
+    pick(@ann, "Right", after: 9)     # slow, but Ann also gets the second point
+    pick(@cy, "Wrong", after: 1)
+    finish_and_next(OPENED + 10)
+    pick(@ann, "Right", after: 8)
+    pick(@ben, "Wrong", after: 0.5)
+    pick(@cy, "Wrong", after: 1)
+    finish_at(OPENED + 20)
+
+    assert_equal [ "Ann", "Ben", "Cy" ], order_of(board.entries)
+    assert_equal [ 2, 1, 0 ], board.entries.map(&:points)
+    assert_equal [ 1, 2, 3 ], board.entries.map(&:place)
+  end
+
+  test "equal points: the lower total time of the correct answers ranks higher" do
+    pick(@ann, "Right", after: 1)
+    pick(@cy, "Right", after: 5)
+    finish_and_next(OPENED + 10)
+    pick(@ann, "Right", after: 2)     # Ann: 1 + 2 = 3 seconds
+    pick(@cy, "Right", after: 3)      # Cy: 5 + 3 = 8 seconds
+    finish_at(OPENED + 20)
+
+    assert_equal [ "Ann", "Cy", "Ben" ], order_of(board.entries)
+    assert_equal [ 1, 2, 3 ], board.entries.map(&:place)
+    assert_equal 3_000_000, board.entry_for(@ann).time_us
+    assert_equal 8_000_000, board.entry_for(@cy).time_us
+  end
+
+  test "a wrong pick adds no time, so only the correct answers are timed" do
+    pick(@ben, "Wrong", after: 0.1)
+    pick(@ann, "Right", after: 4)     # Ann: one point, 4 seconds
+    finish_and_next(OPENED + 10)
+    pick(@ben, "Right", after: 2)     # Ben: one point, 2 seconds
+    pick(@ann, "Wrong", after: 1)     # Ann's wrong pick does not change her time
+    finish_at(OPENED + 20)
+
+    assert_equal [ 1, 1 ], [ board.entry_for(@ann).points, board.entry_for(@ben).points ]
+    assert_equal 4_000_000, board.entry_for(@ann).time_us
+    assert_equal 2_000_000, board.entry_for(@ben).time_us
+    assert_equal [ "Ben", "Ann", "Cy" ], order_of(board.entries)
+  end
+
+  test "the time runs to the last pick, not the first" do
+    pick(@ann, "Right", after: 1)
+    pick(@ann, "Wrong", after: 2)
+    pick(@ann, "Right", after: 6)     # the last pick is the one that counts: 6 seconds
+    pick(@ben, "Right", after: 3)
+    finish_at(OPENED + 10)
+
+    assert_equal 6_000_000, board.entry_for(@ann).time_us
+    assert_equal [ "Ben", "Ann", "Cy" ], order_of(board.entries)
+  end
+
+  test "players with exactly the same points and time share a place" do
+    pick(@ann, "Right", after: 2)
+    pick(@ben, "Right", after: 2)
+    pick(@cy, "Right", after: 4)
+    finish_at(OPENED + 10)
+
+    assert_equal [ 1, 1, 3 ], board.entries.map(&:place)
+  end
+
+  test "players with no points share the last place" do
+    @dee = @game.players.create!(name: "Dee")
+    pick(@ann, "Right", after: 1)
+    pick(@ben, "Right", after: 5)
+    pick(@cy, "Wrong", after: 1)
+    finish_at(OPENED + 10)
+
+    assert_equal [ 1, 2, 3, 3 ], board.entries.map(&:place)
+    assert_equal [ 1, 1, 0, 0 ], board.entries.map(&:points)
+    assert_equal "Dee", board.entries.last.player.name
+  end
+
+  test "scoring entries leave out players with no points" do
+    pick(@ann, "Right", after: 1)
+    finish_at(OPENED + 10)
+
+    assert_equal [ "Ann" ], order_of(board.scoring_entries)
+  end
+
+  test "entry_for is nil for someone who never joined this game" do
+    finish_at(OPENED + 10)
+    other = @quiz.games.create!.players.create!(name: "Stranger")
+
+    assert_nil board.entry_for(other)
+  end
+
+  test "top N: the first N players of the leaderboard who have points" do
+    pick(@ann, "Right", after: 1)
+    pick(@ben, "Wrong", after: 0.5)
+    pick(@cy, "Right", after: 5)
+    finish_and_next(OPENED + 10)
+    pick(@ann, "Right", after: 2)
+    pick(@cy, "Right", after: 3)
+    finish_at(OPENED + 20)
+
+    assert_equal [ "Ann" ], board.top_winners(1).map(&:name)
+    assert_equal [ "Ann", "Cy" ], board.top_winners(2).map(&:name)
+    assert_equal [ "Ann", "Cy" ], board.top_winners(3).map(&:name), "Ben has no points and cannot win"
+    assert_equal [ "Ann", "Cy" ], board.top_winners(10).map(&:name)
+  end
+
+  test "top N with nobody scoring gives no winners" do
+    finish_at(OPENED + 10)
+
+    assert_empty board.top_winners(3)
+  end
+
+  # Ann 3 points; Ben, Cy and Dee 2 points each (Ben fastest, then Cy, then Dee);
+  # Eve 1 point. The 3rd place is Cy, so the tie at 2 points is Ben, Cy and Dee.
+  def build_draw_board
+    @dee = @game.players.create!(name: "Dee")
+    @eve = @game.players.create!(name: "Eve")
+    pick(@ann, "Right", after: 1)
+    pick(@ben, "Right", after: 2)
+    pick(@cy, "Right", after: 3)
+    pick(@dee, "Right", after: 4)
+    pick(@eve, "Right", after: 5)
+    finish_and_next(OPENED + 10)
+    pick(@ann, "Right", after: 1)
+    pick(@ben, "Right", after: 2)
+    pick(@cy, "Right", after: 3)
+    pick(@dee, "Right", after: 4)
+    pick(@eve, "Wrong", after: 5)
+    finish_and_next(OPENED + 20)
+    pick(@ann, "Right", after: 1)
+    pick(@ben, "Wrong", after: 2)
+    pick(@cy, "Wrong", after: 3)
+    pick(@dee, "Wrong", after: 4)
+    pick(@eve, "Wrong", after: 5)
+    finish_at(OPENED + 30)
+
+    assert_equal [ [ "Ann", 3 ], [ "Ben", 2 ], [ "Cy", 2 ], [ "Dee", 2 ], [ "Eve", 1 ] ],
+                 board.entries.map { |entry| [ entry.player.name, entry.points ] }
+  end
+
+  test "draw: players ahead of the N-th place always win, the rest come from the tie at that place" do
+    build_draw_board
+
+    seen = Hash.new(0)
+    200.times do
+      winners = board.drawn_winners(3).map(&:name).sort
+      assert_equal 3, winners.size
+      assert_includes winners, "Ann", "Ann has more points than the 3rd place"
+      assert_empty winners - %w[Ann Ben Cy Dee], "Eve has fewer points than the tie and cannot win"
+      winners.each { |name| seen[name] += 1 }
+    end
+    assert_equal 200, seen["Ann"]
+    assert seen["Ben"].positive? && seen["Cy"].positive? && seen["Dee"].positive?,
+           "each player in the tie can be drawn"
+  end
+
+  test "draw with a tie at the 2nd place draws one prize from the tie" do
+    build_draw_board
+
+    results = Set.new
+    200.times { results << board.drawn_winners(2).map(&:name).sort }
+    assert_equal [ %w[Ann Ben], %w[Ann Cy], %w[Ann Dee] ].to_set, results
+  end
+
+  test "draw: speed does not decide the tie, so each of the three possible draws happens" do
+    build_draw_board
+
+    results = Set.new
+    300.times { results << board.drawn_winners(3).map(&:name).sort }
+    assert_equal [ %w[Ann Ben Cy], %w[Ann Ben Dee], %w[Ann Cy Dee] ].to_set, results
+  end
+
+  test "draw: when fewer players have points than prizes, all of them win" do
+    pick(@ann, "Right", after: 1)
+    finish_at(OPENED + 10)
+
+    assert_equal [ "Ann" ], board.drawn_winners(3).map(&:name)
+  end
+
+  test "draw: with no points at all nobody wins" do
+    finish_at(OPENED + 10)
+
+    assert_empty board.drawn_winners(3)
+  end
+end
diff --git a/test/models/player_screen_test.rb b/test/models/player_screen_test.rb
new file mode 100644
index 0000000..d14f601
--- /dev/null
+++ b/test/models/player_screen_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class PlayerScreenTest < ActiveSupport::TestCase
+  setup do
+    @quiz = build_quiz(title: "Frontend Fest")
+    build_question(@quiz, text: "Largest planet?", options: [ [ "Jupiter", true ], [ "Mars", false ] ])
+    build_question(@quiz, text: "Second?", options: [ [ "A", false ], [ "B", true ] ])
+    @game = @quiz.games.create!
+    @alice = @game.players.create!(name: "Alice")
+  end
+
+  def screen(player = @alice)
+    PlayerScreen.new(@game.reload, player&.reload)
+  end
+
+  test "someone who has not joined sees the join form, and then the end" do
+    assert_equal :join, screen(nil).phase
+    refute screen(nil).joined?
+
+    @game.start
+    @game.finish_question
+    @game.next_question
+    @game.finish_question
+    @game.end_quiz
+    assert_equal :over, screen(nil).phase
+  end
+
+  test "a joined player waits until the quiz starts" do
+    assert_equal :waiting, screen.phase
+    assert screen.joined?
+  end
+
+  test "an open question offers its options with no correctness" do
+    @game.start
+
+    view = screen
+    assert_equal :open, view.phase
+    assert_equal %w[Jupiter Mars], view.option_rows.map { |row| row.option.text }
+    assert view.option_rows.all? { |row| row.correct.nil? }
+    assert_nil view.picked_option
+  end
+
+  test "a pick is shown on the open question, and the last one counts" do
+    @game.start
+    first, second = @game.current_game_question.options
+    @alice.pick(first)
+    @alice.pick(second)
+
+    view = screen
+    assert_equal second, view.picked_option
+    assert_equal [ false, true ], view.option_rows.map(&:picked)
+  end
+
+  test "a closed question reveals the correct options and reports a right pick" do
+    @game.start
+    @alice.pick(@game.current_game_question.options.first)
+    @game.finish_question
+
+    view = screen
+    assert_equal :closed, view.phase
+    assert_equal :right, view.result
+    assert_equal [ true, false ], view.option_rows.map(&:correct)
+  end
+
+  test "no answer is reported when nothing was picked" do
+    @game.start
+    @game.finish_question
+
+    assert_equal :none, screen.result
+  end
+
+  test "a wrong pick is reported as wrong after the close" do
+    @game.start
+    @alice.pick(@game.current_game_question.options.last)
+    @game.finish_question
+
+    assert_equal :wrong, screen.result
+  end
+
+  test "the join form only changes when the quiz ends" do
+    join_version = screen(nil).version
+    @game.start
+    assert_equal join_version, screen(nil).version
+
+    @game.finish_question
+    @game.next_question
+    @game.finish_question
+    @game.end_quiz
+    refute_equal join_version, screen(nil).version
+  end
+
+  test "joined players get a version that changes with their own answer" do
+    @game.start
+    before = screen.version
+    @alice.pick(@game.current_game_question.options.first)
+
+    refute_equal before, screen.version
+  end
+end
diff --git a/test/models/player_test.rb b/test/models/player_test.rb
new file mode 100644
index 0000000..abf0439
--- /dev/null
+++ b/test/models/player_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class PlayerTest < ActiveSupport::TestCase
+  setup do
+    @quiz = build_quiz
+    build_question(@quiz, text: "First?", options: [ [ "Yes", true ], [ "No", false ] ])
+    build_question(@quiz, text: "Second?", options: [ [ "A", false ], [ "B", true ] ])
+    @game = @quiz.games.create!
+    @game.start
+    @alice = @game.players.create!(name: "  Alice   Liddell ")
+  end
+
+  test "the name is trimmed and squeezed, and every player gets a token" do
+    assert_equal "Alice Liddell", @alice.name
+    assert @alice.token.present?
+    refute_equal @alice.token, @game.players.create!(name: "Bob").token
+  end
+
+  test "a blank name is refused with a plain message" do
+    player = @game.players.new(name: "   ")
+
+    refute player.valid?
+    assert_equal [ "Enter your name" ], player.errors[:name]
+  end
+
+  test "a name longer than the limit is refused" do
+    player = @game.players.new(name: "x" * (Player::NAME_MAX_LENGTH + 1))
+
+    refute player.valid?
+    assert player.errors[:name].any?
+  end
+
+  test "a pick on the open question is saved" do
+    option = @game.current_game_question.options.first
+
+    assert @alice.pick(option)
+    assert_equal option, @alice.answer_for(@game.current_game_question).game_option
+  end
+
+  test "picking again changes the answer, and there is still one row" do
+    question = @game.current_game_question
+    @alice.pick(question.options.first)
+    @alice.pick(question.options.last)
+
+    assert_equal 1, Answer.where(player: @alice, game_question: question).count
+    assert_equal question.options.last, @alice.answer_for(question).game_option
+  end
+
+  test "a pick after the question closed is refused and the old pick stays" do
+    question = @game.current_game_question
+    @alice.pick(question.options.first)
+    @game.finish_question
+
+    refute @alice.pick(question.options.last)
+    assert_includes @alice.errors.full_messages, "This question is closed."
+    assert_equal question.options.first, @alice.answer_for(question).game_option
+  end
+
+  test "an option of an earlier question cannot be picked now" do
+    @game.finish_question
+    @game.next_question
+    old_option = @game.game_questions.first.options.first
+
+    refute @alice.pick(old_option)
+    assert_includes @alice.errors.full_messages, "This question is closed."
+  end
+
+  test "an option from another game is refused" do
+    other_quiz = build_quiz(title: "Other")
+    build_question(other_quiz, text: "Elsewhere?")
+    other_game = other_quiz.games.create!
+    other_game.start
+    foreign = other_game.current_game_question.options.first
+
+    refute @alice.pick(foreign)
+    assert_includes @alice.errors.full_messages, "That answer is not part of this game."
+  end
+
+  test "picks are refused in the lobby and after the end" do
+    lobby_game = @quiz.games.create!
+    lobby_player = lobby_game.players.create!(name: "Early")
+    lobby_game.start
+    lobby_game.players.create!(name: "Late")
+    lobby_option = @game.current_game_question.options.first
+    refute lobby_player.pick(lobby_option)
+
+    @game.finish_question
+    @game.next_question
+    @game.finish_question
+    @game.end_quiz
+    refute @alice.pick(@game.game_questions.last.options.first)
+    assert_includes @alice.errors.full_messages, "This question is closed."
+  end
+
+  test "a successful pick tells the big screen to refresh" do
+    option = @game.current_game_question.options.first
+
+    assert_turbo_stream_broadcasts [ @game, :screen ], count: 1 do
+      @alice.pick(option)
+    end
+  end
+end
diff --git a/test/models/question_test.rb b/test/models/question_test.rb
new file mode 100644
index 0000000..a719f20
--- /dev/null
+++ b/test/models/question_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class QuestionTest < ActiveSupport::TestCase
+  setup do
+    @quiz = build_quiz
+  end
+
+  def row(text, correct = false)
+    Question::OptionRow.new(text: text, correct: correct)
+  end
+
+  test "a question needs at least two filled options" do
+    question = Question.new(quiz: @quiz, text: "Q?")
+    question.option_rows = [ row("Only one", true), row("", false), row("  ", false) ]
+
+    assert_not question.valid?
+    assert_includes question.errors.full_messages, "Add at least two options"
+    assert_not_includes question.errors.full_messages, "Mark at least one option as correct"
+  end
+
+  test "at least one filled option must be correct" do
+    question = Question.new(quiz: @quiz, text: "Q?")
+    question.option_rows = [ row("A"), row("B") ]
+
+    assert_not question.valid?
+    assert_equal [ "Mark at least one option as correct" ], question.errors.full_messages
+  end
+
+  test "a correct option on an empty row does not count" do
+    question = Question.new(quiz: @quiz, text: "Q?")
+    question.option_rows = [ row("A"), row("B"), row("", true) ]
+
+    assert_not question.valid?
+    assert_equal [ "Mark at least one option as correct" ], question.errors.full_messages
+  end
+
+  test "empty rows are skipped and several correct options are fine" do
+    question = Question.new(quiz: @quiz, text: "Q?")
+    question.option_rows = [ row("A", true), row(""), row("  B  ", true), row("C") ]
+
+    assert question.save
+    assert_equal [ "A", "B", "C" ], question.options.map(&:text)
+    assert_equal [ true, true, false ], question.options.map(&:correct)
+    assert_equal [ 1, 2, 3 ], question.options.map(&:position)
+  end
+
+  test "a rejected save changes nothing in the database" do
+    question = build_question(@quiz, options: [ [ "Jupiter", true ], [ "Mars", false ] ])
+    question.text = "Changed"
+    question.option_rows = [ row("Venus"), row("Earth") ]
+
+    assert_not question.save
+    question.reload
+    assert_equal "Which planet is the largest?", question.text
+    assert_equal [ "Jupiter", "Mars" ], question.options.map(&:text)
+  end
+
+  test "a successful edit replaces the options" do
+    question = build_question(@quiz, options: [ [ "Jupiter", true ], [ "Mars", false ] ])
+    question.option_rows = [ row("Venus", false), row("Earth", true), row("") ]
+
+    assert question.save
+    assert_equal [ "Venus", "Earth" ], question.reload.options.map(&:text)
+    assert_equal 2, Option.where(question: question).count
+  end
+
+  test "toggling active does not touch the options" do
+    question = build_question(@quiz, options: [ [ "Jupiter", true ], [ "Mars", false ] ])
+
+    assert question.update(active: false)
+    assert_equal false, question.reload.active
+    assert_equal [ "Jupiter", "Mars" ], question.options.map(&:text)
+  end
+
+  test "new questions go to the end of the quiz" do
+    first = build_question(@quiz)
+    second = build_question(@quiz, text: "Second?")
+
+    assert_equal 1, first.position
+    assert_equal 2, second.position
+  end
+
+  test "options are kept in the order they were typed" do
+    question = build_question(@quiz, options: [ [ "C", false ], [ "A", true ], [ "B", false ] ])
+
+    assert_equal %w[C A B], question.reload.options.map(&:text)
+  end
+
+  test "a blank question is reported with the form label" do
+    question = Question.new(quiz: @quiz, text: " ")
+    question.option_rows = [ row("Yes", true), row("No") ]
+
+    assert_not question.valid?
+    assert_equal [ "Question can't be blank" ], question.errors.full_messages
+  end
+end
diff --git a/test/models/quiz_export_test.rb b/test/models/quiz_export_test.rb
new file mode 100644
index 0000000..2c54e66
--- /dev/null
+++ b/test/models/quiz_export_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class QuizExportTest < ActiveSupport::TestCase
+  test "writes exactly the title and the questions, in order" do
+    quiz = build_quiz(title: "Frontend Fest 2026")
+    build_question(quiz, text: "First?", options: [ [ "418", false ], [ "429", true ] ])
+    build_question(quiz, text: "Second?", options: [ [ "Yes", true ], [ "No", false ] ], active: false)
+
+    assert_equal(
+      {
+        "title" => "Frontend Fest 2026",
+        "questions" => [
+          {
+            "text" => "First?",
+            "active" => true,
+            "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ]
+          },
+          {
+            "text" => "Second?",
+            "active" => false,
+            "options" => [ { "text" => "Yes", "correct" => true }, { "text" => "No", "correct" => false } ]
+          }
+        ]
+      },
+      QuizExport.new(quiz.reload).to_h
+    )
+  end
+
+  test "the questions and options keep their moved order" do
+    quiz = build_quiz
+    first = build_question(quiz, text: "First", options: [ [ "a", true ], [ "b", false ] ])
+    build_question(quiz, text: "Second", options: [ [ "c", false ], [ "d", true ] ])
+    quiz.move_question(first, "down")
+
+    exported = QuizExport.new(quiz.reload).to_h
+    assert_equal [ "Second", "First" ], exported["questions"].map { |question| question["text"] }
+  end
+
+  test "an empty quiz exports an empty list" do
+    quiz = build_quiz(title: "Nothing yet")
+
+    assert_equal({ "title" => "Nothing yet", "questions" => [] }, QuizExport.new(quiz).to_h)
+  end
+
+  test "the pretty JSON parses back to the same hash" do
+    quiz = build_quiz
+    build_question(quiz, text: "Quotes \"and\" <tags> & more", options: [ [ "A", true ], [ "B", false ] ])
+
+    exporter = QuizExport.new(quiz)
+    assert_equal exporter.to_h, JSON.parse(exporter.to_pretty_json)
+    assert_includes exporter.to_pretty_json, "\n  \"title\""
+  end
+end
diff --git a/test/models/quiz_import_test.rb b/test/models/quiz_import_test.rb
new file mode 100644
index 0000000..15d3fff
--- /dev/null
+++ b/test/models/quiz_import_test.rb
@@ -0,0 +1,302 @@
+require "test_helper"
+
+class QuizImportTest < ActiveSupport::TestCase
+  def json(data)
+    data.is_a?(String) ? data : JSON.generate(data)
+  end
+
+  def valid_quiz_data(**overrides)
+    {
+      "title" => "Frontend Fest 2026",
+      "questions" => [
+        {
+          "text" => "Which HTTP status code means \"Too Many Requests\"?",
+          "active" => true,
+          "options" => [
+            { "text" => "418", "correct" => false },
+            { "text" => "429", "correct" => true }
+          ]
+        }
+      ]
+    }.merge(overrides.transform_keys(&:to_s))
+  end
+
+  def import(data)
+    importer = QuizImport.new(json(data))
+    [ importer.save, importer ]
+  end
+
+  def assert_nothing_imported
+    assert_equal 0, Quiz.count, "no quiz should exist"
+    assert_equal 0, Question.count, "no question should exist"
+    assert_equal 0, Option.count, "no option should exist"
+  end
+
+  test "creates the quiz, its questions and options in order" do
+    saved, importer = import(valid_quiz_data)
+
+    assert saved, importer.errors.inspect
+    quiz = importer.quiz
+    assert quiz.persisted?
+    assert_equal "Frontend Fest 2026", quiz.reload.title
+    question = quiz.questions.first
+    assert_equal "Which HTTP status code means \"Too Many Requests\"?", question.text
+    assert_equal [ "418", "429" ], question.options.map(&:text)
+    assert_equal [ false, true ], question.options.map(&:correct)
+    assert question.active
+  end
+
+  test "active defaults to true and correct to false" do
+    data = {
+      "title" => "Defaults",
+      "questions" => [
+        { "text" => "Q?", "options" => [ { "text" => "A" }, { "text" => "B", "correct" => true } ] }
+      ]
+    }
+    saved, importer = import(data)
+
+    assert saved, importer.errors.inspect
+    question = importer.quiz.questions.first
+    assert question.active
+    assert_equal [ false, true ], question.options.map(&:correct)
+  end
+
+  test "active false is kept" do
+    data = valid_quiz_data
+    data["questions"][0]["active"] = false
+    saved, importer = import(data)
+
+    assert saved, importer.errors.inspect
+    assert_equal false, importer.quiz.questions.first.active
+  end
+
+  test "importing a title that already exists still creates a new quiz" do
+    build_quiz(title: "Frontend Fest 2026")
+    saved, importer = import(valid_quiz_data)
+
+    assert saved, importer.errors.inspect
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+    assert_not_equal Quiz.first.id, importer.quiz.id
+  end
+
+  test "a quiz without questions can be imported" do
+    saved, importer = import("title" => "Empty", "questions" => [])
+
+    assert saved, importer.errors.inspect
+    assert_equal 0, importer.quiz.questions.count
+  end
+
+  test "unknown keys are ignored" do
+    data = valid_quiz_data("id" => 99, "note" => "hi")
+    data["questions"][0]["position"] = 7
+    saved, importer = import(data)
+
+    assert saved, importer.errors.inspect
+    assert_equal 1, importer.quiz.questions.count
+  end
+
+  test "blank option rows are skipped, and a correct box on one does not count" do
+    data = valid_quiz_data
+    data["questions"][0]["options"] = [
+      { "text" => "  ", "correct" => true },
+      { "text" => " 429 ", "correct" => true },
+      { "text" => "", "correct" => false },
+      { "text" => "418" }
+    ]
+    saved, importer = import(data)
+
+    assert saved, importer.errors.inspect
+    assert_equal [ "429", "418" ], importer.quiz.questions.first.options.map(&:text)
+    assert_equal [ true, false ], importer.quiz.questions.first.options.map(&:correct)
+  end
+
+  test "null for active or correct counts as left out" do
+    data = valid_quiz_data
+    data["questions"][0]["active"] = nil
+    data["questions"][0]["options"][0]["correct"] = nil
+    saved, importer = import(data)
+
+    assert saved, importer.errors.inspect
+    assert importer.quiz.questions.first.active
+    assert_equal [ false, true ], importer.quiz.questions.first.options.map(&:correct)
+  end
+
+  test "a byte-order mark before the JSON is ignored" do
+    saved, importer = import("\uFEFF" + json(valid_quiz_data))
+
+    assert saved, importer.errors.inspect
+  end
+
+  test "questions keep their order" do
+    data = valid_quiz_data
+    data["questions"] = %w[Third First Second].map do |text|
+      { "text" => text, "options" => [ { "text" => "a", "correct" => true }, { "text" => "b" } ] }
+    end
+    saved, importer = import(data)
+
+    assert saved, importer.errors.inspect
+    assert_equal %w[Third First Second], importer.quiz.questions.map(&:text)
+    assert_equal [ 1, 2, 3 ], importer.quiz.questions.map(&:position)
+  end
+
+  test "invalid JSON imports nothing" do
+    saved, importer = import("{\"title\": \"Broken\", ")
+
+    assert_not saved
+    assert_match(/not valid JSON/, importer.errors.first)
+    assert_nothing_imported
+  end
+
+  test "blank input says what is missing" do
+    saved, importer = import("   ")
+
+    assert_not saved
+    assert_equal [ "Paste the quiz JSON to import." ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "the top level must be an object" do
+    saved, importer = import("[1, 2]")
+
+    assert_not saved
+    assert_match(/must be an object/, importer.errors.first)
+    assert_nothing_imported
+  end
+
+  test "questions must be a list" do
+    saved, importer = import("title" => "No list")
+
+    assert_not saved
+    assert_equal [ "Questions must be a list." ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "a question must be an object with an options list" do
+    saved, importer = import(valid_quiz_data.merge("questions" => [ "just text" ]))
+    assert_not saved
+    assert_equal [ "Question 1 must be an object." ], importer.errors
+
+    data = valid_quiz_data
+    data["questions"][0].delete("options")
+    saved, importer = import(data)
+    assert_not saved
+    assert_equal [ "Question 1: options must be a list." ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "an option must be an object" do
+    data = valid_quiz_data
+    data["questions"][0]["options"] = [ "418", { "text" => "429", "correct" => true } ]
+    saved, importer = import(data)
+
+    assert_not saved
+    assert_equal [ "Question 1, option 1 must be an object." ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "types are checked strictly" do
+    data = valid_quiz_data(title: 42)
+    saved, importer = import(data)
+    assert_not saved
+    assert_equal [ "Title must be a string." ], importer.errors
+
+    data = valid_quiz_data
+    data["questions"][0]["text"] = 7
+    saved, importer = import(data)
+    assert_not saved
+    assert_equal [ "Question 1: text must be a string." ], importer.errors
+
+    data = valid_quiz_data
+    data["questions"][0]["active"] = "yes"
+    saved, importer = import(data)
+    assert_not saved
+    assert_equal [ "Question 1: active must be true or false." ], importer.errors
+
+    data = valid_quiz_data
+    data["questions"][0]["options"][1]["correct"] = "true"
+    saved, importer = import(data)
+    assert_not saved
+    assert_equal [ "Question 1, option 2: correct must be true or false." ], importer.errors
+
+    data = valid_quiz_data
+    data["questions"][0]["options"][1]["text"] = 429
+    saved, importer = import(data)
+    assert_not saved
+    assert_equal [ "Question 1, option 2: text must be a string." ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "a missing title is the same rule as the quiz form" do
+    saved, importer = import(valid_quiz_data(title: "  "))
+
+    assert_not saved
+    assert_equal [ "Title can't be blank" ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "question rules are the question form's rules, and one bad question imports nothing" do
+    data = valid_quiz_data
+    data["questions"] << {
+      "text" => "Only one option?",
+      "options" => [ { "text" => "Alone", "correct" => true } ]
+    }
+    saved, importer = import(data)
+
+    assert_not saved
+    assert_equal [ "Question 2: Add at least two options" ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "a question needs a correct option" do
+    data = valid_quiz_data
+    data["questions"][0]["options"].each { |option| option["correct"] = false }
+    saved, importer = import(data)
+
+    assert_not saved
+    assert_equal [ "Question 1: Mark at least one option as correct" ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "a question needs text" do
+    data = valid_quiz_data
+    data["questions"][0]["text"] = "   "
+    saved, importer = import(data)
+
+    assert_not saved
+    assert_equal [ "Question 1: Question can't be blank" ], importer.errors
+    assert_nothing_imported
+  end
+
+  test "every broken question is reported, and nothing is imported" do
+    data = valid_quiz_data(title: "")
+    data["questions"] << { "text" => "", "options" => [] }
+    saved, importer = import(data)
+
+    assert_not saved
+    assert_includes importer.errors, "Title can't be blank"
+    assert_includes importer.errors, "Question 2: Add at least two options"
+    assert_includes importer.errors, "Question 2: Mark at least one option as correct"
+    assert_nothing_imported
+  end
+
+  test "several correct options are fine" do
+    data = valid_quiz_data
+    data["questions"][0]["options"] = [ { "text" => "2", "correct" => true }, { "text" => "3", "correct" => true } ]
+    saved, _importer = import(data)
+
+    assert saved
+  end
+
+  test "an export imports back to the same contents" do
+    quiz = build_quiz(title: "Round trip")
+    build_question(quiz, text: "One", options: [ [ "a", true ], [ "b", false ] ])
+    build_question(quiz, text: "Two", options: [ [ "c", false ], [ "d", true ], [ "e", true ] ], active: false)
+    exported = QuizExport.new(quiz).to_pretty_json
+
+    saved, importer = import(exported)
+
+    assert saved, importer.errors.inspect
+    assert_equal QuizExport.new(quiz.reload).to_h, QuizExport.new(importer.quiz.reload).to_h
+    assert_equal 2, Quiz.count
+  end
+end
diff --git a/test/models/quiz_preview_test.rb b/test/models/quiz_preview_test.rb
new file mode 100644
index 0000000..b599e3b
--- /dev/null
+++ b/test/models/quiz_preview_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class QuizPreviewTest < ActiveSupport::TestCase
+  setup do
+    @quiz = build_quiz
+    @first = build_question(@quiz, text: "One", options: [ [ "Right", true ], [ "Wrong", false ] ])
+    @off = build_question(@quiz, text: "Off", active: false)
+    @second = build_question(@quiz, text: "Two", options: [ [ "Nope", false ], [ "Yes", true ], [ "No", false ] ])
+    @right_one = @first.options.find_by!(correct: true)
+    @wrong_one = @first.options.find_by!(correct: false)
+    @right_two = @second.options.find_by!(correct: true)
+    @wrong_two = @second.options.find_by!(correct: false)
+  end
+
+  test "only active questions are played" do
+    preview = QuizPreview.new(@quiz)
+
+    assert_equal [ "One", "Two" ], preview.questions.map(&:text)
+    assert_equal 1, preview.position
+    assert_equal @first, preview.current_question
+    assert_not preview.finished?
+  end
+
+  test "picking a correct option reveals it and scores a point" do
+    preview = QuizPreview.new(@quiz, answers: "", pick: @right_one.id.to_s)
+
+    assert_equal @right_one, preview.picked_option
+    assert_equal "#{@right_one.id}", preview.answers_param_after_pick
+  end
+
+  test "score counts correct answers across the quiz" do
+    preview = QuizPreview.new(@quiz, answers: "#{@right_one.id},#{@wrong_two.id}")
+
+    assert preview.valid?
+    assert preview.finished?
+    assert_equal 1, preview.score
+    assert_equal 2, preview.total
+  end
+
+  test "answers for other questions are not valid" do
+    preview = QuizPreview.new(@quiz, answers: "#{@right_two.id}")
+
+    assert_not preview.valid?
+  end
+
+  test "unreadable answers are not valid" do
+    assert_not QuizPreview.new(@quiz, answers: "abc").valid?
+    assert_not QuizPreview.new(@quiz, answers: "1,x").valid?
+  end
+
+  test "picks that do not belong to the current question are ignored" do
+    preview = QuizPreview.new(@quiz, answers: "", pick: @right_two.id.to_s)
+
+    assert_nil preview.picked_option
+  end
+
+  test "a preview never writes to the database" do
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      preview = QuizPreview.new(@quiz, answers: "#{@right_one.id}", pick: @right_two.id.to_s)
+      preview.score
+    end
+  end
+end
diff --git a/test/models/quiz_test.rb b/test/models/quiz_test.rb
new file mode 100644
index 0000000..0d3787d
--- /dev/null
+++ b/test/models/quiz_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class QuizTest < ActiveSupport::TestCase
+  test "title is required" do
+    quiz = Quiz.new(title: "  ")
+
+    assert_not quiz.valid?
+    assert_includes quiz.errors.full_messages, "Title can't be blank"
+  end
+
+  test "questions come back in order" do
+    quiz = build_quiz
+    first = build_question(quiz, text: "First")
+    second = build_question(quiz, text: "Second")
+    third = build_question(quiz, text: "Third")
+    quiz.move_question(third, "up")
+    quiz.move_question(first, "down")
+
+    assert_equal [ "Third", "First", "Second" ], quiz.questions.reload.map(&:text)
+    assert_equal [ 1, 2, 3 ], quiz.questions.map(&:position)
+    assert_equal [ third.id, first.id, second.id ], quiz.questions.map(&:id)
+  end
+
+  test "moving past the ends does nothing" do
+    quiz = build_quiz
+    first = build_question(quiz, text: "First")
+    second = build_question(quiz, text: "Second")
+
+    assert_not quiz.move_question(first, "up")
+    assert_not quiz.move_question(second, "down")
+    assert_equal [ "First", "Second" ], quiz.questions.reload.map(&:text)
+  end
+
+  test "inactive questions take part in the ordering" do
+    quiz = build_quiz
+    first = build_question(quiz, text: "First", active: false)
+    second = build_question(quiz, text: "Second")
+
+    assert quiz.move_question(second, "up")
+    assert_equal [ "Second", "First" ], quiz.questions.reload.map(&:text)
+    assert_equal [ first.id, second.id ].reverse, quiz.questions.map(&:id)
+  end
+
+  test "active_questions skips inactive questions" do
+    quiz = build_quiz
+    build_question(quiz, text: "On")
+    build_question(quiz, text: "Off", active: false)
+
+    assert_equal [ "On" ], quiz.active_questions.map(&:text)
+  end
+
+  test "deleting a quiz deletes its questions and options" do
+    quiz = build_quiz
+    build_question(quiz)
+
+    assert_difference "Quiz.count", -1 do
+      assert_difference "Question.count", -1 do
+        assert_difference "Option.count", -2 do
+          quiz.destroy
+        end
+      end
+    end
+  end
+
+  test "the number of winners is 3 by default" do
+    assert_equal 3, Quiz.new(title: "Quiz").winner_count
+    assert_equal 3, build_quiz.reload.winner_count
+  end
+
+  test "the number of winners is a whole number of at least 1" do
+    quiz = build_quiz
+
+    quiz.winner_count = 1
+    assert quiz.valid?
+
+    quiz.winner_count = "7"
+    assert quiz.valid?
+    assert_equal 7, quiz.winner_count
+  end
+
+  test "zero and negative numbers of winners are refused" do
+    quiz = build_quiz
+
+    [ "0", "-2" ].each do |typed|
+      quiz.winner_count = typed
+      refute quiz.valid?, "#{typed.inspect} should be refused"
+      assert_includes quiz.errors.full_messages, "Number of winners must be at least 1"
+    end
+  end
+
+  test "fractions, blanks and words are refused as not a whole number" do
+    quiz = build_quiz
+
+    [ "2.5", "", "three", " " ].each do |typed|
+      quiz.winner_count = typed
+      refute quiz.valid?, "#{typed.inspect} should be refused"
+      assert_includes quiz.errors.full_messages, "Number of winners must be a whole number"
+    end
+  end
+
+  test "a number too large for the stored integer is refused" do
+    quiz = build_quiz
+    quiz.winner_count = "99999999999999"
+
+    refute quiz.valid?
+    assert_includes quiz.errors.full_messages, "Number of winners must be at most 2147483647"
+  end
+end
