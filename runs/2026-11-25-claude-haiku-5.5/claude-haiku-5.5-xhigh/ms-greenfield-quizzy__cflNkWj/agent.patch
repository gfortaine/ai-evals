+module Moderate
+  # Creates a quiz from pasted JSON (see QuizImport). Each import is a new quiz.
+  class ImportsController < BaseController
+    def new
+      @import = QuizImport.new("")
+    end
+
+    def create
+      @import = QuizImport.new(quiz_json_param)
+
+      if @import.save
+        redirect_to moderate_quiz_path(@import.quiz), notice: "Quiz imported.", status: :see_other
+      else
+        render :new, status: :unprocessable_entity
+      end
+    end
+
+    private
+
+    def quiz_json_param
