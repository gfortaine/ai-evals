@@ -0,0 +1,37 @@
+require "test_helper"
+
+class ActivationTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = build_quiz
+    @question = build_question(@quiz, text: "Toggle me", options: [ [ "A", true ], [ "B", false ] ])
+    @path = "/moderate/quizzes/#{@quiz.id}/questions/#{@question.id}/activation"
+  end
+
+  def auth
+    { "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "letmein") }
+  end
+
+  test "switching a question off keeps its text and options" do
+    patch @path, params: { question: { active: "0" } }, headers: auth
+
+    assert_redirected_to "/moderate/quizzes/#{@quiz.id}"
+    @question.reload
+    assert_equal false, @question.active
+    assert_equal "Toggle me", @question.text
+    assert_equal %w[A B], @question.options.map(&:text)
+  end
+
+  test "switching a question back on" do
+    @question.update!(active: false)
+    patch @path, params: { question: { active: "1" } }, headers: auth
+
+    assert @question.reload.active
+  end
+
+  test "the activation endpoint also needs credentials" do
+    patch @path, params: { question: { active: "0" } }
+
+    assert_response :unauthorized
+    assert @question.reload.active
+  end
+end
diff --git a/test/integration/moderator_access_test.rb b/test/integration/moderator_access_test.rb
new file mode 100644
index 0000000..d5f760d
--- /dev/null
+++ b/test/integration/moderator_access_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+require "support/moderator_helpers"
+
+class ModeratorAccessTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = build_quiz
+    @question = build_question(@quiz)
+  end
+
+  def moderator_paths
+    [
+      "/moderate",
+      "/moderate/quizzes/new",
+      "/moderate/quizzes/#{@quiz.id}",
+      "/moderate/quizzes/#{@quiz.id}/edit",
+      "/moderate/quizzes/#{@quiz.id}/preview",
+      "/moderate/quizzes/#{@quiz.id}/questions/new",
+      "/moderate/quizzes/#{@quiz.id}/questions/#{@question.id}/edit"
+    ]
+  end
+
+  test "health check needs no credentials" do
+    get "/up"
+
+    assert_response :success
+  end
+
+  test "every moderator page answers 401 without credentials" do
+    moderator_paths.each do |path|
+      get path
+
+      assert_response :unauthorized, "expected 401 for #{path}"
+      assert_match %r{\ABasic}, response.headers["WWW-Authenticate"].to_s
+    end
+  end
+
+  test "wrong credentials get 401" do
+    moderator_paths.each do |path|
+      get path, headers: basic_auth("moderator", "wrong")
+
+      assert_response :unauthorized, "expected 401 for #{path}"
+    end
+  end
+
+  test "a wrong username with the right password gets 401" do
+    get "/moderate", headers: basic_auth("someone", "letmein")
+
+    assert_response :unauthorized
+  end
+
+  test "right credentials open the moderator pages" do
+    moderator_paths.each do |path|
+      get path, headers: basic_auth("moderator", "letmein")
+
+      assert_response :success, "expected 200 for #{path}"
+    end
+  end
+
+  test "write actions also need credentials" do
+    post "/moderate/quizzes", params: { quiz: { title: "Sneaky" } }
+
+    assert_response :unauthorized
+    assert_equal 1, Quiz.count
+  end
+
+  test "unset environment credentials never match" do
+    original_user = ENV["QUIZZY_MODERATOR_USERNAME"]
+    original_password = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    ENV["QUIZZY_MODERATOR_USERNAME"] = ""
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = ""
+
+    get "/moderate", headers: basic_auth("", "")
+
+    assert_response :unauthorized
+  ensure
+    ENV["QUIZZY_MODERATOR_USERNAME"] = original_user
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = original_password
+  end
+
+  private
+
+  def basic_auth(username, password)
+    { "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials(username, password) }
+  end
+end
+
+class UnknownModeratorUrlTest < ActionDispatch::IntegrationTest
+  setup { build_quiz }
+
+  test "unknown moderator URLs need credentials too" do
+    get "/moderate/nothing/here"
+
+    assert_response :unauthorized
+  end
+
+  test "unknown moderator URLs are 404 with credentials" do
+    get "/moderate/nothing/here", headers: { "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "letmein") }
+
+    assert_response :not_found
+  end
+end
