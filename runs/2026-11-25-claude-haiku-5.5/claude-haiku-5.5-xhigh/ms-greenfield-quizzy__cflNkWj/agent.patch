diff --git a/app/views/moderate/questions/_form.html.erb b/app/views/moderate/questions/_form.html.erb
new file mode 100644
index 0000000..9ca31ab
--- /dev/null
+++ b/app/views/moderate/questions/_form.html.erb
@@ -0,0 +1,62 @@
+<% url = question.persisted? ? moderate_quiz_question_path(quiz, question) : moderate_quiz_questions_path(quiz) %>
+<% method = question.persisted? ? :patch : :post %>
+
+<%= form_with url: url, method: method, scope: :question, id: "question-form", data: { turbo: false } do |f| %>
+  <%# Enter in a text field submits through the first submit button. Keep it on "Save question", not "Add option". %>
+  <button type="submit" hidden tabindex="-1" aria-hidden="true"></button>
+
+  <div class="card">
+    <% if question.errors.any? %>
+      <div class="errors" role="alert">
+        <ul>
+          <% question.errors.full_messages.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <div class="field">
+      <%= f.label :text, "Question", class: "field-label" %>
+      <%= f.text_area :text, value: question.text, rows: 3, class: "input", required: true, autofocus: true %>
+    </div>
+
+    <fieldset class="field options-field">
+      <legend class="field-label">Options</legend>
+      <span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span>
+
+      <div class="option-rows">
+        <% form_option_rows(question).each_with_index do |row, index| %>
+          <div class="option-row">
+            <label class="visually-hidden" for="question_options_<%= index %>_text">Option <%= index + 1 %></label>
+            <%= text_field_tag "question[options][#{index}][text]", row.text,
+                  id: "question_options_#{index}_text", class: "input", placeholder: "Option text" %>
+            <label class="checkbox" for="question_options_<%= index %>_correct">
+              <%= check_box_tag "question[options][#{index}][correct]", "1", row.correct,
+                    id: "question_options_#{index}_correct" %>
+              <span class="visually-hidden">Option <%= index + 1 %> is</span> correct
+            </label>
+          </div>
+        <% end %>
+      </div>
+
+      <div class="buttons add-option">
+        <button type="submit" name="add_option" value="1" formnovalidate class="btn btn--ghost btn--sm">Add option</button>
+      </div>
+    </fieldset>
+
+    <div class="field">
+      <%= hidden_field_tag "question[active]", "0", id: nil %>
+      <label class="checkbox">
+        <%= check_box_tag "question[active]", "1", question.active?, id: "question_active" %>
+        Active
+      </label>
+      <span class="field-hint">Only active questions are played.</span>
+    </div>
+
+    <div class="buttons">
+      <button type="submit" class="btn btn--pink">Save question</button>
+      <%= link_to "Cancel", moderate_quiz_path(quiz), class: "btn btn--ghost" %>
+    </div>
+  </div>
+<% end %>
