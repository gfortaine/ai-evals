@@ -0,0 +1,39 @@
+ENV["RAILS_ENV"] ||= "test"
+require_relative "../config/environment"
+require "rails/test_help"
+require "turbo/broadcastable/test_helper"
+
+# Moderator credentials used by the moderator area in tests.
+ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+ENV["QUIZZY_MODERATOR_PASSWORD"] = "letmein"
+
+module ActiveSupport
+  class TestCase
+    # Each test gets its own transaction; the suite is small, so keep it serial.
+    fixtures []
+    include Turbo::Broadcastable::TestHelper
+
+    def build_quiz(title: "Frontend Fest 2026")
+      Quiz.create!(title: title)
+    end
+
+    # Builds a question from simple option specs, e.g. [["Jupiter", true], ["Mars", false]].
+    def build_question(quiz, text: "Which planet is the largest?", options: [ [ "Jupiter", true ], [ "Mars", false ] ], active: true)
+      rows = options.map { |option_text, correct| Question::OptionRow.new(text: option_text, correct: correct) }
+      question = Question.new(quiz: quiz, text: text, active: active)
+      question.option_rows = rows
+      question.save!
+      question
+    end
+  end
+end
+
+class ActionDispatch::IntegrationTest
+  # Capybara-driven integration tests use the fast rack-test driver, even after a
+  # browser (Cuprite) system test has switched the current driver.
+  setup { Capybara.current_driver = :rack_test }
+  teardown do
+    Capybara.reset_sessions!
+    Capybara.use_default_driver
+  end
+end
