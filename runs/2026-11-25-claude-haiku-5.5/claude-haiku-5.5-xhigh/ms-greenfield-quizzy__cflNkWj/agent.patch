+++ b/test/integration/play_test.rb
@@ -0,0 +1,321 @@
+require "test_helper"
+
+class PlayTest < ActionDispatch::IntegrationTest
+  TURBO_STREAM = { "Accept" => "text/vnd.turbo-stream.html" }.freeze
+
+  setup do
+    @quiz = build_quiz(title: "Frontend Fest 2026")
+    build_question(@quiz, text: "Largest planet?", options: [ [ "Jupiter", true ], [ "Mars", false ] ])
+    build_question(@quiz, text: "Which protocol?", options: [ [ "WebSocket", true ], [ "FTP", false ] ])
+    @game = @quiz.games.create!
+  end
+
+  def moderator
+    { "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "letmein") }
+  end
+
+  def page
+    Capybara.string(response.body)
+  end
+
+  def play_path = "/play/#{@game.code}"
+
+  def join_as(name, session = self)
+    session.post "#{play_path}/join", params: { name: name }
+  end
+
+  def moderate(action)
+    post "/moderate/games/#{@game.id}/#{action}", headers: moderator
+  end
+
+  def option(text)
+    @game.reload.current_game_question.options.find_by!(text: text)
+  end
+
+  test "the join link shows a name form to someone who has not joined" do
+    get play_path
+
+    assert_response :success
+    assert page.has_field?("Your name")
+    assert page.has_button?("Join")
+    assert page.has_text?("Frontend Fest 2026")
+  end
+
+  test "the join link is not case sensitive" do
+    get "/play/#{@game.code.downcase}"
+
+    assert_response :success
+    assert page.has_field?("Your name")
+  end
+
+  test "an unknown code says there is no quiz here" do
+    get "/play/ZZZZZ"
+
+    assert_response :not_found
+    assert page.has_text?("No quiz here")
+  end
+
+  test "joining with a name shows Hi, name and the wait for the start" do
+    join_as("Alice")
+
+    assert_redirected_to play_path
+    follow_redirect!
+    assert page.has_text?("Hi, Alice!")
+    assert page.has_text?("Waiting for the quiz to start")
+    refute page.has_field?("Your name")
+  end
+
+  test "a blank name is refused with a message and nobody joins" do
+    assert_no_difference -> { Player.count } do
+      join_as("   ")
+    end
+
+    assert_response :unprocessable_entity
+    assert page.has_text?("Enter your name")
+    assert page.has_field?("Your name")
+  end
+
+  test "a name that is too long is refused" do
+    assert_no_difference -> { Player.count } do
+      join_as("x" * 41)
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "HTML in a name is shown as text" do
+    join_as("<b>Eve</b>")
+    follow_redirect!
+
+    assert page.has_text?("Hi, <b>Eve</b>!")
+    refute page.has_css?("b")
+  end
+
+  test "the browser keeps its player, so the same link continues the same player" do
+    join_as("Alice")
+
+    get play_path
+    assert page.has_text?("Hi, Alice!")
+
+    assert_no_difference -> { Player.count } do
+      join_as("Someone else")
+    end
+    assert_redirected_to play_path
+    assert_equal [ "Alice" ], @game.players.reload.map(&:name)
+  end
+
+  test "another browser is another player" do
+    join_as("Alice")
+    other = open_session
+    other.get play_path
+    assert_includes other.response.body, "Your name"
+
+    join_as("Bob", other)
+    assert_equal 2, @game.players.count
+  end
+
+  test "players can join in the lobby, during a question, and after it closes" do
+    join_as("Lobby", open_session)
+    moderate("start")
+    join_as("During", open_session)
+    moderate("finish")
+    join_as("Afterwards", open_session)
+
+    assert_equal %w[Lobby During Afterwards], @game.players.reload.map(&:name)
+  end
+
+  test "the join link says the quiz is over and nobody can join after the end" do
+    moderate("start")
+    moderate("finish")
+    moderate("next_question")
+    moderate("finish")
+    moderate("end_quiz")
+
+    get play_path
+    assert page.has_text?("The quiz is over")
+    refute page.has_field?("Your name")
+
+    assert_no_difference -> { Player.count } do
+      join_as("Late")
+    end
+  end
+
+  test "a phone that already joined sees the end" do
+    join_as("Alice")
+    moderate("start")
+    moderate("finish")
+    moderate("next_question")
+    moderate("finish")
+    moderate("end_quiz")
+
+    get play_path
+    assert page.has_text?("The quiz is over")
+  end
+
+  test "an open question shows its text and options as buttons, with no hint of the answer" do
+    join_as("Alice")
+    moderate("start")
+
+    get play_path
+    assert page.has_text?("Largest planet?")
+    assert page.has_button?("Jupiter")
+    assert page.has_button?("Mars")
+    refute_includes response.body.downcase, "correct"
+    refute_includes response.body, "Your answer"
+  end
+
+  test "tapping an option answers at once and marks it as your answer" do
+    join_as("Alice")
+    moderate("start")
+    jupiter = option("Jupiter")
+
+    post "/play/#{@game.code}/answer", params: { option_id: jupiter.id }, headers: TURBO_STREAM
+
+    assert_response :success
+    assert_includes response.body, %(action="replace" target="player-screen")
+    assert_includes response.body, "Your answer"
+    assert_equal jupiter, @game.players.find_by(name: "Alice").answer_for(@game.current_game_question).game_option
+  end
+
+  test "the last tap before the close is the answer that counts" do
+    join_as("Alice")
+    moderate("start")
+
+    post "/play/#{@game.code}/answer", params: { option_id: option("Jupiter").id }
+    post "/play/#{@game.code}/answer", params: { option_id: option("Mars").id }
+
+    assert_equal 1, Answer.count
+    assert_equal option("Mars"), Answer.first.game_option
+  end
+
+  test "after Finish each player sees Correct!, Wrong! or No answer for their own pick" do
+    right, wrong, silent = open_session, open_session, open_session
+    join_as("Right", right)
+    join_as("Wrong", wrong)
+    join_as("Silent", silent)
+    moderate("start")
+    players = @game.players.reload.order(:id).to_a
+    players[0].pick(option("Jupiter"))
+    players[1].pick(option("Mars"))
+    moderate("finish")
+
+    { right => "Correct!", wrong => "Wrong!", silent => "No answer" }.each do |browser, status|
+      browser.get play_path
+      assert_includes browser.response.body, status
+      ([ "Correct!", "Wrong!", "No answer" ] - [ status ]).each do |other|
+        refute_includes browser.response.body, other
+      end
+    end
+  end
+
+  test "the correct answer is revealed only once the question is closed" do
+    join_as("Alice")
+    moderate("start")
+    get play_path
+    refute_includes response.body.downcase, "correct"
+
+    moderate("finish")
+    get play_path
+    assert page.has_css?(".play-option.is-correct", text: "Jupiter")
+  end
+
+  test "a player who never answered sees No answer after the close" do
+    join_as("Silent")
+    moderate("start")
+    moderate("finish")
+
+    get play_path
+    assert page.has_text?("No answer")
+  end
+
+  test "a player who joined after the close sees the closed question and its result" do
+    moderate("start")
+    moderate("finish")
+    join_as("Late")
+
+    get play_path
+    assert page.has_text?("No answer")
+    assert page.has_text?("Largest planet?")
+  end
+
+  test "a pick after the close is refused and says so" do
+    join_as("Alice")
+    moderate("start")
+    jupiter = option("Jupiter")
+    moderate("finish")
+
+    post "/play/#{@game.code}/answer", params: { option_id: jupiter.id }, headers: TURBO_STREAM
+
+    assert_response :success
+    assert_includes response.body, "This question is closed."
+    assert_equal 0, Answer.count
+  end
+
+  test "an option from another game is refused" do
+    join_as("Alice")
+    moderate("start")
+    other_quiz = build_quiz(title: "Elsewhere")
+    build_question(other_quiz, text: "Foreign?", options: [ [ "Yes", true ], [ "No", false ] ])
+    foreign = other_quiz.games.create!
+    foreign.start
+    foreign_option = foreign.current_game_question.options.first
+
+    post "/play/#{@game.code}/answer", params: { option_id: foreign_option.id }, headers: TURBO_STREAM
+
+    assert_includes response.body, "That answer is not part of this question."
+    assert_equal 0, Answer.count
+  end
+
+  test "a phone that has not joined cannot answer" do
+    moderate("start")
+
+    post "/play/#{@game.code}/answer", params: { option_id: option("Jupiter").id }, headers: TURBO_STREAM
+
+    assert_includes response.body, "Join the quiz first."
+    assert_equal 0, Answer.count
+  end
+
+  test "a phone's state fragment answers 304 until its version changes" do
+    join_as("Alice")
+    get "/play/#{@game.code}/state"
+    assert_response :success
+    etag = response.headers["ETag"]
+
+    get "/play/#{@game.code}/state", headers: { "If-None-Match" => etag }
+    assert_response :not_modified
+
+    moderate("start")
+    get "/play/#{@game.code}/state", headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_includes response.body, "Largest planet?"
+  end
+
+  test "a phone's state fragment is personal: it never shows another player's answer" do
+    join_as("Alice")
+    moderate("start")
+    @game.players.find_by(name: "Alice").pick(option("Mars"))
+
+    bob = open_session
+    join_as("Bob", bob)
+    bob.get "/play/#{@game.code}/state"
+
+    assert_includes bob.response.body, "Tap an answer"
+    refute_includes bob.response.body, "Your answer"
+  end
+
+  test "the phone page subscribes to the game's phone stream and points at its own state" do
+    join_as("Alice")
+
+    get play_path
+    assert page.has_css?("turbo-cable-stream-source")
+    assert_includes response.body, "data-live-url-value=\"/play/#{@game.code}/state\""
+  end
+
+  test "a state change sends the refresh signal to the phones once" do
+    join_as("Alice")
+
+    assert_turbo_stream_broadcasts [ @game, :players ], count: 1 do
+      moderate("start")
+    end
+  end
+end
diff --git a/test/integration/preview_test.rb b/test/integration/preview_test.rb
new file mode 100644
index 0000000..644911d
--- /dev/null
+++ b/test/integration/preview_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+require "support/moderator_helpers"
+
+class PreviewTest < ActionDispatch::IntegrationTest
+  include ModeratorHelpers
+
+  setup do
+    sign_in_as_moderator
+    @quiz = build_quiz(title: "Frontend Fest 2026")
+    build_question(@quiz, text: "Which HTTP status means Too Many Requests?",
+                   options: [ [ "418", false ], [ "429", true ], [ "503", false ] ])
+    build_question(@quiz, text: "Hidden question", options: [ [ "X", true ], [ "Y", false ] ], active: false)
+    build_question(@quiz, text: "Which protocol keeps a two-way connection?",
+                   options: [ [ "WebSocket", true ], [ "SMTP", false ] ])
+  end
+
+  def option(question_text, option_text)
+    Question.find_by!(text: question_text).options.find_by!(text: option_text)
+  end
+
+  test "the preview starts at question 1 of the active questions" do
+    visit "/moderate/quizzes/#{@quiz.id}/preview"
+
+    assert_text "Question 1 of 2"
+    assert_text "Which HTTP status means Too Many Requests?"
+    assert_button "418"
+    assert_button "429"
+    assert_no_text "Hidden question"
+  end
+
+  test "picking an answer shows the result and the correct option" do
+    visit "/moderate/quizzes/#{@quiz.id}/preview"
+    click_button "418"
+
+    assert_text "Wrong!"
+    assert_no_text "Correct!"
+    assert_text "Correct answer"
+    assert_button "Next question"
+  end
+
+  test "a correct pick says Correct!" do
+    visit "/moderate/quizzes/#{@quiz.id}/preview"
+    click_button "429"
+
+    assert_text "Correct!"
+    assert_no_text "Wrong!"
+  end
+
+  test "the preview goes through the questions and shows the score" do
+    visit "/moderate/quizzes/#{@quiz.id}/preview"
+    click_button "429"
+    click_button "Next question"
+
+    assert_text "Question 2 of 2"
+    assert_text "Which protocol keeps a two-way connection?"
+    click_button "SMTP"
+    assert_button "See score"
+    click_button "See score"
+
+    assert_text "Score: 1/2"
+    assert_button "Start over"
+  end
+
+  test "a perfect run scores everything" do
+    visit "/moderate/quizzes/#{@quiz.id}/preview"
+    click_button "429"
+    click_button "Next question"
+    click_button "WebSocket"
+    click_button "See score"
+
+    assert_text "Score: 2/2"
+  end
+
+  test "Start over restarts the preview" do
+    visit "/moderate/quizzes/#{@quiz.id}/preview"
+    click_button "429"
+    click_button "Next question"
+    click_button "Start over"
+
+    assert_text "Question 1 of 2"
+    assert_no_text "Correct!"
+  end
+
+  test "the preview stores nothing" do
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      visit "/moderate/quizzes/#{@quiz.id}/preview"
+      click_button "429"
+      click_button "Next question"
+      click_button "WebSocket"
+      click_button "See score"
+    end
+  end
+
+  test "a quiz without active questions says so" do
+    Question.update_all(active: false)
+    visit "/moderate/quizzes/#{@quiz.id}/preview"
+
+    assert_text "No active questions to preview"
+  end
+
+  test "stale answers restart the preview" do
+    visit "/moderate/quizzes/#{@quiz.id}/preview?answers=#{option('Which protocol keeps a two-way connection?', 'SMTP').id}"
+
+    assert_text "Question 1 of 2"
+    assert_current_path "/moderate/quizzes/#{@quiz.id}/preview"
+  end
+end
diff --git a/test/integration/prizes_test.rb b/test/integration/prizes_test.rb
new file mode 100644
index 0000000..71b131e
--- /dev/null
+++ b/test/integration/prizes_test.rb
@@ -0,0 +1,282 @@
+require "test_helper"
+
+# The end of a game: the leaderboard on the big screen, the places on the phones,
+# and the moderator's prize buttons.
+class PrizesTest < ActionDispatch::IntegrationTest
+  TURBO_STREAM = { "Accept" => "text/vnd.turbo-stream.html" }.freeze
+  OPENED = Time.zone.local(2026, 11, 23, 10, 0, 0)
+
+  setup do
+    @quiz = build_quiz(title: "Frontend Fest 2026")
+    3.times { |i| build_question(@quiz, text: "Question #{i + 1}?", options: [ [ "Right", true ], [ "Wrong", false ] ]) }
+    @game = @quiz.games.create!
+    @phones = {}
+    %w[Ann Ben Cy Dee].each do |name|
+      phone = open_session
+      phone.post "/play/#{@game.code}/join", params: { name: name }
+      @phones[name] = phone
+    end
+  end
+
+  teardown { travel_back }
+
+  def moderator
+    { "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "letmein") }
+  end
+
+  def page(session = self)
+    Capybara.string(session.response.body)
+  end
+
+  def moderate(action, headers: moderator)
+    post "/moderate/games/#{@game.id}/#{action}", headers: headers
+  end
+
+  # Plays the whole quiz: Ann 3 points, Ben 2, Cy 1, Dee 0, then ends the quiz.
+  def play_quiz
+    answers = {
+      "Ann" => %w[Right Right Right],
+      "Ben" => %w[Right Right Wrong],
+      "Cy" => %w[Right Wrong Wrong],
+      "Dee" => %w[Wrong Wrong Wrong]
+    }
+    travel_to(OPENED) { moderate("start") }
+    3.times do |index|
+      position = index + 1
+      game_question = @game.reload.game_questions.find_by!(position: position)
+      answers.each do |name, texts|
+        option = game_question.options.find_by!(text: texts[index])
+        travel_to(game_question.opened_at + 1) { assert @game.players.find_by!(name: name).pick(option) }
+      end
+      travel_to(OPENED + position * 10) { moderate("finish") }
+      travel_to(OPENED + position * 10 + 5) { moderate("next_question") } if position < 3
+    end
+    travel_to(OPENED + 100) { moderate("end_quiz") }
+  end
+
+  def leader_rows
+    page.all("li.leader").map do |row|
+      {
+        place: row.find(".leader__place").text,
+        name: row.find(".leader__name").text.sub(/Winner\z/, "").strip,
+        points: row.find(".leader__score").text,
+        winner: row[:class].include?("is-winner")
+      }
+    end
+  end
+
+  test "the quiz settings have a Number of winners field, 3 by default" do
+    get "/moderate/quizzes/#{@quiz.id}/edit", headers: moderator
+
+    assert page.has_field?("Number of winners", with: "3", type: "number")
+    assert_equal "1", page.find_field("Number of winners")[:min]
+  end
+
+  test "the new quiz form also asks for the number of winners" do
+    get "/moderate/quizzes/new", headers: moderator
+
+    assert page.has_field?("Number of winners", with: "3", type: "number")
+  end
+
+  test "saving the settings stores the number of winners" do
+    patch "/moderate/quizzes/#{@quiz.id}", params: { quiz: { title: "Frontend Fest 2026", winner_count: "2" } }, headers: moderator
+
+    assert_redirected_to "/moderate/quizzes/#{@quiz.id}"
+    assert_equal 2, @quiz.reload.winner_count
+  end
+
+  test "a number below 1 is refused and the quiz keeps its number" do
+    patch "/moderate/quizzes/#{@quiz.id}", params: { quiz: { title: "Frontend Fest 2026", winner_count: "0" } }, headers: moderator
+
+    assert_response :unprocessable_entity
+    assert page.has_text?("Number of winners must be at least 1")
+    assert_equal 3, @quiz.reload.winner_count
+  end
+
+  test "during the game the phones show no points, only the question" do
+    travel_to(OPENED) { moderate("start") }
+    travel_to(OPENED + 1) { @phones["Ann"].get "/play/#{@game.code}" }
+
+    assert_includes @phones["Ann"].response.body, "Question 1 of 3"
+    refute_match(/point/i, @phones["Ann"].response.body)
+  end
+
+  test "before the end the big screen has no leaderboard and no prize buttons" do
+    get "/moderate/games/#{@game.id}", headers: moderator
+
+    assert_empty page.all("li.leader")
+    refute page.has_button?("Draw")
+    refute page.has_button?("Top 3")
+  end
+
+  test "after End quiz the big screen lists every player in order, with place, name and points" do
+    play_quiz
+    get "/moderate/games/#{@game.id}", headers: moderator
+
+    assert page.has_text?("The quiz is over")
+    assert_equal [
+      { place: "1", name: "Ann", points: "3 points", winner: false },
+      { place: "2", name: "Ben", points: "2 points", winner: false },
+      { place: "3", name: "Cy", points: "1 point", winner: false },
+      { place: "4", name: "Dee", points: "0 points", winner: false }
+    ], leader_rows
+  end
+
+  test "the big screen's leaderboard has one list item for each player" do
+    play_quiz
+    get "/moderate/games/#{@game.id}", headers: moderator
+
+    assert_equal 4, page.all("ol.leaderboard > li.leader").size
+  end
+
+  test "after End quiz the prize buttons are on the big screen" do
+    play_quiz
+    get "/moderate/games/#{@game.id}", headers: moderator
+
+    assert page.has_button?("Top 3")
+    assert page.has_button?("Draw")
+    assert page.has_button?("Reset winners")
+  end
+
+  test "Top N marks the first N players as winners, and the big screen shows the Winner mark" do
+    play_quiz
+    moderate("top_winners", headers: moderator.merge(TURBO_STREAM))
+
+    assert_response :success
+    assert_includes response.body, "game-screen"
+    assert_equal [ true, true, true, false ], leader_rows_from(response.body).map { |row| row[:winner] }
+    assert_includes response.body, "Winner"
+  end
+
+  test "Top 3 can be pressed on the page too, and redirects back to the screen" do
+    play_quiz
+    moderate("top_winners")
+
+    assert_redirected_to "/moderate/games/#{@game.id}"
+    assert_equal %w[Ann Ben Cy], @game.reload.winners.map(&:name).sort
+  end
+
+  test "Draw marks the winners, and Reset winners removes the marks" do
+    play_quiz
+    moderate("draw_winners", headers: moderator.merge(TURBO_STREAM))
+    assert_equal %w[Ann Ben Cy], @game.reload.winners.map(&:name).sort
+
+    moderate("reset_winners", headers: moderator.merge(TURBO_STREAM))
+    assert_empty @game.reload.winners
+    refute_includes response.body, "Winner"
+  end
+
+  test "a prize pick before the end is refused on the page, with the reason" do
+    moderate("start")
+    moderate("top_winners", headers: moderator.merge(TURBO_STREAM))
+
+    assert_response :success
+    assert_includes response.body, "End the quiz before picking winners."
+    assert_empty @game.reload.winners
+  end
+
+  test "with nobody holding points, Top N says there are no winners" do
+    travel_to(OPENED) { moderate("start") }
+    travel_to(OPENED + 1) { moderate("finish") }
+    travel_to(OPENED + 2) { moderate("next_question") }
+    travel_to(OPENED + 3) { moderate("finish") }
+    travel_to(OPENED + 4) { moderate("next_question") }
+    travel_to(OPENED + 5) { moderate("finish") }
+    travel_to(OPENED + 6) { moderate("end_quiz") }
+
+    moderate("top_winners", headers: moderator.merge(TURBO_STREAM))
+
+    assert_includes response.body, "Nobody has points yet, so there are no winners."
+    assert_empty @game.reload.winners
+  end
+
+  test "the phone of a player shows the place and the points once the quiz has ended" do
+    play_quiz
+    @phones["Ben"].get "/play/#{@game.code}"
+
+    assert_includes @phones["Ben"].response.body, "Place 2 of 4"
+    assert_includes @phones["Ben"].response.body, "2 points"
+    refute_includes @phones["Ben"].response.body, "You won!"
+  end
+
+  test "a player with no points is placed last of four" do
+    play_quiz
+    @phones["Dee"].get "/play/#{@game.code}"
+
+    assert_includes @phones["Dee"].response.body, "Place 4 of 4"
+    assert_includes @phones["Dee"].response.body, "0 points"
+  end
+
+  test "a winner's phone says You won! and the phone of anyone else does not" do
+    play_quiz
+    moderate("top_winners")
+
+    @phones["Ann"].get "/play/#{@game.code}"
+    assert_includes @phones["Ann"].response.body, "You won!"
+
+    @phones["Dee"].get "/play/#{@game.code}"
+    refute_includes @phones["Dee"].response.body, "You won!"
+  end
+
+  test "Reset winners takes the You won! message off the phones" do
+    play_quiz
+    moderate("top_winners")
+    moderate("reset_winners")
+
+    @phones["Ann"].get "/play/#{@game.code}"
+    refute_includes @phones["Ann"].response.body, "You won!"
+    assert_includes @phones["Ann"].response.body, "Place 1 of 4"
+  end
+
+  test "someone who never joined sees the end without a place" do
+    play_quiz
+    stranger = open_session
+    stranger.get "/play/#{@game.code}"
+
+    assert_includes stranger.response.body, "The quiz is over"
+    refute_includes stranger.response.body, "Place "
+  end
+
+  test "a phone's state changes when the winners change, so it fetches them" do
+    play_quiz
+    @phones["Ann"].get "/play/#{@game.code}/state"
+    etag = @phones["Ann"].response.headers["ETag"]
+
+    @phones["Ann"].get "/play/#{@game.code}/state", headers: { "If-None-Match" => etag }
+    assert_equal 304, @phones["Ann"].response.status
+
+    moderate("top_winners")
+    @phones["Ann"].get "/play/#{@game.code}/state", headers: { "If-None-Match" => etag }
+    assert_equal 200, @phones["Ann"].response.status
+    assert_includes @phones["Ann"].response.body, "You won!"
+  end
+
+  test "a state change sends the refresh signal to the big screen and the phones once each" do
+    play_quiz
+
+    assert_turbo_stream_broadcasts [ @game, :screen ], count: 1 do
+      assert_turbo_stream_broadcasts [ @game, :players ], count: 1 do
+        moderate("top_winners")
+      end
+    end
+  end
+
+  test "the prize buttons need the moderator login" do
+    play_quiz
+    %w[top_winners draw_winners reset_winners].each do |action|
+      post "/moderate/games/#{@game.id}/#{action}"
+      assert_response :unauthorized, "#{action} must ask for the login"
+    end
+    assert_empty @game.reload.winners
+  end
+
+  private
+
+  # A turbo stream answer wraps the new screen in a <template>; read the screen inside it.
+  def leader_rows_from(html)
+    screen = html[%r{<template>(.*)</template>}m, 1] || html
+    Capybara.string(screen).all("li.leader").map do |row|
+      { name: row.find(".leader__name").text.sub(/Winner\z/, "").strip, winner: row[:class].include?("is-winner") }
+    end
+  end
+end
diff --git a/test/integration/question_form_test.rb b/test/integration/question_form_test.rb
new file mode 100644
index 0000000..4914dd3
--- /dev/null
+++ b/test/integration/question_form_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+require "support/moderator_helpers"
+
+class QuestionFormTest < ActionDispatch::IntegrationTest
+  include ModeratorHelpers
+
+  setup do
+    sign_in_as_moderator
+    @quiz = build_quiz(title: "Frontend Fest 2026")
+  end
+
+  test "a new question starts with four empty rows and Active on" do
+    visit "/moderate/quizzes/#{@quiz.id}"
+    click_button "Add question"
+
+    assert_field "Question"
+    (1..4).each do |number|
+      assert_field "Option #{number}", with: ""
+      assert_unchecked_field "Option #{number} is correct"
+    end
+    assert_checked_field "Active"
+  end
+
+  test "saving a valid question shows it on the quiz page" do
+    visit "/moderate/quizzes/#{@quiz.id}/questions/new"
+    fill_question_form(text: "Which planet is the largest?", options: [ [ "Jupiter", true ], [ "Saturn", false ], [ nil, true ] ])
+    click_button "Save question"
+
+    assert_current_path "/moderate/quizzes/#{@quiz.id}"
+    assert_text "Which planet is the largest?"
+    question = Question.last
+    assert_equal [ "Jupiter", "Saturn" ], question.options.map(&:text)
+    assert_selector "li.is-correct", text: "Jupiter"
+    assert_no_selector "li.is-correct", text: "Saturn"
+  end
+
+  test "a question needs two options" do
+    visit "/moderate/quizzes/#{@quiz.id}/questions/new"
+    fill_question_form(text: "Lonely?", options: [ [ "Only", true ] ])
+    click_button "Save question"
+
+    assert_status 422
+    assert_text "Add at least two options"
+    assert_no_text "Mark at least one option as correct"
+    assert_equal 0, Question.count
+    assert_field "Question", with: "Lonely?"
+    assert_field "Option 1", with: "Only"
+    assert_checked_field "Option 1 is correct"
+  end
+
+  test "at least one option must be correct" do
+    visit "/moderate/quizzes/#{@quiz.id}/questions/new"
+    fill_question_form(text: "Which?", options: [ [ "Yes", false ], [ "No", false ] ], active: false)
+    click_button "Save question"
+
+    assert_status 422
+    assert_text "Mark at least one option as correct"
+    assert_equal 0, Question.count
+    assert_field "Option 1", with: "Yes"
+    assert_field "Option 2", with: "No"
+    assert_unchecked_field "Active"
+  end
+
+  test "several correct options are fine" do
+    visit "/moderate/quizzes/#{@quiz.id}/questions/new"
+    fill_question_form(text: "Pick primes", options: [ [ "2", true ], [ "3", true ], [ "4", false ] ])
+    click_button "Save question"
+
+    assert_text "Pick primes"
+    assert_equal 2, Question.last.options.where(correct: true).count
+  end
+
+  test "Add option adds one row with the next number and keeps what was typed" do
+    visit "/moderate/quizzes/#{@quiz.id}/questions/new"
+    fill_in "Question", with: "Keep me"
+    fill_in "Option 1", with: "First"
+    check "Option 1 is correct"
+    click_button "Add option"
+
+    assert_field "Question", with: "Keep me"
+    assert_field "Option 1", with: "First"
+    assert_checked_field "Option 1 is correct"
+    assert_field "Option 5", with: ""
+    assert_no_field "Option 6"
+    assert_equal 0, Question.count
+  end
+
+  test "edit shows the saved question and its options" do
+    question = build_question(@quiz, text: "Old text", options: [ [ "Red", true ], [ "Blue", false ] ])
+    visit "/moderate/quizzes/#{@quiz.id}"
+    click_link "Edit"
+
+    assert_field "Question", with: "Old text"
+    assert_field "Option 1", with: "Red"
+    assert_checked_field "Option 1 is correct"
+    assert_field "Option 2", with: "Blue"
+    assert_unchecked_field "Option 2 is correct"
+    assert_field "Option 3", with: ""
+
+    fill_in "Question", with: "New text"
+    fill_in "Option 2", with: "Green"
+    check "Option 2 is correct"
+    click_button "Save question"
+
+    assert_text "New text"
+    assert_equal %w[Red Green], question.reload.options.map(&:text)
+  end
+
+  test "a rejected edit leaves the question untouched" do
+    question = build_question(@quiz, text: "Keep", options: [ [ "A", true ], [ "B", false ] ])
+    visit "/moderate/quizzes/#{@quiz.id}"
+    click_link "Edit"
+    fill_in "Question", with: "Changed"
+    uncheck "Option 1 is correct"
+    click_button "Save question"
+
+    assert_text "Mark at least one option as correct"
+    assert_field "Question", with: "Changed"
+    assert_equal "Keep", question.reload.text
+    assert_equal [ true, false ], question.options.map(&:correct)
+  end
+end
diff --git a/test/integration/quiz_management_test.rb b/test/integration/quiz_management_test.rb
new file mode 100644
index 0000000..019fcfe
--- /dev/null
+++ b/test/integration/quiz_management_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+require "support/moderator_helpers"
+
+class QuizManagementTest < ActionDispatch::IntegrationTest
+  include ModeratorHelpers
+
+  setup do
+    sign_in_as_moderator
+  end
+
+  test "the list shows quizzes and the New quiz button" do
+    build_quiz(title: "Frontend Fest 2026")
+    visit "/moderate"
+
+    assert_selector "li", text: "Frontend Fest 2026"
+    assert_button "New quiz"
+  end
+
+  test "an empty list says so" do
+    visit "/moderate"
+
+    assert_text "No quizzes yet"
+  end
+
+  test "creating a quiz opens its page" do
+    create_quiz_through_form("Frontend Fest 2026")
+
+    assert_text "Frontend Fest 2026"
+    assert_button "Add question"
+    assert_link "Settings"
+    assert_link "Preview"
+    assert_equal 1, Quiz.count
+  end
+
+  test "the title is required" do
+    visit "/moderate/quizzes/new"
+    fill_in "Title", with: "   "
+    click_button "Save quiz"
+
+    assert_status 422
+    assert_text "Title can't be blank"
+    assert_equal 0, Quiz.count
+  end
+
+  test "settings edit the title" do
+    quiz = build_quiz(title: "Old")
+    visit "/moderate/quizzes/#{quiz.id}"
+    click_link "Settings"
+    fill_in "Title", with: "New title"
+    click_button "Save quiz"
+
+    assert_text "New title"
+    assert_equal "New title", quiz.reload.title
+  end
+
+  test "settings delete the quiz" do
+    quiz = build_quiz(title: "Doomed")
+    visit "/moderate/quizzes/#{quiz.id}/edit"
+    click_button "Delete quiz"
+
+    assert_current_path "/moderate"
+    assert_equal 0, Quiz.count
+  end
+
+  test "the quiz page lists questions in order with their options" do
+    quiz = build_quiz
+    build_question(quiz, text: "First question", options: [ [ "Alpha", true ], [ "Beta", false ] ])
+    build_question(quiz, text: "Second question", options: [ [ "Gamma", false ], [ "Delta", true ] ], active: false)
+    visit "/moderate/quizzes/#{quiz.id}"
+
+    items = all("li.question-item")
+    assert_equal 2, items.size
+    assert_includes items[0].text, "First question"
+    assert_includes items[1].text, "Second question"
+    within items[0] do
+      assert_button "Move up"
+      assert_button "Move down"
+      assert_link "Edit"
+      assert_button "Delete"
+      assert_field "Active", checked: true
+    end
+    within items[1] do
+      assert_field "Active", checked: false
+    end
+    assert_text "1 of 2 questions active"
+  end
+
+  test "deleting a question removes it" do
+    quiz = build_quiz
+    build_question(quiz, text: "Doomed question")
+    visit "/moderate/quizzes/#{quiz.id}"
+    within("li.question-item", text: "Doomed question") { click_button "Delete" }
+
+    assert_no_text "Doomed question"
+    assert_equal 0, Question.count
+  end
+
+  test "Move up and Move down reorder the questions" do
+    quiz = build_quiz
+    build_question(quiz, text: "Alpha question")
+    build_question(quiz, text: "Beta question")
+    visit "/moderate/quizzes/#{quiz.id}"
+    within("li.question-item", text: "Beta question") { click_button "Move up" }
+
+    assert_equal [ "Beta question", "Alpha question" ], all("li.question-item .question-item__body").map(&:text)
+
+    within("li.question-item", text: "Beta question") { click_button "Move down" }
+    assert_equal [ "Alpha question", "Beta question" ], all("li.question-item .question-item__body").map(&:text)
+  end
+end
diff --git a/test/integration/quiz_transfer_test.rb b/test/integration/quiz_transfer_test.rb
