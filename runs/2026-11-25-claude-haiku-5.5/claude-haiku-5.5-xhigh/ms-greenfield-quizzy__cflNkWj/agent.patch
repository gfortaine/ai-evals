+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+  end
+
+  test "a rejected import shows the error in the browser and imports nothing" do
+    visit "/moderate/imports/new"
+    fill_in "Quiz JSON", with: '{"title": "Nope", "questions": [{"text": "One option", "options": [{"text": "A", "correct": true}]}]}'
+    click_button "Import"
+
+    assert_text "Question 1: Add at least two options"
+    assert_field "Quiz JSON"
+    assert_equal 1, Quiz.count
+  end
+end
