new file mode 100644
index 0000000..4a82db7
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,89 @@
+# The players' side, on phones. No account: a join code, then a name. The browser
+# keeps its player in a signed cookie, so opening the join link again continues
+# the same player.
+class PlayController < ApplicationController
+  before_action :set_game
+  before_action :set_player
+
+  def show
+    @screen = PlayerScreen.new(@game, @player)
+  end
+
+  def join
+    if @game.finished?
+      redirect_to play_path(@game.code), status: :see_other
+      return
+    end
+
+    if @player
+      redirect_to play_path(@game.code), status: :see_other
+      return
+    end
+
+    player = @game.players.new(name: params[:name])
+    if player.save
+      cookies.permanent.signed[cookie_name] = { value: player.token, httponly: true, same_site: :lax }
+      @game.broadcast_screen_refresh
+      redirect_to play_path(@game.code), status: :see_other
+    else
+      @join_error = player.errors[:name].first || "Enter your name"
+      @screen = PlayerScreen.new(@game, nil)
+      render :show, status: :unprocessable_entity
+    end
+  end
+
+  # The phone's own region, fetched by the live controller.
+  def state
+    view = PlayerScreen.new(@game, @player)
+    render partial: "play/screen", locals: { screen: view } if stale?(etag: view.version)
+  end
+
+  # Tapping an option. Answers with a Turbo Stream that replaces the phone's view.
+  def answer
+    message = nil
+
+    if @player.nil?
+      message = "Join the quiz first."
+    else
+      option = GameOption.joins(:game_question).find_by(id: params[:option_id], game_questions: { game_id: @game.id })
+      if option.nil?
+        message = "That answer is not part of this question."
+      elsif !@player.pick(option)
+        message = @player.errors.full_messages.to_sentence
+      end
+    end
+
+    # A pick refused at the deadline has closed the question; show the phone that state.
+    @game.reload
+
+    respond_to do |format|
+      format.turbo_stream do
+        render turbo_stream: turbo_stream.replace(
+          "player-screen",
+          partial: "play/screen",
+          locals: { screen: PlayerScreen.new(@game, @player), message: message }
+        )
+      end
+      format.html { redirect_to play_path(@game.code), status: :see_other }
+    end
+  end
+
+  private
+
+  def set_game
+    @game = Game.includes(:quiz).with_join_code(params[:code])
+    return render :missing, status: :not_found if @game.nil?
+
+    # A question whose time is up closes before the phone sees or answers it.
+    @game.close_expired_question
+  end
+
+  def set_player
+    token = cookies.signed[cookie_name]
+    @player = @game.players.find_by(token: token) if token.present?
+  end
+
+  def cookie_name
+    "quizzy_player_#{@game.code}"
+  end
+end
diff --git a/app/helpers/application_helper.rb b/app/helpers/application_helper.rb
new file mode 100644
index 0000000..fc44daf
--- /dev/null
+++ b/app/helpers/application_helper.rb
@@ -0,0 +1,47 @@
+module ApplicationHelper
+  # A new question starts with this many option rows.
+  FORM_OPTION_ROWS = 4
+
+  def page_title(text)
+    content_for(:title, text)
+  end
+
+  def option_letter(index)
+    ("A".ord + index).chr
+  end
+
+  # A time as M:SS, e.g. "1:30" or "0:05". Partial seconds round up, so the
+  # countdown shows 0:00 only once the time is up. Same rule as countdown_controller.js.
+  def countdown_text(milliseconds)
+    seconds = (milliseconds / 1000.0).ceil
+    format("%d:%02d", seconds / 60, seconds % 60)
+  end
+
+  # The quiz's time per question, for the quiz page: "1:30 per question" or "No timer".
+  def time_per_question_text(quiz)
+    return "No timer" unless quiz.time_limit_seconds.positive?
+
+    "#{countdown_text(quiz.time_limit_seconds * 1000)} per question"
+  end
+
+  # Rows for the question form: the rows as they were submitted, padded with
+  # empty rows up to FORM_OPTION_ROWS.
+  def form_option_rows(question)
+    rows = question.option_rows.dup
+    (FORM_OPTION_ROWS - rows.size).times { rows << Question::OptionRow.new(text: "", correct: false) }
+    rows
+  end
+
+  # The join link as an inline SVG, sized by the stylesheet (.qr svg).
+  def qr_code_svg(text)
+    svg = RQRCode::QRCode.new(text).as_svg(
+      offset: 0,
+      module_size: 6,
+      shape_rendering: "crispEdges",
+      use_path: true,
+      viewbox: true
+    )
+    # The XML declaration only belongs in a file, not inside an HTML page.
+    svg.sub(/\A<\?xml[^>]*\?>/, "").html_safe
+  end
+end
