diff --git a/app/models/player.rb b/app/models/player.rb
new file mode 100644
index 0000000..2b4e79f
--- /dev/null
+++ b/app/models/player.rb
@@ -0,0 +1,64 @@
+# Someone who joined a game from a phone. No account: the name and a random token,
+# which the browser keeps in a signed cookie.
+class Player < ApplicationRecord
+  NAME_MAX_LENGTH = 40
+
+  belongs_to :game
+  has_many :answers, dependent: :destroy
+
+  before_validation :normalize_name, on: :create
+  before_validation :assign_token, on: :create
+  validates :name, presence: { message: "Enter your name" },
+                   length: { maximum: NAME_MAX_LENGTH, message: "Use at most #{NAME_MAX_LENGTH} characters" }
+  validates :token, presence: true, uniqueness: true
+
+  def answer_for(game_question)
+    answers.find_by(game_question: game_question)
+  end
+
+  # Records the player's pick for the open question. Picking again replaces it, so
+  # the last pick before the question closes is the one that counts. `picked_at` is
+  # the moment of that last pick; the speed tie-break measures to it.
+  #
+  # The check and the write happen in one immediate SQLite transaction. The
+  # moderator's "Finish" takes the same lock, so a pick cannot land after close.
+  # A pick after the question's deadline is refused, as if the question were
+  # already finished; the question then closes at its deadline.
+  def pick(option)
+    saved = false
+    Answer.transaction(requires_new: true) do
+      fresh_game = Game.find(game_id)
+      question = GameQuestion.find_by(id: option.game_question_id)
+
+      if question.nil? || question.game_id != game_id
+        errors.add(:base, "That answer is not part of this game.")
+      elsif !fresh_game.running? || fresh_game.current_game_question != question || !question.open? || fresh_game.time_up?
+        errors.add(:base, "This question is closed.")
+      else
+        now = Time.current
+        Answer.upsert(
+          { player_id: id, game_question_id: question.id, game_option_id: option.id,
+            picked_at: now, created_at: now, updated_at: now },
+          unique_by: %i[player_id game_question_id],
+          update_only: %i[game_option_id picked_at updated_at]
+        )
+        saved = true
+      end
+    end
+
+    # A pick refused because the time ran out closes the question now, so every screen follows.
+    Game.find(game_id).close_expired_question
+    game.broadcast_screen_refresh if saved
+    saved
+  end
+
+  private
+
+  def normalize_name
+    self.name = name.to_s.squish
+  end
+
+  def assign_token
+    self.token = SecureRandom.hex(16) if token.blank?
+  end
+end
diff --git a/app/models/player_screen.rb b/app/models/player_screen.rb
new file mode 100644
index 0000000..fb44eac
--- /dev/null
+++ b/app/models/player_screen.rb
@@ -0,0 +1,97 @@
+# What one phone shows for a game: the join form, the waiting room, the open
+# question, the result of a closed question, or the end.
+#
+# `option_rows` gives `correct` only once the question has closed, so an open
+# question never reveals the right answer, not even in the HTML.
+class PlayerScreen
+  Row = Data.define(:option, :index, :picked, :correct)
+
+  attr_reader :game, :player
+
+  # player is nil for someone who has not joined in this browser yet.
+  def initialize(game, player)
+    @game = game
+    @player = player
+  end
+
+  def joined?
+    player.present? && player.persisted?
+  end
+
+  # :join (not joined yet), :waiting (joined, quiz not started), :open, :closed,
+  # or :over.
+  def phase
+    return :over if game.finished?
+    return :join unless joined?
+    return :waiting if game.lobby?
+
+    question.open? ? :open : :closed
+  end
+
+  # The standings, shown once the quiz has ended.
+  def leaderboard
+    @leaderboard ||= game.leaderboard
+  end
+
+  # The player's place and points, once the quiz has ended. nil before that, and for
+  # someone who never joined.
+  def standing
+    return unless joined? && game.finished?
+
+    leaderboard.entry_for(player)
+  end
+
+  # Winners are picked only after the end, but the banner also waits for the end.
+  def winner?
+    joined? && game.finished? && player.winner?
+  end
+
+  # 1-based number of the current question, and how many the game has.
+  def position
+    game.current_position
+  end
+
+  def total
+    @total ||= game.total_questions
+  end
+
+  def question
+    return @question if defined?(@question)
+
+    @question = game.current_game_question
+  end
+
+  def picked_option
+    return @picked_option if defined?(@picked_option)
+
+    @picked_option = (joined? && question) ? player.answer_for(question)&.game_option : nil
+  end
+
+  # Only meaningful when the question is closed: :right, :wrong or :none.
+  def result
+    return :none unless picked_option
+
+    picked_option.correct? ? :right : :wrong
+  end
+
+  def option_rows
+    return [] unless question
+
+    question.options.each_with_index.map do |option, index|
+      Row.new(
+        option: option,
+        index: index,
+        picked: picked_option.present? && option.id == picked_option.id,
+        correct: phase == :closed ? option.correct : nil
+      )
+    end
+  end
+
+  # The join form only changes when the quiz ends, so a name being typed is not
+  # replaced by a refresh. Joined players get a version for every change.
+  def version
+    return phase.to_s unless joined?
+
+    [ phase, game.state_version, player.id, picked_option&.id ].join("-")
+  end
+end
diff --git a/app/models/question.rb b/app/models/question.rb
new file mode 100644
index 0000000..6077ca7
--- /dev/null
+++ b/app/models/question.rb
@@ -0,0 +1,60 @@
+class Question < ApplicationRecord
+  # One row of the question form. Rows keep what the moderator typed, including
+  # empty ones, so a failed save can show the form exactly as it was submitted.
+  OptionRow = Struct.new(:text, :correct, keyword_init: true) do
+    def empty_text? = text.to_s.strip.empty?
+  end
+
+  MIN_OPTIONS = 2
+
+  belongs_to :quiz
+  has_many :options, -> { order(:position, :id) }, dependent: :destroy, inverse_of: :question
+
+  before_create :assign_position
+  validates :text, presence: true
+  validate :option_rules
+  after_save :replace_options, if: :option_rows_assigned?
+
+  # The option rows as shown in the form. Until they are assigned, the
+  # question's saved options are used.
+  def option_rows
+    @option_rows ||= options.map { |option| OptionRow.new(text: option.text, correct: option.correct) }
+  end
+
+  def option_rows=(rows)
+    @option_rows_assigned = true
+    @option_rows = Array(rows).map do |row|
+      OptionRow.new(text: row.text.to_s, correct: row.correct ? true : false)
+    end
+  end
+
+  def filled_option_rows
+    option_rows.reject(&:empty_text?)
+  end
+
+  def option_rows_assigned?
+    @option_rows_assigned == true
+  end
+
+  private
+
+  def assign_position
+    self.position = Question.where(quiz_id: quiz_id).maximum(:position).to_i + 1 if position.to_i.zero?
+  end
+
+  def option_rules
+    filled = filled_option_rows
+    errors.add(:base, "Add at least two options") if filled.size < MIN_OPTIONS
+    errors.add(:base, "Mark at least one option as correct") unless filled.any?(&:correct)
+  end
+
+  # Runs after validation has passed, so a rejected form never touches the
+  # saved options. Empty rows are skipped.
+  def replace_options
+    options.destroy_all
+    filled_option_rows.each.with_index(1) do |row, position|
+      options.create!(text: row.text.strip, correct: row.correct, position: position)
+    end
+    options.reset
+  end
+end
diff --git a/app/models/quiz.rb b/app/models/quiz.rb
new file mode 100644
index 0000000..9008d9c
--- /dev/null
+++ b/app/models/quiz.rb
@@ -0,0 +1,94 @@
+class Quiz < ApplicationRecord
+  # Largest value the integer column holds.
+  MAX_WINNER_COUNT = 2_147_483_647
+  # The timer is per question: a day of minutes is far more than any talk needs.
+  MAX_TIMER_MINUTES = 1_440
+  MAX_TIMER_SECONDS = 59
+
+  has_many :questions, -> { order(:position, :id) }, dependent: :destroy, inverse_of: :quiz
+  has_many :games, dependent: :destroy
+
+  before_validation :blank_timer_fields_mean_zero
+
+  validates :title, presence: true
+  validate :winner_count_rules
+  validate :timer_rules
+
+  def active_questions
+    questions.where(active: true)
+  end
+
+  # Time per question, in seconds. 0 means no timer.
+  def time_limit_seconds
+    timer_minutes.to_i * 60 + timer_seconds.to_i
+  end
+
+  # Swaps a question with its neighbour. Inactive questions take part in the
+  # ordering too, so moving past them is allowed. Returns false at the ends.
+  def move_question(question, direction)
+    ordered = Question.where(quiz_id: id).order(:position, :id).to_a
+    index = ordered.index { |candidate| candidate.id == question.id }
+    return false unless index
+
+    target = case direction.to_s
+    when "up" then index - 1
+    when "down" then index + 1
+    else return false
+    end
+    return false unless target.between?(0, ordered.size - 1)
+
+    ordered[index], ordered[target] = ordered[target], ordered[index]
+    transaction do
+      ordered.each.with_index(1) do |candidate, position|
+        candidate.update_column(:position, position) unless candidate.position == position
+      end
+    end
+    true
+  end
+
+  private
+
+  # The checks read the typed text, so "2.5" or "" is refused rather than rounded.
+  def winner_count_rules
+    typed = winner_count_before_type_cast.to_s.strip
+
+    unless typed.match?(/\A[+-]?\d+\z/)
+      errors.add(:winner_count, "must be a whole number")
+      return
+    end
+
+    if winner_count < 1
+      errors.add(:winner_count, "must be at least 1")
+    elsif winner_count > MAX_WINNER_COUNT
+      errors.add(:winner_count, "must be at most #{MAX_WINNER_COUNT}")
+    end
+  end
+
+  # A cleared timer box means no time in that unit, the same as 0.
+  def blank_timer_fields_mean_zero
+    self.timer_minutes = 0 if timer_minutes_before_type_cast.to_s.strip.empty?
+    self.timer_seconds = 0 if timer_seconds_before_type_cast.to_s.strip.empty?
+  end
+
+  def timer_rules
+    check_timer_field(:timer_minutes, MAX_TIMER_MINUTES)
+    check_timer_field(:timer_seconds, MAX_TIMER_SECONDS)
+  end
+
+  # Same typed-text rule as the winner count: a fractional or non-numeric value is refused.
+  def check_timer_field(attribute, largest)
+    typed = public_send(:"#{attribute}_before_type_cast").to_s.strip
+
+    unless typed.match?(/\A[+-]?\d+\z/)
+      errors.add(attribute, "must be a whole number")
+      return
+    end
+
+    value = public_send(attribute)
+    if value < 0
+      errors.add(attribute, "must be at least 0")
+    elsif value > largest
+      errors.add(attribute, "must be at most #{largest}")
+    end
+  end
+end
diff --git a/app/models/quiz_export.rb b/app/models/quiz_export.rb
new file mode 100644
index 0000000..abd3caf
--- /dev/null
+++ b/app/models/quiz_export.rb
@@ -0,0 +1,33 @@
+# Writes a quiz in the JSON format that QuizImport reads:
+#
+#   {"title": "...", "questions": [{"text": "...", "active": true,
+#     "options": [{"text": "...", "correct": false}]}]}
+#
+# Only the title and the questions go out, in their order. Ids, positions and
+# timestamps stay out: the export is for moving the quiz's contents.
+class QuizExport
+  def initialize(quiz)
+    @quiz = quiz
+  end
+
+  def to_h
+    {
+      "title" => @quiz.title,
+      "questions" => @quiz.questions.includes(:options).map { |question| question_hash(question) }
+    }
+  end
+
+  def to_pretty_json
+    JSON.pretty_generate(to_h)
+  end
+
+  private
+
+  def question_hash(question)
+    {
+      "text" => question.text,
+      "active" => question.active,
+      "options" => question.options.map { |option| { "text" => option.text, "correct" => option.correct } }
+    }
+  end
+end
diff --git a/app/models/quiz_import.rb b/app/models/quiz_import.rb
new file mode 100644
index 0000000..0e2470e
--- /dev/null
+++ b/app/models/quiz_import.rb
@@ -0,0 +1,117 @@
+# Creates a new quiz from JSON in the format QuizExport writes:
+#
+#   {"title": "...", "questions": [{"text": "...", "active": true,
+#     "options": [{"text": "...", "correct": false}]}]}
+#
+# "active" (default true) and "correct" (default false) may be left out. Questions
+# and options keep their order. Unknown keys are ignored.
+#
+# The rules are the ones the moderator's forms use, because the same models check
+# them. Nothing is written unless the whole quiz is valid: the quiz and its
+# questions are saved in one save call, which validates everything before it
+# inserts a row and runs in a single transaction. Every import creates a new
+# quiz, even when one with the same title exists.
+class QuizImport
+  # The JSON cannot be read, or has the wrong shape (for example a question that
+  # is not an object). Rule errors come from the models and are collected in full.
+  class FormatError < StandardError; end
+
+  attr_reader :json_text, :quiz, :errors
+
+  def initialize(json_text)
+    @json_text = json_text.to_s
+    @errors = []
+    @quiz = nil
+  end
+
+  # True when the quiz and all of its questions were created.
+  def save
+    build
+    return true if quiz.save
+
+    collect_errors
+    false
+  rescue FormatError => e
+    errors << e.message
+    false
+  end
+
+  private
+
+  def build
+    data = parse
+    raise FormatError, "The quiz JSON must be an object with a title and questions." unless data.is_a?(Hash)
+
+    @quiz = Quiz.new(title: text_value(data["title"], "Title"))
+    items = data["questions"]
+    raise FormatError, "Questions must be a list." unless items.is_a?(Array)
+
+    items.each.with_index(1) do |item, number|
+      @quiz.questions.build(build_question_attributes(item, number))
+    end
+  end
+
+  # A byte-order mark from a copied file is not part of the JSON.
+  def parse
+    source = json_text.delete_prefix("\uFEFF")
+    raise FormatError, "Paste the quiz JSON to import." if source.strip.empty?
+
+    JSON.parse(source)
+  rescue JSON::ParserError => e
+    raise FormatError, "The quiz JSON is not valid JSON: #{e.message}"
+  end
+
+  def build_question_attributes(item, number)
+    raise FormatError, "Question #{number} must be an object." unless item.is_a?(Hash)
+
+    label = "Question #{number}"
+    options = item["options"]
+    raise FormatError, "#{label}: options must be a list." unless options.is_a?(Array)
+
+    {
+      text: text_value(item["text"], "#{label}: text"),
+      active: boolean_value(item["active"], true, "#{label}: active"),
+      position: number,
+      option_rows: options.each.with_index(1).map { |option, index| build_option_row(option, label, index) }
+    }
+  end
+
+  def build_option_row(item, question_label, number)
+    label = "#{question_label}, option #{number}"
+    raise FormatError, "#{label} must be an object." unless item.is_a?(Hash)
+
+    Question::OptionRow.new(
+      text: text_value(item["text"], "#{label}: text"),
+      correct: boolean_value(item["correct"], false, "#{label}: correct")
+    )
+  end
+
+  # A missing or null value counts as blank, which the model rules then reject
+  # (or, for option rows, skip, as the question form does).
+  def text_value(value, label)
+    return "" if value.nil?
+    return value if value.is_a?(String)
+
+    raise FormatError, "#{label} must be a string."
+  end
+
+  def boolean_value(value, default, label)
+    return default if value.nil?
+    return value if value == true || value == false
+
+    raise FormatError, "#{label} must be true or false."
+  end
+
+  # Model messages as the form shows them, with the question they belong to.
+  def collect_errors
+    quiz.errors.each do |error|
+      next if error.attribute == :questions # reported per question below
+
+      errors << error.full_message
+    end
+
+    quiz.questions.each.with_index(1) do |question, number|
+      question.errors.full_messages.each { |message| errors << "Question #{number}: #{message}" }
+    end
+  end
+end
diff --git a/app/models/quiz_preview.rb b/app/models/quiz_preview.rb
new file mode 100644
index 0000000..f022035
--- /dev/null
+++ b/app/models/quiz_preview.rb
@@ -0,0 +1,88 @@
+# Plays a quiz the way a participant would, without storing anything.
+#
+# The state lives in the URL, so nothing is written to the database:
+#   answers - option ids picked so far, one per active question, comma-separated
+#   pick    - option id picked for the current question; reveals the answer
+class QuizPreview
+  attr_reader :questions
+
+  def initialize(quiz, answers: nil, pick: nil)
+    @questions = quiz.active_questions.includes(:options).to_a
+    @answer_ids = parse_ids(answers)
+    @pick_id = parse_id(pick)
+  end
+
+  # False when the answers do not match this quiz's active questions, for
+  # example after a question was deleted or deactivated during the preview.
+  def valid?
+    !@answer_ids.nil? && answers_fit_questions?
+  end
+
+  def total
+    questions.size
+  end
+
+  def answer_ids
+    @answer_ids || []
+  end
+
+  def finished?
+    total.positive? && answer_ids.size == total
+  end
+
+  # 1-based number of the question on screen.
+  def position
+    answer_ids.size + 1
+  end
+
+  def current_question
+    questions[answer_ids.size] unless finished?
+  end
+
+  def last_question?
+    answer_ids.size == total - 1
+  end
+
+  # The option picked for the current question, if the page shows one.
+  def picked_option
+    return if current_question.nil? || @pick_id.nil?
+
+    current_question.options.find { |option| option.id == @pick_id }
+  end
+
+  def score
+    answer_ids.each_with_index.count { |id, index| option_for(index, id)&.correct? }
+  end
+
+  def answers_param
+    answer_ids.join(",")
+  end
+
+  def answers_param_after_pick
+    (answer_ids + [ picked_option.id ]).join(",")
+  end
+
+  private
+
+  # nil means the parameter could not be read; [] means no answers yet.
+  def parse_ids(raw)
+    return [] if raw.blank?
+
+    ids = raw.to_s.split(",").map { |part| parse_id(part) }
+    ids.include?(nil) ? nil : ids
+  end
+
+  def parse_id(raw)
+    Integer(raw.to_s, exception: false)
+  end
+
+  def answers_fit_questions?
+    return false if @answer_ids.size > total
+
+    @answer_ids.each_with_index.all? { |id, index| option_for(index, id) }
+  end
+
+  def option_for(index, id)
+    questions[index]&.options&.find { |option| option.id == id }
+  end
+end
