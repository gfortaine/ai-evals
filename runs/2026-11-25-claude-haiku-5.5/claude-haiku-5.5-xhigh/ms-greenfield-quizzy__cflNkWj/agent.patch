diff --git a/config/routes.rb b/config/routes.rb
new file mode 100644
index 0000000..939e4fa
--- /dev/null
+++ b/config/routes.rb
@@ -0,0 +1,45 @@
+Rails.application.routes.draw do
+  get "up" => "rails/health#show", as: :rails_health_check
+
+  root to: redirect("/moderate", status: 302)
+
+  # The players' side. Public: the join code is the only key, and each browser
+  # keeps its own player in a signed cookie.
+  get "play/:code", to: "play#show", as: :play
+  post "play/:code/join", to: "play#join", as: :join_play
+  get "play/:code/state", to: "play#state", as: :play_state
+  post "play/:code/answer", to: "play#answer", as: :answer_play
+
+  namespace :moderate do
+    root "quizzes#index"
+
+    resources :quizzes do
+      get :preview, on: :member
+      get :export, on: :member
+
+      resources :games, only: %i[create]
+      resources :questions, except: %i[index show] do
+        post :move, on: :member
+        patch :activation, on: :member
+      end
+    end
+
+    # The big screen and the buttons that move a game along.
+    resources :games, only: %i[show] do
+      get :screen, on: :member
+      post :start, on: :member
+      post :finish, on: :member
+      post :next_question, on: :member
+      post :end_quiz, on: :member
+      post :top_winners, on: :member
+      post :draw_winners, on: :member
+      post :reset_winners, on: :member
+    end
+
+    # Importing always creates a new quiz, so there is no record to edit.
+    resources :imports, only: %i[new create]
+
+    # Unknown moderator URLs still ask for credentials before answering 404.
+    match "*unmatched", to: "base#missing", via: :all
+  end
+end
