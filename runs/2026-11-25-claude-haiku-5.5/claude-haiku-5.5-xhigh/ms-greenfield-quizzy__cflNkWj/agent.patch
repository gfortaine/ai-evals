diff --git a/app/javascript/controllers/countdown_controller.js b/app/javascript/controllers/countdown_controller.js
new file mode 100644
index 0000000..6709114
--- /dev/null
+++ b/app/javascript/controllers/countdown_controller.js
@@ -0,0 +1,55 @@
+import { Controller } from "@hotwired/stimulus"
+
+// The big screen's countdown for the open question, shown as M:SS.
+//
+// The server sends the time left when it renders the screen, not the end time, so
+// the countdown does not depend on the clock of the machine running the big screen.
+// A reload gets the true time left from the server again.
+//
+// At 0:00 the control asks its live region for fresh HTML. The server closes the
+// question at its deadline, as if the moderator had clicked "Finish", and the
+// region is replaced, which disconnects this control. If the request raced the
+// deadline and the question is still open, the control asks again after a second.
+const RETRY_MS = 1000
+const MAX_ASKS = 10
+
+export default class extends Controller {
+  static values = { remaining: Number }
+  static targets = [ "display" ]
+
+  connect() {
+    this.endsAt = performance.now() + this.remainingValue
+    this.asks = 0
+    this.tick()
+  }
+
+  disconnect() {
+    clearTimeout(this.timer)
+  }
+
+  tick() {
+    const left = this.endsAt - performance.now()
+    if (left <= 0) {
+      this.displayTarget.textContent = format(0)
+      this.ask()
+      return
+    }
+
+    // Same rounding as the server (countdown_text): partial seconds round up.
+    const seconds = Math.ceil(left / 1000)
+    this.displayTarget.textContent = format(seconds)
+    // Wake up when the displayed number changes next.
+    this.timer = setTimeout(() => this.tick(), left - (seconds - 1) * 1000)
+  }
+
+  ask() {
+    this.asks += 1
+    this.dispatch("refresh", { prefix: "live" })
+    if (this.asks < MAX_ASKS) this.timer = setTimeout(() => this.ask(), RETRY_MS)
+  }
+}
+
+function format(seconds) {
+  const minutes = Math.floor(seconds / 60)
+  return `${minutes}:${String(seconds % 60).padStart(2, "0")}`
+}
