+++ b/app/assets/stylesheets/quizzy_app.css
@@ -0,0 +1,100 @@
+/*
+ * Quizzy app-specific tweaks on top of the design's quizzy.css.
+ * Keep quizzy.css as exported from the design file.
+ */
+
+/* Option rows: text field plus "correct" checkbox. There is no remove button;
+   clearing the text drops a row. */
+.option-row { grid-template-columns: 1fr auto; }
+.option-row .checkbox { white-space: nowrap; }
+.option-row .input { min-width: 0; }
+
+/* The options group is a fieldset; keep it a plain block inside the card. */
+.options-field { border: 0; padding: 0; margin: 0 0 20px; min-width: 0; }
+.options-field legend { padding: 0; margin-bottom: 6px; }
+/* Checkboxes inside form fields keep the design's switch-label type, not the
+   small form-label style that ".field label" applies. */
+.field .checkbox { font-size: 18px; font-weight: 500; }
+.options-field > .field-hint { display: block; }
+.add-option { margin-bottom: 28px; }
+
+/* First and last question: the move arrow that cannot move is dimmed, not disabled,
+   so clicking it stays a harmless no-op. */
+.btn.is-edge { opacity: 0.4; }
+
+/* The Active checkbox sits on its own line under the move buttons. */
+.question-item__actions form { margin: 0; }
+
+/* Export page: the JSON block selects as a whole on one click, ready to copy. */
+.export-json {
+  padding: 16px 18px;
+  border-radius: 12px;
+  background: var(--c-lavender);
+  color: var(--c-night);
+  max-height: 70vh;
+  overflow: auto;
+  user-select: all;
+}
+
+/* ---------- Quiz page: games list ---------- */
+
+.game-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
+.game-item { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px; padding: 18px 22px; }
+.game-item__title { font-family: var(--f-display); font-weight: 800; font-size: 20px; }
+
+/* ---------- Big screen ---------- */
+
+/* Flash messages sit at the top here, away from the control bar at the bottom. */
+.big-screen .flash { top: 24px; bottom: auto; }
+
+.game-screen { min-height: 100vh; min-height: 100dvh; }
+.game-screen .cover { min-height: 100vh; min-height: 100dvh; }
+.game-screen .screen .errors { margin-bottom: 24px; }
+
+.screen-controls .btn--light { background: transparent; color: var(--c-lavender); box-shadow: inset 0 0 0 2px var(--c-lavender); }
+.screen-controls .btn--light:hover { background: var(--c-lavender); color: var(--c-blue); }
+.screen-controls .buttons { justify-content: flex-end; }
+
+.stage-finished { font-size: clamp(56px, 9vw, 160px); line-height: 0.95; margin: 0; }
+
+/* ---------- Phones ---------- */
+
+.play-option-form { margin: 0; display: contents; }
+.join-form .field-label { margin-bottom: -4px; }
+.play-options .play-option { cursor: pointer; }
+.play-options:not(.is-revealed) .play-option:focus-visible { outline: 3px solid var(--c-pink); outline-offset: 2px; }
+.play-options.is-revealed .play-option { cursor: default; }
+
+/* While a tap or click is on its way to the server, the control dims (Turbo sets aria-busy). */
+.play-option-form[aria-busy="true"] .play-option,
+.screen-controls form[aria-busy="true"] .btn { opacity: 0.6; pointer-events: none; }
+
+/* ---------- Quiz settings: time per question ---------- */
+
+.timer-field { border: 0; padding: 0; margin: 0 0 20px; min-width: 0; }
+.timer-field legend { padding: 0; margin-bottom: 6px; }
+.timer-field > .field-hint { display: block; }
+.field-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
+.field-pair .field { margin-bottom: 0; }
+
+/* ---------- Big screen: countdown ---------- */
+
+.stage-question__head {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  align-items: baseline;
+  gap: 12px 32px;
+  margin-bottom: 0.6em;
+}
+.stage-question__head .stage-question__num { margin-bottom: 0; }
+.stage-timer {
+  padding: 0.1em 0.5em;
+  border-radius: 1000px;
+  background: rgb(221 221 255 / 0.18);
+  font-family: var(--f-display);
+  font-weight: 900;
+  font-size: clamp(32px, 4vw, 64px);
+  line-height: 1.1;
+  font-variant-numeric: tabular-nums;
+}
