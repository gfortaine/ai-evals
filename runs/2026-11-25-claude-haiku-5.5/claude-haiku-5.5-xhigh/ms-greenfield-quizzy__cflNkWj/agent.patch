+module Moderate
+  class QuizzesController < BaseController
+    before_action :set_quiz, only: %i[show edit update destroy preview export]
+
+    def index
+      @quizzes = Quiz.includes(:questions).order(:id)
+    end
+
+    def show
+      @questions = @quiz.questions.includes(:options).to_a
+      @games = @quiz.games.newest_first.includes(:players)
+    end
+
+    def new
+      @quiz = Quiz.new
+    end
+
+    def create
+      @quiz = Quiz.new(quiz_params)
+
+      if @quiz.save
+        redirect_to moderate_quiz_path(@quiz), notice: "Quiz saved.", status: :see_other
+      else
+        render :new, status: :unprocessable_entity
+      end
+    end
+
+    def edit
+    end
+
+    def update
+      if @quiz.update(quiz_params)
+        redirect_to moderate_quiz_path(@quiz), notice: "Quiz saved.", status: :see_other
+      else
+        render :edit, status: :unprocessable_entity
+      end
+    end
+
+    def destroy
+      @quiz.destroy
+      redirect_to moderate_root_path, notice: "Quiz deleted.", status: :see_other
+    end
+
+    def preview
+      @preview = QuizPreview.new(@quiz, answers: params[:answers], pick: params[:pick])
+
+      redirect_to preview_moderate_quiz_path(@quiz), status: :see_other unless @preview.valid?
+    end
+
+    # The quiz as JSON in a <pre>, ready to copy (see QuizExport).
+    def export
+      @export_json = QuizExport.new(@quiz).to_pretty_json
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:id])
+    end
+
+    def quiz_params
+      params.fetch(:quiz, {}).permit(:title, :winner_count, :timer_minutes, :timer_seconds)
+    end
+  end
+end
