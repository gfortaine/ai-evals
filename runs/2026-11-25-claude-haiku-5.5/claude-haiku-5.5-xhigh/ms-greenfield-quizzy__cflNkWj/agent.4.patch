+require "test_helper"
+
+# Picking winners after the end: Top N, Draw, Reset winners.
+class GamePrizesTest < ActiveSupport::TestCase
+  OPENED = Time.zone.local(2026, 11, 23, 10, 0, 0)
+
+  setup do
+    @quiz = build_quiz
+    3.times { |i| build_question(@quiz, text: "Question #{i + 1}?", options: [ [ "Right", true ], [ "Wrong", false ] ]) }
+    @game = @quiz.games.create!
+    travel_to(OPENED) { @game.start }
+    @ann = @game.players.create!(name: "Ann")
+    @ben = @game.players.create!(name: "Ben")
+    @cy = @game.players.create!(name: "Cy")
+    @dee = @game.players.create!(name: "Dee")
+    # Points: Ann 3, Ben 2, Cy 1, Dee 0.
+    @answers = {
+      @ann => %w[Right Right Right],
+      @ben => %w[Right Right Wrong],
+      @cy => %w[Right Wrong Wrong],
+      @dee => %w[Wrong Wrong Wrong]
+    }
+    # Questions 1 and 2 are answered and closed. Question 3 is answered but still open.
+    answer_question(1)
+    finish_question(1)
+    next_question(1)
+    answer_question(2)
+    finish_question(2)
+    next_question(2)
+    answer_question(3)
+  end
+
+  teardown { travel_back }
+
+  # Every player answers the question at this position, one second after it opened.
+  def answer_question(position)
+    game_question = @game.game_questions.find_by!(position: position)
+    @answers.each do |player, texts|
+      option = game_question.options.find_by!(text: texts[position - 1])
+      travel_to(game_question.opened_at + 1) { assert player.pick(option) }
+    end
+  end
+
+  def finish_question(position)
+    travel_to(OPENED + position * 10) { assert @game.finish_question }
+  end
+
+  def next_question(position)
+    travel_to(OPENED + position * 10 + 5) { assert @game.next_question }
+  end
+
+  # Closes the last question and ends the quiz.
+  def end_game
+    finish_question(3)
+    travel_to(OPENED + 100) { assert @game.end_quiz }
+    @game.reload
+  end
+
+  def winner_names
+    @game.winners.map(&:name)
+  end
+
+  test "winners can only be picked once the quiz has ended" do
+    refute @game.pick_top_winners
+    assert_includes @game.errors.full_messages, "End the quiz before picking winners."
+
+    refute @game.draw_winners
+    refute @game.reset_winners
+    assert_empty winner_names
+  end
+
+  test "Top N makes the first N players of the leaderboard the winners" do
+    end_game
+
+    assert @game.pick_top_winners
+    assert_equal %w[Ann Ben Cy], winner_names.sort
+  end
+
+  test "Top N uses the number of winners the quiz has now" do
+    end_game
+    @quiz.update!(winner_count: 1)
+
+    assert @game.pick_top_winners
+    assert_equal %w[Ann], winner_names
+  end
+
+  test "Top N never gives a prize to a player with 0 points, even with more prizes than scorers" do
+    @quiz.update!(winner_count: 10)
+    end_game
+
+    assert @game.pick_top_winners
+    refute_includes winner_names, "Dee"
+    assert_equal %w[Ann Ben Cy], winner_names.sort
+  end
+
+  test "Draw: players ahead of the N-th place win, and the N-th place is drawn from its tie" do
+    end_game
+
+    # 2 prizes: the 2nd place is Ben with 2 points. Ann has more, so she wins; Ben is the
+    # only player with exactly 2 points, so he is drawn.
+    @quiz.update!(winner_count: 2)
+    assert @game.draw_winners
+    assert_equal %w[Ann Ben], winner_names.sort
+
+    # 3 prizes: the 3rd place is Cy with 1 point. Ann and Ben are ahead of him.
+    @quiz.update!(winner_count: 3)
+    assert @game.draw_winners
+    assert_equal %w[Ann Ben Cy], winner_names.sort
+  end
+
+  test "Draw with more prizes than scorers gives every scorer a prize and nobody with 0 points" do
+    end_game
+    @quiz.update!(winner_count: 4)
+
+    assert @game.draw_winners
+    assert_equal %w[Ann Ben Cy], winner_names.sort
+  end
+
+  test "each pick replaces the previous winners" do
+    end_game
+    @quiz.update!(winner_count: 3)
+
+    assert @game.pick_top_winners
+    assert_equal %w[Ann Ben Cy], winner_names.sort
+    assert @game.reset_winners
+    assert_empty winner_names
+    assert @game.draw_winners
+    assert_equal %w[Ann Ben Cy], winner_names.sort
+  end
+
+  test "Reset winners removes the winners" do
+    end_game
+    @game.pick_top_winners
+    assert_equal 3, winner_names.size
+
+    assert @game.reset_winners
+    assert_empty winner_names
+  end
+
+  test "a player who lost the prize in a later pick is no longer marked" do
+    @quiz.update!(winner_count: 1)
+    end_game
+    @game.pick_top_winners
+    assert_equal %w[Ann], winner_names
+
+    @quiz.update!(winner_count: 2)
+    @game.pick_top_winners
+    assert_equal %w[Ann Ben], winner_names.sort
+  end
+
+  test "a pick sends one refresh to the big screen and one to the phones" do
+    end_game
+
+    assert_turbo_stream_broadcasts [ @game, :screen ], count: 1 do
+      assert_turbo_stream_broadcasts [ @game, :players ], count: 1 do
+        @game.pick_top_winners
+      end
+    end
+  end
+
+  test "a pick changes the game's version, so the screens fetch the new marks" do
+    end_game
+    before = @game.state_version
+
+    @game.pick_top_winners
+    assert_equal before + 1, @game.state_version
+  end
+end
diff --git a/test/models/leaderboard_test.rb b/test/models/leaderboard_test.rb
new file mode 100644
index 0000000..6dad7ae
--- /dev/null
+++ b/test/models/leaderboard_test.rb
@@ -0,0 +1,247 @@
+require "test_helper"
+
+# Points and speed: the order of the standings, the places, and who may win.
+class LeaderboardTest < ActiveSupport::TestCase
+  OPENED = Time.zone.local(2026, 11, 23, 10, 0, 0)
+
+  setup do
+    @quiz = build_quiz
+    3.times { |i| build_question(@quiz, text: "Question #{i + 1}?", options: [ [ "Right", true ], [ "Wrong", false ] ]) }
+    @game = @quiz.games.create!
+    travel_to(OPENED) { @game.start }
+    @ann = @game.players.create!(name: "Ann")
+    @ben = @game.players.create!(name: "Ben")
+    @cy = @game.players.create!(name: "Cy")
+  end
+
+  teardown { travel_back }
+
+  # Picks the option with this text on the open question, `after` seconds after it opened.
+  def pick(player, text, after:)
+    question = @game.current_game_question
+    option = question.options.find_by!(text: text)
+    travel_to(question.opened_at + after) { assert player.pick(option) }
+  end
+
+  # Finishes the open question at `at` and opens the next one at the same moment.
+  def finish_and_next(at)
+    travel_to(at) do
+      assert @game.finish_question
+      assert @game.next_question
+    end
+  end
+
+  def finish_at(at)
+    travel_to(at) { assert @game.finish_question }
+  end
+
+  def board
+    Leaderboard.new(@game)
+  end
+
+  def order_of(entries)
+    entries.map { |entry| entry.player.name }
+  end
+
+  test "a correct answer is one point, a wrong answer none" do
+    pick(@ann, "Right", after: 1)
+    pick(@ben, "Wrong", after: 1)
+    finish_at(OPENED + 10)
+
+    ann = board.entry_for(@ann)
+    ben = board.entry_for(@ben)
+    assert_equal 1, ann.points
+    assert_equal 0, ben.points
+  end
+
+  test "every joined player is on the board, even without an answer" do
+    pick(@ann, "Right", after: 1)
+    finish_at(OPENED + 10)
+
+    assert_equal 3, board.player_count
+    assert_equal [ "Ann", "Ben", "Cy" ], board.entries.map { |entry| entry.player.name }.sort
+  end
+
+  test "more points rank higher, whatever the speed" do
+    pick(@ben, "Right", after: 0.5)   # fast, one point
+    pick(@ann, "Right", after: 9)     # slow, but Ann also gets the second point
+    pick(@cy, "Wrong", after: 1)
+    finish_and_next(OPENED + 10)
+    pick(@ann, "Right", after: 8)
+    pick(@ben, "Wrong", after: 0.5)
+    pick(@cy, "Wrong", after: 1)
+    finish_at(OPENED + 20)
+
+    assert_equal [ "Ann", "Ben", "Cy" ], order_of(board.entries)
+    assert_equal [ 2, 1, 0 ], board.entries.map(&:points)
+    assert_equal [ 1, 2, 3 ], board.entries.map(&:place)
+  end
+
+  test "equal points: the lower total time of the correct answers ranks higher" do
+    pick(@ann, "Right", after: 1)
+    pick(@cy, "Right", after: 5)
+    finish_and_next(OPENED + 10)
+    pick(@ann, "Right", after: 2)     # Ann: 1 + 2 = 3 seconds
+    pick(@cy, "Right", after: 3)      # Cy: 5 + 3 = 8 seconds
+    finish_at(OPENED + 20)
+
+    assert_equal [ "Ann", "Cy", "Ben" ], order_of(board.entries)
+    assert_equal [ 1, 2, 3 ], board.entries.map(&:place)
+    assert_equal 3_000_000, board.entry_for(@ann).time_us
+    assert_equal 8_000_000, board.entry_for(@cy).time_us
+  end
+
+  test "a wrong pick adds no time, so only the correct answers are timed" do
+    pick(@ben, "Wrong", after: 0.1)
+    pick(@ann, "Right", after: 4)     # Ann: one point, 4 seconds
+    finish_and_next(OPENED + 10)
+    pick(@ben, "Right", after: 2)     # Ben: one point, 2 seconds
+    pick(@ann, "Wrong", after: 1)     # Ann's wrong pick does not change her time
+    finish_at(OPENED + 20)
+
+    assert_equal [ 1, 1 ], [ board.entry_for(@ann).points, board.entry_for(@ben).points ]
+    assert_equal 4_000_000, board.entry_for(@ann).time_us
+    assert_equal 2_000_000, board.entry_for(@ben).time_us
+    assert_equal [ "Ben", "Ann", "Cy" ], order_of(board.entries)
+  end
+
+  test "the time runs to the last pick, not the first" do
+    pick(@ann, "Right", after: 1)
+    pick(@ann, "Wrong", after: 2)
+    pick(@ann, "Right", after: 6)     # the last pick is the one that counts: 6 seconds
+    pick(@ben, "Right", after: 3)
+    finish_at(OPENED + 10)
+
+    assert_equal 6_000_000, board.entry_for(@ann).time_us
+    assert_equal [ "Ben", "Ann", "Cy" ], order_of(board.entries)
+  end
+
+  test "players with exactly the same points and time share a place" do
+    pick(@ann, "Right", after: 2)
+    pick(@ben, "Right", after: 2)
+    pick(@cy, "Right", after: 4)
+    finish_at(OPENED + 10)
+
+    assert_equal [ 1, 1, 3 ], board.entries.map(&:place)
+  end
+
+  test "players with no points share the last place" do
+    @dee = @game.players.create!(name: "Dee")
+    pick(@ann, "Right", after: 1)
+    pick(@ben, "Right", after: 5)
+    pick(@cy, "Wrong", after: 1)
+    finish_at(OPENED + 10)
+
+    assert_equal [ 1, 2, 3, 3 ], board.entries.map(&:place)
+    assert_equal [ 1, 1, 0, 0 ], board.entries.map(&:points)
+    assert_equal "Dee", board.entries.last.player.name
+  end
+
+  test "scoring entries leave out players with no points" do
+    pick(@ann, "Right", after: 1)
+    finish_at(OPENED + 10)
+
+    assert_equal [ "Ann" ], order_of(board.scoring_entries)
+  end
+
+  test "entry_for is nil for someone who never joined this game" do
+    finish_at(OPENED + 10)
+    other = @quiz.games.create!.players.create!(name: "Stranger")
+
+    assert_nil board.entry_for(other)
+  end
+
+  test "top N: the first N players of the leaderboard who have points" do
+    pick(@ann, "Right", after: 1)
+    pick(@ben, "Wrong", after: 0.5)
+    pick(@cy, "Right", after: 5)
+    finish_and_next(OPENED + 10)
+    pick(@ann, "Right", after: 2)
+    pick(@cy, "Right", after: 3)
+    finish_at(OPENED + 20)
+
+    assert_equal [ "Ann" ], board.top_winners(1).map(&:name)
+    assert_equal [ "Ann", "Cy" ], board.top_winners(2).map(&:name)
+    assert_equal [ "Ann", "Cy" ], board.top_winners(3).map(&:name), "Ben has no points and cannot win"
+    assert_equal [ "Ann", "Cy" ], board.top_winners(10).map(&:name)
+  end
+
+  test "top N with nobody scoring gives no winners" do
+    finish_at(OPENED + 10)
+
+    assert_empty board.top_winners(3)
+  end
+
+  # Ann 3 points; Ben, Cy and Dee 2 points each (Ben fastest, then Cy, then Dee);
+  # Eve 1 point. The 3rd place is Cy, so the tie at 2 points is Ben, Cy and Dee.
+  def build_draw_board
+    @dee = @game.players.create!(name: "Dee")
+    @eve = @game.players.create!(name: "Eve")
+    pick(@ann, "Right", after: 1)
+    pick(@ben, "Right", after: 2)
+    pick(@cy, "Right", after: 3)
+    pick(@dee, "Right", after: 4)
+    pick(@eve, "Right", after: 5)
+    finish_and_next(OPENED + 10)
+    pick(@ann, "Right", after: 1)
+    pick(@ben, "Right", after: 2)
+    pick(@cy, "Right", after: 3)
+    pick(@dee, "Right", after: 4)
+    pick(@eve, "Wrong", after: 5)
+    finish_and_next(OPENED + 20)
+    pick(@ann, "Right", after: 1)
+    pick(@ben, "Wrong", after: 2)
+    pick(@cy, "Wrong", after: 3)
+    pick(@dee, "Wrong", after: 4)
+    pick(@eve, "Wrong", after: 5)
+    finish_at(OPENED + 30)
+
+    assert_equal [ [ "Ann", 3 ], [ "Ben", 2 ], [ "Cy", 2 ], [ "Dee", 2 ], [ "Eve", 1 ] ],
+                 board.entries.map { |entry| [ entry.player.name, entry.points ] }
+  end
+
+  test "draw: players ahead of the N-th place always win, the rest come from the tie at that place" do
+    build_draw_board
+
+    seen = Hash.new(0)
+    200.times do
+      winners = board.drawn_winners(3).map(&:name).sort
+      assert_equal 3, winners.size
+      assert_includes winners, "Ann", "Ann has more points than the 3rd place"
+      assert_empty winners - %w[Ann Ben Cy Dee], "Eve has fewer points than the tie and cannot win"
+      winners.each { |name| seen[name] += 1 }
+    end
+    assert_equal 200, seen["Ann"]
+    assert seen["Ben"].positive? && seen["Cy"].positive? && seen["Dee"].positive?,
+           "each player in the tie can be drawn"
+  end
+
+  test "draw with a tie at the 2nd place draws one prize from the tie" do
+    build_draw_board
+
+    results = Set.new
+    200.times { results << board.drawn_winners(2).map(&:name).sort }
+    assert_equal [ %w[Ann Ben], %w[Ann Cy], %w[Ann Dee] ].to_set, results
+  end
+
+  test "draw: speed does not decide the tie, so each of the three possible draws happens" do
+    build_draw_board
+
+    results = Set.new
+    300.times { results << board.drawn_winners(3).map(&:name).sort }
+    assert_equal [ %w[Ann Ben Cy], %w[Ann Ben Dee], %w[Ann Cy Dee] ].to_set, results
+  end
+
+  test "draw: when fewer players have points than prizes, all of them win" do
+    pick(@ann, "Right", after: 1)
+    finish_at(OPENED + 10)
+
+    assert_equal [ "Ann" ], board.drawn_winners(3).map(&:name)
+  end
+
+  test "draw: with no points at all nobody wins" do
+    finish_at(OPENED + 10)
+
+    assert_empty board.drawn_winners(3)
+  end
+end
