index 0000000..1957983
--- /dev/null
+++ b/app/views/moderate/games/_screen.html.erb
@@ -0,0 +1,81 @@
+<%# The big screen. The live controller fetches this partial again when the game changes. %>
+<% game = screen.game %>
+<div id="game-screen" class="game-screen"
+     data-controller="live"
+     data-live-url-value="<%= screen_moderate_game_path(game) %>"
+     data-live-version-value="<%= screen.version %>"
+     data-live-interval-value="3000"
+     data-action="live:refresh->live#refresh">
+
+  <section class="cover <%= { lobby: "", open: "cover--blue", closed: "cover--blue cover--calm", finished: "cover--night" }[screen.phase] %>">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+        <% unless screen.phase == :lobby %><span><%= game.quiz.title %></span><% end %>
+      </div>
+
+      <div class="screen__body">
+        <% if local_assigns[:message].present? %>
+          <p class="errors" role="alert"><%= message %></p>
+        <% end %>
+
+        <% case screen.phase %>
+        <% when :lobby %>
+          <div class="lobby">
+            <div>
+              <h1 class="lobby__title"><%= game.quiz.title %></h1>
+              <p class="lobby__join">Join at</p>
+              <p class="lobby__url"><%= screen.join_url %></p>
+              <span class="counter-pill"><span>Players: <strong><%= screen.players_count %></strong></span></span>
+            </div>
+            <div class="qr" role="img" aria-label="QR code for the join link"><%= qr_code_svg(screen.join_url) %></div>
+          </div>
+
+        <% when :open, :closed %>
+          <div class="stage-question__num">Question <%= screen.position %> of <%= screen.total %></div>
+          <div class="stage-question__body"><%= screen.question.text %></div>
+
+          <ol class="stage-options<%= " stage-options--results" if screen.revealed? %>">
+            <% screen.option_rows.each do |row| %>
+              <li class="stage-option<%= " is-correct" if row.correct %>">
+                <% if screen.revealed? %><span class="stage-option__bar" style="--share: <%= row.share %>%"></span><% end %>
+                <span class="stage-option__letter"><%= option_letter(row.index) %></span>
+                <span class="stage-option__title"><%= row.option.text %></span>
+                <% if screen.revealed? %>
+                  <span class="stage-option__count"><%= pluralize(row.count, "answer") %></span>
+                  <% if row.correct %><span class="stage-option__mark">Correct</span><% end %>
+                <% end %>
+              </li>
+            <% end %>
+          </ol>
+
+          <% if screen.phase == :open %>
+            <p class="answers-counter">Answers: <%= screen.answers_count %> / <%= screen.players_count %></p>
+          <% end %>
+
+        <% when :finished %>
+          <h1 class="stage-finished">The quiz is over</h1>
+        <% end %>
+      </div>
+    </div>
+  </section>
+
+  <nav class="screen-controls" aria-label="Game controls">
+    <span class="screen-controls__info">Game code <%= game.code %></span>
+    <div class="buttons">
+      <% case screen.phase %>
+      <% when :lobby %>
+        <%= button_to "Start", start_moderate_game_path(game), class: "btn btn--pink btn--lg" %>
+      <% when :open %>
+        <%= button_to "Finish", finish_moderate_game_path(game), class: "btn btn--pink btn--lg" %>
+      <% when :closed %>
+        <% if screen.last_question? %>
+          <%= button_to "End quiz", end_quiz_moderate_game_path(game), class: "btn btn--pink btn--lg" %>
+        <% else %>
+          <%= button_to "Next", next_question_moderate_game_path(game), class: "btn btn--pink btn--lg" %>
+        <% end %>
+      <% end %>
+      <%= link_to "Back to quiz", moderate_quiz_path(game.quiz), class: "btn btn--light btn--sm" %>
+    </div>
+  </nav>
+</div>
