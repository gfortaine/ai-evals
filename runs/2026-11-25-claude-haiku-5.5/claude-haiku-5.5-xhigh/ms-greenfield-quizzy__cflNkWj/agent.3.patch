diff --git a/test/integration/moderator_games_test.rb b/test/integration/moderator_games_test.rb
new file mode 100644
index 0000000..7fe105e
--- /dev/null
+++ b/test/integration/moderator_games_test.rb
@@ -0,0 +1,206 @@
+require "test_helper"
+
+class ModeratorGamesTest < ActionDispatch::IntegrationTest
+  TURBO_STREAM = { "Accept" => "text/vnd.turbo-stream.html" }.freeze
+
+  setup do
+    @quiz = build_quiz(title: "Frontend Fest 2026")
+    @first = build_question(@quiz, text: "Largest planet?", options: [ [ "Jupiter", true ], [ "Mars", false ] ])
+    @second = build_question(@quiz, text: "Which protocol?", options: [ [ "WebSocket", true ], [ "FTP", false ] ])
+    build_question(@quiz, text: "Inactive question", active: false)
+  end
+
+  def auth
+    { "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "letmein") }
+  end
+
+  def page
+    Capybara.string(response.body)
+  end
+
+  def start_game
+    post "/moderate/quizzes/#{@quiz.id}/games", headers: auth
+    @game = Game.last
+  end
+
+  test "the quiz page has a Start a game button that creates a game and opens its big screen" do
+    get "/moderate/quizzes/#{@quiz.id}", headers: auth
+    assert page.has_button?("Start a game")
+
+    assert_difference -> { Game.count }, 1 do
+      post "/moderate/quizzes/#{@quiz.id}/games", headers: auth
+    end
+    assert_redirected_to "/moderate/games/#{Game.last.id}"
+  end
+
+  test "the quiz page lists its games, each in its own list item" do
+    start_game
+
+    get "/moderate/quizzes/#{@quiz.id}", headers: auth
+    items = page.all("li.game-item")
+    assert_equal 1, items.size
+    assert items.first.has_link?("Open", href: "/moderate/games/#{@game.id}")
+    assert items.first.has_text?(@game.code)
+    assert items.first.has_text?("Waiting to start")
+  end
+
+  test "a quiz without active questions cannot start a game" do
+    @quiz.questions.update_all(active: false)
+
+    assert_no_difference -> { Game.count } do
+      post "/moderate/quizzes/#{@quiz.id}/games", headers: auth
+    end
+    assert_redirected_to "/moderate/quizzes/#{@quiz.id}"
+  end
+
+  test "the big screen in the lobby shows the title, the join link as text, the QR code and the player count" do
+    start_game
+    @game.players.create!(name: "Alice")
+    @game.players.create!(name: "Bob")
+
+    get "/moderate/games/#{@game.id}", headers: auth
+    assert_response :success
+    assert page.has_text?("Frontend Fest 2026")
+    assert page.has_text?("http://www.example.com/play/#{@game.code}")
+    assert page.has_text?("Players: 2")
+    assert page.has_css?(".qr svg")
+    assert page.has_button?("Start")
+  end
+
+  test "the big screen uses the moderator's layout, not the phone's" do
+    start_game
+
+    get "/moderate/games/#{@game.id}", headers: auth
+    assert page.has_css?("body.big-screen")
+    assert page.has_css?("[data-controller='live'][data-live-url-value='/moderate/games/#{@game.id}/screen']")
+  end
+
+  test "Start shows the first question with its progress and options, and no correct marks" do
+    start_game
+
+    post "/moderate/games/#{@game.id}/start", headers: auth
+    assert_response :redirect
+
+    get "/moderate/games/#{@game.id}", headers: auth
+    assert page.has_text?("Question 1 of 2")
+    assert page.has_text?("Largest planet?")
+    assert page.has_text?("Jupiter")
+    assert page.has_text?("Mars")
+    assert page.has_text?("Answers: 0 / 0")
+    assert page.has_button?("Finish")
+    refute_includes response.body.downcase, "correct"
+  end
+
+  test "Start with the Turbo Stream answer replaces the moderator's screen in place" do
+    start_game
+
+    post "/moderate/games/#{@game.id}/start", headers: auth.merge(TURBO_STREAM)
+
+    assert_response :success
+    assert_equal "text/vnd.turbo-stream.html", response.media_type
+    assert_includes response.body, %(action="replace" target="game-screen")
+    assert_includes response.body, "Largest planet?"
+    assert_includes response.body, "Finish"
+  end
+
+  test "Start is refused with a message when the game has already started" do
+    start_game
+    post "/moderate/games/#{@game.id}/start", headers: auth
+    post "/moderate/games/#{@game.id}/start", headers: auth.merge(TURBO_STREAM)
+
+    assert_response :success
+    assert_includes response.body, "The quiz has already started."
+  end
+
+  test "Finish reveals the answer counts per option and marks the correct options" do
+    start_game
+    post "/moderate/games/#{@game.id}/start", headers: auth
+    alice = @game.players.create!(name: "Alice")
+    alice.pick(@game.reload.current_game_question.options.first)
+
+    post "/moderate/games/#{@game.id}/finish", headers: auth
+    get "/moderate/games/#{@game.id}", headers: auth
+
+    assert page.has_css?("li.stage-option.is-correct", text: "Jupiter")
+    assert page.has_css?(".stage-option__mark", text: "Correct")
+    assert page.has_text?("1 answer")
+    assert page.has_text?("0 answers")
+    assert page.has_button?("Next")
+    refute page.has_text?("Answers:")
+  end
+
+  test "Next opens the next active question, and the last question's button says End quiz" do
+    start_game
+    post "/moderate/games/#{@game.id}/start", headers: auth
+    post "/moderate/games/#{@game.id}/finish", headers: auth
+    post "/moderate/games/#{@game.id}/next_question", headers: auth
+
+    get "/moderate/games/#{@game.id}", headers: auth
+    assert page.has_text?("Question 2 of 2")
+    assert page.has_text?("Which protocol?")
+
+    post "/moderate/games/#{@game.id}/finish", headers: auth
+    get "/moderate/games/#{@game.id}", headers: auth
+    assert page.has_button?("End quiz")
+    refute page.has_button?("Next")
+  end
+
+  test "End quiz ends the game and the big screen says the quiz is over" do
+    start_game
+    post "/moderate/games/#{@game.id}/start", headers: auth
+    post "/moderate/games/#{@game.id}/finish", headers: auth
+    post "/moderate/games/#{@game.id}/next_question", headers: auth
+    post "/moderate/games/#{@game.id}/finish", headers: auth
+    post "/moderate/games/#{@game.id}/end_quiz", headers: auth
+
+    get "/moderate/games/#{@game.id}", headers: auth
+    assert page.has_text?("The quiz is over")
+    refute page.has_button?("Finish")
+    refute page.has_button?("Start")
+    assert_predicate @game.reload, :finished?
+  end
+
+  test "the big screen's own fragment answers 304 when nothing has changed" do
+    start_game
+    get "/moderate/games/#{@game.id}/screen", headers: auth
+    assert_response :success
+    etag = response.headers["ETag"]
+    assert etag.present?
+
+    get "/moderate/games/#{@game.id}/screen", headers: auth.merge("If-None-Match" => etag)
+    assert_response :not_modified
+
+    @game.players.create!(name: "Late")
+    get "/moderate/games/#{@game.id}/screen", headers: auth.merge("If-None-Match" => etag)
+    assert_response :success
+    assert page.text.include?("Players: 1")
+  end
+
+  test "a refused button press on a stale screen shows the reason on the page" do
+    start_game
+    post "/moderate/games/#{@game.id}/start", headers: auth
+    post "/moderate/games/#{@game.id}/next_question", headers: auth.merge(TURBO_STREAM)
+
+    assert_response :success
+    assert_includes response.body, "Finish the question before going on."
+  end
+
+  test "the big screen and its actions need the moderator login" do
+    start_game
+    paths = [
+      [ :get, "/moderate/games/#{@game.id}" ],
+      [ :get, "/moderate/games/#{@game.id}/screen" ],
+      [ :post, "/moderate/games/#{@game.id}/start" ],
+      [ :post, "/moderate/games/#{@game.id}/finish" ],
+      [ :post, "/moderate/games/#{@game.id}/next_question" ],
+      [ :post, "/moderate/games/#{@game.id}/end_quiz" ],
+      [ :post, "/moderate/quizzes/#{@quiz.id}/games" ]
+    ]
+
+    paths.each do |method, path|
+      send(method, path)
+      assert_response :unauthorized, "#{method.upcase} #{path} should need credentials"
+    end
+    assert @game.reload.lobby?, "no request may move the game"
+  end
+end
diff --git a/test/integration/play_test.rb b/test/integration/play_test.rb
new file mode 100644
index 0000000..a076e6a
--- /dev/null
+++ b/test/integration/play_test.rb
@@ -0,0 +1,321 @@
+require "test_helper"
+
+class PlayTest < ActionDispatch::IntegrationTest
+  TURBO_STREAM = { "Accept" => "text/vnd.turbo-stream.html" }.freeze
+
+  setup do
+    @quiz = build_quiz(title: "Frontend Fest 2026")
+    build_question(@quiz, text: "Largest planet?", options: [ [ "Jupiter", true ], [ "Mars", false ] ])
+    build_question(@quiz, text: "Which protocol?", options: [ [ "WebSocket", true ], [ "FTP", false ] ])
+    @game = @quiz.games.create!
+  end
+
+  def moderator
+    { "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "letmein") }
+  end
+
+  def page
+    Capybara.string(response.body)
+  end
+
+  def play_path = "/play/#{@game.code}"
+
+  def join_as(name, session = self)
+    session.post "#{play_path}/join", params: { name: name }
+  end
+
+  def moderate(action)
+    post "/moderate/games/#{@game.id}/#{action}", headers: moderator
+  end
+
+  def option(text)
+    @game.reload.current_game_question.options.find_by!(text: text)
+  end
+
+  test "the join link shows a name form to someone who has not joined" do
+    get play_path
+
+    assert_response :success
+    assert page.has_field?("Your name")
+    assert page.has_button?("Join")
+    assert page.has_text?("Frontend Fest 2026")
+  end
+
+  test "the join link is not case sensitive" do
+    get "/play/#{@game.code.downcase}"
+
+    assert_response :success
+    assert page.has_field?("Your name")
+  end
+
+  test "an unknown code says there is no quiz here" do
+    get "/play/ZZZZZ"
+
+    assert_response :not_found
+    assert page.has_text?("No quiz here")
+  end
+
+  test "joining with a name shows Hi, name and the wait for the start" do
+    join_as("Alice")
+
+    assert_redirected_to play_path
+    follow_redirect!
+    assert page.has_text?("Hi, Alice!")
+    assert page.has_text?("Waiting for the quiz to start")
+    refute page.has_field?("Your name")
+  end
+
+  test "a blank name is refused with a message and nobody joins" do
+    assert_no_difference -> { Player.count } do
+      join_as("   ")
+    end
+
+    assert_response :unprocessable_entity
+    assert page.has_text?("Enter your name")
+    assert page.has_field?("Your name")
+  end
+
+  test "a name that is too long is refused" do
+    assert_no_difference -> { Player.count } do
+      join_as("x" * 41)
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "HTML in a name is shown as text" do
+    join_as("<b>Eve</b>")
+    follow_redirect!
+
+    assert page.has_text?("Hi, <b>Eve</b>!")
+    refute page.has_css?("b")
+  end
+
+  test "the browser keeps its player, so the same link continues the same player" do
+    join_as("Alice")
+
+    get play_path
+    assert page.has_text?("Hi, Alice!")
+
+    assert_no_difference -> { Player.count } do
+      join_as("Someone else")
+    end
+    assert_redirected_to play_path
+    assert_equal [ "Alice" ], @game.players.reload.map(&:name)
+  end
+
+  test "another browser is another player" do
+    join_as("Alice")
+    other = open_session
+    other.get play_path
+    assert_includes other.response.body, "Your name"
+
+    join_as("Bob", other)
+    assert_equal 2, @game.players.count
+  end
+
+  test "players can join in the lobby, during a question, and after it closes" do
+    join_as("Lobby", open_session)
+    moderate("start")
+    join_as("During", open_session)
+    moderate("finish")
+    join_as("Afterwards", open_session)
+
+    assert_equal %w[Lobby During Afterwards], @game.players.reload.map(&:name)
+  end
+
+  test "the join link says the quiz is over and nobody can join after the end" do
+    moderate("start")
+    moderate("finish")
+    moderate("next_question")
+    moderate("finish")
+    moderate("end_quiz")
+
+    get play_path
+    assert page.has_text?("The quiz is over")
+    refute page.has_field?("Your name")
+
+    assert_no_difference -> { Player.count } do
+      join_as("Late")
+    end
+  end
+
+  test "a phone that already joined sees the end" do
+    join_as("Alice")
+    moderate("start")
+    moderate("finish")
+    moderate("next_question")
+    moderate("finish")
+    moderate("end_quiz")
+
+    get play_path
+    assert page.has_text?("The quiz is over")
+  end
+
+  test "an open question shows its text and options as buttons, with no hint of the answer" do
+    join_as("Alice")
+    moderate("start")
+
+    get play_path
+    assert page.has_text?("Largest planet?")
+    assert page.has_button?("Jupiter")
+    assert page.has_button?("Mars")
+    refute_includes response.body.downcase, "correct"
+    refute_includes response.body, "Your answer"
+  end
+
+  test "tapping an option answers at once and marks it as your answer" do
+    join_as("Alice")
+    moderate("start")
+    jupiter = option("Jupiter")
+
+    post "/play/#{@game.code}/answer", params: { option_id: jupiter.id }, headers: TURBO_STREAM
+
+    assert_response :success
+    assert_includes response.body, %(action="replace" target="player-screen")
+    assert_includes response.body, "Your answer"
+    assert_equal jupiter, @game.players.find_by(name: "Alice").answer_for(@game.current_game_question).game_option
+  end
+
+  test "the last tap before the close is the answer that counts" do
+    join_as("Alice")
+    moderate("start")
+
+    post "/play/#{@game.code}/answer", params: { option_id: option("Jupiter").id }
+    post "/play/#{@game.code}/answer", params: { option_id: option("Mars").id }
+
+    assert_equal 1, Answer.count
+    assert_equal option("Mars"), Answer.first.game_option
+  end
+
+  test "after Finish each player sees Correct!, Wrong! or No answer for their own pick" do
+    right, wrong, silent = open_session, open_session, open_session
+    join_as("Right", right)
+    join_as("Wrong", wrong)
+    join_as("Silent", silent)
+    moderate("start")
+    players = @game.players.reload.order(:id).to_a
+    players[0].pick(option("Jupiter"))
+    players[1].pick(option("Mars"))
+    moderate("finish")
+
+    { right => "Correct!", wrong => "Wrong!", silent => "No answer" }.each do |browser, status|
+      browser.get play_path
+      assert_includes browser.response.body, status
+      ([ "Correct!", "Wrong!", "No answer" ] - [ status ]).each do |other|
+        refute_includes browser.response.body, other
+      end
+    end
+  end
+
+  test "the correct answer is revealed only once the question is closed" do
+    join_as("Alice")
+    moderate("start")
+    get play_path
+    refute_includes response.body.downcase, "correct"
+
+    moderate("finish")
+    get play_path
+    assert page.has_css?(".play-option.is-correct", text: "Jupiter")
+  end
+
+  test "a player who never answered sees No answer after the close" do
+    join_as("Silent")
+    moderate("start")
+    moderate("finish")
+
+    get play_path
+    assert page.has_text?("No answer")
+  end
+
+  test "a player who joined after the close sees the closed question and its result" do
+    moderate("start")
+    moderate("finish")
+    join_as("Late")
+
+    get play_path
+    assert page.has_text?("No answer")
+    assert page.has_text?("Largest planet?")
+  end
+
+  test "a pick after the close is refused and says so" do
+    join_as("Alice")
+    moderate("start")
+    jupiter = option("Jupiter")
+    moderate("finish")
+
+    post "/play/#{@game.code}/answer", params: { option_id: jupiter.id }, headers: TURBO_STREAM
+
+    assert_response :success
+    assert_includes response.body, "This question is closed."
+    assert_equal 0, Answer.count
+  end
+
+  test "an option from another game is refused" do
+    join_as("Alice")
+    moderate("start")
+    other_quiz = build_quiz(title: "Elsewhere")
+    build_question(other_quiz, text: "Foreign?", options: [ [ "Yes", true ], [ "No", false ] ])
+    foreign = other_quiz.games.create!
+    foreign.start
+    foreign_option = foreign.current_game_question.options.first
+
+    post "/play/#{@game.code}/answer", params: { option_id: foreign_option.id }, headers: TURBO_STREAM
+
+    assert_includes response.body, "That answer is not part of this question."
+    assert_equal 0, Answer.count
+  end
+
+  test "a phone that has not joined cannot answer" do
+    moderate("start")
+
+    post "/play/#{@game.code}/answer", params: { option_id: option("Jupiter").id }, headers: TURBO_STREAM
+
+    assert_includes response.body, "Join the quiz first."
+    assert_equal 0, Answer.count
+  end
+
+  test "a phone's state fragment answers 304 until its version changes" do
+    join_as("Alice")
+    get "/play/#{@game.code}/state"
+    assert_response :success
+    etag = response.headers["ETag"]
+
+    get "/play/#{@game.code}/state", headers: { "If-None-Match" => etag }
+    assert_response :not_modified
+
+    moderate("start")
+    get "/play/#{@game.code}/state", headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_includes response.body, "Largest planet?"
+  end
+
+  test "a phone's state fragment is personal: it never shows another player's answer" do
+    join_as("Alice")
+    moderate("start")
+    @game.players.find_by(name: "Alice").pick(option("Mars"))
+
+    bob = open_session
+    join_as("Bob", bob)
+    bob.get "/play/#{@game.code}/state"
+
+    assert_includes bob.response.body, "Tap an answer"
+    refute_includes bob.response.body, "Your answer"
+  end
+
+  test "the phone page subscribes to the game's phone stream and points at its own state" do
+    join_as("Alice")
+
+    get play_path
+    assert page.has_css?("turbo-cable-stream-source")
+    assert_includes response.body, "data-live-url-value=\"/play/#{@game.code}/state\""
+  end
+
+  test "a state change sends the refresh signal to the phones once" do
+    join_as("Alice")
+
+    assert_turbo_stream_broadcasts [ @game, :players ], count: 1 do
+      moderate("start")
+    end
+  end
+end
diff --git a/test/models/game_screen_test.rb b/test/models/game_screen_test.rb
new file mode 100644
index 0000000..93432da
--- /dev/null
+++ b/test/models/game_screen_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class GameScreenTest < ActiveSupport::TestCase
+  setup do
+    @quiz = build_quiz(title: "Frontend Fest")
+    build_question(@quiz, text: "Largest planet?", options: [ [ "Jupiter", true ], [ "Mars", false ] ])
+    build_question(@quiz, text: "Second?", options: [ [ "A", false ], [ "B", true ] ])
+    @game = @quiz.games.create!
+    @screen = -> { GameScreen.new(@game.reload, join_url: "http://localhost:3000/play/#{@game.code}") }
+  end
+
+  test "the lobby shows the players waiting, and the join link" do
+    @game.players.create!(name: "Alice")
+    @game.players.create!(name: "Bob")
+
+    assert_equal :lobby, @screen.call.phase
+    assert_equal 2, @screen.call.players_count
+    assert_equal "http://localhost:3000/play/#{@game.code}", @screen.call.join_url
+  end
+
+  test "an open question has no correct flags and counts no answers on the screen" do
+    @game.start
+
+    screen = @screen.call
+    assert_equal :open, screen.phase
+    assert_equal "Largest planet?", screen.question.text
+    assert_equal 1, screen.position
+    assert_equal 2, screen.total
+    assert screen.option_rows.all? { |row| row.correct.nil? }
+    assert_equal [ 0 ], [ screen.answers_count ]
+  end
+
+  test "answers are counted per player for the open question" do
+    alice = @game.players.create!(name: "Alice")
+    bob = @game.players.create!(name: "Bob")
+    @game.players.create!(name: "Cara")
+    @game.start
+    alice.pick(@game.current_game_question.options.first)
+    bob.pick(@game.current_game_question.options.last)
+    bob.pick(@game.current_game_question.options.first)
+
+    screen = @screen.call
+    assert_equal 2, screen.answers_count
+    assert_equal 3, screen.players_count
+  end
+
+  test "once closed, correct options are revealed with the count per option" do
+    alice = @game.players.create!(name: "Alice")
+    @game.start
+    alice.pick(@game.current_game_question.options.first)
+    @game.finish_question
+
+    screen = @screen.call
+    assert_equal :closed, screen.phase
+    jupiter = screen.option_rows.find { |row| row.option.text == "Jupiter" }
+    mars = screen.option_rows.find { |row| row.option.text == "Mars" }
+    assert_equal true, jupiter.correct
+    assert_equal false, mars.correct
+    assert_equal 1, jupiter.count
+    assert_equal 0, mars.count
+    assert_equal 100, jupiter.share
+  end
+
+  test "the last question is recognised so the button can say End quiz" do
+    @game.start
+    @game.finish_question
+    refute @screen.call.last_question?
+
+    @game.next_question
+    @game.finish_question
+    assert @screen.call.last_question?
+  end
+
+  test "after the end the screen says the quiz is over" do
+    @game.start
+    @game.finish_question
+    @game.next_question
+    @game.finish_question
+    @game.end_quiz
+
+    assert_equal :finished, @screen.call.phase
+  end
+
+  test "the version changes with the game, the players and the answers" do
+    version = @screen.call.version
+    @game.players.create!(name: "Late")
+    refute_equal version, @screen.call.version
+
+    @game.start
+    version = @screen.call.version
+    @game.current_game_question.options.first.answers.create!(player: @game.players.first, game_question: @game.current_game_question)
+    refute_equal version, @screen.call.version
+  end
+end
diff --git a/test/models/game_test.rb b/test/models/game_test.rb
new file mode 100644
index 0000000..7b5264a
--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,220 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  setup do
+    @quiz = build_quiz
+    @first = build_question(@quiz, text: "First?", options: [ [ "Yes", true ], [ "No", false ] ])
+    @second = build_question(@quiz, text: "Second?", options: [ [ "A", false ], [ "B", true ] ])
+    @skipped = build_question(@quiz, text: "Skipped?", active: false)
+    @game = @quiz.games.create!
+  end
+
+  test "a new game gets a five character join code from the readable alphabet" do
+    assert_match Game::CODE_FORMAT, @game.code
+    assert_equal 5, @game.code.length
+    refute_match(/[ILO01]/, @game.code)
+  end
+
+  test "each game has its own code, even for the same quiz" do
+    other = @quiz.games.create!
+    refute_equal @game.code, other.code
+  end
+
+  test "a new game is in the lobby with no questions copied yet" do
+    assert @game.lobby?
+    refute @game.running?
+    refute @game.finished?
+    assert_equal 0, @game.total_questions
+    assert_nil @game.current_game_question
+    assert_equal "Waiting to start", @game.status_label
+  end
+
+  test "start copies only the active questions, in order, with their options" do
+    assert @game.start
+
+    assert_equal %w[First? Second?], @game.game_questions.map(&:text)
+    assert_equal [ 1, 2 ], @game.game_questions.map(&:position)
+    assert_equal [ [ "Yes", true ], [ "No", false ] ], @game.game_questions.first.options.map { |o| [ o.text, o.correct ] }
+    assert_equal 1, @game.current_position
+    assert @game.running?
+    assert_equal "Running", @game.status_label
+  end
+
+  test "start opens the first question and nothing else" do
+    @game.start
+
+    assert @game.game_questions.first.open?
+    assert @game.game_questions.second.pending?
+  end
+
+  test "start without any active question is refused and leaves the game in the lobby" do
+    @quiz.questions.update_all(active: false)
+
+    refute @game.start
+    assert_includes @game.errors.full_messages, "Activate at least one question before starting the game."
+    assert @game.lobby?
+    assert_equal 0, @game.game_questions.count
+  end
+
+  test "a game cannot be started twice" do
+    @game.start
+
+    refute @game.start
+    assert_includes @game.errors.full_messages, "The quiz has already started."
+  end
+
+  test "finish closes the open question and next opens the following one" do
+    @game.start
+
+    assert @game.finish_question
+    assert @game.question_closed?
+    assert @game.current_game_question.closed?
+
+    assert @game.next_question
+    assert_equal 2, @game.current_position
+    assert @game.question_open?
+    assert @game.game_questions.first.reload.closed?
+  end
+
+  test "finish is refused when no question is open" do
+    refute @game.finish_question
+    assert_includes @game.errors.full_messages, "Start the quiz first."
+
+    @game.start
+    @game.finish_question
+    refute @game.finish_question
+    assert_includes @game.errors.full_messages, "No question is open."
+  end
+
+  test "next is refused while the question is still open" do
+    @game.start
+
+    refute @game.next_question
+    assert_includes @game.errors.full_messages, "Finish the question before going on."
+    assert_equal 1, @game.current_position
+  end
+
+  test "the last question is ended with end_quiz, not next" do
+    @game.start
+    @game.finish_question
+    @game.next_question
+    @game.finish_question
+
+    assert @game.last_question?
+    refute @game.next_question
+    refute @game.end_quiz.nil?
+    assert @game.finished?
+    assert_equal "Finished", @game.status_label
+  end
+
+  test "end_quiz is refused before the last question is finished" do
+    @game.start
+
+    refute @game.end_quiz
+    assert_includes @game.errors.full_messages, "Finish the question before ending the quiz."
+
+    @game.finish_question
+    refute @game.end_quiz
+    assert_includes @game.errors.full_messages, "There are more questions to show."
+  end
+
+  test "the moderator is told why a button cannot work in the lobby or after the end" do
+    refute @game.finish_question
+    assert_includes @game.errors.full_messages, "Start the quiz first."
+    refute @game.next_question
+    assert_includes @game.errors.full_messages, "Start the quiz first."
+
+    @game.start
+    @game.finish_question
+    @game.next_question
+    @game.finish_question
+    @game.end_quiz
+    refute @game.next_question
+    assert_includes @game.errors.full_messages, "The quiz has ended."
+    refute @game.end_quiz
+    assert_includes @game.errors.full_messages, "The quiz has ended."
+  end
+
+  test "a finished game cannot move on" do
+    @game.start
+    @game.finish_question
+    @game.next_question
+    @game.finish_question
+    @game.end_quiz
+
+    refute @game.finish_question
+    refute @game.next_question
+  end
+
+  test "editing the quiz after the start does not change the running game" do
+    @game.start
+    @first.update!(text: "Changed?")
+    build_question(@quiz, text: "Late addition?")
+
+    assert_equal %w[First? Second?], @game.game_questions.map(&:text)
+  end
+
+  test "every state change bumps the version that live views compare" do
+    version = @game.state_version
+    @game.start
+    assert_operator @game.state_version, :>, version
+
+    version = @game.state_version
+    @game.finish_question
+    assert_operator @game.state_version, :>, version
+  end
+
+  test "a stale moderator click cannot move the game twice" do
+    @game.start
+    stale = Game.find(@game.id)
+
+    assert @game.finish_question
+    assert @game.next_question
+
+    refute stale.finish_question
+    assert_includes stale.errors.full_messages, "No question is open."
+    refute stale.next_question
+    assert_equal 2, @game.reload.current_position
+  end
+
+  test "a double click on Finish closes the question once" do
+    @game.start
+    first_tab = Game.find(@game.id)
+    second_tab = Game.find(@game.id)
+
+    assert first_tab.finish_question
+    refute second_tab.finish_question
+  end
+
+  test "a successful change tells the big screen and the phones to refresh" do
+    assert_turbo_stream_broadcasts [ @game, :screen ], count: 1 do
+      assert_turbo_stream_broadcasts [ @game, :players ], count: 1 do
+        @game.start
+      end
+    end
+  end
+
+  test "a refused change sends no signal" do
+    assert_turbo_stream_broadcasts [ @game, :screen ], count: 0 do
+      @game.finish_question
+    end
+  end
+
+  test "joining is one of the ways a game is found by its code" do
+    assert_equal @game, Game.with_join_code(@game.code.downcase)
+    assert_nil Game.with_join_code("ZZZZZ")
+  end
+
+  test "deleting the quiz deletes its games, players and answers" do
+    @game.start
+    player = @game.players.create!(name: "Alice")
+    player.pick(@game.current_game_question.options.first)
+
+    assert_difference -> { Game.count }, -1 do
+      @quiz.destroy!
+    end
+    assert_equal 0, Player.count
+    assert_equal 0, Answer.count
+    assert_equal 0, GameOption.count
+  end
+end
diff --git a/test/models/player_screen_test.rb b/test/models/player_screen_test.rb
new file mode 100644
