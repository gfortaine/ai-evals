+import { Turbo } from "@hotwired/turbo-rails"
 import "controllers"
+
+// The server signals "live_refresh" for a game region (the big screen, or a
+// phone). The region's live controller then fetches fresh HTML. No game data
+// travels over the socket, so every receiver gets only what its own request may see.
+Turbo.StreamActions.live_refresh = function () {
+  this.targetElements.forEach((element) => element.dispatchEvent(new CustomEvent("live:refresh")))
+}
+
+// A tap or click that never reached the server (crowded Wi-Fi) is reported in the
+// region it came from, not dropped silently. The next live refresh clears it.
+document.addEventListener("turbo:fetch-request-error", (event) => {
+  const source = event.target instanceof Element ? event.target : null
+  const region = source?.closest("[data-controller~='live']")
+  if (!region) return
+
+  const body = region.querySelector(".play__body, .screen__body") || region
+  const notice = document.createElement("p")
+  notice.className = "errors"
+  notice.setAttribute("role", "alert")
+  notice.dataset.connectionError = ""
+  notice.textContent = "No connection. Nothing was sent. Try again."
+  body.prepend(notice)
+})
diff --git a/app/javascript/controllers/live_controller.js b/app/javascript/controllers/live_controller.js
new file mode 100644
index 0000000..c1bef79
--- /dev/null
+++ b/app/javascript/controllers/live_controller.js
@@ -0,0 +1,92 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Keeps one region of the page in step with the game.
+//
+// The server sends a short "live_refresh" signal when something changes (see
+// application.js). The region then fetches its own HTML from `url` and swaps
+// itself in when its version has changed. The server answers 304 when nothing
+// changed, so repeat fetches are cheap.
+//
+// A timer does the same job on a slow beat. Conference Wi-Fi drops sockets
+// without telling anyone, and signals sent while the socket is down are lost;
+// the timer, a return to the tab, or regaining the network makes the region
+// catch up.
+export default class extends Controller {
+  static values = {
+    url: String,
+    version: String,
+    interval: { type: Number, default: 5000 }
+  }
+
+  connect() {
+    this.connected = true
+    this.inFlight = false
+    this.queued = false
+    this.onVisible = () => { if (document.visibilityState === "visible") this.refresh() }
+    this.onOnline = () => this.refresh()
+    document.addEventListener("visibilitychange", this.onVisible)
+    window.addEventListener("online", this.onOnline)
+    this.schedulePoll()
+  }
+
+  disconnect() {
+    this.connected = false
+    clearTimeout(this.pollTimer)
+    clearTimeout(this.debounceTimer)
+    document.removeEventListener("visibilitychange", this.onVisible)
+    window.removeEventListener("online", this.onOnline)
+  }
+
+  // Signals come in bursts (one per answer), so wait a moment and fetch once.
+  refresh() {
+    clearTimeout(this.debounceTimer)
+    this.debounceTimer = setTimeout(() => this.fetchState(), 150)
+  }
+
+  schedulePoll() {
+    clearTimeout(this.pollTimer)
+    // Random jitter keeps a room full of phones from polling in lockstep.
+    const delay = this.intervalValue * (0.75 + Math.random() * 0.5)
+    this.pollTimer = setTimeout(() => this.fetchState(), delay)
+  }
+
+  async fetchState() {
+    if (!this.connected) return
+
+    if (this.inFlight) {
+      this.queued = true
+      return
+    }
+
+    this.inFlight = true
+    try {
+      const response = await fetch(this.urlValue, {
+        headers: { Accept: "text/html" },
+        credentials: "same-origin"
+      })
+
+      if (response.ok && this.connected) {
+        const template = document.createElement("template")
+        template.innerHTML = (await response.text()).trim()
+        const fresh = template.content.firstElementChild
+
+        if (fresh && fresh.getAttribute("data-live-version-value") !== this.versionValue) {
+          // The new element connects its own controller with the new version.
+          this.element.replaceWith(fresh)
+        }
+      }
+    } catch (error) {
+      // Offline or a flaky connection: the next attempt will try again.
+    } finally {
+      this.inFlight = false
+      if (!this.connected) return
+
+      if (this.queued) {
+        this.queued = false
+        this.refresh()
+      } else {
+        this.schedulePoll()
+      }
+    }
+  }
+}
