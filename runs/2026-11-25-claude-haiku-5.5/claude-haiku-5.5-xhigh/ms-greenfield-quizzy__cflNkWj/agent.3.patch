--- /dev/null
+++ b/test/models/player_screen_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class PlayerScreenTest < ActiveSupport::TestCase
+  setup do
+    @quiz = build_quiz(title: "Frontend Fest")
+    build_question(@quiz, text: "Largest planet?", options: [ [ "Jupiter", true ], [ "Mars", false ] ])
+    build_question(@quiz, text: "Second?", options: [ [ "A", false ], [ "B", true ] ])
+    @game = @quiz.games.create!
+    @alice = @game.players.create!(name: "Alice")
+  end
+
+  def screen(player = @alice)
+    PlayerScreen.new(@game.reload, player&.reload)
+  end
+
+  test "someone who has not joined sees the join form, and then the end" do
+    assert_equal :join, screen(nil).phase
+    refute screen(nil).joined?
+
+    @game.start
+    @game.finish_question
+    @game.next_question
+    @game.finish_question
+    @game.end_quiz
+    assert_equal :over, screen(nil).phase
+  end
+
+  test "a joined player waits until the quiz starts" do
+    assert_equal :waiting, screen.phase
+    assert screen.joined?
+  end
+
+  test "an open question offers its options with no correctness" do
+    @game.start
+
+    view = screen
+    assert_equal :open, view.phase
+    assert_equal %w[Jupiter Mars], view.option_rows.map { |row| row.option.text }
+    assert view.option_rows.all? { |row| row.correct.nil? }
+    assert_nil view.picked_option
+  end
+
+  test "a pick is shown on the open question, and the last one counts" do
+    @game.start
+    first, second = @game.current_game_question.options
+    @alice.pick(first)
+    @alice.pick(second)
+
+    view = screen
+    assert_equal second, view.picked_option
+    assert_equal [ false, true ], view.option_rows.map(&:picked)
+  end
+
+  test "a closed question reveals the correct options and reports a right pick" do
+    @game.start
+    @alice.pick(@game.current_game_question.options.first)
+    @game.finish_question
+
+    view = screen
+    assert_equal :closed, view.phase
+    assert_equal :right, view.result
+    assert_equal [ true, false ], view.option_rows.map(&:correct)
+  end
+
+  test "no answer is reported when nothing was picked" do
+    @game.start
+    @game.finish_question
+
+    assert_equal :none, screen.result
+  end
+
+  test "a wrong pick is reported as wrong after the close" do
+    @game.start
+    @alice.pick(@game.current_game_question.options.last)
+    @game.finish_question
+
+    assert_equal :wrong, screen.result
+  end
+
+  test "the join form only changes when the quiz ends" do
+    join_version = screen(nil).version
+    @game.start
+    assert_equal join_version, screen(nil).version
+
+    @game.finish_question
+    @game.next_question
+    @game.finish_question
+    @game.end_quiz
+    refute_equal join_version, screen(nil).version
+  end
+
+  test "joined players get a version that changes with their own answer" do
+    @game.start
+    before = screen.version
+    @alice.pick(@game.current_game_question.options.first)
+
+    refute_equal before, screen.version
+  end
+end
diff --git a/test/models/player_test.rb b/test/models/player_test.rb
new file mode 100644
index 0000000..abf0439
--- /dev/null
+++ b/test/models/player_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class PlayerTest < ActiveSupport::TestCase
+  setup do
+    @quiz = build_quiz
+    build_question(@quiz, text: "First?", options: [ [ "Yes", true ], [ "No", false ] ])
+    build_question(@quiz, text: "Second?", options: [ [ "A", false ], [ "B", true ] ])
+    @game = @quiz.games.create!
+    @game.start
+    @alice = @game.players.create!(name: "  Alice   Liddell ")
+  end
+
+  test "the name is trimmed and squeezed, and every player gets a token" do
+    assert_equal "Alice Liddell", @alice.name
+    assert @alice.token.present?
+    refute_equal @alice.token, @game.players.create!(name: "Bob").token
+  end
+
+  test "a blank name is refused with a plain message" do
+    player = @game.players.new(name: "   ")
+
+    refute player.valid?
+    assert_equal [ "Enter your name" ], player.errors[:name]
+  end
+
+  test "a name longer than the limit is refused" do
+    player = @game.players.new(name: "x" * (Player::NAME_MAX_LENGTH + 1))
+
+    refute player.valid?
+    assert player.errors[:name].any?
+  end
+
+  test "a pick on the open question is saved" do
+    option = @game.current_game_question.options.first
+
+    assert @alice.pick(option)
+    assert_equal option, @alice.answer_for(@game.current_game_question).game_option
+  end
+
+  test "picking again changes the answer, and there is still one row" do
+    question = @game.current_game_question
+    @alice.pick(question.options.first)
+    @alice.pick(question.options.last)
+
+    assert_equal 1, Answer.where(player: @alice, game_question: question).count
+    assert_equal question.options.last, @alice.answer_for(question).game_option
+  end
+
+  test "a pick after the question closed is refused and the old pick stays" do
+    question = @game.current_game_question
+    @alice.pick(question.options.first)
+    @game.finish_question
+
+    refute @alice.pick(question.options.last)
+    assert_includes @alice.errors.full_messages, "This question is closed."
+    assert_equal question.options.first, @alice.answer_for(question).game_option
+  end
+
+  test "an option of an earlier question cannot be picked now" do
+    @game.finish_question
+    @game.next_question
+    old_option = @game.game_questions.first.options.first
+
+    refute @alice.pick(old_option)
+    assert_includes @alice.errors.full_messages, "This question is closed."
+  end
+
+  test "an option from another game is refused" do
+    other_quiz = build_quiz(title: "Other")
+    build_question(other_quiz, text: "Elsewhere?")
+    other_game = other_quiz.games.create!
+    other_game.start
+    foreign = other_game.current_game_question.options.first
+
+    refute @alice.pick(foreign)
+    assert_includes @alice.errors.full_messages, "That answer is not part of this game."
+  end
+
+  test "picks are refused in the lobby and after the end" do
+    lobby_game = @quiz.games.create!
+    lobby_player = lobby_game.players.create!(name: "Early")
+    lobby_game.start
+    lobby_game.players.create!(name: "Late")
+    lobby_option = @game.current_game_question.options.first
+    refute lobby_player.pick(lobby_option)
+
+    @game.finish_question
+    @game.next_question
+    @game.finish_question
+    @game.end_quiz
+    refute @alice.pick(@game.game_questions.last.options.first)
+    assert_includes @alice.errors.full_messages, "This question is closed."
+  end
+
+  test "a successful pick tells the big screen to refresh" do
+    option = @game.current_game_question.options.first
+
+    assert_turbo_stream_broadcasts [ @game, :screen ], count: 1 do
+      @alice.pick(option)
+    end
+  end
+end
