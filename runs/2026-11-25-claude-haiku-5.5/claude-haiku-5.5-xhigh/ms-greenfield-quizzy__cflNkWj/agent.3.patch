@@ -0,0 +1,9 @@
+# An option of a game question. `correct` is only shown to players and on the
+# big screen after the question has closed (see GameScreen and PlayerScreen).
+class GameOption < ApplicationRecord
+  belongs_to :game_question, inverse_of: :options
+  has_many :answers, dependent: :destroy
+
+  validates :text, presence: true
+  validates :position, numericality: { only_integer: true, greater_than: 0 }
+end
