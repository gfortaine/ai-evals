diff --git a/test/models/board/publication_test.rb b/test/models/board/publication_test.rb
new file mode 100644
index 0000000..729efd0
--- /dev/null
+++ b/test/models/board/publication_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Board::PublicationTest < ActiveSupport::TestCase
+  test "publish creates a publication with a random key" do
+    board = boards(:writebook)
+
+    board.publish
+
+    assert board.published?
+    assert_predicate board.publication.key, :present?
+    assert_equal accounts("37s"), board.publication.account
+  end
+
+  test "publish is idempotent" do
+    board = boards(:writebook)
+    board.publish
+    key = board.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      board.publish
+    end
+
+    assert_equal key, board.publication.key
+  end
+
+  test "unpublish removes the publication" do
+    board = boards(:writebook)
+    board.publish
+
+    board.unpublish
+
+    assert_not board.published?
+    assert_nil board.publication
+    assert_not Board::Publication.exists?(board: board)
+  end
+
+  test "publishing and unpublishing touch the in-memory board so cached representations are refreshed" do
+    board = boards(:writebook)
+
+    travel_to 1.minute.from_now do
+      board.publish
+      assert_equal Time.current, board.updated_at
+    end
+
+    travel_to 2.minutes.from_now do
+      board.unpublish
+      assert_equal Time.current, board.updated_at
+    end
+  end
+
+  test "keys are unique" do
+    boards(:writebook).publish
+    duplicate = Board::Publication.new(account: accounts("37s"), board: boards(:private), key: boards(:writebook).publication.key)
+
+    assert_raises(ActiveRecord::RecordNotUnique) { duplicate.save! }
+  end
+
+  test "destroying the board removes its publication" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      board.destroy!
+    end
+  end
+
+  test "to_param is the key" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_equal board.publication.key, board.publication.to_param
+  end
+end
