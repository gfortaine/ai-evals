diff --git a/test/test_helpers/caching_test_helper.rb b/test/test_helpers/caching_test_helper.rb
index 90dab64..50c1ed9 100644
--- a/test/test_helpers/caching_test_helper.rb
+++ b/test/test_helpers/caching_test_helper.rb
@@ -11,4 +11,17 @@ module CachingTestHelper
       ApplicationController.perform_caching = was_perform_caching
     end
   end
+
+  def with_json_fragment_caching
+    was_cache = Rails.cache
+    was_perform_caching = ApplicationController.perform_caching
+    begin
+      Rails.cache = ActiveSupport::Cache::MemoryStore.new
+      ApplicationController.perform_caching = true
+      yield
+    ensure
+      Rails.cache = was_cache
+      ApplicationController.perform_caching = was_perform_caching
+    end
+  end
 end
