+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to @board.name, public_board_path(@publication), class: "btn txt-small" %>
+  </div>
+<% end %>
+
+<article class="panel panel--wide flex flex-column gap margin-block">
+  <header class="flex flex-column gap-half">
+    <p class="txt-small txt-subtle margin-none">
+      #<%= @card.number %><% if @card.column %> in <%= @card.column.name %><% end %>
+    </p>
+    <h1 class="txt-x-large font-weight-black margin-none"><%= card_html_title(@card) %></h1>
+  </header>
+
+  <% if @card.image.attached? %>
+    <%= image_tag @card.image, class: "full-width" %>
+  <% end %>
+
+  <% if @card.description.present? %>
+    <div class="lexxy-content">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <% if @card.tags.any? %>
+    <p class="txt-small margin-none"><%= @card.tags.map(&:title).to_sentence %></p>
+  <% end %>
+
+  <% if @card.steps.any? %>
+    <ul class="flex flex-column gap-half margin-none">
+      <% @card.steps.each do |step| %>
+        <li class="flex gap-half align-center">
+          <input type="checkbox" class="checkbox" disabled <%= "checked" if step.completed? %>>
+          <span><%= step.content %></span>
+        </li>
+      <% end %>
+    </ul>
+  <% end %>
+</article>
