+require "test_helper"
+
+class Admin::Accounts::OverridesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "staff can override card count and bytes used" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_override_path(@account), params: { limit_override: { card_count: "12", bytes_used: "2147483648" } }
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: "")
+    override = @account.reload.limit_override
+    assert_equal 12, override.card_count
+    assert_equal 2.gigabytes, override.bytes_used
+  end
+
+  test "a blank field leaves that figure alone" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_override_path(@account), params: { limit_override: { card_count: "12", bytes_used: "" } }
+    end
+
+    override = @account.reload.limit_override
+    assert_equal 12, override.card_count
+    assert_nil override.bytes_used
+  end
+
+  test "overriding with nothing is refused" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_override_path(@account), params: { limit_override: { card_count: "", bytes_used: "" } }
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: "")
+    assert_match(/Enter a card count, bytes used, or both/, flash[:alert])
+    assert_nil @account.reload.limit_override
+  end
+
+  test "negative figures are refused" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_override_path(@account), params: { limit_override: { card_count: "-1", bytes_used: "" } }
+    end
+
+    assert_nil @account.reload.limit_override
+  end
+
+  test "reset drops the override" do
+    sign_in_as :david
+    @account.override_limits(card_count: 12, bytes_used: 1)
+
+    untenanted do
+      delete saas.admin_account_override_path(@account)
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: "")
+    assert_nil @account.reload.limit_override
+  end
+
+  test "non-staff can't override limits" do
+    sign_in_as :jz
+
+    untenanted do
+      post saas.admin_account_override_path(@account), params: { limit_override: { card_count: "12" } }
+    end
+
+    assert_response :forbidden
+    assert_nil @account.reload.limit_override
+  end
+end
