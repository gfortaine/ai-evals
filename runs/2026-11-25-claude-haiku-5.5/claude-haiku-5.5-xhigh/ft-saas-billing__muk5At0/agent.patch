+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,144 @@
+require "test_helper"
+require_relative "../../test_helpers/stripe_test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts without a subscription or comp are on the Free plan" do
+    assert_equal Plan::FREE, @account.plan
+    assert_not @account.comped?
+    assert_nil @account.active_subscription
+  end
+
+  test "comping an account gives it the Unlimited allowances" do
+    @account.comp
+
+    assert @account.comped?
+    assert_equal Plan::UNLIMITED, @account.plan
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "comp and uncomp are idempotent" do
+    @account.comp
+    assert_no_difference -> { Account::Comp.count } do
+      @account.comp
+    end
+
+    @account.uncomp
+    @account.uncomp
+
+    assert_not @account.reload.comped?
+    assert_equal Plan::FREE, @account.plan
+  end
+
+  test "the comped setter follows comp and uncomp" do
+    @account.comped = true
+    assert @account.comped?
+
+    @account.comped = false
+    assert_not @account.reload.comped?
+  end
+
+  test "an active subscription sets the plan even when the account is comped" do
+    with_stripe_prices do
+      AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account, price_id: UNLIMITED_PLUS_PRICE_ID), event_at: Time.current)
+    end
+    @account.comp
+
+    assert_equal Plan::UNLIMITED_PLUS, @account.reload.plan
+  end
+
+  test "a canceled subscription doesn't keep the paid plan" do
+    with_stripe_prices do
+      AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account, status: "canceled"), event_at: Time.current)
+    end
+
+    assert_nil @account.reload.active_subscription
+    assert_equal Plan::FREE, @account.plan
+  end
+
+  test "overriding limits stores both figures, and reset drops them" do
+    @account.override_limits(card_count: 3, bytes_used: 2.gigabytes)
+
+    assert_equal 3, @account.card_count
+    assert_equal 2.gigabytes, @account.bytes_used
+
+    @account.reset_limit_override
+
+    assert_equal @account.cards_count, @account.card_count
+    assert_equal 0, @account.bytes_used
+    assert_nil @account.reload.limit_override
+  end
+
+  test "an override can set one figure and leave the other as it is" do
+    @account.override_limits(card_count: 3)
+
+    assert_equal 3, @account.card_count
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "cancelling the account cancels its Stripe subscription" do
+    with_stripe_prices do
+      AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account), event_at: Time.current)
+    end
+
+    Stripe::Subscription.expects(:cancel).with("sub_test_123").once
+
+    @account.cancel!
+
+    assert @account.reload.cancelled?
+    assert_equal "canceled", @account.subscription.status
+    assert_equal Plan::FREE, @account.plan
+  end
+
+  test "cancelling an account without a subscription doesn't touch Stripe" do
+    Stripe::Subscription.expects(:cancel).never
+
+    @account.cancel!
+
+    assert @account.reload.cancelled?
+  end
+
+  test "cancelling an account whose subscription Stripe no longer has still cancels the account" do
+    with_stripe_prices do
+      AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account), event_at: Time.current)
+    end
+
+    Stripe::Subscription.stubs(:cancel).raises(Stripe::InvalidRequestError.new("No such subscription", nil, code: "resource_missing"))
+
+    @account.cancel!
+
+    assert @account.reload.cancelled?
+  end
+
+  test "a Stripe failure stops the account from being cancelled" do
+    with_stripe_prices do
+      AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account), event_at: Time.current)
+    end
+
+    Stripe::Subscription.stubs(:cancel).raises(Stripe::APIConnectionError.new("Stripe is down"))
+
+    assert_raises(Stripe::APIConnectionError) { @account.cancel! }
+
+    assert_not @account.reload.cancelled?
+    assert_equal "active", @account.subscription.status
+  end
+
+  test "incinerating an account cancels its Stripe subscription" do
+    with_stripe_prices do
+      AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account), event_at: Time.current)
+    end
+
+    Stripe::Subscription.expects(:cancel).with("sub_test_123").once
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_equal 0, AccountSubscription.where(stripe_subscription_id: "sub_test_123").count
+  end
+end
diff --git a/saas/test/models/account/card_limited_test.rb b/saas/test/models/account/card_limited_test.rb
