index 0000000..c7693d8
--- /dev/null
+++ b/saas/app/views/account/settings/_plan.html.erb
@@ -0,0 +1,43 @@
+<% if Current.user.admin? %>
+  <% plan = account.plan %>
+  <% subscription = account.active_subscription %>
+  <% purchasable_plans = Plan::PAID.select(&:purchasable?) %>
+
+  <section class="settings__section">
+    <header>
+      <h2 class="divider">Plan</h2>
+      <div>
+        <strong><%= plan.name %></strong>
+        <% if plan.paid? && subscription %>
+          &middot; <%= plan.price_label %>
+        <% elsif account.comped? %>
+          <span class="txt-ink-medium">(complimentary)</span>
+        <% end %>
+      </div>
+      <div class="txt-ink-medium">
+        <%= plan.unlimited_cards? ? "Unlimited cards" : "#{number_with_delimiter(plan.card_limit)} cards" %>
+        &middot; <%= number_to_human_size(account.storage_limit) %> storage
+      </div>
+      <div class="txt-small txt-ink-medium">
+        <% if account.card_limit %>
+          <%= number_with_delimiter(account.card_count) %> of <%= number_with_delimiter(account.card_limit) %> cards used &middot;
+        <% end %>
+        <%= number_to_human_size(account.bytes_used) %> of <%= number_to_human_size(account.storage_limit) %> storage used
+      </div>
+      <% if subscription&.cancel_at %>
+        <div class="txt-small txt-ink-medium">Cancels on <%= subscription.cancel_at.to_date.to_fs(:long) %></div>
+      <% elsif subscription&.current_period_end %>
+        <div class="txt-small txt-ink-medium">Renews on <%= subscription.current_period_end.to_date.to_fs(:long) %></div>
+      <% end %>
+    </header>
+
+    <% if subscription %>
+      <%= button_to "Manage billing", saas.account_billing_portal_path(script_name: Current.account.slug), method: :post, class: "btn", form: { data: { turbo: false } } %>
+    <% elsif !account.comped? && purchasable_plans.any? %>
+      <%= form_with url: saas.account_upgrade_path(script_name: Current.account.slug), method: :post, class: "flex gap-half", data: { turbo: false } do |form| %>
+        <%= select_tag :plan, options_for_select(purchasable_plans.map { |candidate| [ "#{candidate.name} (#{candidate.price_label})", candidate.key ] }), class: "input" %>
+        <%= form.submit "Upgrade", class: "btn" %>
+      <% end %>
+    <% end %>
+  </section>
+<% end %>
