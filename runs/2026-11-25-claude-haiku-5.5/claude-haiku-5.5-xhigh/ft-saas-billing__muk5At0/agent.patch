diff --git a/saas/test/controllers/account/billing_portals_controller_test.rb b/saas/test/controllers/account/billing_portals_controller_test.rb
new file mode 100644
index 0000000..7b8b870
--- /dev/null
+++ b/saas/test/controllers/account/billing_portals_controller_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+require_relative "../../test_helpers/stripe_test_helper"
+
+class Account::BillingPortalsControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "an admin with a subscription is sent to the customer portal" do
+    sign_in_as :mike
+
+    with_stripe_prices do
+      AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account), event_at: Time.current)
+
+      Stripe::BillingPortal::Session.expects(:create).with(
+        has_entries(customer: "cus_test_123")
+      ).returns(stub(url: "https://billing.stripe.test/p/session/test"))
+
+      post saas.account_billing_portal_path(script_name: @account.slug)
+    end
+
+    assert_redirected_to "https://billing.stripe.test/p/session/test"
+  end
+
+test "a Stripe outage sends the admin back to settings with a message" do
+  sign_in_as :mike
+
+  with_stripe_prices do
+    AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account), event_at: Time.current)
+    Stripe::BillingPortal::Session.stubs(:create).raises(Stripe::APIConnectionError.new("Stripe is down"))
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+  end
+
+  assert_redirected_to account_settings_path(script_name: @account.slug)
+  assert_match(/couldn't reach our payment provider/, flash[:alert])
+end
+
+  test "an account without a Stripe customer has nothing to manage" do
+    sign_in_as :mike
+
+    Stripe::BillingPortal::Session.expects(:create).never
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+  end
+
+  test "non-admins can't open the portal" do
+    sign_in_as :mike
+    users(:mike).update!(role: :member)
+
+    Stripe::BillingPortal::Session.expects(:create).never
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_response :forbidden
+  end
+end
