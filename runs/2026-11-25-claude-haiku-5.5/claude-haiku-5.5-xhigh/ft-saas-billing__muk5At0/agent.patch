diff --git a/saas/app/controllers/stripe_webhooks_controller.rb b/saas/app/controllers/stripe_webhooks_controller.rb
new file mode 100644
index 0000000..ee6583e
--- /dev/null
+++ b/saas/app/controllers/stripe_webhooks_controller.rb
@@ -0,0 +1,30 @@
+# Receives subscription changes from Stripe. Requests are authenticated by
+# signature rather than by session or CSRF token, so this controller doesn't
+# inherit ApplicationController.
+class StripeWebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  HANDLED_EVENT_TYPES = %w[
+    customer.subscription.created
+    customer.subscription.updated
+    customer.subscription.deleted
+  ].freeze
+
+  def create
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"].to_s, webhook_secret)
+
+    if HANDLED_EVENT_TYPES.include?(event.type)
+      result = AccountSubscription.sync_from_stripe(event.data.object, event_at: Time.at(event.created))
+      Rails.logger.info "[Stripe] #{event.type} #{event.id}: #{result}"
+    end
+
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def webhook_secret
+      ENV.fetch("STRIPE_WEBHOOK_SECRET")
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..1ca730e
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,69 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "AccountSubscription", dependent: :destroy
+    has_one :comp_record, class_name: "Account::Comp", dependent: :destroy
+    has_one :limit_override, class_name: "Account::LimitOverride", dependent: :destroy
+
+    # A cancelled or incinerated account must not keep billing.
+    set_callback :cancel, :before, :cancel_stripe_subscription
+    set_callback :incinerate, :before, :cancel_stripe_subscription
+  end
+
+  def plan
+    if active_subscription
+      active_subscription.plan
+    elsif comped?
+      Plan::UNLIMITED
+    else
+      Plan::FREE
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.entitled?
+  end
+
+  def comped?
+    comp_record.present?
+  end
+
+  def comp
+    create_comp_record! unless comped?
+  end
+
+  def uncomp
+    comp_record&.destroy!
+    association(:comp_record).reset
+  end
+
+  # Queenbee-facing setter, kept so that callers which set `comped` still work.
+  def comped=(value)
+    value ? comp : uncomp
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    override = limit_override || build_limit_override
+    override.update!(card_count: card_count, bytes_used: bytes_used)
+  end
+
+  def reset_limit_override
+    limit_override&.destroy!
+    association(:limit_override).reset
+  end
+
+  private
+    def cancel_stripe_subscription
+      return unless active_subscription
+
+      begin
+        Stripe::Subscription.cancel(subscription.stripe_subscription_id)
+      rescue Stripe::InvalidRequestError => error
+        # Already gone on Stripe's side; nothing left to cancel.
+        raise unless error.code == "resource_missing"
+      end
+
+      subscription.update!(status: "canceled")
+    end
+end
diff --git a/saas/app/models/account/card_limited.rb b/saas/app/models/account/card_limited.rb
new file mode 100644
index 0000000..38d6523
--- /dev/null
+++ b/saas/app/models/account/card_limited.rb
@@ -0,0 +1,28 @@
+# Free accounts can hold up to Plan#card_limit cards. Paid plans have no card
+# limit. The count is the account's cards_count (which is also what the admin
+# stats report as the card count) unless support has overridden it.
+module Account::CardLimited
+  extend ActiveSupport::Concern
+
+  NEARING_CARD_LIMIT_THRESHOLD = 100
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def card_count
+    limit_override&.card_count || cards_count
+  end
+
+  def cards_left
+    card_limit - card_count if card_limit
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && !exceeding_card_limit? && cards_left <= NEARING_CARD_LIMIT_THRESHOLD
+  end
+end
