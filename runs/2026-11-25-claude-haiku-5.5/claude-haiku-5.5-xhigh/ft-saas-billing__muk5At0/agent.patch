diff --git a/saas/test/models/account_subscription_test.rb b/saas/test/models/account_subscription_test.rb
new file mode 100644
index 0000000..2e5ecc5
--- /dev/null
+++ b/saas/test/models/account_subscription_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+require_relative "../test_helpers/stripe_test_helper"
+
+class AccountSubscriptionTest < ActiveSupport::TestCase
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "a created subscription sets the account's plan" do
+    with_stripe_prices do
+      result = AccountSubscription.sync_from_stripe(
+        stripe_subscription_object(account: @account, price_id: UNLIMITED_PLUS_PRICE_ID),
+        event_at: Time.current
+      )
+
+      assert_equal :synced, result
+    end
+
+    subscription = @account.reload.subscription
+    assert_equal "unlimited_plus", subscription.plan_key
+    assert_equal "cus_test_123", subscription.stripe_customer_id
+    assert_equal "sub_test_123", subscription.stripe_subscription_id
+    assert_equal Plan::UNLIMITED_PLUS, @account.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert_nil @account.card_limit
+  end
+
+  test "an update to an existing subscription changes it in place" do
+    with_stripe_prices do
+      AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account), event_at: 2.minutes.ago)
+      AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account, price_id: UNLIMITED_PLUS_PRICE_ID), event_at: Time.current)
+    end
+
+    assert_equal 1, AccountSubscription.where(account: @account).count
+    assert_equal "unlimited_plus", @account.reload.subscription.plan_key
+  end
+
+test "the renewal date comes from the subscription item when Stripe has moved it there" do
+  object = stripe_subscription_object(account: accounts(:initech))
+  object[:current_period_end] = nil
+  object[:items][:data].first[:current_period_end] = 3.weeks.from_now.to_i
+
+  with_stripe_prices do
+    AccountSubscription.sync_from_stripe(object, event_at: Time.current)
+  end
+
+  assert_in_delta 3.weeks.from_now.to_i, accounts(:initech).reload.subscription.current_period_end.to_i, 1
+end
+
+  test "events for accounts we don't know about are ignored" do
+    with_stripe_prices do
+      result = AccountSubscription.sync_from_stripe(
+        stripe_subscription_object(account: @account, metadata: { account_id: "999999999" }),
+        event_at: Time.current
+      )
+
+      assert_equal :unknown_account, result
+    end
+
+    assert_equal 0, AccountSubscription.count
+  end
+
+  test "events for prices we don't sell are ignored" do
+    with_stripe_prices do
+      result = AccountSubscription.sync_from_stripe(
+        stripe_subscription_object(account: @account, price_id: "price_legacy"),
+        event_at: Time.current
+      )
+
+      assert_equal :unknown_price, result
+    end
+
+    assert_equal 0, AccountSubscription.count
+  end
+
+  test "an event older than the last one applied is ignored" do
+    with_stripe_prices do
+      AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account, status: "canceled"), event_at: Time.current)
+
+      result = AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account, status: "active"), event_at: 1.hour.ago)
+
+      assert_equal :stale, result
+    end
+
+    assert_equal "canceled", @account.reload.subscription.status
+  end
+
+  test "an event for a subscription we already know about is matched without account metadata" do
+    with_stripe_prices do
+      AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account), event_at: 1.minute.ago)
+
+      result = AccountSubscription.sync_from_stripe(
+        stripe_subscription_object(account: @account, metadata: {}, status: "past_due"),
+        event_at: Time.current
+      )
+
+      assert_equal :synced, result
+    end
+
+    assert_equal "past_due", @account.reload.subscription.status
+  end
+
+  test "only some statuses keep paid features on" do
+    subscription = AccountSubscription.new(status: "active")
+    assert subscription.entitled?
+    assert AccountSubscription.new(status: "trialing").entitled?
+    assert AccountSubscription.new(status: "past_due").entitled?
+
+    %w[ canceled incomplete incomplete_expired unpaid paused ].each do |status|
+      assert_not AccountSubscription.new(status: status).entitled?, status
+    end
+  end
+end
