@@ -0,0 +1,39 @@
+class Account::UpgradesController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = Plan::PAID.find { |candidate| candidate.key == params[:plan] }
+    return head :bad_request unless plan
+
+    if Current.account.active_subscription
+      redirect_to account_settings_path, alert: "This account already has a subscription. Manage it from billing."
+    elsif !plan.purchasable?
+      redirect_to account_settings_path, alert: "#{plan.name} isn't available to buy right now."
+    else
+      start_checkout(plan)
+    end
+  end
+
+  private
+    def start_checkout(plan)
+      session = Stripe::Checkout::Session.create(checkout_params(plan))
+      redirect_to session.url, allow_other_host: true
+    rescue Stripe::StripeError
+      redirect_to account_settings_path, alert: "We couldn't reach our payment provider. Please try again."
+    end
+
+    def checkout_params(plan)
+      subscription = Current.account.subscription
+
+      {
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        client_reference_id: Current.account.external_account_id.to_s,
+        customer: subscription&.stripe_customer_id,
+        customer_email: (Current.identity.email_address unless subscription),
+        subscription_data: { metadata: { account_id: Current.account.external_account_id.to_s } },
+        success_url: account_settings_url,
+        cancel_url: account_settings_url
+      }.compact
+    end
+end
