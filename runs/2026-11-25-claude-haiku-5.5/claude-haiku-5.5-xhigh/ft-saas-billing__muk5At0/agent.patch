+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Plan</h2>
+    </header>
+
+    <dl class="margin-block-half txt-small">
+      <dt class="txt-ink-medium">Account</dt>
+      <dd>#<%= @account.external_account_id %></dd>
+
+      <dt class="txt-ink-medium">Plan</dt>
+      <dd>
+        <strong><%= plan.name %></strong>
+        <%= "(comped)" if @account.comped? %>
+        <%= "(subscribed)" if @account.active_subscription %>
+      </dd>
