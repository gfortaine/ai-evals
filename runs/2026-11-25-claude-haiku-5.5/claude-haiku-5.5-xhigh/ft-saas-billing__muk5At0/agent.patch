@@ -0,0 +1,19 @@
+class Account::BillingPortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    if subscription = Current.account.subscription
+      open_portal(subscription)
+    else
+      redirect_to account_settings_path, alert: "There's no billing to manage for this account yet."
+    end
+  end
+
+  private
+    def open_portal(subscription)
+      session = Stripe::BillingPortal::Session.create(customer: subscription.stripe_customer_id, return_url: account_settings_url)
+      redirect_to session.url, allow_other_host: true
+    rescue Stripe::StripeError
+      redirect_to account_settings_path, alert: "We couldn't reach our payment provider. Please try again."
+    end
+end
diff --git a/saas/app/controllers/account/upgrades_controller.rb b/saas/app/controllers/account/upgrades_controller.rb
new file mode 100644
index 0000000..91a24e0
