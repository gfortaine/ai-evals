+class Admin::Accounts::OverridesController < AdminController
+  before_action :set_account
+
+  def create
+    @account.override_limits(**override_params)
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden for #{@account.name}"
+  rescue ActiveRecord::RecordInvalid => error
+    redirect_to saas.admin_account_path(@account), alert: error.record.errors.full_messages.to_sentence
+  end
+
+  def destroy
+    @account.reset_limit_override
+    redirect_to saas.admin_account_path(@account), notice: "Overrides reset for #{@account.name}"
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:account_id])
+    end
+
+    def override_params
+      params.expect(limit_override: %i[ card_count bytes_used ]).to_h.symbolize_keys.transform_values(&:presence)
+    end
+end
