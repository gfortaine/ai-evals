+require "test_helper"
+require_relative "../test_helpers/stripe_test_helper"
+
+class StripeWebhooksControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "a created subscription puts the account on the plan it bought" do
+    with_stripe_prices do
+      post_stripe_event stripe_event(type: "customer.subscription.created", object: stripe_subscription_object(account: @account, price_id: UNLIMITED_PLUS_PRICE_ID))
+    end
+
+    assert_response :ok
+    assert_equal Plan::UNLIMITED_PLUS, @account.reload.plan
+  end
+
+  test "a deleted subscription puts the account back on Free" do
+    with_stripe_prices do
+      post_stripe_event stripe_event(type: "customer.subscription.created", object: stripe_subscription_object(account: @account))
+      post_stripe_event stripe_event(type: "customer.subscription.deleted", object: stripe_subscription_object(account: @account, status: "canceled"))
+    end
+
+    assert_response :ok
+    assert_equal Plan::FREE, @account.reload.plan
+  end
+
+  test "an updated subscription is applied" do
+    with_stripe_prices do
+      post_stripe_event stripe_event(type: "customer.subscription.updated", object: stripe_subscription_object(account: @account, status: "past_due"))
+    end
+
+    assert_response :ok
+    assert_equal "past_due", @account.reload.subscription.status
+    assert_equal Plan::UNLIMITED, @account.plan
+  end
+
+  test "a payload with a bad signature is refused and changes nothing" do
+    with_stripe_prices do
+      payload = stripe_event(type: "customer.subscription.created", object: stripe_subscription_object(account: @account)).to_json
+
+      post_stripe_webhook payload, signature_header: stripe_signature_header(payload, secret: "whsec_wrong")
+    end
+
+    assert_response :bad_request
+    assert_nil @account.reload.subscription
+  end
+
+test "a payload changed after signing is refused" do
+  with_stripe_prices do
+    payload = stripe_event(type: "customer.subscription.created", object: stripe_subscription_object(account: @account)).to_json
+    header = stripe_signature_header(payload)
+    tampered = payload.sub(UNLIMITED_PRICE_ID, UNLIMITED_PLUS_PRICE_ID)
+
+    post_stripe_webhook tampered, signature_header: header
+  end
+
+  assert_response :bad_request
+  assert_nil @account.reload.subscription
+end
+
+  test "a request without a signature is refused" do
+    with_stripe_prices do
+      post_stripe_webhook stripe_event(type: "customer.subscription.created", object: stripe_subscription_object(account: @account)).to_json,
+        signature_header: nil
+    end
+
+    assert_response :bad_request
+    assert_nil @account.reload.subscription
+  end
+
+  test "a signature from too long ago is refused" do
+    with_stripe_prices do
+      payload = stripe_event(type: "customer.subscription.created", object: stripe_subscription_object(account: @account)).to_json
+
+      post_stripe_webhook payload, signature_header: stripe_signature_header(payload, timestamp: 1.hour.ago.to_i)
+    end
+
+    assert_response :bad_request
+  end
+
+  test "event types we don't handle are acknowledged and ignored" do
+    with_stripe_prices do
+      post_stripe_event stripe_event(type: "invoice.paid", object: { id: "in_test" })
+    end
+
+    assert_response :ok
+    assert_nil @account.reload.subscription
+  end
+
+  test "events for unknown accounts are acknowledged and ignored" do
+    with_stripe_prices do
+      post_stripe_event stripe_event(type: "customer.subscription.created", object: stripe_subscription_object(account: @account, metadata: {}))
+    end
+
+    assert_response :ok
+    assert_equal 0, AccountSubscription.count
+  end
+
+  test "an out-of-order event doesn't overwrite a newer one" do
+    with_stripe_prices do
+      post_stripe_event stripe_event(type: "customer.subscription.updated", object: stripe_subscription_object(account: @account, status: "canceled"), created: Time.current.to_i)
+      post_stripe_event stripe_event(type: "customer.subscription.updated", object: stripe_subscription_object(account: @account, status: "active"), created: 1.hour.ago.to_i)
+    end
+
+    assert_response :ok
+    assert_equal "canceled", @account.reload.subscription.status
+  end
+end
