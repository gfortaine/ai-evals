+      </dd>
+
+      <dt class="txt-ink-medium">Storage</dt>
+      <dd>
+        <%= number_to_human_size(@account.bytes_used) %>
+        <% if override&.bytes_used %>(overridden, actual <%= number_to_human_size(@account.storage_total&.bytes_stored || 0) %>)<% end %>
