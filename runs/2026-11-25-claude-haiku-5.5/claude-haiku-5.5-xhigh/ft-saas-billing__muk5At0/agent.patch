+require "test_helper"
+require_relative "../../test_helpers/stripe_test_helper"
+
+class Account::PlanSettingsTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "admins see their plan and an Upgrade button in settings" do
+    sign_in_as :mike
+
+    with_stripe_prices do
+      get account_settings_path(script_name: @account.slug)
+    end
+
+    assert_response :success
+    assert_select "h2", text: "Plan"
+    assert_select "strong", text: "Free"
+    assert_select "form[action=?] input[type=submit][value=?]", saas.account_upgrade_path(script_name: @account.slug), "Upgrade"
+    assert_select "select[name=plan] option", count: 2
+  end
+
+  test "the Upgrade button isn't offered when no plan can be bought" do
+    sign_in_as :mike
+
+    with_env("STRIPE_MONTHLY_V1_PRICE_ID" => nil, "STRIPE_UNLIMITED_PLUS_PRICE_ID" => nil) do
+      get account_settings_path(script_name: @account.slug)
+    end
+
+    assert_response :success
+    assert_select "h2", text: "Plan"
+    assert_select "input[value=Upgrade]", count: 0
+    assert_select "button", text: "Upgrade", count: 0
+  end
+
+  test "members don't see the plan" do
+    sign_in_as :mike
+    users(:mike).update!(role: :member)
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "h2", text: "Plan", count: 0
+  end
+
+  test "a subscribed admin sees their plan and can manage billing" do
+    sign_in_as :mike
+
+    with_stripe_prices do
+      AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account, price_id: UNLIMITED_PLUS_PRICE_ID), event_at: Time.current)
+
+      get account_settings_path(script_name: @account.slug)
+    end
+
+    assert_response :success
+    assert_select "strong", text: "Unlimited+"
+    assert_select "div", text: /\$25\/month/
+    assert_select "form[action=?] button", saas.account_billing_portal_path(script_name: @account.slug), text: "Manage billing"
+    assert_select "select[name=plan]", count: 0
+  end
+
+  test "a comped admin sees their plan as complimentary" do
+    sign_in_as :mike
+    @account.comp
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "strong", text: "Unlimited"
+    assert_select "span", text: "(complimentary)"
+  end
+end
diff --git a/saas/test/controllers/account/upgrades_controller_test.rb b/saas/test/controllers/account/upgrades_controller_test.rb
new file mode 100644
index 0000000..82fda77
--- /dev/null
+++ b/saas/test/controllers/account/upgrades_controller_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+require_relative "../../test_helpers/stripe_test_helper"
+
+class Account::UpgradesControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "an admin is sent to Stripe Checkout for the chosen plan" do
+    sign_in_as :mike
+
+    with_stripe_prices do
+      Stripe::Checkout::Session.expects(:create).with(
+        has_entries(
+          mode: "subscription",
+          line_items: [ { price: UNLIMITED_PLUS_PRICE_ID, quantity: 1 } ],
+          client_reference_id: @account.external_account_id.to_s,
+          customer_email: identities(:mike).email_address,
+          subscription_data: { metadata: { account_id: @account.external_account_id.to_s } }
+        )
+      ).returns(checkout_session_stub)
+
+      post saas.account_upgrade_path(script_name: @account.slug), params: { plan: "unlimited_plus" }
+    end
+
+    assert_redirected_to "https://checkout.stripe.test/c/pay/cs_test"
+  end
+
+  test "an account that has been a customer before checks out against the same Stripe customer" do
+    sign_in_as :mike
+
+    with_stripe_prices do
+      AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account, status: "canceled"), event_at: Time.current)
+
+      Stripe::Checkout::Session.expects(:create).with do |params|
+        params[:customer] == "cus_test_123" && !params.key?(:customer_email)
+      end.returns(checkout_session_stub)
+
+      post saas.account_upgrade_path(script_name: @account.slug), params: { plan: "unlimited" }
+    end
+
+    assert_redirected_to "https://checkout.stripe.test/c/pay/cs_test"
+  end
+
+  test "non-admins can't start an upgrade" do
+    sign_in_as :mike
+    users(:mike).update!(role: :member)
+
+    with_stripe_prices do
+      Stripe::Checkout::Session.expects(:create).never
+
+      post saas.account_upgrade_path(script_name: @account.slug), params: { plan: "unlimited" }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "an account with a live subscription is pointed at billing instead of checking out again" do
+    sign_in_as :mike
+
+    with_stripe_prices do
+      AccountSubscription.sync_from_stripe(stripe_subscription_object(account: @account), event_at: Time.current)
+
+      Stripe::Checkout::Session.expects(:create).never
+
+      post saas.account_upgrade_path(script_name: @account.slug), params: { plan: "unlimited_plus" }
+    end
+
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+    assert_match(/already has a subscription/, flash[:alert])
+  end
+
+  test "a plan whose price isn't configured can't be bought" do
+    sign_in_as :mike
+
+    with_env("STRIPE_UNLIMITED_PLUS_PRICE_ID" => nil) do
+      Stripe::Checkout::Session.expects(:create).never
+
+      post saas.account_upgrade_path(script_name: @account.slug), params: { plan: "unlimited_plus" }
+    end
+
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+    assert_match(/isn't available/, flash[:alert])
+  end
+
+test "a Stripe outage sends the admin back to settings with a message" do
+  sign_in_as :mike
+
+  with_stripe_prices do
+    Stripe::Checkout::Session.stubs(:create).raises(Stripe::APIConnectionError.new("Stripe is down"))
+
+    post saas.account_upgrade_path(script_name: @account.slug), params: { plan: "unlimited" }
+  end
+
+  assert_redirected_to account_settings_path(script_name: @account.slug)
+  assert_match(/couldn't reach our payment provider/, flash[:alert])
+end
+
+  test "an unknown plan is refused" do
+    sign_in_as :mike
+
+    with_stripe_prices do
+      Stripe::Checkout::Session.expects(:create).never
+
+      post saas.account_upgrade_path(script_name: @account.slug), params: { plan: "platinum" }
+    end
+
+    assert_response :bad_request
+  end
+end
