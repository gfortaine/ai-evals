+require "test_helper"
+require_relative "../test_helpers/stripe_test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  include StripeTestHelper
+
+  test "allowances match the approved pricing" do
+    assert_equal 1_000, Plan::FREE.card_limit
+    assert_equal 1.gigabyte, Plan::FREE.storage_limit
+
+    assert_nil Plan::UNLIMITED.card_limit
+    assert_equal 5.gigabytes, Plan::UNLIMITED.storage_limit
+    assert_equal "$20/month", Plan::UNLIMITED.price_label
+
+    assert_nil Plan::UNLIMITED_PLUS.card_limit
+    assert_equal 500.gigabytes, Plan::UNLIMITED_PLUS.storage_limit
+    assert_equal "$25/month", Plan::UNLIMITED_PLUS.price_label
+  end
+
+  test "find looks plans up by key" do
+    assert_equal Plan::UNLIMITED_PLUS, Plan.find("unlimited_plus")
+    assert_nil Plan.find("platinum")
+  end
+
+  test "only paid plans can be bought, and only when a Stripe price is configured" do
+    assert_not Plan::FREE.purchasable?
+    assert_not Plan::UNLIMITED.purchasable?
+
+    with_stripe_prices do
+      assert Plan::UNLIMITED.purchasable?
+      assert Plan::UNLIMITED_PLUS.purchasable?
+    end
+
+    with_env("STRIPE_MONTHLY_V1_PRICE_ID" => nil, "STRIPE_UNLIMITED_PLUS_PRICE_ID" => "") do
+      assert_not Plan::UNLIMITED.purchasable?
+      assert_not Plan::UNLIMITED_PLUS.purchasable?
+    end
+  end
+
+  test "for_stripe_price_id maps configured prices to paid plans" do
+    with_stripe_prices do
+      assert_equal Plan::UNLIMITED, Plan.for_stripe_price_id(UNLIMITED_PRICE_ID)
+      assert_equal Plan::UNLIMITED_PLUS, Plan.for_stripe_price_id(UNLIMITED_PLUS_PRICE_ID)
+      assert_nil Plan.for_stripe_price_id("price_something_else")
+      assert_nil Plan.for_stripe_price_id(nil)
+    end
+  end
+end
diff --git a/saas/test/test_helpers/stripe_test_helper.rb b/saas/test/test_helpers/stripe_test_helper.rb
new file mode 100644
index 0000000..299ac75
--- /dev/null
+++ b/saas/test/test_helpers/stripe_test_helper.rb
@@ -0,0 +1,65 @@
+# Stripe can't be reached from tests, so these helpers build the webhook
+# payloads and signatures locally. Anything that calls the Stripe API must be
+# stubbed in the test itself.
+module StripeTestHelper
+  WEBHOOK_SECRET = "whsec_test_secret"
+  UNLIMITED_PRICE_ID = "price_test_unlimited"
+  UNLIMITED_PLUS_PRICE_ID = "price_test_unlimited_plus"
+
+  def with_stripe_prices(&block)
+    with_env(
+      "STRIPE_WEBHOOK_SECRET" => WEBHOOK_SECRET,
+      "STRIPE_MONTHLY_V1_PRICE_ID" => UNLIMITED_PRICE_ID,
+      "STRIPE_UNLIMITED_PLUS_PRICE_ID" => UNLIMITED_PLUS_PRICE_ID,
+      &block
+    )
+  end
+
+  def with_env(vars)
+    previous = vars.keys.index_with { |key| ENV[key] }
+    vars.each { |key, value| ENV[key] = value }
+    yield
+  ensure
+    previous&.each { |key, value| ENV[key] = value }
+  end
+
+  def stripe_subscription_object(account:, status: "active", price_id: UNLIMITED_PRICE_ID,
+                                 id: "sub_test_123", customer: "cus_test_123", cancel_at: nil,
+                                 metadata: { account_id: account.external_account_id.to_s })
+    {
+      id: id,
+      object: "subscription",
+      customer: customer,
+      status: status,
+      metadata: metadata,
+      current_period_end: 1.month.from_now.to_i,
+      cancel_at: cancel_at,
+      items: { object: "list", data: [ { id: "si_test_123", object: "subscription_item", price: { id: price_id } } ] }
+    }
+  end
+
+  def stripe_event(type:, object:, created: Time.current.to_i)
+    { id: "evt_#{SecureRandom.hex(8)}", object: "event", type: type, created: created, data: { object: object } }
+  end
+
+  # Same scheme Stripe uses: "t=<timestamp>,v1=<HMAC-SHA256 of "<timestamp>.<payload>">".
+  def stripe_signature_header(payload, secret: WEBHOOK_SECRET, timestamp: Time.current.to_i)
+    signature = OpenSSL::HMAC.hexdigest("SHA256", secret, "#{timestamp}.#{payload}")
+    "t=#{timestamp},v1=#{signature}"
+  end
+
+  def post_stripe_webhook(payload, signature_header:)
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => signature_header }
+    end
+  end
+
+  def post_stripe_event(event, secret: WEBHOOK_SECRET, timestamp: Time.current.to_i)
+    payload = event.to_json
+    post_stripe_webhook payload, signature_header: stripe_signature_header(payload, secret: secret, timestamp: timestamp)
+  end
+
+  def checkout_session_stub(url: "https://checkout.stripe.test/c/pay/cs_test")
+    stub(url: url)
+  end
+end
