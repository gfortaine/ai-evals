diff --git a/saas/app/models/account_subscription.rb b/saas/app/models/account_subscription.rb
new file mode 100644
index 0000000..a87093d
--- /dev/null
+++ b/saas/app/models/account_subscription.rb
@@ -0,0 +1,79 @@
+# A hosted account's Stripe subscription. Rows are written only from Stripe
+# webhooks (see StripeWebhooksController); there is at most one per account.
+class AccountSubscription < SaasRecord
+  # Statuses that keep paid features on. past_due keeps access while Stripe
+  # retries the payment; the other statuses mean the account is on Free.
+  ENTITLED_STATUSES = %w[ trialing active past_due ].freeze
+
+  belongs_to :account
+
+  validates :plan_key, inclusion: { in: Plan::PAID.map(&:key) }
+  validates :stripe_customer_id, :stripe_subscription_id, :status, presence: true
+
+  class << self
+    # Applies the state carried by a Stripe subscription object from a webhook
+    # event. Events can arrive out of order, so an event older than the last
+    # one applied is ignored. Returns a symbol describing what happened.
+    def sync_from_stripe(stripe_subscription, event_at:)
+      account = account_for(stripe_subscription)
+      return :unknown_account unless account
+
+      plan = Plan.for_stripe_price_id(price_id_for(stripe_subscription))
+      return :unknown_price unless plan
+
+      record = account.subscription || account.build_subscription
+      return :stale if record.synced_at && event_at < record.synced_at
+
+      record.update!(
+        plan_key: plan.key,
+        stripe_customer_id: stripe_value(stripe_subscription[:customer]),
+        stripe_subscription_id: stripe_subscription[:id],
+        status: stripe_subscription[:status],
+        current_period_end: stripe_time(current_period_end_for(stripe_subscription)),
+        cancel_at: stripe_time(stripe_subscription[:cancel_at]),
+        synced_at: event_at
+      )
+
+      :synced
+    end
+
+    private
+      def account_for(stripe_subscription)
+        if (account_id = stripe_subscription[:metadata]&.[](:account_id)).present?
+          Account.find_by(external_account_id: account_id.to_i)
+        elsif (existing = find_by(stripe_subscription_id: stripe_subscription[:id]))
+          existing.account
+        end
+      end
+
+def price_id_for(stripe_subscription)
+  item = first_item_for(stripe_subscription)
+  item&.[](:price)&.[](:id)
+end
+
+# Stripe moved current_period_end onto subscription items in newer API versions.
+def current_period_end_for(stripe_subscription)
+  stripe_subscription[:current_period_end] || first_item_for(stripe_subscription)&.[](:current_period_end)
+end
+
+def first_item_for(stripe_subscription)
+  stripe_subscription[:items]&.[](:data)&.first
+end
+
+      def stripe_value(value)
+        value.is_a?(String) ? value : value&.[](:id)
+      end
+
+      def stripe_time(epoch)
+        Time.at(epoch) if epoch
+      end
+  end
+
+  def plan
+    Plan.find(plan_key)
+  end
+
+  def entitled?
+    ENTITLED_STATUSES.include?(status)
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..83770ee
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,66 @@
+# Hosted Fizzy plans. Allowances and prices are the approved pricing. Stripe
+# price IDs are read from the environment so each deployment can point at its
+# own Stripe catalogue; a plan without a configured price can't be purchased.
+class Plan
+  attr_reader :key, :name, :card_limit, :storage_limit, :price_cents, :stripe_price_env
+
+  class << self
+    def find(key)
+      ALL.find { |plan| plan.key == key.to_s }
+    end
+
+    def for_stripe_price_id(price_id)
+      return if price_id.blank?
+
+      PAID.find { |plan| plan.stripe_price_id == price_id }
+    end
+  end
+
+  def initialize(key:, name:, card_limit:, storage_limit:, price_cents: 0, stripe_price_env: nil)
+    @key = key
+    @name = name
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @price_cents = price_cents
+    @stripe_price_env = stripe_price_env
+  end
+
+  FREE = new key: "free", name: "Free", card_limit: 1_000, storage_limit: 1.gigabyte
+
+  UNLIMITED = new key: "unlimited", name: "Unlimited", card_limit: nil, storage_limit: 5.gigabytes,
+    price_cents: 2_000, stripe_price_env: "STRIPE_MONTHLY_V1_PRICE_ID"
+
+  UNLIMITED_PLUS = new key: "unlimited_plus", name: "Unlimited+", card_limit: nil, storage_limit: 500.gigabytes,
+    price_cents: 2_500, stripe_price_env: "STRIPE_UNLIMITED_PLUS_PRICE_ID"
+
+  PAID = [ UNLIMITED, UNLIMITED_PLUS ].freeze
+  ALL = [ FREE, *PAID ].freeze
+
+  def paid?
+    price_cents.positive?
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def stripe_price_id
+    ENV[stripe_price_env].presence if stripe_price_env
+  end
+
+  def purchasable?
+    paid? && stripe_price_id.present?
+  end
+
+  def price_label
+    paid? ? "$#{price_cents / 100}/month" : "Free"
+  end
+
+  def to_param
+    key
+  end
+
+  def to_s
+    name
+  end
+end
diff --git a/saas/app/views/account/settings/_plan.html.erb b/saas/app/views/account/settings/_plan.html.erb
