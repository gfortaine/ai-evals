@@ -0,0 +1,63 @@
+# frozen_string_literal: false
+
+# Writes the golden artifacts of a release (see docs/UPGRADE.md, section 6).
+# Run it once per release, in that release's checkout, and copy the output to
+# test/fixtures/files/upgrade/ with the release prefix (r1_, r2_, ...). Never
+# regenerate the files of an earlier release.
+#
+# Usage (from the root of the checkout):
+#
+#   ARTIFACT_DIR=/tmp/artifacts/r2 ARTIFACT_TIME=2025-04-01T12:00:00Z \
+#     bin/rails test /path/to/docs/upgrade/generate_golden_artifacts.rb
+#
+# ARTIFACT_TIME is the creation time of the artifacts (UTC). Mail links expire
+# 30 days after it, so it is also the time the compatibility tests use.
+# This file is not part of the test suite. It is kept here so every release
+# writes its artifacts in the same way.
+require File.expand_path('test/test_helper', Dir.pwd)
+require 'fileutils'
+require 'tmpdir'
+
+class GenArtifactsTest < Redmine::IntegrationTest
+  fixtures :projects, :users, :email_addresses, :roles, :members, :member_roles,
+           :trackers, :projects_trackers, :issue_statuses, :enumerations, :issues,
+           :enabled_modules, :watchers, :tokens
+
+  def test_generate
+    dir = ENV.fetch('ARTIFACT_DIR')
+    FileUtils.mkdir_p(dir)
+    at = Time.iso8601(ENV.fetch('ARTIFACT_TIME'))
+    travel_to at do
+      # 1. Logged-in session cookie and its session token row.
+      log_user 'jsmith', 'jsmith'
+      get '/my/account'
+      assert_response :success
+      token = Token.where(:user_id => 2, :action => 'session').order(:id).last.value
+      File.write(File.join(dir, 'session_cookie.txt'), cookies['_redmine_session'] + "\n")
+      File.write(File.join(dir, 'session_token.txt'), token + "\n")
+
+      # 2. Unwatch link as written into notification mails.
+      File.write(File.join(dir, 'mail_unwatch_token.txt'),
+                 Mailer.mail_link_token(:unwatch, 'user_id' => 2, 'issue_id' => 1) + "\n")
+
+      # 3. Open form: anonymous login page (cookie + CSRF token from the same session).
+      reset!
+      ActionController::Base.allow_forgery_protection = true
+      get '/login'
+      assert_response :success
+      csrf = response.body[/name="authenticity_token" value="([^"]+)"/, 1]
+      File.write(File.join(dir, 'open_form_session_cookie.txt'), cookies['_redmine_session'] + "\n")
+      File.write(File.join(dir, 'open_form_csrf_token.txt'), csrf + "\n")
+
+      # 4. Cache entry as written by Rails.cache with a file store.
+      store_dir = Dir.mktmpdir('artifact-cache')
+      store = ActiveSupport::Cache::FileStore.new(store_dir)
+      store.write('upgrade-compat/cache-entry', {'formatted' => '<p>cached text</p>', 'list' => [['English', 'en']]})
+      file = Dir.glob(File.join(store_dir, '**', '*')).find { |f| File.file?(f) }
+      File.write(File.join(dir, 'cache_entry.txt'), [File.binread(file)].pack('m0') + "\n")
+      FileUtils.rm_rf(store_dir)
+    end
+  ensure
+    ActionController::Base.allow_forgery_protection = false
+  end
+end
