+# frozen_string_literal: true
+
+# Checks that the checkout this file is run in can read the golden artifacts
+# written by another release. It is how the rollback target is verified:
+# run the previous release's checkout with the artifacts of the newer release.
+#
+# Usage (from the root of the checkout that should read them):
+#
+#   ARTIFACT_DIR=/tmp/artifacts/r2 ARTIFACT_TIME=2025-04-01T12:00:00Z \
+#     bin/rails test /path/to/docs/upgrade/check_artifacts_readable.rb
+#
+# The artifact directory holds the files written by generate_golden_artifacts.rb:
+# session_cookie.txt, session_token.txt, mail_unwatch_token.txt,
+# open_form_session_cookie.txt, open_form_csrf_token.txt and cache_entry.txt.
+# The test is not committed to the test suite, because it reads files outside
+# the repository. See docs/UPGRADE.md, section 6.
+
+require File.expand_path('test/test_helper', Dir.pwd)
+
+class CheckArtifactsReadableTest < Redmine::IntegrationTest
+  fixtures :projects, :users, :email_addresses, :roles, :members, :member_roles,
+           :trackers, :projects_trackers, :issue_statuses, :enumerations, :issues,
+           :enabled_modules, :watchers, :tokens
+
+  CACHE_KEY = 'upgrade-compat/cache-entry'
+  CACHE_VALUE = {'formatted' => '<p>cached text</p>', 'list' => [['English', 'en']]}.freeze
+
+  def artifact(name)
+    File.read(File.join(ENV.fetch('ARTIFACT_DIR'), name)).strip
+  end
+
+  def at
+    Time.iso8601(ENV.fetch('ARTIFACT_TIME'))
+  end
+
+  def test_session_cookie_keeps_user_logged_in
+    travel_to at do
+      Token.insert_all!([{:user_id => 2, :action => 'session', :value => artifact('session_token.txt'),
+                          :created_on => Time.now, :updated_on => Time.now}])
+      cookies['_redmine_session'] = artifact('session_cookie.txt')
+      get '/my/account'
+
+      assert_response :success
+      assert_select '#loggedas', :text => /jsmith/
+    end
+  end
+
+  def test_unwatch_link_still_works
+    travel_to at do
+      token = artifact('mail_unwatch_token.txt')
+      assert_equal({'user_id' => 2, 'issue_id' => 1}, Mailer.verify_mail_link(token, :unwatch))
+
+      Issue.find(1).set_watcher(User.find(2), true)
+      get '/mail_links/unwatch', :params => {:token => token}
+
+      assert_response :success
+      assert_not Issue.find(1).watched_by?(User.find(2))
+    end
+  end
+
+  def test_open_form_csrf_token_is_accepted
+    travel_to at do
+      ActionController::Base.allow_forgery_protection = true
+      cookies['_redmine_session'] = artifact('open_form_session_cookie.txt')
+      post '/login', :params => {:username => 'jsmith', :password => 'wrong-password',
+                                 :authenticity_token => artifact('open_form_csrf_token.txt')}
+
+      assert_response :success, 'CSRF token from an open form was rejected'
+    end
+  ensure
+    ActionController::Base.allow_forgery_protection = false
+  end
+
+  def test_cache_entry_is_read
+    dir = Dir.mktmpdir('artifact-cache')
+    store = ActiveSupport::Cache::FileStore.new(dir)
+    store.write(CACHE_KEY, 'placeholder')
+    file = Dir.glob(File.join(dir, '**', '*')).find { |f| File.file?(f) }
+    File.binwrite(file, artifact('cache_entry.txt').unpack1('m0'))
+
+    assert_equal CACHE_VALUE, store.read(CACHE_KEY)
+  ensure
+    FileUtils.rm_rf(dir) if dir
+  end
+end
