@@ -1,6 +1,8 @@
 require "test_helper"
 
 class LeafTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
   test "slug is generated from title" do
     leaf = Leaf.new(title: "Hello, World!")
     assert_equal "hello-world", leaf.slug
@@ -10,4 +12,47 @@ class LeafTest < ActiveSupport::TestCase
     leaf = Leaf.new(title: "")
     assert_equal "-", leaf.slug
   end
+
+  test "destroying a leaf purges the images embedded in its page" do
+    attachment = attach_image_to leaves(:welcome_page).page.body
+
+    leaves(:welcome_page).destroy
+    perform_enqueued_jobs
+
+    assert_image_purged attachment
+  end
+
+  test "destroying a leaf purges the images embedded in its earlier revisions" do
+    attachment = attach_image_to leaves(:welcome_page).page.body
+    leaves(:welcome_page).edit leafable_params: { body: "![Reading](#{attachment.slug_path})" }
+    assert leaves(:welcome_page).edits.revision.any?
+
+    leaves(:welcome_page).destroy
+    perform_enqueued_jobs
+
+    assert_image_purged attachment
+    assert_equal 0, Edit.count
+  end
+
+  test "destroying a trashed leaf purges the images embedded in its page" do
+    attachment = attach_image_to leaves(:welcome_page).page.body
+    leaves(:welcome_page).trashed!
+
+    assert_nothing_raised { leaves(:welcome_page).destroy! }
+    perform_enqueued_jobs
+
+    assert_image_purged attachment
+  end
+
+  private
+    def attach_image_to(markdown)
+      markdown.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+      markdown.uploads.attachments.last
+    end
+
+    def assert_image_purged(attachment)
+      assert_not ActiveStorage::Attachment.exists?(attachment.id)
+      assert_not ActiveStorage::Blob.exists?(attachment.blob_id)
+      assert_not ActiveStorage::Blob.service.exist?(attachment.blob.key)
+    end
 end
