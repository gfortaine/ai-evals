diff --git a/app/models/edit.rb b/app/models/edit.rb
index 57bccf9..b56dc6f 100644
--- a/app/models/edit.rb
+++ b/app/models/edit.rb
@@ -1,9 +1,13 @@
 class Edit < ApplicationRecord
   belongs_to :leaf
-  delegated_type :leafable, types: Leafable::TYPES, dependent: :destroy
+  delegated_type :leafable, types: Leafable::TYPES
 
   enum :action, %w[ revision trash ].index_by(&:itself)
 
+  # A revision owns its leafable: it's a snapshot kept from before an edit. A trash edit only
+  # points at the leaf's current leafable, which the leaf itself is responsible for destroying.
+  after_destroy :destroy_revision_leafable, if: :revision?
+
   scope :sorted, -> { order(created_at: :desc) }
   scope :before, ->(edit) { where("created_at < ?", edit.created_at) }
   scope :after, ->(edit) { where("created_at > ?", edit.created_at) }
@@ -15,4 +19,9 @@ class Edit < ApplicationRecord
   def next
     leaf.edits.after(self).first
   end
+
+  private
+    def destroy_revision_leafable
+      leafable&.destroy
+    end
 end
