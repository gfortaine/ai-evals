diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..2a85439
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+
+    books(:manual).press Page.new(body: "Only the manual editors can read this."), title: "Secret Plans"
+    books(:handbook).press Page.new(body: "Half price until Friday."), title: "Save 50% off"
+    books(:handbook).press Page.new(body: "Don't panic, it is only a handbook."), title: "Don't Panic"
+  end
+
+  test "show finds pages by title" do
+    get library_search_url, params: { q: "Summary" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Handbook: Summary/
+  end
+
+  test "show is case insensitive" do
+    get library_search_url, params: { q: "summary" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Summary/
+  end
+
+  test "show returns nothing for a blank query" do
+    get library_search_url, params: { q: "   " }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "show does not return pages from books the user cannot read" do
+    get library_search_url, params: { q: "Secret" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_select "p.search__no_matches", text: /no matches/i
+  end
+
+  test "show only returns pages from readable books when the term is injected into the query" do
+    get library_search_url, params: { q: "x' or 1=1 or 'x" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Secret Plans/, count: 0
+  end
+
+  test "show does not error on an apostrophe" do
+    get library_search_url, params: { q: "Don't" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Don't Panic/
+  end
+
+  test "show does not error on other punctuation" do
+    [ "\"", "--", ";", "\\", "(", "'" ].each do |term|
+      get library_search_url, params: { q: term }
+
+      assert_response :success
+    end
+  end
+
+  test "show does not treat a per cent sign as a wildcard" do
+    get library_search_url, params: { q: "%" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Save 50% off/, count: 1
+    assert_select "a.search__result", text: /Summary/, count: 0
+    assert_select "a.search__result", text: /Welcome/, count: 0
+  end
+
+  test "show does not treat an underscore as a wildcard" do
+    get library_search_url, params: { q: "_" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_select "p.search__no_matches", text: /no matches/i
+  end
+
+  test "show finds a page by a title containing a per cent sign" do
+    get library_search_url, params: { q: "Save 50% off" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Save 50% off/, count: 1
+  end
+
+  test "show finds a page by its title when the signed out user can read the book" do
+    sign_out
+    books(:handbook).update!(published: true)
+
+    get library_search_url, params: { q: "Summary" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Summary/
+  end
+
+  test "show does not return unpublished pages to a signed out user" do
+    sign_out
+
+    get library_search_url, params: { q: "Summary" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "show does not return trashed pages" do
+    leaves(:summary_page).trashed!
+
+    get library_search_url, params: { q: "Summary" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+end
