diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..11435ee
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,161 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:buy_domain)
+  end
+
+  test "a card that never bursted is not stalled, however long it sits idle" do
+    freeze_time
+    travel 3.weeks
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "assigning someone bursts the card, and it stalls after two weeks without activity" do
+    freeze_time
+    @card.toggle_assignment(users(:kevin))
+
+    travel 2.weeks - 1.second
+    assert_not @card.reload.stalled?
+
+    travel 1.second
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "reopening a card bursts it" do
+    card = cards(:shipping)
+    freeze_time
+    card.reopen
+
+    travel 2.weeks
+    assert card.reload.stalled?
+  end
+
+  test "two comments from two people do not burst the card" do
+    freeze_time
+    comment_by users(:david)
+    comment_by users(:kevin)
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "three comments from two people within a third of the auto-close period burst the card" do
+    freeze_time
+    comment_by users(:david)
+    comment_by users(:kevin)
+    comment_by users(:david), at: 1.day.from_now
+
+    travel_to 15.days.from_now
+    assert @card.reload.stalled?
+  end
+
+  test "three comments from one person do not burst the card" do
+    freeze_time
+    3.times { comment_by users(:david) }
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "comments spread wider than a third of the auto-close period do not burst the card" do
+    # Writebook auto-closes after 90 days, so the burst window is 30 days.
+    freeze_time
+    comment_by users(:david), at: 40.days.ago
+    comment_by users(:kevin), at: 20.days.ago
+    comment_by users(:david)
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "the burst window is a third of the board's auto-close period" do
+    freeze_time
+    board = boards(:writebook)
+    board.update! auto_postpone_period: 3.days.to_i # one day window
+
+    card = create_card(board)
+    comment_by users(:david), at: 2.days.ago, card: card
+    comment_by users(:kevin), at: 1.day.ago, card: card
+    comment_by users(:david), card: card
+    travel 2.weeks
+    assert_not card.reload.stalled?
+
+    board.update! auto_postpone_period: 30.days.to_i # ten day window
+    card = create_card(board)
+    comment_by users(:david), at: 2.days.ago, card: card
+    comment_by users(:kevin), at: 1.day.ago, card: card
+    comment_by users(:david), card: card
+    travel 2.weeks
+    assert card.reload.stalled?
+  end
+
+  test "system comments do not count as people bursting the card" do
+    freeze_time
+    3.times { comment_by accounts("37s").system_user }
+    comment_by users(:david)
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "any activity resets the two week stall" do
+    freeze_time
+    @card.toggle_assignment(users(:kevin))
+    travel 2.weeks
+    assert @card.reload.stalled?
+
+    comment_by users(:jz)
+    assert_not @card.reload.stalled?
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "the system moving a cold card to not now is not activity" do
+    freeze_time
+    @card.toggle_assignment(users(:kevin))
+
+    travel 15.days
+    assert @card.reload.stalled?
+
+    @card.auto_postpone(user: accounts("37s").system_user)
+    assert @card.reload.postponed?
+    assert @card.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "closed cards are never stalled" do
+    freeze_time
+    @card.toggle_assignment(users(:kevin))
+    @card.close
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "a stalled card that is moved to not now is still stalled" do
+    freeze_time
+    @card.toggle_assignment(users(:kevin))
+    @card.postpone
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  private
+    def create_card(board)
+      # Fresh instance: a card created as published keeps an in-memory flag that skips activity touches.
+      Card.find(board.cards.create!(title: "Pricing page", status: "published").id)
+    end
+
+    def comment_by(user, at: Time.current, card: @card)
+      travel_to(at) { card.comments.create!(creator: user, body: "Thoughts?") }
+    end
+end
