diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..cc9fa18
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,39 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  BURST_COMMENTS = 3
+  BURST_PEOPLE = 2
+
+  included do
+    scope :stalled, -> { open.published.where.not(burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def stalled?
+    open? && published? && burst_at.present? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def record_burst
+    if burst_at.nil?
+      update! burst_at: Time.current
+    end
+  end
+
+  def check_for_comment_burst(comment)
+    if burst_at.nil? && comment_burst_at?(comment.created_at)
+      record_burst
+    end
+  end
+
+  private
+    # Three or more comments from at least two people within a third of the
+    # auto-close period, ending at +time+. System comments don't count.
+    def comment_burst_at?(time)
+      recent = comments.by_user.where(created_at: (time - burst_window)..time)
+      recent.count >= BURST_COMMENTS && recent.distinct.count(:creator_id) >= BURST_PEOPLE
+    end
+
+    def burst_window
+      auto_postpone_period.seconds / 3
+    end
+end
