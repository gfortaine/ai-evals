diff --git a/test/test_helpers/caching_test_helper.rb b/test/test_helpers/caching_test_helper.rb
index 90dab64..d464eb5 100644
--- a/test/test_helpers/caching_test_helper.rb
+++ b/test/test_helpers/caching_test_helper.rb
@@ -11,4 +11,22 @@ module CachingTestHelper
       ApplicationController.perform_caching = was_perform_caching
     end
   end
+
+  # Fragment and JSON caching (`cache` blocks and `json.cache!`) use the app's
+  # cache store, which is a null store in tests.
+  def with_fragment_caching
+    was_rails_cache = Rails.cache
+    was_cache_store = ActionController::Base.cache_store
+    was_perform_caching = ApplicationController.perform_caching
+    begin
+      Rails.cache = ActiveSupport::Cache.lookup_store(:memory_store)
+      ActionController::Base.cache_store = Rails.cache
+      ApplicationController.perform_caching = true
+      yield
+    ensure
+      Rails.cache = was_rails_cache
+      ActionController::Base.cache_store = was_cache_store
+      ApplicationController.perform_caching = was_perform_caching
+    end
+  end
 end
