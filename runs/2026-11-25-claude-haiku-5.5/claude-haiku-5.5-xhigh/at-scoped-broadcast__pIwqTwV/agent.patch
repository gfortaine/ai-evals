diff --git a/test/controllers/pages_controller_test.rb b/test/controllers/pages_controller_test.rb
index 0b0ccec..209430f 100644
--- a/test/controllers/pages_controller_test.rb
+++ b/test/controllers/pages_controller_test.rb
@@ -79,7 +79,60 @@ class PagesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "With even more interesting words.", updated_page.body.content
   end
 
+  test "update broadcasts the being edited indicator to a current editor" do
+    get edit_leafable_path(leaves(:welcome_page))
+    kevin_stream = being_edited_stream_from(response.body)
+
+    sign_out
+    sign_in :jason
+
+    payloads = capture_turbo_stream_broadcasts(kevin_stream) do
+      perform_enqueued_jobs do
+        put leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Better welcome" }, page: { body: "Edited." } }
+      end
+    end
+
+    assert_equal 1, payloads.size
+    assert_equal "append", payloads.first["action"]
+    assert_includes payloads.first.to_html, "Jason"
+  end
+
+  test "update does not broadcast the being edited indicator to a collaborator whose access was removed" do
+    get edit_leafable_path(leaves(:welcome_page))
+    removed_stream = being_edited_stream_from(response.body)
+
+    books(:handbook).access_for(user: users(:kevin)).destroy!
+    sign_out
+    sign_in :jason
+
+    assert_no_turbo_stream_broadcasts(removed_stream) do
+      perform_enqueued_jobs do
+        put leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Better welcome" }, page: { body: "Edited." } }
+      end
+    end
+  end
+
+  test "update does not broadcast the being edited indicator to an editor who was downgraded to reader" do
+    get edit_leafable_path(leaves(:welcome_page))
+    downgraded_stream = being_edited_stream_from(response.body)
+
+    books(:handbook).access_for(user: users(:kevin)).update!(level: :reader)
+    sign_out
+    sign_in :jason
+
+    assert_no_turbo_stream_broadcasts(downgraded_stream) do
+      perform_enqueued_jobs do
+        put leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Better welcome" }, page: { body: "Edited." } }
+      end
+    end
+  end
+
   private
+    def being_edited_stream_from(html)
+      signed_name = Nokogiri::HTML(html).css("turbo-cable-stream-source").first["signed-stream-name"]
+      Turbo.signed_stream_verifier.verified(signed_name)
+    end
+
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
     end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..953af64 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -37,6 +37,27 @@ class BookTest < ActiveSupport::TestCase
     assert_not_includes books(:handbook).markable, leaves(:summary_page).title
   end
 
+  test "users who can edit are active editors and administrators" do
+    editors = books(:handbook).users_who_can_edit
+
+    assert_includes editors, users(:kevin)
+    assert_includes editors, users(:jason)
+    assert_includes editors, users(:david)
+    assert_not_includes editors, users(:jz)
+  end
+
+  test "users who can edit includes administrators without a direct access to the book" do
+    books(:manual).accesses.where(user: users(:david)).delete_all
+
+    assert_includes books(:manual).users_who_can_edit, users(:david)
+  end
+
+  test "users who can edit excludes deactivated users" do
+    users(:kevin).deactivate
+
+    assert_not_includes books(:handbook).users_who_can_edit, users(:kevin)
+  end
+
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
