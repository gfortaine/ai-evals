diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..adbb393 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,100 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "readers never see editor controls, even when an editor loaded the page first" do
+    with_fragment_caching do
+      get book_slug_path(books(:handbook))
+      assert_editor_controls
+
+      switch_user :jz
+      get book_slug_path(books(:handbook))
+      assert_no_editor_controls
+    end
+  end
+
+  test "editors always see editor controls, even when a reader loaded the page first" do
+    with_fragment_caching do
+      switch_user :jz
+      get book_slug_path(books(:handbook))
+      assert_no_editor_controls
+
+      switch_user :kevin
+      get book_slug_path(books(:handbook))
+      assert_editor_controls
+    end
+  end
+
+  test "signed-out visitors never see editor controls, even when an editor loaded the page first" do
+    books(:handbook).update!(published: true)
+
+    with_fragment_caching do
+      get book_slug_path(books(:handbook))
+      assert_editor_controls
+
+      sign_out
+      get book_slug_path(books(:handbook))
+      assert_no_editor_controls
+    end
+  end
+
+  test "renamed entries show their new title to the next viewer" do
+    with_fragment_caching do
+      get book_slug_path(books(:handbook))
+
+      patch leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Renamed Page" } }
+
+      switch_user :jz
+      get book_slug_path(books(:handbook))
+      assert_toc_titles include: "Renamed Page", exclude: "Welcome to The Handbook!"
+
+      switch_user :kevin
+      get book_slug_path(books(:handbook))
+      assert_toc_titles include: "Renamed Page", exclude: "Welcome to The Handbook!"
+    end
+  end
+
+  test "permission checks do not grow with the number of entries" do
+    before = count_queries_matching(/FROM "accesses"/) { get book_slug_path(books(:handbook)) }
+
+    10.times { |i| books(:handbook).press Section.new(body: "Section #{i}"), title: "Section #{i}" }
+
+    after = count_queries_matching(/FROM "accesses"/) { get book_slug_path(books(:handbook)) }
+
+    assert_equal before, after
+  end
+
+  private
+    def switch_user(user)
+      sign_out
+      sign_in user
+    end
+
+    def assert_editor_controls
+      books(:handbook).leaves.active.each do |leaf|
+        assert_select "menu.toc a[href=?]", edit_leafable_path(leaf)
+      end
+      assert_select "menu.toc form.leaf__delete", count: books(:handbook).leaves.active.count
+      assert_select "menu.toc .arrangement__handle", count: books(:handbook).leaves.active.count
+    end
+
+    def assert_no_editor_controls
+      books(:handbook).leaves.active.each do |leaf|
+        assert_select "menu.toc a[href=?]", edit_leafable_path(leaf), count: 0
+      end
+      assert_select "menu.toc form.leaf__delete", count: 0
+      assert_select "menu.toc .arrangement__handle", count: 0
+    end
+
+    def assert_toc_titles(include:, exclude:)
+      assert_select "menu.toc .toc__title span", text: include
+      assert_select "menu.toc .toc__title span", text: exclude, count: 0
+    end
+
+    def count_queries_matching(pattern)
+      count = 0
+      counter = ->(*, payload) { count += 1 if payload[:name] != "SCHEMA" && payload[:sql].match?(pattern) }
+      ActiveSupport::Notifications.subscribed(counter, "sql.active_record") { yield }
+      count
+    end
 end
