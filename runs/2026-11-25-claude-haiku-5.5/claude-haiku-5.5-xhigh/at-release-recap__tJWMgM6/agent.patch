--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "saving a book caches its title and published state" do
+    book = books(:handbook)
+
+    book.update! title: "Renamed Handbook"
+
+    assert_equal({ title: "Renamed Handbook", published: false }, book.cached_recap)
+  end
+
+  test "each book keeps its own recap" do
+    handbook, manual = books(:handbook), books(:manual)
+    handbook.update! title: "Handbook v2"
+    manual.update! title: "Manual v2"
+
+    handbook.update! published: true
+
+    assert_equal({ title: "Handbook v2", published: true }, handbook.cached_recap)
+    assert_equal({ title: "Manual v2", published: false }, manual.cached_recap)
+  end
+
+  test "recaps expire on the configured schedule" do
+    book = books(:handbook)
+    expires_in = Rails.application.config.x.recap.expires_in
+
+    travel_to Time.current do
+      book.update! title: "Renamed Handbook"
+
+      travel expires_in - 1.minute
+      assert_not_nil book.cached_recap
+
+      travel 2.minutes
+      assert_nil book.cached_recap
+    end
+  end
+end
diff --git a/test/models/book/release_test.rb b/test/models/book/release_test.rb
new file mode 100644
index 0000000..556aac2
--- /dev/null
+++ b/test/models/book/release_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Book::ReleaseTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "finalizing a release caches the new title and published state" do
+    book = books(:handbook)
+    assert_not book.published?
+
+    assert Book.finalize_release(book.id, title: "The Final Handbook")
+
+    assert_equal "The Final Handbook", book.reload.title
+    assert_equal({ title: "The Final Handbook", published: true }, book.cached_recap)
+  end
+
+  test "finalizing a release updates the subtitle when given" do
+    book = books(:handbook)
+
+    Book.finalize_release(book.id, title: "The Final Handbook", subtitle: "Second Edition")
+
+    assert_equal "Second Edition", book.reload.subtitle
+  end
+
+  test "finalizing a release keeps the existing subtitle when none is given" do
+    book = books(:handbook)
+    book.update! subtitle: "Original Subtitle"
+
+    Book.finalize_release(book.id, title: "The Final Handbook")
+
+    assert_equal "Original Subtitle", book.reload.subtitle
+  end
+
+  test "finalizing a release does not touch the cached recap of other books" do
+    other = books(:manual)
+    other.update! title: "Manual v2"
+    Book.finalize_release(books(:handbook).id, title: "The Final Handbook")
+
+    assert_equal({ title: "Manual v2", published: false }, other.cached_recap)
+  end
+
+  test "finalizing an already published book does nothing" do
+    book = books(:handbook)
+    book.update! published: true
+    Rails.cache.clear
+
+    assert_not Book.finalize_release(book.id, title: "Renamed")
+
+    assert_equal "Handbook", book.reload.title
+    assert_nil book.cached_recap
+  end
+
+  test "a failed release leaves the book as a draft with no recap written" do
+    book = books(:handbook)
+
+    assert_raises(ActiveRecord::NotNullViolation) do
+      Book.finalize_release(book.id, title: nil)
+    end
+
+    assert_not book.reload.published?
+    assert_equal "Handbook", book.title
+    assert_nil book.cached_recap
+  end
+end
