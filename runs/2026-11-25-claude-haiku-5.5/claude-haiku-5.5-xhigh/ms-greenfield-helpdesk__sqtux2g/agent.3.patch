diff --git a/app/controllers/api/v1/users_controller.rb b/app/controllers/api/v1/users_controller.rb
new file mode 100644
index 0000000..d054975
--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,47 @@
+module Api
+  module V1
+    # Admins manage the business's people. Suspension is the only change they can make to a user.
+    class UsersController < BaseController
+      include Paginatable
+
+      before_action :authenticate_user!
+      before_action :ensure_account_active!
+      before_action :require_admin!
+      before_action :load_user, only: %i[show update]
+
+      rescue_from User::LastAdmin do
+        render_error(422, "validation_failed",
+          "The business must keep at least one active admin, so this user cannot be suspended.",
+          details: {suspended: ["would leave the business without an active admin"]})
+      end
+
+      def index
+        users = @account.users.order(:id)
+        users = users.where(role: checked_enum(:role, User::ROLES)) if params[:role].present?
+        users = users.where(suspended: boolean_value(:suspended, params[:suspended])) if params[:suspended].present?
+        render_page(:users, users) { |user| UserSerializer.new(user).as_json }
+      end
+
+      def show
+        render json: {user: UserSerializer.new(@user).as_json}
+      end
+
+      def update
+        details = envelope(:user, :suspended)
+        unless details.key?(:suspended)
+          return render_error(422, "validation_failed", "Send suspended to change.",
+            details: {suspended: ["is required"]})
+        end
+
+        @user.set_suspended!(boolean_value(:suspended, details[:suspended]))
+        render json: {user: UserSerializer.new(@user).as_json}
+      end
+
+      private
+
+      def load_user
+        @user = @account.users.find(params[:id])
+      end
+    end
+  end
+end
