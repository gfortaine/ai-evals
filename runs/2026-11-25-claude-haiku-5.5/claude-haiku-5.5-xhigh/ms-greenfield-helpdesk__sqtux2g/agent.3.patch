+++ b/test/integration/invitations_test.rb
@@ -0,0 +1,319 @@
+require "test_helper"
+
+class InvitationsTest < ApiIntegrationTest
+  setup do
+    @owner = verified_owner
+    @owner_token = sign_in
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def invite(email: "sam@example.test", role: "agent", token: @owner_token, account: "acme")
+    api(:post, "/api/v1/invitations", body: {invitation: {email:, role:}}, account:, token:)
+  end
+
+  def invitation_id(email: "sam@example.test", role: "agent")
+    invite(email:, role:)
+    assert_response :created
+    json.dig("invitation", "id")
+  end
+
+  test "an admin invites an agent and an admin, and the link goes to the frontend" do
+    invite(email: "sam@example.test", role: "agent")
+
+    assert_response :created
+    invitation = json["invitation"]
+    assert_equal "sam@example.test", invitation["email"]
+    assert_equal "agent", invitation["role"]
+    assert_equal "pending", invitation["status"]
+    assert_nil invitation["accepted_at"]
+    assert_nil invitation["revoked_at"]
+    assert invitation["expires_at"].present?
+    refute invitation.key?("token")
+
+    assert_equal ["sam@example.test"], last_mail.to
+    assert_includes last_mail.body.decoded, "http://localhost:3001/accept-invitation?account=acme&token="
+    token = link_token(last_mail)
+    assert_equal Helpdesk::Token.digest(token), Invitation.find(invitation["id"]).token_digest
+    refute_includes Invitation.find(invitation["id"]).token_digest, token
+
+    invite(email: "lee@example.test", role: "admin")
+    assert_response :created
+    assert_equal "admin", json.dig("invitation", "role")
+  end
+
+  test "the address is normalized" do
+    invite(email: "  Sam@Example.TEST ")
+
+    assert_response :created
+    assert_equal "sam@example.test", json.dig("invitation", "email")
+  end
+
+  test "customers cannot be invited" do
+    invite(role: "customer")
+
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "details", "role").present?
+    assert_equal 0, Invitation.count
+  end
+
+  test "agents cannot invite, list, or manage invitations" do
+    Account.find_by!(subdomain: "acme").users.create!(name: "Pat", email: "pat@acme.test",
+      password: PASSWORD, role: "agent", verified: true)
+    agent_token = sign_in(email: "pat@acme.test")
+
+    invite(token: agent_token)
+    assert_response :forbidden
+    id = invitation_id
+    api(:get, "/api/v1/invitations", account: "acme", token: agent_token)
+    assert_response :forbidden
+    api(:get, "/api/v1/invitations/#{id}", account: "acme", token: agent_token)
+    assert_response :forbidden
+    api(:post, "/api/v1/invitations/#{id}/resend", account: "acme", token: agent_token)
+    assert_response :forbidden
+    api(:delete, "/api/v1/invitations/#{id}", account: "acme", token: agent_token)
+    assert_response :forbidden
+    assert_equal "pending", Invitation.find(id).status(now: Time.current)
+  end
+
+  test "an address that already belongs to a user of the business cannot be invited" do
+    verified_customer(email: "avery@example.test")
+    invite(email: "avery@example.test")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "email").present?
+  end
+
+  test "only one live invitation exists for an address" do
+    invitation_id(email: "sam@example.test", role: "agent")
+
+    invite(email: "sam@example.test", role: "agent")
+    assert_response :unprocessable_entity
+    assert_match(/pending invitation/, json.dig("error", "message"))
+
+    invite(email: "SAM@example.test", role: "admin")
+    assert_response :unprocessable_entity
+    assert_equal 1, Invitation.count
+  end
+
+  test "an expired invitation no longer competes, so the address can be invited again" do
+    invitation_id(email: "sam@example.test")
+
+    travel(Invitation::TTL + 1.minute) do
+      invite(email: "sam@example.test", role: "admin")
+      assert_response :created
+      assert_equal "pending", json.dig("invitation", "status")
+    end
+    assert_equal 2, Invitation.count
+  end
+
+  test "a revoked invitation no longer competes" do
+    id = invitation_id(email: "sam@example.test")
+    api(:delete, "/api/v1/invitations/#{id}", account: "acme", token: @owner_token)
+
+    invite(email: "sam@example.test")
+    assert_response :created
+  end
+
+  test "the same address may be invited by another business" do
+    invitation_id(email: "sam@example.test")
+    verified_owner(subdomain: "globex", email: "jo@globex.test")
+    globex_token = sign_in(email: "jo@globex.test", account: "globex")
+
+    invite(email: "sam@example.test", account: "globex", token: globex_token)
+    assert_response :created
+  end
+
+  test "lists invitations by ID ascending and filters them by status" do
+    first = invitation_id(email: "a@example.test")
+    second = invitation_id(email: "b@example.test", role: "admin")
+    third = invitation_id(email: "c@example.test")
+    api(:delete, "/api/v1/invitations/#{second}", account: "acme", token: @owner_token)
+
+    api(:get, "/api/v1/invitations", account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [first, second, third], json["invitations"].pluck("id")
+    assert_equal 3, json["count"]
+    assert_equal %w[pending revoked pending], json["invitations"].pluck("status")
+
+    api(:get, "/api/v1/invitations?status=revoked", account: "acme", token: @owner_token)
+    assert_equal [second], json["invitations"].pluck("id")
+
+    api(:get, "/api/v1/invitations?status=pending", account: "acme", token: @owner_token)
+    assert_equal [first, third], json["invitations"].pluck("id")
+
+    api(:get, "/api/v1/invitations?status=accepted", account: "acme", token: @owner_token)
+    assert_equal [], json["invitations"]
+    assert_equal 0, json["count"]
+  end
+
+  test "a status filter outside the known statuses is refused" do
+    api(:get, "/api/v1/invitations?status=archived", account: "acme", token: @owner_token)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "status").present?
+  end
+
+  test "tracks expired invitations by time" do
+    id = invitation_id
+    travel(Invitation::TTL + 1.minute) do
+      api(:get, "/api/v1/invitations/#{id}", account: "acme", token: @owner_token)
+      assert_equal "expired", json.dig("invitation", "status")
+
+      api(:get, "/api/v1/invitations?status=expired", account: "acme", token: @owner_token)
+      assert_equal [id], json["invitations"].pluck("id")
+    end
+  end
+
+  test "inspects one invitation, including who sent it" do
+    id = invitation_id
+
+    api(:get, "/api/v1/invitations/#{id}", account: "acme", token: @owner_token)
+
+    assert_response :ok
+    assert_equal id, json.dig("invitation", "id")
+    assert_equal({"id" => @owner.id, "name" => "Jo"}, json.dig("invitation", "invited_by"))
+  end
+
+  test "another business's invitation is not found" do
+    id = invitation_id
+    verified_owner(subdomain: "globex", email: "jo@globex.test")
+    globex_token = sign_in(email: "jo@globex.test", account: "globex")
+
+    api(:get, "/api/v1/invitations/#{id}", account: "globex", token: globex_token)
+    assert_response :not_found
+    api(:delete, "/api/v1/invitations/#{id}", account: "globex", token: globex_token)
+    assert_response :not_found
+    assert_equal "pending", Invitation.find(id).status
+  end
+
+  test "resending replaces the link and restarts the expiry" do
+    id = invitation_id
+    old_token = link_token(last_mail)
+    travel 2.days do
+      api(:post, "/api/v1/invitations/#{id}/resend", account: "acme", token: @owner_token)
+      assert_response :ok
+      assert_equal "pending", json.dig("invitation", "status")
+      assert_in_delta (Time.current + Invitation::TTL).to_i, Time.iso8601(json.dig("invitation", "expires_at")).to_i, 1
+      assert_equal 2, ActionMailer::Base.deliveries.size
+      refute_equal old_token, link_token(last_mail)
+      assert_equal Helpdesk::Token.digest(link_token(last_mail)), Invitation.find(id).token_digest
+    end
+  end
+
+  test "an expired invitation can be resent and becomes pending again" do
+    id = invitation_id
+    travel(Invitation::TTL + 1.minute) do
+      api(:post, "/api/v1/invitations/#{id}/resend", account: "acme", token: @owner_token)
+
+      assert_response :ok
+      assert_equal "pending", json.dig("invitation", "status")
+      assert_equal 2, ActionMailer::Base.deliveries.size
+    end
+  end
+
+  test "an accepted invitation cannot be resent" do
+    id = invitation_id
+    api(:post, "/api/v1/invitation_acceptances", body: {
+      invitation_acceptance: {token: link_token(last_mail), name: "Sam", password: "my-team-password"}
+    }, account: "acme")
+    assert_response :created
+
+    api(:post, "/api/v1/invitations/#{id}/resend", account: "acme", token: @owner_token)
+    assert_response :unprocessable_entity
+    assert_equal "already_accepted", json.dig("error", "code")
+  end
+
+  test "resending an expired invitation is refused while another invitation for the address is pending" do
+    first = invitation_id(email: "sam@example.test")
+    travel(Invitation::TTL + 1.minute) do
+      invite(email: "sam@example.test", role: "admin")
+      assert_response :created
+
+      api(:post, "/api/v1/invitations/#{first}/resend", account: "acme", token: @owner_token)
+      assert_response :unprocessable_entity
+      assert_equal "validation_failed", json.dig("error", "code")
+    end
+  end
+
+  test "revoking stops the link from working and is final" do
+    id = invitation_id
+    token = link_token(last_mail)
+
+    api(:delete, "/api/v1/invitations/#{id}", account: "acme", token: @owner_token)
+
+    assert_response :ok
+    assert_equal "revoked", json.dig("invitation", "status")
+    assert json.dig("invitation", "revoked_at").present?
+    assert_equal "revoked", Invitation.find(id).status
+
+    api(:post, "/api/v1/invitation_previews", body: {invitation_preview: {token:}}, account: "acme")
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+
+    api(:delete, "/api/v1/invitations/#{id}", account: "acme", token: @owner_token)
+    assert_response :unprocessable_entity
+    assert_equal "already_revoked", json.dig("error", "code")
+
+    api(:post, "/api/v1/invitations/#{id}/resend", account: "acme", token: @owner_token)
+    assert_response :unprocessable_entity
+    assert_equal "already_revoked", json.dig("error", "code")
+  end
+
+  test "an accepted invitation cannot be revoked" do
+    id = invitation_id
+    api(:post, "/api/v1/invitation_acceptances", body: {
+      invitation_acceptance: {token: link_token(last_mail), name: "Sam", password: "my-team-password"}
+    }, account: "acme")
+
+    api(:delete, "/api/v1/invitations/#{id}", account: "acme", token: @owner_token)
+
+    assert_response :unprocessable_entity
+    assert_equal "already_accepted", json.dig("error", "code")
+    assert_equal "accepted", Invitation.find(id).status
+  end
+
+  test "an expired invitation can be revoked" do
+    id = invitation_id
+    travel(Invitation::TTL + 1.minute) do
+      api(:delete, "/api/v1/invitations/#{id}", account: "acme", token: @owner_token)
+      assert_response :ok
+      assert_equal "revoked", json.dig("invitation", "status")
+    end
+  end
+
+  test "unknown invitations are not found" do
+    api(:get, "/api/v1/invitations/999999", account: "acme", token: @owner_token)
+    assert_response :not_found
+  end
+
+  test "invitation routes need a signed-in user of the business" do
+    invitation_id
+    api(:get, "/api/v1/invitations", account: "acme")
+    assert_response :unauthorized
+
+    api(:get, "/api/v1/invitations", token: @owner_token)
+    assert_response :bad_request
+    assert_equal "account_required", json.dig("error", "code")
+  end
+
+  test "a cancelled business cannot send invitations" do
+    Account.find_by!(subdomain: "acme").cancel!
+    owner_token = sign_in # the owner may still sign in during the reactivation window
+
+    invite(token: owner_token)
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+  end
+
+  test "purging a cancelled business removes its invitations along with its people and tickets" do
+    invitation_id
+    verified_customer
+    open_request(token: customer_token)
+    Account.find_by!(subdomain: "acme").cancel!(now: 91.days.ago)
+
+    assert_equal 1, Account.purge_cancelled!
+    assert_equal 0, Invitation.count
+    assert_equal 0, User.count
+  end
+end
