diff --git a/test/integration/invitation_acceptances_test.rb b/test/integration/invitation_acceptances_test.rb
new file mode 100644
index 0000000..4ef2954
--- /dev/null
+++ b/test/integration/invitation_acceptances_test.rb
@@ -0,0 +1,251 @@
+require "test_helper"
+
+class InvitationAcceptancesTest < ApiIntegrationTest
+  TEAM_PASSWORD = "my-team-password"
+
+  setup do
+    @owner = verified_owner
+    @owner_token = sign_in
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def invite(email: "sam@example.test", role: "agent")
+    api(:post, "/api/v1/invitations", body: {invitation: {email:, role:}}, account: "acme", token: @owner_token)
+    assert_response :created
+    link_token(last_mail)
+  end
+
+  def preview(token)
+    api(:post, "/api/v1/invitation_previews", body: {invitation_preview: {token:}}, account: "acme")
+  end
+
+  def accept(token:, name: "Sam", password: TEAM_PASSWORD)
+    api(:post, "/api/v1/invitation_acceptances", body: {
+      invitation_acceptance: {token:, name:, password:}
+    }, account: "acme")
+  end
+
+  test "the preview shows the invited email, role, business name, subdomain and expiry" do
+    token = invite(email: "sam@example.test", role: "agent")
+
+    preview(token)
+
+    assert_response :ok
+    show = json["invitation_preview"]
+    assert_equal({"email" => "sam@example.test", "role" => "agent", "business_name" => "Acme",
+                  "subdomain" => "acme"}, show.slice("email", "role", "business_name", "subdomain"))
+    assert_in_delta (Time.current + Invitation::TTL).to_i, Time.iso8601(show["expires_at"]).to_i, 5
+    refute show.key?("token")
+  end
+
+  test "the preview does not consume the invitation" do
+    token = invite
+
+    preview(token)
+    preview(token)
+
+    assert_response :ok
+    assert_equal "pending", Invitation.last.status
+  end
+
+  test "an unknown, missing or malformed token is refused the same way" do
+    invite
+
+    preview("not-a-real-token")
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+    unknown = json["error"]["message"]
+
+    api(:post, "/api/v1/invitation_previews", body: {invitation_preview: {token: ""}}, account: "acme")
+    assert_response :unprocessable_entity
+    assert_equal unknown, json.dig("error", "message")
+
+    api(:post, "/api/v1/invitation_previews", body: {invitation_preview: {token: {x: 1}}}, account: "acme")
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+  end
+
+  test "accepting creates a verified user with the invited role, without another email" do
+    token = invite(email: "sam@example.test", role: "admin")
+    deliveries = ActionMailer::Base.deliveries.size
+
+    accept(token:, name: "Sam")
+
+    assert_response :created
+    user = json["user"]
+    assert_equal "Sam", user["name"]
+    assert_equal "sam@example.test", user["email"]
+    assert_equal "admin", user["role"]
+    assert_equal true, user["verified"]
+    assert_equal "acme", json.dig("account", "subdomain")
+    assert_equal deliveries, ActionMailer::Base.deliveries.size
+
+    invitation = Invitation.last
+    assert_equal "accepted", invitation.status
+    assert_equal user["id"], invitation.accepted_user_id
+  end
+
+  test "the new user signs in with the password they chose" do
+    token = invite(email: "sam@example.test", role: "agent")
+    accept(token:)
+
+    api(:post, "/api/v1/sessions", body: {session: {email: "sam@example.test", password: TEAM_PASSWORD}},
+      account: "acme")
+
+    assert_response :created
+    assert_equal "agent", json.dig("user", "role")
+    api(:get, "/api/v1/tickets", account: "acme", token: json.dig("session", "token"))
+    assert_response :ok
+  end
+
+  test "an accepted link cannot be used again" do
+    token = invite
+    accept(token:)
+    assert_response :created
+
+    accept(token:, name: "Someone else")
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+
+    preview(token)
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+    assert_equal 1, User.where(email: "sam@example.test").count
+  end
+
+  test "a failed acceptance leaves the invitation pending" do
+    token = invite
+
+    accept(token:, name: "")
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "details", "name").present?
+
+    accept(token:, password: "short")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "password").present?
+
+    accept(token:, password: "")
+    assert_response :unprocessable_entity
+
+    assert_equal "pending", Invitation.last.status
+    assert_equal 0, User.where(email: "sam@example.test").count
+    assert_nil Invitation.last.accepted_user_id
+    accept(token:)
+    assert_response :created
+  end
+
+  test "an expired link cannot be previewed or accepted" do
+    token = invite
+    travel(Invitation::TTL + 1.minute) do
+      preview(token)
+      assert_response :unprocessable_entity
+
+      accept(token:)
+      assert_response :unprocessable_entity
+      assert_equal "invalid_token", json.dig("error", "code")
+    end
+    assert_equal 0, User.where(email: "sam@example.test").count
+  end
+
+  test "a resent invitation makes the earlier link stop working" do
+    old_token = invite
+    Invitation.last.reissue!
+    new_token = link_token(last_mail)
+
+    preview(old_token)
+    assert_response :unprocessable_entity
+    preview(new_token)
+    assert_response :ok
+  end
+
+  test "a resent expired invitation works with the new link" do
+    old_token = invite
+    travel(Invitation::TTL + 1.minute) do
+      Invitation.last.reissue!
+      new_token = link_token(last_mail)
+
+      accept(token: old_token)
+      assert_response :unprocessable_entity
+      accept(token: new_token)
+      assert_response :created
+    end
+  end
+
+  test "a revoked link cannot be accepted" do
+    token = invite
+    Invitation.last.revoke!
+
+    accept(token:)
+
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+    assert_equal 0, User.where(email: "sam@example.test").count
+  end
+
+  test "an invitation cannot be accepted twice, even from a stale copy of it" do
+    token = invite
+    invitation = Invitation.last
+    invitation.accept!(name: "Sam", password: TEAM_PASSWORD)
+
+    assert_raises(Invitation::Closed) do
+      Invitation.find(invitation.id).accept!(name: "Sam again", password: TEAM_PASSWORD)
+    end
+    assert_equal 1, User.where(email: "sam@example.test").count
+    accept(token:)
+    assert_response :unprocessable_entity
+  end
+
+  test "customers cannot register with an address that has a pending invitation" do
+    invite(email: "sam@example.test")
+
+    api(:post, "/api/v1/registrations", body: {user: {name: "Sam", email: "sam@example.test",
+      password: CUSTOMER_PASSWORD}}, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "details", "email").present?
+    assert_equal 0, User.where(role: "customer").count
+  end
+
+  test "customers can register with an address whose invitation has expired or been revoked" do
+    invite(email: "sam@example.test")
+    travel(Invitation::TTL + 1.minute) do
+      api(:post, "/api/v1/registrations", body: {user: {name: "Sam", email: "sam@example.test",
+        password: CUSTOMER_PASSWORD}}, account: "acme")
+      assert_response :created
+    end
+
+    invite(email: "lee@example.test")
+    Invitation.find_by!(email: "lee@example.test").revoke!
+    api(:post, "/api/v1/registrations", body: {user: {name: "Lee", email: "lee@example.test",
+      password: CUSTOMER_PASSWORD}}, account: "acme")
+    assert_response :created
+  end
+
+  test "an invitation to a cancelled business cannot be previewed or accepted" do
+    token = invite
+    Account.find_by!(subdomain: "acme").cancel!
+
+    preview(token)
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+
+    accept(token:)
+    assert_response :forbidden
+    assert_equal 0, User.where(email: "sam@example.test").count
+  end
+
+  test "an invitation accepted as an agent gives access to tickets but not to people" do
+    token = invite(role: "agent")
+    accept(token:)
+    api(:post, "/api/v1/sessions", body: {session: {email: "sam@example.test", password: TEAM_PASSWORD}},
+      account: "acme")
+    agent_token = json.dig("session", "token")
+
+    api(:get, "/api/v1/tickets", account: "acme", token: agent_token)
+    assert_response :ok
+    api(:get, "/api/v1/users", account: "acme", token: agent_token)
+    assert_response :forbidden
+  end
+end
diff --git a/test/integration/invitations_test.rb b/test/integration/invitations_test.rb
new file mode 100644
