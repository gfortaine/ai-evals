diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
new file mode 100644
index 0000000..2ed0616
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,24 @@
+module Api
+  module V1
+    # The invitee sets a name and password. The user is created and verified, so they can sign in
+    # straight away. Signing in is a separate step, as with any other account.
+    class InvitationAcceptancesController < BaseController
+      before_action :ensure_account_active!
+
+      def create
+        details = envelope(:invitation_acceptance, :token, :name, :password)
+        invitation = Invitation.pending_for_token(@account, details[:token].to_s)
+        return render_error(422, "invalid_token", Invitation::INVALID_LINK_MESSAGE) unless invitation
+
+        user = invitation.accept!(name: details[:name], password: details[:password].to_s)
+        render json: {
+          user: UserSerializer.new(user).as_json,
+          account: AccountSerializer.new(@account).as_json
+        }, status: :created
+      rescue Invitation::Closed
+        # Accepted or revoked between the lookup and the lock.
+        render_error(422, "invalid_token", Invitation::INVALID_LINK_MESSAGE)
+      end
+    end
+  end
+end
