+# A request as its customer sees it. Staff get the same record with the requester included.
+class TicketSerializer
+  def initialize(ticket, include_requester: false)
+    @ticket = ticket
+    @include_requester = include_requester
+  end
+
+  def as_json(*)
+    json = {
+      id: @ticket.id,
+      subject: @ticket.subject,
+      status: @ticket.status,
+      requester_id: @ticket.requester_id,
+      created_at: @ticket.created_at,
+      updated_at: @ticket.updated_at
+    }
+    json[:requester] = requester_json if @include_requester
+    json
+  end
+
+  private
+
+  def requester_json
+    requester = @ticket.requester
+    {id: requester.id, name: requester.name, email: requester.email}
+  end
+end
