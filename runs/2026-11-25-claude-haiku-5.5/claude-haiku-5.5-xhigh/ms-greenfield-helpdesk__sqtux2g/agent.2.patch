+module Api
+  module V1
+    # Customers sign up through a business's portal, chosen with the X-Helpdesk-Account header.
+    # The new customer verifies their email and then signs in with the usual flows.
+    class RegistrationsController < BaseController
+      before_action :ensure_account_active!
+
+      def create
+        details = envelope(:user, :name, :email, :password)
+        user = User.register_customer!(@account, name: details[:name], email: details[:email],
+          password: details[:password].to_s)
+        user.send_email_verification!
+
+        render json: {
+          user: UserSerializer.new(user).as_json,
+          message: "Check your email to verify your address before signing in."
+        }, status: :created
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/requests_controller.rb b/app/controllers/api/v1/requests_controller.rb
