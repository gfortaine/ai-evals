@@ -0,0 +1,50 @@
+module Api
+  module V1
+    # Staff view of every request in the business. Customers use RequestsController.
+    class TicketsController < BaseController
+      include Paginatable
+
+      before_action :authenticate_user!
+      before_action :ensure_account_active!
+      before_action :require_staff!
+      before_action :load_ticket, only: %i[show update comments]
+
+      def index
+        render_page(:tickets, @account.tickets.includes(:requester).recent_first) do |ticket|
+          TicketSerializer.new(ticket, include_requester: true).as_json
+        end
+      end
+
+      def show
+        render json: {ticket: TicketSerializer.new(@ticket, include_requester: true).as_json}
+      end
+
+      # A staff reply and/or a status change. A reply alone leaves the status as it is.
+      def update
+        details = envelope(:ticket, :status, comment: %i[body public])
+        comment = details[:comment]
+        changes = details.slice(:status).to_h
+
+        unless comment.present? || changes.any?
+          return render_error(422, "validation_failed", "Send a reply, or a status to change.")
+        end
+
+        @ticket.staff_update!(author: @current_user, comment:, changes:)
+        render json: {ticket: TicketSerializer.new(@ticket, include_requester: true).as_json}
+      end
+
+      # Everything, including private staff notes.
+      def comments
+        render_page(:comments, @ticket.comments.includes(:author)) do |comment|
+          CommentSerializer.new(comment).as_json
+        end
+      end
+
+      private
+
+      def load_ticket
+        @ticket = @account.tickets.includes(:requester).find(params[:id])
+      end
+    end
+  end
+end
