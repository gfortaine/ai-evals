@@ -0,0 +1,19 @@
+class CreateTickets < ActiveRecord::Migration[8.1]
+  # A ticket is a customer's request. Customers see theirs as "requests"; staff see every
+  # ticket in the business as "tickets".
+  def change
+    create_table :tickets do |t|
+      t.references :account, null: false, foreign_key: {on_delete: :cascade}, index: false
+      t.references :requester, null: false, foreign_key: {to_table: :users, on_delete: :cascade}, index: false
+      t.string :subject, null: false
+      t.string :status, null: false, default: "open"
+
+      t.timestamps
+    end
+
+    # Lists are ordered by recent activity, so the indexes match that order.
+    add_index :tickets, [:account_id, :updated_at, :id]
+    add_index :tickets, [:requester_id, :updated_at, :id]
+    add_check_constraint :tickets, "status IN ('open', 'pending', 'solved')", name: "tickets_status_valid"
+  end
+end
