diff --git a/lib/tasks/helpdesk.rake b/lib/tasks/helpdesk.rake
index 12e50a4..9951309 100644
--- a/lib/tasks/helpdesk.rake
+++ b/lib/tasks/helpdesk.rake
@@ -4,4 +4,15 @@ namespace :helpdesk do
     purged = Account.purge_cancelled!
     puts "Purged #{purged} cancelled account(s) past the 90-day reactivation window."
   end
+
+  desc "Delete raw-email blobs no inbound email refers to (left by duplicate deliveries), when older than a day"
+  task purge_orphaned_blobs: :environment do
+    # A blob is attached to its inbound email just after upload, so only blobs older than a day are considered.
+    purged = 0
+    ActiveStorage::Blob.unattached.where(created_at: ...1.day.ago).find_each do |blob|
+      blob.purge
+      purged += 1
+    end
+    puts "Purged #{purged} orphaned blob(s)."
+  end
 end
diff --git a/test/integration/inbound_mail_test.rb b/test/integration/inbound_mail_test.rb
new file mode 100644
index 0000000..4582e4e
--- /dev/null
+++ b/test/integration/inbound_mail_test.rb
@@ -0,0 +1,590 @@
+require "test_helper"
+
+class InboundMailTest < ApiIntegrationTest
+  setup do
+    @saved_password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"]
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = INBOUND_PASSWORD
+    @owner = verified_owner
+    @token = sign_in
+  end
+
+  teardown { ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @saved_password }
+
+  def open_email_ticket(subject: "Cannot download my receipt", from: "avery@example.test")
+    relay(raw_mail(from:, subject:))
+    assert_response :no_content
+    ticket_for(subject)
+  end
+
+  def staff_reply(ticket, body, public: true)
+    api(:patch, "/api/v1/tickets/#{ticket.id}", body: {ticket: {comment: {body:, public:}}}, account: "acme", token: @token)
+    assert_response :ok
+  end
+
+  def set_status(ticket, status)
+    api(:patch, "/api/v1/tickets/#{ticket.id}", body: {ticket: {status:}}, account: "acme", token: @token)
+    assert_response :ok
+  end
+
+  # --- Ingress -------------------------------------------------------------------------------------------------
+
+  test "the relay refuses a missing or wrong password, and records nothing" do
+    relay(raw_mail, password: nil)
+    assert_response :unauthorized
+
+    relay(raw_mail, password: "wrong")
+    assert_response :unauthorized
+
+    assert_empty account_tickets
+    assert_equal 0, inbound_emails.count
+  end
+
+  test "the relay accepts only RFC 822 messages" do
+    post InboundMailHelpers::RELAY_PATH, params: raw_mail, headers: {
+      "CONTENT_TYPE" => "text/plain",
+      "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials("actionmailbox", INBOUND_PASSWORD)
+    }
+    assert_response :unsupported_media_type
+    assert_empty account_tickets
+  end
+
+  test "without RAILS_INBOUND_EMAIL_PASSWORD the relay refuses to run, so no mail is accepted unauthenticated" do
+    ENV.delete("RAILS_INBOUND_EMAIL_PASSWORD")
+    assert_raises(ArgumentError) { relay(raw_mail, password: "") }
+    assert_equal 0, inbound_emails.count
+  end
+
+  test "an accepted delivery is processed before the request completes" do
+    relay(raw_mail(subject: "Receipt"))
+
+    assert_response :no_content
+    assert_equal ["Receipt"], account_tickets.pluck(:subject)
+    assert_equal ["delivered"], inbound_emails.pluck(:status)
+  end
+
+  # --- Opening tickets -----------------------------------------------------------------------------------------
+
+  test "mail to the support address opens an email ticket with its subject and plain-text message" do
+    relay(raw_mail(subject: "Cannot download my receipt", body: "The download button does nothing.\n\nThanks"))
+
+    ticket = ticket_for("Cannot download my receipt")
+    assert_equal "email", ticket.source
+    assert_equal "open", ticket.status
+    assert_equal "normal", ticket.priority
+    comment = ticket.comments.sole
+    assert_equal "The download button does nothing.\n\nThanks", comment.body
+    assert comment.public?
+    assert_equal ticket.requester, comment.author
+    assert_equal "avery@example.test", ticket.requester.email
+  end
+
+  test "a new sender becomes an unverified customer who is sent a verification email" do
+    relay(raw_mail(from: "Avery Smith <Avery@Example.test>"))
+
+    customer = Account.find_by!(subdomain: "acme").users.find_by!(email: "avery@example.test")
+    assert customer.customer?
+    refute customer.verified?
+    assert_equal "Avery Smith", customer.name
+    assert_equal ["avery@example.test"], last_mail.to
+    assert_includes last_mail.body.decoded, "http://localhost:3001/verify-email?account=acme&token="
+  end
+
+  test "a customer created by mail can use the portal once they confirm the link and set a password" do
+    relay(raw_mail)
+    api(:post, "/api/v1/email_verifications/confirm", body: {email_verification: {token: link_token(last_mail)}}, account: "acme")
+    assert_response :ok
+
+    ActionMailer::Base.deliveries.clear
