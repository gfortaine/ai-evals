+    cursor = json["meta"]["after_cursor"]
+
+    verified_owner(subdomain: "other", email: "jo@other.test")
+    other_token = sign_in(email: "jo@other.test", account: "other")
+    api(:get, "/api/v1/tickets?page[size]=1&page[after]=#{CGI.escape(cursor)}", account: "other", token: other_token)
+
+    assert_response :unprocessable_entity
