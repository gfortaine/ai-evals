+# Cursor paging lists a business's people, invitations, groups and memberships in ID order. These indexes let each
+# page be a short range scan within the business. Without them, the scan would skip the rows of other businesses
+# that sit between the page's ID and its own rows.
+class AddAccountIdIndexesForCursorPaging < ActiveRecord::Migration[8.1]
+  def change
+    add_index :users, %i[account_id id]
+    add_index :invitations, %i[account_id id]
+    add_index :groups, %i[account_id id]
+    add_index :group_memberships, %i[account_id id]
+  end
+end
