diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..ccb67e2
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,54 @@
+module Api
+  module V1
+    class AccountsController < BaseController
+      skip_before_action :load_account, only: :create
+      before_action :authenticate_user!, except: :create
+      before_action :require_owner!, only: %i[cancel reactivate]
+
+      def create
+        account = Account.register!(**registration_params)
+        account.owner.send_email_verification!
+
+        render json: {
+          account: AccountSerializer.new(account).as_json,
+          user: UserSerializer.new(account.owner).as_json,
+          message: "Check your email to verify your address before signing in."
+        }, status: :created
+      end
+
+      def show
+        render json: {account: AccountSerializer.new(@account).as_json}
+      end
+
+      def cancel
+        return render_error(422, "already_cancelled", "This business is already cancelled.") if @account.cancelled?
+
+        @account.cancel!
+        render json: {account: AccountSerializer.new(@account).as_json}
+      end
+
+      def reactivate
+        return render_error(422, "not_cancelled", "This business is not cancelled.") unless @account.cancelled?
+
+        unless @account.reactivation_open?
+          return render_error(422, "reactivation_expired",
+            "The 90-day reactivation window has passed. This business is closed.")
+        end
+
+        @account.reactivate!
+        render json: {account: AccountSerializer.new(@account).as_json}
+      end
+
+      private
+
+      def registration_params
+        account = envelope(:account, :name, :subdomain, admin: %i[name email password])
+        {
+          name: account[:name],
+          subdomain: account[:subdomain],
+          admin: account.fetch(:admin, {}).to_h.symbolize_keys
+        }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..1b122ee
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,52 @@
+module Api
+  module V1
+    # Business-scoped endpoints. The X-Helpdesk-Account header selects the business;
+    # the bearer token selects the signed-in user within that business.
+    class BaseController < ApplicationController
+      ACCOUNT_HEADER = "X-Helpdesk-Account".freeze
+
+      before_action :load_account
+
+      private
+
+      def load_account
+        subdomain = request.headers[ACCOUNT_HEADER].to_s.strip.downcase
+        if subdomain.empty?
+          return render_error(400, "account_required", "Send the #{ACCOUNT_HEADER} header to choose a business.")
+        end
+
+        @account = Account.find_by(subdomain:)
+        render_error(404, "account_not_found", "No business exists for that #{ACCOUNT_HEADER} header.") unless @account
+      end
+
+      def authenticate_user!
+        @current_session = UserSession.find_for_account(@account, bearer_token)
+        @current_user = @current_session&.user
+        render_error(401, "unauthorized", "Sign in to continue.") unless @current_user
+      end
+
+      def bearer_token
+        request.authorization.to_s[/\ABearer\s+(\S+)\z/i, 1]
+      end
+
+      # Cancelled businesses stop ordinary access. Endpoints that must still work
+      # (reactivation, account status, sign-out) do not call this.
+      def ensure_account_active!
+        return if @account.active?
+
+        message = if @account.reactivation_open?
+          "This business is cancelled. The owner can sign in and reactivate it until #{@account.reactivate_until.iso8601}."
+        else
+          "This business was cancelled and is closed."
+        end
+        render_error(403, "account_cancelled", message)
+      end
+
+      def require_owner!
+        return if @current_user.owner?
+
+        render_error(403, "forbidden", "Only the account owner can do that.")
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
new file mode 100644
index 0000000..cbad9ae
--- /dev/null
+++ b/app/controllers/api/v1/email_verifications_controller.rb
@@ -0,0 +1,24 @@
+module Api
+  module V1
+    class EmailVerificationsController < BaseController
+      def create
+        email = envelope(:email_verification, :email)[:email].to_s.strip.downcase
+        user = @account.users.find_by(email:)
+        user.send_email_verification! if user && !user.verified?
+
+        # The same response whether or not the email is registered, so the endpoint cannot be used to look up accounts.
+        render json: {message: "If that email has an unverified account, a verification link is on its way."},
+          status: :accepted
+      end
+
+      def confirm
+        token = envelope(:email_verification, :token)[:token]
+        user = User.with_email_verification_token(@account, token.to_s)
+        return render_error(422, "invalid_token", "This verification link is invalid or has expired.") unless user
+
+        user.verify_email!
+        render json: {user: UserSerializer.new(user).as_json, message: "Email verified. You can now sign in."}
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/password_changes_controller.rb b/app/controllers/api/v1/password_changes_controller.rb
new file mode 100644
index 0000000..8884d5d
--- /dev/null
+++ b/app/controllers/api/v1/password_changes_controller.rb
@@ -0,0 +1,21 @@
+module Api
+  module V1
+    class PasswordChangesController < BaseController
+      before_action :authenticate_user!
+      before_action :ensure_account_active!
+
+      def update
+        change = envelope(:password_change, :current_password, :password)
+
+        unless @current_user.authenticate(change[:current_password].to_s)
+          return render_error(422, "invalid_current_password", "Current password is incorrect.",
+            details: {current_password: ["is incorrect"]})
+        end
+
+        # Signs out every session, including this one.
+        @current_user.set_password!(change[:password])
+        render json: {message: "Password changed. Sign in again with your new password."}
+      end
+    end
+  end
+end
