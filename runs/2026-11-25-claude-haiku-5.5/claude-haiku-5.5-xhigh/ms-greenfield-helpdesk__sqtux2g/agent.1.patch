+    api(:get, "/api/v1/portal", account: "acme")
+
+    assert_response :ok
+    assert_equal({"name" => "Acme Support", "subdomain" => "acme"}, json["portal"])
+  end
+
+  test "GET /portal needs the business header and a known business" do
+    api(:get, "/api/v1/portal")
+    assert_response :bad_request
+
+    api(:get, "/api/v1/portal", account: "nope")
+    assert_response :not_found
+    assert_equal "account_not_found", json.dig("error", "code")
+  end
+end
+
+class CorsTest < ApiIntegrationTest
+  FRONTEND = "http://localhost:3001"
+
+  test "responses to the configured frontend origin carry CORS headers" do
+    signup
+
+    get "/api/v1/portal", headers: {"Origin" => FRONTEND, HEADER => "acme"}
+
+    assert_response :ok
+    assert_equal FRONTEND, header("Access-Control-Allow-Origin")
+    assert_includes header("Vary").to_s, "Origin"
+  end
+
+  test "preflight requests from the frontend may use the API's methods and headers" do
+    process :options, "/api/v1/me", headers: {
+      "Origin" => FRONTEND,
+      "Access-Control-Request-Method" => "PATCH",
+      "Access-Control-Request-Headers" => "authorization,content-type,x-helpdesk-account"
+    }
+
+    assert_response :no_content
+    assert_equal FRONTEND, header("Access-Control-Allow-Origin")
+    assert_includes header("Access-Control-Allow-Methods"), "PATCH"
+    allowed = header("Access-Control-Allow-Headers").downcase
+    %w[authorization content-type x-helpdesk-account].each { |name| assert_includes allowed, name }
+  end
+
+  test "other origins get no CORS allowance" do
+    signup
+    get "/api/v1/portal", headers: {"Origin" => "https://evil.test", HEADER => "acme"}
+
+    assert_response :ok
+    assert_nil header("Access-Control-Allow-Origin")
+
+    process :options, "/api/v1/me", headers: {
+      "Origin" => "https://evil.test", "Access-Control-Request-Method" => "GET"
+    }
+    assert_response :forbidden
+    assert_nil header("Access-Control-Allow-Origin")
+  end
+
+  test "the allowed origin follows HELPDESK_FRONTEND_URL" do
+    with_env("HELPDESK_FRONTEND_URL" => "https://desk.acme.test/app/") do
+      signup
+      get "/api/v1/portal", headers: {"Origin" => "https://desk.acme.test", HEADER => "acme"}
+      assert_equal "https://desk.acme.test", header("Access-Control-Allow-Origin")
+    end
+  end
+end
diff --git a/test/integration/profile_test.rb b/test/integration/profile_test.rb
