diff --git a/test/integration/account_lifecycle_test.rb b/test/integration/account_lifecycle_test.rb
new file mode 100644
index 0000000..cb92d07
--- /dev/null
+++ b/test/integration/account_lifecycle_test.rb
@@ -0,0 +1,203 @@
+require "test_helper"
+
+class AccountLifecycleTest < ApiIntegrationTest
+  setup do
+    @owner = verified_owner
+    @token = sign_in
+    @agent = @owner.account.users.create!(name: "Sam", email: "sam@acme.test", password: PASSWORD,
+      role: "agent", verified: true)
+    @agent_token = sign_in(email: "sam@acme.test")
+  end
+
+  def cancel_as_owner(token = @token)
+    api(:post, "/api/v1/account/cancel", account: "acme", token:)
+    assert_response :ok
+  end
+
+  test "GET /account returns the full account to a signed-in user" do
+    api(:get, "/api/v1/account", account: "acme", token: @token)
+
+    assert_response :ok
+    account = json.fetch("account")
+    assert_equal Account.find_by!(subdomain: "acme").id, account["id"]
+    assert_equal "Acme", account["name"]
+    assert_equal "acme", account["subdomain"]
+    assert_equal "active", account["status"]
+    assert_nil account["cancelled_at"]
+    assert_nil account["reactivate_until"]
+    assert account["created_at"].present?
+  end
+
+  test "GET /account requires a session" do
+    api(:get, "/api/v1/account", account: "acme")
+
+    assert_response :unauthorized
+  end
+
+  test "the owner cancels: sessions are revoked, ordinary access stops, and users cannot sign in" do
+    api(:post, "/api/v1/account/cancel", account: "acme", token: @token)
+
+    assert_response :ok
+    assert_equal "cancelled", json.dig("account", "status")
+    cancelled_at = Time.zone.parse(json.dig("account", "cancelled_at"))
+    assert_in_delta((cancelled_at + 90.days).to_i, Time.zone.parse(json.dig("account", "reactivate_until")).to_i, 1)
+
+    api(:get, "/api/v1/me", account: "acme", token: @token)
+    assert_response :unauthorized
+    api(:get, "/api/v1/me", account: "acme", token: @agent_token)
+    assert_response :unauthorized
+
+    api(:get, "/api/v1/portal", account: "acme")
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+
+    api(:post, "/api/v1/sessions", body: {session: {email: "sam@acme.test", password: PASSWORD}}, account: "acme")
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+  end
+
+  test "the owner can still sign in to reactivate, and reactivation restores access" do
+    cancel_as_owner
+
+    token = sign_in
+    api(:get, "/api/v1/account", account: "acme", token:)
+    assert_equal "cancelled", json.dig("account", "status")
+
+    api(:post, "/api/v1/account/reactivate", account: "acme", token:)
+
+    assert_response :ok
+    assert_equal "active", json.dig("account", "status")
+    assert_nil json.dig("account", "cancelled_at")
+
+    api(:get, "/api/v1/portal", account: "acme")
+    assert_response :ok
+    sign_in(email: "sam@acme.test")
+  end
+
+  test "while cancelled, the owner's session can only read the account, reactivate, or sign out" do
+    cancel_as_owner
+    token = sign_in
+
+    api(:get, "/api/v1/me", account: "acme", token:)
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+
+    api(:patch, "/api/v1/me", body: {user: {name: "Jo Smith"}}, account: "acme", token:)
+    assert_response :forbidden
+
+    api(:delete, "/api/v1/session", account: "acme", token:)
+    assert_response :no_content
+  end
+
+  test "only the owner can cancel" do
+    api(:post, "/api/v1/account/cancel", account: "acme", token: @agent_token)
+
+    assert_response :forbidden
+    assert_equal "forbidden", json.dig("error", "code")
+    assert_equal "active", Account.find_by!(subdomain: "acme").status
+  end
+
+  test "cancelling twice and reactivating an active account are refused" do
+    cancel_as_owner
+    token = sign_in
+
+    api(:post, "/api/v1/account/cancel", account: "acme", token:)
+    assert_response :unprocessable_entity
+    assert_equal "already_cancelled", json.dig("error", "code")
+
+    api(:post, "/api/v1/account/reactivate", account: "acme", token:)
+    assert_response :ok
+
+    api(:post, "/api/v1/account/reactivate", account: "acme", token:)
+    assert_response :unprocessable_entity
+    assert_equal "not_cancelled", json.dig("error", "code")
+  end
+
+  test "reactivation is allowed up to 90 days after cancellation" do
+    cancel_as_owner
+    travel 89.days do
+      token = sign_in
+      api(:post, "/api/v1/account/reactivate", account: "acme", token:)
+      assert_response :ok
+    end
+  end
+
+  test "after 90 days the owner cannot sign in or reactivate, even with a session from inside the window" do
+    cancel_as_owner
+    token_inside_window = nil
+    travel 10.days do
+      token_inside_window = sign_in
+    end
+
+    travel 90.days + 1.minute do
+      api(:post, "/api/v1/sessions", body: {session: {email: "jo@acme.test", password: PASSWORD}}, account: "acme")
+      assert_response :forbidden
+      assert_equal "account_cancelled", json.dig("error", "code")
+
+      api(:post, "/api/v1/account/reactivate", account: "acme", token: token_inside_window)
+      assert_response :unprocessable_entity
+      assert_equal "reactivation_expired", json.dig("error", "code")
+
+      api(:get, "/api/v1/me", account: "acme", token: token_inside_window)
+      assert_response :forbidden
+    end
+  end
+
+  test "the purge task permanently deletes accounts cancelled 90+ days ago, with all their data" do
+    cancel_as_owner
+    Rails.application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+    task = Rake::Task["helpdesk:purge_cancelled_accounts"]
+
+    travel 91.days do
+      task.reenable
+      assert_output(/Purged 1 cancelled account/) { task.invoke }
+    end
+
+    assert_nil Account.find_by(subdomain: "acme")
+    assert_equal 0, User.count
+    assert_equal 0, UserSession.count
+  end
+
+  test "the purge keeps active accounts and accounts still inside the 90-day window" do
+    other = verified_owner(subdomain: "globex", email: "ann@globex.test")
+    cancel_as_owner
+    Rails.application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+    task = Rake::Task["helpdesk:purge_cancelled_accounts"]
+
+    travel 89.days do
+      task.reenable
+      capture_io { task.invoke }
+    end
+
+    assert Account.exists?(subdomain: "acme")
+    assert Account.exists?(subdomain: "globex")
+    assert User.exists?(other.id)
+  end
+
+  test "an owner who reactivates before the deadline is not purged" do
+    cancel_as_owner
+    travel 89.days do
+      token = sign_in
+      api(:post, "/api/v1/account/reactivate", account: "acme", token:)
+      assert_response :ok
+    end
+
+    travel 120.days do
+      Account.purge_cancelled!
+    end
+
+    assert Account.exists?(subdomain: "acme")
+    assert_equal "active", Account.find_by!(subdomain: "acme").status
+  end
+
+  test "a purged subdomain can be used for a new business" do
+    cancel_as_owner
+    travel 91.days do
+      Account.purge_cancelled!
+      signup(subdomain: "acme", name: "Acme Again", email: "new@acme.test")
+    end
+
+    assert_response :created
+    assert_equal "Acme Again", json.dig("account", "name")
+  end
+end
diff --git a/test/integration/email_verifications_test.rb b/test/integration/email_verifications_test.rb
