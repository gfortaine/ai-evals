new file mode 100644
index 0000000..efe4aeb
--- /dev/null
+++ b/app/controllers/api/v1/sessions_controller.rb
@@ -0,0 +1,47 @@
+module Api
+  module V1
+    class SessionsController < BaseController
+      # Checked when the email is unknown, so that failed sign-ins take about as long either way.
+      DUMMY_PASSWORD_DIGEST = BCrypt::Password.create(SecureRandom.hex(16)).freeze
+
+      before_action :authenticate_user!, only: :destroy
+
+      def create
+        credentials = envelope(:session, :email, :password)
+        user = authenticate(credentials[:email].to_s.strip.downcase, credentials[:password].to_s)
+        return render_error(401, "invalid_credentials", "Email or password is incorrect.") unless user
+
+        # A cancelled business admits only its owner, and only until the reactivation window closes.
+        if @account.cancelled? && !(user.id == @account.owner_id && @account.reactivation_open?)
+          return render_error(403, "account_cancelled", "This business is cancelled.")
+        end
+
+        return render_error(403, "email_not_verified", "Verify your email before signing in.") unless user.verified?
+
+        session = UserSession.start!(user)
+        render json: {
+          session: UserSessionSerializer.new(session).as_json,
+          user: UserSerializer.new(user).as_json,
+          account: AccountSerializer.new(@account).as_json
+        }, status: :created
+      end
+
+      def destroy
+        @current_session.destroy!
+        head :no_content
+      end
+
+      private
+
+      def authenticate(email, password)
+        user = @account.users.find_by(email:)
+        unless user
+          BCrypt::Password.new(DUMMY_PASSWORD_DIGEST).is_password?(password)
+          return nil
+        end
+
+        user if user.authenticate(password)
+      end
+    end
+  end
+end
diff --git a/app/controllers/application_controller.rb b/app/controllers/application_controller.rb
new file mode 100644
index 0000000..30ed238
--- /dev/null
+++ b/app/controllers/application_controller.rb
@@ -0,0 +1,41 @@
+class ApplicationController < ActionController::API
+  wrap_parameters false
+
+  rescue_from ActionController::ParameterMissing do |error|
+    render_error(400, "parameter_missing", error.message)
+  end
+
+  rescue_from ActionDispatch::Http::Parameters::ParseError do
+    render_error(400, "invalid_json", "Request body must be valid JSON.")
+  end
+
+  rescue_from ActiveRecord::RecordInvalid do |error|
+    render_error(422, "validation_failed", error.record.errors.full_messages.to_sentence,
+      details: error.record.errors.to_hash)
+  end
+
+  rescue_from Account::RegistrationInvalid do |error|
+    render_error(422, "validation_failed", error.message, details: error.details)
+  end
+
+  rescue_from ActiveRecord::RecordNotFound do
+    render_error(404, "not_found", "The requested record was not found.")
+  end
+
+  private
+
+  def render_error(status, code, message, details: nil)
+    error = {code:, message:}
+    error[:details] = details if details.present?
+    render json: {error:}, status:
+  end
+
+  # Reads a required envelope such as {"user": {...}}, keeping only the listed fields.
+  # Nested hashes are described as keyword arguments, e.g. envelope(:account, :name, admin: [:email]).
+  def envelope(key, *fields, **nested)
+    value = params.require(key)
+    raise ActionController::ParameterMissing.new(key) unless value.is_a?(ActionController::Parameters)
+
+    value.permit(*fields, **nested)
+  end
+end
