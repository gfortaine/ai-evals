+++ b/test/integration/sessions_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class SessionsTest < ApiIntegrationTest
+  test "an owner who has not verified their email cannot sign in" do
+    signup
+
+    api(:post, "/api/v1/sessions", body: {session: {email: "jo@acme.test", password: PASSWORD}}, account: "acme")
+
+    assert_response :forbidden
+    assert_equal "email_not_verified", json.dig("error", "code")
+  end
+
+  test "a verified owner signs in and receives a bearer token with the user and account" do
+    owner = verified_owner
+
+    api(:post, "/api/v1/sessions", body: {session: {email: "jo@acme.test", password: PASSWORD}}, account: "acme")
+
+    assert_response :created
+    assert json.dig("session", "token").present?
+    assert_equal owner.id, json.dig("user", "id")
+    assert_equal "admin", json.dig("user", "role")
+    assert_equal true, json.dig("user", "verified")
+    assert_equal "acme", json.dig("account", "subdomain")
+  end
+
+  test "wrong passwords and unknown emails get the same response" do
+    verified_owner
+
+    api(:post, "/api/v1/sessions", body: {session: {email: "jo@acme.test", password: "wrong-password"}}, account: "acme")
+    assert_response :unauthorized
+    wrong_password = json
+
+    api(:post, "/api/v1/sessions", body: {session: {email: "nobody@acme.test", password: PASSWORD}}, account: "acme")
+    assert_response :unauthorized
+    assert_equal wrong_password, json
+    assert_equal "invalid_credentials", json.dig("error", "code")
+  end
+
+  test "the same email signs into each business with that business's own password" do
+    verified_owner(subdomain: "acme", password: PASSWORD)
+    verified_owner(subdomain: "globex", password: "globex-password")
+
+    acme_token = sign_in(account: "acme", password: PASSWORD)
+    globex_token = sign_in(account: "globex", password: "globex-password")
+    refute_equal acme_token, globex_token
+
+    api(:post, "/api/v1/sessions", body: {session: {email: "jo@acme.test", password: PASSWORD}}, account: "globex")
+    assert_response :unauthorized
+  end
+
+  test "a token only works in the business that issued it" do
+    verified_owner(subdomain: "acme")
+    verified_owner(subdomain: "globex")
+    token = sign_in(account: "acme")
+
+    api(:get, "/api/v1/me", account: "globex", token:)
+
+    assert_response :unauthorized
+  end
+
+  test "sign-in must name a business that exists" do
+    api(:post, "/api/v1/sessions", body: {session: {email: "jo@acme.test", password: PASSWORD}}, account: nil)
+    assert_response :bad_request
+    assert_equal "account_required", json.dig("error", "code")
+
+    api(:post, "/api/v1/sessions", body: {session: {email: "jo@acme.test", password: PASSWORD}}, account: "nope")
+    assert_response :not_found
+    assert_equal "account_not_found", json.dig("error", "code")
+  end
+
+  test "DELETE /session signs out only the session that made the request" do
+    verified_owner
+    this_session = sign_in
+    other_session = sign_in
+
+    api(:delete, "/api/v1/session", account: "acme", token: this_session)
+    assert_response :no_content
+
+    api(:get, "/api/v1/me", account: "acme", token: this_session)
+    assert_response :unauthorized
+
+    api(:get, "/api/v1/me", account: "acme", token: other_session)
+    assert_response :ok
+  end
+
+  test "missing or malformed bearer tokens are rejected" do
+    verified_owner
+
+    api(:get, "/api/v1/me", account: "acme")
+    assert_response :unauthorized
+    assert_equal "unauthorized", json.dig("error", "code")
+
+    api(:get, "/api/v1/me", account: "acme", token: "not-a-real-token")
+    assert_response :unauthorized
+  end
+end
diff --git a/test/integration/signup_test.rb b/test/integration/signup_test.rb
