index 0000000..cb92d07
--- /dev/null
+++ b/test/integration/account_lifecycle_test.rb
@@ -0,0 +1,203 @@
+require "test_helper"
+
+class AccountLifecycleTest < ApiIntegrationTest
+  setup do
+    @owner = verified_owner
+    @token = sign_in
+    @agent = @owner.account.users.create!(name: "Sam", email: "sam@acme.test", password: PASSWORD,
+      role: "agent", verified: true)
+    @agent_token = sign_in(email: "sam@acme.test")
+  end
+
+  def cancel_as_owner(token = @token)
+    api(:post, "/api/v1/account/cancel", account: "acme", token:)
+    assert_response :ok
+  end
+
+  test "GET /account returns the full account to a signed-in user" do
+    api(:get, "/api/v1/account", account: "acme", token: @token)
+
+    assert_response :ok
+    account = json.fetch("account")
+    assert_equal Account.find_by!(subdomain: "acme").id, account["id"]
+    assert_equal "Acme", account["name"]
+    assert_equal "acme", account["subdomain"]
+    assert_equal "active", account["status"]
+    assert_nil account["cancelled_at"]
+    assert_nil account["reactivate_until"]
+    assert account["created_at"].present?
+  end
+
+  test "GET /account requires a session" do
+    api(:get, "/api/v1/account", account: "acme")
+
+    assert_response :unauthorized
+  end
+
+  test "the owner cancels: sessions are revoked, ordinary access stops, and users cannot sign in" do
+    api(:post, "/api/v1/account/cancel", account: "acme", token: @token)
+
+    assert_response :ok
+    assert_equal "cancelled", json.dig("account", "status")
+    cancelled_at = Time.zone.parse(json.dig("account", "cancelled_at"))
+    assert_in_delta((cancelled_at + 90.days).to_i, Time.zone.parse(json.dig("account", "reactivate_until")).to_i, 1)
+
+    api(:get, "/api/v1/me", account: "acme", token: @token)
+    assert_response :unauthorized
+    api(:get, "/api/v1/me", account: "acme", token: @agent_token)
+    assert_response :unauthorized
+
+    api(:get, "/api/v1/portal", account: "acme")
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+
+    api(:post, "/api/v1/sessions", body: {session: {email: "sam@acme.test", password: PASSWORD}}, account: "acme")
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+  end
+
+  test "the owner can still sign in to reactivate, and reactivation restores access" do
+    cancel_as_owner
+
+    token = sign_in
+    api(:get, "/api/v1/account", account: "acme", token:)
+    assert_equal "cancelled", json.dig("account", "status")
+
+    api(:post, "/api/v1/account/reactivate", account: "acme", token:)
+
+    assert_response :ok
+    assert_equal "active", json.dig("account", "status")
+    assert_nil json.dig("account", "cancelled_at")
+
+    api(:get, "/api/v1/portal", account: "acme")
+    assert_response :ok
+    sign_in(email: "sam@acme.test")
+  end
+
+  test "while cancelled, the owner's session can only read the account, reactivate, or sign out" do
+    cancel_as_owner
+    token = sign_in
+
+    api(:get, "/api/v1/me", account: "acme", token:)
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+
+    api(:patch, "/api/v1/me", body: {user: {name: "Jo Smith"}}, account: "acme", token:)
+    assert_response :forbidden
+
+    api(:delete, "/api/v1/session", account: "acme", token:)
+    assert_response :no_content
+  end
+
+  test "only the owner can cancel" do
+    api(:post, "/api/v1/account/cancel", account: "acme", token: @agent_token)
+
+    assert_response :forbidden
+    assert_equal "forbidden", json.dig("error", "code")
+    assert_equal "active", Account.find_by!(subdomain: "acme").status
+  end
+
+  test "cancelling twice and reactivating an active account are refused" do
+    cancel_as_owner
+    token = sign_in
+
+    api(:post, "/api/v1/account/cancel", account: "acme", token:)
+    assert_response :unprocessable_entity
+    assert_equal "already_cancelled", json.dig("error", "code")
+
+    api(:post, "/api/v1/account/reactivate", account: "acme", token:)
+    assert_response :ok
+
+    api(:post, "/api/v1/account/reactivate", account: "acme", token:)
+    assert_response :unprocessable_entity
+    assert_equal "not_cancelled", json.dig("error", "code")
+  end
+
+  test "reactivation is allowed up to 90 days after cancellation" do
+    cancel_as_owner
+    travel 89.days do
+      token = sign_in
+      api(:post, "/api/v1/account/reactivate", account: "acme", token:)
+      assert_response :ok
+    end
+  end
+
+  test "after 90 days the owner cannot sign in or reactivate, even with a session from inside the window" do
+    cancel_as_owner
+    token_inside_window = nil
+    travel 10.days do
+      token_inside_window = sign_in
+    end
+
+    travel 90.days + 1.minute do
+      api(:post, "/api/v1/sessions", body: {session: {email: "jo@acme.test", password: PASSWORD}}, account: "acme")
+      assert_response :forbidden
+      assert_equal "account_cancelled", json.dig("error", "code")
+
+      api(:post, "/api/v1/account/reactivate", account: "acme", token: token_inside_window)
+      assert_response :unprocessable_entity
+      assert_equal "reactivation_expired", json.dig("error", "code")
+
+      api(:get, "/api/v1/me", account: "acme", token: token_inside_window)
+      assert_response :forbidden
+    end
+  end
+
+  test "the purge task permanently deletes accounts cancelled 90+ days ago, with all their data" do
+    cancel_as_owner
+    Rails.application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+    task = Rake::Task["helpdesk:purge_cancelled_accounts"]
+
+    travel 91.days do
+      task.reenable
+      assert_output(/Purged 1 cancelled account/) { task.invoke }
+    end
+
+    assert_nil Account.find_by(subdomain: "acme")
+    assert_equal 0, User.count
+    assert_equal 0, UserSession.count
+  end
+
+  test "the purge keeps active accounts and accounts still inside the 90-day window" do
+    other = verified_owner(subdomain: "globex", email: "ann@globex.test")
+    cancel_as_owner
+    Rails.application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+    task = Rake::Task["helpdesk:purge_cancelled_accounts"]
+
+    travel 89.days do
+      task.reenable
+      capture_io { task.invoke }
+    end
+
+    assert Account.exists?(subdomain: "acme")
+    assert Account.exists?(subdomain: "globex")
+    assert User.exists?(other.id)
+  end
+
+  test "an owner who reactivates before the deadline is not purged" do
+    cancel_as_owner
+    travel 89.days do
+      token = sign_in
+      api(:post, "/api/v1/account/reactivate", account: "acme", token:)
+      assert_response :ok
+    end
+
+    travel 120.days do
+      Account.purge_cancelled!
+    end
+
+    assert Account.exists?(subdomain: "acme")
+    assert_equal "active", Account.find_by!(subdomain: "acme").status
+  end
+
+  test "a purged subdomain can be used for a new business" do
+    cancel_as_owner
+    travel 91.days do
+      Account.purge_cancelled!
+      signup(subdomain: "acme", name: "Acme Again", email: "new@acme.test")
+    end
+
+    assert_response :created
+    assert_equal "Acme Again", json.dig("account", "name")
+  end
+end
diff --git a/test/integration/cursor_pagination_test.rb b/test/integration/cursor_pagination_test.rb
new file mode 100644
index 0000000..673abb5
--- /dev/null
+++ b/test/integration/cursor_pagination_test.rb
@@ -0,0 +1,468 @@
+require "test_helper"
+
+# Cursor paging: ?page[size]=N, then page[after] or page[before], with cursors from the previous response.
+# Each list keeps the order the page-number API gives it.
+class CursorPaginationTest < ApiIntegrationTest
+  setup do
+    @owner = verified_owner
+    @owner_token = sign_in
+    verified_customer
+    @avery_token = customer_token
+  end
+
+  # Opens `count` requests as Avery. Returns their IDs, oldest first.
+  def open_requests(count, prefix: "Request")
+    Array.new(count) { |i| open_request(token: @avery_token, subject: "#{prefix} #{i + 1}") }
+  end
+
+  def get_json(url, token: @owner_token)
+    api(:get, url, account: "acme", token:)
+    assert_response :ok, "GET #{url} => #{response.body}"
+    json
+  end
+
+  def ids_in(body, key)
+    body[key].pluck("id")
+  end
+
+  # The pages of a list, starting at `url` and following links.next until there is no next page.
+  def walk_forward(url, token: @owner_token)
+    pages = [get_json(url, token:)]
+    while (link = pages.last.dig("links", "next"))
+      pages << get_json(link, token:)
+      raise "walk did not end" if pages.size > 200
+    end
+    pages
+  end
+
+  # The page at `url`, then the pages before it, following links.prev until there is no previous page.
+  def walk_back(url, token: @owner_token)
+    pages = [get_json(url, token:)]
+    while (link = pages.last.dig("links", "prev"))
+      pages << get_json(link, token:)
+      raise "walk did not end" if pages.size > 200
+    end
+    pages
+  end
+
+  def query_path(path, query)
+    "#{path}#{path.include?("?") ? "&" : "?"}#{query}"
+  end
+
+  # Every record of a list, in the order the page-number API gives them.
+  def numbered_ids(path, key, token: @owner_token)
+    ids_in(get_json(query_path(path, "per_page=100"), token:), key)
+  end
+
+  # Walking forward with cursors gives the same records in the same order as the page-number API.
+  def assert_walk_matches_numbered_list(path, key, token: @owner_token, size: 2)
+    expected = numbered_ids(path, key, token:)
+    walked = walk_forward(query_path(path, "page[size]=#{size}"), token:).flat_map { |page| ids_in(page, key) }
+
+    assert_equal expected, walked, "cursor walk of #{path} differs from the page-number order"
+  end
+
+  test "the first page has the cursor envelope and the records, with no count" do
+    open_requests(3)
+
+    get_json("/api/v1/tickets?page[size]=2&status=open")
+
+    assert_equal %w[links meta tickets], json.keys.sort
+    assert_equal 2, json["tickets"].size
+    assert_equal %w[after_cursor before_cursor has_more], json["meta"].keys.sort
+    assert_equal true, json["meta"]["has_more"]
+    assert json["meta"]["after_cursor"].present?
+    assert json["meta"]["before_cursor"].present?
+    assert_nil json["links"]["prev"]
+    assert_match(%r{\Ahttp://www\.example\.com/api/v1/tickets\?}, json["links"]["next"])
+  end
+
+  test "an empty list gives the envelope with null cursors and links" do
+    get_json("/api/v1/tickets?page[size]=25&status=open")
+
+    assert_equal({"tickets" => [], "meta" => {"has_more" => false, "after_cursor" => nil, "before_cursor" => nil},
+                  "links" => {"next" => nil, "prev" => nil}}, json)
+  end
+
+  test "a populated page has cursors for its first and last records, and page[after] continues from the last" do
+    ids = open_requests(3)
+    newest_first = ids.reverse
+
+    get_json("/api/v1/tickets?page[size]=2")
+    assert_equal newest_first.first(2), ids_in(json, "tickets")
+    after_cursor = json["meta"]["after_cursor"]
+
+    get_json("/api/v1/tickets?page[size]=2&page[after]=#{CGI.escape(after_cursor)}")
+    assert_equal [newest_first.last], ids_in(json, "tickets")
+    assert_equal false, json["meta"]["has_more"]
+  end
+
+  test "following next visits every record once, in the page-number order" do
+    open_requests(7)
+
+    pages = walk_forward("/api/v1/tickets?page[size]=3")
+
+    assert_equal [3, 3, 1], pages.map { |page| page["tickets"].size }
+    assert_equal numbered_ids("/api/v1/tickets", "tickets"), pages.flat_map { |page| ids_in(page, "tickets") }
+  end
+
+  test "has_more and the links say whether there is more in each direction" do
+    open_requests(5)
+
+    first, middle, last = walk_forward("/api/v1/tickets?page[size]=2")
+
+    assert_equal [true, true, false], [first, middle, last].map { |page| page["meta"]["has_more"] }
+    assert_nil first["links"]["prev"]
+    assert middle["links"]["prev"].present?
+    assert middle["links"]["next"].present?
+    assert_nil last["links"]["next"]
+    assert last["links"]["prev"].present?
+  end
+
+  test "walking back from the last page visits the earlier pages in reverse" do
+    open_requests(5)
+    forward = walk_forward("/api/v1/tickets?page[size]=2")
+    last_page = forward.last
+
+    back = walk_back(last_page["links"]["prev"])
+
+    assert_equal forward.first(2).map { |page| ids_in(page, "tickets") }.reverse,
+      back.map { |page| ids_in(page, "tickets") }
+    assert_equal [true, false], back.map { |page| page["meta"]["has_more"] }
+  end
+
+  test "page[before] has_more answers for the direction being browsed" do
+    ids = open_requests(5)
+    newest_first = ids.reverse
+    last_page = walk_forward("/api/v1/tickets?page[size]=2").last
+    assert_equal newest_first.last(1), ids_in(last_page, "tickets")
+
+    get_json("/api/v1/tickets?page[size]=2&page[before]=#{CGI.escape(last_page["meta"]["before_cursor"])}")
+
+    assert_equal newest_first[2, 2], ids_in(json, "tickets")
+    assert_equal true, json["meta"]["has_more"], "more records lie before this page"
+    assert json["links"]["prev"].present?
+    assert json["links"]["next"].present?, "the last page follows this one"
+
+    get_json("/api/v1/tickets?page[size]=2&page[before]=#{CGI.escape(json["meta"]["before_cursor"])}")
+    assert_equal newest_first.first(2), ids_in(json, "tickets")
+    assert_equal false, json["meta"]["has_more"]
+    assert_nil json["links"]["prev"]
+  end
+
+  test "a page past the end is empty, with null cursors and links" do
+    open_requests(2)
+    last_page = walk_forward("/api/v1/tickets?page[size]=2").last
+
+    get_json("/api/v1/tickets?page[size]=2&page[after]=#{CGI.escape(last_page["meta"]["after_cursor"])}")
+
+    assert_equal [], json["tickets"]
+    assert_equal({"has_more" => false, "after_cursor" => nil, "before_cursor" => nil}, json["meta"])
+    assert_equal({"next" => nil, "prev" => nil}, json["links"])
+  end
+
+  test "page[size] above 100 is capped at 100, and the next link keeps the capped size" do
+    avery = User.find_by!(email: "avery@example.test")
+    101.times { |i| Ticket.open!(requester: avery, subject: "Bulk #{i}", body: "Bulk body") }
+
+    get_json("/api/v1/tickets?page[size]=500")
+
+    assert_equal 100, json["tickets"].size
+    assert_equal "100", Rack::Utils.parse_nested_query(URI(json["links"]["next"]).query).dig("page", "size")
+  end
+
+  test "the links keep the filters and the page size" do
+    open_requests(3)
+
+    get_json("/api/v1/tickets?page[size]=2&status=open&priority=normal")
+
+    query = Rack::Utils.parse_nested_query(URI(json["links"]["next"]).query)
+    assert_equal({"page" => {"size" => "2", "after" => json["meta"]["after_cursor"]},
+                  "status" => "open", "priority" => "normal"}, query)
+  end
+
+  test "filters, including the text search, combine with cursors" do
+    open_request(token: @avery_token, subject: "Receipt 1")
+    open_request(token: @avery_token, subject: "Login")
+    open_request(token: @avery_token, subject: "Receipt 2")
+    open_request(token: @avery_token, subject: "Refund", body: "The receipt was wrong")
+    open_request(token: @avery_token, subject: "Unrelated")
+    solved = open_request(token: @avery_token, subject: "Receipt 3")
+    Ticket.find(solved).update!(status: "solved")
+
+    walked = walk_forward("/api/v1/tickets?page[size]=1&q=receipt&status=open")
+               .flat_map { |page| ids_in(page, "tickets") }
+
+    assert_equal 3, walked.size
+    assert_equal numbered_ids("/api/v1/tickets?q=receipt&status=open", "tickets"), walked
+  end
+
+  test "cursor pages do not count the list" do
+    open_requests(4)
+    counts = []
+    callback = ->(*, payload) { counts << payload[:sql] if payload[:sql].match?(/COUNT\(/i) }
+
+    ActiveSupport::Notifications.subscribed(callback, "sql.active_record") do
+      walk_forward("/api/v1/tickets?page[size]=2")
+    end
+
+    assert_empty counts
+  end
+
+  test "records with the same updated_at are each listed once, in ID order" do
+    ids = open_requests(6)
+    Ticket.where(id: ids).update_all(updated_at: Time.utc(2026, 1, 1, 12))
+
+    walked = walk_forward("/api/v1/tickets?page[size]=2").flat_map { |page| ids_in(page, "tickets") }
+
+    assert_equal ids.reverse, walked
+    assert_equal numbered_ids("/api/v1/tickets", "tickets"), walked
+  end
+
+  test "records one microsecond apart keep their order across pages" do
+    ids = open_requests(5)
+    base = Time.utc(2026, 1, 1, 12)
+    ids.each_with_index { |id, i| Ticket.where(id:).update_all(updated_at: base + Rational(i, 1_000_000)) }
+
+    walked = walk_forward("/api/v1/tickets?page[size]=1").flat_map { |page| ids_in(page, "tickets") }
+
+    assert_equal ids.reverse, walked
+  end
+
+  test "requests opened while browsing do not shift or repeat the pages" do
+    ids = open_requests(6)
+    first = get_json("/api/v1/tickets?page[size]=2")
+    assert_equal ids.last(2).reverse, ids_in(first, "tickets")
+
+    open_requests(2, prefix: "Late")
+    second = get_json(first["links"]["next"])
+
+    assert_equal ids[2, 2].reverse, ids_in(second, "tickets")
+  end
+
+  test "a reply to a request already read does not repeat it on the next page" do
+    ids = open_requests(6)
+    first = get_json("/api/v1/tickets?page[size]=2")
+
+    customer_reply(ids.last)
+    second = get_json(first["links"]["next"])
+
+    assert_equal ids[2, 2].reverse, ids_in(second, "tickets")
+    assert_equal [ids.last], ids_in(get_json("/api/v1/tickets?page[size]=1"), "tickets")
+  end
+
+  test "the record a cursor points at can change without breaking the cursor" do
+    ids = open_requests(5)
+    first = get_json("/api/v1/tickets?page[size]=2")
+    assert_equal ids[3, 2].reverse, ids_in(first, "tickets")
+
+    # The cursor names request 4, the last record on the page. Its activity moves it to the top.
+    customer_reply(ids[3])
+    second = get_json(first["links"]["next"])
+
+    assert_equal ids[1, 2].reverse, ids_in(second, "tickets")
+  end
+
+  test "a request that gets activity before it is reached moves to the top, as the list order says" do
+    ids = open_requests(5)
+    first = get_json("/api/v1/tickets?page[size]=2")
+    assert_equal ids.last(2).reverse, ids_in(first, "tickets")
+
+    customer_reply(ids[0])
+    second = get_json(first["links"]["next"])
+
+    # The unread request now sits at the top, so the walk does not reach it again. It is not repeated either.
+    assert_equal ids[1, 2].reverse, ids_in(second, "tickets")
+    assert_equal ids[0], ids_in(get_json("/api/v1/tickets?page[size]=1"), "tickets").first
+  end
+
+  test "deleting records while browsing keeps the cursor working, even the record it points at" do
+    memberships = 4.times.map do |i|
+      api(:post, "/api/v1/groups", body: {group: {name: "Team #{i}"}}, account: "acme", token: @owner_token)
+      group_id = json["group"]["id"]
+      api(:post, "/api/v1/group_memberships", body: {group_membership: {group_id:, user_id: @owner.id}},
+        account: "acme", token: @owner_token)
+      json["group_membership"]["id"]
+    end
+
+    first = get_json("/api/v1/group_memberships?page[size]=2")
+    assert_equal memberships.first(2), ids_in(first, "group_memberships")
+
+    # The record the next cursor points at is deleted, and so is the one before it.
+    api(:delete, "/api/v1/group_memberships/#{memberships[1]}", account: "acme", token: @owner_token)
+    api(:delete, "/api/v1/group_memberships/#{memberships[0]}", account: "acme", token: @owner_token)
+    second = get_json(first["links"]["next"])
+
+    assert_equal memberships[2, 2], ids_in(second, "group_memberships")
+  end
+
+  test "every list supports cursors and walks in the page-number order" do
+    open_requests(5)
+    get_json("/api/v1/tickets?per_page=1")
+    ticket_id = json["tickets"].first["id"]
+    3.times { |i| customer_reply(ticket_id, body: "Follow-up #{i}") }
+    private_note(ticket_id)
+
+    verified_customer(email: "sam@example.test", name: "Sam")
+    verified_customer(email: "pat@example.test", name: "Pat")
+    3.times do |i|
+      Account.find_by!(subdomain: "acme").users.create!(name: "Agent #{i}", email: "agent#{i}@acme.test",
+        password: PASSWORD, role: "agent", verified: true)
+    end
+    3.times do |i|
+      api(:post, "/api/v1/invitations", body: {invitation: {email: "invite#{i}@example.test", role: "agent"}},
+        account: "acme", token: @owner_token)
+    end
+    3.times do |i|
+      api(:post, "/api/v1/groups", body: {group: {name: "Queue #{i}"}}, account: "acme", token: @owner_token)
+      api(:post, "/api/v1/group_memberships", body: {group_membership: {group_id: json["group"]["id"],
+        user_id: @owner.id}}, account: "acme", token: @owner_token)
+    end
+
+    assert_walk_matches_numbered_list("/api/v1/tickets", "tickets")
+    assert_walk_matches_numbered_list("/api/v1/requests", "requests", token: @avery_token)
+    assert_walk_matches_numbered_list("/api/v1/tickets/#{ticket_id}/comments", "comments")
+    assert_walk_matches_numbered_list("/api/v1/requests/#{ticket_id}/comments", "comments", token: @avery_token)
+    assert_walk_matches_numbered_list("/api/v1/users", "users")
+    assert_walk_matches_numbered_list("/api/v1/staff", "staff")
+    assert_walk_matches_numbered_list("/api/v1/groups", "groups")
+    assert_walk_matches_numbered_list("/api/v1/invitations", "invitations")
+    assert_walk_matches_numbered_list("/api/v1/group_memberships", "group_memberships")
+  end
+
+  test "staff see private notes in the ticket's comments, and customers do not see them in the request's" do
+    id = open_requests(1).first
+    3.times { |i| customer_reply(id, body: "Reply #{i}") }
+    private_note(id)
+
+    get_json("/api/v1/tickets/#{id}/comments?page[size]=2")
+    assert_equal 2, json["comments"].size
+    assert_equal true, json["meta"]["has_more"]
+    staff_walk = walk_forward("/api/v1/tickets/#{id}/comments?page[size]=2").flat_map { |p| p["comments"] }
+    assert_equal 5, staff_walk.size
+    assert_includes staff_walk.map { |c| c["public"] }, false
+
+    customer_walk = walk_forward("/api/v1/requests/#{id}/comments?page[size]=2", token: @avery_token)
+                      .flat_map { |p| p["comments"] }
+    assert_equal 4, customer_walk.size
+    assert customer_walk.all? { |c| c["public"] }
+  end
+
+  test "a cursor from one list is refused on another" do
+    open_requests(3)
+    get_json("/api/v1/tickets?page[size]=2")
+    cursor = json["meta"]["after_cursor"]
+
+    api(:get, "/api/v1/requests?page[size]=2&page[after]=#{CGI.escape(cursor)}", account: "acme", token: @avery_token)
+
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "details", "page[after]").present?
+  end
+
+  test "a cursor from one ticket's comments is refused on another ticket" do
+    id = open_requests(1).first
+    other = open_requests(1, prefix: "Other").first
+    3.times { |i| customer_reply(id, body: "Reply #{i}") }
+    get_json("/api/v1/tickets/#{id}/comments?page[size]=2")
+    cursor = json["meta"]["after_cursor"]
+
+    api(:get, "/api/v1/tickets/#{other}/comments?page[size]=2&page[after]=#{CGI.escape(cursor)}", account: "acme",
+      token: @owner_token)
+
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+  end
+
+  test "a cursor from another business is refused" do
+    open_requests(2)
+    get_json("/api/v1/tickets?page[size]=1")
+    cursor = json["meta"]["after_cursor"]
+
+    verified_owner(subdomain: "other", email: "jo@other.test")
+    other_token = sign_in(email: "jo@other.test", account: "other")
+    api(:get, "/api/v1/tickets?page[size]=1&page[after]=#{CGI.escape(cursor)}", account: "other", token: other_token)
+
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+  end
+
+  test "a cursor that was altered, or is not a cursor at all, is refused" do
+    open_requests(2)
+    get_json("/api/v1/tickets?page[size]=1")
+    cursor = json["meta"]["after_cursor"]
+    altered = cursor.sub(/.\z/) { |c| (c == "a") ? "b" : "a" }
+
+    ["garbage", altered, "#{cursor}x", "#{cursor.split("--").first}--0000"].each do |bad|
+      api(:get, "/api/v1/tickets?page[size]=1&page[after]=#{CGI.escape(bad)}", account: "acme", token: @owner_token)
+      assert_response :unprocessable_entity, "cursor #{bad.inspect} should be refused"
+      assert json.dig("error", "details", "page[after]").present?
+    end
+  end
+
+  test "malformed or contradictory cursor options are refused" do
+    open_requests(2)
+    get_json("/api/v1/tickets?page[size]=1")
+    after = CGI.escape(json["meta"]["after_cursor"])
+
+    {
+      "page[size]=0" => "page[size]",
+      "page[size]=abc" => "page[size]",
+      "page[size]=1.5" => "page[size]",
+      "page[size]=-2" => "page[size]",
+      "page[size][x]=1" => "page[size]",
+      "page[after][]=1" => "page[after]",
+      "page[after]=#{after}&page[before]=#{after}" => "page[before]",
+      "page[size]=1&page[offset]=3" => "page[offset]",
+      "page[size]=1&per_page=2" => "per_page",
+      "page[size]=1&page[after]=#{after}&per_page=2" => "per_page",
+      "page[size]=1&page=2" => "page"
+    }.each do |query, field|
+      api(:get, "/api/v1/tickets?#{query}", account: "acme", token: @owner_token)
+      assert_response :unprocessable_entity, "#{query} should be refused, got #{response.status}: #{response.body}"
+      assert json.dig("error", "details", field).present?, "#{query} should name #{field}: #{response.body}"
+    end
+  end
+
+  test "an empty page[size] uses the default of 25" do
+    open_requests(2)
+
+    get_json("/api/v1/tickets?page[size]=")
+
+    assert_equal 2, json["tickets"].size
+  end
+
+  test "the page-number API is unchanged and has no cursor envelope" do
+    open_requests(3)
+
+    get_json("/api/v1/tickets?page=1&per_page=2")
+
+    assert_equal %w[count next_page page per_page previous_page tickets], json.keys.sort
+    assert_equal 2, json["next_page"]
+  end
+
+  test "a customer's cursor walk covers only their own requests" do
+    verified_customer(email: "sam@example.test", name: "Sam")
+    sam_token = customer_token(email: "sam@example.test")
+    open_requests(3)
+    open_request(token: sam_token, subject: "Sam's problem")
+
+    walked = walk_forward("/api/v1/requests?page[size]=2", token: @avery_token).flat_map { |p| p["requests"] }
+
+    assert_equal 3, walked.size
+    assert walked.none? { |request| request["subject"] == "Sam's problem" }
+  end
+
+  private
+
+  def customer_reply(id, body: "Still broken")
+    api(:patch, "/api/v1/requests/#{id}", body: {request: {comment: {body:}}}, account: "acme", token: @avery_token)
+    assert_response :ok
+  end
+
+  def private_note(id)
+    api(:patch, "/api/v1/tickets/#{id}", body: {ticket: {comment: {body: "Internal note", public: false}}},
+      account: "acme", token: @owner_token)
+    assert_response :ok
+  end
+end
diff --git a/test/integration/customer_registration_test.rb b/test/integration/customer_registration_test.rb
new file mode 100644
index 0000000..55b283e
--- /dev/null
+++ b/test/integration/customer_registration_test.rb
@@ -0,0 +1,160 @@
+require "test_helper"
+
+class CustomerRegistrationTest < ApiIntegrationTest
+  test "a customer registers through the portal as an unverified customer and gets a verification link" do
+    signup
+    register_customer
+
+    assert_response :created
+    user = json.fetch("user")
+    assert_kind_of Integer, user["id"]
+    assert_equal Account.find_by!(subdomain: "acme").id, user["account_id"]
+    assert_equal "Avery", user["name"]
+    assert_equal "avery@example.test", user["email"]
+    assert_equal "customer", user["role"]
+    assert_equal false, user["verified"]
+    refute_match(/password/i, response.body)
+    assert json.fetch("message").present?
+
+    assert_equal ["avery@example.test"], last_mail.to
+    assert_includes last_mail.body.decoded, "http://localhost:3001/verify-email?account=acme&token="
+  end
+
+  test "a new customer cannot sign in until the emailed link is confirmed" do
+    signup
+    register_customer
+    token = link_token(last_mail)
+
+    api(:post, "/api/v1/sessions", body: {session: {email: "avery@example.test", password: CUSTOMER_PASSWORD}},
+      account: "acme")
+    assert_response :forbidden
+    assert_equal "email_not_verified", json.dig("error", "code")
+
+    api(:post, "/api/v1/email_verifications/confirm", body: {email_verification: {token:}}, account: "acme")
+    assert_response :ok
+    assert customer_token.present?
+  end
+
+  test "the verification, sign-in, profile and recovery flows all work for a customer" do
+    signup
+    verified_customer
+    token = customer_token
+
+    api(:get, "/api/v1/me", account: "acme", token:)
+    assert_response :ok
+    assert_equal "customer", json.dig("user", "role")
+    assert_equal true, json.dig("user", "verified")
+
+    api(:patch, "/api/v1/me", body: {user: {name: "Avery Stone"}}, account: "acme", token:)
+    assert_response :ok
+    assert_equal "Avery Stone", json.dig("user", "name")
+
+    ActionMailer::Base.deliveries.clear
+    api(:post, "/api/v1/password_resets", body: {password_reset: {email: "avery@example.test"}}, account: "acme")
+    assert_response :accepted
+    reset_token = link_token(last_mail)
+    api(:post, "/api/v1/password_resets/confirm",
+      body: {password_reset: {token: reset_token, password: "a-brand-new-password"}}, account: "acme")
+    assert_response :ok
+
+    api(:get, "/api/v1/me", account: "acme", token:)
+    assert_response :unauthorized, "a password reset signs out every session"
+
+    new_token = customer_token(password: "a-brand-new-password")
+    assert new_token.present?
+  end
+
+  test "the role cannot be chosen by the client" do
+    signup
+    api(:post, "/api/v1/registrations", body: {
+      user: {name: "Mallory", email: "mallory@example.test", password: CUSTOMER_PASSWORD, role: "admin"}
+    }, account: "acme")
+
+    assert_response :created
+    assert_equal "customer", json.dig("user", "role")
+    assert_equal "customer", User.find_by!(email: "mallory@example.test").role
+  end
+
+  test "an email already registered in the same portal is refused, even if unverified" do
+    signup
+    verified_customer
+    register_customer(name: "Someone Else")
+
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "details", "email").present?
+    assert_equal 1, User.where(email: "avery@example.test").count
+  end
+
+  test "the same email may register with a different business" do
+    signup
+    signup(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    verified_customer(account: "acme")
+    register_customer(account: "globex")
+
+    assert_response :created
+    assert_equal 2, User.where(email: "avery@example.test").count
+  end
+
+  test "invalid details are rejected with field errors and nothing is created" do
+    signup
+    ActionMailer::Base.deliveries.clear
+    api(:post, "/api/v1/registrations", body: {
+      user: {name: "", email: "not-an-email", password: "short"}
+    }, account: "acme")
+
+    assert_response :unprocessable_entity
+    details = json.dig("error", "details")
+    assert details["name"].present?
+    assert details["email"].present?
+    assert details["password"].present?
+    assert_equal 1, User.count
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "a missing password is refused" do
+    signup
+    api(:post, "/api/v1/registrations", body: {user: {name: "Avery", email: "avery@example.test"}}, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "password").present?
+  end
+
+  test "requires the user envelope and a known portal" do
+    signup
+    api(:post, "/api/v1/registrations", body: {name: "Avery"}, account: "acme")
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+
+    api(:post, "/api/v1/registrations", body: {user: {name: "A", email: "a@example.test", password: CUSTOMER_PASSWORD}})
+    assert_response :bad_request
+    assert_equal "account_required", json.dig("error", "code")
+
+    api(:post, "/api/v1/registrations", body: {user: {name: "A", email: "a@example.test", password: CUSTOMER_PASSWORD}},
+      account: "nope")
+    assert_response :not_found
+    assert_equal "account_not_found", json.dig("error", "code")
+  end
+
+  test "a cancelled business accepts no new customers" do
+    signup
+    Account.find_by!(subdomain: "acme").cancel!
+
+    register_customer
+
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+    assert_equal 1, User.count
+  end
+
+  test "an unverified customer can ask for a new verification link" do
+    signup
+    register_customer
+    ActionMailer::Base.deliveries.clear
+
+    api(:post, "/api/v1/email_verifications", body: {email_verification: {email: "avery@example.test"}}, account: "acme")
+
+    assert_response :accepted
+    assert_equal ["avery@example.test"], last_mail.to
+  end
+end
diff --git a/test/integration/customer_requests_test.rb b/test/integration/customer_requests_test.rb
new file mode 100644
index 0000000..c0bb3b8
--- /dev/null
+++ b/test/integration/customer_requests_test.rb
@@ -0,0 +1,237 @@
+require "test_helper"
+
+class CustomerRequestsTest < ApiIntegrationTest
+  setup do
+    signup
+    @avery = verified_customer
+    @token = customer_token
+  end
+
+  def open_as_customer(subject: "Cannot download my receipt", body: "The download button does nothing.", token: @token)
+    api(:post, "/api/v1/requests", body: {request: {subject:, comment: {body:}}}, account: "acme", token:)
+  end
+
+  test "opens a request that is open and owned by the customer, with its first comment" do
+    open_as_customer
+
+    assert_response :created
+    request = json.fetch("request")
+    assert_kind_of Integer, request["id"]
+    assert_equal "Cannot download my receipt", request["subject"]
+    assert_equal "open", request["status"]
+    assert_equal @avery.id, request["requester_id"]
+    assert request["created_at"].present?
+    assert request["updated_at"].present?
+    refute request.key?("requester"), "customers see the requester ID only"
+
+    api(:get, "/api/v1/requests/#{request["id"]}/comments", account: "acme", token: @token)
+    comment = json.fetch("comments").sole
+    assert_equal "The download button does nothing.", comment["body"]
+    assert_equal({"id" => @avery.id, "name" => "Avery"}, comment["author"])
+    assert_equal true, comment["public"]
+    assert comment["created_at"].present?
+  end
+
+  test "a request needs a subject and a first comment body" do
+    api(:post, "/api/v1/requests", body: {request: {subject: "", comment: {body: "Help"}}}, account: "acme", token: @token)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "subject").present?
+
+    api(:post, "/api/v1/requests", body: {request: {subject: "Receipt"}}, account: "acme", token: @token)
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+
+    assert_equal 0, Ticket.count
+    assert_equal 0, Comment.count
+  end
+
+  test "requests must be sent by a signed-in customer" do
+    api(:post, "/api/v1/requests", body: {request: {subject: "Receipt", comment: {body: "Help"}}}, account: "acme")
+    assert_response :unauthorized
+    assert_equal 0, Ticket.count
+  end
+
+  test "lists only the customer's own requests" do
+    mine = open_request(token: @token, subject: "Mine")
+    verified_customer(email: "sam@example.test", name: "Sam")
+    open_request(token: customer_token(email: "sam@example.test"), subject: "Not mine")
+
+    api(:get, "/api/v1/requests", account: "acme", token: @token)
+
+    assert_response :ok
+    assert_equal ["Mine"], json["requests"].pluck("subject")
+    assert_equal [mine], json["requests"].pluck("id")
+    assert_equal 1, json["count"]
+  end
+
+  test "lists the most recently active requests first" do
+    first = open_request(token: @token, subject: "First")
+    second = open_request(token: @token, subject: "Second")
+
+    api(:get, "/api/v1/requests", account: "acme", token: @token)
+    assert_equal [second, first], json["requests"].pluck("id")
+
+    api(:patch, "/api/v1/requests/#{first}", body: {request: {comment: {body: "Still broken"}}},
+      account: "acme", token: @token)
+    api(:get, "/api/v1/requests", account: "acme", token: @token)
+    assert_equal [first, second], json["requests"].pluck("id")
+  end
+
+  test "shows one of the customer's own requests" do
+    id = open_request(token: @token)
+
+    api(:get, "/api/v1/requests/#{id}", account: "acme", token: @token)
+
+    assert_response :ok
+    assert_equal id, json.dig("request", "id")
+    assert_equal "open", json.dig("request", "status")
+  end
+
+  test "another customer's request is not found" do
+    id = open_request(token: @token)
+    verified_customer(email: "sam@example.test", name: "Sam")
+    sam = customer_token(email: "sam@example.test")
+
+    api(:get, "/api/v1/requests/#{id}", account: "acme", token: sam)
+    assert_response :not_found
+    assert_equal "not_found", json.dig("error", "code")
+
+    api(:get, "/api/v1/requests/#{id}/comments", account: "acme", token: sam)
+    assert_response :not_found
+
+    api(:patch, "/api/v1/requests/#{id}", body: {request: {comment: {body: "Hi"}}}, account: "acme", token: sam)
+    assert_response :not_found
+    assert_equal 1, Comment.count
+  end
+
+  test "customers cannot use the staff routes" do
+    id = open_request(token: @token)
+
+    api(:get, "/api/v1/tickets", account: "acme", token: @token)
+    assert_response :forbidden
+    assert_equal "forbidden", json.dig("error", "code")
+
+    api(:get, "/api/v1/tickets/#{id}", account: "acme", token: @token)
+    assert_response :forbidden
+
+    api(:patch, "/api/v1/tickets/#{id}", body: {ticket: {status: "solved"}}, account: "acme", token: @token)
+    assert_response :forbidden
+    assert_equal "open", Ticket.find(id).status
+  end
+
+  test "comments on a request are oldest first and never include staff-only notes" do
+    id = open_request(token: @token)
+    ticket = Ticket.find(id)
+    owner = User.find_by!(email: "jo@acme.test")
+    ticket.comments.create!(author: owner, body: "Internal: refund approved", public: false)
+    ticket.comments.create!(author: owner, body: "Please try again now.", public: true)
+
+    api(:get, "/api/v1/requests/#{id}/comments", account: "acme", token: @token)
+
+    assert_response :ok
+    bodies = json["comments"].pluck("body")
+    assert_equal ["The download button does nothing.", "Please try again now."], bodies
+    assert json["comments"].all? { |c| c["public"] == true }
+    assert_equal({"id" => owner.id, "name" => "Jo"}, json["comments"].last["author"])
+    assert_equal 1, json["page"]
+    assert_equal 2, json["count"]
+  end
+
+  test "a customer reply on a pending request reopens it" do
+    id = open_request(token: @token)
+    Ticket.find(id).update!(status: "pending")
+
+    api(:patch, "/api/v1/requests/#{id}", body: {request: {comment: {body: "Still no receipt."}}},
+      account: "acme", token: @token)
+
+    assert_response :ok
+    assert_equal "open", json.dig("request", "status")
+    assert_equal "open", Ticket.find(id).status
+    assert_equal "Still no receipt.", Comment.order(:id).last.body
+  end
+
+  test "a customer reply on a solved request reopens it" do
+    id = open_request(token: @token)
+    Ticket.find(id).update!(status: "solved")
+
+    api(:patch, "/api/v1/requests/#{id}", body: {request: {comment: {body: "It happened again."}}},
+      account: "acme", token: @token)
+
+    assert_response :ok
+    assert_equal "open", json.dig("request", "status")
+  end
+
+  test "a customer reply that also marks the request solved leaves it solved" do
+    id = open_request(token: @token)
+    Ticket.find(id).update!(status: "pending")
+
+    api(:patch, "/api/v1/requests/#{id}",
+      body: {request: {status: "solved", comment: {body: "Found it, thanks."}}}, account: "acme", token: @token)
+
+    assert_response :ok
+    assert_equal "solved", json.dig("request", "status")
+    assert_equal "solved", Ticket.find(id).status
+    assert_equal 2, Comment.count
+  end
+
+  test "a customer can mark a request solved without replying" do
+    id = open_request(token: @token)
+
+    api(:patch, "/api/v1/requests/#{id}", body: {request: {status: "solved"}}, account: "acme", token: @token)
+
+    assert_response :ok
+    assert_equal "solved", json.dig("request", "status")
+    assert_equal 1, Comment.count
+  end
+
+  test "customers cannot set a status other than solved" do
+    id = open_request(token: @token)
+
+    %w[pending open bogus].each do |status|
+      api(:patch, "/api/v1/requests/#{id}", body: {request: {status:, comment: {body: "Hi"}}},
+        account: "acme", token: @token)
+      assert_response :unprocessable_entity, "#{status} should be refused"
+      assert json.dig("error", "details", "status").present?
+    end
+
+    assert_equal "open", Ticket.find(id).status
+    assert_equal 1, Comment.count
+  end
+
+  test "a reply sent as plain text is refused rather than silently dropped" do
+    id = open_request(token: @token)
+
+    api(:patch, "/api/v1/requests/#{id}", body: {request: {comment: "Still broken", status: "solved"}},
+      account: "acme", token: @token)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "comment").present?
+    assert_equal "open", Ticket.find(id).status
+    assert_equal 1, Comment.count
+
+    api(:post, "/api/v1/requests", body: {request: {subject: "Receipt", comment: "Help"}}, account: "acme", token: @token)
+    assert_response :unprocessable_entity
+    assert_equal 1, Ticket.count
+  end
+
+  test "an update needs a reply or a solved status, and a reply needs a body" do
+    id = open_request(token: @token)
+
+    api(:patch, "/api/v1/requests/#{id}", body: {request: {subject: "Changed"}}, account: "acme", token: @token)
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+
+    api(:patch, "/api/v1/requests/#{id}", body: {request: {comment: {body: ""}}}, account: "acme", token: @token)
+    assert_response :unprocessable_entity
+    assert_equal 1, Comment.count
+    assert_equal "Cannot download my receipt", Ticket.find(id).subject
+  end
+
+  test "a session from one business is refused in another" do
+    id = open_request(token: @token)
+    signup(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+
+    api(:get, "/api/v1/requests/#{id}", account: "globex", token: @token)
+    assert_response :unauthorized
+  end
+end
diff --git a/test/integration/email_verifications_test.rb b/test/integration/email_verifications_test.rb
new file mode 100644
index 0000000..e2724a9
--- /dev/null
+++ b/test/integration/email_verifications_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class EmailVerificationsTest < ApiIntegrationTest
+  test "confirming the link verifies the owner, and the token cannot be reused" do
+    signup
+    token = link_token(last_mail)
+
+    api(:post, "/api/v1/email_verifications/confirm", body: {email_verification: {token:}}, account: "acme")
+
+    assert_response :ok
+    assert_equal true, json.dig("user", "verified")
+    assert Account.find_by!(subdomain: "acme").owner.reload.verified?
+
+    api(:post, "/api/v1/email_verifications/confirm", body: {email_verification: {token:}}, account: "acme")
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "an unknown token is rejected" do
+    signup
+
+    api(:post, "/api/v1/email_verifications/confirm", body: {email_verification: {token: "bogus"}}, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "a token from one business cannot verify a user of another business" do
+    signup(subdomain: "acme")
+    token = link_token(last_mail)
+    signup(subdomain: "globex", name: "Globex")
+
+    api(:post, "/api/v1/email_verifications/confirm", body: {email_verification: {token:}}, account: "globex")
+
+    assert_response :unprocessable_entity
+    refute Account.find_by!(subdomain: "acme").owner.reload.verified?
+    refute Account.find_by!(subdomain: "globex").owner.reload.verified?
+  end
+
+  test "requesting another link emails it and replaces the previous one" do
+    signup
+    old_token = link_token(last_mail)
+
+    api(:post, "/api/v1/email_verifications", body: {email_verification: {email: "jo@acme.test"}}, account: "acme")
+
+    assert_response :accepted
+    assert_equal 2, ActionMailer::Base.deliveries.size
+    new_token = link_token(last_mail)
+    refute_equal old_token, new_token
+    assert_includes last_mail.body.decoded, "http://localhost:3001/verify-email?account=acme&token=#{new_token}"
+
+    api(:post, "/api/v1/email_verifications/confirm", body: {email_verification: {token: old_token}}, account: "acme")
+    assert_response :unprocessable_entity
+
+    api(:post, "/api/v1/email_verifications/confirm", body: {email_verification: {token: new_token}}, account: "acme")
+    assert_response :ok
+  end
+
+  test "an unknown email gets the same response and no email" do
+    signup
+    ActionMailer::Base.deliveries.clear
+
+    api(:post, "/api/v1/email_verifications", body: {email_verification: {email: "nobody@acme.test"}}, account: "acme")
+
+    assert_response :accepted
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "an already verified owner is not sent another link" do
+    verified_owner
+    ActionMailer::Base.deliveries.clear
+
+    api(:post, "/api/v1/email_verifications", body: {email_verification: {email: "jo@acme.test"}}, account: "acme")
+
+    assert_response :accepted
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "verification links expire" do
+    signup
+    token = link_token(last_mail)
+
+    travel User::EMAIL_VERIFICATION_TTL + 1.minute do
+      api(:post, "/api/v1/email_verifications/confirm", body: {email_verification: {token:}}, account: "acme")
+    end
+
+    assert_response :unprocessable_entity
+    refute Account.find_by!(subdomain: "acme").owner.reload.verified?
+  end
+
+  test "requesting a link requires the business header" do
+    api(:post, "/api/v1/email_verifications", body: {email_verification: {email: "jo@acme.test"}})
+
+    assert_response :bad_request
+    assert_equal "account_required", json.dig("error", "code")
+  end
+end
diff --git a/test/integration/group_memberships_test.rb b/test/integration/group_memberships_test.rb
new file mode 100644
index 0000000..7cee7bd
--- /dev/null
+++ b/test/integration/group_memberships_test.rb
@@ -0,0 +1,340 @@
+require "test_helper"
+
+class GroupMembershipsTest < ApiIntegrationTest
+  setup do
+    @owner = verified_owner
+    @owner_token = sign_in
+    @pat = add_user(name: "Pat", email: "pat@acme.test", role: "agent")
+    @pat_token = sign_in(email: "pat@acme.test")
+    @billing = create_group("Billing")
+    @support = create_group("Technical Support")
+    verified_customer
+    @avery_token = customer_token
+  end
+
+  def add_user(name:, email:, role:, account: "acme", suspended: false)
+    Account.find_by!(subdomain: account).users.create!(name:, email:, password: PASSWORD, role:, verified: true,
+      suspended:)
+  end
+
+  def create_group(name)
+    api(:post, "/api/v1/groups", body: {group: {name:}}, account: "acme", token: @owner_token)
+    json.dig("group", "id")
+  end
+
+  def join(group_id, user_id = @pat.id, default: nil, token: @owner_token)
+    body = {group_id:, user_id:}
+    body[:default] = default unless default.nil?
+    api(:post, "/api/v1/group_memberships", body: {group_membership: body}, account: "acme", token:)
+  end
+
+  def membership_for(group_id, user_id = @pat.id)
+    GroupMembership.find_by!(group_id:, user_id:)
+  end
+
+  # Which of this person's memberships is the default, as a set of group IDs. Must be exactly one.
+  def defaults_for(user_id = @pat.id)
+    GroupMembership.where(user_id:, default: true).pluck(:group_id)
+  end
+
+  def open_ticket(subject: "Cannot download my receipt")
+    open_request(token: @avery_token, subject:)
+  end
+
+  test "an admin adds a staff member to a group, and the response shows the membership" do
+    join(@billing)
+
+    assert_response :created
+    membership = json["group_membership"]
+    assert_equal [@billing, @pat.id], [membership["group_id"], membership["user_id"]]
+    assert_equal({"id" => @billing, "name" => "Billing"}, membership["group"])
+    assert_equal({"id" => @pat.id, "name" => "Pat"}, membership["user"])
+  end
+
+  test "one person can belong to several groups" do
+    join(@billing)
+    join(@support)
+
+    assert_response :created
+    assert_equal [@billing, @support], GroupMembership.where(user_id: @pat.id).order(:id).pluck(:group_id)
+  end
+
+  test "the first group a person joins is their default, even when the default is not asked for" do
+    join(@billing, default: false)
+
+    assert_response :created
+    assert_equal true, json.dig("group_membership", "default")
+    assert_equal [@billing], defaults_for
+  end
+
+  test "a later group joins without becoming the default unless asked" do
+    join(@billing)
+    join(@support)
+
+    assert_equal false, json.dig("group_membership", "default")
+    assert_equal [@billing], defaults_for
+  end
+
+  test "asking for a default on a later group moves the default there, leaving exactly one" do
+    join(@billing)
+    join(@support, default: true)
+
+    assert_response :created
+    assert_equal true, json.dig("group_membership", "default")
+    assert_equal [@support], defaults_for
+    assert_equal false, membership_for(@billing).default
+  end
+
+  test "make_default chooses another group as the default, and leaves exactly one" do
+    join(@billing)
+    join(@support)
+    membership = membership_for(@support)
+
+    api(:put, "/api/v1/group_memberships/#{membership.id}/make_default", account: "acme", token: @owner_token)
+
+    assert_response :ok
+    assert_equal true, json.dig("group_membership", "default")
+    assert_equal [@support], defaults_for
+  end
+
+  test "make_default on the current default changes nothing" do
+    join(@billing)
+    membership = membership_for(@billing)
+
+    api(:put, "/api/v1/group_memberships/#{membership.id}/make_default", account: "acme", token: @owner_token)
+
+    assert_response :ok
+    assert_equal [@billing], defaults_for
+  end
+
+  test "deleting the default membership makes another of the person's groups the default" do
+    join(@billing)
+    join(@support)
+    default = membership_for(@billing)
+
+    api(:delete, "/api/v1/group_memberships/#{default.id}", account: "acme", token: @owner_token)
+
+    assert_response :no_content
+    refute GroupMembership.exists?(default.id)
+    assert_equal [@support], defaults_for
+  end
+
+  test "deleting a membership that is not the default leaves the default alone" do
+    join(@billing)
+    join(@support)
+
+    api(:delete, "/api/v1/group_memberships/#{membership_for(@support).id}", account: "acme", token: @owner_token)
+
+    assert_response :no_content
+    assert_equal [@billing], defaults_for
+  end
+
+  test "removing the last membership leaves the person with no default" do
+    join(@billing)
+
+    api(:delete, "/api/v1/group_memberships/#{membership_for(@billing).id}", account: "acme", token: @owner_token)
+
+    assert_response :no_content
+    assert_empty defaults_for
+  end
+
+  test "a person cannot join the same group twice" do
+    join(@billing)
+    join(@billing)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "user_id").present?
+    assert_equal 1, GroupMembership.where(user_id: @pat.id).count
+  end
+
+  test "customers cannot be put in a group" do
+    join(@billing, User.find_by!(email: "avery@example.test").id)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "user_id").present?
+    assert_equal 0, GroupMembership.count
+  end
+
+  test "unknown groups and people are refused, and so is a group from another business" do
+    verified_owner(subdomain: "globex", email: "jo@globex.test")
+    globex_token = sign_in(email: "jo@globex.test", account: "globex")
+    api(:post, "/api/v1/groups", body: {group: {name: "Sales"}}, account: "globex", token: globex_token)
+    globex_group = json.dig("group", "id")
+
+    join(999_999)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "group").present?
+
+    join(@billing, 999_999)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "user").present?
+
+    join(globex_group)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "group").present?
+    assert_equal 0, GroupMembership.count
+  end
+
+  test "IDs sent as something other than numbers are refused" do
+    join("billing")
+    assert_response :unprocessable_entity
+
+    api(:post, "/api/v1/group_memberships", body: {group_membership: {group_id: @billing, user_id: {id: @pat.id}}},
+      account: "acme", token: @owner_token)
+    assert_response :unprocessable_entity
+    assert_equal 0, GroupMembership.count
+  end
+
+  test "default must be true or false" do
+    api(:post, "/api/v1/group_memberships", body: {group_membership: {group_id: @billing, user_id: @pat.id,
+      default: "sometimes"}}, account: "acme", token: @owner_token)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "default").present?
+    assert_equal 0, GroupMembership.count
+  end
+
+  test "agents can browse memberships but cannot change them" do
+    join(@billing)
+    membership = membership_for(@billing)
+
+    api(:get, "/api/v1/group_memberships", account: "acme", token: @pat_token)
+    assert_response :ok
+    assert_equal 1, json["count"]
+
+    join(@support, token: @pat_token)
+    assert_response :forbidden
+    api(:put, "/api/v1/group_memberships/#{membership.id}/make_default", account: "acme", token: @pat_token)
+    assert_response :forbidden
+    api(:delete, "/api/v1/group_memberships/#{membership.id}", account: "acme", token: @pat_token)
+    assert_response :forbidden
+    assert GroupMembership.exists?(membership.id)
+  end
+
+  test "customers cannot browse memberships" do
+    join(@billing)
+
+    api(:get, "/api/v1/group_memberships", account: "acme", token: @avery_token)
+
+    assert_response :forbidden
+  end
+
+  test "memberships are listed by ID ascending, and can be filtered by group and by person" do
+    join(@billing)
+    join(@support)
+    avery = User.find_by!(email: "avery@example.test")
+    lee = add_user(name: "Lee", email: "lee@acme.test", role: "admin")
+    join(@billing, lee.id)
+    join(@support, lee.id)
+    ids = GroupMembership.order(:id).pluck(:id)
+
+    api(:get, "/api/v1/group_memberships", account: "acme", token: @pat_token)
+    assert_equal ids, json["group_memberships"].pluck("id")
+
+    api(:get, "/api/v1/group_memberships?group_id=#{@billing}", account: "acme", token: @pat_token)
+    assert_equal [@billing, @billing], json["group_memberships"].pluck("group_id")
+    assert_equal 2, json["count"]
+
+    api(:get, "/api/v1/group_memberships?user_id=#{lee.id}", account: "acme", token: @pat_token)
+    assert_equal [lee.id, lee.id], json["group_memberships"].pluck("user_id")
+
+    api(:get, "/api/v1/group_memberships?group_id=#{@support}&user_id=#{lee.id}", account: "acme", token: @pat_token)
+    assert_equal 1, json["count"]
+    assert_equal [@support], json["group_memberships"].pluck("group_id")
+
+    api(:get, "/api/v1/group_memberships?user_id=#{avery.id}", account: "acme", token: @pat_token)
+    assert_equal 0, json["count"]
+  end
+
+  test "a malformed group or user filter is refused" do
+    api(:get, "/api/v1/group_memberships?group_id=billing", account: "acme", token: @pat_token)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "group_id").present?
+
+    api(:get, "/api/v1/group_memberships?user_id=0", account: "acme", token: @pat_token)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "user_id").present?
+  end
+
+  test "a single membership can be shown, and another business's membership is not found" do
+    join(@billing)
+    id = membership_for(@billing).id
+
+    api(:get, "/api/v1/group_memberships/#{id}", account: "acme", token: @pat_token)
+    assert_response :ok
+    assert_equal id, json.dig("group_membership", "id")
+
+    api(:get, "/api/v1/group_memberships/999999", account: "acme", token: @pat_token)
+    assert_response :not_found
+  end
+
+  test "suspension keeps memberships and the default for later" do
+    join(@billing)
+    join(@support, default: true)
+    before = GroupMembership.where(user_id: @pat.id).order(:id).pluck(:id, :group_id, :default)
+
+    api(:patch, "/api/v1/users/#{@pat.id}", body: {user: {suspended: true}}, account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal before, GroupMembership.where(user_id: @pat.id).order(:id).pluck(:id, :group_id, :default)
+
+    api(:get, "/api/v1/group_memberships?user_id=#{@pat.id}", account: "acme", token: @owner_token)
+    assert_equal 2, json["count"]
+
+    api(:patch, "/api/v1/users/#{@pat.id}", body: {user: {suspended: false}}, account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal before, GroupMembership.where(user_id: @pat.id).order(:id).pluck(:id, :group_id, :default)
+  end
+
+  test "removing a person from a group unassigns the tickets in that group assigned to them only" do
+    join(@billing)
+    join(@support)
+    billing_ticket = open_ticket(subject: "Refund")
+    support_ticket = open_ticket(subject: "Login loop")
+    api(:patch, "/api/v1/tickets/#{billing_ticket}", body: {ticket: {group_id: @billing, assignee_id: @pat.id}},
+      account: "acme", token: @owner_token)
+    api(:patch, "/api/v1/tickets/#{support_ticket}", body: {ticket: {group_id: @support, assignee_id: @pat.id}},
+      account: "acme", token: @owner_token)
+    assert_response :ok
+
+    api(:delete, "/api/v1/group_memberships/#{membership_for(@billing).id}", account: "acme", token: @owner_token)
+
+    assert_response :no_content
+    billing = Ticket.find(billing_ticket)
+    assert_nil billing.assignee_id
+    assert_equal @billing, billing.group_id
+    assert_equal @pat.id, Ticket.find(support_ticket).assignee_id
+    assert_equal @support, Ticket.find(support_ticket).group_id
+  end
+
+  test "a group that is deleted ungroups its tickets and clears their assignees, leaving other tickets alone" do
+    join(@billing)
+    billing_ticket = open_ticket(subject: "Refund")
+    other_ticket = open_ticket(subject: "Login loop")
+    api(:patch, "/api/v1/tickets/#{billing_ticket}", body: {ticket: {group_id: @billing, assignee_id: @pat.id}},
+      account: "acme", token: @owner_token)
+    api(:patch, "/api/v1/tickets/#{other_ticket}", body: {ticket: {group_id: @support}}, account: "acme",
+      token: @owner_token)
+    assert_response :ok
+    updated_at = Ticket.find(billing_ticket).updated_at
+
+    api(:delete, "/api/v1/groups/#{@billing}", account: "acme", token: @owner_token)
+
+    assert_response :no_content
+    ticket = Ticket.find(billing_ticket)
+    assert_nil ticket.group_id
+    assert_nil ticket.assignee_id
+    assert_equal updated_at.to_i, ticket.updated_at.to_i
+    assert_equal @support, Ticket.find(other_ticket).group_id
+  end
+
+  test "deleting a group removes the memberships in it and keeps the person's other memberships" do
+    join(@billing, default: true)
+    join(@support)
+
+    api(:delete, "/api/v1/groups/#{@billing}", account: "acme", token: @owner_token)
+
+    assert_response :no_content
+    assert_equal [@support], GroupMembership.where(user_id: @pat.id).pluck(:group_id)
+    assert_equal [@support], defaults_for
+  end
+end
