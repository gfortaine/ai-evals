diff --git a/app/controllers/api/v1/requests_controller.rb b/app/controllers/api/v1/requests_controller.rb
new file mode 100644
index 0000000..6bef240
--- /dev/null
+++ b/app/controllers/api/v1/requests_controller.rb
@@ -0,0 +1,64 @@
+module Api
+  module V1
+    # A customer's own requests. Staff work the same records through TicketsController.
+    class RequestsController < BaseController
+      include Paginatable
+
+      before_action :authenticate_user!
+      before_action :ensure_account_active!
+      before_action :load_request, only: %i[show update comments]
+
+      # Customers can filter their own requests by status. Other filters are staff-only and are ignored here.
+      def index
+        requests = @current_user.requested_tickets.recent_first
+        requests = requests.where(status: checked_enum(:status, Ticket::STATUSES)) if params[:status].present?
+        render_page(:requests, requests, keyset: Helpdesk::Keyset::RECENT_FIRST) do |ticket|
+          TicketSerializer.new(ticket).as_json
+        end
+      end
+
+      def create
+        details = envelope(:request, :subject, comment: [:body])
+        ticket = Ticket.open!(requester: @current_user, subject: details[:subject],
+          body: details.dig(:comment, :body))
+
+        render json: {request: TicketSerializer.new(ticket).as_json}, status: :created
+      end
+
+      def show
+        render json: {request: TicketSerializer.new(@ticket).as_json}
+      end
+
+      # A customer reply, optionally marking the request solved in the same update.
+      def update
+        details = envelope(:request, :status, comment: [:body])
+        solve = details.key?(:status)
+        comment = details[:comment]
+
+        if solve && details[:status] != "solved"
+          return render_error(422, "validation_failed", "Customers can only mark a request solved.",
+            details: {status: ["must be solved"]})
+        end
+        unless comment.present? || solve
+          return render_error(422, "validation_failed", "Send a reply, or mark the request solved.")
+        end
+
+        @ticket.requester_update!(author: @current_user, comment:, solve:)
+        render json: {request: TicketSerializer.new(@ticket).as_json}
+      end
+
+      # Only public comments. Staff-only notes never reach the customer.
+      def comments
+        render_page(:comments, @ticket.comments.public_only.includes(:author), keyset: Helpdesk::Keyset::OLDEST_FIRST) do |comment|
+          CommentSerializer.new(comment).as_json
+        end
+      end
+
+      private
+
+      def load_request
+        @ticket = @current_user.requested_tickets.find(params[:id])
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/sessions_controller.rb b/app/controllers/api/v1/sessions_controller.rb
new file mode 100644
index 0000000..fba7d87
--- /dev/null
+++ b/app/controllers/api/v1/sessions_controller.rb
@@ -0,0 +1,48 @@
+module Api
+  module V1
+    class SessionsController < BaseController
+      # Checked when the email is unknown, so that failed sign-ins take about as long either way.
+      DUMMY_PASSWORD_DIGEST = BCrypt::Password.create(SecureRandom.hex(16)).freeze
+
+      before_action :authenticate_user!, only: :destroy
+
+      def create
+        credentials = envelope(:session, :email, :password)
+        user = authenticate(credentials[:email].to_s.strip.downcase, credentials[:password].to_s)
+        return render_error(401, "invalid_credentials", "Email or password is incorrect.") unless user
+
+        # A cancelled business admits only its owner, and only until the reactivation window closes.
+        if @account.cancelled? && !(user.id == @account.owner_id && @account.reactivation_open?)
+          return render_error(403, "account_cancelled", "This business is cancelled.")
+        end
+
+        return render_error(403, "user_suspended", "This account is suspended. Ask an admin to restore it.") if user.suspended?
+        return render_error(403, "email_not_verified", "Verify your email before signing in.") unless user.verified?
+
+        session = UserSession.start!(user)
+        render json: {
+          session: UserSessionSerializer.new(session).as_json,
+          user: UserSerializer.new(user).as_json,
+          account: AccountSerializer.new(@account).as_json
+        }, status: :created
+      end
+
+      def destroy
+        @current_session.destroy!
+        head :no_content
+      end
+
+      private
+
+      def authenticate(email, password)
+        user = @account.users.find_by(email:)
+        unless user
+          BCrypt::Password.new(DUMMY_PASSWORD_DIGEST).is_password?(password)
+          return nil
+        end
+
+        user if user.authenticate(password)
+      end
+    end
+  end
+end
