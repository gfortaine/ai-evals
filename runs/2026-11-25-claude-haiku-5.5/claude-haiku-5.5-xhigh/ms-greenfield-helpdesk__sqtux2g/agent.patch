diff --git a/app/controllers/api/v1/tickets_controller.rb b/app/controllers/api/v1/tickets_controller.rb
new file mode 100644
index 0000000..32d8a58
--- /dev/null
+++ b/app/controllers/api/v1/tickets_controller.rb
@@ -0,0 +1,123 @@
+module Api
+  module V1
+    # Staff view of every request in the business. Customers use RequestsController.
+    class TicketsController < BaseController
+      include Paginatable
+
+      before_action :authenticate_user!
+      before_action :ensure_account_active!
+      before_action :require_staff!
+      before_action :load_ticket, only: %i[show update comments merge]
+
+      # Filters combine. Each one given narrows the list further, e.g.
+      # ?status=open&group_id=unassigned&assignee_id=unassigned&priority=high&q=receipt
+      def index
+        tickets = filter_tickets(@account.tickets.includes(:requester, :assignee, :group).recent_first)
+        render_page(:tickets, tickets, keyset: Helpdesk::Keyset::RECENT_FIRST) do |ticket|
+          TicketSerializer.new(ticket, staff: true).as_json
+        end
+      end
+
+      def show
+        render json: {ticket: TicketSerializer.new(@ticket, staff: true).as_json}
+      end
+
+      # A staff reply, a status change, a group, an assignment, and/or a priority. A reply alone keeps the status.
+      # `group_id` is a group's ID, or null to ungroup the ticket (which also clears the assignee). `assignee_id` is an
+      # active staff member's ID, or null to unassign. `priority` is normal or high.
+      def update
+        details = envelope(:ticket, :status, :group_id, :assignee_id, :priority, comment: %i[body public])
+        comment = details[:comment]
+        changes = details.slice(:status).to_h
+        grouping = details.key?(:group_id)
+        assigning = details.key?(:assignee_id)
+        prioritizing = details.key?(:priority)
+
+        unless comment.present? || changes.any? || grouping || assigning || prioritizing
+          return render_error(422, "validation_failed",
+            "Send a reply, a status, a group, an assignee, or a priority to change.")
+        end
+
+        @ticket.staff_update!(author: @current_user, comment:, changes:,
+          group_id: grouping ? details[:group_id] : Ticket::UNCHANGED,
+          assignee_id: assigning ? details[:assignee_id] : Ticket::UNCHANGED,
+          priority: prioritizing ? details[:priority] : Ticket::UNCHANGED)
+        render json: {ticket: TicketSerializer.new(@ticket, staff: true).as_json}
+      end
+
+      # Everything, including private staff notes.
+      def comments
+        render_page(:comments, @ticket.comments.includes(:author), keyset: Helpdesk::Keyset::OLDEST_FIRST) do |comment|
+          CommentSerializer.new(comment).as_json
+        end
+      end
+
+      # Merges this duplicate into another ticket of the same customer. This ticket is closed and points at the
+      # target. Each side gets a note, private unless `public` is true. The notes send no email. See Ticket#merge_into!.
+      def merge
+        details = envelope(:merge, :target_id, source_comment: %i[body public], target_comment: %i[body public])
+        source, target = @ticket.merge_into!(
+          target_id: merge_target_id(details[:target_id]),
+          author: @current_user,
+          source_note: merge_note(:source_comment, details[:source_comment]),
+          target_note: merge_note(:target_comment, details[:target_comment])
+        )
+
+        render json: {
+          source: TicketSerializer.new(source, staff: true).as_json,
+          target: TicketSerializer.new(target, staff: true).as_json
+        }
+      end
+
+      private
+
+      def load_ticket
+        @ticket = @account.tickets.includes(:requester, :assignee, :group).find(params[:id])
+      end
+
+      # The ticket to merge into, as a number or a string of digits, such as 57 or "57". Anything else is refused.
+      def merge_target_id(raw)
+        value = raw.is_a?(Integer) ? raw.to_s : raw
+        raise InvalidShape.new(:target_id, "a ticket ID") unless value.is_a?(String) && value.match?(/\A[1-9]\d{0,17}\z/)
+
+        value.to_i
+      end
+
+      # One merge note, e.g. source_comment: {body:, public:}. The text must be a string and `public` must be true or
+      # false. A note that is not sent yields {}, so the model uses its defaults: private, with the default text.
+      def merge_note(name, note)
+        return {} if note.nil?
+
+        body = params.dig(:merge, name, :body)
+        raise InvalidShape.new("#{name}.body", "text") unless body.nil? || body.is_a?(String)
+
+        {body:, public: boolean_value("#{name}.public", note.fetch(:public, false))}
+      end
+
+      # Each filter is optional. A blank one is ignored, and a malformed one is refused with 422.
+      def filter_tickets(tickets)
+        tickets = tickets.where(status: checked_enum(:status, Ticket::STATUSES)) if params[:status].present?
+        tickets = tickets.where(priority: checked_enum(:priority, Ticket::PRIORITIES)) if params[:priority].present?
+        tickets = tickets.where(requester_id: checked_user_id(:requester_id)) if params[:requester_id].present?
+        tickets = filter_by_group(tickets) if params[:group_id].present?
+        tickets = filter_by_assignee(tickets) if params[:assignee_id].present?
+        tickets = tickets.search(checked_text(:q)) if params[:q].present?
+        tickets
+      end
+
+      # ?group_id=unassigned finds tickets with no group. A number finds the tickets in that group.
+      def filter_by_group(tickets)
+        return tickets.where(group_id: nil) if params[:group_id] == "unassigned"
+
+        tickets.where(group_id: checked_id(:group_id, expected: "unassigned or a group ID"))
+      end
+
+      # ?assignee_id=unassigned finds tickets nobody is working. A number finds that person's tickets.
+      def filter_by_assignee(tickets)
+        return tickets.where(assignee_id: nil) if params[:assignee_id] == "unassigned"
+
+        tickets.where(assignee_id: checked_user_id(:assignee_id, expected: "unassigned or a user ID"))
+      end
+    end
+  end
+end
