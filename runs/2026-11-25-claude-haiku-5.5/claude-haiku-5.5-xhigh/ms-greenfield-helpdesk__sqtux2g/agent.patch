+++ b/test/integration/invitations_test.rb
@@ -0,0 +1,319 @@
+require "test_helper"
+
+class InvitationsTest < ApiIntegrationTest
+  setup do
+    @owner = verified_owner
+    @owner_token = sign_in
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def invite(email: "sam@example.test", role: "agent", token: @owner_token, account: "acme")
+    api(:post, "/api/v1/invitations", body: {invitation: {email:, role:}}, account:, token:)
+  end
+
+  def invitation_id(email: "sam@example.test", role: "agent")
+    invite(email:, role:)
+    assert_response :created
+    json.dig("invitation", "id")
+  end
+
+  test "an admin invites an agent and an admin, and the link goes to the frontend" do
+    invite(email: "sam@example.test", role: "agent")
+
+    assert_response :created
+    invitation = json["invitation"]
+    assert_equal "sam@example.test", invitation["email"]
+    assert_equal "agent", invitation["role"]
+    assert_equal "pending", invitation["status"]
+    assert_nil invitation["accepted_at"]
+    assert_nil invitation["revoked_at"]
+    assert invitation["expires_at"].present?
+    refute invitation.key?("token")
+
+    assert_equal ["sam@example.test"], last_mail.to
+    assert_includes last_mail.body.decoded, "http://localhost:3001/accept-invitation?account=acme&token="
+    token = link_token(last_mail)
+    assert_equal Helpdesk::Token.digest(token), Invitation.find(invitation["id"]).token_digest
+    refute_includes Invitation.find(invitation["id"]).token_digest, token
+
+    invite(email: "lee@example.test", role: "admin")
+    assert_response :created
+    assert_equal "admin", json.dig("invitation", "role")
+  end
+
+  test "the address is normalized" do
+    invite(email: "  Sam@Example.TEST ")
+
+    assert_response :created
+    assert_equal "sam@example.test", json.dig("invitation", "email")
+  end
+
+  test "customers cannot be invited" do
+    invite(role: "customer")
+
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "details", "role").present?
+    assert_equal 0, Invitation.count
+  end
+
+  test "agents cannot invite, list, or manage invitations" do
+    Account.find_by!(subdomain: "acme").users.create!(name: "Pat", email: "pat@acme.test",
+      password: PASSWORD, role: "agent", verified: true)
+    agent_token = sign_in(email: "pat@acme.test")
+
+    invite(token: agent_token)
+    assert_response :forbidden
+    id = invitation_id
+    api(:get, "/api/v1/invitations", account: "acme", token: agent_token)
+    assert_response :forbidden
+    api(:get, "/api/v1/invitations/#{id}", account: "acme", token: agent_token)
+    assert_response :forbidden
+    api(:post, "/api/v1/invitations/#{id}/resend", account: "acme", token: agent_token)
+    assert_response :forbidden
+    api(:delete, "/api/v1/invitations/#{id}", account: "acme", token: agent_token)
+    assert_response :forbidden
+    assert_equal "pending", Invitation.find(id).status(now: Time.current)
+  end
+
+  test "an address that already belongs to a user of the business cannot be invited" do
+    verified_customer(email: "avery@example.test")
+    invite(email: "avery@example.test")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "email").present?
+  end
+
+  test "only one live invitation exists for an address" do
+    invitation_id(email: "sam@example.test", role: "agent")
+
+    invite(email: "sam@example.test", role: "agent")
+    assert_response :unprocessable_entity
+    assert_match(/pending invitation/, json.dig("error", "message"))
+
+    invite(email: "SAM@example.test", role: "admin")
+    assert_response :unprocessable_entity
+    assert_equal 1, Invitation.count
+  end
+
+  test "an expired invitation no longer competes, so the address can be invited again" do
+    invitation_id(email: "sam@example.test")
+
+    travel(Invitation::TTL + 1.minute) do
+      invite(email: "sam@example.test", role: "admin")
+      assert_response :created
+      assert_equal "pending", json.dig("invitation", "status")
+    end
+    assert_equal 2, Invitation.count
+  end
+
+  test "a revoked invitation no longer competes" do
+    id = invitation_id(email: "sam@example.test")
+    api(:delete, "/api/v1/invitations/#{id}", account: "acme", token: @owner_token)
+
+    invite(email: "sam@example.test")
+    assert_response :created
+  end
+
+  test "the same address may be invited by another business" do
+    invitation_id(email: "sam@example.test")
+    verified_owner(subdomain: "globex", email: "jo@globex.test")
+    globex_token = sign_in(email: "jo@globex.test", account: "globex")
+
+    invite(email: "sam@example.test", account: "globex", token: globex_token)
+    assert_response :created
+  end
+
+  test "lists invitations by ID ascending and filters them by status" do
+    first = invitation_id(email: "a@example.test")
+    second = invitation_id(email: "b@example.test", role: "admin")
+    third = invitation_id(email: "c@example.test")
+    api(:delete, "/api/v1/invitations/#{second}", account: "acme", token: @owner_token)
+
+    api(:get, "/api/v1/invitations", account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal [first, second, third], json["invitations"].pluck("id")
+    assert_equal 3, json["count"]
+    assert_equal %w[pending revoked pending], json["invitations"].pluck("status")
+
+    api(:get, "/api/v1/invitations?status=revoked", account: "acme", token: @owner_token)
+    assert_equal [second], json["invitations"].pluck("id")
+
+    api(:get, "/api/v1/invitations?status=pending", account: "acme", token: @owner_token)
+    assert_equal [first, third], json["invitations"].pluck("id")
+
+    api(:get, "/api/v1/invitations?status=accepted", account: "acme", token: @owner_token)
+    assert_equal [], json["invitations"]
+    assert_equal 0, json["count"]
+  end
+
+  test "a status filter outside the known statuses is refused" do
+    api(:get, "/api/v1/invitations?status=archived", account: "acme", token: @owner_token)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "status").present?
+  end
+
+  test "tracks expired invitations by time" do
+    id = invitation_id
+    travel(Invitation::TTL + 1.minute) do
+      api(:get, "/api/v1/invitations/#{id}", account: "acme", token: @owner_token)
+      assert_equal "expired", json.dig("invitation", "status")
+
+      api(:get, "/api/v1/invitations?status=expired", account: "acme", token: @owner_token)
+      assert_equal [id], json["invitations"].pluck("id")
+    end
+  end
+
+  test "inspects one invitation, including who sent it" do
+    id = invitation_id
+
+    api(:get, "/api/v1/invitations/#{id}", account: "acme", token: @owner_token)
+
+    assert_response :ok
+    assert_equal id, json.dig("invitation", "id")
+    assert_equal({"id" => @owner.id, "name" => "Jo"}, json.dig("invitation", "invited_by"))
+  end
+
+  test "another business's invitation is not found" do
+    id = invitation_id
+    verified_owner(subdomain: "globex", email: "jo@globex.test")
+    globex_token = sign_in(email: "jo@globex.test", account: "globex")
+
+    api(:get, "/api/v1/invitations/#{id}", account: "globex", token: globex_token)
+    assert_response :not_found
+    api(:delete, "/api/v1/invitations/#{id}", account: "globex", token: globex_token)
+    assert_response :not_found
+    assert_equal "pending", Invitation.find(id).status
+  end
+
+  test "resending replaces the link and restarts the expiry" do
+    id = invitation_id
+    old_token = link_token(last_mail)
+    travel 2.days do
+      api(:post, "/api/v1/invitations/#{id}/resend", account: "acme", token: @owner_token)
+      assert_response :ok
+      assert_equal "pending", json.dig("invitation", "status")
+      assert_in_delta (Time.current + Invitation::TTL).to_i, Time.iso8601(json.dig("invitation", "expires_at")).to_i, 1
+      assert_equal 2, ActionMailer::Base.deliveries.size
+      refute_equal old_token, link_token(last_mail)
+      assert_equal Helpdesk::Token.digest(link_token(last_mail)), Invitation.find(id).token_digest
+    end
+  end
+
+  test "an expired invitation can be resent and becomes pending again" do
+    id = invitation_id
+    travel(Invitation::TTL + 1.minute) do
+      api(:post, "/api/v1/invitations/#{id}/resend", account: "acme", token: @owner_token)
+
+      assert_response :ok
+      assert_equal "pending", json.dig("invitation", "status")
+      assert_equal 2, ActionMailer::Base.deliveries.size
+    end
+  end
+
+  test "an accepted invitation cannot be resent" do
+    id = invitation_id
+    api(:post, "/api/v1/invitation_acceptances", body: {
+      invitation_acceptance: {token: link_token(last_mail), name: "Sam", password: "my-team-password"}
+    }, account: "acme")
+    assert_response :created
+
+    api(:post, "/api/v1/invitations/#{id}/resend", account: "acme", token: @owner_token)
+    assert_response :unprocessable_entity
+    assert_equal "already_accepted", json.dig("error", "code")
+  end
+
+  test "resending an expired invitation is refused while another invitation for the address is pending" do
+    first = invitation_id(email: "sam@example.test")
+    travel(Invitation::TTL + 1.minute) do
+      invite(email: "sam@example.test", role: "admin")
+      assert_response :created
+
+      api(:post, "/api/v1/invitations/#{first}/resend", account: "acme", token: @owner_token)
+      assert_response :unprocessable_entity
+      assert_equal "validation_failed", json.dig("error", "code")
+    end
+  end
+
+  test "revoking stops the link from working and is final" do
+    id = invitation_id
+    token = link_token(last_mail)
+
+    api(:delete, "/api/v1/invitations/#{id}", account: "acme", token: @owner_token)
+
+    assert_response :ok
+    assert_equal "revoked", json.dig("invitation", "status")
+    assert json.dig("invitation", "revoked_at").present?
+    assert_equal "revoked", Invitation.find(id).status
+
+    api(:post, "/api/v1/invitation_previews", body: {invitation_preview: {token:}}, account: "acme")
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+
+    api(:delete, "/api/v1/invitations/#{id}", account: "acme", token: @owner_token)
+    assert_response :unprocessable_entity
+    assert_equal "already_revoked", json.dig("error", "code")
+
+    api(:post, "/api/v1/invitations/#{id}/resend", account: "acme", token: @owner_token)
+    assert_response :unprocessable_entity
+    assert_equal "already_revoked", json.dig("error", "code")
+  end
+
+  test "an accepted invitation cannot be revoked" do
+    id = invitation_id
+    api(:post, "/api/v1/invitation_acceptances", body: {
+      invitation_acceptance: {token: link_token(last_mail), name: "Sam", password: "my-team-password"}
+    }, account: "acme")
+
+    api(:delete, "/api/v1/invitations/#{id}", account: "acme", token: @owner_token)
+
+    assert_response :unprocessable_entity
+    assert_equal "already_accepted", json.dig("error", "code")
+    assert_equal "accepted", Invitation.find(id).status
+  end
+
+  test "an expired invitation can be revoked" do
+    id = invitation_id
+    travel(Invitation::TTL + 1.minute) do
+      api(:delete, "/api/v1/invitations/#{id}", account: "acme", token: @owner_token)
+      assert_response :ok
+      assert_equal "revoked", json.dig("invitation", "status")
+    end
+  end
+
+  test "unknown invitations are not found" do
+    api(:get, "/api/v1/invitations/999999", account: "acme", token: @owner_token)
+    assert_response :not_found
+  end
+
+  test "invitation routes need a signed-in user of the business" do
+    invitation_id
+    api(:get, "/api/v1/invitations", account: "acme")
+    assert_response :unauthorized
+
+    api(:get, "/api/v1/invitations", token: @owner_token)
+    assert_response :bad_request
+    assert_equal "account_required", json.dig("error", "code")
+  end
+
+  test "a cancelled business cannot send invitations" do
+    Account.find_by!(subdomain: "acme").cancel!
+    owner_token = sign_in # the owner may still sign in during the reactivation window
+
+    invite(token: owner_token)
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+  end
+
+  test "purging a cancelled business removes its invitations along with its people and tickets" do
+    invitation_id
+    verified_customer
+    open_request(token: customer_token)
+    Account.find_by!(subdomain: "acme").cancel!(now: 91.days.ago)
+
+    assert_equal 1, Account.purge_cancelled!
+    assert_equal 0, Invitation.count
+    assert_equal 0, User.count
+  end
+end
diff --git a/test/integration/pagination_test.rb b/test/integration/pagination_test.rb
new file mode 100644
index 0000000..2e73f30
--- /dev/null
+++ b/test/integration/pagination_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class PaginationTest < ApiIntegrationTest
+  setup do
+    verified_owner
+    @owner_token = sign_in
+    verified_customer
+    @avery_token = customer_token
+  end
+
+  def open_requests(count)
+    Array.new(count) { |i| open_request(token: @avery_token, subject: "Request #{i + 1}") }
+  end
+
+  test "lists default to page 1 with 25 per page and no neighbouring pages" do
+    open_requests(3)
+
+    api(:get, "/api/v1/requests", account: "acme", token: @avery_token)
+
+    assert_response :ok
+    assert_equal 3, json["count"]
+    assert_equal 1, json["page"]
+    assert_equal 25, json["per_page"]
+    assert_nil json["next_page"]
+    assert_nil json["previous_page"]
+    assert_equal 3, json["requests"].size
+  end
+
+  test "walks through pages with next_page and previous_page" do
+    open_requests(5)
+
+    api(:get, "/api/v1/requests?page=1&per_page=2", account: "acme", token: @avery_token)
+    assert_equal 2, json["requests"].size
+    assert_equal 5, json["count"]
+    assert_equal 2, json["next_page"]
+    assert_nil json["previous_page"]
+
+    api(:get, "/api/v1/requests?page=2&per_page=2", account: "acme", token: @avery_token)
+    assert_equal 2, json["requests"].size
+    assert_equal 3, json["next_page"]
+    assert_equal 1, json["previous_page"]
+
+    api(:get, "/api/v1/requests?page=3&per_page=2", account: "acme", token: @avery_token)
+    assert_equal 1, json["requests"].size
+    assert_nil json["next_page"]
+    assert_equal 2, json["previous_page"]
+  end
+
+  test "pages do not overlap and cover every request" do
+    ids = open_requests(5)
+
+    seen = (1..3).flat_map do |page|
+      api(:get, "/api/v1/requests?page=#{page}&per_page=2", account: "acme", token: @avery_token)
+      json["requests"].pluck("id")
+    end
+
+    assert_equal ids.sort, seen.sort
+    assert_equal seen.uniq.size, seen.size
+  end
+
+  test "a page past the end is empty and points back to the previous page" do
+    open_requests(2)
+
+    api(:get, "/api/v1/requests?page=4&per_page=25", account: "acme", token: @avery_token)
+
+    assert_response :ok
+    assert_empty json["requests"]
+    assert_equal 2, json["count"]
+    assert_nil json["next_page"]
+    assert_equal 3, json["previous_page"]
+  end
+
+  test "per_page is capped at 100" do
+    api(:get, "/api/v1/requests?per_page=500", account: "acme", token: @avery_token)
+
+    assert_response :ok
+    assert_equal 100, json["per_page"]
+  end
+
+  test "values that are not positive whole numbers are rejected" do
+    %w[0 -1 abc 1.5].each do |value|
+      api(:get, "/api/v1/requests?page=#{value}", account: "acme", token: @avery_token)
+      assert_response :unprocessable_entity, "page=#{value} should be refused"
+      assert json.dig("error", "details", "page").present?
+
+      api(:get, "/api/v1/tickets?per_page=#{value}", account: "acme", token: @owner_token)
+      assert_response :unprocessable_entity, "per_page=#{value} should be refused"
+      assert json.dig("error", "details", "per_page").present?
+    end
+  end
+
+  test "staff ticket lists and comment lists are paginated too" do
+    open_requests(3)
+    id = Ticket.order(:id).first.id
+    Ticket.find(id).comments.create!(author: User.find_by!(email: "jo@acme.test"), body: "Second")
+
+    api(:get, "/api/v1/tickets?per_page=2", account: "acme", token: @owner_token)
+    assert_equal 3, json["count"]
+    assert_equal 2, json["tickets"].size
+    assert_equal 2, json["next_page"]
+
+    api(:get, "/api/v1/tickets/#{id}/comments?per_page=1", account: "acme", token: @owner_token)
+    assert_equal 2, json["count"]
+    assert_equal ["The download button does nothing."], json["comments"].pluck("body")
+    assert_equal 2, json["next_page"]
+  end
+end
diff --git a/test/integration/password_resets_test.rb b/test/integration/password_resets_test.rb
new file mode 100644
index 0000000..e4ed2a5
--- /dev/null
+++ b/test/integration/password_resets_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class PasswordResetsTest < ApiIntegrationTest
+  def request_reset(email: "jo@acme.test", account: "acme")
+    api(:post, "/api/v1/password_resets", body: {password_reset: {email:}}, account:)
+  end
+
+  def confirm_reset(token:, password: NEW_PASSWORD, account: "acme")
+    api(:post, "/api/v1/password_resets/confirm", body: {password_reset: {token:, password:}}, account:)
+  end
+
+  test "requesting a reset emails a link to the frontend" do
+    verified_owner
+
+    request_reset
+
+    assert_response :accepted
+    assert_equal ["jo@acme.test"], last_mail.to
+    assert_includes last_mail.body.decoded, "http://localhost:3001/reset-password?account=acme&token="
+  end
+
+  test "an unknown email gets the same response and no email" do
+    verified_owner
+    ActionMailer::Base.deliveries.clear
+
+    request_reset(email: "nobody@acme.test")
+
+    assert_response :accepted
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "confirming sets the new password, signs out every session, and burns the token" do
+    verified_owner
+    old_session = sign_in
+    request_reset
+    token = link_token(last_mail)
+
+    confirm_reset(token:)
+
+    assert_response :ok
+    api(:get, "/api/v1/me", account: "acme", token: old_session)
+    assert_response :unauthorized
+
+    sign_in(password: NEW_PASSWORD)
+
+    api(:post, "/api/v1/sessions", body: {session: {email: "jo@acme.test", password: PASSWORD}}, account: "acme")
+    assert_response :unauthorized
+
+    confirm_reset(token:)
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "a new reset link replaces the previous one" do
+    verified_owner
+    request_reset
+    old_token = link_token(last_mail)
+    request_reset
+    new_token = link_token(last_mail)
+    refute_equal old_token, new_token
+
+    confirm_reset(token: old_token)
+    assert_response :unprocessable_entity
+
+    confirm_reset(token: new_token)
+    assert_response :ok
+  end
+
+  test "a too-short new password is rejected and the link still works" do
+    verified_owner
+    request_reset
+    token = link_token(last_mail)
+
+    confirm_reset(token:, password: "short")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "password").present?
+
+    confirm_reset(token:)
+    assert_response :ok
+  end
+
+  test "reset links expire" do
+    verified_owner
+    request_reset
+    token = link_token(last_mail)
+
+    travel User::PASSWORD_RESET_TTL + 1.minute do
+      confirm_reset(token:)
+    end
+
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+    assert Account.find_by!(subdomain: "acme").owner.reload.authenticate(PASSWORD)
+  end
+
+  test "a reset link from one business cannot be used in another" do
+    verified_owner(subdomain: "acme")
+    verified_owner(subdomain: "globex")
+    request_reset(account: "acme")
+    token = link_token(last_mail)
+
+    confirm_reset(token:, account: "globex")
+
+    assert_response :unprocessable_entity
+    assert Account.find_by!(subdomain: "acme").owner.reload.authenticate(PASSWORD)
+  end
+end
diff --git a/test/integration/portal_and_cors_test.rb b/test/integration/portal_and_cors_test.rb
new file mode 100644
index 0000000..b45c287
--- /dev/null
+++ b/test/integration/portal_and_cors_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class PortalTest < ApiIntegrationTest
+  test "GET /portal publicly returns the business name and subdomain" do
+    signup(name: "Acme Support")
+
+    api(:get, "/api/v1/portal", account: "acme")
+
+    assert_response :ok
+    assert_equal({"name" => "Acme Support", "subdomain" => "acme"}, json["portal"])
+  end
+
+  test "GET /portal needs the business header and a known business" do
+    api(:get, "/api/v1/portal")
+    assert_response :bad_request
+
+    api(:get, "/api/v1/portal", account: "nope")
+    assert_response :not_found
+    assert_equal "account_not_found", json.dig("error", "code")
+  end
+end
+
+class CorsTest < ApiIntegrationTest
+  FRONTEND = "http://localhost:3001"
+
+  test "responses to the configured frontend origin carry CORS headers" do
+    signup
+
+    get "/api/v1/portal", headers: {"Origin" => FRONTEND, HEADER => "acme"}
+
+    assert_response :ok
+    assert_equal FRONTEND, header("Access-Control-Allow-Origin")
+    assert_includes header("Vary").to_s, "Origin"
+  end
+
+  test "preflight requests from the frontend may use the API's methods and headers" do
+    process :options, "/api/v1/me", headers: {
+      "Origin" => FRONTEND,
+      "Access-Control-Request-Method" => "PATCH",
+      "Access-Control-Request-Headers" => "authorization,content-type,x-helpdesk-account"
+    }
+
+    assert_response :no_content
+    assert_equal FRONTEND, header("Access-Control-Allow-Origin")
+    assert_includes header("Access-Control-Allow-Methods"), "PATCH"
+    allowed = header("Access-Control-Allow-Headers").downcase
+    %w[authorization content-type x-helpdesk-account].each { |name| assert_includes allowed, name }
+  end
+
+  test "other origins get no CORS allowance" do
+    signup
+    get "/api/v1/portal", headers: {"Origin" => "https://evil.test", HEADER => "acme"}
+
+    assert_response :ok
+    assert_nil header("Access-Control-Allow-Origin")
+
+    process :options, "/api/v1/me", headers: {
+      "Origin" => "https://evil.test", "Access-Control-Request-Method" => "GET"
+    }
+    assert_response :forbidden
+    assert_nil header("Access-Control-Allow-Origin")
+  end
+
+  test "the allowed origin follows HELPDESK_FRONTEND_URL" do
+    with_env("HELPDESK_FRONTEND_URL" => "https://desk.acme.test/app/") do
+      signup
+      get "/api/v1/portal", headers: {"Origin" => "https://desk.acme.test", HEADER => "acme"}
+      assert_equal "https://desk.acme.test", header("Access-Control-Allow-Origin")
+    end
+  end
+end
diff --git a/test/integration/profile_test.rb b/test/integration/profile_test.rb
new file mode 100644
index 0000000..b2016ce
--- /dev/null
+++ b/test/integration/profile_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class ProfileTest < ApiIntegrationTest
+  setup do
+    @owner = verified_owner
+    @token = sign_in
+  end
+
+  test "GET /me returns the signed-in user" do
+    api(:get, "/api/v1/me", account: "acme", token: @token)
+
+    assert_response :ok
+    assert_equal @owner.id, json.dig("user", "id")
+    assert_equal "jo@acme.test", json.dig("user", "email")
+    assert_equal "admin", json.dig("user", "role")
+    assert_equal true, json.dig("user", "verified")
+  end
+
+  test "GET /me requires a session" do
+    api(:get, "/api/v1/me", account: "acme")
+
+    assert_response :unauthorized
+  end
+
+  test "PATCH /me changes the name" do
+    api(:patch, "/api/v1/me", body: {user: {name: "Jo Smith"}}, account: "acme", token: @token)
+
+    assert_response :ok
+    assert_equal "Jo Smith", json.dig("user", "name")
+    assert_equal "Jo Smith", @owner.reload.name
+  end
+
+  test "PATCH /me cannot change the role, verification, or business" do
+    other_account = Account.create!(name: "Other", subdomain: "other")
+
+    api(:patch, "/api/v1/me", body: {user: {name: "Jo", role: "agent", verified: false, account_id: other_account.id}},
+      account: "acme", token: @token)
+
+    assert_response :ok
+    @owner.reload
+    assert_equal "admin", @owner.role
+    assert @owner.verified?
+    assert_equal Account.find_by!(subdomain: "acme").id, @owner.account_id
+  end
+
+  test "PATCH /me rejects a blank name" do
+    api(:patch, "/api/v1/me", body: {user: {name: ""}}, account: "acme", token: @token)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "name").present?
+  end
+
+  test "a password change needs the correct current password" do
+    api(:put, "/api/v1/me/password", body: {password_change: {current_password: "wrong-password", password: NEW_PASSWORD}},
+      account: "acme", token: @token)
+
+    assert_response :unprocessable_entity
+    assert_equal "invalid_current_password", json.dig("error", "code")
+    assert @owner.reload.authenticate(PASSWORD)
+  end
+
+  test "a password change signs out every session, including the current one" do
+    other_session = sign_in
+
+    api(:put, "/api/v1/me/password", body: {password_change: {current_password: PASSWORD, password: NEW_PASSWORD}},
+      account: "acme", token: @token)
+
+    assert_response :ok
+    api(:get, "/api/v1/me", account: "acme", token: @token)
+    assert_response :unauthorized
+    api(:get, "/api/v1/me", account: "acme", token: other_session)
+    assert_response :unauthorized
+
+    sign_in(password: NEW_PASSWORD)
+    api(:post, "/api/v1/sessions", body: {session: {email: "jo@acme.test", password: PASSWORD}}, account: "acme")
+    assert_response :unauthorized
+  end
+
+  test "a new password must be long enough, and the session is kept when it is refused" do
+    api(:put, "/api/v1/me/password", body: {password_change: {current_password: PASSWORD, password: "short"}},
+      account: "acme", token: @token)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "password").present?
+
+    api(:get, "/api/v1/me", account: "acme", token: @token)
+    assert_response :ok
+  end
+end
diff --git a/test/integration/sessions_test.rb b/test/integration/sessions_test.rb
new file mode 100644
index 0000000..916a40b
