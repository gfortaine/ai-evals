--- /dev/null
+++ b/test/models/ticket_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class TicketTest < ActiveSupport::TestCase
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @account = Account.create!(name: "Acme", subdomain: "acme", owner: nil)
+    @owner = @account.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password",
+      role: "admin", verified: true)
+    @account.update!(owner: @owner)
+    @customer = @account.users.create!(name: "Avery", email: "avery@example.test", password: "my-customer-password",
+      role: "customer", verified: true)
+    @ticket = Ticket.open!(requester: @customer, subject: "Receipt", body: "Download does nothing")
+  end
+
+  test "opening a request without a comment body saves nothing" do
+    assert_no_difference ["Ticket.count", "Comment.count"] do
+      assert_raises(ActiveRecord::RecordInvalid) do
+        Ticket.open!(requester: @customer, subject: "Receipt", body: " ")
+      end
+    end
+  end
+
+  test "a customer reply solved in the same update does not reopen" do
+    @ticket.update!(status: "solved")
+    @ticket.requester_update!(author: @customer, comment: {body: "Thanks, it works now"}, solve: true)
+    assert_equal "solved", @ticket.reload.status
+  end
+
+  test "a failed reply leaves the status unchanged" do
+    @ticket.update!(status: "pending")
+    assert_raises(ActiveRecord::RecordInvalid) do
+      @ticket.requester_update!(author: @customer, comment: {body: ""}, solve: true)
+    end
+    assert_equal "pending", @ticket.reload.status
+  end
+
+  test "a reply makes the request the most recently active" do
+    other = Ticket.open!(requester: @customer, subject: "Other", body: "Hi")
+    assert_equal [other.id, @ticket.id], Ticket.where(account: @account).recent_first.pluck(:id)
+
+    travel 1.minute do
+      @ticket.comments.create!(author: @owner, body: "On it", public: true)
+    end
+    assert_equal [@ticket.id, other.id], Ticket.where(account: @account).recent_first.pluck(:id)
+  end
+
+  test "a private note does not change the status" do
+    @ticket.update!(status: "pending")
+    @ticket.staff_update!(author: @owner, comment: {body: "Internal", public: false})
+    assert_equal "pending", @ticket.reload.status
+    assert_equal false, @ticket.comments.order(:id).last.public
+  end
+
+  test "a staff reply with an unknown status is refused, along with the comment" do
+    assert_no_difference -> { Comment.count } do
+      assert_raises(ActiveRecord::RecordInvalid) do
+        @ticket.staff_update!(author: @owner, comment: {body: "Hi"}, changes: {"status" => "archived"})
+      end
+    end
+  end
+
+  test "a new ticket is normal priority" do
+    assert_equal "normal", @ticket.reload.priority
+  end
+
+  test "a priority change does not touch updated_at" do
+    before = @ticket.reload.updated_at
+    travel 5.minutes do
+      @ticket.staff_update!(author: @owner, priority: "high")
+    end
+    assert_equal "high", @ticket.reload.priority
+    assert_equal before.to_i, @ticket.updated_at.to_i
+  end
+
+  test "an invalid priority is refused, and the reply in the same update is not saved" do
+    assert_no_difference -> { Comment.count } do
+      assert_raises(ActiveRecord::RecordInvalid) do
+        @ticket.staff_update!(author: @owner, comment: {body: "Hi"}, priority: "urgent")
+      end
+    end
+    assert_equal "normal", @ticket.reload.priority
+  end
+
+  test "the database refuses a priority outside normal and high" do
+    assert_raises(ActiveRecord::StatementInvalid) do
+      @ticket.update_columns(priority: "urgent")
+    end
+  end
+
+  test "search matches subjects and public comments without regard to case, and only those" do
+    other = Ticket.open!(requester: @customer, subject: "Login loop", body: "Spinner forever")
+    @ticket.comments.create!(author: @owner, body: "Refund for the RECEIPT_ID", public: true)
+    other.comments.create!(author: @owner, body: "Receipt is attached", public: false)
+
+    assert_equal [@ticket.id], Ticket.search("receipt").pluck(:id)
+    assert_equal [@ticket.id], Ticket.search("receipt_id").pluck(:id)
+    assert_equal [other.id], Ticket.search("loop").pluck(:id)
+    assert_equal [], Ticket.search("attached").pluck(:id)
+    assert_equal [], Ticket.search("receipt%").pluck(:id)
+  end
+
+  test "search returns each matching ticket once" do
+    @ticket.comments.create!(author: @owner, body: "receipt again", public: true)
+    @ticket.comments.create!(author: @owner, body: "another receipt", public: true)
+
+    assert_equal 1, Ticket.search("receipt").count
+  end
+
+  test "a cancelled business's tickets and comments are purged with it" do
+    @ticket.comments.create!(author: @owner, body: "Reply", public: true)
+    @account.cancel!(now: 91.days.ago)
+
+    assert_equal 1, Account.purge_cancelled!
+    assert_equal 0, Ticket.count
+    assert_equal 0, Comment.count
+  end
+end
diff --git a/test/test_helper.rb b/test/test_helper.rb
new file mode 100644
index 0000000..da71ba7
--- /dev/null
+++ b/test/test_helper.rb
@@ -0,0 +1,144 @@
+ENV["RAILS_ENV"] ||= "test"
+require_relative "../config/environment"
+require "rails/test_help"
+
+module HelpdeskTestHelpers
+  HEADER = "X-Helpdesk-Account"
+  PASSWORD = "my-first-password"
+  NEW_PASSWORD = "my-new-password"
+
+  # Performs a request against the JSON API. Pass `account:` for the business
+  # header and `token:` for the bearer session token.
+  def api(method, path, body: nil, account: nil, token: nil)
+    headers = {"Accept" => "application/json"}
+    headers[HEADER] = account if account
+    headers["Authorization"] = "Bearer #{token}" if token
+
+    if body
+      send(method, path, params: body, headers: headers, as: :json)
+    else
+      send(method, path, headers: headers)
+    end
+  end
+
+  def json
+    response.parsed_body
+  end
+
+  def signup(subdomain: "acme", name: "Acme", email: "jo@acme.test", password: PASSWORD, admin_name: "Jo")
+    api(:post, "/api/v1/account/create", body: {
+      account: {name:, subdomain:, admin: {name: admin_name, email:, password:}}
+    })
+  end
+
+  # Signs up a business and confirms the owner's email. Returns the owner.
+  def verified_owner(subdomain: "acme", email: "jo@acme.test", password: PASSWORD)
+    signup(subdomain:, email:, password:)
+    assert_response :created
+    token = link_token(last_mail)
+    api(:post, "/api/v1/email_verifications/confirm", body: {email_verification: {token:}}, account: subdomain)
+    assert_response :ok
+    Account.find_by!(subdomain:).users.find_by!(email:)
+  end
+
+  def sign_in(email: "jo@acme.test", password: PASSWORD, account: "acme")
+    api(:post, "/api/v1/sessions", body: {session: {email:, password:}}, account:)
+    assert_response :created
+    json.dig("session", "token")
+  end
+
+  CUSTOMER_PASSWORD = "my-customer-password"
+
+  # Registers a customer through the portal and confirms the emailed link. Returns the customer.
+  def verified_customer(account: "acme", name: "Avery", email: "avery@example.test", password: CUSTOMER_PASSWORD)
+    register_customer(account:, name:, email:, password:)
+    assert_response :created
+    token = link_token(last_mail)
+    api(:post, "/api/v1/email_verifications/confirm", body: {email_verification: {token:}}, account:)
+    assert_response :ok
+    Account.find_by!(subdomain: account).users.find_by!(email:)
+  end
+
+  def register_customer(account: "acme", name: "Avery", email: "avery@example.test", password: CUSTOMER_PASSWORD)
+    api(:post, "/api/v1/registrations", body: {user: {name:, email:, password:}}, account:)
+  end
+
+  # Signs in a verified customer and returns the bearer token.
+  def customer_token(account: "acme", email: "avery@example.test", password: CUSTOMER_PASSWORD)
+    sign_in(email:, password:, account:)
+  end
+
+  # Opens a request as the customer behind `token`. Returns the request's ID.
+  def open_request(token:, subject: "Cannot download my receipt", body: "The download button does nothing.", account: "acme")
+    api(:post, "/api/v1/requests", body: {request: {subject:, comment: {body:}}}, account:, token:)
+    assert_response :created
+    json.dig("request", "id")
+  end
+
+  def last_mail
+    ActionMailer::Base.deliveries.last
+  end
+
+  def link_token(mail)
+    mail.body.decoded[/token=([A-Za-z0-9_-]+)/, 1]
+  end
+
+  def header(name)
+    response.headers.to_h.transform_keys(&:downcase)[name.downcase]
+  end
+
+  # Temporarily sets environment variables for the duration of the block.
+  def with_env(vars)
+    saved = vars.keys.to_h { |key| [key, ENV[key]] }
+    vars.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
+    yield
+  ensure
+    saved.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
+  end
+end
+
+# Delivers mail the way the SMTP server does: a raw RFC 822 message posted to the relay ingress.
+module InboundMailHelpers
+  INBOUND_PASSWORD = "relay-test-password"
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails"
+
+  def relay(raw, password: INBOUND_PASSWORD)
+    headers = {"CONTENT_TYPE" => "message/rfc822"}
+    if password
+      headers["HTTP_AUTHORIZATION"] = ActionController::HttpAuthentication::Basic.encode_credentials("actionmailbox", password)
+    end
+    post(RELAY_PATH, params: raw.to_s, headers: headers)
+    response
+  end
+
+  # A plain-text message. Pass `headers:` to add or override headers.
+  def raw_mail(from: "Avery <avery@example.test>", to: "acme@support.example.test", cc: nil,
+    subject: "Cannot download my receipt", body: "The download button does nothing.",
+    message_id: "<#{SecureRandom.hex(8)}@example.test>", headers: {})
+    fields = {from:, to:, cc:, subject:, message_id:}.compact
+    mail = Mail.new(fields)
+    mail.body = body
+    headers.each { |name, value| mail.header[name] = value }
+    mail.to_s
+  end
+
+  def inbound_emails
+    ActionMailbox::InboundEmail.order(:id)
+  end
+
+  def account_tickets(subdomain = "acme")
+    Account.find_by!(subdomain:).tickets
+  end
+
+  def ticket_for(subject)
+    account_tickets.find_by!(subject:)
+  end
+end
