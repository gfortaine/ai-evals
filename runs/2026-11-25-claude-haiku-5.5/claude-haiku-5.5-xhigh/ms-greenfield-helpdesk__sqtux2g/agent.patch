diff --git a/app/serializers/ticket_serializer.rb b/app/serializers/ticket_serializer.rb
new file mode 100644
index 0000000..76cb633
--- /dev/null
+++ b/app/serializers/ticket_serializer.rb
@@ -0,0 +1,41 @@
+# A request as its customer sees it. Staff get the same record with the requester, group, assignee, and priority.
+# The group, assignment and priority are internal, so customers never see them.
+class TicketSerializer
+  def initialize(ticket, staff: false)
+    @ticket = ticket
+    @staff = staff
+  end
+
+  def as_json(*)
+    json = {
+      id: @ticket.id,
+      subject: @ticket.subject,
+      status: @ticket.status,
+      merged_into_id: @ticket.merged_into_id,
+      requester_id: @ticket.requester_id,
+      created_at: @ticket.created_at,
+      updated_at: @ticket.updated_at
+    }
+    return json unless @staff
+
+    json.merge(priority: @ticket.priority, requester: requester_json, group_id: @ticket.group_id, group: group_json,
+      assignee_id: @ticket.assignee_id, assignee: assignee_json)
+  end
+
+  private
+
+  def requester_json
+    requester = @ticket.requester
+    {id: requester.id, name: requester.name, email: requester.email}
+  end
+
+  def group_json
+    group = @ticket.group
+    group && {id: group.id, name: group.name}
+  end
+
+  def assignee_json
+    assignee = @ticket.assignee
+    assignee && {id: assignee.id, name: assignee.name}
+  end
+end
