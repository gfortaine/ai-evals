@@ -0,0 +1,30 @@
+class Comment < ApplicationRecord
+  BODY_MAX_LENGTH = 10_000
+
+  belongs_to :ticket, inverse_of: :comments
+  belongs_to :author, class_name: "User", inverse_of: :authored_comments
+
+  validates :body, presence: true, length: {maximum: BODY_MAX_LENGTH}
+  validates :public, inclusion: {in: [true, false]}
+
+  scope :public_only, -> { where(public: true) }
+
+  # A closed (merged) ticket takes no new comments. Ticket checks this under its edit lock first, so this is the
+  # last line of defence.
+  validate :ticket_accepts_comments, on: :create
+
+  # A public reply is customer-facing activity, so it makes the request the most recently active.
+  # A private note is internal: it leaves the request's updated_at, and so its place in the
+  # customer's list, exactly as it was.
+  after_create :touch_ticket, if: :public?
+
+  private
+
+  def touch_ticket
+    ticket.touch
+  end
+
+  def ticket_accepts_comments
+    errors.add(:ticket, "is closed") if ticket&.closed?
+  end
+end
