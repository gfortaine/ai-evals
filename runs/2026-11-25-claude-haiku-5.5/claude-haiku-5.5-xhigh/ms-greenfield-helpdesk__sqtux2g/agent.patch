diff --git a/lib/helpdesk/cors.rb b/lib/helpdesk/cors.rb
new file mode 100644
index 0000000..440d252
--- /dev/null
+++ b/lib/helpdesk/cors.rb
@@ -0,0 +1,46 @@
+module Helpdesk
+  # Allows browsers served from the configured frontend origin to call the API.
+  # Requests from any other origin are still processed, but get no CORS headers,
+  # so browsers refuse to expose their responses to that page.
+  class Cors
+    ALLOWED_METHODS = "GET, POST, PUT, PATCH, DELETE, OPTIONS".freeze
+    ALLOWED_HEADERS = "Authorization, Content-Type, Accept, X-Helpdesk-Account".freeze
+    MAX_AGE = "600".freeze
+
+    def initialize(app)
+      @app = app
+    end
+
+    def call(env)
+      origin = env["HTTP_ORIGIN"]
+      return @app.call(env) if origin.nil?
+
+      allowed = origin == Helpdesk::Settings.frontend_origin
+
+      if preflight?(env)
+        return [allowed ? 204 : 403, cors_headers(origin, allowed), []]
+      end
+
+      status, headers, body = @app.call(env)
+      [status, headers.merge(cors_headers(origin, allowed)), body]
+    end
+
+    private
+
+    def preflight?(env)
+      env["REQUEST_METHOD"] == "OPTIONS" && env["HTTP_ACCESS_CONTROL_REQUEST_METHOD"].present?
+    end
+
+    def cors_headers(origin, allowed)
+      headers = {"vary" => "Origin"}
+      return headers unless allowed
+
+      headers.merge(
+        "access-control-allow-origin" => origin,
+        "access-control-allow-methods" => ALLOWED_METHODS,
+        "access-control-allow-headers" => ALLOWED_HEADERS,
+        "access-control-max-age" => MAX_AGE
+      )
+    end
+  end
+end
diff --git a/lib/helpdesk/cursor.rb b/lib/helpdesk/cursor.rb
new file mode 100644
index 0000000..aab8970
--- /dev/null
+++ b/lib/helpdesk/cursor.rb
@@ -0,0 +1,32 @@
+module Helpdesk
+  # Opaque cursors for keyset pagination. A cursor is signed, so clients cannot alter it, and it names the scope it
+  # was issued for (the business and the endpoint). A cursor from one list does not open on another.
+  module Cursor
+    KEY_SALT = "helpdesk pagination cursor".freeze
+
+    module_function
+
+    # A cursor for `position` (already dumped with Keyset#dump) within the list named by `scope`.
+    def seal(scope:, position:)
+      verifier.generate({"scope" => scope, "position" => position})
+    end
+
+    # The dumped position inside `token`, or nil if the token was not issued for `scope` or was altered.
+    def open(token, scope:)
+      return unless token.is_a?(String)
+
+      payload = verifier.verified(token)
+      return unless payload.is_a?(Hash) && payload["scope"] == scope && payload["position"].is_a?(Array)
+
+      payload["position"]
+    end
+
+    def verifier
+      @verifier ||= ActiveSupport::MessageVerifier.new(
+        Rails.application.key_generator.generate_key(KEY_SALT),
+        url_safe: true,
+        serializer: :json
+      )
+    end
+  end
+end
diff --git a/lib/helpdesk/inbound_mail.rb b/lib/helpdesk/inbound_mail.rb
new file mode 100644
index 0000000..9d1d131
--- /dev/null
+++ b/lib/helpdesk/inbound_mail.rb
@@ -0,0 +1,128 @@
+require "loofah"
+
+module Helpdesk
+  # Reads an inbound email for the support mailbox: who it is addressed to, who sent it, and the subject
+  # and plain-text message to store. Nothing here touches the database.
+  module InboundMail
+    # A recipient on the support domain. `tag` is the part after "+" in the local part (a reply address), or nil.
+    Recipient = Data.define(:subdomain, :tag)
+
+    LOCAL_PART = /\A(?<subdomain>[^+@\s]+)(?:\+(?<tag>[^+@\s]+))?\z/
+    AUTOMATED_SENDER = /\A(mailer-daemon|postmaster|bounces?|(no|do-?not)-?reply)\z/
+    # Set by autoresponders. X-Auto-Response-Suppress is left out: it asks auto-responders to stay quiet, and
+    # some mail clients set it on ordinary messages.
+    AUTOMATED_HEADERS = %w[x-autoreply x-autorespond].freeze
+    BULK_PRECEDENCE = %w[bulk list junk auto_reply].freeze
+
+    module_function
+
+    # Every recipient on the support domain: To, Cc, Bcc and the forwarding headers the mail gem reads.
+    # A malformed entry is skipped, so it cannot fail the whole delivery.
+    def support_recipients(mail)
+      domain = Helpdesk::Settings.support_domain
+      mail.recipients.filter_map do |text|
+        address = parse_address(text)
+        next if address.nil? || address.domain.to_s.downcase != domain
+
+        match = LOCAL_PART.match(address.local.to_s.downcase)
+        Recipient.new(subdomain: match[:subdomain], tag: match[:tag]) if match
+      end
+    end
+
+    # Lowercase addresses from the From header. Malformed entries are left out.
+    def from_addresses(mail)
+      Array(mail.from).filter_map { |text| parse_address(text)&.address&.downcase }
+    end
+
+    # The address in `text`, or nil when it cannot be parsed.
+    def parse_address(text)
+      Mail::Address.new(text.to_s)
+    rescue StandardError
+      nil
+    end
+
+    # The sender's address when it is a usable one, else nil.
+    def sender_address(mail)
+      address = from_addresses(mail).first
+      address if valid_address?(address)
+    end
+
+    def valid_address?(address)
+      address.present? && address.length <= 254 && URI::MailTo::EMAIL_REGEXP.match?(address)
+    end
+
+    # The From display name, or the address's local part when the sender gave no name.
+    def sender_name(mail, address)
+      name = clean_line(mail.from_address&.display_name)
+      name = address.split("@").first if name.blank?
+      name.truncate(User::NAME_MAX_LENGTH, omission: "")
+    end
+
+    def subject(mail)
+      clean_line(mail.subject).truncate(Ticket::SUBJECT_MAX_LENGTH, omission: "").presence || "(no subject)"
+    end
+
+    # The plain-text message, stored as UTF-8 with line endings normalised.
+    def text_body(mail)
+      text = utf8(plain_text(mail)).delete("\u0000").gsub(/\r\n?/, "\n").strip
+      text.truncate(Comment::BODY_MAX_LENGTH, omission: "").presence || "(no message text)"
+    end
+
+    # Automated and list mail (auto-replies, bounces, notifications, newsletters). It is not a support request.
+    def automated?(mail)
+      names = mail.header.fields.map { |field| field.name.downcase }
+      return true if names.any? { |name| name.start_with?("list-") } || names.intersect?(AUTOMATED_HEADERS)
+
+      auto_submitted = mail.header["Auto-Submitted"]&.value.to_s.strip.downcase
+      return true if auto_submitted.present? && auto_submitted != "no"
+      return true if BULK_PRECEDENCE.include?(mail.header["Precedence"]&.value.to_s.strip.downcase)
+      return true if mail.mime_type == "multipart/report"
+      # An empty Return-Path (<>) is the null sender that bounces and auto-replies use.
+      return true if mail.header["Return-Path"] && mail.header["Return-Path"].value.to_s.strip.empty?
+
+      local = from_addresses(mail).first.to_s.split("@").first.to_s.split("+").first.to_s
+      AUTOMATED_SENDER.match?(local)
+    end
+
+    # The text/plain part. If that part is blank, the text/html part converted to text.
+    def plain_text(mail)
+      parts = (mail.multipart? ? mail.all_parts.reject(&:multipart?) : [mail]).reject(&:attachment?)
+
+      plain = parts.find { |part| part.mime_type.nil? || part.mime_type == "text/plain" }
+      text = plain ? decode(plain) : ""
+      return text if text.strip.present?
+
+      html = parts.find { |part| part.mime_type == "text/html" }
+      html ? html_to_text(decode(html)) : text
+    end
+
+    def decode(part)
+      part.decoded.to_s
+    rescue StandardError
+      part.body.raw_source.to_s
+    end
+
+    # Turns line breaks and paragraph ends into newlines, drops script, style and head content, and
+    # decodes entities.
+    def html_to_text(html)
+      html = html.gsub(%r{<br\s*/?>}i, "\n").gsub(%r{</(p|div|li|tr|h[1-6])\s*>}i, "\n")
+      fragment = Loofah.fragment(html)
+      fragment.xpath(".//script|.//style|.//head|.//title").each(&:remove)
+      fragment.text(encode_special_chars: false)
+    end
+
+    def clean_line(text)
+      utf8(text).delete("\u0000").gsub(/[[:space:]]+/, " ").strip
+    end
+
+    # Converts text to valid UTF-8, replacing bytes that cannot be read, so it can be stored.
+    def utf8(text)
+      text = text.to_s
+      case text.encoding
+      when Encoding::UTF_8 then text.scrub("?")
+      when Encoding::BINARY then text.dup.force_encoding(Encoding::UTF_8).scrub("?")
+      else text.encode(Encoding::UTF_8, invalid: :replace, undef: :replace, replace: "?")
+      end
+    end
+  end
+end
diff --git a/lib/helpdesk/keyset.rb b/lib/helpdesk/keyset.rb
new file mode 100644
index 0000000..71afc37
--- /dev/null
+++ b/lib/helpdesk/keyset.rb
@@ -0,0 +1,121 @@
+module Helpdesk
+  # Keyset ("cursor") pagination over a list that has a fixed sort order.
+  #
+  # A page is found from the sort values of a boundary record, not by counting rows, so the cost of a page does
+  # not grow with how far into the list it is. The sort ends with the primary key, which breaks ties, so every
+  # record has exactly one position in the list. Positions are compared with row values, such as
+  # (updated_at, id) < (...), which is what lets a btree index serve each page.
+  #
+  # A cursor holds the sort values of its record, not the record itself. So a cursor still works after its record
+  # changes or is deleted, and the next page is still the records after that position.
+  class Keyset
+    # Raised when a cursor's position does not fit the list's sort columns.
+    class Invalid < StandardError; end
+
+    # One page. `records` are in list order. `more_after` means more records follow the page in list order, and
+    # `more_before` means more come before it. Both are false for an empty page.
+    Page = Data.define(:records, :more_before, :more_after)
+
+    MAX_ID = 2**63 - 1
+
+    attr_reader :columns
+
+    def initialize(*columns, descending: false)
+      @columns = columns.map(&:to_sym).freeze
+      @descending = descending
+      freeze
+    end
+
+    # The position of a record: its sort values, in column order.
+    def position_of(record)
+      columns.map { |column| record.public_send(column) }
+    end
+
+    # A position as plain JSON values. Times keep their microseconds, so a position reads back exactly.
+    def dump_position(position)
+      position.map { |value| value.is_a?(Time) ? value.utc.iso8601(6) : value }
+    end
+
+    # Reads a position dumped earlier, for the model class `klass`. Raises Invalid if it does not fit the columns.
+    def load_position(raw, klass)
+      raise Invalid unless raw.is_a?(Array) && raw.size == columns.size
+
+      columns.zip(raw).map do |column, value|
+        case klass.type_for_attribute(column.to_s).type
+        when :datetime then load_time(value)
+        when :integer then load_id(value)
+        else raise Invalid, "unsupported sort column #{column}"
+        end
+      end
+    end
+
+    # One page of `scope`, in list order, of at most `size` records. Give `after:` for the records that follow a
+    # position, or `before:` for the records that precede it (both exclusive), or neither for the first page.
+    # Give at most one of them.
+    def page(scope, size:, after: nil, before: nil)
+      raise ArgumentError, "give after or before, not both" if after && before
+
+      if before
+        rows = before_position(scope, before).reorder(order_by(scope, reverse: true)).limit(size + 1).to_a
+        records = rows.first(size).reverse
+        more_before = rows.size > size
+        more_after = records.any? && after_position(scope, position_of(records.last)).exists?
+      else
+        relation = after ? after_position(scope, after) : scope
+        rows = relation.reorder(order_by(scope)).limit(size + 1).to_a
+        records = rows.first(size)
+        more_after = rows.size > size
+        # Nothing precedes the first page, so that page needs no extra query.
+        more_before = !after.nil? && records.any? && before_position(scope, position_of(records.first)).exists?
+      end
+
+      Page.new(records:, more_before:, more_after:)
+    end
+
+    private
+
+    def order_by(scope, reverse: false)
+      table = scope.klass.arel_table
+      columns.map { |column| table[column].public_send((@descending ^ reverse) ? :desc : :asc) }
+    end
+
+    # Records further along the list than `position`.
+    def after_position(scope, position)
+      compare(scope, @descending ? "<" : ">", position)
+    end
+
+    # Records earlier in the list than `position`.
+    def before_position(scope, position)
+      compare(scope, @descending ? ">" : "<", position)
+    end
+
+    def compare(scope, operator, position)
+      klass = scope.klass
+      quoted = columns.map { |column| "#{klass.quoted_table_name}.#{klass.connection.quote_column_name(column)}" }
+      marks = Array.new(columns.size, "?").join(", ")
+      scope.where("(#{quoted.join(", ")}) #{operator} (#{marks})", *position)
+    end
+
+    def load_time(value)
+      raise Invalid unless value.is_a?(String)
+
+      Time.iso8601(value).utc
+    rescue ArgumentError
+      raise Invalid
+    end
+
+    def load_id(value)
+      raise Invalid unless value.is_a?(Integer) && value.positive? && value <= MAX_ID
+
+      value
+    end
+
+    # The orders the lists use. Each one must match the scope's own order (the tests check this).
+    # Most recently active first: tickets and requests.
+    RECENT_FIRST = new(:updated_at, :id, descending: true)
+    # Oldest first: comments on a ticket or request.
+    OLDEST_FIRST = new(:created_at, :id)
+    # By ID ascending: people, invitations, groups and memberships.
+    BY_ID = new(:id)
+  end
+end
diff --git a/lib/helpdesk/settings.rb b/lib/helpdesk/settings.rb
new file mode 100644
index 0000000..0e65d97
--- /dev/null
+++ b/lib/helpdesk/settings.rb
@@ -0,0 +1,45 @@
+module Helpdesk
+  # Runtime configuration. Values are read from the environment on each call so
+  # that changes (for example in tests) take effect without a restart.
+  module Settings
+    DEFAULT_FRONTEND_URL = "http://localhost:3001".freeze
+    DEFAULT_MAIL_FROM = "support@example.test".freeze
+    DEFAULT_SUPPORT_DOMAIN = "support.example.test".freeze
+
+    module_function
+
+    # Base URL of the separate frontend app, without a trailing slash.
+    def frontend_url
+      ENV.fetch("HELPDESK_FRONTEND_URL", "").presence&.sub(%r{/+\z}, "") || DEFAULT_FRONTEND_URL
+    end
+
+    # Browser origin (scheme, host and non-default port) allowed to call the API.
+    def frontend_origin
+      uri = URI.parse(frontend_url)
+      origin = "#{uri.scheme}://#{uri.host}"
+      origin += ":#{uri.port}" unless uri.port == uri.default_port
+      origin
+    end
+
+    def mail_from
+      ENV.fetch("HELPDESK_MAIL_FROM", "").presence || DEFAULT_MAIL_FROM
+    end
+
+    # Domain that receives support mail. Each business gets <subdomain>@<support domain>.
+    def support_domain
+      ENV.fetch("HELPDESK_SUPPORT_DOMAIN", "").presence&.strip&.downcase || DEFAULT_SUPPORT_DOMAIN
+    end
+
+    # Address of a business, e.g. support_address("acme") => "acme@support.example.test". With a tag,
+    # the address is a private reply address, e.g. support_address("acme", tag: "ab12") => "acme+ab12@...".
+    def support_address(subdomain, tag: nil)
+      local = tag ? "#{subdomain}+#{tag}" : subdomain
+      "#{local}@#{support_domain}"
+    end
+
+    # Link to a page in the frontend app, e.g. frontend_link("/verify-email", account: "acme", token: "...").
+    def frontend_link(path, **query)
+      "#{frontend_url}#{path}?#{query.to_query}"
+    end
+  end
+end
diff --git a/lib/helpdesk/token.rb b/lib/helpdesk/token.rb
new file mode 100644
index 0000000..06f1ed7
--- /dev/null
+++ b/lib/helpdesk/token.rb
@@ -0,0 +1,17 @@
+require "digest"
+
+module Helpdesk
+  # Random single-use tokens. Only the SHA-256 digest is stored, so a leaked
+  # database does not reveal usable sessions or email links.
+  module Token
+    module_function
+
+    def generate
+      SecureRandom.urlsafe_base64(32)
+    end
+
+    def digest(raw)
+      Digest::SHA256.hexdigest(raw.to_s)
+    end
+  end
+end
