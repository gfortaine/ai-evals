+class AddSourceAndReplyTokenToTickets < ActiveRecord::Migration[8.1]
+  def up
+    # "portal" for requests opened in the portal, "email" for tickets opened from inbound mail.
+    add_column :tickets, :source, :string, null: false, default: "portal"
+    add_check_constraint :tickets, "source IN ('portal', 'email')", name: "tickets_source_valid"
+
+    # Each ticket's private reply address is <subdomain>+<reply_token>@<support domain>.
+    add_column :tickets, :reply_token, :string
+    # Existing tickets get a token from gen_random_uuid(), which is cryptographically random (PostgreSQL 13+).
+    execute "UPDATE tickets SET reply_token = replace(gen_random_uuid()::text, '-', '')"
+    change_column_null :tickets, :reply_token, false
+    add_index :tickets, :reply_token, unique: true
+  end
