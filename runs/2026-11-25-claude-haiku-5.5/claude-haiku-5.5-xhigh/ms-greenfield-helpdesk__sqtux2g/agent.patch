+require "test_helper"
+
+class UsersTest < ApiIntegrationTest
+  setup do
+    @owner = verified_owner
+    @owner_token = sign_in
+    verified_customer
+    @avery = Account.find_by!(subdomain: "acme").users.find_by!(email: "avery@example.test")
+    @avery_token = customer_token
+    add_user(name: "Pat", email: "pat@acme.test", role: "agent")
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def add_user(name:, email:, role:, suspended: false)
+    Account.find_by!(subdomain: "acme").users.create!(name:, email:, password: PASSWORD, role:, verified: true,
+      suspended:)
+  end
+
+  def patch_user(id, body, token: @owner_token, account: "acme")
+    api(:patch, "/api/v1/users/#{id}", body: {user: body}, account:, token:)
+  end
+
+  test "admins list users by ID ascending" do
+    api(:get, "/api/v1/users", account: "acme", token: @owner_token)
+
+    assert_response :ok
+    assert_equal User.where(account: Account.find_by!(subdomain: "acme")).order(:id).pluck(:id),
+      json["users"].pluck("id")
+    assert_equal 3, json["count"]
+    assert_equal false, json["users"].first["suspended"]
+  end
+
+  test "users can be filtered by role" do
+    api(:get, "/api/v1/users?role=agent", account: "acme", token: @owner_token)
+    assert_equal ["Pat"], json["users"].pluck("name")
+
+    api(:get, "/api/v1/users?role=customer", account: "acme", token: @owner_token)
+    assert_equal ["Avery"], json["users"].pluck("name")
+  end
+
+  test "users can be filtered by suspension" do
+    patch_user(@avery.id, {suspended: true})
+    assert_response :ok
+
+    api(:get, "/api/v1/users?suspended=true", account: "acme", token: @owner_token)
+    assert_equal ["Avery"], json["users"].pluck("name")
+
+    api(:get, "/api/v1/users?suspended=false", account: "acme", token: @owner_token)
+    assert_equal ["Jo", "Pat"], json["users"].pluck("name")
+  end
+
+  test "a filter value outside the known values is refused" do
+    api(:get, "/api/v1/users?role=superuser", account: "acme", token: @owner_token)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "role").present?
+
+    api(:get, "/api/v1/users?suspended=maybe", account: "acme", token: @owner_token)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "suspended").present?
+  end
+
+  test "admins inspect a user, and users of other businesses are not found" do
+    api(:get, "/api/v1/users/#{@avery.id}", account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal({"id" => @avery.id, "name" => "Avery", "email" => "avery@example.test", "role" => "customer",
+                  "verified" => true, "suspended" => false},
+      json["user"].slice("id", "name", "email", "role", "verified", "suspended"))
+
+    verified_owner(subdomain: "globex", email: "jo@globex.test")
+    globex_token = sign_in(email: "jo@globex.test", account: "globex")
+    api(:get, "/api/v1/users/#{@avery.id}", account: "globex", token: globex_token)
+    assert_response :not_found
+    patch_user(@avery.id, {suspended: true}, token: globex_token, account: "globex")
+    assert_response :not_found
+    refute @avery.reload.suspended?
+  end
+
+  test "agents and customers cannot manage people" do
+    pat_token = sign_in(email: "pat@acme.test")
+
+    [@avery_token, pat_token].each do |token|
+      api(:get, "/api/v1/users", account: "acme", token:)
+      assert_response :forbidden
+      api(:get, "/api/v1/users/#{@avery.id}", account: "acme", token:)
+      assert_response :forbidden
+      patch_user(@avery.id, {suspended: true}, token:)
+      assert_response :forbidden
+    end
+    refute @avery.reload.suspended?
+  end
+
+  test "suspending a user signs them out everywhere and blocks sign-in" do
+    patch_user(@avery.id, {suspended: true})
+
+    assert_response :ok
+    assert_equal true, json.dig("user", "suspended")
+    assert @avery.reload.suspended?
+
+    api(:get, "/api/v1/requests", account: "acme", token: @avery_token)
+    assert_response :unauthorized
+
+    api(:post, "/api/v1/sessions", body: {session: {email: "avery@example.test", password: CUSTOMER_PASSWORD}},
+      account: "acme")
+    assert_response :forbidden
+    assert_equal "user_suspended", json.dig("error", "code")
+  end
+
+  test "restoring a suspended user lets them sign in again" do
+    patch_user(@avery.id, {suspended: true})
+    patch_user(@avery.id, {suspended: false})
+
+    assert_response :ok
+    assert_equal false, json.dig("user", "suspended")
+    customer_token
+    assert_response :created
+  end
+
+  test "suspending a user clears their ticket assignments without changing the customer's request" do
+    request_id = open_request(token: @avery_token)
+    pat = User.find_by!(email: "pat@acme.test")
+    api(:patch, "/api/v1/tickets/#{request_id}", body: {ticket: {assignee_id: pat.id}}, account: "acme",
+      token: @owner_token)
+    assert_response :ok
+    assert_equal pat.id, Ticket.find(request_id).assignee_id
+
+    api(:get, "/api/v1/requests/#{request_id}", account: "acme", token: @avery_token)
+    customer_view = json["request"]
+    before = Ticket.find(request_id).updated_at
+
+    travel 1.minute do
+      patch_user(pat.id, {suspended: true})
+    end
+    assert_response :ok
+
+    ticket = Ticket.find(request_id)
+    assert_nil ticket.assignee_id
+    assert_equal before.to_i, ticket.updated_at.to_i
+    api(:get, "/api/v1/requests/#{request_id}", account: "acme", token: @avery_token)
+    assert_equal customer_view, json["request"]
+  end
+
+  test "the last active admin cannot be suspended" do
+    patch_user(@owner.id, {suspended: true})
+
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "details", "suspended").present?
+    refute @owner.reload.suspended?
+    api(:get, "/api/v1/users", account: "acme", token: @owner_token)
+    assert_response :ok
+  end
+
+  test "another admin can be suspended while one active admin remains, then not the last" do
+    add_user(name: "Lee", email: "lee@acme.test", role: "admin")
+    lee = User.find_by!(email: "lee@acme.test")
+
+    patch_user(lee.id, {suspended: true})
+    assert_response :ok
+    assert lee.reload.suspended?
+
+    patch_user(@owner.id, {suspended: true})
+    assert_response :unprocessable_entity
+    refute @owner.reload.suspended?
+  end
+
+  test "a suspended admin does not count as an active admin" do
+    lee = add_user(name: "Lee", email: "lee@acme.test", role: "admin")
+    lee_token = sign_in(email: "lee@acme.test")
+
+    patch_user(lee.id, {suspended: true})
+    patch_user(@owner.id, {suspended: true}, token: @owner_token)
+    assert_response :unprocessable_entity
+
+    api(:get, "/api/v1/users", account: "acme", token: lee_token)
+    assert_response :unauthorized
+  end
+
+  test "suspending a customer or agent is not limited by the admin rule" do
+    patch_user(@avery.id, {suspended: true})
+    assert_response :ok
+
+    pat = User.find_by!(email: "pat@acme.test")
+    patch_user(pat.id, {suspended: true})
+    assert_response :ok
+  end
+
+  test "suspension must be sent as true or false, and something must be sent" do
+    patch_user(@avery.id, {suspended: "sometimes"})
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "suspended").present?
+
+    patch_user(@avery.id, {suspended: nil})
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "suspended").present?
+
+    patch_user(@avery.id, {})
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+    refute @avery.reload.suspended?
+  end
+
+  test "only suspension can be changed through the users endpoint" do
+    patch_user(@avery.id, {name: "Renamed", role: "admin"})
+
+    assert_response :unprocessable_entity
+    assert_equal "Avery", @avery.reload.name
+    assert_equal "customer", @avery.role
+  end
+end
diff --git a/test/lib/helpdesk/cursor_test.rb b/test/lib/helpdesk/cursor_test.rb
new file mode 100644
index 0000000..f565c70
--- /dev/null
+++ b/test/lib/helpdesk/cursor_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Helpdesk::CursorTest < ActiveSupport::TestCase
+  POSITION = ["2026-01-02T03:04:05.123456Z", 9].freeze
+
+  test "a sealed cursor opens to its position in the same scope" do
+    token = Helpdesk::Cursor.seal(scope: "1:/api/v1/tickets", position: POSITION)
+
+    assert_equal POSITION, Helpdesk::Cursor.open(token, scope: "1:/api/v1/tickets")
+  end
+
+  test "a cursor does not open in another scope" do
+    token = Helpdesk::Cursor.seal(scope: "1:/api/v1/tickets", position: POSITION)
+
+    assert_nil Helpdesk::Cursor.open(token, scope: "1:/api/v1/requests")
+    assert_nil Helpdesk::Cursor.open(token, scope: "2:/api/v1/tickets")
+  end
+
+  test "an altered, foreign or missing cursor does not open" do
+    token = Helpdesk::Cursor.seal(scope: "1:/api/v1/tickets", position: POSITION)
+
+    assert_nil Helpdesk::Cursor.open(token.tr("a-f", "b-g"), scope: "1:/api/v1/tickets")
+    assert_nil Helpdesk::Cursor.open("not a cursor", scope: "1:/api/v1/tickets")
+    assert_nil Helpdesk::Cursor.open(nil, scope: "1:/api/v1/tickets")
+    assert_nil Helpdesk::Cursor.open(42, scope: "1:/api/v1/tickets")
+  end
+
+  test "a cursor from a different secret does not open" do
+    other = ActiveSupport::MessageVerifier.new("another secret that is long enough to be used", url_safe: true,
+      serializer: :json)
+    forged = other.generate({"scope" => "1:/api/v1/tickets", "position" => POSITION})
+
+    assert_nil Helpdesk::Cursor.open(forged, scope: "1:/api/v1/tickets")
+  end
+
+  test "cursors are URL-safe" do
+    20.times do |i|
+      token = Helpdesk::Cursor.seal(scope: "1:/api/v1/tickets", position: ["2026-01-02T03:04:05.#{i}Z", i + 1])
+
+      assert_match(/\A[A-Za-z0-9_\-]+\z/, token)
+    end
+  end
+end
diff --git a/test/lib/helpdesk/keyset_test.rb b/test/lib/helpdesk/keyset_test.rb
new file mode 100644
index 0000000..6afe6a9
--- /dev/null
+++ b/test/lib/helpdesk/keyset_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Helpdesk::KeysetTest < ActiveSupport::TestCase
+  MICRO = Time.utc(2026, 1, 2, 3, 4, 5, 123_456)
+
+  test "a dumped position keeps every microsecond of its timestamp" do
+    dumped = Helpdesk::Keyset::RECENT_FIRST.dump_position([MICRO, 9])
+
+    assert_equal ["2026-01-02T03:04:05.123456Z", 9], dumped
+    loaded = Helpdesk::Keyset::RECENT_FIRST.load_position(dumped, Ticket)
+    assert_equal [MICRO, 9], loaded
+    assert_equal 123_456, loaded.first.usec
+  end
+
+  test "positions come from the record's sort columns, in order" do
+    ticket = Ticket.new(id: 7, updated_at: MICRO, created_at: MICRO + 1)
+
+    assert_equal [MICRO, 7], Helpdesk::Keyset::RECENT_FIRST.position_of(ticket)
+    assert_equal [MICRO + 1, 7], Helpdesk::Keyset::OLDEST_FIRST.position_of(ticket)
+    assert_equal [7], Helpdesk::Keyset::BY_ID.position_of(ticket)
+  end
+
+  test "a position that does not fit the columns is refused" do
+    keyset = Helpdesk::Keyset::RECENT_FIRST
+    valid_time = "2026-01-02T03:04:05.123456Z"
+
+    [
+      [valid_time],                       # too short
+      [valid_time, 9, 1],                 # too long
+      ["2026-01-02T03:04:05.123456Z", "9"], # the ID as text
+      [valid_time, 0],                    # not a positive ID
+      [valid_time, -4],
+      [valid_time, 2**63],                # beyond a bigint
+      [nil, 9],
+      ["yesterday", 9],                   # not a timestamp
+      [1_767_323_045, 9],                 # a timestamp as a number
+      "9"
+    ].each do |raw|
+      assert_raises(Helpdesk::Keyset::Invalid, "#{raw.inspect} should be refused") do
+        keyset.load_position(raw, Ticket)
+      end
+    end
+  end
+
+  test "a column that is neither a timestamp nor an ID is refused" do
+    assert_raises(Helpdesk::Keyset::Invalid) { Helpdesk::Keyset.new(:subject).load_position(["hello"], Ticket) }
+  end
+
+  test "page refuses both directions at once" do
+    error = assert_raises(ArgumentError) do
+      Helpdesk::Keyset::BY_ID.page(Ticket.all, size: 2, after: [1], before: [5])
+    end
+    assert_match(/after or before/, error.message)
+  end
+
+  test "the list orders are the ones the lists use" do
+    assert_equal %i[updated_at id], Helpdesk::Keyset::RECENT_FIRST.columns
+    assert_equal %i[created_at id], Helpdesk::Keyset::OLDEST_FIRST.columns
+    assert_equal %i[id], Helpdesk::Keyset::BY_ID.columns
+  end
+end
