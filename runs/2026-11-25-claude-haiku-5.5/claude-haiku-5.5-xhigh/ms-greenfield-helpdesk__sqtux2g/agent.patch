+++ b/test/integration/staff_tickets_test.rb
@@ -0,0 +1,182 @@
+require "test_helper"
+
+class StaffTicketsTest < ApiIntegrationTest
+  setup do
+    @owner = verified_owner
+    @owner_token = sign_in
+    verified_customer
+    @avery_token = customer_token
+    @request_id = open_request(token: @avery_token, subject: "Cannot download my receipt")
+  end
+
+  test "lists every request in the business with its requester, most recently active first" do
+    verified_customer(email: "sam@example.test", name: "Sam")
+    newer = open_request(token: customer_token(email: "sam@example.test"), subject: "Login loop")
+
+    api(:get, "/api/v1/tickets", account: "acme", token: @owner_token)
+
+    assert_response :ok
+    assert_equal [newer, @request_id], json["tickets"].pluck("id")
+    assert_equal 2, json["count"]
+    first = json["tickets"].first
+    assert_equal "Login loop", first["subject"]
+    assert_equal "open", first["status"]
+    assert_equal({"id" => Ticket.find(newer).requester_id, "name" => "Sam", "email" => "sam@example.test"},
+      first["requester"])
+    assert_equal Ticket.find(newer).requester_id, first["requester_id"]
+  end
+
+  test "shows a ticket with the requester included" do
+    api(:get, "/api/v1/tickets/#{@request_id}", account: "acme", token: @owner_token)
+
+    assert_response :ok
+    ticket = json.fetch("ticket")
+    assert_equal @request_id, ticket["id"]
+    assert_equal({"id" => Ticket.find(@request_id).requester_id, "name" => "Avery", "email" => "avery@example.test"},
+      ticket["requester"])
+    assert ticket["created_at"].present?
+    assert ticket["updated_at"].present?
+  end
+
+  test "a staff reply with a pending status is public and visible to the customer" do
+    api(:patch, "/api/v1/tickets/#{@request_id}", body: {
+      ticket: {comment: {body: "Please try again now."}, status: "pending"}
+    }, account: "acme", token: @owner_token)
+
+    assert_response :ok
+    assert_equal "pending", json.dig("ticket", "status")
+    assert_equal "pending", Ticket.find(@request_id).status
+
+    api(:get, "/api/v1/requests/#{@request_id}/comments", account: "acme", token: @avery_token)
+    reply = json["comments"].last
+    assert_equal "Please try again now.", reply["body"]
+    assert_equal({"id" => @owner.id, "name" => "Jo"}, reply["author"])
+    assert_equal true, reply["public"]
+  end
+
+  test "a reply alone does not change the status, even on a solved request" do
+    Ticket.find(@request_id).update!(status: "solved")
+
+    api(:patch, "/api/v1/tickets/#{@request_id}", body: {ticket: {comment: {body: "Looking into it."}}},
+      account: "acme", token: @owner_token)
+
+    assert_response :ok
+    assert_equal "solved", json.dig("ticket", "status")
+    assert_equal "solved", Ticket.find(@request_id).status
+    assert_equal "Looking into it.", Ticket.find(@request_id).comments.order(:id).last.body
+  end
+
+  test "staff can set open, pending or solved without a reply" do
+    %w[pending solved open].each do |status|
+      api(:patch, "/api/v1/tickets/#{@request_id}", body: {ticket: {status:}}, account: "acme", token: @owner_token)
+      assert_response :ok
+      assert_equal status, json.dig("ticket", "status")
+    end
+    assert_equal 1, Comment.count
+  end
+
+  test "an unknown status is refused and the reply is not saved" do
+    api(:patch, "/api/v1/tickets/#{@request_id}", body: {
+      ticket: {comment: {body: "Hello"}, status: "archived"}
+    }, account: "acme", token: @owner_token)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "status").present?
+    assert_equal 1, Comment.count
+    assert_equal "open", Ticket.find(@request_id).status
+  end
+
+  test "a reply sent as plain text is refused rather than silently dropped" do
+    api(:patch, "/api/v1/tickets/#{@request_id}", body: {
+      ticket: {comment: "Please try again now.", status: "pending"}
+    }, account: "acme", token: @owner_token)
+
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "details", "comment").present?
+    assert_equal "open", Ticket.find(@request_id).status
+    assert_equal 1, Comment.count
+  end
+
+  test "a status sent as an object is refused" do
+    api(:patch, "/api/v1/tickets/#{@request_id}", body: {
+      ticket: {comment: {body: "Hello"}, status: {value: "pending"}}
+    }, account: "acme", token: @owner_token)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "status").present?
+    assert_equal 1, Comment.count
+  end
+
+  test "a null status is refused" do
+    api(:patch, "/api/v1/tickets/#{@request_id}", body: {ticket: {status: nil}}, account: "acme", token: @owner_token)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "status").present?
+  end
+
+  test "an update needs a reply or a status" do
+    api(:patch, "/api/v1/tickets/#{@request_id}", body: {ticket: {subject: "Renamed"}}, account: "acme", token: @owner_token)
+
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert_equal "Cannot download my receipt", Ticket.find(@request_id).subject
+  end
+
+  test "a private note is hidden from the customer but shown to staff" do
+    api(:patch, "/api/v1/tickets/#{@request_id}", body: {
+      ticket: {comment: {body: "Refund approved internally", public: false}}
+    }, account: "acme", token: @owner_token)
+
+    assert_response :ok
+    api(:get, "/api/v1/requests/#{@request_id}/comments", account: "acme", token: @avery_token)
+    assert_equal ["The download button does nothing."], json["comments"].pluck("body")
+
+    api(:get, "/api/v1/tickets/#{@request_id}/comments", account: "acme", token: @owner_token)
+    assert_response :ok
+    assert_equal ["The download button does nothing.", "Refund approved internally"], json["comments"].pluck("body")
+    assert_equal [true, false], json["comments"].pluck("public")
+  end
+
+  test "staff comments list shows every comment oldest first with author and timestamps" do
+    api(:get, "/api/v1/tickets/#{@request_id}/comments", account: "acme", token: @owner_token)
+
+    assert_response :ok
+    comment = json.fetch("comments").first
+    assert_equal "The download button does nothing.", comment["body"]
+    assert_equal({"id" => Ticket.find(@request_id).requester_id, "name" => "Avery"}, comment["author"])
+    assert comment["created_at"].present?
+    assert_equal 1, json["count"]
+  end
+
+  test "a customer's reply after a staff reply reopens the request" do
+    api(:patch, "/api/v1/tickets/#{@request_id}", body: {ticket: {status: "solved"}}, account: "acme", token: @owner_token)
+
+    api(:patch, "/api/v1/requests/#{@request_id}", body: {request: {comment: {body: "Still broken"}}},
+      account: "acme", token: @avery_token)
+
+    assert_response :ok
+    assert_equal "open", Ticket.find(@request_id).status
+  end
+
+  test "a staff member who is only an agent can work tickets" do
+    Account.find_by!(subdomain: "acme").users.create!(name: "Pat", email: "pat@acme.test", password: PASSWORD,
+      role: "agent", verified: true)
+    agent_token = sign_in(email: "pat@acme.test")
+
+    api(:get, "/api/v1/tickets", account: "acme", token: agent_token)
+    assert_response :ok
+  end
+
+  test "tickets of another business are not found" do
+    verified_owner(subdomain: "globex", email: "jo@globex.test")
+    globex_owner = sign_in(email: "jo@globex.test", account: "globex")
+
+    api(:get, "/api/v1/tickets/#{@request_id}", account: "globex", token: globex_owner)
+    assert_response :not_found
+
+    api(:patch, "/api/v1/tickets/#{@request_id}", body: {ticket: {status: "solved"}}, account: "globex", token: globex_owner)
+    assert_response :not_found
+    assert_equal "open", Ticket.find(@request_id).status
+  end
+end
diff --git a/test/integration/ticket_filters_test.rb b/test/integration/ticket_filters_test.rb
new file mode 100644
index 0000000..e65e6c4
--- /dev/null
+++ b/test/integration/ticket_filters_test.rb
@@ -0,0 +1,370 @@
+require "test_helper"
+
+class TicketFiltersTest < ApiIntegrationTest
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    @owner = verified_owner
+    @owner_token = sign_in
+    @pat = Account.find_by!(subdomain: "acme").users.create!(name: "Pat", email: "pat@acme.test",
+      password: PASSWORD, role: "agent", verified: true)
+    @pat_token = sign_in(email: "pat@acme.test")
+    verified_customer
+    @avery_token = customer_token
+    verified_customer(email: "sam@example.test", name: "Sam")
+    @sam_token = customer_token(email: "sam@example.test")
+    @sam = User.find_by!(email: "sam@example.test")
+    @avery = User.find_by!(email: "avery@example.test")
+  end
+
+  def staff_list(**filters)
+    api(:get, "/api/v1/tickets?#{URI.encode_www_form(filters)}", account: "acme", token: @owner_token)
+    assert_response :ok
+    json
+  end
+
+  # Ticket IDs in a staff list, compared as sets (the list order is covered by its own test).
+  def assert_tickets(expected, **filters)
+    assert_equal expected.sort, staff_list(**filters)["tickets"].pluck("id").sort, "filters: #{filters.inspect}"
+  end
+
+  def assert_customer_requests(expected, **filters)
+    api(:get, "/api/v1/requests?#{URI.encode_www_form(filters)}", account: "acme", token: @avery_token)
+    assert_response :ok
+    assert_equal expected.sort, json["requests"].pluck("id").sort, "filters: #{filters.inspect}"
+  end
+
+  def staff_update(id, body, token: @owner_token)
+    api(:patch, "/api/v1/tickets/#{id}", body: {ticket: body}, account: "acme", token:)
+  end
+
+  # A small inbox used by most tests:
+  #   receipt   Avery, open, unassigned, normal. Subject and public comment mention "receipt".
+  #   login     Avery, pending, assigned to Pat, high.
+  #   refund    Sam, open, unassigned, high. Subject "Refund for 50% off order". Public comment "receipt_id".
+  #   invoice   Sam, solved, unassigned, normal. Only a private note mentions "receipt".
+  def build_inbox
+    @receipt = open_request(token: @avery_token, subject: "Cannot download my receipt",
+      body: "The download button does nothing.")
+    @login = open_request(token: @avery_token, subject: "Login loop", body: "It spins forever.")
+    @refund = open_request(token: @sam_token, subject: "Refund for 50% off order", body: "Please check the receipt_id field.")
+    @invoice = open_request(token: @sam_token, subject: "Typo in invoice", body: "Name is misspelled.")
+    Ticket.find(@invoice).comments.create!(author: @owner, body: "The receipt looks fake.", public: false)
+    staff_update(@login, {status: "pending", assignee_id: @pat.id, priority: "high"}, token: @pat_token)
+    staff_update(@refund, {priority: "high"})
+    staff_update(@invoice, {status: "solved"})
+  end
+
+  test "priority defaults to normal for new requests and shows on every staff ticket response" do
+    id = open_request(token: @avery_token)
+
+    api(:get, "/api/v1/tickets/#{id}", account: "acme", token: @owner_token)
+    assert_equal "normal", json.dig("ticket", "priority")
+
+    api(:get, "/api/v1/tickets", account: "acme", token: @owner_token)
+    assert_equal ["normal"], json["tickets"].pluck("priority")
+  end
+
+  test "staff can mark a ticket high and back to normal without a reply" do
+    id = open_request(token: @avery_token)
+
+    staff_update(id, {priority: "high"})
+    assert_response :ok
+    assert_equal "high", json.dig("ticket", "priority")
+    assert_equal "high", Ticket.find(id).priority
+    assert_equal 1, Comment.count, "a priority change adds no comment"
+
+    staff_update(id, {priority: "normal"})
+    assert_response :ok
+    assert_equal "normal", json.dig("ticket", "priority")
+  end
+
+  test "priority can be set with a reply, a status, and an assignment in one update" do
+    id = open_request(token: @avery_token)
+
+    staff_update(id, {comment: {body: "Looking now."}, status: "pending", assignee_id: @pat.id, priority: "high"})
+
+    assert_response :ok
+    ticket = json.fetch("ticket")
+    assert_equal ["pending", "high", @pat.id], [ticket["status"], ticket["priority"], ticket["assignee_id"]]
+    assert_equal 2, Comment.count
+  end
+
+  test "an invalid or null priority is refused, and the rest of the update is not saved" do
+    id = open_request(token: @avery_token)
+
+    [{priority: "urgent"}, {priority: nil}, {priority: 1}, {priority: {value: "high"}}, {priority: ["high"]}].each do |bad|
+      staff_update(id, {comment: {body: "Hi"}, status: "solved"}.merge(bad))
+      assert_response :unprocessable_entity, "expected 422 for #{bad.inspect}"
+      assert_equal "validation_failed", json.dig("error", "code")
+      assert json.dig("error", "details", "priority").present?, "expected a priority error for #{bad.inspect}"
+    end
+
+    assert_equal "normal", Ticket.find(id).priority
+    assert_equal "open", Ticket.find(id).status
+    assert_equal 1, Comment.count
+  end
+
+  test "priority is internal: the customer's request never shows it" do
+    id = open_request(token: @avery_token)
+    staff_update(id, {priority: "high"})
+
+    api(:get, "/api/v1/requests/#{id}", account: "acme", token: @avery_token)
+    refute json["request"].key?("priority")
+    refute_includes response.body, "priority"
+
+    api(:get, "/api/v1/requests", account: "acme", token: @avery_token)
+    refute_includes response.body, "priority"
+
+    api(:patch, "/api/v1/requests/#{id}", body: {request: {comment: {body: "Still broken"}}}, account: "acme", token: @avery_token)
+    refute_includes response.body, "priority"
+  end
+
+  test "customers cannot change priority" do
+    id = open_request(token: @avery_token)
+
+    api(:patch, "/api/v1/requests/#{id}", body: {request: {priority: "high"}}, account: "acme", token: @avery_token)
+
+    assert_response :unprocessable_entity
+    assert_equal "normal", Ticket.find(id).priority
+  end
+
+  test "a priority change does not move the request in the customer's list" do
+    older = open_request(token: @avery_token, subject: "Older")
+    newer = open_request(token: @avery_token, subject: "Newer")
+    api(:get, "/api/v1/requests", account: "acme", token: @avery_token)
+    before = json["requests"]
+
+    travel 5.minutes do
+      staff_update(older, {priority: "high"})
+    end
+
+    api(:get, "/api/v1/requests", account: "acme", token: @avery_token)
+    assert_equal before, json["requests"]
+    assert_equal [newer, older], json["requests"].pluck("id")
+  end
+
+  test "filters by status" do
+    build_inbox
+
+    assert_tickets [@refund, @receipt], status: "open"
+    assert_tickets [@login], status: "pending"
+    assert_tickets [@invoice], status: "solved"
+  end
+
+  test "filters by priority" do
+    build_inbox
+
+    assert_tickets [@login, @refund], priority: "high"
+    assert_tickets [@receipt, @invoice], priority: "normal"
+  end
+
+  test "filters by requester" do
+    build_inbox
+
+    assert_tickets [@refund, @invoice], requester_id: @sam.id
+    assert_tickets [@receipt, @login], requester_id: @avery.id
+  end
+
+  test "filters by assignee, and unassigned means nobody is assigned" do
+    build_inbox
+
+    assert_tickets [@login], assignee_id: @pat.id
+    assert_tickets [@receipt, @refund, @invoice], assignee_id: "unassigned"
+  end
+
+  test "filters combine with AND" do
+    build_inbox
+
+    assert_tickets [@refund], status: "open", priority: "high"
+    assert_tickets [@refund], assignee_id: "unassigned", priority: "high"
+    assert_tickets [@login], assignee_id: @pat.id, status: "pending"
+    assert_tickets [], assignee_id: @pat.id, requester_id: @sam.id
+  end
+
+  test "the combined example returns only open, unassigned, high-priority tickets matching the search" do
+    build_inbox
+
+    # "receipt" is in the refund's public comment, so only the refund is open, unassigned, high, and matching.
+    # The receipt ticket is normal priority, and the invoice matches only in a private note.
+    assert_tickets [@refund], status: "open", assignee_id: "unassigned", priority: "high", q: "receipt"
+  end
+
+  test "q searches subjects and public comments, ignoring case" do
+    build_inbox
+
+    assert_tickets [@refund, @receipt], q: "receipt"
+    assert_tickets [@refund, @receipt], q: "RECEIPT"
+    assert_tickets [@receipt], q: "download"
+    assert_tickets [@login], q: "SPINS"
+    assert_tickets [@refund], q: "refund FOR 50%"
+  end
+
+  test "q never matches private notes" do
+    build_inbox
+
+    assert_tickets [], q: "looks fake"
+    assert_tickets [], q: "fake"
+  end
+
+  test "a ticket matching in several places is listed once and counted once" do
+    build_inbox
+    Ticket.find(@receipt).comments.create!(author: @avery, body: "Still no receipt here.", public: true)
+
+    body = staff_list(q: "receipt")
+
+    assert_equal [@refund, @receipt].sort, body["tickets"].pluck("id").sort
+    assert_equal 2, body["count"]
+  end
+
+  test "q treats % and _ and backslash as literal characters" do
+    build_inbox
+    Ticket.find(@login).update!(subject: "Login loop C:\\temp")
+    wildcard_bait = open_request(token: @sam_token, subject: "Receipt-id mismatch", body: "Nothing else here.")
+
+    assert_tickets [@refund], q: "50%"
+    assert_tickets [@refund], q: "%"
+    assert_tickets [@refund], q: "_"
+    assert_tickets [@refund], q: "receipt_id"
+    assert_tickets [@refund], q: "receipt_"
+    assert_tickets [@login], q: "\\"
+    assert_tickets [@login], q: "C:\\temp"
+    assert_tickets [], q: "a%b"
+    assert_tickets [wildcard_bait], q: "receipt-id"
+    assert_tickets [], q: "receipt_id mismatch"
+    assert_tickets [wildcard_bait], q: "Receipt-id mismatch"
+  end
+
+  test "q treats regular expression and SQL syntax as literal text" do
+    build_inbox
+
+    assert_tickets [], q: "(receipt"
+    assert_tickets [], q: ".*"
+    assert_tickets [], q: "[a-z]+"
+    assert_tickets [], q: "x' OR '1'='1"
+    assert_tickets [], q: "'; DROP TABLE tickets; --"
+    assert_equal 4, staff_list.fetch("count"), "the inbox must be intact"
+  end
+
+  test "a blank q or filter is ignored" do
+    build_inbox
+
+    assert_equal 4, staff_list(q: "").fetch("count")
+    assert_equal 4, staff_list(q: "   ").fetch("count")
+    assert_equal 4, staff_list(status: "", priority: "", assignee_id: "", requester_id: "").fetch("count")
+  end
+
+  test "pagination counts the filtered list" do
+    build_inbox
+
+    body = staff_list(priority: "high", per_page: 1)
+    assert_equal 2, body["count"]
+    assert_equal 2, body["next_page"]
+    assert_equal [@login], body["tickets"].pluck("id")
+
+    body = staff_list(priority: "high", per_page: 1, page: 2)
+    assert_equal [@refund], body["tickets"].pluck("id")
+    assert_nil body["next_page"]
+  end
+
+  test "filtered lists stay most recently active first" do
+    build_inbox
+    travel 1.minute do
+      Ticket.find(@refund).comments.create!(author: @owner, body: "Receipt sent.", public: true)
+    end
+
+    api(:get, "/api/v1/tickets?q=receipt", account: "acme", token: @owner_token)
+    assert_equal [@refund, @receipt], json["tickets"].pluck("id")
+  end
+
+  test "malformed filters are refused with 422" do
+    {
+      "status=archived" => "status",
+      "priority=urgent" => "priority",
+      "priority=HIGH" => "priority",
+      "assignee_id=abc" => "assignee_id",
+      "assignee_id=0" => "assignee_id",
+      "assignee_id=-1" => "assignee_id",
+      "assignee_id=1.5" => "assignee_id",
+      "assignee_id=Unassigned" => "assignee_id",
+      "assignee_id=99999999999999999999999" => "assignee_id",
+      "requester_id=unassigned" => "requester_id",
+      "requester_id=0" => "requester_id",
+      "requester_id=1.5" => "requester_id",
+      "status[]=open" => "status",
+      "priority[high]=1" => "priority",
+      "assignee_id[]=1" => "assignee_id",
+      "requester_id[]=1" => "requester_id",
+      "q[]=receipt" => "q",
+      "q[a]=receipt" => "q",
+      "q=%00" => "q",
+      "q=receipt%00" => "q"
+    }.each do |query, field|
+      api(:get, "/api/v1/tickets?#{query}", account: "acme", token: @owner_token)
+      assert_response :unprocessable_entity, "expected 422 for #{query}"
+      assert_equal "validation_failed", json.dig("error", "code"), query
+      assert json.dig("error", "details", field).present?, "expected #{field} detail for #{query}"
+    end
+  end
+
+  test "agents can use the staff filters too" do
+    build_inbox
+
+    api(:get, "/api/v1/tickets?status=open&assignee_id=unassigned&priority=high&q=receipt", account: "acme", token: @pat_token)
+
+    assert_response :ok
+    assert_equal [@refund], json["tickets"].pluck("id")
+  end
+
+  test "filters never reach another business's tickets" do
+    build_inbox
+    verified_owner(subdomain: "globex", email: "jo@globex.test")
+    globex_owner = sign_in(email: "jo@globex.test", account: "globex")
+    verified_customer(account: "globex", email: "kim@globex.test")
+    globex_kim = customer_token(account: "globex", email: "kim@globex.test")
+    open_request(token: globex_kim, subject: "Receipt from Globex", body: "Receipt again", account: "globex")
+
+    api(:get, "/api/v1/tickets?q=receipt", account: "globex", token: globex_owner)
+    assert_equal ["Receipt from Globex"], json["tickets"].pluck("subject")
+
+    api(:get, "/api/v1/tickets?q=receipt&priority=normal", account: "acme", token: @owner_token)
+    assert_equal [@receipt], json["tickets"].pluck("id")
+    refute_includes json["tickets"].pluck("subject"), "Receipt from Globex"
+
+    api(:get, "/api/v1/tickets?requester_id=#{@avery.id}", account: "globex", token: globex_owner)
+    assert_equal [], json["tickets"]
+  end
+
+  test "customers cannot use the staff list" do
+    api(:get, "/api/v1/tickets?q=receipt", account: "acme", token: @avery_token)
+    assert_response :forbidden
+  end
+
+  test "customers filter their own requests by status" do
+    build_inbox
+    staff_update(@receipt, {status: "solved"})
+
+    assert_customer_requests [@receipt], status: "solved"
+    assert_customer_requests [@login], status: "pending"
+    assert_customer_requests [], status: "open"
+    assert_customer_requests [@receipt, @login]
+  end
+
+  test "a customer's status filter refuses unknown statuses" do
+    api(:get, "/api/v1/requests?status=archived", account: "acme", token: @avery_token)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "details", "status").present?
+  end
+
+  test "customer filters cannot reveal assignment, priority, or other people's requests" do
+    build_inbox
+
+    # Only status is a customer filter. Staff-only filters are ignored, so they neither narrow the list
+    # nor show whether a request is assigned, high priority, or matches a search.
+    assert_customer_requests [@receipt, @login], assignee_id: @pat.id
+    assert_customer_requests [@receipt, @login], priority: "high"
+    assert_customer_requests [@receipt, @login], requester_id: @sam.id
+    assert_customer_requests [@receipt, @login], q: "receipt"
+  end
+end
diff --git a/test/integration/ticket_groups_test.rb b/test/integration/ticket_groups_test.rb
