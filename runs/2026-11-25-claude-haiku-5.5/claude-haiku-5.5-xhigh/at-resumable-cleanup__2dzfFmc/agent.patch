diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..53bd062
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  Interrupted = Class.new(StandardError)
+
+  # Stands in for a deploy killing the worker at a chosen point of one leaf's cleanup:
+  #   :before_title      - before the leaf's title is written
+  #   :before_checkpoint - after the title is written, before the progress cursor is
+  class << self
+    attr_accessor :kill_stage, :kill_leaf_id
+
+    def kill_if(stage, leaf_id)
+      raise Interrupted, "killed #{stage} of leaf #{leaf_id}" if kill_stage == stage && kill_leaf_id == leaf_id
+    end
+  end
+
+  module KillableLeaf
+    def update!(...)
+      TitleCleanupJobTest.kill_if(:before_title, id)
+      super
+    end
+  end
+  Leaf.prepend KillableLeaf
+
+  module KillableCheckpoint
+    def update!(attributes)
+      TitleCleanupJobTest.kill_if(:before_checkpoint, attributes[:cursor])
+      super
+    end
+  end
+  JobProgress.prepend KillableCheckpoint
+
+  setup do
+    # The legacy exporter wrapped every title in quotes. The second title also
+    # legitimately opens with a quoted phrase, so its inner quotes must survive.
+    @leaves = Leaf.order(:id).to_a
+    @leaves.each_with_index { |leaf, i| leaf.update_column(:title, %("Chapter #{i + 1}")) }
+    @leaves[1].update_column(:title, %("\"Quoted\" phrase in the title"))
+    @exported = titles
+
+    @cleaned = [ "Chapter 1", %("Quoted" phrase in the title), "Chapter 3", "Chapter 4" ]
+  end
+
+  teardown do
+    TitleCleanupJobTest.kill_stage = nil
+    TitleCleanupJobTest.kill_leaf_id = nil
+  end
+
+  test "cleans the exporter's wrapping quotes from every title and keeps inner quotes" do
+    TitleCleanupJob.perform_now
+
+    assert_equal @cleaned, titles
+  end
+
+  test "after an interruption, resuming cleans each title exactly once" do
+    interrupt_job_at @leaves[2], :before_title
+    assert_equal [ @cleaned[0], @cleaned[1], @exported[2], @exported[3] ], titles,
+      "leaves before the interrupted one are cleaned; the interrupted one is left untouched"
+
+    TitleCleanupJob.perform_now
+
+    assert_equal @cleaned, titles
+  end
+
+  test "survives repeated interruptions" do
+    interrupt_job_at @leaves[1], :before_title
+    interrupt_job_at @leaves[3], :before_title
+
+    TitleCleanupJob.perform_now
+
+    assert_equal @cleaned, titles
+  end
+
+  test "a title is only cleaned together with its progress checkpoint" do
+    interrupt_job_at @leaves[1], :before_checkpoint
+    assert_equal [ "Chapter 1", @exported[1], %("Chapter 3"), %("Chapter 4") ], titles,
+      "the title written just before the checkpoint must roll back with it"
+
+    TitleCleanupJob.perform_now
+
+    assert_equal @cleaned, titles
+  end
+
+  test "a batch that still holds an already-committed leaf does not clean it again" do
+    interrupt_job_at @leaves[2], :before_title
+    batch = Leaf.order(:id).to_a # titles as they stand now: the first two are already cleaned
+
+    with_loaded_batch(batch) { TitleCleanupJob.perform_now }
+
+    assert_equal @cleaned, titles
+  end
+
+  test "a leaf added after a completed run is not touched by a later run" do
+    TitleCleanupJob.perform_now
+    added = books(:handbook).press(Page.new(body: "Added later"), title: %("\"Quoted\" added later"))
+
+    TitleCleanupJob.perform_now
+
+    assert_equal %("\"Quoted\" added later"), added.reload.title
+  end
+
+  private
+    def titles
+      @leaves.map { |leaf| leaf.reload.title }
+    end
+
+    # Makes the job walk `records` as its batch, as a run that loaded its batch
+    # before another run committed some of those leaves would.
+    def with_loaded_batch(records)
+      batch = Struct.new(:records) { def find_each(&block) = records.each(&block) }.new(records)
+      Leaf.define_singleton_method(:where) { |*| batch }
+      yield
+    ensure
+      Leaf.singleton_class.remove_method(:where)
+    end
+
+    def interrupt_job_at(leaf, stage)
+      TitleCleanupJobTest.kill_leaf_id = leaf.id
+      TitleCleanupJobTest.kill_stage = stage
+      assert_raises(Interrupted) { TitleCleanupJob.perform_now }
+    ensure
+      TitleCleanupJobTest.kill_stage = nil
+      TitleCleanupJobTest.kill_leaf_id = nil
+    end
+end
