+/* Japanese copy sits under the English on the static error pages. */
+[lang="ja"] {
+  font-family: "Hiragino Sans", "Yu Gothic", "Noto Sans JP", system-ui, sans-serif;
+}
+
+.error-page__stamp [lang="ja"] {
+  font-size: 0.6em;
+  opacity: 0.8;
+}
diff --git a/test/i18n/translation_completeness_test.rb b/test/i18n/translation_completeness_test.rb
new file mode 100644
index 0000000..9cc9890
--- /dev/null
+++ b/test/i18n/translation_completeness_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class TranslationCompletenessTest < ActiveSupport::TestCase
+  test "every English app string has a Japanese translation" do
+    en = flatten(I18n.backend.send(:translations)[:en])
+    ja = flatten(I18n.backend.send(:translations)[:ja])
+
+    missing = en.keys.select { |key| key.start_with?(*translated_roots) } - ja.keys
+    assert_empty missing, "Missing Japanese translations: #{missing.first(20).join(", ")}"
+  end
+
+  test "Japanese translations are never blank" do
+    ja = flatten(I18n.backend.send(:translations)[:ja])
+    assert_empty ja.select { |key, value| key.start_with?(*translated_roots) && value.blank? }.keys
+  end
+
+  private
+    def translated_roots
+      %w[ app bar boards cards columns events js mailers notification sessions users account ]
+    end
+
+    def flatten(hash, prefix = nil)
+      hash.each_with_object({}) do |(key, value), result|
+        path = [ prefix, key ].compact.join(".")
+        if value.is_a?(Hash) && !(value.keys & %w[one other]).any?
+          result.merge!(flatten(value, path))
+        else
+          result[path] = value
+        end
+      end
+    end
+end
diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..8bbfe70
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "?locale=ja switches the page and the choice sticks for the session" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_select "html[lang=ja]"
+
+      get new_session_path
+      assert_select "html[lang=ja]"
+    end
+  end
+
+  test "an unknown locale is ignored and never breaks the page" do
+    untenanted do
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_select "html[lang=en]"
+
+      get new_session_path(locale: [ "ja" ])
+      assert_response :success
+      assert_select "html[lang=en]"
+    end
+  end
+
+  test "people who never chose a locale keep English" do
+    untenanted do
+      get new_session_path
+      assert_select "html[lang=en]"
+    end
+  end
+
+  test "a chosen locale is remembered on the identity for the next sign-in from a clean browser" do
+    identity = identities(:david)
+    sign_in_as identity
+
+    untenanted { get new_session_path(locale: "ja") }
+    assert_equal "ja", identity.reload.locale
+
+    integration_session.reset!
+    sign_in_as identity
+    get root_path
+    assert_select "html[lang=ja]"
+  end
+
+  test "magic link email is written in the recipient's language" do
+    identity = identities(:david)
+    identity.update!(locale: "ja")
+
+    email = MagicLinkMailer.sign_in_instructions(identity.send_magic_link)
+    assert_match "Fizzy", email.subject
+    assert_match "Fizzy の確認コード", email.subject
+  end
+end
