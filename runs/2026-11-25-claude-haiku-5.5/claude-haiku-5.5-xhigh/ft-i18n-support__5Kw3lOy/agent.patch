diff --git a/app/javascript/helpers/i18n.js b/app/javascript/helpers/i18n.js
new file mode 100644
index 0000000..3e04fea
--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,16 @@
+// Translations for the current locale, embedded by layouts/shared/_head.html.erb
+const translations = JSON.parse(document.getElementById("js-translations")?.textContent ?? "{}")
+
+// Looks up a key such as "time.ago" and fills in %{name} placeholders. Plural
+// entries ({ one:, other: }) are chosen by values.count.
+export function translate(key, values = {}) {
+  const value = key.split(".").reduce((node, part) => node?.[part], translations)
+  const template = (value && typeof value === "object") ? value[values.count === 1 ? "one" : "other"] : value
+
+  return (template ?? key).replace(/%\{(\w+)\}/g, (_, name) => values[name] ?? "")
+}
+
+// Intl locale matching the page language, used when formatting dates in the browser.
+export function intlLocale() {
+  return document.documentElement.lang === "ja" ? "ja-JP" : "en-US"
+}
