@@ -0,0 +1,33 @@
+require "test_helper"
+
+class SearchHelperTest < ActionView::TestCase
+  test "marks matched words without changing their case, and escapes everything else" do
+    search = Search.new(users(:david), "cat dog")
+
+    assert_equal "&lt;b&gt;<mark>Cat</mark>&lt;/b&gt; &amp; <mark>dog</mark>", highlight_search_matches("<b>Cat</b> & dog", search)
+  end
+
+  test "prefers the longest term when terms overlap" do
+    search = Search.new(users(:david), "foo foobar")
+
+    assert_equal "<mark>foobar</mark> and <mark>foo</mark>", highlight_search_matches("foobar and foo", search)
+  end
+
+  test "excerpts show the text around the first match, with ellipses where text was cut" do
+    search = Search.new(users(:david), "needle")
+    text = "#{"lorem " * 30}needle #{"ipsum " * 30}"
+
+    excerpt = search_excerpt(text, search)
+
+    assert excerpt.start_with?("…")
+    assert excerpt.end_with?("…")
+    assert_includes excerpt, "<mark>needle</mark>"
+    assert excerpt.length < text.length
+  end
+
+  test "short excerpts are shown whole without ellipses" do
+    search = Search.new(users(:david), "needle")
+
+    assert_equal "Find the <mark>needle</mark> here", search_excerpt("Find   the needle\nhere", search)
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..bda072b
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,177 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @david = users(:david)
+    @kevin = users(:kevin)
+  end
+
+  test "a blank query has no terms and returns nothing" do
+    search = Search.new(@david, "   ")
+
+    assert_not search.any?
+    assert_empty search.page(1).records
+    assert_not search.page(1).before_last?
+  end
+
+  test "finds cards by title, ignoring case" do
+    cards = results_for(@david, "LOGO").map(&:card)
+
+    assert_equal [ cards(:logo) ], cards
+  end
+
+  test "finds cards by description" do
+    cards(:buy_domain).update!(description: "Remember to renew the registration")
+
+    assert_equal [ cards(:buy_domain) ], results_for(@david, "registration").map(&:card)
+  end
+
+  test "finds cards by the body of any comment on them" do
+    cards(:logo).comments.create!(body: "Ask the printer about haggis", creator: @david)
+
+    assert_equal [ cards(:logo) ], results_for(@david, "haggis").map(&:card)
+  end
+
+  test "matches the visible text of rich text, not its markup" do
+    cards(:buy_domain).update!(description: "<p class=\"highlighted\"><strong>Plain</strong> words</p>")
+
+    assert_empty results_for(@david, "highlighted")
+    assert_empty results_for(@david, "strong")
+    assert_equal [ cards(:buy_domain) ], results_for(@david, "plain").map(&:card)
+  end
+
+  test "treats terms containing HTML special characters as literal text" do
+    cards(:buy_domain).comments.create!(body: "Use &lt;b&gt;bold&lt;/b&gt; &amp; keep it short", creator: @david)
+
+    assert_equal [ cards(:buy_domain) ], results_for(@david, "<b>bold").map(&:card)
+    assert_equal [ cards(:buy_domain) ], results_for(@david, "&").map(&:card)
+  end
+
+  test "treats LIKE wildcards as literal characters" do
+    cards(:buy_domain).update!(title: "Save 100% of costs")
+    cards(:shipping).update!(title: "snake_case naming")
+
+    assert_equal [ cards(:buy_domain) ], results_for(@david, "%").map(&:card)
+    assert_equal [ cards(:shipping) ], results_for(@david, "_").map(&:card)
+  end
+
+  test "matches non-ASCII text regardless of case" do
+    cards(:buy_domain).update!(title: "Café menu")
+
+    assert_equal [ cards(:buy_domain) ], results_for(@david, "CAFÉ").map(&:card)
+    assert_equal [ cards(:buy_domain) ], results_for(@david, "café").map(&:card)
+    assert_empty results_for(@david, "cafe")
+  end
+
+  test "every term must appear somewhere on the card" do
+    cards(:logo).comments.create!(body: "Haggis again", creator: @david)
+
+    assert_equal [ cards(:logo) ], results_for(@david, "logo haggis").map(&:card)
+    assert_empty results_for(@david, "logo unicorn")
+  end
+
+  test "a term can be matched in different fields of the same card" do
+    cards(:logo).comments.create!(body: "Make it bigger", creator: @david)
+
+    assert_equal [ cards(:logo) ], results_for(@david, "isn't bigger").map(&:card)
+  end
+
+  test "never returns draft cards" do
+    Card.create!(board: boards(:writebook), creator: @david, title: "Hidden draft plans", status: "drafted")
+
+    assert_empty results_for(@david, "hidden")
+  end
+
+  test "never returns comments on draft cards" do
+    cards(:logo).comments.create!(body: "Secret haggis recipe", creator: @david)
+    cards(:logo).update_column(:status, "drafted")
+
+    assert_empty results_for(@david, "haggis")
+  end
+
+  test "only returns cards on boards the user currently has access to" do
+    secret = Card.create!(board: boards(:private), creator: @kevin, title: "Confidential roadmap", status: "published")
+
+    assert_empty results_for(@david, "confidential")
+    assert_equal [ secret ], results_for(@kevin, "confidential").map(&:card)
+  end
+
+  test "stops returning cards once access to their board is revoked" do
+    assert_equal [ cards(:logo) ], results_for(@kevin, "logo").map(&:card)
+
+    accesses(:writebook_kevin).destroy!
+
+    assert_empty results_for(@kevin, "logo")
+  end
+
+  test "returns the newest cards first" do
+    older = Card.create!(board: boards(:writebook), creator: @david, title: "Logo older", status: "published", created_at: 2.days.ago)
+    newer = Card.create!(board: boards(:writebook), creator: @david, title: "Logo newer", status: "published", created_at: 1.hour.ago)
+
+    assert_equal [ newer, older, cards(:logo) ], results_for(@david, "logo").map(&:card)
+  end
+
+  test "excerpts show the matching description and the newest matching comment" do
+    cards(:logo).update!(description: "The logo should be bigger")
+    cards(:logo).comments.create!(body: "Logo is fine now", creator: @david, created_at: 1.minute.ago)
+    cards(:logo).comments.create!(body: "Logo is still small", creator: @david, created_at: 1.second.ago)
+
+    result = results_for(@david, "logo").first
+
+    assert_equal [ "The logo should be bigger", "Logo is still small" ], result.excerpts.map { |excerpt| excerpt.squish }
+  end
+
+  test "pages through results of any length" do
+    25.times { |index| Card.create!(board: boards(:writebook), creator: @david, title: "Paging #{index}", status: "published") }
+
+    search = Search.new(@david, "paging")
+    first_page = search.page(1)
+    second_page = search.page(2)
+
+    assert_equal Search::PER_PAGE, first_page.records.size
+    assert first_page.before_last?
+    assert_equal 25 - Search::PER_PAGE, second_page.records.size
+    assert_not second_page.before_last?
+    assert_equal 25, (first_page.records + second_page.records).map(&:card).uniq.size
+  end
+
+  test "finds matches across candidate batches, skipping cards that only match in markup" do
+    with_batch_size(2) do
+      matches = 5.times.map do |index|
+        Card.create!(board: boards(:writebook), creator: @david, title: "Batch #{index}", status: "published", created_at: index.hours.ago)
+      end
+
+      # Only their markup contains the term, so they reach the database query but must be rejected.
+      3.times do |index|
+        Card.create!(board: boards(:writebook), creator: @david, title: "Unrelated #{index}", status: "published",
+          description: "<p class=\"batch\">Nothing to see</p>", created_at: (index + 1).minutes.ago)
+      end
+
+      assert_equal matches, results_for(@david, "batch").map(&:card)
+    end
+  end
+
+  test "a page past the end is empty" do
+    page = Search.new(@david, "logo").page(3)
+
+    assert_empty page.records
+    assert_not page.before_last?
+  end
+
+  private
+    def results_for(user, query)
+      Search.new(user, query).page(1).records
+    end
+
+    def with_batch_size(size)
+      original = Search::BATCH_SIZE
+      Search.send(:remove_const, :BATCH_SIZE)
+      Search.const_set(:BATCH_SIZE, size)
+      yield
+    ensure
+      Search.send(:remove_const, :BATCH_SIZE)
+      Search.const_set(:BATCH_SIZE, original)
+    end
+end
