--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,21 @@
+module SearchHelper
+  EXCERPT_CONTEXT = 60
+
+  def highlight_search_matches(text, search)
+    safe_join text.to_s.split(search.matcher).each_with_index.map { |piece, index| index.odd? ? tag.mark(piece) : piece }
+  end
+
+  def search_excerpt(text, search)
+    text = text.squish
+    match = search.matcher.match(text)
+
+    start = [ match.begin(0) - EXCERPT_CONTEXT, 0 ].max
+    finish = [ match.end(0) + EXCERPT_CONTEXT, text.length ].min
+    excerpt = text[start...finish]
+
+    excerpt = "…#{excerpt}" if start > 0
+    excerpt = "#{excerpt}…" if finish < text.length
+
+    highlight_search_matches(excerpt, search)
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..bc72778
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,128 @@
+class Search
+  PER_PAGE = 20
+  BATCH_SIZE = 100
+  MAX_TERMS = 10
+  LIKE_ESCAPE = "!"
+
+  Result = Data.define(:card, :excerpts)
+
+  # Same contract as GearedPagination pages, so the shared pagination helpers can render it.
+  Page = Data.define(:number, :records, :more) do
+    def before_last?
+      more
+    end
+  end
+
+  attr_reader :user, :query
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.squish
+  end
+
+  def any?
+    terms.any?
+  end
+
+  def terms
+    @terms ||= query.split.uniq(&:downcase).first(MAX_TERMS)
+  end
+
+  # Capturing group so String#split keeps the matched text. Longer terms go first so "foobar" wins over "foo".
+  def matcher
+    @matcher ||= /(#{Regexp.union(terms.sort_by { |term| -term.length }).source})/i
+  end
+
+  def page(number)
+    number = [ number.to_i, 1 ].max
+    results = matching_results.lazy.drop((number - 1) * PER_PAGE).first(PER_PAGE + 1)
+
+    Page.new(number: number, records: results.first(PER_PAGE), more: results.size > PER_PAGE)
+  end
+
+  private
+    def matching_results
+      Enumerator.new do |yielder|
+        offset = 0
+
+        loop do
+          cards = candidate_cards.offset(offset).limit(BATCH_SIZE).to_a
+          break if cards.empty?
+
+          comments = matching_comments_by_card(cards)
+          cards.filter_map { |card| result_for(card, comments.fetch(card.id, [])) }.each { |result| yielder << result }
+
+          offset += BATCH_SIZE
+        end
+      end
+    end
+
+    # SQL narrows down to published cards on boards the user can access, and each term must hit
+    # the title, the description, or some comment. LIKE also matches markup, so every candidate is
+    # checked against its plain text in result_for.
+    def candidate_cards
+      return Card.none unless any?
+
+      matching = terms.inject(user.accessible_cards.published) { |cards, term| cards.where(id: cards_containing(term)) }
+      matching.reverse_chronologically.with_rich_text_description.includes(:board)
+    end
+
+    def cards_containing(term)
+      Card.where(Card.arel_table[:title].matches_any(like_patterns(term), LIKE_ESCAPE))
+        .or(Card.where(id: descriptions_containing(term).select(:record_id)))
+        .or(Card.where(id: comments_containing(term).select(:card_id)))
+    end
+
+    def descriptions_containing(term)
+      ActionText::RichText.where(record_type: "Card", name: "description").where(body_containing(term))
+    end
+
+    def comments_containing(term)
+      Comment.joins(:rich_text_body).where(body_containing(term))
+    end
+
+    def body_containing(term)
+      ActionText::RichText.arel_table[:body].matches_any(like_patterns(term), LIKE_ESCAPE)
+    end
+
+    # Rich text is stored HTML-escaped, so a term like "<" appears as "&lt;" in the stored body.
+    # SQLite's LIKE only folds ASCII case, so non-ASCII characters become "_" wildcards here; the
+    # Ruby check in result_for still decides the match exactly.
+    def like_patterns(term)
+      [ term, CGI.escapeHTML(term) ].uniq.map do |text|
+        "%#{ActiveRecord::Base.sanitize_sql_like(text, LIKE_ESCAPE).gsub(/[^\x00-\x7F]/, "_")}%"
+      end
+    end
+
+    def matching_comments_by_card(cards)
+      Comment.joins(:rich_text_body)
+        .where(card: cards)
+        .where(terms.map { |term| body_containing(term) }.reduce(:or))
+        .preload(:rich_text_body)
+        .order(created_at: :desc, id: :desc)
+        .group_by(&:card_id)
+    end
+
+    def result_for(card, comments)
+      description = card.description.to_plain_text
+      bodies = comments.map { |comment| comment.body.to_plain_text }
+
+      if every_term_found_in?([ card.title.to_s, description, *bodies ])
+        Result.new(card: card, excerpts: excerpts_for(description, bodies))
+      end
+    end
+
+    def every_term_found_in?(texts)
+      term_patterns.all? { |pattern| texts.any? { |text| pattern.match?(text) } }
+    end
+
+    def term_patterns
+      @term_patterns ||= terms.map { |term| /#{Regexp.escape(term)}/i }
+    end
+
+    def excerpts_for(description, bodies)
+      newest_matching_body = bodies.find { |body| matcher.match?(body) }
+
+      [ description, newest_matching_body ].compact.select { |text| matcher.match?(text) }
+    end
+end
