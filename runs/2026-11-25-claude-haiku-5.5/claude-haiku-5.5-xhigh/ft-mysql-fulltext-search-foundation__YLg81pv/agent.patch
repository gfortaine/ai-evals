@@ -0,0 +1,61 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    Current.session = sessions(:david)
+    sign_in_as :david
+  end
+
+  test "lists matching cards with the matched words marked" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "a.search-result[href=?]", card_path(cards(:logo))
+    assert_select "mark", text: "logo"
+  end
+
+  test "shows only the search form for a blank query" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action=?]", search_path
+    assert_select "a.search-result", count: 0
+  end
+
+  test "escapes the content of cards and comments" do
+    Card.create!(board: boards(:writebook), creator: users(:david), title: "Logo <img src=x onerror=alert(1)>", status: "published")
+
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_no_match "<img src=x", response.body
+    assert_includes response.body, "&lt;img src=x onerror=alert(1)&gt;"
+  end
+
+  test "does not show cards from boards the user has no access to" do
+    Card.create!(board: boards(:private), creator: users(:kevin), title: "Confidential roadmap", status: "published")
+
+    get search_path(q: "confidential")
+
+    assert_response :success
+    assert_no_match "Confidential roadmap", response.body
+  end
+
+  test "links to the next page when there are more results" do
+    21.times { |index| Card.create!(board: boards(:writebook), creator: users(:david), title: "Paging #{index}", status: "published") }
+
+    get search_path(q: "paging")
+
+    assert_response :success
+    assert_select "a.search-result", count: Search::PER_PAGE
+    assert_select "#search_results-pagination-link-2"
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    get search_path(q: "logo")
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+end
diff --git a/test/helpers/search_helper_test.rb b/test/helpers/search_helper_test.rb
