diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..5af1a9d 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,46 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    before_update :start_sitting
+    after_create { sittings[id] = sitting(unpublished: true) }
+    after_commit :announce_launch
+    after_rollback :end_sitting_if_rolled_back
   end
 
   private
-    def announce_publication
-      AnnouncePublicationJob.perform_later self
+    # A sitting is everything saved in one transaction. It launches the book when
+    # the book is unpublished as the sitting starts and published as it commits.
+    #
+    # The sitting is kept per book id rather than on this object: Rails runs commit
+    # callbacks on only one in-memory copy of a book per transaction, and a sitting
+    # can save or touch several copies of the same book.
+    def sittings
+      ActiveSupport::IsolatedExecutionState[:book_sittings] ||= {}
+    end
+
+    # Read from the database, since in-memory state can be stale after a rollback.
+    def start_sitting
+      sittings[id] ||= sitting(unpublished: !stored_published?)
+    end
+
+    def sitting(unpublished:)
+      { unpublished: unpublished, depth: self.class.connection.open_transactions }
+    end
+
+    def announce_launch
+      # nil means this sitting never saved the book (e.g. a leaf only touched it).
+      started_unpublished = sittings.delete(id)&.fetch(:unpublished)
+
+      AnnouncePublicationJob.perform_later self if started_unpublished && stored_published?
+    end
+
+    # A rolled back savepoint only ends the sittings that began inside it.
+    def end_sitting_if_rolled_back
+      started = sittings[id]
+      sittings.delete(id) if started && started[:depth] > self.class.connection.open_transactions
+    end
+
+    def stored_published?
+      self.class.where(id: id).pick(:published) == true
     end
 end
diff --git a/test/controllers/books/publications_controller_test.rb b/test/controllers/books/publications_controller_test.rb
index 8761ea8..5a7453d 100644
--- a/test/controllers/books/publications_controller_test.rb
+++ b/test/controllers/books/publications_controller_test.rb
@@ -29,4 +29,33 @@ class Books::PublicationsTest < ActionDispatch::IntegrationTest
     assert_redirected_to book_slug_url(@book)
     assert_equal "new-slug", @book.slug
   end
+
+  test "publishing and adding a page in the same sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: { book: { published: "1" }, added_pages: [ "Introduction" ] }
+    end
+
+    assert @book.reload.published?
+    assert_equal [ "Introduction" ], @book.leaves.map(&:title)
+  end
+
+  test "unpublishing does not announce" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: { book: { published: "0" } }
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "a failed sitting after publishing leaves a draft and announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: { book: { published: "1" }, added_pages: [ "Introduction" ], trashed_page_ids: [ "0" ] }
+      assert_response :not_found
+    end
+
+    assert_not @book.reload.published?
+    assert_empty @book.leaves
+  end
 end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..f9e5bbb
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,164 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+  end
+
+  test "going live announces the book once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "going live and adding a page in the same sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: "Hello"), title: "Introduction"
+      end
+    end
+  end
+
+  test "going live and saving again in the same sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! title: "Manual, Second Edition"
+      end
+    end
+  end
+
+  test "saving an already-live book does not announce it again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Manual, Second Edition"
+      @book.press Page.new(body: "Late addition"), title: "Appendix"
+    end
+  end
+
+  test "taking a live book down does not announce" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "a save that does not take the book live announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Manual, Second Edition"
+      @book.press Page.new(body: "Draft page"), title: "Draft"
+    end
+  end
+
+  test "a sitting that fails after going live leaves a draft and announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises(RuntimeError) do
+        Book.transaction do
+          @book.update! published: true
+          @book.press Page.new(body: "Hello"), title: "Introduction"
+          raise "boom"
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "going live again after a failed sitting announces once" do
+    assert_raises(RuntimeError) do
+      Book.transaction do
+        @book.update! published: true
+        raise "boom"
+      end
+    end
+
+    @book.reload
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "touching the book through another copy before going live announces once" do
+    handbook = books(:handbook)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        leaves(:welcome_page).update! title: "Welcome, reader"
+        handbook.update! published: true
+      end
+    end
+  end
+
+  test "saving the book through another copy after going live announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        Book.find(@book.id).update! title: "Manual, Second Edition"
+      end
+    end
+  end
+
+  test "a live book touched by a page edit announces nothing" do
+    handbook = books(:handbook)
+    handbook.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      leaves(:welcome_page).update! title: "Welcome, reader"
+    end
+  end
+
+  test "a live book taken down and republished in one sitting is not announced" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "creating a book that is already live announces it once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.create! title: "Live from the start", published: true
+    end
+  end
+
+  test "creating a draft announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.create! title: "Draft"
+    end
+  end
+
+  test "going live and then editing a page through another copy announces once" do
+    handbook = books(:handbook)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        handbook.update! published: true
+        leaves(:welcome_page).update! title: "Welcome, reader"
+      end
+    end
+  end
+
+  test "a rolled back savepoint inside a sitting that goes live still announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+
+        Book.transaction(requires_new: true) do
+          @book.update! title: "Abandoned rename"
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert @book.reload.published?
+  end
+end
