diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..265f9e3
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  class SittingFailed < StandardError; end
+
+  setup do
+    @book = books(:manual)
+  end
+
+  test "going live announces the book" do
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ @book ]) do
+      @book.update! published: true
+    end
+  end
+
+  test "going live and adding a page in the same sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), title: "New page"
+      end
+    end
+  end
+
+  test "going live alongside several other saves in one sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), title: "One"
+        @book.press Page.new(body: ""), title: "Two"
+        @book.update! title: "Renamed"
+      end
+    end
+  end
+
+  test "going live when the sitting saves the book through another copy last announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        Book.find(@book.id).touch
+      end
+    end
+  end
+
+  test "going live and then saving a leaf of the book through a separate copy announces once" do
+    leaf = leaves(:welcome_page)
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        books(:handbook).update! published: true
+        Leaf.find(leaf.id).update! title: "Edited in the same sitting"
+      end
+    end
+  end
+
+  test "creating a live book announces it once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.create! title: "Launch day", published: true
+    end
+  end
+
+  test "creating a draft book announces nothing" do
+    assert_enqueued_jobs 0, only: AnnouncePublicationJob do
+      Book.create! title: "Still a draft"
+    end
+  end
+
+  test "saving an already-live book again does not announce" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_enqueued_jobs 0, only: AnnouncePublicationJob do
+      @book.update! title: "Retitled"
+      @book.press Page.new(body: ""), title: "Added while live"
+    end
+  end
+
+  test "taking a live book down does not announce" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_enqueued_jobs 0, only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "a sitting that ends with the book still a draft announces nothing" do
+    assert_enqueued_jobs 0, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), title: "Page"
+        @book.update! published: false
+      end
+    end
+  end
+
+  test "a live book taken down and back up in one sitting is not announced again" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_enqueued_jobs 0, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "a sitting that fails after going live leaves a draft and no announcement" do
+    assert_enqueued_jobs 0, only: AnnouncePublicationJob do
+      assert_raises(SittingFailed) do
+        @book.transaction do
+          @book.update! published: true
+          @book.press Page.new(body: ""), title: "Page"
+          raise SittingFailed
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "a failed sitting does not leak into the next save of the same object" do
+    assert_raises(SittingFailed) do
+      @book.transaction do
+        @book.update! published: true
+        raise SittingFailed
+      end
+    end
+
+    assert_enqueued_jobs 0, only: AnnouncePublicationJob do
+      @book.update! title: "Fixed title"
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.reload.update! published: true
+    end
+  end
+
+  test "touching the book without publishing announces nothing" do
+    assert_enqueued_jobs 0, only: AnnouncePublicationJob do
+      @book.press Page.new(body: ""), title: "Draft page"
+      @book.touch
+    end
+  end
+end
