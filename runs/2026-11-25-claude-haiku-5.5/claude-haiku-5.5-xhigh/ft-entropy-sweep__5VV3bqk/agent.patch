@@ -1,13 +1,15 @@
 module Card::Entropic
   extend ActiveSupport::Concern
 
+  AUTO_POSTPONE_BATCH_SIZE = 1000
+
   included do
-    scope :due_to_be_postponed, -> do
+    scope :due_to_be_postponed, ->(now = Time.current) do
       active
         .joins(board: :account)
         .left_outer_joins(board: :entropy)
         .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", Time.now)
+        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", now)
     end
 
     scope :postponing_soon, -> do
@@ -24,9 +26,15 @@ module Card::Entropic
   end
 
   class_methods do
-    def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+    def auto_postpone_all_due(now: Time.current)
+      # Select the due IDs in a single query, rather than paging through the cards with
+      # find_each. Paging orders by primary key, which makes the database walk the primary-key
+      # index on every page. Then work through the IDs in slices, re-checking each card when it
+      # is loaded, since it may have been activated or postponed after the IDs were selected.
+      due_to_be_postponed(now).pluck(:id).each_slice(AUTO_POSTPONE_BATCH_SIZE) do |card_ids|
+        includes(board: [ :entropy, { account: :entropy } ]).where(id: card_ids).each do |card|
+          card.auto_postpone(user: card.account.system_user) if card.auto_postpone_due?(now)
+        end
       end
     end
   end
@@ -38,4 +46,8 @@ module Card::Entropic
   def entropic?
     entropy.present?
   end
+
+  def auto_postpone_due?(now = Time.current)
+    active? && last_active_at <= now - auto_postpone_period
+  end
 end
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..ee061be 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,33 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due respects a board period that is longer than the account default" do
+    # Writebook overrides the account's 30-day default with 90 days, so 45 days of inactivity is not due.
+    cards(:logo).update!(last_active_at: 45.days.ago)
+
+    Card.auto_postpone_all_due
+
+    assert_not cards(:logo).reload.postponed?
+  end
+
+  test "auto postpone all due skips cards that are closed or already postponed" do
+    cards(:logo).update!(last_active_at: 120.days.ago)
+    cards(:logo).close
+    cards(:shipping).update!(last_active_at: 120.days.ago)
+    cards(:shipping).postpone
+
+    assert_no_changes -> { Card::NotNow.count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "auto postpone all due re-checks each card before postponing it" do
+    cards(:logo).update!(last_active_at: Time.current) # no longer due
+    Card.stubs(:due_to_be_postponed).returns(Card.where(id: cards(:logo).id))
+
+    Card.auto_postpone_all_due
+
+    assert_not cards(:logo).reload.postponed?
+  end
 end
