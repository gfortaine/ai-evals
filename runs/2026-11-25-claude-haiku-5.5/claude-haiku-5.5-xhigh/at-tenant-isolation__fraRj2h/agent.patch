+++ b/test/models/tenant_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class TenantTest < ActiveSupport::TestCase
+  setup do
+    @acme = Tenant.create!(name: "Acme")
+    @globex = Tenant.create!(name: "Globex")
+
+    users(:kevin).update!(tenant: @acme)
+    users(:jason).update!(tenant: @globex)
+    books(:handbook).update!(tenant: @acme)
+    books(:manual).update!(tenant: @globex)
+  end
+
+  test "requires a name" do
+    assert_not Tenant.new.valid?
+  end
+
+  test "a tenant with members or books cannot be destroyed" do
+    assert_not @globex.destroy
+    assert Tenant.exists?(@globex.id)
+  end
+
+  test "signed-in libraries only include the user's own tenant" do
+    books(:manual).update!(published: true)
+    Access.create!(user: users(:kevin), book: books(:manual), level: :reader)
+
+    books = Book.accessable_or_published(user: users(:kevin))
+
+    assert_includes books, books(:handbook)
+    assert_not_includes books, books(:manual)
+  end
+
+  test "signed-out visitors see published books of every tenant" do
+    books(:manual).update!(published: true)
+
+    assert_includes Book.accessable_or_published(user: nil), books(:manual)
+    assert_not_includes Book.accessable_or_published(user: nil), books(:handbook)
+  end
+
+  test "administrators get no access across tenants" do
+    assert users(:jason).administrator?
+
+    assert_not books(:handbook).editable?(user: users(:jason))
+    assert_not books(:handbook).accessable?(user: users(:jason))
+    assert books(:manual).editable?(user: users(:jason))
+  end
+
+  test "update_access only grants people in the book's tenant" do
+    book = Book.create!(title: "Acme Only", tenant: @acme, everyone_access: false)
+
+    book.update_access(editors: [ users(:kevin).id, users(:jason).id ], readers: [ users(:david).id ])
+
+    assert book.editable?(user: users(:kevin))
+    assert_not book.accessable?(user: users(:jason))
+    assert_not book.accessable?(user: users(:david))
+    assert_equal [ users(:kevin).id ], book.accesses.pluck(:user_id)
+  end
+
+  test "everyone access shares a book only within its tenant" do
+    book = Book.create!(title: "Acme Everyone", tenant: @acme, everyone_access: true)
+
+    book.update_access(editors: [], readers: [])
+
+    assert_equal [ users(:kevin).id ], book.accesses.pluck(:user_id)
+  end
+
+  test "new users get everyone books from their own tenant only" do
+    acme_book = Book.create!(title: "Acme Everyone", tenant: @acme, everyone_access: true)
+    globex_book = Book.create!(title: "Globex Everyone", tenant: @globex, everyone_access: true)
+    loose_book = Book.create!(title: "Loose Everyone", everyone_access: true)
+
+    acme_user = User.create!(name: "Ann", email_address: "ann@example.com", password: "secret123456", tenant: @acme)
+
+    assert_equal [ acme_book.id, books(:handbook).id ].sort, acme_user.accesses.pluck(:book_id).sort
+  end
+
+  test "records without a tenant only match records without a tenant" do
+    loose_user = users(:jz)
+    loose_book = Book.create!(title: "Loose")
+
+    assert loose_user.same_tenant_as?(users(:david))
+    assert loose_book.same_tenant_as?(users(:jz))
+    assert_not loose_user.same_tenant_as?(users(:kevin))
+    assert_not loose_book.same_tenant_as?(books(:handbook))
+    assert_not loose_user.same_tenant_as?(nil)
+  end
