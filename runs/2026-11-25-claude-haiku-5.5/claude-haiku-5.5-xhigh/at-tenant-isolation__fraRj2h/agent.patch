index 0000000..59d101b
--- /dev/null
+++ b/test/integration/tenant_isolation_test.rb
@@ -0,0 +1,266 @@
+require "test_helper"
+
+class TenantIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme = Tenant.create!(name: "Acme")
+    @globex = Tenant.create!(name: "Globex")
+
+    users(:kevin).update!(tenant: @acme)
+    users(:jason).update!(tenant: @globex)
+    users(:david).update!(tenant: @globex)
+
+    books(:handbook).update!(tenant: @acme)
+    books(:manual).update!(tenant: @globex)
+
+    # The pilot case: a customer-A user holds an access row to a customer-B book.
+    Access.create!(user: users(:kevin), book: books(:manual), level: :reader)
+
+    @globex_leaf = books(:manual).press Page.new(body: "Globex secret"), title: "Secret page"
+    @globex_leaf.edit leafable_params: { body: "Globex edited secret" }
+
+    sign_in :kevin
+  end
+
+  test "a book of another tenant is gone from the library, even with an access row" do
+    get root_path
+
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+    assert_select "h2", text: "Manual", count: 0
+  end
+
+  test "a published book of another tenant is gone from a signed-in library" do
+    books(:manual).update!(published: true)
+
+    get root_path
+
+    assert_select "h2", text: "Manual", count: 0
+  end
+
+  test "signed-out visitors still see every published book, whatever its tenant" do
+    books(:manual).update!(published: true)
+    sign_out
+
+    get root_path
+
+    assert_select "h2", text: "Manual"
+  end
+
+  test "a published book of your own tenant is visible to signed-in members" do
+    books(:handbook).update!(published: true)
+    users(:jz).update!(tenant: @acme)
+    sign_out
+    sign_in :jz
+
+    get root_path
+    assert_select "h2", text: "Handbook"
+
+    get book_slug_path(books(:handbook))
+    assert_response :success
+  end
+
+  test "signed-out visitors can read a published book and its pages, whatever its tenant" do
+    books(:manual).update!(published: true)
+    sign_out
+
+    get book_slug_path(books(:manual))
+    assert_response :success
+
+    get leafable_slug_path(@globex_leaf)
+    assert_response :success
+  end
+
+  test "the edit form only offers people from the book's tenant" do
+    get edit_book_path(books(:handbook))
+
+    assert_select "input[name='reader_ids[]'][value='#{users(:kevin).id}']"
+    assert_select "input[name='reader_ids[]'][value='#{users(:jason).id}']", count: 0
+    assert_select "input[name='reader_ids[]'][value='#{users(:david).id}']", count: 0
+  end
+
+  test "another tenant's book answers 404 even when it has an access row" do
+    get book_slug_path(books(:manual))
+
+    assert_response :not_found
+  end
+
+  test "another tenant's published book answers 404 to a signed-in user" do
+    books(:manual).update!(published: true)
+
+    get book_slug_path(books(:manual))
+
+    assert_response :not_found
+  end
+
+  test "another tenant's book answers the same 404 as a book that never existed" do
+    refused = with_production_error_pages do
+      get book_slug_path(books(:manual))
+      [ response.status, response.body ]
+    end
+
+    missing = with_production_error_pages do
+      get "/999999/nothing-here"
+      [ response.status, response.body ]
+    end
+
+    assert_equal missing, refused
+  end
+
+  test "another tenant's pages answer 404 wherever they are asked for" do
+    get leafable_slug_path(@globex_leaf)
+    assert_response :not_found
+
+    get leafable_slug_path(@globex_leaf, format: :md)
+    assert_response :not_found
+
+    get edit_leafable_path(@globex_leaf)
+    assert_response :not_found
+  end
+
+  test "another tenant's edit history answers 404" do
+    get page_edit_path(@globex_leaf, "latest")
+    assert_response :not_found
+
+    get page_edit_path(@globex_leaf, @globex_leaf.edits.last)
+    assert_response :not_found
+  end
+
+  test "another tenant's book features answer 404" do
+    get edit_book_path(books(:manual))
+    assert_response :not_found
+
+    get book_publication_path(books(:manual))
+    assert_response :not_found
+
+    get book_bookmark_path(books(:manual))
+    assert_response :not_found
+
+    post book_search_path(books(:manual)), params: { search: "secret" }
+    assert_response :not_found
+  end
+
+  test "another tenant's book cannot be changed or added to" do
+    patch book_path(books(:manual)), params: { book: { title: "Hacked" } }
+    assert_response :not_found
+    assert_equal "Manual", books(:manual).reload.title
+
+    assert_no_difference -> { Page.count } do
+      post book_pages_path(books(:manual), format: :turbo_stream), params: { page: { body: "x" } }
+    end
+    assert_response :not_found
+  end
+
+  test "another tenant's pages cannot be updated, trashed, moved or created in" do
+    original_body = @globex_leaf.leafable.body.content
+
+    put leafable_path(@globex_leaf), params: { leaf: { title: "Hacked" }, page: { body: "Hacked" } }
+    assert_response :not_found
+
+    delete leafable_path(@globex_leaf)
+    assert_response :not_found
+
+    post book_leaves_moves_path(books(:manual)), params: { id: @globex_leaf.id, position: 1 }
+    assert_response :not_found
+
+    get new_book_page_path(books(:manual))
+    assert_response :not_found
+
+    @globex_leaf.reload
+    assert @globex_leaf.active?
+    assert_equal "Secret page", @globex_leaf.title
+    assert_equal original_body, @globex_leaf.leafable.body.content
+  end
+
+  test "another tenant's page cannot be given an upload" do
+    assert_no_difference -> { ActiveStorage::Attachment.count } do
+      post action_text_markdown_uploads_path, params: {
+        record_gid: @globex_leaf.leafable.to_signed_global_id.to_s,
+        attribute_name: "body",
+        file: fixture_file_upload("reading.webp", "image/webp")
+      }, as: :xhr
+    end
+    assert_response :not_found
+  end
+
+  test "the user stays signed in after being refused" do
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    assert cookies[:session_token].present?
+    get root_path
+    assert_response :success
+  end
+
+  test "new books land in the creator's tenant" do
+    post books_path, params: { book: { title: "Acme Book", everyone_access: false } }
+
+    assert_equal @acme, Book.last.tenant
+  end
+
+  test "the new book form only offers people from the creator's tenant" do
+    get new_book_path
+
+    assert_select "input[name='reader_ids[]'][value='#{users(:kevin).id}']"
+    assert_select "input[name='reader_ids[]'][value='#{users(:jason).id}']", count: 0
+    assert_select "input[name='reader_ids[]'][value='#{users(:david).id}']", count: 0
+  end
+
+  test "everyone access shares only within the book's tenant" do
+    post books_path, params: { book: { title: "Acme Shared", everyone_access: true } }
+    book = Book.last
+
+    assert Access.exists?(user: users(:kevin), book: book)
+    assert_not Access.exists?(user: users(:jason), book: book)
+    assert_not Access.exists?(user: users(:david), book: book)
+  end
+
+  test "editor and reader ids from another tenant are ignored" do
+    post books_path, params: { book: { title: "Acme Private", everyone_access: false },
+      "editor_ids[]": users(:jason).id, "reader_ids[]": users(:david).id }
+    book = Book.last
+
+    assert_not Access.exists?(user: users(:jason), book: book)
+    assert_not Access.exists?(user: users(:david), book: book)
+  end
+
+  test "own books and page histories keep working inside a tenant" do
+    leaves(:welcome_page).edit leafable_params: { body: "Acme edited" }
+
+    get page_edit_path(leaves(:welcome_page), leaves(:welcome_page).edits.last)
+    assert_response :success
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+  end
+
+  test "the people page still names everyone on the install" do
+    get users_path
+
+    assert_response :success
+    assert_in_body "Jason"
+    assert_in_body "David"
+  end
+
+  test "an admin cannot sign in as a user of another tenant" do
+    sign_out
+    sign_in :jason
+
+    get user_profile_path(users(:kevin))
+    assert_response :success
+    assert_select "#session_transfer_url", count: 0
+
+    get user_profile_path(users(:david))
+    assert_select "#session_transfer_url", count: 1
+  end
+
+  private
+    # Serve the static error page production uses instead of the debug page.
+    def with_production_error_pages
+      env = Rails.application.env_config
+      detailed = env["action_dispatch.show_detailed_exceptions"]
+      env["action_dispatch.show_detailed_exceptions"] = false
+      yield
+    ensure
+      env["action_dispatch.show_detailed_exceptions"] = detailed
+    end
+end
