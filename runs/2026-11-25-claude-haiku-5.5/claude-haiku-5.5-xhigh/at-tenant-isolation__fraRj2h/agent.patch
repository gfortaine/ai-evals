diff --git a/db/migrate/20261118223149_create_tenants.rb b/db/migrate/20261118223149_create_tenants.rb
new file mode 100644
index 0000000..02d96d8
--- /dev/null
+++ b/db/migrate/20261118223149_create_tenants.rb
@@ -0,0 +1,35 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    sweep_existing_records_into_one_tenant
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+    drop_table :tenants
+  end
+
+  private
+    # Running installs have no tenants yet. Put every existing user and book into
+    # a single tenant so they keep working exactly as before. Installs with no rows
+    # yet stay tenant-less, so the first records created behave as they do today.
+    def sweep_existing_records_into_one_tenant
+      existing_rows = select_value("SELECT (SELECT COUNT(*) FROM users) + (SELECT COUNT(*) FROM books)").to_i
+      return if existing_rows.zero?
+
+      name = select_value("SELECT name FROM accounts ORDER BY id LIMIT 1") || "Default"
+      now = quote(Time.current.utc.to_fs(:db))
+      tenant_id = insert("INSERT INTO tenants (name, created_at, updated_at) VALUES (#{quote(name)}, #{now}, #{now})")
+
+      execute "UPDATE users SET tenant_id = #{tenant_id}"
+      execute "UPDATE books SET tenant_id = #{tenant_id}"
+    end
+end
