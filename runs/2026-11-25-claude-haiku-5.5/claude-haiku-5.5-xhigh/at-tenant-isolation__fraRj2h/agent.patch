diff --git a/app/models/concerns/tenanted.rb b/app/models/concerns/tenanted.rb
new file mode 100644
index 0000000..4e0fcd3
--- /dev/null
+++ b/app/models/concerns/tenanted.rb
@@ -0,0 +1,14 @@
+module Tenanted
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+  end
+
+  # Records share a tenant when their tenant ids match. Records with no tenant
+  # match only each other, so an install without tenants behaves as it always has,
+  # and a record with no tenant never reaches one that belongs to a tenant.
+  def same_tenant_as?(other)
+    other.present? && tenant_id == other.tenant_id
+  end
+end
