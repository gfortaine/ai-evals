diff --git a/app/jobs/title_cleanup_job.rb b/app/jobs/title_cleanup_job.rb
index 13721ed..8053c46 100644
--- a/app/jobs/title_cleanup_job.rb
+++ b/app/jobs/title_cleanup_job.rb
@@ -1,11 +1,39 @@
 class TitleCleanupJob < ApplicationJob
+  CHECKPOINT = "title_cleanup"
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
-    end
+    # A leaf's search index entry is updated just after its commit, so a run interrupted in between
+    # leaves that entry stale. Only the last cleaned leaf can be affected, so refresh it before resuming.
+    last_cleaned_leaf&.reindex
+
+    loop { break unless clean_next_leaf }
   end
 
   private
+    # Cleaning a leaf and advancing the checkpoint past it commit together, so an interruption rolls
+    # back at most the leaf in progress and the next run resumes at that leaf. Committed leaves are
+    # never cleaned again. The checkpoint is read inside the transaction, so overlapping runs (SQLite
+    # starts transactions immediately) cannot both clean the same leaf.
+    #
+    # Returns false once there are no leaves left after the checkpoint.
+    def clean_next_leaf
+      JobCheckpoint.transaction do
+        checkpoint = JobCheckpoint.for(CHECKPOINT)
+        leaf = Leaf.where("id > ?", checkpoint.last_processed_id).order(:id).first
+
+        if leaf
+          leaf.update!(title: cleaned(leaf.title))
+          checkpoint.update!(last_processed_id: leaf.id)
+        end
+
+        leaf.present?
+      end
+    end
+
+    def last_cleaned_leaf
+      Leaf.find_by(id: JobCheckpoint.for(CHECKPOINT).last_processed_id)
+    end
+
     def cleaned(title)
       title.delete_prefix('"').delete_suffix('"')
     end
