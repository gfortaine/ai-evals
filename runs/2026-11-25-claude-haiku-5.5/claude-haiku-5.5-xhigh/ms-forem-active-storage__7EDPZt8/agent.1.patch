+require "rails_helper"
+
+RSpec.describe "Profile picture URLs" do
+  let(:user) { create(:user) }
+
+  it "serve a picture stored with Active Storage from its stable URL, without signing in" do
+    path = URI.parse(user.profile_image_url).path
+
+    get path
+
+    expect(response).to have_http_status(:redirect)
+    expect(response.location).to include("/rails/active_storage/disk/")
+  end
+
+  it "return the stored bytes when the redirect is followed" do
+    get URI.parse(user.profile_image_url).path
+    get response.location
+
+    expect(response).to have_http_status(:ok)
+    expect(response.body).to eq(user.profile_picture.download)
+  end
+
+  it "return not found for a signed id that does not match a blob" do
+    get "/rails/active_storage/blobs/redirect/not-a-real-signed-id/picture.png"
+
+    expect(response).to have_http_status(:not_found)
+  end
+end
