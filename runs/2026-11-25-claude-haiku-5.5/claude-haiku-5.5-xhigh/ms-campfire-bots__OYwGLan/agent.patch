+++ b/app/controllers/bots/reactivations_controller.rb
@@ -0,0 +1,20 @@
+# Administrators decide when a suspended bot comes back. Nobody else can reactivate one, not even its creator.
+class Bots::ReactivationsController < ApplicationController
+  before_action :ensure_administrator
+  before_action :set_bot
+
+  def create
+    @bot.reactivate!
+
+    redirect_to bots_url
+  end
+
+  private
+    def ensure_administrator
+      head :forbidden unless Current.user.administrator?
+    end
+
+    def set_bot
+      @bot = Bot.find(params[:bot_id])
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..8b97c2c
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,64 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+  before_action :ensure_can_administer, only: %i[ edit update destroy ]
+  before_action :ensure_can_add_bots, only: %i[ new create ]
+
+  def index
+    @bots = visible_bots.ordered.preload(:creator, user: :avatar_attachment)
+  end
+
+  def new
+    @bot = Bot.new
+  end
+
+  def create
+    @bot = Bot.new(bot_params)
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.user.deactivate
+
+    redirect_to bots_url
+  end
+
+  private
+    def set_bot
+      @bot = Bot.find(params[:id])
+    end
+
+    def ensure_can_administer
+      head :forbidden unless Current.user.can_administer?(@bot)
+    end
+
+    # The list says why, so a member at the limit is sent back to it.
+    def ensure_can_add_bots
+      redirect_to bots_url unless Current.user.can_add_bots?
+    end
+
+    # Administrators manage every bot; everyone else only the bots they created.
+    def visible_bots
+      Current.user.can_administer? ? Bot.all : Current.user.bots
+    end
+
+    # A file field submits nothing when no file is chosen, which must not clear the current avatar.
+    def bot_params
+      params.require(:bot).permit(:name, :avatar, :webhook_url, :add_to_all_open_rooms).reject { |key, value| key == "avatar" && value.blank? }
+    end
+end
