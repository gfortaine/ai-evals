+module BotsHelper
+  def bot_avatar_tag(bot, **options)
+    if bot.user&.persisted?
+      image_tag fresh_user_avatar_path(bot.user), **options
+    else
+      image_tag "default-avatar.svg", **options
+    end
+  end
+
+  # Why a suspended bot was suspended, in words for the list.
+  def bot_suspension_reason(bot)
+    case bot.suspension_reason
+    when "flooding"
+      "Went over its limit of #{Bot::MAX_MESSAGES} messages in #{Bot::WINDOW.to_i} seconds, then kept trying during the " \
+        "#{Bot::COOLDOWN.to_i}-second cooldown."
+    when "failing_webhook"
+      "Its webhook failed #{Bot::WEBHOOK_FAILURE_LIMIT} times in a row."
+    end
+  end
+end
