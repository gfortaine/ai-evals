diff --git a/test/jobs/bot/joined_job_test.rb b/test/jobs/bot/joined_job_test.rb
new file mode 100644
index 0000000..6a888ff
--- /dev/null
+++ b/test/jobs/bot/joined_job_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Bot::JoinedJobTest < ActiveJob::TestCase
+  WEBHOOK_URL = "https://bot.example.com/hook"
+
+  setup do
+    @bot = create_bot(name: "Deploy Bot", webhook_url: WEBHOOK_URL)
+    @room = rooms(:designers)
+    @room.memberships.grant_to @bot.user # The bot has joined, so its job is the one under test
+    clear_enqueued_jobs
+
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example.com").returns("93.184.216.34")
+    stub_request(:post, WEBHOOK_URL).to_return(status: 204)
+  end
+
+  test "calls the webhook with a joined event describing the room" do
+    Bot::JoinedJob.perform_now(@bot, @room)
+
+    assert_requested :post, WEBHOOK_URL, headers: { "Content-Type" => "application/json" } do |request|
+      assert_equal({
+        "event" => "joined",
+        "room" => { "id" => @room.id, "name" => "Designers", "reply_to" => "/rooms/#{@room.id}/#{@bot.code}/messages" }
+      }, JSON.parse(request.body))
+    end
+  end
+
+  test "granting a bot membership of a room it hasn't been told about calls its webhook once the grant is committed" do
+    hq = rooms(:hq) # The bot has only been told about designers
+
+    perform_enqueued_jobs only: Bot::JoinedJob do
+      hq.memberships.grant_to @bot.user
+    end
+
+    assert_requested :post, WEBHOOK_URL, times: 1
+  end
+
+  test "doesn't call a suspended bot, so it isn't told it has joined" do
+    @bot.suspend!(:failing_webhook)
+
+    Bot::JoinedJob.perform_now(@bot, @room)
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "a join made while the bot is suspended isn't recorded, so the bot is told when it next joins once reactivated" do
+    hq = rooms(:hq)
+    @bot.suspend!(:failing_webhook)
+    hq.memberships.grant_to @bot.user
+    @bot.reactivate!
+
+    hq.memberships.revoke_from @bot.user
+    assert_enqueued_with job: Bot::JoinedJob, args: [ @bot, hq ] do
+      hq.memberships.grant_to @bot.user
+    end
+  end
+
+  test "a 200 text reply is posted into the room as the bot's message" do
+    stub_request(:post, WEBHOOK_URL).to_return(status: 200, body: "Hello, designers!", headers: { "Content-Type" => "text/plain" })
+
+    assert_difference -> { @room.messages.count }, +1 do
+      Bot::JoinedJob.perform_now(@bot, @room)
+    end
+
+    message = @room.messages.find_by!(creator: @bot.user)
+    assert_equal "Hello, designers!", message.plain_text_body
+  end
+
+  test "a 200 text/html reply is posted into the room as rich text" do
+    stub_request(:post, WEBHOOK_URL).to_return(status: 200, body: "<div><b>Hi</b> designers</div>", headers: { "Content-Type" => "text/html" })
+
+    Bot::JoinedJob.perform_now(@bot, @room)
+
+    assert_equal "Hi designers", @room.messages.find_by!(creator: @bot.user).plain_text_body
+  end
+
+  test "a bot that left the room before the job ran isn't called" do
+    @room.memberships.where(user: @bot.user).delete_all
+
+    Bot::JoinedJob.perform_now(@bot, @room)
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "a banned bot isn't called" do
+    @bot.user.banned!
+
+    Bot::JoinedJob.perform_now(@bot, @room)
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "a bot whose webhook was removed since it joined isn't called" do
+    @bot.update! webhook_url: nil
+
+    Bot::JoinedJob.perform_now(@bot.reload, @room)
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "a bot deleted before its job runs is discarded without error" do
+    Bot::JoinedJob.perform_later(@bot, @room)
+    @bot.user.deactivate
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Bot::JoinedJob
+    end
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+end
diff --git a/test/jobs/bot/webhook_job_test.rb b/test/jobs/bot/webhook_job_test.rb
new file mode 100644
index 0000000..c243bcb
--- /dev/null
+++ b/test/jobs/bot/webhook_job_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class Bot::WebhookJobTest < ActiveJob::TestCase
+  WEBHOOK_URL = "https://bot.example.com/hook"
+
+  setup do
+    @bot = create_bot(name: "Deploy Bot", webhook_url: WEBHOOK_URL, add_to_all_open_rooms: true) # So it's in HQ
+    @room = rooms(:hq)
+
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example.com").returns("93.184.216.34")
+    stub_request(:post, WEBHOOK_URL).to_return(status: 204)
+  end
+
+  test "calls the webhook of a bot the message mentions" do
+    message = mention_message(@bot.user)
+
+    Bot::WebhookJob.perform_now(message)
+
+    assert_requested :post, WEBHOOK_URL
+  end
+
+  test "calls each mentioned bot's webhook once, even when a bot is mentioned twice" do
+    message = mention_message(@bot.user, "#{mention_attachment_for(@bot.user)} and again #{mention_attachment_for(@bot.user)}")
+    Bot::Webhook.expects(:new).with { |bot, payload| bot == @bot && payload.message == message }.once.returns(stub(deliver: nil))
+
+    Bot::WebhookJob.perform_now(message)
+  end
+
+  test "doesn't call bots without a webhook" do
+    @bot.update! webhook_url: nil
+
+    Bot::WebhookJob.perform_now(mention_message(@bot.user))
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "doesn't call bots that aren't mentioned" do
+    other = create_bot(name: "Release Bot", webhook_url: "https://release.example.com/hook")
+    stub_request(:post, "https://release.example.com/hook").to_return(status: 204)
+
+    Bot::WebhookJob.perform_now(mention_message(users(:david)))
+
+    assert_not_requested :post, WEBHOOK_URL
+    assert_not_requested :post, "https://release.example.com/hook"
+  end
+
+  test "doesn't call a bot that isn't in the room the message was posted to" do
+    message = rooms(:designers).messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot.user)} hi</div>")
+
+    Bot::WebhookJob.perform_now(message)
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "doesn't call a suspended bot, even when it's mentioned" do
+    message = mention_message(@bot.user)
+    @bot.suspend!(:flooding)
+
+    Bot::WebhookJob.perform_now(message)
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "doesn't call a bot whose user is banned" do
+    message = mention_message(@bot.user)
+    @bot.user.banned!
+
+    Bot::WebhookJob.perform_now(message)
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "bots' own messages don't call webhooks, so two bots can't set each other off" do
+    other = create_bot(name: "Release Bot", creator: users(:kevin), webhook_url: "https://release.example.com/hook")
+    stub_request(:post, "https://release.example.com/hook").to_return(status: 204)
+
+    Bot::WebhookJob.perform_now(mention_message(@bot.user, creator: other.user))
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "a message deleted before its job runs is discarded without error" do
+    message = mention_message(@bot.user)
+    Bot::WebhookJob.perform_later(message)
+    message.destroy
+
+    assert_nothing_raised do
+      perform_enqueued_jobs(only: Bot::WebhookJob)
+    end
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  private
+    def mention_message(user, body = mention_attachment_for(user), creator: users(:kevin))
+      @room.messages.create!(creator: creator, body: "<div>#{body} restart the build please</div>")
+    end
+end
