+    10.times { |i| post_raw "Message #{i}" }
+
+    assert_no_difference -> { Message.count } do
+      post_raw "Message 10"
+    end
+
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+  end
+
+  test "during the cooldown, the posting endpoint keeps answering too many requests, with the seconds left" do
+    travel_to Time.current do
+      10.times { |i| post_raw "Message #{i}" }
+      post_raw "Message 10"
+
+      travel 12.seconds
+      post_raw "Message 11"
+
+      assert_response :too_many_requests
+      assert_equal "18", response.headers["Retry-After"]
+      assert_no_match @bot.code, response.headers.to_h.to_s
+    end
+  end
+
+  test "the bot can post again once the cooldown has passed" do
+    travel_to Time.current do
+      10.times { |i| post_raw "Message #{i}" }
+      post_raw "Message 10"
+
+      travel 30.seconds
+      post_raw "Message 11"
+    end
+
+    assert_response :created
+  end
+
+  test "five attempts during one cooldown suspend the bot, which then gets forbidden" do
+    10.times { |i| post_raw "Message #{i}" }
+    post_raw "Message 10" # Starts the cooldown
+
+    5.times { post_raw "Still trying" }
+
+    assert_response :too_many_requests
+    assert_predicate @bot.reload, :flooding?
+
+    assert_no_difference -> { Message.count } do
+      post_raw "Message after suspension"
+    end
+    assert_response :forbidden
+  end
+
+  test "during a cooldown, every attempt is too many requests, even an unknown room or an empty body" do
+    10.times { |i| post_raw "Message #{i}" }
+    post_raw "Message 10" # Starts the cooldown
+
+    post_raw "Hello", room_id: 0
+    assert_response :too_many_requests
+
+    post_raw ""
+    assert_response :too_many_requests
+  end
+
+  test "attempts during a cooldown count towards suspension, even ones that would be unprocessable" do
+    10.times { |i| post_raw "Message #{i}" }
+    post_raw "Message 10" # Starts the cooldown
+
+    5.times { post_raw "", room_id: 0 }
+
+    assert_predicate @bot.reload, :flooding?
+  end
+
+  test "outside a cooldown, an unknown room is still not found and an empty body still unprocessable" do
+    post_raw "Hello", room_id: 0
+    assert_response :not_found
+
+    post_raw ""
+    assert_response :unprocessable_content
+  end
+
+  test "a suspended bot gets forbidden, and posts nothing" do
+    @bot.suspend!(:failing_webhook)
+
+    assert_no_difference -> { Message.count } do
+      post_raw "Hello"
+    end
+
+    assert_response :forbidden
+  end
+
+  test "a suspended bot is forbidden before its room or content are checked" do
+    @bot.suspend!(:failing_webhook)
+
+    post_raw "", room_id: 0
+
+    assert_response :forbidden
+  end
+
+  test "a suspended bot is forbidden, not unauthorized, even though its code is valid" do
+    @bot.suspend!(:flooding)
+
+    post_raw "Hello"
+
+    assert_response :forbidden
+  end
+
+  test "a suspended bot is forbidden even once it has left its rooms" do
+    @bot.suspend!(:flooding)
+    @bot.user.memberships.delete_all
+
+    post_raw "Hello"
+
+    assert_response :forbidden
+  end
+
+  test "a multipart attachment counts towards the limit" do
+    10.times { |i| post_raw "Message #{i}" }
+
+    assert_no_difference -> { Message.count } do
+      post bot_messages_url(room_id: @room.id, bot_code: @bot.code),
+        params: { attachment: fixture_file_upload("earth.png", "image/png") }
+    end
+
+    assert_response :too_many_requests
+  end
+
+  test "a multipart attachment is posted once the bot is under the limit again" do
+    travel_to Time.current do
+      10.times { |i| post_raw "Message #{i}" }
+      post_raw "Message 10"
+
+      travel 30.seconds
+      post bot_messages_url(room_id: @room.id, bot_code: @bot.code),
+        params: { attachment: fixture_file_upload("earth.png", "image/png") }
+    end
+
+    assert_response :created
+    assert @room.messages.last.attachment?
+  end
+
+  private
+    def post_raw(body, room_id: @room.id, bot_code: @bot.code, content_type: "text/plain")
+      post bot_messages_url(room_id: room_id, bot_code: bot_code), params: body, headers: { "CONTENT_TYPE" => content_type }
+    end
+end
diff --git a/test/controllers/bots/reactivations_controller_test.rb b/test/controllers/bots/reactivations_controller_test.rb
new file mode 100644
index 0000000..0279d87
--- /dev/null
+++ b/test/controllers/bots/reactivations_controller_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Bots::ReactivationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = create_bot(name: "Deploy Bot", creator: users(:kevin), add_to_all_open_rooms: true)
+    @bot.suspend!(:failing_webhook)
+  end
+
+  test "an administrator reactivates a suspended bot, and returns to the list" do
+    sign_in :david
+
+    post bot_reactivation_url(@bot)
+
+    assert_redirected_to bots_url
+    assert_not @bot.reload.suspended?
+  end
+
+  test "an administrator can reactivate a bot someone else created" do
+    sign_in :david
+    other = create_bot(name: "Release Bot", creator: users(:jz))
+    other.suspend!(:flooding)
+
+    post bot_reactivation_url(other)
+
+    assert_not other.reload.suspended?
+  end
+
+  test "a reactivated bot can post again" do
+    sign_in :david
+    post bot_reactivation_url(@bot)
+
+    post bot_messages_url(room_id: rooms(:hq).id, bot_code: @bot.code), params: "Back online", headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :created
+  end
+
+  test "the bot's creator can't reactivate it, since only administrators can" do
+    sign_in :kevin
+
+    post bot_reactivation_url(@bot)
+
+    assert_response :forbidden
+    assert_predicate @bot.reload, :suspended?
+  end
+
+  test "other members can't reactivate bots either" do
+    sign_in :jz
+
+    post bot_reactivation_url(@bot)
+
+    assert_response :forbidden
+    assert_predicate @bot.reload, :suspended?
+  end
+
+  test "reactivating a bot that doesn't exist is not found" do
+    sign_in :david
+
+    assert_raises ActiveRecord::RecordNotFound do
+      post bot_reactivation_url(bot_id: 0)
+    end
+  end
+end
