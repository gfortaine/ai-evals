+require "test_helper"
+
+class Bot::Webhook::JoinedPayloadTest < ActiveSupport::TestCase
+  setup do
+    @bot = create_bot(name: "Deploy Bot", webhook_url: "https://bot.example.com/hook")
+    @room = rooms(:designers)
+  end
+
+  test "describes the joined room in the documented format" do
+    payload = payload_for(@room)
+
+    assert_equal %w[ event room ], payload.keys
+    assert_equal "joined", payload["event"]
+    assert_equal({ "id" => @room.id, "name" => "Designers", "reply_to" => "/rooms/#{@room.id}/#{@bot.code}/messages" }, payload["room"])
+  end
+
+  test "reply_to is the bot's own posting URL for the room, as a path" do
+    reply_to = payload_for(@room).dig("room", "reply_to")
