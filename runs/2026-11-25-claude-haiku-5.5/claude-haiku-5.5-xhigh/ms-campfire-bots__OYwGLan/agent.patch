diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..915459a
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,107 @@
+# Bots post into rooms over HTTP, authenticating with their code. Each bot acts through its own user, so its
+# messages, memberships and notifications work exactly as they do for people. The code is the bot's credential:
+# whoever holds it can post as the bot, so it's only shown to the bot's creator and to administrators.
+#
+# A bot may also have a webhook URL. When a message mentions the bot, or the bot is added to a room, Bot::Webhook calls
+# that URL.
+#
+# Bots join only the rooms they're added to, unless they're set to add_to_all_open_rooms. Then they're members of every
+# open room, including ones created later (see User.joining_open_rooms and Rooms::Open).
+#
+# A bot that floods a room, or whose webhook keeps failing, is suspended (see Bot::Flooding and Bot::Suspension).
+class Bot < ApplicationRecord
+  include Flooding, Suspension
+
+  # Raised when a suspended bot tries to post. The bot API answers 403 Forbidden.
+  class Suspended < StandardError; end
+
+  # Raised when a bot is refused a message, because it's cooling down or the message would go over its limit. The bot
+  # API answers 429 Too Many Requests, with Retry-After set to retry_after seconds.
+  class RateLimited < StandardError
+    attr_reader :retry_after
+
+    def initialize(retry_after)
+      @retry_after = retry_after
+      super("Chat bot is rate limited for #{retry_after} more seconds")
+    end
+  end
+
+  has_secure_token :code
+
+  belongs_to :user, autosave: true
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+  has_many :joined_rooms, class_name: "Bot::JoinedRoom", dependent: :delete_all
+
+  normalizes :webhook_url, with: ->(url) { url.strip.presence }
+
+  validates :name, presence: true
+  validate :webhook_url_must_be_http_url, if: :webhook_url?
+  validate :creator_must_be_under_bot_limit, on: :create
+
+  after_save :join_open_rooms, if: :add_to_all_open_rooms?
+
+  delegate :name, to: :user, allow_nil: true
+
+  scope :ordered, -> { joins(:user).order("LOWER(users.name)") }
+  # Bots that get webhooks: they have one, they aren't suspended, and their user is active.
+  scope :with_active_webhook, -> { joins(:user).merge(User.active).where.not(webhook_url: nil).where(suspended_at: nil) }
+
+  class << self
+    # Only bots whose user is active can authenticate, so banning a user stops its bots at once. Deactivating a
+    # user destroys its bot outright (see User#deactivate).
+    def authenticate(code)
+      joins(:user).merge(User.active).find_by(code: code) if code.present?
+    end
+
+    # Bot text is plain text, so it's escaped before being stored as rich text: markup in it is shown as written.
+    # Line breaks are kept.
+    def html_from_text(text)
+      ERB::Util.html_escape(text.gsub(/\r\n?/, "\n").strip).gsub("\n", "<br>")
+    end
+
+    # HTML from a bot is kept to the markup messages are shown with. Attachments are dropped, so a bot can't mention
+    # people, which would ping them, the way a person can with the @-mention autocomplete.
+    def html_from_html(html)
+      fragment = ActionText::Content.new(html).fragment.replace(ActionText::Attachment.tag_name) { nil }
+
+      ContentFilters::TextMessagePresentationFilters.apply(ActionText::Content.new(fragment, canonicalize: false)).to_html
+    end
+  end
+
+  def name=(name)
+    bot_user.name = name
+  end
+
+  def avatar=(avatar)
+    bot_user.avatar = avatar
+  end
+
+  private
+    # Bots never sign in, so this password only satisfies the user's password digest.
+    def bot_user
+      user || build_user(password: SecureRandom.hex)
+    end
+
+    # Runs on every save while the switch is on, so the bot is in every open room, not just the ones that existed when
+    # the switch was turned on. Rooms it's already in are skipped, so nothing is added or announced twice.
+    def join_open_rooms
+      Rooms::Open.where.not(id: user.memberships.select(:room_id)).each do |room|
+        room.memberships.grant_to user
+      end
+    end
+
+    # Only creating a bot counts, so lowering the account's limit never removes or blocks existing bots. Validation runs
+    # inside the save's transaction, and SQLite runs write transactions one at a time, so two creations for the same
+    # member can't both see room under the limit.
+    def creator_must_be_under_bot_limit
+      if creator && !creator.can_add_bots?
+        limit = Current.account.bots_per_member
+        errors.add :base, "You’ve reached the limit of #{limit} #{"chat bot".pluralize(limit)}."
+      end
+    end
+
+    def webhook_url_must_be_http_url
+      uri = URI.parse(webhook_url) rescue nil
+      errors.add :webhook_url, "must be an http or https address" unless uri.is_a?(URI::HTTP) && uri.host.present?
+    end
+end
diff --git a/app/models/bot/flooding.rb b/app/models/bot/flooding.rb
new file mode 100644
index 0000000..e8d684b
--- /dev/null
+++ b/app/models/bot/flooding.rb
@@ -0,0 +1,93 @@
+# Stops a bot from flooding a room. A bot may post at most MAX_MESSAGES messages in any WINDOW, counting messages posted
+# through the bot API and webhook replies alike. The message that goes over that limit is refused and starts a COOLDOWN,
+# during which every attempt to post is refused too. MAX_COOLDOWN_ATTEMPTS attempts within one cooldown suspend the bot
+# (see Bot::Suspension).
+#
+# Messages are counted from the messages table, so there's no separate record of posting to keep in step. A refused
+# attempt isn't a message, so it doesn't count towards the limit. The cooldown is longer than the window, so once it has
+# passed, the window is always clear.
+#
+# The check, the cooldown bookkeeping and the insert all run under the bot's row lock. Two posts can't both see room
+# under the limit, whether they come from the API or from webhook replies. Attachments are processed after the
+# transaction, since that can be slow and would otherwise hold the lock.
+module Bot::Flooding
+  extend ActiveSupport::Concern
+
+  MAX_MESSAGES = 10
+  WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  MAX_COOLDOWN_ATTEMPTS = 5
+
+  # Posts a message as the bot, and returns it. Raises Bot::Suspended if the bot is suspended, or Bot::RateLimited if the
+  # message is refused, with the seconds left to wait.
+  def post_message(room, **attributes)
+    message, retry_after = with_lock { post_unless_limited(room, attributes) }
+
+    raise Bot::RateLimited.new(retry_after) if retry_after
+
+    message.process_attachment
+    message.broadcast_create
+    message
+  end
+
+  # Checks an attempt to post against the cooldown, before anything else about the attempt is checked. So during a
+  # cooldown, every attempt is refused and counts, even one that would have been refused for another reason, such as an
+  # unknown room. Raises Bot::Suspended or Bot::RateLimited, like post_message.
+  def refuse_during_cooldown!
+    retry_after = with_lock do
+      raise Bot::Suspended if suspended?
+
+      attempt_during_cooldown
+    end
+
+    raise Bot::RateLimited.new(retry_after) if retry_after
+  end
+
+  private
+    # Raising here would roll back the cooldown bookkeeping, so refusals are returned, and raised once the transaction
+    # has committed.
+    def post_unless_limited(room, attributes)
+      raise Bot::Suspended if suspended?
+
+      if (retry_after = attempt_during_cooldown)
+        [ nil, retry_after ]
+      elsif message_limit_reached?
+        start_cooldown
+        [ nil, COOLDOWN.to_i ]
+      else
+        [ room.messages.create!(attributes.merge(creator: user)), nil ]
+      end
+    end
+
+    # Counts the attempt if the bot is cooling down, and returns the seconds left to wait. Returns nil otherwise.
+    def attempt_during_cooldown
+      return unless cooling_down?
+
+      count_cooldown_attempt
+      seconds_until_cooldown_ends
+    end
+
+    def cooling_down?
+      cooldown_until.present? && cooldown_until.future?
+    end
+
+    def message_limit_reached?
+      user.messages.where(Message.arel_table[:created_at].gt(WINDOW.ago)).count >= MAX_MESSAGES
+    end
+
+    def start_cooldown
+      update_columns cooldown_until: COOLDOWN.from_now, cooldown_attempts: 0
+    end
+
+    def count_cooldown_attempt
+      attempts = cooldown_attempts + 1
+      update_columns cooldown_attempts: attempts
+
+      suspend!(:flooding) if attempts >= MAX_COOLDOWN_ATTEMPTS
+    end
+
+    # Rounded up, so a client that waits this long isn't refused again.
+    def seconds_until_cooldown_ends
+      (cooldown_until - Time.current).ceil
+    end
+end
