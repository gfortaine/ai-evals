+require "test_helper"
+
+class BotCodeFilterTest < ActiveSupport::TestCase
+  test "masks the bot code in a message path" do
+    assert_equal "/rooms/12/[FILTERED]/messages", BotCodeFilter.filter("/rooms/12/abc123XYZ/messages")
+  end
+
+  test "masks the bot code in a full URL, keeping the query string" do
+    assert_equal "https://chat.example.com/rooms/12/[FILTERED]/messages?x=1",
+      BotCodeFilter.filter("https://chat.example.com/rooms/12/abc123XYZ/messages?x=1")
+  end
+
+  test "leaves other paths alone" do
+    [ "/rooms/12/messages", "/rooms/12/messages/34", "/rooms/12/@34", "/bots/12/edit", "/messages/34" ].each do |path|
+      assert_equal path, BotCodeFilter.filter(path)
+    end
+  end
+
+  test "request paths logged by Rails mask the bot code" do
+    request = ActionDispatch::Request.new(Rack::MockRequest.env_for("/rooms/12/abc123XYZ/messages", method: "POST"))
