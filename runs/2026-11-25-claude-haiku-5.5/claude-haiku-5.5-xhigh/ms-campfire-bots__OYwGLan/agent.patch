+    @bot.user.deactivate
+
+    assert_no_difference -> { Message.count } do
+      post_raw "Hello", bot_code: code
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "a banned bot can no longer post" do
+    @bot.user.banned!
+
+    assert_no_difference -> { Message.count } do
+      post_raw "Hello"
+    end
+
+    assert_response :unauthorized
+  end
+
