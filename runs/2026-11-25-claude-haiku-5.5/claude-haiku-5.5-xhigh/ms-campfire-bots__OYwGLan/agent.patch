+<% @page_title = "Chat bots" %>
+
+<% content_for :head do %>
+  <%# The page shows bot codes, which are credentials, so keep it out of Turbo's page cache. %>
+  <%= tag.meta name: "turbo-cache-control", content: "no-cache" %>
+<% end %>
+
+<% content_for :nav do %>
+  <div class="flex-item-justify-start">
+    <%= link_back_to_last_room_visited %>
+  </div>
+
+  <% if Current.user.can_add_bots? %>
+    <div class="flex-item-justify-end">
+      <%= link_to new_bot_path, class: "btn" do %>
+        <%= image_tag "add.svg", aria: { hidden: "true" }, size: 20 %>
+        <span>Add a chat bot</span>
+      <% end %>
+    </div>
+  <% end %>
+<% end %>
+
+<section class="panel panel--wide flex flex-column gap">
+  <h1 class="txt-align-center txt-large margin-none">Chat bots</h1>
+
+  <% unless Current.user.can_add_bots? %>
+    <p class="txt-align-center txt-subtle margin-none">You’ve reached the limit of <%= pluralize Current.account.bots_per_member, "chat bot" %>.</p>
+  <% end %>
+
+  <div class="pad-inline fill-shade border-radius" id="bots">
+    <menu class="pad flex flex-column gap">
+      <%= render partial: "bots/bot", collection: @bots %>
+
+      <% if @bots.empty? %>
+        <li class="txt-align-center txt-subtle margin-none">No chat bots yet.</li>
+      <% end %>
+    </menu>
+  </div>
+</section>
