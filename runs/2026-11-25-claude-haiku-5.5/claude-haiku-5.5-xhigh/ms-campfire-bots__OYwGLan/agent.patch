+<% @page_title = "Edit chat bot" %>
+
+<% content_for :head do %>
+  <%# The form shows the webhook URL, which can carry a secret, so keep the page out of Turbo's page cache. %>
+  <%= tag.meta name: "turbo-cache-control", content: "no-cache" %>
+<% end %>
+
+<% content_for :nav do %>
+  <div class="flex-item-justify-start">
+    <%= link_back_to bots_path %>
+  </div>
+<% end %>
+
+<section class="panel txt-align-center" style="view-transition-name: bot-<%= @bot.id %>">
+  <%= render "bots/form", bot: @bot %>
+</section>
+
+<section class="panel txt-align-center">
+  <%= button_to bot_path(@bot), method: :delete, class: "btn btn--negative max-width",
+        data: { turbo_confirm: "Are you sure you want to delete this chat bot? Its code will stop working, and it can’t be undone." } do %>
+    <%= image_tag "trash.svg", aria: { hidden: "true" }, size: 20 %>
+    <span>Delete this chat bot</span>
+  <% end %>
+</section>
