+# Administrators decide when a suspended bot comes back. Nobody else can reactivate one, not even its creator.
+class Bots::ReactivationsController < ApplicationController
+  before_action :ensure_administrator
+  before_action :set_bot
+
+  def create
+    @bot.reactivate!
+
+    redirect_to bots_url
+  end
+
+  private
+    def ensure_administrator
+      head :forbidden unless Current.user.administrator?
+    end
+
+    def set_bot
+      @bot = Bot.find(params[:bot_id])
+    end
+end
