+  end
+
+  test "index lists the bots you created, with their codes in read-only fields" do
+    bot = create_bot(name: "Deploy Bot", creator: users(:kevin))
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li#bot_#{bot.id}" do
+      assert_select "strong", text: "Deploy Bot"
+      assert_select "label[for=?]", dom_id(bot, :code), text: "Bot code"
+      assert_select "input##{dom_id(bot, :code)}[readonly][value=?]", bot.code
+    end
+  end
+
+  test "index doesn't list bots created by other people" do
+    other_bot = create_bot(name: "Someone Else's Bot", creator: users(:david))
+
+    get bots_url
+
+    assert_select "li#bot_#{other_bot.id}", count: 0
+    assert_no_match other_bot.code, response.body
+  end
+
+  test "index lists every bot for administrators" do
+    sign_in :david
+    other_bot = create_bot(name: "Kevin's Bot", creator: users(:kevin))
+
+    get bots_url
+
+    assert_select "li#bot_#{other_bot.id}" do
+      assert_select "input[value=?]", other_bot.code
+    end
+  end
+
+  test "index has no pagination" do
+    12.times { |i| create_bot(name: "Bot #{i}", creator: users(:kevin)) }
+
+    get bots_url
+
+    assert_select "li", count: 12
+    assert_select "a[href*=page]", count: 0
+  end
+
+  test "new renders the form" do
+    get new_bot_url
+
+    assert_response :success
+    assert_select "form[action=?]", bots_path do
+      assert_select "input[name='bot[name]'][required][placeholder='Name the bot']"
+      assert_select "input[type=file][name='bot[avatar]']"
+      assert_select "button[type=submit]", text: /Save changes/
+    end
+  end
+
+  test "create makes a bot created by the current user and returns to the list" do
+    assert_difference -> { Bot.count }, +1 do
+      assert_difference -> { User.count }, +1 do
+        post bots_url, params: { bot: { name: "Deploy Bot" } }
+      end
+    end
+
+    assert_redirected_to bots_url
+    bot = Bot.last
+    assert_equal "Deploy Bot", bot.name
+    assert_equal users(:kevin), bot.creator
+    assert_predicate bot.code, :present?
+  end
+
+  test "create gives the bot membership of every open room, like any new user" do
+    post bots_url, params: { bot: { name: "Deploy Bot" } }
+
+    assert_equal Rooms::Open.pluck(:id).sort, Bot.last.user.memberships.pluck(:room_id).sort
+  end
+
+  test "create with an avatar sets the bot's avatar" do
+    post bots_url, params: { bot: { name: "Deploy Bot", avatar: fixture_file_upload("earth.png", "image/png") } }
+
+    assert Bot.last.user.avatar.attached?
+  end
+
+  test "create without a name re-renders the form as unprocessable" do
+    assert_no_difference -> { Bot.count } do
+      post bots_url, params: { bot: { name: "" } }
+    end
+
+    assert_response :unprocessable_content
+    assert_select "p", text: /Name can't be blank/
+  end
+
+  test "any member can create a bot" do
+    sign_in :jz
+    assert_not users(:jz).administrator?
+
+    post bots_url, params: { bot: { name: "JZ's Bot" } }
+
+    assert_equal users(:jz), Bot.last.creator
+  end
+
+  test "edit renders the form with the same fields and a delete button that asks for confirmation" do
+    bot = create_bot(name: "Deploy Bot", creator: users(:kevin))
+
+    get edit_bot_url(bot)
+
+    assert_response :success
+    assert_select "input[name='bot[name]'][value=?]", "Deploy Bot"
+    assert_select "input[type=file][name='bot[avatar]']"
+    assert_select "button[data-turbo-confirm]", text: "Delete this chat bot"
+    assert_select "input[value=?]", bot.code, count: 0
+  end
+
+  test "update changes the bot's name" do
+    bot = create_bot(name: "Deploy Bot", creator: users(:kevin))
+
+    patch bot_url(bot), params: { bot: { name: "Release Bot" } }
+
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", bot.reload.name
+    assert_equal "Release Bot", bot.user.reload.name
+  end
+
+  test "update with no new avatar keeps the current avatar" do
+    bot = create_bot(name: "Deploy Bot", creator: users(:kevin), avatar: fixture_file_upload("earth.png", "image/png"))
+
+    patch bot_url(bot), params: { bot: { name: "Release Bot", avatar: "" } }
+
+    assert_redirected_to bots_url
+    assert bot.reload.user.avatar.attached?
+  end
+
+  test "update with a new avatar replaces it" do
+    bot = create_bot(name: "Deploy Bot", creator: users(:kevin))
+
+    patch bot_url(bot), params: { bot: { avatar: fixture_file_upload("moon.jpg", "image/jpeg") } }
+
+    assert_redirected_to bots_url
+    assert_equal "moon.jpg", bot.reload.user.avatar.filename.to_s
+  end
+
+  test "update with a blank name re-renders the form as unprocessable" do
+    bot = create_bot(name: "Deploy Bot", creator: users(:kevin))
+
+    patch bot_url(bot), params: { bot: { name: "" } }
+
+    assert_response :unprocessable_content
+    assert_equal "Deploy Bot", bot.reload.name
+  end
+
+  test "a bot's creator can update it" do
+    bot = create_bot(name: "Deploy Bot", creator: users(:kevin))
+
+    patch bot_url(bot), params: { bot: { name: "Release Bot" } }
+
+    assert_equal "Release Bot", bot.reload.name
+  end
+
+  test "non-administrators can't edit or delete bots created by someone else" do
+    bot = create_bot(name: "David's Bot", creator: users(:david))
+
+    get edit_bot_url(bot)
+    assert_response :forbidden
+
+    patch bot_url(bot), params: { bot: { name: "Hijacked" } }
+    assert_response :forbidden
+    assert_equal "David's Bot", bot.reload.name
+
+    assert_no_difference -> { Bot.count } do
+      delete bot_url(bot)
+    end
+    assert_response :forbidden
+  end
+
+  test "administrators can edit and delete any bot" do
+    sign_in :david
+    bot = create_bot(name: "Kevin's Bot", creator: users(:kevin))
+
+    patch bot_url(bot), params: { bot: { name: "Renamed" } }
+    assert_equal "Renamed", bot.reload.name
+
+    assert_difference -> { Bot.count }, -1 do
+      delete bot_url(bot)
+    end
+  end
+
+  test "destroy deactivates the bot's user and removes its code, leaving the list" do
+    bot = create_bot(name: "Deploy Bot", creator: users(:kevin))
+    user = bot.user
+    code = bot.code
+
+    assert_difference -> { Bot.count }, -1 do
+      delete bot_url(bot)
+    end
+
+    assert_redirected_to bots_url
+    assert user.reload.deactivated?
+    assert_nil Bot.find_by(code: code)
+    assert_empty user.memberships
+  end
+
+  test "bots aren't shown on the list after they're deleted" do
+    bot = create_bot(name: "Deploy Bot", creator: users(:kevin))
+    delete bot_url(bot)
+
+    get bots_url
+
+    assert_select "li#bot_#{bot.id}", count: 0
+  end
+end
