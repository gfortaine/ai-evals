new file mode 100644
index 0000000..2317ca9
--- /dev/null
+++ b/test/controllers/bots/messages_controller_test.rb
@@ -0,0 +1,212 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+
+    @bot = create_bot
+    @room = rooms(:hq) # An open room, so the bot is already a member
+  end
+
+  test "the raw body becomes the message body, authored by the bot" do
+    assert_difference -> { @room.messages.count }, +1 do
+      post_raw "Deploy of v1.2.3 finished ✅"
+    end
+
+    assert_response :created
+    message = @room.messages.last
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+    assert_equal @bot.user, message.creator
+  end
+
+  test "created responds with a location for the message" do
+    post_raw "Deploy of v1.2.3 finished ✅"
+
+    assert_equal "/messages/#{@room.messages.last.id}", response.headers["Location"]
+  end
+
+  test "form-encoded bodies are taken literally rather than parsed as parameters" do
+    post_raw "100% done & checked=yes", content_type: "application/x-www-form-urlencoded"
+
+    assert_response :created
+    assert_equal "100% done & checked=yes", @room.messages.last.plain_text_body
+  end
+
+  test "JSON-looking bodies are taken literally too" do
+    post_raw "{not json", content_type: "application/json"
+
+    assert_response :created
+    assert_equal "{not json", @room.messages.last.plain_text_body
+  end
+
+  test "markup in the body is shown as written" do
+    post_raw "<b>bold</b> & <script>alert(1)</script>"
+
+    assert_response :created
+    message = @room.messages.last
+    assert_equal "<b>bold</b> & <script>alert(1)</script>", message.plain_text_body
+    assert_no_match %r{<b>|<script>}, message.body.body.to_html
+  end
+
+  test "line breaks are kept and surrounding whitespace is trimmed" do
+    post_raw "\n  first line\r\nsecond line\n\n"
+
+    assert_response :created
+    assert_equal "first line\nsecond line", @room.messages.last.plain_text_body
+  end
+
+  test "the response doesn't echo the bot code" do
+    post_raw "Hello"
+
+    assert_no_match @bot.code, response.body
+    assert_no_match @bot.code, response.headers.to_h.to_s
+  end
+
+  test "an invalid bot code is unauthorized and posts nothing" do
+    assert_no_difference -> { Message.count } do
+      post_raw "Hello", bot_code: "not-a-real-code"
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "a deleted bot can no longer post" do
+    code = @bot.code
+    @bot.user.deactivate
+
+    assert_no_difference -> { Message.count } do
+      post_raw "Hello", bot_code: code
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "a banned bot can no longer post" do
+    @bot.user.banned!
+
+    assert_no_difference -> { Message.count } do
+      post_raw "Hello"
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "an unknown room is not found" do
+    assert_no_difference -> { Message.count } do
+      post_raw "Hello", room_id: 0
+    end
+
+    assert_response :not_found
+  end
+
+  test "a room the bot isn't a member of is not found" do
+    designers = rooms(:designers)
+    assert_not @bot.user.rooms.include?(designers)
+
+    assert_no_difference -> { Message.count } do
+      post_raw "Hello", room_id: designers.id
+    end
+
+    assert_response :not_found
+  end
+
+  test "posting needs no CSRF token, as bots aren't browsers" do
+    original = ActionController::Base.allow_forgery_protection
+    ActionController::Base.allow_forgery_protection = true
+
+    post_raw "Hello"
+
+    assert_response :created
+  ensure
+    ActionController::Base.allow_forgery_protection = original
+  end
+
+  test "a bot given access to a closed room can post there" do
+    designers = rooms(:designers)
+    designers.memberships.grant_to @bot.user
+
+    post_raw "Hello designers", room_id: designers.id
+
+    assert_response :created
+    assert_equal designers, Message.last.room
+  end
+
+  test "an empty body with no attachment is unprocessable" do
+    assert_no_difference -> { Message.count } do
+      post_raw ""
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "a whitespace-only body with no attachment is unprocessable" do
+    assert_no_difference -> { Message.count } do
+      post_raw " \n\t "
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "a multipart attachment is posted as the message's attachment" do
+    assert_difference -> { @room.messages.count }, +1 do
+      post bot_messages_url(room_id: @room.id, bot_code: @bot.code),
+        params: { attachment: fixture_file_upload("earth.png", "image/png") }
+    end
+
+    assert_response :created
+    message = @room.messages.last
+    assert message.attachment?
+    assert_equal @bot.user, message.creator
+  end
+
+  test "a multipart request's text is ignored, since a message is either text or a file" do
+    post bot_messages_url(room_id: @room.id, bot_code: @bot.code),
+      params: { attachment: fixture_file_upload("earth.png", "image/png"), body: "Screenshot from CI" }
+
+    assert_response :created
+    message = @room.messages.last
+    assert message.attachment?
+    assert_not message.body.present?
+    assert_equal "earth.png", message.plain_text_body
+  end
+
+  test "a multipart request without attachment or body is unprocessable" do
+    boundary = "CampfireBotBoundary"
+    multipart_body = "--#{boundary}\r\nContent-Disposition: form-data; name=\"body\"\r\n\r\n\r\n--#{boundary}--\r\n"
+
+    assert_no_difference -> { Message.count } do
+      post bot_messages_url(room_id: @room.id, bot_code: @bot.code), params: multipart_body,
+        headers: { "CONTENT_TYPE" => "multipart/form-data; boundary=#{boundary}" }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "posting broadcasts the message to the room, showing the bot as its author" do
+    post_raw "Deploy of v1.2.3 finished ✅"
+
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author strong", text: @bot.name
+      assert_select ".message__body", text: /Deploy of v1.2.3 finished/
+    end
+  end
+
+  test "posting broadcasts unread rooms to each member of the room" do
+    @room.users.each do |member|
+      assert_broadcasts UnreadRoomsChannel.stream_name_for(member.id), 1 do
+        post_raw "Hello #{member.id}"
+      end
+    end
+  end
+
+  test "posting enqueues push notifications for the room, as a human message would" do
+    assert_enqueued_with job: Room::PushMessageJob do
+      post_raw "Deploy of v1.2.3 finished ✅"
+    end
+  end
+
+  private
+    def post_raw(body, room_id: @room.id, bot_code: @bot.code, content_type: "text/plain")
+      post bot_messages_url(room_id: room_id, bot_code: bot_code), params: body, headers: { "CONTENT_TYPE" => content_type }
+    end
+end
