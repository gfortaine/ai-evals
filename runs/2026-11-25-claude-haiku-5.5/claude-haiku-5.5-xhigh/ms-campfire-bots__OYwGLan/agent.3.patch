+    @bot.user.banned!
+
+    assert_no_enqueued_jobs only: Bot::JoinedJob do
+      @room.memberships.grant_to @bot.user
+    end
+  end
+
+  test "people are never told, since only bots have webhooks" do
+    assert_no_enqueued_jobs only: Bot::JoinedJob do
+      @room.memberships.grant_to users(:kevin)
+    end
+  end
+
+  test "a grant that's rolled back tells no one, and records nothing" do
+    assert_no_difference -> { Bot::JoinedRoom.count } do
+      assert_no_enqueued_jobs only: Bot::JoinedJob do
+        Room.transaction do
+          @room.memberships.grant_to @bot.user
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "deleting a room or a bot forgets its joins, without failing" do
+    @room.memberships.grant_to @bot.user
+    assert_equal 1, Bot::JoinedRoom.where(room: @room).count
+
+    assert_nothing_raised { @room.destroy! }
+    assert_empty Bot::JoinedRoom.where(bot: @bot)
+
+    other = rooms(:hq)
+    other.memberships.grant_to @bot.user
+    assert_nothing_raised { @bot.user.deactivate }
+    assert_empty Bot::JoinedRoom.where(room: other)
+  end
+end
