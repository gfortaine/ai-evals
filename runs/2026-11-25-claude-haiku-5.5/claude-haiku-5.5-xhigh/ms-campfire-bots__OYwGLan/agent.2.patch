diff --git a/test/jobs/bot/webhook_job_test.rb b/test/jobs/bot/webhook_job_test.rb
new file mode 100644
index 0000000..d36009c
--- /dev/null
+++ b/test/jobs/bot/webhook_job_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class Bot::WebhookJobTest < ActiveJob::TestCase
+  WEBHOOK_URL = "https://bot.example.com/hook"
+
+  setup do
+    @bot = create_bot(name: "Deploy Bot", webhook_url: WEBHOOK_URL)
+    @room = rooms(:hq)
+
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example.com").returns("93.184.216.34")
+    stub_request(:post, WEBHOOK_URL).to_return(status: 204)
+  end
+
+  test "calls the webhook of a bot the message mentions" do
+    message = mention_message(@bot.user)
+
+    Bot::WebhookJob.perform_now(message)
+
+    assert_requested :post, WEBHOOK_URL
+  end
+
+  test "calls each mentioned bot's webhook once, even when a bot is mentioned twice" do
+    message = mention_message(@bot.user, "#{mention_attachment_for(@bot.user)} and again #{mention_attachment_for(@bot.user)}")
+    Bot::Webhook.expects(:new).with(@bot, message).once.returns(stub(deliver: nil))
+
+    Bot::WebhookJob.perform_now(message)
+  end
+
+  test "doesn't call bots without a webhook" do
+    @bot.update! webhook_url: nil
+
+    Bot::WebhookJob.perform_now(mention_message(@bot.user))
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "doesn't call bots that aren't mentioned" do
+    other = create_bot(name: "Release Bot", webhook_url: "https://release.example.com/hook")
+    stub_request(:post, "https://release.example.com/hook").to_return(status: 204)
+
+    Bot::WebhookJob.perform_now(mention_message(users(:david)))
+
+    assert_not_requested :post, WEBHOOK_URL
+    assert_not_requested :post, "https://release.example.com/hook"
+  end
+
+  test "doesn't call a bot that isn't in the room the message was posted to" do
+    message = rooms(:designers).messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot.user)} hi</div>")
+
+    Bot::WebhookJob.perform_now(message)
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "doesn't call a bot whose user is banned" do
+    message = mention_message(@bot.user)
+    @bot.user.banned!
+
+    Bot::WebhookJob.perform_now(message)
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "bots' own messages don't call webhooks, so two bots can't set each other off" do
+    other = create_bot(name: "Release Bot", creator: users(:kevin), webhook_url: "https://release.example.com/hook")
+    stub_request(:post, "https://release.example.com/hook").to_return(status: 204)
+
+    Bot::WebhookJob.perform_now(mention_message(@bot.user, creator: other.user))
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "a message deleted before its job runs is discarded without error" do
+    message = mention_message(@bot.user)
+    Bot::WebhookJob.perform_later(message)
+    message.destroy
+
+    assert_nothing_raised do
+      perform_enqueued_jobs(only: Bot::WebhookJob)
+    end
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  private
+    def mention_message(user, body = mention_attachment_for(user), creator: users(:kevin))
+      @room.messages.create!(creator: creator, body: "<div>#{body} restart the build please</div>")
+    end
+end
diff --git a/test/models/bot/webhook/payload_test.rb b/test/models/bot/webhook/payload_test.rb
new file mode 100644
index 0000000..fa69af8
--- /dev/null
+++ b/test/models/bot/webhook/payload_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Bot::Webhook::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @bot = create_bot(name: "Deploy Bot", webhook_url: "https://bot.example.com/hook")
+    @room = rooms(:hq)
+  end
+
+  test "describes the mention in the documented format" do
+    message = mention_message("#{mention_attachment_for(@bot.user)} restart the build please", creator: users(:kevin))
+
+    payload = payload_for(message)
+
+    assert_equal %w[ event author room message ], payload.keys
+    assert_equal "mention", payload["event"]
+    assert_equal({ "id" => users(:kevin).id, "name" => "Kevin" }, payload["author"])
+    assert_equal({ "id" => @room.id, "name" => "HQ", "reply_to" => "/rooms/#{@room.id}/#{@bot.code}/messages" }, payload["room"])
+    assert_equal message.id, payload["message"]["id"]
+    assert_equal "restart the build please", payload["message"]["body"]["text"]
+    assert_includes payload["message"]["body"]["html"], "restart the build please"
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", payload["message"]["link"]
+  end
+
+  test "reply_to is the bot's own posting URL for the room, as a path" do
+    message = mention_message("#{mention_attachment_for(@bot.user)} hello")
+
+    reply_to = payload_for(message).dig("room", "reply_to")
+
+    assert_equal "/rooms/#{@room.id}/#{@bot.code}/messages", reply_to
+    assert_equal({ controller: "bots/messages", action: "create", room_id: @room.id.to_s, bot_code: @bot.code },
+      Rails.application.routes.recognize_path(reply_to, method: :post))
+  end
+
+  test "link is a path that opens the room at the message" do
+    message = mention_message("#{mention_attachment_for(@bot.user)} hello")
+
+    link = payload_for(message).dig("message", "link")
+
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", link
+    assert_equal({ controller: "rooms", action: "show", room_id: @room.id.to_s, message_id: message.id.to_s },
+      Rails.application.routes.recognize_path(link))
+  end
+
+  test "the text has the bot's own mention removed, so it reads as the command" do
+    message = mention_message("#{mention_attachment_for(@bot.user)} restart the build please")
+
+    assert_equal "restart the build please", payload_for(message).dig("message", "body", "text")
+  end
+
+  test "the bot's mention is removed wherever it is in the text" do
+    message = mention_message("please #{mention_attachment_for(@bot.user)} restart")
+
+    assert_equal "please  restart", payload_for(message).dig("message", "body", "text")
+  end
+
+  test "other people's mentions stay in the text as @names" do
+    message = mention_message("#{mention_attachment_for(@bot.user)} ask #{mention_attachment_for(:david)} to check")
+
+    assert_equal "ask @David to check", payload_for(message).dig("message", "body", "text")
+  end
+
+  test "the html is the whole rich-text body, including the bot's mention" do
+    message = mention_message("#{mention_attachment_for(@bot.user)} restart the build please")
+
+    html = payload_for(message).dig("message", "body", "html")
+
+    assert_includes html, "restart the build please"
+    assert_includes html, "Deploy Bot"
+  end
+
+  test "the html is sanitized" do
+    message = mention_message("#{mention_attachment_for(@bot.user)} <b>bold</b><script>alert(1)</script>")
+
+    html = payload_for(message).dig("message", "body", "html")
+
+    assert_includes html, "<b>bold</b>"
+    assert_no_match %r{<script>}, html
+  end
+
+  test "direct rooms are named after the people in them, other than the bot" do
+    direct = Rooms::Direct.create_for({ creator: users(:kevin) }, users: [ users(:kevin), @bot.user ])
+    message = direct.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(@bot.user)} hello</div>")
+
+    assert_equal "Kevin", payload_for(message).dig("room", "name")
+    assert_equal "/rooms/#{direct.id}/#{@bot.code}/messages", payload_for(message).dig("room", "reply_to")
+  end
+
+  test "the bot's code appears only in reply_to" do
+    message = mention_message("#{mention_attachment_for(@bot.user)} hello")
+
+    assert_equal 1, Bot::Webhook::Payload.new(@bot, message).to_json.scan(@bot.code).size
+  end
+
+  private
+    def mention_message(body, creator: users(:kevin))
+      @room.messages.create!(creator: creator, body: "<div>#{body}</div>")
+    end
+
+    def payload_for(message)
+      JSON.parse(Bot::Webhook::Payload.new(@bot, message).to_json)
+    end
+end
diff --git a/test/models/bot/webhook_test.rb b/test/models/bot/webhook_test.rb
new file mode 100644
index 0000000..5ea76bc
--- /dev/null
+++ b/test/models/bot/webhook_test.rb
@@ -0,0 +1,225 @@
+require "test_helper"
+
+class Bot::WebhookTest < ActiveSupport::TestCase
+  WEBHOOK_URL = "https://bot.example.com/hook"
+
+  setup do
+    @bot = create_bot(name: "Deploy Bot", webhook_url: WEBHOOK_URL)
+    @room = rooms(:hq)
+    @message = mention_message("#{mention_attachment_for(@bot.user)} restart the build please")
+
+    # Resolving hosts goes through real DNS, so the test pins the address the guard hands back.
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example.com").returns("93.184.216.34")
+  end
+
+  test "posts the payload as JSON" do
+    stub_webhook status: 204
+
+    deliver
+
+    assert_requested :post, WEBHOOK_URL, headers: { "Content-Type" => "application/json" } do |request|
+      assert_equal "mention", JSON.parse(request.body)["event"]
+    end
+  end
+
+  test "connects to the address that was checked, so DNS can't change it in between" do
+    stub_webhook status: 204
+    Net::HTTP.any_instance.expects(:ipaddr=).with("93.184.216.34").at_least_once
+
+    deliver
+
+    assert_requested :post, WEBHOOK_URL
+  end
+
+  test "a 204 posts nothing" do
+    stub_webhook status: 204
+
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+  end
+
+  test "a 200 text/plain reply is posted into the room as the bot's message" do
+    stub_webhook body: "Deployed v1.2.3 <all green>\nrun 42", content_type: "text/plain"
+
+    assert_difference -> { @room.messages.count }, +1 do
+      deliver
+    end
+
+    message = @room.messages.last
+    assert_equal @bot.user, message.creator
+    assert_equal "Deployed v1.2.3 <all green>\nrun 42", message.plain_text_body
+  end
+
+  test "a text/plain reply's markup is shown as written" do
+    stub_webhook body: "<b>bold</b> & <script>alert(1)</script>", content_type: "text/plain"
+
+    deliver
+
+    message = @room.messages.last
+    assert_equal "<b>bold</b> & <script>alert(1)</script>", message.plain_text_body
+    assert_no_match %r{<b>|<script>}, message.body.body.to_html
+  end
+
+  test "a 200 text/html reply is posted as rich text, with unsafe markup removed" do
+    stub_webhook body: "<div><b>Deployed</b> ✅</div><script>alert(1)</script>", content_type: "text/html"
+
+    deliver
+
+    message = @room.messages.last
+    assert_equal @bot.user, message.creator
+    assert_equal "Deployed ✅", message.plain_text_body
+    assert_includes message.body.body.to_html, "<b>Deployed</b>"
+    assert_no_match %r{<script>}, message.body.body.to_html
+  end
+
+  test "a text/html reply can't mention people, since that would ping them" do
+    stub_webhook body: "<div>Hey #{mention_attachment_for(:david)}</div>", content_type: "text/html"
+
+    deliver
+
+    message = @room.messages.last
+    assert_empty message.body.body.attachables
+    assert_empty message.mentionees
+  end
+
+  test "a text/plain reply with a charset is decoded with it" do
+    stub_webhook body: "Déployé".encode(Encoding::ISO_8859_1), content_type: "text/plain; charset=ISO-8859-1"
+
+    deliver
+
+    assert_equal "Déployé", @room.messages.last.plain_text_body
+  end
+
+  test "bytes that aren't valid UTF-8 are replaced, and the reply still posts" do
+    stub_webhook body: "bad \xff bytes".b, content_type: "text/plain"
+
+    assert_nothing_raised { deliver }
+    assert_equal "bad \uFFFD bytes", @room.messages.last.plain_text_body
+  end
+
+  test "a 200 reply posts a message that is broadcast to the room" do
+    stub_webhook body: "Deployed", content_type: "text/plain"
+
+    Message.any_instance.expects(:broadcast_create).once
+
+    deliver
+  end
+
+  test "a 200 reply with no visible text posts nothing" do
+    stub_webhook body: " \n\t ", content_type: "text/plain"
+
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+  end
+
+  test "a 200 text/html reply made only of markup posts nothing" do
+    stub_webhook body: "<div></div>", content_type: "text/html"
+
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+  end
+
+  test "a 200 reply with another content type posts nothing" do
+    stub_webhook body: %({"text":"Deployed"}), content_type: "application/json"
+
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+  end
+
+  test "other statuses post nothing, whatever they say" do
+    [ 201, 400, 404, 500, 503 ].each do |status|
+      stub_webhook status: status, body: "Deployed", content_type: "text/plain"
+
+      assert_no_difference -> { Message.count } do
+        deliver
+      end
+    end
+  end
+
+test "a webhook that answers with an error is logged, without its URL or the bot's code" do
+  stub_webhook status: 500
+  Rails.logger.stubs(:info)
+  Rails.logger.expects(:info).with { |line| line.include?("answered 500") && !line.include?(WEBHOOK_URL) && !line.include?(@bot.code) }
+
+  deliver
+end
+
+  test "redirects aren't followed" do
+    stub_request(:post, WEBHOOK_URL).to_return(status: 302, headers: { location: "https://elsewhere.example.com/hook" })
+    stub_request(:post, "https://elsewhere.example.com/hook").to_return(status: 200, body: "Deployed", headers: { "Content-Type" => "text/plain" })
+
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+
+    assert_not_requested :post, "https://elsewhere.example.com/hook"
+  end
+
+  test "webhooks at private addresses are never called" do
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example.com").raises(RestrictedHTTP::Violation, "private")
+
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "hosts that don't resolve are never called" do
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example.com").raises(Surfguard::Unresolvable)
+
+    assert_nothing_raised { deliver }
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "a webhook that times out posts nothing and doesn't raise" do
+    stub_request(:post, WEBHOOK_URL).to_timeout
+
+    assert_no_difference -> { Message.count } do
+      assert_nothing_raised { deliver }
+    end
+  end
+
+  test "a webhook that refuses the connection posts nothing and doesn't raise" do
+    stub_request(:post, WEBHOOK_URL).to_raise(Errno::ECONNREFUSED)
+
+    assert_no_difference -> { Message.count } do
+      assert_nothing_raised { deliver }
+    end
+  end
+
+  test "a reply that is too large posts nothing" do
+    stub_webhook body: "a" * (Bot::Webhook::MAX_REPLY_SIZE + 1), content_type: "text/plain"
+
+    assert_no_difference -> { Message.count } do
+      assert_nothing_raised { deliver }
+    end
+  end
+
+  test "a bot that has left the room can't post into it" do
+    @bot.user.memberships.where(room: @room).delete_all
+    stub_webhook body: "Deployed", content_type: "text/plain"
+
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+  end
+
+  private
+    def deliver
+      Bot::Webhook.new(@bot, @message).deliver
+    end
+
+    def stub_webhook(status: 200, body: nil, content_type: nil)
+      headers = content_type ? { "Content-Type" => content_type } : {}
+      stub_request(:post, WEBHOOK_URL).to_return(status: status, body: body, headers: headers)
+    end
+
+    def mention_message(body)
+      @room.messages.create!(creator: users(:kevin), body: "<div>#{body}</div>")
+    end
+end
