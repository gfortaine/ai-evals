@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = webhook_delinquency_trackers(:active)
+  end
+
+  test "a failed delivery starts a streak" do
+    @tracker.record(failed_delivery)
+
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+    assert_not_nil @tracker.first_failure_at
+    assert @webhook.reload.active?
+  end
+
+  test "a successful delivery ends the streak" do
+    5.times { @tracker.record(failed_delivery) }
+    @tracker.record(successful_delivery)
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "deactivates the webhook after ten consecutive failures spanning over an hour" do
+    now = Time.current
+    travel_to now
+
+    10.times { @tracker.record(failed_delivery) }
+    assert @webhook.reload.active?, "ten failures in the same instant do not span an hour"
+
+    travel_to now + 1.hour + 1.second
+    @tracker.record(failed_delivery)
+
+    assert_not @webhook.reload.active?
+  end
+
+  test "keeps the webhook active with ten failures inside the first hour" do
+    now = Time.current
+    travel_to now
+
+    10.times { @tracker.record(failed_delivery) }
+
+    travel_to now + 59.minutes
+    @tracker.record(failed_delivery)
+
+    assert @webhook.reload.active?
+  end
+
+  test "keeps the webhook active with fewer than ten failures over an hour" do
+    now = Time.current
+    travel_to now
+
+    8.times { @tracker.record(failed_delivery) }
+
+    travel_to now + 2.hours
+    @tracker.record(failed_delivery)
+
+    assert @webhook.reload.active?
+  end
+
+  test "a success restarts the count before the next deactivation check" do
+    now = Time.current
+    travel_to now
+
+    9.times { @tracker.record(failed_delivery) }
+    @tracker.record(successful_delivery)
+
+    travel_to now + 2.hours
+    9.times { @tracker.record(failed_delivery) }
+
+    assert @webhook.reload.active?
+  end
+
+  test "reset clears the streak" do
+    9.times { @tracker.record(failed_delivery) }
+    @tracker.reset
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  private
+    def failed_delivery
+      Webhook::Delivery.new(webhook: @webhook, event: events(:layout_commented), state: :errored, response: { error: "destination_unreachable" })
+    end
+
+    def successful_delivery
+      Webhook::Delivery.new(webhook: @webhook, event: events(:layout_commented), state: :completed, response: { code: 200 })
+    end
+end
