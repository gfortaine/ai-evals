+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveJob::TestCase
+  PUBLIC_IP = "93.184.216.34"
+
+  setup do
+    @webhook = webhooks(:active)
+    @delivery = Webhook::Delivery.create!(webhook: @webhook, event: events(:layout_commented))
+    stub_dns_resolution(PUBLIC_IP)
+    @request = stub_request(:post, @webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 200)
+  end
+
+  test "delivers the event" do
+    Webhook::DeliveryJob.perform_now(@delivery)
+
+    assert_requested @request
+    assert @delivery.reload.completed?
+  end
+
+  test "runs on the webhooks queue" do
+    assert_equal "webhooks", Webhook::DeliveryJob.new.queue_name
+  end
+
+  test "a job that runs again does not send the event again" do
+    Webhook::DeliveryJob.perform_now(@delivery)
+    Webhook::DeliveryJob.perform_now(@delivery)
+
+    assert_requested @request, times: 1
+  end
+
+  test "discards jobs whose delivery has been removed" do
+    Webhook::DeliveryJob.perform_later(@delivery)
+    @delivery.delete
+
+    assert_nothing_raised do
+      perform_enqueued_jobs
+    end
+
+    assert_not_requested @request
+  end
+end
