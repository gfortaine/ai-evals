 class Webhook::Delivery < ApplicationRecord
+  class DestinationUnreachable < StandardError; end
+
+  RETENTION = 1.week
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+  WRITE_TIMEOUT = 10
+
+  UNREACHABLE_ERRORS = [
+    DestinationUnreachable,
+    SocketError,
+    SystemCallError,
+    IOError,
+    OpenSSL::SSL::SSLError,
+    Net::ProtocolError,
+    Net::HTTPBadResponse,
+    Resolv::ResolvError
+  ].freeze
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +29,29 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  class << self
+    def cleanup
+      where(created_at: ...RETENTION.ago).in_batches.delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later self
+  end
+
+  # Sends at most once: the delivery is claimed before any request goes out,
+  # and failed attempts are never retried.
+  def deliver
+    if claim
+      if webhook.active?
+        transmit
+        webhook.delinquency_tracker.record(self)
+      else
+        update! state: :errored, response: { error: "webhook_inactive" }
+      end
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -29,4 +71,64 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      self.class.pending.where(id: id).update_all(state: "in_progress", updated_at: Time.current) == 1
+    end
+
+    def transmit
+      body = payload
+      headers = request_headers(body)
+      self.request = { headers: headers }
+
+      update! state: :completed, response: { code: post(body, headers).code.to_i }
+    rescue Timeout::Error
+      update! state: :errored, response: { error: "timeout" }
+    rescue *UNREACHABLE_ERRORS
+      update! state: :errored, response: { error: "destination_unreachable" }
+    rescue StandardError
+      update! state: :errored, response: { error: "unexpected_error" }
+      raise
+    end
+
+    def payload
+      renderer.render template: "webhooks/event", formats: [ :json ], assigns: { event: event }
+    end
+
+    def renderer
+      ApplicationController.renderer.new(script_name: account.slug, **url_host_options)
+    end
+
+    def url_host_options
+      options = Rails.application.routes.default_url_options.presence || Rails.application.config.action_mailer.default_url_options || {}
+
+      { http_host: options.values_at(:host, :port).compact.join(":"), https: options[:protocol] == "https" }
+    end
+
+    def request_headers(body)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3),
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+    end
+
+    def post(body, headers)
+      uri = URI(webhook.url)
+      address = SsrfProtection.resolve_public_ip(uri.hostname)
+      raise DestinationUnreachable, "#{uri.hostname} does not resolve to a public address" unless address
+
+      http = Net::HTTP.new(uri.hostname, uri.port)
+      http.ipaddr = address
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+      http.write_timeout = WRITE_TIMEOUT
+
+      http_request = Net::HTTP::Post.new(uri.request_uri, headers)
+      http_request.body = body
+      http.request(http_request)
+    end
 end
