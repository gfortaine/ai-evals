+++ b/test/integration/webhook_delivery_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class WebhookDeliveryTest < ActiveSupport::TestCase
+  PUBLIC_IP = "93.184.216.34"
+
+  setup do
+    @webhook = webhooks(:active)
+    stub_dns_resolution(PUBLIC_IP)
+    stub_request(:post, @webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 500)
+  end
+
+  test "a receiver that keeps failing for over an hour is switched off" do
+    now = Time.current
+    travel_to now
+
+    events = Array.new(10) { publish_event }
+    assert @webhook.reload.active?
+
+    travel_to now + 1.hour + 1.second
+    events << publish_event
+
+    assert_not @webhook.reload.active?
+
+    deliveries = Webhook::Delivery.where(webhook: @webhook, event: events)
+    assert_equal events.size, deliveries.count
+    assert deliveries.all?(&:failed?)
+  end
+
+  test "each event is sent to the receiver once" do
+    event = publish_event
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert_requested :post, @webhook.url, times: 1
+    assert_equal 1, Webhook::Delivery.where(webhook: @webhook, event: event).count
+  end
+
+  private
+    def publish_event
+      event = boards(:writebook).events.create!(action: "card_published", creator: users(:david), eventable: cards(:logo), account: accounts("37s"), particulars: {})
+      perform_enqueued_jobs only: Webhook::DeliveryJob
+      event
+    end
+end
diff --git a/test/jobs/webhook/delivery_job_test.rb b/test/jobs/webhook/delivery_job_test.rb
