diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..f37798a 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -64,4 +64,34 @@ self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
 
+// Web push: show the same text the tray shows, and open the card when tapped
+self.addEventListener("push", (event) => {
+  const { title, body, url, tag } = event.data.json()
+
+  event.waitUntil(self.registration.showNotification(title, {
+    body,
+    tag,
+    renotify: true,
+    icon: "/app-icon-192.png",
+    data: { url }
+  }))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openNotificationUrl(event.notification.data.url))
+})
+
+async function openNotificationUrl(url) {
+  const clients = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+  const client = clients.find((candidate) => new URL(candidate.url).origin === self.location.origin)
+
+  if (client) {
+    await client.navigate(url)
+    return client.focus()
+  } else {
+    return self.clients.openWindow(url)
+  }
+}
+
 TurboOffline.start()
