diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..ea46af9
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,75 @@
+class Push::Subscription < ApplicationRecord
+  TIME_TO_LIVE = 1.day
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :validate_endpoint, if: :will_save_change_to_endpoint?
+
+  class << self
+    def enabled?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"]
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"]
+    end
+
+    def register(user:, endpoint:, p256dh_key:, auth_key:, user_agent:)
+      transaction do
+        # A browser subscription belongs to whoever is signed in on that browser,
+        # so take it away from any other identity that had it before.
+        where(endpoint: endpoint).where.not(user: user.identity.users).delete_all
+
+        find_or_initialize_by(user: user, endpoint: endpoint).tap do |subscription|
+          subscription.assign_attributes(p256dh_key: p256dh_key, auth_key: auth_key, user_agent: user_agent)
+          subscription.save!(context: :register)
+        end
+      end
+    end
+  end
+
+  def push(payload)
+    WebPush.payload_send(
+      message: payload,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      ttl: TIME_TO_LIVE.to_i,
+      vapid: vapid_options
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy!
+  # A device that can't be reached right now shouldn't stop the others from getting the push.
+  rescue WebPush::ResponseError, Timeout::Error, SocketError, SystemCallError, OpenSSL::SSL::SSLError => error
+    Rails.error.report(error, handled: true, severity: :warning, context: { push_subscription_id: id })
+  end
+
+  private
+    def vapid_options
+      {
+        subject: "mailto:#{Mail::Address.new(ApplicationMailer.default_params[:from]).address}",
+        public_key: self.class.vapid_public_key,
+        private_key: self.class.vapid_private_key
+      }
+    end
+
+    # Only browser registration checks the host, so importing old subscriptions
+    # doesn't look up DNS for every endpoint.
+    def validate_endpoint
+      uri = URI.parse(endpoint)
+
+      if uri.scheme != "https" || uri.host.blank?
+        errors.add :endpoint, "must be an https URL"
+      elsif validation_context == :register && SsrfProtection.resolve_public_ip(uri.host).nil?
+        errors.add :endpoint, "must point to a public host"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "is not a URL"
+    end
+end
