@@ -0,0 +1,27 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user, :ensure_current_user
+
+  def create
+    Push::Subscription.register(user: @user, user_agent: request.user_agent, **subscription_params)
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Notifications turned on for this device" }
+      format.json { head :no_content }
+    end
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_entity
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ]).to_h.symbolize_keys
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..c09e9ae
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,71 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+// Turns on push notifications for the device in use. The browser grants
+// permission and issues a push subscription; we hand that subscription to Fizzy
+// so notifications can be delivered to this device.
+export default class extends Controller {
+  static targets = [ "details", "enable" ]
+  static values = { vapidPublicKey: String, subscriptionsUrl: String }
+
+  async connect() {
+    const subscription = await this.#subscription()
+    if (subscription) await this.#register(subscription)
+
+    this.#render(subscription)
+  }
+
+  async enable() {
+    if (await Notification.requestPermission() === "granted") {
+      const subscription = await this.#subscribe()
+      const response = await this.#register(subscription)
+
+      // Don't claim notifications are on if Fizzy couldn't take the subscription
+      if (!response.ok) await subscription.unsubscribe()
+    }
+
+    this.#render(await this.#subscription())
+  }
+
+  async #subscription() {
+    if (!pushSupported() || Notification.permission !== "granted") return null
+
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  async #subscribe() {
+    const registration = await navigator.serviceWorker.ready
+
+    return registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: base64UrlToUint8Array(this.vapidPublicKeyValue)
+    })
+  }
+
+  #register(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    return post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+  }
+
+  #render(subscription) {
+    const blocked = pushSupported() && Notification.permission === "denied"
+
+    this.element.classList.toggle("notifications--on", !!subscription)
+    this.enableTarget.hidden = !pushSupported() || blocked || !!subscription
+    this.detailsTargets.forEach(details => details.hidden = !blocked)
+  }
+}
+
+function pushSupported() {
+  return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+}
+
+function base64UrlToUint8Array(base64Url) {
+  const base64 = base64Url.replace(/-/g, "+").replace(/_/g, "/").padEnd(Math.ceil(base64Url.length / 4) * 4, "=")
+  return Uint8Array.from(atob(base64), char => char.charCodeAt(0))
+}
