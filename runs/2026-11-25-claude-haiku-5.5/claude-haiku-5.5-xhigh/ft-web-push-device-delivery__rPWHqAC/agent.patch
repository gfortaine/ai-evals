diff --git a/test/system/notifications_settings_test.rb b/test/system/notifications_settings_test.rb
new file mode 100644
index 0000000..3092ba6
--- /dev/null
+++ b/test/system/notifications_settings_test.rb
@@ -0,0 +1,110 @@
+require "application_system_test_case"
+
+class NotificationsSettingsTest < ApplicationSystemTestCase
+  # Headless Chromium can't reach a push service, so PushManager is stubbed in the page.
+  # Everything else (permission, the Stimulus controller, the request to Fizzy) is real.
+  setup do
+    key = WebPush.generate_key
+    Push::Subscription.stubs(:vapid_public_key).returns(key.public_key)
+    Push::Subscription.stubs(:vapid_private_key).returns(key.private_key)
+    SsrfProtection.stubs(:resolve_public_ip).returns("93.184.216.34")
+
+    sign_in_as users(:david)
+  end
+
+  teardown do
+    page.driver.browser.execute_cdp("Browser.resetPermissions") rescue nil
+    remove_fake_push_api
+  end
+
+  test "a browser that has not decided yet is offered the button, without the help for blocked browsers" do
+    add_fake_push_api(subscribed: false)
+    visit notifications_settings_url
+
+    assert_button "Turn on notifications"
+    assert_no_selector "[data-notifications-target=details]", visible: :visible
+  end
+
+  test "turning on notifications for this device hands the subscription to Fizzy" do
+    add_fake_push_api(subscribed: false)
+    visit notifications_settings_url
+    grant_notification_permission
+
+    click_on "Turn on notifications"
+
+    assert_text "Notifications are on for this device."
+    assert_equal 1, users(:david).push_subscriptions.count
+    assert_equal "auth-key", users(:david).push_subscriptions.last.auth_key
+  end
+
+  test "a device that is already subscribed is kept in sync each time settings are visited" do
+    add_fake_push_api(subscribed: true)
+    visit notifications_settings_url
+    grant_notification_permission
+    visit notifications_settings_url
+
+    assert_text "Notifications are on for this device."
+    assert_equal 1, users(:david).push_subscriptions.count
+  end
+
+  test "a subscription Fizzy refuses is not shown as turned on" do
+    SsrfProtection.stubs(:resolve_public_ip).returns(nil)
+    add_fake_push_api(subscribed: false)
+    visit notifications_settings_url
+    grant_notification_permission
+
+    click_on "Turn on notifications"
+
+    assert_button "Turn on notifications"
+    assert_no_text "Notifications are on for this device."
+    assert_equal 0, users(:david).push_subscriptions.count
+  end
+
+  test "browsers that block notifications are shown how to turn them back on" do
+    add_fake_push_api(subscribed: false)
+    visit notifications_settings_url
+    deny_notification_permission
+    visit notifications_settings_url
+
+    assert_text "Turn on notifications for this website."
+    assert_no_button "Turn on notifications"
+    assert_equal 0, users(:david).push_subscriptions.count
+  end
+
+  private
+    def add_fake_push_api(subscribed:)
+      @fake_push_script_id = page.driver.browser.execute_cdp(
+        "Page.addScriptToEvaluateOnNewDocument", source: fake_push_api(subscribed: subscribed)
+      )["identifier"]
+    end
+
+    def fake_push_api(subscribed:)
+      <<~JS
+        window.__pushSubscribed = #{subscribed}
+        const subscription = {
+          endpoint: "https://push.example.com/send/browser",
+          toJSON() { return { endpoint: this.endpoint, keys: { p256dh: "p256-key", auth: "auth-key" } } },
+          async unsubscribe() { window.__pushSubscribed = false; return true }
+        }
+        PushManager.prototype.subscribe = async () => { window.__pushSubscribed = true; return subscription }
+        PushManager.prototype.getSubscription = async () => window.__pushSubscribed ? subscription : null
+      JS
+    end
+
+    def remove_fake_push_api
+      return unless @fake_push_script_id
+      page.driver.browser.execute_cdp("Page.removeScriptToEvaluateOnNewDocument", identifier: @fake_push_script_id)
+      @fake_push_script_id = nil
+    end
+
+    def grant_notification_permission
+      page.driver.browser.execute_cdp("Browser.grantPermissions", origin: page.evaluate_script("location.origin"), permissions: [ "notifications" ])
+      visit notifications_settings_url
+    end
+
+    def deny_notification_permission
+      page.driver.browser.execute_cdp("Browser.setPermission",
+        origin: page.evaluate_script("location.origin"),
+        permission: { name: "notifications" }, setting: "denied")
+    end
+end
