+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+
+    SsrfProtection.stubs(:resolve_public_ip).returns("93.184.216.34")
+  end
+
+  test "create stores this device's subscription for the signed in user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :no_content
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/send/abc123", subscription.endpoint
+    assert_equal "p256-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal accounts("37s"), subscription.account
+  end
+
+  test "create from a form redirects back to the notification settings" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }
+
+    assert_redirected_to notifications_settings_path
+    assert_equal "Notifications turned on for this device", flash[:notice]
+  end
+
+  test "creating again for the same device does not duplicate it" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params.merge(auth_key: "rotated") }, as: :json
+    end
+
+    assert_equal "rotated", @user.push_subscriptions.last.auth_key
+  end
+
+  test "users cannot subscribe devices for someone else" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "an endpoint that is not https is rejected" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params.merge(endpoint: "http://push.example.com/send/abc123") }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "a request without a subscription is a bad request" do
+    post user_push_subscriptions_path(@user), params: {}, as: :json
+
+    assert_response :bad_request
+  end
+
+  private
+    def subscription_params
+      { endpoint: "https://push.example.com/send/abc123", p256dh_key: "p256-key", auth_key: "auth-key" }
+    end
+end
diff --git a/test/models/notification/push_test.rb b/test/models/notification/push_test.rb
new file mode 100644
index 0000000..85ead7e
--- /dev/null
+++ b/test/models/notification/push_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class Notification::PushTest < ActiveSupport::TestCase
+  setup do
+    SsrfProtection.stubs(:resolve_public_ip).returns("93.184.216.34")
+    Push::Subscription.stubs(:vapid_public_key).returns("public-key")
+    Push::Subscription.stubs(:vapid_private_key).returns("private-key")
+
+    users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.com/kevin", p256dh_key: "p256", auth_key: "auth")
+  end
+
+  test "a notification that lands in the tray queues a push for the user" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notifier.for(events(:layout_commented)).notify
+    end
+  end
+
+  test "nothing is queued for users without a subscription" do
+    users(:kevin).push_subscriptions.delete_all
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notifier.for(events(:layout_commented)).notify
+    end
+  end
+
+  test "nothing is queued when push is not configured" do
+    Push::Subscription.stubs(:enabled?).returns(false)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notifier.for(events(:layout_commented)).notify
+    end
+  end
+
+  test "new activity on an existing notification pushes again" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_enqueued_with(job: Notification::PushJob, args: [ notification ]) do
+      notification.update!(source: events(:layout_published))
+    end
+  end
+
+  test "marking a notification read or unread does not push" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "the push says what the tray says and opens the comment it's about" do
+    comment = comments(:layout_overflowing_david)
+
+    payload = pushed_payload_for(notifications(:layout_commented_kevin))
+
+    assert_equal "RE: Layout is broken", payload["title"]
+    assert_equal comment.body.to_plain_text.truncate(200), payload["body"]
+    assert_equal card_url(cards(:layout), anchor: ActionView::RecordIdentifier.dom_id(comment)), payload["url"]
+    assert_equal "card-#{cards(:layout).id}", payload["tag"]
+  end
+
+  test "a mention says who mentioned the user and opens where they were mentioned" do
+    users(:david).push_subscriptions.create!(endpoint: "https://push.example.com/david", p256dh_key: "p256", auth_key: "auth")
+    notification = notifications(:logo_mentioned_david)
+    mention = notification.source
+
+    payload = pushed_payload_for(notification)
+
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", payload["title"]
+    assert_equal mention.source.mentionable_content.truncate(200), payload["body"]
+    assert_equal card_url(cards(:logo), anchor: ActionView::RecordIdentifier.dom_id(mention.source)), payload["url"]
+  end
+
+  test "the push job delivers the notification" do
+    notification = notifications(:layout_commented_kevin)
+
+    Notification.any_instance.expects(:deliver_push)
+
+    Notification::PushJob.perform_now(notification)
+  end
+
+  private
+    def pushed_payload_for(notification)
+      payload = nil
+      Push::Subscription.any_instance.expects(:push).with { |json| payload = JSON.parse(json) }
+
+      notification.deliver_push
+
+      payload
+    end
+
+    def card_url(card, **options)
+      Rails.application.routes.url_helpers.card_url(card, host: "example.com", script_name: accounts("37s").slug, **options)
+    end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..55eb6d2
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,176 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  ENDPOINT = "https://push.example.com/send/abc123".freeze
+
+  setup do
+    @user = users(:david)
+    SsrfProtection.stubs(:resolve_public_ip).returns("93.184.216.34")
+    Push::Subscription.stubs(:vapid_public_key).returns("public-key")
+    Push::Subscription.stubs(:vapid_private_key).returns("private-key")
+  end
+
+  test "enabled only when both VAPID keys are configured" do
+    assert Push::Subscription.enabled?
+
+    Push::Subscription.stubs(:vapid_private_key).returns(nil)
+    assert_not Push::Subscription.enabled?
+  end
+
+  test "register stores the browser's subscription for the user and their account" do
+    subscription = register
+
+    assert_equal @user, subscription.user
+    assert_equal accounts("37s"), subscription.account
+    assert_equal "p256-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal "Chrome", subscription.user_agent
+  end
+
+  test "registering the same endpoint again updates the keys instead of duplicating" do
+    register
+    register(p256dh_key: "new-p256", auth_key: "new-auth")
+
+    assert_equal 1, @user.push_subscriptions.where(endpoint: ENDPOINT).count
+    assert_equal "new-p256", @user.push_subscriptions.find_by(endpoint: ENDPOINT).p256dh_key
+  end
+
+  test "registering takes the endpoint away from other identities that had it" do
+    Push::Subscription.register(user: users(:kevin), **subscription_attributes)
+    register
+
+    assert_not users(:kevin).push_subscriptions.exists?(endpoint: ENDPOINT)
+    assert @user.push_subscriptions.exists?(endpoint: ENDPOINT)
+  end
+
+  test "registering keeps the endpoint for other accounts of the same identity" do
+    other_account_user = User.create!(account: accounts("initech"), identity: @user.identity, name: "David")
+
+    register
+    Push::Subscription.register(user: other_account_user, **subscription_attributes)
+
+    assert @user.push_subscriptions.exists?(endpoint: ENDPOINT)
+    assert other_account_user.push_subscriptions.exists?(endpoint: ENDPOINT)
+  end
+
+  test "a rejected registration leaves other identities' subscriptions alone" do
+    Push::Subscription.register(user: users(:kevin), **subscription_attributes)
+
+    assert_raises ActiveRecord::RecordInvalid do
+      register(endpoint: "http://push.example.com/send/abc123")
+    end
+
+    assert users(:kevin).push_subscriptions.exists?(endpoint: ENDPOINT)
+  end
+
+  test "endpoints must be https" do
+    assert_raises(ActiveRecord::RecordInvalid) { register(endpoint: "http://push.example.com/send/abc123") }
+  end
+
+  test "endpoints must not point at non-public hosts" do
+    SsrfProtection.stubs(:resolve_public_ip).returns(nil)
+
+    assert_raises(ActiveRecord::RecordInvalid) { register(endpoint: "https://intranet.example.com/send/abc123") }
+  end
+
+  test "creating a subscription directly, as importing old ones does, doesn't look up its host" do
+    SsrfProtection.expects(:resolve_public_ip).never
+
+    subscription = @user.push_subscriptions.create!(endpoint: ENDPOINT, p256dh_key: "p256-key", auth_key: "auth-key")
+
+    assert subscription.persisted?
+  end
+
+  test "endpoints must be URLs" do
+    assert_raises(ActiveRecord::RecordInvalid) { register(endpoint: "not a url") }
+  end
+
+  test "push sends the payload to the endpoint, signed with the VAPID keys" do
+    subscription = register
+
+    WebPush.expects(:payload_send).with(has_entries(
+      message: '{"title":"Hi"}',
+      endpoint: ENDPOINT,
+      p256dh: "p256-key",
+      auth: "auth-key",
+      vapid: has_entries(public_key: "public-key", private_key: "private-key", subject: "mailto:support@fizzy.do")
+    ))
+
+    subscription.push('{"title":"Hi"}')
+  end
+
+  test "push posts an encrypted message that the push service can verify came from us" do
+    vapid_key = WebPush.generate_key
+    Push::Subscription.stubs(:vapid_public_key).returns(vapid_key.public_key)
+    Push::Subscription.stubs(:vapid_private_key).returns(vapid_key.private_key)
+
+    browser_key = OpenSSL::PKey::EC.generate("prime256v1")
+    subscription = register(
+      p256dh_key: WebPush.encode64(browser_key.public_key.to_bn.to_s(2)),
+      auth_key: WebPush.encode64(SecureRandom.random_bytes(16))
+    )
+    stub_request(:post, ENDPOINT).to_return(status: 201)
+
+    subscription.push('{"title":"Hi"}')
+
+    assert_requested :post, ENDPOINT do |request|
+      request.headers["Content-Encoding"] == "aes128gcm" &&
+        request.headers["Ttl"] == 1.day.to_i.to_s &&
+        request.headers["Authorization"].match?(/\Avapid t=[^,]+,k=#{vapid_key.public_key.delete("=")}\z/)
+    end
+  end
+
+  test "push removes the subscription when the push service says it has expired" do
+    subscription = register
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(push_service_response, "push.example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      subscription.push("{}")
+    end
+  end
+
+  test "push removes the subscription when the push service says it is invalid" do
+    subscription = register
+    WebPush.stubs(:payload_send).raises(WebPush::InvalidSubscription.new(push_service_response, "push.example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      subscription.push("{}")
+    end
+  end
+
+  test "push reports a device it cannot reach without stopping the others" do
+    subscription = register
+    WebPush.stubs(:payload_send).raises(Net::OpenTimeout)
+
+    Rails.error.expects(:report).with(instance_of(Net::OpenTimeout), handled: true, severity: :warning, context: { push_subscription_id: subscription.id })
+
+    assert_no_difference -> { Push::Subscription.count } do
+      subscription.push("{}")
+    end
+  end
+
+  test "push keeps the subscription and reports other push service failures" do
+    subscription = register
+    error = WebPush::PushServiceError.new(push_service_response, "push.example.com")
+    WebPush.stubs(:payload_send).raises(error)
+
+    Rails.error.expects(:report).with(error, handled: true, severity: :warning, context: { push_subscription_id: subscription.id })
+
+    assert_no_difference -> { Push::Subscription.count } do
+      subscription.push("{}")
+    end
+  end
+
+  private
+    def push_service_response
+      stub("push service response", body: "")
+    end
+
+    def register(**overrides)
+      Push::Subscription.register(user: @user, **subscription_attributes, **overrides)
+    end
+
+    def subscription_attributes
+      { endpoint: ENDPOINT, p256dh_key: "p256-key", auth_key: "auth-key", user_agent: "Chrome" }
+    end
+end
