new file mode 100644
index 0000000..e67c0e0
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,18 @@
+class ActivitiesController < ApplicationController
+  # The HTML timeline's kinds, minus the deprecated collection moves, plus title changes
+  ACTIONS = Event::TIMELINEABLE_ACTIONS - %w[ card_collection_changed ] + %w[ card_title_changed ]
+
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      filters = params.permit(creator_ids: [], board_ids: [])
+
+      events = Current.user.accessible_events.preloaded.where(action: ACTIONS).reverse_chronologically
+      events = events.where(creator_id: filters[:creator_ids]) if filters[:creator_ids].present?
+      events = events.where(board_id: filters[:board_ids]) if filters[:board_ids].present?
+      events
+    end
+end
diff --git a/app/helpers/activities_helper.rb b/app/helpers/activities_helper.rb
new file mode 100644
index 0000000..b918085
--- /dev/null
+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,18 @@
+module ActivitiesHelper
+  def activity_particulars(event)
+    details = event.particulars.fetch("particulars", {})
+
+    case event.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: event.assignee_ids }
+    when "card_board_changed"
+      { old_board: details["old_board"].to_s, new_board: details["new_board"].to_s }
+    when "card_title_changed"
+      { old_title: details["old_title"].to_s, new_title: details["new_title"].to_s }
+    when "card_triaged"
+      { column: details["column"].to_s }
+    else
+      {}
+    end
+  end
+end
