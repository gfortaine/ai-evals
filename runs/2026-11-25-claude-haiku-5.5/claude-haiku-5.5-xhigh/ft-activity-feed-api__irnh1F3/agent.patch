+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,296 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_equal writebook_event_ids, @response.parsed_body.pluck("id")
+  end
+
+  test "index defaults to JSON" do
+    get activities_path
+
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+  end
+
+  test "index with an API access token" do
+    sign_out
+    token = identity_access_tokens(:davids_api_token).token
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{token}" }
+
+    assert_response :success
+    assert_equal writebook_event_ids, @response.parsed_body.pluck("id")
+
+    event = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+    assert_equal events(:logo_published).description_for(users(:david)).to_plain_text, event["description"]
+  end
+
+  test "index requires authentication" do
+    sign_out
+
+    get activities_path(format: :json)
+
+    assert_response :redirect
+    assert_match %r{/session/new}, @response.location
+  end
+
+  test "index rejects HTML" do
+    get activities_path(format: :html)
+
+    assert_response :not_acceptable
+  end
+
+  test "events include the expected attributes" do
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+
+    assert_equal %w[ board created_at creator description eventable eventable_type id particulars action url ].sort, event.keys.sort
+    assert_equal "card_published", event["action"]
+    assert_equal events(:logo_published).created_at.utc.iso8601(3), event["created_at"]
+    assert_equal({}, event["particulars"])
+    assert_equal "Card", event["eventable_type"]
+    assert_equal cards(:logo).id, event["eventable"]["id"]
+    assert_equal cards(:logo).title, event["eventable"]["title"]
+    assert_equal boards(:writebook).id, event["board"]["id"]
+    assert_equal users(:david).id, event["creator"]["id"]
+  end
+
+  test "description is the plain-text form for the current user" do
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+    expected = events(:logo_published).description_for(users(:kevin)).to_plain_text
+
+    assert_equal expected, event["description"]
+    assert_not_includes event["description"], "<"
+  end
+
+  test "card events link to the card" do
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+
+    assert_equal polymorphic_url(cards(:logo)), event["url"]
+  end
+
+  test "comment events link to the comment on its card" do
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:layout_commented).id }
+    comment = events(:layout_commented).eventable
+
+    assert_equal "Comment", event["eventable_type"]
+    assert_equal comment.id, event["eventable"]["id"]
+    assert_equal polymorphic_url(comment), event["url"]
+    assert_includes event["url"], "##{ActionView::RecordIdentifier.dom_id(comment)}"
+    assert event["url"].start_with?(polymorphic_url(comment.card))
+  end
+
+  test "omits deprecated collection changes" do
+    events(:logo_published).update_columns(action: "card_collection_changed")
+
+    get activities_path, as: :json
+
+    assert_not_includes @response.parsed_body.pluck("id"), events(:logo_published).id
+  end
+
+  test "includes title changes" do
+    events(:logo_published).update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } })
+
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+
+    assert_equal "card_title_changed", event["action"]
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, event["particulars"])
+  end
+
+  test "particulars for assignments" do
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:logo_assignment_jz).id }
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, event["particulars"])
+  end
+
+  test "particulars for unassignments" do
+    events(:logo_assignment_jz).update_columns(action: "card_unassigned")
+
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:logo_assignment_jz).id }
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, event["particulars"])
+  end
+
+  test "particulars for board changes" do
+    events(:logo_published).update_columns(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "Writebook", "new_board" => "Private board" } })
+
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, event["particulars"])
+  end
+
+  test "particulars for board changes with missing values are empty strings" do
+    events(:logo_published).update_columns(action: "card_board_changed", particulars: {})
+
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, event["particulars"])
+  end
+
+  test "particulars for title changes with missing values are empty strings" do
+    events(:logo_published).update_columns(action: "card_title_changed", particulars: {})
+
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+
+    assert_equal({ "old_title" => "", "new_title" => "" }, event["particulars"])
+  end
+
+  test "particulars for triage" do
+    events(:logo_published).update_columns(action: "card_triaged", particulars: { "particulars" => { "column" => "Writing" } })
+
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+
+    assert_equal({ "column" => "Writing" }, event["particulars"])
+  end
+
+  test "particulars for triage with a missing column are an empty string" do
+    events(:logo_published).update_columns(action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+
+    assert_equal({ "column" => "" }, event["particulars"])
+  end
+
+  test "particulars are empty for other events" do
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:shipping_closed).id }
+
+    assert_equal({}, event["particulars"])
+  end
+
+  test "only includes activity on boards the user can access" do
+    events(:logo_published).update_columns(board_id: boards(:private).id)
+
+    get activities_path, as: :json
+    assert_includes @response.parsed_body.pluck("id"), events(:logo_published).id
+
+    logout_and_sign_in_as :david
+
+    get activities_path, as: :json
+    assert_not_includes @response.parsed_body.pluck("id"), events(:logo_published).id
+  end
+
+  test "filters by board_ids" do
+    events(:logo_published).update_columns(board_id: boards(:private).id)
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+
+    assert_equal [ events(:logo_published).id ], @response.parsed_body.pluck("id")
+  end
+
+  test "board_ids cannot reveal activity on boards the user cannot access" do
+    events(:logo_published).update_columns(board_id: boards(:private).id)
+    logout_and_sign_in_as :david
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "filters by creator_ids" do
+    events(:logo_published).update_columns(creator_id: users(:jz).id)
+
+    get activities_path, params: { creator_ids: [ users(:jz).id ] }, as: :json
+
+    assert_equal [ events(:logo_published).id ], @response.parsed_body.pluck("id")
+  end
+
+  test "filters by creator_ids and board_ids together" do
+    events(:logo_published).update_columns(creator_id: users(:jz).id)
+    events(:logo_published).update_columns(board_id: boards(:private).id)
+
+    get activities_path, params: { creator_ids: [ users(:jz).id ], board_ids: [ boards(:writebook).id ] }, as: :json
+
+    assert_empty @response.parsed_body
+  end
+
+  test "paginates newest first following Link headers" do
+    create_events(20)
+
+    expected_ids = Event.where(board: boards(:writebook)).reverse_chronologically.pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "reports the total count" do
+    get activities_path, as: :json
+
+    assert_equal writebook_event_ids.size.to_s, @response.headers["X-Total-Count"]
+  end
+
+  private
+    def writebook_event_ids
+      Event.where(board: boards(:writebook)).reverse_chronologically.pluck(:id)
+    end
+
+    def create_events(count)
+      now = Time.current
+      rows = Array.new(count) do |index|
+        {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: accounts("37s").id,
+          board_id: boards(:writebook).id,
+          creator_id: users(:david).id,
+          eventable_id: cards(:logo).id,
+          eventable_type: "Card",
+          action: "card_published",
+          particulars: {},
+          created_at: now - index.minutes,
+          updated_at: now - index.minutes
+        }
+      end
+
+      Event.insert_all(rows)
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
