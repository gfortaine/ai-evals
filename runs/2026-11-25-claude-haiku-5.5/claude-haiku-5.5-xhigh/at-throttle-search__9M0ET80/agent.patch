diff --git a/app/controllers/books/searches_controller.rb b/app/controllers/books/searches_controller.rb
index 5268c55..dca8b65 100644
--- a/app/controllers/books/searches_controller.rb
+++ b/app/controllers/books/searches_controller.rb
@@ -3,7 +3,21 @@ class Books::SearchesController < ApplicationController
 
   include BookScoped
 
+  # Anyone can search a published book without signing in, so one address could
+  # otherwise run full-text queries against every book as fast as it likes.
+  SEARCH_LIMITER = SlidingWindowLimiter.new(name: "book-search", limit: 30, window: 1.minute)
+
+  before_action :refuse_when_over_search_limit, only: :create
+
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
+
+  private
+    def refuse_when_over_search_limit
+      unless SEARCH_LIMITER.allow?(request.remote_ip)
+        response.headers["Retry-After"] = SEARCH_LIMITER.window.to_s
+        render :rate_limited, status: :too_many_requests
+      end
+    end
 end
