@@ -0,0 +1,29 @@
+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+
+    @book = books(:manual)
+    @book.update!(title: "Working Title")
+
+    sign_in :david
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "releasing a book shows the released title in Recently updated" do
+    patch book_release_url(@book), params: { book: { title: "Final Title" } }
+    assert_redirected_to root_url
+
+    get root_url
+
+    assert_response :success
+    assert_select ".library__recents strong", text: "Final Title"
+    assert_select ".library__recents strong", text: "Working Title", count: 0
+    assert_select ".library__recents span", text: "Published"
+  end
+end
diff --git a/test/models/book/recap_test.rb b/test/models/book/recap_test.rb
new file mode 100644
index 0000000..1e83dec
--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "saving a book caches its recap" do
+    books(:manual).update!(title: "Renamed")
+
+    assert_equal({ title: "Renamed", published: false }, books(:manual).cached_recap)
+  end
+
+  test "finalizing a release caches the recap with the released title" do
+    books(:manual).update!(title: "Working Title")
+
+    assert Book.finalize_release(books(:manual).id, title: "Final Title")
+
+    assert_equal({ title: "Final Title", published: true }, books(:manual).cached_recap)
+  end
+
+  test "finalizing a release leaves other books' recaps alone" do
+    books(:handbook).update!(title: "Handbook Recap")
+    books(:manual).update!(title: "Working Title")
+
+    Book.finalize_release(books(:manual).id, title: "Final Title")
+
+    assert_equal({ title: "Handbook Recap", published: false }, books(:handbook).cached_recap)
+    assert_equal({ title: "Final Title", published: true }, books(:manual).cached_recap)
+  end
+
+  test "finalizing a release of a published book does nothing" do
+    books(:manual).update!(title: "Published Title", published: true)
+
+    assert_not Book.finalize_release(books(:manual).id, title: "Other Title")
+
+    assert_equal({ title: "Published Title", published: true }, books(:manual).cached_recap)
+  end
+
+  test "recaps expire on the configured schedule" do
+    books(:manual).update!(title: "Renamed")
+    expires_in = Rails.application.config.x.recap.expires_in
+
+    travel_to Time.current + expires_in - 1.minute
+    assert_equal "Renamed", books(:manual).cached_recap[:title]
+
+    travel_to Time.current + expires_in + 1.minute
+    assert_nil books(:manual).cached_recap
+  end
+end
