diff --git a/lib/rails_ext/active_storage_variation.rb b/lib/rails_ext/active_storage_variation.rb
new file mode 100644
index 0000000..0b9441f
--- /dev/null
+++ b/lib/rails_ext/active_storage_variation.rb
@@ -0,0 +1,18 @@
+# Variant records are looked up by ActiveStorage::Variation#digest, which hashes Marshal.dump of the
+# transformations. Marshal tells the symbol :webp apart from the string "webp", but a reader's
+# request only ever has the string, because the variation's signed URL key is JSON. The background
+# job and the first reader therefore got different digests for the same variation, and every upload
+# was derived twice, with both copies kept.
+#
+# Hash the JSON form instead, which is the form readers already decode. Copies recorded by earlier
+# reader requests keep their digests, so they are still found.
+module ActiveStorage::VariationDigest
+  def digest
+    OpenSSL::Digest::SHA1.base64digest Marshal.dump(json_transformations)
+  end
+
+  private
+    def json_transformations
+      JSON.parse(transformations.to_json, symbolize_names: true)
+    end
+end
diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..2307f99 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -38,4 +38,58 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "an uploaded picture is derived once by the background job and served without processing" do
+    perform_enqueued_jobs do
+      post book_pictures_path(books(:handbook)), params: {
+        leaf: { title: "Rabbit" },
+        picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") } }
+    end
+
+    leaf = books(:handbook).leaves.order(:id).last
+    picture = leaf.leafable
+    assert_equal 1, ActiveStorage::VariantRecord.where(blob: picture.image.blob).count
+
+    assert_equal 0, count_transformations { get leafable_slug_path(leaf) }
+    image_path = css_select("figure.page--picture img").first["src"]
+
+    assert_equal 0, count_transformations { fetch_redirected image_path }
+    assert_equal 1, ActiveStorage::VariantRecord.where(blob: picture.image.blob).count
+    assert_equal large_webp_of(picture), response.body.b
+  end
+
+  test "a picture the background job has not derived is derived once, on first read" do
+    leaf = leaves(:reading_picture)
+    picture = leaf.leafable
+    assert_equal 0, ActiveStorage::VariantRecord.where(blob: picture.image.blob).count
+
+    get leafable_slug_path(leaf)
+    image_path = css_select("figure.page--picture img").first["src"]
+
+    assert_equal 1, count_transformations { fetch_redirected image_path }
+    assert_equal 0, count_transformations { fetch_redirected image_path }
+    assert_equal 1, ActiveStorage::VariantRecord.where(blob: picture.image.blob).count
+    assert_equal large_webp_of(picture), response.body.b
+  end
+
+  private
+    def count_transformations
+      count = 0
+      subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { count += 1 }
+      yield
+      count
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+
+    def fetch_redirected(path)
+      get path
+      follow_redirect! while response.redirect?
+    end
+
+    def large_webp_of(picture)
+      picture.image.open do |original|
+        ActiveStorage::Variation.new(resize_to_limit: [ 1500, 1500 ], format: :webp).transform(original) { |output| output.read.b }
+      end
+    end
 end
diff --git a/test/lib/active_storage_variation_test.rb b/test/lib/active_storage_variation_test.rb
new file mode 100644
index 0000000..47ffb33
--- /dev/null
+++ b/test/lib/active_storage_variation_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class ActiveStorageVariationTest < ActiveSupport::TestCase
+  test "digest is the same whether a value is a symbol or the string a reader's request decodes" do
+    job = ActiveStorage::Variation.new(format: :webp, resize_to_limit: [ 1500, 1500 ])
+    reader = ActiveStorage::Variation.new(format: "webp", resize_to_limit: [ 1500, 1500 ])
+
+    assert_equal job.digest, reader.digest
+  end
+
+  test "digest of a picture's large variation is the same as the digest of its URL key" do
+    variation = pictures(:reading).large_image.variation
+
+    assert_equal variation.digest, ActiveStorage::Variation.decode(variation.key).digest
+  end
+
+  test "digest of a picture's large variation is unchanged for the copies reader requests have recorded" do
+    assert_equal "2iK4D6Pm4TeLcj8qTmXCQ2guK3c=", pictures(:reading).large_image.variation.digest
+  end
+
+  test "digest differs for different transformations" do
+    large = ActiveStorage::Variation.new(format: :webp, resize_to_limit: [ 1500, 1500 ])
+
+    assert_not_equal large.digest, ActiveStorage::Variation.new(format: :webp, resize_to_limit: [ 800, 800 ]).digest
+    assert_not_equal large.digest, ActiveStorage::Variation.new(format: :png, resize_to_limit: [ 1500, 1500 ]).digest
+  end
+end
