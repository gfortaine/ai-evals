diff --git a/test/lib/users_erase_task_test.rb b/test/lib/users_erase_task_test.rb
new file mode 100644
index 0000000..a8180ec
--- /dev/null
+++ b/test/lib/users_erase_task_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+require "rake"
+
+class UsersEraseTaskTest < ActiveSupport::TestCase
+  setup do
+    Rails.application.load_tasks unless Rake::Task.task_defined?("users:erase")
+    @task = Rake::Task["users:erase"]
+  end
+
+  teardown do
+    ENV.delete("EMAIL")
+    @task.reenable
+  end
+
+  test "erases the person who signed in with the address" do
+    users(:kevin).sessions.start! user_agent: "Test", ip_address: "127.0.0.1"
+    ENV["EMAIL"] = "kevin@example.com"
+
+    capture_io { @task.invoke }
+
+    assert_not User.exists?(users(:kevin).id)
+    assert_equal 0, SignInEvent.for_address("kevin@example.com").count
+  end
+
+  test "erases an account that was already deactivated, found by its original address" do
+    user = users(:kevin)
+    user.update! active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com"
+    ENV["EMAIL"] = "kevin@example.com"
+
+    capture_io { @task.invoke }
+
+    assert_not User.exists?(user.id)
+  end
+
+  test "refuses when no one signed in with the address" do
+    ENV["EMAIL"] = "nobody@example.com"
+
+    assert_raises(SystemExit) { capture_io { @task.invoke } }
+    assert User.exists?(users(:kevin).id)
+  end
+end
