@@ -0,0 +1,34 @@
+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  setup do
+    @magic_link = MagicLink.create!(email_address: "kevin@37signals.com")
+  end
+
+  test "sign-in code goes to the address it was requested for" do
+    email = IdentityMailer.sign_in_code(@magic_link)
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+  end
+
+  test "code is in the subject so it shows in a notification" do
+    email = IdentityMailer.sign_in_code(@magic_link)
+
+    assert_equal "#{@magic_link.code} is your Fizzy sign-in code", email.subject
+  end
+
+  test "code and expiry are in the body" do
+    email = IdentityMailer.sign_in_code(@magic_link)
+
+    assert_match @magic_link.code, email.text_part.body.to_s
+    assert_match @magic_link.code, email.html_part.body.to_s
+    assert_match "15 minutes", email.text_part.body.to_s
+  end
+
+  test "has both HTML and text parts" do
+    email = IdentityMailer.sign_in_code(@magic_link)
+
+    assert email.html_part.present?, "Email should have HTML part"
+    assert email.text_part.present?, "Email should have text part"
+  end
+end
