diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..821261d
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,69 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    magic_link = pending_magic_link
+
+    if identity = magic_link&.redeem(params[:code])
+      cookies.delete :pending_authentication_token
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to after_sign_in_url(magic_link, identity) }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+
+    def pending_magic_link
+      MagicLink.find_by_pending_authentication_token(cookies[:pending_authentication_token])
+    end
+
+    def after_sign_in_url(magic_link, identity)
+      if magic_link.join_account?
+        after_joining_url(magic_link, identity)
+      elsif magic_link.sign_up?
+        new_signup_completion_path
+      else
+        after_authentication_url
+      end
+    end
+
+    # Joins the account the link was issued for, then points at the next step for that account
+    def after_joining_url(magic_link, identity)
+      join_code = magic_link.account_join_code
+      account = join_code.account
+
+      if user = join_code.redeem_for(identity)
+        if user.setup?
+          landing_url(script_name: account.slug)
+        else
+          new_users_verification_url(script_name: account.slug)
+        end
+      else
+        join_path(code: join_code.code, script_name: account.slug)
+      end
+    end
+end
