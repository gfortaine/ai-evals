diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..4fdd612
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,82 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  # Crockford base32: no I, L, O or U, so codes read back clearly
+  CODE_ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ".freeze
+  EXPIRY_DURATION = 15.minutes
+  MAX_ATTEMPTS = 5
+
+  belongs_to :account_join_code, class_name: "Account::JoinCode", optional: true
+
+  enum :purpose, %w[ sign_in sign_up join_account ].index_by(&:itself), default: :sign_in
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :account_join_code, presence: true, if: :join_account?
+
+  before_create :generate_code, :set_expiry
+
+  def self.find_by_pending_authentication_token(token)
+    find_signed(token, purpose: :pending_authentication)
+  end
+
+  def self.cleanup
+    where(expires_at: ...Time.current).delete_all
+  end
+
+  def pending_authentication_token
+    signed_id(purpose: :pending_authentication, expires_at: expires_at)
+  end
+
+  def send_code_later
+    IdentityMailer.sign_in_code(self).deliver_later
+  end
+
+  # Returns the identity to sign in as, or nil if the code is wrong, expired or
+  # there's no identity to sign in as. A code is used up once it signs someone in.
+  def redeem(submitted_code)
+    if expired?
+      nil
+    elsif matches?(submitted_code)
+      if identity = identity_to_sign_in
+        destroy!
+        identity
+      end
+    else
+      record_failed_attempt
+      nil
+    end
+  end
+
+  private
+    def generate_code
+      self.code = Array.new(CODE_LENGTH) { CODE_ALPHABET[SecureRandom.random_number(CODE_ALPHABET.length)] }.join
+    end
+
+    def set_expiry
+      self.expires_at = EXPIRY_DURATION.from_now
+    end
+
+    def expired?
+      expires_at.past?
+    end
+
+    def matches?(submitted_code)
+      ActiveSupport::SecurityUtils.secure_compare(code, submitted_code.to_s.gsub(/\s/, "").upcase)
+    end
+
+    def record_failed_attempt
+      increment!(:attempts)
+      destroy! if attempts >= MAX_ATTEMPTS
+    end
+
+    # Signing in only works for an existing identity. Signing up and joining prove
+    # ownership of the address with the code, so they create the identity if needed.
+    def identity_to_sign_in
+      if sign_in?
+        Identity.find_by(email_address: email_address)
+      else
+        Identity.find_or_create_by!(email_address: email_address)
+      end
+    end
+end
