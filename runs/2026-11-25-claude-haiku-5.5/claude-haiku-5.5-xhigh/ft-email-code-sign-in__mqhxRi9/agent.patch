diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..bc1c0d4
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "code is six characters from the unambiguous alphabet" do
+    magic_link = MagicLink.create!(email_address: @identity.email_address)
+
+    assert_match(/\A[0-9ABCDEFGHJKMNPQRSTVWXYZ]{6}\z/, magic_link.code)
+  end
+
+  test "codes are different each time" do
+    codes = Array.new(20) { MagicLink.create!(email_address: @identity.email_address).code }
+
+    assert_operator codes.uniq.size, :>, 15
+  end
+
+  test "codes expire after fifteen minutes" do
+    freeze_time do
+      magic_link = MagicLink.create!(email_address: @identity.email_address)
+
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+    end
+  end
+
+  test "email address is normalized" do
+    magic_link = MagicLink.create!(email_address: "  Kevin@37Signals.COM ")
+
+    assert_equal "kevin@37signals.com", magic_link.email_address
+  end
+
+  test "invalid email address is rejected" do
+    magic_link = MagicLink.new(email_address: "not-an-email")
+
+    assert_not magic_link.valid?
+    assert magic_link.errors[:email_address].any?
+  end
+
+  test "join links need an account join code" do
+    magic_link = MagicLink.new(email_address: "someone@example.com", purpose: :join_account)
+
+    assert_not magic_link.valid?
+    assert magic_link.errors[:account_join_code].any?
+  end
+
+  test "redeeming the right code for an existing identity signs in as that identity and uses the code up" do
+    magic_link = MagicLink.create!(email_address: @identity.email_address)
+
+    assert_equal @identity, magic_link.redeem(magic_link.code)
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+
+  test "a code can only be redeemed once" do
+    magic_link = MagicLink.create!(email_address: @identity.email_address)
+
+    magic_link.redeem(magic_link.code)
+
+    assert_nil MagicLink.find_by(id: magic_link.id)&.redeem(magic_link.code)
+  end
+
+  test "the code is matched regardless of case and spacing" do
+    magic_link = MagicLink.create!(email_address: @identity.email_address)
+    typed = " #{magic_link.code[0, 3].downcase} #{magic_link.code[3..].downcase} "
+
+    assert_equal @identity, magic_link.redeem(typed)
+  end
+
+  test "a wrong code doesn't sign in" do
+    magic_link = MagicLink.create!(email_address: @identity.email_address)
+
+    assert_nil magic_link.redeem(wrong_code_for(magic_link))
+    assert MagicLink.exists?(magic_link.id), "a wrong guess shouldn't use up the code"
+  end
+
+  test "a code is used up after too many wrong guesses" do
+    magic_link = MagicLink.create!(email_address: @identity.email_address)
+
+    (MagicLink::MAX_ATTEMPTS - 1).times { magic_link.redeem(wrong_code_for(magic_link)) }
+    assert MagicLink.exists?(magic_link.id)
+
+    magic_link.redeem(wrong_code_for(magic_link))
+
+    assert_not MagicLink.exists?(magic_link.id)
+    assert_nil MagicLink.find_by(id: magic_link.id)&.redeem(magic_link.code)
+  end
+
+  test "an expired code doesn't sign in" do
+    magic_link = MagicLink.create!(email_address: @identity.email_address)
+
+    travel 15.minutes + 1.second do
+      assert_nil magic_link.redeem(magic_link.code)
+    end
+  end
+
+  test "signing in for an address without an identity doesn't create one" do
+    magic_link = MagicLink.create!(email_address: "nobody@example.com")
+
+    assert_no_difference -> { Identity.count } do
+      assert_nil magic_link.redeem(magic_link.code)
+    end
+  end
+
+  test "signing up creates the identity once the code is redeemed" do
+    magic_link = MagicLink.create!(email_address: "new.person@example.com", purpose: :sign_up)
+
+    assert_difference -> { Identity.count }, 1 do
+      assert_equal "new.person@example.com", magic_link.redeem(magic_link.code).email_address
+    end
+  end
+
+  test "joining returns the existing identity without creating another" do
+    magic_link = MagicLink.create!(
+      email_address: @identity.email_address, purpose: :join_account, account_join_code: account_join_codes(:"37s")
+    )
+
+    assert_no_difference -> { Identity.count } do
+      assert_equal @identity, magic_link.redeem(magic_link.code)
+    end
+  end
+
+  test "pending authentication token finds the link until it expires" do
+    magic_link = MagicLink.create!(email_address: @identity.email_address)
+    token = magic_link.pending_authentication_token
+
+    assert_equal magic_link, MagicLink.find_by_pending_authentication_token(token)
+
+    travel 15.minutes + 1.second do
+      assert_nil MagicLink.find_by_pending_authentication_token(token)
+    end
+  end
+
+  test "pending authentication token is missing or invalid" do
+    assert_nil MagicLink.find_by_pending_authentication_token(nil)
+    assert_nil MagicLink.find_by_pending_authentication_token("made-up-token")
+  end
+
+  test "cleanup removes expired links and keeps current ones" do
+    expired = MagicLink.create!(email_address: @identity.email_address)
+    travel 16.minutes do
+      current = MagicLink.create!(email_address: @identity.email_address)
+
+      MagicLink.cleanup
+
+      assert_not MagicLink.exists?(expired.id)
+      assert MagicLink.exists?(current.id)
+    end
+  end
+
+  private
+    def wrong_code_for(magic_link)
+      (MagicLink::CODE_ALPHABET.chars.find { |char| char != magic_link.code[0] }) + magic_link.code[1..]
+    end
+end
