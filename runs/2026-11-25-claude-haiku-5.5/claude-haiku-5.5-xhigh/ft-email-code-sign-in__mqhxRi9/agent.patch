index 0000000..bc4c085
--- /dev/null
+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,229 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+  end
+
+  test "new" do
+    untenanted do
+      get new_session_magic_link_path
+    end
+
+    assert_response :success
+    assert_select "input[name=code]"
+  end
+
+  test "create signs in with the code that was emailed" do
+    magic_link = request_sign_in_code(@identity.email_address)
+
+    untenanted do
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to landing_path
+    end
+
+    assert cookies[:session_token].present?
+    assert_not cookies[:pending_authentication_token].present?
+    assert_not MagicLink.exists?(magic_link.id), "the code should be used up"
+  end
+
+  test "create signs in as the identity that owns the code, even if it was requested with other capitalization" do
+    magic_link = request_sign_in_code(" KEVIN@37signals.com ")
+
+    untenanted do
+      post session_magic_link_path, params: { code: magic_link.code.downcase }
+    end
+
+    assert_equal @identity, Session.last.identity
+  end
+
+  test "create with the wrong code" do
+    magic_link = request_sign_in_code(@identity.email_address)
+
+    untenanted do
+      post session_magic_link_path, params: { code: wrong_code_for(magic_link) }
+
+      assert_redirected_to new_session_magic_link_path
+    end
+
+    assert_equal "That code didn't work. Try again.", flash[:alert]
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create with a blank code is a wrong code, not a bad request" do
+    magic_link = request_sign_in_code(@identity.email_address)
+
+    untenanted do
+      post session_magic_link_path, params: { code: "   " }
+
+      assert_redirected_to new_session_magic_link_path
+    end
+
+    assert_equal "That code didn't work. Try again.", flash[:alert]
+    assert MagicLink.exists?(magic_link.id)
+  end
+
+  test "create without a pending code" do
+    untenanted do
+      post session_magic_link_path, params: { code: "ABC123" }
+
+      assert_redirected_to new_session_magic_link_path
+    end
+
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create with an expired code" do
+    magic_link = request_sign_in_code(@identity.email_address)
+
+    travel 16.minutes do
+      untenanted do
+        post session_magic_link_path, params: { code: magic_link.code }
+      end
+    end
+
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create with a code that has already been used" do
+    magic_link = request_sign_in_code(@identity.email_address)
+    pending_token = cookies[:pending_authentication_token]
+
+    untenanted do
+      post session_magic_link_path, params: { code: magic_link.code }
+    end
+    sign_out
+
+    cookies[:pending_authentication_token] = pending_token
+    untenanted do
+      post session_magic_link_path, params: { code: magic_link.code }
+    end
+
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create for an identity that doesn't exist" do
+    magic_link = request_sign_in_code("nobody@example.com")
+
+    assert_no_difference -> { Identity.count } do
+      untenanted do
+        post session_magic_link_path, params: { code: magic_link.code }
+      end
+    end
+
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create via JSON returns a session token" do
+    magic_link = request_sign_in_code(@identity.email_address)
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: magic_link.code }
+    end
+
+    assert_response :success
+    assert @response.parsed_body["session_token"].present?
+  end
+
+  test "create via JSON with the wrong code" do
+    magic_link = request_sign_in_code(@identity.email_address)
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: wrong_code_for(magic_link) }
+    end
+
+    assert_response :unauthorized
+    assert_not @response.parsed_body.key?("session_token")
+  end
+
+  test "create signing up goes on to complete the sign-up" do
+    magic_link = MagicLink.create!(email_address: "new.person@example.com", purpose: :sign_up)
+    set_pending_authentication magic_link
+
+    assert_difference -> { Identity.count }, 1 do
+      untenanted do
+        post session_magic_link_path, params: { code: magic_link.code }
+
+        assert_redirected_to new_signup_completion_path
+      end
+    end
+  end
+
+  test "create joining an account adds the identity to it and goes on to set up the user" do
+    identity = identities(:mike)
+    magic_link = MagicLink.create!(email_address: identity.email_address, purpose: :join_account, account_join_code: @join_code)
+    set_pending_authentication magic_link
+
+    assert_difference -> { @account.users.count }, 1 do
+      untenanted do
+        post session_magic_link_path, params: { code: magic_link.code }
+
+        assert_redirected_to new_users_verification_url(script_name: @account.slug)
+      end
+    end
+
+    assert_equal identity, @account.users.find_by!(identity: identity).identity
+    assert cookies[:session_token].present?
+  end
+
+  test "create joining an account for an existing member goes straight to the account" do
+    identity = identities(:jz)
+    magic_link = MagicLink.create!(email_address: identity.email_address, purpose: :join_account, account_join_code: @join_code)
+    set_pending_authentication magic_link
+
+    assert_no_difference -> { User.count } do
+      untenanted do
+        post session_magic_link_path, params: { code: magic_link.code }
+
+        assert_redirected_to landing_url(script_name: @account.slug)
+      end
+    end
+  end
+
+  test "create joining an account with a code that's all used up doesn't join" do
+    @join_code.update!(usage_count: @join_code.usage_limit)
+    identity = identities(:mike)
+    magic_link = MagicLink.create!(email_address: identity.email_address, purpose: :join_account, account_join_code: @join_code)
+    set_pending_authentication magic_link
+
+    assert_no_difference -> { User.count } do
+      untenanted do
+        post session_magic_link_path, params: { code: magic_link.code }
+
+        assert_redirected_to join_path(code: @join_code.code, script_name: @account.slug)
+      end
+    end
+  end
+
+  test "create is rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post session_magic_link_path, params: { code: "ABC123" }
+
+      assert_redirected_to new_session_magic_link_path
+    end
+
+    assert_equal "Try again later.", flash[:alert]
+  end
+
+  private
+    def request_sign_in_code(email_address)
+      untenanted do
+        post session_path, params: { email_address: email_address }
+      end
+
+      MagicLink.last
+    end
+
+    def set_pending_authentication(magic_link)
+      cookies[:pending_authentication_token] = magic_link.pending_authentication_token
+    end
+
+    def wrong_code_for(magic_link)
+      (MagicLink::CODE_ALPHABET.chars.find { |char| char != magic_link.code[0] }) + magic_link.code[1..]
+    end
+end
