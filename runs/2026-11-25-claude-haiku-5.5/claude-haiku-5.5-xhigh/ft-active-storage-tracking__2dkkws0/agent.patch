+require "test_helper"
+
+class Board::BytesUsedTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "is zero when the board has no counted content" do
+    boards(:private).recalculate_bytes_used_now
+
+    assert_equal 0, boards(:private).reload.bytes_used
+  end
+
+  test "counts card images" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    perform_bytes_used_recalculations
+
+    assert_equal @card.image.blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in card descriptions" do
+    blob = upload_blob
+    @card.update!(description: "<p>See this</p>#{embed(blob)}")
+
+    perform_bytes_used_recalculations
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in comments" do
+    blob = upload_blob
+    @card.comments.create!(body: "Here it is #{embed(blob)}")
+
+    perform_bytes_used_recalculations
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in the board description" do
+    blob = upload_blob
+    @board.update!(public_description: "<p>Welcome</p>#{embed(blob)}")
+
+    perform_bytes_used_recalculations
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "sums distinct files across images, descriptions and comments" do
+    image = upload_blob("moon.jpg")
+    description_file = upload_blob("avatar.png")
+    comment_file = upload_blob("moon.jpg")
+
+    @card.image.attach(image)
+    @card.update!(description: embed(description_file))
+    @card.comments.create!(body: embed(comment_file))
+
+    perform_bytes_used_recalculations
+
+    assert_equal image.byte_size + description_file.byte_size + comment_file.byte_size, @board.reload.bytes_used
+  end
+
+  test "counts a file embedded in several places on the board only once" do
+    blob = upload_blob
+    @card.update!(description: embed(blob))
+    @card.comments.create!(body: embed(blob))
+    @card.image.attach(blob)
+
+    perform_bytes_used_recalculations
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "ignores content on other boards" do
+    private_card = boards(:private).cards.create!(title: "Private notes", creator: users(:david), status: "published")
+    private_card.update!(description: embed(upload_blob))
+
+    perform_bytes_used_recalculations
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_operator boards(:private).reload.bytes_used, :>, 0
+  end
+
+  test "ignores attachments that are not card or board content" do
+    assert_no_enqueued_jobs only: Board::RecalculateBytesUsedJob do
+      users(:david).avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    end
+
+    perform_bytes_used_recalculations
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "removing a card image lowers the board's bytes_used" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    perform_bytes_used_recalculations
+
+    @card.remove_image
+    perform_bytes_used_recalculations
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "replacing a card image updates the board's bytes_used" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    perform_bytes_used_recalculations
+
+    replacement = upload_blob("avatar.png")
+    @card.image.attach(replacement)
+    perform_bytes_used_recalculations
+
+    assert_equal replacement.byte_size, @board.reload.bytes_used
+  end
+
+  test "removing a file from a description updates the board's bytes_used" do
+    @card.update!(description: embed(upload_blob))
+    perform_bytes_used_recalculations
+
+    @card.update!(description: "<p>No files now</p>")
+    perform_bytes_used_recalculations
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "destroying a card removes its files from the board" do
+    @card.update!(description: embed(upload_blob))
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    perform_bytes_used_recalculations
+    assert_operator @board.reload.bytes_used, :>, 0
+
+    @card.destroy!
+    perform_bytes_used_recalculations
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "destroying a comment removes its files from the board" do
+    comment = @card.comments.create!(body: embed(upload_blob))
+    perform_bytes_used_recalculations
+    assert_operator @board.reload.bytes_used, :>, 0
+
+    comment.destroy!
+    perform_bytes_used_recalculations
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "moving a card moves its files to the new board" do
+    blob = upload_blob
+    @card.update!(description: embed(blob))
+    perform_bytes_used_recalculations
+
+    @card.move_to(boards(:private))
+    perform_bytes_used_recalculations
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal blob.byte_size, boards(:private).reload.bytes_used
+  end
+
+  test "calculates in the background rather than when the file is attached" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    assert_equal 0, @board.reload.bytes_used
+
+    perform_bytes_used_recalculations
+
+    assert_equal @card.image.blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "a change made while a recalculation is running schedules another recalculation" do
+    @board.update_column :bytes_used_stale, true
+    card = @card
+    late_comment_html = embed(upload_blob)
+    @board.define_singleton_method(:calculate_bytes_used) do
+      card.comments.create!(body: late_comment_html)
+      0
+    end
+
+    assert_enqueued_jobs 1, only: Board::RecalculateBytesUsedJob do
+      @board.recalculate_bytes_used_now
+    end
+
+    assert @board.reload.bytes_used_stale
+  end
+
+  test "a burst of changes to a board schedules a single recalculation" do
+    assert_enqueued_jobs 1, only: Board::RecalculateBytesUsedJob do
+      @card.update!(description: embed(upload_blob("moon.jpg")) + embed(upload_blob("avatar.png")))
+    end
+  end
+
+  test "changes made while a recalculation is pending do not schedule another one" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    assert_no_enqueued_jobs only: Board::RecalculateBytesUsedJob do
+      @card.comments.create!(body: embed(upload_blob))
+    end
+  end
+
+  test "recalculating clears the stale flag" do
+    @board.update_column :bytes_used_stale, true
+
+    @board.recalculate_bytes_used_now
+
+    assert_not @board.reload.bytes_used_stale
+  end
+
+  test "clears the stale flag before calculating so that changes during the calculation are not lost" do
+    @board.update_column :bytes_used_stale, true
+    stale_while_calculating = nil
+    @board.define_singleton_method(:calculate_bytes_used) do
+      stale_while_calculating = Board.find(id).bytes_used_stale
+      0
+    end
+
+    @board.recalculate_bytes_used_now
+
+    assert_equal false, stale_while_calculating
+  end
+
+  test "recalculate_stale_bytes_used_later enqueues recalculations for stale boards only" do
+    @board.update_column :bytes_used_stale, true
+
+    assert_enqueued_jobs 1, only: Board::RecalculateBytesUsedJob do
+      Board.recalculate_stale_bytes_used_later
+    end
+
+    assert_not @board.reload.bytes_used_stale
+    assert_no_enqueued_jobs only: Board::RecalculateBytesUsedJob do
+      Board.recalculate_stale_bytes_used_later
+    end
+  end
+
+  private
+    def upload_blob(filename = "moon.jpg")
+      ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture(filename).open,
+        filename: filename,
+        content_type: filename.end_with?(".png") ? "image/png" : "image/jpeg"
+      )
+    end
+
+    def embed(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+
+    def perform_bytes_used_recalculations
+      perform_enqueued_jobs only: Board::RecalculateBytesUsedJob
+    end
+end
