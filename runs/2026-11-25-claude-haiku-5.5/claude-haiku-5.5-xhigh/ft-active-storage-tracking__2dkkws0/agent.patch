new file mode 100644
index 0000000..6db6b86
--- /dev/null
+++ b/app/models/board/bytes_used.rb
@@ -0,0 +1,57 @@
+module Board::BytesUsed
+  extend ActiveSupport::Concern
+
+  included do
+    scope :bytes_used_stale, -> { where(bytes_used_stale: true) }
+
+    after_destroy_commit -> { account&.recalculate_bytes_used_now }
+  end
+
+  class_methods do
+    # Enqueues a recalculation for every board flagged as stale, clearing the flag as it goes.
+    # Changes that land after a flag is cleared flag the board again and schedule their own pass.
+    def recalculate_stale_bytes_used_later
+      bytes_used_stale.find_in_batches(batch_size: 500) do |boards|
+        where(id: boards.map(&:id)).update_all(bytes_used_stale: false)
+        ActiveJob.perform_all_later(boards.map { Board::RecalculateBytesUsedJob.new(it) })
+      end
+    end
+  end
+
+  def bytes_used_board
+    self
+  end
+
+  # Flags the board as stale and enqueues a recalculation unless one is already pending.
+  # Call it after the change has been committed, so the recalculation sees it.
+  def recalculate_bytes_used_later
+    Board::RecalculateBytesUsedJob.perform_later(self) if mark_bytes_used_stale
+  end
+
+  def recalculate_bytes_used_now
+    update_column :bytes_used_stale, false
+    update_column :bytes_used, calculate_bytes_used
+    account.recalculate_bytes_used_now
+  end
+
+  private
+    def mark_bytes_used_stale
+      Board.where(id: id, bytes_used_stale: false).update_all(bytes_used_stale: true) > 0
+    end
+
+    def calculate_bytes_used
+      ActiveStorage::Blob.where(id: counted_attachments.select(:blob_id)).sum(:byte_size)
+    end
+
+    # Card images, plus files embedded in card descriptions, comments and the board description.
+    def counted_attachments
+      ActiveStorage::Attachment.where(record_type: "Card", name: "image", record_id: cards.select(:id))
+        .or(ActiveStorage::Attachment.where(record_type: ActionText::RichText.name, name: "embeds", record_id: counted_rich_texts.select(:id)))
+    end
+
+    def counted_rich_texts
+      ActionText::RichText.where(record_type: "Card", name: "description", record_id: cards.select(:id))
+        .or(ActionText::RichText.where(record_type: "Comment", name: "body", record_id: Comment.where(card_id: cards.select(:id)).select(:id)))
+        .or(ActionText::RichText.where(record_type: "Board", name: "public_description", record_id: id))
+    end
+end
