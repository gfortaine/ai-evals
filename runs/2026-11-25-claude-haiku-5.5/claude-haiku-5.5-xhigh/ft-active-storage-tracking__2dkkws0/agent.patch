@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Board::RecalculateBytesUsedJobTest < ActiveJob::TestCase
+  test "recalculates the bytes used by the board" do
+    board = boards(:writebook)
+    image = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    cards(:logo).image.attach(image)
+
+    Board::RecalculateBytesUsedJob.perform_now(board)
+
+    assert_equal image.byte_size, board.reload.bytes_used
+  end
+
+  test "discards recalculations for boards that no longer exist" do
+    board = boards(:private)
+    board.recalculate_bytes_used_later
+
+    board.destroy!
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Board::RecalculateBytesUsedJob
+    end
+  end
+
+  test "allows only one recalculation per board at a time" do
+    first_board = boards(:writebook)
+    second_board = boards(:private)
+
+    assert_equal 1, Board::RecalculateBytesUsedJob.concurrency_limit
+    assert_equal Board::RecalculateBytesUsedJob.new(first_board).concurrency_key,
+      Board::RecalculateBytesUsedJob.new(first_board).concurrency_key
+    assert_not_equal Board::RecalculateBytesUsedJob.new(first_board).concurrency_key,
+      Board::RecalculateBytesUsedJob.new(second_board).concurrency_key
+  end
+end
diff --git a/test/models/account/bytes_used_test.rb b/test/models/account/bytes_used_test.rb
