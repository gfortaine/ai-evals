--- /dev/null
+++ b/app/models/card/bytes_used.rb
@@ -0,0 +1,32 @@
+module Card::BytesUsed
+  extend ActiveSupport::Concern
+
+  included do
+    # Moving a card changes the bytes_used of both boards, so both are recalculated once the move commits.
+    before_update :remember_board_id_before_move, if: :will_save_change_to_board_id?
+    after_commit :recalculate_bytes_used_of_moved_boards
+    after_destroy_commit -> { bytes_used_board&.recalculate_bytes_used_later }
+  end
+
+  def bytes_used_board
+    board
+  end
+
+  # Purging skips the attachment callbacks, so the board is recalculated explicitly.
+  def remove_image
+    image.purge_later
+    bytes_used_board.recalculate_bytes_used_later
+  end
+
+  private
+    def remember_board_id_before_move
+      @board_id_before_move = board_id_in_database
+    end
+
+    def recalculate_bytes_used_of_moved_boards
+      if @board_id_before_move
+        Board.where(id: [ @board_id_before_move, board_id ]).each(&:recalculate_bytes_used_later)
+        @board_id_before_move = nil
+      end
+    end
+end
