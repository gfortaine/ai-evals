+class Board::RecalculateBytesUsedJob < ApplicationJob
+  # Recalculations for a board never overlap, so the last one to finish reflects the latest changes.
+  limits_concurrency key: ->(board) { board }, duration: 1.hour
+  discard_on ActiveJob::DeserializationError
+
+  def perform(board)
+    board.recalculate_bytes_used_now
+  end
+end
