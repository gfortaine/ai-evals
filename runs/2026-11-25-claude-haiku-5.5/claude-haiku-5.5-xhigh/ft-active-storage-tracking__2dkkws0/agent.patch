+++ b/test/models/account/bytes_used_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Account::BytesUsedTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "is the sum of the bytes used by its boards" do
+    writebook_image = upload_blob
+    cards(:logo).image.attach(writebook_image)
+    private_card = boards(:private).cards.create!(title: "Notes", creator: users(:david), status: "published")
+    private_file = upload_blob("avatar.png")
+    private_card.update!(description: embed(private_file))
+
+    perform_bytes_used_recalculations
+
+    account = accounts("37s")
+    assert_equal writebook_image.byte_size + private_file.byte_size, account.reload.bytes_used
+    assert_equal writebook_image.byte_size, boards(:writebook).reload.bytes_used
+    assert_equal private_file.byte_size, boards(:private).reload.bytes_used
+  end
+
+  test "does not include other accounts" do
+    cards(:radio).image.attach(upload_blob)
+
+    perform_bytes_used_recalculations
+
+    assert_equal 0, accounts("37s").reload.bytes_used
+    assert_operator accounts("initech").reload.bytes_used, :>, 0
+  end
+
+  test "is zero for an account without boards" do
+    account = Account.create!(name: "Empty")
+
+    account.recalculate_bytes_used_now
+
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  test "is updated when a board is destroyed" do
+    cards(:logo).image.attach(upload_blob)
+    perform_bytes_used_recalculations
+    assert_operator accounts("37s").reload.bytes_used, :>, 0
+
+    boards(:writebook).destroy!
+
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  private
+    def upload_blob(filename = "moon.jpg")
+      ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture(filename).open,
+        filename: filename,
+        content_type: filename.end_with?(".png") ? "image/png" : "image/jpeg"
+      )
+    end
+
+    def embed(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+
+    def perform_bytes_used_recalculations
+      perform_enqueued_jobs only: Board::RecalculateBytesUsedJob
+    end
+end
