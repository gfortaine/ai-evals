@@ -0,0 +1,29 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Enter your code</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, placeholder: "Enter your six-character code…" %>
+      </label>
+    </div>
+
+    <%# Sign-in codes only go out to addresses that have an account, so don't promise an email. %>
+    <p><%= @magic_link.sign_in? ? "If there’s a Fizzy account for that email, we" : "We" %> emailed you a six-character code. It works for <%= distance_of_time_in_words_to_now(MagicLink::EXPIRATION.from_now) %>.</p>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <div class="margin-block-start">
+    <%= link_to "Use a different email", new_session_path, class: "btn btn--plain txt-link center txt-small" %>
+  </div>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
