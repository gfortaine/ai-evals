+module MagicLinkTestHelper
+  # Runs the block, delivers the code email it sends, and returns the code from the subject.
+  def code_emailed_by(&block)
+    ActionMailer::Base.deliveries.clear
+    perform_enqueued_jobs(&block)
+    ActionMailer::Base.deliveries.last.subject.split(" ").first
+  end
+end
