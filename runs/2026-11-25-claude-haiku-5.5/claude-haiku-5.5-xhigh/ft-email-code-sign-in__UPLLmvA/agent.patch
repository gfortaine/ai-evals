diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..10c9d4b
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,89 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  # No 0, 1, I, L or O, so a code can be read off the email without mixing them up.
+  CODE_CHARACTERS = "ABCDEFGHJKMNPQRSTUVWXYZ23456789".chars.freeze
+  EXPIRATION = 15.minutes
+  MAX_ATTEMPTS = 5
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  enum :purpose, %w[ sign_in sign_up join ].index_by(&:itself), scopes: false
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :join_code, presence: true, if: :join?
+
+  before_create :generate_code, :set_expiration
+  after_create_commit :send_code_later, if: :code_deliverable?
+
+  def self.find_by_pending_authentication_token(token)
+    find_signed(token, purpose: :pending_authentication)
+  end
+
+  def self.cleanup
+    where(expires_at: ...Time.current).delete_all
+  end
+
+  # Memoized so the cookie and the JSON body of one response carry the same token.
+  def pending_authentication_token
+    @pending_authentication_token ||= signed_id(purpose: :pending_authentication, expires_in: EXPIRATION)
+  end
+
+  # Returns the identity to sign in as, or nil when the code is wrong, used up or expired.
+  def redeem(code)
+    if !active?
+      nil
+    elsif matches?(code)
+      identity_to_sign_in if consume
+    else
+      record_failed_attempt
+      nil
+    end
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(CODE_LENGTH, chars: CODE_CHARACTERS)
+    end
+
+    def set_expiration
+      self.expires_at = EXPIRATION.from_now
+    end
+
+    def send_code_later
+      MagicLinkMailer.code(self).deliver_later
+    end
+
+    # Sign-in codes only go out to addresses that already have an identity. Sign-up and join codes
+    # go to anyone, and the identity is only created once the code has been entered.
+    def code_deliverable?
+      !sign_in? || Identity.exists?(email_address: email_address)
+    end
+
+    def active?
+      expires_at.future? && attempts < MAX_ATTEMPTS
+    end
+
+    def matches?(input)
+      ActiveSupport::SecurityUtils.secure_compare(input.to_s.gsub(/[^A-Za-z0-9]/, "").upcase, code)
+    end
+
+    # Deleting is what makes a code single-use. Checking the row count keeps two concurrent
+    # requests from both winning.
+    def consume
+      self.class.where(id: id).delete_all.positive?
+    end
+
+    def record_failed_attempt
+      increment!(:attempts)
+    end
+
+    def identity_to_sign_in
+      if sign_in?
+        Identity.find_by(email_address: email_address)
+      else
+        Identity.find_or_create_by!(email_address: email_address)
+      end
+    end
+end
