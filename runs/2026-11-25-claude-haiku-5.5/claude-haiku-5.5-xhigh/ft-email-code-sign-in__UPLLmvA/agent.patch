+    end
+
+    assert_response :success
+    assert_match "We emailed you a six-character code", @response.body
+  end
+
+  test "create signs in with the emailed code" do
+    code = request_sign_in_code
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to landing_path
+    end
+
+    assert cookies[:session_token].present?
+    assert_not cookies[:pending_authentication_token].present?
+  end
+
+  test "create accepts the code typed in lowercase" do
+    code = request_sign_in_code
+
+    untenanted do
+      post session_magic_link_path, params: { code: code.downcase }
+
+      assert_redirected_to landing_path
+    end
+
+    assert cookies[:session_token].present?
+  end
+
+  test "create with the wrong code does not sign in" do
+    code = request_sign_in_code
+
+    untenanted do
+      post session_magic_link_path, params: { code: wrong_code_for(code) }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+    end
+
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create with a code that has expired does not sign in" do
+    code = request_sign_in_code
+
+    travel_to MagicLink.last.expires_at + 1.second do
+      untenanted do
+        post session_magic_link_path, params: { code: code }
+      end
+    end
+
+    assert_not cookies[:session_token].present?
+  end
+
+  test "a code can only be used once" do
+    code = request_sign_in_code
+    pending_token = cookies[:pending_authentication_token]
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+    end
+    assert cookies[:session_token].present?
+
+    cookies[:pending_authentication_token] = pending_token
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+    end
+  end
+
+  test "five wrong codes retire the code, even if it is then entered correctly" do
+    code = request_sign_in_code
+
+    5.times do
+      untenanted do
+        post session_magic_link_path, params: { code: wrong_code_for(code) }
+      end
+    end
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+    end
+
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create via JSON returns a session token" do
+    code = code_emailed_by do
+      untenanted do
+        post session_path(format: :json), params: { email_address: @identity.email_address }
+      end
+    end
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: code }
+    end
+
+    assert_response :success
+    assert @response.parsed_body["session_token"].present?
+  end
+
+  test "create via JSON with the wrong code is unauthorized" do
+    code = request_sign_in_code(format: :json)
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: wrong_code_for(code) }
+    end
+
+    assert_response :unauthorized
+    assert_equal "That code didn't work. Try again.", @response.parsed_body["message"]
+  end
+
+  test "create is rate limited" do
+    request_sign_in_code
+
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post session_magic_link_path, params: { code: "ABCDEF" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+
+  private
+    def request_sign_in_code(format: :html)
+      code_emailed_by do
+        untenanted do
+          post session_path(format: format), params: { email_address: @identity.email_address }
+        end
+      end
+    end
+
+    def wrong_code_for(code)
+      code == "AAAAAA" ? "BBBBBB" : "AAAAAA"
+    end
+end
