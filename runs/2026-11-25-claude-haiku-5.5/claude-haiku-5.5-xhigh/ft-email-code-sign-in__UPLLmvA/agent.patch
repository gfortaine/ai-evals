diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..30febb1
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,66 @@
+class Sessions::MagicLinksController < ApplicationController
+  include JoinCodeRedirection
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @magic_link = pending_magic_link
+
+    if @magic_link.nil?
+      redirect_to new_session_path, alert: "Enter your email to get a code."
+    end
+  end
+
+  def create
+    magic_link = pending_magic_link
+
+    if identity = magic_link&.redeem(params[:code])
+      terminate_session if Current.session
+      start_new_session_for identity
+      cookies.delete :pending_authentication_token
+      joined_user = magic_link.join_code&.redeem_for(identity)
+
+      respond_to do |format|
+        format.html { redirect_to redirect_url_after_redeeming(magic_link, joined_user) }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: invalid_code_message }
+        format.json { render json: { message: invalid_code_message }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def invalid_code_message
+      "That code didn't work. Try again."
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+
+    def pending_magic_link
+      @pending_magic_link ||= MagicLink.find_by_pending_authentication_token(cookies[:pending_authentication_token])
+    end
+
+    def redirect_url_after_redeeming(magic_link, joined_user)
+      if magic_link.sign_up?
+        new_signup_completion_path(script_name: nil)
+      elsif magic_link.join?
+        url_after_joining(magic_link.join_code, joined_user)
+      else
+        after_authentication_url
+      end
+    end
+end
