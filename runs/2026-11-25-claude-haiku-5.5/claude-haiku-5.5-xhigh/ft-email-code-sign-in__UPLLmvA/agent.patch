diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..7b6af7d
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "code is six characters from the unambiguous alphabet" do
+    magic_link = MagicLink.create!(email_address: @identity.email_address, purpose: :sign_in)
+
+    assert_match(/\A[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}\z/, magic_link.code)
+  end
+
+  test "email address is normalized" do
+    magic_link = MagicLink.create!(email_address: "  Kevin@37Signals.com ", purpose: :sign_in)
+
+    assert_equal "kevin@37signals.com", magic_link.email_address
+  end
+
+  test "requires a valid email address" do
+    assert_not MagicLink.new(email_address: "not-an-email", purpose: :sign_in).valid?
+  end
+
+  test "join codes need a join code" do
+    assert_not MagicLink.new(email_address: "new@example.com", purpose: :join).valid?
+    assert MagicLink.new(email_address: "new@example.com", purpose: :join, join_code: account_join_codes(:"37s")).valid?
+  end
+
+  test "a code works for fifteen minutes" do
+    magic_link = MagicLink.create!(email_address: "new@example.com", purpose: :sign_up)
+
+    travel_to magic_link.expires_at - 1.second do
+      assert magic_link.redeem(magic_link.code)
+    end
+  end
+
+  test "a code stops working once fifteen minutes have passed" do
+    magic_link = MagicLink.create!(email_address: "new@example.com", purpose: :sign_up)
+
+    travel_to magic_link.expires_at + 1.second do
+      assert_nil magic_link.redeem(magic_link.code)
+    end
+  end
+
+  test "redeeming a code signs in the identity and can only happen once" do
+    magic_link = MagicLink.create!(email_address: @identity.email_address, purpose: :sign_in)
+
+    assert_equal @identity, magic_link.redeem(magic_link.code)
+    assert_nil magic_link.redeem(magic_link.code)
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+
+  test "code matching ignores case and spacing" do
+    magic_link = MagicLink.create!(email_address: @identity.email_address, purpose: :sign_in)
+    typed = magic_link.code.downcase.insert(3, " ")
+
+    assert_equal @identity, magic_link.redeem(typed)
+  end
+
+  test "wrong codes use up attempts and five of them retire the link" do
+    magic_link = MagicLink.create!(email_address: @identity.email_address, purpose: :sign_in)
+    wrong = wrong_code_for(magic_link)
+
+    assert_nil magic_link.redeem(wrong)
+    assert_equal 1, magic_link.reload.attempts
+
+    (MagicLink::MAX_ATTEMPTS - 1).times { magic_link.redeem(wrong) }
+
+    assert_nil magic_link.redeem(magic_link.code)
+    assert MagicLink.exists?(magic_link.id)
+  end
+
+  test "sign-in codes are only emailed to addresses that already have an identity" do
+    assert_emails 1 do
+      MagicLink.create!(email_address: @identity.email_address, purpose: :sign_in)
+    end
+
+    assert_no_emails do
+      MagicLink.create!(email_address: "nobody@example.com", purpose: :sign_in)
+    end
+  end
+
+  test "sign-in code for an address without an identity cannot sign anyone in" do
+    magic_link = MagicLink.create!(email_address: "nobody@example.com", purpose: :sign_in)
+
+    assert_nil magic_link.redeem(magic_link.code)
+    assert_not Identity.exists?(email_address: "nobody@example.com")
+  end
+
+  test "sign-up codes are emailed and create the identity once the code is entered" do
+    magic_link = nil
+
+    assert_emails 1 do
+      magic_link = MagicLink.create!(email_address: "new@example.com", purpose: :sign_up)
+    end
+    assert_not Identity.exists?(email_address: "new@example.com")
+
+    identity = magic_link.redeem(magic_link.code)
+
+    assert identity.persisted?
+    assert_equal "new@example.com", identity.email_address
+  end
+
+  test "join codes are emailed to anyone" do
+    assert_emails 1 do
+      MagicLink.create!(email_address: "new@example.com", purpose: :join, join_code: account_join_codes(:"37s"))
+    end
+  end
+
+  test "pending authentication token finds the link until it expires" do
+    magic_link = MagicLink.create!(email_address: @identity.email_address, purpose: :sign_in)
+    token = magic_link.pending_authentication_token
+
+    assert_equal magic_link, MagicLink.find_by_pending_authentication_token(token)
+
+    travel_to magic_link.expires_at + 1.second do
+      assert_nil MagicLink.find_by_pending_authentication_token(token)
+    end
+  end
+
+  test "pending authentication token does not accept other signed values" do
+    assert_nil MagicLink.find_by_pending_authentication_token(@identity.transfer_id)
+  end
+
+  test "cleanup deletes expired links" do
+    expired = MagicLink.create!(email_address: @identity.email_address, purpose: :sign_in)
+    active = MagicLink.create!(email_address: @identity.email_address, purpose: :sign_in)
+    expired.update!(expires_at: 1.minute.ago)
+
+    MagicLink.cleanup
+
+    assert_not MagicLink.exists?(expired.id)
+    assert MagicLink.exists?(active.id)
+  end
+
+  private
+    def wrong_code_for(magic_link)
+      magic_link.code == "AAAAAA" ? "BBBBBB" : "AAAAAA"
+    end
+end
