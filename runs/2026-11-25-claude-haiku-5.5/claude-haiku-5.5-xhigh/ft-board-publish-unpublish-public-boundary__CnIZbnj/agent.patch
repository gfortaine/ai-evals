diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..85e8c67
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "publish creates a publication with a secret key" do
+    board = boards(:writebook)
+    assert_not board.published?
+
+    board.publish
+
+    assert board.published?
+    assert_equal board, board.publication.board
+    assert_equal accounts("37s"), board.publication.account
+    assert_operator board.publication.key.length, :>=, 20
+  end
+
+  test "publish keeps the existing key when already published" do
+    board = boards(:writebook)
+    board.publish
+    key = board.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      board.publish
+    end
+
+    assert_equal key, board.reload.publication.key
+  end
+
+  test "unpublish removes the publication" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      board.unpublish
+    end
+
+    assert_not board.published?
+    assert_not board.reload.published?
+  end
+
+  test "publishing again after unpublishing generates a new key" do
+    board = boards(:writebook)
+    board.publish
+    old_key = board.publication.key
+
+    board.unpublish
+    board.publish
+
+    assert_not_equal old_key, board.publication.key
+  end
+
+  test "publishing and unpublishing touches the board" do
+    board = boards(:writebook)
+
+    travel 1.minute do
+      assert_changes -> { board.reload.updated_at } do
+        board.publish
+      end
+    end
+
+    travel 2.minutes do
+      assert_changes -> { board.reload.updated_at } do
+        board.unpublish
+      end
+    end
+  end
+
+  test "keys are unique across boards" do
+    boards(:writebook).publish
+    boards(:private).publish
+
+    keys = Board::Publication.pluck(:key)
+    assert_equal keys.uniq, keys
+  end
+
+  test "destroying the board destroys its publication" do
+    board = boards(:writebook)
+    board.publish
+    publication = board.publication
+
+    board.destroy!
+
+    assert_not Board::Publication.exists?(publication.id)
+  end
+end
