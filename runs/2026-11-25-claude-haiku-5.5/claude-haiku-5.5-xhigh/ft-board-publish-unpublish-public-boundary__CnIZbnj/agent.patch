+++ b/app/assets/stylesheets/public-boards.css
@@ -0,0 +1,74 @@
+@layer components {
+  /* Public board: columns side by side, scrolling horizontally on small screens
+  /* ------------------------------------------------------------------------ */
+
+  .public-board {
+    align-items: start;
+    display: grid;
+    gap: var(--block-space);
+    grid-auto-columns: minmax(14rem, 1fr);
+    grid-auto-flow: column;
+    overflow-x: auto;
+    padding: var(--block-space);
+  }
+
+  .public-column {
+    border-block-start: 3px solid var(--card-color, var(--color-ink-lighter));
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space-half);
+    min-inline-size: 0;
+    max-inline-size: 24rem;
+  }
+
+  .public-column__title {
+    color: var(--color-ink);
+    font-weight: 700;
+    text-decoration: none;
+  }
+
+  .public-column__cards,
+  .public-cards {
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space-half);
+  }
+
+  .public-cards {
+    margin-inline: auto;
+    max-inline-size: 60rem;
+    padding: var(--block-space);
+  }
+
+  .public-card {
+    background-color: var(--color-canvas);
+    border: 1px solid var(--color-ink-lighter);
+    border-radius: 0.5em;
+    padding: var(--block-space-half) var(--inline-space-half);
+  }
+
+  .public-card__title {
+    color: var(--color-ink);
+    text-decoration: none;
+  }
+
+  /* Public card page
+  /* ------------------------------------------------------------------------ */
+
+  .public-card-page {
+    margin-inline: auto;
+    max-inline-size: 70ch;
+    padding: var(--block-space-double) var(--inline-space);
+  }
+
+  .public-card-page__column {
+    color: var(--color-ink-light);
+    margin-block-end: var(--block-space-half);
+  }
+
+  .public-card-page__image {
+    border-radius: 0.5em;
+    margin-block: var(--block-space);
+    max-inline-size: 100%;
+  }
+}
diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
