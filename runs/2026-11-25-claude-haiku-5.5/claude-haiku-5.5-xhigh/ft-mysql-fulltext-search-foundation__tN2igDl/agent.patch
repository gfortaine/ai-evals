+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,15 @@
+<% excerpt = result.excerpt %>
+
+<li class="search-result pad-block border-block-end">
+  <%= link_to excerpt&.comment || result.card, class: "flex flex-column gap-half txt-ink txt-undecorated" do %>
+    <span class="txt-small txt-subtle">
+      <%= result.card.board.name %> · #<%= result.card.number %>
+    </span>
+
+    <strong><%= highlight_terms(result.card.title, terms) %></strong>
+
+    <% if excerpt %>
+      <span class="txt-small"><%= search_excerpt(excerpt.text, terms) %></span>
+    <% end %>
+  <% end %>
+</li>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..8c3d826
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,30 @@
+<% @page_title = @search.query.present? ? "Search: #{@search.query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="panel panel--wide flex flex-column gap center borderless margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half" do |form| %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards, descriptions, and comments", class: "input flex-item-grow", autocomplete: "off", autofocus: @search.query.blank? %>
+    <%= form.submit "Search", name: nil, class: "btn" %>
+  <% end %>
+
+  <% if @search.terms.any? %>
+    <% if @results.any? %>
+      <ul class="unpad txt-align-start">
+        <%= render partial: "searches/result", collection: @results, as: :result, locals: { terms: @search.terms } %>
+      </ul>
+    <% else %>
+      <div class="blank-slate">No cards match “<%= @search.query %>”</div>
+    <% end %>
+  <% end %>
+
+  <% unless @page.last? %>
+    <%= link_to "More results", search_path(q: @search.query, page: @page.next_param), class: "btn align-self-center" %>
+  <% end %>
+</div>
