diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..e3ca53e
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,26 @@
+module SearchHelper
+  EXCERPT_LENGTH = 200
+  EXCERPT_CONTEXT = 60
+
+  def highlight_terms(text, terms)
+    pieces = text.to_s.split(search_pattern(terms))
+    safe_join pieces.each_with_index.map { |piece, index| index.odd? ? tag.mark(piece) : piece }
+  end
+
+  def search_excerpt(text, terms)
+    match = search_pattern(terms).match(text)
+    from = [ (match&.begin(0) || 0) - EXCERPT_CONTEXT, 0 ].max
+    to = [ from + EXCERPT_LENGTH, text.length ].min
+
+    excerpt = text[from...to]
+    excerpt = "…#{excerpt}" if from > 0
+    excerpt = "#{excerpt}…" if to < text.length
+    highlight_terms(excerpt, terms)
+  end
+
+  private
+    # Capturing, so that String#split keeps the matches; odd-indexed pieces are the matches.
+    def search_pattern(terms)
+      Regexp.new("(#{Regexp.union(terms.sort_by { -_1.length }).source})", Regexp::IGNORECASE)
+    end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..26dd43a
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,65 @@
+class Search
+  attr_reader :user, :query
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.squish
+  end
+
+  def terms
+    @terms ||= query.split.uniq(&:downcase)
+  end
+
+  # Published cards on boards the user can access where every term appears in the title, the description,
+  # or some comment. Descriptions and comments are stored as HTML, so this can over-match (e.g. on tag
+  # names); #results_for verifies the matches against the plain text.
+  def cards
+    if terms.any?
+      terms.reduce(user.accessible_cards.published) { |cards, term| cards.where(card_contains(term)) }
+    else
+      Card.none
+    end
+  end
+
+  def results_for(cards)
+    return [] if terms.empty?
+
+    cards = cards.with_rich_text_description.preload(:board).to_a
+    comments = comments_for(cards).group_by(&:card_id)
+
+    cards.map { |card| Search::Result.new(card, terms, comments.fetch(card.id, [])) }.select(&:matched?)
+  end
+
+  private
+    def card_contains(term)
+      Card.arel_table[:title].matches(pattern_for(term), "!")
+        .or(descriptions_containing(term).where("action_text_rich_texts.record_id = cards.id").arel.exists)
+        .or(comment_bodies_containing(term).where("comments.card_id = cards.id").arel.exists)
+    end
+
+    def descriptions_containing(term)
+      ActionText::RichText.where(record_type: "Card", name: "description")
+        .where("action_text_rich_texts.body LIKE :pattern ESCAPE '!'", pattern: html_pattern_for(term))
+    end
+
+    def comment_bodies_containing(term)
+      Comment.joins(:rich_text_body)
+        .where("action_text_rich_texts.body LIKE :pattern ESCAPE '!'", pattern: html_pattern_for(term))
+    end
+
+    def comments_for(cards)
+      terms.map { |term| comment_bodies_containing(term) }.reduce(:or)
+        .where(card: cards).preload(:rich_text_body).order(created_at: :desc, id: :desc)
+    end
+
+    # SQLite only folds ASCII case in LIKE, so non-ASCII characters match any single character here.
+    # Search::Result still does the exact, case-insensitive check.
+    def pattern_for(text)
+      "%#{ActiveRecord::Base.sanitize_sql_like(text, "!").gsub(/[^[:ascii:]]/, "_")}%"
+    end
+
+    # Text is stored HTML-escaped, so "a & b" is stored as "a &amp; b".
+    def html_pattern_for(term)
+      pattern_for term.gsub(/[&<>]/, "&" => "&amp;", "<" => "&lt;", ">" => "&gt;")
+    end
+end
diff --git a/app/models/search/result.rb b/app/models/search/result.rb
new file mode 100644
index 0000000..090be22
--- /dev/null
+++ b/app/models/search/result.rb
@@ -0,0 +1,39 @@
+class Search::Result
+  Excerpt = Data.define(:text, :comment)
+
+  attr_reader :card
+
+  def initialize(card, terms, comments)
+    @card, @terms, @comments = card, terms, comments
+  end
+
+  # Every term must appear in the plain text of the title, description, or a comment.
+  def matched?
+    @terms.all? { |term| texts.any? { |text| contains?(text, term) } }
+  end
+
+  # The newest description or comment that contains a term, or nil if only the title matched.
+  def excerpt
+    excerpts.find { |candidate| @terms.any? { |term| contains?(candidate.text, term) } }
+  end
+
+  private
+    def texts
+      [ card.title.to_s, *excerpts.map(&:text) ]
+    end
+
+    def excerpts
+      @excerpts ||= [
+        Excerpt.new(plain_text(card.description), nil),
+        *@comments.map { |comment| Excerpt.new(plain_text(comment.body), comment) }
+      ]
+    end
+
+    def plain_text(rich_text)
+      rich_text.to_plain_text.squish
+    end
+
+    def contains?(text, term)
+      text.downcase.include?(term.downcase)
+    end
+end
diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
