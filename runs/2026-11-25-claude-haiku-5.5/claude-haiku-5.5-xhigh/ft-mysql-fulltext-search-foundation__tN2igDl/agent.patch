diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..0268ec4
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,183 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "finds cards by title regardless of case and marks the matched word" do
+    get search_path(q: "LAYOUT")
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result mark", text: "Layout"
+    assert_select ".search-result a[href=?]", card_path(cards(:layout))
+    assert_select "a", text: "More results", count: 0
+  end
+
+  test "folds case for non-ASCII letters" do
+    create_card(title: "Café menu")
+    create_card(title: "CAFÉ specials")
+
+    get search_path(q: "café")
+
+    assert_select ".search-result strong", text: "Café menu"
+    assert_select ".search-result strong", text: "CAFÉ specials"
+  end
+
+  test "treats LIKE wildcards in the query literally" do
+    create_card(title: "a_b and 100% sure")
+
+    get search_path(q: "a_b")
+    assert_select ".search-result", count: 1
+
+    get search_path(q: "aXb")
+    assert_select ".search-result", count: 0
+
+    get search_path(q: "%")
+    assert_select ".search-result mark", text: "%"
+    assert_select ".search-result", count: 1
+  end
+
+  test "finds cards by description text" do
+    cards(:shipping).update!(description: "<p><strong>Launch</strong> is planned for <em>Friday</em></p>")
+
+    get search_path(q: "launch")
+
+    assert_select ".search-result", count: 1
+    assert_select ".search-result mark", text: "Launch"
+    assert_select ".search-result a[href=?]", card_path(cards(:shipping))
+  end
+
+  test "matches text as it reads, not the HTML it is stored as" do
+    cards(:shipping).update!(description: "<p><strong>Bold</strong> and <a href=\"https://example.com/launchpad\">docs</a></p>")
+
+    get search_path(q: "strong")
+    assert_select ".search-result", count: 0
+
+    get search_path(q: "launchpad")
+    assert_select ".search-result", count: 0
+  end
+
+  test "finds ampersands and angle brackets as they appear in text" do
+    create_card(title: "Tom and Jerry", description: "Tom & Jerry <3 x < y")
+
+    get search_path(q: "&")
+    assert_select ".search-result", count: 1
+    assert_select ".search-result span mark", text: "&"
+
+    get search_path(q: "<")
+    assert_select ".search-result", count: 1
+  end
+
+  test "finds cards by comment body and links to the matching comment" do
+    comment = add_comment(cards(:shipping), "Let's ship it on Friday")
+
+    get search_path(q: "friday")
+
+    assert_select ".search-result", count: 1
+    assert_select ".search-result mark", text: "Friday"
+    assert_select ".search-result a[href$=?]", "##{ActionView::RecordIdentifier.dom_id(comment)}"
+  end
+
+  test "matches each word independently, across title and comments" do
+    get search_path(q: "layout overflowing")
+    assert_select ".search-result", count: 1
+    assert_select ".search-result mark", text: "Layout"
+
+    get search_path(q: "layout nonexistentword")
+    assert_select ".search-result", count: 0
+  end
+
+  test "never shows draft cards, nor comments left on them" do
+    create_card(title: "Zeppelin draft", status: "drafted")
+
+    card = create_card(title: "Plain card")
+    add_comment(card, "Zeppelin comment")
+    card.update_column :status, "drafted"
+
+    get search_path(q: "zeppelin")
+
+    assert_select ".search-result", count: 0
+  end
+
+  test "never shows cards from other accounts" do
+    get search_path(q: "radio")
+    assert_select ".search-result", count: 0
+  end
+
+  test "only shows cards on boards the user has access to" do
+    create_card(board: boards(:private), title: "Kevin's hideout")
+
+    get search_path(q: "hideout")
+    assert_select ".search-result", count: 1
+
+    logout_and_sign_in_as :david
+
+    get search_path(q: "hideout")
+    assert_select ".search-result", count: 0
+  end
+
+  test "stops showing cards once access to their board is revoked" do
+    logout_and_sign_in_as :david
+    get search_path(q: "layout")
+    assert_select ".search-result", count: 1
+
+    accesses(:writebook_david).destroy!
+
+    get search_path(q: "layout")
+    assert_select ".search-result", count: 0
+  end
+
+  test "lists newest cards first" do
+    create_card(title: "Migration older", created_at: 2.days.ago)
+    create_card(title: "Migration newer", created_at: 1.day.ago)
+
+    get search_path(q: "migration")
+
+    assert_equal [ "Migration newer", "Migration older" ], css_select(".search-result strong").map(&:text)
+  end
+
+  test "blank query returns no results" do
+    get search_path
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path(q: "   ")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "escapes card content and echoed query" do
+    create_card(title: "Fix <b>bold</b> rendering")
+
+    get search_path(q: "<b>")
+
+    assert_select ".search-result", count: 1
+    assert_select ".search-result mark", text: "<b>"
+    assert_select ".search-result b", count: 0
+    assert_select "input[name=q][value=?]", "<b>"
+  end
+
+  test "paginates results" do
+    16.times { |index| create_card(title: "Paginated #{index}") }
+
+    get search_path(q: "paginated")
+    assert_select ".search-result", count: 15
+    assert_select "a[href*=?]", "page=2"
+
+    get search_path(q: "paginated", page: 2)
+    assert_select ".search-result", count: 1
+  end
+
+  private
+    def create_card(board: boards(:writebook), creator: users(:kevin), status: "published", **attributes)
+      Current.session = sessions(:kevin)
+      board.cards.create!(creator:, status:, **attributes)
+    end
+
+    def add_comment(card, body)
+      Current.session = sessions(:kevin)
+      card.comments.create!(body:, creator: users(:kevin))
+    end
+end
diff --git a/test/helpers/search_helper_test.rb b/test/helpers/search_helper_test.rb
new file mode 100644
index 0000000..ef232d4
--- /dev/null
+++ b/test/helpers/search_helper_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class SearchHelperTest < ActionView::TestCase
+  test "marks matched terms, keeping the text's case" do
+    assert_equal "<mark>Layout</mark> is <mark>broken</mark>", highlight_terms("Layout is broken", %w[ layout BROKEN ])
+  end
+
+  test "escapes everything else" do
+    assert_equal "&lt;b&gt;<mark>bold</mark>&lt;/b&gt; &amp; more", highlight_terms("<b>bold</b> & more", %w[ bold ])
+  end
+
+  test "prefers the longer of overlapping terms" do
+    assert_equal "<mark>login</mark> page", highlight_terms("login page", %w[ log login ])
+  end
+
+  test "leaves text alone when there is nothing to match" do
+    assert_equal "plain &lt;text&gt;", highlight_terms("plain <text>", [])
+  end
+
+  test "excerpts a window around the first match, with ellipses" do
+    text = "#{"a" * 100} needle #{"b" * 300}"
+
+    excerpt = search_excerpt(text, %w[ needle ])
+
+    assert_includes excerpt, "<mark>needle</mark>"
+    assert excerpt.start_with?("…a")
+    assert excerpt.end_with?("b…")
+    assert_equal SearchHelper::EXCERPT_LENGTH + 2, strip_tags(excerpt).length
+  end
+
+  test "excerpts without ellipses when the whole text fits" do
+    assert_equal "a <mark>needle</mark> b", search_excerpt("a needle b", %w[ needle ])
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..a2e8410
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "terms are split on whitespace, de-duplicated, and ignore case" do
+    assert_equal %w[ Layout broken ], Search.new(users(:kevin), "  Layout   broken layout ").terms
+  end
+
+  test "a blank query has no candidate cards and no results" do
+    search = Search.new(users(:kevin), " ")
+
+    assert_empty search.cards
+    assert_empty search.results_for(Card.all)
+  end
+
+  test "candidate cards are limited to boards the user has access to" do
+    private_card = Card.create!(board: boards(:private), creator: users(:kevin), status: "published", title: "Hideout")
+
+    assert_includes Search.new(users(:kevin), "hideout").cards, private_card
+    assert_not_includes Search.new(users(:david), "hideout").cards, private_card
+  end
+
+  test "the excerpt prefers the description over comments" do
+    cards(:shipping).update!(description: "Launch notes")
+    cards(:shipping).comments.create!(body: "Launch day!", creator: users(:kevin))
+
+    result = Search.new(users(:kevin), "launch").results_for(Card.where(id: cards(:shipping).id)).first
+
+    assert_nil result.excerpt.comment
+    assert_equal "Launch notes", result.excerpt.text
+  end
+
+  test "the excerpt uses the newest matching comment" do
+    card = cards(:shipping)
+    card.comments.create!(body: "Launch first", creator: users(:kevin), created_at: 2.days.ago)
+    card.comments.create!(body: "Launch second", creator: users(:kevin), created_at: 1.day.ago)
+
+    result = Search.new(users(:kevin), "launch").results_for(Card.where(id: card.id)).first
+
+    assert_equal "Launch second", result.excerpt.text
+  end
+end
