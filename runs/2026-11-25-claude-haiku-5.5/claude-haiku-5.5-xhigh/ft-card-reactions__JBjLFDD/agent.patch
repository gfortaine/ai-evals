diff --git a/test/models/card/reaction_test.rb b/test/models/card/reaction_test.rb
new file mode 100644
index 0000000..53c768a
--- /dev/null
+++ b/test/models/card/reaction_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Card::ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:logo)
+  end
+
+  test "creating a reaction touches the card activity" do
+    assert_changes -> { @card.reload.last_active_at } do
+      @card.reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "creating a reaction touches the card so cached views refresh" do
+    assert_changes -> { @card.reload.updated_at } do
+      @card.reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "reacter and account default from the current user and card" do
+    reaction = @card.reactions.create!(content: "👍")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal @card.account, reaction.account
+  end
+
+  test "reactable only when the card is published" do
+    assert cards(:logo).reactable?
+    assert_not cards(:unfinished_thoughts).reactable?
+  end
+
+  test "destroying a card destroys its reactions" do
+    @card.reactions.create!(content: "👍")
+
+    assert_difference -> { Card::Reaction.count }, -1 do
+      @card.destroy!
+    end
+  end
+
+  test "card reactions are separate from comment reactions" do
+    comment = comments(:logo_1)
+    comment.reactions.create!(content: "Nice!")
+
+    assert_empty @card.reactions
+    assert_equal 0, Card::Reaction.where(card: @card).count
+  end
+end
