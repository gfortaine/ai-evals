@@ -10,7 +10,7 @@ class SessionsController < ApplicationController
   def create
     if user = User.active.authenticate_by(email_address: params[:email_address], password: params[:password])
       start_new_session_for user
-      redirect_to params[:return_to].presence || post_authenticating_url, allow_other_host: true
+      redirect_to same_host_return_to || post_authenticating_url
     else
       render_rejection :unauthorized
     end
@@ -26,6 +26,26 @@ class SessionsController < ApplicationController
       redirect_to first_run_url if User.none?
     end
 
+    # return_to arrives in shared and emailed links, so it can name any site. Only honor a path on this host,
+    # and rebuild the redirect from that path and query. Anything else (another host, a "//" URL, a non-string
+    # value, or something unparseable) returns nil so the reader gets the default landing page instead.
+    def same_host_return_to
+      return_to = params[:return_to]
+      return unless return_to.is_a?(String) && return_to.present? && !return_to.start_with?("//")
+
+      uri = URI.parse(return_to)
+      if uri.scheme || uri.host
+        return unless %w[ http https ].include?(uri.scheme&.downcase) && uri.host&.casecmp?(request.host) && uri.userinfo.nil?
+      end
+
+      path = uri.path.presence || "/"
+      return unless path.start_with?("/") && !path.start_with?("//")
+
+      uri.query.present? ? "#{path}?#{uri.query}" : path
+    rescue URI::Error
+      nil
+    end
+
     def render_rejection(status)
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
diff --git a/test/controllers/sessions_return_to_test.rb b/test/controllers/sessions_return_to_test.rb
new file mode 100644
index 0000000..946a285
--- /dev/null
+++ b/test/controllers/sessions_return_to_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class SessionsReturnToTest < ActionDispatch::IntegrationTest
+  PASSWORD = "secret123456"
+
+  def sign_in_with_return_to(return_to)
+    params = { email_address: users(:david).email_address, password: PASSWORD }
+    params[:return_to] = return_to unless return_to.nil?
+    post session_url, params: params
+  end
+
+  test "signing in without return_to goes to the root" do
+    sign_in_with_return_to nil
+
+    assert_redirected_to root_url
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "signing in goes to a same-host deep link, with its query" do
+    sign_in_with_return_to book_slug_url(books(:handbook)) + "?page=2"
+
+    assert_redirected_to book_slug_url(books(:handbook)) + "?page=2"
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "signing in goes to a same-host relative path" do
+    sign_in_with_return_to "/books/new?x=1"
+
+    assert_redirected_to root_url + "books/new?x=1"
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "signing in never goes to another site" do
+    [
+      "https://evil.example/phish",
+      "HTTPS://evil.example/",
+      "//evil.example/phish",
+      "///evil.example/phish",
+      "http://www.example.com//evil.example/phish",
+      "/\\evil.example/phish",
+      "\\\\evil.example/phish",
+      "http:evil.example",
+      "https:/evil.example",
+      "http://www.example.com@evil.example/",
+      "http://evil.example@www.example.com/phish",
+      "http://www.example.com\\@evil.example/",
+      "http://www.example.com.evil.example/",
+      "javascript:alert(1)",
+      "data:text/html,<script>alert(1)</script>"
+    ].each do |return_to|
+      sign_in_with_return_to return_to
+
+      assert_redirected_to root_url, "followed #{return_to.inspect}"
+      assert parsed_cookies.signed[:session_token], "no session for #{return_to.inspect}"
+      sign_out
+    end
+  end
+
+  test "signing in survives malformed return_to values" do
+    [ "   ", "%ZZ", "/%ZZ", "relative/path", "/books\nLocation: https://evil.example/", "\u0000", "/書籍" ].each do |return_to|
+      sign_in_with_return_to return_to
+
+      assert_redirected_to root_url, "unexpected redirect for #{return_to.inspect}"
+      assert parsed_cookies.signed[:session_token], "no session for #{return_to.inspect}"
+      sign_out
+    end
+  end
+
+  test "signing in survives non-string return_to values" do
+    [ [ "x" ], { "a" => "b" } ].each do |return_to|
+      sign_in_with_return_to return_to
+
+      assert_redirected_to root_url
+      assert parsed_cookies.signed[:session_token]
+      sign_out
+    end
+  end
+
+  test "a wrong password is still rejected whatever return_to says" do
+    post session_url, params: { email_address: users(:david).email_address, password: "wrong", return_to: "https://evil.example/" }
+
+    assert_response :unauthorized
+    assert_nil parsed_cookies.signed[:session_token]
+  end
+
+  test "the sign-in page renders with hostile return_to values" do
+    [ "https://evil.example/", [ "x" ], { "a" => "b" } ].each do |return_to|
+      get new_session_url, params: { return_to: return_to }
+
+      assert_response :success
+    end
+  end
+
+  test "a deep link survives the sign-in round trip" do
+    sign_out
+    get new_book_url
+    assert_redirected_to new_session_url(return_to: new_book_url)
+
+    get response.location
+    assert_response :success
+    return_to = css_select("input[name='return_to']").first["value"]
+    assert_equal new_book_url, return_to
+
+    post session_url, params: { email_address: users(:david).email_address, password: PASSWORD, return_to: return_to }
+    assert_redirected_to new_book_url
+    assert parsed_cookies.signed[:session_token]
+  end
+end
