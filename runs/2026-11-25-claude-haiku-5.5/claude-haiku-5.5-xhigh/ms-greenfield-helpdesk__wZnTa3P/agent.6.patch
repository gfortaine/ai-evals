+    create_group!("Billing", token: globex_token, account: "globex")
+
+    assert_response :created
+  end
+
+  test "a body without the group envelope is a bad request" do
+    api_post("/groups", { name: "Billing" }, token: @owner_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "admins rename a group, and the name is checked" do
+    billing = create_group!("Billing")
+    create_group!("Support")
+
+    api_patch("/groups/#{billing}", { group: { name: "Accounts" } }, token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal "Accounts", json.dig("group", "name")
+    assert_equal "Accounts", Group.find(billing).name
+
+    api_patch("/groups/#{billing}", { group: { name: "support" } }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "name").present?
+    assert_equal "Accounts", Group.find(billing).name
+
+    api_patch("/groups/#{billing}", { group: { name: "" } }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+  end
+
+  test "a rename shows on the requests in the group straight away" do
+    billing = create_group!("Billing")
+    request = open_request!(token: @avery_token, subject: "Invoice question")
+    api_patch("/tickets/#{request}", { ticket: { group_id: billing } }, token: @owner_token, account: "acme")
+    assert_response :ok
+
+    api_patch("/groups/#{billing}", { group: { name: "Accounts" } }, token: @owner_token, account: "acme")
+    assert_response :ok
+
+    api_get("/tickets", token: @owner_token, account: "acme")
+    row = json["tickets"].find { |t| t["id"] == request }
+    assert_equal({ "id" => billing, "name" => "Accounts" }, row["group"])
+  end
+
+  test "a rename without a name is a bad request" do
+    billing = create_group!("Billing")
+
+    api_patch("/groups/#{billing}", { group: { description: "nope" } }, token: @owner_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "Billing", Group.find(billing).name
+  end
+
+  test "groups are listed by ID ascending, with the page metadata" do
+    billing = create_group!("Billing")
+    support = create_group!("Technical Support")
+
+    api_get("/groups", token: @sam_token, account: "acme")
+
+    assert_response :ok
+    assert_equal %w[count groups next_page page per_page previous_page], json.keys.sort
+    assert_equal [ billing, support ], json["groups"].map { |g| g["id"] }
+    assert_equal 2, json["count"]
+  end
+
+  test "a group can be shown by ID, and an unknown one is not found" do
+    billing = create_group!("Billing")
+
+    api_get("/groups/#{billing}", token: @sam_token, account: "acme")
+    assert_response :ok
+    assert_equal "Billing", json.dig("group", "name")
+
+    api_get("/groups/999999", token: @sam_token, account: "acme")
+    assert_response :not_found
+  end
+
+  test "staff browse groups, but only admins create, rename or delete them" do
+    billing = create_group!("Billing")
+
+    api_post("/groups", { group: { name: "Sales" } }, token: @sam_token, account: "acme")
+    assert_response :forbidden
+    assert_equal "admin_only", json.dig("error", "code")
+
+    api_patch("/groups/#{billing}", { group: { name: "Money" } }, token: @sam_token, account: "acme")
+    assert_response :forbidden
+    assert_equal "admin_only", json.dig("error", "code")
+
+    api_delete("/groups/#{billing}", token: @sam_token, account: "acme")
+    assert_response :forbidden
+    assert_equal "admin_only", json.dig("error", "code")
+
+    assert_equal "Billing", Group.find(billing).name
+  end
+
+  test "customers cannot browse or change groups" do
+    billing = create_group!("Billing")
+
+    api_get("/groups", token: @avery_token, account: "acme")
+    assert_response :forbidden
+    assert_equal "staff_only", json.dig("error", "code")
+
+    api_get("/groups/#{billing}", token: @avery_token, account: "acme")
+    assert_response :forbidden
+
+    api_post("/groups", { group: { name: "Sales" } }, token: @avery_token, account: "acme")
+    assert_response :forbidden
+  end
+
+  test "deleting a group removes it and its memberships" do
+    billing = create_group!("Billing")
+    GroupMembership.add!(account: Account.find_by!(subdomain: "acme"), group_id: billing, user_id: @sam.id)
+
+    api_delete("/groups/#{billing}", token: @owner_token, account: "acme")
+
+    assert_response :no_content
+    assert_empty response.body
+    refute Group.exists?(billing)
+    refute GroupMembership.exists?(group_id: billing)
+  end
+
+  test "a group in another business is not found" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    globex_group = create_group!("Billing", token: globex_token, account: "globex")
+
+    api_get("/groups/#{globex_group}", token: @owner_token, account: "acme")
+    assert_response :not_found
+
+    api_patch("/groups/#{globex_group}", { group: { name: "Hacked" } }, token: @owner_token, account: "acme")
+    assert_response :not_found
+
+    api_delete("/groups/#{globex_group}", token: @owner_token, account: "acme")
+    assert_response :not_found
+    assert_equal "Billing", Group.find(globex_group).name
+  end
+
+  test "deleting a group ungroups its requests and clears their assignee, and leaves other requests alone" do
+    billing = create_group!("Billing")
+    support = create_group!("Technical Support")
+    account = Account.find_by!(subdomain: "acme")
+    GroupMembership.add!(account: account, group_id: billing, user_id: @sam.id)
+    GroupMembership.add!(account: account, group_id: support, user_id: @sam.id)
+    in_billing = open_request!(token: @avery_token, subject: "Invoice question")
+    in_support = open_request!(token: @avery_token, subject: "Login broken")
+    api_patch("/tickets/#{in_billing}", { ticket: { group_id: billing, assignee_id: @sam.id } },
+              token: @owner_token, account: "acme")
+    assert_response :ok
+    api_patch("/tickets/#{in_support}", { ticket: { group_id: support, assignee_id: @sam.id } },
+              token: @owner_token, account: "acme")
+    assert_response :ok
+
+    api_delete("/groups/#{billing}", token: @owner_token, account: "acme")
+    assert_response :no_content
+
+    billing_ticket = Ticket.find(in_billing)
+    assert_nil billing_ticket.group_id
+    assert_nil billing_ticket.assignee_id
+    assert_equal "open", billing_ticket.status
+
+    support_ticket = Ticket.find(in_support)
+    assert_equal support, support_ticket.group_id
+    assert_equal @sam.id, support_ticket.assignee_id
+  end
+
+  test "deleting a group moves the people in it to their other default" do
+    billing = create_group!("Billing")
+    support = create_group!("Technical Support")
+    account = Account.find_by!(subdomain: "acme")
+    GroupMembership.add!(account: account, group_id: billing, user_id: @sam.id)
+    GroupMembership.add!(account: account, group_id: support, user_id: @sam.id)
+    assert_equal billing, GroupMembership.find_by!(user_id: @sam.id, default: true).group_id
+
+    api_delete("/groups/#{billing}", token: @owner_token, account: "acme")
+
+    assert_response :no_content
+    remaining = GroupMembership.where(user_id: @sam.id).to_a
+    assert_equal [ support ], remaining.map(&:group_id)
+    assert_equal [ true ], remaining.map(&:default)
+  end
+
+  test "deleting the only group a person is in leaves them with no memberships" do
+    billing = create_group!("Billing")
+    account = Account.find_by!(subdomain: "acme")
+    GroupMembership.add!(account: account, group_id: billing, user_id: @sam.id)
+
+    api_delete("/groups/#{billing}", token: @owner_token, account: "acme")
+
+    assert_response :no_content
+    assert_empty GroupMembership.where(user_id: @sam.id)
+    api_get("/group_memberships", token: @owner_token, account: "acme")
+    assert_empty json["group_memberships"]
+  end
+end
