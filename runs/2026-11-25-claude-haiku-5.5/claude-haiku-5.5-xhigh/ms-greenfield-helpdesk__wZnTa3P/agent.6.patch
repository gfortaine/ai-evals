+    @avery_token = customer_sign_in!
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @sam = user_in("acme", "sam@example.test")
+  end
+
+  def create_group!(name, token: @owner_token, account: "acme")
+    api_post("/groups", { group: { name: name } }, token: token, account: account)
+    assert_response :created, response.body
+    json.dig("group", "id")
+  end
+
+  test "an admin creates a group, which is returned with its id and name" do
+    api_post("/groups", { group: { name: "Billing" } }, token: @owner_token, account: "acme")
+
+    assert_response :created
+    assert_equal %w[created_at id name updated_at], json["group"].keys.sort
+    assert_equal "Billing", json.dig("group", "name")
+    assert_equal "Billing", Group.find(json.dig("group", "id")).name
+  end
+
+  test "the name is trimmed, and must be present and unique within the business, ignoring case" do
+    create_group!("Billing")
+
+    api_post("/groups", { group: { name: "  Technical Support  " } }, token: @owner_token, account: "acme")
+    assert_response :created
+    assert_equal "Technical Support", json.dig("group", "name")
+
+    api_post("/groups", { group: { name: "   " } }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "name").present?
+
+    api_post("/groups", { group: { name: "billing" } }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "name").present?
+    assert_equal 2, Group.count
+  end
+
+  test "the same name can be used by two different businesses" do
+    create_group!("Billing")
+
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
