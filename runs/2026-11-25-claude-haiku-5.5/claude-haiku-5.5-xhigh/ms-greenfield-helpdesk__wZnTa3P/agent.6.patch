diff --git a/test/integration/ticket_groups_test.rb b/test/integration/ticket_groups_test.rb
new file mode 100644
index 0000000..26d694e
--- /dev/null
+++ b/test/integration/ticket_groups_test.rb
@@ -0,0 +1,355 @@
+require "test_helper"
+
+class TicketGroupsTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+    @avery = user_in("acme", "avery@example.test")
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @sam = user_in("acme", "sam@example.test")
+    @kim_token = invite_and_sign_in!(inviter_token: @owner_token, email: "kim@example.test", name: "Kim")
+    @kim = user_in("acme", "kim@example.test")
+
+    @billing = create_group!("Billing")
+    @support = create_group!("Technical Support")
+    # Not @request: the integration runner sets @request itself on every call.
+    @ticket_id = open_request!(token: @avery_token, subject: "Invoice question")
+  end
+
+  def create_group!(name)
+    api_post("/groups", { group: { name: name } }, token: @owner_token, account: "acme")
+    assert_response :created, response.body
+    json.dig("group", "id")
+  end
+
+  def join!(group, user, default: :omit)
+    body = { group_id: group, user_id: user.id }
+    body[:default] = default unless default == :omit
+    api_post("/group_memberships", { group_membership: body }, token: @owner_token, account: "acme")
+    assert_response :created, response.body
+  end
+
+  # A staff update that must succeed.
+  def staff_update!(ticket_body, id: @ticket_id)
+    api_patch("/tickets/#{id}", { ticket: ticket_body }, token: @owner_token, account: "acme")
+    assert_response :ok, response.body
+    json["ticket"]
+  end
+
+  # A staff update that must be refused. Returns the errors hash, keyed by field.
+  def staff_refused(ticket_body, id: @ticket_id)
+    api_patch("/tickets/#{id}", { ticket: ticket_body }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity, response.body
+    json.dig("error", "errors")
+  end
+
+  def ticket(id = @ticket_id) = Ticket.find(id)
+
+  def staff_list(query = "")
+    api_get("/tickets#{query}", token: @owner_token, account: "acme")
+    assert_response :ok, response.body
+    json["tickets"]
+  end
+
+  test "staff tickets show the group's ID and name, and a request with no group shows none" do
+    row = staff_list.find { |t| t["id"] == @ticket_id }
+    assert_nil row["group_id"]
+    assert_nil row["group"]
+
+    updated = staff_update!({ group_id: @billing })
+    assert_equal({ "id" => @billing, "name" => "Billing" }, updated["group"])
+
+    row = staff_list.find { |t| t["id"] == @ticket_id }
+    assert_equal @billing, row["group_id"]
+    assert_equal({ "id" => @billing, "name" => "Billing" }, row["group"])
+  end
+
+  test "customers never see a request's group" do
+    staff_update!({ group_id: @billing })
+
+    api_get("/requests/#{@ticket_id}", token: @avery_token, account: "acme")
+    assert_response :ok
+    assert_equal %w[created_at id requester_id status subject updated_at], json["request"].keys.sort
+  end
+
+  test "customers cannot move a request to a group, and such an update is a bad request" do
+    api_patch("/requests/#{@ticket_id}", { request: { group_id: @billing } }, token: @avery_token, account: "acme")
+
+    assert_response :bad_request
+    assert_nil ticket.group_id
+  end
+
+  test "requests can be filtered by group, and group_id=unassigned finds the ungrouped ones" do
+    second = open_request!(token: @avery_token, subject: "Login broken")
+    third = open_request!(token: @avery_token, subject: "Refund")
+    staff_update!({ group_id: @billing })
+    staff_update!({ group_id: @support }, id: second)
+
+    assert_equal [ @ticket_id ], staff_list("?group_id=#{@billing}").map { |t| t["id"] }
+    assert_equal [ second ], staff_list("?group_id=#{@support}").map { |t| t["id"] }
+    assert_equal [], staff_list("?group_id=#{@support + 1000}")
+    assert_equal [ third ], staff_list("?group_id=unassigned").map { |t| t["id"] }
+  end
+
+  test "the group filter combines with the other filters" do
+    join!(@billing, @sam)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+    other = open_request!(token: @avery_token, subject: "Login broken")
+    staff_update!({ group_id: @billing }, id: other)
+
+    assert_equal [ @ticket_id ], staff_list("?group_id=#{@billing}&assignee_id=#{@sam.id}").map { |t| t["id"] }
+    assert_equal [ other ], staff_list("?group_id=#{@billing}&assignee_id=unassigned").map { |t| t["id"] }
+    assert_equal [], staff_list("?group_id=#{@support}&assignee_id=#{@sam.id}")
+  end
+
+  test "a group filter that is not an ID is refused" do
+    api_get("/tickets?group_id=billing", token: @owner_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors").key?("group_id")
+  end
+
+  test "moving a request to a group does not move it up the lists or change what the customer sees" do
+    api_get("/requests/#{@ticket_id}", token: @avery_token, account: "acme")
+    customer_view = json
+    updated_at = ticket.updated_at
+
+    staff_update!({ group_id: @billing })
+
+    assert_equal updated_at.to_i, ticket.updated_at.to_i
+    api_get("/requests/#{@ticket_id}", token: @avery_token, account: "acme")
+    assert_equal customer_view, json
+  end
+
+  test "a group in another business is refused, and nothing in the update is saved" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    api_post("/groups", { group: { name: "Billing" } }, token: globex_token, account: "globex")
+    globex_group = json.dig("group", "id")
+
+    errors = staff_refused({ group_id: globex_group, comment: { body: "Moving it." }, status: "pending" })
+
+    assert errors.key?("group_id")
+    assert_nil ticket.group_id
+    assert_equal "open", ticket.status
+    assert_empty ticket.comments.where(body: "Moving it.")
+  end
+
+  test "an unknown group, or something that is not an ID, is refused" do
+    assert staff_refused({ group_id: 999_999 }).key?("group_id")
+    assert staff_refused({ group_id: "12abc" }).key?("group_id")
+    # An object is not a group ID. Like an object assignee, it is not a usable value, so the update is a bad request.
+    api_patch("/tickets/#{@ticket_id}", { ticket: { group_id: { id: @billing } } }, token: @owner_token, account: "acme")
+    assert_response :bad_request
+
+    assert_nil ticket.group_id
+  end
+
+  test "a blank group ID removes the request from its group" do
+    staff_update!({ group_id: @billing })
+
+    staff_update!({ group_id: "" })
+
+    assert_nil ticket.group_id
+  end
+
+  test "a request with no group is put in the assignee's default group" do
+    join!(@billing, @sam, default: true)
+    join!(@support, @sam)
+
+    staff_update!({ assignee_id: @sam.id })
+
+    assert_equal @billing, ticket.group_id
+    assert_equal @sam.id, ticket.assignee_id
+  end
+
+  test "the default group is the one marked as default, not the first membership" do
+    join!(@billing, @sam)
+    join!(@support, @sam, default: true)
+
+    staff_update!({ assignee_id: @sam.id })
+
+    assert_equal @support, ticket.group_id
+  end
+
+  test "assigning someone with no groups to a request with no group leaves the request ungrouped" do
+    staff_update!({ assignee_id: @sam.id })
+
+    assert_equal @sam.id, ticket.assignee_id
+    assert_nil ticket.group_id
+  end
+
+  test "an assignee who is not in the request's group is refused, and nothing in that update is saved" do
+    join!(@billing, @sam)
+    join!(@support, @kim)
+    staff_update!({ group_id: @billing })
+
+    errors = staff_refused({ assignee_id: @kim.id, comment: { body: "Kim, please look." }, status: "pending" })
+
+    assert errors.key?("assignee_id")
+    assert_nil ticket.assignee_id
+    assert_equal @billing, ticket.group_id
+    assert_equal "open", ticket.status
+    assert_empty ticket.comments.where(body: "Kim, please look.")
+  end
+
+  test "a member of the request's group can be assigned, and clearing the assignee leaves the group in place" do
+    join!(@billing, @sam)
+    staff_update!({ group_id: @billing })
+
+    staff_update!({ assignee_id: @sam.id })
+    assert_equal @sam.id, ticket.assignee_id
+
+    staff_update!({ assignee_id: nil })
+    assert_nil ticket.assignee_id
+    assert_equal @billing, ticket.group_id
+  end
+
+  test "moving to another group clears an assignee who is not in it, and keeps one who is" do
+    join!(@billing, @sam)
+    join!(@support, @sam)
+    join!(@billing, @kim)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    staff_update!({ group_id: @support })
+    assert_equal @support, ticket.group_id
+    assert_equal @sam.id, ticket.assignee_id
+
+    staff_update!({ group_id: @billing, assignee_id: @kim.id })
+    staff_update!({ group_id: @support })
+    assert_equal @support, ticket.group_id
+    assert_nil ticket.assignee_id
+  end
+
+  test "moving to another group with an assignee named who is not in it is refused" do
+    join!(@billing, @sam)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    errors = staff_refused({ group_id: @support, assignee_id: @sam.id })
+
+    assert errors.key?("assignee_id")
+    assert_equal @billing, ticket.group_id
+    assert_equal @sam.id, ticket.assignee_id
+  end
+
+  test "moving to another group with an assignee named who is in it is applied in full" do
+    join!(@billing, @sam)
+    join!(@support, @sam)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    staff_update!({ group_id: @support, assignee_id: @sam.id })
+
+    assert_equal @support, ticket.group_id
+    assert_equal @sam.id, ticket.assignee_id
+  end
+
+  test "clearing the group clears the assignee too" do
+    join!(@billing, @sam)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    staff_update!({ group_id: nil })
+
+    assert_nil ticket.group_id
+    assert_nil ticket.assignee_id
+  end
+
+  test "clearing the group with an assignee named in the same update assigns that person, and the group stays empty" do
+    join!(@billing, @sam)
+    join!(@support, @sam, default: true)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    staff_update!({ group_id: nil, assignee_id: @sam.id })
+
+    assert_nil ticket.group_id
+    assert_equal @sam.id, ticket.assignee_id
+  end
+
+  test "a group named in the update is used as given, not replaced by the assignee's default" do
+    join!(@support, @sam, default: true)
+    join!(@billing, @sam)
+
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    assert_equal @billing, ticket.group_id
+  end
+
+  test "a request whose group was cleared gets the assignee's default group back when they are assigned again" do
+    join!(@billing, @sam, default: true)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+    staff_update!({ group_id: nil })
+    assert_nil ticket.group_id
+
+    staff_update!({ assignee_id: @sam.id })
+
+    assert_equal @billing, ticket.group_id
+  end
+
+  test "a group sent with a reply saves with it, and a refused group saves neither" do
+    join!(@billing, @sam)
+    staff_update!({ comment: { body: "Routing this to billing." }, group_id: @billing, status: "pending" })
+    assert_equal @billing, ticket.group_id
+    assert_equal "pending", ticket.status
+    assert_equal "Routing this to billing.", ticket.comments.last.body
+
+    staff_refused({ comment: { body: "Should not appear" }, group_id: 999_999, status: "solved" })
+    assert_equal @billing, ticket.group_id
+    assert_equal "pending", ticket.status
+    refute_includes ticket.comments.map(&:body), "Should not appear"
+  end
+
+  test "a group change is internal, so it does not move the request in the lists" do
+    join!(@billing, @sam)
+    newer = open_request!(token: @avery_token, subject: "Newer request")
+    before = staff_list.map { |t| t["id"] }
+    assert_equal newer, before.first
+
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    assert_equal before, staff_list.map { |t| t["id"] }
+  end
+
+  test "moving a request to a group keeps the assignee when they are in both groups" do
+    join!(@billing, @sam)
+    join!(@support, @sam)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    staff_update!({ group_id: @support })
+
+    assert_equal @sam.id, ticket.assignee_id
+    assert_equal @support, ticket.group_id
+  end
+
+  test "removing someone from the request's group clears them, and the group stays" do
+    join!(@billing, @sam)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+    membership_id = GroupMembership.find_by!(user_id: @sam.id, group_id: @billing).id
+
+    api_delete("/group_memberships/#{membership_id}", token: @owner_token, account: "acme")
+    assert_response :no_content
+
+    assert_nil ticket.assignee_id
+    assert_equal @billing, ticket.group_id
+  end
+
+  test "an assignee who is suspended is cleared, and the request keeps its group" do
+    join!(@billing, @sam)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    api_patch("/users/#{@sam.id}", { user: { suspended: true } }, token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_nil ticket.assignee_id
+    assert_equal @billing, ticket.group_id
+  end
+
+  test "a staff member who is not in a request's group cannot be assigned to it" do
+    join!(@support, @kim)
+    staff_update!({ group_id: @billing })
+
+    assert staff_refused({ assignee_id: @kim.id }).key?("assignee_id")
+
+    assert_nil ticket.assignee_id
+  end
+end
