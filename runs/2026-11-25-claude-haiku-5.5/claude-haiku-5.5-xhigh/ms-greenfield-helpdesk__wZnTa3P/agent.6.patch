@@ -0,0 +1,49 @@
+module Api
+  module V1
+    # The business's groups, such as Billing or Technical Support. Staff can browse them. Admins create, rename and
+    # delete them. A group organizes the work, and never hides a request from other staff.
+    class GroupsController < ApplicationController
+      include Paginated
+
+      before_action :authenticate_session!
+      before_action :require_staff!
+      before_action :require_admin!, only: %i[create update destroy]
+
+      def index
+        render_page(current_account.groups.order(:id), key: "groups", &:as_api_json)
+      end
+
+      def show
+        render json: { group: find_group.as_api_json }
+      end
+
+      def create
+        input = require_params(:group).permit(:name)
+        group = Group.create_named!(account: current_account, name: input[:name])
+
+        render json: { group: group.as_api_json }, status: :created
+      end
+
+      # Only the name can change. The memberships and the requests in the group stay as they are.
+      def update
+        input = require_params(:group).permit(:name)
+        return render_error(:bad_request, "parameter_missing", "Send a name.") unless input.key?(:name)
+
+        group = find_group.rename!(input[:name])
+        render json: { group: group.as_api_json }
+      end
+
+      # Deletes the group. Its memberships go, and its requests stay, ungrouped and without an assignee.
+      def destroy
+        find_group.remove!
+        head :no_content
+      end
+
+      private
+
+      def find_group
+        current_account.groups.find(params[:id])
+      end
+    end
+  end
+end
