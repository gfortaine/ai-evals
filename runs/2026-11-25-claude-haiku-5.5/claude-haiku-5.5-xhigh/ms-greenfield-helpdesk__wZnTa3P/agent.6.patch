@@ -0,0 +1,75 @@
+module Api
+  module V1
+    # Which staff belong to which groups. Staff can browse memberships. Admins add people to groups, remove them, and
+    # choose each person's default group.
+    class GroupMembershipsController < ApplicationController
+      include Paginated
+      include ListFilters
+
+      before_action :authenticate_session!
+      before_action :require_staff!
+      before_action :require_admin!, only: %i[create destroy make_default]
+
+      # Filters: group_id and user_id. Both combine.
+      def index
+        errors = {}
+        group_id = id_param(:group_id, errors, noun: "a group ID")
+        user_id = user_id_param(:user_id, errors)
+        return render_validation_failed(errors) if errors.any?
+
+        scope = current_account.group_memberships.includes(:group, :user).order(:id)
+        scope = scope.where(group_id: group_id) if group_id
+        scope = scope.where(user_id: user_id) if user_id
+        render_page(scope, key: "group_memberships", &:as_api_json)
+      end
+
+      def show
+        render json: { group_membership: find_membership.as_api_json }
+      end
+
+      # The default is optional. A person's first membership is always their default, whatever default says.
+      def create
+        body = require_params(:group_membership)
+        errors = {}
+        group_id = id_param(:group_id, errors, noun: "a group ID", value: body[:group_id])
+        user_id = id_param(:user_id, errors, noun: "a user ID", value: body[:user_id])
+        default = default_param(body, errors)
+        return render_validation_failed(errors) if errors.any?
+
+        membership = GroupMembership.add!(account: current_account, group_id: group_id, user_id: user_id,
+                                          default: default)
+        render json: { group_membership: membership.as_api_json }, status: :created
+      end
+
+      # Removes the person from the group. Any request in the group that they were assigned loses them, and the
+      # request keeps its group. If this was their default, another of their memberships becomes it.
+      def destroy
+        find_membership.remove!
+        head :no_content
+      end
+
+      # Makes this group the person's default. The previous default stops being one.
+      def make_default
+        membership = find_membership.make_default!
+        render json: { group_membership: membership.as_api_json }
+      end
+
+      private
+
+      def find_membership
+        current_account.group_memberships.includes(:group, :user).find(params[:id])
+      end
+
+      # true or false. Omitted means false. Anything else is an error, not a guess.
+      def default_param(body, errors)
+        return false unless body.key?(:default)
+
+        value = BooleanParam.parse(body[:default])
+        return value unless value.nil?
+
+        errors[:default] = [ "must be true or false" ]
+        false
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/groups_controller.rb b/app/controllers/api/v1/groups_controller.rb
