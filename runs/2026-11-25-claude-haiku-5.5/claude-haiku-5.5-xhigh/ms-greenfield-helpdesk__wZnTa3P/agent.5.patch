@@ -0,0 +1,430 @@
+require "test_helper"
+
+# Mail sent to a business's support address becomes a request, delivered through the relay ingress.
+class SupportMailIntakeTest < ActionDispatch::IntegrationTest
+  include InboundMailHelpers
+
+  setup do
+    set_inbound_password
+    signup!
+    @staff_token = verified_sign_in!
+    @acme = Account.find_by!(subdomain: "acme")
+  end
+
+  teardown { restore_inbound_password }
+
+  # Delivers +raw+ and asserts the relay accepted it (the relay answers 204 for any authenticated, valid delivery).
+  def deliver!(raw)
+    assert_equal 204, relay_mail(raw)
+  end
+
+  # --- the relay ingress ----------------------------------------------------------------------------------
+
+  test "the relay refuses a delivery without the ingress password, and records nothing" do
+    raw = build_mail(from: "avery@example.test", to: support_address)
+
+    assert_no_difference(%w[ActionMailbox::InboundEmail.count Ticket.count]) do
+      assert_equal 401, relay_mail(raw, password: nil)
+      assert_equal 401, relay_mail(raw, password: "guessed")
+    end
+  end
+
+  test "the relay only takes a raw RFC 822 message" do
+    raw = build_mail(from: "avery@example.test", to: support_address)
+
+    assert_equal 415, relay_mail(raw, content_type: "application/json")
+    assert_equal 0, Ticket.count
+  end
+
+  test "the ingress password comes from RAILS_INBOUND_EMAIL_PASSWORD" do
+    raw = build_mail(from: "avery@example.test", to: support_address)
+
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => "rotated-secret") do
+      assert_equal 401, relay_mail(raw, password: INBOUND_PASSWORD)
+      assert_equal 204, relay_mail(raw, password: "rotated-secret")
+    end
+    assert_equal 1, Ticket.count
+  end
+
+  # Makes the mailbox's early duplicate check answer "no", for the block only.
+  def without_duplicate_check
+    Comment.define_singleton_method(:exists?) { |*| false }
+    yield
+  ensure
+    Comment.singleton_class.remove_method(:exists?)
+  end
+
+  # --- opening requests ------------------------------------------------------------------------------------
+
+  test "mail to the business address opens a request with its subject and plain-text message" do
+    raw = build_mail(from: "Avery <avery@example.test>", to: support_address,
+                     subject: "Cannot download my receipt", body: "The download button does nothing.\n\nThanks")
+
+    assert_difference(%w[Ticket.count Comment.count], 1) { deliver!(raw) }
+
+    ticket = last_ticket
+    assert_equal @acme, ticket.account
+    assert_equal "Cannot download my receipt", ticket.subject
+    assert_equal "open", ticket.status
+    assert_equal "email", ticket.origin
+    assert_equal "avery@example.test", ticket.requester.email
+
+    comment = ticket.comments.sole
+    assert_equal "The download button does nothing.\n\nThanks", comment.body
+    assert comment.public
+    assert_equal ticket.requester, comment.author
+    assert_equal message_id_of(raw), comment.inbound_message_id
+  end
+
+  test "the business is found from Cc as well as To" do
+    raw = build_mail(from: "avery@example.test", to: "someone-else@example.test", cc: support_address)
+
+    assert_difference("Ticket.count", 1) { deliver!(raw) }
+    assert_equal @acme, last_ticket.account
+  end
+
+  test "mail with several addresses for the same business opens one request" do
+    raw = build_mail(from: "avery@example.test", to: support_address, cc: support_address.upcase)
+
+    assert_difference("Ticket.count", 1) { deliver!(raw) }
+  end
+
+  test "mail addressed to two businesses is ignored, without creating anything" do
+    signup!(subdomain: "beta", name: "Beta", email: "jo@beta.test")
+    raw = build_mail(from: "avery@example.test", to: support_address("acme"), cc: support_address("beta"))
+
+    assert_no_difference(%w[Ticket.count User.count Comment.count]) { deliver!(raw) }
+    assert_equal "bounced", ActionMailbox::InboundEmail.last.status
+  end
+
+  test "mail to an unknown business, or to another domain, is ignored" do
+    assert_no_difference("Ticket.count") do
+      deliver!(build_mail(from: "avery@example.test", to: "nobody@support.example.test"))
+      deliver!(build_mail(from: "avery@example.test", to: "acme@example.test"))
+    end
+    assert_equal %w[bounced bounced], ActionMailbox::InboundEmail.order(:id).last(2).map(&:status)
+  end
+
+  test "each new message to the plain support address opens a new request" do
+    deliver!(build_mail(from: "avery@example.test", to: support_address, subject: "First"))
+    deliver!(build_mail(from: "avery@example.test", to: support_address, subject: "Second"))
+
+    assert_equal %w[First Second], Ticket.order(:id).pluck(:subject)
+    assert_equal 1, User.where(email: "avery@example.test").count
+  end
+
+  test "the support domain comes from HELPDESK_SUPPORT_DOMAIN" do
+    with_env("HELPDESK_SUPPORT_DOMAIN" => "help.example.test") do
+      deliver!(build_mail(from: "avery@example.test", to: "acme@help.example.test"))
+      assert_no_difference("Ticket.count") do
+        deliver!(build_mail(from: "avery@example.test", to: "acme@support.example.test"))
+      end
+    end
+    assert_equal 1, Ticket.count
+  end
+
+  # --- customers ------------------------------------------------------------------------------------------
+
+  test "a new sender gets an unverified customer account and a verification email" do
+    deliver!(build_mail(from: "Avery Quinn <avery@example.test>", to: support_address))
+
+    user = User.find_by!(email: "avery@example.test", account: @acme)
+    assert_equal "customer", user.role
+    assert_equal "Avery Quinn", user.name
+    assert_not user.verified?, "receiving mail must not verify the account"
+    assert_equal user, last_ticket.requester
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "avery@example.test" ], mail.to
+    assert_match %r{/verify-email\?account=acme&token=}, mail.body.decoded
+  end
+
+  test "a new sender with no display name is named after the part of the address before the @" do
+    deliver!(build_mail(from: "avery.quinn@example.test", to: support_address))
+
+    assert_equal "avery.quinn", User.find_by!(email: "avery.quinn@example.test").name
+  end
+
+  test "a new sender cannot sign in, because nobody knows their password, until they choose one through the reset flow" do
+    deliver!(build_mail(from: "avery@example.test", to: support_address))
+
+    api_post("/sessions", { session: { email: "avery@example.test", password: CUSTOMER_PASSWORD } }, account: "acme")
+    assert_response :unauthorized
+    assert_equal "invalid_credentials", json.dig("error", "code")
+
+    api_post("/password_resets", { password_reset: { email: "avery@example.test" } }, account: "acme")
+    api_post("/password_resets/confirm",
+             { password_reset: { token: reset_token("avery@example.test"), password: CUSTOMER_PASSWORD } }, account: "acme")
+    assert_response :ok
+
+    sign_in!(email: "avery@example.test", password: CUSTOMER_PASSWORD)
+  end
+
+  test "an existing customer is reused, with no new account and no verification email" do
+    customer_sign_in!(email: "avery@example.test")
+    avery = user_in("acme", "avery@example.test")
+    mails_before = ActionMailer::Base.deliveries.size
+
+    assert_no_difference("User.count") { deliver!(build_mail(from: "avery@example.test", to: support_address)) }
+
+    assert_equal avery, last_ticket.requester
+    assert_equal mails_before, ActionMailer::Base.deliveries.size, "no verification email for an existing customer"
+  end
+
+  test "receiving mail does not verify an existing unverified customer" do
+    register_customer!(email: "avery@example.test")
+    avery = user_in("acme", "avery@example.test")
+
+    deliver!(build_mail(from: "avery@example.test", to: support_address))
+
+    assert_not avery.reload.verified?
+  end
+
+  test "a staff member who writes in is the requester, because the business already has their account" do
+    invite_and_sign_in!(inviter_token: @staff_token, email: "sam@example.test", role: "agent")
+    sam = user_in("acme", "sam@example.test")
+
+    assert_no_difference("User.count") { deliver!(build_mail(from: "sam@example.test", to: support_address)) }
+    assert_equal sam, last_ticket.requester
+  end
+
+  test "a suspended person's mail is refused, and accepted once they are reinstated and it is sent again" do
+    customer_sign_in!(email: "avery@example.test")
+    avery = user_in("acme", "avery@example.test")
+    api_patch("/users/#{avery.id}", { user: { suspended: true } }, token: @staff_token, account: "acme")
+    raw = build_mail(from: "avery@example.test", to: support_address)
+
+    assert_no_difference("Ticket.count") { deliver!(raw) }
+    assert_equal "bounced", ActionMailbox::InboundEmail.last.status
+
+    api_patch("/users/#{avery.id}", { user: { suspended: false } }, token: @staff_token, account: "acme")
+    assert_difference("Ticket.count", 1) { deliver!(raw) }
+  end
+
+  test "mail sent from one of our own support addresses never opens a request" do
+    assert_no_difference("Ticket.count") do
+      deliver!(build_mail(from: "acme@support.example.test", to: support_address))
+    end
+  end
+
+  # --- duplicates and retries -----------------------------------------------------------------------------
+
+  test "a message delivered twice by its Message-ID opens one request" do
+    raw = build_mail(from: "avery@example.test", to: support_address, message_id: "same-message@example.test")
+
+    assert_difference("Ticket.count", 1) do
+      deliver!(raw)
+      deliver!(raw)
+    end
+    assert_equal 1, Comment.where(inbound_message_id: "same-message@example.test").count
+    assert_equal 1, ActionMailbox::InboundEmail.where(message_id: "same-message@example.test").count,
+                 "the repeat is dropped at the ingress, like any identical copy"
+  end
+
+  test "a copy with the same Message-ID but different bytes is still a duplicate" do
+    deliver!(build_mail(from: "avery@example.test", to: support_address, message_id: "dup@example.test",
+                        body: "first copy"))
+
+    assert_no_difference("Ticket.count") do
+      deliver!(build_mail(from: "avery@example.test", to: support_address, message_id: "dup@example.test",
+                          body: "second copy, relayed again"))
+    end
+    assert_equal "first copy", Comment.find_by!(inbound_message_id: "dup@example.test").body
+  end
+
+  test "a repeat that gets past the early duplicate check is stopped by the unique index, and leaves nothing behind" do
+    deliver!(build_mail(from: "avery@example.test", to: support_address, message_id: "race@example.test"))
+    ActionMailer::Base.deliveries.clear
+
+    # Pretend the copy arrived before the first one was committed. The database still refuses it.
+    without_duplicate_check do
+      assert_no_difference(%w[Ticket.count Comment.count User.count]) do
+        deliver!(build_mail(from: "casey@example.test", to: support_address, message_id: "race@example.test"))
+      end
+    end
+
+    assert_empty ActionMailer::Base.deliveries, "no verification email for an account that was rolled back"
+    assert_equal "delivered", ActionMailbox::InboundEmail.last.status
+  end
+
+  test "an invalid delivery does not block a later valid retry of the same message" do
+    customer_sign_in!(email: "avery@example.test")
+    avery = user_in("acme", "avery@example.test")
+    api_patch("/users/#{avery.id}", { user: { suspended: true } }, token: @staff_token, account: "acme")
+    raw = build_mail(from: "avery@example.test", to: support_address, message_id: "retry-me@example.test")
+    deliver!(raw)
+    assert_equal 0, Ticket.count
+
+    api_patch("/users/#{avery.id}", { user: { suspended: false } }, token: @staff_token, account: "acme")
+    assert_difference("Ticket.count", 1) { deliver!(raw) }
+    assert_equal "delivered", ActionMailbox::InboundEmail.last.status
+  end
+
+  test "mail that arrives before its business exists is refused, and is accepted when it is sent again afterwards" do
+    raw = build_mail(from: "avery@example.test", to: support_address("beta"), message_id: "early-bird@example.test")
+    assert_no_difference("Ticket.count") { deliver!(raw) }
+
+    signup!(subdomain: "beta", name: "Beta", email: "jo@beta.test")
+    assert_difference("Ticket.count", 1) { deliver!(raw) }
+    assert_equal Account.find_by!(subdomain: "beta"), last_ticket.account
+  end
+
+  test "a message to a cancelled business is refused, and is accepted on retry once the business is reactivated" do
+    raw = build_mail(from: "avery@example.test", to: support_address, message_id: "after-reactivation@example.test")
+    api_post("/account/cancel", token: @staff_token, account: "acme")
+
+    assert_no_difference("Ticket.count") { deliver!(raw) }
+
+    # Cancelling signs everyone out, the owner included, so they sign in again to reactivate.
+    owner_token = sign_in!(email: "jo@acme.test")
+    api_post("/account/reactivate", token: owner_token, account: "acme")
+    assert_response :ok
+    assert_difference("Ticket.count", 1) { deliver!(raw) }
+  end
+
+  test "a message with no plain-text part is refused, and does not block a later delivery of a readable copy" do
+    html_only_attachment = raw_message([
+      "From: avery@example.test", "To: acme@support.example.test", "Subject: Screenshot",
+      "Message-ID: <screenshot@example.test>", "MIME-Version: 1.0",
+      "Content-Type: image/png", "Content-Transfer-Encoding: base64", "", "iVBORw0KGgo="
+    ])
+
+    assert_no_difference("Ticket.count") { deliver!(html_only_attachment) }
+    assert_equal "bounced", ActionMailbox::InboundEmail.last.status
+  end
+
+  test "a bounce with an empty return path is ignored" do
+    bounce = raw_message([
+      "Return-Path: <>", "From: avery@example.test", "To: acme@support.example.test", "Subject: Undelivered",
+      "Message-ID: <null-sender@example.test>", "MIME-Version: 1.0", "Content-Type: text/plain; charset=UTF-8", "",
+      "Your message could not be delivered."
+    ])
+
+    assert_no_difference("Ticket.count") { deliver!(bounce) }
+    assert_equal "bounced", ActionMailbox::InboundEmail.last.status
+  end
+
+  test "a message in Latin-1 keeps its accents in the body, and a raw Windows-1252 subject is read correctly" do
+    latin1 = [
+      "From: avery@example.test", "To: acme@support.example.test", "Subject: Caf\xE9 menu",
+      "Message-ID: <latin1@example.test>", "MIME-Version: 1.0", "Content-Type: text/plain; charset=ISO-8859-1",
+      "Content-Transfer-Encoding: 8bit", "", "Caf\xE9 is broken\r\n"
+    ].join("\r\n").b
+
+    deliver!(latin1)
+    assert_equal "Café menu", last_ticket.subject
+    assert_equal "Café is broken", last_ticket.comments.sole.body
+  end
+
+  # --- automated and list mail ----------------------------------------------------------------------------
+
+  AUTOMATED_HEADERS = [
+    { "Auto-Submitted" => "auto-replied" },
+    { "Auto-Submitted" => "auto-generated" },
+    { "Precedence" => "bulk" },
+    { "Precedence" => "list" },
+    { "List-Id" => "<announcements.example.test>" },
+    { "List-Unsubscribe" => "<https://example.test/unsubscribe>" },
+    { "X-Autoreply" => "yes" }
+  ].freeze
+
+  test "automated and list mail is ignored" do
+    AUTOMATED_HEADERS.each do |headers|
+      raw = build_mail(from: "avery@example.test", to: support_address, headers: headers)
+      assert_no_difference("Ticket.count", "#{headers.keys.first} should be ignored") { deliver!(raw) }
+    end
+  end
+
+  test "mail from machines by sender name is ignored" do
+    %w[mailer-daemon@example.test postmaster@example.test no-reply@example.test].each do |sender|
+      assert_no_difference("Ticket.count") { deliver!(build_mail(from: sender, to: support_address)) }
+    end
+  end
+
+  test "a bounce report is ignored" do
+    report = raw_message([
+      "From: mailer-daemon@example.test", "To: acme@support.example.test", "Subject: Delivery failed",
+      "Message-ID: <bounce@example.test>", "MIME-Version: 1.0",
+      "Content-Type: multipart/report; report-type=delivery-status; boundary=\"b\"", "", "--b--"
+    ])
+
+    assert_no_difference("Ticket.count") { deliver!(report) }
+  end
+
+  test "Auto-Submitted: no is an ordinary message from a person" do
+    raw = build_mail(from: "avery@example.test", to: support_address, headers: { "Auto-Submitted" => "no" })
+
+    assert_difference("Ticket.count", 1) { deliver!(raw) }
+  end
+
+  # --- reading the message --------------------------------------------------------------------------------
+
+  test "a message with no subject is opened as (no subject)" do
+    raw = raw_message([
+      "From: avery@example.test", "To: acme@support.example.test", "Message-ID: <nosubject@example.test>",
+      "MIME-Version: 1.0", "Content-Type: text/plain; charset=utf-8", "", "The app crashes on start."
+    ])
+
+    deliver!(raw)
+    assert_equal "(no subject)", last_ticket.subject
+    assert_equal "The app crashes on start.", last_ticket.comments.sole.body
+  end
+
+  test "a long subject is shortened to the request limit" do
+    deliver!(build_mail(from: "avery@example.test", to: support_address, subject: "S" * 400))
+
+    assert_equal 255, last_ticket.subject.length
+  end
+
+  test "an HTML-only message becomes plain text" do
+    to = support_address
+    mail = Mail.new do
+      from "avery@example.test"
+      to to
+      subject "Html only"
+      message_id "html-only@example.test"
+      html_part do
+        content_type "text/html; charset=UTF-8"
+        body "<p>Tom &amp; Jerry can&#39;t log in.</p><p>Line&nbsp;two<br>and three</p><style>p{color:red}</style>"
+      end
+    end
+
+    deliver!(mail.to_s)
+    body = last_ticket.comments.sole.body
+    assert_includes body, "Tom & Jerry can't log in."
+    assert_includes body, "Line two\nand three"
+    assert_not_includes body, "&nbsp;"
+    assert_not_includes body, "color:red"
+  end
+
+  test "the text of a multipart message is taken from its text part, not its attachments" do
+    to = support_address
+    mail = Mail.new do
+      from "avery@example.test"
+      to to
+      subject "With attachment"
+      message_id "attached@example.test"
+      text_part { body "The export is empty." }
+      add_file filename: "notes.txt", content: "Attachment text that is not the message."
+    end
+
+    deliver!(mail.to_s)
+    assert_equal "The export is empty.", last_ticket.comments.sole.body
+  end
+
+  test "a very long message is shortened, and says so" do
+    deliver!(build_mail(from: "avery@example.test", to: support_address, body: "x" * 20_000))
+
+    body = last_ticket.comments.sole.body
+    assert body.length <= Comment::MAX_BODY_LENGTH
+    assert body.end_with?(SupportMail::TRUNCATION_NOTE.strip)
+  end
+
+  test "a utf-8 message keeps its characters" do
+    deliver!(build_mail(from: "avery@example.test", to: support_address, subject: "Café ☕ receipts",
+                        body: "Bonjour — naïve façade ✓"))
+
+    assert_equal "Café ☕ receipts", last_ticket.subject
+    assert_equal "Bonjour — naïve façade ✓", last_ticket.comments.sole.body
+  end
+end
