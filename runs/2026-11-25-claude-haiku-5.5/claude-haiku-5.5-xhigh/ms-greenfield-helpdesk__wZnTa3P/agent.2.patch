@@ -0,0 +1,42 @@
+module Api
+  module V1
+    # A customer's own requests. Customers open requests and reply here.
+    class RequestsController < ApplicationController
+      include Paginated
+      include Replies
+
+      before_action :authenticate_session!
+
+      def index
+        render_page(current_account.tickets.requested_by(current_user).recently_active, key: "requests", &:as_request_json)
+      end
+
+      def show
+        render json: { request: find_own_request.as_request_json }
+      end
+
+      def create
+        input = require_params(:request).permit(:subject, comment: :body)
+        ticket = Ticket.open!(requester: current_user, subject: input[:subject], body: input.dig(:comment, :body).to_s)
+
+        render json: { request: ticket.as_request_json }, status: :created
+      end
+
+      # Customer replies reopen a pending or solved request, unless the same update marks it solved.
+      def update
+        input = require_params(:request).permit(:status, comment: :body)
+        ticket = find_own_request
+        return if reject_empty_reply(input)
+
+        ticket.reply!(author: current_user, body: reply_body(input), status: reply_status(input), customer: true)
+        render json: { request: ticket.as_request_json }
+      end
+
+      private
+
+      def find_own_request
+        current_account.tickets.requested_by(current_user).find(params[:id])
+      end
+    end
+  end
+end
