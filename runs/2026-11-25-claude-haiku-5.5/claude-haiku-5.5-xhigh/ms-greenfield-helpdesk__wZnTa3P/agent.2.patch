+module Api
+  module V1
+    # The staff view of every request in the business. Staff reply here and set the status.
+    class TicketsController < ApplicationController
+      include Paginated
+      include Replies
+
+      before_action :authenticate_session!
+      before_action :require_staff!
+
+      def index
+        render_page(current_account.tickets.includes(:requester).recently_active, key: "tickets", &:as_ticket_json)
+      end
+
+      def show
+        render json: { ticket: find_ticket.as_ticket_json }
+      end
+
+      # A staff reply does not change the status unless the update sets one.
+      def update
+        input = require_params(:ticket).permit(:status, comment: :body)
+        ticket = find_ticket
+        return if reject_empty_reply(input)
+
+        ticket.reply!(author: current_user, body: reply_body(input), status: reply_status(input))
+        render json: { ticket: ticket.as_ticket_json }
+      end
+
+      private
+
+      def find_ticket
+        current_account.tickets.includes(:requester).find(params[:id])
+      end
+    end
+  end
+end
