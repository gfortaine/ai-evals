diff --git a/test/integration/ticket_filters_test.rb b/test/integration/ticket_filters_test.rb
new file mode 100644
index 0000000..f8e5502
--- /dev/null
+++ b/test/integration/ticket_filters_test.rb
@@ -0,0 +1,234 @@
+require "test_helper"
+
+class TicketFiltersTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+    @avery = user_in("acme", "avery@example.test")
+    @kim_token = customer_sign_in!(email: "kim@example.test")
+    @kim = user_in("acme", "kim@example.test")
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @sam = user_in("acme", "sam@example.test")
+
+    # Nine requests with distinct subjects, built through the API.
+    @download = open_request!(token: @avery_token, subject: "Cannot download my receipt")
+    @refund = open_request!(token: @avery_token, subject: "Refund request")
+    @march = open_request!(token: @kim_token, subject: "Receipt missing for March")
+    @password = open_request!(token: @kim_token, subject: "Password reset", body: "I forgot my password.")
+    @login = open_request!(token: @avery_token, subject: "Cannot log in")
+    open_request!(token: @avery_token, subject: "100% refund")
+    open_request!(token: @avery_token, subject: "a_b test")
+    open_request!(token: @avery_token, subject: "C:\\temp folder")
+    open_request!(token: @avery_token, subject: "axb test")
+
+    staff_update!(@refund, assignee_id: @sam.id, priority: "high", status: "pending")
+    staff_update!(@march, priority: "high")
+    staff_update!(@password, status: "solved", comment: { body: "Internal: the receipt went to billing.", public: false })
+    staff_update!(@login, comment: { body: "We found a receipt problem in the logs." })
+    # Matches "receipt" in its subject and in a public comment. It must still be listed once.
+    api_patch("/requests/#{@download}", { request: { comment: { body: "Still no receipt here." } } },
+              token: @avery_token, account: "acme")
+    assert_response :ok
+  end
+
+  def staff_update!(id, comment: nil, **attributes)
+    body = comment ? attributes.merge(comment: comment) : attributes
+    api_patch("/tickets/#{id}", { ticket: body }, token: @owner_token, account: "acme")
+    assert_response :ok, response.body
+  end
+
+  # Subjects from the staff list for a query string, sorted so assertions do not depend on order.
+  def staff_subjects(query)
+    api_get("/tickets#{query}", token: @owner_token, account: "acme")
+    assert_response :ok, response.body
+    json["tickets"].map { |t| t["subject"] }.sort
+  end
+
+  # The errors hash for a query that must be refused.
+  def staff_errors(query)
+    api_get("/tickets#{query}", token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity, "#{query} was not refused: #{response.body}"
+    assert_equal "validation_failed", json.dig("error", "code")
+    json.dig("error", "errors")
+  end
+
+  def subjects(*names) = names.sort
+
+  def all_subjects
+    subjects("100% refund", "Cannot download my receipt", "Cannot log in", "C:\\temp folder", "Password reset",
+             "Receipt missing for March", "Refund request", "a_b test", "axb test")
+  end
+
+  test "with no filters, staff see every request in the business" do
+    assert_equal all_subjects, staff_subjects("")
+  end
+
+  test "each filter narrows the list on its own" do
+    assert_equal subjects("Refund request"), staff_subjects("?status=pending")
+    assert_equal subjects("Password reset"), staff_subjects("?status=solved")
+    assert_equal subjects("Refund request"), staff_subjects("?assignee_id=#{@sam.id}")
+    assert_equal subjects("Refund request", "Receipt missing for March"), staff_subjects("?priority=high")
+    assert_equal subjects("Receipt missing for March", "Password reset"), staff_subjects("?requester_id=#{@kim.id}")
+    assert_equal subjects("Cannot download my receipt", "Cannot log in", "Receipt missing for March"), staff_subjects("?q=receipt")
+  end
+
+  test "requester_id lists one customer's requests" do
+    assert_equal subjects("100% refund", "C:\\temp folder", "Cannot download my receipt", "Cannot log in",
+                          "Refund request", "a_b test", "axb test"),
+                 staff_subjects("?requester_id=#{@avery.id}")
+    assert_equal subjects("Password reset", "Receipt missing for March"), staff_subjects("?requester_id=#{@kim.id}")
+  end
+
+  test "priority narrows to high or normal" do
+    assert_equal subjects("Receipt missing for March", "Refund request"), staff_subjects("?priority=high")
+    assert_equal all_subjects - subjects("Receipt missing for March", "Refund request"),
+                 staff_subjects("?priority=normal")
+  end
+
+  test "assignee_id=unassigned lists requests that nobody is working on" do
+    assert_equal all_subjects - subjects("Refund request"), staff_subjects("?assignee_id=unassigned")
+  end
+
+  test "unassigning a request puts it back in the unassigned list" do
+    staff_update!(@refund, assignee_id: nil)
+
+    assert_equal all_subjects, staff_subjects("?assignee_id=unassigned")
+    assert_equal [], staff_subjects("?assignee_id=#{@sam.id}")
+  end
+
+  test "filters combine, so a request must match all of them" do
+    assert_equal subjects("Receipt missing for March"),
+                 staff_subjects("?status=open&assignee_id=unassigned&priority=high&q=receipt")
+    assert_equal [], staff_subjects("?status=pending&priority=normal&q=receipt")
+    assert_equal subjects("Refund request"), staff_subjects("?status=pending&assignee_id=#{@sam.id}&priority=high")
+  end
+
+  test "q matches subjects and public comments, ignoring case" do
+    expected = subjects("Cannot download my receipt", "Cannot log in", "Receipt missing for March")
+
+    assert_equal expected, staff_subjects("?q=receipt")
+    assert_equal expected, staff_subjects("?q=RECEIPT")
+    assert_equal expected, staff_subjects("?q=ReCeIpT")
+    assert_equal subjects("Cannot download my receipt"), staff_subjects("?q=still%20no")
+  end
+
+  test "q does not match private notes" do
+    assert_equal [], staff_subjects("?q=billing")
+    assert_equal [], staff_subjects("?q=Internal")
+  end
+
+  test "a request that matches in more than one place is listed once" do
+    api_get("/tickets?q=receipt", token: @owner_token, account: "acme")
+
+    ids = json["tickets"].map { |t| t["id"] }
+    assert_equal 3, ids.size
+    assert_equal ids.uniq, ids
+    assert_equal 3, json["count"]
+  end
+
+  test "q treats % and _ and backslash as ordinary characters" do
+    assert_equal subjects("100% refund"), staff_subjects("?q=%25")
+    assert_equal subjects("100% refund"), staff_subjects("?q=100%25")
+    assert_equal subjects("a_b test"), staff_subjects("?q=a_b")
+    assert_equal subjects("C:\\temp folder"), staff_subjects("?q=%5C")
+    assert_equal subjects("C:\\temp folder"), staff_subjects("?q=C%3A%5Ctemp")
+  end
+
+  test "wildcard-looking q text does not match more than it says" do
+    assert_equal [], staff_subjects("?q=a%25b")
+    assert_equal [], staff_subjects("?q=%25%25%25zzz")
+    assert_equal [], staff_subjects("?q=%27%20OR%201%3D1%20--")
+    assert_equal [], staff_subjects("?q=%28.*%29")
+  end
+
+  test "q is case-insensitive beyond ASCII" do
+    staff_update!(@login, comment: { body: "Ça marche pas, ÉCOLE" })
+
+    assert_equal subjects("Cannot log in"), staff_subjects("?q=%C3%A9cole")
+    assert_equal subjects("Cannot log in"), staff_subjects("?q=%C3%A7A%20MARCHE")
+  end
+
+  test "blank filters mean no filter" do
+    assert_equal all_subjects, staff_subjects("?status=&priority=&assignee_id=&requester_id=&q=")
+    assert_equal all_subjects, staff_subjects("?q=%20%20")
+  end
+
+  test "the count and the pages reflect the filtered list" do
+    api_get("/tickets?status=open&per_page=2", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal 7, json["count"]
+    assert_equal 2, json["tickets"].size
+    assert_equal 2, json["next_page"]
+    assert_nil json["previous_page"]
+  end
+
+  test "a filter that matches nothing is an empty list, not an error" do
+    api_get("/tickets?q=zzz-no-match", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal [], json["tickets"]
+    assert_equal 0, json["count"]
+  end
+
+  test "an unknown user ID matches nothing" do
+    assert_equal [], staff_subjects("?assignee_id=999999")
+    assert_equal [], staff_subjects("?requester_id=999999")
+  end
+
+  test "requests from another business never match" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_owner = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    globex_customer = customer_sign_in!(account: "globex")
+    globex_request = open_request!(token: globex_customer, account: "globex", subject: "Receipt in Globex")
+    globex_avery = user_in("globex", "avery@example.test")
+
+    api_get("/tickets?q=receipt", token: @owner_token, account: "acme")
+    refute_includes json["tickets"].map { |t| t["subject"] }, "Receipt in Globex"
+
+    api_get("/tickets?q=globex", token: @owner_token, account: "acme")
+    assert_equal [], json["tickets"]
+
+    api_get("/tickets?requester_id=#{globex_avery.id}", token: @owner_token, account: "acme")
+    assert_equal [], json["tickets"]
+
+    api_get("/tickets?q=receipt", token: globex_owner, account: "globex")
+    assert_equal [ globex_request ], json["tickets"].map { |t| t["id"] }
+  end
+
+  test "an invalid value is refused with 422 naming each bad parameter, and nothing is listed" do
+    api_get("/tickets?status=closed&priority=urgent&assignee_id=abc&requester_id=-1", token: @owner_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert_equal %w[assignee_id priority requester_id status], json.dig("error", "errors").keys.sort
+    assert_nil json["tickets"]
+  end
+
+  test "each kind of invalid value is refused" do
+    {
+      "?status=closed" => "status",
+      "?status=Open" => "status",
+      "?status[]=open" => "status",
+      "?priority=urgent" => "priority",
+      "?priority=HIGH" => "priority",
+      "?assignee_id=unassign" => "assignee_id",
+      "?assignee_id=1.5" => "assignee_id",
+      "?assignee_id=99999999999999999999" => "assignee_id",
+      "?assignee_id=unassigned,1" => "assignee_id",
+      "?requester_id=unassigned" => "requester_id",
+      "?requester_id=abc" => "requester_id",
+      "?q[]=receipt" => "q",
+      "?q[a]=receipt" => "q"
+    }.each do |query, param|
+      assert_includes staff_errors(query).keys, param, "#{query} should be refused"
+    end
+  end
+
+  test "SQL and regex characters in q are plain text, and change nothing" do
+    assert_equal [], staff_subjects("?q=%27%3B%20DROP%20TABLE%20tickets%3B%20--")
+    assert_equal all_subjects.size, Ticket.count
+  end
+end
diff --git a/test/integration/ticket_priority_test.rb b/test/integration/ticket_priority_test.rb
new file mode 100644
index 0000000..c68fcc0
--- /dev/null
+++ b/test/integration/ticket_priority_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class TicketPriorityTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+    @avery = user_in("acme", "avery@example.test")
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @request_id = open_request!(token: @avery_token)
+  end
+
+  def staff_update!(token: @owner_token, **body)
+    api_patch("/tickets/#{@request_id}", { ticket: body }, token: token, account: "acme")
+  end
+
+  test "a new request is normal priority, for staff" do
+    api_get("/tickets/#{@request_id}", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal "normal", json.dig("ticket", "priority")
+    assert_equal "normal", Ticket.find(@request_id).priority
+  end
+
+  test "the staff list shows priority on every ticket" do
+    api_get("/tickets", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal %w[assignee assignee_id created_at id priority requester status subject updated_at],
+                 json["tickets"].first.keys.sort
+  end
+
+  test "staff raise a request to high and lower it again, and the response shows the change" do
+    staff_update!(priority: "high")
+    assert_response :ok
+    assert_equal "high", json.dig("ticket", "priority")
+    assert_equal "high", Ticket.find(@request_id).priority
+
+    staff_update!(priority: "normal")
+    assert_response :ok
+    assert_equal "normal", json.dig("ticket", "priority")
+    assert_equal "normal", Ticket.find(@request_id).priority
+  end
+
+  test "agents can set priority too" do
+    staff_update!(priority: "high", token: @sam_token)
+
+    assert_response :ok
+    assert_equal "high", json.dig("ticket", "priority")
+  end
+
+  test "a priority change alone does not move the request or change its updated_at" do
+    newer = open_request!(token: @avery_token, subject: "Newer one")
+    updated_at = Ticket.find(@request_id).updated_at
+
+    staff_update!(priority: "high")
+
+    assert_response :ok
+    assert_equal updated_at, Ticket.find(@request_id).updated_at
+    api_get("/requests", token: @avery_token, account: "acme")
+    assert_equal [ newer, @request_id ], json["requests"].map { |r| r["id"] }
+  end
+
+  test "a priority change leaves the customer's view of the request unchanged" do
+    api_get("/requests/#{@request_id}", token: @avery_token, account: "acme")
+    before = json["request"]
+
+    staff_update!(priority: "high")
+
+    api_get("/requests/#{@request_id}", token: @avery_token, account: "acme")
+    assert_equal before, json["request"]
+  end
+
+  test "priority is applied together with a comment and a status, in one update" do
+    staff_update!(priority: "high", status: "pending", comment: { body: "Escalating this." })
+
+    assert_response :ok
+    ticket = Ticket.find(@request_id)
+    assert_equal "high", ticket.priority
+    assert_equal "pending", ticket.status
+    assert_equal "Escalating this.", ticket.comments.last.body
+  end
+
+  test "an invalid priority is refused, and nothing in the same update is saved" do
+    staff_update!(priority: "urgent", status: "pending", comment: { body: "Urgent!" })
+
+    assert_response :unprocessable_entity
+    assert_equal "priority", json.dig("error", "errors").keys.first
+    assert json.dig("error", "errors", "priority").present?
+    ticket = Ticket.find(@request_id)
+    assert_equal "normal", ticket.priority
+    assert_equal "open", ticket.status
+    assert_equal 1, ticket.comments.count
+  end
+
+  test "priority cannot be cleared or set to a non-value" do
+    [ nil, "", "HIGH", "Normal", "low", 1, true ].each do |value|
+      staff_update!(priority: value)
+
+      assert_response :unprocessable_entity, "accepted #{value.inspect}"
+      assert json.dig("error", "errors", "priority").present?
+    end
+    assert_equal "normal", Ticket.find(@request_id).priority
+  end
+
+  test "a priority that is an object or a list is refused, not ignored, and its comment is not posted" do
+    [ { "level" => "high" }, [ "high" ] ].each do |value|
+      api_patch("/tickets/#{@request_id}", { ticket: { priority: value, comment: { body: "Escalating." } } },
+                token: @owner_token, account: "acme")
+
+      assert_response :unprocessable_entity, "accepted #{value.inspect}"
+      assert json.dig("error", "errors", "priority").present?
+    end
+    ticket = Ticket.find(@request_id)
+    assert_equal "normal", ticket.priority
+    assert_equal 1, ticket.comments.count
+  end
+
+  test "customers cannot open a request as high priority" do
+    api_post("/requests", { request: { subject: "Urgent", comment: { body: "Help!" }, priority: "high" } },
+             token: @avery_token, account: "acme")
+
+    assert_response :created
+    refute json["request"].key?("priority")
+    assert_equal "normal", Ticket.find(json.dig("request", "id")).priority
+  end
+
+  test "customers never see priority" do
+    staff_update!(priority: "high")
+
+    api_get("/requests", token: @avery_token, account: "acme")
+    assert_equal %w[created_at id requester_id status subject updated_at], json["requests"].first.keys.sort
+
+    api_get("/requests/#{@request_id}", token: @avery_token, account: "acme")
+    assert_equal %w[created_at id requester_id status subject updated_at], json["request"].keys.sort
+  end
+
+  test "customers cannot change priority, and a priority-only update is a bad request" do
+    api_patch("/requests/#{@request_id}", { request: { priority: "high" } }, token: @avery_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "normal", Ticket.find(@request_id).priority
+  end
+
+  test "a customer's reply with a comment posts it, and leaves priority alone" do
+    api_patch("/requests/#{@request_id}", { request: { priority: "high", comment: { body: "Still broken." } } },
+              token: @avery_token, account: "acme")
+
+    assert_response :ok
+    refute json["request"].key?("priority")
+    assert_equal "normal", Ticket.find(@request_id).priority
+    assert_equal "Still broken.", Ticket.find(@request_id).comments.last.body
+  end
+end
