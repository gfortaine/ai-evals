@@ -0,0 +1,39 @@
+module Api
+  module V1
+    # A customer signs up for a business's portal, chosen by the X-Helpdesk-Account header.
+    # The new user is unverified and gets the usual verification email. After verifying,
+    # they sign in like any other user.
+    class RegistrationsController < ApplicationController
+      def create
+        account = account_from_header!
+        return if performed?
+        return render_error(:forbidden, "account_cancelled", "This business has been cancelled.") if account.cancelled?
+
+        input = require_params(:user).permit(:name, :email, :password)
+        user = User.new(
+          account: account,
+          role: "customer",
+          name: input[:name],
+          email: input[:email],
+          password: input[:password]
+        )
+
+        verification_token = nil
+        # The lock makes this check and the save one step, so an invitation cannot be issued for the same email in between.
+        account.with_lock do
+          # Validate first, so the response reports every problem at once. A pending invitation holds its email.
+          # It is reported as taken, the same as an existing user, so the portal does not reveal who has been invited.
+          user.valid?
+          user.errors.add(:email, :taken) if account.invitations.with_status("pending").exists?(email: user.email)
+          raise ActiveRecord::RecordInvalid, user if user.errors.any?
+
+          user.save!
+          verification_token = EmailVerification.issue!(user)
+        end
+        UserMailer.deliver_safely(:email_verification, user, verification_token)
+
+        render json: { user: user.as_api_json }, status: :created
+      end
+    end
+  end
+end
