diff --git a/.gitignore b/.gitignore
index f305d48..7ba2ab8 100644
--- a/.gitignore
+++ b/.gitignore
@@ -1,2 +1,18 @@
 /.bundle/
 /vendor/bundle/
+
+# Ignore key files for decrypting credentials and more.
+/config/*.key
+
+# Local runtime output
+/log/*
+/tmp/*
+!/log/.keep
+!/tmp/.keep
+/tmp/pids/*
+!/tmp/pids/.keep
+/tmp/mails/
+/public/assets
+
+# Raw inbound mail kept by Active Storage (development and production)
+/storage/
