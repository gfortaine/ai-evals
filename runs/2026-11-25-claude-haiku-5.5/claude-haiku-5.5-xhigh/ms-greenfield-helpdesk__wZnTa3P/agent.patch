@@ -0,0 +1,53 @@
+module Api
+  module V1
+    # Admins manage people in the business: list them, inspect them, and suspend or reinstate them.
+    class UsersController < ApplicationController
+      include Paginated
+
+      before_action :authenticate_session!
+      before_action :require_admin!
+
+      def index
+        errors = {}
+        role = params[:role].presence
+        if role && !User.roles.key?(role)
+          errors[:role] = [ "must be one of #{User.roles.keys.join(", ")}" ]
+        end
+        suspended = nil
+        if params[:suspended].present?
+          suspended = BooleanParam.parse(params[:suspended])
+          errors[:suspended] = [ "must be true or false" ] if suspended.nil?
+        end
+        return render_validation_failed(errors) if errors.any?
+
+        scope = current_account.users.order(:id)
+        scope = scope.where(role: role) if role
+        scope = scope.where(suspended: suspended) unless suspended.nil?
+        render_page(scope, key: "users", &:as_api_json)
+      end
+
+      def show
+        render json: { user: find_user.as_api_json }
+      end
+
+      # Only suspension can be changed here. Other fields are ignored.
+      def update
+        input = require_params(:user).permit(:suspended)
+        user = find_user
+        return render_error(:bad_request, "parameter_missing", "Send suspended: true or false.") unless input.key?(:suspended)
+
+        suspended = BooleanParam.parse(input[:suspended])
+        return render_validation_failed(suspended: [ "must be true or false" ]) if suspended.nil?
+
+        user.set_suspended!(suspended)
+        render json: { user: user.as_api_json }
+      end
+
+      private
+
+      def find_user
+        current_account.users.find(params[:id])
+      end
+    end
+  end
+end
