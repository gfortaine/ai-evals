+require "test_helper"
+
+class TicketGroupsTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+    @avery = user_in("acme", "avery@example.test")
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @sam = user_in("acme", "sam@example.test")
+    @kim_token = invite_and_sign_in!(inviter_token: @owner_token, email: "kim@example.test", name: "Kim")
+    @kim = user_in("acme", "kim@example.test")
+
+    @billing = create_group!("Billing")
+    @support = create_group!("Technical Support")
+    # Not @request: the integration runner sets @request itself on every call.
+    @ticket_id = open_request!(token: @avery_token, subject: "Invoice question")
+  end
+
+  def create_group!(name)
+    api_post("/groups", { group: { name: name } }, token: @owner_token, account: "acme")
+    assert_response :created, response.body
+    json.dig("group", "id")
+  end
+
+  def join!(group, user, default: :omit)
+    body = { group_id: group, user_id: user.id }
+    body[:default] = default unless default == :omit
+    api_post("/group_memberships", { group_membership: body }, token: @owner_token, account: "acme")
+    assert_response :created, response.body
+  end
+
+  # A staff update that must succeed.
+  def staff_update!(ticket_body, id: @ticket_id)
+    api_patch("/tickets/#{id}", { ticket: ticket_body }, token: @owner_token, account: "acme")
+    assert_response :ok, response.body
+    json["ticket"]
+  end
+
+  # A staff update that must be refused. Returns the errors hash, keyed by field.
+  def staff_refused(ticket_body, id: @ticket_id)
+    api_patch("/tickets/#{id}", { ticket: ticket_body }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity, response.body
+    json.dig("error", "errors")
+  end
+
+  def ticket(id = @ticket_id) = Ticket.find(id)
+
+  def staff_list(query = "")
+    api_get("/tickets#{query}", token: @owner_token, account: "acme")
+    assert_response :ok, response.body
+    json["tickets"]
+  end
+
+  test "staff tickets show the group's ID and name, and a request with no group shows none" do
+    row = staff_list.find { |t| t["id"] == @ticket_id }
+    assert_nil row["group_id"]
+    assert_nil row["group"]
+
+    updated = staff_update!({ group_id: @billing })
+    assert_equal({ "id" => @billing, "name" => "Billing" }, updated["group"])
+
+    row = staff_list.find { |t| t["id"] == @ticket_id }
+    assert_equal @billing, row["group_id"]
+    assert_equal({ "id" => @billing, "name" => "Billing" }, row["group"])
+  end
+
+  test "customers never see a request's group" do
+    staff_update!({ group_id: @billing })
+
+    api_get("/requests/#{@ticket_id}", token: @avery_token, account: "acme")
+    assert_response :ok
+    assert_equal %w[created_at id merged_into_id requester_id status subject updated_at], json["request"].keys.sort
+  end
+
+  test "customers cannot move a request to a group, and such an update is a bad request" do
+    api_patch("/requests/#{@ticket_id}", { request: { group_id: @billing } }, token: @avery_token, account: "acme")
+
+    assert_response :bad_request
+    assert_nil ticket.group_id
+  end
+
+  test "requests can be filtered by group, and group_id=unassigned finds the ungrouped ones" do
+    second = open_request!(token: @avery_token, subject: "Login broken")
+    third = open_request!(token: @avery_token, subject: "Refund")
+    staff_update!({ group_id: @billing })
+    staff_update!({ group_id: @support }, id: second)
+
+    assert_equal [ @ticket_id ], staff_list("?group_id=#{@billing}").map { |t| t["id"] }
+    assert_equal [ second ], staff_list("?group_id=#{@support}").map { |t| t["id"] }
+    assert_equal [], staff_list("?group_id=#{@support + 1000}")
+    assert_equal [ third ], staff_list("?group_id=unassigned").map { |t| t["id"] }
+  end
+
+  test "the group filter combines with the other filters" do
+    join!(@billing, @sam)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+    other = open_request!(token: @avery_token, subject: "Login broken")
+    staff_update!({ group_id: @billing }, id: other)
+
+    assert_equal [ @ticket_id ], staff_list("?group_id=#{@billing}&assignee_id=#{@sam.id}").map { |t| t["id"] }
+    assert_equal [ other ], staff_list("?group_id=#{@billing}&assignee_id=unassigned").map { |t| t["id"] }
+    assert_equal [], staff_list("?group_id=#{@support}&assignee_id=#{@sam.id}")
+  end
+
+  test "a group filter that is not an ID is refused" do
+    api_get("/tickets?group_id=billing", token: @owner_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors").key?("group_id")
+  end
+
+  test "moving a request to a group does not move it up the lists or change what the customer sees" do
+    api_get("/requests/#{@ticket_id}", token: @avery_token, account: "acme")
+    customer_view = json
+    updated_at = ticket.updated_at
+
+    staff_update!({ group_id: @billing })
+
+    assert_equal updated_at.to_i, ticket.updated_at.to_i
+    api_get("/requests/#{@ticket_id}", token: @avery_token, account: "acme")
+    assert_equal customer_view, json
+  end
+
+  test "a group in another business is refused, and nothing in the update is saved" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    api_post("/groups", { group: { name: "Billing" } }, token: globex_token, account: "globex")
+    globex_group = json.dig("group", "id")
+
+    errors = staff_refused({ group_id: globex_group, comment: { body: "Moving it." }, status: "pending" })
+
+    assert errors.key?("group_id")
+    assert_nil ticket.group_id
+    assert_equal "open", ticket.status
+    assert_empty ticket.comments.where(body: "Moving it.")
+  end
+
+  test "an unknown group, or something that is not an ID, is refused" do
+    assert staff_refused({ group_id: 999_999 }).key?("group_id")
+    assert staff_refused({ group_id: "12abc" }).key?("group_id")
+    # An object is not a group ID. Like an object assignee, it is not a usable value, so the update is a bad request.
+    api_patch("/tickets/#{@ticket_id}", { ticket: { group_id: { id: @billing } } }, token: @owner_token, account: "acme")
+    assert_response :bad_request
+
+    assert_nil ticket.group_id
+  end
+
+  test "a blank group ID removes the request from its group" do
+    staff_update!({ group_id: @billing })
+
+    staff_update!({ group_id: "" })
+
+    assert_nil ticket.group_id
+  end
+
+  test "a request with no group is put in the assignee's default group" do
+    join!(@billing, @sam, default: true)
+    join!(@support, @sam)
+
+    staff_update!({ assignee_id: @sam.id })
+
+    assert_equal @billing, ticket.group_id
+    assert_equal @sam.id, ticket.assignee_id
+  end
+
+  test "the default group is the one marked as default, not the first membership" do
+    join!(@billing, @sam)
+    join!(@support, @sam, default: true)
+
+    staff_update!({ assignee_id: @sam.id })
+
+    assert_equal @support, ticket.group_id
+  end
+
+  test "assigning someone with no groups to a request with no group leaves the request ungrouped" do
+    staff_update!({ assignee_id: @sam.id })
+
+    assert_equal @sam.id, ticket.assignee_id
+    assert_nil ticket.group_id
+  end
+
+  test "an assignee who is not in the request's group is refused, and nothing in that update is saved" do
+    join!(@billing, @sam)
+    join!(@support, @kim)
+    staff_update!({ group_id: @billing })
+
+    errors = staff_refused({ assignee_id: @kim.id, comment: { body: "Kim, please look." }, status: "pending" })
+
+    assert errors.key?("assignee_id")
+    assert_nil ticket.assignee_id
+    assert_equal @billing, ticket.group_id
+    assert_equal "open", ticket.status
+    assert_empty ticket.comments.where(body: "Kim, please look.")
+  end
+
+  test "a member of the request's group can be assigned, and clearing the assignee leaves the group in place" do
+    join!(@billing, @sam)
+    staff_update!({ group_id: @billing })
+
+    staff_update!({ assignee_id: @sam.id })
+    assert_equal @sam.id, ticket.assignee_id
+
+    staff_update!({ assignee_id: nil })
+    assert_nil ticket.assignee_id
+    assert_equal @billing, ticket.group_id
+  end
+
+  test "moving to another group clears an assignee who is not in it, and keeps one who is" do
+    join!(@billing, @sam)
+    join!(@support, @sam)
+    join!(@billing, @kim)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    staff_update!({ group_id: @support })
+    assert_equal @support, ticket.group_id
+    assert_equal @sam.id, ticket.assignee_id
+
+    staff_update!({ group_id: @billing, assignee_id: @kim.id })
+    staff_update!({ group_id: @support })
+    assert_equal @support, ticket.group_id
+    assert_nil ticket.assignee_id
+  end
+
+  test "moving to another group with an assignee named who is not in it is refused" do
+    join!(@billing, @sam)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    errors = staff_refused({ group_id: @support, assignee_id: @sam.id })
+
+    assert errors.key?("assignee_id")
+    assert_equal @billing, ticket.group_id
+    assert_equal @sam.id, ticket.assignee_id
+  end
+
+  test "moving to another group with an assignee named who is in it is applied in full" do
+    join!(@billing, @sam)
+    join!(@support, @sam)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    staff_update!({ group_id: @support, assignee_id: @sam.id })
+
+    assert_equal @support, ticket.group_id
+    assert_equal @sam.id, ticket.assignee_id
+  end
+
+  test "clearing the group clears the assignee too" do
+    join!(@billing, @sam)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    staff_update!({ group_id: nil })
+
+    assert_nil ticket.group_id
+    assert_nil ticket.assignee_id
+  end
+
+  test "clearing the group with an assignee named in the same update assigns that person, and the group stays empty" do
+    join!(@billing, @sam)
+    join!(@support, @sam, default: true)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    staff_update!({ group_id: nil, assignee_id: @sam.id })
+
+    assert_nil ticket.group_id
+    assert_equal @sam.id, ticket.assignee_id
+  end
+
+  test "a group named in the update is used as given, not replaced by the assignee's default" do
+    join!(@support, @sam, default: true)
+    join!(@billing, @sam)
+
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    assert_equal @billing, ticket.group_id
+  end
+
+  test "a request whose group was cleared gets the assignee's default group back when they are assigned again" do
+    join!(@billing, @sam, default: true)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+    staff_update!({ group_id: nil })
+    assert_nil ticket.group_id
+
+    staff_update!({ assignee_id: @sam.id })
+
+    assert_equal @billing, ticket.group_id
+  end
+
+  test "a group sent with a reply saves with it, and a refused group saves neither" do
+    join!(@billing, @sam)
+    staff_update!({ comment: { body: "Routing this to billing." }, group_id: @billing, status: "pending" })
+    assert_equal @billing, ticket.group_id
+    assert_equal "pending", ticket.status
+    assert_equal "Routing this to billing.", ticket.comments.last.body
+
+    staff_refused({ comment: { body: "Should not appear" }, group_id: 999_999, status: "solved" })
+    assert_equal @billing, ticket.group_id
+    assert_equal "pending", ticket.status
+    refute_includes ticket.comments.map(&:body), "Should not appear"
+  end
+
+  test "a group change is internal, so it does not move the request in the lists" do
+    join!(@billing, @sam)
+    newer = open_request!(token: @avery_token, subject: "Newer request")
+    before = staff_list.map { |t| t["id"] }
+    assert_equal newer, before.first
+
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    assert_equal before, staff_list.map { |t| t["id"] }
+  end
+
+  test "moving a request to a group keeps the assignee when they are in both groups" do
+    join!(@billing, @sam)
+    join!(@support, @sam)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    staff_update!({ group_id: @support })
+
+    assert_equal @sam.id, ticket.assignee_id
+    assert_equal @support, ticket.group_id
+  end
+
+  test "removing someone from the request's group clears them, and the group stays" do
+    join!(@billing, @sam)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+    membership_id = GroupMembership.find_by!(user_id: @sam.id, group_id: @billing).id
+
+    api_delete("/group_memberships/#{membership_id}", token: @owner_token, account: "acme")
+    assert_response :no_content
+
+    assert_nil ticket.assignee_id
+    assert_equal @billing, ticket.group_id
+  end
+
+  test "an assignee who is suspended is cleared, and the request keeps its group" do
+    join!(@billing, @sam)
+    staff_update!({ group_id: @billing, assignee_id: @sam.id })
+
+    api_patch("/users/#{@sam.id}", { user: { suspended: true } }, token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_nil ticket.assignee_id
+    assert_equal @billing, ticket.group_id
+  end
+
+  test "a staff member who is not in a request's group cannot be assigned to it" do
+    join!(@support, @kim)
+    staff_update!({ group_id: @billing })
+
+    assert staff_refused({ assignee_id: @kim.id }).key?("assignee_id")
+
+    assert_nil ticket.assignee_id
+  end
+end
diff --git a/test/integration/ticket_merge_mail_test.rb b/test/integration/ticket_merge_mail_test.rb
new file mode 100644
index 0000000..d964659
--- /dev/null
+++ b/test/integration/ticket_merge_mail_test.rb
@@ -0,0 +1,140 @@
+require "test_helper"
+
+# A merged request is closed to email as well. Its reply address refuses mail, and merge notes send nothing. The
+# request that survives keeps taking replies at its own address, and its requester keeps their thread.
+class TicketMergeMailTest < ActionDispatch::IntegrationTest
+  include InboundMailHelpers
+
+  setup do
+    set_inbound_password
+    signup!
+    @staff_token = verified_sign_in!
+    @acme = Account.find_by!(subdomain: "acme")
+
+    # Two requests from the same customer, both by email.
+    assert_equal 204, relay_mail(build_mail(from: "Avery <avery@example.test>", to: support_address,
+                                            subject: "Cannot download my receipt", body: "The download button does nothing.",
+                                            message_id: "first@example.test"))
+    @duplicate = last_ticket
+    assert_equal 204, relay_mail(build_mail(from: "avery@example.test", to: support_address,
+                                            subject: "Receipt download broken", body: "Same problem, again.",
+                                            message_id: "second@example.test"))
+    @survivor = last_ticket
+    @avery = @survivor.requester
+    ActionMailer::Base.deliveries.clear
+  end
+
+  teardown { restore_inbound_password }
+
+  def merge!(merge: {})
+    api_post("/tickets/#{@duplicate.id}/merge", { merge: { target_id: @survivor.id }.merge(merge) },
+             token: @staff_token, account: "acme")
+  end
+
+  def merge_for!(source, target)
+    api_post("/tickets/#{source.id}/merge", { merge: { target_id: target.id } }, token: @staff_token, account: "acme")
+    assert_response :ok, response.body
+  end
+
+  # Runs the block with the mailbox finding +ticket+ as it was read earlier, instead of reading it again.
+  def with_destination_of(ticket)
+    SupportMailbox.class_eval do
+      alias_method :original_destination, :destination
+      define_method(:destination) { |_message| [ ticket.account, ticket ] }
+    end
+    yield
+  ensure
+    SupportMailbox.class_eval do
+      alias_method :destination, :original_destination
+      remove_method :original_destination
+    end
+  end
+
+  def email_back(to:, body: "It still fails.", message_id: "#{SecureRandom.hex(6)}@example.test")
+    relay_mail(build_mail(from: "avery@example.test", to: to, subject: "Re: Cannot download my receipt",
+                          body: body, message_id: message_id))
+  end
+
+  test "a reply to the closed request's address is refused, and nothing is added or reopened" do
+    merge!
+    assert_response :ok
+
+    assert_no_difference(%w[Ticket.count Comment.count]) do
+      assert_equal 204, email_back(to: @duplicate.reply_address, body: "Late reply.")
+    end
+
+    assert_equal "bounced", ActionMailbox::InboundEmail.last.status
+    assert_equal "closed", @duplicate.reload.status
+    assert_empty Comment.where(body: "Late reply.")
+  end
+
+  test "the request that survives still takes replies at its own address" do
+    merge!
+
+    assert_equal 204, email_back(to: @survivor.reply_address, body: "This one is still broken.")
+
+    assert_equal "delivered", ActionMailbox::InboundEmail.last.status
+    assert_equal "This one is still broken.", @survivor.comments.order(:id).last.body
+    assert_equal "open", @survivor.reload.status
+    assert_equal "closed", @duplicate.reload.status
+  end
+
+  test "after a refused reply to the closed request, replies to the surviving request still arrive" do
+    merge!
+    email_back(to: @duplicate.reply_address, body: "Refused.")
+    email_back(to: @survivor.reply_address, body: "Accepted.")
+
+    assert_equal [ "Accepted." ], Comment.where(body: [ "Refused.", "Accepted." ]).map(&:body)
+  end
+
+  test "a staff reply to the closed request is refused, and no email goes out" do
+    merge!
+    ActionMailer::Base.deliveries.clear
+
+    api_patch("/tickets/#{@duplicate.id}", { ticket: { comment: { body: "Following up." } } },
+              token: @staff_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_equal "ticket_closed", json.dig("error", "code")
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "merge notes send no email, even when public, on a request that came in by email" do
+    merge!(merge: { source_comment: { body: "Continuing in the other request.", public: true },
+                    target_comment: { body: "Thanks, merged.", public: true } })
+
+    assert_response :ok
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "a reply the mailbox read before the merge is refused under the request's lock, and nothing is saved" do
+    raw_request = build_mail(from: "avery@example.test", to: support_address, subject: "Receipt, third time",
+                             body: "A third one.", message_id: "third@example.test")
+    assert_equal 204, relay_mail(raw_request)
+    third = last_ticket
+    stale = Ticket.find(third.id) # the copy the mailbox holds, read while the request is still open
+    merge_for!(third, @survivor)
+    assert_equal "closed", third.reload.status
+    assert_equal false, stale.closed?
+
+    # Make the mailbox use the stale copy, so only the check under the request's lock can refuse the reply.
+    with_destination_of(stale) do
+      assert_equal 204, email_back(to: third.reply_address, body: "Arrived late.", message_id: "late@example.test")
+    end
+
+    assert_equal "bounced", ActionMailbox::InboundEmail.last.status
+    assert_empty Comment.where(body: "Arrived late.")
+    assert_equal "closed", third.reload.status
+  end
+
+  test "a public staff reply on the surviving request is still emailed to the requester" do
+    merge!
+    ActionMailer::Base.deliveries.clear
+
+    api_patch("/tickets/#{@survivor.id}", { ticket: { comment: { body: "Fixed in the new build." } } },
+              token: @staff_token, account: "acme")
+
+    assert_response :ok
+    assert_equal [ "avery@example.test" ], ActionMailer::Base.deliveries.last.to
+  end
+end
diff --git a/test/integration/ticket_merges_test.rb b/test/integration/ticket_merges_test.rb
new file mode 100644
index 0000000..f3b4fd9
--- /dev/null
+++ b/test/integration/ticket_merges_test.rb
@@ -0,0 +1,476 @@
+require "test_helper"
+
+# Merging a duplicate request into another request of the same customer. The duplicate is closed and points at the
+# request that survives. Both views show the pointer, and both can filter for closed requests.
+class TicketMergesTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @avery_token = customer_sign_in!
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @sam = user_in("acme", "sam@example.test")
+    @duplicate = open_request!(token: @avery_token, subject: "Receipt download broken")
+    @survivor = open_request!(token: @avery_token, subject: "Receipt download broken, again")
+  end
+
+  def merge!(source: @duplicate, target: @survivor, merge: {}, token: @owner_token, account: "acme")
+    api_post("/tickets/#{source}/merge", { merge: { target_id: target }.merge(merge) }, token: token, account: account)
+  end
+
+  def stored(id) = Ticket.find(id)
+  def comments_on(id) = Comment.where(ticket_id: id).order(:id)
+
+  # The fields a merge must leave alone on the request that survives.
+  SURVIVOR_FIELDS = %w[status assignee_id group_id priority reply_key origin requester_id subject].freeze
+
+  # --- the merge itself ---------------------------------------------------------------------------------------
+
+  test "staff merge a duplicate into a request of the same customer, and both come back as tickets" do
+    merge!
+
+    assert_response :ok
+    assert_equal %w[source target], json.keys.sort
+    assert_equal @duplicate, json.dig("source", "id")
+    assert_equal "closed", json.dig("source", "status")
+    assert_equal @survivor, json.dig("source", "merged_into_id")
+    assert_equal @survivor, json.dig("target", "id")
+    assert_nil json.dig("target", "merged_into_id")
+    assert_equal "closed", stored(@duplicate).status
+    assert_equal @survivor, stored(@duplicate).merged_into_id
+  end
+
+  test "agents can merge too" do
+    merge!(token: @sam_token)
+
+    assert_response :ok
+    assert_equal @survivor, stored(@duplicate).merged_into_id
+  end
+
+  test "the surviving request keeps its status, assignee, group, priority and reply address" do
+    api_patch("/tickets/#{@survivor}", { ticket: { status: "pending", assignee_id: @sam.id, priority: "high" } },
+              token: @owner_token, account: "acme")
+    assert_response :ok
+    before = stored(@survivor).attributes.slice(*SURVIVOR_FIELDS)
+
+    merge!
+
+    assert_response :ok
+    assert_equal before, stored(@survivor).attributes.slice(*SURVIVOR_FIELDS)
+    assert_nil stored(@survivor).merged_into_id
+  end
+
+  test "a solved surviving request stays solved, and the merge does not reopen it" do
+    api_patch("/tickets/#{@survivor}", { ticket: { status: "solved" } }, token: @owner_token, account: "acme")
+
+    merge!
+
+    assert_equal "solved", stored(@survivor).status
+    assert_equal "solved", json.dig("target", "status")
+  end
+
+  test "the duplicate keeps its own comments, which do not move to the survivor" do
+    api_patch("/requests/#{@duplicate}", { request: { comment: { body: "Still broken on Safari." } } },
+              token: @avery_token, account: "acme")
+    old_ids = comments_on(@duplicate).pluck(:id)
+
+    merge!
+
+    assert_response :ok
+    assert_equal old_ids, comments_on(@duplicate).pluck(:id).first(old_ids.size)
+    assert_empty Comment.where(ticket_id: @survivor, body: "Still broken on Safari.")
+  end
+
+  test "a refused merge changes nothing, including the comments" do
+    merge!(target: 999_999_999)
+
+    assert_response :unprocessable_entity
+    assert_equal "open", stored(@duplicate).status
+    assert_nil stored(@duplicate).merged_into_id
+    assert_equal 1, comments_on(@duplicate).count
+    assert_equal 1, comments_on(@survivor).count
+  end
+
+  # --- the notes -----------------------------------------------------------------------------------------------
+
+  test "by default each side gets a private note that explains the merge" do
+    merge!
+
+    assert_response :ok
+    duplicate_note = comments_on(@duplicate).last
+    assert_equal "Merged into ##{@survivor}. The conversation continues there.", duplicate_note.body
+    assert_equal false, duplicate_note.public
+    assert_equal user_in("acme", "jo@acme.test"), duplicate_note.author
+
+    survivor_note = comments_on(@survivor).last
+    assert_equal "Merged in from ##{@duplicate}.", survivor_note.body
+    assert_equal false, survivor_note.public
+  end
+
+  test "staff write each note and choose whether it is public" do
+    merge!(merge: { source_comment: { body: "Continuing in ticket #{@survivor}.", public: true },
+                    target_comment: { body: "Duplicate checked.", public: false } })
+
+    assert_response :ok
+    assert_equal [ "Continuing in ticket #{@survivor}.", true ], [ comments_on(@duplicate).last.body, comments_on(@duplicate).last.public ]
+    assert_equal [ "Duplicate checked.", false ], [ comments_on(@survivor).last.body, comments_on(@survivor).last.public ]
+  end
+
+  test "a note sent without public is private, and a note sent without a body takes the default text" do
+    merge!(merge: { source_comment: { public: true }, target_comment: { body: "Checked." } })
+
+    assert_response :ok
+    assert_equal [ "Merged into ##{@survivor}. The conversation continues there.", true ],
+                 [ comments_on(@duplicate).last.body, comments_on(@duplicate).last.public ]
+    assert_equal [ "Checked.", false ], [ comments_on(@survivor).last.body, comments_on(@survivor).last.public ]
+  end
+
+  test "a public note on the duplicate is seen by the customer, and a private one is not" do
+    merge!(merge: { source_comment: { body: "Please follow the other request.", public: true },
+                    target_comment: { body: "Internal only.", public: false } })
+
+    api_get("/requests/#{@duplicate}/comments", token: @avery_token, account: "acme")
+    assert_includes json["comments"].map { |c| c["body"] }, "Please follow the other request."
+
+    api_get("/requests/#{@survivor}/comments", token: @avery_token, account: "acme")
+    refute_includes json["comments"].map { |c| c["body"] }, "Internal only."
+  end
+
+  test "a public note counts as activity, a private one does not" do
+    survivor_updated_at = stored(@survivor).updated_at
+
+    travel 1.hour do
+      merge!(merge: { target_comment: { body: "Private.", public: false } })
+    end
+    assert_equal survivor_updated_at, stored(@survivor).updated_at
+
+    travel 2.hours do
+      merge!(source: open_request!(token: @avery_token, subject: "Third"),
+             merge: { target_comment: { body: "Public.", public: true } })
+    end
+    assert stored(@survivor).updated_at > survivor_updated_at
+  end
+
+  test "merge notes send no email, even when public" do
+    ActionMailer::Base.deliveries.clear # the setup's sign-up and invitation mail is not the merge's
+    merge!(merge: { source_comment: { body: "Public one.", public: true },
+                    target_comment: { body: "Public two.", public: true } })
+
+    assert_response :ok
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "a note with no text, text that is not a string, or a bad public flag is refused, and nothing is merged" do
+    [
+      [ { source_comment: { body: "" } }, "source_comment.body" ],
+      [ { source_comment: { body: "   " } }, "source_comment.body" ],
+      [ { target_comment: { body: 42 } }, "target_comment.body" ],
+      [ { source_comment: { body: "Ok.", public: "maybe" } }, "source_comment.public" ],
+      [ { target_comment: { body: "Ok.", public: nil } }, "target_comment.public" ],
+      [ { source_comment: "just text" }, "source_comment" ],
+      [ { target_comment: [ "a" ] }, "target_comment" ]
+    ].each do |merge, key|
+      merge!(merge: merge)
+
+      assert_response :unprocessable_entity, "#{merge.inspect} should be refused"
+      assert json.dig("error", "errors", key).present?, "#{merge.inspect} should name #{key}"
+      assert_equal "open", stored(@duplicate).status
+      assert_nil stored(@duplicate).merged_into_id
+      assert_equal 1, comments_on(@duplicate).count
+      assert_equal 1, comments_on(@survivor).count
+    end
+  end
+
+  test "a note over the length limit is refused" do
+    merge!(merge: { source_comment: { body: "x" * (Comment::MAX_BODY_LENGTH + 1) } })
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "source_comment.body").present?
+    assert_equal "open", stored(@duplicate).status
+  end
+
+  # --- what the customer and staff see ---------------------------------------------------------------------------
+
+  test "every request shows merged_into_id, null until it is merged, to staff and to the customer" do
+    api_get("/tickets", token: @owner_token, account: "acme")
+    assert_equal [ nil, nil ], json["tickets"].map { |t| t["merged_into_id"] }
+
+    merge!
+
+    api_get("/tickets", token: @owner_token, account: "acme")
+    by_id = json["tickets"].index_by { |t| t["id"] }
+    assert_equal @survivor, by_id[@duplicate]["merged_into_id"]
+    assert_nil by_id[@survivor]["merged_into_id"]
+
+    api_get("/requests", token: @avery_token, account: "acme")
+    by_id = json["requests"].index_by { |r| r["id"] }
+    assert_equal @survivor, by_id[@duplicate]["merged_into_id"]
+    assert_nil by_id[@survivor]["merged_into_id"]
+  end
+
+  test "a customer follows the link from the closed request to the one that survives" do
+    merge!
+
+    api_get("/requests/#{@duplicate}", token: @avery_token, account: "acme")
+    assert_response :ok
+    assert_equal "closed", json.dig("request", "status")
+    next_id = json.dig("request", "merged_into_id")
+
+    api_get("/requests/#{next_id}", token: @avery_token, account: "acme")
+    assert_equal @survivor, json.dig("request", "id")
+    assert_nil json.dig("request", "merged_into_id")
+  end
+
+  test "a closed request stays readable, with its conversation, to the customer and to staff" do
+    merge!
+
+    api_get("/requests/#{@duplicate}/comments", token: @avery_token, account: "acme")
+    assert_response :ok
+    assert_equal [ "The download button does nothing." ], json["comments"].map { |c| c["body"] }
+
+    api_get("/tickets/#{@duplicate}", token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal "closed", json.dig("ticket", "status")
+    api_get("/tickets/#{@duplicate}/comments", token: @owner_token, account: "acme")
+    assert_response :ok
+  end
+
+  test "both views can filter for closed requests" do
+    merge!
+
+    api_get("/tickets?status=closed", token: @owner_token, account: "acme")
+    assert_equal [ @duplicate ], json["tickets"].map { |t| t["id"] }
+
+    api_get("/requests?status=closed", token: @avery_token, account: "acme")
+    assert_equal [ @duplicate ], json["requests"].map { |r| r["id"] }
+
+    api_get("/requests?status=open", token: @avery_token, account: "acme")
+    assert_equal [ @survivor ], json["requests"].map { |r| r["id"] }
+  end
+
+  # --- closed requests refuse edits -----------------------------------------------------------------------------
+
+  test "staff cannot close a request by hand, only a merge can" do
+    api_patch("/tickets/#{@survivor}", { ticket: { status: "closed" } }, token: @owner_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "status").present?
+    assert_equal "open", stored(@survivor).status
+  end
+
+  test "a closed request refuses staff replies, status changes, assignments, groups and priority" do
+    merge!
+
+    [
+      { ticket: { comment: { body: "Reopening?" }, status: "open" } },
+      { ticket: { assignee_id: @sam.id } },
+      { ticket: { priority: "high" } },
+      { ticket: { comment: { body: "Private?", public: false } } }
+    ].each do |body|
+      api_patch("/tickets/#{@duplicate}", body, token: @owner_token, account: "acme")
+      assert_response :unprocessable_entity, body.inspect
+      assert_equal "ticket_closed", json.dig("error", "code")
+    end
+
+    assert_equal "closed", stored(@duplicate).status
+    assert_nil stored(@duplicate).assignee_id
+    assert_equal "normal", stored(@duplicate).priority
+    assert_empty Comment.where(ticket_id: @duplicate, body: [ "Reopening?", "Private?" ])
+  end
+
+  test "a closed request refuses customer replies and solving, and nothing is saved" do
+    merge!
+
+    api_patch("/requests/#{@duplicate}", { request: { comment: { body: "Still here?" } } }, token: @avery_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert_equal "ticket_closed", json.dig("error", "code")
+
+    api_patch("/requests/#{@duplicate}", { request: { status: "solved" } }, token: @avery_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert_equal "ticket_closed", json.dig("error", "code")
+
+    assert_equal "closed", stored(@duplicate).status
+    assert_empty Comment.where(ticket_id: @duplicate, body: "Still here?")
+  end
+
+  test "a closed request cannot be merged again, and cannot take a merge" do
+    merge!
+    third = open_request!(token: @avery_token, subject: "A third request")
+
+    merge!(source: @duplicate, target: third)
+    assert_response :unprocessable_entity
+    assert_equal "ticket_closed", json.dig("error", "code")
+    assert_equal @survivor, stored(@duplicate).merged_into_id
+
+    merge!(source: third, target: @duplicate)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "target_id").present?
+    assert_equal "open", stored(third).status
+  end
+
+  # --- links stay as they were -------------------------------------------------------------------------------
+
+  test "when the surviving request is merged later, the earlier link stays as it was" do
+    merge!
+    duplicate_comments = comments_on(@duplicate).pluck(:id)
+    third = open_request!(token: @avery_token, subject: "The real one")
+
+    merge!(source: @survivor, target: third)
+
+    assert_response :ok
+    assert_equal @survivor, stored(@duplicate).merged_into_id
+    assert_equal third, stored(@survivor).merged_into_id
+    assert_equal "closed", stored(@survivor).status
+    assert_equal duplicate_comments, comments_on(@duplicate).pluck(:id)
+
+    api_get("/requests/#{@duplicate}", token: @avery_token, account: "acme")
+    assert_equal @survivor, json.dig("request", "merged_into_id")
+  end
+
+  # --- targets that are refused ------------------------------------------------------------------------------
+
+  test "the duplicate and the target must belong to the same customer" do
+    kim_token = customer_sign_in!(email: "kim@example.test")
+    kims = open_request!(token: kim_token, subject: "Kim's request")
+
+    merge!(target: kims)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "target_id").present?
+    assert_equal "open", stored(@duplicate).status
+  end
+
+  test "a request in another business cannot be the target, and nothing is saved" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    globex_avery = customer_sign_in!(email: "avery@globex.test", account: "globex")
+    globex_request = open_request!(token: globex_avery, account: "globex")
+
+    merge!(target: globex_request)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "target_id").present?
+    assert_equal "open", stored(@duplicate).status
+
+    # And the other business cannot merge this business's request either.
+    merge!(token: globex_token, account: "globex")
+    assert_response :not_found
+    assert_equal "open", stored(@duplicate).status
+  end
+
+  test "a target that is the duplicate itself, does not exist, or is not an ID is refused" do
+    [ @duplicate, 999_999_999, "abc", "1.5", nil, -4 ].each do |target|
+      merge!(target: target)
+
+      assert_response :unprocessable_entity, "target #{target.inspect} should be refused"
+      assert json.dig("error", "errors", "target_id").present?, "target #{target.inspect} should name target_id"
+    end
+    assert_equal "open", stored(@duplicate).status
+    assert_nil stored(@duplicate).merged_into_id
+  end
+
+  test "a merge without a target is a bad request, and so is one without the envelope" do
+    api_post("/tickets/#{@duplicate}/merge", { merge: { source_comment: { body: "Hi." } } }, token: @owner_token, account: "acme")
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+
+    api_post("/tickets/#{@duplicate}/merge", { target_id: @survivor }, token: @owner_token, account: "acme")
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "customers cannot merge, and an unknown duplicate is not found" do
+    api_post("/tickets/#{@duplicate}/merge", { merge: { target_id: @survivor } }, token: @avery_token, account: "acme")
+    assert_response :forbidden
+    assert_equal "staff_only", json.dig("error", "code")
+    assert_equal "open", stored(@duplicate).status
+
+    merge!(source: 999_999_999)
+    assert_response :not_found
+  end
+
+  # --- assignment cleanup still applies to closed requests -------------------------------------------------------
+
+  test "suspending the assignee clears a closed request's assignment, and the request stays closed" do
+    api_patch("/tickets/#{@duplicate}", { ticket: { assignee_id: @sam.id } }, token: @owner_token, account: "acme")
+    assert_response :ok
+    merge!
+    assert_response :ok
+
+    api_patch("/users/#{@sam.id}", { user: { suspended: true } }, token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_nil stored(@duplicate).assignee_id
+    assert_equal "closed", stored(@duplicate).status
+    assert_equal @survivor, stored(@duplicate).merged_into_id
+  end
+
+  test "removing an assignee from the group clears a closed request's assignment, and the group stays" do
+    api_post("/groups", { group: { name: "Billing" } }, token: @owner_token, account: "acme")
+    billing = json.dig("group", "id")
+    api_post("/group_memberships", { group_membership: { group_id: billing, user_id: @sam.id } }, token: @owner_token, account: "acme")
+    assert_response :created
+    membership = json.dig("group_membership", "id")
+    api_patch("/tickets/#{@duplicate}", { ticket: { group_id: billing, assignee_id: @sam.id } }, token: @owner_token, account: "acme")
+    assert_response :ok
+    merge!
+    assert_response :ok
+
+    api_delete("/group_memberships/#{membership}", token: @owner_token, account: "acme")
+
+    assert_response :no_content
+    assert_nil stored(@duplicate).assignee_id
+    assert_equal billing, stored(@duplicate).group_id
+    assert_equal "closed", stored(@duplicate).status
+  end
+
+  test "deleting the group clears a closed request's group and assignment" do
+    api_post("/groups", { group: { name: "Billing" } }, token: @owner_token, account: "acme")
+    billing = json.dig("group", "id")
+    api_patch("/tickets/#{@duplicate}", { ticket: { group_id: billing } }, token: @owner_token, account: "acme")
+    merge!
+
+    api_delete("/groups/#{billing}", token: @owner_token, account: "acme")
+
+    assert_response :no_content
+    assert_nil stored(@duplicate).group_id
+    assert_equal "closed", stored(@duplicate).status
+  end
+
+  # --- deleting a business -------------------------------------------------------------------------------------
+
+  test "purging a business removes merged requests even when the surviving one is deleted first" do
+    # The newer request merges into the older one, so the purge deletes the survivor (the older id) first, while the
+    # duplicate still points at it. The pointer is nullified rather than blocking the delete.
+    merge!(source: @survivor, target: @duplicate)
+    assert_response :ok
+    assert_equal @duplicate, stored(@survivor).merged_into_id
+
+    Account.find_by!(subdomain: "acme").cancel!(now: 91.days.ago)
+
+    assert_equal 1, Account.purge_cancelled!
+    assert_equal 0, Ticket.where(id: [ @duplicate, @survivor ]).count
+  end
+
+  # --- concurrent edits ----------------------------------------------------------------------------------------
+
+  test "a reply that was loaded before the merge is refused once the merge has closed the request" do
+    stale = stored(@duplicate)
+    merge!
+    avery = user_in("acme", "avery@example.test")
+
+    assert_raises(Ticket::Closed) { stale.reply!(author: avery, body: "A late reply.", customer: true) }
+    assert_empty Comment.where(ticket_id: @duplicate, body: "A late reply.")
+  end
+
+  test "a merge checks the target's current state, not a copy loaded earlier" do
+    stale_duplicate = stored(@duplicate)
+    third = open_request!(token: @avery_token, subject: "A third request")
+    merge!(source: @survivor, target: third) # closes the survivor after stale_duplicate was loaded
+    assert_equal "closed", stored(@survivor).status
+
+    assert_raises(ActiveRecord::RecordInvalid) do
+      stale_duplicate.merge_into!(target_id: @survivor, author: user_in("acme", "jo@acme.test"))
+    end
+    assert_equal "open", stored(@duplicate).status
+    assert_nil stored(@duplicate).merged_into_id
+  end
+end
diff --git a/test/integration/ticket_priority_test.rb b/test/integration/ticket_priority_test.rb
new file mode 100644
index 0000000..e87b3ca
--- /dev/null
+++ b/test/integration/ticket_priority_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class TicketPriorityTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+    @avery = user_in("acme", "avery@example.test")
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @request_id = open_request!(token: @avery_token)
+  end
+
+  def staff_update!(token: @owner_token, **body)
+    api_patch("/tickets/#{@request_id}", { ticket: body }, token: token, account: "acme")
+  end
+
+  test "a new request is normal priority, for staff" do
+    api_get("/tickets/#{@request_id}", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal "normal", json.dig("ticket", "priority")
+    assert_equal "normal", Ticket.find(@request_id).priority
+  end
+
+  test "the staff list shows priority on every ticket" do
+    api_get("/tickets", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal %w[assignee assignee_id created_at group group_id id merged_into_id priority requester status subject updated_at],
+                 json["tickets"].first.keys.sort
+  end
+
+  test "staff raise a request to high and lower it again, and the response shows the change" do
+    staff_update!(priority: "high")
+    assert_response :ok
+    assert_equal "high", json.dig("ticket", "priority")
+    assert_equal "high", Ticket.find(@request_id).priority
+
+    staff_update!(priority: "normal")
+    assert_response :ok
+    assert_equal "normal", json.dig("ticket", "priority")
+    assert_equal "normal", Ticket.find(@request_id).priority
+  end
+
+  test "agents can set priority too" do
+    staff_update!(priority: "high", token: @sam_token)
+
+    assert_response :ok
+    assert_equal "high", json.dig("ticket", "priority")
+  end
+
+  test "a priority change alone does not move the request or change its updated_at" do
+    newer = open_request!(token: @avery_token, subject: "Newer one")
+    updated_at = Ticket.find(@request_id).updated_at
+
+    staff_update!(priority: "high")
+
+    assert_response :ok
+    assert_equal updated_at, Ticket.find(@request_id).updated_at
+    api_get("/requests", token: @avery_token, account: "acme")
+    assert_equal [ newer, @request_id ], json["requests"].map { |r| r["id"] }
+  end
+
+  test "a priority change leaves the customer's view of the request unchanged" do
+    api_get("/requests/#{@request_id}", token: @avery_token, account: "acme")
+    before = json["request"]
+
+    staff_update!(priority: "high")
+
+    api_get("/requests/#{@request_id}", token: @avery_token, account: "acme")
+    assert_equal before, json["request"]
+  end
+
+  test "priority is applied together with a comment and a status, in one update" do
+    staff_update!(priority: "high", status: "pending", comment: { body: "Escalating this." })
+
+    assert_response :ok
+    ticket = Ticket.find(@request_id)
+    assert_equal "high", ticket.priority
+    assert_equal "pending", ticket.status
+    assert_equal "Escalating this.", ticket.comments.last.body
+  end
+
+  test "an invalid priority is refused, and nothing in the same update is saved" do
+    staff_update!(priority: "urgent", status: "pending", comment: { body: "Urgent!" })
+
+    assert_response :unprocessable_entity
+    assert_equal "priority", json.dig("error", "errors").keys.first
+    assert json.dig("error", "errors", "priority").present?
+    ticket = Ticket.find(@request_id)
+    assert_equal "normal", ticket.priority
+    assert_equal "open", ticket.status
+    assert_equal 1, ticket.comments.count
+  end
+
+  test "priority cannot be cleared or set to a non-value" do
+    [ nil, "", "HIGH", "Normal", "low", 1, true ].each do |value|
+      staff_update!(priority: value)
+
+      assert_response :unprocessable_entity, "accepted #{value.inspect}"
+      assert json.dig("error", "errors", "priority").present?
+    end
+    assert_equal "normal", Ticket.find(@request_id).priority
+  end
+
+  test "a priority that is an object or a list is refused, not ignored, and its comment is not posted" do
+    [ { "level" => "high" }, [ "high" ] ].each do |value|
+      api_patch("/tickets/#{@request_id}", { ticket: { priority: value, comment: { body: "Escalating." } } },
+                token: @owner_token, account: "acme")
+
+      assert_response :unprocessable_entity, "accepted #{value.inspect}"
+      assert json.dig("error", "errors", "priority").present?
+    end
+    ticket = Ticket.find(@request_id)
+    assert_equal "normal", ticket.priority
+    assert_equal 1, ticket.comments.count
+  end
+
+  test "customers cannot open a request as high priority" do
+    api_post("/requests", { request: { subject: "Urgent", comment: { body: "Help!" }, priority: "high" } },
+             token: @avery_token, account: "acme")
+
+    assert_response :created
+    refute json["request"].key?("priority")
+    assert_equal "normal", Ticket.find(json.dig("request", "id")).priority
+  end
+
+  test "customers never see priority" do
+    staff_update!(priority: "high")
+
+    api_get("/requests", token: @avery_token, account: "acme")
+    assert_equal %w[created_at id merged_into_id requester_id status subject updated_at], json["requests"].first.keys.sort
+
+    api_get("/requests/#{@request_id}", token: @avery_token, account: "acme")
+    assert_equal %w[created_at id merged_into_id requester_id status subject updated_at], json["request"].keys.sort
+  end
+
+  test "customers cannot change priority, and a priority-only update is a bad request" do
+    api_patch("/requests/#{@request_id}", { request: { priority: "high" } }, token: @avery_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "normal", Ticket.find(@request_id).priority
+  end
+
+  test "a customer's reply with a comment posts it, and leaves priority alone" do
+    api_patch("/requests/#{@request_id}", { request: { priority: "high", comment: { body: "Still broken." } } },
+              token: @avery_token, account: "acme")
+
+    assert_response :ok
+    refute json["request"].key?("priority")
+    assert_equal "normal", Ticket.find(@request_id).priority
+    assert_equal "Still broken.", Ticket.find(@request_id).comments.last.body
+  end
+end
diff --git a/test/integration/user_management_test.rb b/test/integration/user_management_test.rb
new file mode 100644
index 0000000..13344ba
--- /dev/null
+++ b/test/integration/user_management_test.rb
@@ -0,0 +1,267 @@
+require "test_helper"
+
+class UserManagementTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+    @avery = user_in("acme", "avery@example.test")
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @sam = user_in("acme", "sam@example.test")
+  end
+
+  def suspend!(user, value = true, token: @owner_token)
+    api_patch("/users/#{user.id}", { user: { suspended: value } }, token: token, account: "acme")
+  end
+
+  test "admins list users by ID ascending, with the page metadata and suspension" do
+    api_get("/users", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal %w[count next_page page per_page previous_page users], json.keys.sort
+    assert_equal [ @owner.id, @avery.id, @sam.id ], json["users"].map { |u| u["id"] }
+    assert_equal %w[account_id created_at email id name role suspended updated_at verified verified_at], json["users"].first.keys.sort
+    assert_equal [ false, false, false ], json["users"].map { |u| u["suspended"] }
+  end
+
+  test "users can be filtered by role" do
+    api_get("/users?role=agent", token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal [ "sam@example.test" ], json["users"].map { |u| u["email"] }
+
+    api_get("/users?role=customer", token: @owner_token, account: "acme")
+    assert_equal [ "avery@example.test" ], json["users"].map { |u| u["email"] }
+  end
+
+  test "users can be filtered by suspension" do
+    suspend!(@sam)
+    assert_response :ok
+
+    api_get("/users?suspended=true", token: @owner_token, account: "acme")
+    assert_equal [ "sam@example.test" ], json["users"].map { |u| u["email"] }
+    assert_equal [ true ], json["users"].map { |u| u["suspended"] }
+
+    api_get("/users?suspended=false", token: @owner_token, account: "acme")
+    assert_equal [ @owner.id, @avery.id ], json["users"].map { |u| u["id"] }
+  end
+
+  test "an unknown role or a non-boolean suspension filter is refused" do
+    api_get("/users?role=superuser", token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "role").present?
+
+    api_get("/users?suspended=maybe", token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "suspended").present?
+  end
+
+  test "admins inspect one user, and a user from another business is not found" do
+    api_get("/users/#{@avery.id}", token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal "avery@example.test", json.dig("user", "email")
+    assert_equal false, json.dig("user", "suspended")
+
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    api_get("/users/#{@avery.id}", token: globex_token, account: "globex")
+    assert_response :not_found
+  end
+
+  test "agents and customers cannot manage people" do
+    [ @avery_token, @sam_token ].each do |token|
+      api_get("/users", token: token, account: "acme")
+      assert_response :forbidden
+      assert_equal "admin_only", json.dig("error", "code")
+
+      api_get("/users/#{@avery.id}", token: token, account: "acme")
+      assert_response :forbidden
+
+      api_patch("/users/#{@avery.id}", { user: { suspended: true } }, token: token, account: "acme")
+      assert_response :forbidden
+    end
+    refute @avery.reload.suspended?
+  end
+
+  test "suspending a user signs them out of every session" do
+    assert_equal 1, Session.where(user: @sam).count, "sam signed in once"
+
+    suspend!(@sam)
+
+    assert_response :ok
+    assert_equal true, json.dig("user", "suspended")
+    assert_equal 0, Session.where(user: @sam).count
+    api_get("/me", token: @sam_token, account: "acme")
+    assert_response :unauthorized
+  end
+
+  test "a suspended user cannot sign in, and reinstating them lets them sign in again" do
+    suspend!(@sam)
+
+    api_post("/sessions", { session: { email: "sam@example.test", password: TEAM_PASSWORD } }, account: "acme")
+    assert_response :forbidden
+    assert_equal "user_suspended", json.dig("error", "code")
+
+    suspend!(@sam, false)
+    assert_response :ok
+    assert_equal false, json.dig("user", "suspended")
+
+    sign_in!(email: "sam@example.test", password: TEAM_PASSWORD)
+  end
+
+  test "reinstating does not bring back the old sessions" do
+    suspend!(@sam)
+    suspend!(@sam, false)
+
+    api_get("/me", token: @sam_token, account: "acme")
+    assert_response :unauthorized
+  end
+
+  test "suspending clears the person's ticket assignments, without moving the requests in the lists" do
+    request_id = open_request!(token: @avery_token)
+    api_patch("/tickets/#{request_id}", { ticket: { assignee_id: @sam.id } }, token: @owner_token, account: "acme")
+    assert_equal @sam.id, json.dig("ticket", "assignee_id")
+    updated_at_before = Ticket.find(request_id).updated_at
+
+    suspend!(@sam)
+
+    ticket = Ticket.find(request_id)
+    assert_nil ticket.assignee_id
+    assert_equal updated_at_before.to_i, ticket.updated_at.to_i
+    api_get("/tickets/#{request_id}", token: @owner_token, account: "acme")
+    assert_nil json.dig("ticket", "assignee")
+  end
+
+  test "suspending a customer stops them signing in" do
+    suspend!(@avery)
+
+    assert_response :ok
+    api_post("/sessions", { session: { email: "avery@example.test", password: CUSTOMER_PASSWORD } }, account: "acme")
+    assert_response :forbidden
+    assert_equal "user_suspended", json.dig("error", "code")
+  end
+
+  test "the last active admin cannot be suspended, not even by themselves" do
+    suspend!(@owner)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "suspended").present?
+    refute @owner.reload.suspended?
+    api_get("/me", token: @owner_token, account: "acme")
+    assert_response :ok
+  end
+
+  test "an admin can be suspended while another active admin remains, and then the remaining one is the last" do
+    ann_token = invite_and_sign_in!(inviter_token: @owner_token, email: "ann@acme.test", role: "admin", name: "Ann")
+    ann = user_in("acme", "ann@acme.test")
+
+    suspend!(@owner, token: ann_token)
+    assert_response :ok
+    assert_equal true, json.dig("user", "suspended")
+
+    suspend!(ann, token: ann_token)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "suspended").present?
+    refute ann.reload.suspended?
+  end
+
+  test "a suspended admin does not count as an active admin" do
+    invite_and_sign_in!(inviter_token: @owner_token, email: "ann@acme.test", role: "admin", name: "Ann")
+    ann = user_in("acme", "ann@acme.test")
+    suspend!(ann)
+    assert_response :ok
+
+    suspend!(@owner)
+    assert_response :unprocessable_entity
+    assert_equal true, ann.reload.suspended?
+  end
+
+  test "suspending a non-admin never trips the last admin rule" do
+    suspend!(@sam)
+    assert_response :ok
+  end
+
+  test "suspending a user twice is harmless" do
+    suspend!(@sam)
+    suspend!(@sam)
+
+    assert_response :ok
+    assert_equal true, json.dig("user", "suspended")
+  end
+
+  test "a non-boolean suspended value is refused" do
+    api_patch("/users/#{@sam.id}", { user: { suspended: "maybe" } }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "suspended").present?
+
+    api_patch("/users/#{@sam.id}", { user: { suspended: nil } }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+
+    refute @sam.reload.suspended?
+  end
+
+  test "a PATCH with no suspended value is a bad request, and other fields are ignored" do
+    api_patch("/users/#{@sam.id}", { user: { name: "Renamed" } }, token: @owner_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+    assert_equal "Sam", @sam.reload.name
+  end
+
+  test "suspension is per business, so another business's user cannot be touched" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+
+    api_patch("/users/#{@sam.id}", { user: { suspended: true } }, token: globex_token, account: "globex")
+
+    assert_response :not_found
+    refute @sam.reload.suspended?
+  end
+
+  test "staff choices list active admins and agents, by ID, leaving out customers and suspended staff" do
+    invite_and_sign_in!(inviter_token: @owner_token, email: "ann@acme.test", role: "admin", name: "Ann")
+    ann = user_in("acme", "ann@acme.test")
+    invite_and_sign_in!(inviter_token: @owner_token, email: "bo@acme.test", name: "Bo")
+    bo = user_in("acme", "bo@acme.test")
+    suspend!(bo)
+
+    api_get("/staff", token: @sam_token, account: "acme")
+
+    assert_response :ok
+    assert_equal %w[count next_page page per_page previous_page staff], json.keys.sort
+    assert_equal [ @owner.id, @sam.id, ann.id ], json["staff"].map { |s| s["id"] }
+    assert_equal({ "id" => @sam.id, "name" => "Sam", "role" => "agent" }, json["staff"][1])
+    refute_includes json["staff"].map { |s| s["id"] }, @avery.id
+    refute_includes json["staff"].map { |s| s["id"] }, bo.id
+  end
+
+  test "customers cannot read staff choices, but admins and agents can" do
+    api_get("/staff", token: @avery_token, account: "acme")
+    assert_response :forbidden
+    assert_equal "staff_only", json.dig("error", "code")
+
+    api_get("/staff", token: @owner_token, account: "acme")
+    assert_response :ok
+  end
+
+  test "a session of a suspended user is refused even if it somehow survived the suspension" do
+    @sam.update!(suspended: true)
+
+    api_get("/me", token: @sam_token, account: "acme")
+
+    assert_response :unauthorized
+  end
+
+  test "a PATCH without the user envelope is a bad request" do
+    api_patch("/users/#{@sam.id}", { suspended: true }, token: @owner_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+    refute @sam.reload.suspended?
+  end
+
+  test "a person's own profile shows their suspension" do
+    api_get("/me", token: @owner_token, account: "acme")
+    assert_equal false, json.dig("user", "suspended")
+  end
+end
diff --git a/test/lib/keyset_cursor_test.rb b/test/lib/keyset_cursor_test.rb
new file mode 100644
index 0000000..31301f4
--- /dev/null
+++ b/test/lib/keyset_cursor_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+
+class KeysetCursorTest < ActiveSupport::TestCase
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @users = %w[ann ben cy dee].map do |name|
+      User.create!(account: @account, name: name.capitalize, email: "#{name}@acme.test", password: ApiHelpers::PASSWORD)
+    end
+  end
+
+  # A list of users by id, the way the users endpoint orders them.
+  def users_scope = @account.users.order(:id)
+
+  test "a cursor round-trips the position of a record, including microseconds" do
+    record = Struct.new(:updated_at, :id).new(Time.utc(2026, 5, 6, 7, 8, 9, 123_456), 42)
+    cursor = KeysetCursor.new(Ticket.order(updated_at: :desc, id: :desc), list: "tickets")
+
+    token = cursor.encode(record)
+
+    assert_equal [ Time.utc(2026, 5, 6, 7, 8, 9, 123_456), 42 ], cursor.decode(token)
+  end
+
+  test "a cursor is a single URL-safe string" do
+    cursor = KeysetCursor.new(users_scope, list: "users")
+    token = cursor.encode(@users.first)
+
+    assert_match(/\A[A-Za-z0-9_-]+\z/, token)
+    assert_equal @users.first.id, cursor.decode(token).first
+  end
+
+  test "a cursor from another list is refused" do
+    token = KeysetCursor.new(users_scope, list: "users").encode(@users.first)
+
+    assert_raises(KeysetCursor::Invalid) { KeysetCursor.new(users_scope, list: "groups").decode(token) }
+  end
+
+  test "anything that is not a cursor this list issued is refused" do
+    cursor = KeysetCursor.new(users_scope, list: "users")
+    list = ->(payload) { Base64.urlsafe_encode64(JSON.generate(payload), padding: false) }
+
+    [
+      nil,
+      42,
+      "",
+      "not base64!",
+      Base64.urlsafe_encode64("not json", padding: false),
+      list.call([ 1, 2 ]),
+      list.call("list" => "users"),
+      list.call("list" => "users", "position" => "1"),
+      list.call("list" => "users", "position" => [ 1, 2 ]),
+      list.call("list" => "users", "position" => [ "1" ]),
+      list.call("list" => "users", "position" => [ 0 ]),
+      list.call("list" => "users", "position" => [ -1 ]),
+      list.call("list" => "users", "position" => [ 1.5 ]),
+      list.call("list" => "users", "position" => [ 2**63 ]),
+      "x" * (KeysetCursor::MAX_LENGTH + 1)
+    ].each do |bad|
+      assert_raises(KeysetCursor::Invalid, "expected #{bad.inspect.first(60)} to be refused") { cursor.decode(bad) }
+    end
+  end
+
+  test "early years are fine, but the timestamp must still be UTC with microseconds" do
+    cursor = KeysetCursor.new(Ticket.order(updated_at: :desc, id: :desc), list: "tickets")
+    token = Base64.urlsafe_encode64(JSON.generate("list" => "tickets", "position" => [ "0999-12-31T23:59:59.000001Z", 1 ]), padding: false)
+
+    assert_equal Time.utc(999, 12, 31, 23, 59, 59, 1), cursor.decode(token).first
+  end
+
+  test "a timestamp must be UTC with microseconds, in a year PostgreSQL accepts" do
+    cursor = KeysetCursor.new(Ticket.order(updated_at: :desc, id: :desc), list: "tickets")
+    list = ->(stamp) { Base64.urlsafe_encode64(JSON.generate("list" => "tickets", "position" => [ stamp, 1 ]), padding: false) }
+
+    [ "2026-05-06T07:08:09Z", "2026-05-06 07:08:09.123456Z", "2026-05-06T07:08:09.123456+01:00",
+      "0000-01-01T00:00:00.000000Z", "2026-13-01T00:00:00.000000Z", "2026-05-06T07:08:09.123456" ].each do |bad|
+      assert_raises(KeysetCursor::Invalid, "expected #{bad} to be refused") { cursor.decode(list.call(bad)) }
+    end
+  end
+
+  test "beyond selects the rows after a position, in list order" do
+    ben = @users[1]
+    cursor = KeysetCursor.new(users_scope, list: "users")
+
+    after = users_scope.where(cursor.beyond(cursor.decode(cursor.encode(ben)), :after))
+    before = users_scope.where(cursor.beyond(cursor.decode(cursor.encode(ben)), :before))
+
+    assert_equal @users[2..].map(&:id), after.map(&:id)
+    assert_equal @users[0..0].map(&:id), before.map(&:id)
+  end
+
+  test "reversed, the same position reads the rows before it nearest first" do
+    dee = @users[3]
+    cursor = KeysetCursor.new(users_scope, list: "users")
+
+    rows = cursor.ordered(users_scope.where(cursor.beyond(cursor.decode(cursor.encode(dee)), :before)), reverse: true)
+
+    assert_equal @users[0, 3].reverse.map(&:id), rows.map(&:id), "cy, ben, ann: nearest to dee first"
+  end
+
+  test "descending lists flip the comparison" do
+    tickets = Ticket.order(updated_at: :desc, id: :desc)
+    cursor = KeysetCursor.new(tickets, list: "tickets")
+
+    sql, *binds = cursor.beyond([ Time.utc(2026, 1, 1), 5 ], :after)
+    assert_match(/\) < \(/, sql, "after a descending position means smaller keys")
+    assert_equal [ Time.utc(2026, 1, 1), 5 ], binds
+    assert_match(/\) > \(/, cursor.beyond([ Time.utc(2026, 1, 1), 5 ], :before).first)
+  end
+
+  test "the sort must end with the primary key, run one way, and use timestamps or integers" do
+    assert_raises(ArgumentError) { KeysetCursor.new(Ticket.order(:updated_at), list: "t") }
+    assert_raises(ArgumentError) { KeysetCursor.new(Ticket.order(updated_at: :desc, id: :asc), list: "t") }
+    assert_raises(ArgumentError) { KeysetCursor.new(Ticket.order(:subject, :id), list: "t") }
+    assert_raises(ArgumentError) { KeysetCursor.new(Ticket.order(Arel.sql("updated_at DESC, id DESC")), list: "t") }
+    assert_raises(ArgumentError) { KeysetCursor.new(Ticket.all, list: "t") }
+  end
+
+  test "beyond? tells whether anything lies past a record" do
+    cursor = KeysetCursor.new(users_scope, list: "users")
+
+    assert cursor.beyond?(users_scope, @users.first, :after)
+    assert_not cursor.beyond?(users_scope, @users.last, :after)
+    assert cursor.beyond?(users_scope, @users.last, :before)
+    assert_not cursor.beyond?(users_scope, @users.first, :before)
+  end
+end
