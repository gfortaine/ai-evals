diff --git a/app/controllers/concerns/account_scoped.rb b/app/controllers/concerns/account_scoped.rb
new file mode 100644
index 0000000..494190c
--- /dev/null
+++ b/app/controllers/concerns/account_scoped.rb
@@ -0,0 +1,34 @@
+# Chooses the business for a request from the X-Helpdesk-Account header.
+module AccountScoped
+  extend ActiveSupport::Concern
+
+  ACCOUNT_HEADER = "X-Helpdesk-Account".freeze
+
+  private
+
+  def requested_subdomain
+    request.headers[ACCOUNT_HEADER].to_s.strip.downcase.presence
+  end
+
+  # The business named by the header, or nil if no header was sent. If the
+  # header names an unknown business, this renders 404 and the caller must stop
+  # (check `performed?`).
+  def optional_account_from_header
+    return nil if requested_subdomain.nil?
+
+    account = Account.find_by(subdomain: requested_subdomain)
+    render_error(:not_found, "account_not_found", "No business matches the X-Helpdesk-Account header.") unless account
+    account
+  end
+
+  # Like optional_account_from_header, but the header is required. Renders 400
+  # when it is missing.
+  def account_from_header!
+    if requested_subdomain.nil?
+      render_error(:bad_request, "account_header_required", "Send the X-Helpdesk-Account header to choose a business.")
+      return nil
+    end
+
+    optional_account_from_header
+  end
+end
diff --git a/app/controllers/concerns/authenticatable.rb b/app/controllers/concerns/authenticatable.rb
new file mode 100644
index 0000000..03b84ab
--- /dev/null
+++ b/app/controllers/concerns/authenticatable.rb
@@ -0,0 +1,68 @@
+# Bearer-token sessions. Callers include `before_action :authenticate_session!`.
+#
+# A cancelled account blocks everything except the actions listed with
+# `available_while_cancelled`, which the owner needs to reactivate the account.
+module Authenticatable
+  extend ActiveSupport::Concern
+
+  included do
+    class_attribute :cancelled_account_actions, instance_writer: false, default: [].freeze
+  end
+
+  class_methods do
+    def available_while_cancelled(*actions)
+      self.cancelled_account_actions = (cancelled_account_actions + actions.map(&:to_s)).freeze
+    end
+  end
+
+  private
+
+  attr_reader :current_session, :current_user, :current_account
+
+  def authenticate_session!
+    session = Session.find_active(bearer_token)
+    return render_error(:unauthorized, "unauthenticated", "Sign in to continue.") unless session
+
+    user = session.user
+    account = user.account
+
+    # Suspending a user deletes their sessions, so this only guards against a session that outlived the suspension.
+    return render_error(:unauthorized, "unauthenticated", "Sign in to continue.") if user.suspended?
+
+    if requested_subdomain && requested_subdomain != account.subdomain
+      return render_error(:forbidden, "account_mismatch", "This session belongs to a different business.")
+    end
+
+    @current_session = session
+    @current_user = user
+    @current_account = account
+
+    return if !account.cancelled? || self.class.cancelled_account_actions.include?(action_name)
+
+    render_error(:forbidden, "account_cancelled", "This business has been cancelled.")
+  end
+
+  def require_account_owner!
+    return if current_user.admin?
+
+    render_error(:forbidden, "owner_only", "Only the account owner can do that.")
+  end
+
+  # Admins manage people and invitations. Agents and customers cannot.
+  def require_admin!
+    return if current_user.admin?
+
+    render_error(:forbidden, "admin_only", "Only admins can do that.")
+  end
+
+  # Staff (admins and agents) work the helpdesk. Customers only see their own requests.
+  def require_staff!
+    return if current_user.staff?
+
+    render_error(:forbidden, "staff_only", "Only business staff can do that.")
+  end
+
+  def bearer_token
+    request.authorization.to_s[/\ABearer\s+(\S+)\z/i, 1]
+  end
+end
diff --git a/app/controllers/concerns/boolean_param.rb b/app/controllers/concerns/boolean_param.rb
new file mode 100644
index 0000000..78969ed
--- /dev/null
+++ b/app/controllers/concerns/boolean_param.rb
@@ -0,0 +1,11 @@
+# Reads true or false from a request. Anything else is refused rather than guessed at, so a typo cannot
+# quietly flip a setting or post a private note publicly.
+module BooleanParam
+  # true or false for JSON booleans and the strings "true" and "false". nil for anything else.
+  def self.parse(value)
+    case value
+    when true, "true" then true
+    when false, "false" then false
+    end
+  end
+end
diff --git a/app/controllers/concerns/error_handling.rb b/app/controllers/concerns/error_handling.rb
new file mode 100644
index 0000000..4ec7cd3
--- /dev/null
+++ b/app/controllers/concerns/error_handling.rb
@@ -0,0 +1,71 @@
+# Every error response has the same shape:
+#   {"error": {"code": "...", "message": "...", "errors": {...}}}
+# where "errors" is present only for validation failures.
+module ErrorHandling
+  extend ActiveSupport::Concern
+
+  included do
+    rescue_from ActionController::ParameterMissing, with: :render_parameter_missing
+    rescue_from ActionDispatch::Http::Parameters::ParseError, with: :render_bad_json
+    rescue_from ActiveRecord::RecordInvalid, with: :render_record_invalid
+    rescue_from ActiveRecord::RecordNotUnique, with: :render_record_not_unique
+    rescue_from ActiveRecord::RecordNotFound, with: :render_record_not_found
+    rescue_from SingleUseToken::InvalidToken, with: :render_invalid_token
+    rescue_from Invitation::InvalidInvitation, with: :render_invalid_token
+    rescue_from Invitation::AlreadyClosed, with: :render_invitation_closed
+    rescue_from Ticket::Closed, with: :render_ticket_closed
+  end
+
+  private
+
+  # Like params.require, but a value that is not an object (e.g. a bare string)
+  # counts as missing, so the client gets a 400 instead of a server error.
+  def require_params(key)
+    value = params.require(key)
+    raise ActionController::ParameterMissing, key unless value.is_a?(ActionController::Parameters)
+
+    value
+  end
+
+  def render_error(status, code, message, errors: nil)
+    body = { code: code, message: message }
+    body[:errors] = errors if errors.present?
+    render json: { error: body }, status: status
+  end
+
+  def render_validation_failed(errors)
+    render_error(:unprocessable_entity, "validation_failed", "Some fields are invalid.", errors: errors)
+  end
+
+  def render_parameter_missing(exception)
+    render_error(:bad_request, "parameter_missing", exception.message)
+  end
+
+  def render_bad_json(_exception)
+    render_error(:bad_request, "invalid_json", "The request body is not valid JSON.")
+  end
+
+  def render_record_invalid(exception)
+    render_validation_failed(exception.record.errors.to_hash)
+  end
+
+  def render_record_not_unique(_exception)
+    render_error(:conflict, "conflict", "That record was created by another request. Please try again.")
+  end
+
+  def render_record_not_found(_exception)
+    render_error(:not_found, "not_found", "The requested record was not found.")
+  end
+
+  def render_invalid_token(_exception)
+    render_error(:unprocessable_entity, "invalid_token", "This link is invalid or has expired. Request a new one.")
+  end
+
+  def render_invitation_closed(_exception)
+    render_error(:unprocessable_entity, "invitation_closed", "This invitation was already accepted or revoked.")
+  end
+
+  def render_ticket_closed(_exception)
+    render_error(:unprocessable_entity, "ticket_closed", "This ticket is closed and can no longer be changed.")
+  end
+end
diff --git a/app/controllers/concerns/list_filters.rb b/app/controllers/concerns/list_filters.rb
new file mode 100644
index 0000000..7681544
--- /dev/null
+++ b/app/controllers/concerns/list_filters.rb
@@ -0,0 +1,48 @@
+# Reads the filters on a list. Each filter is optional, and a blank value means no filter. A value that is not
+# allowed adds an error under the parameter's name, so the caller can answer 422 instead of guessing.
+module ListFilters
+  extend ActiveSupport::Concern
+
+  # An ID as the database stores it: digits only, within the bigint range.
+  ID_FORMAT = /\A\d{1,18}\z/
+
+  private
+
+  # One of +allowed+, or nil when the parameter is absent or blank.
+  def choice_param(name, allowed, errors)
+    value = params[name].to_s.strip
+    return nil if value.empty?
+    return value if allowed.include?(value)
+
+    errors[name] = [ "must be one of #{allowed.join(", ")}" ]
+    nil
+  end
+
+  # A user ID, or a word from +also+ returned as given, or nil when absent or blank.
+  def user_id_param(name, errors, also: [])
+    id_param(name, errors, noun: "a user ID", also: also)
+  end
+
+  # An ID, or a word from +also+ returned as given, or nil when absent or blank. +value+ is read from the query string
+  # unless the caller passes one, such as a value from a request body. +noun+ names the ID in the error.
+  def id_param(name, errors, noun: "an ID", also: [], value: params[name])
+    text = value.to_s.strip
+    return nil if text.empty?
+    return text if also.include?(text)
+    return text.to_i if text.match?(ID_FORMAT)
+
+    errors[name] = [ "must be #{[ noun, *also ].join(" or ")}" ]
+    nil
+  end
+
+  # The search text exactly as typed, or nil when absent or blank. It is not trimmed, so the text the user types
+  # is the text that is matched. Anything other than text is an error.
+  def text_param(name, errors)
+    value = params[name]
+    return nil if value.blank?
+    return value if value.is_a?(String) && !value.include?("\u0000")
+
+    errors[name] = [ "must be text" ]
+    nil
+  end
+end
diff --git a/app/controllers/concerns/paginated.rb b/app/controllers/concerns/paginated.rb
new file mode 100644
index 0000000..243c81d
--- /dev/null
+++ b/app/controllers/concerns/paginated.rb
@@ -0,0 +1,161 @@
+# Pagination for list endpoints. A list is paged in one of two ways, chosen by the page parameter.
+#
+# Page numbers: ?page=2&per_page=10 (defaults 1 and 25, at most 100). The response holds the records under +key+, plus
+# count (all matches, not just this page), page, per_page, next_page and previous_page. The last two are null when
+# there is no such page. This is the original API, and its response does not change.
+#
+# Cursors: ?page[size]=25, ?page[after]=CURSOR or ?page[before]=CURSOR (size defaults to 25, at most 100). The response
+# holds the records under +key+, plus meta ({has_more, after_cursor, before_cursor}) and links ({next, prev}). Cursors
+# skip the count, which scans the whole list, so a page costs the same however deep it is. See KeysetCursor.
+module Paginated
+  extend ActiveSupport::Concern
+
+  DEFAULT_PER_PAGE = 25
+  MAX_PER_PAGE = 100
+  CURSOR_KEYS = %w[size after before].freeze
+
+  private
+
+  # +list+ names the list the cursors belong to. It defaults to +key+, and lists that share a key, such as comments on
+  # different requests, pass their own.
+  def render_page(scope, key:, list: key, &serialize)
+    if params[:page].is_a?(ActionController::Parameters)
+      render_cursor_page(scope, key: key, list: list, &serialize)
+    else
+      render_numbered_page(scope, key: key, &serialize)
+    end
+  end
+
+  def render_numbered_page(scope, key:, &serialize)
+    errors = {}
+    page = whole_number_param(:page, 1, errors)
+    per_page = whole_number_param(:per_page, DEFAULT_PER_PAGE, errors, max: MAX_PER_PAGE)
+    return render_validation_failed(errors) if errors.any?
+
+    count = scope.count
+    offset = (page - 1) * per_page
+    # Past the end there is nothing to fetch. Skipping the query also keeps huge page numbers away from SQL.
+    records = offset < count ? scope.offset(offset).limit(per_page).to_a : []
+
+    render json: {
+      key => records.map(&serialize),
+      count: count,
+      page: page,
+      per_page: per_page,
+      next_page: page * per_page < count ? page + 1 : nil,
+      previous_page: page > 1 ? page - 1 : nil
+    }
+  end
+
+  # Cursor pages are read from the position a cursor names, in list order. The page is read one row longer than it is,
+  # so that row says whether more exists beyond the page, without a count.
+  #
+  # meta.has_more answers for the direction being read: more after the page when reading forwards, more before it
+  # when reading backwards with page[before]. links.next and links.prev are set when there is a page that way. Both
+  # cursors are null on an empty page.
+  def render_cursor_page(scope, key:, list:, &serialize)
+    errors = {}
+    size = cursor_size_param(errors)
+    after = page_text_param(:after, errors)
+    before = page_text_param(:before, errors)
+    add_error(errors, :page, "send after or before, not both") if after && before
+    unknown = params[:page].keys - CURSOR_KEYS
+    add_error(errors, :page, "has keys that are not allowed: #{unknown.join(", ")}") if unknown.any?
+
+    cursors = KeysetCursor.new(scope, list: list)
+    side = after ? :after : (:before if before)
+    position = nil
+    if side
+      begin
+        position = cursors.decode(after || before)
+      rescue KeysetCursor::Invalid
+        add_error(errors, :"page.#{side}", "is not a cursor from this list")
+      end
+    end
+    return render_validation_failed(errors) if errors.any?
+
+    relation = position ? scope.where(cursors.beyond(position, side)) : scope
+    rows = cursors.ordered(relation, reverse: side == :before).limit(size + 1).to_a
+    more = rows.size > size
+    records = rows.first(size)
+    records.reverse! if side == :before
+
+    if side == :before
+      before_more = more
+      after_more = records.any? && cursors.beyond?(scope, records.last, :after)
+    else
+      after_more = more
+      before_more = side == :after && records.any? && cursors.beyond?(scope, records.first, :before)
+    end
+
+    first_cursor = cursors.encode(records.first) if records.any?
+    last_cursor = cursors.encode(records.last) if records.any?
+
+    render json: {
+      key => records.map(&serialize),
+      meta: {
+        has_more: side == :before ? before_more : after_more,
+        after_cursor: last_cursor,
+        before_cursor: first_cursor
+      },
+      links: {
+        next: after_more ? page_link(:after, last_cursor, size) : nil,
+        prev: before_more ? page_link(:before, first_cursor, size) : nil
+      }
+    }
+  end
+
+  # The page size in cursor mode: page[size], or per_page when that is sent instead. If both are sent, they must agree.
+  def cursor_size_param(errors)
+    from_page = page_text_param(:size, errors)
+    from_per_page = params[:per_page].to_s.strip.presence
+    if from_page && from_per_page && from_page != from_per_page
+      add_error(errors, :"page.size", "conflicts with per_page")
+      return nil
+    end
+
+    if from_page
+      whole_number(from_page, :"page.size", DEFAULT_PER_PAGE, errors, max: MAX_PER_PAGE)
+    else
+      whole_number(from_per_page, :per_page, DEFAULT_PER_PAGE, errors, max: MAX_PER_PAGE)
+    end
+  end
+
+  # A value inside page[...], as text, or nil when it is absent or blank. Anything nested is an error.
+  def page_text_param(name, errors)
+    value = params[:page][name]
+    return nil if value.nil?
+    return value.strip.presence if value.is_a?(String)
+
+    add_error(errors, :"page.#{name}", "must be text")
+    nil
+  end
+
+  # The same request, pointed at another page. It keeps the filters and sort the client sent.
+  def page_link(direction, cursor, size)
+    query = request.query_parameters.except("page", "per_page")
+    query = query.merge("page" => { "size" => size.to_s, direction.to_s => cursor })
+    "#{request.base_url}#{request.path}?#{query.to_query}"
+  end
+
+  # Reads a positive whole number from the query string. Anything else adds an error for +name+ and returns nil.
+  def whole_number_param(name, default, errors, max: nil)
+    whole_number(params[name], name, default, errors, max: max)
+  end
+
+  # Reads a positive whole number from +raw+. Blank means the default. Anything else adds an error under +key+.
+  def whole_number(raw, key, default, errors, max: nil)
+    text = raw.to_s.strip
+    return default if text.empty?
+
+    number = text.to_i if text.match?(/\A\d+\z/)
+    return number if number&.positive? && (max.nil? || number <= max)
+
+    add_error(errors, key, max ? "must be a whole number from 1 to #{max}" : "must be a whole number of at least 1")
+    nil
+  end
+
+  def add_error(errors, key, message)
+    (errors[key] ||= []) << message
+  end
+end
diff --git a/app/controllers/concerns/replies.rb b/app/controllers/concerns/replies.rb
new file mode 100644
index 0000000..4c4ed0f
--- /dev/null
+++ b/app/controllers/concerns/replies.rb
@@ -0,0 +1,24 @@
+# Reads a reply from a PATCH body. A reply can carry a comment, a status, or both.
+module Replies
+  extend ActiveSupport::Concern
+
+  private
+
+  # The comment body to post. nil when the reply has no comment.
+  def reply_body(input)
+    input.key?(:comment) ? input.dig(:comment, :body).to_s : nil
+  end
+
+  # The status to set. nil leaves the status alone.
+  def reply_status(input)
+    input.key?(:status) ? input[:status].to_s : nil
+  end
+
+  # Renders 400 and returns true when the update names none of +keys+. The default keys are a comment and a status.
+  def reject_empty_reply(input, keys: %i[comment status], message: "Send a comment, a status, or both.")
+    return false if keys.any? { |key| input.key?(key) }
+
+    render_error(:bad_request, "parameter_missing", message)
+    true
+  end
+end
