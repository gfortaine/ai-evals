+++ b/.ruby-version
@@ -0,0 +1 @@
+ruby-4.0.7
diff --git a/Gemfile b/Gemfile
new file mode 100644
index 0000000..5839e3e
--- /dev/null
+++ b/Gemfile
@@ -0,0 +1,14 @@
+source "https://rubygems.org"
+
+gem "rails", "~> 8.1.4"
+# PostgreSQL adapter (connection is configured via DATABASE_URL)
+gem "pg", "~> 1.1"
+# Puma web server
+gem "puma", ">= 5.0"
+# has_secure_password for owner/user credentials
+gem "bcrypt", "~> 3.1"
+# CORS for the separately hosted frontend
+gem "rack-cors", "~> 3.0"
+
+# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
+gem "tzinfo-data", platforms: %i[ windows jruby ]
