index 0000000..a5e45ed
--- /dev/null
+++ b/test/integration/groups_test.rb
@@ -0,0 +1,242 @@
+require "test_helper"
+
+class GroupsTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @sam = user_in("acme", "sam@example.test")
+  end
+
+  def create_group!(name, token: @owner_token, account: "acme")
+    api_post("/groups", { group: { name: name } }, token: token, account: account)
+    assert_response :created, response.body
+    json.dig("group", "id")
+  end
+
+  test "an admin creates a group, which is returned with its id and name" do
+    api_post("/groups", { group: { name: "Billing" } }, token: @owner_token, account: "acme")
+
+    assert_response :created
+    assert_equal %w[created_at id name updated_at], json["group"].keys.sort
+    assert_equal "Billing", json.dig("group", "name")
+    assert_equal "Billing", Group.find(json.dig("group", "id")).name
+  end
+
+  test "the name is trimmed, and must be present and unique within the business, ignoring case" do
+    create_group!("Billing")
+
+    api_post("/groups", { group: { name: "  Technical Support  " } }, token: @owner_token, account: "acme")
+    assert_response :created
+    assert_equal "Technical Support", json.dig("group", "name")
+
+    api_post("/groups", { group: { name: "   " } }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "name").present?
+
+    api_post("/groups", { group: { name: "billing" } }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "name").present?
+    assert_equal 2, Group.count
+  end
+
+  test "the same name can be used by two different businesses" do
+    create_group!("Billing")
+
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    create_group!("Billing", token: globex_token, account: "globex")
+
+    assert_response :created
+  end
+
+  test "a body without the group envelope is a bad request" do
+    api_post("/groups", { name: "Billing" }, token: @owner_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "admins rename a group, and the name is checked" do
+    billing = create_group!("Billing")
+    create_group!("Support")
+
+    api_patch("/groups/#{billing}", { group: { name: "Accounts" } }, token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal "Accounts", json.dig("group", "name")
+    assert_equal "Accounts", Group.find(billing).name
+
+    api_patch("/groups/#{billing}", { group: { name: "support" } }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "name").present?
+    assert_equal "Accounts", Group.find(billing).name
+
+    api_patch("/groups/#{billing}", { group: { name: "" } }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+  end
+
+  test "a rename shows on the requests in the group straight away" do
+    billing = create_group!("Billing")
+    request = open_request!(token: @avery_token, subject: "Invoice question")
+    api_patch("/tickets/#{request}", { ticket: { group_id: billing } }, token: @owner_token, account: "acme")
+    assert_response :ok
+
+    api_patch("/groups/#{billing}", { group: { name: "Accounts" } }, token: @owner_token, account: "acme")
+    assert_response :ok
+
+    api_get("/tickets", token: @owner_token, account: "acme")
+    row = json["tickets"].find { |t| t["id"] == request }
+    assert_equal({ "id" => billing, "name" => "Accounts" }, row["group"])
+  end
+
+  test "a rename without a name is a bad request" do
+    billing = create_group!("Billing")
+
+    api_patch("/groups/#{billing}", { group: { description: "nope" } }, token: @owner_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "Billing", Group.find(billing).name
+  end
+
+  test "groups are listed by ID ascending, with the page metadata" do
+    billing = create_group!("Billing")
+    support = create_group!("Technical Support")
+
+    api_get("/groups", token: @sam_token, account: "acme")
+
+    assert_response :ok
+    assert_equal %w[count groups next_page page per_page previous_page], json.keys.sort
+    assert_equal [ billing, support ], json["groups"].map { |g| g["id"] }
+    assert_equal 2, json["count"]
+  end
+
+  test "a group can be shown by ID, and an unknown one is not found" do
+    billing = create_group!("Billing")
+
+    api_get("/groups/#{billing}", token: @sam_token, account: "acme")
+    assert_response :ok
+    assert_equal "Billing", json.dig("group", "name")
+
+    api_get("/groups/999999", token: @sam_token, account: "acme")
+    assert_response :not_found
+  end
+
+  test "staff browse groups, but only admins create, rename or delete them" do
+    billing = create_group!("Billing")
+
+    api_post("/groups", { group: { name: "Sales" } }, token: @sam_token, account: "acme")
+    assert_response :forbidden
+    assert_equal "admin_only", json.dig("error", "code")
+
+    api_patch("/groups/#{billing}", { group: { name: "Money" } }, token: @sam_token, account: "acme")
+    assert_response :forbidden
+    assert_equal "admin_only", json.dig("error", "code")
+
+    api_delete("/groups/#{billing}", token: @sam_token, account: "acme")
+    assert_response :forbidden
+    assert_equal "admin_only", json.dig("error", "code")
+
+    assert_equal "Billing", Group.find(billing).name
+  end
+
+  test "customers cannot browse or change groups" do
+    billing = create_group!("Billing")
+
+    api_get("/groups", token: @avery_token, account: "acme")
+    assert_response :forbidden
+    assert_equal "staff_only", json.dig("error", "code")
+
+    api_get("/groups/#{billing}", token: @avery_token, account: "acme")
+    assert_response :forbidden
+
+    api_post("/groups", { group: { name: "Sales" } }, token: @avery_token, account: "acme")
+    assert_response :forbidden
+  end
+
+  test "deleting a group removes it and its memberships" do
+    billing = create_group!("Billing")
+    GroupMembership.add!(account: Account.find_by!(subdomain: "acme"), group_id: billing, user_id: @sam.id)
+
+    api_delete("/groups/#{billing}", token: @owner_token, account: "acme")
+
+    assert_response :no_content
+    assert_empty response.body
+    refute Group.exists?(billing)
+    refute GroupMembership.exists?(group_id: billing)
+  end
+
+  test "a group in another business is not found" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    globex_group = create_group!("Billing", token: globex_token, account: "globex")
+
+    api_get("/groups/#{globex_group}", token: @owner_token, account: "acme")
+    assert_response :not_found
+
+    api_patch("/groups/#{globex_group}", { group: { name: "Hacked" } }, token: @owner_token, account: "acme")
+    assert_response :not_found
+
+    api_delete("/groups/#{globex_group}", token: @owner_token, account: "acme")
+    assert_response :not_found
+    assert_equal "Billing", Group.find(globex_group).name
+  end
+
+  test "deleting a group ungroups its requests and clears their assignee, and leaves other requests alone" do
+    billing = create_group!("Billing")
+    support = create_group!("Technical Support")
+    account = Account.find_by!(subdomain: "acme")
+    GroupMembership.add!(account: account, group_id: billing, user_id: @sam.id)
+    GroupMembership.add!(account: account, group_id: support, user_id: @sam.id)
+    in_billing = open_request!(token: @avery_token, subject: "Invoice question")
+    in_support = open_request!(token: @avery_token, subject: "Login broken")
+    api_patch("/tickets/#{in_billing}", { ticket: { group_id: billing, assignee_id: @sam.id } },
+              token: @owner_token, account: "acme")
+    assert_response :ok
+    api_patch("/tickets/#{in_support}", { ticket: { group_id: support, assignee_id: @sam.id } },
+              token: @owner_token, account: "acme")
+    assert_response :ok
+
+    api_delete("/groups/#{billing}", token: @owner_token, account: "acme")
+    assert_response :no_content
+
+    billing_ticket = Ticket.find(in_billing)
+    assert_nil billing_ticket.group_id
+    assert_nil billing_ticket.assignee_id
+    assert_equal "open", billing_ticket.status
+
+    support_ticket = Ticket.find(in_support)
+    assert_equal support, support_ticket.group_id
+    assert_equal @sam.id, support_ticket.assignee_id
+  end
+
+  test "deleting a group moves the people in it to their other default" do
+    billing = create_group!("Billing")
+    support = create_group!("Technical Support")
+    account = Account.find_by!(subdomain: "acme")
+    GroupMembership.add!(account: account, group_id: billing, user_id: @sam.id)
+    GroupMembership.add!(account: account, group_id: support, user_id: @sam.id)
+    assert_equal billing, GroupMembership.find_by!(user_id: @sam.id, default: true).group_id
+
+    api_delete("/groups/#{billing}", token: @owner_token, account: "acme")
+
+    assert_response :no_content
+    remaining = GroupMembership.where(user_id: @sam.id).to_a
+    assert_equal [ support ], remaining.map(&:group_id)
+    assert_equal [ true ], remaining.map(&:default)
+  end
+
+  test "deleting the only group a person is in leaves them with no memberships" do
+    billing = create_group!("Billing")
+    account = Account.find_by!(subdomain: "acme")
+    GroupMembership.add!(account: account, group_id: billing, user_id: @sam.id)
+
+    api_delete("/groups/#{billing}", token: @owner_token, account: "acme")
+
+    assert_response :no_content
+    assert_empty GroupMembership.where(user_id: @sam.id)
+    api_get("/group_memberships", token: @owner_token, account: "acme")
+    assert_empty json["group_memberships"]
+  end
+end
diff --git a/test/integration/internal_notes_test.rb b/test/integration/internal_notes_test.rb
new file mode 100644
index 0000000..49bafca
--- /dev/null
+++ b/test/integration/internal_notes_test.rb
@@ -0,0 +1,186 @@
+require "test_helper"
+
+class InternalNotesTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @request_id = open_request!(token: @avery_token)
+  end
+
+  # A private note. +extra+ holds ticket-level keys, such as a status, sent alongside it.
+  def staff_note!(body:, token: @owner_token, extra: {})
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: body, public: false } }.merge(extra) }, token: token, account: "acme")
+  end
+
+  def customer_view
+    api_get("/requests/#{@request_id}", token: @avery_token, account: "acme")
+    json["request"]
+  end
+
+  def customer_comment_bodies
+    api_get("/requests/#{@request_id}/comments", token: @avery_token, account: "acme")
+    json["comments"].map { |c| c["body"] }
+  end
+
+  test "a private note is saved as internal, under the staff author, and the staff can read it" do
+    staff_note!(body: "Checking this with billing.")
+
+    assert_response :ok
+    assert_equal false, Comment.find_by!(body: "Checking this with billing.").public
+    api_get("/tickets/#{@request_id}/comments", token: @owner_token, account: "acme")
+    note = json["comments"].last
+    assert_equal "Checking this with billing.", note["body"]
+    assert_equal false, note["public"]
+    assert_equal({ "id" => @owner.id, "name" => "Jo" }, note["author"])
+  end
+
+  test "a private note never reaches the customer" do
+    staff_note!(body: "Checking this with billing.")
+
+    refute_includes customer_comment_bodies, "Checking this with billing."
+    assert_equal [ "The download button does nothing." ], customer_comment_bodies
+  end
+
+  test "a private note leaves the customer's request exactly as it was, timestamps included" do
+    before = customer_view
+
+    staff_note!(body: "Checking this with billing.")
+
+    assert_equal before, customer_view
+  end
+
+  test "a private note does not move the request up the staff or customer lists" do
+    newer_id = open_request!(token: @avery_token, subject: "Newer one")
+    api_get("/tickets", token: @owner_token, account: "acme")
+    assert_equal [ newer_id, @request_id ], json["tickets"].map { |t| t["id"] }
+
+    staff_note!(body: "Internal only.")
+
+    api_get("/tickets", token: @owner_token, account: "acme")
+    assert_equal [ newer_id, @request_id ], json["tickets"].map { |t| t["id"] }
+    api_get("/requests", token: @avery_token, account: "acme")
+    assert_equal [ newer_id, @request_id ], json["requests"].map { |r| r["id"] }
+  end
+
+  test "a staff status change on its own still moves the request to the top of the lists" do
+    newer_id = open_request!(token: @avery_token, subject: "Newer one")
+    api_get("/tickets", token: @owner_token, account: "acme")
+    assert_equal [ newer_id, @request_id ], json["tickets"].map { |t| t["id"] }
+
+    api_patch("/tickets/#{@request_id}", { ticket: { status: "pending" } }, token: @owner_token, account: "acme")
+
+    api_get("/tickets", token: @owner_token, account: "acme")
+    assert_equal [ @request_id, newer_id ], json["tickets"].map { |t| t["id"] }
+  end
+
+  test "setting a status that is already set changes nothing, not even the timestamp" do
+    updated_at = Ticket.find(@request_id).updated_at
+
+    api_patch("/tickets/#{@request_id}", { ticket: { status: "open" } }, token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal updated_at.to_i, Ticket.find(@request_id).updated_at.to_i
+  end
+
+  test "a private note does not change the status, even a solved or pending one" do
+    %w[open pending solved].each do |status|
+      Ticket.find(@request_id).update!(status: status)
+      staff_note!(body: "Internal note while #{status}.")
+      assert_response :ok
+      assert_equal status, json.dig("ticket", "status")
+      assert_equal status, Ticket.find(@request_id).status
+    end
+  end
+
+  test "a private note on a solved request does not reopen it for the customer" do
+    api_patch("/tickets/#{@request_id}", { ticket: { status: "solved" } }, token: @owner_token, account: "acme")
+
+    staff_note!(body: "Logged in case it comes back.")
+
+    assert_equal "solved", customer_view["status"]
+  end
+
+  test "a private note sent with an explicit status still applies that status, since it is a deliberate change" do
+    staff_note!(body: "Refund approved internally.", extra: { status: "pending" })
+
+    assert_response :ok
+    assert_equal "pending", json.dig("ticket", "status")
+    assert_equal "pending", customer_view["status"]
+    refute_includes customer_comment_bodies, "Refund approved internally."
+  end
+
+  test "a public staff reply is still public and still moves the request" do
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "We are on it." } } }, token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal true, Comment.find_by!(body: "We are on it.").public
+    assert_includes customer_comment_bodies, "We are on it."
+  end
+
+  test "a public staff reply that says public explicitly is public" do
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "Public and explicit.", public: true } } },
+              token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_includes customer_comment_bodies, "Public and explicit."
+  end
+
+  test "an agent can add a private note" do
+    staff_note!(body: "Agent's note.", token: @sam_token)
+
+    assert_response :ok
+    assert_equal user_in("acme", "sam@example.test"), Comment.find_by!(body: "Agent's note.").author
+    refute_includes customer_comment_bodies, "Agent's note."
+  end
+
+  test "a value other than true or false for public is refused, and nothing is posted" do
+    [ "maybe", nil, 0, "yes" ].each do |value|
+      api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "Should not post", public: value } } },
+                token: @owner_token, account: "acme")
+      assert_response :unprocessable_entity, "public #{value.inspect} should be refused"
+      assert json.dig("error", "errors", "comment.public").present?
+    end
+    refute Comment.exists?(body: "Should not post")
+    assert_equal [ "The download button does nothing." ], customer_comment_bodies
+  end
+
+  test "the strings true and false are read as booleans" do
+    staff_note!(body: "String false note.")
+    assert_response :ok
+    assert_equal false, Comment.find_by!(body: "String false note.").public
+
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "String true note.", public: "true" } } },
+              token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal true, Comment.find_by!(body: "String true note.").public
+  end
+
+  test "a private note still needs a body" do
+    staff_note!(body: "")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "comment.body").present?
+    assert_equal 1, Comment.where(ticket_id: @request_id).count
+  end
+
+  test "a customer's public flag is ignored, so customers cannot post private notes" do
+    api_patch("/requests/#{@request_id}", { request: { comment: { body: "Still public?", public: false } } },
+              token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal true, Comment.find_by!(body: "Still public?").public
+    assert_includes customer_comment_bodies, "Still public?"
+  end
+
+  test "private notes are kept in the staff conversation, oldest first, next to the public ones" do
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "Public reply." } } }, token: @owner_token, account: "acme")
+    staff_note!(body: "Private.")
+
+    api_get("/tickets/#{@request_id}/comments", token: @owner_token, account: "acme")
+    assert_equal [ "The download button does nothing.", "Public reply.", "Private." ], json["comments"].map { |c| c["body"] }
+    assert_equal [ true, true, false ], json["comments"].map { |c| c["public"] }
+  end
+end
diff --git a/test/integration/invitation_acceptance_test.rb b/test/integration/invitation_acceptance_test.rb
