diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..bde539b
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,67 @@
+module Api
+  module V1
+    class AccountsController < ApplicationController
+      before_action :authenticate_session!, only: %i[show cancel reactivate]
+      before_action :require_account_owner!, only: %i[cancel reactivate]
+
+      available_while_cancelled :show, :reactivate
+
+      # Sign up a business. The admin must verify their email before signing in.
+      def create
+        input = require_params(:account).permit(:name, :subdomain, admin: %i[name email password])
+        admin_input = input[:admin] || {}
+
+        account = Account.new(name: input[:name], subdomain: input[:subdomain])
+        admin = User.new(
+          account: account,
+          role: "admin",
+          name: admin_input[:name],
+          email: admin_input[:email],
+          password: admin_input[:password]
+        )
+
+        # Validate both before saving, so the response reports every problem at once.
+        account_valid = account.valid?
+        admin_valid = admin.valid?
+        unless account_valid && admin_valid
+          errors = account.errors.to_hash.transform_keys { |key| "account.#{key}" }
+                          .merge(admin.errors.to_hash.transform_keys { |key| "admin.#{key}" })
+          return render_validation_failed(errors)
+        end
+
+        verification_token = nil
+        ActiveRecord::Base.transaction do
+          admin.save!
+          verification_token = EmailVerification.issue!(admin)
+        end
+        UserMailer.deliver_safely(:email_verification, admin, verification_token)
+
+        render json: { account: account.as_api_json, user: admin.as_api_json }, status: :created
+      end
+
+      def show
+        render json: { account: current_account.as_api_json }
+      end
+
+      def cancel
+        current_account.cancel!
+        render json: { account: current_account.as_api_json }
+      end
+
+      def reactivate
+        return render_error(:unprocessable_entity, "not_cancelled", "This business is not cancelled.") unless current_account.cancelled?
+
+        unless current_account.reactivation_open?
+          return render_error(
+            :unprocessable_entity,
+            "reactivation_window_closed",
+            "Cancelled businesses can only be reactivated within #{Account::REACTIVATION_WINDOW.inspect} of cancellation."
+          )
+        end
+
+        current_account.reactivate!
+        render json: { account: current_account.as_api_json }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
new file mode 100644
index 0000000..8b3fcd3
--- /dev/null
+++ b/app/controllers/api/v1/email_verifications_controller.rb
@@ -0,0 +1,40 @@
+module Api
+  module V1
+    class EmailVerificationsController < ApplicationController
+      GENERIC_MESSAGE = "If that email belongs to an account that needs verifying, a verification link is on its way.".freeze
+
+      # Sends a fresh verification link. Replaces any earlier link.
+      def create
+        account = optional_account_from_header
+        return if performed?
+
+        email = require_params(:email_verification).permit(:email)[:email]
+        scope = (account ? account.users : User.all).where(email: email, verified_at: nil)
+
+        scope.includes(:account).each do |user|
+          token = EmailVerification.issue!(user)
+          UserMailer.deliver_safely(:email_verification, user, token)
+        end
+
+        render json: { message: GENERIC_MESSAGE }, status: :accepted
+      end
+
+      def confirm
+        account = optional_account_from_header
+        return if performed?
+
+        token = require_params(:email_verification).permit(:token)[:token]
+        user = nil
+
+        EmailVerification.transaction do
+          record = EmailVerification.redeem!(token, account: account)
+          user = record.user
+          user.verified_at ||= Time.current
+          user.save!
+        end
+
+        render json: { message: "Email verified. You can sign in now.", user: user.as_api_json, account: user.account.as_api_json }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/group_memberships_controller.rb b/app/controllers/api/v1/group_memberships_controller.rb
new file mode 100644
index 0000000..a1511cb
--- /dev/null
+++ b/app/controllers/api/v1/group_memberships_controller.rb
@@ -0,0 +1,75 @@
+module Api
+  module V1
+    # Which staff belong to which groups. Staff can browse memberships. Admins add people to groups, remove them, and
+    # choose each person's default group.
+    class GroupMembershipsController < ApplicationController
+      include Paginated
+      include ListFilters
+
+      before_action :authenticate_session!
+      before_action :require_staff!
+      before_action :require_admin!, only: %i[create destroy make_default]
+
+      # Filters: group_id and user_id. Both combine.
+      def index
+        errors = {}
+        group_id = id_param(:group_id, errors, noun: "a group ID")
+        user_id = user_id_param(:user_id, errors)
+        return render_validation_failed(errors) if errors.any?
+
+        scope = current_account.group_memberships.includes(:group, :user).order(:id)
+        scope = scope.where(group_id: group_id) if group_id
+        scope = scope.where(user_id: user_id) if user_id
+        render_page(scope, key: "group_memberships", &:as_api_json)
+      end
+
+      def show
+        render json: { group_membership: find_membership.as_api_json }
+      end
+
+      # The default is optional. A person's first membership is always their default, whatever default says.
+      def create
+        body = require_params(:group_membership)
+        errors = {}
+        group_id = id_param(:group_id, errors, noun: "a group ID", value: body[:group_id])
+        user_id = id_param(:user_id, errors, noun: "a user ID", value: body[:user_id])
+        default = default_param(body, errors)
+        return render_validation_failed(errors) if errors.any?
+
+        membership = GroupMembership.add!(account: current_account, group_id: group_id, user_id: user_id,
+                                          default: default)
+        render json: { group_membership: membership.as_api_json }, status: :created
+      end
+
+      # Removes the person from the group. Any request in the group that they were assigned loses them, and the
+      # request keeps its group. If this was their default, another of their memberships becomes it.
+      def destroy
+        find_membership.remove!
+        head :no_content
+      end
+
+      # Makes this group the person's default. The previous default stops being one.
+      def make_default
+        membership = find_membership.make_default!
+        render json: { group_membership: membership.as_api_json }
+      end
+
+      private
+
+      def find_membership
+        current_account.group_memberships.includes(:group, :user).find(params[:id])
+      end
+
+      # true or false. Omitted means false. Anything else is an error, not a guess.
+      def default_param(body, errors)
+        return false unless body.key?(:default)
+
+        value = BooleanParam.parse(body[:default])
+        return value unless value.nil?
+
+        errors[:default] = [ "must be true or false" ]
+        false
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/groups_controller.rb b/app/controllers/api/v1/groups_controller.rb
new file mode 100644
index 0000000..bbadc1f
--- /dev/null
+++ b/app/controllers/api/v1/groups_controller.rb
@@ -0,0 +1,49 @@
+module Api
+  module V1
+    # The business's groups, such as Billing or Technical Support. Staff can browse them. Admins create, rename and
+    # delete them. A group organizes the work, and never hides a request from other staff.
+    class GroupsController < ApplicationController
+      include Paginated
+
+      before_action :authenticate_session!
+      before_action :require_staff!
+      before_action :require_admin!, only: %i[create update destroy]
+
+      def index
+        render_page(current_account.groups.order(:id), key: "groups", &:as_api_json)
+      end
+
+      def show
+        render json: { group: find_group.as_api_json }
+      end
+
+      def create
+        input = require_params(:group).permit(:name)
+        group = Group.create_named!(account: current_account, name: input[:name])
+
+        render json: { group: group.as_api_json }, status: :created
+      end
+
+      # Only the name can change. The memberships and the requests in the group stay as they are.
+      def update
+        input = require_params(:group).permit(:name)
+        return render_error(:bad_request, "parameter_missing", "Send a name.") unless input.key?(:name)
+
+        group = find_group.rename!(input[:name])
+        render json: { group: group.as_api_json }
+      end
+
+      # Deletes the group. Its memberships go, and its requests stay, ungrouped and without an assignee.
+      def destroy
+        find_group.remove!
+        head :no_content
+      end
+
+      private
+
+      def find_group
+        current_account.groups.find(params[:id])
+      end
+    end
+  end
+end
