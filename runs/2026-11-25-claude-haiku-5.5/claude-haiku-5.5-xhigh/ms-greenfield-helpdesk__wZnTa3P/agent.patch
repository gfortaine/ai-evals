diff --git a/app/models/group.rb b/app/models/group.rb
new file mode 100644
index 0000000..298240b
--- /dev/null
+++ b/app/models/group.rb
@@ -0,0 +1,58 @@
+# A team within a business, such as Billing or Technical Support. Staff join groups through memberships. Groups
+# organize the work: they never hide a request from other staff.
+#
+# Deleting a group removes its memberships, and its requests stay but lose their group and their assignee.
+class Group < ApplicationRecord
+  MAX_NAME_LENGTH = 120
+
+  belongs_to :account
+  # The memberships go with the group. Their own callbacks repair each person's default.
+  has_many :group_memberships, dependent: :destroy, inverse_of: :group
+  before_destroy :clear_tickets
+
+  normalizes :name, with: ->(value) { value.to_s.strip }
+
+  validates :name,
+            presence: true,
+            length: { maximum: MAX_NAME_LENGTH },
+            uniqueness: { scope: :account_id, case_sensitive: false }
+
+  # Creates a group under the business lock, so two admins cannot both take the same name.
+  def self.create_named!(account:, name:)
+    account.with_lock do
+      group = new(account: account, name: name)
+      group.save!
+      group
+    end
+  end
+
+  # Renames the group under the business lock. Returns the group.
+  def rename!(new_name)
+    account.with_lock do
+      reload
+      update!(name: new_name)
+    end
+    self
+  end
+
+  # Deletes the group under the business lock. Returns the group.
+  def remove!
+    account.with_lock do
+      reload
+      destroy!
+    end
+    self
+  end
+
+  def as_api_json
+    { id: id, name: name, created_at: created_at, updated_at: updated_at }
+  end
+
+  private
+
+  # Clears the group and the assignee together, as clearing the group does. Runs before the memberships go, so the
+  # assignments that depended on them are cleared here too.
+  def clear_tickets
+    Ticket.where(group_id: id).update_all(group_id: nil, assignee_id: nil)
+  end
+end
diff --git a/app/models/group_membership.rb b/app/models/group_membership.rb
new file mode 100644
index 0000000..c3e3a5e
--- /dev/null
+++ b/app/models/group_membership.rb
@@ -0,0 +1,107 @@
+# A staff member's place in a group. Admins and agents can belong to several groups. Customers cannot belong to any.
+#
+# Every person with memberships has exactly one default, the group a request goes to when they are assigned it and
+# it has no group yet. The first membership is always the default. Removing the default picks the oldest remaining
+# membership. Suspension keeps memberships; it only clears the person's assignments.
+#
+# Adding, removing and choosing a default run under the business lock, so the default cannot be lost or doubled.
+class GroupMembership < ApplicationRecord
+  belongs_to :account
+  # Optional so that a missing or foreign group is reported as an error on group_id, not as "must exist".
+  belongs_to :group, optional: true
+  belongs_to :user, optional: true
+
+  validate :group_must_belong_to_account
+  validate :user_must_be_staff_of_account
+  validates :user_id, uniqueness: { scope: :group_id, message: "is already in this group" }
+
+  # Removing a membership clears the assignments it supported. Then the person gets a new default, if they still have
+  # memberships. Both run in the same transaction as the delete, also when a whole group or account is deleted.
+  after_destroy :clear_assignments_in_group
+  after_destroy :repair_default
+
+  # Adds a staff member to a group. The first membership is the default, whatever +default+ says. Otherwise +default+
+  # makes this membership the default, and the person's previous default stops being one. Returns the membership.
+  def self.add!(account:, group_id:, user_id:, default: false)
+    account.with_lock do
+      membership = account.group_memberships.new(group_id: group_id, user_id: user_id,
+                                                 default: default || !where(user_id: user_id).exists?)
+      transaction do
+        where(user_id: user_id, default: true).update_all(default: false) if membership.default?
+        membership.save!
+      end
+      membership
+    end
+  end
+
+  # Makes this membership the person's default, and the previous default stops being one. Returns the membership.
+  def make_default!
+    account.with_lock do
+      reload
+      transaction do
+        self.class.where(user_id: user_id, default: true).where.not(id: id).update_all(default: false)
+        update!(default: true)
+      end
+    end
+    self
+  end
+
+  # Removes the person from the group under the business lock. Returns the membership.
+  def remove!
+    account.with_lock do
+      reload
+      destroy!
+    end
+    self
+  end
+
+  def as_api_json
+    {
+      id: id,
+      group_id: group_id,
+      group: group && { id: group.id, name: group.name },
+      user_id: user_id,
+      user: user && { id: user.id, name: user.name },
+      default: default,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  private
+
+  def group_must_belong_to_account
+    if group_id.nil?
+      errors.add(:group_id, :blank)
+    elsif group.nil? || group.account_id != account_id
+      errors.add(:group_id, "must be a group of this business")
+    end
+  end
+
+  # Only admins and agents work in groups. Suspended staff may still belong to groups, so that their memberships are
+  # there when they return.
+  def user_must_be_staff_of_account
+    if user_id.nil?
+      errors.add(:user_id, :blank)
+    elsif user.nil? || user.account_id != account_id
+      errors.add(:user_id, "must be a user of this business")
+    elsif !user.staff?
+      errors.add(:user_id, "must be an admin or agent")
+    end
+  end
+
+  # The person is no longer in this group, so any request in it that they were assigned loses them as assignee.
+  # The request keeps its group.
+  def clear_assignments_in_group
+    Ticket.where(group_id: group_id, assignee_id: user_id).update_all(assignee_id: nil)
+  end
+
+  # If the person has memberships but none is their default, the oldest remaining membership becomes it.
+  def repair_default
+    remaining = self.class.where(user_id: user_id)
+    return if remaining.where(default: true).exists?
+
+    next_id = remaining.minimum(:id)
+    self.class.where(id: next_id).update_all(default: true, updated_at: Time.current) if next_id
+  end
+end
diff --git a/app/models/invitation.rb b/app/models/invitation.rb
new file mode 100644
index 0000000..7ac0fa3
--- /dev/null
+++ b/app/models/invitation.rb
@@ -0,0 +1,155 @@
+# An emailed offer to join a business as an admin or agent. Customers register on their own, so they are never invited.
+#
+# Status comes from the timestamps, so expiry needs no job:
+#   accepted  accepted_at is set
+#   revoked   revoked_at is set, by an admin
+#   pending   neither is set, and expires_at is in the future
+#   expired   neither is set, and expires_at has passed
+#
+# An email can hold at most one pending invitation in a business, and cannot be invited when it already belongs
+# to a user there. Issuing, resending, revoking and accepting all run under the account's row lock, as do customer
+# registration and suspension, so two requests cannot both pass these checks.
+class Invitation < ApplicationRecord
+  TTL = 7.days
+  ROLES = %w[admin agent].freeze
+  STATUSES = %w[pending accepted revoked expired].freeze
+
+  # Raised when a token is unknown, expired, revoked, accepted, or for another business.
+  class InvalidInvitation < StandardError; end
+  # Raised when an admin resends or revokes an invitation that was already accepted or revoked.
+  class AlreadyClosed < StandardError; end
+
+  belongs_to :account
+  belongs_to :invited_by, class_name: "User", optional: true
+
+  normalizes :email, with: ->(value) { value.to_s.strip.downcase }
+
+  validates :email, presence: true, length: { maximum: 254 }, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :role, inclusion: { in: ROLES, message: "must be admin or agent" }
+  validates :token_digest, :expires_at, presence: true
+  # Only checked when an invitation is issued or resent, so existing records do not start failing later.
+  validate :email_must_be_free, on: :issue
+
+  # Invitations in one status. Accepted and revoked are final. Pending and expired depend on the clock.
+  def self.with_status(status)
+    now = Time.current
+    unanswered = where(accepted_at: nil, revoked_at: nil)
+
+    case status
+    when "pending" then unanswered.where("expires_at > ?", now)
+    when "expired" then unanswered.where("expires_at <= ?", now)
+    when "accepted" then where.not(accepted_at: nil)
+    when "revoked" then where(accepted_at: nil).where.not(revoked_at: nil)
+    else raise ArgumentError, "unknown invitation status #{status.inspect}"
+    end
+  end
+
+  # Returns [invitation, raw_token]. The raw token is only emailed, never stored or shown in the API.
+  def self.issue!(account:, invited_by:, email:, role:)
+    raw = generate_token
+    invitation = nil
+    account.with_lock do
+      invitation = new(account: account, invited_by: invited_by, email: email, role: role,
+                       token_digest: digest(raw), expires_at: TTL.from_now)
+      invitation.save!(context: :issue)
+    end
+    [ invitation, raw ]
+  end
+
+  # The pending invitation that +raw+ opens. Raises InvalidInvitation for anything else. When +account+ is given,
+  # the invitation must belong to it.
+  def self.find_pending_by_token!(raw, account: nil, now: Time.current)
+    raise InvalidInvitation if raw.blank?
+
+    scope = where(token_digest: digest(raw))
+    scope = scope.where(account: account) if account
+    invitation = scope.includes(:account).first
+    raise InvalidInvitation unless invitation&.status(now) == "pending"
+
+    invitation
+  end
+
+  def self.digest(raw)
+    Digest::SHA256.hexdigest(raw.to_s)
+  end
+
+  def self.generate_token
+    SecureRandom.urlsafe_base64(32)
+  end
+
+  def status(now = Time.current)
+    return "accepted" if accepted_at
+    return "revoked" if revoked_at
+
+    expires_at > now ? "pending" : "expired"
+  end
+
+  def open?
+    accepted_at.nil? && revoked_at.nil?
+  end
+
+  # Replaces the token and restarts the clock. The old link stops working. Works for pending and expired
+  # invitations. Returns the new raw token.
+  def resend!
+    raw = self.class.generate_token
+    account.with_lock do
+      reload
+      raise AlreadyClosed unless open?
+
+      self.token_digest = self.class.digest(raw)
+      self.expires_at = TTL.from_now
+      save!(context: :issue)
+    end
+    raw
+  end
+
+  # Cancels a pending or expired invitation. The record stays, marked revoked.
+  def revoke!(now: Time.current)
+    account.with_lock do
+      reload
+      raise AlreadyClosed unless open?
+
+      update!(revoked_at: now)
+    end
+  end
+
+  # Creates the verified user with the invited email and role, and marks the invitation accepted. Both happen, or neither does.
+  def accept!(name:, password:, now: Time.current)
+    account.with_lock do
+      reload
+      raise InvalidInvitation unless status(now) == "pending"
+
+      user = account.users.create!(name: name, email: email, password: password, role: role, verified_at: now)
+      update!(accepted_at: now)
+      user
+    end
+  end
+
+  def as_api_json(now: Time.current)
+    {
+      id: id,
+      email: email,
+      role: role,
+      status: status(now),
+      expires_at: expires_at,
+      accepted_at: accepted_at,
+      revoked_at: revoked_at,
+      invited_by: invited_by && { id: invited_by.id, name: invited_by.name },
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  private
+
+  def email_must_be_free
+    return if email.blank? || account.nil?
+
+    if account.users.exists?(email: email)
+      errors.add(:email, "already belongs to a user in this business")
+    end
+    if account.invitations.with_status("pending").where(email: email).where.not(id: id).exists?
+      errors.add(:email, "already has a pending invitation")
+    end
+  end
+end
