+module Api
+  module V1
+    # A customer's own requests. Customers open requests and reply here. The list can be filtered by status.
+    class RequestsController < ApplicationController
+      include Paginated
+      include Replies
+      include ListFilters
+
+      before_action :authenticate_session!
+
+      # The status filter only. Other filters, priority included, are for staff and are ignored here.
+      def index
+        errors = {}
+        status = choice_param(:status, Ticket::STATUSES, errors)
+        return render_validation_failed(errors) if errors.any?
+
+        scope = current_account.tickets.requested_by(current_user)
+        scope = scope.with_status(status) if status
+        render_page(scope.recently_active, key: "requests", &:as_request_json)
+      end
+
+      def show
+        render json: { request: find_own_request.as_request_json }
+      end
+
+      def create
+        input = require_params(:request).permit(:subject, comment: :body)
+        ticket = Ticket.open!(requester: current_user, subject: input[:subject], body: input.dig(:comment, :body).to_s)
+
+        render json: { request: ticket.as_request_json }, status: :created
+      end
+
+      # Customer replies reopen a pending or solved request, unless the same update marks it solved.
+      def update
+        input = require_params(:request).permit(:status, comment: :body)
+        ticket = find_own_request
+        return if reject_empty_reply(input)
+
+        ticket.reply!(author: current_user, body: reply_body(input), status: reply_status(input), customer: true)
+        render json: { request: ticket.as_request_json }
+      end
+
+      private
+
+      def find_own_request
+        current_account.tickets.requested_by(current_user).find(params[:id])
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/sessions_controller.rb b/app/controllers/api/v1/sessions_controller.rb
new file mode 100644
index 0000000..4c892f7
--- /dev/null
+++ b/app/controllers/api/v1/sessions_controller.rb
@@ -0,0 +1,56 @@
+module Api
+  module V1
+    class SessionsController < ApplicationController
+      before_action :authenticate_session!, only: :destroy
+
+      available_while_cancelled :destroy
+
+      # Sign in. With X-Helpdesk-Account, the email is looked up in that business.
+      # Without it, the email must belong to exactly one business.
+      def create
+        credentials = require_params(:session).permit(:email, :password)
+        password = credentials[:password].to_s
+
+        account = optional_account_from_header
+        return if performed?
+
+        candidates = (account ? account.users : User.all).where(email: credentials[:email]).includes(:account).to_a
+        matches = candidates.select { |user| user.authenticate(password) }
+
+        if matches.empty?
+          # Hash anyway when no user matched, so response time does not reveal whether the email exists.
+          BCrypt::Password.create(password) if candidates.empty?
+          return render_error(:unauthorized, "invalid_credentials", "Email or password is incorrect.")
+        end
+
+        if matches.many?
+          return render_error(
+            :unprocessable_entity,
+            "account_required",
+            "This email belongs to several businesses. Send the X-Helpdesk-Account header to choose one."
+          )
+        end
+
+        user = matches.first
+        return render_error(:forbidden, "user_suspended", "This user has been suspended. Ask an admin to reinstate it.") if user.suspended?
+        return render_error(:forbidden, "email_not_verified", "Verify your email address before signing in.") unless user.verified?
+
+        if user.account.cancelled? && !user.admin?
+          return render_error(:forbidden, "account_cancelled", "This business has been cancelled.")
+        end
+
+        session, token = Session.issue!(user)
+        render json: {
+          session: { token: token, expires_at: session.expires_at },
+          user: user.as_api_json,
+          account: user.account.as_api_json
+        }, status: :created
+      end
+
+      def destroy
+        current_session.destroy!
+        head :no_content
+      end
+    end
+  end
+end
