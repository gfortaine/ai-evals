diff --git a/app/controllers/api/v1/tickets_controller.rb b/app/controllers/api/v1/tickets_controller.rb
new file mode 100644
index 0000000..866af3a
--- /dev/null
+++ b/app/controllers/api/v1/tickets_controller.rb
@@ -0,0 +1,186 @@
+module Api
+  module V1
+    # The staff view of every request in the business. Staff reply here, set the status and priority, assign the
+    # request, and add private notes. The list can be filtered, and the filters combine.
+    class TicketsController < ApplicationController
+      include Paginated
+      include Replies
+      include ListFilters
+
+      before_action :authenticate_session!
+      before_action :require_staff!
+
+      # Filters: status, priority, requester_id, group_id (a group ID, or "unassigned" for requests with no group),
+      # assignee_id (a user ID, or "unassigned") and q, which searches subjects and public comments. Each one narrows
+      # the list, and a request must match all of them.
+      def index
+        errors = {}
+        scope = filter_tickets(current_account.tickets, errors)
+        return render_validation_failed(errors) if errors.any?
+
+        render_page(scope.includes(:requester, :assignee, :group).recently_active, key: "tickets", &:as_ticket_json)
+      end
+
+      def show
+        render json: { ticket: find_ticket.as_ticket_json }
+      end
+
+      # A staff reply does not change the status unless the update sets one. A comment is public unless it says otherwise.
+      # Assigning an agent, moving the request to a group, changing the priority and posting private notes do not move
+      # the request up the list.
+      def update
+        body = require_params(:ticket)
+        input = body.permit(:status, :assignee_id, :group_id, :priority, comment: %i[body public])
+        ticket = find_ticket
+        return if reject_empty_reply(input, keys: %i[comment status assignee_id group_id priority],
+                                            message: "Send a comment, a status, an assignee, a group, a priority, or a combination.")
+
+        errors = {}
+        public_comment = comment_public?(input, errors)
+        assignee_id = assignee_id_param(input, errors)
+        group_id = group_id_param(body, errors)
+        priority = priority_param(body, errors)
+        return render_validation_failed(errors) if errors.any?
+
+        ticket.reply!(author: current_user, body: reply_body(input), status: reply_status(input),
+                      public_comment: public_comment, assignee_id: assignee_id, group_id: group_id, priority: priority)
+        render json: { ticket: ticket.as_ticket_json }
+      end
+
+      # Merges a duplicate, this request, into the request named by merge.target_id. This request is closed and keeps
+      # its conversation, and both requests get a note. See Ticket#merge_into!. Returns both as they are afterwards.
+      def merge
+        body = require_params(:merge)
+        return render_error(:bad_request, "parameter_missing", "Send target_id, the ticket to merge into.") unless body.key?(:target_id)
+
+        ticket = find_ticket
+        errors = {}
+        target_id = merge_target_id_param(body, errors)
+        source_note = merge_note_param(body, :source_comment, errors)
+        target_note = merge_note_param(body, :target_comment, errors)
+        return render_validation_failed(errors) if errors.any?
+
+        source, target = ticket.merge_into!(target_id: target_id, author: current_user,
+                                            source_note: source_note, target_note: target_note)
+        render json: { source: source.as_ticket_json, target: target.as_ticket_json }
+      end
+
+      private
+
+      def find_ticket
+        current_account.tickets.includes(:requester, :assignee, :group).find(params[:id])
+      end
+
+      # Applies every filter that was sent. An invalid value adds an error and filters nothing.
+      def filter_tickets(scope, errors)
+        status = choice_param(:status, Ticket::STATUSES, errors)
+        priority = choice_param(:priority, Ticket::PRIORITIES, errors)
+        requester_id = user_id_param(:requester_id, errors)
+        group = id_param(:group_id, errors, noun: "a group ID", also: %w[unassigned])
+        assignee = user_id_param(:assignee_id, errors, also: %w[unassigned])
+        text = text_param(:q, errors)
+
+        scope = scope.with_status(status) if status
+        scope = scope.with_priority(priority) if priority
+        scope = scope.where(requester_id: requester_id) if requester_id
+        scope = scope.search(text) if text
+        unless group.nil?
+          scope = group == "unassigned" ? scope.ungrouped : scope.where(group_id: group)
+        end
+        case assignee
+        when nil then scope
+        when "unassigned" then scope.unassigned
+        else scope.where(assignee_id: assignee)
+        end
+      end
+
+      # Whether the comment is public. Omitted means public. Anything other than true or false is an error.
+      def comment_public?(input, errors)
+        comment = input[:comment]
+        return true unless comment.respond_to?(:key?) && comment.key?(:public)
+
+        value = BooleanParam.parse(comment[:public])
+        return value unless value.nil?
+
+        errors[:"comment.public"] = [ "must be true or false" ]
+        true
+      end
+
+      # The assignee to set: a user ID, nil to clear, or Ticket::UNCHANGED when the key is absent.
+      # A value that is not a user ID is an error, not a guess.
+      def assignee_id_param(input, errors)
+        return Ticket::UNCHANGED unless input.key?(:assignee_id)
+
+        raw = input[:assignee_id].to_s.strip
+        return nil if raw.empty?
+        return raw.to_i if raw.match?(/\A\d{1,18}\z/)
+
+        errors[:assignee_id] = [ "must be a user ID, or null to unassign" ]
+        nil
+      end
+
+      # The group to set: an ID, nil to remove the request from its group, or Ticket::UNCHANGED when the key is absent.
+      # A value that is not an ID is an error, not a guess. This reads the whole body, so an object is refused too.
+      def group_id_param(body, errors)
+        return Ticket::UNCHANGED unless body.key?(:group_id)
+
+        raw = body[:group_id].to_s.strip
+        return nil if raw.empty?
+        return raw.to_i if raw.match?(/\A\d{1,18}\z/)
+
+        errors[:group_id] = [ "must be a group ID, or null to remove it from its group" ]
+        nil
+      end
+
+      # The request to merge into, as an ID. Anything else is an error, including a missing or null value.
+      def merge_target_id_param(body, errors)
+        raw = body[:target_id].to_s.strip
+        return raw.to_i if raw.match?(ListFilters::ID_FORMAT)
+
+        errors[:target_id] = [ "must be a ticket ID" ]
+        nil
+      end
+
+      # A note on a merge: { body, public }. A key that is not sent is left out, so the model supplies its default: the
+      # generated text, and private. A body must be text, and public must be true or false.
+      def merge_note_param(body, key, errors)
+        return {} unless body.key?(key)
+
+        note = body[key]
+        unless note.is_a?(ActionController::Parameters)
+          errors[key] = [ "must be an object with body and public" ]
+          return {}
+        end
+
+        result = {}
+        if note.key?(:body)
+          if note[:body].is_a?(String)
+            result[:body] = note[:body]
+          else
+            errors[:"#{key}.body"] = [ "must be text" ]
+          end
+        end
+        if note.key?(:public)
+          value = BooleanParam.parse(note[:public])
+          if value.nil?
+            errors[:"#{key}.public"] = [ "must be true or false" ]
+          else
+            result[:public] = value
+          end
+        end
+        result
+      end
+
+      # The priority to set, or nil to leave it alone. Only "normal" or "high". A request always has one, so null is
+      # refused. This reads the whole body, not the permitted keys, so an object or a list is refused rather than
+      # silently ignored.
+      def priority_param(body, errors)
+        return nil unless body.key?(:priority)
+        return body[:priority] if Ticket::PRIORITIES.include?(body[:priority])
+
+        errors[:priority] = [ "must be normal or high" ]
+        nil
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/users_controller.rb b/app/controllers/api/v1/users_controller.rb
