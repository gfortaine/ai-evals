+require "test_helper"
+
+class PaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @avery_token = customer_sign_in!
+  end
+
+  test "lists default to page 1 and 25 per page, and report the metadata" do
+    open_request!(token: @avery_token)
+
+    api_get("/requests", token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal %w[count next_page page per_page previous_page requests], json.keys.sort
+    assert_equal 1, json["count"]
+    assert_equal 1, json["page"]
+    assert_equal 25, json["per_page"]
+    assert_nil json["next_page"]
+    assert_nil json["previous_page"]
+  end
+
+  test "the count is the total across all pages, not just this page" do
+    3.times { open_request!(token: @avery_token) }
+
+    api_get("/requests?per_page=2", token: @avery_token, account: "acme")
+
+    assert_equal 2, json["requests"].size
+    assert_equal 3, json["count"]
+    assert_equal 2, json["per_page"]
+  end
+
+  test "next and previous pages are given when they exist" do
+    3.times { open_request!(token: @avery_token) }
+
+    api_get("/requests?per_page=2&page=1", token: @avery_token, account: "acme")
+    assert_nil json["previous_page"]
+    assert_equal 2, json["next_page"]
+
+    api_get("/requests?per_page=2&page=2", token: @avery_token, account: "acme")
+    assert_equal 1, json["requests"].size
+    assert_equal 1, json["previous_page"]
+    assert_nil json["next_page"]
+  end
+
+  test "pages do not overlap and together cover every record" do
+    ids = 5.times.map { open_request!(token: @avery_token) }
+
+    seen = []
+    (1..3).each do |page|
+      api_get("/requests?per_page=2&page=#{page}", token: @avery_token, account: "acme")
+      seen.concat(json["requests"].map { |r| r["id"] })
+    end
+
+    assert_equal ids.reverse, seen
+  end
+
+  test "a page past the end is empty, with no next page" do
+    open_request!(token: @avery_token)
+
+    api_get("/requests?page=9&per_page=5", token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal [], json["requests"]
+    assert_equal 1, json["count"]
+    assert_nil json["next_page"]
+    assert_equal 8, json["previous_page"]
+  end
+
+  test "a huge page number is handled as an empty page" do
+    open_request!(token: @avery_token)
+
+    api_get("/requests?page=99999999999999999999999", token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal [], json["requests"]
+  end
+
+  test "the per_page limit is 100" do
+    api_get("/requests?per_page=100", token: @avery_token, account: "acme")
+    assert_response :ok
+    assert_equal 100, json["per_page"]
+
+    api_get("/requests?per_page=101", token: @avery_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "per_page").present?
+  end
+
+  test "page and per_page must be positive whole numbers" do
+    [ "0", "-1", "abc", "1.5", "2x", "%5B1%5D" ].each do |bad|
+      api_get("/requests?page=#{bad}", token: @avery_token, account: "acme")
+      assert_response :unprocessable_entity, "expected page=#{bad} to be refused"
+      assert json.dig("error", "errors", "page").present?
+    end
+
+    api_get("/requests?per_page=0", token: @avery_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "per_page").present?
+  end
+
+  test "an empty page or per_page parameter falls back to the default" do
+    open_request!(token: @avery_token)
+
+    api_get("/requests?page=&per_page=", token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal 1, json["page"]
+    assert_equal 25, json["per_page"]
+  end
+
+  test "comments are paginated, oldest first" do
+    id = open_request!(token: @avery_token, body: "First")
+    api_patch("/requests/#{id}", { request: { comment: { body: "Second" } } }, token: @avery_token, account: "acme")
+    api_patch("/requests/#{id}", { request: { comment: { body: "Third" } } }, token: @avery_token, account: "acme")
+
+    api_get("/requests/#{id}/comments?per_page=2&page=1", token: @avery_token, account: "acme")
+    assert_equal [ "First", "Second" ], json["comments"].map { |c| c["body"] }
+    assert_equal 3, json["count"]
+    assert_equal 2, json["next_page"]
+
+    api_get("/requests/#{id}/comments?per_page=2&page=2", token: @avery_token, account: "acme")
+    assert_equal [ "Third" ], json["comments"].map { |c| c["body"] }
+    assert_nil json["next_page"]
+  end
+
+  test "staff lists are paginated the same way" do
+    3.times { open_request!(token: @avery_token) }
+
+    api_get("/tickets?per_page=2", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal 2, json["tickets"].size
+    assert_equal 3, json["count"]
+    assert_equal 2, json["next_page"]
+  end
+end
diff --git a/test/integration/password_reset_test.rb b/test/integration/password_reset_test.rb
new file mode 100644
index 0000000..f0a53f2
--- /dev/null
+++ b/test/integration/password_reset_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class PasswordResetTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    verify_email!("jo@acme.test")
+  end
+
+  test "requesting a reset emails a link to the frontend with account and token" do
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "acme")
+
+    assert_response :accepted
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "jo@acme.test" ], mail.to
+    assert_equal [ Helpdesk::Settings.mail_from ], mail.from
+    assert_match %r{\A#{Regexp.escape(Helpdesk::Settings.frontend_url)}/reset-password\?account=acme&token=[\w-]+\z},
+                 mail.body.decoded[%r{http://\S+}]
+  end
+
+  test "an unknown email gets the same answer but no mail" do
+    deliveries = ActionMailer::Base.deliveries.size
+    api_post("/password_resets", { password_reset: { email: "nobody@acme.test" } }, account: "acme")
+
+    assert_response :accepted
+    assert_equal deliveries, ActionMailer::Base.deliveries.size
+    assert json["message"].present?
+  end
+
+  test "a reset link sets the new password, signs out sessions and works only once" do
+    old_session = sign_in!(email: "jo@acme.test")
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "acme")
+    token = reset_token("jo@acme.test")
+
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: NEW_PASSWORD } }, account: "acme")
+    assert_response :ok
+
+    api_get("/me", token: old_session, account: "acme")
+    assert_response :unauthorized
+    assert sign_in!(email: "jo@acme.test", password: NEW_PASSWORD).present?
+    api_post("/sessions", { session: { email: "jo@acme.test", password: PASSWORD } }, account: "acme")
+    assert_response :unauthorized
+
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: "another-password" } }, account: "acme")
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "requesting another reset replaces the earlier link" do
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "acme")
+    old_token = reset_token("jo@acme.test")
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "acme")
+    new_token = reset_token("jo@acme.test")
+    assert_not_equal old_token, new_token
+
+    api_post("/password_resets/confirm", { password_reset: { token: old_token, password: NEW_PASSWORD } }, account: "acme")
+    assert_response :unprocessable_entity
+
+    api_post("/password_resets/confirm", { password_reset: { token: new_token, password: NEW_PASSWORD } }, account: "acme")
+    assert_response :ok
+  end
+
+  test "a rejected password keeps the link usable" do
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "acme")
+    token = reset_token("jo@acme.test")
+
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: "short" } }, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "password").present?
+
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: "" } }, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "password").present?
+    assert User.find_by!(email: "jo@acme.test").authenticate(PASSWORD)
+
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: NEW_PASSWORD } }, account: "acme")
+    assert_response :ok
+  end
+
+  test "a reset link expires after its lifetime" do
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "acme")
+    token = reset_token("jo@acme.test")
+
+    travel PasswordReset::TTL + 1.minute do
+      api_post("/password_resets/confirm", { password_reset: { token: token, password: NEW_PASSWORD } }, account: "acme")
+    end
+
+    assert_response :unprocessable_entity
+    assert User.find_by!(email: "jo@acme.test").authenticate(PASSWORD)
+  end
+
+  test "a reset link from one business cannot be redeemed through another" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@acme.test", password: "globex-password")
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "globex")
+    globex_token = reset_token("jo@acme.test", account: "globex")
+
+    api_post("/password_resets/confirm", { password_reset: { token: globex_token, password: NEW_PASSWORD } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert User.find_by!(email: "jo@acme.test", account: Account.find_by!(subdomain: "acme")).authenticate(PASSWORD)
+  end
+
+  test "a reset also verifies an unverified owner, because the link proves the mailbox" do
+    signup!(subdomain: "globex", name: "Globex", email: "sam@globex.test")
+    api_post("/password_resets", { password_reset: { email: "sam@globex.test" } }, account: "globex")
+    token = reset_token("sam@globex.test", account: "globex")
+
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: NEW_PASSWORD } }, account: "globex")
+
+    assert_response :ok
+    assert_equal true, json.dig("user", "verified")
+  end
+
+  test "a reset for one business does not touch the same email in another" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@acme.test", password: "globex-password")
+    verify_email!("jo@acme.test", account: "globex")
+
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "globex")
+    token = reset_token("jo@acme.test", account: "globex")
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: NEW_PASSWORD } }, account: "globex")
+    assert_response :ok
+
+    assert User.find_by!(email: "jo@acme.test", account: Account.find_by!(subdomain: "acme")).authenticate(PASSWORD)
+  end
+end
diff --git a/test/integration/profile_and_sessions_test.rb b/test/integration/profile_and_sessions_test.rb
new file mode 100644
index 0000000..795faa3
--- /dev/null
+++ b/test/integration/profile_and_sessions_test.rb
@@ -0,0 +1,153 @@
+require "test_helper"
+
+class ProfileAndSessionsTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @token = verified_sign_in!
+  end
+
+  test "GET /me returns the signed-in user" do
+    api_get("/me", token: @token, account: "acme")
+
+    assert_response :ok
+    assert_equal "jo@acme.test", json.dig("user", "email")
+    assert_equal "admin", json.dig("user", "role")
+  end
+
+  test "PATCH /me changes the name" do
+    api_patch("/me", { user: { name: "Jo Smith" } }, token: @token, account: "acme")
+
+    assert_response :ok
+    assert_equal "Jo Smith", json.dig("user", "name")
+    assert_equal "Jo Smith", User.find_by!(email: "jo@acme.test").name
+  end
+
+  test "PATCH /me ignores fields that are not the user's to change" do
+    api_patch("/me", { user: { name: "Jo", role: "agent", verified: false, email: "evil@acme.test" } },
+              token: @token, account: "acme")
+
+    assert_response :ok
+    user = User.find_by!(email: "jo@acme.test")
+    assert user.admin?
+    assert user.verified?
+  end
+
+  test "PATCH /me rejects a blank name" do
+    api_patch("/me", { user: { name: "  " } }, token: @token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "name").present?
+  end
+
+  test "a wrong current password is rejected and changes nothing" do
+    api_put("/me/password", { password_change: { current_password: "not-the-password", password: NEW_PASSWORD } },
+            token: @token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_equal "invalid_current_password", json.dig("error", "code")
+    assert User.find_by!(email: "jo@acme.test").authenticate(PASSWORD)
+  end
+
+  test "a blank new password is rejected instead of silently ignored" do
+    api_put("/me/password", { password_change: { current_password: PASSWORD, password: "" } },
+            token: @token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "password").present?
+    assert User.find_by!(email: "jo@acme.test").authenticate(PASSWORD)
+  end
+
+  test "a short new password is rejected" do
+    api_put("/me/password", { password_change: { current_password: PASSWORD, password: "short" } },
+            token: @token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "password").present?
+  end
+
+  test "changing the password signs out every session, and the new password works" do
+    other_token = sign_in!(email: "jo@acme.test")
+
+    api_put("/me/password", { password_change: { current_password: PASSWORD, password: NEW_PASSWORD } },
+            token: @token, account: "acme")
+    assert_response :ok
+
+    api_get("/me", token: @token, account: "acme")
+    assert_response :unauthorized
+    api_get("/me", token: other_token, account: "acme")
+    assert_response :unauthorized
+
+    api_post("/sessions", { session: { email: "jo@acme.test", password: PASSWORD } }, account: "acme")
+    assert_response :unauthorized
+
+    assert sign_in!(email: "jo@acme.test", password: NEW_PASSWORD).present?
+  end
+
+  test "DELETE /session signs out only that session" do
+    other_token = sign_in!(email: "jo@acme.test")
+
+    api_delete("/session", token: @token, account: "acme")
+    assert_response :no_content
+
+    api_get("/me", token: @token, account: "acme")
+    assert_response :unauthorized
+
+    api_get("/me", token: other_token, account: "acme")
+    assert_response :ok
+  end
+
+  test "a session expires after its lifetime" do
+    travel Session::TTL + 1.minute do
+      api_get("/me", token: @token, account: "acme")
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "requests without a valid bearer token are unauthenticated" do
+    api_get("/me", account: "acme")
+    assert_response :unauthorized
+    assert_equal "unauthenticated", json.dig("error", "code")
+
+    api_get("/me", token: "not-a-real-token", account: "acme")
+    assert_response :unauthorized
+
+    api_get("/account", headers: { "Authorization" => "Basic abc" }, account: "acme")
+    assert_response :unauthorized
+  end
+
+  test "a session cannot be used with a different business header" do
+    signup!(subdomain: "globex", name: "Globex", email: "sam@globex.test")
+
+    api_get("/me", token: @token, account: "globex")
+
+    assert_response :forbidden
+    assert_equal "account_mismatch", json.dig("error", "code")
+  end
+
+  test "the account header is optional when a session is present" do
+    api_get("/me", token: @token)
+
+    assert_response :ok
+  end
+
+  test "GET /account returns the full account to a signed-in user" do
+    api_get("/account", token: @token, account: "acme")
+
+    assert_response :ok
+    assert_equal "acme", json.dig("account", "subdomain")
+    assert_equal "Acme", json.dig("account", "name")
+    assert_equal "active", json.dig("account", "status")
+    assert json.dig("account", "created_at").present?
+  end
+
+  test "GET /account requires a session" do
+    api_get("/account", account: "acme")
+
+    assert_response :unauthorized
+  end
+
+  test "the business owner who signs up is an admin" do
+    assert_equal "admin", User.find_by!(email: "jo@acme.test").role
+  end
+end
diff --git a/test/integration/signup_test.rb b/test/integration/signup_test.rb
new file mode 100644
index 0000000..584cf25
--- /dev/null
+++ b/test/integration/signup_test.rb
@@ -0,0 +1,183 @@
+require "test_helper"
+
+class SignupTest < ActionDispatch::IntegrationTest
+  test "signup creates the business and an unverified admin, and emails a verification link" do
+    assert_difference(%w[Account.count User.count], 1) do
+      signup!
+    end
+
+    assert_response :created
+    assert json.dig("account", "id").present?
+    assert json.dig("account", "created_at").present?
+    assert_equal "acme", json.dig("account", "subdomain")
+    assert_equal "active", json.dig("account", "status")
+
+    assert json.dig("user", "id").present?
+    assert json.dig("user", "created_at").present?
+    assert_equal json.dig("account", "id"), json.dig("user", "account_id")
+    assert_equal "admin", json.dig("user", "role")
+    assert_equal false, json.dig("user", "verified")
+    assert_not json["user"].key?("password_digest")
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ Helpdesk::Settings.mail_from ], mail.from
+    assert_match %r{\A#{Regexp.escape(Helpdesk::Settings.frontend_url)}/verify-email\?account=acme&token=[\w-]+\z},
+                 mail.body.decoded[%r{http://\S+}]
+  end
+
+  test "an admin cannot sign in until the email is verified" do
+    signup!
+    api_post("/sessions", { session: { email: "jo@acme.test", password: PASSWORD } }, account: "acme")
+
+    assert_response :forbidden
+    assert_equal "email_not_verified", json.dig("error", "code")
+  end
+
+  test "verifying the email allows sign in, which returns a session token, the user and the account" do
+    signup!
+    verify_email!("jo@acme.test")
+    assert_response :ok
+    assert_equal true, json.dig("user", "verified")
+
+    api_post("/sessions", { session: { email: "jo@acme.test", password: PASSWORD } }, account: "acme")
+
+    assert_response :created
+    assert json.dig("session", "token").present?
+    assert json.dig("session", "expires_at").present?
+    assert_equal "jo@acme.test", json.dig("user", "email")
+    assert_equal "acme", json.dig("account", "subdomain")
+  end
+
+  test "a verification link works only once" do
+    signup!
+    token = verification_token("jo@acme.test")
+
+    api_post("/email_verifications/confirm", { email_verification: { token: token } })
+    assert_response :ok
+
+    api_post("/email_verifications/confirm", { email_verification: { token: token } })
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "requesting another verification link replaces the earlier one" do
+    signup!
+    old_token = verification_token("jo@acme.test")
+
+    api_post("/email_verifications", { email_verification: { email: "jo@acme.test" } }, account: "acme")
+    assert_response :accepted
+    new_token = verification_token("jo@acme.test")
+    assert_not_equal old_token, new_token
+
+    api_post("/email_verifications/confirm", { email_verification: { token: old_token } })
+    assert_response :unprocessable_entity
+
+    api_post("/email_verifications/confirm", { email_verification: { token: new_token } })
+    assert_response :ok
+  end
+
+  test "resending a verification link for an unknown email says nothing and sends nothing" do
+    signup!
+    deliveries = ActionMailer::Base.deliveries.size
+
+    api_post("/email_verifications", { email_verification: { email: "nobody@acme.test" } }, account: "acme")
+
+    assert_response :accepted
+    assert_equal deliveries, ActionMailer::Base.deliveries.size
+  end
+
+  test "the same email can sign up to a different business and sign in separately" do
+    signup!(subdomain: "acme", email: "jo@acme.test", password: "password-one")
+    signup!(subdomain: "globex", name: "Globex", email: "jo@acme.test", password: "password-two")
+    assert_response :created
+    assert_equal "jo@acme.test", json.dig("user", "email")
+
+    verified_sign_in!(account: "acme", password: "password-one")
+    verify_email!("jo@acme.test", account: "globex")
+
+    assert sign_in!(email: "jo@acme.test", password: "password-one", account: "acme").present?
+    assert sign_in!(email: "jo@acme.test", password: "password-two", account: "globex").present?
+
+    api_post("/sessions", { session: { email: "jo@acme.test", password: "password-two" } }, account: "acme")
+    assert_response :unauthorized
+  end
+
+  test "signing in without the header works when the email belongs to only one business" do
+    signup!
+    verified_sign_in!
+
+    api_post("/sessions", { session: { email: "jo@acme.test", password: PASSWORD } })
+
+    assert_response :created
+    assert_equal "acme", json.dig("account", "subdomain")
+  end
+
+  test "signing in without the header is refused when the email belongs to several businesses" do
+    signup!(subdomain: "acme", email: "jo@acme.test", password: "same-password-1")
+    signup!(subdomain: "globex", name: "Globex", email: "jo@acme.test", password: "same-password-1")
+    verify_email!("jo@acme.test", account: "acme")
+    verify_email!("jo@acme.test", account: "globex")
+
+    api_post("/sessions", { session: { email: "jo@acme.test", password: "same-password-1" } })
+
+    assert_response :unprocessable_entity
+    assert_equal "account_required", json.dig("error", "code")
+  end
+
+  test "signup validation reports every problem with the account and admin fields" do
+    assert_no_difference(%w[Account.count User.count]) do
+      api_post("/account/create", {
+        account: { name: "", subdomain: "Not Valid!", admin: { name: "", email: "nope", password: "short" } }
+      })
+    end
+
+    assert_response :unprocessable_entity
+    errors = json.dig("error", "errors")
+    assert errors.key?("account.name")
+    assert errors.key?("account.subdomain")
+    assert errors.key?("admin.name")
+    assert errors.key?("admin.email")
+    assert errors.key?("admin.password")
+  end
+
+  test "subdomains must be unique and cannot be reserved" do
+    signup!
+    assert_response :created
+
+    signup!
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "account.subdomain").present?
+
+    signup!(subdomain: "www")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "account.subdomain").present?
+  end
+
+  test "subdomain is case-insensitive and stored in lowercase" do
+    signup!(subdomain: "  ACME ")
+
+    assert_response :created
+    assert_equal "acme", json.dig("account", "subdomain")
+  end
+
+  test "a missing admin block is a bad request" do
+    api_post("/account/create", { account: { name: "Acme", subdomain: "acme" } })
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "admin.email").present?
+  end
+
+  test "an envelope that is not an object is a bad request, not a server error" do
+    api_post("/account/create", { account: "Acme" })
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "a request without the account envelope is a bad request" do
+    api_post("/account/create", { name: "Acme" })
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+end
diff --git a/test/integration/staff_tickets_test.rb b/test/integration/staff_tickets_test.rb
new file mode 100644
index 0000000..ac55b79
--- /dev/null
+++ b/test/integration/staff_tickets_test.rb
@@ -0,0 +1,176 @@
+require "test_helper"
+
+class StaffTicketsTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = User.find_by!(email: "jo@acme.test", account: Account.find_by!(subdomain: "acme"))
+    @avery_token = customer_sign_in!
+    @avery = User.find_by!(email: "avery@example.test", account: Account.find_by!(subdomain: "acme"))
+    @request_id = open_request!(token: @avery_token)
+  end
+
+  test "staff list tickets, with the requester as a small object" do
+    api_get("/tickets", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    ticket = json["tickets"].find { |t| t["id"] == @request_id }
+    assert_equal %w[assignee assignee_id created_at group group_id id merged_into_id priority requester status subject updated_at], ticket.keys.sort
+    assert_equal({ "id" => @avery.id, "name" => "Avery", "email" => "avery@example.test" }, ticket["requester"])
+    assert_equal "open", ticket["status"]
+    assert_equal "Cannot download my receipt", ticket["subject"]
+  end
+
+  test "staff show one ticket inside the ticket envelope" do
+    api_get("/tickets/#{@request_id}", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal @request_id, json.dig("ticket", "id")
+    assert_equal "avery@example.test", json.dig("ticket", "requester", "email")
+  end
+
+  test "agents are staff too and can work the queue" do
+    User.create!(account: Account.find_by!(subdomain: "acme"), name: "Ann", email: "ann@acme.test",
+                 password: "agent-password", role: "agent", verified_at: Time.current)
+    agent_token = sign_in!(email: "ann@acme.test", password: "agent-password")
+
+    api_get("/tickets", token: agent_token, account: "acme")
+    assert_response :ok
+
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "On it." } } }, token: agent_token, account: "acme")
+    assert_response :ok
+  end
+
+  test "customers cannot reach any staff route" do
+    api_get("/tickets", token: @avery_token, account: "acme")
+    assert_response :forbidden
+    assert_equal "staff_only", json.dig("error", "code")
+
+    api_get("/tickets/#{@request_id}", token: @avery_token, account: "acme")
+    assert_response :forbidden
+
+    api_get("/tickets/#{@request_id}/comments", token: @avery_token, account: "acme")
+    assert_response :forbidden
+
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "Sneaky" }, status: "solved" } }, token: @avery_token, account: "acme")
+    assert_response :forbidden
+
+    assert_equal "open", Ticket.find(@request_id).status
+    assert_equal 1, Comment.where(ticket_id: @request_id).count
+  end
+
+  test "a staff reply posts the comment as the staff member and sets the status" do
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "Please try again now." }, status: "pending" } },
+              token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal "pending", json.dig("ticket", "status")
+    comment = Ticket.find(@request_id).comments.last
+    assert_equal "Please try again now.", comment.body
+    assert_equal @owner, comment.author
+  end
+
+  test "a staff reply by itself does not change the status" do
+    Ticket.find(@request_id).update!(status: "solved")
+
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "FYI, we are looking into it." } } },
+              token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal "solved", json.dig("ticket", "status")
+    assert_equal "solved", Ticket.find(@request_id).status
+  end
+
+  test "staff can set any of open, pending or solved, with or without a comment" do
+    %w[pending solved open].each do |status|
+      api_patch("/tickets/#{@request_id}", { ticket: { status: status } }, token: @owner_token, account: "acme")
+      assert_response :ok
+      assert_equal status, json.dig("ticket", "status")
+    end
+  end
+
+  test "staff cannot set a status outside the three choices, and nothing is saved" do
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "Closing this" }, status: "closed" } },
+              token: @owner_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "status").present?
+    assert_equal "open", Ticket.find(@request_id).status
+    assert_equal 1, Comment.where(ticket_id: @request_id).count
+  end
+
+  test "a blank staff reply is refused and the status is not changed" do
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "" }, status: "solved" } },
+              token: @owner_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "comment.body").present?
+    assert_equal "open", Ticket.find(@request_id).status
+  end
+
+  test "a staff update that sends neither a comment nor a status is a bad request" do
+    api_patch("/tickets/#{@request_id}", { ticket: { subject: "Renamed" } }, token: @owner_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "staff see internal comments, customers do not" do
+    Comment.create!(ticket_id: @request_id, author: @owner, body: "Internal: refund approved in billing", public: false)
+
+    api_get("/tickets/#{@request_id}/comments", token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal [ "The download button does nothing.", "Internal: refund approved in billing" ], json["comments"].map { |c| c["body"] }
+    assert_equal [ true, false ], json["comments"].map { |c| c["public"] }
+
+    api_get("/requests/#{@request_id}/comments", token: @avery_token, account: "acme")
+    assert_equal [ "The download button does nothing." ], json["comments"].map { |c| c["body"] }
+  end
+
+  test "a staff comment is public unless it is marked private" do
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "Public?" } } }, token: @owner_token, account: "acme")
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "Internal?", public: false } } },
+              token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal true, Comment.find_by!(body: "Public?").public
+    assert_equal false, Comment.find_by!(body: "Internal?").public
+    api_get("/requests/#{@request_id}/comments", token: @avery_token, account: "acme")
+    assert_includes json["comments"].map { |c| c["body"] }, "Public?"
+    refute_includes json["comments"].map { |c| c["body"] }, "Internal?"
+  end
+
+  test "staff reach the comments of any request in the business, oldest first" do
+    api_patch("/requests/#{@request_id}", { request: { comment: { body: "Second." } } }, token: @avery_token, account: "acme")
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "Third." } } }, token: @owner_token, account: "acme")
+
+    api_get("/tickets/#{@request_id}/comments", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal [ "The download button does nothing.", "Second.", "Third." ], json["comments"].map { |c| c["body"] }
+    assert_equal [ @avery.id, @avery.id, @owner.id ], json["comments"].map { |c| c.dig("author", "id") }
+  end
+
+  test "a ticket from another business is not found" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_owner = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+
+    api_get("/tickets/#{@request_id}", token: globex_owner, account: "globex")
+    assert_response :not_found
+
+    api_patch("/tickets/#{@request_id}", { ticket: { status: "solved" } }, token: globex_owner, account: "globex")
+    assert_response :not_found
+    assert_equal "open", Ticket.find(@request_id).status
+  end
+
+  test "a staff reply moves the ticket to the top of the staff list" do
+    newer_id = open_request!(token: @avery_token, subject: "Newer one")
+    api_get("/tickets", token: @owner_token, account: "acme")
+    assert_equal [ newer_id, @request_id ], json["tickets"].map { |t| t["id"] }
+
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "Bumping this." } } }, token: @owner_token, account: "acme")
+
+    api_get("/tickets", token: @owner_token, account: "acme")
+    assert_equal [ @request_id, newer_id ], json["tickets"].map { |t| t["id"] }
+  end
+end
diff --git a/test/integration/support_mail_intake_test.rb b/test/integration/support_mail_intake_test.rb
new file mode 100644
index 0000000..cf26e2e
--- /dev/null
+++ b/test/integration/support_mail_intake_test.rb
@@ -0,0 +1,430 @@
+require "test_helper"
+
+# Mail sent to a business's support address becomes a request, delivered through the relay ingress.
+class SupportMailIntakeTest < ActionDispatch::IntegrationTest
+  include InboundMailHelpers
+
+  setup do
+    set_inbound_password
+    signup!
+    @staff_token = verified_sign_in!
+    @acme = Account.find_by!(subdomain: "acme")
+  end
+
+  teardown { restore_inbound_password }
+
+  # Delivers +raw+ and asserts the relay accepted it (the relay answers 204 for any authenticated, valid delivery).
+  def deliver!(raw)
+    assert_equal 204, relay_mail(raw)
+  end
+
+  # --- the relay ingress ----------------------------------------------------------------------------------
+
+  test "the relay refuses a delivery without the ingress password, and records nothing" do
+    raw = build_mail(from: "avery@example.test", to: support_address)
+
+    assert_no_difference(%w[ActionMailbox::InboundEmail.count Ticket.count]) do
+      assert_equal 401, relay_mail(raw, password: nil)
+      assert_equal 401, relay_mail(raw, password: "guessed")
+    end
+  end
+
+  test "the relay only takes a raw RFC 822 message" do
+    raw = build_mail(from: "avery@example.test", to: support_address)
+
+    assert_equal 415, relay_mail(raw, content_type: "application/json")
+    assert_equal 0, Ticket.count
+  end
+
+  test "the ingress password comes from RAILS_INBOUND_EMAIL_PASSWORD" do
+    raw = build_mail(from: "avery@example.test", to: support_address)
+
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => "rotated-secret") do
+      assert_equal 401, relay_mail(raw, password: INBOUND_PASSWORD)
+      assert_equal 204, relay_mail(raw, password: "rotated-secret")
+    end
+    assert_equal 1, Ticket.count
+  end
+
+  # Makes the mailbox's early duplicate check answer "no", for the block only.
+  def without_duplicate_check
+    Comment.define_singleton_method(:exists?) { |*| false }
+    yield
+  ensure
+    Comment.singleton_class.remove_method(:exists?)
+  end
+
+  # --- opening requests ------------------------------------------------------------------------------------
+
+  test "mail to the business address opens a request with its subject and plain-text message" do
+    raw = build_mail(from: "Avery <avery@example.test>", to: support_address,
+                     subject: "Cannot download my receipt", body: "The download button does nothing.\n\nThanks")
+
+    assert_difference(%w[Ticket.count Comment.count], 1) { deliver!(raw) }
+
+    ticket = last_ticket
+    assert_equal @acme, ticket.account
+    assert_equal "Cannot download my receipt", ticket.subject
+    assert_equal "open", ticket.status
+    assert_equal "email", ticket.origin
+    assert_equal "avery@example.test", ticket.requester.email
+
+    comment = ticket.comments.sole
+    assert_equal "The download button does nothing.\n\nThanks", comment.body
+    assert comment.public
+    assert_equal ticket.requester, comment.author
+    assert_equal message_id_of(raw), comment.inbound_message_id
+  end
+
+  test "the business is found from Cc as well as To" do
+    raw = build_mail(from: "avery@example.test", to: "someone-else@example.test", cc: support_address)
+
+    assert_difference("Ticket.count", 1) { deliver!(raw) }
+    assert_equal @acme, last_ticket.account
+  end
+
+  test "mail with several addresses for the same business opens one request" do
+    raw = build_mail(from: "avery@example.test", to: support_address, cc: support_address.upcase)
+
+    assert_difference("Ticket.count", 1) { deliver!(raw) }
+  end
+
+  test "mail addressed to two businesses is ignored, without creating anything" do
+    signup!(subdomain: "beta", name: "Beta", email: "jo@beta.test")
+    raw = build_mail(from: "avery@example.test", to: support_address("acme"), cc: support_address("beta"))
+
+    assert_no_difference(%w[Ticket.count User.count Comment.count]) { deliver!(raw) }
+    assert_equal "bounced", ActionMailbox::InboundEmail.last.status
+  end
+
+  test "mail to an unknown business, or to another domain, is ignored" do
+    assert_no_difference("Ticket.count") do
+      deliver!(build_mail(from: "avery@example.test", to: "nobody@support.example.test"))
+      deliver!(build_mail(from: "avery@example.test", to: "acme@example.test"))
+    end
+    assert_equal %w[bounced bounced], ActionMailbox::InboundEmail.order(:id).last(2).map(&:status)
+  end
+
+  test "each new message to the plain support address opens a new request" do
+    deliver!(build_mail(from: "avery@example.test", to: support_address, subject: "First"))
+    deliver!(build_mail(from: "avery@example.test", to: support_address, subject: "Second"))
+
+    assert_equal %w[First Second], Ticket.order(:id).pluck(:subject)
+    assert_equal 1, User.where(email: "avery@example.test").count
+  end
+
+  test "the support domain comes from HELPDESK_SUPPORT_DOMAIN" do
+    with_env("HELPDESK_SUPPORT_DOMAIN" => "help.example.test") do
+      deliver!(build_mail(from: "avery@example.test", to: "acme@help.example.test"))
+      assert_no_difference("Ticket.count") do
+        deliver!(build_mail(from: "avery@example.test", to: "acme@support.example.test"))
+      end
+    end
+    assert_equal 1, Ticket.count
+  end
+
+  # --- customers ------------------------------------------------------------------------------------------
+
+  test "a new sender gets an unverified customer account and a verification email" do
+    deliver!(build_mail(from: "Avery Quinn <avery@example.test>", to: support_address))
+
+    user = User.find_by!(email: "avery@example.test", account: @acme)
+    assert_equal "customer", user.role
+    assert_equal "Avery Quinn", user.name
+    assert_not user.verified?, "receiving mail must not verify the account"
+    assert_equal user, last_ticket.requester
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "avery@example.test" ], mail.to
+    assert_match %r{/verify-email\?account=acme&token=}, mail.body.decoded
+  end
+
+  test "a new sender with no display name is named after the part of the address before the @" do
+    deliver!(build_mail(from: "avery.quinn@example.test", to: support_address))
+
+    assert_equal "avery.quinn", User.find_by!(email: "avery.quinn@example.test").name
+  end
+
+  test "a new sender cannot sign in, because nobody knows their password, until they choose one through the reset flow" do
+    deliver!(build_mail(from: "avery@example.test", to: support_address))
+
+    api_post("/sessions", { session: { email: "avery@example.test", password: CUSTOMER_PASSWORD } }, account: "acme")
+    assert_response :unauthorized
+    assert_equal "invalid_credentials", json.dig("error", "code")
+
+    api_post("/password_resets", { password_reset: { email: "avery@example.test" } }, account: "acme")
+    api_post("/password_resets/confirm",
+             { password_reset: { token: reset_token("avery@example.test"), password: CUSTOMER_PASSWORD } }, account: "acme")
+    assert_response :ok
+
+    sign_in!(email: "avery@example.test", password: CUSTOMER_PASSWORD)
+  end
+
+  test "an existing customer is reused, with no new account and no verification email" do
+    customer_sign_in!(email: "avery@example.test")
+    avery = user_in("acme", "avery@example.test")
+    mails_before = ActionMailer::Base.deliveries.size
+
+    assert_no_difference("User.count") { deliver!(build_mail(from: "avery@example.test", to: support_address)) }
+
+    assert_equal avery, last_ticket.requester
+    assert_equal mails_before, ActionMailer::Base.deliveries.size, "no verification email for an existing customer"
+  end
+
+  test "receiving mail does not verify an existing unverified customer" do
+    register_customer!(email: "avery@example.test")
+    avery = user_in("acme", "avery@example.test")
+
+    deliver!(build_mail(from: "avery@example.test", to: support_address))
+
+    assert_not avery.reload.verified?
+  end
+
+  test "a staff member who writes in is the requester, because the business already has their account" do
+    invite_and_sign_in!(inviter_token: @staff_token, email: "sam@example.test", role: "agent")
+    sam = user_in("acme", "sam@example.test")
+
+    assert_no_difference("User.count") { deliver!(build_mail(from: "sam@example.test", to: support_address)) }
+    assert_equal sam, last_ticket.requester
+  end
+
+  test "a suspended person's mail is refused, and accepted once they are reinstated and it is sent again" do
+    customer_sign_in!(email: "avery@example.test")
+    avery = user_in("acme", "avery@example.test")
+    api_patch("/users/#{avery.id}", { user: { suspended: true } }, token: @staff_token, account: "acme")
+    raw = build_mail(from: "avery@example.test", to: support_address)
+
+    assert_no_difference("Ticket.count") { deliver!(raw) }
+    assert_equal "bounced", ActionMailbox::InboundEmail.last.status
+
+    api_patch("/users/#{avery.id}", { user: { suspended: false } }, token: @staff_token, account: "acme")
+    assert_difference("Ticket.count", 1) { deliver!(raw) }
+  end
+
+  test "mail sent from one of our own support addresses never opens a request" do
+    assert_no_difference("Ticket.count") do
+      deliver!(build_mail(from: "acme@support.example.test", to: support_address))
+    end
+  end
+
+  # --- duplicates and retries -----------------------------------------------------------------------------
+
+  test "a message delivered twice by its Message-ID opens one request" do
+    raw = build_mail(from: "avery@example.test", to: support_address, message_id: "same-message@example.test")
+
+    assert_difference("Ticket.count", 1) do
+      deliver!(raw)
+      deliver!(raw)
+    end
+    assert_equal 1, Comment.where(inbound_message_id: "same-message@example.test").count
+    assert_equal 1, ActionMailbox::InboundEmail.where(message_id: "same-message@example.test").count,
+                 "the repeat is dropped at the ingress, like any identical copy"
+  end
+
+  test "a copy with the same Message-ID but different bytes is still a duplicate" do
+    deliver!(build_mail(from: "avery@example.test", to: support_address, message_id: "dup@example.test",
+                        body: "first copy"))
+
+    assert_no_difference("Ticket.count") do
+      deliver!(build_mail(from: "avery@example.test", to: support_address, message_id: "dup@example.test",
+                          body: "second copy, relayed again"))
+    end
+    assert_equal "first copy", Comment.find_by!(inbound_message_id: "dup@example.test").body
+  end
+
+  test "a repeat that gets past the early duplicate check is stopped by the unique index, and leaves nothing behind" do
+    deliver!(build_mail(from: "avery@example.test", to: support_address, message_id: "race@example.test"))
+    ActionMailer::Base.deliveries.clear
+
+    # Pretend the copy arrived before the first one was committed. The database still refuses it.
+    without_duplicate_check do
+      assert_no_difference(%w[Ticket.count Comment.count User.count]) do
+        deliver!(build_mail(from: "casey@example.test", to: support_address, message_id: "race@example.test"))
+      end
+    end
+
+    assert_empty ActionMailer::Base.deliveries, "no verification email for an account that was rolled back"
+    assert_equal "delivered", ActionMailbox::InboundEmail.last.status
+  end
+
+  test "an invalid delivery does not block a later valid retry of the same message" do
+    customer_sign_in!(email: "avery@example.test")
+    avery = user_in("acme", "avery@example.test")
+    api_patch("/users/#{avery.id}", { user: { suspended: true } }, token: @staff_token, account: "acme")
+    raw = build_mail(from: "avery@example.test", to: support_address, message_id: "retry-me@example.test")
+    deliver!(raw)
+    assert_equal 0, Ticket.count
+
+    api_patch("/users/#{avery.id}", { user: { suspended: false } }, token: @staff_token, account: "acme")
+    assert_difference("Ticket.count", 1) { deliver!(raw) }
+    assert_equal "delivered", ActionMailbox::InboundEmail.last.status
+  end
+
+  test "mail that arrives before its business exists is refused, and is accepted when it is sent again afterwards" do
+    raw = build_mail(from: "avery@example.test", to: support_address("beta"), message_id: "early-bird@example.test")
+    assert_no_difference("Ticket.count") { deliver!(raw) }
+
+    signup!(subdomain: "beta", name: "Beta", email: "jo@beta.test")
+    assert_difference("Ticket.count", 1) { deliver!(raw) }
+    assert_equal Account.find_by!(subdomain: "beta"), last_ticket.account
+  end
+
+  test "a message to a cancelled business is refused, and is accepted on retry once the business is reactivated" do
+    raw = build_mail(from: "avery@example.test", to: support_address, message_id: "after-reactivation@example.test")
+    api_post("/account/cancel", token: @staff_token, account: "acme")
+
+    assert_no_difference("Ticket.count") { deliver!(raw) }
+
+    # Cancelling signs everyone out, the owner included, so they sign in again to reactivate.
+    owner_token = sign_in!(email: "jo@acme.test")
+    api_post("/account/reactivate", token: owner_token, account: "acme")
+    assert_response :ok
+    assert_difference("Ticket.count", 1) { deliver!(raw) }
+  end
+
+  test "a message with no plain-text part is refused, and does not block a later delivery of a readable copy" do
+    html_only_attachment = raw_message([
+      "From: avery@example.test", "To: acme@support.example.test", "Subject: Screenshot",
+      "Message-ID: <screenshot@example.test>", "MIME-Version: 1.0",
+      "Content-Type: image/png", "Content-Transfer-Encoding: base64", "", "iVBORw0KGgo="
+    ])
+
+    assert_no_difference("Ticket.count") { deliver!(html_only_attachment) }
+    assert_equal "bounced", ActionMailbox::InboundEmail.last.status
+  end
+
+  test "a bounce with an empty return path is ignored" do
+    bounce = raw_message([
+      "Return-Path: <>", "From: avery@example.test", "To: acme@support.example.test", "Subject: Undelivered",
+      "Message-ID: <null-sender@example.test>", "MIME-Version: 1.0", "Content-Type: text/plain; charset=UTF-8", "",
+      "Your message could not be delivered."
+    ])
+
+    assert_no_difference("Ticket.count") { deliver!(bounce) }
+    assert_equal "bounced", ActionMailbox::InboundEmail.last.status
+  end
+
+  test "a message in Latin-1 keeps its accents in the body, and a raw Windows-1252 subject is read correctly" do
+    latin1 = [
+      "From: avery@example.test", "To: acme@support.example.test", "Subject: Caf\xE9 menu",
+      "Message-ID: <latin1@example.test>", "MIME-Version: 1.0", "Content-Type: text/plain; charset=ISO-8859-1",
+      "Content-Transfer-Encoding: 8bit", "", "Caf\xE9 is broken\r\n"
+    ].join("\r\n").b
+
+    deliver!(latin1)
+    assert_equal "Café menu", last_ticket.subject
+    assert_equal "Café is broken", last_ticket.comments.sole.body
+  end
+
+  # --- automated and list mail ----------------------------------------------------------------------------
+
+  AUTOMATED_HEADERS = [
+    { "Auto-Submitted" => "auto-replied" },
+    { "Auto-Submitted" => "auto-generated" },
+    { "Precedence" => "bulk" },
+    { "Precedence" => "list" },
+    { "List-Id" => "<announcements.example.test>" },
+    { "List-Unsubscribe" => "<https://example.test/unsubscribe>" },
+    { "X-Autoreply" => "yes" }
+  ].freeze
+
+  test "automated and list mail is ignored" do
+    AUTOMATED_HEADERS.each do |headers|
+      raw = build_mail(from: "avery@example.test", to: support_address, headers: headers)
+      assert_no_difference("Ticket.count", "#{headers.keys.first} should be ignored") { deliver!(raw) }
+    end
+  end
+
+  test "mail from machines by sender name is ignored" do
+    %w[mailer-daemon@example.test postmaster@example.test no-reply@example.test].each do |sender|
+      assert_no_difference("Ticket.count") { deliver!(build_mail(from: sender, to: support_address)) }
+    end
+  end
+
+  test "a bounce report is ignored" do
+    report = raw_message([
+      "From: mailer-daemon@example.test", "To: acme@support.example.test", "Subject: Delivery failed",
+      "Message-ID: <bounce@example.test>", "MIME-Version: 1.0",
+      "Content-Type: multipart/report; report-type=delivery-status; boundary=\"b\"", "", "--b--"
+    ])
+
+    assert_no_difference("Ticket.count") { deliver!(report) }
+  end
+
+  test "Auto-Submitted: no is an ordinary message from a person" do
+    raw = build_mail(from: "avery@example.test", to: support_address, headers: { "Auto-Submitted" => "no" })
+
+    assert_difference("Ticket.count", 1) { deliver!(raw) }
+  end
+
+  # --- reading the message --------------------------------------------------------------------------------
+
+  test "a message with no subject is opened as (no subject)" do
+    raw = raw_message([
+      "From: avery@example.test", "To: acme@support.example.test", "Message-ID: <nosubject@example.test>",
+      "MIME-Version: 1.0", "Content-Type: text/plain; charset=utf-8", "", "The app crashes on start."
+    ])
+
+    deliver!(raw)
+    assert_equal "(no subject)", last_ticket.subject
+    assert_equal "The app crashes on start.", last_ticket.comments.sole.body
+  end
+
+  test "a long subject is shortened to the request limit" do
+    deliver!(build_mail(from: "avery@example.test", to: support_address, subject: "S" * 400))
+
+    assert_equal 255, last_ticket.subject.length
+  end
+
+  test "an HTML-only message becomes plain text" do
+    to = support_address
+    mail = Mail.new do
+      from "avery@example.test"
+      to to
+      subject "Html only"
+      message_id "html-only@example.test"
+      html_part do
+        content_type "text/html; charset=UTF-8"
+        body "<p>Tom &amp; Jerry can&#39;t log in.</p><p>Line&nbsp;two<br>and three</p><style>p{color:red}</style>"
+      end
+    end
+
+    deliver!(mail.to_s)
+    body = last_ticket.comments.sole.body
+    assert_includes body, "Tom & Jerry can't log in."
+    assert_includes body, "Line two\nand three"
+    assert_not_includes body, "&nbsp;"
+    assert_not_includes body, "color:red"
+  end
+
+  test "the text of a multipart message is taken from its text part, not its attachments" do
+    to = support_address
+    mail = Mail.new do
+      from "avery@example.test"
+      to to
+      subject "With attachment"
+      message_id "attached@example.test"
+      text_part { body "The export is empty." }
+      add_file filename: "notes.txt", content: "Attachment text that is not the message."
+    end
+
+    deliver!(mail.to_s)
+    assert_equal "The export is empty.", last_ticket.comments.sole.body
+  end
+
+  test "a very long message is shortened, and says so" do
+    deliver!(build_mail(from: "avery@example.test", to: support_address, body: "x" * 20_000))
+
+    body = last_ticket.comments.sole.body
+    assert body.length <= Comment::MAX_BODY_LENGTH
+    assert body.end_with?(SupportMail::TRUNCATION_NOTE.strip)
+  end
+
+  test "a utf-8 message keeps its characters" do
+    deliver!(build_mail(from: "avery@example.test", to: support_address, subject: "Café ☕ receipts",
+                        body: "Bonjour — naïve façade ✓"))
+
+    assert_equal "Café ☕ receipts", last_ticket.subject
+    assert_equal "Bonjour — naïve façade ✓", last_ticket.comments.sole.body
+  end
+end
diff --git a/test/integration/support_mail_replies_test.rb b/test/integration/support_mail_replies_test.rb
new file mode 100644
index 0000000..841c1b1
--- /dev/null
+++ b/test/integration/support_mail_replies_test.rb
@@ -0,0 +1,239 @@
+require "test_helper"
+
+# A request that came in by email, and the conversation that continues by email: staff replies go to the
+# requester, and the requester's answers come back through the request's private reply address.
+class SupportMailRepliesTest < ActionDispatch::IntegrationTest
+  include InboundMailHelpers
+
+  setup do
+    set_inbound_password
+    signup!
+    @staff_token = verified_sign_in!
+    @acme = Account.find_by!(subdomain: "acme")
+
+    @opening = build_mail(from: "Avery <avery@example.test>", to: support_address,
+                          subject: "Cannot download my receipt", body: "The download button does nothing.",
+                          message_id: "opening@example.test")
+    assert_equal 204, relay_mail(@opening)
+    @ticket = last_ticket
+    @avery = @ticket.requester
+    ActionMailer::Base.deliveries.clear
+  end
+
+  teardown { restore_inbound_password }
+
+  def staff_reply!(body, token: @staff_token, public: true)
+    api_patch("/tickets/#{@ticket.id}", { ticket: { comment: { body: body, public: public } } }, token: token, account: "acme")
+    assert_response :ok, response.body
+  end
+
+  def staff_status!(status)
+    api_patch("/tickets/#{@ticket.id}", { ticket: { status: status } }, token: @staff_token, account: "acme")
+    assert_response :ok, response.body
+  end
+
+  # The requester emails back. Replies go to the private reply address unless the test says otherwise.
+  def email_back(body: "It still fails.", from: "avery@example.test", to: @ticket.reply_address, message_id: nil)
+    raw = build_mail(from: from, to: to, subject: "Re: Cannot download my receipt", body: body,
+                     message_id: message_id || "#{SecureRandom.hex(6)}@example.test")
+    relay_mail(raw)
+  end
+
+  def last_delivery = ActionMailer::Base.deliveries.last
+
+  # --- what staff send out --------------------------------------------------------------------------------
+
+  test "a public staff reply is emailed to the requester, from the support address, with the reply address as Reply-To" do
+    staff_reply!("We have fixed it. Try again.")
+
+    mail = last_delivery
+    assert_equal [ "avery@example.test" ], mail.to
+    assert_equal [ "acme@support.example.test" ], mail.from
+    assert_equal [ "acme+#{@ticket.reply_key}@support.example.test" ], mail.reply_to
+    assert_equal "Re: Cannot download my receipt", mail.subject
+    assert_match "We have fixed it. Try again.", mail.body.decoded
+  end
+
+  test "the staff reply is threaded under the requester's message" do
+    staff_reply!("Looking into it.")
+
+    assert_includes last_delivery.header["In-Reply-To"].to_s, "<opening@example.test>"
+    assert_includes last_delivery.header["References"].to_s, "<opening@example.test>"
+  end
+
+  test "a staff reply for a request that is already Re: does not stack another Re:" do
+    @ticket.update!(subject: "Re: Cannot download my receipt")
+    staff_reply!("Looking into it.")
+
+    assert_equal "Re: Cannot download my receipt", last_delivery.subject
+  end
+
+  test "a private note is not emailed" do
+    staff_reply!("Internal: escalate to billing.", public: false)
+
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "a status change or assignment on its own is not emailed" do
+    staff_status!("pending")
+
+    assert_empty ActionMailer::Base.deliveries
+    assert_equal "pending", @ticket.reload.status
+  end
+
+  test "a staff reply does not reopen a solved request" do
+    staff_status!("solved")
+    staff_reply!("Closing this out.")
+
+    assert_equal "solved", @ticket.reload.status
+  end
+
+  test "a request that came from the portal is not emailed on a staff reply" do
+    portal_token = customer_sign_in!(email: "sam@example.test")
+    portal_id = open_request!(token: portal_token, subject: "Portal question")
+    ActionMailer::Base.deliveries.clear
+
+    api_patch("/tickets/#{portal_id}", { ticket: { comment: { body: "Answer on the portal." } } }, token: @staff_token, account: "acme")
+
+    assert_response :ok
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "a business name with punctuation still makes a valid From and Reply-To" do
+    @acme.update!(name: 'Acme, "Best" Inc.')
+    staff_reply!("Fixed.")
+
+    mail = last_delivery
+    assert_equal [ "acme@support.example.test" ], mail.from
+    assert_equal [ "acme+#{@ticket.reply_key}@support.example.test" ], mail.reply_to
+    assert_equal 'Acme, "Best" Inc. Support', mail[:from].display_names.first
+  end
+
+  test "the reply address and support address follow HELPDESK_SUPPORT_DOMAIN" do
+    with_env("HELPDESK_SUPPORT_DOMAIN" => "help.example.test") do
+      staff_reply!("Fixed on our side.")
+    end
+
+    assert_equal [ "acme@help.example.test" ], last_delivery.from
+    assert_equal [ "acme+#{@ticket.reply_key}@help.example.test" ], last_delivery.reply_to
+  end
+
+  # --- what the requester sends back ----------------------------------------------------------------------
+
+  test "the requester's email to the reply address is added to the conversation as a public comment" do
+    assert_difference("Comment.count", 1) { assert_equal 204, email_back(body: "It still fails on Safari.") }
+
+    assert_equal @ticket, last_ticket
+    comment = @ticket.comments.order(:id).last
+    assert_equal "It still fails on Safari.", comment.body
+    assert comment.public
+    assert_equal @avery, comment.author
+  end
+
+  test "the requester's email reply appears in the portal conversation" do
+    email_back(body: "Still broken after the update.")
+
+    # Avery has no password yet. Choosing one through the reset flow also verifies the account.
+    api_post("/password_resets", { password_reset: { email: "avery@example.test" } }, account: "acme")
+    api_post("/password_resets/confirm",
+             { password_reset: { token: reset_token("avery@example.test"), password: CUSTOMER_PASSWORD } }, account: "acme")
+    token = sign_in!(email: "avery@example.test", password: CUSTOMER_PASSWORD)
+
+    api_get("/requests/#{@ticket.id}/comments", token: token, account: "acme")
+    assert_response :ok
+    assert_includes json["comments"].map { |c| c["body"] }, "Still broken after the update."
+  end
+
+  test "the requester's reply reopens a solved request" do
+    staff_status!("solved")
+
+    email_back
+    assert_equal "open", @ticket.reload.status
+    assert_equal 1, Ticket.count
+  end
+
+  test "the requester's reply reopens a pending request" do
+    staff_status!("pending")
+
+    email_back
+    assert_equal "open", @ticket.reload.status
+  end
+
+  test "the requester's reply leaves an open request open" do
+    email_back
+
+    assert_equal "open", @ticket.reload.status
+  end
+
+  test "the requester's email is matched without regard to case" do
+    assert_difference("Comment.count", 1) { email_back(from: "AVERY@Example.TEST") }
+  end
+
+  test "mail to the reply address and the plain address is a reply, not a new request" do
+    assert_no_difference("Ticket.count") do
+      raw = build_mail(from: "avery@example.test", to: [ @ticket.reply_address, support_address ].join(", "),
+                       body: "Adding to the same thread.")
+      assert_equal 204, relay_mail(raw)
+    end
+    assert_equal "Adding to the same thread.", @ticket.comments.order(:id).last.body
+  end
+
+  test "a reply delivered twice is added once" do
+    raw = build_mail(from: "avery@example.test", to: @ticket.reply_address, body: "Once only.", message_id: "twice@example.test")
+
+    assert_difference("Comment.count", 1) do
+      relay_mail(raw)
+      relay_mail(raw)
+    end
+  end
+
+  test "a reply to a reply address that matches no request is refused, and opens nothing" do
+    bogus = "acme+#{'0' * 32}@support.example.test"
+
+    assert_no_difference(%w[Ticket.count Comment.count]) { email_back(to: bogus) }
+    assert_equal "bounced", ActionMailbox::InboundEmail.last.status
+  end
+
+  test "a reply address names one business, so a reply to another business's request is refused" do
+    signup!(subdomain: "beta", name: "Beta", email: "jo@beta.test")
+
+    assert_no_difference("Comment.count") { email_back(to: "beta+#{@ticket.reply_key}@support.example.test") }
+  end
+
+  test "a requester whose account was suspended cannot reply by email" do
+    api_patch("/users/#{@avery.id}", { user: { suspended: true } }, token: @staff_token, account: "acme")
+
+    assert_no_difference("Comment.count") { email_back }
+    assert_equal "bounced", ActionMailbox::InboundEmail.last.status
+  end
+
+  test "a reply to a cancelled business is refused" do
+    api_post("/account/cancel", token: @staff_token, account: "acme")
+
+    assert_no_difference("Comment.count") { email_back }
+  end
+
+  # --- only the requester may reply -------------------------------------------------------------------
+
+  test "only the requester may reply by email: another customer, a staff member and a stranger are refused" do
+    customer_sign_in!(email: "sam@example.test")
+    invite_and_sign_in!(inviter_token: @staff_token, email: "casey@example.test", role: "agent")
+    @ticket.update!(status: "solved")
+
+    [ "sam@example.test", "casey@example.test", "jo@acme.test", "stranger@example.test" ].each do |sender|
+      assert_no_difference("Comment.count", "#{sender} must not reply") do
+        email_back(from: sender, body: "Not from the requester.")
+      end
+    end
+
+    assert_equal "solved", @ticket.reload.status
+    assert_equal 4, ActionMailbox::InboundEmail.where(status: "bounced").count
+  end
+
+  test "a refused reply leaves no trace, so the requester's own reply to the same address is accepted" do
+    email_back(from: "stranger@example.test", body: "Not mine.")
+    assert_equal 0, Comment.where(body: "Not mine.").count
+
+    assert_difference("Comment.count", 1) { email_back(from: "avery@example.test", body: "Mine.") }
+  end
+end
diff --git a/test/integration/ticket_assignment_test.rb b/test/integration/ticket_assignment_test.rb
new file mode 100644
index 0000000..384bc2a
--- /dev/null
+++ b/test/integration/ticket_assignment_test.rb
@@ -0,0 +1,167 @@
+require "test_helper"
+
+class TicketAssignmentTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+    @avery = user_in("acme", "avery@example.test")
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @sam = user_in("acme", "sam@example.test")
+    @request_id = open_request!(token: @avery_token)
+  end
+
+  def assign!(value, token: @owner_token, body: { ticket: {} })
+    body[:ticket][:assignee_id] = value
+    api_patch("/tickets/#{@request_id}", body, token: token, account: "acme")
+  end
+
+  test "staff tickets carry assignee_id and the assignee's id and name" do
+    api_get("/tickets", token: @owner_token, account: "acme")
+
+    ticket = json["tickets"].find { |t| t["id"] == @request_id }
+    assert_equal %w[assignee assignee_id created_at group group_id id merged_into_id priority requester status subject updated_at], ticket.keys.sort
+    assert_nil ticket["assignee_id"]
+    assert_nil ticket["assignee"]
+  end
+
+  test "an admin assigns a ticket to an agent, and the assignee is shown" do
+    assign!(@sam.id)
+
+    assert_response :ok
+    assert_equal @sam.id, json.dig("ticket", "assignee_id")
+    assert_equal({ "id" => @sam.id, "name" => "Sam" }, json.dig("ticket", "assignee"))
+    assert_equal @sam.id, Ticket.find(@request_id).assignee_id
+
+    api_get("/tickets/#{@request_id}", token: @owner_token, account: "acme")
+    assert_equal @sam.id, json.dig("ticket", "assignee_id")
+    api_get("/tickets", token: @sam_token, account: "acme")
+    assert_equal @sam.id, json["tickets"].first.dig("assignee", "id")
+  end
+
+  test "an agent can assign a ticket too" do
+    assign!(@owner.id, token: @sam_token)
+
+    assert_response :ok
+    assert_equal @owner.id, json.dig("ticket", "assignee_id")
+  end
+
+  test "null clears the assignment" do
+    assign!(@sam.id)
+    assign!(nil)
+
+    assert_response :ok
+    assert_nil json.dig("ticket", "assignee_id")
+    assert_nil json.dig("ticket", "assignee")
+    assert_nil Ticket.find(@request_id).assignee_id
+  end
+
+  test "a blank assignee is treated as clearing it" do
+    assign!(@sam.id)
+    assign!("")
+
+    assert_response :ok
+    assert_nil Ticket.find(@request_id).assignee_id
+  end
+
+  test "assigning changes neither the status nor the order of the lists, so the customer's view is unchanged" do
+    before = customer_view
+    updated_at = Ticket.find(@request_id).updated_at
+
+    assign!(@sam.id)
+
+    assert_equal updated_at.to_i, Ticket.find(@request_id).updated_at.to_i
+    assert_equal before, customer_view
+  end
+
+  test "the customer's view of the request does not show the assignment" do
+    assign!(@sam.id)
+
+    api_get("/requests/#{@request_id}", token: @avery_token, account: "acme")
+    assert_response :ok
+    assert_equal %w[created_at id merged_into_id requester_id status subject updated_at], json["request"].keys.sort
+  end
+
+  test "a customer cannot assign a ticket, and an update that only tries to is a bad request" do
+    api_patch("/requests/#{@request_id}", { request: { assignee_id: @avery.id } }, token: @avery_token, account: "acme")
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+
+    api_patch("/requests/#{@request_id}", { request: { assignee_id: @sam.id, comment: { body: "Any news?" } } },
+              token: @avery_token, account: "acme")
+    assert_response :ok
+    assert_nil Ticket.find(@request_id).assignee_id
+  end
+
+  test "a customer or a staff member outside the business cannot be an assignee" do
+    assign!(@avery.id)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "assignee_id").present?
+
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_owner = user_in("globex", "jo@globex.test")
+    assign!(globex_owner.id)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "assignee_id").present?
+    assert_nil Ticket.find(@request_id).assignee_id
+  end
+
+  test "a suspended staff member cannot be assigned" do
+    api_patch("/users/#{@sam.id}", { user: { suspended: true } }, token: @owner_token, account: "acme")
+    assert_response :ok
+
+    assign!(@sam.id)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "assignee_id").present?
+  end
+
+  test "an unknown user, or something that is not an ID, is refused" do
+    assign!(999_999)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "assignee_id").present?
+
+    assign!("12abc")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "assignee_id").present?
+
+    assign!(true)
+    assert_response :unprocessable_entity
+
+    assign!(99_999_999_999_999_999_999_999)
+    assert_response :unprocessable_entity
+    assert_nil Ticket.find(@request_id).assignee_id
+  end
+
+  test "an assignment sent with a reply saves both, and a refused assignment saves neither" do
+    assign!(@sam.id, body: { ticket: { comment: { body: "Taking this one." }, status: "pending" } })
+    assert_response :ok
+    ticket = Ticket.find(@request_id)
+    assert_equal @sam.id, ticket.assignee_id
+    assert_equal "pending", ticket.status
+    assert_equal "Taking this one.", ticket.comments.last.body
+
+    assign!(@avery.id, body: { ticket: { comment: { body: "Should not appear" }, status: "solved" } })
+    assert_response :unprocessable_entity
+    ticket.reload
+    assert_equal @sam.id, ticket.assignee_id
+    assert_equal "pending", ticket.status
+    refute_includes ticket.comments.map(&:body), "Should not appear"
+  end
+
+  test "every staff member sees who the ticket is assigned to" do
+    assign!(@sam.id)
+
+    api_get("/tickets/#{@request_id}", token: @sam_token, account: "acme")
+    assert_equal "Sam", json.dig("ticket", "assignee", "name")
+  end
+
+  private
+
+  # What the customer sees for their request, including its timestamps.
+  def customer_view
+    api_get("/requests/#{@request_id}", token: @avery_token, account: "acme")
+    json["request"]
+  end
+end
diff --git a/test/integration/ticket_filters_test.rb b/test/integration/ticket_filters_test.rb
new file mode 100644
index 0000000..a8d4ec9
--- /dev/null
+++ b/test/integration/ticket_filters_test.rb
@@ -0,0 +1,234 @@
+require "test_helper"
+
+class TicketFiltersTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+    @avery = user_in("acme", "avery@example.test")
+    @kim_token = customer_sign_in!(email: "kim@example.test")
+    @kim = user_in("acme", "kim@example.test")
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @sam = user_in("acme", "sam@example.test")
+
+    # Nine requests with distinct subjects, built through the API.
+    @download = open_request!(token: @avery_token, subject: "Cannot download my receipt")
+    @refund = open_request!(token: @avery_token, subject: "Refund request")
+    @march = open_request!(token: @kim_token, subject: "Receipt missing for March")
+    @password = open_request!(token: @kim_token, subject: "Password reset", body: "I forgot my password.")
+    @login = open_request!(token: @avery_token, subject: "Cannot log in")
+    open_request!(token: @avery_token, subject: "100% refund")
+    open_request!(token: @avery_token, subject: "a_b test")
+    open_request!(token: @avery_token, subject: "C:\\temp folder")
+    open_request!(token: @avery_token, subject: "axb test")
+
+    staff_update!(@refund, assignee_id: @sam.id, priority: "high", status: "pending")
+    staff_update!(@march, priority: "high")
+    staff_update!(@password, status: "solved", comment: { body: "Internal: the receipt went to billing.", public: false })
+    staff_update!(@login, comment: { body: "We found a receipt problem in the logs." })
+    # Matches "receipt" in its subject and in a public comment. It must still be listed once.
+    api_patch("/requests/#{@download}", { request: { comment: { body: "Still no receipt here." } } },
+              token: @avery_token, account: "acme")
+    assert_response :ok
+  end
+
+  def staff_update!(id, comment: nil, **attributes)
+    body = comment ? attributes.merge(comment: comment) : attributes
+    api_patch("/tickets/#{id}", { ticket: body }, token: @owner_token, account: "acme")
+    assert_response :ok, response.body
+  end
+
+  # Subjects from the staff list for a query string, sorted so assertions do not depend on order.
+  def staff_subjects(query)
+    api_get("/tickets#{query}", token: @owner_token, account: "acme")
+    assert_response :ok, response.body
+    json["tickets"].map { |t| t["subject"] }.sort
+  end
+
+  # The errors hash for a query that must be refused.
+  def staff_errors(query)
+    api_get("/tickets#{query}", token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity, "#{query} was not refused: #{response.body}"
+    assert_equal "validation_failed", json.dig("error", "code")
+    json.dig("error", "errors")
+  end
+
+  def subjects(*names) = names.sort
+
+  def all_subjects
+    subjects("100% refund", "Cannot download my receipt", "Cannot log in", "C:\\temp folder", "Password reset",
+             "Receipt missing for March", "Refund request", "a_b test", "axb test")
+  end
+
+  test "with no filters, staff see every request in the business" do
+    assert_equal all_subjects, staff_subjects("")
+  end
+
+  test "each filter narrows the list on its own" do
+    assert_equal subjects("Refund request"), staff_subjects("?status=pending")
+    assert_equal subjects("Password reset"), staff_subjects("?status=solved")
+    assert_equal subjects("Refund request"), staff_subjects("?assignee_id=#{@sam.id}")
+    assert_equal subjects("Refund request", "Receipt missing for March"), staff_subjects("?priority=high")
+    assert_equal subjects("Receipt missing for March", "Password reset"), staff_subjects("?requester_id=#{@kim.id}")
+    assert_equal subjects("Cannot download my receipt", "Cannot log in", "Receipt missing for March"), staff_subjects("?q=receipt")
+  end
+
+  test "requester_id lists one customer's requests" do
+    assert_equal subjects("100% refund", "C:\\temp folder", "Cannot download my receipt", "Cannot log in",
+                          "Refund request", "a_b test", "axb test"),
+                 staff_subjects("?requester_id=#{@avery.id}")
+    assert_equal subjects("Password reset", "Receipt missing for March"), staff_subjects("?requester_id=#{@kim.id}")
+  end
+
+  test "priority narrows to high or normal" do
+    assert_equal subjects("Receipt missing for March", "Refund request"), staff_subjects("?priority=high")
+    assert_equal all_subjects - subjects("Receipt missing for March", "Refund request"),
+                 staff_subjects("?priority=normal")
+  end
+
+  test "assignee_id=unassigned lists requests that nobody is working on" do
+    assert_equal all_subjects - subjects("Refund request"), staff_subjects("?assignee_id=unassigned")
+  end
+
+  test "unassigning a request puts it back in the unassigned list" do
+    staff_update!(@refund, assignee_id: nil)
+
+    assert_equal all_subjects, staff_subjects("?assignee_id=unassigned")
+    assert_equal [], staff_subjects("?assignee_id=#{@sam.id}")
+  end
+
+  test "filters combine, so a request must match all of them" do
+    assert_equal subjects("Receipt missing for March"),
+                 staff_subjects("?status=open&assignee_id=unassigned&priority=high&q=receipt")
+    assert_equal [], staff_subjects("?status=pending&priority=normal&q=receipt")
+    assert_equal subjects("Refund request"), staff_subjects("?status=pending&assignee_id=#{@sam.id}&priority=high")
+  end
+
+  test "q matches subjects and public comments, ignoring case" do
+    expected = subjects("Cannot download my receipt", "Cannot log in", "Receipt missing for March")
+
+    assert_equal expected, staff_subjects("?q=receipt")
+    assert_equal expected, staff_subjects("?q=RECEIPT")
+    assert_equal expected, staff_subjects("?q=ReCeIpT")
+    assert_equal subjects("Cannot download my receipt"), staff_subjects("?q=still%20no")
+  end
+
+  test "q does not match private notes" do
+    assert_equal [], staff_subjects("?q=billing")
+    assert_equal [], staff_subjects("?q=Internal")
+  end
+
+  test "a request that matches in more than one place is listed once" do
+    api_get("/tickets?q=receipt", token: @owner_token, account: "acme")
+
+    ids = json["tickets"].map { |t| t["id"] }
+    assert_equal 3, ids.size
+    assert_equal ids.uniq, ids
+    assert_equal 3, json["count"]
+  end
+
+  test "q treats % and _ and backslash as ordinary characters" do
+    assert_equal subjects("100% refund"), staff_subjects("?q=%25")
+    assert_equal subjects("100% refund"), staff_subjects("?q=100%25")
+    assert_equal subjects("a_b test"), staff_subjects("?q=a_b")
+    assert_equal subjects("C:\\temp folder"), staff_subjects("?q=%5C")
+    assert_equal subjects("C:\\temp folder"), staff_subjects("?q=C%3A%5Ctemp")
+  end
+
+  test "wildcard-looking q text does not match more than it says" do
+    assert_equal [], staff_subjects("?q=a%25b")
+    assert_equal [], staff_subjects("?q=%25%25%25zzz")
+    assert_equal [], staff_subjects("?q=%27%20OR%201%3D1%20--")
+    assert_equal [], staff_subjects("?q=%28.*%29")
+  end
+
+  test "q is case-insensitive beyond ASCII" do
+    staff_update!(@login, comment: { body: "Ça marche pas, ÉCOLE" })
+
+    assert_equal subjects("Cannot log in"), staff_subjects("?q=%C3%A9cole")
+    assert_equal subjects("Cannot log in"), staff_subjects("?q=%C3%A7A%20MARCHE")
+  end
+
+  test "blank filters mean no filter" do
+    assert_equal all_subjects, staff_subjects("?status=&priority=&assignee_id=&requester_id=&q=")
+    assert_equal all_subjects, staff_subjects("?q=%20%20")
+  end
+
+  test "the count and the pages reflect the filtered list" do
+    api_get("/tickets?status=open&per_page=2", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal 7, json["count"]
+    assert_equal 2, json["tickets"].size
+    assert_equal 2, json["next_page"]
+    assert_nil json["previous_page"]
+  end
+
+  test "a filter that matches nothing is an empty list, not an error" do
+    api_get("/tickets?q=zzz-no-match", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal [], json["tickets"]
+    assert_equal 0, json["count"]
+  end
+
+  test "an unknown user ID matches nothing" do
+    assert_equal [], staff_subjects("?assignee_id=999999")
+    assert_equal [], staff_subjects("?requester_id=999999")
+  end
+
+  test "requests from another business never match" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_owner = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    globex_customer = customer_sign_in!(account: "globex")
+    globex_request = open_request!(token: globex_customer, account: "globex", subject: "Receipt in Globex")
+    globex_avery = user_in("globex", "avery@example.test")
+
+    api_get("/tickets?q=receipt", token: @owner_token, account: "acme")
+    refute_includes json["tickets"].map { |t| t["subject"] }, "Receipt in Globex"
+
+    api_get("/tickets?q=globex", token: @owner_token, account: "acme")
+    assert_equal [], json["tickets"]
+
+    api_get("/tickets?requester_id=#{globex_avery.id}", token: @owner_token, account: "acme")
+    assert_equal [], json["tickets"]
+
+    api_get("/tickets?q=receipt", token: globex_owner, account: "globex")
+    assert_equal [ globex_request ], json["tickets"].map { |t| t["id"] }
+  end
+
+  test "an invalid value is refused with 422 naming each bad parameter, and nothing is listed" do
+    api_get("/tickets?status=archived&priority=urgent&assignee_id=abc&requester_id=-1", token: @owner_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert_equal %w[assignee_id priority requester_id status], json.dig("error", "errors").keys.sort
+    assert_nil json["tickets"]
+  end
+
+  test "each kind of invalid value is refused" do
+    {
+      "?status=archived" => "status",
+      "?status=Open" => "status",
+      "?status[]=open" => "status",
+      "?priority=urgent" => "priority",
+      "?priority=HIGH" => "priority",
+      "?assignee_id=unassign" => "assignee_id",
+      "?assignee_id=1.5" => "assignee_id",
+      "?assignee_id=99999999999999999999" => "assignee_id",
+      "?assignee_id=unassigned,1" => "assignee_id",
+      "?requester_id=unassigned" => "requester_id",
+      "?requester_id=abc" => "requester_id",
+      "?q[]=receipt" => "q",
+      "?q[a]=receipt" => "q"
+    }.each do |query, param|
+      assert_includes staff_errors(query).keys, param, "#{query} should be refused"
+    end
+  end
+
+  test "SQL and regex characters in q are plain text, and change nothing" do
+    assert_equal [], staff_subjects("?q=%27%3B%20DROP%20TABLE%20tickets%3B%20--")
+    assert_equal all_subjects.size, Ticket.count
+  end
+end
