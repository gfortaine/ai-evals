+++ b/test/integration/invitation_acceptance_test.rb
@@ -0,0 +1,273 @@
+require "test_helper"
+
+class InvitationAcceptanceTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+  end
+
+  def invite!(email: "sam@example.test", role: "agent", token: @owner_token, account: "acme")
+    api_post("/invitations", { invitation: { email: email, role: role } }, token: token, account: account)
+    assert_response :created, "invite failed: #{response.body}"
+    json.dig("invitation", "id")
+  end
+
+  def preview!(token, account: nil)
+    api_post("/invitation_previews", { invitation_preview: { token: token } }, account: account)
+  end
+
+  test "the preview shows the invited email, role, business name, subdomain and expiry, without signing in" do
+    invite!(role: "admin")
+    token = invitation_token("sam@example.test")
+
+    preview!(token)
+
+    assert_response :ok
+    preview = json["invitation_preview"]
+    assert_equal %w[business_name email expires_at role subdomain], preview.keys.sort
+    assert_equal "sam@example.test", preview["email"]
+    assert_equal "admin", preview["role"]
+    assert_equal "Acme", preview["business_name"]
+    assert_equal "acme", preview["subdomain"]
+    assert_in_delta 7.days.from_now.to_f, Time.iso8601(preview["expires_at"]).to_f, 5
+  end
+
+  test "the preview refuses unknown, missing, accepted, revoked and expired invitations the same way" do
+    preview!("not-a-real-token")
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+
+    preview!("")
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+
+    invite!
+    token = invitation_token("sam@example.test")
+    travel 8.days do
+      preview!(token)
+      assert_response :unprocessable_entity
+      assert_equal "invalid_token", json.dig("error", "code")
+    end
+
+    invite!(email: "bo@acme.test")
+    revoked_token = invitation_token("bo@acme.test")
+    api_delete("/invitations/#{Invitation.find_by!(email: "bo@acme.test").id}", token: @owner_token, account: "acme")
+    preview!(revoked_token)
+    assert_response :unprocessable_entity
+
+    invite!(email: "cy@acme.test")
+    accepted_token = invitation_token("cy@acme.test")
+    accept_invitation!(accepted_token, name: "Cy")
+    preview!(accepted_token)
+    assert_response :unprocessable_entity
+  end
+
+  test "a preview with a missing envelope is a bad request" do
+    api_post("/invitation_previews", { token: "x" })
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "a preview sent with another business's header does not open the invitation" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    invite!
+    token = invitation_token("sam@example.test")
+
+    preview!(token, account: "globex")
+
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "an unknown business header is not found" do
+    preview!("whatever", account: "nowhere")
+
+    assert_response :not_found
+    assert_equal "account_not_found", json.dig("error", "code")
+  end
+
+  test "accepting creates a verified user in the business with the invited role, and returns user and account" do
+    invite!(role: "agent")
+    token = invitation_token("sam@example.test")
+    mails_before = ActionMailer::Base.deliveries.size
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "Sam", password: TEAM_PASSWORD } }, account: "acme")
+
+    assert_response :created
+    assert_equal %w[account user], json.keys.sort
+    assert_equal "sam@example.test", json.dig("user", "email")
+    assert_equal "Sam", json.dig("user", "name")
+    assert_equal "agent", json.dig("user", "role")
+    assert_equal true, json.dig("user", "verified")
+    assert_equal "acme", json.dig("account", "subdomain")
+    assert_equal mails_before, ActionMailer::Base.deliveries.size, "accepting must not send another verification email"
+    assert_equal "accepted", Invitation.last.status
+  end
+
+  test "the new person signs in straight away, without verifying anything" do
+    invite!
+    accept_invitation!(invitation_token("sam@example.test"))
+
+    api_post("/sessions", { session: { email: "sam@example.test", password: TEAM_PASSWORD } }, account: "acme")
+
+    assert_response :created
+    token = json.dig("session", "token")
+    api_get("/me", token: token, account: "acme")
+    assert_equal "agent", json.dig("user", "role")
+  end
+
+  test "an admin invitation makes an admin who can manage people" do
+    invite!(email: "ann@acme.test", role: "admin")
+    accept_invitation!(invitation_token("ann@acme.test"), name: "Ann")
+    ann_token = sign_in!(email: "ann@acme.test", password: TEAM_PASSWORD)
+
+    api_get("/users", token: ann_token, account: "acme")
+    assert_response :ok
+  end
+
+  test "an invitation can be accepted only once" do
+    invite!
+    token = invitation_token("sam@example.test")
+    accept_invitation!(token)
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "Sam again", password: TEAM_PASSWORD } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+    assert_equal 1, User.where(email: "sam@example.test").count
+  end
+
+  test "a failed acceptance keeps the invitation pending, so it can be retried" do
+    invite!
+    token = invitation_token("sam@example.test")
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "Sam", password: "short" } }, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "password").present?
+    assert_equal "pending", Invitation.last.status
+    assert_nil User.find_by(email: "sam@example.test")
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "", password: TEAM_PASSWORD } }, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "name").present?
+
+    accept_invitation!(token)
+    assert_equal "accepted", Invitation.last.status
+  end
+
+  test "a blank password is refused, not quietly dropped" do
+    invite!
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: invitation_token("sam@example.test"), name: "Sam", password: "" } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "password").present?
+  end
+
+  test "an expired invitation cannot be accepted, and resending makes it acceptable again" do
+    id = invite!
+    old_token = invitation_token("sam@example.test")
+
+    travel 8.days do
+      api_post("/invitation_acceptances", { invitation_acceptance: { token: old_token, name: "Sam", password: TEAM_PASSWORD } }, account: "acme")
+      assert_response :unprocessable_entity
+      assert_equal "invalid_token", json.dig("error", "code")
+
+      api_post("/invitations/#{id}/resend", token: @owner_token, account: "acme")
+      accept_invitation!(invitation_token("sam@example.test"))
+    end
+  end
+
+  test "a revoked invitation cannot be accepted" do
+    id = invite!
+    token = invitation_token("sam@example.test")
+    api_delete("/invitations/#{id}", token: @owner_token, account: "acme")
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "Sam", password: TEAM_PASSWORD } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "an invitation cannot be accepted once the business has been cancelled" do
+    invite!
+    token = invitation_token("sam@example.test")
+    api_post("/account/cancel", token: @owner_token, account: "acme")
+    assert_response :ok
+
+    api_post("/invitation_previews", { invitation_preview: { token: token } }, account: "acme")
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "Sam", password: TEAM_PASSWORD } }, account: "acme")
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+    assert_nil User.find_by(email: "sam@example.test")
+  end
+
+  test "if the email has become a user in the meantime, acceptance is refused and nothing is created" do
+    invite!
+    token = invitation_token("sam@example.test")
+    User.create!(account: Account.find_by!(subdomain: "acme"), name: "Sam", email: "sam@example.test",
+                 password: TEAM_PASSWORD, role: "customer", verified_at: Time.current)
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "Sam", password: TEAM_PASSWORD } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "email").present?
+    assert_equal "pending", Invitation.last.status
+  end
+
+  test "a pending invitation's email cannot be taken by customer registration" do
+    invite!
+
+    api_post("/registrations", { user: { name: "Sam", email: "sam@example.test", password: "customer-password" } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "email").present?
+    assert_nil User.find_by(email: "sam@example.test")
+    assert_equal "pending", Invitation.last.status
+  end
+
+  test "a registration reports its other problems together with the invitation clash" do
+    invite!
+
+    api_post("/registrations", { user: { name: "", email: "sam@example.test", password: "customer-password" } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "email").present?
+    assert json.dig("error", "errors", "name").present?
+  end
+
+  test "the email is matched without case, so a differently cased registration is refused too" do
+    invite!
+
+    api_post("/registrations", { user: { name: "Sam", email: "SAM@Example.test", password: "customer-password" } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "email").present?
+  end
+
+  test "customer registration still works for everyone else, and for an email whose invitation has expired" do
+    invite!
+    api_post("/registrations", { user: { name: "Avery", email: "avery@example.test", password: "customer-password" } }, account: "acme")
+    assert_response :created
+
+    travel 8.days do
+      api_post("/registrations", { user: { name: "Sam", email: "sam@example.test", password: "customer-password" } }, account: "acme")
+      assert_response :created
+    end
+  end
+
+  test "a pending invitation in another business does not block registration here" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    api_post("/invitations", { invitation: { email: "sam@example.test", role: "agent" } }, token: globex_token, account: "globex")
+    assert_response :created
+
+    api_post("/registrations", { user: { name: "Sam", email: "sam@example.test", password: "customer-password" } }, account: "acme")
+
+    assert_response :created
+  end
+end
