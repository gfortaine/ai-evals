+require "test_helper"
+
+class CorsTest < ActionDispatch::IntegrationTest
+  test "the configured frontend origin may call the API" do
+    options "/api/v1/sessions", headers: {
+      "Origin" => Helpdesk::Settings.frontend_origin,
+      "Access-Control-Request-Method" => "POST",
+      "Access-Control-Request-Headers" => "authorization,content-type,x-helpdesk-account"
+    }
+
+    assert_equal Helpdesk::Settings.frontend_origin, response.headers["access-control-allow-origin"]
+    assert_includes response.headers["access-control-allow-methods"], "PATCH"
+    assert_includes response.headers["access-control-allow-headers"], "x-helpdesk-account"
+  end
+
+  test "other origins are not allowed" do
+    options "/api/v1/sessions", headers: {
+      "Origin" => "https://evil.example",
+      "Access-Control-Request-Method" => "POST"
+    }
+
+    assert_nil response.headers["access-control-allow-origin"]
+  end
+
+  test "actual API responses carry the allow-origin header for the frontend" do
+    get "/api/v1/portal", headers: { "Origin" => Helpdesk::Settings.frontend_origin, "X-Helpdesk-Account" => "nope" }
+
+    assert_equal Helpdesk::Settings.frontend_origin, response.headers["access-control-allow-origin"]
+  end
+end
diff --git a/test/integration/cursor_pagination_test.rb b/test/integration/cursor_pagination_test.rb
new file mode 100644
index 0000000..1ae5134
--- /dev/null
+++ b/test/integration/cursor_pagination_test.rb
@@ -0,0 +1,470 @@
+require "test_helper"
+
+# Cursor pagination (page[size], page[after], page[before]) on every list. Page numbers are covered in
+# pagination_test.rb.
+class CursorPaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+  end
+
+  # Opens +count+ requests as Avery, oldest first. Returns their ids, oldest first.
+  def open_requests!(count, prefix: "Request")
+    count.times.map { |n| open_request!(token: @avery_token, subject: "#{prefix} #{n}") }
+  end
+
+  # The SQL statements (not the schema or transaction bookkeeping) that run while the block does.
+  def sql_statements
+    statements = []
+    subscriber = ->(*, payload) { statements << payload[:sql] unless payload[:name] == "SCHEMA" }
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") { yield }
+    statements
+  end
+
+  def path_of(link)
+    URI.parse(link).request_uri.delete_prefix("/api/v1")
+  end
+
+  # Follows the first page's next links to the end. Returns every page's records, in order.
+  def walk_forward(path, key:, token: @owner_token)
+    pages = []
+    api_get(path, token: token, account: "acme")
+    loop do
+      assert_response :ok, response.body
+      pages << json[key]
+      link = json.dig("links", "next")
+      break unless link
+
+      api_get(path_of(link), token: token, account: "acme")
+    end
+    pages
+  end
+
+  # The ids from walk_forward, flattened, checking that no record appears twice.
+  def ids_walked_forward(path, key:, token: @owner_token)
+    ids = walk_forward(path, key: key, token: token).flatten.map { |record| record["id"] }
+    assert_equal ids.uniq, ids, "a record was repeated while walking #{path}"
+    ids
+  end
+
+  test "an empty list gives the documented shape with null cursors" do
+    api_get("/tickets?page[size]=25&status=open", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal({
+      "tickets" => [],
+      "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+      "links" => { "next" => nil, "prev" => nil }
+    }, json)
+  end
+
+  test "the first page has records, cursors for its first and last records, and only a next link" do
+    ids = open_requests!(3)
+
+    api_get("/tickets?page[size]=2&status=open", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal ids.reverse.first(2), json["tickets"].map { |t| t["id"] }
+    assert_equal true, json.dig("meta", "has_more")
+    assert_kind_of String, json.dig("meta", "after_cursor")
+    assert_kind_of String, json.dig("meta", "before_cursor")
+    assert_kind_of String, json.dig("links", "next")
+    assert_nil json.dig("links", "prev")
+  end
+
+  test "the response has no count, so a cursor page does not scan the whole list" do
+    open_requests!(2)
+
+    api_get("/tickets?page[size]=1", token: @owner_token, account: "acme")
+
+    assert_equal %w[links meta tickets], json.keys.sort
+    assert_equal %w[after_cursor before_cursor has_more], json["meta"].keys.sort
+    assert_equal %w[next prev], json["links"].keys.sort
+  end
+
+  test "a cursor page runs no count, while a page-number page does" do
+    open_requests!(3)
+
+    counts = sql_statements { api_get("/tickets?page[size]=2", token: @owner_token, account: "acme") }
+    assert_empty counts.grep(/COUNT\(/i)
+
+    counts = sql_statements { api_get("/tickets?page=1&per_page=2", token: @owner_token, account: "acme") }
+    assert_equal 1, counts.grep(/COUNT\(/i).size
+  end
+
+  test "walking forward with next visits every record once, newest first" do
+    ids = open_requests!(7)
+
+    pages = walk_forward("/tickets?page[size]=3", key: "tickets")
+
+    assert_equal [ 3, 3, 1 ], pages.map(&:size)
+    assert_equal ids.reverse, pages.flatten.map { |t| t["id"] }
+  end
+
+  test "next is null on the last page and has_more says so" do
+    open_requests!(3)
+
+    api_get("/tickets?page[size]=2", token: @owner_token, account: "acme")
+    assert_equal true, json.dig("meta", "has_more")
+    api_get(path_of(json.dig("links", "next")), token: @owner_token, account: "acme")
+
+    assert_equal 1, json["tickets"].size
+    assert_equal false, json.dig("meta", "has_more")
+    assert_nil json.dig("links", "next")
+    assert_kind_of String, json.dig("links", "prev")
+  end
+
+  test "has_more answers for the direction being browsed" do
+    a, b, c, d, e = open_requests!(5)
+
+    api_get("/tickets?page[size]=2", token: @owner_token, account: "acme")
+    p1 = json["tickets"].map { |t| t["id"] }
+    assert_equal [ e, d ], p1
+    assert_equal true, json.dig("meta", "has_more"), "forward from the start: more after"
+
+    api_get(path_of(json.dig("links", "next")), token: @owner_token, account: "acme")
+    p2 = json["tickets"].map { |t| t["id"] }
+    assert_equal [ c, b ], p2
+    assert_equal true, json.dig("meta", "has_more")
+    assert json.dig("links", "prev"), "there is a page before this one"
+
+    api_get(path_of(json.dig("links", "next")), token: @owner_token, account: "acme")
+    assert_equal [ a ], json["tickets"].map { |t| t["id"] }
+    assert_equal false, json.dig("meta", "has_more")
+    assert_nil json.dig("links", "next")
+  end
+
+  test "browsing backwards with prev returns the earlier pages and says when they run out" do
+    a, b, c, d, e = open_requests!(5)
+    api_get("/tickets?page[size]=2", token: @owner_token, account: "acme")
+    api_get(path_of(json.dig("links", "next")), token: @owner_token, account: "acme")
+    api_get(path_of(json.dig("links", "next")), token: @owner_token, account: "acme")
+    assert_equal [ a ], json["tickets"].map { |t| t["id"] }
+
+    api_get(path_of(json.dig("links", "prev")), token: @owner_token, account: "acme")
+    assert_equal [ c, b ], json["tickets"].map { |t| t["id"] }
+    assert_equal true, json.dig("meta", "has_more"), "backwards: d and e are still before this page"
+    assert json.dig("links", "prev")
+    assert json.dig("links", "next"), "a is after this page"
+
+    api_get(path_of(json.dig("links", "prev")), token: @owner_token, account: "acme")
+    assert_equal [ e, d ], json["tickets"].map { |t| t["id"] }
+    assert_equal false, json.dig("meta", "has_more"), "nothing is before the newest request"
+    assert_nil json.dig("links", "prev")
+    assert json.dig("links", "next")
+  end
+
+  test "page[before] with nothing before it is an empty page with null cursors" do
+    open_requests!(2)
+    api_get("/tickets?page[size]=2", token: @owner_token, account: "acme")
+    newest = json.dig("meta", "before_cursor")
+
+    api_get("/tickets?page[size]=2&page[before]=#{CGI.escape(newest)}", token: @owner_token, account: "acme")
+
+    assert_equal({
+      "tickets" => [],
+      "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+      "links" => { "next" => nil, "prev" => nil }
+    }, json)
+  end
+
+  test "the cursor for the last record gets the page after it, which is empty at the end" do
+    open_requests!(2)
+    api_get("/tickets?page[size]=2", token: @owner_token, account: "acme")
+    last = json.dig("meta", "after_cursor")
+
+    api_get("/tickets?page[size]=2&page[after]=#{CGI.escape(last)}", token: @owner_token, account: "acme")
+
+    assert_equal [], json["tickets"]
+    assert_equal false, json.dig("meta", "has_more")
+    assert_nil json.dig("meta", "after_cursor")
+  end
+
+  test "records added while browsing do not repeat or shift the pages still to come" do
+    a, b, c, d, e = open_requests!(5)
+    api_get("/tickets?page[size]=2", token: @owner_token, account: "acme")
+    next_link = json.dig("links", "next")
+
+    open_requests!(2, prefix: "New")
+
+    api_get(path_of(next_link), token: @owner_token, account: "acme")
+    assert_equal [ c, b ], json["tickets"].map { |t| t["id"] }
+    api_get(path_of(json.dig("links", "next")), token: @owner_token, account: "acme")
+    assert_equal [ a ], json["tickets"].map { |t| t["id"] }
+  end
+
+  test "a record that is edited while browsing does not come back on the next page" do
+    a, b, c, d, e = open_requests!(5)
+    api_get("/tickets?page[size]=2", token: @owner_token, account: "acme")
+    next_link = json.dig("links", "next")
+
+    # Avery replies to d, the last record on page one. It moves to the top of the list.
+    api_patch("/requests/#{d}", { request: { comment: { body: "Any news?" } } }, token: @avery_token, account: "acme")
+    assert_response :ok
+
+    api_get(path_of(next_link), token: @owner_token, account: "acme")
+    assert_equal [ c, b ], json["tickets"].map { |t| t["id"] }
+    api_get(path_of(json.dig("links", "next")), token: @owner_token, account: "acme")
+    assert_equal [ a ], json["tickets"].map { |t| t["id"] }
+
+    # A fresh walk from the top shows it where it now belongs.
+    assert_equal [ d, e, c, b, a ].first(2), ids_walked_forward("/tickets?page[size]=2", key: "tickets").first(2)
+  end
+
+  test "a cursor still works when its record has been deleted" do
+    a, b, c, d, e = open_requests!(5)
+    api_get("/tickets?page[size]=2", token: @owner_token, account: "acme")
+    next_link = json.dig("links", "next")
+
+    Ticket.where(id: d).delete_all
+
+    api_get(path_of(next_link), token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal [ c, b ], json["tickets"].map { |t| t["id"] }
+  end
+
+  test "records with the same activity time are ordered by id, so pages do not repeat or skip" do
+    ids = open_requests!(5)
+    Ticket.update_all(updated_at: Time.utc(2030, 1, 2, 3, 4, 5, 678_901))
+
+    assert_equal ids.reverse, ids_walked_forward("/tickets?page[size]=2", key: "tickets")
+    assert_equal ids.reverse, ids_walked_forward("/tickets?page[size]=1", key: "tickets")
+  end
+
+  test "filters are kept in the links and apply to every page" do
+    ids = open_requests!(4)
+    api_patch("/tickets/#{ids[1]}", { ticket: { status: "solved" } }, token: @owner_token, account: "acme")
+
+    api_get("/tickets?page[size]=1&status=open", token: @owner_token, account: "acme")
+    assert_includes json.dig("links", "next"), "status=open"
+
+    seen = ids_walked_forward("/tickets?page[size]=1&status=open", key: "tickets")
+    assert_equal ids.reverse - [ ids[1] ], seen
+  end
+
+  test "with a cursor, per_page sets the page size and the next link keeps it" do
+    open_requests!(4)
+    api_get("/tickets?page[size]=1", token: @owner_token, account: "acme")
+    cursor = json.dig("meta", "after_cursor")
+
+    api_get("/tickets?page[after]=#{CGI.escape(cursor)}&per_page=2", token: @owner_token, account: "acme")
+
+    assert_equal 2, json["tickets"].size
+    assert_equal true, json.dig("meta", "has_more")
+    assert_includes json.dig("links", "next"), "page%5Bsize%5D=2"
+  end
+
+  test "without a size, a cursor page holds 25 records" do
+    open_requests!(30)
+    api_get("/tickets?page[size]=1", token: @owner_token, account: "acme")
+    cursor = json.dig("meta", "after_cursor")
+
+    api_get("/tickets?page[after]=#{CGI.escape(cursor)}", token: @owner_token, account: "acme")
+
+    assert_equal 25, json["tickets"].size
+    assert_equal true, json.dig("meta", "has_more")
+  end
+
+  test "the page size is at most 100 and must be a whole number" do
+    [ "0", "101", "abc", "1.5", "-3" ].each do |bad|
+      api_get("/tickets?page[size]=#{bad}", token: @owner_token, account: "acme")
+      assert_response :unprocessable_entity, "expected page[size]=#{bad} to be refused"
+      assert json.dig("error", "errors", "page.size").present?
+    end
+
+    api_get("/tickets?page[size]=100", token: @owner_token, account: "acme")
+    assert_response :ok
+  end
+
+  test "page[size] and per_page must agree when both are sent" do
+    api_get("/tickets?page[size]=2&per_page=3", token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "page.size").present?
+
+    api_get("/tickets?page[size]=2&per_page=2", token: @owner_token, account: "acme")
+    assert_response :ok
+  end
+
+  test "a blank cursor is the same as no cursor" do
+    ids = open_requests!(3)
+
+    api_get("/tickets?page[size]=2&page[after]=&page[before]=", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal ids.reverse.first(2), json["tickets"].map { |t| t["id"] }
+  end
+
+  test "page[after] and page[before] together are refused" do
+    open_requests!(2)
+    api_get("/tickets?page[size]=1", token: @owner_token, account: "acme")
+    cursor = json.dig("meta", "after_cursor")
+
+    api_get("/tickets?page[after]=#{CGI.escape(cursor)}&page[before]=#{CGI.escape(cursor)}", token: @owner_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "page").present?
+  end
+
+  test "keys other than size, after and before are refused" do
+    api_get("/tickets?page[size]=2&page[sort]=asc", token: @owner_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_match(/sort/, json.dig("error", "errors", "page").first)
+  end
+
+  test "a nested value inside page is refused" do
+    api_get("/tickets?page[size][x]=2", token: @owner_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "page.size").present?
+  end
+
+  test "page numbers and cursors cannot be mixed" do
+    open_requests!(2)
+
+    api_get("/tickets?page=2&page[size]=1", token: @owner_token, account: "acme")
+
+    assert_response :bad_request
+  end
+
+  test "a garbage cursor is refused" do
+    [ "abc", "%%%", "eyJub3QiOiJhIGN1cnNvciJ9", "x" * 600 ].each do |bad|
+      api_get("/tickets?page[after]=#{CGI.escape(bad)}", token: @owner_token, account: "acme")
+      assert_response :unprocessable_entity, "expected #{bad.first(12)} to be refused"
+      assert json.dig("error", "errors", "page.after").present?
+    end
+  end
+
+  test "a cursor from another list is refused" do
+    open_requests!(2)
+    api_get("/tickets?page[size]=1", token: @owner_token, account: "acme")
+    ticket_cursor = json.dig("meta", "after_cursor")
+
+    api_get("/requests?page[after]=#{CGI.escape(ticket_cursor)}", token: @avery_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "page.after").present?
+  end
+
+  test "a cursor whose contents were changed is refused" do
+    open_requests!(2)
+    api_get("/tickets?page[size]=1", token: @owner_token, account: "acme")
+    payload = JSON.parse(Base64.urlsafe_decode64(json.dig("meta", "after_cursor")))
+
+    forged = Base64.urlsafe_encode64(JSON.generate(payload.merge("list" => "requests")), padding: false)
+    api_get("/tickets?page[after]=#{forged}", token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+
+    wrong_type = Base64.urlsafe_encode64(JSON.generate("list" => "tickets", "position" => [ "not a time", 1 ]), padding: false)
+    api_get("/tickets?page[after]=#{wrong_type}", token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+  end
+
+  test "a comment cursor is bound to its request" do
+    first = open_request!(token: @avery_token, body: "First")
+    api_patch("/requests/#{first}", { request: { comment: { body: "Second" } } }, token: @avery_token, account: "acme")
+    second = open_request!(token: @avery_token, body: "Other request")
+
+    api_get("/requests/#{first}/comments?page[size]=1", token: @avery_token, account: "acme")
+    cursor = json.dig("meta", "after_cursor")
+
+    api_get("/requests/#{second}/comments?page[after]=#{CGI.escape(cursor)}", token: @avery_token, account: "acme")
+    assert_response :unprocessable_entity
+  end
+
+  # --- every list ---
+
+  test "requests walk forward, most recently active first" do
+    ids = open_requests!(3)
+
+    assert_equal ids.reverse, ids_walked_forward("/requests?page[size]=2", key: "requests", token: @avery_token)
+  end
+
+  test "a customer's request comments walk forward, oldest first" do
+    id = open_request!(token: @avery_token, body: "One")
+    %w[Two Three Four].each do |body|
+      api_patch("/requests/#{id}", { request: { comment: { body: body } } }, token: @avery_token, account: "acme")
+    end
+
+    seen = walk_forward("/requests/#{id}/comments?page[size]=3", key: "comments", token: @avery_token).flatten
+    assert_equal %w[One Two Three Four], seen.map { |c| c["body"] }
+  end
+
+  test "staff see every comment on a request, including private notes, and walk both ways" do
+    id = open_request!(token: @avery_token, body: "One")
+    api_patch("/tickets/#{id}", { ticket: { comment: { body: "Staff note", public: false } } }, token: @owner_token, account: "acme")
+    api_patch("/requests/#{id}", { request: { comment: { body: "Two" } } }, token: @avery_token, account: "acme")
+
+    assert_equal [ "One", "Staff note", "Two" ],
+                 walk_forward("/tickets/#{id}/comments?page[size]=1", key: "comments").flatten.map { |c| c["body"] }
+
+    api_get("/tickets/#{id}/comments?page[size]=2", token: @owner_token, account: "acme")
+    assert_equal [ "One", "Staff note" ], json["comments"].map { |c| c["body"] }
+    api_get(path_of(json.dig("links", "next")), token: @owner_token, account: "acme")
+    assert_equal [ "Two" ], json["comments"].map { |c| c["body"] }
+    assert_equal false, json.dig("meta", "has_more")
+
+    api_get(path_of(json.dig("links", "prev")), token: @owner_token, account: "acme")
+    assert_equal [ "One", "Staff note" ], json["comments"].map { |c| c["body"] }
+    assert_equal false, json.dig("meta", "has_more"), "nothing is before the first comment"
+    assert_nil json.dig("links", "prev")
+  end
+
+  test "users walk forward by id" do
+    register_customer!(email: "kim@example.test", name: "Kim")
+    register_customer!(email: "lee@example.test", name: "Lee")
+    expected = %w[jo@acme.test avery@example.test kim@example.test lee@example.test].map { |e| user_in("acme", e).id }
+
+    assert_equal expected, ids_walked_forward("/users?page[size]=3", key: "users")
+  end
+
+  test "staff lists walk forward by id" do
+    invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    invite_and_sign_in!(inviter_token: @owner_token, email: "kim@example.test", name: "Kim", role: "admin")
+    expected = %w[jo@acme.test sam@example.test kim@example.test].map { |e| user_in("acme", e).id }
+
+    assert_equal expected, ids_walked_forward("/staff?page[size]=2", key: "staff")
+  end
+
+  test "groups walk forward by id" do
+    ids = %w[Billing Sales Support].map do |name|
+      api_post("/groups", { group: { name: name } }, token: @owner_token, account: "acme")
+      json.dig("group", "id")
+    end
+
+    assert_equal ids, ids_walked_forward("/groups?page[size]=2", key: "groups")
+  end
+
+  test "group memberships walk forward by id" do
+    groups = %w[Billing Sales Support].map do |name|
+      api_post("/groups", { group: { name: name } }, token: @owner_token, account: "acme")
+      json.dig("group", "id")
+    end
+    ids = groups.map do |group|
+      api_post("/group_memberships", { group_membership: { group_id: group, user_id: @owner.id } }, token: @owner_token, account: "acme")
+      json.dig("group_membership", "id")
+    end
+
+    assert_equal ids, ids_walked_forward("/group_memberships?page[size]=2", key: "group_memberships")
+  end
+
+  test "invitations walk forward by id" do
+    ids = %w[a b c].map do |name|
+      api_post("/invitations", { invitation: { email: "#{name}@example.test", role: "agent" } }, token: @owner_token, account: "acme")
+      json.dig("invitation", "id")
+    end
+
+    assert_equal ids, ids_walked_forward("/invitations?page[size]=2", key: "invitations")
+  end
+
+  test "filters on the lists stay in force across cursor pages" do
+    register_customer!(email: "kim@example.test", name: "Kim")
+    avery = user_in("acme", "avery@example.test")
+    kim = user_in("acme", "kim@example.test")
+
+    seen = ids_walked_forward("/users?page[size]=1&role=customer", key: "users")
+    assert_equal [ avery.id, kim.id ], seen
+  end
+end
diff --git a/test/integration/customer_registration_test.rb b/test/integration/customer_registration_test.rb
new file mode 100644
index 0000000..82df209
--- /dev/null
+++ b/test/integration/customer_registration_test.rb
@@ -0,0 +1,139 @@
+require "test_helper"
+
+class CustomerRegistrationTest < ActionDispatch::IntegrationTest
+  setup { signup! }
+
+  test "registering creates an unverified customer and emails a verification link" do
+    assert_difference("User.count", 1) do
+      api_post("/registrations", { user: { name: "Avery", email: "avery@example.test", password: CUSTOMER_PASSWORD } }, account: "acme")
+    end
+
+    assert_response :created
+    assert_equal "customer", json.dig("user", "role")
+    assert_equal false, json.dig("user", "verified")
+    assert_equal "avery@example.test", json.dig("user", "email")
+    assert_not json["user"].key?("password_digest")
+
+    user = User.find_by!(email: "avery@example.test")
+    assert_equal Account.find_by!(subdomain: "acme"), user.account
+    assert_not user.verified?
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "avery@example.test" ], mail.to
+    assert_match %r{/verify-email\?account=acme&token=}, mail.body.decoded
+  end
+
+  test "a customer cannot sign in until the email is verified" do
+    register_customer!
+
+    api_post("/sessions", { session: { email: "avery@example.test", password: CUSTOMER_PASSWORD } }, account: "acme")
+
+    assert_response :forbidden
+    assert_equal "email_not_verified", json.dig("error", "code")
+  end
+
+  test "after verifying, a customer signs in and sees their profile as a customer" do
+    token = customer_sign_in!
+
+    api_get("/me", token: token, account: "acme")
+
+    assert_response :ok
+    assert_equal "customer", json.dig("user", "role")
+    assert_equal true, json.dig("user", "verified")
+  end
+
+  test "registration needs the X-Helpdesk-Account header to choose the business" do
+    api_post("/registrations", { user: { name: "Avery", email: "avery@example.test", password: CUSTOMER_PASSWORD } })
+
+    assert_response :bad_request
+    assert_equal "account_header_required", json.dig("error", "code")
+    assert_equal 0, User.where(role: "customer").count
+  end
+
+  test "an unknown business is refused" do
+    api_post("/registrations", { user: { name: "Avery", email: "avery@example.test", password: CUSTOMER_PASSWORD } }, account: "nobody")
+
+    assert_response :not_found
+    assert_equal "account_not_found", json.dig("error", "code")
+  end
+
+  test "registration ignores a requested role, so nobody can register as staff" do
+    api_post("/registrations", { user: { name: "Avery", email: "avery@example.test", password: CUSTOMER_PASSWORD, role: "admin" } }, account: "acme")
+
+    assert_response :created
+    assert_equal "customer", json.dig("user", "role")
+    assert User.find_by!(email: "avery@example.test").customer?
+  end
+
+  test "registration validates the fields" do
+    api_post("/registrations", { user: { name: "", email: "not-an-email", password: "short" } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "errors", "name").present?
+    assert json.dig("error", "errors", "email").present?
+    assert json.dig("error", "errors", "password").present?
+  end
+
+  test "a blank password is rejected, not quietly dropped" do
+    api_post("/registrations", { user: { name: "Avery", email: "avery@example.test", password: "" } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "password").present?
+    assert_equal 0, User.where(email: "avery@example.test").count
+  end
+
+  test "the same email cannot register twice in one business" do
+    register_customer!
+
+    api_post("/registrations", { user: { name: "Avery 2", email: "avery@example.test", password: CUSTOMER_PASSWORD } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "email").present?
+  end
+
+  test "the same email can register in another business" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    register_customer!
+
+    api_post("/registrations", { user: { name: "Avery", email: "avery@example.test", password: CUSTOMER_PASSWORD } }, account: "globex")
+
+    assert_response :created
+    assert_equal 2, User.where(email: "avery@example.test").count
+  end
+
+  test "a cancelled business takes no new registrations" do
+    Account.find_by!(subdomain: "acme").cancel!
+
+    assert_no_difference("User.count") do
+      api_post("/registrations", { user: { name: "Avery", email: "avery@example.test", password: CUSTOMER_PASSWORD } }, account: "acme")
+    end
+
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+  end
+
+  test "a customer recovers a forgotten password through the usual reset flow" do
+    register_customer!
+    verify_email!("avery@example.test")
+
+    api_post("/password_resets", { password_reset: { email: "avery@example.test" } }, account: "acme")
+    assert_response :accepted
+    token = reset_token("avery@example.test")
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: "a-brand-new-password" } }, account: "acme")
+    assert_response :ok
+
+    sign_in!(email: "avery@example.test", password: "a-brand-new-password", account: "acme")
+    assert_response :created
+  end
+
+  test "a customer edits their own profile but cannot change their role" do
+    token = customer_sign_in!
+
+    api_patch("/me", { user: { name: "Avery Stone", role: "admin" } }, token: token, account: "acme")
+
+    assert_response :ok
+    assert_equal "Avery Stone", json.dig("user", "name")
+    assert_equal "customer", json.dig("user", "role")
+  end
+end
diff --git a/test/integration/customer_request_filters_test.rb b/test/integration/customer_request_filters_test.rb
new file mode 100644
index 0000000..8e1d050
--- /dev/null
+++ b/test/integration/customer_request_filters_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class CustomerRequestFiltersTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @avery_token = customer_sign_in!
+    @kim_token = customer_sign_in!(email: "kim@example.test")
+
+    @open = open_request!(token: @avery_token, subject: "Still open")
+    @pending = open_request!(token: @avery_token, subject: "Waiting on us")
+    @solved = open_request!(token: @avery_token, subject: "Fixed")
+    @kims = open_request!(token: @kim_token, subject: "Kim's open request")
+    @kims_solved = open_request!(token: @kim_token, subject: "Kim's solved request")
+
+    api_patch("/tickets/#{@pending}", { ticket: { status: "pending" } }, token: @owner_token, account: "acme")
+    assert_response :ok
+    api_patch("/requests/#{@solved}", { request: { status: "solved" } }, token: @avery_token, account: "acme")
+    assert_response :ok
+    api_patch("/requests/#{@kims_solved}", { request: { status: "solved" } }, token: @kim_token, account: "acme")
+    assert_response :ok
+  end
+
+  def listed_ids(query)
+    api_get("/requests#{query}", token: @avery_token, account: "acme")
+    assert_response :ok, response.body
+    json["requests"].map { |r| r["id"] }.sort
+  end
+
+  test "a customer filters their own requests by status" do
+    assert_equal [ @open ], listed_ids("?status=open")
+    assert_equal [ @pending ], listed_ids("?status=pending")
+    assert_equal [ @solved ], listed_ids("?status=solved")
+  end
+
+  test "without a status, a customer sees all of their own requests, and nobody else's" do
+    assert_equal [ @open, @pending, @solved ].sort, listed_ids("")
+    assert_equal [ @open, @pending, @solved ].sort, listed_ids("?status=")
+  end
+
+  test "a status filter never shows someone else's requests" do
+    api_get("/requests?status=solved", token: @avery_token, account: "acme")
+
+    assert_equal [ @solved ], json["requests"].map { |r| r["id"] }
+    refute_includes json["requests"].map { |r| r["id"] }, @kims_solved
+  end
+
+  test "a customer's own reply reopens a solved request, which then matches open" do
+    api_patch("/requests/#{@solved}", { request: { comment: { body: "Not fixed after all." } } },
+              token: @avery_token, account: "acme")
+    assert_response :ok
+
+    assert_equal [ @open, @solved ].sort, listed_ids("?status=open")
+    assert_equal [], listed_ids("?status=solved")
+  end
+
+  test "the status filter combines with pagination, and the count is the filtered total" do
+    api_get("/requests?status=open&per_page=1", token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal 1, json["count"]
+    assert_equal [ @open ], json["requests"].map { |r| r["id"] }
+    assert_nil json["next_page"]
+  end
+
+  test "an unknown status is refused with 422" do
+    api_get("/requests?status=archived", token: @avery_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "errors", "status").present?
+  end
+
+  test "priority is internal, so a priority filter does not narrow a customer's list" do
+    api_get("/requests?priority=high", token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal [ @open, @pending, @solved ].sort, json["requests"].map { |r| r["id"] }.sort
+    assert_equal 3, json["count"]
+  end
+end
diff --git a/test/integration/customer_requests_test.rb b/test/integration/customer_requests_test.rb
new file mode 100644
index 0000000..cb1b6f1
--- /dev/null
+++ b/test/integration/customer_requests_test.rb
@@ -0,0 +1,264 @@
+require "test_helper"
+
+class CustomerRequestsTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @staff_token = verified_sign_in!
+    @avery_token = customer_sign_in!
+    @avery = User.find_by!(email: "avery@example.test", account: Account.find_by!(subdomain: "acme"))
+  end
+
+  test "opening a request returns it open, with the first comment, inside the request envelope" do
+    assert_difference(%w[Ticket.count Comment.count], 1) do
+      api_post("/requests", { request: { subject: "Cannot download my receipt", comment: { body: "The download button does nothing." } } },
+               token: @avery_token, account: "acme")
+    end
+
+    assert_response :created
+    request_json = json["request"]
+    assert_equal %w[created_at id merged_into_id requester_id status subject updated_at], request_json.keys.sort
+    assert request_json["id"].present?
+    assert_equal "Cannot download my receipt", request_json["subject"]
+    assert_equal "open", request_json["status"]
+    assert_equal @avery.id, request_json["requester_id"]
+    assert request_json["created_at"].present?
+    assert request_json["updated_at"].present?
+
+    comment = Comment.last
+    assert_equal "The download button does nothing.", comment.body
+    assert_equal @avery, comment.author
+    assert comment.public
+  end
+
+  test "opening a request needs a subject and a first comment, and creates nothing when either is missing" do
+    assert_no_difference(%w[Ticket.count Comment.count]) do
+      api_post("/requests", { request: { subject: "", comment: { body: "" } } }, token: @avery_token, account: "acme")
+    end
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "subject").present?
+    assert json.dig("error", "errors", "comment.body").present?
+
+    assert_no_difference("Ticket.count") do
+      api_post("/requests", { request: { subject: "No comment at all" } }, token: @avery_token, account: "acme")
+    end
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "comment.body").present?
+  end
+
+  test "a request needs the request envelope" do
+    api_post("/requests", { subject: "Bare JSON", comment: { body: "x" } }, token: @avery_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "customers list only their own requests, most recently active first" do
+    other_token = customer_sign_in!(email: "sam@example.test")
+    first = open_request!(token: @avery_token, subject: "First")
+    open_request!(token: other_token, subject: "Someone else's")
+    second = open_request!(token: @avery_token, subject: "Second")
+
+    api_get("/requests", token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal [ second, first ], json["requests"].map { |r| r["id"] }
+    assert_equal 2, json["count"]
+    assert json["requests"].all? { |r| r["requester_id"] == @avery.id }
+  end
+
+  test "a request with new activity moves to the top of the list" do
+    first = open_request!(token: @avery_token, subject: "Older")
+    second = open_request!(token: @avery_token, subject: "Newer")
+
+    api_patch("/requests/#{first}", { request: { comment: { body: "Still broken." } } }, token: @avery_token, account: "acme")
+    assert_response :ok
+
+    api_get("/requests", token: @avery_token, account: "acme")
+    assert_equal [ first, second ], json["requests"].map { |r| r["id"] }
+  end
+
+  test "a customer opens their own request and gets the request envelope" do
+    id = open_request!(token: @avery_token)
+
+    api_get("/requests/#{id}", token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal id, json.dig("request", "id")
+    assert_equal "open", json.dig("request", "status")
+  end
+
+  test "a customer cannot open another customer's request, and gets the same answer as for a missing one" do
+    other_token = customer_sign_in!(email: "sam@example.test")
+    theirs = open_request!(token: other_token)
+
+    api_get("/requests/#{theirs}", token: @avery_token, account: "acme")
+    assert_response :not_found
+    assert_equal "not_found", json.dig("error", "code")
+
+    api_get("/requests/#{theirs}/comments", token: @avery_token, account: "acme")
+    assert_response :not_found
+
+    api_patch("/requests/#{theirs}", { request: { comment: { body: "Hi" } } }, token: @avery_token, account: "acme")
+    assert_response :not_found
+    assert_equal 1, Comment.where(ticket_id: theirs).count
+  end
+
+  test "a request from another business is not found" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    avery_in_globex = customer_sign_in!(account: "globex")
+    globex_request = open_request!(token: avery_in_globex, account: "globex")
+
+    api_get("/requests/#{globex_request}", token: @avery_token, account: "acme")
+    assert_response :not_found
+  end
+
+  test "a customer reads the comments on their request, oldest first, with author and visibility" do
+    id = open_request!(token: @avery_token, body: "The download button does nothing.")
+    api_patch("/requests/#{id}", { request: { comment: { body: "I tried Safari too." } } }, token: @avery_token, account: "acme")
+    assert_response :ok
+
+    api_get("/requests/#{id}/comments", token: @avery_token, account: "acme")
+
+    assert_response :ok
+    comments = json["comments"]
+    assert_equal 2, json["count"]
+    assert_equal [ "The download button does nothing.", "I tried Safari too." ], comments.map { |c| c["body"] }
+    assert_equal %w[author body created_at id public], comments.first.keys.sort
+    assert_equal({ "id" => @avery.id, "name" => "Avery" }, comments.first["author"])
+    assert_equal true, comments.first["public"]
+    assert comments.first["created_at"].present?
+  end
+
+  test "a customer does not see non-public comments on their request" do
+    id = open_request!(token: @avery_token)
+    Comment.create!(ticket_id: id, author: User.find_by!(email: "jo@acme.test"), body: "Internal: check the billing logs", public: false)
+
+    api_get("/requests/#{id}/comments", token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal [ "The download button does nothing." ], json["comments"].map { |c| c["body"] }
+    assert_equal 1, json["count"]
+  end
+
+  test "a customer's reply reopens a pending request" do
+    id = open_request!(token: @avery_token)
+    Ticket.find(id).update!(status: "pending")
+
+    api_patch("/requests/#{id}", { request: { comment: { body: "Still broken." } } }, token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal "open", json.dig("request", "status")
+    assert_equal "open", Ticket.find(id).status
+  end
+
+  test "a customer's reply reopens a solved request" do
+    id = open_request!(token: @avery_token)
+    Ticket.find(id).update!(status: "solved")
+
+    api_patch("/requests/#{id}", { request: { comment: { body: "It came back." } } }, token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal "open", json.dig("request", "status")
+  end
+
+  test "a customer's reply marks the request solved when it says so in the same update" do
+    id = open_request!(token: @avery_token)
+    Ticket.find(id).update!(status: "pending")
+
+    api_patch("/requests/#{id}", { request: { comment: { body: "Works now, thanks." }, status: "solved" } }, token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal "solved", json.dig("request", "status")
+    assert_equal "Works now, thanks.", Ticket.find(id).comments.last.body
+  end
+
+  test "a customer can mark a request solved without a comment" do
+    id = open_request!(token: @avery_token)
+
+    api_patch("/requests/#{id}", { request: { status: "solved" } }, token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal "solved", json.dig("request", "status")
+    assert_equal 1, Comment.where(ticket_id: id).count
+  end
+
+  test "a customer's reply on an open request leaves it open" do
+    id = open_request!(token: @avery_token)
+
+    api_patch("/requests/#{id}", { request: { comment: { body: "Any update?" } } }, token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal "open", json.dig("request", "status")
+  end
+
+  test "customers can only mark a request solved, not pick other statuses" do
+    id = open_request!(token: @avery_token)
+    Ticket.find(id).update!(status: "solved")
+
+    %w[open pending bogus].each do |status|
+      api_patch("/requests/#{id}", { request: { comment: { body: "Trying #{status}" }, status: status } }, token: @avery_token, account: "acme")
+      assert_response :unprocessable_entity, "expected #{status} to be refused"
+      assert json.dig("error", "errors", "status").present?
+    end
+
+    assert_equal "solved", Ticket.find(id).status
+    assert_equal 1, Comment.where(ticket_id: id).count
+  end
+
+  test "a customer's blank reply is refused and changes nothing" do
+    id = open_request!(token: @avery_token)
+    Ticket.find(id).update!(status: "pending")
+
+    api_patch("/requests/#{id}", { request: { comment: { body: "   " } } }, token: @avery_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "comment.body").present?
+    assert_equal "pending", Ticket.find(id).status
+    assert_equal 1, Comment.where(ticket_id: id).count
+  end
+
+  test "a comment over the length limit is refused, reported against comment.body" do
+    id = open_request!(token: @avery_token)
+
+    api_patch("/requests/#{id}", { request: { comment: { body: "x" * (Comment::MAX_BODY_LENGTH + 1) } } }, token: @avery_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "comment.body").present?
+    assert_not json.dig("error", "errors").key?("comments")
+    assert_equal 1, Comment.where(ticket_id: id).count
+  end
+
+  test "a reply sends no email, because the conversation stays in the portal" do
+    id = open_request!(token: @avery_token)
+    deliveries = ActionMailer::Base.deliveries.size
+
+    api_patch("/requests/#{id}", { request: { comment: { body: "Any news?" }, status: "solved" } }, token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal deliveries, ActionMailer::Base.deliveries.size
+  end
+
+  test "a customer update that sends neither a comment nor a status is a bad request" do
+    id = open_request!(token: @avery_token)
+
+    api_patch("/requests/#{id}", { request: { subject: "Changed my mind" } }, token: @avery_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+    assert_equal "Cannot download my receipt", Ticket.find(id).subject
+  end
+
+  test "a customer's reply and status change are kept together" do
+    id = open_request!(token: @avery_token)
+    Ticket.find(id).update!(status: "pending")
+
+    # The status is invalid, so the comment must not be saved either.
+    api_patch("/requests/#{id}", { request: { comment: { body: "Partial?" }, status: "pending" } }, token: @avery_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_equal "pending", Ticket.find(id).status
+    assert_equal 1, Comment.where(ticket_id: id).count
+  end
+end
diff --git a/test/integration/group_memberships_test.rb b/test/integration/group_memberships_test.rb
new file mode 100644
index 0000000..bfb729b
--- /dev/null
+++ b/test/integration/group_memberships_test.rb
@@ -0,0 +1,387 @@
+require "test_helper"
+
+class GroupMembershipsTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+    @avery = user_in("acme", "avery@example.test")
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @sam = user_in("acme", "sam@example.test")
+    @billing = create_group!("Billing")
+    @support = create_group!("Technical Support")
+  end
+
+  def create_group!(name, token: @owner_token, account: "acme")
+    api_post("/groups", { group: { name: name } }, token: token, account: account)
+    assert_response :created, response.body
+    json.dig("group", "id")
+  end
+
+  # Adds +user+ (a User, or a user ID) to +group+. Omit +default+ to leave it out of the request.
+  def join!(group, user, default: :omit, token: @owner_token, account: "acme")
+    body = { group_id: group, user_id: user.is_a?(User) ? user.id : user }
+    body[:default] = default unless default == :omit
+    api_post("/group_memberships", { group_membership: body }, token: token, account: account)
+  end
+
+  def join_ok!(group, user, **options)
+    join!(group, user, **options)
+    assert_response :created, response.body
+    json.dig("group_membership", "id")
+  end
+
+  # Adds +user+ to +group+ in another business, as that business's admin. Returns the membership ID.
+  def join_ok_in!(subdomain, token, group, user)
+    api_post("/group_memberships", { group_membership: { group_id: group, user_id: user.id } }, token: token,
+             account: subdomain)
+    assert_response :created, response.body
+    json.dig("group_membership", "id")
+  end
+
+  # The person's memberships, by group ID, and which of them is the default.
+  def memberships_of(user)
+    GroupMembership.where(user_id: user.id).order(:id).map { |m| [ m.group_id, m.default ] }
+  end
+
+  def defaults_of(user)
+    GroupMembership.where(user_id: user.id, default: true).pluck(:group_id)
+  end
+
+  test "an admin adds a staff member to a group, and the membership names the group and the person" do
+    join!(@billing, @sam, default: true)
+
+    assert_response :created
+    assert_equal %w[created_at default group group_id id updated_at user user_id], json["group_membership"].keys.sort
+    membership = json["group_membership"]
+    assert_equal @billing, membership["group_id"]
+    assert_equal({ "id" => @billing, "name" => "Billing" }, membership["group"])
+    assert_equal @sam.id, membership["user_id"]
+    assert_equal({ "id" => @sam.id, "name" => "Sam" }, membership["user"])
+    assert_equal true, membership["default"]
+  end
+
+  test "a person's first membership is their default, even when they did not ask for it" do
+    join_ok!(@billing, @sam)
+    assert_equal [ [ @billing, true ] ], memberships_of(@sam)
+
+    join_ok!(@support, @sam, default: false)
+    assert_equal [ [ @billing, true ], [ @support, false ] ], memberships_of(@sam)
+  end
+
+  test "a person in several groups has exactly one default, which moves when another membership asks for it" do
+    billing_id = join_ok!(@billing, @sam, default: true)
+    join_ok!(@support, @sam)
+    assert_equal [ @billing ], defaults_of(@sam)
+
+    join_ok!(@support, @owner, default: true) # a different person: no effect on Sam
+    assert_equal [ @billing ], defaults_of(@sam)
+    assert_equal [ @support ], defaults_of(@owner)
+
+    support_id = GroupMembership.find_by!(user_id: @sam.id, group_id: @support).id
+    api_put("/group_memberships/#{support_id}/make_default", nil, token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal [ @support ], defaults_of(@sam)
+    assert_equal false, GroupMembership.find(billing_id).default
+  end
+
+  test "a membership that asks for the default takes it from the previous default" do
+    join_ok!(@billing, @sam)
+    join_ok!(@support, @sam, default: true)
+
+    assert_equal [ [ @billing, false ], [ @support, true ] ], memberships_of(@sam)
+  end
+
+  test "customers cannot be added to a group" do
+    join!(@billing, @avery)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "user_id").present?
+    assert_empty GroupMembership.where(user_id: @avery.id)
+  end
+
+  test "a person cannot join the same group twice" do
+    join_ok!(@billing, @sam)
+
+    join!(@billing, @sam)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "user_id").present?
+    assert_equal 1, GroupMembership.where(user_id: @sam.id).count
+  end
+
+  test "an unknown group or person, and one from another business, are refused" do
+    join!(999_999, @sam)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "group_id").present?
+
+    join!(@billing, 999_999)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "user_id").present?
+
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    globex_group = create_group!("Billing", token: globex_token, account: "globex")
+    join!(globex_group, @sam)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "group_id").present?
+
+    globex_owner = user_in("globex", "jo@globex.test")
+    join!(@billing, globex_owner)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "user_id").present?
+
+    assert_empty GroupMembership.all
+  end
+
+  test "a missing group or person is refused, and so is a default that is not true or false" do
+    api_post("/group_memberships", { group_membership: { user_id: @sam.id } }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "group_id").present?
+
+    join!(@billing, @sam, default: "maybe")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "default").present?
+
+    join!(@billing, @sam, default: nil)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "default").present?
+
+    assert_empty GroupMembership.where(user_id: @sam.id)
+  end
+
+  test "a refused membership that asked for the default leaves the person's current default alone" do
+    join_ok!(@billing, @sam, default: true)
+
+    join!(@billing, @sam, default: true) # already in Billing: refused, and must not take the default with it
+
+    assert_response :unprocessable_entity
+    assert_equal [ [ @billing, true ] ], memberships_of(@sam)
+  end
+
+  test "a membership in another business cannot be chosen as a default or removed here" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    api_post("/groups", { group: { name: "Billing" } }, token: globex_token, account: "globex")
+    globex_membership = join_ok_in!("globex", globex_token, json.dig("group", "id"), user_in("globex", "jo@globex.test"))
+
+    api_put("/group_memberships/#{globex_membership}/make_default", nil, token: @owner_token, account: "acme")
+    assert_response :not_found
+
+    api_delete("/group_memberships/#{globex_membership}", token: @owner_token, account: "acme")
+    assert_response :not_found
+    assert GroupMembership.exists?(globex_membership)
+  end
+
+  test "a membership without the envelope is a bad request" do
+    api_post("/group_memberships", { group_id: @billing, user_id: @sam.id }, token: @owner_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "a suspended staff member can still be given a membership, which is kept for their return" do
+    api_patch("/users/#{@sam.id}", { user: { suspended: true } }, token: @owner_token, account: "acme")
+    assert_response :ok
+
+    join_ok!(@billing, @sam)
+
+    assert_equal [ [ @billing, true ] ], memberships_of(@sam)
+  end
+
+  test "staff browse memberships by ID ascending, with the page metadata" do
+    first = join_ok!(@billing, @sam)
+    second = join_ok!(@support, @sam)
+    join_ok!(@billing, @owner)
+
+    api_get("/group_memberships", token: @sam_token, account: "acme")
+
+    assert_response :ok
+    assert_equal %w[count group_memberships next_page page per_page previous_page], json.keys.sort
+    assert_equal first, json["group_memberships"].first["id"]
+    assert_equal [ first, second, json["group_memberships"].last["id"] ].sort, json["group_memberships"].map { |m| m["id"] }
+    assert_equal 3, json["count"]
+  end
+
+  test "memberships can be filtered by group and by person, and the filters combine" do
+    sam_billing = join_ok!(@billing, @sam)
+    sam_support = join_ok!(@support, @sam)
+    owner_billing = join_ok!(@billing, @owner)
+
+    api_get("/group_memberships?group_id=#{@billing}", token: @sam_token, account: "acme")
+    assert_equal [ sam_billing, owner_billing ], json["group_memberships"].map { |m| m["id"] }
+
+    api_get("/group_memberships?user_id=#{@sam.id}", token: @sam_token, account: "acme")
+    assert_equal [ sam_billing, sam_support ], json["group_memberships"].map { |m| m["id"] }
+
+    api_get("/group_memberships?group_id=#{@billing}&user_id=#{@sam.id}", token: @sam_token, account: "acme")
+    assert_equal [ sam_billing ], json["group_memberships"].map { |m| m["id"] }
+
+    api_get("/group_memberships?group_id=#{@support}&user_id=#{@owner.id}", token: @sam_token, account: "acme")
+    assert_equal [], json["group_memberships"]
+
+    api_get("/group_memberships?group_id=", token: @sam_token, account: "acme")
+    assert_equal 3, json["count"]
+  end
+
+  test "a filter that is not an ID is refused" do
+    api_get("/group_memberships?group_id=billing", token: @sam_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "group_id").present?
+
+    api_get("/group_memberships?user_id=12abc", token: @sam_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "user_id").present?
+  end
+
+  test "a membership can be shown by ID, and one in another business is not found" do
+    id = join_ok!(@billing, @sam)
+
+    api_get("/group_memberships/#{id}", token: @sam_token, account: "acme")
+    assert_response :ok
+    assert_equal @sam.id, json.dig("group_membership", "user_id")
+
+    api_get("/group_memberships/999999", token: @sam_token, account: "acme")
+    assert_response :not_found
+  end
+
+  test "staff browse memberships, but only admins add, remove or choose defaults" do
+    id = join_ok!(@billing, @sam)
+
+    join!(@support, @owner, token: @sam_token)
+    assert_response :forbidden
+    assert_equal "admin_only", json.dig("error", "code")
+
+    api_delete("/group_memberships/#{id}", token: @sam_token, account: "acme")
+    assert_response :forbidden
+    assert_equal "admin_only", json.dig("error", "code")
+
+    join_ok!(@support, @sam)
+    support_id = GroupMembership.find_by!(user_id: @sam.id, group_id: @support).id
+    api_put("/group_memberships/#{support_id}/make_default", nil, token: @sam_token, account: "acme")
+    assert_response :forbidden
+    assert_equal "admin_only", json.dig("error", "code")
+    assert_equal [ @billing ], defaults_of(@sam)
+  end
+
+  test "customers cannot browse memberships" do
+    api_get("/group_memberships", token: @avery_token, account: "acme")
+
+    assert_response :forbidden
+    assert_equal "staff_only", json.dig("error", "code")
+  end
+
+  test "make_default chooses the person's default, and a second call changes nothing" do
+    billing_id = join_ok!(@billing, @sam)
+    support_id = join_ok!(@support, @sam)
+
+    api_put("/group_memberships/#{support_id}/make_default", nil, token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal true, json.dig("group_membership", "default")
+    assert_equal support_id, json.dig("group_membership", "id")
+    assert_equal [ [ @billing, false ], [ @support, true ] ], memberships_of(@sam)
+
+    api_put("/group_memberships/#{support_id}/make_default", nil, token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal [ [ @billing, false ], [ @support, true ] ], memberships_of(@sam)
+
+    api_put("/group_memberships/#{billing_id}/make_default", nil, token: @owner_token, account: "acme")
+    assert_equal [ [ @billing, true ], [ @support, false ] ], memberships_of(@sam)
+  end
+
+  test "make_default on an unknown membership is not found" do
+    api_put("/group_memberships/999999/make_default", nil, token: @owner_token, account: "acme")
+
+    assert_response :not_found
+  end
+
+  test "removing a membership that is not the default keeps the default" do
+    join_ok!(@billing, @sam)
+    support_id = join_ok!(@support, @sam)
+
+    api_delete("/group_memberships/#{support_id}", token: @owner_token, account: "acme")
+
+    assert_response :no_content
+    assert_equal [ [ @billing, true ] ], memberships_of(@sam)
+  end
+
+  test "removing the default picks another remaining membership as the default" do
+    billing_id = join_ok!(@billing, @sam)
+    join_ok!(@support, @sam)
+    third = create_group!("Sales")
+    join_ok!(third, @sam)
+    assert_equal [ @billing ], defaults_of(@sam)
+
+    api_delete("/group_memberships/#{billing_id}", token: @owner_token, account: "acme")
+
+    assert_response :no_content
+    assert_equal [ [ @support, true ], [ third, false ] ], memberships_of(@sam)
+  end
+
+  test "removing the last membership leaves the person with no default" do
+    id = join_ok!(@billing, @sam)
+
+    api_delete("/group_memberships/#{id}", token: @owner_token, account: "acme")
+
+    assert_response :no_content
+    assert_empty GroupMembership.where(user_id: @sam.id)
+  end
+
+  test "removing a membership clears the assignments it supported, but keeps the request's group" do
+    account = Account.find_by!(subdomain: "acme")
+    billing_membership = join_ok!(@billing, @sam)
+    join_ok!(@support, @sam)
+    billing_request = open_request!(token: @avery_token, subject: "Invoice question")
+    support_request = open_request!(token: @avery_token, subject: "Login broken")
+    api_patch("/tickets/#{billing_request}", { ticket: { group_id: @billing, assignee_id: @sam.id } },
+              token: @owner_token, account: "acme")
+    assert_response :ok
+    api_patch("/tickets/#{support_request}", { ticket: { group_id: @support, assignee_id: @sam.id } },
+              token: @owner_token, account: "acme")
+    assert_response :ok
+
+    api_delete("/group_memberships/#{billing_membership}", token: @owner_token, account: "acme")
+
+    assert_response :no_content
+    assert_equal @billing, Ticket.find(billing_request).group_id
+    assert_nil Ticket.find(billing_request).assignee_id
+    assert_equal @support, Ticket.find(support_request).group_id
+    assert_equal @sam.id, Ticket.find(support_request).assignee_id
+    assert_equal account.id, Ticket.find(support_request).account_id
+  end
+
+  test "suspension keeps memberships and their default, and clears only the person's assignments" do
+    join_ok!(@billing, @sam)
+    join_ok!(@support, @sam, default: true)
+    request = open_request!(token: @avery_token, subject: "Invoice question")
+    api_patch("/tickets/#{request}", { ticket: { group_id: @support, assignee_id: @sam.id } },
+              token: @owner_token, account: "acme")
+    assert_response :ok
+
+    api_patch("/users/#{@sam.id}", { user: { suspended: true } }, token: @owner_token, account: "acme")
+    assert_response :ok
+
+    assert_equal [ [ @billing, false ], [ @support, true ] ], memberships_of(@sam)
+    assert_nil Ticket.find(request).assignee_id
+    assert_equal @support, Ticket.find(request).group_id
+
+    api_patch("/users/#{@sam.id}", { user: { suspended: false } }, token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal [ [ @billing, false ], [ @support, true ] ], memberships_of(@sam)
+
+    api_get("/group_memberships?user_id=#{@sam.id}", token: @owner_token, account: "acme")
+    assert_equal 2, json["count"]
+  end
+
+  test "destroying a business removes its groups and memberships" do
+    join_ok!(@billing, @sam)
+    join_ok!(@support, @owner)
+    account = Account.find_by!(subdomain: "acme")
+
+    account.destroy!
+
+    assert_empty GroupMembership.all
+    assert_empty Group.all
+  end
+end
diff --git a/test/integration/groups_test.rb b/test/integration/groups_test.rb
