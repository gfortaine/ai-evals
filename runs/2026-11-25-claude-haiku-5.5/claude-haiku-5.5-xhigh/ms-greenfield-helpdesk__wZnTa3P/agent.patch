diff --git a/test/support/api_helpers.rb b/test/support/api_helpers.rb
new file mode 100644
index 0000000..8ce1214
--- /dev/null
+++ b/test/support/api_helpers.rb
@@ -0,0 +1,125 @@
+# Shared helpers for the JSON API integration tests.
+module ApiHelpers
+  include ActiveSupport::Testing::TimeHelpers
+
+  PASSWORD = "my-first-password".freeze
+  NEW_PASSWORD = "my-new-password".freeze
+  CUSTOMER_PASSWORD = "my-customer-password".freeze
+
+  def api(method, path, body: nil, token: nil, account: nil, headers: {})
+    request_headers = { "Accept" => "application/json" }.merge(headers)
+    request_headers["Authorization"] = "Bearer #{token}" if token
+    request_headers["X-Helpdesk-Account"] = account if account
+
+    if body.nil?
+      send(method, "/api/v1#{path}", headers: request_headers)
+    else
+      request_headers["CONTENT_TYPE"] = "application/json"
+      send(method, "/api/v1#{path}", params: body.to_json, headers: request_headers)
+    end
+  end
+
+  def api_get(path, **options) = api(:get, path, **options)
+  def api_post(path, body = nil, **options) = api(:post, path, body: body, **options)
+  def api_patch(path, body, **options) = api(:patch, path, body: body, **options)
+  def api_put(path, body, **options) = api(:put, path, body: body, **options)
+  def api_delete(path, **options) = api(:delete, path, **options)
+
+  def json
+    JSON.parse(response.body)
+  end
+
+  def signup!(subdomain: "acme", name: "Acme", email: "jo@acme.test", password: PASSWORD)
+    api_post("/account/create", {
+      account: {
+        name: name,
+        subdomain: subdomain,
+        admin: { name: "Jo", email: email, password: password }
+      }
+    })
+  end
+
+  # Token from the newest mail sent to `to` whose link is for `account` and `path`.
+  # Links carry the business, so two businesses sharing an email stay distinct.
+  def link_token(to:, path:, account:)
+    mail = ActionMailer::Base.deliveries.reverse.find do |candidate|
+      Array(candidate.to).include?(to) && candidate.body.decoded.include?("#{path}?account=#{account}&")
+    end
+    assert mail, "expected an email to #{to} linking to #{path} for #{account}"
+
+    link = mail.body.decoded[%r{http://\S+}]
+    Rack::Utils.parse_query(URI.parse(link).query).fetch("token")
+  end
+
+  def verification_token(email, account: "acme")
+    link_token(to: email, path: "/verify-email", account: account)
+  end
+
+  def reset_token(email, account: "acme")
+    link_token(to: email, path: "/reset-password", account: account)
+  end
+
+  def verify_email!(email, account: "acme")
+    api_post("/email_verifications/confirm", { email_verification: { token: verification_token(email, account: account) } }, account: account)
+  end
+
+  # Verifies the owner's email and signs them in. Returns the session token.
+  def verified_sign_in!(email: "jo@acme.test", password: PASSWORD, account: "acme")
+    verify_email!(email, account: account)
+    assert_response :ok
+    sign_in!(email: email, password: password, account: account)
+  end
+
+  def sign_in!(email:, password: PASSWORD, account: "acme")
+    api_post("/sessions", { session: { email: email, password: password } }, account: account)
+    assert_response :created, "sign-in failed: #{response.body}"
+    json.dig("session", "token")
+  end
+
+  # Registers a customer through the portal. Returns the new user's id.
+  def register_customer!(email: "avery@example.test", name: "Avery", password: CUSTOMER_PASSWORD, account: "acme")
+    api_post("/registrations", { user: { name: name, email: email, password: password } }, account: account)
+    assert_response :created, "registration failed: #{response.body}"
+    json.dig("user", "id")
+  end
+
+  # Registers a customer, verifies the email and signs in. Returns the session token.
+  def customer_sign_in!(email: "avery@example.test", password: CUSTOMER_PASSWORD, account: "acme")
+    register_customer!(email: email, password: password, account: account)
+    verify_email!(email, account: account)
+    assert_response :ok
+    sign_in!(email: email, password: password, account: account)
+  end
+
+  # Opens a request as the signed-in customer. Returns the request id.
+  def open_request!(token:, subject: "Cannot download my receipt", body: "The download button does nothing.", account: "acme")
+    api_post("/requests", { request: { subject: subject, comment: { body: body } } }, token: token, account: account)
+    assert_response :created, "could not open request: #{response.body}"
+    json.dig("request", "id")
+  end
+
+  TEAM_PASSWORD = "my-team-password".freeze
+
+  def user_in(subdomain, email)
+    User.find_by!(email: email, account: Account.find_by!(subdomain: subdomain))
+  end
+
+  # Token from the newest invitation email sent to +email+.
+  def invitation_token(email, account: "acme")
+    link_token(to: email, path: "/accept-invitation", account: account)
+  end
+
+  # Accepts an invitation with its emailed token. The new user is verified, so no verification step.
+  def accept_invitation!(token, name: "Sam", password: TEAM_PASSWORD, account: "acme")
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: name, password: password } }, account: account)
+    assert_response :created, "acceptance failed: #{response.body}"
+  end
+
+  # Invites +email+ as the signed-in admin, accepts the invitation and signs the new person in. Returns their session token.
+  def invite_and_sign_in!(inviter_token:, email: "sam@example.test", role: "agent", name: "Sam", password: TEAM_PASSWORD, account: "acme")
+    api_post("/invitations", { invitation: { email: email, role: role } }, token: inviter_token, account: account)
+    assert_response :created, "invite failed: #{response.body}"
+    accept_invitation!(invitation_token(email, account: account), name: name, password: password, account: account)
+    sign_in!(email: email, password: password, account: account)
+  end
+end
