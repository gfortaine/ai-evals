+++ b/app/models/user.rb
@@ -0,0 +1,58 @@
+# A person who signs in to one business. Email addresses are unique within an
+# account, not globally.
+class User < ApplicationRecord
+  MIN_PASSWORD_LENGTH = 8
+
+  belongs_to :account
+  has_secure_password
+
+  has_many :sessions, dependent: :delete_all
+  has_one :email_verification, dependent: :delete
+  has_one :password_reset, dependent: :delete
+
+  # The owner who signs up is an admin. Only admins can cancel or reactivate the account.
+  enum :role, { admin: "admin", agent: "agent" }, validate: true
+
+  normalizes :name, with: ->(value) { value.to_s.strip }
+  normalizes :email, with: ->(value) { value.to_s.strip.downcase }
+
+  validates :name, presence: true, length: { maximum: 120 }
+  validates :email,
+            presence: true,
+            length: { maximum: 254 },
+            format: { with: URI::MailTo::EMAIL_REGEXP },
+            uniqueness: { scope: :account_id }
+  validates :password, length: { minimum: MIN_PASSWORD_LENGTH }, allow_nil: true
+  validate :password_not_blank_when_assigned
+
+  # has_secure_password silently ignores "" on assignment. Remember blank
+  # attempts so that a blank password is rejected instead of quietly kept.
+  def password=(unencrypted)
+    @blank_password_assigned = unencrypted.to_s.empty?
+    super
+  end
+
+  def verified?
+    verified_at.present?
+  end
+
+  def as_api_json
+    {
+      id: id,
+      account_id: account_id,
+      name: name,
+      email: email,
+      role: role,
+      verified: verified?,
+      verified_at: verified_at,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  private
+
+  def password_not_blank_when_assigned
+    errors.add(:password, :blank) if @blank_password_assigned
+  end
+end
