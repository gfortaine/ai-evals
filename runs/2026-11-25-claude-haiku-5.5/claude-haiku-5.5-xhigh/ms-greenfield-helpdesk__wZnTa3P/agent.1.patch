+require "test_helper"
+
+class ProfileAndSessionsTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @token = verified_sign_in!
+  end
+
+  test "GET /me returns the signed-in user" do
+    api_get("/me", token: @token, account: "acme")
+
+    assert_response :ok
+    assert_equal "jo@acme.test", json.dig("user", "email")
+    assert_equal "admin", json.dig("user", "role")
+  end
+
+  test "PATCH /me changes the name" do
+    api_patch("/me", { user: { name: "Jo Smith" } }, token: @token, account: "acme")
+
+    assert_response :ok
+    assert_equal "Jo Smith", json.dig("user", "name")
+    assert_equal "Jo Smith", User.find_by!(email: "jo@acme.test").name
+  end
+
+  test "PATCH /me ignores fields that are not the user's to change" do
+    api_patch("/me", { user: { name: "Jo", role: "agent", verified: false, email: "evil@acme.test" } },
+              token: @token, account: "acme")
+
+    assert_response :ok
+    user = User.find_by!(email: "jo@acme.test")
+    assert user.admin?
+    assert user.verified?
+  end
+
+  test "PATCH /me rejects a blank name" do
+    api_patch("/me", { user: { name: "  " } }, token: @token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "name").present?
+  end
+
+  test "a wrong current password is rejected and changes nothing" do
+    api_put("/me/password", { password_change: { current_password: "not-the-password", password: NEW_PASSWORD } },
+            token: @token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_equal "invalid_current_password", json.dig("error", "code")
+    assert User.find_by!(email: "jo@acme.test").authenticate(PASSWORD)
+  end
+
+  test "a blank new password is rejected instead of silently ignored" do
+    api_put("/me/password", { password_change: { current_password: PASSWORD, password: "" } },
+            token: @token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "password").present?
+    assert User.find_by!(email: "jo@acme.test").authenticate(PASSWORD)
+  end
+
+  test "a short new password is rejected" do
+    api_put("/me/password", { password_change: { current_password: PASSWORD, password: "short" } },
+            token: @token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "password").present?
+  end
+
+  test "changing the password signs out every session, and the new password works" do
+    other_token = sign_in!(email: "jo@acme.test")
+
+    api_put("/me/password", { password_change: { current_password: PASSWORD, password: NEW_PASSWORD } },
+            token: @token, account: "acme")
+    assert_response :ok
+
+    api_get("/me", token: @token, account: "acme")
+    assert_response :unauthorized
+    api_get("/me", token: other_token, account: "acme")
+    assert_response :unauthorized
+
+    api_post("/sessions", { session: { email: "jo@acme.test", password: PASSWORD } }, account: "acme")
+    assert_response :unauthorized
+
+    assert sign_in!(email: "jo@acme.test", password: NEW_PASSWORD).present?
+  end
+
+  test "DELETE /session signs out only that session" do
+    other_token = sign_in!(email: "jo@acme.test")
+
+    api_delete("/session", token: @token, account: "acme")
+    assert_response :no_content
+
+    api_get("/me", token: @token, account: "acme")
+    assert_response :unauthorized
+
+    api_get("/me", token: other_token, account: "acme")
+    assert_response :ok
+  end
+
+  test "a session expires after its lifetime" do
+    travel Session::TTL + 1.minute do
+      api_get("/me", token: @token, account: "acme")
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "requests without a valid bearer token are unauthenticated" do
+    api_get("/me", account: "acme")
+    assert_response :unauthorized
+    assert_equal "unauthenticated", json.dig("error", "code")
+
+    api_get("/me", token: "not-a-real-token", account: "acme")
+    assert_response :unauthorized
+
+    api_get("/account", headers: { "Authorization" => "Basic abc" }, account: "acme")
+    assert_response :unauthorized
+  end
+
+  test "a session cannot be used with a different business header" do
+    signup!(subdomain: "globex", name: "Globex", email: "sam@globex.test")
+
+    api_get("/me", token: @token, account: "globex")
+
+    assert_response :forbidden
+    assert_equal "account_mismatch", json.dig("error", "code")
+  end
+
+  test "the account header is optional when a session is present" do
+    api_get("/me", token: @token)
+
+    assert_response :ok
+  end
+
+  test "GET /account returns the full account to a signed-in user" do
+    api_get("/account", token: @token, account: "acme")
+
+    assert_response :ok
+    assert_equal "acme", json.dig("account", "subdomain")
+    assert_equal "Acme", json.dig("account", "name")
+    assert_equal "active", json.dig("account", "status")
+    assert json.dig("account", "created_at").present?
+  end
+
+  test "GET /account requires a session" do
+    api_get("/account", account: "acme")
+
+    assert_response :unauthorized
+  end
+
+  test "the business owner who signs up is an admin" do
+    assert_equal "admin", User.find_by!(email: "jo@acme.test").role
+  end
+end
diff --git a/test/integration/signup_test.rb b/test/integration/signup_test.rb
new file mode 100644
index 0000000..584cf25
--- /dev/null
+++ b/test/integration/signup_test.rb
@@ -0,0 +1,183 @@
+require "test_helper"
+
+class SignupTest < ActionDispatch::IntegrationTest
+  test "signup creates the business and an unverified admin, and emails a verification link" do
+    assert_difference(%w[Account.count User.count], 1) do
+      signup!
+    end
+
+    assert_response :created
+    assert json.dig("account", "id").present?
+    assert json.dig("account", "created_at").present?
+    assert_equal "acme", json.dig("account", "subdomain")
+    assert_equal "active", json.dig("account", "status")
+
+    assert json.dig("user", "id").present?
+    assert json.dig("user", "created_at").present?
+    assert_equal json.dig("account", "id"), json.dig("user", "account_id")
+    assert_equal "admin", json.dig("user", "role")
+    assert_equal false, json.dig("user", "verified")
+    assert_not json["user"].key?("password_digest")
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ Helpdesk::Settings.mail_from ], mail.from
+    assert_match %r{\A#{Regexp.escape(Helpdesk::Settings.frontend_url)}/verify-email\?account=acme&token=[\w-]+\z},
+                 mail.body.decoded[%r{http://\S+}]
+  end
+
+  test "an admin cannot sign in until the email is verified" do
+    signup!
+    api_post("/sessions", { session: { email: "jo@acme.test", password: PASSWORD } }, account: "acme")
+
+    assert_response :forbidden
+    assert_equal "email_not_verified", json.dig("error", "code")
+  end
+
+  test "verifying the email allows sign in, which returns a session token, the user and the account" do
+    signup!
+    verify_email!("jo@acme.test")
+    assert_response :ok
+    assert_equal true, json.dig("user", "verified")
+
+    api_post("/sessions", { session: { email: "jo@acme.test", password: PASSWORD } }, account: "acme")
+
+    assert_response :created
+    assert json.dig("session", "token").present?
+    assert json.dig("session", "expires_at").present?
+    assert_equal "jo@acme.test", json.dig("user", "email")
+    assert_equal "acme", json.dig("account", "subdomain")
+  end
+
+  test "a verification link works only once" do
+    signup!
+    token = verification_token("jo@acme.test")
+
+    api_post("/email_verifications/confirm", { email_verification: { token: token } })
+    assert_response :ok
+
+    api_post("/email_verifications/confirm", { email_verification: { token: token } })
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "requesting another verification link replaces the earlier one" do
+    signup!
+    old_token = verification_token("jo@acme.test")
+
+    api_post("/email_verifications", { email_verification: { email: "jo@acme.test" } }, account: "acme")
+    assert_response :accepted
+    new_token = verification_token("jo@acme.test")
+    assert_not_equal old_token, new_token
+
+    api_post("/email_verifications/confirm", { email_verification: { token: old_token } })
+    assert_response :unprocessable_entity
+
+    api_post("/email_verifications/confirm", { email_verification: { token: new_token } })
+    assert_response :ok
+  end
+
+  test "resending a verification link for an unknown email says nothing and sends nothing" do
+    signup!
+    deliveries = ActionMailer::Base.deliveries.size
+
+    api_post("/email_verifications", { email_verification: { email: "nobody@acme.test" } }, account: "acme")
+
+    assert_response :accepted
+    assert_equal deliveries, ActionMailer::Base.deliveries.size
+  end
+
+  test "the same email can sign up to a different business and sign in separately" do
+    signup!(subdomain: "acme", email: "jo@acme.test", password: "password-one")
+    signup!(subdomain: "globex", name: "Globex", email: "jo@acme.test", password: "password-two")
+    assert_response :created
+    assert_equal "jo@acme.test", json.dig("user", "email")
+
+    verified_sign_in!(account: "acme", password: "password-one")
+    verify_email!("jo@acme.test", account: "globex")
+
+    assert sign_in!(email: "jo@acme.test", password: "password-one", account: "acme").present?
+    assert sign_in!(email: "jo@acme.test", password: "password-two", account: "globex").present?
+
+    api_post("/sessions", { session: { email: "jo@acme.test", password: "password-two" } }, account: "acme")
+    assert_response :unauthorized
+  end
+
+  test "signing in without the header works when the email belongs to only one business" do
+    signup!
+    verified_sign_in!
+
+    api_post("/sessions", { session: { email: "jo@acme.test", password: PASSWORD } })
+
+    assert_response :created
+    assert_equal "acme", json.dig("account", "subdomain")
+  end
+
+  test "signing in without the header is refused when the email belongs to several businesses" do
+    signup!(subdomain: "acme", email: "jo@acme.test", password: "same-password-1")
+    signup!(subdomain: "globex", name: "Globex", email: "jo@acme.test", password: "same-password-1")
+    verify_email!("jo@acme.test", account: "acme")
+    verify_email!("jo@acme.test", account: "globex")
+
+    api_post("/sessions", { session: { email: "jo@acme.test", password: "same-password-1" } })
+
+    assert_response :unprocessable_entity
+    assert_equal "account_required", json.dig("error", "code")
+  end
+
+  test "signup validation reports every problem with the account and admin fields" do
+    assert_no_difference(%w[Account.count User.count]) do
+      api_post("/account/create", {
+        account: { name: "", subdomain: "Not Valid!", admin: { name: "", email: "nope", password: "short" } }
+      })
+    end
+
+    assert_response :unprocessable_entity
+    errors = json.dig("error", "errors")
+    assert errors.key?("account.name")
+    assert errors.key?("account.subdomain")
+    assert errors.key?("admin.name")
+    assert errors.key?("admin.email")
+    assert errors.key?("admin.password")
+  end
+
+  test "subdomains must be unique and cannot be reserved" do
+    signup!
+    assert_response :created
+
+    signup!
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "account.subdomain").present?
+
+    signup!(subdomain: "www")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "account.subdomain").present?
+  end
+
+  test "subdomain is case-insensitive and stored in lowercase" do
+    signup!(subdomain: "  ACME ")
+
+    assert_response :created
+    assert_equal "acme", json.dig("account", "subdomain")
+  end
+
+  test "a missing admin block is a bad request" do
+    api_post("/account/create", { account: { name: "Acme", subdomain: "acme" } })
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "admin.email").present?
+  end
+
+  test "an envelope that is not an object is a bad request, not a server error" do
+    api_post("/account/create", { account: "Acme" })
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "a request without the account envelope is a bad request" do
+    api_post("/account/create", { name: "Acme" })
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+end
