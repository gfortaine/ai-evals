diff --git a/.gitignore b/.gitignore
index f305d48..22945c7 100644
--- a/.gitignore
+++ b/.gitignore
@@ -1,2 +1,15 @@
 /.bundle/
 /vendor/bundle/
+
+# Ignore key files for decrypting credentials and more.
+/config/*.key
+
