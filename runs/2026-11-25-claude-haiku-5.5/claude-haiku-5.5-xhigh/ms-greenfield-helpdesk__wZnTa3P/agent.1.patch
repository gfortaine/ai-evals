--- /dev/null
+++ b/test/integration/cors_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class CorsTest < ActionDispatch::IntegrationTest
+  test "the configured frontend origin may call the API" do
+    options "/api/v1/sessions", headers: {
+      "Origin" => Helpdesk::Settings.frontend_origin,
+      "Access-Control-Request-Method" => "POST",
+      "Access-Control-Request-Headers" => "authorization,content-type,x-helpdesk-account"
+    }
+
+    assert_equal Helpdesk::Settings.frontend_origin, response.headers["access-control-allow-origin"]
+    assert_includes response.headers["access-control-allow-methods"], "PATCH"
+    assert_includes response.headers["access-control-allow-headers"], "x-helpdesk-account"
+  end
+
+  test "other origins are not allowed" do
+    options "/api/v1/sessions", headers: {
+      "Origin" => "https://evil.example",
+      "Access-Control-Request-Method" => "POST"
+    }
+
+    assert_nil response.headers["access-control-allow-origin"]
+  end
+
+  test "actual API responses carry the allow-origin header for the frontend" do
+    get "/api/v1/portal", headers: { "Origin" => Helpdesk::Settings.frontend_origin, "X-Helpdesk-Account" => "nope" }
+
+    assert_equal Helpdesk::Settings.frontend_origin, response.headers["access-control-allow-origin"]
+  end
+end
diff --git a/test/integration/password_reset_test.rb b/test/integration/password_reset_test.rb
new file mode 100644
index 0000000..f0a53f2
--- /dev/null
+++ b/test/integration/password_reset_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class PasswordResetTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    verify_email!("jo@acme.test")
+  end
+
+  test "requesting a reset emails a link to the frontend with account and token" do
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "acme")
+
+    assert_response :accepted
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "jo@acme.test" ], mail.to
+    assert_equal [ Helpdesk::Settings.mail_from ], mail.from
+    assert_match %r{\A#{Regexp.escape(Helpdesk::Settings.frontend_url)}/reset-password\?account=acme&token=[\w-]+\z},
+                 mail.body.decoded[%r{http://\S+}]
+  end
+
+  test "an unknown email gets the same answer but no mail" do
+    deliveries = ActionMailer::Base.deliveries.size
+    api_post("/password_resets", { password_reset: { email: "nobody@acme.test" } }, account: "acme")
+
+    assert_response :accepted
+    assert_equal deliveries, ActionMailer::Base.deliveries.size
+    assert json["message"].present?
+  end
+
+  test "a reset link sets the new password, signs out sessions and works only once" do
+    old_session = sign_in!(email: "jo@acme.test")
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "acme")
+    token = reset_token("jo@acme.test")
+
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: NEW_PASSWORD } }, account: "acme")
+    assert_response :ok
+
+    api_get("/me", token: old_session, account: "acme")
+    assert_response :unauthorized
+    assert sign_in!(email: "jo@acme.test", password: NEW_PASSWORD).present?
+    api_post("/sessions", { session: { email: "jo@acme.test", password: PASSWORD } }, account: "acme")
+    assert_response :unauthorized
+
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: "another-password" } }, account: "acme")
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "requesting another reset replaces the earlier link" do
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "acme")
+    old_token = reset_token("jo@acme.test")
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "acme")
+    new_token = reset_token("jo@acme.test")
+    assert_not_equal old_token, new_token
+
+    api_post("/password_resets/confirm", { password_reset: { token: old_token, password: NEW_PASSWORD } }, account: "acme")
+    assert_response :unprocessable_entity
+
+    api_post("/password_resets/confirm", { password_reset: { token: new_token, password: NEW_PASSWORD } }, account: "acme")
+    assert_response :ok
+  end
+
+  test "a rejected password keeps the link usable" do
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "acme")
+    token = reset_token("jo@acme.test")
+
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: "short" } }, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "password").present?
+
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: "" } }, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "password").present?
+    assert User.find_by!(email: "jo@acme.test").authenticate(PASSWORD)
+
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: NEW_PASSWORD } }, account: "acme")
+    assert_response :ok
+  end
+
+  test "a reset link expires after its lifetime" do
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "acme")
+    token = reset_token("jo@acme.test")
+
+    travel PasswordReset::TTL + 1.minute do
+      api_post("/password_resets/confirm", { password_reset: { token: token, password: NEW_PASSWORD } }, account: "acme")
+    end
+
+    assert_response :unprocessable_entity
+    assert User.find_by!(email: "jo@acme.test").authenticate(PASSWORD)
+  end
+
+  test "a reset link from one business cannot be redeemed through another" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@acme.test", password: "globex-password")
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "globex")
+    globex_token = reset_token("jo@acme.test", account: "globex")
+
+    api_post("/password_resets/confirm", { password_reset: { token: globex_token, password: NEW_PASSWORD } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert User.find_by!(email: "jo@acme.test", account: Account.find_by!(subdomain: "acme")).authenticate(PASSWORD)
+  end
+
+  test "a reset also verifies an unverified owner, because the link proves the mailbox" do
+    signup!(subdomain: "globex", name: "Globex", email: "sam@globex.test")
+    api_post("/password_resets", { password_reset: { email: "sam@globex.test" } }, account: "globex")
+    token = reset_token("sam@globex.test", account: "globex")
+
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: NEW_PASSWORD } }, account: "globex")
+
+    assert_response :ok
+    assert_equal true, json.dig("user", "verified")
+  end
+
+  test "a reset for one business does not touch the same email in another" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@acme.test", password: "globex-password")
+    verify_email!("jo@acme.test", account: "globex")
+
+    api_post("/password_resets", { password_reset: { email: "jo@acme.test" } }, account: "globex")
+    token = reset_token("jo@acme.test", account: "globex")
+    api_post("/password_resets/confirm", { password_reset: { token: token, password: NEW_PASSWORD } }, account: "globex")
+    assert_response :ok
+
+    assert User.find_by!(email: "jo@acme.test", account: Account.find_by!(subdomain: "acme")).authenticate(PASSWORD)
+  end
+end
