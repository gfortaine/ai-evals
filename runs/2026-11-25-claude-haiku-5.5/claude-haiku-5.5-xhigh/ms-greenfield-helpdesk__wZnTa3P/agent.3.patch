@@ -0,0 +1,20 @@
+module Api
+  module V1
+    # Accepting an invitation creates a verified user, so they can sign in straight away. The emailed link
+    # already proved they control the address.
+    class InvitationAcceptancesController < ApplicationController
+      def create
+        account = optional_account_from_header
+        return if performed?
+
+        input = require_params(:invitation_acceptance).permit(:token, :name, :password)
+        invitation = Invitation.find_pending_by_token!(input[:token], account: account)
+        business = invitation.account
+        return render_error(:forbidden, "account_cancelled", "This business has been cancelled.") if business.cancelled?
+
+        user = invitation.accept!(name: input[:name], password: input[:password])
+        render json: { user: user.as_api_json, account: business.as_api_json }, status: :created
+      end
+    end
+  end
+end
