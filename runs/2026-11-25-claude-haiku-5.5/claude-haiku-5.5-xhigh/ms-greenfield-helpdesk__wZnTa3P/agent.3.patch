diff --git a/test/integration/internal_notes_test.rb b/test/integration/internal_notes_test.rb
new file mode 100644
index 0000000..49bafca
--- /dev/null
+++ b/test/integration/internal_notes_test.rb
@@ -0,0 +1,186 @@
+require "test_helper"
+
+class InternalNotesTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @request_id = open_request!(token: @avery_token)
+  end
+
+  # A private note. +extra+ holds ticket-level keys, such as a status, sent alongside it.
+  def staff_note!(body:, token: @owner_token, extra: {})
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: body, public: false } }.merge(extra) }, token: token, account: "acme")
+  end
+
+  def customer_view
+    api_get("/requests/#{@request_id}", token: @avery_token, account: "acme")
+    json["request"]
+  end
+
+  def customer_comment_bodies
+    api_get("/requests/#{@request_id}/comments", token: @avery_token, account: "acme")
+    json["comments"].map { |c| c["body"] }
+  end
+
+  test "a private note is saved as internal, under the staff author, and the staff can read it" do
+    staff_note!(body: "Checking this with billing.")
+
+    assert_response :ok
+    assert_equal false, Comment.find_by!(body: "Checking this with billing.").public
+    api_get("/tickets/#{@request_id}/comments", token: @owner_token, account: "acme")
+    note = json["comments"].last
+    assert_equal "Checking this with billing.", note["body"]
+    assert_equal false, note["public"]
+    assert_equal({ "id" => @owner.id, "name" => "Jo" }, note["author"])
+  end
+
+  test "a private note never reaches the customer" do
+    staff_note!(body: "Checking this with billing.")
+
+    refute_includes customer_comment_bodies, "Checking this with billing."
+    assert_equal [ "The download button does nothing." ], customer_comment_bodies
+  end
+
+  test "a private note leaves the customer's request exactly as it was, timestamps included" do
+    before = customer_view
+
+    staff_note!(body: "Checking this with billing.")
+
+    assert_equal before, customer_view
+  end
+
+  test "a private note does not move the request up the staff or customer lists" do
+    newer_id = open_request!(token: @avery_token, subject: "Newer one")
+    api_get("/tickets", token: @owner_token, account: "acme")
+    assert_equal [ newer_id, @request_id ], json["tickets"].map { |t| t["id"] }
+
+    staff_note!(body: "Internal only.")
+
+    api_get("/tickets", token: @owner_token, account: "acme")
+    assert_equal [ newer_id, @request_id ], json["tickets"].map { |t| t["id"] }
+    api_get("/requests", token: @avery_token, account: "acme")
+    assert_equal [ newer_id, @request_id ], json["requests"].map { |r| r["id"] }
+  end
+
+  test "a staff status change on its own still moves the request to the top of the lists" do
+    newer_id = open_request!(token: @avery_token, subject: "Newer one")
+    api_get("/tickets", token: @owner_token, account: "acme")
+    assert_equal [ newer_id, @request_id ], json["tickets"].map { |t| t["id"] }
+
+    api_patch("/tickets/#{@request_id}", { ticket: { status: "pending" } }, token: @owner_token, account: "acme")
+
+    api_get("/tickets", token: @owner_token, account: "acme")
+    assert_equal [ @request_id, newer_id ], json["tickets"].map { |t| t["id"] }
+  end
+
+  test "setting a status that is already set changes nothing, not even the timestamp" do
+    updated_at = Ticket.find(@request_id).updated_at
+
+    api_patch("/tickets/#{@request_id}", { ticket: { status: "open" } }, token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal updated_at.to_i, Ticket.find(@request_id).updated_at.to_i
+  end
+
+  test "a private note does not change the status, even a solved or pending one" do
+    %w[open pending solved].each do |status|
+      Ticket.find(@request_id).update!(status: status)
+      staff_note!(body: "Internal note while #{status}.")
+      assert_response :ok
+      assert_equal status, json.dig("ticket", "status")
+      assert_equal status, Ticket.find(@request_id).status
+    end
+  end
+
+  test "a private note on a solved request does not reopen it for the customer" do
+    api_patch("/tickets/#{@request_id}", { ticket: { status: "solved" } }, token: @owner_token, account: "acme")
+
+    staff_note!(body: "Logged in case it comes back.")
+
+    assert_equal "solved", customer_view["status"]
+  end
+
+  test "a private note sent with an explicit status still applies that status, since it is a deliberate change" do
+    staff_note!(body: "Refund approved internally.", extra: { status: "pending" })
+
+    assert_response :ok
+    assert_equal "pending", json.dig("ticket", "status")
+    assert_equal "pending", customer_view["status"]
+    refute_includes customer_comment_bodies, "Refund approved internally."
+  end
+
+  test "a public staff reply is still public and still moves the request" do
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "We are on it." } } }, token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal true, Comment.find_by!(body: "We are on it.").public
+    assert_includes customer_comment_bodies, "We are on it."
+  end
+
+  test "a public staff reply that says public explicitly is public" do
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "Public and explicit.", public: true } } },
+              token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_includes customer_comment_bodies, "Public and explicit."
+  end
+
+  test "an agent can add a private note" do
+    staff_note!(body: "Agent's note.", token: @sam_token)
+
+    assert_response :ok
+    assert_equal user_in("acme", "sam@example.test"), Comment.find_by!(body: "Agent's note.").author
+    refute_includes customer_comment_bodies, "Agent's note."
+  end
+
+  test "a value other than true or false for public is refused, and nothing is posted" do
+    [ "maybe", nil, 0, "yes" ].each do |value|
+      api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "Should not post", public: value } } },
+                token: @owner_token, account: "acme")
+      assert_response :unprocessable_entity, "public #{value.inspect} should be refused"
+      assert json.dig("error", "errors", "comment.public").present?
+    end
+    refute Comment.exists?(body: "Should not post")
+    assert_equal [ "The download button does nothing." ], customer_comment_bodies
+  end
+
+  test "the strings true and false are read as booleans" do
+    staff_note!(body: "String false note.")
+    assert_response :ok
+    assert_equal false, Comment.find_by!(body: "String false note.").public
+
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "String true note.", public: "true" } } },
+              token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal true, Comment.find_by!(body: "String true note.").public
+  end
+
+  test "a private note still needs a body" do
+    staff_note!(body: "")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "comment.body").present?
+    assert_equal 1, Comment.where(ticket_id: @request_id).count
+  end
+
+  test "a customer's public flag is ignored, so customers cannot post private notes" do
+    api_patch("/requests/#{@request_id}", { request: { comment: { body: "Still public?", public: false } } },
+              token: @avery_token, account: "acme")
+
+    assert_response :ok
+    assert_equal true, Comment.find_by!(body: "Still public?").public
+    assert_includes customer_comment_bodies, "Still public?"
+  end
+
+  test "private notes are kept in the staff conversation, oldest first, next to the public ones" do
+    api_patch("/tickets/#{@request_id}", { ticket: { comment: { body: "Public reply." } } }, token: @owner_token, account: "acme")
+    staff_note!(body: "Private.")
+
+    api_get("/tickets/#{@request_id}/comments", token: @owner_token, account: "acme")
+    assert_equal [ "The download button does nothing.", "Public reply.", "Private." ], json["comments"].map { |c| c["body"] }
+    assert_equal [ true, true, false ], json["comments"].map { |c| c["public"] }
+  end
+end
diff --git a/test/integration/invitation_acceptance_test.rb b/test/integration/invitation_acceptance_test.rb
new file mode 100644
index 0000000..3054539
--- /dev/null
+++ b/test/integration/invitation_acceptance_test.rb
@@ -0,0 +1,273 @@
+require "test_helper"
+
+class InvitationAcceptanceTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+  end
+
+  def invite!(email: "sam@example.test", role: "agent", token: @owner_token, account: "acme")
+    api_post("/invitations", { invitation: { email: email, role: role } }, token: token, account: account)
+    assert_response :created, "invite failed: #{response.body}"
+    json.dig("invitation", "id")
+  end
+
+  def preview!(token, account: nil)
+    api_post("/invitation_previews", { invitation_preview: { token: token } }, account: account)
+  end
+
+  test "the preview shows the invited email, role, business name, subdomain and expiry, without signing in" do
+    invite!(role: "admin")
+    token = invitation_token("sam@example.test")
+
+    preview!(token)
+
+    assert_response :ok
+    preview = json["invitation_preview"]
+    assert_equal %w[business_name email expires_at role subdomain], preview.keys.sort
+    assert_equal "sam@example.test", preview["email"]
+    assert_equal "admin", preview["role"]
+    assert_equal "Acme", preview["business_name"]
+    assert_equal "acme", preview["subdomain"]
+    assert_in_delta 7.days.from_now.to_f, Time.iso8601(preview["expires_at"]).to_f, 5
+  end
+
+  test "the preview refuses unknown, missing, accepted, revoked and expired invitations the same way" do
+    preview!("not-a-real-token")
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+
+    preview!("")
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+
+    invite!
+    token = invitation_token("sam@example.test")
+    travel 8.days do
+      preview!(token)
+      assert_response :unprocessable_entity
+      assert_equal "invalid_token", json.dig("error", "code")
+    end
+
+    invite!(email: "bo@acme.test")
+    revoked_token = invitation_token("bo@acme.test")
+    api_delete("/invitations/#{Invitation.find_by!(email: "bo@acme.test").id}", token: @owner_token, account: "acme")
+    preview!(revoked_token)
+    assert_response :unprocessable_entity
+
+    invite!(email: "cy@acme.test")
+    accepted_token = invitation_token("cy@acme.test")
+    accept_invitation!(accepted_token, name: "Cy")
+    preview!(accepted_token)
+    assert_response :unprocessable_entity
+  end
+
+  test "a preview with a missing envelope is a bad request" do
+    api_post("/invitation_previews", { token: "x" })
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "a preview sent with another business's header does not open the invitation" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    invite!
+    token = invitation_token("sam@example.test")
+
+    preview!(token, account: "globex")
+
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "an unknown business header is not found" do
+    preview!("whatever", account: "nowhere")
+
+    assert_response :not_found
+    assert_equal "account_not_found", json.dig("error", "code")
+  end
+
+  test "accepting creates a verified user in the business with the invited role, and returns user and account" do
+    invite!(role: "agent")
+    token = invitation_token("sam@example.test")
+    mails_before = ActionMailer::Base.deliveries.size
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "Sam", password: TEAM_PASSWORD } }, account: "acme")
+
+    assert_response :created
+    assert_equal %w[account user], json.keys.sort
+    assert_equal "sam@example.test", json.dig("user", "email")
+    assert_equal "Sam", json.dig("user", "name")
+    assert_equal "agent", json.dig("user", "role")
+    assert_equal true, json.dig("user", "verified")
+    assert_equal "acme", json.dig("account", "subdomain")
+    assert_equal mails_before, ActionMailer::Base.deliveries.size, "accepting must not send another verification email"
+    assert_equal "accepted", Invitation.last.status
+  end
+
+  test "the new person signs in straight away, without verifying anything" do
+    invite!
+    accept_invitation!(invitation_token("sam@example.test"))
+
+    api_post("/sessions", { session: { email: "sam@example.test", password: TEAM_PASSWORD } }, account: "acme")
+
+    assert_response :created
+    token = json.dig("session", "token")
+    api_get("/me", token: token, account: "acme")
+    assert_equal "agent", json.dig("user", "role")
+  end
+
+  test "an admin invitation makes an admin who can manage people" do
+    invite!(email: "ann@acme.test", role: "admin")
+    accept_invitation!(invitation_token("ann@acme.test"), name: "Ann")
+    ann_token = sign_in!(email: "ann@acme.test", password: TEAM_PASSWORD)
+
+    api_get("/users", token: ann_token, account: "acme")
+    assert_response :ok
+  end
+
+  test "an invitation can be accepted only once" do
+    invite!
+    token = invitation_token("sam@example.test")
+    accept_invitation!(token)
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "Sam again", password: TEAM_PASSWORD } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+    assert_equal 1, User.where(email: "sam@example.test").count
+  end
+
+  test "a failed acceptance keeps the invitation pending, so it can be retried" do
+    invite!
+    token = invitation_token("sam@example.test")
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "Sam", password: "short" } }, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "password").present?
+    assert_equal "pending", Invitation.last.status
+    assert_nil User.find_by(email: "sam@example.test")
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "", password: TEAM_PASSWORD } }, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "name").present?
+
+    accept_invitation!(token)
+    assert_equal "accepted", Invitation.last.status
+  end
+
+  test "a blank password is refused, not quietly dropped" do
+    invite!
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: invitation_token("sam@example.test"), name: "Sam", password: "" } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "password").present?
+  end
+
+  test "an expired invitation cannot be accepted, and resending makes it acceptable again" do
+    id = invite!
+    old_token = invitation_token("sam@example.test")
+
+    travel 8.days do
+      api_post("/invitation_acceptances", { invitation_acceptance: { token: old_token, name: "Sam", password: TEAM_PASSWORD } }, account: "acme")
+      assert_response :unprocessable_entity
+      assert_equal "invalid_token", json.dig("error", "code")
+
+      api_post("/invitations/#{id}/resend", token: @owner_token, account: "acme")
+      accept_invitation!(invitation_token("sam@example.test"))
+    end
+  end
+
+  test "a revoked invitation cannot be accepted" do
+    id = invite!
+    token = invitation_token("sam@example.test")
+    api_delete("/invitations/#{id}", token: @owner_token, account: "acme")
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "Sam", password: TEAM_PASSWORD } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "an invitation cannot be accepted once the business has been cancelled" do
+    invite!
+    token = invitation_token("sam@example.test")
+    api_post("/account/cancel", token: @owner_token, account: "acme")
+    assert_response :ok
+
+    api_post("/invitation_previews", { invitation_preview: { token: token } }, account: "acme")
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "Sam", password: TEAM_PASSWORD } }, account: "acme")
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+    assert_nil User.find_by(email: "sam@example.test")
+  end
+
+  test "if the email has become a user in the meantime, acceptance is refused and nothing is created" do
+    invite!
+    token = invitation_token("sam@example.test")
+    User.create!(account: Account.find_by!(subdomain: "acme"), name: "Sam", email: "sam@example.test",
+                 password: TEAM_PASSWORD, role: "customer", verified_at: Time.current)
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "Sam", password: TEAM_PASSWORD } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "email").present?
+    assert_equal "pending", Invitation.last.status
+  end
+
+  test "a pending invitation's email cannot be taken by customer registration" do
+    invite!
+
+    api_post("/registrations", { user: { name: "Sam", email: "sam@example.test", password: "customer-password" } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "email").present?
+    assert_nil User.find_by(email: "sam@example.test")
+    assert_equal "pending", Invitation.last.status
+  end
+
+  test "a registration reports its other problems together with the invitation clash" do
+    invite!
+
+    api_post("/registrations", { user: { name: "", email: "sam@example.test", password: "customer-password" } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "email").present?
+    assert json.dig("error", "errors", "name").present?
+  end
+
+  test "the email is matched without case, so a differently cased registration is refused too" do
+    invite!
+
+    api_post("/registrations", { user: { name: "Sam", email: "SAM@Example.test", password: "customer-password" } }, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "email").present?
+  end
+
+  test "customer registration still works for everyone else, and for an email whose invitation has expired" do
+    invite!
+    api_post("/registrations", { user: { name: "Avery", email: "avery@example.test", password: "customer-password" } }, account: "acme")
+    assert_response :created
+
+    travel 8.days do
+      api_post("/registrations", { user: { name: "Sam", email: "sam@example.test", password: "customer-password" } }, account: "acme")
+      assert_response :created
+    end
+  end
+
+  test "a pending invitation in another business does not block registration here" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    api_post("/invitations", { invitation: { email: "sam@example.test", role: "agent" } }, token: globex_token, account: "globex")
+    assert_response :created
+
+    api_post("/registrations", { user: { name: "Sam", email: "sam@example.test", password: "customer-password" } }, account: "acme")
