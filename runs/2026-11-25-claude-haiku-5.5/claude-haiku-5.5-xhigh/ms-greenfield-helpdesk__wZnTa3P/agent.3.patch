@@ -0,0 +1,167 @@
+require "test_helper"
+
+class TicketAssignmentTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+    @avery = user_in("acme", "avery@example.test")
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @sam = user_in("acme", "sam@example.test")
+    @request_id = open_request!(token: @avery_token)
+  end
+
+  def assign!(value, token: @owner_token, body: { ticket: {} })
+    body[:ticket][:assignee_id] = value
+    api_patch("/tickets/#{@request_id}", body, token: token, account: "acme")
+  end
+
+  test "staff tickets carry assignee_id and the assignee's id and name" do
+    api_get("/tickets", token: @owner_token, account: "acme")
+
+    ticket = json["tickets"].find { |t| t["id"] == @request_id }
+    assert_equal %w[assignee assignee_id created_at id requester status subject updated_at], ticket.keys.sort
+    assert_nil ticket["assignee_id"]
+    assert_nil ticket["assignee"]
+  end
+
+  test "an admin assigns a ticket to an agent, and the assignee is shown" do
+    assign!(@sam.id)
+
+    assert_response :ok
+    assert_equal @sam.id, json.dig("ticket", "assignee_id")
+    assert_equal({ "id" => @sam.id, "name" => "Sam" }, json.dig("ticket", "assignee"))
+    assert_equal @sam.id, Ticket.find(@request_id).assignee_id
+
+    api_get("/tickets/#{@request_id}", token: @owner_token, account: "acme")
+    assert_equal @sam.id, json.dig("ticket", "assignee_id")
+    api_get("/tickets", token: @sam_token, account: "acme")
+    assert_equal @sam.id, json["tickets"].first.dig("assignee", "id")
+  end
+
+  test "an agent can assign a ticket too" do
+    assign!(@owner.id, token: @sam_token)
+
+    assert_response :ok
+    assert_equal @owner.id, json.dig("ticket", "assignee_id")
+  end
+
+  test "null clears the assignment" do
+    assign!(@sam.id)
+    assign!(nil)
+
+    assert_response :ok
+    assert_nil json.dig("ticket", "assignee_id")
+    assert_nil json.dig("ticket", "assignee")
+    assert_nil Ticket.find(@request_id).assignee_id
+  end
+
+  test "a blank assignee is treated as clearing it" do
+    assign!(@sam.id)
+    assign!("")
+
+    assert_response :ok
+    assert_nil Ticket.find(@request_id).assignee_id
+  end
+
+  test "assigning changes neither the status nor the order of the lists, so the customer's view is unchanged" do
+    before = customer_view
+    updated_at = Ticket.find(@request_id).updated_at
+
+    assign!(@sam.id)
+
+    assert_equal updated_at.to_i, Ticket.find(@request_id).updated_at.to_i
+    assert_equal before, customer_view
+  end
+
+  test "the customer's view of the request does not show the assignment" do
+    assign!(@sam.id)
+
+    api_get("/requests/#{@request_id}", token: @avery_token, account: "acme")
+    assert_response :ok
+    assert_equal %w[created_at id requester_id status subject updated_at], json["request"].keys.sort
+  end
+
+  test "a customer cannot assign a ticket, and an update that only tries to is a bad request" do
+    api_patch("/requests/#{@request_id}", { request: { assignee_id: @avery.id } }, token: @avery_token, account: "acme")
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+
+    api_patch("/requests/#{@request_id}", { request: { assignee_id: @sam.id, comment: { body: "Any news?" } } },
+              token: @avery_token, account: "acme")
+    assert_response :ok
+    assert_nil Ticket.find(@request_id).assignee_id
+  end
+
+  test "a customer or a staff member outside the business cannot be an assignee" do
+    assign!(@avery.id)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "assignee_id").present?
+
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_owner = user_in("globex", "jo@globex.test")
+    assign!(globex_owner.id)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "assignee_id").present?
+    assert_nil Ticket.find(@request_id).assignee_id
+  end
+
+  test "a suspended staff member cannot be assigned" do
+    api_patch("/users/#{@sam.id}", { user: { suspended: true } }, token: @owner_token, account: "acme")
+    assert_response :ok
+
+    assign!(@sam.id)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "assignee_id").present?
+  end
+
+  test "an unknown user, or something that is not an ID, is refused" do
+    assign!(999_999)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "assignee_id").present?
+
+    assign!("12abc")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "assignee_id").present?
+
+    assign!(true)
+    assert_response :unprocessable_entity
+
+    assign!(99_999_999_999_999_999_999_999)
+    assert_response :unprocessable_entity
+    assert_nil Ticket.find(@request_id).assignee_id
+  end
+
+  test "an assignment sent with a reply saves both, and a refused assignment saves neither" do
+    assign!(@sam.id, body: { ticket: { comment: { body: "Taking this one." }, status: "pending" } })
+    assert_response :ok
+    ticket = Ticket.find(@request_id)
+    assert_equal @sam.id, ticket.assignee_id
+    assert_equal "pending", ticket.status
+    assert_equal "Taking this one.", ticket.comments.last.body
+
+    assign!(@avery.id, body: { ticket: { comment: { body: "Should not appear" }, status: "solved" } })
+    assert_response :unprocessable_entity
+    ticket.reload
+    assert_equal @sam.id, ticket.assignee_id
+    assert_equal "pending", ticket.status
+    refute_includes ticket.comments.map(&:body), "Should not appear"
+  end
+
+  test "every staff member sees who the ticket is assigned to" do
+    assign!(@sam.id)
+
+    api_get("/tickets/#{@request_id}", token: @sam_token, account: "acme")
+    assert_equal "Sam", json.dig("ticket", "assignee", "name")
+  end
+
+  private
+
+  # What the customer sees for their request, including its timestamps.
+  def customer_view
+    api_get("/requests/#{@request_id}", token: @avery_token, account: "acme")
+    json["request"]
+  end
+end
diff --git a/test/integration/user_management_test.rb b/test/integration/user_management_test.rb
new file mode 100644
index 0000000..13344ba
--- /dev/null
+++ b/test/integration/user_management_test.rb
@@ -0,0 +1,267 @@
+require "test_helper"
+
+class UserManagementTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+    @avery = user_in("acme", "avery@example.test")
+    @sam_token = invite_and_sign_in!(inviter_token: @owner_token, email: "sam@example.test", name: "Sam")
+    @sam = user_in("acme", "sam@example.test")
+  end
+
+  def suspend!(user, value = true, token: @owner_token)
+    api_patch("/users/#{user.id}", { user: { suspended: value } }, token: token, account: "acme")
+  end
+
+  test "admins list users by ID ascending, with the page metadata and suspension" do
+    api_get("/users", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal %w[count next_page page per_page previous_page users], json.keys.sort
+    assert_equal [ @owner.id, @avery.id, @sam.id ], json["users"].map { |u| u["id"] }
+    assert_equal %w[account_id created_at email id name role suspended updated_at verified verified_at], json["users"].first.keys.sort
+    assert_equal [ false, false, false ], json["users"].map { |u| u["suspended"] }
+  end
+
+  test "users can be filtered by role" do
+    api_get("/users?role=agent", token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal [ "sam@example.test" ], json["users"].map { |u| u["email"] }
+
+    api_get("/users?role=customer", token: @owner_token, account: "acme")
+    assert_equal [ "avery@example.test" ], json["users"].map { |u| u["email"] }
+  end
+
+  test "users can be filtered by suspension" do
+    suspend!(@sam)
+    assert_response :ok
+
+    api_get("/users?suspended=true", token: @owner_token, account: "acme")
+    assert_equal [ "sam@example.test" ], json["users"].map { |u| u["email"] }
+    assert_equal [ true ], json["users"].map { |u| u["suspended"] }
+
+    api_get("/users?suspended=false", token: @owner_token, account: "acme")
+    assert_equal [ @owner.id, @avery.id ], json["users"].map { |u| u["id"] }
+  end
+
+  test "an unknown role or a non-boolean suspension filter is refused" do
+    api_get("/users?role=superuser", token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "role").present?
+
+    api_get("/users?suspended=maybe", token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "suspended").present?
+  end
+
+  test "admins inspect one user, and a user from another business is not found" do
+    api_get("/users/#{@avery.id}", token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal "avery@example.test", json.dig("user", "email")
+    assert_equal false, json.dig("user", "suspended")
+
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    api_get("/users/#{@avery.id}", token: globex_token, account: "globex")
+    assert_response :not_found
+  end
+
+  test "agents and customers cannot manage people" do
+    [ @avery_token, @sam_token ].each do |token|
+      api_get("/users", token: token, account: "acme")
+      assert_response :forbidden
+      assert_equal "admin_only", json.dig("error", "code")
+
+      api_get("/users/#{@avery.id}", token: token, account: "acme")
+      assert_response :forbidden
+
+      api_patch("/users/#{@avery.id}", { user: { suspended: true } }, token: token, account: "acme")
+      assert_response :forbidden
+    end
+    refute @avery.reload.suspended?
+  end
+
+  test "suspending a user signs them out of every session" do
+    assert_equal 1, Session.where(user: @sam).count, "sam signed in once"
+
+    suspend!(@sam)
+
+    assert_response :ok
+    assert_equal true, json.dig("user", "suspended")
+    assert_equal 0, Session.where(user: @sam).count
+    api_get("/me", token: @sam_token, account: "acme")
+    assert_response :unauthorized
+  end
+
+  test "a suspended user cannot sign in, and reinstating them lets them sign in again" do
+    suspend!(@sam)
+
+    api_post("/sessions", { session: { email: "sam@example.test", password: TEAM_PASSWORD } }, account: "acme")
+    assert_response :forbidden
+    assert_equal "user_suspended", json.dig("error", "code")
+
+    suspend!(@sam, false)
+    assert_response :ok
+    assert_equal false, json.dig("user", "suspended")
+
+    sign_in!(email: "sam@example.test", password: TEAM_PASSWORD)
+  end
+
+  test "reinstating does not bring back the old sessions" do
+    suspend!(@sam)
+    suspend!(@sam, false)
+
+    api_get("/me", token: @sam_token, account: "acme")
+    assert_response :unauthorized
+  end
+
+  test "suspending clears the person's ticket assignments, without moving the requests in the lists" do
+    request_id = open_request!(token: @avery_token)
+    api_patch("/tickets/#{request_id}", { ticket: { assignee_id: @sam.id } }, token: @owner_token, account: "acme")
+    assert_equal @sam.id, json.dig("ticket", "assignee_id")
+    updated_at_before = Ticket.find(request_id).updated_at
+
+    suspend!(@sam)
+
+    ticket = Ticket.find(request_id)
+    assert_nil ticket.assignee_id
+    assert_equal updated_at_before.to_i, ticket.updated_at.to_i
+    api_get("/tickets/#{request_id}", token: @owner_token, account: "acme")
+    assert_nil json.dig("ticket", "assignee")
+  end
+
+  test "suspending a customer stops them signing in" do
+    suspend!(@avery)
+
+    assert_response :ok
+    api_post("/sessions", { session: { email: "avery@example.test", password: CUSTOMER_PASSWORD } }, account: "acme")
+    assert_response :forbidden
+    assert_equal "user_suspended", json.dig("error", "code")
+  end
+
+  test "the last active admin cannot be suspended, not even by themselves" do
+    suspend!(@owner)
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "suspended").present?
+    refute @owner.reload.suspended?
+    api_get("/me", token: @owner_token, account: "acme")
+    assert_response :ok
+  end
+
+  test "an admin can be suspended while another active admin remains, and then the remaining one is the last" do
+    ann_token = invite_and_sign_in!(inviter_token: @owner_token, email: "ann@acme.test", role: "admin", name: "Ann")
+    ann = user_in("acme", "ann@acme.test")
+
+    suspend!(@owner, token: ann_token)
+    assert_response :ok
+    assert_equal true, json.dig("user", "suspended")
+
+    suspend!(ann, token: ann_token)
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "suspended").present?
+    refute ann.reload.suspended?
+  end
+
+  test "a suspended admin does not count as an active admin" do
+    invite_and_sign_in!(inviter_token: @owner_token, email: "ann@acme.test", role: "admin", name: "Ann")
+    ann = user_in("acme", "ann@acme.test")
+    suspend!(ann)
+    assert_response :ok
+
+    suspend!(@owner)
+    assert_response :unprocessable_entity
+    assert_equal true, ann.reload.suspended?
+  end
+
+  test "suspending a non-admin never trips the last admin rule" do
+    suspend!(@sam)
+    assert_response :ok
+  end
+
+  test "suspending a user twice is harmless" do
+    suspend!(@sam)
+    suspend!(@sam)
+
+    assert_response :ok
+    assert_equal true, json.dig("user", "suspended")
+  end
+
+  test "a non-boolean suspended value is refused" do
+    api_patch("/users/#{@sam.id}", { user: { suspended: "maybe" } }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "suspended").present?
+
+    api_patch("/users/#{@sam.id}", { user: { suspended: nil } }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+
+    refute @sam.reload.suspended?
+  end
+
+  test "a PATCH with no suspended value is a bad request, and other fields are ignored" do
+    api_patch("/users/#{@sam.id}", { user: { name: "Renamed" } }, token: @owner_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+    assert_equal "Sam", @sam.reload.name
+  end
+
+  test "suspension is per business, so another business's user cannot be touched" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+
+    api_patch("/users/#{@sam.id}", { user: { suspended: true } }, token: globex_token, account: "globex")
+
+    assert_response :not_found
+    refute @sam.reload.suspended?
+  end
+
+  test "staff choices list active admins and agents, by ID, leaving out customers and suspended staff" do
+    invite_and_sign_in!(inviter_token: @owner_token, email: "ann@acme.test", role: "admin", name: "Ann")
+    ann = user_in("acme", "ann@acme.test")
+    invite_and_sign_in!(inviter_token: @owner_token, email: "bo@acme.test", name: "Bo")
+    bo = user_in("acme", "bo@acme.test")
+    suspend!(bo)
+
+    api_get("/staff", token: @sam_token, account: "acme")
+
+    assert_response :ok
+    assert_equal %w[count next_page page per_page previous_page staff], json.keys.sort
+    assert_equal [ @owner.id, @sam.id, ann.id ], json["staff"].map { |s| s["id"] }
+    assert_equal({ "id" => @sam.id, "name" => "Sam", "role" => "agent" }, json["staff"][1])
+    refute_includes json["staff"].map { |s| s["id"] }, @avery.id
+    refute_includes json["staff"].map { |s| s["id"] }, bo.id
+  end
+
+  test "customers cannot read staff choices, but admins and agents can" do
+    api_get("/staff", token: @avery_token, account: "acme")
+    assert_response :forbidden
+    assert_equal "staff_only", json.dig("error", "code")
+
+    api_get("/staff", token: @owner_token, account: "acme")
+    assert_response :ok
+  end
+
+  test "a session of a suspended user is refused even if it somehow survived the suspension" do
+    @sam.update!(suspended: true)
+
+    api_get("/me", token: @sam_token, account: "acme")
+
+    assert_response :unauthorized
+  end
+
+  test "a PATCH without the user envelope is a bad request" do
+    api_patch("/users/#{@sam.id}", { suspended: true }, token: @owner_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+    refute @sam.reload.suspended?
+  end
+
+  test "a person's own profile shows their suspension" do
+    api_get("/me", token: @owner_token, account: "acme")
+    assert_equal false, json.dig("user", "suspended")
+  end
+end
diff --git a/test/support/api_helpers.rb b/test/support/api_helpers.rb
index 05c8b34..8ce1214 100644
--- a/test/support/api_helpers.rb
+++ b/test/support/api_helpers.rb
@@ -97,4 +97,29 @@ module ApiHelpers
     assert_response :created, "could not open request: #{response.body}"
     json.dig("request", "id")
   end
+
+  TEAM_PASSWORD = "my-team-password".freeze
+
+  def user_in(subdomain, email)
+    User.find_by!(email: email, account: Account.find_by!(subdomain: subdomain))
+  end
+
+  # Token from the newest invitation email sent to +email+.
+  def invitation_token(email, account: "acme")
+    link_token(to: email, path: "/accept-invitation", account: account)
+  end
+
+  # Accepts an invitation with its emailed token. The new user is verified, so no verification step.
+  def accept_invitation!(token, name: "Sam", password: TEAM_PASSWORD, account: "acme")
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: name, password: password } }, account: account)
+    assert_response :created, "acceptance failed: #{response.body}"
+  end
+
+  # Invites +email+ as the signed-in admin, accepts the invitation and signs the new person in. Returns their session token.
+  def invite_and_sign_in!(inviter_token:, email: "sam@example.test", role: "agent", name: "Sam", password: TEAM_PASSWORD, account: "acme")
+    api_post("/invitations", { invitation: { email: email, role: role } }, token: inviter_token, account: account)
+    assert_response :created, "invite failed: #{response.body}"
+    accept_invitation!(invitation_token(email, account: account), name: name, password: password, account: account)
+    sign_in!(email: email, password: password, account: account)
+  end
 end
