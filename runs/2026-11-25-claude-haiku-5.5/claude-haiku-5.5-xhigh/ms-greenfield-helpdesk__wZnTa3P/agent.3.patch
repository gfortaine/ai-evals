+require "test_helper"
+
+class InvitationsTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+    @owner_token = verified_sign_in!
+    @owner = user_in("acme", "jo@acme.test")
+    @avery_token = customer_sign_in!
+  end
+
+  def invite!(email: "sam@example.test", role: "agent", token: @owner_token, account: "acme")
+    api_post("/invitations", { invitation: { email: email, role: role } }, token: token, account: account)
+  end
+
+  # Invites and returns the new invitation's id.
+  def invite_id!(**options)
+    invite!(**options)
+    assert_response :created, "invite failed: #{response.body}"
+    json.dig("invitation", "id")
+  end
+
+  test "an admin invites an agent and gets back the invitation, pending, with no token in the JSON" do
+    invite!
+
+    assert_response :created
+    invitation = json["invitation"]
+    assert_equal %w[accepted_at created_at email expires_at id invited_by revoked_at role status updated_at], invitation.keys.sort
+    assert_equal "sam@example.test", invitation["email"]
+    assert_equal "agent", invitation["role"]
+    assert_equal "pending", invitation["status"]
+    assert_equal({ "id" => @owner.id, "name" => "Jo" }, invitation["invited_by"])
+    assert_nil invitation["accepted_at"]
+    assert_nil invitation["revoked_at"]
+    assert_in_delta 7.days.from_now.to_f, Time.iso8601(invitation["expires_at"]).to_f, 5
+  end
+
+  test "the invitation is emailed a link to the frontend acceptance screen, with the account and token" do
+    invite!
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "sam@example.test" ], mail.to
+    assert_match %r{/accept-invitation\?account=acme&token=[\w-]+}, mail.body.decoded
+    assert_includes mail.subject, "Acme"
+  end
+
+  test "the database keeps only a digest of the emailed token" do
+    invite!
+    token = invitation_token("sam@example.test")
+
+    invitation = Invitation.last
+    assert_equal Invitation.digest(token), invitation.token_digest
+    refute_equal token, invitation.token_digest
+  end
+
+  test "an admin can invite another admin" do
+    invite!(role: "admin")
+
+    assert_response :created
+    assert_equal "admin", json.dig("invitation", "role")
+  end
+
+  test "only admin and agent can be invited, because customers register themselves" do
+    [ "customer", "owner", "", nil ].each do |role|
+      invite!(role: role)
+      assert_response :unprocessable_entity, "role #{role.inspect} should be refused"
+      assert json.dig("error", "errors", "role").present?
+    end
+    assert_equal 0, Invitation.count
+  end
+
+  test "the email must be well formed and present" do
+    invite!(email: "not-an-email")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "email").present?
+
+    api_post("/invitations", { invitation: { role: "agent" } }, token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "email").present?
+    assert_equal 0, Invitation.count
+  end
+
+  test "an email that already belongs to someone in the business cannot be invited" do
+    invite!(email: "avery@example.test")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "email").present?
+
+    invite!(email: "JO@acme.test")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "email").present?
+  end
+
+  test "there is never more than one pending invitation for an email in a business, whatever the role" do
+    invite!(role: "agent")
+    assert_response :created
+
+    invite!(role: "admin")
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "email").present?
+
+    assert_equal 1, Invitation.where(email: "sam@example.test").count
+  end
+
+  test "emails are compared without case or surrounding spaces" do
+    invite!(email: "  Sam@Example.TEST ")
+    assert_response :created
+    assert_equal "sam@example.test", json.dig("invitation", "email")
+
+    invite!(email: "sam@example.test")
+    assert_response :unprocessable_entity
+  end
+
+  test "another business can invite the same email, because invitations belong to one business" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+
+    invite!
+    assert_response :created
+    invite!(token: globex_token, account: "globex")
+    assert_response :created
+  end
+
+  test "an expired invitation no longer blocks a fresh one for the same email" do
+    invite!
+    assert_response :created
+
+    travel 8.days do
+      invite!(role: "admin")
+      assert_response :created
+      assert_equal "admin", json.dig("invitation", "role")
+    end
+  end
+
+  test "customers and agents cannot invite anyone" do
+    invite!(token: @avery_token)
+    assert_response :forbidden
+    assert_equal "admin_only", json.dig("error", "code")
+
+    agent_token = invite_and_sign_in!(inviter_token: @owner_token, email: "ann@acme.test", name: "Ann")
+    invite!(email: "bo@acme.test", token: agent_token)
+    assert_response :forbidden
+    assert_equal "admin_only", json.dig("error", "code")
+    assert_equal 0, Invitation.where(email: "bo@acme.test").count
+  end
+
+  test "an invitation without its envelope is a bad request" do
+    api_post("/invitations", { email: "sam@example.test", role: "agent" }, token: @owner_token, account: "acme")
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+    assert_equal 0, Invitation.count
+  end
+
+  test "invitation endpoints need a signed-in user" do
+    api_get("/invitations", account: "acme")
+    assert_response :unauthorized
+  end
+
+  test "admins list invitations by ID ascending, with the page metadata" do
+    %w[a b c].each { |name| invite!(email: "#{name}@example.test") }
+
+    api_get("/invitations", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal %w[count invitations next_page page per_page previous_page], json.keys.sort
+    assert_equal %w[a@example.test b@example.test c@example.test], json["invitations"].map { |i| i["email"] }
+    ids = json["invitations"].map { |i| i["id"] }
+    assert_equal ids.sort, ids
+    assert_equal 3, json["count"]
+  end
+
+  test "invitations can be filtered by status, which computes expiry from the clock" do
+    expired_id = invite_id!(email: "old@example.test")
+
+    travel 8.days do
+      pending_id = invite_id!(email: "new@example.test")
+      revoked_id = invite_id!(email: "gone@example.test")
+      api_delete("/invitations/#{revoked_id}", token: @owner_token, account: "acme")
+      accepted_id = invite_id!(email: "yes@example.test")
+      accept_invitation!(invitation_token("yes@example.test"))
+
+      expectations = {
+        "pending" => [ pending_id ],
+        "expired" => [ expired_id ],
+        "revoked" => [ revoked_id ],
+        "accepted" => [ accepted_id ]
+      }
+      expectations.each do |status, ids|
+        api_get("/invitations?status=#{status}", token: @owner_token, account: "acme")
+        assert_response :ok
+        assert_equal ids, json["invitations"].map { |i| i["id"] }, "filter #{status}"
+        assert_equal [ status ], json["invitations"].map { |i| i["status"] }.uniq
+      end
+    end
+  end
+
+  test "an unknown status filter is refused" do
+    api_get("/invitations?status=closed", token: @owner_token, account: "acme")
+
+    assert_response :unprocessable_entity
+    assert json.dig("error", "errors", "status").present?
+  end
+
+  test "admins inspect one invitation, and another business's invitation is not found" do
+    id = invite_id!
+
+    api_get("/invitations/#{id}", token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal "sam@example.test", json.dig("invitation", "email")
+
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test", password: "globex-password")
+    globex_token = verified_sign_in!(email: "jo@globex.test", password: "globex-password", account: "globex")
+    api_get("/invitations/#{id}", token: globex_token, account: "globex")
+    assert_response :not_found
+  end
+
+  test "resending issues a new link, the old link stops working, and the expiry restarts" do
+    id = invite_id!
+    old_token = invitation_token("sam@example.test")
+
+    travel 2.days do
+      api_post("/invitations/#{id}/resend", token: @owner_token, account: "acme")
+      assert_response :ok
+      assert_equal "pending", json.dig("invitation", "status")
+      assert_in_delta 7.days.from_now.to_f, Time.iso8601(json.dig("invitation", "expires_at")).to_f, 5
+
+      new_token = invitation_token("sam@example.test")
+      refute_equal old_token, new_token
+
+      api_post("/invitation_previews", { invitation_preview: { token: old_token } }, account: "acme")
+      assert_response :unprocessable_entity
+      assert_equal "invalid_token", json.dig("error", "code")
+
+      api_post("/invitation_previews", { invitation_preview: { token: new_token } }, account: "acme")
+      assert_response :ok
+    end
+  end
+
+  test "resending an expired invitation brings it back to pending" do
+    id = invite_id!
+    travel 8.days do
+      api_get("/invitations/#{id}", token: @owner_token, account: "acme")
+      assert_equal "expired", json.dig("invitation", "status")
+
+      api_post("/invitations/#{id}/resend", token: @owner_token, account: "acme")
+      assert_response :ok
+      assert_equal "pending", json.dig("invitation", "status")
+    end
+  end
+
+  test "accepted and revoked invitations cannot be resent or revoked" do
+    revoked_id = invite_id!(email: "gone@example.test")
+    api_delete("/invitations/#{revoked_id}", token: @owner_token, account: "acme")
+    assert_response :ok
+    assert_equal "revoked", json.dig("invitation", "status")
+
+    api_post("/invitations/#{revoked_id}/resend", token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert_equal "invitation_closed", json.dig("error", "code")
+
+    api_delete("/invitations/#{revoked_id}", token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert_equal "invitation_closed", json.dig("error", "code")
+
+    accepted_id = invite_id!(email: "yes@example.test")
+    accept_invitation!(invitation_token("yes@example.test"))
+
+    api_post("/invitations/#{accepted_id}/resend", token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert_equal "invitation_closed", json.dig("error", "code")
+
+    api_delete("/invitations/#{accepted_id}", token: @owner_token, account: "acme")
+    assert_response :unprocessable_entity
+    assert_equal "invitation_closed", json.dig("error", "code")
+    assert_equal "accepted", Invitation.find(accepted_id).status
+  end
+
+  test "revoking keeps the record as revoked, and its link stops working" do
+    id = invite_id!
+    token = invitation_token("sam@example.test")
+
+    api_delete("/invitations/#{id}", token: @owner_token, account: "acme")
+
+    assert_response :ok
+    assert_equal "revoked", json.dig("invitation", "status")
+    refute_nil json.dig("invitation", "revoked_at")
+    assert_equal "revoked", Invitation.find(id).status
+
+    api_post("/invitation_acceptances", { invitation_acceptance: { token: token, name: "Sam", password: TEAM_PASSWORD } }, account: "acme")
+    assert_response :unprocessable_entity
+    assert_equal "invalid_token", json.dig("error", "code")
+    assert_nil User.find_by(email: "sam@example.test")
+  end
+
+  test "an expired invitation can be revoked, and then shows as revoked" do
+    id = invite_id!
+    travel(8.days) do
+      api_delete("/invitations/#{id}", token: @owner_token, account: "acme")
+      assert_response :ok
+      assert_equal "revoked", json.dig("invitation", "status")
+    end
+  end
+
+  test "resending is refused when a newer invitation for the email is now pending" do
+    old_id = invite_id!
+    travel 8.days do
+      invite_id!  # a fresh invitation for the same email
+      api_post("/invitations/#{old_id}/resend", token: @owner_token, account: "acme")
+      assert_response :unprocessable_entity
+      assert json.dig("error", "errors", "email").present?
+    end
+  end
+
+  test "resending is refused when the email has since joined the business" do
+    id = invite_id!
+    travel 8.days do
+      register_customer!(email: "sam@example.test")
+      api_post("/invitations/#{id}/resend", token: @owner_token, account: "acme")
+      assert_response :unprocessable_entity
+      assert json.dig("error", "errors", "email").present?
+    end
+  end
+
+  test "an unknown invitation id is not found" do
+    api_get("/invitations/999999", token: @owner_token, account: "acme")
+    assert_response :not_found
+
+    api_post("/invitations/999999/resend", token: @owner_token, account: "acme")
+    assert_response :not_found
+
+    api_delete("/invitations/999999", token: @owner_token, account: "acme")
+    assert_response :not_found
+  end
+
+  test "purging a business after its reactivation window also removes its invitations" do
+    invite!
+    api_post("/account/cancel", token: @owner_token, account: "acme")
+    account_id = Account.find_by!(subdomain: "acme").id
+
+    travel 91.days do
+      assert_equal 1, Account.purge_cancelled!
+    end
+
+    assert_equal 0, Invitation.where(account_id: account_id).count
+  end
+
+  test "only admins can list, inspect, resend or revoke invitations" do
+    id = invite_id!
+    agent_token = invite_and_sign_in!(inviter_token: @owner_token, email: "ann@acme.test", name: "Ann")
+
+    [ @avery_token, agent_token ].each do |token|
+      api_get("/invitations", token: token, account: "acme")
+      assert_response :forbidden
+      api_get("/invitations/#{id}", token: token, account: "acme")
+      assert_response :forbidden
+      api_post("/invitations/#{id}/resend", token: token, account: "acme")
+      assert_response :forbidden
+      api_delete("/invitations/#{id}", token: token, account: "acme")
+      assert_response :forbidden
+    end
+    assert_equal "pending", Invitation.find(id).status
+  end
+end
