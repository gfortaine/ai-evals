+module Api
+  module V1
+    # What the acceptance screen shows before the person signs up. The token is the only credential needed.
+    class InvitationPreviewsController < ApplicationController
+      def create
+        account = optional_account_from_header
+        return if performed?
+
+        input = require_params(:invitation_preview).permit(:token)
+        invitation = Invitation.find_pending_by_token!(input[:token], account: account)
+        business = invitation.account
+        return render_error(:forbidden, "account_cancelled", "This business has been cancelled.") if business.cancelled?
+
+        render json: {
+          invitation_preview: {
+            email: invitation.email,
+            role: invitation.role,
+            business_name: business.name,
+            subdomain: business.subdomain,
+            expires_at: invitation.expires_at
+          }
+        }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/invitations_controller.rb b/app/controllers/api/v1/invitations_controller.rb
new file mode 100644
index 0000000..1ba3648
--- /dev/null
+++ b/app/controllers/api/v1/invitations_controller.rb
@@ -0,0 +1,57 @@
+module Api
+  module V1
+    # Admins invite other admins and agents, and manage the invitations they sent. Listed by ID, oldest first.
+    class InvitationsController < ApplicationController
+      include Paginated
+
+      before_action :authenticate_session!
+      before_action :require_admin!
+
+      def index
+        status = params[:status].presence
+        if status && Invitation::STATUSES.exclude?(status)
+          return render_validation_failed(status: [ "must be one of #{Invitation::STATUSES.join(", ")}" ])
+        end
+
+        scope = current_account.invitations.includes(:invited_by).order(:id)
+        scope = scope.with_status(status) if status
+        render_page(scope, key: "invitations", &:as_api_json)
+      end
+
+      def show
+        render json: { invitation: find_invitation.as_api_json }
+      end
+
+      def create
+        input = require_params(:invitation).permit(:email, :role)
+        invitation, token = Invitation.issue!(account: current_account, invited_by: current_user,
+                                              email: input[:email], role: input[:role])
+        UserMailer.deliver_safely(:invitation, invitation, token)
+
+        render json: { invitation: invitation.as_api_json }, status: :created
+      end
+
+      # A new link. The old one stops working, and the invitation is pending for another full TTL.
+      def resend
+        invitation = find_invitation
+        token = invitation.resend!
+        UserMailer.deliver_safely(:invitation, invitation, token)
+
+        render json: { invitation: invitation.as_api_json }
+      end
+
+      # Revokes the invitation. Its link stops working, and the record stays as revoked.
+      def destroy
+        invitation = find_invitation
+        invitation.revoke!
+        render json: { invitation: invitation.as_api_json }
+      end
+
+      private
+
+      def find_invitation
+        current_account.invitations.includes(:invited_by).find(params[:id])
+      end
+    end
+  end
+end
