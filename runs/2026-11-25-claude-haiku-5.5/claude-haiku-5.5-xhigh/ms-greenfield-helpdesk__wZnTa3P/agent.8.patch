diff --git a/test/lib/keyset_cursor_test.rb b/test/lib/keyset_cursor_test.rb
new file mode 100644
index 0000000..31301f4
--- /dev/null
+++ b/test/lib/keyset_cursor_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+
+class KeysetCursorTest < ActiveSupport::TestCase
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @users = %w[ann ben cy dee].map do |name|
+      User.create!(account: @account, name: name.capitalize, email: "#{name}@acme.test", password: ApiHelpers::PASSWORD)
+    end
+  end
+
+  # A list of users by id, the way the users endpoint orders them.
+  def users_scope = @account.users.order(:id)
+
+  test "a cursor round-trips the position of a record, including microseconds" do
+    record = Struct.new(:updated_at, :id).new(Time.utc(2026, 5, 6, 7, 8, 9, 123_456), 42)
+    cursor = KeysetCursor.new(Ticket.order(updated_at: :desc, id: :desc), list: "tickets")
+
+    token = cursor.encode(record)
+
+    assert_equal [ Time.utc(2026, 5, 6, 7, 8, 9, 123_456), 42 ], cursor.decode(token)
+  end
+
+  test "a cursor is a single URL-safe string" do
+    cursor = KeysetCursor.new(users_scope, list: "users")
+    token = cursor.encode(@users.first)
+
+    assert_match(/\A[A-Za-z0-9_-]+\z/, token)
+    assert_equal @users.first.id, cursor.decode(token).first
+  end
+
+  test "a cursor from another list is refused" do
+    token = KeysetCursor.new(users_scope, list: "users").encode(@users.first)
+
+    assert_raises(KeysetCursor::Invalid) { KeysetCursor.new(users_scope, list: "groups").decode(token) }
+  end
+
+  test "anything that is not a cursor this list issued is refused" do
+    cursor = KeysetCursor.new(users_scope, list: "users")
+    list = ->(payload) { Base64.urlsafe_encode64(JSON.generate(payload), padding: false) }
+
+    [
+      nil,
+      42,
+      "",
+      "not base64!",
+      Base64.urlsafe_encode64("not json", padding: false),
+      list.call([ 1, 2 ]),
+      list.call("list" => "users"),
+      list.call("list" => "users", "position" => "1"),
+      list.call("list" => "users", "position" => [ 1, 2 ]),
+      list.call("list" => "users", "position" => [ "1" ]),
+      list.call("list" => "users", "position" => [ 0 ]),
+      list.call("list" => "users", "position" => [ -1 ]),
+      list.call("list" => "users", "position" => [ 1.5 ]),
+      list.call("list" => "users", "position" => [ 2**63 ]),
+      "x" * (KeysetCursor::MAX_LENGTH + 1)
+    ].each do |bad|
+      assert_raises(KeysetCursor::Invalid, "expected #{bad.inspect.first(60)} to be refused") { cursor.decode(bad) }
+    end
+  end
+
+  test "early years are fine, but the timestamp must still be UTC with microseconds" do
+    cursor = KeysetCursor.new(Ticket.order(updated_at: :desc, id: :desc), list: "tickets")
+    token = Base64.urlsafe_encode64(JSON.generate("list" => "tickets", "position" => [ "0999-12-31T23:59:59.000001Z", 1 ]), padding: false)
+
+    assert_equal Time.utc(999, 12, 31, 23, 59, 59, 1), cursor.decode(token).first
+  end
+
+  test "a timestamp must be UTC with microseconds, in a year PostgreSQL accepts" do
+    cursor = KeysetCursor.new(Ticket.order(updated_at: :desc, id: :desc), list: "tickets")
+    list = ->(stamp) { Base64.urlsafe_encode64(JSON.generate("list" => "tickets", "position" => [ stamp, 1 ]), padding: false) }
+
+    [ "2026-05-06T07:08:09Z", "2026-05-06 07:08:09.123456Z", "2026-05-06T07:08:09.123456+01:00",
+      "0000-01-01T00:00:00.000000Z", "2026-13-01T00:00:00.000000Z", "2026-05-06T07:08:09.123456" ].each do |bad|
+      assert_raises(KeysetCursor::Invalid, "expected #{bad} to be refused") { cursor.decode(list.call(bad)) }
+    end
+  end
+
+  test "beyond selects the rows after a position, in list order" do
+    ben = @users[1]
+    cursor = KeysetCursor.new(users_scope, list: "users")
+
+    after = users_scope.where(cursor.beyond(cursor.decode(cursor.encode(ben)), :after))
+    before = users_scope.where(cursor.beyond(cursor.decode(cursor.encode(ben)), :before))
+
+    assert_equal @users[2..].map(&:id), after.map(&:id)
+    assert_equal @users[0..0].map(&:id), before.map(&:id)
+  end
+
+  test "reversed, the same position reads the rows before it nearest first" do
+    dee = @users[3]
+    cursor = KeysetCursor.new(users_scope, list: "users")
+
+    rows = cursor.ordered(users_scope.where(cursor.beyond(cursor.decode(cursor.encode(dee)), :before)), reverse: true)
+
+    assert_equal @users[0, 3].reverse.map(&:id), rows.map(&:id), "cy, ben, ann: nearest to dee first"
+  end
+
+  test "descending lists flip the comparison" do
+    tickets = Ticket.order(updated_at: :desc, id: :desc)
+    cursor = KeysetCursor.new(tickets, list: "tickets")
+
+    sql, *binds = cursor.beyond([ Time.utc(2026, 1, 1), 5 ], :after)
+    assert_match(/\) < \(/, sql, "after a descending position means smaller keys")
+    assert_equal [ Time.utc(2026, 1, 1), 5 ], binds
+    assert_match(/\) > \(/, cursor.beyond([ Time.utc(2026, 1, 1), 5 ], :before).first)
+  end
+
+  test "the sort must end with the primary key, run one way, and use timestamps or integers" do
+    assert_raises(ArgumentError) { KeysetCursor.new(Ticket.order(:updated_at), list: "t") }
+    assert_raises(ArgumentError) { KeysetCursor.new(Ticket.order(updated_at: :desc, id: :asc), list: "t") }
