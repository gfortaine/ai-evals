+require "test_helper"
+
+class TenancyTest < ActionDispatch::IntegrationTest
+  test "the same email in two businesses has independent passwords and sessions" do
+    owner_session(subdomain: "acme", email: "jo@shared.test", password: "acme-password-1")
+    signup!(subdomain: "globex", name: "Globex", email: "jo@shared.test", password: "globex-password-1")
+    verify_email!(email: "jo@shared.test", subdomain: "globex")
+
+    acme = sign_in!(email: "jo@shared.test", password: "acme-password-1", subdomain: "acme")
+    globex = sign_in!(email: "jo@shared.test", password: "globex-password-1", subdomain: "globex")
+
+    assert_equal "acme", acme.dig("account", "subdomain")
+    assert_equal "globex", globex.dig("account", "subdomain")
+    refute_equal acme.dig("user", "id"), globex.dig("user", "id")
+
+    # Each business's password only works in its own business.
+    sign_in(email: "jo@shared.test", password: "globex-password-1", subdomain: "acme")
+    assert_response :unauthorized
+  end
+
+  test "signed-in users see their full account" do
+    body = owner_session
+    get "/api/v1/account", headers: bearer(body.dig("session", "token"))
+
+    assert_response :ok
+    account = json.fetch("account")
+    assert_equal "Acme", account["name"]
+    assert_equal "acme", account["subdomain"]
+    assert_equal "active", account["status"]
+    assert_nil account["cancelled_at"]
+    assert_nil account["reactivate_by"]
+    assert account["created_at"].present?
+  end
+
+  test "GET /portal is public and returns the name and subdomain" do
+    signup!
+
+    get "/api/v1/portal", headers: in_account("acme")
+
+    assert_response :ok
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, json)
+  end
+
+  test "GET /portal needs the business header" do
+    get "/api/v1/portal"
+
+    assert_response :bad_request
+    assert_equal "account_required", json.dig("error", "code")
+  end
+
+  test "GET /portal for an unknown business is a 404" do
+    get "/api/v1/portal", headers: in_account("missing")
+
+    assert_response :not_found
+    assert_equal "account_not_found", json.dig("error", "code")
+  end
+
+  test "the header is case-insensitive" do
+    signup!
+
+    get "/api/v1/portal", headers: in_account("ACME")
+
+    assert_response :ok
+  end
+
+  test "unknown API paths return JSON 404" do
+    get "/api/v1/does-not-exist"
+
+    assert_response :not_found
+    assert_equal "not_found", json.dig("error", "code")
+  end
+
+  test "malformed JSON gets a JSON 400" do
+    post "/api/v1/account/create",
+         params: "{not json",
+         headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :bad_request
+    assert_equal "invalid_json", json.dig("error", "code")
+  end
+end
diff --git a/test/models/account_test.rb b/test/models/account_test.rb
new file mode 100644
index 0000000..a6db177
--- /dev/null
+++ b/test/models/account_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class AccountTest < ActiveSupport::TestCase
+  def build_account(**attrs)
+    Account.new({ name: "Acme", subdomain: "acme" }.merge(attrs))
+  end
+
+  test "subdomains are normalized to lowercase" do
+    account = build_account(subdomain: "  AcMe ")
+    account.validate
+    assert_equal "acme", account.subdomain
+  end
+
+  test "reserved subdomains are invalid" do
+    account = build_account(subdomain: "admin")
+    refute account.valid?
+    assert account.errors[:subdomain].present?
+  end
+
+  test "subdomains longer than 63 characters are invalid" do
+    refute build_account(subdomain: "a" * 64).valid?
+    assert build_account(subdomain: "a" * 63).valid?
+  end
+
+  test "reactivatable is true only inside the 90-day window" do
+    now = Time.current
+    account = Account.create!(name: "Acme", subdomain: "acme", cancelled_at: now)
+
+    assert account.reactivatable?(now: now + 89.days)
+    refute account.reactivatable?(now: now + 90.days)
+  end
+
+  test "an active account is not reactivatable and has no reactivate_by" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+
+    refute account.reactivatable?
+    assert_nil account.reactivate_by
+    assert_equal "active", account.as_api_json[:status]
+  end
+
+  test "cancel! twice raises a StateError" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+    account.cancel!
+
+    error = assert_raises(Account::StateError) { account.cancel! }
+    assert_equal "already_cancelled", error.code
+  end
+
+  test "reactivate! on an active account raises a StateError" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+
+    error = assert_raises(Account::StateError) { account.reactivate! }
+    assert_equal "not_cancelled", error.code
+  end
+end
diff --git a/test/models/user_test.rb b/test/models/user_test.rb
new file mode 100644
index 0000000..b159f65
--- /dev/null
+++ b/test/models/user_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class UserTest < ActiveSupport::TestCase
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+  end
+
+  test "emails are normalized and unique per account only" do
+    @account.users.create!(name: "Jo", email: " Jo@Acme.test ", password: "my-first-password", role: "admin")
+    assert_equal "jo@acme.test", User.last.email
+
+    other = Account.create!(name: "Globex", subdomain: "globex")
+    assert other.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin").persisted?
+  end
+
+  test "only known roles are allowed" do
+    user = @account.users.new(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "owner")
+    refute user.valid?
+    assert user.errors[:role].present?
+  end
+
+  test "change_password! revokes every session" do
+    user = @account.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+    Session.start_for(user)
+    Session.start_for(user)
+
+    user.change_password!("my-new-password")
+
+    assert_equal 0, Session.where(user_id: user.id).count
+    assert user.reload.authenticate("my-new-password")
+  end
+
+  test "change_password! refuses a blank password and keeps sessions" do
+    user = @account.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+    Session.start_for(user)
+
+    assert_raises(ActiveRecord::RecordInvalid) { user.change_password!("") }
+    assert_equal 1, Session.where(user_id: user.id).count
+    assert user.reload.authenticate("my-first-password")
+  end
+end
+
+class UserPasswordCheckTest < ActiveSupport::TestCase
+  test "burn_password_check never matches and returns nil" do
+    assert_nil User.burn_password_check("anything")
+    assert_nil User.burn_password_check("")
+  end
+end
