diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..b4fc32b
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,69 @@
+module Api
+  module V1
+    class AccountsController < ApplicationController
+      before_action :authenticate_session!, except: :create
+      before_action :require_active_account!, only: :cancel
+      before_action :require_admin!, only: %i[cancel reactivate]
+
+      # POST /api/v1/account/create
+      # { account: { name, subdomain, admin: { name, email, password } } }
+      def create
+        account = Account.new(account_params)
+        admin = User.new(admin_params.merge(role: User::ADMIN, account: account))
+
+        unless [account.valid?, admin.valid?].all?
+          details = { account: account.errors.to_hash, admin: admin.errors.to_hash }.reject { |_, errors| errors.empty? }
+          return render_error(422, "validation_failed", "The business could not be created.", details: details)
+        end
+
+        token = nil
+        ActiveRecord::Base.transaction do
+          account.save!
+          admin.save!
+          token = UserToken.issue!(admin, :email_verification)
+        end
+        # Send only after commit, so the link never points at a rolled-back user.
+        UserMailer.email_verification(admin, token).deliver_later
+
+        render json: { account: account.as_api_json, user: admin.as_api_json }, status: :created
+      rescue ActiveRecord::RecordNotUnique
+        # Lost a race with another signup for the same subdomain or email.
+        render_error(422, "validation_failed", "That subdomain or email is already taken.")
+      end
+
+      # GET /api/v1/account
+      def show
+        render json: { account: @account.as_api_json }
+      end
+
+      # POST /api/v1/account/cancel
+      def cancel
+        @account.cancel!
+        render json: { account: @account.as_api_json }
+      rescue Account::StateError => e
+        render_error(422, e.code, e.message)
+      end
+
+      # POST /api/v1/account/reactivate
+      def reactivate
+        @account.reactivate!
+        render json: { account: @account.as_api_json }
+      rescue Account::StateError => e
+        render_error(422, e.code, e.message)
+      end
+
+      private
+
+      def account_params
+        require_envelope(:account).permit(:name, :subdomain)
+      end
+
+      def admin_params
+        admin = require_envelope(:account).fetch(:admin, nil)
+        raise ActionController::ParameterMissing, :admin unless admin.is_a?(ActionController::Parameters)
+
+        admin.permit(:name, :email, :password).to_h
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
new file mode 100644
index 0000000..d793ab3
--- /dev/null
+++ b/app/controllers/api/v1/email_verifications_controller.rb
@@ -0,0 +1,35 @@
+module Api
+  module V1
+    class EmailVerificationsController < ApplicationController
+      before_action :load_account_from_header!, only: :create
+
+      # POST /api/v1/email_verifications  { email_verification: { email } }
+      def create
+        email = require_envelope(:email_verification).require(:email)
+        user = @account.users.find_by(email: email.to_s)
+
+        # Same answer whether or not the email exists, so this does not reveal accounts.
+        if user && !user.verified?
+          token = UserToken.issue!(user, :email_verification)
+          UserMailer.email_verification(user, token).deliver_later
+        end
+
+        render json: { message: "If that email needs verification, a new link is on its way." }, status: :accepted
+      end
+
+      # POST /api/v1/email_verifications/confirm  { email_verification: { token } }
+      def confirm
+        token = require_envelope(:email_verification).require(:token)
+        record = UserToken.redeem(:email_verification, token)
+        user = record&.user
+        return render_error(422, "invalid_token", "This verification link is invalid or has expired.") if user.nil? || !requested_account_matches?(user.account)
+
+        UserToken.transaction do
+          user.verify!
+          record.destroy!
+        end
+        render json: { message: "Email verified. You can sign in now.", user: user.as_api_json }
+      end
+    end
+  end
+end
