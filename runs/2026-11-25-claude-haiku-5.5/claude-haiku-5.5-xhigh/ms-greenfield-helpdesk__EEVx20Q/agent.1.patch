+require "test_helper"
+
+class ConfigurationTest < ActionDispatch::IntegrationTest
+  test "HELPDESK_MAIL_FROM sets the sender" do
+    with_env("HELPDESK_MAIL_FROM" => "help@acme.test") do
+      signup!
+    end
+
+    assert_equal ["help@acme.test"], latest_mail("jo@acme.test").from
+  end
+
+  test "links use HELPDESK_FRONTEND_URL when set" do
+    with_env("HELPDESK_FRONTEND_URL" => "https://app.acme.test/") do
+      signup!
+      token = link_token(to: "jo@acme.test", path: "/verify-email")
+      assert_includes latest_mail("jo@acme.test").body.decoded,
+                      "https://app.acme.test/verify-email?account=acme&token=#{token}"
+    end
+  end
+
+  test "defaults are the frontend on port 3001 and support@example.test" do
+    with_env("HELPDESK_FRONTEND_URL" => nil, "HELPDESK_MAIL_FROM" => nil) do
+      assert_equal "http://localhost:3001", Helpdesk::Settings.frontend_url
+      assert_equal "support@example.test", Helpdesk::Settings.mail_from
+    end
+  end
+
+  private
+
+  def with_env(values)
+    previous = values.keys.to_h { |key| [key, ENV[key]] }
+    values.each { |key, value| ENV[key] = value }
+    yield
+  ensure
+    previous.each { |key, value| ENV[key] = value }
+  end
+end
diff --git a/test/integration/cors_test.rb b/test/integration/cors_test.rb
new file mode 100644
index 0000000..ffed9f4
--- /dev/null
+++ b/test/integration/cors_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class CorsTest < ActionDispatch::IntegrationTest
+  FRONTEND = "http://localhost:3001".freeze
+
+  test "the configured frontend origin may call the API, including preflight" do
+    process :options, "/api/v1/me",
+            headers: {
+              "Origin" => FRONTEND,
+              "Access-Control-Request-Method" => "PATCH",
+              "Access-Control-Request-Headers" => "authorization, content-type, x-helpdesk-account"
+            }
+
+    assert_response :no_content
+    assert_equal FRONTEND, response.headers["access-control-allow-origin"]
+    assert_includes response.headers["access-control-allow-methods"], "PATCH"
+    assert_includes response.headers["access-control-allow-headers"], "X-Helpdesk-Account"
+    assert_includes response.headers["access-control-allow-headers"], "Authorization"
+  end
+
+  test "real responses to the frontend origin carry the allow-origin header" do
+    signup!
+
+    get "/api/v1/portal", headers: in_account("acme").merge("Origin" => FRONTEND)
+
+    assert_response :ok
+    assert_equal FRONTEND, response.headers["access-control-allow-origin"]
+    assert_includes response.headers["vary"], "Origin"
+  end
+
+  test "other origins get no CORS headers" do
+    signup!
+
+    get "/api/v1/portal", headers: in_account("acme").merge("Origin" => "https://evil.test")
+    assert_response :ok
+    assert_nil response.headers["access-control-allow-origin"]
+
+    process :options, "/api/v1/me",
+            headers: { "Origin" => "https://evil.test", "Access-Control-Request-Method" => "GET" }
+    assert_nil response.headers["access-control-allow-origin"]
+  end
+
+  test "the allowed origin follows HELPDESK_FRONTEND_URL, without its path or trailing slash" do
+    previous = ENV["HELPDESK_FRONTEND_URL"]
+    ENV["HELPDESK_FRONTEND_URL"] = "https://support.acme.test:8443/app/"
+
+    process :options, "/api/v1/me",
+            headers: { "Origin" => "https://support.acme.test:8443", "Access-Control-Request-Method" => "GET" }
+    assert_equal "https://support.acme.test:8443", response.headers["access-control-allow-origin"]
+
+    process :options, "/api/v1/me",
+            headers: { "Origin" => FRONTEND, "Access-Control-Request-Method" => "GET" }
+    assert_nil response.headers["access-control-allow-origin"]
+  ensure
+    ENV["HELPDESK_FRONTEND_URL"] = previous
+  end
+end
diff --git a/test/integration/passwords_test.rb b/test/integration/passwords_test.rb
new file mode 100644
index 0000000..22bde6a
--- /dev/null
+++ b/test/integration/passwords_test.rb
@@ -0,0 +1,207 @@
+require "test_helper"
+
+class PasswordsTest < ActionDispatch::IntegrationTest
+  NEW_PASSWORD = "my-new-password".freeze
+
+  setup do
+    owner_session
+  end
+
+  # --- Changing a password while signed in -------------------------------------
+
+  test "a wrong current password is rejected and changes nothing" do
+    token = sign_in!.dig("session", "token")
+
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "not-it", password: NEW_PASSWORD } },
+        headers: bearer(token),
+        as: :json
+
+    assert_response :unprocessable_content
+    assert_equal "invalid_current_password", json.dig("error", "code")
+    get "/api/v1/me", headers: bearer(token)
+    assert_response :ok
+  end
+
+  test "changing the password signs out every session and the new password works" do
+    first = sign_in!.dig("session", "token")
+    second = sign_in!.dig("session", "token")
+
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: PASSWORD, password: NEW_PASSWORD } },
+        headers: bearer(first),
+        as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: bearer(first)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: bearer(second)
+    assert_response :unauthorized
+
+    sign_in(password: PASSWORD)
+    assert_response :unauthorized
+
+    sign_in!(password: NEW_PASSWORD)
+  end
+
+  test "a blank new password is rejected and the old password still works" do
+    token = sign_in!.dig("session", "token")
+
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: PASSWORD, password: "" } },
+        headers: bearer(token),
+        as: :json
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "password").present?
+    sign_in!(password: PASSWORD)
+  end
+
+  test "a too-short new password is rejected and the session survives" do
+    token = sign_in!.dig("session", "token")
+
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: PASSWORD, password: "short" } },
+        headers: bearer(token),
+        as: :json
+
+    assert_response :unprocessable_content
+    get "/api/v1/me", headers: bearer(token)
+    assert_response :ok
+  end
+
+  test "password change requires a signed-in user" do
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: PASSWORD, password: NEW_PASSWORD } },
+        as: :json
+
+    assert_response :unauthorized
+  end
+
+  # --- Forgotten password -------------------------------------------------------
+
+  test "requesting a reset emails a link to the frontend" do
+    post "/api/v1/password_resets", params: { password_reset: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+
+    assert_response :accepted
+    token = link_token(to: "jo@acme.test", path: "/reset-password")
+    assert_includes latest_mail("jo@acme.test").body.decoded,
+                    "http://localhost:3001/reset-password?account=acme&token=#{token}"
+  end
+
+  test "an unknown email gets the same response and no mail" do
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/password_resets", params: { password_reset: { email: "nobody@acme.test" } },
+         headers: in_account("acme"), as: :json
+    unknown = [response.status, json]
+
+    post "/api/v1/password_resets", params: { password_reset: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+    known = [response.status, json]
+
+    assert_equal known.first, unknown.first
+    assert_equal known.last.keys, unknown.last.keys
+    assert_equal 1, ActionMailer::Base.deliveries.size, "only the known account should get mail"
+  end
+
+  test "a reset link sets the new password, signs everyone out, and works once" do
+    token_session = sign_in!.dig("session", "token")
+    post "/api/v1/password_resets", params: { password_reset: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+    token = link_token(to: "jo@acme.test", path: "/reset-password")
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: token, password: NEW_PASSWORD } }, as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: bearer(token_session)
+    assert_response :unauthorized
+    sign_in!(password: NEW_PASSWORD)
+    sign_in(password: PASSWORD)
+    assert_response :unauthorized
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: token, password: "another-password" } }, as: :json
+    assert_response :unprocessable_content
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "a newer reset request replaces the older link" do
+    post "/api/v1/password_resets", params: { password_reset: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+    old_token = link_token(to: "jo@acme.test", path: "/reset-password")
+
+    post "/api/v1/password_resets", params: { password_reset: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+    new_token = link_token(to: "jo@acme.test", path: "/reset-password")
+    refute_equal old_token, new_token
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: old_token, password: NEW_PASSWORD } }, as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: new_token, password: NEW_PASSWORD } }, as: :json
+    assert_response :ok
+  end
+
+  test "a reset link expires after an hour" do
+    post "/api/v1/password_resets", params: { password_reset: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+    token = link_token(to: "jo@acme.test", path: "/reset-password")
+
+    travel 61.minutes do
+      post "/api/v1/password_resets/confirm",
+           params: { password_reset: { token: token, password: NEW_PASSWORD } }, as: :json
+    end
+
+    assert_response :unprocessable_content
+    sign_in!(password: PASSWORD)
+  end
+
+  test "a rejected new password keeps the reset link usable" do
+    post "/api/v1/password_resets", params: { password_reset: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+    token = link_token(to: "jo@acme.test", path: "/reset-password")
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: token, password: "short" } }, as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: token, password: NEW_PASSWORD } }, as: :json
+    assert_response :ok
+    sign_in!(password: NEW_PASSWORD)
+  end
+
+  # --- Email verification re-requests --------------------------------------------
+
+  test "requesting another verification link replaces the earlier one" do
+    signup!(subdomain: "globex", name: "Globex", email: "ann@globex.test")
+    post "/api/v1/email_verifications", params: { email_verification: { email: "ann@globex.test" } },
+         headers: in_account("globex"), as: :json
+    assert_response :accepted
+    first = link_token(to: "ann@globex.test", path: "/verify-email")
+
+    post "/api/v1/email_verifications", params: { email_verification: { email: "ann@globex.test" } },
+         headers: in_account("globex"), as: :json
+    second = link_token(to: "ann@globex.test", path: "/verify-email")
+    refute_equal first, second
+
+    post "/api/v1/email_verifications/confirm", params: { email_verification: { token: first } }, as: :json
+    assert_response :unprocessable_content
+    post "/api/v1/email_verifications/confirm", params: { email_verification: { token: second } }, as: :json
+    assert_response :ok
+  end
+
+  test "re-requesting verification for an already verified email sends nothing" do
+    # The setup block already verified jo@acme.test.
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/email_verifications", params: { email_verification: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+
+    assert_response :accepted
+    assert_equal 0, ActionMailer::Base.deliveries.size
+  end
+end
diff --git a/test/integration/signup_test.rb b/test/integration/signup_test.rb
new file mode 100644
index 0000000..abb34e0
--- /dev/null
+++ b/test/integration/signup_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class SignupTest < ActionDispatch::IntegrationTest
+  test "creates the business and its admin, unverified, and returns both" do
+    post "/api/v1/account/create", params: signup_params, as: :json
+
+    assert_response :created
+    account = json.fetch("account")
+    user = json.fetch("user")
+
+    assert_kind_of Integer, account["id"]
+    assert_equal "Acme", account["name"]
+    assert_equal "acme", account["subdomain"]
+    assert account["created_at"].present?
+    assert account["updated_at"].present?
+
+    assert_kind_of Integer, user["id"]
+    assert_equal account["id"], user["account_id"]
+    assert_equal "Jo", user["name"]
+    assert_equal "jo@acme.test", user["email"]
+    assert_equal "admin", user["role"]
+    assert_equal false, user["verified"]
+    assert user["created_at"].present?
+    assert user["updated_at"].present?
+  end
+
+  test "never returns the password or its digest" do
+    post "/api/v1/account/create", params: signup_params, as: :json
+
+    assert_response :created
+    refute_includes response.body, PASSWORD
+    refute_includes response.body, "password"
+  end
+
+  test "emails a verification link to the frontend, from the configured sender" do
+    post "/api/v1/account/create", params: signup_params, as: :json
+    assert_response :created
+
+    mail = latest_mail("jo@acme.test")
+    assert_equal ["support@example.test"], mail.from
+    assert_match "Verify your email", mail.subject
+
+    token = link_token(to: "jo@acme.test", path: "/verify-email")
+    assert_match(/\A[A-Za-z0-9_-]{43}\z/, token)
+    assert_includes mail.body.decoded, "http://localhost:3001/verify-email?account=acme&token=#{token}"
+  end
+
+  test "rejects a subdomain that is already taken, case-insensitively" do
+    signup!(subdomain: "acme")
+
+    post "/api/v1/account/create", params: signup_params(subdomain: "ACME", email: "other@acme.test"), as: :json
+
+    assert_response :unprocessable_content
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "details", "account", "subdomain").present?
+  end
+
+  test "rejects reserved and malformed subdomains" do
+    %w[www api bad_name -lead trail- has.dot].each do |subdomain|
+      post "/api/v1/account/create", params: signup_params(subdomain: subdomain), as: :json
+      assert_response :unprocessable_content, "expected #{subdomain.inspect} to be rejected"
+    end
+  end
+
+  test "rejects a short password, and keeps no account" do
+    assert_no_difference -> { Account.count } do
+      post "/api/v1/account/create", params: signup_params(password: "short"), as: :json
+    end
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "admin", "password").present?
+  end
+
+  test "requires the admin object" do
+    post "/api/v1/account/create", params: { account: { name: "Acme", subdomain: "acme" } }, as: :json
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "a non-object envelope is a 400, not a server error" do
+    post "/api/v1/account/create", params: { account: "acme" }, as: :json
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+
+    post "/api/v1/account/create", params: { account: { name: "Acme", subdomain: "acme", admin: "jo" } }, as: :json
+    assert_response :bad_request
+  end
+
+  test "the same email can register separate businesses" do
+    signup!(subdomain: "acme", email: "jo@shared.test")
+    signup!(subdomain: "globex", name: "Globex", email: "jo@shared.test")
+
+    assert_equal 2, User.where(email: "jo@shared.test").count
+    assert_equal 2, Account.count
+  end
+
+  test "a business cannot have the same email twice" do
+    signup!(subdomain: "acme", email: "jo@acme.test")
+    account = Account.find_by!(subdomain: "acme")
+
+    duplicate = account.users.build(name: "Other", email: "JO@acme.test", password: PASSWORD, role: "agent")
+    refute duplicate.valid?
+    assert duplicate.errors[:email].present?
+  end
+end
diff --git a/test/integration/tenancy_test.rb b/test/integration/tenancy_test.rb
