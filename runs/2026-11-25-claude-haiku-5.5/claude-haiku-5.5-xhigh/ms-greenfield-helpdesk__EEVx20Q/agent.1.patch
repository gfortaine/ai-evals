+    class PasswordsController < ApplicationController
+      before_action :authenticate_session!
+      before_action :require_active_account!
+
+      # PUT /api/v1/me/password
+      # { password_change: { current_password, password } }
+      def update
+        change = require_envelope(:password_change).permit(:current_password, :password)
+        return render_error(422, "invalid_current_password", "Current password is incorrect.") unless @current_user.authenticate(change[:current_password].to_s)
+
+        # Also signs out every session, including this one.
+        @current_user.change_password!(change[:password].to_s)
+        render json: { message: "Password changed. Every session was signed out; sign in again." }
+      end
+    end
+  end
+end
