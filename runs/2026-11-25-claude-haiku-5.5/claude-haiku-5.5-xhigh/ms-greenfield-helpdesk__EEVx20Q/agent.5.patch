+# Requests opened by email. An email request has a private reply address, so a customer's
+# next email comes back to the same request.
+class AddEmailOriginToRequests < ActiveRecord::Migration[8.1]
+  def change
+    # "portal" for requests opened in the app, "email" for requests opened by mail.
+    add_column :requests, :origin, :string, null: false, default: "portal"
+    add_check_constraint :requests, "origin IN ('portal', 'email')", name: "requests_origin_known"
+
+    # The Message-ID of the email that opened the request. Outgoing replies refer back to it.
+    add_column :requests, :origin_message_id, :string
+
+    # The part of the private reply address (reply+TOKEN@support domain) that finds the request.
+    add_column :requests, :reply_token, :string
+    add_index :requests, :reply_token, unique: true
+  end
+end
