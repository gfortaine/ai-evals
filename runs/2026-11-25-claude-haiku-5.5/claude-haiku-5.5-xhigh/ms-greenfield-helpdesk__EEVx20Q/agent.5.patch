new file mode 100644
index 0000000..67da9b1
--- /dev/null
+++ b/db/migrate/20261123070004_change_action_mailbox_uniqueness.rb
@@ -0,0 +1,24 @@
+# Action Mailbox makes (message_id, message_checksum) unique for every delivery. A failed or
+# ignored delivery would then block its own retry, and the retry would be dropped as a duplicate.
+#
+# Uniqueness now applies only to deliveries that were actually processed. A Message-ID is
+# handled at most once, and a delivery that was rejected does not stop a later valid one.
+class ChangeActionMailboxUniqueness < ActiveRecord::Migration[8.1]
+  # ActionMailbox::InboundEmail's "delivered" status, stored as an integer enum.
+  DELIVERED = 2
+
+  def up
+    remove_index :action_mailbox_inbound_emails, name: "index_action_mailbox_inbound_emails_uniqueness"
+    add_index :action_mailbox_inbound_emails, :message_id,
+              unique: true,
+              where: "status = #{DELIVERED}",
+              name: "index_action_mailbox_inbound_emails_on_delivered_message_id"
+  end
+
+  def down
+    remove_index :action_mailbox_inbound_emails, name: "index_action_mailbox_inbound_emails_on_delivered_message_id"
+    add_index :action_mailbox_inbound_emails, [:message_id, :message_checksum],
+              unique: true,
+              name: "index_action_mailbox_inbound_emails_uniqueness"
+  end
+end
