+      # POST /api/v1/tickets/:id/merge
+      # { merge: { target_id: 57, source_comment: { body, public }, target_comment: { body, public } } }
+      # Closes this ticket as a duplicate of the target, and returns both. Each note is private unless
+      # `public` is true, and a missing body gets default wording.
+      def merge
+        attrs = require_envelope(:merge)
+
+        target = merge_target(attrs[:target_id])
+        return if performed?
+
+        source_note = merge_note(attrs, :source_comment)
+        return if performed?
+
+        target_note = merge_note(attrs, :target_comment)
+        return if performed?
+
+        source, survivor = @ticket.merge_into!(target, author: @current_user,
+                                                       source_note: source_note, target_note: target_note)
+        render json: { source: source.as_ticket_api_json, target: survivor.as_ticket_api_json }
+      end
+
       private
 
+      # The ticket that stays open. It must be a ticket ID in this business. Other checks, such as the
+      # same customer, are made by the model under the lock.
+      def merge_target(value)
+        target_id = parse_optional_id(value)
+        return render_validation(:target_id, "can't be blank") if target_id.nil?
+        return render_validation(:target_id, "must be a whole number ticket ID") if target_id == INVALID_ID
+
+        target = @account.requests.includes(:requester, :assignee, :group).find_by(id: target_id)
+        return render_validation(:target_id, "must be a ticket in this business") unless target
+
+        target
+      end
+
+      # One merge note as { body:, public: }. A missing body is nil, which gets default wording. A
+      # missing `public` means private. Anything other than text, or true or false, is refused.
+      def merge_note(attrs, key)
+        return { body: nil, public: false } unless attrs.key?(key)
+
+        note = require_envelope(key, attrs)
+        body = note[:body]
+        return render_validation(:body, "must be text", within: key) unless body.nil? || body.is_a?(String)
+
+        public_flag = note[:public].nil? ? false : parse_boolean(note[:public])
+        return render_validation(:public, "must be true or false", within: key) if public_flag.nil?
+
+        { body: body, public: public_flag }
+      end
+
+      # A 422 for one field of the merge, named as the API user sent it, e.g. "target_id can't be blank".
+      def render_validation(name, reason, within: nil)
+        label = within ? "#{within}.#{name}" : name.to_s
+        render_error(422, "validation_failed", "#{label} #{reason}.", details: { name => [reason] })
+      end
+
       def load_ticket
