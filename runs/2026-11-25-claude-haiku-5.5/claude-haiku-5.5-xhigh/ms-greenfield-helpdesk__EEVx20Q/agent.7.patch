+++ b/db/migrate/20261123090001_add_merged_into_to_requests.rb
@@ -0,0 +1,36 @@
+# A duplicate merged into another request is closed and points at the request it was merged into.
+# Unmerged requests have a NULL pointer. Only a merge closes a request, so a pointer is only
+# allowed on a closed one.
+class AddMergedIntoToRequests < ActiveRecord::Migration[8.1]
+  OPEN_STATUSES = %w[open pending solved].freeze
+
+  def up
+    add_reference :requests, :merged_into,
+                  foreign_key: { to_table: :requests, on_delete: :nullify }, index: true
+
+    replace_status_check(%w[open pending solved closed])
+
+    add_check_constraint :requests, "merged_into_id IS NULL OR status::text = 'closed'::text",
+                         name: "requests_merged_only_when_closed"
+    add_check_constraint :requests, "merged_into_id IS NULL OR merged_into_id <> id",
+                         name: "requests_not_merged_into_itself"
+  end
+
+  # Fails if any request is closed, since the older status list cannot hold it.
+  def down
+    remove_check_constraint :requests, name: "requests_not_merged_into_itself"
+    remove_check_constraint :requests, name: "requests_merged_only_when_closed"
+
+    replace_status_check(OPEN_STATUSES)
+
+    remove_reference :requests, :merged_into, foreign_key: { to_table: :requests }, index: true
+  end
+
+  private
+
+  def replace_status_check(statuses)
+    remove_check_constraint :requests, name: "requests_status_known"
+    list = statuses.map { |status| "'#{status}'::character varying" }.join(", ")
+    add_check_constraint :requests, "status::text = ANY (ARRAY[#{list}]::text[])", name: "requests_status_known"
+  end
+end
