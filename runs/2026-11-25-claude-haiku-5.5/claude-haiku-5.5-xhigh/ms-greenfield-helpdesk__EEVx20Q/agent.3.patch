diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
new file mode 100644
index 0000000..f8fb68d
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,23 @@
+module Api
+  module V1
+    # The invitee sets a name and password. The account is created with the invited role
+    # and a verified email, so the invitee can sign in without another verification email.
+    class InvitationAcceptancesController < ApplicationController
+      include InvitationToken
+
+      before_action -> { load_invitation_from_token!(:invitation_acceptance) }
+
+      # POST /api/v1/invitation_acceptances
+      # { invitation_acceptance: { token, name, password } }
+      def create
+        attrs = require_envelope(:invitation_acceptance).permit(:name, :password)
+
+        user = @invitation.accept!(name: attrs[:name].to_s, password: attrs[:password].to_s)
+        render json: { user: user.as_api_json, account: @account.as_api_json }, status: :created
+      rescue ActiveRecord::RecordNotUnique
+        # Lost a race with another signup for the same email.
+        render_error(422, "validation_failed", "That email already has an account with this business.")
+      end
+    end
+  end
+end
