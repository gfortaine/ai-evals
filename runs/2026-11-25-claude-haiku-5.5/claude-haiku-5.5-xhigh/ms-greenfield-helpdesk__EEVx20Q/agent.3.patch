+
+      # The acceptance screen reads and accepts an invitation with its token. No sign-in needed.
+      post "invitation_previews", to: "invitation_previews#create"
+      post "invitation_acceptances", to: "invitation_acceptances#create"
+
+      # Admins manage people.
+      get "users", to: "users#index"
+      get "users/:id", to: "users#show"
+      patch "users/:id", to: "users#update"
+
+      # Active staff, for assignment controls.
+      get "staff", to: "staff#index"
+
       # A customer's own requests.
       get "requests", to: "requests#index"
       post "requests", to: "requests#create"
