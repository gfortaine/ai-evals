@@ -0,0 +1,20 @@
+class AddOwnerToAccounts < ActiveRecord::Migration[8.1]
+  def up
+    # The admin who registered the business. Only the owner can cancel, reactivate, or
+    # sign in to a cancelled business. Other admins are invited later.
+    add_reference :accounts, :owner, foreign_key: { to_table: :users, on_delete: :nullify }, null: true
+
+    # Existing businesses had one admin, the registrant, so that admin becomes the owner.
+    execute <<~SQL
+      UPDATE accounts
+      SET owner_id = (
+        SELECT MIN(users.id) FROM users
+        WHERE users.account_id = accounts.id AND users.role = 'admin'
+      )
+    SQL
+  end
+
+  def down
+    remove_reference :accounts, :owner, foreign_key: { to_table: :users }
+  end
+end
diff --git a/db/migrate/20261123060003_create_invitations.rb b/db/migrate/20261123060003_create_invitations.rb
new file mode 100644
index 0000000..326af49
--- /dev/null
+++ b/db/migrate/20261123060003_create_invitations.rb
@@ -0,0 +1,25 @@
+class CreateInvitations < ActiveRecord::Migration[8.1]
+  def change
+    create_table :invitations do |t|
+      # Deleting a business removes its invitations. Deleting the inviter keeps the invitation.
+      t.references :account, null: false, foreign_key: { on_delete: :cascade }
+      t.references :invited_by, null: true, foreign_key: { to_table: :users, on_delete: :nullify }
+      t.string :email, null: false
+      t.string :role, null: false
+      # SHA-256 of the emailed token. The raw token is never stored.
+      t.string :token_digest, null: false
+      t.datetime :expires_at, null: false
+      # Status is derived from these: accepted, revoked, expired, or pending.
+      t.datetime :accepted_at
+      t.datetime :revoked_at
+
+      t.timestamps
+    end
+
+    add_index :invitations, :token_digest, unique: true
+    add_index :invitations, [:account_id, :email]
+
+    add_check_constraint :invitations, "role IN ('admin', 'agent')", name: "invitations_role_known"
+    add_check_constraint :invitations, "NOT (accepted_at IS NOT NULL AND revoked_at IS NOT NULL)", name: "invitations_not_accepted_and_revoked"
+  end
+end
