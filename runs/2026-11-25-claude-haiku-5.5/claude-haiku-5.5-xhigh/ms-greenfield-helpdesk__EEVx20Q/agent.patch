diff --git a/app/controllers/api/v1/tickets_controller.rb b/app/controllers/api/v1/tickets_controller.rb
new file mode 100644
index 0000000..52c2a44
--- /dev/null
+++ b/app/controllers/api/v1/tickets_controller.rb
@@ -0,0 +1,136 @@
+module Api
+  module V1
+    # Staff view of every request in the business, as tickets.
+    class TicketsController < ApplicationController
+      include Pagination
+
+      before_action :authenticate_session!
+      before_action :require_active_account!
+      before_action :require_staff!
+      before_action :load_ticket, only: %i[show update comments merge]
+
+      # GET /api/v1/tickets?status=open&assignee_id=unassigned&group_id=20&priority=high&q=receipt
+      # Filters combine. See RequestFilter for the values each one takes.
+      def index
+        scope = RequestFilter.new(params, staff: true).apply(@account.requests.includes(:requester, :assignee, :group))
+        records, paging = paginate(scope, order: :recent_activity)
+        render json: { tickets: records.map(&:as_ticket_api_json), **paging }
+      end
+
+      # GET /api/v1/tickets/:id
+      def show
+        render json: { ticket: @ticket.as_ticket_api_json }
+      end
+
+      # PATCH /api/v1/tickets/:id
+      # { ticket: { comment: { body, public }, status: "open" | "pending" | "solved",
+      #             priority: "normal" | "high", group_id: 20 | null, assignee_id: 12 | null } }
+      def update
+        attrs = require_envelope(:ticket)
+
+        reply = {}
+        if attrs.key?(:comment)
+          comment = require_envelope(:comment, attrs).permit(:body, :public)
+          reply[:body] = comment[:body].to_s
+          # Replies are public unless staff mark them as private notes.
+          reply[:public] = comment[:public] if comment.key?(:public)
+        end
+        reply[:status] = attrs.permit(:status)[:status].to_s if attrs.key?(:status)
+        # A null priority becomes "", which fails validation, so a priority cannot be cleared.
+        reply[:priority] = attrs.permit(:priority)[:priority].to_s if attrs.key?(:priority)
+        if attrs.key?(:group_id)
+          group_id = parse_optional_id(attrs[:group_id])
+          if group_id == INVALID_ID
+            return render_invalid_id(:group_id, "group_id must be a group ID, or null to remove the group.")
+          end
+
+          reply[:group_id] = group_id
+        end
+        if attrs.key?(:assignee_id)
+          assignee_id = parse_optional_id(attrs[:assignee_id])
+          if assignee_id == INVALID_ID
+            return render_invalid_id(:assignee_id, "assignee_id must be a user ID, or null to unassign.")
+          end
+
+          reply[:assignee_id] = assignee_id
+        end
+
+        @ticket.staff_reply!(author: @current_user, **reply)
+        render json: { ticket: @ticket.as_ticket_api_json }
+      end
+
+      # GET /api/v1/tickets/:id/comments
+      # Staff see every comment, including private notes, oldest first.
+      def comments
+        records, paging = paginate(@ticket.comments.includes(:author), order: :created_at)
+        render json: { comments: records.map(&:as_api_json), **paging }
+      end
+
+      # POST /api/v1/tickets/:id/merge
+      # { merge: { target_id: 57, source_comment: { body, public }, target_comment: { body, public } } }
+      # Closes this ticket as a duplicate of the target, and returns both. Each note is private unless
+      # `public` is true, and a missing body gets default wording.
+      def merge
+        attrs = require_envelope(:merge)
+
+        target = merge_target(attrs[:target_id])
+        return if performed?
+
+        source_note = merge_note(attrs, :source_comment)
+        return if performed?
+
+        target_note = merge_note(attrs, :target_comment)
+        return if performed?
+
+        source, survivor = @ticket.merge_into!(target, author: @current_user,
+                                                       source_note: source_note, target_note: target_note)
+        render json: { source: source.as_ticket_api_json, target: survivor.as_ticket_api_json }
+      end
+
+      private
+
+      # The ticket that stays open. It must be a ticket ID in this business. Other checks, such as the
+      # same customer, are made by the model under the lock.
+      def merge_target(value)
+        target_id = parse_optional_id(value)
+        return render_validation(:target_id, "can't be blank") if target_id.nil?
+        return render_validation(:target_id, "must be a whole number ticket ID") if target_id == INVALID_ID
+
+        target = @account.requests.includes(:requester, :assignee, :group).find_by(id: target_id)
+        return render_validation(:target_id, "must be a ticket in this business") unless target
+
+        target
+      end
+
+      # One merge note as { body:, public: }. A missing body is nil, which gets default wording. A
+      # missing `public` means private. Anything other than text, or true or false, is refused.
+      def merge_note(attrs, key)
+        return { body: nil, public: false } unless attrs.key?(key)
+
+        note = require_envelope(key, attrs)
+        body = note[:body]
+        return render_validation(:body, "must be text", within: key) unless body.nil? || body.is_a?(String)
+
+        public_flag = note[:public].nil? ? false : parse_boolean(note[:public])
+        return render_validation(:public, "must be true or false", within: key) if public_flag.nil?
+
+        { body: body, public: public_flag }
+      end
+
+      # A 422 for one field of the merge, named as the API user sent it, e.g. "target_id can't be blank".
+      def render_validation(name, reason, within: nil)
+        label = within ? "#{within}.#{name}" : name.to_s
+        render_error(422, "validation_failed", "#{label} #{reason}.", details: { name => [reason] })
+      end
+
+      def load_ticket
+        @ticket = @account.requests.includes(:requester, :assignee, :group).find_by(id: params[:id])
+        render_error(404, "not_found", "No ticket has that ID.") unless @ticket
+      end
+
+      def render_invalid_id(name, message)
+        render_error(422, "validation_failed", message, details: { name => ["must be a whole number ID, or null"] })
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/users_controller.rb b/app/controllers/api/v1/users_controller.rb
new file mode 100644
index 0000000..8b25d8d
--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,70 @@
+module Api
+  module V1
+    # Admins manage the people in the business: find them, and suspend or restore them.
+    class UsersController < ApplicationController
+      include Pagination
+
+      before_action :authenticate_session!
+      before_action :require_active_account!
+      before_action :require_admin!
+      before_action :load_user, only: %i[show update]
+
+      # GET /api/v1/users?role=agent&suspended=true
+      # Oldest first.
+      def index
+        scope = @account.users
+
+        if params[:role].present?
+          unless User::ROLES.include?(params[:role])
+            return render_error(400, "invalid_filter", "role must be one of #{User::ROLES.join(', ')}.")
+          end
+
+          scope = scope.where(role: params[:role])
+        end
+
+        if params[:suspended].present?
+          suspended = parse_boolean(params[:suspended])
+          return render_error(400, "invalid_filter", "suspended must be true or false.") if suspended.nil?
+
+          scope = scope.where(suspended: suspended)
+        end
+
+        records, paging = paginate(scope, order: :id)
+        render json: { users: records.map(&:as_api_json), **paging }
+      end
+
+      # GET /api/v1/users/:id
+      def show
+        render json: { user: @user.as_api_json }
+      end
+
+      # PATCH /api/v1/users/:id
+      # { user: { suspended: true | false } }
+      # Suspending signs the user out and unassigns their tickets. The last active admin
+      # cannot be suspended.
+      def update
+        attrs = require_envelope(:user)
+        unless attrs.key?(:suspended)
+          return render_error(422, "validation_failed", "Only suspended can be changed here.",
+                              details: { suspended: ["is required"] })
+        end
+
+        suspended = parse_boolean(attrs[:suspended])
+        if suspended.nil?
+          return render_error(422, "validation_failed", "suspended must be true or false.",
+                              details: { suspended: ["must be true or false"] })
+        end
+
+        suspended ? @user.suspend! : @user.unsuspend!
+        render json: { user: @user.as_api_json }
+      end
+
+      private
+
+      def load_user
+        @user = @account.users.find_by(id: params[:id])
+        render_error(404, "not_found", "No user has that ID.") unless @user
+      end
+    end
+  end
+end
diff --git a/app/controllers/application_controller.rb b/app/controllers/application_controller.rb
new file mode 100644
index 0000000..97aa72f
--- /dev/null
+++ b/app/controllers/application_controller.rb
@@ -0,0 +1,71 @@
+class ApplicationController < ActionController::API
+  include AccountContext
+  include SessionAuthentication
+
+  # Marks an ID value that is not a whole number, as distinct from nil (no ID).
+  INVALID_ID = Object.new.freeze
+
+  rescue_from ActiveRecord::RecordInvalid, with: :render_record_invalid
+  rescue_from ActionController::ParameterMissing, with: :render_parameter_missing
+  rescue_from ActionDispatch::Http::Parameters::ParseError, with: :render_invalid_json
+  rescue_from StateError, with: :render_state_error
+  rescue_from RequestFilter::Invalid, with: :render_invalid_filter
+
+  private
+
+  # A record ID from a JSON value or a form value: an Integer, nil for a blank or null value, or
+  # INVALID_ID. "12abc" and "1.5" are refused rather than read as an ID, so they cannot quietly
+  # point at another record.
+  def parse_optional_id(value)
+    return nil if value.nil? || value.to_s.strip.empty?
+
+    Integer(value.to_s.strip, 10, exception: false) || INVALID_ID
+  end
+
+  # Strict true/false for flags such as suspended=true. Unlike ActiveModel's casting, any
+  # other value is nil, not true.
+  def parse_boolean(value)
+    case value
+    when true, "true" then true
+    when false, "false" then false
+    end
+  end
+
+  # The "envelope" object for a request, e.g. params[:session] in {"session": {...}}.
+  # A missing or non-object value is a 400, not a server error. Pass `parent` for an
+  # object nested in another envelope, e.g. the comment in {"ticket": {"comment": {...}}}.
+  def require_envelope(key, parent = params)
+    value = parent.require(key)
+    raise ActionController::ParameterMissing, key unless value.is_a?(ActionController::Parameters)
+
+    value
+  end
+
+  # Every error uses the same shape: { error: { code, message, details? } }.
+  def render_error(status, code, message, details: nil)
+    body = { code: code, message: message }
+    body[:details] = details if details.present?
+    render json: { error: body }, status: status
+  end
+
+  def render_record_invalid(exception)
+    record = exception.record
+    render_error(422, "validation_failed", record.errors.full_messages.to_sentence, details: record.errors.to_hash)
+  end
+
+  def render_parameter_missing(exception)
+    render_error(400, "parameter_missing", exception.message)
+  end
+
+  def render_invalid_json(_exception)
+    render_error(400, "invalid_json", "The request body must be valid JSON.")
+  end
+
+  def render_state_error(exception)
+    render_error(422, exception.code, exception.message)
+  end
+
+  def render_invalid_filter(exception)
+    render_error(400, "invalid_filter", exception.message)
+  end
+end
diff --git a/app/controllers/concerns/account_context.rb b/app/controllers/concerns/account_context.rb
new file mode 100644
index 0000000..533288b
--- /dev/null
+++ b/app/controllers/concerns/account_context.rb
@@ -0,0 +1,31 @@
+# Resolves the business a request is about from the X-Helpdesk-Account header.
+module AccountContext
+  extend ActiveSupport::Concern
+
+  private
+
+  def requested_subdomain
+    request.headers["X-Helpdesk-Account"].to_s.strip.downcase.presence
+  end
+
+  # For public endpoints that need to know the business (sign-in, portal, ...).
+  def load_account_from_header!
+    subdomain = requested_subdomain
+    return render_error(400, "account_required", "Send the X-Helpdesk-Account header with the business subdomain.") if subdomain.nil?
+
+    @account = Account.find_by(subdomain: subdomain)
+    render_error(404, "account_not_found", "No business has that subdomain.") unless @account
+  end
+
+  # True when no account header was sent, or the header names this account.
+  def requested_account_matches?(account)
+    requested_subdomain.nil? || requested_subdomain == account.subdomain
+  end
+
+  # Ordinary business access stops once the account is cancelled.
+  def require_active_account!
+    return unless @account.cancelled?
+
+    render_error(403, "account_cancelled", "This account has been cancelled.")
+  end
+end
diff --git a/app/controllers/concerns/invitation_token.rb b/app/controllers/concerns/invitation_token.rb
new file mode 100644
index 0000000..9e1592b
--- /dev/null
+++ b/app/controllers/concerns/invitation_token.rb
@@ -0,0 +1,22 @@
+# Lets the acceptance screen work from the invitation's token alone, with no sign-in. The
+# token is the credential, so a token for another business is reported like an unknown one.
+module InvitationToken
+  extend ActiveSupport::Concern
+
+  private
+
+  # Loads @invitation and @account from the token in `envelope`, e.g. the body of
+  # {"invitation_preview": {"token": ...}}. Renders an error and stops the request if the
+  # token is unknown or the business is cancelled.
+  def load_invitation_from_token!(envelope)
+    token = require_envelope(envelope).require(:token)
+    invitation = Invitation.find_by_token(token)
+    invitation = nil unless invitation && requested_account_matches?(invitation.account)
+
+    return render_error(422, "invalid_token", "This invitation link is invalid.") unless invitation
+
+    @invitation = invitation
+    @account = invitation.account
+    require_active_account!
+  end
+end
diff --git a/app/controllers/concerns/pagination.rb b/app/controllers/concerns/pagination.rb
new file mode 100644
index 0000000..268795c
--- /dev/null
+++ b/app/controllers/concerns/pagination.rb
@@ -0,0 +1,126 @@
+# List pagination, in two modes. Each list has one order (see CursorPage::ORDERS), and both modes use it.
+#
+# Page numbers, the original API: ?page=2&per_page=25. The response carries count, page, per_page,
+# next_page and previous_page. Counting the whole list, and reaching a deep page, both get slower
+# as the list grows.
+#
+# Cursors: ?page[size]=25 for the first page, then ?page[after]=CURSOR or ?page[before]=CURSOR.
+# The response carries meta {has_more, after_cursor, before_cursor} and links {next, prev}. A page
+# costs the same wherever it is, and no count is taken.
+#
+# A paging value that is not valid is a 400 invalid_pagination. The two modes do not mix.
+module Pagination
+  extend ActiveSupport::Concern
+
+  DEFAULT_PER_PAGE = 25
+  MAX_PER_PAGE = 100
+  # What may appear inside page[...] in cursor mode.
+  CURSOR_OPTIONS = %w[size after before].freeze
+
+  # A page number or page size that is not usable, or a cursor-mode request that is not allowed.
+  class InvalidPage < StandardError; end
+
+  included do
+    rescue_from InvalidPage, CursorPage::InvalidCursor do |error|
+      render_error(400, "invalid_pagination", error.message)
+    end
+  end
+
+  private
+
+  # Returns [records, paging] for one page of the scope, in the order named by `order`. `paging` is
+  # the set of fields that go next to the records in the response.
+  def paginate(scope, order:)
+    cursor_mode? ? paginate_by_cursor(scope, order) : paginate_by_number(scope, order)
+  end
+
+  # Cursor mode is the page[...] form. A plain page=2 is page-number mode.
+  def cursor_mode?
+    params[:page].is_a?(ActionController::Parameters)
+  end
+
+  def paginate_by_number(scope, order)
+    page = page_number(:page, default: 1)
+    per_page = [page_number(:per_page, default: DEFAULT_PER_PAGE), MAX_PER_PAGE].min
+
+    count = scope.count
+    offset = (page - 1) * per_page
+    # Skip the query for pages past the end. This also keeps huge page numbers out of SQL.
+    records = offset < count ? ordered(scope, order).offset(offset).limit(per_page).to_a : []
+
+    paging = {
+      count: count,
+      page: page,
+      per_page: per_page,
+      next_page: page * per_page < count ? page + 1 : nil,
+      previous_page: page > 1 ? page - 1 : nil
+    }
+    [records, paging]
+  end
+
+  def paginate_by_cursor(scope, order)
+    if params[:per_page].present?
+      raise InvalidPage, "per_page can't be combined with page[...]. Use page[size] to choose the page size."
+    end
+
+    unknown = params[:page].keys - CURSOR_OPTIONS
+    if unknown.any?
+      raise InvalidPage, "page[#{unknown.first}] is not a paging option. Use page[size], page[after] or page[before]."
+    end
+
+    after = cursor_option(:after)
+    before = cursor_option(:before)
+    raise InvalidPage, "Send page[after] or page[before], not both." if after && before
+
+    size = cursor_page_size
+    result = CursorPage.new(scope, order: order, size: size).fetch(after: after, before: before)
+
+    paging = {
+      meta: { has_more: result.has_more, after_cursor: result.after_cursor, before_cursor: result.before_cursor },
+      links: {
+        next: result.more_after ? cursor_link("after", result.after_cursor, size) : nil,
+        prev: result.more_before ? cursor_link("before", result.before_cursor, size) : nil
+      }
+    }
+    [result.records, paging]
+  end
+
+  # A link to the same list, with the same filters, at the cursor and page size.
+  def cursor_link(name, cursor, size)
+    query = request.query_parameters.merge("page" => { "size" => size.to_s, name => cursor })
+    "#{request.base_url}#{request.path}?#{query.to_query}"
+  end
+
+  def cursor_option(name)
+    raw = params[:page][name]
+    return nil if raw.blank?
+    raise InvalidPage, "page[#{name}] must be a cursor from a previous page." unless raw.is_a?(String)
+
+    raw
+  end
+
+  def cursor_page_size
+    raw = params[:page][:size]
+    return DEFAULT_PER_PAGE if raw.blank?
+
+    [whole_number(raw, "page[size]"), MAX_PER_PAGE].min
+  end
+
+  def page_number(name, default:)
+    raw = params[name]
+    return default if raw.blank?
+
+    whole_number(raw, name.to_s)
+  end
+
+  def whole_number(raw, name)
+    value = raw.is_a?(String) ? Integer(raw, 10, exception: false) : nil
+    raise InvalidPage, "#{name} must be a whole number, 1 or more." if value.nil? || value < 1
+
+    value
+  end
+
+  def ordered(scope, order)
+    scope.reorder(CursorPage::ORDERS.fetch(order).to_h)
+  end
+end
diff --git a/app/controllers/concerns/session_authentication.rb b/app/controllers/concerns/session_authentication.rb
new file mode 100644
index 0000000..03d7b0e
--- /dev/null
+++ b/app/controllers/concerns/session_authentication.rb
@@ -0,0 +1,48 @@
+# Authenticates "Authorization: Bearer TOKEN" and sets @current_session,
+# @current_user and @account.
+module SessionAuthentication
+  extend ActiveSupport::Concern
+
+  private
+
+  def authenticate_session!
+    @current_session = Session.lookup(bearer_token)
+    unless @current_session
+      response.headers["WWW-Authenticate"] = 'Bearer realm="helpdesk"'
+      return render_error(401, "unauthorized", "Sign in to continue.")
+    end
+
+    @current_user = @current_session.user
+    @account = @current_user.account
+    return if requested_account_matches?(@account)
+
+    render_error(403, "wrong_account", "This session belongs to a different business.")
+  end
+
+  def bearer_token
+    scheme, token = request.authorization.to_s.split(" ", 2)
+    token.presence if scheme.to_s.casecmp?("Bearer")
+  end
+
+  # Admins manage people and invitations.
+  def require_admin!
+    return if @current_user.admin?
+
+    render_error(403, "forbidden", "Only admins can do that.")
+  end
+
+  # The owner is the admin who registered the business. Only the owner can cancel or
+  # reactivate it.
+  def require_owner!
+    return if @current_user.owner?
+
+    render_error(403, "forbidden", "Only the account owner can do that.")
+  end
+
+  # Staff are the owner and agents. Customers use the portal's request endpoints instead.
+  def require_staff!
+    return if @current_user.staff?
+
+    render_error(403, "forbidden", "Only staff can do that.")
+  end
+end
