diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..635d1a7
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,67 @@
+module Api
+  module V1
+    class AccountsController < ApplicationController
+      before_action :authenticate_session!, except: :create
+      before_action :require_active_account!, only: :cancel
+      before_action :require_owner!, only: %i[cancel reactivate]
+
+      # POST /api/v1/account/create
+      # { account: { name, subdomain, admin: { name, email, password } } }
+      def create
+        account = Account.new(account_params)
+        admin = User.new(admin_params.merge(role: User::ADMIN, account: account))
+
+        unless [account.valid?, admin.valid?].all?
+          details = { account: account.errors.to_hash, admin: admin.errors.to_hash }.reject { |_, errors| errors.empty? }
+          return render_error(422, "validation_failed", "The business could not be created.", details: details)
+        end
+
+        token = nil
+        ActiveRecord::Base.transaction do
+          account.save!
+          admin.save!
+          # The registrant is the owner. Admins invited later are not.
+          account.update!(owner: admin)
+          token = UserToken.issue!(admin, :email_verification)
+        end
+        # Send only after commit, so the link never points at a rolled-back user.
+        UserMailer.email_verification(admin, token).deliver_later
+
+        render json: { account: account.as_api_json, user: admin.as_api_json }, status: :created
+      rescue ActiveRecord::RecordNotUnique
+        # Lost a race with another signup for the same subdomain or email.
+        render_error(422, "validation_failed", "That subdomain or email is already taken.")
+      end
+
+      # GET /api/v1/account
+      def show
+        render json: { account: @account.as_api_json }
+      end
+
+      # POST /api/v1/account/cancel
+      def cancel
+        @account.cancel!
+        render json: { account: @account.as_api_json }
+      end
+
+      # POST /api/v1/account/reactivate
+      def reactivate
+        @account.reactivate!
+        render json: { account: @account.as_api_json }
+      end
+
+      private
+
+      def account_params
+        require_envelope(:account).permit(:name, :subdomain)
+      end
+
+      def admin_params
+        admin = require_envelope(:account).fetch(:admin, nil)
+        raise ActionController::ParameterMissing, :admin unless admin.is_a?(ActionController::Parameters)
+
+        admin.permit(:name, :email, :password).to_h
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
new file mode 100644
index 0000000..d793ab3
--- /dev/null
+++ b/app/controllers/api/v1/email_verifications_controller.rb
@@ -0,0 +1,35 @@
+module Api
+  module V1
+    class EmailVerificationsController < ApplicationController
+      before_action :load_account_from_header!, only: :create
+
+      # POST /api/v1/email_verifications  { email_verification: { email } }
+      def create
+        email = require_envelope(:email_verification).require(:email)
+        user = @account.users.find_by(email: email.to_s)
+
+        # Same answer whether or not the email exists, so this does not reveal accounts.
+        if user && !user.verified?
+          token = UserToken.issue!(user, :email_verification)
+          UserMailer.email_verification(user, token).deliver_later
+        end
+
+        render json: { message: "If that email needs verification, a new link is on its way." }, status: :accepted
+      end
+
+      # POST /api/v1/email_verifications/confirm  { email_verification: { token } }
+      def confirm
+        token = require_envelope(:email_verification).require(:token)
+        record = UserToken.redeem(:email_verification, token)
+        user = record&.user
+        return render_error(422, "invalid_token", "This verification link is invalid or has expired.") if user.nil? || !requested_account_matches?(user.account)
+
+        UserToken.transaction do
+          user.verify!
+          record.destroy!
+        end
+        render json: { message: "Email verified. You can sign in now.", user: user.as_api_json }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/group_memberships_controller.rb b/app/controllers/api/v1/group_memberships_controller.rb
new file mode 100644
index 0000000..cea3567
--- /dev/null
+++ b/app/controllers/api/v1/group_memberships_controller.rb
@@ -0,0 +1,92 @@
+module Api
+  module V1
+    # Which staff belong to which groups. Staff can browse memberships. Admins add and remove
+    # them, and choose each staff member's default group.
+    class GroupMembershipsController < ApplicationController
+      include Pagination
+
+      before_action :authenticate_session!
+      before_action :require_active_account!
+      before_action :require_staff!
+      before_action :require_admin!, only: %i[create make_default destroy]
+      before_action :load_membership, only: %i[show make_default destroy]
+
+      # GET /api/v1/group_memberships?group_id=20&user_id=12
+      # Oldest first. Both filters are optional and combine.
+      def index
+        scope = @account.group_memberships.includes(:group, :user)
+        scope = scope.where(group_id: filter_id(:group_id)) if params[:group_id].present?
+        scope = scope.where(user_id: filter_id(:user_id)) if params[:user_id].present?
+
+        records, paging = paginate(scope, order: :id)
+        render json: { group_memberships: records.map(&:as_api_json), **paging }
+      end
+
+      # GET /api/v1/group_memberships/:id
+      def show
+        render json: { group_membership: @membership.as_api_json }
+      end
+
+      # POST /api/v1/group_memberships
+      # { group_membership: { group_id: 20, user_id: 12, default: true } }
+      # The first group a staff member joins is their default, whatever default says.
+      def create
+        attrs = require_envelope(:group_membership)
+        default = attrs.key?(:default) ? parse_boolean(attrs[:default]) : false
+        if default.nil?
+          return render_error(422, "validation_failed", "default must be true or false.",
+                              details: { default: ["must be true or false"] })
+        end
+
+        group = @account.groups.find_by(id: body_id(attrs[:group_id]))
+        user = @account.users.find_by(id: body_id(attrs[:user_id]))
+        if group.nil? || user.nil?
+          details = {}
+          details[:group] = ["must be a group in this business"] if group.nil?
+          details[:user] = ["must be a user in this business"] if user.nil?
+          return render_error(422, "validation_failed", "Choose a group and a user in this business.", details: details)
+        end
+
+        membership = GroupMembership.add!(group: group, user: user, default: default)
+        render json: { group_membership: membership.as_api_json }, status: :created
+      end
+
+      # PUT /api/v1/group_memberships/:id/make_default
+      def make_default
+        @membership.make_default!
+        render json: { group_membership: @membership.as_api_json }
+      end
+
+      # DELETE /api/v1/group_memberships/:id
+      # Their tickets in this group are unassigned, and the tickets stay in the group.
+      def destroy
+        @membership.remove!
+        render json: { group_membership: @membership.as_api_json }
+      end
+
+      private
+
+      def load_membership
+        @membership = @account.group_memberships.includes(:group, :user).find_by(id: params[:id])
+        render_error(404, "not_found", "No group membership has that ID.") unless @membership
+      end
+
+      # A filter value must be a whole number ID. Anything else is a 400 invalid_filter, rather than
+      # a list that looks filtered but is not.
+      def filter_id(name)
+        value = params[name]
+        return value.to_i if value.is_a?(String) && value.match?(RequestFilter::ID_FORMAT) && value.to_i.positive?
+
+        description = name == :group_id ? "a group ID" : "a user ID"
+        raise RequestFilter::Invalid, "#{name} must be #{description}."
+      end
+
+      # A group or user ID in a body. A value that is not a whole number becomes nil, which matches
+      # no record, so it is refused like any ID outside the business.
+      def body_id(value)
+        id = parse_optional_id(value)
+        id.is_a?(Integer) ? id : nil
+      end
+    end
+  end
+end
