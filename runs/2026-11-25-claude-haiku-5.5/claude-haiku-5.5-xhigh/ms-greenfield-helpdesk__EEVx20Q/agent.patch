diff --git a/app/models/automated_mail.rb b/app/models/automated_mail.rb
new file mode 100644
index 0000000..f14a3cc
--- /dev/null
+++ b/app/models/automated_mail.rb
@@ -0,0 +1,55 @@
+# Mail that a machine sent: auto-replies, bounces, delivery reports and mailing-list posts.
+# Support does not act on it, so two machines cannot answer each other.
+class AutomatedMail
+  # Other than "no", Auto-Submitted marks a machine-generated message (RFC 3834).
+  AUTO_RESPONSE_HEADERS = %w[X-Autoreply X-Autorespond X-Auto-Response-Suppress].freeze
+  BULK_PRECEDENCE = %w[bulk list junk auto_reply].freeze
+  REPORT_TYPES = %w[multipart/report message/delivery-status message/disposition-notification].freeze
+  MACHINE_SENDERS = %w[mailer-daemon postmaster noreply no-reply donotreply do-not-reply].freeze
+
+  def initialize(mail)
+    @mail = mail
+  end
+
+  def automated?
+    auto_submitted? || bulk? || list_mail? || auto_response? || null_sender? || report? || machine_sender?
+  end
+
+  private
+
+  def auto_submitted?
+    value = header_value("Auto-Submitted")
+    !value.nil? && value.strip.downcase != "no"
+  end
+
+  def bulk?
+    BULK_PRECEDENCE.include?(header_value("Precedence").to_s.strip.downcase)
+  end
+
+  def list_mail?
+    @mail.header.fields.any? { |field| field.name.downcase.start_with?("list-") }
+  end
+
+  def auto_response?
+    AUTO_RESPONSE_HEADERS.any? { |name| @mail.header[name] }
+  end
+
+  # Bounces are sent from an empty return path, "<>", which Mail reads back as an empty value.
+  def null_sender?
+    field = @mail.header["Return-Path"]
+    !field.nil? && field.value.to_s.strip.empty?
+  end
+
+  def report?
+    REPORT_TYPES.include?(@mail.mime_type.to_s.downcase)
+  end
+
+  def machine_sender?
+    local_part = Array(@mail.from).first.to_s.split("@").first.to_s.downcase
+    MACHINE_SENDERS.include?(local_part)
+  end
+
+  def header_value(name)
+    @mail.header[name]&.value
+  end
+end
diff --git a/app/models/comment.rb b/app/models/comment.rb
new file mode 100644
index 0000000..b53c5cf
--- /dev/null
+++ b/app/models/comment.rb
@@ -0,0 +1,56 @@
+# A message on a request. Customers' comments are always public. Staff can add private
+# notes, which only staff see.
+class Comment < ApplicationRecord
+  BODY_MAX_LENGTH = 10_000
+
+  belongs_to :request, inverse_of: :comments
+  belongs_to :author, class_name: "User", inverse_of: :comments
+
+  validates :body, presence: true, length: { maximum: BODY_MAX_LENGTH }
+  validates :public, inclusion: { in: [true, false] }
+  validate :author_belongs_to_request_account
+
+  # Set on the notes a merge writes. They explain the merge, so they never send email.
+  attr_accessor :merge_note
+
+  # Only public replies are customer-visible activity, so only they move the request's
+  # updated_at. Private notes are internal and leave the customer's view unchanged.
+  after_create :touch_request, if: :public?
+
+  # A staff member's public reply on a request opened by email is emailed to the requester, after
+  # the reply is saved. The requester's own messages are not emailed back to them.
+  after_create_commit :email_requester, if: :staff_reply_to_email_request?
+
+  scope :public_only, -> { where(public: true) }
+  scope :oldest_first, -> { order(created_at: :asc, id: :asc) }
+
+  def as_api_json
+    {
+      id: id,
+      body: body,
+      public: public?,
+      author: { id: author.id, name: author.name },
+      created_at: created_at
+    }
+  end
+
+  private
+
+  def touch_request
+    request.touch
+  end
+
+  def staff_reply_to_email_request?
+    public? && !merge_note && request.email_origin? && author.staff? && author_id != request.requester_id
+  end
+
+  def email_requester
+    TicketMailer.public_reply(self).deliver_later
+  end
+
+  def author_belongs_to_request_account
+    return if author.nil? || request.nil?
+
+    errors.add(:author, "must belong to the same business") unless author.account_id == request.account_id
+  end
+end
