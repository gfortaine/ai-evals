diff --git a/app/controllers/api/v1/registrations_controller.rb b/app/controllers/api/v1/registrations_controller.rb
new file mode 100644
index 0000000..5017183
--- /dev/null
+++ b/app/controllers/api/v1/registrations_controller.rb
@@ -0,0 +1,39 @@
+module Api
+  module V1
+    # Customers sign themselves up for a business's portal. They verify their email, then
+    # use the same sign-in, profile and password flows as everyone else.
+    class RegistrationsController < ApplicationController
+      before_action :load_account_from_header!
+      before_action :require_active_account!
+
+      # POST /api/v1/registrations
+      # { user: { name, email, password } } with X-Helpdesk-Account
+      def create
+        # Only these fields are accepted. Everyone who registers here is a customer.
+        user = @account.users.new(require_envelope(:user).permit(:name, :email, :password).merge(role: User::CUSTOMER))
+
+        token = nil
+        User.transaction do
+          # Same lock as invitations, so an invitation cannot be issued for this email in between.
+          @account.lock!
+          # An email with a pending invitation is reserved for that invitee. The message is
+          # worded so it does not reveal the invitation.
+          if Invitation.pending_for_email?(@account, user.email)
+            user.errors.add(:email, "can't be used to register with this business")
+            raise ActiveRecord::RecordInvalid, user
+          end
+
+          user.save!
+          token = UserToken.issue!(user, :email_verification)
+        end
+        # Send only after commit, so the link never points at a rolled-back user.
+        UserMailer.email_verification(user, token).deliver_later
+
+        render json: { user: user.as_api_json }, status: :created
+      rescue ActiveRecord::RecordNotUnique
+        # Lost a race with another registration for the same email.
+        render_error(422, "validation_failed", "That email is already registered with this business.")
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/requests_controller.rb b/app/controllers/api/v1/requests_controller.rb
new file mode 100644
index 0000000..0dba9fa
--- /dev/null
+++ b/app/controllers/api/v1/requests_controller.rb
@@ -0,0 +1,73 @@
+module Api
+  module V1
+    # A customer's own requests. Staff handle the same records through TicketsController.
+    class RequestsController < ApplicationController
+      include Pagination
+
+      before_action :authenticate_session!
+      before_action :require_active_account!
+      before_action :load_own_request, only: %i[show update comments]
+
+      # GET /api/v1/requests?status=open
+      # Customers can only filter by status. Priority is internal.
+      def index
+        scope = RequestFilter.new(params, staff: false).apply(own_requests)
+        records, paging = paginate(scope, order: :recent_activity)
+        render json: { requests: records.map(&:as_api_json), **paging }
+      end
+
+      # POST /api/v1/requests
+      # { request: { subject, comment: { body } } }
+      def create
+        attrs = require_envelope(:request)
+        comment = require_envelope(:comment, attrs).permit(:body)
+
+        request = Request.submit!(
+          requester: @current_user,
+          subject: attrs.permit(:subject)[:subject],
+          body: comment[:body]
+        )
+        render json: { request: request.as_api_json }, status: :created
+      end
+
+      # GET /api/v1/requests/:id
+      def show
+        render json: { request: @request.as_api_json }
+      end
+
+      # PATCH /api/v1/requests/:id
+      # { request: { comment: { body }, status: "solved" } }
+      def update
+        attrs = require_envelope(:request)
+
+        reply = {}
+        if attrs.key?(:comment)
+          reply[:body] = require_envelope(:comment, attrs).permit(:body)[:body].to_s
+        end
+        reply[:status] = attrs.permit(:status)[:status].to_s if attrs.key?(:status)
+
+        @request.requester_reply!(author: @current_user, **reply)
+        render json: { request: @request.as_api_json }
+      end
+
+      # GET /api/v1/requests/:id/comments
+      # Customers see public comments only, oldest first.
+      def comments
+        records, paging = paginate(@request.comments.public_only.includes(:author), order: :created_at)
+        render json: { comments: records.map(&:as_api_json), **paging }
+      end
+
+      private
+
+      def own_requests
+        @account.requests.where(requester: @current_user)
+      end
+
+      # Another customer's request is reported as missing, not forbidden, so IDs don't leak.
+      def load_own_request
+        @request = own_requests.find_by(id: params[:id])
+        render_error(404, "not_found", "No request has that ID.") unless @request
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/sessions_controller.rb b/app/controllers/api/v1/sessions_controller.rb
new file mode 100644
index 0000000..ca148b4
--- /dev/null
+++ b/app/controllers/api/v1/sessions_controller.rb
@@ -0,0 +1,38 @@
+module Api
+  module V1
+    class SessionsController < ApplicationController
+      before_action :load_account_from_header!, only: :create
+      before_action :authenticate_session!, only: :destroy
+
+      # POST /api/v1/sessions
+      # { session: { email, password } } with X-Helpdesk-Account
+      def create
+        credentials = require_envelope(:session).permit(:email, :password)
+        password = credentials[:password].to_s
+        user = @account.users.find_by(email: credentials[:email].to_s)
+        User.burn_password_check(password) if user.nil?
+        return render_error(401, "invalid_credentials", "Email or password is incorrect.") unless user&.authenticate(password)
+        return render_error(403, "user_suspended", "This user has been suspended.") if user.suspended?
+
+        # A cancelled account only admits its owner, so they can reactivate it.
+        if @account.cancelled? && !(user.owner? && @account.reactivatable?)
+          return render_error(403, "account_cancelled", "This account has been cancelled.")
+        end
+        return render_error(403, "email_not_verified", "Verify your email address before signing in.") unless user.verified?
+
+        session = Session.start_for(user)
+        render json: {
+          session: { token: session.token, id: session.id, created_at: session.created_at },
+          user: user.as_api_json,
+          account: @account.as_api_json
+        }, status: :created
+      end
+
+      # DELETE /api/v1/session
+      def destroy
+        @current_session.destroy!
+        render json: { message: "Signed out." }
+      end
+    end
+  end
+end
