+# Users, invitations and groups are listed by ID within one business, a page at a time. An index on
+# (account_id, id) makes each page an index seek. Without it, PostgreSQL can walk the rows of every
+# business in ID order to find the few that belong to a small one, so a page costs more as other
+# businesses grow.
+#
+# The single-column account_id indexes are dropped. Each table already has an index that starts with
+# account_id, and the new index starts with it too, so lookups by business still use an index.
+#
+# Built concurrently, so writes are not blocked while the indexes are made.
+class AddIdOrderIndexesForCursorPages < ActiveRecord::Migration[8.1]
+  disable_ddl_transaction!
+
+  def up
+    add_index :users, %i[account_id id], algorithm: :concurrently
+    add_index :invitations, %i[account_id id], algorithm: :concurrently
+    add_index :groups, %i[account_id id], algorithm: :concurrently
+
+    remove_index :users, :account_id, algorithm: :concurrently
+    remove_index :invitations, :account_id, algorithm: :concurrently
+    remove_index :groups, :account_id, algorithm: :concurrently
+  end
+
+  def down
+    add_index :users, :account_id, algorithm: :concurrently
+    add_index :invitations, :account_id, algorithm: :concurrently
+    add_index :groups, :account_id, algorithm: :concurrently
+
+    remove_index :users, %i[account_id id], algorithm: :concurrently
+    remove_index :invitations, %i[account_id id], algorithm: :concurrently
+    remove_index :groups, %i[account_id id], algorithm: :concurrently
+  end
+end
