diff --git a/test/integration/account_lifecycle_test.rb b/test/integration/account_lifecycle_test.rb
new file mode 100644
index 0000000..2b7c4ff
--- /dev/null
+++ b/test/integration/account_lifecycle_test.rb
@@ -0,0 +1,199 @@
+require "test_helper"
+
+class AccountLifecycleTest < ActionDispatch::IntegrationTest
+  setup do
+    @owner = owner_session
+    @owner_token = @owner.dig("session", "token")
+  end
+
+  def add_user(email:, role:, password: PASSWORD, verified: true)
+    account = Account.find_by!(subdomain: "acme")
+    account.users.create!(
+      name: "Member", email: email, password: password, role: role,
+      verified_at: verified ? Time.current : nil
+    )
+  end
+
+  def account_id_for(subdomain)
+    Account.find_by!(subdomain: subdomain).id
+  end
+
+  def cancel_as_owner
+    post "/api/v1/account/cancel", headers: bearer(@owner_token)
+  end
+
+  test "only the owner can cancel" do
+    add_user(email: "agent@acme.test", role: "agent")
+    agent_token = sign_in!(email: "agent@acme.test").dig("session", "token")
+
+    post "/api/v1/account/cancel", headers: bearer(agent_token)
+
+    assert_response :forbidden
+    assert_equal "forbidden", json.dig("error", "code")
+    assert_nil Account.find_by!(subdomain: "acme").cancelled_at
+  end
+
+  test "cancelling stamps the account and signs out every session" do
+    other = sign_in!.dig("session", "token")
+
+    cancel_as_owner
+
+    assert_response :ok
+    assert_equal "cancelled", json.dig("account", "status")
+    assert json.dig("account", "cancelled_at").present?
+    assert json.dig("account", "reactivate_by").present?
+    assert_equal 0, Session.joins(:user).where(users: { account_id: account_id_for("acme") }).count
+
+    get "/api/v1/me", headers: bearer(@owner_token)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: bearer(other)
+    assert_response :unauthorized
+  end
+
+  test "a cancelled account blocks ordinary business access" do
+    cancel_as_owner
+    token = sign_in!.dig("session", "token")
+
+    get "/api/v1/portal", headers: in_account("acme")
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+
+    patch "/api/v1/me", params: { user: { name: "Changed" } }, headers: bearer(token), as: :json
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: PASSWORD, password: "my-new-password" } },
+        headers: bearer(token), as: :json
+    assert_response :forbidden
+
+    post "/api/v1/account/cancel", headers: bearer(token)
+    assert_response :forbidden
+  end
+
+  test "the owner can still sign in to a cancelled account and reactivate it" do
+    cancel_as_owner
+
+    body = sign_in!
+    assert_equal "cancelled", body.dig("account", "status")
+    token = body.dig("session", "token")
+
+    get "/api/v1/account", headers: bearer(token)
+    assert_response :ok
+    assert_equal "cancelled", json.dig("account", "status")
+
+    post "/api/v1/account/reactivate", headers: bearer(token)
+
+    assert_response :ok
+    assert_equal "active", json.dig("account", "status")
+    assert_nil json.dig("account", "cancelled_at")
+
+    get "/api/v1/portal", headers: in_account("acme")
+    assert_response :ok
+  end
+
+  test "members other than the owner cannot sign in while the account is cancelled" do
+    add_user(email: "agent@acme.test", role: "agent")
+    cancel_as_owner
+
+    sign_in(email: "agent@acme.test")
+
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+  end
+
+  test "reactivating an active account is refused" do
+    post "/api/v1/account/reactivate", headers: bearer(@owner_token)
+
+    assert_response :unprocessable_content
+    assert_equal "not_cancelled", json.dig("error", "code")
+  end
+
+  test "cancellation can be reversed for 90 days but not after" do
+    cancel_as_owner
+    cancelled_at = Account.find_by!(subdomain: "acme").cancelled_at
+
+    travel_to cancelled_at + 89.days do
+      @owner_token = sign_in!.dig("session", "token")
+      post "/api/v1/account/reactivate", headers: bearer(@owner_token)
+      assert_response :ok
+    end
+
+    cancel_as_owner
+    assert_response :ok
+    cancelled_at = Account.find_by!(subdomain: "acme").cancelled_at
+
+    travel_to cancelled_at + 90.days + 1.minute do
+      sign_in(subdomain: "acme")
+      assert_response :forbidden
+      assert_equal "account_cancelled", json.dig("error", "code")
+
+      account = Account.find_by!(subdomain: "acme")
+      error = assert_raises(Account::StateError) { account.reactivate! }
+      assert_equal "reactivation_window_closed", error.code
+    end
+  end
+
+  test "purge deletes cancelled accounts only after 90 days, with all their data" do
+    cancel_as_owner
+    account = Account.find_by!(subdomain: "acme")
+    cancelled_at = account.cancelled_at
+
+    travel_to cancelled_at + 89.days do
+      assert_equal 0, Account.purge_cancelled!
+    end
+    assert Account.exists?(account.id)
+
+    travel_to cancelled_at + 91.days do
+      assert_equal 1, Account.purge_cancelled!
+    end
+
+    refute Account.exists?(account.id)
+    assert_equal 0, User.where(account_id: account.id).count
+    assert_equal 0, Session.count
+    assert_equal 0, UserToken.count
+  end
+
+  test "purge skips accounts that were reactivated in time" do
+    cancel_as_owner
+    account = Account.find_by!(subdomain: "acme")
+    token = sign_in!.dig("session", "token")
+    post "/api/v1/account/reactivate", headers: bearer(token)
+    assert_response :ok
+
+    travel 200.days do
+      assert_equal 0, Account.purge_cancelled!
+    end
+
+    assert Account.exists?(account.id)
+  end
+
+  test "purge leaves active accounts and other cancelled accounts alone" do
+    signup!(subdomain: "globex", name: "Globex", email: "ann@globex.test")
+    cancel_as_owner
+    old = Account.find_by!(subdomain: "acme")
+    globex = Account.find_by!(subdomain: "globex")
+
+    travel 100.days do
+      assert_equal 1, Account.purge_cancelled!
+    end
+
+    refute Account.exists?(old.id)
+    assert Account.exists?(globex.id)
+  end
+
+  test "the rake task purges cancelled accounts" do
+    Rails.application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+    cancel_as_owner
+    account = Account.find_by!(subdomain: "acme")
+
+    travel_to account.cancelled_at + 91.days do
+      Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+      assert_output(/Purged 1 cancelled account\./) do
+        Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+      end
+    end
+
+    refute Account.exists?(account.id)
+  end
+end
diff --git a/test/integration/authentication_test.rb b/test/integration/authentication_test.rb
new file mode 100644
index 0000000..2b6b39c
--- /dev/null
+++ b/test/integration/authentication_test.rb
@@ -0,0 +1,195 @@
+require "test_helper"
+
+class AuthenticationTest < ActionDispatch::IntegrationTest
+  setup do
+    signup!
+  end
+
+  test "an unverified admin cannot sign in" do
+    sign_in
+
+    assert_response :forbidden
+    assert_equal "email_not_verified", json.dig("error", "code")
+  end
+
+  test "confirming the emailed link verifies the email, then sign-in works" do
+    verify_email!
+
+    get "/api/v1/account", headers: {}
+    assert_response :unauthorized
+
+    sign_in!
+    assert_equal true, json.dig("user", "verified")
+    assert json.dig("user", "verified_at").present?
+    assert_equal "acme", json.dig("account", "subdomain")
+  end
+
+  test "sign-in returns the user, the account and a bearer token" do
+    verify_email!
+    body = sign_in!
+
+    assert body.dig("session", "token").present?
+    assert_kind_of Integer, body.dig("session", "id")
+    assert_equal "jo@acme.test", body.dig("user", "email")
+    assert_equal "admin", body.dig("user", "role")
+    assert_equal "acme", body.dig("account", "subdomain")
+    assert_equal body.dig("user", "account_id"), body.dig("account", "id")
+  end
+
+  test "the verification link can be used only once" do
+    token = link_token(to: "jo@acme.test", path: "/verify-email")
+    post "/api/v1/email_verifications/confirm", params: { email_verification: { token: token } }, as: :json
+    assert_response :ok
+
+    post "/api/v1/email_verifications/confirm", params: { email_verification: { token: token } }, as: :json
+    assert_response :unprocessable_content
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "a made-up verification token is rejected" do
+    post "/api/v1/email_verifications/confirm", params: { email_verification: { token: "nope" } }, as: :json
+
+    assert_response :unprocessable_content
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "an expired verification link is rejected" do
+    token = link_token(to: "jo@acme.test", path: "/verify-email")
+
+    travel 4.days do
+      post "/api/v1/email_verifications/confirm", params: { email_verification: { token: token } }, as: :json
+    end
+
+    assert_response :unprocessable_content
+    assert_equal false, User.find_by!(email: "jo@acme.test").verified?
+  end
+
+  test "wrong password and unknown email get the same answer" do
+    verify_email!
+
+    sign_in(password: "wrong-password-here")
+    assert_response :unauthorized
+    wrong_password = json
+
+    sign_in(email: "nobody@acme.test")
+    assert_response :unauthorized
+    unknown_email = json
+
+    assert_equal wrong_password, unknown_email
+    assert_equal "invalid_credentials", unknown_email.dig("error", "code")
+  end
+
+  test "sign-in needs the business header" do
+    verify_email!
+    post "/api/v1/sessions", params: { session: { email: "jo@acme.test", password: PASSWORD } }, as: :json
+
+    assert_response :bad_request
+    assert_equal "account_required", json.dig("error", "code")
+  end
+
+  test "sign-in for an unknown business is a 404" do
+    verify_email!
+    sign_in(subdomain: "nowhere")
+
+    assert_response :not_found
+    assert_equal "account_not_found", json.dig("error", "code")
+  end
+
+  test "GET /me needs a bearer token" do
+    verify_email!
+
+    get "/api/v1/me"
+    assert_response :unauthorized
+    assert_equal "unauthorized", json.dig("error", "code")
+
+    get "/api/v1/me", headers: bearer("not-a-real-token")
+    assert_response :unauthorized
+  end
+
+  test "GET /me returns the signed-in user" do
+    verify_email!
+    token = sign_in!.dig("session", "token")
+
+    get "/api/v1/me", headers: bearer(token)
+
+    assert_response :ok
+    assert_equal "jo@acme.test", json.dig("user", "email")
+    assert_equal true, json.dig("user", "verified")
+  end
+
+  test "PATCH /me changes the name, and ignores fields the user cannot set" do
+    verify_email!
+    token = sign_in!.dig("session", "token")
+
+    patch "/api/v1/me",
+          params: { user: { name: "Jo Smith", role: "agent", verified: false, email: "hacker@evil.test" } },
+          headers: bearer(token),
+          as: :json
+
+    assert_response :ok
+    assert_equal "Jo Smith", json.dig("user", "name")
+    assert_equal "admin", json.dig("user", "role")
+    assert_equal "jo@acme.test", json.dig("user", "email")
+    assert_equal true, json.dig("user", "verified")
+  end
+
+  test "PATCH /me rejects a blank name" do
+    verify_email!
+    token = sign_in!.dig("session", "token")
+
+    patch "/api/v1/me", params: { user: { name: "" } }, headers: bearer(token), as: :json
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "name").present?
+  end
+
+  test "malformed envelopes are 400s" do
+    verify_email!
+
+    post "/api/v1/sessions", params: { session: "jo@acme.test" }, headers: in_account("acme"), as: :json
+    assert_response :bad_request
+
+    post "/api/v1/email_verifications/confirm", params: { email_verification: "token" }, as: :json
+    assert_response :bad_request
+
+    token = sign_in!.dig("session", "token")
+    patch "/api/v1/me", params: { user: "Jo" }, headers: bearer(token), as: :json
+    assert_response :bad_request
+  end
+
+  test "DELETE /session signs out that session only" do
+    verify_email!
+    first = sign_in!.dig("session", "token")
+    second = sign_in!.dig("session", "token")
+
+    delete "/api/v1/session", headers: bearer(first)
+    assert_response :ok
+
+    get "/api/v1/me", headers: bearer(first)
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: bearer(second)
+    assert_response :ok
+  end
+
+  test "a token from one business cannot be used with another business header" do
+    signup!(subdomain: "globex", name: "Globex", email: "ann@globex.test")
+    verify_email!(email: "ann@globex.test", subdomain: "globex")
+    verify_email!
+    token = sign_in!.dig("session", "token")
+
+    get "/api/v1/me", headers: bearer(token).merge(in_account("globex"))
+
+    assert_response :forbidden
+    assert_equal "wrong_account", json.dig("error", "code")
+  end
+
+  test "session tokens are stored only as digests" do
+    verify_email!
+    token = sign_in!.dig("session", "token")
+
+    stored = Session.last.token_digest
+    refute_equal token, stored
+    assert_equal Session.digest(token), stored
+  end
+end
diff --git a/test/integration/configuration_test.rb b/test/integration/configuration_test.rb
new file mode 100644
index 0000000..c77a6e1
--- /dev/null
+++ b/test/integration/configuration_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class ConfigurationTest < ActionDispatch::IntegrationTest
+  test "HELPDESK_MAIL_FROM sets the sender" do
+    with_env("HELPDESK_MAIL_FROM" => "help@acme.test") do
+      signup!
+    end
+
+    assert_equal ["help@acme.test"], latest_mail("jo@acme.test").from
+  end
+
+  test "links use HELPDESK_FRONTEND_URL when set" do
+    with_env("HELPDESK_FRONTEND_URL" => "https://app.acme.test/") do
+      signup!
+      token = link_token(to: "jo@acme.test", path: "/verify-email")
+      assert_includes latest_mail("jo@acme.test").body.decoded,
+                      "https://app.acme.test/verify-email?account=acme&token=#{token}"
+    end
+  end
+
+  test "defaults are the frontend on port 3001 and support@example.test" do
+    with_env("HELPDESK_FRONTEND_URL" => nil, "HELPDESK_MAIL_FROM" => nil) do
+      assert_equal "http://localhost:3001", Helpdesk::Settings.frontend_url
+      assert_equal "support@example.test", Helpdesk::Settings.mail_from
+    end
+  end
+
+  test "HELPDESK_SUPPORT_DOMAIN defaults to support.example.test" do
+    with_env("HELPDESK_SUPPORT_DOMAIN" => nil) do
+      assert_equal "support.example.test", Helpdesk::Settings.support_domain
+    end
+  end
+
+  test "HELPDESK_SUPPORT_DOMAIN sets the domain that business mail is accepted on" do
+    owner_session
+    with_env("HELPDESK_SUPPORT_DOMAIN" => "help.example.test") do
+      receive_mail!(build_mail(to: "acme@help.example.test", message_id: "<custom-domain@example.test>"))
+      receive_mail!(build_mail(to: "acme@support.example.test", message_id: "<old-domain@example.test>"))
+    end
+
+    assert_equal ["custom-domain@example.test"], Request.all.map(&:origin_message_id)
+  end
+
+  private
+
+  def with_env(values)
+    previous = values.keys.to_h { |key| [key, ENV[key]] }
+    values.each { |key, value| ENV[key] = value }
+    yield
+  ensure
+    previous.each { |key, value| ENV[key] = value }
+  end
+end
diff --git a/test/integration/cors_test.rb b/test/integration/cors_test.rb
new file mode 100644
index 0000000..ffed9f4
--- /dev/null
+++ b/test/integration/cors_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class CorsTest < ActionDispatch::IntegrationTest
+  FRONTEND = "http://localhost:3001".freeze
+
+  test "the configured frontend origin may call the API, including preflight" do
+    process :options, "/api/v1/me",
+            headers: {
+              "Origin" => FRONTEND,
+              "Access-Control-Request-Method" => "PATCH",
+              "Access-Control-Request-Headers" => "authorization, content-type, x-helpdesk-account"
+            }
+
+    assert_response :no_content
+    assert_equal FRONTEND, response.headers["access-control-allow-origin"]
+    assert_includes response.headers["access-control-allow-methods"], "PATCH"
+    assert_includes response.headers["access-control-allow-headers"], "X-Helpdesk-Account"
+    assert_includes response.headers["access-control-allow-headers"], "Authorization"
+  end
+
+  test "real responses to the frontend origin carry the allow-origin header" do
+    signup!
+
+    get "/api/v1/portal", headers: in_account("acme").merge("Origin" => FRONTEND)
+
+    assert_response :ok
+    assert_equal FRONTEND, response.headers["access-control-allow-origin"]
+    assert_includes response.headers["vary"], "Origin"
+  end
+
+  test "other origins get no CORS headers" do
+    signup!
+
+    get "/api/v1/portal", headers: in_account("acme").merge("Origin" => "https://evil.test")
+    assert_response :ok
+    assert_nil response.headers["access-control-allow-origin"]
+
+    process :options, "/api/v1/me",
+            headers: { "Origin" => "https://evil.test", "Access-Control-Request-Method" => "GET" }
+    assert_nil response.headers["access-control-allow-origin"]
+  end
+
+  test "the allowed origin follows HELPDESK_FRONTEND_URL, without its path or trailing slash" do
+    previous = ENV["HELPDESK_FRONTEND_URL"]
+    ENV["HELPDESK_FRONTEND_URL"] = "https://support.acme.test:8443/app/"
+
+    process :options, "/api/v1/me",
+            headers: { "Origin" => "https://support.acme.test:8443", "Access-Control-Request-Method" => "GET" }
+    assert_equal "https://support.acme.test:8443", response.headers["access-control-allow-origin"]
+
+    process :options, "/api/v1/me",
+            headers: { "Origin" => FRONTEND, "Access-Control-Request-Method" => "GET" }
+    assert_nil response.headers["access-control-allow-origin"]
+  ensure
+    ENV["HELPDESK_FRONTEND_URL"] = previous
+  end
+end
diff --git a/test/integration/cursor_pagination_test.rb b/test/integration/cursor_pagination_test.rb
new file mode 100644
index 0000000..a2a1f96
--- /dev/null
+++ b/test/integration/cursor_pagination_test.rb
@@ -0,0 +1,472 @@
+require "test_helper"
+
+# Cursor paging (page[size], page[after], page[before]) on every list. The page-number API is covered
+# by pagination_test.rb.
+class CursorPaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    @owner_token = owner_session.dig("session", "token")
+    @agent_token = invited_session!(admin_token: @owner_token, email: "sam@example.test", role: "agent")
+                   .dig("session", "token")
+    @customer = customer_session
+    @customer_token = @customer.dig("session", "token")
+    @requester = User.find(@customer.dig("user", "id"))
+  end
+
+  # --- Helpers --------------------------------------------------------------------
+
+  def list(path, token: @customer_token, **query)
+    get path, params: query, headers: bearer(token)
+    assert_response :ok, response.body
+    json
+  end
+
+  # Fetches a link from a response, as the client would.
+  def follow(url, token: @customer_token)
+    get url, headers: bearer(token)
+    assert_response :ok, response.body
+    json
+  end
+
+  def ids_of(body, key)
+    body.fetch(key).map { |record| record["id"] }
+  end
+
+  # Follows links.next from a page already read. Returns the ID list of each later page, and the
+  # body of the last page read.
+  def pages_after(body, key:, token: @customer_token)
+    pages = []
+    while (url = body.dig("links", "next"))
+      body = follow(url, token: token)
+      pages << ids_of(body, key)
+      flunk "the walk never ended" if pages.size > 500
+    end
+    [pages, body]
+  end
+
+  # The IDs of every page after `body`, in order.
+  def walk_from(body, key:, token: @customer_token)
+    pages_after(body, key: key, token: token).first.flatten
+  end
+
+  # Walks a whole list with cursors, `size` records at a time. Returns the IDs in order.
+  def walk_forward(path, key:, token: @customer_token, size: 2, **query)
+    walk_pages(path, key: key, token: token, size: size, **query).first.flatten
+  end
+
+  # Returns the ID list of each page in a walk, and the body of the last page.
+  def walk_pages(path, key:, token: @customer_token, size: 2, **query)
+    first = list(path, token: token, **query, page: { size: size })
+    later, last = pages_after(first, key: key, token: token)
+    [[ids_of(first, key), *later], last]
+  end
+
+  # The records of an ordinary page-number list, for comparing against a cursor walk.
+  def numbered_ids(path, key:, token: @customer_token)
+    ids_of(list(path, token: token, per_page: 100), key)
+  end
+
+  # Opens `count` requests as the customer. Returns their IDs, oldest first.
+  def open_requests(count, prefix: "Issue")
+    Array.new(count) { |i| Request.submit!(requester: @requester, subject: "#{prefix} #{i}", body: "Details").id }
+  end
+
+  # The customer's requests in recent-activity order, the order the list uses.
+  def expected_requests
+    Request.where(requester: @requester).order(updated_at: :desc, id: :desc).pluck(:id)
+  end
+
+  def reply_as_agent(request_id, body: "Looking into it.")
+    patch "/api/v1/tickets/#{request_id}", params: { ticket: { comment: { body: body } } },
+                                           headers: bearer(@agent_token), as: :json
+    assert_response :ok, response.body
+  end
+
+  def create_group!(name)
+    post "/api/v1/groups", params: { group: { name: name } }, headers: bearer(@owner_token), as: :json
+    assert_response :created, response.body
+    json.fetch("group")
+  end
+
+  def assert_invalid_pagination(params, token: @customer_token, path: "/api/v1/requests")
+    get path, params: params, headers: bearer(token)
+    assert_response :bad_request, "expected #{params.inspect} to be refused"
+    assert_equal "invalid_pagination", json.dig("error", "code")
+    json.dig("error", "message")
+  end
+
+  # --- Shape ----------------------------------------------------------------------
+
+  test "a first cursor page carries the records, meta and links" do
+    open_requests(5)
+
+    body = list("/api/v1/requests", page: { size: 2 })
+
+    assert_equal %w[requests meta links], body.keys
+    assert_equal 2, body["requests"].size
+    assert_equal true, body.dig("meta", "has_more")
+    assert body.dig("meta", "after_cursor").present?
+    assert body.dig("meta", "before_cursor").present?
+    assert_nil body.dig("links", "prev"), "the top of the list has no previous page"
+    assert_match %r{\Ahttp://[^?]+/api/v1/requests\?page%5Bafter%5D=[A-Za-z0-9_-]+&page%5Bsize%5D=2\z},
+                 body.dig("links", "next")
+  end
+
+  test "an empty list has the empty shape" do
+    body = list("/api/v1/requests", page: { size: 2 })
+
+    assert_equal({ "requests" => [],
+                   "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+                   "links" => { "next" => nil, "prev" => nil } },
+                 body)
+  end
+
+  test "the cursor page keeps the list order and the record fields" do
+    open_requests(2)
+
+    body = list("/api/v1/requests", page: { size: 10 })
+
+    assert_equal expected_requests, ids_of(body, "requests")
+    assert_equal %w[id subject status requester_id merged_into_id created_at updated_at],
+                 body.fetch("requests").first.keys
+    assert_equal false, body.dig("meta", "has_more")
+    assert_nil body.dig("links", "next")
+  end
+
+  test "following links.next visits every record once, in list order" do
+    open_requests(7)
+
+    walked = walk_forward("/api/v1/requests", key: "requests", size: 3)
+
+    assert_equal expected_requests, walked
+  end
+
+  test "walking back with links.prev returns the earlier pages in order" do
+    open_requests(7)
+    pages, last_body = walk_pages("/api/v1/requests", key: "requests", size: 3)
+    assert_equal [3, 3, 1], pages.map(&:size)
+
+    backward = [ids_of(last_body, "requests")]
+    body = last_body
+    while (url = body.dig("links", "prev"))
+      body = follow(url)
+      backward.unshift(ids_of(body, "requests"))
+    end
+
+    assert_equal pages, backward
+  end
+
+  test "page[after] and page[before] take the cursors from meta" do
+    open_requests(6)
+    first = list("/api/v1/requests", page: { size: 2 })
+    second = list("/api/v1/requests", page: { size: 2, after: first.dig("meta", "after_cursor") })
+    back = list("/api/v1/requests", page: { size: 2, before: second.dig("meta", "before_cursor") })
+
+    assert_equal expected_requests[2, 2], ids_of(second, "requests")
+    assert_equal ids_of(first, "requests"), ids_of(back, "requests")
+    assert_equal true, second.dig("meta", "has_more")
+  end
+
+  test "a list that divides evenly ends on a full page, with no empty page after it" do
+    open_requests(6)
+
+    pages, = walk_pages("/api/v1/requests", key: "requests", size: 3)
+
+    assert_equal [3, 3], pages.map(&:size)
+  end
+
+  test "a page after the last record is empty, with null cursors and links" do
+    open_requests(3)
+    last = list("/api/v1/requests", page: { size: 3 })
+    assert_equal false, last.dig("meta", "has_more")
+
+    body = list("/api/v1/requests", page: { size: 3, after: last.dig("meta", "after_cursor") })
+
+    assert_equal({ "requests" => [],
+                   "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+                   "links" => { "next" => nil, "prev" => nil } },
+                 body)
+  end
+
+  test "a page reached backwards reports has_more and both links" do
+    open_requests(9)
+    first = list("/api/v1/requests", page: { size: 3 })
+    middle = list("/api/v1/requests", page: { size: 3, after: first.dig("meta", "after_cursor") })
+    last = list("/api/v1/requests", page: { size: 3, after: middle.dig("meta", "after_cursor") })
+
+    back = list("/api/v1/requests", page: { size: 3, before: last.dig("meta", "before_cursor") })
+
+    assert_equal ids_of(middle, "requests"), ids_of(back, "requests")
+    assert_equal true, back.dig("meta", "has_more"), "records before the middle page"
+    assert back.dig("links", "prev").present?
+    assert back.dig("links", "next").present?, "the last page comes after the middle page"
+  end
+
+  test "page[size] is capped at 100 and the links carry the capped size" do
+    open_requests(101)
+
+    body = list("/api/v1/requests", page: { size: 500 })
+
+    assert_equal 100, body["requests"].size
+    assert_includes body.dig("links", "next"), "page%5Bsize%5D=100"
+  end
+
+  test "a blank page[size] uses the default of 25" do
+    open_requests(30)
+
+    body = list("/api/v1/requests", page: { size: "" })
+
+    assert_equal 25, body["requests"].size
+    assert_equal true, body.dig("meta", "has_more")
+  end
+
+  test "page-number responses are unchanged and carry no cursor fields" do
+    open_requests(3)
+
+    body = list("/api/v1/requests", per_page: 2, page: 2)
+
+    assert_equal %w[requests count page per_page next_page previous_page], body.keys
+    assert_equal 1, body["requests"].size
+  end
+
+  # --- Ordering ---------------------------------------------------------------------
+
+  test "records with the same updated_at are walked once each, ordered by ID" do
+    ids = open_requests(5)
+    Request.where(id: ids).update_all(updated_at: Time.utc(2026, 1, 1, 12))
+
+    walked = walk_forward("/api/v1/requests", key: "requests", size: 2)
+
+    assert_equal ids.sort.reverse, walked
+  end
+
+  test "timestamps a microsecond apart keep their order across pages" do
+    ids = open_requests(4)
+    base = Time.utc(2026, 1, 1, 12)
+    ids.each_with_index do |id, i|
+      Request.where(id: id).update_all(updated_at: base + Rational(i, 1_000_000))
+    end
+
+    walked = walk_forward("/api/v1/requests", key: "requests", size: 1)
+
+    assert_equal ids.reverse, walked
+  end
+
+  # --- Stability while other people work ------------------------------------------
+
+  test "requests opened during a walk do not repeat or shift the rest of it" do
+    open_requests(6)
+    expected = expected_requests
+    first = list("/api/v1/requests", page: { size: 2 })
+
+    open_requests(3, prefix: "New")
+
+    assert_equal expected.drop(2), walk_from(first, key: "requests")
+  end
+
+  test "a request that gets a reply after the walk passed it is not repeated" do
+    open_requests(6)
+    expected = expected_requests
+    first = list("/api/v1/requests", page: { size: 2 })
+    seen = ids_of(first, "requests")
+    assert_equal expected.first(2), seen
+
+    reply_as_agent(seen.last)
+
+    assert_equal expected.drop(2), walk_from(first, key: "requests")
+    # A fresh walk from the top shows the replied request first.
+    assert_equal seen.last, ids_of(list("/api/v1/requests", page: { size: 2 }), "requests").first
+  end
+
+  test "a request that gets a reply before the walk reaches it is not repeated" do
+    open_requests(6)
+    expected = expected_requests
+    first = list("/api/v1/requests", page: { size: 2 })
+    unseen = expected[3]
+
+    reply_as_agent(unseen)
+    rest = walk_from(first, key: "requests")
+
+    # Nothing is repeated, and every other request is still reached once.
+    assert_equal rest.uniq, rest
+    assert_empty (expected.drop(2) - [unseen]) - rest
+    assert_not_includes rest, expected.first(2).first
+  end
+
+  test "a cursor keeps working after its own record is updated" do
+    ids = open_requests(6)
+    first = list("/api/v1/requests", page: { size: 2 })
+    anchor = ids_of(first, "requests").last
+
+    reply_as_agent(anchor)
+
+    assert_equal ids.reverse.drop(2), walk_from(first, key: "requests")
+  end
+
+  test "a cursor keeps working after its own record is deleted" do
+    groups = Array.new(5) { |i| create_group!("Team #{i}") }
+    first = list("/api/v1/groups", token: @agent_token, page: { size: 2 })
+    assert_equal groups.first(2).map { |g| g["id"] }, ids_of(first, "groups")
+
+    delete "/api/v1/groups/#{groups[1]['id']}", headers: bearer(@owner_token)
+    assert_response :ok, response.body
+
+    assert_equal groups.drop(2).map { |g| g["id"] }, walk_from(first, key: "groups", token: @agent_token)
+  end
+
+  test "comments added during a walk come after the walked ones and are not repeated" do
+    request = Request.find(open_requests(1).first)
+    3.times { |i| request.comments.create!(author: @requester, body: "Note #{i}", public: true) }
+    expected_before = request.comments.pluck(:id)
+    first = list("/api/v1/requests/#{request.id}/comments", page: { size: 2 })
+
+    late = request.comments.create!(author: @requester, body: "Late note", public: true)
+
+    assert_equal expected_before.drop(2) + [late.id], walk_from(first, key: "comments")
+  end
+
+  # --- Filters ----------------------------------------------------------------------
+
+  test "filters apply to cursor pages and carry into the links" do
+    open_requests(5)
+    Request.where(requester: @requester).order(:id).limit(2).each { |r| r.update!(status: "solved") }
+    expected = Request.where(requester: @requester, status: "solved").order(updated_at: :desc, id: :desc).pluck(:id)
+
+    body = list("/api/v1/requests", page: { size: 1 }, status: "solved")
+
+    assert_equal ["solved"], body["requests"].map { |r| r["status"] }
+    assert_includes body.dig("links", "next"), "status=solved"
+    assert_equal expected, walk_forward("/api/v1/requests", key: "requests", status: "solved", size: 1)
+  end
+
+  test "staff ticket filters apply to cursor pages" do
+    open_requests(3)
+    flagged = Request.where(requester: @requester).order(:id).first
+    flagged.update!(priority: "high")
+
+    walked = walk_forward("/api/v1/tickets", key: "tickets", token: @agent_token,
+                          priority: "high", size: 1)
+
+    assert_equal [flagged.id], walked
+  end
+
+  # --- Every list supports cursors --------------------------------------------------
+
+  test "every list pages with cursors in the same order as page numbers" do
+    request_ids = open_requests(5)
+    request = Request.find(request_ids.first)
+    4.times { |i| request.comments.create!(author: @requester, body: "Note #{i}", public: true) }
+
+    groups = %w[Billing Support Sales].map { |name| create_group!(name) }
+    sam = User.find_by!(email: "sam@example.test")
+    groups.each { |group| GroupMembership.add!(group: Group.find(group["id"]), user: sam) }
+
+    add_staff!(email: "kim@acme.test", role: "agent")
+    invite!(token: @owner_token, email: "ivy@example.test")
+    invite!(token: @owner_token, email: "lee@example.test", role: "admin")
+    invite!(token: @owner_token, email: "max@example.test")
+
+    cases = {
+      "requests" => ["/api/v1/requests", "requests", @customer_token],
+      "tickets" => ["/api/v1/tickets", "tickets", @agent_token],
+      "request comments" => ["/api/v1/requests/#{request.id}/comments", "comments", @customer_token],
+      "ticket comments" => ["/api/v1/tickets/#{request.id}/comments", "comments", @agent_token],
+      "groups" => ["/api/v1/groups", "groups", @agent_token],
+      "group memberships" => ["/api/v1/group_memberships", "group_memberships", @agent_token],
+      "users" => ["/api/v1/users", "users", @owner_token],
+      "staff" => ["/api/v1/staff", "staff", @agent_token],
+      "invitations" => ["/api/v1/invitations", "invitations", @owner_token]
+    }
+
+    cases.each do |label, (path, key, token)|
+      expected = numbered_ids(path, key: key, token: token)
+      walked = walk_forward(path, key: key, token: token, size: 2)
+
+      assert_operator expected.size, :>=, 3, "#{label} needs enough records to walk"
+      assert_equal expected, walked, "#{label} walked with cursors"
+    end
+  end
+
+  # --- Invalid paging ---------------------------------------------------------------
+
+  test "a page[after] or page[before] that is not a cursor is refused" do
+    open_requests(2)
+
+    ["bogus", "!!!", "e30", "WyJ4Il0", "a" * 600].each do |token|
+      assert_invalid_pagination({ page: { size: 1, after: token } })
+      assert_invalid_pagination({ page: { size: 1, before: token } })
+    end
+  end
+
+  test "cursors with the wrong shape, types or ranges are refused" do
+    bad_payloads = [
+      "not json",
+      ["requests:recent_activity"],
+      ["requests:recent_activity", "2026-01-01T00:00:00.000000Z"],
+      ["requests:recent_activity", "2026-01-01T00:00:00.000000Z", 1, 2],
+      { "a" => 1 },
+      ["groups:id", 5],
+      ["requests:recent_activity", "2026-02-30T00:00:00.000000Z", 1],
+      ["requests:recent_activity", "0000-01-01T00:00:00.000000Z", 1],
+      ["requests:recent_activity", "2026-01-01 00:00:00", 1],
+      ["requests:recent_activity", 1_700_000_000, 1],
+      ["requests:recent_activity", "2026-01-01T00:00:00.000000Z", "x"],
+      ["requests:recent_activity", "2026-01-01T00:00:00.000000Z", 0],
+      ["requests:recent_activity", "2026-01-01T00:00:00.000000Z", -4],
+      ["requests:recent_activity", "2026-01-01T00:00:00.000000Z", 2**63],
+      ["requests:recent_activity", "2026-01-01T00:00:00.000000Z", 1.5]
+    ]
+
+    bad_payloads.each do |payload|
+      text = payload.is_a?(String) ? payload : JSON.generate(payload)
+      token = Base64.urlsafe_encode64(text, padding: false)
+      get "/api/v1/requests", params: { page: { size: 1, after: token } }, headers: bearer(@customer_token)
+      assert_response :bad_request, "expected #{text} to be refused"
+      assert_equal "invalid_pagination", json.dig("error", "code"), "for #{text}"
+    end
+  end
+
+  test "a cursor from another list is refused" do
+    create_group!("Billing")
+    cursor = list("/api/v1/groups", token: @agent_token, page: { size: 1 }).dig("meta", "after_cursor")
+
+    assert_invalid_pagination({ page: { size: 1, after: cursor } }, token: @owner_token, path: "/api/v1/users")
+  end
+
+  test "after and before together are refused" do
+    open_requests(3)
+    cursor = list("/api/v1/requests", page: { size: 1 }).dig("meta", "after_cursor")
+
+    assert_invalid_pagination({ page: { size: 1, after: cursor, before: cursor } })
+  end
+
+  test "an unknown option inside page[...] is refused" do
+    assert_invalid_pagination({ page: { size: 1, number: 2 } })
+  end
+
+  test "page[size] must be a whole number of 1 or more" do
+    %w[0 -1 abc 1.5].each do |value|
+      message = assert_invalid_pagination({ page: { size: value } })
+      assert_includes message, "page[size]"
+    end
+  end
+
+  test "a page[size] or cursor given as a list or object is refused" do
+    assert_invalid_pagination({ page: { size: ["1"] } })
+    assert_invalid_pagination({ page: { size: { "a" => "1" } } })
+    assert_invalid_pagination({ page: { size: 1, after: { "a" => "1" } } })
+  end
+
+  test "per_page cannot be combined with page[...]" do
+    open_requests(2)
+
+    assert_invalid_pagination({ page: { size: 1 }, per_page: 2 })
+  end
+
+  test "page and page[size] together are a client error" do
+    open_requests(2)
+
+    get "/api/v1/requests?page=2&page[size]=1", headers: bearer(@customer_token)
+
+    assert_response :bad_request
+  end
+end
diff --git a/test/integration/email_replies_test.rb b/test/integration/email_replies_test.rb
new file mode 100644
index 0000000..561b18a
--- /dev/null
+++ b/test/integration/email_replies_test.rb
@@ -0,0 +1,219 @@
+require "test_helper"
+
+# Replies in both directions on requests opened by email: staff replies go out to the requester,
+# and the requester's replies come back to the same request through its private reply address.
+class EmailRepliesTest < ActionDispatch::IntegrationTest
+  setup do
+    @owner_token = owner_session.dig("session", "token")
+    add_staff!(email: "sam@acme.test", role: "agent")
+    @agent_token = sign_in!(email: "sam@acme.test").dig("session", "token")
+
+    receive_mail!(build_mail(from: "avery@example.test", subject: "Cannot download my receipt",
+                             body: "The download button does nothing.", message_id: "<origin-1@example.test>"))
+    @ticket = Request.sole
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def acme = Account.find_by!(subdomain: "acme")
+
+  def avery = acme.users.find_by!(email: "avery@example.test")
+
+  def reply_address = SupportAddress.reply_for(@ticket.reload)
+
+  def reply_token = @ticket.reload.reply_token
+
+  # A staff update through the API, as the staff app sends it.
+  def staff_update(request_id, token: @agent_token, **ticket)
+    patch "/api/v1/tickets/#{request_id}", params: { ticket: ticket }, headers: bearer(token), as: :json
+    assert_response :ok, response.body
+  end
+
+  # What the customer sends back, from their mail client, to `to`.
+  def customer_reply(to:, body: "It still fails.", from: "avery@example.test", message_id: nil)
+    receive_mail!(build_mail(from: from, to: to, subject: "Re: Cannot download my receipt", body: body,
+                             message_id: message_id))
+  end
+
+  # --- Staff replies going out ---------------------------------------------------
+
+  test "a staff public reply is emailed to the requester" do
+    staff_update(@ticket.id, comment: { body: "We fixed it. Try again." })
+
+    mail = latest_mail("avery@example.test")
+    assert_equal ["avery@example.test"], mail.to
+    assert_equal ["support@example.test"], mail.from
+    assert_equal "Re: Cannot download my receipt", mail.subject
+    assert_includes mail.body.decoded, "We fixed it. Try again."
+    # The address had no display name, so the greeting uses the part before the @.
+    assert_includes mail.body.decoded, "Hi avery,"
+  end
+
+  test "the staff reply names the private reply address and threads to the opening email" do
+    staff_update(@ticket.id, comment: { body: "Try again." })
+
+    mail = latest_mail("avery@example.test")
+    assert_equal ["reply+#{reply_token}@support.example.test"], mail.reply_to
+    assert_equal "<origin-1@example.test>", mail["In-Reply-To"].to_s
+    assert_equal "<origin-1@example.test>", mail["References"].to_s
+  end
+
+  test "the staff reply text reaches the requester exactly, without HTML escaping" do
+    staff_update(@ticket.id, comment: { body: "Tom & Jerry's <b>fix</b> is \"ready\"." })
+
+    assert_includes latest_mail("avery@example.test").body.decoded, "Tom & Jerry's <b>fix</b> is \"ready\"."
+  end
+
+  test "a staff private note is not emailed" do
+    staff_update(@ticket.id, comment: { body: "Checking with billing.", public: false })
+
+    assert_empty mails_to("avery@example.test")
+  end
+
+  test "a status change alone is not emailed" do
+    staff_update(@ticket.id, status: "solved")
+
+    assert_empty mails_to("avery@example.test")
+  end
+
+  test "a reply on a request opened in the app is not emailed" do
+    ben_token = customer_session(email: "ben@example.test", name: "Ben").dig("session", "token")
+    opened = open_request!(ben_token)
+    ActionMailer::Base.deliveries.clear
+
+    staff_update(opened["id"], comment: { body: "On it." })
+
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "the requester's own messages are not emailed back to them" do
+    customer_reply(to: reply_address)
+
+    assert_empty mails_to("avery@example.test")
+  end
+
+  # --- The requester's replies coming back ---------------------------------------
+
+  test "a reply to the reply address adds a public comment from the requester" do
+    customer_reply(to: reply_address, body: "It still fails on Safari.")
+
+    comment = @ticket.comments.order(:id).last
+    assert_equal "It still fails on Safari.", comment.body
+    assert comment.public?
+    assert_equal avery, comment.author
+    assert_equal 1, Request.count, "a reply does not open another request"
+  end
+
+  test "a reply reopens a solved request" do
+    staff_update(@ticket.id, status: "solved")
+
+    customer_reply(to: reply_address)
+
+    assert_equal "open", @ticket.reload.status
+  end
+
+  test "a reply reopens a pending request" do
+    staff_update(@ticket.id, status: "pending")
+
+    customer_reply(to: reply_address)
+
+    assert_equal "open", @ticket.reload.status
+  end
+
+  test "a reply to an open request leaves it open" do
+    customer_reply(to: reply_address)
+
+    assert_equal "open", @ticket.reload.status
+  end
+
+  test "a reply does not verify the requester" do
+    customer_reply(to: reply_address)
+
+    refute avery.verified?
+  end
+
+  test "the reply address in a staff email returns the customer's answer to the same request" do
+    staff_update(@ticket.id, comment: { body: "Did that work?" }, status: "solved")
+    reply_to = latest_mail("avery@example.test").reply_to.first
+
+    customer_reply(to: reply_to, body: "Yes, thanks!")
+
+    assert_equal 1, Request.count
+    assert_equal "open", @ticket.reload.status
+    assert_equal "Yes, thanks!", @ticket.comments.order(:id).last.body
+  end
+
+  test "a reply with the same Message-ID is only recorded once" do
+    customer_reply(to: reply_address, message_id: "<answer-1@example.test>")
+    customer_reply(to: reply_address, message_id: "<answer-1@example.test>")
+
+    assert_equal 2, @ticket.comments.count, "the original message and one reply"
+  end
+
+  test "a reply sent to the reply address and the plain address is a reply, not a new request" do
+    customer_reply(to: "#{reply_address}, acme@support.example.test")
+
+    assert_equal 1, Request.count
+    assert_equal 2, @ticket.comments.count
+  end
+
+  test "a plain message from the same customer opens a new request" do
+    receive_mail!(build_mail(from: "avery@example.test", subject: "A different problem"))
+
+    assert_equal 2, Request.count
+    assert_equal 1, @ticket.comments.count
+  end
+
+  test "only the requester may reply by email" do
+    customer_reply(to: reply_address, from: "someone-else@example.test")
+
+    assert_equal 1, @ticket.comments.count
+    assert_equal "open", @ticket.reload.status
+  end
+
+  test "a reply from a staff member who is not the requester is refused" do
+    customer_reply(to: reply_address, from: "sam@acme.test")
+
+    assert_equal 1, @ticket.comments.count
+  end
+
+  test "a suspended requester cannot reply by email" do
+    suspend_user!(token: @owner_token, user_id: avery.id)
+
+    customer_reply(to: reply_address)
+
+    assert_equal 1, @ticket.comments.count
+  end
+
+  test "a reply that names two different requests is refused" do
+    receive_mail!(build_mail(from: "ben@example.test", subject: "Login", message_id: "<ben-1@example.test>"))
+    other_reply = SupportAddress.reply_for(Request.find_by!(subject: "Login"))
+
+    customer_reply(to: "#{reply_address}, #{other_reply}")
+
+    assert_equal 1, @ticket.comments.count
+    assert_equal 0, Request.find_by!(subject: "Login").comments.where(author: avery).count
+  end
+
+  test "a reply addressed to a second business is ignored" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+
+    customer_reply(to: "#{reply_address}, globex@support.example.test")
+
+    assert_equal 1, @ticket.comments.count
+  end
+
+  test "mail to an unknown reply address alone is ignored" do
+    customer_reply(to: "reply+#{'0' * 32}@support.example.test")
+
+    assert_equal 1, @ticket.comments.count
+    assert_equal 1, Request.count, "an unknown reply address opens nothing"
+  end
+
+  test "mail to an unknown reply address with the plain address opens a new request" do
+    customer_reply(to: "reply+#{'0' * 32}@support.example.test, acme@support.example.test",
+                   message_id: "<stale-1@example.test>")
+
+    assert_equal 1, @ticket.comments.count
+    assert_equal 2, Request.count
+  end
+end
diff --git a/test/integration/group_memberships_test.rb b/test/integration/group_memberships_test.rb
new file mode 100644
index 0000000..886d291
--- /dev/null
+++ b/test/integration/group_memberships_test.rb
@@ -0,0 +1,394 @@
+require "test_helper"
+
+# Memberships put staff in groups. Each staff member with memberships has exactly one default.
+# Staff can browse memberships. Admins add, remove and choose defaults.
+class GroupMembershipsTest < ActionDispatch::IntegrationTest
+  setup do
+    @owner_session = owner_session
+    @owner_token = @owner_session.dig("session", "token")
+    @owner_id = @owner_session.dig("user", "id")
+    @agent_session = invited_session!(admin_token: @owner_token, email: "sam@example.test", role: "agent")
+    @agent_token = @agent_session.dig("session", "token")
+    @agent_id = @agent_session.dig("user", "id")
+    @avery_session = customer_session
+    @avery_token = @avery_session.dig("session", "token")
+    @avery_id = @avery_session.dig("user", "id")
+
+    @billing = create_group!("Billing")
+    @support = create_group!("Technical Support")
+  end
+
+  def create_group!(name, token: @owner_token)
+    post "/api/v1/groups", params: { group: { name: name } }, headers: bearer(token), as: :json
+    assert_response :created, response.body
+    json.fetch("group")
+  end
+
+  def add_member(group_id:, user_id:, default: nil, token: @owner_token)
+    body = { group_id: group_id, user_id: user_id }
+    body[:default] = default unless default.nil?
+    post "/api/v1/group_memberships", params: { group_membership: body }, headers: bearer(token), as: :json
+  end
+
+  def add_member!(**options)
+    add_member(**options)
+    assert_response :created, response.body
+    json.fetch("group_membership")
+  end
+
+  def defaults_for(user_id)
+    GroupMembership.where(user_id: user_id, default: true).pluck(:group_id)
+  end
+
+  # --- Adding staff to groups ----------------------------------------------------------
+
+  test "an admin adds staff to a group, and the membership shows the group and the person" do
+    membership = add_member!(group_id: @billing["id"], user_id: @agent_id)
+
+    assert_equal @billing["id"], membership["group_id"]
+    assert_equal @agent_id, membership["user_id"]
+    assert_equal({ "id" => @billing["id"], "name" => "Billing" }, membership["group"])
+    assert_equal({ "id" => @agent_id, "name" => "Sam" }, membership["user"])
+  end
+
+  test "the first membership a staff member gets is their default, even without asking" do
+    membership = add_member!(group_id: @billing["id"], user_id: @agent_id)
+
+    assert_equal true, membership["default"]
+  end
+
+  test "a staff member can belong to more than one group, and only the first is the default" do
+    add_member!(group_id: @billing["id"], user_id: @agent_id)
+    second = add_member!(group_id: @support["id"], user_id: @agent_id)
+
+    assert_equal false, second["default"]
+    assert_equal [@billing["id"]], defaults_for(@agent_id)
+  end
+
+  test "joining a group as the default moves the default off the previous group" do
+    add_member!(group_id: @billing["id"], user_id: @agent_id)
+
+    second = add_member!(group_id: @support["id"], user_id: @agent_id, default: true)
+
+    assert_equal true, second["default"]
+    assert_equal [@support["id"]], defaults_for(@agent_id)
+  end
+
+  test "a staff member's default is one group at a time, even if an admin joins them again as default" do
+    add_member!(group_id: @billing["id"], user_id: @agent_id)
+    add_member!(group_id: @support["id"], user_id: @agent_id, default: true)
+
+    assert_equal 1, GroupMembership.where(user_id: @agent_id, default: true).count
+  end
+
+  test "a membership can be a default for an admin too" do
+    membership = add_member!(group_id: @billing["id"], user_id: @owner_id)
+
+    assert_equal true, membership["default"]
+    assert_equal [@billing["id"]], defaults_for(@owner_id)
+  end
+
+  test "the same person cannot join the same group twice" do
+    add_member!(group_id: @billing["id"], user_id: @agent_id)
+
+    add_member(group_id: @billing["id"], user_id: @agent_id)
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "user").present?
+    assert_equal 1, GroupMembership.where(group_id: @billing["id"], user_id: @agent_id).count
+  end
+
+  test "customers cannot be put in groups" do
+    add_member(group_id: @billing["id"], user_id: @avery_id)
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "user").present?
+    assert_equal 0, GroupMembership.where(user_id: @avery_id).count
+  end
+
+  test "a group or user from another business is refused, with the same message as a missing one" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    globex_id = Account.find_by!(subdomain: "globex").users.first.id
+    globex_group = Account.find_by!(subdomain: "globex").groups.create!(name: "Sales")
+
+    add_member(group_id: @billing["id"], user_id: globex_id)
+    assert_response :unprocessable_content
+    other_business = json.dig("error", "details", "user")
+
+    add_member(group_id: @billing["id"], user_id: 999_999)
+    assert_response :unprocessable_content
+    assert_equal other_business, json.dig("error", "details", "user")
+
+    add_member(group_id: globex_group.id, user_id: @agent_id)
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "group").present?
+
+    add_member(group_id: 999_999, user_id: @agent_id)
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "group").present?
+  end
+
+  test "a membership needs a group and a user, and a whole-number ID" do
+    add_member(group_id: "12abc", user_id: @agent_id)
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "group").present?
+
+    add_member(group_id: @billing["id"], user_id: nil)
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "user").present?
+  end
+
+  test "default must be true or false" do
+    add_member(group_id: @billing["id"], user_id: @agent_id, default: "yes")
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "default").present?
+    assert_equal 0, GroupMembership.count
+  end
+
+  test "a membership without an envelope is a 400" do
+    post "/api/v1/group_memberships", params: { group_membership: "nope" }, headers: bearer(@owner_token), as: :json
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  # --- Choosing the default --------------------------------------------------------------
+
+  test "an admin makes a different group the default, and only one stays the default" do
+    billing = add_member!(group_id: @billing["id"], user_id: @agent_id)
+    support = add_member!(group_id: @support["id"], user_id: @agent_id)
+
+    put "/api/v1/group_memberships/#{support['id']}/make_default", headers: bearer(@owner_token)
+
+    assert_response :ok
+    assert_equal true, json.dig("group_membership", "default")
+    assert_equal [@support["id"]], defaults_for(@agent_id)
+    assert_equal false, GroupMembership.find(billing["id"]).default?
+  end
+
+  test "making the current default the default again changes nothing" do
+    membership = add_member!(group_id: @billing["id"], user_id: @agent_id)
+
+    put "/api/v1/group_memberships/#{membership['id']}/make_default", headers: bearer(@owner_token)
+
+    assert_response :ok
+    assert_equal [@billing["id"]], defaults_for(@agent_id)
+  end
+
+  test "agents cannot choose a default" do
+    membership = add_member!(group_id: @billing["id"], user_id: @agent_id)
+
+    put "/api/v1/group_memberships/#{membership['id']}/make_default", headers: bearer(@agent_token)
+
+    assert_response :forbidden
+  end
+
+  test "making a membership default for a missing ID is a 404" do
+    put "/api/v1/group_memberships/999999/make_default", headers: bearer(@owner_token)
+
+    assert_response :not_found
+    assert_equal "not_found", json.dig("error", "code")
+  end
+
+  # --- Removing memberships --------------------------------------------------------------
+
+  test "removing the default picks another remaining membership as the default" do
+    billing = add_member!(group_id: @billing["id"], user_id: @agent_id)
+    support = add_member!(group_id: @support["id"], user_id: @agent_id)
+    assert_equal [@billing["id"]], defaults_for(@agent_id)
+
+    delete "/api/v1/group_memberships/#{billing['id']}", headers: bearer(@owner_token)
+
+    assert_response :ok
+    assert_nil GroupMembership.find_by(id: billing["id"])
+    assert_equal [@support["id"]], defaults_for(@agent_id)
+    assert_equal support["id"], GroupMembership.find_by!(user_id: @agent_id, default: true).id
+  end
+
+  test "removing the default picks the oldest remaining membership when there are several" do
+    billing = add_member!(group_id: @billing["id"], user_id: @agent_id)
+    third_group = create_group!("Sales")
+    add_member!(group_id: @support["id"], user_id: @agent_id)
+    add_member!(group_id: third_group["id"], user_id: @agent_id)
+
+    delete "/api/v1/group_memberships/#{billing['id']}", headers: bearer(@owner_token)
+
+    assert_response :ok
+    assert_equal [@support["id"]], defaults_for(@agent_id)
+  end
+
+  test "removing a non-default membership leaves the default where it is" do
+    billing = add_member!(group_id: @billing["id"], user_id: @agent_id)
+    support = add_member!(group_id: @support["id"], user_id: @agent_id)
+
+    delete "/api/v1/group_memberships/#{support['id']}", headers: bearer(@owner_token)
+
+    assert_response :ok
+    assert_equal [@billing["id"]], defaults_for(@agent_id)
+    assert_equal billing["id"], GroupMembership.find_by!(user_id: @agent_id, default: true).id
+  end
+
+  test "removing the last membership leaves the staff member with no default, and no error" do
+    membership = add_member!(group_id: @billing["id"], user_id: @agent_id)
+
+    delete "/api/v1/group_memberships/#{membership['id']}", headers: bearer(@owner_token)
+
+    assert_response :ok
+    assert_equal 0, GroupMembership.where(user_id: @agent_id).count
+  end
+
+  test "agents cannot remove memberships" do
+    membership = add_member!(group_id: @billing["id"], user_id: @agent_id)
+
+    delete "/api/v1/group_memberships/#{membership['id']}", headers: bearer(@agent_token)
+
+    assert_response :forbidden
+    assert GroupMembership.exists?(membership["id"])
+  end
+
+  test "removing a missing membership is a 404" do
+    delete "/api/v1/group_memberships/999999", headers: bearer(@owner_token)
+
+    assert_response :not_found
+  end
+
+  # --- Browsing (staff) --------------------------------------------------------------------
+
+  test "staff list memberships by ID ascending, with the filters combined" do
+    first = add_member!(group_id: @billing["id"], user_id: @agent_id)
+    second = add_member!(group_id: @support["id"], user_id: @agent_id)
+    third = add_member!(group_id: @billing["id"], user_id: @owner_id)
+
+    get "/api/v1/group_memberships", headers: bearer(@agent_token)
+    assert_response :ok
+    assert_equal [first["id"], second["id"], third["id"]], json.fetch("group_memberships").map { |m| m["id"] }
+    assert_equal 3, json["count"]
+
+    get "/api/v1/group_memberships", params: { group_id: @billing["id"] }, headers: bearer(@agent_token)
+    assert_equal [first["id"], third["id"]], json.fetch("group_memberships").map { |m| m["id"] }
+
+    get "/api/v1/group_memberships", params: { user_id: @agent_id }, headers: bearer(@agent_token)
+    assert_equal [first["id"], second["id"]], json.fetch("group_memberships").map { |m| m["id"] }
+
+    get "/api/v1/group_memberships", params: { group_id: @billing["id"], user_id: @agent_id },
+                                     headers: bearer(@agent_token)
+    assert_equal [first["id"]], json.fetch("group_memberships").map { |m| m["id"] }
+  end
+
+  test "a filter that matches nothing is an empty list, not an error" do
+    add_member!(group_id: @billing["id"], user_id: @agent_id)
+
+    get "/api/v1/group_memberships", params: { group_id: 999_999 }, headers: bearer(@agent_token)
+
+    assert_response :ok
+    assert_equal [], json.fetch("group_memberships")
+    assert_equal 0, json["count"]
+  end
+
+  test "a membership filter that is not a whole number ID is a 400" do
+    add_member!(group_id: @billing["id"], user_id: @agent_id)
+
+    ["12abc", "0", "1.5", "unassigned", "-3"].each do |value|
+      get "/api/v1/group_memberships", params: { group_id: value }, headers: bearer(@agent_token)
+      assert_response :bad_request, value
+      assert_equal "invalid_filter", json.dig("error", "code"), value
+      assert_match(/group_id/, json.dig("error", "message"))
+    end
+
+    get "/api/v1/group_memberships", params: { user_id: "abc" }, headers: bearer(@agent_token)
+    assert_response :bad_request
+    assert_match(/user_id/, json.dig("error", "message"))
+  end
+
+  test "a blank membership filter counts as not sent" do
+    add_member!(group_id: @billing["id"], user_id: @agent_id)
+
+    get "/api/v1/group_memberships", params: { group_id: "", user_id: "" }, headers: bearer(@agent_token)
+
+    assert_response :ok
+    assert_equal 1, json["count"]
+  end
+
+  test "staff show one membership, and a membership from another business is not found" do
+    membership = add_member!(group_id: @billing["id"], user_id: @agent_id)
+
+    get "/api/v1/group_memberships/#{membership['id']}", headers: bearer(@agent_token)
+    assert_response :ok
+    assert_equal membership["id"], json.dig("group_membership", "id")
+
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    verify_email!(email: "jo@globex.test", subdomain: "globex")
+    globex_token = sign_in!(subdomain: "globex", email: "jo@globex.test").dig("session", "token")
+    get "/api/v1/group_memberships/#{membership['id']}", headers: bearer(globex_token)
+    assert_response :not_found
+  end
+
+  test "customers cannot browse memberships" do
+    add_member!(group_id: @billing["id"], user_id: @agent_id)
+
+    get "/api/v1/group_memberships", headers: bearer(@avery_token)
+
+    assert_response :forbidden
+  end
+
+  test "memberships are paginated" do
+    add_member!(group_id: @billing["id"], user_id: @agent_id)
+    add_member!(group_id: @support["id"], user_id: @agent_id)
+
+    get "/api/v1/group_memberships", params: { per_page: 1, page: 2 }, headers: bearer(@agent_token)
+
+    assert_response :ok
+    assert_equal 1, json.fetch("group_memberships").size
+    assert_equal 2, json["count"]
+    assert_nil json["next_page"]
+    assert_equal 1, json["previous_page"]
+  end
+
+  # --- Suspension keeps memberships ----------------------------------------------------------
+
+  test "suspending a staff member keeps their memberships, and restoring them keeps the default" do
+    add_member!(group_id: @billing["id"], user_id: @agent_id)
+    add_member!(group_id: @support["id"], user_id: @agent_id, default: true)
+
+    patch "/api/v1/users/#{@agent_id}", params: { user: { suspended: true } }, headers: bearer(@owner_token), as: :json
+    assert_response :ok
+    assert_equal 2, GroupMembership.where(user_id: @agent_id).count
+    assert_equal [@support["id"]], defaults_for(@agent_id)
+
+    patch "/api/v1/users/#{@agent_id}", params: { user: { suspended: false } }, headers: bearer(@owner_token), as: :json
+    assert_response :ok
+    get "/api/v1/group_memberships", params: { user_id: @agent_id }, headers: bearer(@owner_token)
+    assert_equal 2, json["count"]
+    assert_equal [@support["id"]], defaults_for(@agent_id)
+  end
+
+  # --- Removing a membership clears assignments in that group --------------------------
+
+  test "removing a membership unassigns that person's tickets in the group, but keeps the tickets in the group" do
+    add_member!(group_id: @billing["id"], user_id: @agent_id)
+    add_member!(group_id: @support["id"], user_id: @agent_id)
+    billing_ticket = open_request!(@avery_token, subject: "Invoice")
+    support_ticket = open_request!(@avery_token, subject: "Login")
+    patch "/api/v1/tickets/#{billing_ticket['id']}",
+          params: { ticket: { group_id: @billing["id"], assignee_id: @agent_id } }, headers: bearer(@owner_token), as: :json
+    patch "/api/v1/tickets/#{support_ticket['id']}",
+          params: { ticket: { group_id: @support["id"], assignee_id: @agent_id } }, headers: bearer(@owner_token), as: :json
+    billing_membership = GroupMembership.find_by!(group_id: @billing["id"], user_id: @agent_id)
+    updated_at = Request.find(billing_ticket["id"]).updated_at
+
+    travel 1.hour do
+      delete "/api/v1/group_memberships/#{billing_membership.id}", headers: bearer(@owner_token)
+    end
+
+    assert_response :ok
+    billing_ticket = Request.find(billing_ticket["id"])
+    assert_equal @billing["id"], billing_ticket.group_id
+    assert_nil billing_ticket.assignee_id
+    assert_equal updated_at.to_i, billing_ticket.updated_at.to_i
+
+    support_ticket = Request.find(support_ticket["id"])
+    assert_equal @support["id"], support_ticket.group_id
+    assert_equal @agent_id, support_ticket.assignee_id
+  end
+end
diff --git a/test/integration/groups_test.rb b/test/integration/groups_test.rb
new file mode 100644
index 0000000..ce27302
--- /dev/null
+++ b/test/integration/groups_test.rb
@@ -0,0 +1,222 @@
+require "test_helper"
+
+# Groups are the departments the business works in. Staff browse them. Admins create, rename and
+# delete them. Deleting a group ungroups its tickets and removes its memberships.
+class GroupsTest < ActionDispatch::IntegrationTest
+  setup do
+    @owner_session = owner_session
+    @owner_token = @owner_session.dig("session", "token")
+    @owner_id = @owner_session.dig("user", "id")
+    @agent_session = invited_session!(admin_token: @owner_token, email: "sam@example.test", role: "agent")
+    @agent_token = @agent_session.dig("session", "token")
+    @agent_id = @agent_session.dig("user", "id")
+    @avery_session = customer_session
+    @avery_token = @avery_session.dig("session", "token")
+  end
+
+  def create_group!(name, token: @owner_token)
+    post "/api/v1/groups", params: { group: { name: name } }, headers: bearer(token), as: :json
+    assert_response :created, response.body
+    json.fetch("group")
+  end
+
+  # --- Creating, renaming and deleting (admins only) --------------------------------
+
+  test "an admin creates a group, and the name is trimmed" do
+    post "/api/v1/groups", params: { group: { name: "  Billing  " } }, headers: bearer(@owner_token), as: :json
+
+    assert_response :created
+    group = json.fetch("group")
+    assert_equal "Billing", group["name"]
+    assert group["id"].present?
+    assert_equal Group.find(group["id"]).name, "Billing"
+  end
+
+  test "an admin renames a group with PATCH" do
+    group = create_group!("Billing")
+
+    patch "/api/v1/groups/#{group['id']}", params: { group: { name: "Accounts" } }, headers: bearer(@owner_token), as: :json
+
+    assert_response :ok
+    assert_equal "Accounts", json.dig("group", "name")
+    assert_equal "Accounts", Group.find(group["id"]).name
+  end
+
+  test "an admin deletes a group" do
+    group = create_group!("Billing")
+
+    delete "/api/v1/groups/#{group['id']}", headers: bearer(@owner_token)
+
+    assert_response :ok
+    assert_equal group["id"], json.dig("group", "id")
+    assert_nil Group.find_by(id: group["id"])
+  end
+
+  test "agents and customers cannot create, rename or delete groups" do
+    group = create_group!("Billing")
+
+    [@agent_token, @avery_token].each do |token|
+      post "/api/v1/groups", params: { group: { name: "Sales" } }, headers: bearer(token), as: :json
+      assert_response :forbidden
+
+      patch "/api/v1/groups/#{group['id']}", params: { group: { name: "Renamed" } }, headers: bearer(token), as: :json
+      assert_response :forbidden
+
+      delete "/api/v1/groups/#{group['id']}", headers: bearer(token)
+      assert_response :forbidden
+    end
+
+    assert_equal "Billing", Group.find(group["id"]).name
+  end
+
+  test "a blank name is refused" do
+    post "/api/v1/groups", params: { group: { name: "   " } }, headers: bearer(@owner_token), as: :json
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "name").present?
+
+    post "/api/v1/groups", params: { group: { name: "" } }, headers: bearer(@owner_token), as: :json
+    assert_response :unprocessable_content
+    assert_equal 0, Group.count
+  end
+
+  test "a group without an envelope is a 400" do
+    post "/api/v1/groups", params: { group: {} }, headers: bearer(@owner_token), as: :json
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "a name that is not text is refused rather than crashing" do
+    post "/api/v1/groups", params: { group: { name: { nested: "Billing" } } }, headers: bearer(@owner_token), as: :json
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "name").present?
+  end
+
+  test "a name over 120 characters is refused" do
+    post "/api/v1/groups", params: { group: { name: "x" * 121 } }, headers: bearer(@owner_token), as: :json
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "name").present?
+  end
+
+  test "group names are unique within a business, ignoring case" do
+    create_group!("Billing")
+
+    post "/api/v1/groups", params: { group: { name: "billing" } }, headers: bearer(@owner_token), as: :json
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "name").present?
+  end
+
+  test "another business can use the same group name" do
+    create_group!("Billing")
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    verify_email!(email: "jo@globex.test", subdomain: "globex")
+    globex_token = sign_in!(subdomain: "globex", email: "jo@globex.test").dig("session", "token")
+
+    post "/api/v1/groups", params: { group: { name: "Billing" } }, headers: bearer(globex_token), as: :json
+
+    assert_response :created
+  end
+
+  test "renaming without a name is refused, and a rename to a taken name is refused" do
+    billing = create_group!("Billing")
+    create_group!("Support")
+
+    patch "/api/v1/groups/#{billing['id']}", params: { group: { colour: "red" } }, headers: bearer(@owner_token), as: :json
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "name").present?
+
+    patch "/api/v1/groups/#{billing['id']}", params: { group: { name: "support" } }, headers: bearer(@owner_token), as: :json
+    assert_response :unprocessable_content
+    assert_equal "Billing", Group.find(billing["id"]).name
+  end
+
+  test "a group envelope that is not an object is a 400" do
+    post "/api/v1/groups", params: { group: "Billing" }, headers: bearer(@owner_token), as: :json
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  # --- Browsing (staff) --------------------------------------------------------------
+
+  test "staff list groups by ID ascending, with pagination" do
+    first = create_group!("Billing")
+    second = create_group!("Technical Support")
+    third = create_group!("Sales")
+
+    get "/api/v1/groups", headers: bearer(@agent_token)
+
+    assert_response :ok
+    assert_equal [first["id"], second["id"], third["id"]], json.fetch("groups").map { |group| group["id"] }
+    assert_equal 3, json["count"]
+    assert_equal 1, json["page"]
+    assert_nil json["next_page"]
+  end
+
+  test "groups are paginated" do
+    3.times { |i| create_group!("Group #{i}") }
+
+    get "/api/v1/groups", params: { per_page: 2 }, headers: bearer(@owner_token)
+
+    assert_equal 2, json.fetch("groups").size
+    assert_equal 2, json["next_page"]
+  end
+
+  test "staff show one group, and a group from another business is not found" do
+    group = create_group!("Billing")
+
+    get "/api/v1/groups/#{group['id']}", headers: bearer(@agent_token)
+    assert_response :ok
+    assert_equal({ "id" => group["id"], "name" => "Billing" }, json.fetch("group").slice("id", "name"))
+
+    get "/api/v1/groups/999999", headers: bearer(@agent_token)
+    assert_response :not_found
+    assert_equal "not_found", json.dig("error", "code")
+
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    verify_email!(email: "jo@globex.test", subdomain: "globex")
+    globex_token = sign_in!(subdomain: "globex", email: "jo@globex.test").dig("session", "token")
+    get "/api/v1/groups/#{group['id']}", headers: bearer(globex_token)
+    assert_response :not_found
+  end
+
+  test "customers cannot list or show groups" do
+    group = create_group!("Billing")
+
+    get "/api/v1/groups", headers: bearer(@avery_token)
+    assert_response :forbidden
+
+    get "/api/v1/groups/#{group['id']}", headers: bearer(@avery_token)
+    assert_response :forbidden
+  end
+
+  # --- Deleting clears what depended on the group -------------------------------------
+
+  test "deleting a group removes its memberships and ungroups its tickets, clearing their assignee" do
+    billing = create_group!("Billing")
+    post "/api/v1/group_memberships",
+         params: { group_membership: { group_id: billing["id"], user_id: @agent_id } },
+         headers: bearer(@owner_token), as: :json
+    assert_response :created
+    opened = open_request!(@avery_token)
+    patch "/api/v1/tickets/#{opened['id']}", params: { ticket: { group_id: billing["id"], assignee_id: @agent_id } },
+          headers: bearer(@owner_token), as: :json
+    assert_response :ok
+    updated_at = Request.find(opened["id"]).updated_at
+
+    travel 1.hour do
+      delete "/api/v1/groups/#{billing['id']}", headers: bearer(@owner_token)
+    end
+
+    assert_response :ok
+    assert_nil Group.find_by(id: billing["id"])
+    assert_equal 0, GroupMembership.where(group_id: billing["id"]).count
+    ticket = Request.find(opened["id"])
+    assert_nil ticket.group_id
+    assert_nil ticket.assignee_id
+    assert_equal updated_at.to_i, ticket.updated_at.to_i
+  end
+end
diff --git a/test/integration/inbound_mail_test.rb b/test/integration/inbound_mail_test.rb
new file mode 100644
index 0000000..a960b22
--- /dev/null
+++ b/test/integration/inbound_mail_test.rb
@@ -0,0 +1,300 @@
+require "test_helper"
+
+# Mail arriving at the relay ingress and opening requests.
+class InboundMailTest < ActionDispatch::IntegrationTest
+  setup do
+    @owner_token = owner_session.dig("session", "token")
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def acme = Account.find_by!(subdomain: "acme")
+
+  def requests = acme.requests.order(:id)
+
+  def avery = acme.users.find_by!(email: "avery@example.test")
+
+  # --- Ingress -------------------------------------------------------------------
+
+  test "the relay refuses mail without the inbound password" do
+    raw = build_mail
+
+    relay_mail(raw, password: nil)
+    assert_response :unauthorized
+
+    relay_mail(raw, password: "not-the-password")
+    assert_response :unauthorized
+
+    assert_equal 0, Request.count
+  end
+
+  test "the relay accepts mail with the inbound password and routes it before responding" do
+    receive_mail!(build_mail)
+
+    assert_equal 1, requests.count
+    assert_equal ["delivered"], ActionMailbox::InboundEmail.pluck(:status)
+  end
+
+  # --- Opening a request ---------------------------------------------------------
+
+  test "an email to the business address opens a request with its subject and text" do
+    receive_mail!(build_mail(subject: "Cannot download my receipt",
+                             body: "The download button does nothing.\r\n\r\nThanks,\r\nAvery"))
+
+    request = requests.sole
+    assert_equal "Cannot download my receipt", request.subject
+    assert_equal "open", request.status
+    assert_equal "email", request.origin
+    assert_equal avery, request.requester
+
+    comment = request.comments.sole
+    assert_equal "The download button does nothing.\n\nThanks,\nAvery", comment.body
+    assert comment.public?
+    assert_equal avery, comment.author
+  end
+
+  test "each new message to the plain address opens its own request" do
+    receive_mail!(build_mail(subject: "First"))
+    receive_mail!(build_mail(subject: "Second"))
+
+    assert_equal %w[First Second], requests.map(&:subject)
+  end
+
+  test "a message without a subject gets a placeholder subject" do
+    receive_mail!(build_mail(subject: ""))
+
+    assert_equal "(no subject)", requests.sole.subject
+  end
+
+  test "a long message is cut to the comment length limit" do
+    receive_mail!(build_mail(body: "a" * 12_000))
+
+    assert_equal Comment::BODY_MAX_LENGTH, requests.sole.comments.sole.body.length
+  end
+
+  test "an HTML-only message becomes plain text without markup" do
+    html = "<html><head><style>p { color: red }</style><script>alert(1)</script></head>" \
+           "<body><p>The button does <b>nothing</b>.</p><p>Caf&eacute; &amp; tea</p></body></html>"
+    receive_mail!(build_mail(body: nil, html: html))
+
+    text = requests.sole.comments.sole.body
+    assert_includes text, "The button does nothing."
+    assert_includes text, "Café & tea"
+    refute_match(/<|>|color|alert/, text)
+  end
+
+  test "attachments are left out of the ticket text" do
+    receive_mail!(build_mail(body: "The receipt is blank.", attachment: "secret attachment text"))
+
+    assert_equal "The receipt is blank.", requests.sole.comments.sole.body
+  end
+
+  test "mail with no text is refused and leaves no customer behind" do
+    receive_mail!(build_mail(from: "avery@example.test", body: "   ", message_id: "<empty-1@example.test>"))
+
+    assert_equal 0, Request.count
+    assert_nil acme.users.find_by(email: "avery@example.test")
+    assert_empty mails_to("avery@example.test")
+  end
+
+  # --- Customers -----------------------------------------------------------------
+
+  test "a new sender becomes an unverified customer who is sent a verification link" do
+    receive_mail!(build_mail(from: "Avery O'Brien <avery@example.test>"))
+
+    assert_equal "customer", avery.role
+    assert_equal "Avery O'Brien", avery.name
+    refute avery.verified?
+    assert_equal avery, requests.sole.requester
+
+    token = link_token(to: "avery@example.test", path: "/verify-email")
+    assert_match(/\A[A-Za-z0-9_-]{43}\z/, token)
+    assert_equal 1, mails_to("avery@example.test").size
+  end
+
+  test "receiving mail does not verify an existing unverified customer" do
+    register!(email: "avery@example.test")
+    ActionMailer::Base.deliveries.clear
+
+    receive_mail!(build_mail(from: "avery@example.test"))
+
+    refute avery.verified?
+    assert_equal 1, requests.count
+    assert_empty mails_to("avery@example.test"), "an existing customer is not sent a new verification link"
+  end
+
+  test "an existing verified customer is reused and stays verified" do
+    customer_session
+    ActionMailer::Base.deliveries.clear
+
+    receive_mail!(build_mail(from: "avery@example.test"))
+
+    assert_equal 1, acme.users.where(email: "avery@example.test").count
+    assert avery.verified?
+    assert_equal avery, requests.sole.requester
+  end
+
+  test "a suspended customer cannot open a request by email" do
+    customer = customer_session.dig("user", "id")
+    suspend_user!(token: @owner_token, user_id: customer)
+
+    receive_mail!(build_mail(from: "avery@example.test"))
+
+    assert_equal 0, Request.count
+  end
+
+  test "an address with a pending invitation does not become a customer" do
+    invite!(token: @owner_token, email: "sam@example.test", role: "agent")
+
+    receive_mail!(build_mail(from: "sam@example.test"))
+
+    assert_equal 0, Request.count
+    assert_nil acme.users.find_by(email: "sam@example.test")
+  end
+
+  # --- Routing -------------------------------------------------------------------
+
+  test "the business is found from a Cc recipient" do
+    receive_mail!(build_mail(to: "someone@example.test", cc: "ACME@support.example.test"))
+
+    assert_equal 1, requests.count
+  end
+
+  test "mail addressed to two businesses is ignored" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+
+    receive_mail!(build_mail(to: "acme@support.example.test", cc: "globex@support.example.test"))
+
+    assert_equal 0, Request.count
+    assert_equal "bounced", ActionMailbox::InboundEmail.last.status
+  end
+
+  test "mail for an unknown business is ignored" do
+    receive_mail!(build_mail(to: "nobody@support.example.test"))
+
+    assert_equal 0, Request.count
+    assert_equal 0, User.where(role: "customer").count
+  end
+
+  test "mail to an address on another domain is ignored" do
+    receive_mail!(build_mail(to: "acme@elsewhere.test"))
+
+    assert_equal 0, Request.count
+  end
+
+  test "a business that was cancelled takes no mail" do
+    post "/api/v1/account/cancel", headers: bearer(@owner_token)
+
+    receive_mail!(build_mail)
+
+    assert_equal 0, Request.count
+  end
+
+  test "mail sent from the support domain is ignored, so the business cannot loop with itself" do
+    receive_mail!(build_mail(from: "acme@support.example.test"))
+
+    assert_equal 0, Request.count
+  end
+
+  # --- Dedupe and retries --------------------------------------------------------
+
+  test "a Message-ID that was already processed does not open a second request" do
+    raw = build_mail(message_id: "<dup-1@example.test>")
+    receive_mail!(raw)
+    receive_mail!(raw)
+    receive_mail!(build_mail(message_id: "<dup-1@example.test>", body: "Different bytes, same Message-ID."))
+
+    assert_equal 1, requests.count
+    assert_equal 1, requests.sole.comments.count
+  end
+
+  test "a delivery that could not be used does not block a later retry with the same Message-ID" do
+    raw = build_mail(to: "globex@support.example.test", message_id: "<retry-1@example.test>")
+    receive_mail!(raw)
+    assert_equal 0, Request.count
+
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    receive_mail!(raw)
+
+    assert_equal 1, Request.count
+    assert_equal "globex", Request.sole.account.subdomain
+  end
+
+  test "a sender the app cannot store is refused with no customer left behind, and a corrected retry succeeds" do
+    receive_mail!(build_mail(from: "avery@exa_mple.test", message_id: "<bad-sender-1@example.test>"))
+
+    assert_equal 0, Request.count
+    assert_nil acme.users.find_by(email: "avery@exa_mple.test")
+
+    receive_mail!(build_mail(from: "avery@example.test", message_id: "<bad-sender-1@example.test>"))
+    assert_equal 1, Request.count
+  end
+
+  test "mail without a From header, or with no mail in it at all, is refused without an error" do
+    receive_mail!("To: acme@support.example.test\r\nMessage-ID: <no-from-1@example.test>\r\nSubject: hi\r\n\r\nHello\r\n")
+    receive_mail!("this is not an email at all")
+
+    assert_equal 0, Request.count
+    assert_equal %w[bounced bounced], ActionMailbox::InboundEmail.order(:id).last(2).map(&:status)
+  end
+
+  test "a delivery that loses the race for its Message-ID is refused and rolls back everything it wrote" do
+    receive_mail!(build_mail(from: "first@example.test", message_id: "<race-1@example.test>"))
+    assert_equal 1, Request.count
+
+    # Pretend this delivery's early check ran before the first one was saved, so only the claim
+    # at the end can refuse it.
+    original = SupportMailbox.instance_method(:already_delivered?)
+    SupportMailbox.define_method(:already_delivered?) { false }
+    begin
+      receive_mail!(build_mail(from: "second@example.test", message_id: "<race-1@example.test>"))
+    ensure
+      SupportMailbox.define_method(:already_delivered?, original)
+      SupportMailbox.send(:private, :already_delivered?)
+    end
+
+    assert_equal 1, Request.count
+    assert_nil acme.users.find_by(email: "second@example.test"), "the loser's new customer is rolled back"
+    assert_equal "bounced", ActionMailbox::InboundEmail.order(:id).last.status
+  end
+
+  test "a refused delivery does not block a corrected one with the same Message-ID" do
+    receive_mail!(build_mail(body: "   ", message_id: "<corrected-1@example.test>"))
+    receive_mail!(build_mail(body: "Here is the text.", message_id: "<corrected-1@example.test>"))
+
+    assert_equal "Here is the text.", requests.sole.comments.sole.body
+  end
+
+  test "automated and list mail opens no request" do
+    {
+      "auto-reply" => { "Auto-Submitted" => "auto-replied" },
+      "bulk" => { "Precedence" => "bulk" },
+      "list-post" => { "List-Id" => "<news.example.test>", "List-Unsubscribe" => "<mailto:leave@example.test>" },
+      "auto-responder" => { "X-Autoreply" => "yes" }
+    }.each do |name, headers|
+      receive_mail!(build_mail(headers: headers, message_id: "<#{name}@example.test>"))
+    end
+
+    assert_equal 0, Request.count
+  end
+
+  test "bounces, delivery reports and no-reply senders are ignored" do
+    receive_mail!(build_mail(headers: { "Return-Path" => "<>" }, message_id: "<bounce-1@example.test>"))
+    receive_mail!(build_mail(from: "MAILER-DAEMON@example.test", message_id: "<bounce-2@example.test>"))
+    receive_mail!(build_mail(from: "no-reply@example.test", message_id: "<notice-1@example.test>"))
+
+    assert_equal 0, Request.count
+  end
+
+  test "a human message with Auto-Submitted set to no is not treated as automated" do
+    receive_mail!(build_mail(headers: { "Auto-Submitted" => "no" }))
+
+    assert_equal 1, Request.count
+  end
+
+  test "an automated delivery does not block a later normal delivery with the same Message-ID" do
+    receive_mail!(build_mail(headers: { "Auto-Submitted" => "auto-replied" }, message_id: "<shared-1@example.test>"))
+    receive_mail!(build_mail(message_id: "<shared-1@example.test>"))
+
+    assert_equal 1, Request.count
+  end
+end
diff --git a/test/integration/invitation_acceptances_test.rb b/test/integration/invitation_acceptances_test.rb
new file mode 100644
index 0000000..9d6c60c
--- /dev/null
+++ b/test/integration/invitation_acceptances_test.rb
@@ -0,0 +1,225 @@
+require "test_helper"
+
+class InvitationAcceptancesTest < ActionDispatch::IntegrationTest
+  setup do
+    @owner_token = owner_session.dig("session", "token")
+    invite!(token: @owner_token, email: "sam@example.test", role: "agent")
+    @token = invitation_token
+  end
+
+  def preview(token: @token, headers: {})
+    post "/api/v1/invitation_previews", params: { invitation_preview: { token: token } }, headers: headers, as: :json
+  end
+
+  def accept(token: @token, name: "Sam", password: "my-team-password", headers: {})
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: token, name: name, password: password } },
+         headers: headers, as: :json
+  end
+
+  # --- Preview --------------------------------------------------------------------
+
+  test "the preview shows the invited email, role, business name, subdomain and expiry" do
+    preview
+
+    assert_response :ok
+    preview_body = json.fetch("invitation_preview")
+    assert_equal %w[business_name email expires_at role subdomain], preview_body.keys.sort
+    assert_equal "sam@example.test", preview_body["email"]
+    assert_equal "agent", preview_body["role"]
+    assert_equal "Acme", preview_body["business_name"]
+    assert_equal "acme", preview_body["subdomain"]
+    assert_equal Invitation.last.expires_at.iso8601(3), Time.zone.parse(preview_body["expires_at"]).iso8601(3)
+  end
+
+  test "previewing does not accept the invitation" do
+    preview
+    preview
+
+    assert_response :ok
+    assert_equal "pending", Invitation.last.status
+    assert_nil Invitation.last.accepted_at
+  end
+
+  test "an unknown token is an invalid token" do
+    preview(token: "not-a-real-token")
+
+    assert_response :unprocessable_content
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "a missing token is a 400" do
+    post "/api/v1/invitation_previews", params: { invitation_preview: {} }, as: :json
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "a token sent with another business's header is treated as invalid" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+
+    preview(headers: in_account("globex"))
+
+    assert_response :unprocessable_content
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "a token sent with its own business's header works" do
+    preview(headers: in_account("acme"))
+
+    assert_response :ok
+  end
+
+  test "an expired invitation cannot be previewed" do
+    travel Invitation::LIFETIME + 1.minute do
+      preview
+
+      assert_response :unprocessable_content
+      assert_equal "invitation_expired", json.dig("error", "code")
+    end
+  end
+
+  test "a revoked invitation cannot be previewed" do
+    delete "/api/v1/invitations/#{Invitation.last.id}", headers: bearer(@owner_token)
+
+    preview
+
+    assert_response :unprocessable_content
+    assert_equal "invitation_revoked", json.dig("error", "code")
+  end
+
+  # --- Accepting ------------------------------------------------------------------
+
+  test "accepting creates the user with the invited role and returns the user and account" do
+    accept
+
+    assert_response :created
+    assert_equal %w[account user], json.keys.sort
+    user = json.fetch("user")
+    assert_equal "Sam", user["name"]
+    assert_equal "sam@example.test", user["email"]
+    assert_equal "agent", user["role"]
+    assert_equal true, user["verified"]
+    assert_equal false, user["suspended"]
+    assert_equal "acme", json.dig("account", "subdomain")
+    assert_equal "Acme", json.dig("account", "name")
+    assert_equal "accepted", Invitation.last.status
+  end
+
+  test "the invitee can sign in right away, with no verification email" do
+    mails_before = ActionMailer::Base.deliveries.size
+
+    accept
+
+    assert_equal mails_before, ActionMailer::Base.deliveries.size
+    sign_in!(email: "sam@example.test", password: "my-team-password")
+    assert_equal "agent", json.dig("user", "role")
+  end
+
+  test "an admin invitation creates an admin, who is not the owner" do
+    invite!(token: @owner_token, email: "ann@example.test", role: "admin")
+
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: invitation_token(email: "ann@example.test"), name: "Ann", password: "my-team-password" } },
+         as: :json
+
+    assert_response :created
+    assert_equal "admin", json.dig("user", "role")
+    assert_not_equal Account.find_by!(subdomain: "acme").owner_id, json.dig("user", "id")
+  end
+
+  test "the link works once: a second acceptance is refused" do
+    accept
+    assert_response :created
+
+    accept(name: "Someone else")
+
+    assert_response :unprocessable_content
+    assert_equal "invitation_accepted", json.dig("error", "code")
+    assert_equal 1, User.where(email: "sam@example.test").count
+  end
+
+  test "a weak password is refused and the invitation stays pending for another try" do
+    accept(password: "short")
+
+    assert_response :unprocessable_content
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "details", "password").present?
+    assert_equal "pending", Invitation.last.status
+    assert_equal 0, User.where(email: "sam@example.test").count
+
+    accept
+    assert_response :created
+  end
+
+  test "a missing name is refused and the invitation stays pending" do
+    accept(name: "")
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "name").present?
+    assert_equal "pending", Invitation.last.status
+  end
+
+  test "accepting an expired invitation is refused" do
+    travel Invitation::LIFETIME + 1.minute do
+      accept
+
+      assert_response :unprocessable_content
+      assert_equal "invitation_expired", json.dig("error", "code")
+      assert_equal 0, User.where(email: "sam@example.test").count
+    end
+  end
+
+  test "accepting a revoked invitation is refused" do
+    delete "/api/v1/invitations/#{Invitation.last.id}", headers: bearer(@owner_token)
+
+    accept
+
+    assert_response :unprocessable_content
+    assert_equal "invitation_revoked", json.dig("error", "code")
+  end
+
+  test "the old link is refused after a resend" do
+    old_token = @token
+    post "/api/v1/invitations/#{Invitation.last.id}/resend", headers: bearer(@owner_token)
+
+    accept(token: old_token)
+    assert_response :unprocessable_content
+    assert_equal "invalid_token", json.dig("error", "code")
+
+    accept(token: invitation_token)
+    assert_response :created
+  end
+
+  test "an expired invitation cannot be revived once its email registers as a customer" do
+    id = Invitation.last.id
+    travel Invitation::LIFETIME + 1.minute do
+      # Registration is allowed again, because the invitation has expired.
+      customer_session(email: "sam@example.test", name: "Sam", password: "my-customer-password")
+
+      post "/api/v1/invitations/#{id}/resend", headers: bearer(@owner_token)
+      assert_response :unprocessable_content
+      assert json.dig("error", "details", "email").present?
+
+      accept
+      assert_response :unprocessable_content
+      assert_equal "invitation_expired", json.dig("error", "code")
+    end
+  end
+
+  test "accepting into a cancelled business is refused" do
+    post "/api/v1/account/cancel", headers: bearer(@owner_token)
+
+    accept
+
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+    assert_equal 0, User.where(email: "sam@example.test").count
+  end
+
+  test "accepting requires no sign-in" do
+    accept
+
+    assert_response :created
+  end
+end
diff --git a/test/integration/invitations_test.rb b/test/integration/invitations_test.rb
new file mode 100644
index 0000000..da0d5d8
--- /dev/null
+++ b/test/integration/invitations_test.rb
@@ -0,0 +1,441 @@
+require "test_helper"
+
+class InvitationsTest < ActionDispatch::IntegrationTest
+  setup do
+    @owner_token = owner_session.dig("session", "token")
+    @owner_id = Account.find_by!(subdomain: "acme").owner_id
+  end
+
+  def create_invitation(token: @owner_token, email: "sam@example.test", role: "agent")
+    post "/api/v1/invitations", params: { invitation: { email: email, role: role } }, headers: bearer(token), as: :json
+  end
+
+  def invitation_status(id)
+    get "/api/v1/invitations/#{id}", headers: bearer(@owner_token)
+    json.dig("invitation", "status")
+  end
+
+  # Invitation emails only; the signup also sends a verification email.
+  def invitation_mails
+    ActionMailer::Base.deliveries.select { |mail| mail.subject.include?("invited to join") }
+  end
+
+  # --- Creating -----------------------------------------------------------------
+
+  test "an admin invites an agent and the link points at the frontend accept page" do
+    create_invitation
+
+    assert_response :created
+    invitation = json.fetch("invitation")
+    assert_equal %w[accepted_at created_at email expires_at id invited_by revoked_at role status updated_at],
+                 invitation.keys.sort
+    assert_equal "sam@example.test", invitation["email"]
+    assert_equal "agent", invitation["role"]
+    assert_equal "pending", invitation["status"]
+    assert_equal({ "id" => @owner_id, "name" => "Jo" }, invitation["invited_by"])
+
+    link = latest_mail("sam@example.test").body.decoded[%r{http://localhost:3001/accept-invitation\?\S+}]
+    assert_equal "http://localhost:3001/accept-invitation?account=acme&token=#{invitation_token}", link
+  end
+
+  test "the response never includes the token" do
+    create_invitation
+
+    assert_no_match invitation_token, response.body
+  end
+
+  test "an admin can invite another admin" do
+    create_invitation(email: "ann@example.test", role: "admin")
+
+    assert_response :created
+    assert_equal "admin", json.dig("invitation", "role")
+  end
+
+  test "customers cannot be invited, only admins and agents" do
+    create_invitation(role: "customer")
+
+    assert_response :unprocessable_content
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "details", "role").present?
+    assert_empty invitation_mails
+  end
+
+  test "an invalid email is refused" do
+    create_invitation(email: "not-an-email")
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "email").present?
+  end
+
+  test "the email is normalized, so the same person cannot be invited twice" do
+    create_invitation(email: " Sam@Example.TEST ")
+    assert_response :created
+    assert_equal "sam@example.test", json.dig("invitation", "email")
+
+    create_invitation(email: "sam@example.test", role: "admin")
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "email").present?
+  end
+
+  test "agents and customers cannot invite anyone" do
+    add_staff!(email: "agent@acme.test", role: "agent")
+    agent_token = sign_in!(email: "agent@acme.test").dig("session", "token")
+    avery_token = customer_session.dig("session", "token")
+
+    create_invitation(token: agent_token)
+    assert_response :forbidden
+    create_invitation(token: avery_token)
+    assert_response :forbidden
+
+    assert_equal 0, Invitation.count
+  end
+
+  test "an invited admin can invite others, but cannot cancel the business" do
+    ann_token = invited_session!(admin_token: @owner_token, email: "ann@example.test", role: "admin").dig("session", "token")
+
+    create_invitation(token: ann_token, email: "bob@example.test")
+    assert_response :created
+
+    post "/api/v1/account/cancel", headers: bearer(ann_token)
+    assert_response :forbidden
+    assert_equal "forbidden", json.dig("error", "code")
+    assert_nil Account.find_by!(subdomain: "acme").cancelled_at
+  end
+
+  test "while the business is cancelled, only the owner can sign in, not an invited admin" do
+    invited_session!(admin_token: @owner_token, email: "ann@example.test", role: "admin")
+    post "/api/v1/account/cancel", headers: bearer(@owner_token)
+
+    sign_in(email: "ann@example.test", password: "my-team-password")
+
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+    sign_in(email: "jo@acme.test")
+    assert_response :created
+  end
+
+  test "a second invitation to an email with a pending invitation is refused, even with another role" do
+    create_invitation
+    assert_response :created
+
+    create_invitation(role: "admin")
+
+    assert_response :unprocessable_content
+    assert_equal 1, Invitation.where(email: "sam@example.test").count
+    assert_equal 1, invitation_mails.size
+  end
+
+  test "an email that already belongs to a member cannot be invited" do
+    add_staff!(email: "sam@example.test", role: "agent")
+
+    create_invitation
+
+    assert_response :unprocessable_content
+    assert_match(/already belongs/, json.dig("error", "details", "email").first)
+  end
+
+  test "an email that is registered as a customer cannot be invited" do
+    customer_session(email: "avery@example.test")
+
+    create_invitation(email: "avery@example.test")
+
+    assert_response :unprocessable_content
+  end
+
+  test "a revoked invitation no longer blocks a new one" do
+    create_invitation
+    delete "/api/v1/invitations/#{json.dig('invitation', 'id')}", headers: bearer(@owner_token)
+    assert_response :ok
+
+    create_invitation(role: "admin")
+
+    assert_response :created
+  end
+
+  test "an expired invitation no longer blocks a new one" do
+    create_invitation
+    travel Invitation::LIFETIME + 1.minute do
+      create_invitation(role: "admin")
+      assert_response :created
+    end
+  end
+
+  test "an invitation is refused when the business is cancelled" do
+    post "/api/v1/account/cancel", headers: bearer(@owner_token)
+    # Cancelling signs everyone out, so the owner signs in again. Only the owner can do that.
+    owner_token = sign_in!.dig("session", "token")
+
+    create_invitation(token: owner_token)
+
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+    assert_empty invitation_mails
+  end
+
+  # --- Listing and inspecting ----------------------------------------------------
+
+  test "lists invitations oldest first" do
+    create_invitation(email: "one@example.test")
+    create_invitation(email: "two@example.test")
+    create_invitation(email: "three@example.test")
+
+    get "/api/v1/invitations", headers: bearer(@owner_token)
+
+    assert_response :ok
+    assert_equal 3, json["count"]
+    ids = json.fetch("invitations").map { |i| i["id"] }
+    assert_equal ids.sort, ids
+  end
+
+  test "pagination applies to the invitation list" do
+    3.times { |i| create_invitation(email: "p#{i}@example.test") }
+
+    get "/api/v1/invitations", params: { per_page: 2 }, headers: bearer(@owner_token)
+
+    assert_equal 2, json.fetch("invitations").size
+    assert_equal 2, json["next_page"]
+  end
+
+  test "filters invitations by status" do
+    now = Time.current
+    travel_to now do
+      create_invitation(email: "old@example.test")
+      @old_id = json.dig("invitation", "id")
+      create_invitation(email: "revoked@example.test")
+      delete "/api/v1/invitations/#{json.dig('invitation', 'id')}", headers: bearer(@owner_token)
+      @revoked_id = json.dig("invitation", "id")
+      create_invitation(email: "accepted@example.test")
+      @accepted_id = json.dig("invitation", "id")
+      accept_invitation!(email: "accepted@example.test")
+    end
+
+    # Sent later, so it is still pending when the first one has expired.
+    travel_to now + Invitation::LIFETIME - 1.hour do
+      create_invitation(email: "new@example.test")
+      @new_id = json.dig("invitation", "id")
+    end
+
+    travel_to now + Invitation::LIFETIME + 1.minute do
+      filter = ->(status) do
+        get "/api/v1/invitations", params: { status: status }, headers: bearer(@owner_token)
+        assert_response :ok
+        json.fetch("invitations").map { |i| i["id"] }
+      end
+
+      assert_equal [@old_id], filter.call("expired")
+      assert_equal [@new_id], filter.call("pending")
+      assert_equal [@revoked_id], filter.call("revoked")
+      assert_equal [@accepted_id], filter.call("accepted")
+    end
+  end
+
+  test "an unknown status filter is a 400" do
+    get "/api/v1/invitations", params: { status: "lost" }, headers: bearer(@owner_token)
+
+    assert_response :bad_request
+    assert_equal "invalid_filter", json.dig("error", "code")
+  end
+
+  test "shows one invitation, and another business's invitation is not found" do
+    create_invitation
+    id = json.dig("invitation", "id")
+
+    get "/api/v1/invitations/#{id}", headers: bearer(@owner_token)
+    assert_response :ok
+    assert_equal id, json.dig("invitation", "id")
+
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    verify_email!(email: "jo@globex.test", subdomain: "globex")
+    globex_token = sign_in!(subdomain: "globex", email: "jo@globex.test").dig("session", "token")
+
+    get "/api/v1/invitations/#{id}", headers: bearer(globex_token)
+    assert_response :not_found
+  end
+
+  test "a missing invitation is a 404" do
+    get "/api/v1/invitations/999999", headers: bearer(@owner_token)
+
+    assert_response :not_found
+    assert_equal "not_found", json.dig("error", "code")
+  end
+
+  # --- Expiry ---------------------------------------------------------------------
+
+  test "an invitation expires after its lifetime" do
+    create_invitation
+    id = json.dig("invitation", "id")
+
+    travel Invitation::LIFETIME - 1.minute do
+      assert_equal "pending", invitation_status(id)
+    end
+    travel Invitation::LIFETIME + 1.minute do
+      assert_equal "expired", invitation_status(id)
+    end
+  end
+
+  # --- Resending ------------------------------------------------------------------
+
+  test "resending sends a new link, and the old link stops working" do
+    create_invitation
+    id = json.dig("invitation", "id")
+    old_token = invitation_token
+
+    post "/api/v1/invitations/#{id}/resend", headers: bearer(@owner_token)
+
+    assert_response :ok
+    assert_equal "pending", json.dig("invitation", "status")
+    assert_equal 2, invitation_mails.size
+    refute_equal old_token, invitation_token
+
+    post "/api/v1/invitation_previews", params: { invitation_preview: { token: old_token } }, as: :json
+    assert_response :unprocessable_content
+    assert_equal "invalid_token", json.dig("error", "code")
+
+    post "/api/v1/invitation_previews", params: { invitation_preview: { token: invitation_token } }, as: :json
+    assert_response :ok
+  end
+
+  test "resending an expired invitation renews it for the full lifetime" do
+    create_invitation
+    id = json.dig("invitation", "id")
+
+    travel Invitation::LIFETIME + 1.day do
+      post "/api/v1/invitations/#{id}/resend", headers: bearer(@owner_token)
+
+      assert_response :ok
+      assert_equal "pending", json.dig("invitation", "status")
+      assert_in_delta (Time.current + Invitation::LIFETIME).to_f, Time.zone.parse(json.dig("invitation", "expires_at")).to_f, 1
+    end
+  end
+
+  test "an accepted or revoked invitation cannot be resent" do
+    create_invitation(email: "accepted@example.test")
+    accepted_id = json.dig("invitation", "id")
+    accept_invitation!(email: "accepted@example.test")
+
+    post "/api/v1/invitations/#{accepted_id}/resend", headers: bearer(@owner_token)
+    assert_response :unprocessable_content
+    assert_equal "invitation_accepted", json.dig("error", "code")
+
+    create_invitation(email: "revoked@example.test")
+    revoked_id = json.dig("invitation", "id")
+    delete "/api/v1/invitations/#{revoked_id}", headers: bearer(@owner_token)
+
+    post "/api/v1/invitations/#{revoked_id}/resend", headers: bearer(@owner_token)
+    assert_response :unprocessable_content
+    assert_equal "invitation_revoked", json.dig("error", "code")
+  end
+
+  test "resending an expired invitation is refused if another invitation for the email is now pending" do
+    create_invitation(email: "sam@example.test", role: "agent")
+    old_id = json.dig("invitation", "id")
+
+    travel Invitation::LIFETIME + 1.minute do
+      create_invitation(email: "sam@example.test", role: "admin")
+      assert_response :created
+
+      post "/api/v1/invitations/#{old_id}/resend", headers: bearer(@owner_token)
+      assert_response :unprocessable_content
+      assert json.dig("error", "details", "email").present?
+    end
+  end
+
+  # --- Revoking -------------------------------------------------------------------
+
+  test "revoking keeps the record as revoked and stops the link working" do
+    create_invitation
+    id = json.dig("invitation", "id")
+
+    delete "/api/v1/invitations/#{id}", headers: bearer(@owner_token)
+
+    assert_response :ok
+    assert_equal "revoked", json.dig("invitation", "status")
+    assert json.dig("invitation", "revoked_at").present?
+    assert_equal "revoked", invitation_status(id)
+
+    post "/api/v1/invitation_previews", params: { invitation_preview: { token: invitation_token } }, as: :json
+    assert_response :unprocessable_content
+    assert_equal "invitation_revoked", json.dig("error", "code")
+  end
+
+  test "revoking an invitation twice is refused" do
+    create_invitation
+    id = json.dig("invitation", "id")
+    delete "/api/v1/invitations/#{id}", headers: bearer(@owner_token)
+
+    delete "/api/v1/invitations/#{id}", headers: bearer(@owner_token)
+
+    assert_response :unprocessable_content
+    assert_equal "invitation_revoked", json.dig("error", "code")
+  end
+
+  test "an accepted invitation cannot be revoked" do
+    create_invitation
+    id = json.dig("invitation", "id")
+    accept_invitation!
+
+    delete "/api/v1/invitations/#{id}", headers: bearer(@owner_token)
+
+    assert_response :unprocessable_content
+    assert_equal "invitation_accepted", json.dig("error", "code")
+    assert_equal "accepted", invitation_status(id)
+  end
+
+  test "an expired invitation can be revoked to close it out" do
+    create_invitation
+    id = json.dig("invitation", "id")
+
+    travel Invitation::LIFETIME + 1.minute do
+      delete "/api/v1/invitations/#{id}", headers: bearer(@owner_token)
+
+      assert_response :ok
+      assert_equal "revoked", json.dig("invitation", "status")
+    end
+  end
+
+  # --- Registration and pending invitations ---------------------------------------
+
+  test "customer registration cannot take a pending invitation's email" do
+    create_invitation(email: "sam@example.test")
+
+    post "/api/v1/registrations",
+         params: { user: { name: "Sam", email: "sam@example.test", password: "my-customer-password" } },
+         headers: in_account("acme"), as: :json
+
+    assert_response :unprocessable_content
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "details", "email").present?
+    refute User.exists?(email: "sam@example.test", role: "customer")
+  end
+
+  test "customer registration is allowed again once the invitation is revoked or expired" do
+    create_invitation(email: "sam@example.test")
+    id = json.dig("invitation", "id")
+    delete "/api/v1/invitations/#{id}", headers: bearer(@owner_token)
+
+    post "/api/v1/registrations",
+         params: { user: { name: "Sam", email: "sam@example.test", password: "my-customer-password" } },
+         headers: in_account("acme"), as: :json
+    assert_response :created
+  end
+
+  test "registration is refused for a pending invitation even with different capitalization" do
+    create_invitation(email: "sam@example.test")
+
+    post "/api/v1/registrations",
+         params: { user: { name: "Sam", email: "SAM@example.test", password: "my-customer-password" } },
+         headers: in_account("acme"), as: :json
+
+    assert_response :unprocessable_content
+  end
+
+  test "the refusal does not reveal that the email was invited" do
+    create_invitation(email: "sam@example.test")
+
+    post "/api/v1/registrations",
+         params: { user: { name: "Sam", email: "sam@example.test", password: "my-customer-password" } },
+         headers: in_account("acme"), as: :json
+
+    refute_match(/invit/i, response.body)
+  end
+end
diff --git a/test/integration/pagination_test.rb b/test/integration/pagination_test.rb
new file mode 100644
index 0000000..0c6f64a
--- /dev/null
+++ b/test/integration/pagination_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class PaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    owner_session
+    @customer = customer_session
+    @token = @customer.dig("session", "token")
+    @requester = User.find(@customer.dig("user", "id"))
+  end
+
+  def seed_requests(count)
+    count.times { |i| Request.submit!(requester: @requester, subject: "Issue #{i}", body: "Details #{i}") }
+  end
+
+  def list(params = {})
+    get "/api/v1/requests", params: params, headers: bearer(@token)
+    assert_response :ok, response.body
+    json
+  end
+
+  test "defaults to page 1 with 25 per page, and reports the paging fields" do
+    seed_requests(30)
+
+    body = list
+
+    assert_equal 25, body.fetch("requests").size
+    assert_equal({ "count" => 30, "page" => 1, "per_page" => 25, "next_page" => 2, "previous_page" => nil },
+                 body.slice("count", "page", "per_page", "next_page", "previous_page"))
+  end
+
+  test "walks through the pages using next_page and previous_page" do
+    seed_requests(30)
+
+    second = list(page: 2)
+    assert_equal 5, second.fetch("requests").size
+    assert_equal 1, second["previous_page"]
+    assert_nil second["next_page"]
+
+    back = list(page: second["previous_page"])
+    assert_equal 25, back.fetch("requests").size
+  end
+
+  test "pages cover every record once, with the requested page size" do
+    seed_requests(7)
+
+    first = list(per_page: 3, page: 1)
+    middle = list(per_page: 3, page: 2)
+    last = list(per_page: 3, page: 3)
+
+    assert_equal [3, 3, 1], [first, middle, last].map { |body| body["requests"].size }
+    assert_equal [2, 3, nil], [first, middle, last].map { |body| body["next_page"] }
+    assert_equal [nil, 1, 2], [first, middle, last].map { |body| body["previous_page"] }
+    ids = (first["requests"] + middle["requests"] + last["requests"]).map { |r| r["id"] }
+    assert_equal 7, ids.uniq.size
+  end
+
+  test "per_page above 100 is capped and the response shows the cap" do
+    seed_requests(3)
+
+    body = list(per_page: 500)
+
+    assert_equal 100, body["per_page"]
+    assert_equal 3, body.fetch("requests").size
+  end
+
+  test "a page past the end is empty and keeps the count" do
+    seed_requests(3)
+
+    body = list(page: 50)
+
+    assert_equal [], body.fetch("requests")
+    assert_equal 3, body["count"]
+    assert_equal 49, body["previous_page"]
+    assert_nil body["next_page"]
+  end
+
+  test "a huge page number is an empty page, not a server error" do
+    seed_requests(1)
+
+    body = list(page: "99999999999999999999999999")
+
+    assert_equal [], body.fetch("requests")
+  end
+
+  test "blank paging values use the defaults" do
+    seed_requests(1)
+
+    body = list(page: "", per_page: "")
+
+    assert_equal 1, body["page"]
+    assert_equal 25, body["per_page"]
+  end
+
+  test "invalid paging values are a 400 naming the parameter" do
+    seed_requests(1)
+
+    { page: %w[0 -1 abc 1.5], per_page: %w[0 -5 many] }.each do |name, values|
+      values.each do |value|
+        get "/api/v1/requests", params: { name => value }, headers: bearer(@token)
+        assert_response :bad_request, "expected #{name}=#{value} to be rejected"
+        assert_equal "invalid_pagination", json.dig("error", "code")
+        assert_includes json.dig("error", "message"), name.to_s
+      end
+    end
+  end
+
+  test "comment lists are paginated too" do
+    opened = open_request!(@token)
+    request_id = opened["id"]
+    request = Request.find(request_id)
+    3.times { |i| request.comments.create!(author: @requester, body: "Follow-up #{i}", public: true) }
+
+    get "/api/v1/requests/#{request_id}/comments", params: { per_page: 2 }, headers: bearer(@token)
+
+    assert_response :ok
+    assert_equal 2, json.fetch("comments").size
+    assert_equal 4, json["count"]
+    assert_equal 2, json["next_page"]
+    assert_nil json["previous_page"]
+  end
+end
diff --git a/test/integration/passwords_test.rb b/test/integration/passwords_test.rb
new file mode 100644
index 0000000..22bde6a
--- /dev/null
+++ b/test/integration/passwords_test.rb
@@ -0,0 +1,207 @@
+require "test_helper"
+
+class PasswordsTest < ActionDispatch::IntegrationTest
+  NEW_PASSWORD = "my-new-password".freeze
+
+  setup do
+    owner_session
+  end
+
+  # --- Changing a password while signed in -------------------------------------
+
+  test "a wrong current password is rejected and changes nothing" do
+    token = sign_in!.dig("session", "token")
+
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: "not-it", password: NEW_PASSWORD } },
+        headers: bearer(token),
+        as: :json
+
+    assert_response :unprocessable_content
+    assert_equal "invalid_current_password", json.dig("error", "code")
+    get "/api/v1/me", headers: bearer(token)
+    assert_response :ok
+  end
+
+  test "changing the password signs out every session and the new password works" do
+    first = sign_in!.dig("session", "token")
+    second = sign_in!.dig("session", "token")
+
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: PASSWORD, password: NEW_PASSWORD } },
+        headers: bearer(first),
+        as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: bearer(first)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: bearer(second)
+    assert_response :unauthorized
+
+    sign_in(password: PASSWORD)
+    assert_response :unauthorized
+
+    sign_in!(password: NEW_PASSWORD)
+  end
+
+  test "a blank new password is rejected and the old password still works" do
+    token = sign_in!.dig("session", "token")
+
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: PASSWORD, password: "" } },
+        headers: bearer(token),
+        as: :json
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "password").present?
+    sign_in!(password: PASSWORD)
+  end
+
+  test "a too-short new password is rejected and the session survives" do
+    token = sign_in!.dig("session", "token")
+
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: PASSWORD, password: "short" } },
+        headers: bearer(token),
+        as: :json
+
+    assert_response :unprocessable_content
+    get "/api/v1/me", headers: bearer(token)
+    assert_response :ok
+  end
+
+  test "password change requires a signed-in user" do
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: PASSWORD, password: NEW_PASSWORD } },
+        as: :json
+
+    assert_response :unauthorized
+  end
+
+  # --- Forgotten password -------------------------------------------------------
+
+  test "requesting a reset emails a link to the frontend" do
+    post "/api/v1/password_resets", params: { password_reset: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+
+    assert_response :accepted
+    token = link_token(to: "jo@acme.test", path: "/reset-password")
+    assert_includes latest_mail("jo@acme.test").body.decoded,
+                    "http://localhost:3001/reset-password?account=acme&token=#{token}"
+  end
+
+  test "an unknown email gets the same response and no mail" do
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/password_resets", params: { password_reset: { email: "nobody@acme.test" } },
+         headers: in_account("acme"), as: :json
+    unknown = [response.status, json]
+
+    post "/api/v1/password_resets", params: { password_reset: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+    known = [response.status, json]
+
+    assert_equal known.first, unknown.first
+    assert_equal known.last.keys, unknown.last.keys
+    assert_equal 1, ActionMailer::Base.deliveries.size, "only the known account should get mail"
+  end
+
+  test "a reset link sets the new password, signs everyone out, and works once" do
+    token_session = sign_in!.dig("session", "token")
+    post "/api/v1/password_resets", params: { password_reset: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+    token = link_token(to: "jo@acme.test", path: "/reset-password")
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: token, password: NEW_PASSWORD } }, as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: bearer(token_session)
+    assert_response :unauthorized
+    sign_in!(password: NEW_PASSWORD)
+    sign_in(password: PASSWORD)
+    assert_response :unauthorized
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: token, password: "another-password" } }, as: :json
+    assert_response :unprocessable_content
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "a newer reset request replaces the older link" do
+    post "/api/v1/password_resets", params: { password_reset: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+    old_token = link_token(to: "jo@acme.test", path: "/reset-password")
+
+    post "/api/v1/password_resets", params: { password_reset: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+    new_token = link_token(to: "jo@acme.test", path: "/reset-password")
+    refute_equal old_token, new_token
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: old_token, password: NEW_PASSWORD } }, as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: new_token, password: NEW_PASSWORD } }, as: :json
+    assert_response :ok
+  end
+
+  test "a reset link expires after an hour" do
+    post "/api/v1/password_resets", params: { password_reset: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+    token = link_token(to: "jo@acme.test", path: "/reset-password")
+
+    travel 61.minutes do
+      post "/api/v1/password_resets/confirm",
+           params: { password_reset: { token: token, password: NEW_PASSWORD } }, as: :json
+    end
+
+    assert_response :unprocessable_content
+    sign_in!(password: PASSWORD)
+  end
+
+  test "a rejected new password keeps the reset link usable" do
+    post "/api/v1/password_resets", params: { password_reset: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+    token = link_token(to: "jo@acme.test", path: "/reset-password")
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: token, password: "short" } }, as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: token, password: NEW_PASSWORD } }, as: :json
+    assert_response :ok
+    sign_in!(password: NEW_PASSWORD)
+  end
+
+  # --- Email verification re-requests --------------------------------------------
+
+  test "requesting another verification link replaces the earlier one" do
+    signup!(subdomain: "globex", name: "Globex", email: "ann@globex.test")
+    post "/api/v1/email_verifications", params: { email_verification: { email: "ann@globex.test" } },
+         headers: in_account("globex"), as: :json
+    assert_response :accepted
+    first = link_token(to: "ann@globex.test", path: "/verify-email")
+
+    post "/api/v1/email_verifications", params: { email_verification: { email: "ann@globex.test" } },
+         headers: in_account("globex"), as: :json
+    second = link_token(to: "ann@globex.test", path: "/verify-email")
+    refute_equal first, second
+
+    post "/api/v1/email_verifications/confirm", params: { email_verification: { token: first } }, as: :json
+    assert_response :unprocessable_content
+    post "/api/v1/email_verifications/confirm", params: { email_verification: { token: second } }, as: :json
+    assert_response :ok
+  end
+
+  test "re-requesting verification for an already verified email sends nothing" do
+    # The setup block already verified jo@acme.test.
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/email_verifications", params: { email_verification: { email: "jo@acme.test" } },
+         headers: in_account("acme"), as: :json
+
+    assert_response :accepted
+    assert_equal 0, ActionMailer::Base.deliveries.size
+  end
+end
diff --git a/test/integration/registrations_test.rb b/test/integration/registrations_test.rb
new file mode 100644
index 0000000..f9e091d
--- /dev/null
+++ b/test/integration/registrations_test.rb
@@ -0,0 +1,151 @@
+require "test_helper"
+
+class RegistrationsTest < ActionDispatch::IntegrationTest
+  setup do
+    owner_session
+  end
+
+  test "registers a customer who is unverified and is emailed a verification link" do
+    post "/api/v1/registrations", params: registration_params, headers: in_account("acme"), as: :json
+
+    assert_response :created
+    user = json.fetch("user")
+    assert_equal "Avery", user["name"]
+    assert_equal "avery@example.test", user["email"]
+    assert_equal "customer", user["role"]
+    assert_equal false, user["verified"]
+    assert_kind_of Integer, user["account_id"]
+    refute_includes response.body, CUSTOMER_PASSWORD
+
+    assert_match(/\A[A-Za-z0-9_-]{43}\z/, link_token(to: "avery@example.test", path: "/verify-email"))
+  end
+
+  test "a registrant cannot choose their role or business" do
+    params = registration_params
+    params[:user].merge!(role: "admin", account_id: 999)
+
+    post "/api/v1/registrations", params: params, headers: in_account("acme"), as: :json
+
+    assert_response :created
+    assert_equal "customer", json.dig("user", "role")
+    assert_equal Account.find_by!(subdomain: "acme").id, json.dig("user", "account_id")
+  end
+
+  test "the same email cannot register twice in one business" do
+    register!
+
+    post "/api/v1/registrations", params: registration_params(name: "Other"), headers: in_account("acme"), as: :json
+
+    assert_response :unprocessable_content
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "details", "email").present?
+  end
+
+  test "the same email can register with a different business" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    register!(subdomain: "acme")
+
+    register!(subdomain: "globex")
+
+    assert_equal 2, User.where(email: "avery@example.test", role: "customer").count
+  end
+
+  test "registration needs the business header, and an unknown business is a 404" do
+    post "/api/v1/registrations", params: registration_params, as: :json
+    assert_response :bad_request
+    assert_equal "account_required", json.dig("error", "code")
+
+    post "/api/v1/registrations", params: registration_params, headers: in_account("missing"), as: :json
+    assert_response :not_found
+    assert_equal "account_not_found", json.dig("error", "code")
+  end
+
+  test "a cancelled business does not take new registrations" do
+    token = sign_in!.dig("session", "token")
+    post "/api/v1/account/cancel", headers: bearer(token)
+
+    assert_no_difference -> { User.where(role: "customer").count } do
+      post "/api/v1/registrations", params: registration_params, headers: in_account("acme"), as: :json
+    end
+
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+  end
+
+  test "a short password is rejected and nothing is saved" do
+    assert_no_difference -> { User.count } do
+      post "/api/v1/registrations",
+           params: registration_params(password: "short"),
+           headers: in_account("acme"),
+           as: :json
+    end
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "password").present?
+  end
+
+  test "a non-object user envelope is a 400" do
+    post "/api/v1/registrations", params: { user: "avery" }, headers: in_account("acme"), as: :json
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "a customer signs in only after verifying, then uses the profile endpoints" do
+    register!
+    sign_in(email: "avery@example.test", password: CUSTOMER_PASSWORD, subdomain: "acme")
+    assert_response :forbidden
+    assert_equal "email_not_verified", json.dig("error", "code")
+
+    verify_email!(email: "avery@example.test")
+    token = sign_in!(email: "avery@example.test", password: CUSTOMER_PASSWORD).dig("session", "token")
+
+    get "/api/v1/me", headers: bearer(token)
+    assert_response :ok
+    assert_equal "customer", json.dig("user", "role")
+
+    patch "/api/v1/me", params: { user: { name: "Avery Stone" } }, headers: bearer(token), as: :json
+    assert_response :ok
+    assert_equal "Avery Stone", json.dig("user", "name")
+
+    put "/api/v1/me/password",
+        params: { password_change: { current_password: CUSTOMER_PASSWORD, password: "my-new-password" } },
+        headers: bearer(token),
+        as: :json
+    assert_response :ok
+    sign_in!(email: "avery@example.test", password: "my-new-password")
+  end
+
+  test "a customer recovers a forgotten password through the reset flow" do
+    customer_session
+
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "avery@example.test" } },
+         headers: in_account("acme"),
+         as: :json
+    assert_response :accepted
+
+    token = link_token(to: "avery@example.test", path: "/reset-password")
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: token, password: "my-reset-password" } },
+         as: :json
+    assert_response :ok
+
+    sign_in(email: "avery@example.test", password: CUSTOMER_PASSWORD)
+    assert_response :unauthorized
+    sign_in!(email: "avery@example.test", password: "my-reset-password")
+  end
+
+  test "a customer can ask for a new verification link" do
+    register!
+
+    post "/api/v1/email_verifications",
+         params: { email_verification: { email: "avery@example.test" } },
+         headers: in_account("acme"),
+         as: :json
+
+    assert_response :accepted
+    verify_email!(email: "avery@example.test")
+    sign_in!(email: "avery@example.test", password: CUSTOMER_PASSWORD)
+  end
+end
diff --git a/test/integration/request_filters_test.rb b/test/integration/request_filters_test.rb
new file mode 100644
index 0000000..1a9bbb1
--- /dev/null
+++ b/test/integration/request_filters_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+# Customers filter their own requests by status. Priority, assignment and search are staff
+# tools, so asking for them is refused rather than quietly ignored.
+class RequestFiltersTest < ActionDispatch::IntegrationTest
+  setup do
+    owner_session
+    add_staff!(email: "sam@acme.test")
+    @staff_token = sign_in!(email: "sam@acme.test").dig("session", "token")
+
+    avery = customer_session
+    @avery_token = avery.dig("session", "token")
+    @avery_id = avery.dig("user", "id")
+    ben = customer_session(email: "ben@example.test", name: "Ben")
+    @ben_token = ben.dig("session", "token")
+
+    @open = open_request!(@avery_token, subject: "Open one")
+    @pending = open_request!(@avery_token, subject: "Pending one")
+    @solved = open_request!(@avery_token, subject: "Solved one")
+    @ben_open = open_request!(@ben_token, subject: "Ben's open one")
+
+    staff_set_status(@pending["id"], "pending")
+    staff_set_status(@solved["id"], "solved")
+  end
+
+  def staff_set_status(id, status)
+    patch "/api/v1/tickets/#{id}", params: { ticket: { status: status } }, headers: bearer(@staff_token), as: :json
+    assert_response :ok, response.body
+  end
+
+  def listed(token: @avery_token, **params)
+    get "/api/v1/requests", params: params, headers: bearer(token)
+    assert_response :ok, response.body
+    json
+  end
+
+  def listed_ids(token: @avery_token, **params)
+    listed(token: token, **params).fetch("requests").map { |r| r["id"] }.sort
+  end
+
+  test "status filters the customer's own requests" do
+    assert_equal [@open["id"]], listed_ids(status: "open")
+    assert_equal [@pending["id"]], listed_ids(status: "pending")
+    assert_equal [@solved["id"]], listed_ids(status: "solved")
+  end
+
+  test "without a status, the customer sees all their own requests" do
+    assert_equal [@open["id"], @pending["id"], @solved["id"]].sort, listed_ids
+  end
+
+  test "a blank status is the same as no filter" do
+    assert_equal [@open["id"], @pending["id"], @solved["id"]].sort, listed_ids(status: "")
+  end
+
+  test "the status filter never shows another customer's requests" do
+    assert_equal [@ben_open["id"]], listed_ids(token: @ben_token, status: "open")
+  end
+
+  test "the status filter is paginated with its own count" do
+    body = listed(status: "open", per_page: 1)
+
+    assert_equal 1, body["count"]
+    assert_equal 1, body.fetch("requests").size
+    assert_nil body["next_page"]
+  end
+
+  test "an unknown status is refused" do
+    get "/api/v1/requests", params: { status: "lost" }, headers: bearer(@avery_token)
+
+    assert_response :bad_request
+    assert_equal "invalid_filter", json.dig("error", "code")
+    assert_includes json.dig("error", "message"), "status"
+  end
+
+  test "staff-only filters are refused for customers, including priority" do
+    { priority: "high", assignee_id: "unassigned", requester_id: @avery_id, q: "open" }.each do |name, value|
+      get "/api/v1/requests", params: { name => value }, headers: bearer(@avery_token)
+
+      assert_response :bad_request, "#{name} should be refused for customers"
+      assert_equal "invalid_filter", json.dig("error", "code")
+      assert_includes json.dig("error", "message"), name.to_s
+    end
+  end
+
+  test "a staff-only filter is refused even alongside a valid status" do
+    get "/api/v1/requests", params: { status: "open", priority: "high" }, headers: bearer(@avery_token)
+
+    assert_response :bad_request
+    assert_equal "invalid_filter", json.dig("error", "code")
+  end
+end
diff --git a/test/integration/requests_test.rb b/test/integration/requests_test.rb
new file mode 100644
index 0000000..c89623f
--- /dev/null
+++ b/test/integration/requests_test.rb
@@ -0,0 +1,352 @@
+require "test_helper"
+
+class RequestsTest < ActionDispatch::IntegrationTest
+  setup do
+    owner_session
+    add_staff!(email: "sam@acme.test")
+    @avery = customer_session
+    @avery_token = @avery.dig("session", "token")
+    @avery_id = @avery.dig("user", "id")
+    @ben = customer_session(email: "ben@example.test", name: "Ben")
+    @ben_token = @ben.dig("session", "token")
+    @staff_token = sign_in!(email: "sam@acme.test").dig("session", "token")
+  end
+
+  def request_ids(scope = nil)
+    json.fetch("requests").map { |r| r["id"] }
+  end
+
+  def customer_patch(token, id, request_body)
+    patch "/api/v1/requests/#{id}", params: { request: request_body }, headers: bearer(token), as: :json
+  end
+
+  # Moves a request to pending through the staff route.
+  def staff_set_status(id, status)
+    patch "/api/v1/tickets/#{id}", params: { ticket: { status: status } }, headers: bearer(@staff_token), as: :json
+    assert_response :ok, response.body
+  end
+
+  # --- Opening a request --------------------------------------------------------
+
+  test "opening a request returns it as open, with its first comment" do
+    post "/api/v1/requests",
+         params: { request: { subject: "Cannot download my receipt", comment: { body: "The download button does nothing." } } },
+         headers: bearer(@avery_token),
+         as: :json
+
+    assert_response :created
+    request = json.fetch("request")
+    assert_equal %w[created_at id merged_into_id requester_id status subject updated_at], request.keys.sort
+    assert_equal "Cannot download my receipt", request["subject"]
+    assert_equal "open", request["status"]
+    assert_equal @avery_id, request["requester_id"]
+    assert request["created_at"].present?
+    assert request["updated_at"].present?
+
+    saved = Request.find(request["id"])
+    assert_equal [["The download button does nothing.", true]], saved.comments.map { |c| [c.body, c.public?] }
+    assert_equal @avery_id, saved.comments.first.author_id
+  end
+
+  test "opening a request needs a subject and a comment body" do
+    assert_no_difference -> { Request.count } do
+      post "/api/v1/requests", params: { request: { subject: "", comment: { body: "Help" } } }, headers: bearer(@avery_token), as: :json
+    end
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "subject").present?
+
+    assert_no_difference -> { Request.count } do
+      post "/api/v1/requests", params: { request: { subject: "Help", comment: { body: "  " } } }, headers: bearer(@avery_token), as: :json
+    end
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "body").present?
+  end
+
+  test "a request without a comment envelope is a 400" do
+    post "/api/v1/requests", params: { request: { subject: "Help" } }, headers: bearer(@avery_token), as: :json
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "a customer cannot set status, requester or business when opening a request" do
+    post "/api/v1/requests",
+         params: { request: { subject: "Help", status: "solved", requester_id: @ben.dig("user", "id"),
+                              comment: { body: "Please help." } } },
+         headers: bearer(@avery_token),
+         as: :json
+
+    assert_response :created
+    assert_equal "open", json.dig("request", "status")
+    assert_equal @avery_id, json.dig("request", "requester_id")
+  end
+
+  # --- Listing and showing ------------------------------------------------------
+
+  test "lists only the customer's own requests, most recently active first" do
+    first = open_request!(@avery_token, subject: "First")
+    open_request!(@ben_token, subject: "Ben's")
+    second = open_request!(@avery_token, subject: "Second")
+
+    # A new reply makes the first request the most recently active one.
+    customer_patch(@avery_token, first["id"], comment: { body: "Still broken." })
+
+    get "/api/v1/requests", headers: bearer(@avery_token)
+
+    assert_response :ok
+    assert_equal [first["id"], second["id"]], request_ids
+    assert_equal 2, json["count"]
+    assert_equal 1, json["page"]
+    assert_equal 25, json["per_page"]
+    assert_nil json["next_page"]
+    assert_nil json["previous_page"]
+  end
+
+  test "a customer can open their own request" do
+    opened = open_request!(@avery_token)
+
+    get "/api/v1/requests/#{opened['id']}", headers: bearer(@avery_token)
+
+    assert_response :ok
+    assert_equal opened["id"], json.dig("request", "id")
+    assert_equal "open", json.dig("request", "status")
+  end
+
+  test "another customer's request looks missing" do
+    opened = open_request!(@ben_token)
+
+    get "/api/v1/requests/#{opened['id']}", headers: bearer(@avery_token)
+
+    assert_response :not_found
+    assert_equal "not_found", json.dig("error", "code")
+    customer_patch(@avery_token, opened["id"], comment: { body: "Hello?" })
+    assert_response :not_found
+    get "/api/v1/requests/#{opened['id']}/comments", headers: bearer(@avery_token)
+    assert_response :not_found
+  end
+
+  test "a request id from another business is not found" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    customer_session(subdomain: "globex", email: "ivy@globex.test", name: "Ivy")
+    globex_token = sign_in!(subdomain: "globex", email: "ivy@globex.test", password: CUSTOMER_PASSWORD)
+                   .dig("session", "token")
+    elsewhere = open_request!(globex_token)
+
+    get "/api/v1/requests/#{elsewhere['id']}", headers: bearer(@avery_token)
+
+    assert_response :not_found
+  end
+
+  test "an unknown or non-numeric request id is a 404" do
+    get "/api/v1/requests/999999", headers: bearer(@avery_token)
+    assert_response :not_found
+
+    get "/api/v1/requests/abc", headers: bearer(@avery_token)
+    assert_response :not_found
+  end
+
+  test "request endpoints need a session" do
+    get "/api/v1/requests"
+    assert_response :unauthorized
+
+    post "/api/v1/requests", params: { request: { subject: "Help", comment: { body: "Help" } } }, as: :json
+    assert_response :unauthorized
+  end
+
+  # --- Replying -----------------------------------------------------------------
+
+  test "a reply to an open request keeps it open" do
+    opened = open_request!(@avery_token)
+
+    customer_patch(@avery_token, opened["id"], comment: { body: "Any update?" })
+
+    assert_response :ok
+    assert_equal "open", json.dig("request", "status")
+    assert_equal 2, Request.find(opened["id"]).comments.count
+  end
+
+  test "a reply reopens a pending request" do
+    opened = open_request!(@avery_token)
+    staff_set_status(opened["id"], "pending")
+
+    customer_patch(@avery_token, opened["id"], comment: { body: "I tried again and it still fails." })
+
+    assert_response :ok
+    assert_equal "open", json.dig("request", "status")
+  end
+
+  test "a reply reopens a solved request" do
+    opened = open_request!(@avery_token)
+    staff_set_status(opened["id"], "solved")
+
+    customer_patch(@avery_token, opened["id"], comment: { body: "It is broken again." })
+
+    assert_response :ok
+    assert_equal "open", json.dig("request", "status")
+  end
+
+  test "a reply that marks the request solved leaves it solved" do
+    opened = open_request!(@avery_token)
+    staff_set_status(opened["id"], "pending")
+
+    customer_patch(@avery_token, opened["id"], comment: { body: "Works now, thanks." }, status: "solved")
+
+    assert_response :ok
+    assert_equal "solved", json.dig("request", "status")
+  end
+
+  test "marking solved without a comment solves the request" do
+    opened = open_request!(@avery_token)
+
+    customer_patch(@avery_token, opened["id"], status: "solved")
+
+    assert_response :ok
+    assert_equal "solved", json.dig("request", "status")
+    assert_equal 1, Request.find(opened["id"]).comments.count
+  end
+
+  test "customers can mark a request solved but cannot set open or pending" do
+    opened = open_request!(@avery_token)
+
+    %w[pending open].each do |status|
+      assert_no_difference -> { Comment.count } do
+        customer_patch(@avery_token, opened["id"], comment: { body: "Trying to sneak a status in." }, status: status)
+      end
+      assert_response :unprocessable_content
+      assert json.dig("error", "details", "status").present?
+    end
+    assert_equal "open", Request.find(opened["id"]).status
+  end
+
+  test "a blank reply is rejected and does not reopen the request" do
+    opened = open_request!(@avery_token)
+    staff_set_status(opened["id"], "solved")
+
+    assert_no_difference -> { Comment.count } do
+      customer_patch(@avery_token, opened["id"], comment: { body: "" })
+    end
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "body").present?
+    assert_equal "solved", Request.find(opened["id"]).status
+  end
+
+  test "a reply with neither a comment nor a status is rejected" do
+    opened = open_request!(@avery_token)
+
+    customer_patch(@avery_token, opened["id"], subject: "Changed my mind")
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "base").present?
+  end
+
+  test "a reply envelope must be an object" do
+    opened = open_request!(@avery_token)
+
+    patch "/api/v1/requests/#{opened['id']}", params: { request: "solved" }, headers: bearer(@avery_token), as: :json
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  # --- Comments -----------------------------------------------------------------
+
+  test "comments show public messages only, oldest first, with their author" do
+    opened = open_request!(@avery_token, body: "The download button does nothing.")
+    request = Request.find(opened["id"])
+    staff = User.find_by!(email: "sam@acme.test")
+
+    request.comments.create!(author: staff, body: "Looking into it.", public: true)
+    request.comments.create!(author: staff, body: "Internal: check billing logs.", public: false)
+    customer_patch(@avery_token, opened["id"], comment: { body: "Still nothing on Safari." })
+
+    get "/api/v1/requests/#{opened['id']}/comments", headers: bearer(@avery_token)
+
+    assert_response :ok
+    comments = json.fetch("comments")
+    assert_equal ["The download button does nothing.", "Looking into it.", "Still nothing on Safari."],
+                 comments.map { |c| c["body"] }
+    assert_equal [true, true, true], comments.map { |c| c["public"] }
+    assert_equal({ "id" => @avery_id, "name" => "Avery" }, comments.first["author"])
+    assert_equal({ "id" => staff.id, "name" => "Sam" }, comments.second["author"])
+    assert comments.first["created_at"].present?
+    assert_equal %w[author body created_at id public], comments.first.keys.sort
+    assert_equal 3, json["count"]
+  end
+
+  test "a customer's comment list is paginated" do
+    opened = open_request!(@avery_token)
+    customer_patch(@avery_token, opened["id"], comment: { body: "Second" })
+    customer_patch(@avery_token, opened["id"], comment: { body: "Third" })
+
+    get "/api/v1/requests/#{opened['id']}/comments", params: { per_page: 2, page: 2 }, headers: bearer(@avery_token)
+
+    assert_response :ok
+    assert_equal ["Third"], json.fetch("comments").map { |c| c["body"] }
+    assert_equal 3, json["count"]
+    assert_equal 1, json["previous_page"]
+    assert_nil json["next_page"]
+  end
+
+  # --- Business boundaries ------------------------------------------------------
+
+  test "a customer session used with another business's header is refused" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+
+    get "/api/v1/requests", headers: bearer(@avery_token).merge(in_account("globex"))
+
+    assert_response :forbidden
+    assert_equal "wrong_account", json.dig("error", "code")
+  end
+
+  test "subjects and comments have length limits" do
+    post "/api/v1/requests",
+         params: { request: { subject: "s" * 256, comment: { body: "Help" } } },
+         headers: bearer(@avery_token),
+         as: :json
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "subject").present?
+
+    opened = open_request!(@avery_token)
+    customer_patch(@avery_token, opened["id"], comment: { body: "b" * 10_001 })
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "body").present?
+
+    customer_patch(@avery_token, opened["id"], comment: { body: "b" * 10_000 })
+    assert_response :ok
+  end
+
+  test "marking an already solved request solved again is a no-op" do
+    opened = open_request!(@avery_token)
+    staff_set_status(opened["id"], "solved")
+
+    customer_patch(@avery_token, opened["id"], status: "solved")
+
+    assert_response :ok
+    assert_equal "solved", json.dig("request", "status")
+    assert_equal 1, Request.find(opened["id"]).comments.count
+  end
+
+  test "there is no PUT route for requests" do
+    opened = open_request!(@avery_token)
+
+    put "/api/v1/requests/#{opened['id']}", params: { request: { status: "solved" } }, headers: bearer(@avery_token), as: :json
+
+    assert_response :not_found
+    assert_equal "open", Request.find(opened["id"]).status
+  end
+
+  test "a cancelled business blocks requests for its customers" do
+    opened = open_request!(@avery_token)
+    owner_token = sign_in!.dig("session", "token")
+    post "/api/v1/account/cancel", headers: bearer(owner_token)
+
+    get "/api/v1/requests", headers: bearer(@avery_token)
+    assert_response :unauthorized
+
+    token = Session.start_for(User.find(@avery_id)).token
+    get "/api/v1/requests/#{opened['id']}", headers: bearer(token)
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+  end
+end
diff --git a/test/integration/signup_test.rb b/test/integration/signup_test.rb
new file mode 100644
index 0000000..abb34e0
--- /dev/null
+++ b/test/integration/signup_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class SignupTest < ActionDispatch::IntegrationTest
+  test "creates the business and its admin, unverified, and returns both" do
+    post "/api/v1/account/create", params: signup_params, as: :json
+
+    assert_response :created
+    account = json.fetch("account")
+    user = json.fetch("user")
+
+    assert_kind_of Integer, account["id"]
+    assert_equal "Acme", account["name"]
+    assert_equal "acme", account["subdomain"]
+    assert account["created_at"].present?
+    assert account["updated_at"].present?
+
+    assert_kind_of Integer, user["id"]
+    assert_equal account["id"], user["account_id"]
+    assert_equal "Jo", user["name"]
+    assert_equal "jo@acme.test", user["email"]
+    assert_equal "admin", user["role"]
+    assert_equal false, user["verified"]
+    assert user["created_at"].present?
+    assert user["updated_at"].present?
+  end
+
+  test "never returns the password or its digest" do
+    post "/api/v1/account/create", params: signup_params, as: :json
+
+    assert_response :created
+    refute_includes response.body, PASSWORD
+    refute_includes response.body, "password"
+  end
+
+  test "emails a verification link to the frontend, from the configured sender" do
+    post "/api/v1/account/create", params: signup_params, as: :json
+    assert_response :created
+
+    mail = latest_mail("jo@acme.test")
+    assert_equal ["support@example.test"], mail.from
+    assert_match "Verify your email", mail.subject
+
+    token = link_token(to: "jo@acme.test", path: "/verify-email")
+    assert_match(/\A[A-Za-z0-9_-]{43}\z/, token)
+    assert_includes mail.body.decoded, "http://localhost:3001/verify-email?account=acme&token=#{token}"
+  end
+
+  test "rejects a subdomain that is already taken, case-insensitively" do
+    signup!(subdomain: "acme")
+
+    post "/api/v1/account/create", params: signup_params(subdomain: "ACME", email: "other@acme.test"), as: :json
+
+    assert_response :unprocessable_content
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert json.dig("error", "details", "account", "subdomain").present?
+  end
+
+  test "rejects reserved and malformed subdomains" do
+    %w[www api bad_name -lead trail- has.dot].each do |subdomain|
+      post "/api/v1/account/create", params: signup_params(subdomain: subdomain), as: :json
+      assert_response :unprocessable_content, "expected #{subdomain.inspect} to be rejected"
+    end
+  end
+
+  test "rejects a short password, and keeps no account" do
+    assert_no_difference -> { Account.count } do
+      post "/api/v1/account/create", params: signup_params(password: "short"), as: :json
+    end
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "admin", "password").present?
+  end
+
+  test "requires the admin object" do
+    post "/api/v1/account/create", params: { account: { name: "Acme", subdomain: "acme" } }, as: :json
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "a non-object envelope is a 400, not a server error" do
+    post "/api/v1/account/create", params: { account: "acme" }, as: :json
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+
+    post "/api/v1/account/create", params: { account: { name: "Acme", subdomain: "acme", admin: "jo" } }, as: :json
+    assert_response :bad_request
+  end
+
+  test "the same email can register separate businesses" do
+    signup!(subdomain: "acme", email: "jo@shared.test")
+    signup!(subdomain: "globex", name: "Globex", email: "jo@shared.test")
+
+    assert_equal 2, User.where(email: "jo@shared.test").count
+    assert_equal 2, Account.count
+  end
+
+  test "a business cannot have the same email twice" do
+    signup!(subdomain: "acme", email: "jo@acme.test")
+    account = Account.find_by!(subdomain: "acme")
+
+    duplicate = account.users.build(name: "Other", email: "JO@acme.test", password: PASSWORD, role: "agent")
+    refute duplicate.valid?
+    assert duplicate.errors[:email].present?
+  end
+end
diff --git a/test/integration/tenancy_test.rb b/test/integration/tenancy_test.rb
new file mode 100644
index 0000000..9f035b5
--- /dev/null
+++ b/test/integration/tenancy_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class TenancyTest < ActionDispatch::IntegrationTest
+  test "the same email in two businesses has independent passwords and sessions" do
+    owner_session(subdomain: "acme", email: "jo@shared.test", password: "acme-password-1")
+    signup!(subdomain: "globex", name: "Globex", email: "jo@shared.test", password: "globex-password-1")
+    verify_email!(email: "jo@shared.test", subdomain: "globex")
+
+    acme = sign_in!(email: "jo@shared.test", password: "acme-password-1", subdomain: "acme")
+    globex = sign_in!(email: "jo@shared.test", password: "globex-password-1", subdomain: "globex")
+
+    assert_equal "acme", acme.dig("account", "subdomain")
+    assert_equal "globex", globex.dig("account", "subdomain")
+    refute_equal acme.dig("user", "id"), globex.dig("user", "id")
+
+    # Each business's password only works in its own business.
+    sign_in(email: "jo@shared.test", password: "globex-password-1", subdomain: "acme")
+    assert_response :unauthorized
+  end
+
+  test "signed-in users see their full account" do
+    body = owner_session
+    get "/api/v1/account", headers: bearer(body.dig("session", "token"))
+
+    assert_response :ok
+    account = json.fetch("account")
+    assert_equal "Acme", account["name"]
+    assert_equal "acme", account["subdomain"]
+    assert_equal "active", account["status"]
+    assert_nil account["cancelled_at"]
+    assert_nil account["reactivate_by"]
+    assert account["created_at"].present?
+  end
+
+  test "GET /portal is public and returns the name and subdomain" do
+    signup!
+
+    get "/api/v1/portal", headers: in_account("acme")
+
+    assert_response :ok
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, json)
+  end
+
+  test "GET /portal needs the business header" do
+    get "/api/v1/portal"
+
+    assert_response :bad_request
+    assert_equal "account_required", json.dig("error", "code")
+  end
+
+  test "GET /portal for an unknown business is a 404" do
+    get "/api/v1/portal", headers: in_account("missing")
+
+    assert_response :not_found
+    assert_equal "account_not_found", json.dig("error", "code")
+  end
+
+  test "the header is case-insensitive" do
+    signup!
+
+    get "/api/v1/portal", headers: in_account("ACME")
+
+    assert_response :ok
+  end
+
+  test "unknown API paths return JSON 404" do
+    get "/api/v1/does-not-exist"
+
+    assert_response :not_found
+    assert_equal "not_found", json.dig("error", "code")
+  end
+
+  test "malformed JSON gets a JSON 400" do
+    post "/api/v1/account/create",
+         params: "{not json",
+         headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :bad_request
+    assert_equal "invalid_json", json.dig("error", "code")
+  end
+end
diff --git a/test/integration/ticket_assignments_test.rb b/test/integration/ticket_assignments_test.rb
new file mode 100644
index 0000000..999b520
--- /dev/null
+++ b/test/integration/ticket_assignments_test.rb
@@ -0,0 +1,231 @@
+require "test_helper"
+
+# Assignments and private notes are internal. They must never change what the customer
+# sees: the request's status, its updated_at, or where it sits in the customer's list.
+class TicketAssignmentsTest < ActionDispatch::IntegrationTest
+  setup do
+    @owner_session = owner_session
+    @owner_token = @owner_session.dig("session", "token")
+    @owner_id = @owner_session.dig("user", "id")
+    @agent_session = invited_session!(admin_token: @owner_token, email: "sam@example.test", role: "agent")
+    @agent_token = @agent_session.dig("session", "token")
+    @agent_id = @agent_session.dig("user", "id")
+    @avery_session = customer_session
+    @avery_token = @avery_session.dig("session", "token")
+    @avery_id = @avery_session.dig("user", "id")
+  end
+
+  def open_request(subject: "Receipt", token: @avery_token)
+    post "/api/v1/requests", params: { request: { subject: subject, comment: { body: "Broken" } } },
+         headers: bearer(token), as: :json
+    assert_response :created, response.body
+    json.fetch("request")
+  end
+
+  def staff_patch(id, ticket, token: @agent_token)
+    patch "/api/v1/tickets/#{id}", params: { ticket: ticket }, headers: bearer(token), as: :json
+  end
+
+  def customer_view(id)
+    get "/api/v1/requests/#{id}", headers: bearer(@avery_token)
+    assert_response :ok
+    json.fetch("request")
+  end
+
+  # --- Assigning --------------------------------------------------------------------
+
+  test "staff assign a ticket to a staff member, and the ticket shows the assignee's ID and name" do
+    opened = open_request
+
+    staff_patch(opened["id"], { assignee_id: @agent_id })
+
+    assert_response :ok
+    assert_equal @agent_id, json.dig("ticket", "assignee_id")
+    assert_equal({ "id" => @agent_id, "name" => "Sam" }, json.dig("ticket", "assignee"))
+  end
+
+  test "an agent can assign a ticket, including to an admin" do
+    opened = open_request
+
+    staff_patch(opened["id"], { assignee_id: @owner_id }, token: @agent_token)
+
+    assert_response :ok
+    assert_equal @owner_id, json.dig("ticket", "assignee_id")
+  end
+
+  test "assigning null clears the assignee" do
+    opened = open_request
+    staff_patch(opened["id"], { assignee_id: @agent_id })
+
+    staff_patch(opened["id"], { assignee_id: nil })
+
+    assert_response :ok
+    assert_nil json.dig("ticket", "assignee_id")
+    assert_nil json.dig("ticket", "assignee")
+    assert_nil Request.find(opened["id"]).assignee_id
+  end
+
+  test "the assignee is shown on the ticket list and on a single ticket" do
+    opened = open_request
+    staff_patch(opened["id"], { assignee_id: @agent_id })
+
+    get "/api/v1/tickets", headers: bearer(@owner_token)
+    assert_equal({ "id" => @agent_id, "name" => "Sam" }, json.fetch("tickets").first["assignee"])
+
+    get "/api/v1/tickets/#{opened['id']}", headers: bearer(@owner_token)
+    assert_equal @agent_id, json.dig("ticket", "assignee_id")
+  end
+
+  test "an assignment can come with a private note, and both are saved" do
+    opened = open_request
+
+    staff_patch(opened["id"], { assignee_id: @agent_id, comment: { body: "Mine now.", public: false } })
+
+    assert_response :ok
+    assert_equal @agent_id, Request.find(opened["id"]).assignee_id
+    assert_equal "Mine now.", Request.find(opened["id"]).comments.order(:id).last.body
+  end
+
+  test "a customer cannot assign tickets" do
+    opened = open_request
+
+    staff_patch(opened["id"], { assignee_id: @agent_id }, token: @avery_token)
+
+    assert_response :forbidden
+    assert_nil Request.find(opened["id"]).assignee_id
+  end
+
+  test "only active agents and admins can be assigned" do
+    opened = open_request
+
+    staff_patch(opened["id"], { assignee_id: @avery_id })
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "assignee").present?
+
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    globex_user_id = Account.find_by!(subdomain: "globex").users.first.id
+    staff_patch(opened["id"], { assignee_id: globex_user_id })
+    assert_response :unprocessable_content
+
+    staff_patch(opened["id"], { assignee_id: 999_999 })
+    assert_response :unprocessable_content
+
+    patch "/api/v1/users/#{@agent_id}", params: { user: { suspended: true } }, headers: bearer(@owner_token), as: :json
+    # Suspended staff are not offered as assignees, even by an admin.
+    staff_patch(opened["id"], { assignee_id: @agent_id }, token: @owner_token)
+    assert_response :unprocessable_content
+
+    assert_nil Request.find(opened["id"]).assignee_id
+  end
+
+  test "an assignee ID must be a whole number, so a trailing letter cannot assign someone else" do
+    opened = open_request
+
+    staff_patch(opened["id"], { assignee_id: "#{@agent_id}abc" })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "assignee_id").present?
+    assert_nil Request.find(opened["id"]).assignee_id
+  end
+
+  test "a numeric string assignee ID works" do
+    opened = open_request
+
+    staff_patch(opened["id"], { assignee_id: @agent_id.to_s })
+
+    assert_response :ok
+    assert_equal @agent_id, json.dig("ticket", "assignee_id")
+  end
+
+  test "an update with no comment, status or assignee is refused" do
+    opened = open_request
+
+    staff_patch(opened["id"], { subject: "Renamed" })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "base").present?
+  end
+
+  test "another business's ticket cannot be assigned" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    verify_email!(email: "jo@globex.test", subdomain: "globex")
+    globex_token = sign_in!(subdomain: "globex", email: "jo@globex.test").dig("session", "token")
+    globex_customer = customer_session(subdomain: "globex", email: "ivy@globex.test", name: "Ivy")
+    elsewhere = open_request(token: globex_customer.dig("session", "token"))
+
+    staff_patch(elsewhere["id"], { assignee_id: @agent_id })
+    assert_response :not_found
+
+    staff_patch(elsewhere["id"], { assignee_id: nil }, token: globex_token)
+    assert_response :ok
+  end
+
+  # --- Internal activity does not change the customer's request ----------------------
+
+  test "assigning a ticket leaves the customer's view and list position unchanged" do
+    opened = open_request
+    before = customer_view(opened["id"])
+    other = open_request(subject: "Another")
+
+    travel 2.hours do
+      staff_patch(opened["id"], { assignee_id: @agent_id })
+      assert_response :ok
+    end
+
+    assert_equal before, customer_view(opened["id"])
+    get "/api/v1/requests", headers: bearer(@avery_token)
+    assert_equal [other["id"], opened["id"]], json.fetch("requests").map { |r| r["id"] }
+    assert_nil json.dig("request", "assignee_id")
+  end
+
+  test "a private note leaves the customer's view and list position unchanged" do
+    opened = open_request
+    other = open_request(subject: "Another")
+    before = customer_view(opened["id"])
+
+    travel 2.hours do
+      staff_patch(opened["id"], { comment: { body: "Checking billing.", public: false } })
+      assert_response :ok
+    end
+
+    assert_equal before, customer_view(opened["id"])
+    get "/api/v1/requests", headers: bearer(@avery_token)
+    assert_equal [other["id"], opened["id"]], json.fetch("requests").map { |r| r["id"] }
+    assert_equal "open", customer_view(opened["id"])["status"]
+  end
+
+  test "a private note does not hide an earlier public reply from the ordering or change the status" do
+    opened = open_request
+    staff_patch(opened["id"], { comment: { body: "Fixed.", public: true }, status: "solved" })
+    solved = customer_view(opened["id"])
+
+    travel 1.hour do
+      staff_patch(opened["id"], { comment: { body: "Private follow-up.", public: false } })
+    end
+
+    assert_equal solved, customer_view(opened["id"])
+  end
+
+  test "a public staff reply still counts as activity for the customer" do
+    opened = open_request
+    before = customer_view(opened["id"])
+
+    travel 1.hour do
+      staff_patch(opened["id"], { comment: { body: "We are on it." } })
+    end
+
+    after = customer_view(opened["id"])
+    assert_operator Time.zone.parse(after["updated_at"]), :>, Time.zone.parse(before["updated_at"])
+  end
+
+  test "the customer's request view never shows the assignee" do
+    opened = open_request
+    staff_patch(opened["id"], { assignee_id: @agent_id })
+
+    view = customer_view(opened["id"])
+
+    refute view.key?("assignee")
+    refute view.key?("assignee_id")
+    assert_equal %w[created_at id merged_into_id requester_id status subject updated_at], view.keys.sort
+  end
+end
diff --git a/test/integration/ticket_filters_test.rb b/test/integration/ticket_filters_test.rb
new file mode 100644
index 0000000..8b84fc3
--- /dev/null
+++ b/test/integration/ticket_filters_test.rb
@@ -0,0 +1,234 @@
+require "test_helper"
+
+# Staff filters on GET /api/v1/tickets. Filters combine with AND, and search treats the
+# text as literal.
+class TicketFiltersTest < ActionDispatch::IntegrationTest
+  setup do
+    owner = owner_session
+    @owner_token = owner.dig("session", "token")
+    @owner_id = owner.dig("user", "id")
+    @sam_id = add_staff!(email: "sam@acme.test", role: "agent").id
+    @sam_token = sign_in!(email: "sam@acme.test").dig("session", "token")
+
+    avery = customer_session
+    @avery_token = avery.dig("session", "token")
+    @avery_id = avery.dig("user", "id")
+    ben = customer_session(email: "ben@example.test", name: "Ben")
+    @ben_token = ben.dig("session", "token")
+    @ben_id = ben.dig("user", "id")
+
+    build_tickets
+  end
+
+  # Five tickets in different states:
+  #   @receipt  Avery, open, unassigned, high. The subject says "Receipt".
+  #   @login    Ben, open, unassigned, normal.
+  #   @invoice  Avery, pending, assigned to Sam, high. The subject has a literal "100%".
+  #   @refund   Ben, solved, assigned to the owner, normal. A public comment mentions the receipt.
+  #   @upgrade  Avery, open, unassigned, high. Its public comment has "seat_count", and a
+  #             private note mentions "receipt", which search must not match.
+  def build_tickets
+    @receipt = open_request!(@avery_token, subject: "Receipt missing from March", body: "Where is it?")
+    @login = open_request!(@ben_token, subject: "Login broken", body: "I cannot sign in.")
+    @invoice = open_request!(@avery_token, subject: "Invoice 100% wrong", body: "The total is off.")
+    @refund = open_request!(@ben_token, subject: "Refund", body: "I never got the receipt for it.")
+    @upgrade = open_request!(@avery_token, subject: "Upgrade plan", body: "We need more seat_count.")
+
+    staff_patch(@receipt["id"], { priority: "high" })
+    staff_patch(@invoice["id"], { status: "pending", assignee_id: @sam_id, priority: "high" })
+    staff_patch(@refund["id"], { status: "solved", assignee_id: @owner_id })
+    staff_patch(@upgrade["id"], { priority: "high", comment: { body: "Internal: receipt was lost in the migration.", public: false } })
+  end
+
+  def staff_patch(id, ticket, token: @sam_token)
+    patch "/api/v1/tickets/#{id}", params: { ticket: ticket }, headers: bearer(token), as: :json
+    assert_response :ok, response.body
+  end
+
+  # The ticket IDs for a list request, in the order returned.
+  def listed_ids(params = {})
+    get "/api/v1/tickets", params: params, headers: bearer(@sam_token)
+    assert_response :ok, response.body
+    json.fetch("tickets").map { |ticket| ticket["id"] }
+  end
+
+  def assert_tickets(params, *expected)
+    assert_equal expected.map { |record| record["id"] }.sort, listed_ids(params).sort, params.inspect
+  end
+
+  def assert_invalid_filter(params, name)
+    get "/api/v1/tickets", params: params, headers: bearer(@sam_token)
+    assert_response :bad_request, "#{params.inspect} should be refused"
+    assert_equal "invalid_filter", json.dig("error", "code")
+    assert_includes json.dig("error", "message"), name
+  end
+
+  # --- Single filters -------------------------------------------------------------
+
+  test "with no filters every ticket is listed" do
+    assert_tickets({}, @receipt, @login, @invoice, @refund, @upgrade)
+  end
+
+  test "blank filter values are the same as no filter" do
+    assert_tickets({ status: "", assignee_id: "", requester_id: "", priority: "", q: "" },
+                   @receipt, @login, @invoice, @refund, @upgrade)
+    assert_tickets({ q: "   " }, @receipt, @login, @invoice, @refund, @upgrade)
+  end
+
+  test "filters by status" do
+    assert_tickets({ status: "open" }, @receipt, @login, @upgrade)
+    assert_tickets({ status: "pending" }, @invoice)
+    assert_tickets({ status: "solved" }, @refund)
+  end
+
+  test "assignee_id=unassigned lists tickets that nobody is working" do
+    assert_tickets({ assignee_id: "unassigned" }, @receipt, @login, @upgrade)
+  end
+
+  test "assignee_id with a user ID lists that person's tickets" do
+    assert_tickets({ assignee_id: @sam_id }, @invoice)
+    assert_tickets({ assignee_id: @owner_id }, @refund)
+  end
+
+  test "an assignee with no tickets gets an empty list" do
+    assert_tickets({ assignee_id: @ben_id })
+  end
+
+  test "requester_id lists one customer's tickets" do
+    assert_tickets({ requester_id: @avery_id }, @receipt, @invoice, @upgrade)
+    assert_tickets({ requester_id: @ben_id }, @login, @refund)
+  end
+
+  test "priority filters by normal or high" do
+    assert_tickets({ priority: "high" }, @receipt, @invoice, @upgrade)
+    assert_tickets({ priority: "normal" }, @login, @refund)
+  end
+
+  # --- Search ---------------------------------------------------------------------
+
+  test "q matches subjects and public comments, ignoring case" do
+    assert_tickets({ q: "receipt" }, @receipt, @refund)
+    assert_tickets({ q: "RECEIPT" }, @receipt, @refund)
+    assert_tickets({ q: "LoGiN" }, @login)
+  end
+
+  test "q does not match private notes" do
+    assert_tickets({ q: "migration" })
+    assert_tickets({ q: "seat_count" }, @upgrade)
+  end
+
+  test "q treats % as a literal percent sign, not a wildcard" do
+    assert_tickets({ q: "%" }, @invoice)
+    assert_tickets({ q: "100%" }, @invoice)
+    assert_tickets({ q: "% wrong" }, @invoice)
+  end
+
+  test "q treats _ as a literal underscore, not a single-character wildcard" do
+    assert_tickets({ q: "_" }, @upgrade)
+    assert_tickets({ q: "seat_count" }, @upgrade)
+  end
+
+  test "q treats a backslash as a literal character" do
+    path = open_request!(@ben_token, subject: 'Path C:\Temp is full', body: "Please clear it.")
+
+    assert_tickets({ q: "\\" }, path)
+    assert_tickets({ q: "C:\\Temp" }, path)
+    assert_tickets({ q: "\\\\" })
+  end
+
+  test "q treats regex and SQL syntax as plain text" do
+    [".*", "(", "[a-z]", "' OR 1=1 --", "*"].each do |text|
+      assert_tickets({ q: text })
+    end
+  end
+
+  test "q finds non-ASCII text regardless of case" do
+    accented = open_request!(@avery_token, subject: "Reçu manquant", body: "Pas de reçu.")
+
+    assert_tickets({ q: "REÇU" }, accented)
+  end
+
+  # --- Combining filters ----------------------------------------------------------
+
+  test "the example query combines every filter" do
+    get "/api/v1/tickets", params: { status: "open", assignee_id: "unassigned", priority: "high", q: "receipt" },
+                           headers: bearer(@sam_token)
+
+    assert_response :ok
+    assert_equal [@receipt["id"]], json.fetch("tickets").map { |t| t["id"] }
+  end
+
+  test "filters combine with AND, so every filter has to match" do
+    assert_tickets({ status: "open", priority: "high" }, @receipt, @upgrade)
+    assert_tickets({ assignee_id: "unassigned", requester_id: @avery_id }, @receipt, @upgrade)
+    assert_tickets({ requester_id: @ben_id, priority: "normal", q: "receipt" }, @refund)
+    assert_tickets({ status: "solved", priority: "high" })
+  end
+
+  test "a combined list keeps the most recently active tickets first" do
+    ids = listed_ids({ status: "open" })
+
+    assert_equal [@upgrade["id"], @login["id"], @receipt["id"]], ids
+  end
+
+  test "pagination counts only the tickets that match" do
+    get "/api/v1/tickets", params: { status: "open", per_page: 2 }, headers: bearer(@sam_token)
+    assert_equal 3, json["count"]
+    assert_equal 2, json.fetch("tickets").size
+    assert_equal 2, json["next_page"]
+
+    get "/api/v1/tickets", params: { status: "open", per_page: 2, page: 2 }, headers: bearer(@sam_token)
+    assert_equal 1, json.fetch("tickets").size
+    assert_nil json["next_page"]
+  end
+
+  test "filters only see tickets in this business" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    verify_email!(email: "jo@globex.test", subdomain: "globex")
+    ivy = customer_session(subdomain: "globex", email: "ivy@globex.test", name: "Ivy")
+    open_request!(ivy.dig("session", "token"), subject: "Receipt from Globex")
+
+    assert_tickets({ q: "receipt" }, @receipt, @refund)
+    assert_tickets({ requester_id: ivy.dig("user", "id") })
+  end
+
+  test "a very large ID matches nothing rather than failing" do
+    assert_tickets({ assignee_id: "9" * 30 })
+    assert_tickets({ requester_id: "9" * 30 })
+  end
+
+  # --- Invalid filters ------------------------------------------------------------
+
+  test "an unknown status is refused" do
+    assert_invalid_filter({ status: "lost" }, "status")
+  end
+
+  test "priority must be normal or high, in lower case" do
+    %w[urgent HIGH low].each { |value| assert_invalid_filter({ priority: value }, "priority") }
+  end
+
+  test "assignee_id is a user ID or unassigned, and a partial number is refused" do
+    ["abc", "12abc", "0", "-1", "1.5", "Unassigned"].each do |value|
+      assert_invalid_filter({ assignee_id: value }, "assignee_id")
+    end
+  end
+
+  test "requester_id is a user ID, not unassigned" do
+    ["unassigned", "abc", "0", "2x"].each do |value|
+      assert_invalid_filter({ requester_id: value }, "requester_id")
+    end
+  end
+
+  test "q must be a single piece of text" do
+    assert_invalid_filter({ q: ["receipt", "login"] }, "q")
+    assert_invalid_filter({ q: { contains: "receipt" } }, "q")
+  end
+
+  test "q cannot contain a NUL byte" do
+    assert_invalid_filter({ q: "receipt\u0000" }, "q")
+  end
+
+  test "an invalid filter is refused even when another filter matches" do
+    assert_invalid_filter({ status: "open", priority: "urgent" }, "priority")
+  end
+end
diff --git a/test/integration/ticket_groups_test.rb b/test/integration/ticket_groups_test.rb
new file mode 100644
index 0000000..1dbee45
--- /dev/null
+++ b/test/integration/ticket_groups_test.rb
@@ -0,0 +1,433 @@
+require "test_helper"
+
+# Tickets can be worked in a group. An assignee must belong to the ticket's group. Groups organize
+# tickets, they never hide them, and moving or clearing a group keeps the assignments consistent.
+class TicketGroupsTest < ActionDispatch::IntegrationTest
+  setup do
+    @owner_session = owner_session
+    @owner_token = @owner_session.dig("session", "token")
+    @owner_id = @owner_session.dig("user", "id")
+    @agent_session = invited_session!(admin_token: @owner_token, email: "sam@example.test", role: "agent")
+    @agent_token = @agent_session.dig("session", "token")
+    @agent_id = @agent_session.dig("user", "id")
+    @second_agent_session = invited_session!(admin_token: @owner_token, email: "ivy@example.test", role: "agent",
+                                             password: "my-team-password")
+    @second_agent_id = @second_agent_session.dig("user", "id")
+    avery = customer_session
+    @avery_token = avery.dig("session", "token")
+
+    @billing = create_group!("Billing")
+    @support = create_group!("Technical Support")
+  end
+
+  def create_group!(name)
+    post "/api/v1/groups", params: { group: { name: name } }, headers: bearer(@owner_token), as: :json
+    assert_response :created, response.body
+    json.fetch("group")
+  end
+
+  def join!(group, user_id, default: nil)
+    body = { group_id: group.fetch("id"), user_id: user_id }
+    body[:default] = default unless default.nil?
+    post "/api/v1/group_memberships", params: { group_membership: body }, headers: bearer(@owner_token), as: :json
+    assert_response :created, response.body
+  end
+
+  def staff_patch(id, ticket, token: @owner_token)
+    patch "/api/v1/tickets/#{id}", params: { ticket: ticket }, headers: bearer(token), as: :json
+  end
+
+  def ticket_for(id, token: @owner_token)
+    get "/api/v1/tickets/#{id}", headers: bearer(token)
+    assert_response :ok, response.body
+    json.fetch("ticket")
+  end
+
+  def open_ticket
+    open_request!(@avery_token, subject: "Invoice wrong")
+  end
+
+  # --- Placing tickets in groups ---------------------------------------------------------
+
+  test "a ticket starts ungrouped, and shows its group as null" do
+    ticket = ticket_for(open_ticket["id"])
+
+    assert_nil ticket["group_id"]
+    assert_nil ticket["group"]
+  end
+
+  test "a staff member puts a ticket in a group, and the ticket shows the group's ID and name" do
+    opened = open_ticket
+
+    staff_patch(opened["id"], { group_id: @billing["id"] })
+
+    assert_response :ok
+    assert_equal @billing["id"], json.dig("ticket", "group_id")
+    assert_equal({ "id" => @billing["id"], "name" => "Billing" }, json.dig("ticket", "group"))
+  end
+
+  test "a group can be chosen with a numeric string" do
+    opened = open_ticket
+
+    staff_patch(opened["id"], { group_id: @billing["id"].to_s })
+
+    assert_response :ok
+    assert_equal @billing["id"], json.dig("ticket", "group_id")
+  end
+
+  test "a group ID that is not a whole number is refused, so it cannot quietly pick another group" do
+    opened = open_ticket
+
+    staff_patch(opened["id"], { group_id: "#{@billing['id']}abc" })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "group_id").present?
+    assert_nil Request.find(opened["id"]).group_id
+  end
+
+  test "a group from another business is refused" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    globex_group = Account.find_by!(subdomain: "globex").groups.create!(name: "Sales")
+    opened = open_ticket
+
+    staff_patch(opened["id"], { group_id: globex_group.id })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "group").present?
+    assert_nil Request.find(opened["id"]).group_id
+  end
+
+  test "a group that does not exist is refused" do
+    opened = open_ticket
+
+    staff_patch(opened["id"], { group_id: 999_999 })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "group").present?
+  end
+
+  test "a group change alone counts as an update, and leaves updated_at and the customer's view alone" do
+    opened = open_ticket
+    updated_at = Request.find(opened["id"]).updated_at
+
+    travel 1.hour do
+      staff_patch(opened["id"], { group_id: @billing["id"] })
+    end
+
+    assert_response :ok
+    request = Request.find(opened["id"])
+    assert_equal updated_at.to_i, request.updated_at.to_i
+    get "/api/v1/requests/#{opened['id']}", headers: bearer(@avery_token)
+    assert_no_match(/group/, response.body)
+  end
+
+  test "a customer cannot see a ticket's group" do
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"] })
+
+    get "/api/v1/requests", headers: bearer(@avery_token)
+
+    assert_no_match(/group/, response.body)
+  end
+
+  test "a customer cannot put a ticket in a group" do
+    opened = open_ticket
+
+    patch "/api/v1/tickets/#{opened['id']}", params: { ticket: { group_id: @billing["id"] } },
+          headers: bearer(@avery_token), as: :json
+
+    assert_response :forbidden
+    assert_nil Request.find(opened["id"]).group_id
+  end
+
+  # --- Assignees must belong to the ticket's group --------------------------------------
+
+  test "an assignee must belong to the ticket's group" do
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"] })
+
+    staff_patch(opened["id"], { assignee_id: @agent_id })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "assignee").present?
+    assert_nil Request.find(opened["id"]).assignee_id
+  end
+
+  test "an assignee who belongs to the ticket's group can be assigned" do
+    join!(@billing, @agent_id)
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"] })
+
+    staff_patch(opened["id"], { assignee_id: @agent_id })
+
+    assert_response :ok
+    assert_equal @agent_id, json.dig("ticket", "assignee_id")
+    assert_equal @billing["id"], json.dig("ticket", "group_id")
+  end
+
+  test "assigning someone to an ungrouped ticket puts it in their default group" do
+    join!(@billing, @agent_id)
+    join!(@support, @agent_id, default: true)
+    opened = open_ticket
+
+    staff_patch(opened["id"], { assignee_id: @agent_id })
+
+    assert_response :ok
+    assert_equal @agent_id, json.dig("ticket", "assignee_id")
+    assert_equal @support["id"], json.dig("ticket", "group_id")
+    assert_equal @support["id"], Request.find(opened["id"]).group_id
+  end
+
+  test "assigning someone with no groups to an ungrouped ticket leaves the ticket ungrouped" do
+    opened = open_ticket
+
+    staff_patch(opened["id"], { assignee_id: @agent_id })
+
+    assert_response :ok
+    assert_equal @agent_id, json.dig("ticket", "assignee_id")
+    assert_nil json.dig("ticket", "group_id")
+  end
+
+  test "assigning someone to an ungrouped ticket, while choosing a group, must match that group" do
+    join!(@billing, @agent_id)
+    join!(@support, @agent_id, default: true)
+    opened = open_ticket
+
+    staff_patch(opened["id"], { group_id: @billing["id"], assignee_id: @agent_id })
+
+    assert_response :ok
+    assert_equal @billing["id"], json.dig("ticket", "group_id")
+    assert_equal @agent_id, json.dig("ticket", "assignee_id")
+  end
+
+  test "an assignment that does not match the chosen group is refused" do
+    join!(@support, @agent_id)
+    opened = open_ticket
+
+    staff_patch(opened["id"], { group_id: @billing["id"], assignee_id: @agent_id })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "assignee").present?
+    assert_nil Request.find(opened["id"]).group_id
+    assert_nil Request.find(opened["id"]).assignee_id
+  end
+
+  test "assigning someone who is not in the ticket's group keeps the old assignee, as a refused update changes nothing" do
+    join!(@billing, @agent_id)
+    join!(@billing, @second_agent_id)
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"], assignee_id: @agent_id })
+
+    staff_patch(opened["id"], { assignee_id: @owner_id })
+
+    assert_response :unprocessable_content
+    assert_equal @agent_id, Request.find(opened["id"]).assignee_id
+  end
+
+  # --- Moving a ticket to another group ------------------------------------------------
+
+  test "moving a ticket to another group clears an assignee who does not belong there" do
+    join!(@billing, @agent_id)
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"], assignee_id: @agent_id })
+
+    staff_patch(opened["id"], { group_id: @support["id"] })
+
+    assert_response :ok
+    assert_equal @support["id"], json.dig("ticket", "group_id")
+    assert_nil json.dig("ticket", "assignee_id")
+  end
+
+  test "moving a ticket keeps an assignee who belongs to the new group" do
+    join!(@billing, @agent_id)
+    join!(@support, @agent_id)
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"], assignee_id: @agent_id })
+
+    staff_patch(opened["id"], { group_id: @support["id"] })
+
+    assert_response :ok
+    assert_equal @support["id"], json.dig("ticket", "group_id")
+    assert_equal @agent_id, json.dig("ticket", "assignee_id")
+  end
+
+  test "moving a ticket into a group with an explicit assignee who is in it is allowed" do
+    join!(@support, @agent_id)
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"] })
+
+    staff_patch(opened["id"], { group_id: @support["id"], assignee_id: @agent_id })
+
+    assert_response :ok
+    assert_equal @agent_id, json.dig("ticket", "assignee_id")
+    assert_equal @support["id"], json.dig("ticket", "group_id")
+  end
+
+  test "moving a ticket to a group an explicit assignee is not in is refused" do
+    join!(@billing, @agent_id)
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"] })
+
+    staff_patch(opened["id"], { group_id: @support["id"], assignee_id: @agent_id })
+
+    assert_response :unprocessable_content
+    assert_equal @billing["id"], Request.find(opened["id"]).group_id
+  end
+
+  test "a move that keeps the same group changes nothing about the assignee" do
+    join!(@billing, @agent_id)
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"], assignee_id: @agent_id })
+
+    staff_patch(opened["id"], { group_id: @billing["id"] })
+
+    assert_response :ok
+    assert_equal @agent_id, json.dig("ticket", "assignee_id")
+  end
+
+  # --- Clearing the assignee and the group ----------------------------------------------
+
+  test "clearing the assignee leaves the group in place" do
+    join!(@billing, @agent_id)
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"], assignee_id: @agent_id })
+
+    staff_patch(opened["id"], { assignee_id: nil })
+
+    assert_response :ok
+    assert_nil json.dig("ticket", "assignee_id")
+    assert_equal @billing["id"], json.dig("ticket", "group_id")
+  end
+
+  test "clearing the group also clears the assignee" do
+    join!(@billing, @agent_id)
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"], assignee_id: @agent_id })
+
+    staff_patch(opened["id"], { group_id: nil })
+
+    assert_response :ok
+    assert_nil json.dig("ticket", "group_id")
+    assert_nil json.dig("ticket", "assignee_id")
+    assert_nil Request.find(opened["id"]).assignee_id
+  end
+
+  test "clearing the group and assigning someone in the same update is refused, not guessed at" do
+    join!(@billing, @agent_id)
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"] })
+
+    staff_patch(opened["id"], { group_id: nil, assignee_id: @agent_id })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "group_id").present?
+    assert_equal @billing["id"], Request.find(opened["id"]).group_id
+    assert_nil Request.find(opened["id"]).assignee_id
+  end
+
+  test "clearing both the group and the assignee in one update is allowed" do
+    join!(@billing, @agent_id)
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"], assignee_id: @agent_id })
+
+    staff_patch(opened["id"], { group_id: nil, assignee_id: nil })
+
+    assert_response :ok
+    assert_nil json.dig("ticket", "group_id")
+    assert_nil json.dig("ticket", "assignee_id")
+  end
+
+  test "an assignment with a private note saves both, and the group is recorded" do
+    join!(@billing, @agent_id)
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"] })
+
+    staff_patch(opened["id"], { assignee_id: @agent_id, comment: { body: "Taking this.", public: false } })
+
+    assert_response :ok
+    assert_equal @agent_id, json.dig("ticket", "assignee_id")
+    assert_equal 2, Request.find(opened["id"]).comments.count
+  end
+
+  # --- Suspension and memberships ----------------------------------------------------------
+
+  test "suspending an assignee unassigns the ticket but keeps the group, and restoring keeps their memberships" do
+    join!(@billing, @agent_id)
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"], assignee_id: @agent_id })
+
+    patch "/api/v1/users/#{@agent_id}", params: { user: { suspended: true } }, headers: bearer(@owner_token), as: :json
+
+    assert_response :ok
+    assert_nil Request.find(opened["id"]).assignee_id
+    assert_equal @billing["id"], Request.find(opened["id"]).group_id
+    assert_equal 1, GroupMembership.where(user_id: @agent_id).count
+
+    patch "/api/v1/users/#{@agent_id}", params: { user: { suspended: false } }, headers: bearer(@owner_token), as: :json
+    assert_equal 1, GroupMembership.where(user_id: @agent_id).count
+  end
+
+  # --- Filtering the inbox by group -----------------------------------------------------
+
+  test "staff filter the inbox by group, and by unassigned groups" do
+    join!(@billing, @agent_id)
+    in_billing = open_ticket
+    staff_patch(in_billing["id"], { group_id: @billing["id"] })
+    in_support = open_request!(@avery_token, subject: "Login")
+    staff_patch(in_support["id"], { group_id: @support["id"] })
+    ungrouped = open_request!(@avery_token, subject: "Refund")
+
+    get "/api/v1/tickets", params: { group_id: @billing["id"] }, headers: bearer(@agent_token)
+    assert_equal [in_billing["id"]], json.fetch("tickets").map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { group_id: "unassigned" }, headers: bearer(@agent_token)
+    assert_equal [ungrouped["id"]], json.fetch("tickets").map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { group_id: @support["id"], status: "open" }, headers: bearer(@agent_token)
+    assert_equal [in_support["id"]], json.fetch("tickets").map { |t| t["id"] }
+  end
+
+  test "a group filter that matches no ticket is an empty list" do
+    get "/api/v1/tickets", params: { group_id: 999_999 }, headers: bearer(@agent_token)
+
+    assert_response :ok
+    assert_equal [], json.fetch("tickets")
+  end
+
+  test "a malformed group filter is a 400 that names the parameter" do
+    ["12abc", "0", "1.5", "none"].each do |value|
+      get "/api/v1/tickets", params: { group_id: value }, headers: bearer(@agent_token)
+      assert_response :bad_request, value
+      assert_equal "invalid_filter", json.dig("error", "code"), value
+      assert_match(/group_id/, json.dig("error", "message"))
+    end
+  end
+
+  test "customers cannot filter by group" do
+    get "/api/v1/requests", params: { group_id: @billing["id"] }, headers: bearer(@avery_token)
+
+    assert_response :bad_request
+    assert_equal "invalid_filter", json.dig("error", "code")
+  end
+
+  test "the group filter is in the list of filters a ticket list supports" do
+    get "/api/v1/tickets", params: { group_id: "unassigned", assignee_id: "unassigned" }, headers: bearer(@agent_token)
+
+    assert_response :ok
+  end
+
+  # --- Deleting a membership and a group ------------------------------------------------
+
+  test "deleting a group ungroups its tickets, and they then stay assigned to no one" do
+    join!(@billing, @agent_id)
+    opened = open_ticket
+    staff_patch(opened["id"], { group_id: @billing["id"], assignee_id: @agent_id })
+
+    delete "/api/v1/groups/#{@billing['id']}", headers: bearer(@owner_token)
+
+    assert_response :ok
+    ticket = ticket_for(opened["id"])
+    assert_nil ticket["group_id"]
+    assert_nil ticket["assignee_id"]
+  end
+end
diff --git a/test/integration/ticket_merges_test.rb b/test/integration/ticket_merges_test.rb
new file mode 100644
index 0000000..3ba8fde
--- /dev/null
+++ b/test/integration/ticket_merges_test.rb
@@ -0,0 +1,522 @@
+require "test_helper"
+
+# Merging a duplicate ticket into another ticket from the same customer. The duplicate is closed,
+# stays readable and points at the surviving ticket. The surviving ticket keeps its status,
+# assignment and email identity. A closed ticket takes no edits or email replies, but internal
+# assignment cleanup still applies to it.
+class TicketMergesTest < ActionDispatch::IntegrationTest
+  setup do
+    @owner_token = owner_session.dig("session", "token")
+    @agent_session = invited_session!(admin_token: @owner_token, email: "sam@example.test", role: "agent")
+    @agent_token = @agent_session.dig("session", "token")
+    @agent_id = @agent_session.dig("user", "id")
+    @avery_token = customer_session.dig("session", "token")
+    @ben_token = customer_session(email: "ben@example.test", name: "Ben").dig("session", "token")
+
+    @duplicate = open_request!(@avery_token, subject: "Cannot download receipt", body: "Duplicate body.")
+    @original = open_request!(@avery_token, subject: "Receipt download fails", body: "Original body.")
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def dup_id = @duplicate["id"]
+
+  def original_id = @original["id"]
+
+  def merge_request(source_id, merge, token: @agent_token)
+    post "/api/v1/tickets/#{source_id}/merge", params: { merge: merge }, headers: bearer(token), as: :json
+  end
+
+  # Merges and checks it worked. Returns the response JSON.
+  def merge!(source_id, target_id, token: @agent_token, **notes)
+    merge_request(source_id, { target_id: target_id, **notes }, token: token)
+    assert_response :ok, response.body
+    json
+  end
+
+  def staff_patch(id, ticket, token: @agent_token)
+    patch "/api/v1/tickets/#{id}", params: { ticket: ticket }, headers: bearer(token), as: :json
+  end
+
+  def customer_patch(id, request, token: @avery_token)
+    patch "/api/v1/requests/#{id}", params: { request: request }, headers: bearer(token), as: :json
+  end
+
+  def staff_ticket(id, token: @agent_token)
+    get "/api/v1/tickets/#{id}", headers: bearer(token)
+    assert_response :ok, response.body
+    json.fetch("ticket")
+  end
+
+  def customer_request(id, token: @avery_token)
+    get "/api/v1/requests/#{id}", headers: bearer(token)
+    assert_response :ok, response.body
+    json.fetch("request")
+  end
+
+  def staff_comments(id, token: @agent_token)
+    get "/api/v1/tickets/#{id}/comments", headers: bearer(token)
+    assert_response :ok, response.body
+    json.fetch("comments")
+  end
+
+  def customer_comments(id, token: @avery_token)
+    get "/api/v1/requests/#{id}/comments", headers: bearer(token)
+    assert_response :ok, response.body
+    json.fetch("comments")
+  end
+
+  def error_code
+    json.dig("error", "code")
+  end
+
+  # Opens a request by email from Avery, who is already a customer. Returns the Request. The stored
+  # Message-ID has no angle brackets.
+  def email_ticket!(message_id:, subject: "Cannot download my receipt")
+    receive_mail!(build_mail(from: "avery@example.test", subject: subject,
+                             body: "The download button does nothing.", message_id: message_id))
+    Request.find_by!(origin_message_id: message_id.delete_prefix("<").delete_suffix(">"))
+  end
+
+  def create_group!(name)
+    post "/api/v1/groups", params: { group: { name: name } }, headers: bearer(@owner_token), as: :json
+    assert_response :created, response.body
+    json.fetch("group")
+  end
+
+  def join!(group_id, user_id)
+    post "/api/v1/group_memberships", params: { group_membership: { group_id: group_id, user_id: user_id } },
+                                      headers: bearer(@owner_token), as: :json
+    assert_response :created, response.body
+    json.fetch("group_membership")
+  end
+
+  # --- The merge itself -------------------------------------------------------------------
+
+  test "merging returns both tickets, with the duplicate closed and pointing at the surviving ticket" do
+    result = merge!(dup_id, original_id)
+
+    assert_equal "closed", result.dig("source", "status")
+    assert_equal dup_id, result.dig("source", "id")
+    assert_equal original_id, result.dig("source", "merged_into_id")
+    assert_equal original_id, result.dig("target", "id")
+    assert_nil result.dig("target", "merged_into_id")
+    assert_equal "closed", Request.find(dup_id).status
+    assert_equal original_id, Request.find(dup_id).merged_into_id
+  end
+
+  test "the surviving ticket keeps its status, assignee, group and email identity" do
+    original = email_ticket!(message_id: "<original-1@example.test>")
+    staff_patch(original.id, { status: "pending", assignee_id: @agent_id })
+    tracked = %w[status assignee_id group_id requester_id origin_message_id reply_token]
+    before = Request.find(original.id).attributes.slice(*tracked)
+
+    merge!(dup_id, original.id)
+
+    assert_equal before, Request.find(original.id).attributes.slice(*tracked)
+  end
+
+  test "a solved surviving ticket stays solved after a merge" do
+    staff_patch(original_id, { status: "solved" })
+
+    result = merge!(dup_id, original_id)
+
+    assert_equal "solved", result.dig("target", "status")
+    assert_equal "solved", Request.find(original_id).status
+  end
+
+  test "the duplicate keeps its old comments, and none of them move to the surviving ticket" do
+    merge!(dup_id, original_id)
+
+    assert_equal ["Duplicate body.", "This ticket was merged into ticket ##{original_id}."],
+                 staff_comments(dup_id).map { |c| c["body"] }
+    assert_equal ["Original body.", "Merged duplicate ticket ##{dup_id} into this ticket."],
+                 staff_comments(original_id).map { |c| c["body"] }
+  end
+
+  test "a merge note is private by default, on both sides" do
+    merge!(dup_id, original_id)
+
+    assert_equal false, staff_comments(dup_id).last["public"]
+    assert_equal false, staff_comments(original_id).last["public"]
+    refute_includes customer_comments(dup_id).map { |c| c["body"] }.join, "merged into ticket"
+    refute_includes customer_comments(original_id).map { |c| c["body"] }.join, "merged duplicate"
+  end
+
+  test "staff can supply the note text and choose to make either note public" do
+    merge!(dup_id, original_id,
+           source_comment: { body: "Continuing in ticket #{original_id}.", public: true },
+           target_comment: { body: "Duplicate checked.", public: false })
+
+    assert_equal "Continuing in ticket #{original_id}.", staff_comments(dup_id).last["body"]
+    assert_equal true, staff_comments(dup_id).last["public"]
+    assert_equal "Duplicate checked.", staff_comments(original_id).last["body"]
+    assert_equal false, staff_comments(original_id).last["public"]
+
+    # The customer sees the public note on the duplicate, and not the private one on the original.
+    assert_equal "Continuing in ticket #{original_id}.", customer_comments(dup_id).last["body"]
+    refute_includes customer_comments(original_id).map { |c| c["body"] }, "Duplicate checked."
+  end
+
+  test "a public note on the surviving ticket is visible to the customer" do
+    merge!(dup_id, original_id, target_comment: { body: "Merged a duplicate here.", public: true })
+
+    assert_equal "Merged a duplicate here.", customer_comments(original_id).last["body"]
+  end
+
+  test "a note with no text gets the default wording, and public can still be chosen" do
+    merge!(dup_id, original_id, source_comment: { public: true })
+
+    note = staff_comments(dup_id).last
+    assert_equal "This ticket was merged into ticket ##{original_id}.", note["body"]
+    assert_equal true, note["public"]
+  end
+
+  test "merge notes send no email, not even a public one on tickets opened by email" do
+    dup = email_ticket!(message_id: "<dup-1@example.test>")
+    original = email_ticket!(message_id: "<original-1@example.test>", subject: "Receipt fails")
+    ActionMailer::Base.deliveries.clear
+
+    merge!(dup.id, original.id,
+           source_comment: { body: "Continuing elsewhere.", public: true },
+           target_comment: { body: "Merged here.", public: true })
+
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "a private merge note does not move the surviving ticket in the customer's list" do
+    updated_at = Request.find(original_id).updated_at
+
+    travel 1.hour do
+      merge!(dup_id, original_id)
+    end
+
+    assert_equal updated_at.to_i, Request.find(original_id).updated_at.to_i
+    assert_equal updated_at.to_i, Time.zone.parse(customer_request(original_id)["updated_at"]).to_i
+  end
+
+  test "a public note on the surviving ticket counts as activity for the customer" do
+    updated_at = Request.find(original_id).updated_at
+
+    travel 1.hour do
+      merge!(dup_id, original_id, target_comment: { body: "Merged here.", public: true })
+    end
+
+    assert_operator Request.find(original_id).updated_at, :>, updated_at
+  end
+
+  # --- What a merged ticket looks like ----------------------------------------------------
+
+  test "the closed duplicate is readable for staff and the customer, and points at the surviving ticket" do
+    merge!(dup_id, original_id)
+
+    staff = staff_ticket(dup_id)
+    assert_equal "closed", staff["status"]
+    assert_equal original_id, staff["merged_into_id"]
+
+    customer = customer_request(dup_id)
+    assert_equal "closed", customer["status"]
+    assert_equal original_id, customer["merged_into_id"]
+  end
+
+  test "an unmerged ticket shows a null merged_into_id, to staff and to the customer" do
+    assert staff_ticket(original_id).key?("merged_into_id"), "the field is present, not just missing"
+    assert_nil staff_ticket(original_id)["merged_into_id"]
+    assert customer_request(original_id).key?("merged_into_id")
+    assert_nil customer_request(original_id)["merged_into_id"]
+  end
+
+  test "filtering for closed tickets works for staff and for the customer" do
+    merge!(dup_id, original_id)
+
+    get "/api/v1/tickets", params: { status: "closed" }, headers: bearer(@agent_token)
+    assert_response :ok
+    assert_equal [dup_id], json["tickets"].map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { status: "open" }, headers: bearer(@agent_token)
+    assert_equal [original_id], json["tickets"].map { |t| t["id"] }
+
+    get "/api/v1/requests", params: { status: "closed" }, headers: bearer(@avery_token)
+    assert_response :ok
+    assert_equal [dup_id], json["requests"].map { |r| r["id"] }
+
+    get "/api/v1/requests", params: { status: "closed" }, headers: bearer(@ben_token)
+    assert_equal [], json["requests"]
+  end
+
+  # --- A closed ticket takes no edits -----------------------------------------------------
+
+  test "a closed ticket rejects every staff edit, and nothing changes" do
+    group = create_group!("Billing")
+    merge!(dup_id, original_id)
+    before = Request.find(dup_id).attributes.slice("status", "priority", "assignee_id", "group_id", "updated_at")
+
+    [
+      { comment: { body: "One more thing." } },
+      { status: "open" },
+      { status: "solved" },
+      { priority: "high" },
+      { assignee_id: @agent_id },
+      { group_id: group["id"] }
+    ].each do |edit|
+      staff_patch(dup_id, edit)
+      assert_response :unprocessable_content, "#{edit.inspect}: #{response.body}"
+      assert_equal "ticket_closed", error_code, edit.inspect
+    end
+
+    assert_equal before, Request.find(dup_id).attributes.slice("status", "priority", "assignee_id", "group_id", "updated_at")
+    assert_equal 2, staff_comments(dup_id).size
+  end
+
+  test "a closed ticket rejects customer replies, including setting it solved" do
+    merge!(dup_id, original_id)
+
+    customer_patch(dup_id, { comment: { body: "It still fails." } })
+    assert_response :unprocessable_content
+    assert_equal "ticket_closed", error_code
+
+    customer_patch(dup_id, { status: "solved" })
+    assert_response :unprocessable_content
+    assert_equal "ticket_closed", error_code
+
+    assert_equal "closed", Request.find(dup_id).status
+    assert_equal 2, Request.find(dup_id).comments.count
+  end
+
+  test "a closed ticket is still readable by the customer, with its public comments" do
+    merge!(dup_id, original_id, source_comment: { body: "Continuing elsewhere.", public: true })
+
+    assert_equal ["Duplicate body.", "Continuing elsewhere."], customer_comments(dup_id).map { |c| c["body"] }
+  end
+
+  test "an email reply to a closed ticket is ignored, and its Message-ID is left free" do
+    dup = email_ticket!(message_id: "<dup-1@example.test>")
+    merge!(dup.id, original_id)
+    reply_to = SupportAddress.reply_for(dup.reload)
+
+    assert_no_difference -> { Comment.count } do
+      assert_no_difference -> { Request.count } do
+        receive_mail!(build_mail(from: "avery@example.test", to: reply_to, subject: "Re: Cannot download my receipt",
+                                 body: "It still fails.", message_id: "<late-1@example.test>"))
+      end
+    end
+    assert_equal "closed", dup.reload.status
+    assert_equal 2, dup.comments.count, "the original message and the merge note, and no reply"
+
+    # The refused reply did not claim its Message-ID, so the same message sent to the plain address
+    # is processed as a new request.
+    receive_mail!(build_mail(from: "avery@example.test", subject: "Something else", message_id: "<late-1@example.test>"))
+    assert_equal 1, Request.where(subject: "Something else").count
+  end
+
+  # --- Merging a closed ticket again ------------------------------------------------------
+
+  test "a closed ticket cannot be merged again" do
+    third = open_request!(@avery_token, subject: "Third one")
+    merge!(dup_id, original_id)
+
+    merge_request(dup_id, { target_id: third["id"] })
+
+    assert_response :unprocessable_content
+    assert_equal "ticket_closed", error_code
+    assert_equal original_id, Request.find(dup_id).merged_into_id
+  end
+
+  test "a closed ticket cannot be the surviving ticket" do
+    merge!(dup_id, original_id)
+    fresh = open_request!(@avery_token, subject: "Another duplicate")
+
+    merge_request(fresh["id"], { target_id: dup_id })
+    assert_response :unprocessable_content
+    assert_equal "target_closed", error_code
+
+    assert_equal "open", Request.find(fresh["id"]).status
+    assert_nil Request.find(fresh["id"]).merged_into_id
+  end
+
+  test "when the surviving ticket is merged later, the earlier links are kept" do
+    third = open_request!(@avery_token, subject: "The real one")
+    merge!(dup_id, original_id)
+
+    merge!(original_id, third["id"])
+
+    assert_equal "closed", Request.find(original_id).status
+    assert_equal third["id"], Request.find(original_id).merged_into_id
+    assert_equal original_id, Request.find(dup_id).merged_into_id, "the duplicate still points where it was merged"
+    assert_equal original_id, customer_request(dup_id)["merged_into_id"]
+  end
+
+  # --- Refused merges ---------------------------------------------------------------------
+
+  test "a ticket cannot be merged into itself" do
+    merge_request(dup_id, { target_id: dup_id })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "target_id").present?
+    assert_equal "open", Request.find(dup_id).status
+  end
+
+  test "the surviving ticket must belong to the same customer" do
+    ben_ticket = open_request!(@ben_token, subject: "Ben's problem")
+
+    merge_request(dup_id, { target_id: ben_ticket["id"] })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "target_id").present?
+    assert_equal "open", Request.find(dup_id).status
+    assert_equal "open", Request.find(ben_ticket["id"]).status
+  end
+
+  test "the surviving ticket must be in the same business" do
+    owner_session(subdomain: "globex", email: "jo@globex.test")
+    globex_token = customer_session(subdomain: "globex", email: "ivy@example.test", name: "Ivy")
+                   .dig("session", "token")
+    globex_ticket = open_request!(globex_token, subject: "Ivy's problem")
+
+    merge_request(dup_id, { target_id: globex_ticket["id"] })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "target_id").present?
+    assert_equal "open", Request.find(dup_id).status
+  end
+
+  test "another business's ticket cannot be merged, and looks missing" do
+    owner_session(subdomain: "globex", email: "jo@globex.test")
+    globex_token = customer_session(subdomain: "globex", email: "ivy@example.test", name: "Ivy")
+                   .dig("session", "token")
+    globex_ticket = open_request!(globex_token, subject: "Ivy's problem")
+
+    merge_request(globex_ticket["id"], { target_id: original_id })
+
+    assert_response :not_found
+    assert_equal "open", Request.find(original_id).status
+  end
+
+  test "a target that does not exist is refused" do
+    merge_request(dup_id, { target_id: 999_999 })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "target_id").present?
+    assert_equal "open", Request.find(dup_id).status
+  end
+
+  test "a target ID that is not a whole number is refused, so it cannot quietly pick another ticket" do
+    merge_request(dup_id, { target_id: "#{original_id}abc" })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "target_id").present?
+    assert_equal "open", Request.find(dup_id).status
+  end
+
+  test "a missing target is refused" do
+    merge_request(dup_id, { source_comment: { public: true } })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "target_id").present?
+  end
+
+  test "a numeric string target works" do
+    result = merge!(dup_id, original_id.to_s)
+
+    assert_equal original_id, result.dig("source", "merged_into_id")
+  end
+
+  test "the merge envelope is required" do
+    post "/api/v1/tickets/#{dup_id}/merge", params: { target_id: original_id }, headers: bearer(@agent_token), as: :json
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", error_code
+    assert_equal "open", Request.find(dup_id).status
+  end
+
+  test "a customer cannot merge tickets" do
+    merge_request(dup_id, { target_id: original_id }, token: @avery_token)
+
+    assert_response :forbidden
+    assert_equal "open", Request.find(dup_id).status
+  end
+
+  test "a blank note is refused, and nothing is saved" do
+    assert_no_difference -> { Comment.count } do
+      merge_request(dup_id, { target_id: original_id, source_comment: { body: "" } })
+    end
+
+    assert_response :unprocessable_content
+    assert_equal "open", Request.find(dup_id).status
+  end
+
+  test "a note body that is not text is refused, and nothing is saved" do
+    assert_no_difference -> { Comment.count } do
+      merge_request(dup_id, { target_id: original_id, source_comment: { body: { text: "nested" } } })
+    end
+
+    assert_response :unprocessable_content
+    assert_equal "source_comment.body must be text.", json.dig("error", "message")
+    assert_equal "open", Request.find(dup_id).status
+  end
+
+  test "a note whose public value is not true or false is refused" do
+    merge_request(dup_id, { target_id: original_id, target_comment: { body: "Checked.", public: "maybe" } })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "public").present?
+    assert_equal "open", Request.find(dup_id).status
+    assert_equal 1, Request.find(original_id).comments.count
+  end
+
+  test "a failed note on the surviving ticket rolls back the duplicate's note and its closing" do
+    assert_no_difference -> { Comment.count } do
+      merge_request(dup_id, { target_id: original_id, target_comment: { body: "" } })
+    end
+
+    assert_response :unprocessable_content
+    assert_equal "open", Request.find(dup_id).status
+    assert_nil Request.find(dup_id).merged_into_id
+  end
+
+  test "a merged pair is deleted with its business when the business is purged" do
+    merge!(dup_id, original_id)
+    Account.find_by!(subdomain: "acme").cancel!(now: 100.days.ago)
+
+    assert_equal 1, Account.purge_cancelled!
+    assert_equal 0, Request.count
+  end
+
+  # --- Assignment cleanup still applies to closed tickets ---------------------------------
+
+  test "suspending the assignee unassigns a closed ticket too" do
+    staff_patch(dup_id, { assignee_id: @agent_id })
+    merge!(dup_id, original_id)
+
+    suspend_user!(token: @owner_token, user_id: @agent_id)
+
+    assert_nil Request.find(dup_id).assignee_id
+    assert_equal "closed", Request.find(dup_id).status
+  end
+
+  test "removing the assignee from the group unassigns a closed ticket, and the ticket stays in the group" do
+    billing = create_group!("Billing")
+    membership = join!(billing["id"], @agent_id)
+    staff_patch(dup_id, { group_id: billing["id"], assignee_id: @agent_id })
+    merge!(dup_id, original_id)
+
+    delete "/api/v1/group_memberships/#{membership['id']}", headers: bearer(@owner_token)
+    assert_response :ok, response.body
+
+    assert_nil Request.find(dup_id).assignee_id
+    assert_equal billing["id"], Request.find(dup_id).group_id
+  end
+
+  test "deleting the group ungroups a closed ticket and clears its assignee" do
+    billing = create_group!("Billing")
+    join!(billing["id"], @agent_id)
+    staff_patch(dup_id, { group_id: billing["id"], assignee_id: @agent_id })
+    merge!(dup_id, original_id)
+
+    delete "/api/v1/groups/#{billing['id']}", headers: bearer(@owner_token)
+    assert_response :ok, response.body
+
+    assert_nil Request.find(dup_id).group_id
+    assert_nil Request.find(dup_id).assignee_id
+    assert_equal "closed", Request.find(dup_id).status
+  end
+end
diff --git a/test/integration/ticket_priority_test.rb b/test/integration/ticket_priority_test.rb
new file mode 100644
index 0000000..52766cf
--- /dev/null
+++ b/test/integration/ticket_priority_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+# Priority is internal. Staff set it, and customers never see it or change it.
+class TicketPriorityTest < ActionDispatch::IntegrationTest
+  setup do
+    owner_session
+    add_staff!(email: "sam@acme.test")
+    @staff_token = sign_in!(email: "sam@acme.test").dig("session", "token")
+    @avery_token = customer_session.dig("session", "token")
+    @id = open_request!(@avery_token, subject: "Receipt")["id"]
+  end
+
+  def staff_patch(**ticket)
+    patch "/api/v1/tickets/#{@id}", params: { ticket: ticket }, headers: bearer(@staff_token), as: :json
+  end
+
+  def customer_view
+    get "/api/v1/requests/#{@id}", headers: bearer(@avery_token)
+    assert_response :ok
+    json.fetch("request")
+  end
+
+  # --- Defaults and who can set it ------------------------------------------------
+
+  test "a new ticket is normal priority, in the ticket view and the database" do
+    get "/api/v1/tickets/#{@id}", headers: bearer(@staff_token)
+
+    assert_response :ok
+    assert_equal "normal", json.dig("ticket", "priority")
+    assert_equal "normal", Request.find(@id).priority
+  end
+
+  test "a customer cannot choose a priority when opening a request" do
+    post "/api/v1/requests",
+         params: { request: { subject: "Urgent", comment: { body: "Help!" }, priority: "high" } },
+         headers: bearer(@avery_token), as: :json
+
+    assert_response :created
+    assert_equal "normal", Request.find(json.dig("request", "id")).priority
+  end
+
+  test "a customer cannot change priority" do
+    patch "/api/v1/requests/#{@id}", params: { request: { priority: "high" } }, headers: bearer(@avery_token), as: :json
+
+    assert_response :unprocessable_content
+    assert_equal "normal", Request.find(@id).priority
+  end
+
+  # --- Staff updates --------------------------------------------------------------
+
+  test "staff set high and back to normal, and the ticket shows it" do
+    staff_patch(priority: "high")
+    assert_response :ok
+    assert_equal "high", json.dig("ticket", "priority")
+    assert_equal "high", Request.find(@id).priority
+
+    staff_patch(priority: "normal")
+    assert_response :ok
+    assert_equal "normal", json.dig("ticket", "priority")
+  end
+
+  test "a priority change alone adds no comment and leaves the status alone" do
+    assert_no_difference -> { Comment.count } do
+      staff_patch(priority: "high")
+    end
+
+    assert_response :ok
+    assert_equal "open", json.dig("ticket", "status")
+  end
+
+  test "priority can come with a comment and a status in one update" do
+    staff_patch(priority: "high", comment: { body: "Escalating." }, status: "pending")
+
+    assert_response :ok
+    assert_equal "high", json.dig("ticket", "priority")
+    assert_equal "pending", json.dig("ticket", "status")
+    assert_equal "Escalating.", Request.find(@id).comments.order(:id).last.body
+  end
+
+  test "an invalid priority is refused, and nothing else in the update is saved" do
+    ["urgent", "HIGH", "", nil].each do |value|
+      assert_no_difference -> { Comment.count } do
+        staff_patch(priority: value, comment: { body: "Trying." }, status: "solved")
+      end
+      assert_response :unprocessable_content
+      assert json.dig("error", "details", "priority").present?, "#{value.inspect} should be refused"
+    end
+
+    assert_equal "normal", Request.find(@id).priority
+    assert_equal "open", Request.find(@id).status
+  end
+
+  test "a priority-only update is a valid staff update" do
+    staff_patch(priority: "high")
+
+    assert_response :ok
+    assert_nil json["error"]
+  end
+
+  # --- Internal: the customer never notices ---------------------------------------
+
+  test "a priority change does not move the request in the customer's view" do
+    before = customer_view
+
+    travel 1.hour do
+      staff_patch(priority: "high")
+    end
+
+    assert_equal before, customer_view
+  end
+
+  test "customers never see priority in their views" do
+    staff_patch(priority: "high")
+
+    assert_equal %w[created_at id merged_into_id requester_id status subject updated_at], customer_view.keys.sort
+
+    get "/api/v1/requests", headers: bearer(@avery_token)
+    json.fetch("requests").each { |request| refute request.key?("priority") }
+  end
+
+  test "the staff ticket list shows each ticket's priority" do
+    open_request!(@avery_token, subject: "Second")
+    staff_patch(priority: "high")
+
+    get "/api/v1/tickets", headers: bearer(@staff_token)
+
+    priorities = json.fetch("tickets").to_h { |ticket| [ticket["subject"], ticket["priority"]] }
+    assert_equal({ "Receipt" => "high", "Second" => "normal" }, priorities)
+  end
+end
diff --git a/test/integration/tickets_test.rb b/test/integration/tickets_test.rb
new file mode 100644
index 0000000..b9ed816
--- /dev/null
+++ b/test/integration/tickets_test.rb
@@ -0,0 +1,265 @@
+require "test_helper"
+
+class TicketsTest < ActionDispatch::IntegrationTest
+  setup do
+    @owner_token = owner_session.dig("session", "token")
+    add_staff!(email: "sam@acme.test", role: "agent")
+    @agent_token = sign_in!(email: "sam@acme.test").dig("session", "token")
+
+    @avery = customer_session
+    @avery_token = @avery.dig("session", "token")
+    @avery_id = @avery.dig("user", "id")
+    @ben_token = customer_session(email: "ben@example.test", name: "Ben").dig("session", "token")
+  end
+
+  def staff_patch(id, ticket, token: @agent_token)
+    patch "/api/v1/tickets/#{id}", params: { ticket: ticket }, headers: bearer(token), as: :json
+  end
+
+  # --- Access -------------------------------------------------------------------
+
+  test "customers cannot use the staff routes" do
+    opened = open_request!(@avery_token)
+
+    get "/api/v1/tickets", headers: bearer(@avery_token)
+    assert_response :forbidden
+    assert_equal "forbidden", json.dig("error", "code")
+
+    get "/api/v1/tickets/#{opened['id']}", headers: bearer(@avery_token)
+    assert_response :forbidden
+
+    get "/api/v1/tickets/#{opened['id']}/comments", headers: bearer(@avery_token)
+    assert_response :forbidden
+
+    staff_patch(opened["id"], { status: "solved" }, token: @avery_token)
+    assert_response :forbidden
+    assert_equal "open", Request.find(opened["id"]).status
+  end
+
+  test "staff replies store a string public flag as a boolean" do
+    opened = open_request!(@avery_token)
+
+    staff_patch(opened["id"], { comment: { body: "Internal.", public: "false" } })
+
+    assert_response :ok
+    assert_equal false, Request.find(opened["id"]).comments.order(:id).last.public?
+  end
+
+  test "the owner and agents can both work tickets" do
+    opened = open_request!(@avery_token)
+
+    get "/api/v1/tickets/#{opened['id']}", headers: bearer(@owner_token)
+    assert_response :ok
+    get "/api/v1/tickets/#{opened['id']}", headers: bearer(@agent_token)
+    assert_response :ok
+  end
+
+  test "staff routes need a session" do
+    get "/api/v1/tickets"
+    assert_response :unauthorized
+  end
+
+  # --- Listing and showing ------------------------------------------------------
+
+  test "lists every request in the business as a ticket, with the requester" do
+    first = open_request!(@avery_token, subject: "Receipt")
+    second = open_request!(@ben_token, subject: "Login")
+
+    get "/api/v1/tickets", headers: bearer(@agent_token)
+
+    assert_response :ok
+    assert_equal 2, json["count"]
+    tickets = json.fetch("tickets")
+    assert_equal [second["id"], first["id"]], tickets.map { |t| t["id"] }
+
+    ticket = tickets.last
+    assert_equal %w[assignee assignee_id created_at group group_id id merged_into_id priority requester requester_id status subject updated_at], ticket.keys.sort
+    assert_nil ticket["assignee"]
+    assert_equal({ "id" => @avery_id, "name" => "Avery", "email" => "avery@example.test" }, ticket["requester"])
+    assert_equal @avery_id, ticket["requester_id"]
+    assert_equal "Receipt", ticket["subject"]
+  end
+
+  test "tickets are ordered by recent activity, so a new reply moves a ticket to the top" do
+    first = open_request!(@avery_token, subject: "First")
+    open_request!(@ben_token, subject: "Second")
+    customer_patch_reply(@avery_token, first["id"], "Any news?")
+
+    get "/api/v1/tickets", headers: bearer(@agent_token)
+
+    assert_equal "First", json.fetch("tickets").first["subject"]
+  end
+
+  test "shows one ticket with its requester" do
+    opened = open_request!(@avery_token)
+
+    get "/api/v1/tickets/#{opened['id']}", headers: bearer(@agent_token)
+
+    assert_response :ok
+    assert_equal opened["id"], json.dig("ticket", "id")
+    assert_equal "Avery", json.dig("ticket", "requester", "name")
+    assert_equal "avery@example.test", json.dig("ticket", "requester", "email")
+  end
+
+  test "a ticket from another business is not found" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    verify_email!(email: "jo@globex.test", subdomain: "globex")
+    globex_token = sign_in!(subdomain: "globex", email: "jo@globex.test").dig("session", "token")
+    globex_customer = customer_session(subdomain: "globex", email: "ivy@globex.test", name: "Ivy")
+    elsewhere = open_request!(globex_customer.dig("session", "token"))
+
+    get "/api/v1/tickets/#{elsewhere['id']}", headers: bearer(@agent_token)
+    assert_response :not_found
+
+    staff_patch(elsewhere["id"], { status: "solved" })
+    assert_response :not_found
+    assert_equal "open", Request.find(elsewhere["id"]).status
+
+    get "/api/v1/tickets", headers: bearer(globex_token)
+    assert_equal ["ivy@globex.test"], json.fetch("tickets").map { |t| t.dig("requester", "email") }
+  end
+
+  test "the ticket list is paginated" do
+    3.times { |i| open_request!(@ben_token, subject: "Issue #{i}") }
+
+    get "/api/v1/tickets", params: { per_page: 2 }, headers: bearer(@agent_token)
+
+    assert_response :ok
+    assert_equal 2, json.fetch("tickets").size
+    assert_equal 3, json["count"]
+    assert_equal 2, json["per_page"]
+    assert_equal 2, json["next_page"]
+  end
+
+  # --- Replying -----------------------------------------------------------------
+
+  test "a staff reply with a status posts the comment and changes the status" do
+    opened = open_request!(@avery_token)
+
+    staff_patch(opened["id"], { comment: { body: "Please try again now." }, status: "pending" })
+
+    assert_response :ok
+    assert_equal "pending", json.dig("ticket", "status")
+    comment = Request.find(opened["id"]).comments.order(:id).last
+    assert_equal "Please try again now.", comment.body
+    assert_equal "Sam", comment.author.name
+    assert comment.public?
+  end
+
+  test "a staff reply on its own does not change the status" do
+    opened = open_request!(@avery_token)
+    staff_patch(opened["id"], { status: "pending" })
+
+    staff_patch(opened["id"], { comment: { body: "Looking into it." } })
+
+    assert_response :ok
+    assert_equal "pending", json.dig("ticket", "status")
+    assert_equal "pending", Request.find(opened["id"]).status
+  end
+
+  test "staff can set open, pending and solved, and nothing else" do
+    opened = open_request!(@avery_token)
+
+    %w[pending solved open].each do |status|
+      staff_patch(opened["id"], { status: status })
+      assert_response :ok
+      assert_equal status, json.dig("ticket", "status")
+    end
+
+    staff_patch(opened["id"], { comment: { body: "Adding a note." }, status: "closed" })
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "status").present?
+    assert_equal "open", Request.find(opened["id"]).status
+  end
+
+  test "a rejected status change does not leave its comment behind" do
+    opened = open_request!(@avery_token)
+
+    assert_no_difference -> { Comment.count } do
+      staff_patch(opened["id"], { comment: { body: "Half done." }, status: "" })
+    end
+    assert_response :unprocessable_content
+  end
+
+  test "a staff status change without a comment is allowed" do
+    opened = open_request!(@avery_token)
+
+    assert_no_difference -> { Comment.count } do
+      staff_patch(opened["id"], { status: "solved" })
+    end
+
+    assert_response :ok
+    assert_equal "solved", json.dig("ticket", "status")
+  end
+
+  test "a staff update needs a comment or a status" do
+    opened = open_request!(@avery_token)
+
+    staff_patch(opened["id"], { subject: "Renamed" })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "base").present?
+  end
+
+  test "a staff update envelope must be an object" do
+    opened = open_request!(@avery_token)
+
+    patch "/api/v1/tickets/#{opened['id']}", params: { ticket: "pending" }, headers: bearer(@agent_token), as: :json
+
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "a customer reply after a staff reply reopens a solved ticket" do
+    opened = open_request!(@avery_token)
+    staff_patch(opened["id"], { comment: { body: "Fixed." }, status: "solved" })
+
+    customer_patch_reply(@avery_token, opened["id"], "Thanks, but it broke again.")
+
+    assert_equal "open", Request.find(opened["id"]).status
+  end
+
+  # --- Private notes ------------------------------------------------------------
+
+  test "private notes are visible to staff and hidden from the customer" do
+    opened = open_request!(@avery_token)
+    staff_patch(opened["id"], { comment: { body: "Check the billing logs first.", public: false } })
+    staff_patch(opened["id"], { comment: { body: "We are on it." } })
+
+    get "/api/v1/tickets/#{opened['id']}/comments", headers: bearer(@agent_token)
+    assert_response :ok
+    staff_view = json.fetch("comments")
+    assert_equal ["The download button does nothing.", "Check the billing logs first.", "We are on it."],
+                 staff_view.map { |c| c["body"] }
+    assert_equal [true, false, true], staff_view.map { |c| c["public"] }
+
+    get "/api/v1/requests/#{opened['id']}/comments", headers: bearer(@avery_token)
+    customer_view = json.fetch("comments").map { |c| c["body"] }
+    assert_equal ["The download button does nothing.", "We are on it."], customer_view
+  end
+
+  test "a private note does not reopen a solved request" do
+    opened = open_request!(@avery_token)
+    staff_patch(opened["id"], { status: "solved" })
+
+    staff_patch(opened["id"], { comment: { body: "Internal only.", public: false } })
+
+    assert_equal "solved", Request.find(opened["id"]).status
+  end
+
+  test "public must be true or false" do
+    opened = open_request!(@avery_token)
+
+    staff_patch(opened["id"], { comment: { body: "Hmm.", public: nil } })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "public").present?
+  end
+
+  private
+
+  def customer_patch_reply(token, id, body)
+    patch "/api/v1/requests/#{id}", params: { request: { comment: { body: body } } }, headers: bearer(token), as: :json
+    assert_response :ok, response.body
+  end
+end
diff --git a/test/integration/users_test.rb b/test/integration/users_test.rb
new file mode 100644
index 0000000..2700f7f
--- /dev/null
+++ b/test/integration/users_test.rb
@@ -0,0 +1,274 @@
+require "test_helper"
+
+class UsersTest < ActionDispatch::IntegrationTest
+  setup do
+    @owner_session = owner_session
+    @owner_token = @owner_session.dig("session", "token")
+    @owner_id = @owner_session.dig("user", "id")
+    @agent_session = invited_session!(admin_token: @owner_token, email: "sam@example.test", role: "agent")
+    @agent_token = @agent_session.dig("session", "token")
+    @agent_id = @agent_session.dig("user", "id")
+    @avery = customer_session
+    @avery_token = @avery.dig("session", "token")
+  end
+
+  def patch_user(id, body, token: @owner_token)
+    patch "/api/v1/users/#{id}", params: { user: body }, headers: bearer(token), as: :json
+  end
+
+  # --- Listing and inspecting -----------------------------------------------------
+
+  test "admins list everyone oldest first, with suspension on each user" do
+    get "/api/v1/users", headers: bearer(@owner_token)
+
+    assert_response :ok
+    assert_equal 3, json["count"]
+    users = json.fetch("users")
+    assert_equal users.map { |u| u["id"] }.sort, users.map { |u| u["id"] }
+    assert_equal [false, false, false], users.map { |u| u["suspended"] }
+    assert_equal %w[admin agent customer], users.map { |u| u["role"] }.sort
+  end
+
+  test "filters users by role" do
+    get "/api/v1/users", params: { role: "agent" }, headers: bearer(@owner_token)
+
+    assert_response :ok
+    assert_equal [@agent_id], json.fetch("users").map { |u| u["id"] }
+  end
+
+  test "filters users by suspension" do
+    suspend_user!(token: @owner_token, user_id: @agent_id)
+
+    get "/api/v1/users", params: { suspended: "true" }, headers: bearer(@owner_token)
+    assert_equal [@agent_id], json.fetch("users").map { |u| u["id"] }
+
+    get "/api/v1/users", params: { suspended: "false" }, headers: bearer(@owner_token)
+    assert_equal [@owner_id, @avery.dig("user", "id")].sort, json.fetch("users").map { |u| u["id"] }.sort
+  end
+
+  test "an unknown role or a non-boolean suspension filter is a 400" do
+    get "/api/v1/users", params: { role: "owner" }, headers: bearer(@owner_token)
+    assert_response :bad_request
+    assert_equal "invalid_filter", json.dig("error", "code")
+
+    get "/api/v1/users", params: { suspended: "yes" }, headers: bearer(@owner_token)
+    assert_response :bad_request
+    assert_equal "invalid_filter", json.dig("error", "code")
+  end
+
+  test "shows one user, and a user from another business is not found" do
+    get "/api/v1/users/#{@agent_id}", headers: bearer(@owner_token)
+
+    assert_response :ok
+    assert_equal "sam@example.test", json.dig("user", "email")
+    assert_equal false, json.dig("user", "suspended")
+
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    verify_email!(email: "jo@globex.test", subdomain: "globex")
+    globex_token = sign_in!(subdomain: "globex", email: "jo@globex.test").dig("session", "token")
+
+    get "/api/v1/users/#{@agent_id}", headers: bearer(globex_token)
+    assert_response :not_found
+  end
+
+  test "agents and customers cannot manage people" do
+    [@agent_token, @avery_token].each do |token|
+      get "/api/v1/users", headers: bearer(token)
+      assert_response :forbidden
+      get "/api/v1/users/#{@agent_id}", headers: bearer(token)
+      assert_response :forbidden
+      patch_user(@avery.dig("user", "id"), { suspended: true }, token: token)
+      assert_response :forbidden
+    end
+    assert_equal false, User.find(@avery.dig("user", "id")).suspended?
+  end
+
+  # --- Suspending -------------------------------------------------------------------
+
+  test "suspending a user marks them suspended and signs them out everywhere" do
+    other_device = sign_in!(email: "sam@example.test", password: "my-team-password").dig("session", "token")
+
+    patch_user(@agent_id, { suspended: true })
+
+    assert_response :ok
+    assert_equal true, json.dig("user", "suspended")
+    assert_equal 0, Session.where(user_id: @agent_id).count
+
+    get "/api/v1/me", headers: bearer(@agent_token)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: bearer(other_device)
+    assert_response :unauthorized
+  end
+
+  test "a suspended user cannot sign in" do
+    patch_user(@agent_id, { suspended: true })
+
+    sign_in(email: "sam@example.test", password: "my-team-password")
+
+    assert_response :forbidden
+    assert_equal "user_suspended", json.dig("error", "code")
+  end
+
+  test "a suspended user's bearer token is refused even if a session somehow survived" do
+    # Simulate a session that outlived the suspension, e.g. from a race with sign-in.
+    User.find(@agent_id).update!(suspended: true)
+
+    get "/api/v1/tickets", headers: bearer(@agent_token)
+
+    assert_response :unauthorized
+  end
+
+  test "suspending clears the tickets assigned to the user, without touching the tickets" do
+    opened = open_request_for(@avery_token)
+    patch "/api/v1/tickets/#{opened['id']}", params: { ticket: { assignee_id: @agent_id } }, headers: bearer(@owner_token), as: :json
+    assert_response :ok
+    updated_at = Request.find(opened["id"]).updated_at
+
+    travel 1.hour do
+      patch_user(@agent_id, { suspended: true })
+    end
+
+    assert_nil Request.find(opened["id"]).assignee_id
+    assert_equal updated_at.to_i, Request.find(opened["id"]).updated_at.to_i
+  end
+
+  test "restoring a user lets them sign in again, without restoring the old sessions" do
+    patch_user(@agent_id, { suspended: true })
+    patch_user(@agent_id, { suspended: false })
+
+    assert_response :ok
+    assert_equal false, json.dig("user", "suspended")
+    get "/api/v1/me", headers: bearer(@agent_token)
+    assert_response :unauthorized
+
+    sign_in!(email: "sam@example.test", password: "my-team-password")
+  end
+
+  test "suspending a suspended user is a no-op" do
+    patch_user(@agent_id, { suspended: true })
+
+    patch_user(@agent_id, { suspended: true })
+
+    assert_response :ok
+    assert_equal true, json.dig("user", "suspended")
+  end
+
+  test "a PATCH must say whether the user is suspended" do
+    patch_user(@agent_id, { name: "Changed" })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "suspended").present?
+    assert_equal false, User.find(@agent_id).suspended?
+  end
+
+  test "suspended must be true or false, not a guess" do
+    patch_user(@agent_id, { suspended: "maybe" })
+
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "suspended").present?
+    assert_equal false, User.find(@agent_id).suspended?
+  end
+
+  test "a string false is a real false, not a suspension" do
+    patch_user(@agent_id, { suspended: "false" })
+
+    assert_response :ok
+    assert_equal false, json.dig("user", "suspended")
+  end
+
+  test "suspending a user in another business is a 404" do
+    signup!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+    globex_user = Account.find_by!(subdomain: "globex").users.first
+
+    patch_user(globex_user.id, { suspended: true })
+
+    assert_response :not_found
+    assert_equal false, globex_user.reload.suspended?
+  end
+
+  # --- The last active admin ----------------------------------------------------------
+
+  test "the last active admin cannot be suspended" do
+    patch_user(@owner_id, { suspended: true })
+
+    assert_response :unprocessable_content
+    assert_equal "last_active_admin", json.dig("error", "code")
+    assert_equal false, User.find(@owner_id).suspended?
+  end
+
+  test "an admin can be suspended while another active admin remains" do
+    ann = invited_session!(admin_token: @owner_token, email: "ann@example.test", role: "admin")
+    ann_id = ann.dig("user", "id")
+
+    patch_user(ann_id, { suspended: true })
+    assert_response :ok
+
+    # The owner is now the only active admin, so the owner is protected.
+    patch_user(@owner_id, { suspended: true })
+    assert_response :unprocessable_content
+    assert_equal "last_active_admin", json.dig("error", "code")
+  end
+
+  test "a suspended admin does not count as an active admin" do
+    ann = invited_session!(admin_token: @owner_token, email: "ann@example.test", role: "admin")
+    ann_token = ann.dig("session", "token")
+    ann_id = ann.dig("user", "id")
+    patch_user(@owner_id, { suspended: true }, token: ann_token) # ann suspends owner, leaving ann the only admin
+    assert_response :ok
+
+    patch_user(ann_id, { suspended: true }, token: ann_token)
+
+    assert_response :unprocessable_content
+    assert_equal "last_active_admin", json.dig("error", "code")
+  end
+
+  test "the last-admin rule does not stop an agent or customer from being suspended" do
+    patch_user(@agent_id, { suspended: true })
+    assert_response :ok
+
+    patch_user(@avery.dig("user", "id"), { suspended: true })
+    assert_response :ok
+  end
+
+  # --- Staff choices ----------------------------------------------------------------
+
+  test "staff lists active admins and agents, oldest first, with their names and roles" do
+    get "/api/v1/staff", headers: bearer(@agent_token)
+
+    assert_response :ok
+    assert_equal [@owner_id, @agent_id], json.fetch("staff").map { |s| s["id"] }
+    assert_equal({ "id" => @agent_id, "name" => "Sam", "role" => "agent" }, json.fetch("staff").last)
+    assert_equal 2, json["count"]
+  end
+
+  test "staff leaves out suspended users and customers" do
+    patch_user(@agent_id, { suspended: true })
+
+    get "/api/v1/staff", headers: bearer(@owner_token)
+
+    assert_equal [@owner_id], json.fetch("staff").map { |s| s["id"] }
+  end
+
+  test "customers cannot list staff" do
+    get "/api/v1/staff", headers: bearer(@avery_token)
+
+    assert_response :forbidden
+  end
+
+  test "staff listing is paginated" do
+    get "/api/v1/staff", params: { per_page: 1 }, headers: bearer(@owner_token)
+
+    assert_equal 1, json.fetch("staff").size
+    assert_equal 2, json["count"]
+    assert_equal 2, json["next_page"]
+  end
+
+  private
+
+  def open_request_for(token)
+    post "/api/v1/requests", params: { request: { subject: "Receipt", comment: { body: "Broken" } } },
+         headers: bearer(token), as: :json
+    assert_response :created, response.body
+    json.fetch("request")
+  end
+end
diff --git a/test/models/account_test.rb b/test/models/account_test.rb
new file mode 100644
index 0000000..a6db177
--- /dev/null
+++ b/test/models/account_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class AccountTest < ActiveSupport::TestCase
+  def build_account(**attrs)
+    Account.new({ name: "Acme", subdomain: "acme" }.merge(attrs))
+  end
+
+  test "subdomains are normalized to lowercase" do
+    account = build_account(subdomain: "  AcMe ")
+    account.validate
+    assert_equal "acme", account.subdomain
+  end
+
+  test "reserved subdomains are invalid" do
+    account = build_account(subdomain: "admin")
+    refute account.valid?
+    assert account.errors[:subdomain].present?
+  end
+
+  test "subdomains longer than 63 characters are invalid" do
+    refute build_account(subdomain: "a" * 64).valid?
+    assert build_account(subdomain: "a" * 63).valid?
+  end
+
+  test "reactivatable is true only inside the 90-day window" do
+    now = Time.current
+    account = Account.create!(name: "Acme", subdomain: "acme", cancelled_at: now)
+
+    assert account.reactivatable?(now: now + 89.days)
+    refute account.reactivatable?(now: now + 90.days)
+  end
+
+  test "an active account is not reactivatable and has no reactivate_by" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+
+    refute account.reactivatable?
+    assert_nil account.reactivate_by
+    assert_equal "active", account.as_api_json[:status]
+  end
+
+  test "cancel! twice raises a StateError" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+    account.cancel!
+
+    error = assert_raises(Account::StateError) { account.cancel! }
+    assert_equal "already_cancelled", error.code
+  end
+
+  test "reactivate! on an active account raises a StateError" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+
+    error = assert_raises(Account::StateError) { account.reactivate! }
+    assert_equal "not_cancelled", error.code
+  end
+end
diff --git a/test/models/automated_mail_test.rb b/test/models/automated_mail_test.rb
new file mode 100644
index 0000000..c174529
--- /dev/null
+++ b/test/models/automated_mail_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class AutomatedMailTest < ActiveSupport::TestCase
+  def automated?(headers = {}, from: "avery@example.test", type: nil)
+    message = Mail.new do
+      from from
+      to "acme@support.example.test"
+      subject "Hello"
+      body "Hello"
+    end
+    headers.each { |name, value| message[name] = value }
+    message.content_type = type if type
+    AutomatedMail.new(message).automated?
+  end
+
+  test "an ordinary message is not automated" do
+    refute automated?
+  end
+
+  test "Auto-Submitted other than no marks a machine message" do
+    assert automated?({ "Auto-Submitted" => "auto-generated" })
+    assert automated?({ "Auto-Submitted" => "auto-replied" })
+    refute automated?({ "Auto-Submitted" => "no" })
+  end
+
+  test "bulk, list and junk precedence mark bulk mail" do
+    assert automated?({ "Precedence" => "bulk" })
+    assert automated?({ "Precedence" => "List" })
+    assert automated?({ "Precedence" => "junk" })
+    refute automated?({ "Precedence" => "first-class" })
+  end
+
+  test "any List- header marks mailing-list mail" do
+    assert automated?({ "List-Id" => "<news.example.test>" })
+    assert automated?({ "List-Unsubscribe" => "<mailto:leave@example.test>" })
+  end
+
+  test "auto-responder headers mark automatic replies" do
+    assert automated?({ "X-Autoreply" => "yes" })
+    assert automated?({ "X-Autorespond" => "yes" })
+    assert automated?({ "X-Auto-Response-Suppress" => "All" })
+  end
+
+  test "an empty return path marks a bounce" do
+    assert automated?({ "Return-Path" => "<>" })
+    refute automated?({ "Return-Path" => "<avery@example.test>" })
+  end
+
+  test "delivery and read reports are automated" do
+    assert automated?({}, type: "multipart/report; report-type=delivery-status")
+    assert automated?({}, type: "message/delivery-status")
+  end
+
+  test "mailer daemons and no-reply senders are automated" do
+    assert automated?({}, from: "Mailer-Daemon@example.test")
+    assert automated?({}, from: "noreply@example.test")
+    refute automated?({}, from: "norah@example.test")
+  end
+end
diff --git a/test/models/group_membership_test.rb b/test/models/group_membership_test.rb
new file mode 100644
index 0000000..4712af7
--- /dev/null
+++ b/test/models/group_membership_test.rb
@@ -0,0 +1,139 @@
+require "test_helper"
+
+# The invariants behind group memberships. The API tests cover the requests; these check the rules
+# hold below the API too, including in the database.
+class GroupMembershipTest < ActiveSupport::TestCase
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme", owner: nil)
+    @agent = @account.users.create!(name: "Sam", email: "sam@acme.test", password: "my-team-password",
+                                    role: "agent", verified_at: Time.current)
+    @customer = @account.users.create!(name: "Avery", email: "avery@acme.test", password: "my-customer-password",
+                                       role: "customer", verified_at: Time.current)
+    @billing = @account.groups.create!(name: "Billing")
+    @support = @account.groups.create!(name: "Technical Support")
+  end
+
+  def defaults_for(user)
+    GroupMembership.where(user: user, default: true).pluck(:group_id)
+  end
+
+  test "the database allows only one default per staff member" do
+    GroupMembership.add!(group: @billing, user: @agent)
+    GroupMembership.add!(group: @support, user: @agent)
+
+    assert_raises(ActiveRecord::RecordNotUnique) do
+      GroupMembership.insert_all!([{ group_id: @billing.id, user_id: @agent.id, default: true,
+                                    created_at: Time.current, updated_at: Time.current }])
+    end
+  end
+
+  test "the database allows only one membership per group and staff member" do
+    GroupMembership.add!(group: @billing, user: @agent)
+
+    assert_raises(ActiveRecord::RecordNotUnique) do
+      GroupMembership.insert_all!([{ group_id: @billing.id, user_id: @agent.id, default: false,
+                                    created_at: Time.current, updated_at: Time.current }])
+    end
+  end
+
+  test "the first membership is the default, and later ones are not unless asked" do
+    first = GroupMembership.add!(group: @billing, user: @agent)
+    second = GroupMembership.add!(group: @support, user: @agent)
+
+    assert first.default?
+    refute second.default?
+  end
+
+  test "a membership asked to be default takes the default from the others" do
+    GroupMembership.add!(group: @billing, user: @agent)
+    support = GroupMembership.add!(group: @support, user: @agent, default: true)
+
+    assert support.default?
+    assert_equal [@support.id], defaults_for(@agent)
+  end
+
+  test "a staff member's first membership is the default even when default is false" do
+    membership = GroupMembership.add!(group: @billing, user: @agent, default: false)
+
+    assert membership.default?
+  end
+
+  test "the oldest remaining membership becomes the default when the default is removed" do
+    billing = GroupMembership.add!(group: @billing, user: @agent)
+    third = @account.groups.create!(name: "Sales")
+    GroupMembership.add!(group: @support, user: @agent)
+    GroupMembership.add!(group: third, user: @agent)
+
+    billing.remove!
+
+    assert_equal [@support.id], defaults_for(@agent)
+  end
+
+  test "making a membership the default twice is harmless" do
+    membership = GroupMembership.add!(group: @billing, user: @agent)
+
+    membership.make_default!
+    membership.make_default!
+
+    assert_equal [@billing.id], defaults_for(@agent)
+  end
+
+  test "a customer cannot be put in a group" do
+    error = assert_raises(ActiveRecord::RecordInvalid) do
+      GroupMembership.add!(group: @billing, user: @customer)
+    end
+
+    assert error.record.errors[:user].present?
+  end
+
+  test "a membership cannot join a group from another business" do
+    other = Account.create!(name: "Globex", subdomain: "globex")
+    other_group = other.groups.create!(name: "Sales")
+
+    error = assert_raises(ActiveRecord::RecordInvalid) do
+      GroupMembership.add!(group: other_group, user: @agent)
+    end
+
+    assert error.record.errors[:user].present?
+  end
+
+  test "a membership removed from a group unassigns the person's tickets in it, and no others" do
+    avery = @account.users.create!(name: "Avery", email: "ivy@acme.test", password: "my-customer-password",
+                                   role: "customer", verified_at: Time.current)
+    GroupMembership.add!(group: @billing, user: @agent)
+    GroupMembership.add!(group: @support, user: @agent)
+    in_billing = Request.submit!(requester: avery, subject: "Invoice", body: "Wrong")
+    in_billing.staff_reply!(author: @agent, group_id: @billing.id, assignee_id: @agent.id)
+    elsewhere = Request.submit!(requester: avery, subject: "Login", body: "Broken")
+    elsewhere.staff_reply!(author: @agent, group_id: @support.id, assignee_id: @agent.id)
+
+    GroupMembership.find_by!(group: @billing, user: @agent).remove!
+
+    assert_nil in_billing.reload.assignee_id
+    assert_equal @billing.id, in_billing.group_id
+    assert_equal @agent.id, elsewhere.reload.assignee_id
+  end
+
+  test "destroying an account with groups and memberships removes them all" do
+    GroupMembership.add!(group: @billing, user: @agent)
+    GroupMembership.add!(group: @support, user: @agent)
+    @account.cancel!(now: 100.days.ago)
+
+    travel_to Time.current do
+      assert_equal 1, Account.purge_cancelled!
+    end
+
+    assert_equal 0, Group.where(account_id: @account.id).count
+    assert_equal 0, GroupMembership.count
+  end
+
+  test "suspending a staff member keeps memberships, and the default" do
+    GroupMembership.add!(group: @billing, user: @agent)
+    GroupMembership.add!(group: @support, user: @agent, default: true)
+
+    @agent.suspend!
+
+    assert_equal 2, GroupMembership.where(user: @agent).count
+    assert_equal [@support.id], defaults_for(@agent)
+  end
+end
diff --git a/test/models/group_test.rb b/test/models/group_test.rb
new file mode 100644
index 0000000..f3025f4
--- /dev/null
+++ b/test/models/group_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class GroupTest < ActiveSupport::TestCase
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @agent = @account.users.create!(name: "Sam", email: "sam@acme.test", password: "my-team-password",
+                                    role: "agent", verified_at: Time.current)
+    @avery = @account.users.create!(name: "Avery", email: "avery@acme.test", password: "my-customer-password",
+                                    role: "customer", verified_at: Time.current)
+  end
+
+  test "names are trimmed, and they are required" do
+    group = @account.groups.create!(name: "  Billing ")
+    assert_equal "Billing", group.name
+
+    refute @account.groups.new(name: "  ").valid?
+    refute @account.groups.new(name: nil).valid?
+  end
+
+  test "names are unique within a business, ignoring case, and can repeat across businesses" do
+    @account.groups.create!(name: "Billing")
+
+    refute @account.groups.new(name: "BILLING").valid?
+    assert Account.create!(name: "Globex", subdomain: "globex").groups.new(name: "Billing").valid?
+  end
+
+  test "the database refuses a duplicate name that differs only in case" do
+    @account.groups.create!(name: "Billing")
+
+    assert_raises(ActiveRecord::RecordNotUnique) do
+      Group.insert_all!([{ account_id: @account.id, name: "billing", created_at: Time.current, updated_at: Time.current }])
+    end
+  end
+
+  test "deleting a group ungroups its tickets and clears their assignee, without touching their updated_at" do
+    billing = @account.groups.create!(name: "Billing")
+    ticket = Request.submit!(requester: @avery, subject: "Invoice", body: "Wrong")
+    GroupMembership.add!(group: billing, user: @agent)
+    ticket.staff_reply!(author: @agent, group_id: billing.id, assignee_id: @agent.id)
+    updated_at = ticket.reload.updated_at
+
+    travel 1.hour do
+      billing.remove!
+    end
+
+    ticket.reload
+    assert_nil ticket.group_id
+    assert_nil ticket.assignee_id
+    assert_equal updated_at.to_i, ticket.updated_at.to_i
+  end
+
+  test "a group can be removed while no tickets or memberships belong to it" do
+    group = @account.groups.create!(name: "Empty")
+
+    group.remove!
+
+    assert_nil Group.find_by(id: group.id)
+  end
+end
diff --git a/test/models/invitation_test.rb b/test/models/invitation_test.rb
new file mode 100644
index 0000000..30f97a0
--- /dev/null
+++ b/test/models/invitation_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class InvitationTest < ActiveSupport::TestCase
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @jo = @account.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin", verified_at: Time.current)
+    @now = Time.current
+  end
+
+  def issue(email: "sam@example.test", role: "agent", now: @now)
+    Invitation.issue!(account: @account, invited_by: @jo, email: email, role: role, now: now)
+  end
+
+  test "the raw token is returned once and only its digest is stored" do
+    invitation, raw = issue
+
+    assert_equal Invitation.digest(raw), invitation.reload.token_digest
+    refute_equal raw, invitation.token_digest
+    assert_equal invitation, Invitation.find_by_token(raw)
+    assert_nil Invitation.find_by_token("wrong")
+    assert_nil Invitation.find_by_token(nil)
+  end
+
+  test "status follows the timestamps, and expiry is inclusive at the deadline" do
+    invitation, = issue(now: @now)
+
+    assert_equal "pending", invitation.status(now: @now)
+    assert_equal "pending", invitation.status(now: invitation.expires_at - 1.second)
+    assert_equal "expired", invitation.status(now: invitation.expires_at)
+  end
+
+  test "accepted wins over revoked and expired" do
+    invitation, = issue(now: @now)
+    invitation.update_columns(accepted_at: @now, revoked_at: nil)
+
+    assert_equal "accepted", invitation.status(now: @now + 1.year)
+  end
+
+  test "the status scopes agree with the status method" do
+    now = @now
+    pending, = issue(email: "a@example.test", now: now)
+    expired, = issue(email: "b@example.test", now: now - Invitation::LIFETIME - 1.day)
+    revoked, = issue(email: "c@example.test", now: now)
+    revoked.update_columns(revoked_at: now)
+    accepted, = issue(email: "d@example.test", now: now)
+    accepted.update_columns(accepted_at: now)
+
+    expected = Invitation.where(account: @account).order(:id).to_h { |i| [i.id, i.status(now: now)] }
+    assert_equal({ pending.id => "pending", expired.id => "expired", revoked.id => "revoked", accepted.id => "accepted" }, expected)
+
+    Invitation::STATUSES.each do |status|
+      ids = Invitation.where(account: @account).with_status(status, now: now).pluck(:id)
+      assert_equal expected.select { |_, s| s == status }.keys.sort, ids.sort, status
+    end
+  end
+
+  test "an unknown status cannot be filtered on" do
+    assert_raises(ArgumentError) { Invitation.with_status("lost") }
+  end
+
+  test "a second pending invitation for the same email is refused" do
+    issue
+    error = assert_raises(ActiveRecord::RecordInvalid) { issue(role: "admin") }
+
+    assert_match(/already has a pending invitation/, error.record.errors[:email].first)
+  end
+
+  test "an email that already belongs to a member is refused" do
+    error = assert_raises(ActiveRecord::RecordInvalid) { issue(email: "jo@acme.test") }
+
+    assert_match(/already belongs to someone/, error.record.errors[:email].first)
+  end
+
+  test "roles are limited to admin and agent" do
+    error = assert_raises(ActiveRecord::RecordInvalid) { issue(role: "customer") }
+
+    assert_equal ["must be admin or agent"], error.record.errors[:role]
+  end
+
+  test "revoked or expired invitations do not block a new one" do
+    old, = issue(now: @now - Invitation::LIFETIME - 1.day)
+    fresh, = issue(now: @now)
+
+    assert_equal "expired", old.status(now: @now)
+    assert_equal "pending", fresh.status(now: @now)
+    assert_operator fresh.id, :>, old.id
+  end
+
+  test "an expired invitation cannot be accepted, and an accepted one cannot be accepted again" do
+    expired, = issue(email: "e@example.test", now: @now - Invitation::LIFETIME - 1.day)
+    error = assert_raises(StateError) { expired.accept!(name: "E", password: "my-team-password", now: @now) }
+    assert_equal "invitation_expired", error.code
+
+    invitation, = issue(email: "f@example.test", now: @now)
+    invitation.accept!(name: "F", password: "my-team-password", now: @now)
+    error = assert_raises(StateError) { invitation.accept!(name: "F", password: "my-team-password", now: @now) }
+    assert_equal "invitation_accepted", error.code
+  end
+
+  test "accepting creates a verified user with the invited role and leaves no partial account on failure" do
+    invitation, = issue(role: "admin")
+
+    assert_raises(ActiveRecord::RecordInvalid) { invitation.accept!(name: "", password: "my-team-password") }
+    assert_equal "pending", invitation.reload.status
+    assert_equal 0, User.where(email: "sam@example.test").count
+
+    user = invitation.accept!(name: "Sam", password: "my-team-password")
+    assert_equal "admin", user.role
+    assert user.verified?
+    assert_equal "accepted", invitation.reload.status
+  end
+
+  test "resending issues a new token and a full lifetime" do
+    invitation, old_raw = issue(now: @now - 6.days)
+
+    new_raw = invitation.resend!(now: @now)
+
+    assert_nil Invitation.find_by_token(old_raw)
+    assert_equal invitation, Invitation.find_by_token(new_raw)
+    assert_in_delta (@now + Invitation::LIFETIME).to_f, invitation.reload.expires_at.to_f, 1
+  end
+
+  test "a pending invitation blocks customer registration for its email, and others do not" do
+    issue
+    assert Invitation.pending_for_email?(@account, "sam@example.test")
+    refute Invitation.pending_for_email?(@account, "other@example.test")
+    refute Invitation.pending_for_email?(Account.create!(name: "Globex", subdomain: "globex"), "sam@example.test")
+  end
+
+  test "the API view never includes the token" do
+    invitation, raw = issue
+
+    refute_includes invitation.as_api_json.to_s, raw
+    refute_includes invitation.as_api_json.keys.map(&:to_s), "token_digest"
+  end
+end
diff --git a/test/models/mail_text_test.rb b/test/models/mail_text_test.rb
new file mode 100644
index 0000000..f8185b5
--- /dev/null
+++ b/test/models/mail_text_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class MailTextTest < ActiveSupport::TestCase
+  def mail_from(source)
+    Mail.from_source(source.gsub("\n", "\r\n"))
+  end
+
+  test "reads a plain text body with CRLF line endings as Unix lines" do
+    mail = mail_from(<<~EOM)
+      From: avery@example.test
+      Subject: Hi
+      Content-Type: text/plain; charset=UTF-8
+
+      Line one
+      Line two
+    EOM
+
+    assert_equal "Line one\nLine two", MailText.from(mail)
+  end
+
+  test "converts a non-UTF-8 charset to UTF-8" do
+    mail = mail_from(<<~EOM)
+      From: avery@example.test
+      Subject: Hi
+      Content-Type: text/plain; charset=ISO-8859-1
+      Content-Transfer-Encoding: quoted-printable
+
+      Caf=E9 receipt
+    EOM
+
+    assert_equal "Café receipt", MailText.from(mail)
+  end
+
+  test "prefers the plain text part of a multipart/alternative message" do
+    mail = mail_from(<<~EOM)
+      From: avery@example.test
+      Subject: Hi
+      MIME-Version: 1.0
+      Content-Type: multipart/alternative; boundary="ALT"
+
+      --ALT
+      Content-Type: text/plain; charset=UTF-8
+
+      Plain version
+      --ALT
+      Content-Type: text/html; charset=UTF-8
+
+      <p>HTML version</p>
+      --ALT--
+    EOM
+
+    assert_equal "Plain version", MailText.from(mail)
+  end
+
+  test "ignores attachments, even text ones" do
+    mail = mail_from(<<~EOM)
+      From: avery@example.test
+      Subject: Hi
+      MIME-Version: 1.0
+      Content-Type: multipart/mixed; boundary="BOUND"
+
+      --BOUND
+      Content-Type: text/plain; charset=UTF-8
+
+      The real message
+      --BOUND
+      Content-Type: text/plain; name="notes.txt"
+      Content-Disposition: attachment; filename="notes.txt"
+
+      attachment text
+      --BOUND--
+    EOM
+
+    assert_equal "The real message", MailText.from(mail)
+  end
+
+  test "converts an HTML-only message, dropping styles and scripts" do
+    mail = mail_from(<<~EOM)
+      From: avery@example.test
+      Subject: Hi
+      Content-Type: text/html; charset=UTF-8
+
+      <html><head><title>T</title><style>p{color:red}</style></head>
+      <body><p>First&nbsp;paragraph &amp; more</p><script>evil()</script><div>Second<br>line</div></body></html>
+    EOM
+
+    text = MailText.from(mail)
+    assert_includes text, "First\u00a0paragraph & more"
+    assert_includes text, "Second\nline"
+    refute_includes text, "color"
+    refute_includes text, "evil"
+    refute_includes text, "T\n"
+  end
+
+  test "a message with only whitespace has no text" do
+    mail = mail_from(<<~EOM)
+      From: avery@example.test
+      Subject: Hi
+      Content-Type: text/plain; charset=UTF-8
+
+         \n\n
+    EOM
+
+    assert_nil MailText.from(mail)
+  end
+
+  test "NUL characters are removed, since PostgreSQL cannot store them" do
+    mail = Mail.new
+    mail.from = "avery@example.test"
+    mail.body = "before\u0000after"
+
+    assert_equal "beforeafter", MailText.from(mail)
+  end
+end
diff --git a/test/models/request_test.rb b/test/models/request_test.rb
new file mode 100644
index 0000000..14bacb3
--- /dev/null
+++ b/test/models/request_test.rb
@@ -0,0 +1,190 @@
+require "test_helper"
+
+class RequestTest < ActiveSupport::TestCase
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @customer = @account.users.create!(name: "Avery", email: "avery@example.test", password: "my-customer-password", role: "customer")
+    @agent = @account.users.create!(name: "Sam", email: "sam@acme.test", password: "my-first-password", role: "agent")
+    @request = Request.submit!(requester: @customer, subject: "Receipt", body: "Button does nothing.")
+  end
+
+  def status
+    @request.reload.status
+  end
+
+  test "submit! opens the request with a public first comment" do
+    assert_equal "open", @request.status
+    assert_equal @customer, @request.requester
+    assert_equal @account, @request.account
+    assert_equal [["Button does nothing.", true]], @request.comments.map { |c| [c.body, c.public?] }
+  end
+
+  test "submit! saves nothing when the comment is blank" do
+    assert_no_difference -> { Request.count } do
+      assert_raises(ActiveRecord::RecordInvalid) do
+        Request.submit!(requester: @customer, subject: "Receipt", body: "")
+      end
+    end
+  end
+
+  test "a requester reply reopens pending and solved requests" do
+    @request.staff_reply!(author: @agent, status: "pending")
+    @request.requester_reply!(author: @customer, body: "Still broken")
+    assert_equal "open", status
+
+    @request.staff_reply!(author: @agent, status: "solved")
+    @request.requester_reply!(author: @customer, body: "Broken again")
+    assert_equal "open", status
+  end
+
+  test "a requester can mark solved, with or without a comment" do
+    @request.requester_reply!(author: @customer, status: "solved")
+    assert_equal "solved", status
+
+    @request.requester_reply!(author: @customer, body: "Thanks!", status: "solved")
+    assert_equal "solved", status
+  end
+
+  test "a requester cannot set pending or open" do
+    %w[pending open bogus].each do |value|
+      error = assert_raises(ActiveRecord::RecordInvalid) do
+        @request.requester_reply!(author: @customer, body: "Nope", status: value)
+      end
+      assert error.record.errors[:status].present?
+    end
+    assert_equal 1, @request.comments.count
+    assert_equal "open", status
+  end
+
+  test "a requester reply needs a comment or a status" do
+    error = assert_raises(ActiveRecord::RecordInvalid) { @request.requester_reply!(author: @customer) }
+
+    assert error.record.errors[:base].present?
+  end
+
+  test "a staff reply without a status keeps the status" do
+    @request.staff_reply!(author: @agent, status: "pending")
+    @request.staff_reply!(author: @agent, body: "On it.")
+
+    assert_equal "pending", status
+    assert_equal "On it.", @request.comments.order(:id).last.body
+  end
+
+  test "a staff reply can be a private note" do
+    @request.staff_reply!(author: @agent, body: "Internal.", public: false)
+
+    assert_equal false, @request.comments.order(:id).last.public?
+  end
+
+  test "a bad status from staff saves nothing, including the comment" do
+    assert_no_difference -> { Comment.count } do
+      assert_raises(ActiveRecord::RecordInvalid) do
+        @request.staff_reply!(author: @agent, body: "Half done.", status: "closed")
+      end
+    end
+    assert_equal "open", status
+  end
+
+  test "a request and its comments cannot belong to another business" do
+    other = Account.create!(name: "Globex", subdomain: "globex")
+    outsider = other.users.create!(name: "Ivy", email: "ivy@globex.test", password: "my-first-password", role: "agent")
+
+    mismatched = Request.new(account: @account, requester: outsider, subject: "Hi", status: "open")
+    refute mismatched.valid?
+    assert mismatched.errors[:requester].present?
+
+    comment = @request.comments.build(author: outsider, body: "Hello", public: true)
+    refute comment.valid?
+    assert comment.errors[:author].present?
+  end
+
+  test "a comment touches its request so the request sorts as recently active" do
+    other = Request.submit!(requester: @customer, subject: "Other", body: "Hi")
+    # Without a touch, `other` would be the most recent. The reply must move @request ahead of it.
+    @request.update_columns(updated_at: 3.days.ago)
+    other.update_columns(updated_at: 2.days.ago)
+    assert_equal other.id, Request.where(account: @account).recently_active.first.id
+
+    @request.comments.create!(author: @customer, body: "Bump", public: true)
+
+    assert_equal @request.id, Request.where(account: @account).recently_active.first.id
+  end
+
+  test "a new request is normal priority, and a customer's reply does not change it" do
+    assert_equal "normal", @request.priority
+
+    @request.requester_reply!(author: @customer, body: "Any update?")
+
+    assert_equal "normal", @request.reload.priority
+  end
+
+  test "priority must be normal or high" do
+    refute @request.tap { |r| r.priority = "urgent" }.valid?
+    assert @request.tap { |r| r.priority = "high" }.valid?
+  end
+
+  test "a staff reply can set priority on its own, with no comment added" do
+    assert_no_difference -> { Comment.count } do
+      @request.staff_reply!(author: @agent, priority: "high")
+    end
+
+    assert_equal "high", @request.reload.priority
+    assert_equal "open", @request.status
+  end
+
+  test "a bad priority from staff saves nothing, including the comment" do
+    assert_no_difference -> { Comment.count } do
+      assert_raises(ActiveRecord::RecordInvalid) do
+        @request.staff_reply!(author: @agent, body: "Escalating.", priority: "urgent")
+      end
+    end
+
+    assert_equal "normal", @request.reload.priority
+  end
+
+  test "a priority change alone does not touch the request" do
+    @request.update_columns(updated_at: 3.days.ago)
+    before = @request.reload.updated_at
+
+    @request.staff_reply!(author: @agent, priority: "high")
+
+    assert_equal before, @request.reload.updated_at
+  end
+
+  test "the search matches subjects and public comments, not private notes" do
+    @request.staff_reply!(author: @agent, body: "Internal: refund approved.", public: false)
+    other = Request.submit!(requester: @customer, subject: "Login", body: "I see a receipt error.")
+
+    assert_equal [@request.id, other.id].sort, Request.search("receipt").ids.sort
+    assert_equal [other.id], Request.search("RECEIPT ERROR").ids
+    assert_empty Request.search("refund")
+  end
+
+  test "the search treats % and _ as literal characters" do
+    percent = Request.submit!(requester: @customer, subject: "Discount 50% off", body: "Ok.")
+    underscore = Request.submit!(requester: @customer, subject: "file_name", body: "Ok.")
+
+    assert_equal [percent.id], Request.search("50%").ids
+    assert_equal [underscore.id], Request.search("file_name").ids
+    assert_equal [percent.id], Request.search("%").ids
+    assert_equal [underscore.id], Request.search("_").ids
+    assert_empty Request.search("50_off")
+  end
+
+  test "the staff view adds the requester's details" do
+    view = @request.as_ticket_api_json
+
+    assert_equal({ id: @customer.id, name: "Avery", email: "avery@example.test" }, view[:requester])
+    assert_equal @customer.id, view[:requester_id]
+  end
+
+  test "purging a cancelled account removes its requests and their comments" do
+    @request.staff_reply!(author: @agent, body: "Internal", public: false)
+    Request.submit!(requester: @customer, subject: "Second", body: "Hello")
+    @account.update!(cancelled_at: 100.days.ago)
+
+    assert_equal 1, Account.purge_cancelled!
+    assert_equal 0, Request.count
+    assert_equal 0, Comment.count
+  end
+end
diff --git a/test/models/support_address_test.rb b/test/models/support_address_test.rb
new file mode 100644
index 0000000..e7d6b49
--- /dev/null
+++ b/test/models/support_address_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class SupportAddressTest < ActiveSupport::TestCase
+  setup do
+    @account = Account.new(name: "Acme", subdomain: "acme")
+    @request = Request.new(reply_token: "0123456789abcdef0123456789abcdef", origin: "email")
+  end
+
+  test "a business's address is its subdomain on the support domain" do
+    assert_equal "acme@support.example.test", SupportAddress.for_account(@account)
+  end
+
+  test "a request's reply address is reply+token on the support domain" do
+    assert_equal "reply+0123456789abcdef0123456789abcdef@support.example.test", SupportAddress.reply_for(@request)
+  end
+
+  test "the domain comes from HELPDESK_SUPPORT_DOMAIN, with support.example.test as the default" do
+    with_env("HELPDESK_SUPPORT_DOMAIN" => nil) do
+      assert_equal "support.example.test", SupportAddress.domain
+    end
+    with_env("HELPDESK_SUPPORT_DOMAIN" => " Help.Acme.Test ") do
+      assert_equal "help.acme.test", SupportAddress.domain
+      assert_equal "acme@help.acme.test", SupportAddress.for_account(@account)
+    end
+  end
+
+  test "parses a business address" do
+    assert_equal [:business, "acme"], SupportAddress.parse("acme@support.example.test")
+    assert_equal [:business, "acme"], SupportAddress.parse("ACME@Support.Example.Test")
+  end
+
+  test "parses a display-name form and an angle-bracket form" do
+    assert_equal [:business, "acme"], SupportAddress.parse("Acme Help <acme@support.example.test>")
+    assert_equal [:business, "acme"], SupportAddress.parse("<acme@support.example.test>")
+  end
+
+  test "parses a reply address into its token" do
+    token = "0123456789abcdef0123456789abcdef"
+    assert_equal [:reply, token], SupportAddress.parse("reply+#{token}@support.example.test")
+  end
+
+  test "a reply token must be 32 lowercase hex characters" do
+    assert_nil SupportAddress.parse("reply+0123@support.example.test")
+    assert_nil SupportAddress.parse("reply+XYZ3456789abcdef0123456789abcdef@support.example.test")
+  end
+
+  test "addresses off the support domain, or with two @ signs, are not support addresses" do
+    assert_nil SupportAddress.parse("acme@example.test")
+    assert_nil SupportAddress.parse("acme@support.example.test.evil.test")
+    assert_nil SupportAddress.parse("acme@x@support.example.test")
+    assert_nil SupportAddress.parse("")
+    assert_nil SupportAddress.parse(nil)
+  end
+
+  test "a local part that is not a valid subdomain is not a business" do
+    assert_nil SupportAddress.parse("-acme@support.example.test")
+    assert_nil SupportAddress.parse("ac_me@support.example.test")
+  end
+
+  test "a business can never be mistaken for a reply address" do
+    # The '+' cannot appear in a subdomain, so no business has a reply-shaped name.
+    refute Account::SUBDOMAIN_FORMAT.match?("reply+0123456789abcdef0123456789abcdef")
+  end
+
+  private
+
+  def with_env(values)
+    previous = values.keys.to_h { |key| [key, ENV[key]] }
+    values.each { |key, value| ENV[key] = value }
+    yield
+  ensure
+    previous.each { |key, value| ENV[key] = value }
+  end
+end
diff --git a/test/models/user_test.rb b/test/models/user_test.rb
new file mode 100644
index 0000000..b159f65
--- /dev/null
+++ b/test/models/user_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class UserTest < ActiveSupport::TestCase
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+  end
+
+  test "emails are normalized and unique per account only" do
+    @account.users.create!(name: "Jo", email: " Jo@Acme.test ", password: "my-first-password", role: "admin")
+    assert_equal "jo@acme.test", User.last.email
+
+    other = Account.create!(name: "Globex", subdomain: "globex")
+    assert other.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin").persisted?
+  end
+
+  test "only known roles are allowed" do
+    user = @account.users.new(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "owner")
+    refute user.valid?
+    assert user.errors[:role].present?
+  end
+
+  test "change_password! revokes every session" do
+    user = @account.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+    Session.start_for(user)
+    Session.start_for(user)
+
+    user.change_password!("my-new-password")
+
+    assert_equal 0, Session.where(user_id: user.id).count
+    assert user.reload.authenticate("my-new-password")
+  end
+
+  test "change_password! refuses a blank password and keeps sessions" do
+    user = @account.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+    Session.start_for(user)
+
+    assert_raises(ActiveRecord::RecordInvalid) { user.change_password!("") }
+    assert_equal 1, Session.where(user_id: user.id).count
+    assert user.reload.authenticate("my-first-password")
+  end
+end
+
+class UserPasswordCheckTest < ActiveSupport::TestCase
+  test "burn_password_check never matches and returns nil" do
+    assert_nil User.burn_password_check("anything")
+    assert_nil User.burn_password_check("")
+  end
+end
diff --git a/test/models/user_token_test.rb b/test/models/user_token_test.rb
new file mode 100644
index 0000000..77ea825
--- /dev/null
+++ b/test/models/user_token_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class UserTokenTest < ActiveSupport::TestCase
+  setup do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+    @user = account.users.create!(name: "Jo", email: "jo@acme.test", password: "my-first-password", role: "admin")
+  end
+
+  test "issuing replaces the earlier token for the same purpose only" do
+    first = UserToken.issue!(@user, :email_verification)
+    reset = UserToken.issue!(@user, :password_reset)
+    second = UserToken.issue!(@user, :email_verification)
+
+    assert_nil UserToken.redeem(:email_verification, first)
+    assert UserToken.redeem(:email_verification, second)
+    assert UserToken.redeem(:password_reset, reset)
+  end
+
+  test "only the digest is stored" do
+    raw = UserToken.issue!(@user, :password_reset)
+
+    assert_equal 1, UserToken.where(token_digest: Digest::SHA256.hexdigest(raw)).count
+    assert_equal 0, UserToken.where(token_digest: raw).count
+  end
+
+  test "tokens for one purpose do not redeem as another" do
+    raw = UserToken.issue!(@user, :email_verification)
+    assert_nil UserToken.redeem(:password_reset, raw)
+  end
+
+  test "unknown purposes are rejected" do
+    record = UserToken.new(user: @user, purpose: "magic", token_digest: "x", expires_at: 1.hour.from_now)
+    refute record.valid?
+  end
+
+  test "lifetimes are 3 days for verification and 1 hour for reset" do
+    raw = UserToken.issue!(@user, :email_verification)
+    assert_in_delta 3.days.from_now.to_f, UserToken.redeem(:email_verification, raw).expires_at.to_f, 5
+
+    raw = UserToken.issue!(@user, :password_reset)
+    assert_in_delta 1.hour.from_now.to_f, UserToken.redeem(:password_reset, raw).expires_at.to_f, 5
+  end
+end
diff --git a/test/test_helper.rb b/test/test_helper.rb
new file mode 100644
index 0000000..7cecd69
--- /dev/null
+++ b/test/test_helper.rb
@@ -0,0 +1,205 @@
+ENV["RAILS_ENV"] ||= "test"
+require_relative "../config/environment"
+require "rails/test_help"
+
+module ApiTestHelpers
+  ACCOUNT_HEADER = "X-Helpdesk-Account".freeze
+  PASSWORD = "my-first-password".freeze
+  CUSTOMER_PASSWORD = "my-customer-password".freeze
+
+  def json
+    JSON.parse(response.body)
+  end
+
+  def bearer(token)
+    { "Authorization" => "Bearer #{token}" }
+  end
+
+  def in_account(subdomain, extra = {})
+    { ACCOUNT_HEADER => subdomain }.merge(extra)
+  end
+
+  def signup_params(subdomain: "acme", name: "Acme", email: "jo@acme.test", password: PASSWORD)
+    { account: { name: name, subdomain: subdomain, admin: { name: "Jo", email: email, password: password } } }
+  end
+
+  def signup!(**options)
+    post "/api/v1/account/create", params: signup_params(**options), as: :json
+    assert_response :created, response.body
+    json
+  end
+
+  def sign_in(email: "jo@acme.test", password: PASSWORD, subdomain: "acme")
+    post "/api/v1/sessions",
+         params: { session: { email: email, password: password } },
+         headers: in_account(subdomain),
+         as: :json
+  end
+
+  def sign_in!(**options)
+    sign_in(**options)
+    assert_response :created, response.body
+    json
+  end
+
+  # The most recent mail sent to `to`, as a Mail::Message.
+  def latest_mail(to)
+    ActionMailer::Base.deliveries.select { |mail| Array(mail.to).include?(to) }.last or
+      flunk "no mail was sent to #{to}"
+  end
+
+  # Pulls the `token` parameter out of the link in the latest mail to `to`,
+  # checking that the link points at the expected frontend page.
+  def link_token(to:, path:)
+    text = latest_mail(to).body.decoded
+    link = text[%r{#{Regexp.escape(Helpdesk::Settings.frontend_url)}#{Regexp.escape(path)}\?\S+}]
+    flunk "no #{path} link in mail to #{to}" unless link
+
+    Rack::Utils.parse_query(URI.parse(link).query).fetch("token")
+  end
+
+  def verify_email!(email: "jo@acme.test", subdomain: "acme")
+    token = link_token(to: email, path: "/verify-email")
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: token } },
+         headers: in_account(subdomain),
+         as: :json
+    assert_response :ok, response.body
+  end
+
+  def registration_params(name: "Avery", email: "avery@example.test", password: CUSTOMER_PASSWORD)
+    { user: { name: name, email: email, password: password } }
+  end
+
+  def register!(subdomain: "acme", **options)
+    post "/api/v1/registrations",
+         params: registration_params(**options),
+         headers: in_account(subdomain),
+         as: :json
+    assert_response :created, response.body
+    json
+  end
+
+  # Registers, verifies and signs in a customer. Returns the sign-in JSON.
+  def customer_session(subdomain: "acme", email: "avery@example.test", password: CUSTOMER_PASSWORD, name: "Avery")
+    register!(subdomain: subdomain, name: name, email: email, password: password)
+    verify_email!(email: email, subdomain: subdomain)
+    sign_in!(email: email, password: password, subdomain: subdomain)
+  end
+
+  # Adds a staff member directly, since the API has no staff invitations yet.
+  def add_staff!(email:, role: "agent", subdomain: "acme", password: PASSWORD)
+    Account.find_by!(subdomain: subdomain).users.create!(
+      name: "Sam", email: email, password: password, role: role, verified_at: Time.current
+    )
+  end
+
+  # Opens a request as the customer behind `token`. Returns the request JSON.
+  def open_request!(token, subject: "Cannot download my receipt", body: "The download button does nothing.")
+    post "/api/v1/requests",
+         params: { request: { subject: subject, comment: { body: body } } },
+         headers: bearer(token),
+         as: :json
+    assert_response :created, response.body
+    json.fetch("request")
+  end
+
+  # Signs up and verifies the owner, then signs in. Returns the sign-in JSON.
+  def owner_session(subdomain: "acme", email: "jo@acme.test", password: PASSWORD)
+    signup!(subdomain: subdomain, email: email, password: password)
+    verify_email!(email: email, subdomain: subdomain)
+    sign_in!(email: email, password: password, subdomain: subdomain)
+  end
+
+  # Invites someone as the admin behind `token`. Returns the invitation JSON.
+  def invite!(token:, email: "sam@example.test", role: "agent")
+    post "/api/v1/invitations", params: { invitation: { email: email, role: role } }, headers: bearer(token), as: :json
+    assert_response :created, response.body
+    json.fetch("invitation")
+  end
+
+  # The raw token from the most recent invitation email sent to `email`.
+  def invitation_token(email: "sam@example.test")
+    link_token(to: email, path: "/accept-invitation")
+  end
+
+  # Accepts the latest invitation sent to `email`. Returns the acceptance JSON.
+  def accept_invitation!(email: "sam@example.test", name: "Sam", password: "my-team-password")
+    post "/api/v1/invitation_acceptances",
+         params: { invitation_acceptance: { token: invitation_token(email: email), name: name, password: password } },
+         as: :json
+    assert_response :created, response.body
+    json
+  end
+
+  # Invites and accepts someone, then signs them in. Returns the sign-in JSON.
+  def invited_session!(admin_token:, email: "sam@example.test", role: "agent", password: "my-team-password")
+    invite!(token: admin_token, email: email, role: role)
+    accept_invitation!(email: email, password: password)
+    sign_in!(email: email, password: password)
+  end
+
+  # Suspends the user with `user_id` as the admin behind `token`.
+  def suspend_user!(token:, user_id:)
+    patch "/api/v1/users/#{user_id}", params: { user: { suspended: true } }, headers: bearer(token), as: :json
+    assert_response :ok, response.body
+    json
+  end
+
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails".freeze
+
+  # Builds an email as a mail client would send it, and returns its raw source. `html` replaces the
+  # body with an HTML one; pass body: nil with it for an HTML-only message.
+  def build_mail(from: "avery@example.test", to: "acme@support.example.test", cc: nil,
+                 subject: "Cannot download my receipt", body: "The download button does nothing.",
+                 message_id: nil, headers: {}, html: nil, attachment: nil)
+    message = Mail.new
+    message.from = from
+    message.to = to
+    message.cc = cc if cc
+    message.subject = subject
+    message["Message-ID"] = message_id || "<#{SecureRandom.hex(8)}@example.test>"
+    headers.each { |name, value| message[name] = value }
+    if html && body.nil?
+      message.content_type = "text/html; charset=UTF-8"
+      message.body = html
+    elsif html || attachment
+      # Parts are set explicitly: adding an attachment to a single-part message would drop its body.
+      message.text_part = Mail::Part.new(content_type: "text/plain; charset=UTF-8", body: body)
+      message.html_part = Mail::Part.new(content_type: "text/html; charset=UTF-8", body: html) if html
+      message.attachments["notes.txt"] = { mime_type: "text/plain", content: attachment } if attachment
+    else
+      message.body = body
+    end
+    message.to_s
+  end
+
+  # Posts a raw email to the relay ingress, as the SMTP relay does, using the inbound password.
+  def relay_mail(raw, password: ENV.fetch("RAILS_INBOUND_EMAIL_PASSWORD"))
+    headers = { "CONTENT_TYPE" => "message/rfc822" }
+    if password
+      headers["Authorization"] = ActionController::HttpAuthentication::Basic.encode_credentials("actionmailbox", password)
+    end
+    post RELAY_PATH, params: raw, headers: headers
+  end
+
+  # Relays an email and checks the relay accepted it. Processing happens inside the request, in test.
+  def receive_mail!(raw)
+    relay_mail(raw)
+    assert_response :no_content, response.body
+  end
+
+  # The mail sent to `to`, in the order sent.
+  def mails_to(to)
+    ActionMailer::Base.deliveries.select { |mail| Array(mail.to).include?(to) }
+  end
+end
+
+class ActionDispatch::IntegrationTest
+  include ApiTestHelpers
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+end
