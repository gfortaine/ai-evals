diff --git a/app/controllers/api/v1/password_resets_controller.rb b/app/controllers/api/v1/password_resets_controller.rb
new file mode 100644
index 0000000..fabd76b
--- /dev/null
+++ b/app/controllers/api/v1/password_resets_controller.rb
@@ -0,0 +1,36 @@
+module Api
+  module V1
+    class PasswordResetsController < ApplicationController
+      before_action :load_account_from_header!, only: :create
+
+      # POST /api/v1/password_resets  { password_reset: { email } }
+      def create
+        email = require_envelope(:password_reset).require(:email)
+        user = @account.users.find_by(email: email.to_s)
+
+        # Same answer whether or not the email exists.
+        if user
+          token = UserToken.issue!(user, :password_reset)
+          UserMailer.password_reset(user, token).deliver_later
+        end
+
+        render json: { message: "If that email belongs to an account, a password reset link is on its way." }, status: :accepted
+      end
+
+      # POST /api/v1/password_resets/confirm  { password_reset: { token, password } }
+      def confirm
+        reset = require_envelope(:password_reset)
+        record = UserToken.redeem(:password_reset, reset.require(:token))
+        user = record&.user
+        return render_error(422, "invalid_token", "This reset link is invalid or has expired.") if user.nil? || !requested_account_matches?(user.account)
+
+        # If the password is rejected, the transaction rolls back and the link still works.
+        UserToken.transaction do
+          user.change_password!(reset[:password].to_s)
+          record.destroy!
+        end
+        render json: { message: "Password updated. Sign in with your new password." }
+      end
+    end
+  end
+end
