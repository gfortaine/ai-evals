@@ -0,0 +1,72 @@
+module Api
+  module V1
+    # Groups are the departments the business works in. Staff can browse them. Admins create,
+    # rename and delete them.
+    class GroupsController < ApplicationController
+      include Pagination
+
+      before_action :authenticate_session!
+      before_action :require_active_account!
+      before_action :require_staff!
+      before_action :require_admin!, only: %i[create update destroy]
+      before_action :load_group, only: %i[show update destroy]
+
+      # Two requests can pass the uniqueness check at once. The index still refuses the second.
+      rescue_from ActiveRecord::RecordNotUnique do
+        render_error(422, "validation_failed", "A group with that name already exists.",
+                     details: { name: ["has already been taken"] })
+      end
+
+      # GET /api/v1/groups
+      # Oldest first.
+      def index
+        records, paging = paginate(@account.groups.order(id: :asc))
+        render json: { groups: records.map(&:as_api_json), **paging }
+      end
+
+      # GET /api/v1/groups/:id
+      def show
+        render json: { group: @group.as_api_json }
+      end
+
+      # POST /api/v1/groups
+      # { group: { name: "Billing" } }
+      def create
+        group = @account.groups.create!(name: group_name(require_envelope(:group)))
+        render json: { group: group.as_api_json }, status: :created
+      end
+
+      # PATCH /api/v1/groups/:id
+      # { group: { name: "Accounts" } }
+      def update
+        attrs = require_envelope(:group)
+        unless attrs.key?(:name)
+          return render_error(422, "validation_failed", "Only name can be changed here.",
+                              details: { name: ["is required"] })
+        end
+
+        @group.update!(name: group_name(attrs))
+        render json: { group: @group.as_api_json }
+      end
+
+      # DELETE /api/v1/groups/:id
+      # Its memberships go. Its tickets become ungrouped, and lose their assignee.
+      def destroy
+        @group.remove!
+        render json: { group: @group.as_api_json }
+      end
+
+      private
+
+      def load_group
+        @group = @account.groups.find_by(id: params[:id])
+        render_error(404, "not_found", "No group has that ID.") unless @group
+      end
+
+      # A name that is not text is refused as blank, rather than raising.
+      def group_name(attrs)
+        attrs.permit(:name)[:name].to_s
+      end
+    end
+  end
+end
