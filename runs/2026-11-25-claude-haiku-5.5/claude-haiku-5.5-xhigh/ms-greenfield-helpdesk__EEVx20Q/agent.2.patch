index 0000000..4108070
--- /dev/null
+++ b/app/controllers/api/v1/registrations_controller.rb
@@ -0,0 +1,30 @@
+module Api
+  module V1
+    # Customers sign themselves up for a business's portal. They verify their email, then
+    # use the same sign-in, profile and password flows as everyone else.
+    class RegistrationsController < ApplicationController
+      before_action :load_account_from_header!
+      before_action :require_active_account!
+
+      # POST /api/v1/registrations
+      # { user: { name, email, password } } with X-Helpdesk-Account
+      def create
+        # Only these fields are accepted. Everyone who registers here is a customer.
+        user = @account.users.new(require_envelope(:user).permit(:name, :email, :password).merge(role: User::CUSTOMER))
+
+        token = nil
+        User.transaction do
+          user.save!
+          token = UserToken.issue!(user, :email_verification)
+        end
+        # Send only after commit, so the link never points at a rolled-back user.
+        UserMailer.email_verification(user, token).deliver_later
+
+        render json: { user: user.as_api_json }, status: :created
+      rescue ActiveRecord::RecordNotUnique
+        # Lost a race with another registration for the same email.
+        render_error(422, "validation_failed", "That email is already registered with this business.")
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/requests_controller.rb b/app/controllers/api/v1/requests_controller.rb
new file mode 100644
index 0000000..2d5f704
--- /dev/null
+++ b/app/controllers/api/v1/requests_controller.rb
@@ -0,0 +1,71 @@
+module Api
+  module V1
+    # A customer's own requests. Staff handle the same records through TicketsController.
+    class RequestsController < ApplicationController
+      include Pagination
+
+      before_action :authenticate_session!
+      before_action :require_active_account!
+      before_action :load_own_request, only: %i[show update comments]
+
+      # GET /api/v1/requests
+      def index
+        records, paging = paginate(own_requests.recently_active)
+        render json: { requests: records.map(&:as_api_json), **paging }
+      end
+
+      # POST /api/v1/requests
+      # { request: { subject, comment: { body } } }
+      def create
+        attrs = require_envelope(:request)
+        comment = require_envelope(:comment, attrs).permit(:body)
+
+        request = Request.submit!(
+          requester: @current_user,
+          subject: attrs.permit(:subject)[:subject],
+          body: comment[:body]
+        )
+        render json: { request: request.as_api_json }, status: :created
+      end
+
+      # GET /api/v1/requests/:id
+      def show
+        render json: { request: @request.as_api_json }
+      end
+
+      # PATCH /api/v1/requests/:id
+      # { request: { comment: { body }, status: "solved" } }
+      def update
+        attrs = require_envelope(:request)
+
+        reply = {}
+        if attrs.key?(:comment)
+          reply[:body] = require_envelope(:comment, attrs).permit(:body)[:body].to_s
+        end
+        reply[:status] = attrs.permit(:status)[:status].to_s if attrs.key?(:status)
+
+        @request.requester_reply!(author: @current_user, **reply)
+        render json: { request: @request.as_api_json }
+      end
+
+      # GET /api/v1/requests/:id/comments
+      # Customers see public comments only, oldest first.
+      def comments
+        records, paging = paginate(@request.comments.public_only.includes(:author))
+        render json: { comments: records.map(&:as_api_json), **paging }
+      end
+
+      private
+
+      def own_requests
+        @account.requests.where(requester: @current_user)
+      end
+
+      # Another customer's request is reported as missing, not forbidden, so IDs don't leak.
+      def load_own_request
+        @request = own_requests.find_by(id: params[:id])
+        render_error(404, "not_found", "No request has that ID.") unless @request
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/tickets_controller.rb b/app/controllers/api/v1/tickets_controller.rb
new file mode 100644
index 0000000..5377062
--- /dev/null
+++ b/app/controllers/api/v1/tickets_controller.rb
@@ -0,0 +1,56 @@
+module Api
+  module V1
+    # Staff view of every request in the business, as tickets.
+    class TicketsController < ApplicationController
+      include Pagination
+
+      before_action :authenticate_session!
+      before_action :require_active_account!
+      before_action :require_staff!
+      before_action :load_ticket, only: %i[show update comments]
+
+      # GET /api/v1/tickets
+      def index
+        records, paging = paginate(@account.requests.includes(:requester).recently_active)
+        render json: { tickets: records.map(&:as_ticket_api_json), **paging }
+      end
+
+      # GET /api/v1/tickets/:id
+      def show
+        render json: { ticket: @ticket.as_ticket_api_json }
+      end
+
+      # PATCH /api/v1/tickets/:id
+      # { ticket: { comment: { body, public }, status: "open" | "pending" | "solved" } }
+      def update
+        attrs = require_envelope(:ticket)
+
+        reply = {}
+        if attrs.key?(:comment)
+          comment = require_envelope(:comment, attrs).permit(:body, :public)
+          reply[:body] = comment[:body].to_s
+          # Replies are public unless staff mark them as private notes.
+          reply[:public] = comment[:public] if comment.key?(:public)
+        end
+        reply[:status] = attrs.permit(:status)[:status].to_s if attrs.key?(:status)
+
+        @ticket.staff_reply!(author: @current_user, **reply)
+        render json: { ticket: @ticket.as_ticket_api_json }
+      end
+
+      # GET /api/v1/tickets/:id/comments
+      # Staff see every comment, including private notes, oldest first.
+      def comments
+        records, paging = paginate(@ticket.comments.includes(:author))
+        render json: { comments: records.map(&:as_api_json), **paging }
+      end
+
+      private
+
+      def load_ticket
+        @ticket = @account.requests.includes(:requester).find_by(id: params[:id])
+        render_error(404, "not_found", "No ticket has that ID.") unless @ticket
+      end
+    end
+  end
+end
