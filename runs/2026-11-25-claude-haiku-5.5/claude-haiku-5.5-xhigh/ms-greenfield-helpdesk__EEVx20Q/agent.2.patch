index 0000000..02d8d82
--- /dev/null
+++ b/db/migrate/20261123050001_create_requests.rb
@@ -0,0 +1,19 @@
+class CreateRequests < ActiveRecord::Migration[8.1]
+  def change
+    create_table :requests do |t|
+      # Deleting an account or a requester removes their requests at the database level too.
+      t.references :account, null: false, foreign_key: { on_delete: :cascade }, index: false
+      t.references :requester, null: false, foreign_key: { to_table: :users, on_delete: :cascade }, index: false
+      t.string :subject, null: false
+      t.string :status, null: false, default: "open"
+
+      t.timestamps
+    end
+
+    # Lists are ordered by recent activity, per business and per requester.
+    add_index :requests, [:account_id, :updated_at]
+    add_index :requests, [:requester_id, :updated_at]
+
+    add_check_constraint :requests, "status IN ('open', 'pending', 'solved')", name: "requests_status_known"
+  end
+end
