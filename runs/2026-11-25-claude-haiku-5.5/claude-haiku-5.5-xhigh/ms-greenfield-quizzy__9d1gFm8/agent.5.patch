   end
 end
+
+# The time per question: "Timer minutes" and "Timer seconds", 0 and 0 for no timer.
+class QuizTimerTest < ActiveSupport::TestCase
+  test "a quiz has no timer by default: 0 minutes and 0 seconds" do
+    quiz = Quiz.create!(title: "Talk")
+    assert_equal [ 0, 0 ], [ quiz.timer_minutes, quiz.timer_seconds ]
+    assert_equal 0, quiz.time_limit_seconds
+  end
+
+  test "the time per question in seconds is minutes times 60 plus seconds" do
+    quiz = Quiz.new(title: "Talk", timer_minutes: 1, timer_seconds: 30)
+    assert_equal 90, quiz.time_limit_seconds
+    quiz.timer_minutes = 0
+    quiz.timer_seconds = 5
+    assert_equal 5, quiz.time_limit_seconds
+  end
+
+  test "minutes are whole numbers from 0 to 99, seconds from 0 to 59" do
+    quiz = Quiz.new(title: "Talk")
+    [ [ 0, 0 ], [ 99, 59 ], [ 1, 30 ] ].each do |minutes, seconds|
+      quiz.timer_minutes = minutes
+      quiz.timer_seconds = seconds
+      assert quiz.valid?, "#{minutes}:#{seconds} should be allowed"
+    end
+
+    [ [ -1, 0 ], [ 100, 0 ], [ 1.5, 0 ], [ nil, 0 ] ].each do |minutes, seconds|
+      quiz.timer_minutes = minutes
+      quiz.timer_seconds = seconds
+      assert_not quiz.valid?, "minutes #{minutes.inspect} should be refused"
+      assert_predicate quiz.errors[:timer_minutes], :any?
+    end
+
+    [ [ 0, -1 ], [ 0, 60 ], [ 0, 2.5 ], [ 0, nil ] ].each do |minutes, seconds|
+      quiz.timer_minutes = minutes
+      quiz.timer_seconds = seconds
+      assert_not quiz.valid?, "seconds #{seconds.inspect} should be refused"
+      assert_predicate quiz.errors[:timer_seconds], :any?
+    end
+  end
+
+  test "the errors name the fields the way the form labels them" do
+    quiz = Quiz.new(title: "Talk", timer_seconds: 75)
+    quiz.valid?
+    assert_equal [ "Timer seconds must be less than or equal to 59" ], quiz.errors.full_messages
+  end
+end
diff --git a/test/system/timer_test.rb b/test/system/timer_test.rb
new file mode 100644
index 0000000..1bbf640
--- /dev/null
+++ b/test/system/timer_test.rb
@@ -0,0 +1,70 @@
+require "application_system_test_case"
+
+# The timer in real browsers: the big screen counts the question down, the question
+# closes by itself at 0:00 (nobody clicks Finish), and the phones show the result
+# without ever showing a clock.
+class TimerSystemTest < ApplicationSystemTestCase
+  include GameFixtures
+
+  setup do
+    @quiz = build_quiz_with_questions
+  end
+
+  def join_as(name)
+    visit "/play/#{Game.last.code}"
+    fill_in "Your name", with: name
+    click_button "Join"
+    assert_text "Hi, #{name}!"
+  end
+
+  def start_game_with_timer(seconds)
+    @quiz.update!(timer_minutes: 0, timer_seconds: seconds)
+    visit "/moderate/quizzes/#{@quiz.id}"
+    click_button "Start a game"
+    assert_text "Players: 0"
+    using_session(:alice) { join_as("Alice") }
+    using_session(:bob) { join_as("Bob") }
+    assert_text "Players: 2"
+    click_button "Start"
+    assert_text "Question 1 of 3"
+  end
+
+  test "the big screen counts down, and the question closes by itself at 0:00" do
+    start_game_with_timer(8)
+
+    assert_selector ".countdown[role='timer']", text: /\A0:0\d\z/
+    # The browser counts it down by itself: the shown time changes without a reload.
+    shown = find(".countdown").text
+    assert_no_selector ".countdown", text: shown, wait: 3
+    assert_button "Finish"
+
+
+    using_session(:alice) { click_button "429" }
+    assert_text "Answers: 1 / 2"
+
+    # Nobody clicks Finish: the timer closes the question.
+    assert_button "Next", wait: 14
+    assert_no_selector ".countdown"
+    assert_no_button "Finish"
+    assert_selector ".stage-option.is-correct .stage-option__count", text: "1 answer"
+
+    using_session(:alice) do
+      assert_selector "[role=status]", text: "Correct!", wait: 10
+    end
+    using_session(:bob) do
+      assert_selector "[role=status]", text: "No answer", wait: 10
+      assert_no_selector ".countdown"
+      assert_no_text(/\d:\d\d/)
+    end
+  end
+
+  test "a reload does not restart the countdown" do
+    start_game_with_timer(10)
+    assert_selector ".countdown", text: /\A0:(09|10)\z/
+    sleep 2.5
+
+    visit current_path
+    assert_selector ".countdown", text: /\A0:0[0-7]\z/
+    assert_button "Finish"
+  end
+end
