diff --git a/app/javascript/controllers/countdown_controller.js b/app/javascript/controllers/countdown_controller.js
new file mode 100644
index 0000000..2df71b4
--- /dev/null
+++ b/app/javascript/controllers/countdown_controller.js
@@ -0,0 +1,46 @@
+import { Controller } from "@hotwired/stimulus"
+
+// The big screen's countdown for the open question, shown as M:SS.
+//
+// The deadline is an absolute time (epoch milliseconds, from the server), so a
+// re-rendered region or a reload shows the same time, and nothing restarts the clock.
+//
+// The server is the one that finishes a question when its time is up (see
+// Game#finish_if_time_up!). When the countdown reaches 0:00, it asks the live region
+// for its view again, so the screen follows at once instead of at the next poll. It
+// asks at most once a second, and only a few times: after that the regular poll takes over.
+export default class extends Controller {
+  static targets = [ "time" ]
+  static values = { deadline: Number }
+
+  connect() {
+    this.asks = 0
+    this.lastAsk = 0
+    this.render()
+    this.timer = setInterval(() => this.render(), 200)
+  }
+
+  disconnect() {
+    clearInterval(this.timer)
+  }
+
+  render() {
+    const seconds = Math.max(0, Math.ceil((this.deadlineValue - Date.now()) / 1000))
+    this.timeTarget.textContent = clock(seconds)
+    if (seconds === 0) this.askForView()
+  }
+
+  askForView() {
+    const now = Date.now()
+    if (this.asks >= 5 || now - this.lastAsk < 1000) return
+
+    this.asks += 1
+    this.lastAsk = now
+    document.dispatchEvent(new CustomEvent("quizzy:tick"))
+  }
+}
+
+// 90 -> "1:30", 5 -> "0:05". Same format as the server's countdown_text helper.
+function clock(seconds) {
+  return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`
+}
