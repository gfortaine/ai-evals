+# The time per question. The quiz keeps what the moderator typed (minutes and
+# seconds; 0 and 0 means no timer). When a question opens, the quiz's time is read
+# and stored with that question (game_questions.time_limit_seconds), so the clock of
+# an open question never changes, and a change in the settings applies to the
+# questions that open after it.
+class AddTimer < ActiveRecord::Migration[8.1]
+  def change
+    add_column :quizzes, :timer_minutes, :integer, null: false, default: 0
+    add_column :quizzes, :timer_seconds, :integer, null: false, default: 0
+    add_column :game_questions, :time_limit_seconds, :integer, null: false, default: 0
+  end
+end
