+require "test_helper"
+
+# The prizes as the moderator and the players see them: the quiz setting, the
+# leaderboard after the end, the winner buttons, and the phones.
+class PrizesTest < ActionDispatch::IntegrationTest
+  include GameFixtures
+
+  setup do
+    @auth = moderator_headers
+    @quiz = build_quiz_with_questions # three active questions
+    @game = Game.create_from_quiz!(@quiz)
+    # Each player joins from their own phone (own cookies). Bob joins first.
+    @bob_phone = join_phone("Bob")
+    @alice_phone = join_phone("Alice")
+    @carol_phone = join_phone("Carol")
+    @bob, @alice, @carol = %w[Bob Alice Carol].map { |name| @game.players.find_by!(name: name) }
+  end
+
+  def join_phone(name)
+    phone = open_session
+    phone.post "/play/#{@game.code}/join", params: { player: { name: name } }
+    phone
+  end
+
+  def correct_option(position)
+    @game.game_questions.find_by!(position: position).options.find_by!(correct: true)
+  end
+
+  def wrong_option(position)
+    @game.game_questions.find_by!(position: position).options.find_by!(correct: false)
+  end
+
+  # Alice answers all three right, Bob one, Carol none.
+  def play_out
+    @game.start!
+    @game.answer!(@alice, correct_option(1))
+    @game.answer!(@bob, correct_option(1))
+    @game.answer!(@carol, wrong_option(1))
+    @game.finish!
+    @game.next_question!
+    @game.answer!(@alice, correct_option(2))
+    @game.answer!(@carol, wrong_option(2))
+    @game.finish!
+    @game.next_question!
+    @game.answer!(@alice, correct_option(3))
+    @game.answer!(@bob, wrong_option(3))
+    @game.finish!
+    @game.end_quiz!
+    @game.reload
+  end
+
+  def leaderboard_names
+    css_select("li.leader .leader__name").map { |node| node.text.strip }
+  end
+
+  test "the quiz settings have a number of winners, 3 by default" do
+    get "/moderate/quizzes/new", headers: @auth
+    assert_select "label[for=quiz_winners_count]", text: "Number of winners"
+    assert_select "input#quiz_winners_count[type=number][min='1'][max='1000'][value='3']"
+  end
+
+  test "the number of winners is saved from the settings page" do
+    patch "/moderate/quizzes/#{@quiz.id}", params: { quiz: { title: @quiz.title, winners_count: "2" } }, headers: @auth
+    assert_redirected_to "/moderate/quizzes/#{@quiz.id}"
+    assert_equal 2, @quiz.reload.winners_count
+  end
+
+  test "the settings refuse a number below 1, or no number, with a message" do
+    patch "/moderate/quizzes/#{@quiz.id}", params: { quiz: { title: @quiz.title, winners_count: "0" } }, headers: @auth
+    assert_response :unprocessable_entity
+    assert_select "[role=alert] li", text: "Number of winners must be greater than or equal to 1"
+
+    patch "/moderate/quizzes/#{@quiz.id}", params: { quiz: { title: @quiz.title, winners_count: "" } }, headers: @auth
+    assert_response :unprocessable_entity
+    assert_select "[role=alert] li", text: "Number of winners is not a number"
+
+    assert_equal 3, @quiz.reload.winners_count
+  end
+
+  test "a new quiz gets 3 winners by default, and a blank number is refused" do
+    post "/moderate/quizzes", params: { quiz: { title: "Talk", winners_count: "" } }, headers: @auth
+    assert_response :unprocessable_entity
+
+    post "/moderate/quizzes", params: { quiz: { title: "Talk" } }, headers: @auth
+    assert_equal 3, Quiz.find_by!(title: "Talk").winners_count
+  end
+
+  test "during the game the big screen shows no places, points or winners" do
+    @game.start!
+    get "/moderate/games/#{@game.id}", headers: @auth
+    assert_select "li.leader", count: 0
+    assert_no_match(/\b\d+ points?\b/, response.body)
+    assert_no_match(/Winner/, response.body)
+    assert_select "button", count: 0, text: /Top \d|Draw|Reset winners/
+  end
+
+  test "after End quiz the big screen lists the players in order, with place, name and points" do
+    play_out
+    get "/moderate/games/#{@game.id}", headers: @auth
+    assert_select "h1.screen__ended", text: "The quiz is over"
+    assert_select "ol.leaderboard > li.leader", count: 3
+    assert_equal %w[Alice Bob Carol], leaderboard_names
+    assert_equal [ "1", "2", "3" ], css_select("li.leader .leader__place").map { |node| node.text.strip }
+    assert_select "li.leader:nth-child(1) .leader__score", text: "3 points"
+    assert_select "li.leader:nth-child(2) .leader__score", text: "1 point"
+    assert_select "li.leader:nth-child(3) .leader__score", text: "0 points"
+  end
+
+  test "the leaderboard marks no winner before the winners are picked" do
+    play_out
+    get "/moderate/games/#{@game.id}", headers: @auth
+    assert_select "li.leader .leader__badge", count: 0
+    assert_no_match(/Winner/, response.body)
+  end
+
+  test "after the end the big screen has Top N, Draw and Reset winners, and no game buttons" do
+    play_out
+    get "/moderate/games/#{@game.id}", headers: @auth
+    assert_select "button", text: "Top 3"
+    assert_select "button", text: "Draw"
+    assert_select "button", text: "Reset winners"
+    assert_select "button", count: 0, text: /Start|Finish|Next|End quiz/
+  end
+
+  test "Top N marks the first N places as winners, and the leaderboard shows the mark" do
+    play_out
+    @quiz.update!(winners_count: 2)
+    post "/moderate/games/#{@game.id}/top_winners", headers: @auth
+    assert_redirected_to "/moderate/games/#{@game.id}"
+
+    get "/moderate/games/#{@game.id}", headers: @auth
+    assert_select "li.leader.is-winner", count: 2
+    assert_select "li.leader .leader__badge", text: "Winner", count: 2
+    assert_select "li.leader:nth-child(3) .leader__badge", count: 0
+    assert_equal %w[Alice Bob], @game.players.where(winner: true).reorder(:place).map(&:name)
+  end
+
+  test "Top N never gives a prize to a player with no points" do
+    play_out
+    @quiz.update!(winners_count: 3)
+    post "/moderate/games/#{@game.id}/top_winners", headers: @auth
+    assert_not @carol.reload.winner?
+    assert_equal 2, @game.players.where(winner: true).count
+  end
+
+  test "Draw picks the winners, and no player without points" do
+    play_out
+    @quiz.update!(winners_count: 1)
+    post "/moderate/games/#{@game.id}/draw_winners", headers: @auth
+    assert_redirected_to "/moderate/games/#{@game.id}"
+    assert_equal [ "Alice" ], @game.players.where(winner: true).map(&:name)
+    assert_not @carol.reload.winner?
+  end
+
+  test "Reset winners removes the winners" do
+    play_out
+    post "/moderate/games/#{@game.id}/top_winners", headers: @auth
+    assert_equal 2, @game.players.where(winner: true).count
+
+    post "/moderate/games/#{@game.id}/reset_winners", headers: @auth
+    assert_equal 0, @game.players.where(winner: true).count
+    get "/moderate/games/#{@game.id}", headers: @auth
+    assert_select "li.leader .leader__badge", count: 0
+  end
+
+  test "winners cannot be picked before the end, and the moderator is told so" do
+    @game.start!
+    post "/moderate/games/#{@game.id}/top_winners", headers: @auth
+    get response.location, headers: @auth
+    assert_select "[role=status]", text: /picked after the quiz is over/
+    assert_equal 0, @game.players.where(winner: true).count
+  end
+
+  test "a draw with nobody on points says so" do
+    @game.start!
+    @game.finish!
+    @game.end_quiz!
+    post "/moderate/games/#{@game.id}/draw_winners", headers: @auth
+    get response.location, headers: @auth
+    assert_select "[role=status]", text: /nobody wins/
+  end
+
+  test "the winner buttons ask for the moderator's login" do
+    play_out
+    post "/moderate/games/#{@game.id}/top_winners"
+    assert_response :unauthorized
+    post "/moderate/games/#{@game.id}/draw_winners"
+    assert_response :unauthorized
+    post "/moderate/games/#{@game.id}/reset_winners"
+    assert_response :unauthorized
+  end
+
+  test "the big screen's live fragment changes when the winners change" do
+    play_out
+    get "/moderate/games/#{@game.id}/live", headers: @auth
+    etag = response.headers["ETag"]
+    get "/moderate/games/#{@game.id}/live", headers: @auth.merge("HTTP_IF_NONE_MATCH" => etag)
+    assert_response :not_modified
+
+    post "/moderate/games/#{@game.id}/top_winners", headers: @auth
+    get "/moderate/games/#{@game.id}/live", headers: @auth.merge("HTTP_IF_NONE_MATCH" => etag)
+    assert_response :success
+    assert_select "li.leader .leader__badge", text: "Winner", count: 2
+  end
+
+  test "a phone shows its place and points only after the end" do
+    @game.start!
+    @bob_phone.get "/play/#{@game.code}"
+    assert_no_match(/Place \d of \d/, @bob_phone.response.body)
+    assert_no_match(/\b\d+ points?\b/, @bob_phone.response.body)
+
+    @game.answer!(@bob, correct_option(1))
+    @game.finish!
+    @game.end_quiz!
+    @bob_phone.get "/play/#{@game.code}"
+    @bob_phone.assert_select "p.result-card__label", text: "Place 1 of 3"
+    @bob_phone.assert_select "p.result-card__score", text: "1 point"
+    @bob_phone.assert_select "h1", text: "The quiz is over"
+  end
+
+  test "a phone shows its place and points after the end, to the first player" do
+    play_out
+    @alice_phone.get "/play/#{@game.code}"
+    @alice_phone.assert_select "p.result-card__label", text: "Place 1 of 3"
+    @alice_phone.assert_select "p.result-card__score", text: "3 points"
+  end
+
+  test "a winner's phone says You won!, and the others do not" do
+    play_out
+    post "/moderate/games/#{@game.id}/top_winners", headers: @auth
+
+    @alice_phone.get "/play/#{@game.code}"
+    @alice_phone.assert_select ".winner-banner", text: "You won!"
+
+    @carol_phone.get "/play/#{@game.code}"
+    @carol_phone.assert_select ".winner-banner", count: 0
+    assert_no_match(/You won!/, @carol_phone.response.body)
+  end
+
+  test "the phone's live fragment changes when the winners change" do
+    play_out
+    @alice_phone.get "/play/#{@game.code}/state"
+    etag = @alice_phone.response.headers["ETag"]
+    @alice_phone.get "/play/#{@game.code}/state", headers: { "HTTP_IF_NONE_MATCH" => etag }
+    assert_equal 304, @alice_phone.response.status
+
+    post "/moderate/games/#{@game.id}/top_winners", headers: @auth
+    @alice_phone.get "/play/#{@game.code}/state", headers: { "HTTP_IF_NONE_MATCH" => etag }
+    assert_equal 200, @alice_phone.response.status
+    @alice_phone.assert_select ".winner-banner", text: "You won!"
+  end
+
+  test "a player who never joined sees the quiz is over, without places or points" do
+    play_out
+    stranger = open_session
+    stranger.get "/play/#{@game.code}"
+    stranger.assert_select "h1", text: "The quiz is over"
+    assert_no_match(/Place \d of \d/, stranger.response.body)
+    assert_no_match(/\b\d+ points?\b/, stranger.response.body)
+  end
+end
diff --git a/test/models/game_prizes_test.rb b/test/models/game_prizes_test.rb
new file mode 100644
index 0000000..afc4915
--- /dev/null
+++ b/test/models/game_prizes_test.rb
@@ -0,0 +1,182 @@
+require "test_helper"
+
+# Results and prizes of a game, against the database. Time is travelled, so the
+# speed of each answer is exact.
+class GamePrizesTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+
+  BASE = Time.zone.local(2026, 11, 25, 10, 0, 0)
+
+  setup do
+    @quiz = Quiz.create!(title: "Prizes", winners_count: 2)
+    add_question("First question")
+    add_question("Second question")
+    @game = Game.create_from_quiz!(@quiz)
+    # Bob joins first, so join order cannot explain a tie that speed should decide.
+    travel_to BASE - 60
+    @bob = @game.join("Bob")
+    @alice = @game.join("Alice")
+    @carol = @game.join("Carol")
+  end
+
+  # Alice and Bob both answer both questions correctly: Alice in 3 s in total,
+  # Bob in 7 s. Carol answers wrongly and has no points.
+  def play_out
+    travel_to BASE
+    @game.start!
+    travel_to BASE + 1
+    @game.answer!(@carol, option(1, "No"))
+    travel_to BASE + 2
+    @game.answer!(@alice, option(1, "Yes"))
+    travel_to BASE + 5
+    @game.answer!(@bob, option(1, "Yes"))
+    travel_to BASE + 6
+    @game.finish!
+    travel_to BASE + 10
+    @game.next_question!
+    travel_to BASE + 11
+    @game.answer!(@alice, option(2, "Yes"))
+    travel_to BASE + 12
+    @game.answer!(@bob, option(2, "Yes"))
+    travel_to BASE + 13
+    @game.answer!(@carol, option(2, "No"))
+    travel_to BASE + 15
+    @game.finish!
+    travel_to BASE + 16
+    @game.end_quiz!
+    @game.reload
+  end
+
+  def add_question(text)
+    question = @quiz.questions.new(text: text)
+    question.option_rows = [ { text: "Yes", correct: true }, { text: "No", correct: false } ]
+    question.save!
+  end
+
+  def option(position, text)
+    @game.game_questions.find_by!(position: position).options.find_by!(text: text)
+  end
+
+  def winner_names
+    @game.players.where(winner: true).reorder(:place).map(&:name)
+  end
+
+  test "the answer records the time of its last pick, also when the option stays the same" do
+    travel_to BASE
+    @game.start!
+    travel_to BASE + 2
+    @game.answer!(@alice, option(1, "Yes"))
+    travel_to BASE + 7
+    @game.answer!(@alice, option(1, "Yes"))
+    assert_equal BASE + 7, @alice.answers.sole.picked_at
+  end
+
+  test "the speed counts to the last pick: a changed answer is timed by its last pick" do
+    travel_to BASE
+    @game.start!
+    travel_to BASE + 1
+    @game.answer!(@alice, option(1, "Yes"))
+    travel_to BASE + 4
+    @game.answer!(@alice, option(1, "No"))
+    travel_to BASE + 6
+    @game.answer!(@alice, option(1, "Yes"))
+    travel_to BASE + 8
+    @game.finish!
+    travel_to BASE + 9
+    @game.end_quiz!
+    alice = @game.players.find(@alice.id)
+    assert_equal 1, alice.points
+    assert_equal 6_000_000, alice.speed_micros
+  end
+
+  test "ending the quiz stores each player's points, speed and place" do
+    play_out
+
+    assert @game.ended?
+    alice, bob, carol = [ @alice, @bob, @carol ].map { |player| @game.players.find(player.id) }
+    assert_equal [ 2, 2, 0 ], [ alice.points, bob.points, carol.points ]
+    assert_equal [ 3_000_000, 7_000_000, 0 ], [ alice.speed_micros, bob.speed_micros, carol.speed_micros ]
+    assert_equal [ 1, 2, 3 ], [ alice.place, bob.place, carol.place ]
+    assert_equal [ @alice.id, @bob.id, @carol.id ], @game.ranked_players.map(&:id)
+  end
+
+  test "joining first does not win a tie: the faster player ranks higher" do
+    play_out
+    assert_equal %w[Alice Bob Carol], @game.ranked_players.map(&:name)
+  end
+
+  test "answers are refused after the end, so the stored result stays" do
+    play_out
+    assert_not @game.answer!(@carol, option(2, "Yes"))
+    assert_equal 0, @carol.answers.count { |answer| answer.game_option.correct? }
+    assert_equal 0, @game.players.find(@carol.id).points
+  end
+
+  test "Top N makes the first N places the winners" do
+    play_out
+    winners = @game.pick_top_winners!
+    assert_equal %w[Alice Bob], winners.map(&:name)
+    assert_equal %w[Alice Bob], winner_names
+  end
+
+  test "Top N never gives a prize to a player without points" do
+    play_out
+    @quiz.update!(winners_count: 3)
+    assert_equal %w[Alice Bob], @game.pick_top_winners!.map(&:name)
+    assert_not @game.players.find(@carol.id).winner?
+  end
+
+  test "Draw gives a tied place to one of the tied players, and draws again on each click" do
+    play_out
+    @quiz.update!(winners_count: 1)
+    seen = Set.new
+    30.times do
+      winners = @game.draw_winners!
+      assert_equal 1, winners.size
+      seen << winners.first.name
+      assert_equal 1, winner_names.size
+    end
+    assert_equal Set["Alice", "Bob"], seen
+  end
+
+  test "Draw with more prizes than tied players gives all the scorers their prize" do
+    play_out
+    assert_equal %w[Alice Bob], @game.draw_winners!.map(&:name).sort
+  end
+
+  test "Reset winners removes the winners" do
+    play_out
+    @game.pick_top_winners!
+    assert_equal %w[Alice Bob], winner_names
+    assert_equal [], @game.reset_winners!
+    assert_equal [], winner_names
+  end
+
+  test "picking winners is refused until the quiz is over, and changes nothing" do
+    travel_to BASE
+    @game.start!
+    assert_nil @game.pick_top_winners!
+    assert_nil @game.draw_winners!
+    assert_nil @game.reset_winners!
+    assert_equal [], winner_names
+  end
+
+  test "each winner action changes the revision and the progress, and ticks both streams" do
+    play_out
+    revision = @game.revision
+    progress = @game.progress
+    assert_broadcasts(@game.live_stream_name, 1) do
+      assert_broadcasts(@game.play_stream_name, 1) { @game.pick_top_winners! }
+    end
+    @game.reload
+    assert_equal revision + 1, @game.revision
+    assert_equal progress + 1, @game.progress
+  end
+
+  test "the winners count is read from the quiz as it is now" do
+    play_out
+    assert_equal 2, @game.winners_count
+    @quiz.update!(winners_count: 5)
+    assert_equal 5, @game.winners_count
+  end
+end
diff --git a/test/models/leaderboard_test.rb b/test/models/leaderboard_test.rb
new file mode 100644
index 0000000..527b165
--- /dev/null
+++ b/test/models/leaderboard_test.rb
@@ -0,0 +1,157 @@
+require "test_helper"
+
+# The ranking and the winner rules, without the database.
+class LeaderboardTest < ActiveSupport::TestCase
+  Option = Struct.new(:correct, keyword_init: true) do
+    def correct? = correct
+  end
+  Question = Struct.new(:opened_at, keyword_init: true)
+  Pick = Struct.new(:game_option, :game_question, :picked_at, :updated_at, keyword_init: true)
+  Player = Struct.new(:id, :answers, keyword_init: true)
+  Entry = Struct.new(:id, :points, :place, keyword_init: true)
+
+  OPENED = Time.utc(2026, 11, 25, 10, 0, 0)
+
+  # One answer: correct or not, picked `seconds` after the question opened.
+  def pick(correct:, seconds:, opened: OPENED)
+    question = Question.new(opened_at: opened)
+    Pick.new(game_option: Option.new(correct: correct), game_question: question,
+             picked_at: opened + seconds, updated_at: opened + seconds)
+  end
+
+  def player(id, *picks)
+    Player.new(id: id, answers: picks)
+  end
+
+  def ranked_ids(players)
+    Leaderboard.rank(players).map { |standing| standing.player.id }
+  end
+
+  test "more points rank higher" do
+    standings = Leaderboard.rank([
+      player(1, pick(correct: true, seconds: 1)),
+      player(2, pick(correct: true, seconds: 1), pick(correct: true, seconds: 2)),
+      player(3)
+    ])
+    assert_equal [ 2, 1, 3 ], standings.map { |s| s.player.id }
+    assert_equal [ 2, 1, 0 ], standings.map(&:points)
+    assert_equal [ 1, 2, 3 ], standings.map(&:place)
+  end
+
+  test "equal points are ranked by the total time of the correct answers" do
+    slow = player(1, pick(correct: true, seconds: 5))
+    fast = player(2, pick(correct: true, seconds: 2))
+    assert_equal [ 2, 1 ], ranked_ids([ slow, fast ])
+    standings = Leaderboard.rank([ slow, fast ])
+    assert_equal 2_000_000, standings.first.speed_micros
+    assert_equal 5_000_000, standings.last.speed_micros
+  end
+
+  test "only correct answers count towards the speed" do
+    # 1 correct answer at 4 s; a wrong answer at 1 s must not make her faster.
+    wrong_fast = player(1, pick(correct: true, seconds: 4), pick(correct: false, seconds: 1, opened: OPENED + 10))
+    right_later = player(2, pick(correct: true, seconds: 3))
+    assert_equal [ 2, 1 ], ranked_ids([ wrong_fast, right_later ])
+  end
+
+  test "the time of an answer runs to the last pick, which is stored in picked_at" do
+    question = Question.new(opened_at: OPENED)
+    option = Option.new(correct: true)
+    # Picked at 1 s, then again at 6 s with the same option: updated_at did not move.
+    last_pick = Pick.new(game_option: option, game_question: question,
+                         picked_at: OPENED + 6, updated_at: OPENED + 1)
+    other = player(2, pick(correct: true, seconds: 3))
+    assert_equal [ 2, 1 ], ranked_ids([ player(1, last_pick), other ])
+    assert_equal 6_000_000, Leaderboard.rank([ player(1, last_pick) ]).first.speed_micros
+  end
+
+  test "the answer time is in whole microseconds" do
+    answer = pick(correct: true, seconds: 1.5)
+    assert_equal 1_500_000, Leaderboard.answer_micros(answer)
+  end
+
+  test "still tied, the player who joined first ranks first" do
+    a = player(7, pick(correct: true, seconds: 2))
+    b = player(3, pick(correct: true, seconds: 2))
+    assert_equal [ 3, 7 ], ranked_ids([ a, b ])
+  end
+
+  test "players without points come last, in order of joining" do
+    ranked = Leaderboard.rank([ player(5), player(2), player(9, pick(correct: false, seconds: 1)) ])
+    assert_equal [ 2, 5, 9 ], ranked.map { |s| s.player.id }
+    assert_equal [ 0, 0, 0 ], ranked.map(&:points)
+  end
+
+  test "top N is the first N places" do
+    ranked = [ Entry.new(id: 1, points: 5, place: 1), Entry.new(id: 2, points: 4, place: 2),
+               Entry.new(id: 3, points: 1, place: 3) ]
+    assert_equal [ 1, 2 ], Leaderboard.top(ranked, 2).map(&:id)
+  end
+
+  test "top N never gives a prize to a player without points" do
+    ranked = [ Entry.new(id: 1, points: 2, place: 1), Entry.new(id: 2, points: 0, place: 2),
+               Entry.new(id: 3, points: 0, place: 3) ]
+    assert_equal [ 1 ], Leaderboard.top(ranked, 3).map(&:id)
+    assert_equal [], Leaderboard.top([ Entry.new(id: 1, points: 0, place: 1) ], 3)
+  end
+
+  test "a draw gives every player above the N-th place a prize, and the rest at random among the tied" do
+    ranked = [ Entry.new(id: 1, points: 5, place: 1), Entry.new(id: 2, points: 4, place: 2),
+               Entry.new(id: 3, points: 3, place: 3), Entry.new(id: 4, points: 3, place: 4),
+               Entry.new(id: 5, points: 3, place: 5), Entry.new(id: 6, points: 2, place: 6) ]
+    seen = Set.new
+    200.times do |seed|
+      winners = Leaderboard.draw(ranked, 3, random: Random.new(seed)).map(&:id)
+      assert_equal 3, winners.size
+      assert_includes winners, 1
+      assert_includes winners, 2
+      seen << (winners - [ 1, 2 ]).first
+    end
+    assert_equal Set[3, 4, 5], seen, "every tied player can be drawn, and only they"
+  end
+
+  test "a draw ignores speed for the tied places: the slowest can win" do
+    # Same points: place order is speed order, but the draw does not use it.
+    ranked = [ Entry.new(id: 1, points: 3, place: 1), Entry.new(id: 2, points: 3, place: 2),
+               Entry.new(id: 3, points: 3, place: 3) ]
+    winners = (0..200).map { |seed| Leaderboard.draw(ranked, 1, random: Random.new(seed)).first.id }
+    assert_equal Set[1, 2, 3], winners.to_set
+  end
+
+  test "the N-th place decides the tie by its points, not by its position among ties" do
+    ranked = [ Entry.new(id: 1, points: 4, place: 1), Entry.new(id: 2, points: 3, place: 2),
+               Entry.new(id: 3, points: 3, place: 3), Entry.new(id: 4, points: 2, place: 4) ]
+    100.times do |seed|
+      winners = Leaderboard.draw(ranked, 2, random: Random.new(seed)).map(&:id)
+      assert_includes winners, 1
+      assert_equal 2, winners.size
+      assert_includes [ 2, 3 ], (winners - [ 1 ]).first
+    end
+  end
+
+  test "a draw with no tie gives exactly the top N" do
+    ranked = [ Entry.new(id: 1, points: 5, place: 1), Entry.new(id: 2, points: 4, place: 2),
+               Entry.new(id: 3, points: 1, place: 3) ]
+    assert_equal [ 1, 2 ], Leaderboard.draw(ranked, 2, random: Random.new(1)).map(&:id)
+  end
+
+  test "fewer players with points than N: all of them win, and nobody else" do
+    ranked = [ Entry.new(id: 1, points: 2, place: 1), Entry.new(id: 2, points: 1, place: 2),
+               Entry.new(id: 3, points: 0, place: 3) ]
+    assert_equal [ 1, 2 ], Leaderboard.draw(ranked, 3, random: Random.new(1)).map(&:id)
+    assert_equal [ 1, 2 ], Leaderboard.top(ranked, 3).map(&:id)
+  end
+
+  test "nobody has points: nobody wins a draw" do
+    ranked = [ Entry.new(id: 1, points: 0, place: 1), Entry.new(id: 2, points: 0, place: 2) ]
+    assert_equal [], Leaderboard.draw(ranked, 1, random: Random.new(1))
+    assert_equal [], Leaderboard.top(ranked, 1)
+  end
+
+  test "the draw draws again on each call" do
+    ranked = [ Entry.new(id: 1, points: 1, place: 1), Entry.new(id: 2, points: 1, place: 2),
+               Entry.new(id: 3, points: 1, place: 3), Entry.new(id: 4, points: 1, place: 4) ]
+    results = (0..40).map { Leaderboard.draw(ranked, 1).first.id }
+    assert_operator results.uniq.size, :>, 1
+  end
+end
diff --git a/test/models/quiz_test.rb b/test/models/quiz_test.rb
new file mode 100644
index 0000000..452e0d6
--- /dev/null
+++ b/test/models/quiz_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class QuizTest < ActiveSupport::TestCase
+  test "a quiz has 3 winners by default" do
+    assert_equal 3, Quiz.new(title: "Talk").winners_count
+  end
+
+  test "the number of winners is a whole number from 1 to 1000" do
+    quiz = Quiz.new(title: "Talk")
+    [ 1, 2, 1000 ].each do |count|
+      quiz.winners_count = count
+      assert quiz.valid?, "#{count} should be allowed"
+    end
+    [ 0, -1, 1001, 99_999_999_999, 2.5, nil ].each do |count|
+      quiz.winners_count = count
+      assert_not quiz.valid?, "#{count.inspect} should be refused"
+      assert_predicate quiz.errors[:winners_count], :any?
+    end
+  end
+
+  test "the error names the field the way the form labels it" do
+    quiz = Quiz.new(title: "Talk", winners_count: 0)
+    quiz.valid?
+    assert_equal [ "Number of winners must be greater than or equal to 1" ], quiz.errors.full_messages
+  end
+end
diff --git a/test/system/prizes_test.rb b/test/system/prizes_test.rb
new file mode 100644
index 0000000..f8357a3
--- /dev/null
+++ b/test/system/prizes_test.rb
@@ -0,0 +1,86 @@
+require "application_system_test_case"
+
+# The prizes in real browsers: a whole game with three phones, the speed tie-break
+# with real time, and the winners shown live on the screen and on the phones.
+class PrizesSystemTest < ApplicationSystemTestCase
+  include GameFixtures
+
+  setup do
+    @quiz = build_quiz_with_questions
+  end
+
+  test "a game ends with a leaderboard, and the winners appear live on the screen and the phones" do
+    visit "/moderate/quizzes/#{@quiz.id}"
+    click_button "Start a game"
+    assert_text "Players: 0"
+
+    # Bob joins first, but answers slowest: on equal points, speed decides.
+    using_session(:bob) { join_as("Bob") }
+    using_session(:alice) { join_as("Alice") }
+    using_session(:carol) { join_as("Carol") }
+    assert_text "Players: 3"
+
+    click_button "Start"
+    assert_text "Question 1 of 3"
+    using_session(:alice) { click_button "429" }
+    using_session(:bob) do
+      sleep 1.5
+      click_button "429"
+    end
+    using_session(:carol) { click_button "418" }
+    click_button "Finish"
+    click_button "Next"
+
+    using_session(:alice) { click_button "WebSocket" }
+    using_session(:bob) { click_button "WebSocket" }
+    using_session(:carol) { click_button "SMTP" }
+    click_button "Finish"
+    click_button "Next"
+
+    using_session(:alice) { click_button "Cascading Style Sheets" }
+    using_session(:bob) { click_button "Cascading Style Sheets" }
+    using_session(:carol) { click_button "Computer Style System" }
+    click_button "Finish"
+    click_button "End quiz"
+
+    assert_text "The quiz is over"
+    assert_selector "li.leader", count: 3
+    assert_selector "li.leader:nth-child(1) .leader__name", text: "Alice"
+    assert_selector "li.leader:nth-child(2) .leader__name", text: "Bob"
+    assert_selector "li.leader:nth-child(3) .leader__name", text: "Carol"
+    assert_selector "li.leader:nth-child(1) .leader__score", text: "3 points"
+    assert_selector "li.leader:nth-child(3) .leader__score", text: "0 points"
+    assert_no_selector "li.leader .leader__badge"
+
