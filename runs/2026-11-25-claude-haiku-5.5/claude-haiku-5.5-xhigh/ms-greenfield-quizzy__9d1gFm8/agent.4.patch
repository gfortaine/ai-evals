@@ -0,0 +1,20 @@
+# Prizes. The quiz gets its number of winners. When a game ends, each player's
+# result is stored (points, total speed of the correct answers, place), and the
+# winners are marked. Every answer keeps the time of its last pick: `updated_at`
+# does not move when a player taps the same option again.
+class AddPrizes < ActiveRecord::Migration[8.1]
+  def change
+    add_column :quizzes, :winners_count, :integer, null: false, default: 3
+
+    add_column :players, :points, :integer, null: false, default: 0
+    add_column :players, :speed_micros, :integer, null: false, default: 0
+    add_column :players, :place, :integer
+    add_column :players, :winner, :boolean, null: false, default: false
+
+    add_column :answers, :picked_at, :datetime
+
+    reversible do |direction|
+      direction.up { execute "UPDATE answers SET picked_at = updated_at WHERE picked_at IS NULL" }
+    end
+  end
+end
