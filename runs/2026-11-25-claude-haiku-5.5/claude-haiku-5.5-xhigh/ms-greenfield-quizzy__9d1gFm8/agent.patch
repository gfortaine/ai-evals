--- /dev/null
+++ b/test/system/prizes_test.rb
@@ -0,0 +1,86 @@
+require "application_system_test_case"
+
+# The prizes in real browsers: a whole game with three phones, the speed tie-break
+# with real time, and the winners shown live on the screen and on the phones.
+class PrizesSystemTest < ApplicationSystemTestCase
+  include GameFixtures
+
+  setup do
+    @quiz = build_quiz_with_questions
+  end
+
+  test "a game ends with a leaderboard, and the winners appear live on the screen and the phones" do
+    visit "/moderate/quizzes/#{@quiz.id}"
+    click_button "Start a game"
+    assert_text "Players: 0"
+
+    # Bob joins first, but answers slowest: on equal points, speed decides.
+    using_session(:bob) { join_as("Bob") }
+    using_session(:alice) { join_as("Alice") }
+    using_session(:carol) { join_as("Carol") }
+    assert_text "Players: 3"
+
+    click_button "Start"
+    assert_text "Question 1 of 3"
+    using_session(:alice) { click_button "429" }
+    using_session(:bob) do
+      sleep 1.5
+      click_button "429"
+    end
+    using_session(:carol) { click_button "418" }
+    click_button "Finish"
+    click_button "Next"
+
+    using_session(:alice) { click_button "WebSocket" }
+    using_session(:bob) { click_button "WebSocket" }
+    using_session(:carol) { click_button "SMTP" }
+    click_button "Finish"
+    click_button "Next"
+
+    using_session(:alice) { click_button "Cascading Style Sheets" }
+    using_session(:bob) { click_button "Cascading Style Sheets" }
+    using_session(:carol) { click_button "Computer Style System" }
+    click_button "Finish"
+    click_button "End quiz"
+
+    assert_text "The quiz is over"
+    assert_selector "li.leader", count: 3
+    assert_selector "li.leader:nth-child(1) .leader__name", text: "Alice"
+    assert_selector "li.leader:nth-child(2) .leader__name", text: "Bob"
+    assert_selector "li.leader:nth-child(3) .leader__name", text: "Carol"
+    assert_selector "li.leader:nth-child(1) .leader__score", text: "3 points"
+    assert_selector "li.leader:nth-child(3) .leader__score", text: "0 points"
+    assert_no_selector "li.leader .leader__badge"
+
+    using_session(:alice) do
+      assert_text "Place 1 of 3"
+      assert_text "3 points"
+      assert_no_text "You won!"
+    end
+    using_session(:carol) { assert_text "Place 3 of 3" }
+
+    click_button "Top 3"
+    assert_selector "li.leader .leader__badge", text: "Winner", count: 2
+    assert_selector "li.leader:nth-child(3) .leader__badge", count: 0
+    using_session(:alice) { assert_text "You won!" }
+    using_session(:bob) { assert_text "You won!" }
+    using_session(:carol) do
+      assert_text "Place 3 of 3"
+      assert_no_text "You won!"
+    end
+
+    click_button "Reset winners"
+    assert_no_selector "li.leader .leader__badge"
+    using_session(:alice) { assert_no_text "You won!" }
+    using_session(:bob) { assert_no_text "You won!" }
+  end
+
+  private
+
+  def join_as(name)
+    visit "/play/#{Game.last.code}"
+    fill_in "Your name", with: name
+    click_button "Join"
+    assert_text "Hi, #{name}!"
+  end
+end
diff --git a/test/system/quiz_preparation_test.rb b/test/system/quiz_preparation_test.rb
new file mode 100644
index 0000000..f108fce
--- /dev/null
+++ b/test/system/quiz_preparation_test.rb
@@ -0,0 +1,177 @@
+require "application_system_test_case"
+
+class QuizPreparationTest < ApplicationSystemTestCase
+  QUESTION_TEXT = "Which HTTP status code means \"Too Many Requests\"?".freeze
+
+  test "create a quiz, see it on its page, and open its settings" do
+    visit "/moderate"
+    click_button "New quiz"
+    fill_in "Title", with: "Frontend Fest 2026"
+    click_button "Save quiz"
+
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_text "No questions yet"
+    assert_link "Settings"
+    assert_link "Preview"
+    assert_button "Add question"
+
+    click_link "Settings"
+    assert_field "Title", with: "Frontend Fest 2026"
+    fill_in "Title", with: "Frontend Fest 2027"
+    click_button "Save quiz"
+    assert_selector "h1", text: "Frontend Fest 2027"
+  end
+
+  test "a blank title is refused and nothing is saved" do
+    visit "/moderate/quizzes/new"
+    click_button "Save quiz"
+    assert_text "Title can't be blank"
+    assert_field "Title", with: ""
+    assert_equal 0, Quiz.count
+  end
+
+  test "a new question starts with four empty option rows, all of them active" do
+    quiz = Quiz.create!(title: "Talk")
+    visit "/moderate/quizzes/#{quiz.id}/questions/new"
+    assert_checked_field "Active"
+    (1..4).each do |number|
+      assert_field "Option #{number}", with: ""
+      assert_unchecked_field "Option #{number} is correct"
+    end
+    assert_no_selector "input[name='question[options][4][text]']"
+  end
+
+  test "add option appends the next numbered row" do
+    quiz = Quiz.create!(title: "Talk")
+    visit "/moderate/quizzes/#{quiz.id}/questions/new"
+    click_button "Add option"
+    assert_field "Option 5", with: ""
+    assert_unchecked_field "Option 5 is correct"
+  end
+
+  test "a question is saved with its options, and the quiz page shows the correct ones" do
+    quiz = Quiz.create!(title: "Talk")
+    visit "/moderate/quizzes/#{quiz.id}"
+    click_button "Add question"
+
+    fill_in "Question", with: QUESTION_TEXT
+    fill_in "Option 1", with: "418"
+    fill_in "Option 2", with: "429"
+    check "Option 2 is correct"
+    fill_in "Option 3", with: "503"
+    click_button "Save question"
+
+    assert_current_path "/moderate/quizzes/#{quiz.id}", ignore_query: true
+    within(".question-item", text: QUESTION_TEXT) do
+      assert_selector ".question-item__options li", count: 3
+      assert_selector ".question-item__options li.is-correct", text: "429"
+      assert_text "A. 418"
+      assert_text "B. 429"
+    end
+  end
+
+  test "option rows are skipped when empty and the typed values survive a rule failure" do
+    quiz = Quiz.create!(title: "Talk")
+    visit "/moderate/quizzes/#{quiz.id}/questions/new"
+    fill_in "Question", with: "Typed question"
+    fill_in "Option 1", with: "Only one"
+    check "Option 1 is correct"
+    click_button "Save question"
+
+    assert_text "Add at least two options"
+    assert_field "Question", with: "Typed question"
+    assert_field "Option 1", with: "Only one"
+    assert_checked_field "Option 1 is correct"
+    assert_equal 0, quiz.questions.count
+
+    fill_in "Option 2", with: "Second"
+    uncheck "Option 1 is correct"
+    click_button "Save question"
+    assert_text "Mark at least one option as correct"
+    assert_field "Option 1", with: "Only one"
+    assert_unchecked_field "Option 1 is correct"
+    assert_field "Option 2", with: "Second"
+    assert_equal 0, quiz.questions.count
+
+    check "Option 2 is correct"
+    fill_in "Option 3", with: "   "
+    click_button "Save question"
+    assert_selector ".question-item", text: "Typed question"
+    assert_equal %w[Only\ one Second], quiz.questions.first.options.map(&:text)
+    assert_equal [ false, true ], quiz.questions.first.options.map(&:correct)
+  end
+
+  test "moving questions changes their order" do
+    quiz = Quiz.create!(title: "Talk")
+    first = create_question(quiz, "First question")
+    create_question(quiz, "Second question")
+
+    visit "/moderate/quizzes/#{quiz.id}"
+    assert_equal [ "First question", "Second question" ], question_texts
+
+    within(".question-item", text: "Second question") { click_button "Move up" }
+    assert_equal [ "Second question", "First question" ], question_texts
+
+    within(".question-item", text: "Second question") { click_button "Move down" }
+    assert_equal [ "First question", "Second question" ], question_texts
+    assert first.reload.position < Question.find_by!(text: "Second question").position
+  end
+
+  test "the active switch saves at once and inactive questions are dimmed" do
+    quiz = Quiz.create!(title: "Talk")
+    question = create_question(quiz, "Switch me")
+
+    visit "/moderate/quizzes/#{quiz.id}"
+    within(".question-item", text: "Switch me") { uncheck "Active" }
+    assert_selector ".question-item--inactive", text: "Switch me"
+    assert_not question.reload.active?
+
+    within(".question-item", text: "Switch me") { check "Active" }
+    assert_no_selector ".question-item--inactive"
+    assert question.reload.active?
+  end
+
+  test "deleting a question asks first" do
+    quiz = Quiz.create!(title: "Talk")
+    create_question(quiz, "Keep me")
+    create_question(quiz, "Delete me")
+
+    visit "/moderate/quizzes/#{quiz.id}"
+    dismiss_confirm("Delete this question?") do
+      within(".question-item", text: "Delete me") { click_button "Delete" }
+    end
+    assert_text "Delete me"
+    assert_equal 2, quiz.questions.count
+
+    accept_confirm("Delete this question?") do
+      within(".question-item", text: "Delete me") { click_button "Delete" }
+    end
+    assert_no_text "Delete me"
+    assert_equal [ "Keep me" ], quiz.questions.reload.map(&:text)
+  end
+
+  test "deleting a quiz asks first and then goes back to the list" do
+    quiz = Quiz.create!(title: "Doomed")
+    visit "/moderate/quizzes/#{quiz.id}/edit"
+    dismiss_confirm { click_button "Delete quiz" }
+    assert_equal 1, Quiz.where(id: quiz.id).count
+
+    accept_confirm { click_button "Delete quiz" }
+    assert_current_path "/moderate", ignore_query: true
+    assert_no_text "Doomed"
+    assert_equal 0, Quiz.where(id: quiz.id).count
+  end
+
+  private
+
+  def question_texts
+    page.all(".question-item__body").map(&:text)
+  end
+
+  def create_question(quiz, text)
+    quiz.questions.create!(text: text, active: true).tap do |question|
+      question.option_rows = [ { text: "A", correct: true }, { text: "B", correct: false } ]
+      question.save!
+    end
+  end
+end
diff --git a/test/system/timer_test.rb b/test/system/timer_test.rb
new file mode 100644
index 0000000..1bbf640
--- /dev/null
+++ b/test/system/timer_test.rb
@@ -0,0 +1,70 @@
+require "application_system_test_case"
+
+# The timer in real browsers: the big screen counts the question down, the question
+# closes by itself at 0:00 (nobody clicks Finish), and the phones show the result
+# without ever showing a clock.
+class TimerSystemTest < ApplicationSystemTestCase
+  include GameFixtures
+
+  setup do
+    @quiz = build_quiz_with_questions
+  end
+
+  def join_as(name)
+    visit "/play/#{Game.last.code}"
+    fill_in "Your name", with: name
+    click_button "Join"
+    assert_text "Hi, #{name}!"
+  end
+
+  def start_game_with_timer(seconds)
+    @quiz.update!(timer_minutes: 0, timer_seconds: seconds)
+    visit "/moderate/quizzes/#{@quiz.id}"
+    click_button "Start a game"
+    assert_text "Players: 0"
+    using_session(:alice) { join_as("Alice") }
+    using_session(:bob) { join_as("Bob") }
+    assert_text "Players: 2"
+    click_button "Start"
+    assert_text "Question 1 of 3"
+  end
+
+  test "the big screen counts down, and the question closes by itself at 0:00" do
+    start_game_with_timer(8)
+
+    assert_selector ".countdown[role='timer']", text: /\A0:0\d\z/
+    # The browser counts it down by itself: the shown time changes without a reload.
+    shown = find(".countdown").text
+    assert_no_selector ".countdown", text: shown, wait: 3
+    assert_button "Finish"
+
+
+    using_session(:alice) { click_button "429" }
+    assert_text "Answers: 1 / 2"
+
+    # Nobody clicks Finish: the timer closes the question.
+    assert_button "Next", wait: 14
+    assert_no_selector ".countdown"
+    assert_no_button "Finish"
+    assert_selector ".stage-option.is-correct .stage-option__count", text: "1 answer"
+
+    using_session(:alice) do
+      assert_selector "[role=status]", text: "Correct!", wait: 10
+    end
+    using_session(:bob) do
+      assert_selector "[role=status]", text: "No answer", wait: 10
+      assert_no_selector ".countdown"
+      assert_no_text(/\d:\d\d/)
+    end
+  end
+
+  test "a reload does not restart the countdown" do
+    start_game_with_timer(10)
+    assert_selector ".countdown", text: /\A0:(09|10)\z/
+    sleep 2.5
+
+    visit current_path
+    assert_selector ".countdown", text: /\A0:0[0-7]\z/
+    assert_button "Finish"
+  end
+end
