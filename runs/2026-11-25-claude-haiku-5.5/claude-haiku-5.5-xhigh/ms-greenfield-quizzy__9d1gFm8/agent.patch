new file mode 100644
index 0000000..49f7f19
--- /dev/null
+++ b/test/integration/game_moderation_test.rb
@@ -0,0 +1,198 @@
+require "test_helper"
+
+class GameModerationTest < ActionDispatch::IntegrationTest
+  include GameFixtures
+
+  setup do
+    @auth = moderator_headers
+    @quiz = build_quiz_with_questions
+  end
+
+  test "every game page asks for the moderator's login" do
+    game = Game.create_from_quiz!(@quiz)
+    get "/moderate/games/#{game.id}"
+    assert_response :unauthorized
+    get "/moderate/games/#{game.id}/live"
+    assert_response :unauthorized
+    post "/moderate/games/#{game.id}/start"
+    assert_response :unauthorized
+    post "/moderate/quizzes/#{@quiz.id}/games"
+    assert_response :unauthorized
+    assert_equal "lobby", game.reload.phase
+  end
+
+  test "the quiz page has Start a game and lists the games" do
+    get "/moderate/quizzes/#{@quiz.id}", headers: @auth
+    assert_response :success
+    assert_select "button", text: "Start a game"
+    assert_select "table.runs-table", count: 0
+    assert_select "p.empty", text: /No games yet/
+  end
+
+  test "Start a game creates a game and opens its big screen" do
+    assert_difference "Game.count", 1 do
+      post "/moderate/quizzes/#{@quiz.id}/games", headers: @auth
+    end
+    game = Game.last
+    assert_equal @quiz, game.quiz
+    assert_redirected_to "/moderate/games/#{game.id}"
+    assert_response :see_other
+  end
+
+  test "the quiz page lists its games, one per row, with a status" do
+    game = Game.create_from_quiz!(@quiz)
+    get "/moderate/quizzes/#{@quiz.id}", headers: @auth
+    assert_select "table.runs-table tbody tr", count: 1 do
+      assert_select "td", text: "Waiting"
+      assert_select "a[href='/moderate/games/#{game.id}']", text: "Open"
+    end
+  end
+
+  test "the lobby shows the title, the join link as text, a QR code and the player count" do
+    game = Game.create_from_quiz!(@quiz)
+    game.join("Alice")
+    game.join("Bob")
+
+    get "/moderate/games/#{game.id}", headers: @auth
+    assert_response :success
+    assert_select "h1.lobby__title", text: "Frontend Fest 2026"
+    assert_select "p.lobby__url", text: "www.example.com/play/#{game.code}"
+    assert_select ".counter-pill", text: "Players: 2"
+    assert_select ".qr svg"
+    assert_select "button", text: "Start"
+    assert_select "button", text: "Finish", count: 0
+  end
+
+  test "the QR code encodes the full join link" do
+    game = Game.create_from_quiz!(@quiz)
+    get "/moderate/games/#{game.id}", headers: @auth
+    assert_select ".qr[aria-label='QR code for the join link']" do
+      assert_select "svg[viewBox]"
+    end
+    assert_no_match(/<\?xml/, response.body, "the SVG is embedded, not a standalone file")
+  end
+
+  test "Start shows the first question with its progress and options, without the answers" do
+    game = Game.create_from_quiz!(@quiz)
+    game.join("Alice")
+    post "/moderate/games/#{game.id}/start", headers: @auth
+    assert_redirected_to "/moderate/games/#{game.id}"
+
+    get "/moderate/games/#{game.id}", headers: @auth
+    assert_select ".stage-question__num", text: "Question 1 of 3"
+    assert_select ".stage-question__body", text: "Which HTTP status code means \"Too Many Requests\"?"
+    assert_select ".stage-option", count: 3
+    assert_select ".stage-option__title", text: "429"
+    assert_select ".answers-counter", text: "Answers: 0 / 1"
+    assert_select "button", text: "Finish"
+    assert_no_match(/Correct/, response.body)
+    assert_no_match(/is-correct/, response.body)
+  end
+
+  test "Finish closes the question and marks the correct options with their counts" do
+    game = Game.create_from_quiz!(@quiz)
+    alice = game.join("Alice")
+    game.join("Bob")
+    game.start!
+    game.answer!(alice, game.current_question.options.find { |option| option.text == "429" })
+
+    post "/moderate/games/#{game.id}/finish", headers: @auth
+    get "/moderate/games/#{game.id}", headers: @auth
+    assert_select "li.stage-option.is-correct", count: 1 do
+      assert_select ".stage-option__mark", text: "Correct"
+      assert_select ".stage-option__title", text: "429"
+      assert_select ".stage-option__count", text: "1 answer"
+    end
+    assert_select "li.stage-option:not(.is-correct) .stage-option__count", text: "0 answers", count: 2
+    assert_select "button", text: "Next"
+    assert_select "button", text: "Start", count: 0
+  end
+
+  test "Next opens the next question; on the last question the button is End quiz" do
+    game = Game.create_from_quiz!(@quiz)
+    game.start!
+    game.finish!
+    post "/moderate/games/#{game.id}/next", headers: @auth
+    get "/moderate/games/#{game.id}", headers: @auth
+    assert_select ".stage-question__num", text: "Question 2 of 3"
+    assert_select ".stage-question__body", text: "Which protocol keeps a two-way connection?"
+    assert_select "button", text: "Finish"
+
+    game.finish!
+    game.next_question!
+    game.finish!
+    get "/moderate/games/#{game.id}", headers: @auth
+    assert_select ".stage-question__num", text: "Question 3 of 3"
+    assert_select "button", text: "Next", count: 0
+    assert_select "button", text: "End quiz"
+  end
+
+  test "End quiz shows that the quiz is over, and the join link is closed" do
+    game = Game.create_from_quiz!(@quiz)
+    game.start!
+    game.finish!
+    game.next_question!
+    game.finish!
+    post "/moderate/games/#{game.id}/end_quiz", headers: @auth
+    assert_response :see_other
+
+    get "/moderate/games/#{game.id}", headers: @auth
+    assert_select "h1.screen__ended", text: "The quiz is over"
+    assert_select "button", count: 0, text: /Start|Finish|Next|End quiz/
+  end
+
+  test "a click that comes too late is refused with a message, and changes nothing" do
+    game = Game.create_from_quiz!(@quiz)
+    game.start!
+    post "/moderate/games/#{game.id}/finish", headers: @auth
+    post "/moderate/games/#{game.id}/finish", headers: @auth
+    assert_redirected_to "/moderate/games/#{game.id}"
+    get response.location, headers: @auth
+    assert_select "[role=status]", text: /already moved on/
+    assert game.reload.closed?
+  end
+
+  test "a quiz without active questions cannot start, but can be ended" do
+    empty = Quiz.create!(title: "Nothing yet")
+    game = Game.create_from_quiz!(empty)
+    get "/moderate/games/#{game.id}", headers: @auth
+    assert_select "button[disabled]", text: "Start"
+    assert_select "button", text: "End quiz"
+
+    post "/moderate/games/#{game.id}/start", headers: @auth
+    get response.location, headers: @auth
+    assert_select "[role=status]", text: /no active questions/
+    assert game.reload.lobby?
+  end
+
+  test "the live fragment of the big screen is served with an ETag and 304 while nothing changed" do
+    game = Game.create_from_quiz!(@quiz)
+    get "/moderate/games/#{game.id}/live", headers: @auth
+    assert_response :success
+    assert_select ".counter-pill", text: "Players: 0"
+    etag = response.headers["ETag"]
+    assert etag.present?
+
+    get "/moderate/games/#{game.id}/live", headers: @auth.merge("HTTP_IF_NONE_MATCH" => etag)
+    assert_response :not_modified
+
+    game.join("Alice")
+    get "/moderate/games/#{game.id}/live", headers: @auth.merge("HTTP_IF_NONE_MATCH" => etag)
+    assert_response :success
+    assert_select ".counter-pill", text: "Players: 1"
+  end
+
+  test "the big screen does not render a dead game's buttons" do
+    game = Game.create_from_quiz!(@quiz)
+    game.end_quiz!
+    get "/moderate/games/#{game.id}", headers: @auth
+    assert_select "form[action$='/start']", count: 0
+    assert_select "form[action$='/finish']", count: 0
+    assert_select "form[action$='/next']", count: 0
+  end
+
+  test "the moderator can open a game page for an unknown id with a 404" do
+    get "/moderate/games/999999", headers: @auth
+    assert_response :not_found
+  end
+end
diff --git a/test/integration/import_export_test.rb b/test/integration/import_export_test.rb
new file mode 100644
index 0000000..96ba14f
--- /dev/null
+++ b/test/integration/import_export_test.rb
@@ -0,0 +1,129 @@
+require "test_helper"
+
+class ImportExportTest < ActionDispatch::IntegrationTest
+  setup do
+    @auth = moderator_headers
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+    question = @quiz.questions.new(text: 'Which HTTP status code means "Too Many Requests"?', active: true)
+    question.option_rows = [ { text: "418", correct: false }, { text: "429", correct: true } ]
+    question.save!
+  end
+
+  def basic(user, password)
+    { "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials(user, password) }
+  end
+
+  def valid_json(title: "Imported talk")
+    {
+      title: title,
+      questions: [
+        { text: "Q1?", active: true, options: [ { text: "A", correct: false }, { text: "B", correct: true } ] }
+      ]
+    }.to_json
+  end
+
+  test "the quiz page links to its export" do
+    get "/moderate/quizzes/#{@quiz.id}", headers: @auth
+    assert_response :success
+    assert_select "a[href=?]", "/moderate/quizzes/#{@quiz.id}/export", text: "Export"
+  end
+
+  test "the export page shows the quiz as JSON in the only pre element" do
+    get "/moderate/quizzes/#{@quiz.id}/export", headers: @auth
+    assert_response :success
+    assert_select "pre", count: 1
+
+    data = JSON.parse(css_select("pre").first.text)
+    assert_equal({
+      "title" => "Frontend Fest 2026",
+      "questions" => [ {
+        "text" => 'Which HTTP status code means "Too Many Requests"?',
+        "active" => true,
+        "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ]
+      } ]
+    }, data)
+  end
+
+  test "the export page is only reachable with the moderator's credentials" do
+    get "/moderate/quizzes/#{@quiz.id}/export"
+    assert_response :unauthorized
+    get "/moderate/quizzes/#{@quiz.id}/export", headers: basic("moderator", "wrong")
+    assert_response :unauthorized
+  end
+
+  test "the import form is only reachable with the moderator's credentials" do
+    get "/moderate/import/new"
+    assert_response :unauthorized
+    post "/moderate/import", params: { quiz_import: { json: valid_json } }
+    assert_response :unauthorized
+    assert_equal 1, Quiz.count
+  end
+
+  test "the quiz list has an Import quiz button that opens the import form" do
+    get "/moderate", headers: @auth
+    assert_select "form[action=?] button", "/moderate/import/new", text: "Import quiz"
+
+    get "/moderate/import/new", headers: @auth
+    assert_response :success
+    assert_select "label", text: "Quiz JSON"
+    assert_select "textarea[name=?]", "quiz_import[json]"
+    assert_select "input[type=submit], button", text: "Import"
+  end
+
+  test "a valid import creates a new quiz and opens its page" do
+    assert_difference "Quiz.count", 1 do
+      assert_difference "Question.count", 1 do
+        assert_difference "Option.count", 2 do
+          post "/moderate/import", params: { quiz_import: { json: valid_json } }, headers: @auth
+        end
+      end
+    end
+    quiz = Quiz.find_by!(title: "Imported talk")
+    assert_redirected_to "/moderate/quizzes/#{quiz.id}"
+    assert_equal "Quiz imported.", flash[:notice]
+  end
+
+  test "importing a quiz whose title already exists still creates a new one" do
+    assert_difference "Quiz.count", 1 do
+      post "/moderate/import", params: { quiz_import: { json: valid_json(title: "Frontend Fest 2026") } }, headers: @auth
+    end
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+  end
+
+  test "an invalid import shows the errors and creates nothing" do
+    broken = { title: "Half done", questions: [
+      { text: "Fine", options: [ { text: "A", correct: true }, { text: "B" } ] },
+      { text: "Broken", options: [ { text: "A" }, { text: "B" } ] }
+    ] }.to_json
+
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      post "/moderate/import", params: { quiz_import: { json: broken } }, headers: @auth
+    end
+    assert_response :unprocessable_entity
+    assert_select "[role=alert] li", text: "Question 2: Mark at least one option as correct"
+    assert_select "textarea", text: /Half done/
+  end
+
+  test "invalid JSON is refused with an error and nothing is created" do
+    assert_no_difference "Quiz.count" do
+      post "/moderate/import", params: { quiz_import: { json: "{ nope" } }, headers: @auth
+    end
+    assert_response :unprocessable_entity
+    assert_select "[role=alert] li", text: "Quiz JSON is not valid JSON"
+  end
+
+  test "a request without the form field is a bad request" do
+    post "/moderate/import", params: {}, headers: @auth
+    assert_response :bad_request
+  end
+
+  test "exporting and importing gives back the same quiz" do
+    get "/moderate/quizzes/#{@quiz.id}/export", headers: @auth
+    exported = css_select("pre").first.text
+
+    post "/moderate/import", params: { quiz_import: { json: exported } }, headers: @auth
+    copy = Quiz.order(:id).last
+    assert_not_equal @quiz.id, copy.id
+    assert_equal QuizExport.new(@quiz.reload).to_h, QuizExport.new(copy).to_h
+  end
+end
diff --git a/test/integration/moderate_access_test.rb b/test/integration/moderate_access_test.rb
new file mode 100644
index 0000000..3dde773
--- /dev/null
+++ b/test/integration/moderate_access_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class ModerateAccessTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = Quiz.create!(title: "Talk")
+  end
+
+  def basic(user, password)
+    { "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials(user, password) }
+  end
+
+  def moderate_paths
+    [
+      [ :get, "/moderate" ],
+      [ :get, "/moderate/quizzes/new" ],
+      [ :post, "/moderate/quizzes" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}/edit" ],
+      [ :patch, "/moderate/quizzes/#{@quiz.id}" ],
+      [ :delete, "/moderate/quizzes/#{@quiz.id}" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}/preview" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}/questions/new" ],
+      [ :post, "/moderate/quizzes/#{@quiz.id}/questions" ],
+      [ :patch, "/moderate/quizzes/#{@quiz.id}/questions/1/move_up" ],
+      [ :patch, "/moderate/quizzes/#{@quiz.id}/questions/1/activation" ]
+    ]
+  end
+
+  test "every moderator page asks for credentials" do
+    moderate_paths.each do |method, path|
+      send(method, path)
+      assert_response :unauthorized, "#{method.upcase} #{path} should be 401 without credentials"
+      assert_match(/Basic/, response.headers["WWW-Authenticate"])
+    end
+  end
+
+  test "wrong credentials get 401 everywhere" do
+    moderate_paths.each do |method, path|
+      send(method, path, headers: basic("moderator", "wrong"))
+      assert_response :unauthorized, "#{method.upcase} #{path} should be 401 with a wrong password"
+    end
+    send(:get, "/moderate", headers: basic("nobody", "test-password"))
+    assert_response :unauthorized
+  end
+
+  test "right credentials open the moderator" do
+    get "/moderate", headers: basic("moderator", "test-password")
+    assert_response :success
+  end
+
+  test "missing server configuration never lets anyone in" do
+    original = ENV.to_hash.slice("QUIZZY_MODERATOR_USERNAME", "QUIZZY_MODERATOR_PASSWORD")
+    ENV.delete("QUIZZY_MODERATOR_USERNAME")
+    ENV.delete("QUIZZY_MODERATOR_PASSWORD")
+    get "/moderate", headers: basic("", "")
+    assert_response :unauthorized
+  ensure
+    original.each { |key, value| ENV[key] = value }
+  end
+
+  test "the health check is public" do
+    get "/up"
+    assert_response :success
+  end
+end
diff --git a/test/integration/moderate_flow_test.rb b/test/integration/moderate_flow_test.rb
new file mode 100644
index 0000000..73a6559
--- /dev/null
+++ b/test/integration/moderate_flow_test.rb
@@ -0,0 +1,143 @@
+require "test_helper"
+
+class ModerateFlowTest < ActionDispatch::IntegrationTest
+  setup do
+    @auth = moderator_headers
+    @quiz = Quiz.create!(title: "Talk")
+  end
+
+  test "the quiz list shows the New quiz button" do
+    get "/moderate", headers: @auth
+    assert_response :success
+    assert_select "button", text: "New quiz"
+  end
+
+  test "creating a quiz opens its page" do
+    post "/moderate/quizzes", params: { quiz: { title: "Frontend Fest" } }, headers: @auth
+    quiz = Quiz.find_by!(title: "Frontend Fest")
+    assert_redirected_to "/moderate/quizzes/#{quiz.id}"
+  end
+
+  test "a quiz needs a title" do
+    assert_no_difference "Quiz.count" do
+      post "/moderate/quizzes", params: { quiz: { title: " " } }, headers: @auth
+    end
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Title can't be blank"
+  end
+
+  test "deleting a quiz removes its questions" do
+    question = @quiz.questions.new(text: "Q", active: true)
+    question.option_rows = [ { text: "a", correct: true }, { text: "b", correct: false } ]
+    question.save!
+
+    assert_difference({ "Quiz.count" => -1, "Question.count" => -1, "Option.count" => -2 }) do
+      delete "/moderate/quizzes/#{@quiz.id}", headers: @auth
+    end
+    assert_redirected_to "/moderate"
+  end
+
+  test "a rule failure re-renders the question form with the typed values" do
+    post "/moderate/quizzes/#{@quiz.id}/questions", headers: @auth, params: {
+      question: {
+        text: "Typed",
+        active: "1",
+        options: {
+          "0" => { text: "Only", correct: "1" },
+          "1" => { text: "", correct: "0" }
+        }
+      }
+    }
+    assert_response :unprocessable_entity
+    assert_select "textarea[name='question[text]']", text: "Typed"
+    assert_select "input[name='question[options][0][text]'][value='Only']"
+    assert_select "input[name='question[options][0][correct]'][checked]"
+    assert_select ".errors li", text: "Add at least two options"
+    assert_equal 0, @quiz.questions.count
+  end
+
+  test "a question is created with options in the submitted order" do
+    post "/moderate/quizzes/#{@quiz.id}/questions", headers: @auth, params: {
+      question: {
+        text: "Order",
+        active: "1",
+        options: {
+          "0" => { text: "first", correct: "" },
+          "1" => { text: "", correct: "1" },
+          "2" => { text: "second", correct: "1" }
+        }
+      }
+    }
+    assert_redirected_to "/moderate/quizzes/#{@quiz.id}#question_#{@quiz.questions.last.id}"
+    question = @quiz.questions.last
+    assert_equal %w[first second], question.options.map(&:text)
+    assert_equal [ false, true ], question.options.map(&:correct)
+  end
+
+  test "the active switch saves on its own" do
+    question = make_question("Switch")
+    patch "/moderate/quizzes/#{@quiz.id}/questions/#{question.id}/activation", headers: @auth,
+          params: { question: { active: "0" } }
+    assert_response :see_other
+    assert_not question.reload.active?
+
+    patch "/moderate/quizzes/#{@quiz.id}/questions/#{question.id}/activation", headers: @auth,
+          params: { question: { active: "1" } }
+    assert question.reload.active?
+  end
+
+  test "move up and move down reorder the questions" do
+    a = make_question("a")
+    b = make_question("b")
+    patch "/moderate/quizzes/#{@quiz.id}/questions/#{b.id}/move_up", headers: @auth
+    assert_equal %w[b a], @quiz.questions.reload.map(&:text)
+    patch "/moderate/quizzes/#{@quiz.id}/questions/#{b.id}/move_down", headers: @auth
+    assert_equal %w[a b], @quiz.questions.reload.map(&:text)
+  end
+
+  test "the preview page reads its run from the address only" do
+    question = make_question("Pick me")
+    right = question.options.find_by!(correct: true)
+    get "/moderate/quizzes/#{@quiz.id}/preview", headers: @auth, params: { results: "", pick: right.id }
+    assert_response :success
+    assert_select ".play-status", text: "Correct!"
+    assert_select "button", text: "See score"
+
+    get "/moderate/quizzes/#{@quiz.id}/preview", headers: @auth, params: { results: "1" }
+    assert_select ".result-card__score", text: "Score: 1/1"
+  end
+
+  test "pages render for a fresh quiz" do
+    get "/moderate/quizzes/#{@quiz.id}", headers: @auth
+    assert_response :success
+    assert_select "a", text: "Settings"
+    assert_select "a", text: "Preview"
+    assert_select "button", text: "Add question"
+
+    get "/moderate/quizzes/#{@quiz.id}/edit", headers: @auth
+    assert_response :success
+    assert_select "button", text: "Delete quiz"
+
+    get "/moderate/quizzes/#{@quiz.id}/questions/new", headers: @auth
+    assert_response :success
+    assert_select "input[name^='question[options]'][type=text]", count: 4
+    assert_select "label", text: "Option 4"
+    assert_select "input[type=checkbox][name='question[active]'][checked]"
+    assert_select "button", text: "Save question"
+    assert_select "button", text: "Add option"
+  end
+
+  test "a missing quiz is a 404" do
+    get "/moderate/quizzes/9999", headers: @auth
+    assert_response :not_found
+  end
+
+  private
+
+  def make_question(text)
+    question = @quiz.questions.new(text: text, active: true)
+    question.option_rows = [ { text: "yes", correct: true }, { text: "no", correct: false } ]
+    question.save!
+    question
+  end
+end
diff --git a/test/integration/play_flow_test.rb b/test/integration/play_flow_test.rb
new file mode 100644
index 0000000..ca70650
--- /dev/null
+++ b/test/integration/play_flow_test.rb
@@ -0,0 +1,265 @@
+require "test_helper"
+
+class PlayFlowTest < ActionDispatch::IntegrationTest
+  include GameFixtures
+
+  setup do
+    @quiz = build_quiz_with_questions
+    @game = Game.create_from_quiz!(@quiz)
+  end
+
+  test "the join link asks for a name and has a Join button" do
+    get "/play/#{@game.code}"
+    assert_response :success
+    assert_select "h1", text: @quiz.title
+    assert_select "label[for='player_name']", text: "Your name"
+    assert_select "input#player_name[name='player[name]']"
+    assert_select "button", text: "Join"
+    assert_no_match(/Hi, /, response.body)
+  end
+
+  test "joining shows Hi, name and waiting for the start" do
+    post "/play/#{@game.code}/join", params: { player: { name: "Alice" } }
+    assert_redirected_to "/play/#{@game.code}"
+
+    get "/play/#{@game.code}"
+    assert_select ".play__top", text: /Hi, Alice!/
+    assert_select ".play-lead", text: "Waiting for the quiz to start…"
+    assert_select "button", text: "Join", count: 0
+    assert_equal 1, @game.players.count
+  end
+
+  test "opening the join link again in the same browser continues as the same player" do
+    post "/play/#{@game.code}/join", params: { player: { name: "Alice" } }
+    get "/play/#{@game.code}"
+    assert_select ".play__top", text: /Hi, Alice!/
+
+    assert_equal 1, @game.players.count
+  end
+
+  test "another browser is another player" do
+    post "/play/#{@game.code}/join", params: { player: { name: "Alice" } }
+
+    other = open_session
+    other.get "/play/#{@game.code}"
+    other.assert_select "label", text: "Your name"
+    other.post "/play/#{@game.code}/join", params: { player: { name: "Bob" } }
+    other.get "/play/#{@game.code}"
+    other.assert_select ".play__top", text: /Hi, Bob!/
+    assert_equal 2, @game.players.count
+  end
+
+  test "a browser that joined two games is remembered for each" do
+    other_game = Game.create_from_quiz!(@quiz)
+    post "/play/#{@game.code}/join", params: { player: { name: "Alice" } }
+    post "/play/#{other_game.code}/join", params: { player: { name: "Alice again" } }
+
+    get "/play/#{@game.code}"
+    assert_select ".play__top", text: /Hi, Alice!/
+    get "/play/#{other_game.code}"
+    assert_select ".play__top", text: /Hi, Alice again!/
+  end
+
+  test "a second Join from the same browser changes nothing (a double tap)" do
+    post "/play/#{@game.code}/join", params: { player: { name: "Alice" } }
+    assert_no_difference "Player.count" do
+      post "/play/#{@game.code}/join", params: { player: { name: "Alice" } }
+    end
+    assert_redirected_to "/play/#{@game.code}"
+  end
+
+  test "a blank name is refused with a message, and no player is made" do
+    post "/play/#{@game.code}/join", params: { player: { name: "   " } }
+    assert_response :unprocessable_entity
+    assert_select ".errors li", text: "Name can't be blank"
+    assert_select "input[name='player[name]']"
+    assert_equal 0, @game.players.count
+  end
+
+  test "the join link is case-insensitive" do
+    get "/play/#{@game.code.downcase}"
+    assert_response :success
+    assert_select "label", text: "Your name"
+  end
+
+  test "an unknown code shows a message and 404" do
+    get "/play/ZZZZZ"
+    assert_response :not_found
+    assert_select "h1", text: "No such quiz"
+  end
+
+  test "after the end the join link says the quiz is over, and nobody can join" do
+    @game.end_quiz!
+    get "/play/#{@game.code}"
+    assert_select "h1", text: "The quiz is over"
+    assert_select "input[name='player[name]']", count: 0
+    assert_select "button", text: "Join", count: 0
+
+    assert_no_difference "Player.count" do
+      post "/play/#{@game.code}/join", params: { player: { name: "Late" } }
+    end
+    assert_redirected_to "/play/#{@game.code}"
+    follow_redirect!
+    assert_select "h1", text: "The quiz is over"
+  end
+
+  test "a player who joined sees the quiz is over after the end" do
+    post "/play/#{@game.code}/join", params: { player: { name: "Alice" } }
+    @game.end_quiz!
+    get "/play/#{@game.code}"
+    assert_select "h1", text: "The quiz is over"
+  end
+
+  test "a question shows its text and options as buttons, and a tap marks the answer" do
+    post "/play/#{@game.code}/join", params: { player: { name: "Alice" } }
+    @game.start!
+
+    get "/play/#{@game.code}"
+    assert_select ".play-question__num", text: "Question 1 of 3"
+    assert_select ".play-question__body", text: "Which HTTP status code means \"Too Many Requests\"?"
+    assert_select "button.play-option", count: 3
+    assert_select "button.play-option", text: /429/
+    assert_select ".play-option__mark", count: 0
+
+    option = @game.current_question.options.find_by(text: "429")
+    post "/play/#{@game.code}/answer", params: { game_option_id: option.id }
+    assert_redirected_to "/play/#{@game.code}"
+    get "/play/#{@game.code}"
+    assert_select "button.play-option.is-picked", text: /429/ do
+      assert_select ".play-option__mark", text: "Your answer"
+    end
+    assert_select ".play-option__mark", count: 1
+  end
+
+  test "the last tap counts: a player can change the answer until the question is closed" do
+    post "/play/#{@game.code}/join", params: { player: { name: "Alice" } }
+    @game.start!
+    first = @game.current_question.options.find_by(text: "418")
+    second = @game.current_question.options.find_by(text: "503")
+    post "/play/#{@game.code}/answer", params: { game_option_id: first.id }
+    post "/play/#{@game.code}/answer", params: { game_option_id: second.id }
+
+    get "/play/#{@game.code}"
+    assert_select "button.play-option.is-picked", text: /503/
+    assert_select "button.play-option.is-picked", text: /418/, count: 0
+    assert_equal 1, Answer.count
+  end
+
+  test "while the question is open, no page or fragment reveals the correct option" do
+    post "/play/#{@game.code}/join", params: { player: { name: "Alice" } }
+    @game.start!
+
+    get "/play/#{@game.code}"
+    assert_no_leak(response.body)
+
+    get "/play/#{@game.code}/state", headers: { "Accept" => "text/html" }
+    assert_no_leak(response.body)
+    assert_match "429", response.body
+  end
+
+  test "after Finish: Correct!, Wrong! or No answer, with the correct option shown" do
+    alice = open_session
+    alice.post "/play/#{@game.code}/join", params: { player: { name: "Alice" } }
+    bob = open_session
+    bob.post "/play/#{@game.code}/join", params: { player: { name: "Bob" } }
+    carol = open_session
+    carol.post "/play/#{@game.code}/join", params: { player: { name: "Carol" } }
+
+    @game.start!
+    alice.post "/play/#{@game.code}/answer", params: { game_option_id: @game.current_question.options.find_by(text: "429").id }
+    bob.post "/play/#{@game.code}/answer", params: { game_option_id: @game.current_question.options.find_by(text: "418").id }
+    @game.finish!
+
+    alice.get "/play/#{@game.code}"
+    alice.assert_select "[role=status]", text: "Correct!"
+    alice.assert_select ".play-option.is-correct", text: /429/
+    bob.get "/play/#{@game.code}"
+    bob.assert_select "[role=status]", text: "Wrong!"
+    carol.get "/play/#{@game.code}"
+    carol.assert_select "[role=status]", text: "No answer"
+  end
+
+  test "after the question is closed, a tap is refused with a message" do
+    post "/play/#{@game.code}/join", params: { player: { name: "Alice" } }
+    @game.start!
+    @game.finish!
+    option = @game.game_questions.first.options.find_by(text: "429")
+    post "/play/#{@game.code}/answer", params: { game_option_id: option.id }
+    assert_redirected_to "/play/#{@game.code}"
+    get "/play/#{@game.code}"
+    assert_select "[role=status]", text: "No answer"
+    assert_equal 0, Answer.count
+  end
+
+  test "a tap before joining is refused" do
+    @game.start!
+    option = @game.current_question.options.first
+    post "/play/#{@game.code}/answer", params: { game_option_id: option.id }
+    assert_equal 0, Answer.count
+    get "/play/#{@game.code}"
+    assert_select "label", text: "Your name"
+  end
+
+  test "a player who joins while a question is open can answer it" do
+    @game.start!
+    post "/play/#{@game.code}/join", params: { player: { name: "Late" } }
+    get "/play/#{@game.code}"
+    assert_select "button.play-option", count: 3
+  end
+
+  test "the state fragment is cached by ETag and refreshed when the game changes" do
+    post "/play/#{@game.code}/join", params: { player: { name: "Alice" } }
+    get "/play/#{@game.code}/state"
+    assert_response :success
+    etag = response.headers["ETag"]
+    assert etag.present?
+
+    get "/play/#{@game.code}/state", headers: { "HTTP_IF_NONE_MATCH" => etag }
+    assert_response :not_modified
+
+    @game.start!
+    get "/play/#{@game.code}/state", headers: { "HTTP_IF_NONE_MATCH" => etag }
+    assert_response :success
+    assert_select ".play-question__body", text: "Which HTTP status code means \"Too Many Requests\"?"
+  end
+
+  test "the state fragment of a player depends on that player" do
+    post "/play/#{@game.code}/join", params: { player: { name: "Alice" } }
+    get "/play/#{@game.code}/state"
+    alice_etag = response.headers["ETag"]
+
+    other = open_session
+    other.get "/play/#{@game.code}/state"
+    assert_not_equal alice_etag, other.response.headers["ETag"]
+  end
+
+  test "a player's fragment and page are never cached in a shared cache" do
+    get "/play/#{@game.code}/state"
+    assert_includes response.headers["Cache-Control"], "private"
+  end
+
+  test "a player's own pick changes the ETag, so a cached view is not served stale" do
+    quiz = build_quiz_with_questions
+    game = Game.create_from_quiz!(quiz)
+    post "/play/#{game.code}/join", params: { player: { name: "Alice" } }
+    game.start!
+
+    get "/play/#{game.code}/state"
+    before = response.headers["ETag"]
+    post "/play/#{game.code}/answer", params: { game_option_id: game.current_question.options.find_by(text: "429").id }
+
+    get "/play/#{game.code}/state", headers: { "HTTP_IF_NONE_MATCH" => before }
+    assert_response :success
+    assert_select "button.play-option.is-picked", text: /429/
+  end
+
+  private
+
+  def assert_no_leak(html)
+    assert_no_match(/is-correct/, html)
+    assert_no_match(/data-correct/, html)
+    assert_no_match(/Correct!/, html)
+    assert_no_match(/Correct</, html)
+    assert_no_match(/correct="true"/, html)
+  end
+end
diff --git a/test/integration/prizes_test.rb b/test/integration/prizes_test.rb
new file mode 100644
index 0000000..ae31897
--- /dev/null
+++ b/test/integration/prizes_test.rb
@@ -0,0 +1,261 @@
+require "test_helper"
+
+# The prizes as the moderator and the players see them: the quiz setting, the
+# leaderboard after the end, the winner buttons, and the phones.
+class PrizesTest < ActionDispatch::IntegrationTest
+  include GameFixtures
+
+  setup do
+    @auth = moderator_headers
+    @quiz = build_quiz_with_questions # three active questions
+    @game = Game.create_from_quiz!(@quiz)
+    # Each player joins from their own phone (own cookies). Bob joins first.
+    @bob_phone = join_phone("Bob")
+    @alice_phone = join_phone("Alice")
+    @carol_phone = join_phone("Carol")
+    @bob, @alice, @carol = %w[Bob Alice Carol].map { |name| @game.players.find_by!(name: name) }
+  end
+
+  def join_phone(name)
+    phone = open_session
+    phone.post "/play/#{@game.code}/join", params: { player: { name: name } }
+    phone
+  end
+
+  def correct_option(position)
+    @game.game_questions.find_by!(position: position).options.find_by!(correct: true)
+  end
+
+  def wrong_option(position)
+    @game.game_questions.find_by!(position: position).options.find_by!(correct: false)
+  end
+
+  # Alice answers all three right, Bob one, Carol none.
+  def play_out
+    @game.start!
+    @game.answer!(@alice, correct_option(1))
+    @game.answer!(@bob, correct_option(1))
+    @game.answer!(@carol, wrong_option(1))
+    @game.finish!
+    @game.next_question!
+    @game.answer!(@alice, correct_option(2))
+    @game.answer!(@carol, wrong_option(2))
+    @game.finish!
+    @game.next_question!
+    @game.answer!(@alice, correct_option(3))
+    @game.answer!(@bob, wrong_option(3))
+    @game.finish!
+    @game.end_quiz!
+    @game.reload
+  end
+
+  def leaderboard_names
+    css_select("li.leader .leader__name").map { |node| node.text.strip }
+  end
+
+  test "the quiz settings have a number of winners, 3 by default" do
+    get "/moderate/quizzes/new", headers: @auth
+    assert_select "label[for=quiz_winners_count]", text: "Number of winners"
+    assert_select "input#quiz_winners_count[type=number][min='1'][max='1000'][value='3']"
+  end
+
+  test "the number of winners is saved from the settings page" do
+    patch "/moderate/quizzes/#{@quiz.id}", params: { quiz: { title: @quiz.title, winners_count: "2" } }, headers: @auth
+    assert_redirected_to "/moderate/quizzes/#{@quiz.id}"
+    assert_equal 2, @quiz.reload.winners_count
+  end
+
+  test "the settings refuse a number below 1, or no number, with a message" do
+    patch "/moderate/quizzes/#{@quiz.id}", params: { quiz: { title: @quiz.title, winners_count: "0" } }, headers: @auth
+    assert_response :unprocessable_entity
+    assert_select "[role=alert] li", text: "Number of winners must be greater than or equal to 1"
+
+    patch "/moderate/quizzes/#{@quiz.id}", params: { quiz: { title: @quiz.title, winners_count: "" } }, headers: @auth
+    assert_response :unprocessable_entity
+    assert_select "[role=alert] li", text: "Number of winners is not a number"
+
+    assert_equal 3, @quiz.reload.winners_count
+  end
+
+  test "a new quiz gets 3 winners by default, and a blank number is refused" do
+    post "/moderate/quizzes", params: { quiz: { title: "Talk", winners_count: "" } }, headers: @auth
+    assert_response :unprocessable_entity
+
+    post "/moderate/quizzes", params: { quiz: { title: "Talk" } }, headers: @auth
+    assert_equal 3, Quiz.find_by!(title: "Talk").winners_count
+  end
+
+  test "during the game the big screen shows no places, points or winners" do
+    @game.start!
+    get "/moderate/games/#{@game.id}", headers: @auth
+    assert_select "li.leader", count: 0
+    assert_no_match(/\b\d+ points?\b/, response.body)
+    assert_no_match(/Winner/, response.body)
+    assert_select "button", count: 0, text: /Top \d|Draw|Reset winners/
+  end
+
+  test "after End quiz the big screen lists the players in order, with place, name and points" do
+    play_out
+    get "/moderate/games/#{@game.id}", headers: @auth
+    assert_select "h1.screen__ended", text: "The quiz is over"
+    assert_select "ol.leaderboard > li.leader", count: 3
+    assert_equal %w[Alice Bob Carol], leaderboard_names
+    assert_equal [ "1", "2", "3" ], css_select("li.leader .leader__place").map { |node| node.text.strip }
+    assert_select "li.leader:nth-child(1) .leader__score", text: "3 points"
+    assert_select "li.leader:nth-child(2) .leader__score", text: "1 point"
+    assert_select "li.leader:nth-child(3) .leader__score", text: "0 points"
+  end
+
+  test "the leaderboard marks no winner before the winners are picked" do
+    play_out
+    get "/moderate/games/#{@game.id}", headers: @auth
+    assert_select "li.leader .leader__badge", count: 0
+    assert_no_match(/Winner/, response.body)
+  end
+
+  test "after the end the big screen has Top N, Draw and Reset winners, and no game buttons" do
+    play_out
+    get "/moderate/games/#{@game.id}", headers: @auth
+    assert_select "button", text: "Top 3"
+    assert_select "button", text: "Draw"
+    assert_select "button", text: "Reset winners"
+    assert_select "button", count: 0, text: /Start|Finish|Next|End quiz/
+  end
+
+  test "Top N marks the first N places as winners, and the leaderboard shows the mark" do
+    play_out
+    @quiz.update!(winners_count: 2)
+    post "/moderate/games/#{@game.id}/top_winners", headers: @auth
+    assert_redirected_to "/moderate/games/#{@game.id}"
+
+    get "/moderate/games/#{@game.id}", headers: @auth
+    assert_select "li.leader.is-winner", count: 2
+    assert_select "li.leader .leader__badge", text: "Winner", count: 2
+    assert_select "li.leader:nth-child(3) .leader__badge", count: 0
+    assert_equal %w[Alice Bob], @game.players.where(winner: true).reorder(:place).map(&:name)
+  end
+
+  test "Top N never gives a prize to a player with no points" do
+    play_out
+    @quiz.update!(winners_count: 3)
+    post "/moderate/games/#{@game.id}/top_winners", headers: @auth
+    assert_not @carol.reload.winner?
+    assert_equal 2, @game.players.where(winner: true).count
+  end
+
+  test "Draw picks the winners, and no player without points" do
+    play_out
+    @quiz.update!(winners_count: 1)
+    post "/moderate/games/#{@game.id}/draw_winners", headers: @auth
+    assert_redirected_to "/moderate/games/#{@game.id}"
+    assert_equal [ "Alice" ], @game.players.where(winner: true).map(&:name)
+    assert_not @carol.reload.winner?
+  end
+
+  test "Reset winners removes the winners" do
+    play_out
+    post "/moderate/games/#{@game.id}/top_winners", headers: @auth
+    assert_equal 2, @game.players.where(winner: true).count
+
+    post "/moderate/games/#{@game.id}/reset_winners", headers: @auth
+    assert_equal 0, @game.players.where(winner: true).count
+    get "/moderate/games/#{@game.id}", headers: @auth
+    assert_select "li.leader .leader__badge", count: 0
+  end
+
+  test "winners cannot be picked before the end, and the moderator is told so" do
+    @game.start!
+    post "/moderate/games/#{@game.id}/top_winners", headers: @auth
+    get response.location, headers: @auth
+    assert_select "[role=status]", text: /picked after the quiz is over/
+    assert_equal 0, @game.players.where(winner: true).count
+  end
+
+  test "a draw with nobody on points says so" do
+    @game.start!
+    @game.finish!
+    @game.end_quiz!
+    post "/moderate/games/#{@game.id}/draw_winners", headers: @auth
+    get response.location, headers: @auth
+    assert_select "[role=status]", text: /nobody wins/
+  end
+
+  test "the winner buttons ask for the moderator's login" do
+    play_out
+    post "/moderate/games/#{@game.id}/top_winners"
+    assert_response :unauthorized
+    post "/moderate/games/#{@game.id}/draw_winners"
+    assert_response :unauthorized
+    post "/moderate/games/#{@game.id}/reset_winners"
+    assert_response :unauthorized
+  end
+
+  test "the big screen's live fragment changes when the winners change" do
+    play_out
+    get "/moderate/games/#{@game.id}/live", headers: @auth
+    etag = response.headers["ETag"]
+    get "/moderate/games/#{@game.id}/live", headers: @auth.merge("HTTP_IF_NONE_MATCH" => etag)
+    assert_response :not_modified
+
+    post "/moderate/games/#{@game.id}/top_winners", headers: @auth
+    get "/moderate/games/#{@game.id}/live", headers: @auth.merge("HTTP_IF_NONE_MATCH" => etag)
+    assert_response :success
+    assert_select "li.leader .leader__badge", text: "Winner", count: 2
+  end
+
+  test "a phone shows its place and points only after the end" do
+    @game.start!
+    @bob_phone.get "/play/#{@game.code}"
+    assert_no_match(/Place \d of \d/, @bob_phone.response.body)
+    assert_no_match(/\b\d+ points?\b/, @bob_phone.response.body)
+
+    @game.answer!(@bob, correct_option(1))
+    @game.finish!
+    @game.end_quiz!
+    @bob_phone.get "/play/#{@game.code}"
+    @bob_phone.assert_select "p.result-card__label", text: "Place 1 of 3"
+    @bob_phone.assert_select "p.result-card__score", text: "1 point"
+    @bob_phone.assert_select "h1", text: "The quiz is over"
+  end
+
+  test "a phone shows its place and points after the end, to the first player" do
+    play_out
+    @alice_phone.get "/play/#{@game.code}"
+    @alice_phone.assert_select "p.result-card__label", text: "Place 1 of 3"
+    @alice_phone.assert_select "p.result-card__score", text: "3 points"
+  end
+
+  test "a winner's phone says You won!, and the others do not" do
+    play_out
+    post "/moderate/games/#{@game.id}/top_winners", headers: @auth
+
+    @alice_phone.get "/play/#{@game.code}"
+    @alice_phone.assert_select ".winner-banner", text: "You won!"
+
+    @carol_phone.get "/play/#{@game.code}"
+    @carol_phone.assert_select ".winner-banner", count: 0
+    assert_no_match(/You won!/, @carol_phone.response.body)
+  end
+
+  test "the phone's live fragment changes when the winners change" do
+    play_out
+    @alice_phone.get "/play/#{@game.code}/state"
+    etag = @alice_phone.response.headers["ETag"]
+    @alice_phone.get "/play/#{@game.code}/state", headers: { "HTTP_IF_NONE_MATCH" => etag }
+    assert_equal 304, @alice_phone.response.status
+
+    post "/moderate/games/#{@game.id}/top_winners", headers: @auth
+    @alice_phone.get "/play/#{@game.code}/state", headers: { "HTTP_IF_NONE_MATCH" => etag }
+    assert_equal 200, @alice_phone.response.status
+    @alice_phone.assert_select ".winner-banner", text: "You won!"
+  end
+
+  test "a player who never joined sees the quiz is over, without places or points" do
+    play_out
+    stranger = open_session
+    stranger.get "/play/#{@game.code}"
+    stranger.assert_select "h1", text: "The quiz is over"
+    assert_no_match(/Place \d of \d/, stranger.response.body)
+    assert_no_match(/\b\d+ points?\b/, stranger.response.body)
+  end
+end
diff --git a/test/integration/timer_test.rb b/test/integration/timer_test.rb
new file mode 100644
index 0000000..5a47887
--- /dev/null
+++ b/test/integration/timer_test.rb
@@ -0,0 +1,270 @@
+require "test_helper"
+
+# The time per question, end to end over HTTP: the settings, the big screen's
+# countdown, the closing at 0:00, and what the phones get (no countdown at all).
+class TimerTest < ActionDispatch::IntegrationTest
+  include GameFixtures
+
+  BASE = Time.zone.local(2026, 11, 25, 10, 0, 0)
+
+  setup do
+    @auth = moderator_headers
+    @quiz = build_quiz_with_questions
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    travel_to(BASE - 600) { @game = Game.create_from_quiz!(@quiz) }
+  end
+
+  def countdown_text
+    css_select("[data-controller='countdown'] [data-countdown-target='time']").first&.text
+  end
+
+  def countdown_deadline
+    css_select("[data-controller='countdown']").first&.[]("data-countdown-deadline-value")&.to_i
+  end
+
+  def big_screen
+    get "/moderate/games/#{@game.id}", headers: @auth
+  end
+
+  def open_question_at(time)
+    travel_to(time) { @game.start! }
+  end
+
+  # --- settings ---
+
+  test "the quiz form has the two timer fields, with 0 by default" do
+    get "/moderate/quizzes/new", headers: @auth
+    assert_select "label[for=quiz_timer_minutes]", text: "Timer minutes"
+    assert_select "label[for=quiz_timer_seconds]", text: "Timer seconds"
+    assert_select "input#quiz_timer_minutes[type=number][min='0'][value='0']"
+    assert_select "input#quiz_timer_seconds[type=number][min='0'][max='59'][value='0']"
+  end
+
+  test "the settings show the time per question that is saved" do
+    get "/moderate/quizzes/#{@quiz.id}/edit", headers: @auth
+    assert_select "input#quiz_timer_minutes[value='1']"
+    assert_select "input#quiz_timer_seconds[value='30']"
+  end
+
+  test "the settings save the time per question" do
+    patch "/moderate/quizzes/#{@quiz.id}", params: { quiz: { title: @quiz.title, winners_count: "3", timer_minutes: "2", timer_seconds: "5" } }, headers: @auth
+    assert_redirected_to "/moderate/quizzes/#{@quiz.id}"
+    assert_equal [ 2, 5 ], [ @quiz.reload.timer_minutes, @quiz.timer_seconds ]
+  end
+
+  test "a new quiz can be given a timer, and 0 and 0 means none" do
+    post "/moderate/quizzes", params: { quiz: { title: "Talk", winners_count: "3", timer_minutes: "0", timer_seconds: "45" } }, headers: @auth
+    assert_equal 45, Quiz.find_by!(title: "Talk").time_limit_seconds
+  end
+
+  test "the settings refuse seconds above 59, with a message, and save nothing" do
+    patch "/moderate/quizzes/#{@quiz.id}", params: { quiz: { title: @quiz.title, winners_count: "3", timer_minutes: "1", timer_seconds: "75" } }, headers: @auth
+    assert_response :unprocessable_entity
+    assert_select "[role=alert] li", text: "Timer seconds must be less than or equal to 59"
+    assert_equal [ 1, 30 ], [ @quiz.reload.timer_minutes, @quiz.timer_seconds ]
+  end
+
+  test "the quiz page says how long each question has, or that there is no timer" do
+    get "/moderate/quizzes/#{@quiz.id}", headers: @auth
+    assert_select ".meta", text: /1:30 per question/
+
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    get "/moderate/quizzes/#{@quiz.id}", headers: @auth
+    assert_select ".meta", text: /No timer/
+  end
+
+  test "a question takes the time per question of the quiz when it opens" do
+    post "/moderate/quizzes/#{@quiz.id}/games", headers: @auth
+    game = Game.order(:id).last
+    assert_redirected_to "/moderate/games/#{game.id}"
+
+    post "/moderate/games/#{game.id}/start", headers: @auth
+    assert_equal 90, game.reload.game_questions.first.time_limit_seconds
+  end
+
+  test "a time set in the lobby, after the game started, applies to the first question" do
+    post "/moderate/quizzes/#{@quiz.id}/games", headers: @auth
+    game = Game.order(:id).last
+    patch "/moderate/quizzes/#{@quiz.id}", params: { quiz: { title: @quiz.title, winners_count: "3", timer_minutes: "0", timer_seconds: "5" } }, headers: @auth
+
+    post "/moderate/games/#{game.id}/start", headers: @auth
+    get "/moderate/games/#{game.id}", headers: @auth
+    assert_equal "0:05", countdown_text
+  end
+
+  # --- the big screen ---
+
+  test "the big screen counts the open question down in M:SS, from the time per question" do
+    open_question_at(BASE)
+    travel_to(BASE) do
+      big_screen
+      assert_response :success
+      assert_equal "1:30", countdown_text
+      assert_equal(((BASE + 90).to_f * 1000).round, countdown_deadline)
+      assert_select "[data-controller='countdown'][role='timer'][aria-label='Time left']"
+    end
+  end
+
+  test "the countdown shows the time left, and 0:05 at five seconds" do
+    open_question_at(BASE)
+    travel_to(BASE + 10) do
+      big_screen
+      assert_equal "1:20", countdown_text
+    end
+    travel_to(BASE + 85) do
+      big_screen
+      assert_equal "0:05", countdown_text
+    end
+  end
+
+  test "a reload does not restart the countdown" do
+    open_question_at(BASE)
+    travel_to(BASE + 40) do
+      big_screen
+      first = [ countdown_text, countdown_deadline ]
+      big_screen
+      assert_equal first, [ countdown_text, countdown_deadline ]
+      assert_equal "0:50", first.first
+    end
+  end
+
+  test "a quiz without a timer shows no countdown" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    game = travel_to(BASE - 600) { Game.create_from_quiz!(@quiz) }
+    travel_to(BASE) { game.start! }
+    get "/moderate/games/#{game.id}", headers: @auth
+    assert_select ".countdown", count: 0
+    assert_select "button", text: "Finish"
+  end
+
+  test "there is no countdown in the lobby, when the question is closed, or after the end" do
+    get "/moderate/games/#{@game.id}", headers: @auth
+    assert_select ".countdown", count: 0
+
+    open_question_at(BASE)
+    travel_to(BASE + 5) { @game.finish! }
+    big_screen
+    assert_select ".countdown", count: 0
+
+    travel_to(BASE + 6) { @game.next_question! }
+    travel_to(BASE + 7) { @game.finish! }
+    travel_to(BASE + 8) { @game.next_question! }
+    travel_to(BASE + 9) { @game.finish! }
+    travel_to(BASE + 10) { @game.end_quiz! }
+    big_screen
+    assert_select ".countdown", count: 0
+    assert_select "h1.screen__ended"
+  end
+
+  test "Finish still works before the deadline, and then the countdown is gone" do
+    open_question_at(BASE)
+    travel_to(BASE + 10) { post "/moderate/games/#{@game.id}/finish", headers: @auth }
+    assert_redirected_to "/moderate/games/#{@game.id}"
+    assert_nil flash[:alert]
+
+    travel_to(BASE + 100) do
+      big_screen
+      assert_select ".countdown", count: 0
+      assert_select "button", text: "Next"
+    end
+    assert_in_delta (BASE + 10).to_f, @game.reload.game_questions.first.closed_at.to_f, 0.001
+  end
+
+  test "at 0:00 the big screen shows the question closed, without anyone clicking Finish" do
+    open_question_at(BASE)
+    travel_to(BASE + 90) do
+      big_screen
+      assert_response :success
+      assert_select ".countdown", count: 0
+      assert_select "button", text: "Finish", count: 0
+      assert_select "button", text: "Next"
+      assert_select ".stage-option.is-correct", text: /429/
+    end
+    assert @game.reload.closed?
+    assert_in_delta (BASE + 90).to_f, @game.game_questions.first.closed_at.to_f, 0.001
+  end
+
+  test "the live fragment changes at 0:00, so a screen that polls sees it closed" do
+    open_question_at(BASE)
+    etag = nil
+    travel_to(BASE + 5) do
+      get "/moderate/games/#{@game.id}/live", headers: @auth
+      assert_response :success
+      etag = response.headers["ETag"]
+
+      get "/moderate/games/#{@game.id}/live", headers: @auth.merge("HTTP_IF_NONE_MATCH" => etag)
+      assert_response :not_modified
+    end
+
+    travel_to(BASE + 90) do
+      get "/moderate/games/#{@game.id}/live", headers: @auth.merge("HTTP_IF_NONE_MATCH" => etag)
+      assert_response :success, "the view changed at 0:00, so it is not 304"
+      assert_select ".countdown", count: 0
+      assert_select "button", text: "Next"
+    end
+  end
+
+  test "finishing by the button after 0:00 says the game has already moved on" do
+    open_question_at(BASE)
+    travel_to(BASE + 90) do
+      post "/moderate/games/#{@game.id}/finish", headers: @auth
+    end
+    assert_redirected_to "/moderate/games/#{@game.id}"
+    assert_equal "The game has already moved on. Look at the screen.", flash[:alert]
+    assert @game.reload.closed?
+  end
+
+  # --- the phones ---
+
+  test "phones never show the countdown or a clock time" do
+    ann = open_session
+    ann.post "/play/#{@game.code}/join", params: { player: { name: "Ann" } }
+    open_question_at(BASE)
+    travel_to(BASE + 10) do
+      ann.get "/play/#{@game.code}"
+      assert_equal 200, ann.response.status
+      ann.assert_select ".play-option", minimum: 1
+      ann.assert_select ".countdown", count: 0
+      ann.assert_select "[data-countdown-deadline-value]", count: 0
+      assert_no_match(/\d:\d\d/, Nokogiri::HTML(ann.response.body).at_css(".play__body").text)
+
+      ann.get "/play/#{@game.code}/state"
+      assert_no_match(/countdown|\d:\d\d/, ann.response.body)
+    end
+  end
+
+  test "a phone's answer after 0:00 is refused, and the earlier one still counts" do
+    ann = open_session
+    ann.post "/play/#{@game.code}/join", params: { player: { name: "Ann" } }
+    open_question_at(BASE)
+    right = @game.current_question.options.find_by!(text: "429")
+    wrong = @game.current_question.options.find_by!(text: "418")
+    ann_player = @game.players.find_by!(name: "Ann")
+
+    travel_to(BASE + 89) { ann.post "/play/#{@game.code}/answer", params: { game_option_id: right.id } }
+    assert_equal "429", ann_player.answer_for(@game.game_questions.first).game_option.text
+
+    travel_to(BASE + 90) do
+      ann.post "/play/#{@game.code}/answer", params: { game_option_id: wrong.id }
+      assert_equal 303, ann.response.status
+      assert ann.response.location.end_with?("/play/#{@game.code}")
+      assert_equal "This question is closed.", ann.flash[:alert]
+    end
+    assert_equal "429", ann_player.answer_for(@game.game_questions.first).game_option.text
+    assert @game.reload.closed?
+  end
+
+  test "after 0:00 the phone shows the result of the question" do
+    ann = open_session
+    ann.post "/play/#{@game.code}/join", params: { player: { name: "Ann" } }
+    open_question_at(BASE)
+    right = @game.current_question.options.find_by!(text: "429")
+    travel_to(BASE + 89) { ann.post "/play/#{@game.code}/answer", params: { game_option_id: right.id } }
+
+    travel_to(BASE + 91) do
+      ann.get "/play/#{@game.code}"
+      ann.assert_select "[role=status]", text: "Correct!"
+      ann.assert_select ".play-option.is-correct", text: /429/
+    end
+  end
+end
