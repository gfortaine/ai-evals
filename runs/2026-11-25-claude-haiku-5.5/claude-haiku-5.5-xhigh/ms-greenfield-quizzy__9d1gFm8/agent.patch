+require "application_system_test_case"
+
+class PreviewTest < ApplicationSystemTestCase
+  setup do
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+    @planet = add_question("Which planet is the largest?", [ [ "Jupiter", true ], [ "Saturn", false ], [ "Earth", false ] ])
+    add_question("Left out for now", [ [ "Yes", true ], [ "No", false ] ], active: false)
+    @protocol = add_question("Which protocol keeps a two-way connection?", [ [ "WebSocket", true ], [ "SMTP", false ] ])
+    @css = add_question("What does CSS stand for?", [ [ "Cascading Style Sheets", true ], [ "Computer Style System", false ] ])
+  end
+
+  test "plays the active questions one at a time and reports the score" do
+    visit "/moderate/quizzes/#{@quiz.id}"
+    click_link "Preview"
+
+    assert_text "Question 1 of 3"
+    assert_text "Which planet is the largest?"
+    assert_no_text "Left out for now"
+    assert_no_text "Correct!"
+    assert_button "Jupiter"
+    assert_button "Saturn"
+    assert_button "Earth"
+
+    click_button "Saturn"
+    assert_text "Wrong!"
+    assert_no_text "Correct!"
+    assert_selector ".play-option.is-correct", text: "Jupiter"
+    assert_button "Next question"
+
+    click_button "Next question"
+    assert_text "Question 2 of 3"
+    assert_text "Which protocol keeps a two-way connection?"
+    click_button "WebSocket"
+    assert_text "Correct!"
+
+    click_button "Next question"
+    assert_text "Question 3 of 3"
+    click_button "Computer Style System"
+    assert_text "Wrong!"
+    assert_button "See score"
+    click_button "See score"
+
+    assert_text "Score: 1/3"
+    assert_no_button "Next question"
+
+    click_button "Start over"
+    assert_text "Question 1 of 3"
+    assert_button "Jupiter"
+  end
+
+  test "start over works in the middle of a run" do
+    visit "/moderate/quizzes/#{@quiz.id}/preview"
+    click_button "Jupiter"
+    assert_text "Correct!"
+    click_button "Next question"
+    assert_text "Question 2 of 3"
+
+    click_button "Start over"
+    assert_text "Question 1 of 3"
+    assert_button "Jupiter"
+  end
+
+  test "preview answers are not stored" do
+    counts = [ Quiz.count, Question.count, Option.count ]
+
+    visit "/moderate/quizzes/#{@quiz.id}/preview"
+    click_button "Saturn"
+    click_button "Next question"
+    assert_text "Question 2 of 3"
+
+    # A fresh visit starts over: the run lives only in the page address.
+    visit "/moderate/quizzes/#{@quiz.id}/preview"
+    assert_text "Question 1 of 3"
+    assert_equal counts, [ Quiz.count, Question.count, Option.count ]
+  end
+
+  test "a quiz with no active questions says so" do
+    empty = Quiz.create!(title: "Empty")
+    visit "/moderate/quizzes/#{empty.id}/preview"
+    assert_text "This quiz has no active questions yet."
+    assert_no_button "Start over"
+  end
+
+  private
+
+  def add_question(text, options, active: true)
+    question = @quiz.questions.new(text: text, active: active)
+    question.option_rows = options.map { |label, correct| { text: label, correct: correct } }
+    question.save!
+    question
+  end
+end
diff --git a/test/system/prizes_test.rb b/test/system/prizes_test.rb
