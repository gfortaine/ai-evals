diff --git a/config/routes.rb b/config/routes.rb
new file mode 100644
index 0000000..d2a4fb5
--- /dev/null
+++ b/config/routes.rb
@@ -0,0 +1,49 @@
+Rails.application.routes.draw do
+  # Reveal health status on /up that returns 200 if the app boots with no exceptions, otherwise 500.
+  get "up" => "rails/health#show", as: :rails_health_check
+
+  root to: redirect("/moderate", status: 302)
+
+  namespace :moderate do
+    root "quizzes#index"
+
+    # "Import quiz": GET /moderate/import/new shows the form, POST /moderate/import creates the quiz.
+    resource :import, only: %i[new create], controller: "imports"
+
+    resources :quizzes do
+      get :preview, on: :member
+      get :export, on: :member
+
+      # "Start a game" on the quiz page.
+      resources :games, only: %i[create]
+
+      resources :questions, except: %i[index show] do
+        member do
+          patch :move_up
+          patch :move_down
+          patch :activation
+        end
+      end
+    end
+
+    # A live game: the big screen the moderator runs it from.
+    resources :games, only: %i[show] do
+      get :live, on: :member
+      post :start, on: :member
+      post :finish, on: :member
+      post :next, on: :member, action: :next_question
+      post :end_quiz, on: :member
+
+      # The prizes, after the end: Top N, Draw, Reset winners.
+      post :top_winners, on: :member
+      post :draw_winners, on: :member
+      post :reset_winners, on: :member
+    end
+  end
+
+  # Players, on their phones (no account). The join link shows the code.
+  get "play/:code", to: "play#show", as: :play
+  get "play/:code/state", to: "play#state", as: :play_state
+  post "play/:code/join", to: "play#join", as: :play_join
+  post "play/:code/answer", to: "play#answer", as: :play_answer
+end
