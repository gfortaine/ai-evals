+module Moderate
+  class QuizzesController < BaseController
+    before_action :set_quiz, only: %i[show edit update destroy preview export]
+
+    def index
+      @quizzes = Quiz.includes(:questions).order(created_at: :desc, id: :desc)
+    end
+
+    def show
+      @questions = @quiz.questions.includes(:options)
+      @games = @quiz.games.includes(:players).order(id: :desc)
+    end
+
+    def new
+      @quiz = Quiz.new
+    end
+
+    def create
+      @quiz = Quiz.new(quiz_params)
+      if @quiz.save
+        redirect_to moderate_quiz_path(@quiz), notice: "Quiz saved."
+      else
+        render :new, status: :unprocessable_entity
+      end
+    end
+
+    def edit
+    end
+
+    def update
+      if @quiz.update(quiz_params)
+        redirect_to moderate_quiz_path(@quiz), notice: "Quiz saved."
+      else
+        render :edit, status: :unprocessable_entity
+      end
+    end
+
+    def destroy
+      @quiz.destroy
+      redirect_to moderate_root_path, notice: "Quiz deleted.", status: :see_other
+    end
+
+    def preview
+      questions = @quiz.questions.active.includes(:options)
+      @preview = QuizPreview.new(questions, results: params[:results], pick: params[:pick])
+    end
+
+    # "Export": the quiz as JSON, ready to copy into another Quizzy.
+    def export
+      @export_json = QuizExport.new(@quiz).pretty_json
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:id])
+    end
+
+    def quiz_params
+      params.require(:quiz).permit(:title, :winners_count, :timer_minutes, :timer_seconds)
+    end
+  end
+end
