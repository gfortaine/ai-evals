+<% content_for :title, "Preview · #{@quiz.title}" %>
+
+<% content_for :banner do %>
+  <div class="preview-banner">
+    <span>Preview: nothing you answer here is saved.</span>
+  </div>
+<% end %>
+
+<div class="breadcrumbs"><%= link_to "← #{@quiz.title}", moderate_quiz_path(@quiz) %></div>
+
+<div class="play">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span><%= @quiz.title %></span>
+  </div>
+
+  <div class="play__body play__body--top">
+    <% if @preview.empty? %>
+      <p class="play-lead">This quiz has no active questions yet. Turn a question on in the quiz page to play it here.</p>
+    <% elsif @preview.finished? %>
+      <div class="result-card">
+        <p class="result-card__label">Quiz finished</p>
+        <p class="result-card__score">Score: <%= @preview.score %>/<%= @preview.total %></p>
+      </div>
+    <% else %>
+      <% question = @preview.current_question %>
+      <div class="play-question__num">Question <%= @preview.answered + 1 %> of <%= @preview.total %></div>
+      <div class="play-question__body"><%= question.text %></div>
+
+      <% if @preview.revealed? %>
+        <% picked = @preview.picked_option %>
+        <div class="play-options is-locked is-revealed">
+          <% question.options.each_with_index do |option, index| %>
+            <div class="play-option<%= " is-correct" if option.correct? %><%= " is-picked" if option == picked %>">
+              <span class="play-option__letter"><%= option_letter(index) %></span>
+              <span class="play-option__title"><%= option.text %></span>
+            </div>
+          <% end %>
+        </div>
+
+        <div class="play-status <%= @preview.correct_pick? ? "play-status--right" : "play-status--wrong" %>" role="status">
+          <%= @preview.correct_pick? ? "Correct!" : "Wrong!" %>
+        </div>
+
+        <div class="buttons preview-actions">
+          <%= button_to (@preview.last_question? ? "See score" : "Next question"),
+                preview_moderate_quiz_path(@quiz), method: :get,
+                params: { results: @preview.results_with_answer }, class: "btn btn--pink btn--lg" %>
+        </div>
+      <% else %>
+        <div class="play-options">
+          <% question.options.each_with_index do |option, index| %>
+            <%= button_to preview_moderate_quiz_path(@quiz), method: :get,
+                  params: { results: @preview.results, pick: option.id }, class: "play-option" do %>
+              <span class="play-option__letter"><%= option_letter(index) %></span>
+              <span class="play-option__title"><%= option.text %></span>
+            <% end %>
+          <% end %>
+        </div>
+      <% end %>
+    <% end %>
+
+    <% unless @preview.empty? %>
+      <div class="buttons preview-actions">
+        <%= button_to "Start over", preview_moderate_quiz_path(@quiz), method: :get, class: "btn btn--ghost" %>
+      </div>
+    <% end %>
+  </div>
+</div>
diff --git a/app/views/moderate/quizzes/show.html.erb b/app/views/moderate/quizzes/show.html.erb
new file mode 100644
