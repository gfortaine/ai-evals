+    <span class="field-hint">The big screen counts down each open question; players don't see the timer. 0 minutes and 0 seconds means no timer.</span>
+  </fieldset>
+
+  <div class="buttons">
+    <%= f.button "Save quiz", class: "btn btn--pink" %>
+    <%= link_to "Cancel", (quiz.new_record? ? moderate_root_path : moderate_quiz_path(quiz)), class: "btn btn--ghost" %>
+  </div>
+<% end %>
