@@ -0,0 +1,222 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+  include GameFixtures
+
+  setup do
+    @quiz = build_quiz_with_questions # three active questions, one inactive
+    @game = Game.create_from_quiz!(@quiz)
+  end
+
+  test "a game copies the active questions and their options, in order" do
+    assert_equal [ "Which HTTP status code means \"Too Many Requests\"?",
+                   "Which protocol keeps a two-way connection?",
+                   "What does CSS stand for?" ], @game.game_questions.map(&:text)
+    assert_equal [ 1, 2, 3 ], @game.game_questions.map(&:position)
+    assert_equal %w[418 429 503], @game.game_questions.first.options.map(&:text)
+    assert_equal [ false, true, false ], @game.game_questions.first.options.map(&:correct)
+    assert_equal 3, @game.total_questions
+    assert_equal "Frontend Fest 2026", @game.title
+  end
+
+  test "editing the quiz later does not change a game" do
+    question = @quiz.questions.find_by!(text: "What does CSS stand for?")
+    question.update!(text: "Changed")
+    question.option_rows = [ { text: "Other", correct: true }, { text: "Nope", correct: false } ]
+    question.save!
+
+    @game.reload
+    assert_equal "What does CSS stand for?", @game.game_questions.last.text
+    assert_equal "Cascading Style Sheets", @game.game_questions.last.options.first.text
+  end
+
+  test "a game gets a short code that is unique" do
+    assert_match(/\A[A-Z2-9]{5}\z/, @game.code)
+    other = Game.create_from_quiz!(@quiz)
+    assert_not_equal @game.code, other.code
+  end
+
+  test "a new game is in the lobby" do
+    assert @game.lobby?
+    assert_equal 0, @game.position
+    assert_nil @game.current_question
+  end
+
+  test "start opens the first question" do
+    assert @game.start!
+    @game.reload
+    assert @game.open?
+    assert_equal 1, @game.position
+    assert_equal "Which HTTP status code means \"Too Many Requests\"?", @game.current_question.text
+    assert_not_nil @game.game_questions.first.opened_at
+  end
+
+  test "a game with no active questions cannot start" do
+    empty = Game.create_from_quiz!(Quiz.create!(title: "Empty"))
+    assert_not empty.start!
+    assert empty.lobby?
+  end
+
+  test "finish closes the question, and only an open question can be finished" do
+    @game.start!
+    assert @game.finish!
+    @game.reload
+    assert @game.closed?
+    assert_not_nil @game.game_questions.first.closed_at
+    assert_not @game.finish!, "a second Finish does nothing"
+  end
+
+  test "next opens the following question, and only after a closed one" do
+    assert_not @game.next_question!, "the lobby has no next question"
+    @game.start!
+    assert_not @game.next_question!, "an open question is not closed yet"
+    @game.finish!
+    assert @game.next_question!
+    @game.reload
+    assert_equal 2, @game.position
+    assert @game.open?
+    assert_equal "Which protocol keeps a two-way connection?", @game.current_question.text
+  end
+
+  test "the last question is detected, and next does not go past it" do
+    play_to_last_question
+    assert @game.last_question?
+    @game.finish!
+    assert_not @game.next_question!
+    assert @game.closed?
+  end
+
+  test "end quiz ends the game, and nothing moves afterwards" do
+    play_to_last_question
+    @game.finish!
+    assert @game.end_quiz!
+    @game.reload
+    assert @game.ended?
+    assert_not_nil @game.ended_at
+    assert_not @game.end_quiz!
+    assert_not @game.start!
+  end
+
+  test "every change bumps the revision, so the live pages know to fetch again" do
+    before = @game.revision
+    @game.start!
+    assert_operator @game.revision, :>, before
+    before = @game.revision
+    player = @game.join("Alice")
+    assert_operator @game.reload.revision, :>, before
+    before = @game.revision
+    @game.answer!(player, @game.game_questions.first.options.first)
+    assert_operator @game.reload.revision, :>, before
+  end
+
+  test "a move ticks both the big screen and the phones, once each" do
+    assert_broadcasts(@game.live_stream_name, 1) { assert_broadcasts(@game.play_stream_name, 1) { @game.start! } }
+    assert_broadcasts(@game.live_stream_name, 1) { assert_broadcasts(@game.play_stream_name, 1) { @game.finish! } }
+    assert_no_broadcasts(@game.live_stream_name) { @game.finish! }
+  end
+
+  test "joins and answers tick only the big screen, so the phones do not refetch for them" do
+    alice = nil
+    assert_broadcasts(@game.live_stream_name, 1) { alice = @game.join("Alice") }
+    @game.start!
+    assert_no_broadcasts(@game.play_stream_name) { @game.join("Bob") }
+    assert_broadcasts(@game.live_stream_name, 1) { @game.answer!(alice, @game.current_question.options.first) }
+    assert_no_broadcasts(@game.play_stream_name) { @game.answer!(alice, @game.current_question.options.last) }
+  end
+
+  test "players join with a name, in any phase but ended" do
+    alice = @game.join("  Alice  ")
+    assert alice.persisted?
+    assert_equal "Alice", alice.name
+    @game.start!
+    assert @game.join("Bob").persisted?, "a player may join while a question is open"
+    @game.finish!
+    assert @game.join("Carol").persisted?, "and after it is closed"
+    assert_equal 3, @game.players_count
+  end
+
+  test "a blank name is refused" do
+    player = @game.join("   ")
+    assert_not player.persisted?
+    assert_includes player.errors.full_messages, "Name can't be blank"
+    assert_equal 0, @game.players_count
+  end
+
+  test "nobody joins after the end" do
+    play_to_last_question
+    @game.finish!
+    @game.end_quiz!
+    player = @game.join("Late")
+    assert_not player.persisted?
+    assert_equal 0, @game.players_count
+  end
+
+  test "a player answers the open question; the last pick counts" do
+    alice = @game.join("Alice")
+    @game.start!
+    first, second = @game.current_question.options.to_a
+
+    assert @game.answer!(alice, first)
+    assert @game.answer!(alice, second)
+    assert_equal 1, Answer.where(player: alice).count
+    assert_equal second, alice.answer_for(@game.current_question).game_option
+    assert_equal 1, @game.answers_count
+  end
+
+  test "answers are only accepted for the question on screen, while it is open" do
+    alice = @game.join("Alice")
+    @game.start!
+    option_of_question_one = @game.current_question.options.first
+    @game.finish!
+    assert_not @game.answer!(alice, option_of_question_one), "closed question"
+
+    @game.next_question!
+    assert_not @game.answer!(alice, option_of_question_one), "an option of an earlier question"
+    assert @game.answer!(alice, @game.current_question.options.first)
+  end
+
+  test "a player of another game cannot answer" do
+    stranger = Game.create_from_quiz!(@quiz).join("Stranger")
+    @game.start!
+    assert_not @game.answer!(stranger, @game.current_question.options.first)
+  end
+
+  test "nobody answers after the end" do
+    alice = @game.join("Alice")
+    play_to_last_question
+    @game.finish!
+    @game.end_quiz!
+    assert_not @game.answer!(alice, @game.game_questions.last.options.first)
+  end
+
+  test "the answer count only includes the question on screen" do
+    alice = @game.join("Alice")
+    bob = @game.join("Bob")
+    @game.start!
+    @game.answer!(alice, @game.current_question.options.first)
+    @game.answer!(bob, @game.current_question.options.last)
+    assert_equal 2, @game.answers_count
+    @game.finish!
+    @game.next_question!
+    assert_equal 0, @game.answers_count
+  end
+
+  test "deleting a quiz deletes its games, players and answers" do
+    alice = @game.join("Alice")
+    @game.start!
+    @game.answer!(alice, @game.current_question.options.first)
+
+    assert_difference({ "Game.count" => -1, "Player.count" => -1, "Answer.count" => -1, "GameQuestion.count" => -3, "GameOption.count" => -7 }) do
+      @quiz.destroy!
+    end
+  end
+
+  private
+
+  def play_to_last_question
+    @game.start!
+    @game.finish! and @game.next_question! while @game.position < @game.total_questions
+    @game.reload
+  end
+end
diff --git a/test/models/game_timer_test.rb b/test/models/game_timer_test.rb
new file mode 100644
index 0000000..c2d8426
--- /dev/null
+++ b/test/models/game_timer_test.rb
@@ -0,0 +1,195 @@
+require "test_helper"
+
+# The time per question: read from the quiz when a question opens, the countdown,
+# the question closing by itself, and answers refused after the deadline. Time is
+# travelled, so every number is exact.
+class GameTimerTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+  include GameFixtures
+
+  BASE = Time.zone.local(2026, 11, 25, 10, 0, 0)
+
+  setup do
+    @quiz = build_quiz_with_questions # three active questions
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    travel_to BASE - 600 do
+      @game = Game.create_from_quiz!(@quiz)
+    end
+  end
+
+  def start_at(time)
+    travel_to(time) { @game.start! }
+    @game.reload
+  end
+
+  def current_option(text)
+    @game.current_question.options.find_by!(text: text)
+  end
+
+  test "the time per question is read from the quiz when a question opens" do
+    start_at(BASE)
+    assert_equal 90, @game.game_questions.first.time_limit_seconds
+  end
+
+  test "a time set after the game was created applies, as long as no question has opened" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 5)
+    start_at(BASE)
+    assert_equal BASE + 5, @game.deadline
+  end
+
+  test "a change of the time applies to the next question, not to the one on screen" do
+    start_at(BASE)
+    travel_to(BASE + 10) { @quiz.update!(timer_minutes: 0, timer_seconds: 5) }
+    assert_equal BASE + 90, @game.reload.deadline, "the open question keeps its time"
+
+    travel_to(BASE + 20) { assert @game.finish! }
+    travel_to(BASE + 21) { assert @game.next_question! }
+    assert_equal BASE + 26, @game.reload.deadline, "the next question takes the new time"
+  end
+
+  test "without a timer a question never closes by itself" do
+    quiz = build_quiz_with_questions
+    game = Game.create_from_quiz!(quiz)
+    travel_to(BASE) { game.start! }
+    travel_to(BASE + 86_400) do
+      assert_nil game.reload.deadline
+      assert_nil game.seconds_left
+      assert_not game.finish_if_time_up!
+    end
+    assert game.reload.open?
+  end
+
+  test "the deadline is the moment the question opened plus the time per question" do
+    start_at(BASE)
+    assert_equal BASE + 90, @game.deadline
+    assert_equal 90, @game.seconds_left(BASE)
+  end
+
+  test "the seconds left round up, like a clock: 1:30 at the start, 0:00 at the end" do
+    start_at(BASE)
+    assert_equal 90, @game.seconds_left(BASE + 0.5)
+    assert_equal 89, @game.seconds_left(BASE + 1)
+    assert_equal 1, @game.seconds_left(BASE + 89.2)
+    assert_equal 0, @game.seconds_left(BASE + 90)
+    assert_equal 0, @game.seconds_left(BASE + 95)
+  end
+
+  test "there is no deadline outside an open question" do
+    assert_nil @game.deadline, "the lobby has no question"
+    start_at(BASE)
+    travel_to(BASE + 5) { @game.finish! }
+    assert_nil @game.reload.deadline, "a closed question has no countdown"
+  end
+
+  test "the question closes by itself at its deadline, as if Finish was clicked" do
+    start_at(BASE)
+    before = @game.progress
+
+    travel_to(BASE + 89.999) do
+      assert_not @game.finish_if_time_up!
+    end
+    assert @game.reload.open?
+
+    travel_to(BASE + 90) do
+      assert @game.finish_if_time_up!
+    end
+    @game.reload
+    assert @game.closed?
+    assert_equal 1, @game.position
+    assert_equal before + 1, @game.progress
+    assert_in_delta (BASE + 90).to_f, @game.game_questions.first.closed_at.to_f, 0.001
+  end
+
+  test "closing at the deadline happens once" do
+    start_at(BASE)
+    travel_to(BASE + 90) do
+      assert @game.finish_if_time_up!
+      assert_not @game.finish_if_time_up!
+      assert_not @game.finish!, "the question is already closed"
+    end
+    assert @game.reload.closed?
+  end
+
+  test "the moderator can still finish earlier, and the timer then does nothing" do
+    start_at(BASE)
+    travel_to(BASE + 10) { assert @game.finish! }
+    travel_to(BASE + 100) { assert_not @game.finish_if_time_up! }
+    assert_in_delta (BASE + 10).to_f, @game.reload.game_questions.first.closed_at.to_f, 0.001
+  end
+
+  test "a time-up close tells the big screen and the phones" do
+    start_at(BASE)
+    travel_to(BASE + 90) do
+      assert_broadcasts(@game.live_stream_name, 1) do
+        assert_broadcasts(@game.play_stream_name, 1) { @game.finish_if_time_up! }
+      end
+    end
+    travel_to(BASE + 91) do
+      assert_no_broadcasts(@game.live_stream_name) { @game.finish_if_time_up! }
+    end
+  end
+
+  test "a refused move still shows a question that the timer had closed" do
+    start_at(BASE)
+    travel_to(BASE + 90) do
+      assert_broadcasts(@game.play_stream_name, 1) do
+        assert_not @game.finish!, "the timer closed it first, so Finish has nothing to do"
+      end
+    end
+    assert @game.reload.closed?
+  end
+
+  test "an answer before the deadline counts, and its time is kept" do
+    start_at(BASE)
+    ann = @game.join("Ann")
+    travel_to(BASE + 89) { assert @game.answer!(ann, current_option("429")) }
+    assert_equal BASE + 89, ann.answers.first.picked_at
+    assert @game.reload.open?
+  end
+
+  test "an answer after the deadline is refused, even before anyone finished the question" do
+    start_at(BASE)
+    ann = @game.join("Ann")
+    travel_to(BASE + 89) { assert @game.answer!(ann, current_option("429")) }
+
+    travel_to(BASE + 90) do
+      assert_not @game.answer!(ann, current_option("418"))
+    end
+    assert @game.reload.closed?, "the answer after the deadline closed the question"
+    assert_equal "429", ann.answer_for(@game.game_questions.first).game_option.text
+  end
+
+  test "an answer exactly at the deadline is refused" do
+    start_at(BASE)
+    ann = @game.join("Ann")
+    travel_to(BASE + 90) { assert_not @game.answer!(ann, current_option("429")) }
+    assert_nil ann.answer_for(@game.game_questions.first)
+  end
+
+  test "the next question gets its own full time from when it opens" do
+    start_at(BASE)
+    travel_to(BASE + 90) { assert @game.finish_if_time_up! }
+    travel_to(BASE + 95) { assert @game.next_question! }
+    @game.reload
+    assert @game.open?
+    assert_equal 2, @game.position
+    assert_equal BASE + 95, @game.game_questions.second.opened_at
+    assert_equal BASE + 185, @game.deadline
+    assert_equal 90, @game.seconds_left(BASE + 95)
+  end
+
+  test "a question closed by the timer can be ended as a quiz" do
+    start_at(BASE)
+    travel_to(BASE + 90) { assert @game.end_quiz! }
+    assert @game.reload.ended?
+  end
+
+  test "reading the game again does not restart the clock" do
+    start_at(BASE)
+    travel_to(BASE + 30) do
+      again = Game.find(@game.id)
+      assert_equal BASE + 90, again.deadline
+      assert_equal 60, again.seconds_left
+    end
+  end
+end
diff --git a/test/models/leaderboard_test.rb b/test/models/leaderboard_test.rb
new file mode 100644
index 0000000..527b165
--- /dev/null
+++ b/test/models/leaderboard_test.rb
@@ -0,0 +1,157 @@
+require "test_helper"
+
+# The ranking and the winner rules, without the database.
+class LeaderboardTest < ActiveSupport::TestCase
+  Option = Struct.new(:correct, keyword_init: true) do
+    def correct? = correct
+  end
+  Question = Struct.new(:opened_at, keyword_init: true)
+  Pick = Struct.new(:game_option, :game_question, :picked_at, :updated_at, keyword_init: true)
+  Player = Struct.new(:id, :answers, keyword_init: true)
+  Entry = Struct.new(:id, :points, :place, keyword_init: true)
+
+  OPENED = Time.utc(2026, 11, 25, 10, 0, 0)
+
+  # One answer: correct or not, picked `seconds` after the question opened.
+  def pick(correct:, seconds:, opened: OPENED)
+    question = Question.new(opened_at: opened)
+    Pick.new(game_option: Option.new(correct: correct), game_question: question,
+             picked_at: opened + seconds, updated_at: opened + seconds)
+  end
+
+  def player(id, *picks)
+    Player.new(id: id, answers: picks)
+  end
+
+  def ranked_ids(players)
+    Leaderboard.rank(players).map { |standing| standing.player.id }
+  end
+
+  test "more points rank higher" do
+    standings = Leaderboard.rank([
+      player(1, pick(correct: true, seconds: 1)),
+      player(2, pick(correct: true, seconds: 1), pick(correct: true, seconds: 2)),
+      player(3)
+    ])
+    assert_equal [ 2, 1, 3 ], standings.map { |s| s.player.id }
+    assert_equal [ 2, 1, 0 ], standings.map(&:points)
+    assert_equal [ 1, 2, 3 ], standings.map(&:place)
+  end
+
+  test "equal points are ranked by the total time of the correct answers" do
+    slow = player(1, pick(correct: true, seconds: 5))
+    fast = player(2, pick(correct: true, seconds: 2))
+    assert_equal [ 2, 1 ], ranked_ids([ slow, fast ])
+    standings = Leaderboard.rank([ slow, fast ])
+    assert_equal 2_000_000, standings.first.speed_micros
+    assert_equal 5_000_000, standings.last.speed_micros
+  end
+
+  test "only correct answers count towards the speed" do
+    # 1 correct answer at 4 s; a wrong answer at 1 s must not make her faster.
+    wrong_fast = player(1, pick(correct: true, seconds: 4), pick(correct: false, seconds: 1, opened: OPENED + 10))
+    right_later = player(2, pick(correct: true, seconds: 3))
+    assert_equal [ 2, 1 ], ranked_ids([ wrong_fast, right_later ])
+  end
+
+  test "the time of an answer runs to the last pick, which is stored in picked_at" do
+    question = Question.new(opened_at: OPENED)
+    option = Option.new(correct: true)
+    # Picked at 1 s, then again at 6 s with the same option: updated_at did not move.
+    last_pick = Pick.new(game_option: option, game_question: question,
+                         picked_at: OPENED + 6, updated_at: OPENED + 1)
+    other = player(2, pick(correct: true, seconds: 3))
+    assert_equal [ 2, 1 ], ranked_ids([ player(1, last_pick), other ])
+    assert_equal 6_000_000, Leaderboard.rank([ player(1, last_pick) ]).first.speed_micros
+  end
+
+  test "the answer time is in whole microseconds" do
+    answer = pick(correct: true, seconds: 1.5)
+    assert_equal 1_500_000, Leaderboard.answer_micros(answer)
+  end
+
+  test "still tied, the player who joined first ranks first" do
+    a = player(7, pick(correct: true, seconds: 2))
+    b = player(3, pick(correct: true, seconds: 2))
+    assert_equal [ 3, 7 ], ranked_ids([ a, b ])
+  end
+
+  test "players without points come last, in order of joining" do
+    ranked = Leaderboard.rank([ player(5), player(2), player(9, pick(correct: false, seconds: 1)) ])
+    assert_equal [ 2, 5, 9 ], ranked.map { |s| s.player.id }
+    assert_equal [ 0, 0, 0 ], ranked.map(&:points)
+  end
+
+  test "top N is the first N places" do
+    ranked = [ Entry.new(id: 1, points: 5, place: 1), Entry.new(id: 2, points: 4, place: 2),
+               Entry.new(id: 3, points: 1, place: 3) ]
+    assert_equal [ 1, 2 ], Leaderboard.top(ranked, 2).map(&:id)
+  end
+
+  test "top N never gives a prize to a player without points" do
+    ranked = [ Entry.new(id: 1, points: 2, place: 1), Entry.new(id: 2, points: 0, place: 2),
+               Entry.new(id: 3, points: 0, place: 3) ]
+    assert_equal [ 1 ], Leaderboard.top(ranked, 3).map(&:id)
+    assert_equal [], Leaderboard.top([ Entry.new(id: 1, points: 0, place: 1) ], 3)
+  end
+
+  test "a draw gives every player above the N-th place a prize, and the rest at random among the tied" do
+    ranked = [ Entry.new(id: 1, points: 5, place: 1), Entry.new(id: 2, points: 4, place: 2),
+               Entry.new(id: 3, points: 3, place: 3), Entry.new(id: 4, points: 3, place: 4),
+               Entry.new(id: 5, points: 3, place: 5), Entry.new(id: 6, points: 2, place: 6) ]
+    seen = Set.new
+    200.times do |seed|
+      winners = Leaderboard.draw(ranked, 3, random: Random.new(seed)).map(&:id)
+      assert_equal 3, winners.size
+      assert_includes winners, 1
+      assert_includes winners, 2
+      seen << (winners - [ 1, 2 ]).first
+    end
+    assert_equal Set[3, 4, 5], seen, "every tied player can be drawn, and only they"
+  end
+
+  test "a draw ignores speed for the tied places: the slowest can win" do
+    # Same points: place order is speed order, but the draw does not use it.
+    ranked = [ Entry.new(id: 1, points: 3, place: 1), Entry.new(id: 2, points: 3, place: 2),
+               Entry.new(id: 3, points: 3, place: 3) ]
+    winners = (0..200).map { |seed| Leaderboard.draw(ranked, 1, random: Random.new(seed)).first.id }
+    assert_equal Set[1, 2, 3], winners.to_set
+  end
+
+  test "the N-th place decides the tie by its points, not by its position among ties" do
+    ranked = [ Entry.new(id: 1, points: 4, place: 1), Entry.new(id: 2, points: 3, place: 2),
+               Entry.new(id: 3, points: 3, place: 3), Entry.new(id: 4, points: 2, place: 4) ]
+    100.times do |seed|
+      winners = Leaderboard.draw(ranked, 2, random: Random.new(seed)).map(&:id)
+      assert_includes winners, 1
+      assert_equal 2, winners.size
+      assert_includes [ 2, 3 ], (winners - [ 1 ]).first
+    end
+  end
+
+  test "a draw with no tie gives exactly the top N" do
+    ranked = [ Entry.new(id: 1, points: 5, place: 1), Entry.new(id: 2, points: 4, place: 2),
+               Entry.new(id: 3, points: 1, place: 3) ]
+    assert_equal [ 1, 2 ], Leaderboard.draw(ranked, 2, random: Random.new(1)).map(&:id)
+  end
+
+  test "fewer players with points than N: all of them win, and nobody else" do
+    ranked = [ Entry.new(id: 1, points: 2, place: 1), Entry.new(id: 2, points: 1, place: 2),
+               Entry.new(id: 3, points: 0, place: 3) ]
+    assert_equal [ 1, 2 ], Leaderboard.draw(ranked, 3, random: Random.new(1)).map(&:id)
+    assert_equal [ 1, 2 ], Leaderboard.top(ranked, 3).map(&:id)
+  end
+
+  test "nobody has points: nobody wins a draw" do
+    ranked = [ Entry.new(id: 1, points: 0, place: 1), Entry.new(id: 2, points: 0, place: 2) ]
+    assert_equal [], Leaderboard.draw(ranked, 1, random: Random.new(1))
+    assert_equal [], Leaderboard.top(ranked, 1)
+  end
+
+  test "the draw draws again on each call" do
+    ranked = [ Entry.new(id: 1, points: 1, place: 1), Entry.new(id: 2, points: 1, place: 2),
+               Entry.new(id: 3, points: 1, place: 3), Entry.new(id: 4, points: 1, place: 4) ]
+    results = (0..40).map { Leaderboard.draw(ranked, 1).first.id }
+    assert_operator results.uniq.size, :>, 1
+  end
+end
diff --git a/test/models/question_test.rb b/test/models/question_test.rb
new file mode 100644
index 0000000..b55ece2
--- /dev/null
+++ b/test/models/question_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class QuestionTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Talk")
+  end
+
+  test "a question needs text" do
+    question = @quiz.questions.new(active: true)
+    question.option_rows = rows([ [ "A", true ], [ "B", false ] ])
+    assert_not question.save
+    assert_includes question.errors.full_messages, "Question can't be blank"
+  end
+
+  test "a question needs at least two options" do
+    question = build_question(rows([ [ "Only", true ] ]))
+    assert_not question.save
+    assert_equal [ "Add at least two options" ], question.errors.full_messages
+  end
+
+  test "at least one option must be correct" do
+    question = build_question(rows([ [ "A", false ], [ "B", false ] ]))
+    assert_not question.save
+    assert_equal [ "Mark at least one option as correct" ], question.errors.full_messages
+  end
+
+  test "both rules are reported together" do
+    question = build_question(rows([ [ "A", false ] ]))
+    assert_not question.save
+    assert_equal [ "Add at least two options", "Mark at least one option as correct" ], question.errors.full_messages
+  end
+
+  test "blank rows are skipped, including ones marked correct" do
+    question = build_question(rows([ [ "", true ], [ "  ", false ], [ "A", true ], [ "", false ], [ "B", false ] ]))
+    assert question.save, question.errors.full_messages.inspect
+    assert_equal %w[A B], question.options.map(&:text)
+    assert_equal [ true, false ], question.options.map(&:correct)
+    assert_equal [ 1, 2 ], question.options.map(&:position)
+  end
+
+  test "several correct options are fine" do
+    question = build_question(rows([ [ "A", true ], [ "B", true ] ]))
+    assert question.save
+    assert_equal 2, question.options.count(&:correct)
+  end
+
+  test "a rule failure saves nothing and keeps the typed rows" do
+    question = build_question(rows([ [ "Keep me", true ], [ "", false ] ]))
+    assert_no_difference [ "Question.count", "Option.count" ] do
+      assert_not question.save
+    end
+    assert_equal [ "Keep me", "" ], question.form_option_rows.first(2).map { |row| row[:text] }
+  end
+
+  test "editing replaces the options in one go" do
+    question = build_question(rows([ [ "A", true ], [ "B", false ] ]))
+    question.save!
+
+    question = Question.find(question.id)
+    question.option_rows = rows([ [ "X", false ], [ "Y", true ], [ "Z", false ] ])
+    assert question.save
+    assert_equal %w[X Y Z], question.reload.options.map(&:text)
+    assert_equal 3, Option.where(question_id: question.id).count
+  end
+
+  test "a failed edit leaves the saved options alone" do
+    question = build_question(rows([ [ "A", true ], [ "B", false ] ]))
+    question.save!
+
+    question = Question.find(question.id)
+    question.option_rows = rows([ [ "X", false ] ])
+    assert_not question.save
+    assert_equal %w[A B], question.reload.options.map(&:text)
+  end
+
+  test "form rows are padded to four" do
+    question = @quiz.questions.new
+    assert_equal 4, question.form_option_rows.size
+    assert question.form_option_rows.all? { |row| row[:text] == "" && row[:correct] == false }
+  end
+
+  test "new questions go to the end and are active by default" do
+    first = build_question(rows([ [ "A", true ], [ "B", false ] ])).tap(&:save!)
+    second = build_question(rows([ [ "A", true ], [ "B", false ] ])).tap(&:save!)
+    assert second.position > first.position
+    assert second.active?
+  end
+
+  test "move up and move down swap neighbours and keep the edges" do
+    a = make_question("a")
+    b = make_question("b")
+    c = make_question("c")
+
+    b.move_up
+    assert_equal %w[b a c], ordered_texts
+
+    b.move_down
+    assert_equal %w[a b c], ordered_texts
+
+    a.move_up
+    assert_equal %w[a b c], ordered_texts
+    c.move_down
+    assert_equal %w[a b c], ordered_texts
+
+    c.move_up
+    assert_equal %w[a c b], ordered_texts
+  end
+
+  test "inactive questions keep their place in the order" do
+    a = make_question("a")
+    b = make_question("b", active: false)
+    c = make_question("c")
+    a.move_down
+    assert_equal %w[b a c], ordered_texts
+    assert_not b.reload.active?
+    assert_equal [ "a", "c" ], @quiz.questions.active.map(&:text)
+    assert_equal [ c.id ], @quiz.questions.active.where(text: "c").pluck(:id)
+  end
+
+  private
+
+  def rows(pairs)
+    pairs.map { |text, correct| { text: text, correct: correct } }
+  end
+
+  def build_question(option_rows, active: true)
+    question = @quiz.questions.new(text: "Question?", active: active)
+    question.option_rows = option_rows
+    question
+  end
+
+  def make_question(text, active: true)
+    question = build_question(rows([ [ "A", true ], [ "B", false ] ]), active: active)
+    question.text = text
+    question.save!
+    question
+  end
+
+  def ordered_texts
+    @quiz.questions.reload.map(&:text)
+  end
+end
diff --git a/test/models/quiz_export_test.rb b/test/models/quiz_export_test.rb
new file mode 100644
index 0000000..db000de
--- /dev/null
+++ b/test/models/quiz_export_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class QuizExportTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+  end
+
+  test "writes the title and the questions with their options, in order" do
+    add_question("Second", [ [ "B", true ], [ "C", false ] ])
+    add_question("First", [ [ "A", false ], [ "D", true ] ], active: false)
+
+    data = QuizExport.new(@quiz.reload).to_h
+
+    assert_equal "Frontend Fest 2026", data[:title]
+    assert_equal %w[Second First], data[:questions].map { |question| question[:text] }
+    assert_equal [ true, false ], data[:questions].map { |question| question[:active] }
+    assert_equal [ { text: "B", correct: true }, { text: "C", correct: false } ], data[:questions].first[:options]
+  end
+
+  test "writes exactly the keys of the format and nothing else" do
+    add_question("Q", [ [ "A", true ], [ "B", false ] ])
+
+    data = JSON.parse(QuizExport.new(@quiz.reload).pretty_json)
+
+    assert_equal %w[questions title], data.keys.sort
+    assert_equal %w[active options text], data["questions"].first.keys.sort
+    assert_equal %w[correct text], data["questions"].first["options"].first.keys.sort
+  end
+
+  test "an empty quiz exports an empty list" do
+    assert_equal({ title: "Frontend Fest 2026", questions: [] }, QuizExport.new(@quiz).to_h)
+  end
+
+  test "the pretty JSON is valid and matches the hash" do
+    add_question("Q \"quoted\" <b>", [ [ "A", true ], [ "B", false ] ])
+    json = QuizExport.new(@quiz.reload).pretty_json
+
+    assert_includes json, "\n  \"title\": \"Frontend Fest 2026\""
+    assert_equal QuizExport.new(@quiz.reload).to_h.deep_stringify_keys, JSON.parse(json)
+  end
+
+  private
+
+  def add_question(text, rows, active: true)
+    question = @quiz.questions.new(text: text, active: active)
+    question.option_rows = rows.map { |option_text, correct| { text: option_text, correct: correct } }
+    question.save!
+    question
+  end
+end
+
+# The timer is a setting of this Quizzy, so it is not part of the export format.
+class QuizExportTimerTest < ActiveSupport::TestCase
+  test "the export leaves the timer out, and an import gets no timer" do
+    quiz = Quiz.create!(title: "Timed talk", timer_minutes: 1, timer_seconds: 30, winners_count: 5)
+    question = quiz.questions.new(text: "Q")
+    question.option_rows = [ { text: "A", correct: true }, { text: "B", correct: false } ]
+    question.save!
+
+    json = JSON.parse(QuizExport.new(quiz.reload).pretty_json)
+    assert_equal %w[questions title], json.keys.sort
+    assert_no_match(/timer|time_limit|winners/i, QuizExport.new(quiz).pretty_json)
+
+    imported = QuizImport.new(json: QuizExport.new(quiz).pretty_json)
+    assert imported.save, imported.errors.full_messages.inspect
+    assert_equal [ 0, 0 ], [ imported.quiz.timer_minutes, imported.quiz.timer_seconds ]
+  end
+end
diff --git a/test/models/quiz_import_test.rb b/test/models/quiz_import_test.rb
new file mode 100644
index 0000000..07788a3
--- /dev/null
+++ b/test/models/quiz_import_test.rb
@@ -0,0 +1,262 @@
+require "test_helper"
+
+class QuizImportTest < ActiveSupport::TestCase
+  HTTP_JSON = <<~JSON.freeze
+    {
+      "title": "Frontend Fest 2026",
+      "questions": [
+        {
+          "text": "Which HTTP status code means \\"Too Many Requests\\"?",
+          "active": true,
+          "options": [
+            {"text": "418", "correct": false},
+            {"text": "429", "correct": true}
+          ]
+        }
+      ]
+    }
+  JSON
+
+  def import(json)
+    QuizImport.new(json: json)
+  end
+
+  # Imports and asserts success; returns the new quiz.
+  def imported(json)
+    importer = import(json)
+    assert importer.save, importer.errors.full_messages.inspect
+    importer.quiz
+  end
+
+  def assert_refused(json, *messages)
+    importer = import(json)
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      assert_not importer.save, "expected a refusal"
+    end
+    assert_nil importer.quiz
+    messages.each do |message|
+      assert_includes importer.errors.full_messages, message
+    end
+  end
+
+  def document(questions: nil, title: "Talk", **extra)
+    { "title" => title, "questions" => questions || [ question_hash ] }.merge(extra).to_json
+  end
+
+  def question_hash(text: "Q?", options: nil, **extra)
+    { "text" => text, "options" => options || [ { "text" => "A", "correct" => true }, { "text" => "B", "correct" => false } ] }.merge(extra.stringify_keys)
+  end
+
+  test "imports the format from the issue, keeping the order" do
+    importer = import(HTTP_JSON)
+
+    assert_difference "Quiz.count", 1 do
+      assert importer.save, importer.errors.full_messages.inspect
+    end
+
+    quiz = importer.quiz
+    assert_equal "Frontend Fest 2026", quiz.title
+    assert_equal [ 'Which HTTP status code means "Too Many Requests"?' ], quiz.questions.map(&:text)
+    assert quiz.questions.first.active?
+    assert_equal [ "418", "429" ], quiz.questions.first.options.map(&:text)
+    assert_equal [ false, true ], quiz.questions.first.options.map(&:correct)
+  end
+
+  test "keeps the order of questions and options" do
+    json = document(questions: [
+      question_hash(text: "first", options: [ { "text" => "z", "correct" => false }, { "text" => "a", "correct" => true } ]),
+      question_hash(text: "second")
+    ])
+    quiz = imported(json)
+
+    assert_equal %w[first second], quiz.questions.map(&:text)
+    assert_equal %w[z a], quiz.questions.first.options.map(&:text)
+    assert_equal [ 1, 2 ], quiz.questions.map(&:position)
+  end
+
+  test "active defaults to true and correct defaults to false" do
+    json = document(questions: [ { "text" => "Q", "options" => [ { "text" => "A" }, { "text" => "B", "correct" => true } ] } ])
+    quiz = imported(json)
+
+    assert quiz.questions.first.active?
+    assert_equal [ false, true ], quiz.questions.first.options.map(&:correct)
+  end
+
+  test "active false keeps the question inactive" do
+    json = document(questions: [ question_hash(active: false) ])
+    quiz = imported(json)
+    assert_not quiz.questions.first.active?
+  end
+
+  test "an import always creates a new quiz, even when the title exists" do
+    existing = Quiz.create!(title: "Frontend Fest 2026")
+
+    importer = import(HTTP_JSON)
+    assert_difference "Quiz.count", 1 do
+      assert importer.save, importer.errors.full_messages.inspect
+    end
+    assert_not_equal existing.id, importer.quiz.id
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+  end
+
+  test "text and title are trimmed like the forms do" do
+    json = document(title: "  Padded  ", questions: [ question_hash(text: "  Q  ", options: [ { "text" => " A ", "correct" => true }, { "text" => "B" } ]) ])
+    quiz = imported(json)
+
+    assert_equal "Padded", quiz.title
+    assert_equal "Q", quiz.questions.first.text
+    assert_equal "A", quiz.questions.first.options.first.text
+  end
+
+  test "a quiz without questions can be imported" do
+    quiz = imported(document(questions: []))
+    assert_equal 0, quiz.questions.count
+  end
+
+  test "blank option rows are skipped, like in the question form" do
+    json = document(questions: [ question_hash(options: [
+      { "text" => "", "correct" => true }, { "text" => "  " }, { "text" => "A", "correct" => true }, { "text" => "B" }, { "correct" => true }
+    ]) ])
+    quiz = imported(json)
+    assert_equal %w[A B], quiz.questions.first.options.map(&:text)
+  end
+
+  test "several correct options are fine" do
+    json = document(questions: [ question_hash(options: [ { "text" => "A", "correct" => true }, { "text" => "B", "correct" => true } ]) ])
+    assert import(json).save
+  end
+
+  test "invalid JSON imports nothing" do
+    assert_refused "{ \"title\": ", "Quiz JSON is not valid JSON"
+  end
+
+  test "blank input imports nothing" do
+    assert_refused "  ", "Quiz JSON can't be blank"
+    assert_refused nil, "Quiz JSON can't be blank"
+  end
+
+  test "a document that is not an object imports nothing" do
+    assert_refused "[]", "Quiz JSON must be an object with \"title\" and \"questions\""
+    assert_refused "null", "Quiz JSON must be an object with \"title\" and \"questions\""
+  end
+
+  test "a title is required" do
+    assert_refused document(title: "  "), "Title can't be blank"
+    assert_refused({ "questions" => [] }.to_json, "Title can't be blank")
+  end
+
+  test "a title must be text and at most 200 characters" do
+    assert_refused document(title: 42), "Title must be a string"
+    assert_refused document(title: "x" * 201), "Title is too long (maximum is 200 characters)"
+  end
+
+  test "questions must be a list" do
+    assert_refused({ "title" => "Talk" }.to_json, "Questions must be a list")
+    assert_refused document(questions: "nope"), "Questions must be a list"
+  end
+
+  test "a question must be an object" do
+    assert_refused document(questions: [ "text" ]), "Question 1 must be an object"
+  end
+
+  test "a question needs text" do
+    assert_refused document(questions: [ question_hash(text: " ") ]), "Question 1: Question can't be blank"
+    assert_refused document(questions: [ { "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] } ]),
+                   "Question 1: Question can't be blank"
+  end
+
+  test "question text must be a string" do
+    assert_refused document(questions: [ question_hash(text: 5) ]), "Question 1: Question must be a string"
+  end
+
+  test "active must be true or false" do
+    assert_refused document(questions: [ question_hash(active: "yes") ]), "Question 1: Active must be true or false"
+    assert_refused document(questions: [ question_hash(active: 0) ]), "Question 1: Active must be true or false"
+  end
+
+  test "a question needs at least two options" do
+    assert_refused document(questions: [ question_hash(options: [ { "text" => "Only", "correct" => true } ]) ]),
+                   "Question 1: Add at least two options"
+    assert_refused document(questions: [ question_hash(options: [ { "text" => "A", "correct" => true }, { "text" => "" } ]) ]),
+                   "Question 1: Add at least two options"
+  end
+
+  test "a question needs one correct option" do
+    assert_refused document(questions: [ question_hash(options: [ { "text" => "A" }, { "text" => "B", "correct" => false } ]) ]),
+                   "Question 1: Mark at least one option as correct"
+  end
+
+  test "a blank option marked correct does not count" do
+    assert_refused document(questions: [ question_hash(options: [ { "text" => "A" }, { "text" => " ", "correct" => true } ]) ]),
+                   "Question 1: Mark at least one option as correct"
+  end
+
+  test "both option rules are reported together" do
+    assert_refused document(questions: [ question_hash(options: [ { "text" => "A" } ]) ]),
+                   "Question 1: Add at least two options",
+                   "Question 1: Mark at least one option as correct"
+  end
+
+  test "options must be a list of objects with text and a boolean correct" do
+    assert_refused document(questions: [ question_hash(options: "A, B") ]), "Question 1: Options must be a list"
+    assert_refused document(questions: [ question_hash(options: [ { "text" => "A", "correct" => true }, "B" ]) ]),
+                   "Question 1, option 2 must be an object"
+    assert_refused document(questions: [ question_hash(options: [ { "text" => "A", "correct" => "true" }, { "text" => "B" } ]) ]),
+                   "Question 1, option 1: Correct must be true or false"
+    assert_refused document(questions: [ question_hash(options: [ { "text" => 418, "correct" => true }, { "text" => "B" } ]) ]),
+                   "Question 1, option 1: Option text must be a string"
+  end
+
+  test "a bad question anywhere means nothing is imported, not even the good questions" do
+    json = document(questions: [
+      question_hash(text: "Good one"),
+      question_hash(text: "Bad one", options: [ { "text" => "A" }, { "text" => "B" } ])
+    ])
+    assert_refused json, "Question 2: Mark at least one option as correct"
+    assert_equal 0, Quiz.where(title: "Talk").count
+  end
+
+  test "errors name the question they belong to" do
+    json = document(questions: [ question_hash, question_hash(text: "", options: []) ])
+    importer = import(json)
+    assert_not importer.save
+    assert_includes importer.errors.full_messages, "Question 2: Question can't be blank"
+    assert_includes importer.errors.full_messages, "Question 2: Add at least two options"
+    assert_not_includes importer.errors.full_messages.join, "Question 1"
+  end
+
+  test "unknown keys are ignored" do
+    json = { "id" => 99, "title" => "Talk", "exported_at" => "now",
+             "questions" => [ { "text" => "Q", "position" => 7, "options" => [ { "text" => "A", "correct" => true, "id" => 3 }, { "text" => "B" } ] } ] }.to_json
+    assert import(json).save
+  end
+
+test "round trip keeps quotes, line breaks, unicode and markup in the text" do
+  source = Quiz.create!(title: "Größe & \"Ränge\" <3")
+  question = source.questions.new(text: "Line one\nLine two \"q\" ✓ <b>bold</b>", active: true)
+  question.option_rows = [ { text: "<script>x</script>", correct: true }, { text: "naïve 🙂", correct: false } ]
+  question.save!
+
+  copy = imported(QuizExport.new(source.reload).pretty_json)
+
+  assert_equal "Größe & \"Ränge\" <3", copy.title
+  assert_equal "Line one\nLine two \"q\" ✓ <b>bold</b>", copy.questions.first.text
+  assert_equal [ "<script>x</script>", "naïve 🙂" ], copy.questions.first.options.map(&:text)
+end
+
+  test "round trip: exporting and importing again gives the same quiz" do
+    source = Quiz.create!(title: "Source")
+    first = source.questions.new(text: "First", active: false)
+    first.option_rows = [ { text: "x", correct: false }, { text: "y", correct: true } ]
+    first.save!
+    second = source.questions.new(text: "Second", active: true)
+    second.option_rows = [ { text: "p", correct: true }, { text: "q", correct: true } ]
+    second.save!
+
+    copy = imported(QuizExport.new(source.reload).pretty_json)
+
+    assert_equal "Source", copy.title
+    assert_not_equal source.id, copy.id
+    assert_equal QuizExport.new(source.reload).to_h, QuizExport.new(copy.reload).to_h
+  end
+end
diff --git a/test/models/quiz_preview_test.rb b/test/models/quiz_preview_test.rb
new file mode 100644
index 0000000..b9f4bb5
--- /dev/null
+++ b/test/models/quiz_preview_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class QuizPreviewTest < ActiveSupport::TestCase
+  setup do
+    quiz = Quiz.create!(title: "Talk")
+    @questions = 3.times.map do |i|
+      question = quiz.questions.new(text: "Q#{i + 1}", active: true)
+      question.option_rows = [ { text: "right", correct: true }, { text: "wrong", correct: false } ]
+      question.save!
+      question
+    end
+  end
+
+  test "starts at the first question" do
+    preview = QuizPreview.new(@questions)
+    assert_equal "Q1", preview.current_question.text
+    assert_equal 0, preview.answered
+    assert_not preview.revealed?
+    assert_not preview.finished?
+  end
+
+  test "a pick reveals the answer and carries the result forward" do
+    right = @questions.first.options.find_by!(text: "right")
+    preview = QuizPreview.new(@questions, pick: right.id)
+    assert preview.revealed?
+    assert preview.correct_pick?
+    assert_equal "1", preview.results_with_answer
+  end
+
+  test "results count answered questions and score the right ones" do
+    preview = QuizPreview.new(@questions, results: "101")
+    assert preview.finished?
+    assert_equal 2, preview.score
+    assert_nil preview.current_question
+  end
+
+  test "garbage in the results is ignored" do
+    preview = QuizPreview.new(@questions, results: "x1y0z9")
+    assert_equal "10", preview.results
+    assert_equal "Q3", preview.current_question.text
+  end
+
+  test "an unknown or foreign pick is not an answer" do
+    other = Quiz.create!(title: "Other")
+    question = other.questions.new(text: "Foreign", active: true)
+    question.option_rows = [ { text: "a", correct: true }, { text: "b", correct: false } ]
+    question.save!
+    foreign = question.options.first
+
+    assert_not QuizPreview.new(@questions, pick: foreign.id).revealed?
+    assert_not QuizPreview.new(@questions, pick: "nope").revealed?
+  end
+
+  test "an empty quiz has nothing to play" do
+    preview = QuizPreview.new([])
+    assert preview.empty?
+    assert_not preview.finished?
+    assert_nil preview.current_question
+  end
+end
diff --git a/test/models/quiz_test.rb b/test/models/quiz_test.rb
new file mode 100644
index 0000000..239364d
--- /dev/null
+++ b/test/models/quiz_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class QuizTest < ActiveSupport::TestCase
+  test "a quiz has 3 winners by default" do
+    assert_equal 3, Quiz.new(title: "Talk").winners_count
+  end
+
+  test "the number of winners is a whole number from 1 to 1000" do
+    quiz = Quiz.new(title: "Talk")
+    [ 1, 2, 1000 ].each do |count|
+      quiz.winners_count = count
+      assert quiz.valid?, "#{count} should be allowed"
+    end
+    [ 0, -1, 1001, 99_999_999_999, 2.5, nil ].each do |count|
+      quiz.winners_count = count
+      assert_not quiz.valid?, "#{count.inspect} should be refused"
+      assert_predicate quiz.errors[:winners_count], :any?
+    end
+  end
+
+  test "the error names the field the way the form labels it" do
+    quiz = Quiz.new(title: "Talk", winners_count: 0)
+    quiz.valid?
+    assert_equal [ "Number of winners must be greater than or equal to 1" ], quiz.errors.full_messages
+  end
+end
+
+# The time per question: "Timer minutes" and "Timer seconds", 0 and 0 for no timer.
+class QuizTimerTest < ActiveSupport::TestCase
+  test "a quiz has no timer by default: 0 minutes and 0 seconds" do
+    quiz = Quiz.create!(title: "Talk")
+    assert_equal [ 0, 0 ], [ quiz.timer_minutes, quiz.timer_seconds ]
+    assert_equal 0, quiz.time_limit_seconds
+  end
+
+  test "the time per question in seconds is minutes times 60 plus seconds" do
+    quiz = Quiz.new(title: "Talk", timer_minutes: 1, timer_seconds: 30)
+    assert_equal 90, quiz.time_limit_seconds
+    quiz.timer_minutes = 0
+    quiz.timer_seconds = 5
+    assert_equal 5, quiz.time_limit_seconds
+  end
+
+  test "minutes are whole numbers from 0 to 99, seconds from 0 to 59" do
+    quiz = Quiz.new(title: "Talk")
+    [ [ 0, 0 ], [ 99, 59 ], [ 1, 30 ] ].each do |minutes, seconds|
+      quiz.timer_minutes = minutes
+      quiz.timer_seconds = seconds
+      assert quiz.valid?, "#{minutes}:#{seconds} should be allowed"
+    end
+
+    [ [ -1, 0 ], [ 100, 0 ], [ 1.5, 0 ], [ nil, 0 ] ].each do |minutes, seconds|
+      quiz.timer_minutes = minutes
+      quiz.timer_seconds = seconds
+      assert_not quiz.valid?, "minutes #{minutes.inspect} should be refused"
+      assert_predicate quiz.errors[:timer_minutes], :any?
+    end
+
+    [ [ 0, -1 ], [ 0, 60 ], [ 0, 2.5 ], [ 0, nil ] ].each do |minutes, seconds|
+      quiz.timer_minutes = minutes
+      quiz.timer_seconds = seconds
+      assert_not quiz.valid?, "seconds #{seconds.inspect} should be refused"
+      assert_predicate quiz.errors[:timer_seconds], :any?
+    end
+  end
+
+  test "the errors name the fields the way the form labels them" do
+    quiz = Quiz.new(title: "Talk", timer_seconds: 75)
+    quiz.valid?
+    assert_equal [ "Timer seconds must be less than or equal to 59" ], quiz.errors.full_messages
+  end
+end
