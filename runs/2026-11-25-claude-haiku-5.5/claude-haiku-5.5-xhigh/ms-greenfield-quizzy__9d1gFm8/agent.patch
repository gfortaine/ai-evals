+<% content_for :title, @quiz.title %>
+
+<% active_count = @questions.count(&:active?) %>
+
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<div class="page-head">
+  <div>
+    <h1><%= @quiz.title %></h1>
+    <div class="meta mt-2">
+      <% if @questions.empty? %>
+        No questions yet
+      <% else %>
+        <%= active_count %> of <%= @questions.size %> questions active
+      <% end %>
+      · <%= @quiz.time_limit_seconds.zero? ? "No timer" : "#{countdown_text(@quiz.time_limit_seconds)} per question" %>
+      · <%= link_to "Settings", edit_moderate_quiz_path(@quiz) %>
+    </div>
+  </div>
+  <div class="buttons">
+    <%= link_to "Preview", preview_moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+    <%= link_to "Export", export_moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+  </div>
+</div>
+
+<section class="section mt-0">
+  <div class="section-head">
+    <h2>Questions</h2>
+    <%= button_to "Add question", new_moderate_quiz_question_path(@quiz), method: :get, class: "btn" %>
+  </div>
+
+  <% if @questions.empty? %>
+    <p class="empty">No questions yet. Add the first one.</p>
+  <% else %>
+    <ol class="question-list">
+      <% number = 0 %>
+      <% @questions.each_with_index do |question, index| %>
+        <% number += 1 if question.active? %>
+        <%= render "moderate/questions/question",
+              quiz: @quiz,
+              question: question,
+              number: (question.active? ? number : nil),
+              first: index.zero?,
+              last: index == @questions.size - 1 %>
+      <% end %>
+    </ol>
+  <% end %>
+</section>
+
+<section class="section">
+  <div class="section-head">
+    <h2>Games</h2>
+    <%= button_to "Start a game", moderate_quiz_games_path(@quiz), class: "btn btn--pink" %>
+  </div>
+
+  <% if @games.empty? %>
+    <p class="empty">No games yet. A game is one play of this quiz, with its own join link and players.</p>
+  <% else %>
+    <table class="runs-table">
+      <thead>
+        <tr>
+          <th>Started</th>
+          <th>Status</th>
+          <th>Players</th>
+          <th><span class="visually-hidden">Actions</span></th>
+        </tr>
+      </thead>
+      <tbody>
+        <% @games.each do |game| %>
+          <tr>
+            <td><%= game.created_at.strftime("%b %-d, %H:%M") %></td>
+            <td><span class="badge <%= game_badge_class(game) %>"><%= game_status_label(game) %></span></td>
+            <td><%= game.players.size %></td>
+            <td><%= link_to "Open", moderate_game_path(game) %></td>
+          </tr>
+        <% end %>
+      </tbody>
+    </table>
+  <% end %>
+</section>
diff --git a/app/views/play/_state.html.erb b/app/views/play/_state.html.erb
new file mode 100644
index 0000000..cd41cbb
--- /dev/null
+++ b/app/views/play/_state.html.erb
@@ -0,0 +1,79 @@
+<%# What a phone shows, by what the player and the game are doing. Nothing here
+    reveals a correct option before its question is closed, and the place and the
+    points appear only once the quiz is over. %>
+<div class="play__top">
+  <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+  <% if player %><span>Hi, <%= player.name %>!</span><% end %>
+</div>
+
+<div class="play__body play__body--top">
+  <% if game.ended? %>
+    <h1 class="play-title">The quiz is over</h1>
+    <p class="play-lead">Thank you for playing.</p>
+
+    <% if player %>
+      <div class="result-card">
+        <p class="result-card__label">Place <%= player.place %> of <%= game.players_count %></p>
+        <p class="result-card__score"><%= pluralize(player.points, "point") %></p>
+      </div>
+      <% if player.winner? %>
+        <div class="winner-banner" role="status">You won!</div>
+      <% end %>
+    <% end %>
+
+  <% elsif player.nil? %>
+    <h1 class="play-title"><%= game.title %></h1>
+    <p class="play-lead">Join with your name to play along.</p>
+
+    <%= form_with url: play_join_path(game.code), scope: :player, class: "join-form", html: { novalidate: true } do |f| %>
+      <%= f.label :name, "Your name", class: "field-label" %>
+      <%= f.text_field :name, value: name, class: "input", maxlength: Player::NAME_LENGTH, autocomplete: "off", spellcheck: "false" %>
+      <%= f.button "Join", class: "btn btn--pink" %>
+    <% end %>
+
+  <% elsif game.lobby? %>
+    <div class="waiting">
+      <div class="waiting__gem" aria-hidden="true">★</div>
+      <h1 class="play-title">You're in</h1>
+      <p class="play-lead">Waiting for the quiz to start…</p>
+    </div>
+
+  <% else %>
+    <% question = game.current_question %>
+    <% answer = game.answer_of(player) %>
+    <% picked_id = answer&.game_option_id %>
+
+    <div class="play-question__num">Question <%= game.position %> of <%= game.total_questions %></div>
+    <div class="play-question__body"><%= question.text %></div>
+
+    <% if game.open? %>
+      <p class="field-hint">Tap an option to answer. You can change it until the question is closed.</p>
+
+      <div class="play-options">
+        <% question.options.each_with_index do |option, index| %>
+          <%= button_to play_answer_path(game.code), params: { game_option_id: option.id },
+                class: "play-option#{' is-picked' if option.id == picked_id}" do %>
+            <span class="play-option__letter"><%= option_letter(index) %></span>
+            <span class="play-option__title"><%= option.text %></span>
+            <% if option.id == picked_id %><span class="play-option__mark">Your answer</span><% end %>
+          <% end %>
+        <% end %>
+      </div>
+
+    <% else %>
+      <div class="play-options is-locked is-revealed">
+        <% question.options.each_with_index do |option, index| %>
+          <div class="play-option<%= ' is-correct' if option.correct? %><%= ' is-picked' if option.id == picked_id %>">
+            <span class="play-option__letter"><%= option_letter(index) %></span>
+            <span class="play-option__title"><%= option.text %></span>
+            <% if option.id == picked_id %><span class="play-option__mark">Your answer</span><% end %>
+          </div>
+        <% end %>
+      </div>
+
+      <% label, tone = answer_result(answer) %>
+      <div class="play-status play-status--<%= tone %>" role="status"><%= label %></div>
+      <p class="play-lead mt-2"><%= game.last_question? ? "Waiting for the end of the quiz…" : "Waiting for the next question…" %></p>
+    <% end %>
+  <% end %>
+</div>
