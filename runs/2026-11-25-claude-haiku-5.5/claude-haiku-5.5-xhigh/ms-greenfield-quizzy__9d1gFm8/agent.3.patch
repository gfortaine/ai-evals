diff --git a/app/views/moderate/games/_screen.html.erb b/app/views/moderate/games/_screen.html.erb
new file mode 100644
index 0000000..79464c9
--- /dev/null
+++ b/app/views/moderate/games/_screen.html.erb
@@ -0,0 +1,85 @@
+<%# The big screen, in the phase the game is in. Everything shown here is for the room:
+    the correct options appear only once their question is closed. %>
+<section class="cover <%= screen_cover_class(game) %>">
+  <div class="screen">
+    <div class="screen__top">
+      <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <% unless game.lobby? %><span><%= game.title %></span><% end %>
+    </div>
+
+    <div class="screen__body">
+      <% if game.lobby? %>
+        <div class="lobby">
+          <div>
+            <h1 class="lobby__title"><%= game.title %></h1>
+            <p class="lobby__join">Join at</p>
+            <p class="lobby__url"><%= join_link_text(game) %></p>
+            <div class="counter-pill"><span>Players: <strong><%= game.players_count %></strong></span></div>
+          </div>
+          <div class="qr" role="img" aria-label="QR code for the join link"><%= join_qr_code(game) %></div>
+        </div>
+
+      <% elsif game.ended? %>
+        <h1 class="screen__ended">The quiz is over</h1>
+        <p class="screen__kicker">Thank you for playing.</p>
+
+      <% else %>
+        <% question = game.current_question %>
+        <% counts = game.closed? ? question.answer_counts : {} %>
+        <% total = counts.values.sum %>
+
+        <div class="stage-question__num">Question <%= game.position %> of <%= game.total_questions %></div>
+        <div class="stage-question__body"><%= question.text %></div>
+
+        <ol class="stage-options<%= " stage-options--results" if game.closed? %>">
+          <% question.options.each_with_index do |option, index| %>
+            <% count = counts.fetch(option.id, 0) %>
+            <% if game.closed? %>
+              <li class="stage-option<%= " is-correct" if option.correct? %>" style="--share: <%= answer_share(count, total) %>%">
+                <span class="stage-option__letter"><%= option_letter(index) %></span>
+                <span class="stage-option__title"><%= option.text %></span>
+                <% if option.correct? %><span class="stage-option__mark">Correct</span><% end %>
+                <span class="stage-option__count"><%= pluralize(count, "answer") %></span>
+                <span class="stage-option__bar" aria-hidden="true"></span>
+              </li>
+            <% else %>
+              <li class="stage-option">
+                <span class="stage-option__letter"><%= option_letter(index) %></span>
+                <span class="stage-option__title"><%= option.text %></span>
+              </li>
+            <% end %>
+          <% end %>
+        </ol>
+
+        <div class="counter-pill answers-counter"><span>Answers: <strong><%= game.answers_count %></strong> / <%= game.players_count %></span></div>
+      <% end %>
+    </div>
+  </div>
+</section>
+
+<div class="screen-controls">
+  <div class="screen-controls__info">
+    <%= link_to "← Back to the quiz", moderate_quiz_path(game.quiz) %>
+    <% if game.open? || game.closed? %>
+      <span>Join at <%= join_link_text(game) %></span>
+    <% end %>
+    <% if game.lobby? && game.total_questions.zero? %>
+      <span>This quiz has no active questions yet.</span>
+    <% end %>
+  </div>
+
+  <div class="buttons">
+    <% if game.lobby? %>
+      <%= button_to "Start", start_moderate_game_path(game), class: "btn btn--pink btn--lg", disabled: game.total_questions.zero? %>
+      <% if game.total_questions.zero? %>
+        <%= button_to "End quiz", end_quiz_moderate_game_path(game), class: "btn btn--lg" %>
+      <% end %>
+    <% elsif game.open? %>
+      <%= button_to "Finish", finish_moderate_game_path(game), class: "btn btn--pink btn--lg" %>
+    <% elsif game.closed? && game.last_question? %>
+      <%= button_to "End quiz", end_quiz_moderate_game_path(game), class: "btn btn--pink btn--lg" %>
+    <% elsif game.closed? %>
+      <%= button_to "Next", next_moderate_game_path(game), class: "btn btn--pink btn--lg" %>
+    <% end %>
+  </div>
+</div>
