diff --git a/app/models/game_question.rb b/app/models/game_question.rb
new file mode 100644
index 0000000..041ae6f
--- /dev/null
+++ b/app/models/game_question.rb
@@ -0,0 +1,16 @@
+# A question as the game plays it: a copy of the quiz question at creation time.
+class GameQuestion < ApplicationRecord
+  belongs_to :game, inverse_of: :game_questions
+
+  # Answers go first: they refer to the options, so they must be gone before them.
+  has_many :answers, dependent: :destroy
+  has_many :options, -> { order(:position) }, class_name: "GameOption", dependent: :destroy, inverse_of: :game_question
+
+  validates :text, presence: true
+  validates :position, numericality: { only_integer: true, greater_than: 0 }
+
+  # How many players picked each option: { option_id => count }.
+  def answer_counts
+    answers.group(:game_option_id).count
+  end
+end
