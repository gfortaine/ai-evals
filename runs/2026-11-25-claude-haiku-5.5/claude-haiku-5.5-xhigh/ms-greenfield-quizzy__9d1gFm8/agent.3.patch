diff --git a/app/views/play/_state.html.erb b/app/views/play/_state.html.erb
new file mode 100644
index 0000000..62840d5
--- /dev/null
+++ b/app/views/play/_state.html.erb
@@ -0,0 +1,68 @@
+<%# What a phone shows, by what the player and the game are doing. Nothing here
+    reveals a correct option before its question is closed. %>
+<div class="play__top">
+  <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+  <% if player %><span>Hi, <%= player.name %>!</span><% end %>
+</div>
+
+<div class="play__body play__body--top">
+  <% if game.ended? %>
+    <h1 class="play-title">The quiz is over</h1>
+    <p class="play-lead">Thank you for playing.</p>
+
+  <% elsif player.nil? %>
+    <h1 class="play-title"><%= game.title %></h1>
+    <p class="play-lead">Join with your name to play along.</p>
+
+    <%= form_with url: play_join_path(game.code), scope: :player, class: "join-form", html: { novalidate: true } do |f| %>
+      <%= f.label :name, "Your name", class: "field-label" %>
+      <%= f.text_field :name, value: name, class: "input", maxlength: Player::NAME_LENGTH, autocomplete: "off", spellcheck: "false" %>
+      <%= f.button "Join", class: "btn btn--pink" %>
+    <% end %>
+
+  <% elsif game.lobby? %>
+    <div class="waiting">
+      <div class="waiting__gem" aria-hidden="true">★</div>
+      <h1 class="play-title">You're in</h1>
+      <p class="play-lead">Waiting for the quiz to start…</p>
+    </div>
+
+  <% else %>
+    <% question = game.current_question %>
+    <% answer = game.answer_of(player) %>
+    <% picked_id = answer&.game_option_id %>
+
+    <div class="play-question__num">Question <%= game.position %> of <%= game.total_questions %></div>
+    <div class="play-question__body"><%= question.text %></div>
+
+    <% if game.open? %>
+      <p class="field-hint">Tap an option to answer. You can change it until the question is closed.</p>
+
+      <div class="play-options">
+        <% question.options.each_with_index do |option, index| %>
+          <%= button_to play_answer_path(game.code), params: { game_option_id: option.id },
+                class: "play-option#{' is-picked' if option.id == picked_id}" do %>
+            <span class="play-option__letter"><%= option_letter(index) %></span>
+            <span class="play-option__title"><%= option.text %></span>
+            <% if option.id == picked_id %><span class="play-option__mark">Your answer</span><% end %>
+          <% end %>
+        <% end %>
+      </div>
+
+    <% else %>
+      <div class="play-options is-locked is-revealed">
+        <% question.options.each_with_index do |option, index| %>
+          <div class="play-option<%= ' is-correct' if option.correct? %><%= ' is-picked' if option.id == picked_id %>">
+            <span class="play-option__letter"><%= option_letter(index) %></span>
+            <span class="play-option__title"><%= option.text %></span>
+            <% if option.id == picked_id %><span class="play-option__mark">Your answer</span><% end %>
+          </div>
+        <% end %>
+      </div>
+
+      <% label, tone = answer_result(answer) %>
+      <div class="play-status play-status--<%= tone %>" role="status"><%= label %></div>
+      <p class="play-lead mt-2"><%= game.last_question? ? "Waiting for the end of the quiz…" : "Waiting for the next question…" %></p>
+    <% end %>
+  <% end %>
+</div>
