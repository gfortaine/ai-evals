+++ b/app/helpers/games_helper.rb
@@ -0,0 +1,56 @@
+module GamesHelper
+  # The join link as the moderator shows it: the full URL without the scheme,
+  # for example "localhost:3000/play/K7RZX".
+  def join_link_text(game)
+    play_url(game.code).delete_prefix("http://").delete_prefix("https://")
+  end
+
+  # The QR code of the full join link (with the scheme, so a phone camera opens it),
+  # as inline SVG that scales with its box.
+  def join_qr_code(game)
+    svg = RQRCode::QRCode.new(play_url(game.code)).as_svg(module_size: 8, standalone: true, use_path: true, viewbox: true)
+    svg.sub(/\A<\?xml[^>]*\?>/, "").html_safe
+  end
+
+  # The big-screen background for each phase.
+  def screen_cover_class(game)
+    case game.phase
+    when "lobby" then "cover--blue"
+    when "open" then ""
+    else "cover--night"
+    end
+  end
+
+  # Moderator list: the status of a game in words, and the badge class for it.
+  def game_status_label(game)
+    { "lobby" => "Waiting", "open" => "Running", "closed" => "Running", "ended" => "Finished" }.fetch(game.phase)
+  end
+
+  def game_badge_class(game)
+    { "lobby" => "", "open" => "badge--running", "closed" => "badge--running", "ended" => "badge--finished" }.fetch(game.phase)
+  end
+
+  # What the player sees after a question is closed: [label, status tone].
+  def answer_result(answer)
+    if answer.nil?
+      [ "No answer", "neutral" ]
+    elsif answer.game_option.correct?
+      [ "Correct!", "right" ]
+    else
+      [ "Wrong!", "wrong" ]
+    end
+  end
+
+  # The stream a live page listens to. Each page load gets its own subscription: Action
+  # Cable keeps one subscription per identifier, and Turbo's identifier is only the
+  # stream name, so the unsubscribe of the page being left could remove the subscription
+  # of the page that replaces it. The random attribute makes each identifier unique.
+  def live_subscription(stream)
+    turbo_stream_from stream, data: { subscription: SecureRandom.hex(8) }
+  end
+
+  # Share of the answers an option got, in percent (for the bar on the big screen).
+  def answer_share(count, total)
+    total.zero? ? 0 : (count * 100.0 / total).round
+  end
+end
diff --git a/app/javascript/application.js b/app/javascript/application.js
index 0d7b494..150a446 100644
--- a/app/javascript/application.js
+++ b/app/javascript/application.js
@@ -1,3 +1,27 @@
 // Configure your import map in config/importmap.rb. Read more: https://github.com/rails/importmap-rails
 import "@hotwired/turbo-rails"
 import "controllers"
+
+// The server sends a "tick" over the game's stream when the game changes (see
+// Game::TICK). Every live region on the page then fetches its view again.
+Turbo.StreamActions.tick = function () {
+  document.dispatchEvent(new CustomEvent("quizzy:tick"))
+}
+
+// A stream subscription gets its "connected" attribute each time it (re)connects.
+// Messages sent while it was down are lost, so catch up as soon as it is back.
+// A change sent just before the server registered the new subscription is lost
+// too, so catch up once more a moment later.
+function catchUp() {
+  document.dispatchEvent(new CustomEvent("quizzy:tick"))
+  setTimeout(() => document.dispatchEvent(new CustomEvent("quizzy:tick")), 500)
+}
+
+new MutationObserver((records) => {
+  if (records.some((record) => record.target.hasAttribute("connected") && record.oldValue === null)) catchUp()
+}).observe(document.documentElement, {
+  subtree: true,
+  attributes: true,
+  attributeFilter: [ "connected" ],
+  attributeOldValue: true
+})
diff --git a/app/javascript/controllers/live_controller.js b/app/javascript/controllers/live_controller.js
new file mode 100644
index 0000000..a132fae
--- /dev/null
+++ b/app/javascript/controllers/live_controller.js
@@ -0,0 +1,119 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Keeps one region of a page in step with a live game.
+//
+// The region fetches its view from `url` when the server ticks (see application.js),
+// and also on a timer. The timer is what makes it survive crowded Wi-Fi: a tick
+// that was lost, or a connection that dropped, is caught up within a few seconds.
+// After a failed fetch the wait grows (up to 12 seconds) and shrinks again on success.
+//
+// Replacing the region must not wipe what someone is typing, so typed values and
+// focus are carried over to the new HTML.
+export default class extends Controller {
+  static values = { url: String, interval: { type: Number, default: 4000 } }
+
+  connect() {
+    this.html = this.element.innerHTML
+    this.failures = 0
+    this.busy = false
+    this.queued = false
+    this.disconnected = false
+
+    this.onTick = () => this.refresh()
+    this.onVisible = () => { if (document.visibilityState === "visible") this.refresh() }
+
+    document.addEventListener("quizzy:tick", this.onTick)
+    window.addEventListener("online", this.onTick)
+    document.addEventListener("visibilitychange", this.onVisible)
+
+    this.schedule(this.intervalValue)
+  }
+
+  disconnect() {
+    this.disconnected = true
+    clearTimeout(this.timer)
+    document.removeEventListener("quizzy:tick", this.onTick)
+    window.removeEventListener("online", this.onTick)
+    document.removeEventListener("visibilitychange", this.onVisible)
+  }
+
+  async refresh() {
+    if (this.disconnected) return
+    if (this.busy) {
+      this.queued = true
+      return
+    }
+
+    this.busy = true
+    clearTimeout(this.timer)
+    let ok = false
+    try {
+      const response = await fetch(this.urlValue, {
+        headers: { Accept: "text/html" },
+        cache: "no-cache",
+        credentials: "same-origin"
+      })
+      if (response.ok) {
+        const html = await response.text()
+        if (html !== this.html) this.replace(html)
+        ok = true
+      }
+    } catch (error) {
+      // Offline or the connection dropped: the next beat tries again.
+    } finally {
+      this.busy = false
+      this.failures = ok ? 0 : Math.min(this.failures + 1, 4)
+      if (!this.disconnected) this.schedule(this.intervalValue * 2 ** this.failures)
+      if (this.queued) {
+        this.queued = false
+        this.refresh()
+      }
+    }
+  }
+
+  schedule(delay) {
+    clearTimeout(this.timer)
+    // Jitter keeps a whole room of phones from fetching in the same instant.
+    const wait = Math.min(delay, 12000) + Math.random() * 1000
+    this.timer = setTimeout(() => this.refresh(), wait)
+  }
+
+  replace(html) {
+    const typed = this.typedValues()
+    this.element.innerHTML = html
+    this.html = html
+    this.restoreTypedValues(typed)
+  }
+
+  typedValues() {
+    const active = document.activeElement
+    return this.fields().map((field) => ({
+      name: field.name,
+      value: field.value,
+      focused: field === active,
+      start: field.selectionStart,
+      end: field.selectionEnd
+    }))
+  }
+
+  restoreTypedValues(typed) {
+    const fields = this.fields()
+    for (const saved of typed) {
+      const field = fields.find((candidate) => candidate.name === saved.name)
+      if (!field) continue
+
+      field.value = saved.value
+      if (saved.focused) {
+        field.focus()
+        if (saved.start !== null) field.setSelectionRange(saved.start, saved.end)
+      }
+    }
+  }
+
+  // Text fields a player or moderator may be typing into.
+  fields() {
+    return [ ...this.element.querySelectorAll("input[name], textarea[name]") ].filter((field) =>
+      field.tagName === "TEXTAREA" || [ "text", "search", "email", "url", "tel", "" ].includes(field.type)
+    )
+  }
+}
