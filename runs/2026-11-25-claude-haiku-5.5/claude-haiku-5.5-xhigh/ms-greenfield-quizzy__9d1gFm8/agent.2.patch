+<% content_for :title, "Import quiz" %>
+
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<div class="page-head"><h1>Import quiz</h1></div>
+
+<%= form_with model: @import, url: moderate_import_path, method: :post, html: { novalidate: true }, class: "card" do |f| %>
+  <% if @import.errors.any? %>
+    <div class="errors" role="alert">
+      <p>Nothing was imported. Fix the problems listed and import again.</p>
+      <ul>
+        <% @import.errors.full_messages.each do |message| %>
+          <li><%= message %></li>
+        <% end %>
+      </ul>
+    </div>
