+  <div class="field">
+    <%= f.label :json, "Quiz JSON", class: "field-label" %>
+    <%= f.text_area :json, rows: 16, class: "input input--code", spellcheck: "false", autofocus: true %>
+    <span class="field-hint">Paste the JSON from another quiz's Export page. Importing always creates a new quiz.</span>
+  </div>
+
+  <div class="buttons">
+    <%= f.button "Import", class: "btn btn--pink" %>
+    <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+  </div>
+<% end %>
