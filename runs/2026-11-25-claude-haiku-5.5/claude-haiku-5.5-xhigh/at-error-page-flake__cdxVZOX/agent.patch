diff --git a/test/integration/with_raised_exceptions_test.rb b/test/integration/with_raised_exceptions_test.rb
new file mode 100644
index 0000000..5f0dc6e
--- /dev/null
+++ b/test/integration/with_raised_exceptions_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class WithRaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "controller errors raise inside the block and render as error pages after it" do
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "the previous setting is restored when the block raises" do
+    previous = Rails.application.env_config["action_dispatch.show_exceptions"]
+
+    assert_raises RuntimeError do
+      with_raised_exceptions { raise "boom" }
+    end
+
+    assert_equal previous, Rails.application.env_config["action_dispatch.show_exceptions"]
+  end
+
+  test "nested blocks restore the outer setting" do
+    previous = Rails.application.env_config["action_dispatch.show_exceptions"]
+
+    with_raised_exceptions do
+      with_raised_exceptions { }
+
+      assert_equal :none, Rails.application.env_config["action_dispatch.show_exceptions"]
+    end
+
+    assert_equal previous, Rails.application.env_config["action_dispatch.show_exceptions"]
+  end
+end
diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..4a66f93 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,24 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Let controller errors reach the test as raised exceptions instead of rendering
+    # the error pages, for the duration of the block.
+    #
+    # Rails copies show_exceptions into Rails.application.env_config the first time
+    # that hash is built, and merges it into every request. Changing
+    # config.action_dispatch.show_exceptions later has no effect on requests, and
+    # whichever request happens to build the hash first would otherwise pin the
+    # setting for the rest of the process. So toggle the value in the hash that
+    # requests actually use, and restore the value it had before.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
-      yield
-    ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config = Rails.application.env_config
+      previous = env_config["action_dispatch.show_exceptions"]
+      begin
+        env_config["action_dispatch.show_exceptions"] = :none
+        yield
+      ensure
+        env_config["action_dispatch.show_exceptions"] = previous
+      end
     end
   end
 end
