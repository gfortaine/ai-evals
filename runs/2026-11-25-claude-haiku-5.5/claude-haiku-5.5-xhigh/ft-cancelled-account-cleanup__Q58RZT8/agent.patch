diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..c804fbe 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,83 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  # Bare models for tenant tables, so that delete_all type-casts account_id the same way as
+  # any other query. Built once per table and kept, rather than rebuilt on every run.
+  TENANT_MODELS = {}
+
+  included do
+    # Cancelled for longer than the grace period.
+    scope :due_for_incineration, -> {
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    }
+  end
+
+  class_methods do
+    # One account failing is reported and skipped so that it can't hold up the others. It stays
+    # due, so the next run retries it.
+    def incinerate_due
+      due_for_incineration.find_each do |account|
+        account.incinerate
+      rescue => error
+        Rails.error.report(error, context: { account_id: account.id }, handled: true)
+      end
+    end
+  end
+
+  # Permanently deletes this account and every row belonging to it. Deletes are done in bulk
+  # rather than through callbacks: callbacks would write storage ledger entries and enqueue
+  # work for rows that are about to disappear. Does nothing unless the account is due.
+  #
+  # The account row is locked, as it is by cancel and reactivate, and the due check runs under
+  # that lock. A reactivation that lands after this instance was loaded can't be deleted by mistake.
+  def incinerate
+    with_lock(requires_new: true) do
+      if incineratable?
+        purge_stored_files
+        delete_data
+        true
+      else
+        false
+      end
+    end
+  end
+
+  private
+    def incineratable?
+      cancelled? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+    end
+
+    # Files go before the rows. Deleting a file is idempotent, so if the transaction fails the
+    # rows survive, and the next run deletes the files again and finishes.
+    def purge_stored_files
+      ActiveStorage::Blob.where(account_id: id).find_each(&:delete)
+    end
+
+    def delete_data
+      Search::Record.delete_index_for_account(id)
+      Filter.where(account_id: id).destroy_all # Also removes the filter's join-table rows.
+      Storage::Total.where(owner: self).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: boards.select(:id)).delete_all
+
+      tenant_tables.each { |table| tenant_model(table).where(account_id: id).delete_all }
+
+      Account.where(id: id).delete_all
+    end
+
+    # Every table with an account_id column holds tenant data (see AGENTS.md). Sweeping by that
+    # column catches tables that aren't reachable through the association graph, such as the
+    # storage ledger and the sharded search tables.
+    def tenant_tables
+      connection = self.class.connection
+
+      connection.tables.select do |table|
+        connection.columns(table).any? { it.name == "account_id" }
+      end
+    end
+
+    def tenant_model(table)
+      TENANT_MODELS[table] ||= Class.new(ApplicationRecord) { self.table_name = table }
+    end
 end
