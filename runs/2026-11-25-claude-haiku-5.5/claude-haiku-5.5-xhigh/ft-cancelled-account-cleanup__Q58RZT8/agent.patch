diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..511fca8
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @user = users(:david)
+    @due = accounts("37s")
+    @recent = accounts(:initech)
+    @active = accounts(:acme)
+  end
+
+  test "incinerates accounts cancelled more than the grace period ago and nothing else" do
+    cancel_at @due, (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+    cancel_at @recent, (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(@due.id)
+    assert Account.exists?(@recent.id)
+    assert Account.exists?(@active.id)
+  end
+
+  test "reports a failing account and still attempts the others" do
+    cancel_at @due, 31.days.ago
+    cancel_at @recent, 31.days.ago
+
+    Account.any_instance.expects(:incinerate).twice.raises(RuntimeError, "boom")
+    Rails.error.expects(:report).twice
+
+    assert_nothing_raised { Account::IncinerateDueJob.perform_now }
+  end
+
+  test "is scheduled daily in production" do
+    path = Rails.root.join("config/recurring.yml")
+    config = ERB.new(File.read(path)).tap { it.filename = path.to_s }.result
+    tasks = YAML.safe_load(config, aliases: true).fetch("production")
+
+    assert_equal "Account::IncinerateDueJob", tasks.dig("incinerate_due_accounts", "class")
+    assert tasks.dig("incinerate_due_accounts", "schedule").present?
+  end
+
+  private
+    def cancel_at(account, time)
+      travel_to(time) { account.cancel(initiated_by: @user) }
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..1265e2b
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,204 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration includes accounts cancelled longer ago than the grace period" do
+    cancel_at @account, (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes accounts cancelled within the grace period" do
+    cancel_at @account, (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes active accounts" do
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "incinerate deletes the account and every row that belongs to it" do
+    populate @account, @user
+    cancel_at @account, 31.days.ago
+    assert_not_empty tenant_rows(@account)
+
+    assert @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_empty tenant_rows(@account)
+  end
+
+  test "incinerate removes rows that are not keyed by account" do
+    populate @account, @user
+    cancel_at @account, 31.days.ago
+    board_ids = @account.boards.ids
+    filter_ids = Filter.where(account_id: @account.id).ids
+    search_record_ids = Search::Record.where(account_id: @account.id).ids
+    assert_not_empty filter_join_rows(filter_ids)
+    assert_not_empty Storage::Total.where(owner_type: "Board", owner_id: board_ids)
+    assert_not_empty Storage::Total.where(owner_type: "Account", owner_id: @account.id)
+    assert_not_empty fts_rows(search_record_ids) if sqlite?
+
+    @account.incinerate
+
+    assert_empty filter_join_rows(filter_ids)
+    assert_empty Storage::Total.where(owner_type: "Board", owner_id: board_ids)
+    assert_empty Storage::Total.where(owner_type: "Account", owner_id: @account.id)
+    assert_empty fts_rows(search_record_ids) if sqlite?
+  end
+
+  test "incinerate deletes stored files" do
+    populate @account, @user
+    cancel_at @account, 31.days.ago
+    keys = ActiveStorage::Blob.where(account_id: @account.id).pluck(:key)
+    assert_not_empty keys
+    assert keys.all? { |key| ActiveStorage::Blob.service.exist?(key) }
+
+    @account.incinerate
+
+    assert keys.none? { |key| ActiveStorage::Blob.service.exist?(key) }
+  end
+
+  test "incinerate leaves other accounts untouched" do
+    other = accounts(:initech)
+    populate other, users(:mike)
+    other_rows = tenant_rows(other)
+    assert_not_empty other_rows
+
+    populate @account, @user
+    cancel_at @account, 31.days.ago
+    @account.incinerate
+
+    assert Account.exists?(other.id)
+    assert_equal other_rows, tenant_rows(other)
+  end
+
+  test "incinerate re-checks the cancellation under lock, so a reactivated account is left alone" do
+    populate @account, @user
+    cancel_at @account, 31.days.ago
+    assert @account.cancelled? # Loads the cancellation on this instance.
+
+    Account.find(@account.id).reactivate
+    rows = tenant_rows(@account)
+
+    assert_not @account.incinerate
+    assert Account.exists?(@account.id)
+    assert_equal rows, tenant_rows(@account)
+  end
+
+  test "incinerate does nothing to an active account" do
+    populate @account, @user
+    rows = tenant_rows(@account)
+
+    assert_not @account.incinerate
+
+    assert Account.exists?(@account.id)
+    assert_equal rows, tenant_rows(@account)
+  end
+
+  test "incinerate does nothing to an account cancelled within the grace period" do
+    populate @account, @user
+    cancel_at @account, (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago
+    rows = tenant_rows(@account)
+
+    assert_not @account.incinerate
+
+    assert Account.exists?(@account.id)
+    assert_equal rows, tenant_rows(@account)
+  end
+
+  test "a failure part way through leaves the account intact so that a retry can finish" do
+    populate @account, @user
+    cancel_at @account, 31.days.ago
+    rows = tenant_rows(@account)
+    filter_ids = Filter.where(account_id: @account.id).ids
+    Storage::Total.stubs(:where).raises(ActiveRecord::StatementInvalid, "boom")
+
+    assert_raises(ActiveRecord::StatementInvalid) { @account.incinerate }
+    assert Account.exists?(@account.id)
+    assert_equal rows, tenant_rows(@account)
+    assert_not_empty filter_join_rows(filter_ids)
+
+    Storage::Total.unstub(:where)
+    assert @account.incinerate
+    assert_not Account.exists?(@account.id)
+    assert_empty tenant_rows(@account)
+  end
+
+  test "a failure part way through is rolled back even when called inside another transaction" do
+    populate @account, @user
+    cancel_at @account, 31.days.ago
+    rows = tenant_rows(@account)
+    Storage::Total.stubs(:where).raises(ActiveRecord::StatementInvalid, "boom")
+
+    ActiveRecord::Base.transaction do
+      assert_raises(ActiveRecord::StatementInvalid) { @account.incinerate }
+    end
+    Storage::Total.unstub(:where)
+
+    assert_equal rows, tenant_rows(@account)
+  end
+
+  private
+    def cancel_at(account, time)
+      travel_to(time) { account.cancel(initiated_by: @user) }
+    end
+
+    # Creates data across the account: attachments and rich text embeds (blobs, storage
+    # ledger), a searchable card and comment, a saved search, and a completed import.
+    def populate(account, user)
+      Current.set(account: account, user: user) do
+        # Fixtures don't keep cards_count in step with card numbers.
+        account.update_column :cards_count, account.cards.maximum(:number).to_i
+
+        card = account.cards.first
+        card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+        embed = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "embed.png", content_type: "image/png")
+        card.update!(description: "<p>Details #{ActionText::Attachment.from_attachable(embed).to_html}</p>")
+        card.comments.create!(creator: user, body: "A comment with a searchable phrase")
+
+        user.avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+        Card.create!(board: account.boards.first, creator: user, title: "Searchable card", description: "findable text")
+        Search::Query.create!(account: account, user: user, terms: "findable")
+        Account::Import.create!(account: account, identity: user.identity, status: :completed, completed_at: Time.current)
+
+        account.materialize_storage
+        account.boards.each(&:materialize_storage)
+      end
+    end
+
+    # Row counts for every table with an account_id column, using the same type casting as
+    # the application so that UUIDs match. Returns only the tables that still have rows.
+    def tenant_rows(account)
+      connection = ActiveRecord::Base.connection
+
+      connection.tables.each_with_object({}) do |table, counts|
+        next unless connection.columns(table).any? { it.name == "account_id" }
+
+        model = Class.new(ApplicationRecord) { self.table_name = table }
+        count = model.where(account_id: account.id).count
+        counts[table] = count if count.positive?
+      end
+    end
+
+    def filter_join_rows(filter_ids)
+      Filter.reflect_on_all_associations(:has_and_belongs_to_many).flat_map do |reflection|
+        model = Class.new(ApplicationRecord) { self.table_name = reflection.join_table }
+        model.where(filter_id: filter_ids).pluck(:filter_id)
+      end
+    end
+
+    def fts_rows(search_record_ids)
+      Search::Record::SQLite::Fts.where(rowid: search_record_ids).pluck(:rowid)
+    end
+
+    def sqlite?
+      Search::Record.connection.adapter_name == "SQLite"
+    end
+end
