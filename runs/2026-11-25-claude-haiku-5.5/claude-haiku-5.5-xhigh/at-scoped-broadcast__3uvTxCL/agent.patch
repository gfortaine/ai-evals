diff --git a/test/integration/being_edited_indicator_test.rb b/test/integration/being_edited_indicator_test.rb
new file mode 100644
index 0000000..ada19de
--- /dev/null
+++ b/test/integration/being_edited_indicator_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class BeingEditedIndicatorTest < ActionDispatch::IntegrationTest
+  include SynchronousCableTestHelper
+
+  setup do
+    @leaf = leaves(:welcome_page)
+  end
+
+  test "a collaborator removed while their editor is open stops receiving who is editing the page" do
+    sign_in :kevin
+    get edit_leafable_path(@leaf)
+    signed_stream_name = rendered_presence_stream_name
+
+    kevin_subscription = subscribe_to_stream(:kevin, signed_stream_name)
+    david_subscription = subscribe_to_stream(:david, signed_stream_name)
+
+    books(:handbook).accesses.where(user: users(:kevin)).delete_all
+    save_page_as :david
+
+    assert_empty kevin_subscription.payloads
+    assert_equal 1, david_subscription.payloads.size
+    assert_includes david_subscription.payloads.first, "David"
+    assert subscribe_to_stream(:kevin, signed_stream_name).rejected?
+  end
+
+  private
+    def rendered_presence_stream_name
+      Nokogiri::HTML5(response.body).at_css("turbo-cable-stream-source[channel='Turbo::StreamsChannel']")["signed-stream-name"]
+    end
+
+    def save_page_as(user)
+      sign_out
+      sign_in user
+      perform_enqueued_jobs do
+        put leafable_path(@leaf), params: { leaf: { title: "Better welcome" }, page: { body: "With even more interesting words." } }
+      end
+      assert_response :no_content
+    end
+end
diff --git a/test/test_helpers/synchronous_cable_test_helper.rb b/test/test_helpers/synchronous_cable_test_helper.rb
new file mode 100644
index 0000000..1cb5123
--- /dev/null
+++ b/test/test_helpers/synchronous_cable_test_helper.rb
@@ -0,0 +1,52 @@
+require "action_cable/channel/test_case"
+
+# Subscribes through the real channels, and delivers broadcasts before they return, so a test
+# can assert exactly which subscriptions received what. Installed around each test that includes it.
+module SynchronousCableTestHelper
+  extend ActiveSupport::Concern
+
+  class ImmediateEventLoop
+    def self.post(&block) = block.call
+  end
+
+  class ImmediateWorkerPool
+    def self.async_invoke(handler, method, *args, **) = handler.public_send(method, *args)
+  end
+
+  Subscription = Struct.new(:connection, :channel) do
+    def confirmed? = transmissions.any? { it["type"] == "confirm_subscription" }
+    def rejected? = transmissions.any? { it["type"] == "reject_subscription" }
+    def payloads = transmissions.filter_map { it["message"] }
+
+    private
+      def transmissions = connection.transmissions
+  end
+
+  included do
+    setup { install_synchronous_action_cable }
+    teardown { uninstall_synchronous_action_cable }
+  end
+
+  private
+    def install_synchronous_action_cable
+      adapter = ActionCable::SubscriptionAdapter::Inline.new(ActionCable.server)
+
+      ActionCable.server.define_singleton_method(:event_loop) { ImmediateEventLoop }
+      ActionCable.server.define_singleton_method(:pubsub) { adapter }
+    end
+
+    def uninstall_synchronous_action_cable
+      ActionCable.server.singleton_class.send(:remove_method, :event_loop, :pubsub)
+    end
+
+    def subscribe_to_stream(user, signed_stream_name)
+      connection = ActionCable::Channel::ConnectionStub.new(current_user: users(user))
+      connection.define_singleton_method(:worker_pool) { ImmediateWorkerPool }
+
+      params = ActiveSupport::HashWithIndifferentAccess.new(signed_stream_name: signed_stream_name)
+      channel = Turbo::StreamsChannel.new(connection, "subscription", params)
+      channel.subscribe_to_channel
+
+      Subscription.new(connection, channel)
+    end
+end
