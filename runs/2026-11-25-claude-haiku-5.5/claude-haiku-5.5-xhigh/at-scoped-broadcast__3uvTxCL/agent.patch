diff --git a/lib/rails_ext/being_edited_authorization.rb b/lib/rails_ext/being_edited_authorization.rb
new file mode 100644
index 0000000..18bd652
--- /dev/null
+++ b/lib/rails_ext/being_edited_authorization.rb
@@ -0,0 +1,49 @@
+# Who is editing a page is only for people who can still edit it.
+#
+# The editor page subscribes to its "being edited" stream through Turbo::StreamsChannel with a
+# signed stream name that stays valid for as long as the page is open. Turbo verifies that
+# signature but never checks access, so a collaborator removed from a book keeps receiving the
+# payloads, editor names included. Presence streams are therefore authorized when subscribed and
+# again for every payload before it is transmitted, so access changes apply to open editors too.
+module BeingEditedAuthorization
+  # The :being_edited streamable that the editor page subscribes to and LeafablesController broadcasts to.
+  STREAM_SUFFIX = ":being_edited"
+
+  private
+    def subscribed
+      stream_name = verified_stream_name_from_params
+
+      if stream_name&.end_with?(STREAM_SUFFIX)
+        subscribe_to_being_edited stream_name
+      else
+        super
+      end
+    end
+
+    def subscribe_to_being_edited(stream_name)
+      leaf = leaf_for_being_edited(stream_name)
+
+      if leaf && can_see_being_edited?(leaf)
+        stream_from stream_name, ->(message) { transmit message if can_see_being_edited?(leaf) }
+      else
+        reject
+      end
+    end
+
+    def leaf_for_being_edited(stream_name)
+      GlobalID::Locator.locate stream_name.delete_suffix(STREAM_SUFFIX), only: Leaf
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    # Checked on every payload, not just at subscribe time, so removing a collaborator or
+    # deactivating a user stops their open subscriptions from receiving presence right away.
+    def can_see_being_edited?(leaf)
+      user = User.active.find_by(id: connection.current_user&.id)
+      user.present? && leaf.book.editable?(user: user)
+    end
+end
+
+Rails.application.config.to_prepare do
+  Turbo::StreamsChannel.prepend BeingEditedAuthorization
+end
diff --git a/test/channels/turbo_streams_channel_test.rb b/test/channels/turbo_streams_channel_test.rb
new file mode 100644
index 0000000..ef6533a
--- /dev/null
+++ b/test/channels/turbo_streams_channel_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class TurboStreamsChannelTest < ActionCable::Channel::TestCase
+  include SynchronousCableTestHelper
+
+  tests Turbo::StreamsChannel
+
+  setup do
+    @leaf = leaves(:welcome_page)
+  end
+
+  test "an editor is subscribed to who is editing the page" do
+    subscription = subscribe_to_presence(:kevin, @leaf)
+
+    assert subscription.confirmed?
+    assert_not subscription.rejected?
+  end
+
+  test "an editor receives who is editing the page" do
+    subscription = subscribe_to_presence(:kevin, @leaf)
+
+    broadcast_being_edited_by :david
+
+    assert_equal 1, subscription.payloads.size
+    assert_includes subscription.payloads.first, "David"
+  end
+
+  test "a collaborator removed from the book cannot subscribe to who is editing the page" do
+    remove_access :kevin
+
+    subscription = subscribe_to_presence(:kevin, @leaf)
+
+    assert subscription.rejected?
+    assert_not subscription.confirmed?
+  end
+
+  test "a collaborator removed from the book stops receiving who is editing the page" do
+    subscription = subscribe_to_presence(:kevin, @leaf)
+    broadcast_being_edited_by :david
+    assert_equal 1, subscription.payloads.size
+
+    remove_access :kevin
+    broadcast_being_edited_by :david
+
+    assert_equal 1, subscription.payloads.size, "removed collaborator should not get the second payload"
+  end
+
+  test "a collaborator who is added back receives who is editing the page again" do
+    subscription = subscribe_to_presence(:kevin, @leaf)
+    remove_access :kevin
+    broadcast_being_edited_by :david
+
+    grant_access :kevin, level: :editor
+    broadcast_being_edited_by :david
+
+    assert_equal 1, subscription.payloads.size
+  end
+
+  test "a reader cannot subscribe to who is editing the page" do
+    subscription = subscribe_to_presence(:jz, @leaf)
+
+    assert subscription.rejected?
+    assert_not subscription.confirmed?
+  end
+
+  test "an editor demoted to reader stops receiving who is editing the page" do
+    subscription = subscribe_to_presence(:kevin, @leaf)
+
+    books(:handbook).access_for(user: users(:kevin)).update!(level: :reader)
+    broadcast_being_edited_by :david
+
+    assert_empty subscription.payloads
+  end
+
+  test "an administrator who can edit the book is subscribed to who is editing the page" do
+    subscription = subscribe_to_presence(:david, @leaf)
+
+    assert subscription.confirmed?
+  end
+
+  test "a deactivated user stops receiving who is editing the page" do
+    subscription = subscribe_to_presence(:kevin, @leaf)
+
+    users(:kevin).deactivate
+    broadcast_being_edited_by :david
+
+    assert_empty subscription.payloads
+  end
+
+  test "a presence subscription for a leaf that no longer exists is rejected" do
+    leaf = leaves(:summary_page)
+    signed_stream_name = presence_stream_name(leaf)
+    leaf.destroy!
+
+    subscription = subscribe_to_stream(:kevin, signed_stream_name)
+
+    assert subscription.rejected?
+  end
+
+  test "a presence subscription with a forged stream name is rejected" do
+    subscription = subscribe_to_stream(:kevin, "#{presence_stream_name(@leaf)}--forged")
+
+    assert subscription.rejected?
+  end
+
+  test "other streams are unaffected by presence authorization" do
+    remove_access :kevin
+
+    subscription = subscribe_to_stream(:kevin, Turbo::StreamsChannel.signed_stream_name([ "chat", 1 ]))
+
+    assert subscription.confirmed?
+  end
+
+  private
+    def presence_stream_name(leaf)
+      Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited ])
+    end
+
+    def subscribe_to_presence(user, leaf)
+      subscribe_to_stream(user, presence_stream_name(leaf))
+    end
+
+    # Broadcasts what the controller sends when someone saves the page, without deferring it to a job.
+    def broadcast_being_edited_by(user)
+      Turbo::StreamsChannel.broadcast_render_to @leaf, :being_edited,
+        partial: "leaves/being_edited_by", locals: { leaf: @leaf, user: users(user) }
+    end
+
+    def remove_access(user)
+      books(:handbook).accesses.where(user: users(user)).delete_all
+    end
+
+    def grant_access(user, level:)
+      books(:handbook).accesses.create!(user: users(user), level: level)
+    end
+end
