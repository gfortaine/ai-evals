diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..56d0f37 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,77 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "update shows being edited to every current editor" do
+    kevin_stream = being_edited_stream_for(:kevin)
+    jason_stream = being_edited_stream_for(:jason)
+    david_stream = being_edited_stream_for(:david)
+
+    sign_in :kevin
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Better welcome" }, page: { body: "Even more interesting words." } }
+    end
+
+    [ kevin_stream, jason_stream, david_stream ].each do |stream|
+      indicator = capture_turbo_stream_broadcasts(stream).sole
+      assert_equal "append", indicator["action"]
+      assert_equal ActionView::RecordIdentifier.dom_id(leaves(:welcome_page), :being_edited), indicator["target"]
+      assert_includes indicator.to_s, "Kevin"
+    end
+  end
+
+  test "update does not show being edited to a collaborator demoted to reader" do
+    kevin_stream = being_edited_stream_for(:kevin)
+    jason_stream = being_edited_stream_for(:jason)
+
+    sign_in :david
+    patch book_path(books(:handbook)), params: { book: { title: "Handbook" }, editor_ids: [ users(:jason).id ], reader_ids: [ users(:jz).id ] }
+    assert_equal "reader", books(:handbook).access_for(user: users(:kevin)).level
+
+    sign_in :jason
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Better welcome" }, page: { body: "Even more interesting words." } }
+    end
+
+    assert_no_turbo_stream_broadcasts kevin_stream
+    assert_turbo_stream_broadcasts jason_stream
+  end
+
+  test "update does not show being edited to a collaborator whose access was removed" do
+    books(:handbook).update!(everyone_access: false)
+    kevin_stream = being_edited_stream_for(:kevin)
+
+    sign_in :david
+    patch book_path(books(:handbook)), params: { book: { title: "Handbook" }, editor_ids: [ users(:jason).id ], reader_ids: [ users(:jz).id ] }
+    assert_nil books(:handbook).access_for(user: users(:kevin))
+
+    sign_in :jason
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Better welcome" }, page: { body: "Even more interesting words." } }
+    end
+
+    assert_no_turbo_stream_broadcasts kevin_stream
+  end
+
+  test "update does not show being edited to a deactivated editor" do
+    jason_stream = being_edited_stream_for(:jason)
+    users(:jason).deactivate
+
+    sign_in :kevin
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Better welcome" }, page: { body: "Even more interesting words." } }
+    end
+
+    assert_no_turbo_stream_broadcasts jason_stream
+  end
+
+  private
+    # The stream an editor's page subscribes to for its being-edited indicator, read from the page itself.
+    def being_edited_stream_for(user, leaf: leaves(:welcome_page))
+      sign_in user
+      get edit_leafable_path(leaf)
+
+      signed_stream_name = Nokogiri::HTML(response.body).at_css("turbo-cable-stream-source")["signed-stream-name"]
+      Turbo::StreamsChannel.verified_stream_name(signed_stream_name)
+    end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..6d3685a 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,43 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "editors are the active users who can edit the book" do
+    assert_equal [ users(:david), users(:jason), users(:kevin) ].sort_by(&:id), books(:handbook).editors.sort_by(&:id)
+
+    users(:kevin).deactivate
+    assert_equal [ users(:david), users(:jason) ].sort_by(&:id), books(:handbook).reload.editors.sort_by(&:id)
+  end
+
+  test "editors leaves out readers and collaborators demoted to readers" do
+    books(:handbook).update_access(editors: [ users(:jason).id ], readers: [ users(:kevin).id ])
+
+    assert_includes books(:handbook).editors, users(:jason)
+    assert_not_includes books(:handbook).editors, users(:kevin)
+    assert_not_includes books(:handbook).editors, users(:jz)
+  end
+
+  test "editors includes administrators who can reach the book" do
+    administrator = User.create!(name: "Ada", email_address: "ada@example.com", password: "secret123456", role: :administrator)
+    books(:manual).accesses.where(user: administrator).delete_all
+    assert_not_includes books(:manual).editors, administrator
+
+    books(:manual).accesses.create!(user: administrator, level: :reader)
+    assert_includes books(:manual).editors, administrator
+    books(:manual).accesses.where(user: administrator).delete_all
+
+    books(:manual).update!(published: true)
+    assert_includes books(:manual).editors, administrator
+  end
+
+  test "editors matches who can open the book for editing" do
+    Book.find_each do |book|
+      User.find_each do |user|
+        reachable = book.accessable?(user: user) || book.published?
+        expected = user.active? && reachable && book.editable?(user: user)
+
+        assert_equal expected, book.editors.include?(user), "#{user.name} on #{book.title}"
+      end
+    end
+  end
 end
