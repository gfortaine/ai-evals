--- a/app/controllers/leafables_controller.rb
+++ b/app/controllers/leafables_controller.rb
@@ -66,8 +66,13 @@ class LeafablesController < ApplicationController
       end
     end
 
+    # Presence is pushed to a stream per current editor (see leaves/_being_edited_indicator), never to one
+    # shared stream: Turbo doesn't re-check access on an open subscription, so a shared stream would keep
+    # delivering to an editor who has since lost edit rights.
     def broadcast_being_edited_indicator
-      Turbo::StreamsChannel.broadcast_render_later_to @leaf, :being_edited,
-        partial: "leaves/being_edited_by", locals: { leaf: @leaf, user: Current.user }
+      @book.editors.each do |editor|
+        Turbo::StreamsChannel.broadcast_render_later_to @leaf, :being_edited, editor,
+          partial: "leaves/being_edited_by", locals: { leaf: @leaf, user: Current.user }
+      end
     end
 end
diff --git a/app/models/book/accessable.rb b/app/models/book/accessable.rb
index aa3dcf1..a8f90d5 100644
--- a/app/models/book/accessable.rb
+++ b/app/models/book/accessable.rb
@@ -32,6 +32,15 @@ module Book::Accessable
     accesses.find_by(user: user)
   end
 
+  # Active users who can open this book for editing right now: editors, plus the administrators who can
+  # reach the book (they are editable? wherever they can see it). This mirrors #editable? and the book
+  # lookup, so anyone who loses edit rights (removed, demoted to reader, deactivated) drops out at once.
+  def editors
+    admins = published? ? User.administrator : User.administrator.where(id: accesses.select(:user_id))
+
+    User.active.where(id: accesses.editor.select(:user_id)).or(User.active.merge(admins))
+  end
+
   def update_access(editors:, readers:)
     editors = Set.new(editors)
     readers = Set.new(everyone_access? ? User.active.ids : readers)
