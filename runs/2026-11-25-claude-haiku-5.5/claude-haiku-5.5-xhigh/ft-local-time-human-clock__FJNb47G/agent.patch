+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,18 @@
 module TimeHelper
+  # The server sends the instant; the browser words it in the viewer's timezone (see the local-time controller).
+  # The text here is only what shows before the page script runs.
+  #
+  # Formats (see formatTime in helpers/date_helpers.js): relative (default), time, date, day, date_time.
+  def local_time(time, format: :relative, **attributes)
+    attributes[:class] = class_names("local-time-value", attributes[:class])
+
+    tag.time local_time_fallback(time), **attributes,
+      datetime: time.utc.iso8601,
+      data: { controller: "local-time", local_time_format_value: format }
+  end
+
+  private
+    def local_time_fallback(time)
+      time.utc.strftime("%b %-d, %Y %-l:%M %p UTC")
+    end
 end
