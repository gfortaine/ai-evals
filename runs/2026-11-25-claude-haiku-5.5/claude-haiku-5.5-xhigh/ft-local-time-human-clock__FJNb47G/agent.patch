@@ -0,0 +1,57 @@
+require "test_helper"
+
+class LocalTimeRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "card meta sends the card's times for the browser to word" do
+    card = cards(:logo)
+
+    get card_path(card)
+
+    assert_select ".card__meta-text--added time.local-time-value[data-controller=local-time][datetime=?]", card.created_at.utc.iso8601
+    assert_select ".card__meta-text--updated time[datetime=?]", card.last_active_at.utc.iso8601
+  end
+
+  test "comments send their time for the browser to word" do
+    comment = comments(:logo_agreement_jz)
+
+    get card_path(comment.card)
+
+    assert_select "##{ActionView::RecordIdentifier.dom_id(comment)} .comment__permalink-title time[datetime=?][data-local-time-format-value=relative]", comment.created_at.utc.iso8601
+  end
+
+  test "a closed card sends its closing date for the stamp and the bridge description" do
+    card = cards(:logo)
+    card.close(user: users(:kevin))
+
+    get card_path(card)
+
+    assert_select ".card__closed time[data-local-time-format-value=date][datetime=?]", card.closed_at.utc.iso8601
+    assert_select ".card__closed[data-bridge-description]" do |stamps|
+      assert_includes stamps.first["data-bridge-description"], "<time"
+    end
+  end
+
+  test "the share button describes the card's dates as local times" do
+    get card_path(cards(:logo))
+
+    assert_select "button[data-bridge-share-description]" do |buttons|
+      description = buttons.first["data-bridge-share-description"]
+
+      assert_includes description, "Added <time"
+      assert_includes description, "Updated <time"
+    end
+  end
+
+  test "the events page sends day headings and hours for the browser to word" do
+    travel_to Time.utc(2025, 1, 22, 17, 30, 0)
+    events(:layout_assignment_jz).update!(created_at: Time.current.beginning_of_day + 8.hours)
+
+    get events_path
+
+    assert_select "h3.events__column-header time[data-local-time-format-value=day]"
+    assert_select "time.event__timestamp[data-local-time-format-value=time][datetime=?]", events(:layout_assignment_jz).created_at.utc.iso8601
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..90d17e7
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,149 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  teardown do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "") if @timezone_overridden
+  end
+
+  # The formatter gets explicit "now" values, so these results don't depend on the clock.
+  test "dates are worded in the viewer's timezone" do
+    use_timezone "America/New_York"
+    sign_in_as(users(:david))
+
+    assert_equal [
+      "1:42 PM", "yesterday", "yesterday", "2 days ago", "5 days ago", "6 days ago", "Sep 5", "Dec 31, 2025",
+      "tomorrow", "in 3 days", "today at 9:00 PM", "yesterday", "12:00 AM", "12:00 PM"
+    ], format_times([
+      [ "2026-09-12T13:42:00-04:00", "relative", "2026-09-12T15:00:00-04:00" ],
+      [ "2026-09-11T23:59:00-04:00", "relative", "2026-09-12T15:00:00-04:00" ],
+      [ "2026-09-11T00:01:00-04:00", "relative", "2026-09-12T15:00:00-04:00" ],
+      [ "2026-09-10T12:00:00-04:00", "relative", "2026-09-12T15:00:00-04:00" ],
+      [ "2026-09-07T12:00:00-04:00", "relative", "2026-09-12T15:00:00-04:00" ],
+      [ "2026-09-06T12:00:00-04:00", "relative", "2026-09-12T15:00:00-04:00" ],
+      [ "2026-09-05T12:00:00-04:00", "relative", "2026-09-12T15:00:00-04:00" ],
+      [ "2025-12-31T12:00:00-05:00", "relative", "2026-09-12T15:00:00-04:00" ],
+      [ "2026-09-13T09:00:00-04:00", "relative", "2026-09-12T15:00:00-04:00" ],
+      [ "2026-09-15T09:00:00-04:00", "relative", "2026-09-12T15:00:00-04:00" ],
+      [ "2026-09-12T21:00:00-04:00", "relative", "2026-09-12T15:00:00-04:00" ],
+      [ "2026-11-01T23:30:00-05:00", "relative", "2026-11-02T10:00:00-05:00" ],
+      [ "2026-09-12T00:00:00-04:00", "relative", "2026-09-12T15:00:00-04:00" ],
+      [ "2026-09-12T12:00:00-04:00", "relative", "2026-09-12T15:00:00-04:00" ]
+    ])
+  end
+
+  test "the other formats" do
+    use_timezone "America/New_York"
+    sign_in_as(users(:david))
+
+    assert_equal [ "1:42 PM", "Sep 12", "Dec 31, 2025", "Saturday, September 12", "9/12/26, 1:42 PM" ], format_times([
+      [ "2026-09-12T13:42:00-04:00", "time", "2026-09-12T15:00:00-04:00" ],
+      [ "2026-09-12T13:42:00-04:00", "date", "2026-09-12T15:00:00-04:00" ],
+      [ "2025-12-31T12:00:00-05:00", "date", "2026-09-12T15:00:00-04:00" ],
+      [ "2026-09-12T13:42:00-04:00", "day", "2026-09-12T15:00:00-04:00" ],
+      [ "2026-09-12T13:42:00-04:00", "date_time", "2026-09-12T15:00:00-04:00" ]
+    ])
+  end
+
+  test "the same instant is a different day in different timezones" do
+    sign_in_as(users(:david))
+    instant = "2026-09-13T01:30:00Z"
+    now = "2026-09-13T12:00:00Z"
+
+    use_timezone "UTC"
+    assert_equal [ "1:30 AM" ], format_times([ [ instant, "time", now ] ])
+
+    use_timezone "America/New_York"
+    assert_equal [ "yesterday" ], format_times([ [ instant, "relative", now ] ])
+
+    use_timezone "Asia/Tokyo"
+    assert_equal [ "10:30 AM" ], format_times([ [ instant, "time", now ] ])
+  end
+
+  test "text of bridge descriptions has its times worded for the viewer" do
+    use_timezone "America/New_York"
+    sign_in_as(users(:david))
+
+    text = page.evaluate_async_script(<<~JS)
+      const done = arguments[arguments.length - 1]
+      import("helpers/date_helpers").then(({ textWithLocalTimes }) => {
+        const html = 'Added <time datetime="2026-09-13T01:30:00Z" data-local-time-format-value="time">x</time> by Ann &amp; Bee'
+        done([ textWithLocalTimes(html), textWithLocalTimes(null) ])
+      })
+    JS
+
+    assert_equal [ "Added 9:30 PM by Ann & Bee", nil ], text
+  end
+
+  test "a card's dates are worded for the viewer when the page loads" do
+    use_timezone "America/New_York"
+    card = cards(:logo)
+    set_card_dates_relative_to_today(card, created_days_ago: 1, updated_days_ago: 3)
+
+    sign_in_as(users(:david))
+    visit card_url(card)
+
+    assert_selector ".card__meta-text--added time", text: /\Ayesterday\z/i
+    assert_selector ".card__meta-text--updated time", text: /\A3 days ago\z/i
+    assert_no_selector "time", text: "UTC"
+  end
+
+  test "a time the page re-renders in place is worded again" do
+    use_timezone "America/New_York"
+    card = cards(:logo)
+    set_card_dates_relative_to_today(card, created_days_ago: 1, updated_days_ago: 3)
+
+    sign_in_as(users(:david))
+    visit card_url(card)
+    assert_selector ".card__meta-text--added time", text: /\Ayesterday\z/i
+
+    page.execute_script(%q{document.querySelector(".card__meta-text--added time").textContent = "Sep 13, 2026 12:00 PM UTC"})
+
+    assert_selector ".card__meta-text--added time", text: /\Ayesterday\z/i
+  end
+
+  test "a closed card's date is worded for the viewer" do
+    use_timezone "America/New_York"
+    card = cards(:logo)
+    card.close(user: users(:david))
+
+    sign_in_as(users(:david))
+    visit card_url(card)
+
+    expected = Time.current.in_time_zone("America/New_York").strftime("%b %-d")
+    assert_selector ".card__closed time", text: /\A#{Regexp.escape(expected)}\z/i
+
+    description = page.evaluate_async_script(<<~JS)
+      const done = arguments[arguments.length - 1]
+      import("helpers/date_helpers").then(({ textWithLocalTimes }) => {
+        done(textWithLocalTimes(document.querySelector(".card__closed[data-bridge-description]").dataset.bridgeDescription))
+      })
+    JS
+    assert_equal expected, description
+  end
+
+  private
+    def use_timezone(timezone_id)
+      @timezone_overridden = true
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone_id)
+    end
+
+    def format_times(requests)
+      page.evaluate_async_script(<<~JS, requests)
+        const done = arguments[arguments.length - 1]
+        import("helpers/date_helpers").then(({ formatTime }) => {
+          done(arguments[0].map(([ date, format, now ]) => formatTime(new Date(date), format, new Date(now))))
+        })
+      JS
+    end
+
+    # Noon in New York, so the wording doesn't depend on the time of day the suite runs.
+    def set_card_dates_relative_to_today(card, created_days_ago:, updated_days_ago:)
+      zone = ActiveSupport::TimeZone["America/New_York"]
+      today = Time.current.in_time_zone(zone).to_date
+
+      card.update_columns(
+        created_at: (today - created_days_ago).in_time_zone(zone).noon,
+        last_active_at: (today - updated_days_ago).in_time_zone(zone).noon
+      )
+    end
+end
