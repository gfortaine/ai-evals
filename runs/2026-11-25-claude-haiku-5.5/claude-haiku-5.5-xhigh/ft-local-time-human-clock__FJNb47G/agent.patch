diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..5bab38d
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  setup do
+    @time = Time.utc(2026, 9, 12, 13, 42)
+  end
+
+  test "local_time sends the instant in UTC for the browser to word" do
+    assert_equal "2026-09-12T13:42:00Z", local_time_element(@time)["datetime"]
+  end
+
+  test "local_time hands the element to the local-time controller with its format" do
+    assert_equal "local-time", local_time_element(@time)["data-controller"]
+    assert_equal "relative", local_time_element(@time)["data-local-time-format-value"]
+    assert_equal "date", local_time_element(@time, format: :date)["data-local-time-format-value"]
+  end
+
+  test "local_time falls back to the UTC time until the page script words it" do
+    assert_equal "Sep 12, 2026 1:42 PM UTC", local_time_element(@time).text
+  end
+
+  test "local_time keeps the instant regardless of the zone the request runs in" do
+    Time.use_zone("Asia/Tokyo") do
+      assert_equal "2026-09-12T13:42:00Z", local_time_element(@time)["datetime"]
+    end
+  end
+
+  test "local_time passes through attributes and keeps the shared class" do
+    time = local_time_element(@time, format: :time, class: "event__timestamp")
+
+    assert_equal %w[ local-time-value event__timestamp ], time["class"].split
+    assert_equal "time", time["data-local-time-format-value"]
+  end
+
+  private
+    def local_time_element(time, **options)
+      Nokogiri::HTML.fragment(local_time(time, **options)).at("time")
+    end
+end
