diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..6f285c9
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,35 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTime } from "helpers/date_helpers"
+
+// Words a <time> element's timestamp in the viewer's own timezone. The server
+// sends the instant in `datetime`; the text it renders is only a fallback.
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #observer
+
+  connect() {
+    // A Turbo morph can put the server's fallback text back without reconnecting
+    // this controller, so keep the words in sync with the timestamp.
+    this.#observer = new MutationObserver(() => this.#render())
+    this.#observer.observe(this.element, { childList: true, characterData: true, subtree: true })
+
+    this.#render()
+  }
+
+  disconnect() {
+    this.#observer.disconnect()
+  }
+
+  #render() {
+    const date = new Date(this.element.dateTime)
+
+    if (!Number.isNaN(date.getTime())) {
+      const text = formatTime(date, this.formatValue)
+
+      if (this.element.textContent !== text) {
+        this.element.textContent = text
+      }
+    }
+  }
+}
