+++ b/test/helpers/bridge_helper_test.rb
@@ -0,0 +1,16 @@
+require "test_helper"
+
+class BridgeHelperTest < ActionView::TestCase
+  test "bridged_share_url_button carries the card's raw timestamps for the browser to word" do
+    card = cards(:logo)
+    card.update!(created_at: Time.utc(2025, 9, 12, 17, 42), last_active_at: Time.utc(2025, 9, 14, 9, 0))
+
+    button = Nokogiri::HTML.fragment(bridged_share_url_button(card: bridge_share_card_data(card)))
+    share = JSON.parse(button.at_css("button")["data-bridge-share-card"])
+
+    assert_equal "2025-09-12T17:42:00Z", share["addedAt"]
+    assert_equal "2025-09-14T09:00:00Z", share["updatedAt"]
+    assert_equal card.creator.familiar_name, share["author"]
+    assert_equal card.assignees.map(&:familiar_name), share["assignees"]
+  end
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..989f094
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time_tag sends the UTC instant, whatever the server's timezone" do
+    Time.use_zone("Tokyo") do
+      assert_dom_equal \
+        %(<time datetime="2025-09-12T17:42:00Z" data-controller="local-time" data-local-time-format-value="relative">Sep 12, 2025, 5:42 PM UTC</time>),
+        local_time_tag(Time.zone.parse("2025-09-13 02:42"))
+    end
+  end
+
+  test "local_time_tag with format: :clock" do
+    assert_dom_equal \
+      %(<time datetime="2025-09-12T17:42:00Z" data-controller="local-time" data-local-time-format-value="clock">5:42 PM UTC</time>),
+      local_time_tag(Time.utc(2025, 9, 12, 17, 42), format: :clock)
+  end
+
+  test "local_date_tag shows the calendar date as written, whatever the timezone" do
+    Time.use_zone("Tokyo") do
+      assert_dom_equal \
+        %(<time datetime="2025-09-12" data-controller="local-time" data-local-time-format-value="date">Friday, September 12</time>),
+        local_date_tag(Time.zone.parse("2025-09-12 08:00"))
+    end
+  end
+
+  test "local_date_tag accepts a Date" do
+    assert_dom_equal \
+      %(<time datetime="2025-09-12" data-controller="local-time" data-local-time-format-value="date">Friday, September 12</time>),
+      local_date_tag(Date.new(2025, 9, 12))
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..c483bfd
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,102 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  # Far from UTC, so a time worded on the server's clock would read differently.
+  KIRITIMATI = "Pacific/Kiritimati"
+  NEW_YORK = "America/New_York"
+
+  teardown { use_browser_timezone "" }
+
+  test "comment times are worded in the viewer's timezone" do
+    use_browser_timezone KIRITIMATI
+    sign_in_as users(:david)
+    comment = comments(:logo_agreement_kevin)
+
+    comment.update!(created_at: local_noon(KIRITIMATI))
+    visit card_url(cards(:logo))
+    assert_comment_time comment, "12:00 PM"
+
+    comment.update!(created_at: local_noon(KIRITIMATI, days_ago: 1))
+    visit card_url(cards(:logo))
+    assert_comment_time comment, "yesterday"
+  end
+
+  test "a time is worded again when something replaces its server-rendered label" do
+    use_browser_timezone KIRITIMATI
+    sign_in_as users(:david)
+    comment = comments(:logo_agreement_kevin)
+    comment.update!(created_at: local_noon(KIRITIMATI))
+
+    visit card_url(cards(:logo))
+    assert_comment_time comment, "12:00 PM"
+
+    page.execute_script("arguments[0].textContent = 'Sep 1, 2000, 1:00 AM UTC'", find(comment_time_selector(comment)))
+    assert_comment_time comment, "12:00 PM"
+  end
+
+  test "uses the viewer's own timezone by default" do
+    use_browser_timezone "America/Los_Angeles"
+    sign_in_as users(:david)
+
+    assert_equal "10:42 AM", date_helper(:formatClock, Time.utc(2025, 9, 12, 17, 42))
+    assert_equal "Friday, September 12", date_helper(:formatCalendarDate, "2025-09-12")
+  end
+
+  test "relative days are worded in the given timezone" do
+    sign_in_as users(:david)
+    now = Time.utc(2025, 9, 12, 19) # 3:00 PM in New York
+
+    assert_equal "1:42 PM", date_helper(:formatRelative, Time.utc(2025, 9, 12, 17, 42), now, NEW_YORK)
+    assert_equal "yesterday", date_helper(:formatRelative, Time.utc(2025, 9, 12, 3, 30), now, NEW_YORK)
+    assert_equal "5 days ago", date_helper(:formatRelative, Time.utc(2025, 9, 7, 14), now, NEW_YORK)
+    assert_equal "Sep 3", date_helper(:formatRelative, Time.utc(2025, 9, 3, 14), now, NEW_YORK)
+    assert_equal "tomorrow", date_helper(:formatRelative, Time.utc(2025, 9, 13, 6), now, NEW_YORK)
+    assert_equal "in 3 days", date_helper(:formatRelative, Time.utc(2025, 9, 15, 13), now, NEW_YORK)
+    assert_equal "in 7 days", date_helper(:formatRelative, Time.utc(2025, 9, 19, 13), now, NEW_YORK)
+    assert_equal "Sep 20", date_helper(:formatRelative, Time.utc(2025, 9, 20, 13), now, NEW_YORK)
+    assert_equal "Dec 31, 2024", date_helper(:formatRelative, Time.utc(2024, 12, 31, 12), now, NEW_YORK)
+  end
+
+  test "the same instant falls on different days in different timezones" do
+    sign_in_as users(:david)
+    instant = Time.utc(2025, 9, 12, 2, 30)
+    now = Time.utc(2025, 9, 12, 19)
+
+    assert_equal "yesterday", date_helper(:formatRelative, instant, now, NEW_YORK) # 10:30 PM on the 11th
+    assert_equal "3:30 AM", date_helper(:formatRelative, instant, now, "Europe/London") # 3:30 AM on the 12th
+  end
+
+  test "counts calendar days across a daylight saving change" do
+    sign_in_as users(:david)
+
+    # 23:30 on March 9 is only an hour before midnight, but it is the previous calendar day.
+    assert_equal "yesterday", date_helper(:formatRelative, Time.utc(2025, 3, 10, 3, 30), Time.utc(2025, 3, 10, 4, 30), NEW_YORK)
+  end
+
+  private
+    def use_browser_timezone(zone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: zone)
+    end
+
+    def local_noon(zone, days_ago: 0)
+      Time.current.in_time_zone(zone).change(hour: 12) - days_ago.days
+    end
+
+    def comment_time_selector(comment)
+      "##{ActionView::RecordIdentifier.dom_id(comment)} .comment__permalink-title time"
+    end
+
+    def assert_comment_time(comment, text)
+      assert_selector comment_time_selector(comment), exact_text: text
+    end
+
+    # Calls a function from helpers/date_helpers.js inside the page, so the browser's own Intl does the work.
+    def date_helper(name, *args)
+      values = args.map { |arg| arg.is_a?(Time) ? "new Date(#{arg.utc.iso8601.to_json})" : arg.to_json }
+
+      page.evaluate_async_script(<<~JS)
+        const done = arguments[arguments.length - 1]
+        import("helpers/date_helpers").then((helpers) => done(helpers.#{name}(#{values.join(", ")})))
+      JS
+    end
+end
