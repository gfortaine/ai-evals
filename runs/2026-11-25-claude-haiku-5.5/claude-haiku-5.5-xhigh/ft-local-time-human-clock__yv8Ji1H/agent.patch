diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..5728514
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,48 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatCalendarDate, formatClock, formatFullDateTime, formatRelative } from "helpers/date_helpers"
+
+// Fills in a <time datetime="…"> with words in the viewer's own timezone. The server sends the UTC
+// timestamp and a neutral fallback label, so the markup is the same for everyone.
+//
+// format: "relative" (default) for "1:42 PM", "yesterday", "5 days ago", "Sep 12", "in 3 days";
+//         "clock" for "1:42 PM" only; "date" for a calendar date such as "Friday, September 12".
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #observer
+
+  connect() {
+    // Turbo morphs write the server's fallback label back into place without reconnecting this
+    // controller, so re-render whenever the content or the timestamp changes.
+    this.#observer = new MutationObserver(() => this.#render())
+    this.#observer.observe(this.element, {
+      childList: true, characterData: true, subtree: true,
+      attributes: true, attributeFilter: [ "datetime" ]
+    })
+
+    this.#render()
+  }
+
+  disconnect() {
+    this.#observer.disconnect()
+  }
+
+  #render() {
+    const datetime = this.element.getAttribute("datetime")
+
+    if (this.formatValue === "date") {
+      this.#show(formatCalendarDate(datetime))
+    } else {
+      const date = new Date(datetime)
+      const text = this.formatValue === "clock" ? formatClock(date) : formatRelative(date)
+
+      this.#show(text, formatFullDateTime(date))
+    }
+  }
+
+  // Only write when the text actually changes, so our own update doesn't re-trigger the observer.
+  #show(text, title) {
+    if (this.element.textContent !== text) this.element.textContent = text
+    if (title && this.element.title !== title) this.element.title = title
+  }
+}
