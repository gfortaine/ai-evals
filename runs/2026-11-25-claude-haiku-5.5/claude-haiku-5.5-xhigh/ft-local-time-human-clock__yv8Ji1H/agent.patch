diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..1008dd1 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,28 @@
 module TimeHelper
+  # Renders an instant as words in the viewer's own timezone (see controllers/local_time_controller.js).
+  # The server sends the UTC timestamp, and the fallback text is also UTC, so the markup is identical
+  # for everyone and can be cached and shared.
+  def local_time_tag(time, format: :relative)
+    tag.time local_time_fallback(time, format),
+      datetime: time.utc.iso8601,
+      data: { controller: "local-time", local_time_format_value: format }
+  end
+
+  # A calendar date has no instant to convert, so it is shown as written in every timezone.
+  def local_date_tag(date)
+    date = date.to_date
+
+    tag.time date.strftime("%A, %B %-d"),
+      datetime: date.iso8601,
+      data: { controller: "local-time", local_time_format_value: "date" }
+  end
+
+  private
+    def local_time_fallback(time, format)
+      if format == :clock
+        time.utc.strftime("%-l:%M %p UTC")
+      else
+        time.utc.strftime("%b %-d, %Y, %-l:%M %p UTC")
+      end
+    end
 end
