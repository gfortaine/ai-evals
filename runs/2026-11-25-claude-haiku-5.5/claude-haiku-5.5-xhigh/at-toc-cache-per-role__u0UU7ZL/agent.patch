diff --git a/test/controllers/books/table_of_contents_test.rb b/test/controllers/books/table_of_contents_test.rb
new file mode 100644
index 0000000..6b5c55e
--- /dev/null
+++ b/test/controllers/books/table_of_contents_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class Books::TableOfContentsTest < ActionDispatch::IntegrationTest
+  # The table of contents is fragment-cached, so these tests turn caching on
+  # (the test environment disables it) to exercise what other visitors see.
+  setup do
+    @previous_cache_store = ActionController::Base.cache_store
+    @previous_perform_caching = ActionController::Base.perform_caching
+    @previous_collection_cache = ActionView::PartialRenderer.collection_cache
+
+    ActionController::Base.cache_store = ActiveSupport::Cache::MemoryStore.new
+    ActionController::Base.perform_caching = true
+    ActionView::PartialRenderer.collection_cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    ActionController::Base.cache_store = @previous_cache_store
+    ActionController::Base.perform_caching = @previous_perform_caching
+    ActionView::PartialRenderer.collection_cache = @previous_collection_cache
+  end
+
+  test "a reader opening the book first does not hide editor controls from an editor" do
+    sign_in :jz
+    get book_slug_url(books(:handbook))
+    assert_no_edit_controls
+
+    sign_out
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_edit_controls
+  end
+
+  test "an editor opening the book first does not show editor controls to a reader" do
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_edit_controls
+
+    sign_out
+    sign_in :jz
+    get book_slug_url(books(:handbook))
+    assert_no_edit_controls
+  end
+
+  test "a signed out visitor never sees editor controls" do
+    books(:handbook).update!(published: true)
+
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_edit_controls
+
+    sign_out
+    get book_slug_url(books(:handbook))
+    assert_no_edit_controls
+  end
+
+  test "an editor losing edit rights stops seeing editor controls" do
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_edit_controls
+
+    accesses(:kevin_handbook).update!(level: :reader)
+
+    get book_slug_url(books(:handbook))
+    assert_no_edit_controls
+  end
+
+  test "a renamed entry shows its new title to the next visitor" do
+    sign_in :jz
+    get book_slug_url(books(:handbook))
+    assert_in_body "Welcome to The Handbook!"
+
+    sign_out
+    sign_in :kevin
+    put leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Better welcome" } }
+
+    sign_out
+    sign_in :jz
+    get book_slug_url(books(:handbook))
+    assert_in_body "Better welcome"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  private
+    def assert_edit_controls
+      assert_response :success
+      books(:handbook).leaves.active.each do |leaf|
+        assert_select "a[href=?]", edit_leafable_path(leaf), minimum: 1
+      end
+    end
+
+    def assert_no_edit_controls
+      assert_response :success
+      books(:handbook).leaves.active.each do |leaf|
+        assert_select "a[href=?]", edit_leafable_path(leaf), count: 0
+      end
+    end
+end
