diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..969a907 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,25 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Let controller errors reach the test as raised exceptions for the duration
+    # of the block, instead of rendering the error pages.
+    #
+    # Rails copies config.action_dispatch.show_exceptions into the memoized
+    # Rails.application.env_config the first time it is needed, and every request
+    # merges that hash into its env. Changing the config object later is ignored
+    # by requests (or, if it happens before the first request in a process, the
+    # stale value sticks for every later test). So flip the value on the hash the
+    # requests actually read, and put back whatever it was afterwards.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
-      yield
-    ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env = Rails.application.env_config
+      key = "action_dispatch.show_exceptions"
+      previous = env[key]
+      env[key] = :none
+      begin
+        yield
+      ensure
+        env[key] = previous
+      end
     end
   end
 end
