diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..3972f9a 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,30 @@
 module TimeHelper
+  # Renders a timestamp as a <time> element that the browser words in the viewer's own
+  # timezone (see controllers/local_time_controller.js). The markup carries the raw
+  # timestamp and never a clock, so it can be cached and shared between viewers.
+  #
+  #   :relative (default)  1:42 PM, yesterday, 5 days ago, Sep 12, tomorrow, in 3 days
+  #   :time                1:42 PM
+  #   :day                 Friday, September 12 (takes a date, not an instant)
+  def local_time(value, format: :relative, **attributes)
+    datetime, text = local_time_datetime_and_text(value, format)
+
+    tag.time text,
+      datetime: datetime,
+      data: { controller: "local-time", local_time_format_value: format, action: "turbo:morph-element->local-time#update:self" },
+      **attributes
+  end
+
+  private
+    # The text is only what the server can say without knowing the viewer's timezone. It shows
+    # until the browser replaces it.
+    def local_time_datetime_and_text(value, format)
+      if format == :day
+        date = value.to_date
+        [ date.iso8601, date.strftime("%A, %B %-d") ]
+      else
+        time = value.utc
+        [ time.iso8601, time.strftime("%b %-d, %Y %-l:%M %p UTC") ]
+      end
+    end
 end
