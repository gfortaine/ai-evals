diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..3b611c2
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,17 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/time_helpers"
+
+// Words the <time> element's raw timestamp in the viewer's own timezone. Rendered by
+// the `local_time` helper, which sends no clock time, so the HTML can be shared.
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.update()
+  }
+
+  // Also run after Turbo morphs the element, which puts back the server's text.
+  update() {
+    this.element.textContent = formatLocalTime(this.element.getAttribute("datetime"), this.formatValue)
+  }
+}
