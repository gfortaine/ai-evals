diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..a5adbfc
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time sends the UTC timestamp for the browser to word" do
+    html = Nokogiri::HTML::DocumentFragment.parse(local_time(Time.utc(2026, 11, 23, 4, 30)))
+
+    assert_select html, "time[datetime='2026-11-23T04:30:00Z'][data-controller='local-time'][data-local-time-format-value='relative']", text: "Nov 23, 2026 4:30 AM UTC"
+  end
+
+  test "local_time output does not depend on the timezone it is rendered in" do
+    time = Time.utc(2026, 11, 23, 4, 30)
+
+    utc = Time.use_zone("UTC") { local_time(time) }
+    tokyo = Time.use_zone("Asia/Tokyo") { local_time(time) }
+
+    assert_equal utc, tokyo
+  end
+
+  test "local_time reads a time in any zone as the same instant" do
+    expected = local_time(Time.utc(2026, 11, 23, 4, 30))
+
+    assert_equal expected, Time.use_zone("Asia/Tokyo") { local_time(Time.zone.parse("2026-11-23 13:30")) }
+    assert_equal expected, Time.use_zone("America/Los_Angeles") { local_time(Time.zone.parse("2026-11-22 20:30")) }
+  end
+
+  test "local_time takes a format" do
+    html = Nokogiri::HTML::DocumentFragment.parse(local_time(Time.utc(2026, 11, 23, 4, 30), format: :time))
+
+    assert_select html, "time[data-local-time-format-value='time']", text: "Nov 23, 2026 4:30 AM UTC"
+  end
+
+  test "local_time :day sends the calendar day and its heading" do
+    html = Nokogiri::HTML::DocumentFragment.parse(local_time(Date.new(2026, 11, 23), format: :day))
+
+    assert_select html, "time[datetime='2026-11-23'][data-local-time-format-value='day']", text: "Monday, November 23"
+  end
+
+  test "local_time :day takes the calendar day in the zone the server is rendering in" do
+    html = Nokogiri::HTML::DocumentFragment.parse(Time.use_zone("Asia/Tokyo") { local_time(Time.zone.local(2026, 11, 23, 1, 0).to_date, format: :day) })
+
+    assert_select html, "time[datetime='2026-11-23']"
+  end
+
+  test "local_time passes other attributes through" do
+    html = Nokogiri::HTML::DocumentFragment.parse(local_time(Time.utc(2026, 11, 23, 4, 30), class: "event__timestamp"))
+
+    assert_select html, "time.event__timestamp[data-controller='local-time']"
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..6d0a904
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,81 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as users(:kevin)
+  end
+
+  test "times are worded in the viewer's timezone" do
+    set_browser_timezone "Pacific/Kiritimati"
+
+    comment = create_comment_at 1.minute.ago
+    yesterday = create_comment_at 1.day.ago
+    three_days_ago = create_comment_at 3.days.ago
+    long_ago = create_comment_at 10.days.ago
+
+    visit card_url(cards(:logo))
+
+    assert_comment_time comment, local_time_in_zone(comment.created_at, "Pacific/Kiritimati", "%-l:%M %p")
+    assert_comment_time yesterday, "yesterday"
+    assert_comment_time three_days_ago, "3 days ago"
+    assert_comment_time long_ago, local_time_in_zone(long_ago.created_at, "Pacific/Kiritimati", "%b %-d")
+  end
+
+  test "times are updated after Turbo morphs them back to the server's text" do
+    set_browser_timezone "Pacific/Kiritimati"
+    comment = create_comment_at 3.days.ago
+
+    visit card_url(cards(:logo))
+    assert_comment_time comment, "3 days ago"
+
+    # Morph in the markup the server rendered, with the text it would render (its UTC fallback).
+    page.execute_script(<<~JS, dom_id(comment))
+      const [ commentId ] = arguments
+      const current = document.querySelector(`#${commentId} .comment__permalink-title time`)
+      const fresh = current.cloneNode(true)
+      fresh.textContent = "server text"
+      Turbo.morphElements(current, fresh)
+    JS
+
+    assert_comment_time comment, "3 days ago"
+  end
+
+  test "closed cards say when they were closed in the viewer's timezone" do
+    set_browser_timezone "Pacific/Kiritimati"
+    card = cards(:shipping)
+    card.closure.update!(created_at: 3.days.ago)
+
+    visit card_url(card)
+
+    assert_selector ".card-perma__closure-message time", text: /\A3 days ago\z/i
+    assert_selector ".card__closed-date", text: /\A3 days ago\z/i
+  end
+
+  test "the auto-close notice says in how many days the card moves to Not Now" do
+    set_browser_timezone "Pacific/Kiritimati"
+    card = cards(:logo)
+    days = (card.entropy.auto_clean_at.in_time_zone("Pacific/Kiritimati").to_date - Time.current.in_time_zone("Pacific/Kiritimati").to_date).to_i
+
+    visit card_url(card)
+
+    assert_selector "##{dom_id(card, :closure_notice)}", text: "Moves to “Not Now” in #{days} days if there’s no activity."
+  end
+
+  private
+    def set_browser_timezone(timezone_id)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone_id)
+    end
+
+    def create_comment_at(time)
+      cards(:logo).comments.create!(creator: users(:kevin), body: "Timed comment", created_at: time)
+    end
+
+    # The comment header is styled with text-transform: capitalize, so compare the words case-insensitively.
+    def assert_comment_time(comment, text)
+      assert_selector "##{dom_id(comment)} .comment__permalink-title time", text: /\A#{Regexp.escape(text)}\z/i
+    end
+
+    def local_time_in_zone(time, timezone_id, format)
+      time.in_time_zone(timezone_id).strftime(format)
+    end
+end
