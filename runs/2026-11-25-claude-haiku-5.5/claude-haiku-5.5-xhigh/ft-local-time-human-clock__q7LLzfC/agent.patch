diff --git a/app/javascript/helpers/time_helpers.js b/app/javascript/helpers/time_helpers.js
new file mode 100644
index 0000000..68f2f62
--- /dev/null
+++ b/app/javascript/helpers/time_helpers.js
@@ -0,0 +1,77 @@
+import { beginningOfDay, signedDifferenceInDays } from "helpers/date_helpers"
+
+const clockTimeFormatter = new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" })
+const shortDateFormatter = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" })
+const shortDateWithYearFormatter = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" })
+const dayHeadingFormatter = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", timeZone: "UTC" })
+
+// Words for a <time> element's datetime, in the viewer's own timezone. An instant
+// ("2025-09-12T13:42:00Z") is read in the browser's timezone. A calendar date
+// ("2025-09-12") names a day and is shown as that day, whatever the timezone.
+export function formatLocalTime(datetime, format = "relative", now = new Date()) {
+  if (format === "day") {
+    return dayHeadingFormatter.format(calendarDay(datetime))
+  } else if (format === "time") {
+    return clockTime(new Date(datetime))
+  } else {
+    return relativeTime(new Date(datetime), now)
+  }
+}
+
+// Plain text for markup containing <time> elements, such as a bridge description.
+export function localTimeText(html, now = new Date()) {
+  const template = document.createElement("template")
+  template.innerHTML = html
+
+  template.content.querySelectorAll("time[datetime]").forEach((time) => {
+    time.textContent = formatLocalTime(time.getAttribute("datetime"), time.dataset.localTimeFormatValue, now)
+  })
+
+  return template.content.textContent
+}
+
+function calendarDay(datetime) {
+  const calendarDate = datetime.match(/^(\d{4})-(\d{2})-(\d{2})$/)
+
+  if (calendarDate) {
+    return new Date(Date.UTC(calendarDate[1], calendarDate[2] - 1, calendarDate[3]))
+  } else {
+    return beginningOfDay(new Date(datetime))
+  }
+}
+
+function relativeTime(date, now) {
+  const days = signedDifferenceInDays(now, date)
+
+  if (date > now) {
+    if (days === 0) {
+      return "today"
+    } else if (days === 1) {
+      return "tomorrow"
+    } else {
+      return `in ${days} days`
+    }
+  } else {
+    if (days === 0) {
+      return clockTime(date)
+    } else if (days === -1) {
+      return "yesterday"
+    } else if (days >= -6) {
+      return `${-days} days ago`
+    } else {
+      return shortDate(date, now)
+    }
+  }
+}
+
+function clockTime(date) {
+  return clockTimeFormatter.format(date).replace(/\s/g, " ")
+}
+
+function shortDate(date, now) {
+  if (date.getFullYear() === now.getFullYear()) {
+    return shortDateFormatter.format(date)
+  } else {
+    return shortDateWithYearFormatter.format(date)
+  }
+}
