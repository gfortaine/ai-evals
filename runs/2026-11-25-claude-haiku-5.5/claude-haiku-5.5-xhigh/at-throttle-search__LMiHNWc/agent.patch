diff --git a/app/controllers/books/searches_controller.rb b/app/controllers/books/searches_controller.rb
index 5268c55..360f884 100644
--- a/app/controllers/books/searches_controller.rb
+++ b/app/controllers/books/searches_controller.rb
@@ -1,9 +1,44 @@
 class Books::SearchesController < ApplicationController
+  # Every search runs a full-text query, and a bot walking the library runs one
+  # per book. Each address gets SEARCH_LIMIT searches in any SEARCH_WINDOW
+  # seconds, across all books. Refused requests count too, so an address is
+  # served again once it has been quiet for a full window.
+  SEARCH_LIMIT = 30
+  SEARCH_WINDOW = 60 # seconds
+
   allow_unauthenticated_access
 
+  # Runs ahead of every other filter, so a refused request costs only a couple
+  # of cache operations and never reaches the book lookup or the search.
+  before_action :throttle_searches, only: :create, prepend: true
+
   include BookScoped
 
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
+
+  private
+    # Counts requests per address in one-second buckets and refuses once the
+    # buckets covering the last SEARCH_WINDOW seconds hold more than SEARCH_LIMIT.
+    # Each request increments its own bucket atomically before summing, so
+    # concurrent requests can't all slip under the limit together. If the store
+    # can't count (increment returns nil, e.g. Redis is unreachable), searches
+    # go through unthrottled rather than failing.
+    def throttle_searches
+      now = Time.current.to_i
+      return unless Rails.cache.increment(throttle_key(now), 1, expires_in: SEARCH_WINDOW.seconds)
+
+      buckets = ((now - SEARCH_WINDOW + 1)..now).map { |second| throttle_key(second) }
+      recent = Rails.cache.read_multi(*buckets, raw: true).values.sum(&:to_i)
+
+      if recent > SEARCH_LIMIT
+        response.headers["Retry-After"] = SEARCH_WINDOW.to_s
+        head :too_many_requests
+      end
+    end
+
+    def throttle_key(second)
+      "books/searches:throttle:#{request.remote_ip}:#{second}"
+    end
 end
diff --git a/test/controllers/books/searches_throttle_test.rb b/test/controllers/books/searches_throttle_test.rb
new file mode 100644
index 0000000..830b8bf
--- /dev/null
+++ b/test/controllers/books/searches_throttle_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Books::SearchesThrottleTest < ActionDispatch::IntegrationTest
+  ATTACKER = "203.0.113.10"
+  READER = "198.51.100.20"
+
+  setup do
+    @previous_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+
+    books(:handbook).update!(published: true)
+    books(:manual).update!(published: true)
+    Leaf.reindex_all
+
+    travel_to Time.zone.parse("2025-06-01 12:00:00")
+  end
+
+  teardown do
+    Rails.cache = @previous_cache
+  end
+
+  test "searches past the limit are refused with 429 and a retry hint" do
+    30.times { search books(:handbook), from: ATTACKER }
+
+    search books(:handbook), from: ATTACKER
+
+    assert_response :too_many_requests
+    assert_equal "60", response.headers["Retry-After"]
+    assert_empty response.body
+  end
+
+  test "the limit counts searches across every book" do
+    15.times { search books(:handbook), from: ATTACKER }
+    15.times { search books(:manual), from: ATTACKER }
+
+    search books(:handbook), from: ATTACKER
+
+    assert_response :too_many_requests
+  end
+
+  test "other addresses still get results from the same book" do
+    30.times { search books(:handbook), from: ATTACKER }
+    search books(:handbook), from: ATTACKER
+    assert_response :too_many_requests
+
+    search books(:handbook), from: READER
+
+    assert_response :success
+    assert_select "a.search__result", text: /Thanks for reading/i
+  end
+
+  test "a refused address can still open book pages" do
+    30.times { search books(:handbook), from: ATTACKER }
+    search books(:handbook), from: ATTACKER
+    assert_response :too_many_requests
+
+    get book_slug_path(books(:handbook)), env: { "REMOTE_ADDR" => ATTACKER }
+
+    assert_response :success
+  end
+
+  test "an address is served again within five minutes of its burst stopping" do
+    30.times { search books(:handbook), from: ATTACKER }
+    search books(:handbook), from: ATTACKER
+    assert_response :too_many_requests
+
+    travel 5.minutes
+
+    search books(:handbook), from: ATTACKER
+    assert_response :success
+  end
+
+  test "the limit is over any one-minute stretch, not reset at the minute mark" do
+    15.times { search books(:handbook), from: ATTACKER }
+    travel 30.seconds
+    15.times { search books(:handbook), from: ATTACKER }
+
+    # The 15 searches at +30s are still inside the minute, so only 15 more fit at +60s.
+    travel 30.seconds
+    15.times { search books(:handbook), from: ATTACKER; assert_response :success }
+
+    search books(:handbook), from: ATTACKER
+    assert_response :too_many_requests
+  end
+
+  private
+    def search(book, from:)
+      post book_search_path(book), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => from }
+    end
+end
