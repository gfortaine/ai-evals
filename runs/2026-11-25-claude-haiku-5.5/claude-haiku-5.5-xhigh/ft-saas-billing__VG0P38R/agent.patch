@@ -0,0 +1,26 @@
+# Support overrides for the numbers the plan limits are checked against.
+module Account::Overridable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  # A blank value leaves that number alone. Overriding with both blank resets.
+  def override_limits(card_count:, bytes_used:)
+    attributes = { card_count: card_count.presence, bytes_used: bytes_used.presence }
+
+    if attributes.values.all?(&:nil?)
+      reset_limit_overrides
+    elsif overridden_limit
+      overridden_limit.update!(attributes)
+    else
+      create_overridden_limit!(attributes)
+    end
+  end
+
+  def reset_limit_overrides
+    overridden_limit&.destroy
+    association(:overridden_limit).reset
+  end
+end
