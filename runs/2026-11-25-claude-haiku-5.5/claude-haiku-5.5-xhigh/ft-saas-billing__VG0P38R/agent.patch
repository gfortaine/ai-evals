diff --git a/saas/app/views/admin/accounts/index.html.erb b/saas/app/views/admin/accounts/index.html.erb
new file mode 100644
index 0000000..dff5bd8
--- /dev/null
+++ b/saas/app/views/admin/accounts/index.html.erb
@@ -0,0 +1,36 @@
+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <%= form_with url: saas.admin_accounts_path, method: :get, class: "flex gap-half" do |form| %>
+      <%= form.search_field :q, value: @query, placeholder: "Search by name or account number…", class: "input full-width", autofocus: @query.blank? %>
+      <%= form.submit "Search", name: nil, class: "btn" %>
+    <% end %>
+
+    <ul class="margin-block-half">
+      <% @accounts.each do |account| %>
+        <li class="flex align-start gap-half margin-block-start-half">
+          <div class="flex-item-grow min-width overflow-ellipsis" style="text-align: left">
+            <strong><%= link_to account.name, saas.admin_account_path(account) %></strong>
+            <br>
+            <span class="txt-x-small txt-ink-medium">
+              #<%= account.external_account_id %> •
+              <%= account.plan.name %> •
+              created <%= time_ago_in_words(account.created_at) %> ago
+            </span>
+          </div>
+        </li>
+      <% end %>
+    </ul>
+
+    <% if @accounts.empty? %>
+      <p class="txt-ink-medium">No accounts match “<%= @query %>”.</p>
+    <% elsif @accounts.size == Admin::AccountsController::MAX_ACCOUNTS_LISTED %>
+      <p class="txt-x-small txt-ink-medium">Showing the first <%= Admin::AccountsController::MAX_ACCOUNTS_LISTED %> accounts. Search to narrow the list.</p>
+    <% end %>
+  </div>
+</section>
diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..3eb0957
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,80 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title">
+    <%= link_to "Accounts", saas.admin_accounts_path, class: "txt-link" %> / <%= @account.name %>
+  </h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Plan</h2>
+    </header>
+
+    <dl class="margin-block-half">
+      <dt class="txt-x-small txt-ink-medium">Account</dt>
+      <dd>#<%= @account.external_account_id %> • created <%= time_ago_in_words(@account.created_at) %> ago</dd>
+
+      <dt class="txt-x-small txt-ink-medium margin-block-start-half">Plan</dt>
+      <dd>
+        <strong><%= @account.plan.name %></strong>
+        <% if @account.active_subscription %>
+          (subscription: <%= @account.active_subscription.status %>)
+        <% elsif @account.comped? %>
+          (comped)
+        <% end %>
+      </dd>
+
+      <dt class="txt-x-small txt-ink-medium margin-block-start-half">Comped</dt>
+      <dd><%= @account.comped? ? "Yes" : "No" %></dd>
+    </dl>
+
+    <% if @account.comped? %>
+      <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn" %>
+    <% else %>
+      <%= button_to "Comp", saas.admin_account_comp_path(@account), method: :post, class: "btn" %>
+    <% end %>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Usage and limits</h2>
+    </header>
+
+    <dl class="margin-block-half">
+      <dt class="txt-x-small txt-ink-medium">Cards</dt>
+      <dd>
+        <strong><%= number_with_delimiter(@account.card_count) %></strong>
+        of <%= @account.card_limit ? number_with_delimiter(@account.card_limit) : "unlimited" %>
+        <span class="txt-x-small txt-ink-medium">(actual: <%= number_with_delimiter(@account.cards_count) %>)</span>
+      </dd>
+
+      <dt class="txt-x-small txt-ink-medium margin-block-start-half">Storage</dt>
+      <dd>
+        <strong><%= number_to_human_size(@account.bytes_used) %></strong>
+        of <%= number_to_human_size(@account.storage_limit) %>
+        <span class="txt-x-small txt-ink-medium">(actual: <%= number_to_human_size(@account.storage_total&.bytes_stored || 0) %>)</span>
+      </dd>
+    </dl>
+
+    <%= form_with scope: :overridden_limit, url: saas.admin_account_override_path(@account), method: :post, class: "flex flex-column gap-half" do |form| %>
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, min: 0, class: "input", placeholder: "Leave blank to keep the actual count" %>
+      </div>
+
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, min: 0, class: "input", placeholder: "Leave blank to keep the actual usage" %>
+      </div>
+
+      <div class="flex gap-half">
+        <%= form.submit "Override", class: "btn" %>
+        <% if @account.overridden_limit %>
+          <%= button_to "Reset", saas.admin_account_override_path(@account), method: :delete, class: "btn btn--link" %>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+</section>
