@@ -0,0 +1,39 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "free plan includes 1,000 cards and 1 GB" do
+    assert_equal 1_000, Plan::FREE.card_limit
+    assert_equal 1.gigabyte, Plan::FREE.storage_limit
+    assert_equal 0, Plan::FREE.monthly_price
+    assert Plan::FREE.free?
+  end
+
+  test "paid plans have no card limit and bring their own storage" do
+    assert_nil Plan::UNLIMITED.card_limit
+    assert_equal 5.gigabytes, Plan::UNLIMITED.storage_limit
+    assert_equal 20, Plan::UNLIMITED.monthly_price
+
+    assert_nil Plan::UNLIMITED_PLUS.card_limit
+    assert_equal 500.gigabytes, Plan::UNLIMITED_PLUS.storage_limit
+    assert_equal 25, Plan::UNLIMITED_PLUS.monthly_price
+
+    assert_not Plan::UNLIMITED.free?
+  end
+
+  test "find looks plans up by key" do
+    assert_equal Plan::UNLIMITED_PLUS, Plan.find("unlimited_plus")
+    assert_nil Plan.find("platinum")
+  end
+
+  test "find_paid never returns the free plan" do
+    assert_nil Plan.find_paid("free")
+    assert_equal Plan::UNLIMITED, Plan.find_paid("unlimited")
+  end
+
+  test "stripe price ids map back to paid plans" do
+    assert_equal Plan::UNLIMITED, Plan.for_stripe_price_id("price_test_unlimited")
+    assert_equal Plan::UNLIMITED_PLUS, Plan.for_stripe_price_id("price_test_unlimited_plus")
+    assert_nil Plan.for_stripe_price_id("price_something_else")
+    assert_nil Plan.for_stripe_price_id(nil)
+  end
+end
