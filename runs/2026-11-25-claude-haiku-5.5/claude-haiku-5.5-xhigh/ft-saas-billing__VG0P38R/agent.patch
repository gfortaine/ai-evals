diff --git a/saas/lib/fizzy/saas/testing.rb b/saas/lib/fizzy/saas/testing.rb
index 3b40f02..8a30f23 100644
--- a/saas/lib/fizzy/saas/testing.rb
+++ b/saas/lib/fizzy/saas/testing.rb
@@ -18,3 +18,22 @@ module Fizzy::Saas::EngineFixtures
 end
 
 ActiveRecord::TestFixtures.singleton_class.prepend(Fizzy::Saas::EngineFixtures)
+
+# Stripe identifiers for tests. They match nothing real: every Stripe call is stubbed.
+ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_test_unlimited"
+ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] = "price_test_unlimited_plus"
+ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+
+# Writes to the SaaS database made after an HTTP request (sign_in_as makes some) can escape
+# the test's transaction, so account records would leak from one test into the next. Clear
+# them before the test's transaction begins, so no test sees another's billing or storage state.
+module Fizzy::Saas::TestIsolation
+  def before_setup
+    [ Account::Subscription, Account::OverriddenLimit, Account::BillingWaiver, Account::StorageException ].each(&:delete_all)
+    super
+  end
+end
+
+ActiveSupport.on_load(:active_support_test_case) do
+  prepend Fizzy::Saas::TestIsolation
+end
