@@ -0,0 +1,27 @@
+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @previous_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+
+    @book = books(:manual)
+
+    sign_in :david
+  end
+
+  teardown do
+    Rails.cache = @previous_cache
+  end
+
+  test "released book shows its final title in the recently updated list" do
+    patch book_release_url(@book), params: { book: { title: "Manual, Second Edition" } }
+    assert_redirected_to root_url
+
+    get root_url
+
+    assert_select ".library__recents strong", text: "Manual, Second Edition"
+    assert_select ".library__recents strong", text: "Manual", count: 0
+    assert_select ".library__recents span", text: "Published"
+  end
+end
diff --git a/test/models/book/recap_test.rb b/test/models/book/recap_test.rb
new file mode 100644
index 0000000..e76cca3
--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  setup do
+    @previous_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @previous_cache
+  end
+
+  test "renaming a book writes its recap" do
+    book = books(:handbook)
+    book.update!(title: "Handbook, Revised")
+
+    assert_equal({ title: "Handbook, Revised", published: false }, book.cached_recap)
+  end
+
+  test "saving one book does not overwrite another book's recap" do
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    handbook.update!(title: "Handbook, Revised")
+    manual.update!(title: "Manual, Revised")
+
+    assert_equal({ title: "Handbook, Revised", published: false }, handbook.cached_recap)
+    assert_equal({ title: "Manual, Revised", published: false }, manual.cached_recap)
+  end
+
+  test "recaps expire on the configured schedule" do
+    book = books(:handbook)
+    book.update!(title: "Handbook, Revised")
+
+    travel Rails.application.config.x.recap.expires_in - 1.second
+    assert_equal "Handbook, Revised", book.cached_recap[:title]
+
+    travel 2.seconds
+    assert_nil book.cached_recap
+  end
+end
diff --git a/test/models/book/release_test.rb b/test/models/book/release_test.rb
new file mode 100644
index 0000000..f5c5300
--- /dev/null
+++ b/test/models/book/release_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Book::ReleaseTest < ActiveSupport::TestCase
+  setup do
+    @previous_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @previous_cache
+  end
+
+  test "finalize_release writes the released title to the recap" do
+    book = Book.create!(title: "Working Title")
+
+    assert Book.finalize_release(book.id, title: "Final Title", subtitle: "A Subtitle")
+
+    assert_equal "Final Title", book.reload.title
+    assert_equal({ title: "Final Title", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release keeps the recap in sync with the stored book" do
+    book = Book.create!(title: "Working Title")
+
+    Book.finalize_release(book.id, title: "Final Title")
+
+    recap = Book.find(book.id).cached_recap
+    assert_equal book.reload.title, recap[:title]
+    assert recap[:published]
+  end
+
+  test "finalize_release does not touch other books' recaps" do
+    other = books(:manual)
+    other.update!(title: "Manual, Revised")
+    other_recap = other.cached_recap
+
+    book = Book.create!(title: "Working Title")
+    Book.finalize_release(book.id, title: "Final Title")
+
+    assert_equal other_recap, other.cached_recap
+    assert_equal({ title: "Manual, Revised", published: false }, other.cached_recap)
+  end
+
+  test "finalize_release recaps expire on the configured schedule" do
+    book = Book.create!(title: "Working Title")
+    Book.finalize_release(book.id, title: "Final Title")
+
+    assert_equal({ title: "Final Title", published: true }, book.cached_recap)
+
+    travel Rails.application.config.x.recap.expires_in - 1.second
+    assert_equal({ title: "Final Title", published: true }, book.cached_recap)
+
+    travel 2.seconds
+    assert_nil book.cached_recap
+  end
+
+  test "finalize_release returns false and writes nothing for a book that is not a draft" do
+    book = books(:handbook)
+    book.update!(published: true)
+    Rails.cache.clear
+
+    assert_not Book.finalize_release(book.id, title: "Whatever")
+    assert_equal "Handbook", book.reload.title
+    assert_nil book.cached_recap
+  end
+end
