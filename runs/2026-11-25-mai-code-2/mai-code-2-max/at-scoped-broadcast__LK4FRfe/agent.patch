@@ -1,6 +1,8 @@
 require "test_helper"
 
 class PagesControllerTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -79,7 +81,38 @@ class PagesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "With even more interesting words.", updated_page.body.content
   end
 
+  test "edit subscribes to a user-specific being edited stream" do
+    get edit_leafable_path(leaves(:welcome_page))
+
+    source = css_select("turbo-cable-stream-source").first
+    expected_stream = Turbo::StreamsChannel.signed_stream_name [ leaves(:welcome_page), users(:kevin), :being_edited ]
+
+    assert_equal expected_stream, source["signed-stream-name"]
+  end
+
+  test "queued being edited broadcasts respect current edit access" do
+    sign_in :jason
+
+    put leafable_path(leaves(:welcome_page)), params: {
+      leaf: { title: "Better welcome" }, page: { body: "Updated content" }
+    }
+
+    books(:handbook).access_for(user: users(:kevin)).update!(level: :reader)
+    perform_enqueued_jobs only: BeingEditedBroadcastJob
+
+    assert_broadcasts being_edited_stream_for(users(:david)), 1
+    assert_broadcasts being_edited_stream_for(users(:jason)), 1
+    assert_includes ActiveSupport::JSON.decode(broadcasts(being_edited_stream_for(users(:david))).first), "Jason"
+    assert_no_broadcasts being_edited_stream_for(users(:kevin))
+    assert_no_broadcasts being_edited_stream_for(users(:jz))
+    assert_no_broadcasts Turbo::StreamsChannel.send(:stream_name_from, [ leaves(:welcome_page), :being_edited ])
+  end
+
   private
+    def being_edited_stream_for(user)
+      Turbo::StreamsChannel.send(:stream_name_from, [ leaves(:welcome_page), user, :being_edited ])
+    end
+
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
     end
