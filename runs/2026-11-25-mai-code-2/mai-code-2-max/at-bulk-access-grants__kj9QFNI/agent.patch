diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..6b7215c
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Imported access", everyone_access: false)
+  end
+
+  test "imports all accesses and notifies each user" do
+    grants = [ users(:jz), users(:kevin) ].map { |user| { user_id: user.id, level: :reader } }
+    result = nil
+
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal grants.map { |grant| grant[:user_id] }, result.accesses.map(&:user_id)
+    assert result.accesses.all?(&:persisted?)
+  end
+
+  test "rejects the entire import and does not notify on a duplicate" do
+    grants = [
+      { user_id: users(:jz).id, level: :reader },
+      { user_id: users(:kevin).id, level: :editor },
+      { user_id: users(:jz).id, level: :editor }
+    ]
+    result = nil
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_empty result.accesses
+    assert_equal 2, result.duplicate_index
+    assert_empty @book.accesses.reload
+  end
+
+  test "rejects an unknown level without inserting or notifying" do
+    grants = [
+      { user_id: users(:jz).id, level: :reader },
+      { user_id: users(:kevin).id, level: :owner }
+    ]
+    result = nil
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_empty result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_empty @book.accesses.reload
+  end
+
+  test "inserts different sized imports with one access write" do
+    small_users = 4.times.map { |index| create_user(index) }
+    large_users = 16.times.map { |index| create_user(index + 4) }
+
+    small_writes = access_insert_writes do
+      Book::AccessImport.new(@book, grants_for(small_users)).import
+    end
+    large_book = Book.create!(title: "Large imported access", everyone_access: false)
+    large_writes = access_insert_writes do
+      Book::AccessImport.new(large_book, grants_for(large_users)).import
+    end
+
+    assert_equal 1, small_writes
+    assert_equal small_writes, large_writes
+
+    rejected_small_writes = access_insert_writes do
+      small_grants = grants_for(small_users)
+      small_book = Book.create!(title: "Rejected small import", everyone_access: false)
+      Book::AccessImport.new(small_book, small_grants << small_grants.first).import
+    end
+    rejected_large_writes = access_insert_writes do
+      large_grants = grants_for(large_users)
+      large_book = Book.create!(title: "Rejected large import", everyone_access: false)
+      Book::AccessImport.new(large_book, large_grants << large_grants.first).import
+    end
+
+    assert_equal rejected_small_writes, rejected_large_writes
+  end
+
+  private
+    def create_user(index)
+      User.create!(
+        name: "Import user #{index}",
+        email_address: "import-user-#{index}@example.com",
+        password_digest: "not-a-real-digest"
+      )
+    end
+
+    def grants_for(users)
+      users.map { |user| { user_id: user.id, level: :reader } }
+    end
+
+    def access_insert_writes(&block)
+      writes = 0
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, payload|
+        writes += 1 if payload[:sql].match?(/\AINSERT INTO "accesses"/)
+      end
+
+      block.call
+      writes
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+end
