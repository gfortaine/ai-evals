@@ -0,0 +1,46 @@
+class Export < ApplicationRecord
+  DOWNLOAD_EXPIRATION = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, { account: 0, cards: 1 }
+  generates_token_for :download, expires_in: DOWNLOAD_EXPIRATION
+
+  after_create_commit :build_later
+  validate :user_belongs_to_account
+
+  def build_later
+    ExportJob.perform_later(self)
+  end
+
+  def build_now
+    unless file.attached?
+      ZipFile.create_for(file, filename: filename) do |zip|
+        if account?
+          Account::DataTransfer::Manifest.new(account).export_to(zip)
+        else
+          User::CardsExport.new(user).export_to(zip)
+        end
+      end
+    end
+
+    AccountMailer.export_ready(self).deliver_later
+  end
+
+  def download_token
+    generate_token_for(:download)
+  end
+
+  def filename
+    owner = account? ? account.name : user.name
+    "#{owner.parameterize.presence || "fizzy"}-#{kind}.zip"
+  end
+
+  private
+    def user_belongs_to_account
+      errors.add(:user, "must belong to the account") unless user&.account_id == account_id
+    end
+end
