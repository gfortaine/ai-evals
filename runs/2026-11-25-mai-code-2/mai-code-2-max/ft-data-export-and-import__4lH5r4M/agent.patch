+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  teardown do
+    Export.find_each { |export| export.file.purge if export.file.attached? }
+  end
+
+  test "creating an export starts it in the background" do
+    assert_enqueued_with(job: ExportJob) do
+      @export = @account.exports.create!(user: @user, kind: :account)
+    end
+  end
+
+  test "builds an account archive" do
+    export = @account.exports.create!(user: @user, kind: :account)
+
+    export.build_now
+
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+
+    reader = ZipFile::Reader.new(export.file.blob)
+    assert reader.exists?("manifest.json")
+    assert reader.exists?("accounts/#{@account.id}.json")
+    assert reader.exists?("cards/#{cards(:logo).id}.json")
+    assert reader.exists?("comments/#{comments(:logo_agreement_jz).id}.json")
+  end
+
+  test "builds a card archive with comments and attachments" do
+    card = cards(:logo)
+    private_card = boards(:private).cards.create!(creator: users(:kevin), title: "Private", status: :drafted)
+    image = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("image"),
+      filename: "logo.png",
+      content_type: "image/png",
+      identify: false
+    )
+    card.image.attach(image)
+
+    comment_file = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("comment file"),
+      filename: "notes.txt",
+      content_type: "text/plain",
+      identify: false
+    )
+    comment = comments(:logo_agreement_jz)
+    comment.body = ActionText::Attachment.from_attachable(comment_file).to_html
+    comment.save!
+
+    export = @account.exports.create!(user: @user, kind: :cards)
+    export.build_now
+
+    reader = ZipFile::Reader.new(export.file.blob)
+    refute reader.exists?("cards/#{private_card.number}.json")
+    card_json = JSON.parse(reader.read("cards/#{card.number}.json"))
+    exported_comment = card_json.fetch("comments").find { |value| value["id"] == comment.id }
+
+    assert_equal "[notes.txt]", exported_comment.fetch("body")
+    assert_equal comment_file.filename.to_s, exported_comment.dig("attachments", 0, "filename")
+    assert_equal image.filename.to_s, card_json.dig("attachments", 0, "filename")
+    assert_equal "image", reader.read(card_json.dig("attachments", 0, "path"))
+    assert_equal "comment file", reader.read(exported_comment.dig("attachments", 0, "path"))
+  end
+end
