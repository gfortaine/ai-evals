+
+  test "reader streams files and verifies them" do
+    Tempfile.create([ "test", ".zip" ]) do |file|
+      writer = ZipFile::Writer.new(file)
+      writer.add_file("hello.txt", "Hello, World!")
+      writer.add_file("binary.data", "\x00\x01\x02", compress: false)
+      writer.close
+      file.rewind
+
+      reader = ZipFile::Reader.new(file)
+
+      assert_equal "Hello, World!", reader.read("hello.txt")
+      assert_equal "\x00\x01\x02".b, reader.read("binary.data")
+      assert_equal [ "binary.data", "hello.txt" ], reader.entries
+    end
+  end
+
+  test "writer records complete output size and checksum" do
+    Tempfile.create([ "test", ".zip" ]) do |file|
+      writer = ZipFile::Writer.new(file)
+      writer.add_file("hello.txt", "Hello, World!")
+      writer.close
+
+      assert_equal file.size, writer.byte_size
+      assert_equal Base64.strict_encode64(Digest::MD5.file(file.path).digest), writer.checksum
+    end
+  end
 end
