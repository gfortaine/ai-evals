@@ -0,0 +1,36 @@
+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  RESOURCES = {
+    "assignees" => User,
+    "boards" => Board,
+    "closers" => User,
+    "creators" => User,
+    "tags" => Tag
+  }.freeze
+
+  def initialize(account)
+    super(account: account, model: Filter)
+  end
+
+  protected
+    def record_attributes(record)
+      super.tap do |attributes|
+        RESOURCES.each_key do |association|
+          attributes["#{association}_ids"] = record.public_send(association).pluck(:id)
+        end
+      end
+    end
+
+    def virtual_attributes
+      RESOURCES.keys.map { |association| "#{association}_ids" }
+    end
+
+    def after_import(attributes, path, context)
+      filter = Filter.find(context.id_for(model, attributes["id"]))
+
+      RESOURCES.each do |association, resource_model|
+        source_ids = attributes["#{association}_ids"] || []
+        target_ids = source_ids.map { |source_id| context.id_for(resource_model, source_id) }
+        filter.public_send("#{association}=", resource_model.where(id: target_ids))
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/import.rb b/app/models/account/data_transfer/import.rb
new file mode 100644
index 0000000..dfa79aa
--- /dev/null
+++ b/app/models/account/data_transfer/import.rb
@@ -0,0 +1,178 @@
+class Account::DataTransfer::Import
+  class InvalidArchive < ZipFile::Reader::InvalidArchive; end
+
+  attr_reader :account, :identity
+
+  def initialize(source, identity:)
+    @source = source
+    @identity = identity
+  end
+
+  def import
+    reader = source.is_a?(ZipFile::Reader) ? source : ZipFile::Reader.new(source)
+    context = nil
+
+    ApplicationRecord.transaction do
+      context = Context.new(identity)
+
+      Current.with_account(context.account) do
+        Account::DataTransfer::Manifest.new(context.account).import_from(reader, context)
+        finalize_account(context)
+      end
+    end
+
+    @account = context.account
+  rescue ZipFile::Reader::InvalidArchive => error
+    context&.cleanup_uploaded_files
+    raise InvalidArchive, error.message
+  rescue ActiveRecord::RecordInvalid, ActiveRecord::StatementInvalid => error
+    context&.cleanup_uploaded_files
+    raise InvalidArchive, "The archive contains records that cannot be imported: #{error.message}"
+  rescue
+    context&.cleanup_uploaded_files
+    raise
+  end
+
+  private
+    attr_reader :source
+
+    def finalize_account(context)
+      account = context.account
+      create_required_account_records(account)
+      ensure_importer_access(account)
+      reconcile_storage(account)
+      rebuild_search(account)
+    end
+
+    def create_required_account_records(account)
+      account.create_join_code! unless account.join_code
+
+      unless account.users.exists?(role: :system)
+        account.users.create!(name: "System", role: :system)
+      end
+
+      unless account.entropies.exists?(container: account)
+        account.entropies.create!(
+          container: account,
+          auto_postpone_period: Account::Entropic::DEFAULT_ENTROPY_PERIOD
+        )
+      end
+    end
+
+    def ensure_importer_access(account)
+      user = account.users.find_or_initialize_by(identity: identity)
+      user.assign_attributes(
+        name: user.name.presence || identity.email_address.split("@").first.humanize,
+        role: :owner,
+        active: true,
+        verified_at: Time.current
+      )
+      user.save!
+
+      account.boards.find_each do |board|
+        board.accesses.grant_to(user) unless board.accessible_to?(user)
+      end
+    end
+
+    def reconcile_storage(account)
+      account.boards.find_each(&:reconcile_storage)
+      account.reconcile_storage
+    end
+
+    def rebuild_search(account)
+      account.cards.published.includes(:rich_text_description).find_each(&:reindex)
+      Comment.where(account: account)
+        .joins(:card)
+        .merge(Card.published)
+        .includes(:card, :rich_text_body)
+        .find_each(&:reindex)
+    end
+
+    class Context
+      ATTACHABLE_MODELS = {
+        "ActiveStorage::Blob" => ::ActiveStorage::Blob,
+        "User" => ::User
+      }.freeze
+
+      attr_reader :account, :identity
+
+      def initialize(identity)
+        @identity = identity
+        @id_maps = Hash.new { |maps, model| maps[model] = {} }
+        @all_ids = {}
+        @uploaded_files = []
+        @account = Account.new(
+          id: ActiveRecord::Type::Uuid.generate,
+          external_account_id: Account::ExternalIdSequence.next,
+          name: "Import in progress"
+        )
+      end
+
+      def register_id(model, source_id)
+        if source_id.blank?
+          invalid! "A record in #{model.table_name} has no ID"
+        end
+
+        target_id = model == Account ? account.id : ActiveRecord::Type::Uuid.generate
+        existing = @id_maps[model][source_id]
+        existing ||= @all_ids[source_id]
+
+        if existing && existing != target_id
+          invalid! "The archive contains conflicting IDs"
+        end
+
+        @id_maps[model][source_id] ||= target_id
+        @all_ids[source_id] ||= target_id
+      end
+
+      def id_for(model, source_id)
+        @id_maps[model].fetch(source_id) do
+          invalid! "The archive references a missing #{model.model_name.human.downcase}"
+        end
+      end
+
+      def ids_for(model)
+        @id_maps[model]
+      end
+
+      def remap(value)
+        case value
+        when Hash
+          value.transform_values { |nested_value| remap(nested_value) }
+        when Array
+          value.map { |nested_value| remap(nested_value) }
+        when String
+          @all_ids.fetch(value, value)
+        else
+          value
+        end
+      end
+
+      def account_imported!(imported_account)
+        @account = imported_account
+        Current.account = imported_account
+      end
+
+      def find_imported_attachable(type, source_id)
+        model = ATTACHABLE_MODELS[type]
+        invalid! "The archive contains an unsupported rich text attachment: #{type}" unless model
+        model.find(id_for(model, source_id))
+      end
+
+      def track_uploaded_blob(blob)
+        @uploaded_files << [ blob.service, blob.key ]
+      end
+
+      def cleanup_uploaded_files
+        @uploaded_files.each do |service, key|
+          service.delete(key)
+        rescue => error
+          Rails.error.report(error, handled: true, context: { storage_key: key })
+        end
+      end
+
+      def invalid!(message)
+        raise InvalidArchive, message
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/manifest.rb b/app/models/account/data_transfer/manifest.rb
index 53c14c4..6570b39 100644
--- a/app/models/account/data_transfer/manifest.rb
+++ b/app/models/account/data_transfer/manifest.rb
@@ -1,10 +1,36 @@
 class Account::DataTransfer::Manifest
+  FORMAT = "fizzy-account-export"
+  VERSION = 1
+  MANIFEST_PATH = "manifest.json"
+
   attr_reader :account
 
   def initialize(account)
     @account = account
   end
 
+  def export_to(zip)
+    zip.add_file MANIFEST_PATH, JSON.generate(
+      format: FORMAT,
+      version: VERSION,
+      exported_at: Time.current,
+      account_id: account.id
+    )
+
+    each_record_set do |record_set|
+      record_set.export_to(zip)
+    end
+  end
+
+  def import_from(zip, context)
+    validate_manifest(zip, context)
+    register_ids(zip, context)
+
+    each_record_set do |record_set|
+      record_set.import_from(zip, context)
+    end
