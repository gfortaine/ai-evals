@@ -3,13 +3,70 @@ class Account::DataTransfer::ActiveStorage::FileRecordSet < Account::DataTransfe
     super(account: account, model: ::ActiveStorage::Blob)
   end
 
+  def register_ids(zip, context)
+  end
+
+  def export_to(zip)
+    with_zip(zip) do
+      each_record do |blob|
+        zip.add_file(entry_path_for(blob.id, extension: "bin"), compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+    end
+  end
+
+  def import_from(zip, context)
+    expected_paths = context.ids_for(model).keys.map { |source_id| entry_path_for(source_id, extension: "bin") }
+
+    unless zip.glob("#{model_dir}/*.bin") == expected_paths.sort
+      context.invalid! "The archive's file list does not match its file metadata"
+    end
+
+    context.ids_for(model).each do |source_id, target_id|
+      blob = model.find(target_id)
+      checksum = nil
+
+      context.track_uploaded_blob(blob)
+      zip.with_file(
+        entry_path_for(source_id, extension: "bin"),
+        digest: blob.service.checksum_implementation
+      ) do |file|
+        unless file.size == blob.byte_size
+          context.invalid! "The size of #{source_id} does not match its metadata"
+        end
+
+        blob.service.upload(
+          blob.key,
+          file,
+          checksum: nil,
+          filename: blob.filename,
+          content_type: blob.content_type,
+          custom_metadata: blob.custom_metadata
+        )
+        checksum = file.checksum
+        if blob.service.respond_to?(:default_digest_type) && blob.service.default_digest_type != :md5
+          checksum = "#{blob.service.default_digest_type}:#{checksum}"
+        end
+      end
+
+      blob.update!(checksum: checksum)
+    end
+  end
+
   private
     def records
-      ::ActiveStorage::Blob.where(account: account).where.not(id: excluded_blob_ids)
+      ::ActiveStorage::Blob.where(account: account, id: referenced_blob_ids)
     end
 
-    def excluded_blob_ids
-      ::ActiveStorage::Attachment.where(account: account, record_type: INTERNAL_RECORD_TYPES).select(:blob_id)
+    def referenced_blob_ids
+      ::ActiveStorage::Attachment
+        .where(account: account)
+        .where.not(record_type: INTERNAL_RECORD_TYPES)
+        .select(:blob_id)
     end
 
+    def entry_path_for(id, extension:)
+      "#{model_dir}/#{id}.#{extension}"
+    end
 end
