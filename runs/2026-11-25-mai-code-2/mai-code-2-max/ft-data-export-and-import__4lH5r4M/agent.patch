+++ b/app/models/user/cards_export.rb
@@ -0,0 +1,124 @@
+class User::CardsExport
+  FORMAT = "fizzy-cards-export"
+  VERSION = 1
+
+  attr_reader :user
+
+  def initialize(user)
+    @user = user
+    @exported_blob_ids = Set.new
+  end
+
+  def export_to(zip)
+    @zip = zip
+    build_archive
+  ensure
+    @zip = nil
+  end
+
+  private
+    attr_reader :exported_blob_ids, :zip
+
+    def build_archive
+      zip.add_file "manifest.json", JSON.generate(
+        format: FORMAT,
+        version: VERSION,
+        exported_at: Time.current,
+        user: person_attributes(user)
+      )
+
+      cards.find_each do |card|
+        zip.add_file("cards/#{card.number}.json", JSON.pretty_generate(card_attributes(card)))
+      end
+    end
+
+    def cards
+      user.accessible_cards.preload(
+        :board,
+        :creator,
+        :column,
+        :image_attachment,
+        rich_text_description: :embeds_attachments
+      )
+    end
+
+    def card_attributes(card)
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        due_on: card.due_on,
+        created_at: card.created_at,
+        updated_at: card.updated_at,
+        board: { id: card.board_id, name: card.board.name },
+        column: card.column && { id: card.column_id, name: card.column.name },
+        creator: person_attributes(card.creator),
+        description: card.description.to_plain_text,
+        description_html: card.description.to_s,
+        attachments: attachments_for(card),
+        comments: comments_for(card).map do |comment|
+          {
+            id: comment.id,
+            creator: person_attributes(comment.creator),
+            created_at: comment.created_at,
+            updated_at: comment.updated_at,
+            body: comment.body.to_plain_text,
+            body_html: comment.body.to_s,
+            attachments: attachments_for(comment)
+          }
+        end
+      }
+    end
+
+    def comments_for(card)
+  card.comments.chronologically.includes(:creator, rich_text_body: :embeds_attachments)
+end
+
+def attachments_for(record)
+      blobs_for(record).map do |blob|
+        path = attachment_path(blob)
+        export_blob(blob, path)
+
+        {
+          id: blob.id,
+          filename: blob.filename.to_s,
+          content_type: blob.content_type,
+          byte_size: blob.byte_size,
+          path: path
+        }
+      end
+    end
+
+    def blobs_for(record)
+      blobs = []
+      blobs << record.image.blob if record.respond_to?(:image) && record.image.attached?
+
+      rich_text = if record.is_a?(Card)
+        record.rich_text_description
+      elsif record.is_a?(Comment)
+        record.rich_text_body
+      end
+      blobs.concat(rich_text.embeds.blobs.to_a) if rich_text
+      blobs.uniq(&:id)
+    end
+
+    def attachment_path(blob)
+      "attachments/#{blob.id}/#{blob.filename.sanitized}"
+    end
+
+    def export_blob(blob, path)
+      unless exported_blob_ids.include?(blob.id)
+        exported_blob_ids << blob.id
+        zip.add_file(path, compress: false) { |sink| blob.download { |chunk| sink.write(chunk) } }
+      end
+    end
+
+    def person_attributes(person)
+      {
+        id: person.id,
+        name: person.name,
+        email_address: person.identity&.email_address
+      }
+    end
+end
