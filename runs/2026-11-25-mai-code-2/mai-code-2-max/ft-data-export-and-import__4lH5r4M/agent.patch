diff --git a/test/models/account/data_transfer/import_test.rb b/test/models/account/data_transfer/import_test.rb
new file mode 100644
index 0000000..9b13a01
--- /dev/null
+++ b/test/models/account/data_transfer/import_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Account::DataTransfer::ImportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @identity = identities(:david)
+  end
+
+  teardown do
+    ActiveStorage::Blob.where(id: @created_blob_ids).find_each(&:purge) if @created_blob_ids
+    Storage::Entry.suppressing_recording { @imported_account&.destroy! }
+  end
+
+  test "restores the account with remapped people, cards, comments, and files" do
+    card = cards(:logo)
+    card.board.publish
+    publication_key = card.board.publication.key
+    image = attach_blob(card, "image.png", "image") do |blob|
+      card.image.attach(blob)
+    end
+    comment_file = attach_blob(comments(:logo_agreement_jz), "notes.txt", "comment file") do |blob|
+      comment = comments(:logo_agreement_jz)
+      comment.body = ActionText::Attachment.from_attachable(blob).to_html
+      comment.save!
+    end
+
+    @imported_account = with_archive_for(@account) do |reader|
+      Account::DataTransfer::Import.new(reader, identity: @identity).import
+    end
+
+    imported_card = @imported_account.cards.find_by!(number: card.number)
+    imported_comment = imported_card.comments.find_by!(created_at: comments(:logo_agreement_jz).created_at)
+    imported_user = @imported_account.users.find_by!(identity: @identity)
+
+    assert_not_equal @account.id, @imported_account.id
+    assert_not_equal @account.external_account_id, @imported_account.external_account_id
+    assert_not_equal card.id, imported_card.id
+    assert_equal @account.cards.count, @imported_account.cards.count
+    assert_equal Comment.where(account: @account).count, Comment.where(account: @imported_account).count
+    assert imported_user.owner?
+    assert imported_user.active?
+    assert_equal "image", imported_card.image.download
+    assert_equal "comment file", imported_comment.rich_text_body.embeds.blobs.first.download
+    refute_equal image.id, imported_card.image.blob.id
+    refute_equal comment_file.id, imported_comment.rich_text_body.embeds.blobs.first.id
+    refute_equal publication_key, imported_card.board.publication.key
+  end
+
+  test "removes uploaded files when an import fails" do
+  card = cards(:logo)
+  attach_blob(card, "image.png", "image") { |blob| card.image.attach(blob) }
+  service = ActiveStorage::Blob.service
+  uploaded_keys = []
+  service.stubs(:upload).with do |key, *_|
+    uploaded_keys << key
+    true
+  end.raises(IOError, "upload failed")
+
+  with_archive_for(@account) do |reader|
+    assert_no_difference -> { Account.count } do
+      assert_raises IOError do
+        Account::DataTransfer::Import.new(reader, identity: @identity).import
+      end
+    end
+  end
+
+  assert uploaded_keys.any?
+  assert uploaded_keys.none? { |key| service.exist?(key) }
+end
+
+test "rolls the account back when an archive contains invalid records" do
+    Tempfile.create([ "invalid-account", ".zip" ]) do |file|
+      writer = ZipFile::Writer.new(file)
+      writer.add_file "manifest.json", JSON.generate(
+        format: Account::DataTransfer::Manifest::FORMAT,
+        version: Account::DataTransfer::Manifest::VERSION
+      )
+      writer.add_file "accounts/#{@account.id}.json", JSON.generate(@account.attributes)
+      writer.add_file "users/#{users(:jz).id}.json", JSON.generate(
+        users(:jz).attributes.except("identity_id").merge("identity_email_address" => "not an email")
+      )
+      writer.close
+      file.rewind
+
+      assert_no_difference -> { Account.count } do
+        assert_no_difference -> { Identity.count } do
+          assert_raises Account::DataTransfer::Import::InvalidArchive do
+            Account::DataTransfer::Import.new(ZipFile::Reader.new(file), identity: @identity).import
+          end
+        end
+      end
+    end
+  end
+
+  private
+    def with_archive_for(account)
+      Tempfile.create([ "account", ".zip" ]) do |file|
+        writer = ZipFile::Writer.new(file)
+        Account::DataTransfer::Manifest.new(account).export_to(writer)
+        writer.close
+        file.rewind
+        yield ZipFile::Reader.new(file)
+      end
+    end
+
+    def attach_blob(record, filename, contents)
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(contents),
+        filename: filename,
+        identify: false
+      )
+      (@created_blob_ids ||= []) << blob.id
+      yield blob
+      blob
+    end
+end
