index 0000000..92cc1d3
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,228 @@
+class ZipFile::Reader
+  class InvalidArchive < StandardError; end
+
+  def initialize(source)
+    @io = source.respond_to?(:download_chunk) ? BlobIO.new(source) : source
+    @file_reader = ZipKit::FileReader.new
+    @entries = @file_reader.read_zip_structure(io: @io, read_local_headers: false)
+    validate_entries!
+  rescue ZipKit::FileReader::ReadError,
+    ZipKit::FileReader::UnsupportedFeature,
+    ZipKit::FileReader::MissingEOCD => error
+    raise InvalidArchive, "The file is not a valid ZIP archive: #{error.message}"
+  end
+
+  def entries
+    @entries_by_path.keys.sort
+  end
+
+  def glob(pattern)
+    entries.select { |path| File.fnmatch(pattern, path) }
+  end
+
+  def exists?(path)
+    @entries_by_path.key?(path)
+  end
+
+  def read(path, limit: nil)
+    entry = find_entry(path)
+
+    if limit && entry.uncompressed_size > limit
+      raise InvalidArchive, "#{path} is too large to read"
+    end
+
+    with_file(path) do |file|
+      value = +""
+
+      while chunk = file.read(256.kilobytes)
+        break if chunk.empty?
+
+        value << chunk
+
+        if limit && value.bytesize > limit
+          raise InvalidArchive, "#{path} exceeded the allowed size"
+        end
+      end
+
+      value
+    end
+  end
+
+  def with_file(path, digest: Digest::MD5)
+    raise ArgumentError, "No block given" unless block_given?
+
+    entry = find_entry(path)
+    prepare_entry_offset(entry)
+    file = EntryIO.new(entry.extractor_from(@io), entry, digest: digest)
+    result = yield file
+    file.verify!
+    result
+  end
+
+  private
+    def validate_entries!
+      @entries_by_path = {}
+
+      @entries.each do |entry|
+        path = entry.filename.to_s
+
+        unless safe_path?(path)
+          raise InvalidArchive, "The archive contains an unsafe path: #{path.inspect}"
+        end
+
+        if @entries_by_path.key?(path)
+          raise InvalidArchive, "The archive contains duplicate entries for #{path}"
+        end
+
+        if entry.gp_flags.anybits?(1)
+          raise InvalidArchive, "The archive contains encrypted files"
+        end
+
+        @entries_by_path[path] = entry
+      end
+    end
+
+    def safe_path?(path)
+      path.present? &&
+        !path.start_with?("/", "\\") &&
+        !path.match?(%r{(?:\A|/|\\)\.\.(?:/|\\|\z)}) &&
+        !path.include?("\0")
+    end
+
+    def find_entry(path)
+      @entries_by_path.fetch(path) do
+        raise InvalidArchive, "The archive is missing #{path}"
+      end
+    end
+
+    def prepare_entry_offset(entry)
+      unless entry.known_offset?
+        entry.compressed_data_offset = @file_reader.get_compressed_data_offset(
+          io: @io,
+          local_file_header_offset: entry.local_file_header_offset
+        )
+      end
+    end
+
+    class BlobIO
+      def initialize(blob)
+        @blob = blob
+        @position = 0
+      end
+
+      def size
+        @blob.byte_size
+      end
+
+      def tell
+        @position
+      end
+
+      def seek(position, mode = IO::SEEK_SET)
+        unless mode == IO::SEEK_SET
+          raise ArgumentError, "Unsupported seek mode"
+        end
+
+        @position = position.clamp(0, size)
+        0
+      end
+
+      def read(length = nil)
+        available = size - @position
+        length ||= available
+        return "" if length.zero?
+        return nil if available <= 0
+
+        length = [ length, available ].min
+        range = @position...(@position + length)
+        data = @blob.download_chunk(range).to_s
+        @position += data.bytesize
+        data
+      end
+    end
+
+    class EntryIO
+      CHUNK_SIZE = 256.kilobytes
+
+      attr_reader :position
+
+      def initialize(extractor, entry, digest: Digest::MD5)
+        @extractor = extractor
+        @entry = entry
+        @buffer = +""
+        @position = 0
+        @crc = 0
+        @digest = digest.new
+      end
+
+      def size
+        @entry.uncompressed_size
+      end
+
+      def eof?
+        @buffer.empty? && @extractor.eof?
+      end
+
+      def read(length = nil, output_buffer = nil)
+        return copy_to_output_buffer("", output_buffer) if length == 0
+        return nil if eof?
+
+        data = length ? read_up_to(length) : read_up_to(size - position)
+        return nil if data.nil?
+
+        copy_to_output_buffer(data, output_buffer)
+      end
+
+      def checksum
+        Base64.strict_encode64(@digest.digest)
+      end
+
+      def crc32
+        @crc
+      end
+
+      def verify!
+        unless position == size
+          raise InvalidArchive, "An archive entry ended after #{position} bytes instead of #{size}"
+        end
+
+        unless crc32 == @entry.crc32
+          raise InvalidArchive, "An archive entry has an invalid checksum"
+        end
+      end
+
+      private
+        def read_up_to(length)
+          result = +""
+
+          while result.bytesize < length && !eof?
+            fill_buffer
+            break if @buffer.empty?
+
+            amount = [ length - result.bytesize, @buffer.bytesize ].min
+            chunk = @buffer.slice!(0, amount)
+            @position += chunk.bytesize
+            @crc = Zlib.crc32(chunk, @crc)
+            @digest.update(chunk)
+            result << chunk
+          end
+
+          result.presence
+        end
+
+        def fill_buffer
+          while @buffer.empty? && !@extractor.eof?
+            chunk = @extractor.extract(CHUNK_SIZE)
+            @buffer << chunk.to_s if chunk.present?
+          end
+        end
+
+        def copy_to_output_buffer(data, output_buffer)
+          if output_buffer
+            output_buffer.replace(data)
+          else
+            data
+          end
+        end
+    end
+end
