+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  test "signed in people can open the import form" do
+    sign_in_as :david
+
+    get new_account_import_path
+
+    assert_response :success
+    assert_select "form[action='#{account_imports_path}'] input[type='file']"
+  end
+
+  test "a directly uploaded archive is sent to the import job" do
+    sign_in_as :david
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("zip contents"),
+      filename: "account.zip",
+      content_type: "application/zip"
+    )
+
+    assert_enqueued_with(job: Account::ImportJob) do
+      post account_imports_path, params: { import: { file: blob.signed_id } }
+    end
+
+    assert_redirected_to account_settings_path
+  end
+
+  test "rejects a missing or invalid upload" do
+    sign_in_as :david
+
+    post account_imports_path
+
+    assert_response :unprocessable_content
+    assert_select ".flash", text: /Choose a Fizzy account export/
+  end
+
+  test "rejects a blob uploaded to another account" do
+    sign_in_as :david
+    blob = Current.with_account(accounts(:initech)) do
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("zip contents"),
+        filename: "account.zip",
+        content_type: "application/zip"
+      )
+    end
+
+    assert_no_enqueued_jobs only: Account::ImportJob do
+      post account_imports_path, params: { import: { file: blob.signed_id } }
+    end
+
+    assert_response :unprocessable_content
+  end
+end
