diff --git a/app/jobs/account/import_job.rb b/app/jobs/account/import_job.rb
new file mode 100644
index 0000000..7cde507
--- /dev/null
+++ b/app/jobs/account/import_job.rb
@@ -0,0 +1,28 @@
+class Account::ImportJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(blob, identity)
+    account = begin
+      Account::DataTransfer::Import.new(blob, identity: identity).import
+    rescue => error
+      Rails.error.report(error, handled: true, context: { identity_id: identity.id })
+      AccountMailer.import_failed(identity, failure_reason(error)).deliver_later
+      nil
+    end
+
+    AccountMailer.import_complete(identity, account).deliver_later if account
+  ensure
+    blob.purge
+  end
+
+  private
+    def failure_reason(error)
+      if error.is_a?(Account::DataTransfer::Import::InvalidArchive)
+        error.message
+      else
+        "Fizzy could not complete the import because an unexpected error occurred."
+      end
+    end
+end
