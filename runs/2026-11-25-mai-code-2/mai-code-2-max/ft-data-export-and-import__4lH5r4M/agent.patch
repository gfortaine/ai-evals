diff --git a/test/jobs/account/import_job_test.rb b/test/jobs/account/import_job_test.rb
new file mode 100644
index 0000000..3257bdd
--- /dev/null
+++ b/test/jobs/account/import_job_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Account::ImportJobTest < ActiveJob::TestCase
+  test "notifies the requester and purges a failed upload" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("not a zip"),
+      filename: "broken.zip",
+      content_type: "application/zip"
+    )
+
+    assert_no_difference -> { Account.count } do
+      assert_enqueued_with(job: ActionMailer::MailDeliveryJob) do
+        Account::ImportJob.perform_now(blob, identities(:david))
+      end
+    end
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+  end
+
+  test "emails when an import succeeds" do
+    Tempfile.create([ "account", ".zip" ]) do |file|
+      writer = ZipFile::Writer.new(file)
+      Account::DataTransfer::Manifest.new(accounts(:"37s")).export_to(writer)
+      writer.close
+      file.rewind
+      blob = ActiveStorage::Blob.create_and_upload!(io: file, filename: "account.zip")
+
+      imported = nil
+      assert_difference -> { Account.count }, 1 do
+        assert_enqueued_with(job: ActionMailer::MailDeliveryJob) do
+          Account::ImportJob.perform_now(blob, identities(:david))
+        end
+      end
+
+      imported = identities(:david).accounts.where.not(id: accounts(:"37s")).first
+      assert imported
+      Storage::Entry.suppressing_recording { imported.destroy! }
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+    end
+  end
+end
