+  ID_ATTRIBUTE = "data-fizzy-attachable-id"
+
   def initialize(account)
     super(account: account, model: ::ActionText::RichText)
   end
 
+  protected
+    def record_attributes(record)
+      super.tap do |attributes|
+        content = ::ActionText::Content.new(attributes["body"])
+
+        content.attachments.each do |attachment|
+          if attachment.attachable.respond_to?(:id) && attachment.attachable.id.present?
+            attachment.node[TYPE_ATTRIBUTE] = attachment.attachable.class.base_class.name
+            attachment.node[ID_ATTRIBUTE] = attachment.attachable.id
+          end
+        end
