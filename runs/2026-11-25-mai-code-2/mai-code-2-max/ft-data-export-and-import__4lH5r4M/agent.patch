diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
new file mode 100644
index 0000000..6fb2908
--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,53 @@
+class Account::ImportsController < ApplicationController
+  def new
+  end
+
+  def create
+    blob = import_blob
+
+    begin
+      Current.without_account do
+        Account::ImportJob.perform_later(blob, Current.identity)
+      end
+    rescue
+      blob.purge
+      raise
+    end
+
+    redirect_to account_settings_path, notice: "We'll email you when your import finishes"
+  rescue ActionController::BadRequest => error
+    flash.now[:alert] = error.message
+    render :new, status: :unprocessable_content
+  end
+
+  private
+    def import_blob
+      upload = params[:file] || params.dig(:import, :file)
+
+      blob = case upload
+      when String
+        ActiveStorage::Blob.find_signed!(upload).tap do |signed_blob|
+          unless signed_blob.account_id == Current.account.id && signed_blob.attachments.none?
+            raise ActionController::BadRequest, "That upload is not available for this account"
+          end
+        end
+      when ActionDispatch::Http::UploadedFile
+        ActiveStorage::Blob.create_and_upload!(
+          io: upload,
+          filename: upload.original_filename,
+          content_type: upload.content_type
+        )
+      else
+        raise ActionController::BadRequest, "Choose a Fizzy account export to import"
+      end
+
+      unless blob.filename.extension.downcase == "zip"
+        blob.purge
+        raise ActionController::BadRequest, "The import must be a .zip file"
+      end
+
+      blob
+    rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+      raise ActionController::BadRequest, "The upload is invalid or has expired"
+    end
+end
