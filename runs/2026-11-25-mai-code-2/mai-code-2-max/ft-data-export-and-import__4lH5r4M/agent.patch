+    def attributes_for_import(attributes, context)
+      super.tap do |imported_attributes|
+        content = ::ActionText::Content.new(imported_attributes["body"])
+
+        content.fragment.find_all(::ActionText::Attachment.tag_name).each do |node|
+          type = node[TYPE_ATTRIBUTE]
+          source_id = node[ID_ATTRIBUTE]
+          next if type.blank? && source_id.blank?
+
+          context.invalid! "A rich text attachment is missing its portable identity" if type.blank? || source_id.blank?
+
+          attachable = context.find_imported_attachable(type, source_id)
+          attachment_attributes = attachable.to_rich_text_attributes.stringify_keys
+          attachment_attributes.each do |name, value|
+            node[name.to_s.dasherize] = value.to_s
+          end
+          node.remove_attribute(TYPE_ATTRIBUTE)
+          node.remove_attribute(ID_ATTRIBUTE)
+        end
+
+        imported_attributes["body"] = content.to_s
+      end
+    end
+
   private
     def records
       ::ActionText::RichText.where(account: account)
     end
-
 end
