diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..afc17ca
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,73 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as users(:kevin)
+  end
+
+  test "does not reorder cards dropped in the same column" do
+    card = cards(:logo)
+    column_selector = "##{dom_id(card.column)}"
+
+    visit board_url(card.board)
+    expand column_selector
+
+    card_order = all("#{column_selector} [data-drag-and-drop-target~='item']").map { |item| item[:id] }
+    last_active_at = card.last_active_at
+
+    find(".card-columns ##{dom_id(card, :article)}").drag_to find(column_selector)
+
+    assert_equal card_order, all("#{column_selector} [data-drag-and-drop-target~='item']").map { |item| item[:id] }
+    sleep 0.1
+    assert_equal last_active_at, card.reload.last_active_at
+  end
+
+  test "changes a card's column and status immediately" do
+    card = cards(:buy_domain)
+
+    visit board_url(card.board)
+
+    move_card card, "##{dom_id(columns(:writebook_in_progress))}"
+    wait_for { card.reload.column == columns(:writebook_in_progress) }
+    expand "##{dom_id(columns(:writebook_in_progress))}"
+
+    move_card card, "#not-now"
+    wait_for { card.reload.postponed? }
+    expand "#not-now"
+
+    move_card card, "#maybe"
+    wait_for { card.reload.awaiting_triage? }
+
+    move_card card, "#closed-cards"
+    wait_for { card.reload.closed? }
+    expand "#closed-cards"
+
+    move_card card, "##{dom_id(columns(:writebook_on_hold))}"
+    wait_for { card.reload.column == columns(:writebook_on_hold) && card.open? }
+  end
+
+  private
+    def move_card(card, destination_selector)
+      card_element = find(".card-columns ##{dom_id(card, :article)}")
+      source = card_element.find(:xpath, "ancestor::section[1]", visible: :all)
+      destination = find(destination_selector)
+      source_count = source.find(".cards__expander", visible: :all)["data-card-count"].to_i
+      destination_count = destination.find(".cards__expander", visible: :all)["data-card-count"].to_i
+
+      card_element.drag_to destination
+
+      assert_selector "#{destination_selector} ##{dom_id(card, :article)}", visible: :all
+      assert_equal source_count - 1, source.find(".cards__expander", visible: :all)["data-card-count"].to_i
+      assert_equal destination_count + 1, destination.find(".cards__expander", visible: :all)["data-card-count"].to_i
+    end
+
+    def expand(column_selector)
+      find("#{column_selector} .cards__expander").click
+    end
+
+    def wait_for
+      Timeout.timeout(Capybara.default_max_wait_time) do
+        sleep 0.05 until yield
+      end
+    end
+end
