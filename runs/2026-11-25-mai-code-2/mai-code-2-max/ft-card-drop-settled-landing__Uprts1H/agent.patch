diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..8a767b9
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,219 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const SAVE_OPTIONS = { responseKind: "json", keepalive: true }
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #draggedItem
+  #hoveredContainer
+  #saveQueues = new WeakMap()
+
+  connect() {
+    this.itemTargets.forEach(item => item.draggable = true)
+  }
+
+  disconnect() {
+    this.#finishDrag()
+    this.itemTargets.forEach(item => item.draggable = false)
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  dragstart(event) {
+    const item = this.#itemFor(event.target)
+
+    if (item) {
+      this.#draggedItem = item
+      item.classList.add(this.draggedItemClass)
+
+      if (event.dataTransfer) {
+        event.dataTransfer.effectAllowed = "move"
+        event.dataTransfer.setData("text/plain", item.id)
+      }
+    }
+  }
+
+  dragover(event) {
+    const container = this.#containerFor(event.target)
+
+    if (this.#draggedItem && container && this.#cardsContainer(container)) {
+      event.preventDefault()
+
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+      this.#highlight(container)
+    }
+  }
+
+  dragleave(event) {
+    if (this.#hoveredContainer && !this.#hoveredContainer.contains(event.relatedTarget)) {
+      this.#clearHover()
+    }
+  }
+
+  drop(event) {
+    const destination = this.#containerFor(event.target)
+    const item = this.#draggedItem
+
+    if (item && destination && this.#cardsContainer(destination)) {
+      event.preventDefault()
+
+      const source = this.#containerFor(item)
+
+      if (source && source !== destination) {
+        this.#moveItem(item, source, destination)
+        this.#queueSave(item, destination)
+      }
+    }
+
+    this.#finishDrag()
+  }
+
+  dragend() {
+    this.#finishDrag()
+  }
+
+  #itemFor(element) {
+    const item = element instanceof Element ? element.closest('[data-drag-and-drop-target~="item"]') : null
+    return item && this.itemTargets.includes(item) ? item : null
+  }
+
+  #containerFor(element) {
+    const container = element instanceof Element ? element.closest('[data-drag-and-drop-target~="container"]') : null
+    return container && this.containerTargets.includes(container) ? container : null
+  }
+
+  #cardsContainer(container) {
+    const list = container.querySelector(".cards__list")
+    return list?.querySelector(':scope > [data-controller~="pagination"] > turbo-frame') || list
+  }
+
+  #highlight(container) {
+    if (container !== this.#hoveredContainer) {
+      this.#clearHover()
+      container.classList.add(this.hoverContainerClass)
+      this.#hoveredContainer = container
+    }
+  }
+
+  #clearHover() {
+    this.#hoveredContainer?.classList.remove(this.hoverContainerClass)
+    this.#hoveredContainer = null
+  }
+
+  #moveItem(item, source, destination) {
+    const cardsContainer = this.#cardsContainer(destination)
+    const cards = Array.from(cardsContainer.querySelectorAll(':scope > [data-drag-and-drop-target~="item"]'))
+    const reference = this.#insertionReference(item, cards, cardsContainer, destination)
+
+    cardsContainer.insertBefore(item, reference)
+    this.#updateCard(item, destination)
+    this.#updateCount(source, -1)
+    this.#updateCount(destination, 1)
+  }
+
+  #insertionReference(item, cards, cardsContainer, destination) {
+    if (destination.dataset.dragAndDropOrder === "golden_first" && !item.classList.contains("golden-effect")) {
+      const firstNonGolden = cards.find(card => !card.classList.contains("golden-effect"))
+
+      if (firstNonGolden) {
+        return firstNonGolden
+      } else if (cards.length > 0) {
+        return cards[cards.length - 1].nextSibling
+      }
+    }
+
+    return cards[0] || cardsContainer.firstChild
+  }
+
+  #updateCard(item, destination) {
+    const destinationType = destination.dataset.dragAndDropDestination
+    const active = destinationType === "column" || destinationType === "stream"
+    const color = getComputedStyle(destination).getPropertyValue("--card-color").trim()
+
+    item.classList.toggle("card--active", active)
+    item.classList.toggle("card--postponed", destinationType === "not_now")
+    item.querySelectorAll(".card__closed").forEach(stamp => stamp.remove())
+
+    if (color) item.style.setProperty("--card-color", color)
+  }
+
+  #updateCount(container, delta) {
+    const counter = container.querySelector(".cards__expander[data-card-count]")
+
+    if (counter) {
+      const count = Math.max(0, Number(counter.dataset.cardCount) + delta)
+      const label = counter.querySelector(".cards__expander-count")
+
+      counter.dataset.cardCount = count
+      counter.style.setProperty("--card-count", Math.min(count, 15))
+      if (label) label.textContent = count > 99 ? "99+" : count
+    }
+  }
+
+  #queueSave(item, destination) {
+    const previousSave = this.#saveQueues.get(item) || Promise.resolve()
+    const move = {
+      destination: destination.dataset.dragAndDropDestination,
+      columnId: destination.dataset.dragAndDropColumnId,
+      triageUrl: item.dataset.cardTriageUrl,
+      notNowUrl: item.dataset.cardNotNowUrl,
+      closureUrl: item.dataset.cardClosureUrl
+    }
+    const save = previousSave.catch(() => undefined).then(() => this.#save(move))
+
+    this.#saveQueues.set(item, save)
+    save.then(
+      () => this.#clearSave(item, save),
+      error => {
+        this.#clearSave(item, save)
+        this.#handleSaveError(error)
+      }
+    )
+  }
+
+  async #save(move) {
+    let response
+
+    switch (move.destination) {
+      case "column":
+        response = await post(move.triageUrl, { ...SAVE_OPTIONS, body: { column_id: move.columnId } })
+        break
+      case "stream":
+        response = await destroy(move.triageUrl, SAVE_OPTIONS)
+        break
+      case "not_now":
+        response = await post(move.notNowUrl, SAVE_OPTIONS)
+        break
+      case "closed":
+        response = await post(move.closureUrl, SAVE_OPTIONS)
+        break
+      default:
+        throw new Error(`Unknown drag-and-drop destination: ${move.destination}`)
+    }
+
+    if (!response.ok) {
+      throw new Error(`Unable to move card: ${response.statusCode}`)
+    }
+  }
+
+  #clearSave(item, save) {
+    if (this.#saveQueues.get(item) === save) this.#saveQueues.delete(item)
+  }
+
+  #handleSaveError(error) {
+    console.error("Unable to move card", error)
+    window.location.reload()
+  }
+
+  #finishDrag() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#draggedItem = null
+    this.#clearHover()
+  }
+}
