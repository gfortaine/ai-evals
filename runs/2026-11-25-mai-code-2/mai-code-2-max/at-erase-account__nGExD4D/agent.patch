diff --git a/app/models/user/erasure.rb b/app/models/user/erasure.rb
new file mode 100644
index 0000000..a7e655b
--- /dev/null
+++ b/app/models/user/erasure.rb
@@ -0,0 +1,102 @@
+module User::Erasure
+  extend ActiveSupport::Concern
+
+  DEACTIVATED_EMAIL_SUFFIX = /-deactivated-[0-9a-f-]+(?=@)/i
+  DELETED_AUTHOR = "Deleted author"
+
+  included do
+    before_destroy :prepare_for_erasure, prepend: true
+    after_destroy_commit :purge_erased_blobs
+  end
+
+  def erase!
+    destroy!
+  end
+
+  def deactivate
+    erase!
+  end
+
+  private
+    def prepare_for_erasure
+      @erased_blob_ids = blob_ids_for(created_books.where(everyone_access: false).ids)
+
+      delete_sign_in_events
+      anonymize_everyone_books
+    end
+
+    def delete_sign_in_events
+      SignInEvent.where(email_address: sign_in_email_addresses).delete_all
+    end
+
+    def sign_in_email_addresses
+      addresses = [ email_address ]
+      addresses << email_address.sub(DEACTIVATED_EMAIL_SUFFIX, "") unless active?
+      addresses.uniq
+    end
+
+    def anonymize_everyone_books
+      created_books.with_everyone_access.update_all(
+        creator_id: nil,
+        author: DELETED_AUTHOR,
+        updated_at: Time.current
+      )
+      created_books.reset
+    end
+
+    def blob_ids_for(book_ids)
+      return [] if book_ids.empty?
+
+      references = Hash.new { |hash, key| hash[key] = [] }
+      references[Book.polymorphic_name].concat book_ids
+
+      leaf_rows = Leaf.where(book_id: book_ids).pluck(:id, :leafable_type, :leafable_id)
+      add_references references, leaf_rows.map { |_, type, id| [ type, id ] }
+
+      edit_rows = Edit.where(leaf_id: leaf_rows.map(&:first)).pluck(:leafable_type, :leafable_id)
+      add_references references, edit_rows
+
+      markdown_ids = ActionText::Markdown.where(
+        record_type: Page.polymorphic_name,
+        record_id: references[Page.polymorphic_name]
+      ).ids
+      references[ActionText::Markdown.polymorphic_name].concat markdown_ids
+
+      root_blob_ids = references.flat_map do |record_type, record_ids|
+        ActiveStorage::Attachment.where(record_type: record_type, record_id: record_ids.uniq).pluck(:blob_id)
+      end.uniq
+      blob_ids_with_derivatives(root_blob_ids)
+    end
+
+    def blob_ids_with_derivatives(root_blob_ids)
+      ordered_ids = []
+      pending_ids = root_blob_ids
+
+      while pending_ids.any?
+        ordered_ids.concat pending_ids
+        pending_ids = (derivative_blob_ids_for(pending_ids) - ordered_ids).uniq
+      end
+
+      ordered_ids
+    end
+
+    def derivative_blob_ids_for(blob_ids)
+      variant_record_ids = ActiveStorage::VariantRecord.where(blob_id: blob_ids).ids
+
+      ActiveStorage::Attachment.where(
+        record_type: ActiveStorage::Blob.polymorphic_name,
+        record_id: blob_ids
+      ).pluck(:blob_id) + ActiveStorage::Attachment.where(
+        record_type: ActiveStorage::VariantRecord.polymorphic_name,
+        record_id: variant_record_ids
+      ).pluck(:blob_id)
+    end
+
+    def add_references(references, rows)
+      rows.each { |record_type, record_id| references[record_type] << record_id }
+    end
+
+    def purge_erased_blobs
+      @erased_blob_ids.each { |blob_id| ActiveStorage::Blob.find_by(id: blob_id)&.purge }
+    end
+end
