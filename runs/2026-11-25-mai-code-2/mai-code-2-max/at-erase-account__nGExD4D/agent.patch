diff --git a/test/controllers/users_controller_test.rb b/test/controllers/users_controller_test.rb
index e0ca8db..fcdd5cd 100644
--- a/test/controllers/users_controller_test.rb
+++ b/test/controllers/users_controller_test.rb
@@ -78,4 +78,36 @@ class UsersControllerTest < ActionDispatch::IntegrationTest
     delete user_url(users(:david))
     assert_response :forbidden
   end
+
+  test "destroy erases the user row" do
+    sign_in :david
+
+    assert_difference -> { User.count }, -1 do
+      delete user_url(users(:kevin))
+    end
+
+    assert_redirected_to users_url
+    assert_not User.exists?(users(:kevin).id)
+  end
+
+  test "destroy erases legacy deactivated users and their sign in history" do
+    sign_in :david
+
+    user = users(:kevin)
+    original_address = user.email_address
+    deactivated_address = "kevin-deactivated-#{SecureRandom.uuid}@example.com"
+    user.update_columns(active: false, email_address: deactivated_address)
+    SignInEvent.create!(email_address: original_address, action: :signed_in)
+    SignInEvent.create!(email_address: deactivated_address, action: :signed_out)
+
+    get users_url
+    assert_response :success
+    assert_in_body user.name
+
+    delete user_url(user)
+
+    assert_redirected_to users_url
+    assert_not User.exists?(user.id)
+    assert_not SignInEvent.exists?(email_address: [ original_address, deactivated_address ])
+  end
 end
diff --git a/test/models/leaf/searchable_test.rb b/test/models/leaf/searchable_test.rb
index 4446433..06f1562 100644
--- a/test/models/leaf/searchable_test.rb
+++ b/test/models/leaf/searchable_test.rb
@@ -81,4 +81,17 @@ class Leaf::SearchableTest < ActiveSupport::TestCase
     leaves = Leaf.search("findme")
     assert_equal "<mark>findme</mark> fake highlight", leaves.first.title_match
   end
+
+  test "destroying a leaf removes stale search rows even when content is not searchable" do
+    section = Section.new(body: "stale erasure search words")
+    leaf = books(:manual).press(section, title: "Stale search result")
+    leaf.reindex
+    section.update!(body: nil)
+
+    assert_equal 1, ActiveRecord::Base.connection.select_value("select count(*) from leaf_search_index where rowid = #{leaf.id}")
+
+    leaf.destroy!
+
+    assert_equal 0, ActiveRecord::Base.connection.select_value("select count(*) from leaf_search_index where rowid = #{leaf.id}")
+  end
 end
diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..8086beb 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,57 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "erasing removes the user and private data but keeps everyone books readable" do
+    user = users(:kevin)
+    private_book = Book.create!(creator: user, title: "Private book", author: user.name, everyone_access: false)
+    everyone_book = Book.create!(creator: user, title: "Everyone book", author: user.name, everyone_access: true)
+
+    private_page = Page.new(body: "private erasure words")
+    private_leaf = private_book.press(private_page, title: "Private page")
+    revision = Page.create!(body: "private revision words")
+    edit = private_leaf.edits.revision.create!(leafable: revision)
+    public_leaf = everyone_book.press(Section.new(body: "public words"), title: "Public page")
+    picture = Picture.new
+    picture.image.attach(io: file_fixture("reading.webp").open, filename: "private.webp")
+    picture_leaf = private_book.press(picture, title: "Private picture")
+
+    private_book.cover.attach(io: file_fixture("pixel.bmp").open, filename: "private.bmp")
+    private_blob_id = private_book.cover.blob.id
+    picture_blob_id = picture.image.blob.id
+    variant_blob_id = picture.large_image.processed.blob.id
+    private_markdown_ids = ActionText::Markdown.where(record_type: "Page", record_id: [ private_page.id, revision.id ]).ids
+    private_search_index_id = private_leaf.id
+    private_leaf.reindex
+    public_leaf.reindex
+
+    session = Session.create!(user: user, ip_address: "192.0.2.1", user_agent: "Erasure test")
+    mark = ReadingMark.create!(user: user, leaf: leaves(:summary_page), last_read_at: Time.current)
+    user.created_books.load
+
+    user.erase!
+
+    assert_not User.exists?(user.id)
+    assert_not Session.exists?(session.id)
+    assert_not Access.exists?(user_id: user.id)
+    assert_not ReadingMark.exists?(mark.id)
+    assert_not SignInEvent.exists?(email_address: user.email_address)
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(private_search_index_id)
+    assert_not Leaf.exists?(picture_leaf.id)
+    assert_not Picture.exists?(picture.id)
+    assert_not Page.exists?(private_page.id)
+    assert_not Page.exists?(revision.id)
+    assert_not Edit.exists?(edit.id)
+    assert_not ActionText::Markdown.exists?(id: private_markdown_ids)
+    assert_not ActiveStorage::Blob.exists?(private_blob_id)
+    assert_not ActiveStorage::Blob.exists?(picture_blob_id)
+    assert_not ActiveStorage::Blob.exists?(variant_blob_id)
+    assert_equal 0, ActiveRecord::Base.connection.select_value("select count(*) from leaf_search_index where rowid = #{private_search_index_id}")
+
+    assert everyone_book.reload.creator.nil?
+    assert_equal "Deleted author", everyone_book.author
+    assert Leaf.exists?(public_leaf.id)
+    assert_equal 1, ActiveRecord::Base.connection.select_value("select count(*) from leaf_search_index where rowid = #{public_leaf.id}")
+  end
 end
