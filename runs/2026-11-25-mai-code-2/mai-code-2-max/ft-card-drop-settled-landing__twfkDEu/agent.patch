diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..6e6fa56
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,119 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    visit board_url(boards(:writebook))
+  end
+
+  test "moves a card immediately while the save is pending" do
+    card = cards(:buy_domain)
+    destination = columns(:writebook_review)
+
+    assert_draggable card
+    hold_network_requests
+    begin_drag card, destination
+
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item", visible: :all
+    assert_selector "##{dom_id(destination)}.drag-and-drop__hover-container", visible: :all
+
+    finish_drag card, destination
+    assert_selector "##{dom_id(destination)} ##{dom_id(card, :article)}[aria-busy]", visible: :all
+    assert_equal "0", page.evaluate_script("document.querySelector('#maybe .cards__expander-count').textContent")
+    assert_equal "1", page.evaluate_script("document.querySelector('##{dom_id(destination)} .cards__expander-count').textContent")
+  end
+
+  test "saves column and status moves without shifting the card" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_triage)
+
+    drag card, column
+    assert_equal dom_id(card, :article), card_order(column)[1]
+
+    wait_for_save card
+    assert_equal column, card.reload.column
+    assert_equal dom_id(card, :article), card_order(column)[1]
+
+    drag card, "closed-cards"
+    wait_for_save card
+    assert card.reload.closed?
+
+    drag card, "maybe"
+    wait_for_save card
+    assert card.reload.awaiting_triage?
+
+    drag card, "not-now"
+    wait_for_save card
+    assert card.reload.postponed?
+  end
+
+  test "does not reorder cards within a column" do
+    card = cards(:logo)
+    column = columns(:writebook_triage)
+    original_order = card_order(column)
+    original_event_count = Event.count
+
+    assert_draggable card
+    drag card, column
+
+    assert_equal original_order, card_order(column)
+    assert_equal original_event_count, Event.count
+  end
+
+  private
+    def card_order(column)
+      assert_selector "##{dom_id(column)} .cards__list", visible: :all
+
+      page.evaluate_script(<<~JS, dom_id(column))
+        Array.from(document.getElementById(arguments[0]).querySelectorAll(".card"), card => card.id)
+      JS
+    end
+
+    def assert_draggable(card)
+      assert_selector "##{dom_id(card, :article)}[draggable='true']", visible: :all
+    end
+
+    def hold_network_requests
+      page.execute_script("window.fetch = () => new Promise(() => {})")
+    end
+
+    def drag(card, destination)
+      begin_drag card, destination
+      finish_drag card, destination
+    end
+
+    def begin_drag(card, destination)
+      assert_selector "##{destination_id(destination)} .cards__list", visible: :all
+
+      page.execute_script(<<~JS, dom_id(card, :article), destination_id(destination))
+        const card = document.getElementById(arguments[0])
+        const destination = document.getElementById(arguments[1])
+        const dataTransfer = window.dragAndDropDataTransfer = new DataTransfer()
+
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        destination.dispatchEvent(new DragEvent("dragenter", { bubbles: true, cancelable: true, dataTransfer }))
+        destination.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+      JS
+    end
+
+    def finish_drag(card, destination)
+      page.execute_script(<<~JS, dom_id(card, :article), destination_id(destination))
+        const card = document.getElementById(arguments[0])
+        const destination = document.getElementById(arguments[1])
+        const dataTransfer = window.dragAndDropDataTransfer
+
+        destination.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer }))
+      JS
+    end
+
+    def destination_id(destination)
+      destination.respond_to?(:id) ? dom_id(destination) : destination
+    end
+
+    def wait_for_save(card)
+      assert_no_selector "##{dom_id(card, :article)}[aria-busy]", wait: 5
+    end
+end
