diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..77bbc89
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,326 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "card", "container" ]
+
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  connect() {
+    this.moveSequence = 0
+  }
+
+  disconnect() {
+    this.#clearDragState()
+    this.cardTargets.forEach(card => card.draggable = false)
+  }
+
+  cardTargetConnected(card) {
+    card.draggable = !card.hasAttribute("aria-busy")
+  }
+
+  cardTargetDisconnected(card) {
+    card.draggable = false
+  }
+
+  startDrag(event) {
+    const card = this.#cardFor(event.target)
+    if (!card || card.hasAttribute("aria-busy")) return
+
+    this.draggedCard = card
+    card.classList.add(this.draggedItemClass)
+    event.dataTransfer?.setData("text/plain", card.id)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+    }
+  }
+
+  hover(event) {
+    const container = this.#containerFor(event.target)
+    if (!this.draggedCard || !container) return
+
+    event.preventDefault()
+
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    this.#highlight(container)
+  }
+
+  leave(event) {
+    const container = this.#containerFor(event.target)
+    const nextContainer = this.#containerFor(event.relatedTarget)
+
+    if (container === this.hoveredContainer && nextContainer !== container) {
+      this.#clearHighlight()
+    }
+  }
+
+  drop(event) {
+    const card = this.draggedCard
+    const destination = this.#containerFor(event.target)
+
+    if (!card || !destination) return
+
+    event.preventDefault()
+    this.#clearHighlight()
+
+    const source = this.#containerFor(card)
+    if (source === destination) return
+
+    const move = this.#moveCard(card, source, destination)
+    this.#saveMove(card, destination, move)
+  }
+
+  endDrag() {
+    this.draggedCard?.classList.remove(this.draggedItemClass)
+    this.draggedCard = null
+    this.#clearHighlight()
+  }
+
+  // Private
+
+  #moveCard(card, source, destination) {
+    const originalCard = card.cloneNode(true)
+    originalCard.classList.remove(this.draggedItemClass)
+
+    const move = {
+      id: ++this.moveSequence,
+      source,
+      destination,
+      originalCard,
+      originalParent: card.parentElement,
+      originalNextSibling: card.nextSibling
+    }
+
+    this.#updateCard(card, destination)
+    this.#insertAtOrderedPosition(card, destination)
+    this.#updateCount(source, -1)
+    this.#updateCount(destination, 1)
+
+    card.dataset.dragAndDropMoveId = move.id
+    card.setAttribute("aria-busy", "true")
+
+    return move
+  }
+
+  async #saveMove(card, destination, move) {
+    try {
+      const response = await this.#requestMove(card, destination)
+
+      if (!response.ok) {
+        throw new Error(`Card move failed with status ${response.statusCode}`)
+      }
+
+      if (card.dataset.dragAndDropMoveId === String(move.id)) {
+        delete card.dataset.dragAndDropMoveId
+        card.removeAttribute("aria-busy")
+        card.draggable = true
+      }
+    } catch (error) {
+      this.#rollbackMove(card, move)
+      this.#showSaveError(error)
+    }
+  }
+
+  #requestMove(card, destination) {
+    // A Turbo Stream response would re-render the board after the optimistic move.
+    const options = { responseKind: "json" }
+
+    switch (destination.dataset.dragAndDropKind) {
+      case "column":
+        options.query = { column_id: destination.dataset.dragAndDropColumnId }
+        return post(card.dataset.cardTriageUrl, options)
+      case "stream":
+        return destroy(card.dataset.cardTriageUrl, options)
+      case "not_now":
+        return post(card.dataset.cardNotNowUrl, options)
+      case "closed":
+        return post(card.dataset.cardClosureUrl, options)
+      default:
+        return Promise.reject(new Error(`Unknown card destination: ${destination.dataset.dragAndDropKind}`))
+    }
+  }
+
+  #rollbackMove(card, move) {
+    if (card.dataset.dragAndDropMoveId !== String(move.id)) return
+
+    if (move.originalNextSibling?.parentElement === move.originalParent) {
+      move.originalParent.insertBefore(move.originalCard, move.originalNextSibling)
+    } else {
+      move.originalParent.append(move.originalCard)
+    }
+
+    card.remove()
+    this.#updateCount(move.source, 1)
+    this.#updateCount(move.destination, -1)
+  }
+
+  #insertAtOrderedPosition(card, destination) {
+    const list = this.#listFor(destination)
+    const cards = Array.from(list.querySelectorAll(".card"))
+    const ordersGoldenFirst = [ "column", "stream" ].includes(destination.dataset.dragAndDropKind)
+
+    if (ordersGoldenFirst && !card.classList.contains("golden-effect")) {
+      const firstRegularCard = cards.find(item => !item.classList.contains("golden-effect"))
+
+      if (firstRegularCard) {
+        firstRegularCard.before(card)
+      } else if (cards.length > 0) {
+        cards.at(-1).after(card)
+      } else {
+        list.prepend(card)
+      }
+    } else if (cards.length > 0) {
+      cards[0].before(card)
+    } else {
+      list.prepend(card)
+    }
+  }
+
+  #listFor(container) {
+    const existingList = container.querySelector(".cards__list")
+    if (existingList) return existingList
+
+    const list = document.createElement("div")
+    list.className = "cards__list hide-scrollbar"
+    const parent = container.querySelector(".cards__transition-container") || container
+    parent.append(list)
+
+    return list
+  }
+
+  #updateCard(card, destination) {
+    const kind = destination.dataset.dragAndDropKind
+    const active = kind === "column" || kind === "stream"
+
+    card.classList.toggle("card--active", active)
+    card.classList.toggle("card--postponed", kind === "not_now")
+    if (active) card.dataset.action = "mouseenter->navigable-list#hoverSelect"
+    card.querySelectorAll(".card__closed").forEach(stamp => stamp.remove())
+
+    if (kind === "not_now" || kind === "closed") {
+      this.#addStatusStamp(card, kind === "not_now" ? "Not Now" : "Done")
+    }
+
+    this.#updateColumn(card, destination, kind)
+  }
+
+  #updateColumn(card, destination, kind) {
+    const label = card.querySelector(".card__header > .card__column-name--current")
+    let columnId = kind === "column" ? destination.dataset.dragAndDropColumnId : ""
+
+    if (kind === "column") {
+      if (label) {
+        label.querySelector(".overflow-ellipsis").textContent = destination.dataset.columnName
+      } else {
+        this.#addColumnLabel(card, destination.dataset.columnName)
+      }
+    } else {
+      label?.remove()
+    }
+
+    if (kind === "closed") {
+      columnId = card.dataset.cardColumnId || ""
+    }
+
+    card.dataset.cardColumnId = columnId
+    card.querySelectorAll(".card__stages [data-card-column-id]").forEach(item => {
+      item.classList.toggle("card__column-name--current", item.dataset.cardColumnId === columnId)
+    })
+
+    if (kind === "column") {
+      card.style.setProperty("--card-color", destination.dataset.dragAndDropColor)
+    } else if (kind !== "closed") {
+      card.style.setProperty("--card-color", "var(--color-card-default)")
+    }
+  }
+
+  #addColumnLabel(card, name) {
+    const label = document.createElement("span")
+    label.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+
+    const text = document.createElement("span")
+    text.className = "overflow-ellipsis"
+    text.textContent = name
+    label.append(text)
+
+    card.querySelector(".card__header").append(label)
+  }
+
+  #addStatusStamp(card, title) {
+    const stamp = document.createElement("div")
+    stamp.className = "card__closed"
+
+    const text = document.createElement("span")
+    text.className = "card__closed-title"
+    text.dataset.text = title
+    text.textContent = title
+    stamp.append(text)
+
+    card.querySelector(".card__body").append(stamp)
+  }
+
+  #updateCount(container, difference) {
+    const counter = container?.querySelector(".cards__expander-count")
+    if (!counter) return
+
+    const count = Math.max(0, Number(counter.dataset.dragAndDropCount) + difference)
+    counter.dataset.dragAndDropCount = count
+    counter.textContent = count > 99 ? "99+" : count
+  }
+
+  #highlight(container) {
+    if (container === this.hoveredContainer) return
+
+    this.#clearHighlight()
+    this.hoveredContainer = container
+    container.classList.add(this.hoverContainerClass)
+  }
+
+  #clearHighlight() {
+    this.hoveredContainer?.classList.remove(this.hoverContainerClass)
+    this.hoveredContainer = null
+  }
+
+  #clearDragState() {
+    this.draggedCard?.classList.remove(this.draggedItemClass)
+    this.draggedCard = null
+    this.#clearHighlight()
+  }
+
+  #cardFor(element) {
+    const card = element instanceof Element ? element.closest('[data-drag-and-drop-target~="card"]') : null
+    return card && this.cardTargets.includes(card) ? card : null
+  }
+
+  #containerFor(element) {
+    const container = element instanceof Element ? element.closest('[data-drag-and-drop-target~="container"]') : null
+    return container && this.containerTargets.includes(container) ? container : null
+  }
+
+  #showSaveError(error) {
+    console.error("Unable to move card", error)
+
+    const frame = document.querySelector("turbo-frame#flash")
+    if (!frame) return
+
+    const flash = document.createElement("div")
+    flash.className = "flash"
+    flash.dataset.controller = "element-removal"
+    flash.dataset.action = "animationend->element-removal#remove"
+
+    const message = document.createElement("div")
+    message.className = "flash__inner shadow"
+    message.textContent = "Couldn't move the card. Try again."
+    flash.append(message)
+
+    frame.replaceChildren(flash)
+  }
+}
