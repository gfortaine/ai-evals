+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,60 @@
+class Api::V1::UsersController < Api::V1::BaseController
+  before_action :set_account
+  before_action :authenticate_user!
+  before_action :require_active_account!
+  before_action :require_admin!
+  before_action :set_user, only: %i[show update]
+
+  def index
+    scope = current_account.users
+    if params.key?(:role)
+      role = params[:role].to_s
+      raise ActionController::BadRequest, "role is invalid" unless User::ROLES.include?(role)
+
+      scope = scope.where(role: role)
+    end
+    scope = scope.where(suspended: boolean_filter(:suspended)) if params.key?(:suspended)
+
+    users, pagination = paginate(scope.order(id: :asc))
+    render json: { users: users.map { |user| user_json(user) } }.merge(pagination)
+  end
+
+  def show
+    render json: { user: user_json(@user) }
+  end
+
+  def update
+    user_params = params.require(:user)
+    attributes = {}
+    attributes[:role] = user_params[:role] if user_params.key?(:role)
+    attributes[:suspended] = user_params[:suspended] if user_params.key?(:suspended)
+    raise ActionController::BadRequest, "No user attributes supplied" if attributes.empty?
+
+    current_account.with_lock do
+      @user = current_account.users.lock.find(params[:id])
+      @user.update!(attributes)
+
+      unless @user.active_staff?
+        @user.sessions.delete_all
+        @user.assigned_tickets.update_all(assignee_id: nil)
+      end
+    end
+
+    render json: { user: user_json(@user) }
+  end
+
+  private
+
+  def set_user
+    @user = current_account.users.find(params[:id])
+  end
+
+  def boolean_filter(name)
+    case params[name].to_s
+    when "true", "1" then true
+    when "false", "0" then false
+    else
+      raise ActionController::BadRequest, "#{name} must be true or false"
+    end
+  end
+end
