@@ -0,0 +1,128 @@
+require "uri"
+
+class Invitation < ApplicationRecord
+  STATUSES = %w[pending accepted revoked expired].freeze
+  ROLES = %w[admin agent].freeze
+  TOKEN_LIFETIME = 7.days
+
+  belongs_to :account
+  belongs_to :invited_by, class_name: "User", optional: true, inverse_of: :sent_invitations
+  belongs_to :accepted_user,
+    class_name: "User",
+    optional: true,
+    inverse_of: :accepted_invitation
+
+  before_validation :normalize_email
+
+  validates :email,
+    presence: true,
+    length: { maximum: 254 },
+    format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :role, inclusion: { in: ROLES }
+  validates :status, inclusion: { in: STATUSES }
+  validates :sent_at, :expires_at, presence: true
+  validates :token_digest, presence: true, if: :pending?
+  validate :email_is_not_registered, if: :pending?
+  validate :only_one_pending_invitation, if: :pending?
+
+  scope :pending, -> { where(status: "pending") }
+  scope :oldest_first, -> { order(id: :asc) }
+
+  def self.digest_token(token)
+    Digest::SHA256.hexdigest(token.to_s)
+  end
+
+  def self.find_by_token(token)
+    return if token.blank?
+
+    find_by(token_digest: digest_token(token))
+  end
+
+  def self.expire_due!(account: nil, email: nil, now: Time.current)
+    scope = pending.where("expires_at <= ?", now)
+    scope = scope.where(account: account) if account
+    scope = scope.where(email: email) if email
+    scope.update_all(status: "expired", token_digest: nil, updated_at: now)
+  end
+
+  def issue_token
+    token = SecureRandom.urlsafe_base64(32)
+    issued_at = Time.current
+    self.status = "pending"
+    self.token_digest = self.class.digest_token(token)
+    self.sent_at = issued_at
+    self.expires_at = issued_at + TOKEN_LIFETIME
+    self.accepted_at = nil
+    self.revoked_at = nil
+    self.accepted_user = nil
+    token
+  end
+
+  def issue_token!
+    token = issue_token
+    save!
+    token
+  end
+
+  def token_valid?(token)
+    return false unless pending? && token_digest.present? && expires_at.future?
+    return false if token.blank?
+
+    ActiveSupport::SecurityUtils.secure_compare(
+      self.class.digest_token(token),
+      token_digest
+    )
+  end
+
+  def expire_if_needed!
+    return self unless pending? && !expires_at.future?
+
+    update_columns(status: "expired", token_digest: nil, updated_at: Time.current)
+    self
+  end
+
+  def revoke!
+    update!(
+      status: "revoked",
+      token_digest: nil,
+      revoked_at: Time.current
+    )
+  end
+
+  def pending?
+    status == "pending"
+  end
+
+  def accepted?
+    status == "accepted"
+  end
+
+  def revoked?
+    status == "revoked"
+  end
+
+  def expired?
+    status == "expired"
+  end
+
+  private
+
+  def normalize_email
+    self.email = email.to_s.strip.downcase if email
+  end
+
+  def email_is_not_registered
+    return unless account_id && email.present?
+    return unless account.users.exists?(email: email)
+
+    errors.add(:email, "is already registered")
+  end
+
+  def only_one_pending_invitation
+    return unless account_id && email.present?
+
+    competing = account.invitations.where(email: email, status: "pending")
+    competing = competing.where.not(id: id) if persisted?
+    errors.add(:email, "already has a pending invitation") if competing.exists?
+  end
+end
