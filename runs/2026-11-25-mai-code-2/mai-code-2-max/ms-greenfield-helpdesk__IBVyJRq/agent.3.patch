diff --git a/test/integration/staff_management_api_test.rb b/test/integration/staff_management_api_test.rb
new file mode 100644
index 0000000..8cdb7ed
--- /dev/null
+++ b/test/integration/staff_management_api_test.rb
@@ -0,0 +1,342 @@
+require "test_helper"
+require "uri"
+
+class StaffManagementApiTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @owner = create_user(
+      name: "Jo",
+      email: "jo@acme.test",
+      role: "admin",
+      owner: true
+    )
+    @owner_token = issue_token(@owner)
+  end
+
+  test "admins invite, preview, resend, accept, and sign in staff" do
+    post "/api/v1/invitations",
+      params: { invitation: { email: "SAM@example.test", role: "agent" } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+
+    assert_response :created
+    invitation = response.parsed_body.fetch("invitation")
+    invitation_id = invitation.fetch("id")
+    assert_equal "sam@example.test", invitation["email"]
+    assert_equal "agent", invitation["role"]
+    assert_equal "pending", invitation["status"]
+    assert_match %r{\Ahttp://localhost:3001/accept-invitation\?account=acme&token=}, latest_mail_link
+
+    old_token = token_from_latest_mail
+    post "/invitation_previews",
+      params: { invitation_preview: { token: old_token } },
+      as: :json
+
+    assert_response :success
+    preview = response.parsed_body.fetch("invitation_preview")
+    assert_equal "sam@example.test", preview["email"]
+    assert_equal "agent", preview["role"]
+    assert_equal "Acme", preview["business_name"]
+    assert_equal "acme", preview["subdomain"]
+    assert preview["expires_at"]
+
+    post "/api/v1/invitations/#{invitation_id}/resend",
+      headers: authenticated_headers(@owner_token),
+      as: :json
+
+    assert_response :success
+    new_token = token_from_latest_mail
+    refute_equal old_token, new_token
+
+    post "/api/v1/invitation_previews",
+      params: { invitation_preview: { token: old_token } },
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/invitation_acceptances",
+      params: {
+        invitation_acceptance: {
+          token: new_token,
+          name: "Sam",
+          password: "my-team-password"
+        }
+      },
+      as: :json
+
+    assert_response :created
+    accepted = response.parsed_body
+    assert_equal "Sam", accepted.dig("user", "name")
+    assert_equal "agent", accepted.dig("user", "role")
+    assert_equal true, accepted.dig("user", "verified")
+    assert_equal false, accepted.dig("user", "suspended")
+    assert_equal "Acme", accepted.dig("account", "name")
+    assert_equal "accepted", Invitation.find(invitation_id).status
+
+    post "/api/v1/sessions",
+      params: {
+        session: {
+          email: "sam@example.test",
+          password: "my-team-password"
+        }
+      },
+      headers: account_headers,
+      as: :json
+    assert_response :success
+
+    post "/api/v1/invitation_acceptances",
+      params: {
+        invitation_acceptance: {
+          token: new_token,
+          name: "Sam Again",
+          password: "another-password"
+        }
+      },
+      as: :json
+    assert_response :unprocessable_content
+  end
+
+  test "pending invitations reserve email addresses and states are filterable" do
+    first = create_invitation(email: "sam@example.test", role: "agent")
+    second = create_invitation(email: "ren@example.test", role: "admin")
+
+    post "/api/v1/invitations",
+      params: { invitation: { email: "SAM@example.test", role: "admin" } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal 2, @account.invitations.count
+
+    post "/api/v1/registrations",
+      params: {
+        user: {
+          name: "Customer",
+          email: "sam@example.test",
+          password: "customer-password"
+        }
+      },
+      headers: account_headers,
+      as: :json
+    assert_response :unprocessable_content
+
+    delete "/api/v1/invitations/#{first.id}",
+      headers: authenticated_headers(@owner_token)
+    assert_response :no_content
+    assert_equal "revoked", first.reload.status
+
+    post "/api/v1/registrations",
+      params: {
+        user: {
+          name: "Customer",
+          email: "sam@example.test",
+          password: "customer-password"
+        }
+      },
+      headers: account_headers,
+      as: :json
+    assert_response :created
+
+    get "/api/v1/invitations",
+      params: { status: "pending" },
+      headers: authenticated_headers(@owner_token)
+    assert_response :success
+    assert_equal [ second.id ], response.parsed_body.fetch("invitations").pluck("id")
+
+    get "/api/v1/invitations",
+      headers: authenticated_headers(@owner_token)
+    assert_response :success
+    assert_equal [ first.id, second.id ], response.parsed_body.fetch("invitations").pluck("id")
+
+    get "/api/v1/invitations/#{second.id}",
+      headers: authenticated_headers(@owner_token)
+    assert_response :success
+    assert_equal "pending", response.parsed_body.dig("invitation", "status")
+  end
+
+  test "expired invitations become trackable and can be renewed" do
+    invitation = create_invitation(email: "expired@example.test")
+    token = token_from_latest_mail
+    invitation.update_column(:expires_at, 1.minute.ago)
+
+    post "/api/v1/invitation_previews",
+      params: { invitation_preview: { token: token } },
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal "expired", invitation.reload.status
+
+    get "/api/v1/invitations",
+      params: { status: "expired" },
+      headers: authenticated_headers(@owner_token)
+    assert_response :success
+    assert_equal [ invitation.id ], response.parsed_body.fetch("invitations").pluck("id")
+
+    post "/api/v1/invitations/#{invitation.id}/resend",
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :success
+    assert_equal "pending", invitation.reload.status
+    assert_operator invitation.expires_at, :>, Time.current
+  end
+
+  test "only admins manage users and suspension revokes access and assignments" do
+    agent = create_user(name: "Alex", email: "alex@example.test", role: "agent")
+    customer = create_user(name: "Avery", email: "avery@example.test", role: "member")
+    second_admin = create_user(name: "Mo", email: "mo@example.test", role: "admin")
+    agent_token = issue_token(agent)
+    issue_token(second_admin)
+
+    ticket = Ticket.create!(
+      account: @account,
+      requester: customer,
+      assignee: agent,
+      subject: "Billing question"
+    )
+
+    get "/api/v1/users", headers: authenticated_headers(agent_token)
+    assert_response :forbidden
+
+    get "/api/v1/staff", headers: authenticated_headers(agent_token)
+    assert_response :success
+    assert_equal [ @owner.id, agent.id, second_admin.id ],
+      response.parsed_body.fetch("staff").pluck("id")
+
+    patch "/api/v1/users/#{agent.id}",
+      params: { user: { suspended: true } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :success
+    assert_equal true, response.parsed_body.dig("user", "suspended")
+    assert_not Session.exists?(user: agent)
+    assert_nil ticket.reload.assignee_id
+
+    get "/api/v1/me", headers: authenticated_headers(agent_token)
+    assert_response :unauthorized
+
+    get "/api/v1/users",
+      params: { role: "agent", suspended: true },
+      headers: authenticated_headers(@owner_token)
+    assert_response :success
+    assert_equal [ agent.id ], response.parsed_body.fetch("users").pluck("id")
+
+    patch "/api/v1/users/#{second_admin.id}",
+      params: { user: { suspended: true } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :success
+
+    patch "/api/v1/users/#{@owner.id}",
+      params: { user: { suspended: true } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal false, @owner.reload.suspended?
+  end
+
+  test "agents and admins assign tickets but private notes do not touch requests" do
+    agent = create_user(name: "Alex", email: "alex@example.test", role: "agent")
+    suspended_agent = create_user(
+      name: "Casey",
+      email: "casey@example.test",
+      role: "agent",
+      suspended: true
+    )
+    customer = create_user(name: "Avery", email: "avery@example.test", role: "member")
+    agent_token = issue_token(agent)
+    customer_token = issue_token(customer)
+    ticket = Ticket.create!(
+      account: @account,
+      requester: customer,
+      subject: "Delivery issue"
+    )
+    ticket.comments.create!(author: customer, body: "Please help.", public: true)
+    ticket.update_columns(updated_at: 2.minutes.ago)
+    customer_updated_at = ticket.reload.updated_at
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: {
+        ticket: {
+          assignee_id: agent.id,
+          comment: { body: "Checking billing.", public: false }
+        }
+      },
+      headers: authenticated_headers(agent_token),
+      as: :json
+
+    assert_response :success
+    assert_equal agent.id, response.parsed_body.dig("ticket", "assignee_id")
+    assert_equal agent.id, response.parsed_body.dig("ticket", "assignee", "id")
+    assert_equal "Alex", response.parsed_body.dig("ticket", "assignee", "name")
+    assert_not_equal customer_updated_at, ticket.reload.updated_at
+
+    ticket.update_columns(updated_at: customer_updated_at)
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { comment: { body: "Internal follow-up.", public: false } } },
+      headers: authenticated_headers(agent_token),
+      as: :json
+    assert_response :success
+    assert_equal customer_updated_at, ticket.reload.updated_at
+
+    get "/api/v1/requests/#{ticket.id}/comments",
+      headers: authenticated_headers(customer_token)
+    assert_response :success
+    assert_equal [ "Please help." ], response.parsed_body.fetch("comments").pluck("body")
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { assignee_id: suspended_agent.id } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal agent.id, ticket.reload.assignee_id
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { assignee_id: nil } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :success
+    assert_nil response.parsed_body.dig("ticket", "assignee_id")
+  end
+
+  private
+
+  def create_user(name:, email:, role:, owner: false, suspended: false)
+    @account.users.create!(
+      name: name,
+      email: email,
+      password: "account-password",
+      role: role,
+      owner: owner,
+      verified: true,
+      suspended: suspended
+    )
+  end
+
+  def create_invitation(email:, role: "agent")
+    post "/api/v1/invitations",
+      params: { invitation: { email: email, role: role } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :created
+
+    Invitation.find(response.parsed_body.dig("invitation", "id"))
+  end
+
+  def issue_token(user)
+    Session.issue_for(user).last
+  end
+
+  def token_from_latest_mail
+    URI.decode_www_form_component(latest_mail_link[/[?&]token=([^&\s]+)/, 1])
+  end
+
+  def latest_mail_link
+    ActionMailer::Base.deliveries.last.body.decoded[%r{https?://[^\s]+}]
+  end
+
+  def account_headers
+    { "X-Helpdesk-Account" => @account.subdomain }
+  end
+
+  def authenticated_headers(token)
+    account_headers.merge("Authorization" => "Bearer #{token}")
+  end
+end
