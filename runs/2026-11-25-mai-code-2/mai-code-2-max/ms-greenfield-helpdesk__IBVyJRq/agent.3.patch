diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
new file mode 100644
index 0000000..1c66ccb
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,61 @@
+class Api::V1::InvitationAcceptancesController < Api::V1::BaseController
+  def create
+    attributes = params.require(:invitation_acceptance).permit(:token, :name, :password)
+    token = attributes.require(:token)
+    name = attributes.require(:name)
+    password = attributes.require(:password)
+    invitation = Invitation.includes(:account).find_by_token(token)
+    result = :invalid
+    accepted_user = nil
+
+    if invitation
+      invitation.account.with_lock do
+        invitation.lock!
+        invitation.expire_if_needed!
+
+        if !account_header_matches?(invitation.account)
+          result = :invalid
+        elsif invitation.account.cancelled?
+          result = :cancelled
+        elsif invitation.token_valid?(token)
+          invitation.update!(
+            status: "accepted",
+            token_digest: nil,
+            accepted_at: Time.current
+          )
+          accepted_user = invitation.account.users.create!(
+            name: name,
+            email: invitation.email,
+            password: password,
+            role: invitation.role,
+            verified: true
+          )
+          invitation.update!(accepted_user: accepted_user)
+          result = :accepted
+        end
+      end
+    end
+
+    if result == :cancelled
+      render json: { error: "Account is cancelled" }, status: :forbidden
+      return
+    end
+
+    unless result == :accepted
+      render json: { error: "Invalid or expired invitation token" }, status: :unprocessable_content
+      return
+    end
+
+    render json: {
+      user: user_json(accepted_user),
+      account: account_json(invitation.account)
+    }, status: :created
+  end
+
+  private
+
+  def account_header_matches?(account)
+    subdomain = request.headers["X-Helpdesk-Account"].to_s.strip.downcase.presence
+    subdomain.nil? || subdomain == account.subdomain
+  end
+end
