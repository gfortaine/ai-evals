+class Api::V1::InvitationPreviewsController < Api::V1::BaseController
+  def create
+    token = params.require(:invitation_preview).permit(:token).require(:token)
+    invitation = Invitation.includes(:account).find_by_token(token)
+    valid = false
+
+    if invitation
+      invitation.with_lock do
+        invitation.expire_if_needed!
+        valid = invitation.token_valid?(token) && account_header_matches?(invitation.account)
+      end
+    end
+
+    unless valid
+      render json: { error: "Invalid or expired invitation token" }, status: :unprocessable_content
+      return
+    end
+
+    render json: { invitation_preview: invitation_preview_json(invitation) }
+  end
+
+  private
+
+  def account_header_matches?(account)
+    subdomain = request.headers["X-Helpdesk-Account"].to_s.strip.downcase.presence
+    subdomain.nil? || subdomain == account.subdomain
+  end
+end
diff --git a/app/controllers/api/v1/invitations_controller.rb b/app/controllers/api/v1/invitations_controller.rb
new file mode 100644
index 0000000..aa4cd24
--- /dev/null
+++ b/app/controllers/api/v1/invitations_controller.rb
@@ -0,0 +1,98 @@
+class Api::V1::InvitationsController < Api::V1::BaseController
+  before_action :set_account
+  before_action :authenticate_user!
+  before_action :require_active_account!
+  before_action :require_admin!
+  before_action :set_invitation, only: %i[show resend destroy]
+
+  def index
+    current_account.with_lock do
+      Invitation.expire_due!(account: current_account)
+    end
+    scope = current_account.invitations.includes(:invited_by, :accepted_user)
+
+    if params.key?(:status)
+      status = params[:status].to_s
+      unless Invitation::STATUSES.include?(status)
+        raise ActionController::BadRequest, "status is invalid"
+      end
+
+      scope = scope.where(status: status)
+    end
+
+    invitations, pagination = paginate(scope.oldest_first)
+    render json: {
+      invitations: invitations.map { |invitation| invitation_json(invitation) }
+    }.merge(pagination)
+  end
+
+  def show
+    current_account.with_lock do
+      @invitation.lock!
+      @invitation.expire_if_needed!
+    end
+    render json: { invitation: invitation_json(@invitation) }
+  end
+
+  def create
+    invitation_params = params.require(:invitation)
+    email = invitation_params.require(:email).to_s.strip.downcase
+    token = nil
+
+    current_account.with_lock do
+      current_account.reload
+      Invitation.expire_due!(account: current_account, email: email)
+      @invitation = current_account.invitations.new(
+        email: email,
+        role: invitation_params.require(:role),
+        invited_by: current_user
+      )
+      token = @invitation.issue_token
+      @invitation.save!
+    end
+
+    InvitationMailer.with(invitation: @invitation, token: token).staff_invitation.deliver_now
+    render json: { invitation: invitation_json(@invitation) }, status: :created
+  end
+
+  def resend
+    token = nil
+
+    current_account.with_lock do
+      @invitation.lock!
+      @invitation.expire_if_needed!
+      unless @invitation.pending? || @invitation.expired?
+        @invitation.errors.add(:status, "cannot be resent")
+        raise ActiveRecord::RecordInvalid, @invitation
+      end
+
+      token = @invitation.issue_token!
+    end
+
+    InvitationMailer.with(invitation: @invitation, token: token).staff_invitation.deliver_now
+    render json: { invitation: invitation_json(@invitation) }
+  end
+
+  def destroy
+    current_account.with_lock do
+      @invitation.lock!
+      @invitation.expire_if_needed!
+      unless @invitation.pending?
+        @invitation.errors.add(:status, "cannot be revoked")
+        raise ActiveRecord::RecordInvalid, @invitation
+      end
+
+      @invitation.revoke!
+    end
+
+    head :no_content
+  end
+
+  private
+
+  def set_invitation
+    @invitation = current_account.invitations
+      .includes(:invited_by, :accepted_user)
+      .find(params[:id])
+  end
+end
