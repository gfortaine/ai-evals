+  def staff_ticket_json(ticket)
+    ticket_json(
+      ticket,
+      include_requester: true,
+      include_assignee: true,
+      include_priority: true
+    )
+  end
+
+  def filtered_scope(scope)
+    if params.key?(:status)
+      scope = scope.where(status: valid_filter(:status, Ticket::STATUSES))
+    end
+
+    if params.key?(:assignee_id)
+      assignee_id = params[:assignee_id].to_s
+      scope = if assignee_id == "unassigned"
+        scope.where(assignee_id: nil)
+      else
+        scope.where(assignee_id: positive_id_filter(:assignee_id))
+      end
+    end
+
+    if params.key?(:requester_id)
+      scope = scope.where(requester_id: positive_id_filter(:requester_id))
+    end
+
+    if params.key?(:priority)
+      scope = scope.where(priority: valid_filter(:priority, Ticket::PRIORITIES))
+    end
+
+    scope = scope.matching_text(params[:q]) if params.key?(:q)
+    scope
+  end
+
+  def valid_filter(name, values)
+    value = params[name].to_s
+    return value if values.include?(value)
+
+    raise ActionController::BadRequest, "#{name} is invalid"
+  end
+
+  def positive_id_filter(name)
+    value = Integer(params[name].to_s, 10, exception: false)
+    return value if value&.positive?
+
+    raise ActionController::BadRequest, "#{name} must be a positive integer"
+  end
+
   def comment_parameters(ticket_params)
     return unless ticket_params.key?(:comment)
 
diff --git a/app/models/ticket.rb b/app/models/ticket.rb
index ebdbd56..26acaef 100644
--- a/app/models/ticket.rb
+++ b/app/models/ticket.rb
@@ -1,5 +1,6 @@
 class Ticket < ApplicationRecord
   STATUSES = %w[open pending solved].freeze
+  PRIORITIES = %w[normal high].freeze
 
   belongs_to :account
   belongs_to :requester, class_name: "User", inverse_of: :requested_tickets
@@ -11,10 +12,26 @@ class Ticket < ApplicationRecord
 
   validates :subject, presence: true, length: { maximum: 255 }
   validates :status, inclusion: { in: STATUSES }
+  validates :priority, inclusion: { in: PRIORITIES }
   validate :requester_belongs_to_account
   validate :assignee_is_active_account_staff
 
   scope :recently_active, -> { order(updated_at: :desc, id: :desc) }
+  scope :matching_text, ->(query) {
+    pattern = "%#{sanitize_sql_like(query.to_s)}%"
+    condition = <<~SQL.squish
+      tickets.subject ILIKE :query
+      OR EXISTS (
+        SELECT 1
+        FROM comments
+        WHERE comments.ticket_id = tickets.id
+          AND comments.public = TRUE
+          AND comments.body ILIKE :query
+      )
+    SQL
+
+    where(condition, query: pattern)
+  }
 
   private
 
