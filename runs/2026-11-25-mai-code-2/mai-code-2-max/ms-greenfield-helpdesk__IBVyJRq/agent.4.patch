+  test "staff can update ticket priority without exposing it to customers" do
+    account, owner, customer = create_portal_users
+    owner_token = issue_token(owner)
+    customer_token = issue_token(customer)
+    ticket = create_request(customer, "Priority test", customer_token, account)
+
+    assert_equal "normal", ticket.priority
+    refute response.parsed_body.fetch("request").key?("priority")
+
+    get "/api/v1/tickets/#{ticket.id}",
+      headers: authenticated_headers(owner_token, account)
+    assert_response :success
+    assert_equal "normal", response.parsed_body.dig("ticket", "priority")
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { priority: "high" } },
