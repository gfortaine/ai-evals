+  def validate_merge_parameter_shapes!(merge_payload)
+    raise ActionController::BadRequest, "merge must be an object" unless merge_payload.respond_to?(:permit)
+
+    %i[source_comment target_comment].each do |key|
+      next unless merge_payload.respond_to?(:key?) && merge_payload.key?(key)
+      next if merge_payload[key].respond_to?(:permit)
+
+      raise ActionController::BadRequest, "#{key} must be an object"
+    end
+  end
+
+  def positive_merge_target_id(merge_params)
+    value = Integer(merge_params.require(:target_id).to_s, 10, exception: false)
+    return value if value&.positive?
+
+    raise ActionController::BadRequest, "target_id must be a positive integer"
+  end
+
+  def ensure_ticket_mergeable!(target_ticket)
+    @ticket.errors.add(:base, "A closed ticket cannot be merged") if @ticket.closed?
+    if @ticket.merged_into_id.present?
+      @ticket.errors.add(:merged_into, "is already set")
+    end
+    if target_ticket.id == @ticket.id
+      @ticket.errors.add(:merged_into, "cannot be the ticket itself")
+    end
+    if target_ticket.requester_id != @ticket.requester_id
+      @ticket.errors.add(:merged_into, "must belong to the same customer")
+    end
+    if target_ticket.closed? || target_ticket.merged_into_id.present?
+      @ticket.errors.add(:merged_into, "must not already be closed or merged")
+    end
+
+    raise ActiveRecord::RecordInvalid, @ticket if @ticket.errors.any?
+  end
+
+  def merge_note_attributes(merge_params, key, default_body:)
+    note = merge_params[key]
+    return { body: default_body, public: false } unless note
+
+    {
+      body: note.key?(:body) ? note[:body] : default_body,
+      public: note.fetch(:public, false)
+    }
+  end
+
   def update_ticket_group_and_assignee(ticket_params, group_supplied:, assignee_supplied:)
     if group_supplied
       @ticket.group = group_for(ticket_params[:group_id])
