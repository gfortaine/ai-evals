diff --git a/test/integration/ticket_merge_api_test.rb b/test/integration/ticket_merge_api_test.rb
new file mode 100644
index 0000000..b115585
--- /dev/null
+++ b/test/integration/ticket_merge_api_test.rb
@@ -0,0 +1,349 @@
+require "test_helper"
+require "mail"
+
+class TicketMergeApiTest < ActionDispatch::IntegrationTest
+  setup do
+    @previous_ingress_password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"]
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = "inbound-secret"
+    ActionMailer::Base.deliveries.clear
+
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @owner = create_user("Jo", "jo@acme.test", role: "admin", owner: true)
+    @agent = create_user("Alex", "alex@acme.test", role: "agent")
+    @customer = create_user("Avery", "avery@example.test")
+    @other_customer = create_user("Blake", "blake@example.test")
+    @owner_token = Session.issue_for(@owner).last
+    @customer_token = Session.issue_for(@customer).last
+  end
+
+teardown do
+  if @previous_ingress_password
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @previous_ingress_password
+  else
+    ENV.delete("RAILS_INBOUND_EMAIL_PASSWORD")
+  end
+end
+
+test "staff merges a duplicate without moving or reconfiguring the conversation" do
+    group = @account.groups.create!(name: "Support")
+    GroupMembership.create!(group: group, user: @agent)
+    source = create_ticket(subject: "Cannot sign in", status: "pending", email_origin: true)
+    target = create_ticket(
+      subject: "Sign-in issue",
+      status: "solved",
+      priority: "high",
+      email_origin: true,
+      group: group,
+      assignee: @agent
+    )
+    source_comment = source.comments.create!(author: @customer, body: "The page loops.", public: true)
+    target_comment = target.comments.create!(author: @customer, body: "I cannot log in.", public: true)
+    target_identity = target.attributes.slice(
+      "status",
+      "priority",
+      "group_id",
+      "assignee_id",
+      "email_origin",
+      "reply_token"
+    )
+    original_source_comment_ids = source.comments.ids
+    original_target_comment_ids = target.comments.ids
+
+    post "/api/v1/tickets/#{source.id}/merge",
+      params: {
+        merge: {
+          target_id: target.id,
+          source_comment: { body: "Continuing in the original conversation.", public: true },
+          target_comment: { body: "Duplicate checked.", public: false }
+        }
+      },
+      headers: staff_headers,
+      as: :json
+
+    assert_response :success
+    assert_empty ActionMailer::Base.deliveries
+    assert_equal "closed", response.parsed_body.dig("source", "status")
+    assert_equal target.id, response.parsed_body.dig("source", "merged_into_id")
+    assert_equal "solved", response.parsed_body.dig("target", "status")
+    assert_nil response.parsed_body.dig("target", "merged_into_id")
+
+    source.reload
+    target.reload
+    assert_predicate source, :closed?
+    assert_equal target.id, source.merged_into_id
+    assert_equal target_identity, target.attributes.slice(*target_identity.keys)
+    assert_includes original_source_comment_ids, source_comment.id
+    assert_includes original_target_comment_ids, target_comment.id
+    assert_equal original_source_comment_ids + [ source.comments.order(:id).last.id ], source.comments.ids
+    assert_equal original_target_comment_ids + [ target.comments.order(:id).last.id ], target.comments.ids
+
+    source_note = source.comments.order(:id).last
+    target_note = target.comments.order(:id).last
+    assert_equal "Continuing in the original conversation.", source_note.body
+    assert_equal true, source_note.public?
+    assert_equal "Duplicate checked.", target_note.body
+    assert_equal false, target_note.public?
+    assert_equal @owner.id, source_note.author_id
+    assert_equal @owner.id, target_note.author_id
+
+    get "/api/v1/tickets",
+      params: { status: "closed" },
+      headers: staff_headers
+    assert_response :success
+    assert_equal [ source.id ], response.parsed_body.fetch("tickets").pluck("id")
+
+    get "/api/v1/requests",
+      params: { status: "closed" },
+      headers: customer_headers
+    assert_response :success
+    assert_equal [ source.id ], response.parsed_body.fetch("requests").pluck("id")
+
+    get "/api/v1/requests/#{source.id}", headers: customer_headers
+    assert_response :success
+    assert_equal target.id, response.parsed_body.dig("request", "merged_into_id")
+
+    get "/api/v1/requests/#{target.id}", headers: customer_headers
+    assert_response :success
+    assert response.parsed_body.dig("request").key?("merged_into_id")
+    assert_nil response.parsed_body.dig("request", "merged_into_id")
+
+    get "/api/v1/requests/#{source.id}/comments", headers: customer_headers
+    assert_response :success
+    assert_equal [ "The page loops.", source_note.body ],
+      response.parsed_body.fetch("comments").pluck("body")
+
+    get "/api/v1/requests/#{target.id}/comments", headers: customer_headers
+    assert_response :success
+    assert_equal [ "I cannot log in." ], response.parsed_body.fetch("comments").pluck("body")
+
+    patch "/api/v1/tickets/#{source.id}",
+      params: { ticket: { status: "open", comment: { body: "Do not add.", public: true } } },
+      headers: staff_headers,
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal "closed", source.reload.status
+    assert_not source.comments.exists?(body: "Do not add.")
+
+    patch "/api/v1/requests/#{source.id}",
+      params: { request: { comment: { body: "Please reopen." } } },
+      headers: customer_headers,
+      as: :json
+    assert_response :unprocessable_content
+    assert_not source.comments.exists?(body: "Please reopen.")
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "default notes are private and later merges preserve original links" do
+    first = create_ticket(subject: "First")
+    second = create_ticket(subject: "Second")
+    final = create_ticket(subject: "Final")
+
+    post "/api/v1/tickets/#{first.id}/merge",
+      params: { merge: { target_id: second.id } },
+      headers: staff_headers,
+      as: :json
+    assert_response :success
+
+    first_note = first.comments.order(:id).last
+    second_note = second.comments.order(:id).last
+    assert_equal "Merged into ticket ##{second.id}.", first_note.body
+    assert_equal "Merged ticket ##{first.id} into this ticket.", second_note.body
+    assert_not first_note.public?
+    assert_not second_note.public?
+
+    post "/api/v1/tickets/#{second.id}/merge",
+      params: { merge: { target_id: final.id } },
+      headers: staff_headers,
+      as: :json
+    assert_response :success
+
+    assert_equal second.id, first.reload.merged_into_id
+    assert_equal final.id, second.reload.merged_into_id
+    assert_nil final.reload.merged_into_id
+    assert_equal "closed", first.status
+    assert_equal "closed", second.status
+    assert_equal 1, first.comments.count
+    assert_equal 2, second.comments.count
+    assert_equal 1, final.comments.count
+
+    post "/api/v1/tickets/#{first.id}/merge",
+      params: { merge: { target_id: final.id } },
+      headers: staff_headers,
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal second.id, first.reload.merged_into_id
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "invalid merges leave both tickets and their notes unchanged" do
+    source = create_ticket(subject: "Source")
+    same_customer_target = create_ticket(subject: "Target")
+    other_customer_target = create_ticket(
+      subject: "Other customer",
+      requester: @other_customer
+    )
+
+    post "/api/v1/tickets/#{source.id}/merge",
+      params: { merge: { target_id: other_customer_target.id } },
+      headers: staff_headers,
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal "open", source.reload.status
+    assert_nil source.merged_into_id
+    assert_empty source.comments
+    assert_empty other_customer_target.comments
+
+    post "/api/v1/tickets/#{source.id}/merge",
+      params: { merge: { target_id: source.id } },
+      headers: staff_headers,
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal "open", source.reload.status
+    assert_empty source.comments
+
+    post "/api/v1/tickets/#{source.id}/merge",
+      params: {
+        merge: {
+          target_id: same_customer_target.id,
+          source_comment: "not an object"
+        }
+      },
+      headers: staff_headers,
+      as: :json
+    assert_response :bad_request
+    assert_empty source.comments
+
+    post "/api/v1/tickets/#{source.id}/merge",
+      params: {
+        merge: {
+          target_id: same_customer_target.id,
+          source_comment: { body: "This would be added.", public: false },
+          target_comment: { body: "", public: true }
+        }
+      },
+      headers: staff_headers,
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal "open", source.reload.status
+    assert_nil source.merged_into_id
+    assert_empty source.comments
+    assert_empty same_customer_target.comments
+    assert_empty ActionMailer::Base.deliveries
+
+    same_customer_target.update!(status: "closed")
+    post "/api/v1/tickets/#{source.id}/merge",
+      params: { merge: { target_id: same_customer_target.id } },
+      headers: staff_headers,
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal "open", source.reload.status
+  end
+
+  test "closed tickets still receive assignment cleanup but reject email replies" do
+    group = @account.groups.create!(name: "Escalations")
+    membership = GroupMembership.create!(group: group, user: @agent)
+    source = create_ticket(
+      subject: "Duplicate by email",
+      email_origin: true,
+      group: group,
+      assignee: @agent
+    )
+    target = create_ticket(subject: "Email survivor")
+
+    post "/api/v1/tickets/#{source.id}/merge",
+      params: { merge: { target_id: target.id } },
+      headers: staff_headers,
+      as: :json
+    assert_response :success
+    assert_equal @agent.id, source.reload.assignee_id
+
+    membership.destroy!
+    assert_nil source.reload.assignee_id
+    assert_equal group.id, source.group_id
+
+    second_source = create_ticket(subject: "Assigned duplicate", assignee: @agent)
+    second_target = create_ticket(subject: "Second survivor")
+    post "/api/v1/tickets/#{second_source.id}/merge",
+      params: { merge: { target_id: second_target.id } },
+      headers: staff_headers,
+      as: :json
+    assert_response :success
+
+    patch "/api/v1/users/#{@agent.id}",
+      params: { user: { suspended: true } },
+      headers: staff_headers,
+      as: :json
+    assert_response :success
+    assert_nil second_source.reload.assignee_id
+    assert_equal "closed", second_source.status
+
+    comment_count = source.comments.count
+    relay_mail(
+      from: @customer.email,
+      to: source.reply_address,
+      subject: "Re: Duplicate by email",
+      body: "Do not reopen the duplicate."
+    )
+
+    assert_equal comment_count, source.comments.reload.count
+    assert_equal "closed", source.reload.status
+    assert_equal "bounced", ActionMailbox::InboundEmail.order(:id).last.status
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  private
+
+  def create_user(name, email, role: "member", owner: false)
+    @account.users.create!(
+      name: name,
+      email: email,
+      password: "account-password",
+      role: role,
+      owner: owner,
+      verified: true
+    )
+  end
+
+  def create_ticket(subject:, requester: @customer, **attributes)
+    @account.tickets.create!(
+      requester: requester,
+      subject: subject,
+      **attributes
+    )
+  end
+
+  def staff_headers
+    account_headers.merge("Authorization" => "Bearer #{@owner_token}")
+  end
+
+  def customer_headers
+    account_headers.merge("Authorization" => "Bearer #{@customer_token}")
+  end
+
+  def account_headers
+    { "X-Helpdesk-Account" => @account.subdomain }
+  end
+
+  def relay_mail(from:, to:, subject:, body:)
+    message = Mail.new do
+      from from
+      to to
+      subject subject
+      text_part do
+        body body
+        content_type "text/plain; charset=UTF-8"
+      end
+    end
+    message.message_id = "<closed-reply-#{SecureRandom.uuid}@example.test>"
+
+    post "/rails/action_mailbox/relay/inbound_emails",
+      params: message.encoded,
+      headers: {
+        "CONTENT_TYPE" => "message/rfc822",
+        "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials(
+          "actionmailbox",
+          ENV.fetch("RAILS_INBOUND_EMAIL_PASSWORD")
+        )
+      }
+  end
+end
