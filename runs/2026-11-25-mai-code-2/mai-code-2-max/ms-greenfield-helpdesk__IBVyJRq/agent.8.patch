diff --git a/app/services/cursor_paginator.rb b/app/services/cursor_paginator.rb
new file mode 100644
index 0000000..522a38c
--- /dev/null
+++ b/app/services/cursor_paginator.rb
@@ -0,0 +1,213 @@
+class CursorPaginator
+  class InvalidCursor < StandardError; end
+
+  Page = Struct.new(
+    :records,
+    :has_more,
+    :direction,
+    :cursor_supplied,
+    :before_cursor,
+    :after_cursor,
+    keyword_init: true
+  )
+
+  CURSOR_VERSION = 1
+  CURSOR_PURPOSE = "helpdesk.cursor_pagination"
+
+  def initialize(scope:, order:, context:, size:, after: nil, before: nil)
+    raise ArgumentError, "after and before cannot both be supplied" if after && before
+
+    @scope = scope
+    @order = normalize_order(order)
+    @context = context
+    @size = size
+    @after = after
+    @before = before
+    @verifier = Rails.application.message_verifier(CURSOR_PURPOSE)
+    @payload = decode_cursor(after || before)
+    @snapshot_values = @payload ? cast_values(@payload["snapshot"]) : load_snapshot_values
+  end
+
+  def paginate
+    return empty_page unless @snapshot_values
+
+    direction = @before ? :before : :after
+    relation = @scope.where(snapshot_predicate(@snapshot_values))
+    if @payload
+      relation = relation.where(position_predicate(cast_values(@payload["position"]), direction))
+    end
+
+    relation = relation.reorder(order_for(direction)).limit(@size + 1)
+    batch = relation.to_a
+    has_more = batch.length > @size
+    records = batch.first(@size)
+    records.reverse! if direction == :before
+
+    Page.new(
+      records: records,
+      has_more: has_more,
+      direction: direction,
+      cursor_supplied: @payload.present?,
+      before_cursor: records.any? ? encode_cursor(records.first) : nil,
+      after_cursor: records.any? ? encode_cursor(records.last) : nil
+    )
+  end
+
+  def cursors_for(records)
+    return [ nil, nil ] unless records.any? && @snapshot_values
+
+    [ encode_cursor(records.first), encode_cursor(records.last) ]
+  end
+
+  private
+
+  def normalize_order(order)
+    normalized = order.to_a.map { |column, direction| [ column.to_s, direction.to_sym ] }
+    if normalized.empty? || normalized.any? { |column, direction| column.blank? || !%i[asc desc].include?(direction) }
+      raise ArgumentError, "order must contain columns and asc/desc directions"
+    end
+
+    normalized
+  end
+
+  def load_snapshot_values
+    value_order = @order.to_h.transform_values { :desc }
+    raw_values = @scope.reorder(value_order).limit(1).pluck(*columns).first
+    return unless raw_values
+
+    columns.one? ? [ raw_values ] : raw_values
+  end
+
+  def decode_cursor(token)
+    return unless token
+
+    payload = @verifier.verified(token, purpose: CURSOR_PURPOSE)
+    raise InvalidCursor unless payload.is_a?(Hash)
+
+    payload = payload.deep_stringify_keys
+    valid = payload["version"] == CURSOR_VERSION &&
+      payload["context"] == @context &&
+      payload["sort"] == sort_signature &&
+      cursor_value_list?(payload["snapshot"]) &&
+      cursor_value_list?(payload["position"])
+    raise InvalidCursor unless valid
+
+    payload
+  rescue ActiveSupport::MessageVerifier::InvalidSignature, ArgumentError, TypeError
+    raise InvalidCursor
+  end
+
+  def cursor_value_list?(values)
+    values.is_a?(Array) && values.length == columns.length
+  end
+
+  def cast_values(values)
+    unless cursor_value_list?(values)
+      raise InvalidCursor
+    end
+
+    values.zip(columns).map do |value, column|
+      case @scope.klass.type_for_attribute(column).type
+      when :integer
+        Integer(value.to_s, 10)
+      when :datetime
+        Time.iso8601(value.to_s)
+      else
+        value
+      end
+    end
+  rescue ArgumentError, TypeError
+    raise InvalidCursor
+  end
+
+  def encode_cursor(record)
+    position_values = columns.map { |column| serialize_value(record.public_send(column), column) }
+
+    @verifier.generate(
+      {
+        version: CURSOR_VERSION,
+        context: @context,
+        sort: sort_signature,
+        snapshot: serialize_values(@snapshot_values),
+        position: position_values
+      },
+      purpose: CURSOR_PURPOSE
+    )
+  end
+
+  def serialize_values(values)
+    values.zip(columns).map { |value, column| serialize_value(value, column) }
+  end
+
+  def serialize_value(value, column)
+    return value unless @scope.klass.type_for_attribute(column).type == :datetime
+
+    value.iso8601(6)
+  end
+
+  def snapshot_predicate(values)
+    predicates = columns.each_index.map do |index|
+      comparison = table[columns[index]].lt(values[index])
+      with_equal_prefix(columns.take(index), values.take(index), comparison)
+    end
+    predicates << equal_prefix(columns, values)
+
+    predicates.reduce(&:or)
+  end
+
+  def position_predicate(values, direction)
+    predicates = columns.each_index.map do |index|
+      comparison = if direction == :after
+        @order[index].last == :asc ? :gt : :lt
+      else
+        @order[index].last == :asc ? :lt : :gt
+      end
+
+      value_comparison = table[columns[index]].public_send(comparison, values[index])
+      with_equal_prefix(columns.take(index), values.take(index), value_comparison)
+    end
+
+    predicates.reduce(&:or)
+  end
+
+  def equal_prefix(prefix_columns, values)
+    prefix_columns.zip(values).reduce(nil) do |node, (column, value)|
+      equality = table[column].eq(value)
+      node ? node.and(equality) : equality
+    end
+  end
+
+  def with_equal_prefix(prefix_columns, values, comparison)
+    prefix = equal_prefix(prefix_columns, values)
+    prefix ? prefix.and(comparison) : comparison
+  end
+
+  def order_for(direction)
+    return @order.to_h if direction == :after
+
+    @order.to_h.transform_values { |value| value == :asc ? :desc : :asc }
+  end
+
+  def empty_page
+    Page.new(
+      records: [],
+      has_more: false,
+      direction: @before ? :before : :after,
+      cursor_supplied: @payload.present?,
+      before_cursor: nil,
+      after_cursor: nil
+    )
+  end
+
+  def sort_signature
+    @sort_signature ||= @order.map { |column, direction| [ column, direction.to_s ] }
+  end
+
+  def columns
+    @columns ||= @order.map(&:first)
+  end
+
+  def table
+    @table ||= @scope.klass.arel_table
+  end
+end
