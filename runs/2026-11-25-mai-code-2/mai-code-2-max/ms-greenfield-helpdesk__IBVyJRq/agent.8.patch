diff --git a/test/integration/cursor_pagination_api_test.rb b/test/integration/cursor_pagination_api_test.rb
new file mode 100644
index 0000000..ea2b47d
--- /dev/null
+++ b/test/integration/cursor_pagination_api_test.rb
@@ -0,0 +1,254 @@
+require "test_helper"
+
+class CursorPaginationApiTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = Account.create!(name: "Cursor Co", subdomain: "cursor-co")
+    @owner = create_user(name: "Olive", email: "olive@example.test", role: "admin", owner: true)
+    @agent = create_user(name: "Alex", email: "alex@example.test", role: "agent")
+    @customer = create_user(name: "Casey", email: "casey@example.test", role: "member")
+    @owner_token = Session.issue_for(@owner).last
+    @agent_token = Session.issue_for(@agent).last
+    @customer_token = Session.issue_for(@customer).last
+  end
+
+  test "empty cursor pages have navigation metadata" do
+    get "/api/v1/tickets",
+      params: { page: { size: 25 }, status: "open" },
+      headers: authenticated_headers(@owner_token)
+
+    assert_response :success
+    assert_equal(
+      {
+        "tickets" => [],
+        "meta" => {
+          "has_more" => false,
+          "after_cursor" => nil,
+          "before_cursor" => nil
+        },
+        "links" => { "next" => nil, "prev" => nil }
+      },
+      response.parsed_body
+    )
+  end
+
+  test "every collection supports cursor pagination" do
+    groups = [
+      @account.groups.create!(name: "Billing"),
+      @account.groups.create!(name: "Technical")
+    ]
+    groups.each { |group| GroupMembership.create!(group: group, user: @agent) }
+
+    2.times do |index|
+      invitation = @account.invitations.new(
+        email: "invite-#{index}@example.test",
+        role: "agent",
+        invited_by: @owner
+      )
+      invitation.issue_token
+      invitation.save!
+    end
+
+    tickets = 2.times.map do |index|
+      Ticket.create!(
+        account: @account,
+        requester: @customer,
+        subject: "Ticket #{index}"
+      )
+    end
+    2.times do |index|
+      tickets.first.comments.create!(
+        author: @customer,
+        body: "Comment #{index}",
+        public: true
+      )
+    end
+
+    collections = [
+      [ "/api/v1/tickets", "tickets", @owner_token ],
+      [ "/api/v1/tickets/#{tickets.first.id}/comments", "comments", @owner_token ],
+      [ "/api/v1/requests", "requests", @customer_token ],
+      [ "/api/v1/requests/#{tickets.first.id}/comments", "comments", @customer_token ],
+      [ "/api/v1/groups", "groups", @agent_token ],
+      [ "/api/v1/group_memberships", "group_memberships", @agent_token ],
+      [ "/api/v1/invitations", "invitations", @owner_token ],
+      [ "/api/v1/users", "users", @owner_token ],
+      [ "/api/v1/staff", "staff", @agent_token ]
+    ]
+
+    collections.each do |path, key, token|
+      get path, params: { page: { size: 1 } }, headers: authenticated_headers(token)
+
+      assert_response :success
+      assert_equal 1, response.parsed_body.fetch(key).length, path
+      assert_equal true, response.parsed_body.dig("meta", "has_more"), path
+      assert response.parsed_body.dig("meta", "after_cursor").present?, path
+      assert response.parsed_body.dig("meta", "before_cursor").present?, path
+      assert response.parsed_body.dig("links", "next").present?, path
+      assert_nil response.parsed_body.dig("links", "prev"), path
+      refute response.parsed_body.key?("count"), path
+    end
+  end
+
+  test "cursor navigation is stable and walks backward without offsets" do
+    tickets = 5.times.map do |index|
+      Ticket.create!(account: @account, requester: @customer, subject: "Ticket #{index}")
+    end
+    shared_timestamp = 2.minutes.ago.change(usec: 0)
+    tickets.each { |ticket| ticket.update_columns(updated_at: shared_timestamp) }
+    expected_ids = tickets.reverse.map(&:id)
+
+    first_queries = []
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, payload|
+      first_queries << payload[:sql] if payload[:name] != "SCHEMA"
+    end
+    get "/api/v1/tickets",
+      params: { page: { size: 2 }, status: "open" },
+      headers: authenticated_headers(@owner_token)
+    ActiveSupport::Notifications.unsubscribe(subscriber)
+
+    assert_response :success
+    first_page = response.parsed_body
+    assert_equal expected_ids.first(2), first_page.fetch("tickets").pluck("id")
+    assert_equal true, first_page.dig("meta", "has_more")
+    assert_nil first_page.dig("links", "prev")
+    assert first_page.dig("links", "next").present?
+    ticket_queries = first_queries.grep(/FROM "tickets"/).join("\n")
+    refute_match(/OFFSET/i, ticket_queries)
+    refute_match(/COUNT\s*\(/i, ticket_queries)
+
+    concurrent_ticket = Ticket.create!(
+      account: @account,
+      requester: @customer,
+      subject: "Created during the browse"
+    )
+
+    get first_page.dig("links", "next"), headers: authenticated_headers(@owner_token)
+
+    assert_response :success
+    second_page = response.parsed_body
+    assert_equal expected_ids.slice(2, 2), second_page.fetch("tickets").pluck("id")
+    assert_equal true, second_page.dig("meta", "has_more")
+    assert second_page.dig("links", "prev").present?
+    refute_includes second_page.fetch("tickets").pluck("id"), concurrent_ticket.id
+
+    get second_page.dig("links", "prev"), headers: authenticated_headers(@owner_token)
+
+    assert_response :success
+    assert_equal expected_ids.first(2), response.parsed_body.fetch("tickets").pluck("id")
+    assert_equal false, response.parsed_body.dig("meta", "has_more")
+    assert_nil response.parsed_body.dig("links", "prev")
+    assert response.parsed_body.dig("links", "next").present?
+
+    get second_page.dig("links", "next"), headers: authenticated_headers(@owner_token)
+
+    assert_response :success
+    assert_equal expected_ids.last(1), response.parsed_body.fetch("tickets").pluck("id")
+    assert_equal false, response.parsed_body.dig("meta", "has_more")
+    assert_nil response.parsed_body.dig("links", "next")
+    assert response.parsed_body.dig("links", "prev").present?
+  end
+
+  test "ascending cursors do not include records added during a browse" do
+    groups = 4.times.map do |index|
+      @account.groups.create!(name: "Group #{index}")
+    end
+
+    get "/api/v1/groups",
+      params: { page: { size: 2 } },
+      headers: authenticated_headers(@owner_token)
+    next_link = response.parsed_body.dig("links", "next")
+
+    new_group = @account.groups.create!(name: "Added concurrently")
+
+    get next_link, headers: authenticated_headers(@owner_token)
+
+    assert_response :success
+    ids = response.parsed_body.fetch("groups").pluck("id")
+    assert_equal groups.last(2).map(&:id), ids
+    refute_includes ids, new_group.id
+    assert_equal false, response.parsed_body.dig("meta", "has_more")
+    assert_nil response.parsed_body.dig("links", "next")
+  end
+
+  test "legacy and nested page numbers retain offset metadata" do
+    3.times do |index|
+      @account.groups.create!(name: "Group #{index}")
+    end
+
+    get "/api/v1/groups",
+      params: { page: 2, per_page: 1 },
+      headers: authenticated_headers(@owner_token)
+
+    assert_response :success
+    assert_equal 3, response.parsed_body["count"]
+    assert_equal 2, response.parsed_body["page"]
+    assert_equal 1, response.parsed_body["per_page"]
+    assert_equal 3, response.parsed_body["next_page"]
+    assert_equal 1, response.parsed_body["previous_page"]
+    assert response.parsed_body.dig("meta", "before_cursor").present?
+    assert response.parsed_body.dig("links", "next").present?
+    assert response.parsed_body.dig("links", "prev").present?
+
+    get "/api/v1/groups",
+      params: { page: { number: 2, size: 1 } },
+      headers: authenticated_headers(@owner_token)
+
+    assert_response :success
+    assert_equal 2, response.parsed_body["page"]
+    assert_equal 1, response.parsed_body["per_page"]
+    assert_equal 3, response.parsed_body["count"]
+  end
+
+  test "malformed or mismatched cursors are rejected" do
+    ticket = Ticket.create!(
+      account: @account,
+      requester: @customer,
+      subject: "Cursor validation"
+    )
+
+    get "/api/v1/tickets",
+      params: { page: { size: 1 }, status: "open" },
+      headers: authenticated_headers(@owner_token)
+    after_cursor = response.parsed_body.dig("meta", "after_cursor")
+
+    get "/api/v1/tickets",
+      params: { page: { size: 1, after: "not-a-cursor" } },
+      headers: authenticated_headers(@owner_token)
+    assert_response :bad_request
+
+    get "/api/v1/tickets",
+      params: { page: { size: 1, after: after_cursor }, status: "closed" },
+      headers: authenticated_headers(@owner_token)
+    assert_response :bad_request
+
+    get "/api/v1/tickets",
+      params: { page: { size: 1, after: after_cursor, before: after_cursor } },
+      headers: authenticated_headers(@owner_token)
+    assert_response :bad_request
+
+    get "/api/v1/tickets/#{ticket.id}/comments",
+      params: { page: { after: after_cursor, size: 1 } },
+      headers: authenticated_headers(@owner_token)
+    assert_response :bad_request
+  end
+
+  private
+
+  def create_user(name:, email:, role:, owner: false)
+    @account.users.create!(
+      name: name,
+      email: email,
+      password: "account-password",
+      role: role,
+      owner: owner,
+      verified: true
+    )
+  end
+
+  def authenticated_headers(token)
+    {
+      "X-Helpdesk-Account" => @account.subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+end
