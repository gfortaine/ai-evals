--- /dev/null
+++ b/app/models/group_membership.rb
@@ -0,0 +1,72 @@
+class GroupMembership < ApplicationRecord
+  belongs_to :group, inverse_of: :group_memberships
+  belongs_to :user, inverse_of: :group_memberships
+
+  around_create :coordinate_default_on_create
+  around_destroy :coordinate_destroy
+
+  validates :group_id, uniqueness: { scope: :user_id }
+  validates :default, inclusion: { in: [ true, false ] }
+  validate :group_and_user_belong_to_same_account
+  validate :user_is_staff
+
+  def make_default!
+    user.with_lock do
+      reload
+      now = Time.current
+      GroupMembership.where(user_id: user_id, default: true)
+        .where.not(id: id)
+        .update_all(default: false, updated_at: now)
+      update!(default: true)
+    end
+
+    self
+  end
+
+  private
+
+  def coordinate_default_on_create
+    user.with_lock do
+      default_exists = GroupMembership.where(user_id: user_id, default: true).exists?
+      if default? || !default_exists
+        self.class.where(user_id: user_id, default: true).update_all(
+          default: false,
+          updated_at: Time.current
+        )
+        self.default = true
+      end
+
+      yield
+    end
+  end
+
+  def coordinate_destroy
+    user.with_lock do
+      destroyed_default = self.class.where(id: id, default: true).exists?
+      yield
+
+      Ticket.where(group_id: group_id, assignee_id: user_id).update_all(assignee_id: nil)
+
+      if destroyed_default && !self.class.where(user_id: user_id, default: true).exists?
+        self.class.where(user_id: user_id).order(id: :asc).first&.update_columns(
+          default: true,
+          updated_at: Time.current
+        )
+      end
+    end
+  end
+
+  def group_and_user_belong_to_same_account
+    return unless group && user
+    return if group.account_id == user.account_id
+
+    errors.add(:group, "must belong to the same account as the user")
+  end
+
+  def user_is_staff
+    return unless user
+    return if user.staff?
+
+    errors.add(:user, "must be a staff member")
+  end
+end
