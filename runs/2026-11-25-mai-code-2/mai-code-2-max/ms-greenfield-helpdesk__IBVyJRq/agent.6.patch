+
+    add_index :groups, %i[account_id name], unique: true
+
+    create_table :group_memberships do |t|
+      t.references :group, null: false, foreign_key: { on_delete: :cascade }
+      t.references :user, null: false, foreign_key: { on_delete: :cascade }
+      t.boolean :default, null: false, default: false
+
+      t.timestamps
+    end
+
+    add_index :group_memberships, %i[group_id user_id], unique: true
+    add_index :group_memberships,
+      :user_id,
+      unique: true,
+      where: '"default" = TRUE',
+      name: "index_group_memberships_one_default_per_user"
+
+    add_reference :tickets,
+      :group,
+      foreign_key: { on_delete: :nullify }
+    add_index :tickets, %i[account_id group_id]
+  end
+end
