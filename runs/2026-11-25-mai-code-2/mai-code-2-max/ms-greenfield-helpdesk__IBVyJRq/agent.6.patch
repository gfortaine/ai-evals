@@ -0,0 +1,68 @@
+class Api::V1::GroupMembershipsController < Api::V1::BaseController
+  before_action :set_account
+  before_action :authenticate_user!
+  before_action :require_active_account!
+  before_action :require_staff!
+  before_action :require_admin!, only: %i[create destroy make_default]
+  before_action :set_group_membership, only: %i[show destroy make_default]
+
+  def index
+    scope = current_account.group_memberships.includes(:group, :user)
+    scope = scope.where(group_id: positive_id(:group_id)) if params.key?(:group_id)
+    scope = scope.where(user_id: positive_id(:user_id)) if params.key?(:user_id)
+
+    memberships, pagination = paginate(scope.order(id: :asc))
+    render json: {
+      group_memberships: memberships.map { |membership| group_membership_json(membership) }
+    }.merge(pagination)
+  end
+
+  def show
+    render json: { group_membership: group_membership_json(@group_membership) }
+  end
+
+  def create
+    attributes = params.require(:group_membership).permit(:group_id, :user_id, :default)
+
+    current_account.with_lock do
+      group = current_account.groups.find(attributes.require(:group_id))
+      user = current_account.users.find(attributes.require(:user_id))
+      @group_membership = GroupMembership.new(group: group, user: user)
+      @group_membership.default = attributes[:default] if attributes.key?(:default)
+      @group_membership.save!
+    end
+
+    render json: { group_membership: group_membership_json(@group_membership) }, status: :created
+  end
+
+  def destroy
+    current_account.with_lock do
+      @group_membership.destroy!
+    end
+
+    head :no_content
+  end
+
+  def make_default
+    current_account.with_lock do
+      @group_membership.make_default!
+    end
+
+    render json: { group_membership: group_membership_json(@group_membership) }
+  end
+
+  private
+
+  def set_group_membership
+    @group_membership = current_account.group_memberships
+      .includes(:group, :user)
+      .find(params[:id])
+  end
+
+  def positive_id(name)
+    value = Integer(params[name].to_s, 10, exception: false)
+    return value if value&.positive?
+
+    raise ActionController::BadRequest, "#{name} must be a positive integer"
+  end
+end
