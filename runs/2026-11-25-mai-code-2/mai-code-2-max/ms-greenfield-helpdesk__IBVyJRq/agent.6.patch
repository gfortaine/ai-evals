diff --git a/test/integration/groups_api_test.rb b/test/integration/groups_api_test.rb
new file mode 100644
index 0000000..a474ded
--- /dev/null
+++ b/test/integration/groups_api_test.rb
@@ -0,0 +1,298 @@
+require "test_helper"
+
+class GroupsApiTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @owner = create_user(
+      name: "Jo",
+      email: "jo@acme.test",
+      role: "admin",
+      owner: true
+    )
+    @agent = create_user(name: "Alex", email: "alex@acme.test", role: "agent")
+    @customer = create_user(name: "Avery", email: "avery@acme.test", role: "member")
+    @owner_token = issue_token(@owner)
+    @agent_token = issue_token(@agent)
+  end
+
+  test "admins manage groups while all staff can browse them" do
+    billing = create_group(" Billing ")
+    technical = create_group("Technical Support")
+
+    assert_equal "Billing", billing["name"]
+
+    get "/api/v1/groups", headers: authenticated_headers(@agent_token)
+    assert_response :success
+    assert_equal [ billing["id"], technical["id"] ],
+      response.parsed_body.fetch("groups").pluck("id")
+
+    get "/api/v1/groups/#{billing["id"]}", headers: authenticated_headers(@agent_token)
+    assert_response :success
+    assert_equal "Billing", response.parsed_body.dig("group", "name")
+
+    patch "/api/v1/groups/#{billing["id"]}",
+      params: { group: { name: "Accounts" } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :success
+    assert_equal "Accounts", response.parsed_body.dig("group", "name")
+
+    post "/api/v1/groups",
+      params: { group: { name: "Customer Success" } },
+      headers: authenticated_headers(@agent_token),
+      as: :json
+    assert_response :forbidden
+
+    post "/api/v1/groups",
+      params: { group: { name: "accounts" } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :unprocessable_content
+
+    other_account = Account.create!(name: "Beta", subdomain: "beta")
+    other_group = other_account.groups.create!(name: "Billing")
+
+    get "/api/v1/groups/#{other_group.id}", headers: authenticated_headers(@owner_token)
+    assert_response :not_found
+
+    delete "/api/v1/groups/#{technical["id"]}", headers: authenticated_headers(@owner_token)
+    assert_response :no_content
+  end
+
+  test "memberships have one default and support staff browsing and filtering" do
+    billing = @account.groups.create!(name: "Billing")
+    technical = @account.groups.create!(name: "Technical Support")
+
+    first = create_membership(billing, @agent, default: false)
+    assert_equal true, first["default"]
+
+    second = create_membership(technical, @agent, default: false)
+    assert_equal false, second["default"]
+
+    post "/api/v1/group_memberships",
+      params: {
+        group_membership: {
+          group_id: technical.id,
+          user_id: @agent.id
+        }
+      },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/group_memberships",
+      params: {
+        group_membership: {
+          group_id: technical.id,
+          user_id: @customer.id
+        }
+      },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :unprocessable_content
+
+    put "/api/v1/group_memberships/#{second["id"]}/make_default",
+      headers: authenticated_headers(@owner_token)
+    assert_response :success
+    assert_equal false, GroupMembership.find(first["id"]).default?
+    assert_equal true, GroupMembership.find(second["id"]).default?
+
+    get "/api/v1/group_memberships",
+      params: { user_id: @agent.id },
+      headers: authenticated_headers(@agent_token)
+    assert_response :success
+    assert_equal [ first["id"], second["id"] ],
+      response.parsed_body.fetch("group_memberships").pluck("id")
+
+    get "/api/v1/group_memberships",
+      params: { group_id: technical.id },
+      headers: authenticated_headers(@agent_token)
+    assert_response :success
+    assert_equal [ second["id"] ], response.parsed_body.fetch("group_memberships").pluck("id")
+
+    put "/api/v1/group_memberships/#{first["id"]}/make_default",
+      headers: authenticated_headers(@agent_token)
+    assert_response :forbidden
+
+    delete "/api/v1/group_memberships/#{second["id"]}",
+      headers: authenticated_headers(@owner_token)
+    assert_response :no_content
+    assert_equal true, GroupMembership.find(first["id"]).reload.default?
+  end
+
+  test "ticket group and assignee changes preserve valid assignments" do
+    billing = @account.groups.create!(name: "Billing")
+    technical = @account.groups.create!(name: "Technical Support")
+    billing_membership = GroupMembership.create!(group: billing, user: @agent, default: true)
+    ticket = Ticket.create!(account: @account, requester: @customer, subject: "Invoice issue")
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { assignee_id: @agent.id } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :success
+    assert_equal billing.id, response.parsed_body.dig("ticket", "group_id")
+    assert_equal({ "id" => billing.id, "name" => billing.name },
+      response.parsed_body.dig("ticket", "group"))
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { group_id: technical.id } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :success
+    assert_equal technical.id, response.parsed_body.dig("ticket", "group_id")
+    assert_nil response.parsed_body.dig("ticket", "assignee_id")
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { assignee_id: @agent.id } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :unprocessable_content
+
+    technical_membership = GroupMembership.create!(group: technical, user: @agent)
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { assignee_id: @agent.id } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :success
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { assignee_id: nil } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :success
+    assert_equal technical.id, ticket.reload.group_id
+    assert_nil ticket.assignee_id
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { assignee_id: @agent.id } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :success
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { group_id: nil } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :success
+    assert_nil ticket.reload.group_id
+    assert_nil ticket.assignee_id
+
+    ticket.update!(group: technical, assignee: @agent)
+    get "/api/v1/tickets",
+      params: { group_id: technical.id },
+      headers: authenticated_headers(@owner_token)
+    assert_response :success
+    assert_equal [ ticket.id ], response.parsed_body.fetch("tickets").pluck("id")
+
+    ticket.update!(group: nil, assignee: nil)
+    get "/api/v1/tickets",
+      params: { group_id: "unassigned" },
+      headers: authenticated_headers(@owner_token)
+    assert_response :success
+    assert_equal [ ticket.id ], response.parsed_body.fetch("tickets").pluck("id")
+
+    technical_membership.destroy!
+    assert_equal true, billing_membership.reload.default?
+  end
+
+  test "deletions and user changes clear only assignments that become invalid" do
+    billing = @account.groups.create!(name: "Billing")
+    technical = @account.groups.create!(name: "Technical Support")
+    billing_membership = GroupMembership.create!(group: billing, user: @agent)
+    technical_membership = GroupMembership.create!(group: technical, user: @agent)
+    ticket = Ticket.create!(
+      account: @account,
+      requester: @customer,
+      group: billing,
+      assignee: @agent,
+      subject: "Charged twice"
+    )
+
+    patch "/api/v1/users/#{@agent.id}",
+      params: { user: { suspended: true } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :success
+    assert_equal 2, @agent.reload.group_memberships.count
+    assert_nil ticket.reload.assignee_id
+    assert_equal billing.id, ticket.group_id
+
+    patch "/api/v1/users/#{@agent.id}",
+      params: { user: { suspended: false } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :success
+    @agent.reload
+
+    ticket.update!(assignee: @agent)
+    billing_membership.destroy!
+    assert_nil ticket.reload.assignee_id
+    assert_equal billing.id, ticket.group_id
+    assert_equal true, technical_membership.reload.default?
+
+    ticket.update!(group: technical, assignee: @agent)
+    delete "/api/v1/groups/#{technical.id}", headers: authenticated_headers(@owner_token)
+    assert_response :no_content
+    assert_nil ticket.reload.group_id
+    assert_nil ticket.assignee_id
+
+    replacement = GroupMembership.create!(group: billing, user: @agent, default: true)
+    patch "/api/v1/users/#{@agent.id}",
+      params: { user: { role: "member" } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :success
+    assert_not GroupMembership.exists?(replacement.id)
+  end
+
+  private
+
+  def create_group(name)
+    post "/api/v1/groups",
+      params: { group: { name: name } },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :created
+
+    response.parsed_body.fetch("group")
+  end
+
+  def create_membership(group, user, default: false)
+    post "/api/v1/group_memberships",
+      params: {
+        group_membership: {
+          group_id: group.id,
+          user_id: user.id,
+          default: default
+        }
+      },
+      headers: authenticated_headers(@owner_token),
+      as: :json
+    assert_response :created
+
+    response.parsed_body.fetch("group_membership")
+  end
+
+  def create_user(name:, email:, role:, owner: false)
+    @account.users.create!(
+      name: name,
+      email: email,
+      password: "account-password",
+      role: role,
+      owner: owner,
+      verified: true
+    )
+  end
+
+  def issue_token(user)
+    Session.issue_for(user).last
+  end
+
+  def authenticated_headers(token)
+    {
+      "X-Helpdesk-Account" => @account.subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+end
