--- /dev/null
+++ b/app/models/support_email_address.rb
@@ -0,0 +1,17 @@
+class SupportEmailAddress
+  DEFAULT_DOMAIN = "support.example.test"
+
+  class << self
+    def domain
+      ENV.fetch("HELPDESK_SUPPORT_DOMAIN", DEFAULT_DOMAIN).to_s.strip.downcase.presence || DEFAULT_DOMAIN
+    end
+
+    def parse(email)
+      address = Mail::Address.new(email.to_s).address.to_s.strip.downcase
+      local, separator, recipient_domain = address.rpartition("@")
+      return unless separator.present? && local.present? && recipient_domain == domain
+
+      [ address, local, recipient_domain ]
+    end
+  end
+end
