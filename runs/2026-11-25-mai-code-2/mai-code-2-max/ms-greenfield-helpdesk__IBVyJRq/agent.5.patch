diff --git a/app/mailboxes/support_mailbox.rb b/app/mailboxes/support_mailbox.rb
new file mode 100644
index 0000000..a0dd280
--- /dev/null
+++ b/app/mailboxes/support_mailbox.rb
@@ -0,0 +1,208 @@
+class SupportMailbox < ApplicationMailbox
+  AUTOMATED_PRECEDENCE_VALUES = %w[auto_reply bulk junk list].freeze
+
+  before_processing :ignore_automated_email
+
+  def process
+    attributes = accepted_message_attributes
+    unless attributes
+      bounced!
+      return
+    end
+
+    result = record_delivery(attributes)
+    bounced! unless result == :accepted
+  end
+
+  private
+
+  def ignore_automated_email
+    bounced! if automated_email?
+  end
+
+  def automated_email?
+    auto_submitted = header_value("Auto-Submitted")
+    return true if auto_submitted.present? && !auto_submitted.casecmp?("no")
+
+    return true if mail.header.fields.any? { |field| field.name.match?(/\AList-/i) }
+    return true if header_value("X-Auto-Response-Suppress").present?
+    return true if header_value("X-Autorespond").present? || header_value("X-Autoreply").present?
+    return true if header_value("X-Mailing-List").present? || header_value("X-Loop").present?
+    return true if header_value("Return-Path") == "<>"
+
+    header_value("Precedence").to_s.downcase.split(/[,;\s]+/).any? do |value|
+      AUTOMATED_PRECEDENCE_VALUES.include?(value)
+    end
+  end
+
+  def accepted_message_attributes
+    sender = sender_details
+    destination = resolve_destination
+    subject = mail.subject.to_s.strip
+    body = plain_text_body
+
+    return if sender.blank? || destination.blank? || subject.blank? || body.blank?
+    return if subject.length > 255 || body.length > 20_000
+    return unless sender[:email].match?(URI::MailTo::EMAIL_REGEXP)
+
+    {
+      message_id: inbound_email.message_id.to_s.strip.downcase,
+      sender: sender,
+      destination: destination,
+      subject: subject,
+      body: body
+    }
+  end
+
+  def record_delivery(attributes)
+    result = :invalid
+
+    EmailDelivery.transaction do
+      delivery = EmailDelivery.create_or_find_by!(message_id: attributes[:message_id])
+      unless delivery.previously_new_record?
+        result = :duplicate
+        raise ActiveRecord::Rollback
+      end
+
+      account = Account.lock.find_by(id: attributes[:destination][:account_id])
+      unless account&.active?
+        raise ActiveRecord::Rollback
+      end
+
+      result = if attributes[:destination][:ticket_id]
+        record_reply(account, attributes)
+      else
+        record_new_ticket(account, attributes)
+      end
+      raise ActiveRecord::Rollback unless result == :accepted
+    end
+
+    result
+  end
+
+  def record_new_ticket(account, attributes)
+    Invitation.expire_due!(account: account, email: attributes[:sender][:email])
+    requester = account.users.find_by(email: attributes[:sender][:email])
+    new_requester = requester.nil?
+
+    if requester
+      return :invalid unless requester.customer?
+    else
+      return :invalid if account.invitations.pending.exists?(
+        email: attributes[:sender][:email],
+        accepted_user_id: nil
+      )
+
+      requester = account.users.create!(
+        name: attributes[:sender][:name],
+        email: attributes[:sender][:email],
+        password: SecureRandom.base64(48),
+        role: "member",
+        verified: false
+      )
+    end
+
+    verification = requester.rotate_email_verification_token! if new_requester
+
+    ticket = account.tickets.create!(
+      requester: requester,
+      subject: attributes[:subject],
+      status: "open",
+      email_origin: true
+    )
+    ticket.comments.create!(author: requester, body: attributes[:body], public: true)
+
+    if verification
+      UserMailer.with(user: requester, token: verification).email_verification.deliver_now
+    end
+
+    :accepted
+  end
+
+  def record_reply(account, attributes)
+    ticket = account.tickets.lock.find_by(id: attributes[:destination][:ticket_id])
+    return :invalid unless ticket
+    return :invalid unless ticket.requester.email.casecmp?(attributes[:sender][:email])
+
+    ticket.comments.create!(author: ticket.requester, body: attributes[:body], public: true)
+    ticket.status = "open" if %w[pending solved].include?(ticket.status)
+    ticket.save! if ticket.changed?
+
+    :accepted
+  end
+
+  def resolve_destination
+    recipients = Array(mail.recipients).filter_map { |email| destination_for(email) }
+    return if recipients.blank?
+    return unless recipients.map { |destination| destination[:account_id] }.uniq.one?
+
+    destinations = recipients.uniq { |destination| [ destination[:account_id], destination[:ticket_id] ] }
+    return unless destinations.one?
+
+    destinations.first
+  end
+
+  def destination_for(email)
+    _address, local, = SupportEmailAddress.parse(email)
+    return unless local
+
+    first, separator, token = local.partition("+")
+    if separator.present?
+      ticket = if %w[reply ticket].include?(first)
+        Ticket.includes(:account).find_by(reply_token: token)
+      else
+        account = Account.find_by(subdomain: first)
+        account&.tickets&.find_by(reply_token: token)
+      end
+      return unless ticket
+
+      { account_id: ticket.account_id, ticket_id: ticket.id }
+    else
+      account = Account.find_by(subdomain: local)
+      { account_id: account.id, ticket_id: nil } if account
+    end
+  end
+
+  def sender_details
+    field = mail[:from]
+    addresses = field&.addresses.to_a
+    return unless addresses&.one?
+
+    address = addresses.first.to_s.strip.downcase
+    name = field.display_names.first.to_s.strip
+    name = address.split("@", 2).first if name.blank?
+
+    { email: address, name: name[0, 120].presence || address[0, 120] }
+  end
+
+  def plain_text_body
+    part = plain_text_part(mail)
+    return unless part
+
+    encoding = part.charset.presence || "UTF-8"
+    part.body.decoded.to_s
+      .force_encoding(encoding)
+      .encode("UTF-8", invalid: :replace, undef: :replace)
+      .delete("\r")
+      .strip
+      .presence
+  rescue ArgumentError, Encoding::InvalidByteSequenceError, Encoding::UndefinedConversionError
+    nil
+  end
+
+  def plain_text_part(part)
+    return if part.attachment?
+    return part if part.mime_type.blank? || part.mime_type == "text/plain"
+
+    part.parts.each do |child|
+      text_part = plain_text_part(child)
+      return text_part if text_part
+    end
+
+    nil
+  end
+
+  def header_value(name)
+    mail.header[name]&.value.to_s.strip
+  end
+end
