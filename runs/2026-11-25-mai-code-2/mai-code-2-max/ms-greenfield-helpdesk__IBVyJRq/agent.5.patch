diff --git a/test/integration/email_support_test.rb b/test/integration/email_support_test.rb
new file mode 100644
index 0000000..ed885d5
--- /dev/null
+++ b/test/integration/email_support_test.rb
@@ -0,0 +1,238 @@
+require "test_helper"
+
+class EmailSupportTest < ActionDispatch::IntegrationTest
+  setup do
+    @previous_ingress_password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"]
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = "inbound-secret"
+    ActionMailer::Base.deliveries.clear
+
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @other_account = Account.create!(name: "Beta", subdomain: "beta")
+    @owner = @account.users.create!(
+      name: "Owner",
+      email: "owner@example.test",
+      password: "owner-password",
+      role: "admin",
+      owner: true,
+      verified: true
+    )
+  end
+
+  teardown do
+    if @previous_ingress_password
+      ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @previous_ingress_password
+    else
+      ENV.delete("RAILS_INBOUND_EMAIL_PASSWORD")
+    end
+  end
+
+  test "relay creates a customer and ticket before the request completes" do
+    relay_mail(
+      from: "Alice Example <Alice@Example.test>",
+      to: "acme@support.example.test",
+      subject: "Cannot sign in",
+      body: "Please reset access.",
+      message_id: "<new-ticket@example.test>"
+    )
+
+    assert_response :no_content
+    ticket = @account.tickets.sole
+    requester = ticket.requester
+    assert_equal "alice@example.test", requester.email
+    assert_equal "Alice Example", requester.name
+    assert_equal "member", requester.role
+    assert_not requester.verified?
+    assert ticket.email_origin?
+    assert_equal "Cannot sign in", ticket.subject
+    assert_equal "Please reset access.", ticket.comments.sole.body
+    assert_equal "delivered", ActionMailbox::InboundEmail.sole.status
+    assert_equal 1, ActionMailer::Base.deliveries.length
+    assert_equal [ requester.email ], ActionMailer::Base.deliveries.sole.to
+    assert_match "\+#{ticket.reply_token}@support.example.test", ticket.reply_address
+  end
+
+  test "Cc selects the business and mail for multiple businesses is retryable" do
+    relay_mail(
+      from: "alice@example.test",
+      to: "unrelated@example.test",
+      cc: [ "acme@support.example.test", "beta@support.example.test" ],
+      subject: "Invalid first attempt",
+      body: "Do not create this.",
+      message_id: "<retryable@example.test>"
+    )
+    assert_response :no_content
+    assert_equal 0, Ticket.count
+    assert_equal "bounced", ActionMailbox::InboundEmail.sole.status
+
+    relay_mail(
+      from: "alice@example.test",
+      to: "unrelated@example.test",
+      cc: "acme@support.example.test",
+      subject: "Valid retry",
+      body: "Now create it.",
+      message_id: "<retryable@example.test>"
+    )
+    assert_response :no_content
+    assert_equal 1, @account.tickets.count
+    assert_equal "Valid retry", @account.tickets.sole.subject
+  end
+
+  test "an unchanged delivery can be retried after it was rejected" do
+    @account.update!(cancelled_at: Time.current)
+    source = {
+      from: "alice@example.test",
+      to: "acme@support.example.test",
+      subject: "Retry without edits",
+      body: "The business was temporarily unavailable.",
+      message_id: "<unchanged-retry@example.test>"
+    }
+
+    relay_mail(**source)
+    assert_response :no_content
+    assert_equal 0, @account.tickets.count
+
+    @account.update!(cancelled_at: nil)
+    relay_mail(**source)
+    assert_response :no_content
+    assert_equal 1, @account.tickets.count
+    assert_equal %w[bounced delivered], ActionMailbox::InboundEmail.order(:id).pluck(:status)
+  end
+
+  test "Message-ID duplicates and automated mail are ignored" do
+    relay_mail(
+      from: "alice@example.test",
+      to: "acme@support.example.test",
+      subject: "Original",
+      body: "Original body.",
+      message_id: "<duplicate@example.test>"
+    )
+    relay_mail(
+      from: "alice@example.test",
+      to: "acme@support.example.test",
+      subject: "Changed duplicate",
+      body: "Duplicate body.",
+      message_id: "<duplicate@example.test>"
+    )
+    relay_mail(
+      from: "automation@example.test",
+      to: "acme@support.example.test",
+      subject: "Automatic response",
+      body: "Out of office.",
+      message_id: "<automatic@example.test>",
+      "Auto-Submitted" => "auto-generated"
+    )
+
+    assert_equal 1, @account.tickets.count
+    assert_equal 1, @account.tickets.sole.comments.count
+    assert_equal 0, @account.users.where(email: "automation@example.test").count
+    assert_equal [ "delivered", "bounced" ],
+      ActionMailbox::InboundEmail.order(:id).pluck(:status)
+  end
+
+  test "staff public replies are emailed and only the requester can reopen by email" do
+    customer = @account.users.create!(
+      name: "Alice",
+      email: "alice@example.test",
+      password: "customer-password",
+      role: "member",
+      verified: true
+    )
+    ticket = @account.tickets.create!(
+      requester: customer,
+      subject: "Email question",
+      status: "pending",
+      email_origin: true
+    )
+    ticket.comments.create!(author: customer, body: "Initial email.", public: true)
+    ActionMailer::Base.deliveries.clear
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { comment: { body: "Here is the answer.", public: true } } },
+      headers: {
+        "X-Helpdesk-Account" => @account.subdomain,
+        "Authorization" => "Bearer #{Session.issue_for(@owner).last}"
+      },
+      as: :json
+    assert_response :success
+
+    notification = ActionMailer::Base.deliveries.sole
+    assert_equal [ customer.email ], notification.to
+    assert_equal [ ticket.reply_address ], notification.reply_to
+    assert_equal [ @account.support_email_address ], notification.from
+    assert_includes notification.body.decoded, "Here is the answer."
+
+    relay_mail(
+      from: "imposter@example.test",
+      to: ticket.reply_address,
+      subject: "Re: Email question",
+      body: "Wrong sender.",
+      message_id: "<imposter@example.test>"
+    )
+    assert_equal 2, ticket.comments.count
+    assert_equal "pending", ticket.reload.status
+
+    relay_mail(
+      from: customer.email,
+      to: ticket.reply_address,
+      subject: "Re: Email question",
+      body: "One more question.",
+      message_id: "<requester-reply@example.test>"
+    )
+    assert_equal 3, ticket.comments.count
+    assert_equal "open", ticket.reload.status
+    assert_equal "One more question.", ticket.comments.last.body
+  end
+
+  test "private staff notes do not send customer email" do
+    customer = @account.users.create!(
+      name: "Alice",
+      email: "alice@example.test",
+      password: "customer-password",
+      role: "member",
+      verified: true
+    )
+    ticket = @account.tickets.create!(
+      requester: customer,
+      subject: "Private note",
+      email_origin: true
+    )
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { comment: { body: "Internal only", public: false } } },
+      headers: {
+        "X-Helpdesk-Account" => @account.subdomain,
+        "Authorization" => "Bearer #{Session.issue_for(@owner).last}"
+      },
+      as: :json
+
+    assert_response :success
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  private
+
+  def relay_mail(from:, to:, subject:, body:, message_id:, cc: nil, **headers)
+    message = Mail.new do
+      from from
+      to to
+      cc cc if cc
+      subject subject
+      text_part do
+        body body
+        content_type "text/plain; charset=UTF-8"
+      end
+    end
+    message.message_id = message_id
+    headers.each { |name, value| message[name] = value }
+
+    post "/rails/action_mailbox/relay/inbound_emails",
+      params: message.encoded,
+      headers: {
+        "CONTENT_TYPE" => "message/rfc822",
+        "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials(
+          "actionmailbox",
+          ENV.fetch("RAILS_INBOUND_EMAIL_PASSWORD")
+        )
+      }
+  end
+end
