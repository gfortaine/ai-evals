@@ -0,0 +1,15 @@
+class TicketMailer < ApplicationMailer
+  def public_reply
+    @comment = params.fetch(:comment)
+    @ticket = @comment.ticket
+    @account = @ticket.account
+
+    subject = @ticket.subject.match?(/\ARe:/i) ? @ticket.subject : "Re: #{@ticket.subject}"
+    mail(
+      to: @ticket.requester.email,
+      from: @account.support_email_address,
+      reply_to: @ticket.reply_address,
+      subject: subject
+    )
+  end
+end
