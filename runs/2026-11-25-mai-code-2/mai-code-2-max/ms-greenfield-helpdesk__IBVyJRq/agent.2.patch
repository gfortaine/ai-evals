@@ -0,0 +1,312 @@
+require "test_helper"
+require "uri"
+
+class PortalConversationsApiTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "customers register and use the existing identity flows" do
+    account = Account.create!(name: "Acme", subdomain: "acme")
+
+    post "/api/v1/registrations",
+      params: {
+        user: {
+          name: "Avery",
+          email: "AVERY@example.test",
+          password: "my-customer-password"
+        }
+      },
+      headers: account_headers(account),
+      as: :json
+
+    assert_response :created
+    user_id = response.parsed_body.dig("user", "id")
+    assert_equal "member", response.parsed_body.dig("user", "role")
+    assert_equal "avery@example.test", response.parsed_body.dig("user", "email")
+    assert_equal false, response.parsed_body.dig("user", "verified")
+
+    post "/api/v1/sessions",
+      params: { session: { email: "avery@example.test", password: "my-customer-password" } },
+      headers: account_headers(account),
+      as: :json
+    assert_response :unauthorized
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token_from_latest_mail } },
+      headers: account_headers(account),
+      as: :json
+    assert_response :success
+    assert_equal true, response.parsed_body.dig("user", "verified")
+
+    post "/api/v1/sessions",
+      params: { session: { email: "avery@example.test", password: "my-customer-password" } },
+      headers: account_headers(account),
+      as: :json
+    assert_response :success
+    token = response.parsed_body.dig("session", "token")
+
+    get "/api/v1/me", headers: authenticated_headers(token, account)
+    assert_response :success
+    assert_equal user_id, response.parsed_body.dig("user", "id")
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "avery@example.test" } },
+      headers: account_headers(account),
+      as: :json
+    assert_response :accepted
+
+    post "/api/v1/password_resets/confirm",
+      params: {
+        password_reset: {
+          token: token_from_latest_mail,
+          password: "new-customer-password"
+        }
+      },
+      headers: account_headers(account),
+      as: :json
+    assert_response :success
+
+    get "/api/v1/me", headers: authenticated_headers(token, account)
+    assert_response :unauthorized
+  end
+
+  test "request comments and replies enforce owner and customer status transitions" do
+    account, owner, customer = create_portal_users
+    owner_token = issue_token(owner)
+    customer_token = issue_token(customer)
+
+    post "/api/v1/requests",
+      params: {
+        request: {
+          subject: "Cannot download my receipt",
+          comment: { body: "The download button does nothing." }
+        }
+      },
+      headers: authenticated_headers(customer_token, account),
+      as: :json
+
+    assert_response :created
+    ticket_id = response.parsed_body.dig("request", "id")
+    assert_equal "open", response.parsed_body.dig("request", "status")
+    assert_equal customer.id, response.parsed_body.dig("request", "requester_id")
+    assert response.parsed_body.dig("request", "created_at")
+    assert response.parsed_body.dig("request", "updated_at")
+
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: {
+        ticket: {
+          comment: { body: "Please try again now." },
+          status: "pending"
+        }
+      },
+      headers: authenticated_headers(owner_token, account),
+      as: :json
+    assert_response :success
+    assert_equal "pending", response.parsed_body.dig("ticket", "status")
+    assert_equal(
+      { "id" => customer.id, "name" => customer.name, "email" => customer.email },
+      response.parsed_body.dig("ticket", "requester")
+    )
+
+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { comment: { body: "It still fails." } } },
+      headers: authenticated_headers(customer_token, account),
+      as: :json
+    assert_response :success
+    assert_equal "open", response.parsed_body.dig("request", "status")
+
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { comment: { body: "I checked the account." } } },
+      headers: authenticated_headers(owner_token, account),
+      as: :json
+    assert_response :success
+    assert_equal "open", response.parsed_body.dig("ticket", "status")
+
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { status: "solved" } },
+      headers: authenticated_headers(owner_token, account),
+      as: :json
+    assert_response :success
+
+    patch "/api/v1/requests/#{ticket_id}",
+      params: {
+        request: {
+          comment: { body: "Confirmed, thank you." },
+          status: "solved"
+        }
+      },
+      headers: authenticated_headers(customer_token, account),
+      as: :json
+    assert_response :success
+    assert_equal "solved", response.parsed_body.dig("request", "status")
+
+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { comment: { body: "One more question." } } },
+      headers: authenticated_headers(customer_token, account),
+      as: :json
+    assert_response :success
+    assert_equal "open", response.parsed_body.dig("request", "status")
+
+    get "/api/v1/requests/#{ticket_id}/comments",
+      headers: authenticated_headers(customer_token, account)
+    assert_response :success
+    comments = response.parsed_body.fetch("comments")
+    assert_equal 6, comments.length
+    assert_equal "The download button does nothing.", comments.first["body"]
+    assert_equal(
+      { "id" => customer.id, "name" => customer.name },
+      comments.first["author"]
+    )
+    assert_equal true, comments.first["public"]
+    assert comments.first["created_at"]
+
+    get "/api/v1/tickets/#{ticket_id}/comments",
+      headers: authenticated_headers(customer_token, account)
+    assert_response :forbidden
+
+    get "/api/v1/requests",
+      headers: authenticated_headers(owner_token, account)
+    assert_response :forbidden
+    assert_equal 0, ActionMailer::Base.deliveries.size
