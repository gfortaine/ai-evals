@@ -0,0 +1,20 @@
+class Comment < ApplicationRecord
+  belongs_to :ticket, touch: true
+  belongs_to :author, class_name: "User", inverse_of: :comments
+
+  validates :body, presence: true, length: { maximum: 20_000 }
+  validates :public, inclusion: { in: [ true, false ] }
+  validate :author_belongs_to_ticket_account
+
+  scope :oldest_first, -> { order(created_at: :asc, id: :asc) }
+  scope :visible_to_customers, -> { where(public: true) }
+
+  private
+
+  def author_belongs_to_ticket_account
+    return unless author && ticket
+    return if author.account_id == ticket.account_id
+
+    errors.add(:author, "must belong to the ticket account")
+  end
+end
