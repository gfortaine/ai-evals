index 0000000..bbf37c0
--- /dev/null
+++ b/app/controllers/api/v1/tickets_controller.rb
@@ -0,0 +1,64 @@
+class Api::V1::TicketsController < Api::V1::BaseController
+  before_action :set_account
+  before_action :authenticate_user!
+  before_action :require_active_account!
+  before_action :require_staff!
+  before_action :set_ticket, only: %i[show update comments]
+
+  def index
+    tickets, pagination = paginate(
+      current_account.tickets.includes(:requester).recently_active
+    )
+    render json: {
+      tickets: tickets.map { |ticket| ticket_json(ticket, include_requester: true) }
+    }.merge(pagination)
+  end
+
+  def show
+    render json: { ticket: ticket_json(@ticket, include_requester: true) }
+  end
+
+  def update
+    ticket_params = params.require(:ticket)
+    comment = comment_parameters(ticket_params)
+    status_supplied = ticket_params.key?(:status)
+
+    @ticket.with_lock do
+      if comment
+        @ticket.comments.create!(
+          author: current_user,
+          body: comment.require(:body),
+          public: comment.fetch(:public, true)
+        )
+      end
+
+      if status_supplied
+        @ticket.status = ticket_params[:status]
+        @ticket.save!
+      end
+    end
+
+    render json: { ticket: ticket_json(@ticket, include_requester: true) }
+  end
+
+  def comments
+    comments, pagination = paginate(
+      @ticket.comments.includes(:author).oldest_first
+    )
+    render json: {
+      comments: comments.map { |comment| comment_json(comment) }
+    }.merge(pagination)
+  end
+
+  private
+
+  def set_ticket
+    @ticket = current_account.tickets.includes(:requester).find(params[:id])
+  end
+
+  def comment_parameters(ticket_params)
+    return unless ticket_params.key?(:comment)
+
+    ticket_params.require(:comment).permit(:body, :public)
+  end
+end
