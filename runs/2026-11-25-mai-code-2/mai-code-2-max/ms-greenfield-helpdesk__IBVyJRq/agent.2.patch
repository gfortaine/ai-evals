+
+  test "portal lists are paginated and scoped to the current customer and account" do
+    account, owner, first_customer = create_portal_users
+    second_customer = account.users.create!(
+      name: "Blake",
+      email: "blake@example.test",
+      password: "blake-password",
+      role: "member",
+      verified: true
+    )
+    owner_token = issue_token(owner)
+    customer_token = issue_token(first_customer)
+    second_customer_token = issue_token(second_customer)
+
+    first_ticket = create_request(first_customer, "First", customer_token, account)
+    second_ticket = create_request(first_customer, "Second", customer_token, account)
+    create_request(second_customer, "Other customer", second_customer_token, account)
+
+    first_ticket.update_columns(updated_at: 2.days.ago)
+    second_ticket.update_columns(updated_at: 1.day.ago)
+
+    get "/api/v1/requests", params: { page: 1, per_page: 1 },
+      headers: authenticated_headers(customer_token, account)
+    assert_response :success
+    assert_equal 2, response.parsed_body["count"]
+    assert_equal 1, response.parsed_body["page"]
+    assert_equal 1, response.parsed_body["per_page"]
+    assert_equal 2, response.parsed_body["next_page"]
+    assert_nil response.parsed_body["previous_page"]
+    assert_equal second_ticket.id, response.parsed_body.dig("requests", 0, "id")
+
+    get "/api/v1/requests", params: { page: 2, per_page: 1 },
+      headers: authenticated_headers(customer_token, account)
+    assert_response :success
+    assert_nil response.parsed_body["next_page"]
+    assert_equal 1, response.parsed_body["previous_page"]
+    assert_equal first_ticket.id, response.parsed_body.dig("requests", 0, "id")
+
+    get "/api/v1/requests/#{Ticket.where(requester: second_customer).pick(:id)}",
+      headers: authenticated_headers(customer_token, account)
+    assert_response :not_found
+
+    patch "/api/v1/tickets/#{first_ticket.id}",
+      params: { ticket: { comment: { body: "A new update." } } },
+      headers: authenticated_headers(owner_token, account),
+      as: :json
+    assert_response :success
+
+    get "/api/v1/tickets", params: { page: 1, per_page: 25 },
+      headers: authenticated_headers(owner_token, account)
+    assert_response :success
+    assert_equal 3, response.parsed_body["count"]
+    assert_equal first_ticket.id, response.parsed_body.dig("tickets", 0, "id")
+    assert_equal first_customer.id,
+      response.parsed_body.dig("tickets", 0, "requester", "id")
+
+    get "/api/v1/requests", params: { page: 0 },
+      headers: authenticated_headers(customer_token, account)
+    assert_response :bad_request
+  end
+
+  test "staff comments can be private while customer replies stay public" do
+    account, owner, customer = create_portal_users
+    owner_token = issue_token(owner)
+    customer_token = issue_token(customer)
+    ticket = create_request(customer, "Private note", customer_token, account)
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: {
+        ticket: {
+          comment: { body: "Internal handoff", public: false }
+        }
+      },
+      headers: authenticated_headers(owner_token, account),
+      as: :json
+    assert_response :success
+
+    get "/api/v1/tickets/#{ticket.id}/comments",
+      headers: authenticated_headers(owner_token, account)
+    assert_response :success
+    assert_equal [ true, false ], response.parsed_body["comments"].map { |comment| comment["public"] }
+
+    get "/api/v1/requests/#{ticket.id}/comments",
+      params: { per_page: 1 },
+      headers: authenticated_headers(customer_token, account)
+    assert_response :success
+    assert_equal 1, response.parsed_body["count"]
+    assert_equal true, response.parsed_body.dig("comments", 0, "public")
+  end
+
+  private
+
+  def create_portal_users
+    account = Account.create!(name: "Acme", subdomain: "acme")
+    owner = account.users.create!(
+      name: "Jo",
+      email: "jo@acme.test",
+      password: "owner-password",
+      role: "admin",
+      owner: true,
+      verified: true
+    )
+    customer = account.users.create!(
+      name: "Avery",
+      email: "avery@example.test",
+      password: "customer-password",
+      role: "member",
+      verified: true
+    )
+
+    [ account, owner, customer ]
+  end
+
+  def create_request(customer, subject, token, account)
+    post "/api/v1/requests",
+      params: { request: { subject: subject, comment: { body: "Please help." } } },
+      headers: authenticated_headers(token, account),
+      as: :json
+    assert_response :created
+
+    Ticket.find(response.parsed_body.dig("request", "id"))
+  end
+
+  def issue_token(user)
+    Session.issue_for(user).last
+  end
+
+  def token_from_latest_mail
+    link = ActionMailer::Base.deliveries.last.body.decoded[%r{https?://[^\s]+}]
+    URI.decode_www_form_component(link[/[?&]token=([^&\s]+)/, 1])
+  end
+
+  def account_headers(account)
+    { "X-Helpdesk-Account" => account.subdomain }
+  end
+
+  def authenticated_headers(token, account)
+    account_headers(account).merge("Authorization" => "Bearer #{token}")
+  end
+end
