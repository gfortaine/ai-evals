@@ -0,0 +1,17 @@
+class Api::V1::RegistrationsController < Api::V1::BaseController
+  before_action :set_account
+  before_action :require_active_account!
+
+  def create
+    attributes = params.require(:user).permit(:name, :email, :password)
+    token = nil
+
+    User.transaction do
+      @user = current_account.users.create!(attributes.merge(role: "member"))
+      token = @user.rotate_email_verification_token!
+    end
+
+    UserMailer.with(user: @user, token: token).email_verification.deliver_now
+    render json: { user: user_json(@user) }, status: :created
+  end
+end
diff --git a/app/controllers/api/v1/requests_controller.rb b/app/controllers/api/v1/requests_controller.rb
new file mode 100644
index 0000000..5438a62
--- /dev/null
+++ b/app/controllers/api/v1/requests_controller.rb
@@ -0,0 +1,91 @@
+class Api::V1::RequestsController < Api::V1::BaseController
+  before_action :set_account
+  before_action :authenticate_user!
+  before_action :require_active_account!
+  before_action :require_customer!
+  before_action :set_request, only: %i[show update comments]
+
+  def index
+    requests, pagination = paginate(current_user.requested_tickets.recently_active)
+    render json: {
+      requests: requests.map { |ticket| ticket_json(ticket) }
+    }.merge(pagination)
+  end
+
+  def show
+    render json: { request: ticket_json(@ticket) }
+  end
+
+  def create
+    request_params = params.require(:request)
+    subject = request_params.require(:subject)
+    body = request_params.require(:comment).permit(:body).require(:body)
+
+    ticket = Ticket.new(
+      account: current_account,
+      requester: current_user,
+      subject: subject,
+      status: "open"
+    )
+
+    ticket.transaction do
+      ticket.save!
+      ticket.comments.create!(author: current_user, body: body, public: true)
+    end
+
+    render json: { request: ticket_json(ticket) }, status: :created
+  end
+
+  def update
+    request_params = params.require(:request)
+    comment_supplied = request_params.key?(:comment)
+    body = comment_body(request_params)
+    status_supplied = request_params.key?(:status)
+    supplied_status = request_params[:status]
+
+    if status_supplied && supplied_status != "solved"
+      @ticket.errors.add(:status, "can only be set to solved by a customer")
+      raise ActiveRecord::RecordInvalid, @ticket
+    end
+
+    @ticket.with_lock do
+      if comment_supplied
+        @ticket.comments.create!(author: current_user, body: body, public: true)
+      end
+
+      if status_supplied
+        @ticket.status = "solved"
+      elsif comment_supplied && %w[pending solved].include?(@ticket.status)
+        @ticket.status = "open"
+      end
+
+      @ticket.save! if @ticket.changed?
+    end
+
+    render json: { request: ticket_json(@ticket) }
+  end
+
+  def comments
+    comments, pagination = paginate(
+      @ticket.comments.visible_to_customers.includes(:author).oldest_first
+    )
+    render json: {
+      comments: comments.map { |comment| comment_json(comment) }
+    }.merge(pagination)
+  end
+
+  private
+
+  def set_request
+    @ticket = current_account.tickets.find_by!(
+      id: params[:id],
+      requester_id: current_user.id
+    )
+  end
+
+  def comment_body(request_params)
+    return unless request_params.key?(:comment)
+
+    request_params.require(:comment).permit(:body).require(:body)
+  end
+end
diff --git a/app/controllers/api/v1/tickets_controller.rb b/app/controllers/api/v1/tickets_controller.rb
