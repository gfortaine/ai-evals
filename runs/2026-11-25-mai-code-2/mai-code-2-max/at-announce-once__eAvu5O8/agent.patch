diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..1454631 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,28 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_save :defer_publication_announcement, if: -> { saved_change_to_published?(from: false, to: true) }
   end
 
   private
+    def defer_publication_announcement
+      return if @publication_announcement_deferred
+
+      @publication_announcement_deferred = true
+      transaction = self.class.current_transaction
+      transaction.after_commit { announce_publication }
+      transaction.after_rollback { clear_publication_announcement }
+    end
+
     def announce_publication
-      AnnouncePublicationJob.perform_later self
+      AnnouncePublicationJob.perform_later self if self.class.published.exists?(id: id)
+    ensure
+      clear_publication_announcement
+    end
+
+    def clear_publication_announcement
+      if instance_variable_defined?(:@publication_announcement_deferred)
+        remove_instance_variable(:@publication_announcement_deferred)
+      end
     end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..f70af6b 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class BookTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
   test "slug is generated from title" do
     book = Book.create!(title: "Hello, World!")
     assert_equal "hello-world", book.slug
@@ -40,4 +42,53 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "announces a publication once after all changes in the transaction commit" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.press Page.new(body: ""), title: "A new page"
+      end
+    end
+
+    assert_predicate book.reload, :published?
+  end
+
+  test "does not announce an already-published book when saved" do
+    book = books(:manual)
+    book.update!(published: true)
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(title: "An updated manual")
+    end
+  end
+
+  test "does not announce an unpublished book" do
+    book = books(:manual)
+    book.update!(published: true)
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(published: false)
+    end
+  end
+
+  test "does not announce a publication that is rolled back" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises RuntimeError do
+        book.transaction do
+          book.update!(published: true)
+          book.press Page.new(body: ""), title: "A rolled back page"
+          raise "The transaction failed"
+        end
+      end
+    end
+
+    assert_not_predicate book.reload, :published?
+  end
 end
