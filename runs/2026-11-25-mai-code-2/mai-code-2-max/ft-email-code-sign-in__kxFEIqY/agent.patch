+require "test_helper"
+
+class Identity::EmailCodeTest < ActiveSupport::TestCase
+  test "issues a six-character code" do
+    SecureRandom.stubs(:base58).with(Identity::EmailCode::CODE_LENGTH).returns("ab12cd")
+
+    email_code = Identity::EmailCode.issue(email_address: " Person@Example.com ", purpose: :sign_in)
+
+    assert_equal "AB12CD", email_code.code
+    assert_match /\A[A-Z0-9]{6}\z/, email_code.code
+    assert_equal "person@example.com", email_code.email_address
+  end
+
+  test "validates a code from a signed challenge" do
+    email_code = Identity::EmailCode.issue(email_address: "person@example.com", purpose: :signup)
+    restored_email_code = Identity::EmailCode.from_signed(email_code.signed)
+
+    assert restored_email_code.valid_code?(email_code.code.downcase)
+    assert_not restored_email_code.valid_code?("WRONG1")
+  end
+
+  test "codes expire after fifteen minutes" do
+    freeze_time do
+      email_code = Identity::EmailCode.issue(email_address: "person@example.com", purpose: :sign_in)
+      signed = email_code.signed
+
+      travel 14.minutes + 59.seconds
+      assert Identity::EmailCode.from_signed(signed).valid_code?(email_code.code)
+
+      travel 1.second
+      restored_email_code = Identity::EmailCode.from_signed(signed)
+      assert_predicate restored_email_code, :expired?
+      assert_not restored_email_code.valid_code?(email_code.code)
+    end
+  end
+
+  test "rejects a changed signed challenge" do
+    email_code = Identity::EmailCode.issue(email_address: "person@example.com", purpose: :join)
+    signed = email_code.signed
+
+    assert_nil Identity::EmailCode.from_signed("#{signed}changed")
+  end
+
+  test "rejects unknown purposes" do
+    assert_raises ArgumentError do
+      Identity::EmailCode.issue(email_address: "person@example.com", purpose: :unknown)
+    end
+  end
+end
