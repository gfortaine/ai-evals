@@ -0,0 +1,17 @@
+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "email code is included in the subject and body" do
+    code = "AB12CD"
+    email = IdentityMailer.email_code(email_address: "person@example.com", code: code)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "person@example.com" ], email.to
+    assert_includes email.subject, code
+    assert_match code, email.html_part.body.decoded
+    assert_match code, email.text_part.body.decoded
