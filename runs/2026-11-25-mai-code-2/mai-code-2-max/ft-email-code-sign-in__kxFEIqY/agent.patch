diff --git a/app/models/identity/email_code.rb b/app/models/identity/email_code.rb
new file mode 100644
index 0000000..c21d880
--- /dev/null
+++ b/app/models/identity/email_code.rb
@@ -0,0 +1,81 @@
+class Identity::EmailCode
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  PURPOSE = :email_code
+  VALID_PURPOSES = %w[ sign_in signup join ].freeze
+
+  attr_reader :email_address, :expires_at, :join_code, :join_code_id, :purpose
+  attr_reader :code
+
+  class << self
+    def issue(email_address:, purpose:, join_code: nil, join_code_id: nil)
+      identity = Identity.new(email_address: email_address)
+      purpose = purpose.to_s
+
+      raise ArgumentError, "Unknown email code purpose: #{purpose}" unless purpose.in?(VALID_PURPOSES)
+      raise ActiveRecord::RecordInvalid, identity unless identity.valid?
+
+      new(
+        email_address: identity.email_address,
+        code: generate_code,
+        purpose: purpose,
+        expires_at: EXPIRATION.from_now,
+        join_code: join_code,
+        join_code_id: join_code_id
+      )
+    end
+
+    def from_signed(token)
+      if payload = verifier.verified(token, purpose: PURPOSE)
+        new(**payload.symbolize_keys)
+      end
+    end
+
+    def sign(payload)
+      verifier.generate(payload, purpose: PURPOSE)
+    end
+
+    private
+      def generate_code
+        SecureRandom.base58(CODE_LENGTH).upcase
+      end
+
+      def verifier
+        Rails.application.message_verifier(:email_codes)
+      end
+  end
+
+  def initialize(email_address:, purpose:, expires_at:, code: nil, code_digest: nil, join_code: nil, join_code_id: nil)
+    @email_address = email_address
+    @purpose = purpose
+    @expires_at = Time.zone.at(expires_at.to_f)
+    @join_code = join_code
+    @join_code_id = join_code_id
+    @code = code
+    @code_digest = code_digest || digest(code)
+  end
+
+  def valid_code?(code)
+    !expired? && ActiveSupport::SecurityUtils.secure_compare(@code_digest, digest(code))
+  end
+
+  def expired?
+    Time.current >= expires_at
+  end
+
+  def signed
+    self.class.sign({
+      email_address: email_address,
+      code_digest: @code_digest,
+      purpose: purpose,
+      expires_at: expires_at.to_f,
+      join_code: join_code,
+      join_code_id: join_code_id
+    })
+  end
+
+  private
+    def digest(code)
+      Digest::SHA256.hexdigest(code.to_s.strip.upcase)
+    end
+end
