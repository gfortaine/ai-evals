@@ -0,0 +1,140 @@
+class Sessions::CodesController < ApplicationController
+  include EmailCodeAuthentication
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_email_code
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if @email_code.valid_code?(params[:code])
+      clear_pending_email_code
+      complete_email_code_authentication
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def set_email_code
+      if @email_code = pending_email_code
+        @email_code_entry_path = email_code_entry_path
+        redirect_for_expired_email_code if @email_code.expired?
+      else
+        redirect_for_missing_email_code
+      end
+    end
+
+    def redirect_for_expired_email_code
+      clear_pending_email_code
+      redirect_to @email_code_entry_path, alert: "That code has expired. Enter your email to get a new one."
+    end
+
+    def redirect_for_missing_email_code
+      redirect_to new_session_path(script_name: nil), alert: "Enter your email to get a code."
+    end
+
+    def complete_email_code_authentication
+      case @email_code.purpose
+      when "sign_in"
+        complete_sign_in
+      when "signup"
+        complete_signup
+      when "join"
+        complete_join
+      end
+    end
+
+    def complete_sign_in
+      if identity = Identity.find_by(email_address: @email_code.email_address)
+        authenticate identity
+        respond_after_email_code_authentication
+      else
+        redirect_to new_session_path(script_name: nil), alert: "That email doesn't have a Fizzy account yet. Sign up to create one."
+      end
+    end
+
+    def complete_signup
+      signup = Signup.new(email_address: @email_code.email_address)
+      signup.create_identity
+      authenticate signup.identity
+      respond_after_email_code_authentication redirect_url: new_signup_completion_url(script_name: nil)
+    end
+
+    def complete_join
+      if join_code = email_code_join_code
+        identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+        join_code.redeem_if { |account| identity.join(account) }
+
+        if user = User.active.find_by(account: join_code.account, identity: identity)
+          authenticate identity
+          respond_after_email_code_authentication redirect_url: joined_url(join_code, user)
+        else
+          redirect_to join_path(code: join_code.code, script_name: join_code.account.slug), alert: "We couldn't join that account."
+        end
+      end
+    end
+
+    def email_code_join_code
+      join_code = Account::JoinCode.find_by(id: @email_code.join_code_id, code: @email_code.join_code)
+
+      if join_code&.active?
+        join_code
+      else
+        redirect_to new_session_path(script_name: nil), alert: "That join code is no longer available."
+        nil
+      end
+    end
+
+    def joined_url(join_code, user)
+      if user.setup?
+        landing_url(script_name: join_code.account.slug)
+      else
+        new_users_verification_url(script_name: join_code.account.slug)
+      end
+    end
+
+    def authenticate(identity)
+      terminate_session if Current.session
+      start_new_session_for identity
+    end
+
+    def respond_after_email_code_authentication(redirect_url: after_authentication_url)
+      respond_to do |format|
+        format.html { redirect_to redirect_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def invalid_code
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = "That code didn't work. Try again."
+          render :new, status: :unprocessable_entity
+        end
+
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unprocessable_entity }
+      end
+    end
+
+    def email_code_entry_path
+      case @email_code.purpose
+      when "signup"
+        new_signup_path(script_name: nil)
+      when "join"
+        if join_code = Account::JoinCode.find_by(id: @email_code.join_code_id, code: @email_code.join_code)
+          join_path(code: join_code.code, script_name: join_code.account.slug)
+        else
+          new_session_path(script_name: nil)
+        end
+      else
+        new_session_path(script_name: nil)
+      end
+    end
+end
