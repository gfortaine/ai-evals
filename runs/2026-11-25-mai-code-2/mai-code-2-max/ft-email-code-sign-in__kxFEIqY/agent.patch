+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,27 @@
+module EmailCodeAuthentication
+  private
+    def send_email_code(email_address:, purpose:, join_code: nil, join_code_id: nil)
+      email_code = Identity::EmailCode.issue(
+        email_address: email_address,
+        purpose: purpose,
+        join_code: join_code,
+        join_code_id: join_code_id
+      )
+
+      IdentityMailer.email_code(
+        email_address: email_code.email_address,
+        code: email_code.code
+      ).deliver_later
+
+      session[:email_code_authentication] = email_code.signed
+    end
+
+    def pending_email_code
+      @pending_email_code ||= Identity::EmailCode.from_signed(session[:email_code_authentication])
+    end
+
+    def clear_pending_email_code
+      session.delete(:email_code_authentication)
+      @pending_email_code = nil
+    end
+end
