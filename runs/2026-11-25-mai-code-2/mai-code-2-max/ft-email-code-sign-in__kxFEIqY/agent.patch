+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <p>Enter the six-character code we sent to <strong><%= @email_code.email_address %></strong>.</p>
+
+  <%= form_with url: session_code_path, class: "flex flex-column gap", data: { controller: "form" } do |form| %>
+    <%= form.text_field :code,
+          class: "input txt-large",
+          required: true,
+          autofocus: true,
+          autocomplete: "one-time-code",
+          autocapitalize: "characters",
+          inputmode: "text",
+          maxlength: Identity::EmailCode::CODE_LENGTH,
+          minlength: Identity::EmailCode::CODE_LENGTH,
+          pattern: "[A-Za-z0-9]{#{Identity::EmailCode::CODE_LENGTH}}",
+          placeholder: "Six-character code" %>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small"><%= link_to "Use a different email address", @email_code_entry_path, class: "txt-link" %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
