diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
new file mode 100644
index 0000000..2b498b7
--- /dev/null
+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class MailerLocalizationTest < ActionMailer::TestCase
+  setup do
+    @identity = identities(:david)
+    @identity.update!(locale: :ja)
+  end
+
+  test "magic link email uses the identity locale" do
+    magic_link = @identity.magic_links.create!
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Fizzyの確認コード：#{magic_link.code}", email.subject
+    assert_match "Fizzy確認コード", mail_body(email)
+    refute_match "Fizzy verification code", mail_body(email)
+  end
+
+  test "export and import emails use the identity locale" do
+    export = Account::Export.create!(account: Current.account, user: users(:david))
+    completed_export = ExportMailer.completed(export)
+    completed_import = ImportMailer.completed(@identity, accounts(:"37s"))
+    failed_import = Account::Import.create!(account: Current.account, identity: @identity, status: :failed)
+    import_failure = ImportMailer.failed(failed_import)
+
+    assert_equal "Fizzyデータのエクスポートをダウンロードできます", completed_export.subject
+    assert_match "ダウンロードできる", mail_body(completed_export)
+    assert_equal "Fizzyアカウントのインポートが完了しました", completed_import.subject
+    assert_equal "Fizzyアカウントのインポートに失敗しました", import_failure.subject
+  end
+
+  test "email address confirmation uses the user locale" do
+    email = UserMailer.email_change_confirmation(
+      email_address: "new@example.com",
+      token: "token",
+      user: users(:david)
+    )
+
+    assert_equal "新しいメールアドレスの確認", email.subject
+    assert_match "メールアドレス変更の確認", mail_body(email)
+  end
+
+  test "account cancellation email uses the initiating user's locale" do
+  account = accounts(:"37s")
+  account.cancel(initiated_by: users(:david))
+
+  email = AccountMailer.cancellation(account.cancellation)
+
+  assert_equal "Fizzyアカウントを解約しました", email.subject
+  assert_match "今後の手順", mail_body(email)
+end
+
+  test "notification bundle email uses the recipient locale and localized dates" do
+  user = users(:david)
+  user.notifications.destroy_all
+  create_notification(user)
+  bundle = Notification::Bundle.create!(user:, starts_at: Time.zone.parse("2026-01-02 15:04"), ends_at: 1.day.from_now)
+
+  email = Notification::BundleMailer.notification(bundle)
+
+  assert_equal "Fizzy：新着通知", email.subject
+  body = mail_body(email)
+  assert_match "1月2日（金曜日）15時04分からの通知", body
+  assert_match "新しい通知1件", body
+end
+
+  private
+    def create_notification(user, source: events(:logo_published))
+      Notification.create!(user:, creator: user, source:, created_at: 30.minutes.ago)
+    end
+
+    def mail_body(email)
+      [ email.html_part&.body&.decoded, email.text_part&.body&.decoded ].compact.join("\n")
+    end
+end
