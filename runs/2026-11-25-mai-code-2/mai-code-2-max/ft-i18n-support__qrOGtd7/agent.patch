diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..9063888
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,120 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "a supported locale switch persists in the browser session" do
+    untenanted { get new_session_path(locale: :ja) }
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_select "h1", "Fizzyにサインイン"
+
+    untenanted { get new_session_path }
+    assert_select "html[lang=ja]"
+
+    untenanted { get new_session_path(locale: :xx) }
+    assert_select "html[lang=ja]"
+  end
+
+  test "an unsupported locale leaves the default English rendering intact" do
+    untenanted { get new_session_path(locale: :xx) }
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_select "h1", "Get into Fizzy"
+  end
+
+  test "locale selection applies before authentication redirects" do
+    get cards_path(locale: :ja)
+
+    assert_redirected_to new_session_path(script_name: nil)
+    follow_redirect!
+
+    assert_select "html[lang=ja]"
+  end
+
+  test "an authenticated locale choice is remembered by the identity" do
+    identity = identities(:kevin)
+    sign_in_as identity
+
+    get cards_path(locale: :ja)
+
+    assert_response :success
+    assert_equal "ja", identity.reload.locale
+    assert_select "html[lang=ja]"
+
+    get cards_path
+    assert_select "html[lang=ja]"
+  end
+
+  test "Japanese renders across authenticated screens without missing translations" do
+    sign_in_as :kevin
+
+    paths = [
+      root_path(locale: :ja),
+      board_path(boards(:writebook)),
+      card_path(cards(:logo)),
+      cards_path,
+      notifications_path,
+      account_settings_path,
+      user_path(users(:kevin)),
+      edit_user_path(users(:kevin)),
+      board_webhooks_path(boards(:writebook)),
+      my_passkeys_path,
+      notifications_settings_path
+    ]
+
+    paths.each do |path|
+      get path
+      assert_response :success, "Expected #{path} to render"
+      assert_select "html[lang=ja]"
+      refute_match %r{Translation missing|translation missing}, response.body, "Missing translation while rendering #{path}"
+    end
+
+    get card_path(cards(:logo))
+    refute_match %r{<strong>(?:Moved|assigned|Reopened)</strong>}, response.body
+  end
+
+  test "a locale selected before authentication is saved to the signing-in identity" do
+  identity = identities(:kevin)
+
+  untenanted do
+    get new_session_path(locale: :ja)
+    post session_path, params: { email_address: identity.email_address }
+    assert_redirected_to session_magic_link_path
+  end
+
+  assert_equal "ja", identity.reload.locale
+end
+
+  test "Japanese renders on public board pages without authentication" do
+  board = boards(:writebook)
+  board.publish
+
+  get published_board_path(board, locale: :ja)
+
+  assert_response :success
+  assert_select "html[lang=ja]"
+  refute_match %r{No cards here|Maximize column|Translation missing}, response.body
+end
+
+  test "a clean browser restores the locale after signing in" do
+    identity = identities(:kevin)
+    identity.update!(locale: :ja)
+
+    clean_session = open_session
+    clean_session.default_url_options[:script_name] = ""
+    clean_session.post session_path, params: { email_address: identity.email_address }
+    magic_link = identity.magic_links.order(:id).last
+    clean_session.post session_magic_link_path, params: { code: magic_link.code }
+
+    assert clean_session.response.redirect?
+
+    5.times do
+      break unless clean_session.response.redirect?
+      clean_session.follow_redirect!
+    end
+
+    assert clean_session.response.successful?, "status=#{clean_session.response.status} location=#{clean_session.response.location.inspect}"
+    assert_match %r{<html lang="ja">}, clean_session.response.body
+  end
+end
