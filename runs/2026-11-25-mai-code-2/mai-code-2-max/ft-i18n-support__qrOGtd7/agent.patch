diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..bcb5991
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,47 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_request_locale
+    before_action :apply_identity_locale
+  end
+
+  private
+    def with_request_locale(&block)
+      I18n.with_locale(locale_from_request, &block)
+    end
+
+    def locale_from_request
+      if requested_locale = available_locale(params[:locale])
+        session[:locale] = requested_locale
+        requested_locale
+      elsif locale = available_locale(session[:locale])
+        locale
+      else
+        I18n.default_locale
+      end
+    end
+
+    def apply_identity_locale
+      if identity = Current.identity
+        remember_locale_for identity
+      end
+    end
+
+    def remember_locale_for(identity)
+      if locale = available_locale(session[:locale])
+        identity.update_column(:locale, locale) unless identity.locale == locale
+      elsif locale = available_locale(identity.locale)
+        session[:locale] = locale
+      else
+        locale = I18n.default_locale.to_s
+      end
+
+      I18n.locale = locale
+    end
+
+    def available_locale(locale)
+      locale = locale.to_s
+      locale if I18n.available_locales.map(&:to_s).include?(locale)
+    end
+end
