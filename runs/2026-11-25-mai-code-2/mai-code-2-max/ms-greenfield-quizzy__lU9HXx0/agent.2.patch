diff --git a/test/integration/moderator_quiz_transfer_test.rb b/test/integration/moderator_quiz_transfer_test.rb
new file mode 100644
index 0000000..c581514
--- /dev/null
+++ b/test/integration/moderator_quiz_transfer_test.rb
@@ -0,0 +1,141 @@
+require "test_helper"
+
+class ModeratorQuizTransferTest < ActionDispatch::IntegrationTest
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "quizzy"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "conference"
+    @headers = {
+      "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("quizzy", "conference")
+    }
+  end
+
+  test "moderators can open the labelled import page from the quiz list" do
+    get moderator_root_path, headers: @headers
+    assert_response :success
+    assert_select "button", text: "Import quiz"
+
+    get moderator_new_quiz_import_path, headers: @headers
+    assert_response :success
+    assert_select "label[for='quiz_json']", text: "Quiz JSON"
+    assert_select "textarea[name='quiz_json']"
+    assert_select "input[type='submit'][value='Import']"
+  end
+
+  test "export writes only the quiz contents in stored order" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+    second = create_question(quiz, "Second question", 2)
+    first = create_question(quiz, "First question", 1)
+    second.options.create!(text: "Third option", correct: true, position: 3)
+    first.options.build(text: "Earlier option", correct: false, position: 0).save!
+
+    get export_moderator_quiz_path(quiz), headers: @headers
+    assert_response :success
+    assert_select "pre", count: 1
+
+    exported = nil
+    assert_select "pre" do |elements|
+      exported = JSON.parse(elements.first.text)
+    end
+
+    assert_equal [ "title", "questions" ], exported.keys
+    assert_equal "Frontend Fest 2026", exported["title"]
+    assert_equal [ "First question", "Second question" ], exported["questions"].pluck("text")
+    assert_equal [ "text", "active", "options" ], exported["questions"].first.keys
+    assert_equal [ "Earlier option", "Right", "Wrong" ], exported["questions"].first["options"].pluck("text")
+    assert_equal [ "text", "correct" ], exported["questions"].first["options"].first.keys
+    assert_equal [ false, true, false ], exported["questions"].first["options"].pluck("correct")
+  end
+
+  test "import creates a new quiz and applies optional defaults" do
+    existing = Quiz.create!(title: "Repeated title")
+    payload = {
+      title: "Repeated title",
+      questions: [
+        {
+          text: "First imported",
+          options: [
+            { text: "No" },
+            { text: "Yes", correct: true }
+          ]
+        },
+        {
+          text: "Second imported",
+          active: false,
+          options: [
+            { text: "Correct", correct: true },
+            { text: "Incorrect", correct: false }
+          ]
+        }
+      ]
+    }
+
+    assert_difference("Quiz.count", 1) do
+      assert_difference("Question.count", 2) do
+        assert_difference("Option.count", 4) do
+          post moderator_quiz_import_path, params: { quiz_json: JSON.generate(payload) }, headers: @headers
+        end
+      end
+    end
+
+    imported = Quiz.order(:id).last
+    assert_redirected_to moderator_quiz_path(imported)
+    assert_equal 2, Quiz.where(title: "Repeated title").count
+    assert_not_equal existing.id, imported.id
+
+    assert_equal [ "First imported", "Second imported" ], imported.questions.pluck(:body)
+    assert_equal [ true, false ], imported.questions.pluck(:active)
+    assert_equal [ "No", "Yes" ], imported.questions.first.options.pluck(:text)
+    assert_equal [ false, true ], imported.questions.first.options.pluck(:correct)
+  end
+
+  test "invalid JSON and a broken later question leave all transfer data unchanged" do
+assert_no_difference([ "Quiz.count", "Question.count", "Option.count" ]) do
+  post moderator_quiz_import_path, params: { quiz_json: "null" }, headers: @headers
+end
+assert_response :unprocessable_entity
+assert_select "[role='alert']", text: /must contain an object/
+
+    assert_no_difference([ "Quiz.count", "Question.count", "Option.count" ]) do
+      post moderator_quiz_import_path, params: { quiz_json: "not json" }, headers: @headers
+    end
+    assert_response :unprocessable_entity
+    assert_select "[role='alert']", text: /Import error/
+    assert_select "textarea", text: "not json"
+
+    payload = {
+      title: "Never partially saved",
+      questions: [
+        {
+          text: "Valid first question",
+          options: [
+            { text: "Wrong", correct: false },
+            { text: "Right", correct: true }
+          ]
+        },
+        {
+          text: "Invalid second question",
+          options: [
+            { text: "One" },
+            { text: "Two" }
+          ]
+        }
+      ]
+    }
+
+    assert_no_difference([ "Quiz.count", "Question.count", "Option.count" ]) do
+      post moderator_quiz_import_path, params: { quiz_json: JSON.generate(payload) }, headers: @headers
+    end
+    assert_response :unprocessable_entity
+    assert_select "[role='alert']", text: /Mark at least one option as correct/
+  end
+
+  private
+
+  def create_question(quiz, body, position)
+    question = quiz.questions.build(body: body, active: true, position: position)
+    question.options.build(text: "Right", correct: true, position: 1)
+    question.options.build(text: "Wrong", correct: false, position: 2)
+    question.save!
+    question
+  end
+end
