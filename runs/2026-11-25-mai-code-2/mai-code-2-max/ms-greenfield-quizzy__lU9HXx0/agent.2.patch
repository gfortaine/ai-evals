diff --git a/app/services/quiz_importer.rb b/app/services/quiz_importer.rb
new file mode 100644
index 0000000..19083e6
--- /dev/null
+++ b/app/services/quiz_importer.rb
@@ -0,0 +1,144 @@
+require "json"
+
+class QuizImporter
+  attr_reader :errors, :quiz
+
+  def initialize(json)
+    @json = json
+    @errors = []
+  end
+
+  def import
+    payload = parse_payload
+    return false if errors.any?
+
+    attributes = normalize_payload(payload)
+    return false if errors.any?
+
+    Quiz.transaction do
+      @quiz = Quiz.create!(title: attributes[:title])
+
+      attributes[:questions].each_with_index do |question_attributes, question_index|
+        question = @quiz.questions.build(
+          body: question_attributes[:text],
+          active: question_attributes[:active],
+          position: question_index + 1
+        )
+
+        question_attributes[:options].each_with_index do |option_attributes, option_index|
+          question.options.build(
+            text: option_attributes[:text],
+            correct: option_attributes[:correct],
+            position: option_index + 1
+          )
+        end
+
+        question.save!
+      end
+    end
+
+    true
+  rescue ActiveRecord::RecordInvalid => error
+    @quiz = nil
+    add_record_errors(error.record)
+    false
+  end
+
+  private
+
+  def parse_payload
+    if @json.blank?
+      errors << "Quiz JSON is required"
+      return
+    end
+
+    JSON.parse(@json)
+  rescue JSON::ParserError
+    errors << "Quiz JSON is invalid"
+    nil
+  end
+
+  def normalize_payload(payload)
+    unless payload.is_a?(Hash)
+      errors << "Quiz JSON must contain an object"
+      return
+    end
+
+    {
+      title: string_value(payload, "title", "Quiz title"),
+      questions: question_values(payload["questions"])
+    }
+  end
+
+  def question_values(value)
+    unless value.is_a?(Array)
+      errors << "Quiz questions must be an array"
+      return []
+    end
+
+    value.filter_map.with_index do |question, index|
+      question_value(question, index + 1)
+    end
+  end
+
+  def question_value(question, number)
+    unless question.is_a?(Hash)
+      errors << "Question #{number} must be an object"
+      return
+    end
+
+    {
+      text: string_value(question, "text", "Question #{number} text"),
+      active: boolean_value(question, "active", true, "Question #{number} active"),
+      options: option_values(question["options"], number)
+    }
+  end
+
+  def option_values(value, question_number)
+    unless value.is_a?(Array)
+      errors << "Question #{question_number} options must be an array"
+      return []
+    end
+
+    value.filter_map.with_index do |option, index|
+      option_value(option, question_number, index + 1)
+    end
+  end
+
+  def option_value(option, question_number, option_number)
+    unless option.is_a?(Hash)
+      errors << "Question #{question_number} option #{option_number} must be an object"
+      return
+    end
+
+    {
+      text: string_value(option, "text", "Question #{question_number} option #{option_number} text"),
+      correct: boolean_value(option, "correct", false, "Question #{question_number} option #{option_number} correct")
+    }
+  end
+
+  def string_value(object, key, label)
+    value = object[key]
+
+    if !object.key?(key)
+      errors << "#{label} is required"
+    elsif !value.is_a?(String)
+      errors << "#{label} must be text"
+    end
+
+    value
+  end
+
+  def boolean_value(object, key, default, label)
+    return default unless object.key?(key)
+
+    value = object[key]
+    errors << "#{label} must be true or false" unless value == true || value == false
+    value
+  end
+
+  def add_record_errors(record)
+    prefix = record.is_a?(Question) ? "Question #{record.position}: " : ""
+    record.errors.full_messages.each { |message| errors << "#{prefix}#{message}" }
+  end
+end
