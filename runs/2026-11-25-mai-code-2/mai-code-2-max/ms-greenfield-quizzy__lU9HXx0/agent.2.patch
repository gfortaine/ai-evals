+<% content_for(:title, "Import quiz · Quizzy") %>
+
+<main class="admin-main">
+  <div class="breadcrumbs"><%= link_to "← All quizzes", moderator_root_path %></div>
+  <div class="page-head"><h1>Import quiz</h1></div>
+
+  <div class="card">
+    <%= form_with url: moderator_quiz_import_path, method: :post, class: "quiz-import-form" do %>
+      <% if @import_errors.any? %>
+        <div class="errors" role="alert">
+          <h2>Import error</h2>
+          <ul>
+            <% @import_errors.each do |message| %>
+              <li><%= message %></li>
+            <% end %>
+          </ul>
+        </div>
+      <% end %>
+
+      <div class="field">
+        <%= label_tag :quiz_json, "Quiz JSON" %>
+        <%= text_area_tag :quiz_json,
+              @quiz_json,
+              class: "input input--code quiz-json-input",
+              rows: 18,
+              required: true,
+              spellcheck: false,
+              autofocus: true %>
+      </div>
+
+      <div class="buttons">
+        <%= submit_tag "Import", class: "btn btn--pink" %>
+        <%= link_to "Cancel", moderator_root_path, class: "btn btn--ghost" %>
+      </div>
+    <% end %>
+  </div>
+</main>
