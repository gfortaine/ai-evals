+++ b/app/controllers/moderator/quiz_imports_controller.rb
@@ -0,0 +1,20 @@
+module Moderator
+  class QuizImportsController < BaseController
+    def new
+      @quiz_json = ""
+      @import_errors = []
+    end
+
+    def create
+      @quiz_json = params[:quiz_json].to_s
+      importer = QuizImporter.new(@quiz_json)
+
+      if importer.import
+        redirect_to moderator_quiz_path(importer.quiz), notice: "Quiz imported"
+      else
+        @import_errors = importer.errors
+        render :new, status: :unprocessable_entity
+      end
+    end
+  end
+end
