diff --git a/app/views/play/_screen.html.erb b/app/views/play/_screen.html.erb
new file mode 100644
index 0000000..ddf99d6
--- /dev/null
+++ b/app/views/play/_screen.html.erb
@@ -0,0 +1,95 @@
+<main class="play">
+  <header class="play__top">
+    <span class="logo play__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+    <span><%= @player ? (@game.waiting? ? @player.name : "Hi, #{@player.name}!") : "Join the quiz" %></span>
+  </header>
+
+  <% if @game.ended? %>
+    <div class="play__body">
+      <section class="card result-card">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h1>The quiz is over</h1>
+      </section>
+    </div>
+  <% elsif @player.nil? %>
+    <div class="play__body">
+      <section class="card join-card">
+        <h1 class="play-title"><%= @game.title %></h1>
+        <p class="play-lead">Choose your name, then join the room.</p>
+
+        <% if @join_errors.present? %>
+          <div class="errors" role="alert">
+            <ul>
+              <% @join_errors.each do |error| %>
+                <li><%= error %></li>
+              <% end %>
+            </ul>
+          </div>
+        <% end %>
+
+        <%= form_with url: join_play_game_path(code: @game.code), method: :post, class: "join-form" do |form| %>
+          <%= form.label :player_name, "Your name" %>
+          <%= text_field_tag "player[name]", @join_name,
+                id: "player_name",
+                class: "input",
+                placeholder: "Your name",
+                autocomplete: "name",
+                maxlength: 60,
+                required: true,
+                autofocus: true %>
+          <%= button_tag "Join", type: "submit", class: "btn btn--pink" %>
+        <% end %>
+      </section>
+    </div>
+  <% elsif @game.waiting? %>
+    <div class="play__body">
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h1>Hi, <%= @player.name %>!</h1>
+        <p class="play-lead">Waiting for the quiz to start.</p>
+      </div>
+    </div>
+  <% elsif @question %>
+    <div class="play__body play__body--top">
+      <div class="play-question__num">Question <%= @game.current_question_position %> of <%= @game.question_count %></div>
+      <h1 class="play-question__body"><%= @question.body %></h1>
+
+      <% if @game.question_open? %>
+        <div class="play-options" aria-label="Options">
+          <% @question.game_options.each_with_index do |option, index| %>
+            <% picked = @answer&.game_option_id == option.id %>
+            <%= form_with url: answer_play_game_path(code: @game.code), method: :post do %>
+              <%= hidden_field_tag :game_question_id, @question.id %>
+              <%= hidden_field_tag :game_option_id, option.id %>
+              <button type="submit" class="play-option <%= "is-picked" if picked %>">
+                <span class="play-option__letter" aria-hidden="true"><%= (65 + index).chr %></span>
+                <span class="play-option__title"><%= option.text %></span>
+                <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+              </button>
+            <% end %>
+          <% end %>
+        </div>
+      <% else %>
+        <div class="play-options is-locked is-revealed" aria-label="Options and correct answers">
+          <% @question.game_options.each_with_index do |option, index| %>
+            <% picked = @answer&.game_option_id == option.id %>
+            <div class="play-option <%= "is-picked" if picked %> <%= "is-correct" if option.correct? %>">
+              <span class="play-option__letter" aria-hidden="true"><%= (65 + index).chr %></span>
+              <span class="play-option__title"><%= option.text %></span>
+              <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+              <% if option.correct? %><span class="play-option__mark">Correct</span><% end %>
+            </div>
+          <% end %>
+        </div>
+
+        <% if @answer.nil? %>
+          <div class="play-status play-status--neutral">No answer</div>
+        <% elsif @answer.game_option.correct? %>
+          <div class="play-status play-status--right">Correct!</div>
+        <% else %>
+          <div class="play-status play-status--wrong">Wrong!</div>
+        <% end %>
+      <% end %>
+    </div>
+  <% end %>
+</main>
