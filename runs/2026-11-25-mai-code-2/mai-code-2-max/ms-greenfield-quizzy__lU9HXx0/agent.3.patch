diff --git a/test/integration/live_game_flow_test.rb b/test/integration/live_game_flow_test.rb
new file mode 100644
index 0000000..0dc92bd
--- /dev/null
+++ b/test/integration/live_game_flow_test.rb
@@ -0,0 +1,184 @@
+require "test_helper"
+
+class LiveGameFlowTest < ActionDispatch::IntegrationTest
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "quizzy"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "conference"
+    @headers = {
+      "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("quizzy", "conference")
+    }
+    @quiz = Quiz.create!(title: "Live conference quiz")
+    create_question("First active question", active: true, position: 1)
+    create_question("Inactive question", active: false, position: 2)
+    create_question("Final active question", active: true, position: 3)
+  end
+
+  test "moderator starts a game and runs every active question live" do
+    get moderator_quiz_path(@quiz), headers: @headers
+    assert_response :success
+    assert_select "button", text: "Start a game"
+
+    assert_difference("Game.count", 1) do
+      assert_difference("GameQuestion.count", 2) do
+        post moderator_quiz_games_path(@quiz), headers: @headers
+      end
+    end
+    assert_response :redirect
+
+    game = Game.order(:id).last
+    assert_equal 2, game.game_questions.count
+    assert_equal 4, game.game_questions.sum { |question| question.game_options.count }
+
+    follow_redirect!(headers: @headers)
+    assert_response :success
+    assert_select "h1", text: @quiz.title
+    join_url = "http://www.example.com#{play_game_path(code: game.code)}"
+    assert_select ".lobby__url", text: join_url
+    assert_select ".qr img[src^='data:image/svg+xml;base64,'][data-join-url='#{join_url}'][alt='QR code for #{join_url}']"
+    assert_select "#players-counter", text: /Players:\s*0/
+    assert_select "button", text: "Start"
+
+    alice_session = open_session
+    alice_session.get play_game_path(code: game.code)
+    assert_equal 200, alice_session.response.status
+    assert_select_session alice_session, "label[for='player_name']", text: "Your name"
+    assert_select_session alice_session, "input[placeholder='Your name']"
+    assert_select_session alice_session, "button", text: "Join"
+
+    alice_session.post join_play_game_path(code: game.code), params: { player: { name: "Alice" } }
+    alice_session.follow_redirect!
+    assert_select_session alice_session, "h1", text: "Hi, Alice!"
+    assert_select_session alice_session, "p", text: "Waiting for the quiz to start."
+
+    alice_session.get play_game_path(code: game.code)
+    assert_select_session alice_session, "h1", text: "Hi, Alice!"
+    assert_select_session alice_session, "form.join-form", count: 0
+
+    get moderator_quiz_game_path(@quiz, game), headers: @headers
+    assert_select "#players-counter", text: /Players:\s*1/
+
+    post start_moderator_quiz_game_path(@quiz, game), headers: @headers
+    follow_redirect!(headers: @headers)
+    assert_select ".stage-question__num", text: "Question 1 of 2"
+    assert_select "h1.stage-question__body", text: "First active question"
+    assert_select "ol.stage-options li", count: 2
+    assert_select "#answers-counter", text: "Answers: 0 / 1"
+    assert_select "button", text: "Finish"
+
+    alice_session.get play_game_path(code: game.code)
+    assert_select_session alice_session, "h1", text: "First active question"
+    assert_select_session alice_session, "button.play-option", count: 2
+    assert_not_includes alice_session.response.body, "is-correct"
+    assert_not_includes alice_session.response.body, "Correct"
+
+    bob_session = open_session
+    bob_session.get play_game_path(code: game.code)
+    bob_session.post join_play_game_path(code: game.code), params: { player: { name: "Bob" } }
+    bob_session.follow_redirect!
+
+    question = game.reload.current_question
+    wrong = question.game_options.find_by!(correct: false)
+    right = question.game_options.find_by!(correct: true)
+
+    alice_session.post answer_play_game_path(code: game.code), params: {
+      game_question_id: question.id,
+      game_option_id: wrong.id
+    }
+    alice_session.follow_redirect!
+    assert_select_session alice_session, ".play-option.is-picked", text: /Wrong option.*Your answer/m
+
+    alice_session.post answer_play_game_path(code: game.code), params: {
+      game_question_id: question.id,
+      game_option_id: right.id
+    }
+    alice_session.follow_redirect!
+    assert_select_session alice_session, ".play-option.is-picked", text: /Right option.*Your answer/m
+    assert_equal 1, game.players.find_by!(name: "Alice").answers.where(game_question: question).count
+
+    get moderator_quiz_game_path(@quiz, game), headers: @headers
+    assert_select "#answers-counter", text: "Answers: 1 / 2"
+
+    post finish_moderator_quiz_game_path(@quiz, game), headers: @headers
+    follow_redirect!(headers: @headers)
+    assert_select ".stage-options--results li", count: 2
+    assert_select ".stage-option.is-correct .stage-option__mark", text: "Correct"
+    assert_select ".stage-option", text: /1/
+    assert_select "button", text: "Next"
+
+    alice_session.get play_game_path(code: game.code)
+    assert_select_session alice_session, ".play-status", text: "Correct!"
+    assert_select_session alice_session, ".play-option.is-correct", count: 1
+    assert_select_session alice_session, "button.play-option", count: 0
+
+    bob_session.get play_game_path(code: game.code)
+    assert_select_session bob_session, ".play-status", text: "No answer"
+
+    assert_no_difference("Answer.count") do
+      alice_session.post answer_play_game_path(code: game.code), params: {
+        game_question_id: question.id,
+        game_option_id: wrong.id
+      }
+    end
+    assert_equal right.id, game.players.find_by!(name: "Alice").answers.first.reload.game_option_id
+
+    post advance_moderator_quiz_game_path(@quiz, game), headers: @headers
+    follow_redirect!(headers: @headers)
+    assert_select ".stage-question__num", text: "Question 2 of 2"
+    assert_select "h1.stage-question__body", text: "Final active question"
+
+    post finish_moderator_quiz_game_path(@quiz, game), headers: @headers
+    follow_redirect!(headers: @headers)
+    assert_select "button", text: "End quiz"
+    post advance_moderator_quiz_game_path(@quiz, game), headers: @headers
+    follow_redirect!(headers: @headers)
+    assert_select "h1", text: "The quiz is over"
+
+    alice_session.get play_game_path(code: game.code)
+    assert_select_session alice_session, "h1", text: "The quiz is over"
+
+    newcomer = open_session
+    newcomer.get play_game_path(code: game.code)
+    assert_select_session newcomer, "h1", text: "The quiz is over"
+    assert_select_session newcomer, "form.join-form", count: 0
+    assert_select_session newcomer, "button", text: "Join", count: 0
+    assert_no_difference("Player.count") do
+      newcomer.post join_play_game_path(code: game.code), params: { player: { name: "Too late" } }
+    end
+  end
+
+  test "each start creates an isolated game" do
+    post moderator_quiz_games_path(@quiz), headers: @headers
+    first = Game.order(:id).last
+    post moderator_quiz_games_path(@quiz), headers: @headers
+    second = Game.order(:id).last
+
+    assert_not_equal first.id, second.id
+    assert_not_equal first.code, second.code
+    assert_equal 2, first.game_questions.count
+    assert_equal 2, second.game_questions.count
+  end
+
+  private
+
+  def create_question(body, active:, position:)
+    question = @quiz.questions.build(body: body, active: active, position: position)
+    question.options.build(text: "Right option", correct: true, position: 1)
+    question.options.build(text: "Wrong option", correct: false, position: 2)
+    question.save!
+    question
+  end
+
+  def assert_select_session(session, selector, text: nil, count: nil, **_options)
+    response = session.send(:response)
+    assert_equal 200, response.status
+    nodes = Nokogiri::HTML(response.body).css(selector)
+    assert_equal count, nodes.length if count
+    assert_predicate nodes, :any?, "Expected #{selector.inspect} in response" unless count&.zero?
+
+    if text && count != 0
+      normalized = nodes.map { |node| node.text.gsub(/\s+/, " ").strip }
+      matches = text.is_a?(Regexp) ? normalized.grep(text) : normalized.select { |value| value == text.to_s }
+      assert_predicate matches, :any?, "Expected #{selector.inspect} to contain #{text.inspect}"
+    end
+  end
+end
