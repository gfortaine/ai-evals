+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Conference quiz")
+  end
+
+  test "a game snapshots only active questions and keeps its own answers" do
+    active = create_question(@quiz, "Played question", active: true, position: 1)
+    create_question(@quiz, "Skipped question", active: false, position: 2)
+    game = Game.create_for!(@quiz)
+
+    active.update!(body: "Edited later")
+
+    assert_equal [ "Played question" ], game.game_questions.pluck(:body)
+    assert_equal [ "Right", "Wrong" ], game.game_questions.first.game_options.pluck(:text)
+    assert_match(/\A[2-9A-Z]{5}\z/, game.code)
+
+    other_game = Game.create_for!(@quiz)
+    assert_not_equal game.code, other_game.code
+    assert_equal "Edited later", other_game.game_questions.first.body
+  end
+
+  test "a player can replace an answer only while the question is open" do
+    create_question(@quiz, "First", active: true, position: 1)
+    game = Game.create_for!(@quiz)
+    game.start!
+    player = game.join!(browser_token: "browser-one", name: "Alice")
+    question = game.current_question
+    wrong, right = question.game_options.order(:position).to_a
+
+    first_answer = game.submit_answer!(
+      player: player,
+      game_question_id: question.id,
+      game_option_id: right.id
+    )
+    second_answer = game.submit_answer!(
+      player: player,
+      game_question_id: question.id,
+      game_option_id: wrong.id
+    )
+
+    assert_equal first_answer.id, second_answer.id
+    assert_equal wrong.id, second_answer.reload.game_option_id
+    assert_equal 1, player.answers.where(game_question: question).count
+
+    game.finish_question!
+
+    assert_raises Game::InvalidTransition do
+      game.submit_answer!(
+        player: player,
+        game_question_id: question.id,
+        game_option_id: right.id
+      )
+    end
+  end
+
+  test "advance opens the next snapshot and ends after the final question" do
+    create_question(@quiz, "First", active: true, position: 1)
+    create_question(@quiz, "Second", active: true, position: 2)
+    game = Game.create_for!(@quiz)
+
+    game.start!
+    assert_equal "First", game.current_question.body
+    game.finish_question!
+    game.advance!
+    assert_predicate game, :question_open?
+    assert_equal "Second", game.current_question.body
+    game.finish_question!
+    game.advance!
+
+    assert_predicate game, :ended?
+    assert_predicate game.finished_at, :present?
+  end
+
+  private
+
+  def create_question(quiz, body, active:, position:)
+    question = quiz.questions.build(body: body, active: active, position: position)
+    question.options.build(text: "Right", correct: true, position: 1)
+    question.options.build(text: "Wrong", correct: false, position: 2)
+    question.save!
+    question
+  end
+end
