diff --git a/app/models/game.rb b/app/models/game.rb
new file mode 100644
index 0000000..57d5bca
--- /dev/null
+++ b/app/models/game.rb
@@ -0,0 +1,148 @@
+class Game < ApplicationRecord
+  CODE_CHARACTERS = ("A".."Z").to_a.concat(("2".."9").to_a).freeze
+  STATUSES = {
+    waiting: "waiting",
+    question_open: "question_open",
+    question_closed: "question_closed",
+    ended: "ended"
+  }.freeze
+
+  class InvalidTransition < StandardError; end
+
+  belongs_to :quiz
+  has_many :game_questions, -> { order(:position, :id) }, dependent: :destroy, inverse_of: :game
+  has_many :players, dependent: :destroy, inverse_of: :game
+
+  enum :status, STATUSES, validate: true
+
+  validates :title, presence: true
+  validates :code, presence: true, uniqueness: true, format: { with: /\A[2-9A-Z]{5}\z/ }
+  validates :current_question_position, numericality: { greater_than_or_equal_to: 0 }
+
+  before_validation :generate_code, on: :create
+
+  def self.create_for!(quiz)
+    transaction do
+      game = quiz.games.create!(title: quiz.title)
+
+      quiz.questions.active.includes(:options).each_with_index do |question, question_index|
+        game_question = game.game_questions.create!(
+          body: question.body,
+          position: question_index + 1
+        )
+
+        question.options.each_with_index do |option, option_index|
+          game_question.game_options.create!(
+            text: option.text,
+            correct: option.correct?,
+            position: option_index + 1
+          )
+        end
+      end
+
+      game
+    end
+  end
+
+  def start!
+    with_lock do
+      require_status!(:waiting)
+      raise InvalidTransition, "Add an active question before starting" unless game_questions.exists?
+
+      update!(
+        status: :question_open,
+        current_question_position: 1,
+        started_at: Time.current
+      )
+    end
+  end
+
+  def finish_question!
+    with_lock do
+      require_status!(:question_open)
+      update!(status: :question_closed)
+    end
+  end
+
+  def advance!
+    with_lock do
+      require_status!(:question_closed)
+
+      if last_question?
+        update!(status: :ended, finished_at: Time.current)
+      else
+        update!(
+          status: :question_open,
+          current_question_position: current_question_position + 1
+        )
+      end
+    end
+  end
+
+  def join!(browser_token:, name:)
+    with_lock do
+      touch
+      raise InvalidTransition, "The quiz is over" if ended?
+
+      player = players.find_or_initialize_by(browser_token: browser_token)
+      player.name = name
+      player.save!
+      player
+    end
+  end
+
+  def submit_answer!(player:, game_question_id:, game_option_id:)
+    with_lock do
+      touch
+      require_status!(:question_open)
+
+      question = current_question
+      unless question && question.id == game_question_id.to_i
+        raise ActiveRecord::RecordNotFound, "Question is not open"
+      end
+
+      option = question.game_options.find(game_option_id)
+      raise ActiveRecord::RecordNotFound, "Player not found" unless player.game_id == id
+
+      answer = player.answers.find_or_initialize_by(game_question: question)
+      answer.game_option = option
+      answer.save!
+      answer
+    end
+  end
+
+  def current_question
+    return if current_question_position.zero?
+
+    game_questions.includes(:game_options).find_by(position: current_question_position)
+  end
+
+  def question_count
+    game_questions.count
+  end
+
+  def last_question?
+    current_question_position >= question_count
+  end
+
+  def answer_count
+    question = current_question
+    return 0 unless question
+
+    Answer.where(game_question_id: question.id).count
+  end
+
+  private
+
+  def generate_code
+    return if code.present?
+
+    self.code = Array.new(5) { CODE_CHARACTERS[SecureRandom.random_number(CODE_CHARACTERS.length)] }.join
+  end
+
+  def require_status!(*expected_statuses)
+    return if expected_statuses.any? { |expected| public_send("#{expected}?") }
+
+    raise InvalidTransition, "The game state has already changed"
+  end
+end
