diff --git a/app/services/game_broadcaster.rb b/app/services/game_broadcaster.rb
new file mode 100644
index 0000000..048a48b
--- /dev/null
+++ b/app/services/game_broadcaster.rb
@@ -0,0 +1,42 @@
+class GameBroadcaster
+  MODERATOR_FRAME = "moderator-game"
+  PLAYER_FRAME = "player-game"
+
+  class << self
+    def state_changed(game)
+      broadcast_frame(game, MODERATOR_FRAME, live_moderator_path(game))
+      broadcast_frame(game, PLAYER_FRAME, live_player_path(game))
+    end
+
+    def counters_changed(game)
+      player_count = game.players.count
+
+      Turbo::StreamsChannel.broadcast_update_to(
+        game,
+        target: "players-counter",
+        html: "Players: <strong>#{player_count}</strong>".html_safe
+      )
+
+      Turbo::StreamsChannel.broadcast_update_to(
+        game,
+        target: "answers-counter",
+        html: "Answers: #{game.answer_count} / #{player_count}".html_safe
+      )
+    end
+
+    private
+
+    def broadcast_frame(game, target, source)
+      html = %(<turbo-frame id="#{target}" src="#{ERB::Util.html_escape(source)}" loading="eager"></turbo-frame>)
+      Turbo::StreamsChannel.broadcast_replace_to(game, target: target, html: html)
+    end
+
+    def live_moderator_path(game)
+      Rails.application.routes.url_helpers.live_moderator_quiz_game_path(game.quiz_id, game.id)
+    end
+
+    def live_player_path(game)
+      Rails.application.routes.url_helpers.live_play_game_path(code: game.code)
+    end
+  end
+end
