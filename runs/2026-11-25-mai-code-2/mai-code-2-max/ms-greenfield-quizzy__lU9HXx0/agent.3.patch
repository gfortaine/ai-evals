diff --git a/app/javascript/controllers/live_recovery_controller.js b/app/javascript/controllers/live_recovery_controller.js
new file mode 100644
index 0000000..ca75633
--- /dev/null
+++ b/app/javascript/controllers/live_recovery_controller.js
@@ -0,0 +1,38 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "stream" ]
+  static values = { url: String, frame: String }
+
+  connect() {
+    this.wasConnected = this.streamTarget.hasAttribute("connected")
+    this.wasDisconnected = false
+    this.observer = new MutationObserver(this.connectionChanged)
+    this.observer.observe(this.streamTarget, { attributes: true, attributeFilter: [ "connected" ] })
+  }
+
+  disconnect() {
+    this.observer?.disconnect()
+  }
+
+  connectionChanged = () => {
+    const connected = this.streamTarget.hasAttribute("connected")
+
+    if (!connected && this.wasConnected) {
+      this.wasDisconnected = true
+    } else if (connected && this.wasDisconnected) {
+      this.wasDisconnected = false
+      this.reloadFrame()
+    }
+
+    this.wasConnected = connected
+  }
+
+  reloadFrame() {
+    const frame = document.getElementById(this.frameValue)
+    if (!frame) return
+
+    frame.src = this.urlValue
+    frame.reload?.()
+  }
+}
