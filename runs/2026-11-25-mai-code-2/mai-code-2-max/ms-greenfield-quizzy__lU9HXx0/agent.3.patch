diff --git a/app/controllers/moderator/games_controller.rb b/app/controllers/moderator/games_controller.rb
new file mode 100644
index 0000000..83db6c4
--- /dev/null
+++ b/app/controllers/moderator/games_controller.rb
@@ -0,0 +1,65 @@
+module Moderator
+  class GamesController < BaseController
+    layout "live_game"
+
+    before_action :set_quiz
+    before_action :set_game, only: %i[show live start finish advance]
+    before_action :load_screen, only: %i[show live]
+
+    rescue_from Game::InvalidTransition, with: :handle_invalid_transition
+
+    def create
+      @game = Game.create_for!(@quiz)
+      redirect_to moderator_quiz_game_path(@quiz, @game), status: :see_other
+    end
+
+    def show
+    end
+
+    def live
+      render layout: false
+    end
+
+    def start
+      @game.start!
+      state_changed
+    end
+
+    def finish
+      @game.finish_question!
+      state_changed
+    end
+
+    def advance
+      @game.advance!
+      state_changed
+    end
+
+    private
+
+    def state_changed
+      GameBroadcaster.state_changed(@game)
+      redirect_to moderator_quiz_game_path(@quiz, @game), status: :see_other
+    end
+
+    def handle_invalid_transition(error)
+      redirect_to moderator_quiz_game_path(@quiz, @game), alert: error.message, status: :see_other
+    end
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_game
+      @game = @quiz.games.find(params[:id])
+    end
+
+    def load_screen
+      @join_url = "#{request.base_url}#{play_game_path(code: @game.code)}"
+      @question = @game.current_question
+      @player_count = @game.players.count
+      @answer_count = @question ? Answer.where(game_question: @question).count : 0
+      @answer_counts = @question ? Answer.where(game_question: @question).group(:game_option_id).count : {}
+    end
+  end
+end
diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
index 0000000..6a4a93a
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,85 @@
+class PlayController < ApplicationController
+  BROWSER_TOKEN_COOKIE = :quizzy_player_token
+
+  before_action :set_game
+  before_action :set_player
+
+  def show
+    load_screen
+  end
+
+  def live
+    load_screen
+    render layout: false
+  end
+
+  def join
+    if @game.ended?
+      redirect_to play_game_path(code: @game.code), status: :see_other
+      return
+    end
+
+    @player = @game.join!(
+      browser_token: browser_token,
+      name: params.dig(:player, :name)
+    )
+    GameBroadcaster.counters_changed(@game)
+    redirect_to play_game_path(code: @game.code), status: :see_other
+  rescue Game::InvalidTransition
+    redirect_to play_game_path(code: @game.code), status: :see_other
+  rescue ActiveRecord::RecordInvalid => error
+    @player = nil
+    @join_name = params.dig(:player, :name)
+    @join_errors = error.record.errors.full_messages
+    load_screen
+    render :show, status: :unprocessable_entity
+  end
+
+  def answer
+    unless @player
+      redirect_to play_game_path(code: @game.code), status: :see_other
+      return
+    end
+
+    @game.submit_answer!(
+      player: @player,
+      game_question_id: params[:game_question_id],
+      game_option_id: params[:game_option_id]
+    )
+    GameBroadcaster.counters_changed(@game)
+    redirect_to play_game_path(code: @game.code), status: :see_other
+  rescue Game::InvalidTransition
+    redirect_to play_game_path(code: @game.code), status: :see_other
+  end
+
+  private
+
+  def set_game
+    @game = Game.find_by!(code: params[:code].to_s.upcase)
+  end
+
+  def set_player
+    @player = @game.players.find_by(browser_token: browser_token)
+  end
+
+  def load_screen
+    @question = @game.current_question
+    @answer = if @player && @question
+      @player.answers.includes(:game_option).find_by(game_question: @question)
+    end
+  end
+
+  def browser_token
+    existing = cookies.encrypted[BROWSER_TOKEN_COOKIE]
+    return existing if existing.present?
+
+    token = SecureRandom.urlsafe_base64(24)
+    cookies.encrypted.permanent[BROWSER_TOKEN_COOKIE] = {
+      value: token,
+      path: "/",
+      httponly: true,
+      same_site: :lax
+    }
+    token
+  end
+end
