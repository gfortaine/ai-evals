diff --git a/app/views/moderator/games/_screen.html.erb b/app/views/moderator/games/_screen.html.erb
new file mode 100644
index 0000000..13d7a28
--- /dev/null
+++ b/app/views/moderator/games/_screen.html.erb
@@ -0,0 +1,83 @@
+<section class="cover <%= @game.waiting? ? "cover--blue" : (@game.ended? ? "cover--night" : "cover--blue cover--calm") %>">
+  <div class="screen">
+    <header class="screen__top">
+      <span class="logo screen__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+      <span><%= @game.waiting? ? "Game code: #{@game.code}" : @game.title %></span>
+    </header>
+
+    <div class="screen__body">
+      <% if @game.waiting? %>
+        <div class="lobby">
+          <div>
+            <p class="screen__kicker">Join the quiz</p>
+            <h1 class="lobby__title"><%= @game.title %></h1>
+            <p class="lobby__join">Open this link on your phone</p>
+            <div class="lobby__url"><%= @join_url %></div>
+            <div id="players-counter" class="counter-pill" aria-live="polite">
+              Players: <strong><%= @player_count %></strong>
+            </div>
+          </div>
+          <div class="qr" aria-label="QR code for the join link">
+            <%= image_tag qr_code_data_uri(@join_url), alt: "QR code for #{@join_url}", data: { join_url: @join_url } %>
+          </div>
+        </div>
+      <% elsif @game.ended? %>
+        <div class="waiting">
+          <div class="waiting__gem" aria-hidden="true">?</div>
+          <h1 class="lobby__title">The quiz is over</h1>
+        </div>
+      <% elsif @question %>
+        <div class="stage-question">
+          <div class="stage-question__num">Question <%= @game.current_question_position %> of <%= @game.question_count %></div>
+          <h1 class="stage-question__body"><%= @question.body %></h1>
+
+          <ol class="stage-options <%= "stage-options--results" if @game.question_closed? %>" aria-label="Options">
+            <% @question.game_options.each_with_index do |option, index| %>
+              <% correct = @game.question_closed? && option.correct? %>
+              <% count = @answer_counts.fetch(option.id, 0) %>
+              <% share = @player_count.positive? ? ((count.to_f / @player_count) * 100).round : 0 %>
+              <li class="stage-option <%= "is-correct" if correct %>"<% if @game.question_closed? %> style="--share: <%= share %>%"<% end %>>
+                <span class="stage-option__letter"><%= (65 + index).chr %></span>
+                <span class="stage-option__title"><%= option.text %></span>
+                <% if @game.question_closed? %>
+                  <span class="stage-option__count"><%= count %></span>
+                  <% if correct %><span class="stage-option__mark">Correct</span><% end %>
+                  <span class="stage-option__bar" aria-hidden="true"></span>
+                <% end %>
+              </li>
+            <% end %>
+          </ol>
+        </div>
+      <% end %>
+    </div>
+  </div>
+
+  <footer class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "Back to quiz", moderator_quiz_path(@quiz), data: { turbo_frame: "_top" } %>
+      <% if @game.question_open? || @game.question_closed? %>
+        <span id="answers-counter" class="answers-counter" aria-live="polite">Answers: <%= @answer_count %> / <%= @player_count %></span>
+      <% end %>
+    </div>
+
+    <div class="screen-controls__action">
+      <% if @game.waiting? %>
+        <%= button_to "Start",
+              start_moderator_quiz_game_path(@quiz, @game),
+              method: :post,
+              class: "btn btn--pink btn--lg",
+              disabled: @game.question_count.zero? %>
+      <% elsif @game.question_open? %>
+        <%= button_to "Finish",
+              finish_moderator_quiz_game_path(@quiz, @game),
+              method: :post,
+              class: "btn btn--pink btn--lg" %>
+      <% elsif @game.question_closed? %>
+        <%= button_to(@game.last_question? ? "End quiz" : "Next",
+              advance_moderator_quiz_game_path(@quiz, @game),
+              method: :post,
+              class: "btn btn--pink btn--lg") %>
+      <% end %>
+    </div>
+  </footer>
+</section>
