+
+  test "top selection and draws never award zero-point players" do
+    @quiz.update!(number_of_winners: 2)
+    create_question(@quiz, "First", active: true, position: 1)
+    create_question(@quiz, "Second", active: true, position: 2)
+    game = Game.create_for!(@quiz)
+    players = %w[Alice Bob Cara Dave Zero].index_with do |name|
+      game.join!(browser_token: name.downcase, name: name)
+    end
+    opened_at = Time.zone.local(2026, 11, 21, 13, 0, 0)
+
+    travel_to(opened_at) { game.start! }
+    first_question = game.current_question
+    first_correct = first_question.game_options.find_by!(correct: true)
+
+    { "Alice" => 1, "Bob" => 3, "Cara" => 4, "Dave" => 5 }.each do |name, seconds|
+      travel_to(opened_at + seconds.seconds) do
+        game.submit_answer!(
+          player: players.fetch(name),
+          game_question_id: first_question.id,
+          game_option_id: first_correct.id
+        )
+      end
+    end
+
+    game.finish_question!
+    travel_to(opened_at + 20.seconds) { game.advance! }
+    second_question = game.current_question
+    second_correct = second_question.game_options.find_by!(correct: true)
+    travel_to(opened_at + 22.seconds) do
+      game.submit_answer!(
+        player: players.fetch("Alice"),
+        game_question_id: second_question.id,
+        game_option_id: second_correct.id
+      )
+    end
+    game.finish_question!
+    game.advance!
+
+    assert_equal 2, game.number_of_winners
+
+    game.choose_top_winners!
+    assert_equal %w[Alice Bob], game.players.where(winner: true).order(:id).pluck(:name)
+
+    game.draw_winners!
+    drawn_names = game.players.where(winner: true).pluck(:name)
+    assert_equal 2, drawn_names.length
+    assert_includes drawn_names, "Alice"
+    assert_includes [ "Bob", "Cara", "Dave" ], (drawn_names - [ "Alice" ]).first
+    assert_not_includes drawn_names, "Zero"
+
+    game.reset_winners!
+    assert_empty game.players.where(winner: true)
+
+    game.update!(number_of_winners: 5)
+    game.draw_winners!
+    assert_equal %w[Alice Bob Cara Dave], game.players.where(winner: true).order(:id).pluck(:name)
+  end
+
