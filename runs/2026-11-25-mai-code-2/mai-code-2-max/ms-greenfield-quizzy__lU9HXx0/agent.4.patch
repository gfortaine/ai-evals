+    wrong = question.game_options.find_by!(correct: false)
+
+    assert_equal opened_at, question.opened_at
+
+    travel_to(opened_at + 3.seconds) do
+      game.submit_answer!(player: fast, game_question_id: question.id, game_option_id: correct.id)
+    end
+
+    slow_answer = nil
+    travel_to(opened_at + 2.seconds) do
+      slow_answer = game.submit_answer!(player: slow, game_question_id: question.id, game_option_id: wrong.id)
+    end
+    travel_to(opened_at + 7.seconds) do
+      slow_answer = game.submit_answer!(player: slow, game_question_id: question.id, game_option_id: correct.id)
+    end
+
+    assert_equal opened_at + 7.seconds, slow_answer.picked_at
+    assert_in_delta 7.0, slow_answer.response_time
+
+    game.finish_question!
+    game.advance!
+
+    entries = game.leaderboard
+    assert_equal [ "Fast", "Slow", "Wrong" ], entries.map { |entry| entry.player.name }
+    assert_equal [ 1, 1, 0 ], entries.map(&:points)
+    assert_equal [ 1, 2, 3 ], entries.map(&:place)
