+  def leaderboard
+    entries = players.includes(answers: %i[game_option game_question]).map do |player|
+      correct_answers = player.answers.select { |answer| answer.game_option.correct? }
+      LeaderboardEntry.new(
+        player: player,
+        points: correct_answers.length,
+        total_time: correct_answers.sum(&:response_time)
+      )
+    end
+
+    entries.sort_by! { |entry| [ -entry.points, entry.total_time, entry.player.id ] }
+    entries.each_with_index { |entry, index| entry.place = index + 1 }
+    entries
+  end
+
+  def choose_top_winners!
+    with_lock do
+      require_status!(:ended)
+      winner_ids = leaderboard.select { |entry| entry.points.positive? }.first(number_of_winners).map { |entry| entry.player.id }
+      set_winner_ids(winner_ids)
+    end
+  end
+
+  def draw_winners!
+    with_lock do
+      require_status!(:ended)
+
+      entries = leaderboard.select { |entry| entry.points.positive? }
+      winner_ids = if entries.length <= number_of_winners
+        entries.map { |entry| entry.player.id }
+      else
+        cutoff_points = entries.fetch(number_of_winners - 1).points
+        guaranteed = entries.select { |entry| entry.points > cutoff_points }
+        tied = entries.select { |entry| entry.points == cutoff_points }
+        remaining = number_of_winners - guaranteed.length
+
+        guaranteed.map { |entry| entry.player.id } + tied.sample(remaining).map { |entry| entry.player.id }
+      end
+
+      set_winner_ids(winner_ids)
+    end
+  end
+
+  def reset_winners!
+    with_lock do
+      require_status!(:ended)
+      set_winner_ids([])
+    end
+  end
+
   private
 
+  def set_winner_ids(winner_ids)
+    now = Time.current
+    players.update_all(winner: false, updated_at: now)
+    players.where(id: winner_ids).update_all(winner: true, updated_at: now)
+  end
+
   def generate_code
     return if code.present?
 
