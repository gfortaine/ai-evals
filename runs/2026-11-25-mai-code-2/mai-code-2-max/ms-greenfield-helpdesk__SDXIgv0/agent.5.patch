@@ -0,0 +1,14 @@
+class SupportMailbox < ApplicationMailbox
+  def process
+    result = Helpdesk::InboundEmailProcessor.new(inbound_email).call
+    unless result.status == :accepted
+      bounced!
+      inbound_email.destroy!
+      return
+    end
+
+    if result.verification_token
+      UserMailer.email_verification(result.requester, result.verification_token).deliver_now
+    end
+  end
+end
