diff --git a/app/services/helpdesk/inbound_email_processor.rb b/app/services/helpdesk/inbound_email_processor.rb
new file mode 100644
index 0000000..f123546
--- /dev/null
+++ b/app/services/helpdesk/inbound_email_processor.rb
@@ -0,0 +1,230 @@
+require "securerandom"
+require "uri"
+
+module Helpdesk
+  class InboundEmailProcessor
+    AUTOMATED_PRECEDENCES = %w[auto-reply auto_reply bulk junk list].freeze
+    AUTOMATED_SENDER_LOCALS = %w[mailer-daemon postmaster].freeze
+    Result = Struct.new(:status, :ticket, :requester, :verification_token, keyword_init: true)
+    Sender = Struct.new(:email, :name, keyword_init: true)
+    Destination = Struct.new(:account, :ticket, keyword_init: true)
+
+    def initialize(inbound_email)
+      @inbound_email = inbound_email
+    end
+
+    def call
+      return ignored if message_id.blank?
+      return ignored if automated?
+      return ignored if EmailDelivery.exists?(message_id: message_id)
+
+      sender = extract_sender
+      return ignored unless sender
+
+      destination = resolve_destination
+      return ignored unless destination
+
+      body = plain_text_body
+      return ignored if body.blank?
+
+      subject = mail.subject.to_s.strip
+      if destination.ticket.nil? && (subject.blank? || subject.length > 255)
+        return ignored
+      end
+
+      persist(destination, sender, subject, body)
+    rescue Mail::Field::ParseError
+      ignored
+    rescue ActiveRecord::RecordNotUnique
+      raise unless EmailDelivery.exists?(message_id: message_id)
+
+      ignored
+    end
+
+    private
+
+    attr_reader :inbound_email
+
+    def mail
+      inbound_email.mail
+    end
+
+    def message_id
+      @message_id ||= inbound_email.message_id.to_s.strip
+    end
+
+    def ignored
+      Result.new(status: :ignored)
+    end
+
+    def accepted(ticket:, requester:, verification_token: nil)
+      Result.new(
+        status: :accepted,
+        ticket: ticket,
+        requester: requester,
+        verification_token: verification_token
+      )
+    end
+
+    def automated?
+      auto_submitted = header_value("Auto-Submitted").split(/[,;\s]+/, 2).first.to_s
+      return true if auto_submitted.present? && !auto_submitted.casecmp?("no")
+
+      precedence = header_value("Precedence").downcase.split(/[,;\s]+/)
+      return true if (precedence & AUTOMATED_PRECEDENCES).any?
+
+      suppression = header_value("X-Auto-Response-Suppress").downcase
+      return true if suppression.present? && !%w[none false].include?(suppression)
+      return true if %w[X-Loop X-Autoreply X-Auto-Reply X-Autorespond X-Mailing-List].any? do |name|
+        header_value(name).present?
+      end
+      return true if mail.header_fields.any? { |field| field.name.to_s.downcase.start_with?("list-") }
+      return true if mail.mime_type.to_s.casecmp?("multipart/report")
+
+      sender_email = Array(mail.from).first.to_s.strip.downcase
+      local = sender_email.split("@", 2).first
+      AUTOMATED_SENDER_LOCALS.include?(local) || local.match?(/\A(?:no[-_.]?reply|do[-_.]?not[-_.]?reply)\z/)
+    end
+
+    def header_value(name)
+      mail[name].to_s.strip
+    end
+
+    def extract_sender
+      from_addresses = Array(mail.from)
+      return unless from_addresses.one?
+
+      email = parsed_address(from_addresses.first)
+      return unless email
+
+      email = User.normalize_email(email)
+      return unless URI::MailTo::EMAIL_REGEXP.match?(email)
+
+      display_name = mail.from_address&.display_name.to_s.squish
+      name = display_name.presence || email.split("@", 2).first.tr("._-", " ").squish
+      name = email if name.blank?
+
+      Sender.new(email: email, name: name.truncate(120))
+    end
+
+    def resolve_destination
+      accounts = []
+      tickets = []
+
+      normalized_recipients.each do |address|
+        local, separator, domain = address.rpartition("@")
+        next unless separator.present? && domain.casecmp?(support_domain)
+
+        if local.start_with?("reply+")
+          token = Ticket.reply_token_from_address(address)
+          ticket = token && Ticket.includes(:account).find_by(reply_token: token)
+          return if ticket.nil?
+
+          tickets << ticket
+          accounts << ticket.account
+        else
+          account = Account.find_by(subdomain: local.downcase)
+          accounts << account if account
+        end
+      end
+
+      accounts.uniq!(&:id)
+      tickets.uniq!(&:id)
+      return unless accounts.one? && tickets.length <= 1
+
+      Destination.new(account: accounts.first, ticket: tickets.first)
+    end
+
+    def normalized_recipients
+      Array(mail.recipients).filter_map { |address| parsed_address(address) }.map(&:downcase).uniq
+    end
+
+    def parsed_address(address)
+      Mail::Address.new(address.to_s).address.to_s.presence
+    rescue Mail::Field::ParseError
+      nil
+    end
+
+    def plain_text_body
+      part = mail.multipart? ? mail.text_part : mail
+      return unless part && (part.mime_type.blank? || part.mime_type.casecmp?("text/plain"))
+
+      part.body.decoded.to_s.encode("UTF-8", invalid: :replace, undef: :replace, replace: "?").strip
+    rescue EncodingError
+      nil
+    end
+
+    def persist(destination, sender, subject, body)
+      result = nil
+
+      Account.transaction do
+        account = Account.active.lock.find_by(id: destination.account.id)
+        unless account
+          result = ignored
+          next
+        end
+
+        if EmailDelivery.exists?(message_id: message_id)
+          result = ignored
+          next
+        end
+
+        if destination.ticket
+          result = persist_reply(account, destination.ticket, sender, body)
+        else
+          result = persist_new_ticket(account, sender, subject, body)
+        end
+      end
+
+      result || ignored
+    end
+
+    def persist_new_ticket(account, sender, subject, body)
+      requester = account.users.find_by(email: sender.email)
+      verification_token = nil
+
+      if requester
+        return ignored unless requester.customer? && !requester.suspended?
+      else
+        requester = account.users.build(
+          name: sender.name,
+          email: sender.email,
+          password: SecureRandom.base64(32),
+          role: "customer",
+          verified: false,
+          suspended: false
+        )
+        return ignored unless requester.valid?
+
+        requester.save!
+        verification_token = requester.issue_email_verification!
+      end
+
+      ticket = account.tickets.create!(
+        requester: requester,
+        subject: subject,
+        status: "open",
+        email_origin: true
+      )
+      ticket.comments.create!(author: requester, body: body, public: true)
+      EmailDelivery.create!(ticket: ticket, message_id: message_id)
+
+      accepted(ticket: ticket, requester: requester, verification_token: verification_token)
+    end
+
+    def persist_reply(account, routed_ticket, sender, body)
+      ticket = account.tickets.lock.find_by(id: routed_ticket.id)
+      return ignored unless ticket && User.normalize_email(ticket.requester.email) == sender.email
+
+      ticket.comments.create!(author: ticket.requester, body: body, public: true)
+      ticket.update!(status: "open") unless ticket.status == "open"
+      EmailDelivery.create!(ticket: ticket, message_id: message_id)
+
+      accepted(ticket: ticket, requester: ticket.requester)
+    end
+
+    def support_domain
+      Rails.application.config.x.helpdesk.support_domain
+    end
+  end
+end
