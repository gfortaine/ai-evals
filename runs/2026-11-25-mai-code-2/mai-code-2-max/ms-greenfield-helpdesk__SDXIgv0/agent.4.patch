diff --git a/test/integration/customer_portal_test.rb b/test/integration/customer_portal_test.rb
index 8d3532c..1efecde 100644
--- a/test/integration/customer_portal_test.rb
+++ b/test/integration/customer_portal_test.rb
@@ -180,6 +180,31 @@ class CustomerPortalTest < ActionDispatch::IntegrationTest
     assert_response :bad_request
   end
 
+  test "customers filter their requests by status without access to priority" do
+    open_request = create_ticket(@customer, "Open request")
+    solved_request = create_ticket(@customer, "Solved request")
+    solved_request.update!(status: "solved", priority: "high")
+
+    get "/api/v1/requests", params: { status: "solved" }, headers: customer_headers
+    assert_response :success
+    assert_equal [ solved_request.id ], json.fetch("requests").map { |record| record.fetch("id") }
+    refute json.fetch("requests").first.key?("priority")
+
+    get "/api/v1/requests/#{open_request.id}", headers: customer_headers
+    assert_response :success
+    refute json.fetch("request").key?("priority")
+
+    patch "/api/v1/requests/#{open_request.id}", params: {
+      request: { status: "solved", priority: "high" }
+    }, headers: customer_headers, as: :json
+    assert_response :success
+    assert_equal "normal", open_request.reload.priority
+    refute json.fetch("request").key?("priority")
+
+    get "/api/v1/requests", params: { status: "solved" }, headers: customer_headers
+    assert_equal 2, json.fetch("count")
+  end
+
   private
 
   def create_user(handle, name, role)
diff --git a/test/integration/staff_management_test.rb b/test/integration/staff_management_test.rb
index 73ee56f..07271c7 100644
--- a/test/integration/staff_management_test.rb
+++ b/test/integration/staff_management_test.rb
@@ -235,6 +235,72 @@ class StaffManagementTest < ActionDispatch::IntegrationTest
     assert_response :unprocessable_content
   end
 
+  test "staff set priority and combine ticket filters with literal public text search" do
+    agent = create_user("priority-agent", "Priority Agent", "agent")
+    other_customer = create_user("filter-customer", "Filter Customer", "customer")
+    agent_token = Session.issue_for!(agent).last
+    ticket = create_ticket
+
+    assert_equal "normal", ticket.priority
+    original_updated_at = ticket.reload.updated_at
+
+    patch "/api/v1/tickets/#{ticket.id}", params: {
+      ticket: { priority: "high" }
+    }, headers: authenticated_headers(agent_token), as: :json
+    assert_response :success
+    assert_equal "high", json.dig("ticket", "priority")
+    assert_equal original_updated_at, ticket.reload.updated_at
+
+    patch "/api/v1/tickets/#{ticket.id}", params: {
+      ticket: { priority: "urgent" }
+    }, headers: authenticated_headers(agent_token), as: :json
+    assert_response :unprocessable_content
+    assert_equal "high", ticket.reload.priority
+
+    ticket.comments.create!(author: @customer, body: "Need a RECEIPT 100%_done!", public: true)
+    ticket.comments.create!(author: @customer, body: "Another RECEIPT 100%_done!", public: true)
+
+    make_ticket = ->(requester: @customer, status: "open", priority: "high", assignee: nil, subject: "Other", comment: "Please help.", private_comment: nil) do
+      record = @account.tickets.create!(
+        requester: requester,
+        assignee: assignee,
+        subject: subject,
+        status: status,
+        priority: priority
+      )
+      record.comments.create!(author: requester, body: comment, public: true)
+      record.comments.create!(author: @owner, body: private_comment, public: false) if private_comment
+      record
+    end
+
+    make_ticket.call(status: "pending")
+    assigned = make_ticket.call(assignee: agent)
+    make_ticket.call(priority: "normal")
+    make_ticket.call(requester: other_customer)
+    make_ticket.call(comment: "A wildcard lookalike 100XXdone!")
+    make_ticket.call(private_comment: "Hidden 100%_done!")
+
+    get "/api/v1/tickets", params: {
+      status: "open",
+      assignee_id: "unassigned",
+      requester_id: @customer.id,
+      priority: "high",
+      q: "100%_done!"
+    }, headers: authenticated_headers(agent_token)
+    assert_response :success
+    assert_equal [ ticket.id ], json.fetch("tickets").map { |record| record.fetch("id") }
+    assert_equal "high", json.dig("tickets", 0, "priority")
+
+    get "/api/v1/tickets", params: { assignee_id: agent.id }, headers: authenticated_headers(agent_token)
+    assert_response :success
+    assert_equal [ assigned.id ], json.fetch("tickets").map { |record| record.fetch("id") }
+
+    subject_match = make_ticket.call(subject: "A unique receipt report", comment: "Nothing relevant")
+    get "/api/v1/tickets", params: { q: "UNIQUE RECEIPT REPORT" }, headers: authenticated_headers(agent_token)
+    assert_response :success
+    assert_equal [ subject_match.id ], json.fetch("tickets").map { |record| record.fetch("id") }
+  end
+
   private
 
   def create_user(handle, name, role, suspended: false)
