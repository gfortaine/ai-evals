+module Api
+  module V1
+    class GroupsController < ApplicationController
+      before_action :set_account
+      before_action :authenticate_user!
+      before_action :require_active_account
+      before_action :require_staff!
+      before_action :require_admin!, only: %i[create update destroy]
+      before_action :set_group, only: %i[show update destroy]
+
+      def index
+        render_paginated(
+          current_account.groups.order(:id),
+          key: :groups,
+          serializer: ->(group) { GroupSerializer.new(group) },
+          cursor_order: { id: :asc }
+        )
+      end
+
+      def show
+        render json: { group: GroupSerializer.new(@group) }
+      end
+
+      def create
+        attributes = params.require(:group).permit(:name)
+        group = current_account.groups.create!(name: attributes.require(:name))
+
+        render json: { group: GroupSerializer.new(group) }, status: :created
+      end
+
+      def update
+        attributes = params.require(:group).permit(:name)
+        @group.with_lock do
+          @group.update!(name: attributes.require(:name))
+        end
+
+        render json: { group: GroupSerializer.new(@group.reload) }
+      end
+
+      def destroy
+        @group.with_lock do
+          @group.destroy!
+        end
+        head :no_content
+      end
+
+      private
+
+      def set_group
+        @group = current_account.groups.find(params[:id])
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
