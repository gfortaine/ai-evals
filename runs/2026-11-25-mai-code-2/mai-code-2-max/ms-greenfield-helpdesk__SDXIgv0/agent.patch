diff --git a/app/services/helpdesk/cursor_paginator.rb b/app/services/helpdesk/cursor_paginator.rb
new file mode 100644
index 0000000..931c233
--- /dev/null
+++ b/app/services/helpdesk/cursor_paginator.rb
@@ -0,0 +1,274 @@
+module Helpdesk
+  class CursorPaginator
+    class InvalidCursor < StandardError; end
+
+    Page = Data.define(
+      :records,
+      :has_more,
+      :before_cursor,
+      :after_cursor,
+      :next_cursor,
+      :prev_cursor,
+      :has_before,
+      :has_after
+    )
+
+    VERSION = 1
+    PURPOSE = :cursor_pagination
+    VERIFIER = "helpdesk.cursor_pagination"
+    MAX_CURSOR_LENGTH = 8_192
+
+    def initialize(relation:, order:, scope:)
+      @relation = relation
+      @model = relation.klass
+      @order = normalize_order(order)
+      @scope = scope.to_s
+    end
+
+    def paginate(size:, after: nil, before: nil)
+      raise ArgumentError, "size must be positive" unless size.positive?
+      raise ArgumentError, "only one cursor direction can be supplied" if after && before
+
+      direction = before ? :before : :after
+      input_cursor = before || after
+      decoded_cursor = decode_cursor(input_cursor, direction: direction) if input_cursor
+      # Freeze the result set at the first page so later inserts and sort-key changes cannot shift it.
+      snapshot = decoded_cursor ? decoded_cursor[:snapshot] : snapshot_position
+      bounded = snapshot ? bounded_relation(snapshot) : @relation.none
+
+      requested = if decoded_cursor
+        seek(bounded, decoded_cursor[:position], direction: direction)
+      else
+        bounded
+      end
+
+      fetched = requested
+        .reorder(fetch_order(direction))
+        .limit(size + 1)
+        .to_a
+      more_in_direction = fetched.length > size
+      records = fetched.first(size)
+      records.reverse! if direction == :before
+
+      has_after = if direction == :after
+        more_in_direction
+      else
+        opposite_records_exist?(bounded, records, decoded_cursor, :after)
+      end
+      has_before = if direction == :before
+        more_in_direction
+      elsif decoded_cursor
+        opposite_records_exist?(bounded, records, decoded_cursor, :before)
+      else
+        false
+      end
+
+      before_cursor, after_cursor = cursors_for(records, snapshot)
+      next_cursor = after_cursor if has_after
+      next_cursor ||= input_cursor if direction == :before && has_after
+      prev_cursor = before_cursor if has_before
+      prev_cursor ||= input_cursor if direction == :after && has_before
+
+      Page.new(
+        records: records,
+        has_more: more_in_direction,
+        before_cursor: before_cursor,
+        after_cursor: after_cursor,
+        next_cursor: next_cursor,
+        prev_cursor: prev_cursor,
+        has_before: has_before,
+        has_after: has_after
+      )
+    end
+
+    def offset_navigation(records, has_after:, has_before:)
+      snapshot = snapshot_position
+      before_cursor, after_cursor = cursors_for(records, snapshot)
+
+      Page.new(
+        records: records,
+        has_more: has_after,
+        before_cursor: before_cursor,
+        after_cursor: after_cursor,
+        next_cursor: has_after ? after_cursor : nil,
+        prev_cursor: has_before ? before_cursor : nil,
+        has_before: has_before,
+        has_after: has_after
+      )
+    end
+
+    private
+
+    def normalize_order(order)
+      pairs = order.respond_to?(:to_h) ? order.to_h.to_a : Array(order)
+      normalized = pairs.map do |column, direction|
+        column = column.to_s
+        direction = direction.to_s.downcase.to_sym
+        unless @model.column_names.include?(column) && %i[asc desc].include?(direction)
+          raise ArgumentError, "invalid cursor order"
+        end
+        [ column, direction ]
+      end
+
+      valid_order = normalized.any? &&
+        normalized.map(&:first).uniq.length == normalized.length &&
+        normalized.map(&:first).include?("id")
+      unless valid_order
+        raise ArgumentError, "cursor order must include a unique id column"
+      end
+
+      normalized.freeze
+    end
+
+    def snapshot_position
+      value = @relation
+        .except(:includes, :preload, :eager_load)
+        .reorder(snapshot_order)
+        .limit(1)
+        .pick(*@order.map(&:first))
+      return if value.nil?
+
+      values = @order.one? ? [ value ] : Array(value)
+      values.length == @order.length ? values : nil
+    end
+
+    def snapshot_order
+      @order.to_h { |column, _direction| [ column, :desc ] }
+    end
+
+    def fetch_order(direction)
+      @order.to_h do |column, order_direction|
+        effective_direction = if direction == :before
+          order_direction == :asc ? :desc : :asc
+        else
+          order_direction
+        end
+        [ column, effective_direction ]
+      end
+    end
+
+    def bounded_relation(snapshot)
+      @relation.where(lexicographic_predicate(snapshot, through: :snapshot))
+    end
+
+    def seek(relation, position, direction:)
+      relation.where(lexicographic_predicate(position, through: direction))
+    end
+
+    def lexicographic_predicate(values, through:)
+      table = @model.arel_table
+      clauses = values.each_index.map do |index|
+        column, order_direction = @order[index]
+        attribute = table[column]
+        comparison = if through == :snapshot
+          index == values.length - 1 ? attribute.lteq(values[index]) : attribute.lt(values[index])
+        else
+          attribute.public_send(comparison_operator(order_direction, through), values[index])
+        end
+
+        values.each_index.take(index).reduce(comparison) do |clause, prefix_index|
+          prefix_column = @order[prefix_index].first
+          table[prefix_column].eq(values[prefix_index]).and(clause)
+        end
+      end
+
+      clauses.drop(1).reduce(clauses.first) { |predicate, clause| predicate.or(clause) }
+    end
+
+    def comparison_operator(order_direction, through)
+      after = through == :after
+      ascending = order_direction == :asc
+      (after == ascending) ? :gt : :lt
+    end
+
+    def opposite_records_exist?(bounded, records, decoded_cursor, direction)
+      position = if records.any?
+        position_for(direction == :after ? records.last : records.first)
+      elsif decoded_cursor
+        decoded_cursor[:position]
+      end
+      return false unless position
+
+      seek(bounded, position, direction: direction).exists?
+    end
+
+    def cursors_for(records, snapshot)
+      return [ nil, nil ] if records.empty? || snapshot.nil?
+
+      [ cursor_for(records.first, snapshot), cursor_for(records.last, snapshot) ]
+    end
+
+    def cursor_for(record, snapshot)
+      verifier.generate({
+        "version" => VERSION,
+        "scope" => @scope,
+        "model" => @model.base_class.name,
+        "order" => @order.map { |column, direction| [ column, direction.to_s ] },
+        "position" => encode_position(position_for(record)),
+        "snapshot" => encode_position(snapshot)
+      }, purpose: PURPOSE)
+    end
+
+    def decode_cursor(token, direction:)
+      unless token.is_a?(String) && token.present? && token.bytesize <= MAX_CURSOR_LENGTH
+        raise InvalidCursor, "page[#{direction}] must be a valid cursor"
+      end
+
+      payload = verifier.verified(token, purpose: PURPOSE)
+      unless valid_payload?(payload)
+        raise InvalidCursor, "page[#{direction}] must be a valid cursor"
+      end
+
+      {
+        position: decode_position(payload["position"]),
+        snapshot: decode_position(payload["snapshot"])
+      }
+    rescue ArgumentError, TypeError, ActiveSupport::MessageVerifier::InvalidSignature
+      raise InvalidCursor, "page[#{direction}] must be a valid cursor"
+    end
+
+    def valid_payload?(payload)
+      payload.is_a?(Hash) &&
+        payload["version"] == VERSION &&
+        payload["scope"] == @scope &&
+        payload["model"] == @model.base_class.name &&
+        payload["order"] == @order.map { |column, direction| [ column, direction.to_s ] } &&
+        position_payload?(payload["position"]) &&
+        position_payload?(payload["snapshot"])
+    end
+
+    def position_payload?(values)
+      values.is_a?(Array) && values.length == @order.length
+    end
+
+    def decode_position(values)
+      @order.each_with_index.map do |(column, _direction), index|
+        value = @model.type_for_attribute(column).cast(values[index])
+        raise TypeError if value.nil?
+
+        value
+      end
+    end
+
+    def encode_position(values)
+      values.map do |value|
+        case value
+        when ActiveSupport::TimeWithZone, Time, DateTime
+          value.utc.iso8601(6)
+        when Date
+          value.iso8601
+        else
+          value
+        end
+      end
+    end
+
+    def position_for(record)
+      @order.map { |column, _direction| record.public_send(column) }
+    end
+
+    def verifier
+      Rails.application.message_verifier(VERIFIER)
+    end
+  end
+end
diff --git a/app/services/helpdesk/inbound_email_processor.rb b/app/services/helpdesk/inbound_email_processor.rb
new file mode 100644
index 0000000..66cf71c
--- /dev/null
+++ b/app/services/helpdesk/inbound_email_processor.rb
@@ -0,0 +1,231 @@
+require "securerandom"
+require "uri"
+
+module Helpdesk
+  class InboundEmailProcessor
+    AUTOMATED_PRECEDENCES = %w[auto-reply auto_reply bulk junk list].freeze
+    AUTOMATED_SENDER_LOCALS = %w[mailer-daemon postmaster].freeze
+    Result = Struct.new(:status, :ticket, :requester, :verification_token, keyword_init: true)
+    Sender = Struct.new(:email, :name, keyword_init: true)
+    Destination = Struct.new(:account, :ticket, keyword_init: true)
+
+    def initialize(inbound_email)
+      @inbound_email = inbound_email
+    end
+
+    def call
+      return ignored if message_id.blank?
+      return ignored if automated?
+      return ignored if EmailDelivery.exists?(message_id: message_id)
+
+      sender = extract_sender
+      return ignored unless sender
+
+      destination = resolve_destination
+      return ignored unless destination
+
+      body = plain_text_body
+      return ignored if body.blank?
+
+      subject = mail.subject.to_s.strip
+      if destination.ticket.nil? && (subject.blank? || subject.length > 255)
+        return ignored
+      end
+
+      persist(destination, sender, subject, body)
+    rescue Mail::Field::ParseError
+      ignored
+    rescue ActiveRecord::RecordNotUnique
+      raise unless EmailDelivery.exists?(message_id: message_id)
+
+      ignored
+    end
+
+    private
+
+    attr_reader :inbound_email
+
+    def mail
+      inbound_email.mail
+    end
+
+    def message_id
+      @message_id ||= inbound_email.message_id.to_s.strip
+    end
+
+    def ignored
+      Result.new(status: :ignored)
+    end
+
+    def accepted(ticket:, requester:, verification_token: nil)
+      Result.new(
+        status: :accepted,
+        ticket: ticket,
+        requester: requester,
+        verification_token: verification_token
+      )
+    end
+
+    def automated?
+      auto_submitted = header_value("Auto-Submitted").split(/[,;\s]+/, 2).first.to_s
+      return true if auto_submitted.present? && !auto_submitted.casecmp?("no")
+
+      precedence = header_value("Precedence").downcase.split(/[,;\s]+/)
+      return true if (precedence & AUTOMATED_PRECEDENCES).any?
+
+      suppression = header_value("X-Auto-Response-Suppress").downcase
+      return true if suppression.present? && !%w[none false].include?(suppression)
+      return true if %w[X-Loop X-Autoreply X-Auto-Reply X-Autorespond X-Mailing-List].any? do |name|
+        header_value(name).present?
+      end
+      return true if mail.header_fields.any? { |field| field.name.to_s.downcase.start_with?("list-") }
+      return true if mail.mime_type.to_s.casecmp?("multipart/report")
+
+      sender_email = Array(mail.from).first.to_s.strip.downcase
+      local = sender_email.split("@", 2).first
+      AUTOMATED_SENDER_LOCALS.include?(local) || local.match?(/\A(?:no[-_.]?reply|do[-_.]?not[-_.]?reply)\z/)
+    end
+
+    def header_value(name)
+      mail[name].to_s.strip
+    end
+
+    def extract_sender
+      from_addresses = Array(mail.from)
+      return unless from_addresses.one?
+
+      email = parsed_address(from_addresses.first)
+      return unless email
+
+      email = User.normalize_email(email)
+      return unless URI::MailTo::EMAIL_REGEXP.match?(email)
+
+      display_name = mail.from_address&.display_name.to_s.squish
+      name = display_name.presence || email.split("@", 2).first.tr("._-", " ").squish
+      name = email if name.blank?
+
+      Sender.new(email: email, name: name.truncate(120))
+    end
+
+    def resolve_destination
+      accounts = []
+      tickets = []
+
+      normalized_recipients.each do |address|
+        local, separator, domain = address.rpartition("@")
+        next unless separator.present? && domain.casecmp?(support_domain)
+
+        if local.start_with?("reply+")
+          token = Ticket.reply_token_from_address(address)
+          ticket = token && Ticket.includes(:account).find_by(reply_token: token)
+          return if ticket.nil?
+
+          tickets << ticket
+          accounts << ticket.account
+        else
+          account = Account.find_by(subdomain: local.downcase)
+          accounts << account if account
+        end
+      end
+
+      accounts.uniq!(&:id)
+      tickets.uniq!(&:id)
+      return unless accounts.one? && tickets.length <= 1
+
+      Destination.new(account: accounts.first, ticket: tickets.first)
+    end
+
+    def normalized_recipients
+      Array(mail.recipients).filter_map { |address| parsed_address(address) }.map(&:downcase).uniq
+    end
+
+    def parsed_address(address)
+      Mail::Address.new(address.to_s).address.to_s.presence
+    rescue Mail::Field::ParseError
+      nil
+    end
+
+    def plain_text_body
+      part = mail.multipart? ? mail.text_part : mail
+      return unless part && (part.mime_type.blank? || part.mime_type.casecmp?("text/plain"))
+
+      part.body.decoded.to_s.encode("UTF-8", invalid: :replace, undef: :replace, replace: "?").strip
+    rescue EncodingError
+      nil
+    end
+
+    def persist(destination, sender, subject, body)
+      result = nil
+
+      Account.transaction do
+        account = Account.active.lock.find_by(id: destination.account.id)
+        unless account
+          result = ignored
+          next
+        end
+
+        if EmailDelivery.exists?(message_id: message_id)
+          result = ignored
+          next
+        end
+
+        if destination.ticket
+          result = persist_reply(account, destination.ticket, sender, body)
+        else
+          result = persist_new_ticket(account, sender, subject, body)
+        end
+      end
+
+      result || ignored
+    end
+
+    def persist_new_ticket(account, sender, subject, body)
+      requester = account.users.find_by(email: sender.email)
+      verification_token = nil
+
+      if requester
+        return ignored unless requester.customer? && !requester.suspended?
+      else
+        requester = account.users.build(
+          name: sender.name,
+          email: sender.email,
+          password: SecureRandom.base64(32),
+          role: "customer",
+          verified: false,
+          suspended: false
+        )
+        return ignored unless requester.valid?
+
+        requester.save!
+        verification_token = requester.issue_email_verification!
+      end
+
+      ticket = account.tickets.create!(
+        requester: requester,
+        subject: subject,
+        status: "open",
+        email_origin: true
+      )
+      ticket.comments.create!(author: requester, body: body, public: true)
+      EmailDelivery.create!(ticket: ticket, message_id: message_id)
+
+      accepted(ticket: ticket, requester: requester, verification_token: verification_token)
+    end
+
+    def persist_reply(account, routed_ticket, sender, body)
+      ticket = account.tickets.lock.find_by(id: routed_ticket.id)
+      return ignored unless ticket && User.normalize_email(ticket.requester.email) == sender.email
+      return ignored if ticket.closed?
+
+      ticket.comments.create!(author: ticket.requester, body: body, public: true)
+      ticket.update!(status: "open") unless ticket.status == "open"
+      EmailDelivery.create!(ticket: ticket, message_id: message_id)
+
+      accepted(ticket: ticket, requester: ticket.requester)
+    end
+
+    def support_domain
+      Rails.application.config.x.helpdesk.support_domain
+    end
+  end
+end
diff --git a/app/services/helpdesk/ticket_merger.rb b/app/services/helpdesk/ticket_merger.rb
new file mode 100644
index 0000000..236f24a
--- /dev/null
+++ b/app/services/helpdesk/ticket_merger.rb
@@ -0,0 +1,52 @@
+module Helpdesk
+  class TicketMerger
+    Result = Struct.new(:source, :target, keyword_init: true)
+
+    def initialize(account:, source:, target_id:, actor:, source_comment:, target_comment:)
+      @account = account
+      @source_id = source.id
+      @target_id = target_id
+      @actor = actor
+      @source_comment = source_comment
+      @target_comment = target_comment
+    end
+
+    def call
+      Ticket.transaction do
+        tickets = account.tickets
+          .where(id: [ source_id, target_id ].uniq)
+          .order(:id)
+          .lock
+          .index_by(&:id)
+        source = tickets[source_id]
+        target = tickets[target_id]
+        raise ActiveRecord::RecordNotFound, "Ticket not found" unless source && target
+
+        validate_merge!(source, target)
+        source.comments.create!(author: actor, **source_comment)
+        target.comments.create!(author: actor, **target_comment)
+        source.update!(status: Ticket::CLOSED_STATUS, assignee: nil, merged_into: target)
+
+        Result.new(source: source.reload, target: target.reload)
+      end
+    end
+
+    private
+
+    attr_reader :account, :source_id, :target_id, :actor, :source_comment, :target_comment
+
+    def validate_merge!(source, target)
+      reject!(source, :base, "A ticket cannot be merged into itself") if source.id == target.id
+      reject!(source, :base, "Closed tickets cannot be edited") if source.closed?
+      reject!(target, :base, "A closed ticket cannot receive merges") if target.closed?
+      if source.requester_id != target.requester_id
+        reject!(target, :requester, "must match the source ticket customer")
+      end
+    end
+
+    def reject!(record, attribute, message)
+      record.errors.add(attribute, message)
+      raise ActiveRecord::RecordInvalid, record
+    end
+  end
+end
