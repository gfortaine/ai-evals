diff --git a/app/models/group_membership.rb b/app/models/group_membership.rb
new file mode 100644
index 0000000..8c424c9
--- /dev/null
+++ b/app/models/group_membership.rb
@@ -0,0 +1,72 @@
+class GroupMembership < ApplicationRecord
+  belongs_to :group, inverse_of: :group_memberships
+  belongs_to :user, inverse_of: :group_memberships
+
+  validates :group_id, uniqueness: { scope: :user_id }
+  validates :default, inclusion: { in: [ true, false ] }
+  validate :user_is_staff
+  validate :group_and_user_belong_to_same_account
+
+  around_save :synchronize_default, if: -> { new_record? || will_save_change_to_default? }
+  around_destroy :clear_assignment_and_reselect_default
+
+  def make_default!
+    self.class.transaction do
+      user.lock!
+      update!(default: true)
+    end
+    self
+  end
+
+  private
+
+  def synchronize_default
+    user.lock!
+    peers = self.class.where(user_id: user_id)
+
+    if default?
+      peers.where.not(id: id).where(default: true).update_all(default: false, updated_at: Time.current)
+    end
+
+    yield
+
+    if default?
+      peers.where.not(id: id).where(default: true).update_all(default: false, updated_at: Time.current)
+    elsif !peers.where(default: true).exists?
+      replacement = peers.order(:id).first
+      if replacement
+        replacement.update_columns(default: true, updated_at: Time.current)
+        if replacement.id == id
+          self[:default] = true
+          self[:updated_at] = replacement.updated_at
+        end
+      end
+    end
+  end
+
+  def clear_assignment_and_reselect_default
+    user.lock!
+    Ticket.where(group_id: group_id, assignee_id: user_id).update_all(assignee_id: nil)
+
+    yield
+
+    peers = self.class.where(user_id: user_id)
+    return if peers.where(default: true).exists?
+
+    peers.order(:id).first&.update_columns(default: true, updated_at: Time.current)
+  end
+
+  def user_is_staff
+    return unless user
+    return if user.staff?
+
+    errors.add(:user, "must be staff")
+  end
+
+  def group_and_user_belong_to_same_account
+    return unless group && user
+    return if group.account_id == user.account_id
+
+    errors.add(:user, "must belong to the group's account")
+  end
+end
diff --git a/app/models/invitation.rb b/app/models/invitation.rb
new file mode 100644
index 0000000..576b6d4
--- /dev/null
+++ b/app/models/invitation.rb
@@ -0,0 +1,124 @@
+require "uri"
+
+class Invitation < ApplicationRecord
+  TOKEN_TTL = 7.days
+  STATUSES = %w[pending accepted revoked expired].freeze
+  STAFF_ROLES = %w[admin agent].freeze
+
+  belongs_to :account, inverse_of: :invitations
+  belongs_to :invited_by, class_name: "User", optional: true
+
+  before_validation :normalize_email
+
+  validates :email,
+    presence: true,
+    length: { maximum: 254 },
+    format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :role, inclusion: { in: STAFF_ROLES }
+  validates :status, inclusion: { in: STATUSES }
+  validates :sent_at, :expires_at, presence: true
+  validates :token_digest, presence: true, if: :pending?
+  validates :token_digest, uniqueness: true, allow_nil: true
+
+  scope :oldest_first, -> { order(:id) }
+
+  def self.expire_due!
+    now = Time.current
+    where(status: "pending").where("expires_at <= ?", now).update_all(
+      status: "expired",
+      token_digest: nil,
+      updated_at: now
+    )
+  end
+
+  def pending?
+    status == "pending"
+  end
+
+  def expire_if_due!
+    with_lock do
+      update!(status: "expired", token_digest: nil) if pending? && expires_at <= Time.current
+    end
+    self
+  end
+
+  def issue!(attributes = {})
+    token = Helpdesk::Tokens.generate
+    now = Time.current
+    assign_attributes(attributes.merge(
+      token_digest: Helpdesk::Tokens.digest(token),
+      sent_at: now,
+      expires_at: now + TOKEN_TTL,
+      status: "pending",
+      accepted_at: nil,
+      revoked_at: nil
+    ))
+    save!
+    token
+  end
+
+  def resend!
+    token = nil
+    with_lock do
+      expire_if_due_without_lock!
+      reject_unless_resendable!
+      token = issue!
+    end
+    token
+  end
+
+  def revoke!
+    with_lock do
+      expire_if_due_without_lock!
+      reject_operation!("Only pending invitations may be revoked") unless pending?
+
+      update!(status: "revoked", revoked_at: Time.current, token_digest: nil)
+    end
+  end
+
+  def accept!(token, name:, password:)
+    user = nil
+    with_lock do
+      expire_if_due_without_lock!
+      next unless valid_token?(token)
+
+      user = account.users.build(
+        name: name,
+        email: email,
+        role: role,
+        password: password,
+        verified: true,
+        suspended: false
+      )
+      user.save!
+      update!(status: "accepted", accepted_at: Time.current, token_digest: nil)
+    end
+    user
+  end
+
+  def valid_token?(token)
+    pending? && expires_at.future? && token_digest.present? &&
+      ActiveSupport::SecurityUtils.secure_compare(token_digest, Helpdesk::Tokens.digest(token))
+  end
+
+  private
+
+  def normalize_email
+    self.email = User.normalize_email(email)
+  end
+
+  def expire_if_due_without_lock!
+    update!(status: "expired", token_digest: nil) if pending? && expires_at <= Time.current
+  end
+
+  def reject_unless_resendable!
+    return if pending? || status == "expired"
+
+    reject_operation!("Only pending or expired invitations may be resent")
+  end
+
+  def reject_operation!(message)
+    errors.add(:base, message)
+    raise ActiveRecord::RecordInvalid, self
+  end
+end
