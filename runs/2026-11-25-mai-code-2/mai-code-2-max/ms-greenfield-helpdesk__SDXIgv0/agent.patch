diff --git a/config/initializers/helpdesk.rb b/config/initializers/helpdesk.rb
new file mode 100644
index 0000000..ee95caf
--- /dev/null
+++ b/config/initializers/helpdesk.rb
@@ -0,0 +1,21 @@
+require "uri"
+
+frontend_url = ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001").sub(%r{/+\z}, "")
+frontend_uri = URI.parse(frontend_url)
+support_domain = ENV.fetch("HELPDESK_SUPPORT_DOMAIN", "support.example.test").strip.downcase
+
+unless frontend_uri.is_a?(URI::HTTP) && frontend_uri.host.present? && frontend_uri.query.nil? && frontend_uri.fragment.nil?
+  raise ArgumentError, "HELPDESK_FRONTEND_URL must be an HTTP(S) URL without a query or fragment"
+end
+
+valid_support_domain = support_domain.length <= 253 && support_domain.split(".", -1).all? do |label|
+  label.match?(/\A[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\z/)
+end
+unless valid_support_domain
+  raise ArgumentError, "HELPDESK_SUPPORT_DOMAIN must be a valid DNS domain"
+end
+
+Rails.application.config.x.helpdesk.frontend_url = frontend_url
+Rails.application.config.x.helpdesk.frontend_origin = frontend_uri.origin
+Rails.application.config.x.helpdesk.mail_from = ENV.fetch("HELPDESK_MAIL_FROM", "support@example.test")
+Rails.application.config.x.helpdesk.support_domain = support_domain
