+namespace :helpdesk do
+  desc "Permanently delete accounts cancelled more than 90 days ago"
+  task purge_cancelled_accounts: :environment do
+    purged = 0
+    Account.purgeable.in_batches(of: 100) do |accounts|
+      purged += accounts.destroy_all.length
+    end
+
+    puts "Purged #{purged} cancelled account#{'s' unless purged == 1}."
+  end
+end
