diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..d8a4b97
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,57 @@
+module Api
+  module V1
+    class AccountsController < ApplicationController
+      before_action :set_account, only: %i[show cancel reactivate]
+      before_action :authenticate_user!, only: %i[show cancel reactivate]
+      before_action :require_active_account, only: %i[show cancel]
+      before_action :require_owner!, only: %i[cancel reactivate]
+
+      def create
+        account_attributes = params.require(:account).permit(:name, :subdomain)
+        admin_attributes = params.require(:account).require(:admin).permit(:name, :email, :password)
+
+        account = Account.new(account_attributes)
+        user = account.users.build(admin_attributes.merge(role: "admin"))
+
+        account_valid = account.valid?
+        user_valid = user.valid?
+        unless account_valid && user_valid
+          render_error("Validation failed", status: :unprocessable_content, errors: {
+            account: account.errors.to_hash,
+            admin: user.errors.to_hash
+          })
+          return
+        end
+
+        verification_token = nil
+        Account.transaction do
+          account.save!
+          user.save!
+          account.update!(owner: user)
+          verification_token = user.issue_email_verification!
+        end
+
+        UserMailer.email_verification(user, verification_token).deliver_now
+
+        render json: {
+          account: AccountSerializer.new(account),
+          user: UserSerializer.new(user)
+        }, status: :created
+      end
+
+      def show
+        render_account
+      end
+
+      def cancel
+        current_account.cancel!
+        render_account
+      end
+
+      def reactivate
+        current_account.reactivate!
+        render_account
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
new file mode 100644
index 0000000..ee293ac
--- /dev/null
+++ b/app/controllers/api/v1/email_verifications_controller.rb
@@ -0,0 +1,36 @@
+module Api
+  module V1
+    class EmailVerificationsController < ApplicationController
+      before_action :set_account
+      before_action :require_active_account
+
+      def create
+        request_params = params.require(:email_verification).permit(:email)
+        email = User.normalize_email(request_params.require(:email))
+        user = current_account.users.find_by(email: email)
+
+        if user && !user.verified?
+          token = user.issue_email_verification!
+          UserMailer.email_verification(user, token).deliver_now
+        end
+
+        render json: { message: "If the address is awaiting verification, a new link has been sent" }, status: :accepted
+      end
+
+      def confirm
+        request_params = params.require(:email_verification).permit(:token)
+        token = request_params[:token].to_s
+        user = current_account.users.find_by(
+          email_verification_token_digest: Helpdesk::Tokens.digest(token)
+        )
+
+        unless user&.consume_email_verification!(token)
+          render_error("The email verification link is invalid or has expired", status: :unprocessable_content)
+          return
+        end
+
+        render_user(user)
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/group_memberships_controller.rb b/app/controllers/api/v1/group_memberships_controller.rb
