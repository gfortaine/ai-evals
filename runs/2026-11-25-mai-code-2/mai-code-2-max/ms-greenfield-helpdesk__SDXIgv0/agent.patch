+require "securerandom"
+
+class Ticket < ApplicationRecord
+  PRIORITIES = %w[normal high].freeze
+  CLOSED_STATUS = "closed"
+  STATUSES = [ "open", "pending", "solved", CLOSED_STATUS ].freeze
+  REPLY_TOKEN_PATTERN = /\A[a-f0-9]{48}\z/
+  REPLY_ADDRESS_PATTERN = /\Areply\+([a-f0-9]{48})\z/
+
+  belongs_to :account, inverse_of: :tickets
+  belongs_to :requester, class_name: "User"
+  belongs_to :assignee, class_name: "User", optional: true
+  belongs_to :group, optional: true, inverse_of: :tickets
+  belongs_to :merged_into, class_name: "Ticket", optional: true, inverse_of: :merged_tickets
+  has_many :merged_tickets,
+    class_name: "Ticket",
+    foreign_key: :merged_into_id,
+    inverse_of: :merged_into,
+    dependent: :nullify
+  has_many :comments, inverse_of: :ticket, dependent: :destroy
+  has_many :email_deliveries, inverse_of: :ticket, dependent: :destroy
+
+  before_validation :ensure_reply_token, on: :create
+  before_validation :reconcile_group_and_assignment
+  before_validation :clear_assignment_when_closed
+
+  validates :subject, presence: true, length: { maximum: 255 }
+  validates :priority, inclusion: { in: PRIORITIES }
+  validates :status, inclusion: { in: STATUSES }
+  validates :email_origin, inclusion: { in: [ true, false ] }
+  validates :reply_token, presence: true, uniqueness: true, format: { with: REPLY_TOKEN_PATTERN }
+  validate :requester_belongs_to_account
+  validate :group_belongs_to_account
+  validate :assignee_is_active_account_staff
+  validate :assignee_belongs_to_group
+  validate :closed_ticket_cannot_be_edited, on: :update
+  validate :merged_ticket_is_closed
+  validate :merge_target_is_compatible
+
+  scope :recent_first, -> { order(updated_at: :desc, id: :desc) }
+
+  def self.search_text(query)
+    pattern = "%#{sanitize_sql_like(query.to_s, "!")}%"
+    condition = <<~SQL.squish
+      tickets.subject ILIKE :pattern ESCAPE '!'
+      OR EXISTS (
+        SELECT 1
+        FROM comments
+        WHERE comments.ticket_id = tickets.id
+          AND comments.public = TRUE
+          AND comments.body ILIKE :pattern ESCAPE '!'
+      )
+    SQL
+
+    where(condition, pattern: pattern)
+  end
+
+  def self.reply_token_from_address(address)
+    local, separator, domain = address.to_s.rpartition("@")
+    return unless separator.present?
+    return unless domain.casecmp?(Rails.application.config.x.helpdesk.support_domain)
+
+    REPLY_ADDRESS_PATTERN.match(local.downcase)&.captures&.first
+  end
+
+  def reply_address
+    "reply+#{reply_token}@#{Rails.application.config.x.helpdesk.support_domain}"
+  end
+
+  def closed?
+    status == CLOSED_STATUS
+  end
+
+  def ensure_editable!
+    return unless closed?
+
+    errors.add(:base, "Closed tickets cannot be edited")
+    raise ActiveRecord::RecordInvalid, self
+  end
+
+  private
+
+  def ensure_reply_token
+    self.reply_token ||= SecureRandom.hex(24)
+  end
+
+  def reconcile_group_and_assignment
+    group_changed = will_save_change_to_group_id?
+    assignee_changed = will_save_change_to_assignee_id?
+
+    if group_changed && group_id.nil?
+      self.assignee = nil
+    elsif group_changed && assignee && !assignee_changed && !assignee_belongs_to_group?
+      self.assignee = nil
+    elsif assignee_changed && assignee && group_id.nil?
+      self.group = assignee.default_group
+    end
+  end
+
+  def clear_assignment_when_closed
+    self.assignee = nil if closed?
+  end
+
+  def requester_belongs_to_account
+    return unless account && requester
+    return if requester.account_id == account.id
+
+    errors.add(:requester, "must belong to the account")
+  end
+
+  def group_belongs_to_account
+    return unless account && group
+    return if group.account_id == account.id
+
+    errors.add(:group, "must belong to the ticket account")
+  end
+
+  def assignee_is_active_account_staff
+    return unless assignee
+
+    errors.add(:assignee, "must belong to the ticket account") unless assignee.account_id == account_id
+    errors.add(:assignee, "must be active staff") unless assignee.active_staff?
+  end
+
+  def assignee_belongs_to_group
+    return unless group && assignee
+    return if assignee_belongs_to_group?
+
+    errors.add(:assignee, "must belong to the ticket group")
+  end
+
+  def assignee_belongs_to_group?
+    GroupMembership.exists?(group_id: group_id, user_id: assignee_id)
+  end
+
+  def closed_ticket_cannot_be_edited
+    return unless persisted? && attribute_in_database(:status) == CLOSED_STATUS && has_changes_to_save?
+
+    errors.add(:base, "Closed tickets cannot be edited")
+  end
+
+  def merged_ticket_is_closed
+    return unless merged_into_id
+    return if closed?
+
+    errors.add(:merged_into, "can only be set on a closed ticket")
+  end
+
+  def merge_target_is_compatible
+    target = merged_into
+    return unless target
+
+    errors.add(:merged_into, "cannot reference the same ticket") if target.id == id
+    if target.account_id != account_id
+      errors.add(:merged_into, "must belong to the same account")
+    end
+    if target.requester_id != requester_id
+      errors.add(:merged_into, "must belong to the same customer")
+    end
+  end
+end
diff --git a/app/models/user.rb b/app/models/user.rb
new file mode 100644
index 0000000..fbdc809
--- /dev/null
+++ b/app/models/user.rb
@@ -0,0 +1,161 @@
+require "uri"
+
+class User < ApplicationRecord
+  ROLES = %w[admin agent member customer].freeze
+  EMAIL_VERIFICATION_TTL = 24.hours
+  PASSWORD_RESET_TTL = 2.hours
+
+  belongs_to :account, inverse_of: :users
+  has_many :sessions, dependent: :destroy
+  has_many :assigned_tickets,
+    class_name: "Ticket",
+    foreign_key: :assignee_id,
+    inverse_of: :assignee,
+    dependent: :nullify
+  has_many :sent_invitations,
+    class_name: "Invitation",
+    foreign_key: :invited_by_id,
+    inverse_of: :invited_by,
+    dependent: :nullify
+  has_many :group_memberships, inverse_of: :user, dependent: :destroy
+  has_many :groups, through: :group_memberships
+
+  has_secure_password
+
+  before_validation :normalize_email
+  after_update :clean_up_suspension, if: -> { saved_change_to_suspended? && suspended? }
+
+  validates :name, presence: true, length: { maximum: 120 }
+  validates :email,
+    presence: true,
+    length: { maximum: 254 },
+    uniqueness: { scope: :account_id, case_sensitive: false },
+    format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :role, inclusion: { in: ROLES }
+  validates :suspended, inclusion: { in: [ true, false ] }
+  validates :password, length: { minimum: 8 }, allow_nil: true, on: %i[create update]
+
+  scope :active, -> { where(suspended: false) }
+  scope :active_staff, -> { active.where(role: %w[admin agent member], verified: true) }
+
+  def self.normalize_email(email)
+    email.to_s.strip.downcase
+  end
+
+  def admin?
+    role == "admin"
+  end
+
+  def agent?
+    role == "agent"
+  end
+
+  def customer?
+    role == "customer"
+  end
+
+  def staff?
+    %w[admin agent member].include?(role)
+  end
+
+  def active_staff?
+    staff? && verified? && !suspended?
+  end
+
+  def default_group
+    group_memberships.includes(:group).find_by(default: true)&.group
+  end
+
+  def owner?
+    account&.owned_by?(self)
+  end
+
+  def issue_email_verification!
+    token = Helpdesk::Tokens.generate
+    update!(
+      email_verification_token_digest: Helpdesk::Tokens.digest(token),
+      email_verification_sent_at: Time.current
+    )
+    token
+  end
+
+  def consume_email_verification!(token)
+    with_lock do
+      return false unless valid_token?(
+        token,
+        email_verification_token_digest,
+        email_verification_sent_at,
+        EMAIL_VERIFICATION_TTL
+      )
+
+      update!(
+        verified: true,
+        email_verification_token_digest: nil,
+        email_verification_sent_at: nil
+      )
+      true
+    end
+  end
+
+  def issue_password_reset!
+    token = Helpdesk::Tokens.generate
+    update!(
+      password_reset_token_digest: Helpdesk::Tokens.digest(token),
+      password_reset_sent_at: Time.current
+    )
+    token
+  end
+
+  def reset_password!(token, password:)
+    with_lock do
+      validate_password_argument!(password)
+      return false unless valid_token?(
+        token,
+        password_reset_token_digest,
+        password_reset_sent_at,
+        PASSWORD_RESET_TTL
+      )
+
+      update!(
+        password: password,
+        password_reset_token_digest: nil,
+        password_reset_sent_at: nil
+      )
+      sessions.delete_all
+      true
+    end
+  end
+
+  def change_password!(password:)
+    validate_password_argument!(password)
+    transaction do
+      update!(password: password)
+      sessions.delete_all
+    end
+  end
+
+  private
+
+  def clean_up_suspension
+    sessions.delete_all
+    account.tickets.where(assignee_id: id).update_all(assignee_id: nil)
+  end
+
+  def validate_password_argument!(password)
+    return if password.present?
+
+    errors.add(:password, :blank)
+    raise ActiveRecord::RecordInvalid, self
+  end
+
+  def normalize_email
+    self.email = self.class.normalize_email(email)
+  end
+
+  def valid_token?(token, expected_digest, sent_at, ttl)
+    return false if token.blank? || expected_digest.blank? || sent_at.blank?
+    return false unless sent_at >= ttl.ago
+
+    ActiveSupport::SecurityUtils.secure_compare(expected_digest, Helpdesk::Tokens.digest(token))
+  end
+end
