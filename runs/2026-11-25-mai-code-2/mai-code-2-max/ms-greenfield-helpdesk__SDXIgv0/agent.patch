+module Api
+  module V1
+    class PasswordResetsController < ApplicationController
+      before_action :set_account
+
+      def create
+        request_params = params.require(:password_reset).permit(:email)
+        email = User.normalize_email(request_params.require(:email))
+        user = current_account.users.find_by(email: email)
+
+        if user && password_reset_allowed_for?(user)
+          token = user.issue_password_reset!
+          UserMailer.password_reset(user, token).deliver_now
+        end
+
+        render json: { message: "If the address belongs to this account, a password reset link has been sent" }, status: :accepted
+      end
+
+      def confirm
+        request_params = params.require(:password_reset).permit(:token, :password)
+        token = request_params.require(:token).to_s
+        password = request_params.require(:password)
+        user = current_account.users.find_by(
+          password_reset_token_digest: Helpdesk::Tokens.digest(token)
+        )
+
+        unless user && password_reset_allowed_for?(user) && user.reset_password!(token, password: password)
+          render_error("The password reset link is invalid or has expired", status: :unprocessable_content)
+          return
+        end
+
+        render_user(user)
+      end
+
+      private
+
+      def password_reset_allowed_for?(user)
+        !current_account.cancelled? || (current_account.owned_by?(user) && current_account.reactivation_available?)
+      end
+    end
+  end
+end
