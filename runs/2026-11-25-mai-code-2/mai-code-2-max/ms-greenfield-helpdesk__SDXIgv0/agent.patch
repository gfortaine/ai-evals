diff --git a/test/integration/business_authentication_test.rb b/test/integration/business_authentication_test.rb
new file mode 100644
index 0000000..3133a90
--- /dev/null
+++ b/test/integration/business_authentication_test.rb
@@ -0,0 +1,208 @@
+require "test_helper"
+require "uri"
+
+class BusinessAuthenticationTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "signup requires verification before a user can manage their profile" do
+    create_account
+
+    assert_response :created
+    payload = json
+    assert_equal "Acme", payload.dig("account", "name")
+    assert_equal "acme", payload.dig("account", "subdomain")
+    assert payload.dig("account", "id")
+    assert payload.dig("account", "created_at")
+    assert_equal "admin", payload.dig("user", "role")
+    assert_equal false, payload.dig("user", "verified")
+    assert payload.dig("user", "id")
+    assert payload.dig("user", "created_at")
+
+    assert_equal [ "support@example.test" ], ActionMailer::Base.deliveries.last.from
+    assert_match %r{http://localhost:3001/verify-email\?account=acme&token=}, mail_text(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/sessions", params: login_payload, headers: account_headers, as: :json
+    assert_response :forbidden
+
+    verify_email_from(ActionMailer::Base.deliveries.last)
+    assert_response :success
+    assert_equal true, json.dig("user", "verified")
+
+    post "/api/v1/sessions", params: login_payload, headers: account_headers, as: :json
+    assert_response :success
+    token = json.dig("session", "token")
+    assert token.present?
+    assert_equal "acme", json.dig("account", "subdomain")
+
+    get "/api/v1/me", headers: authenticated_headers(token)
+    assert_response :success
+
+    patch "/api/v1/me", params: { user: { name: "Jo Smith" } }, headers: authenticated_headers(token), as: :json
+    assert_response :success
+    assert_equal "Jo Smith", json.dig("user", "name")
+
+    put "/api/v1/me/password", params: {
+      password_change: {
+        current_password: "my-first-password",
+        password: "my-new-password"
+      }
+    }, headers: authenticated_headers(token), as: :json
+
+    assert_response :success
+    assert_equal 0, User.find_by!(email: "jo@acme.test").sessions.count
+
+    get "/api/v1/me", headers: authenticated_headers(token)
+    assert_response :unauthorized
+  end
+
+  test "requesting new verification and reset links invalidates old links" do
+    create_account
+    first_verification_mail = ActionMailer::Base.deliveries.last
+
+    post "/api/v1/email_verifications", params: {
+      email_verification: { email: "jo@acme.test" }
+    }, headers: account_headers, as: :json
+    assert_response :accepted
+    second_verification_mail = ActionMailer::Base.deliveries.last
+
+    confirm_mail(first_verification_mail)
+    assert_response :unprocessable_content
+    confirm_mail(second_verification_mail)
+    assert_response :success
+
+    post "/api/v1/sessions", params: login_payload, headers: account_headers, as: :json
+    token = json.dig("session", "token")
+
+    post "/api/v1/password_resets", params: {
+      password_reset: { email: "jo@acme.test" }
+    }, headers: account_headers, as: :json
+    first_reset_mail = ActionMailer::Base.deliveries.last
+
+    post "/api/v1/password_resets", params: {
+      password_reset: { email: "jo@acme.test" }
+    }, headers: account_headers, as: :json
+    second_reset_mail = ActionMailer::Base.deliveries.last
+
+    confirm_mail(first_reset_mail, password: "replacement-one")
+    assert_response :unprocessable_content
+    confirm_mail(second_reset_mail, password: "replacement-one")
+    assert_response :success
+
+    get "/api/v1/me", headers: authenticated_headers(token)
+    assert_response :unauthorized
+
+    post "/api/v1/sessions", params: {
+      session: { email: "jo@acme.test", password: "replacement-one" }
+    }, headers: account_headers, as: :json
+    assert_response :success
+  end
+
+  test "the owner can reactivate a recently cancelled account but old sessions cannot be reused" do
+    create_account
+    verify_email_from(ActionMailer::Base.deliveries.last)
+    post "/api/v1/sessions", params: login_payload, headers: account_headers, as: :json
+    old_token = json.dig("session", "token")
+
+    post "/api/v1/account/cancel", headers: authenticated_headers(old_token), as: :json
+    assert_response :success
+    assert json.dig("account", "cancelled")
+    assert_equal 0, Session.count
+
+    get "/api/v1/portal", headers: account_headers
+    assert_response :forbidden
+
+    post "/api/v1/sessions", params: login_payload, headers: account_headers, as: :json
+    assert_response :success
+    reactivation_token = json.dig("session", "token")
+
+    post "/api/v1/account/reactivate", headers: authenticated_headers(reactivation_token), as: :json
+    assert_response :success
+    assert_equal false, json.dig("account", "cancelled")
+
+    get "/api/v1/portal", headers: account_headers
+    assert_response :success
+    assert_equal({ "name" => "Acme", "subdomain" => "acme" }, json["portal"])
+
+    get "/api/v1/account", headers: authenticated_headers(old_token)
+    assert_response :unauthorized
+  end
+
+  test "email addresses are scoped to accounts and the frontend origin is allowed" do
+    create_account
+    post "/api/v1/account/create", params: signup_payload(
+      subdomain: "other",
+      account_name: "Other"
+    ), headers: { "Content-Type" => "application/json" }, as: :json
+    assert_response :created
+
+    assert_equal 2, User.where(email: "jo@acme.test").count
+
+    get "/api/v1/portal",
+      headers: { "X-Helpdesk-Account" => "acme", "Origin" => "http://localhost:3001" }
+    assert_response :success
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+  end
+
+  private
+
+  def create_account
+    post "/api/v1/account/create", params: signup_payload, headers: { "Content-Type" => "application/json" }, as: :json
+  end
+
+  def signup_payload(subdomain: "acme", account_name: "Acme")
+    {
+      account: {
+        name: account_name,
+        subdomain: subdomain,
+        admin: {
+          name: "Jo",
+          email: "jo@acme.test",
+          password: "my-first-password"
+        }
+      }
+    }
+  end
+
+  def login_payload
+    { session: { email: "jo@acme.test", password: "my-first-password" } }
+  end
+
+  def account_headers
+    { "X-Helpdesk-Account" => "acme" }
+  end
+
+  def authenticated_headers(token)
+    account_headers.merge("Authorization" => "Bearer #{token}")
+  end
+
+  def confirm_mail(mail, password: nil)
+    path = if password
+      "/api/v1/password_resets/confirm"
+    else
+      "/api/v1/email_verifications/confirm"
+    end
+    envelope = password ? :password_reset : :email_verification
+    body = password ? { token: token_from(mail), password: password } : { token: token_from(mail) }
+
+    post path, params: { envelope => body }, headers: account_headers, as: :json
+  end
+
+  def verify_email_from(mail)
+    confirm_mail(mail)
+  end
+
+  def token_from(mail)
+    url = URI.extract(mail_text(mail), %w[http https]).first
+    URI.decode_www_form(URI(url).query).to_h.fetch("token")
+  end
+
+  def mail_text(mail)
+    mail.multipart? ? mail.text_part.body.decoded : mail.body.decoded
+  end
+
+  def json
+    JSON.parse(response.body)
+  end
+end
diff --git a/test/integration/cursor_pagination_test.rb b/test/integration/cursor_pagination_test.rb
new file mode 100644
index 0000000..6916cfb
--- /dev/null
+++ b/test/integration/cursor_pagination_test.rb
@@ -0,0 +1,187 @@
+require "test_helper"
+require "uri"
+
+class CursorPaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme-cursors")
+    @owner = create_user("owner", "admin")
+    @account.update!(owner: @owner)
+    @agent = create_user("agent", "agent")
+    @customer = create_user("customer", "customer")
+    @owner_token = Session.issue_for!(@owner).last
+    @customer_token = Session.issue_for!(@customer).last
+  end
+
+  test "tickets traverse forward and backward without shifting during concurrent inserts" do
+    timestamp = 1.day.ago.change(usec: 0)
+    tickets = 3.times.map { |index| create_ticket("Ticket #{index}") }
+    tickets.each { |ticket| ticket.update_columns(updated_at: timestamp) }
+
+    statements = []
+    subscriber = lambda do |_name, _start, _finish, _id, payload|
+      statements << payload.fetch(:sql)
+    end
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      get "/api/v1/tickets", params: {
+        page: { size: 1 },
+        status: "open"
+      }, headers: owner_headers
+    end
+
+    assert_response :success
+    assert statements.none? { |statement| statement.match?(/\b(?:COUNT|OFFSET)\b/i) }
+    assert_equal [ "tickets", "meta", "links" ], json.keys
+    assert_equal [ tickets.last.id ], json.fetch("tickets").map { |ticket| ticket.fetch("id") }
+    assert_equal true, json.dig("meta", "has_more")
+    assert json.dig("meta", "after_cursor").present?
+    assert json.dig("meta", "before_cursor").present?
+    assert json.dig("links", "next").present?
+    assert_nil json.dig("links", "prev")
+
+    first_page = json
+    get follow_path(first_page.dig("links", "next")), headers: owner_headers
+
+    assert_response :success
+    assert_equal [ tickets.second.id ], json.fetch("tickets").map { |ticket| ticket.fetch("id") }
+    assert_equal true, json.dig("meta", "has_more")
+    assert json.dig("links", "next").present?
+    assert json.dig("links", "prev").present?
+    assert URI.parse(json.dig("links", "next")).query.include?("status=open")
+
+    second_page = json
+    create_ticket("Inserted while browsing")
+    get follow_path(second_page.dig("links", "next")), headers: owner_headers
+
+    assert_response :success
+    assert_equal [ tickets.first.id ], json.fetch("tickets").map { |ticket| ticket.fetch("id") }
+    assert_equal false, json.dig("meta", "has_more")
+    assert_nil json.dig("links", "next")
+
+    get follow_path(second_page.dig("links", "prev")), headers: owner_headers
+
+    assert_response :success
+    assert_equal [ tickets.last.id ], json.fetch("tickets").map { |ticket| ticket.fetch("id") }
+    assert_equal false, json.dig("meta", "has_more")
+    assert_nil json.dig("links", "prev")
+  end
+
+  test "all collection endpoints expose cursor navigation" do
+    groups = 2.times.map { |index| @account.groups.create!(name: "Group #{index}") }
+    2.times.map do |index|
+      GroupMembership.create!(group: groups[index], user: index.zero? ? @agent : @owner)
+    end
+    first_ticket = create_ticket("First")
+    second_ticket = create_ticket("Second")
+    second_ticket.update_columns(updated_at: 1.second.ago)
+    first_ticket.comments.create!(author: @customer, body: "Old comment", public: true)
+    first_ticket.comments.create!(author: @owner, body: "New comment", public: false)
+    2.times do |index|
+      invitation = @account.invitations.build(
+        email: "invite#{index}@example.test",
+        role: "agent",
+        invited_by: @owner
+      )
+      invitation.issue!
+    end
+
+    collections = [
+      [ "/api/v1/tickets", "tickets", owner_headers ],
+      [ "/api/v1/requests", "requests", customer_headers ],
+      [ "/api/v1/tickets/#{first_ticket.id}/comments", "comments", owner_headers ],
+      [ "/api/v1/requests/#{first_ticket.id}/comments", "comments", customer_headers ],
+      [ "/api/v1/users", "users", owner_headers ],
+      [ "/api/v1/staff", "staff", owner_headers ],
+      [ "/api/v1/groups", "groups", owner_headers ],
+      [ "/api/v1/group_memberships", "group_memberships", owner_headers ],
+      [ "/api/v1/invitations", "invitations", owner_headers ]
+    ]
+
+    collections.each do |path, key, headers|
+      get path, params: { page: { size: 1 } }, headers: headers
+
+      assert_response :success, path
+      assert_equal 1, json.fetch(key).length, path
+      assert_equal %w[after_cursor before_cursor has_more], json.fetch("meta").keys.sort, path
+      assert json.dig("meta", "after_cursor").present?, path
+      assert json.dig("meta", "before_cursor").present?, path
+      assert json.fetch("links").key?("next"), path
+      assert json.fetch("links").key?("prev"), path
+    end
+  end
+
+  test "cursor requests reject invalid navigation and preserve page number requests" do
+    get "/api/v1/tickets", params: { page: { size: 25 }, status: "solved" }, headers: owner_headers
+    assert_response :success
+    assert_equal [], json.fetch("tickets")
+    assert_equal({
+      "has_more" => false,
+      "after_cursor" => nil,
+      "before_cursor" => nil
+    }, json.fetch("meta"))
+    assert_equal({ "next" => nil, "prev" => nil }, json.fetch("links"))
+
+    2.times { |index| create_ticket("Ticket #{index}") }
+
+    get "/api/v1/tickets", params: { page: { after: "not-a-cursor", size: 1 } }, headers: owner_headers
+    assert_response :bad_request
+
+    get "/api/v1/tickets", params: { page: { size: 0 } }, headers: owner_headers
+    assert_response :bad_request
+
+    get "/api/v1/tickets", params: { page: { size: 1 } }, headers: owner_headers
+    cursor = json.dig("meta", "after_cursor")
+    get "/api/v1/tickets", params: { page: { after: cursor, before: cursor, size: 1 } }, headers: owner_headers
+    assert_response :bad_request
+
+    get "/api/v1/tickets", params: { page: 2, per_page: 1 }, headers: owner_headers
+    assert_response :success
+    assert_equal 2, json.fetch("count")
+    assert_equal 2, json.fetch("page")
+    assert_equal 1, json.fetch("per_page")
+    assert_equal 1, json.fetch("previous_page")
+    assert_nil json.fetch("next_page")
+    assert json.dig("meta", "before_cursor").present?
+  end
+
+  private
+
+  def create_user(handle, role)
+    @account.users.create!(
+      name: handle.capitalize,
+      email: "#{handle}@acme.test",
+      password: "secure-password",
+      role: role,
+      verified: true
+    )
+  end
+
+  def create_ticket(subject)
+    @account.tickets.create!(
+      requester: @customer,
+      subject: subject,
+      status: "open"
+    )
+  end
+
+  def owner_headers
+    {
+      "X-Helpdesk-Account" => @account.subdomain,
+      "Authorization" => "Bearer #{@owner_token}"
+    }
+  end
+
+  def customer_headers
+    {
+      "X-Helpdesk-Account" => @account.subdomain,
+      "Authorization" => "Bearer #{@customer_token}"
+    }
+  end
+
+  def follow_path(url)
+    URI.parse(url).request_uri
+  end
+
+  def json
+    JSON.parse(response.body)
+  end
+end
diff --git a/test/integration/customer_portal_test.rb b/test/integration/customer_portal_test.rb
new file mode 100644
index 0000000..1efecde
--- /dev/null
+++ b/test/integration/customer_portal_test.rb
@@ -0,0 +1,263 @@
+require "test_helper"
+require "uri"
+
+class CustomerPortalTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @owner = create_user("owner", "Owner", "admin")
+    @account.update!(owner: @owner)
+    @customer = create_user("avery", "Avery", "customer")
+    @other_customer = create_user("other", "Other Customer", "customer")
+    @owner_token = Session.issue_for!(@owner).last
+    @customer_token = Session.issue_for!(@customer).last
+    @other_customer_token = Session.issue_for!(@other_customer).last
+  end
+
+  test "portal registration creates an unverified customer who uses the existing auth flows" do
+    post "/api/v1/registrations", params: {
+      user: {
+        name: "Jordan",
+        email: "JORDAN@example.test",
+        password: "my-customer-password"
+      }
+    }, headers: account_headers, as: :json
+
+    assert_response :created
+    user = json.fetch("user")
+    assert_equal "customer", user.fetch("role")
+    assert_equal "jordan@example.test", user.fetch("email")
+    assert_equal false, user.fetch("verified")
+    assert_equal 1, ActionMailer::Base.deliveries.length
+
+    post "/api/v1/sessions", params: {
+      session: { email: "jordan@example.test", password: "my-customer-password" }
+    }, headers: account_headers, as: :json
+    assert_response :forbidden
+
+    post "/api/v1/email_verifications/confirm", params: {
+      email_verification: { token: token_from(ActionMailer::Base.deliveries.last) }
+    }, headers: account_headers, as: :json
+    assert_response :success
+
+    post "/api/v1/sessions", params: {
+      session: { email: "jordan@example.test", password: "my-customer-password" }
+    }, headers: account_headers, as: :json
+    assert_response :success
+
+    get "/api/v1/me", headers: authenticated_headers(json.dig("session", "token"))
+    assert_response :success
+    assert_equal "customer", json.dig("user", "role")
+  end
+
+  test "customer and staff can exchange a portal-only ticket conversation" do
+    post "/api/v1/requests", params: {
+      request: {
+        subject: "Cannot download my receipt",
+        comment: { body: "The download button does nothing." }
+      }
+    }, headers: customer_headers, as: :json
+
+    assert_response :created
+    request_payload = json.fetch("request")
+    assert_equal "Cannot download my receipt", request_payload.fetch("subject")
+    assert_equal "open", request_payload.fetch("status")
+    assert_equal @customer.id, request_payload.fetch("requester_id")
+    assert request_payload.fetch("created_at").present?
+    assert request_payload.fetch("updated_at").present?
+    ticket_id = request_payload.fetch("id")
+
+    get "/api/v1/tickets", headers: owner_headers
+    assert_response :success
+    assert_equal "tickets", json.keys.find { |key| key == "tickets" }
+    assert_equal 1, json.fetch("count")
+    assert_equal({
+      "id" => @customer.id,
+      "name" => "Avery",
+      "email" => "avery@acme.test"
+    }, json.fetch("tickets").first.fetch("requester"))
+
+    patch "/api/v1/tickets/#{ticket_id}", params: {
+      ticket: {
+        comment: { body: "Please try again now." },
+        status: "pending"
+      }
+    }, headers: owner_headers, as: :json
+    assert_response :success
+    assert_equal "pending", json.dig("ticket", "status")
+    assert_equal "Please try again now.", Comment.last.body
+    assert_empty ActionMailer::Base.deliveries
+
+    patch "/api/v1/requests/#{ticket_id}", params: {
+      request: { comment: { body: "It still does not work." } }
+    }, headers: customer_headers, as: :json
+    assert_response :success
+    assert_equal "open", json.dig("request", "status")
+
+    patch "/api/v1/tickets/#{ticket_id}", params: {
+      ticket: { comment: { body: "I have refreshed the portal." } }
+    }, headers: owner_headers, as: :json
+    assert_response :success
+    assert_equal "open", json.dig("ticket", "status")
+
+    patch "/api/v1/requests/#{ticket_id}", params: {
+      request: {
+        comment: { body: "The receipt downloaded. Thank you." },
+        status: "solved"
+      }
+    }, headers: customer_headers, as: :json
+    assert_response :success
+    assert_equal "solved", json.dig("request", "status")
+
+    get "/api/v1/requests/#{ticket_id}/comments", headers: customer_headers
+    assert_response :success
+    assert_equal [
+      "The download button does nothing.",
+      "Please try again now.",
+      "It still does not work.",
+      "I have refreshed the portal.",
+      "The receipt downloaded. Thank you."
+    ], json.fetch("comments").map { |comment| comment.fetch("body") }
+    assert_equal @owner.id, json.fetch("comments").second.dig("author", "id")
+    assert json.fetch("comments").all? { |comment| comment.fetch("public") == true }
+    assert json.fetch("comments").all? { |comment| comment["created_at"].present? }
+
+    get "/api/v1/tickets/#{ticket_id}", headers: owner_headers
+    assert_response :success
+    assert_equal "solved", json.dig("ticket", "status")
+  end
+
+  test "lists are customer scoped paginated and ordered by recent activity" do
+    older = create_ticket(@customer, "Older", created_at: 2.days.ago)
+    newest = create_ticket(@customer, "Newest", created_at: 1.day.ago)
+    create_ticket(@other_customer, "Someone else's", created_at: 1.hour.ago)
+
+    get "/api/v1/requests", params: { page: 1, per_page: 1 }, headers: customer_headers
+    assert_response :success
+    assert_equal 2, json.fetch("count")
+    assert_equal 1, json.fetch("page")
+    assert_equal 1, json.fetch("per_page")
+    assert_equal 2, json.fetch("next_page")
+    assert_nil json.fetch("previous_page")
+    assert_equal [ newest.id ], json.fetch("requests").map { |record| record.fetch("id") }
+
+    older.touch
+    get "/api/v1/requests", params: { page: 1, per_page: 1 }, headers: customer_headers
+    assert_equal [ older.id ], json.fetch("requests").map { |record| record.fetch("id") }
+
+    get "/api/v1/tickets", params: { page: 2, per_page: 2 }, headers: owner_headers
+    assert_response :success
+    assert_equal 3, json.fetch("count")
+    assert_equal 2, json.fetch("page")
+    assert_equal 1, json.fetch("previous_page")
+    assert_nil json.fetch("next_page")
+
+    get "/api/v1/requests/#{older.id}/comments", params: { per_page: 1 }, headers: customer_headers
+    assert_equal 1, json.fetch("count")
+    assert_equal "oldest request", json.dig("comments", 0, "body")
+  end
+
+  test "roles and request ownership are enforced and failed updates are atomic" do
+    ticket = create_ticket(@other_customer, "Private to Other")
+
+    get "/api/v1/requests/#{ticket.id}", headers: customer_headers
+    assert_response :not_found
+
+    get "/api/v1/tickets", headers: customer_headers
+    assert_response :forbidden
+
+    get "/api/v1/requests", headers: owner_headers
+    assert_response :forbidden
+
+    patch "/api/v1/requests/#{ticket.id}", params: {
+      request: { comment: { body: "Should not persist" }, status: "pending" }
+    }, headers: authenticated_headers(@other_customer_token), as: :json
+    assert_response :unprocessable_content
+    assert_equal 1, ticket.reload.comments.count
+    assert_equal "open", ticket.status
+
+    get "/api/v1/requests", params: { page: 0 }, headers: customer_headers
+    assert_response :bad_request
+  end
+
+  test "customers filter their requests by status without access to priority" do
+    open_request = create_ticket(@customer, "Open request")
+    solved_request = create_ticket(@customer, "Solved request")
+    solved_request.update!(status: "solved", priority: "high")
+
+    get "/api/v1/requests", params: { status: "solved" }, headers: customer_headers
+    assert_response :success
+    assert_equal [ solved_request.id ], json.fetch("requests").map { |record| record.fetch("id") }
+    refute json.fetch("requests").first.key?("priority")
+
+    get "/api/v1/requests/#{open_request.id}", headers: customer_headers
+    assert_response :success
+    refute json.fetch("request").key?("priority")
+
+    patch "/api/v1/requests/#{open_request.id}", params: {
+      request: { status: "solved", priority: "high" }
+    }, headers: customer_headers, as: :json
+    assert_response :success
+    assert_equal "normal", open_request.reload.priority
+    refute json.fetch("request").key?("priority")
+
+    get "/api/v1/requests", params: { status: "solved" }, headers: customer_headers
+    assert_equal 2, json.fetch("count")
+  end
+
+  private
+
+  def create_user(handle, name, role)
+    @account.users.create!(
+      name: name,
+      email: "#{handle}@acme.test",
+      password: "my-secure-password",
+      role: role,
+      verified: true
+    )
+  end
+
+  def create_ticket(requester, subject, created_at: Time.current)
+    ticket = @account.tickets.create!(
+      requester: requester,
+      subject: subject,
+      status: "open",
+      created_at: created_at,
+      updated_at: created_at
+    )
+    ticket.comments.create!(
+      author: requester,
+      body: "oldest request",
+      public: true,
+      created_at: created_at,
+      updated_at: created_at
+    )
+    ticket.update_columns(updated_at: created_at)
+    ticket
+  end
+
+  def account_headers
+    { "X-Helpdesk-Account" => "acme" }
+  end
+
+  def authenticated_headers(token)
+    account_headers.merge("Authorization" => "Bearer #{token}")
+  end
+
+  def owner_headers
+    authenticated_headers(@owner_token)
+  end
+
+  def customer_headers
+    authenticated_headers(@customer_token)
+  end
+
+  def token_from(mail)
+    url = URI.extract(mail.text_part ? mail.text_part.body.decoded : mail.body.decoded, %w[http https]).first
+    URI.decode_www_form(URI(url).query).to_h.fetch("token")
+  end
+
+  def json
+    JSON.parse(response.body)
+  end
+end
diff --git a/test/integration/email_support_test.rb b/test/integration/email_support_test.rb
new file mode 100644
index 0000000..26dac0e
--- /dev/null
+++ b/test/integration/email_support_test.rb
@@ -0,0 +1,320 @@
+require "test_helper"
+require "base64"
+require "mail"
+
+class EmailSupportTest < ActionDispatch::IntegrationTest
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  INGRESS_PASSWORD = "test-inbound-password"
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @previous_ingress_password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"]
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = INGRESS_PASSWORD
+    @account = create_account("Acme", "acme")
+  end
+
+  teardown do
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @previous_ingress_password
+  end
+
+  test "relay requires authentication and processes Cc mail before responding" do
+    customer = create_customer(@account, "avery", "Avery")
+    raw = support_mail(
+      from: customer.email,
+      to: "unrelated@example.test",
+      cc: "Acme Support <acme@support.example.test>",
+      subject: "Cannot download a receipt",
+      body: "The download button does not respond."
+    )
+
+    post RELAY_PATH, params: raw, headers: { "CONTENT_TYPE" => "message/rfc822" }
+    assert_response :unauthorized
+    assert_no_difference("Ticket.count") do
+      relay(raw, password: "wrong-password")
+      assert_response :unauthorized
+    end
+
+    relay(raw)
+    assert_response :no_content
+    ticket = Ticket.order(:id).last
+    assert_equal "Cannot download a receipt", ticket.subject
+    assert ticket.email_origin?
+    assert_equal customer, ticket.requester
+    assert_equal "The download button does not respond.", ticket.comments.first.body
+    assert ActionMailbox::InboundEmail.order(:id).last.delivered?
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "a new sender becomes an unverified customer and receives verification" do
+    raw = support_mail(
+      from: "Jordan Doe <JORDAN@EXAMPLE.TEST>",
+      to: "acme@support.example.test",
+      subject: "Billing question",
+      body: "Please update my invoice address."
+    )
+
+    relay(raw)
+    assert_response :no_content
+
+    customer = @account.users.find_by!(email: "jordan@example.test")
+    ticket = @account.tickets.find_by!(requester: customer)
+    assert customer.customer?
+    assert_not customer.verified?
+    assert ticket.email_origin?
+      assert_match(/\Areply\+[a-f0-9]{48}@support\.example\.test\z/, ticket.reply_address)
+    assert_equal 1, ActionMailer::Base.deliveries.length
+    assert_equal [ customer.email ], ActionMailer::Base.deliveries.last.to
+    assert_equal "Verify your email for Acme", ActionMailer::Base.deliveries.last.subject
+  end
+
+  test "deliveries are deduplicated by Message-ID and automated mail is ignored" do
+    customer = create_customer(@account, "avery", "Avery")
+    relay(support_mail(
+      from: customer.email,
+      to: "acme@support.example.test",
+      subject: "Duplicate test",
+      body: "First body",
+      message_id: "same-delivery@example.test"
+    ))
+    relay(support_mail(
+      from: customer.email,
+      to: "acme@support.example.test",
+      subject: "Changed subject",
+      body: "Changed body",
+      message_id: "same-delivery@example.test"
+    ))
+    relay(support_mail(
+      from: customer.email,
+      to: "acme@support.example.test",
+      subject: "Out of office",
+      body: "I am away.",
+      message_id: "automated@example.test"
+    ) { |mail| mail["Auto-Submitted"] = "auto-replied" })
+
+    assert_equal 1, @account.tickets.count
+    assert_equal 1, @account.tickets.first.comments.count
+    assert_equal [ "same-delivery@example.test" ], EmailDelivery.pluck(:message_id)
+  end
+
+  test "mail to multiple businesses is ignored and an invalid Message-ID can be retried" do
+    other = create_account("Other", "other")
+    customer = create_customer(@account, "avery", "Avery")
+    relay(support_mail(
+      from: customer.email,
+      to: "acme@support.example.test",
+      cc: "other@support.example.test",
+      subject: "Ambiguous business",
+      body: "Which business?",
+      message_id: "retryable@example.test"
+    ))
+    assert_equal 0, @account.tickets.count
+    assert_equal 0, other.tickets.count
+    assert_equal 0, ActionMailbox::InboundEmail.count
+
+    relay(support_mail(
+      from: customer.email,
+      to: "acme@support.example.test",
+      subject: "Ambiguous business",
+      body: "Only Acme should receive this.",
+      message_id: "retryable@example.test"
+    ))
+    assert_equal 1, @account.tickets.count
+  end
+
+  test "the same invalid raw delivery can succeed after its recipient becomes valid" do
+    raw = support_mail(
+      from: "new@example.test",
+      to: "later@support.example.test",
+      subject: "Delayed account activation",
+      body: "Please open this after setup.",
+      message_id: "delayed@example.test"
+    )
+    relay(raw)
+    assert_equal 0, Ticket.count
+    assert_equal 0, ActionMailbox::InboundEmail.count
+
+    later = create_account("Later", "later")
+    relay(raw)
+    assert_equal 1, later.tickets.count
+    assert_equal "Delayed account activation", later.tickets.first.subject
+  end
+
+  test "only the requester can add email replies and replies reopen pending or solved tickets" do
+    customer = create_customer(@account, "avery", "Avery")
+    ticket = email_ticket_for(customer)
+    ticket.update!(status: "pending")
+
+    relay(support_mail(
+      from: "attacker@example.test",
+      to: ticket.reply_address,
+      subject: "Re: #{ticket.subject}",
+      body: "Unauthorized reply",
+      message_id: "wrong-requester@example.test"
+    ))
+    assert_equal 1, ticket.comments.count
+    assert_equal "pending", ticket.reload.status
+
+    relay(support_mail(
+      from: customer.email,
+      to: ticket.reply_address,
+      subject: "Re: #{ticket.subject}",
+      body: "Here is the requested detail.",
+      message_id: "valid-reply@example.test"
+    ))
+    assert_equal 2, ticket.reload.comments.count
+    assert_equal "open", ticket.status
+    assert_equal "Here is the requested detail.", ticket.comments.order(:id).last.body
+
+    ticket.update!(status: "solved")
+    relay(support_mail(
+      from: customer.email,
+      to: ticket.reply_address,
+      subject: "Re: #{ticket.subject}",
+      body: "One more thing",
+      message_id: "solved-reply@example.test"
+    ))
+    assert_equal "open", ticket.reload.status
+
+    relay(support_mail(
+      from: customer.email,
+      to: "acme@support.example.test",
+      subject: "Re: #{ticket.subject}",
+      body: "A new message to the public address",
+      message_id: "plain-address@example.test",
+      in_reply_to: "original@example.test"
+    ))
+    assert_equal 2, @account.tickets.count
+  end
+
+  test "staff public replies are emailed but private notes are not" do
+    customer = create_customer(@account, "avery", "Avery")
+    agent = @account.users.create!(
+      name: "Agent",
+      email: "agent@acme.test",
+      password: "secure-password",
+      role: "agent",
+      verified: true
+    )
+    token = Session.issue_for!(agent).last
+    ticket = email_ticket_for(customer)
+    ActionMailer::Base.deliveries.clear
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { comment: { body: "We can help with that." } } },
+      headers: authenticated_headers(token),
+      as: :json
+    assert_response :success
+
+    outgoing = ActionMailer::Base.deliveries.last
+    assert_equal [ customer.email ], outgoing.to
+    assert_equal [ ticket.reply_address ], outgoing.reply_to
+    assert_equal [ ticket.reply_address ], outgoing.from
+    assert_equal "Re: #{ticket.subject}", outgoing.subject
+    assert_match "We can help with that.", mail_text(outgoing)
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { comment: { body: "Internal only", public: false } } },
+      headers: authenticated_headers(token),
+      as: :json
+    assert_response :success
+    assert_equal 1, ActionMailer::Base.deliveries.length
+  end
+
+  test "email replies to a merged source are ignored" do
+    customer = create_customer(@account, "avery", "Avery")
+    staff = @account.users.create!(
+      name: "Owner",
+      email: "owner@acme.test",
+      password: "secure-password",
+      role: "admin",
+      verified: true
+    )
+    source = email_ticket_for(customer)
+    target = @account.tickets.create!(requester: customer, subject: "Original email request")
+    target.comments.create!(author: customer, body: "Original conversation", public: true)
+
+    post "/api/v1/tickets/#{source.id}/merge",
+      params: { merge: { target_id: target.id } },
+      headers: authenticated_headers(Session.issue_for!(staff).last),
+      as: :json
+    assert_response :success
+    source.reload
+    assert_equal "closed", source.status
+    original_comment_count = source.comments.count
+    ActionMailer::Base.deliveries.clear
+
+    relay(support_mail(
+      from: customer.email,
+      to: source.reply_address,
+      subject: "Re: #{source.subject}",
+      body: "Reply that should not reopen the duplicate",
+      message_id: "closed-merged-reply@example.test"
+    ))
+
+    assert_equal "closed", source.reload.status
+    assert_equal original_comment_count, source.comments.count
+    refute EmailDelivery.exists?(message_id: "closed-merged-reply@example.test")
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  private
+
+  def relay(raw, password: INGRESS_PASSWORD)
+    credentials = Base64.strict_encode64("actionmailbox:#{password}")
+    post RELAY_PATH,
+      params: raw,
+      headers: {
+        "CONTENT_TYPE" => "message/rfc822",
+        "HTTP_AUTHORIZATION" => "Basic #{credentials}"
+      }
+  end
+
+  def support_mail(from:, to:, subject:, body:, cc: nil, message_id: nil, in_reply_to: nil)
+    mail = Mail.new
+    mail.from = from
+    mail.to = to
+    mail.cc = cc if cc
+    mail.subject = subject
+    mail.body = body
+    mail.content_type = "text/plain; charset=UTF-8"
+    mail.message_id = message_id || "#{SecureRandom.hex(16)}@example.test"
+    mail.in_reply_to = in_reply_to if in_reply_to
+    yield mail if block_given?
+    mail.to_s
+  end
+
+  def email_ticket_for(customer)
+    relay(support_mail(
+      from: customer.email,
+      to: "#{@account.subdomain}@support.example.test",
+      subject: "Email-originated request",
+      body: "The initial email body."
+    ))
+    @account.tickets.order(:id).last
+  end
+
+  def create_account(name, subdomain)
+    Account.create!(name: name, subdomain: subdomain)
+  end
+
+  def create_customer(account, handle, name)
+    account.users.create!(
+      name: name,
+      email: "#{handle}@example.test",
+      password: "secure-password",
+      role: "customer",
+      verified: true
+    )
+  end
+
+  def authenticated_headers(token)
+    {
+      "X-Helpdesk-Account" => @account.subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+
+  def mail_text(mail)
+    mail.multipart? ? mail.text_part.body.decoded : mail.body.decoded
+  end
+end
diff --git a/test/integration/group_management_test.rb b/test/integration/group_management_test.rb
new file mode 100644
index 0000000..b2886de
--- /dev/null
+++ b/test/integration/group_management_test.rb
@@ -0,0 +1,239 @@
+require "test_helper"
+
+class GroupManagementTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @owner = create_user("owner", "Owner", "admin")
+    @account.update!(owner: @owner)
+    @agent = create_user("agent", "Agent", "agent")
+    @other_agent = create_user("other-agent", "Other Agent", "member")
+    @customer = create_user("customer", "Customer", "customer")
+    @owner_token = Session.issue_for!(@owner).last
+    @agent_token = Session.issue_for!(@agent).last
+    @customer_token = Session.issue_for!(@customer).last
+  end
+
+  test "admins manage groups while staff can browse them" do
+    billing = post_group("Billing").then { Group.find(json.dig("group", "id")) }
+    support = post_group("Support").then { Group.find(json.dig("group", "id")) }
+
+    post "/api/v1/groups", params: { group: { name: "Forbidden" } }, headers: agent_headers, as: :json
+    assert_response :forbidden
+
+    get "/api/v1/groups", headers: agent_headers
+    assert_response :success
+    assert_equal [ billing.id, support.id ], json.fetch("groups").map { |group| group.fetch("id") }
+
+    get "/api/v1/groups/#{billing.id}", headers: agent_headers
+    assert_response :success
+    assert_equal "Billing", json.dig("group", "name")
+
+    patch "/api/v1/groups/#{billing.id}", params: {
+      group: { name: "Accounts Receivable" }
+    }, headers: owner_headers, as: :json
+    assert_response :success
+    assert_equal "Accounts Receivable", json.dig("group", "name")
+
+    get "/api/v1/groups", headers: customer_headers
+    assert_response :forbidden
+
+    delete "/api/v1/groups/#{billing.id}", headers: owner_headers
+    assert_response :no_content
+    refute Group.exists?(billing.id)
+  end
+
+  test "admins manage memberships and exactly one membership stays the default" do
+    billing = @account.groups.create!(name: "Billing")
+    support = @account.groups.create!(name: "Technical Support")
+
+    post "/api/v1/group_memberships", params: {
+      group_membership: { group_id: billing.id, user_id: @agent.id, default: false }
+    }, headers: owner_headers, as: :json
+    assert_response :created
+    first = GroupMembership.find(json.dig("group_membership", "id"))
+    assert_predicate first.reload, :default?
+
+    post "/api/v1/group_memberships", params: {
+      group_membership: { group_id: support.id, user_id: @agent.id, default: true }
+    }, headers: owner_headers, as: :json
+    assert_response :created
+    second = GroupMembership.find(json.dig("group_membership", "id"))
+    refute_predicate first.reload, :default?
+    assert_predicate second.reload, :default?
+
+    post "/api/v1/group_memberships", params: {
+      group_membership: { group_id: billing.id, user_id: @other_agent.id }
+    }, headers: owner_headers, as: :json
+    assert_response :created
+    other_membership = GroupMembership.find(json.dig("group_membership", "id"))
+
+    get "/api/v1/group_memberships", params: { user_id: @agent.id }, headers: agent_headers
+    assert_response :success
+    assert_equal [ first.id, second.id ], json.fetch("group_memberships").map { |membership| membership.fetch("id") }
+
+    get "/api/v1/group_memberships", params: { group_id: billing.id }, headers: agent_headers
+    assert_response :success
+    assert_equal [ first.id, other_membership.id ], json.fetch("group_memberships").map { |membership| membership.fetch("id") }
+
+    put "/api/v1/group_memberships/#{first.id}/make_default", headers: owner_headers
+    assert_response :success
+    assert_predicate first.reload, :default?
+    refute_predicate second.reload, :default?
+
+    delete "/api/v1/group_memberships/#{first.id}", headers: owner_headers
+    assert_response :no_content
+    assert_predicate second.reload, :default?
+
+    overflow = @account.groups.create!(name: "Overflow")
+    replacement = GroupMembership.create!(group: overflow, user: @agent)
+    delete "/api/v1/groups/#{support.id}", headers: owner_headers
+    assert_response :no_content
+    assert_predicate replacement.reload, :default?
+
+    post "/api/v1/group_memberships", params: {
+      group_membership: { group_id: overflow.id, user_id: @customer.id }
+    }, headers: owner_headers, as: :json
+    assert_response :unprocessable_content
+  end
+
+  test "ticket groups and assignments stay consistent through changes and deletion" do
+    billing = @account.groups.create!(name: "Billing")
+    support = @account.groups.create!(name: "Technical Support")
+    @account.groups.create!(name: "Other")
+    agent_billing = GroupMembership.create!(group: billing, user: @agent, default: true)
+    GroupMembership.create!(group: support, user: @agent)
+    GroupMembership.create!(group: billing, user: @other_agent)
+    ticket = create_ticket
+
+    patch "/api/v1/tickets/#{ticket.id}", params: {
+      ticket: { assignee_id: @agent.id }
+    }, headers: agent_headers, as: :json
+    assert_response :success
+    assert_equal billing.id, ticket.reload.group_id
+    assert_equal({ "id" => billing.id, "name" => "Billing" }, json.dig("ticket", "group"))
+
+    patch "/api/v1/tickets/#{ticket.id}", params: {
+      ticket: { group_id: support.id }
+    }, headers: agent_headers, as: :json
+    assert_response :success
+    assert_equal support.id, ticket.reload.group_id
+    assert_equal @agent.id, ticket.assignee_id
+
+    billing_ticket = create_ticket(group: billing, assignee: @other_agent)
+    patch "/api/v1/tickets/#{billing_ticket.id}", params: {
+      ticket: { group_id: support.id }
+    }, headers: agent_headers, as: :json
+    assert_response :success
+    assert_equal support.id, billing_ticket.reload.group_id
+    assert_nil billing_ticket.assignee_id
+
+    patch "/api/v1/tickets/#{billing_ticket.id}", params: {
+      ticket: { assignee_id: @agent.id }
+    }, headers: agent_headers, as: :json
+    assert_response :success
+    patch "/api/v1/tickets/#{billing_ticket.id}", params: {
+      ticket: { assignee_id: nil }
+    }, headers: agent_headers, as: :json
+    assert_response :success
+    assert_equal support.id, billing_ticket.reload.group_id
+
+    patch "/api/v1/tickets/#{billing_ticket.id}", params: {
+      ticket: { assignee_id: @agent.id }
+    }, headers: agent_headers, as: :json
+    assert_response :success
+    patch "/api/v1/tickets/#{billing_ticket.id}", params: {
+      ticket: { group_id: nil }
+    }, headers: agent_headers, as: :json
+    assert_response :success
+    assert_nil billing_ticket.reload.group_id
+    assert_nil billing_ticket.assignee_id
+
+    invalid_update = create_ticket(group: support)
+    patch "/api/v1/tickets/#{invalid_update.id}", params: {
+      ticket: { assignee_id: @other_agent.id }
+    }, headers: agent_headers, as: :json
+    assert_response :unprocessable_content
+    assert_nil invalid_update.reload.assignee_id
+
+    ungrouped = create_ticket
+    get "/api/v1/tickets", params: { group_id: support.id }, headers: agent_headers
+    assert_response :success
+    assert_includes json.fetch("tickets").map { |record| record.fetch("id") }, ticket.id
+
+    get "/api/v1/tickets", params: { group_id: "unassigned" }, headers: agent_headers
+    assert_response :success
+    assert_includes json.fetch("tickets").map { |record| record.fetch("id") }, ungrouped.id
+
+    assigned = create_ticket(group: billing, assignee: @other_agent)
+    billing_membership = GroupMembership.find_by!(group: billing, user: @other_agent)
+    billing_membership.destroy!
+    assert_nil assigned.reload.assignee_id
+
+    group_ticket = create_ticket(group: support, assignee: @agent)
+    support.destroy!
+    assert_nil group_ticket.reload.group_id
+    assert_nil group_ticket.assignee_id
+    assert_predicate agent_billing.reload, :default?
+  end
+
+  test "suspension keeps group memberships" do
+    billing = @account.groups.create!(name: "Billing")
+    membership = GroupMembership.create!(group: billing, user: @agent)
+
+    patch "/api/v1/users/#{@agent.id}", params: {
+      user: { suspended: true }
+    }, headers: owner_headers, as: :json
+    assert_response :success
+    assert GroupMembership.exists?(membership.id)
+    assert_predicate membership.reload, :default?
+  end
+
+  private
+
+  def post_group(name)
+    post "/api/v1/groups", params: { group: { name: name } }, headers: owner_headers, as: :json
+    assert_response :created
+  end
+
+  def create_user(handle, name, role)
+    @account.users.create!(
+      name: name,
+      email: "#{handle}@acme.test",
+      password: "secure-password",
+      role: role,
+      verified: true
+    )
+  end
+
+  def create_ticket(group: nil, assignee: nil)
+    @account.tickets.create!(
+      requester: @customer,
+      subject: "Need help",
+      group: group,
+      assignee: assignee
+    )
+  end
+
+  def owner_headers
+    authenticated_headers(@owner_token)
+  end
+
+  def agent_headers
+    authenticated_headers(@agent_token)
+  end
+
+  def customer_headers
+    authenticated_headers(@customer_token)
+  end
+
+  def authenticated_headers(token)
+    {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+
+  def json
+    JSON.parse(response.body)
+  end
+end
