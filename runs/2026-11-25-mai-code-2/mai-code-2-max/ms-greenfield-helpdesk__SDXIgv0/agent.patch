diff --git a/app/controllers/api/v1/tickets_controller.rb b/app/controllers/api/v1/tickets_controller.rb
new file mode 100644
index 0000000..9b58fc1
--- /dev/null
+++ b/app/controllers/api/v1/tickets_controller.rb
@@ -0,0 +1,207 @@
+module Api
+  module V1
+    class TicketsController < ApplicationController
+      before_action :set_account
+      before_action :authenticate_user!
+      before_action :require_active_account
+      before_action :require_staff!
+      before_action :set_ticket, only: %i[show comments merge update]
+
+      def index
+        status = params[:status].presence
+        if status && !Ticket::STATUSES.include?(status)
+          render_error("Invalid ticket status", status: :unprocessable_content)
+          return
+        end
+
+        priority = params[:priority].presence
+        if priority && !Ticket::PRIORITIES.include?(priority)
+          render_error("Invalid ticket priority", status: :unprocessable_content)
+          return
+        end
+
+        assignee_id = params[:assignee_id].presence
+        assignee_id = person_filter_id!(:assignee_id) if assignee_id && assignee_id != "unassigned"
+        requester_id = person_filter_id!(:requester_id)
+        group_id = params[:group_id].presence
+        group_id = person_filter_id!(:group_id) if group_id && group_id != "unassigned"
+
+        tickets = current_account.tickets.includes(:requester, :assignee, :group)
+        tickets = tickets.where(status: status) if status
+        tickets = tickets.where(priority: priority) if priority
+        if assignee_id == "unassigned"
+          tickets = tickets.where(assignee_id: nil)
+        elsif assignee_id
+          tickets = tickets.where(assignee_id: assignee_id)
+        end
+        tickets = tickets.where(requester_id: requester_id) if requester_id
+        if group_id == "unassigned"
+          tickets = tickets.where(group_id: nil)
+        elsif group_id
+          tickets = tickets.where(group_id: group_id)
+        end
+        tickets = tickets.search_text(params[:q]) if params[:q].present?
+
+        render_paginated(
+          tickets.recent_first,
+          key: :tickets,
+          serializer: ->(ticket) { TicketSerializer.new(ticket, include_requester: true) },
+          cursor_order: { updated_at: :desc, id: :desc }
+        )
+      end
+
+      def show
+        render json: { ticket: TicketSerializer.new(@ticket, include_requester: true) }
+      end
+
+      def comments
+        comments = @ticket.comments.includes(:author).oldest_first
+        render_paginated(
+          comments,
+          key: :comments,
+          serializer: ->(comment) { CommentSerializer.new(comment) },
+          cursor_order: { created_at: :asc, id: :asc }
+        )
+      end
+
+      def merge
+        attributes = params.require(:merge).permit(
+          :target_id,
+          source_comment: %i[body public],
+          target_comment: %i[body public]
+        )
+        target_id = positive_integer!(attributes.require(:target_id), name: :target_id)
+        source_comment = merge_note_attributes(
+          attributes,
+          :source_comment,
+          default_body: "Merged into ticket ##{target_id}."
+        )
+        target_comment = merge_note_attributes(
+          attributes,
+          :target_comment,
+          default_body: "Merged from ticket ##{@ticket.id}."
+        )
+
+        result = Helpdesk::TicketMerger.new(
+          account: current_account,
+          source: @ticket,
+          target_id: target_id,
+          actor: current_user,
+          source_comment: source_comment,
+          target_comment: target_comment
+        ).call
+
+        render json: {
+          source: TicketSerializer.new(result.source, include_requester: true),
+          target: TicketSerializer.new(result.target, include_requester: true)
+        }
+      end
+
+      def update
+        attributes = params.require(:ticket).permit(:status, :assignee_id, :group_id, :priority, comment: %i[body public])
+        unless attributes.key?(:status) || attributes.key?(:assignee_id) || attributes.key?(:group_id) || attributes.key?(:priority) || attributes.key?(:comment)
+          render_error("At least a comment, status, assignee, group, or priority is required", status: :unprocessable_content)
+          return
+        end
+
+        public_comment = public_comment?(attributes) if attributes.key?(:comment)
+        created_comment = nil
+
+        Ticket.transaction do
+          @ticket.lock!
+          @ticket.ensure_editable!
+          if attributes.key?(:comment)
+            comment_attributes = attributes.require(:comment)
+            created_comment = @ticket.comments.create!(
+              author: current_user,
+              body: comment_attributes.require(:body),
+              public: public_comment
+            )
+          end
+
+          @ticket.assign_attributes(status: attributes[:status]) if attributes.key?(:status)
+          @ticket.group = resolve_group(attributes[:group_id]) if attributes.key?(:group_id)
+          if attributes.key?(:group_id) && attributes[:group_id].nil?
+            @ticket.assignee = nil
+          elsif attributes.key?(:assignee_id)
+            @ticket.assignee = resolve_assignee(attributes[:assignee_id])
+          end
+          @ticket.priority = attributes[:priority] if attributes.key?(:priority)
+          if @ticket.has_changes_to_save?
+            customer_activity = attributes.key?(:status) || public_comment
+            @ticket.save!(touch: customer_activity)
+          end
+        end
+
+        @ticket.reload
+        if created_comment&.public? && @ticket.email_origin?
+          TicketMailer.staff_reply(@ticket, created_comment).deliver_now
+        end
+
+        render json: { ticket: TicketSerializer.new(@ticket, include_requester: true) }
+      end
+
+      private
+
+      def set_ticket
+        @ticket = current_account.tickets.includes(:requester, :assignee, :group).find(params[:id])
+      end
+
+      def resolve_group(id)
+        return if id.nil?
+
+        current_account.groups.find(id)
+      end
+
+      def resolve_assignee(id)
+        return if id.nil?
+
+        assignee = current_account.users.find_by(id: id)
+        unless assignee&.active_staff?
+          @ticket.errors.add(:assignee, "must be active staff in this account")
+          raise ActiveRecord::RecordInvalid, @ticket
+        end
+        assignee
+      end
+
+      def person_filter_id!(name)
+        value = params[name]
+        return if value.blank?
+
+        positive_integer!(value, name: name)
+      end
+
+      def public_comment?(attributes)
+        return false unless attributes.key?(:comment)
+
+        comment = attributes.require(:comment)
+        return true unless comment.key?(:public)
+
+        boolean_value!(comment[:public], name: :public)
+      end
+
+      def positive_integer!(value, name:)
+        integer = Integer(value.to_s, 10)
+        raise ArgumentError unless integer.positive?
+
+        integer
+      rescue ArgumentError, TypeError
+        raise ActionController::BadRequest, "#{name} must be a positive integer"
+      end
+
+      def merge_note_attributes(attributes, key, default_body:)
+        return { body: default_body, public: false } unless attributes.key?(key)
+
+        note = attributes[key]
+        unless note.is_a?(ActionController::Parameters)
+          raise ActionController::BadRequest, "#{key} must be an object"
+        end
+
+        {
+          body: note.key?(:body) ? note[:body] : default_body,
+          public: note.key?(:public) ? boolean_value!(note[:public], name: :public) : false
+        }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/users_controller.rb b/app/controllers/api/v1/users_controller.rb
new file mode 100644
index 0000000..72ab0fd
--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,90 @@
+module Api
+  module V1
+    class UsersController < ApplicationController
+      before_action :set_account
+      before_action :authenticate_user!
+      before_action :require_active_account
+      before_action :require_admin!, only: :index
+      before_action :require_admin_for_user!, only: %i[show update]
+      before_action :set_user, only: %i[show update], if: -> { params[:id].present? }
+
+      def index
+        users = current_account.users
+        role = params[:role].presence
+        if role
+          unless User::ROLES.include?(role)
+            render_error("Invalid user role", status: :unprocessable_content)
+            return
+          end
+          users = users.where(role: role)
+        end
+        if params.key?(:suspended)
+          users = users.where(suspended: boolean_value!(params[:suspended], name: :suspended))
+        end
+
+        render_paginated(
+          users.order(:id),
+          key: :users,
+          serializer: ->(user) { UserSerializer.new(user) },
+          cursor_order: { id: :asc }
+        )
+      end
+
+      def show
+        render_user(@user || current_user)
+      end
+
+      def update
+        return update_profile unless params[:id].present?
+
+        attributes = params.require(:user).permit(:suspended)
+        unless attributes.key?(:suspended)
+          render_error("Invalid or missing parameter: suspended", status: :unprocessable_content, errors: {
+            suspended: [ "is required" ]
+          })
+          return
+        end
+
+        suspended = boolean_value!(attributes[:suspended], name: :suspended)
+        current_account.with_lock do
+          @user.lock!
+          prevent_last_admin_suspension! if suspended && !@user.suspended?
+          @user.update!(suspended: suspended)
+        end
+
+        render_user(@user.reload)
+      end
+
+      private
+
+      def update_profile
+        attributes = params.require(:user).permit(:name)
+        unless attributes.key?(:name)
+          render_error("Invalid or missing parameter: name", status: :unprocessable_content, errors: {
+            name: [ "is required" ]
+          })
+          return
+        end
+
+        current_user.update!(attributes)
+        render_user
+      end
+
+      def require_admin_for_user!
+        require_admin! if params[:id].present?
+      end
+
+      def set_user
+        @user = current_account.users.find(params[:id])
+      end
+
+      def prevent_last_admin_suspension!
+        return unless @user.admin?
+        return if current_account.users.where(role: "admin", suspended: false, verified: true).where.not(id: @user.id).exists?
+
+        @user.errors.add(:suspended, "cannot suspend the last active administrator")
+        raise ActiveRecord::RecordInvalid, @user
+      end
+    end
+  end
+end
diff --git a/app/controllers/application_controller.rb b/app/controllers/application_controller.rb
new file mode 100644
index 0000000..0591481
--- /dev/null
+++ b/app/controllers/application_controller.rb
@@ -0,0 +1,232 @@
+class ApplicationController < ActionController::API
+  ACCOUNT_HEADER = "X-Helpdesk-Account"
+
+  rescue_from ActionController::BadRequest, with: :render_bad_request_error
+  rescue_from Helpdesk::CursorPaginator::InvalidCursor, with: :render_bad_request_error
+  rescue_from ActionController::ParameterMissing, with: :render_parameter_error
+  rescue_from ActiveRecord::RecordInvalid, with: :render_record_error
+  rescue_from ActiveRecord::RecordNotUnique, with: :render_conflict_error
+  rescue_from ActiveRecord::RecordNotFound, with: :render_not_found_error
+
+  private
+
+  attr_reader :current_account, :current_session, :current_user
+
+  def set_account
+    subdomain = request.headers[ACCOUNT_HEADER].to_s.strip.downcase
+    if subdomain.blank?
+      render_error("#{ACCOUNT_HEADER} header is required", status: :bad_request)
+      return
+    end
+
+    @current_account = Account.find_by(subdomain: subdomain)
+    render_error("Account not found", status: :not_found) unless @current_account
+  end
+
+  def require_active_account
+    return unless current_account&.cancelled?
+
+    render_error("Account is cancelled", status: :forbidden)
+  end
+
+  def authenticate_user!
+    token = bearer_token
+    unless token
+      render_error("A valid bearer token is required", status: :unauthorized)
+      return
+    end
+
+    @current_session = Session.includes(user: :account).find_by_token(token)
+    user = current_session&.user
+
+    unless user && user.account_id == current_account.id && user.verified? && !user.suspended?
+      render_error("Invalid or expired session", status: :unauthorized)
+      return
+    end
+
+    @current_user = user
+  end
+
+  def require_owner!
+    return if current_account.owned_by?(current_user)
+
+    render_error("Only the account owner may perform this action", status: :forbidden)
+  end
+
+  def require_admin!
+    return if current_user.admin?
+
+    render_error("Only administrators may perform this action", status: :forbidden)
+  end
+
+  def require_customer!
+    return if current_user.customer?
+
+    render_error("Only customers may perform this action", status: :forbidden)
+  end
+
+  def require_staff!
+    return if current_user.staff?
+
+    render_error("Only staff may perform this action", status: :forbidden)
+  end
+
+  def bearer_token
+    authorization = request.headers["Authorization"].to_s
+    match = authorization.match(/\ABearer\s+(\S+)\z/i)
+    match[1] if match && match[1].bytesize <= 2048
+  end
+
+  def find_invitation_by_token(token)
+    invitation = Invitation.includes(:account).find_by(token_digest: Helpdesk::Tokens.digest(token))
+    requested_account = request.headers[ACCOUNT_HEADER].to_s.strip.downcase
+    return if requested_account.present? && invitation && invitation.account.subdomain != requested_account
+
+    invitation
+  end
+
+  def boolean_value!(value, name:)
+    return true if value == true || value.to_s == "true" || value.to_s == "1"
+    return false if value == false || value.to_s == "false" || value.to_s == "0"
+
+    raise ActionController::BadRequest, "#{name} must be true or false"
+  end
+
+  def render_account(account = current_account, status: :ok)
+    render json: { account: AccountSerializer.new(account) }, status: status
+  end
+
+  def render_user(user = current_user, status: :ok)
+    render json: { user: UserSerializer.new(user) }, status: status
+  end
+
+  def render_paginated(relation, key:, serializer:, cursor_order:)
+    paginator = Helpdesk::CursorPaginator.new(
+      relation: relation,
+      order: cursor_order,
+      scope: "#{request.path}::#{key}::#{current_account.id}"
+    )
+
+    if params[:page].is_a?(ActionController::Parameters)
+      render_cursor_paginated(paginator, key: key, serializer: serializer)
+    else
+      render_offset_paginated(relation, paginator, key: key, serializer: serializer)
+    end
+  end
+
+  def render_cursor_paginated(paginator, key:, serializer:)
+    page = params[:page]
+    if page.key?(:after) && page.key?(:before)
+      raise ActionController::BadRequest, "page[after] and page[before] cannot be used together"
+    end
+
+    after_cursor = cursor_parameter(page, :after)
+    before_cursor = cursor_parameter(page, :before)
+    size_default = params.key?(:per_page) ? params[:per_page] : 25
+    size = positive_integer_value(page.fetch(:size, size_default), name: "page[size]")
+    result = paginator.paginate(size: size, after: after_cursor, before: before_cursor)
+
+    render json: {
+      key => result.records.map { |record| serializer.call(record) },
+      meta: pagination_meta(result),
+      links: pagination_links(result, size: size)
+    }
+  end
+
+  def render_offset_paginated(relation, paginator, key:, serializer:)
+    page = pagination_value(:page, default: 1)
+    per_page = pagination_value(:per_page, default: 25)
+    count = relation.count
+    records = relation.offset((page - 1) * per_page).limit(per_page).to_a
+    has_after = page * per_page < count
+    has_before = page > 1
+    navigation = paginator.offset_navigation(
+      records,
+      has_after: has_after,
+      has_before: has_before
+    )
+
+    render json: {
+      key => records.map { |record| serializer.call(record) },
+      count: count,
+      page: page,
+      per_page: per_page,
+      next_page: has_after ? page + 1 : nil,
+      previous_page: has_before ? page - 1 : nil,
+      meta: pagination_meta(navigation),
+      links: pagination_links(navigation, size: per_page)
+    }
+  end
+
+  def pagination_value(name, default:)
+    positive_integer_value(params.fetch(name, default), name: name)
+  end
+
+  def positive_integer_value(value, name:)
+    Integer(value.to_s, 10).tap do |integer|
+      raise ActionController::BadRequest, "#{name} must be a positive integer" unless integer.positive?
+    end
+  rescue ArgumentError, TypeError
+    raise ActionController::BadRequest, "#{name} must be a positive integer"
+  end
+
+  def cursor_parameter(page, name)
+    return unless page.key?(name)
+
+    value = page[name]
+    return value if value.is_a?(String) && value.present?
+
+    raise ActionController::BadRequest, "page[#{name}] must be a valid cursor"
+  end
+
+  def pagination_meta(result)
+    {
+      has_more: result.has_more,
+      after_cursor: result.after_cursor,
+      before_cursor: result.before_cursor
+    }
+  end
+
+  def pagination_links(result, size:)
+    {
+      next: result.next_cursor && cursor_url(:after, result.next_cursor, size: size),
+      prev: result.prev_cursor && cursor_url(:before, result.prev_cursor, size: size)
+    }
+  end
+
+  def cursor_url(direction, cursor, size:)
+    query = request.query_parameters.deep_dup
+    query.delete("page")
+    query.delete("per_page")
+    query["page"] = { "size" => size, direction.to_s => cursor }
+    "#{request.base_url}#{request.path}?#{query.to_query}"
+  end
+
+  def render_error(message, status:, errors: nil)
+    payload = { error: message }
+    payload[:errors] = errors if errors
+    render json: payload, status: status
+  end
+
+  def render_bad_request_error(exception)
+    render_error(exception.message, status: :bad_request)
+  end
+
+  def render_parameter_error(exception)
+    render_error("Invalid or missing parameter: #{exception.param}", status: :unprocessable_content, errors: {
+      exception.param => [ "is required" ]
+    })
+  end
+
+  def render_record_error(exception)
+    render_error("Validation failed", status: :unprocessable_content, errors: exception.record.errors.to_hash)
+  end
+
+  def render_conflict_error(_exception)
+    render_error("A record with those values already exists", status: :unprocessable_content)
+  end
+
+  def render_not_found_error(_exception)
+    render_error("Record not found", status: :not_found)
+  end
+end
