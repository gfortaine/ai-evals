diff --git a/app/controllers/api/v1/invitations_controller.rb b/app/controllers/api/v1/invitations_controller.rb
new file mode 100644
index 0000000..42186b2
--- /dev/null
+++ b/app/controllers/api/v1/invitations_controller.rb
@@ -0,0 +1,85 @@
+module Api
+  module V1
+    class InvitationsController < ApplicationController
+      before_action :set_account
+      before_action :authenticate_user!
+      before_action :require_active_account
+      before_action :require_admin!
+      before_action :set_invitation, only: %i[show resend destroy]
+
+      def index
+        invitations = current_account.invitations
+        invitations.expire_due!
+
+        status = params[:status].presence
+        if status
+          unless Invitation::STATUSES.include?(status)
+            render_error("Invalid invitation status", status: :unprocessable_content)
+            return
+          end
+          invitations = invitations.where(status: status)
+        end
+
+        render_paginated(
+          invitations.oldest_first,
+          key: :invitations,
+          serializer: ->(invitation) { InvitationSerializer.new(invitation) },
+          cursor_order: { id: :asc }
+        )
+      end
+
+      def show
+        render json: { invitation: InvitationSerializer.new(@invitation) }
+      end
+
+      def create
+        attributes = params.require(:invitation).permit(:email, :role)
+        email = User.normalize_email(attributes.require(:email))
+        role = attributes.require(:role)
+        invitation = nil
+        token = nil
+
+        current_account.with_lock do
+          current_account.invitations.expire_due!
+          invitation = current_account.invitations.build(
+            email: email,
+            role: role,
+            invited_by: current_user
+          )
+
+          if current_account.users.exists?(email: email)
+            invitation.errors.add(:email, :taken)
+            raise ActiveRecord::RecordInvalid, invitation
+          end
+          if current_account.invitations.exists?(email: email, status: "pending")
+            invitation.errors.add(:email, "already has a pending invitation")
+            raise ActiveRecord::RecordInvalid, invitation
+          end
+
+          token = invitation.issue!
+        end
+
+        InvitationMailer.staff_invitation(invitation, token).deliver_now
+        render json: { invitation: InvitationSerializer.new(invitation.reload) }, status: :created
+      end
+
+      def resend
+        token = @invitation.resend!
+        InvitationMailer.staff_invitation(@invitation, token).deliver_now
+        render json: { invitation: InvitationSerializer.new(@invitation.reload) }
+      end
+
+      def destroy
+        @invitation.revoke!
+        head :no_content
+      end
+
+      private
+
+      def set_invitation
+        @invitation = current_account.invitations.find(params[:id])
+        @invitation.expire_if_due!
+      end
+    end
+  end
+end
