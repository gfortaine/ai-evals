@@ -0,0 +1,71 @@
+module Api
+  module V1
+    class GroupMembershipsController < ApplicationController
+      before_action :set_account
+      before_action :authenticate_user!
+      before_action :require_active_account
+      before_action :require_staff!
+      before_action :require_admin!, only: %i[create destroy make_default]
+      before_action :set_group_membership, only: %i[show destroy make_default]
+
+      def index
+        memberships = current_account.group_memberships.includes(:group, :user)
+        group_id = positive_filter_id!(:group_id)
+        user_id = positive_filter_id!(:user_id)
+        memberships = memberships.where(group_id: group_id) if group_id
+        memberships = memberships.where(user_id: user_id) if user_id
+
+        render_paginated(
+          memberships.order(:id),
+          key: :group_memberships,
+          serializer: ->(membership) { GroupMembershipSerializer.new(membership) }
+        )
+      end
+
+      def show
+        render json: { group_membership: GroupMembershipSerializer.new(@group_membership) }
+      end
+
+      def create
+        attributes = params.require(:group_membership).permit(:group_id, :user_id, :default)
+        group = current_account.groups.find(attributes.require(:group_id))
+        user = current_account.users.find(attributes.require(:user_id))
+        membership = GroupMembership.new(group: group, user: user)
+        membership.default = boolean_value!(attributes[:default], name: :default) if attributes.key?(:default)
+        membership.save!
+
+        render json: { group_membership: GroupMembershipSerializer.new(membership.reload) }, status: :created
+      end
+
+      def destroy
+        @group_membership.destroy!
+        head :no_content
+      end
+
+      def make_default
+        @group_membership.make_default!
+        render json: { group_membership: GroupMembershipSerializer.new(@group_membership.reload) }
+      end
+
+      private
+
+      def set_group_membership
+        @group_membership = current_account.group_memberships
+          .includes(:group, :user)
+          .find(params[:id])
+      end
+
+      def positive_filter_id!(name)
+        value = params[name]
+        return if value.blank?
+
+        id = Integer(value.to_s, 10)
+        return id if id.positive?
+
+        raise ActionController::BadRequest, "#{name} must be a positive integer"
+      rescue ArgumentError, TypeError
+        raise ActionController::BadRequest, "#{name} must be a positive integer"
+      end
+    end
+  end
+end
