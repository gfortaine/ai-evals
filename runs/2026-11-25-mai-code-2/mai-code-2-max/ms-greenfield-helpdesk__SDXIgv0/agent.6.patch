+++ b/app/models/group_membership.rb
@@ -0,0 +1,72 @@
+class GroupMembership < ApplicationRecord
+  belongs_to :group, inverse_of: :group_memberships
+  belongs_to :user, inverse_of: :group_memberships
+
+  validates :group_id, uniqueness: { scope: :user_id }
+  validates :default, inclusion: { in: [ true, false ] }
+  validate :user_is_staff
+  validate :group_and_user_belong_to_same_account
+
+  around_save :synchronize_default, if: -> { new_record? || will_save_change_to_default? }
+  around_destroy :clear_assignment_and_reselect_default
+
+  def make_default!
+    self.class.transaction do
+      user.lock!
+      update!(default: true)
+    end
+    self
+  end
+
+  private
+
+  def synchronize_default
+    user.lock!
+    peers = self.class.where(user_id: user_id)
+
+    if default?
+      peers.where.not(id: id).where(default: true).update_all(default: false, updated_at: Time.current)
+    end
+
+    yield
+
+    if default?
+      peers.where.not(id: id).where(default: true).update_all(default: false, updated_at: Time.current)
+    elsif !peers.where(default: true).exists?
+      replacement = peers.order(:id).first
+      if replacement
+        replacement.update_columns(default: true, updated_at: Time.current)
+        if replacement.id == id
+          self[:default] = true
+          self[:updated_at] = replacement.updated_at
+        end
+      end
+    end
+  end
+
+  def clear_assignment_and_reselect_default
+    user.lock!
+    Ticket.where(group_id: group_id, assignee_id: user_id).update_all(assignee_id: nil)
+
+    yield
+
+    peers = self.class.where(user_id: user_id)
+    return if peers.where(default: true).exists?
+
+    peers.order(:id).first&.update_columns(default: true, updated_at: Time.current)
+  end
+
+  def user_is_staff
+    return unless user
+    return if user.staff?
+
+    errors.add(:user, "must be staff")
+  end
+
+  def group_and_user_belong_to_same_account
+    return unless group && user
+    return if group.account_id == user.account_id
+
+    errors.add(:user, "must belong to the group's account")
+  end
+end
