diff --git a/README.md b/README.md
index d61e757..5e9aac8 100644
--- a/README.md
+++ b/README.md
@@ -16,11 +16,16 @@ Core endpoints:
 
 - `POST /api/v1/account/create`
 - `GET /api/v1/portal`
+- `POST /api/v1/registrations`
 - `GET /api/v1/account`
 - `POST /api/v1/sessions` and `DELETE /api/v1/session`
 - `GET /api/v1/me`, `PATCH /api/v1/me`, and `PUT /api/v1/me/password`
 - `POST /api/v1/email_verifications` and `POST /api/v1/email_verifications/confirm`
 - `POST /api/v1/password_resets` and `POST /api/v1/password_resets/confirm`
 - `POST /api/v1/account/cancel` and `POST /api/v1/account/reactivate`
+- `GET /api/v1/requests`, `POST /api/v1/requests`, `GET|PATCH /api/v1/requests/:id`, and `GET /api/v1/requests/:id/comments`
+- `GET /api/v1/tickets`, `GET|PATCH /api/v1/tickets/:id`, and `GET /api/v1/tickets/:id/comments`
+
+Customers register in a portal, verify their email, and use the same session and recovery endpoints as staff. Request and ticket lists support `page` and `per_page`; they include pagination metadata and newest account activity first. Comment lists are oldest first. Ticket replies are stored as portal comments and do not send email.
 
 Cancelled accounts are blocked from ordinary access, revoke all sessions, and may be reactivated by their owner for 90 days. Run `bin/rails helpdesk:purge_cancelled_accounts` to permanently remove accounts past that window and cascade their data deletion.
diff --git a/app/controllers/api/v1/registrations_controller.rb b/app/controllers/api/v1/registrations_controller.rb
new file mode 100644
index 0000000..b3087ea
--- /dev/null
+++ b/app/controllers/api/v1/registrations_controller.rb
@@ -0,0 +1,22 @@
+module Api
+  module V1
+    class RegistrationsController < ApplicationController
+      before_action :set_account
+      before_action :require_active_account
+
+      def create
+        attributes = params.require(:user).permit(:name, :email, :password)
+        user = current_account.users.build(attributes.merge(role: "customer"))
+
+        verification_token = nil
+        User.transaction do
+          user.save!
+          verification_token = user.issue_email_verification!
+        end
+
+        UserMailer.email_verification(user, verification_token).deliver_now
+        render_user(user, status: :created)
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/requests_controller.rb b/app/controllers/api/v1/requests_controller.rb
new file mode 100644
index 0000000..c034920
--- /dev/null
+++ b/app/controllers/api/v1/requests_controller.rb
@@ -0,0 +1,95 @@
+module Api
+  module V1
+    class RequestsController < ApplicationController
+      before_action :set_account
+      before_action :authenticate_user!
+      before_action :require_active_account
+      before_action :require_customer!
+      before_action :set_request, only: %i[show comments update]
+
+      def index
+        requests = current_account.tickets
+          .where(requester: current_user)
+          .recent_first
+
+        render_paginated(
+          requests,
+          key: :requests,
+          serializer: ->(ticket) { TicketSerializer.new(ticket) }
+        )
+      end
+
+      def create
+        attributes = params.require(:request).permit(:subject, comment: [ :body ])
+        comment_attributes = attributes.require(:comment)
+        ticket = current_account.tickets.build(
+          requester: current_user,
+          subject: attributes.require(:subject),
+          status: "open"
+        )
+
+        Ticket.transaction do
+          ticket.save!
+          ticket.comments.create!(
+            author: current_user,
+            body: comment_attributes.require(:body),
+            public: true
+          )
+        end
+
+        render json: { request: TicketSerializer.new(ticket.reload) }, status: :created
+      end
+
+      def show
+        render json: { request: TicketSerializer.new(@request) }
+      end
+
+      def comments
+        comments = @request.comments.where(public: true).includes(:author).oldest_first
+        render_paginated(
+          comments,
+          key: :comments,
+          serializer: ->(comment) { CommentSerializer.new(comment) }
+        )
+      end
+
+      def update
+        attributes = params.require(:request).permit(:status, comment: [ :body ])
+        unless attributes.key?(:status) || attributes.key?(:comment)
+          render_error("At least a comment or status is required", status: :unprocessable_content)
+          return
+        end
+
+        Ticket.transaction do
+          @request.lock!
+          if attributes.key?(:comment)
+            comment_attributes = attributes.require(:comment)
+            @request.comments.create!(
+              author: current_user,
+              body: comment_attributes.require(:body),
+              public: true
+            )
+          end
+
+          if attributes.key?(:status)
+            unless attributes[:status] == "solved"
+              @request.errors.add(:status, :inclusion, value: attributes[:status])
+              raise ActiveRecord::RecordInvalid, @request
+            end
+            @request.update!(status: "solved") unless @request.status == "solved"
+          elsif attributes.key?(:comment) && @request.status != "open"
+            @request.update!(status: "open")
+          end
+        end
+
+        render json: { request: TicketSerializer.new(@request.reload) }
+      end
+
+      private
+
+      def set_request
+        @request = current_account.tickets.find_by!(id: params[:id], requester: current_user)
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/tickets_controller.rb b/app/controllers/api/v1/tickets_controller.rb
