+module Api
+  module V1
+    class TicketsController < ApplicationController
+      before_action :set_account
+      before_action :authenticate_user!
+      before_action :require_active_account
+      before_action :require_staff!
+      before_action :set_ticket, only: %i[show comments update]
+
+      def index
+        tickets = current_account.tickets.includes(:requester).recent_first
+        render_paginated(
+          tickets,
+          key: :tickets,
+          serializer: ->(ticket) { TicketSerializer.new(ticket, include_requester: true) }
+        )
+      end
+
+      def show
+        render json: { ticket: TicketSerializer.new(@ticket, include_requester: true) }
+      end
+
+      def comments
+        comments = @ticket.comments.includes(:author).oldest_first
+        render_paginated(
+          comments,
+          key: :comments,
+          serializer: ->(comment) { CommentSerializer.new(comment) }
+        )
+      end
+
+      def update
+        attributes = params.require(:ticket).permit(:status, comment: %i[body public])
+        unless attributes.key?(:status) || attributes.key?(:comment)
+          render_error("At least a comment or status is required", status: :unprocessable_content)
+          return
+        end
+
+        Ticket.transaction do
+          @ticket.lock!
+          if attributes.key?(:comment)
+            comment_attributes = attributes.require(:comment)
+            @ticket.comments.create!(
+              author: current_user,
+              body: comment_attributes.require(:body),
+              public: comment_attributes.fetch(:public, true)
+            )
+          end
+
+          @ticket.update!(status: attributes[:status]) if attributes.key?(:status)
+        end
+
+        render json: { ticket: TicketSerializer.new(@ticket.reload, include_requester: true) }
+      end
+
+      private
+
+      def set_ticket
+        @ticket = current_account.tickets.includes(:requester).find(params[:id])
+      end
+    end
+  end
+end
