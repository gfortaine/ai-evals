new file mode 100644
index 0000000..4c6b735
--- /dev/null
+++ b/app/models/comment.rb
@@ -0,0 +1,19 @@
+class Comment < ApplicationRecord
+  belongs_to :ticket, inverse_of: :comments, touch: true
+  belongs_to :author, class_name: "User"
+
+  validates :body, presence: true
+  validates :public, inclusion: { in: [ true, false ] }
+  validate :author_belongs_to_ticket_account
+
+  scope :oldest_first, -> { order(:created_at, :id) }
+
+  private
+
+  def author_belongs_to_ticket_account
+    return unless ticket && author
+    return if author.account_id == ticket.account_id
+
+    errors.add(:author, "must belong to the ticket account")
+  end
+end
diff --git a/app/models/ticket.rb b/app/models/ticket.rb
new file mode 100644
index 0000000..241e312
--- /dev/null
+++ b/app/models/ticket.rb
@@ -0,0 +1,22 @@
+class Ticket < ApplicationRecord
+  STATUSES = %w[open pending solved].freeze
+
+  belongs_to :account, inverse_of: :tickets
+  belongs_to :requester, class_name: "User"
+  has_many :comments, inverse_of: :ticket, dependent: :destroy
+
+  validates :subject, presence: true, length: { maximum: 255 }
+  validates :status, inclusion: { in: STATUSES }
+  validate :requester_belongs_to_account
+
+  scope :recent_first, -> { order(updated_at: :desc, id: :desc) }
+
+  private
+
+  def requester_belongs_to_account
+    return unless account && requester
+    return if requester.account_id == account.id
+
+    errors.add(:requester, "must belong to the account")
+  end
+end
