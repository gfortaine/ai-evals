@@ -0,0 +1,238 @@
+require "test_helper"
+require "uri"
+
+class CustomerPortalTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @owner = create_user("owner", "Owner", "admin")
+    @account.update!(owner: @owner)
+    @customer = create_user("avery", "Avery", "customer")
+    @other_customer = create_user("other", "Other Customer", "customer")
+    @owner_token = Session.issue_for!(@owner).last
+    @customer_token = Session.issue_for!(@customer).last
+    @other_customer_token = Session.issue_for!(@other_customer).last
+  end
+
+  test "portal registration creates an unverified customer who uses the existing auth flows" do
+    post "/api/v1/registrations", params: {
+      user: {
+        name: "Jordan",
+        email: "JORDAN@example.test",
+        password: "my-customer-password"
+      }
+    }, headers: account_headers, as: :json
+
+    assert_response :created
+    user = json.fetch("user")
+    assert_equal "customer", user.fetch("role")
+    assert_equal "jordan@example.test", user.fetch("email")
+    assert_equal false, user.fetch("verified")
+    assert_equal 1, ActionMailer::Base.deliveries.length
+
+    post "/api/v1/sessions", params: {
+      session: { email: "jordan@example.test", password: "my-customer-password" }
+    }, headers: account_headers, as: :json
+    assert_response :forbidden
+
+    post "/api/v1/email_verifications/confirm", params: {
+      email_verification: { token: token_from(ActionMailer::Base.deliveries.last) }
+    }, headers: account_headers, as: :json
+    assert_response :success
+
+    post "/api/v1/sessions", params: {
+      session: { email: "jordan@example.test", password: "my-customer-password" }
+    }, headers: account_headers, as: :json
+    assert_response :success
+
+    get "/api/v1/me", headers: authenticated_headers(json.dig("session", "token"))
+    assert_response :success
+    assert_equal "customer", json.dig("user", "role")
+  end
+
+  test "customer and staff can exchange a portal-only ticket conversation" do
+    post "/api/v1/requests", params: {
+      request: {
+        subject: "Cannot download my receipt",
+        comment: { body: "The download button does nothing." }
+      }
+    }, headers: customer_headers, as: :json
+
+    assert_response :created
+    request_payload = json.fetch("request")
+    assert_equal "Cannot download my receipt", request_payload.fetch("subject")
+    assert_equal "open", request_payload.fetch("status")
+    assert_equal @customer.id, request_payload.fetch("requester_id")
+    assert request_payload.fetch("created_at").present?
+    assert request_payload.fetch("updated_at").present?
+    ticket_id = request_payload.fetch("id")
+
+    get "/api/v1/tickets", headers: owner_headers
+    assert_response :success
+    assert_equal "tickets", json.keys.find { |key| key == "tickets" }
+    assert_equal 1, json.fetch("count")
+    assert_equal({
+      "id" => @customer.id,
+      "name" => "Avery",
+      "email" => "avery@acme.test"
+    }, json.fetch("tickets").first.fetch("requester"))
+
+    patch "/api/v1/tickets/#{ticket_id}", params: {
+      ticket: {
+        comment: { body: "Please try again now." },
+        status: "pending"
+      }
+    }, headers: owner_headers, as: :json
+    assert_response :success
+    assert_equal "pending", json.dig("ticket", "status")
+    assert_equal "Please try again now.", Comment.last.body
+    assert_empty ActionMailer::Base.deliveries
+
+    patch "/api/v1/requests/#{ticket_id}", params: {
+      request: { comment: { body: "It still does not work." } }
+    }, headers: customer_headers, as: :json
+    assert_response :success
+    assert_equal "open", json.dig("request", "status")
+
+    patch "/api/v1/tickets/#{ticket_id}", params: {
+      ticket: { comment: { body: "I have refreshed the portal." } }
+    }, headers: owner_headers, as: :json
+    assert_response :success
+    assert_equal "open", json.dig("ticket", "status")
+
+    patch "/api/v1/requests/#{ticket_id}", params: {
+      request: {
+        comment: { body: "The receipt downloaded. Thank you." },
+        status: "solved"
+      }
+    }, headers: customer_headers, as: :json
+    assert_response :success
+    assert_equal "solved", json.dig("request", "status")
+
+    get "/api/v1/requests/#{ticket_id}/comments", headers: customer_headers
+    assert_response :success
+    assert_equal [
+      "The download button does nothing.",
+      "Please try again now.",
+      "It still does not work.",
+      "I have refreshed the portal.",
+      "The receipt downloaded. Thank you."
+    ], json.fetch("comments").map { |comment| comment.fetch("body") }
+    assert_equal @owner.id, json.fetch("comments").second.dig("author", "id")
+    assert json.fetch("comments").all? { |comment| comment.fetch("public") == true }
+    assert json.fetch("comments").all? { |comment| comment["created_at"].present? }
+
+    get "/api/v1/tickets/#{ticket_id}", headers: owner_headers
+    assert_response :success
+    assert_equal "solved", json.dig("ticket", "status")
+  end
+
+  test "lists are customer scoped paginated and ordered by recent activity" do
+    older = create_ticket(@customer, "Older", created_at: 2.days.ago)
+    newest = create_ticket(@customer, "Newest", created_at: 1.day.ago)
+    create_ticket(@other_customer, "Someone else's", created_at: 1.hour.ago)
+
+    get "/api/v1/requests", params: { page: 1, per_page: 1 }, headers: customer_headers
+    assert_response :success
+    assert_equal 2, json.fetch("count")
+    assert_equal 1, json.fetch("page")
+    assert_equal 1, json.fetch("per_page")
+    assert_equal 2, json.fetch("next_page")
+    assert_nil json.fetch("previous_page")
+    assert_equal [ newest.id ], json.fetch("requests").map { |record| record.fetch("id") }
+
+    older.touch
+    get "/api/v1/requests", params: { page: 1, per_page: 1 }, headers: customer_headers
+    assert_equal [ older.id ], json.fetch("requests").map { |record| record.fetch("id") }
+
+    get "/api/v1/tickets", params: { page: 2, per_page: 2 }, headers: owner_headers
+    assert_response :success
+    assert_equal 3, json.fetch("count")
+    assert_equal 2, json.fetch("page")
+    assert_equal 1, json.fetch("previous_page")
+    assert_nil json.fetch("next_page")
+
+    get "/api/v1/requests/#{older.id}/comments", params: { per_page: 1 }, headers: customer_headers
+    assert_equal 1, json.fetch("count")
+    assert_equal "oldest request", json.dig("comments", 0, "body")
+  end
+
+  test "roles and request ownership are enforced and failed updates are atomic" do
+    ticket = create_ticket(@other_customer, "Private to Other")
+
+    get "/api/v1/requests/#{ticket.id}", headers: customer_headers
+    assert_response :not_found
+
+    get "/api/v1/tickets", headers: customer_headers
+    assert_response :forbidden
+
+    get "/api/v1/requests", headers: owner_headers
+    assert_response :forbidden
+
+    patch "/api/v1/requests/#{ticket.id}", params: {
+      request: { comment: { body: "Should not persist" }, status: "pending" }
+    }, headers: authenticated_headers(@other_customer_token), as: :json
+    assert_response :unprocessable_content
+    assert_equal 1, ticket.reload.comments.count
+    assert_equal "open", ticket.status
+
+    get "/api/v1/requests", params: { page: 0 }, headers: customer_headers
+    assert_response :bad_request
+  end
+
+  private
+
+  def create_user(handle, name, role)
+    @account.users.create!(
+      name: name,
+      email: "#{handle}@acme.test",
+      password: "my-secure-password",
+      role: role,
+      verified: true
+    )
+  end
+
+  def create_ticket(requester, subject, created_at: Time.current)
+    ticket = @account.tickets.create!(
+      requester: requester,
+      subject: subject,
+      status: "open",
+      created_at: created_at,
+      updated_at: created_at
+    )
+    ticket.comments.create!(
+      author: requester,
+      body: "oldest request",
+      public: true,
+      created_at: created_at,
+      updated_at: created_at
+    )
+    ticket.update_columns(updated_at: created_at)
+    ticket
+  end
+
+  def account_headers
+    { "X-Helpdesk-Account" => "acme" }
+  end
+
+  def authenticated_headers(token)
+    account_headers.merge("Authorization" => "Bearer #{token}")
+  end
+
+  def owner_headers
+    authenticated_headers(@owner_token)
+  end
+
+  def customer_headers
+    authenticated_headers(@customer_token)
+  end
+
+  def token_from(mail)
+    url = URI.extract(mail.text_part ? mail.text_part.body.decoded : mail.body.decoded, %w[http https]).first
+    URI.decode_www_form(URI(url).query).to_h.fetch("token")
+  end
+
+  def json
+    JSON.parse(response.body)
+  end
+end
