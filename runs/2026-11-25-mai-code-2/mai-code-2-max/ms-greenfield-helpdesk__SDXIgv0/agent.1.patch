+++ b/app/mailers/user_mailer.rb
@@ -0,0 +1,32 @@
+class UserMailer < ApplicationMailer
+  def email_verification(user, token)
+    @user = user
+    @account = user.account
+    @verification_url = frontend_link(
+      "/verify-email",
+      account: @account.subdomain,
+      token: token
+    )
+
+    mail to: @user.email, subject: "Verify your email for #{@account.name}"
+  end
+
+  def password_reset(user, token)
+    @user = user
+    @account = user.account
+    @reset_url = frontend_link(
+      "/reset-password",
+      account: @account.subdomain,
+      token: token
+    )
+
+    mail to: @user.email, subject: "Reset your password for #{@account.name}"
+  end
+
+  private
+
+  def frontend_link(path, params)
+    base_url = Rails.application.config.x.helpdesk.frontend_url
+    "#{base_url}#{path}?#{URI.encode_www_form(params)}"
+  end
+end
diff --git a/app/models/account.rb b/app/models/account.rb
new file mode 100644
index 0000000..579a703
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,64 @@
+class Account < ApplicationRecord
+  CANCELLATION_WINDOW = 90.days
+
+  belongs_to :owner, class_name: "User", optional: true
+  has_many :users, inverse_of: :account, dependent: :destroy
+  has_many :sessions, through: :users
+
+  before_validation :normalize_subdomain
+
+  validates :name, presence: true, length: { maximum: 120 }
+  validates :subdomain,
+    presence: true,
+    uniqueness: true,
+    length: { maximum: 63 },
+    format: { with: /\A[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\z/ }
+
+  scope :active, -> { where(cancelled_at: nil) }
+  scope :purgeable, -> { where("cancelled_at < ?", cancellation_cutoff) }
+
+  def self.cancellation_cutoff
+    CANCELLATION_WINDOW.ago
+  end
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  def owned_by?(user)
+    user.present? && owner_id == user.id
+  end
+
+  def reactivation_available?
+    cancelled? && cancelled_at >= self.class.cancellation_cutoff
+  end
+
+  def cancel!
+    with_lock do
+      reject_operation!("Account is already cancelled") if cancelled?
+
+      update!(cancelled_at: Time.current)
+      Session.where(user_id: users.select(:id)).delete_all
+    end
+  end
+
+  def reactivate!
+    with_lock do
+      reject_operation!("Account is not cancelled") unless cancelled?
+      reject_operation!("The account reactivation period has expired") unless reactivation_available?
+
+      update!(cancelled_at: nil)
+    end
+  end
+
+  private
+
+  def normalize_subdomain
+    self.subdomain = subdomain.to_s.strip.downcase
+  end
+
+  def reject_operation!(message)
+    errors.add(:base, message)
+    raise ActiveRecord::RecordInvalid, self
+  end
+end
