+require "digest"
+require "securerandom"
+
+module Helpdesk
+  module Tokens
+    module_function
+
+    def generate
+      SecureRandom.urlsafe_base64(32, false)
+    end
+
+    def digest(token)
+      Digest::SHA256.hexdigest(token.to_s)
+    end
+  end
+end
