+    Rails.application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+    Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+  end
+
+  test "purge task removes accounts cancelled more than 90 days ago and all their users" do
+    expired = Account.create!(name: "Expired", subdomain: "expired", cancelled_at: 91.days.ago)
+    expired_user = expired.users.create!(
+      name: "Expired Owner",
+      email: "owner@expired.test",
+      password: "password-one",
+      role: "admin"
+    )
+    expired.update!(owner: expired_user)
+
+    recent = Account.create!(name: "Recent", subdomain: "recent", cancelled_at: 89.days.ago)
+    recent_user = recent.users.create!(
+      name: "Recent Owner",
+      email: "owner@recent.test",
+      password: "password-one",
+      role: "admin"
+    )
+    recent.update!(owner: recent_user)
+
+    Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+
+    refute Account.exists?(expired.id)
+    refute User.exists?(expired_user.id)
+    assert Account.exists?(recent.id)
+    assert User.exists?(recent_user.id)
+  end
+end
