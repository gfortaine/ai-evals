+module Api
+  module V1
+    class PasswordsController < ApplicationController
+      before_action :set_account
+      before_action :authenticate_user!
+      before_action :require_active_account
+
+      def update
+        password_change = params.require(:password_change).permit(:current_password, :password)
+        current_password = password_change.require(:current_password)
+        password = password_change.require(:password)
+
+        unless current_user.authenticate(current_password)
+          render_error("Current password is incorrect", status: :unprocessable_content, errors: {
+            current_password: [ "is incorrect" ]
+          })
+          return
+        end
+
+        current_user.change_password!(password: password)
+        render_user
+      end
+    end
+  end
+end
