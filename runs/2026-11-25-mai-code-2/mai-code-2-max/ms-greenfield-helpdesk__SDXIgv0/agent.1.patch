+class Session < ApplicationRecord
+  belongs_to :user
+
+  validates :token_digest, presence: true, uniqueness: true
+
+  def self.issue_for!(user)
+    token = Helpdesk::Tokens.generate
+    session = create!(user: user, token_digest: Helpdesk::Tokens.digest(token))
+    [ session, token ]
+  end
+
+  def self.find_by_token(token)
+    return if token.blank?
+
+    find_by(token_digest: Helpdesk::Tokens.digest(token))
+  end
+end
diff --git a/app/models/user.rb b/app/models/user.rb
new file mode 100644
index 0000000..44a4f6c
--- /dev/null
+++ b/app/models/user.rb
@@ -0,0 +1,120 @@
+require "uri"
+
+class User < ApplicationRecord
+  ROLES = %w[admin member].freeze
+  EMAIL_VERIFICATION_TTL = 24.hours
+  PASSWORD_RESET_TTL = 2.hours
+
+  belongs_to :account, inverse_of: :users
+  has_many :sessions, dependent: :destroy
+
+  has_secure_password
+
+  before_validation :normalize_email
+
+  validates :name, presence: true, length: { maximum: 120 }
+  validates :email,
+    presence: true,
+    length: { maximum: 254 },
+    uniqueness: { scope: :account_id, case_sensitive: false },
+    format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :role, inclusion: { in: ROLES }
+  validates :password, length: { minimum: 8 }, allow_nil: true, on: %i[create update]
+
+  def self.normalize_email(email)
+    email.to_s.strip.downcase
+  end
+
+  def admin?
+    role == "admin"
+  end
+
+  def owner?
+    account&.owned_by?(self)
+  end
+
+  def issue_email_verification!
+    token = Helpdesk::Tokens.generate
+    update!(
+      email_verification_token_digest: Helpdesk::Tokens.digest(token),
+      email_verification_sent_at: Time.current
+    )
+    token
+  end
+
+  def consume_email_verification!(token)
+    with_lock do
+      return false unless valid_token?(
+        token,
+        email_verification_token_digest,
+        email_verification_sent_at,
+        EMAIL_VERIFICATION_TTL
+      )
+
+      update!(
+        verified: true,
+        email_verification_token_digest: nil,
+        email_verification_sent_at: nil
+      )
+      true
+    end
+  end
+
+  def issue_password_reset!
+    token = Helpdesk::Tokens.generate
+    update!(
+      password_reset_token_digest: Helpdesk::Tokens.digest(token),
+      password_reset_sent_at: Time.current
+    )
+    token
+  end
+
+  def reset_password!(token, password:)
+    with_lock do
+      validate_password_argument!(password)
+      return false unless valid_token?(
+        token,
+        password_reset_token_digest,
+        password_reset_sent_at,
+        PASSWORD_RESET_TTL
+      )
+
+      update!(
+        password: password,
+        password_reset_token_digest: nil,
+        password_reset_sent_at: nil
+      )
+      sessions.delete_all
+      true
+    end
+  end
+
+  def change_password!(password:)
+    validate_password_argument!(password)
+    transaction do
+      update!(password: password)
+      sessions.delete_all
+    end
+  end
+
+  private
+
+  def validate_password_argument!(password)
+    return if password.present?
+
+    errors.add(:password, :blank)
+    raise ActiveRecord::RecordInvalid, self
+  end
+
+  def normalize_email
+    self.email = self.class.normalize_email(email)
+  end
+
+  def valid_token?(token, expected_digest, sent_at, ttl)
+    return false if token.blank? || expected_digest.blank? || sent_at.blank?
+    return false unless sent_at >= ttl.ago
+
+    ActiveSupport::SecurityUtils.secure_compare(expected_digest, Helpdesk::Tokens.digest(token))
+  end
+
+end
