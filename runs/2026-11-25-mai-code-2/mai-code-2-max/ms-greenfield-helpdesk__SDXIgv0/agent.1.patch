diff --git a/app/controllers/application_controller.rb b/app/controllers/application_controller.rb
new file mode 100644
index 0000000..0d59520
--- /dev/null
+++ b/app/controllers/application_controller.rb
@@ -0,0 +1,86 @@
+class ApplicationController < ActionController::API
+  ACCOUNT_HEADER = "X-Helpdesk-Account"
+
+  rescue_from ActionController::ParameterMissing, with: :render_parameter_error
+  rescue_from ActiveRecord::RecordInvalid, with: :render_record_error
+  rescue_from ActiveRecord::RecordNotUnique, with: :render_conflict_error
+
+  private
+
+  attr_reader :current_account, :current_session, :current_user
+
+  def set_account
+    subdomain = request.headers[ACCOUNT_HEADER].to_s.strip.downcase
+    if subdomain.blank?
+      render_error("#{ACCOUNT_HEADER} header is required", status: :bad_request)
+      return
+    end
+
+    @current_account = Account.find_by(subdomain: subdomain)
+    render_error("Account not found", status: :not_found) unless @current_account
+  end
+
+  def require_active_account
+    return unless current_account&.cancelled?
+
+    render_error("Account is cancelled", status: :forbidden)
+  end
+
+  def authenticate_user!
+    token = bearer_token
+    unless token
+      render_error("A valid bearer token is required", status: :unauthorized)
+      return
+    end
+
+    @current_session = Session.includes(user: :account).find_by_token(token)
+    user = current_session&.user
+
+    unless user && user.account_id == current_account.id && user.verified?
+      render_error("Invalid or expired session", status: :unauthorized)
+      return
+    end
+
+    @current_user = user
+  end
+
+  def require_owner!
+    return if current_account.owned_by?(current_user)
+
+    render_error("Only the account owner may perform this action", status: :forbidden)
+  end
+
+  def bearer_token
+    authorization = request.headers["Authorization"].to_s
+    match = authorization.match(/\ABearer\s+(\S+)\z/i)
+    match[1] if match && match[1].bytesize <= 2048
+  end
+
+  def render_account(account = current_account, status: :ok)
+    render json: { account: AccountSerializer.new(account) }, status: status
+  end
+
+  def render_user(user = current_user, status: :ok)
+    render json: { user: UserSerializer.new(user) }, status: status
+  end
+
+  def render_error(message, status:, errors: nil)
+    payload = { error: message }
+    payload[:errors] = errors if errors
+    render json: payload, status: status
+  end
+
+  def render_parameter_error(exception)
+    render_error("Invalid or missing parameter: #{exception.param}", status: :unprocessable_content, errors: {
+      exception.param => [ "is required" ]
+    })
+  end
+
+  def render_record_error(exception)
+    render_error("Validation failed", status: :unprocessable_content, errors: exception.record.errors.to_hash)
+  end
+
+  def render_conflict_error(_exception)
+    render_error("A record with those values already exists", status: :unprocessable_content)
+  end
+end
