new file mode 100644
index 0000000..867a835
--- /dev/null
+++ b/app/controllers/api/v1/sessions_controller.rb
@@ -0,0 +1,44 @@
+module Api
+  module V1
+    class SessionsController < ApplicationController
+      before_action :set_account
+      before_action :authenticate_user!, only: :destroy
+
+      def create
+        credentials = params.require(:session).permit(:email, :password)
+        email = User.normalize_email(credentials.require(:email))
+        password = credentials.require(:password)
+        user = current_account.users.find_by(email: email)
+
+        unless user&.authenticate(password)
+          render_error("Invalid email or password", status: :unauthorized)
+          return
+        end
+
+        unless user.verified?
+          render_error("Email address must be verified before signing in", status: :forbidden)
+          return
+        end
+
+        if current_account.cancelled?
+          unless current_account.owned_by?(user) && current_account.reactivation_available?
+            render_error("Account is cancelled", status: :forbidden)
+            return
+          end
+        end
+
+        session, token = Session.issue_for!(user)
+        render json: {
+          session: SessionSerializer.new(session, token: token),
+          user: UserSerializer.new(user),
+          account: AccountSerializer.new(current_account)
+        }, status: :ok
+      end
+
+      def destroy
+        current_session.destroy!
+        head :no_content
+      end
+    end
+  end
+end
