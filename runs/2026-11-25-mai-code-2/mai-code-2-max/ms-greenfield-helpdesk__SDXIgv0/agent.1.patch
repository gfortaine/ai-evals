diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..d8a4b97
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,57 @@
+module Api
+  module V1
+    class AccountsController < ApplicationController
+      before_action :set_account, only: %i[show cancel reactivate]
+      before_action :authenticate_user!, only: %i[show cancel reactivate]
+      before_action :require_active_account, only: %i[show cancel]
+      before_action :require_owner!, only: %i[cancel reactivate]
+
+      def create
+        account_attributes = params.require(:account).permit(:name, :subdomain)
+        admin_attributes = params.require(:account).require(:admin).permit(:name, :email, :password)
+
+        account = Account.new(account_attributes)
+        user = account.users.build(admin_attributes.merge(role: "admin"))
+
+        account_valid = account.valid?
+        user_valid = user.valid?
+        unless account_valid && user_valid
+          render_error("Validation failed", status: :unprocessable_content, errors: {
+            account: account.errors.to_hash,
+            admin: user.errors.to_hash
+          })
+          return
+        end
+
+        verification_token = nil
+        Account.transaction do
+          account.save!
+          user.save!
+          account.update!(owner: user)
+          verification_token = user.issue_email_verification!
+        end
+
+        UserMailer.email_verification(user, verification_token).deliver_now
+
+        render json: {
+          account: AccountSerializer.new(account),
+          user: UserSerializer.new(user)
+        }, status: :created
+      end
+
+      def show
+        render_account
+      end
+
+      def cancel
+        current_account.cancel!
+        render_account
+      end
+
+      def reactivate
+        current_account.reactivate!
+        render_account
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
