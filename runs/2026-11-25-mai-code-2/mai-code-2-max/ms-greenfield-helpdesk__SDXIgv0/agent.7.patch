+require "test_helper"
+
+class TicketMergeTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @owner = create_user("owner", "Owner", "admin")
+    @agent = create_user("agent", "Agent", "agent")
+    @customer = create_user("avery", "Avery", "customer")
+    @other_customer = create_user("other", "Other Customer", "customer")
+    @account.update!(owner: @owner)
+    @owner_token = Session.issue_for!(@owner).last
+    @customer_token = Session.issue_for!(@customer).last
+  end
+
+  test "staff merges without moving comments or changing the surviving conversation" do
+    source = create_ticket(subject: "Duplicate receipt request", assignee: @owner, email_origin: true)
+    target = create_ticket(subject: "Original receipt request", status: "pending", assignee: @agent)
+    source.comments.create!(author: @owner, body: "Old private note", public: false)
+    source_reply_address = source.reply_address
+    target_reply_token = target.reply_token
+    target_email_origin = target.email_origin?
+    target_comment_ids = target.comments.ids
+
+    post merge_path(source), params: {
+      merge: {
+        target_id: target.id,
+        source_comment: { body: "Continuing in ticket #{target.id}.", public: true },
+        target_comment: { body: "Duplicate checked.", public: false }
+      }
+    }, headers: owner_headers, as: :json
+
+    assert_response :success
+    source_payload = json.fetch("source")
+    target_payload = json.fetch("target")
+    assert_equal "closed", source_payload.fetch("status")
+    assert_equal target.id, source_payload.fetch("merged_into_id")
+    assert_nil source_payload.fetch("assignee_id")
+    assert_nil target_payload.fetch("merged_into_id")
+    assert_equal "pending", target_payload.fetch("status")
+    assert_equal @agent.id, target_payload.fetch("assignee_id")
+
+    source.reload
+    target.reload
+    assert_equal source_reply_address, source.reply_address
+    assert_equal target_reply_token, target.reply_token
+    assert_equal target_email_origin, target.email_origin?
+    assert_equal "Duplicate receipt request", source.subject
+    assert_equal target_comment_ids, target.comments.where(id: target_comment_ids).ids
+    assert_equal 3, source.comments.count
+    assert_equal 2, target.comments.count
+
+    public_source_note = source.comments.find_by!(body: "Continuing in ticket #{target.id}.")
+    private_target_note = target.comments.find_by!(body: "Duplicate checked.")
+    assert_predicate public_source_note, :public?
+    refute_predicate private_target_note, :public?
+    assert_equal @owner, public_source_note.author
+    assert_equal @owner, private_target_note.author
+    assert_empty ActionMailer::Base.deliveries
+
+    get "/api/v1/tickets/#{source.id}", headers: owner_headers
+    assert_response :success
+    assert_equal target.id, json.dig("ticket", "merged_into_id")
+    get "/api/v1/requests/#{source.id}", headers: customer_headers
+    assert_response :success
+    assert_equal target.id, json.dig("request", "merged_into_id")
+
+    get "/api/v1/tickets", params: { status: "closed" }, headers: owner_headers
+    assert_equal [ source.id ], json.fetch("tickets").map { |ticket| ticket.fetch("id") }
+    get "/api/v1/requests", params: { status: "closed" }, headers: customer_headers
+    assert_equal [ source.id ], json.fetch("requests").map { |ticket| ticket.fetch("id") }
+
+    get "/api/v1/requests/#{source.id}/comments", headers: customer_headers
+    public_bodies = json.fetch("comments").map { |comment| comment.fetch("body") }
+    assert_includes public_bodies, public_source_note.body
+    refute_includes public_bodies, "Old private note"
+  end
+
+  test "default merge notes are private and later links are preserved" do
+    original = create_ticket(subject: "A")
+    middle = create_ticket(subject: "B")
+    final = create_ticket(subject: "C", status: "solved", email_origin: true)
+
+    post merge_path(original), params: { merge: { target_id: middle.id } }, headers: owner_headers, as: :json
+    assert_response :success
+    source_note = original.comments.order(:id).last
+    target_note = middle.comments.order(:id).last
+    refute_predicate source_note, :public?
+    refute_predicate target_note, :public?
+    assert_match middle.id.to_s, source_note.body
+    assert_match original.id.to_s, target_note.body
+
+    post merge_path(middle), params: {
+      merge: { target_id: final.id, target_comment: { public: true } }
+    }, headers: owner_headers, as: :json
+    assert_response :success
+    assert_equal middle.id, original.reload.merged_into_id
+    assert_equal final.id, middle.reload.merged_into_id
+    assert_equal "solved", final.reload.status
+    assert_nil final.merged_into_id
+    assert_predicate final.comments.order(:id).last, :public?
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "closed tickets reject staff and customer edits" do
+    source = create_ticket(subject: "Duplicate")
+    target = create_ticket(subject: "Target")
+    post merge_path(source), params: { merge: { target_id: target.id } }, headers: owner_headers, as: :json
+    assert_response :success
+    source_comment_count = source.comments.count
+
+    patch "/api/v1/tickets/#{source.id}", params: {
+      ticket: { status: "open", comment: { body: "Should not be added" } }
+    }, headers: owner_headers, as: :json
+    assert_response :unprocessable_content
+    assert_equal "closed", source.reload.status
+    assert_equal source_comment_count, source.comments.count
+
+    patch "/api/v1/requests/#{source.id}", params: {
+      request: { comment: { body: "Customer reply" } }
+    }, headers: customer_headers, as: :json
+    assert_response :unprocessable_content
+    assert_equal source_comment_count, source.comments.count
+
+    assert_raises(ActiveRecord::RecordInvalid) { source.update!(priority: "high") }
+    assert_raises(ActiveRecord::RecordInvalid) do
+      source.comments.create!(author: @customer, body: "Direct reply", public: true)
+    end
+  end
+
+  test "invalid merge attempts are rejected atomically" do
+    source = create_ticket(subject: "Duplicate")
+    other_request = create_ticket(requester: @other_customer, subject: "Other customer")
+    closed_target = create_ticket(subject: "Closed")
+    closed_target.update!(status: "closed")
+
+    post merge_path(source), params: { merge: { target_id: source.id } }, headers: owner_headers, as: :json
+    assert_response :unprocessable_content
+    assert_equal 1, source.comments.count
+    assert_equal "open", source.reload.status
+
+    post merge_path(source), params: { merge: { target_id: other_request.id } }, headers: owner_headers, as: :json
+    assert_response :unprocessable_content
+    assert_equal 1, source.comments.count
+    assert_equal 1, other_request.comments.count
+
+    post merge_path(source), params: { merge: { target_id: closed_target.id } }, headers: owner_headers, as: :json
+    assert_response :unprocessable_content
+    assert_equal 1, source.comments.count
+    assert_equal 1, closed_target.comments.count
+
+    post merge_path(source), params: { merge: { target_id: other_request.id } }, headers: customer_headers, as: :json
+    assert_response :forbidden
+    assert_equal "open", source.reload.status
+  end
+
+  private
+
+  def create_user(handle, name, role)
+    @account.users.create!(
+      name: name,
+      email: "#{handle}@acme.test",
+      password: "my-secure-password",
+      role: role,
+      verified: true
+    )
+  end
+
+  def create_ticket(requester: @customer, subject:, status: "open", assignee: nil, email_origin: false)
+    ticket = @account.tickets.create!(
+      requester: requester,
+      subject: subject,
+      status: status,
+      assignee: assignee,
+      email_origin: email_origin
+    )
+    ticket.comments.create!(author: requester, body: "Initial comment for #{subject}", public: true)
+    ticket
+  end
+
+  def merge_path(ticket)
+    "/api/v1/tickets/#{ticket.id}/merge"
+  end
+
+  def owner_headers
+    authenticated_headers(@owner_token)
+  end
+
+  def customer_headers
+    authenticated_headers(@customer_token)
+  end
+
+  def authenticated_headers(token)
+    {
+      "X-Helpdesk-Account" => @account.subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+
+  def json
+    JSON.parse(response.body)
+  end
+end
