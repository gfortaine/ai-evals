diff --git a/app/services/helpdesk/ticket_merger.rb b/app/services/helpdesk/ticket_merger.rb
new file mode 100644
index 0000000..236f24a
--- /dev/null
+++ b/app/services/helpdesk/ticket_merger.rb
@@ -0,0 +1,52 @@
+module Helpdesk
+  class TicketMerger
+    Result = Struct.new(:source, :target, keyword_init: true)
+
+    def initialize(account:, source:, target_id:, actor:, source_comment:, target_comment:)
+      @account = account
+      @source_id = source.id
+      @target_id = target_id
+      @actor = actor
+      @source_comment = source_comment
+      @target_comment = target_comment
+    end
+
+    def call
+      Ticket.transaction do
+        tickets = account.tickets
+          .where(id: [ source_id, target_id ].uniq)
+          .order(:id)
+          .lock
+          .index_by(&:id)
+        source = tickets[source_id]
+        target = tickets[target_id]
+        raise ActiveRecord::RecordNotFound, "Ticket not found" unless source && target
+
+        validate_merge!(source, target)
+        source.comments.create!(author: actor, **source_comment)
+        target.comments.create!(author: actor, **target_comment)
+        source.update!(status: Ticket::CLOSED_STATUS, assignee: nil, merged_into: target)
+
+        Result.new(source: source.reload, target: target.reload)
+      end
+    end
+
+    private
+
+    attr_reader :account, :source_id, :target_id, :actor, :source_comment, :target_comment
+
+    def validate_merge!(source, target)
+      reject!(source, :base, "A ticket cannot be merged into itself") if source.id == target.id
+      reject!(source, :base, "Closed tickets cannot be edited") if source.closed?
+      reject!(target, :base, "A closed ticket cannot receive merges") if target.closed?
+      if source.requester_id != target.requester_id
+        reject!(target, :requester, "must match the source ticket customer")
+      end
+    end
+
+    def reject!(record, attribute, message)
+      record.errors.add(attribute, message)
+      raise ActiveRecord::RecordInvalid, record
+    end
+  end
+end
