diff --git a/test/integration/staff_management_test.rb b/test/integration/staff_management_test.rb
new file mode 100644
index 0000000..73ee56f
--- /dev/null
+++ b/test/integration/staff_management_test.rb
@@ -0,0 +1,289 @@
+require "test_helper"
+require "uri"
+
+class StaffManagementTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @owner = create_user("owner", "Owner", "admin")
+    @account.update!(owner: @owner)
+    @customer = create_user("avery", "Avery", "customer")
+    @owner_token = Session.issue_for!(@owner).last
+    @customer_token = Session.issue_for!(@customer).last
+  end
+
+  test "admins create resend preview and accept staff invitations" do
+    post "/api/v1/invitations", params: {
+      invitation: { email: "SAM@example.test", role: "agent" }
+    }, headers: owner_headers, as: :json
+
+    assert_response :created
+    invitation_payload = json.fetch("invitation")
+    assert_equal "agent", invitation_payload.fetch("role")
+    assert_equal "pending", invitation_payload.fetch("status")
+    assert_equal "sam@example.test", invitation_payload.fetch("email")
+    invitation = Invitation.find(invitation_payload.fetch("id"))
+    assert invitation.expires_at.present?
+    assert_equal [ "sam@example.test" ], ActionMailer::Base.deliveries.last.to
+    assert_match %r{http://localhost:3001/accept-invitation\?account=acme&token=}, mail_text(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/invitations", params: {
+      invitation: { email: "sam@example.test", role: "admin" }
+    }, headers: owner_headers, as: :json
+    assert_response :unprocessable_content
+    assert_equal 1, @account.invitations.where(status: "pending").count
+
+    post "/api/v1/registrations", params: {
+      user: { name: "Sam", email: "sam@example.test", password: "customer-password" }
+    }, headers: account_headers, as: :json
+    assert_response :unprocessable_content
+    refute @account.users.exists?(email: "sam@example.test")
+
+    first_token = token_from(ActionMailer::Base.deliveries.last)
+    post "/api/v1/invitations/#{invitation.id}/resend", headers: owner_headers, as: :json
+    assert_response :success
+    second_token = token_from(ActionMailer::Base.deliveries.last)
+    refute_equal first_token, second_token
+
+    post "/invitation_previews", params: { invitation_preview: { token: first_token } }, as: :json
+    assert_response :unprocessable_content
+
+    post "/invitation_previews", params: { invitation_preview: { token: second_token } }, as: :json
+    assert_response :success
+    assert_equal({
+      "email" => "sam@example.test",
+      "role" => "agent",
+      "business_name" => "Acme",
+      "subdomain" => "acme"
+    }, json.fetch("invitation_preview").slice("email", "role", "business_name", "subdomain"))
+    assert json.fetch("invitation_preview").fetch("expires_at").present?
+
+    delivery_count = ActionMailer::Base.deliveries.length
+    post "/api/v1/invitation_acceptances", params: {
+      invitation_acceptance: {
+        token: second_token,
+        name: "Sam",
+        password: "team-member-password"
+      }
+    }, as: :json
+
+    assert_response :created
+    assert_equal true, json.dig("user", "verified")
+    assert_equal "agent", json.dig("user", "role")
+    assert_equal false, json.dig("user", "suspended")
+    assert_equal "acme", json.dig("account", "subdomain")
+    assert_equal delivery_count, ActionMailer::Base.deliveries.length
+    assert_equal "accepted", invitation.reload.status
+
+    post "/api/v1/sessions", params: {
+      session: { email: "sam@example.test", password: "team-member-password" }
+    }, headers: account_headers, as: :json
+    assert_response :success
+
+    get "/api/v1/invitations", params: { status: "accepted" }, headers: owner_headers
+    assert_response :success
+    assert_equal [ invitation.id ], json.fetch("invitations").map { |record| record.fetch("id") }
+  end
+
+  test "admins manage sorted staff and suspension clears access and assignments" do
+    second_admin = create_user("second-admin", "Second Admin", "admin")
+    agent = create_user("agent", "Agent", "agent")
+    suspended_agent = create_user("suspended", "Suspended", "agent", suspended: true)
+    agent_token = Session.issue_for!(agent).last
+    ticket = create_ticket
+    ticket.update!(assignee: agent)
+
+    get "/api/v1/users", headers: owner_headers
+    assert_response :success
+    assert_equal @account.users.order(:id).ids, json.fetch("users").map { |record| record.fetch("id") }
+
+    get "/api/v1/users", params: { role: "agent", suspended: false }, headers: owner_headers
+    assert_response :success
+    assert_equal [ agent.id ], json.fetch("users").map { |record| record.fetch("id") }
+
+    get "/api/v1/users/#{agent.id}", headers: owner_headers
+    assert_response :success
+    assert_equal false, json.dig("user", "suspended")
+
+    patch "/api/v1/users/#{agent.id}", params: {
+      user: { suspended: true }
+    }, headers: owner_headers, as: :json
+    assert_response :success
+    assert_equal true, json.dig("user", "suspended")
+    assert_nil ticket.reload.assignee_id
+    assert_equal 0, agent.sessions.reload.count
+
+    get "/api/v1/tickets", headers: authenticated_headers(agent_token)
+    assert_response :unauthorized
+
+    get "/api/v1/staff", headers: owner_headers
+    assert_response :success
+    assert_equal [ @owner.id, second_admin.id ], json.fetch("staff").map { |record| record.fetch("id") }
+    refute_includes json.fetch("staff").map { |record| record.fetch("id") }, suspended_agent.id
+
+    patch "/api/v1/users/#{second_admin.id}", params: {
+      user: { suspended: true }
+    }, headers: owner_headers, as: :json
+    assert_response :success
+
+    patch "/api/v1/users/#{@owner.id}", params: {
+      user: { suspended: true }
+    }, headers: owner_headers, as: :json
+    assert_response :unprocessable_content
+    assert_equal false, @owner.reload.suspended?
+
+    get "/api/v1/users", headers: authenticated_headers(agent_token)
+    assert_response :unauthorized
+  end
+
+  test "agents assign tickets and private notes do not change customer activity" do
+    agent = create_user("agent", "Agent", "agent")
+    agent_token = Session.issue_for!(agent).last
+    ticket = create_ticket
+    original_updated_at = ticket.reload.updated_at
+
+    patch "/api/v1/tickets/#{ticket.id}", params: {
+      ticket: { assignee_id: agent.id }
+    }, headers: authenticated_headers(agent_token), as: :json
+    assert_response :success
+    assert_equal agent.id, json.dig("ticket", "assignee_id")
+    assert_equal({ "id" => agent.id, "name" => "Agent" }, json.dig("ticket", "assignee"))
+    assert_equal original_updated_at, ticket.reload.updated_at
+
+    patch "/api/v1/tickets/#{ticket.id}", params: {
+      ticket: { comment: { body: "Checking this with billing.", public: false } }
+    }, headers: authenticated_headers(agent_token), as: :json
+    assert_response :success
+    assert_equal original_updated_at, ticket.reload.updated_at
+    assert_equal false, Comment.order(:id).last.public?
+
+    get "/api/v1/tickets/#{ticket.id}/comments", headers: authenticated_headers(agent_token)
+    assert_response :success
+    assert_includes json.fetch("comments").map { |comment| comment.fetch("body") }, "Checking this with billing."
+
+    get "/api/v1/requests/#{ticket.id}", headers: customer_headers
+    assert_response :success
+    assert_equal original_updated_at.iso8601(3), json.dig("request", "updated_at")
+
+    get "/api/v1/requests/#{ticket.id}/comments", headers: customer_headers
+    assert_response :success
+    refute_includes json.fetch("comments").map { |comment| comment.fetch("body") }, "Checking this with billing."
+
+    patch "/api/v1/tickets/#{ticket.id}", params: {
+      ticket: { assignee_id: nil }
+    }, headers: authenticated_headers(agent_token), as: :json
+    assert_response :success
+    assert_nil json.dig("ticket", "assignee_id")
+    assert_nil json.dig("ticket", "assignee")
+
+    patch "/api/v1/tickets/#{ticket.id}", params: {
+      ticket: { assignee_id: @customer.id }
+    }, headers: authenticated_headers(agent_token), as: :json
+    assert_response :unprocessable_content
+  end
+
+  test "only admins manage invitations and revoked invitations cannot be used" do
+    agent = create_user("agent", "Agent", "agent")
+    agent_token = Session.issue_for!(agent).last
+
+    post "/api/v1/invitations", params: {
+      invitation: { email: "sam@example.test", role: "agent" }
+    }, headers: authenticated_headers(agent_token), as: :json
+    assert_response :forbidden
+
+    get "/api/v1/users", headers: authenticated_headers(agent_token)
+    assert_response :forbidden
+
+    post "/api/v1/invitations", params: {
+      invitation: { email: "sam@example.test", role: "agent" }
+    }, headers: owner_headers, as: :json
+    invitation = Invitation.find(json.dig("invitation", "id"))
+    token = token_from(ActionMailer::Base.deliveries.last)
+
+    get "/api/v1/invitations/#{invitation.id}", headers: owner_headers
+    assert_response :success
+    assert_equal invitation.id, json.dig("invitation", "id")
+
+    delete "/api/v1/invitations/#{invitation.id}", headers: owner_headers
+    assert_response :no_content
+    assert_equal "revoked", invitation.reload.status
+
+    post "/invitation_previews", params: { invitation_preview: { token: token } }, as: :json
+    assert_response :unprocessable_content
+  end
+
+  test "expired invitations are tracked and cannot be accepted" do
+    post "/api/v1/invitations", params: {
+      invitation: { email: "sam@example.test", role: "admin" }
+    }, headers: owner_headers, as: :json
+    invitation = Invitation.find(json.dig("invitation", "id"))
+    token = token_from(ActionMailer::Base.deliveries.last)
+    invitation.update_columns(expires_at: 1.minute.ago)
+
+    get "/api/v1/invitations", params: { status: "expired" }, headers: owner_headers
+    assert_response :success
+    assert_equal [ invitation.id ], json.fetch("invitations").map { |record| record.fetch("id") }
+    assert_equal "expired", invitation.reload.status
+
+    post "/api/v1/invitation_acceptances", params: {
+      invitation_acceptance: {
+        token: token,
+        name: "Sam",
+        password: "team-member-password"
+      }
+    }, as: :json
+    assert_response :unprocessable_content
+  end
+
+  private
+
+  def create_user(handle, name, role, suspended: false)
+    @account.users.create!(
+      name: name,
+      email: "#{handle}@acme.test",
+      password: "my-secure-password",
+      role: role,
+      verified: true,
+      suspended: suspended
+    )
+  end
+
+  def create_ticket
+    ticket = @account.tickets.create!(
+      requester: @customer,
+      subject: "Billing question",
+      status: "open"
+    )
+    ticket.comments.create!(author: @customer, body: "Please help.", public: true)
+    ticket
+  end
+
+  def account_headers
+    { "X-Helpdesk-Account" => "acme" }
+  end
+
+  def authenticated_headers(token)
+    account_headers.merge("Authorization" => "Bearer #{token}")
+  end
+
+  def owner_headers
+    authenticated_headers(@owner_token)
+  end
+
+  def customer_headers
+    authenticated_headers(@customer_token)
+  end
+
+  def token_from(mail)
+    url = URI.extract(mail_text(mail), %w[http https]).first
+    URI.decode_www_form(URI(url).query).to_h.fetch("token")
+  end
+
+  def mail_text(mail)
+    mail.multipart? ? mail.text_part.body.decoded : mail.body.decoded
+  end
+
+  def json
+    JSON.parse(response.body)
+  end
+end
