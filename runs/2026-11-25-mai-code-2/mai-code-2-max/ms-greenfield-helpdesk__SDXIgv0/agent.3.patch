diff --git a/app/models/invitation.rb b/app/models/invitation.rb
new file mode 100644
index 0000000..576b6d4
--- /dev/null
+++ b/app/models/invitation.rb
@@ -0,0 +1,124 @@
+require "uri"
+
+class Invitation < ApplicationRecord
+  TOKEN_TTL = 7.days
+  STATUSES = %w[pending accepted revoked expired].freeze
+  STAFF_ROLES = %w[admin agent].freeze
+
+  belongs_to :account, inverse_of: :invitations
+  belongs_to :invited_by, class_name: "User", optional: true
+
+  before_validation :normalize_email
+
+  validates :email,
+    presence: true,
+    length: { maximum: 254 },
+    format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :role, inclusion: { in: STAFF_ROLES }
+  validates :status, inclusion: { in: STATUSES }
+  validates :sent_at, :expires_at, presence: true
+  validates :token_digest, presence: true, if: :pending?
+  validates :token_digest, uniqueness: true, allow_nil: true
+
+  scope :oldest_first, -> { order(:id) }
+
+  def self.expire_due!
+    now = Time.current
+    where(status: "pending").where("expires_at <= ?", now).update_all(
+      status: "expired",
+      token_digest: nil,
+      updated_at: now
+    )
+  end
+
+  def pending?
+    status == "pending"
+  end
+
+  def expire_if_due!
+    with_lock do
+      update!(status: "expired", token_digest: nil) if pending? && expires_at <= Time.current
+    end
+    self
+  end
+
+  def issue!(attributes = {})
+    token = Helpdesk::Tokens.generate
+    now = Time.current
+    assign_attributes(attributes.merge(
+      token_digest: Helpdesk::Tokens.digest(token),
+      sent_at: now,
+      expires_at: now + TOKEN_TTL,
+      status: "pending",
+      accepted_at: nil,
+      revoked_at: nil
+    ))
+    save!
+    token
+  end
+
+  def resend!
+    token = nil
+    with_lock do
+      expire_if_due_without_lock!
+      reject_unless_resendable!
+      token = issue!
+    end
+    token
+  end
+
+  def revoke!
+    with_lock do
+      expire_if_due_without_lock!
+      reject_operation!("Only pending invitations may be revoked") unless pending?
+
+      update!(status: "revoked", revoked_at: Time.current, token_digest: nil)
+    end
+  end
+
+  def accept!(token, name:, password:)
+    user = nil
+    with_lock do
+      expire_if_due_without_lock!
+      next unless valid_token?(token)
+
+      user = account.users.build(
+        name: name,
+        email: email,
+        role: role,
+        password: password,
+        verified: true,
+        suspended: false
+      )
+      user.save!
+      update!(status: "accepted", accepted_at: Time.current, token_digest: nil)
+    end
+    user
+  end
+
+  def valid_token?(token)
+    pending? && expires_at.future? && token_digest.present? &&
+      ActiveSupport::SecurityUtils.secure_compare(token_digest, Helpdesk::Tokens.digest(token))
+  end
+
+  private
+
+  def normalize_email
+    self.email = User.normalize_email(email)
+  end
+
+  def expire_if_due_without_lock!
+    update!(status: "expired", token_digest: nil) if pending? && expires_at <= Time.current
+  end
+
+  def reject_unless_resendable!
+    return if pending? || status == "expired"
+
+    reject_operation!("Only pending or expired invitations may be resent")
+  end
+
