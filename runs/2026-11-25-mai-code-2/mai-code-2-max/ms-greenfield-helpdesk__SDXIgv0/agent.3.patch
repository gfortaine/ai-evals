index 0000000..286fea6
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,36 @@
+module Api
+  module V1
+    class InvitationAcceptancesController < ApplicationController
+      def create
+        attributes = params.require(:invitation_acceptance).permit(:token, :name, :password)
+        token = attributes.require(:token).to_s
+        invitation = find_invitation_by_token(token)
+
+        unless invitation
+          render_error("The invitation link is invalid or has expired", status: :unprocessable_content)
+          return
+        end
+
+        if invitation.account.cancelled?
+          render_error("Account is cancelled", status: :forbidden)
+          return
+        end
+
+        user = invitation.accept!(
+          token,
+          name: attributes.require(:name),
+          password: attributes.require(:password)
+        )
+        unless user
+          render_error("The invitation link is invalid or has expired", status: :unprocessable_content)
+          return
+        end
+
+        render json: {
+          user: UserSerializer.new(user),
+          account: AccountSerializer.new(invitation.account)
+        }, status: :created
+      end
+    end
+  end
+end
