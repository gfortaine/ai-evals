@@ -1,2 +1,29 @@
 module TimeHelper
+  def local_time_tag(time, format: :smart, **options)
+    timestamp = time.utc.iso8601
+    data = options.delete(:data)&.dup || {}
+
+    data[:controller] = token_list(data[:controller], "local-time")
+    data[:action] = token_list(data[:action], "turbo:morph-element->local-time#update")
+    data[:local_time_datetime_value] = timestamp
+    data[:local_time_format_value] = format
+
+    tag.time timestamp,
+      datetime: timestamp,
+      class: token_list("local-time-value", options.delete(:class)),
+      data: data,
+      **options
+  end
+
+  def local_date_tag(time, **options)
+    local_time_tag time, format: :short_date, **options
+  end
+
+  def local_relative_time_tag(time, **options)
+    local_time_tag time, format: :relative, **options
+  end
+
+  def local_relative_date_tag(time, **options)
+    local_time_tag time, format: :relative_date, **options
+  end
 end
