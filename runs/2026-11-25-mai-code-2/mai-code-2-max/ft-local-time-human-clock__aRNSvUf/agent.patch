diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..263ff0e
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,70 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, isRelativeTimeFormat } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { datetime: String, format: String, gridColumn: Number }
+
+  #connected = false
+  #timer
+  #handleVisibilityChange = () => {
+    if (!document.hidden) this.update()
+  }
+
+  connect() {
+    this.#connected = true
+    document.addEventListener("visibilitychange", this.#handleVisibilityChange)
+    this.update()
+    this.#scheduleRefresh()
+  }
+
+  disconnect() {
+    this.#connected = false
+    document.removeEventListener("visibilitychange", this.#handleVisibilityChange)
+    clearInterval(this.#timer)
+  }
+
+  datetimeValueChanged() {
+    if (this.#connected) this.update()
+  }
+
+  formatValueChanged() {
+    if (this.#connected) {
+      this.update()
+      this.#scheduleRefresh()
+    }
+  }
+
+  update() {
+    if (!this.hasDatetimeValue) return
+
+    if (this.#rendersText) {
+      this.element.textContent = formatLocalTime(this.datetimeValue, this.#format)
+      this.element.title = formatLocalTime(this.datetimeValue, "full_date_time")
+      this.element.dataset.localTimeRendered = "true"
+      this.dispatch("rendered")
+    }
+
+    if (this.hasGridColumnValue) {
+      const hour = new Date(this.datetimeValue).getHours()
+      this.element.style.gridArea = `${25 - hour}/${this.gridColumnValue}`
+    }
+  }
+
+  get #format() {
+    return this.formatValue || "smart"
+  }
+
+  get #rendersText() {
+    return this.hasFormatValue || !this.hasGridColumnValue
+  }
+
+  #scheduleRefresh() {
+    clearInterval(this.#timer)
+
+    if (this.#rendersText && isRelativeTimeFormat(this.#format)) {
+      this.#timer = setInterval(() => this.update(), REFRESH_INTERVAL)
+    }
+  }
+}
