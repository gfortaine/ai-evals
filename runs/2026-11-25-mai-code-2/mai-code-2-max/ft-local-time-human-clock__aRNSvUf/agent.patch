diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..35ffae6
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders a cacheable UTC timestamp for browser-side formatting" do
+    Time.use_zone("America/New_York") do
+      timestamp = Time.zone.local(2025, 1, 2, 3, 4, 5)
+      html = local_time_tag(timestamp, format: :smart, class: "custom", data: { controller: "tooltip" })
+      time = Nokogiri::HTML.fragment(html).at_css("time")
+
+      assert_equal "2025-01-02T08:04:05Z", time.text
+      assert_equal "2025-01-02T08:04:05Z", time["datetime"]
+      assert_equal "2025-01-02T08:04:05Z", time["data-local-time-datetime-value"]
+      assert_equal "smart", time["data-local-time-format-value"]
+      assert_equal "tooltip local-time", time["data-controller"]
+      assert_equal "turbo:morph-element->local-time#update", time["data-action"]
+      assert_includes time["class"], "local-time-value"
+      assert_includes time["class"], "custom"
+    end
+  end
+
+  test "relative date helper uses calendar-day wording" do
+    time = Time.utc(2025, 1, 2, 23, 0, 0)
+    element = Nokogiri::HTML.fragment(local_relative_date_tag(time)).at_css("time")
+
+    assert_equal "relative_date", element["data-local-time-format-value"]
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..2b19ba3
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,39 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "formats timestamps in the viewer's timezone and uses relative calendar words" do
+    page.driver.browser.execute_cdp "Emulation.setTimezoneOverride", timezoneId: "America/New_York"
+    sign_in_as users(:david)
+
+    page.execute_script <<~JS
+      const NativeDate = window.Date
+      const now = NativeDate.parse("2025-09-18T19:42:00Z")
+
+      window.Date = class extends NativeDate {
+        constructor(...args) {
+          super(...(args.length ? args : [ now ]))
+        }
+
+        static now() { return now }
+      }
+
+      document.body.insertAdjacentHTML("beforeend", `
+        <time id="same-day" data-controller="local-time" data-local-time-datetime-value="2025-09-18T17:42:00Z" data-local-time-format-value="smart"></time>
+        <time id="last-night" data-controller="local-time" data-local-time-datetime-value="2025-09-17T22:00:00Z" data-local-time-format-value="smart"></time>
+        <time id="five-days-ago" data-controller="local-time" data-local-time-datetime-value="2025-09-13T19:42:00Z" data-local-time-format-value="smart"></time>
+        <time id="older" data-controller="local-time" data-local-time-datetime-value="2025-09-10T19:42:00Z" data-local-time-format-value="smart"></time>
+        <time id="tomorrow" data-controller="local-time" data-local-time-datetime-value="2025-09-19T04:00:00Z" data-local-time-format-value="relative_date"></time>
+        <time id="in-three-days" data-controller="local-time" data-local-time-datetime-value="2025-09-21T19:42:00Z" data-local-time-format-value="relative_date"></time>
+      `)
+    JS
+
+    assert_selector "#same-day", text: "1:42 PM"
+    assert_selector "#last-night", text: "yesterday"
+    assert_selector "#five-days-ago", text: "5 days ago"
+    assert_selector "#older", text: "Sep 10"
+    assert_selector "#tomorrow", text: "tomorrow"
+    assert_selector "#in-three-days", text: "in 3 days"
+  ensure
+    page.driver.browser.execute_cdp "Emulation.setTimezoneOverride", timezoneId: "UTC"
+  end
+end
