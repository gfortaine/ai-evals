diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..6669b82
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,69 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:david)
+  end
+
+  test "moves a card to another column without reordering within a column" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    visit board_url(card.board)
+    expand column
+
+    drag card, to: column
+    assert_moved card, to: column
+    assert_equal column, card.reload.column
+
+    last_active_at = card.last_active_at
+    order = card_ids_in(column)
+
+    drag card, to: column
+
+    assert_equal order, card_ids_in(column)
+    assert_equal last_active_at, card.reload.last_active_at
+  end
+
+  test "moves a card between status columns" do
+    card = cards(:buy_domain)
+
+    visit board_url(card.board)
+    expand "not-now"
+
+    drag card, to: "not-now"
+    assert_moved card, to: "not-now"
+    assert card.reload.postponed?
+
+    drag card, to: "maybe"
+    assert_moved card, to: "maybe"
+    assert card.reload.awaiting_triage?
+
+    expand "closed-cards"
+    drag card, to: "closed-cards"
+    assert_moved card, to: "closed-cards"
+    assert card.reload.closed?
+  end
+
+  private
+  def expand(column)
+    id = column.respond_to?(:id) ? dom_id(column) : column
+    find("##{id} .cards__expander").click
+  end
+
+  def drag(card, to:)
+    id = to.respond_to?(:id) ? dom_id(to) : to
+    find("##{dom_id(card, :article)}").drag_to find("##{id}")
+  end
+
+  def assert_moved(card, to:)
+    id = to.respond_to?(:id) ? dom_id(to) : to
+    assert_selector "##{id} ##{dom_id(card, :article)}:not([aria-busy='true'])", visible: :all
+  end
+
+  def card_ids_in(column)
+    all("##{dom_id(column)} .card", visible: :all).map { |element| element[:id] }
+  end
+end
