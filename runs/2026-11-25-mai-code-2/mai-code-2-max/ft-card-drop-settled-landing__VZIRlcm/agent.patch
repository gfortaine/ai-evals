diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..547c683
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,300 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+const CONTAINER_TARGET_SELECTOR = '[data-drag-and-drop-target~="container"]'
+const ITEM_TARGET_SELECTOR = '[data-drag-and-drop-target~="item"]'
+const CLICK_SUPPRESSION_DELAY = 100
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "item", "container" ]
+
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  #draggedItem
+  #hoverContainer
+  #suppressClick = false
+  #suppressClickTimeout
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  dragStart(event) {
+    const item = event.target instanceof Element ? event.target.closest(ITEM_TARGET_SELECTOR) : null
+
+    if (item && item.getAttribute("aria-busy") !== "true") {
+      this.#draggedItem = item
+      this.#suppressClick = true
+      clearTimeout(this.#suppressClickTimeout)
+      this.#draggedItem.classList.add(this.#draggedItemClassName)
+
+      if (event.dataTransfer) {
+        event.dataTransfer.effectAllowed = "move"
+        event.dataTransfer.setData("text/plain", item.id)
+      }
+    } else {
+      event.preventDefault()
+    }
+  }
+
+  dragEnter(event) {
+    this.#acceptDrop(event)
+  }
+
+  dragOver(event) {
+    this.#acceptDrop(event)
+  }
+
+  dragLeave(event) {
+    const container = this.#containerFrom(event.target)
+
+    const pointerIsStillInside = event.relatedTarget instanceof Node && container?.contains(event.relatedTarget)
+
+    if (container === this.#hoverContainer && !pointerIsStillInside) {
+      this.#clearHover()
+    }
+  }
+
+  drop(event) {
+    const destination = this.#containerFrom(event.target)
+
+    if (this.#draggedItem && destination) {
+      event.preventDefault()
+      event.stopPropagation()
+
+      const source = this.#containerFrom(this.#draggedItem)
+      const list = this.#listFor(destination)
+
+      if (source !== destination && list) {
+        const move = this.#move(this.#draggedItem, source, destination, list)
+        this.#finishDrag()
+        this.#save(move)
+      } else {
+        this.#finishDrag()
+      }
+    }
+  }
+
+  dragEnd() {
+    this.#finishDrag()
+  }
+
+  preventClick(event) {
+    if (this.#suppressClick) {
+      event.preventDefault()
+      event.stopPropagation()
+      this.#allowClick()
+    }
+  }
+
+  disconnect() {
+    this.#finishDrag()
+    this.#allowClick()
+  }
+
+  #acceptDrop(event) {
+    const container = this.#containerFrom(event.target)
+
+    if (this.#draggedItem && container) {
+      event.preventDefault()
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    }
+  }
+
+  #highlight(container) {
+    if (this.#hoverContainer !== container) {
+      this.#clearHover()
+      container.classList.add(this.#hoverContainerClassName)
+      this.#hoverContainer = container
+    }
+  }
+
+  #clearHover() {
+    this.#hoverContainer?.classList.remove(this.#hoverContainerClassName)
+    this.#hoverContainer = null
+  }
+
+  #finishDrag() {
+    const wasDragging = !!this.#draggedItem
+
+    this.#draggedItem?.classList.remove(this.#draggedItemClassName)
+    this.#draggedItem = null
+    this.#clearHover()
+
+    if (wasDragging) {
+      this.#suppressClickTimeout = setTimeout(() => this.#allowClick(), CLICK_SUPPRESSION_DELAY)
+    }
+  }
+
+  #allowClick() {
+    clearTimeout(this.#suppressClickTimeout)
+    this.#suppressClick = false
+  }
+
+  #move(item, source, destination, list) {
+    const snapshot = {
+      item,
+      source,
+      destination,
+      sourceParent: item.parentElement,
+      sourceNextSibling: item.nextSibling,
+      className: item.className,
+      style: item.getAttribute("style"),
+      stamps: this.#snapshotStamps(item),
+      columnIndicators: this.#snapshotColumnIndicators(item)
+    }
+
+    this.#insertInColumnOrder(item, destination, list)
+    this.#updateItem(item, destination)
+    this.#updateCount(source, -1)
+    this.#updateCount(destination, 1)
+
+    return snapshot
+  }
+
+  #insertInColumnOrder(item, destination, list) {
+    const existingCards = [ ...list.querySelectorAll(".card") ].filter(card => card !== item)
+    const preserveGoldenOrder = destination.dataset.dragAndDropType === "column" || destination.dataset.dragAndDropType === "stream"
+
+    if (preserveGoldenOrder && !item.classList.contains("golden-effect")) {
+      const firstNonGoldenCard = existingCards.find(card => !card.classList.contains("golden-effect"))
+      const lastGoldenCard = [ ...existingCards ].reverse().find(card => card.classList.contains("golden-effect"))
+
+      if (firstNonGoldenCard) {
+        firstNonGoldenCard.before(item)
+      } else if (lastGoldenCard) {
+        lastGoldenCard.after(item)
+      } else {
+        list.prepend(item)
+      }
+    } else if (existingCards.length) {
+      existingCards[0].before(item)
+    } else {
+      list.prepend(item)
+    }
+  }
+
+  #updateItem(item, destination) {
+    const type = destination.dataset.dragAndDropType
+    const active = type === "column" || type === "stream"
+    const color = getComputedStyle(destination).getPropertyValue("--card-color")
+
+    item.classList.toggle("card--active", active)
+    item.classList.toggle("card--postponed", type === "not-now")
+    item.querySelectorAll(".card__closed").forEach(stamp => stamp.remove())
+    item.querySelectorAll(".card__stages [data-drag-and-drop-column-id]").forEach(indicator => {
+      indicator.classList.toggle("card__column-name--current", indicator.dataset.dragAndDropColumnId === destination.dataset.dragAndDropColumnId)
+    })
+
+    if (color) item.style.setProperty("--card-color", color)
+  }
+
+  async #save(move) {
+    move.item.setAttribute("aria-busy", "true")
+
+    try {
+      const response = await this.#requestMove(move)
+      if (!response.ok) throw new Error(`Saving the move failed with ${response.statusCode}`)
+    } catch (error) {
+      this.#rollback(move)
+      console.error("Could not save the card move", error)
+    } finally {
+      move.item.removeAttribute("aria-busy")
+    }
+  }
+
+  #requestMove({ item, destination }) {
+    const options = { responseKind: "json" }
+
+    switch (destination.dataset.dragAndDropType) {
+      case "column":
+        return post(item.dataset.cardTriageUrl, { ...options, query: { column_id: destination.dataset.dragAndDropColumnId } })
+      case "stream":
+        return destroy(item.dataset.cardTriageUrl, options)
+      case "not-now":
+        return post(item.dataset.cardNotNowUrl, options)
+      case "closed":
+        return post(item.dataset.cardClosureUrl, options)
+      default:
+        return Promise.reject(new Error(`Unknown drop destination: ${destination.dataset.dragAndDropType}`))
+    }
+  }
+
+  #rollback(move) {
+    const { item, source, sourceParent, sourceNextSibling, destination } = move
+
+    if (sourceParent?.isConnected) {
+      if (sourceNextSibling?.parentNode === sourceParent) {
+        sourceParent.insertBefore(item, sourceNextSibling)
+      } else {
+        sourceParent.append(item)
+      }
+    } else {
+      const currentSource = source?.isConnected ? source : document.getElementById(source?.id)
+      this.#listFor(currentSource)?.prepend(item)
+    }
+
+    item.className = move.className
+    if (move.style) {
+      item.setAttribute("style", move.style)
+    } else {
+      item.removeAttribute("style")
+    }
+
+    move.stamps.forEach(({ stamp, parent, nextSibling }) => parent.insertBefore(stamp, nextSibling))
+    move.columnIndicators.forEach(({ indicator, current }) => indicator.classList.toggle("card__column-name--current", current))
+    this.#updateCount(source, 1)
+    this.#updateCount(destination, -1)
+  }
+
+  #snapshotStamps(item) {
+    return [ ...item.querySelectorAll(".card__closed") ].map(stamp => ({
+      stamp,
+      parent: stamp.parentElement,
+      nextSibling: stamp.nextSibling
+    }))
+  }
+
+  #snapshotColumnIndicators(item) {
+    return [ ...item.querySelectorAll(".card__stages [data-drag-and-drop-column-id]") ].map(indicator => ({
+      indicator,
+      current: indicator.classList.contains("card__column-name--current")
+    }))
+  }
+
+  #updateCount(container, change) {
+    const countElement = container?.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const count = Number.parseInt(countElement.dataset.dragAndDropCount)
+    if (Number.isNaN(count)) return
+
+    const updatedCount = Math.max(0, count + change)
+    countElement.dataset.dragAndDropCount = updatedCount
+    countElement.textContent = updatedCount > 99 ? "99+" : updatedCount
+
+    const counter = countElement.closest('[data-css-variable-counter-target~="counter"]')
+    counter?.style.setProperty("--card-count", Math.min(updatedCount, 15))
+  }
+
+  #containerFrom(element) {
+    return element instanceof Element ? element.closest(CONTAINER_TARGET_SELECTOR) : null
+  }
+
+  #listFor(container) {
+    return container?.querySelector(".cards__list")
+  }
+
+  get #draggedItemClassName() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : "drag-and-drop__dragged-item"
+  }
+
+  get #hoverContainerClassName() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : "drag-and-drop__hover-container"
+  }
+}
