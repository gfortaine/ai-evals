@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "release caches the published title" do
+    book = books(:manual)
+
+    assert Book.finalize_release(book.id, title: "Published title", subtitle: "A subtitle")
+
+    assert_equal "Published title", book.reload.title
+    assert book.published?
+    assert_equal({ title: "Published title", published: true }, book.cached_recap)
+  end
+
+  test "saving one book does not replace another book's recap" do
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    handbook.update! title: "Updated handbook"
+    manual.update! title: "Updated manual"
+    handbook.update! title: "Latest handbook"
+
+    assert_equal "Latest handbook", handbook.cached_recap[:title]
+    assert_equal "Updated manual", manual.cached_recap[:title]
+  end
+
+  test "recaps expire on the configured schedule" do
+    book = books(:handbook)
+
+    freeze_time
+    book.update! title: "An updated title"
+
+    assert_equal "An updated title", book.cached_recap[:title]
+
+    travel Rails.application.config.x.recap.expires_in + 1.second
+    assert_nil book.cached_recap
+  end
+end
