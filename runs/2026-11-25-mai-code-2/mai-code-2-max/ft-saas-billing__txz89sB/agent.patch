+class Account::BillingPortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    if customer_id = Current.account.stripe_customer_id
+      session = Stripe::BillingPortal::Session.create(
+        customer: customer_id,
+        return_url: main_app.account_settings_url(script_name: Current.account.slug)
+      )
+
+      redirect_to session.url, allow_other_host: true
+    else
+      redirect_to saas.new_account_billing_path(script_name: Current.account.slug),
+        alert: "Choose a plan to get started"
+    end
+  end
+end
diff --git a/saas/app/controllers/account/billings_controller.rb b/saas/app/controllers/account/billings_controller.rb
new file mode 100644
index 0000000..0656ed5
--- /dev/null
+++ b/saas/app/controllers/account/billings_controller.rb
@@ -0,0 +1,45 @@
+class Account::BillingsController < ApplicationController
+  before_action :ensure_admin
+
+  def new
+    @plans = Subscription.paid_plans
+  end
+
+  def create
+    if plan = Subscription.checkout_plan(params[:plan].presence || "MonthlyV1")
+      session = Stripe::Checkout::Session.create(**checkout_session_attributes(plan))
+      redirect_to session.url, allow_other_host: true
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  private
+    def checkout_session_attributes(plan)
+      {
+        mode: "subscription",
+        line_items: plan.stripe_price_ids.map { |price| { price: price, quantity: 1 } },
+        success_url: main_app.account_settings_url(script_name: Current.account.slug),
+        cancel_url: main_app.account_settings_url(script_name: Current.account.slug),
+        client_reference_id: Current.account.id.to_s,
+        metadata: {
+          account_id: Current.account.id.to_s,
+          account_external_id: Current.account.external_account_id.to_s,
+          plan_key: plan.short_name
+        },
+        subscription_data: {
+          metadata: {
+            account_id: Current.account.id.to_s,
+            account_external_id: Current.account.external_account_id.to_s,
+            plan_key: plan.short_name
+          }
+        }
+      }.tap do |attributes|
+        if customer_id = Current.account.stripe_customer_id
+          attributes[:customer] = customer_id
+        else
+          attributes[:customer_email] = Current.account.owner_email
+        end
+      end
+    end
+end
