diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..2f7d397
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+require "ostruct"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  test "syncs Stripe subscription state to an account" do
+    account = accounts(:initech)
+    stripe_subscription = OpenStruct.new(
+      id: "sub_sync",
+      customer: "cus_sync",
+      status: "active",
+      current_period_end: 1.month.from_now.to_i,
+      cancel_at: nil,
+      metadata: { account_id: account.id, plan_key: "MonthlyV1" },
+      items: OpenStruct.new(data: [])
+    )
+
+    subscription = Account::Subscription.sync_from_stripe!(stripe_subscription)
+
+    assert_equal account, subscription.account
+    assert_equal "MonthlyV1", subscription.plan_key
+    assert_equal "active", subscription.status
+    assert subscription.paid?
+  end
+
+  test "recognizes Unlimited+ from its Stripe prices" do
+    with_env(
+      "STRIPE_MONTHLY_V1_PRICE_ID" => "price_monthly",
+      "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_extra"
+    ) do
+      stripe_subscription = OpenStruct.new(
+        id: "sub_plus_sync",
+        customer: "cus_plus_sync",
+        status: "active",
+        metadata: { account_id: accounts(:initech).id },
+        items: OpenStruct.new(data: [
+          OpenStruct.new(price: OpenStruct.new(id: "price_monthly")),
+          OpenStruct.new(price: OpenStruct.new(id: "price_extra"))
+        ])
+      )
+
+      subscription = Account::Subscription.sync_from_stripe!(stripe_subscription)
+      assert_equal "MonthlyExtraStorageV1", subscription.plan_key
+    end
+  end
+
+  private
+    def with_env(variables)
+      originals = variables.to_h { |key, _value| [ key, ENV[key] ] }
+      variables.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
+
+class SubscriptionTest < ActiveSupport::TestCase
+  test "checkout recognizes plan display names without losing the plus" do
+    assert_equal Subscription::MonthlyV1, Subscription.checkout_plan("unlimited")
+    assert_equal Subscription::MonthlyExtraStorageV1, Subscription.checkout_plan("Unlimited+")
+    assert_equal Subscription::MonthlyExtraStorageV1, Subscription.checkout_plan("unlimited_plus")
+    assert_nil Subscription.checkout_plan("Free")
+  end
+end
