index 0000000..b23cd4c
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,21 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(
+      request.raw_post,
+      request.headers["Stripe-Signature"],
+      ENV.fetch("STRIPE_WEBHOOK_SECRET")
+    )
+
+    if event.type.in?(%w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted ])
+      Account::Subscription.sync_from_stripe!(event.data.object)
+    end
+
+    head :no_content
+  rescue Stripe::SignatureVerificationError, JSON::ParserError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..69fc139
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,102 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  CARD_WARNING_THRESHOLD = 100
+
+  included do
+    has_many :account_subscriptions, class_name: "Account::Subscription", dependent: :destroy
+    has_one :subscription, -> { order(created_at: :desc) }, class_name: "Account::Subscription", inverse_of: :account
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limit, dependent: :destroy
+  end
+
+  def billing_subscription
+    account_subscriptions.order(created_at: :desc).first
+  end
+  alias_method :current_subscription, :billing_subscription
+
+  def billing_plan
+    if comped?
+      Subscription::MonthlyExtraStorageV1
+    else
+      subscription = billing_subscription
+      subscription&.paid? ? subscription.plan : Subscription::FreeV1
+    end
+  end
+  alias_method :plan_definition, :billing_plan
+
+  def paid?
+    billing_plan.paid?
+  end
+
+  def comped?
+    Account::BillingWaiver.exists?(account_id: id)
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+    billing_waiver
+  end
+  alias_method :comp!, :comp
+
+  def uncomp
+    Account::BillingWaiver.find_by(account_id: id)&.destroy!
+    association(:billing_waiver).reset
+  end
+  alias_method :uncomp!, :uncomp
+
+  def comped=(value)
+    ActiveModel::Type::Boolean.new.cast(value) ? comp : uncomp
+  end
+
+  def stripe_customer_id
+    billing_subscription&.stripe_customer_id
+  end
+
+  def card_count
+    overridden_limit&.card_count || cards_count
+  end
+  alias_method :billable_card_count, :card_count
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def cards_remaining
+    card_limit && [ card_limit - card_count, 0 ].max
+  end
+  alias_method :cards_left, :cards_remaining
+
+  def card_limit_reached?
+    card_limit && card_count >= card_limit
+  end
+
+  def card_limit_exceeded?
+    card_limit && card_count > card_limit
+  end
+  alias_method :exceeding_card_limit?, :card_limit_exceeded?
+
+  def nearing_card_limit?
+    cards_remaining && !card_limit_exceeded? && cards_remaining <= CARD_WARNING_THRESHOLD
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  def override_limits(card_count:, bytes_used:)
+    overridden_limit = self.overridden_limit || build_overridden_limit
+    overridden_limit.update!(card_count: card_count, bytes_used: bytes_used)
+    association(:overridden_limit).reset
+    overridden_limit
+  end
+  alias_method :override_limits!, :override_limits
+
+  def reset_limits
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+  end
+  alias_method :reset_override, :reset_limits
+  alias_method :reset_overridden_limits, :reset_limits
+  alias_method :reset_overridden_limits!, :reset_limits
+end
