@@ -0,0 +1,65 @@
+require "test_helper"
+require "ostruct"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  test "subscription changes mirror Stripe state" do
+    account = accounts(:initech)
+    stripe_subscription = OpenStruct.new(
+      id: "sub_webhook",
+      customer: "cus_webhook",
+      status: "active",
+      metadata: { account_id: account.id, plan_key: "MonthlyV1" },
+      items: OpenStruct.new(data: []),
+      current_period_end: 1.month.from_now.to_i,
+      cancel_at: nil
+    )
+    event = OpenStruct.new(type: "customer.subscription.updated", data: OpenStruct.new(object: stripe_subscription))
+
+    Stripe::Webhook.expects(:construct_event).once.returns(event)
+
+    with_env "STRIPE_WEBHOOK_SECRET" => "whsec_test" do
+      untenanted do
+        post "/stripe/webhooks", params: "{}", headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "signature" }
+      end
+    end
+
+    assert_response :no_content
+    subscription = account.account_subscriptions.find_by!(stripe_subscription_id: "sub_webhook")
+    assert_equal "active", subscription.status
+    assert_equal "MonthlyV1", subscription.plan_key
+
+    stripe_subscription.status = "canceled"
+    event.type = "customer.subscription.deleted"
+    Stripe::Webhook.expects(:construct_event).once.returns(event)
+
+    with_env "STRIPE_WEBHOOK_SECRET" => "whsec_test" do
+      untenanted do
+        post "/stripe/webhooks", params: "{}", headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "signature" }
+      end
+    end
+
+    assert_equal "canceled", subscription.reload.status
+    assert_equal Subscription::FreeV1, account.reload.billing_plan
+  end
+
+  test "invalid signatures are rejected" do
+    Stripe::Webhook.stubs(:construct_event).raises(Stripe::SignatureVerificationError.new("bad signature", nil, http_body: "{}"))
+
+    with_env "STRIPE_WEBHOOK_SECRET" => "whsec_test" do
+      untenanted do
+        post "/stripe/webhooks", params: "{}", headers: { "CONTENT_TYPE" => "application/json" }
+      end
+    end
+
+    assert_response :bad_request
+  end
+
+  private
+    def with_env(variables)
+      originals = variables.to_h { |key, _value| [ key, ENV[key] ] }
+      variables.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..441619b
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free accounts have the approved limits" do
+    assert_equal Subscription::FreeV1, @account.billing_plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "paid accounts receive their plan's storage allowance" do
+    assert_equal Subscription::FreeV1, @account.billing_plan
+    @account.account_subscriptions.create!(
+      stripe_customer_id: "cus_monthly",
+      stripe_subscription_id: "sub_monthly",
+      plan_key: "MonthlyV1",
+      status: "active"
+    )
+
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_nil @account.card_limit
+    assert @account.paid?
+  end
+
+  test "Unlimited+ includes the extra storage allowance" do
+    @account.account_subscriptions.create!(
+      stripe_customer_id: "cus_plus",
+      stripe_subscription_id: "sub_plus",
+      plan_key: "MonthlyExtraStorageV1",
+      status: "active"
+    )
+
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "card warning counts down from 100 remaining cards" do
+    @account.update_column(:cards_count, 950)
+
+    assert_equal 50, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_not @account.card_limit_exceeded?
+  end
+
+  test "the last in-limit draft can publish but API creation has no room" do
+    @account.update_column(:cards_count, 1_000)
+
+    assert @account.card_limit_reached?
+    assert_not @account.card_limit_exceeded?
+
+    @account.update_column(:cards_count, 1_001)
+    assert @account.card_limit_exceeded?
+  end
+
+  test "comping gives an account unlimited cards and the largest storage allowance" do
+    @account.comp
+
+    assert @account.comped?
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert_nil @account.card_limit
+
+    @account.uncomp
+    assert_not @account.comped?
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "support can override and reset usage counts" do
+    @account.override_limits(card_count: 321, bytes_used: 654)
+
+    assert_equal 321, @account.reload.card_count
+    assert_equal 654, @account.bytes_used
+
+    @account.reset_limits
+
+    assert_equal @account.cards_count, @account.card_count
+    assert_equal 0, @account.bytes_used
+  end
+end
