+<% @page_title = "Upgrade your plan" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--centered flex flex-column gap shadow" style="--panel-size: min(60ch, 100%);">
+  <div class="flex align-center gap">
+    <strong class="flex-item-grow txt-large">Free</strong>
+    <strong>$0/month</strong>
+  </div>
+  <div>1,000 cards and 1 GB of storage.</div>
+
+  <% @plans.each do |plan| %>
+    <section class="flex flex-column gap-half">
+      <div class="flex align-center gap">
+        <strong class="flex-item-grow txt-large"><%= plan.display_name %></strong>
+        <strong><%= number_to_currency(plan.price, precision: 0) %>/month</strong>
+      </div>
+      <div>
+        Unlimited cards and <%= number_to_human_size(plan.storage_limit) %> of storage.
+      </div>
+      <%= button_to "Choose #{plan.display_name}", saas.account_billing_path(script_name: Current.account.slug),
+            params: { plan: plan.short_name }, form: { data: { turbo: false } }, class: "btn btn--reversed" %>
+    </section>
+  <% end %>
+
+  <%= link_to "Back to account settings", main_app.account_settings_path(script_name: Current.account.slug), class: "btn" %>
+</section>
diff --git a/saas/app/views/account/settings/saas/_billing.html.erb b/saas/app/views/account/settings/saas/_billing.html.erb
