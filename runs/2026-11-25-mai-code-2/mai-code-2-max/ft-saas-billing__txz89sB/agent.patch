diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..d1b5ac6
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,112 @@
+class Account::Subscription < SaasRecord
+  PAID_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  scope :paid, -> { where(status: PAID_STATUSES) }
+
+  class << self
+    def sync_from_stripe!(stripe_subscription)
+      account = account_for(stripe_subscription)
+      record = find_by(stripe_subscription_id: value_from(stripe_subscription, :id)) ||
+        find_by(stripe_customer_id: customer_id_from(stripe_subscription)) ||
+        account.subscription || new(account: account)
+
+      if record.account != account
+        raise ActiveRecord::RecordNotFound, "Stripe subscription belongs to another account"
+      end
+
+      record.update!(attributes_from(stripe_subscription))
+      account.association(:subscription).reset
+      record
+    end
+
+    private
+      def account_for(stripe_subscription)
+        metadata = metadata_from(stripe_subscription)
+        account_id = metadata[:account_id]
+        external_account_id = metadata[:account_external_id]
+
+        account = if account_id.present?
+          Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id)
+        end
+        account ||= Account.find_by(external_account_id: external_account_id) if external_account_id.present?
+        account ||= find_by(stripe_subscription_id: value_from(stripe_subscription, :id))&.account
+        account ||= find_by(stripe_customer_id: customer_id_from(stripe_subscription))&.account
+
+        account || raise(ActiveRecord::RecordNotFound, "No account for Stripe subscription")
+      end
+
+      def customer_id_from(stripe_subscription)
+        customer = value_from(stripe_subscription, :customer)
+        value_from(customer, :id).presence || customer
+      end
+
+      def attributes_from(stripe_subscription)
+        {
+          stripe_customer_id: customer_id_from(stripe_subscription),
+          stripe_subscription_id: value_from(stripe_subscription, :id),
+          plan_key: plan_key_from(stripe_subscription),
+          status: value_from(stripe_subscription, :status),
+          current_period_end: timestamp_from(value_from(stripe_subscription, :current_period_end)),
+          cancel_at: timestamp_from(value_from(stripe_subscription, :cancel_at)),
+          next_amount_due_in_cents: value_from(stripe_subscription, :next_amount_due_in_cents)
+        }
+      end
+
+      def plan_key_from(stripe_subscription)
+        price_ids = items_from(stripe_subscription).filter_map do |item|
+          price = value_from(item, :price) || value_from(item, :plan)
+          value_from(price, :id)
+        end
+
+        if plan = ::Subscription.for_stripe_price_ids(price_ids)
+          plan.short_name
+        else
+          plan_key = metadata_from(stripe_subscription)[:plan_key].presence
+          ::Subscription.for_plan_key(plan_key || "MonthlyV1").short_name
+        end
+      end
+
+      def items_from(stripe_subscription)
+        items = value_from(stripe_subscription, :items)
+
+        if items.is_a?(Array)
+          items
+        else
+          value_from(items, :data) || []
+        end
+      end
+
+      def metadata_from(stripe_subscription)
+        metadata = value_from(stripe_subscription, :metadata)
+        metadata.respond_to?(:to_h) ? metadata.to_h.with_indifferent_access : {}.with_indifferent_access
+      end
+
+      def value_from(object, attribute)
+        if object.respond_to?(attribute)
+          object.public_send(attribute)
+        elsif object.respond_to?(:key?)
+          object[attribute] || object[attribute.to_s]
+        end
+      end
+
+      def timestamp_from(value)
+        if value.present?
+          value.respond_to?(:to_time) ? value.to_time : Time.at(value)
+        end
+      end
+  end
+
+  def paid?
+    status.in?(PAID_STATUSES)
+  end
+  alias_method :active?, :paid?
+
+  def plan
+    ::Subscription.for_plan_key(plan_key.presence || "MonthlyV1")
+  end
+end
diff --git a/saas/app/models/subscription.rb b/saas/app/models/subscription.rb
index 5efb1a7..2032dda 100644
--- a/saas/app/models/subscription.rb
+++ b/saas/app/models/subscription.rb
@@ -1,13 +1,87 @@
 class Subscription < Queenbee::Subscription
-  SHORT_NAMES = %w[ FreeV1 ]
+  SHORT_NAMES = %w[ FreeV1 MonthlyV1 MonthlyExtraStorageV1 ]
+
+  class << self
+    def all_plans
+      SHORT_NAMES.map { |short_name| const_get(short_name, false) }
+    end
+
+    def for_plan_key(plan_key)
+      plan_matching(plan_key) || FreeV1
+    end
+
+    def checkout_plan(plan_key)
+      plan = plan_matching(plan_key)
+      plan if plan&.paid?
+    end
+
+    def for_stripe_price_ids(price_ids)
+      return unless price_ids.present?
+
+      paid_plans.sort_by { |plan| -plan.stripe_price_environment_variables.size }.find do |plan|
+        plan.stripe_price_environment_variables.all? { |variable| price_ids.include?(ENV[variable]) }
+      end
+    end
+
+    def paid_plans
+      all_plans.select(&:paid?)
+    end
+
+    private
+      def plan_matching(plan_key)
+        normalized_key = normalize_plan_key(plan_key)
+
+        all_plans.find do |plan|
+          [ plan.short_name, plan.display_name ].any? do |name|
+            normalize_plan_key(name) == normalized_key
+          end
+        end
+      end
+
+      def normalize_plan_key(plan_key)
+        plan_key.to_s.downcase.gsub("+", "plus").gsub(/[\s_-]/, "")
+      end
+  end
 
   def self.short_name
     name.demodulize
   end
 
+  def self.paid?
+    price.positive?
+  end
+
+  def self.stripe_price_ids
+    stripe_price_environment_variables.map { |variable| ENV.fetch(variable) }
+  end
+
   class FreeV1 < Subscription
-    property :proper_name,  "Free Subscription"
-    property :price,        0
-    property :frequency,    "yearly"
+    property :proper_name,                        "Free Subscription"
+    property :display_name,                       "Free"
+    property :price,                              0
+    property :frequency,                          "yearly"
+    property :card_limit,                         1_000
+    property :storage_limit,                      1.gigabyte
+    property :stripe_price_environment_variables, []
+  end
+
+  class MonthlyV1 < Subscription
+    property :proper_name,                        "Unlimited Subscription"
+    property :display_name,                       "Unlimited"
+    property :price,                              20
+    property :frequency,                          "monthly"
+    property :card_limit,                         nil
+    property :storage_limit,                      5.gigabytes
+    property :stripe_price_environment_variables, [ "STRIPE_MONTHLY_V1_PRICE_ID" ]
+  end
