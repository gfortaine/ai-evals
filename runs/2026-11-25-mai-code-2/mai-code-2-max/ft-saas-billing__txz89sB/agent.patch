diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..42457a8
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,60 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Account</h2>
+      </header>
+      <div class="flex flex-column gap-half">
+        <div>#<%= @account.external_account_id %></div>
+        <div><%= @account.owner_email || "No owner" %></div>
+        <div><strong>Plan:</strong> <%= @account.billing_plan.display_name %></div>
+        <div><strong>Cards:</strong> <%= number_with_delimiter(@account.card_count) %></div>
+        <div><strong>Bytes used:</strong> <%= number_with_delimiter(@account.bytes_used) %></div>
+        <% if @account.subscription %>
+          <div><strong>Subscription:</strong> <%= @account.subscription.status %></div>
+          <div><strong>Stripe customer:</strong> <%= @account.subscription.stripe_customer_id %></div>
+        <% end %>
+      </div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Comp</h2>
+      </header>
+      <div class="flex gap-half">
+        <%= button_to "Comp", saas.admin_account_comp_path(@account), class: "btn", disabled: @account.comped? %>
+        <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn", disabled: !@account.comped? %>
+      </div>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Usage override</h2>
+      </header>
+
+      <%= form_with model: @overridden_limit, url: saas.admin_account_override_path(@account), scope: :override, method: :post, class: "flex flex-column gap" do |form| %>
+        <div>
+          <%= form.label :card_count, "Card count" %>
+          <%= form.number_field :card_count, min: 0, required: true, class: "input full-width" %>
+        </div>
+
+        <div>
+          <%= form.label :bytes_used, "Bytes used" %>
+          <%= form.number_field :bytes_used, min: 0, required: true, class: "input full-width" %>
+        </div>
+
+        <%= form.button "Override", class: "btn btn--reversed" %>
+      <% end %>
+
+      <%= button_to "Reset", saas.admin_account_override_path(@account), method: :delete, class: "btn" %>
+    </section>
+  </div>
+</section>
