diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..ce2766b
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,116 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_AFTER = 2.weeks
+  COMMENT_BURST_MINIMUM = 3
+  COMMENT_BURST_COMMENTERS_MINIMUM = 2
+  COMMENT_BURST_PERIOD_DIVISOR = 3
+
+  included do
+    scope :with_burst, -> { where(burst_condition) }
+    scope :stalled, -> { active.with_burst.where(last_active_at: ..STALL_AFTER.ago) }
+  end
+
+  class_methods do
+    def burst_condition
+      [ assignment_burst_condition, reopening_burst_condition, comment_burst_condition ].join(" OR ")
+    end
+
+    private
+      def assignment_burst_condition
+        <<~SQL.squish
+          EXISTS (
+            SELECT 1
+            FROM assignments burst_assignments
+            WHERE burst_assignments.card_id = cards.id
+          ) OR EXISTS (
+            SELECT 1
+            FROM events burst_assignment_events
+            WHERE burst_assignment_events.eventable_type = 'Card'
+              AND burst_assignment_events.eventable_id = cards.id
+              AND burst_assignment_events.action = 'card_assigned'
+          )
+        SQL
+      end
+
+      def reopening_burst_condition
+        <<~SQL.squish
+          EXISTS (
+            SELECT 1
+            FROM events burst_reopening_events
+            WHERE burst_reopening_events.eventable_type = 'Card'
+              AND burst_reopening_events.eventable_id = cards.id
+              AND burst_reopening_events.action = 'card_reopened'
+          )
+        SQL
+      end
+
+      def comment_burst_condition
+        # Anchor the window at every comment so overlapping bursts are found.
+        window_start = connection.date_subtract("burst_comments.created_at", comment_burst_period)
+
+        <<~SQL.squish
+          EXISTS (
+            SELECT 1
+            FROM comments burst_comments
+            INNER JOIN users burst_comment_creators ON burst_comment_creators.id = burst_comments.creator_id
+            WHERE burst_comments.card_id = cards.id
+              AND burst_comment_creators.role != 'system'
+              AND (
+                SELECT COUNT(*)
+                FROM comments burst_window_comments
+                INNER JOIN users burst_window_creators ON burst_window_creators.id = burst_window_comments.creator_id
+                WHERE burst_window_comments.card_id = cards.id
+                  AND burst_window_creators.role != 'system'
+                  AND burst_window_comments.created_at BETWEEN #{window_start} AND burst_comments.created_at
+              ) >= #{COMMENT_BURST_MINIMUM}
+              AND (
+                SELECT COUNT(DISTINCT burst_window_comments.creator_id)
+                FROM comments burst_window_comments
+                INNER JOIN users burst_window_creators ON burst_window_creators.id = burst_window_comments.creator_id
+                WHERE burst_window_comments.card_id = cards.id
+                  AND burst_window_creators.role != 'system'
+                  AND burst_window_comments.created_at BETWEEN #{window_start} AND burst_comments.created_at
+              ) >= #{COMMENT_BURST_COMMENTERS_MINIMUM}
+          )
+        SQL
+      end
+
+      def comment_burst_period
+        <<~SQL.squish
+          COALESCE(
+            (SELECT board_entropies.auto_postpone_period
+             FROM entropies board_entropies
+             WHERE board_entropies.container_type = 'Board'
+               AND board_entropies.container_id = cards.board_id),
+            (SELECT account_entropies.auto_postpone_period
+             FROM entropies account_entropies
+             WHERE account_entropies.container_type = 'Account'
+               AND account_entropies.container_id = cards.account_id),
+            #{Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days.to_i}
+          ) / #{COMMENT_BURST_PERIOD_DIVISOR}
+        SQL
+      end
+  end
+
+  def burst?
+    return @burst if defined?(@burst)
+
+    @burst = persisted? && self.class.with_burst.exists?(id: id)
+  end
+
+  alias_method :had_burst?, :burst?
+
+  def stalled?
+    active? && last_active_at <= STALL_AFTER.ago && burst?
+  end
+
+  def stalls_at
+    last_active_at + STALL_AFTER
+  end
+
+  private
+    def reset_burst_cache
+      remove_instance_variable(:@burst) if defined?(@burst)
+    end
+end
