--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = boards(:writebook).cards.create!(title: "Stall test", creator: users(:david), status: :published)
+  end
+
+  test "three comments from at least two people within a third of the auto-close period create a burst" do
+    assert_not @card.burst?
+
+    add_comments_at 21.days.ago, 20.days.ago, 19.days.ago, creators: [ users(:david), users(:jz), users(:david) ]
+
+    assert @card.burst?
+  end
+
+  test "three comments from one person do not create a burst" do
+    add_comments_at 3.days.ago, 2.days.ago, 1.day.ago, creators: [ users(:david) ] * 3
+
+    assert_not @card.burst?
+  end
+
+  test "system comments do not count toward a comment burst" do
+    add_comments_at 3.days.ago, 2.days.ago, 1.day.ago,
+      creators: [ users(:david), users(:jz), accounts("37s").system_user ]
+
+    assert_not @card.burst?
+  end
+
+  test "comments outside the auto-close third do not create a burst" do
+    add_comments_at 40.days.ago, 9.days.ago, 8.days.ago,
+      creators: [ users(:david), users(:jz), users(:david) ]
+
+    assert_not @card.burst?
+  end
+
+  test "assignment creates a burst" do
+    @card.toggle_assignment users(:jz)
+
+    assert @card.burst?
+  end
+
+  test "reopening creates a burst" do
+    @card.close
+    @card.reopen
+
+    assert @card.burst?
+  end
+
+  test "a burst becomes stalled after two weeks without activity" do
+    @card.toggle_assignment users(:jz)
+
+    freeze_time do
+      @card.update!(last_active_at: 2.weeks.ago)
+      assert @card.stalled?
+
+      @card.update!(last_active_at: 2.weeks.ago + 1.second)
+      assert_not @card.stalled?
+    end
+  end
+
+  test "new activity resets a stalled card without erasing its burst" do
+    @card.toggle_assignment users(:jz)
+    @card.update!(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.comments.create!(body: "Back on it", creator: users(:jz))
+    assert @card.reload.burst?
+    assert_not @card.stalled?
+  end
+
+  test "card edits reset a stalled card" do
+    @card.toggle_assignment users(:jz)
+    @card.update!(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.update!(description: "Updated description")
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "activity from an associated record resets a stalled card" do
+    @card.toggle_assignment users(:jz)
+    @card.update!(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.steps.create!(content: "Next step")
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "closed and postponed cards are not stalled" do
+    @card.toggle_assignment users(:jz)
+    @card.update!(last_active_at: 3.weeks.ago)
+
+    @card.close
+    assert_not @card.stalled?
+
+    @card.reopen
+    @card.postpone
+    assert_not @card.stalled?
+  end
+
+  test "stalled cards can be indexed by stalled" do
+    @card.toggle_assignment users(:jz)
+    @card.update!(last_active_at: 3.weeks.ago)
+
+    filter = users(:david).filters.new(indexed_by: "stalled")
+
+    assert_includes filter.cards, @card
+  end
+
+  private
+    def add_comments_at(*times, creators:)
+      times.each_with_index do |time, index|
+        @card.comments.create!(body: "Comment #{index}", creator: creators[index], created_at: time)
+      end
+    end
+end
