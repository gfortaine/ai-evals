index 0000000..5503d1c
--- /dev/null
+++ b/test/scripts/library_report_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+require "stringio"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  test "writes the report to the terminal and the environment logger" do
+    file_output = StringIO.new
+    file_logger = ActiveSupport::Logger.new(file_output)
+    file_logger.formatter = ->(severity, _timestamp, _progname, message) do
+      "#{severity}: #{message}\n"
+    end
+
+    expected = <<~OUTPUT
+      INFO: Library report: 2 books
+      WARN: Library report: Manual has no pages
+      INFO: Library report: Handbook has 4 pages
+      INFO: Library report: done
+    OUTPUT
+
+    original_logger = Rails.logger
+    Rails.logger = file_logger
+    begin
+      stdout, stderr = capture_io do
+        load Rails.root.join("script/library_report.rb").to_s
+      end
+
+      assert_equal expected, stdout
+      assert_empty stderr
+    ensure
+      Rails.logger = original_logger
+    end
+
+    assert_equal expected, file_output.string
+  end
+end
