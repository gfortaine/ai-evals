diff --git a/lib/active_storage/service/fog_service.rb b/lib/active_storage/service/fog_service.rb
new file mode 100644
index 0000000..baa2840
--- /dev/null
+++ b/lib/active_storage/service/fog_service.rb
@@ -0,0 +1,138 @@
+require "fog/aws"
+
+module ActiveStorage
+  class Service
+    class FogService < ActiveStorage::Service
+      def initialize(directory:, provider: "AWS", public: false, cache_control: nil, **credentials)
+        super()
+        @directory_name = directory
+        @public = public
+        @cache_control = cache_control
+        @storage = Fog::Storage.new(credentials.merge(provider: provider))
+      end
+
+      def upload(key, io, checksum: nil, filename: nil, content_type: nil, disposition: nil, custom_metadata: {}, **)
+        instrument :upload, key: key, checksum: checksum do
+          headers = upload_headers(
+            checksum: checksum,
+            filename: filename,
+            content_type: content_type,
+            disposition: disposition,
+            custom_metadata: custom_metadata,
+          )
+          @storage.put_object(@directory_name, key, io, headers)
+        end
+      end
+
+      def download(key)
+        data = @storage.get_object(@directory_name, key).body
+        data = data.read if data.respond_to?(:read)
+        data = data.to_s.b
+        return data unless block_given?
+
+        offset = 0
+        while (chunk = data.byteslice(offset, 5.megabytes))
+          yield chunk
+          offset += chunk.bytesize
+        end
+      rescue Excon::Errors::NotFound, Fog::Errors::NotFound
+        raise ActiveStorage::FileNotFoundError
+      end
+
+      def download_chunk(key, range)
+        range_end = range.exclude_end? ? range.end - 1 : range.end
+        data = @storage.get_object(@directory_name, key, "Range" => "bytes=#{range.begin}-#{range_end}").body
+        data = data.read if data.respond_to?(:read)
+        data.to_s.b
+      rescue Excon::Errors::NotFound, Fog::Errors::NotFound
+        raise ActiveStorage::FileNotFoundError
+      end
+
+      def delete(key)
+        instrument :delete, key: key do
+          @storage.delete_object(@directory_name, key)
+        end
+      end
+
+      def delete_prefixed(prefix)
+        instrument :delete_prefixed, prefix: prefix do
+          directory.files.all(prefix: prefix).each(&:destroy) # rubocop:disable Rails/FindEach
+        end
+      end
+
+      def exist?(key)
+        instrument :exist, key: key do |payload|
+          payload[:exist] = @storage.head_object(@directory_name, key).present?
+        rescue Excon::Errors::NotFound, Fog::Errors::NotFound
+          payload[:exist] = false
+        end
+      end
+
+      def url_for_direct_upload(key, expires_in:, content_type:, content_length:, checksum:, custom_metadata: {})
+        instrument :url, key: key do
+          headers = direct_upload_headers(
+            content_type: content_type,
+            content_length: content_length,
+            checksum: checksum,
+            custom_metadata: custom_metadata,
+          )
+          @storage.put_object_url(@directory_name, key, expires_at(expires_in), headers)
+        end
+      end
+
+      def headers_for_direct_upload(_key, content_type:, content_length:, checksum:, custom_metadata: {}, **)
+        direct_upload_headers(
+          content_type: content_type,
+          content_length: content_length,
+          checksum: checksum,
+          custom_metadata: custom_metadata,
+        )
+      end
+
+      private
+
+      def private_url(key, expires_in:, filename:, content_type:, disposition:, **)
+        options = {
+          "response-content-disposition" => content_disposition_with(type: disposition, filename: filename),
+          "response-content-type" => content_type
+        }.compact
+        @storage.get_object_url(@directory_name, key, expires_at(expires_in), options)
+      end
+
+      def public_url(key, **)
+        @storage.request_url(bucket_name: @directory_name, object_name: key)
+      end
+
+      def upload_headers(checksum:, filename:, content_type:, disposition:, custom_metadata:)
+        {
+          "Content-MD5" => checksum,
+          "Content-Type" => content_type,
+          "Content-Disposition" => content_disposition_with(type: disposition, filename: filename),
+          "Cache-Control" => @cache_control,
+          "x-amz-acl" => ("public-read" if public?)
+        }.compact.merge(custom_metadata_headers(custom_metadata))
+      end
+
+      def direct_upload_headers(content_type:, content_length:, checksum:, custom_metadata:)
+        {
+          "Content-MD5" => checksum,
+          "Content-Type" => content_type,
+          "Content-Length" => content_length.to_s,
+          "x-amz-acl" => ("public-read" if public?)
+        }.compact.merge(custom_metadata_headers(custom_metadata))
+      end
+
+      def custom_metadata_headers(metadata)
+        metadata.transform_keys { |key| "x-amz-meta-#{key}" }
+      end
+
+      def expires_at(expires_in)
+        expires_in ? Time.now.to_i + expires_in.to_i : Time.now.to_i + ActiveStorage.service_urls_expire_in.to_i
+      end
+
+      def directory
+        @storage.directories.new(key: @directory_name)
+      end
+    end
+  end
+end
