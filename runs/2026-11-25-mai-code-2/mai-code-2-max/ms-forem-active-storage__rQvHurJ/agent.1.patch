diff --git a/app/models/concerns/profile_imageable.rb b/app/models/concerns/profile_imageable.rb
new file mode 100644
index 0000000..594da48
--- /dev/null
+++ b/app/models/concerns/profile_imageable.rb
@@ -0,0 +1,122 @@
+module ProfileImageable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one_attached :profile_image
+
+    mount_uploader :legacy_profile_image, ProfileImageUploader, mount_on: :profile_image do
+      def store_dir
+        "uploads/#{model.class.to_s.underscore}/profile_image/#{model.id}"
+      end
+    end
+
+    alias_method :write_active_storage_profile_image=, :profile_image=
+    private :write_active_storage_profile_image=
+
+    define_method(:profile_image=) do |attachable|
+      assign_active_storage_profile_image(attachable)
+    end
+
+    validate :validate_profile_image_upload
+    after_commit :remove_processed_profile_image_files, on: %i[create update]
+    after_rollback :remove_processed_profile_image_files
+  end
+
+  def profile_image_url(*args)
+    blob = profile_image.blob if profile_image.attached?
+    return URL.url(Rails.application.routes.url_helpers.rails_blob_path(blob)) if blob&.persisted?
+    return unless has_attribute?(:profile_image)
+
+    legacy_profile_image_url(*args)
+  end
+
+  def remote_profile_image_url
+    @remote_profile_image_url
+  end
+
+  def remote_profile_image_url=(url)
+    @remote_profile_image_url = url
+    return if url.blank?
+
+    if url.is_a?(String)
+      assign_remote_active_storage_profile_image(url)
+    else
+      assign_active_storage_profile_image(url)
+    end
+  end
+
+  def remote_profile_image_request_header=(headers)
+    @remote_profile_image_request_headers = headers
+  end
+
+  def profile_image_changed_for_related_entities?
+    @profile_image_changed || saved_change_to_attribute?(:profile_image)
+  end
+
+  private
+
+  def assign_active_storage_profile_image(attachable)
+    @profile_image_upload_error = nil
+    if attachable.is_a?(String) && attachable.match?(%r{\Ahttps?://})
+      self.remote_profile_image_url = attachable unless local_profile_image_url?(attachable)
+      return
+    end
+    if attachable.nil? || attachable == "" || attachable.is_a?(String) || attachable.is_a?(ActiveStorage::Blob)
+      write_active_storage_profile_image(attachable)
+      return
+    end
+
+    uploader = ActiveStorageProfileImageUploader.new(self, :profile_image)
+    source = attachable.is_a?(Hash) ? attachable[:io] || attachable["io"] : attachable
+    uploader.cache!(source)
+    assign_processed_profile_image(uploader)
+  rescue CarrierWave::UploadError, CarrierWave::DownloadError, CarrierWave::ProcessingError => e
+    @profile_image_upload_error = e.message
+  end
+
+  def local_profile_image_url?(url)
+    host = URI.parse(url).host
+    [ApplicationConfig["APP_DOMAIN"], Settings::General.app_domain].compact.any? do |domain|
+      URI.parse("//#{domain}").host == host
+    end
+  rescue URI::InvalidURIError
+    false
+  end
+
+  def assign_remote_active_storage_profile_image(url)
+    uploader = ActiveStorageProfileImageUploader.new(self, :profile_image)
+    uploader.download!(url, @remote_profile_image_request_headers || {})
+    assign_processed_profile_image(uploader)
+  rescue CarrierWave::UploadError, CarrierWave::DownloadError, CarrierWave::ProcessingError => e
+    @profile_image_upload_error = e.message
+  end
+
+  def assign_processed_profile_image(uploader)
+    return if uploader.file.blank?
+
+    (@processed_profile_image_uploaders ||= []) << uploader
+    write_active_storage_profile_image(
+      io: uploader.file,
+      filename: uploader.filename,
+      content_type: uploader.file.content_type,
+    )
+  end
+
+  def write_active_storage_profile_image(attachable)
+    __send__(:write_active_storage_profile_image=, attachable)
+    @profile_image_changed = true
+  end
+
+  def validate_profile_image_upload
+    errors.add(:profile_image, @profile_image_upload_error) if @profile_image_upload_error.present?
+  end
+
+  def remove_processed_profile_image_files
+    Array(@processed_profile_image_uploaders).each(&:remove!)
+    @processed_profile_image_uploaders = nil
+  end
+
+  def reset_profile_image_change
+    @profile_image_changed = false
+  end
+end
