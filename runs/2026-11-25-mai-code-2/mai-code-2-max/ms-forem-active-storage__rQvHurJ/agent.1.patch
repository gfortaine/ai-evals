@@ -0,0 +1,48 @@
+require "rails_helper"
+require "active_storage/service/fog_service"
+
+RSpec.describe ActiveStorage::Service::FogService do
+  let(:credentials) do
+    {
+      directory: "profile-images",
+      aws_access_key_id: "key",
+      aws_secret_access_key: "secret",
+      region: "us-east-1"
+    }
+  end
+  let(:service) { described_class.new(**credentials) }
+
+  around do |example|
+    Fog.mock!
+    Fog::Storage.new(credentials.except(:directory).merge(provider: "AWS"))
+      .directories
+      .create(key: credentials[:directory])
+    example.run
+  ensure
+    Fog.unmock!
+  end
+
+  it "uploads, downloads, deletes, and signs URLs" do
+    data = "profile image"
+    filename = ActiveStorage::Filename.new("profile.jpg")
+    checksum = Base64.strict_encode64(Digest::MD5.digest(data))
+
+    service.upload(
+      "profile/key",
+      StringIO.new(data),
+      checksum: checksum,
+      filename: filename,
+      content_type: "image/jpeg",
+      disposition: :inline,
+    )
+
+    expect(service.exist?("profile/key")).to be true
+    expect(service.download("profile/key")).to eq(data)
+    expect(service.url("profile/key", expires_in: 1.minute, filename: filename,
+                                      content_type: "image/jpeg", disposition: :inline))
+      .to start_with("https://profile-images.s3.amazonaws.com/profile/key")
+
+    service.delete("profile/key")
+    expect(service.exist?("profile/key")).to be false
+  end
+end
diff --git a/spec/models/profile_imageable_spec.rb b/spec/models/profile_imageable_spec.rb
new file mode 100644
index 0000000..72748ce
--- /dev/null
+++ b/spec/models/profile_imageable_spec.rb
@@ -0,0 +1,73 @@
+require "rails_helper"
+
+RSpec.describe ProfileImageable do
+  let(:image) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+
+  %i[user organization].each do |factory|
+    context "with a #{factory}" do
+      let(:record) { create(factory) }
+
+      it "stores new images with Active Storage" do
+        expect(record.profile_image).to be_attached
+        expect(record[:profile_image]).to be_nil
+        expect(record.profile_image_url).to include("/rails/active_storage/")
+      end
+
+      it "stores a remote image with Active Storage" do
+        url = "https://dummyimage.com/profile-image.jpg"
+        stub_request(:get, url).to_return(
+          body: Rails.root.join("spec/fixtures/files/800x600.jpg").binread,
+          headers: { "Content-Type" => "image/jpeg" },
+        )
+
+        record.profile_image = url
+        record.save!
+
+        expect(record.remote_profile_image_url).to eq(url)
+        expect(record.reload.profile_image).to be_attached
+        expect(record[:profile_image]).to be_nil
+      end
+
+      it "serves CarrierWave images that have not been migrated" do
+        record.profile_image.detach
+        record.update_column(:profile_image, "legacy.png")
+        record.reload
+
+        uploader = ProfileImageUploader.new(record, :profile_image)
+        uploader.retrieve_from_store!("legacy.png")
+
+        expect(record.profile_image).not_to be_attached
+        expect(record.profile_image_url).to eq(uploader.url)
+      end
+
+      it "prefers a new Active Storage image without moving the legacy image" do
+        record.profile_image.detach
+        record.update_column(:profile_image, "legacy.png")
+        record.reload
+        legacy_url = record.profile_image_url
+
+        record.update!(profile_image: image)
+        record.reload
+
+        expect(record.profile_image).to be_attached
+        expect(record[:profile_image]).to eq("legacy.png")
+        expect(record.profile_image_url).not_to eq(legacy_url)
+      end
+    end
+  end
+
+  it "accepts a legacy CarrierWave image as an organization's required profile image" do
+    organization = create(:organization)
+    organization.profile_image.detach
+    organization.update_column(:profile_image, "legacy.png")
+
+    expect(organization.reload).to be_valid
+  end
+
+  it "keeps profile images on other models in CarrierWave" do
+    tag = create(:tag, profile_image: image)
+
+    expect(tag.profile_image).to be_a(ProfileImageUploader)
+    expect(tag).not_to respond_to(:profile_image_attachment)
+  end
+end
