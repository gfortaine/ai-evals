diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..865f7f7
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@comment.card, @comment),
+        params: { reaction: { content: "🔥" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reactions)
+    assert_equal users(:kevin), Reaction.last.creator
+    assert_equal "🔥", Reaction.last.content
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@comment.card, @comment), params: { content: "Agreed" }, as: :json
+    end
+
+    reaction = Reaction.last
+
+    assert_response :created
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("creator", "id")
+    assert_equal card_comment_reaction_path(@comment.card, @comment, reaction, format: :json), @response.headers["Location"]
+  end
+
+  test "content cannot exceed sixteen characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@comment.card, @comment),
+        params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+    assert_select "[role=alert]", text: /too long/
+  end
+
+  test "show as JSON" do
+    reaction = @comment.reactions.create!(creator: users(:jz), content: "👍")
+
+    get card_comment_reaction_path(@comment.card, @comment, reaction), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal reaction.content, @response.parsed_body["content"]
+  end
+
+  test "destroy your reaction" do
+    reaction = @comment.reactions.create!(creator: users(:kevin), content: "Nice")
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reactions)
+  end
+
+  test "destroy another user's reaction is forbidden" do
+    reaction = @comment.reactions.create!(creator: users(:jz), content: "Nice")
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "card comments include the reactions strip" do
+    reaction = @comment.reactions.create!(creator: users(:jz), content: "Nice")
+
+    get card_path(@comment.card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)}.reactions" do
+      assert_select "##{dom_id(reaction)}.reaction", text: /Nice/
+      assert_select "[data-reactions-target=trigger] img[src*='boost-color']"
+      assert_select "input[name='reaction[content]'][maxlength='16']"
+    end
+  end
+
+  test "comment JSON includes reactions" do
+    reaction = @comment.reactions.create!(creator: users(:jz), content: "Nice")
+
+    get card_comment_path(@comment.card, @comment), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body.dig("reactions", 0, "id")
+  end
+end
