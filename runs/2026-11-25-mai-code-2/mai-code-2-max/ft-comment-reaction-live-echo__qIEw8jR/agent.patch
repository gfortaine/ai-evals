+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "add, cancel, and remove a reaction" do
+    visit card_url(@comment.card)
+
+    within "##{dom_id(@comment, :container)}" do
+      click_button "Add a reaction"
+      assert_selector "form.reaction__form:not([hidden])"
+
+      fill_in "Reaction", with: "Draft"
+      click_button "Cancel reaction"
+      assert_selector "form.reaction__form[hidden]", visible: :all
+
+      click_button "Add a reaction"
+      fill_in "Reaction", with: "Looks good"
+      click_button "Add reaction"
+
+      reaction = find(".reaction--deleteable", text: "Looks good")
+      reaction.click
+      click_button "Remove reaction"
+
+      assert_no_selector ".reaction", text: "Looks good"
+    end
+  end
+
+  test "reactions appear in another open card" do
+    visit card_url(@comment.card)
+    main_window = current_window
+
+    perform_enqueued_jobs do
+      other_window = open_new_window
+      within_window other_window do
+        visit card_url(@comment.card)
+        within "##{dom_id(@comment, :container)}" do
+          click_button "Add a reaction"
+          fill_in "Reaction", with: "Live"
+          click_button "Add reaction"
+          assert_selector ".reaction", text: "Live"
+        end
+      end
+    end
+
+    within_window main_window do
+      assert_selector ".reaction", text: "Live"
+    end
+  end
+end
