+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  test "normalizes and limits content" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(creator: users(:kevin), content: "  Looking good  ")
+
+    assert_equal "Looking good", reaction.content
+    assert_equal comment.account, reaction.account
+
+    assert_not comment.reactions.build(creator: users(:kevin), content: " ").valid?
+    assert comment.reactions.build(creator: users(:kevin), content: "a" * 16).valid?
+    assert_not comment.reactions.build(creator: users(:kevin), content: "a" * 17).valid?
+  end
+
+  test "recognizes emoji content" do
+    reaction = comments(:logo_agreement_jz).reactions.build(creator: users(:kevin), content: "👍")
+
+    assert_predicate reaction, :emoji?
+    assert_not comments(:logo_agreement_jz).reactions.build(creator: users(:kevin), content: "Thanks!").emoji?
+  end
+
+  test "creating a reaction refreshes viewers of the card" do
+    comment = comments(:logo_agreement_jz)
+
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts comment.card do
+        comment.reactions.create!(creator: users(:kevin), content: "Nice")
+      end
+    end
+  end
+
+  test "destroying a reaction refreshes viewers of the card" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(creator: users(:kevin), content: "Nice")
+    clear_enqueued_jobs
+
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts comment.card do
+        reaction.destroy!
+      end
+    end
+  end
+end
