index 0000000..2b8a395
--- /dev/null
+++ b/app/views/cards/comments/reactions/_reactions.html.erb
@@ -0,0 +1,61 @@
+<% form_reaction = local_assigns.fetch(:new_reaction) { Reaction.new } %>
+<% form_expanded = form_reaction.errors.any? %>
+
+<%= turbo_frame_tag comment, :reactions,
+      class: "reactions",
+      data: { controller: "reactions", action: "turbo:submit-end->reactions#resetIfSuccessful" } do %>
+  <div id="<%= dom_id(comment, :reaction_list) %>" class="reactions__list" role="list">
+    <%= render comment.reactions %>
+  </div>
+
+  <%= button_tag type: :button,
+        id: dom_id(comment, :reaction_trigger),
+        class: "reactions__trigger btn btn--circle borderless",
+        hidden: form_expanded,
+        title: "Add a reaction",
+        aria: { label: "Add a reaction" },
+        data: { turbo_permanent: true, reactions_target: "trigger", action: "reactions#open" } do %>
+    <%= image_tag "boost-color.svg", alt: "" %>
+  <% end %>
+
+  <%= form_with model: form_reaction,
+        url: card_comment_reactions_path(comment.card, comment),
+        scope: :reaction,
+        id: dom_id(comment, :reaction_form),
+        class: class_names("reaction__form", { "reaction expanded" => form_expanded }),
+        hidden: !form_expanded,
+        data: { turbo_permanent: true, reactions_target: "form", action: "keydown.esc->reactions#cancel:stop:prevent" } do |form| %>
+    <label class="reaction__form-label">
+      <span class="for-screen-reader">Reaction</span>
+      <%= form.text_field :content,
+            class: "input reaction__input txt-small",
+            placeholder: "React…",
+            maxlength: Reaction::MAX_CONTENT_LENGTH,
+            required: true,
+            autocomplete: "off",
+            aria: { invalid: form_reaction.errors[:content].any?, describedby: dom_id(comment, :reaction_errors) },
+            data: { reactions_target: "input", "1p-ignore": true } %>
+    </label>
+
+    <%= form.button class: "reaction__submit-btn btn btn--circle borderless",
+          title: "Add reaction", aria: { label: "Add reaction" } do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add reaction</span>
+    <% end %>
+
+    <%= button_tag type: :button,
+          class: "reaction__cancel-btn btn btn--circle borderless",
+          title: "Cancel",
+          aria: { label: "Cancel reaction" },
+          data: { action: "reactions#cancel" } do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel reaction</span>
+    <% end %>
+  <% end %>
+
+  <% if form_reaction.errors.any? %>
+    <span id="<%= dom_id(comment, :reaction_errors) %>" class="txt-negative txt-x-small" role="alert" data-reactions-target="error">
+      <%= form_reaction.errors.full_messages.to_sentence %>
+    </span>
+  <% end %>
+<% end %>
