diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..1af5b05
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,57 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_creatorship, only: :destroy
+
+  def show
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params.merge(creator: Current.user))
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { render :create, status: :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden unless @reaction.creator == Current.user
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..491107a
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,48 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { creatorId: String }
+
+  connect() {
+    this.refreshOwnership()
+  }
+
+  toggle(event) {
+    if (this.ownedByCurrentUser() && !event.target.closest("a, button, form, input, label")) {
+      this.element.classList.toggle("expanded")
+      this.refreshExpandedState()
+    }
+  }
+
+  deleting() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  finishDeleting(event) {
+    if (!event.detail.success) this.element.classList.remove("reaction--deleting")
+  }
+
+  refreshOwnership() {
+    const owned = this.ownedByCurrentUser()
+
+    this.element.classList.toggle("reaction--deleteable", owned)
+
+    if (owned) {
+      this.element.setAttribute("role", "button")
+      this.element.setAttribute("tabindex", "0")
+      this.refreshExpandedState()
+    } else {
+      this.element.removeAttribute("tabindex")
+      this.element.removeAttribute("aria-expanded")
+      this.element.setAttribute("role", "listitem")
+    }
+  }
+
+  refreshExpandedState() {
+    this.element.setAttribute("aria-expanded", this.element.classList.contains("expanded"))
+  }
+
+  ownedByCurrentUser() {
+    return window.Current?.user?.id === this.creatorIdValue
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..706b12f
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,27 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "error", "form", "input", "trigger" ]
+
+  open() {
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.triggerTarget.hidden = true
+    if (this.hasErrorTarget) this.errorTarget.remove()
+    requestAnimationFrame(() => this.inputTarget.focus())
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    this.formTarget.reset()
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+    if (this.hasErrorTarget) this.errorTarget.remove()
+    this.triggerTarget.focus({ preventScroll: true })
+  }
+
+  resetIfSuccessful(event) {
+    if (event.detail.success) this.cancel()
+  }
+}
