diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..248b2bc
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @book = books(:handbook)
+    sign_in :kevin
+  end
+
+  test "show renders formatted date and character count" do
+    leaves(:welcome_page).leafable.update!(body: "a" * 1_000)
+    @book.update_columns(updated_at: Time.utc(2026, 1, 2, 3, 4, 5))
+
+    get book_report_path(@book)
+
+    assert_response :success
+    assert_in_body "Last updated January 02, 2026"
+    assert_in_body "#{@book.reload.markable.length.to_fs(:delimited)} characters"
+  end
+
+  test "text report formats dates, record IDs, and filename" do
+    @book.update_columns(
+      created_at: Time.utc(2026, 1, 2, 3, 4, 5),
+      updated_at: Time.utc(2026, 1, 3, 4, 5, 6)
+    )
+
+    get book_report_path(@book, format: :text)
+
+    assert_response :success
+    assert_in_body "Started: January 02, 2026 03:04"
+    assert_in_body "Updated: 03 Jan 04:05"
+    assert_in_body "Covers: #{@book.leaves.active.positioned.map(&:id).join(',')}"
+    assert_match(/filename="shelf-report-20260103040506\.txt"/, response.headers["Content-Disposition"])
+  end
+end
diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..f3328f5
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+require "tmpdir"
+
+class ReportArchiveJobTest < ActiveJob::TestCase
+  test "archives the last edited timestamp" do
+    book = books(:handbook)
+    leaves(:welcome_page).update_column(:updated_at, Time.utc(2032, 1, 2, 3, 4, 5))
+
+    Dir.mktmpdir do |root|
+      original_root = Rails.application.config.root
+      Rails.application.config.root = root
+
+      ReportArchiveJob.perform_now(book)
+
+      archive = Pathname(root).join(ReportArchiveJob::ARCHIVE_DIR, "book-#{book.id}.txt")
+      assert_equal "# archived 2032-01-02 03:04:05 UTC\n\n#{book.markable}", archive.read
+    ensure
+      Rails.application.config.root = original_root
+    end
+  end
+end
