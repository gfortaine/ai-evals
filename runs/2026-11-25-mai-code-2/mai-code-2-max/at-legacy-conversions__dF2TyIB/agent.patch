@@ -0,0 +1,14 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest formats the last edited date" do
+    books(:handbook).update_columns(
+      published: true,
+      updated_at: Time.utc(2026, 1, 2, 3, 4, 5)
+    )
+
+    email = ReportDigestMailer.weekly(users(:kevin))
+
+    assert_includes email.body.decoded, "* Handbook, last edited 02 Jan"
+  end
+end
