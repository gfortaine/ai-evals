diff --git a/app/models/bot/webhook.rb b/app/models/bot/webhook.rb
new file mode 100644
index 0000000..a633964
--- /dev/null
+++ b/app/models/bot/webhook.rb
@@ -0,0 +1,91 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class Bot::Webhook
+  OPEN_TIMEOUT = 5.seconds
+  READ_TIMEOUT = 10.seconds
+
+  attr_reader :bot, :message
+
+  def initialize(bot:, message:)
+    @bot = bot
+    @message = message
+  end
+
+  def deliver
+    return if bot.webhook_url.blank?
+
+    case response = post
+    when Net::HTTPOK
+      post_reply(response)
+    when Net::HTTPNoContent
+    else
+      log_ignored_response(response)
+    end
+  rescue URI::InvalidURIError, Surfguard::Unresolvable, RestrictedHTTP::Violation, SocketError, Timeout::Error, IOError, SystemCallError, Net::ProtocolError, OpenSSL::SSL::SSLError => error
+    Rails.logger.warn "Webhook delivery failed for Bot##{bot.id} and Message##{message.id}: #{error.class}: #{error.message}"
+  end
+
+  private
+    def post
+      url = URI.parse(bot.webhook_url)
+      request = Net::HTTP::Post.new(url.request_uri, "Content-Type" => "application/json")
+      request.body = JSON.generate(payload)
+
+      Net::HTTP.start(url.host, url.port, ipaddr: RestrictedHTTP::PrivateNetworkGuard.resolve(url.host), use_ssl: url.scheme == "https") do |http|
+        http.open_timeout = OPEN_TIMEOUT
+        http.read_timeout = READ_TIMEOUT
+        http.request(request)
+      end
+    end
+
+    def post_reply(response)
+      if body = reply_body(response)
+        reply = message.room.messages.create!(creator: bot, body: body)
+        reply.broadcast_create
+      else
+        log_ignored_response(response)
+      end
+    end
+
+    def reply_body(response)
+      body = response.body.to_s.dup.force_encoding(Encoding::UTF_8)
+      return unless body.valid_encoding? && body.present?
+
+      case response.content_type
+      when "text/plain"
+        ERB::Util.html_escape(body)
+      when "text/html"
+        body
+      end
+    end
+
+    def log_ignored_response(response)
+      Rails.logger.warn "Ignored webhook response for Bot##{bot.id}: HTTP #{response.code} (#{response.content_type || "no content type"})"
+    end
+
+    def payload
+      {
+        event: "mention",
+        author: { id: message.creator_id, name: message.creator.name },
+        room: { id: message.room_id, name: message.room.name, reply_to: reply_to_path },
+        message: { id: message.id, body: { text: command_text, html: message.body.body.to_html }, link: message_link }
+      }
+    end
+
+    def command_text
+      fragment = message.body.body.fragment.replace(ActionText::Attachment.tag_name) do |node|
+        ActionText::Attachment.from_node(node).attachable == bot ? nil : node
+      end
+
+      ActionText::Content.new(fragment).to_plain_text.strip
+    end
+
+    def reply_to_path
+      Rails.application.routes.url_helpers.room_bot_messages_path(message.room_id, bot.bot_code)
+    end
+
+    def message_link
+      Rails.application.routes.url_helpers.room_at_message_path(message.room_id, message.id)
+    end
+end
