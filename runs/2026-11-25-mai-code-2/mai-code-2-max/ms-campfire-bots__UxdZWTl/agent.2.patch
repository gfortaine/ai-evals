diff --git a/test/models/bot/webhook_test.rb b/test/models/bot/webhook_test.rb
new file mode 100644
index 0000000..2ae780f
--- /dev/null
+++ b/test/models/bot/webhook_test.rb
@@ -0,0 +1,132 @@
+require "test_helper"
+
+class Bot::WebhookTest < ActiveSupport::TestCase
+  setup do
+    @room = rooms(:hq)
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://bots.example.com/campfire")
+    @message = @room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} restart the build please</div>"
+    )
+
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bots.example.com").returns("93.184.216.34")
+  end
+
+  test "posts the mention payload and treats 204 as no reply" do
+    captured_payload = nil
+    request = stub_request(:post, @bot.webhook_url)
+      .with(headers: { "Content-Type" => "application/json" }) do |webhook_request|
+        captured_payload = JSON.parse(webhook_request.body)
+        true
+      end
+      .to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      deliver_webhook
+    end
+
+    assert_requested request
+    assert_equal expected_payload, captured_payload
+  end
+
+  test "does nothing when the webhook is removed before delivery" do
+    @bot.update!(webhook_url: nil)
+    stub_request(:post, "https://bots.example.com/campfire")
+
+    assert_no_difference -> { Message.count } do
+      deliver_webhook
+    end
+
+    assert_not_requested :post, "https://bots.example.com/campfire"
+  end
+
+  test "posts a text/plain response as literal text" do
+    stub_request(:post, @bot.webhook_url).to_return(
+      status: 200,
+      headers: { "Content-Type" => "text/plain; charset=UTF-8" },
+      body: "Deployment <strong>finished</strong>"
+    )
+
+    assert_difference -> { Message.count }, 1 do
+      deliver_webhook
+    end
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Deployment <strong>finished</strong>", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "&lt;strong&gt;finished&lt;/strong&gt;"
+  end
+
+  test "posts a text/html response as rich text" do
+    stub_request(:post, @bot.webhook_url).to_return(
+      status: 200,
+      headers: { "Content-Type" => "text/html; charset=UTF-8" },
+      body: "<div>Deployment <strong>finished</strong></div>"
+    )
+
+    assert_difference -> { Message.count }, 1 do
+      deliver_webhook
+    end
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Deployment finished", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "<strong>finished</strong>"
+  end
+
+  test "does not post a 200 response with another content type" do
+    stub_request(:post, @bot.webhook_url).to_return(
+      status: 200,
+      headers: { "Content-Type" => "application/json" },
+      body: '{"status":"finished"}'
+    )
+
+    assert_no_difference -> { Message.count } do
+      deliver_webhook
+    end
+  end
+
+  test "strips only this bot's mention from command text" do
+    other_bot = Bot.create!(name: "Other Bot", creator: users(:david))
+    @message.update!(body: "<div>#{mention_attachment_for(@bot)} ask #{mention_attachment_for(other_bot)} first</div>")
+    captured_payload = nil
+    stub_request(:post, @bot.webhook_url).with do |request|
+      captured_payload = JSON.parse(request.body)
+      true
+    end.to_return(status: 204)
+
+    deliver_webhook
+
+    assert_equal "ask @Other Bot first", captured_payload.dig("message", "body", "text")
+  end
+
+  private
+    def deliver_webhook
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+
+    def expected_payload
+      routes = Rails.application.routes.url_helpers
+
+      {
+        "event" => "mention",
+        "author" => {
+          "id" => users(:david).id,
+          "name" => "David"
+        },
+        "room" => {
+          "id" => @room.id,
+          "name" => "HQ",
+          "reply_to" => routes.room_bot_messages_path(@room, @bot.bot_code)
+        },
+        "message" => {
+          "id" => @message.id,
+          "body" => {
+            "text" => "restart the build please",
+            "html" => @message.body.body.to_html
+          },
+          "link" => routes.room_at_message_path(@room, @message.id)
+        }
+      }
+    end
+end
