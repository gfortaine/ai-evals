diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..8410b89
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,36 @@
+class Bots::MessagesController < ApplicationController
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  before_action :set_room
+  before_action :set_bot
+
+  def create
+    if !message_body.valid_encoding? || message_body.blank?
+      head :unprocessable_content
+    else
+      @message = @room.messages.create!(creator: @bot, body: ERB::Util.html_escape(message_body))
+      @message.broadcast_create
+
+      head :created, location: message_path(@message)
+    end
+  end
+
+  private
+    def set_room
+      @room = Room.find_by(id: params[:room_id])
+      head :not_found unless @room
+    end
+
+    def set_bot
+      @bot = Bot.find_by(bot_code: params[:bot_code])
+
+      unless @bot && @room.users.exists?(@bot.id)
+        head :unauthorized
+      end
+    end
+
+    def message_body
+      @message_body ||= request.raw_post.dup.force_encoding(Encoding::UTF_8)
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..0cdc855
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,51 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+
+  def index
+    @bots = bot_scope.ordered
+  end
+
+  def new
+    @bot = Bot.new
+  end
+
+  def create
+    @bot = Current.user.bots.new(bot_params)
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.destroy!
+    redirect_to bots_url
+  end
+
+  private
+    def bot_scope
+      Current.user.administrator? ? Bot.all : Current.user.bots
+    end
+
+    def set_bot
+      @bot = bot_scope.find_by(id: params[:id])
+      head :not_found unless @bot
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
