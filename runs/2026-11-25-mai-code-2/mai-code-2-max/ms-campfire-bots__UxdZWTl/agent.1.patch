@@ -0,0 +1,125 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "account settings link to bot setup" do
+    get edit_account_url
+
+    assert_response :success
+    assert_select "a[href='#{bots_path}']", text: /Set up chat bots/
+  end
+
+  test "index lists owned bots and their codes without pagination" do
+    bot = create_bot("Deploy Bot", owner: users(:kevin))
+    other_bot = create_bot("Other Bot", owner: users(:david))
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li##{dom_id(bot)}" do
+      assert_select "strong", text: "Deploy Bot"
+      assert_select "label[for='#{dom_id(bot, :code)}']", text: "Bot code"
+      assert_select "input[readonly][value='#{bot.bot_code}']"
+      assert_select "a[aria-label='Edit Deploy Bot']"
+    end
+    assert_select "li##{dom_id(other_bot)}", count: 0
+    assert_select "nav.pagination", count: 0
+  end
+
+  test "administrators see all bots" do
+    own_bot = create_bot("Admin Bot", owner: users(:kevin))
+    other_bot = create_bot("Other Bot", owner: users(:david))
+    sign_in :david
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li##{dom_id(own_bot)}"
+    assert_select "li##{dom_id(other_bot)}"
+  end
+
+  test "new has the required name, optional avatar, and save controls" do
+    get new_bot_url
+
+    assert_response :success
+    assert_select "form" do
+      assert_select "input[type='file'][name='bot[avatar]']"
+      assert_select "label", text: "Name the bot"
+      assert_select "input[name='bot[name]'][required]"
+      assert_select "input[type='submit'][value='Save changes']"
+    end
+  end
+
+  test "create assigns the current user and joins open rooms" do
+    assert_difference -> { Bot.count }, 1 do
+      assert_difference -> { Membership.count }, Rooms::Open.count do
+        post bots_url, params: { bot: { name: "Deploy Bot" } }
+      end
+    end
+
+    assert_redirected_to bots_url
+    assert_equal users(:kevin), Bot.order(:id).last.creator
+  end
+
+  test "create requires a name" do
+    assert_no_difference -> { Bot.count } do
+      post bots_url, params: { bot: { name: "" } }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "updates an owned bot's avatar" do
+    bot = create_bot(owner: users(:kevin))
+
+    patch bot_url(bot), params: { bot: { avatar: fixture_file_upload("moon.jpg", "image/jpeg") } }
+
+    assert_redirected_to bots_url
+    assert bot.reload.avatar.attached?
+
+    get user_avatar_url(bot.avatar_token)
+    assert_response :success
+  end
+
+  test "update changes an owned bot" do
+    bot = create_bot("Deploy Bot", owner: users(:kevin))
+
+    patch bot_url(bot), params: { bot: { name: "Release Bot" } }
+
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", bot.reload.name
+  end
+
+  test "destroy deletes an owned bot and invalidates its code" do
+    bot = create_bot(owner: users(:kevin))
+    code = bot.bot_code
+
+    delete bot_url(bot)
+
+    assert_redirected_to bots_url
+    assert_nil Bot.find_by(bot_code: code)
+  end
+
+  test "members cannot manage another member's bot" do
+    bot = create_bot(owner: users(:david))
+
+    get edit_bot_url(bot)
+    assert_response :not_found
+
+    patch bot_url(bot), params: { bot: { name: "Changed" } }
+    assert_response :not_found
+
+    assert_no_difference -> { Bot.count } do
+      delete bot_url(bot)
+    end
+    assert_response :not_found
+  end
+
+  private
+    def create_bot(name = "Deploy Bot", owner: users(:david))
+      Bot.create!(name:, creator: owner)
+    end
+end
