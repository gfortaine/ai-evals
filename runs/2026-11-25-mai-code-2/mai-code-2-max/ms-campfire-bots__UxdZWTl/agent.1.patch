diff --git a/test/controllers/bots/messages_controller_test.rb b/test/controllers/bots/messages_controller_test.rb
new file mode 100644
index 0000000..78a5451
--- /dev/null
+++ b/test/controllers/bots/messages_controller_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+    @room = rooms(:hq)
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+  end
+
+  test "creates, broadcasts, and queues push delivery for a raw message" do
+    body = "Deploy of v1.2.3 finished ✅"
+    expected_body = body.dup
+
+    assert_difference -> { @room.messages.count }, 1 do
+      assert_enqueued_jobs 1, only: Room::PushMessageJob do
+        post room_bot_messages_url(@room, @bot.bot_code), params: body, headers: text_headers
+      end
+    end
+
+    message = @room.messages.order(:id).last
+    assert_response :created
+    assert_empty response.body
+    assert_equal message_path(message), response.headers["Location"]
+    assert_equal expected_body, message.plain_text_body
+    assert_equal @bot, message.creator
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author", text: "Deploy Bot"
+      assert_select ".message__body", text: /Deploy of v1.2.3 finished/
+    end
+  end
+
+  test "treats a request body as literal text rather than fields or markup" do
+    body = "<strong>Deploy & finish</strong>"
+
+    post room_bot_messages_url(@room, @bot.bot_code), params: body, headers: text_headers
+
+    assert_response :created
+    assert_equal body, @room.messages.order(:id).last.plain_text_body
+  end
+
+  test "rejects an empty body" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "  \n", headers: text_headers
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "rejects malformed text" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "\xFF".b, headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "returns not found for an unknown room" do
+    post room_bot_messages_url(Room.maximum(:id) + 1, @bot.bot_code), params: "Hello", headers: text_headers
+
+    assert_response :not_found
+  end
+
+  test "returns unauthorized for an invalid code" do
+    post room_bot_messages_url(@room, "not-a-bot-code"), params: "Hello", headers: text_headers
+
+    assert_response :unauthorized
+  end
+
+  test "returns unauthorized for a deleted bot" do
+    code = @bot.bot_code
+    @bot.destroy!
+
+    post room_bot_messages_url(@room, code), params: "Hello", headers: text_headers
+
+    assert_response :unauthorized
+  end
+
+  test "returns unauthorized when the bot is not a room member" do
+    room = rooms(:watercooler)
+
+    assert_not room.users.exists?(@bot.id)
+    post room_bot_messages_url(room, @bot.bot_code), params: "Hello", headers: text_headers
+
+    assert_response :unauthorized
+  end
+
+  private
+    def text_headers
+      { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+end
