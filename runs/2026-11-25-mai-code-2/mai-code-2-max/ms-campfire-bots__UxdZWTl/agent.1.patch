diff --git a/test/models/bot_test.rb b/test/models/bot_test.rb
new file mode 100644
index 0000000..72d4c68
--- /dev/null
+++ b/test/models/bot_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class BotTest < ActiveSupport::TestCase
+  test "requires a name and creator" do
+    assert Bot.new(creator: users(:david)).invalid?
+    assert Bot.new(name: "Deploy Bot").invalid?
+  end
+
+  test "generates a unique code and unusable password" do
+    first_bot = create_bot("First Bot")
+    second_bot = create_bot("Second Bot")
+
+    assert first_bot.bot_code.present?
+    assert first_bot.password_digest.present?
+    assert_not_equal first_bot.bot_code, second_bot.bot_code
+    assert_not first_bot.authenticate(first_bot.bot_code)
+  end
+
+  test "belongs to its creator" do
+    bot = create_bot
+
+    assert_equal users(:david), bot.creator
+    assert_includes users(:david).bots, bot
+  end
+
+  test "joins every open room" do
+    bot = nil
+
+    assert_difference -> { Membership.count }, Rooms::Open.count do
+      bot = create_bot
+    end
+
+    assert_equal Rooms::Open.order(:id), bot.rooms.where(type: "Rooms::Open").order(:id)
+  end
+
+  private
+    def create_bot(name = "Deploy Bot")
+      Bot.create!(name: name, creator: users(:david))
+    end
+end
