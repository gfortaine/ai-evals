+require "application_system_test_case"
+
+class BotsTest < ApplicationSystemTestCase
+  test "member creates, edits, and deletes a chat bot" do
+    sign_in users(:kevin).email_address
+
+    visit edit_account_url
+    click_link "Set up chat bots"
+    assert_current_path bots_path
+
+    click_button "Add a chat bot"
+    assert_current_path new_bot_path
+    fill_in "Name the bot", with: "Deploy Bot"
+    click_button "Save changes"
+
+    assert_current_path bots_path
+    assert_text "Deploy Bot"
+    assert find_field("Bot code", readonly: true).value.present?
+
+    click_link "Edit Deploy Bot"
+    fill_in "Name the bot", with: "Release Bot"
+    click_button "Save changes"
+
+    assert_current_path bots_path
+    assert_text "Release Bot"
+
+    click_link "Edit Release Bot"
+    accept_confirm do
+      click_button "Delete this chat bot"
+    end
+
+    assert_current_path bots_path
+    assert_no_text "Release Bot"
+  end
+end
