diff --git a/test/jobs/card/auto_postpone_all_due_job_test.rb b/test/jobs/card/auto_postpone_all_due_job_test.rb
new file mode 100644
index 0000000..b5734e0
--- /dev/null
+++ b/test/jobs/card/auto_postpone_all_due_job_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class Card::AutoPostponeAllDueJobTest < ActiveJob::TestCase
+  setup do
+    cards(:logo).update_column(:last_active_at, 1.year.ago)
+    clear_enqueued_jobs
+  end
+
+  test "enqueue due cards for auto postponement without postponing them in the sweep" do
+    assert_enqueued_with job: Card::AutoPostponeJob, queue: "backend" do
+      assert_no_difference -> { Card.postponed.count } do
+        Card::AutoPostponeAllDueJob.perform_now
+      end
+    end
+
+    args = enqueued_jobs.filter { it[:job] == Card::AutoPostponeJob }.flat_map { it[:args].first }
+    assert_includes args, cards(:logo).id
+    assert_not_includes args, cards(:shipping).id
+  end
+
+  test "split due cards into bounded jobs" do
+    ids = Array.new(Card::AutoPostponeAllDueJob::BATCH_SIZE + 1) { ActiveRecord::Type::Uuid.generate }
+    Card.stubs(:due_to_be_postponed).returns(stub(ids: ids))
+
+    assert_enqueued_jobs 2, only: Card::AutoPostponeJob do
+      Card::AutoPostponeAllDueJob.perform_now
+    end
+
+    batches = enqueued_jobs.filter { it[:job] == Card::AutoPostponeJob }.map { it[:args].first }
+    assert_equal [ Card::AutoPostponeAllDueJob::BATCH_SIZE, 1 ], batches.map(&:size)
+  end
+end
diff --git a/test/jobs/card/auto_postpone_job_test.rb b/test/jobs/card/auto_postpone_job_test.rb
new file mode 100644
index 0000000..cad6e8e
--- /dev/null
+++ b/test/jobs/card/auto_postpone_job_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class Card::AutoPostponeJobTest < ActiveJob::TestCase
+  setup do
+    cards(:logo).update_column(:last_active_at, 1.year.ago)
+    clear_enqueued_jobs
+  end
+
+  test "postpone due cards" do
+    Card::AutoPostponeJob.perform_now([ cards(:logo).id ])
+
+    assert cards(:logo).reload.postponed?
+    assert_equal accounts("37s").system_user, cards(:logo).postponed_by
+  end
+
+  test "recheck cards when running a queued batch" do
+    cards(:logo).update_column(:last_active_at, Time.current)
+
+    assert_no_difference -> { cards(:logo).events.count } do
+      Card::AutoPostponeJob.perform_now([ cards(:logo).id ])
+    end
+
+    assert cards(:logo).reload.active?
+  end
+
+  test "ignore cards already postponed by another batch" do
+    Card::AutoPostponeJob.perform_now([ cards(:logo).id ])
+
+    assert_no_difference -> { cards(:logo).events.count } do
+      Card::AutoPostponeJob.perform_now([ cards(:logo).id ])
+    end
+  end
+end
