@@ -0,0 +1,14 @@
+class Card::AutoPostponeAllDueJob < ApplicationJob
+  BATCH_SIZE = 500
+
+  queue_as :backend
+  limits_concurrency to: 1, key: "card-auto-postpone-all-due"
+
+  def perform
+    jobs = Card.due_to_be_postponed.ids.sort.each_slice(BATCH_SIZE).map do |card_ids|
+      Card::AutoPostponeJob.new(card_ids)
+    end
+
+    ActiveJob.perform_all_later jobs if jobs.any?
+  end
+end
