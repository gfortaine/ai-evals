diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..e36a0af 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -24,11 +24,33 @@ module Card::Entropic
   end
 
   class_methods do
-    def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
-      end
+    def auto_postpone_all_due(card_ids: nil)
+      cards = due_to_be_postponed
+      cards = cards.where(id: card_ids) unless card_ids.nil?
+
+      cards
+        .preload(:account, :board, :column, :activity_spike, :closure, :not_now)
+        .find_in_batches do |batch|
+          auto_postpone_batch(batch)
+        end
     end
+
+    private
+      def auto_postpone_batch(cards)
+        boards = cards.index_by(&:board_id).transform_values(&:board)
+        system_users = {}
+
+        Card.no_touching do
+          Board.no_touching do
+            cards.each do |card|
+              system_user = system_users[card.account_id] ||= card.account.system_user
+              card.auto_postpone(user: system_user)
+            end
+          end
+        end
+
+        boards.each_value(&:touch)
+      end
   end
 
   def entropy
