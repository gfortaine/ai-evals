@@ -0,0 +1,43 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    respond_to do |format|
+      format.json { set_page_and_extract_portion_from activity_events }
+    end
+  end
+
+  private
+    def activity_events
+      events = Event.preloaded.where(
+        account: Current.account,
+        board: accessible_boards,
+        action: ACTIVITY_ACTIONS
+      )
+      events = events.where(creator_id: params[:creator_ids]) if params[:creator_ids].present?
+      events.order(created_at: :desc, id: :desc)
+    end
+
+    def accessible_boards
+      boards = Current.user.boards
+
+      if params[:board_ids].present?
+        boards.where(id: params[:board_ids])
+      else
+        boards
+      end
+    end
+end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..f9fbf0b
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,33 @@
+stored_particulars = activity.particulars || {}
+particulars = stored_particulars["particulars"].presence || stored_particulars
+api_particulars = case activity.action
+when "card_assigned", "card_unassigned"
+  { assignee_ids: Array(activity.assignee_ids || particulars["assignee_ids"]) }
+when "card_board_changed"
+  { old_board: particulars["old_board"].to_s, new_board: particulars["new_board"].to_s }
+when "card_title_changed"
+  { old_title: particulars["old_title"].to_s, new_title: particulars["new_title"].to_s }
+when "card_triaged"
+  { column: particulars["column"].to_s }
+else
+  {}
+end
+
+json.cache! [ activity, activity.creator, activity.eventable, activity.eventable&.card, activity.board, Current.user ] do
+  json.(activity, :id, :action)
+  json.created_at activity.created_at.utc
+  json.description activity.description_for(Current.user).to_plain_text
+  json.particulars api_particulars
+  json.url polymorphic_url(activity.eventable)
+  json.eventable_type activity.eventable_type
+
+  json.eventable do
+    case activity.eventable
+    when Card then json.partial! "cards/card", card: activity.eventable
+    when Comment then json.partial! "cards/comments/comment", comment: activity.eventable
+    end
+  end
+
+  json.board activity.board, partial: "boards/board", as: :board
+  json.creator activity.creator, partial: "users/user", as: :user
+end
