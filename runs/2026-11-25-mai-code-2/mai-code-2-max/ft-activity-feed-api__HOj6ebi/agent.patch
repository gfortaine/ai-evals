+# Activity
+
+## `GET /:account_slug/activities.json`
+
+Returns account activity that the current user can access, newest first. The response is a flat array and follows the [pagination convention](../README.md#pagination). Deprecated `card_collection_changed` events are omitted, and `card_title_changed` events are included.
+
+The available filters are repeatable list parameters:
+
+- `creator_ids[]`: Only return activity created by these users.
+- `board_ids[]`: Only return activity from these accessible boards.
+
+The `eventable`, `board`, and `creator` fields use the same representations as the card or comment, board, and user endpoints. A comment activity URL opens its card at the comment anchor; other activity URLs open the card.
+
+`particulars` is empty for most actions. Assignment changes include `assignee_ids`; board changes include `old_board` and `new_board`; title changes include `old_title` and `new_title`; and triage changes include `column`. Missing board, title, and column values are returned as empty strings.
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5v9zq0m4s8k2n7b6c1x9at",
+    "action": "card_board_changed",
+    "created_at": "2025-12-05T20:12:34.123Z",
+    "description": "David moved \"Publish the new homepage\" to \"Website\"",
+    "particulars": {
+      "old_board": "Ideas",
+      "new_board": "Website"
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/42",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zp9gk3m1v8r4t7w2x6n",
+      "number": 42,
+      "title": "Publish the new homepage",
+      "status": "published"
+    },
+    "board": {
+      "id": "03f5v9zob4j6n8q1d3f5h7k9m",
+      "name": "Website",
+      "all_access": true,
+      "created_at": "2025-12-05T19:36:35.534Z",
+      "auto_postpone_period_in_days": 30,
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zob4j6n8q1d3f5h7k9m",
+      "creator": {
+        "id": "03f5v9zjw7pz8717a4no1h8a7",
+        "name": "David",
+        "role": "owner",
+        "active": true,
+        "email_address": "david@example.com",
+        "created_at": "2025-12-05T19:36:35.401Z",
+        "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+      }
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..623e843
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,162 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns newest activity with API representations" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ], @response.parsed_body.first.keys
+    timestamps = @response.parsed_body.map { |activity| Time.iso8601(activity["created_at"]) }
+    assert_equal timestamps.sort.reverse, timestamps
+
+    comment_event = events(:layout_commented)
+    activity = @response.parsed_body.find { |entry| entry["id"] == comment_event.id }
+
+    assert_equal comment_event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal card_url(comment_event.card, anchor: ActionView::RecordIdentifier.dom_id(comment_event.eventable)), activity["url"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment_event.eventable_id, activity.dig("eventable", "id")
+    assert_equal comment_event.board_id, activity.dig("board", "id")
+    assert_equal comment_event.creator_id, activity.dig("creator", "id")
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "index defaults to JSON and rejects HTML" do
+    get activities_path
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+  end
+
+  test "index includes title changes and omits deprecated collection changes" do
+    title_event = create_event(
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old title", new_title: "New title" } }
+    )
+    collection_event = create_event(
+      action: "card_collection_changed",
+      particulars: { particulars: { old_collection: "Old board", new_collection: "New board" } }
+    )
+
+    get activities_path(format: :json)
+
+    assert_includes @response.parsed_body.pluck("id"), title_event.id
+    assert_not_includes @response.parsed_body.pluck("id"), collection_event.id
+  end
+
+  test "index exposes action-specific particulars" do
+    assigned = create_event(action: "card_assigned", particulars: { assignee_ids: [ users(:jz).id ] })
+    moved = create_event(
+      action: "card_board_changed",
+      particulars: { particulars: { old_board: "Old board", new_board: "New board" } }
+    )
+    renamed = create_event(
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old title", new_title: "New title" } }
+    )
+    triaged = create_event(action: "card_triaged", particulars: { particulars: { column: "In progress" } })
+    incomplete = create_event(action: "card_board_changed", particulars: { particulars: { new_board: "New board" } })
+    ordinary = create_event(action: "card_published", particulars: { ignored: "value" })
+
+    get activities_path(format: :json)
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, particulars_for(assigned))
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, particulars_for(moved))
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, particulars_for(renamed))
+    assert_equal({ "column" => "In progress" }, particulars_for(triaged))
+    assert_equal({ "old_board" => "", "new_board" => "New board" }, particulars_for(incomplete))
+    assert_equal({}, particulars_for(ordinary))
+  end
+
+  test "index returns empty strings for missing title and column values" do
+    renamed = create_event(action: "card_title_changed", particulars: { particulars: {} })
+    triaged = create_event(action: "card_triaged", particulars: { particulars: {} })
+
+    get activities_path(format: :json)
+
+    assert_equal({ "old_title" => "", "new_title" => "" }, particulars_for(renamed))
+    assert_equal({ "column" => "" }, particulars_for(triaged))
+  end
+
+  test "index filters by creator and board" do
+    private_event = create_private_event
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ] }
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:david).id }
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+    assert @response.parsed_body.all? { |activity| activity.dig("board", "id") == boards(:private).id }
+
+    get activities_path(format: :json), params: {
+      creator_ids: [ users(:david).id ],
+      board_ids: [ boards(:private).id ]
+    }
+    assert_empty @response.parsed_body
+  end
+
+  test "index only returns accessible activity" do
+    private_event = create_private_event
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_empty @response.parsed_body
+  end
+
+  test "index uses the API pagination convention" do
+    5.times do |index|
+      create_event(action: "card_published", created_at: Time.current + index.seconds)
+    end
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal 15, @response.parsed_body.size
+    assert_equal 16, @response.headers["X-Total-Count"].to_i
+
+    next_url = @response.headers["Link"][/<([^>]+)>/, 1]
+    assert next_url
+
+    get next_url, as: :json
+    assert_equal 1, @response.parsed_body.size
+    assert_nil @response.headers["Link"]
+  end
+
+  private
+    def create_event(action:, particulars: {}, created_at: Time.current)
+      Event.create!(
+        account: accounts("37s"),
+        board: boards(:writebook),
+        creator: users(:david),
+        eventable: cards(:logo),
+        action:,
+        particulars:,
+        created_at:
+      )
+    end
+
+    def create_private_event
+      card = with_current_user(users(:kevin)) do
+        boards(:private).cards.create!(
+          creator: users(:kevin),
+          title: "Private card",
+          status: :published
+        )
+      end
+
+      card.events.find_by!(action: "card_published")
+    end
+
+    def particulars_for(event)
+      @response.parsed_body.find { |activity| activity["id"] == event.id }.fetch("particulars")
+    end
+end
