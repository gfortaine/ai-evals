+  test "update queues being edited broadcasts only for current editors" do
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+    sign_in :jason
+    book.access_for(user: users(:kevin)).destroy!
+
+    assert_enqueued_jobs 2, only: BeingEditedBroadcastJob do
+      patch book_page_path(book, leaf, format: :turbo_stream), params: { page: { body: "Updated body" } }
+    end
+
+    [ users(:david), users(:jason) ].each do |recipient|
+      assert_enqueued_with job: BeingEditedBroadcastJob, args: [ leaf, recipient, users(:jason) ]
+    end
+  end
+
   test "show highlights search terms" do
