diff --git a/test/jobs/being_edited_broadcast_job_test.rb b/test/jobs/being_edited_broadcast_job_test.rb
new file mode 100644
index 0000000..f5b2f26
--- /dev/null
+++ b/test/jobs/being_edited_broadcast_job_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class BeingEditedBroadcastJobTest < ActiveJob::TestCase
+  include ActionCable::TestHelper
+
+  test "broadcasts presence on the recipient's stream" do
+    leaf = leaves(:welcome_page)
+    recipient = users(:kevin)
+    stream = Turbo::StreamsChannel.send(:stream_name_from, [ leaf, recipient, :being_edited ])
+
+    messages = capture_broadcasts(stream) do
+      BeingEditedBroadcastJob.perform_now leaf, recipient, users(:jason)
+    end
+
+    assert_equal 1, messages.size
+    assert_includes messages.first, users(:jason).name
+  end
+
+  test "does not broadcast to a recipient whose editing access was removed" do
+    leaf = leaves(:welcome_page)
+    recipient = users(:kevin)
+    books(:handbook).access_for(user: recipient).destroy!
+    stream = Turbo::StreamsChannel.send(:stream_name_from, [ leaf, recipient, :being_edited ])
+
+    assert_no_broadcasts stream do
+      BeingEditedBroadcastJob.perform_now leaf, recipient, users(:jason)
+    end
+  end
+end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
