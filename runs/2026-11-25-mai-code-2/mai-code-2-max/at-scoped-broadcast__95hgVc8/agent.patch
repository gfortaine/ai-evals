@@ -22,6 +22,33 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
     assert_select "p", "This is such a great handbook."
   end
 
+  test "edit subscribes to a user-specific being edited stream" do
+    leaf = leaves(:welcome_page)
+
+    get edit_book_page_path(books(:handbook), leaf)
+
+    assert_response :success
+    assert_select "turbo-cable-stream-source" do |elements|
+      signed_stream_name = Turbo::StreamsChannel.signed_stream_name([ leaf, users(:kevin), :being_edited ])
+      assert_equal [ signed_stream_name ], elements.map { it["signed-stream-name"] }
+    end
+  end
