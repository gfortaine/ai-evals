@@ -33,4 +33,18 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors includes only users who can open and edit a private book" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+
+    assert_equal [ users(:kevin) ], book.editors.to_a
+  end
+
+  test "editors includes administrators for a published book" do
+    book = Book.create!(title: "My new book", everyone_access: false, published: true)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+
+    assert_equal [ users(:david), users(:jason), users(:kevin) ].sort_by(&:id), book.editors.order(:id).to_a
+  end
 end
