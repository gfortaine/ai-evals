new file mode 100644
index 0000000..b5e4c81
--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,155 @@
+module EmailCodeAuthentication
+  extend ActiveSupport::Concern
+
+  EMAIL_CODE_SESSION_KEY = :email_code
+
+  private
+    def authenticate_with_email_code(expected_purpose: nil, expected_join_code: nil)
+      if email_code = pending_email_code
+        if email_code.expired?
+          clear_email_code
+          email_code_expired(email_code)
+        elsif expected_purpose && email_code.purpose != expected_purpose.to_s
+          invalid_email_code
+        elsif expected_join_code && email_code.join_code_id != expected_join_code.id
+          invalid_email_code
+        elsif email_code.matches?(submitted_email_code)
+          complete_email_code_authentication(email_code)
+        else
+          invalid_email_code
+        end
+      else
+        invalid_email_code
+      end
+    end
+
+    def clear_email_code
+      session.delete EMAIL_CODE_SESSION_KEY
+      @pending_email_code = nil
+    end
+
+    def email_code_submission?
+      request.request_parameters.key?("code")
+    end
+
+    def pending_email_code
+      @pending_email_code ||= EmailCode.from_session(session[EMAIL_CODE_SESSION_KEY])
+    end
+
+    def redirect_to_email_code(email_code)
+      respond_to do |format|
+        format.html { redirect_to new_session_url(script_name: nil) }
+        format.json { render json: { message: "Check #{email_code.email_address} for your code" }, status: :accepted }
+      end
+    end
+
+    def send_email_code(email_address:, purpose:, join_code: nil)
+      email_code = EmailCode.new(
+        email_address: email_address,
+        purpose: purpose,
+        join_code_id: join_code&.id,
+        join_code_value: join_code&.code
+      )
+
+      if email_code.valid?
+        session[EMAIL_CODE_SESSION_KEY] = email_code.session_attributes
+        email_code.deliver
+        redirect_to_email_code email_code
+      else
+        head :unprocessable_entity
+      end
+    end
+
+    def submitted_email_code
+      request.request_parameters["code"]
+    end
+
+    def complete_email_code_authentication(email_code)
+      if email_code.join?
+        complete_email_code_join(email_code)
+      elsif identity = email_code.identity
+        clear_email_code
+        start_new_session_for identity
+
+        destination = if email_code.signup?
+          new_signup_completion_url(script_name: nil)
+        else
+          after_authentication_url
+        end
+
+        respond_to do |format|
+          format.html { redirect_to destination }
+          format.json { render json: { session_token: session_token, redirect_to: destination } }
+        end
+      else
+        clear_email_code
+        invalid_email_code
+      end
+    end
+
+    def complete_email_code_join(email_code)
+      join_code = email_code.join_code
+
+      if join_code&.active?
+        identity = email_code.identity
+        join_code.redeem_if { |account| identity.join(account) }
+
+        if user = User.active.find_by(account: join_code.account, identity: identity)
+          clear_email_code
+          start_new_session_for identity
+          redirect_after_joining user
+        else
+          email_code_unavailable
+        end
+      else
+        clear_email_code
+        email_code_unavailable
+      end
+    end
+
+    def redirect_after_joining(user)
+      destination = if user.setup?
+        landing_url(script_name: user.account.slug)
+      else
+        new_users_verification_url(script_name: user.account.slug)
+      end
+
+      respond_to do |format|
+        format.html { redirect_to destination }
+        format.json { render json: { session_token: session_token, redirect_to: destination } }
+      end
+    end
+
+    def invalid_email_code
+      respond_to do |format|
+        format.html { flash.now[:alert] = "That code didn't work. Check it and try again."; render "sessions/email_code", status: :unprocessable_entity, locals: { email_code: pending_email_code } }
+        format.json { render json: { error: "That code didn't work. Check it and try again." }, status: :unprocessable_entity }
+      end
+    end
+
+    def email_code_expired(email_code)
+      respond_to do |format|
+        format.html { redirect_to email_code_entry_url(email_code), alert: "That code has expired. Enter your email to get a new one." }
+        format.json { render json: { error: "That code has expired. Enter your email to get a new one." }, status: :unprocessable_entity }
+      end
+    end
+
+    def email_code_unavailable
+      clear_email_code
+
+      respond_to do |format|
+        format.html { redirect_to new_session_url(script_name: nil), alert: "That email code is no longer available. Please start again." }
+        format.json { render json: { error: "That email code is no longer available. Please start again." }, status: :unprocessable_entity }
+      end
+    end
+
+    def email_code_entry_url(email_code)
+      if email_code.signup?
+        new_signup_url(script_name: nil)
+      elsif email_code.join_code
+        join_url(code: email_code.join_code.code, script_name: email_code.join_code.account.slug)
+      else
+        new_session_url(script_name: nil)
+      end
+    end
+end
