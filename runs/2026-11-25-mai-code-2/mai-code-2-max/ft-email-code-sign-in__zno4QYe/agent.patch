+
+    assert Identity.find_by!(email_address: email_address).users.exists?(account: @account)
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+  end
 end
diff --git a/test/controllers/sessions_controller_test.rb b/test/controllers/sessions_controller_test.rb
index 0016ba1..6bd8332 100644
--- a/test/controllers/sessions_controller_test.rb
+++ b/test/controllers/sessions_controller_test.rb
@@ -39,4 +39,77 @@ class SessionsControllerTest < ActionDispatch::IntegrationTest
       assert_not cookies[:session_token].present?
     end
   end
+
+  test "email sign in sends a code and shows the code form" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      assert_redirected_to new_session_url
+
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code][autocomplete=one-time-code]"
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identity.email_address ], email.to
+    assert_match /[#{EmailCode::CODE_ALPHABET.join}]{#{EmailCode::CODE_LENGTH}}/, email.subject
+  end
+
+  test "email sign in authenticates with the code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+
+      post session_path, params: { code: code.downcase }
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "email sign in rejects an incorrect code" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+
+      post session_path, params: { code: "WRONG!" }
+
+      assert_response :unprocessable_entity
+      assert_select "input[name=code]"
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "email sign in rejects an expired code" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+      code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+
+      travel 16.minutes do
+        post session_path, params: { code: code }
+      end
+
+      assert_redirected_to new_session_url
+      assert_equal "That code has expired. Enter your email to get a new one.", flash[:alert]
