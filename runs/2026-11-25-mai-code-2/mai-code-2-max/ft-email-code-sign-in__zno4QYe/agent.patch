diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..bbc3892
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,98 @@
+class EmailCode
+  CODE_ALPHABET = %w[
+    A B C D E F G H J K L M N P Q R S T U V W X Y Z 2 3 4 5 6 7 8 9
+  ].freeze
+  CODE_LENGTH = 6
+  CODE_PATTERN = /\A[A-Z0-9]{6}\z/
+  EXPIRES_IN = 15.minutes
+  PURPOSES = %w[ sign_in signup join ].freeze
+
+  attr_reader :code, :email_address, :issued_at, :join_code_id, :join_code_value, :purpose
+
+  class << self
+    def from_session(attributes)
+      if attributes.present?
+        new(**attributes.symbolize_keys)
+      end
+    end
+
+    def generate_code
+      Array.new(CODE_LENGTH) { CODE_ALPHABET[SecureRandom.random_number(CODE_ALPHABET.length)] }.join
+    end
+  end
+
+  def initialize(email_address:, purpose:, code: self.class.generate_code, issued_at: Time.current.to_f, join_code_id: nil, join_code_value: nil)
+    @email_address = email_address.to_s.strip.downcase.presence
+    @purpose = purpose.to_s
+    @code = code.to_s
+    @issued_at = issued_at.to_f
+    @join_code_id = join_code_id
+    @join_code_value = join_code_value
+  end
+
+  def deliver
+    log_code_without_email_provider
+    UserMailer.email_code(email_address: email_address, code: code).deliver_later
+  end
+
+  def expired?
+    Time.at(issued_at) + EXPIRES_IN <= Time.current
+  end
+
+  def identity
+    if sign_in?
+      Identity.find_by(email_address: email_address)
+    else
+      Identity.find_or_create_by!(email_address: email_address)
+    end
+  end
+
+  def join_code
+    if join?
+      Account::JoinCode.find_by(id: join_code_id, code: join_code_value)
+    end
+  end
+
+  def matches?(submitted_code)
+    submitted_code = submitted_code.to_s.strip.upcase
+
+    !expired? && submitted_code.bytesize == code.bytesize && ActiveSupport::SecurityUtils.secure_compare(submitted_code, code)
+  end
+
+  def sign_in?
+    purpose == "sign_in"
+  end
+
+  def signup?
+    purpose == "signup"
+  end
+
+  def join?
+    purpose == "join"
+  end
+
+  def session_attributes
+    {
+      email_address: email_address,
+      purpose: purpose,
+      code: code,
+      issued_at: issued_at,
+      join_code_id: join_code_id,
+      join_code_value: join_code_value
+    }.compact
+  end
+
+  def valid?
+    Identity.new(email_address: email_address).valid? &&
+      PURPOSES.include?(purpose) &&
+      CODE_PATTERN.match?(code) &&
+      (!join? || (join_code_id.present? && join_code_value.present?))
+  end
+
+  private
+    def log_code_without_email_provider
+      if Rails.env.production? && ENV["SMTP_ADDRESS"].blank? && !Fizzy.saas?
+        Rails.logger.info "Email verification code for #{email_address}: #{code}"
+      end
+    end
+end
diff --git a/app/views/sessions/email_code.html.erb b/app/views/sessions/email_code.html.erb
new file mode 100644
index 0000000..cb6accd
--- /dev/null
+++ b/app/views/sessions/email_code.html.erb
@@ -0,0 +1,43 @@
+<% email_code = local_assigns[:email_code] || @email_code %>
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <%= form_with url: session_path(script_name: nil), class: "flex flex-column gap-half txt-medium", data: { controller: "form" } do |form| %>
+    <label class="flex align-center gap input input--actor">
+      <%= form.text_field :code,
+            class: "input txt-large full-width txt-uppercase",
+            autofocus: true,
+            autocomplete: "one-time-code",
+            autocapitalize: "characters",
+            autocorrect: "off",
+            inputmode: "text",
+            maxlength: EmailCode::CODE_LENGTH,
+            minlength: EmailCode::CODE_LENGTH,
+            pattern: "[A-Za-z0-9]{6}",
+            placeholder: "ABCDEF",
+            required: true,
+            spellcheck: false %>
+    </label>
+
+    <% if email_code %>
+      <p>We sent a six-character code to <strong><%= email_code.email_address %></strong>. It works for fifteen minutes.</p>
+
+      <% if Rails.env.development? %>
+        <p class="txt-subtle txt-small">Psst, here's your code: <strong><%= email_code.code %></strong></p>
+      <% end %>
+    <% end %>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <%= link_to "Use a different email", new_session_path(script_name: nil, restart: true), class: "btn btn--plain txt-link center txt-small" %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
