+require "test_helper"
+
+class UserMailerTest < ActionMailer::TestCase
+  test "email code is in the subject and both message parts" do
+    email = UserMailer.email_code(email_address: "user@example.com", code: "ABC234")
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "user@example.com" ], email.to
+    assert_equal "ABC234 is your Fizzy verification code", email.subject
+    assert_includes email.html_part.body.decoded, "ABC234"
+    assert_includes email.text_part.body.decoded, "ABC234"
+    assert_includes email.text_part.body.decoded, "15 minutes"
+  end
+end
diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..50eda5f
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "generates a six-character alphanumeric code" do
+    code = EmailCode.generate_code
+
+    assert_equal EmailCode::CODE_LENGTH, code.length
+    assert_match /\A[A-Z0-9]{6}\z/, code
+  end
+
+  test "normalizes the email address" do
+    email_code = EmailCode.new(email_address: "  New.User@Example.COM ", purpose: :sign_in)
+
+    assert_equal "new.user@example.com", email_code.email_address
+  end
+
+  test "matches codes case-insensitively until they expire" do
+    email_code = EmailCode.new(email_address: "user@example.com", purpose: :sign_in, code: "ABC234")
+
+    assert email_code.matches?("abc234")
+
+    travel 15.minutes + 1.second do
+      assert_not email_code.matches?("ABC234")
+    end
+  end
+
+  test "round trips session state" do
+    email_code = EmailCode.new(email_address: "user@example.com", purpose: :signup, code: "ABC234")
+    restored = EmailCode.from_session(email_code.session_attributes)
+
+    assert_equal email_code.email_address, restored.email_address
+    assert_equal email_code.purpose, restored.purpose
+    assert_equal email_code.code, restored.code
+    assert_in_delta email_code.issued_at, restored.issued_at
+  end
+
+  test "requires valid email, purpose, and join context" do
+    assert_not EmailCode.new(email_address: "not-an-email", purpose: :sign_in).valid?
+    assert_not EmailCode.new(email_address: "user@example.com", purpose: :other).valid?
+    assert_not EmailCode.new(email_address: "user@example.com", purpose: :sign_in, code: "SHORT").valid?
+    assert_not EmailCode.new(email_address: "user@example.com", purpose: :join).valid?
+  end
+end
