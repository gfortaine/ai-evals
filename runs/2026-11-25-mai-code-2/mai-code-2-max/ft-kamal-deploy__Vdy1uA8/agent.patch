diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..08dc221
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,58 @@
+# This configuration runs Fizzy on one Linux server. The Rails container owns
+# the web server, SQLite databases, local file storage, and background jobs.
+service: fizzy
+image: fizzy
+
+# Replace this with the address Kamal uses to SSH to the server.
+servers:
+  web:
+    - 192.0.2.1
+
+# Set the DNS name once; the proxy and Rails both use it for HTTPS URLs.
+x-app-host: &app-host fizzy.example.com
+
+proxy:
+  ssl: true
+  host: *app-host
+
+# Kamal runs this registry on the application server, so no external registry
+# account or credentials are needed.
+registry:
+  server: localhost:5555
+
+env:
+  clear:
+    APP_FQDN: *app-host
+    ACTIVE_STORAGE_SERVICE: local
+    DATABASE_ADAPTER: sqlite
+    SOLID_QUEUE_IN_PUMA: "true"
+    MAILER_FROM_ADDRESS: "Fizzy <support@fizzy.example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PRIVATE_KEY
+    - VAPID_PUBLIC_KEY
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
+
+# Keep all SQLite databases and Active Storage files across container deploys.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+asset_path: /rails/public/assets
+
+builder:
+  arch: amd64
+
+# If Kamal connects with a non-root account, configure it here.
+# ssh:
+#   user: deploy
