diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..e39cf3f
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago" do
+    account = accounts(:"37s")
+    identity = users(:david).identity
+    cancel account, at: 31.days.ago
+    cards(:layout).image.attach \
+      io: StringIO.new("attachment"),
+      filename: "attachment.png",
+      content_type: "image/png"
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_not User.where(account_id: account.id).exists?
+    assert_not Board.where(account_id: account.id).exists?
+    assert_not Card.where(account_id: account.id).exists?
+    assert_not Storage::Entry.where(account_id: account.id).exists?
+    assert_not ActiveStorage::Blob.where(account_id: account.id).exists?
+    assert Identity.exists?(identity.id)
+  end
+
+  test "keeps accounts cancelled within the past 30 days" do
+    account = accounts(:initech)
+    cancel account, at: 29.days.ago
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+  end
+
+  test "keeps accounts at the 30 day boundary" do
+    travel_to Time.current do
+      account = accounts(:initech)
+      cancel account, at: 30.days.ago
+
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+  end
+
+  private
+    def cancel(account, at:)
+      account.cancel(initiated_by: account.users.first)
+      account.cancellation.update!(created_at: at)
+    end
+end
