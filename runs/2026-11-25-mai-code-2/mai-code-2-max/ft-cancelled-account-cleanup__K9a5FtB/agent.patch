diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..ce87dcf 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,35 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> do
+      joins(:cancellation)
+        .where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    end
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    incinerated = with_lock do
+      destroy! if due_for_incineration?
+    end
+
+    purge_blobs if incinerated
+  end
+
+  def due_for_incineration?
+    cancellation && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+  end
+
+  private
+    def purge_blobs
+      ActiveStorage::Blob.where(account_id: id).find_each(&:purge)
+    end
 end
