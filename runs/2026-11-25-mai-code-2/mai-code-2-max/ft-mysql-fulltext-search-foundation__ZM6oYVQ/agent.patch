diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..71b86a7
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.session = sessions(:david)
+  end
+
+  test "shows marked title, description, and comment matches" do
+    title_match = create_card(title: "Searchable title", created_at: 3.minutes.ago)
+    description_match = create_card(title: "Description result", description: "Searchable description", created_at: 2.minutes.ago)
+    comment_match = create_card(title: "Comment result", created_at: 1.minute.ago)
+    comment_match.comments.create!(creator: users(:david), body: "Searchable comment")
+
+    get search_path(q: "searchable")
+
+    assert_response :success
+    assert_select "#search_result_card_#{title_match.id}", 1
+    assert_select "#search_result_card_#{description_match.id}", 1
+    assert_select "#search_result_card_#{comment_match.id}", 1
+    assert_select "article.search-result mark", minimum: 3
+
+    assert_operator response.body.index(dom_id(comment_match, :search_result)), :<, response.body.index(dom_id(description_match, :search_result))
+    assert_operator response.body.index(dom_id(description_match, :search_result)), :<, response.body.index(dom_id(title_match, :search_result))
+  end
+
+  test "highlights a match in an existing comment body" do
+    get search_path(q: "agree")
+
+    assert_response :success
+    assert_select "#search_result_card_#{cards(:logo).id}" do
+      assert_select "mark", text: "agree"
+      assert_select "a[href*='##{dom_id(comments(:logo_agreement_jz))}']", 1
+    end
+  end
+
+  test "does not expose inaccessible cards, drafts, or draft comments" do
+    inaccessible = boards(:private).cards.create!(creator: users(:kevin), title: "Secret hidden", status: :published)
+    draft = create_card(title: "Secret draft")
+    draft.comments.create!(creator: users(:david), body: "Secret draft comment")
+    draft.update!(status: :drafted)
+    visible = create_card(title: "Secret visible")
+
+    get search_path(q: "secret")
+
+    assert_response :success
+    assert_select "#search_result_card_#{visible.id}", 1
+    assert_select "#search_result_card_#{inaccessible.id}", 0
+    assert_select "#search_result_card_#{draft.id}", 0
+    assert_no_match /Secret draft/, response.body
+  end
+
+  test "escapes search output" do
+    create_card(title: "<script>alert('unsafe')</script> searchable")
+
+    get search_path(q: "searchable")
+
+    assert_select "article.search-result script", 0
+    assert_select "article.search-result mark", text: "searchable"
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    get search_path(q: "logo")
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "blank search shows no cards" do
+    get search_path
+
+    assert_response :success
+    assert_select "article.search-result", 0
+  end
+
+  private
+    def create_card(**attributes)
+      boards(:writebook).cards.create!({ creator: users(:david), status: :published }.merge(attributes))
+    end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..674a1a2
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "finds published accessible cards by title, description, or comment" do
+    title_match = create_card(title: "Needle in the title", created_at: 3.minutes.ago)
+    description_match = create_card(title: "Description match", description: "A needle in the description", created_at: 2.minutes.ago)
+    comment_match = create_card(title: "Comment match", created_at: 1.minute.ago)
+    comment_match.comments.create!(creator: users(:david), body: "A needle in a comment")
+
+    assert_equal [ comment_match, description_match, title_match ], Search.new(users(:david), "needle").cards.to_a
+  end
+
+  test "requires all search words and treats wildcard characters literally" do
+    matching = create_card(title: "Planning", description: "Review 100% complete")
+    create_card(title: "Planning another 100 things")
+
+    assert_equal [ matching ], Search.new(users(:david), "planning 100%").cards.to_a
+  end
+
+  test "does not search drafts or their comments" do
+    published = create_card(title: "Published searchable")
+    draft = create_card(title: "Draft searchable")
+    draft.comments.create!(creator: users(:david), body: "A searchable draft comment")
+    draft.update!(status: :drafted)
+
+    assert_equal [ published ], Search.new(users(:david), "searchable").cards.to_a
+  end
+
+  test "only searches boards the user can access" do
+    accessible = create_card(title: "Accessible result")
+    inaccessible = boards(:private).cards.create!(creator: users(:kevin), title: "Inaccessible result", status: :published)
+
+    assert_equal [ accessible ], Search.new(users(:david), "result").cards.to_a
+    assert_not_includes Search.new(users(:david), "inaccessible").cards, inaccessible
+  end
+
+  test "blank searches return no cards" do
+    assert_empty Search.new(users(:david), "  ").cards
+  end
+
+  private
+    def create_card(**attributes)
+      boards(:writebook).cards.create!({ creator: users(:david), status: :published }.merge(attributes))
+    end
+end
