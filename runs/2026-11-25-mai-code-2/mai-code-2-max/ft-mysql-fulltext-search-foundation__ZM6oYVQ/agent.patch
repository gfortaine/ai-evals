diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..7168ab9
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,37 @@
+<% description = search_result_excerpt(card.description, search.terms) %>
+
+<article class="search-result" id="<%= dom_id(card, :search_result) %>" data-card-id="<%= card.number %>">
+  <header class="search-result__header">
+    <div class="search-result__board txt-small txt-subtle">
+      <%= link_to card.board.name, card.board %>
+      <span aria-hidden="true">&middot;</span>
+      <span><span class="for-screen-reader">Card </span>#<%= card.number %></span>
+    </div>
+
+    <h2 class="search-result__title margin-none">
+      <%= link_to card_path(card), class: "txt-ink" do %>
+        <%= highlight_search_result(card.title, search.terms) %>
+      <% end %>
+    </h2>
+  </header>
+
+  <% if description %>
+    <p class="search-result__snippet">
+      <%= highlight_search_result(description, search.terms) %>
+    </p>
+  <% end %>
+
+  <% comments_by_card.fetch(card.id, []).each do |comment| %>
+    <% comment_excerpt = search_result_excerpt(comment.body, search.terms) %>
+    <% if comment_excerpt %>
+      <p class="search-result__snippet search-result__snippet--comment">
+        <%= link_to "Comment", comment, class: "search-result__source" %>
+        <%= highlight_search_result(comment_excerpt, search.terms) %>
+      </p>
+    <% end %>
+  <% end %>
+
+  <footer class="search-result__meta txt-small txt-subtle">
+    Added <%= local_datetime_tag(card.created_at, style: :daysago) %>
+  </footer>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..a6ef765
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,35 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    Search
+  </h1>
+<% end %>
+
+<div class="search">
+  <%= form_with url: search_path, method: :get, class: "search__form", role: "search" do %>
+    <%= label_tag :q, "Search cards, descriptions, and comments", class: "search__label" %>
+    <div class="search__fields">
+      <%= search_field_tag :q, @search.query, class: "input", placeholder: "Search for a word or phrase", autocomplete: "off", autocorrect: "off", autofocus: @search.query.blank? %>
+      <%= button_tag class: "btn btn--link" do %>
+        <%= icon_tag "search" %>
+        <span>Search</span>
+      <% end %>
+    </div>
+  <% end %>
+
+  <% if @search.query.present? %>
+    <% if @cards.any? %>
+      <section class="search__results" aria-label="Search results">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "searches/result", collection: @cards, as: :card, locals: { search: @search, comments_by_card: @comments_by_card } %>
+        <% end %>
+      </section>
+    <% else %>
+      <p class="blank-slate">No cards match this search</p>
+    <% end %>
+  <% else %>
+    <p class="blank-slate">Search the titles, descriptions, and comments of cards on your boards</p>
+  <% end %>
+</div>
