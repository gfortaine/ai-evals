@@ -0,0 +1,12 @@
+class SearchesController < ApplicationController
+  def show
+    @search = Search.new(Current.user, params[:q])
+    set_page_and_extract_portion_from @search.cards.preload(:board).with_rich_text_description
+
+    @cards = @page.records.load
+    @comments_by_card = @search.comments_for(@cards)
+      .preload(:rich_text_body)
+      .order(created_at: :desc, id: :desc)
+      .group_by(&:card_id)
+  end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..143dba7
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,19 @@
+module SearchesHelper
+  def highlight_search_result(text, terms)
+    highlight(search_result_plain_text(text), terms)
+  end
+
+  def search_result_excerpt(text, terms, radius: 100)
+    text = search_result_plain_text(text).squish
+    matching_term = terms.find { |term| text.match?(/#{Regexp.escape(term)}/i) }
+
+    if matching_term
+      excerpt(text, matching_term, radius: radius, omission: "...")
+    end
+  end
+
+  private
+    def search_result_plain_text(text)
+      text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+    end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..4c01090
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,65 @@
+class Search
+  LIKE_ESCAPE = "!"
+
+  attr_reader :query, :user
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.squish
+  end
+
+  def cards
+    @cards ||= if terms.any?
+      terms.reduce(user.accessible_cards.published) do |cards, term|
+        cards.where(id: matching_cards(term).select(:id))
+      end.reverse_chronologically
+    else
+      Card.none
+    end
+  end
+
+  def comments_for(cards)
+    card_ids = cards.map(&:id)
+
+    if card_ids.any? && terms.any?
+      Comment.where(account: user.account, card_id: card_ids, id: matching_comment_rich_texts.select(:record_id))
+    else
+      Comment.none
+    end
+  end
+
+  def terms
+    @terms ||= query.split(/\s+/).uniq
+  end
+
+  private
+    def matching_cards(term)
+      base = Card.where(account: user.account)
+      description_card_ids = matching_rich_texts(term, record_type: "Card", name: "description").select(:record_id)
+      comment_ids = matching_rich_texts(term, record_type: "Comment", name: "body").select(:record_id)
+      comment_card_ids = Comment.where(account: user.account, id: comment_ids).select(:card_id)
+
+      base.where("cards.title LIKE ? ESCAPE '!'", like_pattern(term))
+        .or(base.where(id: description_card_ids))
+        .or(base.where(id: comment_card_ids))
+    end
+
+    def matching_comment_rich_texts
+      patterns = terms.map { |term| like_pattern(term) }
+      comparisons = terms.map { "action_text_rich_texts.body LIKE ? ESCAPE '!'" }
+
+      ActionText::RichText
+        .where(account: user.account, record_type: "Comment", name: "body")
+        .where(comparisons.join(" OR "), *patterns)
+    end
+
+    def matching_rich_texts(term, record_type:, name:)
+      ActionText::RichText
+        .where(account: user.account, record_type: record_type, name: name)
+        .where("action_text_rich_texts.body LIKE ? ESCAPE '!'", like_pattern(term))
+    end
+
+    def like_pattern(term)
+      "%#{ActiveRecord::Base.sanitize_sql_like(term, LIKE_ESCAPE)}%"
+    end
+end
