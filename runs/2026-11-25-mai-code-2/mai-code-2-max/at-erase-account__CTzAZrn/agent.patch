diff --git a/app/models/user/erasure.rb b/app/models/user/erasure.rb
new file mode 100644
index 0000000..4dd5573
--- /dev/null
+++ b/app/models/user/erasure.rb
@@ -0,0 +1,71 @@
+module User::Erasure
+  extend ActiveSupport::Concern
+
+  DEACTIVATED_EMAIL_PATTERN = /-deactivated-[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}(?=@)/i
+  DELETED_AUTHOR = "Deleted author"
+
+  included do
+    before_destroy :erase_created_books, prepend: true
+    before_destroy :erase_sign_in_events, prepend: true
+    after_destroy_commit :purge_erased_blobs
+  end
+
+  private
+    def erase_created_books
+      @erased_blob_ids = []
+
+      created_books.find_each do |book|
+        if book.everyone_access?
+          book.update! creator: nil, author: DELETED_AUTHOR
+        else
+          @erased_blob_ids.concat blob_ids_for(book)
+          book.destroy!
+        end
+      end
+    end
+
+    def erase_sign_in_events
+      SignInEvent.where(email_address: erasure_email_addresses).delete_all
+    end
+
+    def erasure_email_addresses
+      [ email_address, email_address.sub(DEACTIVATED_EMAIL_PATTERN, "") ].uniq
+    end
+
+    def blob_ids_for(book)
+      records = [ book, *leafables_for(book) ]
+      records.concat ActionText::Markdown.where(record_type: "Page", record_id: records.grep(Page).map(&:id))
+
+      blob_ids = records.flat_map do |record|
+        ActiveStorage::Attachment.where(record: record).pluck(:blob_id)
+      end
+
+      blob_ids_with_derivatives(blob_ids.uniq)
+    end
+
+    def blob_ids_with_derivatives(blob_ids)
+      discovered = blob_ids.dup
+      pending = blob_ids.dup
+
+      until pending.empty?
+        variant_ids = ActiveStorage::VariantRecord.where(blob_id: pending).ids
+        related_blob_ids = ActiveStorage::Attachment.where(record_type: "ActiveStorage::Blob", record_id: pending).pluck(:blob_id)
+        related_blob_ids.concat ActiveStorage::Attachment.where(record_type: "ActiveStorage::VariantRecord", record_id: variant_ids).pluck(:blob_id)
+
+        pending = related_blob_ids.uniq - discovered
+        discovered.concat pending
+      end
+
+      discovered
+    end
+
+    def leafables_for(book)
+      book.leaves.flat_map do |leaf|
+        [ leaf.leafable, *leaf.edits.map(&:leafable) ]
+      end.compact
+    end
+
+    def purge_erased_blobs
+      ActiveStorage::Blob.where(id: @erased_blob_ids).find_each(&:purge)
+    end
+end
