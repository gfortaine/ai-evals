+    private_leaf.reindex
+    shared_leaf = shared_book.press(Page.new(body: "shared content"), title: "Shared page")
+    shared_book.update_access(editors: [], readers: [])
+    old_page_id = private_leaf.edits.last.leafable_id
+
+    private_book.cover.attach io: file_fixture("reading.webp").open, filename: "private-cover.webp", content_type: "image/webp"
+    private_blob_id = private_book.cover.blob.id
