+    private_upload_blob_id = private_leaf.page.body.uploads.blobs.last.id
+    markdown_ids = ActionText::Markdown.where(record_type: "Page", record_id: [ private_leaf.leafable_id, old_page_id ]).ids
+    private_leaf.trashed!
+
+    shared_book.cover.attach io: file_fixture("white-rabbit.webp").open, filename: "shared-cover.webp", content_type: "image/webp"
+    shared_blob_id = shared_book.cover.blob.id
+
+    user.sessions.create!(user_agent: "Privacy test", ip_address: "127.0.0.1")
+    Access.create!(user: user, book: private_book, level: :editor)
+    ReadingMark.remember(shared_leaf, user: user)
+    ReadingMark.remember(private_leaf, user: user)
+
+    user.destroy!
+
+    assert_not User.exists?(user.id)
+    assert_not Session.exists?(user_id: user.id)
+    assert_not Access.exists?(user_id: user.id)
+    assert_not ReadingMark.exists?(user_id: user.id)
