+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(private_leaf.id)
+    assert_not Page.exists?(private_leaf.leafable_id)
+    assert_not Page.exists?(old_page_id)
+    assert_not Edit.exists?(leaf_id: private_leaf.id)
+    assert_not ActionText::Markdown.exists?(id: markdown_ids)
+    assert_not ActiveStorage::Blob.exists?(private_blob_id)
+    assert_not ActiveStorage::Blob.exists?(private_upload_blob_id)
