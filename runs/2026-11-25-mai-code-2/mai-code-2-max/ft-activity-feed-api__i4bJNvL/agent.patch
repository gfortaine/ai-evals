diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..bb5b11d 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,29 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def activity_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: activity_detail(:old_board), new_board: activity_detail(:new_board) }
+    when "card_title_changed"
+      { old_title: activity_detail(:old_title), new_title: activity_detail(:new_title) }
+    when "card_triaged", "card_sent_back_to_triage"
+      { column: activity_detail(:column) }
+    else
+      {}
+    end
+  end
+
+  private
+    def activity_detail(key)
+      nested_activity_particulars[key].to_s
+    end
+
+    def nested_activity_particulars
+      details = particulars.to_h.with_indifferent_access
+      (details[:particulars] || details).with_indifferent_access
+    end
 end
