@@ -0,0 +1,36 @@
+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from filtered_activities
+        fresh_when etag: @page.records
+      end
+    end
+  end
+
+  private
+    def filtered_activities
+      Current.user.accessible_events
+        .preloaded_for_activity
+        .where(action: Event::ACTIVITY_ACTIONS)
+        .then { |events| filter(events, :creator_id, creator_ids) }
+        .then { |events| filter(events, :board_id, board_ids) }
+        .order(created_at: :desc, id: :desc)
+    end
+
+    def filter(events, attribute, ids)
+      ids.present? ? events.where(attribute => ids) : events
+    end
+
+    def creator_ids
+      filter_params[:creator_ids].to_a.compact_blank
+    end
+
+    def board_ids
+      filter_params[:board_ids].to_a.compact_blank
+    end
+
+    def filter_params
+      @filter_params ||= params.permit(:format, :page, creator_ids: [], board_ids: [])
+    end
+end
