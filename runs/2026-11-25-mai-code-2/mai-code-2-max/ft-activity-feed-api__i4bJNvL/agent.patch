new file mode 100644
index 0000000..82d6c9e
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,29 @@
+# Activities
+
+Activities are the account events displayed in the activity timeline. Deprecated `card_collection_changed` events are omitted, and `card_title_changed` events are included.
+
+## `GET /:account_slug/activities.json`
+
+Returns a paginated, flat list of activity the current user can access, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the ID(s) of users who created the activity |
+| `board_ids[]` | Filter by board ID(s) |
+
+Each activity contains `id`, `action`, `created_at`, `description`, `particulars`, `url`, `eventable_type`, `eventable`, `board`, and `creator`. The `eventable`, `board`, and `creator` fields use the same representations returned by the corresponding card, comment, board, and user endpoints.
+
+Descriptions are plain text. Card activity URLs open the card. Comment activity URLs open the card and jump to the comment.
+
+`particulars` is an empty object unless the action has event-specific details:
+
+| Activity | Particulars |
+|----------|-------------|
+| Card assigned or unassigned | `assignee_ids` |
+| Card board changed | `old_board`, `new_board` |
+| Card title changed | `old_title`, `new_title` |
+| Card triaged or sent back to triage | `column` |
+
+Missing board, title, and column values are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..5f21f4b
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,173 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  EVENT_KEYS = %w[ id action created_at description particulars url eventable_type eventable board creator ].freeze
+
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns the existing API representations in reverse chronological order" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    created_at = @response.parsed_body.pluck("created_at")
+    assert_equal created_at.sort.reverse, created_at
+
+    activity = activity_for(events(:logo_published))
+    eventable = events(:logo_published).eventable
+
+    assert_equal EVENT_KEYS.sort, activity.keys.sort
+    assert_equal "card_published", activity["action"]
+    assert_equal events(:logo_published).description_for(users(:kevin)).to_plain_text.to_s, activity["description"]
+    assert_equal events(:logo_published).created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal card_url(eventable), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal eventable.id, activity.dig("eventable", "id")
+    assert_equal eventable.title, activity.dig("eventable", "title")
+    assert_equal events(:logo_published).board_id, activity.dig("board", "id")
+    assert_equal events(:logo_published).creator_id, activity.dig("creator", "id")
+  end
+
+  test "comment events link to the card comment" do
+    event = events(:layout_commented)
+
+    get activities_path, as: :json
+
+    activity = activity_for(event)
+    assert_equal polymorphic_url(event.eventable), activity["url"]
+    assert_equal card_url(event.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable)), activity["url"]
+    assert_equal event.eventable.id, activity.dig("eventable", "id")
+    assert_equal event.eventable.card_id, activity.dig("eventable", "card", "id")
+  end
+
+  test "includes title changes and excludes collection changes" do
+    title_change = events(:logo_published)
+    collection_change = events(:layout_published)
+    title_change.update_columns(
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old title", new_title: "New title" } }
+    )
+    collection_change.update_columns(
+      action: "card_collection_changed",
+      particulars: { particulars: { old_collection: "Old", new_collection: "New" } }
+    )
+
+    get activities_path, as: :json
+
+    assert activity_for(title_change)
+    assert_nil activity_for(collection_change)
+  end
+
+  test "normalizes event-specific particulars" do
+    assignment = events(:logo_assignment_jz)
+    board_change = events(:logo_published).tap do |event|
+      event.update_columns(action: "card_board_changed", particulars: { particulars: { old_board: "Old board" } })
+    end
+    title_change = events(:layout_published).tap do |event|
+      event.update_columns(action: "card_title_changed", particulars: { particulars: { new_title: "New title" } })
+    end
+    triage = events(:text_published).tap do |event|
+      event.update_columns(action: "card_triaged", particulars: {})
+    end
+    sent_back_to_triage = events(:buy_domain_sent_back_to_triage)
+    other = events(:shipping_closed).tap do |event|
+      event.update_columns(particulars: { ignored: "value" })
+    end
+
+    get activities_path, as: :json
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity_for(assignment)["particulars"])
+    assert_equal({ "old_board" => "Old board", "new_board" => "" }, activity_for(board_change)["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "New title" }, activity_for(title_change)["particulars"])
+    assert_equal({ "column" => "" }, activity_for(triage)["particulars"])
+    assert_equal({ "column" => "" }, activity_for(sent_back_to_triage)["particulars"])
+    assert_equal({}, activity_for(other)["particulars"])
+  end
+
+  test "filters by creator and board" do
+    get activities_path, params: {
+      creator_ids: [ users(:david).id ],
+      board_ids: [ boards(:writebook).id ]
+    }, as: :json
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:david).id }
+    assert @response.parsed_body.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "only returns activity from accessible boards" do
+    private_card = with_current_user(users(:kevin)) do
+      boards(:private).cards.create!(title: "Private activity", creator: users(:kevin), status: :published)
+    end
+    private_event = private_card.events.find_by!(action: "card_published")
+
+    logout_and_sign_in_as :jason
+    get activities_path, as: :json
+
+    assert_nil activity_for(private_event)
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+
+    assert_empty @response.parsed_body
+  end
+
+  test "uses standard JSON pagination" do
+    base_time = Time.current
+    Event.insert_all!(20.times.map do |index|
+      {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: accounts("37s").id,
+        action: "card_published",
+        board_id: boards(:writebook).id,
+        creator_id: users(:kevin).id,
+        eventable_type: "Card",
+        eventable_id: cards(:logo).id,
+        particulars: {},
+        created_at: base_time - index.seconds,
+        updated_at: base_time - index.seconds
+      }
+    end)
+
+    get activities_path, as: :json
+
+    first_page = @response.parsed_body
+    next_page = next_page_from_link_header(@response.headers["Link"])
+
+    assert_response :success
+    assert_equal 15, first_page.size
+    assert next_page
+    assert @response.headers["X-Total-Count"].to_i > first_page.size
+
+    get next_page, as: :json
+
+    second_page = @response.parsed_body
+    assert second_page.any?
+    assert_empty first_page.pluck("id") & second_page.pluck("id")
+    assert_operator first_page.last["created_at"], :>=, second_page.first["created_at"]
+  end
+
+  test "defaults to JSON and rejects HTML" do
+    get activities_path
+
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+
+    get activities_path(format: :html)
+
+    assert_response :not_acceptable
+  end
+
+  private
+    def activity_for(event)
+      @response.parsed_body.find { |activity| activity["id"] == event.id }
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
