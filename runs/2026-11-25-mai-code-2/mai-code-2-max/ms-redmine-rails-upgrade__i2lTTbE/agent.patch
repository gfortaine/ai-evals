diff --git a/lib/redmine/rails_compatibility.rb b/lib/redmine/rails_compatibility.rb
new file mode 100644
index 0000000..e973cb2
--- /dev/null
+++ b/lib/redmine/rails_compatibility.rb
@@ -0,0 +1,79 @@
+# frozen_string_literal: true
+
+require 'openssl'
+
+module Redmine
+  module RailsCompatibility
+    KEY_GENERATOR_ITERATIONS = 1_000
+    LEGACY_CIPHER = 'aes-256-cbc'
+
+    module LegacyCookieParser
+      private
+
+      def parse(name, dumped, force_reserialize: false, **options)
+        # A forced reserialization means a legacy key or cipher accepted the cookie.
+        legacy_serializer = ActiveSupport::Messages::SerializerWithFallback[:marshal]
+        return super unless force_reserialize && legacy_serializer.dumped?(dumped)
+
+        begin
+          value = legacy_serializer.load(dumped)
+        rescue StandardError
+          return super
+        end
+        self[name] = {:value => value}
+        upgraded(name)
+        value
+      end
+    end
+
+    class << self
+      def install
+        return if @installed
+
+        install_legacy_cookie_serializer
+        install_cookie_rotations
+        install_mail_link_rotation
+        @installed = true
+      end
+
+      def generated_key(salt, digest_class, length = 64)
+        OpenSSL::PKCS5.pbkdf2_hmac(
+          Rails.application.secret_key_base,
+          salt,
+          KEY_GENERATOR_ITERATIONS,
+          length,
+          digest_class.new
+        )
+      end
+
+      private
+
+      def install_legacy_cookie_serializer
+        ActionDispatch::Cookies::SerializedCookieJars.prepend LegacyCookieParser
+      end
+
+      def install_cookie_rotations
+        config = Rails.application.config.action_dispatch
+        rotations = config.cookies_rotations
+
+        rotations.rotate(
+          :signed,
+          generated_key(config.signed_cookie_salt, OpenSSL::Digest::SHA1),
+          :digest => 'SHA1'
+        )
+        rotations.rotate(
+          :encrypted,
+          generated_key(config.encrypted_cookie_salt, OpenSSL::Digest::SHA1, 32),
+          generated_key(config.encrypted_signed_cookie_salt, OpenSSL::Digest::SHA1),
+          :cipher => LEGACY_CIPHER,
+          :digest => 'SHA1'
+        )
+      end
+
+      def install_mail_link_rotation
+        verifier = Rails.application.message_verifier(:mail_links)
+        verifier.rotate generated_key('mail_links', OpenSSL::Digest::SHA1)
+      end
+    end
+  end
+end
