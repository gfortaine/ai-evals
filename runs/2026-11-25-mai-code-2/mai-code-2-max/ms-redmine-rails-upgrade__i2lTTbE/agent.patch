diff --git a/test/unit/lib/redmine/rails_compatibility_test.rb b/test/unit/lib/redmine/rails_compatibility_test.rb
new file mode 100644
index 0000000..0ddc760
--- /dev/null
+++ b/test/unit/lib/redmine/rails_compatibility_test.rb
@@ -0,0 +1,171 @@
+# frozen_string_literal: true
+
+require_relative '../../../test_helper'
+
+class Redmine::RailsCompatibilityTest < ActiveSupport::TestCase
+  def test_framework_uses_rails_8_1_defaults
+    assert_equal '8.1', Rails.application.config.loaded_config_version.to_s
+    assert_equal 7.1, ActiveSupport.cache_format_version
+    assert_equal :json_allow_marshal, Rails.application.config.active_support.message_serializer
+    assert_equal true, Rails.application.config.active_support.use_message_serializer_for_metadata
+    assert_equal 7.1, ActiveRecord.marshalling_format_version
+    assert_equal :json, Rails.application.config.action_dispatch.cookies_serializer
+  end
+
+  def test_cache_format_is_readable_by_rails_7_2_rollback
+    payload = {'release' => '8.1'}
+    entry = ActiveSupport::Cache::Entry.new(payload)
+    current_writer = ActiveSupport::Cache::SerializerWithFallback[:marshal_7_1]
+    rollback_reader = ActiveSupport::Cache::SerializerWithFallback[:marshal_7_0]
+
+    assert_equal payload, rollback_reader.load(current_writer.dump(entry)).value
+  end
+
+  def test_cache_format_reads_rails_7_2_writes
+    payload = {'release' => '7.2'}
+    entry = ActiveSupport::Cache::Entry.new(payload)
+    rollback_writer = ActiveSupport::Cache::SerializerWithFallback[:marshal_7_0]
+    current_reader = ActiveSupport::Cache::SerializerWithFallback[:marshal_7_1]
+
+    assert_equal payload, current_reader.load(rollback_writer.dump(entry)).value
+  end
+
+  def test_mail_link_verifier_reads_rails_6_1_tokens
+    payload = {'user_id' => 2, 'issue_id' => 1}
+    key = Redmine::RailsCompatibility.generated_key('mail_links', OpenSSL::Digest::SHA1)
+    verifier = ActiveSupport::MessageVerifier.new(key, :serializer => :marshal)
+    token = with_legacy_message_metadata { verifier.generate(payload, :purpose => :unwatch, :expires_in => 30.days) }
+
+    assert_equal payload, Mailer.verify_mail_link(token, :unwatch)
+  end
+
+  def test_rails_7_2_verifier_reads_rails_8_1_mail_links
+    payload = {'user_id' => 2, 'issue_id' => 1, 'release' => '8.1'}
+    token = Mailer.mail_link_token(:unwatch, payload)
+    rollback_verifier = ActiveSupport::MessageVerifier.new(current_mail_link_key, :serializer => :marshal)
+
+    with_legacy_message_metadata do
+      assert_equal payload, rollback_verifier.verify(token, :purpose => :unwatch)
+    end
+  end
+
+  def test_mail_link_verifier_reads_rails_7_2_tokens
+    payload = {'user_id' => 2, 'issue_id' => 1, 'release' => '7.2'}
+    verifier = ActiveSupport::MessageVerifier.new(current_mail_link_key, :serializer => :marshal)
+    token = with_legacy_message_metadata { verifier.generate(payload, :purpose => :unwatch, :expires_in => 30.days) }
+
+    assert_equal payload, Mailer.verify_mail_link(token, :unwatch)
+  end
+
+  def test_rails_7_2_reads_rails_8_1_active_record_marshalling
+    record = User.find(1)
+    dumped = Marshal.dump(record)
+
+    ActiveRecord.marshalling_format_version = 6.1
+    # This test only loads the record dumped immediately above.
+    # rubocop:disable Security/MarshalLoad
+    restored = Marshal.load(dumped)
+    # rubocop:enable Security/MarshalLoad
+    assert_instance_of User, restored
+    assert_equal record.id, restored.id
+  ensure
+    ActiveRecord.marshalling_format_version = 7.1
+  end
+
+  def test_active_record_reads_rails_7_2_marshalling
+    record = User.find(1)
+    ActiveRecord.marshalling_format_version = 6.1
+    dumped = Marshal.dump(record)
+    ActiveRecord.marshalling_format_version = 7.1
+
+    # This test only loads the record dumped immediately above.
+    # rubocop:disable Security/MarshalLoad
+    restored = Marshal.load(dumped)
+    # rubocop:enable Security/MarshalLoad
+    assert_instance_of User, restored
+    assert_equal record.id, restored.id
+  ensure
+    ActiveRecord.marshalling_format_version = 7.1
+  end
+
+  def test_encrypted_cookie_jar_reads_rails_6_1_sessions
+    payload = {'user_id' => 2, 'release' => '6.1'}
+    cookie = legacy_encrypted_cookie('upgrade_probe', payload)
+
+    assert_equal payload, read_encrypted_cookie('upgrade_probe', cookie)
+  end
+
+  def test_encrypted_cookie_jar_reads_rails_7_2_sessions
+    payload = {'user_id' => 2, 'release' => '7.2'}
+    cookie = current_encrypted_cookie('upgrade_probe', payload)
+
+    assert_equal payload, read_encrypted_cookie('upgrade_probe', cookie)
+  end
+
+  def test_rails_7_2_hybrid_cookie_jar_reads_rails_8_1_sessions
+    payload = {'user_id' => 2, 'release' => '8.1'}
+    cookie = current_encrypted_cookie('upgrade_probe', payload)
+
+    assert_equal payload, read_encrypted_cookie('upgrade_probe', cookie, :cookies_serializer => :hybrid)
+  end
+
+  private
+
+  def current_mail_link_key
+    Redmine::RailsCompatibility.generated_key('mail_links', OpenSSL::Digest::SHA256)
+  end
+
+  def with_legacy_message_metadata
+    old_setting = ActiveSupport::Messages::Metadata.use_message_serializer_for_metadata
+    ActiveSupport::Messages::Metadata.use_message_serializer_for_metadata = false
+    yield
+  ensure
+    ActiveSupport::Messages::Metadata.use_message_serializer_for_metadata = old_setting
+  end
+
+  def read_encrypted_cookie(name, cookie, cookies_serializer: :json)
+    env = Rack::MockRequest.env_for(
+      '/',
+      'HTTP_COOKIE' => "#{name}=#{Rack::Utils.escape(cookie)}"
+    ).merge(Rails.application.env_config).merge(
+      'action_dispatch.cookies_serializer' => cookies_serializer
+    )
+
+    ActionDispatch::Request.new(env).cookie_jar.encrypted[name]
+  end
+
+  def legacy_encrypted_cookie(_name, payload)
+    config = Rails.application.config.action_dispatch
+    key = Redmine::RailsCompatibility.generated_key(config.encrypted_cookie_salt, OpenSSL::Digest::SHA1, 32)
+    sign_key = Redmine::RailsCompatibility.generated_key(
+      config.encrypted_signed_cookie_salt,
+      OpenSSL::Digest::SHA1
+    )
+    encryptor = ActiveSupport::MessageEncryptor.new(
+      key,
+      sign_key,
+      :cipher => 'aes-256-cbc',
+      :digest => 'SHA1',
+      :serializer => ActiveSupport::MessageEncryptor::NullSerializer
+    )
+    encryptor.encrypt_and_sign(Marshal.dump(payload))
+  end
+
+  def current_encrypted_cookie(name, payload)
+    config = Rails.application.config.action_dispatch
+    key = Redmine::RailsCompatibility.generated_key(
+      config.authenticated_encrypted_cookie_salt,
+      OpenSSL::Digest::SHA256,
+      32
+    )
+    encryptor = ActiveSupport::MessageEncryptor.new(
+      key,
+      :cipher => 'aes-256-gcm',
+      :serializer => ActiveSupport::MessageEncryptor::NullSerializer
+    )
+    encryptor.encrypt_and_sign(
+      ActiveSupport::JSON.encode(payload),
+      :purpose => "cookie.#{name}"
+    )
+  end
+end
