diff --git a/test/unit/lib/redmine/rails_compatibility_test.rb b/test/unit/lib/redmine/rails_compatibility_test.rb
new file mode 100644
index 0000000..40695e6
--- /dev/null
+++ b/test/unit/lib/redmine/rails_compatibility_test.rb
@@ -0,0 +1,65 @@
+# frozen_string_literal: true
+
+require_relative '../../../test_helper'
+
+class Redmine::RailsCompatibilityTest < ActiveSupport::TestCase
+  def test_mail_link_verifier_reads_the_other_rails_key_derivation
+    payload = {'user_id' => 2, 'issue_id' => 1}
+    verifier = ActiveSupport::MessageVerifier.new(alternate_mail_link_key)
+    token = verifier.generate(payload, :purpose => :unwatch, :expires_in => 30.days)
+
+    assert_equal payload, Mailer.verify_mail_link(token, :unwatch)
+  end
+
+  def test_encrypted_cookie_jar_reads_the_other_rails_format
+    payload = {'user_id' => 2, 'release' => 'other'}
+    cookie = alternate_encrypted_cookie('upgrade_probe', payload)
+    env = Rack::MockRequest.env_for(
+      '/',
+      'HTTP_COOKIE' => "upgrade_probe=#{Rack::Utils.escape(cookie)}"
+    ).merge(Rails.application.env_config)
+
+    assert_equal payload, ActionDispatch::Request.new(env).cookie_jar.encrypted['upgrade_probe']
+  end
+
+  private
+
+  def alternate_mail_link_key
+    Redmine::RailsCompatibility.generated_key('mail_links', alternate_digest)
+  end
+
+  def alternate_encrypted_cookie(name, payload)
+    config = Rails.application.config.action_dispatch
+    if Rails::VERSION::MAJOR >= 7
+      key = Redmine::RailsCompatibility.generated_key(config.encrypted_cookie_salt, alternate_digest, 32)
+      sign_key = Redmine::RailsCompatibility.generated_key(config.encrypted_signed_cookie_salt, alternate_digest)
+      encryptor = ActiveSupport::MessageEncryptor.new(
+        key,
+        sign_key,
+        :cipher => 'aes-256-cbc',
+        :digest => 'SHA1',
+        :serializer => ActiveSupport::MessageEncryptor::NullSerializer
+      )
+      encryptor.encrypt_and_sign(Marshal.dump(payload))
+    else
+      key = Redmine::RailsCompatibility.generated_key(
+        config.authenticated_encrypted_cookie_salt,
+        alternate_digest,
+        32
+      )
+      encryptor = ActiveSupport::MessageEncryptor.new(
+        key,
+        :cipher => 'aes-256-gcm',
+        :serializer => ActiveSupport::MessageEncryptor::NullSerializer
+      )
+      encryptor.encrypt_and_sign(
+        ActiveSupport::JSON.encode(payload),
+        :purpose => "cookie.#{name}"
+      )
+    end
+  end
+
+  def alternate_digest
+    Rails::VERSION::MAJOR >= 7 ? OpenSSL::Digest::SHA1 : OpenSSL::Digest::SHA256
+  end
+end
