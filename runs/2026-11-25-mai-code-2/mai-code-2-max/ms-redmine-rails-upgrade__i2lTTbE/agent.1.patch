diff --git a/lib/redmine/rails_compatibility.rb b/lib/redmine/rails_compatibility.rb
new file mode 100644
index 0000000..a40868d
--- /dev/null
+++ b/lib/redmine/rails_compatibility.rb
@@ -0,0 +1,74 @@
+# frozen_string_literal: true
+
+require 'openssl'
+
+module Redmine
+  module RailsCompatibility
+    KEY_GENERATOR_ITERATIONS = 1_000
+    LEGACY_CIPHER = 'aes-256-cbc'
+    CURRENT_CIPHER = 'aes-256-gcm'
+
+    class << self
+      def install
+        return if @installed
+
+        install_cookie_rotations
+        install_mail_link_rotation
+        @installed = true
+      end
+
+      def generated_key(salt, digest_class, length = 64)
+        OpenSSL::PKCS5.pbkdf2_hmac(
+          Rails.application.secret_key_base,
+          salt,
+          KEY_GENERATOR_ITERATIONS,
+          length,
+          digest_class.new
+        )
+      end
+
+      private
+
+      def install_cookie_rotations
+        config = Rails.application.config.action_dispatch
+        rotations = config.cookies_rotations
+
+        rotations.rotate(
+          :signed,
+          generated_key(config.signed_cookie_salt, alternate_digest),
+          :digest => 'SHA1'
+        )
+
+        if rails_7?
+          rotations.rotate(
+            :encrypted,
+            generated_key(config.encrypted_cookie_salt, alternate_digest, 32),
+            generated_key(config.encrypted_signed_cookie_salt, alternate_digest),
+            :cipher => LEGACY_CIPHER,
+            :digest => 'SHA1'
+          )
+        else
+          rotations.rotate(
+            :encrypted,
+            generated_key(config.authenticated_encrypted_cookie_salt, alternate_digest, 32),
+            nil,
+            :cipher => CURRENT_CIPHER
+          )
+        end
+      end
+
+      def install_mail_link_rotation
+        verifier = Rails.application.message_verifier(:mail_links)
+        verifier.rotate generated_key('mail_links', alternate_digest)
+      end
+
+      def alternate_digest
+        rails_7? ? OpenSSL::Digest::SHA1 : OpenSSL::Digest::SHA256
+      end
+
+      def rails_7?
+        Rails::VERSION::MAJOR >= 7
+      end
+    end
+  end
+end
