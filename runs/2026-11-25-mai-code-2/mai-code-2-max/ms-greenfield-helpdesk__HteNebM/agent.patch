diff --git a/app/controllers/api/v1/tickets_controller.rb b/app/controllers/api/v1/tickets_controller.rb
new file mode 100644
index 0000000..8eab5c3
--- /dev/null
+++ b/app/controllers/api/v1/tickets_controller.rb
@@ -0,0 +1,225 @@
+module Api
+  module V1
+    class TicketsController < BaseController
+      before_action :set_current_account
+      before_action :require_active_account
+      before_action :authenticate_user!
+      before_action :require_staff!
+      before_action :set_ticket, only: %i[show update merge]
+
+      def index
+        scope = filtered_ticket_scope
+          .includes(:requester, :assignee, :group)
+        records, pagination = paginate(scope, order: { updated_at: :desc, id: :desc })
+
+        render json: {
+          tickets: records.map { |ticket| ticket_json(ticket) },
+          **pagination
+        }
+      end
+
+      def show
+        render json: { ticket: ticket_json(@ticket) }
+      end
+
+      def update
+        attributes = params.require(:ticket).permit(
+          :status,
+          :priority,
+          :assignee_id,
+          :group_id,
+          comment: %i[body public]
+        )
+        comment_attributes = attributes[:comment]
+        body = comment_attributes.require(:body) if comment_attributes
+        public_comment = comment_attributes && comment_attributes.key?(:public) ?
+          ActiveModel::Type::Boolean.new.cast(comment_attributes[:public]) : true
+
+        comment = nil
+        current_account.with_lock do
+          @ticket.lock!
+          ensure_ticket_editable!(@ticket)
+          @ticket.status = attributes[:status] if attributes.key?(:status)
+          @ticket.priority = attributes[:priority] if attributes.key?(:priority)
+
+          group_cleared = false
+          if attributes.key?(:group_id)
+            requested_group_id = attributes[:group_id]
+            group_cleared = requested_group_id.blank?
+            group = requested_group_id.present? ? current_account.groups.find_by(id: requested_group_id) : nil
+            if requested_group_id.present? && group.nil?
+              @ticket.errors.add(:group_id, "must be a group in this account")
+              raise ActiveRecord::RecordInvalid, @ticket
+            end
+            @ticket.group = group
+          end
+
+          if attributes.key?(:assignee_id)
+            assignee_id = attributes[:assignee_id]
+            assignee = assignee_id.present? ? current_account.users.active_staff.find_by(id: assignee_id) : nil
+            if assignee_id.present? && assignee.nil?
+              @ticket.errors.add(:assignee_id, "must be an active staff member in this account")
+              raise ActiveRecord::RecordInvalid, @ticket
+            end
+            @ticket.assignee = assignee
+
+            if assignee && @ticket.group.nil? && !group_cleared
+              @ticket.group = assignee.default_group
+            elsif assignee && @ticket.group && !assignee.group_memberships.exists?(group_id: @ticket.group_id)
+              @ticket.errors.add(:assignee_id, "must belong to the ticket's group")
+              raise ActiveRecord::RecordInvalid, @ticket
+            end
+          end
+
+          @ticket.assignee = nil if group_cleared
+
+          if @ticket.has_changes_to_save?
+            touches_activity = @ticket.will_save_change_to_status? ||
+                               @ticket.will_save_change_to_priority?
+            @ticket.save!(touch: touches_activity)
+          end
+          comment = @ticket.comments.create!(
+            author: current_user,
+            body: body,
+            public: public_comment
+          ) if body
+        end
+
+        if comment&.public? && @ticket.email_origin?
+          HelpdeskMailer.ticket_reply(@ticket, comment).deliver_now
+        end
+
+        render json: { ticket: ticket_json(@ticket.reload) }
+      end
+
+      def merge
+        attributes = params.require(:merge).permit(
+          :target_id,
+          source_comment: %i[body public],
+          target_comment: %i[body public]
+        )
+        target_id = attributes.require(:target_id)
+        target = nil
+
+        current_account.with_lock do
+          @ticket.lock!
+          ensure_ticket_editable!(@ticket)
+
+          target = current_account.tickets.find(target_id)
+          target.lock!
+          ensure_ticket_editable!(target)
+
+          if target.id == @ticket.id
+            @ticket.errors.add(:target_id, "must be another ticket")
+            raise ActiveRecord::RecordInvalid, @ticket
+          end
+          unless target.requester_id == @ticket.requester_id
+            @ticket.errors.add(:target_id, "must belong to the same customer")
+            raise ActiveRecord::RecordInvalid, @ticket
+          end
+
+          source_note = merge_note_attributes(
+            attributes[:source_comment],
+            "Merged into ticket ##{target.id}."
+          )
+          target_note = merge_note_attributes(
+            attributes[:target_comment],
+            "Merged ticket ##{@ticket.id} into this ticket."
+          )
+
+          @ticket.update!(status: :closed, merged_into: target)
+          @ticket.comments.create!(author: current_user, **source_note)
+          target.comments.create!(author: current_user, **target_note)
+        end
+
+        render json: {
+          source: ticket_json(@ticket.reload),
+          target: ticket_json(target.reload)
+        }
+      end
+
+      private
+
+      def set_ticket
+        @ticket = current_account.tickets.includes(:requester, :assignee, :group).find(params[:id])
+      end
+
+      def filtered_ticket_scope
+        scope = current_account.tickets
+        scope = scope.where(status: enum_filter(:status, Ticket::STATUSES)) if params.key?(:status)
+        scope = scope.where(priority: enum_filter(:priority, Ticket::PRIORITIES)) if params.key?(:priority)
+        if params.key?(:assignee_id)
+          scope = scope.where(assignee_id: person_id_filter(:assignee_id, allow_unassigned: true))
+        end
+        if params.key?(:group_id)
+          scope = scope.where(group_id: person_id_filter(:group_id, allow_unassigned: true))
+        end
+        scope = scope.where(requester_id: person_id_filter(:requester_id)) if params.key?(:requester_id)
+        scope = search_scope(scope) if params.key?(:q) && params[:q].to_s != ""
+        scope
+      end
+
+      def search_scope(scope)
+        pattern = "%#{Ticket.sanitize_sql_like(params[:q].to_s)}%"
+        condition = <<~SQL.squish
+          tickets.subject ILIKE :pattern
+          OR EXISTS (
+            SELECT 1
+            FROM comments
+            WHERE comments.ticket_id = tickets.id
+              AND comments.public = TRUE
+              AND comments.body ILIKE :pattern
+          )
+        SQL
+
+        scope.where(condition, pattern: pattern)
+      end
+
+      def enum_filter(name, allowed_values)
+        value = params[name].to_s.strip.downcase
+        return value if allowed_values.include?(value)
+
+        raise ApiRequestError.new(
+          "#{name} must be one of: #{allowed_values.join(', ')}",
+          status: :bad_request,
+          code: "invalid_filter"
+        )
+      end
+
+      def person_id_filter(name, allow_unassigned: false)
+        value = params[name].to_s.strip
+        if allow_unassigned && value.downcase == "unassigned"
+          return nil
+        end
+
+        id = Integer(value, 10)
+        return id if id.positive? && id <= (2**63 - 1)
+
+        invalid_person_id_filter!(name, allow_unassigned)
+      rescue ArgumentError
+        invalid_person_id_filter!(name, allow_unassigned)
+      end
+
+      def invalid_person_id_filter!(name, allow_unassigned)
+        expectation = allow_unassigned ? "unassigned or a positive integer" : "a positive integer"
+        raise ApiRequestError.new(
+          "#{name} must be #{expectation}",
+          status: :bad_request,
+          code: "invalid_filter"
+        )
+      end
+
+      def ticket_json(ticket)
+        TicketSerializer.new(ticket, include_requester: true).as_json
+      end
+
+      def merge_note_attributes(attributes, default_body)
+        {
+          body: attributes&.key?(:body) ? attributes[:body] : default_body,
+          public: attributes&.key?(:public) ?
+            ActiveModel::Type::Boolean.new.cast(attributes[:public]) : false
+        }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/users_controller.rb b/app/controllers/api/v1/users_controller.rb
new file mode 100644
index 0000000..b449f4c
--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,103 @@
+module Api
+  module V1
+    class UsersController < BaseController
+      before_action :set_current_account
+      before_action :require_active_account
+      before_action :authenticate_user!
+      before_action :require_admin!
+      before_action :set_user, only: %i[show update]
+
+      def index
+        scope = current_account.users
+        scope = scope.where(role: role_filter) if params.key?(:role)
+        scope = scope.where(suspended: suspension_filter) if params.key?(:suspended)
+        records, pagination = paginate(scope, order: { id: :asc })
+
+        render json: {
+          users: records.map { |user| user_json(user) },
+          **pagination
+        }
+      end
+
+      def show
+        render json: { user: user_json(@user) }
+      end
+
+      def update
+        attributes = params.require(:user).permit(:suspended)
+        unless attributes.key?(:suspended)
+          raise ApiRequestError.new(
+            "user.suspended is required",
+            status: :bad_request,
+            code: "invalid_request"
+          )
+        end
+
+        desired_suspension = boolean_value(attributes[:suspended], "suspended")
+
+        current_account.with_lock do
+          @user.lock!
+          if desired_suspension && @user.admin? && @user.active?
+            other_active_admin = current_account.users
+              .where(role: "admin", suspended: false)
+              .where.not(id: @user.id)
+              .exists?
+
+            unless other_active_admin
+              @user.errors.add(:suspended, "cannot be changed for the last active admin")
+              raise ActiveRecord::RecordInvalid, @user
+            end
+          end
+
+          was_suspended = @user.suspended?
+          @user.update!(suspended: desired_suspension)
+
+          if desired_suspension && !was_suspended
+            @user.sessions.delete_all
+            current_account.tickets.where(assignee_id: @user.id).update_all(assignee_id: nil)
+          end
+        end
+
+        render json: { user: user_json(@user.reload) }
+      end
+
+      private
+
+      def set_user
+        @user = current_account.users.find(params[:id])
+      end
+
+      def role_filter
+        role = params[:role].to_s.strip.downcase
+        return role if User::ROLES.include?(role)
+
+        raise ApiRequestError.new(
+          "role must be one of: #{User::ROLES.join(', ')}",
+          status: :bad_request,
+          code: "invalid_filter"
+        )
+      end
+
+      def suspension_filter
+        boolean_value(params[:suspended], "suspended")
+      end
+
+      def boolean_value(value, field)
+        return value if value == true || value == false
+
+        case value.to_s.strip.downcase
+        when "true", "1"
+          true
+        when "false", "0"
+          false
+        else
+          raise ApiRequestError.new(
+            "#{field} must be true or false",
+            status: :bad_request,
+            code: "invalid_boolean"
+          )
+        end
+      end
+    end
+  end
+end
diff --git a/app/controllers/application_controller.rb b/app/controllers/application_controller.rb
new file mode 100644
index 0000000..1cf9c31
--- /dev/null
+++ b/app/controllers/application_controller.rb
@@ -0,0 +1,35 @@
+class ApiRequestError < StandardError
+  attr_reader :status, :code
+
+  def initialize(message, status:, code:)
+    super(message)
+    @status = status
+    @code = code
+  end
+end
+
+class ApplicationController < ActionController::API
+  rescue_from ApiRequestError, with: :render_api_error
+  rescue_from ActionController::ParameterMissing, with: :render_parameter_error
+  rescue_from ActiveRecord::RecordInvalid, with: :render_record_errors
+  rescue_from ActiveRecord::RecordNotUnique, with: :render_duplicate_error
+
+  private
+
+  def render_api_error(error)
+    render json: { error: error.message, code: error.code }, status: error.status
+  end
+
+  def render_parameter_error(error)
+    render json: { error: error.message, code: "invalid_request" }, status: :bad_request
+  end
+
+  def render_record_errors(error)
+    render json: { errors: error.record.errors.to_hash(full_messages: true) }, status: :unprocessable_entity
+  end
+
+  def render_duplicate_error
+    render json: { error: "A matching record already exists", code: "duplicate_record" },
+           status: :unprocessable_entity
+  end
+end
