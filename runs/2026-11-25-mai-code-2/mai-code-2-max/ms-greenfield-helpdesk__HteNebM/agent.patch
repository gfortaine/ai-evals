+
+    get "/api/v1/group_memberships?user_id=#{@agent.id}",
+        headers: authenticated_headers(@agent_token),
+        as: :json
+    assert_equal 2, response.parsed_body.fetch("group_memberships").length
+
+    get "/api/v1/group_memberships/#{billing_membership.fetch('id')}",
+        headers: authenticated_headers(@agent_token),
+        as: :json
+    assert_response :success
+    assert_equal billing.id, response.parsed_body.dig("group_membership", "group", "id")
+
+    post "/api/v1/group_memberships",
