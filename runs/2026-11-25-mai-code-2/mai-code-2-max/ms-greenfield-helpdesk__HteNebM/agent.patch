diff --git a/test/integration/cursor_pagination_api_test.rb b/test/integration/cursor_pagination_api_test.rb
new file mode 100644
index 0000000..eb4d510
--- /dev/null
+++ b/test/integration/cursor_pagination_api_test.rb
@@ -0,0 +1,157 @@
+require "test_helper"
+require "uri"
+
+class CursorPaginationApiTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = Account.create!(name: "Cursor Co", subdomain: "cursor-co")
+    @owner = create_user("Owner", "owner@cursor.test", :admin)
+    @account.update!(owner: @owner)
+    @agent = create_user("Agent", "agent@cursor.test", :agent)
+    @customer = create_user("Customer", "customer@cursor.test", :customer)
+    @owner_token = issue_session(@owner)
+    @customer_token = issue_session(@customer)
+  end
+
+  test "keyset cursors traverse ticket activity without timestamp or concurrent-insert drift" do
+    timestamp = 2.hours.ago.change(usec: 123_456)
+    tickets = 5.times.map do |index|
+      create_ticket("Ticket #{index}").tap do |ticket|
+        ticket.update_columns(updated_at: timestamp)
+      end
+    end
+
+    get "/api/v1/tickets?page[size]=2&status=open", headers: staff_headers
+    assert_response :success
+    first = response.parsed_body
+    assert_equal tickets.reverse.first(2).pluck(:id), first.fetch("tickets").pluck("id")
+    assert first.dig("meta", "has_more")
+    assert_not_nil first.dig("meta", "after_cursor")
+    assert_not_nil first.dig("meta", "before_cursor")
+    assert_includes first.dig("links", "next"), "status=open"
+    refute first.key?("count")
+
+    create_ticket("Inserted while browsing")
+
+    get request_uri(first.dig("links", "next")), headers: staff_headers
+    assert_response :success
+    second = response.parsed_body
+    assert_equal tickets.reverse.slice(2, 2).pluck(:id), second.fetch("tickets").pluck("id")
+    assert second.dig("meta", "has_more")
+
+    get request_uri(second.dig("links", "next")), headers: staff_headers
+    assert_response :success
+    assert_equal [tickets.first.id], response.parsed_body.fetch("tickets").pluck("id")
+    refute response.parsed_body.dig("meta", "has_more")
+    assert_nil response.parsed_body.dig("links", "next")
+
+    get request_uri(second.dig("links", "prev")), headers: staff_headers
+    assert_response :success
+    assert_equal first.fetch("tickets").pluck("id"), response.parsed_body.fetch("tickets").pluck("id")
+    assert response.parsed_body.dig("meta", "has_more")
+  end
+
+  test "every collection supports forward and backward cursor links" do
+    billing = @account.groups.create!(name: "Billing")
+    support = @account.groups.create!(name: "Support")
+    billing.group_memberships.create!(user: @owner)
+    support.group_memberships.create!(user: @agent)
+    2.times do |index|
+      Invitation.issue!(
+        account: @account,
+        invited_by: @owner,
+        email: "invite#{index}@cursor.test",
+        role: :agent
+      )
+    end
+    ticket = create_ticket("Cursor comments")
+    create_ticket("Another cursor request")
+    ticket.comments.create!(author: @agent, body: "Second comment", public: true)
+
+    collections = [
+      ["/api/v1/tickets", "tickets", staff_headers],
+      ["/api/v1/requests", "requests", customer_headers],
+      ["/api/v1/tickets/#{ticket.id}/comments", "comments", staff_headers],
+      ["/api/v1/requests/#{ticket.id}/comments", "comments", customer_headers],
+      ["/api/v1/invitations", "invitations", staff_headers],
+      ["/api/v1/users", "users", staff_headers],
+      ["/api/v1/staff", "staff", staff_headers],
+      ["/api/v1/groups", "groups", staff_headers],
+      ["/api/v1/group_memberships", "group_memberships", staff_headers]
+    ]
+
+    collections.each do |path, key, headers|
+      get "#{path}?page[size]=1", headers: headers
+      assert_response :success, "expected cursor pagination for #{path}"
+      first = response.parsed_body
+      assert_equal 1, first.fetch(key).length
+      assert_not_nil first.dig("meta", "after_cursor")
+      assert_not_nil first.dig("meta", "before_cursor")
+      assert first.dig("meta", "has_more"), "expected another #{key} record"
+
+      get request_uri(first.dig("links", "next")), headers: headers
+      assert_response :success
+      second = response.parsed_body
+      refute_equal first.fetch(key).first.fetch("id"), second.fetch(key).first.fetch("id")
+
+      get request_uri(second.dig("links", "prev")), headers: headers
+      assert_response :success
+      assert_equal first.fetch(key).first.fetch("id"), response.parsed_body.fetch(key).first.fetch("id")
+    end
+  end
+
+  test "empty pages return null navigation and invalid cursors are rejected" do
+    get "/api/v1/tickets?page[size]=25&status=closed", headers: staff_headers
+    assert_response :success
+    assert_equal({
+      "has_more" => false,
+      "after_cursor" => nil,
+      "before_cursor" => nil
+    }, response.parsed_body.fetch("meta"))
+    assert_equal({ "next" => nil, "prev" => nil }, response.parsed_body.fetch("links"))
+
+    get "/api/v1/tickets?page[size]=25&page[after]=not-a-cursor", headers: staff_headers
+    assert_response :bad_request
+    assert_equal "invalid_pagination", response.parsed_body.fetch("code")
+  end
+
+  private
+
+  def create_user(name, email, role)
+    @account.users.create!(
+      name: name,
+      email: email,
+      password: "cursor-password",
+      role: role,
+      verified_at: Time.current
+    )
+  end
+
+  def create_ticket(subject)
+    ticket = @account.tickets.create!(requester: @customer, subject: subject)
+    ticket.comments.create!(author: @customer, body: "Initial comment", public: true)
+    ticket
+  end
+
+  def issue_session(user)
+    _session, token = Session.issue!(user)
+    token
+  end
+
+  def staff_headers
+    {
+      "X-Helpdesk-Account" => @account.subdomain,
+      "Authorization" => "Bearer #{@owner_token}"
+    }
+  end
+
+  def customer_headers
+    {
+      "X-Helpdesk-Account" => @account.subdomain,
+      "Authorization" => "Bearer #{@customer_token}"
+    }
+  end
+
+  def request_uri(url)
+    URI.parse(url).request_uri
+  end
+end
diff --git a/test/integration/group_management_api_test.rb b/test/integration/group_management_api_test.rb
new file mode 100644
index 0000000..fee6d88
--- /dev/null
+++ b/test/integration/group_management_api_test.rb
@@ -0,0 +1,324 @@
+require "test_helper"
+
+class GroupManagementApiTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme-groups")
+    @owner = create_user("Owner", "owner@acme-groups.test", :admin)
+    @account.update!(owner: @owner)
+    @agent = create_user("Agent", "agent@acme-groups.test", :agent)
+    @outsider = create_user("Other agent", "outsider@acme-groups.test", :agent)
+    @customer = create_user("Customer", "customer@acme-groups.test", :customer)
+    @owner_token = issue_session(@owner)
+    @agent_token = issue_session(@agent)
+    @outsider_token = issue_session(@outsider)
+    @customer_token = issue_session(@customer)
+  end
+
+  test "admins manage groups and staff can browse them" do
+    post "/api/v1/groups",
+         params: { group: { name: "Billing" } },
+         headers: authenticated_headers(@agent_token),
+         as: :json
+    assert_response :forbidden
+
+    post "/api/v1/groups",
+         params: { group: { name: " Billing " } },
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :created
