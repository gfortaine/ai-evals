diff --git a/app/models/group_membership.rb b/app/models/group_membership.rb
new file mode 100644
index 0000000..8154343
--- /dev/null
+++ b/app/models/group_membership.rb
@@ -0,0 +1,61 @@
+class GroupMembership < ApplicationRecord
+  belongs_to :group, inverse_of: :group_memberships
+  belongs_to :user, inverse_of: :group_memberships
+
+  before_create :prepare_default
+  around_destroy :preserve_default
+  before_destroy :clear_ticket_assignments
+
+  validates :default, inclusion: { in: [true, false] }
+  validates :user_id, uniqueness: { scope: :group_id }
+  validate :user_is_staff_in_group_account
+
+  def make_default!
+    self.class.transaction do
+      user.lock!
+      lock!
+
+      self.class
+        .where(user_id: user_id)
+        .where.not(id: id)
+        .where(default: true)
+        .update_all(default: false, updated_at: Time.current)
+      update!(default: true)
+      self
+    end
+  end
+
+  private
+
+  def prepare_default
+    user.lock!
+    siblings = self.class.where(user_id: user_id)
+
+    if default?
+      siblings.where(default: true).update_all(default: false, updated_at: Time.current)
+    elsif !siblings.where(default: true).exists?
+      self.default = true
+    end
+  end
+
+  def preserve_default
+    user.with_lock do
+      yield
+
+      unless self.class.where(user_id: user_id, default: true).exists?
+        self.class.where(user_id: user_id).order(:id).first&.update!(default: true)
+      end
+    end
+  end
+
+  def clear_ticket_assignments
+    Ticket.where(group_id: group_id, assignee_id: user_id).update_all(assignee_id: nil)
+  end
+
+  def user_is_staff_in_group_account
+    return unless user && group
+
+    errors.add(:user, "must be staff") unless user.staff?
+    errors.add(:user, "must belong to the group's account") unless user.account_id == group.account_id
+  end
+end
diff --git a/app/models/invitation.rb b/app/models/invitation.rb
new file mode 100644
index 0000000..97bf502
--- /dev/null
+++ b/app/models/invitation.rb
@@ -0,0 +1,207 @@
+class Invitation < ApplicationRecord
+  TOKEN_EXPIRATION = 7.days
+  ROLES = %w[admin agent].freeze
+  STATUSES = %w[pending accepted revoked expired].freeze
+
+  belongs_to :account, inverse_of: :invitations
+  belongs_to :invited_by, class_name: "User", optional: true
+  belongs_to :accepted_user, class_name: "User", optional: true
+
+  enum :role, ROLES.index_by(&:itself), validate: true
+
+  before_validation :normalize_email
+
+  validates :email,
+            presence: true,
+            length: { maximum: 255 },
+            format: { with: /\A[^@\s]+@[^@\s]+\z/ }
+  validates :token_digest, presence: true, uniqueness: true
+  validates :status, inclusion: { in: STATUSES }
+  validates :expires_at, presence: true
+  validate :inviter_belongs_to_account
+
+  def self.expire_stale!(account:)
+    where(account: account, status: "pending")
+      .where("expires_at <= ?", Time.current)
+      .update_all(status: "expired", updated_at: Time.current)
+  end
+
+  scope :for_status, lambda { |value|
+    now = Time.current
+
+    case value.to_s
+    when "pending"
+      where(status: "pending").where("expires_at > ?", now)
+    when "expired"
+      where(status: "expired").or(where(status: "pending").where("expires_at <= ?", now))
+    when "accepted", "revoked"
+      where(status: value.to_s)
+    else
+      none
+    end
+  }
+
+  scope :pending, -> { for_status("pending") }
+  scope :accepted, -> { where(status: "accepted") }
+  scope :revoked, -> { where(status: "revoked") }
+  scope :expired, -> { for_status("expired") }
+
+  def self.issue!(account:, invited_by:, email:, role:)
+    raw_token = TokenDigest.generate
+    invitation = account.with_lock do
+      expire_stale!(account: account)
+      record = account.invitations.build(
+        invited_by: invited_by,
+        email: email.to_s.strip.downcase,
+        role: role,
+        token_digest: TokenDigest.digest(raw_token),
+        status: "pending",
+        expires_at: Time.current + TOKEN_EXPIRATION
+      )
+
+      if account.users.exists?(email: record.email)
+        record.errors.add(:email, "already belongs to a user")
+        raise ActiveRecord::RecordInvalid, record
+      end
+
+      if account.invitations.where(email: record.email, status: "pending").exists?
+        record.errors.add(:email, "already has a pending invitation")
+        raise ActiveRecord::RecordInvalid, record
+      end
+
+      record.save!
+      record
+    end
+
+    [invitation, raw_token]
+  end
+
+  def self.accept!(account:, token:, name:, password:)
+    result = nil
+
+    account.with_lock do
+      expire_stale!(account: account)
+      invitation = account.invitations
+        .lock
+        .find_by(token_digest: TokenDigest.digest(token))
+
+      if invitation
+        invitation.expire_if_needed!
+
+        if invitation.pending?
+          if account.users.exists?(email: invitation.email)
+            invitation.errors.add(:email, "already belongs to a user")
+            raise ActiveRecord::RecordInvalid, invitation
+          end
+
+          user = account.users.create!(
+            email: invitation.email,
+            name: name,
+            password: password,
+            role: invitation.role,
+            verified_at: Time.current
+          )
+          invitation.update!(
+            status: "accepted",
+            accepted_at: Time.current,
+            accepted_user: user
+          )
+          result = [invitation, user]
+        end
+      end
+    end
+
+    result
+  end
+
+  def status
+    stored_status = self[:status]
+    return "expired" if stored_status == "pending" && expires_at && expires_at <= Time.current
+
+    stored_status
+  end
+
+  def pending?
+    status == "pending"
+  end
+
+  def accepted?
+    status == "accepted"
+  end
+
+  def revoked?
+    status == "revoked"
+  end
+
+  def expired?
+    status == "expired"
+  end
+
+  def expire_if_needed!
+    return unless self[:status] == "pending" && expires_at <= Time.current
+
+    update!(status: "expired")
+  end
+
+  def resend!
+    raw_token = TokenDigest.generate
+
+    account.with_lock do
+      lock!
+      expire_if_needed!
+
+      unless pending? || expired?
+        errors.add(:status, "does not allow resending")
+        raise ActiveRecord::RecordInvalid, self
+      end
+
+      if account.invitations.where(email: email, status: "pending").where.not(id: id).exists?
+        errors.add(:email, "already has a pending invitation")
+        raise ActiveRecord::RecordInvalid, self
+      end
+
+      if account.users.exists?(email: email)
+        errors.add(:email, "already belongs to a user")
+        raise ActiveRecord::RecordInvalid, self
+      end
+
+      update!(
+        token_digest: TokenDigest.digest(raw_token),
+        status: "pending",
+        expires_at: Time.current + TOKEN_EXPIRATION,
+        accepted_at: nil,
+        accepted_user: nil,
+        revoked_at: nil
+      )
+    end
+
+    raw_token
+  end
+
+  def revoke!
+    account.with_lock do
+      lock!
+      expire_if_needed!
+
+      unless pending?
+        errors.add(:status, "cannot be revoked")
+        raise ActiveRecord::RecordInvalid, self
+      end
+
+      update!(status: "revoked", revoked_at: Time.current)
+    end
+  end
+
+  private
+
+  def normalize_email
+    self.email = email.to_s.strip.downcase
+  end
+
+  def inviter_belongs_to_account
+    return unless invited_by
+
+    errors.add(:invited_by, "must belong to the account") unless invited_by.account_id == account_id
+    errors.add(:invited_by, "must be an admin") unless invited_by.admin?
+  end
+end
diff --git a/app/models/password_reset.rb b/app/models/password_reset.rb
