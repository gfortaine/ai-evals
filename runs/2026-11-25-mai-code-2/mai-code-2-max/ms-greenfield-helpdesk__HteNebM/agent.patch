+         },
+         headers: account_header,
+         as: :json
+    assert_response :success
+  end
+
+  test "invitations are filtered ordered resent revoked and expired" do
+    first = post_invitation("one@example.test", "agent").fetch("id")
+    second = post_invitation("two@example.test", "admin").fetch("id")
+    first_token = token_from(ActionMailer::Base.deliveries[-2])
+
+    get "/api/v1/invitations?status=pending",
+        headers: authenticated_headers(@owner_token),
+        as: :json
+    assert_response :success
+    assert_equal [first, second], response.parsed_body.fetch("invitations").pluck("id")
+
+    post "/api/v1/invitations/#{first}/resend",
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :success
+    refreshed_token = token_from(ActionMailer::Base.deliveries.last)
+    refute_equal first_token, refreshed_token
+    post "/api/v1/invitation_previews",
+         params: { invitation_preview: { token: first_token } },
+         headers: account_header,
+         as: :json
+    assert_response :unprocessable_entity
+
+    delete "/api/v1/invitations/#{first}",
+           headers: authenticated_headers(@owner_token),
+           as: :json
+    assert_response :success
+    assert_equal "revoked", response.parsed_body.dig("invitation", "status")
+
+    Invitation.find(second).update!(expires_at: 1.second.ago)
+    get "/api/v1/invitations?status=expired",
+        headers: authenticated_headers(@owner_token),
+        as: :json
+    assert_response :success
+    assert_equal [second], response.parsed_body.fetch("invitations").pluck("id")
+    assert_equal "expired", Invitation.find(second).reload.status
+
+    post "/api/v1/invitations/#{second}/resend",
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :success
+    assert_equal "pending", response.parsed_body.dig("invitation", "status")
+  end
+
+  test "admins manage suspension without removing the last active admin" do
+    second_admin = create_user("Second admin", "second-admin@acme.test", :admin)
+    agent = create_user("Agent", "agent@acme.test", :agent)
+    customer = create_user("Customer", "customer@acme.test", :customer)
+    second_admin_token = issue_session(second_admin)
