+++ b/test/integration/ticket_merge_api_test.rb
@@ -0,0 +1,266 @@
+require "test_helper"
+
+class TicketMergeApiTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+
+    @account = Account.create!(name: "Acme", subdomain: "acme-merge")
+    @owner = create_user("Owner", "owner@acme-merge.test", :admin)
+    @account.update!(owner: @owner)
+    @agent = create_user("Agent", "agent@acme-merge.test", :agent)
+    @customer = create_user("Avery", "avery@customer.test", :customer)
+    @other_customer = create_user("Blair", "blair@customer.test", :customer)
+    @owner_token = issue_session(@owner)
+    @customer_token = issue_session(@customer)
+  end
+
+  test "staff merge closes a duplicate and preserves the surviving ticket" do
+    source = create_ticket(@customer, subject: "Duplicate receipt problem", assignee: @agent)
+    target = create_ticket(
+      @customer,
+      subject: "Receipt download problem",
+      status: :pending,
+      priority: :high,
+      origin: "email",
+      assignee: @agent
+    )
+    source_comment_ids = source.comments.ids
+    target_comment_ids = target.comments.ids
+    target_attributes = target.attributes.slice(
+      "status", "priority", "assignee_id", "group_id", "origin",
+      "email_reply_token", "updated_at"
+    )
+
+    post "/api/v1/tickets/#{source.id}/merge",
+         params: { merge: { target_id: target.id } },
+         headers: staff_headers,
+         as: :json
+
+    assert_response :success
+    result = response.parsed_body
+    assert_equal source.id, result.dig("source", "id")
+    assert_equal "closed", result.dig("source", "status")
+    assert_equal target.id, result.dig("source", "merged_into_id")
+    assert_equal target.id, result.dig("target", "id")
+    assert_nil result.dig("target", "merged_into_id")
+    assert_equal target_attributes, target.reload.attributes.slice(*target_attributes.keys)
+    assert source.comments.where(id: source_comment_ids).exists?
+    assert target.comments.where(id: target_comment_ids).exists?
+
+    source_note = source.comments.order(:id).last
+    target_note = target.comments.order(:id).last
+    assert_equal @owner.id, source_note.author_id
+    assert_equal "Merged into ticket ##{target.id}.", source_note.body
+    refute source_note.public?
+    assert_equal @owner.id, target_note.author_id
+    assert_equal "Merged ticket ##{source.id} into this ticket.", target_note.body
+    refute target_note.public?
+    assert_empty ActionMailer::Base.deliveries
+
+    get "/api/v1/tickets/#{source.id}", headers: staff_headers
+    assert_response :success
+    assert_equal target.id, response.parsed_body.dig("ticket", "merged_into_id")
+
+    get "/api/v1/requests/#{source.id}", headers: customer_headers
+    assert_response :success
+    assert_equal "closed", response.parsed_body.dig("request", "status")
+    assert_equal target.id, response.parsed_body.dig("request", "merged_into_id")
+
+    get "/api/v1/tickets", params: { status: "closed" }, headers: staff_headers
+    assert_response :success
+    assert_equal [source.id], response.parsed_body.fetch("tickets").pluck("id")
+
+    get "/api/v1/requests", params: { status: "closed" }, headers: customer_headers
+    assert_response :success
+    assert_equal [source.id], response.parsed_body.fetch("requests").pluck("id")
+  end
+
+  test "custom public notes are independent and chained merges retain earlier links" do
+    first = create_ticket(@customer, subject: "First duplicate", origin: "email")
+    second = create_ticket(@customer, subject: "Second ticket", origin: "email")
+    final = create_ticket(
+      @customer,
+      subject: "Final ticket",
+      status: :solved,
+      origin: "email"
+    )
+
+    post "/api/v1/tickets/#{first.id}/merge",
+         params: {
+           merge: {
+             target_id: second.id,
+             source_comment: { body: "Continuing in ticket #{second.id}.", public: true },
+             target_comment: { body: "Duplicate checked.", public: false }
+           }
+         },
+         headers: staff_headers,
+         as: :json
+    assert_response :success
+
+    post "/api/v1/tickets/#{second.id}/merge",
+         params: {
+           merge: {
+             target_id: final.id,
+             source_comment: { body: "Use the final conversation.", public: false },
+             target_comment: { body: "Previous reports checked.", public: true }
+           }
+         },
+         headers: staff_headers,
+         as: :json
+    assert_response :success
+
+    assert_equal second.id, first.reload.merged_into_id
+    assert_equal final.id, second.reload.merged_into_id
+    assert first.closed?
+    assert second.closed?
+    assert final.reload.solved?
+    assert_nil final.merged_into_id
+
+    first_note = first.comments.find_by!(body: "Continuing in ticket #{second.id}.")
+    second_private_note = second.comments.find_by!(body: "Duplicate checked.")
+    second_close_note = second.comments.find_by!(body: "Use the final conversation.")
+    final_note = final.comments.find_by!(body: "Previous reports checked.")
+    assert first_note.public?
+    refute second_private_note.public?
+    refute second_close_note.public?
+    assert final_note.public?
+
+    get "/api/v1/requests/#{first.id}/comments", headers: customer_headers
+    assert_response :success
+    assert_includes response.parsed_body.fetch("comments").pluck("body"), first_note.body
+
+    get "/api/v1/requests/#{second.id}/comments", headers: customer_headers
+    assert_response :success
+    second_customer_comments = response.parsed_body.fetch("comments").pluck("body")
+    refute_includes second_customer_comments, second_private_note.body
+    refute_includes second_customer_comments, second_close_note.body
+
+    get "/api/v1/requests/#{final.id}/comments", headers: customer_headers
+    assert_response :success
+    assert_includes response.parsed_body.fetch("comments").pluck("body"), final_note.body
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "merge rejects invalid or closed tickets and closed tickets reject edits" do
+    source = create_ticket(@customer, subject: "Source")
+    other_customer_ticket = create_ticket(@other_customer, subject: "Other customer")
+
+    post "/api/v1/tickets/#{source.id}/merge",
+         params: { merge: { target_id: other_customer_ticket.id } },
+         headers: customer_headers,
+         as: :json
+    assert_response :forbidden
+
+    post "/api/v1/tickets/#{source.id}/merge",
+         params: { merge: { target_id: other_customer_ticket.id } },
+         headers: staff_headers,
+         as: :json
+    assert_response :unprocessable_entity
+    assert source.reload.open?
+    assert_nil source.merged_into_id
+
+    post "/api/v1/tickets/#{source.id}/merge",
+         params: { merge: { target_id: source.id } },
+         headers: staff_headers,
+         as: :json
+    assert_response :unprocessable_entity
+
+    closed_target = create_ticket(@customer, subject: "Already closed")
+    closed_target.update!(status: :closed)
+    post "/api/v1/tickets/#{source.id}/merge",
+         params: { merge: { target_id: closed_target.id } },
+         headers: staff_headers,
+         as: :json
+    assert_response :unprocessable_entity
+
+    target = create_ticket(@customer, subject: "Target")
+    post "/api/v1/tickets/#{source.id}/merge",
+         params: { merge: { target_id: target.id } },
+         headers: staff_headers,
+         as: :json
+    assert_response :success
+    comment_count = source.comments.count
+
+    patch "/api/v1/tickets/#{source.id}",
+          params: { ticket: { status: "open", comment: { body: "Should not be added" } } },
+          headers: staff_headers,
+          as: :json
+    assert_response :unprocessable_entity
+    assert source.reload.closed?
+    assert_equal comment_count, source.comments.count
+
+    patch "/api/v1/requests/#{source.id}",
+          params: { request: { status: "solved", comment: { body: "Also rejected" } } },
+          headers: customer_headers,
+          as: :json
+    assert_response :unprocessable_entity
+    assert source.reload.closed?
+    assert_equal comment_count, source.comments.count
+
+    post "/api/v1/tickets/#{source.id}/merge",
+         params: { merge: { target_id: target.id } },
+         headers: staff_headers,
+         as: :json
+    assert_response :unprocessable_entity
+  end
+
+  test "assignment cleanup still applies after a ticket is closed by merging" do
+    source = create_ticket(@customer, subject: "Assigned duplicate", assignee: @agent)
+    target = create_ticket(@customer, subject: "Assigned target")
+
+    post "/api/v1/tickets/#{source.id}/merge",
+         params: { merge: { target_id: target.id } },
+         headers: staff_headers,
+         as: :json
+    assert_response :success
+    assert_equal @agent.id, source.reload.assignee_id
+
+    patch "/api/v1/users/#{@agent.id}",
+          params: { user: { suspended: true } },
+          headers: staff_headers,
+          as: :json
+    assert_response :success
+    assert_nil source.reload.assignee_id
+    assert source.closed?
+  end
+
+  private
+
+  def create_user(name, email, role)
+    @account.users.create!(
+      name: name,
+      email: email,
+      password: "valid-password",
+      role: role,
+      verified_at: Time.current
+    )
+  end
+
+  def create_ticket(customer, **attributes)
+    ticket = @account.tickets.create!({
+      requester: customer,
+      subject: "Ticket"
+    }.merge(attributes))
+    ticket.comments.create!(author: customer, body: "Initial comment")
+    ticket
+  end
+
+  def issue_session(user)
+    _session, token = Session.issue!(user)
+    token
+  end
+
+  def staff_headers
+    {
+      "X-Helpdesk-Account" => @account.subdomain,
+      "Authorization" => "Bearer #{@owner_token}"
+    }
+  end
+
+  def customer_headers
+    {
+      "X-Helpdesk-Account" => @account.subdomain,
+      "Authorization" => "Bearer #{@customer_token}"
+    }
+  end
+end
