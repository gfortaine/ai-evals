+++ b/app/models/password_reset.rb
@@ -0,0 +1,56 @@
+class PasswordReset < ApplicationRecord
+  TOKEN_EXPIRATION = 2.hours
+
+  belongs_to :account
+  belongs_to :user
+
+  validates :token_digest, presence: true, uniqueness: true
+  validates :expires_at, presence: true
+  validate :user_belongs_to_account
+
+  def self.issue!(user)
+    raw_token = TokenDigest.generate
+
+    user.with_lock do
+      where(user: user).delete_all
+      create!(
+        account: user.account,
+        user: user,
+        token_digest: TokenDigest.digest(raw_token),
+        expires_at: Time.current + TOKEN_EXPIRATION
+      )
+    end
+
+    raw_token
+  end
+
+  def self.lookup(account:, token:)
+    find_by(account: account, token_digest: TokenDigest.digest(token))
+  end
+
+  def self.consume!(account:, token:, password:, &allowed)
+    transaction do
+      record = lock.find_by(account: account, token_digest: TokenDigest.digest(token))
+      return unless record
+
+      if record.expires_at <= Time.current
+        record.destroy!
+        return
+      end
+
+      user = record.user.lock!
+      return if allowed && !allowed.call(user)
+
+      user.update!(password: password)
+      user.sessions.delete_all
+      record.destroy!
+      user
+    end
+  end
+
+  private
+
+  def user_belongs_to_account
+    errors.add(:user, "must belong to the account") if user && account_id != user.account_id
+  end
+end
diff --git a/app/models/session.rb b/app/models/session.rb
new file mode 100644
index 0000000..50fb3dd
--- /dev/null
+++ b/app/models/session.rb
@@ -0,0 +1,30 @@
+class Session < ApplicationRecord
+  DEFAULT_EXPIRATION = 30.days
+
+  belongs_to :user
+
+  validates :token_digest, presence: true, uniqueness: true
+  validates :expires_at, presence: true
+
+  scope :unexpired, -> { where("expires_at > ?", Time.current) }
+
+  def self.issue!(user)
+    if user.suspended?
+      user.errors.add(:base, "is suspended")
+      raise ActiveRecord::RecordInvalid, user
+    end
+
+    raw_token = TokenDigest.generate
+    session = create!(
+      user: user,
+      token_digest: TokenDigest.digest(raw_token),
+      expires_at: Time.current + DEFAULT_EXPIRATION
+    )
+
+    [ session, raw_token ]
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+end
diff --git a/app/models/ticket.rb b/app/models/ticket.rb
new file mode 100644
index 0000000..6afe9c8
--- /dev/null
+++ b/app/models/ticket.rb
@@ -0,0 +1,112 @@
+require "securerandom"
+
+class Ticket < ApplicationRecord
+  ORIGINS = %w[portal email].freeze
+  STATUSES = %w[open pending solved closed].freeze
+  PRIORITIES = %w[normal high].freeze
+
+  belongs_to :account, inverse_of: :tickets
+  belongs_to :requester, class_name: "User", inverse_of: :requested_tickets
+  belongs_to :group, inverse_of: :tickets, optional: true
+  belongs_to :assignee,
+             class_name: "User",
+             inverse_of: :assigned_tickets,
+             optional: true
+  belongs_to :merged_into,
+             class_name: "Ticket",
+             inverse_of: :merged_tickets,
+             optional: true
+
+  has_many :comments, inverse_of: :ticket, dependent: :destroy
+  has_many :merged_tickets,
+           class_name: "Ticket",
+           foreign_key: :merged_into_id,
+           inverse_of: :merged_into,
+           dependent: :nullify
+
+  enum :status, STATUSES.index_by(&:itself), validate: true
+  enum :priority, PRIORITIES.index_by(&:itself), validate: true
+
+  before_validation :normalize_subject
+  before_validation :ensure_email_reply_token, on: :create
+  before_validation :reconcile_group_assignment
+
+  validates :subject, presence: true, length: { maximum: 255 }
+  validates :origin, inclusion: { in: ORIGINS }
+  validates :email_reply_token, presence: true, uniqueness: true, length: { is: 32 }
+  validate :requester_belongs_to_account
+  validate :assignee_is_active_staff
+  validate :group_belongs_to_account
+  validate :assignee_belongs_to_ticket_group
+  validate :merged_into_belongs_to_same_customer
+
+  def email_origin?
+    origin == "email"
+  end
+
+  def reply_address
+    SupportEmailAddresses.reply_address(self)
+  end
+
+  private
+
+  def normalize_subject
+    self.subject = subject.to_s.strip
+  end
+
+  def ensure_email_reply_token
+    self.email_reply_token ||= SecureRandom.hex(16)
+  end
+
+  def reconcile_group_assignment
+    if persisted? && will_save_change_to_group_id? && group_id.nil?
+      self.assignee = nil
+      return
+    end
+
+    return unless assignee
+
+    if group.nil?
+      if new_record? || will_save_change_to_assignee_id?
+        self.group = assignee.default_group
+      end
+    elsif will_save_change_to_group_id? && !will_save_change_to_assignee_id?
+      self.assignee = nil unless assignee.group_memberships.exists?(group_id: group_id)
+    end
+  end
+
+  def requester_belongs_to_account
+    return unless requester
+
+    errors.add(:requester, "must belong to the account") unless requester.account_id == account_id
+    errors.add(:requester, "must be a customer") unless requester.customer?
+  end
+
+  def assignee_is_active_staff
+    return unless assignee
+
+    errors.add(:assignee, "must belong to the account") unless assignee.account_id == account_id
+    errors.add(:assignee, "must be active staff") unless assignee.staff? && assignee.active?
+  end
+
+  def group_belongs_to_account
+    errors.add(:group, "must belong to the account") if group && group.account_id != account_id
+  end
+
+  def assignee_belongs_to_ticket_group
+    return unless assignee && group
+    return if assignee.group_memberships.exists?(group_id: group_id)
+
+    errors.add(:assignee, "must belong to the ticket's group")
+  end
+
+  def merged_into_belongs_to_same_customer
+    return unless merged_into
+
+    unless merged_into.id != id &&
+           merged_into.account_id == account_id &&
+           merged_into.requester_id == requester_id
+      errors.add(:merged_into, "must be another ticket for the same customer")
+    end
+  end
+end
diff --git a/app/models/token_digest.rb b/app/models/token_digest.rb
new file mode 100644
index 0000000..8398f5b
--- /dev/null
+++ b/app/models/token_digest.rb
@@ -0,0 +1,14 @@
+require "digest"
+require "securerandom"
+
+module TokenDigest
+  module_function
+
+  def generate
+    SecureRandom.urlsafe_base64(32)
+  end
+
+  def digest(token)
+    Digest::SHA256.hexdigest(token.to_s)
+  end
+end
