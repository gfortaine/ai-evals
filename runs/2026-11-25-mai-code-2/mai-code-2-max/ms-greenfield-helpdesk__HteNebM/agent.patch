+class User < ApplicationRecord
+  ROLES = %w[admin agent customer].freeze
+
+  belongs_to :account, inverse_of: :users
+
+  has_many :sessions, dependent: :destroy
+  has_many :email_verifications, dependent: :destroy
+  has_many :password_resets, dependent: :destroy
+  has_many :group_memberships, inverse_of: :user, dependent: :destroy
+  has_many :groups, through: :group_memberships
+  has_many :requested_tickets,
+           class_name: "Ticket",
+           foreign_key: :requester_id,
+           inverse_of: :requester,
+           dependent: :destroy
+  has_many :assigned_tickets,
+           class_name: "Ticket",
+           foreign_key: :assignee_id,
+           inverse_of: :assignee,
+           dependent: :nullify
+  has_many :sent_invitations,
+           class_name: "Invitation",
+           foreign_key: :invited_by_id,
+           inverse_of: :invited_by,
+           dependent: :nullify
+  has_many :accepted_invitations,
+           class_name: "Invitation",
+           foreign_key: :accepted_user_id,
+           inverse_of: :accepted_user,
+           dependent: :nullify
+  has_many :comments, foreign_key: :author_id, inverse_of: :author, dependent: :destroy
+
+  has_secure_password
+
+  enum :role, ROLES.index_by(&:itself), validate: true
+
+  before_validation :normalize_name
+  before_validation :normalize_email
+
+  validates :name, presence: true, length: { maximum: 255 }
+  validates :email,
+            presence: true,
+            length: { maximum: 255 },
+            uniqueness: { scope: :account_id, case_sensitive: false },
+            format: { with: /\A[^@\s]+@[^@\s]+\z/ }
+  validates :password, length: { minimum: 8 }, allow_nil: true
+  validates :suspended, inclusion: { in: [true, false] }
+
+  scope :active_staff, -> { where(role: %w[admin agent], suspended: false) }
+
+  def verified
+    verified_at.present?
+  end
+
+  alias_method :verified?, :verified
+
+  def verified=(value)
+    self.verified_at = ActiveModel::Type::Boolean.new.cast(value) ? (verified_at || Time.current) : nil
+  end
+
+  def owner?
+    account.owner_id == id
+  end
+
+  def staff?
+    admin? || agent?
+  end
+
+  def active?
+    !suspended?
+  end
+
+  def default_group
+    group_memberships.includes(:group).find_by(default: true)&.group
+  end
+
+  private
+
+  def normalize_name
+    self.name = name.to_s.strip
+  end
+
+  def normalize_email
+    self.email = email.to_s.strip.downcase
+  end
+end
