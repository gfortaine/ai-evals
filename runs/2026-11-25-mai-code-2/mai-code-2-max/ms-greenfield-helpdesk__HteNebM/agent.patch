diff --git a/app/controllers/api/v1/password_resets_controller.rb b/app/controllers/api/v1/password_resets_controller.rb
new file mode 100644
index 0000000..91f27ea
--- /dev/null
+++ b/app/controllers/api/v1/password_resets_controller.rb
@@ -0,0 +1,51 @@
+module Api
+  module V1
+    class PasswordResetsController < BaseController
+      before_action :set_current_account
+
+      def create
+        email = params.require(:password_reset).require(:email).to_s.strip.downcase
+        user = current_account.users.find_by(email: email)
+
+        if user && recovery_allowed_for?(user)
+          token = PasswordReset.issue!(user)
+          HelpdeskMailer.password_reset(user, token).deliver_now
+        end
+
+        render json: { message: "If the account matches, a password reset link has been sent" }, status: :accepted
+      end
+
+      def confirm
+        attributes = params.require(:password_reset)
+        token = attributes.require(:token).to_s
+        password = attributes.require(:password).to_s
+
+        user = nil
+        current_account.with_lock do
+          user = PasswordReset.consume!(
+            account: current_account,
+            token: token,
+            password: password,
+            &method(:recovery_allowed_for?)
+          )
+        end
+
+        unless user
+          raise ApiRequestError.new(
+            "Password reset link is invalid or expired",
+            status: :unprocessable_entity,
+            code: "invalid_reset_token"
+          )
+        end
+
+        render json: { user: user_json(user) }
+      end
+
+      private
+
+      def recovery_allowed_for?(user)
+        current_account.active? || (user.owner? && !current_account.reactivation_expired?)
+      end
+    end
+  end
+end
