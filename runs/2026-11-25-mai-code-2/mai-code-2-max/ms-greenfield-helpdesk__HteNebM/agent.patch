@@ -0,0 +1,78 @@
+module Api
+  module V1
+    class InvitationsController < BaseController
+      before_action :set_current_account
+      before_action :require_active_account
+      before_action :authenticate_user!
+      before_action :require_admin!
+      before_action :set_invitation, only: %i[show resend destroy]
+
+      def index
+        Invitation.expire_stale!(account: current_account)
+        scope = current_account.invitations
+          .includes(:invited_by, :accepted_user)
+        scope = scope.for_status(invitation_status_filter) if params.key?(:status)
+        records, pagination = paginate(scope, order: { id: :asc })
+
+        render json: {
+          invitations: records.map { |invitation| invitation_json(invitation) },
+          **pagination
+        }
+      end
+
+      def show
+        render json: { invitation: invitation_json(@invitation) }
+      end
+
+      def create
+        attributes = params.require(:invitation)
+        invitation, token = Invitation.issue!(
+          account: current_account,
+          invited_by: current_user,
+          email: attributes.require(:email).to_s,
+          role: attributes.require(:role).to_s
+        )
+        HelpdeskMailer.invitation(invitation, token).deliver_now
+
+        render json: { invitation: invitation_json(invitation) }, status: :created
+      end
+
+      def resend
+        token = @invitation.resend!
+        HelpdeskMailer.invitation(@invitation, token).deliver_now
+
+        render json: { invitation: invitation_json(@invitation.reload) }
+      end
+
+      def destroy
+        @invitation.revoke!
+
+        render json: { invitation: invitation_json(@invitation.reload) }
+      end
+
+      private
+
+      def set_invitation
+        @invitation = current_account.invitations
+          .includes(:invited_by, :accepted_user)
+          .find(params[:id])
+        @invitation.with_lock { @invitation.expire_if_needed! }
+      end
+
+      def invitation_status_filter
+        status = params[:status].to_s.strip.downcase
+        return status if Invitation::STATUSES.include?(status)
+
+        raise ApiRequestError.new(
+          "status must be one of: #{Invitation::STATUSES.join(', ')}",
+          status: :bad_request,
+          code: "invalid_filter"
+        )
+      end
+
+      def invitation_json(invitation)
+        InvitationSerializer.new(invitation).as_json
+      end
+    end
+  end
+end
