+        as: :json
+    assert_response :success
+    assert_equal [agent.id], response.parsed_body.fetch("users").pluck("id")
+
+    get "/api/v1/staff", headers: authenticated_headers(agent_token), as: :json
+    assert_response :success
+    assert_equal [@owner.id, second_admin.id, agent.id].sort, response.parsed_body.fetch("staff").pluck("id")
+
+    patch "/api/v1/users/#{agent.id}",
+          params: { user: { suspended: true } },
+          headers: authenticated_headers(@owner_token),
+          as: :json
+    assert_response :success
+    assert_equal true, response.parsed_body.dig("user", "suspended")
+    assert_equal 0, agent.sessions.count
+    assert_nil ticket.reload.assignee_id
+
+    get "/api/v1/tickets", headers: authenticated_headers(agent_token), as: :json
+    assert_response :unauthorized
+
+    patch "/api/v1/users/#{@owner.id}",
+          params: { user: { suspended: true } },
+          headers: authenticated_headers(second_admin_token),
+          as: :json
+    assert_response :success
+
+    patch "/api/v1/users/#{second_admin.id}",
+          params: { user: { suspended: true } },
+          headers: authenticated_headers(second_admin_token),
+          as: :json
+    assert_response :unprocessable_entity
+  end
+
+  test "agents assign tickets and private notes stay out of customer activity" do
+    agent = create_user("Agent", "ticket-agent@acme.test", :agent)
+    customer = create_user("Customer", "ticket-customer@acme.test", :customer)
+    agent_token = issue_session(agent)
+    customer_token = issue_session(customer)
+    ticket = @account.tickets.create!(requester: customer, subject: "Invoice")
+    ticket.comments.create!(author: customer, body: "Please help")
+    get "/api/v1/requests/#{ticket.id}", headers: authenticated_headers(customer_token), as: :json
+    assert_response :success
+    customer_request_before = response.parsed_body.fetch("request")
+    previous_updated_at = ticket.reload.updated_at
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { assignee_id: agent.id } },
+          headers: authenticated_headers(agent_token),
+          as: :json
+    assert_response :success
+    assert_equal agent.id, response.parsed_body.dig("ticket", "assignee_id")
+    assert_equal({ "id" => agent.id, "name" => agent.name }, response.parsed_body.dig("ticket", "assignee"))
+    assert_equal previous_updated_at, ticket.reload.updated_at
+    previous_updated_at = ticket.updated_at
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: {
+            ticket: {
+              comment: { body: "Checking this with billing.", public: false }
+            }
+          },
+          headers: authenticated_headers(agent_token),
+          as: :json
+    assert_response :success
+    assert_equal previous_updated_at, ticket.reload.updated_at
+    assert_equal "open", ticket.status
+
+    get "/api/v1/requests/#{ticket.id}", headers: authenticated_headers(customer_token), as: :json
+    assert_response :success
+    assert_equal customer_request_before, response.parsed_body.fetch("request")
+
+    get "/api/v1/tickets/#{ticket.id}/comments",
+        headers: authenticated_headers(agent_token),
+        as: :json
+    assert_response :success
+    assert_includes response.parsed_body.fetch("comments").map { |comment| comment.fetch("body") },
+                    "Checking this with billing."
+
+    get "/api/v1/requests/#{ticket.id}/comments",
+        headers: authenticated_headers(customer_token),
+        as: :json
+    assert_response :success
