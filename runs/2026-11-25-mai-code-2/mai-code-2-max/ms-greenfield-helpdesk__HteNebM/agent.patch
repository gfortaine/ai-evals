@@ -0,0 +1,18 @@
+class SupportMailbox < ApplicationMailbox
+  def process
+    outcome = InboundSupportEmail.new(inbound_email).process
+    discard_ignored_delivery unless accepted_outcome?(outcome)
+  end
+
+  private
+
+  def accepted_outcome?(outcome)
+    [InboundSupportEmail::ACCEPTED, InboundSupportEmail::DUPLICATE].include?(outcome)
+  end
+
+  def discard_ignored_delivery
+    # Action Mailbox checks the in-memory status after processing the destroyed record.
+    inbound_email.status = :bounced
+    inbound_email.destroy!
+  end
+end
