diff --git a/app/services/frontend_links.rb b/app/services/frontend_links.rb
new file mode 100644
index 0000000..e0ac06b
--- /dev/null
+++ b/app/services/frontend_links.rb
@@ -0,0 +1,27 @@
+require "uri"
+
+module FrontendLinks
+  module_function
+
+  def email_verification(account:, token:)
+    build("verify-email", account: account, token: token)
+  end
+
+  def invitation(account:, token:)
+    build("accept-invitation", account: account, token: token)
+  end
+
+  def password_reset(account:, token:)
+    build("reset-password", account: account, token: token)
+  end
+
+  def build(path, account:, token:)
+    uri = URI.parse(ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001"))
+    base_path = uri.path.to_s.sub(%r{/\z}, "")
+    uri.path = "#{base_path}/#{path}"
+    uri.query = URI.encode_www_form(account: account.subdomain, token: token)
+    uri.fragment = nil
+    uri.to_s
+  end
+  private_class_method :build
+end
diff --git a/app/services/inbound_support_email.rb b/app/services/inbound_support_email.rb
new file mode 100644
index 0000000..9f4c4a4
--- /dev/null
+++ b/app/services/inbound_support_email.rb
@@ -0,0 +1,238 @@
+class InboundSupportEmail
+  LIST_HEADERS = %w[
+    List-Id
+    List-Unsubscribe
+    List-Subscribe
+    List-Post
+    List-Help
+    List-Archive
+    Mailing-List
+  ].freeze
+  AUTOMATED_PRECEDENCE = %w[bulk junk list].freeze
+  NO_REPLY_LOCAL_PATTERN = /\A(?:mailer-daemon|postmaster|no-?reply|do-?not-?reply)\z/i.freeze
+  ACCEPTED = :accepted
+  DUPLICATE = :duplicate
+  IGNORED = :ignored
+  Target = Struct.new(:account, :ticket, keyword_init: true)
+
+  def initialize(inbound_email)
+    @inbound_email = inbound_email
+  end
+
+  def process
+    return IGNORED if automated_mail?
+
+    sender = sender_email
+    body = plain_text_body
+    message_id = canonical_message_id
+    return IGNORED unless sender && body.present? && valid_message_id?(message_id)
+
+    target = resolve_target
+    return IGNORED unless target
+
+    if target.ticket
+      append_reply(target.ticket, sender, body, message_id)
+    else
+      open_ticket(target.account, sender, mail.subject.to_s.strip, body, message_id)
+    end
+  rescue Mail::Field::ParseError
+    IGNORED
+  rescue ActiveRecord::RecordNotUnique
+    return DUPLICATE if message_id.present? && Comment.where(email_message_id: message_id).exists?
+
+    raise
+  end
+
+  private
+
+  attr_reader :inbound_email
+
+  def mail
+    @mail ||= inbound_email.mail
+  end
+
+  def automated_mail?
+    auto_submitted = header_value("Auto-Submitted")
+    return true if auto_submitted.present? && !auto_submitted.casecmp?("no")
+
+    precedence = header_value("Precedence").downcase
+    return true if AUTOMATED_PRECEDENCE.include?(precedence.split(/[;,\s]/).first.to_s)
+    return true if LIST_HEADERS.any? { |name| header_value(name).present? }
+    return true if header_value("X-Auto-Response-Suppress").present?
+    return true if %w[yes true auto].include?(header_value("X-Autoreply").downcase)
+    return true if %w[yes true auto].include?(header_value("X-Autorespond").downcase)
+
+    NO_REPLY_LOCAL_PATTERN.match?(sender_email.to_s.split("@", 2).first)
+  end
+
+  def header_value(name)
+    mail.header[name].to_s.strip
+  end
+
+  def sender_email
+    @sender_email ||= begin
+      senders = Array(mail.from).map { |address| SupportEmailAddresses.parse(address)&.[](:email) }.compact.uniq
+      email = senders.first if senders.one?
+      email if valid_email?(email)
+    end
+  end
+
+  def valid_email?(email)
+    email.present? && email.bytesize <= 255 && email.match?(/\A[^@\s]+@[^@\s]+\z/)
+  end
+
+  def canonical_message_id
+    value = inbound_email.message_id.to_s.strip
+    value = mail.message_id.to_s.strip if value.blank?
+    value.delete_prefix("<").delete_suffix(">").strip
+  end
+
+  def valid_message_id?(message_id)
+    message_id.present? && message_id.bytesize <= 255
+  end
+
+  def plain_text_body
+    part = if mail.multipart?
+      mail.all_parts.find do |candidate|
+        candidate.mime_type.to_s.casecmp?("text/plain") && !candidate.attachment?
+      end
+    elsif mail.mime_type.blank? || mail.mime_type.to_s.casecmp?("text/plain")
+      mail
+    end
+
+    decode_part(part) if part
+  end
+
+  def decode_part(part)
+    text = part.decoded.to_s.dup
+    encoding = Encoding.find(part.charset.presence || "UTF-8")
+    text.force_encoding(encoding).encode(
+      Encoding::UTF_8,
+      invalid: :replace,
+      undef: :replace,
+      replace: ""
+    ).gsub(/\r\n?/, "\n").strip
+  rescue ArgumentError, EncodingError
+    nil
+  end
+
+  def resolve_target
+    recipients = support_recipients
+    return if recipients.empty?
+
+    tokens = recipients.filter_map { |address| SupportEmailAddresses.reply_token(address) }.uniq
+    subdomains = recipients.filter_map do |address|
+      SupportEmailAddresses.account_subdomain(address)
+    end.uniq
+
+    tickets = Ticket.includes(:account, :requester).where(email_reply_token: tokens).index_by(&:email_reply_token)
+    accounts = Account.where(subdomain: subdomains).index_by(&:subdomain)
+
+    return unless tokens.all? { |token| tickets.key?(token) }
+    return unless subdomains.all? { |subdomain| accounts.key?(subdomain) }
+
+    account_ids = tickets.values.map(&:account_id) + accounts.values.map(&:id)
+    return unless account_ids.uniq.one?
+
+    if tickets.any?
+      return unless tickets.one?
+
+      ticket = tickets.values.first
+      Target.new(account: ticket.account, ticket: ticket)
+    else
+      account = accounts.values.first
+      Target.new(account: account) if account
+    end
+  end
+
+  def support_recipients
+    mail.recipients_addresses.filter_map do |address|
+      parsed = SupportEmailAddresses.parse(address.address)
+      parsed[:email] if parsed && parsed[:domain] == SupportEmailAddresses.domain
+    end.uniq
+  rescue Mail::Field::ParseError
+    []
+  end
+
+  def open_ticket(account, sender, subject, body, message_id)
+    return IGNORED unless subject.present? && subject.bytesize <= 255
+
+    creation = account.with_lock do
+      next DUPLICATE if Comment.exists?(email_message_id: message_id)
+
+      customer = find_customer(account, sender)
+      next IGNORED if customer == :invalid
+
+      verification_token = nil
+      if customer.nil?
+        customer = account.users.create!(
+          name: sender_name(sender),
+          email: sender,
+          password: SecureRandom.urlsafe_base64(32),
+          role: :customer
+        )
+        verification_token = EmailVerification.issue!(customer)
+      end
+
+      ticket = account.tickets.create!(
+        requester: customer,
+        subject: subject,
+        status: :open,
+        origin: "email"
+      )
+      ticket.comments.create!(
+        author: customer,
+        body: body,
+        public: true,
+        email_message_id: message_id
+      )
+
+      { customer: customer, verification_token: verification_token }
+    end
+
+    return creation if creation.in?([DUPLICATE, IGNORED])
+
+    if creation&.fetch(:verification_token)
+      HelpdeskMailer.email_verification(
+        creation.fetch(:customer),
+        creation.fetch(:verification_token)
+      ).deliver_now
+    end
+
+    ACCEPTED
+  end
+
+  def append_reply(ticket, sender, body, message_id)
+    ticket.account.with_lock do
+      next DUPLICATE if Comment.exists?(email_message_id: message_id)
+      next IGNORED unless sender == ticket.requester.email.to_s.downcase
+
+      ticket.lock!
+      next IGNORED if ticket.closed?
+
+      ticket.status = :open if ticket.pending? || ticket.solved?
+      ticket.save! if ticket.has_changes_to_save?
+      ticket.comments.create!(
+        author: ticket.requester,
+        body: body,
+        public: true,
+        email_message_id: message_id
+      )
+
+      ACCEPTED
+    end
+  end
+
+  def find_customer(account, sender)
+    user = account.users.where("LOWER(email) = ?", sender).first
+    return :invalid if user && !user.customer?
+
+    user
+  end
+
+  def sender_name(sender)
+    name = mail.from_address&.display_name.to_s.strip
+    name = sender.split("@", 2).first if name.blank?
+    name.truncate(255)
+  end
+end
diff --git a/app/services/support_email_addresses.rb b/app/services/support_email_addresses.rb
new file mode 100644
index 0000000..4b94a90
--- /dev/null
+++ b/app/services/support_email_addresses.rb
@@ -0,0 +1,53 @@
+module SupportEmailAddresses
+  DEFAULT_DOMAIN = "support.example.test".freeze
+  REPLY_PREFIX = "reply+".freeze
+  REPLY_LOCAL_PATTERN = /\Areply\+([0-9a-f]{32})\z/.freeze
+
+  module_function
+
+  def domain
+    ENV.fetch("HELPDESK_SUPPORT_DOMAIN", DEFAULT_DOMAIN)
+      .to_s
+      .strip
+      .delete_prefix("@")
+      .delete_suffix(".")
+      .downcase
+      .presence || DEFAULT_DOMAIN
+  end
+
+  def account_address(account)
+    "#{account.subdomain}@#{domain}"
+  end
+
+  def reply_address(ticket)
+    "#{REPLY_PREFIX}#{ticket.email_reply_token}@#{domain}"
+  end
+
+  def parse(address)
+    email = address.to_s.strip.downcase
+    local, separator, recipient_domain = email.rpartition("@")
+    return unless separator == "@" && local.present? && recipient_domain.present?
+
+    { email: email, local: local, domain: recipient_domain }
+  end
+
+  def for_support_domain?(address)
+    parsed = parse(address)
+    parsed && parsed[:domain] == domain
+  end
+
+  def reply_token(address)
+    parsed = parse(address)
+    return unless parsed && parsed[:domain] == domain
+
+    REPLY_LOCAL_PATTERN.match(parsed[:local])&.[](1)
+  end
+
+  def account_subdomain(address)
+    parsed = parse(address)
+    return unless parsed && parsed[:domain] == domain
+    return if REPLY_LOCAL_PATTERN.match?(parsed[:local]) || parsed[:local].start_with?(REPLY_PREFIX)
+
+    parsed[:local]
+  end
+end
