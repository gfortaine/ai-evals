diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..327090d
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,48 @@
+module Api
+  module V1
+    class AccountsController < BaseController
+      before_action :set_current_account, only: %i[show cancel reactivate]
+      before_action :require_active_account, only: %i[show cancel]
+      before_action :authenticate_user!, only: %i[show cancel reactivate]
+      before_action :require_owner!, only: %i[cancel reactivate]
+      before_action :require_reactivatable_account, only: :reactivate
+
+      def create
+        attributes = params.require(:account)
+        account_attributes = attributes.permit(:name, :subdomain)
+        admin_attributes = attributes.require(:admin).permit(:name, :email, :password)
+
+        account = nil
+        user = nil
+        verification_token = nil
+
+        Account.transaction do
+          account = Account.new(account_attributes)
+          account.save!
+
+          user = account.users.create!(admin_attributes.merge(role: :admin))
+          account.update!(owner: user)
+          verification_token = EmailVerification.issue!(user)
+        end
+
+        HelpdeskMailer.email_verification(user, verification_token).deliver_now
+
+        render json: { account: account_json(account), user: user_json(user) }, status: :created
+      end
+
+      def show
+        render json: { account: account_json }
+      end
+
+      def cancel
+        current_account.cancel!
+        render json: { account: account_json }
+      end
+
+      def reactivate
+        current_account.reactivate!
+        render json: { account: account_json }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..593c70f
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,418 @@
+module Api
+  module V1
+    class BaseController < ApplicationController
+      DEFAULT_PAGINATION_SIZE = 25
+
+      private
+
+      attr_reader :current_account, :current_session, :current_user, :current_invitation, :invitation_token
+
+      def set_current_account
+        subdomain = request.headers["X-Helpdesk-Account"].to_s.strip.downcase
+        if subdomain.blank?
+          raise ApiRequestError.new(
+            "X-Helpdesk-Account header is required",
+            status: :bad_request,
+            code: "account_required"
+          )
+        end
+
+        @current_account = Account.find_by(subdomain: subdomain)
+        return if current_account
+
+        raise ApiRequestError.new("Account not found", status: :not_found, code: "account_not_found")
+      end
+
+      def require_active_account
+        return if current_account.active?
+
+        raise ApiRequestError.new(
+          "The account is cancelled",
+          status: :forbidden,
+          code: "account_cancelled"
+        )
+      end
+
+      def authenticate_user!
+        token = bearer_token
+        unless token
+          raise ApiRequestError.new("Authentication required", status: :unauthorized, code: "unauthorized")
+        end
+
+        @current_session = Session.unexpired.includes(user: :account).find_by(token_digest: TokenDigest.digest(token))
+        unless current_session &&
+               current_session.user.account_id == current_account.id &&
+               current_session.user.active?
+          raise ApiRequestError.new("Invalid session", status: :unauthorized, code: "unauthorized")
+        end
+
+        @current_user = current_session.user
+      end
+
+      def set_current_invitation_context(envelope)
+        attributes = params.require(envelope)
+        @invitation_token = attributes.require(:token).to_s
+        digest = TokenDigest.digest(invitation_token)
+        subdomain = request.headers["X-Helpdesk-Account"].to_s.strip.downcase
+        scope = Invitation.includes(:account)
+        scope = scope.joins(:account).where(accounts: { subdomain: subdomain }) if subdomain.present?
+        @current_invitation = scope.find_by(token_digest: digest)
+
+        unless current_invitation
+          invalid_invitation_token!
+        end
+
+        @current_account = current_invitation.account
+      end
+
+      def invalid_invitation_token!
+        raise ApiRequestError.new(
+          "Invitation link is invalid or expired",
+          status: :unprocessable_entity,
+          code: "invalid_invitation_token"
+        )
+      end
+
+      def require_admin!
+        return if current_user&.admin?
+
+        raise ApiRequestError.new("Admin access required", status: :forbidden, code: "admin_required")
+      end
+
+      def require_owner!
+        return if current_user&.owner?
+
+        raise ApiRequestError.new("Owner access required", status: :forbidden, code: "owner_required")
+      end
+
+      def require_customer!
+        return if current_user&.customer?
+
+        raise ApiRequestError.new(
+          "Customer access required",
+          status: :forbidden,
+          code: "customer_required"
+        )
+      end
+
+      def ensure_ticket_editable!(ticket)
+        return unless ticket.closed?
+
+        ticket.errors.add(:base, "Closed tickets cannot be edited")
+        raise ActiveRecord::RecordInvalid, ticket
+      end
+
+      def require_staff!
+        return if current_user&.staff?
+
+        raise ApiRequestError.new(
+          "Staff access required",
+          status: :forbidden,
+          code: "staff_required"
+        )
+      end
+
+      def require_reactivatable_account
+        if current_account.active?
+          raise ApiRequestError.new(
+            "The account is already active",
+            status: :unprocessable_entity,
+            code: "account_active"
+          )
+        end
+
+        return unless current_account.reactivation_expired?
+
+        raise ApiRequestError.new(
+          "The account can no longer be reactivated",
+          status: :gone,
+          code: "reactivation_expired"
+        )
+      end
+
+      def account_json(account = current_account)
+        AccountSerializer.new(account).as_json
+      end
+
+      def user_json(user = current_user)
+        UserSerializer.new(user).as_json
+      end
+
+      def paginate(scope, order: { id: :asc })
+        ordering = normalized_pagination_order(scope, order)
+        page_options = nested_page_options
+        direction = pagination_direction(page_options)
+
+        if cursor_pagination?(page_options, direction)
+          size = pagination_page_size(page_options)
+          cursor = direction == :before ? page_options[:before] : page_options[:after]
+          if page_options.key?(direction) && cursor.blank?
+            invalid_pagination!("page[#{direction}] must not be blank")
+          end
+          records, has_before, has_after = cursor_page(
+            scope,
+            ordering,
+            direction: direction,
+            cursor: cursor,
+            size: size
+          )
+
+          [records, navigation_payload(scope, ordering, records, size, direction, has_before, has_after)]
+        else
+          page = pagination_page_number(page_options)
+          size = pagination_page_size(page_options)
+          base_scope = scope.unscope(:order, :limit, :offset)
+          count = base_scope.count
+          records = base_scope
+            .reorder(ordering.to_h)
+            .offset((page - 1) * size)
+            .limit(size)
+            .to_a
+          has_before = page > 1 && count.positive?
+          has_after = page * size < count
+
+          [
+            records,
+            {
+              count: count,
+              page: page,
+              per_page: size,
+              next_page: has_after ? page + 1 : nil,
+              previous_page: page > 1 ? page - 1 : nil
+            }.merge(navigation_payload(scope, ordering, records, size, :after, has_before, has_after))
+          ]
+        end
+      end
+
+      def normalized_pagination_order(scope, order)
+        normalized = order.to_a.map { |column, direction| [column.to_s, direction.to_s.downcase.to_sym] }
+        valid = normalized.any? && normalized.all? do |column, direction|
+          %i[asc desc].include?(direction) && scope.klass.column_names.include?(column)
+        end
+        return normalized if valid
+
+        raise ArgumentError, "pagination order must reference model columns and use :asc or :desc"
+      end
+
+      def nested_page_options
+        value = params[:page]
+        value.is_a?(ActionController::Parameters) ? value : nil
+      end
+
+      def pagination_direction(page_options)
+        return :after unless page_options
+
+        has_after = page_options.key?(:after)
+        has_before = page_options.key?(:before)
+        if has_after && has_before
+          invalid_pagination!("page[after] and page[before] cannot be used together")
+        end
+        if (has_after || has_before) && page_options.key?(:number)
+          invalid_pagination!("page[number] cannot be used with a cursor")
+        end
+
+        has_before ? :before : :after
+      end
+
+      def cursor_pagination?(page_options, direction)
+        return false unless page_options
+
+        page_options.key?(direction) || (page_options.key?(:size) && !page_options.key?(:number))
+      end
+
+      def pagination_page_number(page_options)
+        if page_options
+          raw = page_options[:number]
+          return positive_integer(raw, "page[number]", 1)
+        end
+
+        positive_integer(params[:page], "page", 1)
+      end
+
+      def pagination_page_size(page_options)
+        if page_options&.key?(:size)
+          return positive_integer(page_options[:size], "page[size]", DEFAULT_PAGINATION_SIZE)
+        end
+
+        positive_integer(params[:per_page], "per_page", DEFAULT_PAGINATION_SIZE)
+      end
+
+      def positive_integer(raw, name, default)
+        return default if raw.nil?
+
+        value = Integer(raw.to_s, 10)
+        raise ArgumentError unless value.positive?
+
+        value
+      rescue ArgumentError
+        invalid_pagination!("#{name} must be a positive integer")
+      end
+
+      def cursor_page(scope, ordering, direction:, cursor:, size:)
+        base_scope = scope.unscope(:order, :limit, :offset)
+        position = cursor.nil? ? nil : decode_pagination_cursor(scope, ordering, cursor)
+        page_scope = if position
+          base_scope.where(pagination_position_predicate(scope, ordering, position, direction))
+        else
+          base_scope
+        end
+        query_order = if direction == :before
+          ordering.to_h.transform_values { |sort_direction| sort_direction == :asc ? :desc : :asc }
+        else
+          ordering.to_h
+        end
+        records = page_scope.reorder(query_order).limit(size + 1).to_a
+        has_more = records.length > size
+        records.pop if has_more
+        records.reverse! if direction == :before
+
+        return [records, false, false] if records.empty?
+
+        if direction == :before
+          has_after = pagination_position_exists?(
+            base_scope,
+            ordering,
+            :after,
+            pagination_record_position(records.last, ordering)
+          )
+          [records, has_more, has_after]
+        else
+          has_before = pagination_position_exists?(
+            base_scope,
+            ordering,
+            :before,
+            pagination_record_position(records.first, ordering)
+          )
+          [records, has_before, has_more]
+        end
+      end
+
+      def pagination_position_predicate(scope, ordering, values, direction)
+        table = scope.klass.arel_table
+        predicates = ordering.each_index.map do |index|
+          column, sort_direction = ordering[index]
+          operator = if (sort_direction == :asc) == (direction == :after)
+            :gt
+          else
+            :lt
+          end
+
+          terms = ordering.first(index).each_index.map do |prefix_index|
+            prefix_column = ordering[prefix_index].first
+            table[prefix_column].eq(values[prefix_index])
+          end
+          terms << table[column].public_send(operator, values[index])
+          terms.reduce { |predicate, term| predicate.and(term) }
+        end
+
+        predicates.reduce { |predicate, term| predicate.or(term) }
+      end
+
+      def pagination_position_exists?(scope, ordering, direction, position)
+        scope
+          .where(pagination_position_predicate(scope, ordering, position, direction))
+          .limit(1)
+          .exists?
+      end
+
+      def navigation_payload(scope, ordering, records, size, direction, has_before, has_after)
+        before_cursor = if records.present?
+          encode_pagination_cursor(
+            scope,
+            ordering,
+            pagination_record_position(records.first, ordering)
+          )
+        end
+        after_cursor = if records.present?
+          encode_pagination_cursor(
+            scope,
+            ordering,
+            pagination_record_position(records.last, ordering)
+          )
+        end
+
+        {
+          meta: {
+            has_more: direction == :before ? has_before : has_after,
+            after_cursor: after_cursor,
+            before_cursor: before_cursor
+          },
+          links: {
+            next: has_after && after_cursor ? pagination_link(:after, after_cursor, size) : nil,
+            prev: has_before && before_cursor ? pagination_link(:before, before_cursor, size) : nil
+          }
+        }
+      end
+
+      def pagination_record_position(record, ordering)
+        ordering.map { |column, _direction| pagination_serialized_value(record.public_send(column)) }
+      end
+
+      def pagination_serialized_value(value)
+        if value.is_a?(Time) || value.is_a?(DateTime) || value.is_a?(ActiveSupport::TimeWithZone)
+          value.iso8601(6)
+        else
+          value
+        end
+      end
+
+      def encode_pagination_cursor(scope, ordering, position)
+        pagination_cursor_verifier.generate(
+          {
+            "version" => 1,
+            "account_id" => current_account&.id,
+            "model" => scope.klass.name,
+            "order" => ordering.map { |column, direction| [column, direction.to_s] },
+            "position" => position
+          },
+          purpose: :api_cursor_pagination
+        )
+      end
+
+      def decode_pagination_cursor(scope, ordering, cursor)
+        payload = pagination_cursor_verifier.verified(cursor.to_s, purpose: :api_cursor_pagination)
+        valid = payload.is_a?(Hash) &&
+                payload["version"] == 1 &&
+                payload["account_id"] == current_account&.id &&
+                payload["model"] == scope.klass.name &&
+                payload["order"] == ordering.map { |column, direction| [column, direction.to_s] } &&
+                payload["position"].is_a?(Array) &&
+                payload["position"].length == ordering.length
+        invalid_pagination!("page cursor is invalid") unless valid
+
+        payload["position"].each_with_index.map do |value, index|
+          column = ordering[index].first
+          decoded = scope.klass.type_for_attribute(column).cast(value)
+          invalid_pagination!("page cursor is invalid") if decoded.nil?
+          decoded
+        end
+      rescue ActiveSupport::MessageVerifier::InvalidSignature, ArgumentError, TypeError
+        invalid_pagination!("page cursor is invalid")
+      end
+
+      def pagination_cursor_verifier
+        @pagination_cursor_verifier ||= Rails.application.message_verifier("api_cursor_pagination")
+      end
+
+      def pagination_link(direction, cursor, size)
+        query = request.query_parameters.deep_dup
+        query = query.to_unsafe_h if query.respond_to?(:to_unsafe_h)
+        query.delete("page")
+        query.delete("per_page")
+        query["page"] = { "size" => size, direction.to_s => cursor }
+
+        "#{request.base_url}#{request.path}?#{Rack::Utils.build_nested_query(query)}"
+      end
+
+      def invalid_pagination!(message)
+        raise ApiRequestError.new(message, status: :bad_request, code: "invalid_pagination")
+      end
+
+      def bearer_token
+        authorization = request.headers["Authorization"].to_s
+        match = authorization.match(/\ABearer\s+(.+)\z/i)
+        match && match[1].strip
+      end
+    end
+  end
+end
