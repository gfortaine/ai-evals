+      name: name,
+      email: email,
+      password: "valid-password",
+      role: role,
+      verified_at: Time.current
+    )
+  end
+
+  def issue_session(user)
+    _session, token = Session.issue!(user)
+    token
+  end
+
+  def post_invitation(email, role)
+    post "/api/v1/invitations",
+         params: { invitation: { email: email, role: role } },
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :created
+    response.parsed_body.fetch("invitation")
