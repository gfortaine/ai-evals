+end
diff --git a/config/initializers/cors.rb b/config/initializers/cors.rb
new file mode 100644
index 0000000..feffa7b
--- /dev/null
+++ b/config/initializers/cors.rb
@@ -0,0 +1,16 @@
+require "uri"
+
+frontend_url = ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001")
+frontend_uri = URI.parse(frontend_url)
+frontend_origin = "#{frontend_uri.scheme}://#{frontend_uri.host}"
+frontend_origin += ":#{frontend_uri.port}" unless frontend_uri.port == frontend_uri.default_port
+
+Rails.application.config.middleware.insert_before 0, Rack::Cors do
+  allow do
+    origins frontend_origin
+
+    resource "*",
+             headers: :any,
+             methods: %i[get post put patch delete options head]
+  end
+end
