+          as: :json
+    assert_response :success
+    assert_equal @agent.id, ticket.reload.assignee_id
+    assert_equal technical.id, ticket.group_id
+
+    delete "/api/v1/group_memberships/#{technical_membership.id}",
+           headers: authenticated_headers(@owner_token),
+           as: :json
+    assert_response :no_content
+    assert_nil ticket.reload.assignee_id
+    assert_equal technical.id, ticket.group_id
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { assignee_id: @agent.id } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :unprocessable_entity
+    assert_nil ticket.reload.assignee_id
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { group_id: nil } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+    assert_nil ticket.reload.group_id
+    assert_nil ticket.assignee_id
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { assignee_id: @agent.id } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+    assert_equal billing.id, ticket.reload.group_id
+    assert_equal @agent.id, ticket.assignee_id
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { assignee_id: nil } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+    assert_nil ticket.reload.assignee_id
+    assert_equal billing.id, ticket.group_id
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { assignee_id: @agent.id } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { group_id: nil } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+    assert_nil ticket.reload.group_id
+    assert_nil ticket.assignee_id
+
+    GroupMembership.create!(group: billing, user: @outsider)
+    moved_away = @account.tickets.create!(
+      requester: @customer,
+      subject: "Only billing",
+      group: billing,
+      assignee: @outsider
+    )
+    patch "/api/v1/tickets/#{moved_away.id}",
+          params: { ticket: { group_id: technical.id } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+    assert_equal technical.id, moved_away.reload.group_id
+    assert_nil moved_away.assignee_id
+
+    legacy_ungrouped = @account.tickets.create!(
+      requester: @customer,
+      subject: "Legacy ungrouped assignment",
+      assignee: @owner
+    )
+    patch "/api/v1/tickets/#{legacy_ungrouped.id}",
+          params: { ticket: { group_id: nil } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+    assert_nil legacy_ungrouped.reload.assignee_id
+
+    assigned_elsewhere = @account.tickets.create!(
+      requester: @customer,
+      subject: "Billing ticket",
+      group: billing,
+      assignee: @agent
+    )
+    ungrouped = @account.tickets.create!(requester: @customer, subject: "Ungrouped ticket")
+
+    get "/api/v1/tickets?group_id=#{billing.id}",
+        headers: authenticated_headers(@outsider_token),
+        as: :json
+    assert_response :success
+    assert_equal [assigned_elsewhere.id], response.parsed_body.fetch("tickets").pluck("id")
+
+    get "/api/v1/tickets?group_id=unassigned",
+        headers: authenticated_headers(@outsider_token),
+        as: :json
+    assert_response :success
+    assert_includes response.parsed_body.fetch("tickets").pluck("id"), ungrouped.id
+
+    delete "/api/v1/groups/#{billing.id}",
+           headers: authenticated_headers(@owner_token),
+           as: :json
+    assert_response :no_content
+    assert_nil assigned_elsewhere.reload.group_id
+    assert_nil assigned_elsewhere.assignee_id
+    refute GroupMembership.exists?(billing_membership.id)
+  end
+
+  private
+
+  def create_user(name, email, role)
+    @account.users.create!(
+      name: name,
+      email: email,
+      password: "valid-password",
+      role: role,
+      verified_at: Time.current
+    )
+  end
+
+  def issue_session(user)
+    _session, token = Session.issue!(user)
+    token
+  end
+
+  def authenticated_headers(token)
+    {
+      "X-Helpdesk-Account" => @account.subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+end
diff --git a/test/integration/helpdesk_api_test.rb b/test/integration/helpdesk_api_test.rb
new file mode 100644
index 0000000..5c7f774
--- /dev/null
+++ b/test/integration/helpdesk_api_test.rb
@@ -0,0 +1,206 @@
+require "test_helper"
+require "uri"
+
+class HelpdeskApiTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "signup verification authentication profile password recovery and account lifecycle" do
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: "Acme",
+             subdomain: "acme",
+             admin: {
+               name: "Jo",
+               email: "jo@acme.test",
+               password: "my-first-password"
+             }
+           }
+         },
+         as: :json
+
+    assert_response :created
+    signup = response.parsed_body
+    assert_equal "admin", signup.dig("user", "role")
+    assert_equal false, signup.dig("user", "verified")
+    assert signup.dig("account", "id").present?
+    assert signup.dig("account", "created_at").present?
+    assert signup.dig("user", "created_at").present?
+    assert_equal "support@example.test", ActionMailer::Base.deliveries.last.from.first
+
+    verification_token = token_from(ActionMailer::Base.deliveries.last)
+    verify(verification_token)
+    assert_response :success
+    assert_equal true, response.parsed_body.dig("user", "verified")
+
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+         headers: account_header,
+         as: :json
+
+    assert_response :success
+    token = response.parsed_body.dig("session", "token")
+    assert token.present?
+    assert_equal "acme", response.parsed_body.dig("account", "subdomain")
+
+    get "/api/v1/account", headers: authenticated_headers(token)
+    assert_response :success
+
+    patch "/api/v1/me",
+          params: { user: { name: "Jo Smith" } },
+          headers: authenticated_headers(token),
+          as: :json
+    assert_response :success
+    assert_equal "Jo Smith", response.parsed_body.dig("user", "name")
+
+    put "/api/v1/me/password",
+        params: {
+          password_change: {
+            current_password: "my-first-password",
+            password: "my-new-password"
+          }
+        },
+        headers: authenticated_headers(token),
+        as: :json
+    assert_response :success
+    assert_equal 0, Session.count
+
+    get "/api/v1/me", headers: authenticated_headers(token)
+    assert_response :unauthorized
+
+    login_token = login("my-new-password")
+
+    post "/api/v1/password_resets",
+         params: { password_reset: { email: "jo@acme.test" } },
+         headers: account_header,
+         as: :json
+    assert_response :accepted
+    reset_token = token_from(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/password_resets/confirm",
+         params: { password_reset: { token: reset_token, password: "recovered-password" } },
+         headers: account_header,
+         as: :json
+    assert_response :success
+    assert_equal 0, Session.count
+
+    recovered_token = login("recovered-password")
+
+    post "/api/v1/account/cancel", headers: authenticated_headers(recovered_token)
+    assert_response :success
+    assert Account.find(signup.dig("account", "id")).cancelled?
+    assert_equal 0, Session.count
+
+    get "/api/v1/portal", headers: account_header
+    assert_response :forbidden
+
+    post "/api/v1/sessions",
+         params: { session: { email: "jo@acme.test", password: "recovered-password" } },
+         headers: account_header,
+         as: :json
+    assert_response :success
+    cancelled_token = response.parsed_body.dig("session", "token")
+
+    post "/api/v1/account/reactivate", headers: authenticated_headers(cancelled_token)
+    assert_response :success
+    assert_equal false, response.parsed_body.dig("account", "cancelled")
+
+    get "/api/v1/portal", headers: account_header
+    assert_response :success
+    assert_equal "acme", response.parsed_body.dig("portal", "subdomain")
+
+    delete "/api/v1/session", headers: authenticated_headers(cancelled_token)
+    assert_response :no_content
+    get "/api/v1/me", headers: authenticated_headers(cancelled_token)
+    assert_response :unauthorized
+  end
+
+  test "new verification links replace old links and email is scoped by account" do
+    create_signup("first", "same@example.test")
+    old_token = token_from(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/email_verifications",
+         params: { email_verification: { email: "same@example.test" } },
+         headers: account_header("first"),
+         as: :json
+    new_token = token_from(ActionMailer::Base.deliveries.last)
+    refute_equal old_token, new_token
+
+    verify(old_token, "first")
+    assert_response :unprocessable_entity
+    verify(new_token, "first")
+    assert_response :success
+
+    create_signup("second", "same@example.test")
+    assert_equal 2, User.where(email: "same@example.test").count
+  end
+
+  test "tokens cannot be used across tenants and owner access is enforced" do
+    create_signup("first", "one@example.test")
+    first_user = User.find_by!(email: "one@example.test")
+    first_user.update!(verified_at: Time.current)
+    token = login("valid-password", "first", "one@example.test")
+
+    create_signup("second", "two@example.test")
+
+    get "/api/v1/me", headers: authenticated_headers(token, "second")
+    assert_response :unauthorized
+
+    teammate = Account.find_by!(subdomain: "first").users.create!(
+      name: "Agent",
+      email: "agent@example.test",
+      password: "valid-password",
+      role: :agent,
+      verified_at: Time.current
+    )
+    teammate_token = login("valid-password", "first", teammate.email)
+    post "/api/v1/account/cancel", headers: authenticated_headers(teammate_token, "first")
+    assert_response :forbidden
+  end
+
+  private
+
+  def create_signup(subdomain, email)
+    post "/api/v1/account/create",
+         params: {
+           account: {
+             name: subdomain.titleize,
+             subdomain: subdomain,
+             admin: { name: "Owner", email: email, password: "valid-password" }
+           }
+         },
+         as: :json
+    assert_response :created
+  end
+
+  def verify(token, subdomain = "acme")
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: token } },
+         headers: account_header(subdomain),
+         as: :json
+  end
+
+  def login(password, subdomain = "acme", email = "jo@acme.test")
+    post "/api/v1/sessions",
+         params: { session: { email: email, password: password } },
+         headers: account_header(subdomain),
+         as: :json
+    assert_response :success
+    response.parsed_body.dig("session", "token")
+  end
+
+  def token_from(mail)
+    url = mail.text_part.body.decoded.lines.find { |line| line.include?("?account=") }.to_s.strip
+    URI.decode_www_form(URI.parse(url).query).to_h.fetch("token")
+  end
+
+  def account_header(subdomain = "acme")
+    { "X-Helpdesk-Account" => subdomain }
+  end
+
+  def authenticated_headers(token, subdomain = "acme")
+    account_header(subdomain).merge("Authorization" => "Bearer #{token}")
+  end
+end
diff --git a/test/integration/inbound_email_test.rb b/test/integration/inbound_email_test.rb
new file mode 100644
index 0000000..5a006d1
--- /dev/null
+++ b/test/integration/inbound_email_test.rb
@@ -0,0 +1,303 @@
+require "test_helper"
+require "base64"
+
+class InboundEmailTest < ActionDispatch::IntegrationTest
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails".freeze
+  PASSWORD = "inbound-test-password".freeze
+
+  setup do
+    @previous_password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"]
+    @previous_support_domain = ENV["HELPDESK_SUPPORT_DOMAIN"]
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = PASSWORD
+    ENV["HELPDESK_SUPPORT_DOMAIN"] = "support.example.test"
+    ActionMailer::Base.deliveries.clear
+
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @owner = @account.users.create!(
+      name: "Owner",
+      email: "owner@acme.test",
+      password: "owner-password",
+      role: :admin,
+      verified_at: Time.current
+    )
+    @account.update!(owner: @owner)
+  end
+
+  teardown do
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @previous_password
+    ENV["HELPDESK_SUPPORT_DOMAIN"] = @previous_support_domain
+  end
+
+  test "relay ingress is authenticated and processes new mail before responding" do
+    post_relay(email_source(from: "Avery <avery@example.test>", to: "acme@support.example.test", id: "new-1"),
+               authenticated: false)
+    assert_response :unauthorized
+
+    post_relay(email_source(from: "Avery <avery@example.test>", to: "acme@support.example.test", id: "new-1"))
+
+    assert_response :no_content
+    ticket = Ticket.find_by!(account: @account)
+    customer = ticket.requester
+    assert_equal "Cannot log in", ticket.subject
+    assert_equal "Please help me access my account.", ticket.comments.first.body
+    assert ticket.email_origin?
+    assert ticket.reply_address.end_with?("@support.example.test")
+    refute customer.verified?
+    assert customer.customer?
+    assert_equal customer.email, ActionMailer::Base.deliveries.last.to.first
+  end
+
+  test "Cc recipients route a message but multiple businesses are ignored" do
+    post_relay(email_source(
+      to: "unrelated@example.test",
+      cc: "acme@support.example.test",
+      from: "cc@example.test",
+      id: "cc-1"
+    ))
+    assert_response :no_content
+    assert_equal 1, @account.tickets.count
+
+    other = Account.create!(name: "Beta", subdomain: "beta")
+    post_relay(email_source(
+      to: "acme@support.example.test",
+      cc: "beta@support.example.test",
+      from: "ambiguous@example.test",
+      id: "multi-1"
+    ))
+    assert_response :no_content
+    assert_equal 1, @account.tickets.count
+    assert_equal 0, other.tickets.count
+  end
+
+  test "configured support domains and multipart plain text are honored" do
+    ENV["HELPDESK_SUPPORT_DOMAIN"] = "helpdesk.example.test"
+    mail = Mail.new
+    mail.from = "Avery <avery@example.test>"
+    mail.to = "acme@helpdesk.example.test"
+    mail.subject = "Multipart request"
+    mail.message_id = "<multipart-1@example.test>"
+    mail.text_part = Mail::Part.new do
+      content_type "text/plain; charset=UTF-8"
+      body "The plain-text part."
+    end
+    mail.html_part = Mail::Part.new do
+      content_type "text/html; charset=UTF-8"
+      body "<p>The HTML part.</p>"
+    end
+
+    post_relay(mail.encoded)
+
+    assert_response :no_content
+    ticket = @account.tickets.find_by!(subject: "Multipart request")
+    assert_equal "The plain-text part.", ticket.comments.first.body
+    assert ticket.reply_address.end_with?("@helpdesk.example.test")
+  end
+
+  test "invalid deliveries do not claim message IDs and successful deliveries are deduplicated" do
+    post_relay(email_source(to: "missing@support.example.test", from: "retry@example.test", id: "retry-1"))
+    assert_response :no_content
+    assert_equal 0, @account.tickets.count
+
+    post_relay(email_source(
+      to: "acme@support.example.test",
+      from: "retry@example.test",
+      subject: "Corrected delivery",
+      body: "The corrected message.",
+      id: "retry-1"
