+Rails.application.routes.draw do
+  namespace :api do
+    namespace :v1 do
+      post "account/create", to: "accounts#create"
+      post "registrations", to: "registrations#create"
+      get "portal", to: "portals#show"
+
+      resources :requests, only: %i[index show create update] do
+        resources :comments, only: :index, controller: "request_comments"
+      end
+
+      resources :tickets, only: %i[index show update] do
+        post :merge, on: :member
+        resources :comments, only: :index, controller: "ticket_comments"
+      end
+
+      resources :invitations, only: %i[index show create destroy] do
+        post :resend, on: :member
+      end
+      resources :invitation_previews, only: :create
+      resources :invitation_acceptances, only: :create
+
+      resources :users, only: %i[index show update]
+      get "staff", to: "staff#index"
+
+      resources :groups, only: %i[index show create update destroy]
+      resources :group_memberships, only: %i[index show create destroy] do
+        put :make_default, on: :member
+      end
+
+      post "sessions", to: "sessions#create"
+      delete "session", to: "sessions#destroy"
+
+      get "me", to: "me#show"
+      patch "me", to: "me#update"
+      put "me/password", to: "me#update_password"
+
+      post "email_verifications", to: "email_verifications#create"
+      post "email_verifications/confirm", to: "email_verifications#confirm"
+
+      post "password_resets", to: "password_resets#create"
+      post "password_resets/confirm", to: "password_resets#confirm"
+
+      get "account", to: "accounts#show"
+      post "account/cancel", to: "accounts#cancel"
+      post "account/reactivate", to: "accounts#reactivate"
+    end
+  end
+
+  resources :invitations, controller: "api/v1/invitations", only: %i[index show create destroy] do
+    post :resend, on: :member
+  end
+  resources :invitation_previews, controller: "api/v1/invitation_previews", only: :create
+  resources :invitation_acceptances, controller: "api/v1/invitation_acceptances", only: :create
+  resources :users, controller: "api/v1/users", only: %i[index show update]
+  get "staff", to: "api/v1/staff#index"
+
+  get "up" => "rails/health#show", as: :rails_health_check
+end
