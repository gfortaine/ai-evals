+module Api
+  module V1
+    class TicketSerializer
+      def initialize(ticket, include_requester: false)
+        @ticket = ticket
+        @include_requester = include_requester
+      end
+
+      def as_json
+        record = {
+          id: ticket.id,
+          subject: ticket.subject,
+          status: ticket.status,
+          origin: ticket.origin,
+          reply_address: ticket.reply_address,
+          requester_id: ticket.requester_id,
+          merged_into_id: ticket.merged_into_id,
+          created_at: ticket.created_at.iso8601(3),
+          updated_at: ticket.updated_at.iso8601(3)
+        }
+
+        if include_requester
+          record[:priority] = ticket.priority
+          record[:group_id] = ticket.group_id
+          record[:group] = group_json
+          record[:assignee_id] = ticket.assignee_id
+          record[:assignee] = assignee_json
+          record[:requester] = {
