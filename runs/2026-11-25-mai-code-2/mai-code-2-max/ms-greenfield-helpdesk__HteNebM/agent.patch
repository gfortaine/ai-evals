new file mode 100644
index 0000000..e69de29
diff --git a/lib/tasks/helpdesk.rake b/lib/tasks/helpdesk.rake
new file mode 100644
index 0000000..bbb406b
--- /dev/null
+++ b/lib/tasks/helpdesk.rake
@@ -0,0 +1,14 @@
+namespace :helpdesk do
+  desc "Permanently delete accounts cancelled for at least 90 days"
+  task purge_cancelled_accounts: :environment do
+    cutoff = Account::CANCELLATION_RETENTION.ago
+    purged = 0
+
+    Account.cancelled.where("cancelled_at <= ?", cutoff).find_each do |account|
+      account.destroy!
+      purged += 1
+    end
+
+    puts "Purged #{purged} cancelled account#{"s" unless purged == 1}"
+  end
+end
