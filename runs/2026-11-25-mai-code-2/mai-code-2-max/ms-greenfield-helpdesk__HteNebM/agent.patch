@@ -0,0 +1,35 @@
+class HelpdeskMailer < ApplicationMailer
+  def email_verification(user, token)
+    @user = user
+    @url = FrontendLinks.email_verification(account: user.account, token: token)
+
+    mail to: user.email, subject: "Verify your email address"
+  end
+
+  def invitation(invitation, token)
+    @invitation = invitation
+    @url = FrontendLinks.invitation(account: invitation.account, token: token)
+
+    mail to: invitation.email, subject: "You have been invited to #{invitation.account.name}"
+  end
+
+  def password_reset(user, token)
+    @user = user
+    @url = FrontendLinks.password_reset(account: user.account, token: token)
+
+    mail to: user.email, subject: "Reset your password"
+  end
+
+  def ticket_reply(ticket, comment)
+    @ticket = ticket
+    @comment = comment
+    subject = ticket.subject.match?(/\Are:/i) ? ticket.subject : "Re: #{ticket.subject}"
+
+    mail(
+      to: ticket.requester.email,
+      from: ticket.reply_address,
+      reply_to: ticket.reply_address,
+      subject: subject
+    )
+  end
+end
diff --git a/app/models/account.rb b/app/models/account.rb
new file mode 100644
index 0000000..fd422aa
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,81 @@
+class Account < ApplicationRecord
+  CANCELLATION_RETENTION = 90.days
+
+  belongs_to :owner, class_name: "User", optional: true
+
+  has_many :groups, inverse_of: :account, dependent: :destroy
+  has_many :group_memberships, through: :groups
+  has_many :users, inverse_of: :account, dependent: :destroy
+  has_many :sessions, through: :users
+  has_many :email_verifications, dependent: :destroy
+  has_many :password_resets, dependent: :destroy
+  has_many :tickets, inverse_of: :account, dependent: :destroy
+  has_many :invitations, inverse_of: :account, dependent: :destroy
+
+  before_validation :normalize_subdomain
+  before_validation :normalize_name
+
+  validates :name, presence: true, length: { maximum: 255 }
+  validates :subdomain,
+            presence: true,
+            length: { maximum: 63 },
+            uniqueness: true,
+            format: {
+              with: /\A[a-z0-9]+(?:-[a-z0-9]+)*\z/,
+              message: "may contain only lowercase letters, numbers, and single hyphens"
+            }
+  validate :owner_belongs_to_account, if: -> { owner_id.present? }
+
+  scope :active, -> { where(cancelled_at: nil) }
+  scope :cancelled, -> { where.not(cancelled_at: nil) }
+
+  def active?
+    cancelled_at.nil?
+  end
+
+  def cancelled?
+    !active?
+  end
+
+  def reactivation_deadline
+    cancelled_at && cancelled_at + CANCELLATION_RETENTION
+  end
+
+  def reactivation_expired?
+    cancelled? && reactivation_deadline <= Time.current
+  end
+
+  def cancel!
+    with_lock do
+      errors.add(:base, "is already cancelled") unless active?
+      raise ActiveRecord::RecordInvalid, self if errors.any?
+
+      update!(cancelled_at: Time.current)
+      Session.where(user_id: users.select(:id)).delete_all
+    end
+  end
+
+  def reactivate!
+    with_lock do
+      errors.add(:base, "is not cancelled") if active?
+      errors.add(:base, "can no longer be reactivated") if cancelled? && reactivation_expired?
+      raise ActiveRecord::RecordInvalid, self if errors.any?
+
+      update!(cancelled_at: nil)
+    end
+  end
+
+  private
+
+  def normalize_name
+    self.name = name.to_s.strip
+  end
+
+  def normalize_subdomain
+    self.subdomain = subdomain.to_s.strip.downcase
+  end
+
+  def owner_belongs_to_account
+    errors.add(:owner, "must belong to this account") unless owner&.account_id == id
+  end
+end
