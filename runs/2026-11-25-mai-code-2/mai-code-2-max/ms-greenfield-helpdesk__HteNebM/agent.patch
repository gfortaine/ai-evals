+    assert_equal [customer.email], reply.to
+    assert_equal [ticket.reply_address], reply.from
+    assert_equal [ticket.reply_address], reply.reply_to
+    assert_includes reply.text_part.body.decoded, "We reset the account."
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { comment: { body: "Private note.", public: false } } },
+          headers: authenticated_headers,
+          as: :json
+    assert_response :success
+    assert_equal 1, ActionMailer::Base.deliveries.size
+  end
+
+  test "incoming replies to a merged ticket are ignored without claiming the message ID" do
+    customer = create_customer("Avery", "avery@example.test")
+    post_relay(email_source(to: "acme@support.example.test", from: customer.email, id: "closed-thread-1"))
+    source = Ticket.find_by!(account: @account)
+    target = @account.tickets.create!(requester: customer, subject: "Surviving conversation")
+    target.comments.create!(author: customer, body: "Target initial comment")
+
+    post "/api/v1/tickets/#{source.id}/merge",
+         params: { merge: { target_id: target.id } },
+         headers: authenticated_headers,
+         as: :json
+    assert_response :success
+    source_comment_count = source.comments.count
+    ActionMailer::Base.deliveries.clear
+
+    post_relay(email_source(
+      to: source.reply_address,
+      from: customer.email,
+      subject: "Re: Cannot log in",
+      body: "This should be rejected.",
+      id: "closed-reply-1"
+    ))
+    assert_equal source_comment_count, source.comments.reload.count
+    assert source.reload.closed?
+    refute Comment.exists?(email_message_id: "closed-reply-1@example.test")
+
+    post_relay(email_source(
+      to: target.reply_address,
+      from: customer.email,
+      subject: "Re: Surviving conversation",
+      body: "This reaches the surviving ticket.",
+      id: "closed-reply-1"
+    ))
+    reply_comment = Comment.find_by!(email_message_id: "closed-reply-1@example.test")
+    assert_equal target.id, reply_comment.ticket_id
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "only the requester can reply to a private address and replies reopen solved tickets" do
+    customer = create_customer("Avery", "avery@example.test")
+    post_relay(email_source(to: "acme@support.example.test", from: customer.email, id: "thread-1"))
+    ticket = Ticket.find_by!(account: @account)
+    ticket.update!(status: :solved)
+
+    post_relay(email_source(
+      to: ticket.reply_address,
+      from: "impostor@example.test",
+      subject: "Re: Cannot log in",
+      body: "This is not the requester.",
+      id: "thread-reply-1"
+    ))
+    assert_equal 1, ticket.comments.count
+    assert ticket.reload.solved?
+
+    post_relay(email_source(
+      to: ticket.reply_address,
+      from: customer.email,
+      subject: "Re: Cannot log in",
+      body: "It is fixed now, thank you.",
+      id: "thread-reply-1"
+    ))
+    assert ticket.reload.open?
+    assert_equal "It is fixed now, thank you.", ticket.comments.order(:id).last.body
+
+    post_relay(email_source(
+      to: "acme@support.example.test",
+      from: customer.email,
+      subject: "A separate problem",
+      body: "Please open another ticket.",
+      id: "thread-new-1"
+    ))
+    assert_equal 2, @account.tickets.count
+  end
+
+  private
+
+  def post_relay(source, authenticated: true)
+    headers = { "Content-Type" => "message/rfc822" }
+    if authenticated
+      credentials = Base64.strict_encode64("actionmailbox:#{PASSWORD}")
+      headers["Authorization"] = "Basic #{credentials}"
+    end
+
+    post RELAY_PATH, params: source, headers: headers
+  end
+
+  def email_source(from:, to:, id:, cc: nil, subject: "Cannot log in", body: "Please help me access my account.", headers: {})
+    lines = [
+      "From: #{from}",
+      "To: #{to}",
+      ("Cc: #{cc}" if cc),
+      "Subject: #{subject}",
+      "Message-ID: <#{id}@example.test>",
+      "Date: Sat, 21 Nov 2026 10:00:00 +0000",
+      *headers.map { |name, value| "#{name}: #{value}" },
+      "Content-Type: text/plain; charset=UTF-8",
+      "Content-Transfer-Encoding: 8bit"
+    ].compact
+
+    "#{lines.join("\r\n")}\r\n\r\n#{body}\r\n"
+  end
+
+  def create_customer(name, email)
+    @account.users.create!(
+      name: name,
+      email: email,
+      password: "customer-password",
+      role: :customer,
+      verified_at: Time.current
+    )
+  end
+
+  def authenticated_headers
+    _session, token = Session.issue!(@owner)
+    {
+      "X-Helpdesk-Account" => @account.subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+end
