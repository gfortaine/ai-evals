+        attributes = params.require(:session)
+        email = attributes.require(:email).to_s.strip.downcase
+        password = attributes.require(:password).to_s
+        user = current_account.users.find_by(email: email)
+
+        unless user&.authenticate(password)
+          raise ApiRequestError.new(
+            "Invalid email or password",
+            status: :unauthorized,
+            code: "invalid_credentials"
+          )
+        end
+
+        if user.suspended?
+          raise ApiRequestError.new(
+            "The user is suspended",
+            status: :forbidden,
+            code: "user_suspended"
+          )
+        end
+
+        unless user.verified?
+          raise ApiRequestError.new(
+            "Email address has not been verified",
+            status: :forbidden,
+            code: "email_unverified"
+          )
+        end
+
+        if current_account.cancelled? &&
+           (!user.owner? || current_account.reactivation_expired?)
+          raise ApiRequestError.new(
+            "The account is unavailable",
+            status: :forbidden,
+            code: "account_unavailable"
+          )
+        end
+
+        session, token = Session.issue!(user)
+
+        render json: {
+          user: user_json(user),
+          account: account_json,
+          session: SessionSerializer.new(session, token: token).as_json
+        }
+      end
+
+      def destroy
+        current_session.destroy!
+        head :no_content
+      end
+    end
+  end
+end
