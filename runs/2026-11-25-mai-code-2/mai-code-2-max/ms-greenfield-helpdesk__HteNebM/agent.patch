+
+    get "/api/v1/groups/#{billing.fetch('id')}",
+        headers: authenticated_headers(@agent_token),
+        as: :json
+    assert_response :success
+    assert_equal "Billing", response.parsed_body.dig("group", "name")
+
+    patch "/api/v1/groups/#{billing.fetch('id')}",
+          params: { group: { name: "Accounts Receivable" } },
+          headers: authenticated_headers(@owner_token),
+          as: :json
+    assert_response :success
+    assert_equal "Accounts Receivable", response.parsed_body.dig("group", "name")
+
+    post "/api/v1/groups",
+         params: { group: { name: "accounts receivable" } },
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :unprocessable_entity
+
+    get "/api/v1/groups", headers: authenticated_headers(@customer_token), as: :json
+    assert_response :forbidden
+
+    delete "/api/v1/groups/#{billing.fetch('id')}",
