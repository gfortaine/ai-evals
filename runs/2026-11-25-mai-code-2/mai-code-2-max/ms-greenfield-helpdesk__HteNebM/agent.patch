new file mode 100644
index 0000000..bb69ee7
--- /dev/null
+++ b/app/controllers/api/v1/group_memberships_controller.rb
@@ -0,0 +1,98 @@
+module Api
+  module V1
+    class GroupMembershipsController < BaseController
+      before_action :set_current_account
+      before_action :require_active_account
+      before_action :authenticate_user!
+      before_action :require_staff!
+      before_action :require_admin!, only: %i[create destroy make_default]
+      before_action :set_membership, only: %i[show destroy make_default]
+
+      def index
+        scope = current_account.group_memberships.includes(:group, :user)
+        scope = scope.where(group_id: id_filter(:group_id)) if params.key?(:group_id)
+        scope = scope.where(user_id: id_filter(:user_id)) if params.key?(:user_id)
+        records, pagination = paginate(scope, order: { id: :asc })
+
+        render json: {
+          group_memberships: records.map { |membership| membership_json(membership) },
+          **pagination
+        }
+      end
+
+      def show
+        render json: { group_membership: membership_json(@membership) }
+      end
+
+      def create
+        attributes = params.require(:group_membership)
+        group_id = attributes.require(:group_id)
+        user_id = attributes.require(:user_id)
+        requested_default = attributes.key?(:default) ? boolean_value(attributes[:default]) : false
+
+        membership = nil
+        current_account.with_lock do
+          membership = GroupMembership.new(
+            group: current_account.groups.find_by(id: group_id),
+            user: current_account.users.find_by(id: user_id),
+            default: requested_default
+          )
+          membership.save!
+        end
+
+        render json: { group_membership: membership_json(membership.reload) }, status: :created
+      end
+
+      def destroy
+        current_account.with_lock { @membership.destroy! }
+        head :no_content
+      end
+
+      def make_default
+        current_account.with_lock { @membership.make_default! }
+
+        render json: { group_membership: membership_json(@membership.reload) }
+      end
+
+      private
+
+      def set_membership
+        @membership = current_account.group_memberships.includes(:group, :user).find(params[:id])
+      end
+
+      def membership_json(membership)
+        GroupMembershipSerializer.new(membership).as_json
+      end
+
+      def id_filter(name)
+        id = Integer(params[name].to_s, 10)
+        return id if id.positive? && id <= (2**63 - 1)
+
+        raise ArgumentError
+      rescue ArgumentError
+        raise ApiRequestError.new(
+          "#{name} must be a positive integer",
+          status: :bad_request,
+          code: "invalid_filter"
+        )
+      end
+
+      def boolean_value(value)
+        return value if value == true || value == false
+
+        case value.to_s.strip.downcase
+        when "true", "1"
+          true
+        when "false", "0"
+          false
+        else
+          raise ApiRequestError.new(
+            "default must be true or false",
+            status: :bad_request,
+            code: "invalid_boolean"
+          )
+        end
+      end
+    end
+  end
+end
