diff --git a/test/integration/inbound_email_test.rb b/test/integration/inbound_email_test.rb
new file mode 100644
index 0000000..851c53e
--- /dev/null
+++ b/test/integration/inbound_email_test.rb
@@ -0,0 +1,265 @@
+require "test_helper"
+require "base64"
+
+class InboundEmailTest < ActionDispatch::IntegrationTest
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails".freeze
+  PASSWORD = "inbound-test-password".freeze
+
+  setup do
+    @previous_password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"]
+    @previous_support_domain = ENV["HELPDESK_SUPPORT_DOMAIN"]
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = PASSWORD
+    ENV["HELPDESK_SUPPORT_DOMAIN"] = "support.example.test"
+    ActionMailer::Base.deliveries.clear
+
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @owner = @account.users.create!(
+      name: "Owner",
+      email: "owner@acme.test",
+      password: "owner-password",
+      role: :admin,
+      verified_at: Time.current
+    )
+    @account.update!(owner: @owner)
+  end
+
+  teardown do
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @previous_password
+    ENV["HELPDESK_SUPPORT_DOMAIN"] = @previous_support_domain
+  end
+
+  test "relay ingress is authenticated and processes new mail before responding" do
+    post_relay(email_source(from: "Avery <avery@example.test>", to: "acme@support.example.test", id: "new-1"),
+               authenticated: false)
+    assert_response :unauthorized
+
+    post_relay(email_source(from: "Avery <avery@example.test>", to: "acme@support.example.test", id: "new-1"))
+
+    assert_response :no_content
+    ticket = Ticket.find_by!(account: @account)
+    customer = ticket.requester
+    assert_equal "Cannot log in", ticket.subject
+    assert_equal "Please help me access my account.", ticket.comments.first.body
+    assert ticket.email_origin?
+    assert ticket.reply_address.end_with?("@support.example.test")
+    refute customer.verified?
+    assert customer.customer?
+    assert_equal customer.email, ActionMailer::Base.deliveries.last.to.first
+  end
+
+  test "Cc recipients route a message but multiple businesses are ignored" do
+    post_relay(email_source(
+      to: "unrelated@example.test",
+      cc: "acme@support.example.test",
+      from: "cc@example.test",
+      id: "cc-1"
+    ))
+    assert_response :no_content
+    assert_equal 1, @account.tickets.count
+
+    other = Account.create!(name: "Beta", subdomain: "beta")
+    post_relay(email_source(
+      to: "acme@support.example.test",
+      cc: "beta@support.example.test",
+      from: "ambiguous@example.test",
+      id: "multi-1"
+    ))
+    assert_response :no_content
+    assert_equal 1, @account.tickets.count
+    assert_equal 0, other.tickets.count
+  end
+
+  test "configured support domains and multipart plain text are honored" do
+    ENV["HELPDESK_SUPPORT_DOMAIN"] = "helpdesk.example.test"
+    mail = Mail.new
+    mail.from = "Avery <avery@example.test>"
+    mail.to = "acme@helpdesk.example.test"
+    mail.subject = "Multipart request"
+    mail.message_id = "<multipart-1@example.test>"
+    mail.text_part = Mail::Part.new do
+      content_type "text/plain; charset=UTF-8"
+      body "The plain-text part."
+    end
+    mail.html_part = Mail::Part.new do
+      content_type "text/html; charset=UTF-8"
+      body "<p>The HTML part.</p>"
+    end
+
+    post_relay(mail.encoded)
+
+    assert_response :no_content
+    ticket = @account.tickets.find_by!(subject: "Multipart request")
+    assert_equal "The plain-text part.", ticket.comments.first.body
+    assert ticket.reply_address.end_with?("@helpdesk.example.test")
+  end
+
+  test "invalid deliveries do not claim message IDs and successful deliveries are deduplicated" do
+    post_relay(email_source(to: "missing@support.example.test", from: "retry@example.test", id: "retry-1"))
+    assert_response :no_content
+    assert_equal 0, @account.tickets.count
+
+    post_relay(email_source(
+      to: "acme@support.example.test",
+      from: "retry@example.test",
+      subject: "Corrected delivery",
+      body: "The corrected message.",
+      id: "retry-1"
+    ))
+    assert_response :no_content
+    assert_equal 1, @account.tickets.count
+
+    post_relay(email_source(
+      to: "acme@support.example.test",
+      from: "retry@example.test",
+      subject: "Changed duplicate",
+      body: "A different body with the same Message-ID.",
+      id: "retry-1"
+    ))
+    assert_response :no_content
+    assert_equal 1, @account.tickets.count
+    assert_equal 1, Comment.where(email_message_id: "retry-1@example.test").count
+  end
+
+  test "the same raw delivery can succeed after previously invalid routing becomes valid" do
+    source = email_source(
+      to: "future@support.example.test",
+      from: "future@example.test",
+      id: "future-1"
+    )
+
+    post_relay(source)
+    assert_response :no_content
+    assert_equal 0, Ticket.count
+
+    account = Account.create!(name: "Future", subdomain: "future")
+    post_relay(source)
+    assert_response :no_content
+    assert_equal 1, account.tickets.count
+  end
+
+  test "automated and list messages are ignored" do
+    post_relay(email_source(
+      to: "acme@support.example.test",
+      from: "bot@example.test",
+      id: "auto-1",
+      headers: { "Auto-Submitted" => "auto-generated" }
+    ))
+    post_relay(email_source(
+      to: "acme@support.example.test",
+      from: "list@example.test",
+      id: "list-1",
+      headers: { "List-Id" => "Example list <example.list.test>" }
+    ))
+
+    assert_equal 0, @account.tickets.count
+  end
+
+  test "staff public replies are emailed with the ticket reply address" do
+    customer = create_customer("Avery", "avery@example.test")
+    post_relay(email_source(to: "acme@support.example.test", from: customer.email, id: "reply-mail-1"))
+    ticket = Ticket.find_by!(account: @account)
+    ActionMailer::Base.deliveries.clear
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { comment: { body: "We reset the account.", public: true } } },
+          headers: authenticated_headers,
+          as: :json
+
+    assert_response :success
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    reply = ActionMailer::Base.deliveries.first
+    assert_equal [customer.email], reply.to
+    assert_equal [ticket.reply_address], reply.from
+    assert_equal [ticket.reply_address], reply.reply_to
+    assert_includes reply.text_part.body.decoded, "We reset the account."
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { comment: { body: "Private note.", public: false } } },
+          headers: authenticated_headers,
+          as: :json
+    assert_response :success
+    assert_equal 1, ActionMailer::Base.deliveries.size
+  end
+
+  test "only the requester can reply to a private address and replies reopen solved tickets" do
+    customer = create_customer("Avery", "avery@example.test")
+    post_relay(email_source(to: "acme@support.example.test", from: customer.email, id: "thread-1"))
+    ticket = Ticket.find_by!(account: @account)
+    ticket.update!(status: :solved)
+
+    post_relay(email_source(
+      to: ticket.reply_address,
+      from: "impostor@example.test",
+      subject: "Re: Cannot log in",
+      body: "This is not the requester.",
+      id: "thread-reply-1"
+    ))
+    assert_equal 1, ticket.comments.count
+    assert ticket.reload.solved?
+
+    post_relay(email_source(
+      to: ticket.reply_address,
+      from: customer.email,
+      subject: "Re: Cannot log in",
+      body: "It is fixed now, thank you.",
+      id: "thread-reply-1"
+    ))
+    assert ticket.reload.open?
+    assert_equal "It is fixed now, thank you.", ticket.comments.order(:id).last.body
+
+    post_relay(email_source(
+      to: "acme@support.example.test",
+      from: customer.email,
+      subject: "A separate problem",
+      body: "Please open another ticket.",
+      id: "thread-new-1"
+    ))
+    assert_equal 2, @account.tickets.count
+  end
+
+  private
+
+  def post_relay(source, authenticated: true)
+    headers = { "Content-Type" => "message/rfc822" }
+    if authenticated
+      credentials = Base64.strict_encode64("actionmailbox:#{PASSWORD}")
+      headers["Authorization"] = "Basic #{credentials}"
+    end
+
+    post RELAY_PATH, params: source, headers: headers
+  end
+
+  def email_source(from:, to:, id:, cc: nil, subject: "Cannot log in", body: "Please help me access my account.", headers: {})
+    lines = [
+      "From: #{from}",
+      "To: #{to}",
+      ("Cc: #{cc}" if cc),
+      "Subject: #{subject}",
+      "Message-ID: <#{id}@example.test>",
+      "Date: Sat, 21 Nov 2026 10:00:00 +0000",
+      *headers.map { |name, value| "#{name}: #{value}" },
+      "Content-Type: text/plain; charset=UTF-8",
+      "Content-Transfer-Encoding: 8bit"
+    ].compact
+
+    "#{lines.join("\r\n")}\r\n\r\n#{body}\r\n"
+  end
+
+  def create_customer(name, email)
+    @account.users.create!(
+      name: name,
+      email: email,
+      password: "customer-password",
+      role: :customer,
+      verified_at: Time.current
+    )
+  end
+
+  def authenticated_headers
+    _session, token = Session.issue!(@owner)
+    {
+      "X-Helpdesk-Account" => @account.subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+end
