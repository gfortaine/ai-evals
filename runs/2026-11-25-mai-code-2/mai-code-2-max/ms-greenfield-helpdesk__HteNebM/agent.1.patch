diff --git a/app/controllers/api/v1/sessions_controller.rb b/app/controllers/api/v1/sessions_controller.rb
new file mode 100644
index 0000000..64dace8
--- /dev/null
+++ b/app/controllers/api/v1/sessions_controller.rb
@@ -0,0 +1,53 @@
+module Api
+  module V1
+    class SessionsController < BaseController
+      before_action :set_current_account
+      before_action :authenticate_user!, only: :destroy
+
+      def create
+        attributes = params.require(:session)
+        email = attributes.require(:email).to_s.strip.downcase
+        password = attributes.require(:password).to_s
+        user = current_account.users.find_by(email: email)
+
+        unless user&.authenticate(password)
+          raise ApiRequestError.new(
+            "Invalid email or password",
+            status: :unauthorized,
+            code: "invalid_credentials"
+          )
+        end
+
+        unless user.verified?
+          raise ApiRequestError.new(
+            "Email address has not been verified",
+            status: :forbidden,
+            code: "email_unverified"
+          )
+        end
+
+        if current_account.cancelled? &&
+           (!user.owner? || current_account.reactivation_expired?)
+          raise ApiRequestError.new(
+            "The account is unavailable",
+            status: :forbidden,
+            code: "account_unavailable"
+          )
+        end
+
+        session, token = Session.issue!(user)
+
+        render json: {
+          user: user_json(user),
+          account: account_json,
+          session: SessionSerializer.new(session, token: token).as_json
+        }
+      end
+
+      def destroy
+        current_session.destroy!
+        head :no_content
+      end
+    end
+  end
+end
diff --git a/app/controllers/application_controller.rb b/app/controllers/application_controller.rb
new file mode 100644
index 0000000..1cf9c31
--- /dev/null
+++ b/app/controllers/application_controller.rb
@@ -0,0 +1,35 @@
+class ApiRequestError < StandardError
+  attr_reader :status, :code
+
+  def initialize(message, status:, code:)
+    super(message)
+    @status = status
+    @code = code
+  end
+end
+
+class ApplicationController < ActionController::API
+  rescue_from ApiRequestError, with: :render_api_error
+  rescue_from ActionController::ParameterMissing, with: :render_parameter_error
+  rescue_from ActiveRecord::RecordInvalid, with: :render_record_errors
+  rescue_from ActiveRecord::RecordNotUnique, with: :render_duplicate_error
+
+  private
+
+  def render_api_error(error)
+    render json: { error: error.message, code: error.code }, status: error.status
+  end
+
+  def render_parameter_error(error)
+    render json: { error: error.message, code: "invalid_request" }, status: :bad_request
+  end
+
+  def render_record_errors(error)
+    render json: { errors: error.record.errors.to_hash(full_messages: true) }, status: :unprocessable_entity
+  end
+
+  def render_duplicate_error
+    render json: { error: "A matching record already exists", code: "duplicate_record" },
+           status: :unprocessable_entity
+  end
+end
