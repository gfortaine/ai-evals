+      def filtered_ticket_scope
+        scope = current_account.tickets
+        scope = scope.where(status: enum_filter(:status, Ticket::STATUSES)) if params.key?(:status)
+        scope = scope.where(priority: enum_filter(:priority, Ticket::PRIORITIES)) if params.key?(:priority)
+        if params.key?(:assignee_id)
+          scope = scope.where(assignee_id: person_id_filter(:assignee_id, allow_unassigned: true))
+        end
+        scope = scope.where(requester_id: person_id_filter(:requester_id)) if params.key?(:requester_id)
+        scope = search_scope(scope) if params.key?(:q) && params[:q].to_s != ""
+        scope
+      end
+
+      def search_scope(scope)
+        pattern = "%#{Ticket.sanitize_sql_like(params[:q].to_s)}%"
+        condition = <<~SQL.squish
+          tickets.subject ILIKE :pattern
+          OR EXISTS (
+            SELECT 1
+            FROM comments
+            WHERE comments.ticket_id = tickets.id
+              AND comments.public = TRUE
+              AND comments.body ILIKE :pattern
+          )
+        SQL
+
+        scope.where(condition, pattern: pattern)
+      end
+
+      def enum_filter(name, allowed_values)
+        value = params[name].to_s.strip.downcase
+        return value if allowed_values.include?(value)
+
+        raise ApiRequestError.new(
+          "#{name} must be one of: #{allowed_values.join(', ')}",
+          status: :bad_request,
+          code: "invalid_filter"
+        )
+      end
+
+      def person_id_filter(name, allow_unassigned: false)
+        value = params[name].to_s.strip
+        if allow_unassigned && value.downcase == "unassigned"
+          return nil
+        end
+
+        id = Integer(value, 10)
+        return id if id.positive? && id <= (2**63 - 1)
+
+        invalid_person_id_filter!(name, allow_unassigned)
+      rescue ArgumentError
+        invalid_person_id_filter!(name, allow_unassigned)
+      end
+
+      def invalid_person_id_filter!(name, allow_unassigned)
+        expectation = allow_unassigned ? "unassigned or a positive integer" : "a positive integer"
+        raise ApiRequestError.new(
+          "#{name} must be #{expectation}",
+          status: :bad_request,
+          code: "invalid_filter"
+        )
+      end
+
       def ticket_json(ticket)
         TicketSerializer.new(ticket, include_requester: true).as_json
       end
