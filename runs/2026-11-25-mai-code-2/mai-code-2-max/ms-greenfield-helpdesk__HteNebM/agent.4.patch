+    owner_token = issue_session(@owner)
+    ticket = create_ticket(customer)
+
+    assert_equal "normal", ticket.priority
+
+    get "/api/v1/tickets/#{ticket.id}", headers: authenticated_headers(owner_token)
+    assert_response :success
+    assert_equal "normal", response.parsed_body.dig("ticket", "priority")
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { priority: "high" } },
+          headers: authenticated_headers(owner_token),
+          as: :json
+    assert_response :success
+    assert_equal "high", response.parsed_body.dig("ticket", "priority")
+    assert_predicate ticket.reload, :high?
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { priority: "urgent" } },
+          headers: authenticated_headers(owner_token),
+          as: :json
+    assert_response :unprocessable_entity
+    assert_predicate ticket.reload, :high?
+
+    get "/api/v1/requests/#{ticket.id}", headers: authenticated_headers(customer_token)
+    assert_response :success
+    refute response.parsed_body.fetch("request").key?("priority")
+
+    patch "/api/v1/requests/#{ticket.id}",
+          params: { request: { status: "open", priority: "normal" } },
+          headers: authenticated_headers(customer_token),
+          as: :json
+    assert_response :success
+    refute response.parsed_body.fetch("request").key?("priority")
+    assert_predicate ticket.reload, :high?
+  end
+
+  test "staff combine ticket filters and search public text literally" do
+    customer = create_customer("Avery", "avery@example.test")
+    other_customer = create_customer("Blair", "blair@example.test")
+    owner_token = issue_session(@owner)
+
+    target = create_ticket(customer, subject: "Download problem")
+    target.update!(priority: :high)
+    target.comments.create!(author: @owner, body: "Your RECEIPT is attached", public: true)
+    target.comments.create!(author: @owner, body: "Receipt archive too", public: true)
+
+    subject_match = create_ticket(other_customer, subject: "RECEIPT export")
+    assigned_match = create_ticket(other_customer, subject: "Another receipt request")
+    assigned_match.update!(assignee: @owner, priority: :high)
+
+    private_match = create_ticket(other_customer, subject: "Private note only")
+    private_match.comments.create!(author: @owner, body: "receipt token", public: false)
+    solved_match = create_ticket(other_customer, subject: "Solved receipt request")
+    solved_match.update!(status: :solved, priority: :high)
+
+    literal_percent = create_ticket(other_customer, subject: "100% complete")
+    literal_underscore = create_ticket(other_customer, subject: "under_score")
+    literal_backslash = create_ticket(other_customer, subject: "back#{92.chr}slash")
+
+    get "/api/v1/tickets",
+        params: {
+          status: "open",
+          assignee_id: "unassigned",
+          priority: "high",
+          q: "receipt"
+        },
+        headers: authenticated_headers(owner_token)
+    assert_response :success
+    assert_equal [target.id], response.parsed_body.fetch("tickets").pluck("id")
+    assert_equal 1, response.parsed_body.fetch("count")
+
+    get "/api/v1/tickets",
+        params: { assignee_id: @owner.id },
+        headers: authenticated_headers(owner_token)
+    assert_response :success
+    assert_equal [assigned_match.id], response.parsed_body.fetch("tickets").pluck("id")
+
+    get "/api/v1/tickets",
+        params: { requester_id: customer.id },
+        headers: authenticated_headers(owner_token)
+    assert_response :success
+    assert_equal [target.id], response.parsed_body.fetch("tickets").pluck("id")
+
+    get "/api/v1/tickets",
+        params: { q: "receipt" },
+        headers: authenticated_headers(owner_token)
+    assert_response :success
+    assert_equal(
+      [target, subject_match, assigned_match, solved_match].map(&:id).sort,
+      response.parsed_body.fetch("tickets").pluck("id").sort
+    )
+
+    get "/api/v1/tickets",
+        params: { q: "%" },
+        headers: authenticated_headers(owner_token)
+    assert_response :success
+    assert_equal [literal_percent.id], response.parsed_body.fetch("tickets").pluck("id")
+
+    get "/api/v1/tickets",
+        params: { q: "_" },
+        headers: authenticated_headers(owner_token)
+    assert_response :success
+    assert_equal [literal_underscore.id], response.parsed_body.fetch("tickets").pluck("id")
+
+    get "/api/v1/tickets",
+        params: { q: 92.chr },
+        headers: authenticated_headers(owner_token)
+    assert_response :success
+    assert_equal [literal_backslash.id], response.parsed_body.fetch("tickets").pluck("id")
+
+    get "/api/v1/tickets",
+        params: { priority: "urgent" },
+        headers: authenticated_headers(owner_token)
+    assert_response :bad_request
+
+    get "/api/v1/tickets",
+        params: { assignee_id: "nobody" },
+        headers: authenticated_headers(owner_token)
+    assert_response :bad_request
+  end
+
+  test "customers filter their own requests by status" do
+    customer = create_customer("Avery", "avery@example.test")
+    other_customer = create_customer("Blair", "blair@example.test")
+    customer_token = issue_session(customer)
+    open_ticket = create_ticket(customer, subject: "Open request")
+    solved_ticket = create_ticket(customer, subject: "Solved request")
+    solved_ticket.update!(status: :solved, priority: :high)
+    create_ticket(other_customer, subject: "Someone else's solved request").update!(status: :solved)
+
+    get "/api/v1/requests",
+        params: { status: "OPEN" },
+        headers: authenticated_headers(customer_token)
+    assert_response :success
+    assert_equal [open_ticket.id], response.parsed_body.fetch("requests").pluck("id")
+    assert response.parsed_body.fetch("requests").none? { |request| request.key?("priority") }
+
+    get "/api/v1/requests",
+        params: { status: "solved" },
+        headers: authenticated_headers(customer_token)
+    assert_response :success
+    assert_equal [solved_ticket.id], response.parsed_body.fetch("requests").pluck("id")
+
+    get "/api/v1/requests",
+        params: { status: "pending" },
+        headers: authenticated_headers(customer_token)
+    assert_response :success
+    assert_empty response.parsed_body.fetch("requests")
+
+    get "/api/v1/requests",
+        params: { status: "closed" },
+        headers: authenticated_headers(customer_token)
+    assert_response :bad_request
+  end
