diff --git a/app/controllers/api/v1/requests_controller.rb b/app/controllers/api/v1/requests_controller.rb
new file mode 100644
index 0000000..93ed3f5
--- /dev/null
+++ b/app/controllers/api/v1/requests_controller.rb
@@ -0,0 +1,85 @@
+module Api
+  module V1
+    class RequestsController < BaseController
+      before_action :set_current_account
+      before_action :require_active_account
+      before_action :authenticate_user!
+      before_action :require_customer!
+      before_action :set_request, only: %i[show update]
+
+      def index
+        scope = current_account.tickets
+          .where(requester: current_user)
+          .order(updated_at: :desc, id: :desc)
+        records, pagination = paginate(scope)
+
+        render json: {
+          requests: records.map { |ticket| ticket_json(ticket) },
+          **pagination
+        }
+      end
+
+      def show
+        render json: { request: ticket_json(@request) }
+      end
+
+      def create
+        attributes = params.require(:request).permit(:subject, comment: [:body])
+        subject = attributes.require(:subject)
+        body = attributes.require(:comment).require(:body)
+
+        ticket = nil
+        Ticket.transaction do
+          ticket = current_account.tickets.create!(
+            subject: subject,
+            requester: current_user,
+            status: :open
+          )
+          ticket.comments.create!(author: current_user, body: body, public: true)
+        end
+
+        render json: { request: ticket_json(ticket.reload) }, status: :created
+      end
+
+      def update
+        attributes = params.require(:request).permit(:status, comment: [:body])
+        update_ticket(@request, attributes)
+
+        render json: { request: ticket_json(@request.reload) }
+      end
+
+      private
+
+      def set_request
+        @request = current_account.tickets.find_by!(id: params[:id], requester: current_user)
+      end
+
+      def ticket_json(ticket)
+        TicketSerializer.new(ticket).as_json
+      end
+
+      def update_ticket(ticket, attributes)
+        comment_attributes = attributes[:comment]
+        body = comment_attributes.require(:body) if comment_attributes
+        status_provided = attributes.key?(:status)
+        requested_status = attributes[:status] if status_provided
+
+        ticket.with_lock do
+          if status_provided && !%w[open solved].include?(requested_status.to_s)
+            ticket.errors.add(:status, "is not available to customers")
+            raise ActiveRecord::RecordInvalid, ticket
+          end
+
+          if status_provided
+            ticket.status = requested_status
+          elsif body && !ticket.open?
+            ticket.status = :open
+          end
+
+          ticket.save! if ticket.has_changes_to_save?
+          ticket.comments.create!(author: current_user, body: body, public: true) if body
+        end
+      end
+    end
+  end
+end
