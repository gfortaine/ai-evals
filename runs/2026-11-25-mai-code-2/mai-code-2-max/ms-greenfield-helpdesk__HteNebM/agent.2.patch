@@ -0,0 +1,49 @@
+module Api
+  module V1
+    class TicketsController < BaseController
+      before_action :set_current_account
+      before_action :require_active_account
+      before_action :authenticate_user!
+      before_action :require_staff!
+      before_action :set_ticket, only: %i[show update]
+
+      def index
+        scope = current_account.tickets.includes(:requester).order(updated_at: :desc, id: :desc)
+        records, pagination = paginate(scope)
+
+        render json: {
+          tickets: records.map { |ticket| ticket_json(ticket) },
+          **pagination
+        }
+      end
+
+      def show
+        render json: { ticket: ticket_json(@ticket) }
+      end
+
+      def update
+        attributes = params.require(:ticket).permit(:status, comment: [:body])
+        comment_attributes = attributes[:comment]
+        body = comment_attributes.require(:body) if comment_attributes
+
+        @ticket.with_lock do
+          @ticket.status = attributes[:status] if attributes.key?(:status)
+          @ticket.save! if @ticket.has_changes_to_save?
+          @ticket.comments.create!(author: current_user, body: body, public: true) if body
+        end
+
+        render json: { ticket: ticket_json(@ticket.reload) }
+      end
+
+      private
+
+      def set_ticket
+        @ticket = current_account.tickets.includes(:requester).find(params[:id])
+      end
+
+      def ticket_json(ticket)
+        TicketSerializer.new(ticket, include_requester: true).as_json
+      end
+    end
+  end
+end
