+      def paginate(scope)
+        page = positive_integer_param(:page, 1)
+        per_page = positive_integer_param(:per_page, 25)
+        count = scope.count
+        records = scope.offset((page - 1) * per_page).limit(per_page)
+
+        [
+          records,
+          {
+            count: count,
+            page: page,
+            per_page: per_page,
+            next_page: page * per_page < count ? page + 1 : nil,
+            previous_page: page > 1 ? page - 1 : nil
+          }
+        ]
+      end
+
+      def positive_integer_param(name, default)
+        raw = params[name]
+        return default if raw.nil?
+
+        value = Integer(raw.to_s, 10)
+        raise ArgumentError unless value.positive?
+
+        value
+      rescue ArgumentError
