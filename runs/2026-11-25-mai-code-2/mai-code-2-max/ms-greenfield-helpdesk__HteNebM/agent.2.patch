diff --git a/app/models/ticket.rb b/app/models/ticket.rb
new file mode 100644
index 0000000..10f80b9
--- /dev/null
+++ b/app/models/ticket.rb
@@ -0,0 +1,28 @@
+class Ticket < ApplicationRecord
+  STATUSES = %w[open pending solved].freeze
+
+  belongs_to :account, inverse_of: :tickets
+  belongs_to :requester, class_name: "User", inverse_of: :requested_tickets
+
+  has_many :comments, inverse_of: :ticket, dependent: :destroy
+
+  enum :status, STATUSES.index_by(&:itself), validate: true
+
+  before_validation :normalize_subject
+
+  validates :subject, presence: true, length: { maximum: 255 }
+  validate :requester_belongs_to_account
+
+  private
+
+  def normalize_subject
+    self.subject = subject.to_s.strip
+  end
+
+  def requester_belongs_to_account
+    return unless requester
+
+    errors.add(:requester, "must belong to the account") unless requester.account_id == account_id
+    errors.add(:requester, "must be a customer") unless requester.customer?
+  end
+end
