diff --git a/test/integration/portal_tickets_api_test.rb b/test/integration/portal_tickets_api_test.rb
new file mode 100644
index 0000000..7409efb
--- /dev/null
+++ b/test/integration/portal_tickets_api_test.rb
@@ -0,0 +1,266 @@
+require "test_helper"
+require "uri"
+
+class PortalTicketsApiTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+
+    @account = Account.create!(name: "Acme", subdomain: "acme-portal")
+    @owner = @account.users.create!(
+      name: "Owner",
+      email: "owner@acme.test",
+      password: "owner-password",
+      role: :admin,
+      verified_at: Time.current
+    )
+    @account.update!(owner: @owner)
+  end
+
+  test "customers register through the portal and use verification and login" do
+    post "/api/v1/registrations",
+         params: {
+           user: {
+             name: "Avery",
+             email: "avery@example.test",
+             password: "my-customer-password"
+           }
+         },
+         headers: account_header,
+         as: :json
+
+    assert_response :created
+    user = response.parsed_body.fetch("user")
+    assert_equal "customer", user.fetch("role")
+    assert_equal false, user.fetch("verified")
+    assert_equal @account.id, user.fetch("account_id")
+    assert_equal 1, ActionMailer::Base.deliveries.size
+
+    verification_token = token_from(ActionMailer::Base.deliveries.last)
+    post "/api/v1/email_verifications/confirm",
+         params: { email_verification: { token: verification_token } },
+         headers: account_header,
+         as: :json
+
+    assert_response :success
+
+    post "/api/v1/sessions",
+         params: {
+           session: {
+             email: "avery@example.test",
+             password: "my-customer-password"
+           }
+         },
+         headers: account_header,
+         as: :json
+
+    assert_response :success
+    assert_equal "Avery", response.parsed_body.dig("user", "name")
+    assert_equal "customer", response.parsed_body.dig("user", "role")
+  end
+
+  test "customers open and read only their own requests while staff see requester details" do
+    customer = create_customer("Avery", "avery@example.test")
+    other_customer = create_customer("Blair", "blair@example.test")
+    customer_token = issue_session(customer)
+    owner_token = issue_session(@owner)
+
+    post "/api/v1/requests",
+         params: {
+           request: {
+             subject: "Cannot download my receipt",
+             comment: { body: "The download button does nothing." }
+           }
+         },
+         headers: authenticated_headers(customer_token),
+         as: :json
+
+    assert_response :created
+    request_record = response.parsed_body.fetch("request")
+    assert_equal "Cannot download my receipt", request_record.fetch("subject")
+    assert_equal "open", request_record.fetch("status")
+    assert_equal customer.id, request_record.fetch("requester_id")
+    assert request_record.fetch("created_at").present?
+    assert request_record.fetch("updated_at").present?
+
+    other_ticket = @account.tickets.create!(requester: other_customer, subject: "Separate request")
+    other_ticket.comments.create!(author: other_customer, body: "Another customer's note")
+
+    get "/api/v1/requests", headers: authenticated_headers(customer_token)
+    assert_response :success
+    assert_equal [request_record.fetch("id")], response.parsed_body.fetch("requests").pluck("id")
+    assert_pagination response.parsed_body, count: 1, page: 1, per_page: 25
+
+    get "/api/v1/requests/#{other_ticket.id}", headers: authenticated_headers(customer_token)
+    assert_response :not_found
+
+    get "/api/v1/tickets", headers: authenticated_headers(owner_token)
+    assert_response :success
+    tickets = response.parsed_body.fetch("tickets")
+    assert_equal 2, tickets.length
+    assert_equal(
+      { "id" => customer.id, "name" => "Avery", "email" => "avery@example.test" },
+      tickets.find { |ticket| ticket.fetch("id") == request_record.fetch("id") }.fetch("requester")
+    )
+
+    get "/api/v1/tickets/#{request_record.fetch("id")}/comments",
+        headers: authenticated_headers(owner_token)
+    assert_response :success
+    comment = response.parsed_body.fetch("comments").first
+    assert_equal "The download button does nothing.", comment.fetch("body")
+    assert_equal({ "id" => customer.id, "name" => "Avery" }, comment.fetch("author"))
+    assert_equal true, comment.fetch("public")
+    assert comment.fetch("created_at").present?
+
+    get "/api/v1/tickets", headers: authenticated_headers(customer_token)
+    assert_response :forbidden
+    get "/api/v1/requests", headers: authenticated_headers(owner_token)
+    assert_response :forbidden
+  end
+
+  test "staff replies preserve status and customer replies reopen unless solved" do
+    customer = create_customer("Avery", "avery@example.test")
+    customer_token = issue_session(customer)
+    owner_token = issue_session(@owner)
+    ticket = create_ticket(customer)
+    path = "/api/v1/tickets/#{ticket.id}"
+
+    patch path,
+          params: { ticket: { comment: { body: "Please try again now." }, status: "pending" } },
+          headers: authenticated_headers(owner_token),
+          as: :json
+
+    assert_response :success
+    assert_equal "pending", response.parsed_body.dig("ticket", "status")
+
+    patch path,
+          params: { ticket: { comment: { body: "I sent that moments ago." } } },
+          headers: authenticated_headers(owner_token),
+          as: :json
+
+    assert_response :success
+    assert_equal "pending", response.parsed_body.dig("ticket", "status")
+    assert_equal 3, ticket.comments.reload.count
+
+    patch "/api/v1/requests/#{ticket.id}",
+          params: { request: { comment: { body: "It still fails." } } },
+          headers: authenticated_headers(customer_token),
+          as: :json
+
+    assert_response :success
+    assert_equal "open", response.parsed_body.dig("request", "status")
+
+    patch "/api/v1/requests/#{ticket.id}",
+          params: { request: { comment: { body: "Thanks, that fixed it." }, status: "solved" } },
+          headers: authenticated_headers(customer_token),
+          as: :json
+
+    assert_response :success
+    assert_equal "solved", response.parsed_body.dig("request", "status")
+
+    patch "/api/v1/requests/#{ticket.id}",
+          params: { request: { comment: { body: "A follow-up question." } } },
+          headers: authenticated_headers(customer_token),
+          as: :json
+
+    assert_response :success
+    assert_equal "open", response.parsed_body.dig("request", "status")
+
+    patch "/api/v1/requests/#{ticket.id}",
+          params: { request: { status: "pending" } },
+          headers: authenticated_headers(customer_token),
+          as: :json
+    assert_response :unprocessable_entity
+
+    patch path,
+          params: { ticket: { status: "solved" } },
+          headers: authenticated_headers(owner_token),
+          as: :json
+    assert_response :success
+    assert_equal "solved", ticket.reload.status
+
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "lists paginate and order by activity while comments are oldest first" do
+    customer = create_customer("Avery", "avery@example.test")
+    customer_token = issue_session(customer)
+    owner_token = issue_session(@owner)
+    older = create_ticket(customer, subject: "Older")
+    recent = create_ticket(customer, subject: "Recent")
+    older.update_columns(updated_at: 2.hours.ago)
+    recent.update_columns(updated_at: 1.hour.ago)
+
+    get "/api/v1/requests?page=1&per_page=1", headers: authenticated_headers(customer_token)
+    assert_response :success
+    assert_equal [recent.id], response.parsed_body.fetch("requests").pluck("id")
+    assert_pagination response.parsed_body, count: 2, page: 1, per_page: 1, next_page: 2
+
+    get "/api/v1/requests?page=2&per_page=1", headers: authenticated_headers(customer_token)
+    assert_response :success
+    assert_equal [older.id], response.parsed_body.fetch("requests").pluck("id")
+    assert_pagination response.parsed_body, count: 2, page: 2, per_page: 1, previous_page: 1
+
+    recent.comments.create!(author: @owner, body: "Reply")
+    comments_path = "/api/v1/tickets/#{recent.id}/comments?per_page=1&page=1"
+    get comments_path, headers: authenticated_headers(owner_token)
+    assert_response :success
+    assert_equal "Initial comment", response.parsed_body.fetch("comments").first.fetch("body")
+    assert_pagination response.parsed_body, count: 2, page: 1, per_page: 1, next_page: 2
+
+    get "/api/v1/requests?page=0", headers: authenticated_headers(customer_token)
+    assert_response :bad_request
+  end
+
+  private
+
+  def create_customer(name, email)
+    @account.users.create!(
+      name: name,
+      email: email,
+      password: "customer-password",
+      role: :customer,
+      verified_at: Time.current
+    )
+  end
+
+  def create_ticket(customer, subject: "Cannot download my receipt")
+    ticket = @account.tickets.create!(requester: customer, subject: subject)
+    ticket.comments.create!(author: customer, body: "Initial comment")
+    ticket
+  end
+
+  def issue_session(user)
+    _session, token = Session.issue!(user)
+    token
+  end
+
+  def account_header
+    { "X-Helpdesk-Account" => @account.subdomain }
+  end
+
+  def authenticated_headers(token)
+    account_header.merge("Authorization" => "Bearer #{token}")
+  end
+
+  def token_from(mail)
+    url = mail.text_part.body.decoded.lines.find { |line| line.include?("?account=") }.to_s.strip
+    URI.decode_www_form(URI.parse(url).query).to_h.fetch("token")
+  end
+
+  def assert_pagination(body, count:, page:, per_page:, next_page: nil, previous_page: nil)
+    assert_equal count, body.fetch("count")
+    assert_equal page, body.fetch("page")
+    assert_equal per_page, body.fetch("per_page")
+    if next_page.nil?
+      assert_nil body.fetch("next_page")
+    else
+      assert_equal next_page, body.fetch("next_page")
+    end
+
+    if previous_page.nil?
+      assert_nil body.fetch("previous_page")
+    else
+      assert_equal previous_page, body.fetch("previous_page")
+    end
+  end
+end
