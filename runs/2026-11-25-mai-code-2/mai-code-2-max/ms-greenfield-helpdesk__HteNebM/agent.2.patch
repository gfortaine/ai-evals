@@ -0,0 +1,23 @@
+module Api
+  module V1
+    class RegistrationsController < BaseController
+      before_action :set_current_account
+      before_action :require_active_account
+
+      def create
+        attributes = params.require(:user).permit(:name, :email, :password)
+        user = nil
+        verification_token = nil
+
+        Account.transaction do
+          user = current_account.users.create!(attributes.merge(role: :customer))
+          verification_token = EmailVerification.issue!(user)
+        end
+
+        HelpdeskMailer.email_verification(user, verification_token).deliver_now
+
+        render json: { user: user_json(user) }, status: :created
+      end
+    end
+  end
+end
