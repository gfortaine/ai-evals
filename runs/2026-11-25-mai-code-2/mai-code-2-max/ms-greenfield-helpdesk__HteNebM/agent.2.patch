--- /dev/null
+++ b/app/serializers/api/v1/ticket_serializer.rb
@@ -0,0 +1,35 @@
+module Api
+  module V1
+    class TicketSerializer
+      def initialize(ticket, include_requester: false)
+        @ticket = ticket
+        @include_requester = include_requester
+      end
+
+      def as_json
+        record = {
+          id: ticket.id,
+          subject: ticket.subject,
+          status: ticket.status,
+          requester_id: ticket.requester_id,
+          created_at: ticket.created_at.iso8601(3),
+          updated_at: ticket.updated_at.iso8601(3)
+        }
+
+        if include_requester
+          record[:requester] = {
+            id: ticket.requester.id,
+            name: ticket.requester.name,
+            email: ticket.requester.email
+          }
+        end
+
+        record
+      end
+
+      private
+
+      attr_reader :ticket, :include_requester
+    end
+  end
+end
