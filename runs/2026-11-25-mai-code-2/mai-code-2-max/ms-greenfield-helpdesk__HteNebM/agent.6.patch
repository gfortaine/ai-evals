diff --git a/test/integration/group_management_api_test.rb b/test/integration/group_management_api_test.rb
new file mode 100644
index 0000000..fee6d88
--- /dev/null
+++ b/test/integration/group_management_api_test.rb
@@ -0,0 +1,324 @@
+require "test_helper"
+
+class GroupManagementApiTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme-groups")
+    @owner = create_user("Owner", "owner@acme-groups.test", :admin)
+    @account.update!(owner: @owner)
+    @agent = create_user("Agent", "agent@acme-groups.test", :agent)
+    @outsider = create_user("Other agent", "outsider@acme-groups.test", :agent)
+    @customer = create_user("Customer", "customer@acme-groups.test", :customer)
+    @owner_token = issue_session(@owner)
+    @agent_token = issue_session(@agent)
+    @outsider_token = issue_session(@outsider)
+    @customer_token = issue_session(@customer)
+  end
+
+  test "admins manage groups and staff can browse them" do
+    post "/api/v1/groups",
+         params: { group: { name: "Billing" } },
+         headers: authenticated_headers(@agent_token),
+         as: :json
+    assert_response :forbidden
+
+    post "/api/v1/groups",
+         params: { group: { name: " Billing " } },
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :created
+    billing = response.parsed_body.fetch("group")
+    assert_equal "Billing", billing.fetch("name")
+
+    post "/api/v1/groups",
+         params: { group: { name: "Technical Support" } },
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :created
+    technical = response.parsed_body.fetch("group")
+
+    get "/api/v1/groups", headers: authenticated_headers(@agent_token), as: :json
+    assert_response :success
+    assert_equal [billing.fetch("id"), technical.fetch("id")],
+                 response.parsed_body.fetch("groups").pluck("id")
+
+    get "/api/v1/groups/#{billing.fetch('id')}",
+        headers: authenticated_headers(@agent_token),
+        as: :json
+    assert_response :success
+    assert_equal "Billing", response.parsed_body.dig("group", "name")
+
+    patch "/api/v1/groups/#{billing.fetch('id')}",
+          params: { group: { name: "Accounts Receivable" } },
+          headers: authenticated_headers(@owner_token),
+          as: :json
+    assert_response :success
+    assert_equal "Accounts Receivable", response.parsed_body.dig("group", "name")
+
+    post "/api/v1/groups",
+         params: { group: { name: "accounts receivable" } },
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :unprocessable_entity
+
+    get "/api/v1/groups", headers: authenticated_headers(@customer_token), as: :json
+    assert_response :forbidden
+
+    delete "/api/v1/groups/#{billing.fetch('id')}",
+           headers: authenticated_headers(@owner_token),
+           as: :json
+    assert_response :no_content
+    refute Group.exists?(billing.fetch("id"))
+  end
+
+  test "memberships are scoped ordered filtered and retain one default" do
+    billing = @account.groups.create!(name: "Billing")
+    technical = @account.groups.create!(name: "Technical Support")
+
+    post "/api/v1/group_memberships",
+         params: { group_membership: { group_id: billing.id, user_id: @agent.id } },
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :created
+    billing_membership = response.parsed_body.fetch("group_membership")
+    assert billing_membership.fetch("default")
+
+    post "/api/v1/group_memberships",
+         params: { group_membership: { group_id: technical.id, user_id: @agent.id, default: true } },
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :created
+    technical_membership = response.parsed_body.fetch("group_membership")
+    refute GroupMembership.find(billing_membership.fetch("id")).default?
+    assert technical_membership.fetch("default")
+
+    post "/api/v1/group_memberships",
+         params: { group_membership: { group_id: billing.id, user_id: @agent.id } },
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/group_memberships",
+         params: { group_membership: { group_id: billing.id, user_id: @customer.id } },
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :unprocessable_entity
+
+    get "/api/v1/group_memberships",
+        headers: authenticated_headers(@agent_token),
+        as: :json
+    assert_response :success
+    assert_equal [billing_membership.fetch("id"), technical_membership.fetch("id")],
+                 response.parsed_body.fetch("group_memberships").pluck("id")
+
+    get "/api/v1/group_memberships?group_id=#{billing.id}",
+        headers: authenticated_headers(@agent_token),
+        as: :json
+    assert_response :success
+    assert_equal [billing_membership.fetch("id")],
+                 response.parsed_body.fetch("group_memberships").pluck("id")
+
+    get "/api/v1/group_memberships?user_id=#{@agent.id}",
+        headers: authenticated_headers(@agent_token),
+        as: :json
+    assert_equal 2, response.parsed_body.fetch("group_memberships").length
+
+    get "/api/v1/group_memberships/#{billing_membership.fetch('id')}",
+        headers: authenticated_headers(@agent_token),
+        as: :json
+    assert_response :success
+    assert_equal billing.id, response.parsed_body.dig("group_membership", "group", "id")
+
+    post "/api/v1/group_memberships",
+         params: { group_membership: { group_id: billing.id, user_id: @outsider.id } },
+         headers: authenticated_headers(@agent_token),
+         as: :json
+    assert_response :forbidden
+
+    put "/api/v1/group_memberships/#{billing_membership.fetch('id')}/make_default",
+        headers: authenticated_headers(@owner_token),
+        as: :json
+    assert_response :success
+    assert response.parsed_body.dig("group_membership", "default")
+    refute GroupMembership.find(technical_membership.fetch("id")).default?
+
+    delete "/api/v1/group_memberships/#{billing_membership.fetch('id')}",
+           headers: authenticated_headers(@owner_token),
+           as: :json
+    assert_response :no_content
+    assert GroupMembership.find(technical_membership.fetch("id")).default?
+
+    patch "/api/v1/users/#{@agent.id}",
+          params: { user: { suspended: true } },
+          headers: authenticated_headers(@owner_token),
+          as: :json
+    assert_response :success
+    assert GroupMembership.exists?(technical_membership.fetch("id"))
+
+    outsider_billing = GroupMembership.create!(group: billing, user: @outsider)
+    outsider_technical = GroupMembership.create!(group: technical, user: @outsider)
+    assert outsider_billing.default?
+    refute outsider_technical.default?
+
+    delete "/api/v1/groups/#{billing.id}",
+           headers: authenticated_headers(@owner_token),
+           as: :json
+    assert_response :no_content
+    assert outsider_technical.reload.default?
+  end
+
+  test "ticket groups follow membership and assignment transitions" do
+    billing = @account.groups.create!(name: "Billing")
+    technical = @account.groups.create!(name: "Technical Support")
+    billing_membership = GroupMembership.create!(group: billing, user: @agent)
+    technical_membership = GroupMembership.create!(group: technical, user: @agent)
+    ticket = @account.tickets.create!(requester: @customer, subject: "Payment issue")
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { assignee_id: @agent.id } },
+          headers: authenticated_headers(@outsider_token),
+          as: :json
+    assert_response :success
+    assert_equal @agent.id, ticket.reload.assignee_id
+    assert_equal billing.id, ticket.group_id
+    assert_equal({ "id" => billing.id, "name" => billing.name }, response.parsed_body.dig("ticket", "group"))
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { group_id: technical.id } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+    assert_equal @agent.id, ticket.reload.assignee_id
+    assert_equal technical.id, ticket.group_id
+
+    delete "/api/v1/group_memberships/#{technical_membership.id}",
+           headers: authenticated_headers(@owner_token),
+           as: :json
+    assert_response :no_content
+    assert_nil ticket.reload.assignee_id
+    assert_equal technical.id, ticket.group_id
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { assignee_id: @agent.id } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :unprocessable_entity
+    assert_nil ticket.reload.assignee_id
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { group_id: nil } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+    assert_nil ticket.reload.group_id
+    assert_nil ticket.assignee_id
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { assignee_id: @agent.id } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+    assert_equal billing.id, ticket.reload.group_id
+    assert_equal @agent.id, ticket.assignee_id
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { assignee_id: nil } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+    assert_nil ticket.reload.assignee_id
+    assert_equal billing.id, ticket.group_id
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { assignee_id: @agent.id } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { group_id: nil } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+    assert_nil ticket.reload.group_id
+    assert_nil ticket.assignee_id
+
+    GroupMembership.create!(group: billing, user: @outsider)
+    moved_away = @account.tickets.create!(
+      requester: @customer,
+      subject: "Only billing",
+      group: billing,
+      assignee: @outsider
+    )
+    patch "/api/v1/tickets/#{moved_away.id}",
+          params: { ticket: { group_id: technical.id } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+    assert_equal technical.id, moved_away.reload.group_id
+    assert_nil moved_away.assignee_id
+
+    legacy_ungrouped = @account.tickets.create!(
+      requester: @customer,
+      subject: "Legacy ungrouped assignment",
+      assignee: @owner
+    )
+    patch "/api/v1/tickets/#{legacy_ungrouped.id}",
+          params: { ticket: { group_id: nil } },
+          headers: authenticated_headers(@agent_token),
+          as: :json
+    assert_response :success
+    assert_nil legacy_ungrouped.reload.assignee_id
+
+    assigned_elsewhere = @account.tickets.create!(
+      requester: @customer,
+      subject: "Billing ticket",
+      group: billing,
+      assignee: @agent
+    )
+    ungrouped = @account.tickets.create!(requester: @customer, subject: "Ungrouped ticket")
+
+    get "/api/v1/tickets?group_id=#{billing.id}",
+        headers: authenticated_headers(@outsider_token),
+        as: :json
+    assert_response :success
+    assert_equal [assigned_elsewhere.id], response.parsed_body.fetch("tickets").pluck("id")
+
+    get "/api/v1/tickets?group_id=unassigned",
+        headers: authenticated_headers(@outsider_token),
+        as: :json
+    assert_response :success
+    assert_includes response.parsed_body.fetch("tickets").pluck("id"), ungrouped.id
+
+    delete "/api/v1/groups/#{billing.id}",
+           headers: authenticated_headers(@owner_token),
+           as: :json
+    assert_response :no_content
+    assert_nil assigned_elsewhere.reload.group_id
+    assert_nil assigned_elsewhere.assignee_id
+    refute GroupMembership.exists?(billing_membership.id)
+  end
+
+  private
+
+  def create_user(name, email, role)
+    @account.users.create!(
+      name: name,
+      email: email,
+      password: "valid-password",
+      role: role,
+      verified_at: Time.current
+    )
+  end
+
+  def issue_session(user)
+    _session, token = Session.issue!(user)
+    token
+  end
+
+  def authenticated_headers(token)
+    {
+      "X-Helpdesk-Account" => @account.subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+end
