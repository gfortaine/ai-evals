diff --git a/test/integration/team_management_api_test.rb b/test/integration/team_management_api_test.rb
new file mode 100644
index 0000000..1f7a93c
--- /dev/null
+++ b/test/integration/team_management_api_test.rb
@@ -0,0 +1,274 @@
+require "test_helper"
+require "uri"
+
+class TeamManagementApiTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @account = Account.create!(name: "Acme", subdomain: "acme-team")
+    @owner = create_user("Owner", "owner@acme.test", :admin)
+    @account.update!(owner: @owner)
+    @owner_token = issue_session(@owner)
+  end
+
+  test "admins invite and accept staff without another verification email" do
+    post "/api/v1/invitations",
+         params: { invitation: { email: " Sam@Example.Test ", role: "agent" } },
+         headers: authenticated_headers(@owner_token),
+         as: :json
+
+    assert_response :created
+    invitation = response.parsed_body.fetch("invitation")
+    assert_equal "sam@example.test", invitation.fetch("email")
+    assert_equal "agent", invitation.fetch("role")
+    assert_equal "pending", invitation.fetch("status")
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    token = token_from(ActionMailer::Base.deliveries.last)
+    url = invitation_url(ActionMailer::Base.deliveries.last)
+    assert_equal "/accept-invitation", url.path
+    assert_equal @account.subdomain, URI.decode_www_form(url.query).to_h.fetch("account")
+
+    post "/api/v1/invitations",
+         params: { invitation: { email: "sam@example.test", role: "admin" } },
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/registrations",
+         params: {
+           user: {
+             email: "sam@example.test",
+             name: "Not staff",
+             password: "customer-password"
+           }
+         },
+         headers: account_header,
+         as: :json
+    assert_response :unprocessable_entity
+
+    post "/invitation_previews",
+         params: { invitation_preview: { token: token } },
+         as: :json
+    assert_response :success
+    preview = response.parsed_body.fetch("invitation_preview")
+    assert_equal "sam@example.test", preview.fetch("email")
+    assert_equal "agent", preview.fetch("role")
+    assert_equal @account.name, preview.dig("account", "name")
+    assert_equal @account.subdomain, preview.dig("account", "subdomain")
+    assert preview.fetch("expires_at").present?
+
+    deliveries_before_acceptance = ActionMailer::Base.deliveries.size
+    post "/api/v1/invitation_acceptances",
+         params: {
+           invitation_acceptance: {
+             token: token,
+             name: "Sam",
+             password: "team-member-password"
+           }
+         },
+         headers: account_header,
+         as: :json
+    assert_response :created
+    assert_equal true, response.parsed_body.dig("user", "verified")
+    assert_equal "agent", response.parsed_body.dig("user", "role")
+    assert_equal @account.subdomain, response.parsed_body.dig("account", "subdomain")
+    assert_equal deliveries_before_acceptance, ActionMailer::Base.deliveries.size
+    assert_equal "accepted", Invitation.find(invitation.fetch("id")).reload.status
+
+    post "/api/v1/sessions",
+         params: {
+           session: { email: "sam@example.test", password: "team-member-password" }
+         },
+         headers: account_header,
+         as: :json
+    assert_response :success
+  end
+
+  test "invitations are filtered ordered resent revoked and expired" do
+    first = post_invitation("one@example.test", "agent").fetch("id")
+    second = post_invitation("two@example.test", "admin").fetch("id")
+    first_token = token_from(ActionMailer::Base.deliveries[-2])
+
+    get "/api/v1/invitations?status=pending",
+        headers: authenticated_headers(@owner_token),
+        as: :json
+    assert_response :success
+    assert_equal [first, second], response.parsed_body.fetch("invitations").pluck("id")
+
+    post "/api/v1/invitations/#{first}/resend",
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :success
+    refreshed_token = token_from(ActionMailer::Base.deliveries.last)
+    refute_equal first_token, refreshed_token
+    post "/api/v1/invitation_previews",
+         params: { invitation_preview: { token: first_token } },
+         headers: account_header,
+         as: :json
+    assert_response :unprocessable_entity
+
+    delete "/api/v1/invitations/#{first}",
+           headers: authenticated_headers(@owner_token),
+           as: :json
+    assert_response :success
+    assert_equal "revoked", response.parsed_body.dig("invitation", "status")
+
+    Invitation.find(second).update!(expires_at: 1.second.ago)
+    get "/api/v1/invitations?status=expired",
+        headers: authenticated_headers(@owner_token),
+        as: :json
+    assert_response :success
+    assert_equal [second], response.parsed_body.fetch("invitations").pluck("id")
+    assert_equal "expired", Invitation.find(second).reload.status
+
+    post "/api/v1/invitations/#{second}/resend",
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :success
+    assert_equal "pending", response.parsed_body.dig("invitation", "status")
+  end
+
+  test "admins manage suspension without removing the last active admin" do
+    second_admin = create_user("Second admin", "second-admin@acme.test", :admin)
+    agent = create_user("Agent", "agent@acme.test", :agent)
+    customer = create_user("Customer", "customer@acme.test", :customer)
+    second_admin_token = issue_session(second_admin)
+    agent_token = issue_session(agent)
+    ticket = @account.tickets.create!(requester: customer, subject: "Help", assignee: agent)
+
+    get "/api/v1/users?role=agent&suspended=false",
+        headers: authenticated_headers(@owner_token),
+        as: :json
+    assert_response :success
+    assert_equal [agent.id], response.parsed_body.fetch("users").pluck("id")
+
+    get "/api/v1/staff", headers: authenticated_headers(agent_token), as: :json
+    assert_response :success
+    assert_equal [@owner.id, second_admin.id, agent.id].sort, response.parsed_body.fetch("staff").pluck("id")
+
+    patch "/api/v1/users/#{agent.id}",
+          params: { user: { suspended: true } },
+          headers: authenticated_headers(@owner_token),
+          as: :json
+    assert_response :success
+    assert_equal true, response.parsed_body.dig("user", "suspended")
+    assert_equal 0, agent.sessions.count
+    assert_nil ticket.reload.assignee_id
+
+    get "/api/v1/tickets", headers: authenticated_headers(agent_token), as: :json
+    assert_response :unauthorized
+
+    patch "/api/v1/users/#{@owner.id}",
+          params: { user: { suspended: true } },
+          headers: authenticated_headers(second_admin_token),
+          as: :json
+    assert_response :success
+
+    patch "/api/v1/users/#{second_admin.id}",
+          params: { user: { suspended: true } },
+          headers: authenticated_headers(second_admin_token),
+          as: :json
+    assert_response :unprocessable_entity
+  end
+
+  test "agents assign tickets and private notes stay out of customer activity" do
+    agent = create_user("Agent", "ticket-agent@acme.test", :agent)
+    customer = create_user("Customer", "ticket-customer@acme.test", :customer)
+    agent_token = issue_session(agent)
+    customer_token = issue_session(customer)
+    ticket = @account.tickets.create!(requester: customer, subject: "Invoice")
+    ticket.comments.create!(author: customer, body: "Please help")
+    get "/api/v1/requests/#{ticket.id}", headers: authenticated_headers(customer_token), as: :json
+    assert_response :success
+    customer_request_before = response.parsed_body.fetch("request")
+    previous_updated_at = ticket.reload.updated_at
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { assignee_id: agent.id } },
+          headers: authenticated_headers(agent_token),
+          as: :json
+    assert_response :success
+    assert_equal agent.id, response.parsed_body.dig("ticket", "assignee_id")
+    assert_equal({ "id" => agent.id, "name" => agent.name }, response.parsed_body.dig("ticket", "assignee"))
+    assert_equal previous_updated_at, ticket.reload.updated_at
+    previous_updated_at = ticket.updated_at
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: {
+            ticket: {
+              comment: { body: "Checking this with billing.", public: false }
+            }
+          },
+          headers: authenticated_headers(agent_token),
+          as: :json
+    assert_response :success
+    assert_equal previous_updated_at, ticket.reload.updated_at
+    assert_equal "open", ticket.status
+
+    get "/api/v1/requests/#{ticket.id}", headers: authenticated_headers(customer_token), as: :json
+    assert_response :success
+    assert_equal customer_request_before, response.parsed_body.fetch("request")
+
+    get "/api/v1/tickets/#{ticket.id}/comments",
+        headers: authenticated_headers(agent_token),
+        as: :json
+    assert_response :success
+    assert_includes response.parsed_body.fetch("comments").map { |comment| comment.fetch("body") },
+                    "Checking this with billing."
+
+    get "/api/v1/requests/#{ticket.id}/comments",
+        headers: authenticated_headers(customer_token),
+        as: :json
+    assert_response :success
+    assert_equal ["Please help"], response.parsed_body.fetch("comments").map { |comment| comment.fetch("body") }
+
+    patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { assignee_id: nil } },
+          headers: authenticated_headers(agent_token),
+          as: :json
+    assert_response :success
+    assert_nil response.parsed_body.dig("ticket", "assignee_id")
+  end
+
+  private
+
+  def create_user(name, email, role)
+    @account.users.create!(
+      name: name,
+      email: email,
+      password: "valid-password",
+      role: role,
+      verified_at: Time.current
+    )
+  end
+
+  def issue_session(user)
+    _session, token = Session.issue!(user)
+    token
+  end
+
+  def post_invitation(email, role)
+    post "/api/v1/invitations",
+         params: { invitation: { email: email, role: role } },
+         headers: authenticated_headers(@owner_token),
+         as: :json
+    assert_response :created
+    response.parsed_body.fetch("invitation")
+  end
+
+  def account_header
+    { "X-Helpdesk-Account" => @account.subdomain }
+  end
+
+  def authenticated_headers(token)
+    account_header.merge("Authorization" => "Bearer #{token}")
+  end
+
+  def token_from(mail)
+    URI.decode_www_form(invitation_url(mail).query).to_h.fetch("token")
+  end
+
+  def invitation_url(mail)
+    value = mail.text_part.body.decoded.lines.find { |line| line.include?("?account=") }.to_s.strip
+    URI.parse(value)
+  end
+end
