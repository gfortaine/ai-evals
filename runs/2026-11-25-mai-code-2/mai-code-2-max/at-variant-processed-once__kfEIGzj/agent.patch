@@ -86,6 +86,38 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
     assert_select "figure img[src*=\"pixel.bmp\"]"
   end
 
+  test "show a preprocessed picture without transforming it again" do
+    picture = pictures(:reading)
+    transformations = Picture.reflect_on_attachment(:image).named_variants.fetch(:large).transformations
+
+    perform_enqueued_jobs do
+      ActiveStorage::CreateVariantsJob.perform_later picture.image.blob,
+        variants: [ transformations ], process: :later
+    end
+
+    expected_bytes = picture.large_image.download
+    assert_equal 1, picture.image.blob.variant_records.count
+
+    books(:handbook).update! published: true
+    sign_out
+    transformations_performed = 0
+
+    ActiveSupport::Notifications.subscribed(->(*) { transformations_performed += 1 }, "transform.active_storage") do
+      get leafable_slug_path(leaves(:reading_picture))
+      assert_response :success
+
+      get css_select("figure img").first["src"]
+      assert_response :redirect
+
+      follow_redirect!
+      assert_response :success
+      assert_equal expected_bytes, response.body
+    end
+
+    assert_equal 0, transformations_performed
+    assert_equal 1, picture.image.blob.variant_records.reload.count
+  end
+
