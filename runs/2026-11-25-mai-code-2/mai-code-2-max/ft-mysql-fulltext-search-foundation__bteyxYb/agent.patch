+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,26 @@
+<li>
+  <article class="search-result" id="<%= dom_id(card, :search_result) %>" data-card-number="<%= card.number %>">
+    <%= link_to card_path(card), class: "search-result__link" do %>
+      <div class="search-result__board txt-x-small txt-uppercase">
+        <span class="overflow-ellipsis"><%= card.board.name %></span>
+        <span>Card <%= card.number %></span>
+      </div>
+
+      <h3 class="search-result__title">
+        <%= highlighted_search_text card.title, @search.terms %>
+      </h3>
+
+      <% @search.matches_for(card).each do |match| %>
+        <p class="search-result__match">
+          <strong><%= match.kind.to_s.humanize %></strong>
+          <%= highlighted_search_excerpt match.text, @search.terms %>
+        </p>
+      <% end %>
+
+      <div class="search-result__meta txt-x-small">
+        Added by <%= card.creator.familiar_name %>
+        <%= local_datetime_tag card.created_at, style: :daysago %>
+      </div>
+    <% end %>
+  </article>
+</li>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..2a64e8d
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,41 @@
+<% @page_title = @search.query.present? ? "Search: #{@search.query}" : "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get, class: "search__form", role: "search" do %>
+    <%= label_tag :q, "Search cards", class: "for-screen-reader" %>
+    <%= search_field_tag :q, @search.query,
+          class: "input search__input",
+          placeholder: "Search card titles, descriptions, and comments",
+          autofocus: @search.query.blank?,
+          autocomplete: "off",
+          autocorrect: "off" %>
+    <%= button_tag class: "btn btn--reversed search__submit", type: :submit, aria: { label: "Search" } do %>
+      <%= icon_tag "search" %>
+      <span>Search</span>
+    <% end %>
+  <% end %>
+
+  <% if @search.terms.any? %>
+    <h2 class="search__heading">
+      <%= pluralize @page.recordset.records_count, "card" %> matching <q><%= @search.query %></q>
+    </h2>
+
+    <% if @cards.any? %>
+      <%= with_automatic_pagination :search_results, @page do %>
+        <ol class="search__results">
+          <%= render partial: "searches/result", collection: @cards, as: :card %>
+        </ol>
+      <% end %>
+    <% else %>
+      <p class="search__blank">No cards found.</p>
+    <% end %>
+  <% else %>
+    <p class="search__blank">Search titles, descriptions, and comments on cards from boards you can access.</p>
+  <% end %>
+</section>
