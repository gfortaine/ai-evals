+  .search__heading {
+    font-size: var(--text-medium);
+    font-weight: 700;
+    margin-block: var(--block-space-double) var(--block-space);
+  }
+
+  .search__results {
+    display: grid;
+    gap: var(--block-space);
+    list-style: none;
+    margin: 0;
+    padding: 0;
+  }
+
+  .search-result {
+    background: var(--color-canvas);
+    border: var(--border);
+    border-radius: 0.4em;
+    box-shadow: var(--shadow);
+  }
+
+  .search-result__link {
+    color: inherit;
+    display: block;
+    padding: var(--block-space) var(--inline-space-double);
+  }
+
+  .search-result__board {
+    display: flex;
+    gap: var(--inline-space-double);
+    justify-content: space-between;
+  }
+
+  .search-result__title {
+    font-size: var(--text-x-large);
+    font-weight: 900;
+    line-height: 1.15;
+    margin-block: var(--block-space-half);
+  }
+
+  .search-result__match {
+    display: flex;
+    gap: var(--inline-space);
+    line-height: 1.45;
+    margin-block: var(--block-space-half);
+  }
+
+  .search-result__match strong {
+    color: var(--color-ink-dark);
+    flex: 0 0 8ch;
+    font-size: var(--text-x-small);
+    padding-block-start: 0.3em;
+    text-transform: uppercase;
+  }
+
+  .search-result__meta {
+    color: var(--color-ink-dark);
+    display: flex;
+    gap: var(--inline-space-half);
+    margin-block-start: var(--block-space);
+  }
