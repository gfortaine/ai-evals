diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..5e938d3
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.session = sessions(:kevin)
+  end
+
+  test "searches card titles descriptions and comments newest first" do
+    title_match = create_card(title: "Photon in the title", created_at: 3.hours.ago)
+    description_match = create_card(title: "Description result", description: "A photon in the description", created_at: 2.hours.ago)
+    comment_match = create_card(title: "Comment result", created_at: 1.hour.ago)
+    comment_match.comments.create!(body: "There is a photon in this comment")
+
+    get search_path(q: "photon")
+
+    assert_response :success
+    assert_select ".search-result__link", 3 do |links|
+      assert_equal [ comment_match, description_match, title_match ].map { card_path(it) }, links.map { it["href"] }
+    end
+    assert_select ".search-result mark", text: /photon/i, count: 3
+  end
+
+  test "only searches accessible published cards" do
+    create_card(title: "Visible hidden-orchid", created_at: 1.hour.ago)
+    create_card(board: boards(:private), title: "Private hidden-orchid", creator: users(:kevin))
+    create_card(title: "Draft hidden-orchid", status: :drafted)
+
+    draft_with_comment = create_card(title: "Draft with a comment", created_at: 2.hours.ago)
+    draft_with_comment.comments.create!(body: "A hidden-orchid in a draft card")
+    draft_with_comment.update_column(:status, "drafted")
+
+    logout_and_sign_in_as :david
+    get search_path(q: "hidden-orchid")
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__title", text: /Visible hidden-orchid/
+  end
+
+  test "search treats LIKE metacharacters literally" do
+    literal_match = create_card(title: "100% ready")
+    create_card(title: "1000 ready")
+
+    get search_path(q: "%")
+
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__link[href=?]", card_path(literal_match)
+    assert_select "mark", text: "%"
+  end
+
+  test "escapes highlighted matches" do
+    create_card(title: "Try <script> carefully")
+
+    get search_path(q: "<script>")
+
+    assert_response :success
+    assert_select ".search-result mark", text: "<script>"
+    assert_select ".search-result script", count: 0
+  end
+
+  test "does not reuse a response ETag for a different query" do
+    create_card(title: "Copper result")
+    create_card(title: "Silver result")
+
+    get search_path(q: "Copper")
+    etag = response.headers["ETag"]
+    get search_path(q: "Silver"), headers: { "If-None-Match" => etag }
+
+    assert_response :success
+    assert_select ".search-result__title", text: /Silver result/
+  end
+
+  private
+    def create_card(title:, board: boards(:writebook), creator: users(:kevin), **attributes)
+      board.cards.create!({ title: title, creator: creator, status: :published }.merge(attributes))
+    end
+end
