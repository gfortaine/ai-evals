+class SearchesController < ApplicationController
+  def show
+    @search = Card::Search.new(user: Current.user, query: params[:q])
+    @cards = set_page_and_extract_portion_from @search.cards.preload(:board, :creator, :rich_text_description)
+    @search.load_matches_for @cards
+    fresh_when etag: [ @search.query, @cards ]
+  end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
