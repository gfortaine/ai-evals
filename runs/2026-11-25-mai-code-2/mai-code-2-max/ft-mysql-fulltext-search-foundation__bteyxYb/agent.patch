index 0000000..d4a2415
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,21 @@
+module SearchesHelper
+  def highlighted_search_text(text, terms)
+    highlight ERB::Util.html_escape(text.to_s), terms.map { ERB::Util.html_escape(it) },
+      highlighter: '<mark>\1</mark>', sanitize: false
+  end
+
+  def highlighted_search_excerpt(text, terms, radius: 100)
+    excerpt = text.to_s.gsub(/\s+/, " ").strip
+    position = terms.filter_map { |term| excerpt.downcase.index(term.downcase) }.min
+
+    if position
+      start = [ position - radius, 0 ].max
+      finish = [ start + (radius * 2), excerpt.length ].min
+      prefix = start.positive? ? "..." : ""
+      suffix = finish < excerpt.length ? "..." : ""
+      excerpt = "#{prefix}#{excerpt[start...finish]}#{suffix}"
+    end
+
+    highlighted_search_text excerpt, terms
+  end
+end
diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..7f38be9
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,92 @@
+class Card::Search
+  MAX_COMMENT_MATCHES = 3
+
+  Match = Data.define(:kind, :text)
+
+  attr_reader :query, :terms
+
+  def initialize(user:, query:)
+    @user = user
+    @query = query.to_s.squish
+    @terms = @query.split.uniq { it.downcase }
+    @comment_matches = {}
+  end
+
+  def cards
+    @cards ||= if terms.empty?
+      Card.none
+    else
+      terms.reduce(searchable_cards) { |cards, term| cards.where(matches_term_sql, term, description_matches(term), comment_matches(term)) }
+        .reverse_chronologically
+    end
+  end
+
+  def load_matches_for(cards)
+    @comment_matches = matching_comments(cards.map(&:id)).group_by(&:card_id)
+  end
+
+  def matches_for(card)
+    description = card.description.to_plain_text
+
+    matches = []
+    matches << Match.new(kind: :description, text: description) if matches_any_term?(description)
+
+    @comment_matches.fetch(card.id, []).first(MAX_COMMENT_MATCHES).each do |comment|
+      text = comment.body.to_plain_text
+      matches << Match.new(kind: :comment, text: text) if matches_any_term?(text)
+    end
+
+    matches
+  end
+
+  private
+    def searchable_cards
+      @user.accessible_cards.published
+    end
+
+    def matches_term_sql
+      <<~SQL.squish
+        INSTR(LOWER(cards.title), LOWER(?)) > 0
+        OR cards.id IN (?)
+        OR cards.id IN (?)
+      SQL
+    end
+
+    def description_matches(term)
+      matching_rich_texts(term)
+        .where(record_type: "Card", name: "description")
+        .select(:record_id)
+    end
+
+    def comment_matches(term)
+      Comment
+        .where(account_id: @user.account_id, id: matching_rich_texts(term).where(record_type: "Comment", name: "body").select(:record_id))
+        .select(:card_id)
+    end
+
+    def matching_rich_texts(term)
+      ActionText::RichText
+        .where(account_id: @user.account_id)
+        .where("INSTR(LOWER(action_text_rich_texts.body), LOWER(?)) > 0", term)
+    end
+
+    def matching_comments(card_ids)
+      if card_ids.any? && terms.any?
+        comments = Comment
+          .where(account_id: @user.account_id, card_id: card_ids)
+          .joins(:rich_text_body)
+          .preload(:rich_text_body)
+
+        terms
+          .map { |term| comments.where("INSTR(LOWER(action_text_rich_texts.body), LOWER(?)) > 0", term) }
+          .reduce { |matches, term_matches| matches.or(term_matches) }
+          .order(created_at: :desc, id: :desc)
+      else
+        Comment.none
+      end
+    end
+
+    def matches_any_term?(text)
+      terms.any? { |term| text.downcase.include?(term.downcase) }
+    end
+end
