@@ -0,0 +1,18 @@
+require "test_helper"
+
+class UserMailerTest < ActionMailer::TestCase
+  test "notification bundle includes all notifications in one email" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: :daily)
+    bundle = Notification::Bundle.capture(notifications(:logo_assignment_kevin))
+    bundle.add(notifications(:layout_commented_kevin))
+
+    email = UserMailer.notification_bundle(bundle)
+
+    assert_equal [ user.identity.email_address ], email.to
+    assert_equal "2 new notifications in #{user.account.name}", email.subject
+    assert_match(/logo/i, email.html_part.body.decoded)
+    assert_match "Layout is broken", email.html_part.body.decoded
+    assert_match %r{/notifications/settings}, email.text_part.body.decoded
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
