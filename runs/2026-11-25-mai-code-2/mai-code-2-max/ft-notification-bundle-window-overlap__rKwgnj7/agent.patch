diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..07dfcc5
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,108 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :memberships, class_name: "Notification::Bundle::Membership", dependent: :delete_all
+  has_many :notifications, through: :memberships
+
+  scope :pending, -> { where(pending: true) }
+  scope :open, -> { pending }
+
+  validates :starts_at, :ends_at, presence: true
+  validate :window_has_positive_length
+  validate :window_does_not_overlap_another
+  validates :pending, uniqueness: { scope: :user_id }, if: :pending?
+
+  after_create_commit :schedule_delivery
+
+  class << self
+    def capture(notification)
+      notification.user.with_lock do
+        user = notification.user
+
+        if user.active? && user.identity.present? && user.account.active? &&
+            (interval = user.settings&.bundle_email_interval)
+          open_or_create_for(user, interval).add(notification)
+        end
+      end
+    end
+
+    private
+      def open_or_create_for(user, interval)
+        user.notification_bundles.pending.lock.first || create_for(user, interval)
+      end
+
+      def create_for(user, interval)
+        starts_at = Time.current
+        user.notification_bundles.create!(starts_at: starts_at, ends_at: starts_at + interval)
+      rescue ActiveRecord::RecordNotUnique
+        user.notification_bundles.pending.first!
+      end
+  end
+
+  def add(notification)
+    memberships.find_or_create_by!(notification: notification)
+    self
+  end
+
+  def overlaps?(other)
+    user_id == other.user_id && starts_at < other.ends_at && ends_at > other.starts_at
+  end
+
+  def deliver
+    user.with_lock do
+      reload
+
+      if pending?
+        if ends_at > Time.current
+          schedule_delivery
+        else
+          close
+        end
+      end
+    end
+  end
+
+  def open?
+    pending?
+  end
+
+  private
+    def schedule_delivery
+      Notification::Bundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+    end
+
+    def close
+      update!(pending: nil, delivered_at: Time.current)
+
+      if deliverable?
+        Current.with_account(account) do
+          UserMailer.notification_bundle(self).deliver_later
+        end
+      end
+    end
+
+    def deliverable?
+      notifications.exists? &&
+        user.active? && user.identity.present? && user.account.active? &&
+        user.settings&.bundle_email_interval.present?
+    end
+
+    def window_has_positive_length
+      if starts_at && ends_at && ends_at <= starts_at
+        errors.add(:ends_at, "must be after the window starts")
+      end
+    end
+
+    def window_does_not_overlap_another
+      if starts_at && ends_at && overlapping_windows.exists?
+        errors.add(:base, "overlaps another notification window")
+      end
+    end
+
+    def overlapping_windows
+      self.class.where(user_id: user_id)
+        .where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+        .where.not(id: id)
+    end
+end
