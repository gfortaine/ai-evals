--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :daily)
+    @notifications = [ notifications(:logo_assignment_kevin), notifications(:layout_commented_kevin) ]
+    travel_to Time.utc(2026, 11, 21, 9, 0)
+  end
+
+  test "a saved notification opens its recipient's window" do
+    existing = @user.notifications.find_by!(card: cards(:logo))
+    existing.destroy!
+
+    assert_difference -> { @user.notification_bundles.count }, 1 do
+      Notification.create!(
+        user: @user,
+        source: events(:logo_assignment_km),
+        creator: users(:david)
+      )
+    end
+
+    assert_equal 1, @user.notification_bundles.last.memberships.count
+  end
+
+  test "the first notification opens a window for the selected frequency" do
+    bundle = nil
+
+    assert_difference -> { @user.notification_bundles.count }, 1 do
+      assert_enqueued_with(job: Notification::Bundle::DeliveryJob, at: 1.day.from_now) do
+        bundle = Notification::Bundle.capture(@notifications.first)
+      end
+    end
+
+    assert_equal Time.current, bundle.starts_at
+    assert_equal 1.day, bundle.ends_at - bundle.starts_at
+    assert_includes bundle.notifications, @notifications.first
+  end
+
+  test "notifications stay in the window even when they arrive after its end" do
+    bundle = Notification::Bundle.capture(@notifications.first)
+
+    travel 1.day + 1.hour
+
+    assert_no_difference -> { @user.notification_bundles.count } do
+      assert_equal bundle, Notification::Bundle.capture(@notifications.second)
+    end
+
+    assert_equal @notifications.sort_by(&:id), bundle.notifications.sort_by(&:id)
+  end
+
+  test "repeated captures do not add the same notification twice" do
+    bundle = Notification::Bundle.capture(@notifications.first)
+
+    Notification::Bundle.capture(@notifications.first)
+
+    assert_equal 1, bundle.reload.notifications.count
+    assert_equal 1, bundle.memberships.count
+  end
+
+  test "delivery is idempotent and queues one email for the window" do
+    bundle = Notification::Bundle.capture(@notifications.first)
+    bundle.add(@notifications.second)
+
+    travel_to bundle.ends_at do
+      assert_enqueued_jobs 1, only: ActionMailer::MailDeliveryJob do
+        bundle.deliver
+      end
+
+      assert_no_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        bundle.deliver
+      end
+    end
+
+    assert_equal bundle.ends_at, bundle.reload.delivered_at
+    assert_not bundle.open?
+  end
+
+  test "a delivered window is closed before the next one opens" do
+    first_bundle = Notification::Bundle.capture(@notifications.first)
+
+    travel_to first_bundle.ends_at do
+      first_bundle.deliver
+      second_bundle = Notification::Bundle.capture(@notifications.second)
+
+      assert_equal first_bundle.ends_at, second_bundle.starts_at
+      assert_not first_bundle.overlaps?(second_bundle)
+    end
+  end
+
+  test "never does not open a window" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { @user.notification_bundles.count } do
+      assert_nil Notification::Bundle.capture(@notifications.first)
+    end
+  end
+
+  test "switching to never suppresses an already open window" do
+    bundle = Notification::Bundle.capture(@notifications.first)
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    travel_to bundle.ends_at do
+      assert_no_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        bundle.deliver
+      end
+    end
+
+    assert_not bundle.reload.open?
+  end
+
+  test "inactive users do not open windows" do
+    @user.deactivate
+
+    assert_no_difference -> { @user.notification_bundles.count } do
+      assert_nil Notification::Bundle.capture(@notifications.first)
+    end
+  end
+
+  test "overlapping pending windows are invalid" do
+    Notification::Bundle.capture(@notifications.first)
+
+    duplicate = @user.notification_bundles.new(
+      starts_at: Time.current,
+      ends_at: 1.day.from_now
+    )
+
+    assert_not duplicate.valid?
+    assert duplicate.errors[:base].include?("overlaps another notification window")
+  end
+end
