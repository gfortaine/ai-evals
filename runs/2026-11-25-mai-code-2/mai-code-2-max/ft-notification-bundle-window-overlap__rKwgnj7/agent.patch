+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @settings = users(:david).settings
+  end
+
+  test "bundle email frequency is off by default" do
+    assert_equal "never", @settings.bundle_email_frequency
+    assert_nil @settings.bundle_email_interval
+  end
+
+  test "bundle email frequencies have their fixed intervals" do
+    {
+      every_few_hours: 4.hours,
+      daily: 1.day,
+      weekly: 1.week
+    }.each do |frequency, interval|
+      @settings.update!(bundle_email_frequency: frequency)
+
+      assert_equal interval, @settings.bundle_email_interval
+    end
+  end
+
+  test "bundle email frequency is restricted to supported values" do
+    @settings.bundle_email_frequency = "yearly"
+
+    assert_not @settings.valid?
+    assert @settings.errors.added?(:bundle_email_frequency, :inclusion, value: "yearly")
+  end
+end
