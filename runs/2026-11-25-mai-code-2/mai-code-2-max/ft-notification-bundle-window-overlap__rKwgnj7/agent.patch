+class Notification::Bundle::Membership < ApplicationRecord
+  belongs_to :account, default: -> { bundle.account }
+  belongs_to :bundle, class_name: "Notification::Bundle"
+  belongs_to :notification
+
+  validates :notification_id, uniqueness: { scope: :bundle_id }
+  validate :notification_belongs_to_bundle
+
+  private
+    def notification_belongs_to_bundle
+      if bundle && notification && (bundle.user_id != notification.user_id || bundle.account_id != notification.account_id)
+        errors.add(:notification, "must belong to the bundle recipient")
+      end
+    end
+end
