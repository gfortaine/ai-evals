diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..bf0310a 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,102 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "show keeps cached editor controls separate from reader controls" do
+    with_fragment_caching do |cache|
+      get book_slug_path(books(:handbook))
+      assert_editor_toc_controls
+
+      sign_out
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_reader_toc
+
+      cache.clear
+      get book_slug_path(books(:handbook))
+      assert_reader_toc
+
+      sign_out
+      sign_in :kevin
+      get book_slug_path(books(:handbook))
+      assert_editor_toc_controls
+    end
+  end
+
+  test "show expires a cached table of contents entry when its title changes" do
+    with_fragment_caching do
+      sign_out
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_in_body "Welcome to The Handbook!"
+
+      leaves(:welcome_page).update!(title: "A new welcome")
+
+      sign_out
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+
+      assert_in_body "A new welcome"
+      assert_not_in_body "Welcome to The Handbook!"
+      assert_reader_toc
+    end
+  end
+
+  test "show does not look up edit access for every table of contents entry" do
+    with_fragment_caching do
+      access_queries = count_queries_matching(/FROM "accesses"/) do
+        get book_slug_path(books(:handbook))
+      end
+
+      assert_operator access_queries, :<=, 3
+    end
+  end
+
+  private
+    def assert_editor_toc_controls
+      leaf = leaves(:welcome_page)
+
+      assert_select "a[href='#{edit_leafable_path(leaf)}']", minimum: 1
+      assert_select "form.leaf__delete[action='#{leafable_path(leaf)}']", count: 1
+      assert_select ".arrangement__handle", minimum: 1
+    end
+
+    def assert_reader_toc
+      leaf = leaves(:welcome_page)
+
+      assert_select "li##{dom_id(leaf)}", count: 1
+      assert_select "a[href='#{edit_leafable_path(leaf)}']", count: 0
+      assert_select "form.leaf__delete[action='#{leafable_path(leaf)}']", count: 0
+      assert_select ".arrangement__handle", count: 0
+      assert_select ".arrangement__container[data-controller~='arrangement']", count: 0
+    end
+
+    def count_queries_matching(pattern)
+      count = 0
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*arguments|
+        count += 1 if arguments.last[:sql].match?(pattern)
+      end
+
+      yield
+      count
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+    end
+
+    def with_fragment_caching
+      previous_perform_caching = ActionController::Base.perform_caching
+      previous_controller_cache = ActionController::Base.cache_store
+      previous_collection_cache = ActionView::PartialRenderer.collection_cache
+      cache = ActiveSupport::Cache::MemoryStore.new
+
+      ActionController::Base.perform_caching = true
+      ActionController::Base.cache_store = cache
+      ActionView::PartialRenderer.collection_cache = cache
+
+      yield cache
+    ensure
+      ActionController::Base.perform_caching = previous_perform_caching
+      ActionController::Base.cache_store = previous_controller_cache
+      ActionView::PartialRenderer.collection_cache = previous_collection_cache
+    end
 end
