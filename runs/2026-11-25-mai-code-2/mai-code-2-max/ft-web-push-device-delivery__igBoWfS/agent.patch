new file mode 100644
index 0000000..f9c8e1e
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,43 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @push_subscription.update!(push_subscription_params)
+
+    render json: { id: @push_subscription.id }, status: :created
+  end
+
+  def destroy
+    find_push_subscription&.destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def find_push_subscription
+      if params[:id]
+        @user.push_subscriptions.find(params[:id])
+      else
+        @user.push_subscriptions.find_by(endpoint: endpoint_param)
+      end
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+
+    def endpoint_param
+      params.expect(push_subscription: :endpoint)[:endpoint]
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..1244b50
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,158 @@
+import { destroy, post } from "@rails/request.js"
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "toggle", "details", "error" ]
+  static values = { subscriptionUrl: String, vapidPublicKey: String }
+
+  connect() {
+    this.#hideDetails()
+    this.#initialize().catch((error) => this.#showError(error))
+  }
+
+  async toggle() {
+    this.toggleTarget.disabled = true
+
+    try {
+      if (this.subscription) {
+        await this.#turnOff()
+      } else {
+        await this.#turnOn()
+      }
+    } catch (error) {
+      this.#showError(error)
+    } finally {
+      this.toggleTarget.disabled = false
+    }
+  }
+
+  async #initialize() {
+    if (!this.#pushIsSupported) {
+      this.#showError(new Error("Push notifications aren't supported in this browser"))
+      this.#showDetails()
+      return
+    }
+
+    if (!this.vapidPublicKeyValue) {
+      this.#showError(new Error("Push notifications aren't configured on this server"))
+      return
+    }
+
+    const registration = await navigator.serviceWorker.ready
+    this.subscription = await registration.pushManager.getSubscription()
+
+    if (this.subscription && Notification.permission === "granted") {
+      await this.#save(this.subscription)
+      this.#setOn(true)
+    } else {
+      this.#setOn(false)
+      if (Notification.permission === "denied") this.#showDetails()
+    }
+
+    this.toggleTarget.disabled = false
+  }
+
+  async #turnOn() {
+    this.#clearError()
+
+    if (Notification.permission === "default") {
+      await Notification.requestPermission()
+    }
+
+    if (Notification.permission !== "granted") {
+      this.#setOn(false)
+      this.#showDetails()
+      return
+    }
+
+    const registration = await navigator.serviceWorker.ready
+    const existingSubscription = await registration.pushManager.getSubscription()
+    const subscription = existingSubscription || await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    })
+
+    try {
+      await this.#save(subscription)
+      this.subscription = subscription
+      this.#setOn(true)
+    } catch (error) {
+      if (!existingSubscription) await subscription.unsubscribe()
+      throw error
+    }
+  }
+
+  async #turnOff() {
+    this.#clearError()
+
+    const endpoint = this.subscription.endpoint
+    if (!await this.subscription.unsubscribe()) {
+      throw new Error("This device couldn't be unsubscribed from push notifications")
+    }
+
+    this.subscription = null
+    this.#setOn(false)
+
+    const formData = new FormData()
+    formData.append("push_subscription[endpoint]", endpoint)
+
+    const response = await destroy(this.subscriptionUrlValue, { body: formData, responseKind: "json" })
+    if (!response.ok) throw new Error(`The push subscription couldn't be removed (${response.statusCode})`)
+  }
+
+  async #save(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+    if (!endpoint || !keys?.p256dh || !keys?.auth) {
+      throw new Error("The browser returned an invalid push subscription")
+    }
+
+    const formData = new FormData()
+    formData.append("push_subscription[endpoint]", endpoint)
+    formData.append("push_subscription[p256dh_key]", keys.p256dh)
+    formData.append("push_subscription[auth_key]", keys.auth)
+
+    const response = await post(this.subscriptionUrlValue, { body: formData, responseKind: "json" })
+    if (!response.ok) throw new Error(`The push subscription couldn't be saved (${response.statusCode})`)
+  }
+
+  #setOn(on) {
+    this.element.classList.toggle("notifications--on", on)
+    this.toggleTarget.setAttribute("aria-pressed", on)
+  }
+
+  #showDetails() {
+    const inPwa = matchMedia("(display-mode: standalone)").matches
+
+    this.detailsTargets.forEach((details) => {
+      details.hidden = inPwa !== details.classList.contains("hide-in-browser")
+    })
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach((details) => details.hidden = true)
+  }
+
+  #showError(error) {
+    console.error(error)
+    this.errorTarget.textContent = error.message
+    this.errorTarget.hidden = false
+  }
+
+  #clearError() {
+    this.errorTarget.textContent = ""
+    this.errorTarget.hidden = true
+  }
+
+  get #pushIsSupported() {
+    return "serviceWorker" in navigator && "Notification" in window && "PushManager" in window
+  }
+
+  get #applicationServerKey() {
+    const key = this.vapidPublicKeyValue
+    const padding = "=".repeat((4 - key.length % 4) % 4)
+    const base64 = `${key}${padding}`.replaceAll("-", "+").replaceAll("_", "/")
+    const bytes = atob(base64)
+
+    return Uint8Array.from(bytes, (character) => character.charCodeAt(0))
+  }
+}
diff --git a/app/jobs/push_subscription/deliver_job.rb b/app/jobs/push_subscription/deliver_job.rb
