diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..6cf33a6
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,45 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }
+
+  def deliver_later(notification)
+    DeliverJob.perform_later(self, notification)
+  end
+
+  def deliver(notification)
+    WebPush.payload_send(
+      message: notification_payload(notification),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: {
+        public_key: ENV["VAPID_PUBLIC_KEY"],
+        private_key: ENV["VAPID_PRIVATE_KEY"]
+      }
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy!
+  end
+
+  private
+    def notification_payload(notification)
+      tray_notification = JSON.parse ApplicationController.renderer.new(
+        script_name: account.slug,
+        https: !Rails.env.local?
+      ).render(
+        partial: "notifications/notification",
+        formats: :json,
+        locals: { notification: notification }
+      )
+
+      {
+        title: tray_notification["title"],
+        body: tray_notification["body"],
+        url: tray_notification.dig("card", "url"),
+        card: { id: tray_notification.dig("card", "id") }
+      }.to_json
+    end
+end
