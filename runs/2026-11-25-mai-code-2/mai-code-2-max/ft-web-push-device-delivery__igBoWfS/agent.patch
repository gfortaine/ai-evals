diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..d56c3ec
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:kevin).push_subscriptions.create!(
+      endpoint: "https://push.example/subscriptions/one",
+      p256dh_key: "public-key",
+      auth_key: "auth-key"
+    )
+    @notification = notifications(:layout_commented_kevin)
+  end
+
+  test "deliver sends the tray notification with its card URL" do
+    delivered = nil
+
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).with { |**options| delivered = options; true }
+      @subscription.deliver(@notification)
+    end
+
+    assert_equal @subscription.endpoint, delivered[:endpoint]
+    assert_equal @subscription.p256dh_key, delivered[:p256dh]
+    assert_equal @subscription.auth_key, delivered[:auth]
+    assert_equal "vapid-public", delivered.dig(:vapid, :public_key)
+    assert_equal "vapid-private", delivered.dig(:vapid, :private_key)
+
+    payload = JSON.parse(delivered[:message])
+    assert_equal ApplicationController.helpers.event_notification_title(@notification.source), payload["title"]
+    assert_equal ApplicationController.helpers.event_notification_body(@notification.source), payload["body"]
+    expected_path = Rails.application.routes.url_helpers.card_path(@notification.card, script_name: @notification.account.slug)
+    assert_equal expected_path, URI.parse(payload["url"]).path
+    assert_equal({ "id" => @notification.card.id }, payload["card"])
+    assert_not payload.key?("creator")
+  end
+
+  test "deliver later enqueues a delivery job" do
+    assert_enqueued_with job: PushSubscription::DeliverJob, args: [ @subscription, @notification ] do
+      @subscription.deliver_later(@notification)
+    end
+  end
+
+  test "deliver removes expired subscriptions" do
+    response = Struct.new(:body).new("expired")
+    error = WebPush::ExpiredSubscription.new(response, "push.example")
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      WebPush.stubs(:payload_send).raises(error)
+      @subscription.deliver(@notification)
+    end
+
+    assert_not PushSubscription.exists?(@subscription.id)
+  end
+
+  test "deliver removes invalid subscriptions" do
+    response = Struct.new(:body).new("not found")
+    error = WebPush::InvalidSubscription.new(response, "push.example")
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      WebPush.stubs(:payload_send).raises(error)
+      @subscription.deliver(@notification)
+    end
+  end
+
+  private
+    def with_vapid_keys
+      old_public_key = ENV["VAPID_PUBLIC_KEY"]
+      old_private_key = ENV["VAPID_PRIVATE_KEY"]
+      ENV["VAPID_PUBLIC_KEY"] = "vapid-public"
+      ENV["VAPID_PRIVATE_KEY"] = "vapid-private"
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = old_public_key
+      ENV["VAPID_PRIVATE_KEY"] = old_private_key
+    end
+end
