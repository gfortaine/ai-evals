diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..47f996c 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,61 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroy archives access after the book is deleted" do
+    book = Book.create!(title: "Private Notes", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+    book_id = book.id
+    statements = []
+
+    subscriber = ->(_name, _started, _finished, _unique_id, payload) do
+      sql = payload[:sql]
+      statements << sql if sql.include?(%(DELETE FROM "books")) || sql.include?(%(INSERT INTO "access_archives"))
+    end
+
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      book.destroy!
+    end
+
+    archives = AccessArchive.where(book_id: book_id).index_by(&:user_id)
+    assert_equal [ users(:jz).id, users(:kevin).id ].sort, archives.keys.sort
+    assert_equal "reader", archives.fetch(users(:jz).id).level
+    assert_equal "editor", archives.fetch(users(:kevin).id).level
+    assert_equal "Private Notes", archives.values.first.book_title
+    assert_equal "JZ", archives.fetch(users(:jz).id).user_name
+    assert_not Book.exists?(book_id)
+    assert_empty Access.where(book_id: book_id)
+
+    book_delete = statements.index { |sql| sql.include?(%(DELETE FROM "books")) }
+    archive_inserts = statements.each_index.select { |index| statements[index].include?(%(INSERT INTO "access_archives")) }
+    assert book_delete
+    assert_equal 2, archive_inserts.size
+    assert archive_inserts.all? { |index| index > book_delete }
+  end
+
+  test "destroy archives only accesses that still exist" do
+    book = Book.create!(title: "Changing Access", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+    book.accesses.load
+
+    book.update_access(editors: [ users(:jz).id ], readers: [])
+    book.destroy!
+
+    archive = AccessArchive.find_by!(book_id: book.id)
+    assert_equal users(:jz).id, archive.user_id
+    assert_equal users(:jz).name, archive.user_name
+    assert_equal "editor", archive.level
+    assert_equal 1, AccessArchive.where(book_id: book.id).count
+  end
+
+  test "destroy does not archive a book without accesses" do
+    book = Book.create!(title: "Unshared", everyone_access: false)
+
+    assert_no_difference -> { AccessArchive.count } do
+      Book.find(book.id).destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_empty Access.where(book_id: book.id)
+  end
 end
