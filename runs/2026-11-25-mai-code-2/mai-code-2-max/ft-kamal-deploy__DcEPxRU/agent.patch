diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..5b011c4
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,48 @@
+# This deployment runs Fizzy, SQLite, Active Storage, and Solid Queue in one
+# container on one server. Replace the host and mail values before deploying.
+x-fizzy-host: &fizzy_host fizzy.example.com
+
+minimum_version: 2.11.0
+
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - *fizzy_host
+
+proxy:
+  ssl: true
+  host: *fizzy_host
+
+# A registry on the developer's machine is sufficient. Kamal tunnels it to the
+# server while images are pulled, so no separate registry account is required.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64
+
+env:
+  clear:
+    APP_HOST: *fizzy_host
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    WEB_CONCURRENCY: "1"
+    JOB_CONCURRENCY: "1"
+    MAILER_FROM_ADDRESS: "Fizzy <support@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_DOMAIN: *fizzy_host
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
