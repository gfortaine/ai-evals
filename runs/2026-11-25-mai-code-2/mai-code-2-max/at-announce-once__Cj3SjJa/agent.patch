     assert_equal "hello-world", book.slug
@@ -40,4 +42,87 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "announces a publication once when other changes are saved with it" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.press Page.new(body: ""), title: "An extra page"
+      end
+    end
+
+    assert_predicate book.reload, :published?
+  end
+
+  test "does not announce a book that is already published" do
+    book = books(:manual)
+    book.update!(published: true)
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(title: "A better title")
+    end
+  end
+
+  test "does not announce an unpublished book" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      books(:manual).update!(title: "A better title")
+    end
+  end
+
+  test "does not announce a book that is taken offline" do
+    book = books(:manual)
+    book.update!(published: true)
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(published: false)
+    end
+  end
+
+  test "does not announce a publication when its transaction rolls back" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises ActiveRecord::RecordNotFound do
+        book.transaction do
+          book.update!(published: true)
+          book.leaves.find(-1)
+        end
+      end
+    end
+
+    assert_not book.reload.published?
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.update!(published: true)
+    end
+  end
+
+  test "announces once when a transaction publishes the book more than once" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        Book.find(book.id).update!(published: false)
+        Book.find(book.id).update!(published: true)
+      end
+    end
+  end
+
+  test "does not announce a publication reversed before commit" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.update!(published: false)
+      end
+    end
+
+    assert_not book.reload.published?
+  end
 end
