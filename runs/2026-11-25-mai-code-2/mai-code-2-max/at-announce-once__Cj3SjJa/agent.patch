diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..a99471a 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,41 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :schedule_publication_announcement, if: :became_published?
   end
 
   private
-    def announce_publication
-      AnnouncePublicationJob.perform_later self
+    def became_published?
+      saved_change_to_published?(from: false, to: true)
+    end
+
+    def schedule_publication_announcement
+      announcements = pending_publication_announcements
+      key = publication_announcement_key
+      return if announcements.key?(key)
+
+      token = announcements[key] = Object.new
+      transaction = self.class.current_transaction
+
+      transaction.after_commit do
+        if announcements.delete(key).equal?(token)
+          AnnouncePublicationJob.perform_later(self) if published_after_commit?
+        end
+      end
+      transaction.after_rollback do
+        announcements.delete(key) if announcements[key].equal?(token)
+      end
+    end
+
+    def pending_publication_announcements
+      ActiveSupport::IsolatedExecutionState[:book_publication_announcements] ||= {}
+    end
+
+    def publication_announcement_key
+      [ self.class, id ]
+    end
+
+    def published_after_commit?
+      self.class.exists?(id: id, published: true)
     end
 end
