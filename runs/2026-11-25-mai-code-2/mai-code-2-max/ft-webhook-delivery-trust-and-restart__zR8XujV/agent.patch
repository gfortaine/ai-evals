@@ -1,4 +1,10 @@
 class Webhook::Delivery < ApplicationRecord
+  DESTINATION_UNREACHABLE = "destination_unreachable"
+  INACTIVE_WEBHOOK = "webhook_inactive"
+  RETENTION_PERIOD = 7.days
+  REQUEST_TIMEOUT = 10
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +15,29 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :expired, -> { where(created_at: ...RETENTION_PERIOD.ago) }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def cleanup
+      expired.delete_all
+    end
+  end
+
+  def deliver
+    if claim
+      perform
+    else
+      self
+    end
+  end
+
+  alias deliver_now deliver
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -27,6 +56,88 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response&.dig(:error).blank? && response&.dig(:code).to_i.between?(200, 299)
   end
+
+  private
+    def claim
+      with_lock do
+        if pending?
+          if webhook.active?
+            in_progress!
+            true
+          else
+            update!(state: :errored, response: { error: INACTIVE_WEBHOOK })
+            false
+          end
+        else
+          false
+        end
+      end
+    end
+
+    def perform
+      response = post
+
+      update!(state: :completed, response: {
+        code: response.code.to_i,
+        headers: response.to_hash
+      })
+    rescue => error
+      update!(state: :errored, response: { error: DESTINATION_UNREACHABLE })
+      Rails.error.report(error, context: { webhook_id:, event_id:, delivery_id: id })
+    ensure
+      webhook.record_delivery(self) if completed? || errored?
+    end
+
+    def post
+      body = payload
+      headers = request_headers(body)
+      uri = URI.parse(webhook.url)
+      destination_ip = webhook.resolved_url_ip
+
+      raise Net::HTTPBadResponse, "Webhook destination did not resolve to a public IP address" unless destination_ip
+
+      update!(request: { headers: })
+
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.ipaddr = destination_ip
+      http.open_timeout = REQUEST_TIMEOUT
+      http.read_timeout = REQUEST_TIMEOUT
+      http.use_ssl = uri.scheme == "https"
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      http.request(request)
+    end
+
+    def payload
+      if webhook.for_slack?
+        JSON.generate(text: rendered_event(:html))
+      elsif webhook.for_campfire? || webhook.for_basecamp?
+        JSON.generate(content: rendered_event(:html))
+      else
+        rendered_event(:json)
+      end
+    end
+
+    def rendered_event(format)
+      Current.with_account(account) do
+        ApplicationController.renderer.new(script_name: account.slug).render(
+          template: "webhooks/event",
+          formats: [ format ],
+          assigns: { event: }
+        )
+      end
+    end
+
+    def request_headers(body)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+    end
 end
