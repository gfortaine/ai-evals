@@ -9,6 +9,101 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
     assert_equal "pending", delivery.state
   end
 
+  test "posts a signed payload once" do
+    webhook = webhooks(:active)
+    event = events(:text_published)
+    delivery = Webhook::Delivery.create!(webhook:, event:)
+    tracker = Webhook::DelinquencyTracker.create_or_find_by!(webhook:)
+    tracker.update!(consecutive_failures_count: 2, first_failure_at: 30.minutes.ago)
+    stub_dns_resolution("93.184.216.34")
+
+    received_request = nil
+    request = stub_request(:post, webhook.url).with(ipaddr: "93.184.216.34") do |http_request|
+      received_request = http_request
+      true
+    end
+    request.to_return(status: 201, headers: { "X-Result" => "accepted" })
+
+    delivery.deliver
+    delivery.reload
+
+    assert delivery.completed?
+    assert delivery.succeeded?
+    assert_equal 201, delivery.response_summary[:code]
+    assert_equal [ "accepted" ], delivery.response[:headers]["x-result"]
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+
+    payload = JSON.parse(received_request.body)
+    assert_equal event.id, payload["id"]
+    assert_equal event.action, payload["action"]
+
+    signature = delivery.request.dig("headers", "X-Webhook-Signature")
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, received_request.body), signature
+    assert_equal event.created_at.utc.iso8601, delivery.request.dig("headers", "X-Webhook-Timestamp")
+    assert_not_includes delivery.sanitized_request[:headers], "X-Webhook-Signature"
+
+    delivery.deliver
+    assert_requested request, times: 1
+  end
+
+  test "records a failed response and deactivates a delinquent webhook" do
+    webhook = webhooks(:active)
+    tracker = Webhook::DelinquencyTracker.create_or_find_by!(webhook:)
+    tracker.update!(consecutive_failures_count: 9, first_failure_at: 30.minutes.ago)
+    stub_dns_resolution("93.184.216.34")
+
+    stub_request(:post, webhook.url).to_return(status: 500)
+    delivery = Webhook::Delivery.create!(webhook:, event: events(:text_published))
+
+    delivery.deliver
+
+    assert delivery.reload.failed?
+    assert_not webhook.reload.active?
+    assert_equal 10, tracker.reload.consecutive_failures_count
+
+    webhook.activate
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "does not POST when the webhook is inactive" do
+    webhook = webhooks(:inactive)
+    delivery = Webhook::Delivery.create!(webhook:, event: events(:logo_published))
+    request = stub_request(:post, webhook.url)
+
+    delivery.deliver
+
+    assert_not_requested request
+    assert_equal "webhook_inactive", delivery.reload.response[:error]
+    assert delivery.errored?
+  end
+
+  test "records a private destination without making a request" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook:, event: events(:text_published))
+    stub_dns_resolution("127.0.0.1")
+    request = stub_request(:post, webhook.url)
+
+    delivery.deliver
+
+    assert_not_requested request
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
