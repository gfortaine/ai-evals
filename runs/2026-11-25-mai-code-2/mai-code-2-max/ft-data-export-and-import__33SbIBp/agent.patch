index 0000000..79c6a17
--- /dev/null
+++ b/app/models/account/data_transfer/filter_record_set.rb
@@ -0,0 +1,58 @@
+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  ASSOCIATIONS = {
+    "tags" => [ "filters_tags", "tag_id" ],
+    "boards" => [ "boards_filters", "board_id" ],
+    "assignees" => [ "assignees_filters", "assignee_id" ],
+    "creators" => [ "creators_filters", "creator_id" ],
+    "closers" => [ "closers_filters", "closer_id" ]
+  }.freeze
+
+  def initialize(account)
+    super(account: account, model: Filter)
+    @pending_associations = []
+  end
+
+  private
+    def export_attributes(record)
+      super.merge("_associations" => ASSOCIATIONS.keys.to_h { |name| [ name, record.public_send(name).ids ] })
+    end
+
+    def import_attributes(attributes, context)
+      associations = attributes.delete("_associations") || {}
+      imported = super
+      mapped_associations = associations.to_h do |name, source_ids|
+        [ name, Array(source_ids).map { |source_id| context.mapped_id(source_id) } ]
+      end
+      @pending_associations << [ imported["id"], mapped_associations ]
+      imported
+    end
+
+    def insert_records(rows)
+      super
+      return if @pending_associations.empty?
+
+      @pending_associations.each do |filter_id, associations|
+        ASSOCIATIONS.each do |name, (table_name, foreign_key)|
+          join_records = Array(associations[name]).filter_map do |resource_id|
+            { "filter_id" => filter_id, foreign_key => resource_id }
+          end
+          join_model_for(table_name).insert_all!(join_records) if join_records.any?
+        end
+      end
+
+      @pending_associations.pluck(0).each do |filter_id|
+        filter = Filter.find(filter_id)
+        filter.update_column(:params_digest, Filter.digest_params(filter.as_params))
+      end
+
+      @pending_associations = []
+    end
+
+    def join_model_for(table_name)
+      @join_models ||= {}
+      @join_models[table_name] ||= Class.new(ApplicationRecord) do
+        self.table_name = table_name
+        self.inheritance_column = nil
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/import_context.rb b/app/models/account/data_transfer/import_context.rb
new file mode 100644
index 0000000..c8d3b2f
--- /dev/null
+++ b/app/models/account/data_transfer/import_context.rb
@@ -0,0 +1,102 @@
+class Account::DataTransfer::ImportContext
+  POLYMORPHIC_TYPES = %w[
+    Account ActionText::RichText ActiveStorage::Blob ActiveStorage::VariantRecord Board Card Comment Event Mention User Webhook
+  ].freeze
+
+  attr_reader :account, :identity, :uploaded_blobs
+
+  def initialize(identity:)
+    @identity = identity
+    @ids = {}
+    @uploaded_blobs = {}
+  end
+
+  def create_account(attributes)
+    @account = Account.create!(name: attributes.fetch("name"), cards_count: Integer(attributes.fetch("cards_count", 0)))
+    account.update_columns(
+      created_at: attributes["created_at"].presence || account.created_at,
+      updated_at: attributes["updated_at"].presence || account.updated_at
+    )
+    register_id(attributes.fetch("id"), account.id)
+    account.entropy&.destroy!
+    account
+  rescue KeyError, TypeError, ArgumentError, ActiveRecord::RecordInvalid => error
+    raise Account::DataTransfer::InvalidArchive, "The account record is invalid: #{error.message}"
+  end
+
+  def attributes_for(model, source, allowed: model.column_names)
+    source = source.stringify_keys
+    attributes = source.slice(*(allowed.map(&:to_s)))
+    old_id = attributes["id"] || source["id"]
+    attributes["id"] = old_id.present? ? new_id_for(old_id) : ActiveRecord::Type::Uuid.generate
+    attributes["account_id"] = account.id if model.column_names.include?("account_id")
+    remap_types!(attributes)
+    remap_values(attributes).except("external_account_id")
+  end
+
+  def mapped_id?(source_id)
+    @ids.key?(source_id.to_s)
+  end
+
+  def mapped_id(source_id)
+    @ids.fetch(source_id.to_s) do
+      raise Account::DataTransfer::InvalidArchive, "The archive refers to a missing record #{source_id.inspect}"
+    end
+  end
+
+  def register_id(source_id, target_id = ActiveRecord::Type::Uuid.generate)
+    source_id = source_id.to_s
+
+    if @ids.key?(source_id)
+      raise Account::DataTransfer::InvalidArchive, "The archive contains the duplicate record #{source_id.inspect}"
+    end
+
+    @ids[source_id] = target_id
+  end
+
+  def remap_values(value, key: nil)
+    case value
+    when Hash
+      value.to_h { |nested_key, item| [ nested_key, remap_values(item, key: nested_key) ] }
+    when Array
+      value.map { |item| remap_values(item, key: key) }
+    when String
+      key.to_s.match?(/(?:\A|_)id(?:s)?\z/) ? @ids.fetch(value, value) : value
+    else
+      value
+    end
+  end
+
+  def identity_for(email_address)
+    if email_address.present?
+      Identity.create_or_find_by!(email_address: email_address.to_s.strip.downcase)
+    end
+  end
+
+  def track_blob_upload(blob)
+    @uploaded_blobs[blob.key] = blob.service
+  end
+
+  def rollback_file_uploads
+    @uploaded_blobs.each do |key, service|
+      service.delete(key)
+    rescue => error
+      Rails.error.report(error, handled: true, severity: :error)
+    end
+  end
+
+  private
+    def new_id_for(source_id)
+      register_id(source_id)
+    end
+
+    def remap_types!(attributes)
+      polymorphic_keys = %w[container_type eventable_type reactable_type record_type searchable_type source_type]
+
+      attributes.each do |key, value|
+        if polymorphic_keys.include?(key) && value.present? && !POLYMORPHIC_TYPES.include?(value.to_s)
+          raise Account::DataTransfer::InvalidArchive, "The archive contains an unsupported record type #{value.inspect}"
+        end
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..cc8ae21
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,87 @@
+class Account::DataTransfer::Importer
+  attr_reader :account
+
+  def initialize(identity:, zip:)
+    @identity = identity
+    @zip = zip
+  end
+
+  def import
+    @context = Account::DataTransfer::ImportContext.new(identity: identity)
+
+    ApplicationRecord.transaction(requires_new: true) do
+      Account::DataTransfer::Manifest.new(Current.account).import_from(zip, @context)
+      @account = @context.account
+      finalize_account
+    end
+
+    @context
+  rescue
+    @context&.rollback_file_uploads
+    raise
+  end
+
+  private
+    attr_reader :identity, :zip
+
+    def finalize_account
+      ensure_entropy
+      ensure_system_user
+      ensure_importing_user
+      update_search_index
+      reconcile_storage
+    end
+
+    def ensure_entropy
+      account.entropy || account.create_entropy!(auto_postpone_period: Account::Entropic::DEFAULT_ENTROPY_PERIOD)
+    end
+
+    def ensure_system_user
+      unless account.users.exists?(role: :system)
+        account.users.create!(name: "System", role: :system)
+      end
+    end
+
+    def ensure_importing_user
+      user = account.users.find_or_initialize_by(identity: identity)
+
+      if user.new_record?
+        user.assign_attributes(
+          name: identity.email_address.split("@").first,
+          role: :owner,
+          verified_at: Time.current
+        )
+        user.save!
+      elsif !account.users.exists?(role: :owner)
+        user.owner!
+      end
+
+      Access.insert_all account.boards.ids.map { |board_id|
+        {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: account.id,
+          board_id: board_id,
+          user_id: user.id,
+          created_at: Time.current,
+          updated_at: Time.current
+        }
+      }, unique_by: %i[board_id user_id]
+    end
+
+    def update_search_index
+      account.cards.includes(:rich_text_description, :board).find_each(&:reindex)
+      Comment.where(account: account).includes(:rich_text_body, card: :board).find_each(&:reindex)
+    end
+
+    def reconcile_storage
+      account.boards.find_each do |board|
+        unless board.reconcile_storage
+          raise Account::DataTransfer::InvalidArchive, "The imported storage usage could not be reconciled"
+        end
+      end
+
+      unless account.reconcile_storage
+        raise Account::DataTransfer::InvalidArchive, "The imported account storage could not be reconciled"
+      end
+    end
+end
