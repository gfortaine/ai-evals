index 0000000..3ab6362
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,58 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  belongs_to :source, polymorphic: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[pending processing completed failed].index_by(&:itself), default: :pending
+
+  after_create_commit :build_later
+
+  validates :source, presence: true
+
+  def build_later
+    ExportJob.perform_later(self)
+  end
+
+  def build_now
+    return if completed? || failed?
+
+    update!(status: :processing, started_at: Time.current)
+
+    case source
+    when Account
+      Account::DataTransfer::Exporter.new(source).export_to(file, filename: download_filename)
+    when User
+      ZipFile.create_for(file, filename: download_filename) do |zip|
+        User::DataExport.new(source).export_to(zip)
+      end
+    else
+      raise ArgumentError, "Unsupported export source #{source.class.name}"
+    end
+
+    update!(status: :completed, completed_at: Time.current, error_message: nil)
+    AccountMailer.export_ready(self).deliver_later
+  rescue => error
+    update_columns(status: :failed, error_message: safe_error_message(error), completed_at: Time.current)
+    Rails.error.report(error, handled: true, severity: :error, source: "fizzy.export")
+  end
+
+  def accessible_to?(candidate)
+    candidate == user
+  end
+
+  def publicly_accessible?
+    false
+  end
+
+  def download_filename
+    name = source.respond_to?(:name) ? source.name : "account"
+    "#{name.to_s.parameterize.presence || "fizzy"}-export-#{created_at.to_date.iso8601}.zip"
+  end
+
+  private
+    def safe_error_message(error)
+      (error.message.presence || error.class.name).truncate(20_000)
+    end
+end
