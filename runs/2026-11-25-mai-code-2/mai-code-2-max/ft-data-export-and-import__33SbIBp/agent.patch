@@ -0,0 +1,45 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+    Current.session = sessions(:kevin)
+  end
+
+  test "builds an account export and sends the ready email" do
+    export = @account.export(requested_by: @user)
+
+    export.build_now
+
+    assert export.reload.completed?, export.error_message
+    assert_enqueued_with(job: ActionMailer::MailDeliveryJob)
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+
+    ZipFile.open(export.file) do |zip|
+      assert_equal "fizzy-account", JSON.parse(zip.read("manifest.json"))["format"]
+      assert zip.glob("cards/*.json").any?
+    end
+  end
+
+  test "a card export contains only the requesting user's visible cards" do
+    export = users(:david).export_data
+    export.build_now
+
+    ZipFile.open(export.file) do |zip|
+      paths = zip.glob("cards/*.json")
+      exported_ids = paths.map { |path| JSON.parse(zip.read(path))["id"] }
+
+      assert_equal users(:david).accessible_cards.pluck(:id).sort, exported_ids.sort
+    end
+  end
+
+  test "only the requester can access the export file" do
+    export = @account.export(requested_by: @user)
+
+    assert export.accessible_to?(@user)
+    assert_not export.accessible_to?(users(:david))
+    assert_not export.publicly_accessible?
+  end
+end
