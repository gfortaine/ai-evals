+<% @page_title = "Import an account" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "account settings", account_settings_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+<% end %>
+
+<div class="panel shadow center" style="--panel-size: 50ch;">
+  <div class="flex flex-column gap">
+    <div class="flex flex-column gap-half">
+      <h1 class="txt-x-large margin-none">Import an account</h1>
+      <p class="margin-none">Choose a Fizzy account export. We'll create a new account with its boards, cards, comments, files, and people, then email you when it's ready.</p>
+    </div>
+
+    <%= form_with model: @import, url: account_imports_path, class: "flex flex-column gap", data: { controller: "form" } do |form| %>
+      <label class="flex flex-column gap-half">
+        <strong>Account export (.zip)</strong>
+        <%= form.file_field :file, accept: ".zip,application/zip", required: true, direct_upload: true, class: "input" %>
+      </label>
+
+      <% if @import.errors.any? %>
+        <div class="txt-negative txt-small">
+          <strong>Your import couldn't be started:</strong>
+          <ul class="margin-block-none">
+            <% @import.errors.full_messages.each do |message| %>
+              <li><%= message %></li>
+            <% end %>
+          </ul>
+        </div>
+      <% end %>
+
+      <%= form.button "Start import", class: "btn btn--reversed", data: { form_target: "submit" } %>
+    <% end %>
+  </div>
+</div>
