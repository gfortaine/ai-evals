+++ b/app/models/user/data_export.rb
@@ -0,0 +1,137 @@
+class User::DataExport
+  FORMAT = "fizzy-cards"
+  VERSION = 1
+
+  def initialize(user)
+    @user = user
+  end
+
+  def export_to(zip)
+    @zip = zip
+    @exported_blobs = Set.new
+    zip.add_file("manifest.json", JSON.generate(
+      "format" => FORMAT,
+      "version" => VERSION,
+      "user" => { "id" => user.id, "name" => user.name },
+      "created_at" => Time.current.iso8601
+    ))
+
+    cards.find_each { |card| export_card(card) }
+  end
+
+  private
+    attr_reader :user, :zip
+
+    def cards
+      user.accessible_cards.includes(
+        :board,
+        :creator,
+        :column,
+        :assignees,
+        :tags,
+        :steps,
+        :closure,
+        :goldness,
+        :not_now,
+        reactions: :reacter,
+        image_attachment: :blob,
+        rich_text_description: :embeds_attachments,
+        comments: [ :creator, { reactions: :reacter }, { rich_text_body: :embeds_attachments } ]
+      )
+    end
+
+    def export_card(card)
+      zip.add_file("cards/#{card.number}-#{card.id}.json", JSON.generate(card_attributes(card)))
+    end
+
+    def card_attributes(card)
+      {
+        "id" => card.id,
+        "number" => card.number,
+        "title" => card.title,
+        "description" => rich_text_attributes(card.description),
+        "status" => card.status,
+        "created_at" => card.created_at,
+        "updated_at" => card.updated_at,
+        "last_active_at" => card.last_active_at,
+        "board" => { "id" => card.board_id, "name" => card.board.name },
+        "creator" => user_attributes(card.creator),
+        "column" => card.column && { "id" => card.column.id, "name" => card.column.name, "color" => card.column.color },
+        "assignees" => card.assignees.map { |assignee| user_attributes(assignee) },
+        "tags" => card.tags.pluck(:title),
+        "steps" => card.steps.map { |step| step.attributes.slice("id", "content", "completed", "created_at", "updated_at") },
+        "closure" => card.closure && card.closure.attributes.slice("id", "user_id", "created_at"),
+        "golden" => card.goldness.present?,
+        "postponed" => card.not_now&.attributes&.slice("user_id", "created_at"),
+        "image" => attachment_attributes(card.image_attachment),
+        "attachments" => attachment_list(card.attachments),
+        "reactions" => reaction_attributes(card.reactions),
+        "comments" => card.comments.chronologically.map { |comment| comment_attributes(comment) }
+      }
+    end
+
+    def comment_attributes(comment)
+      {
+        "id" => comment.id,
+        "creator" => user_attributes(comment.creator),
+        "body" => rich_text_attributes(comment.body),
+        "attachments" => attachment_list(comment.attachments),
+        "reactions" => reaction_attributes(comment.reactions),
+        "created_at" => comment.created_at,
+        "updated_at" => comment.updated_at
+      }
+    end
+
+    def rich_text_attributes(rich_text)
+      if rich_text.nil?
+        { "html" => nil, "plain_text" => nil }
+      else
+        content = rich_text.respond_to?(:body) ? rich_text.body : rich_text
+        { "html" => content.to_html, "plain_text" => content.to_plain_text }
+      end
+    end
+
+    def attachment_list(attachments)
+      relation = attachments.respond_to?(:attachments) ? attachments.attachments : attachments
+      Array(relation).map { |attachment| attachment_attributes(attachment) }
+    end
+
+    def attachment_attributes(attachment)
+      return unless attachment.present?
+
+      blob = attachment.blob
+      path = add_blob(blob)
+
+      {
+        "name" => attachment.name,
+        "filename" => blob.filename.to_s,
+        "content_type" => blob.content_type,
+        "byte_size" => blob.byte_size,
+        "path" => path
+      }
+    end
+
+    def add_blob(blob)
+      path = "files/#{blob.id}/#{safe_filename(blob)}"
+      unless @exported_blobs.include?(blob.id)
+        zip.add_file(path, compress: false) { |output| blob.download { |chunk| output.write(chunk) } }
+        @exported_blobs << blob.id
+      end
+      path
+    end
+
+    def safe_filename(blob)
+      filename = blob.filename.sanitized.to_s
+      filename.presence || "attachment"
+    end
+
+    def user_attributes(value)
+      value && { "id" => value.id, "name" => value.name }
+    end
+
+    def reaction_attributes(reactions)
+      reactions.map do |reaction|
+        { "content" => reaction.content, "creator" => user_attributes(reaction.reacter) }
+      end
+    end
+end
