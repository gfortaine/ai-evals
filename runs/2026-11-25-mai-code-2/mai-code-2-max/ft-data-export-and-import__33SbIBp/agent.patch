--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,78 @@
+class Account::Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :identity
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[pending processing completed failed].index_by(&:itself), default: :pending
+
+  after_create_commit :process_later
+
+  validate :file_is_a_zip
+
+  def process_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def process_now
+    return if completed? || failed?
+
+    update!(status: :processing, started_at: Time.current)
+
+    ZipFile.open(file.blob) do |zip|
+      importer = Account::DataTransfer::Importer.new(identity: identity, zip: zip)
+      @context = importer.import
+      @imported_account = importer.account
+    end
+
+    update!(
+      status: :completed,
+      completed_at: Time.current,
+      error_message: nil,
+      imported_account: @imported_account
+    )
+    AccountMailer.import_complete(self).deliver_later
+    file.purge_later
+  rescue => error
+    @imported_account&.destroy! if @imported_account&.persisted?
+    @context&.rollback_file_uploads
+    update_columns(
+      status: :failed,
+      error_message: safe_error_message(error),
+      completed_at: Time.current,
+      imported_account_id: nil
+    )
+    Rails.error.report(error, handled: true, severity: :error, source: "fizzy.import")
+    AccountMailer.import_failed(self).deliver_later
+    file.purge_later
+  end
+
+  def accessible_to?(candidate)
+    candidate&.identity == identity
+  end
+
+  def publicly_accessible?
+    false
+  end
+
+  private
+    def file_is_a_zip
+      if file.attached? && !File.extname(file.filename.to_s).casecmp?(".zip")
+        errors.add(:file, "must be a ZIP file")
+      elsif !file.attached?
+        errors.add(:file, "must be attached")
+      end
+    end
+
+    def safe_error_message(error)
+      message = case error
+      when ZipFile::Reader::InvalidArchive, Account::DataTransfer::InvalidArchive
+        error.message
+      else
+        "The import could not be completed. #{error.message}"
+      end
+
+      message.to_s.truncate(20_000)
+    end
+end
