 class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransfer::RecordSet
+  ATTACHABLE_TYPES = {
+    "ActiveStorage::Blob" => ::ActiveStorage::Blob,
+    "User" => ::User
+  }.freeze
+
   def initialize(account)
     super(account: account, model: ::ActionText::RichText)
   end
@@ -8,4 +13,46 @@ class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransf
       ::ActionText::RichText.where(account: account)
     end
 
+    def export_attributes(record)
+      super.merge("body" => portable_body(record.body.to_html))
+    end
+
+    def import_attributes(attributes, context)
+      imported = super(attributes, context)
+      imported["body"] = restored_body(imported["body"], context)
+      imported
+    end
+
+    def portable_body(body)
+      document = Nokogiri::HTML5.fragment(body)
+
+      document.css("action-text-attachment[sgid]").each do |node|
+        attachable = ::ActionText::Attachable.from_node(node)
+        next unless attachable.respond_to?(:id) && ATTACHABLE_TYPES.key?(attachable.class.name)
+
+        node["data-fizzy-attachable-type"] = attachable.class.polymorphic_name
+        node["data-fizzy-attachable-id"] = attachable.id
+        node.remove_attribute("sgid")
+      end
+
+      document.to_html
+    end
+
+    def restored_body(body, context)
+      document = Nokogiri::HTML5.fragment(body.to_s)
+
+      document.css("action-text-attachment[data-fizzy-attachable-id]").each do |node|
+        type = node["data-fizzy-attachable-type"]
+        model = ATTACHABLE_TYPES.fetch(type) do
+          raise Account::DataTransfer::InvalidArchive, "The archive contains an unsupported attachment"
+        end
+        attachable = model.find(context.mapped_id(node["data-fizzy-attachable-id"]))
+
+        node["sgid"] = attachable.attachable_sgid
+        node.remove_attribute("data-fizzy-attachable-type")
+        node.remove_attribute("data-fizzy-attachable-id")
+      end
+
+      document.to_html
+    end
 end
