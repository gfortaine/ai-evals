diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..a7befb2
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,105 @@
+class ZipFile::Reader
+  class InvalidArchive < StandardError; end
+  class EntryNotFound < InvalidArchive; end
+  class EntryTooLarge < InvalidArchive; end
+  class ChecksumMismatch < InvalidArchive; end
+
+  DEFAULT_CHUNK_SIZE = 5.megabytes
+  DEFAULT_MAX_READ = 50.megabytes
+
+  attr_reader :io
+
+  def initialize(io)
+    @io = io
+    @parser = ZipKit::FileReader.new
+    @entries = index_entries
+  end
+
+  def entries
+    @entries.values.sort_by(&:filename)
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  def size(path)
+    entry_for(path).uncompressed_size
+  end
+
+  def read(path, max_bytes: DEFAULT_MAX_READ)
+    entry = entry_for(path)
+    reject_oversized_entry(entry, max_bytes)
+
+    copy(entry, output: StringIO.new, max_bytes: max_bytes).string
+  end
+
+  def copy(path, output:, max_bytes: nil)
+    entry = path.is_a?(ZipKit::FileReader::ZipEntry) ? path : entry_for(path)
+    reject_oversized_entry(entry, max_bytes) if max_bytes
+
+    extractor = extractor_for(entry)
+    bytes_read = 0
+    checksum = 0
+
+    until extractor.eof?
+      chunk = extractor.extract(chunk_size_for(entry))
+      break if chunk.nil? || chunk.empty?
+
+      bytes_read += chunk.bytesize
+      reject_oversized_entry(entry, max_bytes, bytes_read: bytes_read) if max_bytes
+      output.write(chunk)
+      checksum = Zlib.crc32(chunk, checksum)
+    end
+
+    unless bytes_read == entry.uncompressed_size
+      raise InvalidArchive, "#{entry.filename} was truncated while reading"
+    end
+
+    unless checksum == entry.crc32
+      raise ChecksumMismatch, "Checksum mismatch for #{entry.filename}"
+    end
+
+    output
+  end
+
+  private
+    def chunk_size_for(entry)
+      entry.storage_mode == 8 ? 64.kilobytes : DEFAULT_CHUNK_SIZE
+    end
+
+    def index_entries
+      entries = @parser.read_zip_structure(io: io, read_local_headers: false)
+      indexed = entries.index_by(&:filename)
+      raise InvalidArchive, "ZIP contains duplicate file names" unless entries.length == indexed.length
+
+      indexed
+    rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, EOFError, SystemCallError => error
+      raise InvalidArchive, "The ZIP file is invalid: #{error.message}"
+    end
+
+    def entry_for(path)
+      @entries.fetch(path) { raise EntryNotFound, "Missing #{path} in ZIP file" }
+    end
+
+    def extractor_for(entry)
+      unless entry.known_offset?
+        entry.compressed_data_offset = @parser.get_compressed_data_offset(
+          io: io,
+          local_file_header_offset: entry.local_file_header_offset
+        )
+      end
+
+      entry.extractor_from(io)
+    end
+
+    def reject_oversized_entry(entry, max_bytes, bytes_read: entry.uncompressed_size)
+      if bytes_read > max_bytes
+        raise EntryTooLarge, "#{entry.filename} is larger than the supported #{max_bytes} bytes"
+      end
+    end
+end
diff --git a/app/models/zip_file/remote_io.rb b/app/models/zip_file/remote_io.rb
new file mode 100644
index 0000000..428bf3e
--- /dev/null
+++ b/app/models/zip_file/remote_io.rb
@@ -0,0 +1,105 @@
+require "net/http"
+require "uri"
+
+class ZipFile::RemoteIO
+  def initialize(&url_provider)
+    raise ArgumentError, "URL provider is required" if url_provider.nil?
+
+    @url_provider = url_provider
+    @position = 0
+    @remote_size = nil
+  end
+
+  def seek(offset, mode = IO::SEEK_SET)
+    raise ArgumentError, "Unsupported seek mode #{mode}" unless mode == IO::SEEK_SET
+
+    @position = offset.clamp(0, size)
+    0
+  end
+
+  def tell
+    @position
+  end
+
+  def size
+    @remote_size ||= request_object_size
+  end
+
+  def read(length = nil)
+    return if size.zero?
+
+    available = size - @position
+    length ||= available
+    return "" if length.zero?
+    raise ArgumentError, "Negative read length" if length.negative?
+
+    length = [ length, available ].min
+    data = request_range(@position..(@position + length - 1))
+
+    unless data.bytesize == length
+      raise IOError, "Remote read returned #{data.bytesize} bytes instead of #{length}"
+    end
+
+    @position += data.bytesize
+    data
+  end
+
+  private
+    def request_object_size
+      response = request(range: 0..0)
+      content_range = response["Content-Range"]
+
+      if response.code == "206" && content_range
+        Integer(content_range.split("/").last)
+      else
+        Integer(response["Content-Length"])
+      end
+    end
+
+    def request_range(range)
+      response = request(range: range)
+      unless response.code == "206"
+        raise IOError, "Remote storage did not honor a requested byte range"
+      end
+
+      response.body.to_s
+    end
+
+    def request(range:, redirects: 3)
+      uri = URI(@url_provider.call)
+      Net::HTTP.new(uri.hostname, uri.port).tap do |http|
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = 30
+        http.read_timeout = 30
+        http.verify_mode = OpenSSL::SSL::VERIFY_NONE if http.use_ssl?
+      end.start do |http|
+        response = http.request(Net::HTTP::Get.new(uri).tap { |request| request.range = range })
+
+        if response.is_a?(Net::HTTPRedirection) && redirects.positive?
+          redirect_uri = URI.join(uri, response["location"])
+          redirect_request(redirect_uri, range: range, redirects: redirects - 1)
+        elsif response.is_a?(Net::HTTPSuccess)
+          response
+        else
+          raise IOError, "Remote storage returned HTTP #{response.code}"
+        end
+      end
+    end
+
+    def redirect_request(uri, range:, redirects:)
+      Net::HTTP.start(uri.hostname, uri.port,
+        use_ssl: uri.scheme == "https",
+        verify_mode: uri.scheme == "https" ? OpenSSL::SSL::VERIFY_NONE : nil
+      ) do |http|
+        response = http.request(Net::HTTP::Get.new(uri).tap { |request| request.range = range })
+
+        if response.is_a?(Net::HTTPRedirection) && redirects.positive?
+          redirect_request(URI.join(uri, response["location"]), range: range, redirects: redirects - 1)
+        elsif response.is_a?(Net::HTTPSuccess)
+          response
+        else
+          raise IOError, "Remote storage returned HTTP #{response.code}"
+        end
+      end
+    end
+end
