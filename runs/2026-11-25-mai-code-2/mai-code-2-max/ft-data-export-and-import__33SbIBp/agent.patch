--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "an admin starts an account export" do
+    sign_in_as :kevin
+
+    assert_enqueued_with(job: ExportJob) do
+      post account_exports_path
+    end
+
+    export = Export.order(:id).last
+    assert_equal accounts(:"37s"), export.source
+    assert_equal users(:kevin), export.user
+    assert_redirected_to account_settings_path
+  end
+
+  test "a member cannot export an account" do
+    sign_in_as :jz
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+end
