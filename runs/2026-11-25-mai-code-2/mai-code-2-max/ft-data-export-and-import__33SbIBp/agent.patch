@@ -55,3 +55,48 @@ class AccountMailerTest < ActionMailer::TestCase
     assert_match /deleted/i, email.body.encoded
   end
 end
+
+class AccountDataTransferMailerTest < ActionMailer::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    @identity = @user.identity
+  end
+
+  test "export ready includes a download link that expires after one day" do
+    export = Export.create!(account: @account, user: @user, source: @account)
+    export.file.attach(io: StringIO.new("zip"), filename: "account.zip", content_type: "application/zip")
+    email = AccountMailer.export_ready(export)
+    html = Nokogiri::HTML5(email.html_part.body.decoded)
+    url = html.at_css("a")["href"]
+    signed_id = URI(url).path.split("blobs/redirect/").last.split("/").first
+
+    assert_equal [ @identity.email_address ], email.to
+    assert ActiveStorage::Blob.find_signed(signed_id, purpose: :blob_id)
+
+    travel 25.hours do
+      assert_nil ActiveStorage::Blob.find_signed(signed_id, purpose: :blob_id)
+    end
+  end
+
+  test "completed import links to the new account" do
+    imported_account = Account.create!(name: "Imported account")
+    account_import = @account.imports.create!(identity: @identity, file: { io: StringIO.new("zip"), filename: "account.zip", content_type: "application/zip" })
+    account_import.update!(status: :completed, imported_account: imported_account)
+    email = AccountMailer.import_complete(account_import)
+
+    assert_match imported_account.name, email.body.encoded
+    assert_match imported_account.slug, email.body.encoded
+  ensure
+    imported_account&.destroy!
+  end
+
+  test "failed import includes the reason" do
+    account_import = @account.imports.create!(identity: @identity, file: { io: StringIO.new("zip"), filename: "account.zip", content_type: "application/zip" })
+    account_import.update!(status: :failed, error_message: "The ZIP is corrupt")
+    email = AccountMailer.import_failed(account_import)
+
+    assert_match "The ZIP is corrupt", email.body.encoded
+    assert_match "No account data", email.body.encoded
+  end
+end
diff --git a/test/models/account/data_transfer_test.rb b/test/models/account/data_transfer_test.rb
new file mode 100644
index 0000000..9880621
--- /dev/null
+++ b/test/models/account/data_transfer_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Account::DataTransferTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+  end
+
+  test "round trips an account with comments and files" do
+    card = cards(:logo)
+    publication = card.board.publish
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    attachment_html = ActionText::Attachment.from_attachable(card.image.blob).to_html
+    card.update!(description: "Portable #{attachment_html}")
+
+    imported = nil
+    with_account_zip(@account) do |zip|
+      importer = Account::DataTransfer::Importer.new(identity: users(:jason).identity, zip: zip)
+      importer.import
+      imported = importer.account
+    end
+
+    imported_card = imported.cards.find_by!(number: card.number)
+
+    assert_equal @account.users.count, imported.users.count
+    assert_equal @account.boards.count, imported.boards.count
+    assert_equal @account.cards.count, imported.cards.count
+    assert_not_equal publication.key, imported.boards.find_by!(name: card.board.name).publication.key
+    assert_equal Comment.where(account: @account).count, Comment.where(account: imported).count
+    assert imported_card.image.attached?
+    assert_equal card.image.download, imported_card.image.download
+    assert imported_card.description.body.attachables.first.is_a?(ActiveStorage::Blob)
+    assert imported.users.exists?(identity: users(:jason).identity, role: :owner)
+  ensure
+    imported&.destroy!
+  end
+
+  test "a failed import leaves no account behind" do
+    tempfile = Tempfile.new([ "broken-export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("manifest.json", JSON.generate(format: "fizzy-account", version: 1))
+    writer.add_file("accounts/source.json", JSON.generate(id: ActiveRecord::Type::Uuid.generate, name: "Broken import"))
+    writer.add_file("boards/broken.json", "not json")
+    writer.close
+    tempfile.rewind
+
+    assert_no_difference -> { Account.count } do
+      assert_raises Account::DataTransfer::InvalidArchive, JSON::ParserError do
+        Account::DataTransfer::Importer.new(
+          identity: users(:jason).identity,
+          zip: ZipFile::Reader.new(tempfile)
+        ).import
+      end
+    end
+  ensure
+    tempfile&.close!
+  end
+
+  test "exports only cards visible to a user with comments and their files" do
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("comment file"),
+      filename: "comment.txt",
+      content_type: "text/plain"
+    )
+    card.comments.create!(
+      creator: users(:david),
+      body: "With #{ActionText::Attachment.from_attachable(blob).to_html}"
+    )
+
+    tempfile = Tempfile.new([ "cards-export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    User::DataExport.new(users(:david)).export_to(writer)
+    writer.close
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+    card_payload = reader.glob("cards/*.json").map { |path| JSON.parse(reader.read(path)) }
+      .find { |attributes| attributes["id"] == card.id }
+
+    assert card_payload
+    assert card_payload["comments"].any?
+    assert card_payload["comments"].any? { |comment| comment["attachments"].any? }
+    assert reader.glob("files/*/*").any?
+  ensure
+    tempfile&.close!
+  end
+
+  private
+    def with_account_zip(account)
+      tempfile = Tempfile.new([ "account-export", ".zip" ])
+      tempfile.binmode
+      writer = ZipFile::Writer.new(tempfile)
+      Account::DataTransfer::Manifest.new(account).export_to(writer)
+      writer.close
+      tempfile.rewind
+      yield ZipFile::Reader.new(tempfile)
+    ensure
+      tempfile&.close!
+    end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..c6f3770
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  setup do
+    @source_account = accounts(:"37s")
+    @identity = users(:jason).identity
+    Current.session = sessions(:jason)
+  end
+
+  test "imports a zip into a new account and sends the completion email" do
+    archive = account_archive(@source_account)
+    account_import = @source_account.imports.create!(identity: @identity, file: archive)
+    imported = nil
+
+    assert_difference -> { Account.count }, 1 do
+      assert_enqueued_with(job: ActionMailer::MailDeliveryJob) do
+        account_import.process_now
+      end
+    end
+
+    account_import.reload
+    imported = account_import.imported_account
+    assert account_import.completed?
+    assert_equal @source_account.name, imported.name
+    assert_equal @source_account.cards.count, imported.cards.count
+    assert_not account_import.file.attached?
+    assert_no_difference(-> { Account.count }) { account_import.process_now }
+  ensure
+    imported&.destroy!
+    archive&.close!
+  end
+
+  test "a failed import keeps no new account and sends the reason" do
+    file = Tempfile.new([ "invalid-import", ".zip" ])
+    file.write("not a zip")
+    file.rewind
+    account_import = @source_account.imports.create!(identity: @identity, file: file)
+
+    assert_no_difference -> { Account.count } do
+      assert_enqueued_with(job: ActionMailer::MailDeliveryJob) do
+        account_import.process_now
+      end
+    end
+
+    assert account_import.reload.failed?
+    assert_match /ZIP|zip|import/i, account_import.error_message
+    assert_not account_import.file.attached?
+  ensure
+    file&.close!
+  end
+
+  private
+    def account_archive(account)
+      tempfile = Tempfile.new([ "account", ".zip" ])
+      tempfile.binmode
+      writer = ZipFile::Writer.new(tempfile)
+      Account::DataTransfer::Manifest.new(account).export_to(writer)
+      writer.close
+      tempfile.rewind
+      tempfile
+    end
+end
