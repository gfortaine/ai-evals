diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..e89f0d6 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -38,4 +38,50 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "reader reuses the variant processed after upload" do
+    expected_image = nil
+    file_fixture("white-rabbit.webp").open do |source|
+      ActiveStorage::Variation.new(format: :webp, resize_to_limit: [ 1500, 1500 ]).transform(source) do |output|
+        expected_image = output.binmode.read
+      end
+    end
+
+    transformations = 0
+    subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { transformations += 1 }
+
+    perform_enqueued_jobs(only: [ ActiveStorage::CreateVariantsJob, ActiveStorage::TransformJob ]) do
+      post book_pictures_path(books(:handbook), format: :turbo_stream), params: {
+        leaf: { title: "A new picture" },
+        picture: {
+          image: fixture_file_upload("white-rabbit.webp", "image/webp")
+        }
+      }
+    end
+
+    assert_response :success
+    assert_equal 1, transformations
+
+    picture = Picture.last
+    blob = picture.image.blob
+    assert_equal 1, blob.variant_records.count
+    books(:handbook).update!(published: true)
+    sign_out
+
+    get leafable_slug_path(picture.leaf)
+    assert_response :success
+    image_path = css_select("figure img").sole["src"]
+
+    get image_path
+    assert_response :redirect
+    follow_redirect!
+
+    assert_response :success
+    assert_equal expected_image, response.body
+    assert_equal 1, transformations
+    assert_equal 1, blob.variant_records.reload.count
+    assert blob.variant_records.sole.image.blob.service.exist?(blob.variant_records.sole.image.blob.key)
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+  end
 end
