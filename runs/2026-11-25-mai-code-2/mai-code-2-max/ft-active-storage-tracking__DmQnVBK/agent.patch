diff --git a/app/models/storage/usage.rb b/app/models/storage/usage.rb
new file mode 100644
index 0000000..acea778
--- /dev/null
+++ b/app/models/storage/usage.rb
@@ -0,0 +1,201 @@
+module Storage::Usage
+  CLAIM_DURATION = 5.minutes
+  RECORD_TYPES = %w[ Account Board ].freeze
+
+  class << self
+    def bytes_used(record)
+      if record.persisted?
+        ApplicationRecord.connected_to(role: :writing) do
+          values = record.class.where(id: record.id).pick(:bytes_used, :storage_usage_dirty, :storage_usage_job_claimed_at)
+
+          if values
+            claim_recalculation(record.class, record.id) if values.second && claim_due?(values.last)
+            values.first.to_i
+          else
+            record[:bytes_used].to_i
+          end
+        end
+      else
+        record[:bytes_used].to_i
+      end
+    end
+
+    def mark_board_dirty(board_id)
+      mark_dirty(Board, board_id)
+    end
+
+    def mark_account_dirty(account_id)
+      mark_dirty(Account, account_id)
+    end
+
+    def recalculate(record_type, record_id)
+      ApplicationRecord.connected_to(role: :writing) do
+        model = model_for(record_type)
+
+        3.times do
+          snapshot = snapshot_for(model, record_id)
+
+          return unless snapshot
+          return snapshot[:bytes_used] unless snapshot[:dirty]
+
+          calculated_bytes = if model == Board
+            bytes_for_board(snapshot[:id], snapshot[:account_id])
+          else
+            bytes_for_account(snapshot[:id])
+          end
+
+          if apply_snapshot(model, snapshot, calculated_bytes)
+            return calculated_bytes
+          end
+        end
+
+        enqueue_recalculation(model, record_id)
+        nil
+      end
+    end
+
+    def repairable(model)
+      model.where(storage_usage_dirty: true)
+        .where("storage_usage_job_claimed_at IS NULL OR storage_usage_job_claimed_at < ?", CLAIM_DURATION.ago)
+    end
+
+    def claim_for_repair(model, record_id)
+      claim_recalculation(model, record_id, enqueue: false)
+    end
+
+    def rebuild_account_later(account)
+      claimed_at = Time.current
+
+      account.class.transaction do
+        Board.where(account_id: account.id).update_all([
+          "storage_usage_dirty = ?, storage_usage_revision = storage_usage_revision + 1, storage_usage_job_claimed_at = ?",
+          true, claimed_at
+        ])
+        account.class.where(id: account.id).update_all([
+          "storage_usage_dirty = ?, storage_usage_revision = storage_usage_revision + 1, storage_usage_job_claimed_at = ?",
+          true, claimed_at
+        ])
+      end
+
+      ActiveRecord.after_all_transactions_commit do
+        Storage::Usage::RebuildJob.perform_later(account.id)
+      end
+    end
+
+    private
+      def claim_due?(claimed_at)
+        claimed_at.nil? || claimed_at < CLAIM_DURATION.ago
+      end
+
+      def mark_dirty(model, record_id)
+        updated = model.where(id: record_id).update_all([
+          "storage_usage_dirty = ?, storage_usage_revision = storage_usage_revision + 1",
+          true
+        ])
+        claim_recalculation(model, record_id) if updated.positive?
+      end
+
+      def claim_recalculation(model, record_id, enqueue: true)
+        claimed = model.where(id: record_id, storage_usage_dirty: true)
+          .where("storage_usage_job_claimed_at IS NULL OR storage_usage_job_claimed_at < ?", CLAIM_DURATION.ago)
+          .update_all(storage_usage_job_claimed_at: Time.current)
+
+        if claimed.positive? && enqueue
+          enqueue_recalculation(model, record_id)
+        end
+
+        claimed.positive?
+      end
+
+      def enqueue_recalculation(model, record_id)
+        ActiveRecord.after_all_transactions_commit do
+          Storage::UsageJob.perform_later(model.name, record_id)
+        end
+      end
+
+      def model_for(record_type)
+        if RECORD_TYPES.include?(record_type)
+          record_type.constantize
+        else
+          raise ArgumentError, "Unsupported storage usage record type: #{record_type}"
+        end
+      end
+
+      def snapshot_for(model, record_id)
+        if model == Board
+          if values = model.where(id: record_id).pick(
+            :id, :bytes_used, :storage_usage_revision, :storage_usage_dirty, :account_id
+          )
+            id, bytes_used, revision, dirty, account_id = values
+            { id: id, bytes_used: bytes_used, revision: revision, dirty: dirty, account_id: account_id }
+          end
+        elsif values = model.where(id: record_id).pick(
+          :id, :bytes_used, :storage_usage_revision, :storage_usage_dirty
+        )
+          id, bytes_used, revision, dirty = values
+          { id: id, bytes_used: bytes_used, revision: revision, dirty: dirty }
+        end
+      end
+
+      def apply_snapshot(model, snapshot, calculated_bytes)
+        updated = false
+
+        model.transaction do
+          updated = model.where(
+            id: snapshot[:id],
+            storage_usage_revision: snapshot[:revision],
+            storage_usage_dirty: true
+          ).update_all(
+            bytes_used: calculated_bytes,
+            storage_usage_dirty: false,
+            storage_usage_job_claimed_at: nil
+          ) > 0
+
+          if updated && model == Board && calculated_bytes != snapshot[:bytes_used]
+            mark_account_dirty(snapshot[:account_id])
+          end
+        end
+
+        updated
+      end
+
+      def bytes_for_account(account_id)
+        Board.where(account_id: account_id).sum(:bytes_used).to_i
+      end
+
+      def bytes_for_board(board_id, account_id)
+        card_ids = Card.where(account_id: account_id, board_id: board_id).select(:id)
+        comment_ids = Comment.where(account_id: account_id, card_id: card_ids).select(:id)
+
+        rich_texts = ActionText::RichText.where(account_id: account_id)
+        relevant_rich_text_ids = rich_texts
+          .where(record_type: "Board", record_id: board_id, name: "public_description")
+          .or(rich_texts.where(record_type: "Card", record_id: card_ids, name: "description"))
+          .or(rich_texts.where(record_type: "Comment", record_id: comment_ids, name: "body"))
+          .select(:id)
+
+        image_bytes = attachment_bytes(
+          account_id: account_id,
+          record_type: "Card",
+          record_ids: card_ids,
+          name: "image"
+        )
+        embed_bytes = attachment_bytes(
+          account_id: account_id,
+          record_type: "ActionText::RichText",
+          record_ids: relevant_rich_text_ids,
+          name: "embeds"
+        )
+
+        image_bytes + embed_bytes
+      end
+
+      def attachment_bytes(account_id:, record_type:, record_ids:, name:)
+        ActiveStorage::Attachment
+          .where(account_id: account_id, record_type: record_type, record_id: record_ids, name: name)
+          .joins(:blob)
+          .sum("active_storage_blobs.byte_size")
+          .to_i
+      end
+  end
+end
diff --git a/app/models/storage/usage/attachment_tracking.rb b/app/models/storage/usage/attachment_tracking.rb
new file mode 100644
index 0000000..8dd32fe
--- /dev/null
+++ b/app/models/storage/usage/attachment_tracking.rb
@@ -0,0 +1,108 @@
+module Storage::Usage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    before_create :remember_storage_usage_board_id
+    before_destroy :remember_storage_usage_board_id
+
+    after_create :track_storage_usage_change
+    after_destroy :track_storage_usage_change
+  end
+
+  def delete
+    board_id = remember_storage_usage_board_id
+    was_persisted = persisted?
+
+    self.class.transaction do
+      super.tap do
+        Storage::Usage.mark_board_dirty(board_id) if was_persisted && board_id
+      end
+    end
+  end
+
+  private
+    def remember_storage_usage_board_id
+      if defined?(@storage_usage_board_id_remembered)
+        @storage_usage_board_id
+      else
+        @storage_usage_board_id_remembered = true
+        @storage_usage_board_id = counted_board_id
+      end
+    end
+
+    def track_storage_usage_change
+      if board_id = remember_storage_usage_board_id
+        Storage::Usage.mark_board_dirty(board_id)
+      end
+    end
+
+    def counted_board_id
+      if record_type == "Card" && name == "image"
+        attachment_card&.board_id
+      elsif record_type == "ActionText::RichText" && name == "embeds"
+        if rich_text = attachment_rich_text
+          board_id_for_rich_text(rich_text)
+        end
+      end
+    end
+
+    def attachment_card
+      associated_record(Card)
+    end
+
+    def attachment_rich_text
+      associated_record(ActionText::RichText)
+    end
+
+    def associated_record(model)
+      association = association(:record)
+
+      if association.loaded? && association.target
+        association.target
+      else
+        model.find_by(id: record_id)
+      end
+    end
+
+    def board_id_for_rich_text(rich_text)
+      case [ rich_text.record_type, rich_text.name ]
+      when [ "Board", "public_description" ]
+        rich_text.record_id
+      when [ "Card", "description" ]
+        rich_text_card(rich_text)&.board_id
+      when [ "Comment", "body" ]
+        comment = rich_text_comment(rich_text)
+        comment && Card.where(id: comment.card_id).pick(:board_id)
+      end
+    end
+
+    def board_id_for_comment(comment)
+      if comment
+        association = comment.association(:card)
+
+        if association.loaded? && association.target
+          association.target.board_id
+        else
+          Card.where(id: comment.card_id).pick(:board_id)
+        end
+      end
+    end
+
+    def rich_text_card(rich_text)
+      rich_text_record(rich_text, Card)
+    end
+
+    def rich_text_comment(rich_text)
+      rich_text_record(rich_text, Comment)
+    end
+
+    def rich_text_record(rich_text, model)
+      association = rich_text.association(:record)
+
+      if association.loaded? && association.target
+        association.target
+      else
+        model.find_by(id: rich_text.record_id)
+      end
+    end
+end
