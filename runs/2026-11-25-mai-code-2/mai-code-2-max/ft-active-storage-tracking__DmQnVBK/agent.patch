new file mode 100644
index 0000000..9d7a6de
--- /dev/null
+++ b/app/jobs/storage/usage/rebuild_job.rb
@@ -0,0 +1,23 @@
+class Storage::Usage::RebuildJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  discard_on ActiveJob::DeserializationError
+
+  queue_as :backend
+  limits_concurrency key: ->(account_id, **) { [ :storage_usage_rebuild, account_id ] }
+
+  def perform(account_id, batch_size: 100)
+    ApplicationRecord.connected_to(role: :writing) do
+      step :boards do |step|
+        Board.where(account_id: account_id).find_each(start: step.cursor, batch_size: batch_size) do |board|
+          Storage::Usage.recalculate("Board", board.id)
+          step.advance! from: board.id
+        end
+      end
+
+      step :account do
+        Storage::Usage.recalculate("Account", account_id)
+      end
+    end
+  end
+end
diff --git a/app/jobs/storage/usage/repair_job.rb b/app/jobs/storage/usage/repair_job.rb
new file mode 100644
index 0000000..75da8ce
--- /dev/null
+++ b/app/jobs/storage/usage/repair_job.rb
@@ -0,0 +1,26 @@
+class Storage::Usage::RepairJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+  limits_concurrency key: "storage-usage-repair", on_conflict: :discard
+
+  def perform(batch_size: 100)
+    ApplicationRecord.connected_to(role: :writing) do
+      step :boards do |step|
+        repair_stale_records(Board, step, batch_size)
+      end
+
+      step :accounts do |step|
+        repair_stale_records(Account, step, batch_size)
+      end
+    end
+  end
+
+  private
+    def repair_stale_records(model, step, batch_size)
+      Storage::Usage.repairable(model).find_each(start: step.cursor, batch_size: batch_size) do |record|
+        Storage::Usage.recalculate(model.name, record.id) if Storage::Usage.claim_for_repair(model, record.id)
+        step.advance! from: record.id
+      end
+    end
+end
