+require "test_helper"
+
+class Storage::UsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+  end
+
+  test "counts card images and files embedded in board descriptions, card descriptions, and comments" do
+    board_blob = create_blob("board file")
+    image_blob = create_blob("card image")
+    description_blob = create_blob("card description file")
+    comment_blob = create_blob("comment file")
+
+    perform_enqueued_jobs only: Storage::UsageJob do
+      embed_in(@board, :public_description, board_blob)
+      cards(:logo).image.attach(image_blob)
+      embed_in(cards(:logo), :description, description_blob)
+      embed_in(comments(:logo_agreement_kevin), :body, comment_blob)
+    end
+
+    expected = [ board_blob, image_blob, description_blob, comment_blob ].sum(&:byte_size)
+
+    assert_equal expected, @board.bytes_used
+    assert_equal expected, @account.bytes_used
+  end
+
+  test "counts every board toward the account but only the board's own cards toward that board" do
+    writebook_blob = create_blob("writebook")
+    private_blob = create_blob("private")
+
+    perform_enqueued_jobs only: Storage::UsageJob do
+      embed_in(@board, :public_description, writebook_blob)
+      embed_in(boards(:private), :public_description, private_blob)
+    end
+
+    assert_equal writebook_blob.byte_size, @board.bytes_used
+    assert_equal private_blob.byte_size, boards(:private).bytes_used
+    assert_equal writebook_blob.byte_size + private_blob.byte_size, @account.bytes_used
+  end
+
+  test "ignores blobs attached outside the counted locations" do
+    blob = create_blob("outside")
+
+    perform_enqueued_jobs only: Storage::UsageJob do
+      users(:david).avatar.attach(blob)
+    end
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "updates usage in the background when an image is removed" do
+    blob = create_blob("image")
+
+    perform_enqueued_jobs only: Storage::UsageJob do
+      cards(:logo).image.attach(blob)
+    end
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+
+    cards(:logo).image.purge_later
+
+    assert_equal blob.byte_size, @board.bytes_used
+    run_storage_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "moves a card's attachments from one board's usage to another" do
+    blob = create_blob("image")
+
+    perform_enqueued_jobs only: Storage::UsageJob do
+      cards(:logo).image.attach(blob)
+    end
+
+    cards(:logo).move_to(boards(:private))
+    run_storage_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal blob.byte_size, boards(:private).bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+  end
+
+  test "coalesces repeated attachment changes into one board recalculation" do
+    blobs = 10.times.map { |index| create_blob("file #{index}") }
+
+    assert_enqueued_jobs 1, only: Storage::UsageJob do
+      blobs.each { |blob| embed_in(@board, :public_description, blob) }
+    end
+
+    run_storage_jobs
+
+    assert_equal blobs.last.byte_size, @board.bytes_used
+    assert_equal blobs.last.byte_size, @account.bytes_used
+  end
+
+  test "removes a deleted board's usage from its account" do
+    board = @account.boards.create!(name: "Temporary", creator: users(:david), all_access: true)
+    blob = create_blob("temporary")
+
+    perform_enqueued_jobs only: Storage::UsageJob do
+      embed_in(board, :public_description, blob)
+    end
+
+    assert_equal blob.byte_size, @account.bytes_used
+
+    board.destroy!
+    run_storage_jobs
+
+    assert_equal 0, @account.bytes_used
+  end
+
+  private
+    def create_blob(contents)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(contents),
+        filename: "file.txt",
+        content_type: "text/plain"
+      )
+    end
+
+    def embed_in(record, attribute, blob)
+      attachment = ActionText::Attachment.from_attachable(blob)
+      record.update!(attribute => attachment.to_html)
+    end
+
+    def run_storage_jobs
+      2.times { perform_enqueued_jobs only: Storage::UsageJob }
+    end
+end
