diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..17d3700 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,47 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "releasing a book caches its final title" do
+    with_memory_cache do
+      book = books(:manual)
+
+      Book.finalize_release book.id, title: "The Final Manual"
+
+      assert_equal({ title: "The Final Manual", published: true }, book.cached_recap)
+    end
+  end
+
+  test "recaps are cached per book" do
+    with_memory_cache do
+      handbook = books(:handbook)
+      manual = books(:manual)
+
+      handbook.update! title: "Updated Handbook"
+      manual.update! title: "Updated Manual"
+
+      assert_equal "Updated Handbook", handbook.cached_recap[:title]
+      assert_equal "Updated Manual", manual.cached_recap[:title]
+    end
+  end
+
+  test "recaps expire on the configured schedule" do
+    with_memory_cache do
+      book = books(:manual)
+      book.update! title: "Recently Updated Manual"
+
+      travel Rails.application.config.x.recap.expires_in + 1.second
+
+      assert_nil book.cached_recap
+    end
+  end
+
+  private
+    def with_memory_cache
+      original_cache = Rails.cache
+      Rails.cache = ActiveSupport::Cache::MemoryStore.new
+      yield
+    ensure
+      Rails.cache = original_cache
+    end
 end
