diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..f77527f
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,19 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders a raw UTC timestamp for client-side formatting" do
+    time = Time.zone.local(2026, 9, 12, 13, 42)
+    rendered = Nokogiri::HTML::DocumentFragment.parse(local_time(time, format: :friendly))
+    timestamp = "2026-09-12T13:42:00Z"
+
+    assert_select rendered, "time.local-time-value[datetime='#{timestamp}'][data-controller='local-time'][data-local-time-format-value='friendly']", text: timestamp
+  end
+
+  test "preserves attributes passed to the time tag" do
+    rendered = Nokogiri::HTML::DocumentFragment.parse(
+      local_time(Time.current, format: :relative, class: "card-time", data: { controller: "tooltip" })
+    )
+
+    assert_select rendered, "time.local-time-value.card-time[data-controller='tooltip local-time']"
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..db155cc
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,53 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "formats timestamps in the browser" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    sign_in_as users(:david)
+
+    page.execute_script <<~JS
+      const addTime = (id, date, format) => {
+        const time = document.createElement("time")
+        time.id = id
+        time.dateTime = date.toISOString()
+        time.textContent = time.dateTime
+        time.dataset.controller = "local-time"
+        time.dataset.localTimeFormatValue = format
+        document.body.appendChild(time)
+      }
+
+      addTime("local-time-timezone", new Date("2026-09-12T13:42:00Z"), "time")
+
+      const today = new Date()
+      today.setHours(13, 42, 0, 0)
+      addTime("local-time-today", today, "friendly")
+
+      const yesterday = new Date()
+      yesterday.setDate(yesterday.getDate() - 1)
+      addTime("local-time-yesterday", yesterday, "friendly")
+
+      const fiveDaysAgo = new Date()
+      fiveDaysAgo.setDate(fiveDaysAgo.getDate() - 5)
+      addTime("local-time-five-days-ago", fiveDaysAgo, "friendly")
+
+      const septemberTwelfth = new Date(today.getFullYear() - 1, 8, 12, 12)
+      addTime("local-time-date", septemberTwelfth, "friendly")
+
+      const tomorrow = new Date()
+      tomorrow.setDate(tomorrow.getDate() + 1)
+      addTime("local-time-tomorrow", tomorrow, "relative")
+
+      const inThreeDays = new Date()
+      inThreeDays.setDate(inThreeDays.getDate() + 3)
+      addTime("local-time-three-days", inThreeDays, "relative")
+    JS
+
+    assert_selector "#local-time-timezone", text: "6:42 AM", exact_text: true
+    assert_selector "#local-time-today", text: "1:42 PM", exact_text: true
+    assert_selector "#local-time-yesterday", text: "yesterday", exact_text: true
+    assert_selector "#local-time-five-days-ago", text: "5 days ago", exact_text: true
+    assert_selector "#local-time-date", text: "Sep 12", exact_text: true
+    assert_selector "#local-time-tomorrow", text: "tomorrow", exact_text: true
+    assert_selector "#local-time-three-days", text: "in 3 days", exact_text: true
+  end
+end
