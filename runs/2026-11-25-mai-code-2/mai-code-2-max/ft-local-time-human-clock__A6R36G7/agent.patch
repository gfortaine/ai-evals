diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..8488e07
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,33 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #observer
+  #timer
+
+  connect() {
+    this.#observer = new MutationObserver(this.update.bind(this))
+    this.#observer.observe(this.element, { attributeFilter: [ "datetime" ], attributes: true })
+
+    this.update()
+    this.#timer = setInterval(this.update.bind(this), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    this.#observer.disconnect()
+    clearInterval(this.#timer)
+  }
+
+  update() {
+    const date = new Date(this.element.dateTime)
+    const text = formatLocalTime(date, this.formatValue)
+    const title = formatLocalTime(date, "full_datetime")
+
+    if (this.element.textContent !== text) this.element.textContent = text
+    if (this.element.title !== title) this.element.title = title
+  }
+}
diff --git a/app/javascript/controllers/timezone_controller.js b/app/javascript/controllers/timezone_controller.js
new file mode 100644
index 0000000..666b200
--- /dev/null
+++ b/app/javascript/controllers/timezone_controller.js
@@ -0,0 +1,25 @@
+import { Controller } from "@hotwired/stimulus"
+import { patch } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  async connect() {
+    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone
+    const updateUrl = getMetaContent("timezone-update-url")
+    const userId = getMetaContent("current-user-id")
+    const storageKey = `timezone:${updateUrl}:${userId}`
+
+    if (updateUrl && sessionStorage.getItem(storageKey) !== timezone) {
+      const response = await patch(updateUrl, {
+        body: { timezone_name: timezone },
+        responseKind: "json"
+      })
+
+      if (response.ok) {
+        sessionStorage.setItem(storageKey, timezone)
+      } else {
+        throw new Error(`Failed to update timezone (${response.statusCode})`)
+      }
+    }
+  }
+}
