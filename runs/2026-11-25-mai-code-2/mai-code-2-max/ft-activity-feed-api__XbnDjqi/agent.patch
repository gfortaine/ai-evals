diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..b0d4b79
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,158 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns the API event representation in reverse chronological order" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    expected_ids = users(:kevin).accessible_events
+      .where(action: ActivitiesController::ACTIVITY_ACTIONS)
+      .order(created_at: :desc, id: :desc)
+      .pluck(:id)
+    assert_equal expected_ids, @response.parsed_body.pluck("id")
+
+    event = events(:logo_published)
+    json_event = @response.parsed_body.find { |activity| activity["id"] == event.id }
+
+    assert_equal %w[ action board created_at creator description eventable eventable_type id particulars url ].sort, json_event.keys.sort
+    assert_equal event.action, json_event["action"]
+    assert_equal event.created_at.utc.iso8601(3), json_event["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, json_event["description"]
+    assert_equal event.eventable_type, json_event["eventable_type"]
+    assert_equal event.eventable_id, json_event.dig("eventable", "id")
+    assert_equal event.board_id, json_event.dig("board", "id")
+    assert_equal event.creator_id, json_event.dig("creator", "id")
+    assert_equal card_url(event.eventable), json_event["url"]
+  end
+
+  test "index defaults to JSON" do
+    get activities_path
+
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+  end
+
+  test "index uses the requested action set" do
+    deprecated_event = events(:logo_published)
+    title_change = events(:text_published)
+    deprecated_event.update!(action: "card_collection_changed")
+    title_change.update!(action: "card_title_changed")
+
+    get activities_path, as: :json
+
+    event_ids = @response.parsed_body.pluck("id")
+    assert_includes event_ids, title_change.id
+    assert_not_includes event_ids, deprecated_event.id
+  end
+
+  test "index serializes event particulars" do
+    assignment = events(:logo_assignment_jz)
+    board_change = events(:layout_published)
+    title_change = events(:text_published)
+    triage = events(:shipping_published)
+    other = events(:logo_published)
+
+    board_change.update_columns(action: "card_board_changed", particulars: { "particulars" => { "new_board" => "Destination" } })
+    title_change.update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old title" } })
+    triage.update_columns(action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+
+    activities = @response.parsed_body.index_by { |activity| activity["id"] }
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activities.dig(assignment.id, "particulars"))
+    assert_equal({ "old_board" => "", "new_board" => "Destination" }, activities.dig(board_change.id, "particulars"))
+    assert_equal({ "old_title" => "Old title", "new_title" => "" }, activities.dig(title_change.id, "particulars"))
+    assert_equal({ "column" => "" }, activities.dig(triage.id, "particulars"))
+    assert_empty activities.dig(other.id, "particulars")
+  end
+
+  test "index links comment activity to its comment on the card" do
+    event = events(:layout_commented)
+
+    get activities_path, as: :json
+
+    json_event = @response.parsed_body.find { |activity| activity["id"] == event.id }
+    assert_equal polymorphic_url(event.eventable), json_event["url"]
+    assert_equal event.eventable.id, json_event.dig("eventable", "id")
+    assert_equal "Comment", json_event["eventable_type"]
+  end
+
+  test "index filters by creator and board" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:kevin).id }
+    assert @response.parsed_body.present?
+
+    private_card = Card.create!(board: boards(:private), creator: users(:kevin), title: "Private", status: :drafted)
+    private_event = Event.create!(board: boards(:private), creator: users(:kevin), eventable: private_card, action: "card_published")
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+  end
+
+  test "index only returns accessible activity" do
+    private_card = Card.create!(board: boards(:private), creator: users(:kevin), title: "Private", status: :drafted)
+    private_event = Event.create!(board: boards(:private), creator: users(:kevin), eventable: private_card, action: "card_published")
+
+    logout_and_sign_in_as :jason
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+    assert @response.parsed_body.all? { |activity| users(:jason).board_ids.include?(activity.dig("board", "id")) }
+  end
+
+  test "index paginates a flat array newest first" do
+    insert_events
+
+    expected_ids = users(:kevin).accessible_events
+      .where(action: ActivitiesController::ACTIVITY_ACTIONS)
+      .order(created_at: :desc, id: :desc)
+      .pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+      assert_kind_of Array, @response.parsed_body
+
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_equal expected_ids.count.to_s, @response.headers["X-Total-Count"]
+  end
+
+  private
+    def insert_events
+      now = Time.current
+      Event.insert_all!(20.times.map do |index|
+        {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: accounts("37s").id,
+          action: "card_published",
+          board_id: boards(:writebook).id,
+          creator_id: users(:kevin).id,
+          eventable_id: cards(:text).id,
+          eventable_type: "Card",
+          particulars: {},
+          created_at: now - index.seconds,
+          updated_at: now - index.seconds
+        }
+      end)
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
