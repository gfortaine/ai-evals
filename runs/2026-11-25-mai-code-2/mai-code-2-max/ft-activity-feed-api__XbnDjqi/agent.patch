@@ -0,0 +1,44 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from filtered_events
+      end
+    end
+  end
+
+  private
+    def filtered_events
+      events = Current.user.accessible_events.preloaded.where(action: ACTIVITY_ACTIONS)
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events = events.where(board_id: board_ids) if board_ids.present?
+      events.order(created_at: :desc, id: :desc)
+    end
+
+    def creator_ids
+      @creator_ids ||= filter_ids(:creator_ids)
+    end
+
+    def board_ids
+      @board_ids ||= filter_ids(:board_ids)
+    end
+
+    def filter_ids(key)
+      Array(params[key]).compact_blank
+    end
+end
diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..47aed71 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,29 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def activity_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(activity_particular_values[:assignee_ids]) }
+    when "card_board_changed"
+      { old_board: activity_particular_value(:old_board), new_board: activity_particular_value(:new_board) }
+    when "card_title_changed"
+      { old_title: activity_particular_value(:old_title), new_title: activity_particular_value(:new_title) }
+    when "card_triaged"
+      { column: activity_particular_value(:column) }
+    else
+      {}
+    end
+  end
+
+  private
+    def activity_particular_value(key)
+      activity_particular_values[key].to_s
+    end
+
+    def activity_particular_values
+      values = (particulars || {}).with_indifferent_access
+      values[:particulars] || values
+    end
 end
