diff --git a/test/unit/lib/redmine/rails_compatibility_test.rb b/test/unit/lib/redmine/rails_compatibility_test.rb
new file mode 100644
index 0000000..1cd3873
--- /dev/null
+++ b/test/unit/lib/redmine/rails_compatibility_test.rb
@@ -0,0 +1,89 @@
+# frozen_string_literal: true
+
+require_relative '../../../test_helper'
+require 'rack/mock'
+
+class RailsCompatibilityTest < ActiveSupport::TestCase
+  COOKIE_NAME = '_redmine_upgrade_compatibility'
+  COOKIE_DATA = {'user_id' => 2, 'nested' => {'value' => 'ok'}}.freeze
+
+  def test_legacy_encrypted_cookie_is_read_and_rewritten
+    request = request_with_cookie(legacy_cookie)
+
+    assert_equal COOKIE_DATA, request.cookie_jar.encrypted[COOKIE_NAME]
+    assert_not_equal legacy_cookie, request.cookie_jar[COOKIE_NAME]
+    assert_equal COOKIE_DATA, request_with_cookie(request.cookie_jar[COOKIE_NAME]).cookie_jar.encrypted[COOKIE_NAME]
+  end
+
+  def test_rails_7_encrypted_cookie_is_read
+    assert_equal COOKIE_DATA, request_with_cookie(rails_7_cookie).cookie_jar.encrypted[COOKIE_NAME]
+  end
+
+  def test_cookie_written_by_this_bundle_uses_the_rails_7_format
+    request = request_with_cookie
+    request.cookie_jar.encrypted[COOKIE_NAME] = {:value => COOKIE_DATA}
+    serialized = rails_7_encryptor.decrypt_and_verify(
+      request.cookie_jar[COOKIE_NAME],
+      :purpose => "cookie.#{COOKIE_NAME}"
+    )
+
+    assert_equal COOKIE_DATA, ActionDispatch::Cookies::JsonSerializer.load(serialized)
+  end
+
+  private
+
+  def request_with_cookie(value = nil)
+    headers = {}
+    if value
+      headers['HTTP_COOKIE'] = "#{COOKIE_NAME}=#{Rack::Utils.escape(value)}"
+    end
+    env = Rack::MockRequest.env_for('/', headers)
+    env.update(Rails.application.env_config)
+    ActionDispatch::Request.new(env)
+  end
+
+  def legacy_cookie
+    @legacy_cookie ||=
+      legacy_encryptor.encrypt_and_sign(
+        ActionDispatch::Cookies::MarshalWithJsonFallback.dump(COOKIE_DATA)
+      )
+  end
+
+  def rails_7_cookie
+    @rails_7_cookie ||=
+      rails_7_encryptor.encrypt_and_sign(
+        ActionDispatch::Cookies::JsonSerializer.dump(COOKIE_DATA),
+        :purpose => "cookie.#{COOKIE_NAME}"
+      )
+  end
+
+  def legacy_encryptor
+    generator = ActiveSupport::KeyGenerator.new(
+      Rails.application.secret_key_base,
+      :iterations => 1000,
+      :hash_digest_class => OpenSSL::Digest::SHA1
+    )
+    dispatch = Rails.application.config.action_dispatch
+    ActiveSupport::MessageEncryptor.new(
+      generator.generate_key(dispatch.encrypted_cookie_salt, 32),
+      generator.generate_key(dispatch.encrypted_signed_cookie_salt),
+      :cipher => 'aes-256-cbc',
+      :digest => 'SHA1',
+      :serializer => ActiveSupport::MessageEncryptor::NullSerializer
+    )
+  end
+
+  def rails_7_encryptor
+    generator = ActiveSupport::KeyGenerator.new(
+      Rails.application.secret_key_base,
+      :iterations => 1000,
+      :hash_digest_class => OpenSSL::Digest::SHA256
+    )
+    dispatch = Rails.application.config.action_dispatch
+    ActiveSupport::MessageEncryptor.new(
+      generator.generate_key(dispatch.authenticated_encrypted_cookie_salt, 32),
+      :cipher => 'aes-256-gcm',
+      :serializer => ActiveSupport::MessageEncryptor::NullSerializer
+    )
+  end
+end
diff --git a/test/unit/mailer_mail_links_test.rb b/test/unit/mailer_mail_links_test.rb
