diff --git a/lib/redmine/rails_compatibility.rb b/lib/redmine/rails_compatibility.rb
new file mode 100644
index 0000000..0097c50
--- /dev/null
+++ b/lib/redmine/rails_compatibility.rb
@@ -0,0 +1,95 @@
+# frozen_string_literal: true
+
+require 'openssl'
+require 'active_support/key_generator'
+
+module Redmine
+  module RailsCompatibility
+    module JsonCookieSerializerCompatibility
+      def load(value)
+        super
+      rescue JSON::ParserError
+        raise unless value.start_with?(ActionDispatch::Cookies::SerializedCookieJars::MARSHAL_SIGNATURE)
+
+        ActionDispatch::Cookies::MarshalWithJsonFallback.load(value)
+      end
+    end
+
+    module Rails61KeyGeneratorHashDigest
+      def initialize(secret, options = {})
+        @hash_digest_class =
+          options[:hash_digest_class] ||
+          Rails.application.config.active_support.key_generator_hash_digest_class
+        super
+      end
+
+      def generate_key(salt, key_size = 64)
+        return super unless @hash_digest_class
+
+        OpenSSL::PKCS5.pbkdf2_hmac(
+          @secret,
+          salt,
+          @iterations,
+          key_size,
+          @hash_digest_class.new
+        )
+      end
+    end
+
+    if Rails::VERSION::MAJOR == 6
+      ActiveSupport::KeyGenerator.prepend(Rails61KeyGeneratorHashDigest)
+    end
+
+    class << self
+      def install!
+        install_json_cookie_serializer_compatibility
+        install_cookie_rotations
+        install_mail_link_verifier_rotation
+      end
+
+      private
+
+      def install_json_cookie_serializer_compatibility
+        return unless Rails::VERSION::MAJOR >= 7
+
+        ActionDispatch::Cookies::JsonSerializer.singleton_class.prepend(
+          JsonCookieSerializerCompatibility
+        )
+      end
+
+      def install_cookie_rotations
+        dispatch = Rails.application.config.action_dispatch
+        rotations = dispatch.cookies_rotations
+        generator = legacy_key_generator
+        rotations.rotate(
+          :signed,
+          generator.generate_key(dispatch.signed_cookie_salt),
+          digest: 'SHA1'
+        )
+        rotations.rotate(
+          :encrypted,
+          generator.generate_key(dispatch.encrypted_cookie_salt, 32),
+          generator.generate_key(dispatch.encrypted_signed_cookie_salt),
+          cipher: 'aes-256-cbc',
+          digest: 'SHA1'
+        )
+      end
+
+      def install_mail_link_verifier_rotation
+        Rails.application.message_verifier(:mail_links).rotate(
+          legacy_key_generator.generate_key('mail_links'),
+          digest: 'SHA1',
+          serializer: Marshal
+        )
+      end
+
+      def legacy_key_generator
+        ActiveSupport::KeyGenerator.new(
+          Rails.application.secret_key_base,
+          iterations: 1000,
+          hash_digest_class: OpenSSL::Digest::SHA1
+        )
+      end
+    end
+  end
+end
