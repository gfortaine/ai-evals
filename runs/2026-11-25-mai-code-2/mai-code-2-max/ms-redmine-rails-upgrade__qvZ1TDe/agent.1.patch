@@ -41,4 +41,34 @@ class MailerMailLinksTest < ActiveSupport::TestCase
 
     assert_include 'mail_links/unwatch', mail.text_part.body.decoded
   end
+
+  def test_unwatch_token_from_before_the_framework_upgrade_still_verifies
+    data = {'user_id' => 3, 'issue_id' => 2}
+    token = legacy_mail_link_verifier.generate(data, :purpose => :unwatch, :expires_in => 30.days)
+
+    assert_equal data, Mailer.verify_mail_link(token, :unwatch)
+  end
+
+  def test_unwatch_token_verifies_with_the_rails_7_key_generator
+    token = Mailer.mail_link_token(:unwatch, 'user_id' => 3, 'issue_id' => 2)
+    key_generator = ActiveSupport::KeyGenerator.new(
+      Rails.application.secret_key_base,
+      :iterations => 1000,
+      :hash_digest_class => OpenSSL::Digest::SHA256
+    )
+    verifier = ActiveSupport::MessageVerifier.new(key_generator.generate_key('mail_links'))
+
+    assert_equal({'user_id' => 3, 'issue_id' => 2}, verifier.verify(token, :purpose => :unwatch))
+  end
+
+  private
+
+  def legacy_mail_link_verifier
+    key_generator = ActiveSupport::KeyGenerator.new(
+      Rails.application.secret_key_base,
+      :iterations => 1000,
+      :hash_digest_class => OpenSSL::Digest::SHA1
+    )
+    ActiveSupport::MessageVerifier.new(key_generator.generate_key('mail_links'))
+  end
 end
