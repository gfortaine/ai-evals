diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..2627490
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts("37s")
+    @initiated_by = users(:jason)
+  end
+
+  test "permanently removes accounts cancelled more than 30 days ago" do
+    Account::Cancellation.create!(
+      account: @account,
+      initiated_by: @initiated_by,
+      created_at: 31.days.ago
+    )
+
+    card = cards(:logo)
+    card.image.attach io: StringIO.new("incinerate me"), filename: "incinerate.txt", content_type: "text/plain"
+    blob_id = card.image.blob.id
+    account_id = @account.id
+    board_ids = @account.boards.ids
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account_id)
+    assert_not ActiveStorage::Blob.exists?(blob_id)
+    assert_not Storage::Total.where(owner: @account).exists?
+    assert_not Storage::Total.where(owner_type: "Board", owner_id: board_ids).exists?
+
+    account_record_classes.each do |record_class|
+      assert_not record_class.where(account_id: account_id).exists?, "#{record_class} records remain for incinerated account"
+    end
+
+    assert_not Search::Record.for(account_id).where(account_id: account_id).exists?
+  end
+
+  test "keeps accounts cancelled within the grace period" do
+    freeze_time do
+      Account::Cancellation.create!(
+        account: @account,
+        initiated_by: @initiated_by,
+        created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago
+      )
+
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert Account.exists?(@account.id)
+      assert Account.exists?(accounts(:initech).id)
+    end
+  end
+
+  private
+    def account_record_classes
+      [
+        Access,
+        Account::Cancellation,
+        Account::Import,
+        Account::JoinCode,
+        ActionText::RichText,
+        ActiveStorage::Attachment,
+        ActiveStorage::Blob,
+        ActiveStorage::VariantRecord,
+        Assignment,
+        Board::Publication,
+        Board,
+        Card::ActivitySpike,
+        Card::Goldness,
+        Card::NotNow,
+        Card,
+        Closure,
+        Column,
+        Comment,
+        Entropy,
+        Event,
+        Export,
+        Filter,
+        Mention,
+        Notification::Bundle,
+        Notification,
+        Pin,
+        Push::Subscription,
+        Reaction,
+        Search::Query,
+        Step,
+        Storage::Entry,
+        Tagging,
+        Tag,
+        User::Settings,
+        User,
+        Watch,
+        Webhook::Delivery,
+        Webhook::DelinquencyTracker,
+        Webhook
+      ]
+    end
+end
