diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..0888838 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,36 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> {
+      joins(:cancellation)
+        .where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    incinerated = false
+
+    with_lock do
+      if incineration_due?
+        Search::Record.for(id).where(account_id: id).destroy_all
+        destroy!
+        incinerated = true
+      end
+    end
+
+    ActiveStorage::Blob.where(account_id: id).find_each(&:purge) if incinerated
+  end
+
+  def incineration_due?
+    cancellation.present? && cancellation.created_at.before?(INCINERATION_GRACE_PERIOD.ago)
+  end
 end
