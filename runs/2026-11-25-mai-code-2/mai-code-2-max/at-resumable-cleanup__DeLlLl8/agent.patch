+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  test "resumes after the last cleaned leaf" do
+    leaves = Leaf.order(:id).to_a
+    clean_titles = [ %q("Welcome"), "Introduction", "A " + %q("quoted") + " title", "Summary" ]
+    leaves.zip(clean_titles).each do |leaf, title|
+      leaf.update!(title: %Q("#{title}"))
+    end
+
+    TitleCleanupJob.perform_later
+    interrupt_job_during_step(TitleCleanupJob, :cleanup_titles, cursor: leaves.first.id.succ) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal clean_titles.first, leaves.first.reload.title
+    assert_equal %Q("#{clean_titles.second}"), leaves.second.reload.title
+    assert_nil enqueued_jobs.last[:at]
+
+    perform_enqueued_jobs
+
+    assert_equal clean_titles, leaves.map { it.reload.title }
+  end
+
+  test "keeps a legitimate opening quote when redoing the current leaf" do
+    leaf = Leaf.order(:id).last
+    title = %q("Welcome" to the handbook)
+    leaf.update!(title: title)
+
+    job = TitleCleanupJob.new
+    job_data = job.serialize.merge(
+      "continuation" => { "current" => [ "cleanup_titles", leaf.id ] }
+    )
+
+    TitleCleanupJob.execute(job_data)
+
+    assert_equal title, leaf.reload.title
+  end
+
+  test "exposes worker shutdown to continuable jobs" do
+    worker = Resque::Worker.new(:default)
+    worker.fork_per_job = false
+    worker.shutdown
+
+    stopping = false
+    job = Object.new
+    job.define_singleton_method(:perform) do
+      stopping = ActiveJob::Base.queue_adapter.stopping?
+    end
+
+    worker.perform(job)
+
+    assert stopping
+    assert_not ActiveJob::Base.queue_adapter.stopping?
+  end
+end
