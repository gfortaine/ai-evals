diff --git a/lib/rails_ext/resque_job_continuation.rb b/lib/rails_ext/resque_job_continuation.rb
new file mode 100644
index 0000000..052ddac
--- /dev/null
+++ b/lib/rails_ext/resque_job_continuation.rb
@@ -0,0 +1,14 @@
+# Resque records graceful shutdown on the worker, outside Active Job's adapter.
+module ResqueJobContinuation
+  def perform(...)
+    adapter = ActiveJob::Base.queue_adapter
+    previous_stopping = adapter.stopping
+    adapter.stopping = -> { shutdown? }
+
+    super
+  ensure
+    adapter.stopping = previous_stopping if adapter
+  end
+end
+
+Resque::Worker.prepend ResqueJobContinuation
