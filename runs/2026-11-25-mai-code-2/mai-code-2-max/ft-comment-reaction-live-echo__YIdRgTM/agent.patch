diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..e320e42
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "content is normalized and limited to 16 characters" do
+    reaction = comments(:logo_agreement_jz).reactions.build(content: "  Nicely done  ")
+
+    assert reaction.save
+    assert_equal "Nicely done", reaction.content
+
+    reaction.content = "x" * 17
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "content cannot be blank" do
+    reaction = comments(:logo_agreement_jz).reactions.build(content: "   ")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "creating and destroying reactions touch the card and broadcast a refresh" do
+    comment = comments(:logo_agreement_jz)
+    reaction = nil
+
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts comment.card do
+        reaction = comment.reactions.create!(content: "👏")
+      end
+
+      assert_turbo_stream_broadcasts comment.card do
+        reaction.destroy!
+      end
+    end
+  end
+
+  test "recognizes emoji-only reactions" do
+    assert Reaction.new(content: "👍").emoji?
+    assert Reaction.new(content: "👨‍👩‍👧‍👦").emoji?
+    assert_not Reaction.new(content: "Love it").emoji?
+  end
+end
