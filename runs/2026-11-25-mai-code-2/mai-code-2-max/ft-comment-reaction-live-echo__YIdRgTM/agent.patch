new file mode 100644
index 0000000..5d210ad
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,50 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params)
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render :show, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { head :unprocessable_entity }
+        format.json { render json: { errors: @reaction.errors }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden if Current.user != @reaction.creator
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..23cd5b3
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,34 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { creatorId: String }
+
+  connect() {
+    if (this.isOwned) {
+      this.element.setAttribute("role", "button")
+      this.element.tabIndex = 0
+    } else {
+      this.element.classList.remove("reaction--deleteable")
+      this.element.removeAttribute("aria-expanded")
+    }
+  }
+
+  toggle(event) {
+    if (!this.isOwned || event.target.closest("a, button, form")) return
+
+    const expanded = this.element.classList.toggle("expanded")
+    this.element.setAttribute("aria-expanded", expanded)
+  }
+
+  deleting() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  finishDeleting(event) {
+    if (!event.detail.success) this.element.classList.remove("reaction--deleting")
+  }
+
+  get isOwned() {
+    return window.Current?.user?.id === this.creatorIdValue
+  }
+}
