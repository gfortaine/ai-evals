--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,20 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+
+  EMOJI_ONLY_PATTERN = /\A[\p{Extended_Pictographic}\p{Emoji_Presentation}\p{Emoji_Modifier}\p{Regional_Indicator}\u{200d fe0e fe0f 20e3}0-9#*]+\z/u
+  EMOJI_PATTERN = /[\p{Extended_Pictographic}\p{Emoji_Presentation}\p{Regional_Indicator}\u{20e3}]/u
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  normalizes :content, with: -> { it.strip }
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  def emoji?
+    content.present? && content.match?(EMOJI_ONLY_PATTERN) && content.match?(EMOJI_PATTERN)
+  end
+end
