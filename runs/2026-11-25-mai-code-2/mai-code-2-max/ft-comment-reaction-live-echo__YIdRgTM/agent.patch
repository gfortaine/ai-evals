+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "add, cancel, and remove your reaction" do
+    comment = comments(:logo_agreement_jz)
+    visit card_url(comment.card)
+
+    within "##{dom_id(comment, :reactions)}" do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Not saved"
+      click_on "Cancel reaction"
+
+      assert_selector "button.reactions__trigger", visible: :visible
+    end
+
+    assert_not Reaction.exists?(content: "Not saved")
+
+    within "##{dom_id(comment, :reactions)}" do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Ship it"
+      click_on "Confirm reaction"
+
+      assert_selector ".reaction", text: "Ship it"
+      assert_selector "button.reactions__trigger", visible: :visible
+    end
+
+    reaction = Reaction.find_by!(content: "Ship it")
+
+    within "##{dom_id(reaction)}" do
+      find("span.txt-small").click
+      assert_selector ".reaction__delete", visible: :visible
+      find("button[aria-label='Remove your reaction']").click
+    end
+
+    assert_no_selector "##{dom_id(reaction)}"
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "reactions appear and disappear for other viewers without reloading" do
+    comment = comments(:logo_agreement_jz)
+    visit card_url(comment.card)
+    wait_for_cable_subscriptions
+
+    within "##{dom_id(comment, :reactions)}" do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Draft reaction"
+    end
+
+    reaction = comment.reactions.create!(creator: users(:kevin), content: "Live")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within "##{dom_id(comment, :reactions)}" do
+      assert_field "Your reaction", with: "Draft reaction", visible: :visible
+    end
+
+    assert_selector "##{dom_id(reaction)}", text: "Live", wait: 5
+
+    reaction.destroy!
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_no_selector "##{dom_id(reaction)}", wait: 5
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
