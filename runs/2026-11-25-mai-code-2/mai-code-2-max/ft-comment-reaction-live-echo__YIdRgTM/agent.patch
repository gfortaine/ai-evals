diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..14c09da
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment),
+        params: { reaction: { content: "Great" } },
+        as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(comment, :reactions)
+    assert_equal users(:kevin), comment.reactions.order(:created_at).last.creator
+    assert_equal accounts(:"37s"), comment.reactions.order(:created_at).last.account
+  end
+
+  test "create rejects reactions longer than 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(comment.card, comment),
+        params: { reaction: { content: "x" * 17 } },
+        as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create as JSON with flat params" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment), params: { content: "👏" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👏", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("creator", "id")
+  end
+
+  test "destroy" do
+    reaction = comments(:logo_agreement_jz).reactions.create!(creator: users(:kevin), content: "+1")
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(reaction.comment, :reactions)
+  end
+
+  test "cannot destroy another user's reaction" do
+    reaction = comments(:logo_agreement_jz).reactions.create!(creator: users(:jz), content: "+1")
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+end
