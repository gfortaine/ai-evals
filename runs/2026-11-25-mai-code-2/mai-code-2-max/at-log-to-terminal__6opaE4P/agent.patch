index 0000000..ecf2c1d
--- /dev/null
+++ b/test/scripts/library_report_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  test "broadcasts the report to stdout and the application logger" do
+    log_output = StringIO.new
+    application_logger = ActiveSupport::Logger.new(log_output)
+    application_logger.formatter = proc do |severity, _time, _program, message|
+      "#{severity}: #{message}\n"
+    end
+
+    original_logger = Rails.logger
+    Rails.logger = application_logger
+    begin
+      stdout, = capture_io do
+        load Rails.root.join("script/library_report.rb")
+      end
+    ensure
+      Rails.logger = original_logger
+    end
+
+    reports = [
+      [ :info, "Library report: 2 books" ],
+      *Book.order(:id).map do |book|
+        pages = book.leaves.count
+        if pages.zero?
+          [ :warn, "Library report: #{book.title} has no pages" ]
+        else
+          [ :info, "Library report: #{book.title} has #{pages} #{"page".pluralize(pages)}" ]
+        end
+      end,
+      [ :info, "Library report: done" ]
+    ]
+
+    assert_equal reports.map(&:last).join("\n") + "\n", stdout
+    assert_equal reports.map { |severity, message| "#{severity.to_s.upcase}: #{message}" },
+      log_output.string.lines(chomp: true)
+  end
+end
