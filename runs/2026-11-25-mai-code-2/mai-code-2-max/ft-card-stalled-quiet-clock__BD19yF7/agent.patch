diff --git a/db/migrate/20261124235422_add_last_burst_at_to_cards.rb b/db/migrate/20261124235422_add_last_burst_at_to_cards.rb
new file mode 100644
index 0000000..b453689
--- /dev/null
+++ b/db/migrate/20261124235422_add_last_burst_at_to_cards.rb
@@ -0,0 +1,111 @@
+class AddLastBurstAtToCards < ActiveRecord::Migration[8.2]
+  class Card < ActiveRecord::Base
+    self.table_name = "cards"
+  end
+
+  def up
+    add_column :cards, :last_burst_at, :datetime
+    backfill_bursts_from_events
+    backfill_bursts_from_comments
+  end
+
+  def down
+    remove_column :cards, :last_burst_at
+  end
+
+  private
+    def backfill_bursts_from_events
+      execute <<~SQL
+        UPDATE cards
+        SET last_burst_at = (
+          SELECT MAX(events.created_at)
+          FROM events
+          WHERE events.eventable_type = 'Card'
+            AND events.eventable_id = cards.id
+            AND events.action IN ('card_assigned', 'card_reopened')
+        )
+        WHERE EXISTS (
+          SELECT 1
+          FROM events
+          WHERE events.eventable_type = 'Card'
+            AND events.eventable_id = cards.id
+            AND events.action IN ('card_assigned', 'card_reopened')
+        )
+      SQL
+    end
+
+    def backfill_bursts_from_comments
+      Card.in_batches(of: 1000) do |batch|
+        periods = burst_periods_for(batch.ids)
+
+        comments_by_card_id_for(batch.ids).each do |card_id, comments|
+          if burst_at = latest_comment_burst_at(comments, periods.fetch(card_id).to_i / 3)
+            set_last_burst_at(card_id, burst_at)
+          end
+        end
+      end
+    end
+
+    def burst_periods_for(card_ids)
+      ids = card_ids.map { |id| quote_id(id) }.join(",")
+
+      connection.select_all(<<~SQL).to_h { |row| [ deserialize_id(row.fetch("id")), row.fetch("burst_period") ] }
+        SELECT cards.id,
+               COALESCE(board_entropies.auto_postpone_period, account_entropies.auto_postpone_period) AS burst_period
+        FROM cards
+        LEFT JOIN entropies board_entropies
+          ON board_entropies.container_type = 'Board'
+          AND board_entropies.container_id = cards.board_id
+        LEFT JOIN entropies account_entropies
+          ON account_entropies.container_type = 'Account'
+          AND account_entropies.container_id = cards.account_id
+        WHERE cards.id IN (#{ids})
+      SQL
+    end
+
+    def comments_by_card_id_for(card_ids)
+      ids = card_ids.map { |id| quote_id(id) }.join(",")
+
+      connection.select_all(<<~SQL).group_by { |row| deserialize_id(row.fetch("card_id")) }
+        SELECT comments.card_id, comments.creator_id, comments.created_at
+        FROM comments
+        INNER JOIN users ON users.id = comments.creator_id
+        WHERE comments.card_id IN (#{ids})
+          AND users.role != 'system'
+        ORDER BY comments.card_id, comments.created_at, comments.id
+      SQL
+    end
+
+    def latest_comment_burst_at(comments, burst_period)
+      comments.each_cons(3).filter_map do |window|
+        start_at = deserialize_time(window.first.fetch("created_at"))
+        end_at = deserialize_time(window.last.fetch("created_at"))
+
+        if end_at - start_at <= burst_period && window.pluck("creator_id").uniq.size >= 2
+          end_at
+        end
+      end.max
+    end
+
+    def set_last_burst_at(card_id, burst_at)
+      execute <<~SQL
+        UPDATE cards
+        SET last_burst_at = #{connection.quote(burst_at)}
+        WHERE id = #{quote_id(card_id)}
+          AND (last_burst_at IS NULL OR last_burst_at < #{connection.quote(burst_at)})
+      SQL
+    end
+
+    def quote_id(id)
+      connection.quote(Card.type_for_attribute("id").serialize(id))
+    end
+
+    def deserialize_id(id)
+      id = id.to_s
+      id.bytesize == 16 ? Card.type_for_attribute("id").deserialize(id) : id
+    end
+
+    def deserialize_time(value)
+      value.is_a?(String) ? Time.zone.parse(value) : value
+    end
+end
