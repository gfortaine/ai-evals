new file mode 100644
index 0000000..957813c
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,56 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+  BURST_EVENTS = %w[ card_assigned card_reopened ].freeze
+
+  included do
+    after_touch :register_touch_activity, if: -> { published? && !saved_change_to_last_active_at? }
+    after_update :register_save_activity, if: -> { published? && saved_change_to_due_on? }
+
+    scope :stalled, -> do
+      active
+        .where.not(last_burst_at: nil)
+        .where(last_active_at: ..STALL_PERIOD.ago)
+    end
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at <= STALL_PERIOD.ago && active?
+  end
+
+  def comment_burst?(comment)
+    return false if comment.creator.system?
+
+    recent_comments = comments.by_user.where(created_at: (comment.created_at - comment_burst_period)..comment.created_at)
+
+    recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+  end
+
+  def touch_last_active_at(burst: false)
+    attributes = { last_active_at: Time.current }
+    attributes[:last_burst_at] = Time.current if burst
+    update!(attributes)
+  end
+
+  def cache_key_with_version
+    "#{super}-#{stalled? ? "stalled" : "not-stalled"}"
+  end
+
+  private
+    def register_touch_activity
+      touch_last_active_at
+    end
+
+    def register_save_activity
+      touch_last_active_at
+    end
+
+    def bursting_event?(event)
+      event.action.in?(BURST_EVENTS)
+    end
+
+    def comment_burst_period
+      board.auto_postpone_period / 3
+    end
+end
