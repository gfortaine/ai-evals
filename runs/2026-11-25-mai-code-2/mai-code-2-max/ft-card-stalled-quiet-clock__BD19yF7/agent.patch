diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..4d82f91
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = boards(:writebook).cards.create!(title: "Keep an eye on this", creator: users(:david), status: :published)
+  end
+
+  test "assignment starts a burst" do
+    assert_nil @card.last_burst_at
+
+    @card.toggle_assignment users(:kevin)
+
+    assert @card.reload.last_burst_at.present?
+  end
+
+  test "reopening starts a burst" do
+    @card.close
+    assert_nil @card.last_burst_at
+
+    @card.reopen
+
+    assert @card.reload.last_burst_at.present?
+  end
+
+  test "three comments from at least two people within a third of the auto-close period start a burst" do
+    travel_to 20.days.ago do
+      @card.comments.create!(creator: users(:david), body: "First")
+    end
+    travel_to 10.days.ago do
+      @card.comments.create!(creator: users(:kevin), body: "Second")
+    end
+
+    assert_nil @card.reload.last_burst_at
+
+    @card.comments.create!(creator: users(:david), body: "Third")
+
+    assert @card.reload.last_burst_at.present?
+  end
+
+  test "comments from only one person do not start a burst" do
+    3.times do
+      @card.comments.create!(creator: users(:david), body: "Still one person")
+    end
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    @card.comments.create!(creator: users(:david), body: "First person")
+    @card.comments.create!(creator: users(:kevin), body: "Second person")
+    @card.comments.create!(creator: users(:system), body: "System update")
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comments outside the burst window do not start a burst" do
+    travel_to 31.days.ago do
+      @card.comments.create!(creator: users(:david), body: "Too old")
+    end
+    travel_to 20.days.ago do
+      @card.comments.create!(creator: users(:kevin), body: "Recent")
+    end
+    @card.comments.create!(creator: users(:jz), body: "Also recent")
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "a burst with no activity for two weeks is stalled" do
+    @card.toggle_assignment users(:kevin)
+
+    travel 2.weeks + 1.second do
+      assert @card.reload.stalled?
+      assert_includes Card.stalled, @card
+    end
+  end
+
+  test "new activity resets a stalled card" do
+    @card.toggle_assignment users(:kevin)
+
+    travel 2.weeks + 1.second do
+      assert @card.reload.stalled?
+
+      @card.comments.create!(creator: users(:jz), body: "Back on it")
+
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+  end
+
+  test "other card activity resets a stalled card" do
+    @card.toggle_assignment users(:kevin)
+
+    travel 2.weeks + 1.second do
+      assert @card.reload.stalled?
+
+      @card.steps.create!(content: "Follow up")
+
+      assert_not @card.reload.stalled?
+    end
+  end
+
+  test "closed cards are not stalled" do
+    @card.toggle_assignment users(:kevin)
+
+    travel 2.weeks + 1.second do
+      @card.close
+
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+  end
+end
