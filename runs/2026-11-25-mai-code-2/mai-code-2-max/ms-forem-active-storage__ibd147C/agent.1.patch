diff --git a/lib/active_storage/service/fog_aws_service.rb b/lib/active_storage/service/fog_aws_service.rb
new file mode 100644
index 0000000..6e07f40
--- /dev/null
+++ b/lib/active_storage/service/fog_aws_service.rb
@@ -0,0 +1,117 @@
+require "fog/aws"
+
+module ActiveStorage
+  class Service
+    class FogAwsService < ActiveStorage::Service
+      def initialize(bucket:, region:, access_key_id: nil, secret_access_key: nil, use_iam_profile: false,
+                     public: false)
+        super()
+        @bucket = bucket
+        @public = public
+        credentials = { provider: "AWS", region: region, use_iam_profile: use_iam_profile }
+        credentials[:aws_access_key_id] = access_key_id if access_key_id.present?
+        credentials[:aws_secret_access_key] = secret_access_key if secret_access_key.present?
+        @storage = Fog::Storage.new(credentials)
+        @directory = @storage.directories.new(key: bucket)
+      end
+
+      def upload(key, io, checksum: nil, filename: nil, content_type: nil, disposition: nil, custom_metadata: {}, **)
+        instrument :upload, key: key, checksum: checksum do
+          if filename && disposition
+            disposition_header = content_disposition_with(type: disposition,
+                                                          filename: filename)
+          end
+          file = @directory.files.new(
+            key: key,
+            body: io,
+            content_md5: checksum,
+            content_type: content_type,
+            content_disposition: disposition_header,
+            public: public?,
+          )
+          file.metadata = custom_metadata.transform_keys { |name| "x-amz-meta-#{name}" }
+          file.save
+        end
+      end
+
+      def download(key, &block)
+        instrument :download, key: key do
+          body = object_for(key).body
+          if block
+            yield body
+          else
+            body
+          end
+        end
+      end
+
+      def download_chunk(key, range)
+        instrument :download, key: key do
+          @storage.get_object(
+            @bucket,
+            key,
+            "Range" => "bytes=#{range.begin}-#{range.exclude_end? ? range.end - 1 : range.end}",
+          ).body
+        end
+      rescue Excon::Errors::NotFound
+        raise ActiveStorage::FileNotFoundError
+      end
+
+      def delete(key)
+        instrument :delete, key: key do
+          @storage.delete_object(@bucket, key)
+        end
+      end
+
+      def delete_prefixed(prefix)
+        instrument :delete_prefixed, prefix: prefix do
+          # rubocop:disable Rails/FindEach
+          @directory.files.all(prefix: prefix).each(&:destroy)
+          # rubocop:enable Rails/FindEach
+        end
+      end
+
+      def exist?(key)
+        instrument :exist, key: key do |payload|
+          payload[:exist] = @directory.files.head(key).present?
+        end
+      end
+
+      def url_for_direct_upload(key, expires_in:, content_type:, content_length:, checksum:, custom_metadata: {})
+        instrument :url, key: key do |payload|
+          headers = {
+            "Content-Type" => content_type,
+            "Content-Length" => content_length,
+            "Content-MD5" => checksum
+          }.merge(custom_metadata_headers(custom_metadata))
+          payload[:url] = @storage.put_object_url(@bucket, key, Time.current + expires_in, headers)
+        end
+      end
+
+      def headers_for_direct_upload(_key, content_type:, _content_length:, checksum:, custom_metadata: {}, **)
+        {
+          "Content-Type" => content_type,
+          "Content-MD5" => checksum
+        }.merge(custom_metadata_headers(custom_metadata))
+      end
+
+      private
+
+      def object_for(key)
+        @directory.files.get(key) || raise(ActiveStorage::FileNotFoundError)
+      end
+
+      def private_url(key, expires_in:, **)
+        @storage.get_object_url(@bucket, key, Time.current + expires_in)
+      end
+
+      def public_url(key, **)
+        @storage.request_url(bucket_name: @bucket, object_name: key)
+      end
+
+      def custom_metadata_headers(metadata)
+        metadata.transform_keys { |name| "x-amz-meta-#{name}" }
+      end
+    end
+  end
+end
