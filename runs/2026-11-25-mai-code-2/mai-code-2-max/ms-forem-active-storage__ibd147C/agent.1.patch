@@ -0,0 +1,44 @@
+require "rails_helper"
+
+RSpec.describe ActiveStorage::Service::FogAwsService do
+  let(:bucket) { "profile-images-test" }
+  let(:credentials) do
+    {
+      bucket: bucket,
+      region: "us-east-2",
+      access_key_id: "test",
+      secret_access_key: "test"
+    }
+  end
+  let(:service) { described_class.new(**credentials) }
+  let(:body) { "profile image" }
+  let(:key) { "profile.jpg" }
+  let(:checksum) { Base64.strict_encode64(Digest::MD5.digest(body)) }
+
+  around do |example|
+    was_mocking = Fog.mock?
+    Fog.mock! unless was_mocking
+    example.run
+  ensure
+    Fog.unmock! unless was_mocking
+  end
+
+  before do
+    Fog::Storage.new(
+      provider: "AWS",
+      region: credentials[:region],
+      aws_access_key_id: credentials[:access_key_id],
+      aws_secret_access_key: credentials[:secret_access_key],
+    ).directories.create(key: bucket)
+  end
+
+  it "uploads, downloads, and deletes an object" do
+    service.upload(key, StringIO.new(body), checksum: checksum, content_type: "image/jpeg")
+
+    expect(service.exist?(key)).to be(true)
+    expect(service.download(key)).to eq(body)
+
+    service.delete(key)
+    expect(service.exist?(key)).to be(false)
+  end
+end
diff --git a/spec/models/profile_imageable_spec.rb b/spec/models/profile_imageable_spec.rb
new file mode 100644
index 0000000..0d13a9c
--- /dev/null
+++ b/spec/models/profile_imageable_spec.rb
@@ -0,0 +1,66 @@
+require "rails_helper"
+
+RSpec.describe ProfileImageable do
+  shared_examples "a dual-storage profile image" do |factory, model_directory|
+    let(:image) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+
+    it "stores new uploads in Active Storage" do
+      record = create(factory, profile_image: image)
+
+      expect(record.profile_image).to be_attached
+      expect(record[:profile_image]).to be_nil
+      expect(record.profile_image_url).to include("/rails/active_storage/")
+      expect(record.as_json["profile_image"]).to eq("url" => record.profile_image_url)
+    end
+
+    it "attaches remote profile images to Active Storage" do
+      url = "https://example.com/profile.jpg"
+      body = Rails.root.join("spec/fixtures/files/800x600.jpg").binread
+      stub_request(:get, url).to_return(body: body, headers: { "Content-Type" => "image/jpeg" })
+      record = build(factory, profile_image: nil)
+
+      record.remote_profile_image_url = url
+      record.save!
+
+      expect(record.profile_image).to be_attached
+      expect(record.remote_profile_image_url).to eq(url)
+      expect(record.profile_image.download).to eq(body)
+    end
+
+    it "continues to render an existing CarrierWave image" do
+      record = build(factory, profile_image: nil)
+      record[:profile_image] = "legacy.jpeg"
+      record.save!
+      record.reload
+
+      expect(record.profile_image).not_to be_attached
+      expect(record.profile_image_url).to eq("/uploads/#{model_directory}/profile_image/#{record.id}/legacy.jpeg")
+      expect(record.as_json["profile_image"]).to eq("url" => record.profile_image_url)
+    end
+
+    it "prefers a new Active Storage image without deleting the legacy identifier" do
+      record = build(factory, profile_image: nil)
+      record[:profile_image] = "legacy.jpeg"
+      record.save!
+
+      record.profile_image = image
+      record.save!
+
+      expect(record.profile_image).to be_attached
+      expect(record[:profile_image]).to eq("legacy.jpeg")
+      expect(record.profile_image_url).to include("/rails/active_storage/")
+    end
+  end
+
+  context "with users" do
+    it_behaves_like "a dual-storage profile image", :user, "user"
+  end
+
+  context "with organizations" do
+    it_behaves_like "a dual-storage profile image", :organization, "organization"
+  end
+
+  it "leaves other CarrierWave profile images mounted" do
+    expect(Tag.uploaders).to include(:profile_image)
+  end
+end
