diff --git a/app/models/concerns/profile_imageable.rb b/app/models/concerns/profile_imageable.rb
new file mode 100644
index 0000000..f4a449b
--- /dev/null
+++ b/app/models/concerns/profile_imageable.rb
@@ -0,0 +1,172 @@
+module ProfileImageable
+  extend ActiveSupport::Concern
+
+  ALLOWED_CONTENT_TYPES = %w[image/gif image/jpeg image/png image/webp].freeze
+
+  included do
+    has_one_attached :profile_image
+    mount_uploader :legacy_profile_image, ProfileImageUploader, mount_on: :profile_image
+
+    alias_method :profile_image_without_processing=, :profile_image=
+
+    define_method(:profile_image=) do |attachable|
+      assign_profile_image(attachable)
+    end
+
+    before_save :capture_profile_image_attachment_change
+    validate :validate_profile_image_upload
+    after_commit :cleanup_processed_profile_image, on: %i[create update]
+  end
+
+  def profile_image_url
+    active_storage_profile_image_url || current_legacy_profile_image_url
+  end
+
+  def profile_image_attachment_changed?
+    @profile_image_attachment_changed || saved_change_to_profile_image?
+  end
+
+  def profile_image_available?
+    active_storage_profile_image_blob.present? || current_legacy_profile_image_identifier.present?
+  end
+
+  def remote_profile_image_url
+    @remote_profile_image_url
+  end
+
+  def remote_profile_image_url=(url)
+    @remote_profile_image_url = url
+    @processing_remote_profile_image = true
+    self.profile_image = url
+  ensure
+    @processing_remote_profile_image = false
+  end
+
+  def read_attribute_for_serialization(key)
+    return { "url" => profile_image_url } if key.to_s == "profile_image"
+
+    super
+  end
+
+  private
+
+  def current_legacy_profile_image_url
+    legacy_profile_image_url if has_attribute?(:profile_image)
+  end
+
+  def current_legacy_profile_image_identifier
+    self[:profile_image] if has_attribute?(:profile_image)
+  end
+
+  def active_storage_profile_image_url
+    blob = active_storage_profile_image_blob
+    return unless blob&.persisted?
+
+    path = Rails.application.routes.url_helpers.rails_blob_path(blob, only_path: true)
+    URL.url(path)
+  end
+
+  def active_storage_profile_image_blob
+    change = attachment_changes["profile_image"]
+    return if change.is_a?(ActiveStorage::Attached::Changes::DeleteOne)
+    return change.blob if change.respond_to?(:blob)
+
+    profile_image_blob
+  end
+
+  def assign_profile_image(attachable)
+    @profile_image_upload_errors = []
+
+    if attachable.nil? || attachable == ""
+      self[:profile_image] = nil
+      @_mounters&.delete(:legacy_profile_image)
+      self.profile_image_without_processing = attachable
+      return
+    end
+
+    if attachable.is_a?(String) && attachable.match?(%r{\Ahttps?://})
+      return unless @processing_remote_profile_image
+
+      prepared_upload = prepare_profile_image_upload(attachable, remote: true)
+    else
+      prepared_upload = if processable_profile_image_upload?(attachable)
+                          prepare_profile_image_upload(attachable)
+                        else
+                          attachable
+                        end
+    end
+    return unless prepared_upload
+
+    self.profile_image_without_processing = prepared_upload
+  rescue ActiveSupport::MessageVerifier::InvalidSignature,
+         CarrierWave::DownloadError,
+         CarrierWave::IntegrityError,
+         CarrierWave::ProcessingError => e
+    @profile_image_upload_errors = [e.message]
+  end
+
+  def processable_profile_image_upload?(attachable)
+    return false if attachable.is_a?(ActiveStorage::Blob) || attachable.is_a?(Hash)
+    return false if attachable.is_a?(String)
+
+    attachable.respond_to?(:path) || attachable.respond_to?(:read)
+  end
+
+  def prepare_profile_image_upload(upload, remote: false)
+    cleanup_processed_profile_image
+    uploader = ActiveStorageProfileImageUploader.new(self, :profile_image)
+
+    if remote
+      uploader.download!(upload)
+    else
+      uploader.cache!(upload)
+    end
+
+    return if uploader.file.blank?
+
+    io = File.open(uploader.file.path, "rb")
+    @processed_profile_image_uploader = uploader
+    @processed_profile_image_io = io
+
+    {
+      io: io,
+      filename: uploader.filename,
+      content_type: uploader.file.content_type
+    }
+  end
+
+  def capture_profile_image_attachment_change
+    @profile_image_attachment_changed = attachment_changes.key?("profile_image")
+  end
+
+  def validate_profile_image_upload
+    Array(@profile_image_upload_errors).each do |message|
+      errors.add(:profile_image, message)
+    end
+    blob = active_storage_profile_image_blob
+    validate_active_storage_profile_image(blob) if blob
+  end
+
+  def validate_active_storage_profile_image(blob)
+    if blob.byte_size > ProfileImageUploader::MAX_FILE_SIZE
+      errors.add(
+        :profile_image,
+        I18n.t(
+          "errors.messages.max_size_error",
+          max_size: ActiveSupport::NumberHelper.number_to_human_size(ProfileImageUploader::MAX_FILE_SIZE),
+        ),
+      )
+    end
+
+    return if ALLOWED_CONTENT_TYPES.include?(blob.content_type)
+
+    errors.add(:profile_image, I18n.t("errors.messages.unsupported_image_type"))
+  end
+
+  def cleanup_processed_profile_image
+    @processed_profile_image_io&.close unless @processed_profile_image_io&.closed?
+    @processed_profile_image_uploader&.remove!
+    @processed_profile_image_io = nil
+    @processed_profile_image_uploader = nil
+  end
+end
