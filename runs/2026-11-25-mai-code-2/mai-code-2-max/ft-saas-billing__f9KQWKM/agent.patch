diff --git a/saas/app/views/account/billings/show.html.erb b/saas/app/views/account/billings/show.html.erb
new file mode 100644
index 0000000..2c93d57
--- /dev/null
+++ b/saas/app/views/account/billings/show.html.erb
@@ -0,0 +1,48 @@
+<% @page_title = "Upgrade Fizzy" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Account Settings", account_settings_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings margin-block-start-half">
+  <div class="settings__panel settings__panel--users panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Current plan</h2>
+        <div><strong><%= @account.plan_name %></strong></div>
+      </header>
+
+      <% if @account.paid? && Current.user.admin? %>
+        <%= button_to "Manage billing", saas.account_billing_portal_path(script_name: Current.account.slug), class: "btn btn--link", form: { data: { turbo: false } } %>
+      <% end %>
+    </section>
+  </div>
+
+  <div class="settings__panel settings__panel--entropy panel shadow center">
+    <% @plans.each do |plan| %>
+      <section class="settings__section">
+        <header>
+          <h2 class="divider"><%= plan.proper_name %></h2>
+          <div><strong><%= number_to_currency(plan.price, precision: 0) %>/month</strong></div>
+        </header>
+
+        <ul class="list-unindented">
+          <li>Unlimited cards</li>
+          <li><%= number_to_human_size(plan.storage_limit) %> storage</li>
+        </ul>
+
+        <% if @account.plan == plan.short_name %>
+          <button type="button" class="btn" disabled>Current plan</button>
+        <% elsif Current.user.admin? %>
+          <%= button_to "Upgrade to #{plan.proper_name}", saas.account_billing_checkout_path(script_name: Current.account.slug),
+                params: { plan: plan.short_name }, class: "btn btn--link", form: { data: { turbo: false } } %>
+        <% else %>
+          <div>Ask an account admin to upgrade.</div>
+        <% end %>
+      </section>
+    <% end %>
+  </div>
+</section>
