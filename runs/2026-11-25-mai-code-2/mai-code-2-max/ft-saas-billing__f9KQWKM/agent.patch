diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..6bef87e
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,60 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Accounts", saas.admin_accounts_path(script_name: nil), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Account</h2>
+      </header>
+      <div>#<%= @account.external_account_id %></div>
+      <div><%= @account.owner_email || "No owner" %></div>
+      <div><%= number_with_delimiter(@account.cards_count) %> real cards</div>
+      <div><%= number_to_human_size(@account.bytes_used) %> real storage</div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Billing</h2>
+      </header>
+      <div>Plan: <strong><%= @account.plan_name %></strong></div>
+      <div><%= @account.comped? ? "Comped" : "Not comped" %></div>
+
+      <div class="flex gap-half">
+        <%= button_to "Comp", saas.admin_account_comp_path(@account, script_name: nil), class: "btn", disabled: @account.comped? %>
+        <%= button_to "Uncomp", saas.admin_account_comp_path(@account, script_name: nil), method: :delete, class: "btn", disabled: !@account.comped? %>
+      </div>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Usage override</h2>
+        <div>Override the values used to test card and storage limits.</div>
+      </header>
+
+      <%= form_with model: @overridden_limit, url: saas.admin_account_overridden_limit_path(@account, script_name: nil), scope: :overridden_limit, method: :post, class: "flex flex-column gap-half" do |form| %>
+        <label class="flex flex-column gap-quarter txt-align-start">
+          <span>Card count</span>
+          <%= form.number_field :card_count, min: 0, required: true, class: "input" %>
+        </label>
+
+        <label class="flex flex-column gap-quarter txt-align-start">
+          <span>Bytes used</span>
+          <%= form.number_field :bytes_used, min: 0, required: true, class: "input" %>
+        </label>
+
+        <%= form.submit "Override", class: "btn btn--link" %>
+      <% end %>
+
+      <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account, script_name: nil), method: :delete, class: "btn" %>
+    </section>
+  </div>
+</section>
