diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..adcca83
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,119 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  scope :active, -> { where(status: ACTIVE_STATUSES) }
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+  validates :plan_key, inclusion: { in: ::Subscription::SHORT_NAMES }, allow_nil: true
+  validates :plan_key, presence: true, if: :active?
+
+  class << self
+    def sync_from_checkout_session!(stripe_session, account: nil)
+      sync_from_stripe! stripe_session,
+        account: account,
+        status: "active",
+        subscription_id: stripe_identifier(stripe_value(stripe_session, :subscription))
+    end
+
+    def sync_from_stripe!(stripe_subscription, account: nil, status: nil, subscription_id: nil)
+      subscription_id ||= stripe_identifier(stripe_value(stripe_subscription, :id))
+      customer_id = stripe_identifier(stripe_value(stripe_subscription, :customer))
+      account ||= find_account_for(stripe_subscription, subscription_id: subscription_id, customer_id: customer_id)
+
+      if account
+        record = find_by(stripe_subscription_id: subscription_id) if subscription_id
+        record ||= find_by(stripe_customer_id: customer_id) if customer_id
+        record ||= new(account: account)
+        record.assign_attributes account: account,
+          stripe_customer_id: customer_id || record.stripe_customer_id,
+          stripe_subscription_id: subscription_id || record.stripe_subscription_id,
+          plan_key: plan_key_from(stripe_subscription) || record.plan_key,
+          status: status || stripe_value(stripe_subscription, :status) || record.status,
+          current_period_end: stripe_time(current_period_end_from(stripe_subscription)) || record.current_period_end,
+          cancel_at: stripe_time(stripe_value(stripe_subscription, :cancel_at)) || record.cancel_at
+        record.save!
+      else
+        Rails.logger.warn "Ignoring Stripe subscription #{subscription_id} because no account could be matched"
+        nil
+      end
+    end
+
+    def update_next_amount_due(stripe_invoice)
+      if subscription_id = stripe_identifier(stripe_value(stripe_invoice, :subscription))
+        find_by(stripe_subscription_id: subscription_id)&.update!(next_amount_due_in_cents: stripe_value(stripe_invoice, :amount_due))
+      end
+    end
+
+    private
+      def find_account_for(stripe_object, subscription_id:, customer_id:)
+        if existing = (find_by(stripe_subscription_id: subscription_id) if subscription_id) || (find_by(stripe_customer_id: customer_id) if customer_id)
+          existing.account
+        elsif account_id = stripe_metadata(stripe_object)[:account_id]
+          ::Account.find_by(id: account_id)
+        elsif account_id = stripe_value(stripe_object, :client_reference_id)
+          ::Account.find_by(id: account_id)
+        end
+      end
+
+      def plan_key_from(stripe_object)
+        if plan = ::Subscription.plan_for_price_ids(price_ids_from(stripe_object))
+          plan.short_name
+        elsif plan_key = stripe_metadata(stripe_object)[:plan_key]
+          ::Subscription.find(plan_key)&.short_name
+        end
+      end
+
+      def price_ids_from(stripe_object)
+        items = stripe_value(stripe_object, :items)
+        Array(stripe_value(items, :data)).filter_map do |item|
+          price = stripe_value(item, :price) || stripe_value(item, :plan)
+          stripe_identifier(price)
+        end
+      end
+
+      def current_period_end_from(stripe_object)
+        stripe_value(stripe_object, :current_period_end) || begin
+          items = stripe_value(stripe_object, :items)
+          stripe_value(Array(stripe_value(items, :data)).first, :current_period_end)
+        end
+      end
+
+      def stripe_metadata(stripe_object)
+        (stripe_value(stripe_object, :metadata) || {}).to_h.symbolize_keys
+      end
+
+      def stripe_identifier(value)
+        if value.respond_to?(:id)
+          value.id
+        elsif value.respond_to?(:key?)
+          value[:id] || value["id"]
+        else
+          value
+        end
+      end
+
+      def stripe_time(value)
+        Time.at(value.to_i) if value.present?
+      end
+
+      def stripe_value(object, key)
+        if object.respond_to?(key)
+          object.public_send(key)
+        elsif object.respond_to?(:to_h)
+          values = object.to_h
+          values[key] || values[key.to_s]
+        end
+      end
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def plan
+    ::Subscription.find!(plan_key)
+  end
+end
