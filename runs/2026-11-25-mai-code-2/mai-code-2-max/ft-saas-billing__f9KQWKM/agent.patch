+class Account::Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    session = if Current.account.paid?
+      Current.account.create_portal_session(return_url: account_billing_url)
+    else
+      Current.account.create_checkout_session(
+        plan_key: params.require(:plan),
+        success_url: account_billing_url,
+        cancel_url: account_billing_url
+      )
+    end
+
+    redirect_to session.url, allow_other_host: true
+  end
+
+  private
+    def account_billing_url
+      saas.account_billing_url(script_name: Current.account.slug)
+    end
+end
