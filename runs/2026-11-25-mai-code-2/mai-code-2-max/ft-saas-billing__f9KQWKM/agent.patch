diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..45be4a3
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,19 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(
+      request.body.read,
+      request.headers["Stripe-Signature"],
+      ENV.fetch("STRIPE_WEBHOOK_SECRET")
+    )
+
+    Account::Billing::Webhook.process event
+    head :no_content
+  rescue JSON::ParserError, Stripe::SignatureVerificationError => error
+    Rails.logger.warn "Rejected Stripe webhook: #{error.class}: #{error.message}"
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..891fbe1
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,156 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  CARD_WARNING_THRESHOLD = 100
+
+  class MissingStripeCustomer < StandardError; end
+
+  included do
+    has_many :subscriptions, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limit, dependent: :destroy
+
+    set_callback :cancel, :before, :cancel_active_subscription
+  end
+
+  def billing_plan
+    if comped?
+      ::Subscription::MonthlyV1
+    else
+      active_subscription&.plan || ::Subscription::FreeV1
+    end
+  end
+
+  def plan
+    billing_plan.short_name
+  end
+
+  def plan_name
+    billing_plan.proper_name
+  end
+
+  def paid?
+    active_subscription.present?
+  end
+
+  def comped?
+    ::Account::BillingWaiver.exists?(account_id: id)
+  end
+
+  def comped=(_value)
+  end
+
+  def comp
+    create_or_find_billing_waiver
+  end
+
+  def uncomp
+    if waiver = billing_waiver
+      waiver.destroy!
+      association(:billing_waiver).reset
+    end
+  end
+
+  def active_subscription
+    subscriptions.active.order(updated_at: :desc).first
+  end
+
+  def latest_subscription
+    subscriptions.order(updated_at: :desc).first
+  end
+
+  def billable_card_count
+    overridden_limit&.card_count || cards_count
+  end
+
+  def billable_bytes_used
+    overridden_limit&.bytes_used || bytes_used
+  end
+
+  alias card_count billable_card_count
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def cards_remaining
+    card_limit && [ card_limit - billable_card_count, 0 ].max
+  end
+
+  def reaching_card_limit?
+    card_limit.present? && billable_card_count >= card_limit
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && billable_card_count > card_limit
+  end
+
+  alias card_limit_exceeded? exceeding_card_limit?
+
+  def nearing_card_limit?
+    cards_remaining.present? && cards_remaining.positive? && cards_remaining <= CARD_WARNING_THRESHOLD
+  end
+
+  def override_limits(card_count:, bytes_used:)
+    (overridden_limit || build_overridden_limit).tap do |override|
+      override.update!(card_count: card_count, bytes_used: bytes_used)
+    end
+  end
+
+  def reset_limit_override
+    if override = overridden_limit
+      override.destroy!
+      association(:overridden_limit).reset
+    end
+  end
+
+  def create_checkout_session(plan_key:, success_url:, cancel_url:)
+    plan = ::Subscription.find!(plan_key)
+    raise ArgumentError, "Cannot checkout the free plan" if plan == ::Subscription::FreeV1
+
+    Stripe::Checkout::Session.create checkout_session_params(plan, success_url: success_url, cancel_url: cancel_url)
+  end
+
+  def create_portal_session(return_url:)
+    if customer_id = latest_subscription&.stripe_customer_id
+      Stripe::BillingPortal::Session.create(customer: customer_id, return_url: return_url)
+    else
+      raise MissingStripeCustomer, "Account #{id} has no Stripe customer"
+    end
+  end
+
+  private
+    def checkout_session_params(plan, success_url:, cancel_url:)
+      metadata = { account_id: id, plan_key: plan.short_name }
+
+      {}.tap do |params|
+        params[:mode] = "subscription"
+        params[:line_items] = plan.stripe_price_ids.map { |price| { price: price, quantity: 1 } }
+        params[:success_url] = success_url
+        params[:cancel_url] = cancel_url
+        params[:client_reference_id] = id
+        params[:metadata] = metadata
+        params[:subscription_data] = { metadata: metadata }
+        params[:allow_promotion_codes] = true
+
+        if customer_id = latest_subscription&.stripe_customer_id
+          params[:customer] = customer_id
+        elsif email = owner_email || Current.identity&.email_address
+          params[:customer_email] = email
+        end
+      end
+    end
+
+    def create_or_find_billing_waiver
+      billing_waiver || ::Account::BillingWaiver.create_or_find_by!(account: self).tap do
+        association(:billing_waiver).reset
+      end
+    end
+
+    def cancel_active_subscription
+      if subscription = active_subscription
+        Stripe::Subscription.cancel(subscription.stripe_subscription_id)
+        subscription.update!(status: "canceled", cancel_at: Time.current)
+      end
+    end
+end
diff --git a/saas/app/models/account/billing/webhook.rb b/saas/app/models/account/billing/webhook.rb
new file mode 100644
index 0000000..fb26390
--- /dev/null
+++ b/saas/app/models/account/billing/webhook.rb
@@ -0,0 +1,16 @@
+class Account::Billing::Webhook
+  class << self
+    def process(event)
+      case event.type
+      when "checkout.session.completed"
+        Account::Subscription.sync_from_checkout_session! event.data.object
+      when "customer.subscription.created", "customer.subscription.updated"
+        Account::Subscription.sync_from_stripe! event.data.object
+      when "customer.subscription.deleted"
+        Account::Subscription.sync_from_stripe! event.data.object, status: "canceled"
+      when "invoice.created", "invoice.updated", "invoice.payment_failed"
+        Account::Subscription.update_next_amount_due event.data.object
+      end
+    end
+  end
+end
