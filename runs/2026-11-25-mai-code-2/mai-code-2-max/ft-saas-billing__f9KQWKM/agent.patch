diff --git a/saas/test/controllers/account/billings_controller_test.rb b/saas/test/controllers/account/billings_controller_test.rb
new file mode 100644
index 0000000..ce65261
--- /dev/null
+++ b/saas/test/controllers/account/billings_controller_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Account::BillingsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @script_name = accounts(:initech).slug
+  end
+
+  test "billing page shows approved paid plans" do
+    get saas.account_billing_path(script_name: @script_name)
+
+    assert_response :success
+    assert_select "h2", text: "Unlimited"
+    assert_select "h2", text: "Unlimited+"
+    assert_includes response.body, "$20/month"
+    assert_includes response.body, "$25/month"
+  end
+
+  test "settings show the current plan and upgrade link to admins" do
+    get account_settings_path(script_name: @script_name)
+
+    assert_response :success
+    assert_select ".settings__section strong", text: "Free"
+    assert_select "a[href='#{saas.account_billing_path(script_name: @script_name)}']", text: "Upgrade"
+  end
+
+  test "checkout is hosted by Stripe" do
+    Subscription::MonthlyV1.stubs(:stripe_price_ids).returns([ "price_monthly" ])
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:mode] == "subscription" &&
+        params[:line_items] == [ { price: "price_monthly", quantity: 1 } ] &&
+        params[:metadata][:account_id] == accounts(:initech).id &&
+        params[:customer_email] == identities(:mike).email_address
+    end.returns(stub(url: "https://checkout.stripe.test/session"))
+
+    post saas.account_billing_checkout_path(script_name: @script_name),
+      params: { plan: "MonthlyV1" }
+
+    assert_redirected_to "https://checkout.stripe.test/session"
+  end
+
+  test "customer portal is hosted by Stripe" do
+    accounts(:initech).subscriptions.create!(
+      stripe_customer_id: "cus_billing",
+      stripe_subscription_id: "sub_billing",
+      plan_key: "MonthlyV1",
+      status: "active"
+    )
+    Stripe::BillingPortal::Session.expects(:create).with do |params|
+      params[:customer] == "cus_billing"
+    end.returns(stub(url: "https://billing.stripe.test/session"))
+
+    post saas.account_billing_portal_path(script_name: @script_name)
+
+    assert_redirected_to "https://billing.stripe.test/session"
+  end
+
+  test "checkout requires an account admin" do
+    logout_and_sign_in_as :david
+
+    post saas.account_billing_checkout_path, params: { plan: "MonthlyV1" }
+
+    assert_response :forbidden
+  end
+
+  test "members can view the upgrade pitch" do
+    logout_and_sign_in_as :david
+
+    get saas.account_billing_path
+
+    assert_response :success
+    assert_includes response.body, "Ask an account admin to upgrade."
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..6a5a521
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "staff can list accounts and open an account" do
+    untenanted do
+      get saas.admin_accounts_path(script_name: nil)
+    end
+
+    assert_response :success
+    assert_select "a[href='#{saas.admin_account_path(accounts(:initech), script_name: nil)}']", text: "Initech LLC"
+
+    untenanted do
+      get saas.admin_account_path(accounts(:initech), script_name: nil)
+    end
+
+    assert_response :success
+    assert_select "button[type='submit']", text: "Comp"
+    assert_select "button[type='submit']", text: "Uncomp"
+    assert_select "label", text: /Card count/
+    assert_select "label", text: /Bytes used/
+    assert_select "input[type='submit'][value='Override']"
+    assert_select "button[type='submit']", text: "Reset"
+  end
+
+  test "staff can comp and uncomp an account" do
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_comp_path(account, script_name: nil)
+    end
+    assert_redirected_to saas.admin_account_path(account, script_name: nil)
+    assert account.reload.comped?
+
+    untenanted do
+      delete saas.admin_account_comp_path(account, script_name: nil)
+    end
+    assert_not account.reload.comped?
+  end
+
+  test "staff can override and reset account usage" do
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(account, script_name: nil), params: {
+        overridden_limit: { card_count: 950, bytes_used: 2.gigabytes }
+      }
+    end
+
+    override = account.reload.overridden_limit
+    assert_equal 950, override.card_count
+    assert_equal 2.gigabytes, override.bytes_used
+
+    untenanted do
+      delete saas.admin_account_overridden_limit_path(account, script_name: nil)
+    end
+    assert_nil account.reload.overridden_limit
+  end
+
+  test "non-staff cannot access accounts" do
+    logout_and_sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path(script_name: nil)
+    end
+
+    assert_response :forbidden
+  end
+end
