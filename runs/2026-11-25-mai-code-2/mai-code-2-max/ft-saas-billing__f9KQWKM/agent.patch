new file mode 100644
index 0000000..35b9d6f
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @previous_webhook_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+  end
+
+  teardown do
+    ENV["STRIPE_WEBHOOK_SECRET"] = @previous_webhook_secret
+  end
+
+  test "syncs subscription changes" do
+    stripe_subscription = {
+      id: "sub_webhook",
+      customer: "cus_webhook",
+      status: "active",
+      current_period_end: 2.days.from_now.to_i,
+      metadata: { account_id: accounts(:initech).id, plan_key: "MonthlyV1" },
+      items: { data: [] }
+    }
+
+    post_event "customer.subscription.created", stripe_subscription
+
+    subscription = accounts(:initech).subscriptions.find_by!(stripe_subscription_id: "sub_webhook")
+    assert_equal "MonthlyV1", subscription.plan_key
+    assert_equal "active", subscription.status
+    assert accounts(:initech).reload.paid?
+  end
+
+  test "records checkout completion while waiting for the subscription event" do
+    post_event "checkout.session.completed", {
+      id: "cs_checkout",
+      customer: "cus_checkout",
+      subscription: { id: "sub_checkout" },
+      metadata: { account_id: accounts(:initech).id, plan_key: "MonthlyExtraStorageV1" }
+    }
+
+    subscription = accounts(:initech).subscriptions.find_by!(stripe_subscription_id: "sub_checkout")
+    assert_equal "cus_checkout", subscription.stripe_customer_id
+    assert_equal "MonthlyExtraStorageV1", subscription.plan_key
+  end
+
+  test "moves a subscription to the free plan when deleted" do
+    subscription = accounts(:initech).subscriptions.create!(
+      stripe_customer_id: "cus_deleted",
+      stripe_subscription_id: "sub_deleted",
+      plan_key: "MonthlyV1",
+      status: "active"
+    )
+
+    post_event "customer.subscription.deleted", {
+      id: subscription.stripe_subscription_id,
+      customer: subscription.stripe_customer_id,
+      status: "canceled",
+      metadata: { account_id: accounts(:initech).id },
+      items: { data: [] }
+    }
+
+    assert_equal "canceled", subscription.reload.status
+    assert_equal "FreeV1", accounts(:initech).reload.plan
+  end
+
+  test "rejects invalid signatures" do
+    Stripe::Webhook.expects(:construct_event).raises(Stripe::SignatureVerificationError.new("invalid signature", "invalid"))
+
+    untenanted do
+      post saas.stripe_webhooks_path,
+        params: "invalid",
+        headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "invalid" }
+    end
+
+    assert_response :bad_request
+  end
+
+  private
+    def post_event(type, object)
+      event = stub(
+        type: type,
+        data: stub(object: object)
+      )
+      Stripe::Webhook.expects(:construct_event).with("{}", "signature", "whsec_test").returns(event)
+
+      untenanted do
+        post saas.stripe_webhooks_path,
+          params: "{}",
+          headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "signature" }
+      end
+
+      assert_response :no_content
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..e3fb1d0
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan includes one thousand cards and one gigabyte" do
+    assert_equal "FreeV1", @account.plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "card limit is exceeded at one thousand cards" do
+    @account.update_column :cards_count, 999
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column :cards_count, 1_000
+    assert @account.reaching_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column :cards_count, 1_001
+    assert @account.exceeding_card_limit?
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "warns from one hundred cards remaining" do
+    @account.update_column :cards_count, 900
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+
+    @account.update_column :cards_count, 950
+    assert_equal 50, @account.cards_remaining
+  end
+
+  test "monthly plan has unlimited cards and five gigabytes" do
+    subscribe_to "MonthlyV1"
+
+    assert_equal "Unlimited", @account.plan_name
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "extra storage plan has five hundred gigabytes" do
+    subscribe_to "MonthlyExtraStorageV1"
+
+    assert_equal "Unlimited+", @account.plan_name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "comp and uncomp toggle a waived plan" do
+    @account.comp
+
+    assert @account.comped?
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.uncomp
+    assert_not @account.comped?
+    assert_equal 1_000, @account.card_limit
+  end
+
+  test "limit overrides replace usage values and reset restores real usage" do
+    @account.update_column :cards_count, 10
+    Account.any_instance.stubs(:bytes_used).returns(20)
+
+    @account.override_limits(card_count: 950, bytes_used: 2.gigabytes)
+
+    assert_equal 950, @account.billable_card_count
+    assert_equal 2.gigabytes, @account.billable_bytes_used
+    assert @account.exceeding_storage_limit?
+
+    @account.reset_limit_override
+    assert_equal 10, @account.billable_card_count
+    assert_equal 20, @account.billable_bytes_used
+  end
+
+  private
+    def subscribe_to(plan_key)
+      @account.subscriptions.create!(
+        plan_key: plan_key,
+        stripe_customer_id: "cus_#{plan_key}",
+        stripe_subscription_id: "sub_#{plan_key}",
+        status: "active"
+      )
+    end
+end
