+module Notification::Bundling
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :bundle_entries, class_name: "Notification::Bundle::Entry", dependent: :delete_all
+    has_many :notification_bundles, through: :bundle_entries, source: :bundle
+
+    around_save :capture_in_email_bundle, if: :source_changing?
+  end
+
+  private
+    def capture_in_email_bundle(&block)
+      Notification::Bundle.capture(self, &block)
+    end
+
+    def source_changing?
+      new_record? || will_save_change_to_source_id? || will_save_change_to_source_type?
+    end
+end
