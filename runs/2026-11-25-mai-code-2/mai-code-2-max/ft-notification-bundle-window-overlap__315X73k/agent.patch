+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @settings = users(:david).settings
+  end
+
+  test "bundle email frequency defaults to off" do
+    assert_predicate @settings, :never?
+    assert_not @settings.bundle_emails?
+  end
+
+  test "bundle email frequencies have rolling intervals" do
+    @settings.every_few_hours!
+    assert_equal 4.hours, @settings.bundle_email_interval
+
+    @settings.daily!
+    assert_equal 1.day, @settings.bundle_email_interval
+
+    @settings.weekly!
+    assert_equal 1.week, @settings.bundle_email_interval
+  end
+end
