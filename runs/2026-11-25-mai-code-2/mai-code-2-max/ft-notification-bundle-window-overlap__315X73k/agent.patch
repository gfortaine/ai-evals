diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..645eab6
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,94 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :entries, -> { ordered }, class_name: "Notification::Bundle::Entry", inverse_of: :bundle, dependent: :delete_all
+  has_many :notifications, through: :entries
+
+  scope :open, -> { where(closed_at: nil) }
+  scope :ordered, -> { order(starts_at: :desc, id: :desc) }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def capture(notification, &block)
+      notification.user.with_lock do
+        block&.call
+        capture_without_lock(notification)
+      end
+    end
+
+    private
+      def capture_without_lock(notification)
+        user = notification.user
+
+        if (settings = user.settings&.reload) && settings.bundle_emails?
+          bundle = open.find_by(user: user) || create!(
+            user: user,
+            starts_at: notification.updated_at,
+            ends_at: notification.updated_at + settings.bundle_email_interval
+          )
+
+          bundle.entries.create_or_find_by!(
+            notification: notification,
+            source: notification.source,
+            creator: notification.creator,
+            card: notification.card
+          )
+          bundle
+        end
+      end
+  end
+
+  def deliver_later
+    Notification::BundleJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver
+    if due?
+      user.with_lock do
+        reload
+
+        if open? && due?
+          delivered = deliverable?
+          now = Time.current
+
+          update!(
+            closed_at: now,
+            active_slot: nil,
+            sent_at: delivered ? now : nil
+          )
+
+          NotificationMailer.bundle(self).deliver_later if delivered
+        end
+      end
+    end
+  end
+
+  def open?
+    closed_at.nil?
+  end
+
+  def closed?
+    !open?
+  end
+
+  def due?
+    ends_at <= Time.current
+  end
+
+  def window
+    starts_at...ends_at
+  end
+
+  def notification_snapshots
+    entries.preloaded.map(&:notification_snapshot)
+  end
+
+  private
+    def deliverable?
+      entries.exists? &&
+        user.active? && account.active? && user.identity.present? &&
+        user.settings&.bundle_emails?
+    end
+end
diff --git a/app/models/notification/bundle/entry.rb b/app/models/notification/bundle/entry.rb
