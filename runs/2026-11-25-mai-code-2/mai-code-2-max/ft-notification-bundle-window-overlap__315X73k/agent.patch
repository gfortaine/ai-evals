--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  test "bundle includes each notification and has text and HTML parts" do
+    user = users(:david)
+    user.settings.every_few_hours!
+    notification = notifications(:logo_mentioned_david)
+    notification.update!(source: events(:logo_assignment_david), creator: users(:kevin))
+    bundle = user.notification_bundles.open.sole
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ user.identity.email_address ], email.to
+    assert_match notification.card.title, email.body.encoded
+    assert_match notification.payload.body, email.body.encoded
+    assert email.html_part.present?
+    assert email.text_part.present?
+  end
+
+  test "bundle renders mention notifications" do
+    user = users(:david)
+    user.settings.every_few_hours!
+    bundle = Notification::Bundle.capture(notifications(:logo_mentioned_david))
+
+    email = NotificationMailer.digest(bundle)
+
+    assert_match "mentioned you", email.body.encoded
+  end
+end
