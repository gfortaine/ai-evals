@@ -0,0 +1,31 @@
+class Notification::Bundle::Entry < ApplicationRecord
+  belongs_to :account, default: -> { bundle.account }
+  belongs_to :bundle, class_name: "Notification::Bundle", inverse_of: :entries
+  belongs_to :notification, inverse_of: :bundle_entries
+  belongs_to :source, polymorphic: true
+  belongs_to :creator, class_name: "User"
+  belongs_to :card
+
+  scope :ordered, -> { order(:created_at, :id) }
+  scope :preloaded, -> {
+    preload(
+      :creator,
+      card: [ :board, :column, :closure, :not_now ],
+      source: [ :board, :creator, { eventable: [ :closure, :board, :assignments ] } ]
+    )
+  }
+
+  def notification_snapshot
+    Notification.new(
+      id: notification_id,
+      account: account,
+      user: bundle.user,
+      creator: creator,
+      source: source,
+      card: card,
+      unread_count: 1,
+      created_at: created_at,
+      updated_at: updated_at
+    )
+  end
+end
