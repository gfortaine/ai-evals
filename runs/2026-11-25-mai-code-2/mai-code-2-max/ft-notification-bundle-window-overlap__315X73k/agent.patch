@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @user.settings.every_few_hours!
+    @notification = notifications(:logo_mentioned_david)
+  end
+
+  test "the first notification opens and schedules a window" do
+    travel_to Time.zone.parse("2026-11-23 10:00:00") do
+      assert_enqueued_with(job: Notification::BundleJob) do
+        @notification.update!(source: events(:logo_assignment_david), creator: users(:kevin))
+      end
+
+      bundle = @user.notification_bundles.open.sole
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 4.hours.from_now, bundle.ends_at
+      assert_equal [ @notification ], bundle.notifications.to_a
+    end
+  end
+
+  test "notifications keep using the window already open even after its scheduled end" do
+    travel_to Time.zone.parse("2026-11-23 10:00:00") do
+      @notification.update!(source: events(:logo_assignment_david), creator: users(:kevin))
+    end
+
+    bundle = @user.notification_bundles.open.sole
+
+    travel_to Time.zone.parse("2026-11-23 14:30:00") do
+      late_notification = @user.notifications.create!(
+        source: events(:layout_commented),
+        creator: users(:kevin)
+      )
+
+      assert_equal [ bundle ], @user.notification_bundles.open.to_a
+      assert_includes bundle.notifications, late_notification
+      assert_equal Time.zone.parse("2026-11-23 14:00:00"), bundle.ends_at
+    end
+  end
+
+  test "a due window sends only once and the next notification opens a later window" do
+    @notification.update!(source: events(:logo_assignment_david), creator: users(:kevin))
+    bundle = @user.notification_bundles.open.sole
+
+    travel_to bundle.ends_at + 1.minute do
+      assert_enqueued_with(job: ActionMailer::MailDeliveryJob) do
+        bundle.deliver
+      end
+
+      assert_predicate bundle.reload, :closed?
+      assert_predicate bundle, :sent_at
+
+      assert_no_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        bundle.deliver
+      end
+
+      next_notification = @user.notifications.create!(
+        source: events(:layout_commented),
+        creator: users(:kevin)
+      )
+      next_bundle = @user.notification_bundles.open.sole
+
+      assert_not_equal bundle, next_bundle
+      assert_includes next_bundle.notifications, next_notification
+      assert_operator next_bundle.starts_at, :>=, bundle.closed_at
+    end
+  end
+
+  test "an event keeps the source snapshot from its original window" do
+    @notification.update!(source: events(:logo_assignment_david), creator: users(:kevin))
+    first_bundle = @user.notification_bundles.open.sole
+
+    travel_to first_bundle.ends_at + 1.minute do
+      first_bundle.deliver
+      @notification.update!(source: events(:logo_published), creator: users(:jz))
+    end
+
+    snapshot = first_bundle.notification_snapshots.sole
+    assert_equal events(:logo_assignment_david), snapshot.source
+    assert_equal users(:kevin), snapshot.creator
+  end
+
+  test "multiple events for one card are included in the same window" do
+    @notification.update!(source: events(:logo_assignment_david), creator: users(:kevin))
+    @notification.update!(source: events(:logo_published), creator: users(:jz))
+
+    bundle = @user.notification_bundles.open.sole
+
+    assert_equal 2, bundle.entries.count
+    assert_equal events(:logo_assignment_david, :logo_published), bundle.notification_snapshots.map(&:source)
+  end
+
+  test "off does not open a window" do
+    @user.settings.never!
+
+    assert_no_difference -> { @user.notification_bundles.count } do
+      @notification.update!(source: events(:logo_assignment_david), creator: users(:kevin))
+    end
+  end
+end
