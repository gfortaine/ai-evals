--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,26 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    subscription.update!(subscription_params.merge(user_agent: request.user_agent))
+
+    head :created
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..25a081d
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,110 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "details", "error" ]
+  static values = { url: String, vapidPublicKey: String }
+
+  async connect() {
+    if (this.#supported) {
+      try {
+        const registration = await this.#serviceWorkerRegistration()
+        const subscription = await registration.pushManager.getSubscription()
+
+        if (subscription && Notification.permission === "granted") {
+          await this.#persist(subscription)
+          this.#render(true)
+        } else {
+          this.#render(false, Notification.permission === "denied")
+        }
+      } catch (error) {
+        this.#report(error)
+      }
+    } else if ("Notification" in window) {
+      this.#render(false, Notification.permission === "denied")
+    } else {
+      this.#render(false, true)
+    }
+  }
+
+  async subscribe() {
+    if (!this.#supported) {
+      this.#report(new Error("Push notifications are not supported on this device"))
+      return
+    }
+
+    this.#clearError()
+    this.buttonTarget.disabled = true
+
+    try {
+      const permission = await Notification.requestPermission()
+
+      if (permission === "granted") {
+        const registration = await this.#serviceWorkerRegistration()
+        const subscription = await registration.pushManager.getSubscription() ||
+          await registration.pushManager.subscribe({
+            userVisibleOnly: true,
+            applicationServerKey: this.#applicationServerKey
+          })
+
+        await this.#persist(subscription)
+        this.#render(true)
+      } else {
+        this.#render(false, permission === "denied")
+      }
+    } catch (error) {
+      this.#report(error)
+    } finally {
+      this.buttonTarget.disabled = false
+    }
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const bytes = window.atob(base64)
+
+    return Uint8Array.from(bytes, character => character.charCodeAt(0))
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window &&
+      "Notification" in window && this.vapidPublicKeyValue.length > 0
+  }
+
+  #serviceWorkerRegistration() {
+    return this.serviceWorkerRegistrationPromise ||= navigator.serviceWorker.ready
+  }
+
+  async #persist(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.urlValue, {
+      body: {
+        push_subscription: {
+          endpoint,
+          p256dh_key: keys.p256dh,
+          auth_key: keys.auth
+        }
+      }
+    })
+
+    if (!response.ok) {
+      throw new Error(`Unable to save push subscription (${response.statusCode})`)
+    }
+  }
+
+  #render(enabled, blocked = false) {
+    this.element.classList.toggle("notifications--on", enabled)
+    this.detailsTargets.forEach(details => details.hidden = !blocked)
+  }
+
+  #report(error) {
+    console.error(error)
+    this.#render(false)
+    this.errorTarget.hidden = false
+  }
+
+  #clearError() {
+    this.errorTarget.hidden = true
+  }
+}
