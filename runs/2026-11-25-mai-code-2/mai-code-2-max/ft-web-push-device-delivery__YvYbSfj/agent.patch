+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscription",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "sets the account from the user" do
+    assert_equal @user.account, @subscription.account
+  end
+
+  test "requires push credentials" do
+    subscription = @user.push_subscriptions.new(endpoint: nil, p256dh_key: nil, auth_key: nil)
+
+    assert_not subscription.valid?
+    assert subscription.errors.added?(:endpoint, :blank)
+    assert subscription.errors.added?(:p256dh_key, :blank)
+    assert subscription.errors.added?(:auth_key, :blank)
+  end
+
+  test "delivers the tray payload with VAPID credentials" do
+    delivered = nil
+
+    WebPush.expects(:payload_send).with do |*options|
+      delivered = options.first
+      true
+    end
+
+    with_vapid_keys do
+      @subscription.deliver(@notification)
+    end
+
+    payload = JSON.parse(delivered[:message])
+
+    assert_equal @subscription.endpoint, delivered[:endpoint]
+    assert_equal @subscription.p256dh_key, delivered[:p256dh]
+    assert_equal @subscription.auth_key, delivered[:auth]
+    assert_equal({ public_key: "public-key", private_key: "private-key" }, delivered[:vapid])
+    assert_equal ApplicationController.helpers.event_notification_title(@notification.source), payload["title"]
+    assert_equal ApplicationController.helpers.event_notification_body(@notification.source), payload["body"]
+    assert payload.dig("card", "url").end_with?("/cards/#{@notification.card.to_param}")
+    assert_equal payload.dig("card", "url"), payload["url"]
+  end
+
+  test "removes subscriptions rejected by the push service" do
+    response = Struct.new(:body) do
+      def inspect
+        "410 Gone"
+      end
+    end.new("Gone")
+    error = WebPush::ExpiredSubscription.new(response, "push.example.com")
+
+    WebPush.stubs(:payload_send).raises(error)
+
+    with_vapid_keys do
+      assert_difference -> { Push::Subscription.count }, -1 do
+        @subscription.deliver(@notification)
+      end
+    end
+  end
+
+  test "deliver later enqueues a delivery job" do
+    assert_enqueued_with(job: Push::Subscription::DeliveryJob, args: [ @subscription, @notification ]) do
+      @subscription.deliver_later(@notification)
+    end
+  end
+
+  private
+    def with_vapid_keys
+      previous_public_key = ENV["VAPID_PUBLIC_KEY"]
+      previous_private_key = ENV["VAPID_PRIVATE_KEY"]
+      ENV["VAPID_PUBLIC_KEY"] = "public-key"
+      ENV["VAPID_PRIVATE_KEY"] = "private-key"
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = previous_public_key
+      ENV["VAPID_PRIVATE_KEY"] = previous_private_key
+    end
+end
