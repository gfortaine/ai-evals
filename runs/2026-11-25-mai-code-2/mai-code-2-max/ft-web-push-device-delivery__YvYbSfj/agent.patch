diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..2bdac0d
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,41 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }
+
+  def deliver_later(notification)
+    DeliveryJob.perform_later(self, notification)
+  end
+
+  def deliver(notification)
+    WebPush.payload_send(
+      message: payload_for(notification),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: {
+        public_key: ENV.fetch("VAPID_PUBLIC_KEY"),
+        private_key: ENV.fetch("VAPID_PRIVATE_KEY")
+      }
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy!
+  end
+
+  private
+    def payload_for(notification)
+      payload = renderer.render(
+        partial: "notifications/notification",
+        formats: [ :json ],
+        locals: { notification: notification }
+      )
+
+      JSON.parse(payload).tap { it["url"] = it.dig("card", "url") }.to_json
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(script_name: account.slug, https: !Rails.env.local?)
+    end
+end
