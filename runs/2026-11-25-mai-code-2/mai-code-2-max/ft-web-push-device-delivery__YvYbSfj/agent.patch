diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..b94a6a2
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create stores the subscription for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user),
+        params: subscription_params,
+        headers: { "HTTP_USER_AGENT" => "Test browser" },
+        as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal @user.account, subscription.account
+    assert_equal "https://push.example.com/subscription", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal "Test browser", subscription.user_agent
+  end
+
+  test "create refreshes an existing endpoint instead of creating a duplicate" do
+    subscription = @user.push_subscriptions.create!(subscription_params[:push_subscription])
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: subscription_params[:push_subscription].merge(
+          p256dh_key: "new-p256dh-key",
+          auth_key: "new-auth-key"
+        )
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "new-p256dh-key", subscription.reload.p256dh_key
+    assert_equal "new-auth-key", subscription.auth_key
+  end
+
+  test "create is forbidden for another user" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: subscription_params, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  private
+    def subscription_params
+      {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscription",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }
+    end
+end
