diff --git a/test/controllers/pages_controller_test.rb b/test/controllers/pages_controller_test.rb
index 0b0ccec..b892031 100644
--- a/test/controllers/pages_controller_test.rb
+++ b/test/controllers/pages_controller_test.rb
@@ -1,6 +1,9 @@
 require "test_helper"
 
 class PagesControllerTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+  include ActiveJob::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -79,7 +82,53 @@ class PagesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "With even more interesting words.", updated_page.body.content
   end
 
+  test "update broadcasts the being edited indicator only to current editors" do
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+    book.update!(everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id, users(:david).id ], readers: [])
+
+    get edit_leafable_path(leaf)
+
+    subscription = css_select("turbo-cable-stream-source").first
+    assert_equal stream_name_for(leaf, :being_edited, users(:kevin)),
+      Turbo::StreamsChannel.verified_stream_name(subscription["signed-stream-name"])
+
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { leaf: { title: "Better welcome" }, page: { body: "A new edit." } }
+    end
+
+    assert_response :no_content
+    assert_broadcasts stream_name_for(leaf, :being_edited, users(:kevin)), 1
+    assert_broadcasts stream_name_for(leaf, :being_edited, users(:david)), 1
+    assert_no_broadcasts stream_name_for(leaf, :being_edited, users(:jason))
+    assert_no_broadcasts stream_name_for(leaf, :being_edited)
+
+    payload = ActiveSupport::JSON.decode(broadcasts(stream_name_for(leaf, :being_edited, users(:david))).first)
+    assert_includes payload, users(:kevin).name
+  end
+
+  test "queued being edited indicators skip collaborators whose access was removed" do
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+    book.update!(everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id, users(:david).id ], readers: [])
+
+    put leafable_path(leaf), params: { page: { body: "A new edit." } }
+
+    book.update_access(editors: [ users(:kevin).id ], readers: [])
+    perform_enqueued_jobs
+
+    assert_broadcasts stream_name_for(leaf, :being_edited, users(:kevin)), 1
+    assert_no_broadcasts stream_name_for(leaf, :being_edited, users(:david))
+    assert_no_broadcasts stream_name_for(leaf, :being_edited)
+  end
+
   private
+    def stream_name_for(*streamables)
+      Turbo::StreamsChannel.send(:stream_name_from, streamables)
+    end
+
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
     end
