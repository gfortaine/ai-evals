diff --git a/app/jobs/broadcast_being_edited_job.rb b/app/jobs/broadcast_being_edited_job.rb
new file mode 100644
index 0000000..73afeb5
--- /dev/null
+++ b/app/jobs/broadcast_being_edited_job.rb
@@ -0,0 +1,10 @@
+class BroadcastBeingEditedJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(leaf, user)
+    leaf.book.editors.find_each do |editor|
+      Turbo::StreamsChannel.broadcast_render_to leaf, :being_edited, editor,
+        partial: "leaves/being_edited_by", locals: { leaf: leaf, user: user }
+    end
+  end
+end
diff --git a/app/models/book/accessable.rb b/app/models/book/accessable.rb
