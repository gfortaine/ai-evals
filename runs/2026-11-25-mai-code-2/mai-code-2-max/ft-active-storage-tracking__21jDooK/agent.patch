diff --git a/test/models/storage/usage_test.rb b/test/models/storage/usage_test.rb
new file mode 100644
index 0000000..8519b07
--- /dev/null
+++ b/test/models/storage/usage_test.rb
@@ -0,0 +1,226 @@
+require "test_helper"
+
+class Storage::UsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "counts card images and embedded files on a board and its account" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    comment = card.comments.create!(body: "With a file", creator: users(:david))
+
+    image = create_blob("card image", "card.png")
+    board_file = create_blob("board file", "board.txt")
+    card_file = create_blob("card file", "card.txt")
+    comment_file = create_blob("comment file", "comment.txt")
+    other_board_file = create_blob("other board file", "other-board.txt")
+
+    card.image.attach(image)
+    append_embeds(board, :public_description, board_file)
+    append_embeds(card, :description, card_file)
+    append_embeds(comment, :body, comment_file)
+    append_embeds(boards(:private), :public_description, other_board_file)
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, board.account.reload.bytes_used
+
+    perform_storage_jobs
+
+    expected = image.byte_size + board_file.byte_size + card_file.byte_size + comment_file.byte_size
+    assert_equal expected, board.reload.bytes_used
+    assert_equal expected + other_board_file.byte_size, board.account.reload.bytes_used
+    assert_equal other_board_file.byte_size, boards(:private).reload.bytes_used
+  end
+
+  test "does not count unrelated active storage attachments" do
+    avatar = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("avatar.png")),
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+    create_blob("unattached", "unattached.txt")
+
+    users(:david).avatar.attach(avatar)
+
+    perform_storage_jobs
+
+    assert_equal 0, boards(:writebook).reload.bytes_used
+    assert_equal 0, accounts("37s").reload.bytes_used
+    assert_equal 0, Storage::Usage.where(source_id: users(:david).id).count
+  end
+
+  test "replaces and removes a card image" do
+    card = cards(:logo)
+    old_image = create_blob("old", "old.png")
+    new_image = create_blob("new image", "new.png")
+
+    card.image.attach(old_image)
+    perform_storage_jobs
+    assert_equal old_image.byte_size, card.board.reload.bytes_used
+
+    card.image.attach(new_image)
+    perform_storage_jobs
+    assert_equal new_image.byte_size, card.board.reload.bytes_used
+
+    card.image.detach
+    perform_storage_jobs
+    assert_equal 0, card.board.reload.bytes_used
+    assert_equal 0, card.account.reload.bytes_used
+  end
+
+  test "moves card and comment usage to the new board" do
+    card = cards(:logo)
+    old_board = card.board
+    new_board = boards(:private)
+    comment = card.comments.create!(body: "With a file", creator: users(:david))
+    image = create_blob("image", "image.png")
+    comment_file = create_blob("comment file", "comment.txt")
+
+    card.image.attach(image)
+    append_embeds(comment, :body, comment_file)
+    perform_storage_jobs
+
+    expected = image.byte_size + comment_file.byte_size
+    assert_equal expected, old_board.reload.bytes_used
+
+    card.move_to(new_board)
+    perform_storage_jobs
+
+    assert_equal 0, old_board.reload.bytes_used
+    assert_equal expected, new_board.reload.bytes_used
+    assert_equal expected, card.account.reload.bytes_used
+  end
+
+  test "removes embedded usage when descriptions change" do
+    card = cards(:logo)
+    file = create_blob("description", "description.txt")
+
+    append_embeds(card, :description, file)
+    perform_storage_jobs
+    assert_equal file.byte_size, card.board.reload.bytes_used
+
+    card.update!(description: "No more file")
+    perform_storage_jobs
+
+    assert_equal 0, card.board.reload.bytes_used
+    assert_equal 0, card.account.reload.bytes_used
+  end
+
+  test "removes detached embedded files" do
+    card = cards(:logo)
+    file = create_blob("description", "description.txt")
+
+    append_embeds(card, :description, file)
+    perform_storage_jobs
+    assert_equal file.byte_size, card.board.reload.bytes_used
+
+    card.description.embeds.detach
+    perform_storage_jobs
+
+    assert_equal 0, card.board.reload.bytes_used
+    assert_equal 0, card.account.reload.bytes_used
+  end
+
+  test "removes usage when a comment is destroyed" do
+    card = cards(:logo)
+    comment = card.comments.create!(body: "With a file", creator: users(:david))
+    file = create_blob("comment", "comment.txt")
+
+    append_embeds(comment, :body, file)
+    perform_storage_jobs
+    assert_equal file.byte_size, card.board.reload.bytes_used
+
+    comment.destroy!
+    perform_storage_jobs
+
+    assert_equal 0, card.board.reload.bytes_used
+    assert_equal 0, card.account.reload.bytes_used
+    assert_not Storage::Usage.exists?(source_type: "Comment", source_id: comment.id)
+  end
+
+  test "removes usage when a board is destroyed" do
+    board = Board.create!(name: "Temporary", creator: users(:david))
+    file = create_blob("board file", "board.txt")
+
+    append_embeds(board, :public_description, file)
+    perform_storage_jobs
+    assert_equal file.byte_size, board.account.reload.bytes_used
+
+    board.destroy!
+    perform_storage_jobs
+
+    assert_equal 0, board.account.reload.bytes_used
+    assert_not Storage::Usage.exists?(source_type: "Board", source_id: board.id)
+  end
+
+  test "requeues stale calculations" do
+    card = cards(:logo)
+    image = create_blob("image", "image.png")
+    card.image.attach(image)
+
+    usage = Storage::Usage.find_by!(source_type: "Card", source_id: card.id)
+    usage.update_column(:queued_at, 1.hour.ago)
+    clear_enqueued_jobs
+
+    assert_enqueued_jobs 1, only: Storage::Usage::RecalculateJob do
+      Storage::Usage.requeue_stale
+    end
+
+    perform_storage_jobs
+    assert_equal image.byte_size, card.board.reload.bytes_used
+  end
+
+  test "coalesces a multi-file edit into one calculation" do
+    card = cards(:logo)
+    first = create_blob("first", "first.txt")
+    second = create_blob("second", "second.txt")
+
+    assert_enqueued_jobs 1, only: Storage::Usage::RecalculateJob do
+      append_embeds(card, :description, first, second)
+    end
+
+    assert_equal 1, Storage::Usage.find_by!(source_type: "Card", source_id: card.id).revision
+    perform_storage_jobs
+    assert_equal first.byte_size + second.byte_size, card.board.reload.bytes_used
+  end
+
+  test "rebuilds totals from existing attachments" do
+    card = cards(:logo)
+    image = create_blob("image", "image.png")
+    file = create_blob("description", "description.txt")
+    card.image.attach(image)
+    append_embeds(card, :description, file)
+    perform_storage_jobs
+
+    Storage::Usage.delete_all
+    card.board.update_column(:bytes_used, 0)
+    card.account.update_column(:bytes_used, 0)
+
+    Storage::Usage.rebuild_account(card.account)
+
+    expected = image.byte_size + file.byte_size
+    assert_equal expected, card.board.reload.bytes_used
+    assert_equal expected, card.account.reload.bytes_used
+  end
+
+  private
+    def create_blob(contents, filename)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(contents),
+        filename: filename,
+        content_type: "application/octet-stream"
+      )
+    end
+
+    def append_embeds(record, attribute, *blobs)
+      rich_text = record.public_send(attribute)
+      content = ActionText::Content.new(rich_text.body.to_s)
+      rich_text.body = content.append_attachables(blobs)
+      record.save!
+    end
+
+    def perform_storage_jobs
+      perform_enqueued_jobs only: [ Storage::Usage::RecalculateJob, Storage::Usage::MoveCardJob ]
+    end
+end
