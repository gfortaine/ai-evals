@@ -0,0 +1,17 @@
+module Storage::ActionTextTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :track_storage_usage_later, if: :body_previously_changed?
+    after_destroy_commit :remove_storage_usage_later
+  end
+
+  private
+    def track_storage_usage_later
+      Storage::Usage.track_rich_text_later(self)
+    end
+
+    def remove_storage_usage_later
+      Storage::Usage.track_deleted_later(record_type, record_id)
+    end
+end
diff --git a/app/models/storage/attached_many_tracking.rb b/app/models/storage/attached_many_tracking.rb
new file mode 100644
index 0000000..873df61
--- /dev/null
+++ b/app/models/storage/attached_many_tracking.rb
@@ -0,0 +1,16 @@
+module Storage::AttachedManyTracking
+  def detach
+    super.tap do
+      track_rich_text_storage_usage_later if tracked_rich_text?
+    end
+  end
+
+  private
+    def track_rich_text_storage_usage_later
+      Storage::Usage.track_later(record.record_type, record.record_id)
+    end
+
+    def tracked_rich_text?
+      record.is_a?(ActionText::RichText) && Storage::Usage::RICH_TEXT_NAMES[record.record_type] == record.name
+    end
+end
diff --git a/app/models/storage/attachment_tracking.rb b/app/models/storage/attachment_tracking.rb
new file mode 100644
index 0000000..a280624
--- /dev/null
+++ b/app/models/storage/attachment_tracking.rb
@@ -0,0 +1,37 @@
+module Storage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  prepended do
+    after_create_commit :track_created_card_image_storage_usage_later
+    after_destroy_commit :track_destroyed_card_image_storage_usage_later
+  end
+
+  def delete(...)
+    source = storage_source
+
+    super.tap do
+      Storage::Usage.track_later(*source) if source
+    end
+  end
+
+  private
+    def track_created_card_image_storage_usage_later
+      Storage::Usage.track_later(record_type, record_id) if card_image_attachment?
+    end
+
+    def track_destroyed_card_image_storage_usage_later
+      Storage::Usage.track_later(record_type, record_id) if card_image_attachment?
+    end
+
+    def storage_source
+      if card_image_attachment?
+        [ record_type, record_id ]
+      elsif record_type == "ActionText::RichText" && name == "embeds"
+        ActionText::RichText.where(id: record_id).pick(:record_type, :record_id)
+      end
+    end
+
+    def card_image_attachment?
+      record_type == "Card" && name == "image"
+    end
+end
