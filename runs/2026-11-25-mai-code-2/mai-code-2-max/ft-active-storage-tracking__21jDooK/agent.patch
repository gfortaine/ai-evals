diff --git a/app/models/storage/usage.rb b/app/models/storage/usage.rb
new file mode 100644
index 0000000..3361aef
--- /dev/null
+++ b/app/models/storage/usage.rb
@@ -0,0 +1,391 @@
+class Storage::Usage < ApplicationRecord
+  self.table_name = "storage_usages"
+
+  AGGREGATE_BATCH_SIZE = 1_000
+  STALE_CALCULATION_AFTER = 15.minutes
+
+  SOURCE_TYPES = %w[ Board Card Comment ].freeze
+  RICH_TEXT_NAMES = {
+    "Board" => "public_description",
+    "Card" => "description",
+    "Comment" => "body"
+  }.freeze
+
+  scope :stale, -> { where(queued_at: ...STALE_CALCULATION_AFTER.ago) }
+
+  validates :source_type, inclusion: { in: SOURCE_TYPES }
+
+  class << self
+    def track_rich_text_later(rich_text)
+      if RICH_TEXT_NAMES[rich_text.record_type] == rich_text.name
+        usage = find_by(source_type: rich_text.record_type, source_id: rich_text.record_id)
+        track_later(rich_text.record_type, rich_text.record_id) if usage || rich_text.embeds_attachments.exists?
+      end
+    end
+
+    def track_later(source_type, source_id)
+      if parent = parent_for(source_type, source_id)
+        usage = create_or_find_by!(source_type: source_type, source_id: source_id) do |record|
+          record.assign_attributes(parent)
+          record.bytes_used = 0
+        end
+
+        queue_calculation(usage)
+      else
+        track_deleted_later(source_type, source_id)
+      end
+    end
+
+    def track_deleted_later(source_type, source_id)
+      if usage = find_by(source_type: source_type, source_id: source_id)
+        queue_calculation(usage)
+      end
+    end
+
+    def recalculate(source_type, source_id)
+      if usage = find_by(source_type: source_type, source_id: source_id)
+        revision = usage.revision
+        parent = parent_for(source_type, source_id)
+        new_bytes_used = parent ? bytes_for(source_type, source_id) : 0
+        changed_while_calculating = false
+
+        transaction do
+          if locked_usage = lock.find_by(id: usage.id)
+            if locked_usage.revision == revision
+              locked_usage.reconcile_to(parent, new_bytes_used)
+            else
+              changed_while_calculating = true
+            end
+          end
+        end
+
+        enqueue_recalculation(source_type, source_id) if changed_while_calculating
+      end
+    end
+
+    def move_card(card_id)
+      Card.transaction do
+        if Card.lock.find_by(id: card_id)
+          parent = parent_for("Card", card_id)
+          where(card_id: card_id).find_each { |usage| usage.relocate_to(parent) } if parent
+        end
+      end
+    end
+
+    def requeue_stale
+      cutoff = STALE_CALCULATION_AFTER.ago
+
+      stale.find_each do |usage|
+        requeued = false
+
+        transaction do
+          if locked_usage = lock.find_by(id: usage.id)
+            if locked_usage.queued_at && locked_usage.queued_at < cutoff
+              locked_usage.update!(queued_at: Time.current)
+              requeued = true
+            end
+          end
+        end
+
+        enqueue_recalculation(usage.source_type, usage.source_id) if requeued
+      end
+    end
+
+    def rebuild_account(account)
+      account_id = account.id
+
+      where(account_id: account_id).delete_all
+      Board.where(account_id: account_id).update_all(bytes_used: 0)
+      Account.where(id: account_id).update_all(bytes_used: 0)
+
+      SOURCE_TYPES.each do |source_type|
+        insert_aggregates_for(account_id, source_type)
+      end
+
+      refresh_account_counters(account_id)
+    end
+
+    private
+      def queue_calculation(usage)
+        should_enqueue = false
+
+        # One queued job covers bursty edits; revisions make it retry if work lands while it calculates.
+        transaction do
+          if locked_usage = lock.find_by(id: usage.id)
+            should_enqueue = locked_usage.queued_at.nil?
+            locked_usage.queued_at ||= Time.current
+            locked_usage.revision += 1
+            locked_usage.save!
+          end
+        end
+
+        enqueue_recalculation(usage.source_type, usage.source_id) if should_enqueue
+      end
+
+      def enqueue_recalculation(source_type, source_id)
+        Storage::Usage::RecalculateJob.perform_later(source_type, source_id)
+      end
+
+      def parent_for(source_type, source_id)
+        case source_type
+        when "Board"
+          if row = Board.where(id: source_id).pick(:account_id, :id)
+            { account_id: row.first, board_id: row.last, card_id: nil }
+          end
+        when "Card"
+          if row = Card.joins(:board).where(id: source_id).pick("boards.account_id", "cards.board_id", "cards.id")
+            { account_id: row[0], board_id: row[1], card_id: row[2] }
+          end
+        when "Comment"
+          if row = Comment.joins(card: :board).where(id: source_id).pick("boards.account_id", "cards.board_id", "comments.card_id")
+            { account_id: row[0], board_id: row[1], card_id: row[2] }
+          end
+        end
+      end
+
+      def bytes_for(source_type, source_id)
+        embedded_bytes(source_type, source_id) + (source_type == "Card" ? image_bytes(source_id) : 0)
+      end
+
+      def embedded_bytes(source_type, source_id)
+        rich_text_ids = ActionText::RichText
+          .where(record_type: source_type, record_id: source_id, name: RICH_TEXT_NAMES.fetch(source_type))
+          .select(:id)
+
+        ActiveStorage::Attachment
+          .joins(:blob)
+          .where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds")
+          .sum("active_storage_blobs.byte_size")
+          .to_i
+      end
+
+      def image_bytes(card_id)
+        ActiveStorage::Attachment
+          .joins(:blob)
+          .where(record_type: "Card", record_id: card_id, name: "image")
+          .sum("active_storage_blobs.byte_size")
+          .to_i
+      end
+
+      def normalize_uuid(value)
+        if value && value.to_s.bytesize == 16
+          Account.type_for_attribute("id").deserialize(value)
+        else
+          value
+        end
+      end
+
+      def quote_uuid(value)
+        connection.quote(Account.type_for_attribute("id").serialize(normalize_uuid(value)))
+      end
+
+      def insert_aggregates_for(account_id, source_type)
+        after_source_id = nil
+
+        loop do
+          rows = aggregate_rows(account_id, source_type, after_source_id: after_source_id)
+          insert_aggregate_rows(rows, source_type)
+
+          break if rows.length < AGGREGATE_BATCH_SIZE
+
+          after_source_id = rows.last["source_id"]
+        end
+      end
+
+      def aggregate_rows(account_id, source_type, after_source_id:)
+        quoted_account_id = quote_uuid(account_id)
+        cursor = if after_source_id
+          "AND %{column} > #{quote_uuid(after_source_id)}"
+        else
+          ""
+        end
+
+        sql = case source_type
+        when "Board"
+          <<~SQL.squish
+            SELECT rich_texts.record_id AS source_id,
+                   boards.account_id AS account_id,
+                   boards.id AS board_id,
+                   NULL AS card_id,
+                   SUM(blobs.byte_size) AS bytes_used
+              FROM active_storage_attachments AS attachments
+              JOIN active_storage_blobs AS blobs ON blobs.id = attachments.blob_id
+              JOIN action_text_rich_texts AS rich_texts
+                ON rich_texts.id = attachments.record_id
+               AND attachments.record_type = 'ActionText::RichText'
+              JOIN boards ON boards.id = rich_texts.record_id
+             WHERE attachments.name = 'embeds'
+               AND rich_texts.record_type = 'Board'
+               AND rich_texts.name = 'public_description'
+               AND boards.account_id = #{quoted_account_id}
+               #{format(cursor, column: "rich_texts.record_id")}
+             GROUP BY rich_texts.record_id, boards.account_id, boards.id
+             ORDER BY rich_texts.record_id
+             LIMIT #{AGGREGATE_BATCH_SIZE}
+          SQL
+        when "Card"
+          <<~SQL.squish
+            SELECT source_id, account_id, board_id, card_id, SUM(bytes_used) AS bytes_used
+              FROM (
+                SELECT cards.id AS source_id,
+                       boards.account_id AS account_id,
+                       cards.board_id AS board_id,
+                       cards.id AS card_id,
+                       blobs.byte_size AS bytes_used
+                  FROM active_storage_attachments AS attachments
+                  JOIN active_storage_blobs AS blobs ON blobs.id = attachments.blob_id
+                  JOIN cards ON cards.id = attachments.record_id
+                  JOIN boards ON boards.id = cards.board_id
+                 WHERE attachments.record_type = 'Card'
+                   AND attachments.name = 'image'
+                   AND boards.account_id = #{quoted_account_id}
+                   #{format(cursor, column: "cards.id")}
+
+                UNION ALL
+
+                SELECT cards.id AS source_id,
+                       boards.account_id AS account_id,
+                       cards.board_id AS board_id,
+                       cards.id AS card_id,
+                       blobs.byte_size AS bytes_used
+                  FROM active_storage_attachments AS attachments
+                  JOIN active_storage_blobs AS blobs ON blobs.id = attachments.blob_id
+                  JOIN action_text_rich_texts AS rich_texts
+                    ON rich_texts.id = attachments.record_id
+                   AND attachments.record_type = 'ActionText::RichText'
+                  JOIN cards ON cards.id = rich_texts.record_id
+                  JOIN boards ON boards.id = cards.board_id
+                 WHERE attachments.name = 'embeds'
+                   AND rich_texts.record_type = 'Card'
+                   AND rich_texts.name = 'description'
+                   AND boards.account_id = #{quoted_account_id}
+                   #{format(cursor, column: "cards.id")}
+              ) AS card_storage
+             GROUP BY source_id, account_id, board_id, card_id
+             ORDER BY source_id
+             LIMIT #{AGGREGATE_BATCH_SIZE}
+          SQL
+        when "Comment"
+          <<~SQL.squish
+            SELECT rich_texts.record_id AS source_id,
+                   boards.account_id AS account_id,
+                   cards.board_id AS board_id,
+                   comments.card_id AS card_id,
+                   SUM(blobs.byte_size) AS bytes_used
+              FROM active_storage_attachments AS attachments
+              JOIN active_storage_blobs AS blobs ON blobs.id = attachments.blob_id
+              JOIN action_text_rich_texts AS rich_texts
+                ON rich_texts.id = attachments.record_id
+               AND attachments.record_type = 'ActionText::RichText'
+              JOIN comments ON comments.id = rich_texts.record_id
+              JOIN cards ON cards.id = comments.card_id
+              JOIN boards ON boards.id = cards.board_id
+             WHERE attachments.name = 'embeds'
+               AND rich_texts.record_type = 'Comment'
+               AND rich_texts.name = 'body'
+               AND boards.account_id = #{quoted_account_id}
+               #{format(cursor, column: "rich_texts.record_id")}
+             GROUP BY rich_texts.record_id, boards.account_id, cards.board_id, comments.card_id
+             ORDER BY rich_texts.record_id
+             LIMIT #{AGGREGATE_BATCH_SIZE}
+          SQL
+        end
+
+        connection.select_all(sql).map do |row|
+          %w[ source_id account_id board_id card_id ].each do |column|
+            row[column] = normalize_uuid(row[column])
+          end
+
+          row
+        end
+      end
+
+      def insert_aggregate_rows(rows, source_type)
+        return if rows.empty?
+
+        now = Time.current
+        insert_all!(rows.map do |row|
+          {
+            id: ActiveRecord::Type::Uuid.generate,
+            source_type: source_type,
+            source_id: row["source_id"],
+            account_id: row["account_id"],
+            board_id: row["board_id"],
+            card_id: row["card_id"],
+            bytes_used: row["bytes_used"].to_i,
+            revision: 0,
+            created_at: now,
+            updated_at: now
+          }
+        end)
+      end
+
+      def refresh_account_counters(account_id)
+        quoted_account_id = quote_uuid(account_id)
+
+        connection.execute <<~SQL
+          UPDATE boards
+             SET bytes_used = COALESCE((
+               SELECT SUM(storage_usages.bytes_used)
+                 FROM storage_usages
+                WHERE storage_usages.board_id = boards.id
+             ), 0)
+           WHERE boards.account_id = #{quoted_account_id}
+        SQL
+
+        connection.execute <<~SQL
+          UPDATE accounts
+             SET bytes_used = COALESCE((
+               SELECT SUM(boards.bytes_used)
+                 FROM boards
+                WHERE boards.account_id = accounts.id
+             ), 0)
+           WHERE accounts.id = #{quoted_account_id}
+        SQL
+      end
+  end
+
+  def relocate_to(parent)
+    with_lock do
+      replace_parent_totals(parent, bytes_used)
+      assign_attributes(parent)
+      self.revision += 1
+      save!
+    end
+  end
+
+  def reconcile_to(parent, new_bytes_used)
+    replace_parent_totals(parent, new_bytes_used)
+
+    if parent
+      assign_attributes(parent)
+      self.bytes_used = new_bytes_used
+      self.queued_at = nil
+      save!
+    else
+      destroy!
+    end
+  end
+
+  private
+    def replace_parent_totals(new_parent, new_bytes_used)
+      account_deltas = Hash.new(0)
+      board_deltas = Hash.new(0)
+
+      account_deltas[account_id] -= bytes_used
+      account_deltas[new_parent[:account_id]] += new_bytes_used if new_parent
+      board_deltas[board_id] -= bytes_used
+      board_deltas[new_parent[:board_id]] += new_bytes_used if new_parent
+
+      adjust_counters(Account, account_deltas)
+      adjust_counters(Board, board_deltas)
+    end
+
+    def adjust_counters(model, deltas)
+      deltas.each do |id, delta|
+        if id && delta.nonzero?
+          model.where(id: id).update_all([ "bytes_used = bytes_used + ?", delta ])
+        end
+      end
+    end
+end
