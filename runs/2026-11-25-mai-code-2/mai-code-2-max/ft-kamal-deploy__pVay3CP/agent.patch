@@ -84,6 +84,41 @@ Rails.application.configure do
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
 
+  if app_fqdn = ENV["APP_FQDN"].presence
+    default_url_options = { host: app_fqdn, protocol: "https" }
+    config.action_controller.default_url_options = default_url_options
+    config.action_mailer.default_url_options = default_url_options
+
+    config.after_initialize do
+      Rails.application.routes.default_url_options.merge!(default_url_options)
+    end
+  end
+
+  if smtp_address = ENV["SMTP_ADDRESS"].presence
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.raise_delivery_errors = true
+
+    smtp_settings = {
+      address: smtp_address,
+      port: Integer(ENV.fetch("SMTP_PORT", "587")),
+      domain: ENV.fetch("SMTP_DOMAIN") { ENV.fetch("APP_FQDN") },
+      user_name: ENV["SMTP_USERNAME"].presence,
+      password: ENV["SMTP_PASSWORD"].presence
+    }
+
+    if ENV["SMTP_TLS"] == "true"
+      smtp_settings[:tls] = true
+    else
+      smtp_settings[:enable_starttls_auto] = ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+    end
+
+    if smtp_settings[:user_name]
+      smtp_settings[:authentication] = ENV.fetch("SMTP_AUTHENTICATION", "plain").to_sym
+    end
+
+    config.action_mailer.smtp_settings = smtp_settings
+  end
+
   # Don't log any deprecations.
