+# Copy this file to .kamal/secrets and fill in the values there. That file is
+# ignored by Git; these values are reused for every deploy and must stay stable.
+# Quote values that contain spaces or shell-special characters.
+
+# Generate once with: bin/rails secret
+SECRET_KEY_BASE=
+
+# Credentials from your SMTP provider.
+SMTP_USERNAME=
+SMTP_PASSWORD=
+
+# Generate the pair together with:
+# bin/rails runner 'key = WebPush.generate_key; puts "VAPID_PRIVATE_KEY=#{key.private_key}"; puts "VAPID_PUBLIC_KEY=#{key.public_key}"'
+VAPID_PRIVATE_KEY=
+VAPID_PUBLIC_KEY=
