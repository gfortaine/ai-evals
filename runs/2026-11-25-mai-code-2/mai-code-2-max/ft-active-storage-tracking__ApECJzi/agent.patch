+require "test_helper"
+
+class Storage::TrackableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "counts card images and files in board, card, and comment rich text" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+
+    expected_bytes = attach_card_image(card, "card image")
+    expected_bytes += embed_file(board, :public_description, "board description")
+    expected_bytes += embed_file(card, :description, "card description")
+    expected_bytes += embed_file(comment, :body, "comment body")
+
+    users(:david).avatar.attach(upload("avatar"))
+
+    perform_enqueued_jobs only: Storage::RecalculationJob
+
+    assert_equal expected_bytes, board.bytes_used
+    assert_equal expected_bytes, board.account.bytes_used
+  end
+
+  test "updates counters after counted attachments are removed" do
+    card = cards(:logo)
+    board = card.board
+
+    attach_card_image(card, "card image")
+    embed_file(card, :description, "card description")
+    perform_enqueued_jobs only: Storage::RecalculationJob
+
+    card.image.purge
+    card.update!(description: "<p>No attachment</p>")
+    perform_enqueued_jobs only: Storage::RecalculationJob
+
+    assert_equal 0, board.bytes_used
+    assert_equal 0, board.account.bytes_used
+  end
+
+  test "moves card attachment usage between boards" do
+    card = cards(:logo)
+    old_board = card.board
+    new_board = boards(:private)
+    expected_bytes = attach_card_image(card, "card image")
+
+    perform_enqueued_jobs only: Storage::RecalculationJob
+
+    card.move_to(new_board)
+    perform_enqueued_jobs only: Storage::RecalculationJob
+
+    assert_equal 0, old_board.bytes_used
+    assert_equal expected_bytes, new_board.bytes_used
+    assert_equal expected_bytes, new_board.account.bytes_used
+  end
+
+  test "removes a board's attachment usage when the board is destroyed" do
+    board = boards(:writebook)
+    attach_card_image(cards(:logo), "card image")
+    perform_enqueued_jobs only: Storage::RecalculationJob
+
+    board.destroy!
+    perform_enqueued_jobs only: Storage::RecalculationJob
+
+    assert_equal 0, board.account.bytes_used
+  end
+
+  test "coalesces recalculations for many attachment changes" do
+    blobs = 20.times.map { |index| upload_blob("file #{index}") }
+    body = blobs.map { |blob| ActionText::Attachment.from_attachable(blob).to_html }.join
+
+    assert_enqueued_jobs 1, only: Storage::RecalculationJob do
+      cards(:logo).update!(description: body)
+    end
+  end
+
+  test "keeps account usage isolated by board" do
+    account_bytes = attach_card_image(cards(:logo), "account card")
+    board_bytes = embed_file(boards(:private), :public_description, "private board")
+    other_account_bytes = attach_card_image(cards(:radio), "other account")
+
+    perform_enqueued_jobs only: Storage::RecalculationJob
+
+    assert_equal account_bytes, boards(:writebook).bytes_used
+    assert_equal board_bytes, boards(:private).bytes_used
+    assert_equal account_bytes + board_bytes, accounts(:"37s").bytes_used
+    assert_equal other_account_bytes, accounts(:initech).bytes_used
+  end
+
+  private
+    def attach_card_image(card, contents)
+      blob = upload_blob(contents)
+      card.image.attach(blob)
+      blob.byte_size
+    end
+
+    def embed_file(record, attribute, contents)
+      blob = upload_blob(contents)
+      record.update!(attribute => ActionText::Attachment.from_attachable(blob).to_html)
+      blob.byte_size
+    end
+
+    def upload_blob(contents)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new(contents), filename: "file.txt", content_type: "text/plain")
+    end
+
+    def upload(contents)
+      { io: StringIO.new(contents), filename: "avatar.txt", content_type: "text/plain" }
+    end
+end
