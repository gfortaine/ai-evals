diff --git a/app/models/storage/attachment_tracking.rb b/app/models/storage/attachment_tracking.rb
new file mode 100644
index 0000000..02d5263
--- /dev/null
+++ b/app/models/storage/attachment_tracking.rb
@@ -0,0 +1,54 @@
+module Storage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :remember_storage_owner
+    after_create_commit :track_storage_change
+    after_destroy_commit :track_destroyed_storage_change
+  end
+
+  def delete(*)
+    owner = storage_owner
+    deleted = super
+    Storage::Tracker.changed_after_commit(owner)
+    deleted
+  end
+
+  private
+    def remember_storage_owner
+      @storage_owner = storage_owner
+    end
+
+    def track_storage_change
+      Storage::Tracker.changed(storage_owner)
+    end
+
+    def track_destroyed_storage_change
+      Storage::Tracker.changed(@storage_owner)
+    end
+
+    def storage_owner
+      if record_type == "Card" && name == "image"
+        { account_id: account_id, board_id: Card.where(id: record_id).pick(:board_id) }
+      elsif record_type == "ActionText::RichText" && name == "embeds"
+        rich_text_storage_owner
+      end
+    end
+
+    def rich_text_storage_owner
+      if rich_text = ActionText::RichText.where(id: record_id).pick(:account_id, :record_type, :record_id, :name)
+        account_id, record_type, record_id, name = rich_text
+
+        board_id = case [ record_type, name ]
+        when [ "Board", "public_description" ]
+          record_id
+        when [ "Card", "description" ]
+          Card.where(id: record_id).pick(:board_id)
+        when [ "Comment", "body" ]
+          Comment.joins(:card).where(id: record_id).pick("cards.board_id")
+        end
+
+        { account_id: account_id, board_id: board_id } if board_id
+      end
+    end
+end
diff --git a/app/models/storage/trackable.rb b/app/models/storage/trackable.rb
new file mode 100644
index 0000000..ea7bc71
--- /dev/null
+++ b/app/models/storage/trackable.rb
@@ -0,0 +1,108 @@
+module Storage::Trackable
+  extend ActiveSupport::Concern
+
+  COLUMNS = %w[
+    storage_bytes
+    storage_revision
+    storage_calculated_at
+    storage_recalculation_queued_at
+  ].freeze
+
+  MAX_RECALCULATIONS = 10
+  STALE_RECALCULATION_AFTER = 1.hour
+
+  included do
+    before_create :initialize_storage_usage
+
+    scope :needing_storage_recalculation, -> {
+      where(storage_calculated_at: nil, storage_recalculation_queued_at: nil)
+        .or(where(storage_recalculation_queued_at: ...STALE_RECALCULATION_AFTER.ago))
+    }
+  end
+
+  def bytes_used
+    if persisted?
+      row = self.class.uncached do
+        self.class.where(id: id).pick(
+          :storage_bytes,
+          :storage_calculated_at,
+          :storage_recalculation_queued_at
+        )
+      end
+
+      if row
+        bytes, calculated_at, queued_at = row
+        recalculate_bytes_used_later if calculated_at.nil? && queued_at.nil?
+        bytes.to_i
+      else
+        0
+      end
+    else
+      storage_bytes.to_i
+    end
+  end
+
+  def recalculate_bytes_used_later(force: false)
+    if mark_storage_recalculation(force: force)
+      Storage::RecalculationJob.perform_later(self)
+    end
+  end
+
+  def recalculate_bytes_used_in_background
+    recalculate_bytes_used_now if mark_storage_recalculation
+  end
+
+  def recalculate_bytes_used_now
+    prepare_storage_recalculation
+
+    MAX_RECALCULATIONS.times do
+      reload
+      revision = storage_revision
+      bytes = Storage::Usage.calculate(self)
+
+      if store_calculated_bytes(bytes, revision)
+        storage_usage_recalculated
+        return bytes
+      end
+    end
+
+    with_lock { update_columns(storage_recalculation_queued_at: Time.current) }
+    Storage::RecalculationJob.perform_later(self)
+  end
+
+  private
+    def initialize_storage_usage
+      self.storage_calculated_at ||= Time.current
+    end
+
+    def prepare_storage_recalculation
+    end
+
+    def mark_storage_recalculation(force: false)
+      with_lock do
+        claimed = force || storage_recalculation_queued_at.nil?
+        attributes = { storage_revision: storage_revision + 1 }
+        attributes[:storage_recalculation_queued_at] = Time.current if claimed
+        update_columns(attributes)
+        claimed
+      end
+    end
+
+    def store_calculated_bytes(bytes, revision)
+      with_lock do
+        if storage_revision == revision
+          update_columns(
+            storage_bytes: bytes,
+            storage_calculated_at: Time.current,
+            storage_recalculation_queued_at: nil
+          )
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def storage_usage_recalculated
+    end
+end
diff --git a/app/models/storage/tracker.rb b/app/models/storage/tracker.rb
new file mode 100644
index 0000000..a192996
--- /dev/null
+++ b/app/models/storage/tracker.rb
@@ -0,0 +1,31 @@
+module Storage::Tracker
+  class << self
+    def changed(owner)
+      if owner.present?
+        board = Board.find_by(id: owner[:board_id])
+
+        if board
+          board.recalculate_bytes_used_later
+        else
+          account_changed(owner[:account_id])
+        end
+      end
+    end
+
+    def changed_after_commit(owner)
+      ActiveRecord.after_all_transactions_commit { changed(owner) }
+    end
+
+    def boards_changed(*board_ids)
+      Board.where(id: board_ids.compact.uniq).find_each(&:recalculate_bytes_used_later)
+    end
+
+    def account_changed(account_id)
+      Account.find_by(id: account_id)&.recalculate_bytes_used_later
+    end
+
+    def account_changed_in_background(account_id)
+      Account.find_by(id: account_id)&.recalculate_bytes_used_in_background
+    end
+  end
+end
diff --git a/app/models/storage/usage.rb b/app/models/storage/usage.rb
new file mode 100644
index 0000000..3855fd9
--- /dev/null
+++ b/app/models/storage/usage.rb
@@ -0,0 +1,101 @@
+class Storage::Usage
+  class << self
+    def calculate(record)
+      new(record).calculate
+    end
+  end
+
+  def initialize(record)
+    @record = record
+  end
+
+  def calculate
+    case record
+    when Account
+      calculated_account_bytes
+    when Board
+      calculated_board_bytes
+    else
+      raise ArgumentError, "Unsupported storage owner: #{record.class.name}"
+    end
+  end
+
+  private
+    attr_reader :record
+
+    def calculated_account_bytes
+      if boards.where(storage_calculated_at: nil).exists?
+        calculated_board_bytes
+      else
+        boards.sum(:storage_bytes).to_i
+      end
+    end
+
+    def calculated_board_bytes
+      attachment_bytes(card_image_attachments) + attachment_bytes(rich_text_attachments)
+    end
+
+    def attachment_bytes(attachments)
+      attachments.joins(:blob).sum("active_storage_blobs.byte_size").to_i
+    end
+
+    def card_image_attachments
+      attachments.where(
+        record_type: "Card",
+        record_id: cards.select(:id),
+        name: "image"
+      )
+    end
+
+    def rich_text_attachments
+      attachments.where(
+        record_type: "ActionText::RichText",
+        record_id: rich_texts.select(:id),
+        name: "embeds"
+      )
+    end
+
+    def attachments
+      ActiveStorage::Attachment.where(account_id: account_id)
+    end
+
+    def rich_texts
+      board_descriptions = account_rich_texts.where(
+        record_type: "Board",
+        record_id: boards.select(:id),
+        name: "public_description"
+      )
+      card_descriptions = account_rich_texts.where(
+        record_type: "Card",
+        record_id: cards.select(:id),
+        name: "description"
+      )
+      comment_bodies = account_rich_texts.where(
+        record_type: "Comment",
+        record_id: comments.select(:id),
+        name: "body"
+      )
+
+      board_descriptions.or(card_descriptions).or(comment_bodies)
+    end
+
+    def account_rich_texts
+      ActionText::RichText.where(account_id: account_id)
+    end
+
+    def comments
+      Comment.where(card_id: cards.select(:id))
+    end
+
+    def cards
+      record.cards
+    end
+
+    def boards
+      record.is_a?(Account) ? record.boards : Board.where(id: record.id)
+    end
+
+    def account_id
+      record.is_a?(Account) ? record.id : record.account_id
+    end
+end
