--- /dev/null
+++ b/app/jobs/storage/recalculation_recovery_job.rb
@@ -0,0 +1,13 @@
+class Storage::RecalculationRecoveryJob < ApplicationJob
+  queue_as :backend
+
+  def perform
+    Board.needing_storage_recalculation.find_each do |board|
+      board.recalculate_bytes_used_later(force: true)
+    end
+
+    Account.needing_storage_recalculation.find_each do |account|
+      account.recalculate_bytes_used_later(force: true)
+    end
+  end
+end
