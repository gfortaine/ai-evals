diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
new file mode 100644
index 0000000..f795e55
--- /dev/null
+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class MailerLocalizationTest < ActionMailer::TestCase
+  setup do
+    @identity = identities(:david)
+    @identity.update!(locale: :ja)
+    @user = users(:david)
+    @user.notifications.destroy_all
+  end
+
+  test "every mailer renders in the recipient locale" do
+    magic_link = MagicLink.create!(identity: @identity)
+    account = accounts(:"37s")
+    account.cancel(initiated_by: @user)
+    export = Account::Export.create!(account: account, user: @user)
+    import = Account::Import.create!(account: account, identity: @identity, status: :failed)
+
+    emails = [
+      MagicLinkMailer.sign_in_instructions(magic_link),
+      AccountMailer.cancellation(account.cancellation),
+      ExportMailer.completed(export),
+      ImportMailer.completed(@identity, account),
+      ImportMailer.failed(import),
+      UserMailer.email_change_confirmation(email_address: "new@example.com", token: "token", user: @user)
+    ]
+
+    emails.each do |email|
+      assert_japanese email
+    end
+  end
+
+  test "notification bundles render their email, dates, and event copy in Japanese" do
+    bundle = Notification::Bundle.create!(
+      user: @user,
+      starts_at: 1.hour.ago,
+      ends_at: 1.day.from_now
+    )
+    Notification.create!(user: @user, creator: @user, source: events(:logo_published), created_at: 30.minutes.ago)
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_japanese email
+    assert_match I18n.with_locale(:ja) { I18n.l(bundle.starts_at, format: :notification_bundle) }, email_body(email)
+    assert_match "が追加", email_body(email)
+  end
+
+  private
+    def assert_japanese(email)
+      assert_match /[ぁ-んァ-ヶ一-龯]/, email.subject
+      assert_match /[ぁ-んァ-ヶ一-龯]/, email_body(email)
+      refute_match(/What happens now\?|Download your data|Need help\?|New notifications|Please enter this 6-character/i, email_body(email))
+    end
+
+    def email_body(email)
+      parts = [ email.html_part, email.text_part ].compact
+      parts.any? ? parts.map { |part| part.body.decoded }.join("\n") : email.body.decoded
+    end
+end
