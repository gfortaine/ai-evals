diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..e881479
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "English remains the default" do
+    untenanted do
+      get new_session_path
+    end
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_select "h1", text: "Get into Fizzy"
+  end
+
+  test "supported locale switches the current session" do
+    untenanted do
+      get new_session_path(locale: :ja)
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyにログイン"
+
+      get new_session_path
+      assert_select "html[lang=ja]"
+    end
+  end
+
+  test "unsupported locale leaves the current locale alone" do
+    untenanted do
+      get new_session_path(locale: :ja)
+      get new_session_path(locale: :xx)
+    end
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_select "h1", text: "Fizzyにログイン"
+  end
+
+  test "locale is captured even when the page redirects before rendering" do
+    untenanted do
+      get root_path(locale: :ja)
+      assert_redirected_to session_menu_path
+
+      get new_session_path
+      assert_select "html[lang=ja]"
+    end
+  end
+
+test "Japanese renders application screens and their generated copy" do
+  sign_in_as identities(:kevin)
+
+  paths = [
+    root_path,
+    cards_path,
+    board_path(boards(:writebook)),
+    card_path(cards(:logo)),
+    new_board_path,
+    account_settings_path,
+    notifications_path,
+    notifications_settings_path,
+    user_path(users(:kevin)),
+    edit_user_path(users(:kevin)),
+    my_access_tokens_path,
+    my_passkeys_path,
+    board_webhooks_path(boards(:writebook)),
+    search_path
+  ]
+
+  paths.each do |path|
+    get path, params: { locale: :ja }
+    assert_response :success, "Expected #{path} to render in Japanese"
+    assert_select "html[lang=ja]"
+    assert_no_translatable_english(path)
+  end
+end
+
+  test "locale choice is saved on the identity and restored in a clean browser" do
+    identity = identities(:kevin)
+    sign_in_as identity
+
+    get notifications_settings_path(locale: :ja)
+    assert_response :success
+    assert_equal "ja", identity.reload.locale
+
+    cookies.delete :session_token
+    sign_in_as identity
+    get notifications_settings_path
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_select "h1", text: "通知設定"
+  end
+
+test "static error pages include English and Japanese" do
+  %w[400 404 406-unsupported-browser 422 500].each do |name|
+    html = Rails.root.join("public/#{name}.html").read
+    assert_match 'lang="en"', html
+    assert_match 'lang="ja"', html
+    assert_match /[ぁ-んァ-ヶ一-龯]/, html
+  end
+end
+
+private
+  def assert_no_translatable_english(path)
+    document = Nokogiri::HTML5(response.body)
+    document.css("script, style").remove
+    readable = document.text
+    readable << document.css("[title], [alt], [placeholder], [aria-label], [aria-description]").flat_map do |element|
+      %w[title alt placeholder aria-label aria-description].filter_map { |attribute| element[attribute] }
+    end.join(" ")
+
+    translations = I18n.t(:translations, locale: :ja)
+    untranslated = translations.filter_map do |key, translation|
+      source = key.to_s
+      source if source.length >= 8 && source != translation && !source.include?("%{") && !source.match?(/[<>]/) && readable.include?(source)
+    end
+
+    assert_empty untranslated, "English UI text rendered in Japanese on #{path}: #{untranslated.join(', ')}"
+  end
+
+  test "a clean sign in restores the identity locale on magic link emails" do
+    identity = identities(:kevin)
+    identity.update!(locale: :ja)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identity.email_address }
+      end
+    end
+
+    assert_equal [ "kevin@37signals.com" ], ActionMailer::Base.deliveries.last.to
+    assert_match "Fizzyの確認コード", ActionMailer::Base.deliveries.last.subject
+  end
+end
