diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..b2dc298
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,39 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_before_action :capture_locale
+    around_action :with_locale
+  end
+
+  private
+    def capture_locale
+      if locale = supported_locale(params[:locale])
+        session[:locale] = locale
+        persist_locale(locale)
+      end
+    end
+    def with_locale(&)
+      requested_locale = supported_locale(params[:locale])
+      session_locale = supported_locale(session[:locale])
+      identity_locale = supported_locale(locale_identity&.locale)
+      locale = requested_locale || session_locale || identity_locale || I18n.default_locale
+
+      session[:locale] = locale.to_s if requested_locale || session_locale || identity_locale
+
+
+      I18n.with_locale(locale, &)
+    end
+
+    def supported_locale(value)
+      value.to_s.presence&.in?(I18n.available_locales.map(&:to_s)) ? value.to_s : nil
+    end
+
+    def locale_identity
+      Current.identity || find_session_by_cookie&.identity
+    end
+
+    def persist_locale(locale)
+      locale_identity&.update!(locale: locale)
+    end
+end
