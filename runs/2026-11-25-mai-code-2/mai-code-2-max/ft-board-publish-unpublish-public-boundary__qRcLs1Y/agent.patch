diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..5c6e73e
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,22 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :published, -> { where.not(publication_key: nil) }
+  end
+
+  def publish
+    update!(publication_key: self.class.generate_unique_secure_token) unless publicly_accessible?
+  end
+
+  def unpublish
+    update!(publication_key: nil) if publicly_accessible?
+  end
+
+  def publicly_accessible?
+    publication_key.present?
+  end
+
+  alias published? publicly_accessible?
+  alias public? publicly_accessible?
+end
