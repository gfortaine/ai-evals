+class Public::BoardsController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthenticated_access
+  before_action :set_board
+
+  layout "public"
+
+  def show
+    @columns = @board.columns.sorted
+    @cards = @board.cards.published.latest.with_golden_first.preloaded.to_a
+
+    fresh_when etag: [ @board, @cards ]
+  end
+
+  private
+    def set_board
+      @board = Board.find_by!(publication_key: board_key)
+      Current.account = @board.account
+    end
+
+    def board_key
+      params[:key] || params[:board_key]
+    end
+end
