diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..0ad0d27
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "board is visible without authentication" do
+    get_public public_board_path(@board.publication_key)
+
+    assert_response :success
+    assert_in_body @board.name
+  end
+
+  test "board is available as JSON" do
+    get_public public_board_path(@board.publication_key, format: :json)
+
+    assert_response :success
+    assert_equal @board.name, response.parsed_body["name"]
+    assert_equal public_board_url(@board.publication_key, script_name: ""), response.parsed_body["url"]
+    assert_equal public_board_url(@board.publication_key, script_name: ""), response.parsed_body["public_url"]
+  end
+
+  test "board URL is revoked after unpublishing" do
+    public_path = public_board_path(@board.publication_key)
+    @board.unpublish
+
+    get_public public_path
+
+    assert_response :not_found
+  end
+
+  test "invalid key is not found" do
+    get_public public_board_path("not-a-real-key")
+
+    assert_response :not_found
+  end
+
+  test "board does not show drafts" do
+    draft = @board.cards.create!(status: :drafted, title: "Private draft", creator: users(:kevin))
+
+    get_public public_board_path(@board.publication_key)
+
+    assert_response :success
+    assert_not_includes response.body, draft.title
+  end
+
+  test "column is visible and only includes active published cards" do
+    column = columns(:writebook_triage)
+    draft = @board.cards.create!(status: :drafted, column: column, title: "Private column draft", creator: users(:kevin))
+
+    get_public public_board_column_path(@board.publication_key, column)
+
+    assert_response :success
+    assert_includes response.body, ERB::Util.html_escape(cards(:logo).title)
+    assert_not_includes response.body, draft.title
+  end
+
+  test "column is available as JSON" do
+    column = columns(:writebook_triage)
+
+    get_public public_board_column_path(@board.publication_key, column, format: :json)
+
+    assert_response :success
+    assert_equal column.name, response.parsed_body["name"]
+    assert_includes response.parsed_body["cards"].pluck("number"), cards(:logo).number
+  end
+
+  test "column must belong to the public board" do
+    other_column = boards(:private).columns.create!(name: "Private column")
+
+    get_public public_board_column_path(@board.publication_key, other_column)
+
+    assert_response :not_found
+  end
+
+  test "published card can be opened by number" do
+    get_public public_board_card_path(@board.publication_key, cards(:logo).number)
+
+    assert_response :success
+    assert_includes response.body, ERB::Util.html_escape(cards(:logo).title)
+    assert_select "form[action]", count: 0
+  end
+
+  test "published card is available as JSON" do
+    get_public public_board_card_path(@board.publication_key, cards(:logo).number, format: :json)
+
+    assert_response :success
+    assert_equal cards(:logo).title, response.parsed_body["title"]
+  end
+
+  test "card attachments are available while the board is public" do
+    card = cards(:logo)
+    card.image.attach fixture_file_upload("moon.jpg", "image/jpeg")
+    blob_path = rails_blob_path(card.image, script_name: "")
+
+    get_public blob_path
+
+    assert_response :redirect
+    assert_not_equal session_menu_url(script_name: ""), response.location
+
+    @board.unpublish
+    get_public blob_path
+
+    assert_redirected_to session_menu_url(script_name: "")
+  end
+
+  test "draft card cannot be opened" do
+    draft = @board.cards.create!(status: :drafted, title: "Private card", creator: users(:kevin))
+
+    get_public public_board_card_path(@board.publication_key, draft.number)
+
+    assert_response :not_found
+  end
+
+  test "card must belong to the public board" do
+    other_board = boards(:miltons_wish_list)
+    other_board.publish
+
+    get_public public_board_card_path(other_board.publication_key, cards(:text).number)
+
+    assert_response :not_found
+  end
+
+  private
+    def get_public(path, **options)
+      untenanted { get path.delete_prefix(@board.account.slug), **options }
+    end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..bbd1718
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "publishing creates a stable public key" do
+    assert_nil @board.publication_key
+
+    @board.publish
+    publication_key = @board.publication_key
+
+    assert_predicate publication_key, :present?
+    assert_predicate @board, :published?
+
+    @board.publish
+
+    assert_equal publication_key, @board.publication_key
+  end
+
+  test "unpublishing revokes the key and republishing creates a new one" do
+    @board.publish
+    previous_key = @board.publication_key
+
+    @board.unpublish
+
+    assert_nil @board.publication_key
+    assert_not_predicate @board, :published?
+
+    @board.publish
+
+    assert_not_equal previous_key, @board.publication_key
+  end
+
+  test "publication key is not included in account transfers" do
+    board_record_set = Account::DataTransfer::Manifest.new(@board.account).send(:record_sets).find { |record_set| record_set.model == Board }
+
+    assert_not_includes board_record_set.attributes, "publication_key"
+  end
+
+  test "only published cards on a published board are publicly accessible" do
+    @board.publish
+
+    assert_predicate cards(:logo), :publicly_accessible?
+    assert_predicate comments(:logo_agreement_jz), :publicly_accessible?
+    assert_not_predicate @board.cards.create!(status: :drafted, creator: users(:kevin)), :publicly_accessible?
+
+    @board.unpublish
+
+    assert_not_predicate cards(:logo).reload, :publicly_accessible?
+    assert_not_predicate comments(:logo_agreement_jz).reload, :publicly_accessible?
+  end
+end
