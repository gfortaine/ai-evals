+++ b/app/views/public/boards/cards/show.html.erb
@@ -0,0 +1,68 @@
+<% @page_title = @card.title %>
+<% @header_class = "header--card" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to @board.name, public_board_path(@board.publication_key),
+          "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+<% end %>
+
+<section class="card-perma" style="--card-color: <%= @card.color %>">
+  <div class="card-perma__bg">
+    <%= card_article_tag @card, class: "card" do %>
+      <header class="card__header">
+        <%= render "cards/display/common/board", card: @card %>
+        <%= render "cards/display/preview/tags", card: @card %>
+      </header>
+
+      <div class="card__body justify-space-between">
+        <div class="card__content">
+          <h1 class="card__title flex align-start gap-half"><%= card_html_title(@card) %></h1>
+
+          <% unless @card.description.blank? %>
+            <div class="card__description lexxy-content" data-controller="syntax-highlight retarget-links">
+              <%= @card.description %>
+            </div>
+          <% end %>
+
+          <% if @card.steps.any? %>
+            <ol class="steps txt-small margin-block-start-auto">
+              <% @card.steps.each do |step| %>
+                <li class="step">
+                  <%= check_box_tag nil, nil, step.completed?, disabled: true, class: "checkbox" %>
+                  <span class="step__content"><%= step.content %></span>
+                </li>
+              <% end %>
+            </ol>
+          <% end %>
+        </div>
+
+        <%= render "cards/display/common/stamp", card: @card %>
+      </div>
+
+      <footer class="card__footer">
+        <%= render "public/boards/meta", card: @card %>
+        <%= render "cards/display/common/background", card: @card %>
+
+        <% if @card.reactions.any? %>
+          <div class="reactions__list">
+            <% @card.reactions.each do |reaction| %>
+              <span class="reaction txt-small" aria-label="<%= reaction.reacter.name %> reacted <%= reaction.content %>">
+                <%= avatar_tag reaction.reacter %>
+                <%= reaction.content %>
+              </span>
+            <% end %>
+          </div>
+        <% end %>
+      </footer>
+    <% end %>
+  </div>
+</section>
+
+<% if @card.comments.any? %>
+  <%= messages_tag(@card) do %>
+    <%= render partial: "public/boards/cards/comment",
+          collection: @card.comments.preloaded.chronologically.includes(:creator), as: :comment %>
+  <% end %>
+<% end %>
