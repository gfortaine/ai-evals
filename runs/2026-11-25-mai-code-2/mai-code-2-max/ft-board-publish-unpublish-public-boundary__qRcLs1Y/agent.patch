index 0000000..832e86f
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admin publishes a board" do
+    post board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    assert_predicate @board.reload, :published?
+  end
+
+  test "admin publishes a board as JSON" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert_equal public_board_url(@board.reload.publication_key, script_name: ""), response.parsed_body["public_url"]
+  end
+
+  test "admin can manage publication from board settings" do
+    get edit_board_path(@board)
+
+    assert_response :success
+    assert_in_body "Publish board"
+
+    @board.publish
+    get edit_board_path(@board)
+
+    assert_in_body "Unpublish board"
+    assert_in_body public_board_url(@board.publication_key, script_name: "")
+  end
+
+  test "non-admin board creator does not see publication settings" do
+    logout_and_sign_in_as :david
+
+    get edit_board_path(@board)
+
+    assert_response :success
+    assert_not_includes response.body, "Public link"
+  end
+
+  test "admin unpublishes a board" do
+    @board.publish
+
+    delete board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    assert_nil @board.reload.publication_key
+  end
+
+  test "admin unpublishes a board as JSON" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_nil @board.reload.publication_key
+  end
+
+  test "board creator cannot publish without being an admin" do
+    logout_and_sign_in_as :david
+
+    post board_publication_path(@board)
+
+    assert_response :forbidden
+    assert_nil @board.reload.publication_key
+  end
+
+  test "member cannot unpublish a board" do
+    @board.publish
+    logout_and_sign_in_as :david
+
+    delete board_publication_path(@board)
+
+    assert_response :forbidden
+    assert_predicate @board.reload, :published?
+  end
+end
