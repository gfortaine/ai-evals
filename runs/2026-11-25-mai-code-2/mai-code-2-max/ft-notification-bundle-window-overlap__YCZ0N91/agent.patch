+require "test_helper"
+
+class Notification::PushTarget::EmailTest < ActiveSupport::TestCase
+  setup do
+    @notification = notifications(:logo_mentioned_david)
+    @settings = @notification.user.settings
+  end
+
+  test "adds notifications to email bundles when enabled" do
+    @settings.update!(bundle_email_frequency: :daily)
+
+    assert_difference -> { Notification::Bundle.count }, 1 do
+      Notification::PushTarget::Email.new(@notification).process
+    end
+
+    assert_equal @notification.bundle, @notification.user.notification_bundle
+  end
+
+  test "does not create email bundles when disabled" do
+    @settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      Notification::PushTarget::Email.new(@notification).process
+    end
+  end
+end
