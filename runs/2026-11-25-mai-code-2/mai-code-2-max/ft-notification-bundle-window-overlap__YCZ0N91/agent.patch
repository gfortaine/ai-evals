+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @notifications = @user.notifications.to_a
+  end
+
+  test "sends a digest to the user's email address" do
+    email = NotificationMailer.bundle(@user, @notifications.map(&:id))
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+  end
+
+  test "includes each bundled notification in HTML and text" do
+    email = NotificationMailer.bundle(@user, @notifications.map(&:id))
+
+    html = CGI.unescapeHTML(email.html_part.body.decoded)
+
+    @notifications.each do |notification|
+      assert_includes html, notification.payload.title
+      assert_includes email.text_part.body.decoded, notification.payload.title
+    end
+
+    assert_includes email.html_part.body.decoded, Rails.application.routes.url_helpers.notifications_settings_url(script_name: @user.account.slug, host: "example.com")
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..49044ce
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    @notifications = [
+      notifications(:logo_assignment_kevin),
+      notifications(:layout_commented_kevin)
+    ]
+  end
+
+  test "the first notification opens a window for the configured period" do
+    freeze_time do
+      bundle = assert_difference -> { Notification::Bundle.count }, 1 do
+        Notification::Bundle.add(@notifications.first)
+      end
+
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 4.hours.from_now, bundle.ends_at
+      assert_enqueued_with job: Notification::Bundle::DeliveryJob, at: bundle.ends_at
+    end
+  end
+
+  test "notifications for one user share the open window" do
+    first = Notification::Bundle.add(@notifications.first)
+    second = Notification::Bundle.add(@notifications.second)
+
+    assert_equal first, second
+    assert_equal @notifications.sort_by(&:id), first.notifications.order(:id).to_a.sort_by(&:id)
+  end
+
+  test "a notification that arrives after the window end joins the window already open" do
+    bundle = Notification::Bundle.add(@notifications.first)
+
+    travel 5.hours
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      assert_equal bundle, Notification::Bundle.add(@notifications.second)
+    end
+    assert_includes bundle.notifications, @notifications.second
+  end
+
+  test "different users have independent windows" do
+    other_user = users(:david)
+    other_user.settings.update!(bundle_email_frequency: :daily)
+
+    freeze_time do
+      first = Notification::Bundle.add(@notifications.first)
+      second = Notification::Bundle.add(notifications(:logo_mentioned_david))
+
+      assert_not_equal first, second
+      assert_equal 4.hours.from_now, first.ends_at
+      assert_equal 1.day.from_now, second.ends_at
+    end
+  end
+
+  test "delivery queues one email containing the whole window" do
+    bundle = Notification::Bundle.add(@notifications.first)
+    Notification::Bundle.add(@notifications.second)
+
+    travel_to bundle.ends_at, with_usec: true do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+          bundle.deliver
+        end
+      end
+    end
+
+    assert_not Notification::Bundle.exists?(bundle.id)
+    assert @notifications.all? { |notification| notification.reload.bundle_id.nil? }
+
+    email = ActionMailer::Base.deliveries.last
+    @notifications.each { |notification| assert_includes email.body.encoded, notification.payload.title }
+  end
+
+  test "a delivered window cannot be delivered twice" do
+    bundle = Notification::Bundle.add(@notifications.first)
+
+    travel_to bundle.ends_at, with_usec: true do
+      bundle.deliver
+      bundle.deliver
+    end
+
+    assert_enqueued_jobs 1, only: ActionMailer::MailDeliveryJob
+  end
+
+  test "the next window starts after the previous window closes" do
+    old_bundle = Notification::Bundle.add(@notifications.first)
+
+    travel_to old_bundle.ends_at, with_usec: true do
+      old_bundle.deliver
+      new_bundle = Notification::Bundle.add(@notifications.second)
+
+      assert_operator new_bundle.starts_at, :>=, old_bundle.ends_at
+      assert_not_equal old_bundle, new_bundle
+    end
+  end
+
+  test "turning off email suppresses the pending delivery" do
+    bundle = Notification::Bundle.add(@notifications.first)
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    travel_to bundle.ends_at, with_usec: true do
+      assert_no_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        bundle.deliver
+      end
+    end
+  end
+end
