diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..5cb61d0
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,94 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :notifications, dependent: :nullify
+
+  before_validation :set_window, on: :create
+
+  validates :ends_at, comparison: { greater_than: :starts_at }
+  validates :user_id, uniqueness: true
+
+  after_create_commit :deliver_later
+
+  class << self
+    def add(notification)
+      user = notification.user
+
+      user.with_lock do
+        if period = user.settings&.bundle_email_period
+          find_or_create_by!(user: user) do |bundle|
+            bundle.starts_at = Time.current
+            bundle.ends_at = bundle.starts_at + period
+          end.tap { |bundle| bundle.add(notification) }
+        end
+      end
+    end
+
+    alias_method :capture, :add
+    alias_method :open, :add
+  end
+
+  def add(notification)
+    unless notification.user_id == user_id && notification.account_id == account_id
+      raise ArgumentError, "Notification and bundle must belong to the same user and account"
+    end
+
+    notification.update_column(:bundle_id, id)
+    self
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver
+    user.with_lock do
+      if self.class.exists?(id)
+        reload
+
+        if due?
+          close
+        else
+          deliver_later
+        end
+      end
+    end
+  end
+
+  def due?
+    Time.current >= ends_at
+  end
+
+  def started_at
+    starts_at
+  end
+
+  def deliver_at
+    ends_at
+  end
+
+  private
+    def set_window
+      self.starts_at ||= Time.current
+
+      if ends_at.nil? && (period = user&.settings&.bundle_email_period)
+        self.ends_at = starts_at + period
+      end
+    end
+
+    def close
+      notification_ids = notifications.ids
+      email_enabled = email_enabled?
+
+      destroy!
+
+      if notification_ids.any? && email_enabled
+        NotificationMailer.bundle(user, notification_ids).deliver_later
+      end
+    end
+
+    def email_enabled?
+      user.active? && account.active? && user.identity.present? && user.settings&.bundle_email_period.present?
+    end
+end
