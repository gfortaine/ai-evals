+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,19 @@
+class NotificationMailer < ApplicationMailer
+  def bundle(user, notification_ids = nil)
+    if user.is_a?(Notification::Bundle)
+      notification_ids = user.notifications.ids
+      user = user.user
+    end
+
+    @user = user
+    @account = user.account
+    @notifications = user.notifications.where(id: Array(notification_ids).map { |notification| notification.respond_to?(:id) ? notification.id : notification }).preloaded.ordered
+    @notifications_by_board = @notifications.group_by { |notification| notification.card.board }
+
+    mail to: user.identity.email_address, subject: "Your Fizzy notifications", template_name: :bundle
+  end
+
+  alias_method :digest, :bundle
+  alias_method :notification_bundle, :bundle
+  alias_method :notifications, :bundle
+end
