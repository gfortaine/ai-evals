+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @settings = users(:david).settings
+  end
+
+  test "bundle email frequency defaults to never" do
+    assert_predicate @settings, :never?
+    assert_nil @settings.bundle_email_period
+  end
+
+  test "bundle email frequencies map to their periods" do
+    periods = {
+      every_few_hours: 4.hours,
+      daily: 1.day,
+      weekly: 1.week
+    }
+
+    periods.each do |frequency, period|
+      @settings.update!(bundle_email_frequency: frequency)
+
+      assert_equal period, @settings.bundle_email_period
+    end
+  end
+
+  test "bundle email frequency only accepts known values" do
+    assert_raises(ArgumentError) { @settings.bundle_email_frequency = "hourly" }
+  end
+end
