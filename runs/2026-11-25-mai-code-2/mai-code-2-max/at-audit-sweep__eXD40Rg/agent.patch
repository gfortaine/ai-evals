diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..eedaac6
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "search only returns pages from readable books" do
+    private_leaf = books(:manual).press Page.new(body: "Private content"), title: "Private Canary"
+
+    get library_search_path, params: { q: "Private Canary" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Welcome to The Handbook!/, count: 1
+    assert_not_in_body private_leaf.title
+  end
+
+  test "search includes published books when signed out" do
+    books(:manual).press Page.new(body: "Published content"), title: "Published Canary"
+    books(:manual).update!(published: true)
+    sign_out
+
+    get library_search_path, params: { q: "Published Canary" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Published Canary/, count: 1
+  end
+
+  test "search treats an apostrophe as data" do
+    leaves(:welcome_page).update!(title: "Reader's Guide")
+
+    get library_search_path, params: { q: "Reader's" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Reader's Guide/, count: 1
+  end
+
+  test "search query cannot inject SQL or bypass book access" do
+    books(:manual).press Page.new(body: "Private content"), title: "Private Canary"
+
+    get library_search_path, params: { q: "' OR 1=1 --" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_not_in_body "Private Canary"
+  end
+
+  test "search treats percent and underscore as literal characters" do
+    leaves(:welcome_page).update!(title: "Save 50% off")
+    leaves(:summary_page).update!(title: "Under_score guide")
+    leaves(:reading_picture).update!(title: "Underscore guide")
+
+    get library_search_path, params: { q: "Save 50% off" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Save 50% off/, count: 1
+
+    get library_search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_select "a.search__result", text: /Save 50% off/, count: 1
+
+    get library_search_path, params: { q: "_" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_select "a.search__result", text: /Under_score guide/, count: 1
+  end
+end
