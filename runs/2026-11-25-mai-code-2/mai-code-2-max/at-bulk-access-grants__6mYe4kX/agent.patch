diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..cd7eb9a
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup { clear_enqueued_jobs }
+
+  test "imports a roster with one database write" do
+    write_counts = [ 4, 16 ].map do |size|
+      book, users = roster(size)
+      book.accesses.load
+      result = nil
+
+      writes = capture_database_writes do
+        result = Book::AccessImport.new(book, grants_for(users)).import
+      end
+
+      assert_nil result.duplicate_index
+      assert_equal users.map(&:id), result.accesses.map(&:user_id)
+      assert_equal size, book.accesses.size
+      assert_equal size, result.accesses.count
+      writes.size
+    end
+
+    assert_equal [ 1, 1 ], write_counts
+  end
+
+  test "rejects a roster with one database write" do
+    write_counts = [ 4, 16 ].map do |size|
+      book, users = roster(size)
+      book.accesses.create!(user: users.last, level: :reader)
+      result = nil
+
+      writes = capture_database_writes do
+        result = Book::AccessImport.new(book, grants_for(users)).import
+      end
+
+      assert_equal size - 1, result.duplicate_index
+      assert_empty result.accesses
+      assert_equal [ users.last.id ], book.accesses.pluck(:user_id)
+      writes.size
+    end
+
+    assert_equal [ 1, 1 ], write_counts
+  end
+
+  test "does not notify for a rejected roster" do
+    book, users = roster(4)
+    grants = grants_for(users)
+    grants[2] = grants[1]
+
+    result = nil
+    assert_no_enqueued_jobs do
+      result = Book::AccessImport.new(book, grants).import
+    end
+
+    assert_equal 2, result.duplicate_index
+    assert_empty result.accesses
+    assert_empty book.accesses
+  end
+
+  test "notifies for every access in an imported roster" do
+    book, users = roster(4)
+
+    assert_enqueued_jobs users.size, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, grants_for(users)).import
+      assert_nil result.duplicate_index
+    end
+  end
+
+  test "rejects an unknown level as the bad row" do
+    book, users = roster(3)
+    grants = grants_for(users)
+    grants[1][:level] = :owner
+
+    result = nil
+    writes = capture_database_writes do
+      assert_no_enqueued_jobs do
+        result = Book::AccessImport.new(book, grants).import
+      end
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_empty writes
+    assert_empty book.accesses
+  end
+
+  private
+    def roster(size)
+      users = Array.new(size) do
+        User.create!(
+          name: "Import user #{SecureRandom.uuid}",
+          email_address: "import-#{SecureRandom.uuid}@example.com",
+          password_digest: "not-used"
+        )
+      end
+      [ Book.create!(title: "Import book #{SecureRandom.uuid}", everyone_access: false), users ]
+    end
+
+    def grants_for(users)
+      users.map.with_index do |user, index|
+        { user_id: user.id, level: index.even? ? :reader : :editor }
+      end
+    end
+
+    def capture_database_writes
+      writes = []
+      subscriber = lambda do |*, payload|
+        writes << payload[:sql] if payload[:sql].lstrip.match?(/\A(?:INSERT|UPDATE|DELETE) /i)
+      end
+
+      ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") { yield }
+      writes
+    end
+end
