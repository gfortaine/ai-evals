new file mode 100644
index 0000000..e568ecf
--- /dev/null
+++ b/app/javascript/helpers/localization_helpers.js
@@ -0,0 +1,19 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+export function currentLocale() {
+  return document.documentElement.lang || "en"
+}
+
+export function translate(key, interpolations = {}) {
+  let text = key.split(".").reduce((translations, part) => translations?.[part], translations())
+
+  for (const [ name, value ] of Object.entries(interpolations)) {
+    text = text.replaceAll(`%{${name}}`, value)
+  }
+
+  return text
+}
+
+function translations() {
+  return JSON.parse(getMetaContent("ui-translations") || "{}")
+}
