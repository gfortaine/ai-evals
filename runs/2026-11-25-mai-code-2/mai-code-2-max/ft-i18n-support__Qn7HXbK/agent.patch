diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..caf50ab
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "supported locale switches a page and is retained for the session" do
+    untenanted do
+      get new_session_path(locale: :ja)
+    end
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_includes response.body, "Fizzyにサインイン"
+    assert_equal :en, I18n.locale
+
+    untenanted do
+      get new_session_path
+    end
+
+    assert_select "html[lang=ja]"
+  end
+
+  test "unsupported locale leaves the current locale unchanged" do
+    untenanted do
+      get new_session_path(locale: :ja)
+      get new_session_path(locale: :xx)
+    end
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "locale choice is persisted on the signed-in identity" do
+    identity = identities(:kevin)
+    sign_in_as identity
+
+    get events_path(locale: :ja)
+
+    assert_equal "ja", identity.reload.locale
+    assert_select "html[lang=ja]"
+  end
+
+  test "identity locale is restored on a clean-browser sign in" do
+    identities(:kevin).update!(locale: :ja)
+
+    sign_in_as :kevin
+    cookies.delete(:session_token)
+    cookies.to_hash.each_key { |name| cookies.delete(name) }
+    get events_path
+    assert_response :redirect
+
+    sign_in_as :kevin
+    get events_path
+
+    assert_select "html[lang=ja]"
+  end
+
+  test "major screens render without missing Japanese translations" do
+    sign_in_as :kevin
+
+    paths = [
+      events_path(locale: :ja),
+      board_path(boards(:writebook), locale: :ja),
+      card_path(cards(:layout), locale: :ja),
+      account_settings_path(locale: :ja),
+      notifications_path(locale: :ja),
+      notifications_settings_path(locale: :ja),
+      user_path(users(:kevin), locale: :ja),
+      edit_user_path(users(:kevin), locale: :ja),
+      board_webhooks_path(boards(:writebook), locale: :ja),
+      search_path(q: "layout", locale: :ja)
+    ]
+
+    paths.each do |path|
+      get path
+      assert_response :success, path
+      assert_select "html[lang=ja]", count: 1, message: path
+      assert_no_match(/translation missing|translation_missing/, response.body, path)
+    end
+  end
+
+  test "locale participates in page cache validation" do
+    sign_in_as :kevin
+    get events_path
+    english_etag = response.headers["ETag"]
+
+    get notifications_settings_path(locale: :ja)
+    get events_path, headers: { "If-None-Match" => english_etag }
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+
+  test "the web app manifest uses the selected locale" do
+    sign_in_as :kevin
+
+    get pwa_manifest_path(format: :json, locale: :ja)
+
+    assert_response :success
+    assert_equal "通知", response.parsed_body.dig("shortcuts", 0, "name")
+
+    untenanted do
+      get pwa_manifest_path(format: :json, locale: :ja)
+    end
+    assert_response :success
+  end
+
+  test "public and unauthenticated screens support Japanese" do
+    boards(:writebook).publish
+
+    get "#{published_board_path(boards(:writebook))}?locale=ja"
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_no_match(/translation missing|translation_missing/, response.body)
+
+    untenanted do
+      get new_signup_path(locale: :ja)
+    end
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+end
diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
new file mode 100644
index 0000000..2367c02
--- /dev/null
+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class MailerLocalizationTest < ActionMailer::TestCase
+  setup do
+    @identity = identities(:kevin)
+    @identity.update!(locale: :ja)
+    @user = users(:kevin)
+  end
+
+  test "recipient locale is used for magic link subjects and email bodies" do
+    magic_link = MagicLink.create!(identity: @identity)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Fizzy確認コード：#{magic_link.code}", email.subject
+    assert_match "6文字の確認コード", email.html_part.body.to_s
+    assert_match "6文字の確認コード", email.text_part.body.to_s
+    assert_match %r{<html lang="ja">}, email.html_part.decoded
+  end
+
+  test "account, export, import, and email-change mail use recipient locale" do
+    cancellation = Account::Cancellation.create!(account: accounts(:"37s"), initiated_by: @user)
+    emails = [
+      AccountMailer.cancellation(cancellation),
+      ExportMailer.completed(Account::Export.create!(account: accounts(:"37s"), user: @user)),
+      ImportMailer.completed(@identity, accounts(:"37s")),
+      ImportMailer.failed(Account::Import.create!(account: accounts(:"37s"), identity: @identity, status: :failed)),
+      UserMailer.email_change_confirmation(email_address: "new@example.com", token: "token", user: @user)
+    ]
+
+    emails.each { |email| assert_japanese_email email }
+  end
+
+  test "notification bundle mail uses recipient locale and localized dates" do
+    @user.notifications.destroy_all
+    notification = Notification.create!(
+      user: @user,
+      creator: @user,
+      source: events(:logo_published),
+      created_at: 30.minutes.ago
+    )
+    bundle = Notification::Bundle.create!(user: @user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_japanese_email email
+    assert_match /\d{4}年\d{1,2}月\d{1,2}日/, email.html_part.decoded
+    assert notification.present?
+  end
+
+  private
+    def assert_japanese_email(email)
+      assert_match(/[ぁ-んァ-ヶ一-龠]/, email.subject)
+      assert_match(/[ぁ-んァ-ヶ一-龠]/, email.html_part&.decoded || email.decoded)
+      assert_match(/[ぁ-んァ-ヶ一-龠]/, email.text_part.decoded) if email.text_part
+      assert_no_match(/translation missing|translation_missing/, email.body.encoded)
+    end
+end
