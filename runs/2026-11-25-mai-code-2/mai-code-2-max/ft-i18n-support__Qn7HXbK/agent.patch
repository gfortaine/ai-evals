diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..d85fb3f
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,49 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :preserve_locale
+    before_action :use_locale_from_identity
+
+    etag { I18n.locale }
+  end
+
+  private
+    def preserve_locale
+      original_locale = I18n.locale
+      use_locale_from_request
+      yield
+    ensure
+      I18n.locale = original_locale
+    end
+
+    def use_locale_from_request
+      if locale = supported_locale(params[:locale])
+        session[:locale] = locale
+      end
+
+      I18n.locale = supported_locale(session[:locale]) || I18n.default_locale
+    end
+
+    def use_locale_from_identity
+      if Current.identity
+        if locale = supported_locale(session[:locale])
+          Current.identity.update!(locale: locale) if Current.identity.locale != locale
+        elsif locale = supported_locale(Current.identity.locale)
+          session[:locale] = locale
+          I18n.locale = locale
+        end
+      end
+    end
+
+    def remember_locale_for(identity)
+      if locale = supported_locale(session[:locale])
+        identity.update!(locale: locale) if identity.locale != locale
+      end
+    end
+
+    def supported_locale(value)
+      locale = value.to_s
+      locale if locale.present? && I18n.available_locales.include?(locale.to_sym)
+    end
+end
