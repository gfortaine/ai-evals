+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "email code includes the code in the subject and body" do
+    identity = identities(:david)
+    code = "ABC234"
+    email = IdentityMailer.email_code(identity, code)
+
+    assert_equal [ identity.email_address ], email.to
+    assert_includes email.subject, code
+    assert_includes email.html_part.body.to_s, code
+    assert_includes email.text_part.body.to_s, code
+    assert_includes email.body.encoded, "15 minutes"
+  end
+end
diff --git a/test/models/identity/email_code_test.rb b/test/models/identity/email_code_test.rb
new file mode 100644
index 0000000..ac1af11
--- /dev/null
+++ b/test/models/identity/email_code_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Identity::EmailCodeTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:david)
+  end
+
+  test "issues a six-character code that expires in fifteen minutes" do
+    email_code = Identity::EmailCode.issue_for(@identity)
+
+    assert_match /\A[0-9A-Z]{6}\z/, email_code.code
+    assert_in_delta 15.minutes.from_now, email_code.expires_at, 1.second
+    assert_not_includes email_code.code_digest, email_code.code
+  end
+
+  test "consumes a matching code without regard to case" do
+    email_code = Identity::EmailCode.issue_for(@identity)
+    code = email_code.code.downcase
+
+    assert_equal @identity, email_code.consume(code)
+    assert_not Identity::EmailCode.exists?(email_code.id)
+  end
+
+  test "keeps the challenge after an incorrect code" do
+    email_code = Identity::EmailCode.issue_for(@identity)
+
+    assert_nil email_code.consume("NOTIT")
+    assert Identity::EmailCode.exists?(email_code.id)
+  end
+
+  test "does not consume an expired code" do
+    email_code = Identity::EmailCode.issue_for(@identity)
+    code = email_code.code
+    email_code.update!(expires_at: 15.minutes.ago)
+
+    assert_nil email_code.consume(code)
+    assert_not Identity::EmailCode.exists?(email_code.id)
+  end
+
+  test "issuing a new code invalidates the previous code" do
+    previous_code = Identity::EmailCode.issue_for(@identity)
+    current_code = Identity::EmailCode.issue_for(@identity)
+
+    assert_not Identity::EmailCode.exists?(previous_code.id)
+    assert Identity::EmailCode.exists?(current_code.id)
+  end
+
+  test "finds a challenge by its pending authentication token" do
+    email_code = Identity::EmailCode.issue_for(@identity)
+
+    token = email_code.pending_authentication_token
+    assert_equal email_code, Identity::EmailCode.find_by_pending_authentication_token(token)
+  end
+end
