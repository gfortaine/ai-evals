diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..ed2e286
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,145 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  before_action :set_email_code_authentication
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    identity = @email_code.consume(params.expect(:code))
+
+    if identity
+      complete_email_code_authentication(identity)
+    elsif @email_code.destroyed?
+      email_code_expired
+    else
+      email_code_invalid
+    end
+  end
+
+  private
+    def set_email_code_authentication
+      session_authentication = pending_email_code_authentication
+      token = cookies[PENDING_AUTHENTICATION_TOKEN_COOKIE_KEY]
+
+      @email_code = if token.present?
+        Identity::EmailCode.find_by_pending_authentication_token(token)
+      else
+        Identity::EmailCode.find_by(id: session_authentication&.dig(:email_code_id))
+      end
+
+      @pending_email_code_authentication = if @email_code
+        {
+          purpose: @email_code.purpose,
+          join_code_id: @email_code.join_code_id
+        }.with_indifferent_access
+      else
+        session_authentication
+      end
+
+      if @email_code&.expired?
+        @email_code.destroy!
+        email_code_expired
+      elsif @email_code.nil?
+        email_code_unavailable
+      else
+        @email_address = @email_code.identity.email_address
+        @retry_path = retry_path
+      end
+    end
+
+    def complete_email_code_authentication(identity)
+      pending_authentication = @pending_email_code_authentication
+      clear_pending_email_code_authentication
+
+      terminate_session if Current.session
+      start_new_session_for identity
+
+      if destination = destination_after_email_code_authentication(identity, pending_authentication)
+        respond_to do |format|
+          format.html { redirect_to destination }
+          format.json do
+            payload = { session_token: session_token }
+            payload[:redirect_to] = destination unless pending_authentication[:purpose] == "sign_in"
+            render json: payload
+          end
+        end
+      else
+        email_code_unavailable
+      end
+    end
+
+    def destination_after_email_code_authentication(identity, pending_authentication)
+      case pending_authentication[:purpose]
+      when "sign_in"
+        after_authentication_url
+      when "sign_up"
+        new_signup_completion_url(script_name: nil)
+      when "join"
+        destination_after_joining(identity, pending_authentication[:join_code_id])
+      end
+    end
+
+    def destination_after_joining(identity, join_code_id)
+      if (join_code = Account::JoinCode.find_by(id: join_code_id)) && join_code.active?
+        url_after_joining(identity, join_code)
+      else
+        main_app.new_session_url(script_name: nil)
+      end
+    end
+
+    def retry_path
+      case @pending_email_code_authentication[:purpose]
+      when "sign_up"
+        main_app.new_signup_path(script_name: nil)
+      when "join"
+        join_code = Account::JoinCode.find_by(id: @pending_email_code_authentication[:join_code_id])
+        main_app.join_path(code: join_code.code, script_name: join_code.account.slug) if join_code
+      else
+        main_app.new_session_path(script_name: nil)
+      end
+    end
+
+    def email_code_invalid
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil), alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def email_code_expired
+      clear_pending_email_code_authentication
+      message = "That code has expired. Enter your email again to get a new one."
+
+      respond_to do |format|
+        format.html { redirect_to retry_path || new_session_path(script_name: nil), alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def email_code_unavailable
+      clear_pending_email_code_authentication
+      message = "Enter your email again to get a new code."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path(script_name: nil), alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil), alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
