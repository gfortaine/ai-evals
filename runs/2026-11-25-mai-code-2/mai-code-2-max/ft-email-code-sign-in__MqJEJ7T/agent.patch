@@ -0,0 +1,28 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, inputmode: "text", maxlength: 6, pattern: "[A-Za-z0-9]{6}", placeholder: "Six-character code", required: true %>
+      </label>
+    </div>
+
+    <p>Enter the six-character code we sent to <strong><%= @email_address %></strong>. It works for 15 minutes.</p>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <% if @retry_path %>
+    <p class="txt-small"><%= link_to "Use a different email address", @retry_path, class: "txt-link" %></p>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
