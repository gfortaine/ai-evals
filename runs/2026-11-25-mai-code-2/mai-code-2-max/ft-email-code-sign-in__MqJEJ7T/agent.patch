diff --git a/app/models/identity/email_code.rb b/app/models/identity/email_code.rb
new file mode 100644
index 0000000..58ced7f
--- /dev/null
+++ b/app/models/identity/email_code.rb
@@ -0,0 +1,73 @@
+class Identity::EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  TOKEN_PURPOSE = :email_code
+
+  belongs_to :identity
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  validates :code_digest, :expires_at, :purpose, presence: true
+
+  before_validation :generate_code, on: :create, if: -> { code.blank? }
+  before_validation :set_expiration, on: :create, if: -> { expires_at.blank? }
+
+  attr_reader :code
+
+  class << self
+    def issue_for(identity, purpose: :sign_in, join_code: nil)
+      identity.with_lock do
+        where(identity: identity).delete_all
+        create!(identity: identity, purpose: purpose, join_code: join_code)
+      end
+    end
+
+    def find_by_pending_authentication_token(token)
+      find_signed(token, purpose: TOKEN_PURPOSE)
+    end
+  end
+
+  def code=(value)
+    @code = normalize_code(value)
+    self.code_digest = BCrypt::Password.create(@code)
+  end
+
+  def consume(code)
+    with_lock do
+      if expired?
+        destroy!
+        nil
+      elsif authenticated?(code)
+        identity.tap { destroy! }
+      end
+    end
+  end
+
+  def deliver_later
+    IdentityMailer.email_code(identity, code).deliver_later
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  def pending_authentication_token
+    signed_id(purpose: TOKEN_PURPOSE, expires_in: EXPIRATION)
+  end
+
+  private
+    def authenticated?(code)
+      BCrypt::Password.new(code_digest) == normalize_code(code)
+    end
+
+    def generate_code
+      self.code = SecureRandom.base58(CODE_LENGTH)
+    end
+
+    def normalize_code(value)
+      value.to_s.strip.upcase
+    end
+
+    def set_expiration
+      self.expires_at = EXPIRATION.from_now
+    end
+end
