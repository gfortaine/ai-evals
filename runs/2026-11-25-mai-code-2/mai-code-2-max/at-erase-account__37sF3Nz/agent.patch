diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..30365b8 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,44 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "destroying a user erases their data and private authored books" do
+    user = users(:kevin)
+    user_id = user.id
+    email_address = user.email_address
+    session = user.sessions.create!
+    reading_mark = ReadingMark.create!(user: user, leaf: leaves(:welcome_page), last_read_at: Time.current)
+
+    private_book = Book.create!(title: "Private erasure book", author: user.name, creator: user, everyone_access: false)
+    private_leaf = private_book.press(Page.new(body: "private-erasure-needle"), title: "Private erasure page")
+    private_leaf.edit leafable_params: { body: "updated-private-erasure-needle" }
+    private_leaf.trashed!
+    private_page_ids = [ private_leaf.leafable_id, *private_leaf.edits.pluck(:leafable_id) ].uniq
+    private_markdown_ids = ActionText::Markdown.where(record: Page.where(id: private_page_ids)).ids
+
+    shared_book = Book.create!(title: "Shared erasure book", author: user.name, creator: user, everyone_access: true)
+
+    assert Leaf.search("updated-private-erasure-needle").exists?(id: private_leaf.id)
+
+    user.destroy!
+
+    assert_not User.exists?(user_id)
+    assert_not Session.exists?(session.id)
+    assert_not Access.where(user_id: user_id).exists?
+    assert_not ReadingMark.exists?(reading_mark.id)
+    assert_not SignInEvent.where(email_address: email_address).exists?
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(private_leaf.id)
+    assert_not Page.exists?(id: private_page_ids)
+    assert_not ActionText::Markdown.where(id: private_markdown_ids).exists?
+    assert_not Edit.where(leaf_id: private_leaf.id).exists?
+    assert_not Leaf.search("updated-private-erasure-needle").exists?
+    assert_equal 0, Leaf.connection.select_value(
+      Leaf.sanitize_sql([ "select count(*) from leaf_search_index where rowid = ?", private_leaf.id ])
+    )
+
+    assert Book.exists?(shared_book.id)
+    assert_nil shared_book.reload.creator_id
+    assert_equal "Deleted author", shared_book.author
+  end
 end
