+  def draw_winners!
+    eligible = leaderboard.reject { |player| player.points.zero? }
+    winner_ids = if eligible.length <= number_of_winners
+      eligible.map(&:id)
+    else
+      cutoff_points = eligible.fetch(number_of_winners - 1).points
+      guaranteed = eligible.select { |player| player.points > cutoff_points }
+      tied = eligible.select { |player| player.points == cutoff_points }
+      guaranteed.map(&:id) + tied.sample(number_of_winners - guaranteed.length).map(&:id)
+    end
+
+    replace_winners!(winner_ids)
+  end
