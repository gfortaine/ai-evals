diff --git a/test/models/game_test.rb b/test/models/game_test.rb
index e183b31..e846efb 100644
--- a/test/models/game_test.rb
+++ b/test/models/game_test.rb
@@ -81,6 +81,87 @@ class GameTest < ActiveSupport::TestCase
     end
   end
 
+test "ranks equal scores by the total time of the final correct picks" do
+  quiz = Quiz.create!(title: "Speed")
+  create_question(quiz, "Fastest?", 1)
+  game = Game.create_for!(quiz)
+  alice = join_player(game, "Alice")
+  bob = join_player(game, "Bob")
+  charlie = join_player(game, "Charlie")
+  opened_at = Time.zone.parse("2026-11-22 20:00:00")
+
+  travel_to(opened_at) { game.start! }
+  question = game.current_question
+  correct = question.game_options.first
+  wrong = question.game_options.second
+  assert_equal opened_at, question.reload.opened_at
+
+  travel_to(opened_at + 1.second) { game.submit_answer!(player: alice, option_id: correct.id) }
+  travel_to(opened_at + 2.seconds) do
+    game.submit_answer!(player: bob, option_id: correct.id)
+    game.submit_answer!(player: charlie, option_id: wrong.id)
+  end
+  travel_to(opened_at + 5.seconds) { game.submit_answer!(player: alice, option_id: correct.id) }
+
+  game.finish_question!
+  game.advance!
+  leaderboard = game.leaderboard
+
+  assert_equal %w[Bob Alice Charlie], leaderboard.map(&:name)
+  assert_equal [ 1, 1, 0 ], leaderboard.map(&:points)
+  assert_in_delta 2.seconds, leaderboard.first.total_correct_answer_time
+  assert_in_delta 5.seconds, leaderboard.second.total_correct_answer_time
+end
+
+test "selects top winners and draws only among players tied at the cutoff score" do
+  quiz = Quiz.create!(title: "Prizes", number_of_winners: 2)
+  3.times { |index| create_question(quiz, "Question #{index + 1}?", index + 1) }
+  game = Game.create_for!(quiz)
+  players = %w[Leader TiedOne TiedTwo RunnerUp Zero].map { |name| join_player(game, name) }
+  point_targets = [ 3, 2, 2, 1, 0 ]
+
+  3.times do |question_index|
+    if question_index.zero?
+      game.start!
+    end
+
+    question = game.current_question
+    players.zip(point_targets).each do |player, points|
+      option = question_index < points ? question.game_options.first : question.game_options.second
+      game.submit_answer!(player: player, option_id: option.id)
+    end
+    game.finish_question!
+    game.advance!
+  end
+
+  assert_predicate game, :finished?
+  game.select_top_winners!
+  assert_equal %w[Leader TiedOne], game.players.where(winner: true).order(:id).pluck(:name)
+
+  game.draw_winners!
+  drawn_names = game.players.where(winner: true).order(:id).pluck(:name)
+  assert_equal 2, drawn_names.length
+  assert_includes drawn_names, "Leader"
+  assert_equal 1, (%w[TiedOne TiedTwo] & drawn_names).length
+  refute_includes drawn_names, "RunnerUp"
+  refute_includes drawn_names, "Zero"
+
+  game.reset_winners!
+  assert_empty game.players.where(winner: true)
+
+  game.update!(number_of_winners: 5)
+  game.draw_winners!
+  assert_equal %w[Leader TiedOne TiedTwo RunnerUp], game.players.where(winner: true).order(:id).pluck(:name)
+end
+
+test "winner actions are unavailable before the quiz ends" do
+  game = create_game_with_two_questions
+
+  assert_raises(Game::InvalidTransition) { game.select_top_winners! }
+  assert_raises(Game::InvalidTransition) { game.draw_winners! }
+  assert_raises(Game::InvalidTransition) { game.reset_winners! }
+end
+
   private
 
   def create_game_with_two_questions
