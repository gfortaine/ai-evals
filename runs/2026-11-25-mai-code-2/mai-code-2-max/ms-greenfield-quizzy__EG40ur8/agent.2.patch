+<% content_for :title, "Import quiz · Quizzy" %>
+
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<div class="page-head">
+  <div>
+    <h1>Import quiz</h1>
+    <p class="meta">Paste Quizzy JSON to create a new quiz.</p>
+  </div>
+</div>
+
+<div class="card">
+  <%= form_with url: moderate_quiz_import_path, method: :post, class: "quiz-import-form" do |form| %>
+    <% if @import_errors.present? %>
+      <div class="errors" role="alert">
+        <ul>
+          <% @import_errors.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <div class="field">
+      <%= form.label :quiz_json, "Quiz JSON" %>
+      <%= form.text_area :quiz_json, value: @quiz_json, class: "input input--code", rows: 18,
+            autofocus: true, spellcheck: false %>
+    </div>
+
+    <div class="buttons">
+      <%= form.button "Import", type: "submit", class: "btn btn--pink" %>
+      <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+    </div>
+  <% end %>
+</div>
