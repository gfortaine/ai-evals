+++ b/app/services/quiz_export.rb
@@ -0,0 +1,29 @@
+class QuizExport
+  def initialize(quiz)
+    @quiz = quiz
+  end
+
+  def to_json
+    JSON.pretty_generate(as_hash)
+  end
+
+  private
+
+  def as_hash
+    {
+      "title" => @quiz.title,
+      "questions" => @quiz.questions.includes(:options).map do |question|
+        {
+          "text" => question.text,
+          "active" => question.active?,
+          "options" => question.options.map do |option|
+            {
+              "text" => option.text,
+              "correct" => option.correct?
+            }
+          end
+        }
+      end
+    }
+  end
+end
diff --git a/app/services/quiz_import.rb b/app/services/quiz_import.rb
new file mode 100644
index 0000000..29ebfde
--- /dev/null
+++ b/app/services/quiz_import.rb
@@ -0,0 +1,115 @@
+class QuizImport
+  class Invalid < StandardError; end
+
+  ROOT_KEYS = %w[title questions].freeze
+  QUESTION_KEYS = %w[text active options].freeze
+  OPTION_KEYS = %w[text correct].freeze
+
+  def initialize(json)
+    @json = json.to_s
+  end
+
+  def call
+    contents = parse
+
+    Quiz.transaction do
+      quiz = Quiz.create!(title: contents[:title])
+
+      contents[:questions].each_with_index do |attributes, index|
+        question = quiz.questions.build(
+          text: attributes[:text],
+          active: attributes[:active],
+          position: index + 1
+        )
+
+        attributes[:options].filter_map.with_index(1) do |option, position|
+          next if option[:text].blank?
+
+          question.options.build(
+            text: option[:text].strip,
+            correct: option[:correct],
+            position: position
+          )
+        end
+
+        question.save!
+      end
+
+      quiz
+    end
+  end
+
+  private
+
+  def parse
+    data = JSON.parse(@json)
+    object = object!(data, "Quiz JSON")
+    check_keys!(object, allowed: ROOT_KEYS, required: ROOT_KEYS, location: "Quiz JSON")
+
+    questions = array!(object["questions"], "questions")
+    {
+      title: string!(object["title"], "title"),
+      questions: questions.map.with_index(1) { |question, index| parse_question(question, index) }
+    }
+  rescue JSON::ParserError => error
+    raise Invalid, "Quiz JSON is invalid: #{error.message}"
+  end
+
+  def parse_question(value, index)
+    location = "Question #{index}"
+    question = object!(value, location)
+    check_keys!(question, allowed: QUESTION_KEYS, required: %w[text options], location: location)
+
+    {
+      text: string!(question["text"], "#{location} text"),
+      active: optional_boolean!(question, "active", true, location),
+      options: array!(question["options"], "#{location} options").map.with_index(1) do |option, option_index|
+        parse_option(option, index, option_index)
+      end
+    }
+  end
+
+  def parse_option(value, question_index, option_index)
+    location = "Question #{question_index}, option #{option_index}"
+    option = object!(value, location)
+    check_keys!(option, allowed: OPTION_KEYS, required: %w[text], location: location)
+
+    {
+      text: string!(option["text"], "#{location} text"),
+      correct: optional_boolean!(option, "correct", false, location)
+    }
+  end
+
+  def check_keys!(object, allowed:, required:, location:)
+    unknown = object.keys - allowed
+    raise Invalid, "#{location} has unsupported keys: #{unknown.map(&:inspect).join(', ')}" if unknown.any?
+
+    missing = required - object.keys
+    raise Invalid, "#{location} is missing keys: #{missing.map(&:inspect).join(', ')}" if missing.any?
+  end
+
+  def object!(value, location)
+    return value if value.is_a?(Hash)
+
+    raise Invalid, "#{location} must be a JSON object"
+  end
+
+  def array!(value, location)
+    return value if value.is_a?(Array)
+
+    raise Invalid, "#{location} must be an array"
+  end
+
+  def string!(value, location)
+    return value if value.is_a?(String)
+
+    raise Invalid, "#{location} must be a string"
+  end
+
+  def optional_boolean!(object, key, default, location)
+    return default unless object.key?(key)
+    return object[key] if object[key] == true || object[key] == false
+
+    raise Invalid, "#{location} #{key} must be true or false"
+  end
+end
