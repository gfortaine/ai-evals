@@ -0,0 +1,20 @@
+module Moderate
+  class QuizImportsController < ApplicationController
+    def new
+      @quiz_json = ""
+    end
+
+    def create
+      @quiz_json = params[:quiz_json].to_s
+      quiz = QuizImport.new(@quiz_json).call
+
+      redirect_to moderate_quiz_path(quiz), notice: "Quiz imported"
+    rescue QuizImport::Invalid => error
+      @import_errors = [ error.message ]
+      render :new, status: :unprocessable_entity
+    rescue ActiveRecord::RecordInvalid => error
+      @import_errors = error.record.errors.full_messages.presence || [ error.message ]
+      render :new, status: :unprocessable_entity
+    end
+  end
+end
