diff --git a/test/integration/quiz_transfer_test.rb b/test/integration/quiz_transfer_test.rb
new file mode 100644
index 0000000..71a6487
--- /dev/null
+++ b/test/integration/quiz_transfer_test.rb
@@ -0,0 +1,164 @@
+require "test_helper"
+
+class QuizTransferTest < ActionDispatch::IntegrationTest
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "conference-secret"
+    @authorization = ActionController::HttpAuthentication::Basic.encode_credentials(
+      ENV["QUIZZY_MODERATOR_USERNAME"], ENV["QUIZZY_MODERATOR_PASSWORD"]
+    )
+  end
+
+  test "shows export and import controls with the required labels" do
+    quiz = Quiz.create!(title: "Controls")
+
+    get moderate_root_path, headers: auth_headers
+    assert_response :success
+    assert_select "button", text: "Import quiz", exact_text: true
+
+    get moderate_quiz_path(quiz), headers: auth_headers
+    assert_response :success
+    assert_select "a", text: "Export", exact_text: true
+
+    get moderate_quiz_import_path, headers: auth_headers
+    assert_response :success
+    assert_select "label[for=quiz_json]", text: "Quiz JSON", exact_text: true
+    assert_select "textarea#quiz_json"
+    assert_select "button", text: "Import", exact_text: true
+  end
+
+  test "exports only quiz contents in question and option order" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+    first = create_question(quiz, "First?", 1, active: false)
+    second = create_question(quiz, "Second?", 2)
+    first.options.first.update!(correct: false)
+    first.options.last.update!(correct: true)
+
+    get export_moderate_quiz_path(quiz), headers: auth_headers
+
+    assert_response :success
+    pre = css_select("pre")
+    assert_equal 1, pre.length
+    assert_equal(
+      {
+        "title" => "Frontend Fest 2026",
+        "questions" => [
+          {
+            "text" => "First?",
+            "active" => false,
+            "options" => [
+              { "text" => "Right answer", "correct" => false },
+              { "text" => "Other answer", "correct" => true }
+            ]
+          },
+          {
+            "text" => "Second?",
+            "active" => true,
+            "options" => [
+              { "text" => "Right answer", "correct" => true },
+              { "text" => "Other answer", "correct" => false }
+            ]
+          }
+        ]
+      },
+      JSON.parse(pre.first.text)
+    )
+    assert_equal second, quiz.questions.last
+  end
+
+  test "imports as a new quiz and defaults optional booleans" do
+    Quiz.create!(title: "Reusable")
+    contents = {
+      title: "Reusable",
+      questions: [
+        {
+          text: "Default values?",
+          options: [
+            { text: "Wrong by default" },
+            { text: "Right", correct: true }
+          ]
+        },
+        {
+          text: "Still ordered?",
+          active: false,
+          options: [
+            { text: "First" },
+            { text: "Second", correct: true }
+          ]
+        }
+      ]
+    }
+
+    assert_difference "Quiz.count", 1 do
+      post moderate_quiz_import_path,
+        params: { quiz_json: JSON.generate(contents) },
+        headers: auth_headers
+    end
+
+    imported = Quiz.order(:id).last
+    assert_redirected_to moderate_quiz_path(imported)
+    assert_equal "Reusable", imported.title
+    assert_equal [ "Default values?", "Still ordered?" ], imported.questions.map(&:text)
+    assert_equal [ true, false ], imported.questions.map(&:active?)
+    assert_equal [ "Wrong by default", "Right" ], imported.questions.first.options.map(&:text)
+    assert_equal [ false, true ], imported.questions.first.options.map(&:correct?)
+  end
+
+  test "invalid JSON imports nothing and retains the submitted JSON" do
+    invalid_json = '{"title": "Broken"'
+
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      post moderate_quiz_import_path,
+        params: { quiz_json: invalid_json },
+        headers: auth_headers
+    end
+
+    assert_response :unprocessable_entity
+    assert_select ".errors", /Quiz JSON is invalid/
+    assert_select "textarea#quiz_json", text: invalid_json
+  end
+
+  test "a rule violation rolls back the whole quiz" do
+    contents = {
+      title: "Atomic",
+      questions: [
+        {
+          text: "Valid first",
+          options: [
+            { text: "First", correct: true },
+            { text: "Second" }
+          ]
+        },
+        {
+          text: "Invalid second",
+          options: [
+            { text: "Only option", correct: true }
+          ]
+        }
+      ]
+    }
+
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      post moderate_quiz_import_path,
+        params: { quiz_json: JSON.generate(contents) },
+        headers: auth_headers
+    end
+
+    assert_response :unprocessable_entity
+    assert_select ".errors", /Add at least two options/
+  end
+
+  private
+
+  def auth_headers
+    { "HTTP_AUTHORIZATION" => @authorization }
+  end
+
+  def create_question(quiz, text, position, active: true)
+    question = quiz.questions.build(text: text, position: position, active: active)
+    question.options.build(text: "Right answer", correct: true, position: 1)
+    question.options.build(text: "Other answer", correct: false, position: 2)
+    question.save!
+    question
+  end
+end
