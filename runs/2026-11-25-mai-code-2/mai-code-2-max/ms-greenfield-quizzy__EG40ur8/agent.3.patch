diff --git a/test/integration/live_game_flow_test.rb b/test/integration/live_game_flow_test.rb
new file mode 100644
index 0000000..4151cf3
--- /dev/null
+++ b/test/integration/live_game_flow_test.rb
@@ -0,0 +1,137 @@
+require "test_helper"
+
+class LiveGameFlowTest < ActionDispatch::IntegrationTest
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "conference-secret"
+    @authorization = ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "conference-secret")
+    @quiz = Quiz.create!(title: "Conference quiz")
+    create_question(@quiz, "Choose the right answer", 1)
+    inactive = create_question(@quiz, "This is skipped", 2)
+    inactive.update!(active: false)
+    create_question(@quiz, "Last question", 3)
+  end
+
+  test "moderator and remembered player complete a live game" do
+    post moderate_quiz_games_path(@quiz), headers: auth_headers
+    assert_response :redirect
+    game = @quiz.games.order(:id).last
+    assert_redirected_to moderate_quiz_game_path(@quiz, game)
+
+    get moderate_quiz_game_path(@quiz, game), headers: auth_headers
+    assert_response :success
+    assert_select ".lobby__title", text: "Conference quiz"
+    assert_select ".lobby__url", text: %r{http://www\.example\.com/play/#{game.join_code}}
+    assert_select ".qr svg"
+    assert_select ".counter-pill", text: "Players: 0"
+    assert_select "button", text: "Start"
+
+    alice = open_session
+    alice.get play_game_path(game.join_code)
+    alice.assert_response :success
+    alice.assert_select "label", text: "Your name"
+    alice.assert_select "input[placeholder='Your name']"
+    alice.assert_select "button", text: "Join"
+
+    alice.post join_play_game_path(game.join_code), params: { player: { name: "Alice" } }
+    alice.assert_response :redirect
+    alice.follow_redirect!
+    alice.assert_select ".play-title", text: "Hi, Alice!"
+    assert_equal 1, game.players.count
+
+    alice.get play_game_path(game.join_code)
+    alice.assert_select ".play-title", text: "Hi, Alice!"
+    assert_equal 1, game.players.count
+
+    get moderate_quiz_game_path(@quiz, game), headers: auth_headers
+    assert_select ".counter-pill", text: "Players: 1"
+
+    patch start_moderate_quiz_game_path(@quiz, game), headers: auth_headers
+    assert_redirected_to moderate_quiz_game_path(@quiz, game)
+
+    alice.get play_game_path(game.join_code)
+    alice.assert_select ".play-question__num", text: "Question 1 of 2"
+    alice.assert_select ".play-question__body", text: "Choose the right answer"
+    alice.assert_select "button", text: /Right answer/
+    alice.assert_no_match(/is-correct|Correct!|Wrong!|No answer/, alice.response.body)
+
+    question = game.reload.current_question
+    alice.post answer_play_game_path(game.join_code), params: { option_id: question.game_options.second.id }
+    alice.follow_redirect!
+    alice.assert_select ".play-option.is-picked .play-option__mark", text: "Your answer"
+
+    get moderate_quiz_game_path(@quiz, game), headers: auth_headers
+    assert_select ".answers-counter", text: "Answers: 1 / 1"
+
+    alice.post answer_play_game_path(game.join_code), params: { option_id: question.game_options.first.id }
+    alice.follow_redirect!
+    assert_equal question.game_options.first, question.answer_for(game.players.first).game_option
+
+    patch finish_moderate_quiz_game_path(@quiz, game), headers: auth_headers
+    alice.get play_game_path(game.join_code)
+    alice.assert_select ".play-status", text: "Correct!"
+
+    get moderate_quiz_game_path(@quiz, game), headers: auth_headers
+    assert_select ".stage-option.is-correct .stage-option__mark", text: "Correct"
+    assert_select ".stage-option__count", count: 2
+    assert_select "button", text: "Next"
+
+    patch next_moderate_quiz_game_path(@quiz, game), headers: auth_headers
+    alice.get play_game_path(game.join_code)
+    alice.assert_select ".play-question__num", text: "Question 2 of 2"
+    assert_not_includes alice.response.body, "This is skipped"
+
+    patch finish_moderate_quiz_game_path(@quiz, game), headers: auth_headers
+    alice.get play_game_path(game.join_code)
+    alice.assert_select ".play-status", text: "No answer"
+
+    get moderate_quiz_game_path(@quiz, game), headers: auth_headers
+    assert_select "button", text: "End quiz"
+    patch next_moderate_quiz_game_path(@quiz, game), headers: auth_headers
+
+    alice.get play_game_path(game.join_code)
+    alice.assert_select ".play-title", text: "The quiz is over"
+    alice.assert_select "input[name='player[name]']", count: 0
+
+    newcomer = open_session
+    newcomer.get play_game_path(game.join_code)
+    newcomer.assert_select ".play-title", text: "The quiz is over"
+    newcomer.assert_select "form", count: 0
+    newcomer.post join_play_game_path(game.join_code), params: { player: { name: "Too late" } }
+    newcomer.assert_response :redirect
+    assert_equal 1, game.players.count
+  end
+
+  test "requires moderator credentials for every game action" do
+    game = Game.create_for!(@quiz)
+    routes = [
+      moderate_quiz_game_path(@quiz, game),
+      [ :patch, start_moderate_quiz_game_path(@quiz, game) ],
+      [ :patch, finish_moderate_quiz_game_path(@quiz, game) ],
+      [ :patch, next_moderate_quiz_game_path(@quiz, game) ]
+    ]
+
+    routes.each do |route|
+      if route.is_a?(Array)
+        public_send(route.first, route.last)
+      else
+        get route
+      end
+      assert_response :unauthorized
+    end
+  end
+
+  private
+
+  def auth_headers
+    { "HTTP_AUTHORIZATION" => @authorization }
+  end
+
+  def create_question(quiz, text, position)
+    question = quiz.questions.build(text: text, active: true, position: position)
+    question.options.build(text: "Right answer", correct: true, position: 1)
+    question.options.build(text: "Wrong answer", position: 2)
+    question.save!
+    question
+  end
+end
diff --git a/test/models/game_test.rb b/test/models/game_test.rb
new file mode 100644
index 0000000..e183b31
--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+require "digest"
+
+class GameTest < ActiveSupport::TestCase
+  test "creates independent snapshots and skips inactive questions" do
+    quiz = Quiz.create!(title: "Original title")
+    first = create_question(quiz, "First?", 1, active: true)
+    create_question(quiz, "Skipped?", 2, active: false)
+    second = create_question(quiz, "Second?", 3, active: true)
+
+    first_game = Game.create_for!(quiz)
+    second_game = Game.create_for!(quiz)
+
+    assert_equal %w[First? Second?], first_game.game_questions.map(&:text)
+    assert_not_equal first_game.join_code, second_game.join_code
+
+    quiz.update!(title: "Changed title")
+    first.update!(text: "Edited first question")
+    second.options.first.update!(correct: false)
+
+    assert_equal "Original title", first_game.quiz_title
+    assert_equal "First?", first_game.game_questions.first.text
+    assert first_game.game_questions.second.game_options.first.correct?
+  end
+
+  test "runs questions and keeps only the latest answer" do
+    game = create_game_with_two_questions
+    player = join_player(game, "Alice")
+
+    game.start!
+    question = game.current_question
+    wrong = question.game_options.second
+    right = question.game_options.first
+
+    game.submit_answer!(player: player, option_id: wrong.id)
+    game.submit_answer!(player: player, option_id: right.id)
+
+    assert_equal 1, player.answers.where(game_question: question).count
+    assert_equal right, question.answer_for(player).game_option
+
+    game.finish_question!
+    assert_raises(Game::InvalidTransition) do
+      game.submit_answer!(player: player, option_id: wrong.id)
+    end
+
+    game.advance!
+    assert_equal 2, game.current_question_position
+    assert_predicate game, :question_open?
+
+    game.finish_question!
+    game.advance!
+    assert_predicate game, :finished?
+    assert game.finished_at
+  end
+
+  test "allows players to join until the game ends but not after" do
+    game = create_game_with_two_questions
+    first_player = join_player(game, "Early")
+
+    game.start!
+    late_player = join_player(game, "Late")
+
+    assert_equal [ first_player, late_player ].sort_by(&:id), game.players.order(:id).to_a
+
+    game.finish_question!
+    game.advance!
+    game.finish_question!
+    game.advance!
+
+    assert_raises(Game::Finished) do
+      join_player(game, "Too late")
+    end
+  end
+
+  test "rejects a game with no active questions" do
+    quiz = Quiz.create!(title: "Empty")
+    create_question(quiz, "Inactive?", 1, active: false)
+
+    assert_no_difference("Game.count") do
+      assert_raises(Game::NoActiveQuestions) { Game.create_for!(quiz) }
+    end
+  end
+
+  private
+
+  def create_game_with_two_questions
+    quiz = Quiz.create!(title: "Live quiz")
+    create_question(quiz, "First?", 1)
+    create_question(quiz, "Second?", 2)
+    Game.create_for!(quiz)
+  end
+
+  def join_player(game, name)
+    game.join_player!(name: name, token_digest: Digest::SHA256.hexdigest("#{name}-token"))
+  end
+
+  def create_question(quiz, text, position, active: true)
+    question = quiz.questions.build(text: text, position: position, active: active)
+    question.options.build(text: "Right", correct: true, position: 1)
+    question.options.build(text: "Wrong", position: 2)
+    question.save!
+    question
+  end
+end
