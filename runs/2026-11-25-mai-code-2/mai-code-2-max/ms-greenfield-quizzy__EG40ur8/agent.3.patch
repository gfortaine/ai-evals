+class Answer < ApplicationRecord
+  belongs_to :player
+  belongs_to :game_question
+  belongs_to :game_option
+
+  validates :player_id, uniqueness: { scope: :game_question_id }
+  validates :answered_at, presence: true
+  validate :option_matches_question
+  validate :player_matches_game
+
+  after_create_commit -> { game_question.game.broadcast_moderator_state }
+
+  def correct?
+    game_option.correct?
+  end
+
+  private
+
+  def option_matches_question
+    return if game_option_id.blank? || game_question_id.blank?
+    return if game_option&.game_question_id == game_question_id
+
+    errors.add(:game_option, "does not belong to this question")
+  end
+
+  def player_matches_game
+    return if player_id.blank? || game_question_id.blank?
+    return if player&.game_id == game_question&.game_id
+
+    errors.add(:player, "does not belong to this game")
+  end
+end
diff --git a/app/models/game.rb b/app/models/game.rb
new file mode 100644
index 0000000..679f973
--- /dev/null
+++ b/app/models/game.rb
@@ -0,0 +1,149 @@
+class Game < ApplicationRecord
+  JOIN_CODE_CHARACTERS = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789".freeze
+
+  class InvalidTransition < StandardError; end
+  class NoActiveQuestions < StandardError; end
+  class Finished < StandardError; end
+
+  belongs_to :quiz
+  has_many :game_questions, -> { order(:position, :id) }, dependent: :destroy
+  has_many :players, dependent: :destroy
+
+  enum :status, {
+    waiting: "waiting",
+    question_open: "question_open",
+    question_closed: "question_closed",
+    finished: "finished"
+  }, validate: true
+
+  validates :quiz_title, :join_code, presence: true
+  validates :join_code, uniqueness: true, format: { with: /\A[A-Z2-9]{5}\z/ }
+  validates :current_question_position, numericality: { only_integer: true, greater_than_or_equal_to: 0 }
+
+  before_validation :assign_join_code, on: :create
+  after_update_commit :broadcast_state_change, if: :state_changed?
+
+  def self.create_for!(quiz)
+    active_questions = quiz.active_questions.includes(:options).to_a
+    raise NoActiveQuestions, "Activate at least one question before starting a game" if active_questions.empty?
+
+    transaction do
+      game = quiz.games.create!(quiz_title: quiz.title)
+
+      active_questions.each_with_index do |question, question_index|
+        game_question = game.game_questions.create!(text: question.text, position: question_index + 1)
+        question.options.each_with_index do |option, option_index|
+          game_question.game_options.create!(
+            text: option.text,
+            correct: option.correct?,
+            position: option_index + 1
+          )
+        end
+      end
+
+      game
+    end
+  end
+
+  def current_question
+    return if current_question_position.zero?
+
+    game_questions.find_by(position: current_question_position)
+  end
+
+def question_count
+  game_questions.count
+end
+
+def live_version
+  question = current_question
+  [
+    status,
+    current_question_position,
+    updated_at.to_f,
+    players.count,
+    question ? question.answers.count : 0
+  ].join(":")
+end
+
+  def last_question?
+    current_question_position >= question_count
+  end
+
+  def start!
+    with_lock do
+      raise InvalidTransition, "The game has already started" unless waiting?
+      raise NoActiveQuestions, "This game has no questions" if game_questions.none?
+
+      update!(status: :question_open, current_question_position: 1, started_at: Time.current)
+    end
+  end
+
+  def finish_question!
+    with_lock do
+      raise InvalidTransition, "This question is not open" unless question_open?
+
+      update!(status: :question_closed)
+    end
+  end
+
+  def advance!
+    with_lock do
+      raise InvalidTransition, "This question has not been finished" unless question_closed?
+
+      if last_question?
+        update!(status: :finished, finished_at: Time.current)
+      else
+        update!(status: :question_open, current_question_position: current_question_position + 1)
+      end
+    end
+  end
+
+  def join_player!(name:, token_digest:)
+    with_lock do
+      raise Finished, "The quiz is over" if finished?
+
+      players.find_by(token_digest: token_digest) || players.create!(name: name, token_digest: token_digest)
+    end
+  end
+
+  def submit_answer!(player:, option_id:)
+    with_lock do
+      raise InvalidTransition, "This question is closed" unless question_open?
+      raise InvalidTransition, "You are not in this game" unless player.game_id == id
+
+      question = current_question
+      option = question.game_options.find(option_id)
+      answer = player.answers.find_or_initialize_by(game_question: question)
+      answer.assign_attributes(game_option: option, answered_at: Time.current)
+      answer.save!
+      answer
+    end
+  end
+
+  def broadcast_moderator_state
+    Turbo::StreamsChannel.broadcast_refresh_to(self, :moderator, request_id: Turbo.current_request_id)
+  end
+
+  def broadcast_player_state
+    Turbo::StreamsChannel.broadcast_refresh_to(self, :players, request_id: Turbo.current_request_id)
+  end
+
+  private
+
+  def assign_join_code
+    self.join_code ||= loop do
+      candidate = Array.new(5) { JOIN_CODE_CHARACTERS[SecureRandom.random_number(JOIN_CODE_CHARACTERS.length)] }.join
+      break candidate unless self.class.exists?(join_code: candidate)
+    end
+  end
+
+  def state_changed?
+    saved_change_to_status? || saved_change_to_current_question_position?
+  end
+
+  def broadcast_state_change
+    broadcast_moderator_state
+    broadcast_player_state
+  end
+end
