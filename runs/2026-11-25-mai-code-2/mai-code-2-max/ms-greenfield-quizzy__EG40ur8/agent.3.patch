@@ -0,0 +1,69 @@
+module Moderate
+  class GamesController < ApplicationController
+    layout "player"
+
+    before_action :set_quiz
+    before_action :set_game, only: %i[show live start finish advance]
+
+    def create
+      game = Game.create_for!(@quiz)
+      redirect_to moderate_quiz_game_path(@quiz, game), status: :see_other
+    rescue Game::NoActiveQuestions => error
+      redirect_to moderate_quiz_path(@quiz), alert: error.message
+    end
+
+    def show
+      @question = @game.current_question
+      @join_url = "#{request.base_url}#{play_game_path(@game.join_code)}"
+      @qr_svg = qr_svg(@join_url)
+      @live_version = @game.live_version
+    end
+
+def live
+  response.headers["Cache-Control"] = "no-store"
+  render json: { version: @game.live_version }
+end
+
+def start
+      @game.start!
+      redirect_to moderate_quiz_game_path(@quiz, @game), status: :see_other
+    rescue Game::InvalidTransition, Game::NoActiveQuestions => error
+      redirect_to moderate_quiz_game_path(@quiz, @game), alert: error.message
+    end
+
+    def finish
+      @game.finish_question!
+      redirect_to moderate_quiz_game_path(@quiz, @game), status: :see_other
+    rescue Game::InvalidTransition => error
+      redirect_to moderate_quiz_game_path(@quiz, @game), alert: error.message
+    end
+
+    def advance
+      @game.advance!
+      redirect_to moderate_quiz_game_path(@quiz, @game), status: :see_other
+    rescue Game::InvalidTransition => error
+      redirect_to moderate_quiz_game_path(@quiz, @game), alert: error.message
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_game
+      @game = @quiz.games.find(params[:id])
+    end
+
+    def qr_svg(join_url)
+      RQRCode::QRCode.new(join_url).as_svg(
+        offset: 24,
+        fill: "ffffff",
+        color: "0d0640",
+        module_size: 6,
+        viewbox: true,
+        use_path: true
+      ).sub(/\A<\?xml[^>]*>\s*/, "")
+    end
+  end
+end
diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
index 0000000..8786d06
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,85 @@
+require "digest"
+
+class PlayController < ApplicationController
+  layout "player"
+
+  before_action :set_game
+  before_action :prepare_page
+
+  def show
+  end
+
+def live
+  response.headers["Cache-Control"] = "no-store"
+  render json: { version: @game.live_version }
+end
+
+def join
+    if @game.finished?
+      return redirect_to play_game_path(@game.join_code), alert: "The quiz is over", status: :see_other
+    end
+
+    if @player
+      return redirect_to play_game_path(@game.join_code), status: :see_other
+    end
+
+    @player = @game.join_player!(
+      name: player_params[:name],
+      token_digest: participant_token_digest
+    )
+    redirect_to play_game_path(@game.join_code), status: :see_other
+  rescue Game::Finished => error
+    redirect_to play_game_path(@game.join_code), alert: error.message
+  rescue ActiveRecord::RecordInvalid => error
+    @new_player = error.record
+    render :show, status: :unprocessable_entity
+  end
+
+  def answer
+    unless @player
+      return redirect_to play_game_path(@game.join_code), alert: "Join the quiz before answering", status: :see_other
+    end
+
+    @game.submit_answer!(player: @player, option_id: params.require(:option_id))
+    redirect_to play_game_path(@game.join_code), status: :see_other
+  rescue Game::InvalidTransition => error
+    redirect_to play_game_path(@game.join_code), alert: error.message, status: :see_other
+  rescue ActiveRecord::RecordNotFound
+    redirect_to play_game_path(@game.join_code), alert: "That answer is no longer available", status: :see_other
+  end
+
+  private
+
+  def set_game
+    @game = Game.find_by!(join_code: params[:code].to_s.upcase)
+    token = participant_token
+    @player = @game.players.find_by(token_digest: Digest::SHA256.hexdigest(token)) if token.present?
+  end
+
+  def prepare_page
+    @live_version = @game.live_version
+    @new_player ||= Player.new
+    return if @player.nil? || @game.waiting? || @game.finished?
+
+    @question = @game.current_question
+    @selected_answer = @question&.answer_for(@player)
+  end
+
+  def player_params
+    params.expect(player: [ :name ])
+  end
+
+  def participant_token
+    token = cookies.encrypted[:quizzy_player_token]
+    return token if token.present?
+    return if @game.finished?
+
+    token = SecureRandom.base64(36)
+    cookies.encrypted.permanent[:quizzy_player_token] = token
+    token
+  end
+
+  def participant_token_digest
+    Digest::SHA256.hexdigest(participant_token)
+  end
+end
diff --git a/app/javascript/application.js b/app/javascript/application.js
new file mode 100644
index 0000000..23b262a
--- /dev/null
+++ b/app/javascript/application.js
@@ -0,0 +1,59 @@
+import "@hotwired/turbo-rails"
+
+function startLiveStateSync() {
+  const root = document.querySelector("[data-live-state-url]")
+  if (!root) return
+
+  const stream = document.querySelector("turbo-cable-stream-source")
+  const version = root.dataset.liveVersion
+  const url = root.dataset.liveStateUrl
+  let checking = false
+  let streamWasConnected = false
+  let lastFallbackCheck = 0
+
+  const check = async () => {
+    if (checking || !root.isConnected) return
+    checking = true
+
+    try {
+      const response = await fetch(url, {
+        credentials: "same-origin",
+        cache: "no-store",
+        headers: { Accept: "application/json" }
+      })
+
+      if (!response.ok) throw new Error(`Live state request failed with ${response.status}`)
+      const state = await response.json()
+      if (state.version !== version && root.isConnected) {
+        window.Turbo.visit(window.location.href, { action: "replace" })
+      }
+    } catch (error) {
+      console.warn("Quizzy live update check failed", error)
+    } finally {
+      checking = false
+      lastFallbackCheck = Date.now()
+    }
+  }
+
+  const timer = window.setInterval(() => {
+    if (!root.isConnected) {
+      window.clearInterval(timer)
+      return
+    }
+
+    const connected = stream?.hasAttribute("connected")
+
+    if (connected && !streamWasConnected) check()
+    if (!connected && Date.now() - lastFallbackCheck >= 2000) check()
+
+    streamWasConnected = connected
+  }, 250)
+
+  document.addEventListener("turbo:before-cache", () => {
+    window.clearInterval(timer)
+  }, { once: true })
+
+  check()
+}
+
+document.addEventListener("turbo:load", startLiveStateSync)
