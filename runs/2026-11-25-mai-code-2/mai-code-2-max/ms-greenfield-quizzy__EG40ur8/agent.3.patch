diff --git a/app/views/play/show.html.erb b/app/views/play/show.html.erb
new file mode 100644
index 0000000..b94d611
--- /dev/null
+++ b/app/views/play/show.html.erb
@@ -0,0 +1,104 @@
+<% content_for :title, "#{@game.quiz_title} · Quizzy" %>
+
+<%= turbo_stream_from @game, :players %>
+
+<section class="cover cover--blue player-cover" data-live-state-url="<%= live_play_game_path(@game.join_code) %>" data-live-version="<%= @live_version %>">
+  <div class="play">
+    <header class="play__top">
+      <span class="logo play__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+      <span><%= @game.quiz_title %></span>
+    </header>
+
+    <% if @game.finished? %>
+      <main class="play__body">
+        <div class="result-card">
+          <h1 class="play-title">The quiz is over</h1>
+          <p class="play-lead">Thanks for playing <%= @game.quiz_title %>.</p>
+        </div>
+      </main>
+    <% elsif @player.nil? %>
+      <main class="play__body">
+        <h1 class="play-title"><%= @game.quiz_title %></h1>
+        <p class="play-lead">Choose a name so the moderator can see you.</p>
+
+        <%= form_with model: @new_player,
+              url: join_play_game_path(@game.join_code),
+              class: "join-form" do |form| %>
+          <% if @new_player.errors.any? %>
+            <div class="errors" role="alert">
+              <ul>
+                <% @new_player.errors.full_messages.each do |message| %>
+                  <li><%= message %></li>
+                <% end %>
+              </ul>
+            </div>
+          <% end %>
+
+          <div class="field">
+            <%= form.label :name, "Your name" %>
+            <%= form.text_field :name,
+                  class: "input",
+                  placeholder: "Your name",
+                  aria: { label: "Your name" },
+                  maxlength: 60,
+                  autocomplete: "nickname",
+                  required: true,
+                  autofocus: true %>
+          </div>
+          <%= form.button "Join", type: "submit", class: "btn btn--pink" %>
+        <% end %>
+      </main>
+    <% elsif @game.waiting? %>
+      <main class="play__body">
+        <div class="waiting">
+          <div class="waiting__gem" aria-hidden="true">?</div>
+          <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+          <p class="play-lead">Wait for the moderator to start.</p>
+        </div>
+      </main>
+    <% elsif @question %>
+      <main class="play__body play__body--top">
+        <div class="play-question__num">Question <%= @game.current_question_position %> of <%= @game.question_count %></div>
+        <div class="play-question__body"><%= @question.text %></div>
+
+        <ol class="play-options <%= "is-locked" if @game.question_closed? %>" aria-label="Options">
+          <% @question.game_options.each_with_index do |option, index| %>
+            <% picked = @selected_answer&.game_option_id == option.id %>
+            <li>
+              <% if @game.question_open? %>
+                <%= button_to answer_play_game_path(@game.join_code),
+                      method: :post,
+                      params: { option_id: option.id },
+                      class: ["play-option", ("is-picked" if picked)],
+                      aria: { label: option.text, pressed: picked } do %>
+                  <span class="play-option__letter"><%= (index + 65).chr %></span>
+                  <span class="play-option__title"><%= option.text %></span>
+                  <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+                <% end %>
+              <% else %>
+                <button type="button"
+                        class="play-option <%= "is-picked" if picked %>"
+                        aria-label="<%= option.text %>"
+                        disabled>
+                  <span class="play-option__letter"><%= (index + 65).chr %></span>
+                  <span class="play-option__title"><%= option.text %></span>
+                  <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+                </button>
+              <% end %>
+            </li>
+          <% end %>
+        </ol>
+
+        <% if @game.question_closed? %>
+          <% if @selected_answer.nil? %>
+            <div class="play-status play-status--neutral" role="status">No answer</div>
+          <% elsif @selected_answer.correct? %>
+            <div class="play-status play-status--right" role="status">Correct!</div>
+          <% else %>
+            <div class="play-status play-status--wrong" role="status">Wrong!</div>
+          <% end %>
+        <% end %>
+      </main>
+    <% end %>
+  </div>
+</section>
