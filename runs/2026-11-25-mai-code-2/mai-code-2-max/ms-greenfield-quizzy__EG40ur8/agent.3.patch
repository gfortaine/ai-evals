+<% content_for :title, "#{@game.quiz_title} · Live game · Quizzy" %>
+
+<%= turbo_stream_from @game, :moderator %>
+
+<section class="cover cover--night game-cover" data-live-state-url="<%= live_moderate_quiz_game_path(@quiz, @game) %>" data-live-version="<%= @live_version %>">
+  <div class="screen">
+    <header class="screen__top">
+      <span class="logo screen__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+      <span class="screen__quiz-title"><%= @game.quiz_title %></span>
+    </header>
+
+    <main class="screen__body">
+      <% if @game.waiting? %>
+        <div class="lobby">
+          <div>
+            <div class="screen__kicker">Join the quiz</div>
+            <h1 class="lobby__title"><%= @game.quiz_title %></h1>
+            <p class="lobby__join">Open this link on your phone</p>
+            <p class="lobby__url"><%= @join_url %></p>
+            <div class="counter-pill">Players: <%= @game.players.count %></div>
+          </div>
+
+          <div class="qr" role="img" aria-label="QR code for <%= @join_url %>">
+            <%= raw @qr_svg %>
+          </div>
+        </div>
+      <% elsif @game.question_open? || @game.question_closed? %>
+        <% answer_counts = @question.answers.group(:game_option_id).count %>
+        <div class="stage-question">
+          <div class="stage-question__num">Question <%= @game.current_question_position %> of <%= @game.question_count %></div>
+          <div class="stage-question__body"><%= @question.text %></div>
+          <ol class="stage-options <%= "stage-options--results" if @game.question_closed? %>" aria-label="Options">
+            <% @question.game_options.each_with_index do |option, index| %>
+              <% correct = @game.question_closed? && option.correct? %>
+              <% count = answer_counts.fetch(option.id, 0) %>
+              <li class="stage-option <%= "is-correct" if correct %>">
+                <span class="stage-option__letter"><%= (index + 65).chr %></span>
+                <span class="stage-option__title"><%= option.text %></span>
+                <% if @game.question_closed? %>
+                  <span class="stage-option__count"><%= count %></span>
+                  <% if correct %><span class="stage-option__mark">Correct</span><% end %>
+                <% end %>
+                <% if @game.question_closed? %><span class="stage-option__bar" aria-hidden="true"></span><% end %>
+              </li>
+            <% end %>
+          </ol>
+        </div>
+      <% else %>
+        <div class="game-over">
+          <div class="waiting__gem" aria-hidden="true">?</div>
+          <h1>The quiz is over</h1>
+          <p><%= @game.quiz_title %></p>
+        </div>
+      <% end %>
+    </main>
+  </div>
+
+  <footer class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "← Back to quiz", moderate_quiz_path(@quiz) %>
+      <% if @game.question_open? %>
+        <span class="answers-counter">Answers: <%= @question.answers.count %> / <%= @game.players.count %></span>
+      <% elsif @game.question_closed? %>
+        <span class="answers-counter">Answers: <%= @question.answers.count %> / <%= @game.players.count %></span>
+      <% end %>
+    </div>
+
+    <div class="screen-controls__action">
+      <% if @game.waiting? %>
+        <%= button_to "Start", start_moderate_quiz_game_path(@quiz, @game), method: :patch, class: "btn btn--pink btn--lg" %>
+      <% elsif @game.question_open? %>
+        <%= button_to "Finish", finish_moderate_quiz_game_path(@quiz, @game), method: :patch, class: "btn btn--pink btn--lg" %>
+      <% elsif @game.question_closed? %>
+        <%= button_to(@game.last_question? ? "End quiz" : "Next",
+              next_moderate_quiz_game_path(@quiz, @game), method: :patch, class: "btn btn--pink btn--lg") %>
+      <% end %>
+    </div>
+  </footer>
+</section>
