diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..6e38ad6 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -79,6 +79,37 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
   end
 
+  test "show reuses a picture variant created by background jobs" do
+    picture = Picture.new
+    leaf = books(:handbook).press picture, title: "Uploaded picture"
+
+    perform_enqueued_jobs only: [ ActiveStorage::CreateVariantsJob, ActiveStorage::TransformJob ] do
+      picture.image.attach io: file_fixture("white-rabbit.webp").open,
+        filename: "white-rabbit.webp", content_type: "image/webp"
+    end
+
+    blob = picture.image.blob
+    derived_bytes = blob.variant_records.sole.image.download
+    books(:handbook).update!(published: true)
+    sign_out
+
+    assert_no_notifications "transform.active_storage" do
+      get book_slug_path(books(:handbook))
+      assert_response :success
+
+      assert_select "#leaf_#{leaf.id} .toc__thumbnail img", 1 do |images|
+        get images.first["src"]
+      end
+    end
+
+    assert_response :redirect
+    assert_equal 1, blob.variant_records.reload.count
+
+    follow_redirect!
+    assert_response :success
+    assert_equal derived_bytes, response.body
+  end
+
   test "show includes OG metadata for public access" do
