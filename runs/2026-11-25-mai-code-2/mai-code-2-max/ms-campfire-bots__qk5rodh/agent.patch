+class AddOpenRoomPreferencesAndBotRoomJoins < ActiveRecord::Migration[8.1]
+  def change
+    add_column :users, :add_to_all_open_rooms, :boolean, default: false, null: false
+
+    create_table :bot_room_joins do |t|
+      t.references :bot, null: false, foreign_key: { to_table: :users }
+      t.references :room, null: false, foreign_key: true
+      t.timestamps
+
+      t.index [ :bot_id, :room_id ], unique: true
+    end
+
+    reversible do |direction|
+      direction.up do
+        execute <<~SQL
+          INSERT INTO bot_room_joins (bot_id, room_id, created_at, updated_at)
+          SELECT memberships.user_id, memberships.room_id, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
+          FROM memberships
+          INNER JOIN users ON users.id = memberships.user_id
+          INNER JOIN rooms ON rooms.id = memberships.room_id
+          WHERE users.type = 'Bot' AND rooms.type != 'Rooms::Direct'
+        SQL
+      end
+    end
+  end
+end
