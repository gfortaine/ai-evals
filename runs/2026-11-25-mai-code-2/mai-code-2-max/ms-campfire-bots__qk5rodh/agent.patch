+++ b/app/jobs/bot/webhook_job.rb
@@ -0,0 +1,11 @@
+class Bot::WebhookJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bot, message_or_room)
+    if message_or_room.is_a?(Message)
+      Bot::Webhook.new(bot:, message: message_or_room).deliver
+    else
+      Bot::Webhook.new(bot:, room: message_or_room).deliver
+    end
+  end
+end
