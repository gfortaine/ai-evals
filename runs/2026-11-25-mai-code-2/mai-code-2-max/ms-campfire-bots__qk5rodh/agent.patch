@@ -0,0 +1,56 @@
+require "application_system_test_case"
+
+class ManagingBotsTest < ApplicationSystemTestCase
+  test "creating, editing, and deleting a bot" do
+    sign_in "jz@37signals.com"
+    visit edit_account_url
+
+    click_on "Set up chat bots"
+    click_on "Add a chat bot"
+    fill_in "Name the bot", with: "Deploy Bot"
+    assert_not find_field("Add to all open rooms").checked?
+    check "Add to all open rooms"
+    click_on "Save changes"
+
+    assert_current_path bots_path
+    assert_text "Deploy Bot"
+    code = find_field("Bot code")
+    assert_selector "input[readonly]"
+    assert_predicate code.value, :present?
+
+    click_on "Edit Deploy Bot"
+    fill_in "Name the bot", with: "Release Bot"
+    assert find_field("Add to all open rooms").checked?
+    uncheck "Add to all open rooms"
+    click_on "Save changes"
+
+    assert_current_path bots_path
+    assert_text "Release Bot"
+
+    click_on "Edit Release Bot"
+    accept_confirm do
+      click_on "Delete this chat bot"
+    end
+
+    assert_current_path bots_path
+    assert_no_text "Release Bot"
+  end
+
+  test "an administrator reactivates a suspended bot after confirmation" do
+    bot = users(:jz).bots.create!(name: "Paused Bot")
+    bot.suspend!("flooding")
+    sign_in "david@37signals.com"
+    visit bots_url
+
+    assert_text "Suspended"
+    assert_text "Reason: Flooding: message rate limit exceeded"
+
+    accept_confirm do
+      click_on "Reactivate"
+    end
+
+    assert_current_path bots_path
+    assert_no_text "Suspended"
+    assert_predicate bot.reload, :active?
+  end
+end
