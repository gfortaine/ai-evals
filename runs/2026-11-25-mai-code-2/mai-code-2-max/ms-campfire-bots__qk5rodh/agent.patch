diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..9ba4b81
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,53 @@
+class Bots::MessagesController < ApplicationController
+  allow_unauthenticated_access only: :create
+  skip_forgery_protection only: :create
+
+  before_action :set_room
+  before_action :set_bot
+
+  rescue_from Bot::PostingCooldownError, with: :reject_during_cooldown
+  rescue_from Bot::SuspendedError, with: :reject_suspended_bot
+
+  def create
+    body = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+    message = @bot.post_message!(room: @room, body: body)
+    return head :unprocessable_content unless message
+
+    message.broadcast_create
+
+    head :created, location: message_path(message)
+  end
+
+  private
+    # Curl's default form content type must not make Rails parse the opaque message body.
+    def process_action(*)
+      request.set_header "CONTENT_TYPE", "text/plain"
+      request.set_header "action_dispatch.request.request_parameters", {}
+      request.set_header "action_dispatch.request.content_type", Mime[:text]
+      super
+    end
+
+    def set_room
+      @room = Room.find_by(id: request.path_parameters[:room_id])
+      head :not_found unless @room
+    end
+
+    def set_bot
+      @bot = Bot.find_by(bot_code: request.path_parameters[:bot_code])
+      return head :unauthorized unless @bot
+      return head :forbidden if @bot.suspended?
+
+      unless @bot.active? && @bot.memberships.exists?(room: @room)
+        head :unauthorized
+      end
+    end
+
+    def reject_during_cooldown(error)
+      response.set_header "Retry-After", error.retry_after.to_s
+      head :too_many_requests
+    end
+
+    def reject_suspended_bot
+      head :forbidden
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..b914ac3
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,73 @@
+class BotsController < ApplicationController
+  before_action :ensure_administrator, only: :reactivate
+  before_action :set_bot, only: %i[ edit update destroy reactivate ]
+  before_action :redirect_from_new_when_at_bot_limit, only: :new
+  before_action :ensure_bot_creation_is_allowed, only: :create
+
+  def index
+    @bots = bot_scope.with_attached_avatar.ordered
+  end
+
+  def new
+    @bot = Current.user.bots.new
+  end
+
+  def create
+    @bot = Current.user.bots.new(bot_params)
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.destroy!
+    redirect_to bots_url
+  end
+
+  def reactivate
+    @bot.reactivate!
+    redirect_to bots_url
+  end
+
+  private
+    def set_bot
+      @bot = bot_scope.find_by(id: params[:id])
+      head :not_found unless @bot
+    end
+
+    def bot_scope
+      Current.user.can_administer? ? Bot.all : Current.user.bots
+    end
+
+    def redirect_from_new_when_at_bot_limit
+      if Current.user.bot_limit_reached?
+        redirect_to bots_url, alert: Bot::LIMIT_REACHED_MESSAGE
+      end
+    end
+
+    def ensure_bot_creation_is_allowed
+      head :forbidden if Current.user.bot_limit_reached?
+    end
+
+    def ensure_administrator
+      head :forbidden unless Current.user.administrator?
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar, :webhook_url, :add_to_all_open_rooms)
+    end
+end
