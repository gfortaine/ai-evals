diff --git a/test/models/bot_test.rb b/test/models/bot_test.rb
new file mode 100644
index 0000000..db0e85b
--- /dev/null
+++ b/test/models/bot_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class BotTest < ActiveSupport::TestCase
+  test "creates a unique bot code" do
+    first = users(:jz).bots.create!(name: "First bot")
+    second = users(:jz).bots.create!(name: "Second bot")
+
+    assert first.bot_code.present?
+    assert_not_equal first.bot_code, second.bot_code
+    assert_equal first.bot_code, first.code
+    assert_equal first.bot_code, first.token
+  end
+
+  test "members cannot create a bot at the account limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    creator = users(:jz)
+    creator.bots.create!(name: "Allowed bot")
+
+    bot = creator.bots.new(name: "Blocked bot")
+
+    assert_not bot.valid?
+    assert_includes bot.errors.full_messages, Bot::LIMIT_REACHED_MESSAGE
+    assert_no_difference -> { Bot.count } do
+      assert_not bot.save
+    end
+  end
+
+  test "deleting a bot makes room for another one" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    creator = users(:jz)
+    creator.bots.create!(name: "Temporary bot").destroy!
+
+    assert creator.bots.create!(name: "Replacement bot")
+  end
+
+  test "administrators are not limited" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    creator = users(:david)
+
+    assert creator.bots.create!(name: "First bot")
+    assert creator.bots.create!(name: "Second bot")
+  end
+
+  test "lowering the limit keeps existing bots and only blocks new bots" do
+    creator = users(:jz)
+    bots = 2.times.map { |index| creator.bots.create!(name: "Existing bot #{index}") }
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+    assert_equal bots, creator.bots.reload.order(:id).to_a
+    assert bots.first.update(name: "Still editable")
+    assert_not creator.bots.new(name: "New bot").valid?
+  end
+
+  test "requires a name and creator" do
+    bot = Bot.new
+
+    assert_not bot.valid?
+    assert bot.errors.of_kind?(:name, :blank)
+    assert bot.errors.of_kind?(:creator, :blank)
+  end
+
+  test "does not join open rooms by default" do
+    bot = users(:jz).bots.create!(name: "Open room bot")
+
+    assert_empty bot.rooms
+  end
+  test "joins every open room when configured to do so" do
+    bot = users(:jz).bots.create!(name: "Everywhere bot", add_to_all_open_rooms: true)
+
+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+  end
+
+  test "turning automatic open room membership on grants it and turning it off keeps it" do
+    bot = users(:jz).bots.create!(name: "Everywhere bot")
+
+    bot.update!(add_to_all_open_rooms: true)
+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+
+    bot.update!(add_to_all_open_rooms: false)
+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+
+    new_room = Rooms::Open.create!(name: "A later room", creator: users(:david))
+    assert_not_includes bot.rooms, new_room
+  end
+
+  test "joins open rooms created after automatic membership is enabled" do
+    bot = users(:jz).bots.create!(name: "Future bot", add_to_all_open_rooms: true)
+    room = Rooms::Open.create!(name: "A later room", creator: users(:david))
+
+    assert_includes bot.rooms, room
+  end
+
+  test "joining open rooms queues one webhook per room" do
+    assert_enqueued_jobs Rooms::Open.count, only: Bot::WebhookJob do
+      bot = users(:jz).bots.create!(
+        name: "Webhook bot",
+        webhook_url: "https://hooks.example.com/joined",
+        add_to_all_open_rooms: true
+      )
+      assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+    end
+  end
+
+  test "normalizes a blank webhook URL to nil" do
+    bot = users(:jz).bots.create!(name: "Webhook Bot", webhook_url: "  ")
+
+    assert_nil bot.webhook_url
+  end
+
+  test "requires an HTTP webhook URL" do
+    bot = users(:jz).bots.build(name: "Webhook Bot", webhook_url: "file:///tmp/campfire")
+
+    assert_not bot.valid?
+    assert_includes bot.errors[:webhook_url], "must be an HTTP(S) URL"
+  end
+end
