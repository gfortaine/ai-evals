diff --git a/test/controllers/bots/messages_controller_test.rb b/test/controllers/bots/messages_controller_test.rb
new file mode 100644
index 0000000..4071c60
--- /dev/null
+++ b/test/controllers/bots/messages_controller_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = users(:jz).bots.create!(name: "Deploy Bot")
+    @room = rooms(:pets)
+    @room.memberships.grant_to(@bot)
+  end
+
+  test "posts the raw body as the bot and broadcasts it" do
+    body = "Deploy 100% finished ✅ + safe=raw&key=value"
+
+    post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: body,
+      headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author", text: /Deploy Bot/
+      assert_select ".message__body", text: /Deploy 100% finished/
+    end
+
+    message = Message.order(:id).last
+    assert_response :created
+    assert_equal message_path(message), response.location
+    assert_equal body.dup.force_encoding(Encoding::UTF_8), message.plain_text_body
+    assert_equal @bot, message.creator
+  end
+
+  test "returns the required relative location for a bot message" do
+    post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: "Built"
+
+    message = Message.order(:id).last
+    assert_equal message_path(message), URI(response.location).path
+  end
+
+  test "rejects an empty body" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: ""
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "returns not found for a bad room id" do
+    post room_bot_messages_url(room_id: -1, bot_code: @bot.bot_code), params: "Built"
+
+    assert_response :not_found
+  end
+
+  test "returns unauthorized for an invalid bot code" do
+    post room_bot_messages_url(room_id: @room.id, bot_code: "invalid"), params: "Built"
+
+    assert_response :unauthorized
+  end
+
+  test "posts after the bot is granted membership to a closed room" do
+    room = rooms(:watercooler)
+    room.memberships.grant_to(@bot)
+
+    post room_bot_messages_url(room_id: room.id, bot_code: @bot.bot_code), params: "Private build"
+
+    assert_response :created
+    assert_equal @bot, room.messages.order(:id).last.creator
+  end
+
+  test "returns unauthorized when the bot is not a room member" do
+    post room_bot_messages_url(room_id: rooms(:watercooler).id, bot_code: @bot.bot_code), params: "Built"
+
+    assert_response :unauthorized
+  end
+
+  test "a deleted bot can no longer post" do
+    bot_code = @bot.bot_code
+    @bot.destroy!
+
+    post room_bot_messages_url(room_id: @room.id, bot_code: bot_code), params: "Built"
+
+    assert_response :unauthorized
+  end
+
+  test "enqueues the same push notification job as a human message" do
+    assert_enqueued_with(job: Room::PushMessageJob) do
+      post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: "Built"
+    end
+  end
+
+  test "rate limits posting and suspends after five attempts during the cooldown" do
+    travel_to Time.current.change(usec: 0) do
+      10.times do |index|
+        post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: "Message #{index}"
+        assert_response :created
+      end
+
+      assert_no_difference -> { Message.count } do
+        post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: "Over the limit"
+      end
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+
+      travel 1.second
+      4.times do
+        post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: "During cooldown"
+        assert_response :too_many_requests
+        assert_equal "29", response.headers["Retry-After"]
+      end
+
+      post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: "Still flooding"
+      assert_response :forbidden
+
+      assert_predicate @bot.reload, :suspended?
+      assert_equal "flooding", @bot.suspension_reason
+      assert_equal 10, @bot.messages.count
+      assert_includes @bot.rooms, @room
+    end
+  end
+
+  test "the cooldown expires after 30 seconds" do
+    travel_to Time.current.change(usec: 0) do
+      10.times { post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: "Flood" }
+      post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: "Over the limit"
+      assert_response :too_many_requests
+
+      travel 30.seconds
+      post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: "Recovered"
+
+      assert_response :created
+      assert_predicate @bot.reload, :active?
+    end
+  end
+
+test "empty requests are still rejected as too many requests during a cooldown" do
+  10.times { post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: "Flood" }
+  post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: "Over the limit"
+
+  post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: ""
+
+  assert_response :too_many_requests
+  assert_equal "30", response.headers["Retry-After"]
+end
+
+  test "a suspended bot is forbidden from posting" do
+    @bot.suspend!("flooding")
+
+    post room_bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: "Blocked"
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..f1fc6c2
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,270 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :jz
+  end
+
+  test "account settings link to chat bot setup" do
+    get edit_account_url
+
+    assert_response :success
+    assert_select "a[aria-label='Set up chat bots'][href='#{bots_path}']"
+  end
+
+  test "index lists the member's bots with their readonly codes and edit links" do
+    bot = users(:jz).bots.create!(name: "Deploy Bot")
+    users(:kevin).bots.create!(name: "Other Bot")
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li##{dom_id(bot)}", text: /Deploy Bot/ do
+      assert_select "label", text: "Bot code"
+      assert_select "input[readonly][value='#{bot.bot_code}']"
+      assert_select "a[aria-label='Edit Deploy Bot'][href='#{edit_bot_path(bot)}']"
+    end
+    assert_select "body", { text: /Other Bot/, count: 0 }
+    assert_select "a[aria-label='Add a chat bot']"
+  end
+
+  test "the index hides creation and says the member has reached the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    users(:jz).bots.create!(name: "Allowed bot")
+
+    get bots_url
+
+    assert_response :success
+    assert_select "a[aria-label='Add a chat bot']", count: 0
+    assert_select "p", text: Bot::LIMIT_REACHED_MESSAGE
+  end
+
+  test "new and create refuse bot creation at the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    users(:jz).bots.create!(name: "Allowed bot")
+
+    get new_bot_url
+    assert_redirected_to bots_url
+
+    assert_no_difference -> { Bot.count } do
+      post bots_url, params: { bot: { name: "Blocked bot" } }
+    end
+    assert_response :forbidden
+  end
+
+  test "administrators can still add bots at the configured member limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    sign_in :david
+
+    get bots_url
+    assert_select "a[aria-label='Add a chat bot']"
+
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Admin bot" } }
+    end
+    assert_redirected_to bots_url
+  end
+
+  test "a bot has a user avatar URL for messages" do
+    bot = users(:jz).bots.create!(name: "Avatar Bot")
+
+    get fresh_user_avatar_url(bot)
+
+    assert_response :success
+    assert_equal "image/svg+xml", response.media_type
+  end
+
+  test "administrators can see all bots" do
+    sign_in :david
+    own_bot = users(:david).bots.create!(name: "Admin Bot")
+    other_bot = users(:jz).bots.create!(name: "Member Bot")
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li##{dom_id(own_bot)}"
+    assert_select "li##{dom_id(other_bot)}"
+  end
+
+  test "new uses the required bot form labels" do
+    get new_bot_url
+
+    assert_response :success
+    assert_select "label[for='bot_name']", text: "Name the bot"
+    assert_select "input[name='bot[name]'][required]"
+    assert_select "input[name='bot[avatar]'][type='file'][aria-label='Bot avatar']"
+    assert_select "button", text: /Save changes/
+    assert_select "label[for='bot_add_to_all_open_rooms']", text: "Add to all open rooms"
+    assert_select "input[name='bot[add_to_all_open_rooms]'][type='checkbox']:not([checked])"
+  end
+
+  test "create saves a bot for the current user and redirects to the unpaginated list" do
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+
+    bot = Bot.order(:id).last
+    assert_equal users(:jz), bot.creator
+    assert_redirected_to bots_url
+    assert_not bot.add_to_all_open_rooms?
+    assert_empty bot.rooms
+  end
+
+  test "create can add a bot to every open room" do
+    post bots_url, params: { bot: { name: "Everywhere Bot", add_to_all_open_rooms: "1" } }
+
+    bot = Bot.order(:id).last
+    assert bot.add_to_all_open_rooms?
+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+  end
+
+  test "create accepts an avatar" do
+    post bots_url, params: {
+      bot: { name: "Avatar Bot", avatar: fixture_file_upload("moon.jpg", "image/jpeg") }
+    }
+
+    assert Bot.order(:id).last.avatar.attached?
+    assert_redirected_to bots_url
+  end
+
+  test "create rejects a missing name" do
+    assert_no_difference -> { Bot.count } do
+      post bots_url, params: { bot: { name: "" } }
+    end
+
+    assert_response :unprocessable_content
+    assert_select "label[for='bot_name']", text: "Name the bot"
+  end
+
+  test "updates an owned bot" do
+    bot = users(:jz).bots.create!(name: "Old name")
+
+    patch bot_url(bot), params: { bot: { name: "New name" } }
+
+    assert_redirected_to bots_url
+    assert_equal "New name", bot.reload.name
+  end
+
+  test "turning automatic membership off keeps existing room memberships" do
+    bot = users(:jz).bots.create!(name: "Everywhere Bot")
+    patch bot_url(bot), params: { bot: { name: bot.name, add_to_all_open_rooms: "1" } }
+    assert_equal Rooms::Open.ids.sort, bot.reload.rooms.ids.sort
+
+    patch bot_url(bot), params: { bot: { name: bot.name, add_to_all_open_rooms: "0" } }
+    assert_not bot.reload.add_to_all_open_rooms?
+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+  end
+
+  test "members cannot manage another member's bot" do
+    bot = users(:kevin).bots.create!(name: "Private bot")
+
+    get edit_bot_url(bot)
+    assert_response :not_found
+
+    patch bot_url(bot), params: { bot: { name: "Stolen" } }
+    assert_response :not_found
+    assert_equal "Private bot", bot.reload.name
+
+    delete bot_url(bot)
+    assert_response :not_found
+    assert bot.reload
+  end
+
+  test "destroy deletes an owned bot" do
+    bot = users(:jz).bots.create!(name: "Temporary bot")
+
+    assert_difference -> { Bot.count }, -1 do
+      delete bot_url(bot)
+    end
+
+    assert_redirected_to bots_url
+  end
+  test "new and edit forms expose the optional webhook URL field" do
+    get new_bot_url
+
+    assert_response :success
+    assert_select "label[for='bot_webhook_url']", text: "Webhook URL"
+    assert_select "input[name='bot[webhook_url]'][type='url']:not([required])"
+
+    bot = users(:jz).bots.create!(name: "Webhook Bot", webhook_url: "https://hooks.example.com/mention", add_to_all_open_rooms: true)
+    get edit_bot_url(bot)
+
+    assert_response :success
+    assert_select "label[for='bot_webhook_url']", text: "Webhook URL"
+    assert_select "input[name='bot[webhook_url]'][value='https://hooks.example.com/mention']"
+    assert_select "input[name='bot[add_to_all_open_rooms]'][type='checkbox'][checked]"
+  end
+
+  test "create saves a webhook URL" do
+    post bots_url, params: {
+      bot: { name: "Webhook Bot", webhook_url: "https://hooks.example.com/mention" }
+    }
+
+    assert_equal "https://hooks.example.com/mention", Bot.order(:id).last.webhook_url
+  end
+
+  test "saving an empty webhook URL removes it" do
+    bot = users(:jz).bots.create!(name: "Webhook Bot", webhook_url: "https://hooks.example.com/mention")
+
+    patch bot_url(bot), params: { bot: { name: bot.name, webhook_url: "" } }
+
+    assert_redirected_to bots_url
+    assert_nil bot.reload.webhook_url
+  end
+
+  test "the member bots page shows suspension details without reactivation controls" do
+    bot = users(:jz).bots.create!(name: "Flood Bot")
+    bot.suspend!("flooding")
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li##{dom_id(bot)}", text: /Suspended/ do
+      assert_select "*", text: /Reason: Flooding: message rate limit exceeded/
+      assert_select "button", text: "Reactivate", count: 0
+    end
+  end
+
+  test "only administrators can reactivate a suspended bot" do
+    bot = users(:jz).bots.create!(name: "Broken Bot", webhook_url: "https://hooks.example.com/mention")
+    bot.suspend!("webhook_failures")
+    bot.update!(posting_cooldown_until: 30.seconds.from_now, posting_cooldown_attempts: 5, webhook_failure_count: 10)
+
+    patch reactivate_bot_url(bot)
+    assert_response :forbidden
+    assert_predicate bot.reload, :suspended?
+
+    sign_in :david
+    delete user_ban_url(bot)
+    assert_predicate bot.reload, :suspended?
+
+    get bots_url
+    assert_select "form[action='#{reactivate_bot_path(bot)}'] button[data-turbo-confirm]", text: "Reactivate"
+
+    patch reactivate_bot_url(bot)
+
+    assert_redirected_to bots_url
+    assert_predicate bot.reload, :active?
+    assert_nil bot.suspension_reason
+    assert_nil bot.posting_cooldown_until
+    assert_equal 0, bot.posting_cooldown_attempts
+    assert_equal 0, bot.webhook_failure_count
+  end
+
+  test "suspended bots still count toward their owner's limit and retain their data" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    bot = users(:jz).bots.create!(name: "Stopped Bot")
+    room = rooms(:pets)
+    room.memberships.grant_to(bot)
+    message = room.messages.create!(creator: bot, body: "Kept message")
+    bot.suspend!("flooding")
+
+    get bots_url
+
+    assert_response :success
+    assert_select "p", text: Bot::LIMIT_REACHED_MESSAGE
+    assert_includes bot.reload.rooms, room
+    assert Message.exists?(message.id)
+    assert_equal 1, users(:jz).bots.count
+  end
+end
