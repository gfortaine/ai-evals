+class Bot::RoomJoin < ApplicationRecord
+  self.table_name = "bot_room_joins"
+
+  belongs_to :bot, class_name: "Bot", inverse_of: :room_joins
+  belongs_to :room, inverse_of: :bot_room_joins
+
+  after_create_commit :deliver_webhook_later
+
+  def self.record!(bot:, room:)
+    create_or_find_by!(bot:, room:) unless room.direct?
+  end
+
+  private
+    def deliver_webhook_later
+      Bot::WebhookJob.perform_later(bot, room) if bot.active? && bot.webhook_url.present?
+    end
+end
diff --git a/app/models/bot/webhook.rb b/app/models/bot/webhook.rb
new file mode 100644
index 0000000..929aa78
--- /dev/null
+++ b/app/models/bot/webhook.rb
@@ -0,0 +1,115 @@
+require "net/http"
+require "openssl"
+require "restricted_http/private_network_guard"
+
+class Bot::Webhook
+  REPLY_CONTENT_TYPES = %w[ text/plain text/html ].freeze
+
+  def initialize(bot:, message: nil, room: nil)
+    @bot, @message, @room = bot, message, room || message&.room
+    raise ArgumentError, "message or room is required" unless @room
+  end
+
+  def deliver
+    return unless bot.reload.active?
+    return if message.nil? && room.direct?
+    return unless bot.webhook_url.present?
+
+    response = post_webhook
+
+    if response.is_a?(Net::HTTPSuccess)
+      bot.record_webhook_success!
+      post_reply response
+    else
+      record_failure "HTTP #{response.code}"
+    end
+  rescue Timeout::Error, SocketError, EOFError, IOError, SystemCallError,
+      Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError, OpenSSL::SSL::SSLError,
+      URI::InvalidURIError, RestrictedHTTP::Violation, Surfguard::Unresolvable,
+      Surfguard::Violation => error
+    record_failure error.class.name
+  end
+
+  def payload
+    message ? mention_payload : joined_payload
+  end
+
+  private
+    attr_reader :bot, :message, :room
+
+    def mention_payload
+      {
+        event: "mention",
+        author: {
+          id: message.creator_id,
+          name: message.creator.name
+        },
+        room: room_payload,
+        message: {
+          id: message.id,
+          body: {
+            text: command_text,
+            html: message.body.to_s
+          },
+          link: routes.room_at_message_path(room_id: room.id, message_id: message.id)
+        }
+      }
+    end
+
+    def joined_payload
+      {
+        event: "joined",
+        room: room_payload
+      }
+    end
+
+    def room_payload
+      {
+        id: room.id,
+        name: room.name,
+        reply_to: routes.room_bot_messages_path(room_id: room.id, bot_code: bot.bot_code)
+      }
+    end
+
+    def routes
+      Rails.application.routes.url_helpers
+    end
+
+    def command_text
+      message.body.body.render_attachments do |attachment|
+        attachment.attachable == bot ? "" : attachment.to_plain_text
+      end.to_plain_text.strip
+    end
+
+    def post_webhook
+      url = URI.parse(bot.webhook_url)
+      ip = RestrictedHTTP::PrivateNetworkGuard.resolve(url.host)
+      request = Net::HTTP::Post.new(url, "Content-Type" => "application/json")
+      request.body = payload.to_json
+
+      Net::HTTP.start(url.host, url.port, ipaddr: ip, use_ssl: url.scheme == "https") do |http|
+        http.open_timeout = 5
+        http.read_timeout = 10
+        http.request(request)
+      end
+    end
+
+    def post_reply(response)
+      return unless response.is_a?(Net::HTTPSuccess) && response.content_type.in?(REPLY_CONTENT_TYPES)
+      return unless body = response.body.presence
+
+      reply = bot.post_message!(room:, body: reply_body(body, response.content_type))
+      reply.broadcast_create
+    rescue Bot::PostingCooldownError, Bot::SuspendedError
+      Rails.logger.info "Webhook reply suppressed for suspended or rate-limited bot #{bot.id}"
+    end
+
+    def reply_body(body, content_type)
+      content_type == "text/html" ? body : ERB::Util.html_escape(body)
+    end
+
+    def record_failure(detail)
+      Rails.logger.warn "Webhook delivery failed for bot #{bot.id}: #{detail}"
+      bot.record_webhook_failure!
+    end
+end
