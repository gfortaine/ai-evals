diff --git a/test/jobs/bot/webhook_job_test.rb b/test/jobs/bot/webhook_job_test.rb
new file mode 100644
index 0000000..6e0d11c
--- /dev/null
+++ b/test/jobs/bot/webhook_job_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class Bot::WebhookJobTest < ActiveSupport::TestCase
+  setup do
+    @webhook_url = "https://hooks.example.com/campfire"
+    @bot = users(:jz).bots.create!(name: "Deploy Bot")
+    @room = rooms(:pets)
+    @message = @room.messages.create!(
+      creator: users(:david),
+      client_message_id: "webhook-command",
+      body: "<div>#{mention_attachment_for(@bot)} restart for #{mention_attachment_for(:jason)}</div>"
+    )
+    @bot.update!(webhook_url: @webhook_url)
+
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("hooks.example.com").returns("93.184.216.34")
+  end
+
+  test "posts the mention payload as JSON" do
+    request_body = nil
+    stub_request(:post, @webhook_url).with do |request|
+      request_body = request.body
+      request.headers["Content-Type"] == "application/json"
+    end.to_return(status: 204)
+
+    Bot::WebhookJob.perform_now(@bot, @message)
+
+    payload = JSON.parse(request_body)
+    assert_equal "mention", payload["event"]
+    assert_equal({ "id" => users(:david).id, "name" => "David" }, payload["author"])
+    assert_equal @room.id, payload.dig("room", "id")
+    assert_equal @room.name, payload.dig("room", "name")
+    assert_equal Rails.application.routes.url_helpers.room_bot_messages_path(room_id: @room.id, bot_code: @bot.bot_code), payload.dig("room", "reply_to")
+    assert_equal @message.id, payload.dig("message", "id")
+    assert_equal "restart for @Jason", payload.dig("message", "body", "text")
+    assert_includes payload.dig("message", "body", "html"), "restart for"
+    assert_equal Rails.application.routes.url_helpers.room_at_message_path(room_id: @room.id, message_id: @message.id), payload.dig("message", "link")
+  end
+
+  test "posts a 200 plain-text response as the bot" do
+    stub_request(:post, @webhook_url).to_return(
+      status: 200,
+      body: "Built <strong>now</strong> & ready",
+      headers: { "Content-Type" => "text/plain; charset=utf-8" }
+    )
+
+    assert_difference -> { @room.messages.count }, 1 do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Built <strong>now</strong> & ready", reply.plain_text_body
+  end
+
+  test "posts a 200 HTML response as rich text from the bot" do
+    stub_request(:post, @webhook_url).to_return(
+      status: 200,
+      body: "<div>Built <strong>now</strong></div>",
+      headers: { "Content-Type" => "text/html; charset=utf-8" }
+    )
+
+    Bot::WebhookJob.perform_now(@bot, @message)
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.body.to_html, "<strong>now</strong>"
+  end
+
+  test "a 204 response does not post a message" do
+    stub_request(:post, @webhook_url).to_return(status: 204)
+
+    assert_no_difference -> { @room.messages.count } do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+  end
+
+  test "a removed webhook is ignored if delivery was already queued" do
+    @bot.update!(webhook_url: nil)
+
+    assert_no_difference -> { @room.messages.count } do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+  end
+
+  test "a 200 response with another content type does not post a message" do
+    stub_request(:post, @webhook_url).to_return(status: 200, body: '{"status":"ok"}', headers: { "Content-Type" => "application/json" })
+
+    assert_no_difference -> { @room.messages.count } do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+  end
+end
