+    assert_equal 2, @bot.reload.webhook_failure_count
+  end
+
+  test "a suspended bot receives no queued webhooks" do
+    @bot.suspend!("webhook_failures")
+    stub_request(:post, @webhook_url).to_return(status: 200)
+
+    Bot::WebhookJob.perform_now(@bot, @message)
+
+    assert_not_requested :post, @webhook_url
+  end
+
+  test "webhook replies use the same message limit and cooldown" do
+    10.times { |index| @bot.post_message!(room: @room, body: "Posted #{index}") }
+    stub_request(:post, @webhook_url).to_return(
+      status: 200,
+      body: "Over the limit",
+      headers: { "Content-Type" => "text/plain" }
+    )
+
+    assert_no_difference -> { @room.messages.count } do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+
+    assert_predicate @bot.reload.posting_cooldown_until, :future?
+    assert_equal 0, @bot.posting_cooldown_attempts
+  end
 end
