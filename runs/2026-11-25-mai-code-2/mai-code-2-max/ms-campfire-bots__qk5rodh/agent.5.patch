 class Bot < User
   LIMIT_REACHED_MESSAGE = "You have reached the limit for chat bots."
+  MESSAGE_LIMIT = 10
+  MESSAGE_WINDOW = 10.seconds
+  POSTING_COOLDOWN = 30.seconds
+  COOLDOWN_SUSPENSION_ATTEMPTS = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+  SUSPENSION_REASON_LABELS = {
+    "flooding" => "Flooding: message rate limit exceeded",
+    "webhook_failures" => "Webhook failures: 10 consecutive failed deliveries"
+  }.freeze
+
+  class PostingCooldownError < StandardError
+    def initialize(expires_at)
+      @expires_at = expires_at
+    end
+
+    def retry_after
+      [ (@expires_at - Time.current).ceil, 1 ].max
+    end
+  end
+
+  class SuspendedError < StandardError; end
 
   belongs_to :creator, class_name: "User", inverse_of: :bots, default: -> { Current.user }
   has_many :room_joins, class_name: "Bot::RoomJoin", dependent: :delete_all, inverse_of: :bot
@@ -20,8 +41,115 @@ class Bot < User
   before_create :lock_creator_and_recheck_bot_limit
 
   after_update_commit :grant_membership_to_open_rooms_when_enabled, if: :enabled_open_room_membership?
+
+  def post_message!(room:, body:)
+    error = nil
+
+    message = with_lock do
+      error = posting_limit_error
+
+      if error
+        nil
+      elsif body.present?
+        room.messages.create!(creator: self, body:)
+      end
+    end
+
+    raise error if error
+
+    message
+  end
+
+  def record_webhook_failure!
+    with_lock do
+      if active?
+        failures = webhook_failure_count + 1
+
+        if failures >= WEBHOOK_FAILURE_LIMIT
+          update!(webhook_failure_count: failures, status: :suspended, suspension_reason: "webhook_failures")
+        else
+          update!(webhook_failure_count: failures)
+        end
+      end
+    end
+  end
+
+  def record_webhook_success!
+    with_lock { update!(webhook_failure_count: 0) if active? }
+  end
+
+  def suspend!(reason)
+    reason = reason.to_s
+    raise ArgumentError, "Unknown suspension reason: #{reason}" unless SUSPENSION_REASON_LABELS.key?(reason)
+
+    with_lock { suspend_without_lock!(reason) unless suspended? }
+  end
+
+  def reactivate!
+    with_lock do
+      if suspended?
+        update!(
+          status: :active,
+          suspension_reason: nil,
+          posting_cooldown_until: nil,
+          posting_cooldown_attempts: 0,
+          webhook_failure_count: 0
+        )
+      end
+    end
+  end
+
+  def suspension_reason_label
+    SUSPENSION_REASON_LABELS.fetch(suspension_reason, "Unknown reason")
+  end
+
   # A distinct callback method preserves User's inherited after-create callback.
   private
+    def posting_limit_error
+      return SuspendedError.new unless active?
+
+      now = Time.current
+
+      if posting_cooldown_until&.future?
+        record_cooldown_attempt
+      else
+        clear_expired_cooldown
+        start_cooldown(now) if recent_message_count(now) >= MESSAGE_LIMIT
+      end
+    end
+
+    def record_cooldown_attempt
+      attempts = posting_cooldown_attempts + 1
+
+      if attempts >= COOLDOWN_SUSPENSION_ATTEMPTS
+        update!(posting_cooldown_attempts: attempts, status: :suspended, suspension_reason: "flooding")
+        SuspendedError.new
+      else
+        update!(posting_cooldown_attempts: attempts)
+        PostingCooldownError.new(posting_cooldown_until)
+      end
+    end
+
+    def clear_expired_cooldown
+      if posting_cooldown_until
+        update!(posting_cooldown_until: nil, posting_cooldown_attempts: 0)
+      end
+    end
+
+    def start_cooldown(now)
+      expires_at = now + POSTING_COOLDOWN
+      update!(posting_cooldown_until: expires_at, posting_cooldown_attempts: 0)
+      PostingCooldownError.new(expires_at)
+    end
+
+    def recent_message_count(now)
+      messages.where(created_at: (now - MESSAGE_WINDOW)..now).count
+    end
+
+    def suspend_without_lock!(reason)
+      update!(status: :suspended, suspension_reason: reason)
+    end
+
     def enabled_open_room_membership?
       saved_change_to_add_to_all_open_rooms?(to: true)
     end
