diff --git a/test/models/bot_test.rb b/test/models/bot_test.rb
new file mode 100644
index 0000000..ebc8480
--- /dev/null
+++ b/test/models/bot_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class BotTest < ActiveSupport::TestCase
+  test "creates a unique bot code" do
+    first = users(:jz).bots.create!(name: "First bot")
+    second = users(:jz).bots.create!(name: "Second bot")
+
+    assert first.bot_code.present?
+    assert_not_equal first.bot_code, second.bot_code
+    assert_equal first.bot_code, first.code
+    assert_equal first.bot_code, first.token
+  end
+
+  test "requires a name and creator" do
+    bot = Bot.new
+
+    assert_not bot.valid?
+    assert bot.errors.of_kind?(:name, :blank)
+    assert bot.errors.of_kind?(:creator, :blank)
+  end
+
+  test "joins every open room when created" do
+    bot = users(:jz).bots.create!(name: "Open room bot")
+
+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+  end
+end
