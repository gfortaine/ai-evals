diff --git a/test/models/game_timer_test.rb b/test/models/game_timer_test.rb
new file mode 100644
index 0000000..145756b
--- /dev/null
+++ b/test/models/game_timer_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class GameTimerTest < ActiveSupport::TestCase
+  include ActiveSupport::Testing::TimeHelpers
+
+  test "quiz timer defaults to zero and validates minute and second values" do
+    quiz = Quiz.new(title: "Defaults")
+
+    assert_equal 0, quiz.timer_minutes
+    assert_equal 0, quiz.timer_seconds
+    assert_equal 0, quiz.timer_duration_seconds
+
+    quiz.timer_minutes = -1
+    assert_not quiz.valid?
+    quiz.timer_minutes = 1
+    quiz.timer_seconds = 60
+    assert_not quiz.valid?
+  end
+
+  test "a game snapshots the quiz timer and calculates the opened question deadline" do
+    quiz = build_quiz(timer_minutes: 1, timer_seconds: 30)
+    game = build_game(quiz)
+    opened_at = Time.zone.local(2026, 11, 22, 20, 0, 0)
+
+    travel_to(opened_at) { game.start! }
+    quiz.update!(timer_minutes: 0, timer_seconds: 0)
+
+    assert_equal 90, game.reload.timer_duration_seconds
+    assert_equal opened_at + 90.seconds, game.question_deadline
+
+    travel_to(opened_at + 30.seconds) do
+      assert_equal 60, game.timer_remaining_seconds
+      assert_equal opened_at, game.current_game_question.opened_at
+    end
+  end
+
+  test "expires a timed question exactly at its deadline and ignores later expiry calls" do
+    game = build_game(build_quiz(timer_seconds: 5))
+    opened_at = Time.zone.local(2026, 11, 22, 20, 0, 0)
+    travel_to(opened_at) { game.start! }
+
+    travel_to(opened_at + 5.seconds) do
+      assert game.expire_question_if_due!
+      assert game.reload.question_closed?
+      assert_not game.expire_question_if_due!
+    end
+  end
+
+  test "a late answer closes the question and is not saved" do
+    game = build_game(build_quiz(timer_seconds: 5))
+    opened_at = Time.zone.local(2026, 11, 22, 20, 0, 0)
+    player = game.join_player!(name: "Alice", token_digest: Player.token_digest("alice"))
+    travel_to(opened_at) { game.start! }
+    option = game.current_game_question.game_options.first
+
+    travel_to(opened_at + 5.seconds) do
+      error = assert_raises(Game::InvalidTransition) do
+        game.submit_answer!(player: player, game_option_id: option.id)
+      end
+
+      assert_equal "Time is up", error.message
+    end
+
+    assert game.reload.question_closed?
+    assert_empty player.answers.reload
+  end
+
+  test "zero timer keeps a question open and advancing starts a fresh deadline" do
+    untimed_game = build_game(build_quiz)
+    opened_at = Time.zone.local(2026, 11, 22, 20, 0, 0)
+    travel_to(opened_at) { untimed_game.start! }
+
+    travel_to(opened_at + 1.day) do
+      assert_not untimed_game.expire_question_if_due!
+      assert untimed_game.reload.question_open?
+    end
+
+    timed_game = build_game(build_quiz(timer_seconds: 10))
+    started_at = Time.zone.local(2026, 11, 22, 21, 0, 0)
+    travel_to(started_at) { timed_game.start! }
+    travel_to(started_at + 2.seconds) { timed_game.finish_question! }
+    advanced_at = started_at + 3.seconds
+    travel_to(advanced_at) { timed_game.advance! }
+
+    assert_equal advanced_at, timed_game.current_game_question.opened_at
+    assert_equal advanced_at + 10.seconds, timed_game.question_deadline
+  end
+
+  private
+
+  def build_quiz(timer_minutes: 0, timer_seconds: 0)
+    Quiz.create!(title: "Timer quiz", timer_minutes: timer_minutes, timer_seconds: timer_seconds).tap do |quiz|
+      2.times do |index|
+        question = quiz.questions.create!(text: "Question #{index + 1}", position: index + 1)
+        question.options.create!(text: "Wrong", position: 1, correct: false)
+        question.options.create!(text: "Right", position: 2, correct: true)
+      end
+    end
+  end
+
+  def build_game(quiz)
+    Game.create_from!(quiz: quiz) { |code| "http://example.test/play/#{code}" }
+  end
+end
