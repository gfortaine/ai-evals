--- /dev/null
+++ b/test/models/game_prizes_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class GamePrizesTest < ActiveSupport::TestCase
+  test "defaults and validates the number of winners" do
+    quiz = Quiz.new(title: "Prizes")
+
+    assert_equal 3, quiz.number_of_winners
+    assert quiz.valid?
+
+    quiz.number_of_winners = 0
+    assert_not quiz.valid?
+  end
+
+  test "ranks equal scores by the total time of the last correct picks" do
+    game = build_game
+    alice = join_player(game, "Alice")
+    bob = join_player(game, "Bob")
+    zero = join_player(game, "Zero")
+    opened_at = Time.current.change(usec: 0)
+
+    travel_to opened_at do
+      game.start!
+    end
+
+    first_question = game.current_game_question
+    first_right = first_question.game_options.find_by!(correct: true)
+    first_wrong = first_question.game_options.find_by!(correct: false)
+
+    travel_to(opened_at + 0.4.seconds, with_usec: true) { answer(game, bob, first_right) }
+    travel_to(opened_at + 0.5.seconds, with_usec: true) { answer(game, alice, first_wrong) }
+    travel_to(opened_at + 1.4.seconds, with_usec: true) do
+      last_pick = answer(game, alice, first_right)
+      assert_equal 1_400, last_pick.response_time_ms
+    end
+
+    game.finish_question!
+    second_opened_at = opened_at + 10.seconds
+    travel_to(second_opened_at, with_usec: true) { game.advance! }
+
+    second_question = game.current_game_question
+    second_right = second_question.game_options.find_by!(correct: true)
+    travel_to(second_opened_at + 0.2.seconds, with_usec: true) { answer(game, alice, second_right) }
+    travel_to(second_opened_at + 2.5.seconds, with_usec: true) { answer(game, bob, second_right) }
+    game.finish_question!
+    game.advance!
+
+    assert_equal 2, alice.reload.points
+    assert_equal 2, bob.reload.points
+    assert_equal 1_600, alice.total_correct_answer_time_ms
+    assert_equal 2_900, bob.total_correct_answer_time_ms
+    assert_equal [ alice.id, bob.id, zero.id ], game.leaderboard.map(&:id)
+  end
+
+  test "top and drawn winners exclude zero scores and reset cleanly" do
+    game = build_game
+    first_question = game.game_questions.first
+    second_question = game.game_questions.second
+    leader = join_player(game, "Leader")
+    tied = %w[One Two Three].map { |name| join_player(game, name) }
+    zero = join_player(game, "Zero")
+    game.update!(status: :finished, finished_at: Time.current)
+
+    correct_answer(leader, first_question, 100)
+    correct_answer(leader, second_question, 100)
+    tied.each_with_index { |player, index| correct_answer(player, first_question, 200 + index) }
+
+    game.select_top_winners!
+    assert_equal [ leader.name, "One" ], winner_names(game)
+
+    game.draw_winners!
+    winners = winner_names(game)
+    assert_includes winners, leader.name
+    assert_equal 1, (winners & tied.map(&:name)).length
+    assert_not_includes winners, zero.name
+    assert_equal 2, winners.length
+
+    game.reset_winners!
+    assert_empty winner_names(game)
+
+    game.update!(number_of_winners: 5)
+    game.draw_winners!
+    assert_equal %w[Leader One Three Two].sort, winner_names(game).sort
+  end
+
+  private
+
+  def build_game(number_of_winners: 2)
+    quiz = Quiz.create!(title: "Prize quiz", number_of_winners: number_of_winners)
+    2.times do |index|
+      question = quiz.questions.create!(text: "Question #{index + 1}", position: index + 1)
+      question.options.create!(text: "Wrong", position: 1, correct: false)
+      question.options.create!(text: "Right", position: 2, correct: true)
+    end
+
+    Game.create_from!(quiz: quiz) { |code| "http://example.test/play/#{code}" }.tap do |game|
+      assert_equal number_of_winners, game.number_of_winners
+    end
+  end
+
+  def join_player(game, name)
+    game.join_player!(name: name, token_digest: Player.token_digest(name))
+  end
+
+  def answer(game, player, option)
+    game.submit_answer!(player: player, game_option_id: option.id)
+  end
+
+  def correct_answer(player, game_question, response_time_ms)
+    player.answers.create!(
+      game_question: game_question,
+      game_option: game_question.game_options.find_by!(correct: true),
+      response_time_ms: response_time_ms
+    )
+  end
+
+  def winner_names(game)
+    game.players.where(winner: true).order(:name).pluck(:name)
+  end
+end
