diff --git a/test/integration/prize_flow_test.rb b/test/integration/prize_flow_test.rb
new file mode 100644
index 0000000..0fa683c
--- /dev/null
+++ b/test/integration/prize_flow_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class PrizeFlowTest < ActionDispatch::IntegrationTest
+  setup do
+    @previous_username = ENV["QUIZZY_MODERATOR_USERNAME"]
+    @previous_password = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "secret"
+    @authorization = {
+      "Authorization" => "Basic #{Base64.strict_encode64("moderator:secret")}"
+    }
+
+    @quiz = Quiz.create!(title: "Conference prizes")
+    question = @quiz.questions.create!(text: "A winner?", position: 1)
+    question.options.create!(text: "No", correct: false, position: 1)
+    question.options.create!(text: "Yes", correct: true, position: 2)
+  end
+
+  teardown do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = @previous_username
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = @previous_password
+  end
+
+  test "shows places, scores, winners, and their controls" do
+    get edit_moderate_quiz_path(@quiz), headers: @authorization
+    assert_select "label", "Number of winners"
+    assert_select "input[name='quiz[number_of_winners]'][type=number][min='1'][value='3']"
+
+    patch moderate_quiz_path(@quiz),
+      params: { quiz: { title: @quiz.title, number_of_winners: 1 } },
+      headers: @authorization
+    post moderate_quiz_games_path(@quiz), headers: @authorization
+    game = @quiz.games.last
+
+    alice = open_session
+    alice.post join_play_game_path(code: game.code), params: { player: { name: "Alice" } }
+    bob = open_session
+    bob.post join_play_game_path(code: game.code), params: { player: { name: "Bob" } }
+
+    patch start_moderate_game_path(game), headers: @authorization
+    correct_option = game.current_game_question.game_options.find_by!(correct: true)
+    alice.post play_answer_path(code: game.code), params: { game_option_id: correct_option.id }
+    patch finish_moderate_game_path(game), headers: @authorization
+    patch advance_moderate_game_path(game), headers: @authorization
+
+    get moderate_game_path(game), headers: @authorization
+    assert_select "ol.leaderboard > li", count: 2 do |rows|
+      assert_match(/Alice/, rows.first.text)
+      assert_match(/1 point/, rows.first.text)
+      assert_match(/Bob/, rows[1].text)
+      assert_match(/0 points/, rows[1].text)
+    end
+    assert_select "button", "Top 1"
+    assert_select "button", "Draw"
+    assert_select "button", "Reset winners"
+
+    alice.get play_game_path(code: game.code)
+    assert_includes alice.response.body, "Place 1 of 2"
+    assert_includes alice.response.body, "1 point"
+    bob.get play_game_path(code: game.code)
+    assert_includes bob.response.body, "Place 2 of 2"
+    assert_includes bob.response.body, "0 points"
+    assert_not_includes alice.response.body, "You won!"
+
+    patch top_winners_moderate_game_path(game), headers: @authorization
+    assert game.players.find_by!(name: "Alice").reload.winner?
+    assert_not game.players.find_by!(name: "Bob").winner?
+
+    get moderate_game_path(game), headers: @authorization
+    assert_select "ol.leaderboard > li.is-winner", count: 1 do |rows|
+      assert_match(/Alice/, rows.first.text)
+      assert_match(/Winner/, rows.first.text)
+      assert_match(/1 point/, rows.first.text)
+    end
+    alice.get play_game_path(code: game.code)
+    assert_includes alice.response.body, "You won!"
+
+    patch reset_winners_moderate_game_path(game), headers: @authorization
+    assert_not game.players.where(winner: true).exists?
+    alice.get play_game_path(code: game.code)
+    assert_not_includes alice.response.body, "You won!"
+  end
+end
diff --git a/test/models/game_prizes_test.rb b/test/models/game_prizes_test.rb
