+module GamesHelper
+  def qr_code_svg(url)
+    module_size = 10
+    offset = module_size * 4
+    code = RQRCode::QRCode.new(url)
+    width = (code.modules.length * module_size) + (offset * 2)
+    path = code.as_svg(
+      color: "2a12c9",
+      module_size: module_size,
+      offset: offset,
+      shape_rendering: "crispEdges",
+      standalone: false,
+      use_path: true,
+      viewbox: true
+    )
+
+    tag.svg(
+      xmlns: "http://www.w3.org/2000/svg",
+      viewBox: "0 0 #{width} #{width}",
+      shape_rendering: "crispEdges"
+    ) { path.html_safe }
+  end
+end
diff --git a/app/javascript/controllers/live_game_controller.js b/app/javascript/controllers/live_game_controller.js
new file mode 100644
index 0000000..b4f7a84
--- /dev/null
+++ b/app/javascript/controllers/live_game_controller.js
@@ -0,0 +1,74 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { url: String }
+
+  connect() {
+    this.refresh = this.refresh.bind(this)
+    this.refreshWhenDisconnected = this.refreshWhenDisconnected.bind(this)
+    this.observeSubscription()
+    this.refreshTimer = window.setInterval(this.refreshWhenDisconnected, 20000)
+  }
+
+  disconnect() {
+    window.clearInterval(this.refreshTimer)
+    this.subscriptionObserver?.disconnect()
+    this.request?.abort()
+  }
+
+  observeSubscription() {
+    const source = this.element.querySelector("turbo-cable-stream-source")
+    if (!source) return
+
+    this.subscriptionEstablished = source.hasAttribute("connected")
+    this.subscriptionConnected = this.subscriptionEstablished
+    this.subscriptionObserver = new MutationObserver(() => {
+      const connected = source.hasAttribute("connected")
+      if (connected && this.subscriptionEstablished && !this.subscriptionConnected) this.refresh()
+      if (connected) this.subscriptionEstablished = true
+      this.subscriptionConnected = connected
+    })
+    this.subscriptionObserver.observe(source, { attributes: true, attributeFilter: ["connected"] })
+  }
+
+  refreshWhenDisconnected() {
+    if (!this.subscriptionConnected) this.refresh()
+  }
+
+  async refresh() {
+    if (document.hidden || !this.urlValue) return
+
+    this.request?.abort()
+    this.request = new AbortController()
+    const headers = { Accept: "text/vnd.turbo-stream.html" }
+    if (this.etag) headers["If-None-Match"] = this.etag
+
+    try {
+      const response = await fetch(this.urlValue, {
+        headers,
+        credentials: "same-origin",
+        signal: this.request.signal,
+        cache: "no-store"
+      })
+
+      if (response.status === 304) return
+      if (!response.ok) throw new Error(`Live update failed (${response.status})`)
+
+      this.etag = response.headers.get("ETag") || this.etag
+      const nameInput = this.element.querySelector("input[name='player[name]']")
+      const enteredName = nameInput?.value
+      const restoreFocus = nameInput === document.activeElement
+      window.Turbo.renderStreamMessage(await response.text())
+
+      if (enteredName) {
+        const replacement = this.element.querySelector("input[name='player[name]']")
+        if (replacement) {
+          replacement.value = enteredName
+          if (restoreFocus) replacement.focus()
+        }
+      }
+    } catch (error) {
+      if (error.name !== "AbortError") console.warn(error.message)
+    }
+  }
+}
