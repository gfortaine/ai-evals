+module Play
+  class AnswersController < ApplicationController
+    before_action :set_game
+    before_action :set_player
+
+    def create
+      @game.submit_answer!(player: @player, game_option_id: params.require(:game_option_id))
+      @game.touch
+      LiveGameBroadcaster.moderator(@game)
+      LiveGameBroadcaster.player(@game, @player)
+
+      respond_to do |format|
+        format.html { redirect_to play_game_path(code: @game.code), status: :see_other }
+        format.turbo_stream do
+          render turbo_stream: turbo_stream.replace(
+            "player_game_#{@game.id}",
+            partial: "play/games/game",
+            locals: { game: @game.reload, player: @player.reload }
+          )
+        end
+      end
+    rescue Game::InvalidTransition => error
+      @game.reload
+
+      respond_to do |format|
+        format.html { redirect_to play_game_path(code: @game.code), alert: error.message, status: :see_other }
+        format.turbo_stream do
+          render turbo_stream: turbo_stream.replace(
+            "player_game_#{@game.id}",
+            partial: "play/games/game",
+            locals: { game: @game, player: @player.reload }
+          ), status: :conflict
+        end
+      end
+    end
+
+    private
+
+    def set_game
+      @game = Game.includes(game_questions: :game_options).find_by!(code: params[:code].to_s.upcase)
+    end
+
+    def set_player
+      token = cookies.encrypted[:quizzy_player_token]
+      @player = @game.players.find_by(token_digest: Player.token_digest(token)) if token.present?
+      redirect_to play_game_path(code: @game.code), status: :see_other unless @player
+    end
+  end
+end
diff --git a/app/controllers/play/games_controller.rb b/app/controllers/play/games_controller.rb
new file mode 100644
index 0000000..b056097
--- /dev/null
+++ b/app/controllers/play/games_controller.rb
@@ -0,0 +1,68 @@
+module Play
+  class GamesController < ApplicationController
+    before_action :set_game
+
+    def show
+      load_player
+      @join_player ||= Player.new
+    end
+
+    def join
+      token = player_session_token
+      digest = Player.token_digest(token)
+
+      @player = @game.join_player!(name: player_params[:name], token_digest: digest)
+      @game.touch
+      LiveGameBroadcaster.moderator(@game)
+      redirect_to play_game_path(code: @game.code), status: :see_other
+    rescue Game::InvalidTransition => error
+      redirect_to play_game_path(code: @game.code), alert: error.message, status: :see_other
+    rescue ActiveRecord::RecordInvalid
+      @player = nil
+      @join_player = Player.new(player_params)
+      @join_player.valid?
+      render :show, status: :unprocessable_content
+    end
+
+    def state
+      load_player
+      @join_player ||= Player.new
+
+      etag = [ @game.status, @game.current_question_index, @game.finished_at, @player&.updated_at ]
+      return unless stale?(etag: etag, last_modified: @game.updated_at, public: false)
+
+      render turbo_stream: turbo_stream.replace(
+        "player_game_#{@game.id}",
+        partial: "play/games/game",
+        locals: { game: @game, player: @player }
+      )
+    end
+
+    private
+
+    def set_game
+      @game = Game.includes(game_questions: :game_options).find_by!(code: params[:code].to_s.upcase)
+    end
+
+    def load_player
+      token = cookies.encrypted[:quizzy_player_token]
+      return if token.blank?
+
+      @player = @game.players.find_by(token_digest: Player.token_digest(token))
+    end
+
+    def player_session_token
+      cookies.encrypted[:quizzy_player_token].presence || SecureRandom.hex(32).tap do |token|
+        cookies.encrypted.permanent[:quizzy_player_token] = {
+          value: token,
+          httponly: true,
+          same_site: :lax
+        }
+      end
+    end
+
+    def player_params
+      params.require(:player).permit(:name)
+    end
+  end
+end
