diff --git a/app/views/play/games/_game.html.erb b/app/views/play/games/_game.html.erb
new file mode 100644
index 0000000..078550e
--- /dev/null
+++ b/app/views/play/games/_game.html.erb
@@ -0,0 +1,90 @@
+<% join_player ||= Player.new %>
+<div id="player_game_<%= game.id %>" class="play">
+  <div class="play__top">
+    <div class="logo play__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</div>
+    <% if player %><span>Hi, <%= player.name %>!</span><% end %>
+  </div>
+
+  <div class="play__body <%= "play__body--top" unless game.waiting? %>">
+    <% if game.finished? %>
+      <section class="waiting" aria-live="polite">
+        <div class="waiting__gem" aria-hidden="true">✓</div>
+        <h1 class="play-title">The quiz is over</h1>
+        <p class="play-lead">Thanks for playing <%= game.title %>.</p>
+      </section>
+    <% elsif player.nil? %>
+      <section>
+        <div class="screen__kicker"><%= game.title %></div>
+        <h1 class="play-title">Join the quiz</h1>
+        <p class="play-lead">Choose a name and you're in.</p>
+
+        <%= form_with model: join_player, url: join_play_game_path(code: game.code), scope: :player, class: "join-form" do |form| %>
+          <% if join_player.errors.any? %>
+            <div class="errors" role="alert">
+              <ul><% join_player.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
+            </div>
+          <% end %>
+
+          <div class="field">
+            <%= form.label :name, "Your name" %>
+            <%= form.text_field :name, class: "input", maxlength: 80, autocomplete: "nickname", required: true, autofocus: true %>
+          </div>
+          <%= form.submit "Join", class: "btn btn--pink" %>
+        <% end %>
+      </section>
+    <% elsif game.waiting? %>
+      <section class="waiting" aria-live="polite">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h1 class="play-title">You're in!</h1>
+        <p class="play-lead">Wait for the quiz to start.</p>
+        <div class="badge"><%= game.title %></div>
+      </section>
+    <% else %>
+      <% question = game.current_game_question %>
+      <% answer = player.answers.find_by(game_question: question) %>
+
+      <section class="play-question" aria-labelledby="player_question_text">
+        <div class="play-question__num">Question <%= game.current_question_index + 1 %> of <%= game.game_questions.count %></div>
+        <h1 class="play-question__body" id="player_question_text"><%= question.text %></h1>
+
+        <% if game.question_open? %>
+          <ul class="play-options">
+            <% question.game_options.each_with_index do |option, index| %>
+              <% selected = answer&.game_option_id == option.id %>
+              <li>
+                <%= button_to play_answer_path(code: game.code), params: { game_option_id: option.id },
+                    method: :post, class: "play-option #{"is-picked" if selected}",
+                    aria: { pressed: selected, label: option.text } do %>
+                  <span class="play-option__letter"><%= (65 + index).chr %></span>
+                  <span class="play-option__title"><%= option.text %></span>
+                  <% if selected %><span class="play-option__mark">Your answer</span><% end %>
+                <% end %>
+              </li>
+            <% end %>
+          </ul>
+        <% else %>
+          <ul class="play-options is-locked is-revealed">
+            <% question.game_options.each_with_index do |option, index| %>
+              <% selected = answer&.game_option_id == option.id %>
+              <li>
+                <div class="play-option <%= "is-picked" if selected %> <%= "is-correct" if option.correct? %>">
+                  <span class="play-option__letter"><%= (65 + index).chr %></span>
+                  <span class="play-option__title"><%= option.text %></span>
+                  <% if selected %><span class="play-option__mark">Your answer</span><% end %>
+                </div>
+              </li>
+            <% end %>
+          </ul>
+
+          <% if answer.nil? %>
+            <div class="play-status play-status--neutral" role="status">No answer</div>
+          <% elsif answer.game_option.correct? %>
+            <div class="play-status play-status--right" role="status">Correct!</div>
+          <% else %>
+            <div class="play-status play-status--wrong" role="status">Wrong!</div>
+          <% end %>
+        <% end %>
+      </section>
+    <% end %>
+  </div>
+</div>
