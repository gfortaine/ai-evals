+require "test_helper"
+
+class LiveGameFlowTest < ActionDispatch::IntegrationTest
+  setup do
+    @previous_username = ENV["QUIZZY_MODERATOR_USERNAME"]
+    @previous_password = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "secret"
+    @authorization = {
+      "Authorization" => "Basic #{Base64.strict_encode64("moderator:secret")}"
+    }
+
+    @quiz = Quiz.create!(title: "Live conference quiz")
+    @first = question("First active", position: 1, correct: "Ruby")
+    question("Skipped", position: 2, active: false, correct: "Rails")
+    @second = question("Second active", position: 3, correct: "Yes")
+  end
+
+  teardown do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = @previous_username
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = @previous_password
+  end
+
+  test "plays a repeatable game from lobby through final results" do
+    get moderate_quiz_path(@quiz), headers: @authorization
+    assert_select "button", "Start a game"
+
+    post moderate_quiz_games_path(@quiz), headers: @authorization
+    game = @quiz.games.order(:id).last
+    assert_redirected_to moderate_game_path(game)
+
+    get moderate_game_path(game), headers: @authorization
+    assert_response :success
+    assert_select ".lobby__url", "#{game.join_url}"
+    assert_select ".qr svg", count: 1
+    assert_select ".counter-pill", /Players: 0/
+    assert_select "button", "Start"
+
+    alice = open_session
+    alice.get play_game_path(code: game.code)
+    assert_includes alice.response.body, "Your name"
+    alice.post join_play_game_path(code: game.code), params: { player: { name: "Alice" } }
+    alice.get play_game_path(code: game.code)
+    assert_includes alice.response.body, "Hi, Alice!"
+
+    bob = open_session
+    bob.post join_play_game_path(code: game.code), params: { player: { name: "Bob" } }
+
+    get moderate_game_path(game), headers: @authorization
+    assert_select ".counter-pill", /Players: 2/
+
+    patch start_moderate_game_path(game), headers: @authorization
+    assert_redirected_to moderate_game_path(game)
+
+    alice.get play_game_path(code: game.code)
+    assert_includes alice.response.body, "Question 1 of 2"
+    assert_includes alice.response.body, @first.text
+    assert_not_includes alice.response.body, "is-correct"
+    assert_not_includes alice.response.body, "data-correct"
+
+    wrong = game.current_game_question.game_options.find_by!(correct: false)
+    right = game.current_game_question.game_options.find_by!(correct: true)
+    alice.post play_answer_path(code: game.code), params: { game_option_id: wrong.id }
+    alice.post play_answer_path(code: game.code), params: { game_option_id: right.id }
+    alice.get play_game_path(code: game.code)
+    assert_includes alice.response.body, "Your answer"
+    assert_equal right.id, game.players.find_by!(name: "Alice").answers.first.game_option_id
+
+    get moderate_game_path(game), headers: @authorization
+    assert_select ".answers-counter", "Answers: 1 / 2"
+
+    patch finish_moderate_game_path(game), headers: @authorization
+    alice.get play_game_path(code: game.code)
+    assert_includes alice.response.body, "Correct!"
+    bob.get play_game_path(code: game.code)
+    assert_includes bob.response.body, "No answer"
+
+    get moderate_game_path(game), headers: @authorization
+    assert_select ".stage-option.is-correct .stage-option__mark", "Correct"
+    assert_select "button", "Next"
+
+    patch advance_moderate_game_path(game), headers: @authorization
+    assert_equal 1, game.reload.current_question_index
+    get moderate_game_path(game), headers: @authorization
+    assert_select ".stage-question__num", "Question 2 of 2"
+    assert_includes response.body, @second.text
+
+    patch finish_moderate_game_path(game), headers: @authorization
+    get moderate_game_path(game), headers: @authorization
+    assert_select "button", "End quiz"
+    patch advance_moderate_game_path(game), headers: @authorization
+
+    assert game.reload.finished?
+    alice.get play_game_path(code: game.code)
+    assert_includes alice.response.body, "The quiz is over"
+
+    newcomer = open_session
+    newcomer.get play_game_path(code: game.code)
+    assert_includes newcomer.response.body, "The quiz is over"
+    assert_not_includes newcomer.response.body, "Your name"
+    assert_not_includes newcomer.response.body, ">Join<"
+  end
+
+  test "creates a fresh player set for every game" do
+    post moderate_quiz_games_path(@quiz), headers: @authorization
+    first_game = @quiz.games.last
+    post moderate_quiz_games_path(@quiz), headers: @authorization
+    second_game = @quiz.games.last
+
+    assert_not_equal first_game.code, second_game.code
+
+    player = open_session
+    player.post join_play_game_path(code: first_game.code), params: { player: { name: "Alice" } }
+    player.post join_play_game_path(code: second_game.code), params: { player: { name: "Alice again" } }
+
+    assert_equal [ "Alice" ], first_game.players.pluck(:name)
+    assert_equal [ "Alice again" ], second_game.players.pluck(:name)
+  end
+
+  private
+
+  def question(text, position:, active: true, correct:)
+    @quiz.questions.create!(text: text, active: active, position: position).tap do |record|
+      record.options.create!(text: "#{correct} no", correct: false, position: 1)
+      record.options.create!(text: correct, correct: true, position: 2)
+    end
+  end
+end
