diff --git a/app/views/moderate/games/_game.html.erb b/app/views/moderate/games/_game.html.erb
new file mode 100644
index 0000000..b4633b2
--- /dev/null
+++ b/app/views/moderate/games/_game.html.erb
@@ -0,0 +1,83 @@
+<% question = game.current_game_question %>
+<% answer_counts = question&.answer_counts || {} %>
+<% player_count = game.players.count %>
+
+<div id="moderator_game_<%= game.id %>" class="screen cover cover--night">
+  <div class="screen__top">
+    <%= link_to moderate_quiz_path(game.quiz), class: "logo screen__logo", aria: { label: "Back to #{game.title}" } do %>
+      <span class="logo__mark" aria-hidden="true">?</span>Quizzy
+    <% end %>
+    <span><%= game.title %></span>
+  </div>
+
+  <% if game.waiting? %>
+    <div class="screen__body">
+      <section class="lobby">
+        <div>
+          <div class="screen__kicker">Join the quiz</div>
+          <h1 class="lobby__title"><%= game.title %></h1>
+          <div class="lobby__join">Open this link</div>
+          <div class="lobby__url"><%= game.join_url %></div>
+          <div class="counter-pill">Players: <strong><%= player_count %></strong></div>
+        </div>
+        <div class="qr" role="img" aria-label="QR code for <%= game.join_url %>">
+          <%= qr_code_svg(game.join_url) %>
+        </div>
+      </section>
+    </div>
+  <% elsif game.finished? %>
+    <div class="screen__body">
+      <section class="game-over">
+        <div class="screen__kicker">That's a wrap</div>
+        <h1>The quiz is over</h1>
+      </section>
+    </div>
+  <% else %>
+    <div class="screen__body">
+      <section class="stage-question" aria-labelledby="stage_question_text">
+        <div class="stage-question__num">Question <%= game.current_question_index + 1 %> of <%= game.game_questions.count %></div>
+        <h1 class="stage-question__body" id="stage_question_text"><%= question.text %></h1>
+
+        <% if game.question_open? %>
+          <ul class="stage-options">
+            <% question.game_options.each_with_index do |option, index| %>
+              <li class="stage-option">
+                <span class="stage-option__letter"><%= (65 + index).chr %></span>
+                <span class="stage-option__title"><%= option.text %></span>
+              </li>
+            <% end %>
+          </ul>
+          <div class="counter-pill answers-counter">Answers: <%= question.answers.count %> / <%= player_count %></div>
+        <% else %>
+          <ul class="stage-options stage-options--results">
+            <% question.game_options.each_with_index do |option, index| %>
+              <% count = answer_counts.fetch(option.id, 0) %>
+              <% share = player_count.positive? ? (count.to_f / player_count * 100) : 0 %>
+              <li class="stage-option <%= "is-correct" if option.correct? %>" style="--share: <%= share %>%">
+                <span class="stage-option__bar" aria-hidden="true"></span>
+                <span class="stage-option__letter"><%= (65 + index).chr %></span>
+                <span class="stage-option__title"><%= option.text %></span>
+                <span class="stage-option__count"><%= count %></span>
+                <% if option.correct? %><span class="stage-option__mark">Correct</span><% end %>
+              </li>
+            <% end %>
+          </ul>
+        <% end %>
+      </section>
+    </div>
+  <% end %>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "Back to quiz", moderate_quiz_path(game.quiz) %>
+      <% unless game.waiting? %><span>Players: <%= player_count %></span><% end %>
+    </div>
+    <% if game.waiting? %>
+      <%= button_to "Start", start_moderate_game_path(game), method: :patch, class: "btn btn--pink btn--lg" %>
+    <% elsif game.question_open? %>
+      <%= button_to "Finish", finish_moderate_game_path(game), method: :patch, class: "btn btn--pink btn--lg" %>
+    <% elsif game.question_closed? %>
+      <%= button_to(game.last_question? ? "End quiz" : "Next", advance_moderate_game_path(game), method: :patch, class: "btn btn--pink btn--lg") %>
+    <% end %>
+  </div>
+</div>
