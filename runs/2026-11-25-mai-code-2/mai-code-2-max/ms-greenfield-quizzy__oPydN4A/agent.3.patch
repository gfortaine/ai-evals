diff --git a/app/services/live_game_broadcaster.rb b/app/services/live_game_broadcaster.rb
new file mode 100644
index 0000000..684eec4
--- /dev/null
+++ b/app/services/live_game_broadcaster.rb
@@ -0,0 +1,34 @@
+class LiveGameBroadcaster
+  MODERATOR_STREAM_KEY = "moderator".freeze
+
+  class << self
+    def moderator(game)
+      Turbo::StreamsChannel.broadcast_replace_to(
+        [ game, MODERATOR_STREAM_KEY ],
+        target: "moderator_game_#{game.id}",
+        partial: "moderate/games/game",
+        locals: { game: game.reload }
+      )
+    end
+
+    def player(game, player)
+      Turbo::StreamsChannel.broadcast_replace_to(
+        [ game, player ],
+        target: "player_game_#{game.id}",
+        partial: "play/games/game",
+        locals: { game: game.reload, player: player.reload }
+      )
+    end
+
+    def all_players(game)
+      game.players.find_each do |player|
+        player(game, player)
+      end
+    end
+
+    def transition(game)
+      moderator(game)
+      all_players(game)
+    end
+  end
+end
