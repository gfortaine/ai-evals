index 0000000..269d14a
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,83 @@
+module Moderate
+  class GamesController < BaseController
+    layout "live"
+
+    before_action :set_quiz, only: :create
+    before_action :set_game, except: :create
+
+    def show
+    end
+
+    def create
+      if @quiz.active_questions.none?
+        redirect_to moderate_quiz_path(@quiz), alert: "Add an active question before starting a game"
+        return
+      end
+
+      game = Game.create_from!(quiz: @quiz) do |code|
+        "#{request.base_url}#{play_game_path(code: code)}"
+      end
+
+      redirect_to moderate_game_path(game)
+    end
+
+    def start
+      transition_game(&:start!)
+    end
+
+    def finish
+      transition_game(&:finish_question!)
+    end
+
+    def advance
+      transition_game(&:advance!)
+    end
+
+    def state
+      return unless stale?(etag: @game, last_modified: @game.updated_at, public: false)
+
+      render turbo_stream: turbo_stream.replace(
+        "moderator_game_#{@game.id}",
+        partial: "moderate/games/game",
+        locals: { game: @game }
+      )
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_game
+      @game = Game.includes(game_questions: :game_options).find_by!(code: params[:id].to_s.upcase)
+    end
+
+    def transition_game
+      yield @game
+      LiveGameBroadcaster.transition(@game)
+
+      respond_to do |format|
+        format.html { redirect_to moderate_game_path(@game) }
+        format.turbo_stream do
+          render turbo_stream: turbo_stream.replace(
+            "moderator_game_#{@game.id}",
+            partial: "moderate/games/game",
+            locals: { game: @game.reload }
+          )
+        end
+      end
+    rescue Game::InvalidTransition => error
+      respond_to do |format|
+        format.html { redirect_to moderate_game_path(@game), alert: error.message }
+        format.turbo_stream do
+          render turbo_stream: turbo_stream.replace(
+            "moderator_game_#{@game.id}",
+            partial: "moderate/games/game",
+            locals: { game: @game.reload }
+          ), status: :conflict
+        end
+      end
+    end
+  end
+end
