+class Answer < ApplicationRecord
+  belongs_to :player, touch: true
+  belongs_to :game_question
+  belongs_to :game_option
+
+  validates :game_question_id, uniqueness: { scope: :player_id }
+  validate :option_belongs_to_question
+  validate :player_belongs_to_game
+
+  private
+
+  def option_belongs_to_question
+    return if game_option.nil? || game_option.game_question_id == game_question_id
+
+    errors.add(:game_option, "does not belong to the question")
+  end
+
+  def player_belongs_to_game
+    return if player.nil? || game_question.nil? || player.game_id == game_question.game_id
+
+    errors.add(:player, "does not belong to the game")
+  end
+end
diff --git a/app/models/game.rb b/app/models/game.rb
new file mode 100644
index 0000000..29260d9
--- /dev/null
+++ b/app/models/game.rb
@@ -0,0 +1,135 @@
+class Game < ApplicationRecord
+  CODE_ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789".freeze
+  CODE_LENGTH = 5
+
+  class InvalidTransition < StandardError; end
+
+  belongs_to :quiz
+  has_many :game_questions, -> { order(:position, :id) }, dependent: :destroy
+  has_many :players, -> { order(:created_at, :id) }, dependent: :destroy
+
+  enum :status, {
+    waiting: "waiting",
+    question_open: "question_open",
+    question_closed: "question_closed",
+    finished: "finished"
+  }, validate: true
+
+  validates :title, :code, :join_url, presence: true
+  validates :code, uniqueness: true, format: { with: /\A[A-Z2-9]{#{CODE_LENGTH}}\z/ }
+  validates :current_question_index, numericality: { greater_than_or_equal_to: 0 }
+
+  before_validation :assign_code, on: :create
+
+  def self.create_from!(quiz:)
+    raise ArgumentError, "A join URL builder is required" unless block_given?
+
+    transaction do
+      active_questions = quiz.active_questions.includes(:options).to_a
+      raise ActiveRecord::RecordInvalid.new(Game.new), "A game needs an active question" if active_questions.empty?
+
+      game = quiz.games.build(title: quiz.title)
+      game.assign_code
+      game.join_url = yield(game.code)
+      game.save!
+      game.snapshot_questions!(active_questions)
+      game
+    end
+  end
+
+  def to_param
+    code
+  end
+
+  def snapshot_questions!(questions)
+    questions.each_with_index do |question, index|
+      snapshot = game_questions.create!(
+        source_question_id: question.id,
+        text: question.text,
+        position: index + 1
+      )
+
+      question.options.each do |option|
+        snapshot.game_options.create!(
+          text: option.text,
+          correct: option.correct?,
+          position: option.position
+        )
+      end
+    end
+  end
+
+  def current_game_question
+    game_questions.find_by(position: current_question_index + 1)
+  end
+
+  def last_question?
+    current_question_index >= game_questions.count - 1
+  end
+
+  def start!
+    with_lock do
+      ensure_status!(:waiting)
+      update!(status: :question_open, started_at: Time.current)
+    end
+  end
+
+  def finish_question!
+    with_lock do
+      ensure_status!(:question_open)
+      update!(status: :question_closed)
+    end
+  end
+
+  def advance!
+    with_lock do
+      ensure_status!(:question_closed)
+
+      if last_question?
+        update!(status: :finished, finished_at: Time.current)
+      else
+        update!(status: :question_open, current_question_index: current_question_index + 1)
+      end
+    end
+  end
+
+  def join_player!(name:, token_digest:)
+    with_lock do
+      raise InvalidTransition, "The quiz is over" if finished?
+
+      player = players.find_by(token_digest: token_digest)
+      player || players.create!(name: name.to_s.strip, token_digest: token_digest)
+    end
+  end
+
+  def submit_answer!(player:, game_option_id:)
+    with_lock do
+      ensure_status!(:question_open)
+
+      question = current_game_question
+      option = question.game_options.find(game_option_id)
+      raise ActiveRecord::RecordNotFound unless player.game_id == id
+
+      answer = player.answers.find_or_initialize_by(game_question: question)
+      answer.update!(game_option: option)
+      answer
+    end
+  end
+
+  def assign_code
+    return if code.present?
+
+    loop do
+      self.code = Array.new(CODE_LENGTH) { CODE_ALPHABET[SecureRandom.random_number(CODE_ALPHABET.length)] }.join
+      break unless self.class.exists?(code: code)
+    end
+  end
+
+  private
+
+  def ensure_status!(expected_status)
+    return if status == expected_status.to_s
+
+    raise InvalidTransition, "Cannot change a #{status} game to this state"
+  end
+end
