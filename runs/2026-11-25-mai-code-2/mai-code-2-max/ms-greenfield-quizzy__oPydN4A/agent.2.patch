+<% content_for :title, "Import quiz · Quizzy" %>
+
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<div class="page-head"><h1>Import quiz</h1></div>
+
+<div class="card form-card">
+  <% if @quiz_import.errors.any? %>
+    <div class="errors" role="alert">
+      <ul>
+        <% @quiz_import.errors.full_messages.each do |message| %>
+          <li><%= message %></li>
+        <% end %>
+      </ul>
+    </div>
+  <% end %>
+
+  <%= form_with scope: :quiz_import, url: import_moderate_quizzes_path, method: :post do |form| %>
+    <div class="field">
+      <%= form.label :quiz_json, "Quiz JSON" %>
+      <%= form.text_area :quiz_json, value: @quiz_import.quiz_json, class: "input input--json",
+          rows: 18, required: true, autofocus: true, spellcheck: false %>
+    </div>
+
+    <div class="buttons">
+      <%= form.submit "Import", class: "btn btn--pink" %>
+      <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+    </div>
+  <% end %>
+</div>
