+++ b/test/models/quiz_import_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class QuizImportTest < ActiveSupport::TestCase
+  test "creates a new quiz with defaults and preserves question and option order" do
+    Quiz.create!(title: "Frontend Fest 2026")
+    payload = {
+      title: "Frontend Fest 2026",
+      questions: [
+        {
+          text: "First question",
+          options: [
+            { text: "Wrong" },
+            { text: "Right", correct: true }
+          ]
+        },
+        {
+          text: "Second question",
+          active: false,
+          options: [
+            { text: "B", correct: false },
+            { text: "A", correct: true }
+          ]
+        }
+      ]
+    }
+
+    quiz_import = QuizImport.new(quiz_json: JSON.generate(payload))
+
+    assert_difference -> { Quiz.where(title: payload[:title]).count }, 1 do
+      assert quiz_import.save
+    end
+
+    quiz = quiz_import.quiz
+    questions = quiz.questions.to_a
+    assert_equal [ "First question", "Second question" ], questions.map(&:text)
+    assert_equal [ 1, 2 ], questions.map(&:position)
+    assert_equal [ true, false ], questions.map(&:active?)
+    assert_equal %w[Wrong Right], questions.first.options.map(&:text)
+    assert_equal [ false, true ], questions.first.options.map(&:correct?)
+    assert_equal %w[B A], questions.second.options.map(&:text)
+  end
+
+  test "rejects a bad later question without importing anything" do
+    payload = {
+      title: "Atomic import",
+      questions: [
+        {
+          text: "Valid question",
+          options: [
+            { text: "Yes", correct: true },
+            { text: "No" }
+          ]
+        },
+        {
+          text: "Not enough options",
+          options: [
+            { text: "Only", correct: true }
+          ]
+        }
+      ]
+    }
+
+    quiz_import = QuizImport.new(quiz_json: JSON.generate(payload))
+
+    counts = [ Quiz.count, Question.count, Option.count ]
+    assert_not quiz_import.save
+    assert_equal counts, [ Quiz.count, Question.count, Option.count ]
+
+    assert_includes quiz_import.errors.full_messages.join, "Add at least two options"
+  end
+
+  test "rejects malformed JSON and values with non-JSON-boolean types" do
+    malformed = QuizImport.new(quiz_json: '{"title":')
+    assert_not malformed.save
+    assert_includes malformed.errors.full_messages, "Quiz JSON is invalid"
+
+    non_text = QuizImport.new(quiz_json: [ "not", "text" ])
+    assert_not non_text.save
+    assert_includes non_text.errors.full_messages, "Quiz JSON must be text"
+
+    payload = {
+      title: "Wrong types",
+      questions: [
+        {
+          text: "Question",
+          active: "true",
+          options: [
+            { text: "Yes", correct: "true" },
+            { text: "No" }
+          ]
+        }
+      ]
+    }
+    wrong_types = QuizImport.new(quiz_json: JSON.generate(payload))
+
+    assert_not wrong_types.save
+    assert_includes wrong_types.errors.full_messages.join, "active must be true or false"
+    assert_includes wrong_types.errors.full_messages.join, "correct must be true or false"
+  end
+end
