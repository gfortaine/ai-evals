diff --git a/app/forms/quiz_import.rb b/app/forms/quiz_import.rb
new file mode 100644
index 0000000..18ff71b
--- /dev/null
+++ b/app/forms/quiz_import.rb
@@ -0,0 +1,159 @@
+class QuizImport
+  include ActiveModel::Model
+
+  attr_accessor :quiz_json
+  attr_reader :quiz
+
+  validate :payload_is_valid
+
+  def save
+    return false unless valid?
+
+    imported = false
+    Quiz.transaction do
+      @pending_quiz.save!
+
+      @pending_question_forms.each_with_index do |question_form, index|
+        unless question_form.save
+          add_errors("Question #{index + 1}", question_form.errors.full_messages)
+          raise ActiveRecord::Rollback
+        end
+      end
+
+      imported = true
+    end
+
+    return false unless imported
+
+    @quiz = @pending_quiz
+    true
+  end
+
+  private
+
+  def payload_is_valid
+    if quiz_json.blank?
+      errors.add(:base, "Quiz JSON is required")
+      return
+    end
+    unless quiz_json.is_a?(String)
+      errors.add(:base, "Quiz JSON must be text")
+      return
+    end
+
+    payload = JSON.parse(quiz_json)
+    unless payload.is_a?(Hash)
+      errors.add(:base, "Quiz JSON must be an object")
+      return
+    end
+
+    @pending_question_forms = []
+    build_pending_quiz(payload)
+    build_pending_questions(payload)
+  rescue JSON::ParserError
+    errors.add(:base, "Quiz JSON is invalid")
+  end
+
+  def build_pending_quiz(payload)
+    unless payload["title"].is_a?(String)
+      errors.add(:base, "Quiz title must be a string")
+      return
+    end
+
+    @pending_quiz = Quiz.new(title: payload["title"])
+    return if @pending_quiz.valid?
+
+    add_errors("Quiz", @pending_quiz.errors.full_messages)
+  end
+
+  def build_pending_questions(payload)
+    questions = payload["questions"]
+    unless questions.is_a?(Array)
+      errors.add(:base, "Quiz questions must be an array")
+      return
+    end
+
+    questions.each_with_index do |question, index|
+      build_pending_question(question, index)
+    end
+  end
+
+  def build_pending_question(question, index)
+    unless question.is_a?(Hash)
+      errors.add(:base, "Question #{index + 1} must be an object")
+      return
+    end
+
+    error_count = errors.count
+    text = validate_question_text(question, index)
+    active = validate_question_active(question, index)
+    options = validate_question_options(question, index)
+    return if errors.count > error_count
+
+    question_form = QuestionForm.new(
+      quiz: @pending_quiz,
+      attributes: { text:, active:, options: }
+    )
+
+    if question_form.valid?
+      @pending_question_forms << question_form
+    else
+      add_errors("Question #{index + 1}", question_form.errors.full_messages)
+    end
+  end
+
+  def validate_question_text(question, index)
+    text = question["text"]
+    errors.add(:base, "Question #{index + 1} text must be a string") unless text.is_a?(String)
+    text
+  end
+
+  def validate_question_active(question, index)
+    active = question.fetch("active", true)
+    unless boolean?(active)
+      errors.add(:base, "Question #{index + 1} active must be true or false")
+    end
+    active
+  end
+
+  def validate_question_options(question, index)
+    options = question["options"]
+    unless options.is_a?(Array)
+      errors.add(:base, "Question #{index + 1} options must be an array")
+      return
+    end
+
+    error_count = errors.count
+    rows = options.each_with_index.filter_map do |option, option_index|
+      validate_option(option, index, option_index)
+    end
+    errors.count > error_count ? nil : rows
+  end
+
+  def validate_option(option, question_index, option_index)
+    label = "Question #{question_index + 1} option #{option_index + 1}"
+    unless option.is_a?(Hash)
+      errors.add(:base, "#{label} must be an object")
+      return
+    end
+
+    error_count = errors.count
+    text = option["text"]
+    errors.add(:base, "#{label} text must be a string") unless text.is_a?(String)
+
+    correct = option.fetch("correct", false)
+    errors.add(:base, "#{label} correct must be true or false") unless boolean?(correct)
+
+    return if errors.count > error_count
+
+    { text:, correct: }
+  end
+
+  def boolean?(value)
+    value.equal?(true) || value.equal?(false)
+  end
+
+  def add_errors(label, messages)
+    messages.each { |message| errors.add(:base, "#{label}: #{message}") }
+  end
+end
