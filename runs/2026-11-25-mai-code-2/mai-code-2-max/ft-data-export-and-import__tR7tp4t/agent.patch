index 0000000..26b1663
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,89 @@
+class Export < ApplicationRecord
+  DOWNLOAD_LINK_EXPIRY = 1.day
+
+  belongs_to :account
+  belongs_to :user
+  belongs_to :exportable, polymorphic: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  after_create_commit :build_later
+
+  validate :exportable_belongs_to_account
+
+  class << self
+    def account_data(account:, requested_by:)
+      create!(account: account, user: requested_by, exportable: account)
+    end
+
+    def visible_cards(user)
+      create!(account: user.account, user: user, exportable: user)
+    end
+  end
+
+  def build_later
+    BuildJob.perform_later(self)
+  end
+
+  def build_now
+    claimed = with_lock do
+      if pending?
+        processing!
+        true
+      else
+        false
+      end
+    end
+    return unless claimed
+
+    ZipFile.create_for(file, filename: filename) do |zip|
+      data_transfer.export(zip)
+    end
+
+    update!(status: :completed, completed_at: Time.current, failure_reason: nil)
+    ExportMailer.completed(self).deliver_later
+  rescue => error
+    update!(status: :failed, failure_reason: failure_message(error))
+    Rails.error.report(error, context: { export_id: id, account_id: account_id })
+    raise
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_in: DOWNLOAD_LINK_EXPIRY)
+  end
+
+  def filename
+    label = if exportable.is_a?(Account)
+      account.name
+    else
+      "#{user.name}-cards"
+    end
+
+    "fizzy-#{label.parameterize}-#{created_at.to_date.iso8601}.zip"
+  end
+
+  def accessible_to?(candidate)
+    candidate == user
+  end
+
+  private
+    def data_transfer
+      if exportable.is_a?(Account)
+        Account::DataTransfer::Manifest.new(account)
+      else
+        Account::DataTransfer::CardExporter.new(user)
+      end
+    end
+
+    def exportable_belongs_to_account
+      unless exportable == account || exportable.try(:account) == account
+        errors.add(:exportable, "must belong to the account")
+      end
+    end
+
+    def failure_message(error)
+      error.message.to_s.truncate(4000)
+    end
+end
