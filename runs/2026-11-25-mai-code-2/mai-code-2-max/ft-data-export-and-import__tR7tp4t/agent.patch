diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..08021f7
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,486 @@
+class Account::DataTransfer::Importer
+  class InvalidArchive < StandardError; end
+
+  RECORD_JSON_LIMIT = 32.megabytes
+  MANIFEST_JSON_LIMIT = 1.megabyte
+  POLYMORPHIC_CLASSES = {
+    "Account" => ::Account,
+    "ActionText::RichText" => ::ActionText::RichText,
+    "ActiveStorage::Blob" => ::ActiveStorage::Blob,
+    "Board" => ::Board,
+    "Card" => ::Card,
+    "Comment" => ::Comment,
+    "Event" => ::Event,
+    "Mention" => ::Mention,
+    "User" => ::User
+  }.freeze
+
+  attr_reader :account, :file, :identity
+
+  def initialize(file:, identity:)
+    @file = file
+    @identity = identity
+    @uploaded_files = []
+    @remap_salt = SecureRandom.random_bytes(32)
+  end
+
+  def import
+    ZipFile.read_from(file) do |zip|
+      @zip = zip
+      validate_manifest!
+      source_account = read_source_account
+      validate_record_json!
+      stage_blobs
+
+      Account.transaction(requires_new: true) do
+        create_account(source_account)
+
+        Current.with_account(account) do
+          import_record_sets
+          importer_user = ensure_importer_access!
+
+          Current.with(user: importer_user) do
+            validate_imported_account!
+            rebuild_derived_data!
+          end
+        end
+      end
+    end
+
+    @uploaded_files.clear
+    account
+  rescue InvalidArchive
+    cleanup_uploaded_files
+    raise
+  rescue => error
+    cleanup_uploaded_files
+    raise InvalidArchive, import_error_message(error), cause: error
+  end
+
+  private
+    attr_reader :zip, :source_account
+
+    def validate_manifest!
+      if zip.exists?("manifest.json")
+        manifest = parse_json("manifest.json", limit: MANIFEST_JSON_LIMIT)
+        version = manifest["version"].to_i
+
+        unless manifest["format"] == Account::DataTransfer::Manifest::FORMAT && version.between?(1, Account::DataTransfer::Manifest::VERSION)
+          raise InvalidArchive, "This is not a Fizzy account export or its version is not supported"
+        end
+      end
+    end
+
+    def read_source_account
+      paths = zip.glob("accounts/*.json")
+      unless paths.one?
+        raise InvalidArchive, "The account export must contain exactly one account"
+      end
+
+      @source_account = parse_json(paths.first)
+      unless source_account["id"].present? && source_account["name"].present?
+        raise InvalidArchive, "The account export is missing account details"
+      end
+
+      source_account
+    end
+
+    def validate_record_json!
+      Account::DataTransfer::Manifest.new(nil).each_record_set do |record_set|
+        next if record_set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+
+        each_record(record_set) { |attributes| attributes }
+      end
+    end
+
+    def create_account(attributes)
+      @account = Account.create!(name: attributes["name"])
+
+      account.update_columns(
+        cards_count: attributes["cards_count"].to_i,
+        created_at: parse_time(attributes["created_at"]),
+        updated_at: parse_time(attributes["updated_at"])
+      )
+    end
+
+    def import_record_sets
+      Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+        next if record_set.is_a?(Account::DataTransfer::AccountRecordSet)
+        next if record_set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+        next if record_set.model == ::ActiveStorage::VariantRecord
+
+        if record_set.is_a?(Account::DataTransfer::ActiveStorage::BlobRecordSet)
+          import_blobs(record_set)
+        elsif record_set.is_a?(Account::DataTransfer::UserRecordSet)
+          import_users(record_set)
+        elsif record_set.is_a?(Account::DataTransfer::EntropyRecordSet)
+          import_entropies(record_set)
+        elsif record_set.is_a?(Account::DataTransfer::ActionText::RichTextRecordSet)
+          import_rich_texts(record_set)
+        else
+          import_records(record_set)
+        end
+      end
+
+      account.update_columns(cards_count: [ account.cards_count, account.cards.maximum(:number).to_i ].max)
+    end
+
+    def import_users(record_set)
+      each_record(record_set) do |attributes|
+        email_address = attributes.delete("identity_email_address").presence
+        attributes = mapped_attributes(User, attributes)
+        attributes["identity_id"] = identity_for(email_address, attributes["identity_id"])&.id
+        User.insert_all!([ attributes ])
+      end
+    end
+
+    def identity_for(email_address, source_identity_id)
+      if email_address.present?
+        if email_address.casecmp?(identity.email_address)
+          identity
+        else
+          Identity.create_or_find_by!(email_address: email_address)
+        end
+      elsif source_identity_id.present?
+        Identity.find_by(id: source_identity_id)
+      end
+    end
+
+    def import_entropies(record_set)
+      each_record(record_set) do |attributes|
+        attributes = mapped_attributes(Entropy, attributes)
+
+        if attributes["container_type"] == "Account" && account.entropy
+          attributes["id"] = account.entropy.id
+          account.entropy.update_columns(attributes.except("id"))
+        else
+          Entropy.insert_all!([ attributes ])
+        end
+      end
+    end
+
+    def import_blobs(record_set)
+      each_record(record_set) do |attributes|
+        import_blob(attributes)
+      end
+    end
+
+    def import_blob(attributes)
+      mapped = mapped_attributes(::ActiveStorage::Blob, attributes.except("file_path"))
+      mapped["key"] = imported_blob_key(attributes["id"])
+      mapped["service_name"] = ::ActiveStorage::Blob.service.name
+
+      ::ActiveStorage::Blob.insert_all!([ mapped ])
+    end
+
+    def stage_blobs
+      zip.glob("active_storage_blobs/*.json").each do |path|
+        stage_blob(parse_json(path))
+      end
+    end
+
+    def stage_blob(attributes)
+      file_path = blob_file_path(attributes)
+      key = imported_blob_key(attributes["id"])
+
+      service = ::ActiveStorage::Blob.service
+      @uploaded_files << [ service, key ]
+
+      zip.open(file_path) do |io|
+        unless io.size == attributes["byte_size"].to_i
+          raise InvalidArchive, "#{attributes["filename"]} has the wrong file size"
+        end
+
+        if s3_service?(service)
+          upload_to_s3(service, attributes.merge("key" => key), io)
+        else
+          service.upload(
+            key,
+            io,
+            checksum: attributes["checksum"],
+            filename: attributes["filename"],
+            content_type: attributes["content_type"]
+          )
+        end
+      end
+    end
+
+    def imported_blob_key(old_id)
+      unless old_id.present?
+        raise InvalidArchive, "A blob in the export is missing its ID"
+      end
+
+      OpenSSL::HMAC.hexdigest(OpenSSL::Digest::SHA256.new, @remap_salt, old_id.to_s)
+    end
+
+    def blob_file_path(attributes)
+      candidates = [
+        attributes["file_path"],
+        "files/#{attributes["id"]}",
+        "files/#{attributes["key"]}"
+      ].compact
+
+      candidates.find { |path| zip.exists?(path) } ||
+        zip.glob("files/#{attributes["id"]}/*").sole.presence ||
+        raise(InvalidArchive, "The export is missing a file attached to #{attributes["filename"]}")
+    rescue Enumerable::SoleItemExpectedError
+      raise InvalidArchive, "The export has ambiguous files for #{attributes["filename"]}"
+    end
+
+    def upload_to_s3(service, attributes, io)
+      part_size = [ 100.megabytes, (attributes["byte_size"].to_i.fdiv(9000)).ceil ].max
+      service.send(:upload_stream,
+        key: attributes["key"],
+        content_type: attributes["content_type"],
+        part_size: part_size
+      ) do |out|
+        IO.copy_stream(io, out)
+      end
+    end
+
+    def import_rich_texts(record_set)
+      each_record(record_set) do |attributes|
+        attachables = attributes.delete("attachables") || []
+        mapped = mapped_attributes(record_set.model, attributes)
+        mapped["body"] = rewrite_rich_text(mapped["body"], attachables)
+        record_set.model.insert_all!([ mapped ])
+      end
+    end
+
+    def rewrite_rich_text(body, attachables)
+      by_sgid = attachables.index_by { |attachable| attachable["sgid"] }
+      content = ::ActionText::Content.new(body, canonicalize: false)
+
+      content.fragment.find_all(::ActionText::Attachment.tag_name).each do |node|
+        if attachable_attributes = by_sgid[node["sgid"]]
+          new_attachable = find_imported_attachable(attachable_attributes)
+          unless new_attachable
+            raise InvalidArchive, "A rich text attachment is missing from the export"
+          end
+
+          node["sgid"] = new_attachable.attachable_sgid
+
+          if new_attachable.is_a?(::ActiveStorage::Blob)
+            node["url"] = Rails.application.routes.url_helpers.rails_blob_path(
+              new_attachable,
+              only_path: true,
+              script_name: account.slug
+            )
+          end
+        end
+      end
+
+      content.fragment.to_html
+    end
+
+    def find_imported_attachable(attributes)
+      id = remap_id(attributes["record_id"])
+
+      case attributes["record_type"]
+      when "User"
+        User.find_by(account: account, id: id)
+      when "ActiveStorage::Blob"
+        ::ActiveStorage::Blob.find_by(account: account, id: id)
+      end
+    end
+
+    def import_records(record_set)
+      each_record(record_set) do |attributes|
+        mapped = mapped_attributes(record_set.model, attributes)
+        mapped["key"] = SecureRandom.base58(24) if record_set.model == Board::Publication
+        record_set.model.insert_all!([ mapped ])
+      end
+    end
+
+    def each_record(record_set)
+      zip.glob("#{record_set.model.table_name}/*.json").each do |path|
+        yield parse_json(path)
+      end
+    end
+
+    def mapped_attributes(model, attributes)
+      attributes = attributes.stringify_keys
+      old_id = attributes["id"]
+      unless old_id.present?
+        raise InvalidArchive, "A #{model.model_name.human.downcase} in the export is missing its ID"
+      end
+
+      attributes.slice(*model.column_names).tap do |mapped|
+        model.columns.each do |column|
+          next unless mapped.key?(column.name)
+
+          case column.name
+          when "account_id"
+            mapped[column.name] = account.id
+          when "identity_id"
+            # User identities are restored by email below.
+          else
+            mapped[column.name] = remap_id(mapped[column.name]) if column.type == :uuid
+          end
+        end
+
+        model.reflect_on_all_associations(:belongs_to).select(&:polymorphic?).each do |association|
+          if attributes[association.foreign_type] == "Account"
+            mapped[association.foreign_key] = account.id
+          end
+        end
+      end
+    end
+
+    def remap_id(id)
+      if id.present?
+        digest = OpenSSL::HMAC.digest(OpenSSL::Digest::SHA256.new, @remap_salt, id.to_s)
+        ActiveRecord::Type::Uuid.hex_to_base36(digest.first(16).unpack1("H*"))
+      end
+    end
+
+    def ensure_importer_access!
+      importer_user = account.users.find_by(identity: identity)
+
+      if importer_user
+        importer_user.update_columns(
+          active: true,
+          role: "owner",
+          verified_at: importer_user.verified_at || Time.current,
+          updated_at: Time.current
+        )
+      else
+        importer_user = account.users.create!(
+          identity: identity,
+          name: identity.email_address.split("@").first.titleize,
+          role: :owner,
+          verified_at: Time.current
+        )
+      end
+
+      account.users.create!(name: "System", role: :system) unless account.users.exists?(role: :system)
+
+      account.users.where.not(role: :system).where.missing(:settings).find_each do |user|
+        user.create_settings!
+      end
+
+      account.boards.find_each do |board|
+        Access.insert_all(
+          [ {
+            id: ActiveRecord::Type::Uuid.generate,
+            account_id: account.id,
+            board_id: board.id,
+            user_id: importer_user.id,
+            involvement: :watching,
+            created_at: Time.current,
+            updated_at: Time.current
+          } ],
+          unique_by: %i[ board_id user_id ]
+        )
+      end
+
+      importer_user
+    end
+
+    def rebuild_derived_data!
+      account.cards.published.find_each(&:reindex)
+      Comment.where(account: account).joins(:card).merge(Card.published).find_each(&:reindex)
+
+      account.boards.find_each do |board|
+        raise InvalidArchive, "The board storage total could not be rebuilt" unless board.reconcile_storage
+
+        board.materialize_storage
+      end
+
+      raise InvalidArchive, "The account storage total could not be rebuilt" unless account.reconcile_storage
+
+      account.materialize_storage
+    end
+
+    def validate_imported_account!
+      Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+        next if record_set.is_a?(Account::DataTransfer::AccountRecordSet)
+        next if record_set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+        next if record_set.model == ::ActiveStorage::VariantRecord
+
+        validate_model_references!(record_set.model)
+        validate_model_records!(record_set.model)
+      end
+    end
+
+    def validate_model_references!(model)
+      scope = model.where(account_id: account.id)
+
+      model.reflect_on_all_associations(:belongs_to).each do |association|
+        next if association.options[:optional]
+
+        if association.polymorphic?
+          validate_polymorphic_references!(scope, association)
+        else
+          validate_reference!(scope, association.foreign_key, association.klass)
+        end
+      end
+    end
+
+    def validate_model_records!(model)
+      model.where(account_id: account.id).find_each do |record|
+        unless record.valid?
+          raise InvalidArchive, "An imported #{model.model_name.human.downcase} is invalid: #{record.errors.full_messages.to_sentence}"
+        end
+      end
+    end
+
+    def validate_polymorphic_references!(scope, association)
+      foreign_type = association.foreign_type
+      foreign_key = association.foreign_key
+
+      scope.distinct.pluck(foreign_type).each do |record_type|
+        parent = POLYMORPHIC_CLASSES.fetch(record_type) do
+          raise InvalidArchive, "The export contains an unsupported #{association.name} type"
+        end
+
+        validate_reference!(scope.where(foreign_type => record_type), foreign_key, parent)
+      end
+    end
+
+    def validate_reference!(scope, foreign_key, parent)
+      parent_scope = if parent.column_names.include?("account_id")
+        parent.where(account_id: account.id)
+      else
+        parent.where(id: account.id)
+      end
+
+      unless scope.where.not(foreign_key => parent_scope.select(:id)).none?
+        raise InvalidArchive, "The export contains a #{scope.klass.model_name.human.downcase} with a missing #{parent.model_name.human.downcase}"
+      end
+    end
+
+    def parse_json(path, limit: RECORD_JSON_LIMIT)
+      JSON.parse(zip.read(path, limit: limit))
+    rescue JSON::ParserError => error
+      raise InvalidArchive, "#{path} is not valid JSON", cause: error
+    end
+
+    def parse_time(value)
+      value.present? ? Time.zone.parse(value) : Time.current
+    end
+
+    def s3_service?(service)
+      defined?(::ActiveStorage::Service::S3Service) && service.is_a?(::ActiveStorage::Service::S3Service)
+    end
+
+    def cleanup_uploaded_files
+      @uploaded_files.reverse_each do |service, key|
+        service.delete(key)
+      rescue => error
+        Rails.error.report(error, context: { import_file_key: key })
+      end
+      @uploaded_files.clear
+    end
+
+    def import_error_message(error)
+      case error
+      when ActiveRecord::RecordInvalid
+        error.record.errors.full_messages.to_sentence
+      when ActiveRecord::RecordNotUnique
+        "The archive contains duplicate records"
+      else
+        "The archive could not be imported: #{error.message}".truncate(4000)
+      end
+    end
+end
