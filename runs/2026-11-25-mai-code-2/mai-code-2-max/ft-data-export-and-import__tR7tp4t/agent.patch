diff --git a/app/models/account/data_transfer/card_exporter.rb b/app/models/account/data_transfer/card_exporter.rb
new file mode 100644
index 0000000..fb760a2
--- /dev/null
+++ b/app/models/account/data_transfer/card_exporter.rb
@@ -0,0 +1,58 @@
+class Account::DataTransfer::CardExporter
+  attr_reader :user
+
+  def initialize(user)
+    @user = user
+  end
+
+  def export(zip)
+    zip.add_file "manifest.json", {
+      format: "fizzy.cards",
+      version: 1,
+      exported_at: Time.current.iso8601,
+      user: {
+        id: user.id,
+        name: user.name
+      }
+    }.to_json
+
+    Account::DataTransfer::CardRecordSet.new(user.account, relation: cards).export(zip)
+    export_files(zip)
+  end
+
+  private
+    def cards
+      user.accessible_cards
+        .with_rich_text_description_and_embeds
+        .preload(:image_attachment, comments: [ :creator, { rich_text_body: :embeds_attachments } ])
+    end
+
+    def export_files(zip)
+      cards.find_each do |card|
+        attachments_for(card).each do |blob|
+          export_blob(zip, blob)
+        end
+      end
+    end
+
+    def attachments_for(card)
+      blobs = []
+      blobs << card.image.blob if card.image.attached?
+      blobs.concat(card.attachments.map(&:blob))
+
+      card.comments.each do |comment|
+        blobs.concat(comment.attachments.map(&:blob))
+      end
+
+      blobs.uniq(&:id)
+    end
+
+    def export_blob(zip, blob)
+      path = Account::DataTransfer::ActiveStorage::FileRecordSet.archive_path_for(blob)
+      return if zip.exists?(path)
+
+      zip.add_file(path, compress: false) do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/card_record_set.rb b/app/models/account/data_transfer/card_record_set.rb
new file mode 100644
index 0000000..2264e26
--- /dev/null
+++ b/app/models/account/data_transfer/card_record_set.rb
@@ -0,0 +1,52 @@
+class Account::DataTransfer::CardRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account, relation: nil)
+    super(account: account, model: Card, relation: relation)
+  end
+
+  private
+    def records
+      super
+        .with_rich_text_description_and_embeds
+        .preload(:image_attachment, comments: [ :creator, { rich_text_body: :embeds_attachments } ])
+    end
+
+    def serialized_attributes(record)
+      super.merge(
+        "description" => record.description&.body&.to_html,
+        "comments" => record.comments.chronologically.map { |comment| serialized_comment(comment) },
+        "attachments" => serialized_attachments(record)
+      )
+    end
+
+    def serialized_comment(comment)
+      comment.attributes.merge(
+        "body" => comment.rich_text_body&.body&.to_html,
+        "creator_name" => comment.creator.name,
+        "attachments" => attachments_for(comment).map { |blob| attachment_attributes(blob) }
+      ).as_json
+    end
+
+    def serialized_attachments(card)
+      blobs = []
+      blobs << card.image.blob if card.image.attached?
+      blobs.concat(attachments_for(card))
+
+      blobs.uniq(&:id).map do |blob|
+        attachment_attributes(blob)
+      end
+    end
+
+    def attachments_for(record)
+      record.attachments.map(&:blob)
+    end
+
+    def attachment_attributes(blob)
+      {
+        id: blob.id,
+        filename: blob.filename.to_s,
+        content_type: blob.content_type,
+        byte_size: blob.byte_size,
+        path: Account::DataTransfer::ActiveStorage::FileRecordSet.archive_path_for(blob)
+      }.as_json
+    end
+end
