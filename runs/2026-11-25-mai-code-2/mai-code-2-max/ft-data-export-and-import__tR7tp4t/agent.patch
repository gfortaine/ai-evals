@@ -0,0 +1,62 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :identity
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  after_create_commit :process_later
+
+  validates :file, presence: true
+  validate :file_is_zip
+
+  def process_later
+    ProcessJob.perform_later(self)
+  end
+
+  def process_now
+    claimed = with_lock do
+      if pending?
+        processing!
+        true
+      else
+        false
+      end
+    end
+    return unless claimed
+
+    account = Account::DataTransfer::Importer.new(file: file, identity: identity).import
+    update!(imported_account: account, status: :completed, completed_at: Time.current, failure_reason: nil)
+    ImportMailer.completed(self).deliver_later
+  rescue => error
+    update!(status: :failed, failure_reason: failure_message(error))
+    Rails.error.report(error, context: { import_id: id, account_id: account_id })
+    ImportMailer.failed(self).deliver_later
+  ensure
+    purge_file if defined?(claimed) && claimed
+  end
+
+private
+  def purge_file
+    file.purge if file.attached?
+  rescue => error
+    Rails.error.report(error, context: { import_id: id, account_id: account_id })
+  end
+
+    def file_is_zip
+      if file.attached? && !file.filename.to_s.downcase.end_with?(".zip")
+        errors.add(:file, "must be a .zip file")
+      end
+    end
+
+    def failure_message(error)
+      case error
+      when Account::DataTransfer::Importer::InvalidArchive
+        error.message
+      else
+        "The import could not be completed: #{error.message}".truncate(4000)
+      end
+    end
+end
