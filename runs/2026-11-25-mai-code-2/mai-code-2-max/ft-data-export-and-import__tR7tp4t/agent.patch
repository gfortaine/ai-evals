@@ -0,0 +1,40 @@
+class Account::ExportsController < ApplicationController
+  allow_unauthenticated_access only: :show
+  allow_unauthorized_access only: :show
+
+  before_action :ensure_admin, only: :create
+
+  def create
+    Export.account_data(account: Current.account, requested_by: Current.user)
+
+    respond_to do |format|
+      format.html { redirect_to account_settings_path, notice: "We'll email you when your export is ready" }
+      format.json { head :accepted }
+    end
+  end
+
+  def show
+    @export = Export.find_signed(params[:id], purpose: :download)
+
+    unless @export&.account == Current.account && @export.file.attached?
+      raise ActiveRecord::RecordNotFound
+    end
+
+    ActiveStorage::Current.set(url_options: download_url_options) do
+      redirect_to @export.file.url(
+        expires_in: Export::DOWNLOAD_LINK_EXPIRY,
+        disposition: "attachment"
+      ), allow_other_host: true
+    end
+  end
+
+  private
+    def download_url_options
+      {
+        host: request.host,
+        port: request.optional_port,
+        protocol: request.protocol,
+        script_name: request.script_name
+      }
+    end
+end
