@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "shows the import form" do
+    get new_account_import_path
+
+    assert_response :success
+    assert_select "input[type=file][name='import[file]']"
+  end
+
+  test "starts an import" do
+    archive = Tempfile.new([ "account", ".zip" ])
+    archive.binmode
+    writer = ZipFile::Writer.new(archive)
+    writer.add_file("manifest.json", { format: "fizzy.account", version: 1 }.to_json)
+    writer.close
+    archive.rewind
+
+    upload = Rack::Test::UploadedFile.new(archive.path, "application/zip", original_filename: "account.zip")
+
+    assert_difference -> { Import.count }, 1 do
+      assert_enqueued_with job: Import::ProcessJob do
+        post account_imports_path, params: { import: { file: upload } }
+      end
+    end
+
+    assert_redirected_to new_account_import_path
+  ensure
+    archive&.close!
+  end
+
+  test "requires an account archive" do
+    assert_no_difference -> { Import.count } do
+      post account_imports_path, params: { import: { file: nil } }
+    end
+
+    assert_response :unprocessable_entity
+  end
+end
