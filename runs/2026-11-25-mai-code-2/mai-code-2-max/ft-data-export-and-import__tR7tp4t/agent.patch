@@ -0,0 +1,54 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+    Current.account = @account
+    Current.user = @user
+  end
+
+  test "builds an account ZIP and emails the recipient" do
+    export = Export.account_data(account: @account, requested_by: @user)
+
+    assert_enqueued_with job: ActionMailer::MailDeliveryJob do
+      export.build_now
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+
+    ZipFile.read_from(export.file) do |zip|
+      assert zip.exists?("manifest.json")
+      assert zip.glob("cards/*.json").any?
+      assert zip.glob("comments/*.json").any?
+    end
+  end
+
+  test "builds card JSON with only the cards visible to the user" do
+    export = Export.visible_cards(@user)
+    export.build_now
+
+    ZipFile.read_from(export.file) do |zip|
+      paths = zip.glob("cards/*.json")
+
+      assert paths.any?
+      paths.each do |path|
+        card = JSON.parse(zip.read(path))
+        assert @user.accessible_cards.exists?(id: card["id"])
+        assert card.key?("comments")
+      end
+    end
+  end
+
+  test "download tokens expire after one day" do
+    export = Export.account_data(account: @account, requested_by: @user)
+    token = export.download_token
+
+    assert_equal export, Export.find_signed(token, purpose: :download)
+
+    travel 2.days do
+      assert_nil Export.find_signed(token, purpose: :download)
+    end
+  end
+end
diff --git a/test/models/import_test.rb b/test/models/import_test.rb
new file mode 100644
index 0000000..e3161af
--- /dev/null
+++ b/test/models/import_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class ImportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+    Current.account = @account
+    Current.user = @user
+  end
+
+  test "creates an account and queues a completion email" do
+    export = Export.account_data(account: @account, requested_by: @user)
+    export.build_now
+    import = create_import_from(export.file)
+
+    assert_enqueued_with job: ActionMailer::MailDeliveryJob do
+      import.process_now
+    end
+
+    assert import.completed?
+    assert import.imported_account.present?
+    assert_not import.file.attached?
+  end
+
+  test "queues a failure email and leaves no partial account" do
+    archive = build_archive do |writer|
+      writer.add_file("manifest.json", { format: "fizzy.account", version: 1 }.to_json)
+      writer.add_file("accounts/source.json", @account.attributes.to_json)
+      writer.add_file("boards/broken.json", {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: @account.id,
+        creator_id: ActiveRecord::Type::Uuid.generate,
+        name: "Broken board",
+        all_access: false,
+        created_at: Time.current,
+        updated_at: Time.current
+      }.to_json)
+    end
+    import = Import.create!(account: @account, identity: @user.identity, file: archive)
+
+    assert_no_difference -> { Account.count } do
+      assert_enqueued_with job: ActionMailer::MailDeliveryJob do
+        import.process_now
+      end
+    end
+
+    assert import.failed?
+    assert import.failure_reason.present?
+    assert_not import.file.attached?
+  ensure
+    archive[:io]&.close!
+  end
+
+  private
+    def create_import_from(attachment)
+      archive = Tempfile.new([ "account-import", ".zip" ])
+      archive.binmode
+      attachment.download { |chunk| archive.write(chunk) }
+      archive.rewind
+      Import.create!(account: @account, identity: @user.identity, file: { io: archive, filename: "account.zip", content_type: "application/zip" })
+    ensure
+      archive&.close!
+    end
+
+    def build_archive
+      archive = Tempfile.new([ "bad-account", ".zip" ])
+      archive.binmode
+      writer = ZipFile::Writer.new(archive)
+      yield writer
+      writer.close
+      archive.rewind
+      { io: archive, filename: "account.zip", content_type: "application/zip" }
+    end
+end
