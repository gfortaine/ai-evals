@@ -0,0 +1,22 @@
+class Account::ImportsController < ApplicationController
+  def new
+    @import = Current.account.imports.new
+  end
+
+  def create
+    @import = Current.account.imports.new(import_params.merge(identity: Current.identity))
+
+    if @import.save
+      redirect_to new_account_import_path, notice: "We'll email you when the import is finished"
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def import_params
+      permitted = params.expect(import: %i[ file archive ])
+      permitted[:file] ||= permitted.delete(:archive)
+      permitted.slice(:file)
+    end
+end
