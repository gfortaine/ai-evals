diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..6284fbd
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,172 @@
+class ZipFile::Reader
+  class InvalidArchive < StandardError; end
+
+  CHUNK_SIZE = 1.megabyte
+
+  attr_reader :entries
+
+  def initialize(io)
+    @io = io
+    @file_reader = ZipKit::FileReader.new
+    @entries = @file_reader.read_zip_structure(io: io, read_local_headers: false)
+    @entries_by_path = entries.index_by(&:filename)
+
+    validate_entries!
+  rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::InvalidStructure => error
+    raise InvalidArchive, error.message
+  end
+
+  def glob(pattern)
+    entries.filter_map do |entry|
+      entry.filename if File.fnmatch(pattern, entry.filename)
+    end.sort
+  end
+
+  def exists?(path)
+    @entries_by_path.key?(path)
+  end
+
+  def read(path, limit: nil)
+    entry = entry_for(path)
+    if limit && entry.uncompressed_size > limit
+      raise InvalidArchive, "#{path} is too large"
+    end
+
+    String.new(capacity: entry.uncompressed_size, encoding: Encoding::BINARY).tap do |content|
+      open(path) do |io|
+        while (chunk = io.read(CHUNK_SIZE))
+          if limit && content.bytesize + chunk.bytesize > limit
+            raise InvalidArchive, "#{path} is too large"
+          end
+
+          content << chunk
+        end
+      end
+    end
+  end
+
+  def open(path)
+    io = EntryStream.new(entry_for(path), @io, @file_reader)
+    yield io
+    io.verify!
+  end
+
+  private
+    def entry_for(path)
+      @entries_by_path.fetch(path) do
+        raise InvalidArchive, "The archive is missing #{path}"
+      end
+    end
+
+    def validate_entries!
+      if entries.length != @entries_by_path.length
+        raise InvalidArchive, "The archive contains duplicate file names"
+      end
+
+      entries.each do |entry|
+        validate_path!(entry.filename)
+
+        if (entry.gp_flags & 0x0001).nonzero?
+          raise InvalidArchive, "Encrypted archives are not supported"
+        end
+      end
+    end
+
+    def validate_path!(path)
+      segments = path.split("/")
+
+      if path.blank? || path.start_with?("/") || path.include?("\\") || segments.any? { |segment| segment.in?([ "", ".", ".." ]) }
+        raise InvalidArchive, "The archive contains an unsafe path"
+      end
+    end
+
+    class EntryStream
+      attr_reader :size
+
+      def initialize(entry, io, file_reader)
+        @entry = entry
+        @io = io
+        @file_reader = file_reader
+        @size = entry.uncompressed_size
+        @buffer = "".b
+        @bytes_read = 0
+        @crc32 = 0
+      end
+
+      def read(length = nil, outbuf = nil)
+        if length.nil?
+          fill_buffer until extractor.eof?
+          data = @buffer.slice!(0, @buffer.bytesize)
+        else
+          raise ArgumentError, "negative length" if length.negative?
+          return "" if length.zero?
+
+          fill_buffer until @buffer.bytesize >= length || extractor.eof?
+          return if @buffer.empty?
+
+          data = @buffer.slice!(0, length)
+        end
+
+        finish if eof?
+
+        if outbuf
+          outbuf.replace(data)
+        else
+          data
+        end
+      end
+
+      def eof?
+        extractor.eof? && @buffer.empty?
+      end
+
+      def verify!
+        finish
+      end
+
+      def binmode
+        self
+      end
+
+      def close
+        @buffer.clear
+      end
+
+      private
+        def extractor
+          @extractor ||= begin
+            unless @entry.known_offset?
+              @entry.compressed_data_offset = @file_reader.get_compressed_data_offset(
+                io: @io,
+                local_file_header_offset: @entry.local_file_header_offset
+              )
+            end
+
+            @entry.extractor_from(@io)
+          end
+        end
+
+        def fill_buffer
+          chunk = extractor.extract(CHUNK_SIZE)
+          return if chunk.nil?
+
+          @bytes_read += chunk.bytesize
+          @crc32 = Zlib.crc32(chunk, @crc32)
+          @buffer << chunk
+        end
+
+        def finish
+          if eof?
+            unless @bytes_read == @size
+              raise InvalidArchive, "#{@entry.filename} has the wrong size"
+            end
+
+            unless @crc32 == @entry.crc32
+              raise InvalidArchive, "#{@entry.filename} failed its checksum"
+            end
+          else
+            raise InvalidArchive, "#{@entry.filename} was not completely read"
+          end
+        end
+    end
+end
diff --git a/app/models/zip_file/remote_io.rb b/app/models/zip_file/remote_io.rb
new file mode 100644
index 0000000..299fe2d
--- /dev/null
+++ b/app/models/zip_file/remote_io.rb
@@ -0,0 +1,52 @@
+class ZipFile::RemoteIO
+  def initialize(blob_or_url)
+    if blob_or_url.respond_to?(:service)
+      @blob = blob_or_url
+      @size = @blob.byte_size
+    else
+      @http_io = ZipKit::RemoteIO.new(blob_or_url)
+      @size = @http_io.size
+    end
+
+    @position = 0
+  end
+
+  def seek(offset, mode = IO::SEEK_SET)
+    if @http_io
+      @http_io.seek(offset, mode).tap { @position = @http_io.tell }
+    elsif mode == IO::SEEK_SET
+      @position = offset.clamp(0, @size)
+      0
+    else
+      raise ArgumentError, "Unsupported seek mode"
+    end
+  end
+
+  def size
+    @size
+  end
+
+  def tell
+    @position
+  end
+
+  def read(length = nil)
+    return if @size.zero?
+
+    available = @size - @position
+    length ||= available
+    return "" if length.zero?
+    raise ArgumentError, "negative length" if length.negative?
+
+    length = [ length, available ].min
+    range = (@position...@position + length)
+    data = @http_io ? @http_io.read(length) : @blob.service.download_chunk(@blob.key, range)
+
+    unless data.bytesize == length
+      raise IOError, "Remote storage returned #{data.bytesize} bytes instead of #{length}"
+    end
+
+    @position += data.bytesize
+    data
+  end
+end
