diff --git a/test/models/account/data_transfer/importer_test.rb b/test/models/account/data_transfer/importer_test.rb
new file mode 100644
index 0000000..8d3d2b5
--- /dev/null
+++ b/test/models/account/data_transfer/importer_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Account::DataTransfer::ImporterTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+    Current.account = @account
+    Current.user = @user
+  end
+
+  test "round trips an account with its files" do
+    card = cards(:logo)
+    card.image.attach(
+      io: StringIO.new("portable image"),
+      filename: "logo.png",
+      content_type: "image/png"
+    )
+    embedded_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("embedded file"),
+      filename: "notes.txt",
+      content_type: "text/plain"
+    )
+    card.update!(description: <<~HTML)
+      <action-text-attachment sgid="#{embedded_blob.attachable_sgid}" filename="notes.txt" content-type="text/plain"></action-text-attachment>
+    HTML
+
+    export = Export.account_data(account: @account, requested_by: @user)
+    export.build_now
+
+    imported = Account::DataTransfer::Importer.new(file: export.file, identity: @user.identity).import
+    imported_card = imported.cards.find_by!(number: card.number)
+
+    assert_not_equal @account.id, imported.id
+    assert_equal @account.boards.count, imported.boards.count
+    assert_equal @account.cards.count, imported.cards.count
+    assert_equal Comment.where(account: @account).count, Comment.where(account: imported).count
+    assert_equal "portable image", imported_card.image.download
+    assert_equal "embedded file", imported_card.description.body.attachables.sole.download
+    assert imported.users.exists?(identity: @user.identity, role: :owner)
+  end
+
+  test "rolls back an invalid archive" do
+    archive = Tempfile.new([ "invalid-import", ".zip" ])
+    archive.binmode
+    writer = ZipFile::Writer.new(archive)
+    writer.add_file("manifest.json", { format: "fizzy.account", version: 1 }.to_json)
+    writer.add_file("accounts/source.json", @account.attributes.to_json)
+    writer.add_file("boards/broken.json", {
+      id: ActiveRecord::Type::Uuid.generate,
+      account_id: @account.id,
+      all_access: false,
+      creator_id: ActiveRecord::Type::Uuid.generate,
+      name: "Broken board",
+      created_at: Time.current,
+      updated_at: Time.current
+    }.to_json)
+    writer.close
+    archive.rewind
+
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: archive,
+      filename: "invalid.zip",
+      content_type: "application/zip"
+    )
+
+    assert_no_difference -> { Account.count } do
+      assert_raises Account::DataTransfer::Importer::InvalidArchive do
+        Account::DataTransfer::Importer.new(file: blob, identity: @user.identity).import
+      end
+    end
+  ensure
+    blob&.purge
+    archive&.close!
+  end
+end
diff --git a/test/models/export_test.rb b/test/models/export_test.rb
