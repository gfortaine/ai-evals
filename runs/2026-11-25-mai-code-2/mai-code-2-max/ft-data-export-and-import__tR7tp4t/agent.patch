diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..e135bc6
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admins start account exports" do
+    assert_difference -> { Export.count }, 1 do
+      post account_exports_path
+    end
+
+    assert_redirected_to account_settings_path
+  end
+
+  test "members cannot export an account" do
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "download links work without a session until they expire" do
+    export = Export.account_data(account: accounts(:"37s"), requested_by: users(:kevin))
+    export.file.attach(io: StringIO.new("export"), filename: "export.zip", content_type: "application/zip")
+    token = export.download_token
+    sign_out
+
+    get account_export_path(token)
+    assert_response :redirect
+
+    travel 2.days do
+      get account_export_path(token)
+      assert_response :not_found
+    end
+  end
+end
