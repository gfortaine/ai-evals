diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..78e918f
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,30 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event \
+      request.raw_post,
+      request.headers["Stripe-Signature"],
+      ENV["STRIPE_WEBHOOK_SECRET"]
+
+    sync event
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError
+    Rails.logger.warn "Rejected Stripe webhook with an invalid signature"
+    head :bad_request
+  end
+
+  private
+    def sync(event)
+      stripe_object = Account::Subscription.attribute(event, :data)&.then { |data| Account::Subscription.attribute(data, :object) }
+
+      case Account::Subscription.attribute(event, :type)
+      when "checkout.session.completed"
+        Account::Subscription.sync_from_checkout(stripe_object)
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        Account::Subscription.sync_from_stripe_subscription(stripe_object)
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..1adb3ad
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,110 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :subscriptions, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+
+    set_callback :cancel, :before, :cancel_active_subscription
+  end
+
+  def plan
+    billing_plan.short_name
+  end
+
+  def billing_plan
+    if comped?
+      Subscription::MonthlyV1
+    elsif subscription = active_subscription
+      subscription.plan
+    else
+      Subscription::FreeV1
+    end
+  end
+
+  def active_subscription
+    subscriptions.active.order(updated_at: :desc).first
+  end
+
+  def subscription
+    subscriptions.order(updated_at: :desc).first
+  end
+
+  def paid?
+    comped? || active_subscription.present?
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def card_count
+    overridden_limit&.card_count || cards_count
+  end
+
+  def cards_remaining
+    [ card_limit - card_count, 0 ].max if card_limit
+  end
+
+  alias_method :cards_left, :cards_remaining
+
+  def exceeding_card_limit?(card = nil)
+    card_limit.present? && card_count >= card_limit && !last_free_card?(card)
+  end
+
+  alias_method :card_limit_exceeded?, :exceeding_card_limit?
+
+  def nearing_card_limit?(card = nil)
+    cards_remaining.present? && cards_remaining <= 100 && !exceeding_card_limit?(card)
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      create_billing_waiver! unless comped?
+    else
+      billing_waiver&.destroy!
+      association(:billing_waiver).reset
+    end
+  end
+
+  def comp
+    self.comped = true
+  end
+
+  def uncomp
+    self.comped = false
+  end
+
+  alias_method :uncomp!, :uncomp
+
+  def override_usage(card_count:, bytes_used:)
+    if overridden_limit
+      overridden_limit.update!(card_count: card_count, bytes_used: bytes_used)
+    else
+      create_overridden_limit!(card_count: card_count, bytes_used: bytes_used)
+    end
+  end
+
+  alias_method :override_limits, :override_usage
+
+  def reset_usage_override
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+  end
+
+  alias_method :reset_overridden_limit, :reset_usage_override
+
+  private
+    def cancel_active_subscription
+      active_subscription&.cancel_in_stripe
+    end
+
+    def last_free_card?(card)
+      card && overridden_limit.nil? && card_count == card_limit && card.number == card_limit
+    end
+end
