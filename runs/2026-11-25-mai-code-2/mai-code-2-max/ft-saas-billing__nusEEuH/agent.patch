diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..447efe8
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,93 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header><h2 class="divider">Account</h2></header>
+
+      <dl class="flex flex-column gap-half">
+        <div>
+          <dt class="txt-x-small txt-uppercase">Account ID</dt>
+          <dd class="margin-none"><%= @account.id %></dd>
+        </div>
+        <div>
+          <dt class="txt-x-small txt-uppercase">Owner</dt>
+          <dd class="margin-none"><%= @account.owner_email || "No owner" %></dd>
+        </div>
+        <div>
+          <dt class="txt-x-small txt-uppercase">Plan</dt>
+          <dd class="margin-none"><%= @account.billing_plan.proper_name %></dd>
+        </div>
+        <div>
+          <dt class="txt-x-small txt-uppercase">Cards</dt>
+          <dd class="margin-none">
+            <%= number_with_delimiter(@account.card_count) %>
+            <% if @account.card_limit %>/ <%= number_with_delimiter(@account.card_limit) %><% end %>
+          </dd>
+        </div>
+        <div>
+          <dt class="txt-x-small txt-uppercase">Storage</dt>
+          <dd class="margin-none"><%= number_to_human_size(@account.bytes_used) %> / <%= number_to_human_size(@account.storage_limit) %></dd>
+        </div>
+      </dl>
+    </section>
+
+    <section class="settings__section">
+      <header><h2 class="divider">Billing waiver</h2></header>
+
+      <div class="flex gap-half">
+        <%= button_to "Comp", saas.admin_account_comp_path(@account),
+              class: "btn", disabled: @account.comped? %>
+        <%= button_to "Uncomp", saas.admin_account_comp_path(@account),
+              method: :delete, class: "btn", disabled: !@account.comped? %>
+      </div>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Override usage</h2>
+        <div>Temporarily replace the values used for billing limits.</div>
+      </header>
+
+      <%= form_with scope: :overridden_limit,
+            url: saas.admin_account_overridden_limit_path(@account),
+            method: :post,
+            class: "flex flex-column gap-half" do |form| %>
+        <div class="flex flex-column gap-quarter txt-align-start">
+          <%= form.label :card_count, "Card count" %>
+          <%= form.number_field :card_count,
+                value: @overridden_limit.card_count,
+                min: 0,
+                class: "input",
+                required: true %>
+        </div>
+
+        <div class="flex flex-column gap-quarter txt-align-start">
+          <%= form.label :bytes_used, "Bytes used" %>
+          <%= form.number_field :bytes_used,
+                value: @overridden_limit.bytes_used,
+                min: 0,
+                class: "input",
+                required: true %>
+        </div>
+
+        <%= form.submit "Override", class: "btn btn--link" %>
+      <% end %>
+
+      <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account),
+            method: :delete,
+            class: "btn",
+            disabled: !@account.overridden_limit %>
+    </section>
+  </div>
+</section>
+
+<div class="txt-align-center margin-block-start">
+  <%= link_to "All accounts", saas.admin_accounts_path, class: "txt-link txt-small" %>
+</div>
