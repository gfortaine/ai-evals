@@ -0,0 +1,51 @@
+<% @page_title = "Upgrade Fizzy" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <% @plans.each do |plan| %>
+    <div class="settings__panel panel shadow center">
+      <section class="settings__section">
+        <header>
+          <h2 class="divider"><%= plan.proper_name %></h2>
+        </header>
+
+        <div class="txt-x-large"><strong>$<%= plan.price %></strong><span class="txt-small">/month</span></div>
+
+        <ul class="list-unindented txt-align-start">
+          <% if plan.card_limit %>
+            <li><%= number_with_delimiter(plan.card_limit) %> cards</li>
+          <% else %>
+            <li>Unlimited cards</li>
+          <% end %>
+          <li><%= number_to_human_size(plan.storage_limit) %> storage</li>
+        </ul>
+
+        <% if plan == Subscription::FreeV1 %>
+          <div class="txt-small txt-ink-medium">Included with every account</div>
+        <% elsif Current.user.admin? %>
+          <%= button_to "Choose #{plan.proper_name}", saas.account_billing_checkout_path,
+                params: { plan_key: plan.short_name },
+                class: "btn btn--link center",
+                form: { data: { turbo: false } } %>
+        <% else %>
+          <div class="txt-small">Ask an account admin to upgrade.</div>
+        <% end %>
+      </section>
+    </div>
+  <% end %>
+</section>
+
+<% if Current.account.active_subscription %>
+  <div class="txt-align-center margin-block-start">
+    <%= button_to "Manage billing", saas.account_billing_portal_path,
+          class: "btn btn--link",
+          form: { data: { turbo: false } } %>
+  </div>
+<% end %>
+
+<div class="txt-align-center txt-small margin-block-start-double">
+  Checkout and billing details are securely handled by Stripe.
+</div>
