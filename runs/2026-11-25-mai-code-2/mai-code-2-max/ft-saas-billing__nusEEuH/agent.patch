@@ -0,0 +1,15 @@
+class Account::BillingPortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    if subscription = Current.account.active_subscription
+      portal_session = Stripe::BillingPortal::Session.create \
+        customer: subscription.stripe_customer_id,
+        return_url: main_app.account_settings_url(script_name: Current.account.slug)
+
+      redirect_to portal_session.url, allow_other_host: true
+    else
+      redirect_to saas.account_billing_path, alert: "No active subscription"
+    end
+  end
+end
diff --git a/saas/app/controllers/account/billings_controller.rb b/saas/app/controllers/account/billings_controller.rb
new file mode 100644
index 0000000..354856c
--- /dev/null
+++ b/saas/app/controllers/account/billings_controller.rb
@@ -0,0 +1,55 @@
+class Account::BillingsController < ApplicationController
+  before_action :ensure_admin, only: :create
+
+  def show
+    @plans = Subscription::SHORT_NAMES.map { |short_name| Subscription.find(short_name) }
+  end
+
+  def create
+    plan = selected_plan
+
+    if plan
+      session = Stripe::Checkout::Session.create checkout_session_attributes(plan)
+      redirect_to session.url, allow_other_host: true
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  private
+    def selected_plan
+      plan_key = params[:plan_key].presence || params[:plan].presence
+
+      if plan_key
+        plan = Subscription.find(plan_key)
+        plan if plan.in?(Subscription.paid)
+      else
+        Subscription::MonthlyV1
+      end
+    end
+
+    def checkout_session_attributes(plan)
+      attributes = {
+        client_reference_id: Current.account.external_account_id.to_s,
+        customer: Current.account.subscription&.stripe_customer_id,
+        customer_email: Current.account.owner_email,
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        metadata: stripe_metadata(plan),
+        mode: "subscription",
+        subscription_data: { metadata: stripe_metadata(plan) },
+        success_url: main_app.account_settings_url(script_name: Current.account.slug, checkout: "success"),
+        cancel_url: main_app.account_settings_url(script_name: Current.account.slug, checkout: "cancelled")
+      }.compact
+
+      attributes.delete(:customer_email) if attributes[:customer]
+      attributes
+    end
+
+    def stripe_metadata(plan)
+      {
+        account_id: Current.account.id,
+        queenbee_account_id: Current.account.external_account_id,
+        plan_key: plan.short_name
+      }
+    end
+end
