diff --git a/saas/test/controllers/account/billings_controller_test.rb b/saas/test/controllers/account/billings_controller_test.rb
new file mode 100644
index 0000000..3b193cd
--- /dev/null
+++ b/saas/test/controllers/account/billings_controller_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Account::BillingsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    integration_session.default_url_options[:script_name] = accounts(:initech).slug
+  end
+
+  test "admin can see all approved plans" do
+    get saas.account_billing_path
+
+    assert_response :success
+    assert_select "h2", text: "Free"
+    assert_select "h2", text: "Unlimited"
+    assert_select "h2", text: "Unlimited+"
+    assert_select "li", text: "1,000 cards"
+    assert_select "li", text: "5 GB storage"
+    assert_select "li", text: "500 GB storage"
+  end
+
+  test "admin is sent to Stripe hosted checkout" do
+    checkout = stub(url: "https://checkout.stripe.test/session")
+    Stripe::Checkout::Session.expects(:create).with do |attributes|
+      attributes[:mode] == "subscription" &&
+        attributes[:metadata][:account_id] == accounts(:initech).id &&
+        attributes[:metadata][:plan_key] == "MonthlyV1"
+    end.returns(checkout)
+
+    post saas.account_billing_checkout_path, params: { plan_key: "MonthlyV1" }
+
+    assert_redirected_to checkout.url
+  end
+
+  test "unknown checkout plan is rejected" do
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_billing_checkout_path, params: { plan_key: "FreeV1" }
+
+    assert_response :unprocessable_entity
+  end
+
+  test "admin is sent to Stripe hosted customer portal" do
+    accounts(:initech).subscriptions.create! \
+      plan_key: "MonthlyV1",
+      stripe_customer_id: "cus_portal",
+      stripe_subscription_id: "sub_portal",
+      status: "active"
+    portal = stub(url: "https://billing.stripe.test/session")
+
+    Stripe::BillingPortal::Session.expects(:create).with(
+      customer: "cus_portal",
+      return_url: main_app.account_settings_url(script_name: accounts(:initech).slug)
+    ).returns(portal)
+
+    post saas.account_billing_portal_path
+
+    assert_redirected_to portal.url
+  end
+
+  test "account member cannot create checkout session" do
+    logout_and_sign_in_as :david
+    integration_session.default_url_options[:script_name] = accounts(:"37s").slug
+
+    post saas.account_billing_checkout_path, params: { plan_key: "MonthlyV1" }
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..3db4112
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "staff can list accounts and open each account" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :success
+    assert_select "a[href='#{saas.admin_account_path(accounts(:initech), script_name: "")}']", text: "Initech LLC"
+
+    untenanted do
+      get saas.admin_account_path(accounts(:initech), script_name: "")
+    end
+
+    assert_response :success
+    assert_select "h1", text: "Initech LLC"
+  end
+
+  test "non-staff cannot list accounts" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "account page has support billing controls" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_account_path(accounts(:initech), script_name: "")
+    end
+
+    assert_response :success
+    assert_select "button", text: "Comp"
+    assert_select "button", text: "Uncomp"
+    assert_select "label", text: "Card count"
+    assert_select "label", text: "Bytes used"
+    assert_select "input[type='submit'][value='Override']"
+    assert_select "button", text: "Reset"
+  end
+
+  test "staff can comp and uncomp an account" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_comp_path(account, script_name: "")
+    end
+
+    assert_redirected_to saas.admin_account_path(account, script_name: "")
+    assert account.reload.comped?
+
+    untenanted do
+      delete saas.admin_account_comp_path(account, script_name: "")
+    end
+
+    assert_redirected_to saas.admin_account_path(account, script_name: "")
+    assert_not account.reload.comped?
+  end
+
+  test "staff can override usage and reset it" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(account, script_name: ""), params: {
+        overridden_limit: { card_count: 1_100, bytes_used: 2.gigabytes }
+      }
+    end
+
+    assert_redirected_to saas.admin_account_path(account, script_name: "")
+    assert_equal 1_100, account.reload.card_count
+    assert_equal 2.gigabytes, account.bytes_used
+
+    untenanted do
+      delete saas.admin_account_overridden_limit_path(account, script_name: "")
+    end
+
+    assert_redirected_to saas.admin_account_path(account, script_name: "")
+    assert_nil account.reload.overridden_limit
+  end
+
+  test "staff-only routes reject non-staff" do
+    sign_in_as :jz
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_comp_path(account, script_name: "")
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/card/limited_test.rb b/saas/test/controllers/card/limited_test.rb
new file mode 100644
index 0000000..9618407
--- /dev/null
+++ b/saas/test/controllers/card/limited_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class Card::LimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    integration_session.default_url_options[:script_name] = @account.slug
+  end
+
+  test "free account can create drafts at the card limit" do
+    @account.update!(cards_count: 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list))
+    end
+
+    assert_redirected_to card_draft_path(cards(:unfinished_thoughts))
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "free account cannot create cards through JSON at the card limit" do
+    @account.update!(cards_count: 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list)),
+        params: { card: { title: "Blocked" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "free account cannot publish at the card limit" do
+    @account.update!(cards_count: 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts))
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "the one thousandth draft can still be published" do
+    card = cards(:unfinished_thoughts)
+    card.update!(number: 1_000)
+    @account.update!(cards_count: 1_000)
+
+    get card_draft_path(card)
+    assert_select ".card-perma__notch-new-card-buttons"
+
+    post card_publish_path(card)
+    assert_redirected_to card.board
+    assert card.reload.published?
+  end
+
+  test "paid account can create and publish at the free card limit" do
+    @account.subscriptions.create! \
+      plan_key: "MonthlyV1",
+      stripe_customer_id: "cus_limit_test",
+      stripe_subscription_id: "sub_limit_test",
+      status: "active"
+    @account.update!(cards_count: 1_000)
+
+    assert_difference -> { Card.count }, +1 do
+      post board_cards_path(boards(:miltons_wish_list)),
+        params: { card: { title: "Paid" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "draft shows card countdown with 100 cards remaining or fewer" do
+    @account.update!(cards_count: 950)
+
+    get card_draft_path(cards(:unfinished_thoughts))
+
+    assert_response :success
+    assert_select ".txt-small strong", text: "50 cards left."
+  end
+
+  test "draft replaces create buttons with upgrade pitch at the limit" do
+    @account.update!(cards_count: 1_000)
+
+    get card_draft_path(cards(:unfinished_thoughts))
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__account-limit-message" do
+      assert_select "strong", text: /1,000/
+      assert_select "a", text: "Upgrade"
+    end
+  end
+
+  test "staff bypasses the card limit" do
+    logout_and_sign_in_as :kevin
+    account = accounts(:"37s")
+    integration_session.default_url_options[:script_name] = account.slug
+    account.update!(cards_count: 1_000)
+
+    assert_difference -> { Card.count }, +1 do
+      post board_cards_path(boards(:writebook)),
+        params: { card: { title: "Staff" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..3881a42
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  test "unauthenticated checkout event creates a subscription" do
+    event = {
+      type: "checkout.session.completed",
+      data: { object: {
+        id: "cs_webhook",
+        customer: "cus_webhook",
+        subscription: "sub_webhook",
+        metadata: { account_id: accounts(:initech).id, plan_key: "MonthlyV1" }
+      } }
+    }
+
+    Stripe::Webhook.expects(:construct_event).returns(event)
+
+    untenanted do
+      post Fizzy::Saas::Engine.routes.url_helpers.stripe_webhooks_path, params: event.to_json, headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "signed" }
+    end
+
+    assert_response :ok
+    subscription = accounts(:initech).subscriptions.sole
+    assert_equal "MonthlyV1", subscription.plan_key
+    assert subscription.active?
+  end
+
+  test "subscription event updates the local plan and status" do
+    subscription = accounts(:initech).subscriptions.create! \
+      plan_key: "MonthlyV1",
+      stripe_customer_id: "cus_update",
+      stripe_subscription_id: "sub_update",
+      status: "active"
+    event = {
+      type: "customer.subscription.updated",
+      data: { object: {
+        id: "sub_update",
+        customer: "cus_update",
+        status: "canceled",
+        metadata: { account_id: accounts(:initech).id, plan_key: "MonthlyV1" }
+      } }
+    }
+
+    Stripe::Webhook.expects(:construct_event).returns(event)
+
+    untenanted do
+      post Fizzy::Saas::Engine.routes.url_helpers.stripe_webhooks_path, params: event.to_json, as: :json, headers: { "Stripe-Signature" => "signed" }
+    end
+
+    assert_response :ok
+    assert_equal "canceled", subscription.reload.status
+  end
+
+  test "rejects invalid Stripe signatures" do
+    Stripe::Webhook.expects(:construct_event).raises(Stripe::SignatureVerificationError.new("invalid", "bad"))
+
+    untenanted do
+      post Fizzy::Saas::Engine.routes.url_helpers.stripe_webhooks_path, params: "{}", as: :json, headers: { "Stripe-Signature" => "bad" }
+    end
+
+    assert_response :bad_request
+  end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..6d586c2
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan has the approved limits" do
+    assert_equal "FreeV1", @account.plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "unlimited plan has unlimited cards and 5 GB of storage" do
+    @account.subscriptions.create! \
+      plan_key: "MonthlyV1",
+      stripe_customer_id: "cus_unlimited",
+      stripe_subscription_id: "sub_unlimited",
+      status: "active"
+
+    assert_equal "MonthlyV1", @account.plan
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "unlimited plus plan has 500 GB of storage" do
+    @account.subscriptions.create! \
+      plan_key: "MonthlyExtraStorageV1",
+      stripe_customer_id: "cus_plus",
+      stripe_subscription_id: "sub_plus",
+      status: "active"
+
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "cancelled subscriptions no longer provide paid limits" do
+    subscription = @account.subscriptions.create! \
+      plan_key: "MonthlyV1",
+      stripe_customer_id: "cus_cancelled",
+      stripe_subscription_id: "sub_cancelled",
+      status: "active"
+
+    subscription.update!(status: "canceled")
+
+    assert_equal "FreeV1", @account.plan
+    assert_equal 1_000, @account.card_limit
+  end
+
+  test "canceling an account cancels its Stripe subscription" do
+    subscription = @account.subscriptions.create! \
+      plan_key: "MonthlyV1",
+      stripe_customer_id: "cus_account_cancel",
+      stripe_subscription_id: "sub_account_cancel",
+      status: "active"
+
+    Stripe::Subscription.expects(:cancel).with("sub_account_cancel")
+
+    @account.cancel(initiated_by: users(:mike))
+
+    assert @account.cancelled?
+    assert_equal "canceled", subscription.reload.status
+  end
+
+  test "card count warns from 100 remaining and exceeds at the limit" do
+    @account.update!(cards_count: 900)
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+
+    @account.update!(cards_count: 950)
+    assert_equal 50, @account.cards_remaining
+
+    @account.update!(cards_count: 1_000)
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "usage override replaces cards and bytes" do
+    @account.override_usage(card_count: 1_250, bytes_used: 2.gigabytes)
+
+    assert_equal 1_250, @account.card_count
+    assert_equal 2.gigabytes, @account.bytes_used
+
+    @account.reset_usage_override
+
+    assert_equal @account.cards_count, @account.card_count
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "comped accounts get unlimited without an active Stripe subscription" do
+    @account.comp
+
+    assert @account.comped?
+    assert @account.paid?
+    assert_equal "MonthlyV1", @account.plan
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.uncomp
+    assert_not @account.comped?
+  end
+
+  test "syncs a checkout and subsequent subscription event" do
+    Account::Subscription.sync_from_checkout(
+      id: "cs_test",
+      customer: "cus_test",
+      subscription: "sub_test",
+      metadata: { account_id: @account.id, plan_key: "MonthlyV1" }
+    )
+
+    subscription = @account.subscriptions.sole
+    assert subscription.active?
+    assert_equal "MonthlyV1", subscription.plan_key
+    assert_equal "sub_test", subscription.stripe_subscription_id
+
+    Account::Subscription.sync_from_stripe_subscription(
+      id: "sub_test",
+      customer: "cus_test",
+      status: "canceled",
+      metadata: { account_id: @account.id, plan_key: "MonthlyV1" }
+    )
+
+    assert_not subscription.reload.active?
+  end
+end
