+class Admin::Accounts::OverriddenLimitsController < AdminController
+  before_action :set_account
+
+  def create
+    @account.override_usage(**override_params)
+    redirect_to saas.admin_account_path(@account), notice: "Usage overridden"
+  end
+
+  alias_method :update, :create
+
+  def destroy
+    @account.reset_usage_override
+    redirect_to saas.admin_account_path(@account), notice: "Usage override reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:account_id])
+    end
+
+    def override_params
+      values = if params[:account_overridden_limit]
+        params.require(:account_overridden_limit)
+      elsif params[:overridden_limit]
+        params.require(:overridden_limit)
+      else
+        params
+      end
+
+      permitted = values.permit(:card_count, :bytes_used).to_h.symbolize_keys
+
+      {
+        card_count: permitted[:card_count].presence,
+        bytes_used: permitted[:bytes_used].presence
+      }
+    end
+end
