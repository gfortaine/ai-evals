diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..db1fb6f
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,135 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  scope :active, -> { where(status: ACTIVE_STATUSES) }
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+  validates :plan_key, inclusion: { in: Subscription::SHORT_NAMES.excluding("FreeV1") }, allow_nil: true
+
+  before_destroy :cancel_in_stripe, if: :active?
+
+  class << self
+    def sync_from_checkout(checkout_session)
+      sync_from_stripe checkout_session, checkout: true
+    end
+
+    def sync_from_stripe_subscription(stripe_subscription)
+      sync_from_stripe stripe_subscription
+    end
+
+    def attribute(object, name)
+      return unless object
+
+      value = if object.respond_to?(:key?)
+        object[name] || object[name.to_s]
+      elsif object.respond_to?(:[])
+        object[name]
+      end
+
+      value || (object.public_send(name) if object.respond_to?(name))
+    end
+
+    private
+      def sync_from_stripe(object, checkout: false)
+        subscription_id = stripe_subscription_id(object, checkout: checkout)
+        customer_id = stripe_customer_id(object)
+        record = find_by(stripe_subscription_id: subscription_id) if subscription_id
+        record ||= find_by(stripe_customer_id: customer_id) if customer_id
+        account = record&.account || account_for(object)
+        plan = plan_for(object)
+
+        if account && (record || plan)
+          attributes = subscription_attributes(object, checkout: checkout, plan: plan, record: record)
+          record ||= account.subscriptions.build
+          record.tap { |subscription| subscription.update!(attributes) }
+        end
+      end
+
+      def account_for(object)
+        account_reference = metadata(object, :account_id) ||
+          metadata(object, :fizzy_account_id) ||
+          metadata(object, :queenbee_account_id) ||
+          attribute(object, :client_reference_id)
+
+        if account_reference.present?
+          Account.find_by(id: account_reference) || Account.find_by(external_account_id: account_reference)
+        end
+      end
+
+      def subscription_attributes(object, checkout:, plan:, record:)
+        {
+          stripe_customer_id: stripe_customer_id(object) || record&.stripe_customer_id,
+          stripe_subscription_id: stripe_subscription_id(object, checkout: checkout) || record&.stripe_subscription_id,
+          plan_key: plan&.short_name || record&.plan_key,
+          status: checkout ? "active" : attribute(object, :status),
+          current_period_end: timestamp(attribute(object, :current_period_end) || current_item_period_end(object)),
+          cancel_at: timestamp(attribute(object, :cancel_at))
+        }.compact
+      end
+
+      def stripe_customer_id(object)
+        id_from(attribute(object, :customer)) || id_from(attribute(object, :stripe_customer_id))
+      end
+
+      def stripe_subscription_id(object, checkout:)
+        value = if checkout
+          attribute(object, :subscription)
+        else
+          attribute(object, :id)
+        end
+
+        id_from(value) || id_from(attribute(object, :stripe_subscription_id))
+      end
+
+      def plan_for(object)
+        Subscription.for \
+          stripe_price_id: stripe_price_id(object),
+          plan_key: metadata(object, :plan_key)
+      end
+
+      def stripe_price_id(object)
+        items = attribute(object, :items)
+        data = attribute(items, :data)
+        item = data&.first
+        price = attribute(item, :price) || attribute(object, :price) || attribute(object, :plan)
+        id_from(price)
+      end
+
+      def current_item_period_end(object)
+        items = attribute(object, :items)
+        data = attribute(items, :data)
+        attribute(data&.first, :current_period_end)
+      end
+
+      def metadata(object, name)
+        metadata = attribute(object, :metadata)
+        attribute(metadata, name)
+      end
+
+      def id_from(value)
+        value.is_a?(String) ? value : attribute(value, :id)
+      end
+
+      def timestamp(value)
+        Time.at(value) if value.present?
+      end
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def plan
+    Subscription.find(plan_key) || Subscription::FreeV1
+  end
+
+  def cancel_in_stripe
+    if stripe_subscription_id.present? && active?
+      Stripe::Subscription.cancel(stripe_subscription_id)
+      update_column(:status, "canceled") unless destroyed?
+    end
+  end
+end
