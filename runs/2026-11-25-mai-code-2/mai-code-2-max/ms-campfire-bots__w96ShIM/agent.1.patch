diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..31745f8
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,25 @@
+class Bot < User
+  belongs_to :creator, class_name: "User", inverse_of: :bots, default: -> { Current.user }
+
+  has_secure_token :code
+
+  before_validation :set_password, on: :create
+
+  validates :name, presence: true
+
+  def bot?
+    true
+  end
+
+  def deactivate
+    transaction do
+      super
+      update!(code: nil)
+    end
+  end
+
+  private
+    def set_password
+      self.password ||= SecureRandom.base64(36)
+    end
+end
