diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..e5e7ea5
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,51 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+
+  def index
+    @bots = bot_scope.ordered.with_attached_avatar
+  end
+
+  def new
+    @bot = Bot.new
+  end
+
+  def create
+    @bot = Current.user.bots.new(bot_params)
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url
+  end
+
+  private
+    def set_bot
+      @bot = bot_scope.find(params[:id])
+    end
+
+    def bot_scope
+      scope = Current.user.can_administer? ? Bot.all : Current.user.bots
+      scope.active
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
diff --git a/app/controllers/rooms/bot_messages_controller.rb b/app/controllers/rooms/bot_messages_controller.rb
new file mode 100644
index 0000000..84de157
--- /dev/null
+++ b/app/controllers/rooms/bot_messages_controller.rb
@@ -0,0 +1,37 @@
+class Rooms::BotMessagesController < ApplicationController
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  before_action :set_room
+  before_action :set_bot
+  before_action :ensure_bot_is_member
+
+  def create
+    body = request.raw_post.to_s.dup.force_encoding(Encoding::UTF_8)
+
+    if !body.valid_encoding? || body.blank?
+      head :unprocessable_content
+      return
+    end
+
+    message = @room.messages.create_with_attachment!(body: ERB::Util.html_escape(body), creator: @bot)
+    message.broadcast_create
+
+    head :created, location: message_path(message)
+  end
+
+  private
+    def set_room
+      @room = Room.find_by(id: params[:room_id])
+      head :not_found unless @room
+    end
+
+    def set_bot
+      @bot = Bot.active.find_by(code: params[:bot_code])
+      head :unauthorized unless @bot
+    end
+
+    def ensure_bot_is_member
+      head :not_found unless @room.users.exists?(@bot.id)
+    end
+end
