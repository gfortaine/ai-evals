diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..642f28c
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    @own_bot = users(:kevin).bots.create!(name: "Deploy Bot")
+    @other_bot = users(:jz).bots.create!(name: "Other Bot")
+  end
+
+  test "account settings links to bot setup" do
+    get edit_account_url
+
+    assert_response :success
+    assert_select "a[href='#{bots_path}'][aria-label='Set up chat bots']", text: /Set up chat bots/
+  end
+
+  test "lists only the current member's bots without pagination" do
+    get bots_url
+
+    assert_response :success
+    assert_select "##{dom_id(@own_bot)}" do
+      assert_select "strong", text: @own_bot.name
+      assert_select "a[href='#{edit_bot_path(@own_bot)}'][aria-label='Edit #{@own_bot.name}']"
+      assert_select "label[for='#{dom_id(@own_bot, :code)}']", text: "Bot code"
+      assert_select "input[id='#{dom_id(@own_bot, :code)}'][readonly]", value: @own_bot.code
+    end
+    assert_select "##{dom_id(@other_bot)}", count: 0
+    assert_select "turbo-frame", count: 0
+  end
+
+  test "administrators see every bot" do
+    sign_in :david
+
+    get bots_url
+
+    assert_response :success
+    assert_select "##{dom_id(@own_bot)}"
+    assert_select "##{dom_id(@other_bot)}"
+  end
+
+  test "new form uses the bot labels" do
+    get new_bot_url
+
+    assert_response :success
+    assert_select "label[for='bot_name']", text: "Name the bot"
+    assert_select "input#bot_name[required][placeholder='Name the bot']"
+    assert_select "button[type='submit']", text: "Save changes"
+  end
+
+  test "creates a bot for the current member" do
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Build Bot" } }
+    end
+
+    assert_redirected_to bots_url
+    bot = Bot.find_by!(name: "Build Bot")
+    assert_equal users(:kevin), bot.creator
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+  end
+
+  test "does not create a bot without a name" do
+    assert_no_difference -> { Bot.count } do
+      post bots_url, params: { bot: { name: "" } }
+    end
+
+    assert_response :unprocessable_content
+    assert_select "button[type='submit']", text: "Save changes"
+  end
+
+  test "edits an owned bot" do
+    patch bot_url(@own_bot), params: { bot: { name: "Release Bot" } }
+
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", @own_bot.reload.name
+  end
+
+  test "a member cannot edit another member's bot" do
+    assert_raises ActiveRecord::RecordNotFound do
+      get edit_bot_url(@other_bot)
+    end
+  end
+
+  test "an administrator can edit another member's bot" do
+    sign_in :david
+
+    get edit_bot_url(@own_bot)
+
+    assert_response :success
+    assert_select "input#bot_name", value: @own_bot.name
+  end
+
+  test "edit form includes deletion with native confirmation" do
+    get edit_bot_url(@own_bot)
+
+    assert_response :success
+    assert_select "button", text: "Delete this chat bot" do
+      assert_select "[data-turbo-confirm]"
+    end
+  end
+
+  test "deletion invalidates the bot" do
+    code = @own_bot.code
+
+    delete bot_url(@own_bot)
+
+    assert_redirected_to bots_url
+    assert @own_bot.reload.deactivated?
+    assert_nil @own_bot.code
+    assert_nil Bot.active.find_by(code: code)
+  end
+end
diff --git a/test/controllers/rooms/bot_messages_controller_test.rb b/test/controllers/rooms/bot_messages_controller_test.rb
new file mode 100644
index 0000000..c99999a
--- /dev/null
+++ b/test/controllers/rooms/bot_messages_controller_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class Rooms::BotMessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+    @room = rooms(:pets)
+    @bot = users(:kevin).bots.create!(name: "Deploy Bot")
+  end
+
+  test "posts the raw request body as the bot" do
+    body = "Deploy of v1.2.3 finished ✅"
+
+    assert_difference -> { Message.count }, 1 do
+      post room_bot_messages_url(@room, @bot.code), params: body.dup,
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+
+    assert_response :created
+    message = Message.last
+    assert_equal body, message.plain_text_body
+    assert_equal @bot, message.creator
+    assert_equal message_path(message), response.location
+  end
+
+  test "keeps markup-like content as text" do
+    body = '<div class="deploy">finished</div>'
+
+    post room_bot_messages_url(@room, @bot.code), params: body.dup,
+      headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :created
+    message = Message.last
+    assert_equal body, message.plain_text_body
+    assert_includes message.body.to_s, "&lt;div"
+  end
+
+  test "broadcasts and enqueues push delivery like a human message" do
+    assert_enqueued_with(job: Room::PushMessageJob) do
+      assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+        post room_bot_messages_url(@room, @bot.code), params: "Broadcast me",
+          headers: { "CONTENT_TYPE" => "text/plain" }
+      end
+    end
+  end
+
+  test "rejects an empty body" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.code), params: ""
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "rejects a whitespace-only body" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.code), params: "  \n"
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "returns not found for an unknown room" do
+    post room_bot_messages_url(0, @bot.code), params: "Hello"
+
+    assert_response :not_found
+  end
+
+  test "returns unauthorized for an invalid bot code" do
+    post room_bot_messages_url(@room, "invalid-code"), params: "Hello"
+
+    assert_response :unauthorized
+  end
+
+  test "returns not found when the bot is not a room member" do
+    room = rooms(:designers)
+    assert_not @bot.rooms.include?(room)
+
+    post room_bot_messages_url(room, @bot.code), params: "Hello"
+
+    assert_response :not_found
+  end
+
+  test "a deleted bot cannot post" do
+    code = @bot.code
+    @bot.deactivate
+
+    post room_bot_messages_url(@room, code), params: "Hello"
+
+    assert_response :unauthorized
+  end
+
+  test "does not require browser authentication or a csrf token" do
+    post room_bot_messages_url(@room, @bot.code), params: "From a shell",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :created
+  end
+end
diff --git a/test/models/bot_test.rb b/test/models/bot_test.rb
new file mode 100644
index 0000000..9efaf0e
--- /dev/null
+++ b/test/models/bot_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class BotTest < ActiveSupport::TestCase
+  test "creates a code and joins every open room" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:kevin))
+
+    assert bot.code.present?
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+    assert bot.bot?
+    assert_not users(:kevin).bot?
+  end
+
+  test "codes are unique" do
+    first = Bot.create!(name: "First", creator: users(:kevin))
+    second = Bot.create!(name: "Second", creator: users(:kevin))
+
+    assert_not_equal first.code, second.code
+  end
+
+  test "requires a name" do
+    bot = Bot.new(creator: users(:kevin))
+
+    assert_not bot.save
+    assert bot.errors.added?(:name, :blank)
+  end
+
+  test "deactivation invalidates the code and preserves authored messages" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:kevin))
+    message = rooms(:pets).messages.create!(body: "Deployed", creator: bot)
+
+    bot.deactivate
+
+    assert bot.reload.deactivated?
+    assert_nil bot.code
+    assert_equal bot, message.reload.creator
+  end
+end
