diff --git a/test/models/bot/webhook_test.rb b/test/models/bot/webhook_test.rb
new file mode 100644
index 0000000..e689433
--- /dev/null
+++ b/test/models/bot/webhook_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+
+class Bot::WebhookTest < ActiveSupport::TestCase
+  setup do
+    @room = rooms(:pets)
+    @bot = users(:kevin).bots.create!(
+      name: "Deploy Bot",
+      webhook_url: "http://bots.example.test/campfire"
+    )
+    @author = users(:david)
+    @message = @room.messages.create!(
+      creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} restart <strong>the build</strong> please</div>",
+      client_message_id: "webhook-message"
+    )
+
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve)
+      .with("bots.example.test").returns("93.184.216.34")
+  end
+
+  test "posts the mention payload as JSON" do
+    request = nil
+    stub_request(:post, @bot.webhook_url).with do |candidate|
+      request = candidate
+      candidate.headers["Content-Type"] == "application/json"
+    end.to_return(status: 204)
+
+    Bot::Webhook.new(bot: @bot, message: @message).deliver
+
+    assert request
+    assert_equal({
+      "event" => "mention",
+      "author" => { "id" => @author.id, "name" => @author.name },
+      "room" => {
+        "id" => @room.id,
+        "name" => @room.name,
+        "reply_to" => Rails.application.routes.url_helpers.room_bot_messages_path(@room, @bot.code)
+      },
+      "message" => {
+        "id" => @message.id,
+        "body" => {
+          "text" => "restart the build please",
+          "html" => @message.body.body.to_html
+        },
+        "link" => Rails.application.routes.url_helpers.room_at_message_path(@room, @message)
+      }
+    }, JSON.parse(request.body))
+  end
+
+  test "posts a plain text response as the bot" do
+    stub_request(:post, @bot.webhook_url).to_return(
+      status: 200,
+      headers: { "Content-Type" => "text/plain; charset=utf-8" },
+      body: "Build restarted <strong>safely</strong>"
+    )
+
+    assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+      assert_difference -> { Message.count }, 1 do
+        Bot::Webhook.new(bot: @bot, message: @message).deliver
+      end
+    end
+
+    reply = Message.last
+    assert_equal @bot, reply.creator
+    assert_equal "Build restarted <strong>safely</strong>", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "&lt;strong&gt;"
+  end
+
+  test "posts an HTML response as rich text" do
+    stub_request(:post, @bot.webhook_url).to_return(
+      status: 200,
+      headers: { "Content-Type" => "text/html; charset=utf-8" },
+      body: "<p>Build <strong>restarted</strong></p>"
+    )
+
+    assert_difference -> { Message.count }, 1 do
+      Bot::Webhook.new(bot: @bot, message: @message).deliver
+    end
+
+    reply = Message.last
+    assert_equal @bot, reply.creator
+    assert_equal "Build restarted", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "<strong>restarted</strong>"
+  end
+
+  test "does not post a message for 204" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      Bot::Webhook.new(bot: @bot, message: @message).deliver
+    end
+  end
+
+  test "does not post unsupported 200 content" do
+    stub_request(:post, @bot.webhook_url).to_return(
+      status: 200,
+      headers: { "Content-Type" => "application/json" },
+      body: '{"ignored":true}'
+    )
+
+    assert_no_difference -> { Message.count } do
+      Bot::Webhook.new(bot: @bot, message: @message).deliver
+    end
+  end
+end
