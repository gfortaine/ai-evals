diff --git a/app/models/bot/webhook.rb b/app/models/bot/webhook.rb
new file mode 100644
index 0000000..c1bd66f
--- /dev/null
+++ b/app/models/bot/webhook.rb
@@ -0,0 +1,111 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class Bot::Webhook
+  MAX_RESPONSE_BODY_SIZE = 1.megabyte
+  REQUEST_TIMEOUT = 10
+
+  class ResponseTooLarge < StandardError; end
+
+  attr_reader :bot, :message
+
+  def initialize(bot:, message:)
+    @bot = bot
+    @message = message
+  end
+
+  def deliver
+    return unless deliverable?
+
+    Net::HTTP.start(uri.host, uri.port, ipaddr: resolved_ip, use_ssl: uri.scheme == "https") do |http|
+      http.open_timeout = REQUEST_TIMEOUT
+      http.read_timeout = REQUEST_TIMEOUT
+      http.request(request) { |response| handle(response) }
+    end
+  end
+
+  private
+    def deliverable?
+      bot.active? && bot.webhook_url.present? && bot.rooms.exists?(id: message.room_id) && !message.creator.bot?
+    end
+
+    def uri
+      @uri ||= URI.parse(bot.webhook_url)
+    end
+
+    def resolved_ip
+      @resolved_ip ||= RestrictedHTTP::PrivateNetworkGuard.resolve(uri.host)
+    end
+
+    def request
+      Net::HTTP::Post.new(uri.request_uri, "Content-Type" => "application/json").tap do |request|
+        request.body = payload.to_json
+      end
+    end
+
+    def payload
+      {
+        event: "mention",
+        author: { id: message.creator_id, name: message.creator.name },
+        room: { id: message.room_id, name: message.room.name, reply_to: reply_to_path },
+        message: {
+          id: message.id,
+          body: { text: command_text, html: message.body.body.to_html },
+          link: message_link_path
+        }
+      }
+    end
+
+    def command_text
+      message.body.body.render_attachments(with_full_attributes: false) do |attachment|
+        attachment.attachable == bot ? "" : attachment.to_plain_text
+      end.fragment.to_plain_text.gsub(/[ \t]+/, " ").strip
+    end
+
+    def handle(response)
+      case response
+      when Net::HTTPOK
+        if reply_content_type?(response)
+          post_reply(response)
+        else
+          Rails.logger.warn "Bot webhook returned unsupported content type for bot #{bot.id}"
+        end
+      when Net::HTTPNoContent
+        nil
+      else
+        Rails.logger.warn "Bot webhook returned unexpected #{response.code} for bot #{bot.id}"
+      end
+    end
+
+    def reply_content_type?(response)
+      response.content_type.in?(%w[ text/plain text/html ])
+    end
+
+    def post_reply(response)
+      body = read_body(response)
+      bot.post_message(message.room, body:, content_type: response.content_type)
+    end
+
+    def read_body(response)
+      raise ResponseTooLarge if response.content_length.to_i > MAX_RESPONSE_BODY_SIZE
+
+      StringIO.new.tap do |body|
+        response.read_body do |chunk|
+          raise ResponseTooLarge if body.string.bytesize + chunk.bytesize > MAX_RESPONSE_BODY_SIZE
+          body << chunk
+        end
+      end.string.force_encoding(Encoding::UTF_8)
+    end
+
+    def reply_to_path
+      routes.room_bot_messages_path(room_id: message.room_id, bot_code: bot.code)
+    end
+
+    def message_link_path
+      routes.room_at_message_path(room_id: message.room_id, message_id: message.id)
+    end
+
+    def routes
+      Rails.application.routes.url_helpers
+    end
+end
