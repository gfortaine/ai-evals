diff --git a/lib/rails_ext/resque_job_shutdown.rb b/lib/rails_ext/resque_job_shutdown.rb
new file mode 100644
index 0000000..b84f0e8
--- /dev/null
+++ b/lib/rails_ext/resque_job_shutdown.rb
@@ -0,0 +1,8 @@
+module ResqueJobShutdown
+  def shutdown
+    ActiveJob::Base.queue_adapter.stopping = true
+    super
+  end
+end
+
+Resque::Worker.prepend ResqueJobShutdown
diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..42ebe8b
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  test "resumes at the next leaf after an interruption" do
+    leaves = Leaf.order(:id).to_a
+    leaves.first.update!(title: %q(""An entirely quoted title""))
+    leaves.second.update!(title: %q(""Opening quote" remains"))
+    leaves.third.update!(title: %q("Third title"))
+    leaves.fourth.update!(title: %q("Fourth title"))
+
+    TitleCleanupJob.perform_later
+
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: leaves.first.id + 1) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal %q("An entirely quoted title"), leaves.first.reload.title
+    assert_equal %q(""Opening quote" remains"), leaves.second.reload.title
+    assert_nil enqueued_jobs.sole[:at]
+
+    perform_enqueued_jobs
+
+    assert_equal %q("An entirely quoted title"), leaves.first.reload.title
+    assert_equal %q("Opening quote" remains), leaves.second.reload.title
+    assert_equal "Third title", leaves.third.reload.title
+    assert_equal "Fourth title", leaves.fourth.reload.title
+  end
+
+  test "leaves unpaired quotes intact" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: %q("Opening quote" remains))
+
+    TitleCleanupJob.perform_now
+
+    assert_equal %q("Opening quote" remains), leaf.reload.title
+  end
+
+  test "resque shutdown marks the active job adapter as stopping" do
+    adapter = ActiveJob::Base.queue_adapter
+    previous_stopping = adapter.stopping
+    adapter.stopping = false
+
+    Resque::Worker.new("*").shutdown
+
+    assert_predicate adapter, :stopping?
+  ensure
+    adapter.stopping = previous_stopping
+  end
+end
