+++ b/test/models/webhook/delivery_test.rb
@@ -9,6 +9,137 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
     assert_equal "pending", delivery.state
   end
 
+  test "matching events create one delivery and enqueue it once" do
+    webhook = webhooks(:active)
+    event = nil
+
+    assert_enqueued_with(job: Webhook::DeliveryJob) do
+      assert_difference -> { webhook.deliveries.count }, 1 do
+        event = webhook.board.events.create!(
+          action: "card_published",
+          creator: users(:david),
+          eventable: cards(:logo)
+        )
+      end
+    end
+
+    assert_equal [ event ], webhook.deliveries.where(event: event).map(&:event)
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      event.relay_webhooks
+      event.relay_webhooks
+    end
+  end
+
+  test "events that are not subscribed do not create deliveries" do
+    webhook = webhooks(:active)
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      webhook.board.events.create!(
+        action: "card_board_changed",
+        creator: users(:david),
+        eventable: cards(:logo)
+      )
+    end
+  end
+
+  test "delivers a signed POST and never posts the same delivery twice" do
+    webhook = webhooks(:active)
+    event = events(:logo_assignment_david)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+    body = webhook.payload_for(event)
+    timestamp = event.created_at.utc.iso8601(3)
+    signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+
+    post = stub_request(:post, webhook.url)
+      .with(
+        body: body,
+        headers: {
+          "Content-Type" => "application/json",
+          "User-Agent" => "fizzy/1.0.0 Webhook",
+          "X-Webhook-Signature" => signature,
+          "X-Webhook-Timestamp" => timestamp
+        }
+      )
+      .to_return(status: 202)
+
+    delivery.deliver
+    delivery.reload
+
+    assert_requested post, times: 1
+    assert delivery.completed?
+    assert delivery.succeeded?
+    assert_equal 202, delivery.response["code"]
+    assert_equal signature, delivery.request.dig("headers", "X-Webhook-Signature")
+    assert_equal timestamp, delivery.request.dig("headers", "X-Webhook-Timestamp")
+
+    delivery.deliver
+
+    assert_requested post, times: 1
+  end
+
+  test "records unsuccessful responses and tracks a failure" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:logo_assignment_david))
+
+    stub_request(:post, webhook.url).to_return(status: 503)
+
+    delivery.deliver
+    delivery.reload
+
+    assert delivery.completed?
