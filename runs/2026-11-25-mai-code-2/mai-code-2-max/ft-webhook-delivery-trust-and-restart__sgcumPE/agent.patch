diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..51cdd77
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,52 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_LIMIT = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record(delivery)
+    if delivery.succeeded?
+      record_success
+    elsif delivery.failed?
+      record_failure
+    end
+  end
+
+  def record_success
+    with_lock do
+      if consecutive_failures_count.nonzero? || first_failure_at.present?
+        reset_failures_without_lock
+      end
+    end
+  end
+
+  def record_failure
+    deactivate = with_lock do
+      now = Time.current
+
+      if first_failure_at.blank? || first_failure_at <= FAILURE_WINDOW.ago
+        update!(consecutive_failures_count: 1, first_failure_at: now)
+      else
+        update!(consecutive_failures_count: consecutive_failures_count + 1)
+      end
+
+      delinquent?
+    end
+
+    webhook.deactivate if deactivate
+  end
+
+  def reset_failures
+    with_lock { reset_failures_without_lock }
+  end
+
+  private
+    def delinquent?
+      consecutive_failures_count >= FAILURE_LIMIT && first_failure_at > FAILURE_WINDOW.ago
+    end
+
+    def reset_failures_without_lock
+      update!(consecutive_failures_count: 0, first_failure_at: nil)
+    end
+end
