+class EnforceUniqueWebhookDeliveryRecords < ActiveRecord::Migration[8.2]
+  class WebhookDeliveryRecord < ActiveRecord::Base
+    self.table_name = "webhook_deliveries"
+  end
+
+  class DelinquencyTrackerRecord < ActiveRecord::Base
+    self.table_name = "webhook_delinquency_trackers"
+  end
+
+  def up
+    remove_duplicates(WebhookDeliveryRecord, :webhook_id, :event_id)
+    remove_duplicates(DelinquencyTrackerRecord, :webhook_id)
+
+    add_index :webhook_deliveries, [ :webhook_id, :event_id ], unique: true
+
+    remove_index :webhook_delinquency_trackers, :webhook_id
+    add_index :webhook_delinquency_trackers, :webhook_id, unique: true
+  end
+
+  def down
+    remove_index :webhook_deliveries, [ :webhook_id, :event_id ]
+    remove_index :webhook_delinquency_trackers, :webhook_id
+    add_index :webhook_delinquency_trackers, :webhook_id
+  end
+
+  private
+    def remove_duplicates(model, *columns)
+      model.group(*columns).having("COUNT(*) > 1").pluck(*columns).each do |values|
+        values = Array(values)
+        conditions = columns.zip(values).to_h
+        ids = model.where(conditions).order(:id).pluck(:id)
+        model.where(id: ids.drop(1)).delete_all
+      end
+    end
+end
