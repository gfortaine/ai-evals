+require "net/http"
+require "openssl"
+
 class Webhook::Delivery < ApplicationRecord
+  OPEN_TIMEOUT = 5.seconds
+  READ_TIMEOUT = 10.seconds
+  RETENTION_PERIOD = 1.week
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -8,7 +15,32 @@ class Webhook::Delivery < ApplicationRecord
 
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
+  after_create_commit :deliver_later
+
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :expired, -> { where(created_at: ...RETENTION_PERIOD.ago) }
+
+  class << self
+    def cleanup
+      expired.delete_all
+    end
+  end
+
+  def deliver
+    if claim_for_delivery
+      result = post_to_webhook
+      update!(state: result[:error] ? :errored : :completed, response: result)
+      webhook.record_delivery(self)
+    end
+
+    self
+  end
+
+  def deliver_later
+    Current.with_account(account) do
+      Webhook::DeliveryJob.perform_later(self)
+    end
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -27,6 +59,66 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response.present? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def claim_for_delivery
+      with_lock do
+        if pending?
+          if webhook.active?
+            in_progress!
+          else
+            update!(state: :errored, response: { error: "webhook_inactive" })
+            false
+          end
+        else
+          false
+        end
+      end
+    end
+
+    def post_to_webhook
+      body = webhook.payload_for(event)
+      timestamp = event.created_at.utc.iso8601(3)
+      headers = {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body),
+        "X-Webhook-Timestamp" => timestamp
+      }
+
+      update!(request: { headers: headers })
+
+      uri = URI.parse(webhook.url)
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+      http.max_retries = 0
+
+      response = http.start { |connection| connection.request(request) }
+      { code: response.code.to_i }
+    rescue StandardError => error
+      Rails.error.report(error, handled: true, context: { delivery_id: id }, source: "webhook_delivery")
+      { error: failure_name(error) }
+    end
+
+    def failure_name(error)
+      case error
+      when Net::OpenTimeout, Errno::ETIMEDOUT
+        "connection_timeout"
+      when Net::ReadTimeout
+        "read_timeout"
+      when SocketError, Socket::ResolutionError, SystemCallError
+        "destination_unreachable"
+      when OpenSSL::SSL::SSLError
+        "tls_error"
+      else
+        error.class.name
+      end
+    end
 end
