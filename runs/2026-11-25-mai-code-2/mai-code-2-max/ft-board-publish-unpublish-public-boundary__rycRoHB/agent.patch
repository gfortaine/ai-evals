diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..44cdeaa
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admin can publish a board" do
+    assert_changes -> { @board.reload.public_key }, from: nil do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to board_path(@board)
+  end
+
+  test "admin can unpublish a board" do
+    @board.publish
+
+    assert_changes -> { @board.reload.public_key }, to: nil do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to board_path(@board)
+  end
+
+  test "board creators cannot publish unless they are admins" do
+    logout_and_sign_in_as :david
+
+    post board_publication_path(@board)
+
+    assert_response :forbidden
+    assert_nil @board.reload.public_key
+  end
+
+  test "members cannot unpublish a board" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    delete board_publication_path(@board)
+
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "admins cannot publish inaccessible boards" do
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(boards(:private))
+
+    assert_response :not_found
+  end
+
+  test "create as JSON returns a public URL" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert_equal public_board_url(@board.reload.public_key, script_name: nil), @response.parsed_body["public_url"]
+  end
+
+  test "destroy as JSON" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_nil @board.reload.public_key
+  end
+
+  test "board JSON is not public by default" do
+    get board_path(@board), as: :json
+
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+  end
+end
diff --git a/test/controllers/public/boards/cards_controller_test.rb b/test/controllers/public/boards/cards_controller_test.rb
