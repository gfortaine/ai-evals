diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..4c08801
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,31 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  PUBLIC_KEY_LENGTH = 24
+
+  included do
+    scope :published, -> { where.not(public_key: nil) }
+  end
+
+  def publish
+    with_lock do
+      update!(public_key: generate_public_key) unless published?
+    end
+  end
+
+  def unpublish
+    update!(public_key: nil) if published?
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  private
+    def generate_public_key
+      loop do
+        key = SecureRandom.base58(PUBLIC_KEY_LENGTH)
+        break key unless Board.exists?(public_key: key)
+      end
+    end
+end
