@@ -0,0 +1,72 @@
+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show is available without authentication" do
+    card = cards(:logo)
+
+    untenanted do
+      get public_board_card_path(@board.public_key, card)
+    end
+
+    assert_response :success
+    assert_select "h1", text: card.title
+  end
+
+  test "drafted cards are not public" do
+    draft = @board.cards.create!(title: "Private draft", creator: users(:david), status: :drafted)
+
+    untenanted do
+      get public_board_card_path(@board.public_key, draft)
+    end
+
+    assert_response :not_found
+  end
+
+  test "cards are scoped to the public board" do
+    untenanted do
+      get public_board_card_path(@board.public_key, cards(:radio).number)
+    end
+
+    assert_response :success
+    assert_match ERB::Util.html_escape(cards(:logo).title), response.body
+    assert_no_match cards(:radio).title, response.body
+  end
+
+  test "show as JSON" do
+    card = cards(:logo)
+
+    untenanted do
+      get public_board_card_path(@board.public_key, card), as: :json
+    end
+
+    assert_response :success
+    assert_equal card.number, @response.parsed_body["number"]
+    assert_equal public_board_card_url(@board.public_key, card, script_name: nil), @response.parsed_body["url"]
+  end
+
+  test "published card images are publicly accessible" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    untenanted do
+      get rails_blob_path(card.image, only_path: true)
+    end
+
+    assert_response :redirect
+    assert_not_includes response.location, session_menu_path
+
+    @board.unpublish
+
+    untenanted do
+      get rails_blob_path(card.image, only_path: true)
+    end
+
+    assert_response :redirect
+    assert_includes response.location, "/session/new"
+  end
+end
