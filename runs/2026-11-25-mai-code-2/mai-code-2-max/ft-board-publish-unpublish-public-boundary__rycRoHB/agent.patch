diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..de0192c
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are private by default" do
+    assert_not @board.published?
+    assert_nil @board.public_key
+  end
+
+  test "publish generates a stable public key" do
+    @board.publish
+
+    assert @board.published?
+    assert_match(/\A[#{SecureRandom::BASE58_ALPHABET.join}]{#{Board::Publishable::PUBLIC_KEY_LENGTH}}\z/, @board.public_key)
+
+    public_key = @board.public_key
+    @board.publish
+
+    assert_equal public_key, @board.public_key
+  end
+
+  test "unpublish revokes the public key" do
+    @board.publish
+    old_public_key = @board.public_key
+
+    @board.unpublish
+
+    assert_not @board.reload.published?
+    assert_nil @board.public_key
+
+    @board.publish
+    assert_not_equal old_public_key, @board.public_key
+  end
+
+  test "published cards are publicly accessible only while their board is published" do
+    card = cards(:logo)
+
+    @board.publish
+    assert card.publicly_accessible?
+    assert card.comments.first.publicly_accessible?
+
+    card.drafted!
+    assert_not card.publicly_accessible?
+
+    card.published!
+    @board.unpublish
+    assert_not card.publicly_accessible?
+  end
+end
