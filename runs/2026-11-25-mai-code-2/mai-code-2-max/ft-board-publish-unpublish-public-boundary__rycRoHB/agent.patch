@@ -0,0 +1,13 @@
+class Public::BoardsController < Public::BaseController
+  include Public::BoardScoped
+
+  def show
+    @columns = @board.columns.sorted
+    @column_cards = @board.cards.active.latest.with_golden_first.preloaded.group_by(&:column_id)
+    @stream_cards = @board.cards.awaiting_triage.latest.with_golden_first.preloaded
+    @postponed_cards = @board.cards.postponed.latest.preloaded
+    @closed_cards = @board.cards.closed.published.recently_closed_first.preloaded
+
+    fresh_when etag: [ @board, @columns, @column_cards.values, @stream_cards, @postponed_cards, @closed_cards ]
+  end
+end
