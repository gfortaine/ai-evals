diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..70c4229 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,28 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :track_publication_transition, if: :saved_change_to_published?
+    after_update_commit :clear_publication_transition
+    after_rollback :clear_publication_transition
   end
 
   private
-    def announce_publication
-      AnnouncePublicationJob.perform_later self
+    def track_publication_transition
+      return if instance_variable_defined?(:@published_before_transaction)
+
+      @published_before_transaction = saved_change_to_published.first
+      schedule_publication_announcement unless @published_before_transaction
+    end
+
+    def schedule_publication_announcement
+      ActiveRecord.after_all_transactions_commit do
+        AnnouncePublicationJob.perform_later(self) if self.class.published.exists?(id)
+      ensure
+        clear_publication_transition
+      end
+    end
+
+    def clear_publication_transition
+      remove_instance_variable(:@published_before_transaction) if instance_variable_defined?(:@published_before_transaction)
     end
 end
