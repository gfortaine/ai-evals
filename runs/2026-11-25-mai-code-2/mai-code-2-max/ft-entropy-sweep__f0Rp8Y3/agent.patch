diff --git a/test/jobs/card/auto_postpone_all_due_job_test.rb b/test/jobs/card/auto_postpone_all_due_job_test.rb
new file mode 100644
index 0000000..7547bc6
--- /dev/null
+++ b/test/jobs/card/auto_postpone_all_due_job_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class Card::AutoPostponeAllDueJobTest < ActiveJob::TestCase
+  test "auto postpones due cards" do
+    Card.expects(:auto_postpone_all_due).once
+
+    Card::AutoPostponeAllDueJob.perform_now
+  end
+
+  test "does not overlap delayed sweeps" do
+    assert_equal 1, Card::AutoPostponeAllDueJob.concurrency_limit
+    assert_equal :discard, Card::AutoPostponeAllDueJob.concurrency_on_conflict
+    assert_equal 2.hours, Card::AutoPostponeAllDueJob.concurrency_duration
+  end
+
+  test "is configured as the recurring entropy sweep" do
+    config = Rails.application.config_for(:recurring, env: :production)
+
+    assert_equal "Card::AutoPostponeAllDueJob", config.dig(:auto_postpone_all_due, :class)
+    assert_equal "solid_queue_recurring", Card::AutoPostponeAllDueJob.new.queue_name
+  end
+end
