+++ b/test/models/book/editing_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Book::EditingTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  self.use_transactional_tests = false
+
+  test "edit jobs are handed off after the outermost transaction commits" do
+    book = books(:handbook)
+    cover = file_fixture("reading.webp")
+    expected_fingerprint = Digest::SHA256.file(cover).hexdigest
+
+    File.open(cover) do |file|
+      Book.transaction do
+        book.apply_edit title: "Revised handbook", cover: {
+          io: file,
+          filename: "cover.webp",
+          content_type: "image/webp"
+        }
+
+        assert_no_enqueued_jobs only: Book::CoverProcessingJob
+        assert_no_enqueued_jobs only: Book::SearchIndexJob
+      end
+    end
+
+    assert_enqueued_jobs 1, only: Book::CoverProcessingJob
+    assert_enqueued_jobs 1, only: Book::SearchIndexJob
+
+    perform_enqueued_jobs only: Book::CoverProcessingJob, at: 6.seconds.from_now
+    assert_equal expected_fingerprint, book.reload.cover.blob.metadata["sha256"]
+
+    cache_writes = capture_cache_writes do
+      perform_enqueued_jobs only: Book::SearchIndexJob
+    end
+    assert_includes cache_writes, "search_index/book/#{book.id}"
+  end
+
+  test "edit jobs are discarded when the outermost transaction rolls back" do
+    book = books(:handbook)
+
+    File.open(file_fixture("reading.webp")) do |file|
+      Book.transaction do
+        book.apply_edit title: "Abandoned handbook", cover: {
+          io: file,
+          filename: "cover.webp",
+          content_type: "image/webp"
+        }
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_no_enqueued_jobs only: Book::CoverProcessingJob
+    assert_no_enqueued_jobs only: Book::SearchIndexJob
+    assert_equal "Handbook", book.reload.title
+    assert_not book.cover.attached?
+  end
+
+  private
+    def capture_cache_writes
+      keys = []
+      subscriber = ActiveSupport::Notifications.subscribe("cache_write.active_support") do |*, payload|
+        keys << payload[:key]
+      end
+
+      yield
+      keys
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+    end
+end
