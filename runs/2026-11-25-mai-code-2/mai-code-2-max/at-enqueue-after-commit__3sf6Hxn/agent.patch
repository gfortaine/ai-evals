diff --git a/test/controllers/books/imports_controller_test.rb b/test/controllers/books/imports_controller_test.rb
new file mode 100644
index 0000000..715c4f5
--- /dev/null
+++ b/test/controllers/books/imports_controller_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Books::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "a failed batch enqueues a notification but no edit jobs" do
+    book = books(:handbook)
+    missing_book_id = Book.maximum(:id) + 1
+
+    post books_import_url, params: {
+      books: {
+        book.id => {
+          title: "Abandoned handbook",
+          cover: fixture_file_upload("reading.webp", "image/webp")
+        },
+        missing_book_id => { title: "Missing book" }
+      }
+    }
+
+    assert_response :not_found
+    assert_no_enqueued_jobs only: [ Book::CoverProcessingJob, Book::SearchIndexJob ]
+    assert_enqueued_jobs 1, only: Books::ImportFailureJob
+    assert_equal "Handbook", book.reload.title
+    assert_not book.cover.attached?
+
+    notifications = capture_cache_writes do
+      perform_enqueued_jobs only: Books::ImportFailureJob
+    end
+    assert_includes notifications, "import_failure/#{users(:kevin).id}"
+  end
+
+  private
+    def capture_cache_writes
+      keys = []
+      subscriber = ActiveSupport::Notifications.subscribe("cache_write.active_support") do |*, payload|
+        keys << payload[:key]
+      end
+
+      yield
+      keys
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+    end
+end
diff --git a/test/models/book/editing_test.rb b/test/models/book/editing_test.rb
