+  def test_mail_link_tokens_keep_the_rails_6_1_key_derivation
+    key_generator =
+      ActiveSupport::KeyGenerator.new(
+        Rails.application.secret_key_base,
+        :iterations => 1000,
+        :hash_digest_class => OpenSSL::Digest::SHA1
+      )
+    verifier = ActiveSupport::MessageVerifier.new(key_generator.generate_key(:mail_links.to_s))
+    data = {'user_id' => 3, 'issue_id' => 2}
+
+    legacy_token = verifier.generate(data, :purpose => :unwatch, :expires_in => 30.days)
+    current_token = Mailer.mail_link_token(:unwatch, data)
+
+    assert_equal data, Mailer.verify_mail_link(legacy_token, :unwatch)
+    assert_equal data, verifier.verify(current_token, :purpose => :unwatch)
+  end
