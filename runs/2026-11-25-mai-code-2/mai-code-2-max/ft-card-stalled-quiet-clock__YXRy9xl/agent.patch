diff --git a/app/models/card/engageable.rb b/app/models/card/engageable.rb
new file mode 100644
index 0000000..02f90c9
--- /dev/null
+++ b/app/models/card/engageable.rb
@@ -0,0 +1,72 @@
+module Card::Engageable
+  extend ActiveSupport::Concern
+
+  STALL_AFTER = 2.weeks
+  BURST_COMMENT_COUNT = 3
+  BURST_CREATOR_COUNT = 2
+  BURST_EVENT_ACTIONS = %w[ card_assigned card_reopened ].freeze
+
+  included do
+    has_one :engagement, dependent: :destroy, class_name: "Card::Engagement"
+
+    after_update :record_engagement_activity, if: :saved_change_to_last_active_at?
+
+    scope :engaged, -> { joins(:engagement) }
+    scope :stalled, ->(as_of = Time.current) do
+      active.engaged.where(last_active_at: ..(as_of - STALL_AFTER))
+    end
+  end
+
+  def engaged?
+    engagement.present?
+  end
+
+  def stalled?(as_of = Time.current)
+    active? && engaged? && last_active_at <= as_of - STALL_AFTER
+  end
+
+  def engage
+    engagement_record = engagement || Card::Engagement.create_or_find_by!(card: self) do |record|
+      record.account = account
+      record.status = "doing"
+    end
+
+    association(:engagement).target = engagement_record
+    touch_last_active_at
+    engagement_record
+  end
+
+  def register_comment_burst(comment)
+    engage if comment_burst?(comment)
+  end
+
+  def engage_if_burst_event(event)
+    engage if event.action.in?(BURST_EVENT_ACTIONS)
+  end
+
+  def comment_burst?(comment)
+    return false if comment.creator.system?
+
+    comments_count, creators_count = comments.by_user
+      .where(created_at: (comment.created_at - comment_burst_period)..comment.created_at)
+      .pick(
+        Arel.sql("COUNT(*)"),
+        Arel.sql("COUNT(DISTINCT comments.creator_id)")
+      )
+
+    comments_count >= BURST_COMMENT_COUNT && creators_count >= BURST_CREATOR_COUNT
+  end
+
+  def cache_key_with_version
+    "#{super}/#{stalled? ? "stalled" : "not-stalled"}"
+  end
+
+  private
+    def record_engagement_activity
+      engagement&.update_columns(updated_at: last_active_at)
+    end
+
+    def comment_burst_period
+      board.auto_postpone_period.to_f / 3
+    end
+end
