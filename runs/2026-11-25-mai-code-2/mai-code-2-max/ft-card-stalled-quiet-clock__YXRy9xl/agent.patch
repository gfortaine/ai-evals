diff --git a/test/models/card/engageable_test.rb b/test/models/card/engageable_test.rb
new file mode 100644
index 0000000..712fcba
--- /dev/null
+++ b/test/models/card/engageable_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Card::EngageableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = boards(:writebook).cards.create!(title: "Engagement test", creator: users(:david), status: :published)
+  end
+
+  test "assignment marks a card as engaged" do
+    @card.toggle_assignment users(:jz)
+
+    assert_predicate @card.reload, :engaged?
+  end
+
+  test "reopening marks a card as engaged" do
+    @card.close
+    assert_not @card.engaged?
+
+    @card.reopen
+
+    assert_predicate @card.reload, :engaged?
+  end
+
+  test "a comment burst marks a card as engaged" do
+    create_comment users(:david), at: 3.days.ago
+    create_comment users(:david), at: 2.days.ago
+    create_comment users(:jz), at: 1.day.ago
+
+    assert_predicate @card.reload, :engaged?
+  end
+
+  test "comments must be from multiple people" do
+    [ 3, 2, 1 ].each do |days|
+      create_comment users(:david), at: days.days.ago
+    end
+
+    assert_not @card.reload.engaged?
+  end
+
+  test "comments must fit within a third of the auto-close period" do
+    burst_period = @card.board.auto_postpone_period / 3
+
+    create_comment users(:david), at: (burst_period + 2.days).seconds.ago
+    create_comment users(:jz), at: 2.days.ago
+    create_comment users(:david), at: 1.day.ago
+
+    assert_not @card.reload.engaged?
+  end
+
+  test "an engaged card is stalled after two inactive weeks" do
+    @card.engage
+    @card.update!(last_active_at: 2.weeks.ago - 1.second)
+
+    assert_predicate @card.reload, :stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "an old card without a burst is not stalled" do
+    @card.update!(last_active_at: 2.weeks.ago - 1.second)
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "new activity resets a stalled card" do
+    @card.engage
+    @card.update!(last_active_at: 3.weeks.ago)
+    assert_predicate @card.reload, :stalled?
+
+    create_comment users(:jz), at: Time.current
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  private
+    def create_comment(user, at:)
+      @card.comments.create!(creator: user, body: "Test comment", created_at: at)
+    end
+end
