diff --git a/db/migrate/20261123220000_create_card_engagements.rb b/db/migrate/20261123220000_create_card_engagements.rb
new file mode 100644
index 0000000..c8670e1
--- /dev/null
+++ b/db/migrate/20261123220000_create_card_engagements.rb
@@ -0,0 +1,135 @@
+class CreateCardEngagements < ActiveRecord::Migration[8.2]
+  BATCH_SIZE = 1000
+
+  class BackfillCard < ActiveRecord::Base
+    self.table_name = "cards"
+  end
+
+  class BackfillComment < ActiveRecord::Base
+    self.table_name = "comments"
+  end
+
+  class BackfillAssignment < ActiveRecord::Base
+    self.table_name = "assignments"
+  end
+
+  class BackfillEntropy < ActiveRecord::Base
+    self.table_name = "entropies"
+  end
+
+  class BackfillEvent < ActiveRecord::Base
+    self.table_name = "events"
+  end
+
+  class BackfillEngagement < ActiveRecord::Base
+    self.table_name = "card_engagements"
+  end
+
+  def change
+    create_table :card_engagements, id: :uuid do |t|
+      t.references :account, type: :uuid, null: false, index: true
+      t.references :card, type: :uuid, null: false, index: { unique: true }
+      t.string :status, null: false, default: "doing"
+      t.timestamps
+    end
+
+    add_index :card_engagements, [ :account_id, :status ]
+
+    reversible do |dir|
+      dir.up { backfill_engagements }
+    end
+  end
+
+  private
+    def backfill_engagements
+      board_periods = entropy_periods("Board")
+      account_periods = entropy_periods("Account")
+
+      BackfillCard.in_batches(of: BATCH_SIZE) do |batch|
+        cards = batch.pluck(:id, :account_id, :board_id)
+        burst_times = burst_times_from_events(cards.map(&:first))
+        burst_times_from_comments(burst_times, cards, board_periods, account_periods)
+        insert_engagements(cards, burst_times)
+      end
+    end
+
+    def entropy_periods(container_type)
+      BackfillEntropy.where(container_type: container_type).pluck(:container_id, :auto_postpone_period).to_h
+    end
+
+    def burst_times_from_events(card_ids)
+      {}.tap do |burst_times|
+        BackfillEvent
+          .where(eventable_type: "Card", eventable_id: card_ids, action: %w[ card_assigned card_reopened ])
+          .pluck(:eventable_id, :created_at)
+          .each { |card_id, at| record_burst_time(burst_times, card_id, at) }
+
+        BackfillAssignment
+          .where(card_id: card_ids)
+          .pluck(:card_id, :created_at)
+          .each { |card_id, at| record_burst_time(burst_times, card_id, at) }
+      end
+    end
+
+    def burst_times_from_comments(burst_times, cards, board_periods, account_periods)
+      card_periods = cards.to_h { |id, account_id, board_id| [ id, board_periods[board_id] || account_periods[account_id] ] }
+      comments_by_card = comment_rows(cards.map(&:first)).group_by(&:first)
+
+      comments_by_card.each do |card_id, rows|
+        if period = card_periods[card_id]
+          burst_at = comment_burst_at(rows.map { |_, creator_id, created_at| [ creator_id, created_at ] }, period)
+          record_burst_time(burst_times, card_id, burst_at) if burst_at
+        end
+      end
+    end
+
+    def comment_rows(card_ids)
+      BackfillComment
+        .joins("INNER JOIN users ON users.id = comments.creator_id")
+        .where(card_id: card_ids)
+        .where.not(users: { role: "system" })
+        .order(:card_id, :created_at)
+        .pluck(:card_id, :creator_id, :created_at)
+    end
+
+    def comment_burst_at(comments, period)
+      window = []
+      creators = Hash.new(0)
+      window_period = period.to_f / 3
+
+      comments.each do |creator_id, created_at|
+        window << [ creator_id, created_at ]
+        creators[creator_id] += 1
+
+        while window.any? && created_at - window.first.last > window_period
+          old_creator_id, = window.shift
+          creators[old_creator_id] -= 1
+          creators.delete(old_creator_id) if creators[old_creator_id].zero?
+        end
+
+        return created_at if window.length >= 3 && creators.length >= 2
+      end
+
+      nil
+    end
+
+    def record_burst_time(burst_times, card_id, at)
+      burst_times[card_id] = [ burst_times[card_id], at ].compact.min
+    end
+
+    def insert_engagements(cards, burst_times)
+      accounts_by_card = cards.to_h { |id, account_id, _| [ id, account_id ] }
+      records = burst_times.map do |card_id, burst_at|
+        {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: accounts_by_card[card_id],
+          card_id: card_id,
+          status: "doing",
+          created_at: burst_at,
+          updated_at: burst_at
+        }
+      end
+
+      BackfillEngagement.insert_all!(records) if records.any?
+    end
+end
