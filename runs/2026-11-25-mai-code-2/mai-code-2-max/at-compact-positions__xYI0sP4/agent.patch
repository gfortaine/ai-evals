diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..9c0ccd9 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,32 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+  test "compact positions preserves the current leaf order" do
+    book = books(:handbook)
+    expected_order = [ leaves(:summary_page), leaves(:reading_picture), leaves(:welcome_section), leaves(:welcome_page) ]
+    expected_order.each.with_index { |leaf, index| leaf.update_column(:position_score, index * 10 + 5) }
+
+    book.compact_positions!
+
+    assert_equal expected_order, book.leaves.positioned.reload
+    assert_equal [ 1, 2, 3, 4 ], book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compact positions preserves a trashed leaf's place when restored" do
+    book = books(:handbook)
+    expected_order = [ leaves(:summary_page), leaves(:welcome_page), leaves(:welcome_section), leaves(:reading_picture) ]
+    expected_order.each.with_index { |leaf, index| leaf.update_column(:position_score, index * 10 + 5) }
+    leaves(:welcome_page).trashed!
+
+    book.compact_positions!
+    leaves(:welcome_page).active!
+
+    assert_equal expected_order, book.leaves.active.positioned
+  end
+
+  test "live leaf count excludes trashed leaves" do
+    leaves(:summary_page).trashed!
+
+    assert_equal 3, books(:handbook).live_leaf_count
+  end
 end
