diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..6a63100 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,82 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "show caches entry controls by edit access" do
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+
+    with_fragment_caching do |cache|
+      get book_slug_path(book)
+      assert_editor_controls_for leaf, visible: true
+
+      sign_out
+      sign_in :jz
+      get book_slug_path(book)
+      assert_editor_controls_for leaf, visible: false
+
+      cache.clear
+      get book_slug_path(book)
+      assert_editor_controls_for leaf, visible: false
+
+      sign_out
+      sign_in :kevin
+      get book_slug_path(book)
+      assert_editor_controls_for leaf, visible: true
+    end
+  end
+
+  test "show expires cached entries after a rename" do
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+    old_title = leaf.title
+
+    with_fragment_caching do
+      get book_slug_path(book)
+      leaf.update! title: "A Better Welcome"
+
+      sign_out
+      sign_in :jason
+      get book_slug_path(book)
+
+      assert_select "#leaf_#{leaf.id} .toc__title", text: /A Better Welcome/
+      assert_not_in_body old_title
+    end
+  end
+
+  test "show checks edit access once for the whole contents list" do
+    assert_queries_match(/SELECT "accesses"\.\* FROM "accesses"/, count: 1) do
+      ActiveRecord::Base.uncached do
+        get book_slug_path(books(:handbook))
+      end
+    end
+  end
+
+  private
+    def assert_editor_controls_for(leaf, visible:)
+      expected_edit_links = visible ? 2 : 0
+      expected_controls = visible ? 1 : 0
+
+      assert_select "#leaf_#{leaf.id} a[href='#{edit_leafable_path(leaf)}']", count: expected_edit_links
+      assert_select "#leaf_#{leaf.id} .arrangement__handle", count: expected_controls
+      assert_select "#leaf_#{leaf.id} form.leaf__delete", count: expected_controls
+    end
+
+    def with_fragment_caching
+      original_perform_caching = BooksController.perform_caching
+      original_controller_cache = BooksController.cache_store
+      original_collection_cache = ActionView::PartialRenderer.collection_cache
+      cache = ActiveSupport::Cache::MemoryStore.new
+
+      BooksController.perform_caching = true
+      BooksController.cache_store = cache
+      ActionView::PartialRenderer.collection_cache = cache
+
+      yield cache
+    ensure
+      cache&.clear
+      BooksController.perform_caching = original_perform_caching
+      BooksController.cache_store = original_controller_cache
+      ActionView::PartialRenderer.collection_cache = original_collection_cache
+    end
 end
