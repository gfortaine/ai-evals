diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..787f828
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,51 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+  REACTABLE_TYPES = %w[ Card Comment ].freeze
+
+  belongs_to :account, default: -> { reactable.account if reactable }
+  belongs_to :reactable, polymorphic: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { preload(reacter: [ :account, :avatar_attachment, :identity ]) }
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+  validates :reactable_type, inclusion: { in: REACTABLE_TYPES }
+  validate :belongs_to_reactable_account
+
+  before_validation :strip_content
+
+  after_create -> { invalidate_reactable_cache }
+  after_destroy -> { invalidate_reactable_cache if destroyed_by_association.nil? }
+  after_create_commit -> { broadcast_reactions }
+  after_destroy_commit -> { broadcast_reactions if reactable_persisted? && destroyed_by_association.nil? }
+
+  delegate :card, to: :reactable
+
+  private
+    def strip_content
+      self.content = content&.strip
+    end
+
+    def invalidate_reactable_cache
+      reactable.update_column(:updated_at, Time.current)
+    end
+
+    def broadcast_reactions
+      reactable.broadcast_replace_later_to reactable.card,
+        target: [ reactable, :reaction_list ],
+        partial: "reactions/list",
+        locals: { reactable: reactable }
+    end
+
+    def belongs_to_reactable_account
+      if reactable
+        errors.add(:account, "must match the reactable account") if account && reactable.account_id != account_id
+        errors.add(:reacter, "must belong to the reactable account") if reacter && reactable.account_id != reacter.account_id
+      end
+    end
+
+    def reactable_persisted?
+      reactable.persisted?
+    end
+end
