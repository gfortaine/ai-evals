diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..dafbf54
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "renders the strip for every comment" do
+    get card_path(@comment.card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)}.reactions" do
+      assert_select ".reactions__trigger img[src*='boost-color']"
+      assert_select "form.reaction__form[hidden] input[name='reaction[content]'][maxlength='16']"
+      assert_select ".reaction__submit-btn"
+      assert_select ".reaction__cancel-btn"
+    end
+  end
+
+  test "creates a reaction from the strip" do
+    assert_difference -> { @comment.reactions.count }, 1 do
+      post card_comment_reactions_path(@comment.card, @comment),
+        params: { reaction: { content: "Looks good" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reactions)
+    assert_equal users(:kevin), Reaction.last.reacter
+    assert_equal "Looks good", Reaction.last.content
+  end
+
+  test "creates with flat JSON parameters" do
+    post card_comment_reactions_path(@comment.card, @comment),
+      params: { content: "👍" }, as: :json
+
+    assert_response :created
+    assert_equal "👍", Reaction.last.content
+    assert_equal card_comment_reaction_url(@comment.card, @comment, Reaction.last, format: :json), @response.headers["Location"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+  end
+
+  test "rejects reactions longer than sixteen characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@comment.card, @comment),
+        params: { reaction: { content: "x" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+    assert_includes @response.parsed_body["content"], "is too long (maximum is 16 characters)"
+  end
+
+  test "keeps the form open after a validation error" do
+    post card_comment_reactions_path(@comment.card, @comment),
+      params: { reaction: { content: "x" * 17 } }, as: :turbo_stream
+
+    assert_response :unprocessable_entity
+    assert_turbo_stream status: :unprocessable_entity, action: :replace, target: dom_id(@comment, :reactions) do
+      assert_select "form.reaction__form.expanded:not([hidden])"
+    end
+  end
+
+  test "lists reactions as JSON" do
+    reaction = @comment.reactions.create!(content: "Ship it", reacter: users(:david))
+
+    get card_comment_reactions_path(@comment.card, @comment), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body.first["id"]
+    assert_equal users(:david).id, @response.parsed_body.first.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(@comment.card, @comment, reaction), @response.parsed_body.first["url"]
+  end
+
+  test "removes your reaction" do
+    reaction = @comment.reactions.create!(content: "Thanks", reacter: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reactions)
+  end
+
+  test "cannot remove another person's reaction" do
+    reaction = @comment.reactions.create!(content: "Thanks", reacter: users(:david))
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "comment JSON links to reactions" do
+    get card_comment_path(@comment.card, @comment), as: :json
+
+    assert_response :success
+    assert_equal card_comment_reactions_url(@comment.card, @comment), @response.parsed_body["reactions_url"]
+  end
+end
diff --git a/test/controllers/cards/reactions_controller_test.rb b/test/controllers/cards/reactions_controller_test.rb
