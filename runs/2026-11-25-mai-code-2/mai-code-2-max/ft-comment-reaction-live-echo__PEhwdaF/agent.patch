@@ -0,0 +1,59 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reactership, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.chronologically.preloaded
+
+    respond_to do |format|
+      format.json { render "reactions/index" }
+    end
+  end
+
+  def create
+    @reaction = @comment.reactions.new(reaction_params)
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream { render "reactions/refresh", locals: { reactable: @comment } }
+        format.json { render "reactions/show", status: :created, location: card_comment_reaction_url(@card, @comment, @reaction, format: :json) }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { render "reactions/refresh", locals: { reactable: @comment, new_reaction: @reaction }, status: :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream { render "reactions/refresh", locals: { reactable: @comment } }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reactership
+      head :forbidden unless @reaction.reacter == Current.user
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
