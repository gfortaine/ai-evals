diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..60d868d
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,42 @@
+module ReactionsHelper
+  def reactions_path_for(reactable)
+    case reactable
+    when Card
+      card_reactions_path(reactable)
+    when Comment
+      card_comment_reactions_path(reactable.card, reactable)
+    else
+      raise ArgumentError, "Unsupported reactable: #{reactable.class.name}"
+    end
+  end
+
+  def reaction_path_for(reaction)
+    case reaction.reactable
+    when Card
+      card_reaction_path(reaction.reactable, reaction)
+    when Comment
+      card_comment_reaction_path(reaction.card, reaction.reactable, reaction)
+    else
+      raise ArgumentError, "Unsupported reactable: #{reaction.reactable.class.name}"
+    end
+  end
+
+  def reaction_url_for(reaction)
+    case reaction.reactable
+    when Card
+      card_reaction_url(reaction.reactable, reaction)
+    when Comment
+      card_comment_reaction_url(reaction.card, reaction.reactable, reaction)
+    else
+      raise ArgumentError, "Unsupported reactable: #{reaction.reactable.class.name}"
+    end
+  end
+
+  def ordered_reactions_for(reactable)
+    if reactable.reactions.loaded?
+      reactable.reactions.to_a.sort_by { [ it.created_at, it.id ] }
+    else
+      reactable.reactions.chronologically.preloaded
+    end
+  end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..e5a61f5
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,58 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "reaction", "trigger" ]
+
+  connect() {
+    if (this.hasFormTarget && !this.formTarget.hidden) {
+      this.inputTarget.focus()
+    }
+  }
+
+  reactionTargetConnected(reaction) {
+    if (this.#isOwned(reaction)) {
+      reaction.classList.add("reaction--deleteable")
+      reaction.setAttribute("tabindex", "0")
+      reaction.setAttribute("aria-expanded", "false")
+    } else {
+      reaction.classList.remove("reaction--deleteable")
+      reaction.removeAttribute("tabindex")
+      reaction.removeAttribute("aria-expanded")
+    }
+  }
+
+  open() {
+    this.triggerTarget.toggleAttribute("hidden", true)
+    this.formTarget.removeAttribute("hidden")
+    this.formTarget.classList.add("expanded")
+    requestAnimationFrame(() => this.inputTarget.focus())
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    this.formTarget.reset()
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.toggleAttribute("hidden", true)
+    this.triggerTarget.removeAttribute("hidden")
+    this.triggerTarget.focus()
+  }
+
+  submitted(event) {
+    if (event.detail.success) this.cancel()
+  }
+
+  toggle(event) {
+    const reaction = event.currentTarget
+
+    if (!this.#isOwned(reaction) || event.target.closest("a, button, form")) return
+
+    if (event.type === "keydown") event.preventDefault()
+
+    const expanded = reaction.classList.toggle("expanded")
+    reaction.setAttribute("aria-expanded", expanded)
+  }
+
+  #isOwned(reaction) {
+    return Current.user?.id === reaction.dataset.reacterId
+  }
+}
