index 0000000..420cc0c
--- /dev/null
+++ b/test/controllers/cards/reactions_controller_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+  end
+
+  test "creates a card reaction" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@card, :reactions)
+  end
+
+  test "removes only your card reactions" do
+    own_reaction = @card.reactions.create!(content: "Mine", reacter: users(:kevin))
+    other_reaction = @card.reactions.create!(content: "Theirs", reacter: users(:david))
+
+    delete card_reaction_path(@card, own_reaction), as: :json
+    assert_response :no_content
+
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, other_reaction), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "lists card reactions as JSON" do
+    reaction = @card.reactions.create!(content: "Great", reacter: users(:david))
+
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal card_reaction_url(@card, reaction), @response.parsed_body.sole["url"]
+  end
+
+  test "card JSON links to reactions" do
+    get card_path(@card), as: :json
+
+    assert_response :success
+    assert_equal card_reactions_url(@card), @response.parsed_body["reactions_url"]
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..ddfcafa
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "creates with the current reacter and reactable account" do
+    reaction = @comment.reactions.create!(content: "  Nice 👍  ")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal @comment.account, reaction.account
+    assert_equal "Nice 👍", reaction.content
+  end
+
+test "validates without a reactable" do
+  reaction = Reaction.new(content: "Hello")
+
+  assert_not reaction.valid?
+  assert_includes reaction.errors[:account], "must exist"
+  assert_includes reaction.errors[:reactable], "must exist"
+end
+
+  test "requires content" do
+    reaction = @comment.reactions.new(content: "   ")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "limits content to sixteen characters" do
+    valid_reaction = @comment.reactions.new(content: "👍" * Reaction::MAX_CONTENT_LENGTH)
+    invalid_reaction = @comment.reactions.new(content: "👍" * (Reaction::MAX_CONTENT_LENGTH + 1))
+
+    assert_predicate valid_reaction, :valid?
+    assert_not invalid_reaction.valid?
+    assert_includes invalid_reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "touches the reactable when created and destroyed" do
+    assert_changes -> { @comment.reload.updated_at } do
+      reaction = @comment.reactions.create!(content: "👍")
+
+      assert_changes -> { @comment.reload.updated_at } do
+        reaction.destroy!
+      end
+    end
+  end
+
+  test "broadcasts the reactions strip when created" do
+    target = ActionView::RecordIdentifier.dom_id(@comment, :reaction_list)
+    clear_enqueued_jobs
+    @comment.reactions.create!(content: "Great!")
+
+    action_jobs = enqueued_jobs.select { it[:job] == Turbo::Streams::ActionBroadcastJob }
+    assert action_jobs.any?, "Expected a reaction action job, got: #{enqueued_jobs.map { it[:job] }}"
+
+    broadcasts = capture_turbo_stream_broadcasts(@comment.card) do
+      perform_enqueued_jobs
+    end
+
+    reaction_broadcast = broadcasts.find do |broadcast|
+      broadcast["action"] == "replace" && broadcast["target"] == target
+    end
+
+    assert reaction_broadcast, "Expected a replace for #{target}, got: #{broadcasts.map(&:to_s)}"
+    assert_includes reaction_broadcast.to_s, "Great!"
+  end
+
+test "broadcasts the reactions strip when destroyed" do
+  reaction = @comment.reactions.create!(content: "Temporary")
+  target = ActionView::RecordIdentifier.dom_id(@comment, :reaction_list)
+  clear_enqueued_jobs
+
+  broadcasts = capture_turbo_stream_broadcasts(@comment.card) do
+    perform_enqueued_jobs { reaction.destroy! }
+  end
+
+  reaction_broadcast = broadcasts.find do |broadcast|
+    broadcast["action"] == "replace" && broadcast["target"] == target
+  end
+
+  assert reaction_broadcast
+  assert_not_includes reaction_broadcast.to_s, "Temporary"
+end
+
+test "does not broadcast reactions destroyed with their reactable" do
+  @comment.reactions.create!(content: "Temporary")
+  clear_enqueued_jobs
+
+  @comment.destroy!
+
+  assert_empty enqueued_jobs.select { it[:job] == Turbo::Streams::ActionBroadcastJob }
+end
+
+test "requires the account to match the reactable" do
+  reaction = @comment.reactions.new(content: "Nope", account: users(:mike).account)
+
+  assert_not reaction.valid?
+  assert_includes reaction.errors[:account], "must match the reactable account"
+end
+
+  test "requires the reacter to belong to the reactable account" do
+    reaction = @comment.reactions.new(content: "Nope", reacter: users(:mike))
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:reacter], "must belong to the reactable account"
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..98abdbe
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,35 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  test "add, cancel, and remove a reaction to a comment" do
+    comment = comments(:logo_agreement_jz)
+    sign_in_as(users(:kevin))
+    visit card_url(comment.card)
+
+    within "##{dom_id(comment, :reactions)}" do
+      find(".reactions__trigger").click
+      assert_equal "16", find(".reaction__input", visible: true)[:maxlength]
+      find(".reaction__input").set("Not yet")
+      find(".reaction__cancel-btn").click
+
+      assert_selector ".reaction__form", visible: :hidden
+      assert_selector ".reactions__trigger", visible: true
+
+      find(".reactions__trigger").click
+      find(".reaction__input").set("Nice")
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "Nice"
+      assert_selector ".reaction__form", visible: :hidden
+      assert_selector ".reactions__trigger", visible: true
+
+      reaction = find(".reaction", text: "Nice")
+      assert_includes reaction[:class].split, "reaction--deleteable"
+      reaction.find("span.txt-small").click
+      assert_includes reaction[:class].split, "expanded"
+      assert_selector ".reaction__delete", visible: true
+      find(".reaction__delete-btn").click
+      assert_no_selector ".reaction", text: "Nice"
+    end
+  end
+end
