diff --git a/app/views/reactions/_reactions.html.erb b/app/views/reactions/_reactions.html.erb
new file mode 100644
index 0000000..29ad885
--- /dev/null
+++ b/app/views/reactions/_reactions.html.erb
@@ -0,0 +1,39 @@
+<% new_reaction = local_assigns[:new_reaction].presence || Reaction.new %>
+<% show_form = new_reaction.errors.any? %>
+
+<div id="<%= dom_id(reactable, :reactions) %>" class="reactions" data-controller="reactions">
+  <%= render "reactions/list", reactable: reactable %>
+
+  <%= button_tag type: "button",
+        class: "reactions__trigger btn btn--circle borderless",
+        hidden: show_form,
+        aria: { label: "Add a reaction" },
+        data: { reactions_target: "trigger", action: "click->reactions#open" } do %>
+    <%= image_tag "boost-color.svg", alt: "" %>
+  <% end %>
+
+  <%= form_with model: new_reaction, url: reactions_path_for(reactable),
+        html: {
+          class: class_names("reaction reaction__form", expanded: show_form),
+          hidden: !show_form,
+          data: { reactions_target: "form", action: "turbo:submit-end->reactions#submitted" }
+        } do |form| %>
+    <%= form.label :content, class: "reaction__form-label" do %>
+      <span class="for-screen-reader">Reaction, 16 characters maximum</span>
+      <%= form.text_field :content,
+            class: "input reaction__input txt-small txt-medium",
+            placeholder: "React…", maxlength: Reaction::MAX_CONTENT_LENGTH, required: true,
+            size: 1, autocomplete: "off", dir: "auto",
+            data: { reactions_target: "input", action: "keydown.esc->reactions#cancel" } %>
+    <% end %>
+
+    <%= form.button class: "reaction__submit-btn btn btn--circle borderless", aria: { label: "Save reaction" } do %>
+      <%= icon_tag "check" %>
+    <% end %>
+
+    <%= button_tag type: "button", class: "reaction__cancel-btn btn btn--circle borderless",
+          aria: { label: "Cancel reaction" }, data: { action: "click->reactions#cancel" } do %>
+      <%= icon_tag "close" %>
+    <% end %>
+  <% end %>
+</div>
