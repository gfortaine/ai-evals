+require "timeout"
+
 class Webhook::Delivery < ApplicationRecord
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  RETENTION_PERIOD = 1.week
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+  NETWORK_ERRORS = [
+    EOFError,
+    IOError,
+    Net::HTTPBadResponse,
+    Net::ProtocolError,
+    Net::HTTPHeaderSyntaxError,
+    OpenSSL::SSL::SSLError,
+    SocketError,
+    SystemCallError,
+    Timeout::Error,
+    URI::InvalidURIError,
+    Zlib::Error
+  ].freeze
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,10 +31,47 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :expired, -> { where(created_at: ...RETENTION_PERIOD.ago) }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def cleanup
+      expired.delete_all
+    end
+  end
+
+  def deliver_later
+    Current.with_account(account) do
+      Webhook::DeliveryJob.perform_later(self)
+    end
+  end
+
+  def deliver
+    deliver_now
+  end
+
+  def deliver_now
+    return self unless pending?
+
+    body = request_body
+    headers = request_headers(body)
+
+    if claim(body:, headers:)
+      if webhook.reload.active?
+        deliver_request(body, headers)
+      else
+        finish(state: :errored, response: { error: "webhook_inactive" }, record_failure: false)
+      end
+    end
+
+    self
+  end
 
   def sanitized_request
-    if headers = request&.dig("headers")&.except("X-Webhook-Signature")
-      { headers: headers }
+    if headers = request&.dig("headers")
+      sanitized_headers = headers.reject { |key, _| key.to_s.casecmp?("X-Webhook-Signature") }
+      { headers: sanitized_headers }
     end
   end
 
@@ -27,6 +86,112 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    code = Integer(response&.dig(:code), exception: false)
+    completed? && response&.dig(:error).blank? && code&.between?(200, 299)
   end
+
+  private
+    def claim(body:, headers:)
+      with_lock do
+        if pending?
+          update!(state: :in_progress, request: { body:, headers: })
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def deliver_request(body, headers)
+      uri = URI.parse(webhook.url)
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      response = perform_request(uri, request)
+      finish(
+        state: :completed,
+        response: { code: response.code.to_i, headers: response.each_header.to_h }
+      )
+    rescue *NETWORK_ERRORS => error
+      Rails.logger.warn "Webhook delivery #{id} failed: #{error.class}: #{error.message}"
+      finish(
+        state: :errored,
+        response: { error: "destination_unreachable", exception: error.class.name }
+      )
+    end
+
+    def perform_request(uri, request)
+      Net::HTTP.new(uri.hostname, uri.port).tap do |http|
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = OPEN_TIMEOUT
+        http.read_timeout = READ_TIMEOUT
+        http.write_timeout = READ_TIMEOUT
+      end.request(request)
+    end
+
+    def finish(state:, response:, record_failure: true)
+      update!(state:, response:)
+      webhook.delivery_finished(self) if record_failure
+    end
+
+    def request_body
+      if webhook.for_slack?
+        { text: render_event(:html) }.to_json
+      elsif webhook.for_campfire? || webhook.for_basecamp?
+        { content: render_event(:html) }.to_json
+      else
+        render_event(:json)
+      end
+    end
+
+    def render_event(format)
+      Current.with(user: nil) do
+        webhook_renderer.render(
+          template: "webhooks/event",
+          formats: [ format ],
+          layout: false,
+          assigns: { event: }
+        ).strip
+      end
+    end
+
+    def webhook_renderer
+      @webhook_renderer ||= ApplicationController.renderer.new(**renderer_options)
+    end
+
+    def renderer_options
+      options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+
+      { script_name: account.slug }.tap do |renderer|
+        if host = renderer_host(options)
+          renderer[:http_host] = host
+          renderer[:https] = renderer_https?(options)
+        end
+      end
+    end
+
+    def renderer_host(options)
+      host = options[:host] || options["host"]
+      port = options[:port] || options["port"]
+
+      if host.present?
+        port.present? && !host.include?(":") ? "#{host}:#{port}" : host
+      end
+    end
+
+    def renderer_https?(options)
+      protocol = options[:protocol] || options["protocol"]
+      protocol.to_s.delete_suffix("://") == "https"
+    end
+
+    def request_headers(body)
+      timestamp = event.created_at.utc.iso8601
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body),
+        "X-Webhook-Timestamp" => timestamp
+      }
+    end
 end
