diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..93ebb0e
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,44 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record(delivery)
+    if delivery.succeeded?
+      reset_failures
+    else
+      record_failure
+    end
+  end
+
+  def record_failure(at: Time.current)
+    with_lock do
+      if first_failure_at.blank? || first_failure_at < at - FAILURE_WINDOW
+        update!(consecutive_failures_count: 1, first_failure_at: at)
+      else
+        update!(consecutive_failures_count: consecutive_failures_count + 1)
+      end
+
+      webhook.deactivate if delinquent_at?(at)
+    end
+  end
+
+  def reset_failures
+    with_lock do
+      unless consecutive_failures_count.zero? && first_failure_at.nil?
+        update!(consecutive_failures_count: 0, first_failure_at: nil)
+      end
+    end
+  end
+
+  def delinquent?
+    delinquent_at?(Time.current)
+  end
+
+  private
+    def delinquent_at?(at)
+      consecutive_failures_count >= FAILURE_THRESHOLD && first_failure_at >= at - FAILURE_WINDOW
+    end
+end
