+      subscribed_actions: [ "card_published" ]
+    )
+    Webhook.create!(
+      name: "Inactive",
+      url: "https://inactive.example.com/hook",
+      board: board,
+      subscribed_actions: [ "card_published" ],
+      active: false
+    )
+    Webhook.create!(
+      name: "Other events",
+      url: "https://other.example.com/hook",
+      board: board,
+      subscribed_actions: [ "card_closed" ]
+    )
+
+    event = Event.create!(
+      board: board,
+      creator: users(:david),
+      eventable: cards(:logo),
+      action: "card_published"
+    )
+
+    assert_equal [ event.id ], matching.deliveries.pluck(:event_id)
+    assert_equal 1, event.webhook_deliveries.count
+
+    assert_no_changes -> { matching.deliveries.count } do
+      matching.deliver(event)
+    end
+  end
+
+  test "activation starts a fresh failure sequence" do
+    webhook = webhooks(:inactive)
+    tracker = Webhook::DelinquencyTracker.create_or_find_by!(webhook: webhook)
+    tracker.update!(consecutive_failures_count: 10, first_failure_at: 5.minutes.ago)
+
+    webhook.activate
+
+    assert webhook.active?
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
 end
