diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..77c9674
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = Webhook.create!(
+      name: "Reliability test",
+      url: "https://reliability.example.com/hook",
+      board: boards(:private),
+      subscribed_actions: [ "card_published" ]
+    )
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "deactivates a webhook after ten consecutive failures within an hour" do
+    now = Time.current.change(usec: 0)
+
+    10.times do |index|
+      @tracker.record_failure(at: now + index.seconds)
+    end
+
+    assert_not @webhook.reload.active?
+    assert_equal 10, @tracker.reload.consecutive_failures_count
+  end
+
+  test "starts a new failure window after an hour" do
+    now = Time.current.change(usec: 0)
+    9.times { @tracker.record_failure(at: now) }
+
+    @tracker.record_failure(at: now + 1.hour + 1.second)
+
+    assert @webhook.reload.active?
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+  end
+
+  test "success interrupts consecutive failures" do
+    9.times { @tracker.record_failure }
+    successful = Webhook::Delivery.new(
+      webhook: @webhook,
+      event: events(:layout_commented),
+      state: :completed,
+      response: { code: 204 }
+    )
+
+    @tracker.record(successful)
+    @tracker.record_failure
+
+    assert @webhook.reload.active?
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+    assert_not_nil @tracker.first_failure_at
+  end
+end
diff --git a/test/models/webhook/delivery_test.rb b/test/models/webhook/delivery_test.rb
index b51445b..dd16b65 100644
--- a/test/models/webhook/delivery_test.rb
+++ b/test/models/webhook/delivery_test.rb
@@ -77,4 +77,77 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
 
     assert_nil delivery.response_summary
   end
+
+  test "delivers a signed POST exactly once" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_commented))
+    post = stub_request(:post, webhook.url).to_return(status: 202, headers: { "Content-Type" => "text/plain" })
+
+    delivery.deliver_now
+
+    assert delivery.completed?
+    assert delivery.succeeded?
+    assert_equal 202, delivery.response[:code]
+    assert_equal "application/json", delivery.request.dig("headers", "Content-Type")
+    assert_equal "fizzy/1.0.0 Webhook", delivery.request.dig("headers", "User-Agent")
+    assert_equal delivery.event.created_at.utc.iso8601, delivery.request.dig("headers", "X-Webhook-Timestamp")
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, delivery.request["body"]),
+      delivery.request.dig("headers", "X-Webhook-Signature")
+    assert_equal delivery.event.id, JSON.parse(delivery.request["body"])["id"]
+
+    delivery.deliver_now
+    assert_requested post, times: 1
+  end
+
+  test "records unsuccessful responses as completed failures" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_commented))
+    stub_request(:post, webhook.url).to_return(status: 503)
+
+    delivery.deliver_now
+
+    assert delivery.completed?
+    assert delivery.failed?
+    assert_equal 503, delivery.response[:code]
+    assert_equal 1, webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "records network failures without retrying the POST" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_commented))
+    post = stub_request(:post, webhook.url).to_raise(Errno::ECONNREFUSED)
+
+    delivery.deliver_now
+
+    assert delivery.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+
+    delivery.deliver_now
+    assert_requested post, times: 1
+  end
+
+  test "does not deliver after a webhook is deactivated" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_commented))
+    webhook.deactivate
+    post = stub_request(:post, webhook.url)
+
+    delivery.deliver_now
+
+    assert delivery.errored?
+    assert_equal "webhook_inactive", delivery.response[:error]
+    assert_not_requested post
+  end
+
+  test "cleanup removes deliveries older than a week" do
+    expired = webhook_deliveries(:pending)
+    retained = webhook_deliveries(:in_progress)
+    expired.update!(created_at: 8.days.ago)
+    retained.update!(created_at: 6.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(expired.id)
+    assert Webhook::Delivery.exists?(retained.id)
+  end
 end
