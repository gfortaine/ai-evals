diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..7821eb1
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,16 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders a timezone-neutral local time tag" do
+    timestamp = ActiveSupport::TimeZone["America/New_York"].local(2025, 1, 22, 18, 42)
+    html = local_time_tag(timestamp, format: :contextual, class: "timestamp", data: { controller: "tooltip" })
+
+    assert_select Nokogiri::HTML::DocumentFragment.parse(html), "time", count: 1 do |time|
+      assert_equal "timestamp local-time-value", time.attribute("class").value
+      assert_equal "2025-01-22T23:42:00Z", time.attribute("datetime").value
+      assert_equal "2025-01-22T23:42:00Z", time.text
+      assert_equal "tooltip local-time", time.attribute("data-controller").value
+      assert_equal "contextual", time.attribute("data-local-time-format-value").value
+    end
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..dcee768
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,46 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "renders timestamps in the browser's timezone" do
+    sign_in_as users(:david)
+
+    page.execute_script <<~JAVASCRIPT
+      const now = new Date()
+      const localDate = (dayOffset, hour = 13, minute = 42) => {
+        const date = new Date(now)
+        date.setDate(date.getDate() + dayOffset)
+        date.setHours(hour, minute, 0, 0)
+        return date.toISOString()
+      }
+
+      const oldDate = new Date(now)
+      oldDate.setFullYear(2020, 8, 12)
+      oldDate.setHours(13, 42, 0, 0)
+
+      const examples = [
+        [ "same-day", localDate(0), "contextual" ],
+        [ "yesterday", localDate(-1), "contextual" ],
+        [ "five-days-ago", localDate(-5), "contextual" ],
+        [ "old-date", oldDate.toISOString(), "contextual" ],
+        [ "tomorrow", localDate(1), "relative" ],
+        [ "three-days", localDate(3), "relative" ]
+      ]
+
+      for (const [ id, timestamp, format ] of examples) {
+        const time = document.createElement("time")
+        time.id = id
+        time.dateTime = timestamp
+        time.dataset.controller = "local-time"
+        time.dataset.localTimeFormatValue = format
+        document.body.append(time)
+      }
+    JAVASCRIPT
+
+    assert_selector "#same-day", text: "1:42 PM"
+    assert_selector "#yesterday", text: "yesterday"
+    assert_selector "#five-days-ago", text: "5 days ago"
+    assert_selector "#old-date", text: "Sep 12"
+    assert_selector "#tomorrow", text: "tomorrow"
+    assert_selector "#three-days", text: "in 3 days"
+  end
+end
