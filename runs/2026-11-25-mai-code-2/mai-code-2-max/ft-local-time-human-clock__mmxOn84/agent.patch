diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..8da5f1a
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,44 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #observer
+  #timer
+
+  connect() {
+    this.#observer = new MutationObserver(() => this.render())
+    this.#observer.observe(this.element, { attributes: true, attributeFilter: [ "datetime" ] })
+
+    this.render()
+    this.#refreshWhenRelative()
+  }
+
+  disconnect() {
+    this.#observer.disconnect()
+    clearInterval(this.#timer)
+  }
+
+  render() {
+    const timestamp = this.element.getAttribute("datetime")
+    if (timestamp) {
+      this.element.textContent = formatLocalTime(timestamp, this.formatValue)
+      this.element.title = formatLocalTime(timestamp, "full")
+    } else {
+      throw new Error("A local-time controller requires a datetime attribute")
+    }
+  }
+
+  formatValueChanged() {
+    if (this.#observer) this.render()
+  }
+
+  #refreshWhenRelative() {
+    if (this.formatValue === "relative" || this.formatValue === "contextual") {
+      this.#timer = setInterval(() => this.render(), REFRESH_INTERVAL)
+    }
+  }
+}
