diff --git a/test/integration/tenant_isolation_test.rb b/test/integration/tenant_isolation_test.rb
new file mode 100644
index 0000000..13a2deb
--- /dev/null
+++ b/test/integration/tenant_isolation_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class TenantIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant = Tenant.create!(name: "Tenant A")
+    @other_tenant = Tenant.create!(name: "Tenant B")
+
+    users(:kevin).update!(tenant: @tenant)
+    @own_book = books(:handbook)
+    @own_book.update!(tenant: @tenant)
+
+    @other_book = books(:manual)
+    @other_book.update!(tenant: @other_tenant, published: true)
+    @other_book.accesses.create!(user: users(:kevin), level: :editor)
+
+    @other_leaf = @other_book.press(Page.new(body: "The original secret"), title: "Secret")
+    @other_leaf.edit(leafable_params: { body: "The revised secret" })
+
+    sign_in :kevin
+  end
+
+  test "another tenant's published or accessible books are absent from the library" do
+    get root_path
+
+    assert_response :success
+    assert_in_body @own_book.title
+    assert_not_in_body @other_book.title
+  end
+
+  test "another tenant's book routes answer not found even with an access row" do
+    requests = [
+      -> { get book_slug_path(@other_book) },
+      -> { get edit_book_path(@other_book) },
+      -> { get book_publication_path(@other_book) },
+      -> { get edit_book_publication_path(@other_book) },
+      -> { get book_bookmark_path(@other_book) },
+      -> { post book_search_path(@other_book), params: { search: "secret" } },
+      -> { get leafable_slug_path(@other_leaf) },
+      -> { get leafable_path(@other_leaf) },
+      -> { get edit_leafable_path(@other_leaf) },
+      -> { get page_edit_path(@other_leaf, @other_leaf.edits.last) },
+      -> { get page_edit_path(@other_leaf, "latest") }
+    ]
+
+    requests.each do |request|
+      request.call
+      assert_response :not_found
+      assert cookies[:session_token].present?
+    end
+
+    get book_slug_path(@own_book)
+    assert_response :success
+  end
+
+  test "same-tenant edit history remains available" do
+    leaves(:welcome_page).edit(leafable_params: { body: "A same-tenant revision" })
+
+    get page_edit_path(leaves(:welcome_page), leaves(:welcome_page).edits.last)
+
+    assert_response :success
+    assert_select "p", /such a great handbook/
+  end
+
+  test "signed-out visitors can see another tenant's published book and pages" do
+    sign_out
+
+    get book_slug_path(@other_book)
+    assert_response :success
+    assert_in_body @other_book.title
+
+    get leafable_slug_path(@other_leaf)
+    assert_response :success
+    assert_in_body "The revised secret"
+  end
+
+  test "new books inherit the creator's tenant" do
+    post books_path, params: { book: { title: "Tenant book", everyone_access: false } }
+
+    assert_response :redirect
+    assert_equal @tenant, Book.find_by!(title: "Tenant book").tenant
+  end
+
+  test "everyone access is limited to the book's tenant" do
+    users(:jz).update!(tenant: @tenant)
+    users(:jason).update!(tenant: @other_tenant)
+
+    @own_book.update!(everyone_access: true)
+    @own_book.update_access(editors: [ users(:kevin).id, users(:jason).id ], readers: [ users(:jason).id ])
+
+    assert @own_book.accessable?(user: users(:kevin))
+    assert @own_book.accessable?(user: users(:jz))
+    assert_not @own_book.accesses.exists?(user: users(:jason))
+  end
+
+  test "the users page still includes every tenant" do
+    users(:jason).update!(tenant: @other_tenant)
+
+    get users_path
+
+    assert_response :success
+    assert_in_body users(:kevin).name
+    assert_in_body users(:jason).name
+  end
+end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..f0c97b5 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,19 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "cross-tenant access rows do not grant access to published or unpublished books" do
+    tenant = Tenant.create!(name: "Tenant A")
+    other_tenant = Tenant.create!(name: "Tenant B")
+    user = users(:kevin)
+    user.update!(tenant: tenant)
+    book = Book.create!(title: "Other tenant", tenant: other_tenant, published: true)
+    book.accesses.create!(user: user, level: :editor)
+
+    assert_not Book.accessable_or_published(user: user).include?(book)
+    assert_not Book.accessable_books(user: user).include?(book)
+    assert_not book.accessable?(user: user)
+    assert_not book.editable?(user: user)
+    assert_nil book.access_for(user: user)
+  end
 end
