diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..b8cd031 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,42 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, ->(as_of = Time.current) {
+      joins(:cancellation)
+        .where("account_cancellations.created_at < ?", as_of - INCINERATION_GRACE_PERIOD)
+    }
+  end
+
+  class_methods do
+    def incinerate_due(as_of: Time.current)
+      due_for_incineration(as_of).find_each do |account|
+        account.incinerate(as_of: as_of)
+      end
+    end
+  end
+
+  def incineration_due?(as_of: Time.current)
+    cancellation.present? && cancellation.created_at < as_of - INCINERATION_GRACE_PERIOD
+  end
+
+  def incinerate(as_of: Time.current)
+    with_lock do
+      if incineration_due?(as_of: as_of)
+        destroy!
+        remove_remaining_incinerated_data
+      end
+    end
+  end
+
+  private
+    def remove_remaining_incinerated_data
+      Search::Record.for(id).where(account_id: id).destroy_all
+      ActionText::RichText.where(account_id: id).destroy_all
+      ActiveStorage::Attachment.where(account_id: id).find_each(&:purge)
+      ActiveStorage::Blob.where(account_id: id).find_each(&:purge)
+      Storage::Entry.where(account_id: id).delete_all
+    end
 end
