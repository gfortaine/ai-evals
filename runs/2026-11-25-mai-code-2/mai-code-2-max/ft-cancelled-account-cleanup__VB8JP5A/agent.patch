diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..c1d3163
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago" do
+    freeze_time do
+      account = accounts("37s")
+      account_id = account.id
+      identity_ids = account.users.where.not(identity_id: nil).pluck(:identity_id)
+      card = account.cards.first
+
+      account.cancel(initiated_by: users(:david))
+      account.cancellation.update!(created_at: 30.days.ago - 1.second)
+      card.reindex
+      card.image.attach io: StringIO.new("incinerated image"), filename: "incinerated.txt", content_type: "text/plain"
+
+      assert_difference -> { Account.count }, -1 do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert_not Account.exists?(account_id)
+      assert_empty account_data_tables(account_id)
+      assert_empty Storage::Total.where(owner_type: "Account", owner_id: account_id)
+      assert_equal identity_ids.sort, Identity.where(id: identity_ids).pluck(:id).sort
+    end
+  end
+
+  test "preserves accounts cancelled exactly 30 days ago" do
+    freeze_time do
+      account = accounts("37s")
+      account.cancel(initiated_by: users(:david))
+      account.cancellation.update!(created_at: 30.days.ago)
+
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert account.reload.cancelled?
+    end
+  end
+
+  private
+    def account_data_tables(account_id)
+      connection = ApplicationRecord.connection
+
+      connection.tables.filter_map do |table|
+        if connection.columns(table).any? { |column| column.name == "account_id" }
+          quoted_table = connection.quote_table_name(table)
+          count = connection.select_value(
+            "SELECT COUNT(*) FROM #{quoted_table} WHERE account_id = #{connection.quote(account_id)}"
+          ).to_i
+
+          table if count.positive?
+        end
+      end
+    end
+end
