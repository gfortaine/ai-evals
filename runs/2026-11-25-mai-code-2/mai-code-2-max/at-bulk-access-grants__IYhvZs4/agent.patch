diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..cee1527
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "imports all grants with one insert and notifies each user" do
+    book = Book.create!(title: "Imported book", everyone_access: false)
+    grants = User.order(:id).map.with_index do |user, index|
+      { user_id: user.id, level: index.even? ? :reader : :editor }
+    end
+    result = nil
+
+    assert_queries_match(/INSERT INTO "accesses"/i, count: 1) do
+      assert_enqueued_jobs grants.size, only: Book::AccessNotificationJob do
+        result = Book::AccessImport.new(book, grants).import
+      end
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal grants.map { it[:user_id] }, result.accesses.map(&:user_id)
+    assert_equal grants.map { it[:level].to_s }, result.accesses.map(&:level)
+    assert result.accesses.all?(&:persisted?)
+  end
+
+  test "rejects duplicates without inserts or notifications" do
+    book = Book.create!(title: "Duplicate import", everyone_access: false)
+    existing_access = book.accesses.create!(user: users(:david), level: :editor)
+    grants = [
+      { user_id: users(:jason).id, level: :reader },
+      { user_id: users(:jz).id, level: :editor },
+      { user_id: users(:david).id, level: :reader }
+    ]
+    result = nil
+
+    assert_no_queries_match(/INSERT INTO "accesses"/i) do
+      assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+        result = Book::AccessImport.new(book, grants).import
+      end
+    end
+
+    assert_equal 2, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal [ existing_access ], book.reload.accesses
+  end
+
+  test "rejects an unknown level without inserts or notifications" do
+    book = Book.create!(title: "Invalid import", everyone_access: false)
+    grants = [
+      { user_id: users(:david).id, level: :reader },
+      { user_id: users(:jason).id, level: :owner },
+      { user_id: users(:jz).id, level: :editor }
+    ]
+    result = nil
+
+    assert_no_queries_match(/INSERT INTO "accesses"/i) do
+      assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+        result = Book::AccessImport.new(book, grants).import
+      end
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_empty book.reload.accesses
+  end
+end
