@@ -0,0 +1,32 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.squish
+    @cards = set_page_and_extract_portion_from(search_cards).to_a
+    @matching_comments_by_card_id = matching_comments.group_by(&:card_id)
+  end
+
+  private
+    def search_cards
+      Current.user.search_cards(@query).preload(:board, :rich_text_description)
+    end
+
+    def matching_comments
+      if @cards.any? && Card.search_terms(@query).any?
+        Comment
+          .where(card_id: @cards.map(&:id), id: matching_comment_rich_texts.select(:record_id))
+          .with_rich_text_body
+          .order(created_at: :desc, id: :desc)
+      else
+        Comment.none
+      end
+    end
+
+    def matching_comment_rich_texts
+      patterns = Card.search_terms(@query).map { |term| Card.search_pattern(term) }
+      body_matches = Array.new(patterns.size, "action_text_rich_texts.body LIKE ? ESCAPE '!'").join(" OR ")
+
+      ActionText::RichText
+        .where(record_type: "Comment", name: "body")
+        .where(body_matches, *patterns)
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..9fc2292
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,33 @@
+module SearchesHelper
+  def search_highlight(content, query)
+    # Convert SafeBuffers to plain strings before escaping their contents.
+    terms = Card.search_terms(query).map { |term| ERB::Util.html_escape(String.new(term)) }
+    text = ERB::Util.html_escape(String.new(search_plain_text(content)))
+
+    highlight text, terms, sanitize: false
+  end
+
+  def search_result_excerpt(content, query, radius: 80)
+    text = search_plain_text(content).squish
+    term = Card.search_terms(query).find { |candidate| text.match?(Regexp.new(Regexp.escape(candidate), Regexp::IGNORECASE)) }
+
+    if term
+      search_highlight excerpt(text, term, radius: radius), query
+    else
+      ""
+    end
+  end
+
+  def search_text_matches?(content, query)
+    terms = Card.search_terms(query)
+    text = search_plain_text(content)
+
+    terms.any? { |term| text.match?(Regexp.new(Regexp.escape(term), Regexp::IGNORECASE)) }
+  end
+
+  private
+    def search_plain_text(content)
+      text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content
+      text.to_s
+    end
+end
