new file mode 100644
index 0000000..d2b755d
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,25 @@
+<article class="search-result" id="<%= dom_id(card, :search_result) %>">
+  <header class="search-result__header">
+    <%= link_to card.board.name, board_path(card.board), class: "search-result__board" %>
+    <span class="search-result__number">#<%= card.number %></span>
+    <%= local_datetime_tag card.created_at, class: "search-result__date", style: :daysago %>
+  </header>
+
+  <h2 class="search-result__title">
+    <%= link_to search_highlight(card.title, @query), card_path(card) %>
+  </h2>
+
+  <% if search_text_matches?(card.description, @query) %>
+    <p class="search-result__excerpt"><%= search_result_excerpt(card.description, @query) %></p>
+  <% end %>
+
+  <% (@matching_comments_by_card_id[card.id] || []).each do |comment| %>
+    <% if search_text_matches?(comment.body, @query) %>
+      <%= link_to card_path(card, anchor: dom_id(comment)), class: "search-result__comment" do %>
+        <%= icon_tag "comment" %>
+        <span class="for-screen-reader">Matching comment: </span>
+        <span><%= search_result_excerpt(comment.body, @query) %></span>
+      <% end %>
+    <% end %>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..8e7f661
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,31 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span>Search</span>
+  </h1>
+<% end %>
+
+<section class="searches" aria-label="Card search">
+  <%= form_with url: search_path, method: :get, class: "searches__form" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, class: "input searches__input", placeholder: "Search titles, descriptions, and comments…", autofocus: true, autocorrect: "off", autocomplete: "off" %>
+    <%= form.button class: "btn searches__submit" do %>
+      <%= icon_tag "search" %>
+      <span>Search</span>
+    <% end %>
+  <% end %>
+
+  <% if @query.present? && @cards.any? %>
+    <div class="searches__results">
+      <%= with_automatic_pagination :search_results, @page do %>
+        <%= render partial: "searches/result", collection: @cards, as: :card %>
+      <% end %>
+    </div>
+  <% elsif @query.present? %>
+    <div class="blank-slate">No cards match that search</div>
+  <% else %>
+    <div class="blank-slate">Search the cards on boards you can access</div>
+  <% end %>
+</section>
