diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..ebdf157
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.session = sessions(:david)
+  end
+
+  test "searches accessible published cards by title, description, and comments in newest-first order" do
+    board = boards(:writebook)
+    title_match = board.cards.create!(title: "A needle in the title", creator: users(:david), status: :published, created_at: 3.days.ago)
+    description_match = board.cards.create!(title: "Description match", description: "The needle is in the description", creator: users(:david), status: :published, created_at: 2.days.ago)
+    comment_match = board.cards.create!(title: "Comment match", creator: users(:david), status: :published, created_at: 1.day.ago)
+    comment_match.comments.create!(body: "The needle is in a comment", creator: users(:david))
+
+    draft_match = board.cards.create!(title: "Draft match", creator: users(:david), status: :published)
+    draft_match.comments.create!(body: "needle in a draft comment", creator: users(:david))
+    draft_match.update_column(:status, "drafted")
+
+    inaccessible_board = Board.create!(name: "Inaccessible search board", creator: users(:kevin), all_access: false)
+    inaccessible_match = inaccessible_board.cards.create!(title: "needle on another board", creator: users(:kevin), status: :published)
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_select ".search-result", count: 3
+    assert_equal [ comment_match.title, description_match.title, title_match.title ],
+      css_select(".search-result__title").map { |title| title.text.squish }
+    assert_select "mark", text: "needle", count: 3
+    assert_not_includes response.body, draft_match.title
+    assert_not_includes response.body, inaccessible_match.title
+  end
+
+  test "highlights matches as escaped markup" do
+    boards(:writebook).cards.create!(title: "needle <script>alert('no')</script>", creator: users(:david), status: :published)
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_select "mark", text: "needle", count: 1
+    assert_select ".search-result script", count: 0
+    assert_includes css_select(".search-result__title").first.text, "<script>alert('no')</script>"
+  end
+
+  test "treats SQL wildcards as literal search terms" do
+    literal_match = boards(:writebook).cards.create!(title: "100% complete", creator: users(:david), status: :published)
+    boards(:writebook).cards.create!(title: "1000 complete", creator: users(:david), status: :published)
+
+    get search_path(q: "%")
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__title", text: literal_match.title
+    assert_select "mark", text: "%", count: 1
+  end
+
+  test "does not return cards without a query" do
+    get search_path
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+end
