diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..757277e
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,53 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  LIKE_ESCAPE_CHARACTER = "!"
+
+  MATCHING_TEXT_SQL = <<~SQL.squish
+    cards.title LIKE :pattern ESCAPE '!'
+    OR EXISTS (
+      SELECT 1
+      FROM action_text_rich_texts card_descriptions
+      WHERE card_descriptions.record_type = 'Card'
+        AND card_descriptions.record_id = cards.id
+        AND card_descriptions.name = 'description'
+        AND card_descriptions.body LIKE :pattern ESCAPE '!'
+    )
+    OR EXISTS (
+      SELECT 1
+      FROM comments
+      INNER JOIN action_text_rich_texts comment_bodies
+        ON comment_bodies.record_type = 'Comment'
+        AND comment_bodies.record_id = comments.id
+        AND comment_bodies.name = 'body'
+      WHERE comments.card_id = cards.id
+        AND comment_bodies.body LIKE :pattern ESCAPE '!'
+    )
+  SQL
+
+  included do
+    scope :search, ->(query) do
+      search_terms = Card.search_terms(query)
+
+      if search_terms.empty?
+        none
+      else
+        search_terms.reduce(self) do |cards, term|
+          pattern = Card.search_pattern(term)
+          cards.where(MATCHING_TEXT_SQL, pattern: pattern)
+        end
+      end
+    end
+  end
+
+  class_methods do
+    def search_pattern(term)
+      pattern = ActiveRecord::Base.sanitize_sql_like(term, LIKE_ESCAPE_CHARACTER)
+      "%#{pattern}%"
+    end
+
+    def search_terms(query)
+      query.to_s.squish.split.uniq
+    end
+  end
+end
