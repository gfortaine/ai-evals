diff --git a/test/integration/book_absence_test.rb b/test/integration/book_absence_test.rb
index b9c20ac..7b69a13 100644
--- a/test/integration/book_absence_test.rb
+++ b/test/integration/book_absence_test.rb
@@ -8,4 +8,56 @@ class BookAbsenceTest < ActionDispatch::IntegrationTest
       end
     end
   end
+
+  test "raised exceptions do not change normal exception rendering" do
+    get book_slug_url(books(:manual))
+    assert_response :not_found
+
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions do
+        get book_slug_url(books(:manual))
+      end
+    end
+
+    get book_slug_url(books(:manual))
+    assert_response :not_found
+  end
+
+  test "raised exceptions are isolated from concurrent requests" do
+    app = ActionDispatch::ShowExceptions.new(
+      ->(_env) { raise ActiveRecord::RecordNotFound },
+      ->(_env) { [ 404, {}, [] ] }
+    )
+    request_env = -> { Rails.application.env_config.merge(Rack::MockRequest.env_for("/")) }
+
+    assert_equal 404, app.call(request_env.call).first
+
+    ready = Queue.new
+    release = Queue.new
+    result = Queue.new
+    worker = Thread.new do
+      with_raised_exceptions do
+        ready << true
+        release.pop
+        result << begin
+          app.call(request_env.call).first
+        rescue StandardError => error
+          error
+        end
+      end
+    end
+
+    ready.pop
+    begin
+      assert_equal 404, app.call(request_env.call).first
+    ensure
+      release << true
+    end
+    worker.join
+
+    assert_instance_of ActiveRecord::RecordNotFound, result.pop
+  ensure
+    release << true if worker&.alive?
+    worker&.join
+  end
 end
diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..673fdf9 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -2,6 +2,34 @@ ENV["RAILS_ENV"] ||= "test"
 require_relative "../config/environment"
 require "rails/test_help"
 
+# Rails memoizes exception settings, so overrides must stay local to each test execution.
+module RaisedExceptionsTestHelper
+  EXCEPTION_STATE_KEY = :raise_action_dispatch_exceptions
+
+  module ExceptionWrapper
+    def show?(request)
+      return false if ActiveSupport::IsolatedExecutionState[EXCEPTION_STATE_KEY]
+
+      super
+    end
+  end
+
+  def with_raised_exceptions
+    had_override = ActiveSupport::IsolatedExecutionState.key?(EXCEPTION_STATE_KEY)
+    previous_override = ActiveSupport::IsolatedExecutionState[EXCEPTION_STATE_KEY]
+    ActiveSupport::IsolatedExecutionState[EXCEPTION_STATE_KEY] = true
+    yield
+  ensure
+    if had_override
+      ActiveSupport::IsolatedExecutionState[EXCEPTION_STATE_KEY] = previous_override
+    else
+      ActiveSupport::IsolatedExecutionState.delete(EXCEPTION_STATE_KEY)
+    end
+  end
+end
+
+ActionDispatch::ExceptionWrapper.prepend(RaisedExceptionsTestHelper::ExceptionWrapper)
+
 module ActiveSupport
   class TestCase
     # Run tests in parallel with specified workers
