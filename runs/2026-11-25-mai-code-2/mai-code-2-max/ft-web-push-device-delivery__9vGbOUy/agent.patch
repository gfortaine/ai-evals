+++ b/app/jobs/push_subscription/delivery_job.rb
@@ -0,0 +1,10 @@
+class PushSubscription::DeliveryJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+  retry_on WebPush::PushServiceError, WebPush::TooManyRequests,
+    Net::OpenTimeout, Net::ReadTimeout, SocketError,
+    wait: :polynomially_longer, attempts: 5
+
+  def perform(push_subscription, notification)
+    push_subscription.deliver(notification)
+  end
+end
