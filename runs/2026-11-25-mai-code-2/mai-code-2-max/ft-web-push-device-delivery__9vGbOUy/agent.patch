diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..409c69b
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,57 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: true
+
+  class << self
+    def configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].presence
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"].presence
+    end
+
+    def vapid_keys
+      unless configured?
+        missing = %w[ VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY ].reject { |key| ENV[key].present? }
+        raise WebPush::ConfigurationError, "Missing #{missing.to_sentence}"
+      end
+
+      { public_key: vapid_public_key, private_key: vapid_private_key }
+    end
+  end
+
+  def deliver_later(notification)
+    DeliveryJob.perform_later(self, notification)
+  end
+
+  def deliver(notification)
+    if user_id == notification.user_id
+      WebPush.payload_send(
+        endpoint: endpoint,
+        p256dh: p256dh_key,
+        auth: auth_key,
+        message: notification_payload(notification),
+        vapid: self.class.vapid_keys
+      )
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized
+    destroy!
+  end
+
+  private
+    def notification_payload(notification)
+      ApplicationController.renderer.new(script_name: account.slug, https: !Rails.env.local?).render(
+        partial: "notifications/push",
+        formats: [ :json ],
+        locals: { notification: notification }
+      )
+    end
+end
