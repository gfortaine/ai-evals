diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..48a5108
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create stores the browser subscription for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :created
+    assert_equal @user, PushSubscription.last.user
+    assert_equal @user.account, PushSubscription.last.account
+    assert_equal subscription_params[:endpoint], PushSubscription.last.endpoint
+    assert_equal PushSubscription.last.id, response.parsed_body["id"]
+  end
+
+  test "create refreshes an existing browser subscription" do
+    push_subscription = create_subscription(user: @user, endpoint: subscription_params[:endpoint])
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: subscription_params.merge(p256dh_key: "new-p256dh", auth_key: "new-auth")
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "new-p256dh", push_subscription.reload.p256dh_key
+    assert_equal "new-auth", push_subscription.auth_key
+  end
+
+  test "create moves an endpoint to the user currently using the device" do
+    push_subscription = create_subscription(user: users(:kevin), endpoint: subscription_params[:endpoint])
+
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+
+    assert_response :created
+    assert_equal @user, push_subscription.reload.user
+  end
+
+  test "create is forbidden for another user" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy removes the current user's browser subscription" do
+    push_subscription = create_subscription(user: @user)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, push_subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy does not remove another user's browser subscription" do
+    push_subscription = create_subscription(user: users(:kevin))
+
+    assert_no_difference -> { PushSubscription.count } do
+      delete user_push_subscription_path(@user, push_subscription), as: :json
+    end
+
+    assert_response :not_found
+  end
+
+  private
+    def subscription_params
+      {
+        endpoint: "https://push.example.com/subscriptions/device-one",
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      }
+    end
+
+    def create_subscription(user:, endpoint: "https://push.example.com/subscriptions/#{SecureRandom.uuid}")
+      PushSubscription.create!(
+        user: user,
+        account: user.account,
+        endpoint: endpoint,
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      )
+    end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..6a3d6c4
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @previous_public_key = ENV["VAPID_PUBLIC_KEY"]
+    @previous_private_key = ENV["VAPID_PRIVATE_KEY"]
+    ENV["VAPID_PUBLIC_KEY"] = "public-key"
+    ENV["VAPID_PRIVATE_KEY"] = "private-key"
+  end
+
+  teardown do
+    ENV["VAPID_PUBLIC_KEY"] = @previous_public_key
+    ENV["VAPID_PRIVATE_KEY"] = @previous_private_key
+  end
+
+  test "deliver sends the tray content and card URL" do
+    push_subscription = create_subscription
+    notification = notifications(:logo_assignment_kevin)
+    delivery = nil
+
+    WebPush.stubs(:payload_send).with { |options|
+      delivery = options
+      true
+    }
+
+    push_subscription.deliver(notification)
+
+    assert_equal push_subscription.endpoint, delivery[:endpoint]
+    assert_equal push_subscription.p256dh_key, delivery[:p256dh]
+    assert_equal push_subscription.auth_key, delivery[:auth]
+    assert_equal({ public_key: "public-key", private_key: "private-key" }, delivery[:vapid])
+
+    payload = JSON.parse(delivery[:message])
+    assert_equal notification.card_id, payload["tag"]
+    assert_equal event_notification_title(notification.source), payload["title"]
+    assert_equal event_notification_body(notification.source), payload["body"]
+    assert_includes payload["url"], "/cards/#{notification.card.number}"
+  end
+
+  test "deliver ignores notifications for a previous owner of this endpoint" do
+    push_subscription = create_subscription
+    notification = notifications(:logo_mentioned_david)
+    WebPush.expects(:payload_send).never
+
+    push_subscription.deliver(notification)
+  end
+
+  test "deliver removes expired subscriptions" do
+    push_subscription = create_subscription
+    response = Struct.new(:body).new("")
+    error = WebPush::ExpiredSubscription.new(response, "push.example.com")
+    WebPush.stubs(:payload_send).raises(error)
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      push_subscription.deliver(notifications(:logo_assignment_kevin))
+    end
+  end
+
+  test "notification creation enqueues delivery for each device" do
+    push_subscription = create_subscription
+    user = push_subscription.user
+
+    assert_enqueued_with(job: PushSubscription::DeliveryJob) do
+      user.notifications.create!(
+        source: events(:text_published),
+        creator: users(:david),
+        unread_count: 1
+      )
+    end
+  end
+
+  test "notification updates enqueue another delivery when tray content changes" do
+    push_subscription = create_subscription
+    notification = notifications(:logo_assignment_kevin)
+    push_subscription.update!(user: notification.user, account: notification.account)
+
+    assert_enqueued_with(job: PushSubscription::DeliveryJob) do
+      notification.update!(source: events(:logo_published))
+    end
+  end
+
+  test "reading a notification does not enqueue another delivery" do
+    create_subscription
+
+    assert_no_enqueued_jobs only: PushSubscription::DeliveryJob do
+      notifications(:logo_assignment_kevin).read
+    end
+  end
+
+  private
+    def create_subscription
+      user = users(:kevin)
+
+      PushSubscription.create!(
+        account: user.account,
+        user: user,
+        endpoint: "https://push.example.com/subscriptions/#{SecureRandom.uuid}",
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      )
+    end
+
+    def event_notification_title(event)
+      ApplicationController.helpers.event_notification_title(event)
+    end
+
+    def event_notification_body(event)
+      ApplicationController.helpers.event_notification_body(event)
+    end
+end
