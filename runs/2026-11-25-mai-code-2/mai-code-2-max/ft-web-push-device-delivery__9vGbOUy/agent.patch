   })
 })
 
+self.addEventListener("push", (event) => {
+  const { title, body, url, tag } = event.data.json()
+
+  event.waitUntil(self.registration.showNotification(title, {
+    body,
+    data: { url },
+    icon: "/app-icon-192.png",
+    tag
+  }))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  const url = event.notification.data.url
+  event.notification.close()
+
+  event.waitUntil(self.clients.matchAll({ type: "window", includeUncontrolled: true }).then(async (clients) => {
+    const existingClient = clients.find(client => client.url === url)
+
+    if (existingClient) {
+      return existingClient.focus()
+    }
+
+    const client = clients.find(client => new URL(client.url).origin === new URL(url).origin)
+    if (client) {
+      return client.navigate(url).then(navigatedClient => navigatedClient ? navigatedClient.focus() : self.clients.openWindow(url))
+    }
+
+    return self.clients.openWindow(url)
+  }))
+})
+
 self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
