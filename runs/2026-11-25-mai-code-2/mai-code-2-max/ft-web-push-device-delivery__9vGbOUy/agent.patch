new file mode 100644
index 0000000..ffea7bf
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,39 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = PushSubscription.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @push_subscription.assign_attributes(push_subscription_params)
+    @push_subscription.assign_attributes(user: @user, account: @user.account)
+    @push_subscription.save!
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications enabled" }
+      format.json { render json: @push_subscription, only: :id, status: :created }
+    end
+  end
+
+  def destroy
+    @push_subscription = @user.push_subscriptions.find(params[:id])
+    @push_subscription.destroy!
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications disabled" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..7e52824
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,149 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "details", "toggle" ]
+  static values = { publicKey: String, subscriptionsUrl: String }
+
+  async connect() {
+    this.toggleTarget.disabled = true
+    this.#showDetails(false)
+
+    try {
+      if (this.#supported) {
+        const permission = Notification.permission
+        const subscription = await this.#subscription
+
+        if (permission === "granted" && subscription) {
+          await this.#saveSubscription(subscription)
+          this.#updateState(true)
+        } else {
+          this.#updateState(false, permission === "denied")
+        }
+      } else {
+        this.#updateState(false, true)
+        this.toggleTarget.disabled = true
+      }
+    } catch (error) {
+      console.error("Unable to check push notification settings", error)
+      this.#updateState(false, true)
+    }
+  }
+
+  async toggle() {
+    this.toggleTarget.disabled = true
+
+    try {
+      if (this.toggleTarget.checked) {
+        await this.#enable()
+      } else {
+        await this.#disable()
+      }
+    } catch (error) {
+      console.error("Unable to update push notification settings", error)
+      this.#updateState(false, true)
+    } finally {
+      this.toggleTarget.disabled = false
+    }
+  }
+
+  async #enable() {
+    const permission = Notification.permission === "default"
+      ? await Notification.requestPermission()
+      : Notification.permission
+
+    if (permission === "granted") {
+      const subscription = await this.#subscription || await this.#registration.then(registration => registration.pushManager.subscribe({
+        applicationServerKey: this.#applicationServerKey,
+        userVisibleOnly: true
+      }))
+
+      await this.#saveSubscription(subscription)
+      this.#updateState(true)
+    } else {
+      this.#updateState(false, permission === "denied")
+    }
+  }
+
+  async #disable() {
+    const subscription = await this.#subscription
+
+    if (subscription && await subscription.unsubscribe()) {
+      if (this.subscriptionId) {
+        await this.#request(`${this.subscriptionsUrlValue}/${this.subscriptionId}`, "DELETE")
+      }
+
+      this.subscriptionId = null
+      this.#updateState(false)
+    } else {
+      throw new Error("The browser could not remove its push subscription")
+    }
+  }
+
+  async #saveSubscription(subscription) {
+    const data = subscription.toJSON()
+    const keys = data.keys || {}
+    const response = await this.#request(this.subscriptionsUrlValue, "POST", {
+      push_subscription: {
+        endpoint: data.endpoint,
+        p256dh_key: keys.p256dh,
+        auth_key: keys.auth
+      }
+    })
+
+    this.subscriptionId = (await response.json()).id
+  }
+
+  async #request(url, method, body) {
+    const response = await fetch(url, {
+      method,
+      credentials: "same-origin",
+      headers: {
+        "Accept": "application/json",
+        "Content-Type": "application/json",
+        "X-CSRF-Token": this.#csrfToken
+      },
+      body: body ? JSON.stringify(body) : undefined
+    })
+
+    if (!response.ok) {
+      throw new Error(`Push subscription request failed with ${response.status}`)
+    }
+
+    return response
+  }
+
+  #updateState(enabled, showDetails = false) {
+    this.element.classList.toggle("notifications--on", enabled)
+    this.toggleTarget.checked = enabled
+    this.toggleTarget.disabled = false
+    this.#showDetails(showDetails)
+  }
+
+  #showDetails(show) {
+    this.detailsTargets.forEach(details => details.hidden = !show)
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padding = "=".repeat((4 - base64.length % 4) % 4)
+    const binary = atob(base64 + padding)
+
+    return Uint8Array.from(binary, character => character.charCodeAt(0))
+  }
+
+  get #csrfToken() {
+    return document.head.querySelector('meta[name="csrf-token"]')?.content
+  }
+
+  get #registration() {
+    return navigator.serviceWorker.ready
+  }
+
+  get #subscription() {
+    return this.#registration.then(registration => registration.pushManager.getSubscription())
+  }
+
+  get #supported() {
+    return "Notification" in window && "PushManager" in window && "serviceWorker" in navigator
+  }
+}
diff --git a/app/jobs/push_subscription/delivery_job.rb b/app/jobs/push_subscription/delivery_job.rb
