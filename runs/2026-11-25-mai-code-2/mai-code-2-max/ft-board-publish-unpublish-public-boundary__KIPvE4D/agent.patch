diff --git a/app/views/public/boards/cards/show.html.erb b/app/views/public/boards/cards/show.html.erb
new file mode 100644
index 0000000..5ae0deb
--- /dev/null
+++ b/app/views/public/boards/cards/show.html.erb
@@ -0,0 +1,116 @@
+<% @page_title = @card.title %>
+<% @header_class = "header--card" %>
+
+<% content_for :head do %>
+  <%= tag.meta property: "og:title", content: "#{@card.title} | #{@board.name}" %>
+  <%= tag.meta property: "og:description", content: format_excerpt(@card.description, length: 200) %>
+  <%= tag.meta property: "og:url", content: public_board_card_url(@publication.key, @card.number, script_name: nil) %>
+<% end %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to @board.name, public_board_path(@publication.key), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+<% end %>
+
+<section class="card-perma" style="--card-color: <%= @card.color %>;">
+  <div class="card-perma__bg">
+    <%= card_article_tag @card, class: "card" do %>
+      <header class="card__header">
+        <%= render "cards/display/preview/board", card: @card %>
+        <% if @card.tags.any? %>
+          <div class="card__tags">
+            <% @card.tags.each_with_index do |tag, index| %>
+              <span class="card__tag btn btn--plain"><%= tag.title %></span><%= "," unless index == @card.tags.size - 1 %>
+            <% end %>
+          </div>
+        <% end %>
+      </header>
+
+      <div class="card__body justify-space-between">
+        <div class="card__content">
+          <h1 class="card__title"><%= card_html_title(@card) %></h1>
+          <% unless @card.description.blank? %>
+            <div class="card__description lexxy-content" data-controller="syntax-highlight retarget-links">
+              <%= @card.description %>
+            </div>
+          <% end %>
+
+          <% if @card.steps.any? %>
+            <ol class="steps txt-small margin-block-start-auto">
+              <% @card.steps.each do |step| %>
+                <li class="step">
+                  <input type="checkbox" class="checkbox" disabled <%= "checked" if step.completed? %>>
+                  <span class="step__content"><%= step.content %></span>
+                </li>
+              <% end %>
+            </ol>
+          <% end %>
+        </div>
+
+        <%= render "cards/display/common/stamp", card: @card %>
+      </div>
+
+      <footer class="card__footer">
+        <div class="card__meta">
+          <div class="card__meta-avatars card__meta-avatars--author">
+            <%= avatar_preview_tag @card.creator %>
+          </div>
+          <span class="card__meta-text card__meta-text--added">Added <%= local_datetime_tag(@card.created_at, style: :daysago) %></span>
+          <span class="card__meta-text card__meta-text--author">By <strong><%= @card.creator.familiar_name %></strong></span>
+          <span class="card__meta-text card__meta-text--updated overflow-ellipsis">Updated <%= local_datetime_tag(@card.last_active_at, style: :daysago) %></span>
+          <% if @card.assignees.any? %>
+            <span class="card__meta-text card__meta-text--assignees overflow-ellipsis">
+              Assigned to <%= @card.assignees.map { |assignee| h assignee.familiar_name }.to_sentence.html_safe %>
+            </span>
+            <div class="card__meta-avatars card__meta-avatars--assignees"><% @card.assignees.each { |assignee| %><%= avatar_preview_tag assignee %><% } %></div>
+          <% end %>
+        </div>
+        <%= render "cards/display/common/background", card: @card %>
+
+        <% if @card.reactions.any? %>
+          <div class="reactions">
+            <div class="reactions__list">
+              <% @card.reactions.each do |reaction| %>
+                <div class="reaction">
+                  <figure class="reaction__avatar margin-none flex-item-no-shrink"><%= avatar_preview_tag reaction.reacter %></figure>
+                  <span class="txt-small"><%= reaction.content %></span>
+                </div>
+              <% end %>
+            </div>
+          </div>
+        <% end %>
+      </footer>
+    <% end %>
+  </div>
+</section>
+
+<% if @card.comments.any? %>
+  <section class="comments gap center" role="group" aria-label="Messages">
+    <% @card.comments.preloaded.chronologically.each do |comment| %>
+      <div class="comment align-start full-width">
+        <figure class="comment__avatar flex-item-no-shrink" aria-hidden="true"><%= avatar_preview_tag comment.creator, hidden_for_screen_reader: true %></figure>
+        <div class="comment__content flex flex-column flex-item-grow full-width">
+          <div class="comment__author flex align-center gap-half">
+            <h3 class="font-weight-normal txt-normal flex-item-justify-start min-width overflow-ellipsis">
+              <strong><%= comment.creator.name %></strong>,
+              <%= local_datetime_tag comment.created_at, style: :agoorweekday %>,
+              <%= local_datetime_tag comment.created_at, style: :time %>
+            </h3>
+          </div>
+          <div class="comment__body lexxy-content" data-controller="syntax-highlight retarget-links"><%= comment.body %></div>
+          <% if comment.reactions.any? %>
+            <div class="reactions__list">
+              <% comment.reactions.each do |reaction| %>
+                <div class="reaction">
+                  <figure class="reaction__avatar margin-none flex-item-no-shrink"><%= avatar_preview_tag reaction.reacter %></figure>
+                  <span class="txt-small"><%= reaction.content %></span>
+                </div>
+              <% end %>
+            </div>
+          <% end %>
+        </div>
+      </div>
+    <% end %>
+  </section>
+<% end %>
