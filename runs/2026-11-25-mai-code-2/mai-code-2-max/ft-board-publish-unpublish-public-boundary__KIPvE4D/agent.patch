diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..7468c36
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "published card attachments are publicly accessible" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("image"), filename: "image.png", content_type: "image/png")
+
+    assert_not card.image.blob.publicly_accessible?
+
+    board.publish
+    assert card.image.blob.publicly_accessible?
+
+    board.unpublish
+    assert_not card.image.blob.publicly_accessible?
+  end
+
+  test "publish is idempotent and unpublish rotates the key" do
+    board = boards(:writebook)
+
+    assert_not board.published?
+    publication = board.publish
+
+    assert board.published?
+    assert_equal publication, board.publish
+
+    old_key = publication.key
+    board.unpublish
+
+    assert_not board.published?
+    assert_not_equal old_key, board.publish.key
+  end
+end
