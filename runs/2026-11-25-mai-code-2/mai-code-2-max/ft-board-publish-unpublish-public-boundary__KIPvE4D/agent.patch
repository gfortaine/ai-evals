diff --git a/test/controllers/public/boards/cards_controller_test.rb b/test/controllers/public/boards/cards_controller_test.rb
new file mode 100644
index 0000000..967935f
--- /dev/null
+++ b/test/controllers/public/boards/cards_controller_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.publish
+  end
+
+  test "show published card" do
+    card = cards(:logo)
+
+    untenanted do
+      get public_board_card_path(@publication.key, card.number)
+    end
+
+    assert_response :success
+    assert_select "h1", text: card.title
+    assert_select "a[href=?]", public_board_path(@publication.key, script_name: nil)
+  end
+
+  test "show as JSON" do
+    card = cards(:logo)
+
+    untenanted do
+      get public_board_card_path(@publication.key, card.number), as: :json
+    end
+
+    assert_response :success
+    assert_equal card.number, @response.parsed_body["number"]
+    assert_equal public_board_card_url(@publication.key, card.number, script_name: nil), @response.parsed_body["url"]
+    assert_not @response.parsed_body.dig("creator").key?("email_address")
+  end
+
+  test "show excludes drafted cards" do
+    card = @board.cards.create!(creator: users(:kevin), title: "Secret draft", status: :drafted)
+
+    untenanted do
+      get public_board_card_path(@publication.key, card.number)
+    end
+
+    assert_response :not_found
+  end
+
+  test "show scopes a card number to the public board" do
+    card = cards(:radio)
+
+    untenanted do
+      get public_board_card_path(@publication.key, card.number)
+    end
+
+    assert_response :success
+    assert_select "h1", text: cards(:logo).title
+    assert_select "h1", text: card.title, count: 0
+  end
+end
