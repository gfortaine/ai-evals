diff --git a/spec/models/profile_imageable_spec.rb b/spec/models/profile_imageable_spec.rb
new file mode 100644
index 0000000..1ef88ce
--- /dev/null
+++ b/spec/models/profile_imageable_spec.rb
@@ -0,0 +1,94 @@
+require "rails_helper"
+
+RSpec.describe ProfileImageable do
+  shared_examples "a profile image owner" do |factory|
+    it "stores new profile images with Active Storage" do
+      owner = create(factory)
+
+      expect(owner.profile_image).to be_attached
+      expect(owner[:profile_image]).to be_nil
+      expect(owner.profile_image_url).to include("/rails/active_storage/blobs/")
+    end
+
+    it "stores downloaded profile images with Active Storage" do
+      image_url = "https://images.example.com/profile.jpg"
+      image_body = Rails.root.join("spec/support/fixtures/images/image1.jpeg").binread
+      stub_request(:get, image_url).to_return(
+        body: image_body,
+        headers: { "Content-Type" => "image/jpeg" },
+      )
+      owner = build(factory, profile_image: nil)
+
+      owner.remote_profile_image_url = image_url
+      owner.save!
+
+      expect(owner.profile_image).to be_attached
+      expect(owner[:profile_image]).to be_nil
+      expect(owner.remote_profile_image_url).to eq(image_url)
+      expect(owner.profile_image.download).to eq(image_body)
+    end
+
+    it "serves an existing CarrierWave profile image" do
+      owner = create(factory)
+      owner.profile_image.purge
+      owner.update_columns(profile_image: "legacy.jpeg")
+      owner.reload
+
+      expect(owner.profile_image).not_to be_attached
+      expect(owner.profile_image_url).to end_with(
+        "/uploads/#{owner.model_name.singular}/profile_image/#{owner.id}/legacy.jpeg",
+      )
+      expect(owner.as_json["profile_image"]).to eq(owner.profile_image_url)
+    end
+
+    it "keeps the legacy image column when attaching a replacement" do
+      owner = create(factory)
+      owner.update_columns(profile_image: "legacy.jpeg")
+      owner.reload
+
+      replacement = Rack::Test::UploadedFile.new(
+        Rails.root.join("spec/support/fixtures/images/image2.jpeg"),
+        "image/jpeg",
+      )
+      owner.update!(profile_image: replacement)
+
+      expect(owner.reload.profile_image).to be_attached
+      expect(owner[:profile_image]).to eq("legacy.jpeg")
+      expect(owner.profile_image_url).to include("/rails/active_storage/blobs/")
+      expect(owner.profile_image_url).not_to include("legacy.jpeg")
+    end
+  end
+
+  context "with a user" do
+    it_behaves_like "a profile image owner", :user
+
+    it "keeps signup valid when a remote profile image cannot be processed" do
+      image_url = "https://images.example.com/not-an-image"
+      stub_request(:get, image_url).to_return(body: "not an image", headers: { "Content-Type" => "text/plain" })
+      user = build(:user, profile_image: nil)
+
+      user.remote_profile_image_url = image_url
+      user.save!
+
+      expect(user.profile_image).not_to be_attached
+      expect(user.remote_profile_image_url).to eq(image_url)
+    end
+  end
+
+  context "with an organization" do
+    it_behaves_like "a profile image owner", :organization
+
+    it "accepts an existing CarrierWave image during validation" do
+      organization = create(:organization)
+      organization.profile_image.purge
+      organization.update_columns(profile_image: "legacy.jpeg")
+
+      expect(organization.reload.update(name: "Legacy org")).to be(true)
+    end
+  end
+
+  it "leaves unrelated uploads on CarrierWave" do
+    expect(build(:organization).cover_image).to be_a(CoverImageUploader)
+    expect(Tag.new.profile_image).to be_a(ProfileImageUploader)
+  end
+end
