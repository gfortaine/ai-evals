diff --git a/lib/active_storage/service/fog_service.rb b/lib/active_storage/service/fog_service.rb
new file mode 100644
index 0000000..a847549
--- /dev/null
+++ b/lib/active_storage/service/fog_service.rb
@@ -0,0 +1,131 @@
+require "active_storage/service"
+require "fog/aws"
+
+class ActiveStorage::Service::FogService < ActiveStorage::Service # rubocop:disable Style/ClassAndModuleChildren
+  def initialize(bucket:, region:, access_key_id: nil, secret_access_key: nil, use_iam_profile: false)
+    super()
+    credentials = { provider: "AWS", region: region }
+    if use_iam_profile
+      credentials[:use_iam_profile] = true
+    else
+      credentials[:aws_access_key_id] = access_key_id
+      credentials[:aws_secret_access_key] = secret_access_key
+    end
+
+    @credentials = credentials
+    @bucket = bucket
+  end
+
+  def upload(key, io, checksum: nil, content_type: nil, disposition: nil, filename: nil,
+             custom_metadata: {}, **)
+    instrument :upload, key: key, checksum: checksum do
+      io.rewind if io.respond_to?(:rewind)
+      file_for(key).tap do |file|
+        file.body = io
+        file.content_type = content_type
+        file.content_md5 = checksum
+        file.content_disposition = content_disposition_with(type: disposition, filename: filename) if filename
+        file.metadata = custom_metadata_headers(custom_metadata)
+        file.public = false
+        file.save
+      end
+    end
+  end
+
+  def download(key, &block)
+    instrument :download, key: key do
+      data = find_file(key).body.dup.force_encoding(Encoding::BINARY)
+      if block
+        StringIO.new(data).each(5.megabytes, &block)
+      else
+        data
+      end
+    end
+  rescue Excon::Errors::NotFound
+    raise ActiveStorage::FileNotFoundError
+  end
+
+  def download_chunk(key, range)
+    instrument :download_chunk, key: key, range: range do
+      data = find_file(key).body.dup.force_encoding(Encoding::BINARY)
+      data.byteslice(range.begin, range.size) || raise(ActiveStorage::FileNotFoundError)
+    end
+  rescue Excon::Errors::NotFound
+    raise ActiveStorage::FileNotFoundError
+  end
+
+  def delete(key)
+    instrument :delete, key: key do
+      directory.files.head(key)&.destroy
+    end
+  end
+
+  def delete_prefixed(prefix)
+    instrument :delete_prefixed, prefix: prefix do
+      directory.files.all(prefix: prefix).map(&:destroy)
+    end
+  end
+
+  def exist?(key)
+    instrument :exist, key: key do |payload|
+      payload[:exist] = directory.files.head(key).present?
+      payload[:exist]
+    end
+  end
+
+  def url_for_direct_upload(key, expires_in:, content_type:, content_length:, checksum:, custom_metadata: {})
+    headers = headers_for_direct_upload(
+      key,
+      content_type: content_type,
+      content_length: content_length,
+      checksum: checksum,
+      custom_metadata: custom_metadata,
+    )
+    headers["Content-Length"] = content_length.to_s
+    connection.put_object_url(directory.key, key, Time.current.to_i + expires_in.to_i, headers)
+  end
+
+  def headers_for_direct_upload(_key, content_type:, checksum:, custom_metadata: {}, **)
+    {
+      "Content-Type" => content_type,
+      "Content-MD5" => checksum,
+      **custom_metadata_headers(custom_metadata)
+    }
+  end
+
+  private
+
+  def connection
+    @connection ||= Fog::Storage.new(@credentials)
+  end
+
+  def directory
+    @directory ||= connection.directories.new(key: @bucket)
+  end
+
+  def file_for(key)
+    directory.files.new(key: key)
+  end
+
+  def find_file(key)
+    directory.files.get(key) || raise(ActiveStorage::FileNotFoundError)
+  end
+
+  def private_url(key, expires_in:, filename:, disposition:, content_type:, **)
+    query = {
+      "response-content-disposition" => content_disposition_with(type: disposition, filename: filename),
+      "response-content-type" => content_type
+    }.compact_blank
+
+    connection.get_object_url(
+      directory.key,
+      key,
+      Time.current.to_i + expires_in.to_i,
+      query: query,
+    )
+  end
+
+  def custom_metadata_headers(metadata)
+    metadata.transform_keys { |key| "x-amz-meta-#{key}" }
+  end
+end
