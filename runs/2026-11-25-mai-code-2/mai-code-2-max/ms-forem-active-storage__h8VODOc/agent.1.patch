diff --git a/app/models/concerns/profile_imageable.rb b/app/models/concerns/profile_imageable.rb
new file mode 100644
index 0000000..7cb4d38
--- /dev/null
+++ b/app/models/concerns/profile_imageable.rb
@@ -0,0 +1,162 @@
+module ProfileImageable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one_attached :profile_image, dependent: :purge_later
+    mount_uploader :legacy_profile_image, LegacyProfileImageUploader, mount_on: :profile_image
+
+    before_save :remember_profile_image_attachment_change
+    after_commit :discard_staged_profile_images, on: %i[create update]
+    after_rollback :discard_staged_profile_images
+
+    validate :validate_profile_image_upload
+  end
+
+  def profile_image=(attachable)
+    @profile_image_upload_errors = nil
+
+    if remote_profile_image_url?(attachable)
+      self.remote_profile_image_url = attachable
+    elsif !stage_profile_image?(attachable)
+      super
+    else
+      stage_profile_image(attachable) { |staged_file| super(staged_file) }
+    end
+  rescue CarrierWave::IntegrityError, CarrierWave::ProcessingError => e
+    if @remote_profile_image_upload
+      Rails.logger.warn("Unable to attach remote profile image: #{e.message}")
+    else
+      record_profile_image_upload_error(e)
+    end
+  end
+
+  def remote_profile_image_url
+    @remote_profile_image_url
+  end
+
+  def remote_profile_image_url=(url)
+    @remote_profile_image_url = url
+    if url.blank?
+      nil
+    elsif url.is_a?(String)
+      @remote_profile_image_upload = true
+      uploader = ProfileImageUploader.new(self, :profile_image)
+      uploader.download!(url)
+      if uploader.file
+        (@staged_profile_images ||= []) << [nil, uploader]
+        self.profile_image = uploader.file
+      else
+        uploader.remove!
+        Rails.logger.warn("Unable to download remote profile image #{url}: no file returned")
+      end
+    else
+      self.profile_image = url
+    end
+  rescue CarrierWave::DownloadError, CarrierWave::IntegrityError, CarrierWave::ProcessingError => e
+    uploader&.remove!
+    Rails.logger.warn("Unable to download remote profile image #{url}: #{e.message}")
+  ensure
+    @remote_profile_image_upload = false
+  end
+
+  def profile_image_url
+    image = profile_image
+    if image.respond_to?(:attached?) && image.attached? && image.blob.persisted?
+      URL.url(Rails.application.routes.url_helpers.rails_blob_path(image.blob))
+    else
+      legacy_profile_image_url
+    end
+  end
+
+  def profile_image_present?
+    image = profile_image
+    legacy_profile_image_identifier.present? || (image.respond_to?(:attached?) ? image.attached? : image.present?)
+  end
+
+  def read_attribute_for_serialization(attribute)
+    return profile_image_url if attribute.to_s == "profile_image"
+
+    super
+  end
+
+  private
+
+  def remote_profile_image_url?(attachable)
+    attachable.is_a?(String) && attachable.match?(%r{\Ahttps?://}i)
+  end
+
+  def stage_profile_image?(attachable)
+    attachable.present? && !attachable.is_a?(Hash) && !attachable.is_a?(ActiveStorage::Blob)
+  end
+
+  def stage_profile_image(attachable)
+    uploader = ProfileImageUploader.new(self, :profile_image)
+    begin
+      uploader.cache!(attachable)
+      unless uploader.file
+        min_size = ActiveSupport::NumberHelper.number_to_human_size(ProfileImageUploader.new.size_range.min)
+        raise CarrierWave::IntegrityError, I18n.t("errors.messages.min_size_error", min_size: min_size)
+      end
+      io = File.open(uploader.file.path, "rb")
+      staged_file = {
+        io: io,
+        filename: uploader.filename || uploader.file.filename,
+        content_type: uploader.file.content_type
+      }
+      (@staged_profile_images ||= []) << [io, uploader]
+      yield staged_file
+      # CarrierWave's image bomb protection already analyzed this staged image.
+      profile_image.blob.analyzed = true
+    rescue CarrierWave::IntegrityError, CarrierWave::ProcessingError
+      uploader.remove!
+      raise
+    end
+  end
+
+  def record_profile_image_upload_error(error)
+    (@profile_image_upload_errors ||= []) << error.message
+  end
+
+  def validate_profile_image_upload
+    @profile_image_upload_errors&.each { |message| errors.add(:profile_image, message) }
+    image = profile_image
+    return unless attachment_changes.key?("profile_image") && image.respond_to?(:attached?)
+    return unless image.attached?
+
+    blob = image.blob
+    size_range = ProfileImageUploader.new.size_range
+    if blob.byte_size < size_range.min
+      errors.add(:profile_image,
+                 I18n.t("errors.messages.min_size_error",
+                        min_size: ActiveSupport::NumberHelper.number_to_human_size(size_range.min)))
+    elsif blob.byte_size > size_range.max
+      errors.add(:profile_image,
+                 I18n.t("errors.messages.max_size_error",
+                        max_size: ActiveSupport::NumberHelper.number_to_human_size(size_range.max)))
+    end
+
+    extension = blob.filename.extension.downcase
+    return if ProfileImageUploader::EXTENSION_ALLOWLIST.include?(extension) && blob.content_type&.start_with?("image/")
+
+    errors.add(:profile_image,
+               I18n.t("errors.messages.extension_allowlist_error",
+                      extension: extension.inspect,
+                      allowed_types: ProfileImageUploader::EXTENSION_ALLOWLIST.join(", ")))
+  end
+
+  def remember_profile_image_attachment_change
+    @profile_image_attachment_changed = attachment_changes.key?("profile_image")
+  end
+
+  def profile_image_attachment_changed?
+    @profile_image_attachment_changed || saved_change_to_attribute?(:profile_image)
+  end
+
+  def discard_staged_profile_images
+    Array(@staged_profile_images).each do |io, uploader|
+      io.close if io && !io.closed?
+      uploader.remove!
+    end
+    @staged_profile_images = nil
+  end
+end
