+require "rails_helper"
+require Rails.root.join("lib/active_storage/service/fog_service")
+
+RSpec.describe ActiveStorage::Service::FogService, type: :service do
+  subject(:service) do
+    described_class.new(
+      bucket: bucket,
+      region: "us-east-2",
+      access_key_id: "access-key",
+      secret_access_key: "secret-key",
+    )
+  end
+
+  let(:bucket) { "profile-images-#{SecureRandom.hex(8)}" }
+
+  around do |example|
+    Fog.mock!
+    connection = Fog::Storage.new(
+      provider: "AWS",
+      region: "us-east-2",
+      aws_access_key_id: "access-key",
+      aws_secret_access_key: "secret-key",
+    )
+    connection.directories.create(key: bucket)
+    example.run
+  ensure
+    Fog.unmock!
+  end
+
+  it "stores, reads, and deletes Active Storage objects" do
+    contents = "profile image"
+    io = StringIO.new(contents)
+    checksum = Base64.strict_encode64(OpenSSL::Digest::MD5.digest(contents))
+
+    service.upload("new-image", io, checksum: checksum, content_type: "image/png")
+
+    expect(service).to exist("new-image")
+    expect(service.download("new-image")).to eq(contents)
+
+    service.delete("new-image")
+    expect(service).not_to exist("new-image")
+  end
+
+  it "generates private upload URLs" do
+    url = service.url_for_direct_upload(
+      "new-image", expires_in: 1.minute, content_type: "image/png", content_length: 12, checksum: "checksum"
+    )
+
+    expect(url).to include("#{bucket}.s3.us-east-2.amazonaws.com/new-image")
+  end
+end
