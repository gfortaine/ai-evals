@@ -25,10 +31,61 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      system_users = {}
+
+      each_due_card_id_batch do |account, card_ids|
+        system_user = system_users[account.id] ||= account.system_user
+        auto_postpone_batch(account, card_ids, user: system_user)
+      end
+    end
+
+    def auto_postpone_all_due_later
+      jobs = []
+
+      each_due_card_id_batch do |account, card_ids|
+        jobs << Card::AutoPostponeJob.new(account, card_ids)
+      end
+
+      ActiveJob.perform_all_later(jobs) if jobs.any?
+    end
+
+    def auto_postpone_batch(account, card_ids, user: nil)
+      cards = account.cards.active
+        .where(id: card_ids)
+        .preload(:closure, :not_now, :activity_spike, :column, board: [ :entropy, { account: :entropy } ])
+        .select { |card| card.entropy.auto_clean_at <= Time.current }
+
+      if cards.any?
+        user ||= account.system_user
+        boards = cards.map(&:board).uniq
+
+        transaction do
+          Board.no_touching do
+            cards.each { |card| card.auto_postpone(user: user) }
+          end
+
+          boards.each(&:touch)
+        end
       end
     end
+
+    private
+      def each_due_card_id_batch
+        now = Time.current
+
+        Account.preload(:entropy).find_each do |account|
+          account.boards.preload(:entropy).group_by(&:auto_postpone_period).each do |period, boards|
+            boards.map(&:id).each_slice(AUTO_POSTPONE_BOARD_BATCH_SIZE) do |board_ids|
+              account.cards.active
+                .where(board_id: board_ids, last_active_at: ..(now - period))
+                .pluck(:id)
+                .each_slice(AUTO_POSTPONE_CARD_BATCH_SIZE) do |card_ids|
+                  yield account, card_ids
+                end
+            end
+          end
+        end
+      end
   end
 
   def entropy
