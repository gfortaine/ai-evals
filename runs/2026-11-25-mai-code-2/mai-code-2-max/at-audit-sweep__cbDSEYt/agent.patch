diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..68e2b32
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "show only returns leaves from readable books" do
+    leaves(:welcome_page).update!(title: "Visible needle")
+    restricted_leaf = books(:manual).press Page.new(body: "Restricted"), title: "Restricted needle"
+
+    get library_search_path(q: "needle")
+
+    assert_response :success
+    assert_in_body "Visible needle"
+    assert_not_in_body restricted_leaf.title
+  end
+
+  test "show returns published results to unauthenticated users" do
+    books(:manual).update!(published: true)
+    published_leaf = books(:manual).press Page.new(body: "Public"), title: "Public needle"
+    sign_out
+
+    get library_search_path(q: "needle")
+
+    assert_response :success
+    assert_in_body published_leaf.title
+  end
+
+  test "show treats apostrophes as data" do
+    leaves(:welcome_page).update!(title: "Developer's guide")
+
+    get library_search_path(q: "Developer's")
+
+    assert_response :success
+    assert_in_body "Developer&#39;s guide"
+  end
+
+  test "show does not allow a query to bypass book access" do
+    restricted_leaf = books(:manual).press Page.new(body: "Restricted"), title: "Restricted secret"
+
+    get library_search_path(q: "%' OR 1=1 --")
+
+    assert_response :success
+    assert_not_in_body restricted_leaf.title
+  end
+
+  test "show treats percent signs as literal characters" do
+    leaves(:welcome_page).update!(title: "Save 50% off")
+    leaves(:summary_page).update!(title: "Save 5000 off")
+
+    get library_search_path(q: "%")
+
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save 5000 off"
+
+    get library_search_path(q: "Save 50% off")
+
+    assert_response :success
+    assert_in_body "Save 50% off"
+  end
+
+  test "show treats underscores as literal characters" do
+    leaves(:welcome_page).update!(title: "Save_50")
+    leaves(:summary_page).update!(title: "Save 50")
+
+    get library_search_path(q: "_")
+
+    assert_response :success
+    assert_in_body "Save_50"
+    assert_not_in_body "Save 50"
+  end
+end
