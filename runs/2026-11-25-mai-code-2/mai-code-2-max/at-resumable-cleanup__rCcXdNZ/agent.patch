+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  test "resumes after the last cleaned leaf" do
+    ordered_leaves = Leaf.order(:id).to_a
+    wrapped_titles = [ '"Plain"', '""Quoted" opening"', '"Another"', '"Last"' ]
+
+    ordered_leaves.zip(wrapped_titles).each do |leaf, title|
+      leaf.update! title: title
+    end
+
+    TitleCleanupJob.perform_later
+    interrupt_job_during_step TitleCleanupJob, :clean_titles, cursor: ordered_leaves.second.id + 1 do
+      perform_enqueued_jobs
+    end
+
+    assert_equal [ "Plain", '"Quoted" opening', '"Another"', '"Last"' ], ordered_leaves.map { |leaf| leaf.reload.title }
+    assert_not enqueued_jobs.first.key?(:at)
+
+    perform_enqueued_jobs
+
+    assert_equal [ "Plain", '"Quoted" opening', "Another", "Last" ], ordered_leaves.map { |leaf| leaf.reload.title }
+  end
+
+  test "resque shutdown signals the continuation checkpoint" do
+    queue_adapter = ActiveJob::Base.queue_adapter
+    queue_adapter.stopping = false
+
+    Resque::Worker.new("default").shutdown
+
+    assert_predicate queue_adapter, :stopping?
+  ensure
+    queue_adapter.stopping = false if queue_adapter
+  end
+end
