diff --git a/test/controllers/action_text/markdown/uploads_controller_test.rb b/test/controllers/action_text/markdown/uploads_controller_test.rb
index 48141c1..0713a79 100644
--- a/test/controllers/action_text/markdown/uploads_controller_test.rb
+++ b/test/controllers/action_text/markdown/uploads_controller_test.rb
@@ -31,4 +31,82 @@ class ActionText::Markdown::UploadsControllerTest < ActionDispatch::IntegrationT
     assert_response :redirect
     assert_match /\/rails\/active_storage\/.*\/reading\.webp/, @response.redirect_url
   end
+
+  test "upload image, fetch it back, and purge file and blob when page is destroyed" do
+    post action_text_markdown_uploads_path, params: {
+      record_gid: pages(:welcome).to_signed_global_id.to_s,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+    assert_response :created
+
+    file_url = JSON.parse(response.body)["fileUrl"]
+    attachment = pages(:welcome).body.uploads.attachments.last
+    blob = attachment.blob
+    key = blob.key
+    service = blob.service
+
+    get file_url
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_equal "image/webp", response.media_type
+
+    put leafable_path(leaves(:welcome_page)), params: {
+      page: { body: "Embedded image:\n\n![reading.webp](#{file_url})" }
+    }
+    assert_response :no_content
+
+    page = leaves(:welcome_page).reload.page
+    assert service.exist?(key)
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not service.exist?(key)
+
+    get file_url
+    assert_response :not_found
+  end
+
+  test "upload with stale page gid after autosave attaches to active page and purges on destroy" do
+    stale_gid = pages(:welcome).to_signed_global_id.to_s
+
+    put leafable_path(leaves(:welcome_page)), params: {
+      page: { body: "Autosaved draft before uploading image" }
+    }
+    assert_response :no_content
+
+    post action_text_markdown_uploads_path, params: {
+      record_gid: stale_gid,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+    assert_response :created
+
+    file_url = JSON.parse(response.body)["fileUrl"]
+    active_page = leaves(:welcome_page).reload.page
+    attachment = active_page.body.uploads.attachments.last
+    assert_not_nil attachment
+
+    blob = attachment.blob
+    key = blob.key
+    service = blob.service
+
+    put leafable_path(leaves(:welcome_page)), params: {
+      page: { body: "Autosaved draft with ![reading.webp](#{file_url})" }
+    }
+    assert_response :no_content
+
+    perform_enqueued_jobs do
+      leaves(:welcome_page).reload.page.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not service.exist?(key)
+  end
 end
