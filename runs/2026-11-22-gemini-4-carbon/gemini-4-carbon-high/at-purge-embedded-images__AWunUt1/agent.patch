diff --git a/test/controllers/action_text/markdown/uploads_controller_test.rb b/test/controllers/action_text/markdown/uploads_controller_test.rb
index 48141c1..b5c571d 100644
--- a/test/controllers/action_text/markdown/uploads_controller_test.rb
+++ b/test/controllers/action_text/markdown/uploads_controller_test.rb
@@ -31,4 +31,107 @@ class ActionText::Markdown::UploadsControllerTest < ActionDispatch::IntegrationT
     assert_response :redirect
     assert_match /\/rails\/active_storage\/.*\/reading\.webp/, @response.redirect_url
   end
+
+  test "upload and fetch embedded image, then purge blob and file when page is destroyed" do
+    page = pages(:welcome)
+    other_page = pages(:summary)
+
+    post action_text_markdown_uploads_path, params: {
+      record_gid: other_page.to_signed_global_id.to_s,
+      attribute_name: "body",
+      file: fixture_file_upload("white-rabbit.webp", "image/webp")
+    }, as: :xhr
+    assert_response :created
+    other_file_url = JSON.parse(response.body)["fileUrl"]
+    other_blob = other_page.reload.body.uploads.attachments.last.blob
+
+    post action_text_markdown_uploads_path, params: {
+      record_gid: page.to_signed_global_id.to_s,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+    assert_response :created
+
+    file_url = JSON.parse(response.body)["fileUrl"]
+    attachment = page.reload.body.uploads.attachments.last
+    blob = attachment.blob
+
+    get file_url
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_equal file_fixture("reading.webp").binread, response.body
+
+    page.update!(body: "![reading](#{file_url})")
+    assert blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+
+    get file_url
+    assert_response :not_found
+
+    assert ActiveStorage::Blob.exists?(other_blob.id)
+    assert other_blob.service.exist?(other_blob.key)
+    get other_file_url
+    assert_response :redirect
+  end
+
+  test "destroying an edited page purges its uploaded markdown images" do
+    leaf = leaves(:welcome_page)
+    initial_page_gid = leaf.page.to_signed_global_id.to_s
+
+    post action_text_markdown_uploads_path, params: {
+      record_gid: initial_page_gid,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+    assert_response :created
+    first_url = JSON.parse(response.body)["fileUrl"]
+
+    put leafable_path(leaf), params: {
+      leaf: { title: leaf.title },
+      page: { body: "First image: ![reading](#{first_url})" }
+    }
+    assert_response :no_content
+
+    # Subsequent upload from the same editor session still carries initial_page_gid
+    post action_text_markdown_uploads_path, params: {
+      record_gid: initial_page_gid,
+      attribute_name: "body",
+      file: fixture_file_upload("white-rabbit.webp", "image/webp")
+    }, as: :xhr
+    assert_response :created
+    second_url = JSON.parse(response.body)["fileUrl"]
+
+    put leafable_path(leaf), params: {
+      leaf: { title: leaf.title },
+      page: { body: "Both images: ![reading](#{first_url}) ![rabbit](#{second_url})" }
+    }
+    assert_response :no_content
+
+    current_page = leaf.reload.page
+    blobs = current_page.body.uploads_blobs.to_a
+    assert_equal 2, blobs.size
+    blobs.each { |blob| assert blob.service.exist?(blob.key) }
+
+    perform_enqueued_jobs do
+      current_page.destroy!
+    end
+
+    blobs.each do |blob|
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+      assert_not blob.service.exist?(blob.key)
+    end
+
+    get first_url
+    assert_response :not_found
+    get second_url
+    assert_response :not_found
+  end
 end
