diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..5ba7a10 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -1,4 +1,5 @@
 require "test_helper"
+require "vips"
 
 class PicturesControllerTest < ActionDispatch::IntegrationTest
   setup do
@@ -38,4 +39,63 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "uploaded photograph is derived once in background job and reused when reader opens book and fetches picture" do
+    books(:handbook).update!(published: true)
+    leaf = leaves(:reading_picture)
+
+    Tempfile.create([ "photograph", ".jpg" ], binmode: true) do |file|
+      file.write Vips::Image.black(2000, 1200).add([ 100, 150, 200 ]).cast("uchar").write_to_buffer(".jpg")
+      file.flush
+      upload = Rack::Test::UploadedFile.new(file.path, "image/jpeg", true, original_filename: "photograph.jpg")
+
+      assert_no_notifications("transform.active_storage") do
+        put leafable_path(leaf), params: { picture: { image: upload } }
+        assert_response :no_content
+      end
+    end
+
+    assert_notifications_count("transform.active_storage", 1) do
+      assert_notifications_count("service_upload.active_storage", 1) do
+        perform_enqueued_jobs while enqueued_jobs.any?
+      end
+    end
+
+    blob = leaf.reload.picture.image.blob
+    assert_equal 1, blob.variant_records.count
+    derived_blob = blob.variant_records.sole.image.blob
+    assert ActiveStorage::Blob.service.exist?(derived_blob.key)
+
+    sign_out
+
+    assert_no_notifications("transform.active_storage") do
+      assert_no_notifications("service_upload.active_storage") do
+        assert_no_difference -> { ActiveStorage::Blob.count } do
+          get book_slug_path(books(:handbook))
+          assert_response :success
+
+          book_img_src = css_select("##{dom_id(leaf)} .toc__thumbnail img").first["src"]
+
+          get leafable_slug_path(leaf)
+          assert_response :success
+
+          leaf_img_src = css_select("figure.page--picture img").first["src"]
+          assert_equal book_img_src, leaf_img_src
+
+          get URI(book_img_src).request_uri
+          assert_response :redirect
+          follow_redirect!
+          assert_response :success
+        end
+      end
+    end
+
+    assert_equal 1, blob.variant_records.reload.count
+    assert_equal "image/webp", response.media_type
+    assert_equal derived_blob.download, response.body
+
+    served_image = Vips::Image.new_from_buffer(response.body, "")
+    assert_equal 1500, served_image.width
+    assert_equal 900, served_image.height
+  end
 end
