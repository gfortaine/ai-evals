diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..79de2ee
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,203 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "going live announces the book once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ] do
+        @book.update!(published: true)
+      end
+    end
+  end
+
+  test "going live and modifying leaves in the same sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.press Page.new(body: "New content"), title: "Added page"
+        leaves(:welcome_page).update!(title: "Renamed welcome")
+        leaves(:summary_page).trashed!
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "modifying leaves before going live in the same sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        leaves(:welcome_page).update!(title: "Updated first")
+        @book.press Page.new(body: "New content"), title: "Added first"
+        @book.update!(published: true)
+      end
+    end
+  end
+
+  test "toggling publication multiple times in a sitting that ends live announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.update!(published: false)
+        @book.update!(published: true)
+        @book.update!(title: "Final title")
+      end
+    end
+  end
+
+  test "creating a book directly live announces once" do
+    book = nil
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        book = Book.create!(title: "Born Live", published: true)
+        book.press Page.new(body: "Hello"), title: "Chapter 1"
+      end
+    end
+
+    assert book.reload.published?
+  end
+
+  test "creating a draft book and taking it live in the same sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        book = Book.create!(title: "Draft Then Live")
+        book.press Page.new(body: "Hello"), title: "Chapter 1"
+        book.update!(published: true)
+      end
+    end
+  end
+
+  test "saving an already-live book again does not announce again" do
+    @book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update!(title: "Updated Title")
+    end
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update!(published: true, slug: "updated-handbook")
+    end
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(subtitle: "New subtitle")
+        leaves(:welcome_page).update!(title: "Touched leaf")
+      end
+    end
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: false)
+        @book.update!(published: true)
+      end
+    end
+  end
+
+  test "taking a live book back down does not announce" do
+    @book.update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update!(published: false)
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "saving a draft book without taking it live announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update!(title: "Still a draft")
+    end
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.create!(title: "New draft")
+    end
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.update!(published: false)
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "destroying a book after marking it live in the same sitting announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.destroy!
+      end
+    end
+  end
+
+  test "a sitting that fails after the book was marked live leaves a draft and no announcement" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises(RuntimeError) do
+        @book.transaction do
+          @book.update!(published: true)
+          raise "Sitting failed"
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "nested savepoint rollback after marking live leaves a draft and no announcement" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.transaction(requires_new: true) do
+          @book.update!(published: true)
+          raise ActiveRecord::Rollback
+        end
+        leaves(:welcome_page).update!(title: "Still draft edit")
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "separate instances of the same book in one sitting follow final committed state" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        Book.find(@book.id).update!(published: true)
+        Book.find(@book.id).update!(title: "Updated via second instance")
+      end
+    end
+
+    manual = books(:manual)
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        Book.find(manual.id).update!(published: true)
+        Book.find(manual.id).update!(published: false)
+      end
+    end
+
+    assert_not manual.reload.published?
+  end
+
+  test "multiple books going live in one sitting are each announced once" do
+    manual = books(:manual)
+
+    assert_enqueued_jobs 2, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update!(published: true)
+        manual.update!(published: true)
+      end
+    end
+  end
+end
