+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,266 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "imports empty grants without queries or notifications" do
+    book = books(:manual)
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      assert_equal 0, count_queries { result = Book::AccessImport.new(book, []).import }
+    end
+
+    assert_equal [], result.accesses
+    assert_nil result.duplicate_index
+  end
+
+  test "imports valid grants in order and enqueues notifications" do
+    book = books(:manual)
+    book.accesses.delete_all
+
+    grants = [
+      { user_id: users(:kevin).id, level: "reader" },
+      { user_id: users(:david).id, level: :editor },
+      { user_id: users(:jz).id.to_s, level: "editor" }
+    ]
+
+    result = nil
+    assert_enqueued_jobs 3, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, grants).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal 3, result.accesses.size
+    assert_equal [ users(:kevin).id, users(:david).id, users(:jz).id ], result.accesses.map(&:user_id)
+    assert_equal %w[ reader editor editor ], result.accesses.map(&:level)
+    assert result.accesses.all?(&:persisted?)
+    assert_equal 3, book.accesses.count
+
+    result.accesses.each do |access|
+      assert_enqueued_with job: Book::AccessNotificationJob, args: [ access ]
+    end
+
+    perform_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "allows importing user who already has access on a different book" do
+    book = books(:manual)
+
+    assert books(:handbook).accessable?(user: users(:kevin))
+    assert_not book.accessable?(user: users(:kevin))
+
+    result = nil
+    assert_enqueued_jobs 1, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, [ { user_id: users(:kevin).id, level: "reader" } ]).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal [ users(:kevin).id ], result.accesses.map(&:user_id)
+    assert book.accessable?(user: users(:kevin))
+  end
+
+  test "rejects duplicate against existing access without notifying anyone" do
+    book = books(:manual)
+    book.accesses.load
+
+    grants = [
+      { user_id: users(:kevin).id, level: "reader" },
+      { user_id: users(:david).id, level: "editor" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, grants).import
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_not book.accessable?(user: users(:kevin))
+    assert_equal 3, book.accesses.size
+  end
+
+  test "rejects duplicate within the same roster without notifying anyone" do
+    book = books(:manual)
+    book.accesses.delete_all
+
+    grants = [
+      { user_id: users(:kevin).id, level: "reader" },
+      { user_id: users(:david).id, level: "editor" },
+      { user_id: users(:kevin).id.to_s, level: "editor" },
+      { user_id: users(:david).id, level: "reader" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, grants).import
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 2, result.duplicate_index
+    assert_equal 0, book.accesses.count
+  end
+
+  test "rejects unknown or blank level with RecordInvalid and without notifying anyone" do
+    book = books(:manual)
+    book.accesses.delete_all
+
+    [ "owner", :admin, "", nil, 123 ].each do |bad_level|
+      grants = [
+        { user_id: users(:kevin).id, level: "reader" },
+        { user_id: users(:david).id, level: bad_level },
+        { user_id: users(:jz).id, level: "editor" }
+      ]
+
+      assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+        error = assert_raises(ActiveRecord::RecordInvalid) do
+          Book::AccessImport.new(book, grants).import
+        end
+        assert_includes error.record.errors[:level], "is not included in the list"
+      end
+
+      assert_equal 0, book.accesses.count
+    end
+  end
+
+  test "rejects missing or unknown user with RecordInvalid and without notifying anyone" do
+    book = books(:manual)
+    book.accesses.delete_all
+
+    [ nil, -1, 999_999_999 ].each do |bad_user_id|
+      grants = [
+        { user_id: users(:kevin).id, level: "reader" },
+        { user_id: bad_user_id, level: "editor" }
+      ]
+
+      assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+        assert_raises ActiveRecord::RecordInvalid do
+          Book::AccessImport.new(book, grants).import
+        end
+      end
+
+      assert_equal 0, book.accesses.count
+    end
+  end
+
+  test "preserves row order precedence between invalid rows and duplicates" do
+    book = books(:manual)
+
+    invalid_then_duplicate = [
+      { user_id: users(:kevin).id, level: "unknown" },
+      { user_id: users(:david).id, level: "reader" }
+    ]
+    assert_raises ActiveRecord::RecordInvalid do
+      Book::AccessImport.new(book, invalid_then_duplicate).import
+    end
+
+    duplicate_then_invalid = [
+      { user_id: users(:david).id, level: "reader" },
+      { user_id: users(:kevin).id, level: "unknown" }
+    ]
+    result = Book::AccessImport.new(book, duplicate_then_invalid).import
+    assert_equal [], result.accesses
+    assert_equal 0, result.duplicate_index
+
+    duplicate_with_invalid_level = [
+      { user_id: users(:david).id, level: "unknown" }
+    ]
+    assert_raises ActiveRecord::RecordInvalid do
+      Book::AccessImport.new(book, duplicate_with_invalid_level).import
+    end
+  end
+
+  test "sixteen names cost the same database round trips as four when taken" do
+    book = books(:manual)
+    book.accesses.delete_all
+    book.update_columns(everyone_access: false)
+
+    four_users = create_roster_users(4, prefix: "taken4")
+    sixteen_users = create_roster_users(16, prefix: "taken16")
+
+    four_queries = capture_queries do
+      Book::AccessImport.new(book, four_users.map { { user_id: it.id, level: "reader" } }).import
+    end
+
+    book.accesses.delete_all
+
+    sixteen_queries = capture_queries do
+      Book::AccessImport.new(book, sixteen_users.map { { user_id: it.id, level: "reader" } }).import
+    end
+
+    assert_equal four_queries.size, sixteen_queries.size
+    assert_equal write_queries(four_queries).size, write_queries(sixteen_queries).size
+    assert_equal 1, write_queries(sixteen_queries).size
+  end
+
+  test "sixteen names cost the same database round trips as four when turned down" do
+    book = books(:manual)
+    book.update_columns(everyone_access: false)
+
+    four_users = create_roster_users(3, prefix: "rej4") + [ users(:david) ]
+    sixteen_users = create_roster_users(15, prefix: "rej16") + [ users(:david) ]
+
+    four_dup_queries = capture_queries do
+      result = Book::AccessImport.new(book, four_users.map { { user_id: it.id, level: "reader" } }).import
+      assert_equal 3, result.duplicate_index
+    end
+
+    sixteen_dup_queries = capture_queries do
+      result = Book::AccessImport.new(book, sixteen_users.map { { user_id: it.id, level: "reader" } }).import
+      assert_equal 15, result.duplicate_index
+    end
+
+    assert_equal four_dup_queries.size, sixteen_dup_queries.size
+    assert_empty write_queries(sixteen_dup_queries)
+
+    four_bad_grants = four_users.first(3).map { { user_id: it.id, level: "reader" } } + [ { user_id: users(:kevin).id, level: "bogus" } ]
+    sixteen_bad_grants = sixteen_users.first(15).map { { user_id: it.id, level: "reader" } } + [ { user_id: users(:kevin).id, level: "bogus" } ]
+
+    four_bad_queries = capture_queries do
+      assert_raises ActiveRecord::RecordInvalid do
+        Book::AccessImport.new(book, four_bad_grants).import
+      end
+    end
+
+    sixteen_bad_queries = capture_queries do
+      assert_raises ActiveRecord::RecordInvalid do
+        Book::AccessImport.new(book, sixteen_bad_grants).import
+      end
+    end
+
+    assert_equal four_bad_queries.size, sixteen_bad_queries.size
+    assert_empty write_queries(sixteen_bad_queries)
+  end
+
+  private
+    def create_roster_users(count, prefix:)
+      password_digest = users(:david).password_digest
+
+      count.times.map do |i|
+        User.create!(
+          name: "#{prefix}-#{i}",
+          email_address: "#{prefix}-#{i}@example.com",
+          password_digest: password_digest
+        )
+      end
+    end
+
+    def count_queries(&block)
+      capture_queries(&block).size
+    end
+
+    def capture_queries(&block)
+      ActiveRecord::Base.lease_connection.materialize_transactions
+      queries = []
+      callback = ->(*, payload) do
+        next if payload[:cached] || payload[:name] == "SCHEMA"
+        queries << payload[:sql]
+      end
+      ActiveSupport::Notifications.subscribed(callback, "sql.active_record", &block)
+      queries
+    end
+
+    def write_queries(queries)
+      queries.reject { |sql| sql.match?(/\A\s*SELECT\b/i) }
+    end
+end
