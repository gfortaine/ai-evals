diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..ad3f078
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,188 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    get search_path(q: "logo")
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "search page renders without query or with blank query" do
+    get search_path
+    assert_response :success
+    assert_select "form[action=?]", search_path
+    assert_select "input[name='q']"
+    assert_select "mark", count: 0
+
+    get search_path(q: "   ")
+    assert_response :success
+    assert_select "mark", count: 0
+  end
+
+  test "handles non-string query param gracefully" do
+    get search_path, params: { q: [ "logo" ] }
+    assert_response :success
+    assert_select "mark", count: 0
+  end
+
+  test "finds cards by title, description, or comment body newest first with matched words in mark" do
+    older_card, middle_card, newest_card = nil
+
+    with_current_user(:kevin) do
+      older_card = boards(:writebook).cards.create!(
+        title: "Older card with xylophone",
+        status: :published,
+        created_at: 3.days.ago
+      )
+      middle_card = boards(:writebook).cards.create!(
+        title: "Unrelated title",
+        description: "<p>Description mentions <strong>xylophone</strong> tuning</p>",
+        status: :published,
+        created_at: 2.days.ago
+      )
+      newest_card = boards(:writebook).cards.create!(
+        title: "Another title",
+        status: :published,
+        created_at: 1.day.ago
+      )
+      newest_card.comments.create!(body: "Comment body about xylophones", creator: users(:david))
+    end
+
+    get search_path(q: "xylophone")
+    assert_response :success
+
+    assert_select "a[href=?] mark", card_path(newest_card), text: "xylophones"
+    assert_select "a[href=?] mark", card_path(middle_card), text: "xylophone"
+    assert_select "a[href=?] mark", card_path(older_card), text: "xylophone"
+
+    body = response.body
+    assert body.index(card_path(newest_card)) < body.index(card_path(middle_card))
+    assert body.index(card_path(middle_card)) < body.index(card_path(older_card))
+  end
+
+  test "wraps multiple matched words across title, description, and comments in mark" do
+    card = nil
+    with_current_user(:kevin) do
+      card = boards(:writebook).cards.create!(
+        title: "Investigate hibiscus rendering",
+        description: "<p>Check botanical diagrams</p>",
+        status: :published
+      )
+      card.comments.create!(body: "Happens on chromium browsers", creator: users(:david))
+    end
+
+    get search_path(q: "hibiscus botanical chromium")
+    assert_response :success
+
+    assert_select "a[href=?] mark", card_path(card), text: "hibiscus"
+    assert_select "a[href=?] mark", card_path(card), text: "botanical"
+    assert_select "a[href=?] mark", card_path(card), text: "chromium"
+  end
+
+  test "shows results from private boards to users with access" do
+    private_card = nil
+    with_current_user(:kevin) do
+      private_card = boards(:private).cards.create!(
+        title: "Secret narwhal project",
+        status: :published
+      )
+    end
+
+    get search_path(q: "narwhal")
+    assert_response :success
+    assert_select "a[href=?]", card_path(private_card), count: 1
+    assert_select "mark", text: "narwhal"
+  end
+
+  test "hides results from boards the user does not currently have access to" do
+    private_card = nil
+    with_current_user(:kevin) do
+      private_card = boards(:private).cards.create!(
+        title: "Secret narwhal project",
+        description: "Narwhal migration",
+        status: :published
+      )
+      private_card.comments.create!(body: "Narwhal sightings", creator: users(:kevin))
+    end
+
+    logout_and_sign_in_as :david
+    get search_path(q: "narwhal")
+    assert_response :success
+    assert_select "a[href=?]", card_path(private_card), count: 0
+    assert_select "mark", count: 0
+  end
+
+  test "hides results immediately after board access is revoked" do
+    logout_and_sign_in_as :david
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.revoke_from(users(:david))
+
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:logo)), count: 0
+    assert_select "mark", count: 0
+  end
+
+  test "never shows draft cards or their comments" do
+    draft = boards(:writebook).cards.create!(
+      title: "Unpublished pangolin card",
+      description: "Pangolin description",
+      creator: users(:kevin),
+      status: :drafted
+    )
+    comment = Comment.new(account: draft.account, card: draft, creator: users(:kevin), body: "Pangolin comment")
+    comment.rich_text_body.account = draft.account
+    comment.save!(validate: false)
+
+    get search_path(q: "pangolin")
+    assert_response :success
+    assert_select "a[href=?]", card_path(draft), count: 0
+    assert_select "mark", count: 0
+  end
+
+  test "paginates results when exceeding page size" do
+    cards = []
+    with_current_user(:kevin) do
+      55.times do |i|
+        cards << boards(:writebook).cards.create!(
+          title: "Paginated wombat card #{i}",
+          status: :published,
+          created_at: i.minutes.ago
+        )
+      end
+    end
+
+    get search_path(q: "wombat")
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards.first), count: 1
+    assert_select "a[href=?]", card_path(cards.last), count: 0
+
+    get search_path(q: "wombat", page: 2)
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards.last), count: 1
+  end
+
+  test "escapes XSS in query and card content" do
+    xss_card = nil
+    with_current_user(:kevin) do
+      xss_card = boards(:writebook).cards.create!(
+        title: "Alert <img src=x onerror=alert(1)> quokka",
+        status: :published
+      )
+    end
+
+    get search_path(q: "quokka")
+    assert_response :success
+    assert_select "a[href=?] mark", card_path(xss_card), text: "quokka"
+    assert_select "img[onerror]", count: 0
+
+    get search_path(q: "<script>alert(1)</script>")
+    assert_response :success
+    assert_select "script", text: /alert/, count: 0
+  end
+end
diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
new file mode 100644
index 0000000..cd3c480
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "wraps matched words in mark preserving case" do
+    result = highlight_search_terms("The Logo isn't big enough", [ "logo", "big" ])
+    assert_equal "The <mark>Logo</mark> isn&#39;t <mark>big</mark> enough", result
+  end
+
+  test "wraps full matched word when query is a partial word" do
+    result = highlight_search_terms("The text is overflowing the container.", [ "overflow" ])
+    assert_equal "The text is <mark>overflowing</mark> the container.", result
+  end
+
+  test "escapes HTML in text and matched words to prevent XSS" do
+    result = highlight_search_terms("Fix <script>alert('xss')</script> bug", [ "bug", "<script>" ])
+    assert_equal "Fix <mark>&lt;script&gt;</mark>alert(&#39;xss&#39;)&lt;/script&gt; <mark>bug</mark>", result
+  end
+
+  test "does not corrupt HTML entities when searching entity names" do
+    result = highlight_search_terms("Tom & Jerry", [ "amp" ])
+    assert_equal "Tom &amp; Jerry", result
+  end
+
+  test "generates excerpt centered around matched words in long text" do
+    long_text = "Start here. " + ("filler words " * 30) + "Important haggis discovery right here. " + ("more filler " * 30) + "End."
+    card = Card.new(description: long_text)
+    excerpt = search_description_excerpt(card, [ "haggis" ])
+
+    assert_includes excerpt, "<mark>haggis</mark>"
+    assert excerpt.start_with?("…")
+    assert excerpt.end_with?("…")
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..4e2fbdb
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,156 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "finds cards by title, description, or comment body" do
+    cards(:buy_domain).update!(description: "<p>Check registrar pricing for <strong>platypus.example</strong></p>")
+    cards(:text).comments.create!(body: "What about platypus icons?", creator: users(:jz))
+    title_card = boards(:writebook).cards.create!(title: "Draw a platypus", status: :published)
+
+    results = users(:david).search("platypus").to_a
+    assert_equal [ title_card, cards(:text), cards(:buy_domain) ].to_set, results.to_set
+  end
+
+  test "orders results newest first" do
+    oldest = boards(:writebook).cards.create!(title: "Zeppelin prototype", status: :published, created_at: 5.days.ago)
+    middle = boards(:writebook).cards.create!(title: "Unrelated", description: "Zeppelin cabin", status: :published, created_at: 3.days.ago)
+    newest = boards(:writebook).cards.create!(title: "Another card", status: :published, created_at: 1.day.ago)
+    newest.comments.create!(body: "Zeppelin launch checklist", creator: users(:david))
+
+    # Touching oldest card's last_active_at should not move it ahead of newer cards
+    oldest.comments.create!(body: "Latest comment on zeppelin", creator: users(:kevin))
+
+    assert_equal [ newest, middle, oldest ], users(:david).search("zeppelin").to_a
+  end
+
+  test "deduplicates cards matching in multiple places" do
+    card = boards(:writebook).cards.create!(
+      title: "Haggis recipe",
+      description: "Traditional haggis preparation",
+      status: :published
+    )
+    card.comments.create!(body: "First haggis comment", creator: users(:david))
+    card.comments.create!(body: "Second haggis comment", creator: users(:kevin))
+
+    assert_equal [ card ], users(:david).search("haggis").to_a
+  end
+
+  test "finds closed and postponed published cards" do
+    closed_card = cards(:shipping) # closed in fixtures
+    assert closed_card.closed?
+
+    postponed_card = boards(:writebook).cards.create!(title: "Ship postponed feature", status: :published)
+    postponed_card.postpone
+
+    results = users(:david).search("ship").to_a
+    assert_includes results, closed_card
+    assert_includes results, postponed_card
+  end
+
+  test "only returns results from boards user currently has access to" do
+    private_card = boards(:private).cards.create!(
+      title: "Confidential roadmap",
+      description: "Top secret acquisition",
+      creator: users(:kevin),
+      status: :published
+    )
+    private_card.comments.create!(body: "Confidential notes", creator: users(:kevin))
+
+    # Kevin has access to boards(:private), David does not
+    assert_includes users(:kevin).search("confidential").to_a, private_card
+    assert_empty users(:david).search("confidential").to_a
+    assert_empty users(:david).search("acquisition").to_a
+
+    # Grant David access -> now he sees it
+    boards(:private).accesses.grant_to(users(:david))
+    assert_includes users(:david).reload.search("confidential").to_a, private_card
+
+    # Revoke David's access -> he no longer sees it
+    boards(:private).accesses.revoke_from(users(:david))
+    assert_empty users(:david).reload.search("confidential").to_a
+  end
+
+  test "excludes cards moved to a board the user cannot access" do
+    card = cards(:logo)
+    assert_includes users(:david).search("logo").to_a, card
+
+    card.move_to(boards(:private))
+
+    assert_empty users(:david).reload.search("logo").to_a
+    assert_includes users(:kevin).search("logo").to_a, card
+  end
+
+  test "isolates search results by account" do
+    assert_empty users(:david).search("radio").to_a
+
+    Current.account = accounts(:initech)
+    assert_equal [ cards(:radio) ], users(:mike).search("radio").to_a
+  end
+
+  test "draft cards and their comments never turn up" do
+    draft = boards(:writebook).cards.create!(
+      title: "Drafted flamingo title",
+      description: "Drafted flamingo description",
+      creator: users(:david),
+      status: :drafted
+    )
+    draft_comment = Comment.new(account: draft.account, card: draft, creator: users(:david), body: "Drafted flamingo comment")
+    draft_comment.rich_text_body.account = draft.account
+    draft_comment.save!(validate: false)
+
+    assert_empty users(:david).search("flamingo").to_a
+    assert_empty users(:kevin).search("flamingo").to_a
+
+    # Publishing the draft makes it searchable
+    draft.publish
+    assert_equal [ draft ], users(:david).search("flamingo").to_a
+  end
+
+  test "ignores HTML tag names in rich text descriptions and comments" do
+    card = boards(:writebook).cards.create!(
+      title: "Plain heading",
+      description: "<div class=\"custom-wrapper\"><strong>Bold statement</strong></div>",
+      status: :published
+    )
+    card.comments.create!(body: "<p><a href=\"https://hiddenurl.example.com\">Visible link</a></p>", creator: users(:david))
+
+    assert_empty users(:david).search("strong").to_a
+    assert_empty users(:david).search("custom-wrapper").to_a
+    assert_empty users(:david).search("hiddenurl").to_a
+    assert_includes users(:david).search("statement").to_a, card
+    assert_includes users(:david).search("Visible").to_a, card
+  end
+
+  test "does not match old title via system title-change audit comment" do
+    card = boards(:writebook).cards.create!(title: "Temporary caterpillar title", status: :published)
+    card.update!(title: "Permanent butterfly title")
+
+    assert_empty users(:david).search("caterpillar").to_a
+    assert_equal [ card ], users(:david).search("butterfly").to_a
+  end
+
+  test "supports multi-word queries across fields and handles special characters safely" do
+    card = boards(:writebook).cards.create!(
+      title: "100% CPU spike",
+      description: "Happens in [production] & staging",
+      status: :published
+    )
+    card.comments.create!(body: "Triggered by Café import", creator: users(:david))
+
+    assert_equal [ card ], users(:david).search("100%").to_a
+    assert_equal [ card ], users(:david).search("[production] cafÉ").to_a
+    assert_empty users(:david).search("100% nonexistent").to_a
+
+    # SQL wildcards do not match arbitrary text
+    assert_empty users(:david).search("%%%").to_a
+    assert_empty users(:david).search("___").to_a
+
+    # Blank queries return none
+    assert_empty users(:david).search("").to_a
+    assert_empty users(:david).search("   ").to_a
+    assert_empty users(:david).search(nil).to_a
+  end
+end
