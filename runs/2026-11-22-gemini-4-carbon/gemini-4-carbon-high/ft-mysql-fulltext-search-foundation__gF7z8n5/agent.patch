+<div id="<%= dom_id(card, :search_result) %>" class="search__result" data-navigable-list-target="item">
+  <%= link_to card_path(card),
+        id: dom_id(card),
+        class: [ "card card--search", { "golden-effect": card.golden?, "card--postponed": card.postponed?, "card--closed": card.closed? } ],
+        style: "--card-color: #{card.color};",
+        data: { turbo_frame: "_top" } do %>
+    <header class="card__header">
+      <div class="card__board">
+        <span class="card__id">
+          <span class="for-screen-reader">Card number</span>
+          <%= card.number %>
+        </span>
+        <span class="card__board-name">
+          <span class="overflow-ellipsis"><%= card.board.name %></span>
+        </span>
+      </div>
+
+      <div class="card__search-meta txt-xx-small translucent flex-item-justify-end">
+        <%= local_datetime_tag(card.created_at, style: :timeordate) %>
+      </div>
+    </header>
+
+    <div class="card__search-body flex flex-column gap-half txt-align-start">
+      <h3 class="card__title">
+        <%= highlight_search_terms(card.title, terms) %>
+      </h3>
+
+      <% if description_excerpt = search_description_excerpt(card, terms) %>
+        <p class="card__search-excerpt margin-none">
+          <%= description_excerpt %>
+        </p>
+      <% end %>
+
+      <% search_comment_excerpts(card, terms).each do |comment, excerpt| %>
+        <div class="card__search-comment">
+          <strong class="card__search-comment-author"><%= comment.creator.familiar_name %>:</strong>
+          <span class="card__search-excerpt"><%= excerpt %></span>
+        </div>
+      <% end %>
+    </div>
+  <% end %>
+</div>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..a3149ca
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,41 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search center">
+  <%= form_with url: search_path, method: :get, class: "search__form flex align-center gap-half center" do |form| %>
+    <%= form.label :q, "Search", class: "for-screen-reader" %>
+    <%= form.search_field :q,
+          value: @search.query,
+          placeholder: "Find cards by title, description, or comment…",
+          autofocus: @search.query.blank?,
+          autocorrect: "off",
+          autocomplete: "off",
+          class: "input search__input",
+          data: { "1p-ignore": "true" } %>
+    <button type="submit" class="btn btn--link search__submit">
+      <%= icon_tag "search" %>
+      <span class="for-screen-reader">Search</span>
+    </button>
+  <% end %>
+
+  <% if @search.valid? %>
+    <% if @page.records.any? %>
+      <div class="search__results flex flex-column gap-half center margin-block-start" data-controller="navigable-list" data-action="keydown@document->navigable-list#navigate" data-navigable-list-actionable-items-value="true" data-navigable-list-focus-on-selection-value="false">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { terms: @search.terms } %>
+        <% end %>
+      </div>
+    <% else %>
+      <div class="blank-slate margin-block-start-double">
+        No cards match “<%= @search.query %>”
+      </div>
+    <% end %>
+  <% end %>
+</section>
