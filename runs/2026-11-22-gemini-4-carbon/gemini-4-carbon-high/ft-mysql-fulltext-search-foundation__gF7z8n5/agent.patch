diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..ebb9926
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,96 @@
+module SearchesHelper
+  EXCERPT_RADIUS = 80
+
+  def highlight_search_terms(text, terms)
+    return "" if text.blank?
+
+    normalized = text.to_s.unicode_normalize(:nfc)
+    pattern = Search.word_pattern_for(terms)
+    return ERB::Util.html_escape(normalized) unless pattern
+
+    result = ActiveSupport::SafeBuffer.new
+    last_end = 0
+
+    normalized.scan(pattern) do
+      match = Regexp.last_match
+      result << ERB::Util.html_escape(normalized[last_end...match.begin(0)])
+      result << tag.mark(match[0])
+      last_end = match.end(0)
+    end
+
+    result << ERB::Util.html_escape(normalized[last_end..])
+    result
+  end
+
+  def search_description_excerpt(card, terms)
+    search_excerpt(card.rich_text_description&.to_plain_text, terms)
+  end
+
+  def search_comment_excerpts(card, terms)
+    user_comments = card.comments.reject { |comment| comment.creator.system? }
+    sorted_comments = user_comments.sort_by { |comment| [ comment.created_at, comment.id ] }.reverse
+
+    sorted_comments.filter_map do |comment|
+      if excerpt = search_excerpt(comment.rich_text_body&.to_plain_text, terms)
+        [ comment, excerpt ]
+      end
+    end
+  end
+
+  private
+    def search_excerpt(plain_text, terms)
+      normalized = plain_text.to_s.unicode_normalize(:nfc).squish
+      pattern = Search.word_pattern_for(terms)
+      return nil if normalized.blank? || pattern.nil? || !normalized.match?(pattern)
+      return highlight_search_terms(normalized, terms) if normalized.length <= EXCERPT_RADIUS * 3
+
+      windows = excerpt_windows_for(normalized, terms)
+      render_excerpt_windows(normalized, windows, terms)
+    end
+
+    def excerpt_windows_for(normalized, terms)
+      raw_windows = terms.filter_map do |term|
+        if match = normalized.match(Search.word_pattern_for([ term ]))
+          snap_window_to_words(normalized, match.begin(0), match.end(0))
+        end
+      end.sort_by(&:first)
+
+      raw_windows.each_with_object([]) do |(w_start, w_end), merged|
+        if merged.any? && w_start <= merged.last[1] + 10
+          merged.last[1] = [ merged.last[1], w_end ].max
+        else
+          merged << [ w_start, w_end ]
+        end
+      end
+    end
+
+    def snap_window_to_words(text, match_start, match_end)
+      w_start = [ 0, match_start - EXCERPT_RADIUS ].max
+      w_end = [ text.length, match_end + EXCERPT_RADIUS ].min
+
+      if w_start > 0 && text[w_start - 1] != " "
+        space_idx = text.index(" ", w_start)
+        w_start = space_idx + 1 if space_idx && space_idx < match_start
+      end
+
+      if w_end < text.length && text[w_end] != " "
+        space_idx = text.rindex(" ", w_end)
+        w_end = space_idx if space_idx && space_idx >= match_end
+      end
+
+      [ w_start, w_end ]
+    end
+
+    def render_excerpt_windows(text, windows, terms)
+      result = ActiveSupport::SafeBuffer.new
+      result << "…" if windows.first[0] > 0
+
+      windows.each_with_index do |(w_start, w_end), index|
+        result << " … " if index > 0
+        result << highlight_search_terms(text[w_start...w_end], terms)
+      end
+
+      result << "…" if windows.last[1] < text.length
+      result
+    end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..2fe8bef
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,141 @@
+class Search
+  attr_reader :query, :user
+
+  class << self
+    def terms_for(query)
+      query.to_s.unicode_normalize(:nfc).strip.split(/[[:space:]]+/).reject(&:blank?).uniq(&:downcase)
+    end
+
+    def word_pattern_for(terms)
+      fragments = Array(terms).reject(&:blank?).sort_by { |term| -term.length }.map { |term| term_regex_fragment(term) }
+      /(?:#{fragments.join("|")})/i if fragments.any?
+    end
+
+    private
+      def term_regex_fragment(term)
+        escaped = Regexp.escape(term)
+        prefix = term.match?(/\A[\p{Word}]/) ? '[\p{Word}]*' : ""
+        suffix = term.match?(/[\p{Word}]\z/) ? '[\p{Word}]*' : ""
+        "#{prefix}#{escaped}#{suffix}"
+      end
+  end
+
+  def initialize(query, user: Current.user)
+    @query = query.to_s.strip
+    @user = user
+  end
+
+  def valid?
+    user.present? && terms.any?
+  end
+
+  def results
+    if valid?
+      matching_cards
+        .reverse_chronologically
+        .preload(:board, :column, :closure, :goldness, :not_now, comments: [ :creator, { rich_text_body: { embeds_attachments: :blob } } ])
+        .with_rich_text_description_and_embeds
+    else
+      Card.none
+    end
+  end
+
+  def terms
+    @terms ||= self.class.terms_for(query)
+  end
+
+  private
+    def matching_cards
+      scope = candidate_cards
+      excluded_ids = false_positive_card_ids(scope)
+
+      if excluded_ids.any?
+        scope.where.not(id: excluded_ids)
+      else
+        scope
+      end
+    end
+
+    def candidate_cards
+      terms.reduce(published_accessible_cards) do |scope, term|
+        scope.merge(cards_matching_term(term))
+      end
+    end
+
+    def published_accessible_cards
+      user.accessible_cards.published
+    end
+
+    def cards_matching_term(term)
+      Card.where(title_matches(term))
+        .or(Card.where(id: description_card_ids_matching(term)))
+        .or(Card.where(id: comment_card_ids_matching(term)))
+    end
+
+    def title_matches(term)
+      like_any(Card.arel_table[:title], case_variants(term))
+    end
+
+    def description_card_ids_matching(term)
+      ActionText::RichText
+        .where(account_id: user.account_id, record_type: "Card", name: "description")
+        .where(like_any(ActionText::RichText.arel_table[:body], html_variants(term)))
+        .select(:record_id)
+    end
+
+    def comment_card_ids_matching(term)
+      Comment.by_user
+        .where(account_id: user.account_id)
+        .joins(:rich_text_body)
+        .where(like_any(ActionText::RichText.arel_table[:body], html_variants(term)))
+        .select(:card_id)
+    end
+
+    def like_any(column, variants)
+      variants.map { |variant| column.matches("%#{ActiveRecord::Base.sanitize_sql_like(variant)}%", "\\") }.reduce(:or)
+    end
+
+    def case_variants(term)
+      if term.ascii_only?
+        [ term ]
+      else
+        [ term, term.downcase, term.upcase, term.capitalize ].uniq
+      end
+    end
+
+    def html_variants(term)
+      case_variants(term).flat_map do |variant|
+        [ variant, CGI.escapeHTML(variant), variant.gsub("'", "&apos;") ]
+      end.uniq
+    end
+
+    def false_positive_card_ids(scope)
+      candidates = scope.includes(:rich_text_description, comments: [ :creator, :rich_text_body ])
+
+      candidates.filter_map do |card|
+        card.id unless card_matches_all_terms?(card)
+      end
+    end
+
+    def card_matches_all_terms?(card)
+      terms.all? { |term| card_matches_term?(card, term.downcase) }
+    end
+
+    def card_matches_term?(card, downcased_term)
+      text_matches?(card.title, downcased_term) ||
+        text_matches?(plain_text_for(card.rich_text_description), downcased_term) ||
+        user_comments_for(card).any? { |comment| text_matches?(plain_text_for(comment.rich_text_body), downcased_term) }
+    end
+
+    def text_matches?(text, downcased_term)
+      text.present? && text.unicode_normalize(:nfc).downcase.include?(downcased_term)
+    end
+
+    def plain_text_for(rich_text)
+      rich_text&.to_plain_text
+    end
+
+    def user_comments_for(card)
+      card.comments.reject { |comment| comment.creator.system? }
+    end
+end
