diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..f869548 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,10 +2,28 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    thread_mattr_accessor :publication_checks, instance_accessor: false
+
+    after_save :track_publication_change, if: :saved_change_to_published?
   end
 
   private
+    def track_publication_change
+      Book.publication_checks&.delete(id)
+      was_published = !previously_new_record? && published_before_last_save
+
+      Book.current_transaction.after_commit do
+        checks = (Book.publication_checks ||= Set.new)
+        if checks.add?(id)
+          begin
+            announce_publication if !was_published && Book.published.exists?(id)
+          ensure
+            checks.add(id)
+          end
+        end
+      end
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
     end
