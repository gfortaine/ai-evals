diff --git a/test/integration/priority_and_inbox_filters_test.rb b/test/integration/priority_and_inbox_filters_test.rb
new file mode 100644
index 0000000..42d596a
--- /dev/null
+++ b/test/integration/priority_and_inbox_filters_test.rb
@@ -0,0 +1,627 @@
+require "test_helper"
+
+class PriorityAndInboxFiltersTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def extract_token(mail)
+    uri = URI.parse(mail.body.decoded[%r{https?://[^\s"<>]+}])
+    URI.decode_www_form(uri.query).to_h.fetch("token")
+  end
+
+  def setup_business!(subdomain: "acme", name: "Acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: { name: admin_name, email: email, password: password }
+        }
+      },
+      as: :json
+    assert_response :created
+    owner = json_body.fetch("user")
+    token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+    ActionMailer::Base.deliveries.clear
+    owner
+  end
+
+  def invite_and_accept_staff!(subdomain:, owner_headers:, email:, name:, role: "agent", password: "staff-password")
+    post "/api/v1/invitations",
+      params: { invitation: { email: email, role: role } },
+      headers: owner_headers,
+      as: :json
+    assert_response :created
+    token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: token, name: name, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    json_body.fetch("user")
+  end
+
+  def register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    post "/api/v1/registrations",
+      params: { user: { name: name, email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+    user = json_body.fetch("user")
+    ActionMailer::Base.deliveries.clear
+    user
+  end
+
+  def sign_in!(subdomain:, email:, password:)
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    json_body.dig("session", "token")
+  end
+
+  def auth_headers(subdomain, token)
+    {
+      "X-Helpdesk-Account" => subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+
+  test "ticket priority defaults to normal, is editable by staff, and stays completely internal to staff" do
+    setup_business!(subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    owner_headers = auth_headers("acme", owner_token)
+
+    sam = invite_and_accept_staff!(
+      subdomain: "acme",
+      owner_headers: owner_headers,
+      email: "sam@acme.test",
+      name: "Sam",
+      role: "agent"
+    )
+    sam_token = sign_in!(subdomain: "acme", email: "sam@acme.test", password: "staff-password")
+    sam_headers = auth_headers("acme", sam_token)
+
+    avery = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")
+    avery_headers = auth_headers("acme", avery_token)
+
+    # Customer tries to create a high-priority request; priority is ignored on creation and omitted from customer JSON
+    post "/api/v1/requests",
+      params: { request: { subject: "First issue", priority: "high", comment: { body: "Need help" } } },
+      headers: avery_headers,
+      as: :json
+    assert_response :created
+    req1_initial = json_body.fetch("request")
+    req1_id = req1_initial.fetch("id")
+    assert_not req1_initial.key?("priority")
+
+    req2_id = nil
+    travel 1.minute do
+      post "/api/v1/requests",
+        params: { request: { subject: "Second issue", comment: { body: "Another question" } } },
+        headers: avery_headers,
+        as: :json
+      assert_response :created
+      req2_id = json_body.dig("request", "id")
+    end
+
+    # Staff sees default normal priority in GET /tickets and GET /tickets/:id
+    get "/api/v1/tickets/#{req1_id}", headers: sam_headers
+    assert_response :ok
+    t1_initial = json_body.fetch("ticket")
+    assert_equal "normal", t1_initial["priority"]
+
+    get "/api/v1/tickets", headers: owner_headers
+    assert_response :ok
+    assert_equal %w[normal normal], json_body.fetch("tickets").map { |t| t["priority"] }
+
+    # Passing unchanged priority ("normal") does not bump staff updated_at
+    travel 3.minutes do
+      patch "/api/v1/tickets/#{req1_id}",
+        params: { ticket: { priority: "normal" } },
+        headers: sam_headers,
+        as: :json
+      assert_response :ok
+      assert_equal t1_initial["updated_at"], json_body.dig("ticket", "updated_at")
+    end
+
+    # Staff marks ticket 1 as high priority at T+5m -> bumps staff updated_at, leaves customer request unchanged
+    travel 5.minutes do
+      patch "/api/v1/tickets/#{req1_id}",
+        params: { ticket: { priority: "high" } },
+        headers: sam_headers,
+        as: :json
+      assert_response :ok
+      assert_equal "high", json_body.dig("ticket", "priority")
+      assert_not_equal t1_initial["updated_at"], json_body.dig("ticket", "updated_at")
+
+      get "/api/v1/tickets", headers: owner_headers
+      assert_response :ok
+      assert_equal [req1_id, req2_id], json_body.fetch("tickets").map { |t| t["id"] }
+      assert_equal %w[high normal], json_body.fetch("tickets").map { |t| t["priority"] }
+    end
+
+    # Customer view and ordering are completely unchanged by internal priority updates
+    travel 6.minutes do
+      get "/api/v1/requests/#{req1_id}", headers: avery_headers
+      assert_response :ok
+      assert_equal req1_initial, json_body.fetch("request")
+      assert_not json_body.fetch("request").key?("priority")
+
+      get "/api/v1/requests", headers: avery_headers
+      assert_response :ok
+      assert_equal [req2_id, req1_id], json_body.fetch("requests").map { |r| r["id"] }
+      json_body.fetch("requests").each do |req|
+        assert_not req.key?("priority")
+      end
+
+      # Customer cannot access staff ticket endpoints
+      get "/api/v1/tickets", params: { priority: "high" }, headers: avery_headers
+      assert_response :forbidden
+
+      patch "/api/v1/tickets/#{req1_id}",
+        params: { ticket: { priority: "normal" } },
+        headers: avery_headers,
+        as: :json
+      assert_response :forbidden
+
+      # Customer cannot update priority alone or reset priority during a customer reply
+      patch "/api/v1/requests/#{req1_id}",
+        params: { request: { priority: "normal" } },
+        headers: avery_headers,
+        as: :json
+      assert_response :unprocessable_content
+
+      patch "/api/v1/requests/#{req1_id}",
+        params: { request: { priority: "normal", comment: { body: "Following up" } } },
+        headers: avery_headers,
+        as: :json
+      assert_response :ok
+      assert_not json_body.fetch("request").key?("priority")
+
+      get "/api/v1/tickets/#{req1_id}", headers: owner_headers
+      assert_response :ok
+      assert_equal "high", json_body.dig("ticket", "priority")
+    end
+
+    # Staff can set priority back to normal alongside status/assignee/comment, and invalid priority rolls back atomically
+    assert_no_difference -> { Comment.count } do
+      patch "/api/v1/tickets/#{req1_id}",
+        params: { ticket: { priority: "urgent", status: "pending", comment: { body: "Should not save" } } },
+        headers: owner_headers,
+        as: :json
+      assert_response :unprocessable_content
+
+      [nil, "", "low", "HIGH", " high ", 123, true, ["high"], { level: "high" }].each do |bad_priority|
+        patch "/api/v1/tickets/#{req1_id}",
+          params: { ticket: { priority: bad_priority } },
+          headers: owner_headers,
+          as: :json
+        assert_response :unprocessable_content
+      end
+
+      # Empty ticket object still requires comment, status, assignee, or priority
+      patch "/api/v1/tickets/#{req1_id}",
+        params: { ticket: {} },
+        headers: owner_headers,
+        as: :json
+      assert_response :unprocessable_content
+
+      # Invalid comment rolls back valid priority update
+      patch "/api/v1/tickets/#{req1_id}",
+        params: { ticket: { priority: "normal", comment: { body: "   " } } },
+        headers: owner_headers,
+        as: :json
+      assert_response :unprocessable_content
+    end
+    assert_equal "high", Ticket.find(req1_id).priority
+    assert_equal "open", Ticket.find(req1_id).status
+
+    put "/api/v1/tickets/#{req1_id}",
+      params: { ticket: { priority: "normal", assignee_id: sam["id"], status: "pending" } },
+      headers: owner_headers,
+      as: :json
+    assert_response :ok
+    assert_equal "normal", json_body.dig("ticket", "priority")
+    assert_equal sam["id"], json_body.dig("ticket", "assignee_id")
+    assert_equal "pending", json_body.dig("ticket", "status")
+  end
+
+  test "staff combined ticket filters, literal case-insensitive search, pagination, and suspension interaction" do
+    owner = setup_business!(subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    setup_business!(subdomain: "globex", name: "Globex", admin_name: "Gus", email: "gus@globex.test")
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    owner_headers = auth_headers("acme", owner_token)
+    globex_owner_token = sign_in!(subdomain: "globex", email: "gus@globex.test", password: "my-first-password")
+    globex_owner_headers = auth_headers("globex", globex_owner_token)
+
+    sam = invite_and_accept_staff!(
+      subdomain: "acme",
+      owner_headers: owner_headers,
+      email: "sam@acme.test",
+      name: "Sam",
+      role: "agent"
+    )
+    sam_token = sign_in!(subdomain: "acme", email: "sam@acme.test", password: "staff-password")
+    sam_headers = auth_headers("acme", sam_token)
+
+    avery = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    blake = register_and_verify_customer!(subdomain: "acme", name: "Blake", email: "blake@example.test")
+    globex_cust = register_and_verify_customer!(subdomain: "globex", name: "Cory", email: "cory@example.test")
+
+    avery_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password"))
+    blake_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "blake@example.test", password: "my-customer-password"))
