+
+    # Literal text search: %, _, \, regex metacharacters, FTS operators, Unicode, and NUL bytes
+    get "/api/v1/tickets", params: { q: "100%" }, headers: sam_headers
+    assert_response :ok
+    assert_equal [t1_id], json_body.fetch("tickets").map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { q: "order_42" }, headers: sam_headers
+    assert_response :ok
+    assert_equal [t1_id], json_body.fetch("tickets").map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { q: "[a-z] (foo|bar)" }, headers: sam_headers
+    assert_response :ok
+    assert_equal [t1_id], json_body.fetch("tickets").map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { q: 'C:\temp\file.*test' }, headers: sam_headers
+    assert_response :ok
+    assert_equal [t4_id], json_body.fetch("tickets").map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { q: '\\' }, headers: sam_headers
+    assert_response :ok
+    assert_equal [t4_id], json_body.fetch("tickets").map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { q: "CAFÉ" }, headers: sam_headers
+    assert_response :ok
