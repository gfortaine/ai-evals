+require "test_helper"
+require "rake"
+
+class HelpdeskApiTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @orig_frontend_url = ENV["HELPDESK_FRONTEND_URL"]
+    @orig_mail_from = ENV["HELPDESK_MAIL_FROM"]
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  teardown do
+    if @orig_frontend_url
+      ENV["HELPDESK_FRONTEND_URL"] = @orig_frontend_url
+    else
+      ENV.delete("HELPDESK_FRONTEND_URL")
+    end
+
+    if @orig_mail_from
+      ENV["HELPDESK_MAIL_FROM"] = @orig_mail_from
+    else
+      ENV.delete("HELPDESK_MAIL_FROM")
+    end
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def signup_business(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: {
+            name: admin_name,
+            email: email,
+            password: password
+          }
+        }
+      },
+      as: :json
+  end
+
+  def extract_link_params(mail, expected_path)
+    body = mail.body.decoded
+    match = body.match(%r{(https?://[^\s"<>]+)})
+    assert match, "Expected URL in email body, got: #{body.inspect}"
+    uri = URI.parse(match[1])
+    assert_equal expected_path, uri.path
+    [uri, URI.decode_www_form(uri.query).to_h]
+  end
+
+  def register_and_verify!(subdomain: "acme", name: "Acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    signup_business(name: name, subdomain: subdomain, admin_name: admin_name, email: email, password: password)
+    assert_response :created
+    mail = ActionMailer::Base.deliveries.last
+    _uri, query = extract_link_params(mail, "/verify-email")
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: query.fetch("token") } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+    json_body["user"]
+  end
+
+  def sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    json_body
+  end
+
+  test "business signup returns account and unverified admin user, sends verification email, blocks sign in until verified" do
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      signup_business
+    end
+    assert_response :created
+
+    body = json_body
+    account = body.fetch("account")
+    user = body.fetch("user")
+
+    assert_kind_of Integer, account["id"]
+    assert_equal "Acme", account["name"]
+    assert_equal "acme", account["subdomain"]
+    assert_equal user["id"], account["owner_id"]
+    assert_nil account["cancelled_at"]
+    assert account["created_at"].present?
+    assert account["updated_at"].present?
+
+    assert_kind_of Integer, user["id"]
+    assert_equal account["id"], user["account_id"]
+    assert_equal "Jo", user["name"]
+    assert_equal "jo@acme.test", user["email"]
+    assert_equal "admin", user["role"]
+    assert_equal false, user["verified"]
+    assert user["created_at"].present?
+    assert user["updated_at"].present?
+    assert_not user.key?("password")
+    assert_not user.key?("password_digest")
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal ["support@example.test"], mail.from
+    assert_equal ["jo@acme.test"], mail.to
+    uri, query = extract_link_params(mail, "/verify-email")
+    assert_equal "http://localhost:3001", "#{uri.scheme}://#{uri.host}:#{uri.port}"
+    assert_equal "acme", query["account"]
+    assert query["token"].present?
+
+    # Cannot sign in before verifying email
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :forbidden
+
+    # Confirm email verification
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: query["token"] } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "verified")
+
+    # Token is single-use
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: query["token"] } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_content
+
+    # Now sign in succeeds
+    login_data = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    assert login_data.dig("session", "token").present?
+    assert_equal user["id"], login_data.dig("user", "id")
+    assert_equal true, login_data.dig("user", "verified")
+    assert_equal account["id"], login_data.dig("account", "id")
+  end
+
+  test "signup validation errors roll back transaction and send no email" do
+    assert_no_difference [-> { Account.count }, -> { User.count }, -> { ActionMailer::Base.deliveries.size }] do
+      signup_business(subdomain: "acme", email: "not-an-email")
+    end
+    assert_response :unprocessable_content
+
+    # Subdomain is still available after rollback
+    signup_business(subdomain: "acme", email: "jo@acme.test")
+    assert_response :created
+
+    # Duplicate subdomain fails
+    assert_no_difference [-> { Account.count }, -> { User.count }] do
+      signup_business(subdomain: "ACME", email: "other@acme.test")
+    end
+    assert_response :unprocessable_content
+
+    # Invalid subdomain format fails
+    signup_business(subdomain: "bad subdomain!", email: "jo@bad.test")
+    assert_response :unprocessable_content
+  end
+
+  test "custom HELPDESK_FRONTEND_URL and HELPDESK_MAIL_FROM are used in emails" do
+    ENV["HELPDESK_FRONTEND_URL"] = "https://app.helpdesk.example/"
+    ENV["HELPDESK_MAIL_FROM"] = "noreply@helpdesk.example"
+
+    signup_business(subdomain: "acme")
+    assert_response :created
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal ["noreply@helpdesk.example"], mail.from
+    uri, query = extract_link_params(mail, "/verify-email")
+    assert_equal "https://app.helpdesk.example", "#{uri.scheme}://#{uri.host}"
+    assert_equal "acme", query["account"]
+    assert query["token"].present?
+  end
+
+  test "portal is public while GET /account requires authentication, scoped by X-Helpdesk-Account" do
+    register_and_verify!(subdomain: "acme", name: "Acme")
+
+    # Missing X-Helpdesk-Account header
+    get "/api/v1/portal"
+    assert_response :bad_request
+
+    # Unknown account
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "nonexistent" }
+    assert_response :not_found
+
+    # Public portal returns only name and subdomain inside portal
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :ok
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, json_body)
+
+    # GET /account requires auth
+    get "/api/v1/account", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :unauthorized
+
+    token = sign_in!(subdomain: "acme").dig("session", "token")
+    get "/api/v1/account", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{token}"
+    }
+    assert_response :ok
+    account_json = json_body.fetch("account")
+    assert_equal "Acme", account_json["name"]
+    assert_equal "acme", account_json["subdomain"]
+    assert account_json["id"].present?
+    assert account_json["created_at"].present?
+  end
+
+  test "multi-tenancy: same email can belong to different businesses with complete isolation" do
+    register_and_verify!(subdomain: "acme", name: "Acme", admin_name: "Jo Acme", email: "jo@shared.test", password: "acme-password")
+    signup_business(subdomain: "globex", name: "Globex", admin_name: "Jo Globex", email: "jo@shared.test", password: "globex-password")
+    assert_response :created
+    globex_verify_mail = ActionMailer::Base.deliveries.last
+    _uri, globex_query = extract_link_params(globex_verify_mail, "/verify-email")
+
+    # Cannot verify globex token under acme
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: globex_query["token"] } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_content
+
+    # Jo on globex is still unverified and cannot sign in
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@shared.test", password: "globex-password" } },
+      headers: { "X-Helpdesk-Account" => "globex" },
+      as: :json
+    assert_response :forbidden
+
+    # Verify globex
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: globex_query["token"] } },
+      headers: { "X-Helpdesk-Account" => "globex" },
+      as: :json
+    assert_response :ok
+
+    acme_token = sign_in!(subdomain: "acme", email: "jo@shared.test", password: "acme-password").dig("session", "token")
+    globex_token = sign_in!(subdomain: "globex", email: "jo@shared.test", password: "globex-password").dig("session", "token")
+
+    # Cross-account token usage is rejected
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "globex", "Authorization" => "Bearer #{acme_token}" }
+    assert_response :unauthorized
+
+    delete "/api/v1/session", headers: { "X-Helpdesk-Account" => "globex", "Authorization" => "Bearer #{acme_token}" }
+    assert_response :unauthorized
+
+    # Acme session still works on acme
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{acme_token}" }
+    assert_response :ok
+    assert_equal "Jo Acme", json_body.dig("user", "name")
+
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "globex", "Authorization" => "Bearer #{globex_token}" }
+    assert_response :ok
+    assert_equal "Jo Globex", json_body.dig("user", "name")
+  end
+
+  test "requesting a new email verification link replaces the old one" do
+    signup_business(subdomain: "acme", email: "jo@acme.test")
+    assert_response :created
+    first_mail = ActionMailer::Base.deliveries.last
+    _uri, first_query = extract_link_params(first_mail, "/verify-email")
+
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      post "/api/v1/email_verifications",
+        params: { email_verification: { email: "jo@acme.test" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+    end
+    assert_response :ok
+
+    second_mail = ActionMailer::Base.deliveries.last
+    _uri, second_query = extract_link_params(second_mail, "/verify-email")
+    assert_not_equal first_query["token"], second_query["token"]
+
+    # First token no longer works
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: first_query["token"] } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_content
+
+    # Second token works
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: second_query["token"] } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "verified")
+  end
+
+  test "profile view, name update, sign out, and password change revoking existing sessions" do
+    register_and_verify!(subdomain: "acme")
+    token_1 = sign_in!(subdomain: "acme").dig("session", "token")
+    token_2 = sign_in!(subdomain: "acme").dig("session", "token")
+    headers_1 = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token_1}" }
+    headers_2 = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token_2}" }
+
+    # GET /me
+    get "/api/v1/me", headers: headers_1
+    assert_response :ok
+    assert_equal "Jo", json_body.dig("user", "name")
+
+    # PATCH /me updates name and ignores unpermitted fields
+    patch "/api/v1/me",
+      params: { user: { name: "Jo Smith", role: "customer", verified: false } },
+      headers: headers_1,
+      as: :json
+    assert_response :ok
+    assert_equal "Jo Smith", json_body.dig("user", "name")
+    assert_equal "admin", json_body.dig("user", "role")
+    assert_equal true, json_body.dig("user", "verified")
+
+    # Blank name fails validation
+    patch "/api/v1/me", params: { user: { name: "   " } }, headers: headers_1, as: :json
+    assert_response :unprocessable_content
+
+    # DELETE /session signs out only token_1
+    delete "/api/v1/session", headers: headers_1
+    assert_response :no_content
+
+    get "/api/v1/me", headers: headers_1
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: headers_2
+    assert_response :ok
+
+    # Create another session token_3 so user has two active sessions (token_2 and token_3)
+    token_3 = sign_in!(subdomain: "acme").dig("session", "token")
+    headers_3 = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token_3}" }
+
+    # Wrong current_password fails and keeps sessions active
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "wrong-password", password: "my-new-password" } },
+      headers: headers_2,
+      as: :json
+    assert_response :unprocessable_content
+
+    get "/api/v1/me", headers: headers_2
+    assert_response :ok
+
+    # Valid password change signs out ALL existing sessions
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+      headers: headers_2,
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: headers_2
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: headers_3
+    assert_response :unauthorized
+
+    # Old password no longer signs in
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unauthorized
+
+    # New password signs in
+    sign_in!(subdomain: "acme", password: "my-new-password")
+  end
+
+  test "password reset link replacement, confirmation, and session revocation" do
+    register_and_verify!(subdomain: "acme")
+    active_token = sign_in!(subdomain: "acme").dig("session", "token")
+    ActionMailer::Base.deliveries.clear
+
+    # Request first reset link
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    first_mail = ActionMailer::Base.deliveries.last
+    assert_equal ["support@example.test"], first_mail.from
+    uri_1, query_1 = extract_link_params(first_mail, "/reset-password")
+    assert_equal "http://localhost:3001", "#{uri_1.scheme}://#{uri_1.host}:#{uri_1.port}"
+    assert_equal "acme", query_1["account"]
+
+    # Request second reset link - replaces first
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    assert_equal 2, ActionMailer::Base.deliveries.size
+    _uri_2, query_2 = extract_link_params(ActionMailer::Base.deliveries.last, "/reset-password")
+    assert_not_equal query_1["token"], query_2["token"]
+
+    # Old reset token fails
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: query_1["token"], password: "my-new-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_content
+
+    # Invalid password does not consume valid token
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: query_2["token"], password: "" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_content
+
+    # Valid confirmation updates password and revokes existing sessions
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: query_2["token"], password: "my-new-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+
+    # Token cannot be reused
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: query_2["token"], password: "another-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_content
+
+    # Existing session was revoked
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{active_token}" }
+    assert_response :unauthorized
+
+    # Can sign in with new password
+    sign_in!(subdomain: "acme", password: "my-new-password")
+  end
+
+  test "CORS allows configured frontend origin and rejects other origins" do
+    options "/api/v1/account/create", headers: {
+      "Origin" => "http://localhost:3001",
+      "Access-Control-Request-Method" => "POST",
+      "Access-Control-Request-Headers" => "Content-Type, X-Helpdesk-Account, Authorization"
+    }
+    assert_response :ok
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+
+    options "/api/v1/account/create", headers: {
+      "Origin" => "http://evil.example",
+      "Access-Control-Request-Method" => "POST"
+    }
+    assert_nil response.headers["Access-Control-Allow-Origin"]
+
+    ENV["HELPDESK_FRONTEND_URL"] = "https://desk.acme.test:8443/app"
+    options "/api/v1/sessions", headers: {
+      "Origin" => "https://desk.acme.test:8443",
+      "Access-Control-Request-Method" => "POST"
+    }
+    assert_response :ok
+    assert_equal "https://desk.acme.test:8443", response.headers["Access-Control-Allow-Origin"]
+
+    options "/api/v1/sessions", headers: {
+      "Origin" => "http://localhost:3001",
+      "Access-Control-Request-Method" => "POST"
+    }
+    assert_nil response.headers["Access-Control-Allow-Origin"]
+  end
+
+  test "account cancellation, non-owner restrictions, reactivation within 90 days, and purge after 90 days" do
+    register_and_verify!(subdomain: "acme")
+    acme = Account.find_by!(subdomain: "acme")
+    second_admin = acme.users.create!(
+      name: "Sam",
+      email: "sam@acme.test",
+      password: "sam-password",
+      role: "admin",
+      verified: true,
+      email_verified_at: Time.current
+    )
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    sam_token = sign_in!(subdomain: "acme", email: "sam@acme.test", password: "sam-password").dig("session", "token")
+
+    # Non-owner cannot cancel the account
+    post "/api/v1/account/cancel", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{sam_token}"
+    }
+    assert_response :forbidden
+
+    # Owner cancels the account
+    post "/api/v1/account/cancel", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{owner_token}"
+    }
+    assert_response :ok
+    assert json_body.dig("account", "cancelled_at").present?
+
+    # Existing sessions for both owner and Sam are revoked
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" }
+    assert_response :unauthorized
+
+    # Ordinary business access is stopped (public portal, password reset, non-owner login)
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :forbidden
+
+    post "/api/v1/sessions",
+      params: { session: { email: "sam@acme.test", password: "sam-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :forbidden
+
+    # Owner can still sign in while cancelled within 90 days
+    travel 89.days do
+      owner_recovery_login = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+      recovery_token = owner_recovery_login.dig("session", "token")
+      assert owner_recovery_login.dig("account", "cancelled_at").present?
+
+      # Ordinary endpoints remain blocked until reactivated
+      get "/api/v1/account", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{recovery_token}" }
+      assert_response :forbidden
+
+      get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{recovery_token}" }
+      assert_response :forbidden
+
+      # Purge task does NOT delete accounts cancelled < 90 days ago
+      Account.purge_cancelled!
+      assert Account.exists?(acme.id)
+
+      # Owner reactivates the account
+      post "/api/v1/account/reactivate", headers: {
+        "X-Helpdesk-Account" => "acme",
+        "Authorization" => "Bearer #{recovery_token}"
+      }
+      assert_response :ok
+      assert_nil json_body.dig("account", "cancelled_at")
+
+      # Ordinary business access works again
+      get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+      assert_response :ok
+
+      get "/api/v1/account", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{recovery_token}" }
+      assert_response :ok
+
+      get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{recovery_token}" }
+      assert_response :ok
+
+      sign_in!(subdomain: "acme", email: "sam@acme.test", password: "sam-password")
+    end
+
+    # Cancel again and test expiration + rake task purge after 90 days
+    register_and_verify!(subdomain: "keepme", name: "KeepMe", email: "jo@keepme.test")
+    keepme = Account.find_by!(subdomain: "keepme")
+
+    fresh_owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    post "/api/v1/account/cancel", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{fresh_owner_token}"
+    }
+    assert_response :ok
+
+    # Create tokens on acme to verify all child records are purged too
+    second_admin.issue_password_reset_token!
+    second_admin.issue_email_verification_token!
+
+    Rails.application.load_tasks if Rake::Task.tasks.empty?
+
+    travel 90.days + 1.second do
+      # Past 90 days: owner cannot sign in to reactivate anymore
+      post "/api/v1/sessions",
+        params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+      assert_response :forbidden
+
+      Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+      Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+
+      assert_not Account.exists?(acme.id)
+      assert_equal 0, User.where(account_id: acme.id).count
+      assert_equal 0, Session.where(account_id: acme.id).count
+      assert_equal 0, EmailVerificationToken.where(account_id: acme.id).count
+      assert_equal 0, PasswordResetToken.where(account_id: acme.id).count
+
+      # Active account is untouched
+      assert Account.exists?(keepme.id)
+      assert_equal 1, User.where(account_id: keepme.id).count
+    end
+  end
+end
