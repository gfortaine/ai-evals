+      { page: { size: "" } },
+      { page: { size: "abc" } },
+      { page: { size: "1_2" } },
+      { page: { size: ["10"] } },
+      { page: { unknown_key: 10 } },
+      { page: { after: user_cursor } },
+      { page: { after: t0_comment_cursor } }
+    ].each do |bad_params|
+      get "/api/v1/tickets", params: bad_params, headers: acme_owner_headers
+      assert_response :unprocessable_content, "Expected 422 for #{bad_params.inspect}, got #{response.status}"
+    end
+
+    # Cross-account replay: acme cursor sent to globex
+    get "/api/v1/tickets", params: { page: { after: ticket_cursor, size: 1 } }, headers: globex_owner_headers
+    assert_response :unprocessable_content
+
+    # Cross-ticket comment cursor replay & staff-to-customer comment cursor replay
+    get "/api/v1/tickets/#{t_ids[1]}/comments", params: { page: { after: t0_comment_cursor } }, headers: acme_owner_headers
+    assert_response :unprocessable_content
+
+    get "/api/v1/requests/#{t_ids[0]}/comments", params: { page: { after: t0_comment_cursor } }, headers: avery_headers
+    assert_response :unprocessable_content
+
+    # Tickets cursor cannot be used on customer /requests
+    get "/api/v1/requests", params: { page: { after: ticket_cursor } }, headers: avery_headers
+    assert_response :unprocessable_content
+
+    # Large page[size] clamps cleanly to MAX_PER_PAGE without 500
+    get "/api/v1/tickets", params: { page: { size: 5000 } }, headers: acme_owner_headers
+    assert_response :ok
+    assert_equal 2, json_body.fetch("tickets").size
+  end
+
+  test "cursor pagination avoids COUNT(*) and OFFSET and uses B-tree index scans deep into long histories" do
+    setup_business!(subdomain: "acme")
+    owner_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password"))
+    avery = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    acme = Account.find_by!(subdomain: "acme")
+
+    base = Time.utc(2026, 1, 1, 0, 0, 0)
+    rows = Array.new(2500) do |i|
+      ts = base + i.seconds
+      {
+        account_id: acme.id,
+        requester_id: avery["id"],
+        subject: "History ticket #{i + 1}",
+        status: (i % 5 == 0) ? "solved" : "open",
+        priority: "normal",
+        reply_token: SecureRandom.hex(16),
+        email_origin: false,
+        created_at: ts,
+        updated_at: ts,
+        customer_updated_at: ts
+      }
+    end
+    Ticket.insert_all!(rows)
+
+    # First cursor page: zero COUNT(*), zero OFFSET
+    first_queries = capture_sql_queries do
+      get "/api/v1/tickets?page[size]=25&status=open", headers: owner_headers
+      assert_response :ok
+    end
+    assert_equal 25, json_body.fetch("tickets").size
+    assert_equal true, json_body.dig("meta", "has_more")
+    assert_none_count = first_queries.none? { |sql| /COUNT\s*\(/i.match?(sql) }
+    assert_none_offset = first_queries.none? { |sql| /\bOFFSET\b/i.match?(sql) }
+    assert assert_none_count, "Expected no COUNT(*) query in cursor pagination, got: #{first_queries.inspect}"
+    assert assert_none_offset, "Expected no OFFSET clause in cursor pagination, got: #{first_queries.inspect}"
+
+    # Jump deep into the history (near record #2000) using a cursor and verify SQL & EXPLAIN plan
+    deep_ticket = acme.tickets.where(status: "open").recently_active.offset(1800).first
+    # Get page starting around deep_ticket by encoding via a 1-item fetch or walking
+    conn = ActiveRecord::Base.connection
+    explain_sql = acme.tickets
+      .where(status: "open")
+      .where("(\"tickets\".\"updated_at\", \"tickets\".\"id\") < (?, ?)", deep_ticket.updated_at, deep_ticket.id)
+      .recently_active
+      .limit(26)
+      .to_sql
+    plan_lines = conn.select_values("EXPLAIN #{explain_sql}").join("\n")
+    assert_includes plan_lines, "Index Scan"
+    assert_not_includes plan_lines, "Seq Scan"
+    assert_not_includes plan_lines, "Sort"
+
+    # Walk 10 pages via links.next and verify zero COUNT(*) / OFFSET on subsequent pages too
+    next_url = json_body.dig("links", "next")
+    10.times do
+      subsequent_queries = capture_sql_queries do
+        get next_url, headers: owner_headers
+        assert_response :ok
+      end
+      assert subsequent_queries.none? { |sql| /COUNT\s*\(/i.match?(sql) }
+      assert subsequent_queries.none? { |sql| /\bOFFSET\b/i.match?(sql) }
+      assert_equal 25, json_body.fetch("tickets").size
+      next_url = json_body.dig("links", "next")
+    end
+  end
+end
