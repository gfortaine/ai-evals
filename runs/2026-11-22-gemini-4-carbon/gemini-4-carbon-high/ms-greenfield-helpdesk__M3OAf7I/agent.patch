+require "test_helper"
+
+class CursorPaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @orig_env = %w[
+      HELPDESK_FRONTEND_URL
+      HELPDESK_MAIL_FROM
+      HELPDESK_SUPPORT_DOMAIN
+      RAILS_INBOUND_EMAIL_PASSWORD
+    ].index_with { |k| ENV[k] }
+
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+    ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+  end
+
+  teardown do
+    @orig_env.each do |k, v|
+      v.nil? ? ENV.delete(k) : ENV[k] = v
+    end
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def extract_token(mail)
+    uri = URI.parse(mail.body.decoded[%r{https?://[^\s"<>]+}])
+    URI.decode_www_form(uri.query).to_h.fetch("token")
+  end
+
+  def auth_headers(subdomain, token)
+    {
+      "X-Helpdesk-Account" => subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+
+  def setup_business!(subdomain: "acme", name: "Acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: { name: admin_name, email: email, password: password }
+        }
+      },
+      as: :json
+    assert_response :created
+    verify_token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: verify_token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+    ActionMailer::Base.deliveries.clear
+    json_body.fetch("user")
+  end
+
+  def register_and_verify_customer!(subdomain:, name:, email:, password: "my-customer-password")
+    post "/api/v1/registrations",
+      params: { user: { name: name, email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    verify_token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: verify_token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+    ActionMailer::Base.deliveries.clear
+    json_body.fetch("user")
+  end
+
+  def invite_and_accept_staff!(subdomain:, owner_headers:, email:, name:, role: "agent", password: "staff-password")
+    post "/api/v1/invitations",
+      params: { invitation: { email: email, role: role } },
+      headers: owner_headers,
+      as: :json
+    assert_response :created
+    invite_token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: invite_token, name: name, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    json_body.fetch("user")
+  end
+
+  def sign_in!(subdomain:, email:, password:)
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    json_body.dig("session", "token")
+  end
+
+  def capture_sql_queries
+    queries = []
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |_name, _start, _finish, _id, payload|
+      next if payload[:name] == "SCHEMA" || payload[:cached]
+      queries << payload[:sql]
+    end
+    yield
+    queries
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+  end
+
+  test "empty cursor-paginated response shape and page-number coexistence" do
+    setup_business!(subdomain: "acme")
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    owner_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password"))
+    avery_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password"))
+
+    # Exact empty cursor response shape from specification
+    get "/api/v1/tickets?page[size]=25&status=open", headers: owner_headers
+    assert_response :ok
+    assert_equal({
+      "tickets" => [],
+      "meta" => {
+        "has_more" => false,
+        "after_cursor" => nil,
+        "before_cursor" => nil
+      },
+      "links" => {
+        "next" => nil,
+        "prev" => nil
+      }
+    }, json_body)
+
+    # Legacy page-number API remains completely intact
+    get "/api/v1/tickets?status=open", headers: owner_headers
+    assert_response :ok
+    assert_equal({
+      "tickets" => [],
+      "count" => 0,
+      "page" => 1,
+      "per_page" => 25,
+      "next_page" => nil,
+      "previous_page" => nil
+    }, json_body)
+
+    # Empty cursor responses on requests, groups, group_memberships, invitations, and filtered users
+    get "/api/v1/requests?page[size]=10", headers: avery_headers
+    assert_response :ok
+    assert_equal({
+      "requests" => [],
+      "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+      "links" => { "next" => nil, "prev" => nil }
+    }, json_body)
+
+    get "/api/v1/groups?page[size]=10", headers: owner_headers
+    assert_response :ok
+    assert_equal({
+      "groups" => [],
+      "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+      "links" => { "next" => nil, "prev" => nil }
+    }, json_body)
+
+    get "/api/v1/group_memberships?page[size]=10", headers: owner_headers
+    assert_response :ok
+    assert_equal({
+      "group_memberships" => [],
+      "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+      "links" => { "next" => nil, "prev" => nil }
+    }, json_body)
+
+    get "/api/v1/invitations?page[size]=10", headers: owner_headers
+    assert_response :ok
+    assert_equal({
+      "invitations" => [],
+      "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+      "links" => { "next" => nil, "prev" => nil }
+    }, json_body)
+
+    get "/api/v1/users?page[size]=10&suspended=true", headers: owner_headers
+    assert_response :ok
+    assert_equal({
+      "users" => [],
+      "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+      "links" => { "next" => nil, "prev" => nil }
+    }, json_body)
+  end
+
+  test "forward and backward cursor navigation via links and explicit page[after]/page[before] across all 9 collections" do
+    owner = setup_business!(subdomain: "acme")
+    owner_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password"))
+
+    sam = invite_and_accept_staff!(subdomain: "acme", owner_headers: owner_headers, email: "sam@acme.test", name: "Sam", role: "agent")
+    alex = invite_and_accept_staff!(subdomain: "acme", owner_headers: owner_headers, email: "alex@acme.test", name: "Alex", role: "agent")
+    avery = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password"))
+
+    # Add two more pending invitations so invitations has 4 total (2 accepted + 2 pending)
+    post "/api/v1/invitations", params: { invitation: { email: "pat@acme.test", role: "agent" } }, headers: owner_headers, as: :json
+    assert_response :created
+    post "/api/v1/invitations", params: { invitation: { email: "taylor@acme.test", role: "admin" } }, headers: owner_headers, as: :json
+    assert_response :created
+
+    # Create 4 groups and 4 group memberships
+    group_ids = %w[Billing Support Security Onboarding].map do |gname|
+      post "/api/v1/groups", params: { group: { name: gname } }, headers: owner_headers, as: :json
+      assert_response :created
+      json_body.dig("group", "id")
+    end
+
+    membership_ids = [
+      [group_ids[0], sam["id"]],
+      [group_ids[1], sam["id"]],
+      [group_ids[2], alex["id"]],
+      [group_ids[3], owner["id"]]
+    ].map do |gid, uid|
+      post "/api/v1/group_memberships",
+        params: { group_membership: { group_id: gid, user_id: uid } },
+        headers: owner_headers,
+        as: :json
+      assert_response :created
+      json_body.dig("group_membership", "id")
+    end
+
+    # Create 5 tickets, including two at the exact same timestamp to verify tie-breaking on id!
+    base_time = Time.utc(2026, 11, 20, 10, 0, 0, 123_456)
+    ticket_ids = []
+    [0, 10, 20, 20, 30].each_with_index do |offset_sec, idx|
+      travel_to(base_time + offset_sec.seconds) do
+        post "/api/v1/requests",
+          params: { request: { subject: "Order receipt #{idx + 1}", comment: { body: "Customer msg #{idx + 1}" } } },
+          headers: avery_headers,
+          as: :json
+        assert_response :created
+        ticket_ids << json_body.dig("request", "id")
+      end
+    end
+    expected_desc_ticket_ids = ticket_ids.reverse
+
+    # Add public and private comments on ticket_ids.first so ticket_comments has 5 and request_comments has 4
+    first_ticket_id = ticket_ids.first
+    [1, 2, 2, 3].each_with_index do |sec, idx|
+      travel_to(base_time + (100 + sec).seconds) do
+        is_pub = (idx != 1)
+        patch "/api/v1/tickets/#{first_ticket_id}",
+          params: { ticket: { comment: { body: "Reply #{idx + 1}", public: is_pub } } },
+          headers: owner_headers,
+          as: :json
+        assert_response :ok
+      end
+    end
+
+    # Re-read canonical ticket & request orders after ticket_ids.first was updated
+    get "/api/v1/tickets?per_page=50", headers: owner_headers
+    expected_tickets_order = json_body.fetch("tickets").map { |t| t["id"] }
+    assert_equal 5, expected_tickets_order.size
+
+    get "/api/v1/requests?per_page=50", headers: avery_headers
+    expected_requests_order = json_body.fetch("requests").map { |r| r["id"] }
+    assert_equal 5, expected_requests_order.size
+
+    # Helper to verify full forward + backward link traversal AND manual cursor params for any collection
+    verify_collection = lambda do |path:, headers:, key:, expected_ids:, page_size:, extra_query: ""|
+      sep = extra_query.empty? ? "?" : "?#{extra_query}&"
+
+      # 1. Forward traversal via links["next"]
+      collected_forward = []
+      pages_forward = []
+      url = "#{path}#{sep}page[size]=#{page_size}"
+
+      loop do
+        get url, headers: headers
+        assert_response :ok
+        assert_equal [key, "meta", "links"].sort, json_body.keys.sort
+
+        items = json_body.fetch(key)
+        meta = json_body.fetch("meta")
+        links = json_body.fetch("links")
+
+        assert items.any?, "Expected non-empty page for #{url}"
+        assert_not_nil meta["before_cursor"]
+        assert_not_nil meta["after_cursor"]
+        if items.size == 1
+          assert_equal meta["before_cursor"], meta["after_cursor"]
+        else
+          assert_not_equal meta["before_cursor"], meta["after_cursor"]
+        end
+
+        if pages_forward.empty?
+          assert_nil links["prev"], "First page must have prev=null for #{path}"
+        else
+          assert_not_nil links["prev"], "Subsequent page must have prev link for #{path}"
+        end
+
+        pages_forward << { ids: items.map { |i| i["id"] }, meta: meta, links: links }
+        collected_forward.concat(items.map { |i| i["id"] })
+
+        if meta["has_more"]
+          assert_not_nil links["next"]
+          url = links["next"]
+        else
+          assert_nil links["next"]
+          break
+        end
+      end
+
+      assert_equal expected_ids, collected_forward, "Forward cursor order mismatch on #{path}"
+
+      # 2. Backward traversal from the last page via links["prev"]
+      if pages_forward.size > 1
+        backward_pages = [pages_forward.last[:ids]]
+        prev_url = pages_forward.last[:links]["prev"]
+
+        while prev_url
+          get prev_url, headers: headers
+          assert_response :ok
+          items = json_body.fetch(key)
+          meta = json_body.fetch("meta")
+          links = json_body.fetch("links")
+
+          assert_not_nil meta["before_cursor"]
+          assert_not_nil meta["after_cursor"]
+          assert_not_nil links["next"], "Backward page must have next link to return forward on #{path}"
+
+          backward_pages.unshift(items.map { |i| i["id"] })
+
+          if meta["has_more"]
+            assert_not_nil links["prev"]
+            prev_url = links["prev"]
+          else
+            assert_nil links["prev"]
+            prev_url = nil
+          end
+        end
+
+        assert_equal expected_ids, backward_pages.flatten, "Backward cursor order mismatch on #{path}"
+      end
+
+      # 3. Manual page[after] with a DIFFERENT page[size]
+      first_cursor = pages_forward.first[:meta]["after_cursor"]
+      get "#{path}#{sep}page[after]=#{first_cursor}&page[size]=1", headers: headers
+      assert_response :ok
+      assert_equal [expected_ids[page_size]], json_body.fetch(key).map { |i| i["id"] }
+
+      # 4. Manual page[before] from the very last item's before_cursor with default page[size] (omitting page[size])
+      last_page_first_cursor = pages_forward.last[:meta]["before_cursor"]
+      last_page_start_idx = expected_ids.index(pages_forward.last[:ids].first)
+      get "#{path}#{sep}page[before]=#{last_page_first_cursor}", headers: headers
+      assert_response :ok
+      assert_equal expected_ids.first(last_page_start_idx), json_body.fetch(key).map { |i| i["id"] }
+      assert_equal false, json_body.dig("meta", "has_more")
+    end
+
+    # Test all 9 collections!
+    verify_collection.call(
+      path: "/api/v1/tickets",
+      headers: owner_headers,
+      key: "tickets",
+      expected_ids: expected_tickets_order,
+      page_size: 2,
+      extra_query: "status=open&q=Order+receipt"
+    )
+    verify_collection.call(
+      path: "/api/v1/requests",
+      headers: avery_headers,
+      key: "requests",
+      expected_ids: expected_requests_order,
+      page_size: 2,
+      extra_query: "status=open"
+    )
+
+    get "/api/v1/tickets/#{first_ticket_id}/comments?per_page=50", headers: owner_headers
+    expected_ticket_comment_ids = json_body.fetch("comments").map { |c| c["id"] }
+    assert_equal 5, expected_ticket_comment_ids.size
+    verify_collection.call(
+      path: "/api/v1/tickets/#{first_ticket_id}/comments",
+      headers: owner_headers,
+      key: "comments",
+      expected_ids: expected_ticket_comment_ids,
+      page_size: 2
+    )
+
+    get "/api/v1/requests/#{first_ticket_id}/comments?per_page=50", headers: avery_headers
+    expected_req_comment_ids = json_body.fetch("comments").map { |c| c["id"] }
+    assert_equal 4, expected_req_comment_ids.size
+    verify_collection.call(
+      path: "/api/v1/requests/#{first_ticket_id}/comments",
+      headers: avery_headers,
+      key: "comments",
+      expected_ids: expected_req_comment_ids,
+      page_size: 2
+    )
+
+    verify_collection.call(
+      path: "/api/v1/users",
+      headers: owner_headers,
+      key: "users",
+      expected_ids: [owner["id"], sam["id"], alex["id"], avery["id"]],
+      page_size: 2
+    )
+    verify_collection.call(
+      path: "/api/v1/staff",
+      headers: owner_headers,
+      key: "staff",
+      expected_ids: [owner["id"], sam["id"], alex["id"]],
+      page_size: 2
+    )
+    verify_collection.call(
+      path: "/api/v1/groups",
+      headers: owner_headers,
+      key: "groups",
+      expected_ids: group_ids,
+      page_size: 2
+    )
+    verify_collection.call(
+      path: "/api/v1/group_memberships",
+      headers: owner_headers,
+      key: "group_memberships",
+      expected_ids: membership_ids,
+      page_size: 2
+    )
+
+    get "/api/v1/invitations?per_page=50", headers: owner_headers
+    expected_invitation_ids = json_body.fetch("invitations").map { |i| i["id"] }
+    assert_equal 4, expected_invitation_ids.size
+    verify_collection.call(
+      path: "/api/v1/invitations",
+      headers: owner_headers,
+      key: "invitations",
+      expected_ids: expected_invitation_ids,
+      page_size: 2
+    )
+  end
+
+  test "navigation remains stable while other people create, reply, solve, add private notes, or delete records" do
+    setup_business!(subdomain: "acme")
+    owner_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password"))
+    sam = invite_and_accept_staff!(subdomain: "acme", owner_headers: owner_headers, email: "sam@acme.test", name: "Sam", role: "agent")
+    sam_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "sam@acme.test", password: "staff-password"))
+    avery = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password"))
+
+    # Create 6 open tickets T1..T6 at t+1m..t+6m (so canonical order is [T6, T5, T4, T3, T2, T1])
+    base = Time.utc(2026, 11, 20, 12, 0, 0)
+    t_ids = (1..6).map do |i|
+      travel_to(base + i.minutes) do
+        post "/api/v1/requests",
+          params: { request: { subject: "Ticket #{i}", comment: { body: "Body #{i}" } } },
+          headers: avery_headers,
+          as: :json
+        assert_response :created
+        json_body.dig("request", "id")
+      end
+    end
+    t1, t2, t3, t4, t5, t6 = t_ids
+
+    # Jo loads Page 1 of open tickets (size 2): gets [T6, T5]
+    get "/api/v1/tickets?page[size]=2&status=open", headers: owner_headers
+    assert_response :ok
+    assert_equal [t6, t5], json_body.fetch("tickets").map { |t| t["id"] }
+    page1_next = json_body.dig("links", "next")
+    page1_before_cursor = json_body.dig("meta", "before_cursor")
+
+    # Avery also loads Page 1 of her open requests (size 2): gets [T6, T5]
+    get "/api/v1/requests?page[size]=2&status=open", headers: avery_headers
+    assert_response :ok
+    assert_equal [t6, t5], json_body.fetch("requests").map { |r| r["id"] }
+    avery_next = json_body.dig("links", "next")
+
+    # Meanwhile, while Jo and Avery are reading Page 1, other people work:
+    travel_to(base + 10.minutes) do
+      # 1. Avery opens a brand new ticket T7 (inserts at the very top!)
+      post "/api/v1/requests",
+        params: { request: { subject: "New Ticket 7", comment: { body: "Urgent" } } },
+        headers: avery_headers,
+        as: :json
+      assert_response :created
+      @t7 = json_body.dig("request", "id")
+
+      # 2. Sam solves T6 (removes an already-seen item from status=open!)
+      patch "/api/v1/tickets/#{t6}",
+        params: { ticket: { status: "solved" } },
+        headers: sam_headers,
+        as: :json
+      assert_response :ok
+
+      # 3. Sam replies publicly to T5 (the exact boundary anchor record of Page 1's after_cursor!), bumping T5 to NOW!
+      patch "/api/v1/tickets/#{t5}",
+        params: { ticket: { comment: { body: "Working on T5 now", public: true } } },
+        headers: sam_headers,
+        as: :json
+      assert_response :ok
+
+      # 4. Sam adds a PRIVATE internal note to T3 (bumps staff updated_at on T3, NOT customer_updated_at!)
+      patch "/api/v1/tickets/#{t3}",
+        params: { ticket: { comment: { body: "Internal triage note on T3", public: false } } },
+        headers: sam_headers,
+        as: :json
+      assert_response :ok
+    end
+
+    # Jo follows page1_next: neither T7 nor bumped T5 nor bumped T3 causes T4 to be skipped or Page 1 to repeat!
+    # Open tickets older than Page 1's snapshot cursor (t5's original timestamp) are [T4, T2, T1] (since T3 moved above T5's old timestamp)
+    get page1_next, headers: owner_headers
+    assert_response :ok
+    assert_equal [t4, t2], json_body.fetch("tickets").map { |t| t["id"] }
+    assert_equal true, json_body.dig("meta", "has_more")
+
+    get json_body.dig("links", "next"), headers: owner_headers
+    assert_response :ok
+    assert_equal [t1], json_body.fetch("tickets").map { |t| t["id"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+    assert_nil json_body.dig("links", "next")
+
+    # Avery follows avery_next: because Sam's note on T3 was PRIVATE, T3 did NOT move in customer requests!
+    # Avery gets [T4, T3] then [T2, T1] with zero skips and zero duplicates!
+    get avery_next, headers: avery_headers
+    assert_response :ok
+    assert_equal [t4, t3], json_body.fetch("requests").map { |r| r["id"] }
+    assert_equal true, json_body.dig("meta", "has_more")
+
+    get json_body.dig("links", "next"), headers: avery_headers
+    assert_response :ok
+    assert_equal [t2, t1], json_body.fetch("requests").map { |r| r["id"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+
+    # Jo can also poll page[before] using Page 1's before_cursor to see tickets updated since Page 1 was loaded!
+    get "/api/v1/tickets", params: { status: "open", page: { size: 10, before: page1_before_cursor } }, headers: owner_headers
+    assert_response :ok
+    assert_equal [@t7, t5, t3], json_body.fetch("tickets").map { |t| t["id"] }
+
+    # Deleting the boundary record on /api/v1/groups mid-browse keeps navigation working cleanly
+    g_ids = (1..4).map do |i|
+      post "/api/v1/groups", params: { group: { name: "Team #{i}" } }, headers: owner_headers, as: :json
+      assert_response :created
+      json_body.dig("group", "id")
+    end
+
+    get "/api/v1/groups?page[size]=2", headers: owner_headers
+    assert_response :ok
+    assert_equal [g_ids[0], g_ids[1]], json_body.fetch("groups").map { |g| g["id"] }
+    groups_next = json_body.dig("links", "next")
+
+    # Another admin deletes g_ids[1] (the anchor record of groups_next!)
+    delete "/api/v1/groups/#{g_ids[1]}", headers: owner_headers
+    assert_response :no_content
+
+    get groups_next, headers: owner_headers
+    assert_response :ok
+    assert_equal [g_ids[2], g_ids[3]], json_body.fetch("groups").map { |g| g["id"] }
+    assert_equal false, json_body.dig("meta", "has_more")
+  end
+
+  test "rejects malformed, tampered, conflicting, cross-collection, and cross-account cursors with 422" do
+    setup_business!(subdomain: "acme")
+    setup_business!(subdomain: "globex", name: "Globex", admin_name: "Max", email: "max@globex.test")
+
+    acme_owner_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password"))
+    globex_owner_headers = auth_headers("globex", sign_in!(subdomain: "globex", email: "max@globex.test", password: "my-first-password"))
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password"))
+
+    t_ids = 2.times.map do |i|
+      post "/api/v1/requests",
+        params: { request: { subject: "Subj #{i}", comment: { body: "Msg #{i}" } } },
+        headers: avery_headers,
+        as: :json
+      assert_response :created
+      json_body.dig("request", "id")
+    end
+
+    get "/api/v1/tickets?page[size]=1", headers: acme_owner_headers
+    assert_response :ok
+    ticket_cursor = json_body.dig("meta", "after_cursor")
+    ticket_before = json_body.dig("meta", "before_cursor")
+
+    get "/api/v1/users?page[size]=1", headers: acme_owner_headers
+    assert_response :ok
+    user_cursor = json_body.dig("meta", "after_cursor")
+
+    get "/api/v1/tickets/#{t_ids[0]}/comments?page[size]=1", headers: acme_owner_headers
+    assert_response :ok
+    t0_comment_cursor = json_body.dig("meta", "after_cursor")
+
+    # Tampered signature byte
+    tampered_char = (ticket_cursor[5] == "A") ? "B" : "A"
+    tampered_cursor = ticket_cursor.dup
+    tampered_cursor[5] = tampered_char
+
+    [
+      { page: { after: "" } },
+      { page: { after: "   " } },
+      { page: { after: "not-a-valid-cursor!!!" } },
+      { page: { after: "short" } },
+      { page: { after: Base64.urlsafe_encode64('{"a":1,"p":"/api/v1/tickets","k":[1,1]}', padding: false) } },
+      { page: { after: tampered_cursor } },
+      { page: { before: tampered_cursor } },
+      { page: { after: ["array"] } },
+      { page: { before: { nested: "hash" } } },
+      { page: { after: ticket_cursor, before: ticket_before } },
+      { page: { size: 0 } },
+      { page: { size: -5 } },
+      { page: { size: "" } },
+      { page: { size: "abc" } },
+      { page: { size: "1_2" } },
+      { page: { size: ["10"] } },
+      { page: { unknown_key: 10 } },
+      { page: { after: user_cursor } },
+      { page: { after: t0_comment_cursor } }
+    ].each do |bad_params|
+      get "/api/v1/tickets", params: bad_params, headers: acme_owner_headers
+      assert_response :unprocessable_content, "Expected 422 for #{bad_params.inspect}, got #{response.status}"
+    end
+
+    # Cross-account replay: acme cursor sent to globex
+    get "/api/v1/tickets", params: { page: { after: ticket_cursor, size: 1 } }, headers: globex_owner_headers
+    assert_response :unprocessable_content
+
+    # Cross-ticket comment cursor replay & staff-to-customer comment cursor replay
+    get "/api/v1/tickets/#{t_ids[1]}/comments", params: { page: { after: t0_comment_cursor } }, headers: acme_owner_headers
+    assert_response :unprocessable_content
+
+    get "/api/v1/requests/#{t_ids[0]}/comments", params: { page: { after: t0_comment_cursor } }, headers: avery_headers
+    assert_response :unprocessable_content
+
+    # Tickets cursor cannot be used on customer /requests
+    get "/api/v1/requests", params: { page: { after: ticket_cursor } }, headers: avery_headers
+    assert_response :unprocessable_content
+
+    # Large page[size] clamps cleanly to MAX_PER_PAGE without 500
+    get "/api/v1/tickets", params: { page: { size: 5000 } }, headers: acme_owner_headers
+    assert_response :ok
+    assert_equal 2, json_body.fetch("tickets").size
+  end
+
+  test "cursor pagination avoids COUNT(*) and OFFSET and uses B-tree index scans deep into long histories" do
+    setup_business!(subdomain: "acme")
+    owner_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password"))
+    avery = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    acme = Account.find_by!(subdomain: "acme")
+
+    base = Time.utc(2026, 1, 1, 0, 0, 0)
+    rows = Array.new(2500) do |i|
+      ts = base + i.seconds
+      {
+        account_id: acme.id,
+        requester_id: avery["id"],
+        subject: "History ticket #{i + 1}",
+        status: (i % 5 == 0) ? "solved" : "open",
+        priority: "normal",
+        reply_token: SecureRandom.hex(16),
+        email_origin: false,
+        created_at: ts,
+        updated_at: ts,
+        customer_updated_at: ts
+      }
+    end
+    Ticket.insert_all!(rows)
+
+    # First cursor page: zero COUNT(*), zero OFFSET
+    first_queries = capture_sql_queries do
+      get "/api/v1/tickets?page[size]=25&status=open", headers: owner_headers
+      assert_response :ok
+    end
+    assert_equal 25, json_body.fetch("tickets").size
+    assert_equal true, json_body.dig("meta", "has_more")
+    assert_none_count = first_queries.none? { |sql| /COUNT\s*\(/i.match?(sql) }
+    assert_none_offset = first_queries.none? { |sql| /\bOFFSET\b/i.match?(sql) }
+    assert assert_none_count, "Expected no COUNT(*) query in cursor pagination, got: #{first_queries.inspect}"
+    assert assert_none_offset, "Expected no OFFSET clause in cursor pagination, got: #{first_queries.inspect}"
+
+    # Jump deep into the history (near record #2000) using a cursor and verify SQL & EXPLAIN plan
+    deep_ticket = acme.tickets.where(status: "open").recently_active.offset(1800).first
+    # Get page starting around deep_ticket by encoding via a 1-item fetch or walking
+    conn = ActiveRecord::Base.connection
+    explain_sql = acme.tickets
+      .where(status: "open")
+      .where("(\"tickets\".\"updated_at\", \"tickets\".\"id\") < (?, ?)", deep_ticket.updated_at, deep_ticket.id)
+      .recently_active
+      .limit(26)
+      .to_sql
+    plan_lines = conn.select_values("EXPLAIN #{explain_sql}").join("\n")
+    assert_includes plan_lines, "Index Scan"
+    assert_not_includes plan_lines, "Seq Scan"
+    assert_not_includes plan_lines, "Sort"
+
+    # Walk 10 pages via links.next and verify zero COUNT(*) / OFFSET on subsequent pages too
+    next_url = json_body.dig("links", "next")
+    10.times do
+      subsequent_queries = capture_sql_queries do
+        get next_url, headers: owner_headers
+        assert_response :ok
+      end
+      assert subsequent_queries.none? { |sql| /COUNT\s*\(/i.match?(sql) }
+      assert subsequent_queries.none? { |sql| /\bOFFSET\b/i.match?(sql) }
+      assert_equal 25, json_body.fetch("tickets").size
+      next_url = json_body.dig("links", "next")
+    end
+  end
+end
diff --git a/test/integration/edge_cases_test.rb b/test/integration/edge_cases_test.rb
new file mode 100644
index 0000000..aab0b8a
--- /dev/null
+++ b/test/integration/edge_cases_test.rb
@@ -0,0 +1,207 @@
+require "test_helper"
+
+class EdgeCasesTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def extract_token(mail)
+    uri = URI.parse(mail.body.decoded[%r{https?://[^\s"<>]+}])
+    URI.decode_www_form(uri.query).to_h.fetch("token")
+  end
+
+  test "expired verification and password reset tokens are rejected" do
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Acme",
+          subdomain: "acme",
+          admin: { name: "Jo", email: "jo@acme.test", password: "my-first-password" }
+        }
+      },
+      as: :json
+    assert_response :created
+    verify_token = extract_token(ActionMailer::Base.deliveries.last)
+
+    travel 49.hours do
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: verify_token } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+      assert_response :unprocessable_content
+    end
+
+    # Request a fresh verification link and confirm within TTL
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "jo@acme.test" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    fresh_verify_token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: fresh_verify_token } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+
+    # Request password reset and let it expire
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    reset_token = extract_token(ActionMailer::Base.deliveries.last)
+
+    travel 25.hours do
+      post "/api/v1/password_resets/confirm",
+        params: { password_reset: { token: reset_token, password: "my-new-password" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+      assert_response :unprocessable_content
+    end
+  end
+
+  test "malformed JSON and wrong parameter types never return 500" do
+    post "/api/v1/account/create",
+      params: "{bad json",
+      headers: { "Content-Type" => "application/json" }
+    assert_response :bad_request
+
+    post "/api/v1/account/create", params: {}, as: :json
+    assert_response :bad_request
+
+    post "/api/v1/account/create", params: { account: "not-an-object" }, as: :json
+    assert_response :bad_request
+
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: ["array"],
+          subdomain: { nested: "hash" },
+          admin: "not-an-object"
+        }
+      },
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Acmé Café",
+          subdomain: "acme",
+          admin: { name: "Jörg", email: "jo@acme.test", password: "my-first-password" }
+        }
+      },
+      as: :json
+    assert_response :created
+    verify_token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: verify_token } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: ["bad"] },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :bad_request
+
+    post "/api/v1/sessions",
+      params: { session: { email: ["bad"], password: { bad: 1 } } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unauthorized
+
+    post "/api/v1/sessions",
+      params: { session: { email: "JO@ACME.TEST", password: "my-first-password" } },
+      headers: { "X-Helpdesk-Account" => "ACME" },
+      as: :json
+    assert_response :created
+    token = json_body.dig("session", "token")
+
+    # Lowercase bearer scheme works; non-Bearer scheme fails
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "bearer #{token}" }
+    assert_response :ok
+    assert_equal "Jörg", json_body.dig("user", "name")
+
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Basic #{token}" }
+    assert_response :unauthorized
+
+    patch "/api/v1/me",
+      params: { user: { name: ["array"] } },
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token}" },
+      as: :json
+    assert_response :unprocessable_content
+
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: ["array"] } },
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token}" },
+      as: :json
+    assert_response :unprocessable_content
+
+    # Active account cannot be reactivated
+    post "/api/v1/account/reactivate",
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token}" }
+    assert_response :unprocessable_content
+  end
+
+  test "email verification and password reset handle unknown or already verified users safely" do
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Acme",
+          subdomain: "acme",
+          admin: { name: "Jo", email: "jo@acme.test", password: "my-first-password" }
+        }
+      },
+      as: :json
+    assert_response :created
+    verify_token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: verify_token } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    ActionMailer::Base.deliveries.clear
+
+    # Already verified user -> 200 OK, no email sent, stays verified
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      post "/api/v1/email_verifications",
+        params: { email_verification: { email: "jo@acme.test" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+      assert_response :ok
+    end
+    assert Account.find_by!(subdomain: "acme").users.find_by!(email: "jo@acme.test").verified?
+
+    # Unknown email -> 200 OK, no email sent
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      post "/api/v1/password_resets",
+        params: { password_reset: { email: "nobody@acme.test" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+      assert_response :ok
+    end
+
+    # Blank email -> 422
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "   " } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_content
+  end
+end
diff --git a/test/integration/email_support_test.rb b/test/integration/email_support_test.rb
new file mode 100644
index 0000000..5cce3c9
--- /dev/null
+++ b/test/integration/email_support_test.rb
@@ -0,0 +1,923 @@
+require "test_helper"
+
+class EmailSupportTest < ActionDispatch::IntegrationTest
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  INGRESS_PASSWORD = "test-inbound-secret-password"
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @orig_env = %w[
+      HELPDESK_FRONTEND_URL
+      HELPDESK_MAIL_FROM
+      HELPDESK_SUPPORT_DOMAIN
+      RAILS_INBOUND_EMAIL_PASSWORD
+    ].index_with { |k| ENV[k] }
+
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+    ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = INGRESS_PASSWORD
+  end
+
+  teardown do
+    @orig_env.each do |k, v|
+      v.nil? ? ENV.delete(k) : ENV[k] = v
+    end
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def extract_token(mail)
+    uri = URI.parse(mail.body.decoded[%r{https?://[^\s"<>]+}])
+    URI.decode_www_form(uri.query).to_h.fetch("token")
+  end
+
+  def relay_auth_header(username: "actionmailbox", password: INGRESS_PASSWORD)
+    ActionController::HttpAuthentication::Basic.encode_credentials(username, password)
+  end
+
+  def post_inbound_raw(raw_rfc822, auth: relay_auth_header, content_type: "message/rfc822")
+    headers = {}
+    headers["Authorization"] = auth if auth
+    headers["Content-Type"] = content_type if content_type
+    post RELAY_PATH, params: raw_rfc822, headers: headers
+  end
+
+  def build_raw_email(
+    from: "Avery Stone <avery@example.test>",
+    to: "acme@support.example.test",
+    cc: nil,
+    subject: "Need help with order",
+    body: "My package arrived damaged.",
+    message_id: "<#{SecureRandom.uuid}@example.test>",
+    extra_headers: {}
+  )
+    mail = Mail.new
+    mail.from = from if from
+    mail.to = to if to
+    mail.cc = cc if cc
+    mail.subject = subject unless subject.nil?
+    mail.message_id = message_id if message_id
+    extra_headers.each { |k, v| mail[k] = v }
+    mail.body = body unless body.nil?
+    mail.to_s
+  end
+
+  def setup_business!(subdomain: "acme", name: "Acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: { name: admin_name, email: email, password: password }
+        }
+      },
+      as: :json
+    assert_response :created
+    owner = json_body.fetch("user")
+    token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+    ActionMailer::Base.deliveries.clear
+    owner
+  end
+
+  def sign_in!(subdomain:, email:, password:)
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    json_body.dig("session", "token")
+  end
+
+  def auth_headers(subdomain, token)
+    {
+      "X-Helpdesk-Account" => subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+
+  test "relay ingress requires HTTP basic auth with RAILS_INBOUND_EMAIL_PASSWORD and message/rfc822" do
+    setup_business!(subdomain: "acme")
+    raw = build_raw_email(message_id: "<auth-check-1@example.test>")
+
+    # No credentials -> 401
+    assert_no_difference -> { Ticket.count } do
+      post_inbound_raw(raw, auth: nil)
+      assert_response :unauthorized
+    end
+
+    # Wrong password -> 401
+    assert_no_difference -> { Ticket.count } do
+      post_inbound_raw(raw, auth: relay_auth_header(password: "wrong-password"))
+      assert_response :unauthorized
+    end
+
+    # Wrong username -> 401
+    assert_no_difference -> { Ticket.count } do
+      post_inbound_raw(raw, auth: relay_auth_header(username: "wronguser"))
+      assert_response :unauthorized
+    end
+
+    # Wrong media type -> 415
+    assert_no_difference -> { Ticket.count } do
+      post_inbound_raw(raw, content_type: "text/plain")
+      assert_response :unsupported_media_type
+    end
+
+    # Valid auth and media type -> 204 and processed synchronously before request completes (including Same Message-ID!)
+    assert_difference -> { Ticket.count }, 1 do
+      post_inbound_raw(raw)
+      assert_response :no_content
+    end
+  end
+
+  test "new customer emailing support opens ticket, sends verification email without verifying account, and can later use portal" do
+    setup_business!(subdomain: "acme", name: "Acme")
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    owner_headers = auth_headers("acme", owner_token)
+
+    raw = build_raw_email(
+      from: "Avery Stone <AVERY@Example.Test>",
+      to: "ACME@support.example.test",
+      subject: "Cannot export CSV",
+      body: "Clicking export shows a spinner forever.\r\nSecond line."
+    )
+
+    assert_difference [-> { User.count }, -> { Ticket.count }, -> { Comment.count }, -> { ActionMailer::Base.deliveries.size }], 1 do
+      post_inbound_raw(raw)
+      assert_response :no_content
+    end
+
+    acme = Account.find_by!(subdomain: "acme")
+    customer = acme.users.find_by!(email: "avery@example.test")
+    assert_equal "Avery Stone", customer.name
+    assert_equal "customer", customer.role
+    assert_equal false, customer.verified?
+    assert_nil customer.email_verified_at
+
+    verify_mail = ActionMailer::Base.deliveries.last
+    assert_equal ["avery@example.test"], verify_mail.to
+    assert_includes verify_mail.subject, "Verify your email for Acme"
+    verify_token = extract_token(verify_mail)
+
+    # Staff sees ticket and initial comment in API
+    get "/api/v1/tickets", headers: owner_headers
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    ticket_json = json_body.fetch("tickets").first
+    ticket_id = ticket_json.fetch("id")
+    assert_equal "Cannot export CSV", ticket_json["subject"]
+    assert_equal "open", ticket_json["status"]
+    assert_equal "normal", ticket_json["priority"]
+    assert_equal customer.id, ticket_json["requester_id"]
+
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: owner_headers
+    assert_response :ok
+    assert_equal 1, json_body["count"]
