+    assert_equal 1, json_body["previous_page"]
+    assert_equal created_ids.reverse.drop(25), json_body.fetch("requests").map { |r| r["id"] }
+
+    # Replying to the oldest ticket (without changing status!) bumps it to the very top of both /tickets and /requests
+    oldest_id = created_ids.first
+    travel 60.minutes do
