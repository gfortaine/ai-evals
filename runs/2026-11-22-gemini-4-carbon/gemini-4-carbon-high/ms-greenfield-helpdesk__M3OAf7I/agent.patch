+    post "/api/v1/groups",
+      params: { group: { name: "Billing" } },
+      headers: globex_headers,
+      as: :json
+    assert_response :created
+
+    # Rename group via PATCH (including case-only rename on itself, then full rename)
+    patch "/api/v1/groups/#{billing["id"]}",
