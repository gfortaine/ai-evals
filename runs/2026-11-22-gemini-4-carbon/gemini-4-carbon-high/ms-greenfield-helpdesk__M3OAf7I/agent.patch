+    assert_equal 28, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 5, json_body["per_page"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    assert_equal oldest_id, json_body.fetch("tickets").first["id"]
+
+    get "/api/v1/requests", params: { page: 1, per_page: 5 }, headers: avery_headers
+    assert_response :ok
+    assert_equal oldest_id, json_body.fetch("requests").first["id"]
+
+    # Add 3 more comments on oldest_id (total 5 comments) and paginate comments oldest first
