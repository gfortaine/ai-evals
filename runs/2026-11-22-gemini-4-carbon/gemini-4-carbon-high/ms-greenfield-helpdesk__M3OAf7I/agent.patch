+    # Cancelling Acme blocks registrations and ticket/request access, and purging after 90 days cleans up tickets & comments
+    acme_id = Account.find_by!(subdomain: "acme").id
+    post "/api/v1/account/cancel", headers: acme_owner_headers
+    assert_response :ok
+
+    post "/api/v1/registrations",
+      params: { user: { name: "New", email: "new@example.test", password: "my-customer-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :forbidden
+
+    recovery_owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    get "/api/v1/tickets", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{recovery_owner_token}" }
