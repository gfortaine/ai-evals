@@ -0,0 +1,67 @@
+class Group < ApplicationRecord
+  belongs_to :account
+  has_many :group_memberships, dependent: :delete_all
+  has_many :users, through: :group_memberships
+  has_many :tickets, dependent: :nullify
+
+  normalizes :name, with: ->(value) { value.is_a?(String) ? value.strip : value }
+
+  validates :name,
+    presence: true,
+    format: { without: /\u0000/ }
+  validates :name,
+    uniqueness: { scope: :account_id, case_sensitive: false },
+    unless: -> { name.blank? || name.include?("\u0000") }
+
+  scope :ordered, -> { order(id: :asc) }
+
+  def self.create_for_account!(account:, name:)
+    group = account.groups.new(name: name)
+
+    account.with_lock do
+      raise ActiveRecord::RecordInvalid.new(group) unless group.valid?
+      group.save!
+    end
+
+    group
+  end
+
+  def rename!(new_name)
+    account.with_lock do
+      reload
+      self.name = new_name
+      raise ActiveRecord::RecordInvalid.new(self) unless valid?
+      save!
+    end
+
+    self
+  end
+
+  def destroy_with_cleanup!
+    account.with_lock do
+      reload
+      affected_user_ids = group_memberships.where(default: true).pluck(:user_id)
+
+      account.tickets.where(group_id: id).update_all(group_id: nil, assignee_id: nil)
+      group_memberships.delete_all
+      destroy!
+
+      affected_user_ids.each do |uid|
+        next if account.group_memberships.where(user_id: uid, default: true).exists?
+
+        replacement = account.group_memberships.where(user_id: uid).ordered.first
+        replacement&.update!(default: true)
+      end
+    end
+  end
+
+  def as_api_json
+    {
+      id: id,
+      account_id: account_id,
+      name: name,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+end
diff --git a/app/models/group_membership.rb b/app/models/group_membership.rb
new file mode 100644
index 0000000..0a20b64
--- /dev/null
+++ b/app/models/group_membership.rb
@@ -0,0 +1,145 @@
+class GroupMembership < ApplicationRecord
+  MAX_BIGINT = (1 << 63) - 1
+
+  belongs_to :account
+  belongs_to :group
+  belongs_to :user
+
+  validates :default, inclusion: { in: [true, false] }
+  validates :user_id, uniqueness: { scope: :group_id }
+
+  scope :ordered, -> { order(id: :asc) }
+
+  def self.add_member!(account:, raw_group_id:, raw_user_id:, has_default:, default_value:)
+    membership = account.group_memberships.new
+
+    account.with_lock do
+      group = resolve_group(account, raw_group_id, membership)
+      user = resolve_staff_user(account, raw_user_id, membership)
+
+      if has_default && default_value.nil?
+        membership.default = nil
+        membership.errors.add(:default, :inclusion)
+      end
+
+      if group && user && account.group_memberships.exists?(group_id: group.id, user_id: user.id)
+        membership.errors.add(:user_id, :taken)
+      end
+
+      raise ActiveRecord::RecordInvalid.new(membership) if membership.errors.any?
+
+      existing_default = account.group_memberships.where(user_id: user.id, default: true).exists?
+      make_default = if !existing_default
+        true
+      elsif has_default
+        default_value
+      else
+        false
+      end
+
+      if make_default && existing_default
+        account.group_memberships.where(user_id: user.id, default: true).update_all(
+          default: false,
+          updated_at: Time.current
+        )
+      end
+
+      membership.group = group
+      membership.user = user
+      membership.default = make_default
+      membership.save!
+    end
+
+    membership
+  end
+
+  def make_default!
+    account.with_lock do
+      reload
+      unless default?
+        account.group_memberships
+          .where(user_id: user_id, default: true)
+          .where.not(id: id)
+          .update_all(default: false, updated_at: Time.current)
+        update!(default: true)
+      end
+    end
+
+    self
+  end
+
+  def destroy_with_cleanup!
+    account.with_lock do
+      reload
+      uid = user_id
+      gid = group_id
+      was_default = default?
+
+      account.tickets.where(group_id: gid, assignee_id: uid).update_all(assignee_id: nil)
+      destroy!
+
+      if was_default && !account.group_memberships.where(user_id: uid, default: true).exists?
+        replacement = account.group_memberships.where(user_id: uid).ordered.first
+        replacement&.update!(default: true)
+      end
+    end
+  end
+
+  def as_api_json
+    {
+      id: id,
+      account_id: account_id,
+      group_id: group_id,
+      user_id: user_id,
+      default: self.default,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  def self.parse_id(raw_id)
+    id = if raw_id.is_a?(String)
+      return nil unless /\A\d+\z/.match?(raw_id)
+      raw_id.to_i
+    elsif raw_id.is_a?(Integer)
+      raw_id
+    end
+    return nil unless id && id >= 1 && id <= MAX_BIGINT
+
+    id
+  end
+
+  def self.resolve_group(account, raw_group_id, membership)
+    if raw_group_id.nil? || raw_group_id == ""
+      membership.errors.add(:group_id, :blank)
+      return nil
+    end
+
+    parsed_id = parse_id(raw_group_id)
+    group = parsed_id && account.groups.find_by(id: parsed_id)
+    unless group
+      membership.errors.add(:group_id, :invalid)
+      return nil
+    end
+
+    group
+  end
+  private_class_method :resolve_group
+
+  def self.resolve_staff_user(account, raw_user_id, membership)
+    if raw_user_id.nil? || raw_user_id == ""
+      membership.errors.add(:user_id, :blank)
+      return nil
+    end
+
+    parsed_id = parse_id(raw_user_id)
+    user = parsed_id && account.users.find_by(id: parsed_id)
+    unless user && user.staff?
+      membership.errors.add(:user_id, :invalid)
+      return nil
+    end
+
+    user
+  end
+  private_class_method :resolve_staff_user
+end
diff --git a/app/models/invitation.rb b/app/models/invitation.rb
new file mode 100644
index 0000000..2144733
--- /dev/null
+++ b/app/models/invitation.rb
@@ -0,0 +1,210 @@
+require "digest"
+
+class Invitation < ApplicationRecord
+  TTL = 7.days
+  ROLES = User::STAFF_ROLES
+  STATUSES = %w[pending accepted revoked expired].freeze
+
+  belongs_to :account
+  belongs_to :invited_by, class_name: "User", optional: true
+
+  normalizes :email, with: ->(value) { value.is_a?(String) ? value.strip.downcase : value }
+
+  validates :email,
+    presence: true,
+    format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :role, presence: true, inclusion: { in: ROLES }
+  validates :token_digest, presence: true, uniqueness: true
+  validates :expires_at, presence: true
+
+  scope :ordered, -> { order(id: :asc) }
+  scope :accepted, -> { where.not(accepted_at: nil) }
+  scope :revoked, -> { where(accepted_at: nil).where.not(revoked_at: nil) }
+  scope :expired, ->(now = Time.current) { where(accepted_at: nil, revoked_at: nil).where("expires_at <= ?", now) }
+  scope :pending, ->(now = Time.current) { where(accepted_at: nil, revoked_at: nil).where("expires_at > ?", now) }
+
+  def self.with_status(status, now = Time.current)
+    case status
+    when "pending" then pending(now)
+    when "accepted" then accepted
+    when "revoked" then revoked
+    when "expired" then expired(now)
+    else none
+    end
+  end
+
+  def self.digest(raw_token)
+    Digest::SHA256.hexdigest(raw_token.to_s)
+  end
+
+  def self.find_valid_for_account(account, raw_token)
+    return nil unless account && raw_token.is_a?(String) && raw_token.present?
+
+    account.invitations
+      .includes(:account)
+      .pending
+      .find_by(token_digest: digest(raw_token))
+  end
+
+  def self.issue!(account:, invited_by:, email:, role:)
+    raw_token = SecureRandom.alphanumeric(40)
+    invitation = account.invitations.new(
+      invited_by: invited_by,
+      email: email,
+      role: role,
+      token_digest: digest(raw_token),
+      expires_at: TTL.from_now
+    )
+
+    account.with_lock do
+      valid = invitation.valid?
+      if invitation.email.present? && !invitation.errors.include?(:email)
+        if account.users.exists?(email: invitation.email) || account.invitations.pending.exists?(email: invitation.email)
+          invitation.errors.add(:email, :taken)
+          valid = false
+        end
+      end
+      raise ActiveRecord::RecordInvalid.new(invitation) unless valid
+
+      invitation.save!
+    end
+
+    UserMailer.invitation(invitation, raw_token).deliver_now
+
+    invitation
+  end
+
+  def self.accept_for_account!(account:, raw_token:, name:, password:)
+    return nil unless account && raw_token.is_a?(String) && raw_token.present?
+
+    account.with_lock do
+      invitation = account.invitations.pending.find_by(token_digest: digest(raw_token))
+      return nil if invitation.nil?
+
+      now = Time.current
+      user = account.users.new(
+        name: name,
+        email: invitation.email,
+        role: invitation.role,
+        verified: true,
+        email_verified_at: now,
+        suspended: false
+      )
+      user.password = password if password.is_a?(String) && password.present?
+      user.save!
+
+      invitation.update!(accepted_at: now)
+      user
+    end
+  end
+
+  def status(now = Time.current)
+    if accepted_at.present?
+      "accepted"
+    elsif revoked_at.present?
+      "revoked"
+    elsif expires_at <= now
+      "expired"
+    else
+      "pending"
+    end
+  end
+
+  def accepted?
+    accepted_at.present?
+  end
+
+  def revoked?
+    accepted_at.nil? && revoked_at.present?
+  end
+
+  def expired?(now = Time.current)
+    accepted_at.nil? && revoked_at.nil? && expires_at <= now
+  end
+
+  def pending?(now = Time.current)
+    accepted_at.nil? && revoked_at.nil? && expires_at > now
+  end
+
+  def resend!
+    raw_token = SecureRandom.alphanumeric(40)
+
+    account.with_lock do
+      reload
+      if accepted?
+        errors.add(:base, "Invitation has already been accepted")
+        raise ActiveRecord::RecordInvalid.new(self)
+      end
+
+      if revoked?
+        errors.add(:base, "Invitation has been revoked")
+        raise ActiveRecord::RecordInvalid.new(self)
+      end
+
+      if account.users.exists?(email: email) || account.invitations.pending.where.not(id: id).exists?(email: email)
+        errors.add(:email, :taken)
+        raise ActiveRecord::RecordInvalid.new(self)
+      end
+
+      update!(
+        token_digest: self.class.digest(raw_token),
+        expires_at: TTL.from_now
+      )
+    end
+
+    UserMailer.invitation(self, raw_token).deliver_now
+    self
+  end
+
+  def revoke!
+    account.with_lock do
+      reload
+      if accepted?
+        errors.add(:base, "Invitation has already been accepted")
+        raise ActiveRecord::RecordInvalid.new(self)
+      end
+
+      if revoked?
+        errors.add(:base, "Invitation has already been revoked")
+        raise ActiveRecord::RecordInvalid.new(self)
+      end
+
+      if expired?
+        errors.add(:base, "Invitation has already expired")
+        raise ActiveRecord::RecordInvalid.new(self)
+      end
+
+      update!(revoked_at: Time.current)
+    end
+
+    self
+  end
+
+  def as_api_json
+    {
+      id: id,
+      account_id: account_id,
+      invited_by_id: invited_by_id,
+      email: email,
+      role: role,
+      status: status,
+      expires_at: expires_at,
+      accepted_at: accepted_at,
+      revoked_at: revoked_at,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  def as_preview_json
+    {
+      email: email,
+      role: role,
+      account: account.as_portal_json,
+      account_name: account.name,
+      business_name: account.name,
+      subdomain: account.subdomain,
+      expires_at: expires_at
+    }
+  end
+end
diff --git a/app/models/password_reset_token.rb b/app/models/password_reset_token.rb
new file mode 100644
index 0000000..18d4ea4
--- /dev/null
+++ b/app/models/password_reset_token.rb
@@ -0,0 +1,35 @@
+require "digest"
+
+class PasswordResetToken < ApplicationRecord
+  TTL = 24.hours
+
+  belongs_to :account
+  belongs_to :user
+
+  validates :token_digest, presence: true, uniqueness: true
+  validates :expires_at, presence: true
+
+  def self.digest(raw_token)
+    Digest::SHA256.hexdigest(raw_token.to_s)
+  end
+
+  def self.issue_for!(user)
+    raw_token = SecureRandom.alphanumeric(40)
+    create!(
+      account: user.account,
+      user: user,
+      token_digest: digest(raw_token),
+      expires_at: TTL.from_now
+    )
+    raw_token
+  end
+
+  def self.find_valid_for_account(account, raw_token)
+    return nil unless account && raw_token.is_a?(String) && raw_token.present?
+
+    account.password_reset_tokens
+      .includes(:user)
+      .where("expires_at > ?", Time.current)
+      .find_by(token_digest: digest(raw_token))
+  end
+end
