+
+  test "password reset link replacement, confirmation, and session revocation" do
+    register_and_verify!(subdomain: "acme")
+    active_token = sign_in!(subdomain: "acme").dig("session", "token")
+    ActionMailer::Base.deliveries.clear
+
+    # Request first reset link
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
