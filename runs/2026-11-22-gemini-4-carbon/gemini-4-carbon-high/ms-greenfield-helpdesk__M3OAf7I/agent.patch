+    assert_equal 2, ActionMailer::Base.deliveries.size
+    _uri_2, query_2 = extract_link_params(ActionMailer::Base.deliveries.last, "/reset-password")
+    assert_not_equal query_1["token"], query_2["token"]
+
+    # Old reset token fails
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: query_1["token"], password: "my-new-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_content
+
+    # Invalid password does not consume valid token
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: query_2["token"], password: "" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_content
+
+    # Valid confirmation updates password and revokes existing sessions
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: query_2["token"], password: "my-new-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+
+    # Token cannot be reused
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: query_2["token"], password: "another-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_content
+
+    # Existing session was revoked
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{active_token}" }
+    assert_response :unauthorized
+
+    # Can sign in with new password
+    sign_in!(subdomain: "acme", password: "my-new-password")
+  end
+
+  test "CORS allows configured frontend origin and rejects other origins" do
+    options "/api/v1/account/create", headers: {
+      "Origin" => "http://localhost:3001",
+      "Access-Control-Request-Method" => "POST",
