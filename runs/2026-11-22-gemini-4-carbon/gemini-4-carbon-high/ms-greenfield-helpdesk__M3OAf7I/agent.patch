+
+  test "profile view, name update, sign out, and password change revoking existing sessions" do
+    register_and_verify!(subdomain: "acme")
+    token_1 = sign_in!(subdomain: "acme").dig("session", "token")
+    token_2 = sign_in!(subdomain: "acme").dig("session", "token")
+    headers_1 = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token_1}" }
+    headers_2 = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token_2}" }
+
+    # GET /me
+    get "/api/v1/me", headers: headers_1
+    assert_response :ok
+    assert_equal "Jo", json_body.dig("user", "name")
+
+    # PATCH /me updates name and ignores unpermitted fields
+    patch "/api/v1/me",
+      params: { user: { name: "Jo Smith", role: "customer", verified: false } },
+      headers: headers_1,
+      as: :json
+    assert_response :ok
+    assert_equal "Jo Smith", json_body.dig("user", "name")
+    assert_equal "admin", json_body.dig("user", "role")
+    assert_equal true, json_body.dig("user", "verified")
+
+    # Blank name fails validation
+    patch "/api/v1/me", params: { user: { name: "   " } }, headers: headers_1, as: :json
+    assert_response :unprocessable_content
+
+    # DELETE /session signs out only token_1
+    delete "/api/v1/session", headers: headers_1
+    assert_response :no_content
+
+    get "/api/v1/me", headers: headers_1
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: headers_2
+    assert_response :ok
+
+    # Create another session token_3 so user has two active sessions (token_2 and token_3)
+    token_3 = sign_in!(subdomain: "acme").dig("session", "token")
+    headers_3 = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token_3}" }
+
+    # Wrong current_password fails and keeps sessions active
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "wrong-password", password: "my-new-password" } },
+      headers: headers_2,
+      as: :json
+    assert_response :unprocessable_content
+
+    get "/api/v1/me", headers: headers_2
+    assert_response :ok
+
+    # Valid password change signs out ALL existing sessions
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+      headers: headers_2,
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: headers_2
