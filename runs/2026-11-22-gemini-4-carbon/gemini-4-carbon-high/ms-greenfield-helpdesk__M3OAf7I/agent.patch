+  test "recently active ordering and pagination defaults and custom page/per_page across requests, tickets, and comments" do
+    setup_business!(subdomain: "acme")
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")
+
+    owner_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    avery_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+
+    # Empty list pagination metadata
+    get "/api/v1/requests", headers: avery_headers
+    assert_response :ok
+    assert_equal({
+      "requests" => [],
+      "count" => 0,
+      "page" => 1,
+      "per_page" => 25,
+      "next_page" => nil,
+      "previous_page" => nil
+    }, json_body)
+
+    # Create 28 requests at staggered times
+    created_ids = []
+    28.times do |i|
+      travel((i + 1).minutes) do
+        post "/api/v1/requests",
+          params: { request: { subject: "Request #{i + 1}", comment: { body: "Initial #{i + 1}" } } },
+          headers: avery_headers,
+          as: :json
+        assert_response :created
+        created_ids << json_body.dig("request", "id")
+      end
+    end
+
+    # Default page=1, per_page=25 returns 25 most recently created first
+    get "/api/v1/requests", headers: avery_headers
+    assert_response :ok
+    assert_equal 28, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_equal 2, json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    assert_equal created_ids.reverse.first(25), json_body.fetch("requests").map { |r| r["id"] }
+
+    # Page 2 returns remaining 3
+    get "/api/v1/requests", params: { page: 2 }, headers: avery_headers
+    assert_response :ok
+    assert_equal 28, json_body["count"]
+    assert_equal 2, json_body["page"]
+    assert_equal 25, json_body["per_page"]
