+      "Still getting a blank tab.",
+      "Deployed a fix for Safari.",
+      "Wait, what about mobile?",
+      "Works on mobile too, thanks!"
+    ], bodies
+  end
+
+  test "agent role can access and reply to tickets; role separation and customer isolation are enforced" do
+    setup_business!(subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
