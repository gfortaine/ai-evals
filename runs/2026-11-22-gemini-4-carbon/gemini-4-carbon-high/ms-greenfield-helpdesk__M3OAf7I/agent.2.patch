+require "test_helper"
+require "rake"
+
+class PortalAndTicketsTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def extract_token(mail)
+    uri = URI.parse(mail.body.decoded[%r{https?://[^\s"<>]+}])
+    URI.decode_www_form(uri.query).to_h.fetch("token")
+  end
+
+  def setup_business!(subdomain: "acme", name: "Acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: { name: admin_name, email: email, password: password }
+        }
+      },
+      as: :json
+    assert_response :created
+    token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+    ActionMailer::Base.deliveries.clear
+  end
+
+  def register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    post "/api/v1/registrations",
+      params: { user: { name: name, email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    user = json_body.fetch("user")
+    token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+    ActionMailer::Base.deliveries.clear
+    user
+  end
+
+  def sign_in!(subdomain:, email:, password:)
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    json_body.dig("session", "token")
+  end
+
+  test "customer registration uses existing verification, login, profile, and password recovery flows" do
+    setup_business!(subdomain: "acme")
+
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      post "/api/v1/registrations",
+        params: {
+          user: {
+            name: "Avery",
+            email: "avery@example.test",
+            password: "my-customer-password",
+            role: "admin",
+            verified: true
+          }
+        },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+    end
+    assert_response :created
+
+    user = json_body.fetch("user")
+    assert_kind_of Integer, user["id"]
+    assert_equal "Avery", user["name"]
+    assert_equal "avery@example.test", user["email"]
+    assert_equal "customer", user["role"]
+    assert_equal false, user["verified"]
+    assert_not user.key?("password")
+    assert_not user.key?("password_digest")
+
+    # Cannot sign in before email verification
+    post "/api/v1/sessions",
+      params: { session: { email: "avery@example.test", password: "my-customer-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :forbidden
+
+    # Resend verification and confirm
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "avery@example.test" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    verify_token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: verify_token } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    assert_equal true, json_body.dig("user", "verified")
+
+    # Sign in and update profile
+    customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{customer_token}" }
+    assert_response :ok
+    assert_equal "customer", json_body.dig("user", "role")
+
+    patch "/api/v1/me",
+      params: { user: { name: "Avery Stone" } },
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{customer_token}" },
+      as: :json
+    assert_response :ok
+    assert_equal "Avery Stone", json_body.dig("user", "name")
+
+    # Password recovery flow
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "avery@example.test" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    reset_token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token, password: "my-new-customer-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+
+    sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-new-customer-password")
+  end
+
+  test "end-to-end portal request and staff ticket conversation, statuses, and no email sent on replies" do
+    setup_business!(subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    avery = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")
+
+    owner_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    avery_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+
+    # Customer opens a request - no email sent
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      post "/api/v1/requests",
+        params: {
+          request: {
+            subject: "Cannot download my receipt",
+            comment: { body: "The download button does nothing." }
+          }
+        },
+        headers: avery_headers,
+        as: :json
+    end
+    assert_response :created
+
+    req = json_body.fetch("request")
+    request_id = req.fetch("id")
+    assert_kind_of Integer, request_id
+    assert_equal "Cannot download my receipt", req["subject"]
+    assert_equal "open", req["status"]
+    assert_equal avery["id"], req["requester_id"]
+    assert req["created_at"].present?
+    assert req["updated_at"].present?
+
+    # Customer views request and comments
+    get "/api/v1/requests/#{request_id}", headers: avery_headers
+    assert_response :ok
+    assert_equal req, json_body.fetch("request")
+
+    get "/api/v1/requests/#{request_id}/comments", headers: avery_headers
+    assert_response :ok
+    assert_equal 1, json_body["count"]
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+    assert_nil json_body["next_page"]
+    assert_nil json_body["previous_page"]
+    first_comment = json_body.fetch("comments").first
+    assert_equal "The download button does nothing.", first_comment["body"]
+    assert_equal({ "id" => avery["id"], "name" => "Avery" }, first_comment["author"])
+    assert_equal true, first_comment["public"]
+    assert first_comment["created_at"].present?
+
+    # Staff views ticket and comments
+    get "/api/v1/tickets/#{request_id}", headers: owner_headers
+    assert_response :ok
+    ticket = json_body.fetch("ticket")
+    assert_equal request_id, ticket["id"]
+    assert_equal "Cannot download my receipt", ticket["subject"]
+    assert_equal "open", ticket["status"]
+    assert_equal({ "id" => avery["id"], "name" => "Avery", "email" => "avery@example.test" }, ticket["requester"])
+
+    # Owner replies and marks ticket pending (no email sent)
+    travel 1.minute do
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        patch "/api/v1/tickets/#{request_id}",
+          params: {
+            ticket: {
+              comment: { body: "Please try again now." },
+              status: "pending"
+            }
+          },
+          headers: owner_headers,
+          as: :json
+      end
+      assert_response :ok
+      assert_equal "pending", json_body.dig("ticket", "status")
+    end
+
+    # Staff reply by itself does not change status (stays pending)
+    travel 2.minutes do
+      patch "/api/v1/tickets/#{request_id}",
+        params: {
+          ticket: {
+            comment: { body: "Let us know if you see any error message." }
+          }
+        },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+      assert_equal "pending", json_body.dig("ticket", "status")
+    end
+
+    # Customer reply reopens pending request
+    travel 3.minutes do
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        patch "/api/v1/requests/#{request_id}",
+          params: {
+            request: {
+              comment: { body: "Still getting a blank tab." }
+            }
+          },
+          headers: avery_headers,
+          as: :json
+      end
+      assert_response :ok
+      assert_equal "open", json_body.dig("request", "status")
+    end
+
+    # Staff marks ticket solved
+    travel 4.minutes do
+      patch "/api/v1/tickets/#{request_id}",
+        params: {
+          ticket: {
+            comment: { body: "Deployed a fix for Safari." },
+            status: "solved"
+          }
+        },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+      assert_equal "solved", json_body.dig("ticket", "status")
+    end
+
+    # Customer reply reopens solved request
+    travel 5.minutes do
+      patch "/api/v1/requests/#{request_id}",
+        params: {
+          request: {
+            comment: { body: "Wait, what about mobile?" }
+          }
+        },
+        headers: avery_headers,
+        as: :json
+      assert_response :ok
+      assert_equal "open", json_body.dig("request", "status")
+    end
+
+    # Staff sets pending again; customer replies AND marks solved in the same update -> stays solved!
+    travel 6.minutes do
+      patch "/api/v1/tickets/#{request_id}",
+        params: { ticket: { status: "pending" } },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+      assert_equal "pending", json_body.dig("ticket", "status")
+    end
+
+    travel 7.minutes do
+      patch "/api/v1/requests/#{request_id}",
+        params: {
+          request: {
+            comment: { body: "Works on mobile too, thanks!" },
+            status: "solved"
+          }
+        },
+        headers: avery_headers,
+        as: :json
+      assert_response :ok
+      assert_equal "solved", json_body.dig("request", "status")
+    end
+
+    # Comments are ordered oldest first
+    get "/api/v1/tickets/#{request_id}/comments", headers: owner_headers
+    assert_response :ok
+    bodies = json_body.fetch("comments").map { |c| c["body"] }
+    assert_equal [
+      "The download button does nothing.",
+      "Please try again now.",
