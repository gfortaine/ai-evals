+    assert_equal ["Initial 1", "Staff reply bumping activity"], json_body.fetch("comments").map { |c| c["body"] }
+
+    get "/api/v1/requests/#{oldest_id}/comments", params: { page: 2, per_page: 2 }, headers: avery_headers
+    assert_response :ok
+    assert_equal 5, json_body["count"]
+    assert_equal 2, json_body["page"]
+    assert_equal 2, json_body["per_page"]
+    assert_equal 3, json_body["next_page"]
+    assert_equal 1, json_body["previous_page"]
+    assert_equal ["Follow-up 1", "Follow-up 2"], json_body.fetch("comments").map { |c| c["body"] }
+
+    get "/api/v1/tickets/#{oldest_id}/comments", params: { page: 3, per_page: 2 }, headers: owner_headers
+    assert_response :ok
+    assert_equal 5, json_body["count"]
+    assert_equal 3, json_body["page"]
+    assert_equal 2, json_body["per_page"]
+    assert_nil json_body["next_page"]
+    assert_equal 2, json_body["previous_page"]
+    assert_equal ["Follow-up 3"], json_body.fetch("comments").map { |c| c["body"] }
+  end
+
+  test "multi-tenancy isolation, validation errors, atomic rollbacks, and cancelled account purge" do
+    setup_business!(subdomain: "acme", name: "Acme", email: "jo@acme.test")
+    setup_business!(subdomain: "globex", name: "Globex", email: "jo@globex.test")
+
+    # Same customer email can register independently on both portals
+    register_and_verify_customer!(subdomain: "acme", name: "Avery Acme", email: "avery@example.test")
+    register_and_verify_customer!(subdomain: "globex", name: "Avery Globex", email: "avery@example.test")
+
+    # Duplicate email on same portal is rejected with 422 and sends no email
+    assert_no_difference [-> { User.count }, -> { ActionMailer::Base.deliveries.size }] do
+      post "/api/v1/registrations",
+        params: { user: { name: "Dup", email: "AVERY@example.test", password: "my-customer-password" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+      assert_response :unprocessable_content
+    end
+
+    acme_owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    globex_owner_token = sign_in!(subdomain: "globex", email: "jo@globex.test", password: "my-first-password")
+    acme_avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")
+
+    acme_owner_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{acme_owner_token}" }
+    globex_owner_headers = { "X-Helpdesk-Account" => "globex", "Authorization" => "Bearer #{globex_owner_token}" }
+    acme_avery_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{acme_avery_token}" }
+
+    # Invalid request creation rolls back both ticket and comment
+    assert_no_difference [-> { Ticket.count }, -> { Comment.count }] do
+      post "/api/v1/requests",
+        params: { request: { subject: "   ", comment: { body: "" } } },
+        headers: acme_avery_headers,
+        as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/requests",
+        params: { request: { subject: "Valid subject" } },
+        headers: acme_avery_headers,
+        as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/requests",
+        params: { request: { subject: "Valid subject", comment: "not-an-object" } },
+        headers: acme_avery_headers,
+        as: :json
+      assert_response :unprocessable_content
+    end
+
+    post "/api/v1/requests",
+      params: { request: { subject: "Acme Receipt", status: "solved", comment: { body: "Cannot download", public: false } } },
+      headers: acme_avery_headers,
+      as: :json
+    assert_response :created
+    ticket_id = json_body.dig("request", "id")
+    # New request is always open, customer comment is always public
+    assert_equal "open", json_body.dig("request", "status")
+    get "/api/v1/requests/#{ticket_id}/comments", headers: acme_avery_headers
+    assert_equal true, json_body.fetch("comments").first["public"]
+
+    # Globex staff cannot see or update Acme ticket
+    get "/api/v1/tickets", headers: globex_owner_headers
+    assert_response :ok
+    assert_equal 0, json_body["count"]
+
+    get "/api/v1/tickets/#{ticket_id}", headers: globex_owner_headers
+    assert_response :not_found
+
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { status: "solved" } },
+      headers: globex_owner_headers,
+      as: :json
+    assert_response :not_found
+
+    # Invalid staff updates and invalid customer updates roll back atomically
+    assert_no_difference -> { Comment.count } do
+      patch "/api/v1/tickets/#{ticket_id}",
+        params: { ticket: { comment: { body: "" }, status: "pending" } },
+        headers: acme_owner_headers,
+        as: :json
+      assert_response :unprocessable_content
+
+      patch "/api/v1/tickets/#{ticket_id}",
+        params: { ticket: { comment: { body: "Valid body" }, status: "closed" } },
+        headers: acme_owner_headers,
+        as: :json
+      assert_response :unprocessable_content
+
+      patch "/api/v1/tickets/#{ticket_id}",
+        params: { ticket: {} },
+        headers: acme_owner_headers,
+        as: :json
+      assert_response :unprocessable_content
+
+      # Customer cannot set status to pending
+      patch "/api/v1/requests/#{ticket_id}",
+        params: { request: { comment: { body: "Trying pending" }, status: "pending" } },
+        headers: acme_avery_headers,
+        as: :json
+      assert_response :unprocessable_content
+
+      patch "/api/v1/requests/#{ticket_id}",
+        params: { request: {} },
+        headers: acme_avery_headers,
+        as: :json
+      assert_response :unprocessable_content
+    end
+    assert_equal "open", Ticket.find(ticket_id).status
+
+    # Malformed params and out-of-range IDs/pagination never return 500
+    post "/api/v1/registrations", params: { user: "bad" }, headers: { "X-Helpdesk-Account" => "acme" }, as: :json
+    assert_response :bad_request
+
+    post "/api/v1/requests", params: { request: ["bad"] }, headers: acme_avery_headers, as: :json
+    assert_response :bad_request
+
+    patch "/api/v1/tickets/#{ticket_id}", params: { ticket: "bad" }, headers: acme_owner_headers, as: :json
+    assert_response :bad_request
+
+    get "/api/v1/tickets/999999999999999999999999999", headers: acme_owner_headers
+    assert_response :not_found
+
+    get "/api/v1/requests/not-an-id/comments", headers: acme_avery_headers
+    assert_response :not_found
+
+    get "/api/v1/tickets", params: { page: -5, per_page: 0 }, headers: acme_owner_headers
+    assert_response :ok
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+
+    get "/api/v1/tickets", params: { page: ["arr"], per_page: "abc" }, headers: acme_owner_headers
+    assert_response :ok
+    assert_equal 1, json_body["page"]
+    assert_equal 25, json_body["per_page"]
+
+    # Cancelling Acme blocks registrations and ticket/request access, and purging after 90 days cleans up tickets & comments
+    acme_id = Account.find_by!(subdomain: "acme").id
+    post "/api/v1/account/cancel", headers: acme_owner_headers
+    assert_response :ok
+
+    post "/api/v1/registrations",
+      params: { user: { name: "New", email: "new@example.test", password: "my-customer-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :forbidden
+
+    recovery_owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    get "/api/v1/tickets", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{recovery_owner_token}" }
+    assert_response :forbidden
+
+    Rails.application.load_tasks if Rake::Task.tasks.empty?
+    travel 90.days + 1.second do
+      Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+      Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+
+      assert_not Account.exists?(acme_id)
+      assert_equal 0, Ticket.where(account_id: acme_id).count
+      assert_equal 0, Comment.where(account_id: acme_id).count
+      assert Account.find_by(subdomain: "globex").present?
+    end
+  end
+end
