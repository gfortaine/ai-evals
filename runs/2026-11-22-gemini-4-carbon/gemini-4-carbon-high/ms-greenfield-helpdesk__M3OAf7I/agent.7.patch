+      Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+      assert_not Account.exists?(acme_id)
+      assert_equal 0, Ticket.where(account_id: acme_id).count
+    end
+  end
+
+  test "merge permissions, cross-customer/cross-tenant/self/closed rejections, malformed payloads, and atomic rollback" do
+    setup_business!(subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    setup_business!(subdomain: "globex", admin_name: "Gus", email: "gus@globex.test")
+
+    acme_owner_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password"))
+    globex_owner_headers = auth_headers("globex", sign_in!(subdomain: "globex", email: "gus@globex.test", password: "my-first-password"))
+
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    register_and_verify_customer!(subdomain: "acme", name: "Blake", email: "blake@example.test")
+    register_and_verify_customer!(subdomain: "globex", name: "Avery Globex", email: "avery@example.test")
+
+    avery_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password"))
+    blake_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "blake@example.test", password: "my-customer-password"))
+    globex_avery_headers = auth_headers("globex", sign_in!(subdomain: "globex", email: "avery@example.test", password: "my-customer-password"))
+
+    post "/api/v1/requests", params: { request: { subject: "Avery 1", comment: { body: "Body 1" } } }, headers: avery_headers, as: :json
+    avery_t1 = json_body.dig("request", "id")
+    post "/api/v1/requests", params: { request: { subject: "Avery 2", comment: { body: "Body 2" } } }, headers: avery_headers, as: :json
+    avery_t2 = json_body.dig("request", "id")
+    post "/api/v1/requests", params: { request: { subject: "Avery 3", comment: { body: "Body 3" } } }, headers: avery_headers, as: :json
+    avery_t3 = json_body.dig("request", "id")
+
+    post "/api/v1/requests", params: { request: { subject: "Blake 1", comment: { body: "Blake body" } } }, headers: blake_headers, as: :json
+    blake_t1 = json_body.dig("request", "id")
+
+    post "/api/v1/requests", params: { request: { subject: "Globex 1", comment: { body: "Globex body" } } }, headers: globex_avery_headers, as: :json
+    globex_t1 = json_body.dig("request", "id")
+
+    # Auth & role checks
+    post "/api/v1/tickets/#{avery_t1}/merge", params: { merge: { target_id: avery_t2 } }, as: :json
+    assert_response :bad_request
+
+    post "/api/v1/tickets/#{avery_t1}/merge",
+      params: { merge: { target_id: avery_t2 } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unauthorized
+
+    post "/api/v1/tickets/#{avery_t1}/merge",
+      params: { merge: { target_id: avery_t2 } },
+      headers: avery_headers,
+      as: :json
+    assert_response :forbidden
+
+    # Source ticket not found / cross-account / malformed ID -> 404
+    ["999999", "not-an-id", "0", "-5", "999999999999999999999999999", globex_t1.to_s].each do |bad_source_id|
+      post "/api/v1/tickets/#{bad_source_id}/merge",
+        params: { merge: { target_id: avery_t2 } },
+        headers: acme_owner_headers,
+        as: :json
+      assert_response :not_found
+    end
+
+    # Malformed JSON or missing/non-object merge wrapper -> 400
+    post "/api/v1/tickets/#{avery_t1}/merge",
+      params: "{bad json",
+      headers: acme_owner_headers.merge("Content-Type" => "application/json")
+    assert_response :bad_request
+
+    [{}, { merge: "bad" }, { merge: [1] }, { merge: nil }].each do |bad_top|
+      post "/api/v1/tickets/#{avery_t1}/merge",
+        params: bad_top,
+        headers: acme_owner_headers,
+        as: :json
+      assert_response :bad_request
+    end
+
+    # Invalid target_id, self-merge, different customer, cross-account target, and invalid source_comment/target_comment roll back atomically (422)
+    assert_no_difference -> { Comment.count } do
+      [
+        {},
+        { target_id: nil },
+        { target_id: "" },
+        { target_id: "abc" },
+        { target_id: 0 },
+        { target_id: -1 },
+        { target_id: true },
+        { target_id: [avery_t2] },
+        { target_id: { id: avery_t2 } },
+        { target_id: 99_999_999_999_999_999_999_999_999 },
+        { target_id: 999_999 },
+        { target_id: avery_t1 }, # self-merge
+        { target_id: avery_t1.to_s }, # self-merge string
+        { target_id: blake_t1 }, # different customer in same account
+        { target_id: globex_t1 }, # cross-account ticket (even with same customer email)
+        { target_id: avery_t2, source_comment: "not-an-object" },
+        { target_id: avery_t2, source_comment: nil },
+        { target_id: avery_t2, source_comment: ["arr"] },
+        { target_id: avery_t2, source_comment: { body: "" } },
+        { target_id: avery_t2, source_comment: { body: "   " } },
+        { target_id: avery_t2, source_comment: { body: nil } },
+        { target_id: avery_t2, source_comment: { body: 123 } },
+        { target_id: avery_t2, source_comment: { body: "Bad\u0000Body" } },
+        { target_id: avery_t2, source_comment: { body: "Valid", public: "yes" } },
+        { target_id: avery_t2, source_comment: { body: "Valid", public: nil } },
+        { target_id: avery_t2, target_comment: "not-an-object" },
+        { target_id: avery_t2, target_comment: nil },
+        { target_id: avery_t2, target_comment: { body: "   " } },
+        { target_id: avery_t2, target_comment: { body: "Bad\u0000Body" } },
+        { target_id: avery_t2, target_comment: { body: "Valid", public: 1 } }
+      ].each do |bad_merge|
+        post "/api/v1/tickets/#{avery_t1}/merge",
+          params: { merge: bad_merge },
+          headers: acme_owner_headers,
+          as: :json
+        assert_response :unprocessable_content, "Expected 422 for merge payload #{bad_merge.inspect}, got #{response.status}"
+      end
+    end
+
+    assert_equal "open", Ticket.find(avery_t1).status
+    assert_nil Ticket.find(avery_t1).merged_into_id
+
+    # Merge avery_t1 -> avery_t2 succeeds (including numeric string target_id)
+    post "/api/v1/tickets/#{avery_t1}/merge",
+      params: { merge: { target_id: avery_t2.to_s } },
+      headers: acme_owner_headers,
+      as: :json
+    assert_response :ok
+
+    # Re-merging already-closed source avery_t1 is rejected (422)
+    assert_no_difference -> { Comment.count } do
+      post "/api/v1/tickets/#{avery_t1}/merge",
+        params: { merge: { target_id: avery_t3 } },
+        headers: acme_owner_headers,
+        as: :json
+      assert_response :unprocessable_content
+
+      # Merging avery_t3 INTO already-closed target avery_t1 (or avery_t2 into closed avery_t1 cycle!) is ALSO rejected (422)
+      post "/api/v1/tickets/#{avery_t3}/merge",
+        params: { merge: { target_id: avery_t1 } },
+        headers: acme_owner_headers,
+        as: :json
+      assert_response :unprocessable_content
+
+      post "/api/v1/tickets/#{avery_t2}/merge",
+        params: { merge: { target_id: avery_t1 } },
+        headers: acme_owner_headers,
+        as: :json
+      assert_response :unprocessable_content
+    end
+
+    assert_equal t_expected = avery_t2, Ticket.find(avery_t1).merged_into_id
+    assert_equal "open", Ticket.find(avery_t2).status
+    assert_equal "open", Ticket.find(avery_t3).status
+  end
