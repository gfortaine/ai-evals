+  test "merge response matches GET /tickets/:id, works for unverified email customers, supports combined closed inbox filters, and blocks cancelled accounts" do
+    setup_business!(subdomain: "acme", admin_name: "Jo", email: "jo@acme.test")
+    owner_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password"))
+
+    sam = invite_and_accept_staff!(subdomain: "acme", owner_headers: owner_headers, email: "sam@acme.test", name: "Sam", role: "agent")
+    post "/api/v1/groups", params: { group: { name: "VIP" } }, headers: owner_headers, as: :json
+    vip_group = json_body.fetch("group")
+    post "/api/v1/group_memberships", params: { group_membership: { group_id: vip_group["id"], user_id: sam["id"] } }, headers: owner_headers, as: :json
+    assert_response :created
+
+    # Unverified customer sends two emails
+    post_inbound_raw(build_raw_email(
+      from: "New Person <newperson@example.test>",
+      to: "acme@support.example.test",
+      subject: "First unverified email",
+      body: "Initial question from unverified user.",
+      message_id: "<unverified-1@example.test>"
+    ))
+    assert_response :no_content
+
+    post_inbound_raw(build_raw_email(
+      from: "New Person <newperson@example.test>",
+      to: "acme@support.example.test",
+      subject: "Second unverified email",
+      body: "Follow-up duplicate email.",
+      message_id: "<unverified-2@example.test>"
+    ))
+    assert_response :no_content
+    ActionMailer::Base.deliveries.clear
+
+    acme = Account.find_by!(subdomain: "acme")
+    unverified_customer = acme.users.find_by!(email: "newperson@example.test")
+    assert_equal false, unverified_customer.verified?
+    t_main, t_dup = acme.tickets.where(requester_id: unverified_customer.id).order(:id).to_a
+
+    # Assign t_dup to VIP/Sam with high priority before merging
+    patch "/api/v1/tickets/#{t_dup.id}",
+      params: { ticket: { priority: "high", group_id: vip_group["id"], assignee_id: sam["id"] } },
+      headers: owner_headers,
+      as: :json
+    assert_response :ok
+
+    # Merge t_dup into t_main with public source_comment containing searchable keyword and private target_comment containing secret keyword
+    post "/api/v1/tickets/#{t_dup.id}/merge",
+      params: {
+        merge: {
+          target_id: t_main.id,
+          source_comment: { body: "Merged public keyword_alpha", public: true },
+          target_comment: { body: "Merged private secret_omega", public: false }
+        }
+      },
+      headers: owner_headers,
+      as: :json
+    assert_response :ok
+    merge_source_json = json_body.fetch("source")
+    merge_target_json = json_body.fetch("target")
+
+    # Merge response matches GET /api/v1/tickets/:id exactly
+    get "/api/v1/tickets/#{t_dup.id}", headers: owner_headers
+    assert_response :ok
+    assert_equal merge_source_json, json_body.fetch("ticket")
+
+    get "/api/v1/tickets/#{t_main.id}", headers: owner_headers
+    assert_response :ok
+    assert_equal merge_target_json, json_body.fetch("ticket")
+
+    # Combined filters on GET /api/v1/tickets with status=closed
+    get "/api/v1/tickets",
+      params: {
+        status: "closed",
+        priority: "high",
+        group_id: vip_group["id"],
+        assignee_id: sam["id"],
+        requester_id: unverified_customer.id,
+        q: "keyword_alpha"
+      },
+      headers: owner_headers
+    assert_response :ok
+    assert_equal [t_dup.id], json_body.fetch("tickets").map { |t| t["id"] }
+
+    # Private merge note is NOT matched by q search
+    get "/api/v1/tickets", params: { q: "secret_omega" }, headers: owner_headers
+    assert_response :ok
+    assert_equal [], json_body.fetch("tickets")
+
+    # Cancelled account rejects merge with 403 Forbidden
+    post "/api/v1/account/cancel", headers: owner_headers
+    assert_response :ok
+
+    cancelled_owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/tickets/#{t_main.id}/merge",
+      params: { merge: { target_id: t_dup.id } },
+      headers: auth_headers("acme", cancelled_owner_token),
+      as: :json
+    assert_response :forbidden
+  end
+end
