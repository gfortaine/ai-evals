--- /dev/null
+++ b/test/integration/ticket_merging_test.rb
@@ -0,0 +1,876 @@
+require "test_helper"
+require "rake"
+
+class TicketMergingTest < ActionDispatch::IntegrationTest
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  INGRESS_PASSWORD = "test-inbound-secret-password"
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @orig_env = %w[
+      HELPDESK_FRONTEND_URL
+      HELPDESK_MAIL_FROM
+      HELPDESK_SUPPORT_DOMAIN
+      RAILS_INBOUND_EMAIL_PASSWORD
+    ].index_with { |k| ENV[k] }
+
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+    ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = INGRESS_PASSWORD
+  end
+
+  teardown do
+    @orig_env.each do |k, v|
+      v.nil? ? ENV.delete(k) : ENV[k] = v
+    end
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def extract_token(mail)
+    uri = URI.parse(mail.body.decoded[%r{https?://[^\s"<>]+}])
+    URI.decode_www_form(uri.query).to_h.fetch("token")
+  end
+
+  def relay_auth_header(username: "actionmailbox", password: INGRESS_PASSWORD)
+    ActionController::HttpAuthentication::Basic.encode_credentials(username, password)
+  end
+
+  def post_inbound_raw(raw_rfc822, auth: relay_auth_header, content_type: "message/rfc822")
+    headers = {}
+    headers["Authorization"] = auth if auth
+    headers["Content-Type"] = content_type if content_type
+    post RELAY_PATH, params: raw_rfc822, headers: headers
+  end
+
+  def build_raw_email(
+    from: "Avery Stone <avery@example.test>",
+    to: "acme@support.example.test",
+    cc: nil,
+    subject: "Need help with order",
+    body: "My package arrived damaged.",
+    message_id: "<#{SecureRandom.uuid}@example.test>",
+    extra_headers: {}
+  )
+    mail = Mail.new
+    mail.from = from if from
+    mail.to = to if to
+    mail.cc = cc if cc
+    mail.subject = subject unless subject.nil?
+    mail.message_id = message_id if message_id
+    extra_headers.each { |k, v| mail[k] = v }
+    mail.body = body unless body.nil?
+    mail.to_s
+  end
+
+  def setup_business!(subdomain: "acme", name: "Acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: { name: admin_name, email: email, password: password }
+        }
+      },
+      as: :json
+    assert_response :created
+    owner = json_body.fetch("user")
+    token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+    ActionMailer::Base.deliveries.clear
+    owner
+  end
+
+  def invite_and_accept_staff!(subdomain:, owner_headers:, email:, name:, role: "agent", password: "staff-password")
+    post "/api/v1/invitations",
+      params: { invitation: { email: email, role: role } },
+      headers: owner_headers,
+      as: :json
+    assert_response :created
+    token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: token, name: name, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    json_body.fetch("user")
+  end
+
+  def register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    post "/api/v1/registrations",
+      params: { user: { name: name, email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    token = extract_token(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+    user = json_body.fetch("user")
+    ActionMailer::Base.deliveries.clear
+    user
+  end
+
+  def sign_in!(subdomain:, email:, password:)
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    json_body.dig("session", "token")
+  end
+
+  def auth_headers(subdomain, token)
+    {
+      "X-Helpdesk-Account" => subdomain,
+      "Authorization" => "Bearer #{token}"
