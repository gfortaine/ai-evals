@@ -0,0 +1,65 @@
+module Api
+  module V1
+    class InvitationsController < BaseController
+      before_action :authenticate_user!
+      before_action :require_active_account!
+      before_action :require_admin!
+      before_action :load_invitation!, only: [:show, :resend, :destroy]
+
+      def index
+        scope = current_account.invitations.ordered
+
+        if params.key?(:status) && !params[:status].nil? && params[:status] != ""
+          status = scalar_string(params[:status])
+          unless status && Invitation::STATUSES.include?(status)
+            render json: {
+              error: "Status is not included in the list",
+              errors: { status: ["is not included in the list"] }
+            }, status: :unprocessable_content
+            return
+          end
+          scope = scope.with_status(status)
+        end
+
+        render json: paginate(scope, resource_key: :invitations, &:as_api_json), status: :ok
+      end
+
+      def show
+        render json: { invitation: @invitation.as_api_json }, status: :ok
+      end
+
+      def create
+        invitation_params = require_object_param(:invitation)
+
+        invitation = Invitation.issue!(
+          account: current_account,
+          invited_by: current_user,
+          email: scalar_string(invitation_params[:email]),
+          role: scalar_string(invitation_params[:role])
+        )
+
+        render json: { invitation: invitation.as_api_json }, status: :created
+      end
+
+      def resend
+        @invitation.resend!
+        render json: { invitation: @invitation.as_api_json }, status: :ok
+      end
+
+      def destroy
+        @invitation.revoke!
+        render json: { invitation: @invitation.as_api_json }, status: :ok
+      end
+
+      private
+
+      def load_invitation!
+        id = parse_record_id(params[:id])
+        @invitation = id && current_account.invitations.find_by(id: id)
+        return if @invitation
+
+        render json: { error: "Invitation not found" }, status: :not_found
+      end
+    end
+  end
+end
