+    post "/api/v1/invitations",
+      params: { invitation: { email: "shared@example.test", role: "admin" } },
+      headers: globex_headers,
+      as: :json
+    assert_response :created
+
+    # Globex cannot inspect/resend/revoke Acme invitation or user
+    get "/api/v1/invitations/#{acme_inv_id}", headers: globex_headers
+    assert_response :not_found
+
+    post "/api/v1/invitations/#{acme_inv_id}/resend", headers: globex_headers
+    assert_response :not_found
+
+    delete "/api/v1/invitations/#{acme_inv_id}", headers: globex_headers
+    assert_response :not_found
+
+    acme_owner_id = Account.find_by!(subdomain: "acme").owner_id
+    get "/api/v1/users/#{acme_owner_id}", headers: globex_headers
+    assert_response :not_found
+
+    patch "/api/v1/users/#{acme_owner_id}",
+      params: { user: { suspended: true } },
+      headers: globex_headers,
+      as: :json
+    assert_response :not_found
+
+    # Cannot preview or accept Acme token under Globex
+    post "/api/v1/invitation_previews",
+      params: { invitation_preview: { token: acme_q["token"] } },
+      headers: { "X-Helpdesk-Account" => "globex" },
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: acme_q["token"], name: "Shared", password: "shared-password" } },
+      headers: { "X-Helpdesk-Account" => "globex" },
+      as: :json
+    assert_response :unprocessable_content
+
+    # Malformed payloads never 500
+    post "/api/v1/invitations", params: { invitation: "bad" }, headers: acme_headers, as: :json
+    assert_response :bad_request
+
+    post "/api/v1/invitation_previews", params: { invitation_preview: ["bad"] }, headers: { "X-Helpdesk-Account" => "acme" }, as: :json
+    assert_response :bad_request
+
+    post "/api/v1/invitation_acceptances", params: { invitation_acceptance: "bad" }, headers: { "X-Helpdesk-Account" => "acme" }, as: :json
+    assert_response :bad_request
+
+    patch "/api/v1/users/#{acme_owner_id}", params: { user: "bad" }, headers: acme_headers, as: :json
+    assert_response :bad_request
+
+    patch "/api/v1/users/#{acme_owner_id}", params: { user: { suspended: "not-bool" } }, headers: acme_headers, as: :json
+    assert_response :unprocessable_content
+
+    # Cancel Acme -> blocks invitation preview/acceptance and people endpoints; 90-day purge removes invitations too
+    acme_id = Account.find_by!(subdomain: "acme").id
+    post "/api/v1/account/cancel", headers: acme_headers
+    assert_response :ok
+
+    post "/api/v1/invitation_previews",
+      params: { invitation_preview: { token: acme_q["token"] } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :forbidden
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: acme_q["token"], name: "Shared", password: "shared-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :forbidden
+
+    Rails.application.load_tasks if Rake::Task.tasks.empty?
+    travel 90.days + 1.second do
+      Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+      Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+
+      assert_not Account.exists?(acme_id)
+      assert_equal 0, Invitation.where(account_id: acme_id).count
+      assert Account.find_by(subdomain: "globex").present?
+    end
+  end
+end
