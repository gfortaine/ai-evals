diff --git a/app/controllers/api/v1/users_controller.rb b/app/controllers/api/v1/users_controller.rb
new file mode 100644
index 0000000..36ce03e
--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,67 @@
+module Api
+  module V1
+    class UsersController < BaseController
+      before_action :authenticate_user!
+      before_action :require_active_account!
+      before_action :require_admin!
+      before_action :load_user!, only: [:show, :update]
+
+      def index
+        scope = current_account.users.ordered
+
+        if params.key?(:role) && !params[:role].nil? && params[:role] != ""
+          role = scalar_string(params[:role])
+          unless role && User::ROLES.include?(role)
+            render json: {
+              error: "Role is not included in the list",
+              errors: { role: ["is not included in the list"] }
+            }, status: :unprocessable_content
+            return
+          end
+          scope = scope.where(role: role)
+        end
+
+        if params.key?(:suspended) && !params[:suspended].nil? && params[:suspended] != ""
+          suspended = extract_query_boolean(params[:suspended])
+          if suspended == :invalid
+            render json: {
+              error: "Suspended is not included in the list",
+              errors: { suspended: ["is not included in the list"] }
+            }, status: :unprocessable_content
+            return
+          end
+          scope = scope.where(suspended: suspended)
+        end
+
+        render json: paginate(scope, resource_key: :users, &:as_api_json), status: :ok
+      end
+
+      def show
+        render json: { user: @user.as_api_json }, status: :ok
+      end
+
+      def update
+        user_params = require_object_param(:user)
+        has_suspended = user_params.key?(:suspended)
+        suspended_value = extract_boolean_param(user_params, :suspended, default: nil)
+
+        @user.apply_admin_update!(
+          has_suspended: has_suspended,
+          suspended_value: suspended_value
+        )
+
+        render json: { user: @user.as_api_json }, status: :ok
+      end
+
+      private
+
+      def load_user!
+        id = parse_record_id(params[:id])
+        @user = id && current_account.users.find_by(id: id)
+        return if @user
+
+        render json: { error: "User not found" }, status: :not_found
+      end
+    end
+  end
+end
