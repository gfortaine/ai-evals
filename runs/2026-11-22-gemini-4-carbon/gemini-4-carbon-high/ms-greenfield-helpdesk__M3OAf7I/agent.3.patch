+class TeamAndCollaborationEdgeCasesTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @orig_frontend_url = ENV["HELPDESK_FRONTEND_URL"]
+    @orig_mail_from = ENV["HELPDESK_MAIL_FROM"]
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  teardown do
+    @orig_frontend_url ? ENV["HELPDESK_FRONTEND_URL"] = @orig_frontend_url : ENV.delete("HELPDESK_FRONTEND_URL")
+    @orig_mail_from ? ENV["HELPDESK_MAIL_FROM"] = @orig_mail_from : ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def extract_link_params(mail, expected_path)
+    uri = URI.parse(mail.body.decoded[%r{https?://[^\s"<>]+}])
+    assert_equal expected_path, uri.path
+    [uri, URI.decode_www_form(uri.query).to_h]
+  end
+
+  test "expired invite claimed by customer cannot be resent; custom frontend URL/mail from; pagination and invalid param types" do
+    ENV["HELPDESK_FRONTEND_URL"] = "https://desk.example.org/"
+    ENV["HELPDESK_MAIL_FROM"] = "team@desk.example.org"
+
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Acme",
+          subdomain: "acme",
+          admin: { name: "Jo", email: "jo@acme.test", password: "my-first-password" }
+        }
+      },
+      as: :json
+    assert_response :created
+    _u, verify_q = extract_link_params(ActionMailer::Base.deliveries.last, "/verify-email")
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: verify_q["token"] } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    owner_token = json_body.dig("session", "token")
+    owner_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+
+    post "/api/v1/invitations",
+      params: { invitation: { email: "claimable@example.test", role: "agent" } },
+      headers: owner_headers,
+      as: :json
+    assert_response :created
+    exp_inv_id = json_body.dig("invitation", "id")
+
+    invite_mail = ActionMailer::Base.deliveries.last
+    assert_equal ["team@desk.example.org"], invite_mail.from
+    uri, q = extract_link_params(invite_mail, "/accept-invitation")
+    assert_equal "https://desk.example.org", "#{uri.scheme}://#{uri.host}"
+    assert_equal "acme", q["account"]
+
+    travel 8.days do
+      # Customer CAN register with an expired invite's email
+      post "/api/v1/registrations",
+        params: { user: { name: "Claimer", email: "claimable@example.test", password: "customer-password" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+      assert_response :created
+      _cu, cq = extract_link_params(ActionMailer::Base.deliveries.last, "/verify-email")
+
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: cq["token"] } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+      assert_response :ok
+
+      # Resending that expired invitation now fails because a user took the email
+      ActionMailer::Base.deliveries.clear
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        post "/api/v1/invitations/#{exp_inv_id}/resend", headers: owner_headers
+        assert_response :unprocessable_content
+      end
+
+      # Creating 2 staff users to test pagination on /invitations, /users, and /staff
+      2.times do |i|
+        post "/api/v1/invitations",
+          params: { invitation: { email: "staff#{i}@acme.test", role: "agent" } },
+          headers: owner_headers,
+          as: :json
+        assert_response :created
+        _su, sq = extract_link_params(ActionMailer::Base.deliveries.last, "/accept-invitation")
+        post "/api/v1/invitation_acceptances",
+          params: { invitation_acceptance: { token: sq["token"], name: "Staff #{i}", password: "staff-password" } },
+          headers: { "X-Helpdesk-Account" => "acme" },
+          as: :json
+        assert_response :created
+      end
+
+      get "/api/v1/invitations", params: { page: 1, per_page: 2 }, headers: owner_headers
+      assert_response :ok
+      assert_equal 3, json_body["count"]
+      assert_equal 2, json_body.fetch("invitations").size
+      assert_equal 2, json_body["next_page"]
+
+      get "/api/v1/users", params: { page: 1, per_page: 2 }, headers: owner_headers
+      assert_response :ok
+      assert_equal 4, json_body["count"]
+      assert_equal 2, json_body.fetch("users").size
+      assert_equal 2, json_body["next_page"]
+
+      get "/api/v1/staff", params: { page: 1, per_page: 2 }, headers: owner_headers
+      assert_response :ok
+      assert_equal 3, json_body["count"]
+      assert_equal 2, json_body.fetch("staff").size
+      assert_equal 2, json_body["next_page"]
+
+      # Open a ticket as Claimer and test invalid assignee_id and public comment types
+      post "/api/v1/sessions",
+        params: { session: { email: "claimable@example.test", password: "customer-password" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+      claimer_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{json_body.dig("session", "token")}" }
+
+      post "/api/v1/requests",
+        params: { request: { subject: "Edge ticket", comment: { body: "Edge body" } } },
+        headers: claimer_headers,
+        as: :json
+      assert_response :created
+      ticket_id = json_body.dig("request", "id")
+      req_before = json_body.fetch("request")
+
+      [true, false, 0, -5, ["arr"], { bad: 1 }, 99_999_999_999_999_999_999_999_999].each do |bad_assignee|
+        patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { assignee_id: bad_assignee } },
+          headers: owner_headers,
+          as: :json
+        assert_response :unprocessable_content
+      end
+
+      ["not-bool", nil, ["arr"]].each do |bad_public|
+        patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { comment: { body: "Note", public: bad_public } } },
+          headers: owner_headers,
+          as: :json
+        assert_response :unprocessable_content
+      end
+
+      # Passing same status ("open") alongside private note still does not change customer-facing request
+      travel 3.minutes
+      patch "/api/v1/tickets/#{ticket_id}",
+        params: { ticket: { comment: { body: "Private note with unchanged status", public: false }, status: "open" } },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+
+      get "/api/v1/requests/#{ticket_id}", headers: claimer_headers
+      assert_response :ok
+      assert_equal req_before, json_body.fetch("request")
+    end
+  end
+end
