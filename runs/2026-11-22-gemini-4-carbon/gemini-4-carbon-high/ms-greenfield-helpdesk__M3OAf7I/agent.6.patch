+
+  sam = invite_and_accept_staff!(subdomain: "acme", owner_headers: owner_headers, email: "sam@acme.test", name: "Sam", role: "agent")
+
+  # Missing/unknown account header and missing/bad bearer token on groups and group_memberships
+  get "/api/v1/groups"
+  assert_response :bad_request
+
+  get "/api/v1/groups", headers: { "X-Helpdesk-Account" => "nonexistent" }
+  assert_response :not_found
+
+  get "/api/v1/groups", headers: { "X-Helpdesk-Account" => "acme" }
+  assert_response :unauthorized
+
+  get "/api/v1/group_memberships", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer invalid" }
+  assert_response :unauthorized
+
+  # Create groups and add Sam using string IDs
+  post "/api/v1/groups", params: { group: { name: "Billing" } }, headers: owner_headers, as: :json
+  billing = json_body.fetch("group")
+  post "/api/v1/groups", params: { group: { name: "Support" } }, headers: owner_headers, as: :json
+  support = json_body.fetch("group")
+
+  post "/api/v1/group_memberships",
+    params: { group_membership: { group_id: billing["id"].to_s, user_id: sam["id"].to_s, default: true } },
+    headers: owner_headers,
+    as: :json
+  assert_response :created
+  m1 = json_body.fetch("group_membership")
+
+  post "/api/v1/group_memberships",
+    params: { group_membership: { group_id: support["id"].to_s, user_id: sam["id"].to_s } },
+    headers: owner_headers,
+    as: :json
+  assert_response :created
+  m2 = json_body.fetch("group_membership")
+
+  # Pagination on group_memberships filtered by user_id
+  get "/api/v1/group_memberships", params: { user_id: sam["id"], page: 1, per_page: 1 }, headers: owner_headers
+  assert_response :ok
+  assert_equal 2, json_body["count"]
+  assert_equal 2, json_body["next_page"]
+  assert_equal [m1["id"]], json_body.fetch("group_memberships").map { |m| m["id"] }
+
+  get "/api/v1/group_memberships", params: { user_id: sam["id"], page: 2, per_page: 1 }, headers: owner_headers
+  assert_response :ok
+  assert_equal [m2["id"]], json_body.fetch("group_memberships").map { |m| m["id"] }
+
+  # Inbound email opens an ungrouped ticket; routing + public reply + customer email reply preserves group and assignee
+  raw_email = <<~MAIL
+    From: Email Customer <emailer@example.test>
+    To: acme@support.example.test
+    Subject: Email billing issue
+    Message-ID: <email-group-1@example.test>
+    Content-Type: text/plain; charset=UTF-8
+
+    Need help with billing invoice #999
+  MAIL
+
+  post "/rails/action_mailbox/relay/inbound_emails",
+    params: raw_email,
+    headers: {
+      "Content-Type" => "message/rfc822",
+      "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("actionmailbox", "test-inbound-secret")
+    }
+  assert_response :no_content
+  ActionMailer::Base.deliveries.clear
+
+  get "/api/v1/tickets", params: { group_id: "unassigned" }, headers: owner_headers
+  assert_response :ok
+  assert_equal 1, json_body["count"]
