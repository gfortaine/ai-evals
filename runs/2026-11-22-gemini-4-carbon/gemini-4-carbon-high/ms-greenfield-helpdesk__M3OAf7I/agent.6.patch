+++ b/app/controllers/api/v1/group_memberships_controller.rb
@@ -0,0 +1,81 @@
+module Api
+  module V1
+    class GroupMembershipsController < BaseController
+      before_action :authenticate_user!
+      before_action :require_active_account!
+      before_action :require_staff!, only: [:index, :show]
+      before_action :require_admin!, only: [:create, :destroy, :make_default]
+      before_action :load_group_membership!, only: [:show, :destroy, :make_default]
+
+      def index
+        scope = current_account.group_memberships.ordered
+
+        if params.key?(:group_id) && !params[:group_id].nil? && params[:group_id] != ""
+          group_id = parse_record_id(params[:group_id])
+          unless group_id
+            render json: {
+              error: "Group is invalid",
+              errors: { group_id: ["is invalid"] }
+            }, status: :unprocessable_content
+            return
+          end
+          scope = scope.where(group_id: group_id)
+        end
+
+        if params.key?(:user_id) && !params[:user_id].nil? && params[:user_id] != ""
+          user_id = parse_record_id(params[:user_id])
+          unless user_id
+            render json: {
+              error: "User is invalid",
+              errors: { user_id: ["is invalid"] }
+            }, status: :unprocessable_content
+            return
+          end
+          scope = scope.where(user_id: user_id)
+        end
+
+        render json: paginate(scope, resource_key: :group_memberships, &:as_api_json), status: :ok
+      end
+
+      def show
+        render json: { group_membership: @group_membership.as_api_json }, status: :ok
+      end
+
+      def create
+        membership_params = require_object_param(:group_membership)
+        has_default = membership_params.key?(:default)
+        default_value = extract_boolean_param(membership_params, :default, default: false)
+
+        membership = GroupMembership.add_member!(
+          account: current_account,
+          raw_group_id: membership_params[:group_id],
+          raw_user_id: membership_params[:user_id],
+          has_default: has_default,
+          default_value: default_value
+        )
+
+        render json: { group_membership: membership.as_api_json }, status: :created
+      end
+
+      def make_default
+        @group_membership.make_default!
+        render json: { group_membership: @group_membership.as_api_json }, status: :ok
+      end
+
+      def destroy
+        @group_membership.destroy_with_cleanup!
+        head :no_content
+      end
+
+      private
+
+      def load_group_membership!
+        id = parse_record_id(params[:id])
+        @group_membership = id && current_account.group_memberships.find_by(id: id)
+        return if @group_membership
+
+        render json: { error: "Group membership not found" }, status: :not_found
+      end
+    end
+  end
+end
