@@ -0,0 +1,1148 @@
+require "test_helper"
+require "rake"
+
+class GroupsAndRoutingTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  def json_body
+    JSON.parse(response.body)
+  end
+
+  def extract_link_params(mail, expected_path)
+    body = mail.body.decoded
+    match = body.match(%r{(https?://[^\s"<>]+)})
+    assert match, "Expected URL in email body, got: #{body.inspect}"
+    uri = URI.parse(match[1])
+    assert_equal expected_path, uri.path
+    [uri, URI.decode_www_form(uri.query).to_h]
+  end
+
+  def setup_business!(subdomain: "acme", name: "Acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: { name: admin_name, email: email, password: password }
+        }
+      },
+      as: :json
+    assert_response :created
+    owner = json_body.fetch("user")
+    _uri, query = extract_link_params(ActionMailer::Base.deliveries.last, "/verify-email")
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: query.fetch("token") } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+    ActionMailer::Base.deliveries.clear
+    owner
+  end
+
+  def invite_and_accept_staff!(subdomain:, owner_headers:, email:, name:, role:, password: "staff-password")
+    post "/api/v1/invitations",
+      params: { invitation: { email: email, role: role } },
+      headers: owner_headers,
+      as: :json
+    assert_response :created
+    _uri, query = extract_link_params(ActionMailer::Base.deliveries.last, "/accept-invitation")
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: query.fetch("token"), name: name, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    json_body.fetch("user")
+  end
+
+  def register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test", password: "my-customer-password")
+    post "/api/v1/registrations",
+      params: { user: { name: name, email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    _uri, query = extract_link_params(ActionMailer::Base.deliveries.last, "/verify-email")
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: query.fetch("token") } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+    user = json_body.fetch("user")
+    ActionMailer::Base.deliveries.clear
+    user
+  end
+
+  def sign_in!(subdomain:, email:, password:)
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    json_body.dig("session", "token")
+  end
+
+  def auth_headers(subdomain, token)
+    {
+      "X-Helpdesk-Account" => subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+
+  test "group CRUD, rename, ID ascending order, pagination, uniqueness, and role permissions" do
+    setup_business!(subdomain: "acme", name: "Acme", admin_name: "Jo", email: "jo@acme.test")
+    setup_business!(subdomain: "globex", name: "Globex", admin_name: "Gus", email: "gus@globex.test")
+
+    owner_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password"))
+    globex_headers = auth_headers("globex", sign_in!(subdomain: "globex", email: "gus@globex.test", password: "my-first-password"))
+
+    alex = invite_and_accept_staff!(subdomain: "acme", owner_headers: owner_headers, email: "alex@acme.test", name: "Alex", role: "admin")
+    sam = invite_and_accept_staff!(subdomain: "acme", owner_headers: owner_headers, email: "sam@acme.test", name: "Sam", role: "agent")
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    alex_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "alex@acme.test", password: "staff-password"))
+    sam_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "sam@acme.test", password: "staff-password"))
+    avery_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password"))
+
+    # Admin creates groups; whitespace is stripped
+    post "/api/v1/groups",
+      params: { group: { name: "  Billing  " } },
+      headers: owner_headers,
+      as: :json
+    assert_response :created
+    billing = json_body.fetch("group")
+    assert_kind_of Integer, billing["id"]
+    assert_equal "Billing", billing["name"]
+    assert billing["created_at"].present?
+    assert billing["updated_at"].present?
+
+    # Second admin can also create groups
+    post "/api/v1/groups",
+      params: { group: { name: "Technical Support" } },
+      headers: alex_headers,
+      as: :json
+    assert_response :created
+    tech_support = json_body.fetch("group")
+    assert_operator tech_support["id"], :>, billing["id"]
+
+    post "/api/v1/groups",
+      params: { group: { name: "Enterprise Onboarding" } },
+      headers: owner_headers,
+      as: :json
+    assert_response :created
+    onboarding = json_body.fetch("group")
+
+    # Case-insensitive duplicate group name in same account fails, while other account can use same name
+    post "/api/v1/groups",
+      params: { group: { name: "billing" } },
+      headers: owner_headers,
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/groups",
+      params: { group: { name: "Billing" } },
+      headers: globex_headers,
+      as: :json
+    assert_response :created
+
+    # Rename group via PATCH (including case-only rename on itself, then full rename)
+    patch "/api/v1/groups/#{billing["id"]}",
+      params: { group: { name: "BILLING" } },
+      headers: owner_headers,
+      as: :json
+    assert_response :ok
+    assert_equal "BILLING", json_body.dig("group", "name")
+
+    travel 1.minute do
+      patch "/api/v1/groups/#{billing["id"]}",
+        params: { group: { name: "Accounts & Billing" } },
+        headers: alex_headers,
+        as: :json
+      assert_response :ok
+      assert_equal "Accounts & Billing", json_body.dig("group", "name")
+    end
+
+    # Cannot rename to another existing group's name
+    patch "/api/v1/groups/#{onboarding["id"]}",
+      params: { group: { name: "technical support" } },
+      headers: owner_headers,
+      as: :json
+    assert_response :unprocessable_content
+
+    # Staff (both admin and agent) can list groups in ID ascending order (even after billing was updated later!) and inspect detail
+    get "/api/v1/groups", headers: sam_headers
+    assert_response :ok
+    assert_equal 3, json_body["count"]
+    assert_equal [billing["id"], tech_support["id"], onboarding["id"]], json_body.fetch("groups").map { |g| g["id"] }
+    assert_equal ["Accounts & Billing", "Technical Support", "Enterprise Onboarding"], json_body.fetch("groups").map { |g| g["name"] }
+
+    # Pagination on /groups
+    get "/api/v1/groups", params: { page: 1, per_page: 2 }, headers: sam_headers
+    assert_response :ok
+    assert_equal 3, json_body["count"]
+    assert_equal 2, json_body["next_page"]
+    assert_equal [billing["id"], tech_support["id"]], json_body.fetch("groups").map { |g| g["id"] }
+
+    get "/api/v1/groups/#{tech_support["id"]}", headers: sam_headers
+    assert_response :ok
+    assert_equal "Technical Support", json_body.dig("group", "name")
+
+    # Agent cannot create, rename, or delete groups; customer cannot even browse groups
+    post "/api/v1/groups", params: { group: { name: "VIP" } }, headers: sam_headers, as: :json
+    assert_response :forbidden
+
+    patch "/api/v1/groups/#{billing["id"]}", params: { group: { name: "Hacked" } }, headers: sam_headers, as: :json
+    assert_response :forbidden
+
+    delete "/api/v1/groups/#{onboarding["id"]}", headers: sam_headers
+    assert_response :forbidden
+
+    get "/api/v1/groups", headers: avery_headers
+    assert_response :forbidden
+
+    get "/api/v1/groups/#{billing["id"]}", headers: avery_headers
+    assert_response :forbidden
+
+    post "/api/v1/groups", params: { group: { name: "CustGroup" } }, headers: avery_headers, as: :json
+    assert_response :forbidden
+
+    # Admin deletes onboarding group
+    delete "/api/v1/groups/#{onboarding["id"]}", headers: owner_headers
+    assert_response :no_content
+
+    get "/api/v1/groups/#{onboarding["id"]}", headers: owner_headers
+    assert_response :not_found
+
+    get "/api/v1/groups", headers: sam_headers
+    assert_response :ok
+    assert_equal [billing["id"], tech_support["id"]], json_body.fetch("groups").map { |g| g["id"] }
+  end
+
+  test "group memberships, default invariant, make_default, ID ascending order, and group_id/user_id filters" do
+    owner = setup_business!(subdomain: "acme", name: "Acme", admin_name: "Jo", email: "jo@acme.test")
+    setup_business!(subdomain: "globex", name: "Globex", admin_name: "Gus", email: "gus@globex.test")
+    globex_owner = Account.find_by!(subdomain: "globex").users.first
+
+    owner_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password"))
+    globex_headers = auth_headers("globex", sign_in!(subdomain: "globex", email: "gus@globex.test", password: "my-first-password"))
+
+    sam = invite_and_accept_staff!(subdomain: "acme", owner_headers: owner_headers, email: "sam@acme.test", name: "Sam", role: "agent")
+    alex = invite_and_accept_staff!(subdomain: "acme", owner_headers: owner_headers, email: "alex@acme.test", name: "Alex", role: "agent")
+    avery = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    sam_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "sam@acme.test", password: "staff-password"))
+    avery_headers = auth_headers("acme", sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password"))
+
+    post "/api/v1/groups", params: { group: { name: "Billing" } }, headers: owner_headers, as: :json
+    billing = json_body.fetch("group")
+    post "/api/v1/groups", params: { group: { name: "Technical Support" } }, headers: owner_headers, as: :json
+    support = json_body.fetch("group")
+    post "/api/v1/groups", params: { group: { name: "Security" } }, headers: owner_headers, as: :json
+    security = json_body.fetch("group")
+
+    post "/api/v1/groups", params: { group: { name: "Globex Group" } }, headers: globex_headers, as: :json
+    globex_group = json_body.fetch("group")
+
+    # First membership for Sam (without default param) automatically gets default: true
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: billing["id"], user_id: sam["id"] } },
+      headers: owner_headers,
+      as: :json
+    assert_response :created
+    sam_billing = json_body.fetch("group_membership")
+    assert_equal billing["id"], sam_billing["group_id"]
+    assert_equal sam["id"], sam_billing["user_id"]
+    assert_equal true, sam_billing["default"]
+
+    # First membership for Alex even with default: false still becomes default: true (every staff with memberships has one default)
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: billing["id"], user_id: alex["id"], default: false } },
+      headers: owner_headers,
+      as: :json
+    assert_response :created
+    alex_billing = json_body.fetch("group_membership")
+    assert_equal true, alex_billing["default"]
+
+    # Duplicate membership in same group is rejected
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: billing["id"], user_id: sam["id"] } },
+      headers: owner_headers,
+      as: :json
+    assert_response :unprocessable_content
+
+    # Customer, cross-account user, or cross-account group cannot be added
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: billing["id"], user_id: avery["id"] } },
+      headers: owner_headers,
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: billing["id"], user_id: globex_owner.id } },
+      headers: owner_headers,
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: globex_group["id"], user_id: sam["id"] } },
+      headers: owner_headers,
+      as: :json
+    assert_response :unprocessable_content
+
+    # Second membership for Sam without default stays default: false, leaving Billing as default
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: support["id"], user_id: sam["id"] } },
+      headers: owner_headers,
+      as: :json
+    assert_response :created
+    sam_support = json_body.fetch("group_membership")
+    assert_equal false, sam_support["default"]
+
+    # Third membership for Sam with default: true switches Sam's default to Security (without affecting Alex's default!)
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: security["id"], user_id: sam["id"], default: true } },
+      headers: owner_headers,
+      as: :json
+    assert_response :created
+    sam_security = json_body.fetch("group_membership")
+    assert_equal true, sam_security["default"]
+
+    get "/api/v1/group_memberships", params: { user_id: sam["id"] }, headers: sam_headers
+    assert_response :ok
+    assert_equal [sam_billing["id"], sam_support["id"], sam_security["id"]], json_body.fetch("group_memberships").map { |m| m["id"] }
+    assert_equal [false, false, true], json_body.fetch("group_memberships").map { |m| m["default"] }
+
+    get "/api/v1/group_memberships/#{alex_billing["id"]}", headers: sam_headers
+    assert_response :ok
+    assert_equal true, json_body.dig("group_membership", "default")
+
+    # Admin switches Sam's default to Support via PUT /api/v1/group_memberships/:id/make_default
+    put "/api/v1/group_memberships/#{sam_support["id"]}/make_default", headers: owner_headers
+    assert_response :ok
+    assert_equal true, json_body.dig("group_membership", "default")
+
