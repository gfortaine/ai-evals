+  assert_nil email_ticket["group_id"]
+  assert_nil email_ticket["group"]
+
+  # Assign using string group_id + assignee_id
+  patch "/api/v1/tickets/#{t_id}",
+    params: { ticket: { group_id: billing["id"].to_s, assignee_id: sam["id"].to_s } },
+    headers: owner_headers,
+    as: :json
+  assert_response :ok
+  assigned_updated_at = json_body.dig("ticket", "updated_at")
+  assert_equal billing["id"], json_body.dig("ticket", "group_id")
+  assert_equal sam["id"], json_body.dig("ticket", "assignee_id")
+
+  # Setting the exact same group_id is a no-op and preserves updated_at and assignee_id
+  travel 2.minutes do
+    patch "/api/v1/tickets/#{t_id}",
+      params: { ticket: { group_id: billing["id"] } },
+      headers: owner_headers,
+      as: :json
+    assert_response :ok
+    assert_equal assigned_updated_at, json_body.dig("ticket", "updated_at")
+    assert_equal sam["id"], json_body.dig("ticket", "assignee_id")
+  end
+
+  # Staff sends public reply -> customer replies by email -> group_id and assignee_id remain intact!
+  patch "/api/v1/tickets/#{t_id}",
+    params: { ticket: { status: "pending", comment: { body: "Please confirm your address", public: true } } },
+    headers: owner_headers,
+    as: :json
+  assert_response :ok
+  reply_to_addr = Array(ActionMailer::Base.deliveries.last.reply_to).first
+  assert reply_to_addr.present?
+
+  customer_reply = <<~MAIL
+    From: Email Customer <emailer@example.test>
+    To: #{reply_to_addr}
+    Subject: Re: Email billing issue
+    Message-ID: <email-group-2@example.test>
+    Content-Type: text/plain; charset=UTF-8
+
+    Confirmed!
+  MAIL
+
+  post "/rails/action_mailbox/relay/inbound_emails",
+    params: customer_reply,
+    headers: {
+      "Content-Type" => "message/rfc822",
+      "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("actionmailbox", "test-inbound-secret")
+    }
+  assert_response :no_content
+
+  get "/api/v1/tickets/#{t_id}", headers: owner_headers
+  assert_response :ok
+  assert_equal "open", json_body.dig("ticket", "status")
+  assert_equal billing["id"], json_body.dig("ticket", "group_id")
+  assert_equal sam["id"], json_body.dig("ticket", "assignee_id")
+
+  # PUT full-object update with group_id: nil and Jo (who has no group memberships) succeeds
+  put "/api/v1/tickets/#{t_id}",
+    params: { ticket: { status: "open", priority: "high", group_id: nil, assignee_id: owner["id"] } },
+    headers: owner_headers,
+    as: :json
+  assert_response :ok
+  assert_nil json_body.dig("ticket", "group_id")
+  assert_equal owner["id"], json_body.dig("ticket", "assignee_id")
+ensure
+  ENV.delete("RAILS_INBOUND_EMAIL_PASSWORD")
+end
+end
