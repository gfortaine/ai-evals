diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..425761f
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,284 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @card = cards(:text)
+  end
+
+  test "card without a burst is not stalled after two weeks of inactivity" do
+    freeze_time
+
+    travel 3.weeks
+
+    assert_not @card.bursted?
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "card gets a burst from three comments by at least two people within a third of board auto-close period" do
+    freeze_time
+    @board.update!(auto_postpone_period: 30.days) # 1/3 = 10 days
+
+    @card.comments.create!(body: "First", creator: users(:david))
+
+    travel 5.days
+    @card.comments.create!(body: "Second", creator: users(:kevin))
+    assert_not @card.bursted?
+
+    travel 5.days # exactly 10 days after first comment
+    @card.comments.create!(body: "Third", creator: users(:david))
+    assert @card.bursted?
+    assert_not @card.stalled?
+
+    travel 2.weeks - 1.second
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 1.second
+    assert @card.stalled?
+    assert_equal 14, @card.stalled_for_days
+    assert_includes Card.stalled, @card
+    assert_includes Card.indexed_by("stalled"), @card
+  end
+
+  test "comments spread beyond a third of board auto-close period do not trigger a burst" do
+    freeze_time
+    @board.update!(auto_postpone_period: 30.days) # 1/3 = 10 days
+
+    @card.comments.create!(body: "First", creator: users(:david))
+
+    travel 5.days
+    @card.comments.create!(body: "Second", creator: users(:kevin))
+
+    travel 5.days + 1.second # 10 days + 1 second since first comment
+    @card.comments.create!(body: "Third", creator: users(:david))
+
+    assert_not @card.bursted?
+
+    travel 3.weeks
+    assert_not @card.stalled?
+  end
+
+  test "comment burst uses account default auto-close period when board has no override" do
+    freeze_time
+    entropies(:writebook_board).destroy
+    entropies("37s_account").update!(auto_postpone_period: 30.days) # 1/3 = 10 days
+
+    card = @board.cards.create!(title: "Default entropy card", status: :published)
+    card.comments.create!(body: "First", creator: users(:david))
+
+    travel 6.days
+    card.comments.create!(body: "Second", creator: users(:kevin))
+
+    travel 4.days
+    card.comments.create!(body: "Third", creator: users(:jz))
+
+    assert card.bursted?
+  end
+
+  test "comment burst respects non-divisible-by-3 day auto-close periods like 11 days" do
+    freeze_time
+    @board.update!(auto_postpone_period: 11.days) # 1/3 = 88 hours
+
+    @card.comments.create!(body: "First", creator: users(:david))
+    travel 44.hours
+    @card.comments.create!(body: "Second", creator: users(:kevin))
+    travel 44.hours
+    @card.comments.create!(body: "Third", creator: users(:david))
+
+    assert @card.bursted?
+  end
+
+  test "three comments from a single person do not trigger a burst until a second person comments in window" do
+    freeze_time
+    @board.update!(auto_postpone_period: 30.days) # 1/3 = 10 days
+
+    3.times do |i|
+      @card.comments.create!(body: "Solo #{i}", creator: users(:david))
+    end
+
+    assert_not @card.bursted?
+
+    travel 2.days
+    @card.comments.create!(body: "Joining in", creator: users(:kevin))
+
+    assert @card.bursted?
+  end
+
+  test "system comments do not count toward comment burst" do
+    freeze_time
+    @board.update!(auto_postpone_period: 30.days)
+
+    @card.update!(title: "Changed title once")
+    @card.update!(title: "Changed title twice")
+    @card.comments.create!(body: "Only one real user comment", creator: users(:david))
+
+    assert_operator @card.comments.count, :>=, 3
+    assert_not @card.bursted?
+  end
+
+  test "assigning someone gives the card a burst" do
+    freeze_time
+
+    @card.toggle_assignment(users(:kevin))
+
+    assert @card.bursted?
+    assert_not @card.stalled?
+
+    travel 2.weeks
+    assert @card.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "reopening a closed card gives it a burst" do
+    freeze_time
+    closed_card = cards(:shipping)
+    assert closed_card.closed?
+    assert_not closed_card.bursted?
+
+    closed_card.reopen
+
+    assert closed_card.bursted?
+    assert_not closed_card.stalled?
+
+    travel 2.weeks
+    assert closed_card.stalled?
+    assert_includes Card.stalled, closed_card
+  end
+
+  test "closed postponed and drafted cards are not stalled" do
+    freeze_time
+
+    @card.toggle_assignment(users(:kevin))
+    travel 3.weeks
+    assert @card.stalled?
+
+    @card.close
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.reopen
+    travel 3.weeks
+    assert @card.stalled?
+
+    @card.postpone
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    draft = @board.cards.create!(title: "Draft")
+    draft.toggle_assignment(users(:kevin))
+    travel 3.weeks
+    assert_not draft.stalled?
+    assert_not_includes Card.stalled, draft
+  end
+
+  test "any activity on a stalled card resets it" do
+    freeze_time
+
+    @card.toggle_assignment(users(:kevin))
+    travel 15.days
+    assert @card.stalled?
+
+    # Single comment resets it
+    comment = @card.comments.create!(body: "Bumping this", creator: users(:david))
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    # Stalls again after another two weeks of no activity
+    travel 14.days
+    assert @card.stalled?
+
+    # Editing comment resets it
+    comment.update!(body: "Updated comment")
+    assert_not @card.reload.stalled?
+
+    # Title update resets it
+    travel 14.days
+    assert @card.stalled?
+    @card.update!(title: "Updated title")
+    assert_not @card.reload.stalled?
+
+    # Description update resets it
+    travel 14.days
+    assert @card.stalled?
+    @card.update!(description: "Updated description")
+    assert_not @card.reload.stalled?
+
+    # Step creation, update, and deletion reset it
+    travel 14.days
+    assert @card.stalled?
+    step = @card.steps.create!(content: "First step")
+    assert_not @card.reload.stalled?
+
+    travel 14.days
+    assert @card.stalled?
+    step.update!(completed: true)
+    assert_not @card.reload.stalled?
+
+    travel 14.days
+    assert @card.stalled?
+    step.destroy!
+    assert_not @card.reload.stalled?
+
+    # Tagging resets it
+    travel 14.days
+    assert @card.stalled?
+    @card.toggle_tag_with("urgent")
+    assert_not @card.reload.stalled?
+
+    # Reaction resets it
+    travel 14.days
+    assert @card.stalled?
+    reaction = @card.reactions.create!(content: "👍")
+    assert_not @card.reload.stalled?
+
+    travel 14.days
+    assert @card.stalled?
+    reaction.destroy!
+    assert_not @card.reload.stalled?
+
+    # Triage resets it
+    travel 14.days
+    assert @card.stalled?
+    @card.triage_into(columns(:writebook_triage))
+    assert_not @card.reload.stalled?
+
+    # Gilding resets it
+    travel 14.days
+    assert @card.stalled?
+    @card.gild
+    assert_not @card.reload.stalled?
+
+    # Unassigning resets it
+    travel 14.days
+    assert @card.stalled?
+    @card.toggle_assignment(users(:kevin))
+    assert_not @card.reload.stalled?
+  end
+
+  test "reading watching and pinning a stalled card do not reset it" do
+    freeze_time
+
+    @card.toggle_assignment(users(:kevin))
+    travel 15.days
+    assert @card.stalled?
+
+    @card.read_by(users(:david))
+    @card.watch_by(users(:jz))
+    @card.unwatch_by(users(:jz))
+    @card.pin_by(users(:david))
+    @card.unpin_by(users(:david))
+
+    assert @card.reload.stalled?
+  end
+
+test "destroying card or incinerating account removes burst records" do
+  @card.toggle_assignment(users(:kevin))
+  burst_id = @card.burst.id
+
+  @card.destroy!
+  assert_not Card::Burst.exists?(burst_id)
+end
+end
