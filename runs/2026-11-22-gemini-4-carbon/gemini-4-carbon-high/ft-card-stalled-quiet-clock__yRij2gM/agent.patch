@@ -0,0 +1,48 @@
+require "application_system_test_case"
+
+class StalledCardsSystemTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:buy_domain)
+  end
+
+  test "stalled card displays bubble across views and resets on activity" do
+    Current.set(session: sessions(:david)) do
+      @card.toggle_assignment(users(:kevin))
+      @card.update!(last_active_at: 15.days.ago)
+    end
+
+    visit cards_url(indexed_by: "stalled")
+    assert_selector "##{dom_id(@card, :bubble)}", text: /Stalled for\s*15\s*days/i
+
+    visit board_url(@card.board)
+    assert_selector "##{dom_id(@card, :bubble)}", text: /Stalled for\s*15\s*days/i
+
+    visit card_url(@card)
+    assert_selector "##{dom_id(@card, :bubble)}", text: /Stalled for\s*15\s*days/i
+
+    within "##{dom_id(@card, :new_comment)}" do
+      fill_in_lexxy with: "Back on track"
+      click_button "Post"
+    end
+
+    assert_text "Back on track"
+    assert_no_selector "##{dom_id(@card, :bubble)}", visible: true
+
+    visit cards_url(indexed_by: "stalled")
+    assert_no_text @card.title
+  end
+
+  test "stalled card bubble works under time travel in browser" do
+    Current.set(session: sessions(:david)) do
+      @card.toggle_assignment(users(:kevin))
+    end
+
+    travel 16.days do
+      visit card_url(@card)
+      assert_selector "##{dom_id(@card, :bubble)}", text: /Stalled for\s*16\s*days/i
+    end
+  end
+end
