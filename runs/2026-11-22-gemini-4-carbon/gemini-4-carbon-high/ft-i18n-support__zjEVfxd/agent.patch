+require "application_system_test_case"
+
+class SystemLocaleTest < ApplicationSystemTestCase
+  test "client-side dates, navigation, and clean-browser persistence work in Japanese" do
+    sign_in_as(users(:david))
+
+    # Default is exact English with English client-side local-time formatting
+    visit card_url(cards(:logo))
+    assert_selector "span", text: "Mark as Done"
+    assert_no_text "完了にする"
+
+    # Switch to Japanese via ?locale=ja and verify client-side JS dates & UI
+    visit card_url(cards(:logo), locale: "ja")
+    assert_selector "span", text: "完了にする"
+    assert_selector "time", text: /(今日|昨日|\d+日前|\d+月\d+日)/
+
+    # Unsupported locale does not break or switch away from Japanese
+    visit board_url(boards(:writebook), locale: "xx")
+    assert_selector "h2", text: "未定"
+    assert_selector "span", text: "カードを追加"
+
+    # Signing in from a clean browser restores Japanese automatically
+    Capybara.using_session("clean_browser") do
+      sign_in_as(users(:david))
+      assert_selector "span", text: "ボードを追加"
+      assert_selector "time", text: /(今日|昨日|\d+日前|\d+月\d+日)/
+    end
+  end
+end
