+        get new_signup_completion_path
+        assert_response :success
+        audit_japanese_html("signups/completions/new", response.body, fixture_strings, findings)
+      end
+
+      # Verify every mailer renders in Japanese for Kevin even when invoked while I18n.locale is :en
+      identities(:kevin).reload
+      users(:kevin).reload
+      I18n.with_locale(:en) do
+        magic_link = identities(:kevin).magic_links.create!(purpose: :sign_in, code: "ABC123")
+        ml = MagicLinkMailer.sign_in_instructions(magic_link)
+        assert_equal "Fizzyの確認コードは ABC123 です", ml.subject
+        assert_includes ml.text_part.body.to_s, "15分"
+        audit_japanese_html("mailer/magic_link", ml.html_part.body.to_s, fixture_strings, findings)
+
+        export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+        ex = ExportMailer.completed(export)
+        assert_equal "Fizzyのデータエクスポートのダウンロード準備ができました", ex.subject
+        audit_japanese_html("mailer/export", ex.html_part.body.to_s, fixture_strings, findings)
+
+        im_ok = ImportMailer.completed(identities(:kevin), accounts("37s"))
+        assert_equal "Fizzyアカウントのインポートが完了しました", im_ok.subject
+        audit_japanese_html("mailer/import_completed", im_ok.html_part.body.to_s, fixture_strings, findings)
+
+        import_rec = Account::Import.create!(account: accounts("37s"), identity: identities(:kevin), status: :failed, failure_reason: :invalid_export)
+        im_fail = ImportMailer.failed(import_rec)
+        assert_equal "Fizzyアカウントのインポートに失敗しました", im_fail.subject
+        audit_japanese_html("mailer/import_failed", im_fail.html_part.body.to_s, fixture_strings, findings)
+
+        um = UserMailer.email_change_confirmation(email_address: "new@example.com", token: "TOK", user: users(:kevin))
+        assert_equal "新しいメールアドレスの確認", um.subject
+        audit_japanese_html("mailer/user_email_change", um.body.to_s, fixture_strings, findings)
+
+        users(:kevin).notifications.destroy_all
+        Notification.create!(user: users(:kevin), creator: users(:david), source: events(:logo_published), account: accounts("37s"))
+        bundle = Notification::Bundle.create!(user: users(:kevin), starts_at: Time.utc(2025, 3, 15, 9, 0, 0), ends_at: Time.utc(2025, 3, 15, 16, 0, 0))
+        bm = Notification::BundleMailer.notification(bundle)
+        assert_includes bm.subject, "新しい通知"
+        assert_includes bm.html_part.body.to_s, "3月15日(土) 午前9時以降の通知"
+        assert_includes bm.text_part.body.to_s, "3月15日(土) 午前9時以降の通知"
+        audit_japanese_html("mailer/bundle", bm.html_part.body.to_s, fixture_strings, findings)
+
+        cancellation = accounts("37s").build_cancellation(initiated_by: users(:kevin))
+        am = AccountMailer.cancellation(cancellation)
+        assert_equal "Fizzyアカウントが解約されました", am.subject
+        assert_includes am.text_part.body.to_s, "約1か月"
+        audit_japanese_html("mailer/account_cancellation", am.html_part.body.to_s, fixture_strings, findings)
+      end
