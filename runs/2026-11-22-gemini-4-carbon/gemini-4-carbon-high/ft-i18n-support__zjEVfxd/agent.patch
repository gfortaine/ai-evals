diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..7c62140
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,86 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :set_current_locale
+
+    helper_method :locale_chosen?
+
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def set_current_locale(&block)
+      locale = resolve_current_locale
+      Current.session_locale = available_locale(session[:locale])
+      I18n.with_locale(locale, &block)
+    end
+
+    def resolve_current_locale
+      identity = authenticated_identity_for_locale
+
+      if requested_locale = available_locale(params[:locale])
+        persist_requested_locale(requested_locale, identity)
+        requested_locale
+      elsif identity
+        sync_pending_locale_for(identity)
+        identity.preferred_locale || available_locale(session[:locale]) || I18n.default_locale
+      else
+        available_locale(session[:locale]) || I18n.default_locale
+      end
+    end
+
+    def authenticated_identity_for_locale
+      Current.identity || find_session_by_cookie&.identity
+    end
+
+    def persist_requested_locale(locale, identity)
+      session[:locale] = locale
+
+      if identity
+        identity.update_locale(locale)
+        session.delete(:pending_locale)
+      else
+        session[:pending_locale] = locale
+      end
+    end
+
+    def sync_pending_locale_for(identity)
+      if pending_locale = available_locale(session.delete(:pending_locale))
+        identity.update_locale(pending_locale)
+      end
+    end
+
+    def sync_session_locale_on_sign_in(identity)
+      if pending_locale = available_locale(session.delete(:pending_locale))
+        identity.update_locale(pending_locale)
+        session[:locale] = pending_locale
+      elsif identity.preferred_locale
+        session[:locale] = identity.preferred_locale
+      else
+        session.delete(:locale)
+      end
+
+      Current.session_locale = available_locale(session[:locale])
+      I18n.locale = Current.session_locale || I18n.default_locale
+    end
+
+    def apply_bearer_identity_locale(identity)
+      if requested_locale = available_locale(params[:locale])
+        identity.update_locale(requested_locale)
+      elsif identity.preferred_locale
+        I18n.locale = identity.preferred_locale
+      end
+    end
+
+    def available_locale(value)
+      value if value.is_a?(String) && I18n.locale_available?(value)
+    end
+
+    def locale_chosen?
+      available_locale(params[:locale]).present? ||
+        available_locale(session[:locale]).present? ||
+        Current.identity&.preferred_locale.present?
+    end
+end
