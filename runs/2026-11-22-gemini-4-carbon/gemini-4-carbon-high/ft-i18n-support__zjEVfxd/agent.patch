diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..0be5454
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,332 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  ALLOWED_ENGLISH = [
+    "37signals", "Fizzy", "Basecamp", "HEY", "Jason Fried", "jason@37signals.com", "support@fizzy.do",
+    "fizzy.do", "https://example.com", "http://example.com", "ABC123", "Campfire", "Mozilla", "Apple", "CEO",
+    "ESC", "OK", "QR", "ZIP", ".zip", "API", "PIN", "OS", "URL", "HTTPS", "HTTP", "RE:",
+    "X-Webhook-Signature", "HMAC", "SHA256", "GitHub", "MacBook Pro", "iPhone",
+    "Chrome", "Google Chrome", "Safari", "Firefox", "Edge", "Linux", "Windows", "Android", "iOS", "macOS", "Web", "Dock",
+    "Ctrl", "Shift", "Enter", "Return", "Meta", "shift+g", "shift+p", "shift+n", "esc"
+  ].freeze
+
+  READABLE_ATTRS = %w[
+    aria-label
+    aria-description
+    placeholder
+    title
+    alt
+    data-turbo-confirm
+    data-bridge-title
+    data-bridge-share-description
+    data-combobox-default-label-value
+    data-combobox-label
+    data-multi-selection-combobox-no-selection-label-value
+    data-multi-selection-combobox-label-prefix-value
+    data-multi-selection-combobox-label
+    data-boards-form-self-removal-prompt-message-value
+    data-validation-message
+    data-touch-placeholder-placeholder-value
+    data-text
+  ].freeze
+
+  test "people who never chose a locale get English even with Japanese Accept-Language header" do
+    sign_in_as :kevin
+
+    get root_path, headers: { "Accept-Language" => "ja,en-US;q=0.9" }
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_select "a.header__skip-navigation", "Skip to main content"
+  end
+
+  test "opening any page with ?locale=ja switches for the session and sticks on clean browser sign-in" do
+    sign_in_as :kevin
+
+    get board_path(boards(:writebook), locale: "ja")
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select "a.header__skip-navigation", "メインコンテンツへスキップ"
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    # Sticks for the rest of the session without ?locale
+    get root_path
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select "span", "ボードを追加"
+
+    # Sticks after sign-out for the remainder of the browser session
+    sign_out
+    untenanted do
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang='ja']"
+      assert_select "h1", "Fizzyにサインイン"
+    end
+
+    # Sticks when signing in from a brand-new clean browser
+    clean_browser = open_session
+    clean_browser.default_url_options[:script_name] = integration_session.default_url_options[:script_name]
+
+    perform_enqueued_jobs do
+      clean_browser.post session_path(script_name: ""), params: { email_address: identities(:kevin).email_address }
+    end
+
+    # Even the magic link email sent during clean-browser sign-in is in Japanese
+    magic_email = ActionMailer::Base.deliveries.last
+    assert_includes magic_email.subject, "Fizzyの確認コードは"
+
+    magic_link = identities(:kevin).magic_links.order(id: :desc).first
+    clean_browser.post session_magic_link_url(script_name: ""), params: { code: magic_link.code }
+
+    clean_browser.get root_path
+    assert_equal 200, clean_browser.response.status
+    clean_doc = Nokogiri::HTML5(clean_browser.response.body)
+    assert_equal "ja", clean_doc.at_css("html")["lang"]
+    assert_includes clean_doc.text, "メインコンテンツへスキップ"
+  end
+
+  test "choosing ?locale=ja before signing in sticks in session and persists to identity upon sign-in" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_select "html[lang='ja']"
+      assert_select "h1", "Fizzyにサインイン"
+
+      ActionMailer::Base.deliveries.clear
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identities(:david).email_address }
+      end
+
+      magic_email = ActionMailer::Base.deliveries.last
+      assert_includes magic_email.subject, "Fizzyの確認コードは"
+
+      magic_link = identities(:david).magic_links.order(id: :desc).first
+      post session_magic_link_url, params: { code: magic_link.code }
+    end
+
+    assert_equal "ja", identities(:david).reload.locale
+
+    get root_path
+    assert_response :success
+    assert_select "html[lang='ja']"
+  end
+
+  test "unsupported or malformed locale parameter never breaks a page and does not switch anything" do
+    untenanted do
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_select "html[lang='en']"
+      assert_select "h1", "Get into Fizzy"
+    end
+
+    sign_in_as :kevin
+    get root_path(locale: "xx")
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_nil identities(:kevin).reload.locale
+
+    # Once switched to Japanese, ?locale=xx keeps Japanese without breaking
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_select "html[lang='ja']"
+
+    get card_path(cards(:logo), locale: "xx")
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    get card_path(cards(:logo), locale: "")
+    assert_response :success
+    assert_select "html[lang='ja']"
+
+    get card_path(cards(:logo), locale: [ "xx" ])
+    assert_response :success
+    assert_select "html[lang='ja']"
+  end
+
+  test "fragment caches are isolated by locale" do
+    with_actionview_partial_caching do
+      sign_in_as :kevin
+      get card_path(cards(:shipping))
+      assert_response :success
+      assert_includes response.body, "Done"
+
+      get card_path(cards(:shipping), locale: "ja")
+      assert_response :success
+      assert_includes response.body, "完了"
+      assert_not_includes response.body, "Card number"
+      assert_includes response.body, "カード番号"
+    end
+  end
+
+  test "every screen, screen-reader label, server date, and email renders in Japanese with no hardcoded English" do
+    findings = []
+
+    travel_to Time.utc(2025, 3, 15, 14, 30, 0) do
+      boards(:writebook).publish unless boards(:writebook).published?
+      pub_key = boards(:writebook).publication.key
+
+      sign_in_as :kevin
+      get root_path(locale: "ja")
+      assert_response :success
+
+      # Verify closed stamp date is formatted in Japanese on card screen
+      get card_path(cards(:shipping))
+      assert_response :success
+      assert_match(/\d{4}年\d{1,2}月\d{1,2}日/, response.body)
+
+      screens = [
+        [ "events/index", root_path ],
+        [ "boards/show", board_path(boards(:writebook)) ],
+        [ "boards/edit", edit_board_path(boards(:writebook)) ],
+        [ "boards/new", new_board_path ],
+        [ "boards/columns/stream", board_columns_stream_path(boards(:writebook)) ],
+        [ "boards/columns/not_now", board_columns_not_now_path(boards(:writebook)) ],
+        [ "boards/columns/closed", board_columns_closed_path(boards(:writebook)) ],
