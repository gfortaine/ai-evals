@@ -0,0 +1,27 @@
+class Stripe::WebhooksController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthenticated_access
+  skip_forgery_protection
+  skip_before_action :ensure_only_employees_can_access_non_production_remote_environments, raise: false
+
+  def create
+    event = construct_stripe_event
+    Account::Subscription.sync_from_stripe_event(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def construct_stripe_event
+      Stripe::Webhook.construct_event(
+        request.raw_post,
+        request.headers["Stripe-Signature"].to_s,
+        webhook_secret
+      )
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"] || ("test_webhook_secret" if Rails.env.test?)
+    end
+end
