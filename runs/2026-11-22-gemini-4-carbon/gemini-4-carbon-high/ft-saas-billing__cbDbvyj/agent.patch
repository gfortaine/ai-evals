index 0000000..75b6753
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "defaults to Free plan" do
+    assert_equal Plan.free, @account.plan
+    assert @account.free?
+    assert_not @account.paid?
+    assert_nil @account.active_subscription
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "Unlimited subscription updates plan and storage allowance to 5 GB" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_unlimited",
+      stripe_subscription_id: "sub_unlimited",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    assert_equal Plan.unlimited, @account.plan
+    assert @account.paid?
+    assert_not @account.free?
+    assert_not_nil @account.active_subscription
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "Unlimited+ subscription updates plan and storage allowance to 500 GB" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_plus",
+      stripe_subscription_id: "sub_plus",
+      plan_key: "monthly_extra_storage_v1",
+      status: "active"
+    )
+
+    assert_equal Plan.unlimited_plus, @account.plan
+    assert @account.paid?
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "canceled subscription falls back to Free plan and 1 GB storage" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_canceled",
+      stripe_subscription_id: "sub_canceled",
+      plan_key: "monthly_extra_storage_v1",
+      status: "canceled"
+    )
+
+    assert_equal Plan.free, @account.plan
+    assert_nil @account.active_subscription
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comp and uncomp toggle billing waiver" do
+    assert_not @account.comped?
+
+    @account.comp
+    assert @account.reload.comped?
+    assert_not @account.free?
+
+    @account.uncomp
+    assert_not @account.reload.comped?
+    assert @account.free?
+  end
+
+  test "canceling account enqueues job to cancel active Stripe subscription" do
+    subscription = @account.create_subscription!(
+      stripe_customer_id: "cus_cancel_acct",
+      stripe_subscription_id: "sub_cancel_acct",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    Stripe::Subscription.expects(:cancel).with("sub_cancel_acct").returns(true)
+
+    with_multi_tenant_mode(true) do
+      perform_enqueued_jobs only: Account::CancelSubscriptionJob do
+        @account.cancel(initiated_by: users(:mike))
+      end
+    end
+
+    assert_equal "canceled", subscription.reload.status
+  end
+end
diff --git a/saas/test/models/account/limited_test.rb b/saas/test/models/account/limited_test.rb
new file mode 100644
index 0000000..d611dca
--- /dev/null
+++ b/saas/test/models/account/limited_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Account::LimitedTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "card_count counts published cards and ignores drafts" do
+    assert_equal 2, @account.card_count
+  end
+
+  test "override_limits overrides card_count and bytes_used and reset drops override" do
+    @account.override_limits(card_count: 950, bytes_used: 2.gigabytes)
+
+    assert_equal 950, @account.card_count
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+    assert @account.exceeding_storage_limit?
+
+    @account.reset_overridden_limits
+    @account.reload
+
+    assert_nil @account.overridden_limits
+    assert_equal 2, @account.card_count
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "override_limits supports zero values and partial overrides" do
+    @account.override_limits(card_count: 0, bytes_used: nil)
+    assert_equal 0, @account.card_count
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "card limit countdown boundaries from 100 cards out" do
+    @account.override_limits(card_count: 899)
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.override_limits(card_count: 900)
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+    assert_not @account.exceeding_card_limit?
+
+    @account.override_limits(card_count: 950)
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+
+    @account.override_limits(card_count: 999)
+    assert @account.nearing_card_limit?
+    assert_equal 1, @account.cards_remaining
+    assert_not @account.exceeding_card_limit?
+
+    @account.override_limits(card_count: 1_000)
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "paid plans and comped accounts do not hit card limits and get plan storage allowance" do
+    @account.override_limits(card_count: 2_000, bytes_used: 3.gigabytes)
+    assert @account.exceeding_card_limit?
+    assert @account.exceeding_storage_limit?
+
+    @account.comp
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_storage_limit?
+
+    @account.uncomp
+    @account.reload
+    assert @account.exceeding_card_limit?
+
+    @account.create_subscription!(
+      stripe_customer_id: "cus_paid",
+      stripe_subscription_id: "sub_paid",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_storage_limit?
+
+    @account.override_limits(card_count: 2_000, bytes_used: 6.gigabytes)
+    assert @account.exceeding_storage_limit?
+
+    @account.subscription.update!(plan_key: "monthly_extra_storage_v1")
+    assert_not @account.exceeding_storage_limit?
+  end
+end
diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
