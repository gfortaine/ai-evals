diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..344d2bf
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "admins see their plan and Upgrade in settings" do
+    sign_in_as :kevin
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".settings__section", text: /Free/
+    assert_select "a[href='#{saas.account_subscription_path(script_name: @account.slug)}']", text: "Upgrade"
+  end
+
+  test "owner sees subscription cancellation warning in delete account dialog when subscribed" do
+    sign_in_as :jason
+
+    with_multi_tenant_mode(true) do
+      get account_settings_path(script_name: @account.slug)
+      assert_no_match "Your subscription will be canceled.", response.body
+
+      @account.create_subscription!(
+        stripe_customer_id: "cus_owner",
+        stripe_subscription_id: "sub_owner",
+        plan_key: "monthly_v1",
+        status: "active"
+      )
+
+      get account_settings_path(script_name: @account.slug)
+      assert_match "Your subscription will be canceled.", response.body
+      assert_select ".settings__section", text: /Unlimited/
+    end
+  end
+
+  test "non-admin members do not see Upgrade in settings and cannot access subscription endpoints" do
+    sign_in_as :jz
+
+    get account_settings_path(script_name: @account.slug)
+    assert_response :success
+    assert_select "a", text: "Upgrade", count: 0
+
+    get saas.account_subscription_path(script_name: @account.slug)
+    assert_response :forbidden
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "monthly_v1" }
+    assert_response :forbidden
+  end
+
+  test "subscription page displays approved pricing plans" do
+    sign_in_as :kevin
+
+    get saas.account_subscription_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_match "Free", response.body
+    assert_match "1,000 cards, 1 GB", response.body
+    assert_match "Unlimited", response.body
+    assert_match "$20/month, 5 GB", response.body
+    assert_match "Unlimited+", response.body
+    assert_match "$25/month, 500 GB", response.body
+  end
+
+  test "creates Stripe Checkout session and redirects to hosted checkout" do
+    sign_in_as :kevin
+
+    fake_session = stub(url: "https://checkout.stripe.com/c/pay/cs_test_unlimited", customer: nil)
+    Stripe::Checkout::Session.expects(:create).with(
+      has_entries(
+        mode: "subscription",
+        line_items: [ { price: Plan.unlimited_plus.stripe_price_id, quantity: 1 } ],
+        client_reference_id: @account.id
+      )
+    ).returns(fake_session)
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "monthly_extra_storage_v1" }
+
+    assert_response :see_other
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_unlimited"
+  end
+
+  test "creates Stripe Customer Portal session and redirects to hosted portal" do
+    sign_in_as :kevin
+
+    @account.create_subscription!(
+      stripe_customer_id: "cus_portal_123",
+      stripe_subscription_id: "sub_portal_123",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    fake_portal = stub(url: "https://billing.stripe.com/p/session/bps_test_123")
+    Stripe::BillingPortal::Session.expects(:create).with(
+      has_entries(customer: "cus_portal_123")
+    ).returns(fake_portal)
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_response :see_other
+    assert_redirected_to "https://billing.stripe.com/p/session/bps_test_123"
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..bbe0245
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "requires staff access" do
+    untenanted do
+      get saas.admin_accounts_path
+      assert_redirected_to new_session_path
+    end
+
+    sign_in_as :jz
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :forbidden
+
+      get saas.admin_account_path(@account)
+      assert_response :forbidden
+
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_response :forbidden
+
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: 500 } }
+      assert_response :forbidden
+    end
+  end
+
+  test "index lists accounts with links opening each account page" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :success
+    Account.find_each do |account|
+      assert_select "a[href='#{saas.admin_account_path(account, script_name: nil)}']", text: account.name
+    end
+  end
+
+  test "account page supports Comp and Uncomp" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "button", text: "Comp"
+      assert_select "button", text: "Uncomp", count: 0
+
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+      assert @account.reload.comped?
+
+      follow_redirect!
+      assert_select "button", text: "Uncomp"
+      assert_select "button", text: "Comp", count: 0
+
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+      assert_not @account.reload.comped?
+    end
+  end
+
+  test "account page supports overriding Card count and Bytes used and Reset drops the override" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "button", text: "Override"
+      assert_select "button", text: "Reset"
+
+      patch saas.admin_account_overridden_limits_path(@account), params: {
+        overridden_limits: { card_count: "950", bytes_used: "2147483648" }
+      }
+      assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+
+      @account.reload
+      assert_equal 950, @account.card_count
+      assert_equal 2_147_483_648, @account.bytes_used
+
+      delete saas.admin_account_overridden_limits_path(@account)
+      assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+
+      @account.reload
+      assert_nil @account.overridden_limits
+      assert_equal 2, @account.card_count
+      assert_equal 0, @account.bytes_used
+    end
+  end
+end
diff --git a/saas/test/controllers/card/limited/creation_test.rb b/saas/test/controllers/card/limited/creation_test.rb
new file mode 100644
index 0000000..d6e36c1
--- /dev/null
+++ b/saas/test/controllers/card/limited/creation_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Card::Limited::CreationTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @account.update_column(:cards_count, 100)
+    sign_in_as :mike
+  end
+
+  test "free account that runs out of cards can still draft via HTML" do
+    @account.override_limits(card_count: 1_000)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count }, 1 do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "refuses creating through the JSON API when free account runs out of cards" do
+    @account.override_limits(card_count: 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "API Card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "refuses creating through the Bearer token API when free account runs out of cards" do
+    sign_out
+    account = accounts(:"37s")
+    account.override_limits(card_count: 1_000)
+    token = identity_access_tokens(:davids_api_token).token
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:writebook), script_name: account.slug),
+        params: { card: { title: "Token API Card" } },
+        headers: { "Authorization" => "Bearer #{token}" },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "allows creating through the JSON API when subscribed" do
+    @account.override_limits(card_count: 1_000)
+    @account.create_subscription!(
+      stripe_customer_id: "cus_api",
+      stripe_subscription_id: "sub_api",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    assert_difference -> { Card.count }, 1 do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "Paid API Card" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+end
