@@ -0,0 +1,23 @@
+class Account::BillingPortalsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_account
+
+  def create
+    if @account.subscription&.stripe_customer_id.present?
+      portal_session = Stripe::BillingPortal::Session.create(
+        @account.stripe_portal_session_params(
+          return_url: account_settings_url(script_name: @account.slug)
+        )
+      )
+
+      redirect_to portal_session.url, allow_other_host: true, status: :see_other
+    else
+      redirect_to saas.account_subscription_path(script_name: @account.slug)
+    end
+  end
+
+  private
+    def set_account
+      @account = Current.account
+    end
+end
diff --git a/saas/app/controllers/account/subscriptions_controller.rb b/saas/app/controllers/account/subscriptions_controller.rb
new file mode 100644
index 0000000..2d332f3
--- /dev/null
+++ b/saas/app/controllers/account/subscriptions_controller.rb
@@ -0,0 +1,37 @@
+class Account::SubscriptionsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_account
+
+  def show
+    @plans = Plan.all
+  end
+
+  def create
+    if plan = selected_paid_plan
+      checkout_session = Stripe::Checkout::Session.create(
+        @account.stripe_checkout_session_params(
+          plan: plan,
+          success_url: account_settings_url(script_name: @account.slug),
+          cancel_url: saas.account_subscription_url(script_name: @account.slug),
+          customer_email: Current.identity.email_address
+        )
+      )
+      @account.record_stripe_customer_from_checkout(checkout_session)
+
+      redirect_to checkout_session.url, allow_other_host: true, status: :see_other
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  private
+    def set_account
+      @account = Current.account
+    end
+
+    def selected_paid_plan
+      raw_key = params[:plan_key] || params[:plan]
+      plan = raw_key.present? ? Plan.find(raw_key) : Plan.unlimited
+      plan if plan&.paid?
+    end
+end
