@@ -0,0 +1,52 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "approved pricing plans and allowances" do
+    free = Plan.free
+    assert_equal "Free", free.name
+    assert_equal 0, free.price
+    assert_equal 1_000, free.card_limit
+    assert_equal 1.gigabyte, free.storage_limit
+    assert free.free?
+    assert_not free.paid?
+
+    unlimited = Plan.unlimited
+    assert_equal "Unlimited", unlimited.name
+    assert_equal 20, unlimited.price
+    assert unlimited.unlimited_cards?
+    assert_equal 5.gigabytes, unlimited.storage_limit
+    assert unlimited.paid?
+
+    unlimited_plus = Plan.unlimited_plus
+    assert_equal "Unlimited+", unlimited_plus.name
+    assert_equal 25, unlimited_plus.price
+    assert unlimited_plus.unlimited_cards?
+    assert_equal 500.gigabytes, unlimited_plus.storage_limit
+    assert unlimited_plus.paid?
+  end
+
+  test "finds plans by key and aliases" do
+    assert_equal Plan.free, Plan.find("free_v1")
+    assert_equal Plan.free, Plan.find("Free")
+    assert_equal Plan.unlimited, Plan.find("monthly_v1")
+    assert_equal Plan.unlimited, Plan.find("unlimited")
+    assert_equal Plan.unlimited_plus, Plan.find("monthly_extra_storage_v1")
+    assert_equal Plan.unlimited_plus, Plan.find("unlimited_plus")
+    assert_equal Plan.unlimited_plus, Plan.find("Unlimited+")
+    assert_nil Plan.find("unknown")
+  end
+
+  test "reads stripe price ids from environment dynamically" do
+    prev_v1 = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    prev_extra = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_custom_20"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_custom_25"
+
+    assert_equal Plan.unlimited, Plan.find_by_price_id("price_custom_20")
+    assert_equal Plan.unlimited_plus, Plan.find_by_price_id("price_custom_25")
+  ensure
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = prev_v1
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = prev_extra
+  end
+end
