diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..868704a
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,133 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @secret = "whsec_test_webhook_secret"
+    @prev_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    ENV["STRIPE_WEBHOOK_SECRET"] = @secret
+    @account = accounts(:initech)
+  end
+
+  teardown do
+    ENV["STRIPE_WEBHOOK_SECRET"] = @prev_secret
+  end
+
+  test "rejects requests with invalid or missing signature" do
+    payload = { id: "evt_bad", object: "event", type: "customer.subscription.created", data: { object: {} } }.to_json
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: { "CONTENT_TYPE" => "application/json" }
+      assert_response :bad_request
+
+      post "/stripe/webhooks", params: payload, headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "t=123,v1=invalid" }
+      assert_response :bad_request
+    end
+  end
+
+  test "creates and updates subscription from Stripe subscription webhooks" do
+    post_stripe_webhook(
+      type: "customer.subscription.created",
+      object: {
+        id: "sub_live_1",
+        object: "subscription",
+        customer: "cus_live_1",
+        status: "active",
+        current_period_end: 1.month.from_now.to_i,
+        items: {
+          data: [ { price: { id: Plan.unlimited.stripe_price_id, unit_amount: 2000 } } ]
+        },
+        metadata: { account_id: @account.id }
+      }
+    )
+
+    assert_response :ok
+    assert_equal Plan.unlimited, @account.reload.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_equal "cus_live_1", @account.subscription.stripe_customer_id
+    assert_equal "sub_live_1", @account.subscription.stripe_subscription_id
+
+    # Upgrade to Unlimited+
+    post_stripe_webhook(
+      type: "customer.subscription.updated",
+      object: {
+        id: "sub_live_1",
+        object: "subscription",
+        customer: "cus_live_1",
+        status: "active",
+        items: {
+          data: [ { price: { id: Plan.unlimited_plus.stripe_price_id, unit_amount: 2500 } } ]
+        }
+      }
+    )
+
+    assert_response :ok
+    assert_equal Plan.unlimited_plus, @account.reload.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    # Cancel subscription
+    post_stripe_webhook(
+      type: "customer.subscription.deleted",
+      object: {
+        id: "sub_live_1",
+        object: "subscription",
+        customer: "cus_live_1",
+        status: "canceled"
+      }
+    )
+
+    assert_response :ok
+    assert_equal Plan.free, @account.reload.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert @account.subscription.canceled?
+  end
+
+  test "handles checkout.session.completed webhook with forgery protection enabled" do
+    with_forgery_protection do
+      post_stripe_webhook(
+        type: "checkout.session.completed",
+        object: {
+          id: "cs_test_1",
+          object: "checkout.session",
+          mode: "subscription",
+          customer: "cus_checkout_1",
+          subscription: "sub_checkout_1",
+          client_reference_id: @account.id,
+          metadata: { account_id: @account.id, plan_key: "monthly_v1" }
+        }
+      )
+    end
+
+    assert_response :ok
+    assert_equal Plan.unlimited, @account.reload.plan
+    assert_equal "cus_checkout_1", @account.subscription.stripe_customer_id
+    assert_equal "sub_checkout_1", @account.subscription.stripe_subscription_id
+  end
+
+  private
+    def post_stripe_webhook(type:, object:)
+      payload = {
+        id: "evt_#{SecureRandom.hex(6)}",
+        object: "event",
+        type: type,
+        data: { object: object }
+      }.to_json
+
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, @secret)
+      header = Stripe::Webhook::Signature.generate_header(timestamp, signature)
+
+      untenanted do
+        post "/stripe/webhooks",
+          params: payload,
+          headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => header }
+      end
+    end
+
+    def with_forgery_protection
+      original = ActionController::Base.allow_forgery_protection
+      ActionController::Base.allow_forgery_protection = true
+      yield
+    ensure
+      ActionController::Base.allow_forgery_protection = original
+    end
+end
diff --git a/saas/test/integration/billing_flow_test.rb b/saas/test/integration/billing_flow_test.rb
new file mode 100644
index 0000000..9c46db1
--- /dev/null
+++ b/saas/test/integration/billing_flow_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+require "capybara/rails"
+require "capybara/minitest"
+
+class BillingFlowTest < ActionDispatch::IntegrationTest
+  include Capybara::DSL
+  include Capybara::Minitest::Assertions
+
+  setup do
+    Capybara.current_driver = :rack_test
+  end
+
+  teardown do
+    Capybara.reset_sessions!
+    Capybara.use_default_driver
+  end
+
+  test "support admin flow: /admin/accounts, Comp/Uncomp, Override Card count and Bytes used, and Reset" do
+    account = accounts(:initech)
+    capybara_sign_in(identities(:kevin))
+
+    visit "/admin/accounts"
+    assert_text "37signals"
+    assert_text "Initech LLC"
+
+    click_on "Initech LLC"
+    assert_current_path "/admin/accounts/#{account.id}"
+
+    click_on "Comp"
+    assert account.reload.comped?
+    assert_button "Uncomp"
+
+    click_on "Uncomp"
+    assert_not account.reload.comped?
+    assert_button "Comp"
+
+    fill_in "Card count", with: "950"
+    fill_in "Bytes used", with: "104857600"
+    click_on "Override"
+
+    account.reload
+    assert_equal 950, account.card_count
+    assert_equal 104_857_600, account.bytes_used
+
+    click_on "Reset"
+
+    account.reload
+    assert_nil account.overridden_limits
+    assert_equal 2, account.card_count
+    assert_equal 0, account.bytes_used
+  end
+
+  test "card limit countdown, Upgrade pitch on draft, and settings Upgrade flow" do
+    account = accounts(:initech)
+    account.update_column(:cards_count, 100)
+    capybara_sign_in(identities(:mike))
+
+    # Settings shows Free plan and Upgrade
+    visit "#{account.slug}/account/settings"
+    assert_text "Free"
+    assert_link "Upgrade"
+
+    click_on "Upgrade"
+    assert_current_path "#{account.slug}/account/subscription"
+    assert_text "Free"
+    assert_text "1,000 cards, 1 GB"
+    assert_text "Unlimited"
+    assert_text "$20/month, 5 GB"
+    assert_text "Unlimited+"
+    assert_text "$25/month, 500 GB"
+
+    # Countdown warning at 950 cards
+    account.override_limits(card_count: 950)
+    visit "#{account.slug}/cards/#{cards(:unfinished_thoughts).number}/draft"
+    assert_text "50 cards left"
+    assert_button "Create card"
+
+    # Out of cards at 1,000: can still draft, create buttons give way to Upgrade pitch
+    account.override_limits(card_count: 1_000)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+    visit "#{account.slug}/boards/#{boards(:miltons_wish_list).id}"
+    first(:button, "Add a card").click
+
+    assert_current_path %r{#{account.slug}/cards/\d+/draft}
+    assert_no_button "Create card"
+    assert_no_button "Create and add another"
+    assert_link "Upgrade"
+  end
+
+  private
+    def capybara_sign_in(identity)
+      page.driver.put session_transfer_path(identity.transfer_id, script_name: nil)
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
