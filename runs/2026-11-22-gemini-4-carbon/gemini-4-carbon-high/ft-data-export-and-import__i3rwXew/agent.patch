+  test "reader reads deflated and stored entries and streams chunks" do
+    tempfile = Tempfile.new([ "test", ".zip" ])
+    tempfile.binmode
+
+    large_binary = Random.new(42).bytes(200_000)
+
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("docs/hello.txt", "Hello deflated!", compress: true)
+    writer.add_file("bin/data.bin", large_binary, compress: false)
+    writer.close
+    tempfile.flush
+
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+
+    assert reader.exists?("docs/hello.txt")
+    assert_not reader.exists?("docs/missing.txt")
+    assert_equal [ "docs/hello.txt" ], reader.glob("docs/*.txt")
+    assert_equal "Hello deflated!", reader.read("docs/hello.txt")
+
+    reader.open_file("bin/data.bin") do |io|
+      assert_equal large_binary.bytesize, io.size
+      copied = StringIO.new("".b)
+      IO.copy_stream(io, copied)
+      assert_equal large_binary, copied.string
+
+      io.rewind
+      assert_equal large_binary[0, 10], io.read(10)
+    end
+  ensure
+    tempfile&.close!
+  end
+
+  test "reader raises InvalidFileError on invalid zip" do
