+require "test_helper"
+
+class Users::DataExportsControllerTest < ActionDispatch::IntegrationTest
+  test "profile page shows export button only on own profile" do
+    sign_in_as :david
+
+    get user_path(users(:david))
+    assert_response :success
+    assert_select "form[action='#{user_data_exports_path(users(:david))}']"
+
+    get user_path(users(:kevin))
+    assert_response :success
+    assert_select "form[action='#{user_data_exports_path(users(:kevin))}']", count: 0
+  end
+
+  test "another user even admin cannot create or download someone else's profile export" do
+    export = nil
+    perform_enqueued_jobs do
+      export = users(:david).data_exports.create!(account: accounts("37s"))
+    end
+
+    sign_in_as :kevin
+
+    post user_data_exports_path(users(:david))
+    assert_response :forbidden
+
+    get user_data_export_path(users(:david), export)
+    assert_response :forbidden
+
+    get rails_blob_path(export.file, disposition: :attachment)
+    assert_response :forbidden
+  end
+
+  test "member exports accessible cards from profile, gets email link, and link works for a day" do
+    sign_in_as :david
+    ActionMailer::Base.deliveries.clear
+
+    assert_difference -> { User::DataExport.count }, +1 do
+      perform_enqueued_jobs do
+        post user_data_exports_path(users(:david))
+      end
+    end
+    assert_redirected_to user_path(users(:david))
+
+    export = User::DataExport.last
+    assert export.completed?
+
+    email = ActionMailer::Base.deliveries.last
+    assert_not_nil email
+    assert_equal [ identities(:david).email_address ], email.to
+    assert_includes email.text_part.body.to_s, user_data_export_path(users(:david), export, script_name: accounts("37s").slug)
+
+    # Download zip
+    get user_data_export_path(users(:david), export)
+    assert_response :redirect
+    blob_redirect = response.location
+    follow_redirect!
+    follow_redirect! if response.redirect?
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+
+    reader = ZipFile::Reader.new(StringIO.new(response.body))
+    assert reader.exists?("#{cards(:logo).number}.json")
+
+    # Link works within 1 day and expires after 1 day
+    travel 23.hours do
+      get user_data_export_path(users(:david), export)
+      assert_response :redirect
+    end
+
+    travel 25.hours do
+      get user_data_export_path(users(:david), export)
+      assert_response :not_found
+
+      get blob_redirect
+      assert_response :forbidden
+    end
+  end
+end
