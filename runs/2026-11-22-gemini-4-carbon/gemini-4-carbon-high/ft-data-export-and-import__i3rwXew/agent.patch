diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..b8b28cd
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "account settings shows export button to admins" do
+    sign_in_as :kevin
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action='#{account_exports_path}']"
+  end
+
+  test "account settings hides export button from non-admins" do
+    sign_in_as :david
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action='#{account_exports_path}']", count: 0
+  end
+
+  test "non-admin cannot create or download account export" do
+    export = nil
+    perform_enqueued_jobs do
+      export = accounts("37s").exports.create!(user: users(:kevin))
+    end
+
+    sign_in_as :david
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_path
+    end
+    assert_response :forbidden
+
+    get account_export_path(export)
+    assert_response :forbidden
+
+    get rails_blob_path(export.file, disposition: :attachment)
+    assert_response :forbidden
+  end
+
+  test "admin creates account export, receives email with download link, and link works for a day" do
+    sign_in_as :kevin
+    ActionMailer::Base.deliveries.clear
+
+    assert_difference -> { Account::Export.count }, +1 do
+      perform_enqueued_jobs do
+        post account_exports_path
+      end
+    end
+    assert_redirected_to account_settings_path
+
+    export = Account::Export.last
+    assert export.completed?
+
+    email = ActionMailer::Base.deliveries.last
+    assert_not_nil email
+    assert_equal [ identities(:kevin).email_address ], email.to
+    download_link = account_export_url(export, script_name: accounts("37s").slug, host: "example.com")
+    assert_includes email.html_part.body.to_s, account_export_path(export, script_name: accounts("37s").slug)
+    assert_includes email.text_part.body.to_s, download_link
+
+    # Download works now
+    get account_export_path(export)
+    assert_response :redirect
+    blob_redirect = response.location
+    follow_redirect!
+    follow_redirect! if response.redirect?
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+
+    # Link still works at 23 hours for admin
+    travel 23.hours do
+      get account_export_path(export)
+      assert_response :redirect
+    end
+
+    # Link expires after 1 day (both export URL and direct blob URL)
+    travel 25.hours do
+      get account_export_path(export)
+      assert_response :not_found
+
+      get blob_redirect
+      assert_response :forbidden
+    end
+  end
+end
