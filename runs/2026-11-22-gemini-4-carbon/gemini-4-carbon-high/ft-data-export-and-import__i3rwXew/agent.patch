+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account)
+    super(account: account, model: ::Filter)
+  end
+
+  private
+    def records
+      ::Filter.where(account_id: account.id).includes(:tags, :assignees, :creators, :closers)
+    end
+
+    def serialize_record(filter)
+      super.merge(
+        "tag_ids" => filter.tags.ids,
+        "board_ids" => filter.association(:boards).scope.pluck(:id),
+        "assignee_ids" => filter.assignees.ids,
+        "creator_ids" => filter.creators.ids,
+        "closer_ids" => filter.closers.ids
+      )
+    end
+
+    def deserialize_record(data, context)
+      tag_ids = Array(data.delete("tag_ids")).map { |id| context.map_id(id) }
+      board_ids = Array(data.delete("board_ids")).map { |id| context.map_id(id) }
+      assignee_ids = Array(data.delete("assignee_ids")).map { |id| context.map_id(id) }
+      creator_ids = Array(data.delete("creator_ids")).map { |id| context.map_id(id) }
+      closer_ids = Array(data.delete("closer_ids")).map { |id| context.map_id(id) }
+
+      row = super
+      if row["fields"].is_a?(Hash)
+        fields = row["fields"].dup
+        fields["card_ids"] = fields["card_ids"].map { |id| context.map_id(id) } if fields["card_ids"].is_a?(Array)
+        fields["column_ids"] = fields["column_ids"].map { |id| context.map_id(id) } if fields["column_ids"].is_a?(Array)
+        row["fields"] = fields
+      end
+
+      {
