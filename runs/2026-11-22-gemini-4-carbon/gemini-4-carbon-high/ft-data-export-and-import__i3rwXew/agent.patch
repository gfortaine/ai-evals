+      get "/account/imports/new"
+      assert_redirected_to new_session_path(script_name: nil)
+    end
+  end
+
+  test "signed-in user can visit /account/imports/new and round-trip export and import an account" do
+    # 1. Admin exports account
+    sign_in_as :kevin
+    Current.with_account(accounts("37s")) do
+      cards(:logo).image.attach(
+        io: File.open(file_fixture("moon.jpg")),
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+    end
+
+    perform_enqueued_jobs do
+      post account_exports_path
+    end
+
+    export = Account::Export.last
+    get account_export_path(export)
+    follow_redirect!
+    follow_redirect! if response.redirect?
+    assert_response :success
+    zip_bytes = response.body
+
+    tempfile = Tempfile.new([ "exported_account", ".zip" ])
+    tempfile.binmode
+    tempfile.write(zip_bytes)
+    tempfile.rewind
+
+    # 2. Signed-in user visits /account/imports/new and uploads the zip
+    ActionMailer::Base.deliveries.clear
+
+    untenanted do
+      get "/account/imports/new"
+      assert_response :success
+      assert_select "form[action='/account/imports']"
+
+      upload = Rack::Test::UploadedFile.new(tempfile.path, "application/zip")
+
+      assert_difference -> { Account.count }, +1 do
+        perform_enqueued_jobs do
+          post "/account/imports", params: { import: { file: upload } }
+        end
+      end
+
+      import = Account::Import.last
+      assert_redirected_to account_import_path(import, script_name: nil)
+      follow_redirect!
+      assert_response :success
+
+      assert import.reload.completed?
+      new_account = import.account
+      assert_not_nil new_account
+      assert_equal "37signals", new_account.name
+
+      # Completion email arrived
+      email = ActionMailer::Base.deliveries.last
+      assert_not_nil email
+      assert_equal [ identities(:kevin).email_address ], email.to
+      assert_includes email.text_part.body.to_s, new_account.slug
+
+      # User can access the newly imported account and see boards & cards
+      get "#{new_account.slug}/boards/#{new_account.boards.first.id}"
+      assert_response :success
+
+      imported_card = new_account.cards.find_by!(number: cards(:logo).number)
+      get "#{new_account.slug}/cards/#{imported_card.number}"
+      assert_response :success
+      assert_equal File.binread(file_fixture("moon.jpg")), imported_card.image.download
+    end
+  ensure
+    tempfile&.close!
+  end
+
+  test "submitting without a file renders validation error and creates nothing" do
+    sign_in_as :kevin
+
+    untenanted do
+      assert_no_difference -> { Account.count } do
+        assert_no_difference -> { Account::Import.count } do
+          post "/account/imports", params: { import: { file: nil } }
+        end
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "uploading a user card export zip to /account/imports fails cleanly and leaves nothing behind" do
+    sign_in_as :david
+    perform_enqueued_jobs do
+      post user_data_exports_path(users(:david))
+    end
+    user_export = User::DataExport.last
+
+    tempfile = Tempfile.new([ "user_cards", ".zip" ])
+    tempfile.binmode
+    tempfile.write(user_export.file.download)
+    tempfile.rewind
+
+    ActionMailer::Base.deliveries.clear
+
+    untenanted do
+      upload = Rack::Test::UploadedFile.new(tempfile.path, "application/zip")
+
+      assert_no_difference -> { Account.count } do
+        perform_enqueued_jobs do
+          post "/account/imports", params: { file: upload }
+        end
+      end
+
+      import = Account::Import.last
+      assert import.failed?
+      assert_nil import.account_id
+
+      email = ActionMailer::Base.deliveries.last
+      assert_not_nil email
+      assert_equal [ identities(:david).email_address ], email.to
+      assert_match(/not a valid Fizzy account export/i, email.text_part.body.to_s)
+    end
+  ensure
+    tempfile&.close!
+  end
+end
