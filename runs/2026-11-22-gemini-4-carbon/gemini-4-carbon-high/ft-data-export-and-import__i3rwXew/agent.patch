+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthorized_access
+
+  layout "public"
+
+  def show
+    @import = Current.identity.account_imports.find(params[:id])
+  end
+
+  def new
+    @import = Current.identity.account_imports.new
+  end
+
+  def create
+    @import = Account::Import.start(identity: Current.identity, file: file_param)
+
+    if @import.persisted?
+      respond_to do |format|
+        format.html { redirect_to account_import_path(@import, script_name: nil), notice: "Import started. You'll receive an email when it's done." }
+        format.json { head :created }
+      end
+    else
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: { errors: @import.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  private
+    def file_param
+      params[:file] || params.dig(:import, :file) || params.dig(:account_import, :file)
+    end
+end
