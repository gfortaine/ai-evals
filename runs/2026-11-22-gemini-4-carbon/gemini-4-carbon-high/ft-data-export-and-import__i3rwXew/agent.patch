@@ -0,0 +1,58 @@
+class Export < ApplicationRecord
+  EXPIRATION_TIME = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  scope :current, -> { completed.where(completed_at: EXPIRATION_TIME.ago...) }
+  scope :expired, -> { where(completed_at: ...EXPIRATION_TIME.ago).or(where(status: :failed, created_at: ...EXPIRATION_TIME.ago)) }
+
+  after_create_commit :build_later
+
+  class << self
+    def cleanup
+      expired.destroy_all
+    end
+  end
+
+  def build_later
+    Export::BuildJob.perform_later(self)
+  end
+
+  def build_now
+    processing!
+
+    Current.with_account(account) do
+      ZipFile.create_for(file, filename: filename) do |zip|
+        populate_zip(zip)
+      end
+
+      update!(status: :completed, completed_at: Time.current)
+      ExportMailer.completed(self).deliver_later
+    end
+  rescue => error
+    failed!
+    raise error
+  end
+
+  def expired?
+    completed_at.present? && completed_at < EXPIRATION_TIME.ago
+  end
+
+  def accessible_to?(_accessor)
+    false
+  end
+
+  private
+    def filename
+      "fizzy-export-#{id}.zip"
+    end
+
+    def populate_zip(_zip)
+      raise NotImplementedError
+    end
+end
