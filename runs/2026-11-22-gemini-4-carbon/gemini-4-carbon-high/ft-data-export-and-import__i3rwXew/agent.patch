@@ -1,4 +1,84 @@
 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  test "exports signed attachable GIDs as portable GIDs and re-signs them for target account on import" do
+    source_account = accounts("37s")
+    david = users(:david)
+    card = cards(:logo)
+
+    blob = nil
+    Current.with_account(source_account) do
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("file content"),
+        filename: "notes.txt",
+        content_type: "text/plain"
+      )
+      card.update!(
+        description: <<~HTML
+          <div>
+            Mentioning <action-text-attachment sgid="#{david.attachable_sgid}" content-type="application/vnd.actiontext.mention"></action-text-attachment>
+            and file <action-text-attachment sgid="#{blob.attachable_sgid}" url="/#{source_account.external_account_id}/rails/active_storage/blobs/redirect/old/notes.txt" filename="notes.txt" content-type="text/plain"></action-text-attachment>
+            and remote <action-text-attachment url="https://example.com/demo.mp4" content-type="video/mp4"></action-text-attachment>
+          </div>
+        HTML
+      )
+    end
+
+    tempfile = Tempfile.new([ "rich_text", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(source_account).export(to: writer)
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    exported_json = JSON.parse(reader.read("data/action_text_rich_texts/#{card.rich_text_description.id}.json"))
+
+    assert_includes exported_json["body"], david.to_gid.to_s
+    assert_includes exported_json["body"], blob.to_gid.to_s
+    assert_not_includes exported_json["body"], david.attachable_sgid
+    assert_includes exported_json["body"], "https://example.com/demo.mp4"
+
+    target_account = Account.create!(name: "Imported Target")
+    context = Account::DataTransfer::Context.new(account: target_account)
+    context.register_id(source_account.id, target_account.id)
+
+    imported_user_id = context.map_id(david.id)
+    User.insert_all!([ {
+      "id" => imported_user_id,
+      "account_id" => target_account.id,
+      "name" => "David",
+      "role" => "member",
+      "active" => true,
+      "created_at" => Time.current,
+      "updated_at" => Time.current
+    } ])
+    imported_user = User.find(imported_user_id)
+
+    imported_blob = Current.with_account(target_account) do
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("file content"),
+        filename: "notes.txt",
+        content_type: "text/plain"
+      )
+    end
+    context.register_id(blob.id, imported_blob.id)
+
+    Current.with_account(target_account) do
+      Account::DataTransfer::ActionText::RichTextRecordSet.new(target_account).import(from: reader, context: context)
+    end
+
+    imported_rt = ActionText::RichText.find(context.map_id(card.rich_text_description.id))
+    fragment = Nokogiri::HTML::DocumentFragment.parse(imported_rt.read_attribute_before_type_cast(:body))
+    attachments = fragment.css("action-text-attachment")
+
+    assert_equal 3, attachments.size
+    assert_equal imported_user, ActionText::Attachable.from_attachable_sgid(attachments[0]["sgid"])
+    assert_equal imported_blob, ActionText::Attachable.from_attachable_sgid(attachments[1]["sgid"])
+    assert_includes attachments[1]["url"], target_account.slug
+    assert_equal "https://example.com/demo.mp4", attachments[2]["url"]
+  ensure
+    tempfile&.close!
+  end
 end
diff --git a/test/models/account/data_transfer_test.rb b/test/models/account/data_transfer_test.rb
