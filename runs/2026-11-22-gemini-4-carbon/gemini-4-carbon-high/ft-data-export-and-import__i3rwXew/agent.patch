+++ b/test/models/account/data_transfer_test.rb
@@ -0,0 +1,247 @@
+require "test_helper"
+
+class Account::DataTransferTest < ActiveSupport::TestCase
+  test "exports and imports a complete account with boards, cards, comments, files, and people" do
+    source = accounts("37s")
+    kevin = users(:kevin)
+    david = users(:david)
+    card = cards(:logo)
+
+    Current.with_account(source) do
+      with_current_user(kevin) do
+        source.entropy.update!(auto_postpone_period_in_days: 90)
+        boards(:writebook).publish
+
+        card.image.attach(
+          io: File.open(file_fixture("moon.jpg")),
+          filename: "moon.jpg",
+          content_type: "image/jpeg"
+        )
+
+        embed_blob = ActiveStorage::Blob.create_and_upload!(
+          io: StringIO.new("Spec PDF bytes"),
+          filename: "spec.pdf",
+          content_type: "application/pdf"
+        )
+        card.update!(
+          description: %(<div>Check <action-text-attachment sgid="#{embed_blob.attachable_sgid}" filename="spec.pdf" content-type="application/pdf"></action-text-attachment> with <action-text-attachment sgid="#{david.attachable_sgid}" content-type="application/vnd.actiontext.mention"></action-text-attachment></div>)
+        )
+
+        comment_blob = ActiveStorage::Blob.create_and_upload!(
+          io: File.open(file_fixture("avatar.png")),
+          filename: "screenshot.png",
+          content_type: "image/png"
+        )
+        card.comments.create!(
+          creator: kevin,
+          body: %(<div>Screenshot: <action-text-attachment sgid="#{comment_blob.attachable_sgid}" filename="screenshot.png" content-type="image/png"></action-text-attachment></div>)
+        )
+      end
+    end
+
+    # Also create an Account::Export on source to verify its zip blob is excluded from exported blobs
+    existing_export = nil
+    perform_enqueued_jobs do
+      existing_export = source.exports.create!(user: kevin)
+    end
+    assert existing_export.reload.completed?
+
+    target = Account.create!(name: "Placeholder")
+    ZipFile.read_from(existing_export.file) do |zip|
+      Account::DataTransfer.new(target).import_from(zip, importer: identities(:kevin))
+    end
+    target.reload
+
+    assert_equal source.name, target.name
+    assert_not_equal source.external_account_id, target.external_account_id
+    assert_equal 90, target.entropy.auto_postpone_period_in_days
+
+    # People
+    assert_equal source.users.count, target.users.count
+    assert_equal source.users.active.map(&:name).sort, target.users.active.map(&:name).sort
+    imported_kevin = target.users.find_by!(identity: identities(:kevin))
+    assert imported_kevin.admin?
+    imported_jason = target.users.find_by!(identity: identities(:jason))
+    assert imported_jason.owner?
+
+    # Boards & Columns
+    assert_equal source.boards.map(&:name).sort, target.boards.map(&:name).sort
+    imported_writebook = target.boards.find_by!(name: "Writebook")
+    assert imported_writebook.published?
+    assert_not_equal boards(:writebook).publication.key, imported_writebook.publication.key
+    assert_equal boards(:writebook).columns.map(&:name), imported_writebook.columns.order(:position).map(&:name)
+
+    # Cards & Comments & Files
+    assert_equal source.cards.count, target.cards.count
+    imported_card = target.cards.find_by!(number: card.number)
+    assert_equal card.title, imported_card.title
+    assert imported_card.image.attached?
+    assert_equal File.binread(file_fixture("moon.jpg")), imported_card.image.download
+
+    assert_equal 1, imported_card.attachments.count
+    assert_equal "Spec PDF bytes", imported_card.attachments.first.download
+
+    assert_equal card.comments.count, imported_card.comments.count
+    screenshot_comment = imported_card.comments.detect { |c| c.attachments.any? }
+    assert_not_nil screenshot_comment
+    assert_equal File.binread(file_fixture("avatar.png")), screenshot_comment.attachments.first.download
+
+    # Internal export zip was NOT copied into target blobs
+    assert_not target.all_exports.exists?
+    assert_not ActiveStorage::Blob.where(account_id: target.id, filename: existing_export.file.filename.to_s).exists?
+
+    # Search index works in the new account
+    search_results = Search::Record.for(target.id).search("logo", user: imported_kevin)
+    assert_includes search_results.map(&:card_id), imported_card.id
+
+    # Storage bytes reconciled
+    assert_operator target.bytes_used, :>, 0
+  end
+
+  test "importer whose identity was not in the exported account gets access to the imported account" do
+    source = accounts("37s")
+    kevin = users(:kevin)
+
+    export = nil
+    perform_enqueued_jobs do
+      export = source.exports.create!(user: kevin)
+    end
+
+    outsider = Identity.create!(email_address: "outsider@example.com")
+    target = Account.create!(name: "Placeholder")
+
+    ZipFile.read_from(export.file) do |zip|
+      Account::DataTransfer.new(target).import_from(zip, importer: outsider)
+    end
+
+    outsider_user = target.users.find_by(identity: outsider)
+    assert_not_nil outsider_user
+    assert outsider_user.active?
+    assert outsider_user.verified?
+    assert outsider_user.admin?
+    assert_equal target.boards.count, outsider_user.boards.count
+    # Original people are also present
+    assert_equal source.users.count + 1, target.users.count
+  end
+end
+
+class Account::DataTransferEdgeCasesTest < ActiveSupport::TestCase
+  test "preserves avatars, variants, closed/postponed/golden cards, steps, tags, reactions, filters, board entropy, and deactivated users across double round-trip" do
+    source = accounts("37s")
+    kevin = users(:kevin)
+    david = users(:david)
+    jz = users(:jz)
+    card = cards(:logo)
+    layout_card = cards(:layout)
+    shipping_card = cards(:shipping)
+
+    Current.with_account(source) do
+      with_current_user(kevin) do
+        kevin.avatar.attach(
+          io: File.open(file_fixture("avatar.png")),
+          filename: "kevin.png",
+          content_type: "image/png"
+        )
+
+        boards(:writebook).update!(auto_postpone_period_in_days: 7)
+
+        card.gild
+        card.steps.create!(content: "Resize SVG", completed: true)
+        card.steps.create!(content: "Deploy to prod", completed: false)
+        card.toggle_tag_with("design")
+        card.reactions.create!(reacter: kevin, content: "👍")
+        card.comments.first.reactions.create!(reacter: david, content: "🎉")
+
+        layout_card.close(user: kevin)
+        shipping_card.postpone(user: kevin)
+
+        filter = david.filters.create!(
+          account: source,
+          fields: {
+            "indexed_by" => "all",
+            "sorted_by" => "newest",
+            "card_ids" => [ card.id ],
+            "column_ids" => [ card.column_id ]
+          }
+        )
+        filter.tags << source.tags.find_by!(title: "design")
+        filter.board_ids = [ boards(:writebook).id ]
+        filter.assignees << david
+
+        # Deactivate jz after jz already has comments on card
+        jz.deactivate
+      end
+    end
+
+    # Round-trip 1: source -> mid_account
+    export1 = nil
+    perform_enqueued_jobs do
+      export1 = source.exports.create!(user: kevin)
+    end
+
+    import1 = nil
+    perform_enqueued_jobs do
+      import1 = Account::Import.start(
+        identity: identities(:kevin),
+        file: Rack::Test::UploadedFile.new(StringIO.new(export1.file.download), "application/zip", true, original_filename: "export1.zip")
+      )
+    end
+    assert import1.reload.completed?
+    mid_account = import1.account
+
+    # Round-trip 2: mid_account -> final_account
+    mid_kevin = mid_account.users.find_by!(identity: identities(:kevin))
+    export2 = nil
+    Current.with_account(mid_account) do
+      perform_enqueued_jobs do
+        export2 = mid_account.exports.create!(user: mid_kevin)
+      end
+    end
+
+    import2 = nil
+    perform_enqueued_jobs do
+      import2 = Account::Import.start(
+        identity: identities(:kevin),
+        file: Rack::Test::UploadedFile.new(StringIO.new(export2.file.download), "application/zip", true, original_filename: "export2.zip")
+      )
+    end
+    assert import2.reload.completed?
+    final_account = import2.account
+
+    # Verify everything in final_account
+    final_kevin = final_account.users.find_by!(identity: identities(:kevin))
+    assert final_kevin.avatar.attached?
+    assert_equal File.binread(file_fixture("avatar.png")), final_kevin.avatar.download
+
+    # Deactivated user preserved with historical comments
+    deactivated_jz = final_account.users.find_by!(name: "JZ")
+    assert_not deactivated_jz.active?
+    assert_nil deactivated_jz.identity_id
+
+    final_board = final_account.boards.find_by!(name: "Writebook")
+    assert_equal 7, final_board.auto_postpone_period_in_days
+
+    final_logo = final_account.cards.find_by!(number: card.number)
+    assert final_logo.golden?
+    assert_includes final_logo.tags.pluck(:title), "design"
+    assert_equal [ "Resize SVG", "Deploy to prod" ], final_logo.steps.map(&:content)
+    assert_equal [ true, false ], final_logo.steps.map(&:completed)
+    assert_equal card.reactions.pluck(:content).sort, final_logo.reactions.pluck(:content).sort
+    assert_includes final_logo.comments.map { |c| c.creator.name }, "JZ"
+    assert_includes final_logo.comments.flat_map { |c| c.reactions.pluck(:content) }, "🎉"
+
+    final_layout = final_account.cards.find_by!(number: layout_card.number)
+    assert final_layout.closed?
+    assert_equal final_kevin, final_layout.closed_by
+
+    final_shipping = final_account.cards.find_by!(number: shipping_card.number)
+    assert final_shipping.postponed?
+
+    final_david = final_account.users.find_by!(identity: identities(:david))
+    final_filter = final_david.filters.last
+    assert_equal [ final_logo.id ], final_filter.card_ids
+    assert_equal [ "design" ], final_filter.tags.pluck(:title)
+    assert_equal [ final_board.id ], final_filter.boards.ids
+    assert_equal [ final_david.id ], final_filter.assignees.ids
+  end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..17068db
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  test "failed import with invalid zip leaves nothing behind and emails failure reason" do
+    identity = identities(:kevin)
+    bad_file = Rack::Test::UploadedFile.new(StringIO.new("not a zip archive"), "application/zip", true, original_filename: "bad.zip")
+
+    tracked_counts = -> {
+      [
+        Account.count,
+        Account::JoinCode.count,
+        Entropy.count,
+        User.count,
+        Identity.count,
+        Board.count,
+        Card.count,
+        Comment.count,
+        ActiveStorage::Blob.count,
+        ActiveStorage::Attachment.count,
+        ActionText::RichText.count,
+        Storage::Entry.count,
+        Storage::Total.count
+      ]
+    }
+
+    before_counts = tracked_counts.call
+    import = nil
+
+    perform_enqueued_jobs do
+      import = Account::Import.start(identity: identity, file: bad_file)
+    end
+
+    assert_equal before_counts, tracked_counts.call
+    assert import.reload.failed?
+    assert_nil import.account_id
+    assert_not import.file.attached?
+    assert_match(/not a valid ZIP/i, import.failure_reason)
+
+    email = ActionMailer::Base.deliveries.last
+    assert_not_nil email
+    assert_equal [ identity.email_address ], email.to
+    assert_match(/failed/i, email.subject)
+    assert_includes email.text_part.body.to_s, import.failure_reason
+  end
+
+  test "failed import midway through file extraction cleans up uploaded blobs and rolls back everything" do
+    source = accounts("37s")
+    kevin = users(:kevin)
+
+    Current.with_account(source) do
+      cards(:logo).image.attach(
+        io: File.open(file_fixture("moon.jpg")),
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+      cards(:layout).image.attach(
+        io: File.open(file_fixture("avatar.png")),
+        filename: "avatar.png",
+        content_type: "image/png"
+      )
+    end
+
+    export = nil
+    perform_enqueued_jobs do
+      export = source.exports.create!(user: kevin)
+    end
+    ActionMailer::Base.deliveries.clear
+
+    # Build a tampered archive where a brand-new user email is in data/users AND the second storage blob is missing
+    tampered_zip = Tempfile.new([ "tampered", ".zip" ])
+    tampered_zip.binmode
+
+    ZipFile.read_from(export.file) do |reader|
+      writer = ZipFile::Writer.new(tampered_zip)
+      storage_entries = reader.glob("storage/*")
+      assert_equal 2, storage_entries.size
+
+      reader.glob("**/*").each do |entry|
+        next if entry == storage_entries.last
+        writer.add_file(entry, reader.read(entry))
+      end
+
+      extra_user_id = ActiveRecord::Type::Uuid.generate
+      writer.add_file("data/users/#{extra_user_id}.json", JSON.generate(
+        id: extra_user_id,
+        account_id: source.id,
+        name: "Brand New Person",
+        role: "member",
+        active: true,
+        email_address: "brandnewperson@example.com",
+        created_at: Time.current.utc.iso8601,
+        updated_at: Time.current.utc.iso8601
+      ))
+      writer.close
+    end
+    tampered_zip.rewind
+
+    upload = Rack::Test::UploadedFile.new(tampered_zip.path, "application/zip")
+
+    before_accounts = Account.count
+    before_identities = Identity.count
+    before_blobs = ActiveStorage::Blob.count
+    before_cards = Card.count
+
+    import = nil
+    perform_enqueued_jobs do
+      import = Account::Import.start(identity: identities(:kevin), file: upload)
+    end
+
+    assert import.reload.failed?
+    assert_nil import.account_id
+    assert_equal before_accounts, Account.count
+    assert_equal before_identities, Identity.count
+    assert_equal before_blobs, ActiveStorage::Blob.count
+    assert_equal before_cards, Card.count
+    assert_not Identity.exists?(email_address: "brandnewperson@example.com")
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_match(/Missing attachment file/i, email.text_part.body.to_s)
+  ensure
+    tampered_zip&.close!
+  end
+end
diff --git a/test/models/user/data_export_test.rb b/test/models/user/data_export_test.rb
new file mode 100644
index 0000000..22641c4
--- /dev/null
+++ b/test/models/user/data_export_test.rb
@@ -0,0 +1,146 @@
+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "exports accessible published cards as JSON with comments and every attached picture and file" do
+    account = accounts("37s")
+    david = users(:david)
+    kevin = users(:kevin)
+    logo_card = cards(:logo)
+
+    Current.with_account(account) do
+      # Attach a header image, a description file, and two comment files (with duplicate filename test) to accessible card
+      logo_card.image.attach(
+        io: File.open(file_fixture("moon.jpg")),
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+
+      doc_blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("Project brief contents"),
+        filename: "brief.txt",
+        content_type: "text/plain"
+      )
+      logo_card.update!(
+        description: %(<div>Brief: <action-text-attachment sgid="#{doc_blob.attachable_sgid}" filename="brief.txt" content-type="text/plain"></action-text-attachment></div>)
+      )
+
+      pic_blob = ActiveStorage::Blob.create_and_upload!(
+        io: File.open(file_fixture("avatar.png")),
+        filename: "moon.jpg",
+        content_type: "image/png"
+      )
+      with_current_user(kevin) do
+        logo_card.comments.create!(
+          creator: kevin,
+          body: %(<div>Another moon: <action-text-attachment sgid="#{pic_blob.attachable_sgid}" filename="moon.jpg" content-type="image/png"></action-text-attachment></div>)
+        )
+      end
+
+      # Create a card on a private board that david CANNOT see
+      with_current_user(kevin) do
+        boards(:private).cards.create!(
+          creator: kevin,
+          title: "Top secret private card",
+          status: "published"
+        )
+      end
+
+      # Create an unpublished drafted card on writebook
+      with_current_user(david) do
+        boards(:writebook).cards.create!(
+          creator: david,
+          title: "Unpublished draft",
+          status: "drafted"
+        )
+      end
+    end
+
+    export = nil
+    assert_emails 1 do
+      perform_enqueued_jobs do
+        export = david.data_exports.create!(account: account)
+      end
+    end
+
+    assert export.reload.completed?
+    assert export.file.attached?
+
+    ZipFile.read_from(export.file) do |zip|
+      json_files = zip.glob("*.json")
+      expected_numbers = david.accessible_cards.published.pluck(:number).map { |n| "#{n}.json" }.sort
+      assert_equal expected_numbers, json_files
+
+      # Private card and drafted card are NOT in the export
+      all_card_titles = json_files.map { |path| JSON.parse(zip.read(path))["title"] }
+      assert_not_includes all_card_titles, "Top secret private card"
+      assert_not_includes all_card_titles, "Unpublished draft"
+
+      # Verify card JSON has comments and attachments
+      logo_json = JSON.parse(zip.read("#{logo_card.number}.json"))
+      assert_equal logo_card.title, logo_json["title"]
+      assert_equal "#{logo_card.number}/moon.jpg", logo_json["image"]
+      assert_includes logo_json["attachments"], "#{logo_card.number}/moon.jpg"
+      assert_includes logo_json["attachments"], "#{logo_card.number}/brief.txt"
+
+      assert_equal logo_card.comments.count, logo_json["comments"].size
+      comment_texts = logo_json["comments"].map { |c| c["body"]["plain_text"] }
+      assert_includes comment_texts, "I agree."
+      assert_includes comment_texts, "Same, let's do it."
+
+      # Verify binary contents of every attached picture and file in the zip
+      assert_equal File.binread(file_fixture("moon.jpg")), zip.read("#{logo_card.number}/moon.jpg")
+      assert_equal "Project brief contents", zip.read("#{logo_card.number}/brief.txt")
+      assert_equal File.binread(file_fixture("avatar.png")), zip.read("#{logo_card.number}/moon-1.jpg")
+    end
+  end
+
+  test "export expires after 1 day and cleanup destroys expired exports" do
+    account = accounts("37s")
+    david = users(:david)
+
+    export = nil
+    perform_enqueued_jobs do
+      export = david.data_exports.create!(account: account)
+    end
+
+    assert export.reload.accessible_to?(david)
+    assert_not export.accessible_to?(users(:kevin))
+
+    travel 23.hours do
+      assert_not export.expired?
+      assert export.accessible_to?(david)
+      assert_includes Export.current, export
+    end
+
+    travel 25.hours do
+      assert export.expired?
+      assert_not export.accessible_to?(david)
+      assert_not_includes Export.current, export
+
+      assert_difference -> { Export.count }, -1 do
+        Export.cleanup
+      end
+    end
+  end
+end
+
+class User::DataExportEdgeCasesTest < ActiveSupport::TestCase
+  test "user with zero accessible cards gets a valid empty zip export" do
+    account = accounts("initech")
+    lonely_identity = Identity.create!(email_address: "lonely@initech.com")
+    lonely_user = account.users.create!(name: "Lonely", identity: lonely_identity, role: :member, verified_at: Time.current)
+    lonely_user.accesses.destroy_all
+
+    export = nil
+    perform_enqueued_jobs do
+      export = lonely_user.data_exports.create!(account: account)
+    end
+
+    assert export.reload.completed?
+    ZipFile.read_from(export.file) do |zip|
+      assert_empty zip.glob("**/*")
+    end
+  end
+end
