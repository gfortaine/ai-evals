@@ -0,0 +1,90 @@
+class Account::Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  validates :file, presence: true, on: :create
+
+  class << self
+    def start(identity:, file:)
+      if file.blank?
+        new(identity: identity).tap do |import|
+          import.errors.add(:file, "must be selected")
+        end
+      else
+        import = transaction do
+          target_account = Account.create!(name: "Imported Account")
+          Current.with_account(target_account) do
+            create!(identity: identity, account: target_account, file: file)
+          end
+        end
+
+        import.process_later
+        import
+      end
+    end
+  end
+
+  def process_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def process_now
+    processing!
+
+    ActiveRecord::Base.transaction do
+      ZipFile.read_from(file) do |zip|
+        Account::DataTransfer.new(account).import_from(zip, importer: identity)
+      end
+    end
+
+    complete_import
+  rescue => error
+    fail_import(error)
+  end
+
+  private
+    def complete_import
+      Current.with_account(account) do
+        file.purge_later
+        update!(status: :completed, completed_at: Time.current)
+        ImportMailer.completed(self).deliver_later
+      end
+    end
+
+    def fail_import(error)
+      reason = failure_message_for(error)
+      target_account = account
+
+      if target_account
+        Current.with_account(target_account) do
+          file.purge if file.attached?
+        end
+      end
+
+      update!(account: nil, status: :failed, failure_reason: reason)
+
+      if target_account && !target_account.destroyed?
+        Storage::Entry.suppressing_recording do
+          target_account.destroy!
+        end
+      end
+
+      Current.without_account do
+        ImportMailer.failed(self).deliver_later
+      end
+    end
+
+    def failure_message_for(error)
+      case error
+      when Account::DataTransfer::InvalidArchiveError, ZipFile::InvalidFileError
+        error.message
+      else
+        Rails.error.report(error, severity: :error)
+        "Import could not be completed: #{error.message}"
+      end
+    end
+end
