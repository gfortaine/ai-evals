diff --git a/app/models/user/data_export.rb b/app/models/user/data_export.rb
new file mode 100644
index 0000000..0fe1058
--- /dev/null
+++ b/app/models/user/data_export.rb
@@ -0,0 +1,161 @@
+class User::DataExport < Export
+  def accessible_to?(accessor)
+    completed? && !expired? && accessor.present? && accessor == user
+  end
+
+  private
+    def filename
+      slug = user.name.parameterize.presence || user.id
+      "fizzy-cards-#{slug}-#{created_at.utc.strftime("%Y%m%d")}.zip"
+    end
+
+    def populate_zip(zip)
+      exportable_cards.find_each do |card|
+        export_card(zip, card)
+      end
+    end
+
+    def exportable_cards
+      user.accessible_cards.published.chronologically.includes(
+        :board,
+        :column,
+        :tags,
+        :steps,
+        :closure,
+        :goldness,
+        :not_now,
+        creator: :identity,
+        assignees: :identity,
+        image_attachment: :blob,
+        rich_text_description: { embeds_attachments: :blob }
+      )
+    end
+
+    def export_card(zip, card)
+      blob_paths = {}
+      used_paths = Set.new
+
+      image_path = if card.image.attached?
+        write_card_blob(zip, card.number, card.image.blob, blob_paths, used_paths)
+      end
+
+      description_attachment_paths = card.attachments.map do |attachment|
+        write_card_blob(zip, card.number, attachment.blob, blob_paths, used_paths)
+      end
+
+      comments = card.comments.chronologically.includes(
+        creator: :identity,
+        rich_text_body: { embeds_attachments: :blob }
+      )
+
+      comments_data = comments.map do |comment|
+        comment_attachment_paths = comment.attachments.map do |attachment|
+          write_card_blob(zip, card.number, attachment.blob, blob_paths, used_paths)
+        end
+
+        {
+          id: comment.id,
+          creator: serialize_user(comment.creator),
+          body: {
+            plain_text: comment.body.to_plain_text,
+            html: rewrite_attachment_urls(comment.body.to_s, blob_paths)
+          },
+          attachments: comment_attachment_paths.uniq,
+          created_at: comment.created_at.utc.iso8601,
+          updated_at: comment.updated_at.utc.iso8601
+        }
+      end
+
+      card_data = {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        description: card.description.to_plain_text,
+        description_html: rewrite_attachment_urls(card.description.to_s, blob_paths),
+        board: {
+          id: card.board.id,
+          name: card.board.name
+        },
+        column: card.column ? { id: card.column.id, name: card.column.name } : nil,
+        creator: serialize_user(card.creator),
+        assignees: card.assignees.map { |assignee| serialize_user(assignee) },
+        tags: card.tags.map(&:title).sort,
+        steps: card.steps.map { |step| { id: step.id, content: step.content, completed: step.completed } },
+        closed: card.closed?,
+        closed_at: card.closed_at&.utc&.iso8601,
+        postponed: card.postponed?,
+        golden: card.golden?,
+        due_on: card.due_on&.iso8601,
+        image: image_path,
+        attachments: ([ image_path ] + description_attachment_paths).compact.uniq,
+        created_at: card.created_at.utc.iso8601,
+        updated_at: card.updated_at.utc.iso8601,
+        last_active_at: card.last_active_at&.utc&.iso8601,
+        comments: comments_data
+      }
+
+      zip.add_file("#{card.number}.json", JSON.pretty_generate(card_data))
+    end
+
+    def write_card_blob(zip, card_number, blob, blob_paths, used_paths)
+      if blob_paths.key?(blob.id)
+        blob_paths[blob.id]
+      else
+        path = unique_attachment_path(card_number, blob.filename.to_s, used_paths)
+        used_paths.add(path)
+        blob_paths[blob.id] = path
+
+        zip.add_file(path, compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+
+        path
+      end
+    end
+
+    def unique_attachment_path(card_number, raw_filename, used_paths)
+      sanitized = File.basename(raw_filename.presence || "attachment")
+      sanitized = "attachment" if sanitized.in?([ "", ".", ".." ])
+      candidate = "#{card_number}/#{sanitized}"
+
+      if !used_paths.include?(candidate)
+        candidate
+      else
+        ext = File.extname(sanitized)
+        stem = File.basename(sanitized, ext)
+        counter = 1
+        loop do
+          numbered = "#{card_number}/#{stem}-#{counter}#{ext}"
+          return numbered unless used_paths.include?(numbered)
+          counter += 1
+        end
+      end
+    end
+
+    def rewrite_attachment_urls(html, blob_paths)
+      if html.blank? || blob_paths.empty? || !html.include?("action-text-attachment")
+        html
+      else
+        fragment = Nokogiri::HTML::DocumentFragment.parse(html)
+        fragment.css("action-text-attachment[sgid]").each do |node|
+          if sgid = SignedGlobalID.parse(node["sgid"], for: ::ActionText::Attachable::LOCATOR_NAME)
+            if sgid.model_name == "ActiveStorage::Blob" && blob_paths.key?(sgid.model_id)
+              node["url"] = blob_paths[sgid.model_id]
+            end
+          end
+        end
+        fragment.to_html
+      end
+    end
+
+    def serialize_user(person)
+      return nil unless person
+
+      {
+        id: person.id,
+        name: person.name,
+        email_address: person.identity&.email_address
+      }
+    end
+end
