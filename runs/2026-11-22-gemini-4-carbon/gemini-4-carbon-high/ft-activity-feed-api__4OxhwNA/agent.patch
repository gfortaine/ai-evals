diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..ae71b76 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,28 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def particular_details
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids || nested_particulars["assignee_ids"]) }
+    when "card_board_changed"
+      { old_board: nested_particulars["old_board"].to_s, new_board: nested_particulars["new_board"].to_s }
+    when "card_title_changed"
+      { old_title: nested_particulars["old_title"].to_s, new_title: nested_particulars["new_title"].to_s }
+    when "card_triaged"
+      { column: nested_particulars["column"].to_s }
+    else
+      {}
+    end
+  end
+
+  private
+    def nested_particulars
+      if particulars.is_a?(Hash)
+        particulars["particulars"].is_a?(Hash) ? particulars["particulars"] : particulars
+      else
+        {}
+      end
+    end
 end
