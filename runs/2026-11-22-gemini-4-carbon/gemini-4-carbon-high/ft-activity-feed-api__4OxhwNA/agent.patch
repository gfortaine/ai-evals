+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from Current.user.activity(board_ids: board_ids_param, creator_ids: creator_ids_param)
+      end
+    end
+  end
+
+  private
+    def board_ids_param
+      extract_ids_param(:board_ids)
+    end
+
+    def creator_ids_param
+      extract_ids_param(:creator_ids)
+    end
+
+    def extract_ids_param(key)
+      case value = params[key]
+      when Array, String
+        Array(value).compact_blank
+      else
+        []
+      end
+    end
+end
