@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "assignment changes expose assignee_ids" do
+    event = events(:logo_assignment_jz)
+
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, event.particular_details)
+
+    event.action = "card_unassigned"
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, event.particular_details)
+  end
+
+  test "assignment changes with missing assignee_ids return empty array" do
+    event = events(:logo_published)
+    event.update!(action: "card_assigned", particulars: {})
+
+    assert_equal({ assignee_ids: [] }, event.particular_details)
+  end
+
+  test "board changes expose old_board and new_board with empty string fallback" do
+    event = events(:logo_published)
+    event.update!(
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Writebook", "new_board" => "Fizzy" } }
+    )
+
+    assert_equal({ old_board: "Writebook", new_board: "Fizzy" }, event.particular_details)
+
+    event.update!(action: "card_board_changed", particulars: {})
+    assert_equal({ old_board: "", new_board: "" }, event.particular_details)
+  end
+
+  test "title changes expose old_title and new_title with empty string fallback" do
+    event = events(:logo_published)
+    event.update!(
+      action: "card_title_changed",
