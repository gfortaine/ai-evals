@@ -26,6 +26,23 @@ class SessionsController < ApplicationController
       redirect_to first_run_url if User.none?
     end
 
+    def return_to_url
+      if params[:return_to].is_a?(String) && params[:return_to].valid_encoding?
+        if url = url_from(params[:return_to])
+          url if safe_return_to_uri?(URI(url))
+        end
+      end
+    end
+
+    def safe_return_to_uri?(uri)
+      uri.userinfo.nil? && (
+        uri.host.nil? || (
+          uri.scheme.in?(%w[ http https ]) &&
+          (uri.port == request.port || uri.port == uri.default_port)
+        )
+      )
+    end
+
     def render_rejection(status)
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
