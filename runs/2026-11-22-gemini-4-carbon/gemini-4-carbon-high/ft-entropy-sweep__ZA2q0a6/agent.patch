@@ -59,6 +59,55 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_not cards(:shipping).reload.postponed?
   end
 
+  test "board entropy overrides shorter account entropy" do
+    entropies("37s_account").update!(auto_postpone_period: 7.days)
+    entropies(:writebook_board).update!(auto_postpone_period: 90.days)
+
+    cards(:logo).update!(last_active_at: 30.days.ago)
+
+    assert_not_includes Card.due_to_be_postponed, cards(:logo)
+
+    assert_no_difference -> { Card.postponed.count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "closed, drafted, and already postponed cards are excluded from due_to_be_postponed" do
+    overdue_time = 2.years.ago
+
+    cards(:shipping).update!(last_active_at: overdue_time)
+    cards(:unfinished_thoughts).update!(last_active_at: overdue_time)
+    cards(:text).postpone
+    cards(:text).update_column(:last_active_at, overdue_time)
+
+    due = Card.due_to_be_postponed
+    assert_not_includes due, cards(:shipping)
+    assert_not_includes due, cards(:unfinished_thoughts)
+    assert_not_includes due, cards(:text)
+  end
+
+  test "exact boundary with subsecond precision" do
+    travel_to Time.utc(2026, 6, 15, 10, 20, 30, 500_000) do
+      period = entropies(:writebook_board).auto_postpone_period
+      cards(:logo).update!(last_active_at: Time.current - period)
+      cards(:layout).update!(last_active_at: Time.current - period + 1.second)
+
+      assert_includes Card.due_to_be_postponed, cards(:logo)
+      assert_not_includes Card.due_to_be_postponed, cards(:layout)
+      assert_not_includes Card.postponing_soon, cards(:logo)
+      assert_includes Card.postponing_soon, cards(:layout)
+    end
+  end
+
+  test "handles missing entropy records gracefully" do
+    Entropy.delete_all
+
+    assert_empty Card.due_to_be_postponed
+    assert_empty Card.postponing_soon
+    assert_not cards(:logo).reload.entropic?
+    assert_nothing_raised { Card.auto_postpone_all_due }
+  end
+
