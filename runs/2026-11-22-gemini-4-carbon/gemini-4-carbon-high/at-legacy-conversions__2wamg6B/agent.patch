diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..cfe0667
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "show renders shelf report html with formatted date and delimited character count" do
+    book = books(:handbook)
+    leaves(:welcome_page).leafable.update!(body: "a" * 1200)
+    book.update_columns(updated_at: Time.utc(2025, 3, 15, 14, 30, 45))
+
+    get book_report_path(book)
+
+    assert_response :success
+    assert_in_body "Last updated March 15, 2025"
+    assert_in_body "#{book.title} — #{book.markable.length.to_fs(:delimited)} characters"
+    assert_match(/1,2\d\d characters/, response.body)
+  end
+
+  test "show renders plain text report card download" do
+    book = books(:handbook)
+    created_time = Time.utc(2025, 1, 5, 9, 15, 0)
+    updated_time = Time.utc(2025, 3, 15, 14, 30, 45)
+    book.update_columns(created_at: created_time, updated_at: updated_time)
+
+    get book_report_path(book, format: :text)
+
+    assert_response :success
+    assert_equal "text/plain", response.media_type
+    assert_includes response.headers["Content-Disposition"], "shelf-report-20250315143045.txt"
+
+    expected_ids = book.leaves.active.positioned.map(&:id).join(",")
+    assert_in_body "Book: Handbook"
+    assert_in_body "Leaves: #{book.leaf_count}"
+    assert_in_body "Started: January 05, 2025 09:15"
+    assert_in_body "Updated: 15 Mar 14:30"
+    assert_in_body "Covers: #{expected_ids}"
+  end
+
+  test "show renders report card for book with no leaves" do
+    sign_in :david
+    book = books(:manual)
+
+    get book_report_path(book, format: :text)
+
+    assert_response :success
+    assert_in_body "Leaves: 0"
+    assert_in_body "Covers: null"
+  end
+end
