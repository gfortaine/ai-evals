+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly formats published book updated dates" do
+    book = books(:handbook)
+    book.update_columns(published: true, updated_at: Time.utc(2025, 3, 15, 14, 30, 0))
+
+    mail = ReportDigestMailer.weekly(users(:kevin))
+
+    assert_equal [ users(:kevin).email_address ], mail.to
+    assert_equal "Your Writebook digest", mail.subject
+    assert_includes mail.body.encoded, "* Handbook, last edited 15 Mar"
+  end
+end
