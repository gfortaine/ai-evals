diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..3107ce5
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class ReportArchiveJobTest < ActiveJob::TestCase
+  setup do
+    @archived_paths = []
+  end
+
+  teardown do
+    @archived_paths.each { |path| FileUtils.rm_f(path) }
+    Dir.rmdir(Rails.root.join(ReportArchiveJob::ARCHIVE_DIR))
+  rescue SystemCallError
+    nil
+  end
+
+  test "perform writes archive file with default formatted timestamp and markable content" do
+    book = books(:handbook)
+    edited_at = Time.utc(2025, 3, 15, 14, 30, 45)
+    book.leaves.active.update_all(updated_at: edited_at)
+
+    path = archive_path_for(book)
+    ReportArchiveJob.perform_now(book)
+
+    assert File.exist?(path)
+    assert_equal "# archived 2025-03-15 14:30:45 UTC\n\n#{book.markable}", File.read(path)
+  end
+
+  test "perform handles book with no active leaves" do
+    book = books(:manual)
+
+    path = archive_path_for(book)
+    ReportArchiveJob.perform_now(book)
+
+    assert File.exist?(path)
+    assert_equal "# archived \n\n", File.read(path)
+  end
+
+  private
+    def archive_path_for(book)
+      Rails.root.join(ReportArchiveJob::ARCHIVE_DIR, "book-#{book.id}.txt").tap do |path|
+        @archived_paths << path
+      end
+    end
+end
diff --git a/test/lib/publishing/report_card_test.rb b/test/lib/publishing/report_card_test.rb
new file mode 100644
index 0000000..3d6d794
--- /dev/null
+++ b/test/lib/publishing/report_card_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Publishing::ReportCardTest < ActiveSupport::TestCase
+  test "to_text formats dates and active leaf ids" do
+    book = books(:handbook)
+    leaves(:summary_page).trashed!
+    book.update_columns(
+      created_at: Time.utc(2025, 2, 10, 8, 5, 0),
+      updated_at: Time.utc(2025, 3, 15, 14, 30, 0)
+    )
+    expected_ids = [ leaves(:welcome_section).id, leaves(:welcome_page).id, leaves(:reading_picture).id ].join(",")
+
+    expected = <<~TEXT
+      Book: Handbook
+      Leaves: 3
+      Started: February 10, 2025 08:05
+      Updated: 15 Mar 14:30
+      Covers: #{expected_ids}
+    TEXT
+
+    assert_equal expected, Publishing::ReportCard.new(book).to_text
+  end
+
+  test "to_text formats empty leaf list as null" do
+    book = books(:manual)
+    card = Publishing::ReportCard.new(book).to_text
+
+    assert_includes card, "Leaves: 0\n"
+    assert_includes card, "Covers: null\n"
+  end
+end
