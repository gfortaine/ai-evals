@@ -0,0 +1,36 @@
+require "application_system_test_case"
+
+class StalledCardsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "shows stalled bubble on cards, filters by indexed_by=stalled, and resets on activity" do
+    board = boards(:writebook)
+
+    stalled_card = nil
+    with_current_user(:david) do
+      stalled_card = board.cards.create!(title: "Cold after burst", creator: users(:david), status: :published)
+      stalled_card.toggle_assignment(users(:kevin))
+      stalled_card.update!(last_active_at: 15.days.ago)
+
+      board.cards.create!(title: "Cold without burst", creator: users(:david), status: :published, last_active_at: 15.days.ago)
+    end
+
+    sign_in_as(users(:david))
+
+    visit cards_url(indexed_by: "stalled")
+    assert_text "Cold after burst"
+    assert_no_text "Cold without burst"
+    within "##{dom_id(stalled_card, :article)}" do
+      assert_selector ".bubble.bubble--stalled:not([hidden])", text: /15/
+    end
+
+    visit card_url(stalled_card)
+    assert_selector "##{dom_id(stalled_card, 'bubble')}.bubble--stalled:not([hidden])", text: /15/
+
+    fill_in_lexxy with: "Back on it!"
+    click_on "Post"
+
+    assert_text "Back on it!"
+    assert_no_selector "##{dom_id(stalled_card, 'bubble')}:not([hidden])"
+  end
+end
