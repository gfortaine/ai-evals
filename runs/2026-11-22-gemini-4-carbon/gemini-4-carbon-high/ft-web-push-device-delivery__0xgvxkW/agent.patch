+    config.x.vapid.public_key = ENV["VAPID_PUBLIC_KEY"]
+    config.x.vapid.private_key = ENV["VAPID_PRIVATE_KEY"]
+  elsif Rails.env.test?
+    vapid_key = WebPush.generate_key
+    config.x.vapid.public_key = vapid_key.public_key
+    config.x.vapid.private_key = vapid_key.private_key
+  elsif Rails.env.development?
+    key_file = Rails.root.join("tmp/vapid_key.pem")
+    vapid_key = if key_file.exist?
+      WebPush::VapidKey.from_pem(key_file.read)
+    else
+      WebPush.generate_key.tap { |key| key_file.write(key.to_pem) }
+    end
+    config.x.vapid.public_key = vapid_key.public_key
+    config.x.vapid.private_key = vapid_key.private_key
+  end
+end
