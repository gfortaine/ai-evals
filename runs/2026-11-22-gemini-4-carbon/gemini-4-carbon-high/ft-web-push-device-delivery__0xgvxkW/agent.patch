@@ -0,0 +1,42 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    if subscription = @user.push_subscriptions.find_by(endpoint: push_subscription_params[:endpoint])
+      subscription.update!(push_subscription_params.merge(user_agent: request.user_agent, session: Current.session))
+    else
+      subscription = @user.push_subscriptions.create!(push_subscription_params.merge(user_agent: request.user_agent, session: Current.session))
+    end
+
+    respond_to do |format|
+      format.turbo_stream { head :created }
+      format.json do
+        render json: { id: subscription.id, url: user_push_subscription_path(@user, subscription) },
+          status: :created,
+          location: user_push_subscription_path(@user, subscription)
+      end
+      format.html { head :created }
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find_by(id: params[:id])&.destroy
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
