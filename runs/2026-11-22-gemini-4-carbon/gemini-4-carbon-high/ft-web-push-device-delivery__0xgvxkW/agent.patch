diff --git a/app/models/notification/pushing.rb b/app/models/notification/pushing.rb
new file mode 100644
index 0000000..fe36959
--- /dev/null
+++ b/app/models/notification/pushing.rb
@@ -0,0 +1,34 @@
+module Notification::Pushing
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :push_later, on: %i[ create update ], if: :source_id_previously_changed?
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self)
+  end
+
+  def push_now
+    return unless pushable?
+
+    payload = push_payload
+    user.push_subscriptions.find_each do |subscription|
+      subscription.deliver(**payload)
+    end
+  end
+  alias_method :push, :push_now
+
+  private
+    def pushable?
+      Push.configured? && account.active? && user.active?
+    end
+
+    def push_payload
+      {
+        title: title,
+        body: body,
+        path: Rails.application.routes.url_helpers.card_path(card, script_name: account.slug)
+      }
+    end
+end
