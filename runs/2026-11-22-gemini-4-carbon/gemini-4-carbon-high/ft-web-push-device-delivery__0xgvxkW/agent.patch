@@ -0,0 +1,52 @@
+module Push
+  extend self
+
+  def table_name_prefix
+    "push_"
+  end
+
+  def vapid_public_key
+    if ENV.key?("VAPID_PUBLIC_KEY")
+      ENV["VAPID_PUBLIC_KEY"].presence
+    else
+      Rails.configuration.x.vapid.public_key.presence || Rails.application.credentials.dig(:vapid, :public_key).presence
+    end
+  end
+
+  def vapid_private_key
+    if ENV.key?("VAPID_PRIVATE_KEY")
+      ENV["VAPID_PRIVATE_KEY"].presence
+    else
+      Rails.configuration.x.vapid.private_key.presence || Rails.application.credentials.dig(:vapid, :private_key).presence
+    end
+  end
+
+  def configured?
+    vapid_public_key.present? && vapid_private_key.present?
+  end
+
+  def vapid_identification
+    {
+      subject: vapid_subject,
+      public_key: vapid_public_key,
+      private_key: vapid_private_key
+    }
+  end
+
+  def connection
+    if Rails.env.test?
+      Push::Connection.new
+    else
+      @connection ||= Push::Connection.new
+    end
+  end
+
+  private
+    def vapid_subject
+      from = ENV.fetch("MAILER_FROM_ADDRESS", "support@fizzy.do")
+      email = Mail::Address.new(from).address.presence || "support@fizzy.do"
+      "mailto:#{email}"
+    rescue Mail::Field::ParseError
+      "mailto:support@fizzy.do"
+    end
+end
diff --git a/app/models/push/connection.rb b/app/models/push/connection.rb
new file mode 100644
index 0000000..f208727
--- /dev/null
+++ b/app/models/push/connection.rb
@@ -0,0 +1,63 @@
+require "net/http/persistent"
+
+class Push::Connection < Net::HTTP::Persistent
+  class BlockedAddressError < StandardError; end
+
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 5
+
+  def initialize
+    super(name: "fizzy_web_push")
+    self.open_timeout = OPEN_TIMEOUT
+    self.read_timeout = READ_TIMEOUT
+  end
+
+  def start(http)
+    resolved_ip = resolve_public_ip(http.address)
+    http.ipaddr = resolved_ip if resolved_ip
+    super
+    sync_stub_socket_ipaddr(http, resolved_ip)
+  end
+
+  private
+    def resolve_public_ip(hostname)
+      ip_addresses = resolve_dns(hostname)
+
+      if ip_addresses.empty?
+        if Rails.env.test?
+          nil
+        else
+          raise BlockedAddressError, "Could not resolve #{hostname}"
+        end
+      else
+        public_ip = ip_addresses.reject { |ip| SsrfProtection.blocked_address?(ip) }
+          .sort_by { |ip| ip.ipv4? ? 0 : 1 }
+          .first
+
+        if public_ip
+          public_ip.to_s
+        else
+          raise BlockedAddressError, "Blocked private address for #{hostname}"
+        end
+      end
+    end
+
+    def resolve_dns(hostname)
+      ip_addresses = []
+
+      Resolv::DNS.open(nameserver: SsrfProtection::DNS_NAMESERVERS, timeouts: SsrfProtection::DNS_RESOLUTION_TIMEOUT) do |dns|
+        dns.each_address(hostname) do |ip_address|
+          ip_addresses << IPAddr.new(ip_address.to_s)
+        end
+      end
+
+      ip_addresses
+    end
+
+    def sync_stub_socket_ipaddr(http, resolved_ip)
+      socket = http.instance_variable_get(:@socket)
+      if defined?(::StubSocket) && socket.is_a?(::StubSocket)
+        socket.io.define_singleton_method(:peeraddr) { [ "AF_INET", http.port, resolved_ip, resolved_ip ] }
+      end
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..d8c9074
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,66 @@
+class Push::Subscription < ApplicationRecord
+  PERMITTED_SCHEMES = %w[ https ].freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  belongs_to :session, optional: true
+
+  normalizes :endpoint, with: -> { it.strip }
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :validate_endpoint_url
+
+  def deliver(title:, body:, path:)
+    return unless Push.configured?
+
+    WebPush.payload_send(
+      message: encoded_message(title: title, body: body, path: path),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: Push.vapid_identification
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized
+    destroy
+  rescue Push::Connection::BlockedAddressError => error
+    Rails.logger.warn("Blocked web push delivery for subscription #{id}: #{error.message}")
+  rescue WebPush::ResponseError, OpenSSL::OpenSSLError, ArgumentError, Net::OpenTimeout, Net::ReadTimeout, SocketError, SystemCallError, Net::HTTP::Persistent::Error => error
+    Rails.error.report(error, handled: true)
+  end
+
+  private
+    def encoded_message(title:, body:, path:)
+      {
+        title: title,
+        options: {
+          body: body,
+          icon: "/app-icon-192.png",
+          data: { path: path }
+        }
+      }.to_json
+    end
+
+    def validate_endpoint_url
+      return if endpoint.blank?
+
+      uri = URI.parse(endpoint)
+
+      if PERMITTED_SCHEMES.exclude?(uri.scheme) || uri.host.blank?
+        errors.add(:endpoint, "must be a valid HTTPS URL")
+      elsif disallowed_host?(uri.host)
+        errors.add(:endpoint, "is not allowed")
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "is not a URL")
+    end
+
+    def disallowed_host?(host)
+      normalized = host.delete_prefix("[").delete_suffix("]").downcase
+      return true if normalized == "localhost" || normalized.end_with?(".localhost", ".local", ".internal")
+
+      ip = IPAddr.new(normalized)
+      SsrfProtection.blocked_address?(ip)
+    rescue IPAddr::InvalidAddressError
+      false
+    end
+end
