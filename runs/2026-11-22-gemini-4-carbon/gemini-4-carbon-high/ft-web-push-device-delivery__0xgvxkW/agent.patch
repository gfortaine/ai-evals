diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..8d9b7f6
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,248 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static targets = [ "toggle", "details", "explainer" ]
+  static classes = [ "enabled" ]
+  static values = {
+    subscriptionsUrl: String,
+    vapidPublicKey: String,
+    subscriptions: { type: Object, default: {} }
+  }
+
+  async connect() {
+    this.handleWindowFocus = this.refresh.bind(this)
+    window.addEventListener("focus", this.handleWindowFocus)
+    await this.#observePermissionChanges()
+    await this.refresh()
+  }
+
+  disconnect() {
+    window.removeEventListener("focus", this.handleWindowFocus)
+    if (this.permissionStatus) {
+      this.permissionStatus.removeEventListener("change", this.handleWindowFocus)
+      this.permissionStatus = null
+    }
+  }
+
+  async refresh() {
+    if (!this.#pushSupported) {
+      this.#setEnabled(false)
+      this.#setToggleDisabled(true)
+      this.#showInstallOnlyHelp()
+      return
+    }
+
+    switch (Notification.permission) {
+      case "denied":
+        this.#setEnabled(false)
+        this.#setToggleDisabled(true)
+        this.#showBlockedHelp()
+        break
+      case "granted":
+        this.#setToggleDisabled(false)
+        this.#hideHelp()
+        await this.#syncGrantedState()
+        break
+      default:
+        this.#setEnabled(false)
+        this.#setToggleDisabled(false)
+        this.#hideHelp()
+    }
+  }
+
+  async toggle() {
+    const enabling = this.toggleTarget.checked
+    this.#setToggleDisabled(true)
+
+    try {
+      if (enabling) {
+        await this.#enable()
+      } else {
+        await this.#disable()
+      }
+    } catch (error) {
+      console.error(error)
+      this.#setEnabled(!enabling)
+    } finally {
+      if (this.#pushSupported && Notification.permission !== "denied") {
+        this.#setToggleDisabled(false)
+      }
+    }
+  }
+
+  async #enable() {
+    const permission = Notification.permission === "default"
+      ? await Notification.requestPermission()
+      : Notification.permission
+
+    if (permission === "granted") {
+      const subscription = await this.#subscribe()
+      const response = await post(this.subscriptionsUrlValue, {
+        body: this.#serializeSubscription(subscription),
+        responseKind: "json"
+      })
+
+      if (response.ok) {
+        const data = await response.json.catch(() => ({}))
+        const url = data.url || response.headers.get("Location")
+        this.subscriptionsValue = { ...this.subscriptionsValue, [subscription.endpoint]: url }
+        this.#setEnabled(true)
+        this.#hideHelp()
+      } else {
+        this.#setEnabled(false)
+      }
+    } else if (permission === "denied") {
+      this.#setEnabled(false)
+      this.#setToggleDisabled(true)
+      this.#showBlockedHelp()
+    } else {
+      this.#setEnabled(false)
+      this.#hideHelp()
+    }
+  }
+
+  async #disable() {
+    const subscription = await this.#currentSubscription()
+    const destroyUrl = subscription && this.subscriptionsValue[subscription.endpoint]
+
+    if (destroyUrl) {
+      const response = await destroy(destroyUrl)
+      if (!response.ok) {
+        this.#setEnabled(true)
+        return
+      }
+
+      const remaining = { ...this.subscriptionsValue }
+      delete remaining[subscription.endpoint]
+      this.subscriptionsValue = remaining
+    }
+
+    this.#setEnabled(false)
+  }
+
+  async #syncGrantedState() {
+    const subscription = await this.#currentSubscription()
+    const subscribed = Boolean(subscription && subscription.endpoint in this.subscriptionsValue)
+    this.#setEnabled(subscribed)
+  }
+
+  async #subscribe() {
+    const registration = await this.#serviceWorkerRegistration()
+    const applicationServerKey = this.#base64UrlToUint8Array(this.#vapidPublicKey)
+    let subscription = await registration.pushManager.getSubscription()
+
+    if (subscription && !this.#sameApplicationServerKey(subscription, applicationServerKey)) {
+      await subscription.unsubscribe()
+      subscription = null
+    }
+
+    return subscription || await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey
+    })
+  }
+
+  async #currentSubscription() {
+    const registration = await navigator.serviceWorker.getRegistration("/")
+    return await registration?.pushManager?.getSubscription()
+  }
+
+  async #serviceWorkerRegistration() {
+    const registration = await navigator.serviceWorker.getRegistration("/") ||
+      await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    await navigator.serviceWorker.ready
+    return await navigator.serviceWorker.getRegistration("/") || registration
+  }
+
+  async #observePermissionChanges() {
+    if (!("permissions" in navigator)) return
+
+    try {
+      this.permissionStatus = await navigator.permissions.query({ name: "notifications" })
+      this.permissionStatus.addEventListener("change", this.handleWindowFocus)
+    } catch {
+      // Permissions API for notifications not supported
+    }
+  }
+
+  #serializeSubscription(subscription) {
+    const json = subscription.toJSON ? subscription.toJSON() : {}
+    const endpoint = subscription.endpoint || json.endpoint
+    const p256dh_key = json.keys?.p256dh || this.#encodeKey(subscription.getKey?.("p256dh"))
+    const auth_key = json.keys?.auth || this.#encodeKey(subscription.getKey?.("auth"))
+
+    return {
+      push_subscription: { endpoint, p256dh_key, auth_key }
+    }
+  }
+
+  #encodeKey(buffer) {
+    if (!buffer) return ""
+
+    const bytes = new Uint8Array(buffer)
+    let binary = ""
+    bytes.forEach((byte) => binary += String.fromCharCode(byte))
+    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+  }
+
+  #base64UrlToUint8Array(base64String) {
+    const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = atob(base64)
+    return Uint8Array.from(rawData, (char) => char.charCodeAt(0))
+  }
+
+  #sameApplicationServerKey(subscription, expectedKey) {
+    const existingKey = subscription.options?.applicationServerKey
+    if (!existingKey) return true
+
+    const existingBytes = new Uint8Array(existingKey)
+    if (existingBytes.byteLength !== expectedKey.byteLength) return false
+
+    return existingBytes.every((byte, index) => byte === expectedKey[index])
+  }
+
+  #setEnabled(enabled) {
+    this.element.classList.toggle(this.#enabledClass, enabled)
+    if (this.hasToggleTarget) {
+      this.toggleTarget.checked = enabled
+    }
+  }
+
+  #setToggleDisabled(disabled) {
+    if (this.hasToggleTarget) {
+      this.toggleTarget.disabled = disabled
+    }
+  }
+
+  #showBlockedHelp() {
+    this.detailsTargets.forEach((element) => element.hidden = false)
+    if (this.hasExplainerTarget) this.explainerTarget.hidden = false
+  }
+
+  #showInstallOnlyHelp() {
+    this.detailsTargets.forEach((element) => element.hidden = true)
+    if (this.hasExplainerTarget) {
+      this.explainerTarget.hidden = this.explainerTarget.querySelectorAll(".pwa__instructions").length === 0
+    }
+  }
+
+  #hideHelp() {
+    this.detailsTargets.forEach((element) => element.hidden = true)
+    if (this.hasExplainerTarget) this.explainerTarget.hidden = true
+  }
+
+  get #pushSupported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window && Boolean(this.#vapidPublicKey)
+  }
+
+  get #vapidPublicKey() {
+    return this.vapidPublicKeyValue || getMetaContent("vapid-public-key")
+  }
+
+  get #enabledClass() {
+    return this.hasEnabledClass ? this.enabledClass : "notifications--on"
+  }
+}
