diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..20ca046
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:kevin)
+    sign_in_as @user
+  end
+
+  test "create registers a push subscription for current user" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://fcm.googleapis.com/fcm/send/device-1",
+          p256dh_key: "p256dh-key-1",
+          auth_key: "auth-key-1"
+        }
+      }, headers: { "HTTP_USER_AGENT" => "Mozilla/5.0 Chrome/130.0" }
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://fcm.googleapis.com/fcm/send/device-1", subscription.endpoint
+    assert_equal "p256dh-key-1", subscription.p256dh_key
+    assert_equal "auth-key-1", subscription.auth_key
+    assert_equal "Mozilla/5.0 Chrome/130.0", subscription.user_agent
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create as JSON returns subscription id and url" do
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: {
+        endpoint: "https://web.push.apple.com/device-json",
+        p256dh_key: "p256dh-json",
+        auth_key: "auth-json"
+      }
+    }, as: :json
+
+    assert_response :created
+    subscription = @user.push_subscriptions.find_by!(endpoint: "https://web.push.apple.com/device-json")
+    assert_equal subscription.id, response.parsed_body["id"]
+    assert_equal user_push_subscription_path(@user, subscription), response.parsed_body["url"]
+  end
+
+  test "create updates existing subscription for same endpoint idempotently" do
+    existing = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/same-endpoint",
+      p256dh_key: "old-p256dh",
+      auth_key: "old-auth"
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: existing.endpoint,
+          p256dh_key: "new-p256dh",
+          auth_key: "new-auth"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "new-p256dh", existing.reload.p256dh_key
+    assert_equal "new-auth", existing.auth_key
+  end
+
+  test "create rejects invalid endpoint" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "http://insecure.example.com/push",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "cannot create or destroy push subscriptions for another user" do
+    other_user = users(:david)
+    other_subscription = other_user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/david-device",
+      p256dh_key: "david-p256dh",
+      auth_key: "david-auth"
+    )
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(other_user), params: {
+        push_subscription: {
+          endpoint: "https://fcm.googleapis.com/fcm/send/hijack",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }
+      assert_response :forbidden
+
+      delete user_push_subscription_path(other_user, other_subscription)
+      assert_response :forbidden
+    end
+  end
+
+  test "destroy removes push subscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/remove-me",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+end
diff --git a/test/models/notification/pushing_test.rb b/test/models/notification/pushing_test.rb
new file mode 100644
index 0000000..0823830
--- /dev/null
+++ b/test/models/notification/pushing_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class Notification::PushingTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @david = users(:david)
+    @client_ec = OpenSSL::PKey::EC.generate("prime256v1")
+    @p256dh_key = Base64.urlsafe_encode64(@client_ec.public_key.to_bn.to_s(2), padding: false)
+    @auth_key = Base64.urlsafe_encode64(Random.bytes(16), padding: false)
+  end
+
+  test "sends push notifications to all user subscriptions when a notification is created" do
+    phone = subscribe(@kevin, "https://web.push.apple.com/phone-token")
+    desktop = subscribe(@kevin, "https://fcm.googleapis.com/fcm/send/desktop-token")
+
+    phone_stub = stub_request(:post, phone.endpoint).to_return(status: 201)
+    desktop_stub = stub_request(:post, desktop.endpoint).to_return(status: 201)
+
+    notifications(:layout_commented_kevin).destroy
+
+    perform_enqueued_jobs do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    end
+
+    assert_requested phone_stub
+    assert_requested desktop_stub
+  end
+
+  test "push payload says what the tray says and opens the card it is about for events" do
+    subscription = subscribe(@kevin, "https://fcm.googleapis.com/fcm/send/kevin-device")
+    notifications(:layout_commented_kevin).destroy
+    event = events(:layout_commented)
+    card = event.card
+
+    delivered = nil
+    Push::Subscription.any_instance.expects(:deliver).with do |**kwargs|
+      delivered = kwargs
+      true
+    end
+
+    perform_enqueued_jobs do
+      Notification.create!(user: @kevin, source: event, creator: @david)
+    end
+
+    assert_equal "RE: #{card.title}", delivered[:title]
+    assert_equal event.eventable.body.to_plain_text.truncate(200), delivered[:body]
+    assert_equal "#{@kevin.account.slug}/cards/#{card.number}", delivered[:path]
+  end
+
+  test "push payload says what the tray says and opens the card it is about for mentions" do
+    subscription = subscribe(@david, "https://fcm.googleapis.com/fcm/send/david-device")
+    notifications(:logo_mentioned_david).destroy
+    mention = mentions(:logo_comment_david_mention_by_jz)
+
+    delivered = nil
+    Push::Subscription.any_instance.expects(:deliver).with do |**kwargs|
+      delivered = kwargs
+      true
+    end
+
+    perform_enqueued_jobs do
+      Notification.create!(user: @david, source: mention, creator: mention.mentioner)
+    end
+
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", delivered[:title]
+    assert_equal mention.source.mentionable_content.truncate(200), delivered[:body]
+    assert_equal "#{@david.account.slug}/cards/#{mention.card.number}", delivered[:path]
+    assert_not_nil subscription
+  end
+
+  test "sends push notification when an existing card notification is updated with a new source" do
+    subscription = subscribe(@kevin, "https://fcm.googleapis.com/fcm/send/kevin-update")
+    stub = stub_request(:post, subscription.endpoint).to_return(status: 201)
+
+    card = cards(:logo)
+    card.watch_by(@kevin)
+
+    perform_enqueued_jobs do
+      card.comments.create!(creator: @david, body: "Fresh update on the logo")
+    end
+
+    assert_requested stub
+  end
+
+  test "reading or unreading a notification does not send a push notification" do
+    subscription = subscribe(@kevin, "https://fcm.googleapis.com/fcm/send/kevin-read")
+    stub = stub_request(:post, subscription.endpoint).to_return(status: 201)
+    notification = notifications(:logo_assignment_kevin)
+
+    perform_enqueued_jobs do
+      notification.read
+      notification.unread
+    end
+
+    assert_not_requested stub
+  end
+
+  test "expired subscription on one device does not prevent push to other devices" do
+    stale_device = subscribe(@kevin, "https://fcm.googleapis.com/fcm/send/stale-device")
+    active_device = subscribe(@kevin, "https://fcm.googleapis.com/fcm/send/active-device")
+
+    stub_request(:post, stale_device.endpoint).to_return(status: 410)
+    active_stub = stub_request(:post, active_device.endpoint).to_return(status: 201)
+
+    notifications(:layout_commented_kevin).destroy
+
+    perform_enqueued_jobs do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    end
+
+    assert_not Push::Subscription.exists?(stale_device.id)
+    assert Push::Subscription.exists?(active_device.id)
+    assert_requested active_stub
+  end
+
+  private
+    def subscribe(user, endpoint)
+      user.push_subscriptions.create!(
+        endpoint: endpoint,
+        p256dh_key: @p256dh_key,
+        auth_key: @auth_key
+      )
+    end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..93eab45
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,189 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  PUBLIC_TEST_IP = "93.184.216.34"
+
+  setup do
+    @user = users(:kevin)
+    @client_ec = OpenSSL::PKey::EC.generate("prime256v1")
+    @p256dh_key = Base64.urlsafe_encode64(@client_ec.public_key.to_bn.to_s(2), padding: false)
+    @auth_key = Base64.urlsafe_encode64(Random.bytes(16), padding: false)
+  end
+
+  test "validates endpoint, p256dh_key, and auth_key" do
+    subscription = @user.push_subscriptions.new(
+      endpoint: "https://fcm.googleapis.com/fcm/send/token-123",
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+    assert subscription.valid?
+    assert_equal @user.account, subscription.account
+
+    subscription.endpoint = "http://fcm.googleapis.com/fcm/send/token-123"
+    assert_not subscription.valid?
+
+    subscription.endpoint = "https://localhost/push"
+    assert_not subscription.valid?
+
+    subscription.endpoint = "https://127.0.0.1/push"
+    assert_not subscription.valid?
+
+    subscription.endpoint = "https://169.254.169.254/latest/meta-data"
+    assert_not subscription.valid?
+
+    subscription.endpoint = "not a url"
+    assert_not subscription.valid?
+  end
+
+  test "delivers encrypted web push payload signed with VAPID keys" do
+    vapid_key = WebPush.generate_key
+    with_vapid_keys(public_key: vapid_key.public_key, private_key: vapid_key.private_key) do
+      subscription = @user.push_subscriptions.create!(
+        endpoint: "https://fcm.googleapis.com/fcm/send/token-123",
+        p256dh_key: @p256dh_key,
+        auth_key: @auth_key
+      )
+
+      captured_request = nil
+      stub_request(:post, subscription.endpoint)
+        .with { |request| captured_request = request; true }
+        .to_return(status: 201)
+
+      subscription.deliver(title: "Design new logo", body: "Assigned to Kevin", path: "/897362094/cards/1")
+
+      assert_not_nil captured_request
+      assert_equal "aes128gcm", captured_request.headers["Content-Encoding"]
+      assert_match(/\Avapid t=.+,k=#{Regexp.escape(vapid_key.public_key.delete("="))}\z/, captured_request.headers["Authorization"])
+
+      decrypted = decrypt_aes128gcm(captured_request.body, @client_ec, @auth_key)
+      payload = JSON.parse(decrypted)
+
+      assert_equal "Design new logo", payload["title"]
+      assert_equal "Assigned to Kevin", payload.dig("options", "body")
+      assert_equal "/897362094/cards/1", payload.dig("options", "data", "path")
+    end
+  end
+
+  test "destroys subscription when push service responds with 410 Gone or 404 Not Found or 401 Unauthorized" do
+    [ 410, 404, 401 ].each do |status|
+      subscription = @user.push_subscriptions.create!(
+        endpoint: "https://fcm.googleapis.com/fcm/send/token-#{status}",
+        p256dh_key: @p256dh_key,
+        auth_key: @auth_key
+      )
+
+      stub_request(:post, subscription.endpoint).to_return(status: status)
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        subscription.deliver(title: "Card 1", body: "Added by David", path: "/897362094/cards/1")
+      end
+    end
+  end
+
+  test "retains subscription on transient push service failure" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/transient-500",
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+
+    stub_request(:post, subscription.endpoint).to_return(status: 503)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      subscription.deliver(title: "Card 1", body: "Added by David", path: "/897362094/cards/1")
+    end
+  end
+
+  test "pins resolved public IP and blocks private DNS resolution" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://example.com/push",
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+
+    stub_dns_resolution(PUBLIC_TEST_IP)
+    pinned_stub = stub_request(:post, "https://example.com/push")
+      .with(ipaddr: PUBLIC_TEST_IP)
+      .to_return(status: 201)
+
+    subscription.deliver(title: "Card 1", body: "Added by David", path: "/897362094/cards/1")
+    assert_requested pinned_stub
+
+    WebMock.reset!
+    stub_dns_resolution("169.254.169.254")
+    blocked_stub = stub_request(:post, "https://example.com/push").to_return(status: 201)
+
+    subscription.deliver(title: "Card 1", body: "Added by David", path: "/897362094/cards/1")
+    assert_not_requested blocked_stub
+  end
+
+  test "skips delivery when VAPID keys are not configured" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/unconfigured",
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+
+    with_vapid_keys(public_key: "", private_key: "") do
+      stub = stub_request(:post, subscription.endpoint).to_return(status: 201)
+      subscription.deliver(title: "Card 1", body: "Added by David", path: "/897362094/cards/1")
+      assert_not_requested stub
+    end
+  end
+
+  test "destroying session destroys associated push subscriptions" do
+    session = sessions(:kevin)
+    subscription = @user.push_subscriptions.create!(
+      session: session,
+      endpoint: "https://fcm.googleapis.com/fcm/send/session-bound",
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      session.destroy
+    end
+    assert_not Push::Subscription.exists?(subscription.id)
+  end
+
+  private
+    def with_vapid_keys(public_key:, private_key:)
+      old_public, old_private = ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"]
+      ENV["VAPID_PUBLIC_KEY"] = public_key
+      ENV["VAPID_PRIVATE_KEY"] = private_key
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = old_public
+      ENV["VAPID_PRIVATE_KEY"] = old_private
+    end
+
+    def decrypt_aes128gcm(body, client_ec, auth_key)
+      salt = body.byteslice(0, 16)
+      _rs = body.byteslice(16, 4).unpack1("N")
+      idlen = body.byteslice(20, 1).unpack1("C")
+      server_pub_bytes = body.byteslice(21, idlen)
+      ciphertext_and_tag = body.byteslice(21 + idlen, body.bytesize - 21 - idlen)
+
+      server_point = OpenSSL::PKey::EC::Point.new(client_ec.group, OpenSSL::BN.new(server_pub_bytes, 2))
+      shared_secret = client_ec.dh_compute_key(server_point)
+      client_pub_bytes = client_ec.public_key.to_bn.to_s(2)
+      auth_secret = Base64.urlsafe_decode64(auth_key)
+
+      prk_key = OpenSSL::HMAC.digest("SHA256", auth_secret, shared_secret)
+      key_info = "WebPush: info\x00".b + client_pub_bytes + server_pub_bytes + "\x01".b
+      ikm = OpenSSL::HMAC.digest("SHA256", prk_key, key_info)
+
+      prk = OpenSSL::HMAC.digest("SHA256", salt, ikm)
+      cek = OpenSSL::HMAC.digest("SHA256", prk, "Content-Encoding: aes128gcm\x00\x01".b).byteslice(0, 16)
+      nonce = OpenSSL::HMAC.digest("SHA256", prk, "Content-Encoding: nonce\x00\x01".b).byteslice(0, 12)
+
+      cipher = OpenSSL::Cipher.new("aes-128-gcm")
+      cipher.decrypt
+      cipher.key = cek
+      cipher.iv = nonce
+      cipher.auth_tag = ciphertext_and_tag.byteslice(-16, 16)
+      decrypted = cipher.update(ciphertext_and_tag.byteslice(0, ciphertext_and_tag.bytesize - 16)) + cipher.final
+
+      decrypted.sub(/\x02\x00*\z/n, "").force_encoding("UTF-8")
+    end
+end
