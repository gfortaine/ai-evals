diff --git a/test/controllers/books/releases_controller_test.rb b/test/controllers/books/releases_controller_test.rb
new file mode 100644
index 0000000..88d90b7
--- /dev/null
+++ b/test/controllers/books/releases_controller_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    sign_in :david
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "releasing a book shows the new title as published in recently updated on the library page" do
+    book = books(:manual)
+
+    get edit_book_release_path(book)
+    assert_response :success
+
+    patch book_release_path(book), params: { book: { title: "Complete Guide", subtitle: "First Edition" } }
+    assert_redirected_to root_path
+
+    follow_redirect!
+    assert_response :success
+    assert_in_body "Recently updated"
+    assert_in_body "Complete Guide"
+    assert_in_body "Published"
+    assert_not_in_body "Manual"
+
+    get book_slug_path(book.reload)
+    assert_response :success
+    assert_in_body "Complete Guide"
+  end
+
+  test "ordinary book rename updates recently updated without overwriting another book's recap" do
+    Book.finalize_release(books(:manual).id, title: "Complete Guide")
+
+    patch book_path(books(:handbook)), params: { book: { title: "Company Playbook" } }
+    assert_redirected_to book_slug_path(books(:handbook))
+
+    get root_path
+    assert_response :success
+    assert_in_body "Complete Guide"
+    assert_in_body "Published"
+    assert_in_body "Company Playbook"
+    assert_in_body "Draft"
+    assert_not_in_body "Manual"
+  end
+
+  test "non-editors cannot release a book" do
+    sign_in :jz
+
+    patch book_release_path(books(:manual)), params: { book: { title: "Unauthorized Release" } }
+    assert_response :forbidden
+    assert_not books(:manual).reload.published?
+  end
+end
diff --git a/test/models/book/recap_test.rb b/test/models/book/recap_test.rb
new file mode 100644
index 0000000..ed33881
--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "releasing a draft book caches the released title and published status" do
+    book = books(:manual)
+
+    assert Book.finalize_release(book.id, title: "Complete Guide", subtitle: "First Edition")
+
+    book.reload
+    assert_equal "Complete Guide", book.title
+    assert_equal "First Edition", book.subtitle
+    assert book.published?
+    assert_equal({ title: "Complete Guide", published: true }, book.cached_recap)
+  end
+
+  test "releasing an already published book returns false without overwriting its recap" do
+    book = books(:manual)
+    book.update!(title: "Published Guide", published: true)
+
+    assert_not Book.finalize_release(book.id, title: "Ignored Title")
+
+    assert_equal "Published Guide", book.reload.title
+    assert_equal({ title: "Published Guide", published: true }, book.cached_recap)
+  end
+
+  test "renaming a book the ordinary way updates its recap" do
+    book = books(:handbook)
+    book.update!(title: "Company Playbook")
+
+    assert_equal({ title: "Company Playbook", published: false }, book.cached_recap)
+  end
+
+  test "updating separate instances of the same book in a transaction caches committed state" do
+    first_handle = Book.find(books(:manual).id)
+    second_handle = Book.find(books(:manual).id)
+
+    Book.transaction do
+      first_handle.update!(published: true)
+      second_handle.update!(title: "Final Title")
+    end
+
+    assert_equal({ title: "Final Title", published: true }, books(:manual).cached_recap)
+  end
+
+  test "recaps stay per book so saving one never overwrites another" do
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    handbook.update!(title: "Team Handbook")
+    Book.finalize_release(manual.id, title: "Released Manual")
+
+    assert_equal({ title: "Team Handbook", published: false }, handbook.cached_recap)
+    assert_equal({ title: "Released Manual", published: true }, manual.cached_recap)
+  end
+
+  test "recaps expire on the configured schedule" do
+    original_expires_in = Rails.application.config.x.recap.expires_in
+    Rails.application.config.x.recap.expires_in = 15.minutes
+
+    book = books(:handbook)
+    book.update!(title: "Expiring Title")
+
+    travel 14.minutes do
+      assert_equal({ title: "Expiring Title", published: false }, book.cached_recap)
+    end
+
+    travel 16.minutes do
+      assert_nil book.cached_recap
+    end
+  ensure
+    Rails.application.config.x.recap.expires_in = original_expires_in
+  end
+end
