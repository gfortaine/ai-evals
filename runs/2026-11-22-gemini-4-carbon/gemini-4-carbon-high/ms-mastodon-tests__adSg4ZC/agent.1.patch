diff --git a/spec/support/redis.rb b/spec/support/redis.rb
new file mode 100644
index 0000000..e38140a
--- /dev/null
+++ b/spec/support/redis.rb
@@ -0,0 +1,21 @@
+# frozen_string_literal: true
+
+module RedisTestTracker
+  @dirty = false
+
+  class << self
+    attr_accessor :dirty
+  end
+
+  def call(command, config)
+    RedisTestTracker.dirty = true
+    super
+  end
+
+  def call_pipelined(commands, config)
+    RedisTestTracker.dirty = true unless commands.empty?
+    super
+  end
+end
+
+RedisClient.register(RedisTestTracker)
diff --git a/spec/support/sidekiq_mailer_test_helper.rb b/spec/support/sidekiq_mailer_test_helper.rb
new file mode 100644
index 0000000..bb0c050
--- /dev/null
+++ b/spec/support/sidekiq_mailer_test_helper.rb
@@ -0,0 +1,21 @@
+# frozen_string_literal: true
+
+module SidekiqMailerTestHelper
+  def deliver_enqueued_emails(queue: nil, at: nil, &block)
+    return super unless ActiveJob::Base.queue_adapter_name == 'sidekiq' && Sidekiq::Testing.fake?
+
+    target_queue = (queue || ActionMailer::Base.deliver_later_queue_name || 'mailers').to_s
+    before_jids = block ? Sidekiq::Queues[target_queue].to_set { |job| job['jid'] } : Set.new
+    res = block&.call
+
+    jobs = Sidekiq::Queues[target_queue].reject { |job| before_jids.include?(job['jid']) }
+    jobs.each do |job|
+      next if at && job['at'] && Time.at(job['at']) > at
+
+      Sidekiq::Queues.delete_for(job['jid'], job['queue'], job['class'])
+      Object.const_get(job['class']).process_job(job)
+    end
+
+    res
+  end
+end
