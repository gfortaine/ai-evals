+# frozen_string_literal: true
+
+module DeviseEncryptorMemoization
+  def digest(klass, password)
+    @digest_cache ||= {}
+    key = [klass.stretches, klass.pepper, password.to_s]
+    (@digest_cache[key] ||= super).dup
+  end
+end
+
+Devise::Encryptor.singleton_class.prepend(DeviseEncryptorMemoization)
