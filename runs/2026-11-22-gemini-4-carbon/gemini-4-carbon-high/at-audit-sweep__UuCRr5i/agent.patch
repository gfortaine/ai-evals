diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..d8a302b 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,72 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+test "editor and administrator can edit, update, and destroy a book" do
+  get edit_book_path(books(:handbook))
+  assert_response :success
+
+  patch book_path(books(:handbook)), params: { book: { title: "Updated Handbook" } }
+  assert_redirected_to book_slug_url(books(:handbook).reload)
+  assert_equal "Updated Handbook", books(:handbook).title
+
+  assert_difference -> { Book.count }, -1 do
+    delete book_path(books(:handbook))
+  end
+  assert_redirected_to root_url
+
+  sign_in :david
+  assert_difference -> { Book.count }, -1 do
+    delete book_path(books(:manual))
+  end
+  assert_redirected_to root_url
+end
+
+test "reader cannot edit, update, or destroy a book" do
+  sign_in :jz
+
+  get edit_book_path(books(:handbook))
+  assert_response :forbidden
+
+  patch book_path(books(:handbook)), params: { book: { title: "Tampered" } }
+  assert_response :forbidden
+  assert_equal "Handbook", books(:handbook).reload.title
+
+  assert_no_difference -> { Book.count } do
+    delete book_path(books(:handbook))
+  end
+  assert_response :forbidden
+end
+
+test "signed in user without edit access cannot edit, update, or destroy a published book" do
+  books(:manual).update!(published: true)
+
+  get edit_book_path(books(:manual))
+  assert_response :forbidden
+
+  patch book_path(books(:manual)), params: { book: { title: "Tampered" } }
+  assert_response :forbidden
+  assert_equal "Manual", books(:manual).reload.title
+
+  assert_no_difference -> { Book.count } do
+    delete book_path(books(:manual))
+  end
+  assert_response :forbidden
+
+  orphan_published = Book.create!(title: "Public World Book", slug: "public-world-book", published: true, everyone_access: false)
+  assert_no_difference -> { Book.count } do
+    delete book_path(orphan_published)
+  end
+  assert_response :forbidden
+end
+
+test "unauthenticated user cannot destroy a published book" do
+  sign_out
+  books(:manual).update!(published: true)
+
+  assert_no_difference -> { Book.count } do
+    delete book_path(books(:manual))
+  end
+  assert_redirected_to new_session_url
+end
 end
diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..28a9ee6 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,79 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+test "show does not render leaves from an unreadable book under any book id" do
+  secret_page = books(:manual).press Page.new(body: "Top secret manual content"), title: "Secret Page"
+  secret_section = books(:manual).press Section.new(body: "Top secret section"), title: "Secret Section"
+  secret_picture = books(:manual).press Picture.new(caption: "Top secret picture"), title: "Secret Picture"
+
+  get slugged_leafable_path(books(:handbook), books(:handbook).slug, secret_page, secret_page.slug)
+  assert_response :not_found
+
+  get slugged_leafable_path(books(:handbook), books(:handbook).slug, secret_page, secret_page.slug, format: :md)
+  assert_response :not_found
+
+  get book_page_path(books(:handbook), secret_page)
+  assert_response :not_found
+
+  get book_section_path(books(:handbook), secret_section)
+  assert_response :not_found
+
+  get book_picture_path(books(:handbook), secret_picture)
+  assert_response :not_found
+
+  get slugged_leafable_path(books(:manual), books(:manual).slug, secret_page, secret_page.slug)
+  assert_response :not_found
+
+  get slugged_leafable_path(999999, "none", secret_page, secret_page.slug)
+  assert_response :not_found
+end
+
+test "show allows reader and signed-in user on published book to read allowed pages" do
+  manual_page = books(:manual).press Page.new(body: "Readable manual content"), title: "Manual Page"
+
+  sign_in :jz
+  get leafable_slug_path(manual_page)
+  assert_response :success
+  assert_in_body "Readable manual content"
+
+  sign_in :kevin
+  books(:manual).update!(published: true)
+  get leafable_slug_path(manual_page)
+  assert_response :success
+  assert_in_body "Readable manual content"
+end
+
+test "show when signed out does not render a page from an unpublished book under a published book id" do
+  sign_out
+  books(:handbook).update!(published: true)
+  secret_leaf = books(:manual).press Page.new(body: "Unpublished secret"), title: "Secret Page"
+
+  get slugged_leafable_path(books(:handbook), books(:handbook).slug, secret_leaf, secret_leaf.slug)
+  assert_response :not_found
+
+  get book_page_path(books(:handbook), secret_leaf)
+  assert_response :not_found
+
+  get leafable_slug_path(leaves(:welcome_page))
+  assert_response :success
+  assert_select "p", "This is such a great handbook."
+end
+
+test "editor of one book cannot edit, update, or destroy a leaf from another book" do
+  secret_leaf = books(:manual).press Page.new(body: "Untouchable"), title: "Secret Page"
+
+  get edit_book_page_path(books(:handbook), secret_leaf)
+  assert_response :not_found
+
+  put book_page_path(books(:handbook), secret_leaf), params: {
+    leaf: { title: "Tampered" }, page: { body: "Tampered body" }
+  }
+  assert_response :not_found
+  assert_equal "Secret Page", secret_leaf.reload.title
+
+  delete book_page_path(books(:handbook), secret_leaf)
+  assert_response :not_found
+  assert secret_leaf.reload.active?
+end
 end
diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..b489c62
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "show finds matching pages in readable books" do
+    get library_search_path, params: { q: "welcome" }
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Summary"
+  end
+
+  test "show does not return trashed pages" do
+    leaves(:welcome_page).trashed!
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "show does not return pages from unreadable books via SQL injection" do
+    books(:manual).press Page.new(body: "Secret body"), title: "Confidential Manual Page"
+
+    [ "' or '1'='1", "' or 1=1) --", "' or 1=1 --", "'; SELECT 1; --" ].each do |payload|
+      get library_search_path, params: { q: payload }
+
+      assert_response :success
+      assert_not_in_body "Confidential Manual Page"
+    end
+  end
+
+  test "show handles apostrophes and punctuation without error and finds matching titles" do
+    leaves(:welcome_page).update!(title: "What's in O'Reilly's Guide?")
+
+    get library_search_path, params: { q: "O'Reilly's" }
+
+    assert_response :success
+    assert_in_body "What&#39;s in O&#39;Reilly&#39;s Guide?"
+
+    get library_search_path, params: { q: "it's not there!" }
+
+    assert_response :success
+    assert_in_body "No matches."
+  end
+
+  test "show finds Save 50% off by full title and by percent sign without wildcard matching" do
+    leaves(:welcome_page).update!(title: "Save 50% off")
+    books(:handbook).press Page.new(body: "Other"), title: "Save 500 off"
+
+    get library_search_path, params: { q: "Save 50% off" }
+
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save 500 off"
+    assert_not_in_body "Summary"
+
+    get library_search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save 500 off"
+    assert_not_in_body "Summary"
+  end
+
+  test "show treats underscore as a literal character rather than a wildcard" do
+    leaves(:welcome_page).update!(title: "user_guide")
+    books(:handbook).press Page.new(body: "Other"), title: "userXguide"
+
+    get library_search_path, params: { q: "user_guide" }
+
+    assert_response :success
+    assert_in_body "user_guide"
+    assert_not_in_body "userXguide"
+    assert_not_in_body "Summary"
+
+    get library_search_path, params: { q: "_" }
+
+    assert_response :success
+    assert_in_body "user_guide"
+    assert_not_in_body "userXguide"
+    assert_not_in_body "Summary"
+  end
+
+  test "show treats backslash as a literal character" do
+    leaves(:welcome_page).update!(title: "C:\\Users\\Docs")
+
+    get library_search_path, params: { q: "\\" }
+
+    assert_response :success
+    assert_in_body "C:\\Users\\Docs"
+    assert_not_in_body "Summary"
+  end
+
+  test "show when signed out only searches published books" do
+    sign_out
+    books(:handbook).update!(published: true)
+    books(:manual).press Page.new(body: "Secret"), title: "Welcome Secret"
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Welcome Secret"
+  end
+
+  test "show when signed out with no published books returns no matches" do
+    sign_out
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+end
