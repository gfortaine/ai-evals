-      end
+    accesses = build_accesses
+    return Result.new([], nil) if accesses.empty?
+
+    raise ActiveRecord::RecordNotSaved, "You cannot call create unless the parent is saved" unless @book.persisted?
+
+    user_ids = accesses.filter_map(&:user_id).uniq
+    users_by_id = User.where(id: user_ids).index_by(&:id)
+    seen_user_ids = existing_user_ids_for(user_ids)
+
+    accesses.each_with_index do |access, index|
+      access.association(:user).target = users_by_id[access.user_id]
