     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
+    persisted_accesses = insert_accesses(accesses, users_by_id)
+    return Result.new([], find_duplicate_index(accesses, user_ids)) unless persisted_accesses
+
+    ActiveJob.perform_all_later(persisted_accesses.map { |access| Book::AccessNotificationJob.new(access) })
+
+    Result.new(persisted_accesses, nil)
   end
+
+  private
+    def build_accesses
+      @grants.map do |grant|
+        Access.new(book: @book, user_id: grant[:user_id], level: grant[:level])
+      end
+    end
+
+    def existing_user_ids_for(user_ids)
+      @book.accesses.where(user_id: user_ids).pluck(:user_id).to_set
+    end
+
+    def insert_accesses(accesses, users_by_id)
+      now = Time.current
+      rows = accesses.map do |access|
+        {
+          user_id: access.user_id,
+          level: access.level,
+          created_at: now,
+          updated_at: now
+        }
+      end
+
+      result = @book.accesses.insert_all!(rows, returning: Access.column_names)
+      inserted_by_user_id = result.to_h do |row|
+        access = Access.instantiate(row)
+        access.association(:book).target = @book
+        access.association(:user).target = users_by_id[access.user_id]
+        [ access.user_id, access ]
+      end
+
+      accesses.map { |access| inserted_by_user_id.fetch(access.user_id) }
+    rescue ActiveRecord::RecordNotUnique
+      nil
+    end
+
+    def find_duplicate_index(accesses, user_ids)
+      seen_user_ids = existing_user_ids_for(user_ids)
+      accesses.index { |access| !seen_user_ids.add?(access.user_id) }
+    end
 end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
