+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.publish
+  end
+
+  test "anyone can view a published board without authentication" do
+    get public_board_path(@publication)
+
+    assert_response :success
+    assert_equal "none", response.headers["X-Robots-Tag"]
+    assert_select "h1", text: @board.name
+    assert_select "h3.card__title", text: cards(:buy_domain).title
+  end
+
+  test "published board can also be opened without an account slug prefix" do
+    untenanted do
+      get public_board_path(@publication)
+    end
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "h3.card__title", text: cards(:buy_domain).title
+  end
+
+  test "published private board is visible via secret public URL even to users without board access" do
+    private_board = boards(:private)
+    Current.with(session: sessions(:kevin)) do
+      private_board.cards.create!(creator: users(:kevin), title: "Public roadmap item", status: :published)
+    end
+    publication = private_board.publish
+
+    get public_board_path(publication)
+    assert_response :success
+    assert_select "h3.card__title", text: "Public roadmap item"
