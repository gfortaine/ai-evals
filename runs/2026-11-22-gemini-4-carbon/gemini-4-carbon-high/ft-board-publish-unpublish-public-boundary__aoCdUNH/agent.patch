+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admin can publish board" do
+    assert_not @board.published?
+
+    assert_difference -> { Board::Publication.count }, +1 do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+  end
+
+  test "admin can publish board as turbo stream" do
+    post board_publication_path(@board), as: :turbo_stream
+
+    assert_response :success
+    assert @board.reload.published?
+    assert_turbo_stream action: :replace, target: dom_id(@board, :publication)
+  end
+
+  test "admin can publish board as JSON" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert @board.reload.published?
+    assert_equal public_board_url(@board.publication), @response.parsed_body["public_url"]
+  end
+
+  test "owner can publish and unpublish board" do
+    @board.accesses.grant_to(users(:jason))
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    assert @board.reload.published?
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "admin can unpublish board" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "admin can unpublish board as turbo stream" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :turbo_stream
+
+    assert_response :success
+    assert_not @board.reload.published?
+    assert_turbo_stream action: :replace, target: dom_id(@board, :publication)
+  end
+
+  test "admin can unpublish board as JSON" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin member cannot publish or unpublish board" do
+    logout_and_sign_in_as :jz
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board)
+    end
+    assert_response :forbidden
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+
+    @board.publish
+
+    assert_no_difference -> { Board::Publication.count } do
+      delete board_publication_path(@board)
+    end
+    assert_response :forbidden
+
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "non-admin board creator cannot publish or unpublish board" do
+    logout_and_sign_in_as :david
+    assert_equal users(:david), @board.creator
+    assert_not users(:david).admin?
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board)
+    end
+    assert_response :forbidden
+
+    @board.publish
+
+    assert_no_difference -> { Board::Publication.count } do
+      delete board_publication_path(@board), as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "cannot publish or unpublish board without board access" do
+    logout_and_sign_in_as :jason
+    private_board = boards(:private)
+
+    post board_publication_path(private_board), as: :json
+    assert_response :not_found
+
+    private_board.publish
+    delete board_publication_path(private_board), as: :json
+    assert_response :not_found
+  end
+
+  test "edit page displays public link settings for admin" do
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "input.switch__input[name='published']:not([disabled])"
+
+    @board.publish
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "input[value='#{public_board_url(@board.publication)}']"
+  end
+
+  test "edit page disables public link switch for non-admin" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "input.switch__input[name='published'][disabled]"
+  end
+end
