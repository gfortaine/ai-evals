diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..e99a868
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,44 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public link</h2>
+    <p class="margin-none-block-start">Turn on the public link to share this board with anyone. Only account admins can publish or unpublish a board.</p>
+
+    <div class="flex align-center gap-half">
+      <figure class="avatar fill-selected">
+        <%= icon_tag "world" %>
+        <span class="for-screen-reader">Public link</span>
+      </figure>
+
+      <div class="min-width">
+        <div class="overflow-ellipsis"><strong>Publish to web</strong></div>
+      </div>
+
+      <hr class="separator--horizontal flex-item-grow" style="--border-color: var(--color-ink-medium); --border-style: dashed" aria-hidden="true">
+
+      <%= form_with url: board_publication_path(board), method: board.published? ? :delete : :post, data: { controller: "form" } do %>
+        <label class="switch">
+          <%= check_box_tag :published, "1", board.published?, class: "switch__input", disabled: !Current.user.admin?, data: { action: "change->form#submit" } %>
+          <span class="switch__btn round"></span>
+          <span class="for-screen-reader"><%= board.published? ? "Unpublish this board" : "Publish this board" %></span>
+        </label>
+      <% end %>
+    </div>
+
+    <% if board.published? %>
+      <% url = published_board_url(board) %>
+      <div class="flex align-center gap-half margin-block-start">
+        <input type="text" class="input flex-item-grow" value="<%= url %>" readonly aria-label="Public URL">
+
+        <%= button_to_copy_to_clipboard(url) do %>
+          <%= icon_tag "copy-paste" %>
+          <span class="for-screen-reader">Copy public link</span>
+        <% end %>
+
+        <%= link_to url, class: "btn", target: "_blank", rel: "noopener noreferrer", data: { turbo: false } do %>
+          <%= icon_tag "arrow-up" %>
+          <span class="for-screen-reader">Open public board</span>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+<% end %>
