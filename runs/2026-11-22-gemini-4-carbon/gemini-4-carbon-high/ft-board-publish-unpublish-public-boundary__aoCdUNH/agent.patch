+  test "unpublishing board makes old secret URL return not found" do
+    key = @publication.key
+    @board.unpublish
+
+    get public_board_path(key)
+    assert_response :not_found
+
+    untenanted do
+      get public_board_path(key)
+    end
+    assert_response :not_found
+  end
+
+  test "invalid key returns not found" do
+    get public_board_path("nonexistent-secret-key")
+    assert_response :not_found
+  end
+
+  test "key accessed under another account slug returns not found" do
+    other_account = accounts(:initech)
+
+    get public_board_path(@publication, script_name: other_account.slug)
+    assert_response :not_found
+  end
