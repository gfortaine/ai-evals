+    sign_in_as :david
+    assert_not private_board.accessible_to?(users(:david))
+    get public_board_path(publication)
+    assert_response :success
+    assert_select "h3.card__title", text: "Public roadmap item"
+
+    logout_and_sign_in_as :mike
+    get public_board_path(publication)
+    assert_response :success
+    assert_select "h3.card__title", text: "Public roadmap item"
+  end
+
+  test "drafted cards are not shown on public board" do
+    draft = @board.cards.create!(creator: users(:david), title: "Top secret draft card", status: :drafted)
+
+    get public_board_path(@publication)
+
+    assert_response :success
+    assert_not_includes response.body, draft.title
+  end
+
+  test "public board links to public card and column URLs without private controls" do
+    get public_board_path(@publication)
+
+    assert_response :success
+    assert_select "a[href='#{public_board_card_path(@publication, cards(:buy_domain))}']"
+    assert_select "a[href='#{public_board_column_path(@publication, columns(:writebook_in_progress))}']"
+    assert_select "a[href='#{edit_board_path(@board)}']", count: 0
+    assert_select "a[href='#{card_path(cards(:buy_domain))}']", count: 0
+  end
