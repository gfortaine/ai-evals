+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.publish
+    @card = cards(:logo)
+  end
+
+  test "can open published card of a public board directly without authentication" do
+    Current.with(session: sessions(:david)) do
+      @card.update!(description: "<p>Detailed public description</p>")
+      @card.steps.create!(content: "First step", completed: true)
+    end
+
+    get public_board_card_path(@publication, @card)
+
+    assert_response :success
+    assert_select "h1.card__title", text: @card.title
+    assert_in_body "Detailed public description"
+    assert_in_body "First step"
+    assert_select ".comment__body", text: /#{Regexp.escape(comments(:logo_1).body.to_plain_text)}/
+    assert_select "a[href='#{public_board_path(@publication)}']"
+    assert_select "a[href='#{edit_card_path(@card)}']", count: 0
+    assert_select "form[action='#{card_comments_path(@card)}']", count: 0
+  end
+
+  test "can open published card by number without account slug prefix" do
+    untenanted do
+      get public_board_card_path(@publication.key, @card.number)
+    end
+
+    assert_response :success
+    assert_select "h1.card__title", text: @card.title
+  end
+
+  test "can open closed and postponed published cards of a public board" do
+    get public_board_card_path(@publication, cards(:shipping))
+    assert_response :success
+    assert_select "h1.card__title", text: cards(:shipping).title
+
+    Current.with(session: sessions(:david)) { @card.postpone(user: users(:david)) }
+    get public_board_card_path(@publication, @card)
+    assert_response :success
+    assert_select "h1.card__title", text: @card.title
+  end
+
+  test "returns not found for drafted card on public board" do
+    draft = @board.cards.create!(creator: users(:david), title: "Unpublished draft", status: :drafted)
+
+    get public_board_card_path(@publication, draft)
+    assert_response :not_found
+  end
+
+  test "returns not found for published card belonging to another board" do
+    other_board_card = Current.with(session: sessions(:kevin)) do
+      boards(:private).cards.create!(creator: users(:kevin), title: "Private card", status: :published)
+    end
+
+    get public_board_card_path(@publication, other_board_card)
+    assert_response :not_found
+  end
+
+  test "returns not found when board is unpublished" do
+    key = @publication.key
+    @board.unpublish
+
+    get public_board_card_path(key, @card)
+    assert_response :not_found
+  end
+end
