+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "unpublished by default" do
+    assert_not @board.published?
+    assert_nil @board.public_key
+    assert_not @board.publicly_accessible?
+  end
+
+  test "publish creates a publication with a secret key" do
+    publication = @board.publish
+
+    assert @board.published?
+    assert @board.publicly_accessible?
+    assert publication.persisted?
+    assert publication.key.present?
+    assert_equal @board.account, publication.account
+    assert_equal publication.key, @board.public_key
+    assert_equal publication.key, publication.to_param
+  end
+
+  test "publish is idempotent when already published" do
+    first_publication = @board.publish
+
+    assert_no_difference -> { Board::Publication.count } do
+      second_publication = @board.publish
+      assert_equal first_publication, second_publication
+      assert_equal first_publication.key, second_publication.key
+    end
+  end
+
+  test "unpublish destroys publication and re-publishing generates a new key" do
+    first_key = @board.publish.key
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+    assert_nil @board.public_key
+
+    second_key = @board.publish.key
+    assert @board.published?
+    assert_not_equal first_key, second_key
+  end
+
+  test "destroying board destroys its publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy
+    end
+  end
+
+  test "published cards and their comments become publicly accessible when board is published" do
+    published_card = cards(:logo)
+    drafted_card = @board.cards.create!(creator: users(:david), title: "Secret draft", status: :drafted)
+    comment = comments(:logo_1)
+
+    assert_not published_card.publicly_accessible?
+    assert_not drafted_card.publicly_accessible?
+    assert_not comment.publicly_accessible?
+
+    @board.publish
+
+    assert published_card.reload.publicly_accessible?
+    assert_not drafted_card.reload.publicly_accessible?
+    assert comment.reload.publicly_accessible?
+
+    @board.unpublish
+
+    assert_not published_card.reload.publicly_accessible?
+    assert_not comment.reload.publicly_accessible?
+  end
+end
