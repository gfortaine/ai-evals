new file mode 100644
index 0000000..1142e99
--- /dev/null
+++ b/app/models/job_checkpoint.rb
@@ -0,0 +1,27 @@
+class JobCheckpoint < ApplicationRecord
+  class << self
+    def read(key)
+      ensure_table_exists!
+      where(key: key).pick(:cursor)
+    end
+
+    def write!(key, cursor)
+      upsert({ key: key, cursor: cursor }, unique_by: :key)
+    end
+
+    def clear!(key)
+      where(key: key).delete_all
+    end
+
+    def ensure_table_exists!
+      return if table_exists?
+
+      connection.create_table :job_checkpoints, if_not_exists: true do |t|
+        t.string :key, null: false, index: { unique: true }
+        t.bigint :cursor, null: false
+        t.timestamps
+      end
+      reset_column_information
+    end
+  end
+end
