diff --git a/lib/rails_ext/active_job_resque_stopping.rb b/lib/rails_ext/active_job_resque_stopping.rb
new file mode 100644
index 0000000..778b876
--- /dev/null
+++ b/lib/rails_ext/active_job_resque_stopping.rb
@@ -0,0 +1,21 @@
+require "active_job/queue_adapters/resque_adapter"
+
+module ResqueWorkerCurrentTracking
+  def perform(job, &block)
+    previous_worker = Thread.current[:resque_worker]
+    Thread.current[:resque_worker] = self
+    super
+  ensure
+    Thread.current[:resque_worker] = previous_worker
+  end
+end
+
+Resque::Worker.prepend(ResqueWorkerCurrentTracking)
+
+module ActiveJobResqueStopping
+  def stopping?
+    super || !!Thread.current[:resque_worker]&.shutdown?
+  end
+end
+
+ActiveJob::QueueAdapters::ResqueAdapter.prepend(ActiveJobResqueStopping)
