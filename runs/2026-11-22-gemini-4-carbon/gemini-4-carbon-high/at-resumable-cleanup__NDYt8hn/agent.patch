+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,291 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  setup do
+    @ordered_leaves = Leaf.order(:id).to_a
+    @first_leaf, @second_leaf, @third_leaf, @fourth_leaf = @ordered_leaves
+
+    @first_leaf.update!(title: %(""On Writing" — Introduction"))
+    @second_leaf.update!(title: %("Chapter "One" Overview"))
+    @third_leaf.update!(title: %(""Entirely Quoted""))
+    @fourth_leaf.update!(title: %("Closing "Remarks""))
+  end
+
+  test "strips outer stray quotes while preserving inner and opening quotes" do
+    TitleCleanupJob.perform_now
+
+    assert_expected_cleaned_titles
+  end
+
+  test "cleans both active and trashed leaves and updates search index" do
+    @third_leaf.trashed!
+
+    TitleCleanupJob.perform_now
+
+    assert_expected_cleaned_titles
+    assert_includes Leaf.search("Chapter One Overview"), @second_leaf
+  end
+
+  test "resumes from where it left off after ActiveJob checkpoint interruption" do
+    updated_ids = []
+
+    TitleCleanupJob.perform_later
+
+    track_leaf_updates(updated_ids) do
+      interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: @second_leaf.id.succ) do
+        perform_enqueued_jobs
+      end
+    end
+
+    assert_equal %("On Writing" — Introduction), @first_leaf.reload.title
+    assert_equal %(Chapter "One" Overview), @second_leaf.reload.title
+    assert_equal %(""Entirely Quoted""), @third_leaf.reload.title
+    assert_equal %("Closing "Remarks""), @fourth_leaf.reload.title
+    assert_equal [ @first_leaf.id, @second_leaf.id ], updated_ids
+    assert_enqueued_jobs 1, only: TitleCleanupJob
+
+    track_leaf_updates(updated_ids) do
+      perform_enqueued_jobs
+    end
+
+    assert_expected_cleaned_titles
+    assert_equal @ordered_leaves.map(&:id), updated_ids
+    assert_no_enqueued_jobs
+  end
+
+  test "resumes across multiple interruptions until the tail of the collection is done" do
+    TitleCleanupJob.perform_later
+
+    [ @first_leaf, @second_leaf, @third_leaf ].each do |leaf|
+      interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: leaf.id.succ) do
+        perform_enqueued_jobs
+      end
+      assert_enqueued_jobs 1, only: TitleCleanupJob
+    end
+
+    perform_enqueued_jobs
+
+    assert_expected_cleaned_titles
+    assert_no_enqueued_jobs
+  end
+
+  test "handles checkpoint interruption on the final leaf without redoing any leaves" do
+    updated_ids = []
+    TitleCleanupJob.perform_later
+
+    track_leaf_updates(updated_ids) do
+      interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: @fourth_leaf.id.succ) do
+        perform_enqueued_jobs
+      end
+    end
+
+    assert_enqueued_jobs 1, only: TitleCleanupJob
+
+    track_leaf_updates(updated_ids) do
+      perform_enqueued_jobs
+    end
+
+    assert_expected_cleaned_titles
+    assert_equal @ordered_leaves.map(&:id), updated_ids
+    assert_no_enqueued_jobs
+  end
+
+  test "picks up where it left off on restart after mid-leaf signal interruption before commit" do
+    attempted_ids = []
+
+    with_leaf_update_hook(->(leaf, super_update) {
+      attempted_ids << leaf.id
+      raise SignalException, "TERM" if attempted_ids.size == 3
+      super_update.call
+    }) do
+      assert_raises(SignalException) { TitleCleanupJob.perform_now }
+    end
+
+    assert_equal %("On Writing" — Introduction), @first_leaf.reload.title
+    assert_equal %(Chapter "One" Overview), @second_leaf.reload.title
+    assert_equal %(""Entirely Quoted""), @third_leaf.reload.title
+    assert_equal %("Closing "Remarks""), @fourth_leaf.reload.title
+
+    with_leaf_update_hook(->(leaf, super_update) {
+      attempted_ids << leaf.id
+      super_update.call
+    }) do
+      TitleCleanupJob.perform_now
+    end
+
+    assert_expected_cleaned_titles
+    assert_equal [ @first_leaf.id, @second_leaf.id, @third_leaf.id, @third_leaf.id, @fourth_leaf.id ], attempted_ids
+  end
+
+  test "rolls back partial leaf update if interrupted inside update before transaction commits" do
+    call_count = 0
+
+    with_leaf_update_hook(->(_leaf, super_update) {
+      super_update.call
+      call_count += 1
+      raise Interrupt, "interrupted mid-transaction" if call_count == 2
+    }) do
+      assert_raises(Interrupt) { TitleCleanupJob.perform_now }
+    end
+
+    assert_equal %("On Writing" — Introduction), @first_leaf.reload.title
+    assert_equal %("Chapter "One" Overview"), @second_leaf.reload.title
+
+    TitleCleanupJob.perform_now
+
+    assert_expected_cleaned_titles
+  end
+
+  test "does not clean a leaf twice if interrupted after transaction commit before cursor advance" do
+    committed_count = 0
+    step_advance = ActiveJob::Continuation::Step.instance_method(:advance!)
+
+    ActiveJob::Continuation::Step.define_method(:advance!) do |*args, **kwargs|
+      committed_count += 1
+      raise SignalException, "TERM" if committed_count == 2
+      step_advance.bind_call(self, *args, **kwargs)
+    end
+
+    begin
+      assert_raises(SignalException) { TitleCleanupJob.perform_now }
+    ensure
+      ActiveJob::Continuation::Step.define_method(:advance!, step_advance)
+    end
+
+    assert_equal %("On Writing" — Introduction), @first_leaf.reload.title
+    assert_equal %(Chapter "One" Overview), @second_leaf.reload.title
+    assert_equal %(""Entirely Quoted""), @third_leaf.reload.title
+
+    updated_ids = []
+    track_leaf_updates(updated_ids) { TitleCleanupJob.perform_now }
+
+    assert_expected_cleaned_titles
+    assert_equal [ @third_leaf.id, @fourth_leaf.id ], updated_ids
+  end
+
+  test "automatically resumes queued job after transient StandardError mid-collection" do
+    failed_once = false
+
+    with_leaf_update_hook(->(leaf, super_update) {
+      if leaf.id == @third_leaf.id && !failed_once
+        failed_once = true
+        raise "transient database busy error"
+      end
+      super_update.call
+    }) do
+      TitleCleanupJob.perform_later
+      perform_enqueued_jobs
+      assert_enqueued_jobs 1, only: TitleCleanupJob
+
+      perform_enqueued_jobs
+    end
+
+    assert_expected_cleaned_titles
+  end
+
+  test "handles gaps from deleted leaves and empty collections" do
+    @third_leaf.destroy!
+
+    TitleCleanupJob.perform_later
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: @second_leaf.id.succ) do
+      perform_enqueued_jobs
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal %("On Writing" — Introduction), @first_leaf.reload.title
+    assert_equal %(Chapter "One" Overview), @second_leaf.reload.title
+    assert_equal %(Closing "Remarks"), @fourth_leaf.reload.title
+
+    Leaf.destroy_all
+    assert_nothing_raised { TitleCleanupJob.perform_now }
+  end
+
+  test "clears checkpoint on completion so a subsequent run works cleanly" do
+    TitleCleanupJob.perform_now
+    assert_expected_cleaned_titles
+    assert_nil JobCheckpoint.read(TitleCleanupJob::CHECKPOINT_KEY)
+
+    @first_leaf.update!(title: %(""Second Pass" Title"))
+    TitleCleanupJob.perform_now
+    assert_equal %("Second Pass" Title), @first_leaf.reload.title
+  end
+
+  test "stops cleanly at next checkpoint when Resque worker shuts down" do
+    enqueued_payloads = []
+    resque_adapter = ActiveJob::QueueAdapters::ResqueAdapter.new
+
+    worker = Resque::Worker.new(:default)
+    worker.fork_per_job = false
+    resque_job = Struct.new(:inspect) do
+      define_method(:perform) do
+        ActiveJob::Base.execute(TitleCleanupJob.new.serialize)
+      end
+    end.new("TitleCleanupJob")
+
+    original_enqueue_to = Resque.method(:enqueue_to)
+    original_adapter = TitleCleanupJob._test_adapter
+    Resque.define_singleton_method(:enqueue_to) { |_queue, _wrapper, payload| enqueued_payloads << payload }
+    TitleCleanupJob.enable_test_adapter(resque_adapter)
+
+    begin
+      updates = 0
+      with_leaf_update_hook(->(_leaf, super_update) {
+        super_update.call
+        updates += 1
+        worker.shutdown if updates == 2
+      }) do
+        worker.perform(resque_job)
+      end
+
+      assert_equal 1, enqueued_payloads.size
+      assert_equal %("On Writing" — Introduction), @first_leaf.reload.title
+      assert_equal %(Chapter "One" Overview), @second_leaf.reload.title
+      assert_equal %(""Entirely Quoted""), @third_leaf.reload.title
+      assert_equal %("Closing "Remarks""), @fourth_leaf.reload.title
+
+      worker_two = Resque::Worker.new(:default)
+      worker_two.fork_per_job = false
+      resumed_job = Struct.new(:inspect) do
+        define_method(:perform) do
+          ActiveJob::Base.execute(enqueued_payloads.first)
+        end
+      end.new("TitleCleanupJob")
+
+      worker_two.perform(resumed_job)
+    ensure
+      Resque.define_singleton_method(:enqueue_to, original_enqueue_to)
+      TitleCleanupJob.enable_test_adapter(original_adapter)
+    end
+
+    assert_expected_cleaned_titles
+  end
+
+  private
+    def assert_expected_cleaned_titles
+      assert_equal %("On Writing" — Introduction), @first_leaf.reload.title
+      assert_equal %(Chapter "One" Overview), @second_leaf.reload.title
+      assert_equal %("Entirely Quoted"), @third_leaf.reload.title
+      assert_equal %(Closing "Remarks"), @fourth_leaf.reload.title
+    end
+
+    def track_leaf_updates(updated_ids, &block)
+      with_leaf_update_hook(->(leaf, super_update) {
+        updated_ids << leaf.id
+        super_update.call
+      }, &block)
+    end
+
+    def with_leaf_update_hook(hook)
+      original_update = Leaf.instance_method(:update!)
+      Leaf.define_method(:update!) do |*args, **kwargs|
+        hook.call(self, -> { original_update.bind_call(self, *args, **kwargs) })
+      end
+      yield
+    ensure
+      Leaf.define_method(:update!, original_update)
+    end
+end
