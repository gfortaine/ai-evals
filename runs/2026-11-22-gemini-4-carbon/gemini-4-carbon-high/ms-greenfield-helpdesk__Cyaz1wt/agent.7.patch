+      def merge
+        source = current_account.tickets.includes(:requester, :assignee, :group).find(params[:id])
+        raw_merge = params[:merge]
+        raise ActionController::ParameterMissing, :merge unless raw_merge.is_a?(ActionController::Parameters)
+        merge_params = raw_merge
+
+        target = nil
+
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          source = current_account.tickets.includes(:requester, :assignee, :group).find(source.id)
+
+          if source.closed?
+            return render json: {
+              error: "Closed tickets cannot be modified",
+              errors: { status: [ "is closed" ] }
+            }, status: :unprocessable_entity
+          end
+
+          target, target_error = resolve_merge_target(source, merge_params)
+          if target_error
+            return render json: {
+              error: target_error[:error],
+              errors: { target_id: [ target_error[:detail] ] }
+            }, status: :unprocessable_entity
+          end
+
+          now = Time.current
+          comment_errors = {}
+          error_messages = []
+
+          source_comment = build_merge_comment(
+            merge_params: merge_params,
+            param_key: :source_comment,
+            ticket: source,
+            default_body: "Merged into ticket ##{target.id}.",
+            now: now,
+            comment_errors: comment_errors,
+            error_messages: error_messages
+          )
+
+          target_comment = build_merge_comment(
+            merge_params: merge_params,
+            param_key: :target_comment,
+            ticket: target,
+            default_body: "Ticket ##{source.id} was merged into this ticket.",
+            now: now,
+            comment_errors: comment_errors,
+            error_messages: error_messages
+          )
+
+          if comment_errors.any?
+            return render json: {
+              error: error_messages.to_sentence,
+              errors: comment_errors
+            }, status: :unprocessable_entity
+          end
+
+          source.status = "closed"
+          source.merged_into = target
+          source.updated_at = now
+          source.customer_updated_at = now
+
+          target.updated_at = now
+          target.customer_updated_at = now if target_comment.public?
+
+          source_comment.save!
+          target_comment.save!
+          source.save!
+          target.save!
+        end
+
+        render json: {
+          source: source.as_ticket_json,
+          target: target.as_ticket_json
+        }, status: :ok
+      end
+
+      private
+
+      def resolve_merge_target(source, merge_params)
+        unless merge_params.key?(:target_id)
+          return [ nil, { error: "Target can't be blank", detail: "can't be blank" } ]
+        end
+
+        raw_target_id = merge_params[:target_id]
+        if raw_target_id.nil? || (raw_target_id.is_a?(String) && raw_target_id.strip.empty?)
+          return [ nil, { error: "Target can't be blank", detail: "can't be blank" } ]
+        end
+
+        unless raw_target_id.is_a?(Integer) || (raw_target_id.is_a?(String) && raw_target_id.strip.match?(/\A\d+\z/))
+          return [ nil, { error: "Target is invalid", detail: "is invalid" } ]
+        end
+
+        tid = raw_target_id.to_i
+        if tid < 1 || tid > MAX_BIGINT
+          return [ nil, { error: "Target is invalid", detail: "is invalid" } ]
+        end
+
+        candidate = current_account.tickets.includes(:requester, :assignee, :group).find_by(id: tid)
+        if candidate.nil?
+          return [ nil, { error: "Target is invalid", detail: "is invalid" } ]
+        end
+
+        if candidate.id == source.id
+          return [ nil, { error: "Cannot merge a ticket into itself", detail: "cannot merge a ticket into itself" } ]
+        end
+
+        if candidate.requester_id != source.requester_id
+          return [ nil, { error: "Target must belong to the same customer", detail: "must belong to the same customer" } ]
+        end
+
+        if candidate.closed?
+          return [ nil, { error: "Target ticket is closed", detail: "is closed" } ]
+        end
+
+        [ candidate, nil ]
+      end
+
+      def build_merge_comment(merge_params:, param_key:, ticket:, default_body:, now:, comment_errors:, error_messages:)
+        label = param_key.to_s.humanize
+
+        unless merge_params.key?(param_key)
+          return Comment.new(
+            account: current_account,
+            ticket: ticket,
+            author: current_user,
+            body: default_body,
+            public: false,
+            created_at: now,
+            updated_at: now
+          )
+        end
+
+        raw = merge_params[param_key]
+        unless raw.is_a?(ActionController::Parameters) || raw.is_a?(Hash)
+          comment_errors[param_key] = [ "is invalid" ]
+          error_messages << "#{label} is invalid"
+          return nil
+        end
+
+        invalid_body_type = false
+        body_value = if raw.key?(:body)
+          raw_body = raw[:body]
+          if raw_body.is_a?(String) || raw_body.is_a?(Symbol)
+            raw_body.to_s
+          elsif raw_body.nil?
+            ""
+          else
+            invalid_body_type = true
+            ""
+          end
+        else
+          default_body
+        end
+
+        public_value = if raw.key?(:public)
+          raw_pub = raw[:public]
+          if raw_pub == true || raw_pub == "true"
+            true
+          elsif raw_pub == false || raw_pub == "false"
+            false
+          else
+            nil
+          end
+        else
+          false
+        end
+
+        comment = Comment.new(
+          account: current_account,
+          ticket: ticket,
+          author: current_user,
+          body: body_value,
+          public: public_value,
+          created_at: now,
+          updated_at: now
+        )
+
+        if invalid_body_type
+          comment_errors[:"#{param_key}.body"] = [ "is invalid" ]
+          error_messages << "#{label} body is invalid"
+        end
+
+        comment.valid?
+        comment.errors.each do |err|
+          attr = err.attribute
+          next if attr == :body && invalid_body_type
+          next if comment_errors.key?(:"#{param_key}.#{attr}")
+
+          comment_errors[:"#{param_key}.#{attr}"] = comment.errors[attr]
+          comment.errors.full_messages_for(attr).each do |msg|
+            error_messages << "#{label} #{msg.downcase}"
+          end
+        end
+
+        comment
+      end
     end
   end
 end
