diff --git a/test/integration/groups_and_memberships_test.rb b/test/integration/groups_and_memberships_test.rb
new file mode 100644
index 0000000..29b2ed5
--- /dev/null
+++ b/test/integration/groups_and_memberships_test.rb
@@ -0,0 +1,906 @@
+require "test_helper"
+require "rake"
+
+class GroupsAndMembershipsTest < ActionDispatch::IntegrationTest
+  setup do
+    Helpdesk::Application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+  end
+
+  def register_and_verify_customer!(subdomain:, name:, email:, password: "my-customer-password")
+    post "/api/v1/registrations",
+      params: { user: { name: name, email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+
+    token = extract_token_from_mail(
+      ActionMailer::Base.deliveries.last,
+      expected_path: "/verify-email",
+      expected_account: subdomain.downcase
+    )
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+
+    ActionMailer::Base.deliveries.clear
+    account = Account.find_by!(subdomain: subdomain.downcase)
+    User.find_by!(account: account, email: email.strip.downcase)
+  end
+
+  test "groups and memberships CRUD, default invariants, filtering, pagination, and role/tenant permissions" do
+    acme, owner = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    globex, globex_owner = register_and_verify_account!(account_name: "Globex", subdomain: "globex", email: "jo@globex.test")
+
+    admin2 = User.create!(
+      account: acme,
+      name: "Alex Admin",
+      email: "alex@acme.test",
+      password: "alex-password",
+      role: "admin",
+      verified_at: Time.current
+    )
+    sam = User.create!(
+      account: acme,
+      name: "Sam Agent",
+      email: "sam@acme.test",
+      password: "sam-password",
+      role: "agent",
+      verified_at: Time.current
+    )
+    taylor = User.create!(
+      account: acme,
+      name: "Taylor Agent",
+      email: "taylor@acme.test",
+      password: "taylor-password",
+      role: "agent",
+      verified_at: Time.current
+    )
+    customer = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    admin2_token = sign_in!(subdomain: "acme", email: "alex@acme.test", password: "alex-password").dig("session", "token")
+    sam_token = sign_in!(subdomain: "acme", email: "sam@acme.test", password: "sam-password").dig("session", "token")
+    customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+    globex_token = sign_in!(subdomain: "globex", email: "jo@globex.test", password: "my-first-password").dig("session", "token")
+
+    owner_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    admin2_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{admin2_token}" }
+    sam_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" }
+    customer_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{customer_token}" }
+    globex_headers = { "X-Helpdesk-Account" => "globex", "Authorization" => "Bearer #{globex_token}" }
+
+    # Unauthenticated and missing account checks
+    get "/api/v1/groups", headers: { "X-Helpdesk-Account" => "unknown" }
+    assert_response :not_found
+
+    get "/api/v1/groups", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :unauthorized
+
+    get "/api/v1/group_memberships", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :unauthorized
+
+    # Both owner and non-owner admins can create groups
+    post "/api/v1/groups", params: { group: { name: "  Billing  " } }, headers: owner_headers, as: :json
+    assert_response :created
+    billing = JSON.parse(response.body).fetch("group")
+    assert_equal "Billing", billing.fetch("name")
+    assert_equal acme.id, billing.fetch("account_id")
+
+    post "/api/v1/groups", params: { group: { name: "Technical Support" } }, headers: admin2_headers, as: :json
+    assert_response :created
+    tech = JSON.parse(response.body).fetch("group")
+
+    post "/api/v1/groups", params: { group: { name: "Sales" } }, headers: owner_headers, as: :json
+    assert_response :created
+    sales = JSON.parse(response.body).fetch("group")
+
+    # Duplicate group name in same account fails (case-insensitive), allowed in another account
+    post "/api/v1/groups", params: { group: { name: "  billing " } }, headers: owner_headers, as: :json
+    assert_response :unprocessable_entity
+    assert JSON.parse(response.body).dig("errors", "name").present?
+
+    post "/api/v1/groups", params: { group: { name: "Billing" } }, headers: globex_headers, as: :json
+    assert_response :created
+    globex_billing = JSON.parse(response.body).fetch("group")
+    assert_equal globex.id, globex_billing.fetch("account_id")
+
+    # Invalid group payloads fail with 422
+    [ "", "   ", nil, 123, true, [ "Ops" ], { title: "Ops" }, "Bad\u0000Name" ].each do |bad_name|
+      post "/api/v1/groups", params: { group: { name: bad_name } }, headers: owner_headers, as: :json
+      assert_response :unprocessable_entity
+    end
+    post "/api/v1/groups", params: { group: "bad" }, headers: owner_headers, as: :json
+    assert_response :unprocessable_entity
+
+    # Staff (agent) can list and view groups ordered by ID ascending + paginated
+    get "/api/v1/groups", headers: sam_headers
+    assert_response :ok
+    groups_body = JSON.parse(response.body)
+    assert_equal [ billing["id"], tech["id"], sales["id"] ], groups_body.fetch("groups").map { |g| g.fetch("id") }
+    assert_equal 3, groups_body.fetch("count")
+
+    get "/api/v1/groups", params: { page: 1, per_page: 2 }, headers: sam_headers
+    assert_response :ok
+    groups_p1 = JSON.parse(response.body)
+    assert_equal [ billing["id"], tech["id"] ], groups_p1.fetch("groups").map { |g| g.fetch("id") }
+    assert_equal 2, groups_p1.fetch("next_page")
+
+    get "/api/v1/groups/#{billing["id"]}", headers: sam_headers
+    assert_response :ok
+    assert_equal "Billing", JSON.parse(response.body).dig("group", "name")
+
+    # Cross-tenant group access returns 404
+    get "/api/v1/groups/#{globex_billing["id"]}", headers: owner_headers
+    assert_response :not_found
+    patch "/api/v1/groups/#{globex_billing["id"]}", params: { group: { name: "Hijack" } }, headers: owner_headers, as: :json
+    assert_response :not_found
+    delete "/api/v1/groups/#{globex_billing["id"]}", headers: owner_headers
+    assert_response :not_found
+
+    # Agent cannot create, rename, or delete groups
+    post "/api/v1/groups", params: { group: { name: "Agent Group" } }, headers: sam_headers, as: :json
+    assert_response :forbidden
+    patch "/api/v1/groups/#{billing["id"]}", params: { group: { name: "Agent Rename" } }, headers: sam_headers, as: :json
+    assert_response :forbidden
+    delete "/api/v1/groups/#{billing["id"]}", headers: sam_headers
+    assert_response :forbidden
+
+    # Customer cannot browse or mutate groups or memberships
+    get "/api/v1/groups", headers: customer_headers
+    assert_response :forbidden
+    get "/api/v1/groups/#{billing["id"]}", headers: customer_headers
+    assert_response :forbidden
+    get "/api/v1/group_memberships", headers: customer_headers
+    assert_response :forbidden
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: billing["id"], user_id: sam.id } },
+      headers: customer_headers,
+      as: :json
+    assert_response :forbidden
+
+    # Admin renames group with PATCH (including case change on own name); empty/duplicate fails with 422
+    patch "/api/v1/groups/#{billing["id"]}", params: { group: { name: "billing" } }, headers: admin2_headers, as: :json
+    assert_response :ok
+    assert_equal "billing", JSON.parse(response.body).dig("group", "name")
+
+    patch "/api/v1/groups/#{billing["id"]}", params: { group: { name: "  Billing  " } }, headers: owner_headers, as: :json
+    assert_response :ok
+    assert_equal "Billing", JSON.parse(response.body).dig("group", "name")
+
+    patch "/api/v1/groups/#{sales["id"]}", params: { group: { name: "billing" } }, headers: owner_headers, as: :json
+    assert_response :unprocessable_entity
+
+    patch "/api/v1/groups/#{sales["id"]}", params: { group: {} }, headers: owner_headers, as: :json
+    assert_response :unprocessable_entity
+
+    patch "/api/v1/groups/#{sales["id"]}", params: { group: { name: "   " } }, headers: owner_headers, as: :json
+    assert_response :unprocessable_entity
+
+    # Membership creation: first membership becomes default automatically
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: billing["id"], user_id: sam.id } },
+      headers: owner_headers,
