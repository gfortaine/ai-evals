+module Api
+  module V1
+    class GroupsController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!
+      before_action :require_active_account!
+      before_action :require_staff!
+      before_action :require_admin!, only: %i[create update destroy]
+
+      def index
+        scope = current_account.groups.ordered
+        render_paginated(:groups, scope) { |records| records.map(&:as_api_json) }
+      end
+
+      def show
+        group = current_account.groups.find(params[:id])
+        render json: { group: group.as_api_json }, status: :ok
+      end
+
+      def create
+        group_params = require_hash_param(:group)
+        raw_name = group_params[:name]
+        name_value = (raw_name.is_a?(String) || raw_name.is_a?(Symbol)) ? raw_name.to_s : nil
+
+        group = nil
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          group = current_account.groups.new(name: name_value)
+          group.save!
+        end
+
+        render json: { group: group.as_api_json }, status: :created
+      end
+
+      def update
+        group = current_account.groups.find(params[:id])
+        group_params = require_hash_param(:group)
+
+        unless group_params.key?(:name)
+          return render json: {
+            error: "Name is required",
+            errors: { name: [ "is required" ] }
+          }, status: :unprocessable_entity
+        end
+
+        raw_name = group_params[:name]
+        name_value = (raw_name.is_a?(String) || raw_name.is_a?(Symbol)) ? raw_name.to_s : nil
+
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          group.reload
+          group.name = name_value
+          group.save!
+        end
+
+        render json: { group: group.as_api_json }, status: :ok
+      end
+
+      def destroy
+        group = current_account.groups.find(params[:id])
+        group.destroy_and_reconcile!
+        head :no_content
+      end
+    end
+  end
+end
