+      params: { user: { suspended: true } },
+      headers: owner_headers,
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Owner session remains valid and owner remains active
+    get "/api/v1/me", headers: owner_headers
+    assert_response :ok
+    assert_equal false, JSON.parse(response.body).dig("user", "suspended")
+
+    # Unsuspend agent1 -> agent1 can sign in again and reappears in /staff
+    patch "/api/v1/users/#{agent1.id}",
+      params: { user: { suspended: false } },
+      headers: owner_headers,
+      as: :json
+    assert_response :ok
+    assert_equal false, JSON.parse(response.body).dig("user", "suspended")
+
+    sign_in!(subdomain: "acme", email: "sam@acme.test", password: "sam-password")
+
+    get "/api/v1/staff", headers: owner_headers
+    assert_response :ok
+    assert_equal [ owner.id, agent1.id, agent2.id ], JSON.parse(response.body).fetch("staff").map { |s| s.fetch("id") }
+  end
+end
+class InvitationsAndUsersEdgeCasesTest < ActionDispatch::IntegrationTest
+  def register_and_verify_customer!(subdomain:, name:, email:, password: "my-customer-password")
+    post "/api/v1/registrations",
