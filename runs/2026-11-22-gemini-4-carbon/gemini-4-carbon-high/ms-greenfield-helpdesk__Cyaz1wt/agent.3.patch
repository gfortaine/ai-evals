diff --git a/app/controllers/api/v1/invitations_controller.rb b/app/controllers/api/v1/invitations_controller.rb
new file mode 100644
index 0000000..043bbdc
--- /dev/null
+++ b/app/controllers/api/v1/invitations_controller.rb
@@ -0,0 +1,125 @@
+module Api
+  module V1
+    class InvitationsController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!
+      before_action :require_active_account!
+      before_action :require_admin!
+
+      def index
+        now = Time.current
+        scope = current_account.invitations.ordered
+
+        raw_status = params[:status]
+        unless raw_status.nil? || raw_status.to_s.strip.empty?
+          status_filter = raw_status.to_s.strip.downcase
+          unless Invitation::STATUSES.include?(status_filter)
+            return render json: {
+              error: "Status is not included in the list",
+              errors: { status: [ "is not included in the list" ] }
+            }, status: :unprocessable_entity
+          end
+
+          scope = scope.with_status(status_filter, now)
+        end
+
+        render_paginated(:invitations, scope) { |records| records.map { |inv| inv.as_api_json(now) } }
+      end
+
+      def show
+        invitation = current_account.invitations.find(params[:id])
+        render json: { invitation: invitation.as_api_json }, status: :ok
+      end
+
+      def create
+        inv_params = require_hash_param(:invitation).permit(:email, :role)
+
+        invitation = nil
+        raw_token = nil
+        now = Time.current
+
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          invitation = current_account.invitations.new(
+            invited_by: current_user,
+            email: inv_params[:email],
+            role: inv_params[:role]
+          )
+          raw_token = invitation.assign_new_token!(now)
+          invitation.save!
+        end
+
+        UserMailer.invitation(invitation, raw_token).deliver_now
+
+        render json: { invitation: invitation.as_api_json(now) }, status: :created
+      end
+
+      def resend
+        invitation = current_account.invitations.find(params[:id])
+        raw_token = nil
+        now = Time.current
+
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          invitation.reload
+
+          if invitation.accepted?
+            return render json: {
+              error: "Invitation has already been accepted",
+              errors: { status: [ "has already been accepted" ] }
+            }, status: :unprocessable_entity
+          end
+
+          if invitation.revoked?
+            return render json: {
+              error: "Invitation has been revoked",
+              errors: { status: [ "has been revoked" ] }
+            }, status: :unprocessable_entity
+          end
+
+          if current_account.users.exists?(email: invitation.email)
+            return render json: {
+              error: "Email has already been taken",
+              errors: { email: [ "has already been taken" ] }
+            }, status: :unprocessable_entity
+          end
+
+          if current_account.invitations.pending_at(now).where(email: invitation.email).where.not(id: invitation.id).exists?
+            return render json: {
+              error: "Email already has a pending invitation",
+              errors: { email: [ "already has a pending invitation" ] }
+            }, status: :unprocessable_entity
+          end
+
+          raw_token = invitation.assign_new_token!(now)
+          invitation.save!
+        end
+
+        UserMailer.invitation(invitation, raw_token).deliver_now
+
+        render json: { invitation: invitation.as_api_json(now) }, status: :ok
+      end
+
+      def destroy
+        invitation = current_account.invitations.find(params[:id])
+        now = Time.current
+
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          invitation.reload
+
+          unless invitation.pending?(now)
+            return render json: {
+              error: "Only pending invitations can be revoked",
+              errors: { status: [ "must be pending to revoke" ] }
+            }, status: :unprocessable_entity
+          end
+
+          invitation.update!(revoked_at: now)
+        end
+
+        render json: { invitation: invitation.as_api_json(now) }, status: :ok
+      end
+    end
+  end
+end
