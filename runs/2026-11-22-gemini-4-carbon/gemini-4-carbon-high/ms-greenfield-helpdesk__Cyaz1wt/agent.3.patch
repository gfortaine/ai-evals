diff --git a/app/controllers/api/v1/users_controller.rb b/app/controllers/api/v1/users_controller.rb
new file mode 100644
index 0000000..f161e72
--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,141 @@
+module Api
+  module V1
+    class UsersController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!
+      before_action :require_active_account!
+      before_action :require_admin!
+
+      def index
+        scope = current_account.users.ordered
+
+        raw_role = params[:role]
+        unless raw_role.nil? || raw_role.to_s.strip.empty?
+          role_filter = raw_role.to_s.strip.downcase
+          unless User::ROLES.include?(role_filter)
+            return render json: {
+              error: "Role is not included in the list",
+              errors: { role: [ "is not included in the list" ] }
+            }, status: :unprocessable_entity
+          end
+          scope = scope.where(role: role_filter)
+        end
+
+        raw_suspended = params[:suspended]
+        unless raw_suspended.nil? || raw_suspended.to_s.strip.empty?
+          suspended_str = raw_suspended.to_s.strip.downcase
+          if raw_suspended == true || suspended_str == "true" || suspended_str == "1"
+            scope = scope.suspended
+          elsif raw_suspended == false || suspended_str == "false" || suspended_str == "0"
+            scope = scope.active
+          else
+            return render json: {
+              error: "Suspended must be true or false",
+              errors: { suspended: [ "must be true or false" ] }
+            }, status: :unprocessable_entity
+          end
+        end
+
+        render_paginated(:users, scope) { |records| records.map(&:as_api_json) }
+      end
+
+      def show
+        user = current_account.users.find(params[:id])
+        render json: { user: user.as_api_json }, status: :ok
+      end
+
+      def update
+        user = current_account.users.find(params[:id])
+        user_params = require_hash_param(:user)
+
+        has_suspended = user_params.key?(:suspended)
+        has_role = user_params.key?(:role)
+        has_name = user_params.key?(:name)
+
+        unless has_suspended || has_role || has_name
+          return render json: {
+            error: "No updatable attributes provided",
+            errors: { user: [ "must include updatable attributes" ] }
+          }, status: :unprocessable_entity
+        end
+
+        desired_suspended = nil
+        if has_suspended
+          raw_susp = user_params[:suspended]
+          if raw_susp == true || raw_susp == "true"
+            desired_suspended = true
+          elsif raw_susp == false || raw_susp == "false"
+            desired_suspended = false
+          else
+            return render json: {
+              error: "Suspended must be true or false",
+              errors: { suspended: [ "must be true or false" ] }
+            }, status: :unprocessable_entity
+          end
+        end
+
+        now = Time.current
+
+        ActiveRecord::Base.transaction do
+          current_account.lock!
+          user.reload
+          was_active_admin = user.admin? && !user.suspended?
+
+          if has_name
+            user.name = user_params[:name]
+          end
+
+          if has_role
+            new_role = user_params[:role].to_s.strip.downcase
+            if user.customer? && new_role != "customer"
+              return render json: {
+                error: "Customer role cannot be changed",
+                errors: { role: [ "cannot be changed for customers" ] }
+              }, status: :unprocessable_entity
+            elsif user.staff? && !User::STAFF_ROLES.include?(new_role)
+              return render json: {
+                error: "Role is not included in the list",
+                errors: { role: [ "is not included in the list" ] }
+              }, status: :unprocessable_entity
+            end
+            user.role = new_role
+          end
+
+          if has_suspended
+            if desired_suspended
+              user.suspended_at ||= now
+            else
+              user.suspended_at = nil
+            end
+          end
+
+          will_be_active_admin = user.admin? && !user.suspended?
+          if was_active_admin && !will_be_active_admin
+            other_active_admin_exists = current_account.users.where(role: "admin", suspended_at: nil).where.not(id: user.id).exists?
+            unless other_active_admin_exists
+              error_key = has_suspended && desired_suspended ? :suspended : :role
+              return render json: {
+                error: "Cannot suspend the last active admin",
+                errors: { error_key => [ "cannot suspend the last active admin" ] }
+              }, status: :unprocessable_entity
+            end
+          end
+
+          if user.suspended?
+            user.password_reset_token_digest = nil
+            user.password_reset_sent_at = nil
+          end
+
+          user.save!
+
+          if user.suspended?
+            user.sessions.delete_all
+            current_account.tickets.where(assignee_id: user.id).update_all(assignee_id: nil, updated_at: now)
+          end
+        end
+
+        render json: { user: user.as_api_json }, status: :ok
+      end
+    end
+  end
+end
