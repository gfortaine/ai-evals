+    assert_equal [ t1 ], all_five.fetch("tickets").map { |t| t.fetch("id") }
+    assert_equal 1, all_five.fetch("count")
+
+    # 2. Individual filter checks & case/whitespace insensitivity
+    get "/api/v1/tickets", params: { priority: "  NORMAL " }, headers: owner_headers
+    assert_response :ok
+    assert_equal [ t6 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+    get "/api/v1/tickets", params: { priority: "high" }, headers: owner_headers
+    assert_response :ok
+    assert_equal [ t5, t4, t3, t2, t1 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+    get "/api/v1/tickets", params: { status: "  PENDING  " }, headers: owner_headers
+    assert_response :ok
+    assert_equal [ t5 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+    get "/api/v1/tickets", params: { assignee_id: agent_sam.id }, headers: owner_headers
+    assert_response :ok
+    assert_equal [ t4 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+    get "/api/v1/tickets", params: { assignee_id: " UNASSIGNED " }, headers: owner_headers
+    assert_response :ok
+    assert_equal [ t6, t5, t3, t2, t1 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+    get "/api/v1/tickets", params: { assignee_id: agent_alex.id }, headers: owner_headers
+    assert_response :ok
+    assert_equal [], JSON.parse(response.body).fetch("tickets")
+    assert_equal 0, JSON.parse(response.body).fetch("count")
+
+    get "/api/v1/tickets", params: { requester_id: cust_blake.id }, headers: owner_headers
+    assert_response :ok
+    assert_equal [ t5, t2 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+    # Cross-account / unknown positive integer IDs return empty list cleanly without leaking data
+    get "/api/v1/tickets", params: { requester_id: globex_cust.id }, headers: owner_headers
+    assert_response :ok
+    assert_equal 0, JSON.parse(response.body).fetch("count")
+
+    get "/api/v1/tickets", params: { assignee_id: globex_owner.id }, headers: owner_headers
+    assert_response :ok
+    assert_equal 0, JSON.parse(response.body).fetch("count")
+
+    get "/api/v1/tickets", params: { assignee_id: 999_999 }, headers: owner_headers
+    assert_response :ok
+    assert_equal 0, JSON.parse(response.body).fetch("count")
+
+    # Blank filter params are treated as omitted
+    get "/api/v1/tickets",
+      params: { status: " ", priority: "", assignee_id: "  ", requester_id: "", q: "   " },
+      headers: owner_headers
+    assert_response :ok
+    assert_equal [ t6, t5, t4, t3, t2, t1 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+    # 3. Literal text search checks (%, _, \, \%, \_, regex metacharacters)
+    # "100%" matches t2 ("100% VAT"), NOT t3 ("1000 points")
+    get "/api/v1/tickets", params: { q: "100%" }, headers: owner_headers
+    assert_response :ok
+    assert_equal [ t2 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+    # "%" matches only tickets containing a literal percent sign (t5 and t2), NOT all tickets
+    get "/api/v1/tickets", params: { q: "%" }, headers: owner_headers
+    assert_response :ok
+    assert_equal [ t5, t2 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+    # "order_42" matches t2 ("order_42"), NOT t3 ("Order-42")
+    get "/api/v1/tickets", params: { q: "ORDER_42" }, headers: owner_headers
+    assert_response :ok
+    assert_equal [ t2 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+    # Single trailing backslash "\" and path with trailing backslash do not crash and match literally
+    get "/api/v1/tickets", params: { q: "\\" }, headers: owner_headers
+    assert_response :ok
+    assert_equal [ t5, t3 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+    get "/api/v1/tickets", params: { q: "c:\\users\\avery\\logs\\" }, headers: owner_headers
+    assert_response :ok
+    assert_equal [ t3 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+    # Literal "\%" matches t5 ("Literal \%"), NOT t2 ("100% VAT")
+    get "/api/v1/tickets", params: { q: "\\%" }, headers: owner_headers
+    assert_response :ok
+    assert_equal [ t5 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+    # Regex characters matched literally
+    get "/api/v1/tickets", params: { q: "[REGEX].*" }, headers: owner_headers
+    assert_response :ok
+    assert_equal [ t5 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+    # Pagination works accurately with search and filters
+    get "/api/v1/tickets", params: { q: "receipt", page: 1, per_page: 2 }, headers: owner_headers
+    assert_response :ok
+    p1 = JSON.parse(response.body)
+    assert_equal [ t6, t5 ], p1.fetch("tickets").map { |t| t.fetch("id") }
+    assert_equal 5, p1.fetch("count")
+    assert_equal 2, p1.fetch("next_page")
+    assert_nil p1.fetch("previous_page")
+
+    get "/api/v1/tickets", params: { q: "receipt", page: 3, per_page: 2 }, headers: owner_headers
+    assert_response :ok
+    p3 = JSON.parse(response.body)
+    assert_equal [ t1 ], p3.fetch("tickets").map { |t| t.fetch("id") }
+    assert_equal 5, p3.fetch("count")
+    assert_nil p3.fetch("next_page")
+    assert_equal 2, p3.fetch("previous_page")
+
+    # Suspending Sam unassigns t4 while keeping its high priority -> now appears in unassigned + high + receipt!
+    travel_to(base_time + 10.minutes) do
+      patch "/api/v1/users/#{agent_sam.id}",
+        params: { user: { suspended: true } },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+
+      get "/api/v1/tickets?status=open&assignee_id=unassigned&priority=high&q=receipt", headers: owner_headers
+      assert_response :ok
+      assert_equal [ t4, t2, t1 ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+    end
+
+    # 4. Invalid filter values on GET /api/v1/tickets return 422 Unprocessable Entity
+    [
+      { status: "closed" },
+      { status: [ "open" ] },
+      { priority: "urgent" },
+      { priority: [ "high" ] },
+      { assignee_id: "nobody" },
+      { assignee_id: "0" },
+      { assignee_id: "-2" },
