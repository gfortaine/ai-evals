diff --git a/test/integration/ticket_priorities_and_filtering_test.rb b/test/integration/ticket_priorities_and_filtering_test.rb
new file mode 100644
index 0000000..43811f7
--- /dev/null
+++ b/test/integration/ticket_priorities_and_filtering_test.rb
@@ -0,0 +1,657 @@
+require "test_helper"
+
+class TicketPrioritiesAndFilteringTest < ActionDispatch::IntegrationTest
+  def register_and_verify_customer!(subdomain:, name:, email:, password: "my-customer-password")
+    post "/api/v1/registrations",
+      params: { user: { name: name, email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+
+    token = extract_token_from_mail(
+      ActionMailer::Base.deliveries.last,
+      expected_path: "/verify-email",
+      expected_account: subdomain.downcase
+    )
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+
+    ActionMailer::Base.deliveries.clear
+    account = Account.find_by!(subdomain: subdomain.downcase)
+    User.find_by!(account: account, email: email.strip.downcase)
+  end
+
+  test "ticket priority defaults to normal, is updatable by staff, and stays strictly internal from customers" do
+    base_time = Time.utc(2026, 11, 21, 9, 0, 0)
+
+    acme_account = nil
+    owner = nil
+    agent = nil
+    avery = nil
+
+    travel_to(base_time) do
+      acme_account, owner = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+      agent = User.create!(
+        account: acme_account,
+        name: "Sam",
+        email: "sam@acme.test",
+        password: "sam-password",
+        role: "agent",
+        verified_at: Time.current
+      )
+      avery = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    end
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    agent_token = sign_in!(subdomain: "acme", email: "sam@acme.test", password: "sam-password").dig("session", "token")
+    customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+
+    owner_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    agent_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{agent_token}" }
+    customer_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{customer_token}" }
+
+    req1_initial = nil
+    req2_initial = nil
+    t1_id = nil
+    t2_id = nil
+
+    # Customer opens Request 1 (attempting to pass priority: "high" -> ignored, defaults to normal, hidden from request JSON)
+    travel_to(base_time + 1.minute) do
+      post "/api/v1/requests",
+        params: {
+          request: {
+            subject: "Checkout error",
+            priority: "high",
+            comment: { body: "Payment failed with card." }
+          }
+        },
+        headers: customer_headers,
+        as: :json
+      assert_response :created
+      req1_initial = JSON.parse(response.body).fetch("request")
+      t1_id = req1_initial.fetch("id")
+      refute req1_initial.key?("priority")
+    end
+
+    travel_to(base_time + 5.minutes) do
+      post "/api/v1/requests",
+        params: {
+          request: {
+            subject: "General question",
+            comment: { body: "Where are your docs?" }
+          }
+        },
+        headers: customer_headers,
+        as: :json
+      assert_response :created
+      req2_initial = JSON.parse(response.body).fetch("request")
+      t2_id = req2_initial.fetch("id")
+      refute req2_initial.key?("priority")
+    end
+
+    # Staff GET /tickets/:id and GET /tickets include priority: "normal" by default
+    get "/api/v1/tickets/#{t1_id}", headers: agent_headers
+    assert_response :ok
+    t1_json = JSON.parse(response.body).fetch("ticket")
+    assert_equal "normal", t1_json.fetch("priority")
+
+    get "/api/v1/tickets", headers: owner_headers
+    assert_response :ok
+    tickets_list = JSON.parse(response.body).fetch("tickets")
+    assert_equal [ t2_id, t1_id ], tickets_list.map { |t| t.fetch("id") }
+    assert_equal %w[normal normal], tickets_list.map { |t| t.fetch("priority") }
+
+    # Invalid priority updates fail with 422 and roll back comments/other fields
+    [ "urgent", "low", "", "   ", nil, 123, true, [ "high" ], { level: "high" } ].each do |bad_priority|
+      assert_no_difference -> { Comment.count } do
+        patch "/api/v1/tickets/#{t1_id}",
+          params: {
+            ticket: {
+              priority: bad_priority,
+              status: "pending",
+              assignee_id: agent.id,
+              comment: { body: "Should not be saved" }
+            }
+          },
+          headers: agent_headers,
+          as: :json
+        assert_response :unprocessable_entity
+        body = JSON.parse(response.body)
+        assert body.dig("errors", "priority").present?
+      end
+    end
+
+    # Empty ticket hash still fails with 422
+    patch "/api/v1/tickets/#{t1_id}", params: { ticket: {} }, headers: agent_headers, as: :json
+    assert_response :unprocessable_entity
+
+    # At +10m: Agent marks Ticket 1 high priority (normalized from "  HIGH  ") -> moves to top for staff, customer request UNCHANGED
+    travel_to(base_time + 10.minutes) do
+      patch "/api/v1/tickets/#{t1_id}",
+        params: { ticket: { priority: "  HIGH  " } },
+        headers: agent_headers,
+        as: :json
+      assert_response :ok
+      updated_t1 = JSON.parse(response.body).fetch("ticket")
+      assert_equal "high", updated_t1.fetch("priority")
+
+      get "/api/v1/tickets", headers: owner_headers
+      assert_response :ok
+      assert_equal [ t1_id, t2_id ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+      # Customer GET /requests/:id and GET /requests remain 100% untouched (priority internal, customer_updated_at unchanged)
+      get "/api/v1/requests/#{t1_id}", headers: customer_headers
+      assert_response :ok
+      assert_equal req1_initial, JSON.parse(response.body).fetch("request")
+
+      get "/api/v1/requests", headers: customer_headers
+      assert_response :ok
+      assert_equal [ req2_initial, req1_initial ], JSON.parse(response.body).fetch("requests")
+    end
+
+    # Updating other staff fields without priority preserves high priority
+    travel_to(base_time + 15.minutes) do
+      patch "/api/v1/tickets/#{t1_id}",
+        params: {
+          ticket: {
+            assignee_id: owner.id,
+            comment: { body: "Escalated internally.", public: false }
+          }
+        },
+        headers: agent_headers,
+        as: :json
+      assert_response :ok
+      assert_equal "high", JSON.parse(response.body).dig("ticket", "priority")
+
+      # Customer request still completely unchanged
+      get "/api/v1/requests/#{t1_id}", headers: customer_headers
+      assert_response :ok
+      assert_equal req1_initial, JSON.parse(response.body).fetch("request")
+    end
+
+    # Customer cannot update priority alone (422) and customer reply ignores priority while preserving staff's high priority
+    patch "/api/v1/requests/#{t1_id}",
+      params: { request: { priority: "normal" } },
+      headers: customer_headers,
+      as: :json
+    assert_response :unprocessable_entity
+
+    travel_to(base_time + 20.minutes) do
+      patch "/api/v1/requests/#{t1_id}",
+        params: {
+          request: {
+            priority: "normal",
+            comment: { body: "Any update on this?" }
+          }
+        },
+        headers: customer_headers,
+        as: :json
+      assert_response :ok
+      cust_updated = JSON.parse(response.body).fetch("request")
+      refute cust_updated.key?("priority")
+
+      get "/api/v1/tickets/#{t1_id}", headers: owner_headers
+      assert_response :ok
+      assert_equal "high", JSON.parse(response.body).dig("ticket", "priority")
+    end
+
+    # Staff can lower priority back to normal via PUT as well
+    travel_to(base_time + 25.minutes) do
+      put "/api/v1/tickets/#{t1_id}",
+        params: { ticket: { priority: "normal", status: "solved" } },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+      solved_t1 = JSON.parse(response.body).fetch("ticket")
+      assert_equal "normal", solved_t1.fetch("priority")
+      assert_equal "solved", solved_t1.fetch("status")
+    end
+  end
+
+  test "staff combine status, assignee_id, requester_id, priority, and literal case-insensitive search q across subjects and public comments" do
+    base_time = Time.utc(2026, 11, 21, 10, 0, 0)
+
+    acme, owner = nil, nil
+    globex, globex_owner = nil, nil
+    agent_sam = nil
+    agent_alex = nil
+    cust_avery = nil
+    cust_blake = nil
+    globex_cust = nil
+
+    travel_to(base_time) do
+      acme, owner = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+      globex, globex_owner = register_and_verify_account!(account_name: "Globex", subdomain: "globex", email: "jo@globex.test")
+
+      agent_sam = User.create!(account: acme, name: "Sam", email: "sam@acme.test", password: "sam-password", role: "agent", verified_at: Time.current)
+      agent_alex = User.create!(account: acme, name: "Alex", email: "alex@acme.test", password: "alex-password", role: "agent", verified_at: Time.current)
+
+      cust_avery = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+      cust_blake = register_and_verify_customer!(subdomain: "acme", name: "Blake", email: "blake@example.test")
+      globex_cust = register_and_verify_customer!(subdomain: "globex", name: "Globex Cust", email: "cust@globex.test")
+    end
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    sam_token = sign_in!(subdomain: "acme", email: "sam@acme.test", password: "sam-password").dig("session", "token")
+    avery_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+    blake_token = sign_in!(subdomain: "acme", email: "blake@example.test", password: "my-customer-password").dig("session", "token")
+    globex_owner_token = sign_in!(subdomain: "globex", email: "jo@globex.test", password: "my-first-password").dig("session", "token")
+    globex_cust_token = sign_in!(subdomain: "globex", email: "cust@globex.test", password: "my-customer-password").dig("session", "token")
+
+    owner_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    sam_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{sam_token}" }
+    avery_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_token}" }
+    blake_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{blake_token}" }
+    globex_owner_headers = { "X-Helpdesk-Account" => "globex", "Authorization" => "Bearer #{globex_owner_token}" }
+    globex_cust_headers = { "X-Helpdesk-Account" => "globex", "Authorization" => "Bearer #{globex_cust_token}" }
+
+    t1 = t2 = t3 = t4 = t5 = t6 = nil
+
+    # Ticket 1 (Avery): open, unassigned, high, subject has "Receipt", ALSO multiple public comments with "receipt"
+    travel_to(base_time + 1.minute) do
+      post "/api/v1/requests",
+        params: { request: { subject: "Missing PDF Receipt", comment: { body: "Please send my receipt for October." } } },
+        headers: avery_headers,
+        as: :json
+      t1 = JSON.parse(response.body).dig("request", "id")
+
+      patch "/api/v1/tickets/#{t1}",
+        params: { ticket: { priority: "high", comment: { body: "Generating your receipt now." } } },
