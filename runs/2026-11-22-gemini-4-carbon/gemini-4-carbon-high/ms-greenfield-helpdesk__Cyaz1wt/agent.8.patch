+
+      agents.each_with_index do |ag, idx|
+        memberships << GroupMembership.create!(account: acme, group: groups[0], user: ag, default: true)
+        memberships << GroupMembership.create!(account: acme, group: groups[1], user: ag, default: false) if idx < 2
