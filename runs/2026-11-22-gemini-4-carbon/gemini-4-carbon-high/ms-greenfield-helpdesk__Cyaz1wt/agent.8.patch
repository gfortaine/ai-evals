+  test "rejects invalid, blank, contradictory, tampered, cross-collection, cross-ticket, cross-customer, and cross-tenant cursors with 422" do
+    acme, _ = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    globex, _ = register_and_verify_account!(account_name: "Globex", subdomain: "globex", email: "boss@globex.test")
+    avery = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@acme.test")
+    jordan = register_and_verify_customer!(subdomain: "acme", name: "Jordan", email: "jordan@acme.test")
+
+    acme_staff_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    globex_staff_token = sign_in!(subdomain: "globex", email: "boss@globex.test", password: "my-first-password").dig("session", "token")
+    avery_token = sign_in!(subdomain: "acme", email: "avery@acme.test", password: "my-customer-password").dig("session", "token")
+    jordan_token = sign_in!(subdomain: "acme", email: "jordan@acme.test", password: "my-customer-password").dig("session", "token")
+
+    acme_headers = auth_headers("acme", acme_staff_token)
+    globex_headers = auth_headers("globex", globex_staff_token)
+    avery_headers = auth_headers("acme", avery_token)
+    jordan_headers = auth_headers("acme", jordan_token)
+
+    group = Group.create!(account: acme, name: "Support")
+    t1 = Ticket.create!(account: acme, requester: avery, subject: "T1", status: "open")
+    c1 = Comment.create!(account: acme, ticket: t1, author: avery, body: "C1", public: true)
+    t2 = Ticket.create!(account: acme, requester: avery, subject: "T2", status: "open")
+    Comment.create!(account: acme, ticket: t2, author: avery, body: "C2", public: true)
+
+    get "/api/v1/tickets", params: { page: { size: 1 } }, headers: acme_headers
+    ticket_cursor = JSON.parse(response.body).dig("meta", "after_cursor")
+
+    get "/api/v1/groups", params: { page: { size: 1 } }, headers: acme_headers
+    group_cursor = JSON.parse(response.body).dig("meta", "after_cursor")
+
+    get "/api/v1/requests", params: { page: { size: 1 } }, headers: avery_headers
+    avery_request_cursor = JSON.parse(response.body).dig("meta", "after_cursor")
+
+    get "/api/v1/tickets/#{t1.id}/comments", params: { page: { size: 1 } }, headers: acme_headers
+    t1_comment_cursor = JSON.parse(response.body).dig("meta", "after_cursor")
+
+    # Invalid sizes
+    [ 0, -3, "abc", "" ].each do |bad_size|
+      get "/api/v1/tickets?page[size]=#{bad_size}", headers: acme_headers
+      assert_response :unprocessable_entity
+    end
+
+    # Blank, malformed, unknown keys, or contradictory after+before
+    get "/api/v1/tickets?page[after]=", headers: acme_headers
+    assert_response :unprocessable_entity
+
+    get "/api/v1/tickets?page[before]=", headers: acme_headers
+    assert_response :unprocessable_entity
+
+    get "/api/v1/tickets?page[after]", headers: acme_headers
+    assert_response :unprocessable_entity
+
+    get "/api/v1/tickets?page[after]=not-a-valid-cursor", headers: acme_headers
+    assert_response :unprocessable_entity
+
+    get "/api/v1/tickets?page[before]=not-a-valid-cursor", headers: acme_headers
+    assert_response :unprocessable_entity
+
+    get "/api/v1/tickets", params: { page: { after: ticket_cursor, before: ticket_cursor, size: 5 } }, headers: acme_headers
+    assert_response :unprocessable_entity
+
+    get "/api/v1/tickets?page[foo]=bar", headers: acme_headers
+    assert_response :unprocessable_entity
+
+    # Tampered cursor
+    flipped_char = ticket_cursor[-1] == "A" ? "B" : "A"
+    tampered_cursor = ticket_cursor[0...-1] + flipped_char
+    get "/api/v1/tickets", params: { page: { after: tampered_cursor, size: 5 } }, headers: acme_headers
+    assert_response :unprocessable_entity
+
+    # Cross-collection cursor (groups cursor on tickets, tickets cursor on requests)
+    get "/api/v1/tickets", params: { page: { after: group_cursor, size: 5 } }, headers: acme_headers
+    assert_response :unprocessable_entity
+
+    get "/api/v1/requests", params: { page: { after: ticket_cursor, size: 5 } }, headers: avery_headers
+    assert_response :unprocessable_entity
+
+    # Cross-tenant cursor (Acme cursor used on Globex)
+    get "/api/v1/tickets", params: { page: { after: ticket_cursor, size: 5 } }, headers: globex_headers
+    assert_response :unprocessable_entity
+
+    # Cross-ticket comment cursor (t1 cursor used on t2)
+    get "/api/v1/tickets/#{t2.id}/comments", params: { page: { after: t1_comment_cursor, size: 5 } }, headers: acme_headers
+    assert_response :unprocessable_entity
+
+    # Cross-customer request cursor (Avery's cursor used by Jordan)
+    get "/api/v1/requests", params: { page: { after: avery_request_cursor, size: 5 } }, headers: jordan_headers
+    assert_response :unprocessable_entity
+  end
