+  test "keeps navigation stable while other people create, update, close, private-note, or delete records" do
+    base_time = Time.utc(2026, 11, 21, 10, 0, 0)
+    acme = owner = customer = nil
+    tickets = []
+
+    travel_to(base_time) do
+      acme, owner = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+      customer = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    end
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+    owner_headers = auth_headers("acme", owner_token)
+    customer_headers = auth_headers("acme", customer_token)
+
+    # Create T1..T6 one minute apart (newest is T6, oldest is T1)
+    6.times do |i|
+      travel_to(base_time + (i + 1).minutes) do
+        t = Ticket.create!(
+          account: acme,
+          requester: customer,
+          subject: "Ticket #{i + 1}",
+          status: "open"
+        )
+        Comment.create!(account: acme, ticket: t, author: customer, body: "Body #{i + 1}", public: true)
+        tickets << t
+      end
+    end
+
+    # Agent loads page 1 of open tickets (size 2): gets [T6, T5]
+    get "/api/v1/tickets", params: { page: { size: 2 }, status: "open" }, headers: owner_headers
+    assert_response :ok
+    p1 = JSON.parse(response.body)
+    assert_equal [ tickets[5].id, tickets[4].id ], p1.fetch("tickets").map { |t| t.fetch("id") }
+
+    # Customer also loads page 1 of open requests (size 2): gets [T6, T5]
+    get "/api/v1/requests", params: { page: { size: 2 }, status: "open" }, headers: customer_headers
+    assert_response :ok
+    cust_p1 = JSON.parse(response.body)
+    assert_equal [ tickets[5].id, tickets[4].id ], cust_p1.fetch("requests").map { |r| r.fetch("id") }
+
+    # Now OTHER PEOPLE WORK before page 2 is requested:
+    # 1. Two brand-new tickets T7 and T8 arrive at the top
+    # 2. Boundary ticket T5 gets replied to AND solved (so its updated_at jumps to top AND it leaves status=open!)
+    # 3. T4 gets a private staff note (bumps updated_at for staff, does NOT bump customer_updated_at for customer!)
+    t7 = t8 = nil
+    travel_to(base_time + 20.minutes) do
+      t7 = Ticket.create!(account: acme, requester: customer, subject: "Ticket 7", status: "open")
+      Comment.create!(account: acme, ticket: t7, author: customer, body: "New 7", public: true)
+    end
+    travel_to(base_time + 21.minutes) do
+      t8 = Ticket.create!(account: acme, requester: customer, subject: "Ticket 8", status: "open")
+      Comment.create!(account: acme, ticket: t8, author: customer, body: "New 8", public: true)
+    end
+    travel_to(base_time + 22.minutes) do
+      patch "/api/v1/tickets/#{tickets[4].id}",
+        params: { ticket: { status: "solved", comment: { body: "Solved T5", public: true } } },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+    end
+    travel_to(base_time + 23.minutes) do
+      patch "/api/v1/tickets/#{tickets[3].id}",
+        params: { ticket: { comment: { body: "Internal private note on T4", public: false } } },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+    end
+
+    # Agent follows p1.links.next (status=open):
+    # Even though T7, T8 arrived, T5 was solved & updated, and T4 moved above T6,
+    # cursor is anchored at T5's original (updated_at, id), so agent smoothly gets [T3, T2] without duplicating T6!
+    get p1.dig("links", "next"), headers: owner_headers
+    assert_response :ok
+    p2 = JSON.parse(response.body)
+    assert_equal [ tickets[2].id, tickets[1].id ], p2.fetch("tickets").map { |t| t.fetch("id") }
+    assert_equal true, p2.dig("meta", "has_more")
+
+    # Meanwhile Customer follows cust_p1.links.next (status=open):
+    # Private note on T4 did NOT change customer_updated_at, so customer still sees [T4, T3]!
+    get cust_p1.dig("links", "next"), headers: customer_headers
+    assert_response :ok
+    cust_p2 = JSON.parse(response.body)
+    assert_equal [ tickets[3].id, tickets[2].id ], cust_p2.fetch("requests").map { |r| r.fetch("id") }
+    assert_equal true, cust_p2.dig("meta", "has_more")
+
+    # Customer follows prev from cust_p2 -> gets [T6, T7] (since T5 was solved, T6 and T7 are the 2 open requests immediately before T4),
+    # AND has_more is true because T8 is still above T7!
+    get cust_p2.dig("links", "prev"), headers: customer_headers
+    assert_response :ok
+    cust_back = JSON.parse(response.body)
+    assert_equal [ t7.id, tickets[5].id ], cust_back.fetch("requests").map { |r| r.fetch("id") }
+    assert_equal true, cust_back.dig("meta", "has_more")
+    assert_not_nil cust_back.dig("links", "prev")
+
+    get cust_back.dig("links", "prev"), headers: customer_headers
+    assert_response :ok
+    cust_top = JSON.parse(response.body)
+    assert_equal [ t8.id ], cust_top.fetch("requests").map { |r| r.fetch("id") }
+    assert_equal false, cust_top.dig("meta", "has_more")
+    assert_nil cust_top.dig("links", "prev")
+
+    # Deleting boundary group while browsing /api/v1/groups keeps navigation stable
+    g1 = Group.create!(account: acme, name: "Alpha")
+    g2 = Group.create!(account: acme, name: "Bravo")
+    g3 = Group.create!(account: acme, name: "Charlie")
+    g4 = Group.create!(account: acme, name: "Delta")
+
+    get "/api/v1/groups", params: { page: { size: 2 } }, headers: owner_headers
+    assert_response :ok
+    gp1 = JSON.parse(response.body)
+    assert_equal [ g1.id, g2.id ], gp1.fetch("groups").map { |g| g.fetch("id") }
+
+    # Another admin deletes boundary group g2!
+    delete "/api/v1/groups/#{g2.id}", headers: owner_headers
+    assert_response :no_content
+
+    get gp1.dig("links", "next"), headers: owner_headers
+    assert_response :ok
+    gp2 = JSON.parse(response.body)
+    assert_equal [ g3.id, g4.id ], gp2.fetch("groups").map { |g| g.fetch("id") }
+    assert_equal false, gp2.dig("meta", "has_more")
+  end
