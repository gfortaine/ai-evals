+      headers: acme_staff_headers,
+      as: :json
+    assert_response :forbidden
+
+    # Cross-tenant isolation: Globex staff & Globex Avery cannot see Acme's ticket
+    get "/api/v1/tickets", headers: globex_staff_headers
+    assert_response :ok
+    assert_equal 0, JSON.parse(response.body).fetch("count")
+
+    get "/api/v1/tickets/#{acme_ticket_id}", headers: globex_staff_headers
+    assert_response :not_found
+
+    get "/api/v1/requests/#{acme_ticket_id}", headers: avery_globex_headers
+    assert_response :not_found
+
+    # Staff non-public comment is visible on /tickets/:id/comments but hidden from customer /requests/:id/comments
+    patch "/api/v1/tickets/#{acme_ticket_id}",
+      params: { ticket: { comment: { body: "Internal triage note", public: false } } },
+      headers: acme_staff_headers,
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/tickets/#{acme_ticket_id}/comments", headers: acme_staff_headers
+    assert_response :ok
+    assert_equal 2, JSON.parse(response.body).fetch("count")
+    assert_equal false, JSON.parse(response.body).fetch("comments").last.fetch("public")
+
+    get "/api/v1/requests/#{acme_ticket_id}/comments", headers: avery_acme_headers
