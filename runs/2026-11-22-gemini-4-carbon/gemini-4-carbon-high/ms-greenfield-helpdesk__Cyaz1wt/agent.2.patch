+    assert_equal 1, JSON.parse(response.body).fetch("count")
+
+    # Cancelling Acme blocks registrations, customer login, /tickets, and /requests; purge deletes tickets & comments
+    post "/api/v1/account/cancel", headers: acme_staff_headers
