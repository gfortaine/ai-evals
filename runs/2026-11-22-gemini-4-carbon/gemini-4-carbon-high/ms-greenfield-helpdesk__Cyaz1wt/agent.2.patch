+++ b/app/controllers/api/v1/requests_controller.rb
@@ -0,0 +1,160 @@
+module Api
+  module V1
+    class RequestsController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!
+      before_action :require_active_account!
+      before_action :require_customer!
+
+      def index
+        scope = customer_requests_scope.recently_active
+        render_paginated(:requests, scope) { |records| records.map(&:as_request_json) }
+      end
+
+      def show
+        ticket = customer_requests_scope.find(params[:id])
+        render json: { request: ticket.as_request_json }, status: :ok
+      end
+
+      def create
+        req_params = require_hash_param(:request)
+        permitted = req_params.permit(:subject)
+        comment_raw = req_params[:comment]
+
+        ticket = current_account.tickets.new(
+          requester: current_user,
+          subject: permitted[:subject],
+          status: "open"
+        )
+
+        unless comment_raw.is_a?(ActionController::Parameters) || comment_raw.is_a?(Hash)
+          ticket.valid?
+          merged_errors = ticket.errors.to_hash(true)
+          merged_errors[:comment] = [ "Comment is required" ]
+          all_messages = ticket.errors.full_messages + [ "Comment is required" ]
+          return render json: {
+            error: all_messages.to_sentence,
+            errors: merged_errors
+          }, status: :unprocessable_entity
+        end
+
+        comment_permitted = comment_raw.permit(:body)
+        comment = Comment.new(
+          account: current_account,
+          ticket: ticket,
+          author: current_user,
+          body: comment_permitted[:body],
+          public: true
+        )
+
+        ticket_valid = ticket.valid?
+        comment_valid = comment.valid?
+
+        unless ticket_valid && comment_valid
+          merged_errors = ticket.errors.to_hash(true)
+          comment.errors.to_hash(true).each do |key, messages|
+            merged_errors[:"comment.#{key}"] = messages
+          end
+          all_messages = ticket.errors.full_messages + comment.errors.full_messages
+          return render json: {
+            error: all_messages.to_sentence,
+            errors: merged_errors
+          }, status: :unprocessable_entity
+        end
+
+        ActiveRecord::Base.transaction do
+          ticket.save!
+          comment.save!
+        end
+
+        render json: { request: ticket.as_request_json }, status: :created
+      end
+
+      def update
+        ticket = customer_requests_scope.find(params[:id])
+        req_params = require_hash_param(:request)
+
+        has_comment = req_params.key?(:comment)
+        has_status = req_params.key?(:status)
+
+        unless has_comment || has_status
+          return render json: {
+            error: "Comment or status is required",
+            errors: { request: [ "must include comment or status" ] }
+          }, status: :unprocessable_entity
+        end
+
+        comment = nil
+        if has_comment
+          comment_raw = req_params[:comment]
+          unless comment_raw.is_a?(ActionController::Parameters) || comment_raw.is_a?(Hash)
+            return render json: {
+              error: "Comment is invalid",
+              errors: { comment: [ "Comment is invalid" ] }
+            }, status: :unprocessable_entity
+          end
+
+          comment_permitted = comment_raw.permit(:body)
+          comment = Comment.new(
+            account: current_account,
+            ticket: ticket,
+            author: current_user,
+            body: comment_permitted[:body],
+            public: true
+          )
+        end
+
+        custom_status_error = nil
+        if has_status
+          status_raw = req_params[:status]
+          normalized_status = if status_raw.is_a?(String) || status_raw.is_a?(Symbol)
+            status_raw.to_s.strip.downcase
+          else
+            ""
+          end
+
+          allowed_statuses = has_comment ? %w[open solved] : %w[solved]
+          if allowed_statuses.include?(normalized_status)
+            ticket.status = normalized_status
+          else
+            custom_status_error = "Status is not included in the list"
+          end
+        else
+          ticket.status = "open"
+        end
+
+        ticket_valid = ticket.valid?
+        comment_valid = comment.nil? || comment.valid?
+
+        unless ticket_valid && comment_valid && custom_status_error.nil?
+          merged_errors = ticket.errors.to_hash(true)
+          merged_errors[:status] = [ custom_status_error ] if custom_status_error
+          comment&.errors&.to_hash(true)&.each do |key, messages|
+            merged_errors[:"comment.#{key}"] = messages
+          end
+          all_messages = ticket.errors.full_messages
+          all_messages += [ custom_status_error ] if custom_status_error
+          all_messages += comment.errors.full_messages if comment
+          return render json: {
+            error: all_messages.to_sentence,
+            errors: merged_errors
+          }, status: :unprocessable_entity
+        end
+
+        ActiveRecord::Base.transaction do
+          comment.save! if comment
+          ticket.updated_at = Time.current
+          ticket.save!
+        end
+
+        render json: { request: ticket.as_request_json }, status: :ok
+      end
+
+      private
+
+      def customer_requests_scope
+        current_account.tickets.where(requester_id: current_user.id)
+      end
+    end
+  end
+end
