+      assert_response :ok
+    end
+
+    get "/api/v1/tickets/#{ids[0]}/comments", params: { page: 1, per_page: 3 }, headers: owner_headers
+    assert_response :ok
+    cp1 = JSON.parse(response.body)
+    assert_equal [ "Initial comment 1", "Customer follow-up on Request 1", "Third comment" ], cp1.fetch("comments").map { |c| c.fetch("body") }
+    assert_equal 4, cp1.fetch("count")
+    assert_equal 1, cp1.fetch("page")
+    assert_equal 3, cp1.fetch("per_page")
+    assert_equal 2, cp1.fetch("next_page")
+    assert_nil cp1.fetch("previous_page")
+
+    get "/api/v1/requests/#{ids[0]}/comments", params: { page: 2, per_page: 3 }, headers: customer_headers
+    assert_response :ok
