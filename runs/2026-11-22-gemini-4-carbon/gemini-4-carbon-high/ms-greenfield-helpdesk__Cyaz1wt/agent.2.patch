+    assert_nil cp2.fetch("next_page")
+    assert_equal 1, cp2.fetch("previous_page")
+
+    # Invalid pagination parameters return 422
+    get "/api/v1/tickets", params: { page: 0 }, headers: owner_headers
+    assert_response :unprocessable_entity
+
+    get "/api/v1/requests", params: { per_page: 0 }, headers: customer_headers
+    assert_response :unprocessable_entity
+
+    get "/api/v1/requests/#{ids[0]}/comments", params: { page: "abc" }, headers: customer_headers
+    assert_response :unprocessable_entity
+  end
+
+  test "validation, role enforcement, cross-customer isolation, cross-tenant isolation, and cancelled account purge" do
+    acme_account, _ = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    register_and_verify_account!(account_name: "Globex", subdomain: "globex", email: "boss@globex.test")
+
+    register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@shared.test")
+    register_and_verify_customer!(subdomain: "acme", name: "Jordan", email: "jordan@acme.test")
+    register_and_verify_customer!(subdomain: "globex", name: "Avery Globex", email: "avery@shared.test")
+
+    acme_staff_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    globex_staff_token = sign_in!(subdomain: "globex", email: "boss@globex.test", password: "my-first-password").dig("session", "token")
+    avery_acme_token = sign_in!(subdomain: "acme", email: "avery@shared.test", password: "my-customer-password").dig("session", "token")
+    jordan_acme_token = sign_in!(subdomain: "acme", email: "jordan@acme.test", password: "my-customer-password").dig("session", "token")
+    avery_globex_token = sign_in!(subdomain: "globex", email: "avery@shared.test", password: "my-customer-password").dig("session", "token")
+
+    acme_staff_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{acme_staff_token}" }
+    globex_staff_headers = { "X-Helpdesk-Account" => "globex", "Authorization" => "Bearer #{globex_staff_token}" }
+    avery_acme_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{avery_acme_token}" }
+    jordan_acme_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{jordan_acme_token}" }
+    avery_globex_headers = { "X-Helpdesk-Account" => "globex", "Authorization" => "Bearer #{avery_globex_token}" }
+
+    # Validation errors when opening request
+    assert_no_difference -> { Ticket.count + Comment.count } do
+      post "/api/v1/requests", params: { request: { subject: "", comment: { body: "Hi" } } }, headers: avery_acme_headers, as: :json
+      assert_response :unprocessable_entity
+
+      post "/api/v1/requests", params: { request: { subject: "Valid", comment: { body: "   " } } }, headers: avery_acme_headers, as: :json
+      assert_response :unprocessable_entity
+
+      post "/api/v1/requests", params: { request: { subject: "Valid" } }, headers: avery_acme_headers, as: :json
+      assert_response :unprocessable_entity
+    end
+
+    # Avery opens a request on Acme
+    post "/api/v1/requests",
+      params: { request: { subject: "Acme Issue", comment: { body: "Help on Acme" } } },
+      headers: avery_acme_headers,
+      as: :json
+    assert_response :created
+    acme_ticket_id = JSON.parse(response.body).dig("request", "id")
+
+    # Jordan (another customer on Acme) cannot see, read comments, or reply to Avery's request
+    get "/api/v1/requests", headers: jordan_acme_headers
+    assert_response :ok
+    assert_equal 0, JSON.parse(response.body).fetch("count")
+
+    get "/api/v1/requests/#{acme_ticket_id}", headers: jordan_acme_headers
+    assert_response :not_found
+
+    get "/api/v1/requests/#{acme_ticket_id}/comments", headers: jordan_acme_headers
+    assert_response :not_found
+
+    patch "/api/v1/requests/#{acme_ticket_id}",
+      params: { request: { comment: { body: "Intruding" } } },
+      headers: jordan_acme_headers,
+      as: :json
+    assert_response :not_found
+
+    # Customers cannot access /tickets* routes (403 Forbidden)
+    get "/api/v1/tickets", headers: avery_acme_headers
+    assert_response :forbidden
+
+    get "/api/v1/tickets/#{acme_ticket_id}", headers: avery_acme_headers
+    assert_response :forbidden
+
+    get "/api/v1/tickets/#{acme_ticket_id}/comments", headers: avery_acme_headers
+    assert_response :forbidden
+
+    patch "/api/v1/tickets/#{acme_ticket_id}",
+      params: { ticket: { status: "solved" } },
+      headers: avery_acme_headers,
+      as: :json
+    assert_response :forbidden
+
+    # Staff cannot access /requests* routes (403 Forbidden)
+    get "/api/v1/requests", headers: acme_staff_headers
+    assert_response :forbidden
+
+    post "/api/v1/requests",
+      params: { request: { subject: "Staff request", comment: { body: "Nope" } } },
