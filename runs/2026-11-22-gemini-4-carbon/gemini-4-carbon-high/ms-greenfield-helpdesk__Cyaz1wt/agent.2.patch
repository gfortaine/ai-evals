--- /dev/null
+++ b/app/models/comment.rb
@@ -0,0 +1,35 @@
+class Comment < ApplicationRecord
+  belongs_to :account
+  belongs_to :ticket
+  belongs_to :author, class_name: "User", inverse_of: :comments
+
+  normalizes :body, with: ->(value) { value.to_s.strip }
+
+  validates :body, presence: true
+  validates :public, inclusion: { in: [ true, false ] }
+  validate :associations_belong_to_account
+
+  scope :oldest_first, -> { order(created_at: :asc, id: :asc) }
+
+  def as_api_json
+    {
+      id: id,
+      body: body,
+      author: author.as_author_json,
+      public: self[:public],
+      created_at: created_at
+    }
+  end
+
+  private
+
+  def associations_belong_to_account
+    if account_id.present? && ticket.present? && ticket.account_id.present? && ticket.account_id != account_id
+      errors.add(:ticket, :invalid)
+    end
+
+    if account_id.present? && author.present? && author.account_id != account_id
+      errors.add(:author, :invalid)
+    end
+  end
+end
