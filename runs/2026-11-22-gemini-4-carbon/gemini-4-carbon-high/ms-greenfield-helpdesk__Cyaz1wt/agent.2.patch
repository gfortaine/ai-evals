@@ -0,0 +1,653 @@
+require "test_helper"
+require "rake"
+
+class CustomerPortalAndTicketsTest < ActionDispatch::IntegrationTest
+  setup do
+    Helpdesk::Application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+  end
+
+  def register_and_verify_customer!(subdomain:, name:, email:, password: "my-customer-password")
+    post "/api/v1/registrations",
+      params: {
+        user: {
+          name: name,
+          email: email,
+          password: password
+        }
+      },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+
+    mail = ActionMailer::Base.deliveries.last
+    token = extract_token_from_mail(mail, expected_path: "/verify-email", expected_account: subdomain.downcase)
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+
+    ActionMailer::Base.deliveries.clear
+    account = Account.find_by!(subdomain: subdomain.downcase)
+    User.find_by!(account: account, email: email.strip.downcase)
+  end
+
+  test "customer registers and uses existing verification, login, profile, password change, and password reset flows" do
+    register_and_verify_account!
+
+    # Unknown account returns 404
+    post "/api/v1/registrations",
+      params: { user: { name: "Avery", email: "avery@example.test", password: "my-customer-password" } },
+      headers: { "X-Helpdesk-Account" => "nonexistent" },
+      as: :json
+    assert_response :not_found
+
+    # Invalid registration params return 422 and send no email
+    assert_no_emails do
+      post "/api/v1/registrations",
+        params: { user: { name: "  ", email: "bad-email", password: "" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+    end
+    assert_response :unprocessable_entity
+
+    # Duplicate email matching staff on same account fails
+    assert_no_emails do
+      post "/api/v1/registrations",
+        params: { user: { name: "Jo Clone", email: "JO@ACME.TEST", password: "my-customer-password" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+    end
+    assert_response :unprocessable_entity
+
+    # Valid customer registration ignores role/verified escalation
+    assert_emails 1 do
+      post "/api/v1/registrations",
+        params: {
+          user: {
+            name: "  Avery  ",
+            email: "  AVERY@EXAMPLE.TEST  ",
+            password: "my-customer-password",
+            role: "admin",
+            verified: true,
+            verified_at: Time.current
+          }
+        },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+    end
+    assert_response :created
+    registered = JSON.parse(response.body).fetch("user")
+    assert_equal "Avery", registered.fetch("name")
+    assert_equal "avery@example.test", registered.fetch("email")
+    assert_equal "customer", registered.fetch("role")
+    assert_equal false, registered.fetch("verified")
+
+    # Cannot sign in before verifying email
+    post "/api/v1/sessions",
+      params: { session: { email: "avery@example.test", password: "my-customer-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :forbidden
+
+    # Resend verification link and confirm
+    assert_emails 1 do
+      post "/api/v1/email_verifications",
+        params: { email_verification: { email: "avery@example.test" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+    end
+    assert_response :ok
+    verify_token = extract_token_from_mail(
+      ActionMailer::Base.deliveries.last,
+      expected_path: "/verify-email",
+      expected_account: "acme"
+    )
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: verify_token } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    assert_equal true, JSON.parse(response.body).dig("user", "verified")
+
+    # Login, view/update profile, change password, reset password, and logout
+    login = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password")
+    assert_equal "customer", login.dig("user", "role")
+    token = login.dig("session", "token")
+    headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token}" }
+
+    get "/api/v1/me", headers: headers
+    assert_response :ok
+    assert_equal "Avery", JSON.parse(response.body).dig("user", "name")
+
+    patch "/api/v1/me", params: { user: { name: "Avery Quinn", role: "admin" } }, headers: headers, as: :json
+    assert_response :ok
+    assert_equal "Avery Quinn", JSON.parse(response.body).dig("user", "name")
+    assert_equal "customer", JSON.parse(response.body).dig("user", "role")
+
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-customer-password", password: "new-customer-password" } },
+      headers: headers,
+      as: :json
+    assert_response :ok
+
+    # Old session revoked
+    get "/api/v1/me", headers: headers
+    assert_response :unauthorized
+
+    # Password reset flow
+    ActionMailer::Base.deliveries.clear
+    assert_emails 1 do
+      post "/api/v1/password_resets",
+        params: { password_reset: { email: "avery@example.test" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+    end
+    assert_response :ok
+    reset_token = extract_token_from_mail(
+      ActionMailer::Base.deliveries.last,
+      expected_path: "/reset-password",
+      expected_account: "acme"
+    )
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token, password: "recovered-customer-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+
+    recovered_login = sign_in!(subdomain: "acme", email: "avery@example.test", password: "recovered-customer-password")
+    recovered_token = recovered_login.dig("session", "token")
+
+    delete "/api/v1/session", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{recovered_token}" }
+    assert_response :no_content
+  end
+
+  test "full conversation lifecycle, status transitions for staff and customers, and no emails on replies" do
+    account, owner = register_and_verify_account!
+    agent = User.create!(
+      account: account,
+      name: "Sam Agent",
+      email: "sam@acme.test",
+      password: "agent-password",
+      role: "agent",
+      verified_at: Time.current
+    )
+    avery = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    agent_token = sign_in!(subdomain: "acme", email: "sam@acme.test", password: "agent-password").dig("session", "token")
+    customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+
+    owner_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    agent_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{agent_token}" }
+    customer_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{customer_token}" }
+
+    ActionMailer::Base.deliveries.clear
+
+    # Customer opens request (status always starts open even if solved is passed)
+    assert_no_emails do
+      post "/api/v1/requests",
+        params: {
+          request: {
+            subject: "  Cannot download my receipt  ",
+            status: "solved",
+            comment: { body: "The download button does nothing." }
+          }
+        },
+        headers: customer_headers,
+        as: :json
+    end
+    assert_response :created
+    req = JSON.parse(response.body).fetch("request")
+    ticket_id = req.fetch("id")
+    assert_equal "Cannot download my receipt", req.fetch("subject")
+    assert_equal "open", req.fetch("status")
+    assert_equal avery.id, req.fetch("requester_id")
+    assert_nil req["requester"]
+    assert_not_nil Time.iso8601(req.fetch("created_at"))
+    assert_not_nil Time.iso8601(req.fetch("updated_at"))
+
+    # Customer GET /requests/:id
+    get "/api/v1/requests/#{ticket_id}", headers: customer_headers
+    assert_response :ok
+    assert_equal req, JSON.parse(response.body).fetch("request")
+
+    # Staff (agent as well as owner) can view /tickets and /tickets/:id with requester hash
+    get "/api/v1/tickets/#{ticket_id}", headers: agent_headers
+    assert_response :ok
+    ticket_json = JSON.parse(response.body).fetch("ticket")
+    assert_equal ticket_id, ticket_json.fetch("id")
+    assert_equal "Cannot download my receipt", ticket_json.fetch("subject")
+    assert_equal "open", ticket_json.fetch("status")
+    assert_equal(
+      { "id" => avery.id, "name" => "Avery", "email" => "avery@example.test" },
+      ticket_json.fetch("requester")
+    )
+
+    # Posting a staff reply by itself does NOT change status (stays open)
+    assert_no_emails do
+      patch "/api/v1/tickets/#{ticket_id}",
+        params: { ticket: { comment: { body: "Let me check our logs." } } },
+        headers: agent_headers,
+        as: :json
+    end
+    assert_response :ok
+    assert_equal "open", JSON.parse(response.body).dig("ticket", "status")
+
+    # Owner replies and marks ticket pending
+    assert_no_emails do
+      patch "/api/v1/tickets/#{ticket_id}",
+        params: { ticket: { comment: { body: "Please try again now." }, status: "pending" } },
+        headers: owner_headers,
+        as: :json
+    end
+    assert_response :ok
+    assert_equal "pending", JSON.parse(response.body).dig("ticket", "status")
+
+    # Posting another staff reply by itself keeps status pending
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { comment: { body: "Let us know if you need screenshots." } } },
+      headers: owner_headers,
+      as: :json
+    assert_response :ok
+    assert_equal "pending", JSON.parse(response.body).dig("ticket", "status")
+
+    # Customer cannot set status to pending
+    assert_no_difference -> { Comment.count } do
+      patch "/api/v1/requests/#{ticket_id}",
+        params: { request: { comment: { body: "Trying pending" }, status: "pending" } },
+        headers: customer_headers,
+        as: :json
+    end
+    assert_response :unprocessable_entity
+    assert_equal "pending", Ticket.find(ticket_id).status
+
+    # Customer reply on pending request reopens it to open
+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { comment: { body: "It still fails in Safari." } } },
+      headers: customer_headers,
+      as: :json
+    assert_response :ok
+    assert_equal "open", JSON.parse(response.body).dig("request", "status")
+
+    # Staff can mark solved without adding a comment
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { status: "solved" } },
+      headers: owner_headers,
+      as: :json
+    assert_response :ok
+    assert_equal "solved", JSON.parse(response.body).dig("ticket", "status")
+
+    # Staff reply on solved ticket keeps it solved
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { comment: { body: "Deployed Safari fix as well." } } },
+      headers: agent_headers,
+      as: :json
+    assert_response :ok
+    assert_equal "solved", JSON.parse(response.body).dig("ticket", "status")
+
+    # Customer reply on solved request reopens it to open
+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { comment: { body: "Wait, one more question." } } },
+      headers: customer_headers,
+      as: :json
+    assert_response :ok
+    assert_equal "open", JSON.parse(response.body).dig("request", "status")
+
+    # Staff marks pending; customer replies AND marks solved in the same update -> stays/becomes solved!
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { status: "pending" } },
+      headers: owner_headers,
+      as: :json
+    assert_response :ok
+    assert_equal "pending", JSON.parse(response.body).dig("ticket", "status")
+
+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { comment: { body: "All good now, thank you!" }, status: "solved" } },
+      headers: customer_headers,
+      as: :json
+    assert_response :ok
+    assert_equal "solved", JSON.parse(response.body).dig("request", "status")
+
+    # Staff can reopen to open; customer can also mark solved directly
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { status: "open" } },
+      headers: owner_headers,
+      as: :json
+    assert_response :ok
+    assert_equal "open", JSON.parse(response.body).dig("ticket", "status")
+
+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { status: "solved" } },
+      headers: customer_headers,
+      as: :json
+    assert_response :ok
+    assert_equal "solved", JSON.parse(response.body).dig("request", "status")
+
+    # Comments on both /requests/:id/comments and /tickets/:id/comments are oldest first with exact fields
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: owner_headers
+    assert_response :ok
+    staff_comments = JSON.parse(response.body).fetch("comments")
+    expected_bodies = [
+      "The download button does nothing.",
+      "Let me check our logs.",
+      "Please try again now.",
+      "Let us know if you need screenshots.",
+      "It still fails in Safari.",
+      "Deployed Safari fix as well.",
+      "Wait, one more question.",
+      "All good now, thank you!"
+    ]
+    assert_equal expected_bodies, staff_comments.map { |c| c.fetch("body") }
+    assert_equal({ "id" => avery.id, "name" => "Avery" }, staff_comments[0].fetch("author"))
+    assert_equal({ "id" => agent.id, "name" => "Sam Agent" }, staff_comments[1].fetch("author"))
+    assert_equal({ "id" => owner.id, "name" => "Jo" }, staff_comments[2].fetch("author"))
+    assert staff_comments.all? { |c| c.fetch("public") == true }
+
+    get "/api/v1/requests/#{ticket_id}/comments", headers: customer_headers
+    assert_response :ok
+    customer_comments = JSON.parse(response.body).fetch("comments")
+    assert_equal expected_bodies, customer_comments.map { |c| c.fetch("body") }
+  end
+
+  test "recently active ordering and pagination for requests, tickets, and comments" do
+    register_and_verify_account!
+    avery = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+    owner_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    customer_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{customer_token}" }
+
+    # Empty list defaults
+    get "/api/v1/requests", headers: customer_headers
+    assert_response :ok
+    empty_body = JSON.parse(response.body)
+    assert_equal([], empty_body.fetch("requests"))
+    assert_equal 0, empty_body.fetch("count")
+    assert_equal 1, empty_body.fetch("page")
+    assert_equal 25, empty_body.fetch("per_page")
+    assert_nil empty_body.fetch("next_page")
+    assert_nil empty_body.fetch("previous_page")
+
+    base_time = Time.utc(2026, 11, 21, 10, 0, 0)
+    ids = []
+
+    5.times do |i|
+      travel_to(base_time + i.minutes) do
+        post "/api/v1/requests",
+          params: {
+            request: {
+              subject: "Request #{i + 1}",
+              comment: { body: "Initial comment #{i + 1}" }
+            }
+          },
+          headers: customer_headers,
+          as: :json
+        assert_response :created
+        ids << JSON.parse(response.body).dig("request", "id")
+      end
+    end
+
+    # Initial order: [5, 4, 3, 2, 1]
+    get "/api/v1/requests", headers: customer_headers
+    assert_response :ok
+    assert_equal ids.reverse, JSON.parse(response.body).fetch("requests").map { |r| r.fetch("id") }
+
+    # Staff replies to Request 2 WITHOUT changing status -> Request 2 moves to front!
+    travel_to(base_time + 10.minutes) do
+      patch "/api/v1/tickets/#{ids[1]}",
+        params: { ticket: { comment: { body: "Staff reply on Request 2" } } },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+    end
+
+    # Customer replies to Request 1 -> Request 1 moves to front!
+    travel_to(base_time + 15.minutes) do
+      patch "/api/v1/requests/#{ids[0]}",
+        params: { request: { comment: { body: "Customer follow-up on Request 1" } } },
+        headers: customer_headers,
+        as: :json
+      assert_response :ok
+    end
+
+    expected_order = [ ids[0], ids[1], ids[4], ids[3], ids[2] ]
+
+    # Paginate requests with per_page=2 across 3 pages
+    get "/api/v1/requests", params: { page: 1, per_page: 2 }, headers: customer_headers
+    assert_response :ok
+    p1 = JSON.parse(response.body)
+    assert_equal expected_order[0, 2], p1.fetch("requests").map { |r| r.fetch("id") }
+    assert_equal 5, p1.fetch("count")
+    assert_equal 1, p1.fetch("page")
+    assert_equal 2, p1.fetch("per_page")
+    assert_equal 2, p1.fetch("next_page")
+    assert_nil p1.fetch("previous_page")
+
+    get "/api/v1/requests", params: { page: 2, per_page: 2 }, headers: customer_headers
+    assert_response :ok
+    p2 = JSON.parse(response.body)
+    assert_equal expected_order[2, 2], p2.fetch("requests").map { |r| r.fetch("id") }
+    assert_equal 5, p2.fetch("count")
+    assert_equal 2, p2.fetch("page")
+    assert_equal 2, p2.fetch("per_page")
+    assert_equal 3, p2.fetch("next_page")
+    assert_equal 1, p2.fetch("previous_page")
+
+    get "/api/v1/requests", params: { page: 3, per_page: 2 }, headers: customer_headers
+    assert_response :ok
+    p3 = JSON.parse(response.body)
+    assert_equal expected_order[4, 1], p3.fetch("requests").map { |r| r.fetch("id") }
+    assert_equal 5, p3.fetch("count")
+    assert_equal 3, p3.fetch("page")
+    assert_equal 2, p3.fetch("per_page")
+    assert_nil p3.fetch("next_page")
+    assert_equal 2, p3.fetch("previous_page")
+
+    # Exact boundary per_page=5 -> next_page is nil
+    get "/api/v1/tickets", params: { page: 1, per_page: 5 }, headers: owner_headers
+    assert_response :ok
+    exact = JSON.parse(response.body)
+    assert_equal expected_order, exact.fetch("tickets").map { |t| t.fetch("id") }
+    assert_equal 5, exact.fetch("count")
