diff --git a/config/initializers/cors.rb b/config/initializers/cors.rb
new file mode 100644
index 0000000..4b24f58
--- /dev/null
+++ b/config/initializers/cors.rb
@@ -0,0 +1,28 @@
+require "uri"
+
+Rails.application.config.middleware.insert_before 0, Rack::Cors do
+  allow do
+    origins do |source, _env|
+      configured_url = (ENV["HELPDESK_FRONTEND_URL"].presence || "http://localhost:3001").strip
+      configured_origin =
+        begin
+          uri = URI.parse(configured_url)
+          if uri.scheme && uri.host
+            default_port = (uri.scheme == "http" && uri.port == 80) || (uri.scheme == "https" && uri.port == 443)
+            port_part = uri.port && !default_port ? ":#{uri.port}" : ""
+            "#{uri.scheme}://#{uri.host}#{port_part}"
+          else
+            configured_url.chomp("/")
+          end
+        rescue URI::InvalidURIError
+          configured_url.chomp("/")
+        end
+
+      source == configured_origin
+    end
+
+    resource "*",
+      headers: :any,
+      methods: %i[get post put patch delete options head]
+  end
+end
