diff --git a/test/integration/account_cancellation_and_purge_test.rb b/test/integration/account_cancellation_and_purge_test.rb
new file mode 100644
index 0000000..e3edaff
--- /dev/null
+++ b/test/integration/account_cancellation_and_purge_test.rb
@@ -0,0 +1,160 @@
+require "test_helper"
+require "rake"
+
+class AccountCancellationAndPurgeTest < ActionDispatch::IntegrationTest
+  setup do
+    Helpdesk::Application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+  end
+
+  test "owner can cancel and reactivate within 90 days; cancellation revokes sessions and stops ordinary access" do
+    account, _owner = register_and_verify_account!
+    teammate = User.create!(
+      account: account,
+      name: "Alex",
+      email: "alex@acme.test",
+      password: "teammate-password",
+      role: "admin",
+      verified_at: Time.current
+    )
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    teammate_token = sign_in!(subdomain: "acme", email: "alex@acme.test", password: "teammate-password").dig("session", "token")
+
+    # Non-owner cannot cancel the account
+    post "/api/v1/account/cancel", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{teammate_token}"
+    }
+    assert_response :forbidden
+
+    # Owner cancels the account
+    post "/api/v1/account/cancel", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{owner_token}"
+    }
+    assert_response :ok
+    cancelled_account_json = JSON.parse(response.body).fetch("account")
+    assert_not_nil cancelled_account_json.fetch("cancelled_at")
+
+    # Existing sessions for both owner and teammate are revoked
+    get "/api/v1/me", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{owner_token}"
+    }
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{teammate_token}"
+    }
+    assert_response :unauthorized
+
+    # Public portal and ordinary unauthenticated flows are stopped
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :forbidden
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "alex@acme.test" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :forbidden
+
+    # Non-owner cannot sign in while cancelled
+    post "/api/v1/sessions",
+      params: { session: { email: "alex@acme.test", password: "teammate-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :forbidden
+
+    # Owner CAN still sign in to reactivate
+    travel 89.days do
+      reactivate_login = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+      new_owner_token = reactivate_login.dig("session", "token")
+      owner_headers = {
+        "X-Helpdesk-Account" => "acme",
+        "Authorization" => "Bearer #{new_owner_token}"
+      }
+
+      # Ordinary business endpoints remain blocked until reactivated
+      get "/api/v1/me", headers: owner_headers
+      assert_response :forbidden
+
+      patch "/api/v1/me", params: { user: { name: "Blocked" } }, headers: owner_headers, as: :json
+      assert_response :forbidden
+
+      get "/api/v1/account", headers: owner_headers
+      assert_response :forbidden
+
+      # Reactivate within 90 days succeeds
+      post "/api/v1/account/reactivate", headers: owner_headers
+      assert_response :ok
+      assert_nil JSON.parse(response.body).dig("account", "cancelled_at")
+
+      # Ordinary access is restored immediately
+      get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+      assert_response :ok
+
+      get "/api/v1/me", headers: owner_headers
+      assert_response :ok
+
+      get "/api/v1/account", headers: owner_headers
+      assert_response :ok
+
+      assert_not_nil teammate
+      sign_in!(subdomain: "acme", email: "alex@acme.test", password: "teammate-password")
+    end
+  end
+
+  test "cannot reactivate after 90 days and helpdesk:purge_cancelled_accounts deletes expired cancelled accounts and all data" do
+    expired_account, _ = register_and_verify_account!(account_name: "Old Co", subdomain: "oldco", email: "owner@oldco.test")
+    recent_account, _ = register_and_verify_account!(account_name: "Recent Co", subdomain: "recentco", email: "owner@recentco.test")
+    active_account, _ = register_and_verify_account!(account_name: "Active Co", subdomain: "activeco", email: "owner@activeco.test")
+
+    # Add extra user and session data
+    User.create!(account: expired_account, name: "Extra", email: "extra@oldco.test", password: "password123", verified_at: Time.current)
+    active_token = sign_in!(subdomain: "activeco", email: "owner@activeco.test", password: "my-first-password").dig("session", "token")
+
+    old_token = sign_in!(subdomain: "oldco", email: "owner@oldco.test", password: "my-first-password").dig("session", "token")
+    post "/api/v1/account/cancel", headers: { "X-Helpdesk-Account" => "oldco", "Authorization" => "Bearer #{old_token}" }
+    assert_response :ok
+
+    travel 50.days do
+      recent_token = sign_in!(subdomain: "recentco", email: "owner@recentco.test", password: "my-first-password").dig("session", "token")
+      post "/api/v1/account/cancel", headers: { "X-Helpdesk-Account" => "recentco", "Authorization" => "Bearer #{recent_token}" }
+      assert_response :ok
+    end
+
+    travel 91.days do
+      # Owner of oldco (cancelled 91 days ago) cannot reactivate
+      late_owner_token = sign_in!(subdomain: "oldco", email: "owner@oldco.test", password: "my-first-password").dig("session", "token")
+      post "/api/v1/account/reactivate", headers: {
+        "X-Helpdesk-Account" => "oldco",
+        "Authorization" => "Bearer #{late_owner_token}"
+      }
+      assert_response :unprocessable_entity
+
+      # Run cleanup task: oldco (91 days) is purged; recentco (41 days) and activeco remain
+      Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+      Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+
+      assert_nil Account.find_by(id: expired_account.id)
+      assert_equal 0, User.where(account_id: expired_account.id).count
+      assert_equal 0, Session.where(account_id: expired_account.id).count
+
+      assert_not_nil Account.find_by(id: recent_account.id)
+      assert_not_nil Account.find_by(id: active_account.id)
+      assert_equal 1, Session.where(account_id: active_account.id).count
+
+      # Purged account now returns 404
+      get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "oldco" }
+      assert_response :not_found
+
+      # Active account session still works
+      get "/api/v1/me", headers: {
+        "X-Helpdesk-Account" => "activeco",
+        "Authorization" => "Bearer #{active_token}"
+      }
+      assert_response :ok
+    end
+  end
+end
diff --git a/test/integration/business_signup_and_portal_test.rb b/test/integration/business_signup_and_portal_test.rb
new file mode 100644
index 0000000..7a1565a
--- /dev/null
+++ b/test/integration/business_signup_and_portal_test.rb
@@ -0,0 +1,197 @@
+require "test_helper"
+
+class BusinessSignupAndPortalTest < ActionDispatch::IntegrationTest
+  test "registers business, returns account and unverified admin user, and sends verification email" do
+    assert_difference -> { Account.count }, 1 do
+      assert_difference -> { User.count }, 1 do
+        assert_emails 1 do
+          post "/api/v1/account/create",
+            params: {
+              account: {
+                name: "Acme",
+                subdomain: "acme",
+                admin: {
+                  name: "Jo",
+                  email: "jo@acme.test",
+                  password: "my-first-password"
+                }
+              }
+            },
+            as: :json
+        end
+      end
+    end
+
+    assert_response :created
+    body = JSON.parse(response.body)
+
+    account = body.fetch("account")
+    assert_kind_of Integer, account.fetch("id")
+    assert_equal "Acme", account.fetch("name")
+    assert_equal "acme", account.fetch("subdomain")
+    assert_not_nil Time.iso8601(account.fetch("created_at"))
+    assert_not_nil Time.iso8601(account.fetch("updated_at"))
+
+    user = body.fetch("user")
+    assert_kind_of Integer, user.fetch("id")
+    assert_equal "Jo", user.fetch("name")
+    assert_equal "jo@acme.test", user.fetch("email")
+    assert_equal "admin", user.fetch("role")
+    assert_equal false, user.fetch("verified")
+    assert_not_nil Time.iso8601(user.fetch("created_at"))
+    assert_not_nil Time.iso8601(user.fetch("updated_at"))
+    assert_nil user["password_digest"]
+    assert_nil user["email_verification_token_digest"]
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "support@example.test" ], mail.from
+    assert_equal [ "jo@acme.test" ], mail.to
+    assert_includes mail.body.decoded, "http://localhost:3001/verify-email?account=acme&token="
+  end
+
+  test "respects HELPDESK_FRONTEND_URL and HELPDESK_MAIL_FROM when sending verification email" do
+    with_env(
+      "HELPDESK_FRONTEND_URL" => "https://desk.example.test/",
+      "HELPDESK_MAIL_FROM" => "no-reply@desk.example.test"
+    ) do
+      post "/api/v1/account/create",
+        params: {
+          account: {
+            name: "Acme",
+            subdomain: "acme",
+            admin: {
+              name: "Jo",
+              email: "jo@acme.test",
+              password: "my-first-password"
+            }
+          }
+        },
+        as: :json
+      assert_response :created
+
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "no-reply@desk.example.test" ], mail.from
+      assert_includes mail.body.decoded, "https://desk.example.test/verify-email?account=acme&token="
+      refute_includes mail.body.decoded, "https://desk.example.test//verify-email"
+    end
+  end
+
+  test "allows the same email to belong to different businesses" do
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Acme",
+          subdomain: "acme",
+          admin: { name: "Jo Acme", email: "jo@shared.test", password: "acme-password" }
+        }
+      },
+      as: :json
+    assert_response :created
+
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Globex",
+          subdomain: "globex",
+          admin: { name: "Jo Globex", email: "jo@shared.test", password: "globex-password" }
+        }
+      },
+      as: :json
+    assert_response :created
+
+    assert_equal 2, Account.count
+    assert_equal 2, User.where(email: "jo@shared.test").count
+  end
+
+  test "rolls back signup atomically when subdomain is duplicate or admin params are invalid" do
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Acme",
+          subdomain: "acme",
+          admin: { name: "Jo", email: "jo@acme.test", password: "my-first-password" }
+        }
+      },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+
+    # Duplicate subdomain (case-insensitive)
+    assert_no_difference -> { Account.count + User.count } do
+      post "/api/v1/account/create",
+        params: {
+          account: {
+            name: "Acme Two",
+            subdomain: "ACME",
+            admin: { name: "Sam", email: "sam@acme.test", password: "my-first-password" }
+          }
+        },
+        as: :json
+      assert_response :unprocessable_entity
+    end
+    assert_empty ActionMailer::Base.deliveries
+
+    # Valid new account but invalid admin email/password
+    assert_no_difference -> { Account.count + User.count } do
+      post "/api/v1/account/create",
+        params: {
+          account: {
+            name: "Beta",
+            subdomain: "beta",
+            admin: { name: "Sam", email: "not-an-email", password: "" }
+          }
+        },
+        as: :json
+      assert_response :unprocessable_entity
+    end
+    assert_empty ActionMailer::Base.deliveries
+
+    # Missing admin payload
+    assert_no_difference -> { Account.count + User.count } do
+      post "/api/v1/account/create",
+        params: { account: { name: "Gamma", subdomain: "gamma" } },
+        as: :json
+      assert_response :unprocessable_entity
+    end
+
+    # Non-hash account payload
+    post "/api/v1/account/create", params: { account: "invalid" }, as: :json
+    assert_response :unprocessable_entity
+  end
+
+  test "GET /portal returns public portal info and GET /account returns full account to signed-in users" do
+    register_and_verify_account!
+
+    # Public portal without authentication
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :ok
+    portal_body = JSON.parse(response.body)
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, portal_body)
+
+    # Missing or unknown X-Helpdesk-Account header
+    get "/api/v1/portal"
+    assert_response :not_found
+
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "unknown" }
+    assert_response :not_found
+
+    # GET /account requires authentication
+    get "/api/v1/account", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :unauthorized
+
+    login = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token = login.dig("session", "token")
+
+    get "/api/v1/account", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{token}"
+    }
+    assert_response :ok
+    account_body = JSON.parse(response.body).fetch("account")
+    assert_equal "Acme", account_body.fetch("name")
+    assert_equal "acme", account_body.fetch("subdomain")
+    assert_kind_of Integer, account_body.fetch("id")
+    assert_not_nil account_body.fetch("created_at")
+    assert_not_nil account_body.fetch("updated_at")
+  end
+end
diff --git a/test/integration/cors_test.rb b/test/integration/cors_test.rb
new file mode 100644
