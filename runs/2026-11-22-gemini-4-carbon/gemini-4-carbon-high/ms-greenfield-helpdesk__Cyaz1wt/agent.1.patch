--- /dev/null
+++ b/test/integration/cors_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class CorsTest < ActionDispatch::IntegrationTest
+  test "allows CORS preflight and requests from default frontend origin and blocks others" do
+    register_and_verify_account!
+
+    options "/api/v1/portal", headers: {
+      "Origin" => "http://localhost:3001",
+      "Access-Control-Request-Method" => "GET",
+      "Access-Control-Request-Headers" => "X-Helpdesk-Account, Authorization, Content-Type"
+    }
+    assert_response :ok
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+    assert_includes response.headers["Access-Control-Allow-Methods"], "PATCH"
+    assert_includes response.headers["Access-Control-Allow-Methods"], "PUT"
+    assert_includes response.headers["Access-Control-Allow-Methods"], "DELETE"
+
+    # Unconfigured origin is not allowed
+    get "/api/v1/portal", headers: {
+      "Origin" => "http://evil.example.test",
+      "X-Helpdesk-Account" => "acme"
+    }
+    assert_response :ok
+    assert_nil response.headers["Access-Control-Allow-Origin"]
+
+    # Configured custom frontend origin (even with trailing slash in env)
+    with_env("HELPDESK_FRONTEND_URL" => "https://frontend.helpdesk.test/") do
+      get "/api/v1/portal", headers: {
+        "Origin" => "https://frontend.helpdesk.test",
+        "X-Helpdesk-Account" => "acme"
+      }
+      assert_response :ok
+      assert_equal "https://frontend.helpdesk.test", response.headers["Access-Control-Allow-Origin"]
+    end
+  end
+end
diff --git a/test/integration/edge_cases_and_isolation_test.rb b/test/integration/edge_cases_and_isolation_test.rb
new file mode 100644
index 0000000..471ec14
--- /dev/null
+++ b/test/integration/edge_cases_and_isolation_test.rb
@@ -0,0 +1,234 @@
+require "test_helper"
+require "rake"
+
+class EdgeCasesAndIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    Helpdesk::Application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+  end
+
+  test "normalizes case and whitespace for subdomain, X-Helpdesk-Account, and emails" do
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "  Acme Corp  ",
+          subdomain: "  AcMe-Corp  ",
+          admin: {
+            name: "  Jo Doe  ",
+            email: "  JO@ACME.TEST  ",
+            password: "my-first-password"
+          }
+        }
+      },
+      as: :json
+    assert_response :created
+    signup_body = JSON.parse(response.body)
+    assert_equal "Acme Corp", signup_body.dig("account", "name")
+    assert_equal "acme-corp", signup_body.dig("account", "subdomain")
+    assert_equal "Jo Doe", signup_body.dig("user", "name")
+    assert_equal "jo@acme.test", signup_body.dig("user", "email")
+
+    mail = ActionMailer::Base.deliveries.last
+    token = extract_token_from_mail(mail, expected_path: "/verify-email", expected_account: "acme-corp")
+
+    # Confirm with uppercase X-Helpdesk-Account header
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => "  ACME-CORP  " },
+      as: :json
+    assert_response :ok
+
+    # Sign in with mixed-case email and X-Helpdesk-Account
+    post "/api/v1/sessions",
+      params: { session: { email: "  Jo@Acme.Test ", password: "my-first-password" } },
+      headers: { "X-Helpdesk-Account" => "ACME-CORP" },
+      as: :json
+    assert_response :created
+    session_token = JSON.parse(response.body).dig("session", "token")
+
+    # Lowercase 'bearer' scheme works; malformed Authorization headers fail with 401
+    get "/api/v1/me", headers: {
+      "X-Helpdesk-Account" => "acme-corp",
+      "Authorization" => "bearer #{session_token}"
+    }
+    assert_response :ok
+
+    get "/api/v1/me", headers: {
+      "X-Helpdesk-Account" => "acme-corp",
+      "Authorization" => "Basic #{session_token}"
+    }
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: {
+      "X-Helpdesk-Account" => "acme-corp",
+      "Authorization" => "Bearer "
+    }
+    assert_response :unauthorized
+  end
+
+  test "cross-tenant isolation for same email across verification, password change, password reset, and cancellation" do
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Acme",
+          subdomain: "acme",
+          admin: { name: "Jo", email: "jo@shared.test", password: "acme-password" }
+        }
+      },
+      as: :json
+    assert_response :created
+    acme_verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, expected_path: "/verify-email", expected_account: "acme")
+
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Globex",
+          subdomain: "globex",
+          admin: { name: "Jo", email: "jo@shared.test", password: "globex-password" }
+        }
+      },
+      as: :json
+    assert_response :created
+    globex_verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, expected_path: "/verify-email", expected_account: "globex")
+
+    # Acme verification token cannot verify Globex user
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: acme_verify_token } },
+      headers: { "X-Helpdesk-Account" => "globex" },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Confirm both on their respective accounts
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: acme_verify_token } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: globex_verify_token } },
+      headers: { "X-Helpdesk-Account" => "globex" },
+      as: :json
+    assert_response :ok
+
+    acme_session = sign_in!(subdomain: "acme", email: "jo@shared.test", password: "acme-password").dig("session", "token")
+    globex_session = sign_in!(subdomain: "globex", email: "jo@shared.test", password: "globex-password").dig("session", "token")
+
+    # Changing password on Acme does NOT revoke Globex session
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "acme-password", password: "new-acme-password" } },
+      headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{acme_session}" },
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "globex", "Authorization" => "Bearer #{globex_session}" }
+    assert_response :ok
+
+    # Password reset token on Acme cannot be used on Globex
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@shared.test" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    acme_reset_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, expected_path: "/reset-password", expected_account: "acme")
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: acme_reset_token, password: "hijacked-password" } },
+      headers: { "X-Helpdesk-Account" => "globex" },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Globex password is unchanged
+    sign_in!(subdomain: "globex", email: "jo@shared.test", password: "globex-password")
+  end
+
+  test "unknown email on verification or password reset does not leak user existence; blank email returns 422" do
+    register_and_verify_account!
+
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "nobody@acme.test" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    assert_empty ActionMailer::Base.deliveries
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "nobody@acme.test" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    assert_empty ActionMailer::Base.deliveries
+
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "   " } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_entity
+  end
+
+  test "exact 90-day boundary, double cancel/reactivate errors, and owner sign-out while cancelled" do
+    base_time = Time.utc(2026, 11, 21, 12, 0, 0)
+    account = nil
+
+    travel_to(base_time) do
+      account, _ = register_and_verify_account!
+      owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+      # Cannot reactivate an active account
+      post "/api/v1/account/reactivate", headers: {
+        "X-Helpdesk-Account" => "acme",
+        "Authorization" => "Bearer #{owner_token}"
+      }
+      assert_response :unprocessable_entity
+
+      # Cancel account
+      post "/api/v1/account/cancel", headers: {
+        "X-Helpdesk-Account" => "acme",
+        "Authorization" => "Bearer #{owner_token}"
+      }
+      assert_response :ok
+
+      # Owner signs in while cancelled, cannot cancel again, and CAN sign out via DELETE /session
+      cancelled_session_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+      post "/api/v1/account/cancel", headers: {
+        "X-Helpdesk-Account" => "acme",
+        "Authorization" => "Bearer #{cancelled_session_token}"
+      }
+      assert_response :unprocessable_entity
+
+      delete "/api/v1/session", headers: {
+        "X-Helpdesk-Account" => "acme",
+        "Authorization" => "Bearer #{cancelled_session_token}"
+      }
+      assert_response :no_content
+    end
+
+    # At 90 days minus 1 second: NOT purged
+    travel_to(base_time + 90.days - 1.second) do
+      Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+      Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+      assert_not_nil Account.find_by(id: account.id)
+    end
+
+    # At exact 90 days: reactivation rejected and purged by task
+    travel_to(base_time + 90.days) do
+      expired_session_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+      post "/api/v1/account/reactivate", headers: {
+        "X-Helpdesk-Account" => "acme",
+        "Authorization" => "Bearer #{expired_session_token}"
+      }
+      assert_response :unprocessable_entity
+
+      Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+      Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+      assert_nil Account.find_by(id: account.id)
+    end
+  end
+end
diff --git a/test/integration/email_verifications_and_sessions_test.rb b/test/integration/email_verifications_and_sessions_test.rb
new file mode 100644
index 0000000..8de2a07
--- /dev/null
+++ b/test/integration/email_verifications_and_sessions_test.rb
@@ -0,0 +1,123 @@
+require "test_helper"
+
+class EmailVerificationsAndSessionsTest < ActionDispatch::IntegrationTest
+  test "unverified user cannot sign in until email is confirmed; new verification links replace old ones" do
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Acme",
+          subdomain: "acme",
+          admin: { name: "Jo", email: "jo@acme.test", password: "my-first-password" }
+        }
+      },
+      as: :json
+    assert_response :created
+
+    first_mail = ActionMailer::Base.deliveries.last
+    first_token = extract_token_from_mail(first_mail, expected_path: "/verify-email", expected_account: "acme")
+
+    # Wrong password returns 401
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "wrong-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unauthorized
+
+    # Right password before verification returns 403
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :forbidden
+
+    # Requesting another verification link replaces the old one
+    assert_emails 1 do
+      post "/api/v1/email_verifications",
+        params: { email_verification: { email: "jo@acme.test" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+    end
+    assert_response :ok
+
+    second_mail = ActionMailer::Base.deliveries.last
+    second_token = extract_token_from_mail(second_mail, expected_path: "/verify-email", expected_account: "acme")
+    assert_not_equal first_token, second_token
+
+    # Old token is rejected
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: first_token } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # New token succeeds
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: second_token } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    assert_equal true, JSON.parse(response.body).dig("user", "verified")
+
+    # Reusing confirmed token is rejected
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: second_token } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Requesting verification link when already verified sends no email and keeps verified true
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "jo@acme.test" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    assert_empty ActionMailer::Base.deliveries
+
+    # Now sign-in succeeds
+    login = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    assert_not_empty login.dig("session", "token")
+    assert_equal "Jo", login.dig("user", "name")
+    assert_equal "admin", login.dig("user", "role")
+    assert_equal true, login.dig("user", "verified")
+    assert_equal "acme", login.dig("account", "subdomain")
+  end
+
+  test "DELETE /session signs out only that session and sessions are strictly scoped per business" do
+    register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@shared.test", password: "pw1")
+    register_and_verify_account!(account_name: "Globex", subdomain: "globex", email: "jo@shared.test", password: "pw2")
+
+    login_a = sign_in!(subdomain: "acme", email: "jo@shared.test", password: "pw1")
+    login_b = sign_in!(subdomain: "acme", email: "jo@shared.test", password: "pw1")
+    token_a = login_a.dig("session", "token")
+    token_b = login_b.dig("session", "token")
+
+    # Acme token cannot access Globex
+    get "/api/v1/me", headers: {
+      "X-Helpdesk-Account" => "globex",
+      "Authorization" => "Bearer #{token_a}"
+    }
+    assert_response :unauthorized
+
+    # Sign out session A
+    delete "/api/v1/session", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{token_a}"
+    }
+    assert_response :no_content
+
+    # Session A is now invalid
+    get "/api/v1/me", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{token_a}"
+    }
+    assert_response :unauthorized
+
+    # Session B still works
+    get "/api/v1/me", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{token_b}"
+    }
+    assert_response :ok
+  end
+end
diff --git a/test/integration/profile_and_passwords_test.rb b/test/integration/profile_and_passwords_test.rb
new file mode 100644
index 0000000..6f7ea6e
--- /dev/null
+++ b/test/integration/profile_and_passwords_test.rb
@@ -0,0 +1,144 @@
+require "test_helper"
+
+class ProfileAndPasswordsTest < ActionDispatch::IntegrationTest
+  test "GET /me and PATCH /me read and update user name safely" do
+    register_and_verify_account!
+    login = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token = login.dig("session", "token")
+    headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token}" }
+
+    get "/api/v1/me", headers: headers
+    assert_response :ok
+    assert_equal "Jo", JSON.parse(response.body).dig("user", "name")
+
+    patch "/api/v1/me",
+      params: { user: { name: "Jo Smith", role: "customer", verified: false } },
+      headers: headers,
+      as: :json
+    assert_response :ok
+    updated_user = JSON.parse(response.body).fetch("user")
+    assert_equal "Jo Smith", updated_user.fetch("name")
+    assert_equal "admin", updated_user.fetch("role")
+    assert_equal true, updated_user.fetch("verified")
+
+    patch "/api/v1/me",
+      params: { user: { name: "   " } },
+      headers: headers,
+      as: :json
+    assert_response :unprocessable_entity
+  end
+
+  test "PUT /me/password updates password and revokes existing sessions" do
+    register_and_verify_account!
+    token_1 = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    token_2 = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    headers_1 = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token_1}" }
+
+    # Wrong current_password fails without revoking sessions
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "wrong", password: "my-new-password" } },
+      headers: headers_1,
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Blank new password fails without revoking sessions
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "" } },
+      headers: headers_1,
+      as: :json
+    assert_response :unprocessable_entity
+
+    get "/api/v1/me", headers: headers_1
+    assert_response :ok
+
+    # Valid password change succeeds and signs out all existing sessions
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+      headers: headers_1,
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: headers_1
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token_2}" }
+    assert_response :unauthorized
+
+    # Old password no longer works; new password works
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unauthorized
+
+    sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-new-password")
+  end
+
+  test "password reset sends link, replaces old links, updates password, and revokes existing sessions" do
+    register_and_verify_account!
+    existing_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    assert_emails 1 do
+      post "/api/v1/password_resets",
+        params: { password_reset: { email: "jo@acme.test" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+    end
+    assert_response :ok
+
+    first_reset_mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "support@example.test" ], first_reset_mail.from
+    first_reset_token = extract_token_from_mail(first_reset_mail, expected_path: "/reset-password", expected_account: "acme")
+
+    # Requesting another reset link replaces the old one
+    assert_emails 1 do
+      post "/api/v1/password_resets",
+        params: { password_reset: { email: "jo@acme.test" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+    end
+    assert_response :ok
+
+    second_reset_mail = ActionMailer::Base.deliveries.last
+    second_reset_token = extract_token_from_mail(second_reset_mail, expected_path: "/reset-password", expected_account: "acme")
+    assert_not_equal first_reset_token, second_reset_token
+
+    # Old reset token fails
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: first_reset_token, password: "recovered-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Blank password fails without consuming the valid token
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: second_reset_token, password: "" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Valid confirmation resets password and signs out existing sessions
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: second_reset_token, password: "recovered-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+
+    # Token cannot be reused
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: second_reset_token, password: "another-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Previous session is revoked
+    get "/api/v1/me", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{existing_token}"
+    }
+    assert_response :unauthorized
+
+    # Can sign in with recovered password
+    sign_in!(subdomain: "acme", email: "jo@acme.test", password: "recovered-password")
+  end
+end
