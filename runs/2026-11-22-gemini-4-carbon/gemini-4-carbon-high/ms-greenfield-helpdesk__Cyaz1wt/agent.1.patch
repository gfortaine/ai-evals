+    def with_env(overrides)
+      previous = {}
+      overrides.each do |key, value|
+        previous[key] = ENV[key]
+        if value.nil?
+          ENV.delete(key)
+        else
+          ENV[key] = value
+        end
+      end
+      yield
+    ensure
+      previous.each do |key, value|
+        if value.nil?
+          ENV.delete(key)
+        else
+          ENV[key] = value
+        end
+      end
+    end
+
+    def extract_token_from_mail(mail, expected_path:, expected_account:)
+      body = mail.body.decoded
+      pattern = %r{#{Regexp.escape(expected_path)}\?account=#{Regexp.escape(expected_account)}&token=([A-Za-z0-9_-]+)}
+      match = body.match(pattern)
+      assert_not_nil match, "Expected mail body #{body.inspect} to match #{pattern.inspect}"
+      match[1]
+    end
