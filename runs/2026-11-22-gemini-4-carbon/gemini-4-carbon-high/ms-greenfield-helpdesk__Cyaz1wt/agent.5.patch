diff --git a/test/integration/email_support_and_replies_test.rb b/test/integration/email_support_and_replies_test.rb
new file mode 100644
index 0000000..3b9f09a
--- /dev/null
+++ b/test/integration/email_support_and_replies_test.rb
@@ -0,0 +1,799 @@
+require "test_helper"
+require "mail"
+
+class EmailSupportAndRepliesTest < ActionDispatch::IntegrationTest
+  INGRESS_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  INGRESS_PASSWORD = "test-inbound-secret-password"
+
+  private
+
+  def relay_auth_header(username: "actionmailbox", password: INGRESS_PASSWORD)
+    ActionController::HttpAuthentication::Basic.encode_credentials(username, password)
+  end
+
+  def post_inbound_raw(raw_rfc822, password: INGRESS_PASSWORD, username: "actionmailbox", content_type: "message/rfc822", env: {})
+    merged_env = { "RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD }.merge(env)
+    headers = { "CONTENT_TYPE" => content_type }
+    if password
+      headers["HTTP_AUTHORIZATION"] = relay_auth_header(username: username, password: password)
+    end
+
+    with_env(merged_env) do
+      post INGRESS_PATH, params: raw_rfc822, headers: headers
+    end
+  end
+
+  def build_raw_mail(from:, to:, subject: "Need help", body: "Hello support!", cc: nil, message_id: nil, headers: {}, &block)
+    mail = Mail.new do |m|
+      m.from = from if from
+      m.to = to if to
+      m.cc = cc if cc
+      m.subject = subject unless subject.nil?
+      m.message_id = message_id if message_id
+      headers.each { |k, v| m[k] = v }
+
+      if block
+        block.call(m)
+      elsif !body.nil?
+        m.content_type = "text/plain; charset=UTF-8"
+        m.body = body
+      end
+    end
+    mail.to_s
+  end
+
+  public
+
+  test "relay ingress requires basic auth with RAILS_INBOUND_EMAIL_PASSWORD and message/rfc822 content type" do
+    register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    raw = build_raw_mail(
+      from: "Alice <alice@customer.test>",
+      to: "acme@support.example.test",
+      subject: "Auth check",
+      body: "Testing auth",
+      message_id: "<auth-check-1@customer.test>"
+    )
+
+    # Missing auth -> 401
+    post_inbound_raw(raw, password: nil)
+    assert_response :unauthorized
+    assert_equal 0, Ticket.count
+
+    # Wrong password -> 401
+    post_inbound_raw(raw, password: "wrong-password")
+    assert_response :unauthorized
+    assert_equal 0, Ticket.count
+
+    # Wrong username -> 401
+    post_inbound_raw(raw, username: "wronguser", password: INGRESS_PASSWORD)
+    assert_response :unauthorized
+    assert_equal 0, Ticket.count
+
+    # Wrong Content-Type -> 415
+    post_inbound_raw(raw, content_type: "text/plain")
+    assert_response :unsupported_media_type
+    assert_equal 0, Ticket.count
+
+    # Valid auth and Content-Type -> 204 and processed synchronously before request completes
+    # (note: earlier failed HTTP attempts with same Message-ID did not block this valid retry)
+    post_inbound_raw(raw)
+    assert_response :no_content
+    assert_equal 1, Ticket.count
+    assert_equal "Auth check", Ticket.last.subject
+  end
+
+  test "incoming mail opens ticket with subject and plain-text message, creates unverified customer, and sends verification email" do
+    acme, _admin = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    admin_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    ActionMailer::Base.deliveries.clear
+
+    raw = build_raw_mail(
+      from: "Alice Example <alice@customer.test>",
+      to: "acme@support.example.test",
+      subject: "Order #42 damaged",
+      message_id: "<order-42@customer.test>"
+    ) do |m|
+      m.text_part = Mail::Part.new do
+        content_type "text/plain; charset=UTF-8"
+        body "Hi team,\r\nThe box arrived crushed."
+      end
+      m.html_part = Mail::Part.new do
+        content_type "text/html; charset=UTF-8"
+        body "<p>Hi team,<br><strong>HTML version</strong></p>"
+      end
+    end
+
+    post_inbound_raw(raw)
+    assert_response :no_content
+
+    customer = acme.users.find_by(email: "alice@customer.test")
+    assert_not_nil customer
+    assert_equal "Alice Example", customer.name
+    assert_equal "customer", customer.role
+    assert_not customer.verified?, "Receiving email must not verify customer account"
+
+    # Verification email was sent so they can later use the portal
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    verification_mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "alice@customer.test" ], verification_mail.to
+    verification_token = extract_token_from_mail(verification_mail, expected_path: "/verify-email", expected_account: "acme")
+
+    # Ticket and initial comment visible to staff immediately
+    get "/api/v1/tickets", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{admin_token}"
+    }
+    assert_response :ok
+    tickets_json = JSON.parse(response.body).fetch("tickets")
+    assert_equal 1, tickets_json.size
+    ticket_id = tickets_json.first.fetch("id")
+    assert_equal "Order #42 damaged", tickets_json.first.fetch("subject")
+    assert_equal "open", tickets_json.first.fetch("status")
+    assert_equal customer.id, tickets_json.first.fetch("requester_id")
+
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{admin_token}"
+    }
+    assert_response :ok
+    comments_json = JSON.parse(response.body).fetch("comments")
+    assert_equal 1, comments_json.size
+    assert_equal "Hi team,\nThe box arrived crushed.", comments_json.first.fetch("body")
+    assert_equal true, comments_json.first.fetch("public")
+    assert_equal customer.id, comments_json.first.dig("author", "id")
+
+    # Another email from the same unverified customer reuses customer, keeps them unverified, and preserves their token
+    ActionMailer::Base.deliveries.clear
+    second_raw = build_raw_mail(
+      from: "alice@customer.test",
+      to: "acme@support.example.test",
+      subject: "Second question",
+      body: "Another detail",
+      message_id: "<second-q@customer.test>"
+    )
+    post_inbound_raw(second_raw)
+    assert_response :no_content
+    assert_equal 2, acme.tickets.count
+    assert_equal 1, acme.users.where(role: "customer").count
+    assert_not customer.reload.verified?
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    # Customer can later verify their email using the original verification email, set password, and use the portal
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: verification_token } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    assert customer.reload.verified?
+
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "alice@customer.test" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+    reset_token = extract_token_from_mail(
+      ActionMailer::Base.deliveries.last,
+      expected_path: "/reset-password",
+      expected_account: "acme"
+    )
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token, password: "new-portal-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+
+    portal_login = sign_in!(subdomain: "acme", email: "alice@customer.test", password: "new-portal-password")
+    customer_token = portal_login.dig("session", "token")
+
+    get "/api/v1/requests", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{customer_token}"
+    }
+    assert_response :ok
+    assert_equal 2, JSON.parse(response.body).fetch("count")
+  end
+
+  test "reuses existing verified customer without sending verification email and supports custom HELPDESK_SUPPORT_DOMAIN" do
+    acme, _admin = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    existing_customer = User.create!(
+      account: acme,
+      name: "Bob Existing",
+      email: "bob@customer.test",
+      password: "bob-password-123",
+      role: "customer",
+      verified_at: Time.current
+    )
+    ActionMailer::Base.deliveries.clear
+
+    # Default domain ignored when HELPDESK_SUPPORT_DOMAIN is customized
+    wrong_domain_raw = build_raw_mail(
+      from: "bob@customer.test",
+      to: "acme@support.example.test",
+      subject: "Wrong domain",
+      body: "Should not match",
+      message_id: "<wrong-domain@customer.test>"
+    )
+    post_inbound_raw(wrong_domain_raw, env: { "HELPDESK_SUPPORT_DOMAIN" => "mail.helpdesk.custom" })
+    assert_response :no_content
+    assert_equal 0, acme.tickets.count
+
+    # Custom domain matches
+    right_domain_raw = build_raw_mail(
+      from: "BOB@CUSTOMER.TEST",
+      to: "acme@mail.helpdesk.custom",
+      subject: "Custom domain support",
+      body: "Works with custom domain!",
+      message_id: "<right-domain@customer.test>"
+    )
+    post_inbound_raw(right_domain_raw, env: { "HELPDESK_SUPPORT_DOMAIN" => "mail.helpdesk.custom" })
+    assert_response :no_content
+
+    assert_equal 1, acme.tickets.count
+    ticket = acme.tickets.last
+    assert_equal existing_customer.id, ticket.requester_id
+    assert existing_customer.reload.verified?
+    assert_equal 0, ActionMailer::Base.deliveries.size
+  end
+
+  test "finds business from To or Cc and ignores mail addressed to multiple businesses" do
+    acme, _ = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    globex, _ = register_and_verify_account!(account_name: "Globex", subdomain: "globex", email: "boss@globex.test")
+    ActionMailer::Base.deliveries.clear
+
+    # Business in Cc with external address in To
+    cc_raw = build_raw_mail(
+      from: "carol@customer.test",
+      to: "partner@external.example",
+      cc: "team@external.example, Acme Help <acme@support.example.test>",
+      subject: "Looping in Acme support",
+      body: "Can Acme help with this?",
+      message_id: "<cc-acme@customer.test>"
+    )
