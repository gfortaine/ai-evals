+    assert_equal 1, ActionMailer::Base.deliveries.size
+
+    ActionMailer::Base.deliveries.clear
+
+    # 2. Invalid delivery (blank body) must NOT block a later valid retry with the SAME Message-ID
+    invalid_blank_body = build_raw_mail(
+      from: "grace@customer.test",
