+  private
+
+  def post_inbound_raw(raw_rfc822, password: INGRESS_PASSWORD)
+    headers = {
+      "CONTENT_TYPE" => "message/rfc822",
+      "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials("actionmailbox", password)
+    }
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD) do
+      post INGRESS_PATH, params: raw_rfc822, headers: headers
+    end
+  end
