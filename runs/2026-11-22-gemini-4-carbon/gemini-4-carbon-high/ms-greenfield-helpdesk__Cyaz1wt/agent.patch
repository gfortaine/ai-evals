@@ -0,0 +1,33 @@
+class TicketMailer < ApplicationMailer
+  def staff_reply(comment)
+    @comment = comment
+    @ticket = comment.ticket
+    @account = comment.account
+    @requester = @ticket.requester
+
+    reply_address = @ticket.reply_email_address
+    subject = @ticket.subject.match?(/\ARe:/i) ? @ticket.subject : "Re: #{@ticket.subject}"
+
+    thread_ids = @ticket.inbound_email_receipts
+      .where(has_message_id_header: true)
+      .order(:id)
+      .pluck(:message_id)
+      .select { |mid| mid.match?(/\A[^\s<>]+\z/) }
+
+    mail_headers = {
+      from: email_address_with_name(reply_address, @account.name),
+      reply_to: reply_address,
+      to: @requester.email,
+      subject: subject,
+      content_type: "text/plain",
+      body: @comment.body
+    }
+
+    if thread_ids.any?
+      mail_headers[:in_reply_to] = "<#{thread_ids.last}>"
+      mail_headers[:references] = thread_ids.map { |mid| "<#{mid}>" }.join(" ")
+    end
+
+    mail(mail_headers)
+  end
+end
diff --git a/app/mailers/user_mailer.rb b/app/mailers/user_mailer.rb
new file mode 100644
index 0000000..009ce5e
--- /dev/null
+++ b/app/mailers/user_mailer.rb
@@ -0,0 +1,66 @@
+require "cgi"
+
+class UserMailer < ApplicationMailer
+  def email_verification(user, token)
+    @user = user
+    @account = user.account
+    @verification_url = "#{frontend_base_url}/verify-email?account=#{CGI.escape(@account.subdomain)}&token=#{CGI.escape(token)}"
+
+    mail(
+      to: @user.email,
+      subject: "Verify your email for #{@account.name}",
+      content_type: "text/plain",
+      body: <<~TEXT
+        Hi #{@user.name},
+
+        Please verify your email address for #{@account.name} by visiting the link below:
+
+        #{@verification_url}
+      TEXT
+    )
+  end
+
+  def password_reset(user, token)
+    @user = user
+    @account = user.account
+    @reset_url = "#{frontend_base_url}/reset-password?account=#{CGI.escape(@account.subdomain)}&token=#{CGI.escape(token)}"
+
+    mail(
+      to: @user.email,
+      subject: "Reset your password for #{@account.name}",
+      content_type: "text/plain",
+      body: <<~TEXT
+        Hi #{@user.name},
+
+        Reset your password for #{@account.name} by visiting the link below:
+
+        #{@reset_url}
+      TEXT
+    )
+  end
+
+  def invitation(invitation, token)
+    @invitation = invitation
+    @account = invitation.account
+    @accept_url = "#{frontend_base_url}/accept-invitation?account=#{CGI.escape(@account.subdomain)}&token=#{CGI.escape(token)}"
+
+    mail(
+      to: @invitation.email,
+      subject: "Invitation to join #{@account.name}",
+      content_type: "text/plain",
+      body: <<~TEXT
+        Hi,
+
+        You have been invited to join #{@account.name} as #{@invitation.role}. Accept your invitation by visiting the link below:
+
+        #{@accept_url}
+      TEXT
+    )
+  end
+
+  private
+
+  def frontend_base_url
+    (ENV["HELPDESK_FRONTEND_URL"].presence || "http://localhost:3001").strip.chomp("/")
+  end
+end
diff --git a/app/models/account.rb b/app/models/account.rb
new file mode 100644
index 0000000..7b229ef
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,83 @@
+class Account < ApplicationRecord
+  CANCELLATION_WINDOW = 90.days
+
+  belongs_to :owner, class_name: "User", optional: true
+  has_many :inbound_email_receipts, dependent: :destroy
+  has_many :comments, dependent: :destroy
+  has_many :tickets, dependent: :destroy
+  has_many :group_memberships, dependent: :destroy
+  has_many :groups, dependent: :destroy
+  has_many :invitations, dependent: :destroy
+  has_many :users, dependent: :destroy
+  has_many :sessions, dependent: :destroy
+
+  normalizes :name, with: ->(value) { value.to_s.strip }
+  normalizes :subdomain, with: ->(value) { value.to_s.strip.downcase }
+
+  validates :name, presence: true
+  validates :subdomain,
+    presence: true,
+    uniqueness: { case_sensitive: false },
+    format: { with: /\A[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\z/ }
+
+  scope :purgeable, -> { where.not(cancelled_at: nil).where("cancelled_at <= ?", CANCELLATION_WINDOW.ago) }
+
+  def support_email_address
+    "#{subdomain}@#{SupportEmail.domain}"
+  end
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  def reactivable?
+    cancelled? && cancelled_at > CANCELLATION_WINDOW.ago
+  end
+
+  def owner?(user)
+    user.present? && owner_id.present? && owner_id == user.id
+  end
+
+  def cancel!
+    transaction do
+      update!(cancelled_at: Time.current)
+      sessions.delete_all
+    end
+  end
+
+  def reactivate!
+    update!(cancelled_at: nil)
+  end
+
+  def self.purge_cancelled!
+    purged_count = 0
+    purgeable.find_each do |account|
+      transaction do
+        account.update_column(:owner_id, nil) if account.owner_id.present?
+        account.destroy!
+        purged_count += 1
+      end
+    end
+    purged_count
+  end
+
+  def as_portal_json
+    {
+      name: name,
+      subdomain: subdomain
+    }
+  end
+
+  def as_api_json
+    {
+      id: id,
+      name: name,
+      subdomain: subdomain,
+      owner_id: owner_id,
+      cancelled: cancelled?,
+      cancelled_at: cancelled_at,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+end
