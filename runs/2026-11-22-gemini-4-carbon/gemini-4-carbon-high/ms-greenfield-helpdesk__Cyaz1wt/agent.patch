+  def register_and_verify_customer!(subdomain:, name:, email:, password: "my-customer-password")
+    post "/api/v1/registrations",
+      params: { user: { name: name, email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+
+    token = extract_token_from_mail(
+      ActionMailer::Base.deliveries.last,
+      expected_path: "/verify-email",
+      expected_account: subdomain.downcase
+    )
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+
+    ActionMailer::Base.deliveries.clear
+    account = Account.find_by!(subdomain: subdomain.downcase)
+    User.find_by!(account: account, email: email.strip.downcase)
+  end
+
+  def post_inbound_raw(raw_rfc822)
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD) do
+      post INGRESS_PATH,
+        params: raw_rfc822,
+        headers: {
+          "CONTENT_TYPE" => "message/rfc822",
+          "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials("actionmailbox", INGRESS_PASSWORD)
+        }
+    end
+  end
+
+  def build_raw_mail(from:, to:, subject: "Need help", body: "Hello support!", cc: nil, message_id: nil, headers: {})
+    mail = Mail.new do |m|
+      m.from = from
+      m.to = to
+      m.cc = cc if cc
+      m.subject = subject
+      m.message_id = message_id if message_id
+      headers.each { |k, v| m[k] = v }
+      m.content_type = "text/plain; charset=UTF-8"
+      m.body = body
+    end
+    mail.to_s
+  end
