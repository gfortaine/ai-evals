diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..02d67ad
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,90 @@
+module Api
+  module V1
+    class AccountsController < BaseController
+      before_action :require_account!, only: %i[show cancel reactivate]
+      before_action :authenticate_user!, only: %i[show cancel reactivate]
+      before_action :require_active_account!, only: %i[show]
+      before_action :require_owner!, only: %i[cancel reactivate]
+
+      def create
+        account_params = require_hash_param(:account)
+        admin_raw = account_params[:admin]
+
+        unless admin_raw.is_a?(ActionController::Parameters) || admin_raw.is_a?(Hash)
+          return render json: {
+            error: "Admin parameters are required",
+            errors: { admin: [ "is required" ] }
+          }, status: :unprocessable_entity
+        end
+
+        account = Account.new(
+          name: account_params[:name],
+          subdomain: account_params[:subdomain]
+        )
+        user = User.new(
+          account: account,
+          name: admin_raw[:name],
+          email: admin_raw[:email],
+          password: admin_raw[:password],
+          role: "admin"
+        )
+
+        account_valid = account.valid?
+        user_valid = user.valid?
+
+        unless account_valid && user_valid
+          merged_errors = account.errors.to_hash(true)
+          user.errors.to_hash(true).each do |key, messages|
+            merged_errors[:"admin.#{key}"] = messages
+          end
+          all_messages = account.errors.full_messages + user.errors.full_messages
+          return render json: {
+            error: all_messages.to_sentence,
+            errors: merged_errors
+          }, status: :unprocessable_entity
+        end
+
+        verification_token = nil
+        ActiveRecord::Base.transaction do
+          account.save!
+          user.save!
+          account.update!(owner: user)
+          verification_token = user.generate_email_verification_token!
+        end
+
+        UserMailer.email_verification(user, verification_token).deliver_now
+
+        render json: {
+          account: account.as_api_json,
+          user: user.as_api_json
+        }, status: :created
+      end
+
+      def show
+        render json: { account: current_account.as_api_json }, status: :ok
+      end
+
+      def cancel
+        if current_account.cancelled?
+          return render json: { error: "Account is already cancelled" }, status: :unprocessable_entity
+        end
+
+        current_account.cancel!
+        render json: { account: current_account.as_api_json }, status: :ok
+      end
+
+      def reactivate
+        unless current_account.cancelled?
+          return render json: { error: "Account is not cancelled" }, status: :unprocessable_entity
+        end
+
+        unless current_account.reactivable?
+          return render json: { error: "Account reactivation window has expired" }, status: :unprocessable_entity
+        end
+
+        current_account.reactivate!
+        render json: { account: current_account.as_api_json }, status: :ok
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..ee60dc4
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,213 @@
+module Api
+  module V1
+    class BaseController < ApplicationController
+      include CursorPaginatable
+
+      class InvalidPaginationError < StandardError
+        attr_reader :errors_hash
+
+        def initialize(message, errors_hash)
+          super(message)
+          @errors_hash = errors_hash
+        end
+      end
+
+      DEFAULT_PAGE = 1
+      DEFAULT_PER_PAGE = 25
+
+      rescue_from ActionController::ParameterMissing, with: :render_parameter_missing
+      rescue_from ActiveRecord::RecordInvalid, with: :render_record_invalid
+      rescue_from ActiveRecord::RecordNotUnique, with: :render_record_not_unique
+      rescue_from ActiveRecord::RecordNotFound, with: :render_not_found
+      rescue_from InvalidPaginationError, with: :render_invalid_pagination
+
+      private
+
+      attr_reader :current_account, :current_session, :current_user
+
+      def require_hash_param(key)
+        value = params.require(key)
+        unless value.is_a?(ActionController::Parameters)
+          raise ActionController::ParameterMissing, key
+        end
+        value
+      end
+
+      def require_account!
+        subdomain = request.headers["X-Helpdesk-Account"].to_s.strip.downcase
+        @current_account = subdomain.present? ? Account.find_by(subdomain: subdomain) : nil
+
+        unless @current_account
+          render json: { error: "Account not found" }, status: :not_found
+        end
+      end
+
+      def authenticate_user!
+        raw_token = extract_bearer_token
+        @current_session = Session.authenticate_for_account(current_account, raw_token)
+        @current_user = @current_session&.user
+
+        if @current_user.nil? || @current_user.suspended?
+          @current_session = nil
+          @current_user = nil
+          render json: { error: "Unauthorized" }, status: :unauthorized
+        end
+      end
+
+      def require_active_account!
+        if current_account&.cancelled?
+          render json: { error: "Account is cancelled" }, status: :forbidden
+        end
+      end
+
+      def require_owner!
+        unless current_account&.owner?(current_user)
+          render json: { error: "Forbidden" }, status: :forbidden
+        end
+      end
+
+      def require_admin!
+        unless current_user&.admin?
+          render json: { error: "Forbidden" }, status: :forbidden
+        end
+      end
+
+      def require_customer!
+        unless current_user&.customer?
+          render json: { error: "Forbidden" }, status: :forbidden
+        end
+      end
+
+      def require_staff!
+        unless current_user&.staff?
+          render json: { error: "Forbidden" }, status: :forbidden
+        end
+      end
+
+      def blank_filter_param?(raw)
+        raw.nil? || ((raw.is_a?(String) || raw.is_a?(Symbol)) && raw.to_s.strip.empty?)
+      end
+
+      def extract_scalar_string(raw)
+        return nil if raw.is_a?(Array) || raw.is_a?(Hash) || raw.is_a?(ActionController::Parameters)
+
+        raw.to_s.strip
+      end
+
+      def render_paginated(
+        collection_key,
+        scope,
+        cursor_scope: collection_key,
+        sort_column: nil,
+        direction: :asc,
+        cursor_context: {},
+        &block
+      )
+        if cursor_pagination_requested?
+          return render_cursor_paginated(
+            collection_key,
+            scope,
+            cursor_scope: cursor_scope,
+            sort_column: sort_column,
+            direction: direction,
+            cursor_context: cursor_context,
+            &block
+          )
+        end
+
+        page = parse_positive_integer_param(:page, default: DEFAULT_PAGE)
+        per_page = parse_positive_integer_param(:per_page, default: DEFAULT_PER_PAGE)
+
+        if per_page > MAX_PAGINATION_BIGINT || (page - 1) * per_page > MAX_PAGINATION_BIGINT
+          raise InvalidPaginationError.new(
+            "Pagination value is too large",
+            { page: [ "is too large" ] }
+          )
+        end
+
+        total_count = scope.count
+        total_pages = total_count.zero? ? 0 : (total_count.to_f / per_page).ceil
+        records = scope.offset((page - 1) * per_page).limit(per_page)
+
+        next_page = page < total_pages ? page + 1 : nil
+        previous_page = if page > 1 && total_pages > 0
+          [ page - 1, total_pages ].min
+        else
+          nil
+        end
+
+        render json: {
+          collection_key => yield(records),
+          count: total_count,
+          page: page,
+          per_page: per_page,
+          next_page: next_page,
+          previous_page: previous_page
+        }, status: :ok
+      end
+
+      def parse_positive_integer_param(name, default:)
+        raw = params[name]
+        if raw.is_a?(Array) || raw.is_a?(Hash) || raw.is_a?(ActionController::Parameters) || raw == true || raw == false
+          raise InvalidPaginationError.new(
+            "#{name.to_s.humanize} must be a positive integer",
+            { name => [ "must be a positive integer" ] }
+          )
+        end
+
+        return default if raw.nil? || raw.to_s.strip.empty?
+
+        str = raw.to_s.strip
+        unless str.match?(/\A\d+\z/)
+          raise InvalidPaginationError.new(
+            "#{name.to_s.humanize} must be a positive integer",
+            { name => [ "must be a positive integer" ] }
+          )
+        end
+
+        value = str.to_i
+        if value < 1
+          raise InvalidPaginationError.new(
+            "#{name.to_s.humanize} must be greater than 0",
+            { name => [ "must be greater than 0" ] }
+          )
+        end
+
+        value
+      end
+
+      def extract_bearer_token
+        header = request.headers["Authorization"].to_s
+        match = header.match(/\ABearer\s+(\S+)\z/i)
+        match ? match[1] : nil
+      end
+
+      def render_parameter_missing(exception)
+        render json: { error: exception.message }, status: :unprocessable_entity
+      end
+
+      def render_record_invalid(exception)
+        record = exception.record
+        render json: {
+          error: record.errors.full_messages.to_sentence,
+          errors: record.errors.to_hash(true)
+        }, status: :unprocessable_entity
+      end
+
+      def render_record_not_unique(_exception)
+        render json: { error: "Record already exists" }, status: :unprocessable_entity
+      end
+
+      def render_not_found(_exception)
+        render json: { error: "Not found" }, status: :not_found
+      end
+
+      def render_invalid_pagination(exception)
+        render json: {
+          error: exception.message,
+          errors: exception.errors_hash
+        }, status: :unprocessable_entity
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
