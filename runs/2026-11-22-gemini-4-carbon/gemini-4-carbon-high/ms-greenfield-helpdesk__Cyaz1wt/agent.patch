+  test "tie-breaks identical timestamps and preserves microsecond timestamp precision" do
+    acme, owner = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    customer = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    owner_headers = auth_headers("acme", owner_token)
+
+    exact_ts = Time.utc(2026, 11, 21, 12, 0, 0, 500_000)
+    same_ts_ids = []
+    5.times do |i|
+      t = Ticket.create!(
+        account: acme,
+        requester: customer,
+        subject: "Batch #{i}",
+        status: "open",
+        created_at: exact_ts,
+        updated_at: exact_ts,
+        customer_updated_at: exact_ts
+      )
+      same_ts_ids << t.id
+    end
+
+    # Also add 2 tickets separated by 1 single microsecond each
+    t_plus_1us = Ticket.create!(
+      account: acme,
+      requester: customer,
+      subject: "Plus 1us",
+      status: "open",
+      created_at: Time.utc(2026, 11, 21, 12, 0, 0, 500_001),
+      updated_at: Time.utc(2026, 11, 21, 12, 0, 0, 500_001),
+      customer_updated_at: Time.utc(2026, 11, 21, 12, 0, 0, 500_001)
+    )
+    t_plus_2us = Ticket.create!(
+      account: acme,
+      requester: customer,
+      subject: "Plus 2us",
+      status: "open",
+      created_at: Time.utc(2026, 11, 21, 12, 0, 0, 500_002),
+      updated_at: Time.utc(2026, 11, 21, 12, 0, 0, 500_002),
+      customer_updated_at: Time.utc(2026, 11, 21, 12, 0, 0, 500_002)
+    )
+
+    expected_order = [ t_plus_2us.id, t_plus_1us.id ] + same_ts_ids.reverse
+
+    # Walk forward 2 at a time
+    collected_forward = []
+    next_url = "/api/v1/tickets?page[size]=2"
+    while next_url
+      get next_url, headers: owner_headers
+      assert_response :ok
+      body = JSON.parse(response.body)
+      collected_forward.concat(body.fetch("tickets").map { |t| t.fetch("id") })
+      next_url = body.dig("links", "next")
+      last_body = body
+    end
+    assert_equal expected_order, collected_forward
+
+    # Walk backward from last page's before_cursor
+    collected_backward_pages = [ last_body.fetch("tickets").map { |t| t.fetch("id") } ]
+    prev_url = last_body.dig("links", "prev")
+    while prev_url
+      get prev_url, headers: owner_headers
+      assert_response :ok
+      body = JSON.parse(response.body)
+      collected_backward_pages.unshift(body.fetch("tickets").map { |t| t.fetch("id") })
+      prev_url = body.dig("links", "prev")
+    end
+    assert_equal expected_order, collected_backward_pages.flatten
+  end
