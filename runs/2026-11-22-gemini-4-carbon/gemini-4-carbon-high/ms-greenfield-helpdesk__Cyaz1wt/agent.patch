@@ -0,0 +1,197 @@
+require "test_helper"
+
+class BusinessSignupAndPortalTest < ActionDispatch::IntegrationTest
+  test "registers business, returns account and unverified admin user, and sends verification email" do
+    assert_difference -> { Account.count }, 1 do
+      assert_difference -> { User.count }, 1 do
+        assert_emails 1 do
+          post "/api/v1/account/create",
+            params: {
+              account: {
+                name: "Acme",
+                subdomain: "acme",
+                admin: {
+                  name: "Jo",
+                  email: "jo@acme.test",
+                  password: "my-first-password"
+                }
+              }
+            },
+            as: :json
+        end
+      end
+    end
+
+    assert_response :created
+    body = JSON.parse(response.body)
+
+    account = body.fetch("account")
+    assert_kind_of Integer, account.fetch("id")
+    assert_equal "Acme", account.fetch("name")
+    assert_equal "acme", account.fetch("subdomain")
+    assert_not_nil Time.iso8601(account.fetch("created_at"))
+    assert_not_nil Time.iso8601(account.fetch("updated_at"))
+
+    user = body.fetch("user")
+    assert_kind_of Integer, user.fetch("id")
+    assert_equal "Jo", user.fetch("name")
+    assert_equal "jo@acme.test", user.fetch("email")
+    assert_equal "admin", user.fetch("role")
+    assert_equal false, user.fetch("verified")
+    assert_not_nil Time.iso8601(user.fetch("created_at"))
+    assert_not_nil Time.iso8601(user.fetch("updated_at"))
+    assert_nil user["password_digest"]
+    assert_nil user["email_verification_token_digest"]
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "support@example.test" ], mail.from
+    assert_equal [ "jo@acme.test" ], mail.to
+    assert_includes mail.body.decoded, "http://localhost:3001/verify-email?account=acme&token="
+  end
+
+  test "respects HELPDESK_FRONTEND_URL and HELPDESK_MAIL_FROM when sending verification email" do
+    with_env(
+      "HELPDESK_FRONTEND_URL" => "https://desk.example.test/",
+      "HELPDESK_MAIL_FROM" => "no-reply@desk.example.test"
+    ) do
+      post "/api/v1/account/create",
+        params: {
+          account: {
+            name: "Acme",
+            subdomain: "acme",
+            admin: {
+              name: "Jo",
+              email: "jo@acme.test",
+              password: "my-first-password"
+            }
+          }
+        },
+        as: :json
+      assert_response :created
+
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "no-reply@desk.example.test" ], mail.from
+      assert_includes mail.body.decoded, "https://desk.example.test/verify-email?account=acme&token="
+      refute_includes mail.body.decoded, "https://desk.example.test//verify-email"
+    end
+  end
+
+  test "allows the same email to belong to different businesses" do
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Acme",
+          subdomain: "acme",
+          admin: { name: "Jo Acme", email: "jo@shared.test", password: "acme-password" }
+        }
+      },
+      as: :json
+    assert_response :created
+
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Globex",
+          subdomain: "globex",
+          admin: { name: "Jo Globex", email: "jo@shared.test", password: "globex-password" }
+        }
+      },
+      as: :json
+    assert_response :created
+
+    assert_equal 2, Account.count
+    assert_equal 2, User.where(email: "jo@shared.test").count
+  end
+
+  test "rolls back signup atomically when subdomain is duplicate or admin params are invalid" do
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Acme",
+          subdomain: "acme",
+          admin: { name: "Jo", email: "jo@acme.test", password: "my-first-password" }
+        }
+      },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+
+    # Duplicate subdomain (case-insensitive)
+    assert_no_difference -> { Account.count + User.count } do
+      post "/api/v1/account/create",
+        params: {
+          account: {
+            name: "Acme Two",
+            subdomain: "ACME",
+            admin: { name: "Sam", email: "sam@acme.test", password: "my-first-password" }
+          }
+        },
+        as: :json
+      assert_response :unprocessable_entity
+    end
+    assert_empty ActionMailer::Base.deliveries
+
+    # Valid new account but invalid admin email/password
+    assert_no_difference -> { Account.count + User.count } do
+      post "/api/v1/account/create",
+        params: {
+          account: {
+            name: "Beta",
+            subdomain: "beta",
+            admin: { name: "Sam", email: "not-an-email", password: "" }
+          }
+        },
+        as: :json
+      assert_response :unprocessable_entity
+    end
+    assert_empty ActionMailer::Base.deliveries
+
+    # Missing admin payload
+    assert_no_difference -> { Account.count + User.count } do
+      post "/api/v1/account/create",
+        params: { account: { name: "Gamma", subdomain: "gamma" } },
+        as: :json
+      assert_response :unprocessable_entity
+    end
+
+    # Non-hash account payload
+    post "/api/v1/account/create", params: { account: "invalid" }, as: :json
+    assert_response :unprocessable_entity
+  end
+
+  test "GET /portal returns public portal info and GET /account returns full account to signed-in users" do
+    register_and_verify_account!
+
+    # Public portal without authentication
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :ok
+    portal_body = JSON.parse(response.body)
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, portal_body)
+
+    # Missing or unknown X-Helpdesk-Account header
+    get "/api/v1/portal"
+    assert_response :not_found
+
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "unknown" }
+    assert_response :not_found
+
+    # GET /account requires authentication
+    get "/api/v1/account", headers: { "X-Helpdesk-Account" => "acme" }
+    assert_response :unauthorized
+
+    login = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token = login.dig("session", "token")
+
+    get "/api/v1/account", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{token}"
+    }
+    assert_response :ok
+    account_body = JSON.parse(response.body).fetch("account")
+    assert_equal "Acme", account_body.fetch("name")
+    assert_equal "acme", account_body.fetch("subdomain")
+    assert_kind_of Integer, account_body.fetch("id")
+    assert_not_nil account_body.fetch("created_at")
+    assert_not_nil account_body.fetch("updated_at")
+  end
+end
