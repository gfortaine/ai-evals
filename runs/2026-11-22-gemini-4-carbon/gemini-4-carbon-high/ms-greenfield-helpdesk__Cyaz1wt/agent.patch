+require "base64"
+require "json"
+require "openssl"
+
+module CursorPaginatable
+  extend ActiveSupport::Concern
+
+  MAX_PAGINATION_BIGINT = 9_223_372_036_854_775_807
+  CURSOR_VERSION = 1
+  CURSOR_MAC_BYTES = 16
+  ALLOWED_CURSOR_PAGE_KEYS = %w[size after before].freeze
+
+  private
+
+  def cursor_pagination_requested?
+    params[:page].is_a?(ActionController::Parameters) || params[:page].is_a?(Hash)
+  end
+
+  def render_cursor_paginated(
+    collection_key,
+    scope,
+    cursor_scope:,
+    sort_column: nil,
+    direction: :asc,
+    cursor_context: {}
+  )
+    normalized_context = normalize_cursor_context(cursor_context)
+    parsed = parse_cursor_pagination_params(
+      cursor_scope: cursor_scope.to_s,
+      sort_column: sort_column,
+      cursor_context: normalized_context
+    )
+
+    size = parsed[:size]
+    mode = parsed[:mode]
+    cursor = parsed[:cursor]
+
+    arel_table = scope.klass.arel_table
+    reverse_direction = direction == :asc ? :desc : :asc
+
+    forward_order = build_cursor_order(arel_table, sort_column, direction)
+    backward_order = build_cursor_order(arel_table, sort_column, reverse_direction)
+
+    case mode
+    when :initial
+      fetched = scope.reorder(*forward_order).limit(size + 1).to_a
+      has_next = fetched.length > size
+      records = fetched.first(size)
+      has_prev = false
+      has_more = has_next
+    when :after
+      predicate = build_cursor_predicate(scope.klass, sort_column, direction, :after, cursor)
+      fetched = scope.where(*predicate).reorder(*forward_order).limit(size + 1).to_a
+      has_next = fetched.length > size
+      records = fetched.first(size)
+      has_prev = if records.any?
+        first_values = extract_cursor_values(records.first, sort_column)
+        prev_predicate = build_cursor_predicate(scope.klass, sort_column, direction, :before, first_values)
+        cursor_neighbor_exists?(scope, prev_predicate, backward_order)
+      else
+        false
+      end
+      has_more = has_next
+    when :before
+      predicate = build_cursor_predicate(scope.klass, sort_column, direction, :before, cursor)
+      fetched = scope.where(*predicate).reorder(*backward_order).limit(size + 1).to_a
+      has_prev = fetched.length > size
+      records = fetched.first(size).reverse
+      has_next = if records.any?
+        last_values = extract_cursor_values(records.last, sort_column)
+        next_predicate = build_cursor_predicate(scope.klass, sort_column, direction, :after, last_values)
+        cursor_neighbor_exists?(scope, next_predicate, forward_order)
+      else
+        false
+      end
+      has_more = has_prev
+    end
+
+    if records.any?
+      before_cursor = encode_cursor(
+        records.first,
+        cursor_scope: cursor_scope.to_s,
+        sort_column: sort_column,
+        cursor_context: normalized_context
+      )
+      after_cursor = encode_cursor(
+        records.last,
+        cursor_scope: cursor_scope.to_s,
+        sort_column: sort_column,
+        cursor_context: normalized_context
+      )
+    else
+      before_cursor = nil
+      after_cursor = nil
+    end
+
+    next_link = has_next && after_cursor ? build_cursor_link(size: size, after: after_cursor) : nil
+    prev_link = has_prev && before_cursor ? build_cursor_link(size: size, before: before_cursor) : nil
+
+    render json: {
+      collection_key => yield(records),
+      meta: {
+        has_more: has_more,
+        after_cursor: after_cursor,
+        before_cursor: before_cursor
+      },
+      links: {
+        next: next_link,
+        prev: prev_link
+      }
+    }, status: :ok
+  end
+
+  def parse_cursor_pagination_params(cursor_scope:, sort_column:, cursor_context:)
+    raw_page = params[:page]
+    raw_hash = raw_page.is_a?(ActionController::Parameters) ? raw_page.to_unsafe_h : raw_page
+
+    string_hash = {}
+    raw_hash.each do |k, v|
+      string_hash[k.to_s] = v
+    end
+
+    unknown_keys = string_hash.keys - ALLOWED_CURSOR_PAGE_KEYS
+    if unknown_keys.any?
+      bad_key = unknown_keys.first
+      raise self.class::InvalidPaginationError.new(
+        "Unsupported page parameter: #{bad_key}",
+        { :"page.#{bad_key}" => [ "is not supported" ] }
+      )
+    end
+
+    compacted = string_hash.reject { |_k, v| v.nil? }
+    if compacted.empty?
+      raise self.class::InvalidPaginationError.new(
+        "Page parameters are invalid",
+        { page: [ "is invalid" ] }
+      )
+    end
+
+    fallback_per_page = if params.key?(:per_page)
+      val = parse_positive_integer_param(:per_page, default: self.class::DEFAULT_PER_PAGE)
+      if val >= MAX_PAGINATION_BIGINT
+        raise self.class::InvalidPaginationError.new(
+          "Per page is too large",
+          { per_page: [ "is too large" ] }
+        )
+      end
+      val
+    else
+      self.class::DEFAULT_PER_PAGE
+    end
+
+    size = if compacted.key?("size")
+      parse_strict_cursor_size!(compacted["size"])
+    else
+      fallback_per_page
+    end
+
+    has_after = compacted.key?("after")
+    has_before = compacted.key?("before")
+
+    if has_after && has_before
+      raise self.class::InvalidPaginationError.new(
+        "Cannot specify both page[after] and page[before]",
+        { page: [ "cannot specify both after and before" ] }
+      )
+    end
+
+    if has_after
+      cursor = decode_cursor!(
+        compacted["after"],
+        param_key: :"page.after",
+        cursor_scope: cursor_scope,
+        sort_column: sort_column,
+        cursor_context: cursor_context
+      )
+      { size: size, mode: :after, cursor: cursor }
+    elsif has_before
+      cursor = decode_cursor!(
+        compacted["before"],
+        param_key: :"page.before",
+        cursor_scope: cursor_scope,
+        sort_column: sort_column,
+        cursor_context: cursor_context
+      )
+      { size: size, mode: :before, cursor: cursor }
+    else
+      { size: size, mode: :initial, cursor: nil }
+    end
+  end
+
+  def parse_strict_cursor_size!(raw_size)
+    if raw_size.is_a?(Array) || raw_size.is_a?(Hash) || raw_size.is_a?(ActionController::Parameters) || raw_size == true || raw_size == false
+      raise self.class::InvalidPaginationError.new(
+        "Page size must be a positive integer",
+        { :"page.size" => [ "must be a positive integer" ] }
+      )
+    end
+
+    str = raw_size.to_s.strip
+    unless str.match?(/\A\d+\z/)
+      raise self.class::InvalidPaginationError.new(
+        "Page size must be a positive integer",
+        { :"page.size" => [ "must be a positive integer" ] }
+      )
+    end
+
+    value = str.to_i
+    if value < 1
+      raise self.class::InvalidPaginationError.new(
+        "Page size must be greater than 0",
+        { :"page.size" => [ "must be greater than 0" ] }
+      )
+    end
+
+    if value >= MAX_PAGINATION_BIGINT
+      raise self.class::InvalidPaginationError.new(
+        "Page size is too large",
+        { :"page.size" => [ "is too large" ] }
+      )
+    end
+
+    value
+  end
+
+  def build_cursor_order(arel_table, sort_column, dir)
+    if sort_column
+      [ arel_table[sort_column].public_send(dir), arel_table[:id].public_send(dir) ]
+    else
+      [ arel_table[:id].public_send(dir) ]
+    end
+  end
+
+  def build_cursor_predicate(klass, sort_column, direction, browse_dir, cursor_vals)
+    conn = klass.connection
+    quoted_table = klass.quoted_table_name
+    quoted_id = "#{quoted_table}.#{conn.quote_column_name(:id)}"
+
+    operator = if (direction == :asc && browse_dir == :after) || (direction == :desc && browse_dir == :before)
+      ">"
+    else
+      "<"
+    end
+
+    if sort_column
+      quoted_sort = "#{quoted_table}.#{conn.quote_column_name(sort_column)}"
+      [ "(#{quoted_sort}, #{quoted_id}) #{operator} (?, ?)", cursor_vals[:time], cursor_vals[:id] ]
+    else
+      [ "#{quoted_id} #{operator} ?", cursor_vals[:id] ]
+    end
+  end
+
+  def cursor_neighbor_exists?(base_scope, predicate, order_clauses)
+    base_scope
+      .except(:includes, :preload, :eager_load, :select)
+      .where(*predicate)
+      .reorder(*order_clauses)
+      .limit(1)
+      .pluck(Arel.sql("1"))
+      .any?
+  end
+
+  def extract_cursor_values(record, sort_column)
+    if sort_column
+      ts = record.public_send(sort_column).utc
+      { id: record.id, time: Time.at(ts.to_i, ts.usec, :microsecond, in: "UTC") }
+    else
+      { id: record.id, time: nil }
+    end
+  end
+
+  def normalize_cursor_context(cursor_context)
+    result = {}
+    (cursor_context || {}).each do |k, v|
+      result[k.to_s] = v
+    end
+    result
+  end
+
+  def encode_cursor(record, cursor_scope:, sort_column:, cursor_context:)
+    payload = {
+      "v" => CURSOR_VERSION,
+      "s" => cursor_scope,
+      "a" => current_account.id,
+      "i" => record.id
+    }
+
+    if sort_column
+      ts = record.public_send(sort_column).utc
+      payload["t"] = (ts.to_i * 1_000_000) + ts.usec
+    end
+
+    payload["c"] = cursor_context unless cursor_context.empty?
+
+    json = JSON.generate(payload)
+    mac = OpenSSL::HMAC.digest("SHA256", cursor_signing_key, json).byteslice(0, CURSOR_MAC_BYTES)
+    Base64.urlsafe_encode64(mac + json, padding: false)
+  end
+
+  def decode_cursor!(raw_cursor, param_key:, cursor_scope:, sort_column:, cursor_context:)
+    unless raw_cursor.is_a?(String) && raw_cursor.bytesize.between?(1, 1024) && raw_cursor.match?(/\A[A-Za-z0-9_-]+\z/)
+      raise_invalid_cursor!(param_key)
+    end
+
+    decoded = begin
+      Base64.urlsafe_decode64(raw_cursor)
+    rescue ArgumentError
+      raise_invalid_cursor!(param_key)
+    end
+
+    if decoded.bytesize <= CURSOR_MAC_BYTES || Base64.urlsafe_encode64(decoded, padding: false) != raw_cursor
+      raise_invalid_cursor!(param_key)
+    end
+
+    provided_mac = decoded.byteslice(0, CURSOR_MAC_BYTES)
+    json = decoded.byteslice(CURSOR_MAC_BYTES, decoded.bytesize - CURSOR_MAC_BYTES)
+    expected_mac = OpenSSL::HMAC.digest("SHA256", cursor_signing_key, json).byteslice(0, CURSOR_MAC_BYTES)
+
+    unless ActiveSupport::SecurityUtils.secure_compare(provided_mac, expected_mac)
+      raise_invalid_cursor!(param_key)
+    end
+
+    data = begin
+      JSON.parse(json)
+    rescue JSON::ParserError
+      raise_invalid_cursor!(param_key)
+    end
+
+    unless data.is_a?(Hash) &&
+        data["v"] == CURSOR_VERSION &&
+        data["s"] == cursor_scope &&
+        data["a"] == current_account.id &&
+        (data["c"] || {}) == cursor_context
+      raise_invalid_cursor!(param_key)
+    end
+
+    id_val = data["i"]
+    unless id_val.is_a?(Integer) && id_val >= 1 && id_val <= MAX_PAGINATION_BIGINT
+      raise_invalid_cursor!(param_key)
+    end
+
+    if sort_column
+      t_val = data["t"]
+      unless t_val.is_a?(Integer)
+        raise_invalid_cursor!(param_key)
+      end
+
+      sec, usec = t_val.divmod(1_000_000)
+      cursor_time = begin
+        Time.at(sec, usec, :microsecond, in: "UTC")
+      rescue RangeError, ArgumentError
+        raise_invalid_cursor!(param_key)
+      end
+
+      { id: id_val, time: cursor_time }
+    else
+      raise_invalid_cursor!(param_key) if data.key?("t")
+      { id: id_val, time: nil }
+    end
+  end
+
+  def raise_invalid_cursor!(param_key)
+    raise self.class::InvalidPaginationError.new(
+      "Invalid pagination cursor",
+      { param_key => [ "is invalid" ] }
+    )
+  end
+
+  def cursor_signing_key
+    OpenSSL::HMAC.digest("SHA256", Rails.application.secret_key_base.to_s, "helpdesk:cursor:v1")
+  end
+
+  def build_cursor_link(size:, after: nil, before: nil)
+    preserved = request.query_parameters.except("page", "per_page").deep_dup
+    page_params = { "size" => size }
+    page_params["after"] = after if after
+    page_params["before"] = before if before
+    preserved["page"] = page_params
+    "#{request.path}?#{preserved.to_query}"
+  end
+end
