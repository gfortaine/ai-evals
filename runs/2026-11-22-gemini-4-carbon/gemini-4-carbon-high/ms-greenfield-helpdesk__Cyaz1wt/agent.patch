+module Api
+  module V1
+    class SessionsController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!, only: %i[destroy]
+
+      def create
+        session_params = require_hash_param(:session)
+        email = session_params[:email].to_s.strip.downcase
+        password = session_params[:password].to_s
+
+        user = email.present? ? current_account.users.find_by(email: email) : nil
+
+        if user.nil? || password.empty? || !user.authenticate(password)
+          return render json: { error: "Invalid email or password" }, status: :unauthorized
+        end
+
+        if user.suspended?
+          return render json: { error: "User is suspended" }, status: :forbidden
+        end
+
+        unless user.verified?
+          return render json: { error: "Email not verified" }, status: :forbidden
+        end
+
+        if current_account.cancelled? && !current_account.owner?(user)
+          return render json: { error: "Account is cancelled" }, status: :forbidden
+        end
+
+        session = Session.issue_for!(user)
+
+        render json: {
+          session: session.as_api_json,
+          user: user.as_api_json,
+          account: current_account.as_api_json
+        }, status: :created
+      end
+
+      def destroy
+        current_session.destroy!
+        head :no_content
+      end
+    end
+  end
+end
