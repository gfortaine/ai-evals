+      from: "henry@customer.test",
+      to: "newco@support.example.test",
+      subject: "Early arrival",
+      body: "Sent while DNS propagated",
+      message_id: "<early-newco-1@customer.test>"
+    )
+    post_inbound_raw(raw_future_biz)
+    assert_response :no_content
+
+    newco, _ = register_and_verify_account!(account_name: "NewCo", subdomain: "newco", email: "owner@newco.test")
+    ActionMailer::Base.deliveries.clear
+
+    # Exact same raw RFC822 bytes retried by MTA!
+    post_inbound_raw(raw_future_biz)
+    assert_response :no_content
+    assert_equal 1, newco.tickets.count
+    assert_equal "Early arrival", newco.tickets.last.subject
+  end
+
+  test "ignores automated and mailing list emails" do
+    acme, _admin = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    customer = User.create!(
+      account: acme,
+      name: "Iris",
+      email: "iris@customer.test",
+      password: "iris-password",
+      role: "customer",
+      verified_at: Time.current
+    )
+    ticket = acme.tickets.create!(
+      requester: customer,
+      subject: "Existing solved ticket",
+      status: "solved",
+      email_origin: true
+    )
+    Comment.create!(account: acme, ticket: ticket, author: customer, body: "Initial", public: true)
+    ActionMailer::Base.deliveries.clear
+
+    automated_cases = [
+      { headers: { "Auto-Submitted" => "auto-replied" }, msg_id: "<auto-1@customer.test>" },
+      { headers: { "Auto-Submitted" => "auto-generated" }, msg_id: "<auto-2@customer.test>" },
+      { headers: { "Precedence" => "bulk" }, msg_id: "<auto-3@customer.test>" },
+      { headers: { "Precedence" => "list" }, msg_id: "<auto-4@customer.test>" },
+      { headers: { "Precedence" => "junk" }, msg_id: "<auto-5@customer.test>" },
+      { headers: { "List-Id" => "Updates <updates.example.test>" }, msg_id: "<auto-6@customer.test>" },
+      { headers: { "List-Unsubscribe" => "<mailto:unsub@example.test>" }, msg_id: "<auto-7@customer.test>" },
+      { headers: { "X-Auto-Response-Suppress" => "All" }, msg_id: "<auto-8@customer.test>" },
+      { headers: { "Return-Path" => "<>" }, msg_id: "<auto-9@customer.test>" },
+      { from: "mailer-daemon@customer.test", headers: {}, msg_id: "<auto-10@customer.test>" },
+      { from: "noreply@customer.test", headers: {}, msg_id: "<auto-11@customer.test>" }
+    ]
+
+    automated_cases.each do |c|
+      raw = build_raw_mail(
+        from: c.fetch(:from, "newsletter@customer.test"),
+        to: "acme@support.example.test",
+        subject: "Automated message",
+        body: "Out of office / newsletter",
+        message_id: c[:msg_id],
+        headers: c[:headers]
+      )
+      post_inbound_raw(raw)
+      assert_response :no_content
+    end
+
+    assert_equal 1, acme.tickets.count
+    assert_equal 0, ActionMailer::Base.deliveries.size
+
+    # Vacation auto-reply from the requester to the ticket's private reply address must ALSO be ignored
+    ooo_reply = build_raw_mail(
+      from: "iris@customer.test",
+      to: ticket.reply_email_address,
+      subject: "Auto: Re: Existing solved ticket",
+      body: "I am out of the office until Monday.",
+      message_id: "<iris-ooo@customer.test>",
+      headers: { "Auto-Submitted" => "auto-replied" }
+    )
+    post_inbound_raw(ooo_reply)
+    assert_response :no_content
+    assert_equal "solved", ticket.reload.status
+    assert_equal 1, ticket.comments.count
+
+    # Auto-Submitted: no IS human-authored per RFC 3834 and MUST be accepted!
+    human_raw = build_raw_mail(
+      from: "iris@customer.test",
+      to: "acme@support.example.test",
+      subject: "Human message with Auto-Submitted no",
+      body: "Real human inquiry",
+      message_id: "<iris-human@customer.test>",
+      headers: { "Auto-Submitted" => "no" }
+    )
+    post_inbound_raw(human_raw)
+    assert_response :no_content
+    assert_equal 2, acme.tickets.count
+  end
+end
+
+class EmailSupportEdgeCasesTest < ActionDispatch::IntegrationTest
+  INGRESS_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  INGRESS_PASSWORD = "edge-case-inbound-password"
+
+  setup do
+    Helpdesk::Application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+  end
+
+  private
+
+  def post_inbound_raw(raw_rfc822, password: INGRESS_PASSWORD)
+    headers = {
+      "CONTENT_TYPE" => "message/rfc822",
+      "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials("actionmailbox", password)
+    }
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD) do
+      post INGRESS_PATH, params: raw_rfc822, headers: headers
+    end
+  end
+
+  public
+
+  test "cancelled account, suspended customer, staff sender, bogus reply token, multipart attachments, and binary inputs are handled safely and allow valid retries" do
+    acme, _admin = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    globex, _ = register_and_verify_account!(account_name: "Globex", subdomain: "globex", email: "owner@globex.test")
+    admin_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    staff_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{admin_token}" }
+
+    # 1. Staff member emailing plain support address is ignored
+    staff_mail = Mail.new do
+      from "jo@acme.test"
+      to "acme@support.example.test"
+      subject "Staff test"
+      body "Should not open customer ticket"
+      message_id "<staff-1@acme.test>"
+    end.to_s
+    post_inbound_raw(staff_mail)
+    assert_response :no_content
+    assert_equal 0, acme.tickets.count
+
+    # 2.Bogus private reply token does NOT open a new ticket
+    bogus_reply = Mail.new do
+      from "kate@customer.test"
+      to "acme+nonexistenttoken123@support.example.test"
+      subject "Re: Fake ticket"
+      body "Trying a guessed token"
+      message_id "<bogus-tok@customer.test>"
+    end.to_s
+    post_inbound_raw(bogus_reply)
+    assert_response :no_content
+    assert_equal 0, acme.tickets.count
+    assert_nil acme.users.find_by(email: "kate@customer.test")
+
+    # 3. Multipart mixed with file attachment extracts inline plain text and skips attachment
+    mixed_mail = Mail.new do |m|
+      m.from = "kate@customer.test"
+      m.to = "acme@support.example.test"
+      m.subject = "Attachment + text"
+      m.message_id = "<mixed-1@customer.test>"
+      m.add_file filename: "debug.txt", content: "ATTACHMENT_ONLY_TEXT"
+      m.part content_type: "multipart/alternative" do |alt|
+        alt.text_part = Mail::Part.new { content_type "text/plain; charset=UTF-8"; body "Actual inline message body" }
+        alt.html_part = Mail::Part.new { content_type "text/html; charset=UTF-8"; body "<p>HTML body</p>" }
+      end
+    end.to_s
+    post_inbound_raw(mixed_mail)
+    assert_response :no_content
+    assert_equal 1, acme.tickets.count
+    ticket = acme.tickets.sole
+    assert_equal "Actual inline message body", ticket.comments.sole.body
+
+    # 4. Private reply address + another business CC'd -> ignored (multiple businesses)
+    cross_biz_reply = Mail.new do
+      from "kate@customer.test"
+      to ticket.reply_email_address
+      cc "globex@support.example.test"
+      subject "Re: Attachment + text"
+      body "Cross business reply"
+      message_id "<cross-biz-reply@customer.test>"
+    end.to_s
+    post_inbound_raw(cross_biz_reply)
+    assert_response :no_content
+    assert_equal 1, ticket.reload.comments.count
+    assert_equal 0, globex.tickets.count
+
+    # 5. Suspended customer delivery ignored, then exact retry succeeds once unsuspended
+    kate = acme.users.find_by!(email: "kate@customer.test")
+    patch "/api/v1/users/#{kate.id}",
+      params: { user: { suspended: true } },
+      headers: staff_headers,
+      as: :json
+    assert_response :ok
+
+    suspended_reply = Mail.new do
+      from "kate@customer.test"
+      to ticket.reply_email_address
+      subject "Re: Attachment + text"
+      body "Replying while suspended"
+      message_id "<susp-reply-1@customer.test>"
+    end.to_s
+    post_inbound_raw(suspended_reply)
+    assert_response :no_content
+    assert_equal 1, ticket.reload.comments.count
+
+    patch "/api/v1/users/#{kate.id}",
+      params: { user: { suspended: false } },
+      headers: staff_headers,
+      as: :json
+    assert_response :ok
+
+    post_inbound_raw(suspended_reply)
+    assert_response :no_content
+    assert_equal 2, ticket.reload.comments.count
+    assert_equal "Replying while suspended", ticket.comments.oldest_first.last.body
+
+    # 6. Cancelled account delivery ignored, then exact retry succeeds once reactivated
+    post "/api/v1/account/cancel", headers: staff_headers
+    assert_response :ok
+
+    cancelled_mail = Mail.new do
+      from "leo@customer.test"
+      to "acme@support.example.test"
+      subject "During cancellation"
+      body "Are you still open?"
+      message_id "<during-cancel@customer.test>"
+    end.to_s
+    post_inbound_raw(cancelled_mail)
+    assert_response :no_content
+    assert_equal 1, acme.tickets.count
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    post "/api/v1/account/reactivate", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    assert_response :ok
+
+    post_inbound_raw(cancelled_mail)
+    assert_response :no_content
+    assert_equal 2, acme.tickets.count
+
+    # 7. Binary / malformed RFC822 input does not 500
+    post_inbound_raw("Message-ID: <bad\xFFid@test>\r\n\xFF\xFE\x00\x01".b)
+    assert_response :no_content
+    post_inbound_raw("")
+    assert_response :no_content
+
+    # 8. Purging cancelled account after 90 days cleanly removes email-origin tickets and receipts
+    new_owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    post "/api/v1/account/cancel", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{new_owner_token}" }
+    assert_response :ok
+
+    travel 91.days do
+      Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+      Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+
+      assert_nil Account.find_by(id: acme.id)
+      assert_equal 0, Ticket.where(account_id: acme.id).count
+      assert_equal 0, InboundEmailReceipt.where(account_id: acme.id).count
+    end
+  end
+end
