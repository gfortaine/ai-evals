+module Api
+  module V1
+    class PasswordResetsController < BaseController
+      before_action :require_account!
+      before_action :require_active_account!
+
+      def create
+        pr_params = require_hash_param(:password_reset)
+        email = pr_params[:email].to_s.strip.downcase
+
+        if email.blank?
+          return render json: {
+            error: "Email can't be blank",
+            errors: { email: [ "can't be blank" ] }
+          }, status: :unprocessable_entity
+        end
+
+        user = current_account.users.find_by(email: email)
+        if user && !user.suspended?
+          token = user.generate_password_reset_token!
+          UserMailer.password_reset(user, token).deliver_now
+        end
+
+        render json: { ok: true }, status: :ok
+      end
+
+      def confirm
+        pr_params = require_hash_param(:password_reset)
+        token = pr_params[:token].to_s
+        new_password = pr_params[:password]
+
+        user = current_account.users.find_by_password_reset_token(token)
+        if user.nil? || user.suspended?
+          return render json: {
+            error: "Invalid or expired password reset token",
+            errors: { token: [ "is invalid" ] }
+          }, status: :unprocessable_entity
+        end
+
+        user.change_password!(new_password)
+        render json: { user: user.as_api_json }, status: :ok
+      end
+    end
+  end
+end
