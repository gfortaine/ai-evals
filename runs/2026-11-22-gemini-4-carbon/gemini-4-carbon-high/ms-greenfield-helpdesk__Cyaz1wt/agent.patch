diff --git a/app/models/ticket.rb b/app/models/ticket.rb
new file mode 100644
index 0000000..4280116
--- /dev/null
+++ b/app/models/ticket.rb
@@ -0,0 +1,154 @@
+require "securerandom"
+
+class Ticket < ApplicationRecord
+  STATUSES = %w[open pending solved closed].freeze
+  UPDATABLE_STATUSES = %w[open pending solved].freeze
+  PRIORITIES = %w[normal high].freeze
+
+  belongs_to :account
+  belongs_to :requester, class_name: "User", inverse_of: :requested_tickets
+  belongs_to :assignee, class_name: "User", inverse_of: :assigned_tickets, optional: true
+  belongs_to :group, inverse_of: :tickets, optional: true
+  belongs_to :merged_into, class_name: "Ticket", inverse_of: :merged_tickets, optional: true
+  has_many :merged_tickets, class_name: "Ticket", foreign_key: :merged_into_id, inverse_of: :merged_into, dependent: :nullify
+  has_many :inbound_email_receipts, dependent: :destroy
+  has_many :comments, dependent: :destroy
+
+  normalizes :subject, with: ->(value) { value.to_s.strip }
+  normalizes :status, with: ->(value) { value.to_s.strip.downcase }
+  normalizes :priority, with: ->(value) { value.to_s.strip.downcase }
+
+  before_validation :ensure_customer_updated_at, on: :create
+  before_validation :ensure_reply_token, on: :create
+
+  validates :subject, presence: true
+  validates :status, presence: true, inclusion: { in: STATUSES }
+  validates :priority, presence: true, inclusion: { in: PRIORITIES }
+  validates :reply_token, presence: true, uniqueness: true
+  validate :requester_belongs_to_account
+  validate :group_belongs_to_account
+  validate :assignee_is_assignable_staff
+  validate :assignee_belongs_to_group
+  validate :merged_into_is_valid
+
+  scope :recently_active, -> { order(updated_at: :desc, id: :desc) }
+  scope :customer_recently_active, -> { order(customer_updated_at: :desc, id: :desc) }
+  scope :matching_query, ->(query) {
+    return none if query.to_s.include?("\u0000")
+
+    pattern = "%#{sanitize_sql_like(query.to_s, "\\")}%"
+    where(
+      <<~SQL.squish,
+        tickets.subject ILIKE :pattern ESCAPE '\\'
+        OR EXISTS (
+          SELECT 1
+          FROM comments
+          WHERE comments.ticket_id = tickets.id
+            AND comments.account_id = tickets.account_id
+            AND comments.public = TRUE
+            AND comments.body ILIKE :pattern ESCAPE '\\'
+        )
+      SQL
+      pattern: pattern
+    )
+  }
+
+  def closed?
+    status == "closed"
+  end
+
+  def reply_email_address
+    "#{account.subdomain}+#{reply_token}@#{SupportEmail.domain}"
+  end
+
+  def as_request_json
+    {
+      id: id,
+      subject: subject,
+      status: status,
+      requester_id: requester_id,
+      merged_into_id: merged_into_id,
+      created_at: created_at,
+      updated_at: customer_updated_at
+    }
+  end
+
+  def as_ticket_json
+    {
+      id: id,
+      subject: subject,
+      status: status,
+      priority: priority,
+      requester_id: requester_id,
+      requester: requester.as_requester_json,
+      assignee_id: assignee_id,
+      assignee: assignee&.as_assignee_json,
+      group_id: group_id,
+      group: group&.as_summary_json,
+      merged_into_id: merged_into_id,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  private
+
+  def ensure_customer_updated_at
+    if customer_updated_at.nil?
+      now = Time.current
+      self.created_at ||= now
+      self.updated_at ||= now
+      self.customer_updated_at = self.updated_at
+    end
+  end
+
+  def ensure_reply_token
+    self.reply_token ||= SecureRandom.hex(16)
+  end
+
+  def requester_belongs_to_account
+    if account_id.present? && requester.present? && requester.account_id != account_id
+      errors.add(:requester, :invalid)
+    end
+  end
+
+  def group_belongs_to_account
+    return if group_id.nil? && group.nil?
+
+    if group.nil? || (account_id.present? && group.account_id != account_id)
+      errors.add(:group_id, :invalid)
+    end
+  end
+
+  def assignee_is_assignable_staff
+    return if assignee_id.nil? && assignee.nil?
+
+    if assignee.nil? || (account_id.present? && assignee.account_id != account_id) || !assignee.staff? || assignee.suspended?
+      errors.add(:assignee_id, :invalid)
+    end
+  end
+
+  def assignee_belongs_to_group
+    return if group.nil? || assignee.nil?
+    return if errors[:group_id].any? || errors[:assignee_id].any?
+
+    unless group.member?(assignee)
+      errors.add(:assignee_id, :invalid)
+    end
+  end
+
+  def merged_into_is_valid
+    return if merged_into_id.nil? && merged_into.nil?
+
+    if merged_into.nil? ||
+        (id.present? && merged_into.id == id) ||
+        (account_id.present? && merged_into.account_id != account_id) ||
+        (requester_id.present? && merged_into.requester_id != requester_id)
+      errors.add(:merged_into_id, :invalid)
+    end
+
+    if !closed? && errors[:status].empty?
+      errors.add(:status, :invalid)
+    end
+  end
+end
diff --git a/app/models/user.rb b/app/models/user.rb
new file mode 100644
index 0000000..d2ed9c6
--- /dev/null
+++ b/app/models/user.rb
@@ -0,0 +1,194 @@
+require "digest"
+
+class User < ApplicationRecord
+  ROLES = %w[admin agent customer].freeze
+  STAFF_ROLES = %w[admin agent].freeze
+
+  belongs_to :account
+  has_many :comments, foreign_key: :author_id, inverse_of: :author, dependent: :destroy
+  has_many :requested_tickets, class_name: "Ticket", foreign_key: :requester_id, inverse_of: :requester, dependent: :destroy
+  has_many :assigned_tickets, class_name: "Ticket", foreign_key: :assignee_id, inverse_of: :assignee, dependent: :nullify
+  has_many :group_memberships, dependent: :destroy
+  has_many :groups, through: :group_memberships
+  has_many :sent_invitations, class_name: "Invitation", foreign_key: :invited_by_id, inverse_of: :invited_by, dependent: :nullify
+  has_many :accepted_invitations, class_name: "Invitation", foreign_key: :accepted_by_id, inverse_of: :accepted_by, dependent: :nullify
+  has_many :sessions, dependent: :destroy
+
+  has_secure_password
+
+  normalizes :name, with: ->(value) { value.to_s.strip }
+  normalizes :email, with: ->(value) { value.to_s.strip.downcase }
+
+  validates :name, presence: true
+  validates :email,
+    presence: true,
+    format: { with: URI::MailTo::EMAIL_REGEXP },
+    uniqueness: { scope: :account_id, case_sensitive: false }
+  validates :role, presence: true, inclusion: { in: ROLES }
+  validate :validate_assigned_password
+  validate :customer_email_not_pending_invitation, on: :create
+
+  after_save :clear_password_assignment_tracking
+
+  scope :ordered, -> { order(id: :asc) }
+  scope :active, -> { where(suspended_at: nil) }
+  scope :suspended, -> { where.not(suspended_at: nil) }
+  scope :staff, -> { where(role: STAFF_ROLES) }
+  scope :active_staff, -> { staff.active }
+
+  def self.digest_token(raw_token)
+    Digest::SHA256.hexdigest(raw_token.to_s)
+  end
+
+  def self.find_by_email_verification_token(raw_token)
+    return nil if raw_token.blank?
+
+    find_by(email_verification_token_digest: digest_token(raw_token))
+  end
+
+  def self.find_by_password_reset_token(raw_token)
+    return nil if raw_token.blank?
+
+    find_by(password_reset_token_digest: digest_token(raw_token))
+  end
+
+  def password=(unencrypted_password)
+    @password_assigned = true
+    @assigned_password_blank = unencrypted_password.blank?
+    super
+  end
+
+  def reload(*args)
+    clear_password_assignment_tracking
+    super
+  end
+
+  def verified?
+    verified_at.present?
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def admin?
+    role == "admin"
+  end
+
+  def agent?
+    role == "agent"
+  end
+
+  def customer?
+    role == "customer"
+  end
+
+  def staff?
+    STAFF_ROLES.include?(role)
+  end
+
+  def default_group_membership
+    group_memberships.includes(:group).find_by(default: true)
+  end
+
+  def default_group
+    default_group_membership&.group
+  end
+
+  def generate_email_verification_token!
+    raw_token = SecureRandom.urlsafe_base64(32)
+    update!(
+      email_verification_token_digest: self.class.digest_token(raw_token),
+      email_verification_sent_at: Time.current
+    )
+    raw_token
+  end
+
+  def verify_email!
+    update!(
+      verified_at: verified_at || Time.current,
+      email_verification_token_digest: nil,
+      email_verification_sent_at: nil
+    )
+  end
+
+  def generate_password_reset_token!
+    raw_token = SecureRandom.urlsafe_base64(32)
+    update!(
+      password_reset_token_digest: self.class.digest_token(raw_token),
+      password_reset_sent_at: Time.current
+    )
+    raw_token
+  end
+
+  def change_password!(new_password)
+    transaction do
+      self.password = new_password
+      self.password_reset_token_digest = nil
+      self.password_reset_sent_at = nil
+      save!
+      sessions.delete_all
+    end
+  end
+
+  def as_api_json
+    {
+      id: id,
+      account_id: account_id,
+      name: name,
+      email: email,
+      role: role,
+      verified: verified?,
+      suspended: suspended?,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  def as_staff_json
+    {
+      id: id,
+      name: name,
+      email: email,
+      role: role
+    }
+  end
+
+  def as_requester_json
+    {
+      id: id,
+      name: name,
+      email: email
+    }
+  end
+
+  def as_author_json
+    {
+      id: id,
+      name: name
+    }
+  end
+
+  alias_method :as_assignee_json, :as_author_json
+
+  private
+
+  def validate_assigned_password
+    if @password_assigned && @assigned_password_blank && errors[:password].empty?
+      errors.add(:password, :blank)
+    end
+  end
+
+  def customer_email_not_pending_invitation
+    return unless customer? && account&.persisted? && email.present? && errors[:email].empty?
+
+    if account.invitations.pending_at.exists?(email: email)
+      errors.add(:email, "has already been invited")
+    end
+  end
+
+  def clear_password_assignment_tracking
+    @password_assigned = false
+    @assigned_password_blank = false
+  end
+end
