+++ b/test/integration/cursor_pagination_test.rb
@@ -0,0 +1,738 @@
+require "test_helper"
+
+class CursorPaginationTest < ActionDispatch::IntegrationTest
+  private
+
+  def register_and_verify_customer!(subdomain:, name:, email:, password: "my-customer-password")
+    post "/api/v1/registrations",
+      params: { user: { name: name, email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+
+    token = extract_token_from_mail(
+      ActionMailer::Base.deliveries.last,
+      expected_path: "/verify-email",
+      expected_account: subdomain.downcase
+    )
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+
+    ActionMailer::Base.deliveries.clear
+    account = Account.find_by!(subdomain: subdomain.downcase)
+    User.find_by!(account: account, email: email.strip.downcase)
+  end
+
+  def auth_headers(subdomain, token)
+    {
+      "X-Helpdesk-Account" => subdomain,
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+
+  public
+
+  test "empty and single-record cursor responses match exact envelope and legacy page-number API remains intact" do
+    acme, owner = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    customer = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+    owner_headers = auth_headers("acme", owner_token)
+    customer_headers = auth_headers("acme", customer_token)
+
+    # Exact empty cursor response from prompt
+    get "/api/v1/tickets?page[size]=25&status=open", headers: owner_headers
+    assert_response :ok
+    empty_cursor = JSON.parse(response.body)
+    assert_equal(
+      {
+        "tickets" => [],
+        "meta" => {
+          "has_more" => false,
+          "after_cursor" => nil,
+          "before_cursor" => nil
+        },
+        "links" => {
+          "next" => nil,
+          "prev" => nil
+        }
+      },
+      empty_cursor
+    )
+
+    # Legacy page-number API without cursor params remains unchanged
+    get "/api/v1/tickets?status=open", headers: owner_headers
+    assert_response :ok
+    legacy_empty = JSON.parse(response.body)
+    assert_equal(
+      {
+        "tickets" => [],
+        "count" => 0,
+        "page" => 1,
+        "per_page" => 25,
+        "next_page" => nil,
+        "previous_page" => nil
+      },
+      legacy_empty
+    )
+
+    # Single-record page provides both first and last cursors (equal), has_more: false, null links
+    post "/api/v1/requests",
+      params: { request: { subject: "Only ticket", comment: { body: "Hello there" } } },
+      headers: customer_headers,
+      as: :json
+    assert_response :created
+    only_id = JSON.parse(response.body).dig("request", "id")
+
+    get "/api/v1/tickets", params: { page: { size: 25 }, status: "open" }, headers: owner_headers
+    assert_response :ok
+    single = JSON.parse(response.body)
+    assert_equal [ only_id ], single.fetch("tickets").map { |t| t.fetch("id") }
+    assert_equal false, single.dig("meta", "has_more")
+    assert_kind_of String, single.dig("meta", "after_cursor")
+    assert_equal single.dig("meta", "before_cursor"), single.dig("meta", "after_cursor")
+    assert_nil single.dig("links", "next")
+    assert_nil single.dig("links", "prev")
+
+    # Requesting after last or before first returns empty envelope
+    c_only = single.dig("meta", "after_cursor")
+    get "/api/v1/tickets", params: { page: { after: c_only, size: 25 }, status: "open" }, headers: owner_headers
+    assert_response :ok
+    assert_equal [], JSON.parse(response.body).fetch("tickets")
+    assert_equal({ "has_more" => false, "after_cursor" => nil, "before_cursor" => nil }, JSON.parse(response.body).fetch("meta"))
+    assert_equal({ "next" => nil, "prev" => nil }, JSON.parse(response.body).fetch("links"))
+
+    get "/api/v1/tickets", params: { page: { before: c_only, size: 25 }, status: "open" }, headers: owner_headers
+    assert_response :ok
+    assert_equal [], JSON.parse(response.body).fetch("tickets")
+    assert_equal({ "has_more" => false, "after_cursor" => nil, "before_cursor" => nil }, JSON.parse(response.body).fetch("meta"))
+    assert_equal({ "next" => nil, "prev" => nil }, JSON.parse(response.body).fetch("links"))
+  end
+
+  test "supports forward and backward cursor pagination and link following across all 9 collections with filters" do
+    base_time = Time.utc(2026, 11, 21, 9, 0, 0)
+    acme = owner = customer = nil
+    agents = []
+    groups = []
+    memberships = []
+    invitations = []
+    ticket_ids = []
+
+    travel_to(base_time) do
