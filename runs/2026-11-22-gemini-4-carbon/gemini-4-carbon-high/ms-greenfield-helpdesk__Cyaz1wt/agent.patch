+
+    # Pagination on invitations, users, and staff
+    get "/api/v1/invitations", params: { page: 1, per_page: 2 }, headers: owner_headers
+    assert_response :ok
+    inv_page = JSON.parse(response.body)
+    assert_equal 2, inv_page.fetch("invitations").size
+    assert_equal 3, inv_page.fetch("count")
+    assert_equal 2, inv_page.fetch("next_page")
+
+    get "/api/v1/users", params: { page: 1, per_page: 1 }, headers: owner_headers
+    assert_response :ok
+    users_page = JSON.parse(response.body)
+    assert_equal [ owner.id ], users_page.fetch("users").map { |u| u.fetch("id") }
+    assert_equal 2, users_page.fetch("count")
+    assert_equal 2, users_page.fetch("next_page")
+
+    get "/api/v1/staff", params: { page: 0 }, headers: owner_headers
+    assert_response :unprocessable_entity
+
+    # Cross-tenant user inspection/update returns 404
+    get "/api/v1/users/#{globex_owner.id}", headers: owner_headers
+    assert_response :not_found
+
+    patch "/api/v1/users/#{globex_owner.id}",
+      params: { user: { suspended: true } },
+      headers: owner_headers,
+      as: :json
+    assert_response :not_found
+
+    # Malformed payloads return 422
+    post "/api/v1/invitations", params: { invitation: "bad" }, headers: owner_headers, as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/invitation_previews", params: { invitation_preview: "bad" }, headers: { "X-Helpdesk-Account" => "acme" }, as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/invitation_acceptances", params: { invitation_acceptance: "bad" }, headers: { "X-Helpdesk-Account" => "acme" }, as: :json
+    assert_response :unprocessable_entity
+
+    patch "/api/v1/users/#{customer.id}", params: { user: {} }, headers: owner_headers, as: :json
+    assert_response :unprocessable_entity
+
+    patch "/api/v1/users/#{customer.id}", params: { user: { suspended: "not-bool" } }, headers: owner_headers, as: :json
+    assert_response :unprocessable_entity
+
+    # Suspending a customer revokes their session and blocks login & password reset
+    patch "/api/v1/users/#{customer.id}",
+      params: { user: { suspended: true } },
+      headers: owner_headers,
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/requests", headers: customer_headers
+    assert_response :unauthorized
+
+    post "/api/v1/sessions",
+      params: { session: { email: "avery@example.test", password: "my-customer-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :forbidden
+
+    ActionMailer::Base.deliveries.clear
+    assert_no_emails do
+      post "/api/v1/password_resets",
+        params: { password_reset: { email: "avery@example.test" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+      assert_response :ok
+    end
+
+    # Cancelling the account blocks invitations, previews, acceptances, users, and staff until reactivated
+    post "/api/v1/account/cancel", headers: owner_headers
+    assert_response :ok
+
+    cancelled_owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    cancelled_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{cancelled_owner_token}" }
+
+    get "/api/v1/invitations", headers: cancelled_headers
+    assert_response :forbidden
+
+    get "/api/v1/invitations/#{first_inv_id}", headers: cancelled_headers
+    assert_response :forbidden
+
+    post "/api/v1/invitation_previews",
+      params: { invitation_preview: { token: invite_token } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :forbidden
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: invite_token, name: "Blocked", password: "pw" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :forbidden
+
+    get "/api/v1/users", headers: cancelled_headers
+    assert_response :forbidden
+
+    get "/api/v1/staff", headers: cancelled_headers
+    assert_response :forbidden
+
+    # Reactivating restores access
+    post "/api/v1/account/reactivate", headers: cancelled_headers
+    assert_response :ok
+
+    post "/api/v1/invitation_previews",
+      params: { invitation_preview: { token: invite_token } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+  end
+end
diff --git a/test/integration/profile_and_passwords_test.rb b/test/integration/profile_and_passwords_test.rb
new file mode 100644
index 0000000..6f7ea6e
--- /dev/null
+++ b/test/integration/profile_and_passwords_test.rb
@@ -0,0 +1,144 @@
+require "test_helper"
+
+class ProfileAndPasswordsTest < ActionDispatch::IntegrationTest
+  test "GET /me and PATCH /me read and update user name safely" do
+    register_and_verify_account!
+    login = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    token = login.dig("session", "token")
+    headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token}" }
+
+    get "/api/v1/me", headers: headers
+    assert_response :ok
+    assert_equal "Jo", JSON.parse(response.body).dig("user", "name")
+
+    patch "/api/v1/me",
+      params: { user: { name: "Jo Smith", role: "customer", verified: false } },
+      headers: headers,
+      as: :json
+    assert_response :ok
+    updated_user = JSON.parse(response.body).fetch("user")
+    assert_equal "Jo Smith", updated_user.fetch("name")
+    assert_equal "admin", updated_user.fetch("role")
+    assert_equal true, updated_user.fetch("verified")
+
+    patch "/api/v1/me",
+      params: { user: { name: "   " } },
+      headers: headers,
+      as: :json
+    assert_response :unprocessable_entity
+  end
+
+  test "PUT /me/password updates password and revokes existing sessions" do
+    register_and_verify_account!
+    token_1 = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    token_2 = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    headers_1 = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token_1}" }
+
+    # Wrong current_password fails without revoking sessions
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "wrong", password: "my-new-password" } },
+      headers: headers_1,
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Blank new password fails without revoking sessions
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "" } },
+      headers: headers_1,
+      as: :json
+    assert_response :unprocessable_entity
+
+    get "/api/v1/me", headers: headers_1
+    assert_response :ok
+
+    # Valid password change succeeds and signs out all existing sessions
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+      headers: headers_1,
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: headers_1
+    assert_response :unauthorized
+
+    get "/api/v1/me", headers: { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{token_2}" }
+    assert_response :unauthorized
+
+    # Old password no longer works; new password works
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unauthorized
+
+    sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-new-password")
+  end
+
+  test "password reset sends link, replaces old links, updates password, and revokes existing sessions" do
+    register_and_verify_account!
+    existing_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+
+    assert_emails 1 do
+      post "/api/v1/password_resets",
+        params: { password_reset: { email: "jo@acme.test" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+    end
+    assert_response :ok
+
+    first_reset_mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "support@example.test" ], first_reset_mail.from
+    first_reset_token = extract_token_from_mail(first_reset_mail, expected_path: "/reset-password", expected_account: "acme")
+
+    # Requesting another reset link replaces the old one
+    assert_emails 1 do
+      post "/api/v1/password_resets",
+        params: { password_reset: { email: "jo@acme.test" } },
+        headers: { "X-Helpdesk-Account" => "acme" },
+        as: :json
+    end
+    assert_response :ok
+
+    second_reset_mail = ActionMailer::Base.deliveries.last
+    second_reset_token = extract_token_from_mail(second_reset_mail, expected_path: "/reset-password", expected_account: "acme")
+    assert_not_equal first_reset_token, second_reset_token
+
+    # Old reset token fails
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: first_reset_token, password: "recovered-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Blank password fails without consuming the valid token
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: second_reset_token, password: "" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Valid confirmation resets password and signs out existing sessions
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: second_reset_token, password: "recovered-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :ok
+
+    # Token cannot be reused
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: second_reset_token, password: "another-password" } },
+      headers: { "X-Helpdesk-Account" => "acme" },
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Previous session is revoked
+    get "/api/v1/me", headers: {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{existing_token}"
+    }
+    assert_response :unauthorized
+
+    # Can sign in with recovered password
+    sign_in!(subdomain: "acme", email: "jo@acme.test", password: "recovered-password")
+  end
+end
diff --git a/test/integration/ticket_assignments_and_private_notes_test.rb b/test/integration/ticket_assignments_and_private_notes_test.rb
new file mode 100644
index 0000000..4f3d4d5
--- /dev/null
+++ b/test/integration/ticket_assignments_and_private_notes_test.rb
@@ -0,0 +1,291 @@
+require "test_helper"
+require "rake"
+
+class TicketAssignmentsAndPrivateNotesTest < ActionDispatch::IntegrationTest
+  setup do
+    Helpdesk::Application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+  end
+
+  def register_and_verify_customer!(subdomain:, name:, email:, password: "my-customer-password")
+    post "/api/v1/registrations",
+      params: { user: { name: name, email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+
+    token = extract_token_from_mail(
+      ActionMailer::Base.deliveries.last,
+      expected_path: "/verify-email",
+      expected_account: subdomain.downcase
+    )
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+
+    ActionMailer::Base.deliveries.clear
+    account = Account.find_by!(subdomain: subdomain.downcase)
+    User.find_by!(account: account, email: email.strip.downcase)
+  end
+
+  test "staff assign and clear tickets, add private notes, and internal activity never changes customer-facing requests" do
+    base_time = Time.utc(2026, 11, 21, 9, 0, 0)
+
+    acme_account = nil
+    owner = nil
+    agent = nil
+    avery = nil
+    globex_owner = nil
+
+    travel_to(base_time) do
+      acme_account, owner = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+      _, globex_owner = register_and_verify_account!(account_name: "Globex", subdomain: "globex", email: "jo@globex.test")
+
+      agent = User.create!(
+        account: acme_account,
+        name: "Sam",
+        email: "sam@acme.test",
+        password: "sam-password",
+        role: "agent",
+        verified_at: Time.current
+      )
+      avery = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    end
+
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    agent_token = sign_in!(subdomain: "acme", email: "sam@acme.test", password: "sam-password").dig("session", "token")
+    customer_token = sign_in!(subdomain: "acme", email: "avery@example.test", password: "my-customer-password").dig("session", "token")
+
+    owner_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{owner_token}" }
+    agent_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{agent_token}" }
+    customer_headers = { "X-Helpdesk-Account" => "acme", "Authorization" => "Bearer #{customer_token}" }
+
+    req1_initial = nil
+    req2_initial = nil
+    t1_id = nil
+    t2_id = nil
+
+    # Customer opens Request 1 at +1m and Request 2 at +5m
+    travel_to(base_time + 1.minute) do
+      post "/api/v1/requests",
+        params: { request: { subject: "Billing double charge", comment: { body: "I was charged twice." } } },
+        headers: customer_headers,
+        as: :json
+      assert_response :created
+      req1_initial = JSON.parse(response.body).fetch("request")
+      t1_id = req1_initial.fetch("id")
+    end
+
+    travel_to(base_time + 5.minutes) do
+      post "/api/v1/requests",
+        params: { request: { subject: "Feature question", comment: { body: "Do you have SSO?" } } },
+        headers: customer_headers,
+        as: :json
+      assert_response :created
+      req2_initial = JSON.parse(response.body).fetch("request")
+      t2_id = req2_initial.fetch("id")
+    end
+
+    # Customer request does not expose assignee_id or assignee
+    assert_nil req1_initial["assignee_id"]
+    assert_nil req1_initial["assignee"]
+
+    # Initial ticket JSON includes assignee_id: nil and assignee: nil
+    get "/api/v1/tickets/#{t1_id}", headers: agent_headers
+    assert_response :ok
+    initial_ticket = JSON.parse(response.body).fetch("ticket")
+    assert initial_ticket.key?("assignee_id")
+    assert initial_ticket.key?("assignee")
+    assert_nil initial_ticket.fetch("assignee_id")
+    assert_nil initial_ticket.fetch("assignee")
+
+    # Invalid assignment targets (customer, other account staff, unknown id, invalid type) fail with 422
+    [ avery.id, globex_owner.id, 999_999, "not-an-id" ].each do |bad_assignee|
+      assert_no_difference -> { Comment.count } do
+        patch "/api/v1/tickets/#{t1_id}",
+          params: {
+            ticket: {
+              assignee_id: bad_assignee,
+              comment: { body: "Should roll back", public: false }
+            }
+          },
+          headers: agent_headers,
+          as: :json
+        assert_response :unprocessable_entity
+      end
+    end
+
+    # At +10m: Agent assigns Ticket 1 to Sam -> staff ticket updates & moves to top, customer request UNCHANGED
+    travel_to(base_time + 10.minutes) do
+      patch "/api/v1/tickets/#{t1_id}",
+        params: { ticket: { assignee_id: agent.id } },
+        headers: agent_headers,
+        as: :json
+      assert_response :ok
+      assigned_ticket = JSON.parse(response.body).fetch("ticket")
+      assert_equal agent.id, assigned_ticket.fetch("assignee_id")
+      assert_equal({ "id" => agent.id, "name" => "Sam" }, assigned_ticket.fetch("assignee"))
+
+      # Ticket 1 is now first on staff GET /tickets
+      get "/api/v1/tickets", headers: agent_headers
+      assert_response :ok
+      assert_equal [ t1_id, t2_id ], JSON.parse(response.body).fetch("tickets").map { |t| t.fetch("id") }
+
+      # Customer GET /requests/:id and GET /requests are completely unchanged!
+      get "/api/v1/requests/#{t1_id}", headers: customer_headers
+      assert_response :ok
+      assert_equal req1_initial, JSON.parse(response.body).fetch("request")
+
+      get "/api/v1/requests", headers: customer_headers
+      assert_response :ok
+      assert_equal [ req2_initial, req1_initial ], JSON.parse(response.body).fetch("requests")
+    end
+
+    # At +15m: Agent posts a private note on Ticket 1 -> visible to staff, hidden from customer, customer request UNCHANGED
+    travel_to(base_time + 15.minutes) do
+      assert_no_emails do
+        patch "/api/v1/tickets/#{t1_id}",
+          params: { ticket: { comment: { body: "Checking this with billing.", public: false } } },
+          headers: agent_headers,
+          as: :json
+      end
+      assert_response :ok
+
+      get "/api/v1/tickets/#{t1_id}/comments", headers: owner_headers
+      assert_response :ok
+      staff_comments = JSON.parse(response.body).fetch("comments")
+      assert_equal 2, staff_comments.size
+      assert_equal "Checking this with billing.", staff_comments.last.fetch("body")
+      assert_equal false, staff_comments.last.fetch("public")
+      assert_equal({ "id" => agent.id, "name" => "Sam" }, staff_comments.last.fetch("author"))
+
+      # Customer comments and request remain completely unchanged!
+      get "/api/v1/requests/#{t1_id}/comments", headers: customer_headers
+      assert_response :ok
+      cust_comments = JSON.parse(response.body).fetch("comments")
+      assert_equal 1, cust_comments.size
+      assert_equal "I was charged twice.", cust_comments.first.fetch("body")
+
+      get "/api/v1/requests/#{t1_id}", headers: customer_headers
+      assert_response :ok
+      assert_equal req1_initial, JSON.parse(response.body).fetch("request")
+
+      get "/api/v1/requests", headers: customer_headers
+      assert_response :ok
+      assert_equal [ req2_initial, req1_initial ], JSON.parse(response.body).fetch("requests")
+    end
+
+    # At +20m: Admin reassigns Ticket 1 to owner, clears to null, reassigns to agent, then suspends agent
+    travel_to(base_time + 20.minutes) do
+      patch "/api/v1/tickets/#{t1_id}",
+        params: {
+          ticket: {
+            assignee_id: owner.id,
+            status: "open",
+            comment: { body: "Admin internal follow-up.", public: false }
+          }
+        },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+      assert_equal({ "id" => owner.id, "name" => "Jo" }, JSON.parse(response.body).dig("ticket", "assignee"))
+
+      # Clear assignment with null
+      patch "/api/v1/tickets/#{t1_id}",
+        params: { ticket: { assignee_id: nil } },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+      assert_nil JSON.parse(response.body).dig("ticket", "assignee_id")
+      assert_nil JSON.parse(response.body).dig("ticket", "assignee")
+
+      # Reassign to agent and suspend agent -> clears assignment without changing customer request
+      patch "/api/v1/tickets/#{t1_id}",
+        params: { ticket: { assignee_id: agent.id } },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+
+      patch "/api/v1/users/#{agent.id}",
+        params: { user: { suspended: true } },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+
+      get "/api/v1/tickets/#{t1_id}", headers: owner_headers
+      assert_response :ok
+      assert_nil JSON.parse(response.body).dig("ticket", "assignee_id")
+
+      # Customer request is STILL 100% identical to req1_initial!
+      get "/api/v1/requests/#{t1_id}", headers: customer_headers
+      assert_response :ok
+      assert_equal req1_initial, JSON.parse(response.body).fetch("request")
+
+      get "/api/v1/requests", headers: customer_headers
+      assert_response :ok
+      assert_equal [ req2_initial, req1_initial ], JSON.parse(response.body).fetch("requests")
+    end
+
+    # At +25m: Owner posts a PUBLIC comment and sets status pending -> customer request DOES update and moves to front!
+    travel_to(base_time + 25.minutes) do
+      patch "/api/v1/tickets/#{t1_id}",
+        params: {
+          ticket: {
+            assignee_id: owner.id,
+            status: "pending",
+            comment: { body: "Refund issued! Please confirm you see it." }
+          }
+        },
+        headers: owner_headers,
+        as: :json
+      assert_response :ok
+
+      get "/api/v1/requests/#{t1_id}", headers: customer_headers
+      assert_response :ok
+      updated_req1 = JSON.parse(response.body).fetch("request")
+      assert_equal "pending", updated_req1.fetch("status")
+      assert_operator Time.iso8601(updated_req1.fetch("updated_at")), :>, Time.iso8601(req1_initial.fetch("updated_at"))
+
+      get "/api/v1/requests", headers: customer_headers
+      assert_response :ok
+      assert_equal [ t1_id, t2_id ], JSON.parse(response.body).fetch("requests").map { |r| r.fetch("id") }
+
+      # Customer replies -> request reopens, and staff assignment to owner is preserved
+      patch "/api/v1/requests/#{t1_id}",
+        params: { request: { comment: { body: "Got the refund, thanks!" }, status: "solved" } },
+        headers: customer_headers,
+        as: :json
+      assert_response :ok
+
+      get "/api/v1/tickets/#{t1_id}", headers: owner_headers
+      assert_response :ok
+      assert_equal owner.id, JSON.parse(response.body).dig("ticket", "assignee_id")
+      assert_equal "solved", JSON.parse(response.body).dig("ticket", "status")
+    end
+
+    # Account cancellation & 90-day purge deletes invitations, users, tickets, and comments cleanly
+    travel_to(base_time + 30.minutes) do
+      post "/api/v1/invitations",
+        params: { invitation: { email: "cleanup@acme.test", role: "agent" } },
+        headers: owner_headers,
+        as: :json
+      assert_response :created
+
+      post "/api/v1/account/cancel", headers: owner_headers
+      assert_response :ok
+    end
+
+    travel_to(base_time + 92.days) do
+      Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+      Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+
+      assert_nil Account.find_by(id: acme_account.id)
+      assert_equal 0, Invitation.where(account_id: acme_account.id).count
+      assert_equal 0, Ticket.where(account_id: acme_account.id).count
