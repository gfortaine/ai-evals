+++ b/test/test_helper.rb
@@ -0,0 +1,88 @@
+ENV["RAILS_ENV"] ||= "test"
+require_relative "../config/environment"
+require "rails/test_help"
+
+module ActiveSupport
+  class TestCase
+    parallelize(workers: 1)
+
+    setup do
+      ActionMailer::Base.deliveries.clear
+    end
+
+    private
+
+    def with_env(overrides)
+      previous = {}
+      overrides.each do |key, value|
+        previous[key] = ENV[key]
+        if value.nil?
+          ENV.delete(key)
+        else
+          ENV[key] = value
+        end
+      end
+      yield
+    ensure
+      previous.each do |key, value|
+        if value.nil?
+          ENV.delete(key)
+        else
+          ENV[key] = value
+        end
+      end
+    end
+
+    def extract_token_from_mail(mail, expected_path:, expected_account:)
+      body = mail.body.decoded
+      pattern = %r{#{Regexp.escape(expected_path)}\?account=#{Regexp.escape(expected_account)}&token=([A-Za-z0-9_-]+)}
+      match = body.match(pattern)
+      assert_not_nil match, "Expected mail body #{body.inspect} to match #{pattern.inspect}"
+      match[1]
+    end
+
+    def register_and_verify_account!(
+      account_name: "Acme",
+      subdomain: "acme",
+      admin_name: "Jo",
+      email: "jo@acme.test",
+      password: "my-first-password"
+    )
+      post "/api/v1/account/create",
+        params: {
+          account: {
+            name: account_name,
+            subdomain: subdomain,
+            admin: {
+              name: admin_name,
+              email: email,
+              password: password
+            }
+          }
+        },
+        as: :json
+      assert_response :created
+
+      mail = ActionMailer::Base.deliveries.last
+      token = extract_token_from_mail(mail, expected_path: "/verify-email", expected_account: subdomain.downcase)
+
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: token } },
+        headers: { "X-Helpdesk-Account" => subdomain },
+        as: :json
+      assert_response :ok
+
+      ActionMailer::Base.deliveries.clear
+      [ Account.find_by!(subdomain: subdomain.downcase), User.find_by!(email: email.downcase, account: Account.find_by!(subdomain: subdomain.downcase)) ]
+    end
+
+    def sign_in!(subdomain:, email:, password:)
+      post "/api/v1/sessions",
+        params: { session: { email: email, password: password } },
+        headers: { "X-Helpdesk-Account" => subdomain },
+        as: :json
+      assert_response :created
+      ::JSON.parse(response.body)
+    end
+  end
+end
