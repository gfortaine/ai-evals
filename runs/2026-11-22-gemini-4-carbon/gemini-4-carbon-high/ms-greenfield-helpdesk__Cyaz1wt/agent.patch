+  test "deep cursor pagination avoids COUNT and OFFSET queries and uses indexed keyset lookups" do
+    acme, _ = register_and_verify_account!(account_name: "Acme", subdomain: "acme", email: "jo@acme.test")
+    customer = register_and_verify_customer!(subdomain: "acme", name: "Avery", email: "avery@acme.test")
+    owner_token = sign_in!(subdomain: "acme", email: "jo@acme.test", password: "my-first-password").dig("session", "token")
+    owner_headers = auth_headers("acme", owner_token)
+
+    now = Time.utc(2026, 11, 21, 15, 0, 0)
+    rows = 1500.times.map do |i|
+      ts = now - i.seconds
+      {
+        account_id: acme.id,
+        requester_id: customer.id,
+        subject: "Deep ticket #{i}",
+        status: "open",
+        priority: "normal",
+        email_origin: false,
+        reply_token: SecureRandom.hex(16),
+        created_at: ts,
+        updated_at: ts,
+        customer_updated_at: ts
+      }
+    end
+    Ticket.insert_all!(rows)
+
+    # Grab a record deep in the list (1200th ticket) and encode cursor via page 1 -> jump
+    deep_anchor = acme.tickets.recently_active.offset(1200).first
+    # Fetch around deep_anchor by getting page at offset via cursor from 1199th
+    prev_record = acme.tickets.recently_active.offset(1199).limit(1).first
+
+    # Obtain valid cursor for prev_record by temporarily filtering or walking; easier: walk 48 pages of 25!
+    executed_sql = []
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, payload|
+      sql = payload[:sql].to_s
+      next if payload[:name] == "SCHEMA" || sql.start_with?("BEGIN", "COMMIT", "SAVEPOINT", "RELEASE")
+      executed_sql << sql
+    end
+
+    cursor_url = "/api/v1/tickets?page[size]=25&status=open"
+    48.times do
+      executed_sql.clear
+      get cursor_url, headers: owner_headers
+      assert_response :ok
+      body = JSON.parse(response.body)
+      assert_equal 25, body.fetch("tickets").size
+      refute executed_sql.any? { |s| s.match?(/\bCOUNT\s*\(/i) }, "Expected no COUNT(*) query in cursor mode, got: #{executed_sql.inspect}"
+      refute executed_sql.any? { |s| s.match?(/\bOFFSET\b/i) }, "Expected no OFFSET query in cursor mode, got: #{executed_sql.inspect}"
+      cursor_url = body.dig("links", "next")
+    end
+
+    # Page 49 starts right at offset 1200 (deep_anchor)!
+    get cursor_url, headers: owner_headers
+    assert_response :ok
+    deep_page = JSON.parse(response.body)
+    assert_equal deep_anchor.id, deep_page.fetch("tickets").first.fetch("id")
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+  end
+end
