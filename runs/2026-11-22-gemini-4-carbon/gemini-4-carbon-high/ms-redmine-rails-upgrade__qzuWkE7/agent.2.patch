new file mode 100644
index 0000000..5a650f6
--- /dev/null
+++ b/config/initializers/upgrade_compatibility.rb
@@ -0,0 +1,169 @@
+# frozen_string_literal: true
+
+# Rolling upgrade and rollback compatibility across:
+# - Previous release: Rails 6.1 (no load_defaults: SHA1 key generator, Marshal
+#   cookies, non-URL-safe CSRF tokens, global CSRF tokens)
+# - Current release:  Rails 7.0 defaults (with temporary overrides in
+#   config/application.rb for safe rollback to 6.1)
+# - Next release:     Rails 7.2 defaults (SHA256 key generator, JSON message
+#   serializer, single-envelope metadata, per-form CSRF tokens)
+
+module RedmineUpgradeCompatibility
+  module MarshalDumpWithJsonFallback
+    MARSHAL_SIGNATURE = "\x04\x08".b
+
+    def self.dump(value)
+      Marshal.dump(value)
+    end
+
+    def self.load(value)
+      if value.b.start_with?(MARSHAL_SIGNATURE)
+        Marshal.load(value) # rubocop:disable Security/MarshalLoad
+      else
+        ActiveSupport::JSON.decode(value)
+      end
+    end
+  end
+
+  module CsrfCompatibility
+    private
+
+    def decode_csrf_token(encoded_csrf_token)
+      Base64.urlsafe_decode64(encoded_csrf_token)
+    rescue ArgumentError
+      Base64.strict_decode64(encoded_csrf_token)
+    end
+
+    def real_csrf_token(*args)
+      raw = super
+      target_session = args.first || (respond_to?(:session, true) ? session : nil)
+      if target_session && (stored = target_session[:_csrf_token]).is_a?(String) && stored.match?(%r{[+/=]})
+        target_session[:_csrf_token] = Base64.urlsafe_encode64(raw, :padding => false)
+      end
+      raw
+    end
+
+    def valid_per_form_csrf_token?(token, session = nil)
+      correct_token = per_form_csrf_token(
+        session,
+        request.path.chomp('/'),
+        request.request_method
+      )
+      ActiveSupport::SecurityUtils.fixed_length_secure_compare(token, correct_token)
+    end
+  end
+
+  module ApplicationKeyGeneratorRotation
+    def sha256_key_generator(secret = secret_key_base)
+      @sha256_key_generators ||= {}
+      @sha256_key_generators[secret] ||= ActiveSupport::CachingKeyGenerator.new(
+        ActiveSupport::KeyGenerator.new(
+          secret,
+          :iterations => 1000,
+          :hash_digest_class => OpenSSL::Digest::SHA256
+        )
+      )
+    end
+  end
+end
+
+ActiveSupport.on_load(:action_controller_base) do
+  prepend(RedmineUpgradeCompatibility::CsrfCompatibility)
+end
+
+Rails::Application.prepend(RedmineUpgradeCompatibility::ApplicationKeyGeneratorRotation)
+
+if Rails.version < '7.1'
+  ActiveSupport::Messages::Metadata.singleton_class.prepend(
+    Module.new do
+      private
+
+      def extract_metadata(message)
+        data =
+          begin
+            ActiveSupport::JSON.decode(message)
+          rescue StandardError
+            nil
+          end
+        if data.is_a?(Hash) && data['_rails'].is_a?(Hash) &&
+             !data['_rails'].key?('message') && data['_rails'].key?('data')
+          new(
+            ActiveSupport::JSON.encode(data['_rails']['data']),
+            data['_rails']['exp'],
+            data['_rails']['pur']
+          )
+        else
+          super
+        end
+      end
+    end
+  )
+
+  ActiveSupport::MessageVerifier.prepend(
+    Module.new do
+      private
+
+      def decode(data)
+        super
+      rescue ArgumentError
+        Base64.urlsafe_decode64(data)
+      end
+    end
+  )
+
+  Rails::Application.prepend(
+    Module.new do
+      def message_verifier(verifier_name)
+        @message_verifiers[verifier_name] ||= begin
+          secret = key_generator.generate_key(verifier_name.to_s)
+          verifier = ActiveSupport::MessageVerifier.new(
+            secret,
+            :serializer => RedmineUpgradeCompatibility::MarshalDumpWithJsonFallback
+          )
+          verifier.rotate(
+            sha256_key_generator.generate_key(verifier_name.to_s),
+            :serializer => RedmineUpgradeCompatibility::MarshalDumpWithJsonFallback
+          )
+          verifier
+        end
+      end
+    end
+  )
+else
+  Rails.application.message_verifiers.rotate(
+    :secret_generator => lambda {|salt| Rails.application.sha256_key_generator.generate_key(salt)}
+  )
+end
+
+Rails.application.config.after_initialize do |app|
+  secret_key_base =
+    begin
+      app.secret_key_base
+    rescue ArgumentError
+      nil
+    end
+  next if secret_key_base.blank?
+
+  sha256_generator = app.sha256_key_generator(secret_key_base)
+
+  cipher = app.config.action_dispatch.encrypted_cookie_cipher || 'aes-256-gcm'
+  encrypted_salt = app.config.action_dispatch.authenticated_encrypted_cookie_salt
+  if encrypted_salt.present?
+    key_len = ActiveSupport::MessageEncryptor.key_len(cipher)
+    app.config.action_dispatch.cookies_rotations.rotate(
+      :encrypted,
+      sha256_generator.generate_key(encrypted_salt, key_len),
+      :cipher => cipher
+    )
+  end
+
+  signed_salt = app.config.action_dispatch.signed_cookie_salt
+  if signed_salt.present?
+    digest = app.config.action_dispatch.signed_cookie_digest || 'SHA1'
+    app.config.action_dispatch.cookies_rotations.rotate(
+      :signed,
+      sha256_generator.generate_key(signed_salt),
+      :digest => digest
+    )
+  end
+end
