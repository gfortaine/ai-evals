--- /dev/null
+++ b/lib/tasks/profile_images.rake
@@ -0,0 +1,10 @@
+namespace :profile_images do
+  desc "Copy existing user and organization profile pictures from CarrierWave into Active Storage"
+  task copy: :environment do
+    result = ProfileImages::Copy.call
+    message = "Copied #{result[:copied]} profile images " \
+              "(skipped: #{result[:skipped]}, missing: #{result[:missing]})"
+    Rails.logger.info(message)
+    puts(message)
+  end
+end
