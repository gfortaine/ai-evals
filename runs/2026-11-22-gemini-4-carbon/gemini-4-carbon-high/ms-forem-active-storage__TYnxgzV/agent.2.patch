+RSpec.describe "profile_images:copy", type: :task do
+  let(:png_fixture) { Rails.root.join("spec/fixtures/files/800x600.png") }
+  let(:jpg_fixture) { Rails.root.join("spec/fixtures/files/800x600.jpg") }
+
+  before do
+    Rake::Task["profile_images:copy"].reenable
+  end
+
+  around do |example|
+    Dir.mktmpdir("carrierwave_task_spec") do |tmpdir|
+      previous_root = CarrierWave.root
+      CarrierWave.root = tmpdir
+      example.run
+    ensure
+      CarrierWave.root = previous_root
+    end
+  end
+
+  it "copies existing user and organization profile pictures into Active Storage idempotently", :aggregate_failures do
+    user = create(:user, profile_image: nil)
+    user.update_columns(profile_image: "task-user.png")
+    user_dir = File.join(CarrierWave.root, "uploads/user/profile_image/#{user.id}")
+    FileUtils.mkdir_p(user_dir)
+    FileUtils.cp(png_fixture, File.join(user_dir, "task-user.png"))
+
+    org = create(:organization)
+    org.profile_image.purge
+    org.update_columns(profile_image: "task-org.jpg")
+    org_dir = File.join(CarrierWave.root, "uploads/organization/profile_image/#{org.id}")
+    FileUtils.mkdir_p(org_dir)
+    FileUtils.cp(jpg_fixture, File.join(org_dir, "task-org.jpg"))
+
+    expect { Rake::Task["profile_images:copy"].invoke }
+      .to output(/Copied 2 profile images/).to_stdout
+
+    expect(user.reload.profile_image).to be_attached
+    expect(org.reload.profile_image).to be_attached
+
+    Rake::Task["profile_images:copy"].reenable
+    expect { Rake::Task["profile_images:copy"].invoke }
+      .to output(/Copied 0 profile images/).to_stdout
+  end
+end
