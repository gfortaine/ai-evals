+          params: { user: { profile_image: Rack::Test::UploadedFile.new(png_path, "image/png") } },
+          headers: { "Accept" => "application/json" }
+
+      expect(response).to have_http_status(:ok)
+      expect(user.reload.profile_image).to be_attached
+      expect(response.parsed_body.dig("user", "profile_image", "url")).to eq(user.profile_image_url)
+    end
+  end
+
+  describe "API profile_images endpoint with both CarrierWave and Active Storage records" do
+    it "returns working URLs for legacy CarrierWave users and organizations", :aggregate_failures do
+      legacy_user = create(:user, profile_image: nil)
+      legacy_user.update_columns(profile_image: "legacy-u.jpg")
+
+      legacy_org = create(:organization)
+      legacy_org.profile_image.purge
+      legacy_org.update_columns(profile_image: "legacy-o.png")
+
+      get api_profile_image_path(legacy_user.username)
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq("/uploads/user/profile_image/#{legacy_user.id}/legacy-u.jpg")
+
+      get api_profile_image_path(legacy_org.slug)
+      expect(response).to have_http_status(:ok)
+      expected_org_path = "/uploads/organization/profile_image/#{legacy_org.id}/legacy-o.png"
+      expect(response.parsed_body["profile_image"]).to eq(expected_org_path)
+    end
+  end
+end
