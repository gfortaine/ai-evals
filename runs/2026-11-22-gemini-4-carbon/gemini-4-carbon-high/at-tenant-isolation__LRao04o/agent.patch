+class AddTenants < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    if select_value("SELECT 1 FROM users LIMIT 1") || select_value("SELECT 1 FROM books LIMIT 1")
+      name = select_value("SELECT name FROM accounts ORDER BY id LIMIT 1").presence || "Default"
+      now = Time.current
+
+      tenant_id = insert ActiveRecord::Base.sanitize_sql_array([
+        "INSERT INTO tenants (name, created_at, updated_at) VALUES (?, ?, ?)",
+        name, now, now
+      ])
+
+      update ActiveRecord::Base.sanitize_sql_array([ "UPDATE users SET tenant_id = ?", tenant_id ])
+      update ActiveRecord::Base.sanitize_sql_array([ "UPDATE books SET tenant_id = ?", tenant_id ])
+    end
+
+    User.reset_column_information if defined?(User)
+    Book.reset_column_information if defined?(Book)
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+    drop_table :tenants
+
+    User.reset_column_information if defined?(User)
+    Book.reset_column_information if defined?(Book)
+  end
