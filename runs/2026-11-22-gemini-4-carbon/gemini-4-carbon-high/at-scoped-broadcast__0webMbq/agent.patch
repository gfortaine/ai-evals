diff --git a/test/controllers/pages_controller_test.rb b/test/controllers/pages_controller_test.rb
index 0b0ccec..6052582 100644
--- a/test/controllers/pages_controller_test.rb
+++ b/test/controllers/pages_controller_test.rb
@@ -79,8 +79,142 @@ class PagesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "With even more interesting words.", updated_page.body.content
   end
 
+  test "update broadcasts being edited indicator to active editors" do
+    get edit_leafable_path(leaves(:welcome_page))
+    kevin_stream = being_edited_stream_from_response
+
+    sign_in :jason
+    get edit_leafable_path(leaves(:welcome_page))
+    jason_stream = being_edited_stream_from_response
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { page: { body: "Edited by David" } }
+    end
+
+    kevin_broadcasts = capture_turbo_stream_broadcasts(kevin_stream)
+    assert_equal 1, kevin_broadcasts.size
+    assert_equal "append", kevin_broadcasts.first["action"]
+    assert_equal dom_id(leaves(:welcome_page), :being_edited), kevin_broadcasts.first["target"]
+    assert_includes kevin_broadcasts.first.to_html, users(:david).name
+
+    jason_broadcasts = capture_turbo_stream_broadcasts(jason_stream)
+    assert_equal 1, jason_broadcasts.size
+    assert_includes jason_broadcasts.first.to_html, users(:david).name
+
+    assert_no_turbo_stream_broadcasts [ leaves(:welcome_page), :being_edited ]
+  end
+
+  test "update does not broadcast being edited indicator to a collaborator removed from the book" do
+    books(:handbook).update_access(editors: [ users(:david).id, users(:kevin).id, users(:jz).id ], readers: [])
+
+    get edit_leafable_path(leaves(:welcome_page))
+    kevin_stream = being_edited_stream_from_response
+
+    sign_in :jz
+    get edit_leafable_path(leaves(:welcome_page))
+    jz_stream = being_edited_stream_from_response
+
+    sign_in :jason
+    get edit_leafable_path(leaves(:welcome_page))
+    jason_stream = being_edited_stream_from_response
+
+    sign_in :david
+    put book_path(books(:handbook)), params: {
+      book: { title: "Handbook", everyone_access: false },
+      editor_ids: [ users(:jz).id ],
+      reader_ids: [ users(:jz).id ]
+    }
+
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { page: { body: "Edited after removal" } }
+    end
+
+    assert_no_turbo_stream_broadcasts kevin_stream
+    assert_no_turbo_stream_broadcasts [ leaves(:welcome_page), :being_edited ]
+
+    jz_broadcasts = capture_turbo_stream_broadcasts(jz_stream)
+    assert_equal 1, jz_broadcasts.size
+    assert_includes jz_broadcasts.first.to_html, users(:david).name
+
+    jason_broadcasts = capture_turbo_stream_broadcasts(jason_stream)
+    assert_equal 1, jason_broadcasts.size
+    assert_includes jason_broadcasts.first.to_html, users(:david).name
+  end
+
+  test "update does not broadcast being edited indicator to a collaborator removed from a published book" do
+    books(:handbook).update!(published: true, everyone_access: false)
+
+    get edit_leafable_path(leaves(:welcome_page))
+    kevin_stream = being_edited_stream_from_response
+
+    accesses(:kevin_handbook).destroy!
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { page: { body: "Edited on published book" } }
+    end
+
+    assert_no_turbo_stream_broadcasts kevin_stream
+  end
+
+  test "update does not broadcast being edited indicator to a collaborator demoted to reader" do
+    get edit_leafable_path(leaves(:welcome_page))
+    kevin_stream = being_edited_stream_from_response
+
+    sign_in :jason
+    get edit_leafable_path(leaves(:welcome_page))
+    jason_stream = being_edited_stream_from_response
+
+    books(:handbook).update_access(editors: [ users(:david).id, users(:jason).id ], readers: [ users(:kevin).id ])
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { page: { body: "Edited after demotion" } }
+    end
+
+    assert_no_turbo_stream_broadcasts kevin_stream
+    assert_turbo_stream_broadcasts jason_stream, count: 1
+  end
+
+  test "update does not broadcast being edited indicator to a deactivated collaborator" do
+    get edit_leafable_path(leaves(:welcome_page))
+    kevin_stream = being_edited_stream_from_response
+
+    users(:kevin).deactivate
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { page: { body: "Edited after deactivation" } }
+    end
+
+    assert_no_turbo_stream_broadcasts kevin_stream
+  end
+
+  test "removed collaborator attempting update is rejected without broadcasting" do
+    sign_in :jason
+    get edit_leafable_path(leaves(:welcome_page))
+    jason_stream = being_edited_stream_from_response
+
+    books(:handbook).access_for(user: users(:kevin)).update!(level: :reader)
+
+    sign_in :kevin
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { page: { body: "Unauthorized edit" } }
+    end
+
+    assert_response :forbidden
+    assert_no_turbo_stream_broadcasts jason_stream
+  end
+
   private
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
     end
+
+    def being_edited_stream_from_response
+      source = css_select("turbo-cable-stream-source").first
+      assert_not_nil source
+      Turbo::StreamsChannel.verified_stream_name(source["signed-stream-name"])
+    end
 end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..ffedcc4 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,19 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors returns active users who can edit the book" do
+    book = books(:handbook)
+
+    assert_equal [ users(:david), users(:jason), users(:kevin) ].sort_by(&:id), book.editors.sort_by(&:id)
+    assert_not_includes book.editors, users(:jz)
+
+    book.update!(everyone_access: false)
+    book.update_access(editors: [ users(:david).id, users(:jz).id ], readers: [ users(:kevin).id ])
+    assert_equal [ users(:david), users(:jason), users(:jz) ].sort_by(&:id), book.editors.sort_by(&:id)
+    assert_not_includes book.editors, users(:kevin)
+
+    users(:jz).deactivate
+    assert_not_includes book.editors, users(:jz)
+  end
 end
