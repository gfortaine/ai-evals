+require "rails_helper"
+
+RSpec.describe "profile_images tasks", type: :task do
+  let(:png_bytes) { Rails.root.join("spec/fixtures/files/800x600.png").binread }
+  let(:jpg_bytes) { Rails.root.join("spec/fixtures/files/800x600.jpg").binread }
+  let(:created_dirs) { [] }
+
+  before do
+    Rake::Task["profile_images:copy"].reenable
+  end
+
+  after do
+    created_dirs.each { |dir| FileUtils.rm_rf(dir) }
+  end
+
+  it "copies existing user and organization profile images via profile_images:copy and is safe to re-run",
+     :aggregate_failures do
+    user = create(:user, profile_image: nil)
+    user_dir = Rails.public_path.join("uploads", "user", "profile_image", user.id.to_s)
+    FileUtils.mkdir_p(user_dir)
+    created_dirs << user_dir
+    File.binwrite(user_dir.join("avatar.png"), png_bytes)
+    user.update_columns(profile_image: "avatar.png")
+
+    org = create(:organization)
+    org.profile_image.purge
+    org_dir = Rails.public_path.join("uploads", "organization", "profile_image", org.id.to_s)
+    FileUtils.mkdir_p(org_dir)
+    created_dirs << org_dir
+    File.binwrite(org_dir.join("logo.jpg"), jpg_bytes)
+    org.update_columns(profile_image: "logo.jpg")
+
+    Rake::Task["profile_images:copy"].invoke
+
+    expect(user.reload.profile_image).to be_attached
+    expect(user.profile_image.download).to eq(png_bytes)
+    expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+
+    expect(org.reload.profile_image).to be_attached
+    expect(org.profile_image.download).to eq(jpg_bytes)
+    expect(org.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+
+    Rake::Task["profile_images:copy"].reenable
+    expect { Rake::Task["profile_images:copy"].invoke }.not_to change(ActiveStorage::Blob, :count)
+  end
+end
