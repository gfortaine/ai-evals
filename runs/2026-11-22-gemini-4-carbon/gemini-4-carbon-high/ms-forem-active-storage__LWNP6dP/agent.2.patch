diff --git a/spec/services/profile_images/copy_spec.rb b/spec/services/profile_images/copy_spec.rb
new file mode 100644
index 0000000..553ec4c
--- /dev/null
+++ b/spec/services/profile_images/copy_spec.rb
@@ -0,0 +1,302 @@
+require "rails_helper"
+require "active_storage/service/fog_service"
+
+RSpec.describe ProfileImages::Copy do
+  let(:png_bytes) { Rails.root.join("spec/fixtures/files/800x600.png").binread }
+  let(:jpg_bytes) { Rails.root.join("spec/fixtures/files/800x600.jpg").binread }
+  let(:webp_bytes) { Rails.root.join("spec/fixtures/files/800x600.webp").binread }
+  let(:created_carrierwave_dirs) { [] }
+
+  after do
+    created_carrierwave_dirs.each { |dir| FileUtils.rm_rf(dir) }
+  end
+
+  def store_legacy_carrierwave_file(record, filename, bytes)
+    model_dir = record.class.name.underscore
+    dir = Rails.public_path.join("uploads", model_dir, "profile_image", record.id.to_s)
+    FileUtils.mkdir_p(dir)
+    created_carrierwave_dirs << dir
+    File.binwrite(dir.join(filename), bytes)
+    record.profile_image.purge if record.profile_image.attached?
+    record.update_columns(profile_image: filename)
+    record.reload
+  end
+
+  describe ".call" do
+    it "copies existing User and Organization CarrierWave profile pictures into Active Storage",
+       :aggregate_failures do
+      user = create(:user, profile_image: nil)
+      store_legacy_carrierwave_file(user, "legacy-user.png", png_bytes)
+
+      org = create(:organization)
+      store_legacy_carrierwave_file(org, "legacy-org.JPG", jpg_bytes)
+
+      expect(user.profile_image).not_to be_attached
+      expect(org.profile_image).not_to be_attached
+      expect(user.profile_image_url).to eq("/uploads/user/profile_image/#{user.id}/legacy-user.png")
+      expect(org.profile_image_url).to eq("/uploads/organization/profile_image/#{org.id}/legacy-org.JPG")
+
+      described_class.call
+
+      user.reload
+      org.reload
+
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image.download).to eq(png_bytes)
+      expect(user.profile_image.content_type).to eq("image/png")
+      expect(user.profile_image.blob).to be_analyzed
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+
+      expect(org.profile_image).to be_attached
+      expect(org.profile_image.download).to eq(jpg_bytes)
+      expect(org.profile_image.content_type).to eq("image/jpeg")
+      expect(org.profile_image.blob).to be_analyzed
+      expect(org.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+    end
+
+    it "leaves other models' CarrierWave uploads untouched", :aggregate_failures do
+      cover = fixture_file_upload("800x600.jpg", "image/jpeg")
+      tag_upload = fixture_file_upload("800x600.png", "image/png")
+      podcast_upload = fixture_file_upload("800x600.jpg", "image/jpeg")
+
+      org = create(:organization, cover_image: cover)
