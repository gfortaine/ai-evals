+++ b/config/initializers/active_storage.rb
@@ -0,0 +1,29 @@
+module ActiveStorageInitializer
+  def self.service_name
+    if Rails.env.test?
+      :test
+    elsif Rails.env.production? && ENV["FILE_STORAGE_LOCATION"] != "file"
+      if ENV["FOREM_CONTEXT"] == "forem_cloud" && ApplicationConfig["AWS_BUCKET_NAME"].present?
+        :forem_cloud
+      elsif ApplicationConfig["AWS_ID"].present? && ApplicationConfig["AWS_BUCKET_NAME"].present?
+        :fog
+      else
+        :local
+      end
+    else
+      :local
+    end
+  end
+
+  def self.initialize!
+    target = service_name
+    Rails.configuration.active_storage.service = target
+    return unless defined?(ActiveStorage::Blob) && ActiveStorage::Blob.services
+
+    ActiveStorage::Blob.service = ActiveStorage::Blob.services.fetch(target)
+  end
+end
+
+Rails.application.reloader.to_prepare do
+  ActiveStorageInitializer.initialize!
+end
