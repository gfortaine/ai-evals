@@ -0,0 +1,302 @@
+require "rails_helper"
+require "exifr/jpeg"
+
+RSpec.describe ProfileImageAttachable do
+  let(:jpg_upload) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+  let(:png_upload) { fixture_file_upload("800x600.png", "image/png") }
+  let(:webp_upload) { fixture_file_upload("800x600.webp", "image/webp") }
+  let(:pdf_upload) { fixture_file_upload("800x600.pdf", "application/pdf") }
+  let(:gps_upload) { fixture_file_upload("image_gps_data.jpg", "image/jpeg") }
+  let(:high_frame_gif) { fixture_file_upload("high_frame_count.gif", "image/gif") }
+  let(:bomb_image_path) { Rails.root.join("spec/support/fixtures/images/bad-image.jpg") }
+  let(:fake_jpg_upload) { fixture_file_upload("test_image.jpg", "image/jpeg") }
+
+  describe "new profile pictures on Active Storage" do
+    it "stores new User profile pictures in Active Storage without writing the CarrierWave column",
+       :aggregate_failures do
+      user = create(:user, profile_image: png_upload)
+
+      expect(user.profile_image).to be_attached
+      expect(user.read_attribute(:profile_image)).to be_nil
+      expect(user.profile_image.download).to eq(File.binread(png_upload.path))
+      expect(user.profile_image.filename.to_s).to match(/\A[0-9a-f-]{36}\.png\z/)
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+      expect(user.profile_image.url).to eq(user.profile_image_url)
+      expect(user.profile_image.to_s).to eq(user.profile_image_url)
+      expect(user.as_json["profile_image"]).to eq({ "url" => user.profile_image_url })
+    end
+
+    it "stores new Organization profile pictures in Active Storage while keeping cover_image on CarrierWave",
+       :aggregate_failures do
+      cover = fixture_file_upload("800x600.jpg", "image/jpeg")
+      org = create(:organization, profile_image: webp_upload, cover_image: cover)
+
+      expect(org.profile_image).to be_attached
+      expect(org.read_attribute(:profile_image)).to be_nil
+      expect(org.profile_image.download).to eq(File.binread(webp_upload.path))
+      expect(org.profile_image.filename.to_s).to match(/\A[0-9a-f-]{36}\.webp\z/)
+      expect(org.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+      expect(org.as_json["profile_image"]).to eq({ "url" => org.profile_image_url })
+      expect(org.cover_image).to be_a(CoverImageUploader)
+      expect(org.read_attribute(:cover_image)).to be_present
+    end
+
+    it "keeps other models' uploads on CarrierWave", :aggregate_failures do
+      tag = create(:tag, profile_image: jpg_upload)
+      podcast = create(:podcast, image: png_upload)
+
+      expect(tag.profile_image).to be_a(ProfileImageUploader)
+      expect(tag.read_attribute(:profile_image)).to be_present
+      expect(podcast.image).to be_a(ProfileImageUploader)
+      expect(podcast.read_attribute(:image)).to be_present
+    end
+
+    it "downloads and attaches remote_profile_image_url including extensionless OAuth avatar URLs",
+       :aggregate_failures do
+      png_bytes = Rails.root.join("spec/fixtures/files/800x600.png").binread
+      avatar_url = "https://avatars.example.com/u/12345?v=4"
+      stub_request(:get, avatar_url).to_return(status: 200, body: png_bytes, headers: { "Content-Type" => "image/png" })
+
+      user = create(:user, profile_image: nil)
+      user.remote_profile_image_url = avatar_url
+      user.save!
+
+      expect(user.remote_profile_image_url).to eq(avatar_url)
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image.download).to eq(png_bytes)
+      expect(user.profile_image.filename.to_s).to end_with(".png")
+    end
+
+    it "records a validation error when remote_profile_image_url fails to download" do
+      failing_url = "https://avatars.example.com/missing.png"
+      stub_request(:get, failing_url).to_return(status: 404, body: "Not Found")
+
+      user = build(:user, profile_image: nil)
+      user.remote_profile_image_url = failing_url
+
+      expect(user).not_to be_valid
+      expect(user.errors[:profile_image]).to be_present
+    end
+  end
+
+  describe "coexistence with existing CarrierWave profile pictures" do
+    it "continues serving existing CarrierWave User profile pictures unchanged", :aggregate_failures do
+      user = create(:user, profile_image: nil)
+      user.update_columns(profile_image: "existing-avatar.jpg")
+      user.reload
+
+      expect(user.profile_image).not_to be_attached
+      expect(user.profile_image).to be_present
+      expect(user.profile_image?).to be(true)
+      expect(user.profile_image_url).to eq("/uploads/user/profile_image/#{user.id}/existing-avatar.jpg")
+      expect(user.profile_image.url).to eq(user.profile_image_url)
+      expect(user.profile_image.to_s).to eq(user.profile_image_url)
+      expect(user.as_json["profile_image"]).to eq({ "url" => user.profile_image_url })
+
+      user.update!(name: "Updated Legacy User")
+      expect(user.reload.profile_image_url).to eq("/uploads/user/profile_image/#{user.id}/existing-avatar.jpg")
+    end
+
+    it "continues serving existing CarrierWave Organization profile pictures and allows non-image updates",
+       :aggregate_failures do
+      org = create(:organization)
+      org.profile_image.purge
+      org.update_columns(profile_image: "existing-org-logo.png")
+      org.reload
+
+      expect(org.profile_image).not_to be_attached
+      expect(org.profile_image).to be_present
+      expect(org.profile_image_url).to eq("/uploads/organization/profile_image/#{org.id}/existing-org-logo.png")
+
+      expect(org.update(summary: "Updated org summary")).to be(true)
+      expect(org.reload.profile_image_url).to eq("/uploads/organization/profile_image/#{org.id}/existing-org-logo.png")
+
+      org.assign_attributes(profile_image: "")
+      expect(org).not_to be_valid
+      expect(org.errors[:profile_image]).to include("can't be blank")
+    end
+
+    it "switches to Active Storage when an existing CarrierWave User or Organization uploads a new picture",
+       :aggregate_failures do
+      allow(Users::BustProfileImageCacheWorker).to receive(:perform_async)
+
+      user = create(:user, profile_image: nil)
+      user.update_columns(profile_image: "legacy-user.jpg")
+      user.reload
+
+      user.update!(profile_image: png_upload)
+      user.reload
+
+      expect(user.profile_image).to be_attached
+      expect(user.read_attribute(:profile_image)).to eq("legacy-user.jpg")
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+      expect(Users::BustProfileImageCacheWorker).to have_received(:perform_async).with(user.id)
+    end
+  end
+
+  describe "validations and EXIF stripping" do
+    it "rejects disallowed extensions, fake images, and oversized dimensions", :aggregate_failures do
+      user_pdf = build(:user, profile_image: pdf_upload)
+      expect(user_pdf).not_to be_valid
+      expect(user_pdf.errors[:profile_image].join).to include("allowed types")
+
+      user_fake = build(:user, profile_image: fake_jpg_upload)
+      expect(user_fake).not_to be_valid
+      expect(user_fake.errors[:profile_image]).to include(I18n.t("errors.messages.unsupported_image_type"))
+
+      bomb_file = Rack::Test::UploadedFile.new(bomb_image_path, "image/jpeg")
+      user_bomb = build(:user, profile_image: bomb_file)
+      expect(user_bomb).not_to be_valid
+      expect(user_bomb.errors[:profile_image]).to include(
+        I18n.t("errors.messages.pixel_dimensions_error", x_size: 4096, y_size: 4096),
+      )
+    end
+
+    context "when image processing is enabled" do
+      around do |example|
+        previous = described_class.enable_processing
+        described_class.enable_processing = true
+        example.run
+      ensure
+        described_class.enable_processing = previous
+      end
+
+      it "strips EXIF and GPS metadata before storing in Active Storage", :aggregate_failures do
+        expect(EXIFR::JPEG.new(gps_upload.path).exif?).to be(true)
+        expect(EXIFR::JPEG.new(gps_upload.path).gps).to be_present
+
+        user = create(:user, profile_image: gps_upload)
+        stored_jpeg = EXIFR::JPEG.new(StringIO.new(user.profile_image.download))
+
+        expect(stored_jpeg.exif?).to be(false)
+        expect(stored_jpeg.gps).to be_nil
+      end
+
+      it "rejects GIFs exceeding the maximum frame count" do
+        stub_const("BaseUploader::FRAME_MAX", 20)
+        user = build(:user, profile_image: high_frame_gif)
+
+        expect(user).not_to be_valid
+        expect(user.errors[:profile_image]).to include(
+          I18n.t("uploaders.base_uploader.too_many_frames", frame_max: BaseUploader::FRAME_MAX),
+        )
+      end
+    end
+  end
+
+  describe "edge cases" do
+    let(:png_upload) { fixture_file_upload("800x600.png", "image/png") }
+
+    it "updates cached_organization on published articles when an Organization uploads a new Active Storage image",
+       :aggregate_failures do
+      allow(Images::SocialImageWorker).to receive(:perform_async)
+
+      org = create(:organization)
+      org.profile_image.purge
+      org.update_columns(profile_image: "legacy-org.png")
+      org.reload
+
+      article = create(:article, organization: org, published: true)
+      expected_legacy_url = "/uploads/organization/profile_image/#{org.id}/legacy-org.png"
+      expect(article.cached_organization.profile_image_url).to eq(expected_legacy_url)
+
+      sidekiq_perform_enqueued_jobs do
+        org.update!(profile_image: png_upload)
+      end
+
+      org.reload
+      article.reload
+      expect(org.profile_image).to be_attached
+      expect(article.cached_organization.profile_image_url).to eq(org.profile_image_url)
+      expect(Images::SocialImageWorker).to have_received(:perform_async).with(org.id, "Organization")
+    end
+
+    it "purges Active Storage profile_image when Moderator::BanishUser banishes a user" do
+      admin = create(:user, :super_admin)
+      spammer = create(:user, profile_image: png_upload)
+      expect(spammer.profile_image).to be_attached
+
+      Moderator::BanishUser.call(admin: admin, user: spammer)
+
+      expect(spammer.reload.profile_image).not_to be_attached
