@@ -0,0 +1,120 @@
+require "rails_helper"
+require "active_storage/service/fog_service"
+
+RSpec.describe ActiveStorageInitializer do
+  describe ".service_name" do
+    it "returns :test in test environment" do
+      expect(described_class.service_name).to eq(:test)
+    end
+
+    context "when in production environment" do
+      before do
+        allow(Rails).to receive(:env).and_return(ActiveSupport::StringInquirer.new("production"))
+      end
+
+      it "returns :fog when AWS_ID and AWS_BUCKET_NAME are present" do
+        allow(ENV).to receive(:[]).and_call_original
+        allow(ENV).to receive(:[]).with("FILE_STORAGE_LOCATION").and_return(nil)
+        allow(ENV).to receive(:[]).with("FOREM_CONTEXT").and_return(nil)
+        allow(ApplicationConfig).to receive(:[]).with("AWS_ID").and_return("aws-id")
+        allow(ApplicationConfig).to receive(:[]).with("AWS_BUCKET_NAME").and_return("forem-bucket")
+
+        expect(described_class.service_name).to eq(:fog)
+      end
+
+      it "returns :forem_cloud when FOREM_CONTEXT is forem_cloud" do
+        allow(ENV).to receive(:[]).and_call_original
+        allow(ENV).to receive(:[]).with("FILE_STORAGE_LOCATION").and_return(nil)
+        allow(ENV).to receive(:[]).with("FOREM_CONTEXT").and_return("forem_cloud")
+        allow(ApplicationConfig).to receive(:[]).with("AWS_BUCKET_NAME").and_return("cloud-bucket")
+
+        expect(described_class.service_name).to eq(:forem_cloud)
+      end
+
+      it "returns :local when FILE_STORAGE_LOCATION is file" do
+        allow(ENV).to receive(:[]).and_call_original
+        allow(ENV).to receive(:[]).with("FILE_STORAGE_LOCATION").and_return("file")
+
+        expect(described_class.service_name).to eq(:local)
+      end
+
+      it "returns :local when AWS credentials are not configured" do
+        allow(ENV).to receive(:[]).and_call_original
+        allow(ENV).to receive(:[]).with("FILE_STORAGE_LOCATION").and_return(nil)
+        allow(ENV).to receive(:[]).with("FOREM_CONTEXT").and_return(nil)
+        allow(ApplicationConfig).to receive(:[]).with("AWS_ID").and_return(nil)
+
+        expect(described_class.service_name).to eq(:local)
+      end
+    end
+  end
+
+  describe ActiveStorage::Service::FogService do
+    let(:bucket_name) { "forem-as-test-bucket" }
+    let(:credentials) do
+      {
+        provider: "AWS",
+        aws_access_key_id: "mock-key",
+        aws_secret_access_key: "mock-secret",
+        region: "us-east-1"
+      }
+    end
+    let(:service) do
+      described_class.new(
+        bucket: bucket_name,
+        credentials: credentials,
+        public: true,
+        upload: { cache_control: "public, max-age=31536000" },
+      )
+    end
+
+    before do
+      Fog.mock!
+      Fog::Mock.reset
+      Fog::Storage.new(credentials).directories.create(key: bucket_name, public: true)
+    end
+
+    after do
+      Fog.unmock!
+    end
+
+    it "uploads, checks existence, downloads, streams, chunks, and deletes objects", :aggregate_failures do
+      payload = "hello active storage fog".b
+      checksum = OpenSSL::Digest::MD5.base64digest(payload)
+      key = "avatars/test-key"
+
+      expect(service.exist?(key)).to be(false)
+      service.upload(key, StringIO.new(payload), checksum: checksum, content_type: "image/png")
+      expect(service.exist?(key)).to be(true)
+      expect(service.download(key)).to eq(payload)
+      expect(service.download_chunk(key, 0...5)).to eq("hello".b)
+      expect(service.permanent_url(key)).to eq("https://#{bucket_name}.s3.amazonaws.com/#{key}")
+
+      chunks = +""
+      service.download(key) { |chunk| chunks << chunk }
+      expect(chunks).to eq(payload)
+
+      service.delete(key)
+      expect(service.exist?(key)).to be(false)
+      expect { service.download(key) }.to raise_error(ActiveStorage::FileNotFoundError)
+    end
+
+    it "raises IntegrityError when checksum does not match" do
+      expect do
+        service.upload("bad-key", StringIO.new("data"), checksum: "wrongchecksum==")
+      end.to raise_error(ActiveStorage::IntegrityError)
+    end
+
+    it "builds /remoteimages permanent URLs when asset_host_remote_images is enabled" do
+      allow(Settings::General).to receive(:app_domain).and_return("community.example.com")
+      cloud_service = described_class.new(
+        bucket: bucket_name,
+        credentials: credentials,
+        public: false,
+        asset_host_remote_images: true,
+      )
+
+      expect(cloud_service.permanent_url("k123")).to eq("https://community.example.com/remoteimages/k123")
+    end
+  end
+end
