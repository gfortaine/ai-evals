diff --git a/test/controllers/books/releases_controller_test.rb b/test/controllers/books/releases_controller_test.rb
new file mode 100644
index 0000000..b87c6ed
--- /dev/null
+++ b/test/controllers/books/releases_controller_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    sign_in :david
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "releasing a book replaces working title recap with released title as published" do
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    patch book_path(handbook), params: { book: { title: "Working Title" } }
+    patch book_path(manual), params: { book: { title: "Draft Manual" } }
+
+    patch book_release_path(handbook), params: { book: { title: "Official Handbook", subtitle: "Final Edition" } }
+    assert_redirected_to root_path
+
+    get root_path
+    assert_response :success
+    assert_select ".library__recents" do
+      assert_select "strong", text: "Official Handbook"
+      assert_select "strong", text: "Draft Manual"
+      assert_select "span", text: "Published"
+      assert_select "span", text: "Draft"
+      assert_select "strong", text: "Working Title", count: 0
+    end
+
+    get book_slug_path(handbook.reload)
+    assert_response :success
+    assert_in_body "Official Handbook"
+  end
+
+  test "renaming a book the ordinary way updates recently updated" do
+    book = books(:handbook)
+
+    patch book_path(book), params: { book: { title: "Renamed Handbook" } }
+    assert_redirected_to book_slug_path(book.reload)
+
+    get root_path
+    assert_response :success
+    assert_select ".library__recents" do
+      assert_select "strong", text: "Renamed Handbook"
+      assert_select "span", text: "Draft"
+    end
+  end
+
+  test "releasing an already published book redirects back to the book" do
+    book = books(:handbook)
+    book.update!(published: true)
+
+    patch book_release_path(book), params: { book: { title: "Should Not Change" } }
+    assert_redirected_to book_slug_path(book)
+    assert_equal "Handbook", book.reload.title
+  end
+
+  test "readers cannot release a book" do
+    sign_in :jz
+
+    patch book_release_path(books(:handbook)), params: { book: { title: "Unauthorized" } }
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/book/recap_test.rb b/test/models/book/recap_test.rb
new file mode 100644
index 0000000..c711499
--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "updating a book writes its recap" do
+    book = books(:handbook)
+    book.update!(title: "Updated Handbook")
+
+    assert_equal({ title: "Updated Handbook", published: false }, book.cached_recap)
+  end
+
+  test "releasing a book caches the released title and published state" do
+    book = books(:handbook)
+    book.update!(title: "Working Title", subtitle: "Draft Subtitle")
+
+    assert Book.finalize_release(book.id, title: "Released Handbook")
+
+    book.reload
+    assert_equal "Released Handbook", book.title
+    assert_equal "Draft Subtitle", book.subtitle
+    assert book.published?
+    assert_equal({ title: "Released Handbook", published: true }, book.cached_recap)
+  end
+
+  test "releasing a book without changing its title still caches it as published" do
+    book = books(:handbook)
+
+    assert Book.finalize_release(book.id, title: book.title)
+
+    assert_equal({ title: "Handbook", published: true }, book.cached_recap)
+  end
+
+  test "releasing an already published book returns false without changing recap" do
+    book = books(:handbook)
+    book.update!(title: "Published Handbook", published: true)
+
+    assert_not Book.finalize_release(book.id, title: "Another Title")
+
+    assert_equal "Published Handbook", book.reload.title
+    assert_equal({ title: "Published Handbook", published: true }, book.cached_recap)
+  end
+
+  test "recaps stay per book without overwriting another book's recap" do
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    handbook.update!(title: "Team Handbook")
+    assert Book.finalize_release(manual.id, title: "Released Manual")
+
+    assert_equal({ title: "Team Handbook", published: false }, handbook.cached_recap)
+    assert_equal({ title: "Released Manual", published: true }, manual.cached_recap)
+  end
+
+  test "multi-instance updates in a single transaction still cache committed state" do
+    book = books(:handbook)
+    marker = ReleaseMarker.for(book.id)
+
+    Book.transaction do
+      book.update!(title: "Fresh Title")
+      marker.publish!
+    end
+
+    assert_equal({ title: "Fresh Title", published: true }, book.cached_recap)
+  end
+
+  test "rolled back release does not overwrite existing recap" do
+    book = books(:handbook)
+    book.update!(title: "Working Title")
+
+    assert_raises(ActiveRecord::NotNullViolation) do
+      Book.finalize_release(book.id, title: nil)
+    end
+
+    assert_equal({ title: "Working Title", published: false }, book.cached_recap)
+  end
+
+  test "recaps expire on the configured schedule" do
+    original_expires_in = Rails.application.config.x.recap.expires_in
+    Rails.application.config.x.recap.expires_in = 30.minutes
+
+    book = books(:handbook)
+    assert Book.finalize_release(book.id, title: "Timed Release")
+
+    travel 29.minutes
+    assert_equal({ title: "Timed Release", published: true }, book.cached_recap)
+
+    travel 2.minutes
+    assert_nil book.cached_recap
+  ensure
+    Rails.application.config.x.recap.expires_in = original_expires_in
+  end
+end
