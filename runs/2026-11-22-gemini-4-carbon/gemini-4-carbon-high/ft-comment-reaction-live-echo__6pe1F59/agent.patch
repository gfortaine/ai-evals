new file mode 100644
index 0000000..5d80790
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,50 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_delete_controller.js b/app/javascript/controllers/reaction_delete_controller.js
new file mode 100644
index 0000000..daac944
--- /dev/null
+++ b/app/javascript/controllers/reaction_delete_controller.js
@@ -0,0 +1,51 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "button" ]
+  static values = { reacterId: String }
+  static classes = [ "expanded", "deleteable", "deleting" ]
+
+  connect() {
+    if (this.canDelete) {
+      this.element.classList.add(this.deleteableClass)
+      this.element.setAttribute("role", "button")
+      this.element.setAttribute("tabindex", "0")
+    } else if (this.hasButtonTarget) {
+      this.buttonTarget.disabled = true
+    }
+  }
+
+  reveal(event) {
+    if (!this.canDelete) return
+    if (this.hasButtonTarget && this.buttonTarget.contains(event.target)) return
+
+    event.preventDefault()
+    const expanded = this.element.classList.toggle(this.expandedClass)
+    if (expanded && this.hasButtonTarget) {
+      this.buttonTarget.focus()
+    }
+  }
+
+  perform() {
+    if (this.canDelete) {
+      this.element.classList.add(this.deletingClass)
+    }
+  }
+
+  hide(event) {
+    if (this.element.classList.contains(this.expandedClass)) {
+      event?.preventDefault()
+      this.element.classList.remove(this.expandedClass)
+    }
+  }
+
+  hideOnClickOutside(event) {
+    if (!this.element.contains(event.target)) {
+      this.element.classList.remove(this.expandedClass)
+    }
+  }
+
+  get canDelete() {
+    return Boolean(window.Current?.user && window.Current.user.id === this.reacterIdValue)
+  }
+}
diff --git a/app/javascript/controllers/reaction_emoji_controller.js b/app/javascript/controllers/reaction_emoji_controller.js
new file mode 100644
index 0000000..43000e3
--- /dev/null
+++ b/app/javascript/controllers/reaction_emoji_controller.js
@@ -0,0 +1,37 @@
+import { Controller } from "@hotwired/stimulus"
+
+const MAX_LENGTH = 16
+
+export default class extends Controller {
+  static targets = [ "input" ]
+
+  connect() {
+    if (this.hasInputTarget) {
+      this.inputTarget.removeAttribute("maxlength")
+    }
+  }
+
+  insert(event) {
+    const emoji = event.currentTarget.dataset.emoji
+    const input = this.inputTarget
+    const start = input.selectionStart ?? input.value.length
+    const end = input.selectionEnd ?? input.value.length
+    const nextValue = input.value.slice(0, start) + emoji + input.value.slice(end)
+
+    if (Array.from(nextValue).length <= MAX_LENGTH) {
+      input.value = nextValue
+      const cursor = start + emoji.length
+      input.setSelectionRange(cursor, cursor)
+      input.dispatchEvent(new Event("input", { bubbles: true }))
+    }
+
+    input.focus()
+  }
+
+  enforceMaxLength() {
+    const codePoints = Array.from(this.inputTarget.value)
+    if (codePoints.length > MAX_LENGTH) {
+      this.inputTarget.value = codePoints.slice(0, MAX_LENGTH).join("")
+    }
+  }
+}
