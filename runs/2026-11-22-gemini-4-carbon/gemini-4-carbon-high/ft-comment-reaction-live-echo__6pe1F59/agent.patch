+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,158 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "index renders reaction trigger frame" do
+    get card_comment_reactions_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :reacting)} a.reactions__trigger"
+  end
+
+  test "index as JSON" do
+    reaction = @comment.reactions.create!(reacter: users(:david), content: "Great 👍")
+
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal 1, @response.parsed_body.length
+
+    item = @response.parsed_body.first
+    assert_equal reaction.id, item["id"]
+    assert_equal "Great 👍", item["content"]
+    assert_equal users(:david).id, item.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(@card, @comment, reaction), item["url"]
+  end
+
+  test "new renders reaction form inside turbo frame" do
+    get new_card_comment_reaction_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :reacting)} form.reaction.reaction__form"
+    assert_select "input.reaction__input[maxlength='16']"
+    assert_select ".reaction__submit-btn"
+    assert_select ".reaction__cancel-btn"
+  end
+
+  test "create as turbo stream" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal "🎉", reaction.content
+    assert_select "turbo-stream[action='append'][target='#{dom_id(@comment, :reaction_list)}']"
+    assert_select "turbo-stream[action='replace'][target='#{dom_id(@comment, :reacting)}']"
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Great 👍", @comment.reactions.last.content
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "🚀" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "🚀", @comment.reactions.last.content
+  end
+
+  test "create rejects content longer than 16 characters or blank" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :json
+    end
+    assert_response :unprocessable_entity
+
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "   " } }, as: :json
+    end
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy own reaction as turbo stream" do
+    reaction = @comment.reactions.create!(reacter: users(:kevin), content: "👍")
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action='remove'][target='#{dom_id(reaction)}']"
+  end
+
+  test "destroy own reaction as JSON" do
+    reaction = @comment.reactions.create!(reacter: users(:kevin), content: "👍")
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "cannot destroy another user's reaction" do
+    reaction = @comment.reactions.create!(reacter: users(:david), content: "👍")
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+    assert_response :forbidden
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "cannot access reactions on inaccessible card" do
+    sign_out_and_sign_in_as_another_account_user
+
+    get card_comment_reactions_path(@card, @comment), as: :json
+    assert_response :not_found
+  end
+
+  test "comment JSON includes reactions_url" do
+    get card_comment_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal card_comment_reactions_url(@card, @comment), @response.parsed_body["reactions_url"]
+  end
+
+  test "adding a reaction invalidates the cached comment partial" do
+    with_actionview_partial_caching do
+      get card_path(@card)
+      assert_response :success
+      assert_select "##{dom_id(@comment)} .reaction", count: 0
+
+      travel 1.second do
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Cached?" } }, as: :turbo_stream
+      end
+
+      get card_path(@card)
+      assert_response :success
+      assert_select "##{dom_id(@comment)} .reaction span.txt-small", text: "Cached?"
+    end
+  end
+
+  private
+    def sign_out_and_sign_in_as_another_account_user
+      Current.set(session: sessions(:david)) do
+        other_board = Board.create!(name: "Private Board", creator: users(:david), all_access: false)
+        @card = other_board.cards.create!(title: "Secret", creator: users(:david), status: :published)
+        @comment = @card.comments.create!(creator: users(:david), body: "Secret comment")
+      end
+    end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..0bb8112
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "creating a reaction defaults account and reacter" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal @comment.account, reaction.account
+    assert_equal "👍", reaction.content
+  end
+
+  test "validates content presence and 16 character maximum" do
+    assert_not @comment.reactions.build(content: nil).valid?
+    assert_not @comment.reactions.build(content: "").valid?
+    assert_not @comment.reactions.build(content: "   ").valid?
+
+    assert @comment.reactions.build(content: "a" * 16).valid?
+    assert_not @comment.reactions.build(content: "a" * 17).valid?
+
+    assert @comment.reactions.build(content: "🎉" * 16).valid?
+    assert_not @comment.reactions.build(content: "🎉" * 17).valid?
+  end
+
+  test "all_emoji?" do
+    assert @comment.reactions.build(content: "👍").all_emoji?
+    assert @comment.reactions.build(content: "👍🎉🔥").all_emoji?
+    assert_not @comment.reactions.build(content: "Great 👍").all_emoji?
+    assert_not @comment.reactions.build(content: "Agreed!").all_emoji?
+  end
+
+  test "same user can leave multiple reactions on the same comment in chronological order" do
+    first = @comment.reactions.create!(content: "👍")
+    second = @comment.reactions.create!(content: "Ship it!")
+
+    assert_equal [ first, second ], @comment.reload.reactions.to_a
+  end
+
+  test "destroying comment destroys its reactions" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_difference -> { Reaction.count }, -1 do
+      @comment.destroy!
+    end
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroying user destroys their reactions" do
+    user = users(:kevin)
+    reaction = @comment.reactions.create!(reacter: user, content: "👍")
+
+    assert_difference -> { Reaction.count }, -1 do
+      user.destroy!
+    end
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "creating and destroying reaction touches comment and card" do
+    travel 5.minutes do
+      assert_changes -> { @comment.reload.updated_at } do
+        assert_changes -> { @comment.card.reload.updated_at } do
+          @comment.reactions.create!(content: "👍")
+        end
+      end
+    end
+
+    reaction = @comment.reactions.last
+
+    travel 10.minutes do
+      assert_changes -> { @comment.reload.updated_at } do
+        reaction.destroy!
+      end
+    end
+  end
+
+  test "broadcasts append on create and remove on destroy to card activity stream" do
+    assert_turbo_stream_broadcasts [ @comment.card, :activity ], count: 1 do
+      @reaction = @comment.reactions.create!(content: "🔥")
+    end
+
+    assert_turbo_stream_broadcasts [ @comment.card, :activity ], count: 1 do
+      @reaction.destroy!
+    end
+  end
+
+  test "account export and import preserves comment reactions" do
+    reaction = @comment.reactions.create!(reacter: users(:kevin), content: "Great 👍")
+
+    source_account = accounts("37s")
+    exporter = users(:david)
+    identity = exporter.identity
+
+    export = Account::Export.create!(account: source_account, user: exporter)
+    export.build
+
+    export_tempfile = Tempfile.new([ "export", ".zip" ])
+    export.file.open { |f| FileUtils.cp(f.path, export_tempfile.path) }
+
+    source_account.destroy!
+
+    target_account = Account.create_with_owner(account: { name: "Import Test" }, owner: { identity: identity, name: exporter.name })
+    import = Account::Import.create!(identity: identity, account: target_account)
+    Current.set(account: target_account) do
+      import.file.attach(io: File.open(export_tempfile.path), filename: "export.zip", content_type: "application/zip")
+    end
+
+    import.check
+    import.process
+
+    assert import.completed?
+    imported_reaction = Reaction.find(reaction.id)
+    assert_equal target_account, imported_reaction.account
+    assert_equal "Great 👍", imported_reaction.content
+    assert_equal @comment.id, imported_reaction.reactable_id
+    assert_equal users(:kevin).id, imported_reaction.reacter_id
+  ensure
+    export_tempfile&.close
+    export_tempfile&.unlink
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..43f435d
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,164 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "adding, canceling, picking emoji, and removing reactions on a comment" do
+    @comment.reactions.create!(reacter: users(:david), content: "Agreed!")
+
+    sign_in_as users(:kevin)
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      # Existing reaction from David is shown with David's avatar/identity, not deleteable by Kevin
+      david_reaction = find(".reaction", text: "Agreed!")
+      assert_selector "##{david_reaction[:id]} .avatar[aria-label='#{users(:david).name}']"
+      assert_no_selector "##{david_reaction[:id]}.reaction--deleteable"
+      david_reaction.click
+      assert_no_selector "##{david_reaction[:id]} .reaction__delete"
+
+      # Add reaction trigger uses boost-color.svg
+      trigger = find(".reactions__trigger")
+      img_loaded = page.evaluate_script("arguments[0].querySelector('img').naturalWidth > 0", trigger)
+      assert img_loaded, "Expected boost-color.svg image to load inside .reactions__trigger"
+
+      # Clicking trigger turns button into small input with confirm and cancel
+      trigger.click
+      assert_no_selector ".reactions__trigger"
+      assert_selector "form.reaction__form"
+
+      # Check avatar inside form is circular/square (not stretched)
+      avatar_dims = page.evaluate_script(<<~JS, find("form.reaction__form .reaction__avatar .avatar"))
+        (el => { const r = el.getBoundingClientRect(); return { w: Math.round(r.width), h: Math.round(r.height) }; })(arguments[0])
+      JS
+      assert_in_delta avatar_dims["w"], avatar_dims["h"], 2
+
+      # Cancel via button restores trigger without adding reaction
+      find(".reaction__cancel-btn").click
+      assert_no_selector "form.reaction__form"
+      assert_selector ".reactions__trigger"
+
+      # Cancel via Escape restores trigger without navigating away from card
+      find(".reactions__trigger").click
+      find("input.reaction__input").send_keys("Draft", :escape)
+      assert_no_selector "form.reaction__form"
+      assert_selector ".reactions__trigger"
+      assert_current_path card_path(@card)
+
+      # Confirming text reaction puts it in strip, removes input, restores trigger
+      find(".reactions__trigger").click
+      find("input.reaction__input").fill_in(with: "Ship it!")
+      find(".reaction__submit-btn").click
+
+      assert_no_selector "form.reaction__form"
+      assert_selector ".reactions__trigger"
+      own_reaction = find(".reaction.reaction--deleteable", text: "Ship it!")
+      assert_selector "##{own_reaction[:id]} .avatar[aria-label='#{users(:kevin).name}']"
+      assert_selector "##{own_reaction[:id]} span.txt-small:not(.txt-medium)", text: "Ship it!"
+
+      # Button is back for the next one: pick emoji from menu & confirm
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      find(".reaction__emoji-list button[data-emoji='🎉']").click
+      assert_equal "🎉", find("input.reaction__input").value
+      find(".reaction__submit-btn").click
+
+      emoji_reaction = find(".reaction.reaction--deleteable", text: "🎉")
+      assert_selector "##{emoji_reaction[:id]} span.txt-small.txt-medium", text: "🎉"
+
+      # 16 character max enforced for both text and emojis
+      find(".reactions__trigger").click
+      find("input.reaction__input").fill_in(with: "12345678901234567890")
+      assert_equal "1234567890123456", find("input.reaction__input").value
+
+      find("input.reaction__input").fill_in(with: "👍" * 18)
+      assert_equal "👍" * 16, find("input.reaction__input").value
+      find(".reaction__cancel-btn").click
+
+      # Clicking own reaction reveals way to remove it; clicking remove deletes it
+      assert_no_selector "##{own_reaction[:id]} .reaction__delete"
+      own_reaction.click
+      assert_selector "##{own_reaction[:id]} .reaction__delete"
+      find("##{own_reaction[:id]} .reaction__delete").click
+
+      assert_no_selector ".reaction", text: "Ship it!"
+      assert_selector ".reaction", text: "🎉"
+    end
+  end
+
+  test "everyone looking at the card sees reactions land and disappear without reloading" do
+    using_session(:david) do
+      sign_in_as users(:david)
+      visit card_url(@card)
+      wait_for_cable_subscriptions
+    end
+
+    using_session(:kevin) do
+      sign_in_as users(:kevin)
+      visit card_url(@card)
+      wait_for_cable_subscriptions
+
+      within "##{dom_id(@comment)}" do
+        find(".reactions__trigger").click
+        find("input.reaction__input").fill_in(with: "🚀 LGTM")
+        find(".reaction__submit-btn").click
+        assert_selector ".reaction", text: "🚀 LGTM"
+      end
+    end
+
+    using_session(:david) do
+      within "##{dom_id(@comment)}" do
+        kevin_reaction = find(".reaction", text: "🚀 LGTM", wait: 5)
+        assert_selector "##{kevin_reaction[:id]} .avatar[aria-label='#{users(:kevin).name}']"
+        assert_no_selector "##{kevin_reaction[:id]}.reaction--deleteable"
+      end
+    end
+
+    using_session(:kevin) do
+      within "##{dom_id(@comment)}" do
+        reaction = find(".reaction.reaction--deleteable", text: "🚀 LGTM")
+        reaction.click
+        find(".reaction__delete").click
+        assert_no_selector ".reaction", text: "🚀 LGTM"
+      end
+    end
+
+    using_session(:david) do
+      within "##{dom_id(@comment)}" do
+        assert_no_selector ".reaction", text: "🚀 LGTM", wait: 5
+      end
+    end
+  end
+
+  test "a broadcast refresh preserves a reaction input in progress" do
+    sign_in_as users(:kevin)
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    within "##{dom_id(@comment)}" do
+      find(".reactions__trigger").click
+      find("input.reaction__input").fill_in(with: "Typing...")
+    end
+
+    Current.set(account: accounts("37s"), session: sessions(:david)) do
+      @card.update!(title: "Updated card title")
+    end
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_selector "h1", text: "Updated card title", wait: 5
+    within "##{dom_id(@comment)}" do
+      assert_equal "Typing...", find("input.reaction__input").value
+    end
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
