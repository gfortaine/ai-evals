+
+    <div class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <button type="button" class="btn btn--circle borderless reaction__menu-btn" data-action="dialog#toggle">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Quick reactions</span>
+      </button>
+
+      <dialog class="popup panel fill-white shadow reaction__popup" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <button type="button" class="btn btn--plain" data-emoji="<%= emoji %>" data-action="reaction-emoji#insert dialog#close" title="<%= label %>">
