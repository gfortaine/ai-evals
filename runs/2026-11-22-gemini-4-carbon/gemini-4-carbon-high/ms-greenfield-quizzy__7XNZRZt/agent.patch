--- /dev/null
+++ b/app/models/question.rb
@@ -0,0 +1,50 @@
+class Question < ApplicationRecord
+  belongs_to :quiz, inverse_of: :questions
+  has_many :options, -> { order(:position, :id) }, dependent: :destroy, inverse_of: :question
+
+  scope :ordered, -> { order(:position, :id) }
+  scope :active, -> { where(active: true) }
+
+  validates :body, presence: true
+
+  def save_with_option_rows(body:, active:, raw_rows:)
+    self.body = body
+    self.active = active
+
+    errors.clear
+    errors.add(:base, "Question can't be blank") if self.body.to_s.strip.empty?
+
+    non_empty_rows = raw_rows.filter_map do |row|
+      cleaned_text = row[:text].to_s.strip
+      next if cleaned_text.empty?
+      { text: cleaned_text, correct: ActiveModel::Type::Boolean.new.cast(row[:correct]) }
+    end
+
+    if non_empty_rows.size < 2
+      errors.add(:base, "Add at least two options")
+    end
+
+    if non_empty_rows.none? { |r| r[:correct] }
+      errors.add(:base, "Mark at least one option as correct")
+    end
+
+    return false if errors.any?
+
+    transaction do
+      if new_record?
+        self.position = (quiz.questions.maximum(:position) || -1) + 1
+      end
+      save!
+      options.destroy_all
+      non_empty_rows.each_with_index do |row, idx|
+        options.create!(
+          text: row[:text],
+          correct: row[:correct],
+          position: idx
+        )
+      end
+    end
+
+    true
+  end
+end
diff --git a/app/models/quiz.rb b/app/models/quiz.rb
new file mode 100644
index 0000000..162fe29
--- /dev/null
+++ b/app/models/quiz.rb
@@ -0,0 +1,61 @@
+class Quiz < ApplicationRecord
+  has_many :questions, -> { order(:position, :id) }, dependent: :destroy, inverse_of: :quiz
+  has_many :active_questions, -> { where(active: true).order(:position, :id) }, class_name: "Question"
+  has_many :games, dependent: :destroy, inverse_of: :quiz
+
+  validates :title, presence: true
+  validates :winners_count, numericality: { only_integer: true, greater_than_or_equal_to: 1 }
+  validates :timer_minutes, numericality: { only_integer: true, greater_than_or_equal_to: 0 }
+  validates :timer_seconds, numericality: { only_integer: true, greater_than_or_equal_to: 0, less_than: 60 }
+
+  def timer_duration_seconds
+    (timer_minutes.to_i * 60) + timer_seconds.to_i
+  end
+
+  def timer_enabled?
+    timer_duration_seconds > 0
+  end
+
+  def reorder_question!(question, direction)
+    transaction do
+      ordered_ids = questions.reorder(:position, :id).pluck(:id)
+      idx = ordered_ids.index(question.id)
+      return unless idx
+
+      target_idx = case direction
+      when :up then idx - 1
+      when :down then idx + 1
+      else return
+      end
+
+      return if target_idx < 0 || target_idx >= ordered_ids.length
+
+      ordered_ids[idx], ordered_ids[target_idx] = ordered_ids[target_idx], ordered_ids[idx]
+      ordered_ids.each_with_index do |id, new_pos|
+        questions.where(id: id).update_all(position: new_pos)
+      end
+    end
+  end
+
+  def as_export_json
+    {
+      "title" => title,
+      "questions" => questions.ordered.includes(:options).map do |question|
+        {
+          "text" => question.body,
+          "active" => question.active?,
+          "options" => question.options.sort_by { |o| [ o.position, o.id ] }.map do |option|
+            {
+              "text" => option.text,
+              "correct" => option.correct?
+            }
+          end
+        }
+      end
+    }
+  end
+
+  def to_export_json
+    JSON.pretty_generate(as_export_json)
+  end
+end
diff --git a/app/models/quiz/importer.rb b/app/models/quiz/importer.rb
new file mode 100644
index 0000000..46aa813
--- /dev/null
+++ b/app/models/quiz/importer.rb
@@ -0,0 +1,157 @@
+class Quiz
+  class Importer
+    Result = Data.define(:quiz, :errors) do
+      def success?
+        errors.empty? && quiz.present?
+      end
+    end
+
+    def self.call(raw_json)
+      new(raw_json).call
+    end
+
+    def initialize(raw_json)
+      @raw_json = raw_json
+    end
+
+    def call
+      return failure("Invalid JSON") unless @raw_json.is_a?(String) && !@raw_json.strip.empty?
+
+      data = JSON.parse(@raw_json)
+      return failure("Quiz JSON must be a JSON object") unless data.is_a?(Hash)
+
+      errors = []
+      title = validate_title(data, errors)
+      normalized_questions = validate_questions(data, errors)
+
+      return Result.new(quiz: nil, errors: errors) if errors.any?
+
+      quiz = Quiz.transaction do
+        created_quiz = Quiz.create!(title: title)
+        normalized_questions.each_with_index do |q_attrs, q_pos|
+          question = created_quiz.questions.create!(
+            body: q_attrs[:text],
+            active: q_attrs[:active],
+            position: q_pos
+          )
+          q_attrs[:options].each_with_index do |opt_attrs, opt_pos|
+            question.options.create!(
+              text: opt_attrs[:text],
+              correct: opt_attrs[:correct],
+              position: opt_pos
+            )
+          end
+        end
+        created_quiz
+      end
+
+      Result.new(quiz: quiz, errors: [])
+    rescue JSON::JSONError
+      failure("Invalid JSON")
+    rescue ActiveRecord::RecordInvalid => e
+      Result.new(quiz: nil, errors: e.record.errors.full_messages)
+    end
+
+    private
+
+    def failure(message)
+      Result.new(quiz: nil, errors: [ message ])
+    end
+
+    def validate_title(data, errors)
+      raw_title = data["title"]
+      if raw_title.nil? || (raw_title.is_a?(String) && raw_title.strip.empty?)
+        errors << "Title can't be blank"
+        nil
+      elsif !raw_title.is_a?(String)
+        errors << "Title must be a string"
+        nil
+      else
+        raw_title
+      end
+    end
+
+    def validate_questions(data, errors)
+      raw_questions = data["questions"]
+      unless raw_questions.is_a?(Array)
+        errors << "Questions must be an array"
+        return []
+      end
+
+      raw_questions.each_with_index.filter_map do |q_data, q_idx|
+        validate_question(q_data, q_idx + 1, errors)
+      end
+    end
+
+    def validate_question(q_data, q_num, errors)
+      unless q_data.is_a?(Hash)
+        errors << "Question #{q_num}: Must be a JSON object"
+        return nil
+      end
+
+      raw_text = q_data["text"]
+      if raw_text.nil? || (raw_text.is_a?(String) && raw_text.strip.empty?)
+        errors << "Question #{q_num}: Question can't be blank"
+      elsif !raw_text.is_a?(String)
+        errors << "Question #{q_num}: Question text must be a string"
+      end
+
+      active = true
+      if q_data.key?("active")
+        if q_data["active"] == true || q_data["active"] == false
+          active = q_data["active"]
+        else
+          errors << "Question #{q_num}: Active must be true or false"
+        end
+      end
+
+      options = validate_options(q_data["options"], q_num, errors)
+
+      { text: raw_text, active: active, options: options }
+    end
+
+    def validate_options(raw_options, q_num, errors)
+      unless raw_options.is_a?(Array)
+        errors << "Question #{q_num}: Options must be an array"
+        return []
+      end
+
+      normalized = []
+      raw_options.each_with_index do |opt_data, opt_idx|
+        opt_num = opt_idx + 1
+        unless opt_data.is_a?(Hash)
+          errors << "Question #{q_num}, option #{opt_num}: Must be a JSON object"
+          next
+        end
+
+        opt_text = opt_data["text"]
+        if opt_text.nil? || (opt_text.is_a?(String) && opt_text.strip.empty?)
+          errors << "Question #{q_num}, option #{opt_num}: Option text can't be blank"
+        elsif !opt_text.is_a?(String)
+          errors << "Question #{q_num}, option #{opt_num}: Option text must be a string"
+        end
+
+        opt_correct = false
+        if opt_data.key?("correct")
+          if opt_data["correct"] == true || opt_data["correct"] == false
+            opt_correct = opt_data["correct"]
+          else
+            errors << "Question #{q_num}, option #{opt_num}: Correct must be true or false"
+          end
+        end
+
+        normalized << { text: opt_text, correct: opt_correct }
+      end
+
+      if raw_options.size < 2
+        errors << "Question #{q_num}: Add at least two options"
+      end
+
+      if normalized.none? { |o| o[:correct] }
+        errors << "Question #{q_num}: Mark at least one option as correct"
+      end
+
+      normalized
+    end
+  end
+end
