+  <%= form_with model: [ :moderate, quiz, question ] do |f| %>
+    <div class="field">
+      <%= f.label :body, "Question", class: "field-label" %>
+      <%= f.text_area :body, class: "input", rows: 3 %>
+    </div>
+
+    <div class="field">
+      <span class="field-label">Options</span>
+      <span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span>
+    </div>
+
+    <div class="option-rows" data-option-rows-target="list">
+      <% option_rows.each_with_index do |row, index| %>
+        <% number = index + 1 %>
+        <div class="option-row">
+          <label class="visually-hidden" for="option_<%= number %>_text">Option <%= number %></label>
+          <input
+            class="input"
+            type="text"
+            id="option_<%= number %>_text"
+            name="question[option_rows][<%= index %>][text]"
+            placeholder="Option <%= number %>"
+            value="<%= row[:text] %>"
+          >
+
+          <label class="visually-hidden" for="option_<%= number %>_correct">Option <%= number %> is correct</label>
+          <span class="checkbox" data-action="click->option-rows#toggleCheckbox">
+            <input
+              type="checkbox"
+              id="option_<%= number %>_correct"
+              name="question[option_rows][<%= index %>][correct]"
+              value="1"
+              <%= "checked" if row[:correct] %>
+            >
+            Correct
+          </span>
+        </div>
+      <% end %>
+    </div>
+
+    <div class="buttons" style="margin-bottom: 28px">
+      <button
+        type="submit"
+        name="add_option"
+        value="1"
+        class="btn btn--ghost btn--sm"
+        data-action="click->option-rows#add"
+      >Add option</button>
+    </div>
+
+    <div class="field">
+      <label class="checkbox">
+        <%= f.check_box :active %>
+        Active
+      </label>
+      <span class="field-hint">Only active questions are played.</span>
+    </div>
+
+    <div class="buttons">
+      <button type="submit" class="btn btn--pink">Save question</button>
+      <%= link_to "Cancel", moderate_quiz_path(quiz), class: "btn btn--ghost" %>
+    </div>
+  <% end %>
+</div>
