index 0000000..6bb8e66
--- /dev/null
+++ b/test/models/timer_test.rb
@@ -0,0 +1,156 @@
+require "test_helper"
+
+class TimerTest < ActiveSupport::TestCase
+  setup do
+    GameTimerScheduler.reset!
+    @quiz = Quiz.create!(title: "Timed Talk Quiz")
+    @q1 = @quiz.questions.create!(body: "First question?", active: true, position: 0)
+    @q1_right = @q1.options.create!(text: "Right 1", correct: true, position: 0)
+    @q1_wrong = @q1.options.create!(text: "Wrong 1", correct: false, position: 1)
+
+    @q2 = @quiz.questions.create!(body: "Second question?", active: true, position: 1)
+    @q2_right = @q2.options.create!(text: "Right 2", correct: true, position: 0)
+    @q2_wrong = @q2.options.create!(text: "Wrong 2", correct: false, position: 1)
+  end
+
+  teardown do
+    GameTimerScheduler.reset!
+  end
+
+  test "quiz timer_minutes and timer_seconds default to 0 (no timer) and validate properly" do
+    fresh = Quiz.new(title: "Default Timer")
+    assert_equal 0, fresh.timer_minutes
+    assert_equal 0, fresh.timer_seconds
+    assert_equal 0, fresh.timer_duration_seconds
+    assert_not fresh.timer_enabled?
+
+    assert_equal 0, @quiz.timer_minutes
+    assert_equal 0, @quiz.timer_seconds
+    assert_not @quiz.timer_enabled?
+
+    imported = Quiz::Importer.call('{"title":"Imported","questions":[]}').quiz
+    assert_equal 0, imported.timer_minutes
+    assert_equal 0, imported.timer_seconds
+    assert_not imported.timer_enabled?
+
+    [ [ 0, 0 ], [ 0, 5 ], [ 1, 30 ], [ 0, 59 ], [ 15, 0 ], [ 120, 45 ] ].each do |mins, secs|
+      @quiz.timer_minutes = mins
+      @quiz.timer_seconds = secs
+      assert @quiz.valid?, "Expected (#{mins}, #{secs}) to be valid, got: #{@quiz.errors.full_messages}"
+    end
+
+    @quiz.timer_minutes = 1
+    @quiz.timer_seconds = 30
+    assert_equal 90, @quiz.timer_duration_seconds
+    assert @quiz.timer_enabled?
+
+    [ -1, -60, nil, "", "abc", 1.5 ].each do |bad_min|
+      @quiz.timer_minutes = bad_min
+      @quiz.timer_seconds = 0
+      assert_not @quiz.valid?, "Expected timer_minutes=#{bad_min.inspect} to be invalid"
+      assert @quiz.errors.full_messages.any? { |m| m.include?("Timer minutes") },
+             "Expected error to mention 'Timer minutes', got: #{@quiz.errors.full_messages.inspect}"
+    end
+
+    [ -1, 60, 90, nil, "", "abc", 1.5 ].each do |bad_sec|
+      @quiz.timer_minutes = 0
+      @quiz.timer_seconds = bad_sec
+      assert_not @quiz.valid?, "Expected timer_seconds=#{bad_sec.inspect} to be invalid"
+      assert @quiz.errors.full_messages.any? { |m| m.include?("Timer seconds") },
+             "Expected error to mention 'Timer seconds', got: #{@quiz.errors.full_messages.inspect}"
+    end
+  end
+
+  test "timer settings are omitted from quiz export format" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    exported_raw = @quiz.to_export_json
+    parsed = JSON.parse(exported_raw)
+
+    assert_equal [ "title", "questions" ], parsed.keys
+    refute_includes exported_raw, "timer"
+    refute_includes exported_raw, "1:30"
+  end
+
+  test "Game.format_timer_ms formats countdown as M:SS using ceiling seconds" do
+    assert_equal "1:30", Game.format_timer_ms(90_000)
+    assert_equal "1:30", Game.format_timer_ms(89_950)
+    assert_equal "1:30", Game.format_timer_ms(89_001)
+    assert_equal "1:29", Game.format_timer_ms(89_000)
+    assert_equal "1:00", Game.format_timer_ms(60_000)
+    assert_equal "0:59", Game.format_timer_ms(59_000)
+    assert_equal "0:05", Game.format_timer_ms(5_000)
+    assert_equal "0:05", Game.format_timer_ms(4_100)
+    assert_equal "0:01", Game.format_timer_ms(1_000)
+    assert_equal "0:01", Game.format_timer_ms(1)
+    assert_equal "0:00", Game.format_timer_ms(0)
+    assert_equal "0:00", Game.format_timer_ms(-500)
+    assert_equal "10:05", Game.format_timer_ms(605_000)
+  end
+
+  test "0 minutes and 0 seconds means no timer: question never auto-expires and stage_assigns omits timer" do
+    game = @quiz.games.create!(question_ids: [ @q1.id, @q2.id ])
+    t0 = Time.zone.parse("2026-11-10 12:00:00")
+
+    travel_to(t0) do
+      game.start!
+      assert game.question_open?
+      assert_not game.question_timer?
+      assert_nil game.timer_remaining_ms
+      assert_nil game.stage_assigns[:timer_remaining_ms]
+    end
+
+    travel_to(t0 + 2.hours) do
+      assert_not game.sync_timer!
+      assert game.reload.question_open?
+    end
+  end
+
+  test "with timer: countdown tracks server open timestamp, expires at 0:00, blocks late answers, allows early finish, and resets on next question" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    game = @quiz.games.create!(question_ids: [ @q1.id, @q2.id ])
+    alice = game.players.create!(name: "Alice")
+    bob = game.players.create!(name: "Bob")
+
+    t0 = Time.zone.parse("2026-11-10 12:00:00")
+
+    travel_to(t0) do
+      game.start!
+      assert game.question_open?
+      assert_equal 90, game.question_duration_seconds
+      assert game.question_timer?
+      assert_equal 90_000, game.timer_remaining_ms
+      assert_equal "1:30", Game.format_timer_ms(game.stage_assigns[:timer_remaining_ms])
+    end
+
+    # 25 seconds later: 1:05 remaining (reloading stage computes 65_000 ms, never restarting)
+    travel_to(t0 + 25.seconds) do
+      assert_not game.sync_timer!
+      assert_equal 65_000, game.timer_remaining_ms
+      assert_equal "1:05", Game.format_timer_ms(game.stage_assigns[:timer_remaining_ms])
+      assert game.submit_answer!(player: alice, question_id: @q1.id, option_id: @q1_right.id)
+    end
+
+    # At 90 seconds (0:00): late answer is rejected and question finishes automatically
+    travel_to(t0 + 90.seconds) do
+      assert_nil game.submit_answer!(player: bob, question_id: @q1.id, option_id: @q1_right.id)
+      assert game.reload.question_closed?
+      assert_nil game.stage_assigns[:timer_remaining_ms]
+      assert_equal 1, game.answers.where(question_id: @q1.id).count
+    end
+
+    # Next question opens Q2 with a fresh 1:30 timer, and moderator can finish early
+    t2 = t0 + 120.seconds
+    travel_to(t2) do
+      game.next_question!
+      assert game.question_open?
+      assert_equal 2, game.question_number
+      assert_equal 90_000, game.timer_remaining_ms
+    end
+
+    travel_to(t2 + 10.seconds) do
+      assert game.finish_question!
+      assert game.question_closed?
+      assert_nil game.stage_assigns[:timer_remaining_ms]
+    end
+  end
+end
diff --git a/test/system/export_and_import_test.rb b/test/system/export_and_import_test.rb
new file mode 100644
index 0000000..33b0978
--- /dev/null
+++ b/test/system/export_and_import_test.rb
@@ -0,0 +1,226 @@
+require "application_system_test_case"
+
+class ExportAndImportTest < ApplicationSystemTestCase
+  setup do
+    @orig_user = ENV["QUIZZY_MODERATOR_USERNAME"]
+    @orig_pass = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "conf2026"
+  end
+
+  teardown do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = @orig_user
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = @orig_pass
+  end
+
+  def login_as_moderator!
+    auth = ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "conf2026")
+    page.driver.browser.headers.set("Authorization" => auth)
+  end
+
+  test "exporting a quiz as JSON in a single <pre> and re-importing creates a new duplicate-titled quiz with preserved order" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+    q_first = quiz.questions.create!(
+      body: "Which HTTP status code means \"Too Many Requests\"?",
+      active: true,
+      position: 0
+    )
+    q_first.options.create!(text: "418", correct: false, position: 0)
+    q_first.options.create!(text: "429", correct: true, position: 1)
+
+    q_second = quiz.questions.create!(
+      body: "Which HTML tags are <void> & self-closing?",
+      active: false,
+      position: 1
+    )
+    q_second.options.create!(text: "<br>", correct: true, position: 0)
+    q_second.options.create!(text: "<div>", correct: false, position: 1)
+    q_second.options.create!(text: "<img>", correct: true, position: 2)
+
+    login_as_moderator!
+    visit moderate_quiz_path(quiz)
+
+    # Reorder so q_second comes first, q_first comes second
+    within(find("li", text: "Too Many Requests")) do
+      click_button "Move down"
+    end
+
+    # Quiz page has the "Export" link
+    click_link "Export"
+
+    # Opens page with a single <pre> containing exact JSON
+    pre_elements = all("pre")
+    assert_equal 1, pre_elements.size
+
+    exported_text = pre_elements.first.text
+    parsed = JSON.parse(exported_text)
+
+    assert_equal({
+      "title" => "Frontend Fest 2026",
+      "questions" => [
+        {
+          "text" => "Which HTML tags are <void> & self-closing?",
+          "active" => false,
+          "options" => [
+            { "text" => "<br>", "correct" => true },
+            { "text" => "<div>", "correct" => false },
+            { "text" => "<img>", "correct" => true }
+          ]
+        },
+        {
+          "text" => "Which HTTP status code means \"Too Many Requests\"?",
+          "active" => true,
+          "options" => [
+            { "text" => "418", "correct" => false },
+            { "text" => "429", "correct" => true }
+          ]
+        }
+      ]
+    }, parsed)
+
+    # Visit /moderate and click "Import quiz" button
+    visit "/moderate"
+    click_button "Import quiz"
+
+    textarea = find_field("Quiz JSON")
+    assert_equal "textarea", textarea.tag_name
+
+    fill_in "Quiz JSON", with: exported_text
+    click_button "Import"
+
+    # Always creates a new quiz even if same title exists, and opens its page
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+    imported_quiz = Quiz.order(:id).last
+    assert_not_equal quiz.id, imported_quiz.id
+    assert_current_path moderate_quiz_path(imported_quiz)
+
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_text "1 of 2 questions active"
+
+    items = all("li")
+    assert_equal 2, items.size
+    assert_includes items[0].text, "Which HTML tags are <void> & self-closing?"
+    assert_includes items[1].text, "Which HTTP status code means \"Too Many Requests\"?"
+
+    within(items[0]) do
+      assert_unchecked_field "Active"
+      assert_selector ".is-correct", text: "<br>"
+      assert_no_selector ".is-correct", text: "<div>"
+      assert_selector ".is-correct", text: "<img>"
+    end
+
+    within(items[1]) do
+      assert_checked_field "Active"
+      assert_no_selector ".is-correct", text: "418"
+      assert_selector ".is-correct", text: "429"
+    end
+
+    # Both quizzes appear in their own list items on /moderate
+    visit "/moderate"
+    assert_equal 2, all("li", text: "Frontend Fest 2026").size
+  end
+
+  test "importing optional active and correct fields uses defaults and re-export writes both explicitly" do
+    login_as_moderator!
+    visit "/moderate"
+    click_button "Import quiz"
+
+    minimal_json = <<~JSON
+      {
+        "title": "Minimal Defaults Quiz",
+        "questions": [
+          {
+            "text": "Is Ruby object-oriented?",
+            "options": [
+              {"text": "No"},
+              {"text": "Yes", "correct": true}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    fill_in "Quiz JSON", with: minimal_json
+    click_button "Import"
+
+    assert_selector "h1", text: "Minimal Defaults Quiz"
+    assert_text "1 of 1 question active"
+    within(find("li", text: "Is Ruby object-oriented?")) do
+      assert_checked_field "Active"
+      assert_no_selector ".is-correct", text: "No"
+      assert_selector ".is-correct", text: "Yes"
+    end
+
+    click_link "Export"
+    re_exported = JSON.parse(find("pre").text)
+    assert_equal({
+      "title" => "Minimal Defaults Quiz",
+      "questions" => [
+        {
+          "text" => "Is Ruby object-oriented?",
+          "active" => true,
+          "options" => [
+            { "text" => "No", "correct" => false },
+            { "text" => "Yes", "correct" => true }
+          ]
+        }
+      ]
+    }, re_exported)
+  end
+
+  test "invalid JSON or rule violations show an error, preserve textarea input, and import nothing" do
+    login_as_moderator!
+    visit "/moderate"
+    click_button "Import quiz"
+
+    # 1. Malformed JSON
+    fill_in "Quiz JSON", with: "{ broken json"
+    click_button "Import"
+
+    assert_selector ".errors", text: "Invalid JSON"
+    assert_field "Quiz JSON", with: "{ broken json"
+    assert_equal 0, Quiz.count
+
+    # 2. First question valid, second question breaks a rule (no correct option) -> atomic rollback
+    partial_invalid_json = <<~JSON.strip
+      {
+        "title": "Atomic Check",
+        "questions": [
+          {
+            "text": "Valid first question?",
+            "options": [
+              {"text": "Right", "correct": true},
+              {"text": "Wrong", "correct": false}
+            ]
+          },
+          {
+            "text": "Broken second question?",
+            "options": [
+              {"text": "Wrong 1", "correct": false},
+              {"text": "Wrong 2"}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    fill_in "Quiz JSON", with: partial_invalid_json
+    click_button "Import"
+
+    assert_selector ".errors", text: "Mark at least one option as correct"
+    assert_field "Quiz JSON", with: partial_invalid_json
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+    assert_equal 0, Option.count
+
+    # 3. Fix the JSON in place and submit -> succeeds!
+    fixed_json = partial_invalid_json.sub('"Wrong 2"', '"Right 2", "correct": true')
+    fill_in "Quiz JSON", with: fixed_json
+    click_button "Import"
+
+    assert_equal 1, Quiz.count
+    assert_equal 2, Question.count
+    assert_equal 4, Option.count
+    assert_selector "h1", text: "Atomic Check"
+  end
+end
