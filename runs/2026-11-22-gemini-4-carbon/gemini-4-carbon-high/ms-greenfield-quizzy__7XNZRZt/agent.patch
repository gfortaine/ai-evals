+require "application_system_test_case"
+
+class LiveGameTest < ApplicationSystemTestCase
+  setup do
+    @orig_user = ENV["QUIZZY_MODERATOR_USERNAME"]
+    @orig_pass = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "conf2026"
+    GamePresence.reset!
+  end
+
+  teardown do
+    GamePresence.reset!
+    ENV["QUIZZY_MODERATOR_USERNAME"] = @orig_user
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = @orig_pass
+  end
+
+  def login_as_moderator!
+    auth = ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "conf2026")
+    page.driver.browser.headers.set("Authorization" => auth)
+  end
+
+  test "full live game across moderator big screen and multiple player phones without page reloads" do
+    quiz = Quiz.create!(title: "RailsConf Live 2026")
+
+    # Q0: Inactive -> must be skipped!
+    q_inactive = quiz.questions.create!(body: "Inactive Draft Question?", active: false, position: 0)
+    q_inactive.options.create!(text: "Draft A", correct: true, position: 0)
+    q_inactive.options.create!(text: "Draft B", correct: false, position: 1)
+
+    # Q1 (Active #1): Single correct option
+    q1 = quiz.questions.create!(body: "Which status code means Too Many Requests?", active: true, position: 1)
+    q1.options.create!(text: "418", correct: false, position: 0)
+    q1.options.create!(text: "429", correct: true, position: 1)
+    q1.options.create!(text: "503", correct: false, position: 2)
+
+    # Q2 (Active #2): Multiple correct options
+    q2 = quiz.questions.create!(body: "Pick a valid JavaScript primitive:", active: true, position: 2)
+    q2.options.create!(text: "Array", correct: false, position: 0)
+    q2.options.create!(text: "Symbol", correct: true, position: 1)
+    q2.options.create!(text: "BigInt", correct: true, position: 2)
+
+    # Q3 (Active #3 - Last): Single correct option
+    q3 = quiz.questions.create!(body: "Which database backs Quizzy?", active: true, position: 3)
+    q3.options.create!(text: "SQLite", correct: true, position: 0)
+    q3.options.create!(text: "MongoDB", correct: false, position: 1)
+
+    join_url = nil
+
+    # 1. Moderator starts a game from the quiz page
+    using_session(:moderator) do
+      login_as_moderator!
+      visit moderate_quiz_path(quiz)
+
+      click_button "Start a game"
+
+      # Stays in moderator area
+      assert_match(%r{\A/moderate/}, current_path)
+      assert_text "RailsConf Live 2026"
+      assert_text "Players: 0"
+      assert_button "Start"
+
+      # Extract plain-text join link and verify QR code SVG matches the exact same link
+      url_text = find(".lobby__url").text.strip
+      assert_match(%r{\Ahttps?://[^/]+/play/[A-Z0-9]+\z}, url_text)
+      join_url = url_text
+
+      expected_qr_path = Nokogiri::XML(ApplicationController.helpers.qr_code_svg(join_url)).at_css("path")["d"]
+      rendered_qr_path = find(".qr svg path", visible: :all)["d"]
+      assert_equal expected_qr_path, rendered_qr_path
+
+      # Set marker to prove zero page reloads on big screen throughout the entire game
+      page.execute_script("window.__moderatorNoReload = true")
+    end
+
+    # 2. Alice opens join link on phone (before joining, moderator still sees Players: 0)
+    using_session(:alice) do
+      visit join_url
+      assert_field "Your name"
+      assert_button "Join"
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 0"
+    end
+
+    # Alice joins -> sees "Hi, Alice!" and moderator counter updates live to "Players: 1"
+    using_session(:alice) do
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+      page.execute_script("window.__aliceNoReload = true")
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 1"
+    end
+
+    # 3. Bob joins -> sees "Hi, Bob!" and moderator counter updates live to "Players: 2"
+    using_session(:bob) do
+      visit join_url
+      fill_in "Your name", with: "Bob"
+      click_button "Join"
+      assert_text "Hi, Bob!"
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 2"
+    end
+
+    # 4. Bob leaves page -> counter drops live to "Players: 1"; Bob reopens join link -> remembered as Bob, counter returns to "Players: 2"
+    using_session(:bob) do
+      visit "about:blank"
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 1"
+    end
+
+    using_session(:bob) do
+      visit join_url
+      assert_text "Hi, Bob!"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 2"
+    end
+
+    # 5. Moderator clicks "Start" -> Question 1 of 3 (inactive question skipped!)
+    using_session(:moderator) do
+      click_button "Start"
+      assert_text "Question 1 of 3"
+      assert_text "Which status code means Too Many Requests?"
+      assert_no_text "Inactive Draft Question?"
+      assert_selector "li.stage-option", count: 3
+      assert_no_text "Correct"
+      assert_text "Answers: 0 / 2"
+      assert_button "Finish"
+    end
+
+    # Alice & Bob phones automatically follow without reload!
+    using_session(:alice) do
+      assert_text "Which status code means Too Many Requests?"
+      assert_button "418"
+      assert_button "429"
+      assert_button "503"
+
+      # Verify correct answer is NOT anywhere in page source before question closes
+      refute_match(/correct/i, page.html)
+
+      # Alice picks 418 first -> marked "Your answer"
+      click_button "418"
+      within(find("button", text: "418")) do
+        assert_text "Your answer"
+      end
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 1 / 2"
+    end
+
+    # Alice changes her answer to 429 before question closes -> "Your answer" moves to 429, counter stays 1 / 2
+    using_session(:alice) do
+      click_button "429"
+      within(find("button", text: "429")) do
+        assert_text "Your answer"
+      end
+      within(find("button", text: "418")) do
+        assert_no_text "Your answer"
+      end
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 1 / 2"
+    end
+
+    # Carol joins mid-game while Question 1 is open -> denominator updates live to 1 / 3!
+    using_session(:carol) do
+      visit join_url
+      fill_in "Your name", with: "Carol"
+      click_button "Join"
+      assert_text "Which status code means Too Many Requests?"
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 1 / 3"
+    end
+
+    # Bob answers wrong (503) -> Answers: 2 / 3; Carol does not answer
+    using_session(:bob) do
+      click_button "503"
+      within(find("button", text: "503")) do
+        assert_text "Your answer"
+      end
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 2 / 3"
+    end
+
+    # 6. Moderator clicks "Finish" on Question 1 -> shows counts & "Correct" on big screen; Correct! / Wrong! / No answer on phones
+    using_session(:moderator) do
+      click_button "Finish"
+
+      within(find("li.stage-option", text: "418")) do
+        assert_no_text "Correct"
+        assert_selector ".stage-option__count", text: "0"
+      end
+      within(find("li.stage-option", text: "429")) do
+        assert_text "Correct"
+        assert_selector ".stage-option__count", text: "1"
+      end
+      within(find("li.stage-option", text: "503")) do
+        assert_no_text "Correct"
+        assert_selector ".stage-option__count", text: "1"
+      end
+
+      assert_button "Next"
+      assert_no_button "End quiz"
+    end
+
+    using_session(:alice) do
+      assert_text "Correct!"
+    end
+
+    using_session(:bob) do
+      assert_text "Wrong!"
+    end
+
+    using_session(:carol) do
+      assert_text "No answer"
+    end
+
+    # 7. Moderator clicks "Next" -> Question 2 of 3 (with 2 correct options)
+    using_session(:moderator) do
+      click_button "Next"
+      assert_text "Question 2 of 3"
+      assert_text "Pick a valid JavaScript primitive:"
+      assert_text "Answers: 0 / 3"
+    end
+
+    using_session(:alice) do
+      assert_text "Pick a valid JavaScript primitive:"
+      click_button "Symbol"
+    end
+
+    using_session(:bob) do
+      assert_text "Pick a valid JavaScript primitive:"
+      click_button "BigInt"
+    end
+
+    using_session(:carol) do
+      assert_text "Pick a valid JavaScript primitive:"
+      click_button "Array"
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 3 / 3"
+      click_button "Finish"
+
+      within(find("li.stage-option", text: "Array")) do
+        assert_no_text "Correct"
+        assert_selector ".stage-option__count", text: "1"
+      end
+      within(find("li.stage-option", text: "Symbol")) do
+        assert_text "Correct"
+        assert_selector ".stage-option__count", text: "1"
+      end
+      within(find("li.stage-option", text: "BigInt")) do
+        assert_text "Correct"
+        assert_selector ".stage-option__count", text: "1"
+      end
+
+      assert_button "Next"
+    end
+
+    using_session(:alice) { assert_text "Correct!" }
+    using_session(:bob) { assert_text "Correct!" }
+    using_session(:carol) { assert_text "Wrong!" }
+
+    # 8. Moderator clicks "Next" -> Question 3 of 3 (last question -> Finish shows "End quiz")
+    using_session(:moderator) do
+      click_button "Next"
+      assert_text "Question 3 of 3"
+      assert_text "Which database backs Quizzy?"
+    end
+
+    # Open an unjoined browser tab before quiz ends
+    using_session(:unjoined_visitor) do
+      visit join_url
+      assert_field "Your name"
+      assert_button "Join"
+    end
+
+    using_session(:alice) do
+      assert_text "Which database backs Quizzy?"
+      click_button "SQLite"
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 1 / 3"
+      click_button "Finish"
+      assert_no_button "Next"
+      assert_button "End quiz"
+
+      click_button "End quiz"
+      assert_text "The quiz is over"
+      assert_equal true, page.evaluate_script("window.__moderatorNoReload === true")
+    end
+
+    using_session(:alice) do
+      assert_text "The quiz is over"
+      assert_equal true, page.evaluate_script("window.__aliceNoReload === true")
+    end
+
+    using_session(:bob) { assert_text "The quiz is over" }
+    using_session(:carol) { assert_text "The quiz is over" }
+
+    # Unjoined visitor tab live-updated to "The quiz is over" and cannot join
+    using_session(:unjoined_visitor) do
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+
+    # Brand new visitor opening join link after end sees "The quiz is over" and cannot join
+    using_session(:after_end_visitor) do
+      visit join_url
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+
+    # 9. Playing the same quiz a second time creates a completely independent game
+    second_join_url = nil
+    using_session(:moderator) do
+      click_link "← Back to quiz"
+      assert_current_path moderate_quiz_path(quiz)
+
+      click_button "Start a game"
+      assert_text "Players: 0"
+      second_join_url = find(".lobby__url").text.strip
+      assert_not_equal join_url, second_join_url
+    end
+
+    # Alice's browser opening the new game's link asks for Your name (independent game!),
+    # while opening the old game's link still shows "The quiz is over"
+    using_session(:alice) do
+      visit second_join_url
+      assert_field "Your name"
+      assert_button "Join"
+
+      visit join_url
+      assert_text "The quiz is over"
+    end
+  end
+
+  test "single-question quiz, mid-question player disconnect, reopening mid-question, joining during closed question, and special characters" do
+    quiz = Quiz.create!(title: "Lightning <Talk> & Q&A")
+    q1 = quiz.questions.create!(body: "Is <script>alert(1)</script> escaped?", active: true, position: 0)
+    q1.options.create!(text: "Yes & Safe", correct: true, position: 0)
+    q1.options.create!(text: "No <unsafe>", correct: false, position: 1)
+
+    join_url = nil
+
+    using_session(:moderator) do
