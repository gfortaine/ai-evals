@@ -0,0 +1,60 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["list"]
+
+  add(event) {
+    event.preventDefault()
+
+    const index = this.listTarget.querySelectorAll(".option-row").length
+    const number = index + 1
+
+    const row = document.createElement("div")
+    row.className = "option-row"
+
+    const textLabel = document.createElement("label")
+    textLabel.className = "visually-hidden"
+    textLabel.htmlFor = `option_${number}_text`
+    textLabel.textContent = `Option ${number}`
+
+    const textInput = document.createElement("input")
+    textInput.className = "input"
+    textInput.type = "text"
+    textInput.id = `option_${number}_text`
+    textInput.name = `question[option_rows][${index}][text]`
+    textInput.placeholder = `Option ${number}`
+
+    const correctLabel = document.createElement("label")
+    correctLabel.className = "visually-hidden"
+    correctLabel.htmlFor = `option_${number}_correct`
+    correctLabel.textContent = `Option ${number} is correct`
+
+    const checkboxWrap = document.createElement("span")
+    checkboxWrap.className = "checkbox"
+    checkboxWrap.dataset.action = "click->option-rows#toggleCheckbox"
+
+    const checkboxInput = document.createElement("input")
+    checkboxInput.type = "checkbox"
+    checkboxInput.id = `option_${number}_correct`
+    checkboxInput.name = `question[option_rows][${index}][correct]`
+    checkboxInput.value = "1"
+
+    checkboxWrap.appendChild(checkboxInput)
+    checkboxWrap.appendChild(document.createTextNode(" Correct"))
+
+    row.appendChild(textLabel)
+    row.appendChild(textInput)
+    row.appendChild(correctLabel)
+    row.appendChild(checkboxWrap)
+
+    this.listTarget.appendChild(row)
+    textInput.focus()
+  }
+
+  toggleCheckbox(event) {
+    if (event.target.tagName !== "INPUT") {
+      const input = event.currentTarget.querySelector("input[type='checkbox']")
+      if (input) input.click()
+    }
+  }
+}
diff --git a/app/javascript/controllers/play_controller.js b/app/javascript/controllers/play_controller.js
new file mode 100644
index 0000000..b36f239
--- /dev/null
+++ b/app/javascript/controllers/play_controller.js
@@ -0,0 +1,308 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["stage", "optionButton"]
+  static values = {
+    code: String,
+    playerToken: String,
+    stateVersion: Number,
+    status: String,
+    stateUrl: String,
+    frameUrl: String,
+    leaveUrl: String
+  }
+
+  connect() {
+    this.currentVersion = this.stateVersionValue
+    this.currentStatus = this.statusValue
+    this.wsConnected = false
+    this.refreshInFlight = false
+    this.pendingRefresh = false
+    this.answerAbortController = null
+    this.pollAbortController = null
+
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      {
+        channel: "PlayChannel",
+        code: this.codeValue,
+        player_token: this.playerTokenValue
+      },
+      {
+        connected: () => {
+          this.wsConnected = true
+          this.pollState()
+        },
+        disconnected: () => {
+          this.wsConnected = false
+        },
+        received: (data) => {
+          this.handlePayload(data)
+        }
+      }
+    )
+
+    this.boundVisibility = () => {
+      if (document.visibilityState === "visible") {
+        this.pollState()
+      }
+    }
+    document.addEventListener("visibilitychange", this.boundVisibility)
+
+    this.boundPageHide = () => {
+      this.notifyLeave()
+    }
+    window.addEventListener("pagehide", this.boundPageHide)
+
+    this.pollTimer = setInterval(() => this.pollState(), 1500)
+  }
+
+  disconnect() {
+    if (this.pollTimer) clearInterval(this.pollTimer)
+    if (this.boundVisibility) {
+      document.removeEventListener("visibilitychange", this.boundVisibility)
+    }
+    if (this.boundPageHide) {
+      window.removeEventListener("pagehide", this.boundPageHide)
+    }
+    if (this.pollAbortController) {
+      this.pollAbortController.abort()
+      this.pollAbortController = null
+    }
+    if (this.answerAbortController) {
+      this.answerAbortController.abort()
+      this.answerAbortController = null
+    }
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  notifyLeave() {
+    if (this.pollAbortController) {
+      this.pollAbortController.abort()
+      this.pollAbortController = null
+    }
+    if (this.playerTokenValue && this.leaveUrlValue && navigator.sendBeacon) {
+      const formData = new FormData()
+      const csrf = this.csrfToken()
+      if (csrf) formData.append("authenticity_token", csrf)
+      navigator.sendBeacon(this.leaveUrlValue, formData)
+    }
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  handlePayload(data) {
+    if (!data || typeof data.state_version !== "number") return
+
+    if (!this.playerTokenValue) {
+      if (data.status === "ended" && this.currentStatus !== "ended") {
+        this.refreshStage()
+      } else if (data.state_version > this.currentVersion) {
+        this.currentVersion = data.state_version
+        if (data.status) this.currentStatus = data.status
+      }
+      return
+    }
+
+    if (data.state_version > this.currentVersion) {
+      if (this.answerAbortController) {
+        this.answerAbortController.abort()
+        this.answerAbortController = null
+      }
+      if (typeof data.open_html === "string" && data.status === "question_open") {
+        this.applyStageHtml(data.open_html, data.state_version, data.status)
+        return
+      }
+      this.refreshStage()
+    }
+  }
+
+  applyStageHtml(html, version, status) {
+    if (!this.hasStageTarget) return
+
+    this.stageTarget.innerHTML = html
+    const csrf = this.csrfToken()
+    if (csrf) {
+      this.stageTarget.querySelectorAll("input[name='authenticity_token']").forEach((el) => {
+        el.value = csrf
+      })
+    }
+    this.currentVersion = version
+    if (status) {
+      this.currentStatus = status
+    }
+  }
+
+  withWsParam(url) {
+    if (!this.wsConnected) return url
+    return url.includes("?") ? `${url}&ws=1` : `${url}?ws=1`
+  }
+
+  async pollState() {
+    if (!this.stateUrlValue) return
+
+    if (this.pollAbortController) {
+      this.pollAbortController.abort()
+    }
+    const controller = new AbortController()
+    this.pollAbortController = controller
+
+    try {
+      const response = await fetch(this.withWsParam(this.stateUrlValue), {
+        credentials: "same-origin",
+        cache: "no-store",
+        headers: { Accept: "application/json" },
+        signal: controller.signal
+      })
+      if (!response.ok) return
+      const data = await response.json()
+      this.handlePayload(data)
+    } catch (_err) {
+      // Ignore abort or transient network hiccups on crowded Wi-Fi
+    } finally {
+      if (this.pollAbortController === controller) {
+        this.pollAbortController = null
+      }
+    }
+  }
+
+  async refreshStage() {
+    if (!this.hasStageTarget) return
+    if (this.refreshInFlight) {
+      this.pendingRefresh = true
+      return
+    }
+
+    this.refreshInFlight = true
+    try {
+      const response = await fetch(this.withWsParam(this.frameUrlValue), {
+        credentials: "same-origin",
+        cache: "no-store",
+        headers: { Accept: "text/html" }
+      })
+      if (!response.ok) return
+
+      const html = await response.text()
+      const doc = new DOMParser().parseFromString(html, "text/html")
+      const incomingRoot = doc.querySelector("[data-state-version]")
+      if (!incomingRoot) return
+
+      const incomingVersion = parseInt(incomingRoot.dataset.stateVersion, 10)
+      if (!Number.isNaN(incomingVersion) && incomingVersion <= this.currentVersion && this.playerTokenValue) {
+        return
+      }
+
+      this.stageTarget.innerHTML = html
+      if (!Number.isNaN(incomingVersion)) {
+        this.currentVersion = incomingVersion
+      }
+      if (incomingRoot.dataset.status) {
+        this.currentStatus = incomingRoot.dataset.status
+      }
+    } catch (_err) {
+      // Will retry on next signal/poll
+    } finally {
+      this.refreshInFlight = false
+      if (this.pendingRefresh) {
+        this.pendingRefresh = false
+        this.refreshStage()
+      }
+    }
+  }
+
+  async submitAnswer(event) {
+    event.preventDefault()
+
+    const form = event.currentTarget
+    const clickedButton = form.querySelector("[data-play-target='optionButton']")
+    if (!clickedButton) return
+
+    this.markPickedButton(clickedButton)
+
+    if (this.answerAbortController) {
+      this.answerAbortController.abort()
+    }
+    const controller = new AbortController()
+    this.answerAbortController = controller
+
+    const sendAttempt = async () => {
+      const headers = { Accept: "application/json" }
+      const csrf = this.csrfToken()
+      if (csrf) headers["X-CSRF-Token"] = csrf
+
+      return fetch(form.action, {
+        method: "POST",
+        body: new FormData(form),
+        credentials: "same-origin",
+        headers,
+        signal: controller.signal
+      })
+    }
+
+    try {
+      let response
+      try {
+        response = await sendAttempt()
+      } catch (err) {
+        if (err.name === "AbortError") return
+        await new Promise((resolve) => setTimeout(resolve, 200))
+        if (controller.signal.aborted) return
+        response = await sendAttempt()
+      }
+
+      if (!response.ok) {
+        this.refreshStage()
+        return
+      }
+
+      const data = await response.json()
+      if (typeof data.state_version === "number" && data.state_version > this.currentVersion) {
+        this.refreshStage()
+      } else if (data.status && data.status !== "question_open") {
+        this.refreshStage()
+      }
+    } catch (err) {
+      if (err.name !== "AbortError") {
+        // Poll will reconcile if needed
+      }
+    } finally {
+      if (this.answerAbortController === controller) {
+        this.answerAbortController = null
+      }
+    }
+  }
+
+  markPickedButton(selectedButton) {
+    this.optionButtonTargets.forEach((btn) => {
+      btn.classList.remove("is-picked")
+      btn.setAttribute("aria-pressed", "false")
+      btn.querySelectorAll(".play-option__mark").forEach((el) => el.remove())
+    })
+
+    selectedButton.classList.add("is-picked")
+    selectedButton.setAttribute("aria-pressed", "true")
+    const mark = document.createElement("span")
+    mark.className = "play-option__mark"
+    mark.textContent = "Your answer"
+    selectedButton.appendChild(document.createTextNode(" "))
+    selectedButton.appendChild(mark)
+  }
+
+  csrfToken() {
+    return document.querySelector("meta[name='csrf-token']")?.getAttribute("content") || ""
+  }
+}
diff --git a/app/javascript/controllers/stage_controller.js b/app/javascript/controllers/stage_controller.js
new file mode 100644
index 0000000..4ae8852
--- /dev/null
+++ b/app/javascript/controllers/stage_controller.js
@@ -0,0 +1,285 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["stageContent", "playersCount", "answersCount", "timer"]
+  static values = {
+    gameId: Number,
+    stageToken: String,
+    stateVersion: Number,
+    stateUrl: String,
+    stageUrl: String
+  }
+
+  connect() {
+    this.currentVersion = this.stateVersionValue
+    this.refreshInFlight = false
+    this.pendingRefresh = false
+    this.submitting = false
+    this.pendingPayload = null
+    this.syncedTimerEl = null
+    this.timerDeadlinePerf = null
+
+    this.syncTimer()
+
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      {
+        channel: "StageChannel",
+        game_id: this.gameIdValue,
+        stage_token: this.stageTokenValue
+      },
+      {
+        connected: () => {
+          this.pollState()
+        },
+        received: (data) => {
+          this.handlePayload(data)
+        }
+      }
+    )
+
+    this.boundVisibility = () => {
+      if (document.visibilityState === "visible") {
+        this.pollState()
+      }
+    }
+    document.addEventListener("visibilitychange", this.boundVisibility)
+
+    this.pollTimer = setInterval(() => this.pollState(), 1500)
+  }
+
+  disconnect() {
+    this.clearTimer()
+    if (this.pollTimer) clearInterval(this.pollTimer)
+    if (this.boundVisibility) {
+      document.removeEventListener("visibilitychange", this.boundVisibility)
+    }
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  onSubmitStart() {
+    this.submitting = true
+  }
+
+  onSubmitEnd() {
+    this.submitting = false
+    if (this.pendingPayload && this.pendingPayload.state_version > this.currentVersion) {
+      const payload = this.pendingPayload
+      this.pendingPayload = null
+      this.handlePayload(payload)
+    } else {
+      this.pendingPayload = null
+    }
+  }
+
+  onFrameLoad() {
+    if (this.hasStageContentTarget) {
+      const ver = parseInt(this.stageContentTarget.dataset.stateVersion, 10)
+      if (!Number.isNaN(ver) && ver >= this.currentVersion) {
+        this.currentVersion = ver
+      }
+    }
+    this.syncTimer()
+  }
+
+  handlePayload(data) {
+    if (!data) return
+
+    const incomingVersion = typeof data.state_version === "number" ? data.state_version : null
+    if (incomingVersion !== null && incomingVersion > this.currentVersion) {
+      if (this.submitting) {
+        if (!this.pendingPayload || incomingVersion > this.pendingPayload.state_version) {
+          this.pendingPayload = data
+        }
+        return
+      }
+      if (typeof data.stage_html === "string") {
+        this.applyStageHtml(data.stage_html, incomingVersion)
+        return
+      }
+      this.refreshStage()
+      return
+    }
+
+    if (incomingVersion === null || incomingVersion === this.currentVersion) {
+      if (typeof data.online_players === "number") {
+        this.updateCounts(data.online_players, data.answered_players ?? 0)
+      }
+    }
+  }
+
+  applyStageHtml(html, version) {
+    const currentFrame = this.element.querySelector("turbo-frame#game-stage")
+    if (!currentFrame) return
+
+    currentFrame.innerHTML = html
+    const csrf = document.querySelector("meta[name='csrf-token']")?.getAttribute("content") || ""
+    if (csrf) {
+      currentFrame.querySelectorAll("input[name='authenticity_token']").forEach((el) => {
+        el.value = csrf
+      })
+    }
+    this.currentVersion = version
+    this.syncTimer()
+  }
+
+  syncTimer() {
+    if (!this.hasTimerTarget) {
+      this.clearTimer()
+      return
+    }
+
+    const el = this.timerTarget
+    if (this.syncedTimerEl === el && this.timerDeadlinePerf !== null) {
+      return
+    }
+
+    this.clearTimer()
+    const remainingMs = parseInt(el.dataset.timerRemainingMs, 10)
+    if (Number.isNaN(remainingMs)) return
+
+    this.syncedTimerEl = el
+    this.timerDeadlinePerf = performance.now() + Math.max(0, remainingMs)
+    this.expiredPollScheduled = false
+    this.tickTimer()
+
+    this.timerInterval = setInterval(() => this.tickTimer(), 100)
+  }
+
+  clearTimer() {
+    if (this.timerInterval) {
+      clearInterval(this.timerInterval)
+      this.timerInterval = null
+    }
+    if (this.expiredPollTimeout) {
+      clearTimeout(this.expiredPollTimeout)
+      this.expiredPollTimeout = null
+    }
+    if (this.expiredFollowupTimeout) {
+      clearTimeout(this.expiredFollowupTimeout)
+      this.expiredFollowupTimeout = null
+    }
+    this.syncedTimerEl = null
+    this.timerDeadlinePerf = null
+  }
+
+  tickTimer() {
+    if (!this.hasTimerTarget || this.timerDeadlinePerf === null) {
+      this.clearTimer()
+      return
+    }
+
+    const remainingMs = Math.max(0, this.timerDeadlinePerf - performance.now())
+    const formatted = this.formatTimerMs(remainingMs)
+    if (this.timerTarget.textContent !== formatted) {
+      this.timerTarget.textContent = formatted
+    }
+
+    if (remainingMs <= 0 && !this.expiredPollScheduled) {
+      this.expiredPollScheduled = true
+      if (this.timerInterval) {
+        clearInterval(this.timerInterval)
+        this.timerInterval = null
+      }
+      this.expiredPollTimeout = setTimeout(() => {
+        this.pollState()
+        this.expiredFollowupTimeout = setTimeout(() => this.pollState(), 250)
+      }, 60)
+    }
+  }
+
+  formatTimerMs(remainingMs) {
+    const totalSeconds = Math.ceil(Math.max(0, remainingMs) / 1000)
+    const minutes = Math.floor(totalSeconds / 60)
+    const seconds = totalSeconds % 60
+    return `${minutes}:${String(seconds).padStart(2, "0")}`
+  }
+
+  updateCounts(onlinePlayers, answeredPlayers) {
+    if (this.hasPlayersCountTarget) {
+      this.playersCountTarget.textContent = `Players: ${onlinePlayers}`
+    }
+    if (this.hasAnswersCountTarget) {
+      this.answersCountTarget.textContent = `Answers: ${answeredPlayers} / ${onlinePlayers}`
+    }
+  }
+
+  async pollState() {
+    if (!this.stateUrlValue) return
+
+    try {
+      const response = await fetch(this.stateUrlValue, {
+        credentials: "same-origin",
+        cache: "no-store",
+        headers: { Accept: "application/json" }
+      })
+      if (!response.ok) return
+      const data = await response.json()
+      this.handlePayload(data)
+    } catch (_err) {
+      // Ignore transient network hiccups on crowded Wi-Fi
+    }
+  }
+
+  async refreshStage() {
+    if (this.refreshInFlight) {
+      this.pendingRefresh = true
+      return
+    }
+
+    this.refreshInFlight = true
+    try {
+      const response = await fetch(this.stageUrlValue, {
+        credentials: "same-origin",
+        cache: "no-store",
+        headers: {
+          Accept: "text/html",
+          "Turbo-Frame": "game-stage"
+        }
+      })
+      if (!response.ok) return
+
+      const html = await response.text()
+      const doc = new DOMParser().parseFromString(html, "text/html")
+      const incomingFrame = doc.querySelector("turbo-frame#game-stage")
+      const incomingContent = incomingFrame?.querySelector("[data-state-version]")
+      if (!incomingFrame || !incomingContent) return
+
+      const incomingVersion = parseInt(incomingContent.dataset.stateVersion, 10)
+      if (!Number.isNaN(incomingVersion) && incomingVersion <= this.currentVersion) {
+        return
+      }
+
+      const currentFrame = this.element.querySelector("turbo-frame#game-stage")
+      if (currentFrame && !this.submitting) {
+        currentFrame.innerHTML = incomingFrame.innerHTML
+        const csrf = document.querySelector("meta[name='csrf-token']")?.getAttribute("content") || ""
+        if (csrf) {
+          currentFrame.querySelectorAll("input[name='authenticity_token']").forEach((el) => {
+            el.value = csrf
+          })
+        }
+        if (!Number.isNaN(incomingVersion)) {
+          this.currentVersion = incomingVersion
+        }
+        this.syncTimer()
+      }
+    } catch (_err) {
+      // Will retry on next signal/poll
+    } finally {
+      this.refreshInFlight = false
+      if (this.pendingRefresh) {
+        this.pendingRefresh = false
+        this.refreshStage()
+      }
+    }
+  }
+}
