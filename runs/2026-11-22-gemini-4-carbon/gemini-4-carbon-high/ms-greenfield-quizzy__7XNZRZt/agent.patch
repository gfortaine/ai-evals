diff --git a/app/views/plays/_stage.html.erb b/app/views/plays/_stage.html.erb
new file mode 100644
index 0000000..4998a62
--- /dev/null
+++ b/app/views/plays/_stage.html.erb
@@ -0,0 +1,112 @@
+<div style="flex: 1; display: flex; flex-direction: column;" data-state-version="<%= @game.state_version %>" data-status="<%= @game.status %>">
+  <% if @game.ended? %>
+    <div class="play__body">
+      <% if @player && @player_standing %>
+        <div class="result-card">
+          <div class="muted" style="font-weight: 700; margin-bottom: 12px;">The quiz is over</div>
+          <div class="result-card__place"><%= @player_standing[:place] %></div>
+          <div class="result-card__label">Place <%= @player_standing[:place] %> of <%= @total_players %></div>
+          <div class="result-card__score"><%= pluralize(@player_standing[:points], "point") %></div>
+          <% if @player_standing[:winner] %>
+            <div class="winner-banner">You won!</div>
+          <% end %>
+        </div>
+      <% else %>
+        <div class="result-card">
+          <h1 class="play-title">The quiz is over</h1>
+        </div>
+      <% end %>
+    </div>
+
+  <% elsif @player.nil? %>
+    <div class="play__body">
+      <h1 class="play-title"><%= @quiz.title %></h1>
+
+      <% if @join_error.present? %>
+        <div class="errors"><%= @join_error %></div>
+      <% end %>
+
+      <%= form_with url: join_play_game_path(@game.code), method: :post, class: "join-form" do %>
+        <div class="field" style="margin-bottom: 0">
+          <label class="field-label" for="player_name">Your name</label>
+          <input class="input"
+                 type="text"
+                 id="player_name"
+                 name="name"
+                 value="<%= @entered_name %>"
+                 placeholder="Your name"
+                 autocomplete="name"
+                 required
+                 autofocus>
+        </div>
+        <button type="submit" class="btn btn--pink">Join</button>
+      <% end %>
+    </div>
+
+  <% elsif @game.waiting? %>
+    <div class="play__body">
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h2>Hi, <%= @player.name %>!</h2>
+        <p class="play-lead">Waiting for the quiz to start…</p>
+      </div>
+    </div>
+
+  <% elsif @game.question_open? && @current_question %>
+    <div class="play__body play__body--top">
+      <div class="play-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+      <div class="play-question__body"><%= @current_question.body %></div>
+
+      <div class="play-options">
+        <% @options.each_with_index do |option, idx| %>
+          <% is_picked = (@picked_option_id == option.id) %>
+          <%= form_with url: answer_play_game_path(@game.code), method: :post, data: { action: "submit->play#submitAnswer" } do %>
+            <input type="hidden" name="question_id" value="<%= @current_question.id %>">
+            <input type="hidden" name="option_id" value="<%= option.id %>">
+            <button type="submit"
+                    class="play-option <%= 'is-picked' if is_picked %>"
+                    data-play-target="optionButton"
+                    data-option-id="<%= option.id %>"
+                    aria-pressed="<%= is_picked %>">
+              <span class="play-option__letter" data-letter="<%= option_letter(idx) %>" aria-hidden="true"></span>
+              <span class="play-option__title"><%= option.text %></span>
+              <% if is_picked %>
+                <span class="play-option__mark">Your answer</span>
+              <% end %>
+            </button>
+          <% end %>
+        <% end %>
+      </div>
+    </div>
+
+  <% elsif @game.question_closed? && @current_question %>
+    <div class="play__body play__body--top">
+      <div class="play-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+      <div class="play-question__body"><%= @current_question.body %></div>
+
+      <div class="play-options is-locked is-revealed">
+        <% @options.each_with_index do |option, idx| %>
+          <% is_picked = (@picked_option_id == option.id) %>
+          <% classes = [ "play-option" ] %>
+          <% classes << "is-picked" if is_picked %>
+          <% classes << "is-correct" if option.correct? %>
+          <button type="button" disabled class="<%= classes.join(' ') %>">
+            <span class="play-option__letter" data-letter="<%= option_letter(idx) %>" aria-hidden="true"></span>
+            <span class="play-option__title"><%= option.text %></span>
+            <% if is_picked %>
+              <span class="play-option__mark">Your answer</span>
+            <% end %>
+          </button>
+        <% end %>
+      </div>
+
+      <% if @picked_option.nil? %>
+        <div class="play-status play-status--neutral">No answer</div>
+      <% elsif @picked_option.correct? %>
+        <div class="play-status play-status--right">Correct!</div>
+      <% else %>
+        <div class="play-status play-status--wrong">Wrong!</div>
+      <% end %>
+    </div>
+  <% end %>
+</div>
