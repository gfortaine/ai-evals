diff --git a/app/views/moderate/previews/show.html.erb b/app/views/moderate/previews/show.html.erb
new file mode 100644
index 0000000..0a4b250
--- /dev/null
+++ b/app/views/moderate/previews/show.html.erb
@@ -0,0 +1,94 @@
+<% content_for(:title) { "Preview · #{@quiz.title} · Quizzy" } %>
+
+<div class="preview-banner">
+  <span>Preview · <%= @quiz.title %></span>
+  <div class="buttons">
+    <% if @total > 0 && !@finished %>
+      <%= button_to "Start over", moderate_quiz_preview_path(@quiz), method: :get, class: "btn btn--light btn--sm" %>
+    <% end %>
+    <%= link_to "← Back to quiz", moderate_quiz_path(@quiz) %>
+  </div>
+</div>
+
+<main class="play">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span><%= @quiz.title %></span>
+  </div>
+
+  <% if @total == 0 %>
+    <div class="play__body">
+      <div class="empty">
+        No active questions in this quiz yet.
+        <div class="buttons mt-2" style="justify-content: center">
+          <%= link_to "Back to quiz", moderate_quiz_path(@quiz), class: "btn" %>
+        </div>
+      </div>
+    </div>
+  <% elsif @finished %>
+    <div class="play__body">
+      <div class="card result-card">
+        <div class="result-card__label">Preview complete</div>
+        <div class="result-card__score">Score: <%= @score %>/<%= @total %></div>
+        <div class="buttons mt-2" style="justify-content: center">
+          <%= button_to "Start over", moderate_quiz_preview_path(@quiz), method: :get, class: "btn btn--pink" %>
+        </div>
+      </div>
+    </div>
+  <% else %>
+    <div class="play__body play__body--top">
+      <div class="play-question__num">Question <%= @step + 1 %> of <%= @total %></div>
+      <div class="play-question__body"><%= @question.body %></div>
+
+      <% if @picked_option %>
+        <div class="play-options is-locked is-revealed">
+          <% @options.each_with_index do |option, idx| %>
+            <% classes = [ "play-option" ] %>
+            <% classes << "is-picked" if option.id == @picked_option.id %>
+            <% classes << "is-correct" if option.correct? %>
+            <button type="button" disabled class="<%= classes.join(' ') %>" <% if option.correct? %>data-correct="true"<% end %>>
+              <span class="play-option__letter" data-letter="<%= option_letter(idx) %>" aria-hidden="true"></span>
+              <span class="play-option__title"><%= option.text %></span>
+              <% if option.correct? %>
+                <span class="play-option__mark">✓</span>
+              <% end %>
+            </button>
+          <% end %>
+        </div>
+
+        <div class="play-status <%= @is_correct ? 'play-status--right' : 'play-status--wrong' %>">
+          <%= @is_correct ? "Correct!" : "Wrong!" %>
+        </div>
+
+        <div class="buttons mt-2" style="justify-content: center">
+          <% if @step + 1 < @total %>
+            <%= form_with url: moderate_quiz_preview_path(@quiz), method: :get do %>
+              <input type="hidden" name="step" value="<%= @step + 1 %>">
+              <input type="hidden" name="score" value="<%= @next_score %>">
+              <button type="submit" class="btn btn--pink">Next question</button>
+            <% end %>
+          <% else %>
+            <%= form_with url: moderate_quiz_preview_path(@quiz), method: :get do %>
+              <input type="hidden" name="finished" value="1">
+              <input type="hidden" name="score" value="<%= @next_score %>">
+              <button type="submit" class="btn btn--pink">See score</button>
+            <% end %>
+          <% end %>
+        </div>
+      <% else %>
+        <div class="play-options">
+          <% @options.each_with_index do |option, idx| %>
+            <%= form_with url: moderate_quiz_preview_path(@quiz), method: :get do %>
+              <input type="hidden" name="step" value="<%= @step %>">
+              <input type="hidden" name="score" value="<%= @score %>">
+              <button type="submit" name="picked" value="<%= option.id %>" class="play-option">
+                <span class="play-option__letter" data-letter="<%= option_letter(idx) %>" aria-hidden="true"></span>
+                <span class="play-option__title"><%= option.text %></span>
+              </button>
+            <% end %>
+          <% end %>
+        </div>
+      <% end %>
+    </div>
+  <% end %>
+</main>
