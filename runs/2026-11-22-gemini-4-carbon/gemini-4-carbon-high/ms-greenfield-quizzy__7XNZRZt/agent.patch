diff --git a/test/integration/live_game_security_and_auth_test.rb b/test/integration/live_game_security_and_auth_test.rb
new file mode 100644
index 0000000..dac7004
--- /dev/null
+++ b/test/integration/live_game_security_and_auth_test.rb
@@ -0,0 +1,199 @@
+require "test_helper"
+
+class LiveGameSecurityAndAuthTest < ActionDispatch::IntegrationTest
+  setup do
+    @orig_user = ENV["QUIZZY_MODERATOR_USERNAME"]
+    @orig_pass = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moduser"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "s3cr3t-pass"
+    GamePresence.reset!
+    GameTimerScheduler.reset!
+
+    @quiz = Quiz.create!(title: "Conf Security Quiz")
+    @q_inactive = @quiz.questions.create!(body: "Inactive warmup?", active: false, position: 0)
+    @q_inactive.options.create!(text: "Skip A", correct: true, position: 0)
+    @q_inactive.options.create!(text: "Skip B", correct: false, position: 1)
+
+    @q1 = @quiz.questions.create!(body: "Which port is HTTP?", active: true, position: 1)
+    @opt_wrong = @q1.options.create!(text: "AlphaOption21", correct: false, position: 0)
+    @opt_right = @q1.options.create!(text: "BravoOption80", correct: true, position: 1)
+  end
+
+  teardown do
+    GameTimerScheduler.reset!
+    GamePresence.reset!
+    ENV["QUIZZY_MODERATOR_USERNAME"] = @orig_user
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = @orig_pass
+  end
+
+  def auth_headers(user = "moduser", pass = "s3cr3t-pass")
+    { "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials(user, pass) }
+  end
+
+  test "all moderator game routes enforce HTTP Basic Auth and accept any host" do
+    post "/moderate/quizzes/#{@quiz.id}/games"
+    assert_response :unauthorized
+
+    post "/moderate/quizzes/#{@quiz.id}/games", headers: auth_headers.merge("Host" => "projector.conf.local:3000")
+    assert_response :see_other
+    game = Game.last
+    assert_equal "http://projector.conf.local:3000", game.join_base_url
+
+    get "/moderate/quizzes/#{@quiz.id}/games/#{game.id}"
+    assert_response :unauthorized
+
+    get "/moderate/quizzes/#{@quiz.id}/games/#{game.id}/stage"
+    assert_response :unauthorized
+
+    get "/moderate/quizzes/#{@quiz.id}/games/#{game.id}/state"
+    assert_response :unauthorized
+
+    patch "/moderate/quizzes/#{@quiz.id}/games/#{game.id}/start"
+    assert_response :unauthorized
+
+    patch "/moderate/quizzes/#{@quiz.id}/games/#{game.id}/finish"
+    assert_response :unauthorized
+
+    patch "/moderate/quizzes/#{@quiz.id}/games/#{game.id}/next_question"
+    assert_response :unauthorized
+
+    patch "/moderate/quizzes/#{@quiz.id}/games/#{game.id}/end_quiz"
+    assert_response :unauthorized
+
+    patch "/moderate/quizzes/#{@quiz.id}/games/#{game.id}/pick_top_winners"
+    assert_response :unauthorized
+
+    patch "/moderate/quizzes/#{@quiz.id}/games/#{game.id}/draw_winners"
+    assert_response :unauthorized
+
+    patch "/moderate/quizzes/#{@quiz.id}/games/#{game.id}/reset_winners"
+    assert_response :unauthorized
+
+    get "/moderate/quizzes/#{@quiz.id}/games/#{game.id}", headers: auth_headers.merge("Host" => "projector.conf.local:3000")
+    assert_response :success
+    assert_includes response.body, "http://projector.conf.local:3000/play/#{game.code}"
+  end
+
+  test "player page source and endpoints never leak correct answer, points during game, or question timer" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    game = @quiz.games.create!(question_ids: [ @q1.id ], join_base_url: "http://localhost:3000")
+
+    # Join as player without moderator credentials on custom host
+    post "/play/#{game.code}/join", params: { name: "Alice" }, headers: { "Host" => "wifi.conf.local:8080" }
+    assert_response :see_other
+
+    # Waiting state: no points or timer shown
+    get "/play/#{game.code}", headers: { "Host" => "wifi.conf.local:8080" }
+    assert_response :success
+    refute_match(/\b\d+\s+points?\b/i, response.body)
+    refute_includes response.body, "stage-timer"
+
+    game.start!
+    assert game.question_open?
+
+    # Moderator big screen DOES show 1:30 timer while question is open
+    get "/moderate/quizzes/#{@quiz.id}/games/#{game.id}", headers: auth_headers
+    assert_response :success
+    assert_includes response.body, "stage-timer"
+    assert_includes response.body, "1:30"
+
+    # Check GET /play/:code HTML source: no correctness, no points, NO timer!
+    get "/play/#{game.code}", headers: { "Host" => "wifi.conf.local:8080" }
+    assert_response :success
+    html_open = response.body
+    assert_includes html_open, "AlphaOption21"
+    assert_includes html_open, "BravoOption80"
+    refute_match(/correct/i, html_open)
+    refute_includes html_open, "✓"
+    refute_match(/\b\d+\s+points?\b/i, html_open)
+    refute_includes html_open, "1:30"
+    refute_includes html_open, "stage-timer"
+    refute_includes html_open, "timer_remaining"
+
+    # Check GET /play/:code/frame HTML source
+    get "/play/#{game.code}/frame", headers: { "Host" => "wifi.conf.local:8080" }
+    assert_response :success
+    refute_match(/correct/i, response.body)
+    refute_match(/\b\d+\s+points?\b/i, response.body)
+    refute_includes response.body, "1:30"
+    refute_includes response.body, "stage-timer"
+
+    # Check GET /play/:code/state JSON
+    get "/play/#{game.code}/state", headers: { "Host" => "wifi.conf.local:8080" }
+    assert_response :success
+    refute_match(/correct/i, response.body)
+    refute_match(/point/i, response.body)
+    refute_match(/timer/i, response.body)
+
+    # Submit wrong answer and check JSON response does NOT reveal correctness
+    post "/play/#{game.code}/answer",
+         params: { question_id: @q1.id, option_id: @opt_wrong.id },
+         headers: { "Accept" => "application/json", "Host" => "wifi.conf.local:8080" }
+    assert_response :success
+    json_wrong = JSON.parse(response.body)
+
+    # Submit right answer and check JSON response has identical keys/shape without correctness
+    post "/play/#{game.code}/answer",
+         params: { question_id: @q1.id, option_id: @opt_right.id },
+         headers: { "Accept" => "application/json", "Host" => "wifi.conf.local:8080" }
+    assert_response :success
+    json_right = JSON.parse(response.body)
+
+    assert_equal json_wrong.keys.sort, json_right.keys.sort
+    assert_equal true, json_wrong["ok"]
+    assert_equal true, json_right["ok"]
+    refute_match(/correct/i, response.body)
+    refute_match(/point/i, response.body)
+    refute_match(/timer/i, response.body)
+
+    # Cannot change answer after question is closed, and points are STILL hidden while question is closed
+    game.finish_question!
+    get "/play/#{game.code}/frame", headers: { "Host" => "wifi.conf.local:8080" }
+    assert_response :success
+    assert_includes response.body, "Correct!"
+    refute_match(/\b\d+\s+points?\b/i, response.body)
+
+    post "/play/#{game.code}/answer",
+         params: { question_id: @q1.id, option_id: @opt_wrong.id },
+         headers: { "Accept" => "application/json", "Host" => "wifi.conf.local:8080" }
+    assert_response :success
+    assert_equal false, JSON.parse(response.body)["ok"]
+    assert_equal @opt_right.id, game.answers.first.option_id
+
+    # Cannot join after quiz ends; joined player now sees Place and points
+    game.end_quiz!
+    get "/play/#{game.code}/frame", headers: { "Host" => "wifi.conf.local:8080" }
+    assert_response :success
+    assert_includes response.body, "Place 1 of 1"
+    assert_includes response.body, "1 point"
+
+    player_count_before = game.players.count
+    open_session do |late_sess|
+      late_sess.post "/play/#{game.code}/join", params: { name: "TooLate" }
+      assert_includes late_sess.response.body, "The quiz is over"
+    end
+    assert_equal player_count_before, game.players.reload.count
+  end
+
+  test "quiz export omits game, player, answer, and timer data, and deleting quiz cascades cleanly" do
+    @quiz.update!(timer_minutes: 2, timer_seconds: 15)
+    game = @quiz.games.create!(question_ids: [ @q1.id ])
+    game.start!
+    player = game.players.create!(name: "Alice")
+    game.submit_answer!(player: player, question_id: @q1.id, option_id: @opt_right.id)
+
+    get "/moderate/quizzes/#{@quiz.id}/export", headers: auth_headers
+    assert_response :success
+    parsed = JSON.parse(Nokogiri::HTML(response.body).at_css("pre").text)
+    assert_equal [ "questions", "title" ], parsed.keys.sort
+
+    assert_difference -> { Game.count }, -1 do
+      assert_difference -> { Player.count }, -1 do
+        assert_difference -> { Answer.count }, -1 do
+          delete "/moderate/quizzes/#{@quiz.id}", headers: auth_headers
+        end
+      end
+    end
+    assert_response :see_other
+  end
+end
