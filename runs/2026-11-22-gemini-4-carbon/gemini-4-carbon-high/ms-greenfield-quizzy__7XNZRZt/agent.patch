--- /dev/null
+++ b/test/system/timer_test.rb
@@ -0,0 +1,339 @@
+require "application_system_test_case"
+
+class TimerTest < ApplicationSystemTestCase
+  setup do
+    @orig_user = ENV["QUIZZY_MODERATOR_USERNAME"]
+    @orig_pass = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "conf2026"
+    GamePresence.reset!
+    GameTimerScheduler.reset!
+  end
+
+  teardown do
+    GameTimerScheduler.reset!
+    GamePresence.reset!
+    ENV["QUIZZY_MODERATOR_USERNAME"] = @orig_user
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = @orig_pass
+  end
+
+  def login_as_moderator!
+    auth = ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "conf2026")
+    page.driver.browser.headers.set("Authorization" => auth)
+  end
+
+  def parse_mss(text)
+    match = text.to_s.strip.match(/\A(\d+):(\d{2})\z/)
+    assert match, "Expected M:SS format, got #{text.inspect}"
+    (match[1].to_i * 60) + match[2].to_i
+  end
+
+  test "quiz settings Timer minutes and Timer seconds default to 0, validate, save, and are omitted from export" do
+    login_as_moderator!
+    visit "/moderate"
+
+    click_button "New quiz"
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+
+    fill_in "Title", with: "Lightning Talk Quiz"
+    click_button "Save quiz"
+
+    quiz = Quiz.last
+    assert_equal 0, quiz.timer_minutes
+    assert_equal 0, quiz.timer_seconds
+
+    click_link "Settings"
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+
+    # Negative minutes rejected
+    fill_in "Timer minutes", with: "-1"
+    click_button "Save quiz"
+    assert_selector ".errors", text: "Timer minutes"
+
+    # Seconds >= 60 rejected
+    fill_in "Timer minutes", with: "1"
+    fill_in "Timer seconds", with: "60"
+    click_button "Save quiz"
+    assert_selector ".errors", text: "Timer seconds"
+
+    # Valid update: 1 minute 30 seconds
+    fill_in "Timer minutes", with: "1"
+    fill_in "Timer seconds", with: "30"
+    click_button "Save quiz"
+
+    assert_current_path moderate_quiz_path(quiz)
+    assert_equal 1, quiz.reload.timer_minutes
+    assert_equal 30, quiz.timer_seconds
+
+    click_link "Settings"
+    assert_field "Timer minutes", with: "1"
+    assert_field "Timer seconds", with: "30"
+    click_link "Cancel"
+
+    # Export omits timer settings; re-importing resets timer to 0m 0s
+    click_link "Export"
+    exported_text = find("pre").text
+    parsed = JSON.parse(exported_text)
+    assert_equal [ "title", "questions" ], parsed.keys
+    refute_includes exported_text, "timer"
+
+    visit "/moderate"
+    click_button "Import quiz"
+    fill_in "Quiz JSON", with: exported_text
+    click_button "Import"
+
+    click_link "Settings"
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+  end
+
+  test "0 minutes and 0 seconds means no timer on big screen and question does not finish by itself" do
+    quiz = Quiz.create!(title: "Untimed Talk") # timer_minutes: 0, timer_seconds: 0
+    q1 = quiz.questions.create!(body: "No rush question?", active: true, position: 0)
+    q1.options.create!(text: "Option A", correct: true, position: 0)
+    q1.options.create!(text: "Option B", correct: false, position: 1)
+
+    login_as_moderator!
+    visit moderate_quiz_path(quiz)
+    click_button "Start a game"
+    click_button "Start"
+
+    assert_text "Question 1 of 1"
+    assert_text "No rush question?"
+    assert_no_selector ".stage-timer"
+    assert_no_text(/\b\d+:\d{2}\b/)
+
+    sleep 1.5
+    assert_button "Finish"
+    assert_no_selector ".stage-timer"
+
+    click_button "Finish"
+    assert_button "End quiz"
+  end
+
+  test "1:30 timer displays M:SS on big screen, hides from players, survives reload without restarting, and allows early Finish" do
+    quiz = Quiz.create!(title: "Keynote 1:30", timer_minutes: 1, timer_seconds: 30)
+    q1 = quiz.questions.create!(body: "What port is HTTPS?", active: true, position: 0)
+    q1.options.create!(text: "80", correct: false, position: 0)
+    q1.options.create!(text: "443", correct: true, position: 1)
+
+    q2 = quiz.questions.create!(body: "Second question?", active: true, position: 1)
+    q2.options.create!(text: "Yes", correct: true, position: 0)
+    q2.options.create!(text: "No", correct: false, position: 1)
+
+    game_url = nil
+    join_url = nil
+
+    using_session(:moderator) do
+      login_as_moderator!
+      visit moderate_quiz_path(quiz)
+      click_button "Start a game"
+      assert_no_selector ".stage-timer"
+      game_url = current_url
+      join_url = find(".lobby__url").text.strip
+    end
+
+    using_session(:alice) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    using_session(:moderator) do
+      click_button "Start"
+      assert_text "Question 1 of 2"
+      assert_selector ".stage-timer", text: "1:30"
+    end
+
+    # Player does NOT see the timer!
+    using_session(:alice) do
+      assert_text "What port is HTTPS?"
+      assert_no_selector ".stage-timer"
+      assert_no_text(/\b1:\d{2}\b/)
+      click_button "443"
+      assert_text "Your answer"
+    end
+
+    # Let countdown tick down, then reload big screen -> must NOT restart to 1:30!
+    using_session(:moderator) do
+      assert_selector ".stage-timer", text: "1:29", wait: 3
+      sleep 1.1
+      visit game_url
+
+      reloaded_text = find(".stage-timer").text
+      reloaded_secs = parse_mss(reloaded_text)
+      assert_operator reloaded_secs, :<=, 88, "Reloading should not restart timer; got #{reloaded_text}"
+      assert_operator reloaded_secs, :>=, 80, "Timer should continue from elapsed time; got #{reloaded_text}"
+
+      # Moderator can click "Finish" earlier
+      click_button "Finish"
+      assert_no_selector ".stage-timer"
+      assert_text "Correct"
+      assert_button "Next"
+    end
+
+    using_session(:alice) do
+      assert_text "Correct!"
+    end
+  end
+
+  test "0:05 timer counts down to 0:00 and finishes question automatically across multiple questions and players" do
+    quiz = Quiz.create!(title: "Fast 5s Talk", timer_minutes: 0, timer_seconds: 5)
+    q1 = quiz.questions.create!(body: "Fast question one?", active: true, position: 0)
+    q1.options.create!(text: "Right Alpha", correct: true, position: 0)
+    q1.options.create!(text: "Wrong Beta", correct: false, position: 1)
+
+    q2 = quiz.questions.create!(body: "Fast question two?", active: true, position: 1)
+    q2.options.create!(text: "Wrong Gamma", correct: false, position: 0)
+    q2.options.create!(text: "Right Delta", correct: true, position: 1)
+
+    game_url = nil
+    join_url = nil
+
+    using_session(:moderator) do
+      login_as_moderator!
+      visit moderate_quiz_path(quiz)
+      click_button "Start a game"
+      game_url = current_url
+      join_url = find(".lobby__url").text.strip
+    end
+
+    %w[Alice Bob Carol].each do |name|
+      using_session(name.downcase.to_sym) do
+        visit join_url
+        fill_in "Your name", with: name
+        click_button "Join"
+        assert_text "Hi, #{name}!"
+      end
+    end
+
+    # Open Question 1 -> shows "0:05"
+    using_session(:moderator) do
+      click_button "Start"
+      assert_text "Question 1 of 2"
+      assert_selector ".stage-timer", text: "0:05"
+    end
+
+    # Alice answers right, Bob answers wrong, Carol does not answer; players never see timer
+    using_session(:alice) do
+      assert_no_text(/0:0\d/)
+      click_button "Right Alpha"
+    end
+    using_session(:bob) do
+      assert_no_text(/0:0\d/)
+      click_button "Wrong Beta"
+    end
+    using_session(:carol) do
+      assert_text "Fast question one?"
+      assert_no_text(/0:0\d/)
+    end
+
+    # Reload big screen mid-countdown -> must NOT restart to 0:05, and still finishes at 0:00!
+    using_session(:moderator) do
+      assert_selector ".stage-timer", text: /0:0[1-4]/, wait: 3
+      visit game_url
+      after_reload = parse_mss(find(".stage-timer").text)
+      assert_operator after_reload, :<=, 4, "Reloading must not restart 0:05 timer"
+
+      # Wait for 0:00 auto-finish WITHOUT clicking Finish!
+      assert_button "Next", wait: 7
+      assert_no_selector ".stage-timer"
+      assert_no_button "Finish"
+      assert_text "Correct"
+    end
+
+    # All 3 players transition automatically to closed question results!
+    using_session(:alice) { assert_text "Correct!" }
+    using_session(:bob)   { assert_text "Wrong!" }
+    using_session(:carol) { assert_text "No answer" }
+
+    # Click Next -> Question 2 opens with a brand-new 0:05 countdown and also finishes at 0:00!
+    using_session(:moderator) do
+      click_button "Next"
+      assert_text "Question 2 of 2"
+      assert_selector ".stage-timer", text: "0:05"
+    end
+
+    using_session(:alice) do
+      assert_text "Fast question two?"
+      click_button "Right Delta"
+    end
+
+    using_session(:moderator) do
+      assert_button "End quiz", wait: 8
+      assert_no_selector ".stage-timer"
+      click_button "End quiz"
+
+      assert_text "Leaderboard"
+      within(find("li", text: "Alice")) { assert_text "2 points" }
+      within(find("li", text: "Bob"))   { assert_text "0 points" }
+      within(find("li", text: "Carol")) { assert_text "0 points" }
+    end
+  end
+
+  test "timer finishes at 0:00 on server even without moderator tab open, and cancelled Q1 timer never cuts Q2 short" do
+    quiz = Quiz.create!(title: "Edge Cases Timer", timer_minutes: 0, timer_seconds: 3)
+    q1 = quiz.questions.create!(body: "Edge Q1?", active: true, position: 0)
+    q1.options.create!(text: "A1", correct: true, position: 0)
+    q1.options.create!(text: "B1", correct: false, position: 1)
+
+    q2 = quiz.questions.create!(body: "Edge Q2?", active: true, position: 1)
+    q2.options.create!(text: "A2", correct: true, position: 0)
+    q2.options.create!(text: "B2", correct: false, position: 1)
+
+    game_url = nil
+    join_url = nil
+
+    using_session(:moderator) do
+      login_as_moderator!
+      visit moderate_quiz_path(quiz)
+      click_button "Start a game"
+      game_url = current_url
+      join_url = find(".lobby__url").text.strip
+    end
+
+    using_session(:alice) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    # Q1 opens (3s timer), moderator clicks Finish early at ~0.5s, then immediately clicks Next!
+    using_session(:moderator) do
+      click_button "Start"
+      assert_selector ".stage-timer", text: "0:03"
+      sleep 0.5
+      click_button "Finish"
+      assert_button "Next"
+      click_button "Next"
+      assert_text "Question 2 of 2"
+      assert_selector ".stage-timer", text: "0:03"
+
+      # Moderator navigates away from big screen before Q2 timer hits 0:00!
+      visit "/moderate"
+      assert_text "Quizzes"
+    end
+
+    # Wait past when Q1 would have expired -> Q2 must STILL be open for Alice!
+    sleep 1.2
+    using_session(:alice) do
+      assert_text "Edge Q2?"
+      click_button "A2"
+      assert_text "Your answer"
+
+      # At ~3s from Q2 opening, server finishes Q2 by itself even with moderator off the big screen!
+      assert_text "Correct!", wait: 5
+    end
+
+    # Moderator returns to big screen and sees Q2 already closed with End quiz button
+    using_session(:moderator) do
+      visit game_url
+      assert_no_selector ".stage-timer"
+      assert_button "End quiz"
+    end
+  end
+end
