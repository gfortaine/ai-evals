+require "application_system_test_case"
+
+class ModeratorFlowTest < ApplicationSystemTestCase
+  setup do
+    @orig_user = ENV["QUIZZY_MODERATOR_USERNAME"]
+    @orig_pass = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "conf2026"
+  end
+
+  teardown do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = @orig_user
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = @orig_pass
+  end
+
+  def login_as_moderator!
+  auth = ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "conf2026")
+  page.driver.browser.headers.set("Authorization" => auth)
+end
+
+  test "unauthenticated request to /moderate gets 401 while / and /up get 200" do
+  page.driver.browser.headers.clear
+  visit "/up"
+  assert_equal 200, page.status_code
+
+  visit "/"
+  assert_equal 200, page.status_code
+
+  err = assert_raises(Ferrum::StatusError) { visit "/moderate" }
+  assert_includes err.message, "ERR_INVALID_AUTH_CREDENTIALS"
+end
+
+  test "creating, editing settings, and deleting quizzes with confirmation" do
+    login_as_moderator!
+    visit "/moderate"
+
+    # Check design stylesheet is applied (lavender background #e9e6ff -> rgb(233, 230, 255))
+    bg_color = page.evaluate_script("getComputedStyle(document.body).backgroundColor")
+    assert_equal "rgb(233, 230, 255)", bg_color
+
+    click_button "New quiz"
+
+    # Blank title fails validation and stays on form
+    click_button "Save quiz"
+    assert_equal 0, Quiz.count
+
+    fill_in "Title", with: "Frontend Fest \"2026\" & Beyond"
+    click_button "Save quiz"
