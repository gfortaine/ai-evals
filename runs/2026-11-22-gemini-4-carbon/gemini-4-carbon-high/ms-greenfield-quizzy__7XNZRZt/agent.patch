+          <div class="stage-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+          <div class="stage-question__body"><%= @current_question.body %></div>
+          <ol class="stage-options stage-options--results">
+            <% @options.each_with_index do |option, idx| %>
+              <% count = @option_counts[option.id] || 0 %>
+              <% share = @total_answers > 0 ? ((count.to_f / @total_answers) * 100).round : 0 %>
+              <li class="stage-option <%= 'is-correct' if option.correct? %>" style="--share: <%= share %>%">
+                <span class="stage-option__bar" aria-hidden="true"></span>
+                <span class="stage-option__letter"><%= option_letter(idx) %></span>
+                <span class="stage-option__title"><%= option.text %></span>
+                <% if option.correct? %>
+                  <span class="stage-option__mark">Correct</span>
+                <% end %>
+                <span class="stage-option__count"><%= count %></span>
+              </li>
+            <% end %>
+          </ol>
+        </div>
+      </div>
+
+      <div class="screen-controls">
+        <div class="screen-controls__info">
+          <%= link_to "← Back to quiz", moderate_quiz_path(@quiz), data: { turbo_frame: "_top" } %>
+        </div>
+        <div class="buttons">
+          <% if @game.last_question? %>
+            <%= form_with url: end_quiz_moderate_quiz_game_path(@quiz, @game), method: :patch do %>
+              <input type="hidden" name="expected_version" value="<%= @game.state_version %>">
+              <button type="submit" class="btn btn--pink btn--lg">End quiz</button>
+            <% end %>
+          <% else %>
+            <%= form_with url: next_question_moderate_quiz_game_path(@quiz, @game), method: :patch do %>
+              <input type="hidden" name="expected_version" value="<%= @game.state_version %>">
+              <button type="submit" class="btn btn--pink btn--lg">Next</button>
+            <% end %>
+          <% end %>
+        </div>
+      </div>
+    </section>
+
+  <% else %>
+    <section class="cover cover--night">
+      <div class="screen">
+        <div class="screen__top">
+          <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+          <span><%= @quiz.title %></span>
+        </div>
+
+        <div class="screen__body">
+          <div class="leaderboard-layout">
+            <div>
+              <div class="screen__kicker">The quiz is over</div>
+              <h1 class="leaderboard-layout__title">Leaderboard</h1>
+            </div>
+
+            <div>
+              <ol class="leaderboard">
+                <% Array(@leaderboard).each do |entry| %>
+                  <li class="leader <%= 'is-winner' if entry[:winner] %>">
+                    <span class="leader__place"><%= entry[:place] %></span>
+                    <span class="leader__name">
+                      <%= entry[:player].name %>
+                      <% if entry[:winner] %>
+                        <span class="leader__badge">Winner</span>
+                      <% end %>
+                    </span>
+                    <span class="leader__score"><%= pluralize(entry[:points], "point") %></span>
+                  </li>
+                <% end %>
+              </ol>
+            </div>
+          </div>
+        </div>
+      </div>
+
+      <div class="screen-controls">
+        <div class="screen-controls__info">
+          <%= link_to "← Back to quiz", moderate_quiz_path(@quiz), data: { turbo_frame: "_top" } %>
+        </div>
+        <div class="buttons">
+          <%= form_with url: pick_top_winners_moderate_quiz_game_path(@quiz, @game), method: :patch do %>
+            <button type="submit" class="btn btn--pink btn--lg">Top <%= @winners_count %></button>
+          <% end %>
+          <%= form_with url: draw_winners_moderate_quiz_game_path(@quiz, @game), method: :patch do %>
+            <button type="submit" class="btn btn--light btn--lg">Draw</button>
+          <% end %>
+          <%= form_with url: reset_winners_moderate_quiz_game_path(@quiz, @game), method: :patch do %>
+            <button type="submit" class="btn btn--light btn--lg">Reset winners</button>
+          <% end %>
+        </div>
+      </div>
+    </section>
+  <% end %>
+</div>
