+require "rqrcode"
+
+module ApplicationHelper
+  def option_letter(index)
+    letter = "A"
+    index.times { letter = letter.next }
+    letter
+  end
+
+  def format_timer_ms(remaining_ms)
+    Game.format_timer_ms(remaining_ms)
+  end
+
+  def qr_code_svg(url)
+    svg = RQRCode::QRCode.new(url.to_s).as_svg(
+      color: "000",
+      fill: "fff",
+      shape_rendering: "crispEdges",
+      standalone: true,
+      use_path: true,
+      viewbox: true,
+      offset: 32,
+      module_size: 8,
+      svg_attributes: {
+        role: "img",
+        "aria-label" => "QR code"
+      }
+    ).sub(/\A<\?xml[^>]*>\s*/, "")
+    svg.html_safe
+  end
+end
