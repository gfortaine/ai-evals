new file mode 100644
index 0000000..a6fa3e2
--- /dev/null
+++ b/config/routes.rb
@@ -0,0 +1,53 @@
+Rails.application.routes.draw do
+  get "up" => "rails/health#show", as: :rails_health_check
+
+  root "home#show"
+
+  get "play/:code", to: "plays#show", as: :play_game
+  get "play/:code/frame", to: "plays#frame", as: :play_game_frame
+  get "play/:code/state", to: "plays#state", as: :play_game_state
+  post "play/:code/join", to: "plays#join", as: :join_play_game
+  post "play/:code/answer", to: "plays#answer", as: :answer_play_game
+  post "play/:code/leave", to: "plays#leave", as: :leave_play_game
+
+  namespace :moderate do
+    root "quizzes#index"
+
+    resources :quizzes, except: [ :index ], path_names: { edit: "settings" } do
+      collection do
+        get :import, to: "imports#new"
+        post :import, to: "imports#create"
+      end
+
+      member do
+        get :export, to: "exports#show"
+      end
+
+      resources :questions, except: [ :index, :show ], path_names: { edit: "edit" } do
+        member do
+          patch :move_up
+          patch :move_down
+          patch :toggle_active
+        end
+      end
+
+      resource :preview, only: [ :show ]
+
+      resources :games, only: [ :create, :show ] do
+        member do
+          get :stage
+          get :state
+          patch :start
+          patch :finish
+          patch :next_question
+          patch :end_quiz
+          patch :pick_top_winners
+          patch :draw_winners
+          patch :reset_winners
+        end
+      end
+    end
+
+    get "quizzes", to: "quizzes#index", as: nil
+  end
+end
