diff --git a/app/views/moderate/quizzes/show.html.erb b/app/views/moderate/quizzes/show.html.erb
new file mode 100644
index 0000000..a5ffb41
--- /dev/null
+++ b/app/views/moderate/quizzes/show.html.erb
@@ -0,0 +1,81 @@
+<% content_for(:title) { "#{@quiz.title} · Quizzy" } %>
+
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<div class="page-head">
+  <div>
+    <h1><%= @quiz.title %></h1>
+    <div class="meta mt-2">
+      <%= @active_count %> of <%= @questions.size %> <%= "question".pluralize(@questions.size) %> active · <%= link_to "Settings", edit_moderate_quiz_path(@quiz) %> · <%= link_to "Export", export_moderate_quiz_path(@quiz) %>
+    </div>
+  </div>
+  <div class="buttons">
+    <%= link_to "Preview", moderate_quiz_preview_path(@quiz), class: "btn btn--ghost" %>
+    <%= button_to "Start a game", moderate_quiz_games_path(@quiz), class: "btn btn--pink" %>
+  </div>
+</div>
+
+<section class="section mt-0">
+  <div class="section-head">
+    <h2>Questions</h2>
+    <%= button_to "Add question", new_moderate_quiz_question_path(@quiz), method: :get, class: "btn" %>
+  </div>
+
+  <% if @questions.any? %>
+    <% active_num = 0 %>
+    <ul class="question-list">
+      <% @questions.each_with_index do |question, index| %>
+        <% active_num += 1 if question.active? %>
+        <li class="card question-item <%= 'question-item--inactive' unless question.active? %>">
+          <div class="question-item__num"><%= question.active? ? active_num : "—" %></div>
+          <div>
+            <div class="question-item__body"><%= question.body %></div>
+            <div class="question-item__options">
+              <% question.options.each_with_index do |option, opt_idx| %>
+                <span class="<%= 'is-correct' if option.correct? %>" <% if option.correct? %>data-correct="true"<% end %>><%= "✓ " if option.correct? %><%= option_letter(opt_idx) %>. <%= option.text %></span>
+              <% end %>
+            </div>
+          </div>
+          <div class="question-item__actions">
+            <div class="buttons">
+              <%= button_to move_up_moderate_quiz_question_path(@quiz, question),
+                    method: :patch,
+                    class: "btn btn--ghost btn--icon",
+                    disabled: index == 0,
+                    aria: { label: "Move up" },
+                    title: "Move up" do %>↑<% end %>
+              <%= button_to move_down_moderate_quiz_question_path(@quiz, question),
+                    method: :patch,
+                    class: "btn btn--ghost btn--icon",
+                    disabled: index == @questions.size - 1,
+                    aria: { label: "Move down" },
+                    title: "Move down" do %>↓<% end %>
+            </div>
+
+            <%= form_with model: question,
+                  url: toggle_active_moderate_quiz_question_path(@quiz, question),
+                  method: :patch,
+                  class: "inline-form" do |f| %>
+              <label class="checkbox">
+                <%= f.check_box :active, id: "question_#{question.id}_active", onchange: "this.form.requestSubmit()" %>
+                Active
+              </label>
+            <% end %>
+
+            <div class="buttons">
+              <%= link_to "Edit", edit_moderate_quiz_question_path(@quiz, question), class: "btn btn--sm" %>
+              <%= button_to "Delete",
+                    moderate_quiz_question_path(@quiz, question),
+                    method: :delete,
+                    class: "btn btn--sm btn--danger",
+                    form: {
+                      onsubmit: "if (!window.confirm('Delete this question?')) { event.preventDefault(); event.stopImmediatePropagation(); return false; }"
+                    } %>
+            </div>
+          </div>
+        </li>
+      <% end %>
