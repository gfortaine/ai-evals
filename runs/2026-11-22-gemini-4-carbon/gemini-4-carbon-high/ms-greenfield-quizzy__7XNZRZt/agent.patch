+
+  test "fewer than N players with points: all positive-point players win and 0-point players never win" do
+    quiz = Quiz.create!(title: "Generous Prizes", winners_count: 4)
+    q1 = quiz.questions.create!(body: "Only question?", active: true, position: 0)
+    q1.options.create!(text: "Correct Option", correct: true, position: 0)
+    q1.options.create!(text: "Wrong Option", correct: false, position: 1)
+
+    join_url = nil
+
+    using_session(:moderator) do
+      login_as_moderator!
+      visit moderate_quiz_path(quiz)
+      click_button "Start a game"
+      join_url = find(".lobby__url").text.strip
+    end
+
+    %w[WinnerOne WinnerTwo ZeroHero].each do |name|
+      using_session(name.downcase.to_sym) do
+        visit join_url
+        fill_in "Your name", with: name
+        click_button "Join"
+        assert_text "Hi, #{name}!"
+      end
+    end
+
+    using_session(:moderator) do
+      click_button "Start"
+      assert_text "Question 1 of 1"
+    end
+
+    using_session(:winnerone) { click_button "Correct Option" }
+    using_session(:winnertwo) { click_button "Correct Option" }
+    using_session(:zerohero)  { click_button "Wrong Option" }
+
+    using_session(:moderator) do
+      assert_text "Answers: 3 / 3"
+      click_button "Finish"
+      click_button "End quiz"
+
+      assert_button "Top 4"
+      click_button "Top 4"
+
+      within(find("li", text: "WinnerOne")) { assert_text "Winner" }
+      within(find("li", text: "WinnerTwo")) { assert_text "Winner" }
+      within(find("li", text: "ZeroHero"))  { assert_no_text "Winner" }
+    end
+
+    using_session(:winnerone) do
+      assert_text "Place 1 of 3"
+      assert_text "1 point"
+      assert_text "You won!"
+    end
+    using_session(:winnertwo) do
+      assert_text "Place 2 of 3"
+      assert_text "1 point"
+      assert_text "You won!"
+    end
+    using_session(:zerohero) do
+      assert_text "Place 3 of 3"
+      assert_text "0 points"
+      assert_no_text "You won!"
+    end
+
+    # Reset and verify Draw also gives prizes ONLY to positive-point players
+    using_session(:moderator) do
+      click_button "Reset winners"
+      assert_no_selector ".leader__badge"
+
+      click_button "Draw"
+      within(find("li", text: "WinnerOne")) { assert_text "Winner" }
+      within(find("li", text: "WinnerTwo")) { assert_text "Winner" }
+      within(find("li", text: "ZeroHero"))  { assert_no_text "Winner" }
+    end
+
+    using_session(:zerohero) { assert_no_text "You won!" }
+  end
+end
