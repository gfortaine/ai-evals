+  test "invalid JSON or rule violations show an error, preserve textarea input, and import nothing" do
+    login_as_moderator!
+    visit "/moderate"
+    click_button "Import quiz"
+
+    # 1. Malformed JSON
+    fill_in "Quiz JSON", with: "{ broken json"
+    click_button "Import"
+
+    assert_selector ".errors", text: "Invalid JSON"
+    assert_field "Quiz JSON", with: "{ broken json"
+    assert_equal 0, Quiz.count
+
+    # 2. First question valid, second question breaks a rule (no correct option) -> atomic rollback
+    partial_invalid_json = <<~JSON.strip
+      {
+        "title": "Atomic Check",
+        "questions": [
+          {
+            "text": "Valid first question?",
+            "options": [
+              {"text": "Right", "correct": true},
+              {"text": "Wrong", "correct": false}
+            ]
+          },
+          {
+            "text": "Broken second question?",
+            "options": [
+              {"text": "Wrong 1", "correct": false},
+              {"text": "Wrong 2"}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    fill_in "Quiz JSON", with: partial_invalid_json
+    click_button "Import"
+
+    assert_selector ".errors", text: "Mark at least one option as correct"
+    assert_field "Quiz JSON", with: partial_invalid_json
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+    assert_equal 0, Option.count
+
+    # 3. Fix the JSON in place and submit -> succeeds!
+    fixed_json = partial_invalid_json.sub('"Wrong 2"', '"Right 2", "correct": true')
+    fill_in "Quiz JSON", with: fixed_json
+    click_button "Import"
+
+    assert_equal 1, Quiz.count
+    assert_equal 2, Question.count
+    assert_equal 4, Option.count
+    assert_selector "h1", text: "Atomic Check"
+  end
+end
