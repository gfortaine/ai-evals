@@ -0,0 +1,20 @@
+module Moderate
+  class ImportsController < BaseController
+    def new
+      @quiz_json = ""
+      @errors = []
+    end
+
+    def create
+      @quiz_json = params[:quiz_json].is_a?(String) ? params[:quiz_json] : ""
+      result = Quiz::Importer.call(params[:quiz_json])
+
+      if result.success?
+        redirect_to moderate_quiz_path(result.quiz), status: :see_other
+      else
+        @errors = result.errors
+        render :new, status: :unprocessable_entity
+      end
+    end
+  end
+end
