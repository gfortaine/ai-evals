+  test "importing optional active and correct fields uses defaults and re-export writes both explicitly" do
+    login_as_moderator!
+    visit "/moderate"
+    click_button "Import quiz"
+
+    minimal_json = <<~JSON
+      {
+        "title": "Minimal Defaults Quiz",
+        "questions": [
+          {
+            "text": "Is Ruby object-oriented?",
+            "options": [
+              {"text": "No"},
+              {"text": "Yes", "correct": true}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    fill_in "Quiz JSON", with: minimal_json
+    click_button "Import"
+
+    assert_selector "h1", text: "Minimal Defaults Quiz"
+    assert_text "1 of 1 question active"
+    within(find("li", text: "Is Ruby object-oriented?")) do
+      assert_checked_field "Active"
+      assert_no_selector ".is-correct", text: "No"
+      assert_selector ".is-correct", text: "Yes"
+    end
+
+    click_link "Export"
+    re_exported = JSON.parse(find("pre").text)
+    assert_equal({
+      "title" => "Minimal Defaults Quiz",
+      "questions" => [
+        {
+          "text" => "Is Ruby object-oriented?",
+          "active" => true,
+          "options" => [
+            { "text" => "No", "correct" => false },
+            { "text" => "Yes", "correct" => true }
+          ]
+        }
+      ]
+    }, re_exported)
+  end
