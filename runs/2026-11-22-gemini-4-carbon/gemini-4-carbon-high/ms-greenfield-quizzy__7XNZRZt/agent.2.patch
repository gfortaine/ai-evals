diff --git a/test/models/quiz_export_import_test.rb b/test/models/quiz_export_import_test.rb
new file mode 100644
index 0000000..3a0ba84
--- /dev/null
+++ b/test/models/quiz_export_import_test.rb
@@ -0,0 +1,175 @@
+require "test_helper"
+
+class QuizExportImportTest < ActiveSupport::TestCase
+  test "export writes exact keys, preserves question and option order, and always writes active and correct" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+    q1 = quiz.questions.create!(body: "Second after reorder", active: false, position: 1)
+    q1.options.create!(text: "Opt X", correct: true, position: 1)
+    q1.options.create!(text: "Opt W", correct: false, position: 0)
+
+    q0 = quiz.questions.create!(body: "Which HTTP status code means \"Too Many Requests\"?", active: true, position: 0)
+    q0.options.create!(text: "418", correct: false, position: 0)
+    q0.options.create!(text: "429", correct: true, position: 1)
+
+    parsed = JSON.parse(quiz.to_export_json)
+
+    assert_equal [ "title", "questions" ], parsed.keys
+    assert_equal "Frontend Fest 2026", parsed["title"]
+    assert_equal 2, parsed["questions"].size
+
+    first_q = parsed["questions"][0]
+    assert_equal [ "text", "active", "options" ], first_q.keys
+    assert_equal "Which HTTP status code means \"Too Many Requests\"?", first_q["text"]
+    assert_equal true, first_q["active"]
+    assert_equal [
+      { "text" => "418", "correct" => false },
+      { "text" => "429", "correct" => true }
+    ], first_q["options"]
+    first_q["options"].each do |opt|
+      assert_equal [ "text", "correct" ], opt.keys
+    end
+
+    second_q = parsed["questions"][1]
+    assert_equal [ "text", "active", "options" ], second_q.keys
+    assert_equal "Second after reorder", second_q["text"]
+    assert_equal false, second_q["active"]
+    assert_equal [
+      { "text" => "Opt W", "correct" => false },
+      { "text" => "Opt X", "correct" => true }
+    ], second_q["options"]
+  end
+
+  test "export of quiz with no questions writes empty questions array" do
+    quiz = Quiz.create!(title: "Empty Conf")
+    parsed = JSON.parse(quiz.to_export_json)
+    assert_equal({ "title" => "Empty Conf", "questions" => [] }, parsed)
+  end
+
+  test "import creates a new quiz even if same title exists, preserving order and applying defaults" do
+    existing = Quiz.create!(title: "Frontend Fest 2026")
+
+    json = <<~JSON
+      {
+        "title": "Frontend Fest 2026",
+        "questions": [
+          {
+            "text": "Default active question",
+            "options": [
+              {"text": "Default wrong"},
+              {"text": "Explicit right", "correct": true},
+              {"text": "Also right", "correct": true}
+            ]
+          },
+          {
+            "text": "Explicit inactive question",
+            "active": false,
+            "options": [
+              {"text": "First right", "correct": true},
+              {"text": "Second wrong", "correct": false}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    result = Quiz::Importer.call(json)
+    assert result.success?, "Expected import to succeed, got errors: #{result.errors.inspect}"
+    imported = result.quiz
+
+    assert_not_equal existing.id, imported.id
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+
+    qs = imported.questions.ordered.to_a
+    assert_equal 2, qs.size
+
+    assert_equal "Default active question", qs[0].body
+    assert_equal true, qs[0].active?
+    assert_equal [ "Default wrong", "Explicit right", "Also right" ], qs[0].options.map(&:text)
+    assert_equal [ false, true, true ], qs[0].options.map(&:correct?)
+
+    assert_equal "Explicit inactive question", qs[1].body
+    assert_equal false, qs[1].active?
+    assert_equal [ "First right", "Second wrong" ], qs[1].options.map(&:text)
+    assert_equal [ true, false ], qs[1].options.map(&:correct?)
+  end
+
+  test "import of quiz with empty questions array succeeds" do
+    result = Quiz::Importer.call('{"title": "Zero Questions", "questions": []}')
+    assert result.success?
+    assert_equal "Zero Questions", result.quiz.title
+    assert_equal 0, result.quiz.questions.count
+  end
+
+  test "import rejects invalid JSON and rule violations atomically without importing anything" do
+    invalid_payloads = [
+      nil,
+      "",
+      "   ",
+      "{not json",
+      "[]",
+      "null",
+      "42",
+      '"just string"',
+      "{}",
+      '{"title": "", "questions": []}',
+      '{"title": "   ", "questions": []}',
+      '{"title": 123, "questions": []}',
+      '{"title": "Valid Title"}',
+      '{"title": "Valid Title", "questions": null}',
+      '{"title": "Valid Title", "questions": {}}',
+      '{"title": "Valid Title", "questions": ["not an object"]}',
+      # Blank question text or wrong key ("body" instead of "text")
+      '{"title": "T", "questions": [{"text": "  ", "options": [{"text": "A", "correct": true}, {"text": "B"}]}]}',
+      '{"title": "T", "questions": [{"body": "Wrong key", "options": [{"text": "A", "correct": true}, {"text": "B"}]}]}',
+      # Invalid active type
+      '{"title": "T", "questions": [{"text": "Q", "active": "yes", "options": [{"text": "A", "correct": true}, {"text": "B"}]}]}',
+      '{"title": "T", "questions": [{"text": "Q", "active": null, "options": [{"text": "A", "correct": true}, {"text": "B"}]}]}',
+      # Fewer than 2 options
+      '{"title": "T", "questions": [{"text": "Q", "options": []}]}',
+      '{"title": "T", "questions": [{"text": "Q", "options": [{"text": "Only 1", "correct": true}]}]}',
+      # No correct options (explicit false or omitted default false)
+      '{"title": "T", "questions": [{"text": "Q", "options": [{"text": "A", "correct": false}, {"text": "B", "correct": false}]}]}',
+      '{"title": "T", "questions": [{"text": "Q", "options": [{"text": "A"}, {"text": "B"}]}]}',
+      # Blank option text or invalid correct type
+      '{"title": "T", "questions": [{"text": "Q", "options": [{"text": "", "correct": false}, {"text": "A", "correct": true}, {"text": "B"}]}]}',
+      '{"title": "T", "questions": [{"text": "Q", "options": [{"correct": false}, {"text": "A", "correct": true}, {"text": "B"}]}]}',
+      '{"title": "T", "questions": [{"text": "Q", "options": [{"text": "A", "correct": "yes"}, {"text": "B", "correct": true}]}]}',
+      # First question valid, second question invalid -> NOTHING imported!
+      <<~JSON
+        {
+          "title": "Partial Trap",
+          "questions": [
+            {
+              "text": "Good Question",
+              "options": [
+                {"text": "A", "correct": true},
+                {"text": "B", "correct": false}
+              ]
+            },
+            {
+              "text": "Bad Question without correct option",
+              "options": [
+                {"text": "C", "correct": false},
+                {"text": "D", "correct": false}
+              ]
+            }
+          ]
+        }
+      JSON
+    ]
+
+    invalid_payloads.each do |payload|
+      quiz_before = Quiz.count
+      question_before = Question.count
+      option_before = Option.count
+
+      result = Quiz::Importer.call(payload)
+      assert_not result.success?, "Expected payload #{payload.inspect} to fail"
+      assert_not_empty result.errors
+
+      assert_equal quiz_before, Quiz.count, "Quiz leaked for #{payload.inspect}"
+      assert_equal question_before, Question.count, "Question leaked for #{payload.inspect}"
+      assert_equal option_before, Option.count, "Option leaked for #{payload.inspect}"
+    end
+  end
+end
