diff --git a/app/views/moderate/games/_stage.html.erb b/app/views/moderate/games/_stage.html.erb
new file mode 100644
index 0000000..daa7bf6
--- /dev/null
+++ b/app/views/moderate/games/_stage.html.erb
@@ -0,0 +1,145 @@
+<div data-stage-target="stageContent" data-state-version="<%= @game.state_version %>">
+  <% if @game.waiting? %>
+    <section class="cover">
+      <div class="screen">
+        <div class="screen__top">
+          <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+        </div>
+
+        <div class="screen__body">
+          <div class="lobby">
+            <div>
+              <h1 class="lobby__title"><%= @quiz.title %></h1>
+              <div class="lobby__join">Join at</div>
+              <div class="lobby__url"><%= @join_url %></div>
+              <div class="counter-pill">
+                <span data-stage-target="playersCount">Players: <%= @online_players_count %></span>
+              </div>
+            </div>
+
+            <div class="qr">
+              <%= qr_code_svg(@join_url) %>
+            </div>
+          </div>
+        </div>
+      </div>
+
+      <div class="screen-controls">
+        <div class="screen-controls__info">
+          <%= link_to "← Back to quiz", moderate_quiz_path(@quiz), data: { turbo_frame: "_top" } %>
+        </div>
+        <div class="buttons">
+          <%= form_with url: start_moderate_quiz_game_path(@quiz, @game), method: :patch do %>
+            <input type="hidden" name="expected_version" value="<%= @game.state_version %>">
+            <button type="submit" class="btn btn--pink btn--lg">Start</button>
+          <% end %>
+        </div>
+      </div>
+    </section>
+
+  <% elsif @game.question_open? && @current_question %>
+    <section class="cover cover--blue cover--calm">
+      <div class="screen">
+        <div class="screen__top">
+          <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+          <span><%= @quiz.title %></span>
+        </div>
+
+        <div class="screen__body">
+          <div class="stage-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+          <div class="stage-question__body"><%= @current_question.body %></div>
+          <ol class="stage-options">
+            <% @options.each_with_index do |option, idx| %>
+              <li class="stage-option">
+                <span class="stage-option__letter"><%= option_letter(idx) %></span>
+                <span class="stage-option__title"><%= option.text %></span>
+              </li>
+            <% end %>
+          </ol>
+        </div>
+      </div>
+
+      <div class="screen-controls">
+        <div class="screen-controls__info">
+          <%= link_to "← Back to quiz", moderate_quiz_path(@quiz), data: { turbo_frame: "_top" } %>
+          <span class="answers-counter" data-stage-target="answersCount">Answers: <%= @answered_players_count %> / <%= @online_players_count %></span>
+        </div>
+        <div class="buttons">
+          <%= form_with url: finish_moderate_quiz_game_path(@quiz, @game), method: :patch do %>
+            <input type="hidden" name="expected_version" value="<%= @game.state_version %>">
+            <button type="submit" class="btn btn--pink btn--lg">Finish</button>
+          <% end %>
+        </div>
+      </div>
+    </section>
+
+  <% elsif @game.question_closed? && @current_question %>
+    <section class="cover cover--blue cover--calm">
+      <div class="screen">
+        <div class="screen__top">
+          <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+          <span><%= @quiz.title %></span>
+        </div>
+
+        <div class="screen__body">
+          <div class="stage-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+          <div class="stage-question__body"><%= @current_question.body %></div>
+          <ol class="stage-options stage-options--results">
+            <% @options.each_with_index do |option, idx| %>
+              <% count = @option_counts[option.id] || 0 %>
+              <% share = @total_answers > 0 ? ((count.to_f / @total_answers) * 100).round : 0 %>
+              <li class="stage-option <%= 'is-correct' if option.correct? %>" style="--share: <%= share %>%">
+                <span class="stage-option__bar" aria-hidden="true"></span>
+                <span class="stage-option__letter"><%= option_letter(idx) %></span>
+                <span class="stage-option__title"><%= option.text %></span>
+                <% if option.correct? %>
+                  <span class="stage-option__mark">Correct</span>
+                <% end %>
+                <span class="stage-option__count"><%= count %></span>
+              </li>
+            <% end %>
+          </ol>
+        </div>
+      </div>
+
+      <div class="screen-controls">
