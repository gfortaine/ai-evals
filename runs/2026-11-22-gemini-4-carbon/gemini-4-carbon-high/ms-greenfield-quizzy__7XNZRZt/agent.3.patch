     index.times { letter = letter.next }
     letter
   end
+
+  def qr_code_svg(url)
+    svg = RQRCode::QRCode.new(url.to_s).as_svg(
+      color: "000",
+      fill: "fff",
+      shape_rendering: "crispEdges",
+      standalone: true,
+      use_path: true,
+      viewbox: true,
+      offset: 32,
+      module_size: 8,
+      svg_attributes: {
+        role: "img",
+        "aria-label" => "QR code"
+      }
+    ).sub(/\A<\?xml[^>]*>\s*/, "")
+    svg.html_safe
+  end
 end
diff --git a/app/javascript/controllers/play_controller.js b/app/javascript/controllers/play_controller.js
new file mode 100644
index 0000000..e3b69c0
--- /dev/null
+++ b/app/javascript/controllers/play_controller.js
@@ -0,0 +1,288 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["stage", "optionButton"]
+  static values = {
+    code: String,
+    playerToken: String,
+    stateVersion: Number,
+    status: String,
+    stateUrl: String,
+    frameUrl: String,
+    leaveUrl: String
+  }
+
+  connect() {
+    this.currentVersion = this.stateVersionValue
+    this.currentStatus = this.statusValue
+    this.wsConnected = false
+    this.refreshInFlight = false
+    this.pendingRefresh = false
+    this.answerAbortController = null
+    this.pollAbortController = null
+
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      {
+        channel: "PlayChannel",
+        code: this.codeValue,
+        player_token: this.playerTokenValue
+      },
+      {
+        connected: () => {
+          this.wsConnected = true
+          this.pollState()
+        },
+        disconnected: () => {
+          this.wsConnected = false
+        },
+        received: (data) => {
+          this.handlePayload(data)
+        }
+      }
+    )
+
+    this.boundVisibility = () => {
+      if (document.visibilityState === "visible") {
+        this.pollState()
+      }
+    }
+    document.addEventListener("visibilitychange", this.boundVisibility)
+
+    this.boundPageHide = () => {
+      this.notifyLeave()
+    }
+    window.addEventListener("pagehide", this.boundPageHide)
+
+    this.pollTimer = setInterval(() => this.pollState(), 1500)
+  }
+
+  disconnect() {
+    if (this.pollTimer) clearInterval(this.pollTimer)
+    if (this.boundVisibility) {
+      document.removeEventListener("visibilitychange", this.boundVisibility)
+    }
+    if (this.boundPageHide) {
+      window.removeEventListener("pagehide", this.boundPageHide)
+    }
+    if (this.pollAbortController) {
+      this.pollAbortController.abort()
+      this.pollAbortController = null
+    }
+    if (this.answerAbortController) {
+      this.answerAbortController.abort()
+      this.answerAbortController = null
+    }
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  notifyLeave() {
+    if (this.pollAbortController) {
+      this.pollAbortController.abort()
+      this.pollAbortController = null
+    }
+    if (this.playerTokenValue && this.leaveUrlValue && navigator.sendBeacon) {
+      const formData = new FormData()
+      const csrf = this.csrfToken()
+      if (csrf) formData.append("authenticity_token", csrf)
+      navigator.sendBeacon(this.leaveUrlValue, formData)
+    }
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  handlePayload(data) {
+    if (!data || typeof data.state_version !== "number") return
+
+    if (!this.playerTokenValue) {
+      if (data.status === "ended" && this.currentStatus !== "ended") {
+        this.refreshStage()
+      } else {
+        this.currentVersion = data.state_version
+        if (data.status) this.currentStatus = data.status
+      }
+      return
+    }
+
+    if (data.state_version !== this.currentVersion) {
+      if (this.answerAbortController) {
+        this.answerAbortController.abort()
+        this.answerAbortController = null
+      }
+      this.refreshStage()
+    }
+  }
+
+  withWsParam(url) {
+    if (!this.wsConnected) return url
+    return url.includes("?") ? `${url}&ws=1` : `${url}?ws=1`
+  }
+
+  async pollState() {
+    if (!this.stateUrlValue) return
+
+    if (this.pollAbortController) {
+      this.pollAbortController.abort()
+    }
+    const controller = new AbortController()
+    this.pollAbortController = controller
+
+    try {
+      const response = await fetch(this.withWsParam(this.stateUrlValue), {
+        credentials: "same-origin",
+        cache: "no-store",
+        headers: { Accept: "application/json" },
+        signal: controller.signal
+      })
+      if (!response.ok) return
+      const data = await response.json()
+      this.handlePayload(data)
+    } catch (_err) {
+      // Ignore abort or transient network hiccups on crowded Wi-Fi
+    } finally {
+      if (this.pollAbortController === controller) {
+        this.pollAbortController = null
+      }
+    }
+  }
+
+  async refreshStage() {
+    if (!this.hasStageTarget) return
+    if (this.refreshInFlight) {
+      this.pendingRefresh = true
+      return
+    }
+
+    this.refreshInFlight = true
+    try {
+      const response = await fetch(this.withWsParam(this.frameUrlValue), {
+        credentials: "same-origin",
+        cache: "no-store",
+        headers: { Accept: "text/html" }
+      })
+      if (!response.ok) return
+
+      const html = await response.text()
+      const doc = new DOMParser().parseFromString(html, "text/html")
+      const incomingRoot = doc.querySelector("[data-state-version]")
+      if (!incomingRoot) return
+
+      const incomingVersion = parseInt(incomingRoot.dataset.stateVersion, 10)
+      if (!Number.isNaN(incomingVersion) && incomingVersion < this.currentVersion && this.playerTokenValue) {
+        return
+      }
+
+      this.stageTarget.innerHTML = html
+      if (!Number.isNaN(incomingVersion)) {
+        this.currentVersion = incomingVersion
+      }
+      if (incomingRoot.dataset.status) {
+        this.currentStatus = incomingRoot.dataset.status
+      }
+    } catch (_err) {
+      // Will retry on next signal/poll
+    } finally {
+      this.refreshInFlight = false
+      if (this.pendingRefresh) {
+        this.pendingRefresh = false
+        this.refreshStage()
+      }
+    }
+  }
+
+  async submitAnswer(event) {
+    event.preventDefault()
+
+    const form = event.currentTarget
+    const clickedButton = form.querySelector("[data-play-target='optionButton']")
+    if (!clickedButton) return
+
+    this.markPickedButton(clickedButton)
+
+    if (this.answerAbortController) {
+      this.answerAbortController.abort()
+    }
+    const controller = new AbortController()
+    this.answerAbortController = controller
+
+    const sendAttempt = async () => {
+      const headers = { Accept: "application/json" }
+      const csrf = this.csrfToken()
+      if (csrf) headers["X-CSRF-Token"] = csrf
+
+      return fetch(form.action, {
+        method: "POST",
+        body: new FormData(form),
+        credentials: "same-origin",
+        headers,
+        signal: controller.signal
+      })
+    }
+
+    try {
+      let response
+      try {
+        response = await sendAttempt()
+      } catch (err) {
+        if (err.name === "AbortError") return
+        await new Promise((resolve) => setTimeout(resolve, 200))
+        if (controller.signal.aborted) return
+        response = await sendAttempt()
+      }
+
+      if (!response.ok) {
+        this.refreshStage()
+        return
+      }
+
+      const data = await response.json()
+      if (typeof data.state_version === "number" && data.state_version !== this.currentVersion) {
+        this.refreshStage()
+      } else if (data.status && data.status !== "question_open") {
+        this.refreshStage()
+      }
+    } catch (err) {
+      if (err.name !== "AbortError") {
+        // Poll will reconcile if needed
+      }
+    } finally {
+      if (this.answerAbortController === controller) {
+        this.answerAbortController = null
+      }
+    }
+  }
+
+  markPickedButton(selectedButton) {
+    this.optionButtonTargets.forEach((btn) => {
+      btn.classList.remove("is-picked")
+      btn.setAttribute("aria-pressed", "false")
+      btn.querySelectorAll(".play-option__mark").forEach((el) => el.remove())
+    })
+
+    selectedButton.classList.add("is-picked")
+    selectedButton.setAttribute("aria-pressed", "true")
+    const mark = document.createElement("span")
+    mark.className = "play-option__mark"
+    mark.textContent = "Your answer"
+    selectedButton.appendChild(document.createTextNode(" "))
+    selectedButton.appendChild(mark)
+  }
+
+  csrfToken() {
+    return document.querySelector("meta[name='csrf-token']")?.getAttribute("content") || ""
+  }
+}
