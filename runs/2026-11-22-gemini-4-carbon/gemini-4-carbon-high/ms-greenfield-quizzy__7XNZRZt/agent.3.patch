diff --git a/app/channels/play_channel.rb b/app/channels/play_channel.rb
new file mode 100644
index 0000000..61cd5a1
--- /dev/null
+++ b/app/channels/play_channel.rb
@@ -0,0 +1,41 @@
+class PlayChannel < ApplicationCable::Channel
+  def subscribed
+    game = Game.find_by(code: params[:code].to_s.upcase)
+    unless game
+      reject
+      return
+    end
+
+    @game_id = game.id
+
+    if params[:player_token].present?
+      verified = Game.verify_player_token(params[:player_token])
+      if verified.is_a?(Array) && verified[0] == game.id
+        player = game.players.find_by(id: verified[1])
+        if player
+          @player_id = player.id
+          @sub_id = "#{connection_id}:#{SecureRandom.hex(4)}"
+          changed = GamePresence.connect(@game_id, @player_id, @sub_id)
+          GameBroadcaster.broadcast_counts(game) if changed
+        end
+      end
+    end
+
+    stream_from GameBroadcaster.play_stream(game.id)
+
+    transmit(
+      event: "sync",
+      state_version: game.state_version,
+      status: game.status
+    )
+  end
+
+  def unsubscribed
+    return unless @game_id && @player_id && @sub_id
+
+    changed = GamePresence.disconnect(@game_id, @player_id, @sub_id)
+    if changed && (game = Game.find_by(id: @game_id))
+      GameBroadcaster.broadcast_counts(game)
+    end
+  end
+end
diff --git a/app/channels/stage_channel.rb b/app/channels/stage_channel.rb
new file mode 100644
index 0000000..af55e60
--- /dev/null
+++ b/app/channels/stage_channel.rb
@@ -0,0 +1,22 @@
+class StageChannel < ApplicationCable::Channel
+  def subscribed
+    game = Game.find_by(id: params[:game_id])
+    verified_game_id = Game.verify_stage_token(params[:stage_token])
+
+    unless game && verified_game_id == game.id
+      reject
+      return
+    end
+
+    stream_from GameBroadcaster.stage_stream(game.id)
+
+    counts = game.live_counts
+    transmit(
+      event: "sync",
+      state_version: game.state_version,
+      status: game.status,
+      online_players: counts[:online_players],
+      answered_players: counts[:answered_players]
+    )
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
new file mode 100644
index 0000000..f33e3cf
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,107 @@
+module Moderate
+  class GamesController < BaseController
+    layout "application"
+
+    before_action :set_quiz
+    before_action :set_game, except: [ :create ]
+
+    def create
+      @game = @quiz.games.create!(
+        question_ids: @quiz.questions.active.ordered.pluck(:id),
+        join_base_url: request.base_url
+      )
+      redirect_to moderate_quiz_game_path(@quiz, @game), status: :see_other
+    end
+
+    def show
+      sync_join_base_url!
+      load_stage_data
+      @stage_token = @game.stage_token
+    end
+
+    def stage
+      sync_join_base_url!
+      load_stage_data
+      response.headers["Cache-Control"] = "no-store"
+      render :stage, layout: false
+    end
+
+    def state
+      counts = @game.live_counts
+      response.headers["Cache-Control"] = "no-store"
+      render json: {
+        state_version: @game.state_version,
+        status: @game.status,
+        online_players: counts[:online_players],
+        answered_players: counts[:answered_players]
+      }
+    end
+
+    def start
+      @game.start!(expected_version: params[:expected_version].presence)
+      respond_with_stage
+    end
+
+    def finish
+      @game.finish_question!(expected_version: params[:expected_version].presence)
+      respond_with_stage
+    end
+
+    def next_question
+      @game.next_question!(expected_version: params[:expected_version].presence)
+      respond_with_stage
+    end
+
+    def end_quiz
+      @game.end_quiz!(expected_version: params[:expected_version].presence)
+      respond_with_stage
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_game
+      @game = @quiz.games.find(params[:id])
+    end
+
+    def sync_join_base_url!
+      return if request.base_url.blank? || @game.join_base_url == request.base_url
+
+      @game.update_column(:join_base_url, request.base_url)
+    end
+
+    def respond_with_stage
+      if turbo_frame_request?
+        load_stage_data
+        response.headers["Cache-Control"] = "no-store"
+        render :stage, layout: false
+      else
+        redirect_to moderate_quiz_game_path(@quiz, @game), status: :see_other
+      end
+    end
+
+    def load_stage_data
+      base = @game.join_base_url.presence || request.base_url
+      @join_url = "#{base}#{play_game_path(@game.code)}"
+
+      counts = @game.live_counts
+      @online_players_count = counts[:online_players]
+      @answered_players_count = counts[:answered_players]
+
+      if @game.question_open? || @game.question_closed?
+        @current_question = @game.current_question
+        @options = @current_question ? @current_question.options.sort_by { |o| [ o.position, o.id ] } : []
+        @question_number = @game.question_number
+        @total_questions = @game.total_questions
+
+        if @game.question_closed?
+          @option_counts = @game.option_answer_counts
+          @total_answers = @option_counts.values.sum
+        end
+      end
+    end
+  end
+end
diff --git a/app/controllers/plays_controller.rb b/app/controllers/plays_controller.rb
new file mode 100644
index 0000000..bc3053d
--- /dev/null
+++ b/app/controllers/plays_controller.rb
@@ -0,0 +1,159 @@
+class PlaysController < ApplicationController
+  before_action :set_game
+  before_action :set_player
+
+  def show
+    if @player && !@game.ended?
+      changed = GamePresence.mark_active_http(@game.id, @player.id)
+      GameBroadcaster.broadcast_counts(@game) if changed
+    end
+
+    load_play_data
+  end
+
+  def frame
+    if @player && !@game.ended? && params[:ws] != "1"
+      changed = GamePresence.mark_active_http(@game.id, @player.id)
+      GameBroadcaster.broadcast_counts(@game) if changed
+    end
+
+    load_play_data
+    response.headers["Cache-Control"] = "no-store"
+    render partial: "stage", layout: false
+  end
+
+  def state
+    if @player && !@game.ended? && params[:ws] != "1"
+      changed = GamePresence.mark_active_http(@game.id, @player.id)
+      GameBroadcaster.broadcast_counts(@game) if changed
+    end
+
+    response.headers["Cache-Control"] = "no-store"
+    render json: {
+      state_version: @game.state_version,
+      status: @game.status
+    }
+  end
+
+  def join
+    if @game.ended?
+      load_play_data
+      render :show
+      return
+    end
+
+    if @player
+      changed = GamePresence.mark_active_http(@game.id, @player.id)
+      GameBroadcaster.broadcast_counts(@game) if changed
+      redirect_to play_game_path(@game.code), status: :see_other
+      return
+    end
+
+    new_player = nil
+    ended_during_join = false
+
+    @game.with_lock do
+      if @game.ended?
+        ended_during_join = true
+      else
+        new_player = @game.players.new(name: params[:name])
+        new_player.save
+      end
+    end
+
+    if ended_during_join
+      load_play_data
+      render :show
+    elsif new_player&.persisted?
+      @player = new_player
+      remember_player(@player)
+      changed = GamePresence.mark_active_http(@game.id, @player.id)
+      GameBroadcaster.broadcast_counts(@game) if changed
+      redirect_to play_game_path(@game.code), status: :see_other
+    else
+      @entered_name = params[:name].to_s
+      @join_error = new_player&.errors&.full_messages&.first || "Enter your name"
+      load_play_data
+      render :show, status: :unprocessable_entity
+    end
+  end
+
+  def answer
+    unless @player
+      respond_to do |format|
+        format.json { render json: { ok: false, reload: true }, status: :unauthorized }
+        format.html { redirect_to play_game_path(@game.code), status: :see_other }
+      end
+      return
+    end
+
+    saved = @game.submit_answer!(
+      player: @player,
+      question_id: params[:question_id],
+      option_id: params[:option_id]
+    )
+    @game.reload
+
+    respond_to do |format|
+      format.json do
+        render json: {
+          ok: saved.present?,
+          state_version: @game.state_version,
+          status: @game.status,
+          picked_option_id: saved&.option_id
+        }
+      end
+      format.html { redirect_to play_game_path(@game.code), status: :see_other }
+    end
+  end
+
+  def leave
+    if @player
+      changed = GamePresence.leave(@game.id, @player.id)
+      GameBroadcaster.broadcast_counts(@game) if changed
+    end
+    head :no_content
+  end
+
+  private
+
+  def set_game
+    @game = Game.includes(:quiz).find_by!(code: params[:code].to_s.upcase)
+    @quiz = @game.quiz
+  end
+
+  def set_player
+    token = cookies.signed[player_cookie_key]
+    @player = token.present? ? @game.players.find_by(token: token) : nil
+  end
+
+  def remember_player(player)
+    cookies.signed[player_cookie_key] = {
+      value: player.token,
+      expires: 1.year.from_now,
+      httponly: true,
+      same_site: :lax
+    }
+  end
+
+  def player_cookie_key
+    "quizzy_player_#{@game.code}"
+  end
+
+  def load_play_data
+    @player_cable_token = @game.player_cable_token(@player)
+
+    if @player && (@game.question_open? || @game.question_closed?)
+      @current_question = @game.current_question
+      @options = @current_question ? @current_question.options.sort_by { |o| [ o.position, o.id ] } : []
+      @question_number = @game.question_number
+      @total_questions = @game.total_questions
+      @answer = @current_question ? @game.answers.find_by(player_id: @player.id, question_id: @current_question.id) : nil
+      @picked_option_id = @answer&.option_id
+
+      if @game.question_closed?
+        @picked_option = @options.find { |o| o.id == @picked_option_id }
+      end
+    end
+  end
+end
