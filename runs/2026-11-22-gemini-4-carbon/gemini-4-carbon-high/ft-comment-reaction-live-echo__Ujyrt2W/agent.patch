diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..be2d43b
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "index renders trigger inside turbo frame" do
+    get card_comment_reactions_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} .reactions__trigger" do
+      assert_select "img[src*='boost-color']"
+    end
+  end
+
+  test "new renders reaction form inside turbo frame" do
+    get new_card_comment_reaction_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} form.reaction.reaction__form" do
+      assert_select "input.reaction__input[maxlength='16']"
+      assert_select "button.reaction__submit-btn[type='submit']"
+      assert_select "a.reaction__cancel-btn"
+    end
+  end
+
+  test "create via turbo stream" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal "👍", reaction.content
+    assert_select "turbo-stream[action='append'][target='#{dom_id(@comment, :reactions)}']"
+    assert_select "turbo-stream[action='replace'][target='#{dom_id(@comment, :new_reaction)}']"
+  end
+
+  test "create rejects blank and over-16-character content" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "   " } }, as: :turbo_stream
+    end
+    assert_response :unprocessable_entity
+
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+    end
+    assert_response :unprocessable_entity
+  end
+
+test "cannot access reactions on inaccessible card" do
+  sign_in_as :jz
+  private_card = nil
+  private_comment = nil
+
+  Current.set(user: users(:david)) do
+    private_board = Board.create!(name: "Private", creator: users(:david), all_access: false)
+    private_card = private_board.cards.create!(title: "Private card", creator: users(:david), status: :published)
+    private_comment = private_card.comments.create!(creator: users(:david), body: "Hidden")
+  end
+
+  post card_comment_reactions_path(private_card, private_comment), params: { reaction: { content: "👀" } }, as: :turbo_stream
+  assert_response :not_found
+end
+
+  test "destroy own reaction via turbo stream" do
+    reaction = @comment.reactions.create!(reacter: users(:kevin), content: "🎉")
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action='remove'][target='#{dom_id(reaction)}']"
+  end
+
+  test "cannot destroy another user's reaction" do
+    reaction = @comment.reactions.create!(reacter: users(:david), content: "🎉")
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "JSON API index, create (including flat params), and destroy" do
+    @comment.reactions.create!(reacter: users(:david), content: "👍")
+
+    get card_comment_reactions_path(@card, @comment), as: :json
+    assert_response :success
+    assert_equal 1, @response.parsed_body.size
+    assert_equal "👍", @response.parsed_body.first["content"]
+    assert_equal users(:david).id, @response.parsed_body.first.dig("reacter", "id")
+
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "Great 👍" }, as: :json
+    end
+    assert_response :created
+
+    own_reaction = @comment.reactions.find_by!(reacter: users(:kevin), content: "Great 👍")
+    delete card_comment_reaction_path(@card, @comment, own_reaction), as: :json
+    assert_response :no_content
+    assert_not Reaction.exists?(own_reaction.id)
+  end
+end
