diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..9f03258
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,52 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ destroy ]
+  before_action :ensure_permission_to_administer_reaction, only: %i[ destroy ]
+
+  def index
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to @card }
+      format.json { head :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to @card }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_permission_to_administer_reaction
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_delete_controller.js b/app/javascript/controllers/reaction_delete_controller.js
new file mode 100644
index 0000000..a00e72b
--- /dev/null
+++ b/app/javascript/controllers/reaction_delete_controller.js
@@ -0,0 +1,39 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "button" ]
+  static values = { reacterId: String }
+
+  connect() {
+    if (this.#canDelete) {
+      this.element.classList.add("reaction--deleteable")
+      this.element.setAttribute("tabindex", "0")
+    }
+  }
+
+  reveal(event) {
+    if (!this.#canDelete) return
+    if (this.hasButtonTarget && this.buttonTarget.contains(event.target)) return
+
+    if (event.type === "keydown") event.preventDefault()
+    this.element.classList.toggle("expanded")
+  }
+
+  hide() {
+    this.element.classList.remove("expanded")
+  }
+
+  hideOnClickOutside({ target }) {
+    if (!this.element.contains(target)) {
+      this.hide()
+    }
+  }
+
+  perform() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  get #canDelete() {
+    return Boolean(Current.user && this.reacterIdValue === Current.user.id)
+  }
+}
diff --git a/app/javascript/controllers/reaction_emoji_controller.js b/app/javascript/controllers/reaction_emoji_controller.js
new file mode 100644
index 0000000..ce94288
--- /dev/null
+++ b/app/javascript/controllers/reaction_emoji_controller.js
@@ -0,0 +1,34 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "input", "dialog", "cancel" ]
+
+  connect() {
+    this.inputTarget.focus()
+  }
+
+  insert(event) {
+    const emoji = event.currentTarget.value
+    const input = this.inputTarget
+    const start = input.selectionStart ?? input.value.length
+    const end = input.selectionEnd ?? input.value.length
+    const nextValue = input.value.slice(0, start) + emoji + input.value.slice(end)
+
+    if ([ ...nextValue ].length <= 16 && nextValue.length <= input.maxLength) {
+      input.setRangeText(emoji, start, end, "end")
+      input.dispatchEvent(new Event("input", { bubbles: true }))
+    }
+
+    input.focus()
+  }
+
+  cancel() {
+    if (this.hasDialogTarget && this.dialogTarget.open) {
+      this.dialogTarget.close()
+      this.dialogTarget.setAttribute("aria-hidden", "true")
+      this.inputTarget.focus()
+    } else {
+      this.cancelTarget?.click()
+    }
+  }
+}
