diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..b13bed5
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "validates presence and 16-character maximum of content" do
+    assert_not @comment.reactions.build(content: "").valid?
+    assert_not @comment.reactions.build(content: "   ").valid?
+    assert @comment.reactions.build(content: "👍").valid?
+    assert @comment.reactions.build(content: "a" * 16).valid?
+    assert @comment.reactions.build(content: "🔥" * 16).valid?
+    assert_not @comment.reactions.build(content: "a" * 17).valid?
+    assert_not @comment.reactions.build(content: "🔥" * 17).valid?
+  end
+
+  test "defaults account and reacter" do
+    reaction = @comment.reactions.create!(content: "Ship it!")
+
+    assert_equal @comment.account, reaction.account
+    assert_equal users(:david), reaction.reacter
+  end
+
+  test "detects emoji-only content" do
+    emoji_reaction = @comment.reactions.build(content: "👍🎉")
+    text_reaction = @comment.reactions.build(content: "Great 👍")
+
+    assert emoji_reaction.all_emoji?
+    assert_not text_reaction.all_emoji?
+  end
+
+  test "orders reactions chronologically" do
+    first = @comment.reactions.create!(content: "First", created_at: 2.minutes.ago)
+    second = @comment.reactions.create!(content: "Second", created_at: 1.minute.ago)
+
+    assert_equal [ first, second ], @comment.reactions.to_a
+  end
+
+  test "touches comment and card activity on create" do
+    card = @comment.card
+    travel 5.minutes do
+      assert_changes -> { card.reload.last_active_at } do
+        @comment.reactions.create!(content: "🙌")
+      end
+    end
+  end
+
+  test "broadcasts append on create and remove on destroy to card activity stream" do
+    card = @comment.card
+
+    reaction = nil
+    broadcasts = capture_turbo_stream_broadcasts([ card, :activity ]) do
+      reaction = @comment.reactions.create!(content: "🔥")
+    end
+    assert_equal 1, broadcasts.size
+    assert_includes broadcasts.first.to_s, "href=\"#{@comment.account.slug}/" if broadcasts.first.to_s.include?("href=")
+    assert_includes broadcasts.first.to_s, "action=\"#{@comment.account.slug}/cards/#{card.to_param}/comments/#{@comment.id}/reactions/#{reaction.id}\""
+
+    assert_turbo_stream_broadcasts([ card, :activity ], count: 1) do
+      reaction.destroy
+    end
+  end
+
+  test "destroying comment or user destroys associated reactions" do
+    reaction_1 = @comment.reactions.create!(reacter: users(:kevin), content: "👍")
+    other_comment = comments(:logo_agreement_kevin)
+    reaction_2 = other_comment.reactions.create!(reacter: users(:jz), content: "🎉")
+
+    assert_difference -> { Reaction.count }, -1 do
+      @comment.destroy
+    end
+    assert_not Reaction.exists?(reaction_1.id)
+
+    assert_difference -> { Reaction.count }, -1 do
+      users(:jz).destroy
+    end
+    assert_not Reaction.exists?(reaction_2.id)
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..e729788
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,154 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @card = cards(:layout)
+    @comment = comments(:layout_overflowing_david)
+  end
+
+  test "adding, canceling, and removing reactions on a comment" do
+    @comment.reactions.create!(reacter: users(:jz), content: "🔥")
+
+    sign_in_as(users(:kevin))
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      # Existing emoji-only reaction shows content with emoji classes and who left it
+      assert_selector ".reactions .reaction[title='JZ'] span.txt-small.txt-medium", text: "🔥"
+
+      # Clicking another user's reaction does not reveal a remove button
+      find(".reaction[title='JZ']").click
+      assert_no_selector ".reaction__delete"
+
+      # Clicking add button turns into focused input with confirm and cancel
+      find(".reactions__trigger").click
+      assert_no_selector ".reactions__trigger"
+      assert_selector "form.reaction.reaction__form .reaction__input:focus"
+
+      # Canceling via button closes input and brings back the add button
+      find(".reaction__cancel-btn").click
+      assert_no_selector "form.reaction.reaction__form"
+      assert_selector ".reactions__trigger"
+
+      # Escape closes emoji menu first, then Escape cancels input without navigating away from card
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      assert_selector "dialog.reaction__popup[open]"
+      send_keys :escape
+      assert_no_selector "dialog.reaction__popup[open]"
+      assert_selector "form.reaction.reaction__form .reaction__input:focus"
+      send_keys :escape
+      assert_no_selector "form.reaction.reaction__form"
+      assert_selector ".reactions__trigger"
+
+      # Input enforces 16-character maximum and confirming puts reaction in strip, removes input, restores button
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "12345678901234567890"
+      assert_equal "1234567890123456", find(".reaction__input").value
+      find(".reaction__submit-btn").click
+
+      assert_no_selector "form.reaction.reaction__form"
+      assert_selector ".reactions__trigger"
+      assert_selector ".reaction[title='Kevin'] span.txt-small:not(.txt-medium)", text: "1234567890123456"
+
+      # Add a second reaction using the emoji picker and Enter key
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      within ".reaction__emoji-list" do
+        click_button "Clapping"
+      end
+      send_keys :enter
+
+      assert_no_selector "form.reaction.reaction__form"
+      assert_selector ".reactions__trigger"
+      assert_selector ".reaction[title='Kevin'] span.txt-small.txt-medium", text: "👏"
+
+      # Clicking own reaction reveals remove button; clicking outside hides it; clicking delete removes it
+      own_reaction = find(".reaction[title='Kevin']", text: "1234567890123456")
+      assert_no_selector "##{own_reaction[:id]} .reaction__delete"
+      own_reaction.click
+      assert_selector "##{own_reaction[:id]} .reaction__delete"
+    end
+
+    # Click outside comment hides the delete button
+    find("h1").click
+    within "##{dom_id(@comment)}" do
+      assert_no_selector ".reaction__delete"
+
+      own_reaction = find(".reaction[title='Kevin']", text: "1234567890123456")
+      own_reaction.click
+      within "##{own_reaction[:id]}" do
+        find(".reaction__delete").click
+      end
+
+      assert_no_selector ".reaction[title='Kevin']", text: "1234567890123456"
+      assert_selector ".reaction[title='Kevin']", text: "👏"
+    end
+  end
+
+  test "everyone looking at the card sees reactions land and disappear without reloading, even while typing" do
+    Capybara.using_session(:david) do
+      sign_in_as(users(:david))
+      visit card_url(@card)
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+
+      # David opens his reaction input and starts typing
+      within "##{dom_id(@comment)}" do
+        find(".reactions__trigger").click
+        find(".reaction__input").fill_in with: "Agreed!"
+      end
+    end
+
+    Capybara.using_session(:kevin) do
+      sign_in_as(users(:kevin))
+      visit card_url(@card)
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+
+      within "##{dom_id(@comment)}" do
+        find(".reactions__trigger").click
+        find(".reaction__input").fill_in with: "🎉"
+        find(".reaction__submit-btn").click
+        assert_selector ".reaction[title='Kevin']", text: "🎉"
+      end
+    end
+
+    Capybara.using_session(:david) do
+      within "##{dom_id(@comment)}" do
+        # Kevin's reaction lands live while David's input stays intact!
+        assert_selector ".reaction[title='Kevin']", text: "🎉", wait: 5
+        assert_equal "Agreed!", find(".reaction__input").value
+
+        # David cannot delete Kevin's newly broadcast reaction
+        find(".reaction[title='Kevin']", text: "🎉").click
+        assert_no_selector ".reaction__delete"
+
+        # David submits his reaction too
+        find(".reaction__submit-btn").click
+        assert_selector ".reaction[title='David']", text: "Agreed!"
+      end
+    end
+
+    Capybara.using_session(:kevin) do
+      within "##{dom_id(@comment)}" do
+        # Kevin sees David's reaction land without reloading
+        assert_selector ".reaction[title='David']", text: "Agreed!", wait: 5
+
+        # Kevin removes his own reaction
+        find(".reaction[title='Kevin']", text: "🎉").click
+        find(".reaction__delete").click
+        assert_no_selector ".reaction[title='Kevin']", text: "🎉"
+      end
+    end
+
+    Capybara.using_session(:david) do
+      within "##{dom_id(@comment)}" do
+        assert_no_selector ".reaction[title='Kevin']", text: "🎉", wait: 5
+        assert_selector ".reaction[title='David']", text: "Agreed!"
+      end
+    end
+  end
+end
