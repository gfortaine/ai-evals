new file mode 100644
index 0000000..bd8c6f0
--- /dev/null
+++ b/app/views/cards/comments/reactions/new.html.erb
@@ -0,0 +1,67 @@
+<%= turbo_frame_tag @comment, :new_reaction do %>
+  <%= form_with model: [ @card, @comment, Reaction.new ],
+        class: "reaction reaction__form expanded",
+        data: {
+          controller: "form reaction-emoji morph-guard",
+          action: "keydown.esc->reaction-emoji#cancel:stop submit->form#preventEmptySubmit submit->form#preventComposingSubmit"
+        } do |form| %>
+    <label class="reaction__form-label flex align-center gap-half">
+      <figure class="reaction__avatar margin-none flex-item-no-shrink" style="--avatar-size: auto;">
+        <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %>
+      </figure>
+
+      <span class="for-screen-reader">Reaction</span>
+      <%= form.text_field :content,
+            autofocus: true,
+            autocomplete: "off",
+            autocorrect: "off",
+            maxlength: 16,
+            required: true,
+            class: "input reaction__input txt-small",
+            data: {
+              form_target: "input",
+              reaction_emoji_target: "input",
+              "1p-ignore": "true",
+              action: "compositionstart->form#compositionStart compositionend->form#compositionEnd"
+            } %>
+    </label>
+
+    <div class="reaction__menu" data-controller="dialog" data-action="click@document->dialog#closeOnClickOutside">
+      <%= button_tag type: "button",
+            class: "reaction__menu-btn btn btn--plain",
+            data: { controller: "tooltip", action: "dialog#toggle" } do %>
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Emoji menu</span>
+      <% end %>
+
+      <dialog class="reaction__popup popup panel shadow" data-dialog-target="dialog" data-reaction-emoji-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <%= button_tag type: "button",
+                  value: emoji,
+                  class: "btn btn--circle borderless",
+                  data: { action: "reaction-emoji#insert dialog#close" } do %>
+              <span><%= emoji %></span>
+              <span class="for-screen-reader"><%= label %></span>
+            <% end %>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button type: "submit",
+          class: "reaction__submit-btn btn btn--plain",
+          data: { controller: "tooltip", form_target: "submit" } do %>
+      <%= icon_tag "check-circle" %>
+      <span class="for-screen-reader">Add reaction</span>
+    <% end %>
+
+    <%= link_to card_comment_reactions_path(@card, @comment),
+          role: "button",
+          class: "reaction__cancel-btn btn btn--plain",
+          data: { controller: "tooltip", form_target: "cancel", reaction_emoji_target: "cancel" } do %>
+      <%= icon_tag "close-circle" %>
+      <span class="for-screen-reader">Cancel</span>
+    <% end %>
+  <% end %>
+<% end %>
