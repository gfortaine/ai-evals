+
+    get public_board_columns_stream_path(board.publication.key)
+    assert_response :success
+    assert_select "##{dom_id(card, :bubble)}:not([hidden])", text: /Stalled for.*16.*days/m
+
+    get public_board_card_path(board.publication.key, card)
+    assert_response :success
+    assert_select "##{dom_id(card, :bubble)}:not([hidden])", text: /Stalled for.*16.*days/m
+
+    # Triage into a column resets stalled state; after another 2 weeks it shows in that column too
