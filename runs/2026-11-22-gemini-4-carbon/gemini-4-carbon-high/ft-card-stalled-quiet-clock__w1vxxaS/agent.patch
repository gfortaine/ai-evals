--- /dev/null
+++ b/test/system/stalled_cards_test.rb
@@ -0,0 +1,39 @@
+require "application_system_test_case"
+
+class StalledCardsTest < ApplicationSystemTestCase
+  test "stalled card shows stalled bubble on board, index, and card page and resets on activity" do
+    board = boards(:writebook)
+    card = with_current_user(:david) do
+      board.cards.create!(title: "Needs follow-up", creator: users(:david), status: :published).tap do |c|
+        c.toggle_assignment(users(:kevin))
+        c.update!(last_active_at: 15.days.ago)
+      end
+    end
+
+    sign_in_as(users(:david))
+
+    visit board_url(board)
+    within("##{dom_id(card, :bubble)}") do
+      assert_text "STALLED FOR"
+      assert_text "15"
+      assert_text "DAYS"
+    end
+
+    visit cards_url(indexed_by: :stalled)
+    assert_selector "h3", text: "Needs follow-up"
+    within("##{dom_id(card, :bubble)}") do
+      assert_text "15"
+    end
+
+    visit card_url(card)
+    assert_selector "##{dom_id(card, :bubble)}", visible: true
+
+    fill_in_lexxy with: "Picking this back up!"
+    click_on "Post"
+
+    assert_no_selector "##{dom_id(card, :bubble)}", visible: true
+
+    visit cards_url(indexed_by: :stalled)
+    assert_no_selector "h3", text: "Needs follow-up"
+  end
+end
