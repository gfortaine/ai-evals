diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..f6fd7c6
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,282 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "card without a burst is not stalled after two weeks of inactivity" do
+    freeze_time
+
+    card = boards(:writebook).cards.create!(title: "Quiet card", status: :published)
+
+    travel 3.weeks
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "card gets a burst when someone is assigned and stalls after two weeks" do
+    freeze_time
+
+    card = boards(:writebook).cards.create!(title: "Assigned card", status: :published)
+    card.toggle_assignment(users(:kevin))
+
+    assert_not card.stalled?
+    assert_equal 0, card.stalled_for_days
+
+    travel 2.weeks - 1.second
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+
+    travel 1.second
+    assert card.stalled?
+    assert_equal 14, card.stalled_for_days
+    assert_includes Card.stalled, card
+    assert_includes Card.indexed_by("stalled"), card
+  end
+
+  test "card gets a burst when reopened and stalls after two weeks" do
+    freeze_time
+
+    card = cards(:shipping)
+    assert card.closed?
+
+    card.reopen
+    assert_not card.stalled?
+
+    travel 2.weeks
+    assert card.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "card gets a burst when three or more comments from at least two people land within a third of board auto-close period" do
+    freeze_time
+
+    board = boards(:private) # 30 days auto-close period -> 10 days window
+    card = board.cards.create!(title: "Discussed card", status: :published)
+
+    card.comments.create!(creator: users(:david), body: "First comment")
+    travel 5.days
+    card.comments.create!(creator: users(:kevin), body: "Second comment")
+    travel 5.days
+    card.comments.create!(creator: users(:david), body: "Third comment")
+
+    assert_not card.reload.stalled?
+
+    travel 2.weeks
+    assert card.reload.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "comment burst respects board auto-close override and account default" do
+    freeze_time
+
+    board = boards(:writebook)
+    board.update!(auto_postpone_period_in_days: 3) # 3 days -> 1 day window
+
+    too_slow = board.cards.create!(title: "Too slow for 3-day board", status: :published)
+    too_slow.comments.create!(creator: users(:david), body: "One")
+    travel 12.hours
+    too_slow.comments.create!(creator: users(:kevin), body: "Two")
+    travel 13.hours # 25 hours total > 1 day
+    too_slow.comments.create!(creator: users(:david), body: "Three")
+
+    fast_enough = board.cards.create!(title: "Fast enough for 3-day board", status: :published)
+    fast_enough.comments.create!(creator: users(:david), body: "One")
+    travel 12.hours
+    fast_enough.comments.create!(creator: users(:kevin), body: "Two")
+    travel 12.hours # 24 hours total <= 1 day
+    fast_enough.comments.create!(creator: users(:david), body: "Three")
+
+    travel 2.weeks
+    assert_not too_slow.reload.stalled?
+    assert fast_enough.reload.stalled?
+
+    # Falls back to account default when board entropy override is absent
+    entropies(:writebook_board).destroy
+    entropies("37s_account").update!(auto_postpone_period: 90.days) # 90 days -> 30 days window
+    board.reload
+
+    account_default_card = board.cards.create!(title: "Uses account default", status: :published)
+    account_default_card.comments.create!(creator: users(:david), body: "One")
+    travel 15.days
+    account_default_card.comments.create!(creator: users(:kevin), body: "Two")
+    travel 15.days # 30 days <= 30 days
+    account_default_card.comments.create!(creator: users(:david), body: "Three")
+
+    travel 2.weeks
+    assert account_default_card.reload.stalled?
+  end
+
+  test "three comments from one person do not trigger a burst until a second person comments within window" do
+    freeze_time
+
+    board = boards(:private) # 30 days -> 10 days window
+    card = board.cards.create!(title: "Monologue then reply", status: :published)
+
+    3.times do |i|
+      card.comments.create!(creator: users(:david), body: "Comment #{i}")
+    end
+
+    travel 2.weeks
+    assert_not card.reload.stalled?
+
+    # Now way outside the original 10-day window, a single reply is only 1 comment in the last 10 days
+    card.comments.create!(creator: users(:kevin), body: "Late single reply")
+    travel 2.weeks
+    assert_not card.reload.stalled?
+
+    # Within 10 days, 3 comments by David + 1 by Kevin = 4 comments from 2 people -> burst!
+    3.times { |i| card.comments.create!(creator: users(:david), body: "Burst #{i}") }
+    travel 2.days
+    card.comments.create!(creator: users(:kevin), body: "Joining in")
+
+    travel 2.weeks
+    assert card.reload.stalled?
+  end
+
+  test "two user comments plus system comments do not trigger a burst" do
+    freeze_time
+
+    card = boards(:writebook).cards.create!(title: "System comment card", status: :published)
+    card.triage_into(columns(:writebook_in_progress)) # creates a system comment
+    card.comments.create!(creator: users(:david), body: "First")
+    card.comments.create!(creator: users(:kevin), body: "Second")
+
+    assert_operator card.comments.count, :>=, 3
+
+    travel 3.weeks
+    assert_not card.reload.stalled?
+  end
+
+  test "comments spread beyond a third of board auto-close period do not trigger a burst" do
+    freeze_time
+
+    board = boards(:private) # 30 days auto-close period -> 10 days window
+    card = board.cards.create!(title: "Slow thread", status: :published)
+
+    card.comments.create!(creator: users(:david), body: "First")
+    travel 6.days
+    card.comments.create!(creator: users(:kevin), body: "Second")
+    travel 4.days + 1.second
+    card.comments.create!(creator: users(:david), body: "Third")
+
+    travel 3.weeks
+    assert_not card.reload.stalled?
+  end
+
+  test "closed, postponed, and drafted cards are not stalled" do
+    freeze_time
+
+    closed_card = boards(:writebook).cards.create!(title: "Will close", status: :published)
+    closed_card.toggle_assignment(users(:kevin))
+    closed_card.close
+
+    postponed_card = boards(:writebook).cards.create!(title: "Will postpone", status: :published)
+    postponed_card.toggle_assignment(users(:kevin))
+    postponed_card.postpone
+
+    drafted_card = boards(:writebook).cards.create!(title: "Still draft", status: :drafted)
+    drafted_card.toggle_assignment(users(:kevin))
+
+    travel 3.weeks
+
+    assert_not closed_card.reload.stalled?
+    assert_not postponed_card.reload.stalled?
+    assert_not drafted_card.reload.stalled?
+    assert_not_includes Card.stalled, closed_card
+    assert_not_includes Card.stalled, postponed_card
+    assert_not_includes Card.stalled, drafted_card
+  end
+
+  test "passive viewer actions like reading, pinning, and watching do not reset a stalled card" do
+    freeze_time
+
+    card = boards(:writebook).cards.create!(title: "Watched stalled card", status: :published)
+    card.toggle_assignment(users(:kevin))
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    card.read_by(users(:jz))
+    card.pin_by(users(:jz))
+    card.watch_by(users(:jz))
+
+    assert card.reload.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "any activity on a stalled card resets it" do
+    freeze_time
+
+    card = boards(:writebook).cards.create!(title: "Stallable card", status: :published)
+    card.toggle_assignment(users(:kevin))
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    comment = card.comments.create!(creator: users(:kevin), body: "Back on this")
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    comment.reactions.create!(content: "🎉")
+    assert_not card.reload.stalled?
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    step = card.steps.create!(content: "First step")
+    assert_not card.reload.stalled?
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    step.update!(completed: true)
+    assert_not card.reload.stalled?
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    step.destroy!
+    assert_not card.reload.stalled?
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    card.toggle_tag_with("urgent")
+    assert_not card.reload.stalled?
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    card.reactions.create!(content: "👍")
+    assert_not card.reload.stalled?
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    card.gild
+    assert_not card.reload.stalled?
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    card.triage_into(columns(:writebook_in_progress))
+    assert_not card.reload.stalled?
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    card.update!(description: "Updated description")
+    assert_not card.reload.stalled?
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    card.update!(title: "Updated title")
+    assert_not card.reload.stalled?
+  end
+end
