+require "test_helper"
+require "open3"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  test "runner prints library report to stdout and records it in development log" do
+    with_development_library do |log_path|
+      stdout, _stderr, status = run_library_report
+
+      assert_predicate status, :success?
+
+      expected = [
+        "Library report: 2 books",
+        "Library report: Manual has no pages",
+        "Library report: Handbook has 4 pages",
+        "Library report: done"
+      ]
+
+      assert_equal expected, report_lines(stdout)
+      assert_equal expected, report_lines(log_path.read)
+    end
+  end
+
+  test "runner respects configured log level on both stdout and development log" do
+    with_development_library do |log_path|
+      stdout, _stderr, status = run_library_report("LOG_LEVEL" => "warn")
+
+      assert_predicate status, :success?
+
+      expected = [ "Library report: Manual has no pages" ]
+
+      assert_equal expected, report_lines(stdout)
+      assert_equal expected, report_lines(log_path.read)
+    end
+  end
+
+  test "runner does not duplicate stdout logging when logger already outputs to stdout" do
+    stdout, _stderr, status = Bundler.with_unbundled_env do
+      Open3.capture3(
+        { "RAILS_ENV" => nil, "SECRET_KEY_BASE" => "dummy" },
+        Rails.root.join("bin/rails").to_s, "runner", "-e", "production", 'Rails.logger.info "Library report: check"',
+        chdir: Rails.root.to_s
+      )
+    end
+
+    assert_predicate status, :success?
+    assert_equal 1, stdout.lines.grep(/Library report: check/).size
+  end
+
+  private
+    def run_library_report(env = {})
+      Bundler.with_unbundled_env do
+        Open3.capture3(
+          { "RAILS_ENV" => nil }.merge(env),
+          Rails.root.join("bin/rails").to_s, "runner", "-e", "development", "script/library_report.rb",
+          chdir: Rails.root.to_s
+        )
+      end
+    end
+
+    def report_lines(output)
+      output.lines(chomp: true).grep(/\ALibrary report:/)
+    end
+
+    def with_development_library
+      lock_path = Rails.root.join("tmp/library_report_test.lock")
+      FileUtils.mkdir_p(lock_path.dirname)
+
+      File.open(lock_path, File::RDWR | File::CREAT, 0o644) do |lock|
+        lock.flock(File::LOCK_EX)
+
+        db_path = Rails.root.join("storage/db/development.sqlite3")
+        log_path = Rails.root.join("log/development.log")
+        FileUtils.mkdir_p(db_path.dirname)
+        FileUtils.mkdir_p(log_path.dirname)
+
+        db_backup = db_path.exist? ? db_path.binread : nil
+        log_backup = log_path.exist? ? log_path.binread : nil
+
+        begin
+          seed_development_database(db_path)
+          File.write(log_path, "")
+
+          yield log_path
+        ensure
+          restore_file(db_path, db_backup)
+          restore_file(log_path, log_backup)
+        end
+      end
+    end
+
+    def seed_development_database(db_path)
+      source_db = Book.connection.raw_connection
+      SQLite3::Database.new(db_path.to_s) do |dest_db|
+        backup = SQLite3::Backup.new(dest_db, "main", source_db, "main")
+        backup.step(-1)
+        backup.finish
+      end
+    end
+
+    def restore_file(path, contents)
+      if contents.nil?
+        FileUtils.rm_f(path)
+      else
+        path.binwrite(contents)
+      end
+    end
+end
