+class NotificationMailerPreview < ActionMailer::Preview
+  def bundled
+    user = User.joins(:notifications).merge(Notification.unread).first || User.active.first
+    Current.account = user.account
+
+    bundle = Notification::Bundle.new(
+      user: user,
+      account: user.account,
+      starts_at: 4.hours.ago,
+      ends_at: Time.current
+    )
+    bundle.notifications = user.notifications.unread.limit(5)
+
+    NotificationMailer.bundled(bundle)
+  end
+end
