--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+    @user.settings.update!(bundle_email_frequency: :daily, timezone_name: "America/New_York")
+  end
+
+  test "bundled email renders events and mentions grouped by board with HTML and text parts" do
+    travel_to Time.utc(2026, 3, 1, 15, 0, 0) do
+      Notification.create!(user: @user, source: events(:logo_assignment_km), creator: users(:david))
+      mention = @user.mentioned_by(users(:jz), at: comments(:layout_overflowing_david))
+      Notification.create!(user: @user, source: mention, creator: users(:jz))
+    end
+
+    bundle = @user.notification_bundles.last
+    email = NotificationMailer.bundled(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "Fizzy: 2 new notifications", email.subject
+    assert email.html_part.present?
+    assert email.text_part.present?
+    assert email["List-Unsubscribe"].present?
+    assert_equal "List-Unsubscribe=One-Click", email["List-Unsubscribe-Post"].value
+
+    html = CGI.unescapeHTML(email.html_part.body.decoded)
+    text = email.text_part.body.decoded
+
+    assert_includes html, boards(:writebook).name
+    assert_includes html, cards(:logo).title
+    assert_includes html, "@mentioned you"
+    assert_includes html, "10:00 AM" # 15:00 UTC in America/New_York (EST)
+    assert_includes html, @user.account.slug
+    assert_includes html, "/notifications/unsubscribe"
+
+    assert_includes text, boards(:writebook).name
+    assert_includes text, cards(:logo).title
+    assert_includes text, "@mentioned you"
+    assert_includes text, "/notifications/unsubscribe"
+  end
+
+  test "singular subject when bundle has 1 notification" do
+    Notification.create!(user: @user, source: events(:logo_assignment_km), creator: users(:david))
+    bundle = @user.notification_bundles.last
+
+    email = NotificationMailer.bundled(bundle)
+    assert_equal "Fizzy: 1 new notification", email.subject
+  end
+end
