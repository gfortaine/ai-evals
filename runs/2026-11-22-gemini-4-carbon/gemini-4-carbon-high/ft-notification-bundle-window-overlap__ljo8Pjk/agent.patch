diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..69a0028
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,95 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :entries, class_name: "Notification::Bundle::Entry", foreign_key: :bundle_id, inverse_of: :bundle, dependent: :delete_all
+  has_many :notifications, through: :entries
+
+  enum :status, %w[ pending processing delivered ].index_by(&:itself), default: :pending
+
+  scope :due, -> { pending.where(ends_at: ..Time.current) }
+  scope :overlapping_with, ->(bundle) {
+    where(user_id: bundle.user_id)
+      .where.not(id: bundle.id)
+      .where("starts_at < ? AND ends_at > ?", bundle.ends_at, bundle.starts_at)
+  }
+  scope :containing, ->(time) { where(starts_at: ..time, ends_at: time..) }
+
+  before_validation :set_default_window, on: :create
+
+  validates :starts_at, :ends_at, presence: true
+  validate :validate_window_order
+  validate :validate_not_overlapping
+
+  class << self
+    def deliver_all_later
+      due.find_each(&:deliver_later)
+    end
+
+    def deliver_all
+      due.find_each(&:deliver)
+    end
+  end
+
+  def window
+    starts_at..ends_at
+  end
+
+  def deliver_later
+    processing!
+    Current.with_account(account) do
+      Notification::Bundle::DeliverJob.perform_later(self)
+    end
+  end
+
+  def deliver
+    with_lock do
+      return if delivered?
+      processing!
+
+      if deliverable?
+        Current.with_account(account) do
+          NotificationMailer.bundled(self).deliver_now
+        end
+      end
+
+      delivered!
+    end
+  rescue
+    pending! if processing?
+    raise
+  end
+
+  private
+    def set_default_window
+      if user
+        self.starts_at ||= [ Time.current, user.notification_bundles.maximum(:ends_at) ].compact.max
+        self.ends_at ||= starts_at + default_period if starts_at
+      end
+    end
+
+    def default_period
+      User::Settings.find_by(user_id: user.id)&.bundle_email_period || 4.hours
+    end
+
+    def validate_window_order
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after starts_at")
+      end
+    end
+
+    def validate_not_overlapping
+      if starts_at.present? && ends_at.present? && self.class.overlapping_with(self).exists?
+        errors.add(:base, "Notification bundle window cannot overlap with an existing window")
+      end
+    end
+
+    def deliverable?
+      fresh_user = user.reload
+      fresh_account = account.reload
+      settings = User::Settings.find_by(user_id: user_id)
+
+      fresh_user.active? && !fresh_user.system? && fresh_user.identity.present? &&
+        fresh_account.active? && settings&.bundling_emails? && notifications.unread.any?
+    end
+end
