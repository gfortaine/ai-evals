--- a/app/models/user/settings.rb
+++ b/app/models/user/settings.rb
@@ -2,6 +2,10 @@ class User::Settings < ApplicationRecord
   belongs_to :account, default: -> { user.account }
   belongs_to :user
 
+  enum :bundle_email_frequency, %w[ never every_few_hours daily weekly ].index_by(&:itself), default: :never, validate: true
+
+  after_update :update_pending_bundles, if: :saved_change_to_bundle_email_frequency?
+
   def timezone
     if timezone_name.present?
       ActiveSupport::TimeZone[timezone_name] || default_timezone
@@ -10,8 +14,38 @@ class User::Settings < ApplicationRecord
     end
   end
 
+  def bundling_emails?
+    !never?
+  end
+
+  def bundle_email_period
+    case bundle_email_frequency
+    when "every_few_hours" then 4.hours
+    when "daily" then 1.day
+    when "weekly" then 1.week
+    end
+  end
+
   private
     def default_timezone
       ActiveSupport::TimeZone["UTC"]
     end
+
+    def update_pending_bundles
+      user.with_lock do
+        if never?
+          user.notification_bundles.pending.destroy_all
+        else
+          reschedule_open_bundle
+        end
+      end
+    end
+
+    def reschedule_open_bundle
+      if open_bundle = user.notification_bundles.pending.where("ends_at > ?", Time.current).order(:starts_at).last
+        later_starts_at = user.notification_bundles.where.not(id: open_bundle.id).where("starts_at >= ?", open_bundle.ends_at).minimum(:starts_at)
+        new_ends_at = [ open_bundle.starts_at + bundle_email_period, later_starts_at ].compact.min
+        open_bundle.update!(ends_at: new_ends_at)
+      end
+    end
 end
