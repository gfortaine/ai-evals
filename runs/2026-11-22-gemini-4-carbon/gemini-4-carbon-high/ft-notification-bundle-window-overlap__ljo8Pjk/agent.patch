+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @settings = @user.settings
+  end
+
+  test "bundle_email_frequency defaults to never" do
+    user = User.create!(account: accounts("37s"), name: "New Person")
+    assert_equal "never", user.settings.bundle_email_frequency
+    assert user.settings.never?
+    assert_not user.settings.bundling_emails?
+    assert_nil user.settings.bundle_email_period
+  end
+
+  test "bundle_email_frequency supports never, every_few_hours, daily, and weekly" do
+    @settings.every_few_hours!
+    assert_equal "every_few_hours", @settings.bundle_email_frequency
+    assert_equal 4.hours, @settings.bundle_email_period
+    assert @settings.bundling_emails?
+
+    @settings.daily!
+    assert_equal "daily", @settings.bundle_email_frequency
+    assert_equal 1.day, @settings.bundle_email_period
+
+    @settings.weekly!
+    assert_equal "weekly", @settings.bundle_email_frequency
+    assert_equal 1.week, @settings.bundle_email_period
+
+    @settings.never!
+    assert_equal "never", @settings.bundle_email_frequency
+    assert_nil @settings.bundle_email_period
+  end
+
+  test "rejects invalid bundle_email_frequency" do
+    @settings.bundle_email_frequency = "hourly"
+    assert_not @settings.valid?
+    assert_includes @settings.errors[:bundle_email_frequency], "is not included in the list"
+  end
+
+  test "switching to never cancels pending bundles" do
+    @user.notifications.destroy_all
+    @settings.every_few_hours!
+
+    Notification.create!(user: @user, source: events(:logo_published), creator: users(:david))
+    assert_equal 1, @user.notification_bundles.pending.count
+
+    @settings.never!
+    assert_empty @user.notification_bundles.pending
+  end
+
+  test "changing frequency reschedules open pending bundle" do
+    @user.notifications.destroy_all
+    @settings.weekly!
+
+    travel_to Time.utc(2026, 3, 1, 10, 0, 0) do
+      Notification.create!(user: @user, source: events(:logo_published), creator: users(:david))
+      bundle = @user.notification_bundles.last
+      assert_equal Time.utc(2026, 3, 8, 10, 0, 0), bundle.ends_at
+
+      @settings.every_few_hours!
+      assert_equal Time.utc(2026, 3, 1, 14, 0, 0), bundle.reload.ends_at
+
+      @settings.daily!
+      assert_equal Time.utc(2026, 3, 2, 10, 0, 0), bundle.reload.ends_at
+    end
+  end
+end
