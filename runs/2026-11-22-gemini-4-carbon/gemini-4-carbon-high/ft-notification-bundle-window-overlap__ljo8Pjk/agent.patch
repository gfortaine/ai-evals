diff --git a/app/models/notification/bundled.rb b/app/models/notification/bundled.rb
new file mode 100644
index 0000000..763f5a9
--- /dev/null
+++ b/app/models/notification/bundled.rb
@@ -0,0 +1,58 @@
+module Notification::Bundled
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :bundle_entries, class_name: "Notification::Bundle::Entry", dependent: :delete_all
+    has_many :bundles, through: :bundle_entries, class_name: "Notification::Bundle"
+
+    after_save :bundle, if: :saved_change_to_source_id?
+  end
+
+  def bundle
+    return unless bundlable_notification?
+
+    user.with_lock do
+      settings = User::Settings.find_by(user_id: user_id)
+      if user.active? && account.reload.active? && settings&.bundling_emails?
+        target_bundle = find_open_bundle || open_bundle(settings.bundle_email_period)
+        target_bundle.entries.create_or_find_by!(notification: self)
+        target_bundle
+      end
+    end
+  end
+
+  private
+    def bundlable_notification?
+      !read? && !creator.system? && !user.system? && User::Settings.where(user_id: user_id).where.not(bundle_email_frequency: :never).exists?
+    end
+
+    def find_open_bundle
+      user.notification_bundles.pending.where("ends_at > ?", occurred_at).order(:starts_at).first
+    end
+
+    def open_bundle(period)
+      starts_at = next_bundle_starts_at
+      user.notification_bundles.create!(
+        starts_at: starts_at,
+        ends_at: starts_at + period
+      )
+    end
+
+    def next_bundle_starts_at
+      latest_ends_at = user.notification_bundles.maximum(:ends_at)
+
+      if latest_ends_at && occurred_at < latest_ends_at
+        [ Time.current, latest_ends_at ].max
+      else
+        occurred_at
+      end
+    end
+
+    def occurred_at
+      if saved_change_to_id? || id_previously_changed?
+        created_at
+      else
+        updated_at
+      end
+    end
+end
