--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,33 @@
+class NotificationMailer < ApplicationMailer
+  helper NotificationsHelper
+
+  def bundled(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.notifications.unread.ordered.preloaded.preload(creator: :avatar_attachment)
+
+    Current.with_account(@account) do
+      @user.in_time_zone do
+        @unsubscribe_url = notifications_unsubscribe_url(access_token: @user.generate_token_for(:unsubscribe))
+
+        headers["List-Unsubscribe-Post"] = "List-Unsubscribe=One-Click"
+        headers["List-Unsubscribe"] = "<#{@unsubscribe_url}>"
+
+        mail(
+          to: @user.identity.email_address,
+          subject: bundle_subject(@notifications.size)
+        )
+      end
+    end
+  end
+
+  private
+    def bundle_subject(count)
+      if count == 1
+        "Fizzy: 1 new notification"
+      else
+        "Fizzy: #{count} new notifications"
+      end
+    end
+end
