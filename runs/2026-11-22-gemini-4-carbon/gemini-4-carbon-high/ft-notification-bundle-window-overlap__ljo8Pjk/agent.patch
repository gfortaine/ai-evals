+require "test_helper"
+
+class Notifications::UnsubscribesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:kevin)
+    @user.settings.daily!
+    @token = @user.generate_token_for(:unsubscribe)
+  end
+
+  test "show renders confirmation without mutating settings" do
+    get notifications_unsubscribe_path(access_token: @token)
+
+    assert_response :success
+    assert @user.settings.reload.daily?
+  end
+
+  test "create sets bundle_email_frequency to never without requiring authentication" do
+    @user.notifications.destroy_all
