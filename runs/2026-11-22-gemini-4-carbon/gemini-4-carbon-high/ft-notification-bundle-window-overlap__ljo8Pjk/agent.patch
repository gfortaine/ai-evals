+<tr>
+  <td>
+    <h1 class="title">New notifications in <%= @account.name %></h1>
+    <p class="subtitle">Since <%= @bundle.starts_at.strftime("%B %-d at %-I:%M %p %Z") %></p>
+
+    <% @notifications.group_by { |notification| notification.card.board }.each_with_index do |(board, notifications), index| %>
+      <% if index > 0 %>
+        <hr class="notification__board-separator">
+      <% end %>
+
+      <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+      <% notifications.each do |notification| %>
+        <table class="notification">
+          <tr>
+            <td class="avatar__container">
+              <%= mail_avatar_tag(notification.creator) %>
+            </td>
+            <td>
+              <% case notification.source %>
+              <% when Mention %>
+                <% mention = notification.source %>
+                <h3 class="card__title"><%= link_to(notification.card.title.presence || "Card #{notification.card.number}", polymorphic_url(notification)) %></h3>
+                <p class="notification__details">
+                  <span class="notificaton__mention"><%= mention.mentioner.first_name %> @mentioned you</span>
+                  <%= mention.source.mentionable_content.truncate(200) %>
+                </p>
+              <% when Event %>
+                <% event = notification.source %>
+                <h3 class="card__title"><%= link_to event_notification_title(event), polymorphic_url(notification) %></h3>
+                <p class="notification__details"><%= event_notification_body(event) %></p>
+              <% else %>
+                <h3 class="card__title"><%= link_to notification.payload.title, polymorphic_url(notification) %></h3>
+                <p class="notification__details"><%= notification.payload.body %></p>
+              <% end %>
+              <p class="notification__author">
+                <%= notification.creator.name %> &bull; <%= notification.updated_at.strftime("%-I:%M %p") %><%= " (#{notification.unread_count} unread)" if notification.unread_count > 1 %>
+              </p>
+            </td>
+          </tr>
+        </table>
+      <% end %>
+    <% end %>
+
+    <p class="footer">
+      <%= link_to "Notification settings", notifications_settings_url %> &bull;
+      <%= link_to "Unsubscribe from email notifications", @unsubscribe_url %>
+    </p>
+  </td>
+</tr>
