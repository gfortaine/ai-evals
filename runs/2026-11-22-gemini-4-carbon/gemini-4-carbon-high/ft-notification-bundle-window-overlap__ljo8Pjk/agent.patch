diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..77a39f2
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,413 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @creator = users(:david)
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+  end
+
+  test "does not create a bundle when bundle_email_frequency is never" do
+    @user.settings.never!
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    end
+  end
+
+  test "clock starts when the first notification lands for every_few_hours" do
+    @user.settings.every_few_hours!
+    start_time = Time.utc(2026, 3, 1, 10, 15, 0)
+
+    travel_to start_time do
+      notification = Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+
+      assert_equal 1, @user.notification_bundles.count
+      bundle = @user.notification_bundles.last
+      assert bundle.pending?
+      assert_equal start_time, bundle.starts_at
+      assert_equal start_time + 4.hours, bundle.ends_at
+      assert_equal [ notification ], bundle.notifications.to_a
+    end
+  end
+
+  test "clock starts when the first notification lands for daily and weekly" do
+    start_time = Time.utc(2026, 3, 1, 9, 30, 0)
+
+    @user.settings.daily!
+    travel_to start_time do
+      Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+      bundle = @user.notification_bundles.last
+      assert_equal start_time, bundle.starts_at
+      assert_equal start_time + 1.day, bundle.ends_at
+    end
+
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+    @user.settings.weekly!
+
+    travel_to start_time do
+      Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+      bundle = @user.notification_bundles.last
+      assert_equal start_time, bundle.starts_at
+      assert_equal start_time + 1.week, bundle.ends_at
+    end
+  end
+
+  test "batches multiple notifications within the open window and sends one email when due" do
+    @user.settings.every_few_hours!
+    start_time = Time.utc(2026, 3, 1, 10, 0, 0)
+
+    n1 = travel_to(start_time) do
+      Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    end
+
+    n2 = travel_to(start_time + 2.hours) do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+    end
+
+    assert_equal 1, @user.notification_bundles.count
+    bundle = @user.notification_bundles.last
+    assert_equal start_time, bundle.starts_at
+    assert_equal start_time + 4.hours, bundle.ends_at
+    assert_equal [ n1, n2 ].sort_by(&:id), bundle.notifications.sort_by(&:id)
+
+    # Not due yet before 4 hours
+    travel_to(start_time + 3.hours + 59.minutes) do
+      assert_no_emails do
+        Notification::Bundle.deliver_all
+      end
+      assert bundle.reload.pending?
+    end
+
+    # Due once 4-hour window closes: sends exactly one email containing both
+    travel_to(start_time + 4.hours) do
+      assert_emails 1 do
+        Notification::Bundle.deliver_all
+      end
+      assert bundle.reload.delivered?
+    end
+  end
+
+  test "late-arriving notifications belong in the window that has already opened without overlapping" do
+    @user.settings.every_few_hours!
+    window_start = Time.utc(2026, 3, 1, 10, 0, 0)
+
+    first = travel_to(window_start) do
+      Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    end
+
+    late = travel_to(window_start + 5.minutes) do
+      Notification.create!(
+        user: @user,
+        source: events(:layout_commented),
+        creator: @creator,
+        created_at: window_start - 15.minutes,
+        updated_at: window_start - 15.minutes
+      )
+    end
+
+    assert_equal 1, @user.notification_bundles.count
+    bundle = @user.notification_bundles.last
+    assert_equal window_start, bundle.starts_at
+    assert_equal window_start + 4.hours, bundle.ends_at
+    assert_includes bundle.notifications, first
+    assert_includes bundle.notifications, late
+  end
+
+  test "late-arriving notification after a delivered window belongs to the currently open window without overlapping" do
+    @user.settings.every_few_hours!
+    t0 = Time.utc(2026, 3, 1, 6, 0, 0)
+
+    travel_to(t0) do
+      Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    end
+
+    travel_to(t0 + 4.hours) do
+      Notification::Bundle.deliver_all
+    end
+
+    first_bundle = @user.notification_bundles.first
+    assert first_bundle.delivered?
+
+    # Open second window at 10:10
+    second_window_start = t0 + 4.hours + 10.minutes
+    travel_to(second_window_start) do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+    end
+
+    # Late notification with timestamp from 09:50 (during already-delivered first window!) arrives at 10:12
+    late = travel_to(second_window_start + 2.minutes) do
+      Notification.create!(
+        user: @user,
+        source: events(:buy_domain_sent_back_to_triage),
+        creator: @creator,
+        created_at: t0 + 3.hours + 50.minutes,
+        updated_at: t0 + 3.hours + 50.minutes
+      )
+    end
+
+    assert_equal 2, @user.notification_bundles.count
+    second_bundle = @user.notification_bundles.order(:starts_at).last
+    assert_equal second_window_start, second_bundle.starts_at
+    assert_equal second_window_start + 4.hours, second_bundle.ends_at
+    assert_operator second_bundle.starts_at, :>=, first_bundle.ends_at
+    assert_includes second_bundle.notifications, late
+  end
+
+  test "late-arriving notification when previous window is delivered and no window is open starts non-overlapping window" do
+    @user.settings.every_few_hours!
+    t0 = Time.utc(2026, 3, 1, 6, 0, 0)
+
+    travel_to(t0) do
+      Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    end
+
+    travel_to(t0 + 4.hours) do
+      Notification::Bundle.deliver_all
+    end
+
+    arrival_time = t0 + 4.hours + 5.minutes
+    late = travel_to(arrival_time) do
+      Notification.create!(
+        user: @user,
+        source: events(:layout_commented),
+        creator: @creator,
+        created_at: t0 + 3.hours + 50.minutes,
+        updated_at: t0 + 3.hours + 50.minutes
+      )
+    end
+
+    assert_equal 2, @user.notification_bundles.count
+    first_bundle, second_bundle = @user.notification_bundles.order(:starts_at).to_a
+    assert_operator second_bundle.starts_at, :>=, first_bundle.ends_at
+    assert_equal arrival_time, second_bundle.starts_at
+    assert_equal arrival_time + 4.hours, second_bundle.ends_at
+    assert_includes second_bundle.notifications, late
+  end
+
+  test "prevents overlapping windows for the same user while allowing adjacent windows and other users" do
+    t0 = Time.utc(2026, 3, 1, 10, 0, 0)
+    first = @user.notification_bundles.create!(starts_at: t0, ends_at: t0 + 4.hours)
+
+    # Partial overlap
+    overlapping = @user.notification_bundles.build(starts_at: t0 + 2.hours, ends_at: t0 + 6.hours)
+    assert_not overlapping.valid?
+
+    # Contained overlap
+    nested = @user.notification_bundles.build(starts_at: t0 + 1.hour, ends_at: t0 + 2.hours)
+    assert_not nested.valid?
+
+    # Identical window
+    duplicate = @user.notification_bundles.build(starts_at: t0, ends_at: t0 + 4.hours)
+    assert_not duplicate.valid?
+
+    # Invalid reversed window
+    reversed = @user.notification_bundles.build(starts_at: t0 + 5.hours, ends_at: t0 + 5.hours)
+    assert_not reversed.valid?
+
+    # Exact adjacent window is valid
+    adjacent = @user.notification_bundles.build(starts_at: first.ends_at, ends_at: first.ends_at + 4.hours)
+    assert adjacent.valid?
+    adjacent.save!
+
+    # Different user can have the same window
+    other_user_bundle = users(:david).notification_bundles.build(starts_at: t0, ends_at: t0 + 4.hours)
+    assert other_user_bundle.valid?
+  end
+
+  test "excludes notifications that were read before the window closes and skips email when all are read" do
+    @user.settings.every_few_hours!
+    t0 = Time.utc(2026, 3, 1, 10, 0, 0)
+
+    n1 = n2 = nil
+    travel_to(t0) do
+      n1 = Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+      n2 = Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+    end
+
+    # Read n1 before window ends -> email only includes n2
+    n1.read
+
+    travel_to(t0 + 4.hours) do
+      assert_emails 1 do
+        Notification::Bundle.deliver_all
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_no_match cards(:logo).title, CGI.unescapeHTML(CGI.unescapeHTML(email.html_part.body.decoded))
+    assert_match cards(:layout).title, CGI.unescapeHTML(CGI.unescapeHTML(email.html_part.body.decoded))
+
+    # Next window where ALL notifications are read -> no email sent
+    n3 = nil
+    travel_to(t0 + 5.hours) do
+      n3 = Notification.create!(user: @user, source: events(:buy_domain_sent_back_to_triage), creator: @creator)
+      n3.read
+    end
+
+    second_bundle = @user.notification_bundles.order(:starts_at).last
+    travel_to(t0 + 9.hours) do
+      assert_no_emails do
+        Notification::Bundle.deliver_all
+      end
+      assert second_bundle.reload.delivered?
+    end
+  end
+
+  test "updated card notification in a later window is included in the new bundle, while untouched unread notifications are not re-sent" do
+    @user.settings.every_few_hours!
+    t0 = Time.utc(2026, 3, 1, 10, 0, 0)
+
+    # Window 1: logo and layout notifications
+    travel_to(t0) do
+      Notifier.for(events(:logo_assignment_km)).notify
+      Notifier.for(events(:layout_commented)).notify
+    end
+
+    travel_to(t0 + 4.hours) do
+      assert_emails 1 do
+        Notification::Bundle.deliver_all
+      end
+    end
+
+    # Both notifications remain unread. In Window 2, only buy_domain gets a notification and logo gets a new event;
+    # layout has NO new activity and must NOT be re-sent.
+    travel_to(t0 + 5.hours) do
+      boards(:writebook).access_for(@user).watching!
+      Notifier.for(events(:buy_domain_sent_back_to_triage)).notify
+      Notifier.for(events(:logo_published)).notify
+    end
+
+    travel_to(t0 + 9.hours) do
+      ActionMailer::Base.deliveries.clear
+      assert_emails 1 do
+        Notification::Bundle.deliver_all
+      end
+
+      email = ActionMailer::Base.deliveries.last
+      assert_match cards(:buy_domain).title, CGI.unescapeHTML(email.html_part.body.decoded)
+      assert_match cards(:logo).title, CGI.unescapeHTML(email.html_part.body.decoded)
+      assert_no_match cards(:layout).title, CGI.unescapeHTML(email.html_part.body.decoded)
+    end
+  end
+
+  test "deliver_all_later enqueues jobs with account context and delivers once" do
+    @user.settings.every_few_hours!
+    t0 = Time.utc(2026, 3, 1, 10, 0, 0)
+
+    travel_to(t0) do
+      Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    end
+
+    bundle = @user.notification_bundles.last
+
+    travel_to(t0 + 4.hours) do
+      assert_enqueued_with(job: Notification::Bundle::DeliverJob, args: [ bundle ]) do
+        Notification::Bundle.deliver_all_later
+      end
+
+      assert bundle.reload.processing?
+
+      # Calling deliver_all_later again while processing does not enqueue a duplicate job
+      assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+        Notification::Bundle.deliver_all_later
+      end
+
+      assert_emails 1 do
+        perform_enqueued_jobs only: Notification::Bundle::DeliverJob
+      end
+
+      assert bundle.reload.delivered?
+      email = ActionMailer::Base.deliveries.last
+      assert_includes CGI.unescapeHTML(email.html_part.body.decoded), @user.account.slug
+    end
+  end
+
+  test "ignores notifications from system user, inactive users, cancelled accounts, and pre-read notifications" do
+    @user.settings.every_few_hours!
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      Notification.create!(user: @user, source: events(:logo_published), creator: users(:system))
+    end
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: @creator, read_at: Time.current)
+    end
+
+    @user.stubs(:close_remote_connections)
+    @user.deactivate
+    assert_no_difference -> { Notification::Bundle.count } do
+      Notification.create!(user: @user, source: events(:buy_domain_sent_back_to_triage), creator: @creator)
+    end
+  end
+
+  test "does not send email if user is deactivated or account is cancelled before delivery" do
+    @user.settings.every_few_hours!
+    t0 = Time.utc(2026, 3, 1, 10, 0, 0)
+
+    travel_to(t0) do
+      Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    end
+
+    @user.account.cancel(initiated_by: @creator)
+
+    travel_to(t0 + 4.hours) do
+      ActionMailer::Base.deliveries.clear
+      assert_no_emails do
+        Notification::Bundle.deliver_all
+      end
+      assert @user.notification_bundles.last.delivered?
+    end
+  end
+
+  test "resets status back to pending when delivery raises a transient error" do
+    @user.settings.every_few_hours!
+    t0 = Time.utc(2026, 3, 1, 10, 0, 0)
+
+    travel_to(t0) do
+      Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    end
+
+    bundle = @user.notification_bundles.last
+    NotificationMailer.stubs(:bundled).raises(RuntimeError, "SMTP down")
+
+    travel_to(t0 + 4.hours) do
+      assert_raises(RuntimeError) { bundle.deliver }
+      assert bundle.reload.pending?
+    end
+  ensure
+    NotificationMailer.unstub(:bundled)
+  end
+
+  test "deliver is idempotent when called multiple times" do
+    @user.settings.every_few_hours!
+    t0 = Time.utc(2026, 3, 1, 10, 0, 0)
+
+    travel_to(t0) do
+      Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    end
+
+    bundle = @user.notification_bundles.last
+
+    travel_to(t0 + 4.hours) do
+      assert_emails 1 do
+        bundle.deliver
+        bundle.deliver
+      end
+    end
+  end
+
+  test "reading and marking unread does not open a new bundle" do
+    notification = Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    @user.settings.every_few_hours!
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      notification.read
+      notification.unread
+    end
+  end
+end
