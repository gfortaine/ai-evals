diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..531dfb7
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+require "fugit"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago and keeps others" do
+    freeze_time do
+      due_account_1 = Account.create_with_owner(
+        account: { name: "Due 1" },
+        owner: { name: "Owner 1", identity: identities(:david) }
+      )
+      due_account_2 = Account.create_with_owner(
+        account: { name: "Due 2" },
+        owner: { name: "Owner 2", identity: identities(:kevin) }
+      )
+      boundary_account = Account.create_with_owner(
+        account: { name: "Exact 30 Days" },
+        owner: { name: "Owner 3", identity: identities(:jz) }
+      )
+      recent_account = Account.create_with_owner(
+        account: { name: "Recent" },
+        owner: { name: "Owner 4", identity: identities(:jason) }
+      )
+      recancelled_account = Account.create_with_owner(
+        account: { name: "Recancelled" },
+        owner: { name: "Owner 5", identity: identities(:mike) }
+      )
+      active_account = accounts(:"37s")
+
+      due_owner = due_account_1.users.owner.first
+      due_board = nil
+      due_card = nil
+
+      Current.with_account(due_account_1) do
+        with_current_user(due_owner) do
+          due_board = due_account_1.boards.create!(name: "Due Board", creator: due_owner)
+          due_card = due_board.cards.create!(title: "Due Card", creator: due_owner, status: "published")
+        end
+      end
+
+      due_account_1.cancel(initiated_by: due_owner)
+      due_account_1.cancellation.update!(created_at: 31.days.ago)
+
+      due_account_2.cancel(initiated_by: due_account_2.users.owner.first)
+      due_account_2.cancellation.update!(created_at: 30.days.ago - 1.second)
+
+      boundary_account.cancel(initiated_by: boundary_account.users.owner.first)
+      boundary_account.cancellation.update!(created_at: 30.days.ago)
+
+      recent_account.cancel(initiated_by: recent_account.users.owner.first)
+      recent_account.cancellation.update!(created_at: 5.days.ago)
+
+      recancelled_owner = recancelled_account.users.owner.first
+      recancelled_account.cancel(initiated_by: recancelled_owner)
+      recancelled_account.cancellation.update!(created_at: 45.days.ago)
+      recancelled_account.reactivate
+      recancelled_account.cancel(initiated_by: recancelled_owner)
+      recancelled_account.cancellation.update!(created_at: 2.days.ago)
+
+      assert_changes -> { Account.count }, -2 do
+        perform_enqueued_jobs do
+          Account::IncinerateDueJob.perform_later
+        end
+      end
+
+      assert_not Account.exists?(due_account_1.id)
+      assert_not Board.exists?(due_board.id)
+      assert_not Card.exists?(due_card.id)
+      assert_not Account.exists?(due_account_2.id)
+
+      assert Account.exists?(boundary_account.id)
+      assert Account.exists?(recent_account.id)
+      assert Account.exists?(recancelled_account.id)
+      assert Account.exists?(active_account.id)
+    end
+  end
+
+  test "does nothing when no accounts are due for incineration" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  test "is configured as a recurring job" do
+    config = ActiveSupport::ConfigurationFile.parse(Rails.root.join("config/recurring.yml"))
+
+    %w[ production development ].each do |env|
+      task = config.fetch(env).values.find { |entry| entry["class"] == "Account::IncinerateDueJob" }
+      assert_not_nil task, "Expected Account::IncinerateDueJob in #{env} recurring tasks"
+      assert_not_nil Fugit.parse(task["schedule"]), "Expected valid Fugit schedule for Account::IncinerateDueJob"
+    end
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..4e6bff6
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,166 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+  end
+
+  test "due_for_incineration includes accounts cancelled more than 30 days ago" do
+    freeze_time do
+      @account.cancel(initiated_by: @user)
+      @account.cancellation.update!(created_at: 30.days.ago - 1.second)
+
+      assert_includes Account.due_for_incineration, @account
+    end
+  end
+
+  test "due_for_incineration excludes active accounts and accounts within grace period" do
+    freeze_time do
+      other_account = accounts(:initech)
+      other_account.cancel(initiated_by: users(:mike))
+      other_account.cancellation.update!(created_at: 30.days.ago)
+
+      assert_not_includes Account.due_for_incineration, @account
+      assert_not_includes Account.due_for_incineration, other_account
+    end
+  end
+
+  test "due_for_incineration excludes reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+    @account.reactivate
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "incinerate permanently removes all account data while preserving identities and other accounts" do
+    other_account = accounts(:initech)
+    identities_before = @account.users.filter_map(&:identity_id).uniq
+    assert_not_empty identities_before
+
+    blob_keys = populate_all_account_data(@account)
+    board_ids = @account.boards.pluck(:id)
+    filter_ids = Filter.where(account_id: @account.id).pluck(:id)
+    account_id = @account.id
+
+    @account.cancel(initiated_by: @user)
+    @account.incinerate
+
+    assert_not Account.exists?(account_id)
+    assert_equal 0, Storage::Total.where(owner_type: "Account", owner_id: account_id).count
+    assert_equal 0, Storage::Total.where(owner_type: "Board", owner_id: board_ids).count
+    assert_equal 0, Search::Record.for(account_id).where(account_id: account_id).count
+
+    %w[ boards_filters filters_tags assignees_filters creators_filters closers_filters ].each do |join_table|
+      remaining = ActiveRecord::Base.connection.select_value(
+        ActiveRecord::Base.sanitize_sql_array([ "SELECT COUNT(*) FROM #{join_table} WHERE filter_id IN (?)", filter_ids ])
+      ).to_i
+      assert_equal 0, remaining, "Expected 0 rows in #{join_table} for incinerated account filters"
+    end
+
+    assert_no_rows_for_account(account_id)
+
+    blob_keys.each do |key|
+      assert_not ActiveStorage::Blob.service.exist?(key), "Expected blob file #{key} to be purged"
+    end
+
+    identities_before.each do |identity_id|
+      assert Identity.exists?(identity_id), "Expected global Identity #{identity_id} to be preserved"
+    end
+
+    assert Account.exists?(other_account.id)
+    assert_not_empty other_account.boards
+    assert_not_empty other_account.users
+  end
+
+  test "incinerate runs callbacks" do
+    callback_called = false
+    account = Account.create!(name: "Callback Account")
+    account.define_singleton_method(:mark_incinerated) { callback_called = true }
+    Account.set_callback(:incinerate, :before, :mark_incinerated, if: -> { respond_to?(:mark_incinerated) })
+
+    account.incinerate
+
+    assert callback_called
+  ensure
+    Account.skip_callback(:incinerate, :before, :mark_incinerated, raise: false)
+  end
+
+  private
+    def populate_all_account_data(account)
+      Current.with_account(account) do
+        owner = account.users.find_by!(role: :owner)
+        member = account.users.find_by!(role: :member)
+        deactivated = account.users.create!(name: "Former User", role: :member)
+        deactivated.deactivate
+
+        Current.session = owner.identity.sessions.first || owner.identity.sessions.create!
+
+        owner.avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg")
+        owner.push_subscriptions.build(account: account, endpoint: "https://fcm.googleapis.com/fcm/send/123", p256dh_key: "k", auth_key: "a").save!(validate: false)
+        owner.remember_search("incineration query")
+
+        board = boards(:writebook)
+        board.publish
+        board_blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "board.jpg", content_type: "image/jpeg")
+        board.update!(public_description: "<p>Board #{ActionText::Attachment.from_attachable(board_blob).to_html}</p>")
+
+        card = board.cards.published.first
+        card.image.attach(io: file_fixture("moon.jpg").open, filename: "card.jpg", content_type: "image/jpeg")
+        card_blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "card_embed.jpg", content_type: "image/jpeg")
+        card.update!(description: "<p>Card #{ActionText::Attachment.from_attachable(card_blob).to_html}</p>")
+        card.steps.create!(content: "Step 1")
+        card.gild
+        Card::ActivitySpike.find_or_create_by!(card: card, account: account)
+
+        postponed_card = board.cards.create!(title: "Postponed", creator: owner, status: "published")
+        postponed_card.postpone(user: owner)
+
+        closed_card = board.cards.create!(title: "Closed", creator: owner, status: "published")
+        closed_card.close(user: member)
+
+        comment_blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "comment.jpg", content_type: "image/jpeg")
+        comment = card.comments.create!(creator: owner, body: "<p>Comment #{ActionText::Attachment.from_attachable(comment_blob).to_html}</p>")
+        member.mentioned_by(owner, at: comment)
+
+        owner.notification_bundles.create!(starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+
+        ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "unattached.jpg", content_type: "image/jpeg")
+
+        owner.filters.create!(
+          params_digest: "incinerate-filter-digest",
+          fields: {},
+          board_ids: [ board.id ],
+          tag_ids: [ account.tags.first.id ],
+          assignee_ids: [ member.id ],
+          creator_ids: [ owner.id ],
+          closer_ids: [ member.id ]
+        )
+
+        account_export = Account::Export.create!(account: account, user: owner)
+        account_export.build
+        user_export = User::DataExport.create!(account: account, user: owner)
+        user_export.build
+        Account::Import.create!(account: account, identity: owner.identity, status: :completed, completed_at: Time.current)
+
+        account.materialize_storage
+        board.materialize_storage
+
+        ActiveStorage::Blob.where(account_id: account.id).pluck(:key)
+      end
+    end
+
+    def assert_no_rows_for_account(account_id)
+      raw_id = Account.type_for_attribute("id").serialize(account_id)
+
+      ActiveRecord::Base.connection.tables.sort.each do |table|
+        columns = ActiveRecord::Base.connection.columns(table).map(&:name)
+        if columns.include?("account_id")
+          sql = ActiveRecord::Base.sanitize_sql_array([ "SELECT COUNT(*) FROM #{table} WHERE account_id = ?", raw_id ])
+          count = ActiveRecord::Base.connection.select_value(sql).to_i
+          assert_equal 0, count, "Expected 0 rows in #{table} for incinerated account, found #{count}"
+        end
+      end
+    end
+end
