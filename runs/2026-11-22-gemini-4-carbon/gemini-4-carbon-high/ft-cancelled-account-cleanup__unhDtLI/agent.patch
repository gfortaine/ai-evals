index 2357b99..2f135f5 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,17 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+
+    define_callbacks :incinerate
+  end
+
+  def incinerate
+    run_callbacks :incinerate do
+      Account::Incineration.new(self).run
+    end
+  end
 end
diff --git a/app/models/account/incineration.rb b/app/models/account/incineration.rb
new file mode 100644
index 0000000..853b507
--- /dev/null
+++ b/app/models/account/incineration.rb
@@ -0,0 +1,42 @@
+class Account::Incineration
+  def initialize(account)
+    @account = account
+  end
+
+  def run
+    suppressing_broadcasts_and_touching do
+      purge_blobs
+      destroy_account
+      cleanup_lingering_data
+    end
+  end
+
+  private
+    def suppressing_broadcasts_and_touching(&block)
+      Board.suppressing_turbo_broadcasts do
+        Card.suppressing_turbo_broadcasts do
+          Notification.suppressing_turbo_broadcasts do
+            Account::Import.suppressing_turbo_broadcasts do
+              ActiveRecord::Base.no_touching(&block)
+            end
+          end
+        end
+      end
+    end
+
+    def purge_blobs
+      ActiveStorage::VariantRecord.where(account_id: @account.id).delete_all
+      ActiveStorage::Attachment.where(account_id: @account.id).delete_all
+      ActiveStorage::Blob.where(account_id: @account.id).find_each(&:purge)
+    end
+
+    def destroy_account
+      @account.destroy!
+    end
+
+    def cleanup_lingering_data
+      Export.where(account_id: @account.id).delete_all
+      ActionText::RichText.where(account_id: @account.id).delete_all
+      Search::Record.for(@account.id).where(account_id: @account.id).find_each(&:destroy)
+    end
+end
