index 0000000..5382a41
--- /dev/null
+++ b/test/controllers/bot_suspensions_test.rb
@@ -0,0 +1,138 @@
+require "test_helper"
+
+class BotSuspensionsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    post bots_url, params: { bot: { name: "Misbehaving Bot", webhook_url: "https://bot.example.com/hook" } }
+    @bot = User.bot.find_by!(name: "Misbehaving Bot")
+
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+    delete session_url
+  end
+
+  test "flooding endpoint returns 429 with Retry-After during 30s cooldown and 403 once suspended after 5 cooldown attempts" do
+    freeze_time do
+      10.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Message #{i + 1}", headers: { "CONTENT_TYPE" => "text/plain" }
+        assert_response :created
+      end
+
+      # 11th message goes over the limit, is rejected, and starts a 30s cooldown
+      assert_no_difference -> { Message.count } do
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Over limit", headers: { "CONTENT_TYPE" => "text/plain" }
+      end
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+
+      # Advance 12 seconds into cooldown -> Retry-After reflects 18 seconds left
+      travel 12.seconds
+      post room_bot_messages_url(@room, @bot.bot_key), params: +"Attempt 1", headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :too_many_requests
+      assert_equal "18", response.headers["Retry-After"]
+
+      # Attempts 2, 3, 4 during same cooldown still return 429
+      travel 7.seconds
+      3.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Attempt #{i + 2}", headers: { "CONTENT_TYPE" => "text/plain" }
+        assert_response :too_many_requests
+        assert_equal "11", response.headers["Retry-After"]
+      end
+      assert_not @bot.reload.suspended?
+
+      # 5th attempt during the same cooldown suspends the bot and returns 403 Forbidden
+      post room_bot_messages_url(@room, @bot.bot_key), params: +"Attempt 5", headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :forbidden
+      assert_nil response.headers["Retry-After"]
+      assert @bot.reload.suspended?
+
+      # Even after 30+ seconds pass, a suspended bot continues getting 403 Forbidden
+      travel 60.seconds
+      post room_bot_messages_url(@room, @bot.bot_key), params: +"Still suspended", headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :forbidden
+
+      # Even posting to a room id it is not in returns 403 Forbidden while suspended
+      post room_bot_messages_url(rooms(:designers), @bot.bot_key), params: +"Other room", headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :forbidden
+
+      # Invalid bot_key still gets 401 Unauthorized
+      post room_bot_messages_url(@room, "#{@bot.id}-wrongtoken"), params: +"Bad token", headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :unauthorized
+    end
+  end
+
+  test "bots page shows Suspended with reason to owner and admin, but only administrator sees and can use Reactivate" do
+    @bot.suspend!(reason: User::Bot::Suspendable::WEBHOOK_FAILURE_SUSPENSION_REASON)
+
+    # Regular member owner sees their suspended bot and reason, counts towards limit, but NO Reactivate button
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    sign_in :kevin
+    get bots_url
+    assert_response :ok
+    assert_select "p", text: /reached the limit/
+    assert_select "li##{dom_id(@bot)}" do
+      assert_select "strong", text: "Misbehaving Bot"
+      assert_select "strong", text: "Suspended"
+      assert_match(/webhook/i, css_select("li##{dom_id(@bot)}").first.text)
+      assert_select "button", text: "Reactivate", count: 0
+    end
+
+    # Direct reactivation attempt by owner (non-admin) is forbidden
+    delete bot_suspension_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+
+    # Direct reactivation attempt by another member is forbidden
+    sign_in :jz
+    delete bot_suspension_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+
+    # Owner can still edit webhook URL of their suspended bot without reactivating it
+    sign_in :kevin
+    patch bot_url(@bot), params: { bot: { name: "Misbehaving Bot", webhook_url: "https://fixed.example.com/hook" } }
+    assert_redirected_to bots_url
+    assert_equal "https://fixed.example.com/hook", @bot.reload.webhook_url
+    assert @bot.suspended?
+
+    # Administrator sees Suspended, reason, and Reactivate button with native turbo_confirm
+    sign_in :david
+    get bots_url
+    assert_response :ok
+    assert_select "li##{dom_id(@bot)}" do
+      assert_select "strong", text: "Suspended"
+      assert_select "form[action='#{bot_suspension_path(@bot)}'] button[data-turbo-confirm]", text: "Reactivate"
+    end
+
+    # Administrator reactivates the bot
+    delete bot_suspension_url(@bot)
+    assert_redirected_to bots_url
+    assert_not @bot.reload.suspended?
+
+    get bots_url
+    assert_response :ok
+    assert_select "li##{dom_id(@bot)}" do
+      assert_select "strong", text: "Suspended", count: 0
+      assert_select "button", text: "Reactivate", count: 0
+    end
+
+    # Bot can post again immediately
+    delete session_url
+    post room_bot_messages_url(@room, @bot.bot_key), params: +"Hello again!", headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :created
+  end
+
+  test "editing a room while a bot is suspended preserves the suspended bot's membership" do
+    @bot.suspend!(reason: User::Bot::Suspendable::FLOODING_SUSPENSION_REASON)
+
+    sign_in :david
+    get edit_rooms_open_url(@room)
+    assert_response :ok
+    assert_select "input[type='checkbox'][name='user_ids[]'][value='#{@bot.id}'][checked]"
+
+    put rooms_open_url(@room), params: { room: { name: "HQ Renamed" }, user_ids: [ "", @bot.id ] }
+    assert_redirected_to room_url(@room)
+    assert_includes @room.reload.users, @bot
+  end
+end
diff --git a/test/models/user/bot_suspension_test.rb b/test/models/user/bot_suspension_test.rb
new file mode 100644
index 0000000..5e4532f
--- /dev/null
+++ b/test/models/user/bot_suspension_test.rb
@@ -0,0 +1,223 @@
+require "test_helper"
+
+class User::BotSuspensionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @bot = User.create_bot!(name: "Flood Bot", webhook_url: "https://bot.example.com/hook")
+    Current.reset
+
+    @author = users(:david)
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+  end
+
+  test "allows up to 10 messages in 10 seconds across API and webhook replies, then rejects 11th with 30s cooldown" do
+    stub_request(:post, "https://bot.example.com/hook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Webhook reply")
+
+    freeze_time do
+      7.times do |i|
+        result = @bot.deliver_bot_message(@room, body: "API message #{i}")
+        assert_equal :created, result.status
+      end
+
+      3.times do
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} hi</div>")
+        end
+      end
+
+      assert_equal 10, @bot.messages.count
+      assert_not @bot.reload.cooling_down?
+      assert_not @bot.suspended?
+
+      # 11th message within 10s is rejected and starts a 30-second cooldown
+      over_limit = nil
+      assert_no_difference -> { Message.count } do
+        over_limit = @bot.deliver_bot_message(@room, body: "11th message")
+      end
+
+      assert_equal :cooling_down, over_limit.status
+      assert_equal 30, over_limit.retry_after
+      assert @bot.reload.cooling_down?
+      assert_not @bot.suspended?
+
+      # Webhook replies are not posted during the cooldown
+      travel 5.seconds
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} during cooldown</div>")
+      end
+      assert_equal 10, @bot.messages.count
+      assert_equal 1, @bot.reload.bot_cooldown_attempts
+
+      # After the 30-second cooldown expires, the bot can post again
+      travel 25.seconds
+      assert_not @bot.cooling_down?
+      after_cooldown = @bot.deliver_bot_message(@room, body: "Back after cooldown")
+      assert_equal :created, after_cooldown.status
+      assert_equal 11, @bot.messages.count
+    end
+  end
+
+  test "sliding 10-second window allows more messages once older ones age past 10 seconds" do
+    freeze_time do
+      6.times { |i| assert_equal :created, @bot.deliver_bot_message(@room, body: "Batch A #{i}").status }
+
+      travel 6.seconds
+      4.times { |i| assert_equal :created, @bot.deliver_bot_message(@room, body: "Batch B #{i}").status }
+
+      # At t=8s, all 10 messages are still within [t-2s, t=8s] -> wait, Batch A was at t=0, window at t=8s is (-2s..8s), so all 10 count
+      # Wait until t=10s so Batch A (at t=0) ages out of the 10-second window
+      travel 4.seconds
+      6.times { |i| assert_equal :created, @bot.deliver_bot_message(@room, body: "Batch C #{i}").status }
+
+      assert_equal 16, @bot.messages.count
+      assert_not @bot.reload.cooling_down?
+    end
+  end
+
+  test "five more attempts during the same cooldown suspend the bot, while attempts across separate cooldowns do not accumulate" do
+    freeze_time do
+      10.times { |i| @bot.deliver_bot_message(@room, body: "Msg #{i}") }
+
+      # Start first cooldown
+      assert_equal :cooling_down, @bot.deliver_bot_message(@room, body: "Over limit 1").status
+
+      # 4 attempts during first cooldown do not suspend
+      4.times do |i|
+        res = @bot.deliver_bot_message(@room, body: "Cooldown 1 attempt #{i}")
+        assert_equal :cooling_down, res.status
+        assert_not @bot.reload.suspended?
+      end
+
+      # Let first cooldown expire
+      travel 30.seconds
+      assert_not @bot.cooling_down?
+
+      # Trigger a second cooldown
+      10.times { |i| assert_equal :created, @bot.deliver_bot_message(@room, body: "Second burst #{i}").status }
+      assert_equal :cooling_down, @bot.deliver_bot_message(@room, body: "Over limit 2").status
+      assert_equal 0, @bot.reload.bot_cooldown_attempts
+
+      # 4 attempts during second cooldown still do not suspend
+      4.times do |i|
+        res = @bot.deliver_bot_message(@room, body: "Cooldown 2 attempt #{i}")
+        assert_equal :cooling_down, res.status
+        assert_not @bot.reload.suspended?
+      end
+
+      # 5th attempt during second cooldown suspends the bot
+      fifth = @bot.deliver_bot_message(@room, body: "Cooldown 2 attempt 5")
+      assert_equal :suspended, fifth.status
+      assert @bot.reload.suspended?
+      assert_match(/flood/i, @bot.suspension_reason)
+    end
+  end
+
+  test "ten failed webhook deliveries in a row suspend the bot and a 2xx delivery resets the count" do
+    # Mix of non-2xx responses, timeouts, and connection errors (9 total)
+    failures = [
+      -> { stub_request(:post, @bot.webhook.url).to_return(status: 500) },
+      -> { stub_request(:post, @bot.webhook.url).to_return(status: 502) },
+      -> { stub_request(:post, @bot.webhook.url).to_return(status: 404) },
+      -> { stub_request(:post, @bot.webhook.url).to_return(status: 302, headers: { "Location" => "https://other.example.com" }) },
+      -> { stub_request(:post, @bot.webhook.url).to_timeout },
+      -> { stub_request(:post, @bot.webhook.url).to_raise(Net::ReadTimeout) },
+      -> { stub_request(:post, @bot.webhook.url).to_raise(Errno::ECONNREFUSED) },
+      -> { stub_request(:post, @bot.webhook.url).to_raise(SocketError.new("Failed to open TCP connection")) },
+      -> { stub_request(:post, @bot.webhook.url).to_return(status: 429) }
+    ]
+
+    failures.each do |setup_stub|
+      WebMock.reset!
+      setup_stub.call
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+      end
+    end
+
+    assert_equal 9, @bot.reload.bot_webhook_failures
+    assert_not @bot.suspended?
+
+    # A 2xx response resets the count
+    WebMock.reset!
+    stub_request(:post, @bot.webhook.url).to_return(status: 204)
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} ok</div>")
+    end
+
+    assert_equal 0, @bot.reload.bot_webhook_failures
+    assert_not @bot.suspended?
+
+    # Now 9 failures again do not suspend, and the 10th suspends
+    WebMock.reset!
+    stub_request(:post, @bot.webhook.url).to_return(status: 503)
+
+    9.times do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} fail</div>")
+      end
+    end
+    assert_not @bot.reload.suspended?
+
+    # 10th consecutive failure via joined webhook suspends the bot
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      rooms(:pets).memberships.grant_to(@bot)
+    end
+
+    assert @bot.reload.suspended?
+    assert_match(/webhook/i, @bot.suspension_reason)
+  end
+
+  test "suspended bot keeps rooms and messages, counts towards owner bot limit, receives no webhooks, and reactivate restores full operation" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    @room.messages.create!(creator: @bot, body: "Historical bot message")
+    closed_room = rooms(:designers)
+    closed_room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+
+    # Flood and suspend within frozen time so reactivation happens < 10s after the flood burst
+    freeze_time do
+      10.times { |i| @bot.deliver_bot_message(@room, body: "Flood #{i}") }
+      @bot.deliver_bot_message(@room, body: "Start cooldown")
+      5.times { @bot.deliver_bot_message(@room, body: "Suspend me") }
+
+      assert @bot.reload.suspended?
+
+      # Keeps rooms and messages
+      assert_includes @bot.rooms.reload, @room
+      assert_includes @bot.rooms, closed_room
+      assert_equal 11, @bot.messages.count
+
+      # Counts towards owner's bot limit
+      assert users(:kevin).reached_bot_limit?(accounts(:signal))
+
+      # Receives no webhooks on mention or room join (and even if job was enqueued before suspension)
+      stub = stub_request(:post, @bot.webhook.url).to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Should not fire")
+
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} hello?</div>")
+        rooms(:pets).memberships.grant_to(@bot)
+      end
+
+      prior_msg = @room.messages.last
+      @bot.webhook.deliver(prior_msg)
+      assert_not_requested stub
+
+      # Reactivating clears suspension and resets flood window immediately
+      @bot.reactivate
+      assert_not @bot.reload.suspended?
+      assert_nil @bot.suspension_reason
+
+      res = @bot.deliver_bot_message(@room, body: "I am back!")
+      assert_equal :created, res.status
+    end
+
+    stub = stub_request(:post, @bot.webhook.url).to_return(status: 204)
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} welcome back</div>")
+    end
+    assert_requested stub, times: 1
+  end
+end
