--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,71 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+  before_action :ensure_can_administer, only: %i[ edit update destroy ]
+  before_action :ensure_within_bot_limit, only: %i[ new create ]
+
+  def index
+    @bots = bots_scope.with_attached_avatar.ordered
+  end
+
+  def new
+    @bot = User.new_bot
+  end
+
+  def create
+    @bot = User.new_bot(bot_params)
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      if @bot.saved_change_to_name? || bot_params[:avatar].present?
+        @bot.touch
+        @bot.messages.touch_all
+      end
+
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url
+  end
+
+  private
+    def set_bot
+      unless @bot = User.active.bot.find_by(id: params[:id])
+        head :not_found
+      end
+    end
+
+    def ensure_can_administer
+      head :forbidden unless Current.user.can_administer?(@bot)
+    end
+
+    def ensure_within_bot_limit
+      head :forbidden if Current.user.reached_bot_limit?
+    end
+
+    def bots_scope
+      if Current.user.administrator?
+        User.active.bot
+      else
+        Current.user.bots.active
+      end
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar, :webhook_url, :auto_join_open_rooms)
+    end
+end
diff --git a/app/controllers/messages/by_bots_controller.rb b/app/controllers/messages/by_bots_controller.rb
new file mode 100644
index 0000000..27b0013
--- /dev/null
+++ b/app/controllers/messages/by_bots_controller.rb
@@ -0,0 +1,59 @@
+class Messages::ByBotsController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  allow_unauthenticated_access
+  skip_forgery_protection
+  wrap_parameters false
+
+  before_action :authenticate_bot
+  before_action :ensure_unsuspended_bot
+  before_action :set_room
+
+  def process_action(...)
+    request.request_parameters = {}
+    super
+  end
+
+  def create
+    result = Current.user.deliver_bot_message(@room, body: message_body)
+
+    case result.status
+    when :created
+      @message = result.message
+      head :created, location: message_path(@message)
+    when :cooling_down
+      response.set_header("Retry-After", result.retry_after.to_s)
+      head :too_many_requests
+    when :suspended
+      head :forbidden
+    when :invalid
+      head :unprocessable_content
+    end
+  end
+
+  private
+    def authenticate_bot
+      if bot = User.authenticate_bot(params[:bot_key])
+        Current.user = bot
+      else
+        head :unauthorized
+      end
+    end
+
+    def ensure_unsuspended_bot
+      head :forbidden if Current.user.suspended?
+    end
+
+    def set_room
+      unless @room = Current.user.rooms.find_by(id: params[:room_id])
+        head :not_found
+      end
+    end
+
+    def message_body
+      request.raw_post.dup.force_encoding(Encoding::UTF_8).scrub
+    end
+
+    def allow_browser(**)
+    end
+end
