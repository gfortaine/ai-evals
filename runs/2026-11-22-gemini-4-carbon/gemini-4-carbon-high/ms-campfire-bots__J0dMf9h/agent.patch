+    has_one :webhook, dependent: :destroy, autosave: true
+
+    before_validation :sync_webhook, if: :webhook_url_assigned?
+    validate :validate_webhook_url
+    validate :ensure_within_bot_limit, on: :create, if: :bot?
+    after_save :clear_assigned_webhook_url
+
+    before_create :ensure_bot_token, if: :bot?
+
+    validates :name, presence: true, if: :bot?
+
+    scope :without_bots, -> { not_bot }
+    scope :auto_joining_open_rooms, -> { bot.where(auto_join_open_rooms: true) }
+    scope :open_room_grantees, -> { active.without_bots.or(active.auto_joining_open_rooms) }
+  end
+
+  class_methods do
+    def new_bot(attributes = {})
+      bot.new(creator: Current.user, **attributes.to_h.symbolize_keys)
+    end
+
+    def create_bot!(attributes = {})
+      new_bot(attributes).tap(&:save!)
+    end
+
+    def authenticate_bot(bot_key)
+      bot_id, bot_token = bot_key.to_s.split("-", 2)
+      return nil if bot_id.blank? || bot_token.blank?
+
+      if user = active.bot.find_by(id: bot_id)
+        user if user.bot_token.present? && ActiveSupport::SecurityUtils.secure_compare(user.bot_token, bot_token)
+      end
+    end
+  end
+
+  def bot_key
+    "#{id}-#{bot_token}" if bot? && bot_token.present?
+  end
+
+  def reached_bot_limit?(account = Current.account)
+    return false if administrator? || account.nil?
+
+    bots.active.count >= account.settings.bots_per_member
+  end
+
+  def webhook_url
+    if webhook_url_assigned?
+      @webhook_url
+    elsif webhook && !webhook.destroyed? && !webhook.marked_for_destruction?
+      webhook.url
+    end
+  end
+
+  def webhook_url=(url)
+    @webhook_url_assigned = true
+    @webhook_url = url.to_s.strip.presence
+  end
+
+  def reload(...)
+    clear_assigned_webhook_url
+    super
+  end
+
+  private
+    def webhook_url_assigned?
+      @webhook_url_assigned == true
+    end
+
+    def clear_assigned_webhook_url
+      @webhook_url_assigned = false
+      @webhook_url = nil
+    end
+
+    def sync_webhook
+      if @webhook_url.present?
+        webhook.reload if webhook&.persisted? && webhook.marked_for_destruction?
+        if webhook && !webhook.destroyed? && !webhook.marked_for_destruction?
+          webhook.url = @webhook_url
+        else
+          build_webhook(url: @webhook_url)
+        end
+      else
+        webhook&.mark_for_destruction
+      end
+    end
+
+    def validate_webhook_url
+      if webhook && !webhook.marked_for_destruction? && !webhook.valid?
+        errors.add(:webhook_url, :invalid) if errors[:webhook_url].empty?
+      end
+    end
+
+    def ensure_within_bot_limit
+      if creator&.reached_bot_limit?
+        errors.add(:base, "You've reached the limit of chat bots.")
+      end
+    end
+
+    def ensure_bot_token
+      self.bot_token ||= generate_unique_bot_token
+    end
+
+    def generate_unique_bot_token
+      loop do
+        token = SecureRandom.base58(24)
+        break token unless User.exists?(bot_token: token)
+      end
+    end
+end
diff --git a/app/models/user/bot/suspendable.rb b/app/models/user/bot/suspendable.rb
new file mode 100644
index 0000000..60d25c2
--- /dev/null
+++ b/app/models/user/bot/suspendable.rb
@@ -0,0 +1,142 @@
+module User::Bot::Suspendable
+  extend ActiveSupport::Concern
+
+  FLOOD_MESSAGE_LIMIT          = 10
+  FLOOD_WINDOW                 = 10.seconds
+  COOLDOWN_DURATION            = 30.seconds
+  COOLDOWN_SUSPENSION_ATTEMPTS = 5
+  WEBHOOK_FAILURE_LIMIT        = 10
+
+  FLOODING_SUSPENSION_REASON        = "Flooding (too many messages)"
+  WEBHOOK_FAILURE_SUSPENSION_REASON = "Failing webhooks (10 failed deliveries)"
+
+  PostResult = Data.define(:status, :message, :retry_after) do
+    def initialize(status:, message: nil, retry_after: nil)
+      super
+    end
+  end
+
+  included do
+    scope :suspended,   -> { where.not(suspended_at: nil) }
+    scope :unsuspended, -> { where(suspended_at: nil) }
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def cooling_down?(now = Time.current)
+    bot_cooldown_until.present? && bot_cooldown_until > now
+  end
+
+  def cooldown_seconds_left(now = Time.current, until_time = bot_cooldown_until)
+    return 0 unless until_time.present? && until_time > now
+
+    (until_time.to_f - now.to_f).ceil.clamp(1, COOLDOWN_DURATION.to_i)
+  end
+
+  def suspend!(reason:, at: Time.current)
+    update!(
+      suspended_at: at,
+      suspension_reason: reason,
+      bot_cooldown_until: nil,
+      bot_cooldown_attempts: 0,
+      bot_post_timestamps: []
+    )
+  end
+
+  def reactivate
+    with_lock do
+      update!(
+        suspended_at: nil,
+        suspension_reason: nil,
+        bot_cooldown_until: nil,
+        bot_cooldown_attempts: 0,
+        bot_post_timestamps: [],
+        bot_webhook_failures: 0
+      )
+    end
+  end
+
+  def deliver_bot_message(room, body:)
+    result = with_lock do
+      now = Time.current
+
+      if suspended?
+        PostResult.new(status: :suspended)
+      elsif cooling_down?(now)
+        record_cooldown_attempt!(now)
+      else
+        attempt_message_delivery(room, body: body, now: now)
+      end
+    end
+
+    result.message.broadcast_create if result.status == :created
+    result
+  end
+
+  def record_webhook_success!
+    User.where(id: id).where("bot_webhook_failures > 0").update_all(bot_webhook_failures: 0)
+    self.bot_webhook_failures = 0
+  end
+
+  def record_webhook_failure!
+    with_lock do
+      return if suspended? || deactivated?
+
+      failures = bot_webhook_failures + 1
+      if failures >= WEBHOOK_FAILURE_LIMIT
+        update!(
+          bot_webhook_failures: failures,
+          suspended_at: Time.current,
+          suspension_reason: WEBHOOK_FAILURE_SUSPENSION_REASON,
+          bot_cooldown_until: nil,
+          bot_cooldown_attempts: 0,
+          bot_post_timestamps: []
+        )
+      else
+        update_columns(bot_webhook_failures: failures)
+      end
+    end
+  end
+
+  private
+    def record_cooldown_attempt!(now)
+      attempts = bot_cooldown_attempts + 1
+
+      if attempts >= COOLDOWN_SUSPENSION_ATTEMPTS
+        suspend!(reason: FLOODING_SUSPENSION_REASON, at: now)
+        PostResult.new(status: :suspended)
+      else
+        update_columns(bot_cooldown_attempts: attempts)
+        PostResult.new(status: :cooling_down, retry_after: cooldown_seconds_left(now))
+      end
+    end
+
+    def attempt_message_delivery(room, body:, now:)
+      message = room.messages.new(creator: self, body: body)
+      return PostResult.new(status: :invalid, message: message) unless message.valid?
+
+      window_start = now.to_f - FLOOD_WINDOW.to_f
+      recent = Array(bot_post_timestamps).map(&:to_f).select { |ts| ts > window_start }
+
+      if recent.size >= FLOOD_MESSAGE_LIMIT
+        cooldown_until = now + COOLDOWN_DURATION
+        update_columns(
+          bot_post_timestamps: recent,
+          bot_cooldown_until: cooldown_until,
+          bot_cooldown_attempts: 0
+        )
+        PostResult.new(status: :cooling_down, retry_after: cooldown_seconds_left(now, cooldown_until))
+      else
+        recent << now.to_f
+        update_columns(
+          bot_post_timestamps: recent,
+          bot_cooldown_until: nil,
+          bot_cooldown_attempts: 0
+        )
+        message.save!
+        PostResult.new(status: :created, message: message)
+      end
+    end
+end
