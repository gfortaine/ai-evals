diff --git a/test/models/user/bot_suspension_test.rb b/test/models/user/bot_suspension_test.rb
new file mode 100644
index 0000000..5e4532f
--- /dev/null
+++ b/test/models/user/bot_suspension_test.rb
@@ -0,0 +1,223 @@
+require "test_helper"
+
+class User::BotSuspensionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @bot = User.create_bot!(name: "Flood Bot", webhook_url: "https://bot.example.com/hook")
+    Current.reset
+
+    @author = users(:david)
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+  end
+
+  test "allows up to 10 messages in 10 seconds across API and webhook replies, then rejects 11th with 30s cooldown" do
+    stub_request(:post, "https://bot.example.com/hook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Webhook reply")
+
+    freeze_time do
+      7.times do |i|
+        result = @bot.deliver_bot_message(@room, body: "API message #{i}")
+        assert_equal :created, result.status
+      end
+
+      3.times do
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} hi</div>")
+        end
+      end
+
+      assert_equal 10, @bot.messages.count
+      assert_not @bot.reload.cooling_down?
+      assert_not @bot.suspended?
+
+      # 11th message within 10s is rejected and starts a 30-second cooldown
+      over_limit = nil
+      assert_no_difference -> { Message.count } do
+        over_limit = @bot.deliver_bot_message(@room, body: "11th message")
+      end
+
+      assert_equal :cooling_down, over_limit.status
+      assert_equal 30, over_limit.retry_after
+      assert @bot.reload.cooling_down?
+      assert_not @bot.suspended?
+
+      # Webhook replies are not posted during the cooldown
+      travel 5.seconds
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} during cooldown</div>")
+      end
+      assert_equal 10, @bot.messages.count
+      assert_equal 1, @bot.reload.bot_cooldown_attempts
+
+      # After the 30-second cooldown expires, the bot can post again
+      travel 25.seconds
+      assert_not @bot.cooling_down?
+      after_cooldown = @bot.deliver_bot_message(@room, body: "Back after cooldown")
+      assert_equal :created, after_cooldown.status
+      assert_equal 11, @bot.messages.count
+    end
+  end
+
+  test "sliding 10-second window allows more messages once older ones age past 10 seconds" do
+    freeze_time do
+      6.times { |i| assert_equal :created, @bot.deliver_bot_message(@room, body: "Batch A #{i}").status }
+
+      travel 6.seconds
+      4.times { |i| assert_equal :created, @bot.deliver_bot_message(@room, body: "Batch B #{i}").status }
+
+      # At t=8s, all 10 messages are still within [t-2s, t=8s] -> wait, Batch A was at t=0, window at t=8s is (-2s..8s), so all 10 count
+      # Wait until t=10s so Batch A (at t=0) ages out of the 10-second window
+      travel 4.seconds
+      6.times { |i| assert_equal :created, @bot.deliver_bot_message(@room, body: "Batch C #{i}").status }
+
+      assert_equal 16, @bot.messages.count
+      assert_not @bot.reload.cooling_down?
+    end
+  end
+
+  test "five more attempts during the same cooldown suspend the bot, while attempts across separate cooldowns do not accumulate" do
+    freeze_time do
+      10.times { |i| @bot.deliver_bot_message(@room, body: "Msg #{i}") }
+
+      # Start first cooldown
+      assert_equal :cooling_down, @bot.deliver_bot_message(@room, body: "Over limit 1").status
+
+      # 4 attempts during first cooldown do not suspend
+      4.times do |i|
+        res = @bot.deliver_bot_message(@room, body: "Cooldown 1 attempt #{i}")
+        assert_equal :cooling_down, res.status
+        assert_not @bot.reload.suspended?
+      end
+
+      # Let first cooldown expire
+      travel 30.seconds
+      assert_not @bot.cooling_down?
+
+      # Trigger a second cooldown
+      10.times { |i| assert_equal :created, @bot.deliver_bot_message(@room, body: "Second burst #{i}").status }
+      assert_equal :cooling_down, @bot.deliver_bot_message(@room, body: "Over limit 2").status
+      assert_equal 0, @bot.reload.bot_cooldown_attempts
+
+      # 4 attempts during second cooldown still do not suspend
+      4.times do |i|
+        res = @bot.deliver_bot_message(@room, body: "Cooldown 2 attempt #{i}")
+        assert_equal :cooling_down, res.status
+        assert_not @bot.reload.suspended?
+      end
+
+      # 5th attempt during second cooldown suspends the bot
+      fifth = @bot.deliver_bot_message(@room, body: "Cooldown 2 attempt 5")
+      assert_equal :suspended, fifth.status
+      assert @bot.reload.suspended?
+      assert_match(/flood/i, @bot.suspension_reason)
+    end
+  end
+
+  test "ten failed webhook deliveries in a row suspend the bot and a 2xx delivery resets the count" do
+    # Mix of non-2xx responses, timeouts, and connection errors (9 total)
+    failures = [
+      -> { stub_request(:post, @bot.webhook.url).to_return(status: 500) },
+      -> { stub_request(:post, @bot.webhook.url).to_return(status: 502) },
+      -> { stub_request(:post, @bot.webhook.url).to_return(status: 404) },
+      -> { stub_request(:post, @bot.webhook.url).to_return(status: 302, headers: { "Location" => "https://other.example.com" }) },
+      -> { stub_request(:post, @bot.webhook.url).to_timeout },
+      -> { stub_request(:post, @bot.webhook.url).to_raise(Net::ReadTimeout) },
+      -> { stub_request(:post, @bot.webhook.url).to_raise(Errno::ECONNREFUSED) },
+      -> { stub_request(:post, @bot.webhook.url).to_raise(SocketError.new("Failed to open TCP connection")) },
+      -> { stub_request(:post, @bot.webhook.url).to_return(status: 429) }
+    ]
+
+    failures.each do |setup_stub|
+      WebMock.reset!
+      setup_stub.call
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+      end
+    end
+
+    assert_equal 9, @bot.reload.bot_webhook_failures
+    assert_not @bot.suspended?
+
+    # A 2xx response resets the count
+    WebMock.reset!
+    stub_request(:post, @bot.webhook.url).to_return(status: 204)
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} ok</div>")
+    end
+
+    assert_equal 0, @bot.reload.bot_webhook_failures
+    assert_not @bot.suspended?
+
+    # Now 9 failures again do not suspend, and the 10th suspends
+    WebMock.reset!
+    stub_request(:post, @bot.webhook.url).to_return(status: 503)
+
+    9.times do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} fail</div>")
+      end
+    end
+    assert_not @bot.reload.suspended?
+
+    # 10th consecutive failure via joined webhook suspends the bot
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      rooms(:pets).memberships.grant_to(@bot)
+    end
+
+    assert @bot.reload.suspended?
+    assert_match(/webhook/i, @bot.suspension_reason)
+  end
+
+  test "suspended bot keeps rooms and messages, counts towards owner bot limit, receives no webhooks, and reactivate restores full operation" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    @room.messages.create!(creator: @bot, body: "Historical bot message")
+    closed_room = rooms(:designers)
+    closed_room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+
+    # Flood and suspend within frozen time so reactivation happens < 10s after the flood burst
+    freeze_time do
+      10.times { |i| @bot.deliver_bot_message(@room, body: "Flood #{i}") }
+      @bot.deliver_bot_message(@room, body: "Start cooldown")
+      5.times { @bot.deliver_bot_message(@room, body: "Suspend me") }
+
+      assert @bot.reload.suspended?
+
+      # Keeps rooms and messages
+      assert_includes @bot.rooms.reload, @room
+      assert_includes @bot.rooms, closed_room
+      assert_equal 11, @bot.messages.count
+
+      # Counts towards owner's bot limit
+      assert users(:kevin).reached_bot_limit?(accounts(:signal))
+
+      # Receives no webhooks on mention or room join (and even if job was enqueued before suspension)
+      stub = stub_request(:post, @bot.webhook.url).to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Should not fire")
+
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} hello?</div>")
+        rooms(:pets).memberships.grant_to(@bot)
+      end
+
+      prior_msg = @room.messages.last
+      @bot.webhook.deliver(prior_msg)
+      assert_not_requested stub
+
+      # Reactivating clears suspension and resets flood window immediately
+      @bot.reactivate
+      assert_not @bot.reload.suspended?
+      assert_nil @bot.suspension_reason
+
+      res = @bot.deliver_bot_message(@room, body: "I am back!")
+      assert_equal :created, res.status
+    end
+
+    stub = stub_request(:post, @bot.webhook.url).to_return(status: 204)
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} welcome back</div>")
+    end
+    assert_requested stub, times: 1
+  end
+end
diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
new file mode 100644
index 0000000..8e16227
--- /dev/null
+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,187 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+  end
+
+  teardown do
+    Current.reset
+  end
+
+  test "create_bot! creates an active bot owned by Current.user with a unique bot_key" do
+    bot = User.create_bot!(name: "Deploy Bot")
+
+    assert bot.bot?
+    assert bot.active?
+    assert_not bot.auto_join_open_rooms?
+    assert_equal users(:kevin), bot.creator
+    assert bot.bot_token.present?
+    assert_equal "#{bot.id}-#{bot.bot_token}", bot.bot_key
+    assert_includes users(:kevin).bots, bot
+  end
+
+  test "human users do not get a bot_token or bot_key and still join all open rooms by default" do
+    user = User.create!(name: "Human", email_address: "human@example.com", password: "secret123456")
+
+    assert user.member?
+    assert_nil user.bot_token
+    assert_nil user.bot_key
+    assert_includes User.without_bots, user
+    assert_equal Rooms::Open.pluck(:id).sort, user.rooms.pluck(:id).sort
+  end
+
+  test "bot requires a name" do
+    bot = User.new_bot(name: "")
+    assert_not bot.valid?
+    assert_includes bot.errors[:name], "can't be blank"
+  end
+
+  test "new bot does not join open rooms by default" do
+    bot = User.create_bot!(name: "Deploy Bot")
+
+    assert_empty bot.rooms
+  end
+
+  test "bot with auto_join_open_rooms joins existing open rooms and future open rooms, and keeps memberships when turned off" do
+    bot = User.create_bot!(name: "Global Bot", auto_join_open_rooms: true)
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+    assert_not_includes bot.rooms, rooms(:designers)
+
+    later_open_room = Rooms::Open.create!(name: "Announcements", creator: users(:david))
+    assert_includes later_open_room.users, bot
+
+    # Turning the switch off keeps current memberships, but skips future open rooms
+    bot.update!(auto_join_open_rooms: false)
+    assert_includes bot.reload.rooms, rooms(:hq)
+    assert_includes bot.rooms, rooms(:pets)
+    assert_includes bot.rooms, later_open_room
+
+    after_off_room = Rooms::Open.create!(name: "After Off", creator: users(:david))
+    assert_not_includes after_off_room.users, bot
+  end
+
+  test "turning auto_join_open_rooms on for an existing bot adds it to all open rooms" do
+    bot = User.create_bot!(name: "Selective Bot")
+    rooms(:hq).memberships.grant_to(bot)
+    assert_equal [ rooms(:hq).id ], bot.rooms.pluck(:id)
+
+    bot.update!(auto_join_open_rooms: true)
+    assert_equal Rooms::Open.pluck(:id).sort, bot.reload.rooms.pluck(:id).sort
+  end
+
+  test "new open room grants access to auto-joining active bots only, not default or deactivated bots" do
+    default_bot = User.create_bot!(name: "Default Bot")
+    auto_bot = User.create_bot!(name: "Auto Bot", auto_join_open_rooms: true)
+    deleted_auto_bot = User.create_bot!(name: "Deleted Auto Bot", auto_join_open_rooms: true)
+    deleted_auto_bot.deactivate
+
+    open_room = Rooms::Open.create!(name: "Announcements", creator: users(:david))
+
+    assert_not_includes open_room.users, default_bot
+    assert_includes open_room.users, auto_bot
+    assert_not_includes open_room.users, deleted_auto_bot
+  end
+
+  test "authenticate_bot verifies bot_key securely" do
+    bot = User.create_bot!(name: "Deploy Bot")
+
+    assert_equal bot, User.authenticate_bot(bot.bot_key)
+    assert_nil User.authenticate_bot("#{bot.id}-wrongtoken")
+    assert_nil User.authenticate_bot("999999-#{bot.bot_token}")
+    assert_nil User.authenticate_bot("#{users(:david).id}-#{bot.bot_token}")
+    assert_nil User.authenticate_bot("malformed_without_dash")
+    assert_nil User.authenticate_bot("")
+    assert_nil User.authenticate_bot(nil)
+  end
+
+  test "deactivating a bot revokes its bot_key, destroys its webhook, and removes non-direct memberships" do
+    bot = User.create_bot!(name: "Deploy Bot", webhook_url: "https://bot.example.com/hook", auto_join_open_rooms: true)
+    old_key = bot.bot_key
+    webhook_id = bot.webhook.id
+    assert_not_empty bot.memberships.without_direct_rooms
+
+    bot.deactivate
+
+    assert bot.reload.deactivated?
+    assert_nil bot.bot_token
+    assert_nil bot.bot_key
+    assert_nil bot.webhook
+    assert_not Webhook.exists?(webhook_id)
+    assert_nil User.authenticate_bot(old_key)
+    assert_empty bot.memberships.without_direct_rooms
+  end
+
+  test "bot optional webhook_url creates, updates, and removes webhook" do
+    bot_without_hook = User.create_bot!(name: "Quiet Bot")
+    assert_nil bot_without_hook.webhook
+    assert_nil bot_without_hook.webhook_url
+
+    bot = User.create_bot!(name: "Ops Bot", webhook_url: "  https://bot.example.com/hook  ")
+    assert_equal "https://bot.example.com/hook", bot.webhook_url
+    assert_equal "https://bot.example.com/hook", bot.reload.webhook.url
+
+    # Updating name alone keeps webhook intact
+    bot.update!(name: "Renamed Ops Bot")
+    assert_equal "https://bot.example.com/hook", bot.reload.webhook_url
+
+    # Updating webhook_url changes the webhook URL
+    bot.update!(webhook_url: "http://localhost:4567/new-hook")
+    assert_equal "http://localhost:4567/new-hook", bot.reload.webhook_url
+
+    # Failed validation on another attribute does not prematurely destroy webhook in DB
+    assert_not bot.update(name: "", webhook_url: "")
+    assert_nil bot.webhook_url
+    assert_equal "http://localhost:4567/new-hook", bot.reload.webhook_url
+
+    # Saving with empty webhook_url removes the bot's webhook
+    assert_difference -> { Webhook.count }, -1 do
+      bot.update!(webhook_url: "")
+    end
+    assert_nil bot.webhook_url
+    assert_nil bot.reload.webhook
+  end
+
+  test "bot validates webhook_url when provided" do
+    bot = User.new_bot(name: "Bad Hook Bot", webhook_url: "not-a-valid-url")
+    assert_not bot.valid?
+    assert_includes bot.errors[:webhook_url], "is invalid"
+  end
+
+  test "can_administer? allows bot creator and administrators only" do
+    bot = User.create_bot!(name: "Kevin Bot")
+
+    assert users(:kevin).can_administer?(bot)
+    assert users(:david).can_administer?(bot)
+    assert_not users(:jz).can_administer?(bot)
+    assert_not bot.can_administer?(bot)
+  end
+
+test "members are capped at account bots_per_member while deleted bots do not count and admins are unlimited" do
+  accounts(:signal).update!(settings: { bots_per_member: 2 })
+
+  bot1 = User.create_bot!(name: "Kevin Bot 1")
+  bot2 = User.create_bot!(name: "Kevin Bot 2")
+  assert users(:kevin).reached_bot_limit?
+
+  extra_bot = User.new_bot(name: "Kevin Bot 3")
+  assert_not extra_bot.valid?
+
+  # Existing bots can still be updated and deactivated when at or above the limit
+  accounts(:signal).update!(settings: { bots_per_member: 1 })
+  bot2.update!(name: "Kevin Bot 2 Renamed")
+  bot1.deactivate
+  assert users(:kevin).reached_bot_limit?
+
+  bot2.deactivate
+  assert_not users(:kevin).reached_bot_limit?
+  assert User.create_bot!(name: "Kevin Replacement Bot").persisted?
+
+  # Administrators are never limited, even at 0
+  accounts(:signal).update!(settings: { bots_per_member: 0 })
+  Current.user = users(:david)
+  assert_not users(:david).reached_bot_limit?
+  assert User.create_bot!(name: "Admin Bot 1").persisted?
+  assert User.create_bot!(name: "Admin Bot 2").persisted?
+end
+end
diff --git a/test/models/webhook_test.rb b/test/models/webhook_test.rb
new file mode 100644
index 0000000..1428bdc
