diff --git a/test/controllers/bot_limits_test.rb b/test/controllers/bot_limits_test.rb
new file mode 100644
index 0000000..3b632f2
--- /dev/null
+++ b/test/controllers/bot_limits_test.rb
@@ -0,0 +1,174 @@
+require "test_helper"
+require "capybara/rails"
+require "capybara/minitest"
+
+class BotLimitsTest < ActionDispatch::IntegrationTest
+  include Capybara::DSL
+  include Capybara::Minitest::Assertions
+
+  setup do
+    Capybara.current_driver = :rack_test
+  end
+
+  teardown do
+    Capybara.reset_sessions!
+    Capybara.use_default_driver
+  end
+
+  test "account settings page offers Bots per member (5 by default) only to administrators" do
+    sign_in_via_form("david@37signals.com")
+
+    visit edit_account_path
+    assert_text "Bots per member"
+    assert_field "Bots per member", with: "5"
+
+    fill_in "Bots per member", with: "2"
+    click_button "Save changes"
+
+    assert_current_path edit_account_path
+    assert_field "Bots per member", with: "2"
+    assert_equal 2, accounts(:signal).reload.settings.bots_per_member
+
+    Capybara.reset_sessions!
+    sign_in_via_form("kevin@37signals.com")
+
+    visit edit_account_path
+    assert_no_text "Bots per member"
+    assert_no_field "Bots per member"
+  end
+
+  test "member is capped at Bots per member, sees reached the limit, and deleted bots do not count" do
+    # Default limit is 5
+    sign_in_via_form("kevin@37signals.com")
+
+    5.times do |i|
+      visit bots_path
+      assert_link "Add a chat bot"
+      assert_no_text "reached the limit"
+
+      click_link "Add a chat bot"
+      fill_in "Name the bot", with: "Kevin Bot #{i + 1}"
+      click_button "Save changes"
+    end
+
+    assert_equal 5, users(:kevin).bots.active.count
+
+    # At the limit: bots page doesn't offer "Add a chat bot" and tells member they've "reached the limit"
+    visit bots_path
+    assert_no_link "Add a chat bot"
+    assert_no_text "Add a chat bot"
+    assert_text "reached the limit"
+
+    # Direct attempts to access /bots/new or POST /bots are refused
+    sign_in :kevin
+    get new_bot_url
+    assert_response :forbidden
+
+    assert_no_difference -> { User.bot.count } do
+      post bots_url, params: { bot: { name: "Extra Bot" } }
+    end
+    assert_response :forbidden
+
+    # Existing bots can still be edited while at the limit
+    first_bot = users(:kevin).bots.active.ordered.first
+    patch bot_url(first_bot), params: { bot: { name: "Renamed Kevin Bot 1" } }
+    assert_redirected_to bots_url
+    assert_equal "Renamed Kevin Bot 1", first_bot.reload.name
+
+    # Deleting a bot frees up a slot because deleted bots don't count
+    delete bot_url(first_bot)
+    assert_redirected_to bots_url
+    assert first_bot.reload.deactivated?
+    assert_equal 4, users(:kevin).bots.active.count
+
+    visit bots_path
+    assert_link "Add a chat bot"
+    assert_no_text "reached the limit"
+
+    click_link "Add a chat bot"
+    fill_in "Name the bot", with: "Replacement Bot"
+    click_button "Save changes"
+
+    assert_current_path bots_path
+    assert_equal 5, users(:kevin).bots.active.count
+    assert_no_link "Add a chat bot"
+    assert_text "reached the limit"
+  end
+
+  test "administrators are not limited even when Bots per member is 0" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+
+    # Member with 0 bots is already at the limit of 0
+    sign_in_via_form("kevin@37signals.com")
+    visit bots_path
+    assert_no_link "Add a chat bot"
+    assert_text "reached the limit"
+
+    sign_in :kevin
+    get new_bot_url
+    assert_response :forbidden
+    post bots_url, params: { bot: { name: "Blocked Bot" } }
+    assert_response :forbidden
+
+    # Administrator can still add bots without limit
+    Capybara.reset_sessions!
+    sign_in_via_form("david@37signals.com")
+
+    3.times do |i|
+      visit bots_path
+      assert_link "Add a chat bot"
+      assert_no_text "reached the limit"
+
+      click_link "Add a chat bot"
+      fill_in "Name the bot", with: "Admin Bot #{i + 1}"
+      click_button "Save changes"
+    end
+
+    assert_equal 3, users(:david).bots.active.count
+    visit bots_path
+    assert_link "Add a chat bot"
+    assert_no_text "reached the limit"
+  end
+
+  test "lowering the limit never removes existing bots and only blocks new ones" do
+    sign_in :kevin
+    4.times do |i|
+      post bots_url, params: { bot: { name: "Existing Bot #{i + 1}" } }
+      assert_redirected_to bots_url
+    end
+    assert_equal 4, users(:kevin).bots.active.count
+
+    # Admin lowers limit from 5 to 2
+    sign_in :david
+    put account_url, params: { account: { settings: { bots_per_member: "2" } } }
+    assert_redirected_to edit_account_url
+    assert_equal 2, accounts(:signal).reload.settings.bots_per_member
+
+    # All 4 existing bots remain active and functional
+    assert_equal 4, users(:kevin).bots.active.count
+    bot = users(:kevin).bots.active.first
+    rooms(:hq).memberships.grant_to(bot)
+    post room_bot_messages_url(rooms(:hq), bot.bot_key), params: "Still working!", headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :created
+
+    # Member sees existing bots, cannot create new ones, and can still edit/delete existing ones
+    sign_in_via_form("kevin@37signals.com")
+    visit bots_path
+    4.times { |i| assert_text "Existing Bot #{i + 1}" }
+    assert_no_link "Add a chat bot"
+    assert_text "reached the limit"
+
+    sign_in :kevin
+    post bots_url, params: { bot: { name: "Fifth Bot" } }
+    assert_response :forbidden
+    assert_equal 4, users(:kevin).bots.active.count
+  end
+
+  private
+    def sign_in_via_form(email)
+      visit new_session_path
+      fill_in "email_address", with: email
+      fill_in "password", with: "secret123456"
+      find("button[type='submit']").click
+    end
+end
diff --git a/test/controllers/bot_suspensions_test.rb b/test/controllers/bot_suspensions_test.rb
new file mode 100644
index 0000000..5382a41
--- /dev/null
+++ b/test/controllers/bot_suspensions_test.rb
@@ -0,0 +1,138 @@
+require "test_helper"
+
+class BotSuspensionsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    post bots_url, params: { bot: { name: "Misbehaving Bot", webhook_url: "https://bot.example.com/hook" } }
+    @bot = User.bot.find_by!(name: "Misbehaving Bot")
+
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+    delete session_url
+  end
+
+  test "flooding endpoint returns 429 with Retry-After during 30s cooldown and 403 once suspended after 5 cooldown attempts" do
+    freeze_time do
+      10.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Message #{i + 1}", headers: { "CONTENT_TYPE" => "text/plain" }
+        assert_response :created
+      end
+
+      # 11th message goes over the limit, is rejected, and starts a 30s cooldown
+      assert_no_difference -> { Message.count } do
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Over limit", headers: { "CONTENT_TYPE" => "text/plain" }
+      end
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+
+      # Advance 12 seconds into cooldown -> Retry-After reflects 18 seconds left
+      travel 12.seconds
+      post room_bot_messages_url(@room, @bot.bot_key), params: +"Attempt 1", headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :too_many_requests
+      assert_equal "18", response.headers["Retry-After"]
+
+      # Attempts 2, 3, 4 during same cooldown still return 429
+      travel 7.seconds
+      3.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Attempt #{i + 2}", headers: { "CONTENT_TYPE" => "text/plain" }
+        assert_response :too_many_requests
+        assert_equal "11", response.headers["Retry-After"]
+      end
+      assert_not @bot.reload.suspended?
+
+      # 5th attempt during the same cooldown suspends the bot and returns 403 Forbidden
+      post room_bot_messages_url(@room, @bot.bot_key), params: +"Attempt 5", headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :forbidden
+      assert_nil response.headers["Retry-After"]
+      assert @bot.reload.suspended?
+
+      # Even after 30+ seconds pass, a suspended bot continues getting 403 Forbidden
+      travel 60.seconds
+      post room_bot_messages_url(@room, @bot.bot_key), params: +"Still suspended", headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :forbidden
+
+      # Even posting to a room id it is not in returns 403 Forbidden while suspended
+      post room_bot_messages_url(rooms(:designers), @bot.bot_key), params: +"Other room", headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :forbidden
+
+      # Invalid bot_key still gets 401 Unauthorized
+      post room_bot_messages_url(@room, "#{@bot.id}-wrongtoken"), params: +"Bad token", headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :unauthorized
+    end
+  end
+
+  test "bots page shows Suspended with reason to owner and admin, but only administrator sees and can use Reactivate" do
+    @bot.suspend!(reason: User::Bot::Suspendable::WEBHOOK_FAILURE_SUSPENSION_REASON)
+
+    # Regular member owner sees their suspended bot and reason, counts towards limit, but NO Reactivate button
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    sign_in :kevin
+    get bots_url
+    assert_response :ok
+    assert_select "p", text: /reached the limit/
+    assert_select "li##{dom_id(@bot)}" do
+      assert_select "strong", text: "Misbehaving Bot"
+      assert_select "strong", text: "Suspended"
+      assert_match(/webhook/i, css_select("li##{dom_id(@bot)}").first.text)
+      assert_select "button", text: "Reactivate", count: 0
+    end
+
+    # Direct reactivation attempt by owner (non-admin) is forbidden
+    delete bot_suspension_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+
+    # Direct reactivation attempt by another member is forbidden
+    sign_in :jz
+    delete bot_suspension_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+
+    # Owner can still edit webhook URL of their suspended bot without reactivating it
+    sign_in :kevin
+    patch bot_url(@bot), params: { bot: { name: "Misbehaving Bot", webhook_url: "https://fixed.example.com/hook" } }
+    assert_redirected_to bots_url
+    assert_equal "https://fixed.example.com/hook", @bot.reload.webhook_url
+    assert @bot.suspended?
+
+    # Administrator sees Suspended, reason, and Reactivate button with native turbo_confirm
+    sign_in :david
+    get bots_url
+    assert_response :ok
+    assert_select "li##{dom_id(@bot)}" do
+      assert_select "strong", text: "Suspended"
+      assert_select "form[action='#{bot_suspension_path(@bot)}'] button[data-turbo-confirm]", text: "Reactivate"
+    end
+
+    # Administrator reactivates the bot
+    delete bot_suspension_url(@bot)
+    assert_redirected_to bots_url
+    assert_not @bot.reload.suspended?
+
+    get bots_url
+    assert_response :ok
+    assert_select "li##{dom_id(@bot)}" do
+      assert_select "strong", text: "Suspended", count: 0
+      assert_select "button", text: "Reactivate", count: 0
+    end
+
+    # Bot can post again immediately
+    delete session_url
+    post room_bot_messages_url(@room, @bot.bot_key), params: +"Hello again!", headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :created
+  end
+
+  test "editing a room while a bot is suspended preserves the suspended bot's membership" do
+    @bot.suspend!(reason: User::Bot::Suspendable::FLOODING_SUSPENSION_REASON)
+
+    sign_in :david
+    get edit_rooms_open_url(@room)
+    assert_response :ok
+    assert_select "input[type='checkbox'][name='user_ids[]'][value='#{@bot.id}'][checked]"
+
+    put rooms_open_url(@room), params: { room: { name: "HQ Renamed" }, user_ids: [ "", @bot.id ] }
+    assert_redirected_to room_url(@room)
+    assert_includes @room.reload.users, @bot
+  end
+end
diff --git a/test/controllers/bot_webhook_flow_test.rb b/test/controllers/bot_webhook_flow_test.rb
new file mode 100644
index 0000000..3c2fa8a
--- /dev/null
+++ b/test/controllers/bot_webhook_flow_test.rb
@@ -0,0 +1,161 @@
+require "test_helper"
+require "socket"
+
+class BotWebhookFlowTest < ActionDispatch::IntegrationTest
+  setup do
+    WebMock.allow_net_connect!
+  end
+
+  teardown do
+    @server&.close rescue nil
+    @server_thread&.kill
+    WebMock.disable_net_connect!
+  end
+
+  test "end-to-end joined and mention webhook flow with synchronous 200 replies, 204 + async reply_to, and message deep link" do
+    requests = Queue.new
+    next_response = ->(_payload) { [ 204, {}, "" ] }
+
+    @server = TCPServer.new("127.0.0.1", 0)
+    port = @server.addr[1]
+    @server_thread = Thread.new do
+      loop do
+        client = @server.accept
+        begin
+          request_line = client.gets
+          headers = {}
+          while (line = client.gets) && line != "\r\n"
+            key, val = line.split(":", 2)
+            headers[key.downcase.strip] = val.strip if key && val
+          end
+          body = client.read(headers["content-length"].to_i)
+          parsed = JSON.parse(body)
+          requests << { request_line: request_line, headers: headers, payload: parsed }
+
+          status, resp_headers, resp_body = next_response.call(parsed)
+          reason = status == 204 ? "No Content" : "OK"
+          client.write "HTTP/1.1 #{status} #{reason}\r\n"
+          resp_headers.each { |k, v| client.write "#{k}: #{v}\r\n" }
+          client.write "Content-Length: #{resp_body.bytesize}\r\nConnection: close\r\n\r\n"
+          client.write resp_body
+        ensure
+          client.close rescue nil
+        end
+      end
+    rescue IOError, Errno::EBADF
+      # Server closed
+    end
+
+    sign_in :david
+    webhook_url = "http://127.0.0.1:#{port}/campfire-hook"
+
+    # Creating bot with switch off by default joins no rooms and triggers no webhooks
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      post bots_url, params: { bot: { name: "Ops Bot", webhook_url: webhook_url } }
+    end
+    assert_redirected_to bots_url
+    bot = User.bot.find_by!(name: "Ops Bot")
+    assert_empty bot.rooms
+    assert requests.empty?
+
+    # Direct conversation with bot never triggers joined
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      post rooms_directs_url, params: { user_ids: [ bot.id ] }
+    end
+    assert requests.empty?
+
+    # Adding bot to open room HQ triggers joined and posts synchronous 200 greeting
+    room = rooms(:hq)
+    next_response = ->(_payload) { [ 200, { "Content-Type" => "text/plain; charset=utf-8" }, "Hello HQ! Ready to help." ] }
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      put rooms_open_url(room), params: { room: { name: room.name }, user_ids: [ "", bot.id ] }
+    end
+
+    joined_req = Timeout.timeout(2) { requests.pop }
+    assert_equal "POST /campfire-hook HTTP/1.1\r\n", joined_req[:request_line]
+    assert_equal "application/json", joined_req[:headers]["content-type"]
+    assert_equal(
+      {
+        "event" => "joined",
+        "room" => {
+          "id" => room.id,
+          "name" => room.name,
+          "reply_to" => "/rooms/#{room.id}/#{bot.bot_key}/messages"
+        }
+      },
+      joined_req[:payload]
+    )
+
+    greeting_msg = room.messages.order(:id).last
+    assert_equal bot, greeting_msg.creator
+    assert_equal "Hello HQ! Ready to help.", greeting_msg.plain_text_body
+
+    sign_in :kevin
+
+    # 1. Bot appears in room @-mention autocomplete
+    get autocompletable_users_url(room_id: room.id, format: :json), params: { query: "Ops" }
+    assert_response :ok
+    bot_entry = response.parsed_body.find { |u| u["value"] == bot.id }
+    assert_not_nil bot_entry
+    assert_equal "Ops Bot", bot_entry["name"]
+
+    # 2. Synchronous 200 text/plain reply to mention
+    next_response = ->(_payload) { [ 200, { "Content-Type" => "text/plain; charset=utf-8" }, "Restarting build #99..." ] }
+
+    mention_html = "<action-text-attachment sgid=\"#{bot_entry["sgid"]}\" content-type=\"application/vnd.campfire.mention\"></action-text-attachment>"
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      post room_messages_url(room, format: :turbo_stream), params: {
+        message: { body: "<div>#{mention_html} restart the build please</div>", client_message_id: "m1" }
+      }
+      assert_response :ok
+    end
+
+    req1 = Timeout.timeout(2) { requests.pop }
+    assert_equal "POST /campfire-hook HTTP/1.1\r\n", req1[:request_line]
+    assert_equal "application/json", req1[:headers]["content-type"]
+
+    payload1 = req1[:payload]
+    user_msg = room.messages.find_by!(client_message_id: "m1")
+    assert_equal "mention", payload1["event"]
+    assert_equal({ "id" => users(:kevin).id, "name" => "Kevin" }, payload1["author"])
+    assert_equal(
+      { "id" => room.id, "name" => room.name, "reply_to" => "/rooms/#{room.id}/#{bot.bot_key}/messages" },
+      payload1["room"]
+    )
+    assert_equal user_msg.id, payload1.dig("message", "id")
+    assert_equal "restart the build please", payload1.dig("message", "body", "text")
+    assert_equal "/rooms/#{room.id}/@#{user_msg.id}", payload1.dig("message", "link")
+
+    sync_reply = room.messages.order(:id).last
+    assert_equal bot, sync_reply.creator
+    assert_equal "Restarting build #99...", sync_reply.plain_text_body
+
+    # Deep link opens the room containing the mentioned message
+    get payload1.dig("message", "link")
+    assert_response :ok
+    assert_select "##{dom_id(user_msg)}"
+
+    # 3. 204 response + asynchronous out-of-band POST to room.reply_to
+    next_response = ->(_payload) { [ 204, {}, "" ] }
+
+    assert_difference -> { room.messages.count }, 1 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        post room_messages_url(room, format: :turbo_stream), params: {
+          message: { body: "<div>#{mention_html} deploy production</div>", client_message_id: "m2" }
+        }
+        assert_response :ok
+      end
+    end
+
+    req2 = Timeout.timeout(2) { requests.pop }
+    reply_to_path = req2[:payload].dig("room", "reply_to")
+
+    # Out-of-band unauthenticated bot reply using reply_to from payload
+    delete session_url
+    post reply_to_path, params: +"Deploy complete!", headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :created
+    assert_equal bot, room.messages.order(:id).last.creator
+    assert_equal "Deploy complete!", room.messages.order(:id).last.plain_text_body
+  end
+end
