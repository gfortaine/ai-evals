+++ b/test/models/webhook_test.rb
@@ -0,0 +1,375 @@
+require "test_helper"
+require "rails-dom-testing"
+
+class WebhookTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper, Rails::Dom::Testing::Assertions
+
+  setup do
+    Current.user = users(:kevin)
+    @bot = User.create_bot!(name: "Ops Bot", webhook_url: "https://bot.example.com/campfire/webhook?secret=xyz")
+    Current.reset
+
+    @author = users(:david)
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+  end
+
+  test "validates webhook url format" do
+    assert Webhook.new(user: @bot, url: "https://bot.example.com/hook").valid?
+    assert Webhook.new(user: @bot, url: "http://localhost:4567/hook").valid?
+    assert Webhook.new(user: @bot, url: "http://127.0.0.1:8080").valid?
+    assert Webhook.new(user: @bot, url: "http://[::1]:8080/hook").valid?
+
+    assert_not Webhook.new(user: @bot, url: "").valid?
+    assert_not Webhook.new(user: @bot, url: "not a url").valid?
+    assert_not Webhook.new(user: @bot, url: "ftp://example.com/hook").valid?
+    assert_not Webhook.new(user: @bot, url: "javascript:alert(1)").valid?
+    assert_not Webhook.new(user: @bot, url: "http://").valid?
+  end
+
+  test "delivers mention JSON payload with stripped bot mention and relative paths" do
+    received_body = nil
+    received_content_type = nil
+
+    stub_request(:post, "https://bot.example.com/campfire/webhook?secret=xyz")
+      .with { |req|
+        received_content_type = req.headers["Content-Type"]
+        received_body = JSON.parse(req.body)
+        true
+      }
+      .to_return(status: 204)
+
+    html = "<div>#{mention_attachment_for(@bot)} <strong>restart</strong> the build please</div>"
+    message = nil
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      message = @room.messages.create!(creator: @author, body: html)
+    end
+
+    assert_equal "application/json", received_content_type
+    assert_equal(
+      {
+        "event" => "mention",
+        "author" => { "id" => @author.id, "name" => @author.name },
+        "room" => {
+          "id" => @room.id,
+          "name" => @room.name,
+          "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_key}/messages"
+        },
+        "message" => {
+          "id" => message.id,
+          "body" => {
+            "text" => "restart the build please",
+            "html" => message.reload.body.body.to_html
+          },
+          "link" => "/rooms/#{@room.id}/@#{message.id}"
+        }
+      },
+      received_body
+    )
+    assert_includes received_body.dig("message", "body", "html"), "<strong>restart</strong> the build please"
+    assert_match %r{\A<div>.*</div>\z}m, received_body.dig("message", "body", "html")
+  end
+
+  test "strips only the receiving bot's own @-mention across positions while preserving other mentions" do
+    Current.user = users(:kevin)
+    other_bot = User.create_bot!(name: "Status Bot", webhook_url: "https://status.example.com/hook")
+    Current.reset
+    @room.memberships.grant_to(other_bot)
+    clear_enqueued_jobs
+
+    ops_texts = []
+    status_texts = []
+
+    stub_request(:post, "https://bot.example.com/campfire/webhook?secret=xyz")
+      .with { |req| ops_texts << JSON.parse(req.body).dig("message", "body", "text"); true }
+      .to_return(status: 204)
+
+    stub_request(:post, "https://status.example.com/hook")
+      .with { |req| status_texts << JSON.parse(req.body).dig("message", "body", "text"); true }
+      .to_return(status: 204)
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(creator: @author, body: "<div>hey #{mention_attachment_for(@bot)} check logs</div>")
+      @room.messages.create!(creator: @author, body: "<div>check logs #{mention_attachment_for(@bot)}</div>")
+      @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} cc #{mention_attachment_for(:jason)} #{mention_attachment_for(other_bot)} deploy now</div>")
+      @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)}&nbsp;</div>")
+    end
+
+    assert_equal [
+      "hey check logs",
+      "check logs",
+      "cc @Jason @Status Bot deploy now",
+      ""
+    ], ops_texts
+
+    assert_equal [
+      "@Ops Bot cc @Jason deploy now"
+    ], status_texts
+  end
+
+  test "direct room mention payload uses other participant's name for room.name and never triggers joined" do
+    received_payloads = []
+    stub_request(:post, "https://bot.example.com/campfire/webhook?secret=xyz")
+      .with { |req| received_payloads << JSON.parse(req.body); true }
+      .to_return(status: 204)
+
+    Current.user = @author
+    direct_room = nil
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      direct_room = Rooms::Direct.find_or_create_for([ @author, @bot ])
+    end
+    Current.reset
+    assert_empty received_payloads
+
+    # Even direct webhook.deliver(direct_room) never sends joined
+    @bot.webhook.deliver(direct_room)
+    assert_empty received_payloads
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      direct_room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+    end
+
+    assert_equal 1, received_payloads.size
+    received_payload = received_payloads.first
+    assert_equal "mention", received_payload["event"]
+    assert_equal direct_room.id, received_payload.dig("room", "id")
+    assert_equal @author.name, received_payload.dig("room", "name")
+    assert_equal "/rooms/#{direct_room.id}/#{@bot.bot_key}/messages", received_payload.dig("room", "reply_to")
+  end
+
+  test "200 text/plain posts escaped plain text reply as the bot and broadcasts to room" do
+    stub_request(:post, "https://bot.example.com/campfire/webhook?secret=xyz")
+      .to_return(
+        status: 200,
+        headers: { "Content-Type" => "text/plain; charset=utf-8" },
+        body: "Build #42 restarted ✅\nCheck <main> & logs".b
+      )
+
+    message = @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} restart</div>")
+
+    assert_difference -> { @room.messages.count }, 1 do
+      assert_broadcasts UnreadRoomsChannel.stream_name_for(@author.id), 1 do
+        perform_enqueued_jobs only: Webhook::DeliveryJob
+      end
+    end
+
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author strong", text: "Ops Bot"
+      assert_select ".message__body", text: /Build #42 restarted/
+    end
+
+    reply = @room.messages.order(:id).last
+    assert_not_equal message.id, reply.id
+    assert_equal @bot, reply.creator
+    assert_equal "Build #42 restarted ✅\nCheck <main> & logs", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "Build #42 restarted ✅<br>Check &lt;main&gt; &amp; logs"
+  end
+
+  test "200 text/html posts rich-text HTML reply as the bot and does not trigger recursive bot webhooks" do
+    Current.user = users(:kevin)
+    second_bot = User.create_bot!(name: "Audit Bot", webhook_url: "https://audit.example.com/hook")
+    Current.reset
+    @room.memberships.grant_to(second_bot)
+    clear_enqueued_jobs
+
+    audit_stub = stub_request(:post, "https://audit.example.com/hook").to_return(status: 204)
+
+    stub_request(:post, "https://bot.example.com/campfire/webhook?secret=xyz")
+      .to_return(
+        status: 200,
+        headers: { "Content-Type" => "text/html" },
+        body: "<div>#{mention_attachment_for(@bot)} #{mention_attachment_for(second_bot)} Build <strong>green</strong>!</div>"
+      )
+
+    assert_difference -> { @room.messages.count }, 2 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} status</div>")
+      end
+    end
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.body.to_html, "<strong>green</strong>"
+    assert_not_requested audit_stub
+  end
+
+  test "204, non-text 200, empty 200, 5xx errors, and network timeouts post no message and do not raise" do
+    [
+      { status: 204, headers: {}, body: "" },
+      { status: 200, headers: { "Content-Type" => "application/json" }, body: '{"ok":true}' },
+      { status: 200, headers: { "Content-Type" => "text/plain" }, body: "   \n  " },
+      { status: 502, headers: { "Content-Type" => "text/html" }, body: "<html><body>Bad Gateway</body></html>" }
+    ].each do |mock_response|
+      stub_request(:post, "https://bot.example.com/campfire/webhook?secret=xyz").to_return(**mock_response)
+
+      message = @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+
+      assert_no_difference -> { Message.count } do
+        perform_enqueued_jobs only: Webhook::DeliveryJob
+      end
+      assert message.persisted?
+    end
+
+    stub_request(:post, "https://bot.example.com/campfire/webhook?secret=xyz").to_timeout
+    @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Webhook::DeliveryJob
+    end
+  end
+
+  test "does not deliver if bot is deactivated before job executes" do
+    webhook = @bot.webhook
+    stub = stub_request(:post, webhook.url).to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Should not run")
+
+    message = @room.messages.create!(creator: @author, body: "<div>#{mention_attachment_for(@bot)} ping</div>")
+    @bot.update!(status: :deactivated, bot_token: nil)
+
+    webhook.deliver(message)
+    assert_not_requested stub
+  end
+
+  test "delivers joined event payload when added to a closed or open room and posts synchronous 200 text or HTML replies" do
+    closed_room = rooms(:designers)
+    received_payloads = []
+    received_content_types = []
+
+    stub_request(:post, "https://bot.example.com/campfire/webhook?secret=xyz")
+      .with { |req|
+        received_content_types << req.headers["Content-Type"]
+        received_payloads << JSON.parse(req.body)
+        true
+      }
+      .to_return(
+        { status: 200, headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "Hello Designers!\nHappy to help" },
+        { status: 200, headers: { "Content-Type" => "text/html" }, body: "<p>Woof <strong>All Pets</strong>!</p>" }
+      )
+
+    assert_difference -> { closed_room.messages.count }, 1 do
+      assert_broadcasts UnreadRoomsChannel.stream_name_for(@author.id), 1 do
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          closed_room.memberships.grant_to(@bot)
+        end
+      end
+    end
+
+    assert_equal [ "application/json" ], received_content_types
+    assert_equal(
+      [
+        {
+          "event" => "joined",
+          "room" => {
+            "id" => closed_room.id,
+            "name" => closed_room.name,
+            "reply_to" => "/rooms/#{closed_room.id}/#{@bot.bot_key}/messages"
+          }
+        }
+      ],
+      received_payloads
+    )
+
+    greeting = closed_room.messages.order(:id).last
+    assert_equal @bot, greeting.creator
+    assert_equal "Hello Designers!\nHappy to help", greeting.plain_text_body
+
+    # Adding to an open room with 200 text/html reply
+    open_room = rooms(:pets)
+    assert_difference -> { open_room.messages.count }, 1 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        open_room.memberships.grant_to(@bot)
+      end
+    end
+
+    assert_equal 2, received_payloads.size
+    assert_equal(
+      {
+        "event" => "joined",
+        "room" => {
+          "id" => open_room.id,
+          "name" => open_room.name,
+          "reply_to" => "/rooms/#{open_room.id}/#{@bot.bot_key}/messages"
+        }
+      },
+      received_payloads.last
+    )
+    html_greeting = open_room.messages.order(:id).last
+    assert_equal @bot, html_greeting.creator
+    assert_includes html_greeting.body.body.to_html, "<strong>All Pets</strong>"
+  end
+
+  test "delivers joined event exactly once per room across auto-join, switch toggles, and room edits" do
+    received_room_ids = []
+    stub_request(:post, "https://auto.example.com/hook")
+      .with { |req|
+        payload = JSON.parse(req.body)
+        assert_equal "joined", payload["event"]
+        received_room_ids << payload.dig("room", "id")
+        true
+      }
+      .to_return(status: 204)
+
+    Current.user = users(:kevin)
+    bot = User.create_bot!(name: "Auto Bot", webhook_url: "https://auto.example.com/hook")
+    Current.reset
+
+    # Creating bot with switch off triggers 0 joined events
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+    assert_empty received_room_ids
+
+    # Manually adding to HQ triggers joined once for HQ
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      rooms(:hq).memberships.grant_to(bot)
+    end
+    assert_equal [ rooms(:hq).id ], received_room_ids
+
+    # Re-granting HQ (e.g. room membership revision) does not re-send joined
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      rooms(:hq).memberships.revise(granted: [ users(:david), bot ], revoked: [])
+    end
+    assert_equal [ rooms(:hq).id ], received_room_ids
+
+    # Turning on auto_join_open_rooms delivers joined ONLY for Pets (not HQ again!)
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      bot.update!(auto_join_open_rooms: true)
+    end
+    assert_equal [ rooms(:hq).id, rooms(:pets).id ], received_room_ids
+
+    # Turning switch off and back on delivers 0 duplicate joined events
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      bot.update!(auto_join_open_rooms: false)
+      bot.update!(auto_join_open_rooms: true)
+    end
+    assert_equal [ rooms(:hq).id, rooms(:pets).id ], received_room_ids
+
+    # Creating a new open room delivers joined once for that new open room
+    new_open = nil
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      new_open = Rooms::Open.create_for({ name: "Ops", creator: users(:david) }, users: [ users(:david), bot ])
+    end
+    assert_equal [ rooms(:hq).id, rooms(:pets).id, new_open.id ], received_room_ids
+
+    # Converting a closed room that already contains the bot to open does NOT re-deliver joined
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      rooms(:designers).memberships.grant_to(bot)
+    end
+    assert_equal [ rooms(:hq).id, rooms(:pets).id, new_open.id, rooms(:designers).id ], received_room_ids
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      open_designers = rooms(:designers).becomes!(Rooms::Open)
+      open_designers.save!
+    end
+    assert_equal [ rooms(:hq).id, rooms(:pets).id, new_open.id, rooms(:designers).id ], received_room_ids
+  end
+
+  test "does not deliver joined if bot is removed from room or deactivated before job runs" do
+    stub = stub_request(:post, @bot.webhook.url).to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Hi")
+
+    closed_room = rooms(:designers)
+    closed_room.memberships.grant_to(@bot)
+    closed_room.memberships.revoke_from(@bot)
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+    assert_not_requested stub
+  end
+end
