diff --git a/app/models/webhook.rb b/app/models/webhook.rb
new file mode 100644
index 0000000..0d617df
--- /dev/null
+++ b/app/models/webhook.rb
@@ -0,0 +1,166 @@
+require "net/http"
+
+class Webhook < ApplicationRecord
+  OPEN_TIMEOUT  = 5.seconds
+  READ_TIMEOUT  = 5.seconds
+  WRITE_TIMEOUT = 5.seconds
+
+  belongs_to :user
+
+  validates :url, presence: true
+  validate :validate_url, if: -> { url.present? }
+
+  def deliver_later(record)
+    Webhook::DeliveryJob.perform_later(self, record)
+  end
+
+  def deliver(record)
+    case record
+    when Message then deliver_mention(record)
+    when Room    then deliver_joined(record)
+    end
+  rescue StandardError => e
+    Rails.logger.warn "Failed to deliver webhook #{id} to #{url}: #{e.class} #{e.message}"
+  end
+
+  private
+    def validate_url
+      unless parsed_url.is_a?(URI::HTTP) && parsed_url.host.present?
+        errors.add(:url, :invalid)
+      end
+    end
+
+    def parsed_url
+      URI.parse(url)
+    rescue URI::InvalidURIError
+      nil
+    end
+
+    def deliver_mention(message)
+      return unless active_recipient_in?(message.room)
+
+      if response = deliver_payload(mention_payload_for(message))
+        post_reply(message.room, response)
+      end
+    end
+
+    def deliver_joined(room)
+      return if room.direct? || !active_recipient_in?(room)
+
+      if response = deliver_payload(joined_payload_for(room))
+        post_reply(room, response)
+      end
+    end
+
+    def active_recipient_in?(room)
+      user.reload if user.persisted?
+      user.active? && !user.suspended? && user.bot? && user.bot_key.present? && room.users.exists?(id: user.id)
+    end
+
+    def joined_payload_for(room)
+      {
+        event: "joined",
+        room: room_payload_for(room)
+      }
+    end
+
+    def mention_payload_for(message)
+      room = message.room
+
+      {
+        event: "mention",
+        author: {
+          id: message.creator.id,
+          name: message.creator.name
+        },
+        room: room_payload_for(room),
+        message: {
+          id: message.id,
+          body: {
+            text: message.plain_text_without_mention(user),
+            html: message.body.body&.to_html.to_s
+          },
+          link: Rails.application.routes.url_helpers.room_at_message_path(room, message)
+        }
+      }
+    end
+
+    def room_payload_for(room)
+      {
+        id: room.id,
+        name: room_name_for(room),
+        reply_to: Rails.application.routes.url_helpers.room_bot_messages_path(room, user.bot_key)
+      }
+    end
+
+    def room_name_for(room)
+      if room.direct?
+        room.users.without(user).pluck(:name).to_sentence.presence || user.name
+      else
+        room.name
+      end
+    end
+
+    def deliver_payload(payload)
+      response = post_payload(payload)
+
+      if response.is_a?(Net::HTTPSuccess)
+        user.record_webhook_success!
+        response
+      else
+        user.record_webhook_failure!
+        nil
+      end
+    rescue StandardError => e
+      Rails.logger.warn "Failed to deliver webhook #{id} to #{url}: #{e.class} #{e.message}"
+      user.record_webhook_failure!
+      nil
+    end
+
+    def post_payload(payload)
+      uri = parsed_url
+
+      Net::HTTP.start(
+        uri.hostname,
+        uri.port,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT,
+        write_timeout: WRITE_TIMEOUT
+      ) do |http|
+        request = Net::HTTP::Post.new(uri)
+        request["Content-Type"] = "application/json"
+        request.body = payload.to_json
+        http.request(request)
+      end
+    end
+
+    def post_reply(room, response)
+      return unless response.is_a?(Net::HTTPOK)
+
+      body = formatted_reply_body(response)
+      return if body.blank?
+
+      user.deliver_bot_message(room, body: body)
+    end
+
+    def formatted_reply_body(response)
+      case response.content_type
+      when "text/plain"
+        ERB::Util.html_escape(decoded_body(response)).gsub(/\r?\n/, "<br>")
+      when "text/html"
+        decoded_body(response)
+      end
+    end
+
+    def decoded_body(response)
+      raw = response.body.to_s
+      if (charset = response.type_params["charset"]).present? && Encoding.find(charset) != Encoding::UTF_8
+        raw.force_encoding(Encoding.find(charset)).encode(Encoding::UTF_8, invalid: :replace, undef: :replace)
+      else
+        raw.dup.force_encoding(Encoding::UTF_8).scrub
+      end
+    rescue ArgumentError
+      response.body.to_s.dup.force_encoding(Encoding::UTF_8).scrub
+    end
+end
