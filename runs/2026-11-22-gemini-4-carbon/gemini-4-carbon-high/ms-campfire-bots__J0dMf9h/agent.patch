+      elsif target.previous.nil? && target.next&.text?
+        target.next.content = target.next.content.sub(/\A[ \t\u00A0]+/, "")
+      elsif target.next.nil? && target.previous&.text?
+        target.previous.content = target.previous.content.sub(/[ \t\u00A0]+\z/, "")
+      end
+
+      target.remove
+    end
