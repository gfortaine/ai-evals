+++ b/app/controllers/messages/by_bots_controller.rb
@@ -0,0 +1,48 @@
+class Messages::ByBotsController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  allow_unauthenticated_access
+  skip_forgery_protection
+  wrap_parameters false
+
+  before_action :authenticate_bot
+  before_action :set_room
+
+  def process_action(...)
+    request.request_parameters = {}
+    super
+  end
+
+  def create
+    @message = @room.messages.new(body: message_body)
+
+    if @message.save
+      @message.broadcast_create
+      head :created, location: message_path(@message)
+    else
+      head :unprocessable_content
+    end
+  end
+
+  private
+    def authenticate_bot
+      if bot = User.authenticate_bot(params[:bot_key])
+        Current.user = bot
+      else
+        head :unauthorized
+      end
+    end
+
+    def set_room
+      unless @room = Current.user.rooms.find_by(id: params[:room_id])
+        head :not_found
+      end
+    end
+
+    def message_body
+      request.raw_post.dup.force_encoding(Encoding::UTF_8).scrub
+    end
+
+    def allow_browser(**)
+    end
+end
