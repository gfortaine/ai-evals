@@ -0,0 +1,223 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  test "account edit page shows Set up chat bots icon link to members and administrators" do
+    sign_in :kevin
+    get edit_account_url
+    assert_response :ok
+    assert_select "a[href='#{bots_path}']", text: /Set up chat bots/
+
+    sign_in :david
+    get edit_account_url
+    assert_response :ok
+    assert_select "a[href='#{bots_path}']", text: /Set up chat bots/
+  end
+
+  test "bots do not appear in human members list on account edit page" do
+    sign_in :kevin
+    post bots_url, params: { bot: { name: "Secret Deploy Bot" } }
+
+    sign_in :david
+    get edit_account_url
+    assert_response :ok
+    assert_select "turbo-frame#account_users", text: /Secret Deploy Bot/, count: 0
+  end
+
+  test "requires authentication" do
+    get bots_url
+    assert_redirected_to new_session_url
+
+    get new_bot_url
+    assert_redirected_to new_session_url
+
+    post bots_url, params: { bot: { name: "Bot" } }
+    assert_redirected_to new_session_url
+  end
+
+  test "index lists only your own bots for regular members and all bots for administrators" do
+    sign_in :kevin
+    post bots_url, params: { bot: { name: "Kevin Bot" } }
+    kevin_bot = User.bot.find_by!(name: "Kevin Bot")
+
+    sign_in :jz
+    post bots_url, params: { bot: { name: "JZ Bot" } }
+    jz_bot = User.bot.find_by!(name: "JZ Bot")
+
+    # JZ (member) sees only JZ Bot
+    get bots_url
+    assert_response :ok
+    assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+    assert_select "li##{dom_id(jz_bot)}" do
+      assert_select "strong", text: "JZ Bot"
+      assert_select "label[for='#{dom_id(jz_bot, :bot_code)}']", text: /Bot code/
+      assert_select "input##{dom_id(jz_bot, :bot_code)}[readonly][value='#{jz_bot.bot_key}']"
+      assert_select "a[href='#{edit_bot_path(jz_bot)}']", text: "Edit JZ Bot"
+    end
+    assert_select "li##{dom_id(kevin_bot)}", count: 0
+    assert_no_match kevin_bot.bot_key, response.body
+
+    # David (administrator) sees all bots
+    sign_in :david
+    get bots_url
+    assert_response :ok
+    assert_select "li##{dom_id(jz_bot)}"
+    assert_select "li##{dom_id(kevin_bot)}"
+  end
+
+  test "index shows all bots on one page without pagination" do
+    sign_in :kevin
+    30.times { |i| User.new_bot(name: "Bot #{i}").tap { |b| b.creator = users(:kevin); b.save! } }
+
+    get bots_url
+    assert_response :ok
+    assert_select "menu li", count: 30
+  end
+
+  test "new renders bot creation form with required labels" do
+    sign_in :kevin
+    get new_bot_url
+    assert_response :ok
+
+    assert_select "form[action='#{bots_path}']" do
+      assert_select "input[type='file'][name='bot[avatar]']"
+      assert_select "label", text: /Name the bot/
+      assert_select "input[type='text'][name='bot[name]'][placeholder='Name the bot'][required]"
+      assert_select "button[type='submit']", text: /Save changes/
+    end
+  end
+
+  test "create creates bot with optional avatar, joins open rooms, and redirects to /bots" do
+    sign_in :kevin
+
+    assert_difference -> { User.bot.count }, 1 do
+      post bots_url, params: {
+        bot: {
+          name: "Deploy Bot",
+          avatar: fixture_file_upload("moon.jpg", "image/jpeg")
+        }
+      }
+    end
+
+    assert_redirected_to bots_url
+    bot = User.bot.find_by!(name: "Deploy Bot")
+    assert_equal users(:kevin), bot.creator
+    assert bot.avatar.attached?
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+
+    get user_avatar_url(bot.avatar_token)
+    assert_response :ok
+    assert_equal "image/webp", response.media_type
+  end
+
+  test "create with blank name responds 422" do
+    sign_in :kevin
+
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: "   " } }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "edit renders form and Delete this chat bot button with confirmation" do
+    sign_in :kevin
+    post bots_url, params: { bot: { name: "Deploy Bot" } }
+    bot = User.bot.find_by!(name: "Deploy Bot")
+
+    get edit_bot_url(bot)
+    assert_response :ok
+    assert_select "form[action='#{bot_path(bot)}']" do
+      assert_select "input[type='file'][name='bot[avatar]']"
+      assert_select "input[type='text'][name='bot[name]'][value='Deploy Bot']"
+      assert_select "button[type='submit']", text: /Save changes/
+    end
+    assert_select "form[action='#{bot_path(bot)}'] button[data-turbo-confirm]", text: /Delete this chat bot/
+  end
+
+  test "update allows creator and admin to edit bot name and avatar, forbids other members" do
+    sign_in :kevin
+    post bots_url, params: { bot: { name: "Deploy Bot" } }
+    bot = User.bot.find_by!(name: "Deploy Bot")
+
+    # Other member cannot access edit or update
+    sign_in :jz
+    get edit_bot_url(bot)
+    assert_response :forbidden
+    patch bot_url(bot), params: { bot: { name: "Hacked" } }
+    assert_response :forbidden
+
+    # Creator can update name and avatar
+    sign_in :kevin
+    patch bot_url(bot), params: {
+      bot: {
+        name: "Release Bot",
+        avatar: fixture_file_upload("moon.jpg", "image/jpeg")
+      }
+    }
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", bot.reload.name
+    assert bot.avatar.attached?
+
+    # Admin can also update
+    sign_in :david
+    patch bot_url(bot), params: { bot: { name: "Admin Renamed Bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Admin Renamed Bot", bot.reload.name
+  end
+
+  test "destroy deactivates bot for creator or admin, forbids other members" do
+    sign_in :kevin
+    post bots_url, params: { bot: { name: "Deploy Bot" } }
+    bot = User.bot.find_by!(name: "Deploy Bot")
+
+    sign_in :jz
+    delete bot_url(bot)
+    assert_response :forbidden
+    assert bot.reload.active?
+
+    sign_in :kevin
+    delete bot_url(bot)
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+
+    get edit_bot_url(bot)
+    assert_response :not_found
+  end
+
+  test "bots can be added to closed and direct rooms the same way as people" do
+    sign_in :david
+    post bots_url, params: { bot: { name: "CI Bot" } }
+    bot = User.bot.find_by!(name: "CI Bot")
+
+    # Closed room edit page shows checkbox switch for the bot
+    get edit_rooms_closed_url(rooms(:designers))
+    assert_response :ok
+    assert_select "label.switch input[type='checkbox'][name='user_ids[]'][value='#{bot.id}']"
+
+    # Adding bot to closed room
+    put rooms_closed_url(rooms(:designers)), params: {
+      room: { name: "Designers" },
+      user_ids: rooms(:designers).user_ids + [ bot.id ]
+    }
+    assert_includes rooms(:designers).reload.users, bot
+
+    # Adding bot to direct room
+    post rooms_directs_url, params: { user_ids: [ bot.id ] }
+    direct_room = Room.last
+    assert direct_room.direct?
+    assert_includes direct_room.users, bot
+  end
+
+  test "bots cannot sign in as human users" do
+    sign_in :kevin
+    post bots_url, params: { bot: { name: "Deploy Bot" } }
+    bot = User.bot.find_by!(name: "Deploy Bot")
+    delete session_url
+
+    post session_url, params: { email_address: "", password: "" }
+    assert_response :unauthorized
+
+    put session_transfer_url(bot.transfer_id)
+    assert_response :bad_request
+  end
+end
diff --git a/test/controllers/messages/by_bots_controller_test.rb b/test/controllers/messages/by_bots_controller_test.rb
new file mode 100644
index 0000000..32cfc97
--- /dev/null
+++ b/test/controllers/messages/by_bots_controller_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class Messages::ByBotsControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    Current.user = users(:kevin)
+    @bot = User.create_bot!(name: "Deploy Bot")
+    Current.reset
+    @room = rooms(:hq)
+  end
+
+  test "posts raw body as message, responds 201 with Location header, and shows bot as author" do
+    assert_difference -> { @room.messages.count }, 1 do
+      post_bot_message @room.id, @bot.bot_key, "Deploy of v1.2.3 finished ✅"
+    end
+
+    assert_response :created
+    message = Message.last
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal @bot, message.creator
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+  end
+
+  test "preserves raw body with percent signs, plus signs, ampersands, and newlines" do
+    raw = "Build 100% passed + artifacts & logs ready\nCommit: abc123"
+
+    post_bot_message @room.id, @bot.bot_key, raw
+
+    assert_response :created
+    assert_equal raw, Message.last.plain_text_body
+  end
+
+  test "broadcasts message to connected clients with bot name as author and broadcasts unread room" do
+    assert_broadcasts UnreadRoomsChannel.stream_name_for(users(:david).id), 1 do
+      post_bot_message @room.id, @bot.bot_key, "Deploy of v1.2.3 finished ✅", content_type: "text/plain"
+    end
+
+    assert_response :created
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author strong", text: "Deploy Bot"
+      assert_select ".message__body", text: /Deploy of v1.2.3 finished ✅/
+    end
+  end
+
+  test "triggers web push notifications exactly as a human-authored message would" do
+    expected_deliveries = Push::Subscription.count
+    assert expected_deliveries > 0
+
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      WebPush.expects(:payload_send).times(expected_deliveries).with do |kwargs|
+        payload = JSON.parse(kwargs[:message])
+        payload["title"] == @room.name &&
+          payload.dig("options", "body") == "Deploy Bot: Deploy of v1.2.3 finished ✅"
+      end
+
+      post_bot_message @room.id, @bot.bot_key, "Deploy of v1.2.3 finished ✅"
+    end
+
+    wait_for_web_push_delivery_pool_tasks(expected_deliveries)
+  end
+
+  test "returns 422 Unprocessable Content for empty or whitespace-only body without attachment" do
+    assert_no_difference -> { Message.count } do
+      post_bot_message @room.id, @bot.bot_key, ""
+      assert_response :unprocessable_content
+
+      post_bot_message @room.id, @bot.bot_key, "   \n\t  ", content_type: "text/plain"
+      assert_response :unprocessable_content
+    end
+  end
+
+  test "returns 404 Not Found for nonexistent room id or closed room bot is not a member of" do
+    assert_no_difference -> { Message.count } do
+      post_bot_message 99999999, @bot.bot_key, "Hello"
+      assert_response :not_found
+
+      post_bot_message "bad-room", @bot.bot_key, "Hello"
+      assert_response :not_found
+
+      # Closed room that @bot has not joined
+      assert_not_includes @bot.rooms, rooms(:designers)
+      post_bot_message rooms(:designers).id, @bot.bot_key, "Hello"
+      assert_response :not_found
+    end
+
+    # Once added to the closed room, bot can post
+    rooms(:designers).memberships.grant_to(@bot)
+    post_bot_message rooms(:designers).id, @bot.bot_key, "Hello Designers"
+    assert_response :created
+  end
+
+  test "returns 401 Unauthorized for invalid bot code" do
+    assert_no_difference -> { Message.count } do
+      post_bot_message @room.id, "invalid-bot-code", "Hello"
+      assert_response :unauthorized
+
+      post_bot_message @room.id, "#{@bot.id}-wrongtoken", "Hello"
+      assert_response :unauthorized
+
+      post_bot_message @room.id, "bad.code.with.dots", "Hello"
+      assert_response :unauthorized
+
+      # Invalid bot code with bad room id still returns 401 Unauthorized without leaking room existence
+      post_bot_message 99999999, "invalid-bot-code", "Hello"
+      assert_response :unauthorized
+    end
+  end
+
+  test "deleted bot can no longer post messages while keeping previous messages" do
+    post_bot_message @room.id, @bot.bot_key, "Before deletion"
+    assert_response :created
+    previous_message = Message.last
+
+    old_key = @bot.bot_key
+    @bot.deactivate
+
+    assert_no_difference -> { Message.count } do
+      post_bot_message @room.id, old_key, "After deletion"
+      assert_response :unauthorized
+    end
+
+    assert previous_message.reload.persisted?
+    assert_equal "Deploy Bot", previous_message.creator.name
+  end
+
+  private
+    def post_bot_message(room_id, bot_key, body, content_type: "application/x-www-form-urlencoded")
+      post "/rooms/#{room_id}/#{bot_key}/messages",
+        params: +body,
+        headers: { "CONTENT_TYPE" => content_type }
+    end
+
+    def wait_for_web_push_delivery_pool_tasks(count)
+      pool = Rails.configuration.x.web_push_pool.delivery_pool
+      start = Time.now
+      while pool.completed_task_count < count
+        raise "Timeout waiting for web push pool tasks" if Time.now - start > 1.0
+        sleep 0.02
+      end
+    end
+end
diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
