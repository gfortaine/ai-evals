+  test "delivers joined event payload when added to a closed or open room and posts synchronous 200 text or HTML replies" do
+    closed_room = rooms(:designers)
+    received_payloads = []
+    received_content_types = []
+
+    stub_request(:post, "https://bot.example.com/campfire/webhook?secret=xyz")
+      .with { |req|
+        received_content_types << req.headers["Content-Type"]
+        received_payloads << JSON.parse(req.body)
+        true
+      }
+      .to_return(
+        { status: 200, headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "Hello Designers!\nHappy to help" },
+        { status: 200, headers: { "Content-Type" => "text/html" }, body: "<p>Woof <strong>All Pets</strong>!</p>" }
+      )
+
+    assert_difference -> { closed_room.messages.count }, 1 do
+      assert_broadcasts UnreadRoomsChannel.stream_name_for(@author.id), 1 do
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          closed_room.memberships.grant_to(@bot)
+        end
+      end
+    end
+
+    assert_equal [ "application/json" ], received_content_types
+    assert_equal(
+      [
+        {
+          "event" => "joined",
+          "room" => {
+            "id" => closed_room.id,
+            "name" => closed_room.name,
+            "reply_to" => "/rooms/#{closed_room.id}/#{@bot.bot_key}/messages"
+          }
+        }
+      ],
+      received_payloads
+    )
+
+    greeting = closed_room.messages.order(:id).last
+    assert_equal @bot, greeting.creator
+    assert_equal "Hello Designers!\nHappy to help", greeting.plain_text_body
+
+    # Adding to an open room with 200 text/html reply
+    open_room = rooms(:pets)
+    assert_difference -> { open_room.messages.count }, 1 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        open_room.memberships.grant_to(@bot)
+      end
+    end
+
+    assert_equal 2, received_payloads.size
+    assert_equal(
+      {
+        "event" => "joined",
+        "room" => {
+          "id" => open_room.id,
+          "name" => open_room.name,
+          "reply_to" => "/rooms/#{open_room.id}/#{@bot.bot_key}/messages"
+        }
+      },
+      received_payloads.last
+    )
+    html_greeting = open_room.messages.order(:id).last
+    assert_equal @bot, html_greeting.creator
+    assert_includes html_greeting.body.body.to_html, "<strong>All Pets</strong>"
