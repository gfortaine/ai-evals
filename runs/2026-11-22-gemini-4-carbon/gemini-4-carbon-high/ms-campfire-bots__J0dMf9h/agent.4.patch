+test "members are capped at account bots_per_member while deleted bots do not count and admins are unlimited" do
+  accounts(:signal).update!(settings: { bots_per_member: 2 })
+
+  bot1 = User.create_bot!(name: "Kevin Bot 1")
+  bot2 = User.create_bot!(name: "Kevin Bot 2")
+  assert users(:kevin).reached_bot_limit?
+
+  extra_bot = User.new_bot(name: "Kevin Bot 3")
+  assert_not extra_bot.valid?
+
+  # Existing bots can still be updated and deactivated when at or above the limit
+  accounts(:signal).update!(settings: { bots_per_member: 1 })
+  bot2.update!(name: "Kevin Bot 2 Renamed")
+  bot1.deactivate
+  assert users(:kevin).reached_bot_limit?
+
+  bot2.deactivate
+  assert_not users(:kevin).reached_bot_limit?
+  assert User.create_bot!(name: "Kevin Replacement Bot").persisted?
+
+  # Administrators are never limited, even at 0
+  accounts(:signal).update!(settings: { bots_per_member: 0 })
+  Current.user = users(:david)
+  assert_not users(:david).reached_bot_limit?
+  assert User.create_bot!(name: "Admin Bot 1").persisted?
+  assert User.create_bot!(name: "Admin Bot 2").persisted?
+end
 end
