@@ -0,0 +1,34 @@
+class Account::DataTransfer::IdMap
+  attr_reader :account
+  attr_accessor :old_external_account_id
+
+  def initialize(account)
+    @account = account
+    @map = {}
+    @last_uuid_int = 0
+  end
+
+  def [](old_id)
+    return nil if old_id.blank?
+
+    @map[old_id.to_s] ||= generate_monotonic_uuid
+  end
+
+  def []=(old_id, new_id)
+    @map[old_id.to_s] = new_id
+  end
+
+  private
+    def generate_monotonic_uuid
+      hex = SecureRandom.uuid_v7(extra_timestamp_bits: 12).delete("-")
+      candidate_int = hex.to_i(16)
+
+      if candidate_int <= @last_uuid_int
+        candidate_int = @last_uuid_int + 1
+        hex = candidate_int.to_s(16).rjust(32, "0")
+      end
+
+      @last_uuid_int = candidate_int
+      ActiveRecord::Type::Uuid.hex_to_base36(hex)
+    end
+end
