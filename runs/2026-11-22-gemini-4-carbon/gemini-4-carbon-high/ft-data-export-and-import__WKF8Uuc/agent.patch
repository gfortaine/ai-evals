diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..c627aee
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @admin = users(:kevin)
+    @owner = users(:jason)
+    @member = users(:david)
+  end
+
+  test "admin sees export button on account settings and downloads full account zip via email link" do
+    sign_in_as @admin
+    enqueued_jobs.clear
+
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action='#{account_exports_path}']"
+
+    ActionMailer::Base.deliveries.clear
+
+    assert_difference -> { Account::Export.count }, +1 do
+      perform_enqueued_jobs do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+
+    export = Account::Export.last
+    assert export.completed?
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ @admin.identity.email_address ], mail.to
+
+    download_path = account_export_path(export)
+    assert_includes mail.body.encoded, download_path
+
+    get download_path
+    assert_response :redirect
+    follow_redirect!
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+
+    # Link stops working after a day
+    blob_path = rails_blob_path(export.file, disposition: "attachment")
+    travel(1.day + 1.minute) do
+      get download_path
+      assert_response :gone
+
+      get blob_path
+      assert_response :forbidden
+    end
+  end
+
+  test "owner can also export the account" do
+    sign_in_as @owner
+
+    assert_difference -> { Account::Export.count }, +1 do
+      post account_exports_path
+    end
+    assert_redirected_to account_settings_path
+  end
+
+  test "non-admin member cannot see export button or export the whole account" do
+    sign_in_as @member
+
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action='#{account_exports_path}']", count: 0
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_path
+    end
+    assert_response :forbidden
+
+    admin_export = @account.exports.create!(user: @admin)
+    admin_export.build_now
+
+    get account_export_path(admin_export)
+    assert_response :forbidden
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..3b6d77b
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @source_account = accounts("37s")
+    @kevin = users(:kevin)
+  end
+
+  test "unauthenticated user visiting /account/imports/new is redirected to sign in" do
+    untenanted do
+      get "/account/imports/new"
+      assert_response :redirect
+    end
+  end
+
+  test "signed-in user brings an account file back in at /account/imports/new and gets a new account and completion email" do
+    Current.with(account: @source_account, session: sessions(:kevin)) do
+      cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    end
+
+    export = Current.with_account(@source_account) do
+      exp = @source_account.exports.create!(user: @kevin)
+      exp.build_now
+      exp
+    end
+
+    zip_tempfile = Tempfile.new([ "account_export", ".zip" ])
+    zip_tempfile.binmode
+    zip_tempfile.write(export.file.download)
+    zip_tempfile.rewind
+
+    # Sign in as an identity with zero existing accounts to verify fresh-instance / new-user flow too
+    fresh_identity = Identity.create!(email_address: "migrator@corp.example.com")
+    sign_in_as fresh_identity
+    enqueued_jobs.clear
+
+    untenanted do
+      get "/account/imports/new"
+      assert_response :success
+      assert_select "form[action='/account/imports']"
+    end
+
+    ActionMailer::Base.deliveries.clear
+    uploaded = Rack::Test::UploadedFile.new(zip_tempfile.path, "application/zip", true)
+
+    untenanted do
+      assert_difference -> { Account::Import.count }, +1 do
+        assert_no_difference -> { Account.count } do
+          post "/account/imports", params: { account_import: { file: uploaded } }
+        end
+      end
+
+      import = Account::Import.last
+      assert_redirected_to "/account/imports/#{import.id}"
+
+      get "/account/imports/#{import.id}"
+      assert_response :success
+
+      assert_difference -> { Account.count }, +1 do
+        perform_enqueued_jobs { perform_enqueued_jobs }
+      end
+
+      import.reload
+      assert import.completed?
+      assert_not_nil import.account
+
+      assert_equal 1, ActionMailer::Base.deliveries.size
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ fresh_identity.email_address ], mail.to
+      assert_includes mail.body.encoded, import.account.slug
+
+      get "/account/imports/#{import.id}"
+      assert_response :success
+      assert_select "a[href='#{landing_path(script_name: import.account.slug)}']"
+
+      # Visit the newly imported account and verify boards and cards are live
+      get "#{import.account.slug}/boards"
+    end
+  ensure
+    zip_tempfile&.close!
+  end
+
+  test "submitting /account/imports without a file renders validation error" do
+    sign_in_as :kevin
+    enqueued_jobs.clear
+
+    untenanted do
+      assert_no_difference -> { Account::Import.count } do
+        post "/account/imports", params: { account_import: {} }
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "uploading invalid account file sends failure email with reason and leaves nothing behind" do
+    # Build a user profile cards export zip (not a full account export) and try importing it at /account/imports/new
+    user_export = Current.with(account: @source_account, session: sessions(:david)) do
+      exp = users(:david).exports.create!(account: @source_account)
+      exp.build_now
+      exp
+    end
+
+    bad_zip = Tempfile.new([ "user_cards", ".zip" ])
+    bad_zip.binmode
+    bad_zip.write(user_export.file.download)
+    bad_zip.rewind
+
+    sign_in_as :kevin
+    enqueued_jobs.clear
+    ActionMailer::Base.deliveries.clear
+
+    accounts_before = Account.count
+    boards_before = Board.count
+    cards_before = Card.count
+    blobs_before = ActiveStorage::Blob.count
+
+    uploaded = Rack::Test::UploadedFile.new(bad_zip.path, "application/zip", true)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post "/account/imports", params: { account_import: { file: uploaded } }
+      end
+    end
+
+    import = Account::Import.last
+    assert import.failed?
+    assert_nil import.account_id
+    assert_includes import.failure_reason, "account data"
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:kevin).email_address ], mail.to
+    assert_includes mail.body.encoded, import.failure_reason
+
+    assert_equal accounts_before, Account.count
+    assert_equal boards_before, Board.count
+    assert_equal cards_before, Card.count
+    assert_equal blobs_before, ActiveStorage::Blob.count
+  ensure
+    bad_zip&.close!
+  end
+end
diff --git a/test/controllers/users/exports_controller_test.rb b/test/controllers/users/exports_controller_test.rb
new file mode 100644
index 0000000..dbcc035
--- /dev/null
+++ b/test/controllers/users/exports_controller_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Users::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @member = users(:david)
+    @other_user = users(:kevin)
+  end
+
+  test "any user can export accessible cards from their own profile page and download via email link for a day" do
+    sign_in_as @member
+    enqueued_jobs.clear
+
+    get user_path(@member)
+    assert_response :success
+    assert_select "form[action='#{user_exports_path(@member)}']"
+
+    # Viewing someone else's profile does not show export button
+    get user_path(@other_user)
+    assert_response :success
+    assert_select "form[action='#{user_exports_path(@other_user)}']", count: 0
+
+    ActionMailer::Base.deliveries.clear
+
+    assert_difference -> { User::Export.count }, +1 do
+      perform_enqueued_jobs do
+        post user_exports_path(@member)
+      end
+    end
+
+    assert_redirected_to user_path(@member)
+
+    export = User::Export.last
+    assert export.completed?
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ @member.identity.email_address ], mail.to
+
+    download_path = user_export_path(@member, export)
+    assert_includes mail.body.encoded, download_path
+
+    get download_path
+    assert_response :redirect
+    follow_redirect!
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+
+    zip_io = StringIO.new(response.body)
+    reader = ZipFile::Reader.new(zip_io)
+    assert reader.glob("*.json").any?
+
+    # Link expires after a day
+    travel(1.day + 1.minute) do
+      get download_path
+      assert_response :gone
+    end
+  end
+
+  test "user cannot create or download another user's export" do
+    sign_in_as @member
+    enqueued_jobs.clear
+
+    assert_no_difference -> { User::Export.count } do
+      post user_exports_path(@other_user)
+    end
+    assert_response :forbidden
+
+    other_export = @other_user.exports.create!(account: @account)
+    other_export.build_now
+
+    get user_export_path(@other_user, other_export)
+    assert_response :forbidden
+  end
+end
diff --git a/test/mailers/export_mailer_test.rb b/test/mailers/export_mailer_test.rb
