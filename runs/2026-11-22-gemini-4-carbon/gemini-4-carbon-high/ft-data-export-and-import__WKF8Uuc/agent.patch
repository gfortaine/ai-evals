+
+  test "exports full account and imports into a new account with boards, cards, comments, files, and people" do
+    # Enrich source account with avatars, card images, rich text embeds, mentions, steps, published board
+    @david.avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    boards(:writebook).publish
+
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    card.steps.create!(content: "Resize SVG", completed: true)
+    card.steps.create!(content: "Deploy to prod", completed: false)
+
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("Important attachment payload"),
+      filename: "notes.txt",
+      content_type: "text/plain"
+    )
+    embed_html = ActionText::Attachment.from_attachable(embed_blob).to_html
+    mention_html = ActionText::Attachment.from_attachable(@david).to_html
+
+    card.update!(description: "<p>Logo spec #{embed_html} cc #{mention_html}</p>")
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("Comment file bytes"),
+      filename: "mockup.txt",
+      content_type: "text/plain"
+    )
+    card.comments.create!(
+      creator: @kevin,
+      body: "<p>Attached mockup #{ActionText::Attachment.from_attachable(comment_blob).to_html}</p>"
+    )
+
+    export = @source_account.exports.create!(user: @kevin)
+    export.build_now
+
+    # Import as an existing member's identity AND verify a second import also works cleanly without collisions
+    zip_bytes = export.file.download
+
+    importer_identity = identities(:kevin)
+    import = Current.without_account do
+      rec = importer_identity.imports.new
+      rec.file.attach(io: StringIO.new(zip_bytes), filename: "account.zip", content_type: "application/zip")
+      rec.save!
+      rec
+    end
+
+    assert_difference -> { Account.count }, +1 do
+      assert_enqueued_emails 1 do
+        Current.without_account { import.process_now }
+      end
+    end
+
+    assert import.reload.completed?
+    new_account = import.account
+    assert_not_nil new_account
+    assert_not_equal @source_account.id, new_account.id
+    assert_not_equal @source_account.external_account_id, new_account.external_account_id
+    assert_equal @source_account.name, new_account.name
+
+    # Verify people
+    assert_equal @source_account.users.count, new_account.users.count
+    imported_david = new_account.users.find_by!(identity: identities(:david))
+    imported_kevin = new_account.users.find_by!(identity: identities(:kevin))
+    assert_equal "David", imported_david.name
+    assert imported_david.avatar.attached?
+    assert_equal file_fixture("avatar.png").binread, imported_david.avatar.download
+
+    # Verify boards and columns
+    assert_equal @source_account.boards.pluck(:name).sort, new_account.boards.pluck(:name).sort
+    imported_writebook = new_account.boards.find_by!(name: "Writebook")
+    assert imported_writebook.published?
+    assert_not_equal boards(:writebook).publication.key, imported_writebook.publication.key
+    assert_equal boards(:writebook).columns.pluck(:name), imported_writebook.columns.order(:position).pluck(:name)
+
+    # Verify cards, numbers, steps, tags, assignments, closures, goldness
+    assert_equal @source_account.cards.count, new_account.cards.count
+    imported_card = new_account.cards.find_by!(number: card.number)
+    assert_equal card.title, imported_card.title
+    assert imported_card.golden?
+    assert_equal card.steps.order(:id).pluck(:content), imported_card.steps.order(:id).pluck(:content)
+    assert_equal card.tags.pluck(:title).sort, imported_card.tags.pluck(:title).sort
+    assert_equal card.assignees.count, imported_card.assignees.count
+
+    # Verify card image and embedded files & mentions in rich text
+    assert imported_card.image.attached?
+    assert_equal file_fixture("moon.jpg").binread, imported_card.image.download
+
+    Current.with_account(new_account) do
+      desc_attachables = imported_card.description.body.attachables
+      imported_embed_blob = desc_attachables.find { |a| a.is_a?(ActiveStorage::Blob) }
+      assert_not_nil imported_embed_blob
+      assert_not_equal embed_blob.id, imported_embed_blob.id
+      assert_equal "Important attachment payload", imported_embed_blob.download
+      assert_includes desc_attachables, imported_david
+
+      # Verify comments and comment attachments
+      assert_equal card.comments.count, imported_card.comments.count
+      mockup_comment = imported_card.comments.detect { |c| c.body.to_plain_text.include?("Attached mockup") }
+      assert_not_nil mockup_comment
+      imported_comment_blob = mockup_comment.body.body.attachables.find { |a| a.is_a?(ActiveStorage::Blob) }
+      assert_not_nil imported_comment_blob
+      assert_equal "Comment file bytes", imported_comment_blob.download
+
+      # Verify search index works in the new account
+      results = Search::Record.for(new_account.id).search("mockup", user: imported_kevin)
+      assert results.any? { |r| r.card_id == imported_card.id }
+
+      # Verify storage reconciliation
+      assert new_account.bytes_used > 0
+    end
+
+    # Import by a brand-new identity not originally in the exported account
+    outsider = Identity.create!(email_address: "ceo@newcorp.example.com")
+    second_import = Current.without_account do
+      rec = outsider.imports.new
+      rec.file.attach(io: StringIO.new(zip_bytes), filename: "account.zip", content_type: "application/zip")
+      rec.save!
+      rec
+    end
+
+    assert_difference -> { Account.count }, +1 do
+      Current.without_account { second_import.process_now }
+    end
+
+    assert second_import.reload.completed?
+    outsider_user = second_import.account.users.find_by!(identity: outsider)
+    assert outsider_user.owner?
+    assert_equal second_import.account.boards.count, outsider_user.boards.count
+  end
+
+  test "failed import due to corrupt zip sends failure email and leaves nothing behind" do
+    identity = identities(:kevin)
+    import = Current.without_account do
+      rec = identity.imports.new
+      rec.file.attach(io: StringIO.new("corrupt zip bytes"), filename: "bad.zip", content_type: "application/zip")
+      rec.save!
+      rec
+    end
+
+    accounts_before = Account.count
+    boards_before = Board.count
+    cards_before = Card.count
+    users_before = User.count
+    identities_before = Identity.count
+    blobs_before = ActiveStorage::Blob.count - 1 # minus the attached bad.zip which must also be purged!
+    attachments_before = ActiveStorage::Attachment.count - 1
+
+    assert_enqueued_emails 1 do
+      Current.without_account { import.process_now }
+    end
+
+    import.reload
+    assert import.failed?
+    assert_nil import.account_id
+    assert import.failure_reason.present?
+    assert_not import.file.attached?
+
+    assert_equal accounts_before, Account.count
+    assert_equal boards_before, Board.count
+    assert_equal cards_before, Card.count
+    assert_equal users_before, User.count
+    assert_equal identities_before, Identity.count
+    assert_equal blobs_before, ActiveStorage::Blob.count
+    assert_equal attachments_before, ActiveStorage::Attachment.count
+    assert_not Identity.exists?(email_address: "rollback_me@corp.example.com")
+  end
+
+  test "failed import mid-way through file extraction rolls back all DB records and deletes uploaded files" do
+    # Add a user whose identity will be deleted before import so import has to create a new Identity that must roll back!
+    temp_identity = Identity.create!(email_address: "rollback_me@corp.example.com")
+    @source_account.users.create!(name: "Rollback Person", identity: temp_identity, role: :member, verified_at: Time.current)
+    # Attach two files so the first uploads and the second fails mid-import
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    cards(:layout).image.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+
+    export = @source_account.exports.create!(user: @kevin)
+    export.build_now
+    zip_bytes = export.file.download
+    temp_identity.destroy!
+
+    identity = identities(:kevin)
+    import = Current.without_account do
+      rec = identity.imports.new
+      rec.file.attach(io: StringIO.new(zip_bytes), filename: "account.zip", content_type: "application/zip")
+      rec.save!
+      rec
+    end
+
+    accounts_before = Account.count
+    cards_before = Card.count
+    users_before = User.count
+    blobs_before = ActiveStorage::Blob.count - 1
+    attachments_before = ActiveStorage::Attachment.count - 1
+
+    call_count = 0
+    original_upload = ActiveStorage::Blob.service.method(:upload)
+    ActiveStorage::Blob.service.stubs(:upload).with do |key, io, **kwargs|
+      call_count += 1
+      if call_count == 1
+        original_upload.call(key, io, **kwargs)
+        true
+      else
+        raise ActiveStorage::IntegrityError, "Simulated checksum mismatch on second file"
+      end
+    end
+
+    assert_enqueued_emails 1 do
+      Current.without_account { import.process_now }
+    end
+
+    import.reload
+    assert import.failed?
+    assert_includes import.failure_reason, "checksum"
+    assert_nil import.account_id
+    assert_not import.file.attached?
+
+    assert_equal accounts_before, Account.count
+    assert_equal cards_before, Card.count
+    assert_equal users_before, User.count
+    assert_equal blobs_before, ActiveStorage::Blob.count
+    assert_equal attachments_before, ActiveStorage::Attachment.count
+  end
+end
