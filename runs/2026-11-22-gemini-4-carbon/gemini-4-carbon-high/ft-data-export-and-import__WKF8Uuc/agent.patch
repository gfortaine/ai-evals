+
+    ActiveStorage::Blob.services.stubs(:fetch).returns(fake_s3)
+    ActiveStorage::Blob.any_instance.stubs(:service).returns(fake_s3)
+
+    ZipFile.create_for(export.file, filename: "s3-export.zip") do |zip|
+      zip.add_file("hello.txt", "Streamed straight to S3!")
+      zip.add_file("binary.bin", "ABCD" * 2048, compress: false)
+    end
+
+    assert export.file.attached?
+    assert export.file.blob.byte_size > 0
+    assert_equal Base64.strict_encode64(Digest::MD5.digest(storage_buckets[export.file.blob.key])), export.file.blob.checksum
+
+    ZipFile.read_from(export.file) do |reader|
+      assert_equal "Streamed straight to S3!", reader.read("hello.txt")
+      assert_equal "ABCD" * 2048, reader.read("binary.bin")
+    end
   end
 end
