--- a/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb
+++ b/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb
@@ -1,4 +1,95 @@
 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @source_account = accounts("37s")
+    Current.account = @source_account
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @author = users(:david)
+    @mentioned_user = users(:kevin)
+  end
+
+  test "exports portable GIDs and rewrites sgid and url on import into new account" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    embed_html = ActionText::Attachment.from_attachable(blob).to_html
+    mention_html = ActionText::Attachment.from_attachable(@mentioned_user).to_html
+    card_link_html = %(<a href="#{@source_account.slug}/cards/1">Card 1</a>)
+
+    card = @board.cards.create!(
+      title: "Rich card",
+      creator: @author,
+      status: "published",
+      description: "<p>Check #{embed_html} and ping #{mention_html} at #{card_link_html}</p>"
+    )
+
+    tempfile = Tempfile.new([ "richtext", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(@source_account).export(to: writer)
+    writer.close
+
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+
+    exported_files = reader.glob("data/action_text_rich_texts/*.json")
+    assert exported_files.any?
+
+    exported_rows = exported_files.flat_map { |f| JSON.parse(reader.read(f)) }
+    exported_rt = exported_rows.find { |r| r["record_id"] == card.id }
+    assert_not_nil exported_rt
+    assert_includes exported_rt["body"], "gid://fizzy/ActiveStorage::Blob/#{blob.id}"
+    assert_includes exported_rt["body"], "gid://fizzy/User/#{@mentioned_user.id}"
+    assert_not_includes exported_rt["body"], @source_account.slug + "/rails/active_storage"
+
+    # Import into a brand new account with remapped IDs
+    target_account = Account.create!(name: "Imported Target")
+    Current.with_account(target_account) do
+      new_author = target_account.users.create!(name: "David", role: :owner)
+      Current.user = new_author
+      new_mentioned = target_account.users.create!(name: "Kevin", role: :member)
+      new_board = target_account.boards.create!(name: "Writebook", creator: new_author)
+      new_card = new_board.cards.create!(title: "Rich card", creator: new_author, status: "published")
+      new_blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+
+      id_map = Account::DataTransfer::IdMap.new(target_account)
+      id_map[@source_account.id] = target_account.id
+      id_map.old_external_account_id = @source_account.external_account_id
+      id_map[@mentioned_user.id] = new_mentioned.id
+      id_map[card.id] = new_card.id
+      id_map[blob.id] = new_blob.id
+
+      # Keep only our test card's rich text in a clean zip to import onto new_card
+      single_zip = Tempfile.new([ "single_rt", ".zip" ])
+      single_zip.binmode
+      w2 = ZipFile::Writer.new(single_zip)
+      w2.add_file("data/action_text_rich_texts/000000.json", JSON.generate([ exported_rt ]))
+      w2.close
+      single_zip.rewind
+      r2 = ZipFile::Reader.new(single_zip)
+
+      ActionText::RichText.where(record: new_card).delete_all
+      Account::DataTransfer::ActionText::RichTextRecordSet.new(target_account).import(from: r2, id_map: id_map)
+
+      imported_rt = ActionText::RichText.find_by!(record: new_card, name: "description")
+      attachables = imported_rt.body.attachables
+      assert_includes attachables, new_blob
+      assert_includes attachables, new_mentioned
+      assert_includes imported_rt.body.to_html, "#{target_account.slug}/rails/active_storage/blobs/redirect/"
+      assert_includes imported_rt.body.to_html, %(href="#{target_account.slug}/cards/1")
+    ensure
+      single_zip&.close!
+    end
+  ensure
+    tempfile&.close!
+  end
 end
