diff --git a/app/models/account/data_transfer/filter_record_set.rb b/app/models/account/data_transfer/filter_record_set.rb
new file mode 100644
index 0000000..921abf9
--- /dev/null
+++ b/app/models/account/data_transfer/filter_record_set.rb
@@ -0,0 +1,107 @@
+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  JOIN_TABLES = {
+    "tag_ids" => [ "filters_tags", "tag_id" ],
+    "board_ids" => [ "boards_filters", "board_id" ],
+    "assignee_ids" => [ "assignees_filters", "assignee_id" ],
+    "creator_ids" => [ "creators_filters", "creator_id" ],
+    "closer_ids" => [ "closers_filters", "closer_id" ]
+  }.freeze
+
+  def initialize(account)
+    super(account: account, model: Filter)
+  end
+
+  private
+    def records
+      Filter.where(account: account).includes(:tags, :assignees, :creators, :closers)
+    end
+
+    def serialize_record(filter)
+      board_ids = ActiveRecord::Base.connection.select_values(
+        ActiveRecord::Base.sanitize_sql([ "SELECT board_id FROM boards_filters WHERE filter_id = ?", ActiveRecord::Type::Uuid.new.serialize(filter.id) ])
+      ).map { |raw| ActiveRecord::Type::Uuid.new.deserialize(raw) }
+
+      super(filter).merge(
+        "tag_ids" => filter.tags.map(&:id),
+        "board_ids" => board_ids,
+        "assignee_ids" => filter.assignees.map(&:id),
+        "creator_ids" => filter.creators.map(&:id),
+        "closer_ids" => filter.closers.map(&:id)
+      )
+    end
+
+    def import_records(id_map:, **)
+      seen_creator_digests = Set.new
+
+      each_imported_batch do |rows|
+        filter_rows = []
+        join_rows_by_table = Hash.new { |h, k| h[k] = [] }
+
+        rows.each do |row|
+          attrs = transform_attributes(row.except(*JOIN_TABLES.keys), id_map)
+          fields = (attrs["fields"].is_a?(Hash) ? attrs["fields"].deep_dup : {})
+
+          if fields["card_ids"].is_a?(Array)
+            fields["card_ids"] = fields["card_ids"].map { |cid| map_id(cid, id_map) }
+          end
+
+          if fields["column_ids"].is_a?(Array)
+            fields["column_ids"] = fields["column_ids"].map { |col_id| map_id(col_id, id_map) }
+          end
+
+          attrs["fields"] = fields
+
+          remapped_assocs = JOIN_TABLES.keys.index_with do |assoc_key|
+            Array(row[assoc_key]).filter_map { |assoc_id| map_id(assoc_id, id_map) }
+          end
+
+          digest_input = {
+            indexed_by: fields["indexed_by"] || "all",
+            sorted_by: fields["sorted_by"] || "latest",
+            creation: fields["creation"],
+            closure: fields["closure"],
+            assignment_status: fields["assignment_status"],
+            terms: fields["terms"],
+            card_ids: fields["card_ids"],
+            tag_ids: remapped_assocs["tag_ids"],
+            board_ids: remapped_assocs["board_ids"],
+            assignee_ids: remapped_assocs["assignee_ids"],
+            creator_ids: remapped_assocs["creator_ids"],
+            closer_ids: remapped_assocs["closer_ids"]
+          }.compact_blank.reject { |k, v| Filter.default_value?(k, v) }
+
+          attrs["params_digest"] = Filter.digest_params(digest_input)
+          next unless seen_creator_digests.add?([ attrs["creator_id"], attrs["params_digest"] ])
+
+          filter_rows << attrs
+
+          JOIN_TABLES.each do |assoc_key, (table_name, fk_column)|
+            remapped_assocs[assoc_key].uniq.each do |fk_id|
+              join_rows_by_table[table_name] << {
+                "filter_id" => attrs["id"],
+                fk_column => fk_id
+              }
+            end
+          end
+        end
+
+        Filter.insert_all!(filter_rows) if filter_rows.any?
+        insert_join_rows(join_rows_by_table)
+      end
+    end
+
+    def insert_join_rows(join_rows_by_table)
+      uuid_type = ActiveRecord::Type::Uuid.new
+      join_rows_by_table.each do |table_name, rows|
+        next if rows.empty?
+
+        rows.each do |row|
+          cols = row.keys.map { |c| ActiveRecord::Base.connection.quote_column_name(c) }.join(", ")
+          placeholders = ([ "?" ] * row.size).join(", ")
+          values = row.values.map { |v| uuid_type.serialize(v) }
+          sql = ActiveRecord::Base.sanitize_sql([ "INSERT INTO #{table_name} (#{cols}) VALUES (#{placeholders})", *values ])
+          ActiveRecord::Base.connection.execute(sql)
+        end
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/id_map.rb b/app/models/account/data_transfer/id_map.rb
