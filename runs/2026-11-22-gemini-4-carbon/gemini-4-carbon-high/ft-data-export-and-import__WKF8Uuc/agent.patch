+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @source_account = accounts("37s")
+    Current.account = @source_account
+    Current.session = sessions(:kevin)
