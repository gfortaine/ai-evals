diff --git a/app/models/account/data_transfer/action_text/rich_text_record_set.rb b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
index 76411f2..f03b480 100644
--- a/app/models/account/data_transfer/action_text/rich_text_record_set.rb
+++ b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
@@ -8,4 +8,82 @@ class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransf
       ::ActionText::RichText.where(account: account)
     end
 
+    def serialize_record(rich_text)
+      attrs = super(rich_text)
+      if attrs["body"].present?
+        attrs["body"] = export_html(attrs["body"])
+      end
+      attrs
+    end
+
+    def transform_attributes(row, id_map)
+      attrs = super(row, id_map)
+      if attrs["body"].present?
+        attrs["body"] = import_html(attrs["body"], id_map)
+      end
+      attrs
+    end
+
+    def export_html(html)
+      ::ActionText::Fragment.wrap(html).replace("action-text-attachment") do |node|
+        if node["sgid"].present?
+          if sgid = SignedGlobalID.parse(node["sgid"], for: ::ActionText::Attachable::LOCATOR_NAME)
+            node["sgid"] = sgid.uri.to_s
+            node.remove_attribute("url") if sgid.model_name == "ActiveStorage::Blob"
+          end
+        end
+        node
+      end.to_html
+    end
+
+    def import_html(html, id_map)
+      fragment = ::ActionText::Fragment.wrap(html).replace("action-text-attachment") do |node|
+        if node["sgid"].present?
+          gid = parse_portable_or_signed_gid(node["sgid"])
+          if gid
+            rewrite_attachment_node(node, gid, id_map)
+          end
+        end
+        node
+      end
+
+      result_html = fragment.to_html
+      rewrite_account_links(result_html, id_map)
+    end
+
+    def parse_portable_or_signed_gid(raw_sgid)
+      GlobalID.parse(raw_sgid) || SignedGlobalID.parse(raw_sgid, for: ::ActionText::Attachable::LOCATOR_NAME)
+    end
+
+    def rewrite_attachment_node(node, gid, id_map)
+      target_id = map_id(gid.model_id, id_map)
+
+      case gid.model_name
+      when "User"
+        if user = ::User.find_by(id: target_id)
+          node["sgid"] = user.attachable_sgid
+        end
+      when "ActiveStorage::Blob"
+        if blob = ::ActiveStorage::Blob.find_by(id: target_id)
+          node["sgid"] = blob.attachable_sgid
+          node["url"] = Rails.application.routes.url_helpers.polymorphic_url(
+            blob,
+            only_path: true,
+            script_name: account.slug
+          )
+        end
+      end
+    end
+
+    def rewrite_account_links(html, id_map)
+      old_slug_id = id_map&.old_external_account_id
+      return html if old_slug_id.blank?
+
+      doc = Nokogiri::HTML::DocumentFragment.parse(html)
+      doc.css("a[href]").each do |anchor|
+        href = anchor["href"].to_s
+        anchor["href"] = href.sub(%r{(^|https?://[^/]+)/#{Regexp.escape(old_slug_id.to_s)}(?=/|$)}, "\\1#{account.slug}")
+      end
+      doc.to_html
+    end
 end
