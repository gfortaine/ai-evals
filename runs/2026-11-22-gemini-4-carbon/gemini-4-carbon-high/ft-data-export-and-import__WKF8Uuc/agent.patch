+class Export < ApplicationRecord
+  EXPIRATION_TIME = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  scope :completed, -> { where(status: :completed) }
+  scope :expired, -> { where(completed_at: ...EXPIRATION_TIME.ago).or(where(completed_at: nil, created_at: ...EXPIRATION_TIME.ago)) }
+
+  class << self
+    def cleanup
+      expired.find_each(&:destroy)
+    end
+  end
+
+  def build_later
+    Export::BuildJob.perform_later(self)
+  end
+
+  def build_now
+    processing!
+    populate_zip
+    update!(status: :completed, completed_at: Time.current)
+    ExportMailer.completed(self).deliver_later if user.identity.present?
+  rescue => error
+    failed!
+    raise error
+  end
+
+  def expired?
+    (completed_at || created_at) < EXPIRATION_TIME.ago
+  end
+
+  def accessible_to?(accessor)
+    completed? && !expired? && authorized_for?(accessor)
+  end
+
+  private
+    def populate_zip
+      raise NotImplementedError
+    end
+
+    def authorized_for?(accessor)
+      raise NotImplementedError
+    end
+end
