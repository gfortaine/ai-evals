@@ -0,0 +1,48 @@
+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthorized_access
+  around_action :without_account_scope
+
+  layout "public"
+
+  def show
+    @import = Current.identity.imports.find(params[:id])
+  end
+
+  def new
+    @import = Current.identity.imports.new
+  end
+
+  def create
+    @import = Current.identity.imports.new
+    @import.file.attach(uploaded_file) if uploaded_file.present?
+
+    if @import.save
+      @import.process_later
+
+      respond_to do |format|
+        format.html { redirect_to account_import_path(@import, script_name: nil), notice: "Import started. You'll receive an email when it's done." }
+        format.json { render json: { id: @import.id, status: @import.status }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: { errors: @import.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  private
+    def without_account_scope(&block)
+      Current.without_account(&block)
+    end
+
+    def uploaded_file
+      params.dig(:account_import, :file) || params.dig(:import, :file) || params[:file]
+    end
+
+    def request_authentication
+      session[:return_to_after_authenticating] = request.url
+      redirect_to_login_url
+    end
+end
