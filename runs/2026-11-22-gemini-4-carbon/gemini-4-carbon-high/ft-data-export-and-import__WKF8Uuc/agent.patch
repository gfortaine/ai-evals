--- /dev/null
+++ b/test/mailers/export_mailer_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class ExportMailerTest < ActionMailer::TestCase
+  test "completed account export email includes download link and expiration notice" do
+    export = accounts("37s").exports.create!(user: users(:kevin), status: :completed, completed_at: Time.current)
+    mail = ExportMailer.completed(export)
+
+    assert_emails 1 do
+      mail.deliver_now
+    end
+
+    assert_equal [ identities(:kevin).email_address ], mail.to
+    assert_equal "Your Fizzy export is ready", mail.subject
+    assert_includes mail.body.encoded, "#{accounts('37s').slug}/account/exports/#{export.id}"
+    assert_includes mail.body.encoded, "1 day"
+  end
+
+  test "completed user export email includes user export download link" do
+    user = users(:david)
+    export = user.exports.create!(account: accounts("37s"), status: :completed, completed_at: Time.current)
+    mail = ExportMailer.completed(export)
+
+    assert_equal [ identities(:david).email_address ], mail.to
+    assert_includes mail.body.encoded, "#{accounts('37s').slug}/users/#{user.id}/exports/#{export.id}"
+  end
+end
diff --git a/test/mailers/import_mailer_test.rb b/test/mailers/import_mailer_test.rb
new file mode 100644
index 0000000..edbe6fa
--- /dev/null
+++ b/test/mailers/import_mailer_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class ImportMailerTest < ActionMailer::TestCase
+  test "completed import email links to the imported account" do
+    import = Account::Import.new(
+      id: ActiveRecord::Type::Uuid.generate,
+      identity: identities(:kevin),
+      account: accounts("37s"),
+      status: :completed
+    )
+    mail = ImportMailer.completed(import)
+
+    assert_equal [ identities(:kevin).email_address ], mail.to
+    assert_includes mail.body.encoded, accounts("37s").name
+    assert_includes mail.body.encoded, "#{accounts('37s').slug}/landing"
+  end
+
+  test "failed import email includes the failure reason and retry link" do
+    import = Account::Import.new(
+      id: ActiveRecord::Type::Uuid.generate,
+      identity: identities(:kevin),
+      status: :failed,
+      failure_reason: "The archive does not contain valid Fizzy account data."
+    )
+    mail = ImportMailer.failed(import)
+
+    assert_equal [ identities(:kevin).email_address ], mail.to
+    assert_includes mail.body.encoded, "The archive does not contain valid Fizzy account data."
+    assert_includes mail.body.encoded, "/account/imports/new"
+  end
+end
diff --git a/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb b/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb
