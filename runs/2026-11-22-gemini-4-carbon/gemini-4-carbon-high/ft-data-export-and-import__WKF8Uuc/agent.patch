--- /dev/null
+++ b/app/models/zip_file/entry_io.rb
@@ -0,0 +1,77 @@
+class ZipFile::EntryIO
+  EXTRACT_CHUNK_SIZE = 64.kilobytes
+
+  def initialize(io, entry)
+    @io = io
+    @entry = entry
+    rewind
+  end
+
+  def size
+    @entry.uncompressed_size
+  end
+
+  def eof?
+    @buffer.empty? && @extractor.eof?
+  end
+
+  def rewind
+    @extractor = @entry.extractor_from(@io)
+    @buffer = "".b
+    0
+  rescue ZipKit::FileReader::UnsupportedFeature, ZipKit::FileReader::ReadError => error
+    raise ZipFile::InvalidFileError, "Unsupported or corrupted ZIP entry #{@entry.filename}: #{error.message}"
+  end
+
+  def read(length = nil, outbuf = nil)
+    if length.nil?
+      read_all(outbuf)
+    elsif length.zero?
+      replace_or_return(outbuf, "".b)
+    else
+      read_chunk(length, outbuf)
+    end
+  rescue Zlib::Error, EOFError, ZipKit::FileReader::ReadError => error
+    raise ZipFile::InvalidFileError, "Corrupted ZIP entry #{@entry.filename}: #{error.message}"
+  end
+
+  private
+    def read_all(outbuf)
+      chunks = [ @buffer ]
+      @buffer = "".b
+      until @extractor.eof?
+        chunk = @extractor.extract(EXTRACT_CHUNK_SIZE)
+        chunks << chunk.b if chunk
+      end
+      replace_or_return(outbuf, chunks.join.b)
+    end
+
+    def read_chunk(length, outbuf)
+      fill_buffer(length)
+
+      if @buffer.empty?
+        outbuf&.clear
+        nil
+      else
+        slice = @buffer.byteslice(0, length)
+        @buffer = @buffer.byteslice(length, @buffer.bytesize - slice.bytesize) || "".b
+        replace_or_return(outbuf, slice)
+      end
+    end
+
+    def fill_buffer(target_length)
+      while @buffer.bytesize < target_length && !@extractor.eof?
+        chunk = @extractor.extract([ target_length - @buffer.bytesize, EXTRACT_CHUNK_SIZE ].max)
+        break if chunk.nil? || chunk.empty?
+        @buffer << chunk.b
+      end
+    end
+
+    def replace_or_return(outbuf, data)
+      if outbuf
+        outbuf.replace(data)
+      else
+        data
+      end
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..22d6735
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,69 @@
+class ZipFile::Reader
+  def initialize(io)
+    @io = io
+    @file_reader = ZipKit::FileReader.new
+    @entries_by_path = index_entries
+  end
+
+  def entries
+    @entries_by_path.keys.sort
+  end
+
+  def glob(pattern)
+    entries.select { |entry| File.fnmatch(pattern, entry) }
+  end
+
+  def exists?(path)
+    @entries_by_path.key?(path)
+  end
+
+  def read(path)
+    open_file(path, &:read)
+  end
+
+  def open_file(path)
+    entry = @entries_by_path[path]
+    raise ZipFile::InvalidFileError, "Missing file in ZIP archive: #{path}" unless entry
+
+    ensure_offset_resolved(entry)
+    entry_io = ZipFile::EntryIO.new(@io, entry)
+
+    if block_given?
+      yield entry_io
+    else
+      entry_io
+    end
+  end
+
+  private
+    def index_entries
+      raise ZipFile::InvalidFileError, "ZIP archive is empty" if @io.size.to_i <= 0
+
+      raw_entries = @file_reader.read_zip_structure(io: @io, read_local_headers: false)
+      raw_entries.each_with_object({}) do |entry, indexed|
+        next if entry.filename.end_with?("/")
+        validate_entry_path(entry.filename)
+        indexed[entry.filename] = entry
+      end
+    rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD,
+           ZipKit::FileReader::UnsupportedFeature, EOFError, Zlib::Error, ArgumentError => error
+      raise ZipFile::InvalidFileError, "Invalid or corrupted ZIP archive: #{error.message}"
+    end
+
+    def validate_entry_path(filename)
+      if filename.start_with?("/") || filename.split("/").include?("..")
+        raise ZipFile::InvalidFileError, "Unsafe path in ZIP archive: #{filename}"
+      end
+    end
+
+    def ensure_offset_resolved(entry)
+      unless entry.known_offset?
+        entry.compressed_data_offset = @file_reader.get_compressed_data_offset(
+          io: @io,
+          local_file_header_offset: entry.local_file_header_offset
+        )
+      end
+    rescue ZipKit::FileReader::ReadError, EOFError => error
+      raise ZipFile::InvalidFileError, "Corrupted header in ZIP archive: #{error.message}"
+    end
+end
diff --git a/app/models/zip_file/remote_io.rb b/app/models/zip_file/remote_io.rb
new file mode 100644
index 0000000..6ab9155
--- /dev/null
+++ b/app/models/zip_file/remote_io.rb
@@ -0,0 +1,96 @@
+class ZipFile::RemoteIO
+  DEFAULT_BUFFER_SIZE = 1.megabyte
+
+  attr_reader :size, :pos
+  alias_method :tell, :pos
+
+  def initialize(blob, buffer_size: DEFAULT_BUFFER_SIZE)
+    @blob = blob
+    @size = blob.byte_size
+    @pos = 0
+    @buffer_size = buffer_size
+    @buffer = "".b
+    @buffer_offset = 0
+  end
+
+  def seek(offset, whence = IO::SEEK_SET)
+    new_pos = case whence
+    when IO::SEEK_SET then offset
+    when IO::SEEK_CUR then @pos + offset
+    when IO::SEEK_END then @size + offset
+    else raise ArgumentError, "Unknown whence: #{whence}"
+    end
+
+    raise Errno::EINVAL, "Invalid seek offset: #{new_pos}" if new_pos.negative?
+    @pos = new_pos
+    0
+  end
+
+  def rewind
+    @pos = 0
+  end
+
+  def eof?
+    @pos >= @size
+  end
+
+  def read(length = nil, outbuf = nil)
+    if length.nil?
+      read_remaining(outbuf)
+    elsif length.zero?
+      replace_or_return(outbuf, "".b)
+    elsif eof?
+      outbuf&.clear
+      nil
+    else
+      read_bytes(length, outbuf)
+    end
+  rescue ActiveStorage::FileNotFoundError
+    raise ZipFile::InvalidFileError, "Archive file not found in storage"
+  end
+
+  private
+    def read_remaining(outbuf)
+      return replace_or_return(outbuf, "".b) if eof?
+
+      read_bytes(@size - @pos, outbuf)
+    end
+
+    def read_bytes(length, outbuf)
+      remaining = [ length, @size - @pos ].min
+      result = "".b
+
+      while remaining > 0
+        ensure_buffered(@pos, remaining)
+        break if @buffer.empty?
+
+        relative_offset = @pos - @buffer_offset
+        available = @buffer.bytesize - relative_offset
+        take = [ remaining, available ].min
+        break if take <= 0
+
+        result << @buffer.byteslice(relative_offset, take)
+        @pos += take
+        remaining -= take
+      end
+
+      replace_or_return(outbuf, result)
+    end
+
+    def ensure_buffered(offset, requested_length)
+      unless offset >= @buffer_offset && offset < (@buffer_offset + @buffer.bytesize)
+        fetch_size = [ requested_length, @buffer_size ].max
+        range_end = [ offset + fetch_size, @size ].min
+        @buffer_offset = offset
+        @buffer = @blob.service.download_chunk(@blob.key, offset...range_end).b
+      end
+    end
+
+    def replace_or_return(outbuf, data)
+      if outbuf
+        outbuf.replace(data)
+      else
+        data
+      end
+    end
+end
