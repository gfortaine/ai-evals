+
+    <%= link_to landing_path(script_name: @import.account.slug), class: "btn btn--link center" do %>
+      <span>Open <%= @import.account.name %></span>
+      <%= icon_tag "arrow-right" %>
+    <% end %>
+  <% elsif @import.failed? %>
+    <h1 class="txt-x-large font-weight-black margin-none txt-negative">Import failed</h1>
+    <p class="margin-none">We couldn’t complete your import, and nothing was left behind.</p>
+    <% if @import.failure_reason.present? %>
+      <p class="margin-none txt-small"><strong>Reason:</strong> <%= @import.failure_reason %></p>
+    <% end %>
+
+    <%= link_to new_account_import_path(script_name: nil), class: "btn btn--link center" do %>
+      <span>Try another file</span>
+      <%= icon_tag "arrow-right" %>
+    <% end %>
+  <% else %>
+    <h1 class="txt-x-large font-weight-black margin-none">Importing your account…</h1>
+    <p class="margin-none">We’re bringing in your boards, cards, comments, files, and people. We’ll send an email to <strong><%= @import.identity.email_address %></strong> as soon as it’s done.</p>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
