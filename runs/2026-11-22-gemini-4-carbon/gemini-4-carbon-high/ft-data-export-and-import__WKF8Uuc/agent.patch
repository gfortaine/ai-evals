+        end
+      end
+    end
+
+    def each_record_batch
+      source = records
+      if source.respond_to?(:in_batches)
+        source.order(:id).in_batches(of: BATCH_SIZE) do |relation|
+          yield relation.to_a
+        end
+      else
+        Array(source).each_slice(BATCH_SIZE) do |slice|
+          yield slice
+        end
+      end
+    end
+
+    def serialize_record(record)
+      raw = record.attributes.slice(*attributes)
+      raw.transform_values { |value| format_attribute_value(value) }
+    end
+
+    def format_attribute_value(value)
+      case value
+      when Time, ActiveSupport::TimeWithZone
+        value.utc.iso8601(6)
+      when Date
+        value.iso8601
+      else
+        value
+      end
+    end
+
+    def validate_records
+      each_imported_batch do |rows|
+        unless rows.is_a?(Array) && rows.all? { |row| row.is_a?(Hash) }
+          raise Account::DataTransfer::InvalidExportError, "Invalid record format in #{model_dir}"
+        end
+      end
+    end
+
+    def import_records(id_map:, **)
+      each_imported_batch do |rows|
+        transformed = rows.map { |row| transform_attributes(row, id_map) }
+        model.insert_all!(transformed) if transformed.any?
+      end
+    end
+
+    def each_imported_batch
+      zip.glob("data/#{model_dir}/*.json").each do |entry_path|
+        parsed = JSON.parse(zip.read(entry_path))
+        yield parsed
+      rescue JSON::ParserError => error
+        raise Account::DataTransfer::InvalidExportError, "Corrupted JSON in #{entry_path}: #{error.message}"
+      end
+    end
+
+    def transform_attributes(row, id_map)
+      transformed = row.slice(*model.column_names)
+      transformed["account_id"] = account.id if model.column_names.include?("account_id")
+
+      uuid_columns.each do |column_name|
+        next if column_name == "account_id"
+        if transformed.key?(column_name)
+          transformed[column_name] = map_id(transformed[column_name], id_map)
+        end
+      end
+
+      if model == ::Board::Publication && transformed["key"].present?
+        if ::Board::Publication.exists?(key: transformed["key"])
+          transformed["key"] = ::Board::Publication.generate_unique_secure_token
+        end
+      end
+
+      if model == ::Event && transformed["particulars"].is_a?(Hash)
+        if transformed["particulars"]["assignee_ids"].is_a?(Array)
+          remapped_ids = transformed["particulars"]["assignee_ids"].map { |uid| map_id(uid, id_map) }
+          transformed["particulars"] = transformed["particulars"].merge("assignee_ids" => remapped_ids)
+        end
+      end
+
+      transformed
+    end
+
+    def uuid_columns
+      @uuid_columns ||= model.columns.select { |col| col.type == :uuid }.map(&:name)
+    end
+
+    def map_id(value, id_map)
+      return nil if value.blank?
+
+      if id_map
+        id_map[value]
+      else
+        value
+      end
+    end
+
+    def batch_path(index)
+      "data/#{model_dir}/#{format('%06d', index)}.json"
+    end
 end
