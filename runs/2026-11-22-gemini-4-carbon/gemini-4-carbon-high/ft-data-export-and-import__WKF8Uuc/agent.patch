+++ b/test/models/export_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    Current.account = @account
+    Current.session = sessions(:david)
+  end
+
+  test "user export includes accessible published cards as JSON with comments and all attached pictures and files" do
+    david = users(:david)
+    kevin = users(:kevin)
+
+    visible_card = cards(:logo)
+    visible_card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    desc_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("PDF spec content"),
+      filename: "spec.pdf",
+      content_type: "application/pdf"
+    )
+    visible_card.update!(description: "<p>See spec: #{ActionText::Attachment.from_attachable(desc_blob).to_html}</p>")
+
+    comment_blob_1 = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "screenshot.png",
+      content_type: "image/png"
+    )
+    comment_blob_2 = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "screenshot.png",
+      content_type: "image/jpeg"
+    )
+    visible_card.comments.create!(
+      creator: david,
+      body: "<p>First attachment #{ActionText::Attachment.from_attachable(comment_blob_1).to_html}</p>"
+    )
+    visible_card.comments.create!(
+      creator: kevin,
+      body: "<p>Second attachment #{ActionText::Attachment.from_attachable(comment_blob_2).to_html}</p>"
+    )
+
+    Current.with(user: kevin) do
+      boards(:private).cards.create!(title: "Top secret private card", creator: kevin, status: "published")
+    end
+
+    boards(:writebook).cards.create!(title: "Unpublished draft", creator: kevin, status: "drafted")
+
+    export = david.exports.create!(account: @account)
+    assert_enqueued_emails 1 do
+      export.build_now
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+    assert_not export.expired?
+
+    ZipFile.read_from(export.file) do |zip|
+      json_files = zip.glob("*.json")
+      expected_numbers = david.accessible_cards.published.pluck(:number).sort
+      assert_equal expected_numbers.map { |n| "#{n}.json" }.sort, json_files
+
+      logo_data = JSON.parse(zip.read("#{visible_card.number}.json"))
+      assert_equal visible_card.id, logo_data["id"]
+      assert_equal visible_card.number, logo_data["number"]
+      assert_equal "The logo isn't big enough", logo_data["title"]
+      assert_includes logo_data["description"], "See spec:"
+      assert_equal "#{visible_card.number}/moon.jpg", logo_data["image"]
+
+      comment_bodies = logo_data["comments"].map { |c| c["body"] }
+      assert comment_bodies.any? { |b| b.include?("First attachment") }
+      assert comment_bodies.any? { |b| b.include?("Second attachment") }
+
+      assert zip.exists?("#{visible_card.number}/moon.jpg")
+      assert_equal file_fixture("moon.jpg").binread, zip.read("#{visible_card.number}/moon.jpg")
+
+      assert zip.exists?("#{visible_card.number}/spec.pdf")
+      assert_equal "PDF spec content", zip.read("#{visible_card.number}/spec.pdf")
+
+      assert zip.exists?("#{visible_card.number}/screenshot.png")
+      assert_equal file_fixture("avatar.png").binread, zip.read("#{visible_card.number}/screenshot.png")
+
+      assert zip.exists?("#{visible_card.number}/screenshot (1).png")
+      assert_equal file_fixture("moon.jpg").binread, zip.read("#{visible_card.number}/screenshot (1).png")
+
+      all_titles = json_files.map { |f| JSON.parse(zip.read(f))["title"] }
+      assert_not_includes all_titles, "Top secret private card"
+      assert_not_includes all_titles, "Unpublished draft"
+      assert_not_includes all_titles, "I want to play my radio at a reasonable volume"
+    end
+  end
+
+  test "account export excludes previous export zip blobs from exported archive" do
+    kevin = users(:kevin)
+    first_export = @account.exports.create!(user: kevin)
+    first_export.build_now
+
+    second_export = @account.exports.create!(user: kevin)
+    second_export.build_now
+
+    ZipFile.read_from(second_export.file) do |zip|
+      assert_not zip.exists?("storage/#{first_export.file.blob.id}")
+      blob_batches = zip.glob("data/active_storage_blobs/*.json").flat_map { |p| JSON.parse(zip.read(p)) }
+      exported_blob_ids = blob_batches.map { |b| b["id"] }
+      assert_not_includes exported_blob_ids, first_export.file.blob.id
+    end
+  end
+
+  test "export expires after one day and cleanup destroys expired exports" do
+    kevin = users(:kevin)
+    export = @account.exports.create!(user: kevin)
+    export.build_now
+
+    assert export.accessible_to?(kevin)
+    assert_not export.accessible_to?(users(:david))
+
+    travel 23.hours do
+      assert_not export.expired?
+      assert export.accessible_to?(kevin)
+    end
+
+    travel(1.day + 1.second) do
+      assert export.expired?
+      assert_not export.accessible_to?(kevin)
+
+      assert_difference -> { Export.count }, -1 do
+        Export.cleanup
+      end
+    end
+  end
+
+test "user export succeeds cleanly with an empty zip when user has zero accessible cards" do
+  isolated_identity = Identity.create!(email_address: "isolated@example.com")
+  isolated_user = @account.users.create!(name: "Isolated", identity: isolated_identity, role: :member, verified_at: Time.current)
+  isolated_user.accesses.delete_all
+
+  export = isolated_user.exports.create!(account: @account)
+  export.build_now
+
+  assert export.completed?
+  ZipFile.read_from(export.file) do |zip|
+    assert_empty zip.entries
+  end
+end
+end
