+    writer.add_file("storage/file1", payload, compress: true)
+    writer.close
+
+    tempfile.rewind
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: tempfile,
+      filename: "remote.zip",
+      content_type: "application/zip"
+    )
+
+    remote_io = ZipFile::RemoteIO.new(blob, buffer_size: 4096)
+    reader = ZipFile::Reader.new(remote_io)
