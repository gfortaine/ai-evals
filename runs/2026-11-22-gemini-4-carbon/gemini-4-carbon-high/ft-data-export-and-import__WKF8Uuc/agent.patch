+
+  test "ZipFile.create_for and ZipFile.read_from support S3 streaming write and chunked read" do
+    require "active_storage/service/s3_service"
+
+    storage_buckets = {}
+    fake_s3 = ActiveStorage::Service::S3Service.allocate
+    fake_s3.define_singleton_method(:name) { :s3 }
+    fake_s3.define_singleton_method(:upload_stream) do |key:, **, &block|
+      buf = StringIO.new("".b)
+      block.call(buf)
+      storage_buckets[key] = buf.string
+    end
+    fake_s3.define_singleton_method(:download_chunk) do |key, range|
+      data = storage_buckets.fetch(key) { raise ActiveStorage::FileNotFoundError }
