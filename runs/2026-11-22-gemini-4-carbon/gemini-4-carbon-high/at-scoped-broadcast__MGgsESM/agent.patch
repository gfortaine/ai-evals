diff --git a/test/controllers/pages_controller_test.rb b/test/controllers/pages_controller_test.rb
index 0b0ccec..22ec67e 100644
--- a/test/controllers/pages_controller_test.rb
+++ b/test/controllers/pages_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class PagesControllerTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -79,8 +81,106 @@ class PagesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "With even more interesting words.", updated_page.body.content
   end
 
+  test "update broadcasts being edited indicator to current editors and not removed collaborators" do
+    leaf = leaves(:welcome_page)
+    book = books(:handbook)
+
+    kevin_channel = editor_stream_for(leaf, user: :kevin)
+    jason_channel = editor_stream_for(leaf, user: :jason)
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { page: { body: "Edited by David" } }
+    end
+    assert_response :no_content
+
+    assert_equal 1, broadcasts(kevin_channel).size
+    assert_includes broadcasts(kevin_channel).last, "David"
+    assert_equal 1, broadcasts(jason_channel).size
+    assert_includes broadcasts(jason_channel).last, "David"
+
+    put book_path(book), params: {
+      book: { title: book.title, everyone_access: false },
+      editor_ids: [ users(:jason).id ]
+    }
+
+    clear_messages(kevin_channel)
+    clear_messages(jason_channel)
+
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { page: { body: "Edited after removing Kevin" } }
+    end
+    assert_response :no_content
+
+    assert_empty broadcasts(kevin_channel)
+    assert_no_broadcasts Turbo::StreamsChannel.send(:stream_name_from, [ leaf, :being_edited ])
+    assert_equal 1, broadcasts(jason_channel).size
+    assert_includes broadcasts(jason_channel).last, "David"
+  end
+
+  test "update does not broadcast being edited indicator to collaborator downgraded to reader" do
+    leaf = leaves(:welcome_page)
+    book = books(:handbook)
+
+    kevin_channel = editor_stream_for(leaf, user: :kevin)
+    jason_channel = editor_stream_for(leaf, user: :jason)
+
+    sign_in :david
+    put book_path(book), params: {
+      book: { title: book.title, everyone_access: true },
+      editor_ids: [ users(:jason).id ]
+    }
+    assert book.reload.accessable?(user: users(:kevin))
+    assert_not book.editable?(user: users(:kevin))
+
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { page: { body: "Edited after downgrading Kevin" } }
+    end
+    assert_response :no_content
+
+    assert_empty broadcasts(kevin_channel)
+    assert_equal 1, broadcasts(jason_channel).size
+    assert_includes broadcasts(jason_channel).last, "David"
+
+    sign_in :kevin
+    clear_messages(jason_channel)
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { page: { body: "Stale editor save attempt" } }
+    end
+    assert_response :forbidden
+    assert_empty broadcasts(jason_channel)
+  end
+
+  test "update does not broadcast being edited indicator to deactivated collaborator" do
+    leaf = leaves(:welcome_page)
+
+    kevin_channel = editor_stream_for(leaf, user: :kevin)
+    jason_channel = editor_stream_for(leaf, user: :jason)
+
+    users(:kevin).deactivate
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { page: { body: "Edited after deactivating Kevin" } }
+    end
+    assert_response :no_content
+
+    assert_empty broadcasts(kevin_channel)
+    assert_equal 1, broadcasts(jason_channel).size
+    assert_includes broadcasts(jason_channel).last, "David"
+  end
+
   private
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
     end
+
+    def editor_stream_for(leaf, user:)
+      sign_in user
+      get edit_leafable_path(leaf)
+      assert_response :ok
+
+      signed_stream_name = css_select("turbo-cable-stream-source").first["signed-stream-name"]
+      Turbo::StreamsChannel.verified_stream_name(signed_stream_name)
+    end
 end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..4db871f 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,26 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors includes active editors and accessible administrators while excluding readers and removed users" do
+    book = books(:handbook)
+
+    assert_equal [ users(:david), users(:jason), users(:kevin) ].sort_by(&:id), book.editors.sort_by(&:id)
+    assert_not_includes book.editors, users(:jz)
+
+    book.update_access(editors: [ users(:david).id ], readers: [])
+    assert_includes book.editors, users(:david)
+    assert_includes book.editors, users(:jason)
+    assert_not_includes book.editors, users(:kevin)
+
+    book.update!(everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [])
+    assert_equal [ users(:kevin) ], book.editors.to_a
+
+    book.update!(published: true)
+    assert_equal [ users(:david), users(:jason), users(:kevin) ].sort_by(&:id), book.editors.sort_by(&:id)
+
+    users(:kevin).deactivate
+    assert_not_includes book.editors, users(:kevin)
+  end
 end
