+require "test_helper"
+
+class TimerTest < ActiveSupport::TestCase
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    @quiz = Quiz.create!(title: "Timed Talk Quiz")
+
+    @q1 = @quiz.questions.new
+    @q1.save_with_option_rows(
+      { body: "First timed question?", active: true },
+      { "0" => { text: "Right 1", correct: "1" }, "1" => { text: "Wrong 1", correct: "0" } }
+    )
+
+    @q2 = @quiz.questions.new
+    @q2.save_with_option_rows(
+      { body: "Second timed question?", active: true },
+      { "0" => { text: "Right 2", correct: "1" }, "1" => { text: "Wrong 2", correct: "0" } }
+    )
+  end
+
+  test "timer_minutes and timer_seconds default to 0, validate integers, and are excluded from export" do
+    assert_equal 0, @quiz.timer_minutes
+    assert_equal 0, @quiz.timer_seconds
+    assert_equal 0, @quiz.timer_duration_seconds
+    refute @quiz.timer_enabled?
+
+    [ 0, 1, 5, 60, "12" ].each do |valid_min|
+      @quiz.timer_minutes = valid_min
+      @quiz.timer_seconds = 0
+      assert @quiz.valid?, "Expected timer_minutes=#{valid_min.inspect} to be valid"
+    end
+
+    [ 0, 5, 30, 59, "45" ].each do |valid_sec|
+      @quiz.timer_minutes = 0
+      @quiz.timer_seconds = valid_sec
+      assert @quiz.valid?, "Expected timer_seconds=#{valid_sec.inspect} to be valid"
+    end
+
+    [ nil, "", "   ", -1, "-5", 1.5, "2.5", "abc" ].each do |invalid_min|
+      @quiz.timer_minutes = invalid_min
+      @quiz.timer_seconds = 0
+      refute @quiz.valid?, "Expected timer_minutes=#{invalid_min.inspect} to be invalid"
+      assert @quiz.errors[:timer_minutes].any?
+    end
+
+    [ nil, "", "   ", -1, "-5", 60, "60", 90, 1.5, "2.5", "abc" ].each do |invalid_sec|
+      @quiz.timer_minutes = 0
+      @quiz.timer_seconds = invalid_sec
+      refute @quiz.valid?, "Expected timer_seconds=#{invalid_sec.inspect} to be invalid"
+      assert @quiz.errors[:timer_seconds].any?
+    end
+
+    @quiz.reload
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    assert_equal 90, @quiz.timer_duration_seconds
+    assert @quiz.timer_enabled?
+
+    payload = @quiz.export_payload
+    assert_equal [ "questions", "title" ], payload.keys.sort
+    exported_json = @quiz.to_export_json
+    refute_includes exported_json, "timer"
+    refute_includes exported_json, "minutes"
+    refute_includes exported_json, "seconds"
+
+    imported = Quiz::Import.new(exported_json)
+    assert imported.save
+    assert_equal 0, imported.quiz.timer_minutes
+    assert_equal 0, imported.quiz.timer_seconds
+    refute imported.quiz.timer_enabled?
+  end
+
+  test "Game.format_timer_ms formats M:SS accurately with ceiling semantics" do
+    assert_equal "1:30", Game.format_timer_ms(90_000)
+    assert_equal "1:30", Game.format_timer_ms(89_500)
+    assert_equal "1:30", Game.format_timer_ms(89_001)
+    assert_equal "1:29", Game.format_timer_ms(89_000)
+    assert_equal "0:05", Game.format_timer_ms(5_000)
+    assert_equal "0:05", Game.format_timer_ms(4_001)
+    assert_equal "0:04", Game.format_timer_ms(4_000)
+    assert_equal "0:01", Game.format_timer_ms(1_000)
+    assert_equal "0:01", Game.format_timer_ms(1)
+    assert_equal "0:00", Game.format_timer_ms(0)
+    assert_equal "0:00", Game.format_timer_ms(-250)
+    assert_equal "10:05", Game.format_timer_ms(605_000)
+  end
+
+  test "0 minutes and 0 seconds means no timer and never auto-finishes" do
+    game = @quiz.games.create!(base_url: "http://localhost:3000")
+    assert_equal 0, game.time_limit_seconds
+    refute game.timer_enabled?
+
+    base_time = Time.zone.parse("2026-06-01 12:00:00")
+    travel_to(base_time) { game.start! }
+
+    mod = game.moderator_payload
+    refute mod[:question].key?(:timer_remaining_ms)
+    refute mod[:question].key?(:timer_display)
+
+    travel_to(base_time + 1.hour) do
+      refute game.expire_timer_if_due!
+      assert game.reload.question_open?
+    end
+  end
+
+  test "timed game snapshots timer, hides timer from players, expires at 0:00, and rejects late answers" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    game = @quiz.games.create!(base_url: "http://localhost:3000")
+    alice = game.players.create!(name: "Alice", browser_token: "b1")
+    bob = game.players.create!(name: "Bob", browser_token: "b2")
+
+    base_time = Time.zone.parse("2026-06-01 12:00:00")
+    travel_to(base_time) { game.start! }
+    assert_equal 90, game.reload.time_limit_seconds
+    assert game.timer_enabled?
+
+    # Mutating quiz timer after game started does not affect running game
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    assert_equal 90, game.reload.time_limit_seconds
+
+    travel_to(base_time + 0.2.seconds, with_usec: true) do
+      mod = game.moderator_payload
+      assert_equal "1:30", mod[:question][:timer_display]
+      assert_equal 89_800, mod[:question][:timer_remaining_ms]
+
+      # Players never receive timer information
+      refute_includes game.play_broadcast_payload.to_json, "timer"
+      refute_includes game.play_broadcast_payload.to_json, "1:30"
+      refute_includes game.player_state_payload(alice).to_json, "timer"
+      refute_includes game.player_state_payload(alice).to_json, "1:30"
+    end
+
+    # Mid-question check (simulating page reload 85s after open -> 0:05 remaining)
+    travel_to(base_time + 85.0.seconds) do
+      refute game.expire_timer_if_due!
+      mod = game.moderator_payload
+      assert_equal "0:05", mod[:question][:timer_display]
+      assert_equal 5_000, mod[:question][:timer_remaining_ms]
+
+      right_opt = game.current_game_question.game_options.find_by!(correct: true)
+      res = game.submit_answer!(player: alice, option_id: right_opt.id, client_seq: 1)
+      assert res[:accepted]
+    end
+
+    # Late answer at T+90.0s closes question and is not accepted
+    travel_to(base_time + 90.0.seconds) do
+      right_opt = game.current_game_question.game_options.find_by!(correct: true)
+      res = game.submit_answer!(player: bob, option_id: right_opt.id, client_seq: 1)
+      refute res[:accepted]
+      assert game.reload.question_closed?
+      assert_equal 1, game.current_game_question.game_answers.count
+
+      mod = game.moderator_payload
+      refute mod[:question].key?(:timer_remaining_ms)
+      refute mod[:question].key?(:timer_display)
+    end
+
+    # Next question starts a fresh 90s timer and early finish works with question_id guard
+    q2_open = base_time + 120.0.seconds
+    travel_to(q2_open) do
+      assert game.next_question!
+      assert game.question_open?
+      mod = game.moderator_payload
+      assert_equal "1:30", mod[:question][:timer_display]
+      assert_equal 90_000, mod[:question][:timer_remaining_ms]
+    end
+
+    gq1 = game.game_questions.find_by!(position: 1)
+    gq2 = game.game_questions.find_by!(position: 2)
+
+    travel_to(q2_open + 10.0.seconds) do
+      # Stale finish for question 1 does NOT close question 2
+      refute game.finish_question!(question_id: gq1.id)
+      assert game.reload.question_open?
+
+      # Early finish for question 2 closes it immediately
+      assert game.finish_question!(question_id: gq2.id)
+      assert game.reload.question_closed?
+    end
+  end
+
+  test "GameTimerScheduler proactively closes open question in real time when deadline arrives" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 1)
+    game = @quiz.games.create!(base_url: "http://localhost:3000")
+    game.start!
+    assert game.reload.question_open?
+
+    deadline = Time.current + 2.5
+    sleep 0.05 until game.reload.question_closed? || Time.current > deadline
+
+    assert game.reload.question_closed?, "Expected GameTimerScheduler to close the question automatically at 0:00"
+  end
+end
diff --git a/test/system/timer_test.rb b/test/system/timer_test.rb
