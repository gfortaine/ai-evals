+require "application_system_test_case"
+
+class TimerTest < ApplicationSystemTestCase
+  test "quiz timer settings default to 0, exclude timer from export, hide timer when 0:00, and support 1:30 reload & early Finish" do
+    visit_moderate "/moderate"
+    click_on "New quiz"
+
+    assert_field "Timer minutes", with: "0", type: "number"
+    assert_field "Timer seconds", with: "0", type: "number"
+
+    fill_in "Title", with: "No Timer Talk"
+    click_on "Save quiz"
+
+    quiz = Quiz.order(:id).last
+    assert_equal 0, quiz.timer_minutes
+    assert_equal 0, quiz.timer_seconds
+
+    q1 = quiz.questions.new
+    q1.save_with_option_rows(
+      { body: "Untimed question?", active: true },
+      { "0" => { text: "Yes", correct: "1" }, "1" => { text: "No", correct: "0" } }
+    )
+    q2 = quiz.questions.new
+    q2.save_with_option_rows(
+      { body: "Second question?", active: true },
+      { "0" => { text: "Alpha", correct: "1" }, "1" => { text: "Beta", correct: "0" } }
+    )
+
+    visit_moderate "/moderate/quizzes/#{quiz.id}"
+    click_on "Settings"
+    assert_field "Timer minutes", with: "0", type: "number"
+    assert_field "Timer seconds", with: "0", type: "number"
+
+    # Untimed game: no timer shown on big screen
+    click_on "Cancel"
+    click_on "Start a game"
+    click_on "Start"
+    assert_text "Question 1 of 2"
+    assert_text "Untimed question?"
+    assert_no_selector ".stage-timer"
+    assert_no_text "0:00"
+    click_on "Finish"
+    assert_button "Next"
+
+    # Configure 1 minute 30 seconds in Settings (after checking invalid input)
+    click_on "← Back to quiz"
+    click_on "Settings"
+
+    fill_in "Timer seconds", with: "60"
+    click_on "Save quiz"
+    assert_selector ".errors"
+
+    fill_in "Timer minutes", with: "1"
+    fill_in "Timer seconds", with: "30"
+    click_on "Save quiz"
+    assert_selector "h1", text: "No Timer Talk"
+    assert_equal 1, quiz.reload.timer_minutes
+    assert_equal 30, quiz.timer_seconds
+
+    # Export does not include timer settings
+    click_on "Export"
+    exported = JSON.parse(find("pre").text)
+    assert_equal [ "questions", "title" ], exported.keys.sort
+    refute_includes find("pre").text, "timer"
+
+    # Start a new game with 1:30 timer and a player in a separate browser session
+    visit_moderate "/moderate/quizzes/#{quiz.id}"
+    click_on "Start a game"
+    game = quiz.games.order(:id).last
+
+    Capybara.using_session(:alice) do
+      visit "/play/#{game.code}"
+      fill_in "Your name", with: "Alice"
+      click_on "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    assert_text "Players: 1"
+    click_on "Start"
+
+    # Moderator sees M:SS countdown starting at 1:30
+    assert_selector ".stage-timer", text: /\A1:(30|29)\z/
+
+    # Player does NOT see timer
+    Capybara.using_session(:alice) do
+      assert_text "Untimed question?"
+      assert_no_selector ".stage-timer"
+      assert_no_text "1:30"
+      assert_no_text "1:29"
+      assert_no_text "1:28"
+      click_on "Yes"
+      within("button", text: "Yes") { assert_text "Your answer" }
+    end
+
+    # Wait ~2.2 seconds so countdown ticks down, then reload moderator page -> does NOT restart to 1:30!
+    sleep 2.2
+    assert_selector ".stage-timer", text: /\A1:2[0-8]\z/
+
+    visit_moderate current_path
+    timer_text_after_reload = find(".stage-timer").text
+    assert_match(/\A1:2[0-8]\z/, timer_text_after_reload)
+    refute_equal "1:30", timer_text_after_reload
+
+    # Moderator can click "Finish" earlier
+    click_on "Finish"
+    assert_no_selector ".stage-timer"
+    within("li", text: "Yes") { assert_text "Correct" }
+    assert_button "Next"
+
+    Capybara.using_session(:alice) do
+      assert_text "Correct!"
+    end
+  end
+
+  test "countdown starts at 0:03 and automatically finishes question at 0:00 as if moderator clicked Finish" do
+    quiz = Quiz.create!(title: "Lightning Conf", timer_minutes: 0, timer_seconds: 3)
+
+    q1 = quiz.questions.new
+    q1.save_with_option_rows(
+      { body: "Fast question 1?", active: true },
+      { "0" => { text: "Fast Right 1", correct: "1" }, "1" => { text: "Fast Wrong 1", correct: "0" } }
+    )
+    q2 = quiz.questions.new
+    q2.save_with_option_rows(
+      { body: "Fast question 2?", active: true },
+      { "0" => { text: "Fast Right 2", correct: "1" }, "1" => { text: "Fast Wrong 2", correct: "0" } }
+    )
+
+    visit_moderate "/moderate/quizzes/#{quiz.id}"
+    click_on "Start a game"
+    game = quiz.games.order(:id).last
+
+    Capybara.using_session(:alice) do
+      visit "/play/#{game.code}"
+      fill_in "Your name", with: "Alice"
+      click_on "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    Capybara.using_session(:bob) do
+      visit "/play/#{game.code}"
+      fill_in "Your name", with: "Bob"
+      click_on "Join"
+      assert_text "Hi, Bob!"
+    end
+
+    assert_text "Players: 2"
+    click_on "Start"
+
+    # Moderator sees M:SS countdown (0:03)
+    assert_selector ".stage-timer", text: /\A0:0[23]\z/
+
+    # Alice answers while open; neither player sees timer
+    Capybara.using_session(:alice) do
+      assert_text "Fast question 1?"
+      assert_no_text "0:03"
+      assert_no_text "0:02"
+      click_on "Fast Right 1"
+      within("button", text: "Fast Right 1") { assert_text "Your answer" }
+    end
+
+    # Without moderator clicking Finish, at 0:00 the question finishes by itself!
+    assert_button "Next", wait: 6
+    assert_no_selector ".stage-timer"
+    within("li", text: "Fast Right 1") do
+      assert_text "Correct"
+      assert_text "1"
+    end
+
+    # Both players automatically receive the closed state
+    Capybara.using_session(:alice) do
+      assert_text "Correct!"
+    end
+    Capybara.using_session(:bob) do
+      assert_text "No answer"
+    end
+
+    # Advance to Question 2: fresh 0:03 countdown starts and auto-finishes to "End quiz"
+    click_on "Next"
+    assert_text "Question 2 of 2"
+    assert_selector ".stage-timer", text: /\A0:0[23]\z/
+
+    assert_button "End quiz", wait: 6
+    assert_no_selector ".stage-timer"
+    within("li", text: "Fast Right 2") { assert_text "Correct" }
+
+    click_on "End quiz"
+    assert_text "Leaderboard"
+    assert_text "Alice"
+  end
+
+  test "question finishes at 0:00 on server even if moderator navigated away from big screen" do
+    quiz = Quiz.create!(title: "Server Timer Quiz", timer_minutes: 0, timer_seconds: 2)
+    q1 = quiz.questions.new
+    q1.save_with_option_rows(
+      { body: "Server auto-finish question?", active: true },
+      { "0" => { text: "Server Right", correct: "1" }, "1" => { text: "Server Wrong", correct: "0" } }
+    )
+
+    visit_moderate "/moderate/quizzes/#{quiz.id}"
+    click_on "Start a game"
+    game = quiz.games.order(:id).last
+    game_path = current_path
+
+    Capybara.using_session(:alice) do
+      visit "/play/#{game.code}"
+      fill_in "Your name", with: "Alice"
+      click_on "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    click_on "Start"
+    assert_selector ".stage-timer", text: /\A0:0[12]\z/
+
+    Capybara.using_session(:alice) do
+      click_on "Server Right"
+      within("button", text: "Server Right") { assert_text "Your answer" }
+    end
+
+    # Moderator leaves the big screen before 0:00
+    visit_moderate "/moderate"
+    assert_selector "h1", text: "Quizzes"
+
+    # Server scheduler still finishes the question at 0:00 and pushes results to Alice
+    Capybara.using_session(:alice) do
+      assert_text "Correct!", wait: 5
+    end
+
+    visit_moderate game_path
+    assert_button "End quiz"
+    assert_no_selector ".stage-timer"
+  end
+end
