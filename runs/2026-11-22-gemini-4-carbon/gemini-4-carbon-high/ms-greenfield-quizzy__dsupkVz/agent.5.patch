+require "test_helper"
+
+class TimerHttpTest < ActionDispatch::IntegrationTest
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    @quiz = Quiz.create!(title: "HTTP Timer Quiz")
+    q = @quiz.questions.new
+    q.save_with_option_rows(
+      { body: "What port is HTTPS?", active: true },
+      { "0" => { text: "443", correct: "1" }, "1" => { text: "80", correct: "0" } }
+    )
+  end
+
+  test "settings form persists timer_minutes and timer_seconds, renders countdown only to moderator, survives reload, and expires" do
+    # Update quiz settings via PATCH
+    patch "/moderate/quizzes/#{@quiz.id}",
+      params: { quiz: { title: "HTTP Timer Quiz", number_of_winners: 3, timer_minutes: 1, timer_seconds: 30 } },
+      headers: moderator_auth_headers
+    assert_redirected_to "/moderate/quizzes/#{@quiz.id}"
+    @quiz.reload
+    assert_equal 1, @quiz.timer_minutes
+    assert_equal 30, @quiz.timer_seconds
+
+    # Invalid seconds (60) rejected with 422
+    patch "/moderate/quizzes/#{@quiz.id}",
+      params: { quiz: { title: "HTTP Timer Quiz", number_of_winners: 3, timer_minutes: 1, timer_seconds: 60 } },
+      headers: moderator_auth_headers
+    assert_response :unprocessable_entity
+    assert_equal 30, @quiz.reload.timer_seconds
+
+    # Create game and have player join
+    post "/moderate/quizzes/#{@quiz.id}/games", headers: moderator_auth_headers
+    game = @quiz.games.order(:id).last
+
+    alice = open_session
+    alice.post "/play/#{game.code}/join", params: { name: "Alice" }
+
+    base_time = Time.zone.parse("2026-06-01 15:00:00")
+    travel_to(base_time) do
+      patch "/moderate/quizzes/#{@quiz.id}/games/#{game.id}/start", headers: moderator_auth_headers
+      follow_redirect!(headers: moderator_auth_headers)
+      assert_response :success
+      assert_includes response.body, "1:30"
+
+      # Player does NOT see timer in HTML or JSON state
+      alice.get "/play/#{game.code}"
+      alice.assert_response :success
+      refute_includes alice.response.body, "1:30"
+      refute_includes alice.response.body, "stage-timer"
+
+      alice.get "/play/#{game.code}/state"
+      alice.assert_response :success
+      refute_includes alice.response.body, "timer"
+      refute_includes alice.response.body, "1:30"
+    end
+
+    # Reloading moderator page 85 seconds later shows 0:05, not 1:30
+    travel_to(base_time + 85.seconds) do
+      get "/moderate/quizzes/#{@quiz.id}/games/#{game.id}", headers: moderator_auth_headers
+      assert_response :success
+      assert_includes response.body, "0:05"
+      refute_includes response.body, ">1:30<"
+    end
+
+    # At 90 seconds, question is automatically closed
+    travel_to(base_time + 90.seconds) do
+      get "/moderate/quizzes/#{@quiz.id}/games/#{game.id}", headers: moderator_auth_headers
+      assert_response :success
+      assert game.reload.question_closed?
+      assert_includes response.body, "End quiz"
+      refute_includes response.body, ">0:00<"
+    end
+  end
+end
