+require "test_helper"
+
+class PrizesHttpTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = Quiz.create!(title: "HTTP Prize Quiz", number_of_winners: 2)
+    q = @quiz.questions.new
+    q.save_with_option_rows(
+      { body: "Capital of France?", active: true },
+      { "0" => { text: "Paris", correct: "1" }, "1" => { text: "Lyon", correct: "0" } }
+    )
+    @game = @quiz.games.create!(base_url: "http://localhost:3000")
+  end
+
+  test "winner endpoints require moderator auth and render leaderboard and phone results via HTML" do
+    open_session do |alice_sess|
+      alice_sess.post "/play/#{@game.code}/join", params: { name: "Alice" }
+      @game.start!
+      paris = @game.current_game_question.game_options.find_by!(text: "Paris")
+      alice_sess.post "/play/#{@game.code}/answer",
+        params: { option_id: paris.id, client_seq: 1 },
+        headers: { "X-Quizzy-Async" => "1" }
+
+      @game.finish_question!
+      @game.end_quiz!
+
+      # Unauthenticated requests to winner endpoints are rejected with 401
+      patch "/moderate/quizzes/#{@quiz.id}/games/#{@game.id}/pick_top_winners"
+      assert_response :unauthorized
+      patch "/moderate/quizzes/#{@quiz.id}/games/#{@game.id}/draw_winners"
+      assert_response :unauthorized
+      patch "/moderate/quizzes/#{@quiz.id}/games/#{@game.id}/reset_winners"
+      assert_response :unauthorized
+
+      # Alice phone HTML shows Place 1 of 1 and 1 point, without You won!
+      alice_sess.get "/play/#{@game.code}"
+      alice_sess.assert_response :success
+      assert_includes alice_sess.response.body, "Place 1 of 1"
+      assert_includes alice_sess.response.body, "1 point"
+      refute_includes alice_sess.response.body, "You won!"
+
+      # Moderator picks Top 2 via standard HTML PATCH -> redirects and shows Winner
+      patch "/moderate/quizzes/#{@quiz.id}/games/#{@game.id}/pick_top_winners", headers: moderator_auth_headers
+      assert_redirected_to "/moderate/quizzes/#{@quiz.id}/games/#{@game.id}"
+      follow_redirect!(headers: moderator_auth_headers)
+      assert_response :success
+      assert_includes response.body, "Top 2"
+      assert_includes response.body, "Winner"
+
+      # Alice phone HTML now shows You won!
+      alice_sess.get "/play/#{@game.code}"
+      assert_includes alice_sess.response.body, "You won!"
+
+      # Moderator resets winners -> removes Winner and You won!
+      patch "/moderate/quizzes/#{@quiz.id}/games/#{@game.id}/reset_winners", headers: moderator_auth_headers
+      follow_redirect!(headers: moderator_auth_headers)
+      refute_includes response.body, ">Winner<"
+
+      alice_sess.get "/play/#{@game.code}"
+      refute_includes alice_sess.response.body, "You won!"
+    end
+  end
+end
