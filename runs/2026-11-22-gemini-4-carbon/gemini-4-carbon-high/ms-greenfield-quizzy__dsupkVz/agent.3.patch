diff --git a/app/views/plays/show.html.erb b/app/views/plays/show.html.erb
new file mode 100644
index 0000000..424480e
--- /dev/null
+++ b/app/views/plays/show.html.erb
@@ -0,0 +1,98 @@
+<% content_for :title, "Quizzy · #{@quiz.title}" %>
+<%
+  state = @initial_state
+  status = state[:status]
+  joined = state[:joined]
+  question = state[:question]
+  show_join = !joined && status != "finished"
+  show_waiting = joined && status == "lobby"
+  show_question = joined && %w[question_open question_closed].include?(status)
+  show_finished = status == "finished"
+%>
+
+<div class="play"
+     data-controller="play"
+     data-play-code-value="<%= @game.code %>"
+     data-play-initial-state-value="<%= state.to_json %>"
+     data-play-join-url-value="<%= join_play_path(@game.code) %>"
+     data-play-answer-url-value="<%= answer_play_path(@game.code) %>"
+     data-play-state-url-value="<%= state_play_path(@game.code) %>"
+     data-play-leave-url-value="<%= leave_play_path(@game.code) %>">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span data-play-target="headerName"><%= joined ? state[:player_name] : @quiz.title %></span>
+  </div>
+
+  <div class="play__body <%= 'play__body--top' if show_question %>" data-play-target="bodyContainer">
+    <% if show_join %>
+      <div data-play-target="joinView">
+        <h1 class="play-title"><%= @quiz.title %></h1>
+        <div class="errors" data-play-target="joinError" <%= "hidden" if @join_error.blank? %>><%= @join_error %></div>
+        <%= form_with url: join_play_path(@game.code), method: :post, class: "join-form", data: { action: "submit->play#join" } do %>
+          <label class="field-label" for="player_name">Your name</label>
+          <input id="player_name"
+                 name="name"
+                 type="text"
+                 class="input"
+                 placeholder="Your name"
+                 required
+                 autocomplete="nickname"
+                 data-play-target="nameInput">
+          <button type="submit" class="btn btn--pink" data-play-target="joinButton">Join</button>
+        <% end %>
+      </div>
+    <% end %>
+
+    <% unless show_finished %>
+      <div class="waiting" data-play-target="waitingView" <%= "hidden" unless show_waiting %>>
+        <div class="waiting__gem">?</div>
+        <h1 class="play-title" data-play-target="greeting"><%= joined ? "Hi, #{state[:player_name]}!" : "" %></h1>
+        <p class="play-lead">Waiting for the quiz to start…</p>
+      </div>
+
+      <div data-play-target="questionView" <%= "hidden" unless show_question %>>
+        <div class="play-question__num" data-play-target="questionProgress"><%= question ? "Question #{question[:position]} of #{question[:total]}" : "" %></div>
+        <div class="play-question__body" data-play-target="questionBody"><%= question ? question[:body] : "" %></div>
+
+        <div class="play-options <%= 'is-locked is-revealed' if status == 'question_closed' %>" data-play-target="questionOptions">
+          <% if show_question && question %>
+            <% picked_id = question[:picked_option_id] %>
+            <% question[:options].each_with_index do |opt, idx| %>
+              <% is_picked = picked_id.present? && picked_id == opt[:id] %>
+              <% is_correct = status == "question_closed" && opt[:correct] %>
+              <button type="button"
+                      class="play-option <%= 'is-picked' if is_picked %> <%= 'is-correct' if is_correct %>"
+                      title="<%= opt[:text] %>"
+                      data-option-id="<%= opt[:id] %>"
+                      data-action="click->play#pick"
+                      <%= "disabled" if status == "question_closed" %>>
+                <span class="play-option__letter"><%= option_letter(idx) %></span>
+                <span class="play-option__title"><%= opt[:text] %></span>
+                <% if is_picked %>
+                  <span class="play-option__mark">Your answer</span>
+                <% end %>
+              </button>
+            <% end %>
+          <% end %>
+        </div>
+
+        <% if show_question && status == "question_closed" && question %>
+          <% picked_opt = question[:options].find { |o| o[:id] == question[:picked_option_id] } %>
+          <% if picked_opt.nil? %>
+            <div class="play-status play-status--neutral" data-play-target="questionFeedback">No answer</div>
+          <% elsif picked_opt[:correct] %>
+            <div class="play-status play-status--right" data-play-target="questionFeedback">Correct!</div>
+          <% else %>
+            <div class="play-status play-status--wrong" data-play-target="questionFeedback">Wrong!</div>
+          <% end %>
+        <% else %>
+          <div class="play-status" data-play-target="questionFeedback" hidden></div>
+        <% end %>
+      </div>
+    <% end %>
+
+    <div class="waiting" data-play-target="finishedView" <%= "hidden" unless show_finished %>>
+      <h1 class="play-title">The quiz is over</h1>
+    </div>
+  </div>
+</div>
