diff --git a/test/models/game_test.rb b/test/models/game_test.rb
new file mode 100644
index 0000000..a33d8e4
--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Conference Quiz")
+
+    @q1 = @quiz.questions.new
+    @q1.save_with_option_rows(
+      { body: "Active Q1?", active: true },
+      { "0" => { text: "A1 Wrong", correct: "0" }, "1" => { text: "A2 Right", correct: "1" } }
+    )
+
+    @q2_inactive = @quiz.questions.new
+    @q2_inactive.save_with_option_rows(
+      { body: "Inactive Q2?", active: false },
+      { "0" => { text: "Skip 1", correct: "1" }, "1" => { text: "Skip 2", correct: "0" } }
+    )
+
+    @q3 = @quiz.questions.new
+    @q3.save_with_option_rows(
+      { body: "Active Q3?", active: true },
+      { "0" => { text: "C1 Right", correct: "1" }, "1" => { text: "C2 Also Right", correct: "1" }, "2" => { text: "C3 Wrong", correct: "0" } }
+    )
+  end
+
+  test "creates distinct games with unique codes and leaves quiz export untouched" do
+    g1 = @quiz.games.create!(base_url: "http://localhost:3000")
+    g2 = @quiz.games.create!(base_url: "http://localhost:3000")
+
+    assert_not_equal g1.code, g2.code
+    assert_match(/\A[2-9A-HJ-NP-Z]{5}\z/, g1.code)
+    assert g1.lobby?
+
+    alice = g1.players.create!(name: "  Alice  ", browser_token: "b1")
+    assert_equal "Alice", alice.name
+    assert_equal 0, g2.players.count
+
+    g1.start!
+    gq = g1.current_game_question
+    g1.submit_answer!(player: alice, option_id: gq.game_options.first.id, client_seq: 1)
+
+    exported = @quiz.export_payload
+    assert_equal [ "questions", "title" ], exported.keys.sort
+  end
+
+  test "skips inactive questions, enforces answer rules, handles out-of-order client_seq, and hides correct answers until closed" do
+    game = @quiz.games.create!(base_url: "http://conf.local:3000")
+    alice = game.players.create!(name: "Alice", browser_token: "b_alice", connections_count: 1)
+    bob = game.players.create!(name: "Bob", browser_token: "b_bob", connections_count: 1)
+
+    assert_equal 2, game.active_players_count
+
+    game.start!
+    assert game.question_open?
+    assert_equal 2, game.game_questions.count
+    assert_equal [ "Active Q1?", "Active Q3?" ], game.game_questions.map(&:body)
+
+    # Payloads MUST NOT contain :correct while question is open
+    mod_open = game.moderator_payload
+    play_open = game.play_broadcast_payload
+    player_open = game.player_state_payload(alice)
+
+    refute_includes mod_open.to_json, "correct"
+    refute_includes play_open.to_json, "correct"
+    refute_includes player_open.to_json, "correct"
+
+    gq1 = game.current_game_question
+    wrong_opt = gq1.game_options.first
+    right_opt = gq1.game_options.second
+
+    # Alice picks wrong_opt (seq 1), then changes to right_opt (seq 2)
+    assert game.submit_answer!(player: alice, option_id: wrong_opt.id, client_seq: 1)[:accepted]
+    assert game.submit_answer!(player: alice, option_id: right_opt.id, client_seq: 2)[:accepted]
+
+    # Delayed conference Wi-Fi packet for seq 1 arrives late -> ignored, right_opt still stands!
+    game.submit_answer!(player: alice, option_id: wrong_opt.id, client_seq: 1)
+    assert_equal 1, gq1.game_answers.count
+    assert_equal right_opt.id, gq1.game_answers.find_by!(player: alice).game_option_id
+
+    # Finish closes question -> late answers rejected, correct flags & counts revealed
+    game.finish_question!
+    assert game.question_closed?
+    refute game.submit_answer!(player: bob, option_id: right_opt.id, client_seq: 1)[:accepted]
+    refute game.submit_answer!(player: alice, option_id: wrong_opt.id, client_seq: 3)[:accepted]
+
+    mod_closed = game.moderator_payload
+    opts_closed = mod_closed[:question][:options]
+    assert_equal [ false, true ], opts_closed.map { |o| o[:correct] }
+    assert_equal [ 0, 1 ], opts_closed.map { |o| o[:answers_count] }
+    refute mod_closed[:question][:last_question]
+
+    # Advance to last active question (Q3)
+    assert game.next_question!
+    assert game.question_open?
+    assert_equal "Active Q3?", game.current_game_question.body
+    # Double-clicking Next while already open does NOT skip
+    refute game.next_question!
+
+    game.finish_question!
+    assert game.moderator_payload[:question][:last_question]
+
+    game.end_quiz!
+    assert game.finished?
+  end
+
+  test "starting a game with zero active questions finishes cleanly and deleting quiz destroys games" do
+    empty_quiz = Quiz.create!(title: "Empty Quiz")
+    game = empty_quiz.games.create!(base_url: "http://localhost:3000")
+    game.players.create!(name: "Solo", browser_token: "b_solo")
+
+    game.start!
+    assert game.finished?
+
+    assert_difference -> { Game.count }, -1 do
+      empty_quiz.destroy!
+    end
+  end
+end
