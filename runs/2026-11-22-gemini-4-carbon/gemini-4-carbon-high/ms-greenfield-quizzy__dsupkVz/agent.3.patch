+    @quiz = Quiz.create!(title: "Frontend Fest Live 2026")
+
+    q1 = @quiz.questions.new
+    q1.save_with_option_rows(
+      { body: "Which HTTP status code means Too Many Requests?", active: true },
+      {
+        "0" => { text: "418", correct: "0" },
+        "1" => { text: "429", correct: "1" },
+        "2" => { text: "503", correct: "0" }
+      }
+    )
+
+    q2_inactive = @quiz.questions.new
+    q2_inactive.save_with_option_rows(
+      { body: "Inactive draft question to skip?", active: false },
+      {
+        "0" => { text: "Draft A", correct: "1" },
+        "1" => { text: "Draft B", correct: "0" }
+      }
+    )
+
+    q3 = @quiz.questions.new
+    q3.save_with_option_rows(
+      { body: "Which TLS versions are modern and secure?", active: true },
+      {
+        "0" => { text: "TLS 1.2", correct: "1" },
+        "1" => { text: "TLS 1.3", correct: "1" },
+        "2" => { text: "SSL 3.0", correct: "0" }
+      }
+    )
+
+    q4 = @quiz.questions.new
+    q4.save_with_option_rows(
+      { body: "Which protocol keeps a two-way browser connection?", active: true },
+      {
+        "0" => { text: "WebSocket", correct: "1" },
+        "1" => { text: "SMTP", correct: "0" }
+      }
+    )
+  end
+
+  test "full live game across big screen and multiple phones without page reloads" do
+    join_url = nil
+    game = nil
+
+    # 1. Moderator starts a game from the quiz page -> stays in /moderate area
+    using_session(:moderator) do
+      visit_moderate "/moderate/quizzes/#{@quiz.id}"
+      click_button "Start a game"
+
+      assert_match(%r{/moderate/quizzes/#{@quiz.id}/games/\d+\z}, current_path)
+      game = Game.order(:id).last
+
+      # Plant marker to prove the big screen NEVER reloads across the entire game
+      page.execute_script("window.__bigScreenNoReload = 'intact'")
+
+      assert_text "Frontend Fest Live 2026"
+      assert_text "Players: 0"
+      assert_button "Start"
+
+      # Plain-text join link is a full URL (with host & port and /play/CODE)
+      join_url = find(".lobby__url").text.strip
+      assert_match(%r{\Ahttps?://[^/]+/play/#{game.code}\z}, join_url)
+
+      # QR code SVG is rendered visibly and matches the exact QR path for join_url
+      assert_selector ".qr svg"
+      qr_box = page.evaluate_script("document.querySelector('.qr svg').getBoundingClientRect().width")
+      assert_operator qr_box, :>, 100
+      expected_svg_path = RQRCode::QRCode.new(join_url).as_svg(use_path: true, standalone: false)[/d="([^"]+)"/, 1]
+      actual_svg_path = find(".qr svg path", visible: :all)[:d]
+      assert_equal expected_svg_path, actual_svg_path
+    end
+
+    # 2. Alice opens join link on phone, joins, and moderator counter updates live
+    using_session(:alice) do
+      visit join_url
+      page.execute_script("window.__aliceNoReload = 'intact'")
+
+      assert_field "Your name"
+      assert_button "Join"
+
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+
+      assert_text "Hi, Alice!"
+      assert_equal "intact", page.evaluate_script("window.__aliceNoReload")
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 1"
+    end
+
+    # 3. Bob joins on a second phone -> Players: 2
+    using_session(:bob) do
+      visit join_url
+      fill_in "Your name", with: "Bob"
+      click_button "Join"
+      assert_text "Hi, Bob!"
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 2"
+    end
+
+    # 4. Browser remembers player when reopening join link, and tracks leaving/returning players live
+    using_session(:alice) do
+      visit join_url
+      assert_text "Hi, Alice!"
+      assert_no_button "Join"
+      page.execute_script("window.__aliceNoReload = 'intact'")
+    end
+
+    using_session(:bob) do
+      visit "about:blank"
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 1"
+    end
+
+    using_session(:bob) do
+      visit join_url
+      assert_text "Hi, Bob!"
+      page.execute_script("window.__bobNoReload = 'intact'")
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 2"
+
+      # 5. Moderator clicks Start -> Question 1 of 3 (inactive question skipped!)
+      click_button "Start"
+
+      assert_text "Question 1 of 3"
+      assert_text "Which HTTP status code means Too Many Requests?"
+      assert_no_text "Inactive draft question to skip?"
+      assert_text "418"
+      assert_text "429"
+      assert_text "503"
+      assert_text "Answers: 0 / 2"
+      assert_button "Finish"
+      assert_no_text "Correct"
+    end
+
+    # 6. Phones follow live without reload; correct answer is NOT anywhere in page source while open
+    using_session(:alice) do
+      assert_text "Which HTTP status code means Too Many Requests?"
+      assert_button "418"
+      assert_button "429"
+      assert_button "503"
+      assert_equal "intact", page.evaluate_script("window.__aliceNoReload")
+      refute_match(/correct/i, page.html)
+
+      # Alice taps 418 first -> marked "Your answer"
+      click_button "418"
+      within("button", text: "418") do
+        assert_text "Your answer"
+      end
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 1 / 2"
+    end
+
+    # Alice changes her answer to 429 before Finish -> last pick counts!
+    using_session(:alice) do
+      click_button "429"
+      within("button", text: "429") do
+        assert_text "Your answer"
+      end
+      within("button", text: "418") do
+        assert_no_text "Your answer"
+      end
+    end
+
+    using_session(:bob) do
+      assert_text "Which HTTP status code means Too Many Requests?"
+      click_button "503"
+      within("button", text: "503") do
+        assert_text "Your answer"
+      end
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 2 / 2"
+    end
+
+    # 7. Charlie joins mid-question -> sees open question immediately, denominator becomes 3!
+    using_session(:charlie) do
+      visit join_url
+      fill_in "Your name", with: "Charlie"
+      click_button "Join"
+      assert_text "Which HTTP status code means Too Many Requests?"
+      assert_button "429"
+      # Charlie does not pick an answer on Question 1
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 2 / 3"
+
+      # 8. Moderator clicks Finish -> closes Q1, shows answer counts & "Correct", shows "Next"
+      click_button "Finish"
+
+      within("li", text: "418") do
+        assert_text "0"
+        assert_no_text "Correct"
+      end
+      within("li", text: "429") do
+        assert_text "Correct"
+        assert_text "1"
+      end
+      within("li", text: "503") do
+        assert_text "1"
+        assert_no_text "Correct"
+      end
+      assert_button "Next"
+      assert_no_button "End quiz"
+    end
+
+    # Phones live-show "Correct!", "Wrong!", and "No answer"
+    using_session(:alice) do
+      assert_text "Correct!"
+    end
+
+    using_session(:bob) do
+      assert_text "Wrong!"
+    end
+
+    using_session(:charlie) do
+      assert_text "No answer"
+    end
+
+    # 9. Moderator clicks Next -> Question 2 of 3 (multi-correct); Charlie leaves -> active count drops to 2!
+    using_session(:moderator) do
+      click_button "Next"
+      assert_text "Question 2 of 3"
+      assert_text "Which TLS versions are modern and secure?"
+      assert_text "Answers: 0 / 3"
+    end
+
+    using_session(:charlie) do
+      visit "about:blank"
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 0 / 2"
+    end
+
+    using_session(:alice) do
+      assert_text "Which TLS versions are modern and secure?"
+      click_button "TLS 1.2"
+      within("button", text: "TLS 1.2") do
+        assert_text "Your answer"
+      end
+    end
+
+    using_session(:bob) do
+      assert_text "Which TLS versions are modern and secure?"
+      click_button "TLS 1.3"
+      within("button", text: "TLS 1.3") do
+        assert_text "Your answer"
+      end
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 2 / 2"
+      click_button "Finish"
+
+      within("li", text: "TLS 1.2") do
+        assert_text "Correct"
+        assert_text "1"
+      end
+      within("li", text: "TLS 1.3") do
+        assert_text "Correct"
+        assert_text "1"
+      end
+      within("li", text: "SSL 3.0") do
+        assert_no_text "Correct"
+        assert_text "0"
+      end
+      assert_button "Next"
+
+      # 10. Advance to Question 3 of 3 (last active question) -> Finish shows "End quiz" instead of "Next"
+      click_button "Next"
+      assert_text "Question 3 of 3"
+      assert_text "Which protocol keeps a two-way browser connection?"
+      assert_text "Answers: 0 / 2"
+    end
+
+    using_session(:alice) do
+      assert_text "Which protocol keeps a two-way browser connection?"
+      click_button "WebSocket"
+      within("button", text: "WebSocket") do
+        assert_text "Your answer"
+      end
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 1 / 2"
+      click_button "Finish"
+
+      within("li", text: "WebSocket") do
+        assert_text "Correct"
+        assert_text "1"
+      end
+      within("li", text: "SMTP") do
+        assert_no_text "Correct"
+        assert_text "0"
+      end
+
+      assert_no_button "Next"
+      assert_button "End quiz"
+
+      # 11. End quiz -> "The quiz is over" on big screen and phones without reloads!
+      click_button "End quiz"
+      assert_text "The quiz is over"
+      assert_no_button "End quiz"
+      assert_equal "intact", page.evaluate_script("window.__bigScreenNoReload")
+    end
+
+    using_session(:alice) do
+      assert_text "The quiz is over"
+      assert_equal "intact", page.evaluate_script("window.__aliceNoReload")
+    end
+
+    using_session(:bob) do
+      assert_text "The quiz is over"
+      assert_equal "intact", page.evaluate_script("window.__bobNoReload")
+    end
+
+    # 12. Opening join link after the end shows "The quiz is over" and does not let anyone join
+    using_session(:late_visitor) do
+      visit join_url
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+  end
+
+  test "replaying a quiz creates an independent game and single-question quiz goes directly to End quiz" do
+    single_quiz = Quiz.create!(title: "Lightning <Talk> Quiz")
+    q = single_quiz.questions.new
+    q.save_with_option_rows(
+      { body: "Only <one> active question?", active: true },
+      {
+        "0" => { text: "<Yes>", correct: "1" },
+        "1" => { text: "<No>", correct: "0" }
+      }
+    )
+
+    rehearsal_url = nil
+    real_talk_url = nil
+
+    # Game 1: Rehearsal
+    using_session(:moderator) do
+      visit_moderate "/moderate/quizzes/#{single_quiz.id}"
+      click_button "Start a game"
+      rehearsal_url = find(".lobby__url").text.strip
+    end
+
+    using_session(:alice) do
+      visit rehearsal_url
+      fill_in "Your name", with: "Alice <Rehearsal>"
+      click_button "Join"
+      assert_text "Hi, Alice <Rehearsal>!"
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 1"
+      click_button "Start"
+      assert_text "Question 1 of 1"
+    end
+
+    using_session(:alice) do
+      click_button "<Yes>"
+      within("button", text: "<Yes>") do
+        assert_text "Your answer"
+      end
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 1 / 1"
+      click_button "Finish"
+      assert_no_button "Next"
+      assert_button "End quiz"
+      click_button "End quiz"
+      assert_text "The quiz is over"
+
+      # Game 2: Real talk from the same quiz
+      click_link "← Back to quiz"
+      click_button "Start a game"
+      real_talk_url = find(".lobby__url").text.strip
+      assert_not_equal rehearsal_url, real_talk_url
+      assert_text "Players: 0"
+    end
+
+    # Alice's same browser opens the new game's link -> fresh game, asked for name again!
+    using_session(:alice) do
+      visit rehearsal_url
+      assert_text "The quiz is over"
+
+      visit real_talk_url
+      assert_field "Your name"
+      assert_button "Join"
+    end
+  end
+end
+class LiveGameEdgeCasesSystemTest < ApplicationSystemTestCase
+  test "reloading phone mid-question preserves Your answer without leaking correctness, and unjoined guest sees live end" do
+    quiz = Quiz.create!(title: "Edge Case Live Quiz")
+    q = quiz.questions.new
+    q.save_with_option_rows(
+      { body: "Which port is standard HTTP?", active: true },
+      {
+        "0" => { text: "Port 80", correct: "1" },
+        "1" => { text: "Port 22", correct: "0" }
+      }
+    )
+
+    join_url = nil
+    big_screen_path = nil
+
+    using_session(:moderator) do
+      visit_moderate "/moderate/quizzes/#{quiz.id}"
+      click_button "Start a game"
+      big_screen_path = current_path
+      join_url = find(".lobby__url").text.strip
+    end
+
+    using_session(:alice) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    # Guest opens join link but does NOT submit Join yet
+    using_session(:unjoined_guest) do
+      visit join_url
+      assert_field "Your name"
+      assert_button "Join"
+      page.execute_script("window.__guestNoReload = 'intact'")
+    end
+
+    using_session(:moderator) do
+      # Unjoined guest is NOT counted as a player yet
+      assert_text "Players: 1"
+      click_button "Start"
+      assert_text "Question 1 of 1"
+      assert_text "Answers: 0 / 1"
+    end
+
+    using_session(:alice) do
+      assert_text "Which port is standard HTTP?"
+      click_button "Port 80"
+      within("button", text: "Port 80") do
+        assert_text "Your answer"
+      end
+
+      # Reloading phone mid-question remembers Alice AND her picked answer, and still leaks nothing about correctness!
+      visit join_url
+      assert_text "Which port is standard HTTP?"
+      within("button", text: "Port 80") do
+        assert_text "Your answer"
+      end
+      refute_match(/correct/i, page.html)
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 1 / 1"
+
+      # Reloading big screen mid-question renders exact open state
+      visit_moderate big_screen_path
+      assert_text "Question 1 of 1"
+      assert_text "Answers: 1 / 1"
+
+      click_button "Finish"
+      within("li", text: "Port 80") do
+        assert_text "Correct"
+        assert_text "1"
+      end
+      click_button "End quiz"
+      assert_text "The quiz is over"
+    end
+
+    # Unjoined guest sitting on the join form live-transitions to "The quiz is over" without reload!
+    using_session(:unjoined_guest) do
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+      assert_equal "intact", page.evaluate_script("window.__guestNoReload")
+    end
+  end
+end
