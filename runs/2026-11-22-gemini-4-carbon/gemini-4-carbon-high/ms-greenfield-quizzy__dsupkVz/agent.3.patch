diff --git a/app/views/moderate/games/show.html.erb b/app/views/moderate/games/show.html.erb
new file mode 100644
index 0000000..5bcd498
--- /dev/null
+++ b/app/views/moderate/games/show.html.erb
@@ -0,0 +1,107 @@
+<% content_for :title, "Quizzy · #{@quiz.title}" %>
+<%
+  status = @payload[:status]
+  question = @payload[:question]
+  cover_class =
+    case status
+    when "lobby" then "cover cover--blue"
+    when "question_open" then "cover cover--blue cover--calm"
+    when "question_closed" then "cover cover--night cover--calm"
+    else "cover cover--night"
+    end
+%>
+
+<section class="<%= cover_class %>"
+         data-controller="moderator-game"
+         data-moderator-game-initial-state-value="<%= @payload.to_json %>"
+         data-moderator-game-stream-token-value="<%= @stream_token %>"
+         data-moderator-game-state-url-value="<%= moderate_quiz_game_path(@quiz, @game, format: :json) %>"
+         data-moderator-game-start-url-value="<%= start_moderate_quiz_game_path(@quiz, @game) %>"
+         data-moderator-game-finish-url-value="<%= finish_moderate_quiz_game_path(@quiz, @game) %>"
+         data-moderator-game-next-url-value="<%= next_question_moderate_quiz_game_path(@quiz, @game) %>"
+         data-moderator-game-end-url-value="<%= end_quiz_moderate_quiz_game_path(@quiz, @game) %>">
+  <div class="screen">
+    <div class="screen__top">
+      <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span data-moderator-game-target="topTitle"><%= status == "lobby" ? "" : @quiz.title %></span>
+    </div>
+
+    <div class="screen__body">
+      <div class="lobby" data-moderator-game-target="lobbyView" <%= "hidden" unless status == "lobby" %>>
+        <div>
+          <h1 class="lobby__title"><%= @quiz.title %></h1>
+          <div class="lobby__join">Join at</div>
+          <div class="lobby__url"><%= @payload[:join_url] %></div>
+          <div class="counter-pill"><span data-moderator-game-target="playersCounter">Players: <%= @payload[:active_players_count] %></span></div>
+        </div>
+        <div class="qr">
+          <%= @qr_svg %>
+        </div>
+      </div>
+
+      <div class="stage-question" data-moderator-game-target="questionView" <%= "hidden" unless %w[question_open question_closed].include?(status) %>>
+        <div class="stage-question__num" data-moderator-game-target="questionProgress"><%= question ? "Question #{question[:position]} of #{question[:total]}" : "" %></div>
+        <div class="stage-question__body" data-moderator-game-target="questionBody"><%= question ? question[:body] : "" %></div>
+        <ol class="stage-options <%= 'stage-options--results' if status == 'question_closed' %>" data-moderator-game-target="questionOptions">
+          <% if question %>
+            <% total_answers = question[:total_answers].to_i %>
+            <% question[:options].each_with_index do |opt, idx| %>
+              <% if status == "question_closed" %>
+                <% count = opt[:answers_count].to_i %>
+                <% share = total_answers > 0 ? ((count.to_f / total_answers) * 100).round : 0 %>
+                <li class="stage-option <%= 'is-correct' if opt[:correct] %>">
+                  <span class="stage-option__bar" style="--share: <%= share %>%"></span>
+                  <span class="stage-option__letter"><%= option_letter(idx) %></span>
+                  <span class="stage-option__title"><%= opt[:text] %></span>
+                  <% if opt[:correct] %>
+                    <span class="stage-option__mark">Correct</span>
+                  <% end %>
+                  <span class="stage-option__count"><%= count %></span>
+                </li>
+              <% else %>
+                <li class="stage-option">
+                  <span class="stage-option__letter"><%= option_letter(idx) %></span>
+                  <span class="stage-option__title"><%= opt[:text] %></span>
+                </li>
+              <% end %>
+            <% end %>
+          <% end %>
+        </ol>
+      </div>
+
+      <div data-moderator-game-target="finishedView" <%= "hidden" unless status == "finished" %>>
+        <h1 class="lobby__title">The quiz is over</h1>
+      </div>
+    </div>
+  </div>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "← Back to quiz", moderate_quiz_path(@quiz) %>
+      <span data-moderator-game-target="controlsJoinUrl" <%= "hidden" unless %w[question_open question_closed].include?(status) %>><%= @payload[:join_url] %></span>
+      <span class="answers-counter" data-moderator-game-target="answersCounter" <%= "hidden" unless status == "question_open" %>><%= status == "question_open" && question ? "Answers: #{question[:answered_count]} / #{@payload[:active_players_count]}" : "" %></span>
+    </div>
+
+    <div class="buttons" data-moderator-game-target="actionButtons">
+      <% if status == "lobby" %>
+        <%= form_with url: start_moderate_quiz_game_path(@quiz, @game), method: :patch, data: { action: "submit->moderator-game#performAction" } do %>
+          <button type="submit" class="btn btn--pink btn--lg">Start</button>
+        <% end %>
+      <% elsif status == "question_open" %>
+        <%= form_with url: finish_moderate_quiz_game_path(@quiz, @game), method: :patch, data: { action: "submit->moderator-game#performAction" } do %>
+          <button type="submit" class="btn btn--pink btn--lg">Finish</button>
+        <% end %>
+      <% elsif status == "question_closed" && question %>
+        <% if question[:last_question] %>
+          <%= form_with url: end_quiz_moderate_quiz_game_path(@quiz, @game), method: :patch, data: { action: "submit->moderator-game#performAction" } do %>
+            <button type="submit" class="btn btn--pink btn--lg">End quiz</button>
+          <% end %>
+        <% else %>
+          <%= form_with url: next_question_moderate_quiz_game_path(@quiz, @game), method: :patch, data: { action: "submit->moderator-game#performAction" } do %>
+            <button type="submit" class="btn btn--pink btn--lg">Next</button>
+          <% end %>
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+</section>
