@@ -0,0 +1,13 @@
+class ModerateGameChannel < ApplicationCable::Channel
+  def subscribed
+    game = Game.find_by_stream_token(params[:stream_token].to_s)
+    if game.nil?
+      reject
+      return
+    end
+
+    @game = game
+    stream_from "moderate_game_#{@game.id}"
+    transmit(@game.moderator_payload)
+  end
+end
diff --git a/app/channels/play_game_channel.rb b/app/channels/play_game_channel.rb
new file mode 100644
index 0000000..4bb092b
--- /dev/null
+++ b/app/channels/play_game_channel.rb
@@ -0,0 +1,32 @@
+class PlayGameChannel < ApplicationCable::Channel
+  def subscribed
+    code = params[:code].to_s.strip.upcase
+    @game = Game.find_by(code: code)
+    if @game.nil?
+      reject
+      return
+    end
+
+    stream_from "play_game_#{@game.code}"
+
+    player_token = params[:player_token].to_s
+    if player_token.present?
+      player = @game.players.find_by(token: player_token)
+      if player
+        @player = player
+        stream_from "play_player_#{@player.token}"
+        @player.increment_connections!
+      end
+    end
+
+    if @player
+      transmit(@game.player_state_payload(@player).merge(type: "player_sync"))
+    else
+      transmit(@game.play_broadcast_payload)
+    end
+  end
+
+  def unsubscribed
+    @player&.decrement_connections!
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
new file mode 100644
index 0000000..45406e2
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,68 @@
+module Moderate
+  class GamesController < BaseController
+    before_action :set_quiz
+    before_action :set_game, only: [ :show, :start, :finish, :next_question, :end_quiz ]
+
+    def create
+      @game = @quiz.games.create!(base_url: request.base_url)
+      redirect_to moderate_quiz_game_path(@quiz, @game), status: :see_other
+    end
+
+    def show
+      if request.format.html? && @game.base_url != request.base_url
+        @game.update_column(:base_url, request.base_url)
+      end
+
+      @payload = @game.moderator_payload(fallback_base_url: request.base_url)
+
+      respond_to do |format|
+        format.html do
+          @qr_svg = @game.qr_svg(request.base_url)
+          @stream_token = @game.stream_token
+          render layout: "application"
+        end
+        format.json do
+          render json: @payload
+        end
+      end
+    end
+
+    def start
+      @game.start!
+      respond_with_game_state
+    end
+
+    def finish
+      @game.finish_question!
+      respond_with_game_state
+    end
+
+    def next_question
+      @game.next_question!
+      respond_with_game_state
+    end
+
+    def end_quiz
+      @game.end_quiz!
+      respond_with_game_state
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_game
+      @game = @quiz.games.find(params[:id])
+    end
+
+    def respond_with_game_state
+      if request.headers["X-Quizzy-Async"] == "1" || request.format.json?
+        render json: @game.reload.moderator_payload(fallback_base_url: request.base_url)
+      else
+        redirect_to moderate_quiz_game_path(@quiz, @game), status: :see_other
+      end
+    end
+  end
+end
diff --git a/app/controllers/plays_controller.rb b/app/controllers/plays_controller.rb
new file mode 100644
index 0000000..f7d0b59
--- /dev/null
+++ b/app/controllers/plays_controller.rb
@@ -0,0 +1,150 @@
+class PlaysController < ApplicationController
+  before_action :set_game
+
+  def show
+    ensure_browser_token!
+    @quiz = @game.quiz
+    @player = find_current_player
+    if @player && !@game.finished?
+      @player.touch_online_grace!
+    end
+    @initial_state = @game.reload.player_state_payload(@player)
+  end
+
+  def join
+    @quiz = @game.quiz
+
+    if @game.finished?
+      if async_request?
+        render json: { joined: false, state: @game.player_state_payload(nil) }, status: :unprocessable_entity
+      else
+        redirect_to play_path(@game.code), status: :see_other
+      end
+      return
+    end
+
+    existing_player = find_current_player
+    if existing_player
+      existing_player.touch_online_grace!
+      remember_player!(existing_player)
+      if async_request?
+        render json: { joined: true, state: @game.reload.player_state_payload(existing_player) }
+      else
+        redirect_to play_path(@game.code), status: :see_other
+      end
+      return
+    end
+
+    b_token = ensure_browser_token!
+    @player = @game.players.new(
+      name: params[:name].to_s,
+      browser_token: b_token,
+      online_until: Player::ONLINE_GRACE_DURATION.from_now
+    )
+
+    begin
+      saved = @player.save
+    rescue ActiveRecord::RecordNotUnique
+      @player = @game.players.find_by!(browser_token: b_token)
+      saved = true
+    end
+
+    if saved
+      remember_player!(@player)
+      @game.bump_version_and_broadcast_moderator!
+      if async_request?
+        render json: { joined: true, state: @game.reload.player_state_payload(@player) }
+      else
+        redirect_to play_path(@game.code), status: :see_other
+      end
+    else
+      @join_error = @player.errors.full_messages.first || "Enter your name"
+      if async_request?
+        render json: { joined: false, error: @join_error }, status: :unprocessable_entity
+      else
+        @player = nil
+        @initial_state = @game.player_state_payload(nil)
+        render :show, status: :unprocessable_entity
+      end
+    end
+  end
+
+  def answer
+    @player = find_current_player
+    if @player.nil?
+      head :unauthorized
+      return
+    end
+
+    result = @game.submit_answer!(
+      player: @player,
+      option_id: params[:option_id],
+      client_seq: params[:client_seq]
+    )
+
+    render json: {
+      accepted: result[:accepted],
+      state: @game.reload.player_state_payload(@player)
+    }
+  end
+
+  def state
+    @player = find_current_player
+    if @player && !@game.finished? && params[:offline_poll] == "1"
+      @player.touch_online_grace!
+    end
+    render json: @game.reload.player_state_payload(@player)
+  end
+
+  def leave
+    @player = find_current_player
+    @player&.clear_online_grace!
+    head :no_content
+  end
+
+  private
+
+  def set_game
+    @game = Game.includes(:quiz).find_by!(code: params[:code].to_s.strip.upcase)
+  end
+
+  def async_request?
+    request.headers["X-Quizzy-Async"] == "1" || request.format.json?
+  end
+
+  def ensure_browser_token!
+    existing = cookies.signed[:quizzy_browser_token]
+    return existing if existing.present?
+
+    generated = SecureRandom.urlsafe_base64(24)
+    cookies.permanent.signed[:quizzy_browser_token] = {
+      value: generated,
+      httponly: true,
+      same_site: :lax
+    }
+    generated
+  end
+
+  def player_cookie_key
+    :"quizzy_player_#{@game.code}"
+  end
+
+  def remember_player!(player)
+    cookies.permanent.signed[player_cookie_key] = {
+      value: player.token,
+      httponly: true,
+      same_site: :lax
+    }
+  end
+
+  def find_current_player
+    token = cookies.signed[player_cookie_key].presence || params[:player_token].presence
+    if token.present?
+      by_token = @game.players.find_by(token: token)
+      return by_token if by_token
+    end
+
+    b_token = cookies.signed[:quizzy_browser_token]
+    @game.players.find_by(browser_token: b_token) if b_token.present?
+  end
+end
diff --git a/app/javascript/controllers/moderator_game_controller.js b/app/javascript/controllers/moderator_game_controller.js
new file mode 100644
index 0000000..618357c
--- /dev/null
+++ b/app/javascript/controllers/moderator_game_controller.js
@@ -0,0 +1,327 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static values = {
+    initialState: Object,
+    streamToken: String,
+    stateUrl: String,
+    startUrl: String,
+    finishUrl: String,
+    nextUrl: String,
+    endUrl: String
+  }
+
+  static targets = [
+    "topTitle",
+    "lobbyView",
+    "playersCounter",
+    "questionView",
+    "questionProgress",
+    "questionBody",
+    "questionOptions",
+    "finishedView",
+    "controlsJoinUrl",
+    "answersCounter",
+    "actionButtons"
+  ]
+
+  connect() {
+    this.state = { ...this.initialStateValue }
+    this.lastVersion = typeof this.state.version === "number" ? this.state.version : -1
+    this.renderedPhaseKey = this.phaseKey(this.state)
+    this.submitting = false
+    this.cableConnected = false
+
+    this.handleVisibilityChange = () => {
+      if (document.visibilityState === "visible") {
+        this.syncState()
+      }
+    }
+    document.addEventListener("visibilitychange", this.handleVisibilityChange)
+
+    this.consumer = createConsumer("/cable")
+    this.subscription = this.consumer.subscriptions.create(
+      {
+        channel: "ModerateGameChannel",
+        stream_token: this.streamTokenValue
+      },
+      {
+        connected: () => {
+          this.cableConnected = true
+          this.syncState()
+        },
+        disconnected: () => {
+          this.cableConnected = false
+        },
+        received: (data) => {
+          this.applyState(data)
+        }
+      }
+    )
+
+    this.pollTimer = setInterval(() => {
+      if (this.state.status !== "finished" || !this.cableConnected) {
+        this.syncState()
+      }
+    }, 2000)
+  }
+
+  disconnect() {
+    document.removeEventListener("visibilitychange", this.handleVisibilityChange)
+    if (this.pollTimer) {
+      clearInterval(this.pollTimer)
+      this.pollTimer = null
+    }
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  phaseKey(state) {
+    if (!state) return ""
+    return `${state.status}:${state.question?.id || 0}`
+  }
+
+  optionLetter(index) {
+    let n = index
+    let result = ""
+    while (n >= 0) {
+      result = String.fromCharCode(65 + (n % 26)) + result
+      n = Math.floor(n / 26) - 1
+    }
+    return result
+  }
+
+  csrfToken() {
+    return document.querySelector("meta[name='csrf-token']")?.content || ""
+  }
+
+  async syncState() {
+    if (!this.stateUrlValue) return
+    try {
+      const res = await fetch(this.stateUrlValue, {
+        method: "GET",
+        credentials: "same-origin",
+        headers: { Accept: "application/json" }
+      })
+      if (res.ok) {
+        const data = await res.json()
+        this.applyState(data)
+      }
+    } catch (_err) {
+      // Ignore transient conference Wi-Fi errors; next poll/WS will recover
+    }
+  }
+
+  async performAction(event) {
+    event.preventDefault()
+    if (this.submitting) return
+    this.submitting = true
+
+    const form = event.currentTarget
+    const actionUrl = form.getAttribute("action")
+    const formData = new FormData(form)
+
+    try {
+      const res = await fetch(actionUrl, {
+        method: "POST",
+        body: formData,
+        credentials: "same-origin",
+        headers: {
+          "X-CSRF-Token": this.csrfToken(),
+          "X-Quizzy-Async": "1",
+          Accept: "application/json"
+        }
+      })
+      if (res.ok) {
+        const data = await res.json()
+        this.applyState(data)
+      }
+    } catch (_err) {
+      await this.syncState()
+    } finally {
+      this.submitting = false
+    }
+  }
+
+  applyState(nextState) {
+    if (!nextState || !nextState.status) return
+    if (typeof nextState.version === "number" && nextState.version < this.lastVersion) {
+      return
+    }
+    if (typeof nextState.version === "number") {
+      this.lastVersion = nextState.version
+    }
+
+    this.state = nextState
+
+    const nextKey = this.phaseKey(nextState)
+    if (nextKey !== this.renderedPhaseKey) {
+      this.renderPhase(nextState)
+      this.renderedPhaseKey = nextKey
+    } else {
+      this.updateLiveCounters(nextState)
+    }
+  }
+
+  updateLiveCounters(state) {
+    if (state.status === "lobby") {
+      this.playersCounterTarget.textContent = `Players: ${state.active_players_count ?? 0}`
+    } else if (state.status === "question_open" && state.question) {
+      const answered = state.question.answered_count ?? 0
+      const active = state.active_players_count ?? 0
+      this.answersCounterTarget.textContent = `Answers: ${answered} / ${active}`
+    }
+  }
+
+  renderPhase(state) {
+    const status = state.status
+    const question = state.question
+
+    if (status === "lobby") {
+      this.element.className = "cover cover--blue"
+    } else if (status === "question_open") {
+      this.element.className = "cover cover--blue cover--calm"
+    } else if (status === "question_closed") {
+      this.element.className = "cover cover--night cover--calm"
+    } else {
+      this.element.className = "cover cover--night"
+    }
+
+    this.topTitleTarget.textContent = status === "lobby" ? "" : (state.quiz_title || "")
+
+    this.lobbyViewTarget.hidden = status !== "lobby"
+    this.questionViewTarget.hidden = !(status === "question_open" || status === "question_closed")
+    this.finishedViewTarget.hidden = status !== "finished"
+
+    this.controlsJoinUrlTarget.hidden = !(status === "question_open" || status === "question_closed")
+    if (state.join_url) {
+      this.controlsJoinUrlTarget.textContent = state.join_url
+    }
+
+    if (status === "lobby") {
+      this.playersCounterTarget.textContent = `Players: ${state.active_players_count ?? 0}`
+      this.answersCounterTarget.hidden = true
+      this.answersCounterTarget.textContent = ""
+      this.renderActionForm(this.startUrlValue, "Start")
+    } else if (status === "question_open" && question) {
+      this.questionProgressTarget.textContent = `Question ${question.position} of ${question.total}`
+      this.questionBodyTarget.textContent = question.body
+      this.renderQuestionOptions(question, false)
+
+      const answered = question.answered_count ?? 0
+      const active = state.active_players_count ?? 0
+      this.answersCounterTarget.hidden = false
+      this.answersCounterTarget.textContent = `Answers: ${answered} / ${active}`
+
+      this.renderActionForm(this.finishUrlValue, "Finish")
+    } else if (status === "question_closed" && question) {
+      this.questionProgressTarget.textContent = `Question ${question.position} of ${question.total}`
+      this.questionBodyTarget.textContent = question.body
+      this.renderQuestionOptions(question, true)
+
+      this.answersCounterTarget.hidden = true
+      this.answersCounterTarget.textContent = ""
+
+      if (question.last_question) {
+        this.renderActionForm(this.endUrlValue, "End quiz")
+      } else {
+        this.renderActionForm(this.nextUrlValue, "Next")
+      }
+    } else {
+      this.answersCounterTarget.hidden = true
+      this.answersCounterTarget.textContent = ""
+      this.actionButtonsTarget.replaceChildren()
+    }
+  }
+
+  renderQuestionOptions(question, closed) {
+    this.questionOptionsTarget.className = closed
+      ? "stage-options stage-options--results"
+      : "stage-options"
+    this.questionOptionsTarget.replaceChildren()
+
+    const totalAnswers = question.total_answers || 0
+
+    question.options.forEach((opt, idx) => {
+      const li = document.createElement("li")
+      li.className = closed && opt.correct ? "stage-option is-correct" : "stage-option"
+
+      if (closed) {
+        const count = opt.answers_count || 0
+        const share = totalAnswers > 0 ? Math.round((count / totalAnswers) * 100) : 0
+        const bar = document.createElement("span")
+        bar.className = "stage-option__bar"
+        bar.style.setProperty("--share", `${share}%`)
+        li.appendChild(bar)
+      }
+
+      const letter = document.createElement("span")
+      letter.className = "stage-option__letter"
+      letter.textContent = this.optionLetter(idx)
+      li.appendChild(letter)
+      li.appendChild(document.createTextNode(" "))
+
+      const title = document.createElement("span")
+      title.className = "stage-option__title"
+      title.textContent = opt.text
+      li.appendChild(title)
+
+      if (closed) {
+        if (opt.correct) {
+          li.appendChild(document.createTextNode(" "))
+          const mark = document.createElement("span")
+          mark.className = "stage-option__mark"
+          mark.textContent = "Correct"
+          li.appendChild(mark)
+        }
+
+        li.appendChild(document.createTextNode(" "))
+        const countEl = document.createElement("span")
+        countEl.className = "stage-option__count"
+        countEl.textContent = String(opt.answers_count ?? 0)
+        li.appendChild(countEl)
+      }
+
+      this.questionOptionsTarget.appendChild(li)
+    })
+  }
+
+  renderActionForm(actionUrl, label) {
+    this.actionButtonsTarget.replaceChildren()
+
+    const form = document.createElement("form")
+    form.setAttribute("action", actionUrl)
+    form.setAttribute("method", "post")
+    form.dataset.action = "submit->moderator-game#performAction"
+
+    const csrf = this.csrfToken()
+    if (csrf) {
+      const tokenInput = document.createElement("input")
+      tokenInput.type = "hidden"
+      tokenInput.name = "authenticity_token"
+      tokenInput.value = csrf
+      form.appendChild(tokenInput)
+    }
+    
+    const methodInput = document.createElement("input")
+    methodInput.type = "hidden"
+    methodInput.name = "_method"
+    methodInput.value = "patch"
+    form.appendChild(methodInput)
+
+    const btn = document.createElement("button")
+    btn.type = "submit"
+    btn.className = "btn btn--pink btn--lg"
+    btn.textContent = label
+    form.appendChild(btn)
+
+    this.actionButtonsTarget.appendChild(form)
+  }
+}
diff --git a/app/javascript/controllers/play_controller.js b/app/javascript/controllers/play_controller.js
new file mode 100644
index 0000000..99d8895
--- /dev/null
+++ b/app/javascript/controllers/play_controller.js
@@ -0,0 +1,498 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static values = {
+    code: String,
+    initialState: Object,
+    joinUrl: String,
+    answerUrl: String,
+    stateUrl: String,
+    leaveUrl: String
+  }
+
+  static targets = [
+    "headerName",
+    "bodyContainer",
+    "joinView",
+    "joinError",
+    "nameInput",
+    "joinButton",
+    "waitingView",
+    "greeting",
+    "questionView",
+    "questionProgress",
+    "questionBody",
+    "questionOptions",
+    "questionFeedback",
+    "finishedView"
+  ]
+
+  connect() {
+    this.state = { ...this.initialStateValue }
+    this.lastVersion = typeof this.state.version === "number" ? this.state.version : -1
+    this.pickedByQuestion = {}
+    if (this.state.question && this.state.question.picked_option_id != null) {
+      this.pickedByQuestion[this.state.question.id] = this.state.question.picked_option_id
+    }
+
+    this.answerSeq = 0
+    this.latestConfirmedSeq = 0
+    this.joining = false
+    this.cableConnected = false
+    this.renderedPhaseKey = this.phaseKey(this.state)
+
+    this.handleVisibilityChange = () => {
+      if (document.visibilityState === "visible") {
+        this.syncState()
+      }
+    }
+    this.handlePageHide = () => {
+      this.notifyLeave()
+    }
+
+    document.addEventListener("visibilitychange", this.handleVisibilityChange)
+    window.addEventListener("pagehide", this.handlePageHide)
+
+    this.consumer = createConsumer("/cable")
+    this.connectSubscription()
+
+    this.pollTimer = setInterval(() => {
+      if (this.state.status !== "finished" || !this.cableConnected) {
+        this.syncState(!this.cableConnected)
+      }
+    }, 2500)
+  }
+
+  disconnect() {
+    document.removeEventListener("visibilitychange", this.handleVisibilityChange)
+    window.removeEventListener("pagehide", this.handlePageHide)
+
+    if (this.pollTimer) {
+      clearInterval(this.pollTimer)
+      this.pollTimer = null
+    }
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  connectSubscription() {
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+
+    this.subscription = this.consumer.subscriptions.create(
+      {
+        channel: "PlayGameChannel",
+        code: this.codeValue,
+        player_token: this.state.player_token || ""
+      },
+      {
+        connected: () => {
+          this.cableConnected = true
+        },
+        disconnected: () => {
+          this.cableConnected = false
+        },
+        received: (data) => {
+          this.handleCableMessage(data)
+        }
+      }
+    )
+  }
+
+  notifyLeave() {
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+    if (this.state.joined && this.leaveUrlValue && navigator.sendBeacon) {
+      const formData = new FormData()
+      const token = this.csrfToken()
+      if (token) formData.append("authenticity_token", token)
+      if (this.state.player_token) formData.append("player_token", this.state.player_token)
+      navigator.sendBeacon(this.leaveUrlValue, formData)
+    }
+  }
+
+  csrfToken() {
+    return document.querySelector("meta[name='csrf-token']")?.content || ""
+  }
+
+  optionLetter(index) {
+    let n = index
+    let result = ""
+    while (n >= 0) {
+      result = String.fromCharCode(65 + (n % 26)) + result
+      n = Math.floor(n / 26) - 1
+    }
+    return result
+  }
+
+  phaseKey(state) {
+    if (!state) return ""
+    const joinedPart = state.joined ? "joined" : "guest"
+    return `${joinedPart}:${state.status}:${state.question?.id || 0}`
+  }
+
+  handleCableMessage(data) {
+    if (!data) return
+
+    if (data.type === "player_answer") {
+      if (data.question_id != null) {
+        this.pickedByQuestion[data.question_id] = data.picked_option_id
+        if (this.state.question && this.state.question.id === data.question_id && this.state.status === "question_open") {
+          this.updatePickedMark(data.picked_option_id)
+        }
+      }
+      return
+    }
+
+    if (data.type === "player_sync") {
+      this.applyFullPlayerState(data)
+      return
+    }
+
+    if (data.type === "game_state") {
+      if (typeof data.version === "number" && data.version < this.lastVersion) {
+        return
+      }
+      if (typeof data.version === "number") {
+        this.lastVersion = data.version
+      }
+
+      const merged = {
+        ...this.state,
+        version: data.version,
+        status: data.status,
+        quiz_title: data.quiz_title || this.state.quiz_title,
+        question: data.question || null
+      }
+
+      if (merged.question && this.pickedByQuestion[merged.question.id] !== undefined) {
+        merged.question = {
+          ...merged.question,
+          picked_option_id: this.pickedByQuestion[merged.question.id]
+        }
+      }
+
+      this.state = merged
+      this.renderIfNeeded()
+    }
+  }
+
+  applyFullPlayerState(playerState) {
+    if (!playerState || !playerState.status) return
+    if (typeof playerState.version === "number" && playerState.version < this.lastVersion) {
+      return
+    }
+    if (typeof playerState.version === "number") {
+      this.lastVersion = playerState.version
+    }
+
+    if (playerState.question && playerState.question.picked_option_id !== undefined) {
+      this.pickedByQuestion[playerState.question.id] = playerState.question.picked_option_id
+    }
+
+    this.state = { ...playerState }
+    this.renderIfNeeded()
+  }
+
+  async syncState(offlinePoll = false) {
+    if (!this.stateUrlValue) return
+    const url = offlinePoll ? `${this.stateUrlValue}?offline_poll=1` : this.stateUrlValue
+
+    try {
+      const res = await fetch(url, {
+        method: "GET",
+        credentials: "same-origin",
+        headers: { Accept: "application/json" }
+      })
+      if (res.ok) {
+        const data = await res.json()
+        const wasJoined = Boolean(this.state.joined)
+        this.applyFullPlayerState(data)
+        if (!wasJoined && data.joined && data.player_token) {
+          this.connectSubscription()
+        }
+      }
+    } catch (_err) {
+      // Ignore transient network hiccups on conference Wi-Fi
+    }
+  }
+
+  async join(event) {
+    event.preventDefault()
+    if (this.joining) return
+
+    const name = this.nameInputTarget.value.trim()
+    if (!name) {
+      this.joinErrorTarget.textContent = "Name can't be blank"
+      this.joinErrorTarget.hidden = false
+      return
+    }
+
+    this.joining = true
+    this.joinButtonTarget.disabled = true
+    this.joinErrorTarget.hidden = true
+
+    const formData = new FormData()
+    formData.append("name", name)
+
+    try {
+      const res = await fetch(this.joinUrlValue, {
+        method: "POST",
+        body: formData,
+        credentials: "same-origin",
+        headers: {
+          "X-CSRF-Token": this.csrfToken(),
+          "X-Quizzy-Async": "1",
+          Accept: "application/json"
+        }
+      })
+
+      const json = await res.json().catch(() => ({}))
+
+      if (res.ok && json.joined && json.state) {
+        this.lastVersion = typeof json.state.version === "number" ? json.state.version : this.lastVersion
+        if (json.state.question && json.state.question.picked_option_id != null) {
+          this.pickedByQuestion[json.state.question.id] = json.state.question.picked_option_id
+        }
+        this.state = json.state
+        this.renderPhase(this.state)
+        this.renderedPhaseKey = this.phaseKey(this.state)
+        this.connectSubscription()
+      } else if (json.state && json.state.status === "finished") {
+        this.state = json.state
+        this.renderPhase(this.state)
+        this.renderedPhaseKey = this.phaseKey(this.state)
+      } else {
+        this.joinErrorTarget.textContent = json.error || "Unable to join"
+        this.joinErrorTarget.hidden = false
+      }
+    } catch (_err) {
+      this.joinErrorTarget.textContent = "Connection error, please tap Join again"
+      this.joinErrorTarget.hidden = false
+    } finally {
+      this.joining = false
+      if (this.hasJoinButtonTarget) {
+        this.joinButtonTarget.disabled = false
+      }
+    }
+  }
+
+  async pick(event) {
+    if (!this.state.joined || this.state.status !== "question_open" || !this.state.question) {
+      return
+    }
+
+    const optionId = Number(event.currentTarget.dataset.optionId)
+    if (!optionId) return
+
+    const questionId = this.state.question.id
+    const seq = ++this.answerSeq
+
+    const sendPick = async () => {
+      const formData = new FormData()
+      formData.append("option_id", String(optionId))
+      formData.append("client_seq", String(seq))
+
+      return fetch(this.answerUrlValue, {
+        method: "POST",
+        body: formData,
+        credentials: "same-origin",
+        headers: {
+          "X-CSRF-Token": this.csrfToken(),
+          "X-Quizzy-Async": "1",
+          Accept: "application/json"
+        }
+      })
+    }
+
+    try {
+      let res
+      try {
+        res = await sendPick()
+      } catch (_firstErr) {
+        // Automatic 1x retry on flaky conference Wi-Fi
+        res = await sendPick()
+      }
+
+      if (!res.ok) return
+      const json = await res.json()
+
+      if (seq < this.latestConfirmedSeq) {
+        return
+      }
+      this.latestConfirmedSeq = seq
+
+      if (json.state) {
+        if (typeof json.state.version === "number" && json.state.version >= this.lastVersion) {
+          this.lastVersion = json.state.version
+        }
+        if (json.state.question) {
+          this.pickedByQuestion[json.state.question.id] = json.state.question.picked_option_id
+        }
+        this.state = json.state
+        if (this.phaseKey(this.state) !== this.renderedPhaseKey) {
+          this.renderPhase(this.state)
+          this.renderedPhaseKey = this.phaseKey(this.state)
+        } else if (this.state.status === "question_open" && this.state.question?.id === questionId) {
+          this.updatePickedMark(this.pickedByQuestion[questionId] ?? null)
+        }
+      }
+    } catch (_err) {
+      await this.syncState()
+    }
+  }
+
+  renderIfNeeded() {
+    const nextKey = this.phaseKey(this.state)
+    if (nextKey !== this.renderedPhaseKey) {
+      this.renderPhase(this.state)
+      this.renderedPhaseKey = nextKey
+    } else if (this.state.joined && this.state.status === "question_open" && this.state.question) {
+      const picked = this.pickedByQuestion[this.state.question.id] ?? null
+      this.updatePickedMark(picked)
+    }
+  }
+
+  updatePickedMark(pickedOptionId) {
+    const buttons = this.questionOptionsTarget.querySelectorAll(".play-option")
+    buttons.forEach((btn) => {
+      const optId = Number(btn.dataset.optionId)
+      const isPicked = pickedOptionId != null && optId === pickedOptionId
+      btn.classList.toggle("is-picked", isPicked)
+
+      const existingMark = btn.querySelector(".play-option__mark")
+      if (isPicked) {
+        if (!existingMark) {
+          btn.appendChild(document.createTextNode(" "))
+          const mark = document.createElement("span")
+          mark.className = "play-option__mark"
+          mark.textContent = "Your answer"
+          btn.appendChild(mark)
+        }
+      } else if (existingMark) {
+        if (existingMark.previousSibling?.nodeType === Node.TEXT_NODE && existingMark.previousSibling.textContent === " ") {
+          existingMark.previousSibling.remove()
+        }
+        existingMark.remove()
+      }
+    })
+  }
+
+  renderPhase(state) {
+    const status = state.status
+    const joined = Boolean(state.joined)
+    const question = state.question
+
+    const showJoin = !joined && status !== "finished"
+    const showWaiting = joined && status === "lobby"
+    const showQuestion = joined && (status === "question_open" || status === "question_closed") && Boolean(question)
+    const showFinished = status === "finished"
+
+    this.headerNameTarget.textContent = joined ? (state.player_name || "") : (state.quiz_title || "")
+    this.bodyContainerTarget.className = showQuestion ? "play__body play__body--top" : "play__body"
+
+    if (this.hasJoinViewTarget) {
+      if (!showJoin) {
+        this.joinViewTarget.remove()
+      } else {
+        this.joinViewTarget.hidden = false
+      }
+    }
+    if (this.hasWaitingViewTarget) {
+      this.waitingViewTarget.hidden = !showWaiting
+    }
+    if (this.hasQuestionViewTarget) {
+      this.questionViewTarget.hidden = !showQuestion
+    }
+    this.finishedViewTarget.hidden = !showFinished
+
+    if (showWaiting) {
+      this.greetingTarget.textContent = `Hi, ${state.player_name}!`
+    }
+
+    if (showQuestion && question) {
+      const closed = status === "question_closed"
+      const pickedId =
+        this.pickedByQuestion[question.id] !== undefined
+          ? this.pickedByQuestion[question.id]
+          : (question.picked_option_id ?? null)
+
+      this.questionProgressTarget.textContent = `Question ${question.position} of ${question.total}`
+      this.questionBodyTarget.textContent = question.body
+
+      this.questionOptionsTarget.className = closed
+        ? "play-options is-locked is-revealed"
+        : "play-options"
+      this.questionOptionsTarget.replaceChildren()
+
+      question.options.forEach((opt, idx) => {
+        const isPicked = pickedId != null && opt.id === pickedId
+        const isCorrect = closed && Boolean(opt.correct)
+
+        const btn = document.createElement("button")
+        btn.type = "button"
+        btn.className = "play-option"
+        if (isPicked) btn.classList.add("is-picked")
+        if (isCorrect) btn.classList.add("is-correct")
+        btn.title = opt.text
+        btn.dataset.optionId = String(opt.id)
+        btn.dataset.action = "click->play#pick"
+        if (closed) btn.disabled = true
+
+        const letter = document.createElement("span")
+        letter.className = "play-option__letter"
+        letter.textContent = this.optionLetter(idx)
+        btn.appendChild(letter)
+        btn.appendChild(document.createTextNode(" "))
+
+        const title = document.createElement("span")
+        title.className = "play-option__title"
+        title.textContent = opt.text
+        btn.appendChild(title)
+
+        if (isPicked) {
+          btn.appendChild(document.createTextNode(" "))
+          const mark = document.createElement("span")
+          mark.className = "play-option__mark"
+          mark.textContent = "Your answer"
+          btn.appendChild(mark)
+        }
+
+        this.questionOptionsTarget.appendChild(btn)
+      })
+
+      if (closed) {
+        const pickedOpt = question.options.find((o) => o.id === pickedId)
+        this.questionFeedbackTarget.hidden = false
+        if (!pickedOpt) {
+          this.questionFeedbackTarget.className = "play-status play-status--neutral"
+          this.questionFeedbackTarget.textContent = "No answer"
+        } else if (pickedOpt.correct) {
+          this.questionFeedbackTarget.className = "play-status play-status--right"
+          this.questionFeedbackTarget.textContent = "Correct!"
+        } else {
+          this.questionFeedbackTarget.className = "play-status play-status--wrong"
+          this.questionFeedbackTarget.textContent = "Wrong!"
+        }
+      } else {
+        this.questionFeedbackTarget.hidden = true
+        this.questionFeedbackTarget.textContent = ""
+      }
+    }
+  }
+}
diff --git a/app/models/game.rb b/app/models/game.rb
new file mode 100644
index 0000000..763cebe
--- /dev/null
+++ b/app/models/game.rb
@@ -0,0 +1,376 @@
+class Game < ApplicationRecord
+  CODE_ALPHABET = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ".chars.freeze
+  CODE_LENGTH = 5
+  STATUSES = %w[lobby question_open question_closed finished].freeze
+
+  belongs_to :quiz
+  has_many :game_questions, -> { order(:position, :id) }, dependent: :destroy
+  has_many :players, dependent: :destroy
+
+  before_validation :assign_unique_code, on: :create
+
+  validates :code, presence: true, uniqueness: true
+  validates :status, inclusion: { in: STATUSES }
+
+  def lobby?
+    status == "lobby"
+  end
+
+  def question_open?
+    status == "question_open"
+  end
+
+  def question_closed?
+    status == "question_closed"
+  end
+
+  def finished?
+    status == "finished"
+  end
+
+  def current_game_question
+    return nil if lobby? || finished?
+
+    game_questions.includes(:game_options).find_by(position: current_question_index + 1)
+  end
+
+  def online_player_ids
+    players.currently_online.pluck(:id)
+  end
+
+  def active_players_count
+    players.currently_online.count
+  end
+
+  def join_url(fallback_base_url = nil)
+    effective_base = fallback_base_url.presence || base_url.presence || "http://localhost:3000"
+    "#{effective_base.sub(%r{/\z}, '')}/play/#{code}"
+  end
+
+  def qr_svg(fallback_base_url = nil)
+    qrcode = RQRCode::QRCode.new(join_url(fallback_base_url))
+    qrcode.as_svg(
+      color: "000000",
+      fill: "ffffff",
+      shape_rendering: "crispEdges",
+      module_size: 8,
+      offset: 16,
+      standalone: true,
+      use_path: true,
+      viewbox: true,
+      svg_attributes: {
+        role: "img",
+        "aria-label" => "QR code"
+      }
+    ).sub(/\A<\?xml[^?]*\?>\s*/, "").html_safe
+  end
+
+  def stream_token
+    Rails.application.message_verifier(:moderate_game).generate(id)
+  end
+
+  def self.find_by_stream_token(token)
+    game_id = Rails.application.message_verifier(:moderate_game).verified(token)
+    find_by(id: game_id) if game_id.present?
+  end
+
+  def start!
+    changed = false
+    with_lock do
+      next unless lobby?
+
+      active_qs = quiz.active_questions.includes(:options).to_a
+      now = Time.current
+
+      if active_qs.empty?
+        update!(
+          status: "finished",
+          started_at: now,
+          finished_at: now,
+          state_version: state_version + 1
+        )
+      else
+        active_qs.each_with_index do |q, q_idx|
+          gq = game_questions.create!(
+            question_id: q.id,
+            body: q.body,
+            position: q_idx + 1
+          )
+          q.options.each_with_index do |opt, o_idx|
+            gq.game_options.create!(
+              option_id: opt.id,
+              text: opt.text,
+              correct: opt.correct?,
+              position: o_idx + 1
+            )
+          end
+        end
+
+        update!(
+          status: "question_open",
+          current_question_index: 0,
+          started_at: now,
+          question_opened_at: now,
+          question_closed_at: nil,
+          state_version: state_version + 1
+        )
+      end
+      changed = true
+    end
+
+    broadcast_all! if changed
+    changed
+  end
+
+  def finish_question!
+    changed = false
+    with_lock do
+      next unless question_open?
+
+      update!(
+        status: "question_closed",
+        question_closed_at: Time.current,
+        state_version: state_version + 1
+      )
+      changed = true
+    end
+
+    broadcast_all! if changed
+    changed
+  end
+
+  def next_question!
+    changed = false
+    with_lock do
+      next unless question_closed?
+
+      total = game_questions.count
+      next if current_question_index + 1 >= total
+
+      update!(
+        status: "question_open",
+        current_question_index: current_question_index + 1,
+        question_opened_at: Time.current,
+        question_closed_at: nil,
+        state_version: state_version + 1
+      )
+      changed = true
+    end
+
+    broadcast_all! if changed
+    changed
+  end
+
+  def end_quiz!
+    changed = false
+    with_lock do
+      next if finished?
+
+      update!(
+        status: "finished",
+        finished_at: Time.current,
+        state_version: state_version + 1
+      )
+      changed = true
+    end
+
+    broadcast_all! if changed
+    changed
+  end
+
+  def submit_answer!(player:, option_id:, client_seq: 0)
+    result = nil
+    gq = nil
+
+    with_lock do
+      if !question_open? || player.nil? || player.game_id != id
+        result = { accepted: false }
+        next
+      end
+
+      gq = current_game_question
+      if gq.nil?
+        result = { accepted: false }
+        next
+      end
+
+      option = gq.game_options.find { |o| o.id == option_id.to_i }
+      if option.nil?
+        result = { accepted: false }
+        next
+      end
+
+      answer = gq.game_answers.find_or_initialize_by(player_id: player.id)
+      seq = client_seq.to_i
+
+      if answer.persisted? && seq > 0 && answer.client_seq > 0 && seq < answer.client_seq
+        result = { accepted: true, question_id: gq.id, picked_option_id: answer.game_option_id }
+        next
+      end
+
+      answer.game_option_id = option.id
+      answer.client_seq = [ seq, answer.client_seq.to_i ].max
+      answer.answered_at = Time.current
+      answer.save!
+
+      update_columns(state_version: state_version + 1, updated_at: Time.current)
+      result = { accepted: true, question_id: gq.id, picked_option_id: option.id }
+    end
+
+    if result[:accepted]
+      broadcast_moderator!
+      ActionCable.server.broadcast(
+        "play_player_#{player.token}",
+        {
+          type: "player_answer",
+          version: state_version,
+          question_id: result[:question_id],
+          picked_option_id: result[:picked_option_id]
+        }
+      )
+    end
+
+    result
+  end
+
+  def bump_version_and_broadcast_moderator!
+    with_lock do
+      update_columns(state_version: state_version + 1, updated_at: Time.current)
+    end
+    broadcast_moderator!
+  end
+
+  def moderator_payload(fallback_base_url: nil)
+    reload_online_ids = online_player_ids
+    online_count = reload_online_ids.size
+
+    payload = {
+      version: state_version,
+      id: id,
+      code: code,
+      status: status,
+      quiz_title: quiz.title,
+      join_url: join_url(fallback_base_url),
+      active_players_count: online_count
+    }
+
+    if question_open? || question_closed?
+      gq = current_game_question
+      if gq
+        total = game_questions.count
+        opts = gq.game_options.to_a
+
+        if question_open?
+          answered_count = reload_online_ids.empty? ? 0 : gq.game_answers.where(player_id: reload_online_ids).count
+          payload[:question] = {
+            id: gq.id,
+            position: gq.position,
+            total: total,
+            last_question: gq.position == total,
+            body: gq.body,
+            answered_count: answered_count,
+            options: opts.map { |opt| { id: opt.id, text: opt.text } }
+          }
+        else
+          counts_by_option = gq.game_answers.group(:game_option_id).count
+          total_answers = counts_by_option.values.sum
+          payload[:question] = {
+            id: gq.id,
+            position: gq.position,
+            total: total,
+            last_question: gq.position == total,
+            body: gq.body,
+            total_answers: total_answers,
+            options: opts.map do |opt|
+              {
+                id: opt.id,
+                text: opt.text,
+                correct: opt.correct?,
+                answers_count: counts_by_option.fetch(opt.id, 0)
+              }
+            end
+          }
+        end
+      end
+    end
+
+    payload
+  end
+
+  def play_broadcast_payload
+    payload = {
+      type: "game_state",
+      version: state_version,
+      code: code,
+      quiz_title: quiz.title,
+      status: status
+    }
+
+    if question_open? || question_closed?
+      gq = current_game_question
+      if gq
+        total = game_questions.count
+        payload[:question] = {
+          id: gq.id,
+          position: gq.position,
+          total: total,
+          body: gq.body,
+          options: gq.game_options.to_a.map do |opt|
+            item = { id: opt.id, text: opt.text }
+            item[:correct] = opt.correct? if question_closed?
+            item
+          end
+        }
+      end
+    end
+
+    payload
+  end
+
+  def player_state_payload(player)
+    base = play_broadcast_payload.except(:type)
+
+    if player.present? && player.game_id == id
+      base[:joined] = true
+      base[:player_name] = player.name
+      base[:player_token] = player.token
+
+      if base[:question].present?
+        picked_id = GameAnswer.where(game_question_id: base[:question][:id], player_id: player.id).pick(:game_option_id)
+        base[:question] = base[:question].merge(picked_option_id: picked_id)
+      end
+    else
+      base[:joined] = false
+      base.delete(:question) unless finished?
+    end
+
+    base
+  end
+
+  def broadcast_moderator!
+    ActionCable.server.broadcast("moderate_game_#{id}", moderator_payload)
+  end
+
+  def broadcast_players!
+    ActionCable.server.broadcast("play_game_#{code}", play_broadcast_payload)
+  end
+
+  def broadcast_all!
+    broadcast_moderator!
+    broadcast_players!
+  end
+
+  private
+
+  def assign_unique_code
+    return if code.present?
+
+    loop do
+      candidate = Array.new(CODE_LENGTH) { CODE_ALPHABET.sample }.join
+      unless self.class.exists?(code: candidate)
+        self.code = candidate
+        break
+      end
+    end
+  end
+end
