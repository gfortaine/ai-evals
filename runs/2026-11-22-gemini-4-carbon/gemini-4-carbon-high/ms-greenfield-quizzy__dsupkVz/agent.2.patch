diff --git a/test/models/quiz_export_and_import_test.rb b/test/models/quiz_export_and_import_test.rb
new file mode 100644
index 0000000..29ef926
--- /dev/null
+++ b/test/models/quiz_export_and_import_test.rb
@@ -0,0 +1,234 @@
+require "test_helper"
+
+class QuizExportAndImportTest < ActiveSupport::TestCase
+  test "export writes exact keys, always writes active and correct, and preserves question and option order" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+
+    q1 = quiz.questions.new
+    q1.save_with_option_rows(
+      { body: "Which HTTP status code means \"Too Many Requests\"?", active: true },
+      {
+        "0" => { text: "418", correct: "0" },
+        "1" => { text: "429", correct: "1" },
+        "2" => { text: "503", correct: "0" }
+      }
+    )
+
+    q2 = quiz.questions.new
+    q2.save_with_option_rows(
+      { body: "Draft question?", active: false },
+      {
+        "0" => { text: "Yes", correct: "1" },
+        "1" => { text: "Also yes", correct: "1" }
+      }
+    )
+
+    # Reorder so q2 is first, q1 is second
+    q2.move_up!
+
+    parsed = JSON.parse(quiz.reload.to_export_json)
+
+    assert_equal [ "questions", "title" ], parsed.keys.sort
+    assert_equal "Frontend Fest 2026", parsed["title"]
+    assert_equal 2, parsed["questions"].size
+
+    first_q = parsed["questions"][0]
+    assert_equal [ "active", "options", "text" ], first_q.keys.sort
+    assert_equal "Draft question?", first_q["text"]
+    assert_equal false, first_q["active"]
+    assert_equal [
+      { "text" => "Yes", "correct" => true },
+      { "text" => "Also yes", "correct" => true }
+    ], first_q["options"]
+    first_q["options"].each do |opt|
+      assert_equal [ "correct", "text" ], opt.keys.sort
+    end
+
+    second_q = parsed["questions"][1]
+    assert_equal [ "active", "options", "text" ], second_q.keys.sort
+    assert_equal "Which HTTP status code means \"Too Many Requests\"?", second_q["text"]
+    assert_equal true, second_q["active"]
+    assert_equal [
+      { "text" => "418", "correct" => false },
+      { "text" => "429", "correct" => true },
+      { "text" => "503", "correct" => false }
+    ], second_q["options"]
+  end
+
+  test "import applies defaults for active and correct, keeps order, and always creates a new quiz on duplicate title" do
+    existing = Quiz.create!(title: "Frontend Fest 2026")
+
+    raw_json = <<~JSON
+      {
+        "title": "  Frontend Fest 2026  ",
+        "questions": [
+          {
+            "text": "Default active question",
+            "options": [
+              {"text": "First wrong"},
+              {"text": "Second correct", "correct": true},
+              {"text": "Third explicit wrong", "correct": false}
+            ]
+          },
+          {
+            "text": "Inactive multi-correct question",
+            "active": false,
+            "options": [
+              {"text": "Alpha", "correct": true},
+              {"text": "Beta"},
+              {"text": "Gamma", "correct": true}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    importer = Quiz::Import.new(raw_json)
+    assert importer.save, -> { "Expected import to succeed, got errors: #{importer.errors.inspect}" }
+
+    imported = importer.quiz
+    assert_not_equal existing.id, imported.id
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+
+    questions = imported.questions.includes(:options).to_a
+    assert_equal [ "Default active question", "Inactive multi-correct question" ], questions.map(&:body)
+    assert_equal [ true, false ], questions.map(&:active?)
+    assert_equal [ 1, 2 ], questions.map(&:position)
+
+    assert_equal [ "First wrong", "Second correct", "Third explicit wrong" ], questions[0].options.map(&:text)
+    assert_equal [ false, true, false ], questions[0].options.map(&:correct?)
+    assert_equal [ 1, 2, 3 ], questions[0].options.map(&:position)
+
+    assert_equal [ "Alpha", "Beta", "Gamma" ], questions[1].options.map(&:text)
+    assert_equal [ true, false, true ], questions[1].options.map(&:correct?)
+    assert_equal [ 1, 2, 3 ], questions[1].options.map(&:position)
+  end
+
+  test "exporting and importing an empty quiz with zero questions succeeds" do
+    empty_quiz = Quiz.create!(title: "Empty Quiz")
+    exported = empty_quiz.to_export_json
+    assert_equal({ "title" => "Empty Quiz", "questions" => [] }, JSON.parse(exported))
+
+    importer = Quiz::Import.new(exported)
+    assert importer.save
+    assert_equal "Empty Quiz", importer.quiz.title
+    assert_equal 0, importer.quiz.questions.count
+    assert_equal 2, Quiz.count
+  end
+
+  test "invalid JSON or rule violations fail atomically without importing quiz or partial questions" do
+    invalid_payloads = [
+      "",
+      "   ",
+      "{not valid json",
+      "[]",
+      "\"just a string\"",
+      "123",
+      "null",
+      # Missing or blank or non-string title
+      JSON.generate({ questions: [] }),
+      JSON.generate({ title: "   ", questions: [] }),
+      JSON.generate({ title: 123, questions: [] }),
+      JSON.generate({ title: nil, questions: [] }),
+      # Missing or non-array questions
+      JSON.generate({ title: "Valid Title" }),
+      JSON.generate({ title: "Valid Title", questions: nil }),
+      JSON.generate({ title: "Valid Title", questions: {} }),
+      # Non-object question
+      JSON.generate({ title: "Valid Title", questions: [ "not an object" ] }),
+      # Blank or missing or non-string question text
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { text: "   ", options: [ { text: "A", correct: true }, { text: "B" } ] } ]
+      }),
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { options: [ { text: "A", correct: true }, { text: "B" } ] } ]
+      }),
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { text: 42, options: [ { text: "A", correct: true }, { text: "B" } ] } ]
+      }),
+      # Non-boolean active
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { text: "Q?", active: "yes", options: [ { text: "A", correct: true }, { text: "B" } ] } ]
+      }),
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { text: "Q?", active: nil, options: [ { text: "A", correct: true }, { text: "B" } ] } ]
+      }),
+      # Missing or non-array options
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { text: "Q?" } ]
+      }),
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { text: "Q?", options: "nope" } ]
+      }),
+      # Fewer than 2 options
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { text: "Q?", options: [ { text: "Only one", correct: true } ] } ]
+      }),
+      # Blank or missing or non-string option text
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { text: "Q?", options: [ { text: "A", correct: true }, { text: "   ", correct: false } ] } ]
+      }),
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { text: "Q?", options: [ { text: "A", correct: true }, { text: "B", correct: false }, { text: "", correct: false } ] } ]
+      }),
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { text: "Q?", options: [ { text: "A", correct: true }, { correct: false } ] } ]
+      }),
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { text: "Q?", options: [ { text: "A", correct: true }, { text: 999, correct: false } ] } ]
+      }),
+      # Non-boolean correct
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { text: "Q?", options: [ { text: "A", correct: "true" }, { text: "B", correct: false } ] } ]
+      }),
+      # Zero correct options (both explicit false and omitted default false)
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { text: "Q?", options: [ { text: "A", correct: false }, { text: "B", correct: false } ] } ]
+      }),
+      JSON.generate({
+        title: "Valid Title",
+        questions: [ { text: "Q?", options: [ { text: "A" }, { text: "B" } ] } ]
+      }),
+      # First question valid, second question invalid -> NOTHING may be imported!
+      JSON.generate({
+        title: "Partial Failure Quiz",
+        questions: [
+          {
+            text: "Valid Q1?",
+            active: true,
+            options: [ { text: "Yes", correct: true }, { text: "No", correct: false } ]
+          },
+          {
+            text: "Broken Q2?",
+            active: true,
+            options: [ { text: "Yes", correct: false }, { text: "No", correct: false } ]
+          }
+        ]
+      })
+    ]
+
+    invalid_payloads.each do |payload|
+      importer = Quiz::Import.new(payload)
+      assert_not importer.save, "Expected payload to fail import: #{payload.inspect}"
+      assert_not_empty importer.errors, "Expected errors for payload: #{payload.inspect}"
+      assert_nil importer.quiz
+      assert_equal 0, Quiz.count, "Quiz was leaked for payload: #{payload.inspect}"
+      assert_equal 0, Question.count, "Question was leaked for payload: #{payload.inspect}"
+      assert_equal 0, Option.count, "Option was leaked for payload: #{payload.inspect}"
+    end
+  end
+end
