+require "application_system_test_case"
+
+class QuizExportAndImportTest < ApplicationSystemTestCase
+  test "exporting a quiz from its page and importing it as a duplicate-title copy" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+
+    q1 = quiz.questions.new
+    q1.save_with_option_rows(
+      { body: "Which HTTP status code means \"Too Many Requests\"?", active: true },
+      {
+        "0" => { text: "418", correct: "0" },
+        "1" => { text: "429", correct: "1" }
+      }
+    )
+
+    q2 = quiz.questions.new
+    q2.save_with_option_rows(
+      { body: "Which tag embeds <script> & \"code\"?", active: false },
+      {
+        "0" => { text: "<script>", correct: "1" },
+        "1" => { text: "<style>", correct: "0" },
+        "2" => { text: "<link>", correct: "0" }
+      }
+    )
+
+    visit_moderate "/moderate/quizzes/#{quiz.id}"
+    click_link "Export"
+
+    # Exactly one <pre> on the page containing the exact JSON
+    assert_selector "pre", count: 1
+    exported_text = find("pre").text
+    parsed = JSON.parse(exported_text)
+
+    assert_equal(
+      {
+        "title" => "Frontend Fest 2026",
+        "questions" => [
+          {
+            "text" => "Which HTTP status code means \"Too Many Requests\"?",
+            "active" => true,
+            "options" => [
+              { "text" => "418", "correct" => false },
+              { "text" => "429", "correct" => true }
+            ]
+          },
+          {
+            "text" => "Which tag embeds <script> & \"code\"?",
+            "active" => false,
+            "options" => [
+              { "text" => "<script>", "correct" => true },
+              { "text" => "<style>", "correct" => false },
+              { "text" => "<link>", "correct" => false }
+            ]
+          }
+        ]
+      },
+      parsed
+    )
+
+    # Go to /moderate and import the exported JSON even though "Frontend Fest 2026" already exists
+    visit_moderate "/moderate"
+    click_button "Import quiz"
+
+    fill_in "Quiz JSON", with: exported_text
+    click_button "Import"
+
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+    new_quiz = Quiz.order(:id).last
+    assert_not_equal quiz.id, new_quiz.id
+    assert_current_path "/moderate/quizzes/#{new_quiz.id}"
+
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_text "1 of 2 questions active"
+    assert_link "Export"
+
+    items = all("ol.question-list > li")
+    assert_equal 2, items.size
+    assert_includes items[0].text, "Which HTTP status code means \"Too Many Requests\"?"
+    assert_includes items[1].text, "Which tag embeds <script> & \"code\"?"
+
+    within(items[0]) do
+      assert_checked_field "Active"
+      assert_selector ".is-correct", text: "429"
+    end
+
+    within(items[1]) do
+      assert_unchecked_field "Active"
+      assert_selector ".is-correct", text: "<script>"
+    end
+
+    # Both quizzes appear on /moderate in their own list items
+    visit_moderate "/moderate"
+    assert_selector "ul.quiz-list > li", text: "Frontend Fest 2026", count: 2
+  end
+
+  test "importing with omitted optional fields, handling errors atomically, and previewing imported quiz" do
+    visit_moderate "/moderate"
+    click_button "Import quiz"
+
+    # 1. Invalid JSON shows error and keeps input
+    fill_in "Quiz JSON", with: "{invalid json"
+    click_button "Import"
+
+    assert_selector ".errors"
+    assert_field "Quiz JSON", with: "{invalid json"
+    assert_equal 0, Quiz.count
+
+    # 2. Multi-question JSON where Q2 breaks a rule -> error shown, NOTHING imported
+    broken_json = <<~JSON
+      {
+        "title": "RubyConf 2026",
+        "questions": [
+          {
+            "text": "Valid first question?",
+            "options": [
+              {"text": "Right", "correct": true},
+              {"text": "Wrong"}
+            ]
+          },
+          {
+            "text": "Broken second question without correct option?",
+            "options": [
+              {"text": "Option A"},
+              {"text": "Option B"}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    fill_in "Quiz JSON", with: broken_json
+    click_button "Import"
+
+    assert_selector ".errors", text: "Mark at least one option as correct"
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+    assert_equal 0, Option.count
+
+    # 3. Valid JSON using default active (true) and default correct (false)
+    valid_json = <<~JSON
+      {
+        "title": "RubyConf 2026",
+        "questions": [
+          {
+            "text": "Valid first question?",
+            "options": [
+              {"text": "Wrong"},
+              {"text": "Right", "correct": true}
+            ]
+          },
+          {
+            "text": "Skipped inactive question?",
+            "active": false,
+            "options": [
+              {"text": "One", "correct": true},
+              {"text": "Two"}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    fill_in "Quiz JSON", with: valid_json
+    click_button "Import"
+
+    assert_selector "h1", text: "RubyConf 2026"
+    assert_text "1 of 2 questions active"
+
+    click_link "Preview"
+    assert_text "Question 1 of 1"
+    assert_text "Valid first question?"
+    click_button "Right"
+    assert_text "Correct!"
+    click_button "See score"
+    assert_text "Score: 1/1"
+  end
+end
