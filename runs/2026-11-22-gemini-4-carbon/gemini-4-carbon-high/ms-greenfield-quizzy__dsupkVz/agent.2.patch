+<% content_for :title, "Quizzy · Import quiz" %>
+
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<div class="page-head">
+  <h1>Import quiz</h1>
+</div>
+
+<div class="card">
+  <%= form_with url: import_moderate_quizzes_path, method: :post do |f| %>
+    <% if @import.errors.any? %>
+      <div class="errors" role="alert">
+        <% if @import.errors.size == 1 %>
+          <%= @import.errors.first %>
+        <% else %>
+          <ul>
+            <% @import.errors.each do |message| %>
+              <li><%= message %></li>
+            <% end %>
+          </ul>
+        <% end %>
+      </div>
+    <% end %>
+
+    <div class="field">
+      <%= label_tag :quiz_json, "Quiz JSON", class: "field-label" %>
+      <%= text_area_tag :quiz_json, @import.raw_json, rows: 14, class: "input input--code", autofocus: true %>
+    </div>
+
+    <div class="buttons">
+      <%= f.button "Import", type: "submit", class: "btn btn--pink" %>
+      <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+    </div>
+  <% end %>
+</div>
