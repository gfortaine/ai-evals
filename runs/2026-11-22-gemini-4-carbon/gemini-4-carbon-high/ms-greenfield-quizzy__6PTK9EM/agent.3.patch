diff --git a/app/views/games/show.html.erb b/app/views/games/show.html.erb
new file mode 100644
index 0000000..adb465e
--- /dev/null
+++ b/app/views/games/show.html.erb
@@ -0,0 +1,105 @@
+<% content_for :title, "Quizzy · #{@quiz.title}" %>
+
+<div class="play"
+     data-controller="play-game"
+     data-play-game-code-value="<%= @game.code %>"
+     data-play-game-joined-value="<%= @state[:joined] %>"
+     data-play-game-player-name-value="<%= @state[:player_name].to_s %>"
+     data-play-game-quiz-title-value="<%= @state[:quiz_title] %>"
+     data-play-game-state-url-value="<%= state_play_game_path(@game.code) %>"
+     data-play-game-answer-url-value="<%= answer_play_game_path(@game.code) %>"
+     data-play-game-status-value="<%= @state[:status] %>"
+     data-play-game-game-question-id-value="<%= @state[:game_question_id].to_i %>"
+     data-play-game-picked-option-id-value="<%= @state[:picked_option_id].to_i %>"
+     data-play-game-version-value="<%= @state[:state_version] %>">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span data-play-game-target="headerInfo"><%= (@state[:joined] && @state[:status] != "lobby") ? "Hi, #{@state[:player_name]}!" : @state[:quiz_title] %></span>
+  </div>
+
+  <% body_top = @state[:joined] && (@state[:status] == "question_open" || @state[:status] == "question_closed") %>
+  <div class="play__body <%= 'play__body--top' if body_top %>" data-play-game-target="body">
+    <% if @state[:status] == "finished" %>
+      <div class="waiting">
+        <h1 class="play-title">The quiz is over</h1>
+      </div>
+    <% elsif !@state[:joined] %>
+      <h1 class="play-title"><%= @state[:quiz_title] %></h1>
+      <% if @join_error.present? %>
+        <div class="errors"><%= @join_error %></div>
+      <% end %>
+      <%= form_with url: join_play_game_path(@game.code), method: :post, class: "join-form", data: { turbo: false } do %>
+        <label class="field-label" for="player_name" style="text-align: center">Your name</label>
+        <input id="player_name"
+               name="name"
+               type="text"
+               class="input"
+               placeholder="Your name"
+               value="<%= @submitted_name %>"
+               required
+               autofocus
+               autocomplete="nickname">
+        <button type="submit" class="btn btn--pink">Join</button>
+      <% end %>
+    <% elsif @state[:status] == "lobby" %>
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h1 class="play-title">Hi, <%= @state[:player_name] %>!</h1>
+        <p class="play-lead">Waiting for the quiz to start…</p>
+      </div>
+    <% elsif @state[:status] == "question_open" %>
+      <div class="play-question__num">Question <%= @state[:question_number] %> of <%= @state[:total_questions] %></div>
+      <div class="play-question__body"><%= @state[:question_body] %></div>
+      <ul class="play-options">
+        <% @state[:options].each do |opt| %>
+          <% picked = (@state[:picked_option_id] == opt[:id]) %>
+          <li>
+            <%= form_with url: answer_play_game_path(@game.code), method: :post, data: { turbo: false, action: "submit->play-game#pickOption" } do %>
+              <%= hidden_field_tag :game_question_id, @state[:game_question_id] %>
+              <%= hidden_field_tag :option_id, opt[:id] %>
+              <button type="submit"
+                      class="play-option <%= 'is-picked' if picked %>"
+                      data-option-id="<%= opt[:id] %>"
+                      aria-pressed="<%= picked %>">
+                <span class="play-option__letter" aria-hidden="true"><%= opt[:letter] %></span>
+                <span class="play-option__title"><%= opt[:body] %></span>
+                <% if picked %>
+                  <span class="play-option__mark">Your answer</span>
+                <% end %>
+              </button>
+            <% end %>
+          </li>
+        <% end %>
+      </ul>
+    <% elsif @state[:status] == "question_closed" %>
+      <div class="play-question__num">Question <%= @state[:question_number] %> of <%= @state[:total_questions] %></div>
+      <div class="play-question__body"><%= @state[:question_body] %></div>
+      <ul class="play-options is-locked is-revealed">
+        <% picked_opt = nil %>
+        <% @state[:options].each do |opt| %>
+          <% picked = (@state[:picked_option_id] == opt[:id]) %>
+          <% picked_opt = opt if picked %>
+          <% classes = [ "play-option" ] %>
+          <% classes << "is-picked" if picked %>
+          <% classes << "is-correct" if opt[:correct] %>
+          <li>
+            <button type="button" class="<%= classes.join(' ') %>" disabled>
+              <span class="play-option__letter" aria-hidden="true"><%= opt[:letter] %></span>
+              <span class="play-option__title"><%= opt[:body] %></span>
+              <% if picked %>
+                <span class="play-option__mark">Your answer</span>
+              <% end %>
+            </button>
+          </li>
+        <% end %>
+      </ul>
+      <% if picked_opt.nil? %>
+        <div class="play-status play-status--neutral">No answer</div>
+      <% elsif picked_opt[:correct] %>
+        <div class="play-status play-status--right">Correct!</div>
+      <% else %>
+        <div class="play-status play-status--wrong">Wrong!</div>
+      <% end %>
+    <% end %>
+  </div>
+</div>
