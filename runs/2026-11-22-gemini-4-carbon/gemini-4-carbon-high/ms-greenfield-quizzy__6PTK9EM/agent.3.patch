+module Moderate
+  class GamesController < BaseController
+    before_action :set_quiz
+    before_action :set_game, except: [ :create ]
+
+    def create
+      @game = @quiz.games.create!
+      redirect_to moderate_quiz_game_path(@quiz, @game), status: :see_other
+    end
+
+    def show
+      @join_url = "#{request.base_url}#{play_game_path(@game.code)}"
+      @moderator_token = @game.moderator_token
+      @state = @game.moderator_state_payload
+    end
+
+    def state
+      render json: @game.moderator_state_payload
+    end
+
+    def start
+      @game.start!
+      respond_with_moderator_state
+    end
+
+    def finish
+      @game.finish_question!
+      respond_with_moderator_state
+    end
+
+    def next_question
+      @game.next_question!
+      respond_with_moderator_state
+    end
+
+    def end_quiz
+      @game.end_quiz!
+      respond_with_moderator_state
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_game
+      @game = @quiz.games.find(params[:id])
+    end
+
+    def respond_with_moderator_state
+      if json_request?
+        render json: @game.reload.moderator_state_payload
+      else
+        redirect_to moderate_quiz_game_path(@quiz, @game), status: :see_other
+      end
+    end
+
+    def json_request?
+      request.accept&.include?("application/json") || request.xhr?
+    end
+  end
+end
