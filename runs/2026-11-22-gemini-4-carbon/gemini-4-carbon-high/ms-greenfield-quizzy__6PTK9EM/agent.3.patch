     index < 26 ? ("A".ord + index).chr : (index + 1).to_s
   end
+
+  def render_qr_svg(url)
+    svg = RQRCode::QRCode.new(url).as_svg(
+      color: "000",
+      fill: "fff",
+      shape_rendering: "crispEdges",
+      module_size: 8,
