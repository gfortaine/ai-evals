+      <% elsif @state[:status] == "question_closed" %>
+        <% if @state[:is_last_question] %>
+          <%= form_with url: end_quiz_moderate_quiz_game_path(@quiz, @game), method: :post, data: { turbo: false, action: "submit->moderator-game#submitAction" } do %>
