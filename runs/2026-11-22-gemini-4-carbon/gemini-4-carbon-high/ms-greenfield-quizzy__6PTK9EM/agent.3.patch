+  end
+
+  test "reopening join link mid-question preserves player pick and conference Wi-Fi fallback recovers when WebSocket drops" do
+    special_quiz = Quiz.create!(title: "Types <T> & Perf")
+    create_question(special_quiz, "What is Array<string> & Record<K, V>?", active: true, options: [
+      { body: "Intersection <type>", correct: true },
+      { body: "Union | <script>alert(1)</script>", correct: false }
+    ])
+
+    join_url = nil
+
+    Capybara.using_session(:moderator) do
+      authorize_moderator!
+      visit moderate_quiz_path(special_quiz)
+      click_button "Start a game"
+      join_url = find(".lobby__url").text
+    end
+
+    Capybara.using_session(:alice) do
+      visit join_url
+      fill_in "Your name", with: "O'Connor <Dev>"
+      click_button "Join"
+      assert_text "Hi, O'Connor <Dev>!"
+
+      # Simulate conference Wi-Fi dropping the WebSocket connection
+      page.execute_script(<<~JS)
+        const el = document.querySelector('[data-controller="play-game"]')
+        const ctrl = window.Stimulus.getControllerForElementAndIdentifier(el, "play-game")
+        ctrl.teardownCable()
+      JS
+      mark_no_reload!
+    end
+
+    Capybara.using_session(:moderator) do
+      click_button "Start"
+      assert_text "Question 1 of 1"
+      assert_text "What is Array<string> & Record<K, V>?"
+    end
+
+    # Even with WebSocket dropped, phone fallback poll catches up without reload
+    Capybara.using_session(:alice) do
+      assert_text "What is Array<string> & Record<K, V>?", wait: 5
+      assert_no_reload!
+
+      click_button "Intersection <type>"
+      within("button", text: /Intersection <type>/) do
+        assert_text "Your answer"
+      end
+
+      # Opening join link again in the same browser remembers player and their current pick
+      visit join_url
+      assert_text "Hi, O'Connor <Dev>!"
+      within("button", text: /Intersection <type>/) do
+        assert_text "Your answer"
+      end
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 1 / 1"
+      click_button "Finish"
+      assert_button "End quiz"
+    end
+
+    Capybara.using_session(:alice) do
+      assert_text "Correct!"
+    end
+  end
+
+  private
+
+  def authorize_moderator!
+    page.driver.browser.network.authorize(user: "moderator", password: "hunter2") { |r| r.continue }
+  end
+
+  def mark_no_reload!
+    page.execute_script("window.__quizzyNoReload = 'intact'")
+  end
+
+  def assert_no_reload!
+    assert_equal "intact", page.evaluate_script("window.__quizzyNoReload")
+  end
+
+  def create_question(quiz, body, active:, options:)
+    q = quiz.questions.new
+    assert q.save_with_option_rows(body: body, active: active, option_rows: options)
+    q
+  end
+end
