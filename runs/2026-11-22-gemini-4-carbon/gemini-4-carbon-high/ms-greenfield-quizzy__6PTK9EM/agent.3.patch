+    add_index :game_questions, [ :game_id, :position ], unique: true
+
+    create_table :players do |t|
+      t.references :game, null: false, foreign_key: true
+      t.string :name, null: false
+      t.string :token, null: false
+      t.boolean :online, null: false, default: true
+      t.datetime :last_seen_at, null: false
+      t.timestamps
+    end
+    add_index :players, :token, unique: true
+    add_index :players, [ :game_id, :online ]
+
+    create_table :player_connections do |t|
+      t.references :player, null: false, foreign_key: true
+      t.string :connection_uid, null: false
+      t.datetime :last_seen_at, null: false
+      t.timestamps
+    end
+    add_index :player_connections, :connection_uid, unique: true
+
+    create_table :answers do |t|
+      t.references :game, null: false, foreign_key: true
+      t.references :game_question, null: false, foreign_key: true
+      t.references :question, null: false, foreign_key: true
+      t.references :player, null: false, foreign_key: true
+      t.references :option, null: false, foreign_key: true
+      t.datetime :answered_at, null: false
+      t.timestamps
+    end
+    add_index :answers, [ :game_question_id, :player_id ], unique: true
+    add_index :answers, [ :game_question_id, :option_id ]
+  end
+end
