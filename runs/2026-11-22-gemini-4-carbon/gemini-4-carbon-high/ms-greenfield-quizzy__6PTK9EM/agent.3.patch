diff --git a/app/models/player.rb b/app/models/player.rb
new file mode 100644
index 0000000..2e32a0e
--- /dev/null
+++ b/app/models/player.rb
@@ -0,0 +1,72 @@
+class Player < ApplicationRecord
+  belongs_to :game
+  has_many :player_connections, dependent: :destroy
+  has_many :answers, dependent: :destroy
+
+  normalizes :name, with: ->(name) { name.to_s.strip }
+
+  validates :name, presence: true
+  validates :token, presence: true, uniqueness: true
+
+  before_validation :assign_defaults, on: :create
+
+  def currently_online?
+    online? && last_seen_at.present? && last_seen_at > Game::ONLINE_TTL.ago
+  end
+
+  def register_connection!(uid)
+    now = Time.current
+    was_online = currently_online?
+
+    Player.transaction do
+      lock!
+      was_online = currently_online?
+      conn = player_connections.find_or_initialize_by(connection_uid: uid)
+      conn.last_seen_at = now
+      conn.save!
+      update!(online: true, last_seen_at: now)
+    end
+
+    game.broadcast_counters! if !was_online && !game.finished?
+  end
+
+  def unregister_connection!(uid)
+    became_offline = false
+
+    Player.transaction do
+      lock!
+      player_connections.where(connection_uid: uid).delete_all
+      if player_connections.where("last_seen_at > ?", Game::ONLINE_TTL.ago).none? && online?
+        update!(online: false)
+        became_offline = true
+      end
+    end
+
+    game.broadcast_counters! if became_offline && !game.finished?
+  end
+
+  def touch_presence!(uid = nil)
+    now = Time.current
+    was_online = currently_online?
+
+    Player.transaction do
+      lock!
+      was_online = currently_online?
+      if uid.present?
+        conn = player_connections.find_or_initialize_by(connection_uid: uid)
+        conn.last_seen_at = now
+        conn.save!
+      end
+      update!(online: true, last_seen_at: now)
+    end
+
+    game.broadcast_counters! if !was_online && !game.finished?
+  end
+
+  private
+
+  def assign_defaults
+    self.token ||= SecureRandom.urlsafe_base64(24)
+    self.last_seen_at ||= Time.current
+  end
+end
