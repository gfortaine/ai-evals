new file mode 100644
index 0000000..c5fd7ce
--- /dev/null
+++ b/test/integration/live_game_security_and_http_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class LiveGameSecurityAndHttpTest < ActionDispatch::IntegrationTest
+  setup do
+    @old_user = ENV["QUIZZY_MODERATOR_USERNAME"]
+    @old_pass = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "mod"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "secret"
+
+    @auth_headers = {
+      "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("mod", "secret")
+    }
+
+    @quiz = Quiz.create!(title: "SecConf Quiz")
+    @question = @quiz.questions.new
+    @question.save_with_option_rows(
+      body: "Secret question?",
+      active: true,
+      option_rows: [
+        { body: "AlphaWrong", correct: false },
+        { body: "BravoRight", correct: true },
+        { body: "CharlieWrong", correct: false }
+      ]
+    )
+    @game = @quiz.games.create!
+  end
+
+  teardown do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = @old_user
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = @old_pass
+  end
+
+  test "moderator game endpoints enforce HTTP basic auth while player endpoints are public" do
+    post moderate_quiz_games_path(@quiz)
+    assert_response :unauthorized
+
+    get moderate_quiz_game_path(@quiz, @game)
+    assert_response :unauthorized
+
+    post start_moderate_quiz_game_path(@quiz, @game)
+    assert_response :unauthorized
+
+    get play_game_path(@game.code)
+    assert_response :success
+    assert_includes response.body, "Your name"
+  end
+
+  test "players cannot find out the correct answer in HTML or JSON before the question is closed" do
+    post join_play_game_path(@game.code), params: { name: "Alice" }
+    assert_redirected_to play_game_path(@game.code)
+    follow_redirect!
+    assert_includes response.body, "Hi, Alice!"
+
+    post start_moderate_quiz_game_path(@quiz, @game), headers: @auth_headers
+    assert_redirected_to moderate_quiz_game_path(@quiz, @game)
+
+    # Check HTML source of player page while question is open
+    get play_game_path(@game.code)
+    assert_response :success
+    html = response.body
+    assert_includes html, "Secret question?"
+    assert_includes html, "AlphaWrong"
+    assert_includes html, "BravoRight"
+    assert_includes html, "CharlieWrong"
+    assert_no_match(/correct/i, html)
+
+    # Check JSON state endpoint while question is open
+    get state_play_game_path(@game.code), headers: { "Accept" => "application/json" }
+    assert_response :success
+    json_body = response.body
+    assert_no_match(/correct/i, json_body)
+    parsed = JSON.parse(json_body)
+    parsed.fetch("options").each do |opt|
+      assert_equal %w[body id letter], opt.keys.sort
+    end
+
+    # Check JSON answer response while question is open
+    wrong_opt = @question.options.find_by!(body: "AlphaWrong")
+    post answer_play_game_path(@game.code),
+         params: { option_id: wrong_opt.id, game_question_id: @game.reload.current_game_question_id },
+         headers: { "Accept" => "application/json" }
+    assert_response :success
+    assert_no_match(/correct/i, response.body)
+
+    # Check public player broadcast payload while question is open
+    broadcast_json = @game.reload.public_player_broadcast_payload.to_json
+    assert_no_match(/correct/i, broadcast_json)
+
+    # Now close the question as moderator -> player sees Wrong!
+    post finish_moderate_quiz_game_path(@quiz, @game), headers: @auth_headers
+    get play_game_path(@game.code)
+    assert_response :success
+    assert_includes response.body, "Wrong!"
+  end
+
+  test "joining is blocked after the quiz ends" do
+    @game.start!
+    @game.finish_question!
+    @game.end_quiz!
+
+    get play_game_path(@game.code)
+    assert_response :success
+    assert_includes response.body, "The quiz is over"
+    assert_not_includes response.body, "Your name"
+
+    assert_no_difference "Player.count" do
+      post join_play_game_path(@game.code), params: { name: "Latecomer" }
+      assert_response :unprocessable_entity
+      assert_includes response.body, "The quiz is over"
+    end
+  end
+end
diff --git a/test/models/live_game_test.rb b/test/models/live_game_test.rb
new file mode 100644
index 0000000..9086cdc
--- /dev/null
+++ b/test/models/live_game_test.rb
@@ -0,0 +1,150 @@
+require "test_helper"
+
+class LiveGameTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "RubyKaigi Live")
+    @q1_inactive = create_question(@quiz, "Inactive warmup?", active: false, options: [
+      { body: "Yes", correct: true },
+      { body: "No", correct: false }
+    ])
+    @q2_active = create_question(@quiz, "Which HTTP status means Too Many Requests?", active: true, options: [
+      { body: "418", correct: false },
+      { body: "429", correct: true },
+      { body: "503", correct: false }
+    ])
+    @q3_inactive = create_question(@quiz, "Draft question?", active: false, options: [
+      { body: "Draft A", correct: true },
+      { body: "Draft B", correct: false }
+    ])
+    @q4_multi = create_question(@quiz, "Which are transport protocols?", active: true, options: [
+      { body: "TCP", correct: true },
+      { body: "JSON", correct: false },
+      { body: "UDP", correct: true }
+    ])
+  end
+
+  test "a quiz can be played many times with independent players and answers, and export omits game data" do
+    game1 = @quiz.games.create!
+    game2 = @quiz.games.create!
+
+    assert_not_equal game1.code, game2.code
+    assert_match(/\A[A-Z0-9]{5}\z/, game1.code)
+    assert_equal "lobby", game1.status
+
+    alice = game1.players.create!(name: "Alice")
+    bob = game2.players.create!(name: "Bob")
+
+    game1.start!
+    game2.start!
+
+    opt_429 = @q2_active.options.find_by!(body: "429")
+    opt_418 = @q2_active.options.find_by!(body: "418")
+
+    game1.submit_answer!(player: alice, option_id: opt_429.id)
+    game2.submit_answer!(player: bob, option_id: opt_418.id)
+
+    assert_equal 1, game1.players.count
+    assert_equal 1, game2.players.count
+    assert_equal opt_429.id, game1.player_state_payload_for(alice)[:picked_option_id]
+    assert_equal opt_418.id, game2.player_state_payload_for(bob)[:picked_option_id]
+
+    exported = @quiz.as_export_json
+    assert_equal [ "questions", "title" ], exported.keys.sort
+  end
+
+  test "games skip inactive questions, track last pick, and end after last active question" do
+    game = @quiz.games.create!
+    alice = game.players.create!(name: "Alice")
+    bob = game.players.create!(name: "Bob")
+
+    assert_equal 2, game.online_players_count
+
+    game.start!
+    assert game.question_open?
+
+    mod_state = game.moderator_state_payload
+    assert_equal 1, mod_state[:question_number]
+    assert_equal 2, mod_state[:total_questions]
+    assert_equal false, mod_state[:is_last_question]
+    assert_equal "Which HTTP status means Too Many Requests?", mod_state[:question_body]
+
+    opt_418 = @q2_active.options.find_by!(body: "418")
+    opt_429 = @q2_active.options.find_by!(body: "429")
+
+    # Alice picks 418 then changes to 429; last pick counts
+    game.submit_answer!(player: alice, option_id: opt_418.id)
+    assert_equal 1, game.answered_players_count
+    game.submit_answer!(player: alice, option_id: opt_429.id)
+    assert_equal 1, game.answered_players_count
+
+    game.finish_question!
+    assert game.question_closed?
+
+    # Answers after finish are ignored
+    assert_nil game.submit_answer!(player: bob, option_id: opt_418.id)
+
+    closed_mod = game.moderator_state_payload
+    counts_by_body = closed_mod[:options].to_h { |o| [ o[:body], o[:count] ] }
+    assert_equal({ "418" => 0, "429" => 1, "503" => 0 }, counts_by_body)
+
+    # Next advances directly to @q4_multi (skipping @q3_inactive)
+    game.next_question!
+    assert game.question_open?
+    mod_q2 = game.moderator_state_payload
+    assert_equal 2, mod_q2[:question_number]
+    assert_equal 2, mod_q2[:total_questions]
+    assert_equal true, mod_q2[:is_last_question]
+    assert_equal "Which are transport protocols?", mod_q2[:question_body]
+
+    game.finish_question!
+    assert game.question_closed?
+    assert_equal true, game.moderator_state_payload[:is_last_question]
+
+    game.end_quiz!
+    assert game.finished?
+  end
+
+  test "player connection presence handles multi-tab connections and editing questions after games" do
+    game = @quiz.games.create!
+    alice = game.players.create!(name: "Alice")
+
+    alice.register_connection!("tab-1")
+    alice.register_connection!("tab-2")
+    assert_equal 1, game.online_players_count
+
+    # Closing one tab keeps Alice online because tab-2 is still open
+    alice.unregister_connection!("tab-1")
+    assert_equal 1, game.online_players_count
+
+    # Closing the second tab marks Alice offline
+    alice.unregister_connection!("tab-2")
+    assert_equal 0, game.online_players_count
+
+    # Re-opening marks Alice online again
+    alice.touch_presence!("tab-3")
+    assert_equal 1, game.online_players_count
+
+    # Editing or deleting questions/quizzes after a game with answers succeeds cleanly
+    game.start!
+    game.submit_answer!(player: alice, option_id: @q2_active.options.first.id)
+
+    assert @q2_active.save_with_option_rows(
+      body: "Updated question?",
+      active: true,
+      option_rows: [
+        { body: "New A", correct: true },
+        { body: "New B", correct: false }
+      ]
+    )
+    assert_nothing_raised { @q4_multi.destroy! }
+    assert_nothing_raised { @quiz.destroy! }
+  end
+
+  private
+
