diff --git a/app/javascript/controllers/moderator_game_controller.js b/app/javascript/controllers/moderator_game_controller.js
new file mode 100644
index 0000000..31a56a4
--- /dev/null
+++ b/app/javascript/controllers/moderator_game_controller.js
@@ -0,0 +1,320 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["topTitle", "stage", "playersCounter", "infoExtra", "answersCounter", "actionArea"]
+  static values = {
+    gameId: Number,
+    moderatorToken: String,
+    stateUrl: String,
+    startUrl: String,
+    finishUrl: String,
+    nextUrl: String,
+    endUrl: String,
+    status: String,
+    gameQuestionId: Number,
+    version: Number
+  }
+
+  connect() {
+    this.wsConnected = false
+    this.submitting = false
+    this.setupCable()
+
+    this.onVisibilityOrOnline = () => {
+      if (document.visibilityState === "visible" && this.statusValue !== "finished") {
+        this.fetchState()
+      }
+    }
+    this.onPageLeave = () => {
+      this.teardownCable()
+    }
+    this.onPageShow = (event) => {
+      if (event.persisted) {
+        this.setupCable()
+        this.fetchState()
+      }
+    }
+
+    document.addEventListener("visibilitychange", this.onVisibilityOrOnline)
+    window.addEventListener("online", this.onVisibilityOrOnline)
+    window.addEventListener("pagehide", this.onPageLeave)
+    window.addEventListener("beforeunload", this.onPageLeave)
+    window.addEventListener("pageshow", this.onPageShow)
+
+    this.pollTimer = setInterval(() => {
+      if (!this.wsConnected && this.statusValue !== "finished") {
+        this.fetchState()
+      }
+    }, 2000)
+  }
+
+  disconnect() {
+    if (this.pollTimer) clearInterval(this.pollTimer)
+    document.removeEventListener("visibilitychange", this.onVisibilityOrOnline)
+    window.removeEventListener("online", this.onVisibilityOrOnline)
+    window.removeEventListener("pagehide", this.onPageLeave)
+    window.removeEventListener("beforeunload", this.onPageLeave)
+    window.removeEventListener("pageshow", this.onPageShow)
+    this.teardownCable()
+  }
+
+  setupCable() {
+    this.teardownCable()
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      {
+        channel: "GameModeratorChannel",
+        game_id: this.gameIdValue,
+        moderator_token: this.moderatorTokenValue
+      },
+      {
+        connected: () => {
+          this.wsConnected = true
+          if (this.statusValue !== "finished") {
+            this.fetchState()
+          }
+        },
+        disconnected: () => {
+          this.wsConnected = false
+        },
+        received: (data) => {
+          this.handleMessage(data)
+        }
+      }
+    )
+  }
+
+  teardownCable() {
+    this.wsConnected = false
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  async submitAction(event) {
+    event.preventDefault()
+    if (this.submitting) return
+
+    const form = event.currentTarget
+    this.submitting = true
+
+    try {
+      const response = await fetch(form.action, {
+        method: "POST",
+        headers: {
+          Accept: "application/json",
+          "X-CSRF-Token": this.csrfToken()
+        },
+        credentials: "same-origin"
+      })
+      if (response.ok) {
+        const state = await response.json()
+        this.applyState(state)
+      }
+    } catch (_err) {
+      await this.fetchState()
+    } finally {
+      this.submitting = false
+    }
+  }
+
+  async fetchState() {
+    try {
+      const response = await fetch(this.stateUrlValue, {
+        headers: { Accept: "application/json" },
+        credentials: "same-origin",
+        cache: "no-store"
+      })
+      if (response.ok) {
+        const state = await response.json()
+        this.applyState(state)
+      }
+    } catch (_err) {
+      // Transient conference Wi-Fi error; next WS frame or poll will sync
+    }
+  }
+
+  handleMessage(data) {
+    if (!data) return
+
+    if (data.type === "counters") {
+      if (data.state_version && data.state_version < this.versionValue) return
+      if (data.status && data.status !== this.statusValue) {
+        this.fetchState()
+        return
+      }
+      if (data.state_version) this.versionValue = data.state_version
+      this.updateCountersInPlace(data)
+      return
+    }
+
+    if (data.type === "state") {
+      this.applyState(data)
+    }
+  }
+
+  applyState(state) {
+    if (!state) return
+    if (state.state_version && state.state_version < this.versionValue) return
+    if (state.state_version && state.state_version > this.versionValue) {
+      this.versionValue = state.state_version
+    }
+
+    const nextGqId = state.game_question_id || 0
+    if (state.status === this.statusValue && nextGqId === this.gameQuestionIdValue) {
+      this.updateCountersInPlace(state)
+      return
+    }
+
+    this.statusValue = state.status
+    this.gameQuestionIdValue = nextGqId
+
+    const isQuestionPhase = state.status === "question_open" || state.status === "question_closed"
+    this.element.classList.toggle("cover--calm", isQuestionPhase)
+    if (this.hasTopTitleTarget) {
+      this.topTitleTarget.textContent = isQuestionPhase ? state.quiz_title : ""
+    }
+
+    this.renderStage(state)
+    this.renderControls(state)
+  }
+
+  updateCountersInPlace(data) {
+    if (this.statusValue === "lobby" && this.hasPlayersCounterTarget) {
+      this.playersCounterTarget.textContent = `Players: ${data.online_players_count}`
+    } else if (this.statusValue === "question_open" && this.hasAnswersCounterTarget) {
+      this.answersCounterTarget.textContent = `Answers: ${data.answered_count} / ${data.online_players_count}`
+    }
+  }
+
+  renderStage(state) {
+    this.stageTarget.replaceChildren()
+
+    if (state.status === "question_open" || state.status === "question_closed") {
+      const wrapper = document.createElement("div")
+
+      const numEl = document.createElement("div")
+      numEl.className = "stage-question__num"
+      numEl.textContent = `Question ${state.question_number} of ${state.total_questions}`
+      wrapper.appendChild(numEl)
+
+      const bodyEl = document.createElement("div")
+      bodyEl.className = "stage-question__body"
+      bodyEl.textContent = state.question_body
+      wrapper.appendChild(bodyEl)
+
+      const listEl = document.createElement("ol")
+      listEl.className = state.status === "question_closed" ? "stage-options stage-options--results" : "stage-options"
+
+      for (const opt of state.options || []) {
+        const li = document.createElement("li")
+        li.className = state.status === "question_closed" && opt.correct ? "stage-option is-correct" : "stage-option"
+
+        if (state.status === "question_closed") {
+          const bar = document.createElement("span")
+          bar.className = "stage-option__bar"
+          bar.style.setProperty("--share", `${opt.share || 0}%`)
+          li.appendChild(bar)
+        }
+
+        const letter = document.createElement("span")
+        letter.className = "stage-option__letter"
+        letter.setAttribute("aria-hidden", "true")
+        letter.textContent = opt.letter
+        li.appendChild(letter)
+
+        const title = document.createElement("span")
+        title.className = "stage-option__title"
+        title.textContent = opt.body
+        li.appendChild(title)
+
+        if (state.status === "question_closed") {
+          if (opt.correct) {
+            const mark = document.createElement("span")
+            mark.className = "stage-option__mark"
+            mark.textContent = "Correct"
+            li.appendChild(mark)
+          }
+
+          const count = document.createElement("span")
+          count.className = "stage-option__count"
+          count.textContent = String(opt.count ?? 0)
+          li.appendChild(count)
+        }
+
+        listEl.appendChild(li)
+      }
+
+      wrapper.appendChild(listEl)
+      this.stageTarget.appendChild(wrapper)
+    } else if (state.status === "finished") {
+      const wrapper = document.createElement("div")
+
+      const kicker = document.createElement("div")
+      kicker.className = "screen__kicker"
+      kicker.textContent = state.quiz_title
+      wrapper.appendChild(kicker)
+
+      const heading = document.createElement("h1")
+      heading.className = "lobby__title"
+      heading.textContent = "The quiz is over"
+      wrapper.appendChild(heading)
+
+      this.stageTarget.appendChild(wrapper)
+    }
+  }
+
+  renderControls(state) {
+    this.infoExtraTarget.replaceChildren()
+    this.actionAreaTarget.replaceChildren()
+
+    if (state.status === "question_open") {
+      const counter = document.createElement("span")
+      counter.className = "answers-counter"
+      counter.dataset.moderatorGameTarget = "answersCounter"
+      counter.textContent = `Answers: ${state.answered_count} / ${state.online_players_count}`
+      this.infoExtraTarget.appendChild(counter)
+
+      this.actionAreaTarget.appendChild(this.buildActionForm(this.finishUrlValue, "Finish"))
+    } else if (state.status === "question_closed") {
+      if (state.is_last_question) {
+        this.actionAreaTarget.appendChild(this.buildActionForm(this.endUrlValue, "End quiz"))
+      } else {
+        this.actionAreaTarget.appendChild(this.buildActionForm(this.nextUrlValue, "Next"))
+      }
+    }
+  }
+
+  buildActionForm(actionUrl, labelText) {
+    const form = document.createElement("form")
+    form.action = actionUrl
+    form.method = "post"
+    form.dataset.turbo = "false"
+    form.dataset.action = "submit->moderator-game#submitAction"
+
+    const tokenInput = document.createElement("input")
+    tokenInput.type = "hidden"
+    tokenInput.name = "authenticity_token"
+    tokenInput.value = this.csrfToken()
+    form.appendChild(tokenInput)
+
+    const button = document.createElement("button")
+    button.type = "submit"
+    button.className = "btn btn--pink btn--lg"
+    button.textContent = labelText
+    form.appendChild(button)
+
+    return form
+  }
+
+  csrfToken() {
+    const meta = document.querySelector('meta[name="csrf-token"]')
+    return meta ? meta.content : ""
+  }
+}
diff --git a/app/javascript/controllers/play_game_controller.js b/app/javascript/controllers/play_game_controller.js
new file mode 100644
index 0000000..c82fd95
--- /dev/null
+++ b/app/javascript/controllers/play_game_controller.js
@@ -0,0 +1,493 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["headerInfo", "body"]
+  static values = {
+    code: String,
+    joined: Boolean,
+    playerName: String,
+    quizTitle: String,
+    stateUrl: String,
+    answerUrl: String,
+    status: String,
+    gameQuestionId: Number,
+    pickedOptionId: Number,
+    version: Number
+  }
+
+  connect() {
+    this.wsConnected = false
+    this.answerAbortController = null
+    this.requestSeq = 0
+    this.inFlightAnswer = false
+    this.setupCable()
+
+    this.onVisibilityOrOnline = () => {
+      if (document.visibilityState === "visible" && this.statusValue !== "finished") {
+        this.fetchState(true)
+      }
+    }
+    this.onPageLeave = () => {
+      this.teardownCable()
+    }
+    this.onPageShow = (event) => {
+      if (event.persisted) {
+        this.setupCable()
+        this.fetchState(true)
+      }
+    }
+
+    document.addEventListener("visibilitychange", this.onVisibilityOrOnline)
+    window.addEventListener("online", this.onVisibilityOrOnline)
+    window.addEventListener("pagehide", this.onPageLeave)
+    window.addEventListener("beforeunload", this.onPageLeave)
+    window.addEventListener("pageshow", this.onPageShow)
+
+    if (this.joinedValue) {
+      this.pingTimer = setInterval(() => {
+        if (this.statusValue === "finished") return
+        if (this.wsConnected && this.subscription) {
+          this.subscription.perform("ping")
+        } else {
+          this.fetchState(true)
+        }
+      }, 10000)
+    }
+
+    this.pollTimer = setInterval(() => {
+      if (!this.wsConnected && this.statusValue !== "finished") {
+        this.fetchState(true)
+      }
+    }, 2000)
+  }
+
+  disconnect() {
+    if (this.pingTimer) clearInterval(this.pingTimer)
+    if (this.pollTimer) clearInterval(this.pollTimer)
+    if (this.answerAbortController) this.answerAbortController.abort()
+    document.removeEventListener("visibilitychange", this.onVisibilityOrOnline)
+    window.removeEventListener("online", this.onVisibilityOrOnline)
+    window.removeEventListener("pagehide", this.onPageLeave)
+    window.removeEventListener("beforeunload", this.onPageLeave)
+    window.removeEventListener("pageshow", this.onPageShow)
+    this.teardownCable()
+  }
+
+  setupCable() {
+    this.teardownCable()
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      {
+        channel: "GamePlayerChannel",
+        code: this.codeValue
+      },
+      {
+        connected: () => {
+          this.wsConnected = true
+          if (this.statusValue !== "finished") {
+            this.fetchState(true)
+          }
+        },
+        disconnected: () => {
+          this.wsConnected = false
+        },
+        received: (data) => {
+          this.handleMessage(data)
+        }
+      }
+    )
+  }
+
+  teardownCable() {
+    this.wsConnected = false
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  async pickOption(event) {
+    event.preventDefault()
+    if (this.statusValue !== "question_open") return
+
+    const form = event.currentTarget
+    const optionInput = form.querySelector('input[name="option_id"]')
+    const gqInput = form.querySelector('input[name="game_question_id"]')
+    if (!optionInput) return
+
+    const optionId = Number(optionInput.value)
+    const gameQuestionId = gqInput ? Number(gqInput.value) : this.gameQuestionIdValue
+
+    if (this.answerAbortController) {
+      this.answerAbortController.abort()
+    }
+    const controller = new AbortController()
+    this.answerAbortController = controller
+    const seq = ++this.requestSeq
+    this.inFlightAnswer = true
+
+    try {
+      const state = await this.postAnswerWithRetry(optionId, gameQuestionId, controller.signal)
+      if (state && seq === this.requestSeq) {
+        if (state.state_version && state.state_version < this.versionValue) {
+          await this.fetchState(false)
+        } else {
+          this.applyState(state, { authoritative: true })
+        }
+      }
+    } catch (err) {
+      if (err && err.name !== "AbortError" && seq === this.requestSeq) {
+        await this.fetchState(false)
+      }
+    } finally {
+      if (seq === this.requestSeq) {
+        this.inFlightAnswer = false
+      }
+    }
+  }
+
+  async postAnswerWithRetry(optionId, gameQuestionId, signal) {
+    const body = new URLSearchParams({
+      option_id: String(optionId),
+      game_question_id: String(gameQuestionId)
+    })
+
+    for (let attempt = 0; attempt < 2; attempt++) {
+      try {
+        const response = await fetch(this.answerUrlValue, {
+          method: "POST",
+          headers: {
+            Accept: "application/json",
+            "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
+            "X-CSRF-Token": this.csrfToken()
+          },
+          body: body.toString(),
+          credentials: "same-origin",
+          signal
+        })
+        if (response.ok) {
+          return await response.json()
+        }
+        return null
+      } catch (err) {
+        if (signal.aborted || attempt === 1) throw err
+        await new Promise((resolve) => setTimeout(resolve, 300))
+      }
+    }
+    return null
+  }
+
+  async fetchState(touch = false) {
+    try {
+      const url = touch ? `${this.stateUrlValue}?touch=1` : this.stateUrlValue
+      const response = await fetch(url, {
+        headers: { Accept: "application/json" },
+        credentials: "same-origin",
+        cache: "no-store"
+      })
+      if (response.ok) {
+        const state = await response.json()
+        this.applyState(state, { authoritative: true })
+      }
+    } catch (_err) {
+      // Transient conference Wi-Fi error; next WS message or poll will sync
+    }
+  }
+
+  handleMessage(data) {
+    if (!data) return
+
+    if (data.type === "picked") {
+      if (
+        this.joinedValue &&
+        this.statusValue === "question_open" &&
+        data.game_question_id === this.gameQuestionIdValue &&
+        !this.inFlightAnswer
+      ) {
+        this.pickedOptionIdValue = data.picked_option_id || 0
+        this.updatePickedButtonsInPlace()
+      }
+      return
+    }
+
+    if (data.type === "state") {
+      this.applyState(data, { authoritative: data.joined !== undefined })
+    }
+  }
+
+  applyState(state, { authoritative = false } = {}) {
+    if (!state) return
+    if (state.state_version && state.state_version < this.versionValue) return
+    if (state.state_version && state.state_version > this.versionValue) {
+      this.versionValue = state.state_version
+    }
+
+    if (authoritative) {
+      if (state.joined !== undefined) this.joinedValue = Boolean(state.joined)
+      if (state.player_name) this.playerNameValue = state.player_name
+    }
+
+    if (!this.joinedValue) {
+      if (state.status === "finished" && this.statusValue !== "finished") {
+        this.statusValue = "finished"
+        this.bodyTarget.classList.remove("play__body--top")
+        this.renderFinished()
+      }
+      return
+    }
+
+    const prevStatus = this.statusValue
+    const prevGqId = this.gameQuestionIdValue
+    const nextGqId = state.game_question_id || 0
+
+    if (authoritative && state.picked_option_id !== undefined) {
+      this.pickedOptionIdValue = state.picked_option_id || 0
+    } else if (nextGqId !== prevGqId) {
+      this.pickedOptionIdValue = 0
+    }
+
+    if (state.status === prevStatus && nextGqId === prevGqId) {
+      if (state.status === "question_open") {
+        this.updatePickedButtonsInPlace()
+      } else if (state.status === "question_closed" && authoritative) {
+        this.renderClosedQuestion(state)
+      }
+      return
+    }
+
+    this.statusValue = state.status
+    this.gameQuestionIdValue = nextGqId
+
+    if (this.hasHeaderInfoTarget) {
+      this.headerInfoTarget.textContent =
+        state.status !== "lobby" ? `Hi, ${this.playerNameValue}!` : this.quizTitleValue
+    }
+
+    const isQuestionPhase = state.status === "question_open" || state.status === "question_closed"
+    this.bodyTarget.classList.toggle("play__body--top", isQuestionPhase)
+
+    if (state.status === "lobby") {
+      this.renderLobby()
+    } else if (state.status === "question_open") {
+      this.renderOpenQuestion(state)
+    } else if (state.status === "question_closed") {
+      this.renderClosedQuestion(state)
+    } else if (state.status === "finished") {
+      this.renderFinished()
+    }
+  }
+
+  updatePickedButtonsInPlace() {
+    const buttons = this.bodyTarget.querySelectorAll("button.play-option[data-option-id]")
+    buttons.forEach((btn) => {
+      const optId = Number(btn.dataset.optionId)
+      const isPicked = optId === this.pickedOptionIdValue
+      btn.classList.toggle("is-picked", isPicked)
+      btn.setAttribute("aria-pressed", String(isPicked))
+
+      let mark = btn.querySelector(".play-option__mark")
+      if (isPicked && !mark) {
+        mark = document.createElement("span")
+        mark.className = "play-option__mark"
+        mark.textContent = "Your answer"
+        btn.appendChild(mark)
+      } else if (!isPicked && mark) {
+        mark.remove()
+      }
+    })
+  }
+
+  renderLobby() {
+    this.bodyTarget.replaceChildren()
+
+    const waiting = document.createElement("div")
+    waiting.className = "waiting"
+
+    const gem = document.createElement("div")
+    gem.className = "waiting__gem"
+    gem.setAttribute("aria-hidden", "true")
+    gem.textContent = "?"
+    waiting.appendChild(gem)
+
+    const title = document.createElement("h1")
+    title.className = "play-title"
+    title.textContent = `Hi, ${this.playerNameValue}!`
+    waiting.appendChild(title)
+
+    const lead = document.createElement("p")
+    lead.className = "play-lead"
+    lead.textContent = "Waiting for the quiz to start…"
+    waiting.appendChild(lead)
+
+    this.bodyTarget.appendChild(waiting)
+  }
+
+  renderOpenQuestion(state) {
+    this.bodyTarget.replaceChildren()
+
+    const num = document.createElement("div")
+    num.className = "play-question__num"
+    num.textContent = `Question ${state.question_number} of ${state.total_questions}`
+    this.bodyTarget.appendChild(num)
+
+    const body = document.createElement("div")
+    body.className = "play-question__body"
+    body.textContent = state.question_body
+    this.bodyTarget.appendChild(body)
+
+    const list = document.createElement("ul")
+    list.className = "play-options"
+
+    for (const opt of state.options || []) {
+      const isPicked = opt.id === this.pickedOptionIdValue
+      const li = document.createElement("li")
+
+      const form = document.createElement("form")
+      form.action = this.answerUrlValue
+      form.method = "post"
+      form.dataset.turbo = "false"
+      form.dataset.action = "submit->play-game#pickOption"
+
+      const tokenInput = document.createElement("input")
+      tokenInput.type = "hidden"
+      tokenInput.name = "authenticity_token"
+      tokenInput.value = this.csrfToken()
+      form.appendChild(tokenInput)
+
+      const gqInput = document.createElement("input")
+      gqInput.type = "hidden"
+      gqInput.name = "game_question_id"
+      gqInput.value = String(state.game_question_id)
+      form.appendChild(gqInput)
+
+      const optInput = document.createElement("input")
+      optInput.type = "hidden"
+      optInput.name = "option_id"
+      optInput.value = String(opt.id)
+      form.appendChild(optInput)
+
+      const btn = document.createElement("button")
+      btn.type = "submit"
+      btn.className = isPicked ? "play-option is-picked" : "play-option"
+      btn.dataset.optionId = String(opt.id)
+      btn.setAttribute("aria-pressed", String(isPicked))
+
+      const letter = document.createElement("span")
+      letter.className = "play-option__letter"
+      letter.setAttribute("aria-hidden", "true")
+      letter.textContent = opt.letter
+      btn.appendChild(letter)
+
+      const title = document.createElement("span")
+      title.className = "play-option__title"
+      title.textContent = opt.body
+      btn.appendChild(title)
+
+      if (isPicked) {
+        const mark = document.createElement("span")
+        mark.className = "play-option__mark"
+        mark.textContent = "Your answer"
+        btn.appendChild(mark)
+      }
+
+      form.appendChild(btn)
+      li.appendChild(form)
+      list.appendChild(li)
+    }
+
+    this.bodyTarget.appendChild(list)
+  }
+
+  renderClosedQuestion(state) {
+    this.bodyTarget.replaceChildren()
+
+    const num = document.createElement("div")
+    num.className = "play-question__num"
+    num.textContent = `Question ${state.question_number} of ${state.total_questions}`
+    this.bodyTarget.appendChild(num)
+
+    const body = document.createElement("div")
+    body.className = "play-question__body"
+    body.textContent = state.question_body
+    this.bodyTarget.appendChild(body)
+
+    const list = document.createElement("ul")
+    list.className = "play-options is-locked is-revealed"
+
+    let pickedOption = null
+
+    for (const opt of state.options || []) {
+      const isPicked = opt.id === this.pickedOptionIdValue
+      if (isPicked) pickedOption = opt
+
+      const li = document.createElement("li")
+      const btn = document.createElement("button")
+      btn.type = "button"
+      btn.disabled = true
+      const classes = ["play-option"]
+      if (isPicked) classes.push("is-picked")
+      if (opt.correct) classes.push("is-correct")
+      btn.className = classes.join(" ")
+
+      const letter = document.createElement("span")
+      letter.className = "play-option__letter"
+      letter.setAttribute("aria-hidden", "true")
+      letter.textContent = opt.letter
+      btn.appendChild(letter)
+
+      const title = document.createElement("span")
+      title.className = "play-option__title"
+      title.textContent = opt.body
+      btn.appendChild(title)
+
+      if (isPicked) {
+        const mark = document.createElement("span")
+        mark.className = "play-option__mark"
+        mark.textContent = "Your answer"
+        btn.appendChild(mark)
+      }
+
+      li.appendChild(btn)
+      list.appendChild(li)
+    }
+
+    this.bodyTarget.appendChild(list)
+
+    const statusEl = document.createElement("div")
+    if (!pickedOption) {
+      statusEl.className = "play-status play-status--neutral"
+      statusEl.textContent = "No answer"
+    } else if (pickedOption.correct) {
+      statusEl.className = "play-status play-status--right"
+      statusEl.textContent = "Correct!"
+    } else {
+      statusEl.className = "play-status play-status--wrong"
+      statusEl.textContent = "Wrong!"
+    }
+    this.bodyTarget.appendChild(statusEl)
+  }
+
+  renderFinished() {
+    this.bodyTarget.replaceChildren()
+
+    const waiting = document.createElement("div")
+    waiting.className = "waiting"
+
+    const title = document.createElement("h1")
+    title.className = "play-title"
+    title.textContent = "The quiz is over"
+    waiting.appendChild(title)
+
+    this.bodyTarget.appendChild(waiting)
+  }
+
+  csrfToken() {
+    const meta = document.querySelector('meta[name="csrf-token"]')
+    return meta ? meta.content : ""
+  }
+}
