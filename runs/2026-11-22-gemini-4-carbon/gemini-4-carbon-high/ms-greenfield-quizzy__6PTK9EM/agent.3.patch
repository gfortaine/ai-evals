diff --git a/app/channels/game_moderator_channel.rb b/app/channels/game_moderator_channel.rb
new file mode 100644
index 0000000..0f23304
--- /dev/null
+++ b/app/channels/game_moderator_channel.rb
@@ -0,0 +1,13 @@
+class GameModeratorChannel < ApplicationCable::Channel
+  def subscribed
+    verified_game_id = Rails.application.message_verifier(:moderator_game).verified(params[:moderator_token].to_s)
+    @game = Game.find_by(id: params[:game_id])
+
+    if @game && verified_game_id == @game.id
+      stream_from @game.moderator_stream_name
+      transmit(@game.moderator_state_payload)
+    else
+      reject
+    end
+  end
+end
diff --git a/app/channels/game_player_channel.rb b/app/channels/game_player_channel.rb
new file mode 100644
index 0000000..cc96cb6
--- /dev/null
+++ b/app/channels/game_player_channel.rb
@@ -0,0 +1,37 @@
+class GamePlayerChannel < ApplicationCable::Channel
+  def subscribed
+    @game = Game.find_by(code: params[:code].to_s.upcase)
+    unless @game
+      reject
+      return
+    end
+
+    token = connection.signed_cookie("quizzy_player_#{@game.code}")
+    @player = token.present? ? @game.players.find_by(token: token) : nil
+
+    stream_from @game.players_stream_name
+
+    if @player
+      stream_from @game.player_private_stream_name(@player.id)
+      @player.register_connection!(connection_uid)
+    end
+
+    transmit(@game.reload.player_state_payload_for(@player))
+  end
+
+  def ping
+    return unless @player
+
+    @player.reload.touch_presence!(connection_uid)
+  rescue ActiveRecord::RecordNotFound
+    nil
+  end
+
+  def unsubscribed
+    return unless @player
+
+    @player.reload.unregister_connection!(connection_uid)
+  rescue ActiveRecord::RecordNotFound
+    nil
+  end
+end
diff --git a/app/controllers/games_controller.rb b/app/controllers/games_controller.rb
new file mode 100644
index 0000000..5699773
--- /dev/null
+++ b/app/controllers/games_controller.rb
@@ -0,0 +1,96 @@
+class GamesController < ApplicationController
+  before_action :set_game
+
+  def show
+    @player = current_player
+    @player.touch_presence! if @player && !@game.finished?
+    @state = @game.player_state_payload_for(@player)
+  end
+
+  def state
+    @player = current_player
+    @player.touch_presence! if @player && !@game.finished? && params[:touch].present?
+    render json: @game.player_state_payload_for(@player)
+  end
+
+  def join
+    @player = current_player
+    if @player
+      @player.touch_presence! unless @game.finished?
+      redirect_to play_game_path(@game.code), status: :see_other
+      return
+    end
+
+    if @game.finished?
+      @state = @game.player_state_payload_for(nil)
+      render :show, status: :unprocessable_entity
+      return
+    end
+
+    name = params[:name].to_s.strip
+    if name.empty?
+      @submitted_name = params[:name].to_s
+      @join_error = "Enter your name"
+      @state = @game.player_state_payload_for(nil)
+      render :show, status: :unprocessable_entity
+      return
+    end
+
+    @player = @game.players.create!(name: name, online: true, last_seen_at: Time.current)
+    cookies.signed[player_cookie_key] = {
+      value: @player.token,
+      expires: 7.days.from_now,
+      httponly: true,
+      same_site: :lax
+    }
+    @game.broadcast_counters!
+
+    redirect_to play_game_path(@game.code), status: :see_other
+  end
+
+  def answer
+    @player = current_player
+    unless @player
+      if json_request?
+        render json: @game.player_state_payload_for(nil), status: :unauthorized
+      else
+        redirect_to play_game_path(@game.code), status: :see_other
+      end
+      return
+    end
+
+    @game.submit_answer!(
+      player: @player,
+      option_id: params[:option_id],
+      game_question_id: params[:game_question_id]
+    )
+
+    if json_request?
+      render json: @game.reload.player_state_payload_for(@player)
+    else
+      redirect_to play_game_path(@game.code), status: :see_other
+    end
+  end
+
+  private
+
+  def set_game
+    @game = Game.find_by!(code: params[:code].to_s.strip.upcase)
+    @quiz = @game.quiz
+  end
+
+  def player_cookie_key
+    "quizzy_player_#{@game.code}"
+  end
+
+  def current_player
+    token = cookies.signed[player_cookie_key]
+    return nil if token.blank?
+
+    @game.players.find_by(token: token)
+  end
+
+  def json_request?
+    request.accept&.include?("application/json") || request.xhr?
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
