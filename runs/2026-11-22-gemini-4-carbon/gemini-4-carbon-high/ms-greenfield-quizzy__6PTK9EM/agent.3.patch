+    </div>
+
+    <div class="screen__body" data-moderator-game-target="stage">
+      <% if @state[:status] == "lobby" %>
+        <div class="lobby">
+          <div>
+            <h1 class="lobby__title"><%= @state[:quiz_title] %></h1>
+            <div class="lobby__join">Join at</div>
+            <div class="lobby__url"><%= @join_url %></div>
+            <div class="counter-pill" data-moderator-game-target="playersCounter">Players: <%= @state[:online_players_count] %></div>
+          </div>
+          <div class="qr">
+            <%= render_qr_svg(@join_url) %>
+          </div>
+        </div>
+      <% elsif @state[:status] == "question_open" %>
+        <div>
+          <div class="stage-question__num">Question <%= @state[:question_number] %> of <%= @state[:total_questions] %></div>
+          <div class="stage-question__body"><%= @state[:question_body] %></div>
+          <ol class="stage-options">
+            <% @state[:options].each do |opt| %>
+              <li class="stage-option">
+                <span class="stage-option__letter" aria-hidden="true"><%= opt[:letter] %></span>
+                <span class="stage-option__title"><%= opt[:body] %></span>
+              </li>
+            <% end %>
+          </ol>
+        </div>
+      <% elsif @state[:status] == "question_closed" %>
+        <div>
+          <div class="stage-question__num">Question <%= @state[:question_number] %> of <%= @state[:total_questions] %></div>
+          <div class="stage-question__body"><%= @state[:question_body] %></div>
+          <ol class="stage-options stage-options--results">
+            <% @state[:options].each do |opt| %>
+              <li class="stage-option <%= 'is-correct' if opt[:correct] %>">
+                <span class="stage-option__bar" style="--share: <%= opt[:share] %>%"></span>
+                <span class="stage-option__letter" aria-hidden="true"><%= opt[:letter] %></span>
+                <span class="stage-option__title"><%= opt[:body] %></span>
+                <% if opt[:correct] %>
+                  <span class="stage-option__mark">Correct</span>
+                <% end %>
+                <span class="stage-option__count"><%= opt[:count] %></span>
+              </li>
+            <% end %>
+          </ol>
+        </div>
+      <% else %>
+        <div>
+          <div class="screen__kicker"><%= @state[:quiz_title] %></div>
+          <h1 class="lobby__title">The quiz is over</h1>
+        </div>
+      <% end %>
+    </div>
