+require "application_system_test_case"
+require "rqrcode"
+
+class LiveGameSystemTest < ApplicationSystemTestCase
+  setup do
+    @old_user = ENV["QUIZZY_MODERATOR_USERNAME"]
+    @old_pass = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "hunter2"
+
+    @quiz = Quiz.create!(title: "Conf Stage 2026")
+    create_question(@quiz, "Which HTTP status code means Too Many Requests?", active: true, options: [
+      { body: "418 Teapot", correct: false },
+      { body: "429 Rate Limit", correct: true },
+      { body: "503 Unavailable", correct: false }
+    ])
+    create_question(@quiz, "Skipped inactive rehearsal question?", active: false, options: [
+      { body: "Skip A", correct: true },
+      { body: "Skip B", correct: false }
+    ])
+    create_question(@quiz, "Which protocols run over IP?", active: true, options: [
+      { body: "TCP", correct: true },
+      { body: "Pigeon", correct: false },
+      { body: "UDP", correct: true }
+    ])
+    create_question(@quiz, "What port is standard HTTP?", active: true, options: [
+      { body: "Port 80", correct: true },
+      { body: "Port 22", correct: false }
+    ])
+  end
+
+  teardown do
+    Capybara.reset_sessions!
+    ENV["QUIZZY_MODERATOR_USERNAME"] = @old_user
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = @old_pass
+  end
+
+  test "full live game across moderator big screen and participant phones without page reloads" do
+    join_url = nil
+
+    Capybara.using_session(:moderator) do
+      authorize_moderator!
+      visit moderate_quiz_path(@quiz)
+      assert_button "Start a game"
+      click_button "Start a game"
+
+      # Stays in moderator area
+      assert_match(%r{\A/moderate/}, current_path)
+      assert_text "Conf Stage 2026"
+      assert_text "Players: 0"
+      assert_button "Start"
+
+      # Full join URL as plain text + matching QR code SVG
+      displayed_url = find(".lobby__url").text
+      assert_match(%r{\Ahttps?://[^/]+/play/[A-Z0-9]+\z}, displayed_url)
+      join_url = displayed_url
+
+      svg_el = find(".qr svg", visible: true)
+      expected_path_d = RQRCode::QRCode.new(join_url)
+        .as_svg(color: "000", fill: "fff", shape_rendering: "crispEdges", module_size: 8, offset: 16, use_path: true, viewbox: true)
+        .match(/<path d="([^"]+)"/)[1]
+      assert_equal expected_path_d, svg_el.find("path", visible: :all)[:d]
+
+      mark_no_reload!
+    end
+
+    # Alice joins before start
+    Capybara.using_session(:alice) do
+      visit join_url
+      assert_field "Your name"
+      assert_button "Join"
+
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+
+      assert_text "Hi, Alice!"
+      mark_no_reload!
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 1"
+      assert_no_reload!
+    end
+
+    # Bob joins before start
+    Capybara.using_session(:bob) do
+      visit join_url
+      fill_in "Your name", with: "Bob"
+      click_button "Join"
+
+      assert_text "Hi, Bob!"
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 2"
+    end
+
+    # Bob leaves tab -> counter drops to 1; reopening join link remembers Bob -> counter back to 2
+    Capybara.using_session(:bob) do
+      visit "about:blank"
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 1"
+    end
+
+    Capybara.using_session(:bob) do
+      visit join_url
+      assert_text "Hi, Bob!"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+      mark_no_reload!
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 2"
+
+      # Start the quiz -> Question 1 of 3 (inactive question skipped in total)
+      click_button "Start"
+
+      assert_text "Question 1 of 3"
+      assert_text "Which HTTP status code means Too Many Requests?"
+      assert_selector "li", text: /418 Teapot/
+      assert_selector "li", text: /429 Rate Limit/
+      assert_selector "li", text: /503 Unavailable/
+      assert_no_text "Correct"
+      assert_text "Answers: 0 / 2"
+      assert_button "Finish"
+      assert_no_reload!
+    end
+
+    # Alice sees Question 1 live without reload, cannot find correct answer in source, picks wrong then changes to right
+    Capybara.using_session(:alice) do
+      assert_text "Which HTTP status code means Too Many Requests?"
+      assert_button "418 Teapot"
+      assert_button "429 Rate Limit"
+      assert_button "503 Unavailable"
+      assert_no_reload!
+
+      # Page source must not reveal the correct answer while open
+      assert_no_match(/correct/i, page.html)
+
+      click_button "418 Teapot"
+      within("button", text: /418 Teapot/) do
+        assert_text "Your answer"
+      end
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 1 / 2"
+    end
+
+    # Alice changes her answer before Finish -> last pick counts, counter stays 1 / 2
+    Capybara.using_session(:alice) do
+      click_button "429 Rate Limit"
+      within("button", text: /429 Rate Limit/) do
+        assert_text "Your answer"
+      end
+      within("button", text: /418 Teapot/) do
+        assert_no_text "Your answer"
+      end
+      assert_no_reload!
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 1 / 2"
+    end
+
+    # Bob disconnects during open question -> active players drops to 1 ("Answers: 1 / 1")
+    Capybara.using_session(:bob) do
+      visit "about:blank"
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 1 / 1"
+    end
+
+    # Charlie joins mid-question -> active players becomes 2 ("Answers: 1 / 2"), Charlie answers wrong
+    Capybara.using_session(:charlie) do
+      visit join_url
+      fill_in "Your name", with: "Charlie"
+      click_button "Join"
+
+      assert_text "Which HTTP status code means Too Many Requests?"
+      mark_no_reload!
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 1 / 2"
+    end
+
+    Capybara.using_session(:charlie) do
+      click_button "503 Unavailable"
+      within("button", text: /503 Unavailable/) do
+        assert_text "Your answer"
+      end
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 2 / 2"
+    end
+
+    # Bob comes back without answering Q1 -> active players becomes 3 ("Answers: 2 / 3")
+    Capybara.using_session(:bob) do
+      visit join_url
+      assert_text "Which HTTP status code means Too Many Requests?"
+      mark_no_reload!
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 2 / 3"
+
+      # Moderator closes Q1
+      click_button "Finish"
+
+      within("li", text: /418 Teapot/) do
+        assert_no_text "Correct"
+        assert_text "0"
+      end
+      within("li", text: /429 Rate Limit/) do
+        assert_text "Correct"
+        assert_text "1"
+      end
+      within("li", text: /503 Unavailable/) do
+        assert_no_text "Correct"
+        assert_text "1"
+      end
+      assert_button "Next"
+      assert_no_reload!
+    end
+
+    # Players see Correct!, Wrong!, or No answer live without reload
+    Capybara.using_session(:alice) do
+      assert_text "Correct!"
+      assert_no_reload!
+    end
+
+    Capybara.using_session(:charlie) do
+      assert_text "Wrong!"
+      assert_no_reload!
+    end
+
+    Capybara.using_session(:bob) do
+      assert_text "No answer"
+      assert_no_reload!
+    end
+
+    # Advance to Question 2 of 3 (skips inactive question, has multiple correct options)
+    Capybara.using_session(:moderator) do
+      click_button "Next"
+
+      assert_text "Question 2 of 3"
+      assert_text "Which protocols run over IP?"
+      assert_no_text "Skipped inactive rehearsal question?"
+      assert_text "Answers: 0 / 3"
+      assert_button "Finish"
+      assert_no_reload!
+    end
+
+    Capybara.using_session(:alice) do
+      assert_text "Which protocols run over IP?"
+      click_button "TCP"
+      within("button", text: /TCP/) { assert_text "Your answer" }
+      assert_no_reload!
+    end
+
+    Capybara.using_session(:bob) do
+      assert_text "Which protocols run over IP?"
+      click_button "UDP"
+      within("button", text: /UDP/) { assert_text "Your answer" }
+      assert_no_reload!
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 2 / 3"
+      click_button "Finish"
+
+      within("li", text: /TCP/) do
+        assert_text "Correct"
+        assert_text "1"
+      end
+      within("li", text: /Pigeon/) do
+        assert_no_text "Correct"
+        assert_text "0"
+      end
+      within("li", text: /UDP/) do
+        assert_text "Correct"
+        assert_text "1"
+      end
+      assert_button "Next"
+
+      # Advance to Question 3 of 3 (last active question)
+      click_button "Next"
+      assert_text "Question 3 of 3"
+      assert_text "What port is standard HTTP?"
+      assert_button "Finish"
+    end
+
+    # An unjoined visitor opens the join link right before End quiz
+    Capybara.using_session(:outsider) do
+      visit join_url
+      assert_field "Your name"
+      assert_button "Join"
+      mark_no_reload!
+    end
+
+    Capybara.using_session(:moderator) do
+      click_button "Finish"
+      # On the last question, the button is "End quiz" instead of "Next"
+      assert_no_button "Next"
+      assert_button "End quiz"
+
+      click_button "End quiz"
+      assert_text "The quiz is over"
+      assert_no_button "End quiz"
+      assert_no_reload!
+    end
+
+    # All joined players AND unjoined visitors see "The quiz is over" live without reload
+    [ :alice, :bob, :charlie, :outsider ].each do |session_name|
+      Capybara.using_session(session_name) do
+        assert_text "The quiz is over"
+        assert_no_button "Join"
+        assert_no_reload!
+      end
+    end
+
+    # Opening the join link after the end shows "The quiz is over" and does not let anyone join
+    Capybara.using_session(:latecomer) do
+      visit join_url
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+
+    # Starting a new game on the same quiz creates a fresh independent game
+    Capybara.using_session(:moderator) do
+      visit moderate_quiz_path(@quiz)
