+require "application_system_test_case"
+
+class PrizesAndWinnersTest < ApplicationSystemTestCase
+  setup do
+    @old_user = ENV["QUIZZY_MODERATOR_USERNAME"]
+    @old_pass = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "hunter2"
+  end
+
+  teardown do
+    Capybara.reset_sessions!
+    ENV["QUIZZY_MODERATOR_USERNAME"] = @old_user
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = @old_pass
+  end
+
+  test "default 3 winners, speed tie-breaking, instant sync across big screen and phones, Top N, Draw, and Reset winners" do
+    quiz = Quiz.create!(title: "Keynote Prizes 2026")
+    create_question(quiz, "Question One?", active: true, options: [
+      { body: "Right 1", correct: true },
+      { body: "Wrong 1", correct: false }
+    ])
+    create_question(quiz, "Question Two?", active: true, options: [
+      { body: "Right 2A", correct: true },
+      { body: "Right 2B", correct: true },
+      { body: "Wrong 2", correct: false }
+    ])
+    create_question(quiz, "Question Three?", active: true, options: [
+      { body: "Right 3", correct: true },
+      { body: "Wrong 3", correct: false }
+    ])
+
+    mod_game_url = nil
+    join_url = nil
+
+    # Verify Settings has "Number of winners" defaulting to 3
+    Capybara.using_session(:moderator) do
+      authorize_moderator!
+      visit settings_moderate_quiz_path(quiz)
+      assert_field "Title", with: "Keynote Prizes 2026"
+      assert_field "Number of winners", with: "3"
+
+      visit moderate_quiz_path(quiz)
+      click_button "Start a game"
+      assert_text "Players: 0"
+      mod_game_url = page.current_url
+      join_url = find(".lobby__url").text
+      mark_no_reload!
+    end
+
+    # Open a separate big-screen projector window
+    Capybara.using_session(:big_screen) do
+      authorize_moderator!
+      visit mod_game_url
+      assert_text "Join at"
+      mark_no_reload!
+    end
+
+    players = {
+      alice: "Alice",
+      bob:   "Bob",
+      carol: "Carol",
+      dave:  "Dave",
+      frank: "Frank",
+      eve:   "Eve"
+    }
+
+    players.each do |session_name, display_name|
+      Capybara.using_session(session_name) do
+        visit join_url
+        fill_in "Your name", with: display_name
+        click_button "Join"
+        assert_text "Hi, #{display_name}!"
+        assert_no_text "point"
+        mark_no_reload!
+      end
+    end
+
+    # Moderator starts game: big screen and all 6 phones follow close to instantly without reload
+    t_start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 6"
+      click_button "Start"
+      assert_text "Question 1 of 3"
+    end
+
+    Capybara.using_session(:big_screen) do
+      assert_text "Question 1 of 3"
+      assert_text "Question One?"
+      assert_no_reload!
+    end
+
+    players.each_key do |session_name|
+      Capybara.using_session(session_name) do
+        assert_text "Question One?"
+        assert_no_text "point"
+        assert_no_reload!
+      end
+    end
+    elapsed_sync = Process.clock_gettime(Process::CLOCK_MONOTONIC) - t_start
+    assert elapsed_sync < 2.0, "Expected near-instant delivery to big screen and 6 phones, took #{elapsed_sync.round(3)}s"
+
+    # Question 1 answers (staggered so Bob < Carol < Dave in speed):
+    # Frank: Right 1 (will finish with 1 pt)
