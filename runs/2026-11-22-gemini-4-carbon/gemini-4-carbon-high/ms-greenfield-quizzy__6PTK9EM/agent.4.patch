+++ b/test/models/prizes_and_scoring_test.rb
@@ -0,0 +1,241 @@
+require "test_helper"
+
+class PrizesAndScoringTest < ActiveSupport::TestCase
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    @quiz = Quiz.create!(title: "Prize Conf 2026")
+    @q1 = create_question(@quiz, "Question 1?", active: true, options: [
+      { body: "Q1 Right A", correct: true },
+      { body: "Q1 Right B", correct: true },
+      { body: "Q1 Wrong", correct: false }
+    ])
+    @q2 = create_question(@quiz, "Question 2?", active: true, options: [
+      { body: "Q2 Right", correct: true },
+      { body: "Q2 Wrong", correct: false }
+    ])
+    @q3 = create_question(@quiz, "Question 3?", active: true, options: [
+      { body: "Q3 Right", correct: true },
+      { body: "Q3 Wrong", correct: false }
+    ])
+  end
+
+  test "quiz number_of_winners defaults to 3 and requires an integer at least 1" do
+    fresh = Quiz.create!(title: "Default Winners Quiz")
+    assert_equal 3, fresh.number_of_winners
+
+    [ 0, -1, -10, nil, "", "abc", 1.5, "2.5" ].each do |bad_val|
+      fresh.number_of_winners = bad_val
+      assert_not fresh.valid?, "Expected #{bad_val.inspect} to be invalid"
+    end
+
+    [ 1, 2, 3, 10 ].each do |good_val|
+      fresh.number_of_winners = good_val
+      assert fresh.valid?, "Expected #{good_val.inspect} to be valid"
+    end
+  end
+
+  test "scoring awards 1 point per correct answer, ranks ties by total time of correct answers using last pick, and hides points during game" do
+    game = @quiz.games.create!
+    alice = game.players.create!(name: "Alice")
+    bob = game.players.create!(name: "Bob")
+    carol = game.players.create!(name: "Carol")
+    dave = game.players.create!(name: "Dave")
+
+    q1_right_a = @q1.options.find_by!(body: "Q1 Right A")
+    q1_right_b = @q1.options.find_by!(body: "Q1 Right B")
+    q1_wrong = @q1.options.find_by!(body: "Q1 Wrong")
+    q2_right = @q2.options.find_by!(body: "Q2 Right")
+    q2_wrong = @q2.options.find_by!(body: "Q2 Wrong")
+    q3_right = @q3.options.find_by!(body: "Q3 Right")
+    q3_wrong = @q3.options.find_by!(body: "Q3 Wrong")
+
+    # Lobby: no points or place exposed
+    assert_nil game.player_state_payload_for(alice)[:points]
+    assert_nil game.player_state_payload_for(alice)[:place]
+
+    t0 = Time.zone.parse("2026-11-21 14:00:00")
+    travel_to(t0, with_usec: true) { game.start! }
+
+    # Question 1:
+    # - Alice picks Q1 Right A at +1.0s, then changes to Q1 Right B at +4.0s -> 1 pt, 4.0s (last pick counts!)
+    # - Bob picks Q1 Wrong at +0.5s, then changes to Q1 Right A at +2.5s -> 1 pt, 2.5s
+    # - Carol picks Q1 Right A at +0.2s, then changes to Q1 Wrong at +1.5s -> 0 pts, 0s
+    # - Dave picks Q1 Wrong at +0.1s -> 0 pts, 0s
+    travel_to(t0 + 0.1.seconds, with_usec: true) { game.submit_answer!(player: dave, option_id: q1_wrong.id) }
+    travel_to(t0 + 0.2.seconds, with_usec: true) { game.submit_answer!(player: carol, option_id: q1_right_a.id) }
+    travel_to(t0 + 0.5.seconds, with_usec: true) { game.submit_answer!(player: bob, option_id: q1_wrong.id) }
+    travel_to(t0 + 1.0.seconds, with_usec: true) { game.submit_answer!(player: alice, option_id: q1_right_a.id) }
+    travel_to(t0 + 1.5.seconds, with_usec: true) { game.submit_answer!(player: carol, option_id: q1_wrong.id) }
+    travel_to(t0 + 2.5.seconds, with_usec: true) { game.submit_answer!(player: bob, option_id: q1_right_a.id) }
+    travel_to(t0 + 4.0.seconds, with_usec: true) { game.submit_answer!(player: alice, option_id: q1_right_b.id) }
+
+    # Question open: no points exposed
+    assert_nil game.reload.player_state_payload_for(alice)[:points]
+
+    travel_to(t0 + 5.0.seconds, with_usec: true) { game.finish_question! }
+    # Question closed: still no points exposed during the game
+    assert_nil game.reload.player_state_payload_for(alice)[:points]
+
+    # Question 2:
+    # - Alice answers Q2 Wrong slowly at +9.0s (wrong answer time must NOT be added!) -> still 1 pt, 4.0s
+    # - Carol answers Q2 Right at +4.5s -> 1 pt, 4.5s
+    t1 = t0 + 10.0.seconds
+    travel_to(t1, with_usec: true) { game.next_question! }
+    travel_to(t1 + 4.5.seconds, with_usec: true) { game.submit_answer!(player: carol, option_id: q2_right.id) }
+    travel_to(t1 + 9.0.seconds, with_usec: true) { game.submit_answer!(player: alice, option_id: q2_wrong.id) }
+    travel_to(t1 + 10.0.seconds, with_usec: true) { game.finish_question! }
+
+    # Question 3:
+    # - Dave does not answer -> 0 pts
+    # - Bob answers Q3 Wrong at +8.0s -> still 1 pt, 2.5s
+    t2 = t1 + 15.0.seconds
+    travel_to(t2, with_usec: true) { game.next_question! }
+    travel_to(t2 + 8.0.seconds, with_usec: true) { game.submit_answer!(player: bob, option_id: q3_wrong.id) }
+    travel_to(t2 + 9.0.seconds, with_usec: true) { game.finish_question! }
+    travel_to(t2 + 10.0.seconds, with_usec: true) { game.end_quiz! }
+
+    # Bob (1 pt, 2.5s) < Alice (1 pt, 4.0s) < Carol (1 pt, 4.5s) < Dave (0 pts)
+    entries = game.reload.leaderboard_entries
+    assert_equal [ "Bob", "Alice", "Carol", "Dave" ], entries.map { |e| e[:name] }
+    assert_equal [ 1, 2, 3, 4 ], entries.map { |e| e[:place] }
+    assert_equal [ 1, 1, 1, 0 ], entries.map { |e| e[:points] }
+    assert_equal [ 2500, 4000, 4500, 0 ], entries.map { |e| e[:correct_time_ms] }
+    assert entries.none? { |e| e[:winner] }
+
+    alice_payload = game.player_state_payload_for(alice)
+    assert_equal 2, alice_payload[:place]
+    assert_equal 4, alice_payload[:total_players]
+    assert_equal 1, alice_payload[:points]
+    assert_equal false, alice_payload[:winner]
+  end
+
+  test "Top N, Draw with ties, repeated Draw, Reset winners, and 0-point / fewer-than-N rules" do
+    @quiz.update!(number_of_winners: 3)
+    game = @quiz.games.create!
+
+    alice = game.players.create!(name: "Alice") # 3 pts
+    bob   = game.players.create!(name: "Bob")   # 2 pts (fast: 1.0s + 1.0s = 2.0s)
+    carol = game.players.create!(name: "Carol") # 2 pts (mid:  2.0s + 2.0s = 4.0s)
+    dave  = game.players.create!(name: "Dave")  # 2 pts (slow: 3.0s + 3.0s = 6.0s)
+    eve   = game.players.create!(name: "Eve")   # 2 pts (slowest: 4.0s + 4.0s = 8.0s)
+    frank = game.players.create!(name: "Frank") # 1 pt  (0.5s)
+    grace = game.players.create!(name: "Grace") # 0 pts
+
+    q1_r = @q1.options.find_by!(body: "Q1 Right A")
+    q2_r = @q2.options.find_by!(body: "Q2 Right")
+    q3_r = @q3.options.find_by!(body: "Q3 Right")
+
+    t0 = Time.zone.parse("2026-11-21 15:00:00")
+    travel_to(t0, with_usec: true) { game.start! }
+    travel_to(t0 + 0.5.seconds, with_usec: true) { game.submit_answer!(player: frank, option_id: q1_r.id) }
+    travel_to(t0 + 1.0.seconds, with_usec: true) { game.submit_answer!(player: alice, option_id: q1_r.id) }
+    travel_to(t0 + 1.0.seconds, with_usec: true) { game.submit_answer!(player: bob,   option_id: q1_r.id) }
+    travel_to(t0 + 2.0.seconds, with_usec: true) { game.submit_answer!(player: carol, option_id: q1_r.id) }
+    travel_to(t0 + 3.0.seconds, with_usec: true) { game.submit_answer!(player: dave,  option_id: q1_r.id) }
+    travel_to(t0 + 4.0.seconds, with_usec: true) { game.submit_answer!(player: eve,   option_id: q1_r.id) }
+    travel_to(t0 + 5.0.seconds, with_usec: true) { game.finish_question! }
+
+    # Cannot pick winners before quiz finishes
+    assert_equal false, game.pick_top_winners!
+    assert_equal false, game.draw_winners!
+    assert_equal false, game.reset_winners!
+
+    t1 = t0 + 10.0.seconds
+    travel_to(t1, with_usec: true) { game.next_question! }
+    travel_to(t1 + 1.0.seconds, with_usec: true) { game.submit_answer!(player: alice, option_id: q2_r.id) }
+    travel_to(t1 + 1.0.seconds, with_usec: true) { game.submit_answer!(player: bob,   option_id: q2_r.id) }
+    travel_to(t1 + 2.0.seconds, with_usec: true) { game.submit_answer!(player: carol, option_id: q2_r.id) }
+    travel_to(t1 + 3.0.seconds, with_usec: true) { game.submit_answer!(player: dave,  option_id: q2_r.id) }
+    travel_to(t1 + 4.0.seconds, with_usec: true) { game.submit_answer!(player: eve,   option_id: q2_r.id) }
+    travel_to(t1 + 5.0.seconds, with_usec: true) { game.finish_question! }
+
+    t2 = t1 + 10.0.seconds
+    travel_to(t2, with_usec: true) { game.next_question! }
+    travel_to(t2 + 1.0.seconds, with_usec: true) { game.submit_answer!(player: alice, option_id: q3_r.id) }
+    travel_to(t2 + 2.0.seconds, with_usec: true) { game.finish_question! }
+    travel_to(t2 + 3.0.seconds, with_usec: true) { game.end_quiz! }
+
+    # Top 3 selects first 3 of leaderboard: Alice (3), Bob (2, fastest), Carol (2, 2nd fastest)
+    assert game.pick_top_winners!
+    winners = game.leaderboard_entries.select { |e| e[:winner] }.map { |e| e[:name] }
+    assert_equal [ "Alice", "Bob", "Carol" ], winners
+
+    # Draw: Alice (> 2 pts) always wins; remaining 2 prizes drawn at random among [Bob, Carol, Dave, Eve] (all 2 pts)
+    rng = Random.new(12345)
+    drawn_sets = []
+    40.times do
+      assert game.draw_winners!(rng: rng)
+      w = game.leaderboard_entries.select { |e| e[:winner] }.map { |e| e[:name] }
+      assert_equal 3, w.size
+      assert_includes w, "Alice"
+      assert_not_includes w, "Frank"
+      assert_not_includes w, "Grace"
+      assert (w - [ "Alice" ]).all? { |name| %w[Bob Carol Dave Eve].include?(name) }
+      drawn_sets << w.sort
+    end
+
+    # Across 40 draws, each of the 4 tied players (regardless of speed) wins multiple times
+    %w[Bob Carol Dave Eve].each do |tied_name|
+      wins = drawn_sets.count { |set| set.include?(tied_name) }
+      assert wins >= 5, "Expected #{tied_name} to be drawn multiple times, got #{wins}"
+    end
+    assert drawn_sets.uniq.size >= 4, "Expected multiple distinct random draws across clicks"
+
+    # Reset winners clears everyone
+    assert game.reset_winners!
+    assert_empty game.leaderboard_entries.select { |e| e[:winner] }
+  end
+
+  test "players with 0 points never win and fewer than N scorers makes all scorers win" do
+    @quiz.update!(number_of_winners: 4)
+    game = @quiz.games.create!
+
+    alice = game.players.create!(name: "Alice") # 1 pt
+    bob   = game.players.create!(name: "Bob")   # 1 pt
+    carol = game.players.create!(name: "Carol") # 0 pts
+    dave  = game.players.create!(name: "Dave")  # 0 pts
+    eve   = game.players.create!(name: "Eve")   # 0 pts
+
+    q1_r = @q1.options.find_by!(body: "Q1 Right A")
+    q1_w = @q1.options.find_by!(body: "Q1 Wrong")
+
+    game.start!
+    game.submit_answer!(player: alice, option_id: q1_r.id)
+    game.submit_answer!(player: bob,   option_id: q1_r.id)
+    game.submit_answer!(player: carol, option_id: q1_w.id)
+    game.end_quiz!
+
+    game.pick_top_winners!
+    assert_equal [ "Alice", "Bob" ], game.leaderboard_entries.select { |e| e[:winner] }.map { |e| e[:name] }
+
+    game.reset_winners!
+    assert_empty game.leaderboard_entries.select { |e| e[:winner] }
+
+    game.draw_winners!
+    assert_equal [ "Alice", "Bob" ], game.leaderboard_entries.select { |e| e[:winner] }.map { |e| e[:name] }
+  end
+
+  test "when nobody scores any points, neither Top N nor Draw picks any winners" do
+    game = @quiz.games.create!
+    game.players.create!(name: "ZeroOne")
+    game.players.create!(name: "ZeroTwo")
+
+    game.start!
+    game.end_quiz!
+
+    game.pick_top_winners!
+    assert_empty game.leaderboard_entries.select { |e| e[:winner] }
+
+    game.draw_winners!
+    assert_empty game.leaderboard_entries.select { |e| e[:winner] }
+  end
+
+  private
+
+  def create_question(quiz, body, active:, options:)
+    q = quiz.questions.new
+    assert q.save_with_option_rows(body: body, active: active, option_rows: options)
+    q
+  end
+end
