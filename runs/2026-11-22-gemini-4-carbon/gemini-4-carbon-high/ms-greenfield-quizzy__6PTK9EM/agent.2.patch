+require "application_system_test_case"
+
+class QuizExportAndImportTest < ApplicationSystemTestCase
+  setup do
+    @old_user = ENV["QUIZZY_MODERATOR_USERNAME"]
+    @old_pass = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    @old_exact = Capybara.exact
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "hunter2"
+    Capybara.exact = true
+
+    page.driver.browser.network.authorize(user: "moderator", password: "hunter2") { |r| r.continue }
+  end
+
+  teardown do
+    Capybara.exact = @old_exact
+    ENV["QUIZZY_MODERATOR_USERNAME"] = @old_user
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = @old_pass
+  end
+
+  test "exporting a quiz inside a single <pre> and re-importing creates a new quiz with identical ordered contents" do
+    original = Quiz.create!(title: "Frontend Fest 2026")
+
+    q1 = original.questions.new
+    q1.save_with_option_rows(
+      body: "Which HTTP status code means \"Too Many Requests\"?",
+      active: true,
+      option_rows: [
+        { body: "418", correct: false },
+        { body: "429", correct: true }
+      ]
+    )
+
+    q2 = original.questions.new
+    q2.save_with_option_rows(
+      body: "Which HTML tag shows <pre> & code?",
+      active: false,
+      option_rows: [
+        { body: "<pre>", correct: true },
+        { body: "</pre>", correct: false },
+        { body: "<code>", correct: true }
+      ]
+    )
+
+    visit moderate_quiz_path(original)
+    click_link "Export"
+
+    # Must be the ONLY <pre> element on the page
+    assert_selector "pre", count: 1
+    exported_text = find("pre").text
+    exported_data = JSON.parse(exported_text)
+
+    assert_equal(
+      {
+        "title" => "Frontend Fest 2026",
+        "questions" => [
+          {
+            "text" => "Which HTTP status code means \"Too Many Requests\"?",
+            "active" => true,
+            "options" => [
+              { "text" => "418", "correct" => false },
+              { "text" => "429", "correct" => true }
+            ]
+          },
+          {
+            "text" => "Which HTML tag shows <pre> & code?",
+            "active" => false,
+            "options" => [
+              { "text" => "<pre>", "correct" => true },
+              { "text" => "</pre>", "correct" => false },
+              { "text" => "<code>", "correct" => true }
+            ]
+          }
+        ]
+      },
+      exported_data
+    )
+
+    # Import from /moderate even though "Frontend Fest 2026" already exists
+    visit "/moderate"
+    click_button "Import quiz"
+
+    fill_in "Quiz JSON", with: exported_text
+    click_button "Import"
+
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+    imported = Quiz.order(:id).last
+    assert_not_equal original.id, imported.id
+    assert_current_path moderate_quiz_path(imported)
+
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_text "1 of 2 questions active"
+
+    question_bodies = all("li.question-item .question-item__body").map(&:text)
+    assert_equal [
+      "Which HTTP status code means \"Too Many Requests\"?",
+      "Which HTML tag shows <pre> & code?"
+    ], question_bodies
+
+    within("li.question-item", text: "Which HTML tag shows <pre> & code?") do
+      assert_unchecked_field "Active"
+      assert_selector "li.is-correct", count: 2
+    end
+
+    # Both quizzes appear in their own list items on /moderate
+    visit "/moderate"
+    assert_selector "ul.quiz-list > li", text: "Frontend Fest 2026", count: 2
+  end
+
+  test "importing with omitted active and correct defaults, and showing errors without partial import on invalid JSON" do
+    visit "/moderate"
+    click_button "Import quiz"
+
+    # Invalid JSON syntax -> shows error, preserves input, imports nothing
+    fill_in "Quiz JSON", with: "{broken json"
+    click_button "Import"
+
+    assert_selector ".errors", text: "Invalid JSON"
+    assert_field "Quiz JSON", with: "{broken json"
+    assert_equal 0, Quiz.count
+
+    # Multi-question JSON where Q1 is valid and Q2 breaks question form rule -> nothing imported
+    partial_invalid_json = {
+      title: "Should Not Exist",
+      questions: [
+        {
+          text: "Valid first question?",
+          options: [
+            { text: "Yes", correct: true },
+            { text: "No", correct: false }
+          ]
+        },
+        {
+          text: "Invalid second question without correct answer?",
+          options: [
+            { text: "Option 1" },
+            { text: "Option 2" }
+          ]
+        }
+      ]
+    }.to_json
+
+    fill_in "Quiz JSON", with: partial_invalid_json
+    click_button "Import"
+
+    assert_selector ".errors", text: "Mark at least one option as correct"
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+
+    # Valid JSON relying on defaults (active -> true, correct -> false)
+    valid_minimal_json = {
+      title: "Minimal Import Quiz",
+      questions: [
+        {
+          text: "Port for HTTP?",
+          options: [
+            { text: "22" },
+            { text: "80", correct: true },
+            { text: "443" }
+          ]
+        }
+      ]
+    }.to_json
+
+    fill_in "Quiz JSON", with: valid_minimal_json
+    click_button "Import"
+
+    assert_equal 1, Quiz.count
+    quiz = Quiz.first
+    assert_current_path moderate_quiz_path(quiz)
+    assert_selector "h1", text: "Minimal Import Quiz"
+    assert_text "1 of 1 question active"
+
+    within("li.question-item", text: "Port for HTTP?") do
+      assert_checked_field "Active"
+      option_items = all(".question-item__options li").map(&:text)
+      assert_equal [ "A. 22", "B. 80", "C. 443" ], option_items
+      assert_selector "li.is-correct", count: 1
+      assert_selector "li.is-correct", text: "B. 80"
+    end
+  end
+end
