diff --git a/test/models/quiz_export_and_import_test.rb b/test/models/quiz_export_and_import_test.rb
new file mode 100644
index 0000000..ce09a4a
--- /dev/null
+++ b/test/models/quiz_export_and_import_test.rb
@@ -0,0 +1,233 @@
+require "test_helper"
+
+class QuizExportAndImportTest < ActiveSupport::TestCase
+  test "to_export_json writes exact keys and preserves question and option order" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+
+    q1 = quiz.questions.new
+    assert q1.save_with_option_rows(
+      body: "First added?",
+      active: false,
+      option_rows: [
+        { body: "Opt 1", correct: true },
+        { body: "Opt 2", correct: false },
+        { body: "Opt 3", correct: true }
+      ]
+    )
+
+    q2 = quiz.questions.new
+    assert q2.save_with_option_rows(
+      body: "Which HTTP status code means \"Too Many Requests\"?",
+      active: true,
+      option_rows: [
+        { body: "418", correct: false },
+        { body: "429", correct: true }
+      ]
+    )
+
+    # Reorder so q2 comes before q1
+    q2.move_up!
+
+    parsed = JSON.parse(quiz.to_export_json)
+
+    assert_equal [ "title", "questions" ], parsed.keys
+    assert_equal "Frontend Fest 2026", parsed["title"]
+    assert_equal 2, parsed["questions"].size
+
+    first_q = parsed["questions"][0]
+    assert_equal [ "text", "active", "options" ], first_q.keys
+    assert_equal "Which HTTP status code means \"Too Many Requests\"?", first_q["text"]
+    assert_equal true, first_q["active"]
+    assert_equal [
+      { "text" => "418", "correct" => false },
+      { "text" => "429", "correct" => true }
+    ], first_q["options"]
+    first_q["options"].each { |opt| assert_equal [ "text", "correct" ], opt.keys }
+
+    second_q = parsed["questions"][1]
+    assert_equal [ "text", "active", "options" ], second_q.keys
+    assert_equal "First added?", second_q["text"]
+    assert_equal false, second_q["active"]
+    assert_equal [
+      { "text" => "Opt 1", "correct" => true },
+      { "text" => "Opt 2", "correct" => false },
+      { "text" => "Opt 3", "correct" => true }
+    ], second_q["options"]
+  end
+
+  test "export and import handle empty quiz with zero questions" do
+    quiz = Quiz.create!(title: "Zero Questions Conf")
+    exported = quiz.to_export_json
+    assert_equal({ "title" => "Zero Questions Conf", "questions" => [] }, JSON.parse(exported))
+
+    import = QuizImport.new(exported)
+    assert import.save
+    assert_not_equal quiz.id, import.quiz.id
+    assert_equal "Zero Questions Conf", import.quiz.title
+    assert_equal 0, import.quiz.questions.count
+  end
+
+  test "import applies defaults for omitted active and correct, preserves order, and always creates a new quiz" do
+    existing = Quiz.create!(title: "Frontend Fest 2026")
+
+    json = <<~JSON
+      {
+        "title": "Frontend Fest 2026",
+        "questions": [
+          {
+            "text": "Default active question?",
+            "options": [
+              {"text": "Default wrong"},
+              {"text": "Explicit correct", "correct": true},
+              {"text": "Explicit wrong", "correct": false}
+            ]
+          },
+          {
+            "text": "Inactive multi-correct question?",
+            "active": false,
+            "options": [
+              {"text": "Right A", "correct": true},
+              {"text": "Wrong B"},
+              {"text": "Right C", "correct": true}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    import = QuizImport.new(json)
+    assert import.save, -> { "Expected import to succeed, got errors: #{import.errors.inspect}" }
+
+    imported_quiz = import.quiz
+    assert_not_equal existing.id, imported_quiz.id
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+
+    questions = imported_quiz.questions.includes(:options).to_a
+    assert_equal [ "Default active question?", "Inactive multi-correct question?" ], questions.map(&:body)
+    assert_equal [ true, false ], questions.map(&:active?)
+
+    assert_equal [ "Default wrong", "Explicit correct", "Explicit wrong" ], questions[0].options.map(&:body)
+    assert_equal [ false, true, false ], questions[0].options.map(&:correct?)
+
+    assert_equal [ "Right A", "Wrong B", "Right C" ], questions[1].options.map(&:body)
+    assert_equal [ true, false, true ], questions[1].options.map(&:correct?)
+  end
+
+  test "invalid JSON or rule violations import nothing at all" do
+    invalid_payloads = [
+      "",
+      "   ",
+      "{not valid json",
+      "null",
+      "false",
+      "true",
+      "123",
+      "\"just a string\"",
+      "[]",
+      "{}",
+      { title: "   ", questions: [] }.to_json,
+      { title: 123, questions: [] }.to_json,
+      { title: "No questions key" }.to_json,
+      { title: "Null questions", questions: nil }.to_json,
+      { title: "Object questions", questions: {} }.to_json,
