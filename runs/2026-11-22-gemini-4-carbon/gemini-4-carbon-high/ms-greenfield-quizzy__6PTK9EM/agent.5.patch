--- /dev/null
+++ b/test/models/question_timer_test.rb
@@ -0,0 +1,172 @@
+require "test_helper"
+
+class QuestionTimerTest < ActiveSupport::TestCase
+  include ActiveSupport::Testing::TimeHelpers
+  include ApplicationHelper
+
+  setup do
+    @quiz = Quiz.create!(title: "Timed Talk 2026")
+    @q1 = create_question(@quiz, "First Question?", active: true, options: [
+      { body: "Q1 Right", correct: true },
+      { body: "Q1 Wrong", correct: false }
+    ])
+    @q2 = create_question(@quiz, "Second Question?", active: true, options: [
+      { body: "Q2 Right", correct: true },
+      { body: "Q2 Wrong", correct: false }
+    ])
+  end
+
+  test "timer_minutes and timer_seconds default to 0 and validate integer bounds" do
+    fresh = Quiz.create!(title: "Untimed Quiz")
+    assert_equal 0, fresh.timer_minutes
+    assert_equal 0, fresh.timer_seconds
+    assert_equal 0, fresh.timer_duration_seconds
+    assert_not fresh.timer_enabled?
+
+    [ -1, -10, nil, "", "abc", 1.5 ].each do |bad_min|
+      fresh.timer_minutes = bad_min
+      fresh.timer_seconds = 0
+      assert_not fresh.valid?, "Expected timer_minutes=#{bad_min.inspect} to be invalid"
+    end
+
+    [ -1, 60, 90, nil, "", "abc", 2.5 ].each do |bad_sec|
+      fresh.timer_minutes = 0
+      fresh.timer_seconds = bad_sec
+      assert_not fresh.valid?, "Expected timer_seconds=#{bad_sec.inspect} to be invalid"
+    end
+
+    [ [ 0, 0 ], [ 0, 5 ], [ 1, 30 ], [ 10, 59 ] ].each do |min, sec|
+      fresh.timer_minutes = min
+      fresh.timer_seconds = sec
+      assert fresh.valid?, "Expected #{min}:#{sec} to be valid"
+    end
+  end
+
+  test "timer settings are excluded from export JSON and default to 0 on import" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+
+    exported_hash = @quiz.as_export_json
+    exported_str = @quiz.to_export_json
+
+    assert_equal [ "questions", "title" ], exported_hash.keys.sort
+    assert_no_match(/timer/i, exported_str)
+
+    # Importing exported JSON creates a quiz with 0:00 timer
+    imp = QuizImport.new(exported_str)
+    assert imp.save
+    assert_equal 0, imp.quiz.timer_minutes
+    assert_equal 0, imp.quiz.timer_seconds
+
+    # Even if external JSON includes extra timer keys, import ignores them and defaults to 0:00
+    extra_json = JSON.generate(exported_hash.merge("timer_minutes" => 2, "timer_seconds" => 15))
+    imp_extra = QuizImport.new(extra_json)
+    assert imp_extra.save
+    assert_equal 0, imp_extra.quiz.timer_minutes
+    assert_equal 0, imp_extra.quiz.timer_seconds
+  end
+
+  test "0 minutes and 0 seconds means no timer and never auto-finishes" do
+    assert_equal 0, @quiz.timer_duration_seconds
+    game = @quiz.games.create!
+    alice = game.players.create!(name: "Alice")
+    right_opt = @q1.options.find_by!(correct: true)
+
+    t0 = Time.utc(2026, 11, 21, 14, 0, 0)
+    travel_to(t0) { game.start! }
+
+    gq = game.reload.current_game_question
+    assert_equal 0, gq.duration_seconds
+    assert_nil gq.closes_at
+
+    mod_payload = game.moderator_state_payload
+    assert_nil mod_payload[:timer_duration_seconds]
+    assert_nil mod_payload[:timer_remaining_ms]
+
+    travel_to(t0 + 15.minutes) do
+      assert_not game.expire_open_question_if_due!
+      assert game.reload.question_open?
+      assert_equal right_opt.id, game.submit_answer!(player: alice, option_id: right_opt.id, game_question_id: gq.id)
+    end
+  end
+
+  test "M:SS countdown format, no timer leaked to players, reload preserves deadline, and 0:00 closes question and blocks late answers" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    game = @quiz.games.create!
+    alice = game.players.create!(name: "Alice")
+    bob = game.players.create!(name: "Bob")
+
+    q1_right = @q1.options.find_by!(correct: true)
+    q2_right = @q2.options.find_by!(correct: true)
+
+    t0 = Time.utc(2026, 11, 21, 15, 0, 0)
+
+    travel_to(t0) do
+      game.start!
+      mod = game.moderator_state_payload
+      assert_equal 90, mod[:timer_duration_seconds]
+      assert_equal 90_000, mod[:timer_remaining_ms]
+      assert_equal "1:30", format_countdown_ms(mod[:timer_remaining_ms], mod[:timer_duration_seconds])
+
+      # Players never receive timer data
+      pub_payload = game.public_player_broadcast_payload
+      alice_payload = game.player_state_payload_for(alice)
+      [ pub_payload, alice_payload ].each do |p|
+        assert_nil p[:timer_duration_seconds]
+        assert_nil p[:timer_remaining_ms]
+        assert_nil p[:closes_at]
+      end
+    end
+
+    # 25 seconds later: remaining is 65s ("1:05"), Alice answers
+    travel_to(t0 + 25.seconds) do
+      mod = game.reload.moderator_state_payload
+      assert_equal 65_000, mod[:timer_remaining_ms]
+      assert_equal "1:05", format_countdown_ms(mod[:timer_remaining_ms], mod[:timer_duration_seconds])
+      assert_equal q1_right.id, game.submit_answer!(player: alice, option_id: q1_right.id)
+    end
+
+    # 85 seconds after open: remaining is 5s ("0:05")
+    travel_to(t0 + 85.seconds) do
+      mod = game.reload.moderator_state_payload
+      assert_equal 5_000, mod[:timer_remaining_ms]
+      assert_equal "0:05", format_countdown_ms(mod[:timer_remaining_ms], mod[:timer_duration_seconds])
+    end
+
+    # Exactly at 90s (0:00): Bob tries to submit late answer -> auto-closes question and rejects Bob's late answer
+    travel_to(t0 + 90.seconds) do
+      assert_nil game.submit_answer!(player: bob, option_id: q1_right.id)
+      assert game.reload.question_closed?
+      assert_equal 1, game.current_game_question.answers.count
+
+      # Closed state omits timer
+      closed_mod = game.moderator_state_payload
+      assert_nil closed_mod[:timer_duration_seconds]
+      assert_nil closed_mod[:timer_remaining_ms]
+    end
+
+    # Next question opens with a fresh 1:30 timer; auto-expiration on last question closes (not finishes) the quiz
+    t1 = t0 + 100.seconds
+    travel_to(t1) do
+      game.next_question!
+      assert game.reload.question_open?
+      mod = game.moderator_state_payload
+      assert_equal 90_000, mod[:timer_remaining_ms]
+      assert_equal "1:30", format_countdown_ms(mod[:timer_remaining_ms], mod[:timer_duration_seconds])
+      assert_equal q2_right.id, game.submit_answer!(player: bob, option_id: q2_right.id)
+    end
+
+    travel_to(t1 + 90.seconds) do
+      assert game.expire_open_question_if_due!
+      assert game.reload.question_closed?
+      assert game.moderator_state_payload[:is_last_question]
+    end
+  end
+
+  private
+
+  def create_question(quiz, body, active:, options:)
+    q = quiz.questions.new
+    assert q.save_with_option_rows(body: body, active: active, option_rows: options)
+    q
+  end
+end
