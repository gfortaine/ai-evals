+require "application_system_test_case"
+
+class QuestionTimerTest < ApplicationSystemTestCase
+  setup do
+    @old_user = ENV["QUIZZY_MODERATOR_USERNAME"]
+    @old_pass = ENV["QUIZZY_MODERATOR_PASSWORD"]
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "hunter2"
+  end
+
+  teardown do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = @old_user
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = @old_pass
+  end
+
+  test "quiz settings default to 0 minutes and 0 seconds (no timer), export omits timer, and 1:30 timer shows on big screen only and can finish early" do
+    old_exact = Capybara.exact
+    Capybara.exact = true
+
+    quiz = Quiz.create!(title: "Lightning Talks 2026")
+    create_question(quiz, "First Timed Question?", active: true, options: [
+      { body: "Alpha Right", correct: true },
+      { body: "Beta Wrong", correct: false }
+    ])
+    create_question(quiz, "Second Timed Question?", active: true, options: [
+      { body: "Gamma Right", correct: true },
+      { body: "Delta Wrong", correct: false }
+    ])
+
+    # Verify default 0 minutes / 0 seconds shows NO timer on big screen
+    Capybara.using_session(:moderator) do
+      authorize_moderator!
+      visit moderate_quiz_path(quiz)
+      click_link "Settings"
+
+      assert_field "Timer minutes", with: "0"
+      assert_field "Timer seconds", with: "0"
+      click_link "Cancel"
+
+      click_button "Start a game"
+      assert_no_selector ".stage-timer"
+      click_button "Start"
+      assert_text "Question 1 of 2"
+      assert_no_selector ".stage-timer"
+      assert_no_text "0:00"
+      click_link "← Back to quiz"
+    end
+
+    # Configure 1 minute 30 seconds ("1:30") in Settings and verify persistence + Export omission
+    Capybara.using_session(:moderator) do
+      click_link "Settings"
+      fill_in "Timer minutes", with: "1"
+      fill_in "Timer seconds", with: "30"
+      click_button "Save quiz"
+
+      assert_equal 1, quiz.reload.timer_minutes
+      assert_equal 30, quiz.timer_seconds
+
+      click_link "Settings"
+      assert_field "Timer minutes", with: "1"
+      assert_field "Timer seconds", with: "30"
+      click_link "Cancel"
+
+      click_link "Export"
+      exported_text = find("pre.export-json").text
+      exported_data = JSON.parse(exported_text)
+      assert_equal [ "questions", "title" ], exported_data.keys.sort
+      assert_no_match(/timer/i, exported_text)
+      click_link "← Lightning Talks 2026"
+    end
+
+    join_url = nil
+    Capybara.using_session(:moderator) do
+      click_button "Start a game"
+      join_url = find(".lobby__url").text
+      assert_no_selector ".stage-timer"
+    end
+
+    Capybara.using_session(:alice) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    # Start Question 1 -> big screen shows 1:30 countdown; Alice's phone does NOT show timer
+    Capybara.using_session(:moderator) do
+      click_button "Start"
+      within(".screen") do
+        assert_text "Question 1 of 2"
+        assert_selector ".stage-timer", text: /\A1:(30|29)\z/
+      end
+    end
+
+    Capybara.using_session(:alice) do
+      assert_text "First Timed Question?"
+      assert_no_selector ".stage-timer"
+      assert_no_text(/\b1:(30|29|28)\b/)
+      assert_no_match(/timer/i, page.html)
+      click_button "Alpha Right"
+      within("button", text: /Alpha Right/) { assert_text "Your answer" }
+    end
+
+    # Wait until timer ticks down to 1:28, then reload moderator page and verify it does NOT restart to 1:30 or 1:29
+    Capybara.using_session(:moderator) do
+      within(".screen") do
+        assert_selector ".stage-timer", text: "1:28", wait: 4.0
+      end
+
+      visit current_path
+      within(".screen") do
+        assert_text "Question 1 of 2"
+        timer_text = find(".stage-timer").text
+        assert_match(/\A1:2[0-8]\z/, timer_text, "Reloading page must not restart 1:30 countdown, got #{timer_text}")
+      end
+
+      # Moderator can still click "Finish" earlier; timer disappears on closed question
+      click_button "Finish"
+      assert_no_selector ".stage-timer"
+      assert_text "Correct"
+      assert_button "Next"
+    end
+
+    Capybara.using_session(:alice) do
+      assert_text "Correct!"
+    end
+
+    # Setting Timer minutes and Timer seconds back to 0 disables the timer again
+    Capybara.using_session(:moderator) do
+      click_link "← Back to quiz"
+      click_link "Settings"
+      fill_in "Timer minutes", with: "0"
+      fill_in "Timer seconds", with: "0"
+      click_button "Save quiz"
+
+      click_button "Start a game"
+      click_button "Start"
+      assert_text "Question 1 of 2"
+      assert_no_selector ".stage-timer"
+    end
+  ensure
+    Capybara.exact = old_exact
+  end
+
+  test "countdown ticks in M:SS (0:04 -> 0:00), reload does not restart it, and at 0:00 question finishes by itself even without Finish click" do
+    quiz = Quiz.create!(title: "Auto Finish Conf", timer_minutes: 0, timer_seconds: 4)
+    create_question(quiz, "Fast Q1?", active: true, options: [
+      { body: "Q1 Right", correct: true },
+      { body: "Q1 Wrong", correct: false }
+    ])
+    create_question(quiz, "Fast Q2?", active: true, options: [
+      { body: "Q2 Right", correct: true },
+      { body: "Q2 Wrong", correct: false }
+    ])
+
+    join_url = nil
+    game_url = nil
+
+    Capybara.using_session(:moderator) do
+      authorize_moderator!
+      visit moderate_quiz_path(quiz)
+      click_button "Start a game"
+      join_url = find(".lobby__url").text
+      game_url = current_path
+    end
+
+    { alice: "Alice", bob: "Bob" }.each do |sess, name|
+      Capybara.using_session(sess) do
+        visit join_url
+        fill_in "Your name", with: name
+        click_button "Join"
+        assert_text "Hi, #{name}!"
+      end
+    end
+
+    # Open Q1 (4-second timer)
+    Capybara.using_session(:moderator) do
+      click_button "Start"
+      within(".screen") do
+        assert_selector ".stage-timer", text: /\A0:0[34]\z/
+      end
+    end
+
+    # Alice answers in time; Bob does not answer; neither sees the timer
+    Capybara.using_session(:alice) do
+      assert_text "Fast Q1?"
+      assert_no_text(/\b0:0[1-4]\b/)
+      click_button "Q1 Right"
+      within("button", text: /Q1 Right/) { assert_text "Your answer" }
+    end
+
+    # Reload moderator page mid-countdown (~1.3s elapsed) -> still finishes ~2.7s later (not 4s after reload!)
+    sleep 1.3
+    reload_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+    Capybara.using_session(:moderator) do
+      visit game_url
+      within(".screen") do
+        assert_selector ".stage-timer", text: /\A0:0[1-3]\z/
+      end
+
+      # Wait for automatic finish at 0:00 without clicking Finish!
+      assert_button "Next", wait: 4.5
+      elapsed_since_reload = Process.clock_gettime(Process::CLOCK_MONOTONIC) - reload_at
+      assert elapsed_since_reload < 3.8, "Expected timer not to restart on reload (took #{elapsed_since_reload.round(2)}s after reload)"
+      assert_no_selector ".stage-timer"
+      assert_text "Correct"
+    end
+
+    # Both players automatically transitioned to closed results at 0:00
+    Capybara.using_session(:alice) { assert_text "Correct!" }
+    Capybara.using_session(:bob)   { assert_text "No answer" }
+
+    # Now test server-driven auto-finish on Q2 even if moderator navigates away from big screen!
+    Capybara.using_session(:moderator) do
+      click_button "Next"
+      within(".screen") do
+        assert_text "Question 2 of 2"
+        assert_selector ".stage-timer", text: /\A0:0[34]\z/
+      end
+      visit moderate_quiz_path(quiz)
+      assert_selector "h1", text: "Auto Finish Conf"
+    end
+
+    # Bob answers Q2 before 0:00; server auto-finishes Q2 at 0:00 and pushes results to phones!
+    Capybara.using_session(:bob) do
+      assert_text "Fast Q2?"
+      click_button "Q2 Right"
+      assert_text "Correct!", wait: 5.5
+    end
+    Capybara.using_session(:alice) do
+      assert_text "No answer", wait: 5.5
+    end
+
+    # Moderator returns to game big screen -> Q2 is closed and shows "End quiz"
+    Capybara.using_session(:moderator) do
+      visit game_url
+      assert_no_selector ".stage-timer"
+      assert_button "End quiz"
+      click_button "End quiz"
+      assert_text "The quiz is over"
+    end
+  end
+
+  test "finishing Q1 early cancels Q1 timer so it never prematurely closes Q2" do
+    quiz = Quiz.create!(title: "Early Finish Safety", timer_minutes: 0, timer_seconds: 3)
+    create_question(quiz, "Safety Q1?", active: true, options: [
+      { body: "Right 1", correct: true },
+      { body: "Wrong 1", correct: false }
+    ])
+    create_question(quiz, "Safety Q2?", active: true, options: [
