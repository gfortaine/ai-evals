diff --git a/spec/support/redis.rb b/spec/support/redis.rb
new file mode 100644
index 0000000..18362e5
--- /dev/null
+++ b/spec/support/redis.rb
@@ -0,0 +1,33 @@
+# frozen_string_literal: true
+
+module RedisTestTracker
+  IGNORED_COMMANDS = %w(flushdb ping select hello auth client info).freeze
+
+  class << self
+    attr_accessor :dirty
+
+    def flush_if_dirty!
+      return unless dirty
+
+      RedisConnection.with(&:flushdb)
+      self.dirty = false
+    end
+  end
+
+  self.dirty = false
+
+  module Middleware
+    def call(command, _config)
+      cmd = command.first.to_s.downcase
+      RedisTestTracker.dirty = true unless RedisTestTracker::IGNORED_COMMANDS.include?(cmd)
+      super
+    end
+
+    def call_pipelined(commands, _config)
+      RedisTestTracker.dirty = true if commands.any?
+      super
+    end
+  end
+end
+
+RedisClient.register(RedisTestTracker::Middleware)
diff --git a/spec/support/test_prof.rb b/spec/support/test_prof.rb
new file mode 100644
index 0000000..77192f9
--- /dev/null
+++ b/spec/support/test_prof.rb
@@ -0,0 +1,31 @@
+# frozen_string_literal: true
+
+require 'test_prof/recipes/rspec/before_all'
+require 'test_prof/recipes/rspec/let_it_be'
+
+TestProf::LetItBe.configure do |config|
+  config.default_modifiers[:refind] = true
+end
+
+TestProf::BeforeAll.configure do |config|
+  config.before(:begin) do |scope|
+    metadata = scope.respond_to?(:metadata) ? scope.metadata : {}
+    mode = metadata[:sidekiq] || (metadata[:type] == :model ? :fake : :inline)
+    Sidekiq.testing!(mode)
+
+    if metadata[:type] == :model
+      PaperclipTestOptimization.skip_post_process_styles = !metadata[:paperclip_processing]
+      DomainMaterializableTestOptimization.skip_refresh = !metadata[:refresh_instances_view]
+    end
+  end
+
+  config.after(:begin) do
+    PaperclipTestOptimization.skip_post_process_styles = false
+    DomainMaterializableTestOptimization.skip_refresh = false
+  end
+
+  config.after(:rollback) do
+    Rails.cache.clear
+    RedisTestTracker.flush_if_dirty!
+  end
+end
