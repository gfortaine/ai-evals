@@ -0,0 +1,27 @@
+# frozen_string_literal: true
+
+module DomainMaterializableTestOptimization
+  class << self
+    attr_accessor :skip_refresh
+  end
+
+  self.skip_refresh = false
+
+  def refresh_instances_view
+    return if DomainMaterializableTestOptimization.skip_refresh
+
+    super
+  end
+end
+
+DomainMaterializable.prepend(DomainMaterializableTestOptimization)
+
+RSpec.configure do |config|
+  config.around(:each, type: :model) do |example|
+    previous = DomainMaterializableTestOptimization.skip_refresh
+    DomainMaterializableTestOptimization.skip_refresh = !example.metadata[:refresh_instances_view]
+    example.run
+  ensure
+    DomainMaterializableTestOptimization.skip_refresh = previous
+  end
+end
