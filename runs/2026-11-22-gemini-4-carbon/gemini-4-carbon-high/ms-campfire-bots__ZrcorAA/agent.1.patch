+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  test "unauthenticated users are redirected to sign in" do
+    get bots_url
+    assert_redirected_to new_session_url
+  end
+
+  test "account edit page shows Set up chat bots link to members and admins and hides bots from people list" do
+    bot = User.bot.create!(name: "Secret Deploy Bot", creator: users(:kevin))
+
+    sign_in :kevin
+    get edit_account_url
+    assert_response :ok
+    assert_select "a[href=?]", bots_path, text: /Set up chat bots/
+    assert_select "turbo-frame#account_users", text: /Secret Deploy Bot/, count: 0
+
+    sign_in :david
+    get edit_account_url
+    assert_response :ok
+    assert_select "a[href=?]", bots_path, text: /Set up chat bots/
+    assert_select "turbo-frame#account_users", text: /Secret Deploy Bot/, count: 0
+  end
+
+  test "index lists only own bots for regular members and all bots for administrators without pagination" do
+    kevin_bot = User.bot.create!(name: "Kevin Deploy Bot", creator: users(:kevin))
+    jz_bot = User.bot.create!(name: "JZ Alert Bot", creator: users(:jz))
+    deleted_bot = User.bot.create!(name: "Deleted Bot", creator: users(:kevin)).tap(&:deactivate)
+
+    sign_in :kevin
+    get bots_url
+    assert_response :ok
+    assert_includes response.headers["Cache-Control"], "no-store"
+    assert_select "a[href=?]", new_bot_path, text: /Add a chat bot/
+
+    assert_select "li##{dom_id(kevin_bot)}" do
+      assert_select "strong", text: "Kevin Deploy Bot"
+      assert_select "label[for=?]", dom_id(kevin_bot, :bot_code), text: "Bot code"
+      assert_select "input##{dom_id(kevin_bot, :bot_code)}[readonly][value=?]", kevin_bot.bot_key
+      assert_select "a[href=?]", edit_bot_path(kevin_bot), text: "Edit Kevin Deploy Bot"
+    end
+    assert_select "li##{dom_id(jz_bot)}", count: 0
+    assert_select "li##{dom_id(deleted_bot)}", count: 0
+
+    sign_in :david
+    25.times { |i| User.bot.create!(name: "Extra Bot #{i}", creator: users(:jz)) }
+    get bots_url
+    assert_response :ok
+    assert_select "li##{dom_id(kevin_bot)}"
+    assert_select "li##{dom_id(jz_bot)}"
+    assert_select "li##{dom_id(deleted_bot)}", count: 0
+    assert_select "menu li", count: 27
+  end
+
+  test "new renders bot creation form with required labels" do
+    sign_in :kevin
+    get new_bot_url
+    assert_response :ok
+
+    assert_select "form[action=?]", bots_path do
+      assert_select "input[type=file][name='bot[avatar]']"
+      assert_select "label", text: /Name the bot/
+      assert_select "input[name='bot[name]'][placeholder='Name the bot'][required]"
+      assert_select "button[type=submit]", text: /Save changes/
+    end
+  end
+
+  test "create creates a bot with optional avatar, joins open rooms, and redirects to /bots" do
+    sign_in :kevin
+
+    assert_difference -> { User.active_bots.count }, +1 do
+      post bots_url, params: {
+        bot: {
+          name: "Deploy Bot",
+          avatar: fixture_file_upload("moon.jpg", "image/jpeg")
+        }
+      }
+    end
+
+    assert_redirected_to bots_url
+    bot = User.active_bots.last
+    assert_equal "Deploy Bot", bot.name
+    assert_equal users(:kevin), bot.creator
+    assert bot.avatar.attached?
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+  end
+
+  test "create rejects blank name" do
+    sign_in :kevin
+
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: "" } }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "edit renders form and Delete this chat bot button with confirmation" do
+    bot = User.bot.create!(name: "Deploy Bot", creator: users(:kevin))
+
+    sign_in :kevin
+    get edit_bot_url(bot)
+    assert_response :ok
+
+    assert_select "form[action=?]", bot_path(bot) do
+      assert_select "input[name='bot[name]'][value='Deploy Bot']"
+      assert_select "button[type=submit]", text: /Save changes/
+    end
+    assert_select "form[action=?] button[data-turbo-confirm]", bot_path(bot), text: /Delete this chat bot/
+  end
+
+  test "creator and administrator can update a bot, preserving existing avatar and bot_key" do
+    bot = User.bot.create!(
+      name: "Deploy Bot",
+      creator: users(:kevin),
+      avatar: fixture_file_upload("moon.jpg", "image/jpeg")
+    )
+    original_key = bot.bot_key
+
+    sign_in :kevin
+    patch bot_url(bot), params: { bot: { name: "CI Bot", avatar: "" } }
+    assert_redirected_to bots_url
+    assert_equal "CI Bot", bot.reload.name
+    assert bot.avatar.attached?
+    assert_equal original_key, bot.bot_key
+
+    sign_in :david
+    patch bot_url(bot), params: { bot: { name: "Admin Renamed Bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Admin Renamed Bot", bot.reload.name
+  end
+
+  test "other non-admin members cannot edit, update, or delete someone else's bot" do
+    bot = User.bot.create!(name: "Deploy Bot", creator: users(:kevin))
+
+    sign_in :jz
+
+    get edit_bot_url(bot)
+    assert_response :forbidden
+    assert_empty response.body
+
+    patch bot_url(bot), params: { bot: { name: "Hacked" } }
+    assert_response :forbidden
+    assert_equal "Deploy Bot", bot.reload.name
+
+    delete bot_url(bot)
+    assert_response :forbidden
+    assert bot.reload.active?
+  end
+
+  test "destroy deactivates bot and redirects to /bots" do
+    bot = User.bot.create!(name: "Deploy Bot", creator: users(:kevin))
+
+    sign_in :kevin
+    delete bot_url(bot)
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+
+    assert_raises ActiveRecord::RecordNotFound do
+      get edit_bot_url(bot)
+    end
+  end
+
+  test "human users cannot be accessed via bots controller" do
+    sign_in :david
+    assert_raises ActiveRecord::RecordNotFound do
+      get edit_bot_url(users(:kevin))
+    end
+  end
+
+  test "bots can be added to closed rooms and direct rooms like people" do
+    bot = User.bot.create!(name: "Deploy Bot", creator: users(:kevin))
+
+    sign_in :david
+    get edit_rooms_closed_url(rooms(:designers))
+    assert_response :ok
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "input[type=checkbox][name='user_ids[]'][value=?]", bot.id.to_s
+    end
+
+    put rooms_closed_url(rooms(:designers)), params: {
+      room: { name: "Designers" },
+      user_ids: rooms(:designers).user_ids + [ bot.id ]
+    }
+    assert_includes rooms(:designers).reload.users, bot
+
+    get autocompletable_users_url(format: :json), params: { query: "Deploy" }
+    assert_response :ok
+    assert_includes response.parsed_body.map { |u| u["value"] }, bot.id
+
+    post rooms_directs_url, params: { user_ids: [ bot.id ] }
+    direct_room = Room.last
+    assert_includes direct_room.users, bot
+    assert_includes direct_room.users, users(:david)
+  end
+end
