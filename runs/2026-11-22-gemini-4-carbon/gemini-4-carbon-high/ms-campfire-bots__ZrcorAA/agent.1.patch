diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..72ee1ed
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,54 @@
+class Bots::MessagesController < ActionController::Base
+  include ActiveStorage::SetCurrent, BlockBannedRequests, SetCurrentRequest, VersionHeaders
+
+  skip_forgery_protection
+
+  before_action :authenticate_bot
+  before_action :set_room
+
+  rescue_from ActiveRecord::RecordNotFound, with: -> { head :not_found }
+  rescue_from ActiveRecord::RecordInvalid, with: -> { head :unprocessable_content }
+
+  def self.dispatch(name, req, res)
+    unless req.content_mime_type&.symbol == :multipart_form
+      req.set_header("action_dispatch.request.request_parameters", {})
+    end
+
+    super
+  end
+
+  def create
+    @message = @room.messages.create_with_attachment!(message_params)
+    @message.broadcast_create
+
+    head :created, location: message_path(@message)
+  end
+
+  private
+    def authenticate_bot
+      if bot = User.authenticate_bot(params[:bot_code])
+        Current.user = bot
+      else
+        head :unauthorized
+      end
+    end
+
+    def set_room
+      @room = Current.user.rooms.find(params[:room_id])
+    end
+
+    def message_params
+      if request.content_mime_type&.symbol == :multipart_form
+        attachment = params[:attachment] if params[:attachment].is_a?(ActionDispatch::Http::UploadedFile)
+        body = ERB::Util.html_escape(params[:body].to_s).gsub(/\r?\n/, "<br>")
+        { attachment: attachment, body: body }.compact
+      else
+        { body: formatted_body }
+      end
+    end
+
+    def formatted_body
+      raw = request.raw_post.dup.force_encoding(Encoding::UTF_8).scrub
+      ERB::Util.html_escape(raw).gsub(/\r?\n/, "<br>")
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..ad23f38
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,65 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+  before_action :ensure_can_administer, only: %i[ edit update destroy ]
+
+  def index
+    no_store
+    @bots = accessible_bots.with_attached_avatar.ordered
+  end
+
+  def new
+    @bot = User.new(role: :bot)
+  end
+
+  def create
+    @bot = User.new(**bot_params, role: :bot, creator: Current.user)
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      @bot.touch
+      @bot.messages.touch_all
+      @bot.rooms.touch_all
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url
+  end
+
+  private
+    def accessible_bots
+      if Current.user.administrator?
+        User.active_bots
+      else
+        Current.user.bots.active
+      end
+    end
+
+    def set_bot
+      @bot = User.active_bots.find(params[:id])
+    end
+
+    def ensure_can_administer
+      head :forbidden unless Current.user.can_administer?(@bot)
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar).tap do |permitted|
+        permitted.delete(:avatar) if permitted[:avatar].blank?
+      end
+    end
+end
