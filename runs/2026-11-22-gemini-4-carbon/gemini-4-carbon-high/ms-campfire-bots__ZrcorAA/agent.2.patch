--- a/app/models/message/mentionee.rb
+++ b/app/models/message/mentionee.rb
@@ -5,6 +5,27 @@ module Message::Mentionee
     room.users.where(id: mentioned_users.map(&:id))
   end
 
+  def mentioned_bots
+    creator.bot? ? User.none : mentionees.active_bots
+  end
+
+  def plain_text_without_mention_of(user)
+    return "" unless body.body
+
+    sentinel = "\uFFFC__MENTION_#{SecureRandom.hex(8)}__\uFFFC"
+    pattern = Regexp.escape(sentinel)
+
+    text = body.body.render_attachments(with_full_attributes: false) do |attachment|
+      attachment.attachable == user ? sentinel : attachment.to_plain_text
+    end.fragment.to_plain_text
+
+    text = text.gsub(/(?:^|(?<=\n))[ \t\u00a0]*(?:#{pattern}[ \t\u00a0]*)+/, "")
+    text = text.gsub(/[ \t\u00a0]*(?:#{pattern}[ \t\u00a0]*)+(?=\n|\z)/, "")
+    text = text.gsub(/([ \t\u00a0]+)(?:#{pattern}[ \t\u00a0]*)+/, "\\1")
+    text = text.gsub(/[ \t\u00a0]*#{pattern}/, "")
+    text.gsub(/\A[\s\u00a0]+|[\s\u00a0]+\z/, "")
+  end
+
   private
     def mentioned_users
       if body.body
