diff --git a/app/models/user/bot/webhook.rb b/app/models/user/bot/webhook.rb
new file mode 100644
index 0000000..23d1031
--- /dev/null
+++ b/app/models/user/bot/webhook.rb
@@ -0,0 +1,139 @@
+require "net/http"
+
+class User::Bot::Webhook
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 15
+  WRITE_TIMEOUT = 5
+  MAX_RESPONSE_SIZE = 5.megabytes
+
+  attr_reader :bot
+
+  def initialize(bot)
+    @bot = bot
+  end
+
+  def deliver(message, event: "mention")
+    return unless deliverable_for?(message)
+
+    uri = URI.parse(bot.webhook_url)
+    response, body = post_json(uri, payload_for(message, event: event))
+    handle_response(response, body, message) if response
+  rescue StandardError, SocketError, IOError, OpenSSL::SSL::SSLError, Timeout::Error => e
+    Rails.logger.warn "Failed to deliver webhook for bot #{bot.id} to #{bot.webhook_url}: #{e.class} #{e.message}"
+  end
+
+  def payload_for(message, event: "mention")
+    room = message.room
+
+    {
+      event: event.to_s,
+      author: {
+        id: message.creator.id,
+        name: message.creator.name
+      },
+      room: {
+        id: room.id,
+        name: room_name_for(room),
+        reply_to: url_helpers.room_bot_messages_path(room, bot.bot_key)
+      },
+      message: {
+        id: message.id,
+        body: {
+          text: message.plain_text_without_mention_of(bot),
+          html: message.body.body&.to_html.to_s
+        },
+        link: url_helpers.room_at_message_path(room, message)
+      }
+    }
+  end
+
+  private
+    def deliverable_for?(message)
+      bot.webhook_configured? && bot.bot_key.present? && !message.creator.bot? && message.room.users.include?(bot)
+    end
+
+    def room_name_for(room)
+      if room.direct?
+        room.users.without(bot).pluck(:name).to_sentence.presence || bot.name
+      else
+        room.name
+      end
+    end
+
+    def url_helpers
+      Rails.application.routes.url_helpers
+    end
+
+    def post_json(uri, payload)
+      request = Net::HTTP::Post.new(uri)
+      request["Content-Type"] = "application/json"
+      request.body = JSON.generate(payload)
+
+      Net::HTTP.start(
+        uri.hostname,
+        uri.port,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT,
+        write_timeout: WRITE_TIMEOUT
+      ) do |http|
+        http.request(request) do |response|
+          body = read_limited_body(response)
+          return [ response, body ]
+        end
+      end
+    end
+
+    def read_limited_body(response)
+      return "" if response.is_a?(Net::HTTPNoContent)
+
+      buffer = +""
+      response.read_body do |chunk|
+        return nil if buffer.bytesize + chunk.bytesize > MAX_RESPONSE_SIZE
+        buffer << chunk
+      end
+      buffer
+    end
+
+    def handle_response(response, raw_body, message)
+      case response.code
+      when "204"
+        nil
+      when "200"
+        post_reply(message, response, raw_body) if raw_body.present?
+      end
+    end
+
+    def post_reply(message, response, raw_body)
+      formatted = case response.content_type&.downcase
+      when "text/plain"
+        ERB::Util.html_escape(decode_body(response, raw_body)).gsub(/\r?\n/, "<br>")
+      when "text/html"
+        decode_body(response, raw_body)
+      else
+        return
+      end
+
+      return if formatted.blank?
+
+      room = message.room
+      return unless bot.reload.active? && room.reload.users.include?(bot)
+
+      reply = room.messages.new(
+        creator: bot,
+        body: formatted,
+        created_at: [ Time.current, message.created_at + 0.001.seconds ].max
+      )
+      reply.broadcast_create if reply.save
+    end
+
+    def decode_body(response, raw_body)
+      body = raw_body.dup
+      if charset = response.type_params["charset"]
+        if encoding = (Encoding.find(charset) rescue nil)
+          return body.force_encoding(encoding).encode(Encoding::UTF_8, invalid: :replace, undef: :replace)
+        end
+      end
+      body.force_encoding(Encoding::UTF_8).scrub
+    end
+end
