diff --git a/app/javascript/controllers/form_controller.js b/app/javascript/controllers/form_controller.js
index 80b2727..3b5d1c0 100644
--- a/app/javascript/controllers/form_controller.js
+++ b/app/javascript/controllers/form_controller.js
@@ -1,12 +1,93 @@
 import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
 
 export default class extends Controller {
   static targets = [ "cancel" ]
 
+  connect() {
+    this.boundBeforeVisit = this.beforeVisit.bind(this)
+    document.addEventListener("turbo:before-visit", this.boundBeforeVisit)
+  }
+
+  disconnect() {
+    this.clearSaveTimer()
+    document.removeEventListener("turbo:before-visit", this.boundBeforeVisit)
+  }
+
   submit() {
+    this.clearSaveTimer()
+    this.submitting = true
     this.element.requestSubmit()
   }
 
+  prepareSubmit() {
+    this.clearSaveTimer()
+    this.clickingSubmit = true
+    setTimeout(() => { this.clickingSubmit = false }, 500)
+  }
+
+  submitEnd() {
+    this.submitting = false
+    this.clickingSubmit = false
+  }
+
+  saveLater(event) {
+    this.clearSaveTimer()
+    if (!event.target.validity.valid) return
+
+    this.saveTimer = setTimeout(() => {
+      this.saveTimer = null
+      this.saveInBackground()
+    }, 150)
+  }
+
+  saveNow(event) {
+    this.clearSaveTimer()
+    if (this.clickingSubmit || this.submitting) return
+    if (!event.target.validity.valid) return
+
+    this.saveInBackground()
+  }
+
+  saveInBackground() {
+    if (this.clickingSubmit || this.submitting || !this.element.checkValidity()) return
+
+    const token = document.querySelector("meta[name='csrf-token']")?.content
+    this.pendingSave = fetch(this.element.action, {
+      method: this.element.method || "POST",
+      body: new FormData(this.element),
+      headers: {
+        "X-CSRF-Token": token || "",
+        "X-Requested-With": "XMLHttpRequest"
+      },
+      keepalive: true
+    }).finally(() => {
+      this.pendingSave = null
+    })
+  }
+
+  beforeVisit(event) {
+    if (this.saveTimer) {
+      this.clearSaveTimer()
+      this.saveInBackground()
+    }
+
+    if (this.pendingSave) {
+      event.preventDefault()
+      const url = event.detail.url
+      const pending = this.pendingSave
+      this.pendingSave = null
+      pending.finally(() => Turbo.visit(url))
+    }
+  }
+
+  clearSaveTimer() {
+    if (this.saveTimer) {
+      clearTimeout(this.saveTimer)
+      this.saveTimer = null
+    }
+  }
+
   cancel() {
     this.cancelTarget?.click()
   }
