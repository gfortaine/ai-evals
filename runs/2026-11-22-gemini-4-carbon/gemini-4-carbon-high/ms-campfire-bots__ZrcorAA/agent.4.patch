   end
+
+  test "member is capped at Bots per member (5 by default), deleted bots do not count, and direct creation attempts are refused" do
+    sign_in :kevin
+
+    # Create 4 bots: still below default limit of 5
+    4.times do |i|
+      post bots_url, params: { bot: { name: "Kevin Bot #{i}" } }
+      assert_redirected_to bots_url
+    end
