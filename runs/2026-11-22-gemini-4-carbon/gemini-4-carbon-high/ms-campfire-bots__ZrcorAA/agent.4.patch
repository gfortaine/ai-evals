   end
+
+  test "reached_bot_limit? counts only own active bots for members and never limits administrators" do
+    member = users(:kevin)
+    other_member = users(:jz)
+    admin = users(:david)
+
+    assert_equal 5, accounts(:signal).settings.bots_per_member
+    assert_not member.reached_bot_limit?
+
+    # Other members and deleted bots do not count toward member limit
+    3.times { |i| User.bot.create!(name: "JZ Bot #{i}", creator: other_member) }
+    2.times { |i| User.bot.create!(name: "Deleted Bot #{i}", creator: member).tap(&:deactivate) }
+    assert_not member.reached_bot_limit?
+
+    bots = 4.times.map { |i| User.bot.create!(name: "Kevin Bot #{i}", creator: member) }
+    assert_not member.reached_bot_limit?
+
+    fifth_bot = User.bot.create!(name: "Kevin Bot 4", creator: member)
+    assert member.reached_bot_limit?
+
+    fifth_bot.deactivate
+    assert_not member.reached_bot_limit?
+
+    # Lowering limit marks member at/over limit without removing existing bots
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+    assert member.reached_bot_limit?
+    assert_equal 4, member.bots.active.count
+
+    # Administrators are never limited, even at 0
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    assert other_member.reached_bot_limit?
+    10.times { |i| User.bot.create!(name: "Admin Bot #{i}", creator: admin) }
+    assert_not admin.reached_bot_limit?
+    assert bots.first.reached_bot_limit?
+  end
 end
