+
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: "Blocked New Bot" } }
+    end
+    assert_response :forbidden
+
+    # Deleting 1 bot leaves 2 active (still >= 1), so creation remains blocked
+    delete bot_url(bots.second)
+    assert_redirected_to bots_url
+    assert_equal 2, users(:kevin).bots.active.count
+    post bots_url, params: { bot: { name: "Still Over Limit" } }
+    assert_response :forbidden
+
+    # Deleting 2 more bots leaves 0 active (< 1), unblocking creation
+    delete bot_url(bots.first)
+    delete bot_url(bots.third)
+    assert_equal 0, users(:kevin).bots.active.count
+
+    get bots_url
+    assert_select "a[href=?]", new_bot_path, text: /Add a chat bot/
+    assert_difference -> { users(:kevin).bots.active.count }, +1 do
+      post bots_url, params: { bot: { name: "Allowed Again Bot" } }
+    end
+    assert_redirected_to bots_url
+  end
+
+  test "driving Bots per member setting and member bot limit end-to-end via browser labels" do
+    ua = "Mozilla/5.0 (Macintosh; Intel Mac OS X 14_0) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36"
+
+    admin_session = Capybara::Session.new(:rack_test, Rails.application)
+    admin_session.driver.header("User-Agent", ua)
+    admin_session.visit new_session_path
+    admin_session.fill_in "Enter your email address", with: users(:david).email_address
+    admin_session.fill_in "Enter your password", with: "secret123456"
+    admin_session.click_on "log_in"
+
+    # Admin sees "Bots per member" set to 5 by default and lowers it to 2
+    admin_session.visit edit_account_path
+    assert admin_session.has_field?("Bots per member", type: "number", with: "5")
+    admin_session.fill_in "Bots per member", with: "2"
+    admin_session.click_button "Save changes"
+    assert admin_session.has_field?("Bots per member", type: "number", with: "2")
+
+    # Member signs in, does not see "Bots per member" on /account/edit, and creates 2 bots
+    member_session = Capybara::Session.new(:rack_test, Rails.application)
+    member_session.driver.header("User-Agent", ua)
+    member_session.visit new_session_path
+    member_session.fill_in "Enter your email address", with: users(:kevin).email_address
+    member_session.fill_in "Enter your password", with: "secret123456"
+    member_session.click_on "log_in"
+
+    member_session.visit edit_account_path
+    assert member_session.has_no_field?("Bots per member")
+    member_session.click_link "Set up chat bots"
+
+    2.times do |i|
+      assert member_session.has_link?("Add a chat bot")
+      assert member_session.has_no_text?("reached the limit")
+      member_session.click_link "Add a chat bot"
+      member_session.fill_in "Name the bot", with: "Member Bot #{i + 1}"
+      member_session.click_button "Save changes"
+    end
+
+    # At limit of 2: "Add a chat bot" is gone and "reached the limit" is shown
+    assert member_session.has_no_link?("Add a chat bot")
+    assert member_session.has_no_text?("Add a chat bot")
+    assert member_session.has_text?("reached the limit")
+    assert member_session.has_text?("Member Bot 1")
+    assert member_session.has_text?("Member Bot 2")
+
+    # Deleting 1 bot frees a slot
+    member_session.click_link "Edit Member Bot 1"
+    member_session.click_button "Delete this chat bot"
+    assert member_session.has_link?("Add a chat bot")
+    assert member_session.has_no_text?("reached the limit")
+  end
+
+  test "concurrent POST /bots requests cannot exceed Bots per member limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+    User.bot.create!(name: "Initial Bot", creator: users(:kevin))
+
+    ua = "Mozilla/5.0 (Macintosh; Intel Mac OS X 14_0) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36"
+    num_requests = 5
+    barrier = Concurrent::CyclicBarrier.new(num_requests)
+
+    statuses = num_requests.times.map do |i|
+      Thread.new do
+        session = ActionDispatch::Integration::Session.new(Rails.application)
+        session.post session_url, params: { email_address: users(:kevin).email_address, password: "secret123456" }, headers: { "User-Agent" => ua }
+        barrier.wait
+        session.post bots_url, params: { bot: { name: "Concurrent Bot #{i}" } }, headers: { "User-Agent" => ua }
+        session.response.status
+      end
+    end.map(&:value)
+
+    assert_equal 2, users(:kevin).reload.bots.active.count
+    assert_equal 1, statuses.count(302)
+    assert_equal 4, statuses.count(403)
+  end
 end
