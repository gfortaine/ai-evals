+    [
+      -> { WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(status: 500) },
+      -> { WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(status: 502) },
+      -> { WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(status: 404) },
+      -> { WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(status: 429) },
