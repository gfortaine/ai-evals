+    authored_message = @room.messages.create!(creator: @bot, body: "Historical alert")
+
+    assert @member.reached_bot_limit?
+
+    @bot.suspend!("Flooding")
+
+    assert_includes @bot.reload.rooms, @room
+    assert_includes @bot.rooms, closed_room
+    assert_equal @bot, authored_message.reload.creator
+    assert @member.reached_bot_limit?
+
+    # Editing the closed room's name preserves the suspended bot's membership
+    sign_in @admin
+    patch rooms_closed_url(closed_room), params: {
