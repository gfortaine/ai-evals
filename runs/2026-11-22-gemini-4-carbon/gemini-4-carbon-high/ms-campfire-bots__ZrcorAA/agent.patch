+    Bots::WebhookDeliveryJob.perform_later(@bot, pre_message, "mention")
+
+    @bot.suspend!("Failing webhooks")
+
+    perform_enqueued_jobs only: Bots::WebhookDeliveryJob
+    assert_not_requested stub
+
+    # Mentioning a suspended bot enqueues no webhook jobs
+    assert_no_enqueued_jobs only: Bots::WebhookDeliveryJob do
