+    <figure class="avatar flex-item-no-shrink" style="--avatar-size: 3.75ch;">
+      <%= image_tag fresh_user_avatar_path(bot), aria: { hidden: "true" }, size: 48, loading: :lazy %>
+    </figure>
+
+    <div class="min-width txt-align-start">
+      <div class="overflow-ellipsis fill-shade"><strong><%= bot.name %></strong></div>
+      <% if bot.suspended? %>
+        <div class="txt-small txt-negative">
+          <span>Suspended</span> · <span><%= bot.suspension_reason %></span>
+        </div>
+      <% end %>
+    </div>
+
+    <hr class="separator" aria-hidden="true">
+
+    <% if bot.suspended? && Current.user.administrator? %>
+      <%= button_to bot_suspension_path(bot), method: :delete, class: "btn txt-small flex-item-no-shrink",
+            form_class: "flex-item-no-shrink",
+            data: { turbo_confirm: "Are you sure you want to reactivate this chat bot?" } do %>
+        <%= image_tag "refresh.svg", size: 20, aria: { hidden: "true" } %>
+        <span>Reactivate</span>
+      <% end %>
+    <% end %>
+
+    <%= link_to edit_bot_path(bot), class: "btn txt-small flex-item-no-shrink" do %>
+      <%= image_tag "pencil.svg", size: 20, aria: { hidden: "true" } %>
+      <span class="for-screen-reader">Edit <%= bot.name %></span>
+    <% end %>
+  </div>
+
+  <div class="flex align-center gap">
+    <label for="<%= dom_id(bot, :bot_code) %>" class="for-screen-reader">Bot code</label>
+    <span class="flex align-center gap flex-item-grow input input--actor fill-white">
+      <%= image_tag "key.svg", aria: { hidden: "true" }, size: 20, class: "colorize--black flex-item-no-shrink" %>
+      <input type="text" id="<%= dom_id(bot, :bot_code) %>" class="input txt-small" value="<%= bot.bot_key %>" autocomplete="off" data-1p-ignore="true" readonly>
+    </span>
+
+    <%= button_to_copy_to_clipboard(bot.bot_key) do %>
+      <span class="for-screen-reader">Copy bot code</span>
+      <%= image_tag "copy-paste.svg", aria: { hidden: "true" }, size: 20, class: "colorize--black" %>
+    <% end %>
+  </div>
+</li>
