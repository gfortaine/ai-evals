+    old_key = @bot.bot_key
+    @bot.deactivate
+    assert_not @member.reached_bot_limit?
+    assert_not @bot.reload.suspended?
+
+    post room_bot_messages_url(@room, old_key), params: +"After delete", headers: { "Content-Type" => "text/plain" }
+    assert_response :unauthorized
+  end
+end
