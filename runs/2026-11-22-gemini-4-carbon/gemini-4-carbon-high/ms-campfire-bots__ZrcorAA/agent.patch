diff --git a/test/models/user/bot/moderation_test.rb b/test/models/user/bot/moderation_test.rb
new file mode 100644
index 0000000..46de5ad
--- /dev/null
+++ b/test/models/user/bot/moderation_test.rb
@@ -0,0 +1,279 @@
+require "test_helper"
+
+class User::Bot::ModerationTest < ActionDispatch::IntegrationTest
+  setup do
+    @admin = users(:david)
+    @member = users(:kevin)
+    @room = rooms(:hq)
+    @bot = User.bot.create!(
+      name: "Watchdog Bot",
+      creator: @member,
+      webhook_url: "https://hooks.example.com/watchdog"
+    )
+    @room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+  end
+
+  test "sliding window allows at most 10 messages in any 10 seconds across API and webhook replies" do
+    WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(
+      status: 200,
+      headers: { "Content-Type" => "text/plain" },
+      body: "Webhook reply"
+    )
+
+    freeze_time do
+      # 6 API messages at t = 0..5s
+      6.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key),
+          params: +"API message #{i}",
+          headers: { "Content-Type" => "text/plain" }
+        assert_response :created
+        travel 1.second if i < 5
+      end
+
+      # 4 webhook replies at t = 5..8s (total = 10 messages in [0s, 8s])
+      4.times do |i|
+        travel 1.second if i > 0
+        user_msg = @room.messages.create!(creator: @admin, body: "Ping #{i}")
+        assert_difference -> { @room.messages.where(creator: @bot).count }, +1 do
+          @bot.deliver_webhook(user_msg)
+        end
+      end
+
+      # At t = 10.0s, the first API message from t = 0.0s has aged out of the 10s window,
+      # leaving 9 messages in (0.0s, 10.0s], so 1 more message is allowed!
+      travel 2.seconds
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: +"Allowed after oldest aged out",
+        headers: { "Content-Type" => "text/plain" }
+      assert_response :created
+      assert_not @bot.reload.in_cooldown?
+
+      # Immediate next message at t = 10.0s goes over the 10-in-10s limit -> rejected & starts 30s cooldown
+      assert_no_difference -> { @room.messages.count } do
+        post room_bot_messages_url(@room, @bot.bot_key),
+          params: +"Over the limit",
+          headers: { "Content-Type" => "text/plain" }
+      end
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+      assert @bot.reload.in_cooldown?
+      assert_not @bot.suspended?
+    end
+  end
+
+  test "webhook reply going over the 10-in-10s limit is not posted, starts cooldown, suppresses replies during cooldown, and 5 cooldown attempts suspend the bot" do
+    WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(
+      status: 200,
+      headers: { "Content-Type" => "text/plain" },
+      body: "Noisy reply"
+    )
+
+    freeze_time do
+      10.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key),
+          params: +"Burst #{i}",
+          headers: { "Content-Type" => "text/plain" }
+        assert_response :created
+      end
+
+      # 11th message via webhook reply -> rejected and starts 30s cooldown
+      trigger_msg = @room.messages.create!(creator: @admin, body: "Trigger 11")
+      assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+        @bot.deliver_webhook(trigger_msg)
+      end
+      assert @bot.reload.in_cooldown?
+      assert_equal 0, @bot.cooldown_attempts_count
+      assert_not @bot.suspended?
+
+      # 204 No Content during cooldown is not a post attempt
+      WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(status: 204)
+      @bot.deliver_webhook(@room.messages.create!(creator: @admin, body: "Silent"))
+      assert_equal 0, @bot.reload.cooldown_attempts_count
+
+      # Blank HTML body during cooldown is not a post attempt
+      WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(
+        status: 200,
+        headers: { "Content-Type" => "text/html" },
+        body: "<div>   </div>"
+      )
+      @bot.deliver_webhook(@room.messages.create!(creator: @admin, body: "Blank HTML"))
+      assert_equal 0, @bot.reload.cooldown_attempts_count
+
+      # Restore non-blank reply: 3 webhook reply attempts + 1 API attempt = 4 attempts during cooldown (not suspended yet)
+      WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(
+        status: 200,
+        headers: { "Content-Type" => "text/plain" },
+        body: "Still replying"
+      )
+      3.times do |i|
+        msg = @room.messages.create!(creator: @admin, body: "Attempt #{i}")
+        assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+          @bot.deliver_webhook(msg)
+        end
+      end
+
+      travel 12.seconds
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: +"4th cooldown attempt",
+        headers: { "Content-Type" => "text/plain" }
+      assert_response :too_many_requests
+      assert_equal "18", response.headers["Retry-After"]
+      assert_not @bot.reload.suspended?
+
+      # 5th attempt via webhook reply during the same cooldown suspends the bot!
+      fifth_msg = @room.messages.create!(creator: @admin, body: "5th attempt")
+      assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+        @bot.deliver_webhook(fifth_msg)
+      end
+
+      assert @bot.reload.suspended?
+      assert_equal "Flooding", @bot.suspension_reason
+    end
+  end
+
+  test "waiting out a 30-second cooldown resets cooldown attempts so a subsequent cooldown starts fresh" do
+    freeze_time do
+      10.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"First #{i}", headers: { "Content-Type" => "text/plain" }
+        assert_response :created
+      end
+
+      # Start first cooldown
+      post room_bot_messages_url(@room, @bot.bot_key), params: +"Over 1", headers: { "Content-Type" => "text/plain" }
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+
+      # 4 attempts during first cooldown -> not suspended
+      4.times do
+        travel 5.seconds
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Retry early", headers: { "Content-Type" => "text/plain" }
+        assert_response :too_many_requests
+      end
+      assert_not @bot.reload.suspended?
+
+      # At 29s (9s more): still 1s left
+      travel 9.seconds
+      # Wait: that would be 5th attempt if we posted at 29s! Instead advance past 30s (10s more -> total 30s):
