diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..c5e2507
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,88 @@
+class Bots::MessagesController < ActionController::Base
+  include ActiveStorage::SetCurrent, BlockBannedRequests, SetCurrentRequest, VersionHeaders
+
+  skip_forgery_protection
+
+  before_action :authenticate_bot
+  before_action :reject_suspended_or_cooled_down_bot
+  before_action :set_room
+
+  rescue_from ActiveRecord::RecordNotFound, with: -> { head :not_found }
+  rescue_from ActiveRecord::RecordInvalid, with: -> { head :unprocessable_content }
+
+  def self.dispatch(name, req, res)
+    unless req.content_mime_type&.symbol == :multipart_form
+      req.set_header("action_dispatch.request.request_parameters", {})
+    end
+
+    super
+  end
+
+  def create
+    @message = @room.messages.new(message_params)
+    @message.validate!
+
+    status, retry_after = Current.user.attempt_message_post(@message)
+    case status
+    when :created
+      @message.process_attachment
+      @message.broadcast_create
+
+      head :created, location: message_path(@message)
+    when :cooldown
+      reject_with_cooldown(retry_after)
+    when :suspended, :inactive
+      head :forbidden
+    end
+  end
+
+  private
+    def authenticate_bot
+      if bot = User.authenticate_bot(params[:bot_code])
+        Current.user = bot
+      else
+        head :unauthorized
+      end
+    end
+
+    def reject_suspended_or_cooled_down_bot
+      if Current.user.suspended?
+        head :forbidden
+      elsif Current.user.in_cooldown?
+        status, retry_after = Current.user.record_cooldown_attempt_if_active!
+        if status == :suspended
+          head :forbidden
+        elsif status == :cooldown
+          reject_with_cooldown(retry_after)
+        end
+      end
+    end
+
+    def reject_with_cooldown(retry_after)
+      response.set_header("Retry-After", retry_after.to_s)
+      head :too_many_requests
+    end
+
+    def set_room
+      @room = Current.user.rooms.find(params[:room_id])
+    end
+
+    def message_params
+      if request.content_mime_type&.symbol == :multipart_form
+        attachment = params[:attachment] if params[:attachment].is_a?(ActionDispatch::Http::UploadedFile)
+        body = ERB::Util.html_escape(params[:body].to_s).gsub(/\r?\n/, "<br>")
+        { attachment: attachment, body: body }.compact
+      else
+        { body: formatted_body }
+      end
+    end
+
+    def formatted_body
+      raw = request.raw_post.dup.force_encoding(Encoding::UTF_8).scrub
+      if request.content_mime_type&.symbol == :html
+        raw
+      else
+        ERB::Util.html_escape(raw).gsub(/\r?\n/, "<br>")
+      end
+    end
+end
