--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,82 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+  before_action :ensure_can_administer, only: %i[ edit update destroy ]
+  before_action :ensure_permission_to_create_bots, only: %i[ new create ]
+
+  def index
+    no_store
+    @bots = accessible_bots.with_attached_avatar.ordered
+  end
+
+  def new
+    @bot = User.new(role: :bot)
+  end
+
+  def create
+    @bot = User.new(**bot_params, role: :bot, creator: Current.user)
+
+    forbidden = false
+    saved = User.transaction do
+      if Current.user.reached_bot_limit?
+        forbidden = true
+        false
+      else
+        @bot.save
+      end
+    end
+
+    if forbidden
+      head :forbidden
+    elsif saved
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      @bot.touch
+      @bot.messages.touch_all
+      @bot.rooms.touch_all
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url
+  end
+
+  private
+    def accessible_bots
+      if Current.user.administrator?
+        User.active_bots
+      else
+        Current.user.bots.active
+      end
+    end
+
+    def set_bot
+      @bot = User.active_bots.find(params[:id])
+    end
+
+    def ensure_can_administer
+      head :forbidden unless Current.user.can_administer?(@bot)
+    end
+
+    def ensure_permission_to_create_bots
+      head :forbidden if Current.user.reached_bot_limit?
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar, :webhook_url, :auto_join_open_rooms).tap do |permitted|
+        permitted.delete(:avatar) if permitted[:avatar].blank?
+      end
+    end
+end
