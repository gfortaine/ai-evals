@@ -0,0 +1,169 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "creating a bot generates a unique bot_key and does not join open rooms by default" do
+    Current.user = users(:kevin)
+
+    bot = nil
+    assert_no_difference -> { Membership.count } do
+      bot = User.create_bot!(name: "Deploy Bot")
+    end
+
+    assert bot.bot?
+    assert_equal users(:kevin), bot.creator
+    assert bot.bot_token.present?
+    assert_equal "#{bot.id}-#{bot.bot_token}", bot.bot_key
+    assert_nil bot.webhook_url
+    assert_not bot.webhook_configured?
+    assert_not bot.auto_join_open_rooms?
+    assert_not bot.can_administer?
+    assert_empty bot.rooms
+  end
+
+  test "auto_join_open_rooms joins existing and future open rooms and keeps memberships when turned off" do
+    Current.user = users(:kevin)
+
+    bot = User.create_bot!(name: "Everywhere Bot", auto_join_open_rooms: true)
+    assert bot.auto_join_open_rooms?
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+
+    later_open = Rooms::Open.create!(name: "Ops", creator: users(:david))
+    assert_includes bot.reload.rooms, later_open
+
+    bot.update!(auto_join_open_rooms: false)
+    assert_not bot.auto_join_open_rooms?
+    assert_equal Rooms::Open.pluck(:id).sort, bot.reload.rooms.pluck(:id).sort
+
+    after_off_open = Rooms::Open.create!(name: "After Off", creator: users(:david))
+    assert_not_includes bot.reload.rooms, after_off_open
+
+    bot.update!(auto_join_open_rooms: true)
+    assert_equal Rooms::Open.pluck(:id).sort, bot.reload.rooms.pluck(:id).sort
+  end
+
+  test "bot accepts optional http or https webhook_url including localhost and clears blank values" do
+    bot = User.bot.create!(name: "Deploy Bot", creator: users(:kevin), webhook_url: "  http://localhost:4567/webhook?env=test  ")
+    assert_equal "http://localhost:4567/webhook?env=test", bot.webhook_url
+    assert bot.webhook_configured?
+
+    bot.update!(webhook_url: "https://127.0.0.1:8443/hook")
+    assert_equal "https://127.0.0.1:8443/hook", bot.webhook_url
+
+    bot.update!(webhook_url: "   ")
+    assert_nil bot.reload.webhook_url
+    assert_not bot.webhook_configured?
+  end
+
+  test "bot rejects invalid webhook_url" do
+    [ "not-a-url", "ftp://example.com/hook", "javascript:alert(1)", "http://" ].each do |invalid_url|
+      bot = User.new(role: :bot, name: "Deploy Bot", creator: users(:kevin), webhook_url: invalid_url)
+      assert_not bot.valid?, "Expected #{invalid_url.inspect} to be invalid"
+      assert_includes bot.errors[:webhook_url], "is invalid"
+    end
+  end
+
+  test "human users still join open rooms by default and do not get bot_token, bot_key, webhook_url, or auto_join_open_rooms" do
+    user = User.create!(
+      name: "Human",
+      email_address: "human@example.com",
+      password: "secret123456",
+      webhook_url: "https://example.com/hook",
+      auto_join_open_rooms: true
+    )
+
+    assert_not user.bot?
+    assert_nil user.bot_token
+    assert_nil user.bot_key
+    assert_nil user.webhook_url
+    assert_not user.auto_join_open_rooms?
+    assert_equal Rooms::Open.pluck(:id).sort, user.rooms.pluck(:id).sort
+  end
+
+  test "bot requires a name" do
+    bot = User.new(role: :bot, name: "   ", creator: users(:kevin))
+
+    assert_not bot.valid?
+    assert_includes bot.errors[:name], "can't be blank"
+  end
+
+  test "authenticate_bot validates bot_key securely" do
+    bot = User.bot.create!(name: "Deploy Bot", creator: users(:kevin))
+
+    assert_equal bot, User.authenticate_bot(bot.bot_key)
+    assert_nil User.authenticate_bot("#{bot.id}-wrongtoken")
+    assert_nil User.authenticate_bot("0#{bot.id}-#{bot.bot_token}")
+    assert_nil User.authenticate_bot("#{bot.id}x-#{bot.bot_token}")
+    assert_nil User.authenticate_bot("999999-#{bot.bot_token}")
+    assert_nil User.authenticate_bot("#{users(:david).id}-anything")
+    assert_nil User.authenticate_bot("")
+    assert_nil User.authenticate_bot("-")
+    assert_nil User.authenticate_bot(nil)
+  end
+
+  test "deactivating a bot revokes its bot_key and clears webhook_url and auto_join_open_rooms while keeping authored messages" do
+    bot = User.bot.create!(
+      name: "Deploy Bot",
+      creator: users(:kevin),
+      webhook_url: "https://example.com/webhook",
+      auto_join_open_rooms: true
+    )
+    old_key = bot.bot_key
+    message = rooms(:hq).messages.create!(creator: bot, body: "Deployed!")
+
+    bot.deactivate
+
+    assert bot.reload.deactivated?
+    assert_nil bot.bot_token
+    assert_nil bot.bot_key
+    assert_nil bot.webhook_url
+    assert_not bot.auto_join_open_rooms?
+    assert_not bot.webhook_configured?
+    assert_nil User.authenticate_bot(old_key)
+    assert_empty bot.memberships.without_direct_rooms
+    assert_equal bot, message.reload.creator
+  end
+
+  test "can_administer? allows creator and administrators but not other members" do
+    bot = User.bot.create!(name: "Deploy Bot", creator: users(:kevin))
+
+    assert users(:kevin).can_administer?(bot)
+    assert users(:david).can_administer?(bot)
+    assert_not users(:jz).can_administer?(bot)
+    assert_not bot.can_administer?(bot)
+  end
+
+  test "reached_bot_limit? counts only own active bots for members and never limits administrators" do
+    member = users(:kevin)
+    other_member = users(:jz)
+    admin = users(:david)
+
+    assert_equal 5, accounts(:signal).settings.bots_per_member
+    assert_not member.reached_bot_limit?
+
+    # Other members and deleted bots do not count toward member limit
+    3.times { |i| User.bot.create!(name: "JZ Bot #{i}", creator: other_member) }
+    2.times { |i| User.bot.create!(name: "Deleted Bot #{i}", creator: member).tap(&:deactivate) }
+    assert_not member.reached_bot_limit?
+
+    bots = 4.times.map { |i| User.bot.create!(name: "Kevin Bot #{i}", creator: member) }
+    assert_not member.reached_bot_limit?
+
+    fifth_bot = User.bot.create!(name: "Kevin Bot 4", creator: member)
+    assert member.reached_bot_limit?
+
+    fifth_bot.deactivate
+    assert_not member.reached_bot_limit?
+
+    # Lowering limit marks member at/over limit without removing existing bots
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+    assert member.reached_bot_limit?
+    assert_equal 4, member.bots.active.count
+
+    # Administrators are never limited, even at 0
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    assert other_member.reached_bot_limit?
+    10.times { |i| User.bot.create!(name: "Admin Bot #{i}", creator: admin) }
+    assert_not admin.reached_bot_limit?
+    assert bots.first.reached_bot_limit?
+  end
+end
