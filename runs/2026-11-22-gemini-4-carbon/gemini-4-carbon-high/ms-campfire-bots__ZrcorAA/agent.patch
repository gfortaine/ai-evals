new file mode 100644
index 0000000..cfd690a
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,91 @@
+module User::Bot
+  extend ActiveSupport::Concern
+
+  include Moderation
+
+  included do
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :bots, -> { bot }, class_name: "User", foreign_key: :creator_id, dependent: :nullify, inverse_of: :creator
+
+    normalizes :webhook_url, with: ->(url) { url.strip.presence }
+
+    before_validation :clear_bot_settings_unless_bot
+    before_create :generate_bot_token, if: :bot?
+    after_save_commit :grant_bot_membership_to_open_rooms, if: -> { bot? && active? && auto_join_open_rooms? }
+
+    scope :without_bots, -> { not_bot }
+    scope :active_bots, -> { active.bot }
+    scope :with_webhook, -> { where.not(webhook_url: nil) }
+    scope :auto_joining_open_rooms, -> { without_bots.or(where(auto_join_open_rooms: true)) }
+
+    validates :name, presence: true, if: :bot?
+    validate :validate_webhook_url, if: -> { bot? && webhook_url.present? }
+  end
+
+  class_methods do
+    def create_bot!(attributes)
+      bot.create!(**attributes.to_h.symbolize_keys, creator: Current.user)
+    end
+
+    def authenticate_bot(bot_key)
+      bot_id, bot_token = bot_key.to_s.split("-", 2)
+      return nil unless bot_id&.match?(/\A\d+\z/) && bot_token.present?
+
+      if bot = active_bots.find_by(id: bot_id)
+        bot if bot.bot_key.present? && ActiveSupport::SecurityUtils.secure_compare(bot.bot_key, bot_key.to_s)
+      end
+    end
+  end
+
+  def bot_key
+    "#{id}-#{bot_token}" if bot? && bot_token.present?
+  end
+
+  def reached_bot_limit?
+    return true if bot?
+    return false if administrator?
+
+    bots.active.count >= (Current.account&.settings&.bots_per_member || Account::DEFAULT_BOTS_PER_MEMBER)
+  end
+
+  def webhook_configured?
+    bot? && active? && !suspended? && webhook_url.present?
+  end
+
+  def deliver_webhook_later(target, event: :mention)
+    Bots::WebhookDeliveryJob.perform_later(self, target, event.to_s) if webhook_configured?
+  end
+
+  def deliver_webhook(target, event: "mention")
+    Webhook.new(self).deliver(target, event: event)
+  end
+
+  private
+    def generate_bot_token
+      self.bot_token ||= self.class.generate_unique_secure_token
+    end
+
+    def grant_bot_membership_to_open_rooms
+      grant_membership_to_open_rooms
+    end
+
+    def clear_bot_settings_unless_bot
+      unless bot?
+        self.webhook_url = nil
+        self.auto_join_open_rooms = false
+        self.suspended_at = nil
+        self.suspension_reason = nil
+        self.cooldown_until = nil
+        self.cooldown_attempts_count = 0
+        self.recent_post_timestamps = []
+        self.webhook_failures_count = 0
+      end
+    end
+
+    def validate_webhook_url
+      uri = URI.parse(webhook_url)
+      errors.add(:webhook_url, "is invalid") unless uri.is_a?(URI::HTTP) && uri.hostname.present?
+    rescue URI::InvalidURIError
+      errors.add(:webhook_url, "is invalid")
+    end
+end
diff --git a/app/models/user/bot/moderation.rb b/app/models/user/bot/moderation.rb
new file mode 100644
index 0000000..2b8fa64
--- /dev/null
+++ b/app/models/user/bot/moderation.rb
@@ -0,0 +1,134 @@
+module User::Bot::Moderation
+  extend ActiveSupport::Concern
+
+  FLOOD_MESSAGE_LIMIT = 10
+  FLOOD_WINDOW = 10.seconds
+  FLOOD_WINDOW_MICROSECONDS = 10_000_000
+  FLOOD_COOLDOWN_DURATION = 30.seconds
+  FLOOD_COOLDOWN_ATTEMPT_LIMIT = 5
+
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  FLOODING_REASON = "Flooding"
+  FAILING_WEBHOOKS_REASON = "Failing webhooks"
+
+  included do
+    scope :suspended, -> { where.not(suspended_at: nil) }
+    scope :unsuspended, -> { where(suspended_at: nil) }
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def in_cooldown?(now = Time.current)
+    cooldown_until.present? && cooldown_until > now
+  end
+
+  def cooldown_seconds_left(now = Time.current)
+    return 0 unless in_cooldown?(now)
+
+    [ (cooldown_until - now).ceil, 1 ].max
+  end
+
+  def suspend!(reason)
+    update!(
+      suspended_at: Time.current,
+      suspension_reason: reason,
+      cooldown_until: nil,
+      cooldown_attempts_count: 0,
+      recent_post_timestamps: [],
+      webhook_failures_count: 0
+    )
+  end
+
+  def reactivate!
+    update!(
+      suspended_at: nil,
+      suspension_reason: nil,
+      cooldown_until: nil,
+      cooldown_attempts_count: 0,
+      recent_post_timestamps: [],
+      webhook_failures_count: 0
+    )
+  end
+
+  def record_cooldown_attempt_if_active!
+    with_lock do
+      now = Time.current
+      if suspended?
+        [ :suspended, nil ]
+      elsif in_cooldown?(now)
+        record_cooldown_attempt_locked!(now)
+      end
+    end
+  end
+
+  def attempt_message_post(message, room: nil)
+    with_lock do
+      return [ :inactive, nil ] unless active?
+      return [ :suspended, nil ] if suspended?
+      return [ :not_in_room, nil ] if room && !room.users.exists?(id)
+
+      now = Time.current
+      return record_cooldown_attempt_locked!(now) if in_cooldown?(now)
+
+      now_us = timestamp_microseconds(now)
+      cutoff_us = now_us - FLOOD_WINDOW_MICROSECONDS
+      timestamps = Array(recent_post_timestamps).map(&:to_i).select { |ts| ts > cutoff_us }
+
+      if timestamps.size >= FLOOD_MESSAGE_LIMIT
+        update_columns(
+          cooldown_until: now + FLOOD_COOLDOWN_DURATION,
+          cooldown_attempts_count: 0,
+          recent_post_timestamps: timestamps
+        )
+        [ :cooldown, FLOOD_COOLDOWN_DURATION.to_i ]
+      else
+        timestamps << now_us
+        update_columns(
+          cooldown_until: nil,
+          cooldown_attempts_count: 0,
+          recent_post_timestamps: timestamps
+        )
+        message.save!
+        [ :created, nil ]
+      end
+    end
+  end
+
+  def record_webhook_success!
+    User.where(id: id, suspended_at: nil).where.not(webhook_failures_count: 0).update_all(webhook_failures_count: 0)
+    self.webhook_failures_count = 0 unless suspended?
+  end
+
+  def record_webhook_failure!
+    with_lock do
+      return if !bot? || !active? || suspended?
+
+      failures = webhook_failures_count + 1
+      if failures >= WEBHOOK_FAILURE_LIMIT
+        suspend!(FAILING_WEBHOOKS_REASON)
+      else
+        update_columns(webhook_failures_count: failures)
+      end
+    end
+  end
+
+  private
+    def record_cooldown_attempt_locked!(now)
+      attempts = cooldown_attempts_count + 1
+      if attempts >= FLOOD_COOLDOWN_ATTEMPT_LIMIT
+        suspend!(FLOODING_REASON)
+        [ :suspended, nil ]
+      else
+        retry_after = cooldown_seconds_left(now)
+        update_columns(cooldown_attempts_count: attempts)
+        [ :cooldown, retry_after ]
+      end
+    end
+
+    def timestamp_microseconds(time)
+      (time.to_r * 1_000_000).to_i
+    end
+end
diff --git a/app/models/user/bot/webhook.rb b/app/models/user/bot/webhook.rb
new file mode 100644
index 0000000..77faff8
--- /dev/null
+++ b/app/models/user/bot/webhook.rb
@@ -0,0 +1,177 @@
+require "net/http"
+
+class User::Bot::Webhook
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 15
+  WRITE_TIMEOUT = 5
+  MAX_RESPONSE_SIZE = 5.megabytes
+
+  attr_reader :bot
+
+  def initialize(bot)
+    @bot = bot
+  end
+
+  def deliver(target, event: "mention")
+    return unless deliverable_for?(target, event: event)
+
+    uri = URI.parse(bot.webhook_url)
+    payload = payload_for(target, event: event)
+    response, body = perform_request(uri, payload)
+
+    if response&.is_a?(Net::HTTPSuccess)
+      bot.record_webhook_success!
+      handle_response(response, body, target) if body
+    else
+      bot.record_webhook_failure!
+    end
+  end
+
+  def payload_for(target, event: "mention")
+    case target
+    when Room
+      {
+        event: event.to_s,
+        room: room_payload_for(target)
+      }
+    else
+      room = target.room
+
+      {
+        event: event.to_s,
+        author: {
+          id: target.creator.id,
+          name: target.creator.name
+        },
+        room: room_payload_for(room),
+        message: {
+          id: target.id,
+          body: {
+            text: target.plain_text_without_mention_of(bot),
+            html: target.body.body&.to_html.to_s
+          },
+          link: url_helpers.room_at_message_path(room, target)
+        }
+      }
+    end
+  end
+
+  private
+    def deliverable_for?(target, event: "mention")
+      bot.reload if bot.persisted?
+      return false unless bot.webhook_configured? && bot.bot_key.present?
+
+      case target
+      when Room
+        !target.direct? && target.users.include?(bot)
+      else
+        !target.creator.bot? && target.room.users.include?(bot)
+      end
+    end
+
+    def room_payload_for(room)
+      {
+        id: room.id,
+        name: room_name_for(room),
+        reply_to: url_helpers.room_bot_messages_path(room, bot.bot_key)
+      }
+    end
+
+    def room_name_for(room)
+      if room.direct?
+        room.users.without(bot).pluck(:name).to_sentence.presence || bot.name
+      else
+        room.name
+      end
+    end
+
+    def url_helpers
+      Rails.application.routes.url_helpers
+    end
+
+    def perform_request(uri, payload)
+      post_json(uri, payload)
+    rescue StandardError, SocketError, IOError, OpenSSL::SSL::SSLError, Timeout::Error => e
+      Rails.logger.warn "Failed to deliver webhook for bot #{bot.id} to #{bot.webhook_url}: #{e.class} #{e.message}"
+      nil
+    end
+
+    def post_json(uri, payload)
+      request = Net::HTTP::Post.new(uri)
+      request["Content-Type"] = "application/json"
+      request.body = JSON.generate(payload)
+
+      Net::HTTP.start(
+        uri.hostname,
+        uri.port,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT,
+        write_timeout: WRITE_TIMEOUT
+      ) do |http|
+        http.request(request) do |response|
+          body = read_limited_body(response) if response.is_a?(Net::HTTPSuccess)
+          return [ response, body ]
+        end
+      end
+    end
+
+    def read_limited_body(response)
+      return "" if response.is_a?(Net::HTTPNoContent)
+
+      buffer = +""
+      response.read_body do |chunk|
+        return nil if buffer.bytesize + chunk.bytesize > MAX_RESPONSE_SIZE
+        buffer << chunk
+      end
+      buffer
+    end
+
+    def handle_response(response, raw_body, target)
+      case response.code
+      when "204"
+        nil
+      when "200"
+        post_reply(target, response, raw_body) if raw_body.present?
+      end
+    end
+
+    def post_reply(target, response, raw_body)
+      formatted = case response.content_type&.downcase
+      when "text/plain"
+        ERB::Util.html_escape(decode_body(response, raw_body)).gsub(/\r?\n/, "<br>")
+      when "text/html"
+        decode_body(response, raw_body)
+      else
+        return
+      end
+
+      return if formatted.blank?
+
+      room, created_at = if target.is_a?(Room)
+        [ target, Time.current ]
+      else
+        [ target.room, [ Time.current, target.created_at + 0.001.seconds ].max ]
+      end
+
+      reply = room.messages.new(
+        creator: bot,
+        body: formatted,
+        created_at: created_at
+      )
+      return unless reply.valid?
+
+      status, _ = bot.attempt_message_post(reply, room: room)
+      reply.broadcast_create if status == :created
+    end
+
+    def decode_body(response, raw_body)
+      body = raw_body.dup
+      if charset = response.type_params["charset"]
+        if encoding = (Encoding.find(charset) rescue nil)
+          return body.force_encoding(encoding).encode(Encoding::UTF_8, invalid: :replace, undef: :replace)
+        end
+      end
+      body.force_encoding(Encoding::UTF_8).scrub
+    end
+end
