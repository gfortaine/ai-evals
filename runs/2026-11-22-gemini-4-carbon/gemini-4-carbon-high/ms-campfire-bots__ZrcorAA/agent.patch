+    perform_enqueued_jobs only: Bots::WebhookDeliveryJob do
+      patch bot_url(bot), params: {
+        bot: { name: "Auto Bot", webhook_url: "https://hooks.example.com/auto", auto_join_open_rooms: "1" }
+      }
+    end
+    assert_equal [ [ "joined", rooms(:pets).id, "All Pets" ] ], joined_rooms
+
+    # 4. New open room created later -> automatically joins and receives 1 joined event
+    joined_rooms.clear
+    perform_enqueued_jobs only: Bots::WebhookDeliveryJob do
+      post rooms_opens_url, params: { room: { name: "Ops" }, user_ids: [ "" ] }
+    end
+    ops = Room.find_by!(name: "Ops")
+    assert_equal [ [ "joined", ops.id, "Ops" ] ], joined_rooms
+
+    # 5. Closed room where bot is already a member becomes open -> NO duplicate joined event
+    joined_rooms.clear
+    perform_enqueued_jobs only: Bots::WebhookDeliveryJob do
+      put rooms_closed_url(rooms(:designers)), params: {
+        room: { name: "Designers" },
+        user_ids: rooms(:designers).users.pluck(:id) + [ bot.id ]
+      }
+    end
+    assert_equal [ [ "joined", rooms(:designers).id, "Designers" ] ], joined_rooms
+
+    joined_rooms.clear
+    perform_enqueued_jobs only: Bots::WebhookDeliveryJob do
+      put rooms_open_url(rooms(:designers)), params: { room: { name: "Designers" }, user_ids: [ "", bot.id ] }
+    end
+    assert_empty joined_rooms
+
+    # 6. Closed room where bot was NOT a member becomes open -> 1 joined event
+    perform_enqueued_jobs only: Bots::WebhookDeliveryJob do
+      put rooms_open_url(rooms(:watercooler)), params: { room: { name: "All Talk" } }
+    end
+    assert_equal [ [ "joined", rooms(:watercooler).id, "All Talk" ] ], joined_rooms
+
+    # 7. Turn OFF -> ON again when already in all open rooms -> 0 duplicate joined events
+    joined_rooms.clear
+    perform_enqueued_jobs only: Bots::WebhookDeliveryJob do
+      patch bot_url(bot), params: {
+        bot: { name: "Auto Bot", webhook_url: "https://hooks.example.com/auto", auto_join_open_rooms: "0" }
+      }
+      patch bot_url(bot), params: {
+        bot: { name: "Auto Bot", webhook_url: "https://hooks.example.com/auto", auto_join_open_rooms: "1" }
+      }
+    end
+    assert_empty joined_rooms
+  end
+
+  test "starting a direct conversation via DirectsController never triggers joined" do
+    assert_no_enqueued_jobs only: Bots::WebhookDeliveryJob do
+      post rooms_directs_url, params: { user_ids: [ @bot.id ] }
+    end
+    assert_response :redirect
+  end
+end
+
+class User::Bot::RealSocketWebhookTest < ActionDispatch::IntegrationTest
+  test "delivers joined and mention webhooks over a real local HTTP socket and handles 200 text/plain, 200 text/html, and 204" do
+    WebMock.allow_net_connect!
+
+    received_requests = Queue.new
+    next_response = ->(_payload) { [ 204, {}, "" ] }
+
+    server = TCPServer.new("127.0.0.1", 0)
+    port = server.addr[1]
+    server_thread = Thread.new do
+      loop do
+        client = server.accept
+        begin
+          request_line = client.gets
+          break unless request_line
+
+          headers = {}
+          while (line = client.gets) && line != "\r\n"
+            key, val = line.split(":", 2)
+            headers[key.strip.downcase] = val.strip if val
+          end
+          body = client.read(headers["content-length"].to_i)
+          payload = JSON.parse(body)
+          received_requests << { request_line: request_line.strip, headers: headers, payload: payload }
+
+          status, resp_headers, resp_body = next_response.call(payload)
+          reason = status == 204 ? "No Content" : "OK"
+          client.write "HTTP/1.1 #{status} #{reason}\r\n"
+          resp_headers.each { |k, v| client.write "#{k}: #{v}\r\n" }
+          client.write "Content-Length: #{resp_body.bytesize}\r\n" unless status == 204
+          client.write "Connection: close\r\n\r\n"
+          client.write resp_body unless status == 204
+        ensure
+          client.close rescue nil
+        end
+      end
+    rescue IOError, Errno::EBADF
+    end
+
+    author = users(:david)
+    room = rooms(:hq)
+    sign_in author
+    bot = User.bot.create!(name: "Socket Bot", creator: author, webhook_url: "http://127.0.0.1:#{port}/hook?token=xyz")
+
+    # 0. Joining room triggers joined event and posts 200 text/plain greeting
+    next_response = ->(payload) {
+      [ 200, { "Content-Type" => "text/plain" }, "Hello #{payload.dig('room', 'name')}! 👋" ]
+    }
+
+    perform_enqueued_jobs only: Bots::WebhookDeliveryJob do
+      room.memberships.grant_to(bot)
+    end
+
+    join_req = received_requests.pop(true)
+    assert_equal "POST /hook?token=xyz HTTP/1.1", join_req[:request_line]
+    assert_equal "application/json", join_req[:headers]["content-type"]
+    assert_equal(
+      {
+        "event" => "joined",
+        "room" => {
+          "id" => room.id,
+          "name" => room.name,
+          "reply_to" => "/rooms/#{room.id}/#{bot.bot_key}/messages"
+        }
+      },
+      join_req[:payload]
+    )
+    assert_equal "Hello #{room.name}! 👋", room.messages.ordered.last.plain_text_body
+    assert_equal bot, room.messages.ordered.last.creator
+
+    # 1. 200 text/plain with UTF-8 without charset on mention
+    next_response = ->(payload) {
+      [ 200, { "Content-Type" => "text/plain" }, "Got: #{payload.dig('message', 'body', 'text')} 🚀" ]
+    }
+
+    perform_enqueued_jobs only: Bots::WebhookDeliveryJob do
+      post room_messages_url(room), params: {
+        message: { body: "<div>#{mention_attachment_for(bot)} restart build</div>" }
+      }, as: :turbo_stream
+    end
+
+    req = received_requests.pop(true)
+    assert_equal "POST /hook?token=xyz HTTP/1.1", req[:request_line]
+    assert_equal "application/json", req[:headers]["content-type"]
+    assert_equal "mention", req[:payload]["event"]
+    assert_equal "restart build", req[:payload].dig("message", "body", "text")
+    assert_equal "Got: restart build 🚀", room.messages.ordered.last.plain_text_body
+    assert_equal bot, room.messages.ordered.last.creator
+
+    # 2. 200 text/html
+    next_response = ->(_payload) {
+      [ 200, { "Content-Type" => "text/html" }, "<b>All green</b>" ]
+    }
+
+    perform_enqueued_jobs only: Bots::WebhookDeliveryJob do
+      post room_messages_url(room), params: {
+        message: { body: "<div>#{mention_attachment_for(bot)} check ci</div>" }
+      }, as: :turbo_stream
+    end
+
+    received_requests.pop(true)
+    assert_equal "All green", room.messages.ordered.last.plain_text_body
+
+    # 3. 204 No Content
+    next_response = ->(_payload) { [ 204, {}, "" ] }
+
+    assert_difference -> { room.messages.count }, +1 do
+      perform_enqueued_jobs only: Bots::WebhookDeliveryJob do
+        post room_messages_url(room), params: {
+          message: { body: "<div>#{mention_attachment_for(bot)} silent ack</div>" }
+        }, as: :turbo_stream
+      end
+    end
+
+    received_requests.pop(true)
+    assert_equal author, room.messages.ordered.last.creator
+  ensure
+    server&.close rescue nil
+    server_thread&.join(1)
+    WebMock.disable_net_connect!
+  end
+end
