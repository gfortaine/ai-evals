+      post room_bot_messages_url(@room, @bot.bot_key), params: +"Over 2", headers: { "Content-Type" => "text/plain" }
+      assert_response :too_many_requests
+      4.times do
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Second cooldown retry", headers: { "Content-Type" => "text/plain" }
+        assert_response :too_many_requests
+      end
+      assert_not @bot.reload.suspended?
+    end
+  end
