diff --git a/test/controllers/bots/messages_controller_test.rb b/test/controllers/bots/messages_controller_test.rb
new file mode 100644
index 0000000..2593ade
--- /dev/null
+++ b/test/controllers/bots/messages_controller_test.rb
@@ -0,0 +1,175 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "chat.example.com"
+    @bot = User.bot.create!(name: "Deploy Bot", creator: users(:kevin))
+    @open_room = rooms(:hq)
+    @open_room.memberships.grant_to(@bot)
+    @closed_room = rooms(:designers)
+  end
+
+  test "posting raw text creates a message authored by the bot and returns 201 with Location" do
+    assert_difference -> { @open_room.messages.count }, +1 do
+      post room_bot_messages_url(@open_room, @bot.bot_key),
+        params: +"Deploy of v1.2.3 finished ✅",
+        headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    end
+
+    message = Message.last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal @bot, message.creator
+    assert_equal "Deploy Bot", message.creator.name
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+  end
+
+  test "handles raw bodies with percent signs, ampersands, angle brackets, newlines, and invalid JSON" do
+    payload = +"Build #42: 98% pass & 2 < 3 in <main>\n{\"raw\": broken"
+
+    post room_bot_messages_url(@open_room, @bot.bot_key),
+      params: payload,
+      headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+
+    assert_response :created
+    message = Message.last
+    assert_equal payload, message.plain_text_body
+
+    sign_in :david
+    get room_url(@open_room)
+    assert_response :ok
+    assert_select "##{dom_id(message)}" do
+      assert_select ".message__author strong", text: "Deploy Bot"
+      assert_select ".trix-content", text: /Build #42: 98% pass & 2 < 3 in <main>/
+    end
+  end
+
+  test "escapes script tags safely" do
+    post room_bot_messages_url(@open_room, @bot.bot_key),
+      params: +"<script>alert('xss')</script>",
+      headers: { "Content-Type" => "text/plain" }
+
+    assert_response :created
+    message = Message.last
+
+    sign_in :david
+    get room_url(@open_room)
+    assert_select "##{dom_id(message)} script", count: 0
+    assert_select "##{dom_id(message)} .trix-content", text: /<script>alert\('xss'\)<\/script>/
+  end
+
+  test "broadcasts message to connected clients and unread rooms channel" do
+    assert_broadcasts UnreadRoomsChannel.stream_name_for(users(:david).id), 1 do
+      post room_bot_messages_url(@open_room, @bot.bot_key),
+        params: +"Deploy of v1.2.3 finished ✅",
+        headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    end
+
+    assert_rendered_turbo_stream_broadcast @open_room, :messages, action: "append", target: [ @open_room, :messages ] do
+      assert_select ".message__author strong", text: "Deploy Bot"
+      assert_select ".message__body", text: /Deploy of v1.2.3 finished ✅/
+    end
+  end
+
+  test "triggers push notifications just like a human-authored message" do
+    expected_deliveries = Push::Subscription.joins(user: :memberships)
+      .merge(Membership.visible.disconnected.involved_in_everything.where(room: @open_room))
+      .count
+    assert expected_deliveries > 0
+
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      WebPush.expects(:payload_send).with { |params|
+        payload = JSON.parse(params[:message])
+        payload["title"] == @open_room.name &&
+          payload.dig("options", "body") == "Deploy Bot: Deploy of v1.2.3 finished ✅"
+      }.times(expected_deliveries)
+
+      post room_bot_messages_url(@open_room, @bot.bot_key),
+        params: +"Deploy of v1.2.3 finished ✅",
+        headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    end
+
+    start = Time.now
+    pool = Rails.configuration.x.web_push_pool.delivery_pool
+    sleep 0.01 while pool.completed_task_count < expected_deliveries && Time.now - start < 0.5
+    assert_equal expected_deliveries, pool.completed_task_count
+  end
+
+  test "returns 422 Unprocessable Content for empty or whitespace-only body without attachment" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@open_room, @bot.bot_key),
+        params: +"",
+        headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    end
+    assert_response :unprocessable_content
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@open_room, @bot.bot_key),
+        params: +"   \n  ",
+        headers: { "Content-Type" => "text/plain" }
+    end
+    assert_response :unprocessable_content
+  end
+
+  test "returns 404 Not Found for bad room id or room the bot is not a member of" do
+    post room_bot_messages_url(999999, @bot.bot_key),
+      params: +"Hello",
+      headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    assert_response :not_found
+
+    post room_bot_messages_url("bad.room", @bot.bot_key),
+      params: +"Hello",
+      headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    assert_response :not_found
+
+    assert_not_includes rooms(:pets).users, @bot
+    post room_bot_messages_url(rooms(:pets), @bot.bot_key),
+      params: +"Hello unjoined open room",
+      headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    assert_response :not_found
+
+    assert_not_includes @closed_room.users, @bot
+    post room_bot_messages_url(@closed_room, @bot.bot_key),
+      params: +"Hello",
+      headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    assert_response :not_found
+
+    @closed_room.memberships.grant_to(@bot)
+    post room_bot_messages_url(@closed_room, @bot.bot_key),
+      params: +"Hello closed room!",
+      headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    assert_response :created
+  end
+
+  test "returns 401 Unauthorized for invalid bot code or deleted bot" do
+    post room_bot_messages_url(@open_room, "invalid-bot-code"),
+      params: +"Hello",
+      headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    assert_response :unauthorized
+
+    post room_bot_messages_url(999999, "invalid.code"),
+      params: +"Hello",
+      headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    assert_response :unauthorized
+
+    old_key = @bot.bot_key
+    @bot.deactivate
+
+    post room_bot_messages_url(@open_room, old_key),
+      params: +"Hello after delete",
+      headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    assert_response :unauthorized
+  end
+
+  test "supports posting an attachment with empty body" do
+    assert_difference -> { @open_room.messages.count }, +1 do
+      post room_bot_messages_url(@open_room, @bot.bot_key),
+        params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+    end
+
+    assert_response :created
+    message = Message.last
+    assert message.attachment?
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+  end
+end
diff --git a/test/controllers/bots/suspensions_controller_test.rb b/test/controllers/bots/suspensions_controller_test.rb
new file mode 100644
index 0000000..36eb4d4
--- /dev/null
+++ b/test/controllers/bots/suspensions_controller_test.rb
@@ -0,0 +1,225 @@
+require "test_helper"
+
+class Bots::SuspensionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @admin = users(:david)
+    @member = users(:kevin)
+    @other_member = users(:jz)
+    @room = rooms(:hq)
+    @bot = User.bot.create!(
+      name: "Misbehaving Bot",
+      creator: @member,
+      webhook_url: "https://hooks.example.com/misbehaving"
+    )
+    @room.memberships.grant_to(@bot)
+  end
+
+  test "API flooding returns 429 with Retry-After during 30s cooldown, suspends on 5th cooldown attempt, and returns 403 while suspended" do
+    other_room = rooms(:pets)
+    other_room.memberships.grant_to(@bot)
+
+    freeze_time do
+      # 6 messages in @room + 4 messages in other_room = 10 messages across rooms -> all 201 Created
+      6.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"HQ #{i}", headers: { "Content-Type" => "text/plain" }
+        assert_response :created
+      end
+      4.times do |i|
+        post room_bot_messages_url(other_room, @bot.bot_key), params: +"Pets #{i}", headers: { "Content-Type" => "text/plain" }
+        assert_response :created
+      end
+
+      # 11th message goes over limit -> 429 Too Many Requests + Retry-After: 30
+      assert_no_difference -> { Message.count } do
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Too fast", headers: { "Content-Type" => "text/plain" }
+      end
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+      assert_not @bot.reload.suspended?
+
+      # 4 more attempts during cooldown -> 429 with decreasing Retry-After
+      [ [ 5, "25" ], [ 10, "15" ], [ 10, "5" ], [ 4, "1" ] ].each do |advance_seconds, expected_retry_after|
+        travel advance_seconds.seconds
+        assert_no_difference -> { Message.count } do
+          post room_bot_messages_url(@room, @bot.bot_key), params: +"During cooldown", headers: { "Content-Type" => "text/plain" }
+        end
+        assert_response :too_many_requests
+        assert_equal expected_retry_after, response.headers["Retry-After"]
+        assert_not @bot.reload.suspended?
+      end
+
+      # 5th attempt during the same cooldown suspends the bot and returns 403 Forbidden
+      assert_no_difference -> { Message.count } do
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Final straw", headers: { "Content-Type" => "text/plain" }
+      end
+      assert_response :forbidden
+      assert_nil response.headers["Retry-After"]
+      assert @bot.reload.suspended?
+      assert_equal "Flooding", @bot.suspension_reason
+
+      # Even after 60 seconds pass, suspended bot still gets 403 Forbidden
+      travel 60.seconds
+      post room_bot_messages_url(@room, @bot.bot_key), params: +"Still suspended", headers: { "Content-Type" => "text/plain" }
+      assert_response :forbidden
+
+      # Invalid bot code still gets 401 Unauthorized (does not leak suspension state)
+      post room_bot_messages_url(@room, "#{@bot.id}-wrongtoken"), params: +"Bad token", headers: { "Content-Type" => "text/plain" }
+      assert_response :unauthorized
+    end
+  end
+
+  test "bots page shows Suspended with reason to owner and admins, hides Reactivate from non-admins, and enforces bot limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+    webhook_bot = User.bot.create!(name: "Broken Hook Bot", creator: @member, webhook_url: "https://hooks.example.com/broken")
+
+    @bot.suspend!("Flooding")
+    webhook_bot.suspend!("Failing webhooks")
+
+    # Member (owner) sees both suspended bots, their reasons, reached limit notice, and NO Reactivate button
+    sign_in @member
+    get bots_url
+    assert_response :ok
+    assert_select "p", text: "You've reached the limit for chat bots."
+    assert_select "a[href=?]", new_bot_path, count: 0
+
+    assert_select "li##{dom_id(@bot)}" do
+      assert_select "strong", text: "Misbehaving Bot"
+      assert_select "span", text: "Suspended"
+      assert_select "span", text: "Flooding"
+      assert_select "button", text: /Reactivate/, count: 0
+    end
+
+    assert_select "li##{dom_id(webhook_bot)}" do
+      assert_select "strong", text: "Broken Hook Bot"
+      assert_select "span", text: "Suspended"
+      assert_select "span", text: "Failing webhooks"
+      assert_select "button", text: /Reactivate/, count: 0
+    end
+
+    # Member cannot create another bot because suspended bots still count toward limit
+    get new_bot_url
+    assert_response :forbidden
