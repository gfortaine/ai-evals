+++ b/test/models/user/bot/moderation_test.rb
@@ -0,0 +1,279 @@
+require "test_helper"
+
+class User::Bot::ModerationTest < ActionDispatch::IntegrationTest
+  setup do
+    @admin = users(:david)
+    @member = users(:kevin)
+    @room = rooms(:hq)
+    @bot = User.bot.create!(
+      name: "Watchdog Bot",
+      creator: @member,
+      webhook_url: "https://hooks.example.com/watchdog"
+    )
+    @room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+  end
+
+  test "sliding window allows at most 10 messages in any 10 seconds across API and webhook replies" do
+    WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(
+      status: 200,
+      headers: { "Content-Type" => "text/plain" },
+      body: "Webhook reply"
+    )
+
+    freeze_time do
+      # 6 API messages at t = 0..5s
+      6.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key),
+          params: +"API message #{i}",
+          headers: { "Content-Type" => "text/plain" }
+        assert_response :created
+        travel 1.second if i < 5
+      end
+
+      # 4 webhook replies at t = 5..8s (total = 10 messages in [0s, 8s])
+      4.times do |i|
+        travel 1.second if i > 0
+        user_msg = @room.messages.create!(creator: @admin, body: "Ping #{i}")
+        assert_difference -> { @room.messages.where(creator: @bot).count }, +1 do
+          @bot.deliver_webhook(user_msg)
+        end
+      end
+
+      # At t = 10.0s, the first API message from t = 0.0s has aged out of the 10s window,
+      # leaving 9 messages in (0.0s, 10.0s], so 1 more message is allowed!
+      travel 2.seconds
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: +"Allowed after oldest aged out",
+        headers: { "Content-Type" => "text/plain" }
+      assert_response :created
+      assert_not @bot.reload.in_cooldown?
+
+      # Immediate next message at t = 10.0s goes over the 10-in-10s limit -> rejected & starts 30s cooldown
+      assert_no_difference -> { @room.messages.count } do
+        post room_bot_messages_url(@room, @bot.bot_key),
+          params: +"Over the limit",
+          headers: { "Content-Type" => "text/plain" }
+      end
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+      assert @bot.reload.in_cooldown?
+      assert_not @bot.suspended?
+    end
+  end
+
+  test "webhook reply going over the 10-in-10s limit is not posted, starts cooldown, suppresses replies during cooldown, and 5 cooldown attempts suspend the bot" do
+    WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(
+      status: 200,
+      headers: { "Content-Type" => "text/plain" },
+      body: "Noisy reply"
+    )
+
+    freeze_time do
+      10.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key),
+          params: +"Burst #{i}",
+          headers: { "Content-Type" => "text/plain" }
+        assert_response :created
+      end
+
+      # 11th message via webhook reply -> rejected and starts 30s cooldown
+      trigger_msg = @room.messages.create!(creator: @admin, body: "Trigger 11")
+      assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+        @bot.deliver_webhook(trigger_msg)
+      end
+      assert @bot.reload.in_cooldown?
+      assert_equal 0, @bot.cooldown_attempts_count
+      assert_not @bot.suspended?
+
+      # 204 No Content during cooldown is not a post attempt
+      WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(status: 204)
+      @bot.deliver_webhook(@room.messages.create!(creator: @admin, body: "Silent"))
+      assert_equal 0, @bot.reload.cooldown_attempts_count
+
+      # Blank HTML body during cooldown is not a post attempt
+      WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(
+        status: 200,
+        headers: { "Content-Type" => "text/html" },
+        body: "<div>   </div>"
+      )
+      @bot.deliver_webhook(@room.messages.create!(creator: @admin, body: "Blank HTML"))
+      assert_equal 0, @bot.reload.cooldown_attempts_count
+
+      # Restore non-blank reply: 3 webhook reply attempts + 1 API attempt = 4 attempts during cooldown (not suspended yet)
+      WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(
+        status: 200,
+        headers: { "Content-Type" => "text/plain" },
+        body: "Still replying"
+      )
+      3.times do |i|
+        msg = @room.messages.create!(creator: @admin, body: "Attempt #{i}")
+        assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+          @bot.deliver_webhook(msg)
+        end
+      end
+
+      travel 12.seconds
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: +"4th cooldown attempt",
+        headers: { "Content-Type" => "text/plain" }
+      assert_response :too_many_requests
+      assert_equal "18", response.headers["Retry-After"]
+      assert_not @bot.reload.suspended?
+
+      # 5th attempt via webhook reply during the same cooldown suspends the bot!
+      fifth_msg = @room.messages.create!(creator: @admin, body: "5th attempt")
+      assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+        @bot.deliver_webhook(fifth_msg)
+      end
+
+      assert @bot.reload.suspended?
+      assert_equal "Flooding", @bot.suspension_reason
+    end
+  end
+
+  test "waiting out a 30-second cooldown resets cooldown attempts so a subsequent cooldown starts fresh" do
+    freeze_time do
+      10.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"First #{i}", headers: { "Content-Type" => "text/plain" }
+        assert_response :created
+      end
+
+      # Start first cooldown
+      post room_bot_messages_url(@room, @bot.bot_key), params: +"Over 1", headers: { "Content-Type" => "text/plain" }
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+
+      # 4 attempts during first cooldown -> not suspended
+      4.times do
+        travel 5.seconds
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Retry early", headers: { "Content-Type" => "text/plain" }
+        assert_response :too_many_requests
+      end
+      assert_not @bot.reload.suspended?
+
+      # At 29s (9s more): still 1s left
+      travel 9.seconds
+      # Wait: that would be 5th attempt if we posted at 29s! Instead advance past 30s (10s more -> total 30s):
+      travel 1.second
+      assert_not @bot.reload.in_cooldown?
+
+      # Now posting succeeds again and starts a clean slate
+      10.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Second burst #{i}", headers: { "Content-Type" => "text/plain" }
+        assert_response :created
+      end
+
+      # Start second cooldown -> 4 more attempts in second cooldown do NOT suspend (prior 4 did not carry over)
+      post room_bot_messages_url(@room, @bot.bot_key), params: +"Over 2", headers: { "Content-Type" => "text/plain" }
+      assert_response :too_many_requests
+      4.times do
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Second cooldown retry", headers: { "Content-Type" => "text/plain" }
+        assert_response :too_many_requests
+      end
+      assert_not @bot.reload.suspended?
+    end
+  end
+
+  test "ten failed webhook deliveries in a row suspend the bot while any 2xx resets the failure count" do
+    message = @room.messages.create!(creator: @admin, body: "Check webhook")
+
+    # 9 mixed failures (non-2xx responses, timeout, connection errors)
+    [
+      -> { WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(status: 500) },
+      -> { WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(status: 502) },
+      -> { WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(status: 404) },
+      -> { WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(status: 429) },
+      -> { WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(status: 302, headers: { "Location" => "https://example.com" }) },
+      -> { WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_timeout },
+      -> { WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_raise(Errno::ECONNREFUSED) },
+      -> { WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_raise(SocketError.new("getaddrinfo: nodename nor servname provided")) },
+      -> { WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_raise(OpenSSL::SSL::SSLError.new("handshake failure")) }
+    ].each_with_index do |configure_stub, index|
+      configure_stub.call
+      @bot.deliver_webhook(message)
+      assert_equal index + 1, @bot.reload.webhook_failures_count
+      assert_not @bot.suspended?
+    end
+
+    # A 2xx response (e.g. 202 Accepted or 204 No Content) resets the count to 0
+    WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(status: 202)
+    @bot.deliver_webhook(message)
+    assert_equal 0, @bot.reload.webhook_failures_count
+    assert_not @bot.suspended?
+
+    # 9 more failures in a row -> still not suspended
+    WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(status: 503)
+    9.times { @bot.deliver_webhook(message) }
+    assert_equal 9, @bot.reload.webhook_failures_count
+    assert_not @bot.suspended?
+
+    # 10th consecutive failure -> suspends the bot!
+    WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_timeout
+    @bot.deliver_webhook(message)
+    assert @bot.reload.suspended?
+    assert_equal "Failing webhooks", @bot.suspension_reason
+  end
+
+  test "suspended bot receives no mention or joined webhooks even if jobs were already enqueued" do
+    sign_in @admin
+    stub = WebMock.stub_request(:post, "https://hooks.example.com/watchdog").to_return(status: 204)
+
+    # Enqueue a job BEFORE suspension, then suspend the bot before the job executes
+    pre_message = @room.messages.create!(creator: @admin, body: "Before suspend")
+    Bots::WebhookDeliveryJob.perform_later(@bot, pre_message, "mention")
+
+    @bot.suspend!("Failing webhooks")
+
+    perform_enqueued_jobs only: Bots::WebhookDeliveryJob
+    assert_not_requested stub
+
+    # Mentioning a suspended bot enqueues no webhook jobs
+    assert_no_enqueued_jobs only: Bots::WebhookDeliveryJob do
+      post room_messages_url(@room), params: {
+        message: { body: "<div>#{mention_attachment_for(@bot)} are you there?</div>" }
+      }, as: :turbo_stream
+    end
+    assert_response :success
+
+    # Adding a suspended bot to a new room enqueues no joined webhook jobs
+    other_room = Rooms::Closed.create_for({ name: "Ops", creator: @admin }, users: [ @admin ])
+    assert_no_enqueued_jobs only: Bots::WebhookDeliveryJob do
+      other_room.memberships.grant_to(@bot)
+    end
+    assert_not_requested stub
+  end
+
+  test "suspended bot keeps its rooms and messages across room edits and still counts toward owner bot limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    closed_room = Rooms::Closed.create_for({ name: "Secret Ops", creator: @admin }, users: [ @admin, @member, @bot ])
+    authored_message = @room.messages.create!(creator: @bot, body: "Historical alert")
+
+    assert @member.reached_bot_limit?
+
+    @bot.suspend!("Flooding")
+
+    assert_includes @bot.reload.rooms, @room
+    assert_includes @bot.rooms, closed_room
+    assert_equal @bot, authored_message.reload.creator
+    assert @member.reached_bot_limit?
+
+    # Editing the closed room's name preserves the suspended bot's membership
+    sign_in @admin
+    patch rooms_closed_url(closed_room), params: {
+      room: { name: "Renamed Secret Ops" },
+      user_ids: [ @admin.id, @member.id, @bot.id ]
+    }
+    assert_redirected_to room_url(closed_room)
+    assert_includes closed_room.reload.users, @bot
+
+    # Deleting (deactivating) the suspended bot frees the owner's bot limit and returns 401 on posting
+    old_key = @bot.bot_key
+    @bot.deactivate
+    assert_not @member.reached_bot_limit?
+    assert_not @bot.reload.suspended?
+
+    post room_bot_messages_url(@room, old_key), params: +"After delete", headers: { "Content-Type" => "text/plain" }
+    assert_response :unauthorized
+  end
+end
