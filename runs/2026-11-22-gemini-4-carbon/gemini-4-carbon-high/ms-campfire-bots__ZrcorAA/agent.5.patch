+++ b/test/controllers/bots/suspensions_controller_test.rb
@@ -0,0 +1,225 @@
+require "test_helper"
+
+class Bots::SuspensionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @admin = users(:david)
+    @member = users(:kevin)
+    @other_member = users(:jz)
+    @room = rooms(:hq)
+    @bot = User.bot.create!(
+      name: "Misbehaving Bot",
+      creator: @member,
+      webhook_url: "https://hooks.example.com/misbehaving"
+    )
+    @room.memberships.grant_to(@bot)
+  end
+
+  test "API flooding returns 429 with Retry-After during 30s cooldown, suspends on 5th cooldown attempt, and returns 403 while suspended" do
+    other_room = rooms(:pets)
+    other_room.memberships.grant_to(@bot)
+
+    freeze_time do
+      # 6 messages in @room + 4 messages in other_room = 10 messages across rooms -> all 201 Created
+      6.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"HQ #{i}", headers: { "Content-Type" => "text/plain" }
+        assert_response :created
+      end
+      4.times do |i|
+        post room_bot_messages_url(other_room, @bot.bot_key), params: +"Pets #{i}", headers: { "Content-Type" => "text/plain" }
+        assert_response :created
+      end
+
+      # 11th message goes over limit -> 429 Too Many Requests + Retry-After: 30
+      assert_no_difference -> { Message.count } do
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Too fast", headers: { "Content-Type" => "text/plain" }
+      end
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+      assert_not @bot.reload.suspended?
+
+      # 4 more attempts during cooldown -> 429 with decreasing Retry-After
+      [ [ 5, "25" ], [ 10, "15" ], [ 10, "5" ], [ 4, "1" ] ].each do |advance_seconds, expected_retry_after|
+        travel advance_seconds.seconds
+        assert_no_difference -> { Message.count } do
+          post room_bot_messages_url(@room, @bot.bot_key), params: +"During cooldown", headers: { "Content-Type" => "text/plain" }
+        end
+        assert_response :too_many_requests
+        assert_equal expected_retry_after, response.headers["Retry-After"]
+        assert_not @bot.reload.suspended?
+      end
+
+      # 5th attempt during the same cooldown suspends the bot and returns 403 Forbidden
+      assert_no_difference -> { Message.count } do
+        post room_bot_messages_url(@room, @bot.bot_key), params: +"Final straw", headers: { "Content-Type" => "text/plain" }
+      end
+      assert_response :forbidden
+      assert_nil response.headers["Retry-After"]
+      assert @bot.reload.suspended?
+      assert_equal "Flooding", @bot.suspension_reason
+
+      # Even after 60 seconds pass, suspended bot still gets 403 Forbidden
+      travel 60.seconds
+      post room_bot_messages_url(@room, @bot.bot_key), params: +"Still suspended", headers: { "Content-Type" => "text/plain" }
+      assert_response :forbidden
+
+      # Invalid bot code still gets 401 Unauthorized (does not leak suspension state)
+      post room_bot_messages_url(@room, "#{@bot.id}-wrongtoken"), params: +"Bad token", headers: { "Content-Type" => "text/plain" }
+      assert_response :unauthorized
+    end
+  end
+
+  test "bots page shows Suspended with reason to owner and admins, hides Reactivate from non-admins, and enforces bot limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+    webhook_bot = User.bot.create!(name: "Broken Hook Bot", creator: @member, webhook_url: "https://hooks.example.com/broken")
+
+    @bot.suspend!("Flooding")
+    webhook_bot.suspend!("Failing webhooks")
+
+    # Member (owner) sees both suspended bots, their reasons, reached limit notice, and NO Reactivate button
+    sign_in @member
+    get bots_url
+    assert_response :ok
+    assert_select "p", text: "You've reached the limit for chat bots."
+    assert_select "a[href=?]", new_bot_path, count: 0
+
+    assert_select "li##{dom_id(@bot)}" do
+      assert_select "strong", text: "Misbehaving Bot"
+      assert_select "span", text: "Suspended"
+      assert_select "span", text: "Flooding"
+      assert_select "button", text: /Reactivate/, count: 0
+    end
+
+    assert_select "li##{dom_id(webhook_bot)}" do
+      assert_select "strong", text: "Broken Hook Bot"
+      assert_select "span", text: "Suspended"
+      assert_select "span", text: "Failing webhooks"
+      assert_select "button", text: /Reactivate/, count: 0
+    end
+
+    # Member cannot create another bot because suspended bots still count toward limit
+    get new_bot_url
+    assert_response :forbidden
+    post bots_url, params: { bot: { name: "Extra Bot" } }
+    assert_response :forbidden
+
+    # Member can edit their suspended bot (e.g. fix webhook URL) without reactivating it
+    patch bot_url(webhook_bot), params: {
+      bot: { name: "Fixed Hook Bot", webhook_url: "https://hooks.example.com/fixed" }
+    }
+    assert_redirected_to bots_url
+    assert webhook_bot.reload.suspended?
+    assert_equal "https://hooks.example.com/fixed", webhook_bot.webhook_url
+
+    # Non-admin member (even creator) gets 403 Forbidden if attempting to reactivate directly
+    delete bot_suspension_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+
+    # Other member also gets 403 Forbidden
+    sign_in @other_member
+    delete bot_suspension_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "administrator sees Reactivate button with confirmation only on suspended bots and can reactivate them" do
+    healthy_bot = User.bot.create!(name: "Healthy Bot", creator: @member)
+    @bot.suspend!("Flooding")
+
+    sign_in @admin
+    get bots_url
+    assert_response :ok
+
+    assert_select "li##{dom_id(healthy_bot)}" do
+      assert_select "span", text: "Suspended", count: 0
+      assert_select "button", text: /Reactivate/, count: 0
+    end
+
+    assert_select "li##{dom_id(@bot)}" do
+      assert_select "span", text: "Suspended"
+      assert_select "span", text: "Flooding"
+      assert_select "form[action=?] button[data-turbo-confirm]", bot_suspension_path(@bot), text: "Reactivate"
+    end
+
+    # Admin reactivates the bot
+    delete bot_suspension_url(@bot)
+    assert_redirected_to bots_url
+    assert_not @bot.reload.suspended?
+    assert_nil @bot.suspension_reason
+
+    follow_redirect!
+    assert_select "li##{dom_id(@bot)}" do
+      assert_select "span", text: "Suspended", count: 0
+      assert_select "button", text: /Reactivate/, count: 0
+    end
+
+    # Reactivated bot can post via API and receive webhooks again
+    post room_bot_messages_url(@room, @bot.bot_key), params: +"Back online!", headers: { "Content-Type" => "text/plain" }
+    assert_response :created
+
+    stub = WebMock.stub_request(:post, "https://hooks.example.com/misbehaving").to_return(status: 204)
+    perform_enqueued_jobs only: Bots::WebhookDeliveryJob do
+      post room_messages_url(@room), params: {
+        message: { body: "<div>#{mention_attachment_for(@bot)} welcome back</div>" }
+      }, as: :turbo_stream
+    end
+    assert_requested stub, times: 1
+  end
+
+  test "driving suspended bot display and admin reactivation end-to-end via Capybara browser labels" do
+    ua = "Mozilla/5.0 (Macintosh; Intel Mac OS X 14_0) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36"
+    hook_bot = User.bot.create!(name: "Failing Hook Bot", creator: @member, webhook_url: "https://hooks.example.com/down")
+
+    @bot.suspend!("Flooding")
+    hook_bot.suspend!("Failing webhooks")
+
+    member_session = Capybara::Session.new(:rack_test, Rails.application)
+    member_session.driver.header("User-Agent", ua)
+    member_session.visit new_session_path
+    member_session.fill_in "Enter your email address", with: @member.email_address
+    member_session.fill_in "Enter your password", with: "secret123456"
+    member_session.click_on "log_in"
+    member_session.visit bots_path
+
+    member_session.within("##{dom_id(@bot)}") do
+      assert member_session.has_text?("Misbehaving Bot")
+      assert member_session.has_text?("Suspended")
+      assert member_session.has_text?("Flooding")
+      assert member_session.has_no_button?("Reactivate")
+    end
+
+    member_session.within("##{dom_id(hook_bot)}") do
+      assert member_session.has_text?("Failing Hook Bot")
+      assert member_session.has_text?("Suspended")
+      assert member_session.has_text?("Failing webhooks")
+      assert member_session.has_no_button?("Reactivate")
+    end
+
+    admin_session = Capybara::Session.new(:rack_test, Rails.application)
+    admin_session.driver.header("User-Agent", ua)
+    admin_session.visit new_session_path
+    admin_session.fill_in "Enter your email address", with: @admin.email_address
+    admin_session.fill_in "Enter your password", with: "secret123456"
+    admin_session.click_on "log_in"
+    admin_session.visit bots_path
+
+    admin_session.within("##{dom_id(@bot)}") do
+      assert admin_session.has_text?("Suspended")
+      assert admin_session.has_text?("Flooding")
+      assert admin_session.has_button?("Reactivate")
+      admin_session.click_button "Reactivate"
+    end
+
+    admin_session.within("##{dom_id(@bot)}") do
+      assert admin_session.has_no_text?("Suspended")
+      assert admin_session.has_no_button?("Reactivate")
+    end
+    assert_not @bot.reload.suspended?
+
+    admin_session.within("##{dom_id(hook_bot)}") do
+      assert admin_session.has_text?("Suspended")
+      assert admin_session.has_text?("Failing webhooks")
+      assert admin_session.has_button?("Reactivate")
+    end
+  end
+end
diff --git a/test/models/user/bot/moderation_test.rb b/test/models/user/bot/moderation_test.rb
