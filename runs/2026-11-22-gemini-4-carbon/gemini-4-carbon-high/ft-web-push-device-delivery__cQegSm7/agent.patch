@@ -0,0 +1,101 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:kevin)
+    sign_in_as @user
+  end
+
+  test "shows help copy when browser blocks notifications" do
+    visit notifications_settings_path
+
+    assert_text "Push notifications are off for this device"
+    assert_no_text "Push notifications are on for this device"
+    assert_no_text "Turn on notifications for this website."
+
+    find(".switch").click
+
+    assert_text "Push notifications are off for this device"
+    assert_text "Turn on notifications for this website."
+  end
+
+  test "subscribes, reflects existing subscription, and unsubscribes current device" do
+    visit notifications_settings_path
+    assert_text "Push notifications are off for this device"
+
+    page.execute_script(<<~JS)
+      window.__mockSubscription = {
+        endpoint: "https://fcm.googleapis.com/fcm/send/browser-device-token",
+        unsubscribeCalled: false,
+        toJSON() {
+          return {
+            endpoint: this.endpoint,
+            keys: {
+              p256dh: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+              auth: "tBHItJI5svbpez7KI4CCXg"
+            }
+          }
+        },
+        async unsubscribe() {
+          this.unsubscribeCalled = true
+          window.__activeSub = null
+          return true
+        }
+      }
+      window.__activeSub = null
+
+      Object.defineProperty(window, "Notification", {
+        configurable: true,
+        value: {
+          permission: "default",
+          async requestPermission() {
+            this.permission = "granted"
+            return "granted"
+          }
+        }
+      })
+
+      Object.defineProperty(window, "PushManager", {
+        configurable: true,
+        value: function PushManager() {}
+      })
+
+      navigator.serviceWorker.getRegistration = async () => ({
+        active: {},
+        pushManager: {
+          async getSubscription() {
+            return window.__activeSub
+          },
+          async subscribe(options) {
+            window.__subscribeOptions = options
+            window.__activeSub = window.__mockSubscription
+            return window.__mockSubscription
+          }
+        }
+      })
+    JS
+
+    find(".switch").click
+
+    assert_text "Push notifications are on for this device"
+    assert_no_text "Push notifications are off for this device"
+
+    subscription = @user.push_subscriptions.find_by(endpoint: "https://fcm.googleapis.com/fcm/send/browser-device-token")
+    assert_not_nil subscription
+    assert_equal "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM", subscription.p256dh_key
+    assert_equal "tBHItJI5svbpez7KI4CCXg", subscription.auth_key
+
+    user_visible_only = page.evaluate_script("window.__subscribeOptions.userVisibleOnly")
+    key_byte_length = page.evaluate_script("window.__subscribeOptions.applicationServerKey.byteLength")
+    assert_equal true, user_visible_only
+    assert_equal 65, key_byte_length
+
+    # Toggle off
+    find(".switch").click
+
+    assert_text "Push notifications are off for this device"
+    assert_no_text "Push notifications are on for this device"
+    assert_nil @user.push_subscriptions.find_by(endpoint: "https://fcm.googleapis.com/fcm/send/browser-device-token")
+    assert_equal true, page.evaluate_script("window.__mockSubscription.unsubscribeCalled")
+  end
+end
