new file mode 100644
index 0000000..1a46fde
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,47 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    if subscription = @user.push_subscriptions.find_by(push_subscription_params)
+      subscription.touch
+    else
+      subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+      subscription.update!(push_subscription_params.merge(user_agent: request.user_agent))
+    end
+
+    head :created
+  end
+
+  def destroy
+    if params[:id].present?
+      @user.push_subscriptions.find(params[:id]).destroy!
+    elsif endpoint = destroy_endpoint_param
+      @user.push_subscriptions.destroy_by(endpoint: endpoint)
+    end
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path }
+      format.any { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+
+    def destroy_endpoint_param
+      params[:endpoint].presence || params.dig(:push_subscription, :endpoint).presence
+    end
+end
