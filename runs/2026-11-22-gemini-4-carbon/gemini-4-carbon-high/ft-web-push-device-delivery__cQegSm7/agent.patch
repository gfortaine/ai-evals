diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..4cf4462
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:kevin)
+    sign_in_as @user
+  end
+
+  test "create registers push subscription for current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: "https://fcm.googleapis.com/fcm/send/abc-123",
+            p256dh_key: "p256dh-test-key",
+            auth_key: "auth-test-key"
+          }
+        },
+        headers: { "HTTP_USER_AGENT" => "Mozilla/5.0 Test Browser" }
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://fcm.googleapis.com/fcm/send/abc-123", subscription.endpoint
+    assert_equal "p256dh-test-key", subscription.p256dh_key
+    assert_equal "auth-test-key", subscription.auth_key
+    assert_equal "Mozilla/5.0 Test Browser", subscription.user_agent
+    assert_equal Current.account, subscription.account
+  end
+
+  test "create with flat JSON params" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user),
+        params: {
+          endpoint: "https://fcm.googleapis.com/fcm/send/flat-json",
+          p256dh_key: "flat-p256dh",
+          auth_key: "flat-auth"
+        },
+        as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create updates existing subscription when endpoint already registered" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/existing",
+      p256dh_key: "old-p256dh",
+      auth_key: "old-auth"
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: subscription.endpoint,
+            p256dh_key: "new-p256dh",
+            auth_key: "new-auth"
+          }
+        },
+        as: :json
+    end
+
+    assert_response :created
+    assert_equal "new-p256dh", subscription.reload.p256dh_key
+    assert_equal "new-auth", subscription.auth_key
+  end
+
+  test "create is forbidden for another user" do
+    other_user = users(:david)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(other_user),
+        params: {
+          push_subscription: {
+            endpoint: "https://fcm.googleapis.com/fcm/send/forbidden",
+            p256dh_key: "p256dh-key",
+            auth_key: "auth-key"
+          }
+        }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy by id deletes subscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/to-delete",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy on collection by endpoint deletes subscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/by-endpoint",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user),
+        params: { push_subscription: { endpoint: subscription.endpoint } },
+        as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy is forbidden for another user" do
+    other_user = users(:david)
+    subscription = other_user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/other-user",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    assert_no_difference -> { Push::Subscription.count } do
+      delete user_push_subscription_path(other_user, subscription), as: :json
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/notification/pushing_test.rb b/test/models/notification/pushing_test.rb
new file mode 100644
index 0000000..7516679
--- /dev/null
+++ b/test/models/notification/pushing_test.rb
@@ -0,0 +1,144 @@
+require "test_helper"
+
+class Notification::PushingTest < ActiveSupport::TestCase
+  include NotificationsHelper
+
+  setup do
+    @kevin = users(:kevin)
+    @david = users(:david)
+    @phone = create_push_subscription_for(@kevin, endpoint: "https://web.push.apple.com/phone-token")
+    @desktop = create_push_subscription_for(@kevin, endpoint: "https://fcm.googleapis.com/fcm/send/desktop-token")
+  end
+
+  test "pushes comment notification to phone and desktop with tray copy and card path" do
+    card = cards(:logo)
+    card.watch_by(@kevin)
+
+    captured_messages = []
+    WebPush.stubs(:payload_send).with do |kwargs|
+      captured_messages << kwargs
+      true
+    end.returns(true)
+
+    perform_enqueued_jobs do
+      card.comments.create!(body: "Looks ready to ship!", creator: @david)
+    end
+
+    notification = @kevin.notifications.find_by!(card: card)
+    expected_path = "/#{@kevin.account.external_account_id}/cards/#{card.number}"
+
+    assert_equal 2, captured_messages.size
+    assert_equal [ @phone.endpoint, @desktop.endpoint ].sort, captured_messages.map { |m| m[:endpoint] }.sort
+
+    payload = JSON.parse(captured_messages.first[:message])
+    assert_equal event_notification_title(notification.source), payload["title"]
+    assert_equal "RE: #{card.title}", payload["title"]
+    assert_equal event_notification_body(notification.source), payload.dig("options", "body")
+    assert_equal "Looks ready to ship!", payload.dig("options", "body")
+    assert_equal expected_path, payload.dig("options", "data", "path")
+  end
+
+  test "pushes encrypted RFC8030 payload with VAPID header to push service" do
+    notification = notifications(:layout_commented_kevin)
+    notification.destroy!
+
+    stub_request(:post, @phone.endpoint).to_return(status: 201)
+    stub_request(:post, @desktop.endpoint).to_return(status: 201)
+
+    perform_enqueued_jobs do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    end
+
+    assert_requested(:post, @phone.endpoint, times: 1) do |req|
+      req.headers["Authorization"]&.start_with?("vapid t=") &&
+        req.headers["Content-Encoding"] == "aes128gcm"
+    end
+    assert_requested(:post, @desktop.endpoint, times: 1)
+  end
+
+  test "pushes mention notification with mentioner first name and content" do
+    card = cards(:logo)
+    mention = nil
+
+    captured_messages = []
+    WebPush.stubs(:payload_send).with do |kwargs|
+      captured_messages << kwargs
+      true
+    end.returns(true)
+
+    perform_enqueued_jobs do
+      comment = card.comments.create!(body: "Hey check this out", creator: @david)
+      mention = Mention.create!(source: comment, mentioner: @david, mentionee: @kevin)
+    end
+
+    mention_payloads = captured_messages.map { |m| JSON.parse(m[:message]) }.select { |p| p["title"].include?("@mentioned you") }
+    assert mention_payloads.any?
+    assert_equal "#{@david.first_name} @mentioned you", mention_payloads.last["title"]
+    assert_equal mention.source.mentionable_content.truncate(200), mention_payloads.last.dig("options", "body")
+    assert_equal "/#{@kevin.account.external_account_id}/cards/#{card.number}", mention_payloads.last.dig("options", "data", "path")
+  end
+
+  test "pushes again when existing card notification is updated with a new event" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.card.board.access_for(@kevin).update!(involvement: :watching)
+    assert_not notification.read?
+
+    captured_messages = []
+    WebPush.stubs(:payload_send).with do |kwargs|
+      captured_messages << kwargs
+      true
+    end.returns(true)
+
+    perform_enqueued_jobs do
+      notification.card.close(user: @david)
+    end
+
+    assert_equal 2, captured_messages.size
+    payload = JSON.parse(captured_messages.first[:message])
+    assert_equal notification.card.title, payload["title"]
+    assert_equal "Moved to Done by #{@david.name}", payload.dig("options", "body")
+  end
+
+  test "does not push when marking notification as read or unread" do
+    notification = notifications(:logo_assignment_kevin)
+
+    WebPush.expects(:payload_send).never
+
+    perform_enqueued_jobs do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "skips push delivery if notification was read before job ran" do
+    notifications(:layout_commented_kevin).destroy!
+    notification = Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    notification.read
+
+    WebPush.expects(:payload_send).never
+    perform_enqueued_jobs
+  end
+
+  test "does not enqueue push jobs when VAPID keys are not configured" do
+    notifications(:layout_commented_kevin).destroy!
+
+    old_public = ENV["VAPID_PUBLIC_KEY"]
+    ENV["VAPID_PUBLIC_KEY"] = ""
+
+    assert_no_enqueued_jobs only: Push::Subscription::DeliverJob do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    end
+  ensure
+    ENV["VAPID_PUBLIC_KEY"] = old_public
+  end
+
+  private
+    def create_push_subscription_for(user, endpoint:)
+      ec = OpenSSL::PKey::EC.generate("prime256v1")
+      user.push_subscriptions.create!(
+        endpoint: endpoint,
+        p256dh_key: Base64.urlsafe_encode64(ec.public_key.to_bn.to_s(2), padding: false),
+        auth_key: Base64.urlsafe_encode64(Random.bytes(16), padding: false)
+      )
+    end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..f2ad143
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @client_ec = OpenSSL::PKey::EC.generate("prime256v1")
+    @p256dh_key = Base64.urlsafe_encode64(@client_ec.public_key.to_bn.to_s(2), padding: false)
+    @auth_key = Base64.urlsafe_encode64(Random.bytes(16), padding: false)
+  end
+
+  test "validates presence and https endpoint" do
+    subscription = @user.push_subscriptions.new(
+      endpoint: "https://fcm.googleapis.com/fcm/send/device-123",
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+    assert subscription.valid?
+    assert_equal @user.account, subscription.account
+
+    http_subscription = @user.push_subscriptions.new(
+      endpoint: "http://fcm.googleapis.com/fcm/send/device-123",
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+    assert_not http_subscription.valid?
+
+    loopback_subscription = @user.push_subscriptions.new(
+      endpoint: "https://127.0.0.1/push",
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+    assert_not loopback_subscription.valid?
+  end
+
+  test "normalizes standard base64 keys to urlsafe base64" do
+    standard_p256dh = Base64.strict_encode64(@client_ec.public_key.to_bn.to_s(2))
+    standard_auth = Base64.strict_encode64(Random.bytes(16))
+
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/std-b64",
+      p256dh_key: standard_p256dh,
+      auth_key: standard_auth
+    )
+
+    stub_request(:post, subscription.endpoint).to_return(status: 201)
+
+    assert_nothing_raised do
+      subscription.deliver(notifications(:logo_assignment_kevin))
+    end
+  end
+
+  test "deliver destroys expired, invalid, and unauthorized subscriptions" do
+    [ 410, 404, 401 ].each_with_index do |status, index|
+      subscription = @user.push_subscriptions.create!(
+        endpoint: "https://fcm.googleapis.com/fcm/send/stale-#{index}",
+        p256dh_key: @p256dh_key,
+        auth_key: @auth_key
+      )
+
+      stub_request(:post, subscription.endpoint).to_return(status: status, body: "stale")
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        subscription.deliver(notifications(:logo_assignment_kevin))
+      end
+    end
+  end
+
+  test "deliver raises transient errors for job retry" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/transient",
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+
+    stub_request(:post, subscription.endpoint).to_return(status: 429, body: "rate limited")
+
+    assert_no_difference -> { Push::Subscription.count } do
+      assert_raises WebPush::TooManyRequests do
+        subscription.deliver(notifications(:logo_assignment_kevin))
+      end
+    end
+  end
+end
