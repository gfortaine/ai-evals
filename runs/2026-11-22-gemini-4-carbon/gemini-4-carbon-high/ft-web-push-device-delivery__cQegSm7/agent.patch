index 0000000..06f9a0b
--- /dev/null
+++ b/app/models/push.rb
@@ -0,0 +1,35 @@
+module Push
+  class << self
+    def table_name_prefix
+      "push_"
+    end
+
+    def configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_identification
+      {
+        subject: vapid_subject,
+        public_key: vapid_public_key,
+        private_key: vapid_private_key
+      }
+    end
+
+    def vapid_public_key
+      ENV.fetch("VAPID_PUBLIC_KEY") { Rails.configuration.x.vapid.public_key || Rails.application.credentials.dig(:vapid, :public_key) }.presence
+    end
+
+    def vapid_private_key
+      ENV.fetch("VAPID_PRIVATE_KEY") { Rails.configuration.x.vapid.private_key || Rails.application.credentials.dig(:vapid, :private_key) }.presence
+    end
+
+    private
+      def vapid_subject
+        address = Mail::Address.new(ApplicationMailer.default[:from]).address
+        "mailto:#{address}"
+      rescue Mail::Field::ParseError
+        "mailto:support@fizzy.do"
+      end
+  end
+end
diff --git a/app/models/push/notification.rb b/app/models/push/notification.rb
new file mode 100644
index 0000000..1952265
--- /dev/null
+++ b/app/models/push/notification.rb
@@ -0,0 +1,37 @@
+class Push::Notification
+  attr_reader :title, :body, :path, :subscription
+
+  def initialize(title:, body:, path:, subscription:)
+    @title = title
+    @body = body
+    @path = path
+    @subscription = subscription
+  end
+
+  def deliver
+    WebPush.payload_send(
+      message: encoded_message,
+      endpoint: subscription.endpoint,
+      p256dh: subscription.p256dh_key,
+      auth: subscription.auth_key,
+      vapid: Push.vapid_identification,
+      urgency: "high"
+    )
+  end
+
+  def message
+    {
+      title: title,
+      options: {
+        body: body,
+        icon: "/app-icon-192.png",
+        data: { path: path }
+      }
+    }
+  end
+
+  private
+    def encoded_message
+      JSON.generate(message)
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..b605690
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,51 @@
+class Push::Subscription < ApplicationRecord
+  PERMITTED_ENDPOINT_SCHEMES = %w[ https ].freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  normalizes :endpoint, with: -> { it.strip }
+  normalizes :p256dh_key, :auth_key, with: -> { it.strip.tr("+/", "-_") }
+  normalizes :user_agent, with: -> { it.truncate(4096, omission: "") }
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :validate_endpoint_url
+
+  def deliver(notification_record)
+    return unless Push.configured?
+
+    notification(
+      title: notification_record.notification_title,
+      body: notification_record.notification_body,
+      path: notification_record.card_path
+    ).deliver
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized
+    destroy
+  rescue OpenSSL::Cipher::CipherError, OpenSSL::PKey::ECError, ArgumentError
+    destroy
+  end
+
+  def notification(**params)
+    Push::Notification.new(**params, subscription: self)
+  end
+
+  private
+    def validate_endpoint_url
+      if endpoint.present?
+        uri = URI.parse(endpoint)
+
+        if PERMITTED_ENDPOINT_SCHEMES.exclude?(uri.scheme) || uri.host.blank? || blocked_ip_literal?(uri.host)
+          errors.add(:endpoint, "is invalid")
+        end
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "is invalid")
+    end
+
+    def blocked_ip_literal?(host)
+      ip = IPAddr.new(host.delete_prefix("[").delete_suffix("]"))
+      SsrfProtection.blocked_address?(ip)
+    rescue IPAddr::InvalidAddressError
+      false
+    end
+end
