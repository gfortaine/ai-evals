diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..698cc9f
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,225 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static targets = [ "toggle", "explainer", "details" ]
+  static values = {
+    subscriptionsUrl: String,
+    vapidPublicKey: String,
+    subscribedEndpoints: { type: Array, default: [] }
+  }
+
+  async connect() {
+    await this.#syncState()
+    this.#watchPermissions()
+  }
+
+  disconnect() {
+    if (this.permissionStatus) {
+      this.permissionStatus.onchange = null
+    }
+  }
+
+  async toggle() {
+    if (this.toggleTarget.checked) {
+      await this.#subscribe()
+    } else {
+      await this.#unsubscribe()
+    }
+  }
+
+  async #syncState() {
+    if (!this.#pushSupported) {
+      if (this.hasToggleTarget) this.toggleTarget.disabled = true
+      this.#setSubscribedState(false)
+      this.#showInstallHelp()
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#setSubscribedState(false)
+      this.#showBlockedHelp()
+      return
+    }
+
+    this.#hideHelp()
+
+    if (Notification.permission === "granted") {
+      const registration = await navigator.serviceWorker.getRegistration("/")
+      const subscription = await registration?.pushManager?.getSubscription()
+      const isSubscribed = Boolean(subscription && this.subscribedEndpointsValue.includes(subscription.endpoint))
+      this.#setSubscribedState(isSubscribed)
+    } else {
+      this.#setSubscribedState(false)
+    }
+  }
+
+  async #subscribe() {
+    this.toggleTarget.disabled = true
+
+    try {
+      const permission = Notification.permission === "default"
+        ? await Notification.requestPermission()
+        : Notification.permission
+
+      if (permission !== "granted") {
+        this.#setSubscribedState(false)
+        if (permission === "denied") {
+          this.#showBlockedHelp()
+        }
+        return
+      }
+
+      this.#hideHelp()
+
+      const registration = await this.#ensureServiceWorkerRegistration()
+      let subscription = await registration.pushManager.getSubscription()
+
+      if (subscription && !this.#matchingServerKey(subscription)) {
+        await subscription.unsubscribe()
+        subscription = null
+      }
+
+      subscription ||= await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#vapidPublicKeyBytes
+      })
+
+      const response = await post(this.subscriptionsUrlValue, {
+        body: this.#extractSubscriptionPayload(subscription),
+        responseKind: "json"
+      })
+
+      if (response.ok) {
+        this.#rememberEndpoint(subscription.endpoint)
+        this.#setSubscribedState(true)
+      } else {
+        this.#setSubscribedState(false)
+      }
+    } catch (error) {
+      this.#setSubscribedState(false)
+      if (Notification.permission === "denied" || error?.name === "NotAllowedError") {
+        this.#showBlockedHelp()
+      }
+    } finally {
+      this.toggleTarget.disabled = false
+    }
+  }
+
+  async #unsubscribe() {
+    this.toggleTarget.disabled = true
+
+    try {
+      const registration = await navigator.serviceWorker.getRegistration("/")
+      const subscription = await registration?.pushManager?.getSubscription()
+
+      if (subscription) {
+        await destroy(this.subscriptionsUrlValue, {
+          body: { push_subscription: { endpoint: subscription.endpoint } },
+          responseKind: "json"
+        })
+        this.#forgetEndpoint(subscription.endpoint)
+        await subscription.unsubscribe()
+      }
+
+      this.#setSubscribedState(false)
+    } finally {
+      this.toggleTarget.disabled = false
+    }
+  }
+
+  async #ensureServiceWorkerRegistration() {
+    const existing = await navigator.serviceWorker.getRegistration("/")
+    if (existing?.active) return existing
+
+    await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    return navigator.serviceWorker.ready
+  }
+
+  async #watchPermissions() {
+    if (!navigator.permissions?.query) return
+
+    try {
+      this.permissionStatus = await navigator.permissions.query({ name: "notifications" })
+      this.permissionStatus.onchange = () => this.#syncState()
+    } catch {
+      // Ignore browsers that don't support querying "notifications" permission
+    }
+  }
+
+  #matchingServerKey(subscription) {
+    const existingKey = subscription.options?.applicationServerKey
+    if (!existingKey) return true
+
+    const existingBytes = new Uint8Array(existingKey)
+    const expectedBytes = this.#vapidPublicKeyBytes
+    return existingBytes.length === expectedBytes.length &&
+      existingBytes.every((byte, index) => byte === expectedBytes[index])
+  }
+
+  #setSubscribedState(subscribed) {
+    this.element.classList.toggle("notifications--on", subscribed)
+    if (this.hasToggleTarget) {
+      this.toggleTarget.checked = subscribed
+    }
+  }
+
+  #showBlockedHelp() {
+    if (this.hasExplainerTarget) this.explainerTarget.hidden = false
+    this.detailsTargets.forEach((element) => { element.hidden = false })
+  }
+
+  #showInstallHelp() {
+    if (this.hasExplainerTarget) this.explainerTarget.hidden = false
+    this.detailsTargets.forEach((element) => { element.hidden = true })
+  }
+
+  #hideHelp() {
+    if (this.hasExplainerTarget) this.explainerTarget.hidden = true
+  }
+
+  #rememberEndpoint(endpoint) {
+    if (!this.subscribedEndpointsValue.includes(endpoint)) {
+      this.subscribedEndpointsValue = [ ...this.subscribedEndpointsValue, endpoint ]
+    }
+  }
+
+  #forgetEndpoint(endpoint) {
+    this.subscribedEndpointsValue = this.subscribedEndpointsValue.filter((item) => item !== endpoint)
+  }
+
+  #extractSubscriptionPayload(subscription) {
+    const json = typeof subscription.toJSON === "function" ? subscription.toJSON() : subscription
+    const p256dhKey = json.keys?.p256dh || this.#encodeKey(subscription.getKey?.("p256dh"))
+    const authKey = json.keys?.auth || this.#encodeKey(subscription.getKey?.("auth"))
+
+    return {
+      push_subscription: {
+        endpoint: subscription.endpoint || json.endpoint,
+        p256dh_key: p256dhKey,
+        auth_key: authKey
+      }
+    }
+  }
+
+  #encodeKey(buffer) {
+    if (!buffer) return null
+    const bytes = new Uint8Array(buffer)
+    let binary = ""
+    bytes.forEach((byte) => { binary += String.fromCharCode(byte) })
+    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+  }
+
+  get #pushSupported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #vapidPublicKeyBytes() {
+    const key = (this.vapidPublicKeyValue || getMetaContent("vapid-public-key") || "").trim().replace(/=+$/, "")
+    const padding = "=".repeat((4 - (key.length % 4)) % 4)
+    const base64 = (key + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = atob(base64)
+    return Uint8Array.from(rawData, (char) => char.charCodeAt(0))
+  }
+}
diff --git a/app/jobs/push/subscription/deliver_job.rb b/app/jobs/push/subscription/deliver_job.rb
