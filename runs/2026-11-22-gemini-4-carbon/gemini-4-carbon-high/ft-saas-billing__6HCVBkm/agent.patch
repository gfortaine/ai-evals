+class Admin::AccountsController < AdminController
+  include Admin::AccountScoped
+
+  skip_before_action :set_account, only: :index
+
+  layout "public"
+
+  def index
+    @accounts = Account.order(created_at: :desc).preload(:subscription, :billing_waiver, :overridden_limits, users: :identity)
+    if params[:q].present?
+      term = params[:q].strip
+      like_query = "%#{Account.sanitize_sql_like(term)}%"
+      if term.match?(/\A\d+\z/)
+        @accounts = @accounts.where("accounts.name LIKE ? OR accounts.external_account_id = ?", like_query, term.to_i)
+      else
+        @accounts = @accounts.where("accounts.name LIKE ?", like_query)
+      end
+    end
+  end
+
+  def show
+  end
+end
