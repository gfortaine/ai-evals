diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..4bd148f
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,119 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  def plan
+    Plan.find(plan_key) || Plan.free
+  end
+
+  def active?
+    ACTIVE_STATUSES.include?(status)
+  end
+
+  def canceled?
+    status == "canceled"
+  end
+
+  def past_due?
+    status == "past_due"
+  end
+
+  def paused?
+    status == "paused"
+  end
+
+  def to_be_canceled?
+    active? && cancel_at.present?
+  end
+
+  def pause
+    if stripe_subscription_id.present? && active?
+      ::Stripe::Subscription.update(stripe_subscription_id, pause_collection: { behavior: "void" })
+    end
+  rescue ::Stripe::InvalidRequestError => error
+    raise unless error.http_status == 404
+  end
+
+  def resume
+    if stripe_subscription_id.present?
+      ::Stripe::Subscription.update(stripe_subscription_id, pause_collection: "")
+    end
+  rescue ::Stripe::InvalidRequestError => error
+    raise unless error.http_status == 404
+  end
+
+  def cancel
+    if stripe_subscription_id.present? && !canceled?
+      ::Stripe::Subscription.cancel(stripe_subscription_id)
+    end
+  rescue ::Stripe::InvalidRequestError => error
+    raise unless error.http_status == 404
+  end
+
+  def sync_from_stripe(stripe_subscription)
+    item = extract_first_item(stripe_subscription)
+    price = extract_price(stripe_subscription, item)
+    matched_plan = extract_plan(stripe_subscription, price)
+    period_end = extract_period_end(stripe_subscription, item)
+    new_status = fetch_field(stripe_subscription, :status)
+    new_cancel_at = extract_cancel_at(stripe_subscription, period_end)
+
+    update!(
+      stripe_subscription_id: fetch_field(stripe_subscription, :id),
+      status: new_status,
+      plan_key: matched_plan&.key || plan_key,
+      current_period_end: period_end ? Time.at(period_end).utc : nil,
+      cancel_at: new_cancel_at ? Time.at(new_cancel_at).utc : nil,
+      next_amount_due_in_cents: extract_next_amount_due(new_status, new_cancel_at, price, matched_plan)
+    )
+  end
+
+  private
+    def fetch_field(object, key)
+      return nil if object.nil?
+
+      object[key] || object[key.to_s]
+    end
+
+    def extract_first_item(stripe_subscription)
+      items = fetch_field(stripe_subscription, :items)
+      data = fetch_field(items, :data)
+      data&.first
+    end
+
+    def extract_price(stripe_subscription, item)
+      fetch_field(item, :price) || fetch_field(stripe_subscription, :plan)
+    end
+
+    def extract_plan(stripe_subscription, price)
+      price_id = price.is_a?(String) ? price : fetch_field(price, :id)
+      metadata = fetch_field(stripe_subscription, :metadata)
+
+      Plan.find_by_price_id(price_id) || Plan.find(fetch_field(metadata, :plan_key))
+    end
+
+    def extract_period_end(stripe_subscription, item)
+      fetch_field(stripe_subscription, :current_period_end) || fetch_field(item, :current_period_end)
+    end
+
+    def extract_cancel_at(stripe_subscription, period_end)
+      if cancel_at_timestamp = fetch_field(stripe_subscription, :cancel_at)
+        cancel_at_timestamp
+      elsif fetch_field(stripe_subscription, :cancel_at_period_end) && period_end
+        period_end
+      end
+    end
+
+    def extract_next_amount_due(new_status, new_cancel_at, price, matched_plan)
+      if new_status == "canceled" || new_cancel_at.present?
+        0
+      else
+        unit_amount = price.is_a?(String) ? nil : (fetch_field(price, :unit_amount) || fetch_field(price, :amount))
+        unit_amount || matched_plan&.price_in_cents
+      end
+    end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..78f1601
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,113 @@
+class Plan
+  PLANS = {
+    free_v1: {
+      name: "Free",
+      price: 0,
+      card_limit: 1_000,
+      storage_limit: 1.gigabyte,
+      stripe_price_env: nil
+    },
+    monthly_v1: {
+      name: "Unlimited",
+      price: 20,
+      card_limit: Float::INFINITY,
+      storage_limit: 5.gigabytes,
+      stripe_price_env: "STRIPE_MONTHLY_V1_PRICE_ID"
+    },
+    monthly_extra_storage_v1: {
+      name: "Unlimited+",
+      price: 25,
+      card_limit: Float::INFINITY,
+      storage_limit: 500.gigabytes,
+      stripe_price_env: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+    }
+  }.freeze
+
+  ALIASES = {
+    "free" => :free_v1,
+    "unlimited" => :monthly_v1,
+    "unlimited+" => :monthly_extra_storage_v1,
+    "unlimited_plus" => :monthly_extra_storage_v1
+  }.freeze
+
+  attr_reader :key, :name, :price, :card_limit, :storage_limit
+
+  class << self
+    def all
+      @all ||= PLANS.map { |key, attributes| new(key: key, **attributes) }.freeze
+    end
+
+    def paid_plans
+      all.select(&:paid?)
+    end
+
+    def free
+      find(:free_v1)
+    end
+
+    def paid
+      find(:monthly_v1)
+    end
+
+    def unlimited
+      find(:monthly_v1)
+    end
+
+    def unlimited_plus
+      find(:monthly_extra_storage_v1)
+    end
+
+    def find(key)
+      return nil if key.blank?
+
+      normalized = ALIASES.fetch(key.to_s.downcase, key.to_sym)
+      all.find { |plan| plan.key == normalized.to_s }
+    end
+    alias_method :[], :find
+
+    def find_by_price_id(price_id)
+      return nil if price_id.blank?
+
+      all.find { |plan| plan.stripe_price_id == price_id }
+    end
+  end
+
+  def initialize(key:, name:, price:, card_limit:, storage_limit:, stripe_price_env: nil)
+    @key = key.to_s
+    @name = name
+    @price = price
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @stripe_price_env = stripe_price_env
+  end
+
+  def stripe_price_id
+    if @stripe_price_env
+      ENV.fetch(@stripe_price_env) { "price_#{key}" if Rails.env.local? }
+    end
+  end
+
+  def price_in_cents
+    price * 100
+  end
+
+  def free?
+    price.zero?
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited_cards?
+    card_limit.infinite?
+  end
+
+  def to_param
+    key
+  end
+
+  def ==(other)
+    other.is_a?(Plan) && key == other.key
+  end
+end
diff --git a/saas/app/views/account/settings/_subscription.html.erb b/saas/app/views/account/settings/_subscription.html.erb
