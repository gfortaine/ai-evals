+++ b/saas/test/integration/billing_and_admin_flow_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+require "capybara/rails"
+require "capybara/minitest"
+
+class BillingAndAdminFlowTest < ActionDispatch::IntegrationTest
+  include Capybara::DSL
+  include Capybara::Minitest::Assertions
+
+  setup do
+    Capybara.current_driver = :rack_test
+  end
+
+  teardown do
+    Capybara.reset_sessions!
+    Capybara.use_default_driver
+  end
+
+  test "support admin flow: list accounts, open account page, Comp/Uncomp, Override, and Reset" do
+    account = accounts(:initech)
+    capybara_sign_in_as(identities(:david))
+
+    visit "/admin/accounts"
+    assert_link account.name
+    click_link account.name
+
+    assert_current_path saas.admin_account_path(account, script_name: nil)
+    assert_button "Comp"
+    click_button "Comp"
+    assert account.reload.comped?
+
+    assert_button "Uncomp"
+    click_button "Uncomp"
+    assert_not account.reload.comped?
+
+    fill_in "Card count", with: "950"
+    fill_in "Bytes used", with: "500000000"
+    click_button "Override"
+
+    account.reload
+    assert_equal 950, account.card_count
+    assert_equal 500_000_000, account.bytes_used
+
+    fill_in "Card count", with: "1000"
+    click_button "Override"
+    assert_equal 1_000, account.reload.card_count
+
+    click_button "Reset"
+    account.reload
+    assert_nil account.overridden_limits
+    assert_equal account.cards.published.count, account.card_count
+  end
+
+  test "customer flow: warning countdown, out-of-cards Upgrade pitch, and choosing Unlimited or Unlimited+ in settings" do
+    account = accounts(:initech)
+    draft = cards(:unfinished_thoughts)
+    capybara_sign_in_as(identities(:mike))
+
+    account.override_limits(card_count: 950)
+    visit card_draft_path(draft, script_name: account.slug)
+    assert_text "50 cards left"
+    assert_button "Create card"
+
+    account.override_limits(card_count: 1_000)
+    visit card_draft_path(draft, script_name: account.slug)
+    assert_no_button "Create card"
+    assert_link "Upgrade"
+    click_link "Upgrade"
+
+    assert_current_path account_settings_path(script_name: account.slug)
+    assert_text "Free"
+    choose "Unlimited"
+    choose "Unlimited+"
+
+    Stripe::Customer.expects(:create).once.returns(stub(id: "cus_capybara"))
+    Stripe::Checkout::Session.expects(:create).with(
+      has_entries(
+        customer: "cus_capybara",
+        line_items: [ { price: Plan.unlimited_plus.stripe_price_id, quantity: 1 } ]
+      )
+    ).returns(stub(url: "http://www.example.com#{account_settings_path(script_name: account.slug)}"))
+
+    click_button "Upgrade"
+    assert_equal "cus_capybara", account.reload.subscription.stripe_customer_id
+  end
+
+  private
+    def capybara_sign_in_as(identity)
+      page.driver.put session_transfer_path(identity.transfer_id, script_name: nil)
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..2a57770
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "defaults to Free plan" do
+    assert_equal Plan.free, @account.plan
+    assert @account.free?
+    assert_not @account.paid?
+    assert_not @account.subscribed?
+    assert_nil @account.active_subscription
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_equal 1_000, @account.card_limit
+  end
+
+  test "paid plan brings its own storage allowance and unlimited cards" do
+    subscription = @account.create_subscription!(
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    assert_equal Plan.unlimited, @account.plan
+    assert @account.paid?
+    assert @account.subscribed?
+    assert_equal subscription, @account.active_subscription
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_equal Float::INFINITY, @account.card_limit
+
+    subscription.update!(plan_key: "monthly_extra_storage_v1")
+    assert_equal Plan.unlimited_plus, @account.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "canceled subscription falls back to Free plan" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      plan_key: "monthly_v1",
+      status: "canceled"
+    )
+
+    assert_equal Plan.free, @account.plan
+    assert @account.free?
+    assert_not @account.subscribed?
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comp and uncomp toggle billing waiver" do
+    assert_not @account.comped?
+
+    @account.comp
+    assert @account.comped?
+    assert @account.paid?
+    assert_not @account.free?
+    assert_equal Float::INFINITY, @account.card_limit
+    assert_operator @account.storage_limit, :>, 1.gigabyte
+
+    # Idempotent
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp
+    end
+
+    @account.uncomp
+    assert_not @account.comped?
+    assert @account.free?
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "find_or_create_stripe_subscription creates customer once and reuses it" do
+    Stripe::Customer.expects(:create).once.returns(stub(id: "cus_created"))
+
+    first = @account.find_or_create_stripe_subscription(email: "mike@37signals.com")
+    second = @account.find_or_create_stripe_subscription(email: "mike@37signals.com")
+
+    assert_equal "cus_created", first.stripe_customer_id
+    assert_equal first, second
+  end
+
+  test "cancelling, reactivating, and incinerating an account manages stripe subscription" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_cancel_test",
+      stripe_subscription_id: "sub_cancel_test",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    Stripe::Subscription.expects(:update).with("sub_cancel_test", pause_collection: { behavior: "void" }).once
+    @account.cancel(initiated_by: users(:mike))
+
+    Stripe::Subscription.expects(:update).with("sub_cancel_test", pause_collection: "").once
+    @account.reactivate
+
+    Stripe::Subscription.expects(:update).with("sub_cancel_test", pause_collection: { behavior: "void" }).once
+    @account.cancel(initiated_by: users(:mike))
+
+    Stripe::Subscription.expects(:cancel).with("sub_cancel_test").once
+    @account.incinerate
+    assert_not Account::Subscription.exists?(stripe_customer_id: "cus_cancel_test")
+  end
+end
diff --git a/saas/test/models/account/card_limited_test.rb b/saas/test/models/account/card_limited_test.rb
new file mode 100644
index 0000000..43f842f
--- /dev/null
+++ b/saas/test/models/account/card_limited_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Account::CardLimitedTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "card_count counts published cards and ignores drafts" do
+    published_count = @account.cards.published.count
+    assert_equal 2, published_count
+    assert_equal 1, @account.cards.drafted.count
+    assert_equal published_count, @account.card_count
+  end
+
+  test "exceeding and nearing card limit on free plan" do
+    @account.override_limits(card_count: 899)
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+    assert_equal 101, @account.cards_remaining
+
+    @account.override_limits(card_count: 900)
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+    assert_equal 100, @account.cards_remaining
+
+    @account.override_limits(card_count: 950)
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+
+    @account.override_limits(card_count: 999)
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+    assert_equal 1, @account.cards_remaining
+
+    @account.override_limits(card_count: 1_000)
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "paid and comped accounts do not exceed or near card limits" do
+    @account.override_limits(card_count: 5_000)
+    assert @account.exceeding_card_limit?
+
+    @account.comp
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+
+    @account.uncomp
+    assert @account.exceeding_card_limit?
+
+    @account.create_subscription!(
+      stripe_customer_id: "cus_paid",
+      stripe_subscription_id: "sub_paid",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "overriding and resetting card_count and bytes_used" do
+    real_cards = @account.cards.published.count
+    real_bytes = @account.bytes_used
+
+    @account.override_limits(card_count: 975, bytes_used: 2.gigabytes)
+    assert_equal 975, @account.card_count
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.exceeding_storage_limit?
+
+    @account.reset_overridden_limits
+    assert_equal real_cards, @account.card_count
+    assert_equal real_bytes, @account.bytes_used
+    assert_not Account::OverriddenLimits.exists?(account: @account)
+  end
+end
diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
new file mode 100644
index 0000000..8873317
--- /dev/null
+++ b/saas/test/models/plan_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "approved pricing plans" do
+    free = Plan.free
+    assert_equal "free_v1", free.key
+    assert_equal "Free", free.name
+    assert_equal 0, free.price
+    assert_equal 1_000, free.card_limit
+    assert_equal 1.gigabyte, free.storage_limit
+    assert free.free?
+    assert_not free.paid?
+    assert_nil free.stripe_price_id
+
+    unlimited = Plan.unlimited
+    assert_equal "monthly_v1", unlimited.key
+    assert_equal "Unlimited", unlimited.name
+    assert_equal 20, unlimited.price
+    assert_equal 2000, unlimited.price_in_cents
+    assert unlimited.unlimited_cards?
+    assert_equal 5.gigabytes, unlimited.storage_limit
+    assert unlimited.paid?
+
+    unlimited_plus = Plan.unlimited_plus
+    assert_equal "monthly_extra_storage_v1", unlimited_plus.key
+    assert_equal "Unlimited+", unlimited_plus.name
+    assert_equal 25, unlimited_plus.price
+    assert_equal 2500, unlimited_plus.price_in_cents
+    assert unlimited_plus.unlimited_cards?
+    assert_equal 500.gigabytes, unlimited_plus.storage_limit
+    assert unlimited_plus.paid?
+  end
+
+  test "find by key and aliases" do
+    assert_equal Plan.free, Plan[:free_v1]
+    assert_equal Plan.free, Plan.find("free")
+    assert_equal Plan.unlimited, Plan[:monthly_v1]
+    assert_equal Plan.unlimited, Plan.find("unlimited")
+    assert_equal Plan.unlimited_plus, Plan[:monthly_extra_storage_v1]
+    assert_equal Plan.unlimited_plus, Plan.find("unlimited+")
+    assert_nil Plan.find("nonexistent")
+    assert_nil Plan.find(nil)
+  end
+
+  test "find_by_price_id uses configured stripe price env vars" do
+    original_v1 = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    original_extra = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_custom_v1"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_custom_extra"
+
+    assert_equal Plan.unlimited, Plan.find_by_price_id("price_custom_v1")
+    assert_equal Plan.unlimited_plus, Plan.find_by_price_id("price_custom_extra")
+    assert_nil Plan.find_by_price_id("price_unknown")
+    assert_nil Plan.find_by_price_id(nil)
+  ensure
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = original_v1
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = original_extra
+  end
+end
