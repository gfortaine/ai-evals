@@ -0,0 +1,48 @@
+class Account::SubscriptionsController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+    if params[:session_id].present?
+      redirect_to main_app.account_settings_path(script_name: Current.account.slug), notice: "Subscription updated"
+    else
+      redirect_to main_app.account_settings_path(script_name: Current.account.slug)
+    end
+  end
+
+  def create
+    plan = selected_plan
+
+    if plan&.paid?
+      subscription = Current.account.find_or_create_stripe_subscription(email: Current.user.identity.email_address)
+      checkout_session = create_checkout_session(subscription, plan)
+
+      redirect_to checkout_session.url, status: :see_other, allow_other_host: true
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  private
+    def selected_plan
+      if params[:plan_key].present?
+        Plan.find(params[:plan_key])
+      else
+        Plan.paid
+      end
+    end
+
+    def create_checkout_session(subscription, plan)
+      ::Stripe::Checkout::Session.create(
+        customer: subscription.stripe_customer_id,
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        success_url: saas.account_subscription_url(script_name: Current.account.slug, session_id: "{CHECKOUT_SESSION_ID}"),
+        cancel_url: main_app.account_settings_url(script_name: Current.account.slug),
+        client_reference_id: Current.account.id,
+        metadata: { account_id: Current.account.id, plan_key: plan.key },
+        subscription_data: {
+          metadata: { account_id: Current.account.id, plan_key: plan.key }
+        }
+      )
+    end
+end
