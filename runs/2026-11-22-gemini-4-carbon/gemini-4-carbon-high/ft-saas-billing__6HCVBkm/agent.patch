--- /dev/null
+++ b/saas/app/models/account/card_limited.rb
@@ -0,0 +1,29 @@
+module Account::CardLimited
+  extend ActiveSupport::Concern
+
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  def card_count
+    overridden_limits&.card_count || cards.published.count
+  end
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def cards_remaining
+    if card_limit.infinite?
+      Float::INFINITY
+    else
+      [ card_limit - card_count, 0 ].max
+    end
+  end
+
+  def exceeding_card_limit?
+    card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    !exceeding_card_limit? && cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+end
