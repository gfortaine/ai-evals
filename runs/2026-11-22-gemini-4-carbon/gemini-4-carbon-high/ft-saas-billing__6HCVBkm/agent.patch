+      status: "active",
+      items: {
+        object: "list",
+        data: [
+          {
+            id: "si_1",
+            object: "subscription_item",
+            current_period_end: period_end,
+            price: { id: Plan.unlimited.stripe_price_id, object: "price", unit_amount: 2000 }
+          }
+        ]
+      }
+    })
+
+    assert_response :ok
+    @subscription.reload
+    assert_equal "sub_unlimited_1", @subscription.stripe_subscription_id
+    assert_equal "active", @subscription.status
+    assert_equal "monthly_v1", @subscription.plan_key
+    assert_equal 2000, @subscription.next_amount_due_in_cents
+    assert_equal Time.at(period_end).utc, @subscription.current_period_end
+    assert_equal Plan.unlimited, @account.reload.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "upgrades subscription to Unlimited+ and cancels back to Free" do
+    post_stripe_event("customer.subscription.updated", {
+      id: "sub_plus_1",
+      object: "subscription",
+      customer: "cus_webhook_123",
+      status: "active",
+      items: {
+        object: "list",
+        data: [
+          {
+            id: "si_2",
+            object: "subscription_item",
+            price: { id: Plan.unlimited_plus.stripe_price_id, object: "price", unit_amount: 2500 }
+          }
+        ]
+      }
+    })
+
+    assert_response :ok
+    assert_equal Plan.unlimited_plus, @account.reload.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    post_stripe_event("customer.subscription.deleted", {
+      id: "sub_plus_1",
+      object: "subscription",
+      customer: "cus_webhook_123",
+      status: "canceled",
+      items: {
+        object: "list",
+        data: [
+          {
+            id: "si_2",
+            object: "subscription_item",
+            price: { id: Plan.unlimited_plus.stripe_price_id, object: "price", unit_amount: 2500 }
+          }
+        ]
+      }
+    })
+
+    assert_response :ok
+    assert_equal "canceled", @subscription.reload.status
+    assert_equal Plan.free, @account.reload.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "handles subscription created with account metadata even without prior local subscription" do
+    acme = accounts(:acme)
+
+    post_stripe_event("customer.subscription.created", {
+      id: "sub_acme_1",
+      object: "subscription",
+      customer: "cus_acme_new",
+      status: "active",
+      metadata: { account_id: acme.id, plan_key: "monthly_v1" },
+      items: {
+        object: "list",
+        data: [
+          {
+            id: "si_acme",
+            object: "subscription_item",
+            price: { id: Plan.unlimited.stripe_price_id, object: "price", unit_amount: 2000 }
+          }
+        ]
+      }
+    })
+
+    assert_response :ok
+    assert_equal Plan.unlimited, acme.reload.plan
+    assert_equal "cus_acme_new", acme.subscription.stripe_customer_id
+  end
+
+  private
+    def post_stripe_event(type, data_object)
+      payload = {
+        id: "evt_#{SecureRandom.hex(8)}",
+        object: "event",
+        type: type,
+        data: { object: data_object }
+      }.to_json
+
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, @secret)
+      header = Stripe::Webhook::Signature.generate_header(timestamp, signature)
+
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: {
+          "CONTENT_TYPE" => "application/json",
+          "Stripe-Signature" => header
+        }
+      end
+    end
+end
diff --git a/saas/test/integration/billing_and_admin_flow_test.rb b/saas/test/integration/billing_and_admin_flow_test.rb
