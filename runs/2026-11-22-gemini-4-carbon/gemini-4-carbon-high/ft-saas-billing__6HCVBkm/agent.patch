+<section id="subscription" class="settings__section">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <% if account.comped? %>
+      <div>
+        You’re on the <strong><%= account.plan.name %></strong> plan (comped) — unlimited cards and <%= number_to_human_size(account.storage_limit) %> storage.
+      </div>
+    <% elsif account.subscribed? %>
+      <div>
+        You’re on the <strong><%= account.plan.name %></strong> plan ($<%= account.plan.price %>/month) — unlimited cards and <%= number_to_human_size(account.storage_limit) %> storage.
+      </div>
+      <div class="txt-small txt-subtle margin-block-start-quarter">
+        Using <%= number_with_delimiter(account.card_count) %> <%= "card".pluralize(account.card_count) %> and <%= number_to_human_size(account.bytes_used) %> of <%= number_to_human_size(account.storage_limit) %>.
+        <% if account.active_subscription.to_be_canceled? %>
+          Cancels on <%= account.active_subscription.cancel_at.strftime("%B %-d, %Y") %>.
+        <% end %>
+      </div>
+    <% else %>
+      <div>
+        You’re on the <strong><%= account.plan.name %></strong> plan — <%= number_with_delimiter(account.card_limit) %> cards, <%= number_to_human_size(account.storage_limit) %>.
+      </div>
+      <div class="txt-small txt-subtle margin-block-start-quarter">
+        Using <%= number_with_delimiter(account.card_count) %> of <%= number_with_delimiter(account.card_limit) %> cards and <%= number_to_human_size(account.bytes_used) %> of <%= number_to_human_size(account.storage_limit) %>.
+      </div>
+    <% end %>
+  </header>
+
+  <% if account.free? %>
+    <%= form_with url: saas.account_subscription_path(script_name: account.slug), method: :post, data: { turbo: false }, class: "flex flex-column gap-half align-start" do |form| %>
+      <% Plan.paid_plans.each_with_index do |plan, index| %>
+        <div class="flex align-center gap-half txt-align-start">
+          <%= radio_button_tag :plan_key, plan.key, index.zero? %>
+          <%= label_tag "plan_key_#{plan.key}", plan.name, class: "font-weight-bold" %>
+          <span>— $<%= plan.price %>/month, <%= number_to_human_size(plan.storage_limit) %></span>
+        </div>
+      <% end %>
+
+      <%= form.button "Upgrade", type: "submit", class: "btn btn--link" %>
+    <% end %>
+  <% elsif account.subscription&.stripe_customer_id.present? %>
+    <%= button_to "Manage billing", saas.account_billing_portal_path(script_name: account.slug), method: :post, class: "btn", form: { data: { turbo: false } } %>
+  <% end %>
+</section>
