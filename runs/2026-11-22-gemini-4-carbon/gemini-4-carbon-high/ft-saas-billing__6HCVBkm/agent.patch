diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..9ac086b
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,91 @@
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  def create
+    event = construct_webhook_event
+    dispatch_webhook_event(event)
+    head :ok
+  rescue JSON::ParserError, ::Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def construct_webhook_event
+      ::Stripe::Webhook.construct_event(
+        request.raw_post,
+        request.headers["Stripe-Signature"].to_s,
+        ENV["STRIPE_WEBHOOK_SECRET"].to_s
+      )
+    end
+
+    def dispatch_webhook_event(event)
+      case event.type
+      when "customer.subscription.created",
+           "customer.subscription.updated",
+           "customer.subscription.deleted",
+           "customer.subscription.paused",
+           "customer.subscription.resumed"
+        sync_subscription(event.data.object)
+      when "checkout.session.completed"
+        complete_checkout_session(event.data.object)
+      end
+    end
+
+    def sync_subscription(stripe_subscription)
+      stripe_subscription_id = stripe_subscription[:id]
+      stripe_customer_id = extract_id(stripe_subscription[:customer])
+      account_id = stripe_subscription[:metadata]&.[](:account_id)
+
+      if subscription = find_or_initialize_subscription(stripe_subscription_id:, stripe_customer_id:, account_id:)
+        subscription.stripe_customer_id = stripe_customer_id if stripe_customer_id.present?
+        subscription.sync_from_stripe(stripe_subscription)
+      end
+    end
+
+    def complete_checkout_session(session)
+      return unless session[:mode].nil? || session[:mode] == "subscription"
+
+      stripe_customer_id = extract_id(session[:customer])
+      raw_subscription = session[:subscription]
+      stripe_subscription_id = extract_id(raw_subscription)
+      account_id = session[:client_reference_id] || session[:metadata]&.[](:account_id)
+
+      if subscription = find_or_initialize_subscription(stripe_subscription_id:, stripe_customer_id:, account_id:)
+        if raw_subscription.present? && !raw_subscription.is_a?(String)
+          subscription.stripe_customer_id = stripe_customer_id if stripe_customer_id.present?
+          subscription.sync_from_stripe(raw_subscription)
+        else
+          plan = Plan.find(session[:metadata]&.[](:plan_key))
+          subscription.update!(
+            stripe_customer_id: stripe_customer_id || subscription.stripe_customer_id,
+            stripe_subscription_id: stripe_subscription_id || subscription.stripe_subscription_id,
+            plan_key: plan&.key || subscription.plan_key || Plan.paid.key,
+            status: subscription.status.presence || "active"
+          )
+        end
+      end
+    end
+
+    def find_or_initialize_subscription(stripe_subscription_id:, stripe_customer_id:, account_id:)
+      subscription = Account::Subscription.find_by(stripe_subscription_id: stripe_subscription_id) if stripe_subscription_id.present?
+      subscription ||= Account::Subscription.find_by(stripe_customer_id: stripe_customer_id) if stripe_customer_id.present?
+
+      if subscription.nil? && account_id.present? && stripe_customer_id.present?
+        if account = Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id)
+          subscription = account.subscription || account.build_subscription(stripe_customer_id: stripe_customer_id)
+        end
+      end
+
+      subscription
+    end
+
+    def extract_id(object_or_id)
+      if object_or_id.is_a?(String)
+        object_or_id
+      else
+        object_or_id&.[](:id)
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..3265d93
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,79 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, :pause_subscription
+    set_callback :reactivate, :after, :resume_subscription
+    set_callback :incinerate, :before, :cancel_subscription
+  end
+
+  def plan
+    if comped?
+      active_subscription&.plan || billing_waiver.plan
+    elsif active_subscription
+      active_subscription.plan
+    else
+      Plan.free
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def subscribed?
+    active_subscription.present?
+  end
+
+  def free?
+    plan.free? && !comped?
+  end
+
+  def paid?
+    !free?
+  end
+
+  def comped?
+    billing_waiver.present? && !billing_waiver.destroyed?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    if billing_waiver
+      billing_waiver.destroy!
+      association(:billing_waiver).reset
+    end
+  end
+
+  def find_or_create_stripe_subscription(email: owner_email)
+    if subscription
+      subscription
+    else
+      customer = ::Stripe::Customer.create(
+        email: email,
+        name: name,
+        metadata: { account_id: id, external_account_id: external_account_id }
+      )
+      create_subscription!(stripe_customer_id: customer.id)
+    end
+  end
+
+  private
+    def pause_subscription
+      subscription&.pause
+    end
+
+    def resume_subscription
+      subscription&.resume
+    end
+
+    def cancel_subscription
+      subscription&.cancel
+    end
+end
