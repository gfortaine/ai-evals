+class Admin::Accounts::OverriddenLimitsController < AdminController
+  include Admin::AccountScoped
+
+  def create
+    @account.override_limits(**overridden_limits_params)
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+  rescue ActiveRecord::RecordInvalid
+    render "admin/accounts/show", status: :unprocessable_entity
+  end
+  alias_method :update, :create
+
+  def destroy
+    @account.reset_overridden_limits
+    redirect_to saas.admin_account_path(@account), notice: "Limits reset"
+  end
+
+  private
+    def overridden_limits_params
+      source = params[:overridden_limits] || params[:account_overridden_limits] || params
+      source.permit(:card_count, :bytes_used).to_h.to_h do |key, value|
+        [ key.to_sym, value.presence&.to_i ]
+      end
+    end
+end
