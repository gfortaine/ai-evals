diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..f414a15
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "admins see their Free plan and Upgrade in settings" do
+    sign_in_as :kevin
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "#subscription" do
+      assert_select "strong", text: "Free"
+      assert_select "button", text: "Upgrade"
+      assert_select "input[name='plan_key'][value='monthly_v1']"
+      assert_select "input[name='plan_key'][value='monthly_extra_storage_v1']"
+    end
+  end
+
+  test "admins on paid plan see their plan and Manage billing in settings" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_37s",
+      stripe_subscription_id: "sub_37s",
+      plan_key: "monthly_extra_storage_v1",
+      status: "active"
+    )
+
+    sign_in_as :kevin
+    get account_settings_path
+
+    assert_response :success
+    assert_select "#subscription" do
+      assert_select "strong", text: "Unlimited+"
+      assert_select "button", text: "Manage billing"
+    end
+  end
+
+  test "non-admins do not see billing section in settings" do
+    sign_in_as :david
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "#subscription", count: 0
+  end
+
+  test "admin creates Stripe Checkout session for Unlimited plan" do
+    sign_in_as :kevin
+
+    Stripe::Customer.expects(:create).once.returns(stub(id: "cus_new_123"))
+    Stripe::Checkout::Session.expects(:create).with(
+      has_entries(
+        customer: "cus_new_123",
+        mode: "subscription",
+        line_items: [ { price: Plan.unlimited.stripe_price_id, quantity: 1 } ],
+        client_reference_id: @account.id
+      )
+    ).returns(stub(url: "https://checkout.stripe.com/c/pay/cs_test_123"))
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "monthly_v1" }
+
+    assert_response :see_other
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_123"
+    assert_equal "cus_new_123", @account.reload.subscription.stripe_customer_id
+  end
+
+  test "admin creates Stripe Checkout session for Unlimited+ plan reusing existing customer" do
+    @account.create_subscription!(stripe_customer_id: "cus_existing_456")
+    sign_in_as :kevin
+
+    Stripe::Customer.expects(:create).never
+    Stripe::Checkout::Session.expects(:create).with(
+      has_entries(
+        customer: "cus_existing_456",
+        mode: "subscription",
+        line_items: [ { price: Plan.unlimited_plus.stripe_price_id, quantity: 1 } ]
+      )
+    ).returns(stub(url: "https://checkout.stripe.com/c/pay/cs_test_plus"))
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "monthly_extra_storage_v1" }
+
+    assert_response :see_other
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_plus"
+  end
+
+  test "non-admin cannot create checkout session" do
+    sign_in_as :david
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "monthly_v1" }
+
+    assert_response :forbidden
+  end
+
+  test "admin opens Stripe Customer Portal" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_portal_123",
+      stripe_subscription_id: "sub_portal_123",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+    sign_in_as :kevin
+
+    Stripe::BillingPortal::Session.expects(:create).with(
+      has_entries(customer: "cus_portal_123")
+    ).returns(stub(url: "https://billing.stripe.com/p/session/bps_test_123"))
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_response :see_other
+    assert_redirected_to "https://billing.stripe.com/p/session/bps_test_123"
+  end
+
+  test "non-admin cannot open customer portal" do
+    sign_in_as :david
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..a037071
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "requires staff access" do
+    untenanted do
+      get "/admin/accounts"
+      assert_redirected_to new_session_path
+    end
+
+    sign_in_as :jz
+    untenanted do
+      get "/admin/accounts"
+      assert_response :forbidden
+    end
+  end
+
+  test "lists accounts with each name linking to its page" do
+    sign_in_as :david
+
+    untenanted do
+      get "/admin/accounts"
+      assert_response :success
+
+      Account.find_each do |account|
+        assert_select "a[href=?]", saas.admin_account_path(account), text: account.name
+      end
+    end
+  end
+
+  test "account page supports Comp and Uncomp" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "button", text: "Comp"
+      assert_select "button", text: "Uncomp", count: 0
+
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert @account.reload.comped?
+
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "button", text: "Uncomp"
+      assert_select "button", text: "Comp", count: 0
+
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_not @account.reload.comped?
+    end
+  end
+
+  test "account page has override form with Card count and Bytes used, Override, and Reset" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "button", text: "Override"
+      assert_select "button", text: "Reset"
+
+      post saas.admin_account_overridden_limits_path(@account), params: {
+        overridden_limits: { card_count: 950, bytes_used: 536_870_912 }
+      }
+      assert_redirected_to saas.admin_account_path(@account)
+      @account.reload
+      assert_equal 950, @account.card_count
+      assert_equal 536_870_912, @account.bytes_used
+
+      patch saas.admin_account_overridden_limits_path(@account), params: {
+        overridden_limits: { card_count: 1_000, bytes_used: 2_147_483_648 }
+      }
+      assert_redirected_to saas.admin_account_path(@account)
+      @account.reload
+      assert_equal 1_000, @account.card_count
+      assert_equal 2_147_483_648, @account.bytes_used
+
+      delete saas.admin_account_overridden_limits_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      @account.reload
+      assert_nil @account.overridden_limits
+      assert_equal @account.cards.published.count, @account.card_count
+      assert_equal 0, @account.bytes_used
+    end
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..4213f04
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @draft = cards(:unfinished_thoughts)
+    @account.update_column(:cards_count, 100)
+    sign_in_as :mike
+  end
+
+  test "free account out of cards can still draft via HTML" do
+    @account.override_limits(card_count: 1_000)
+    @board.cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count }, 1 do
+      post board_cards_path(@board, script_name: @account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "free account out of cards is refused when creating through JSON API" do
+    @account.override_limits(card_count: 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Blocked API card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "free account out of cards is refused when publishing" do
+    @account.override_limits(card_count: 1_000)
+
+    post card_publish_path(@draft, script_name: @account.slug)
+
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+  end
+
+  test "draft card replaces create buttons with Upgrade pitch when out of cards" do
+    @account.override_limits(card_count: 1_000)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__notch .card-perma__account-limit-message" do
+      assert_select "a", text: "Upgrade"
+    end
+  end
+
+  test "draft card counts down from 100 cards out" do
+    @account.override_limits(card_count: 899)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_no_match(/cards? left/, response.body)
+
+    @account.override_limits(card_count: 900)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_select ".card-perma__notch", text: /100 cards left/
+
+    @account.override_limits(card_count: 950)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_select ".card-perma__notch", text: /50 cards left/
+
+    @account.override_limits(card_count: 999)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_select ".card-perma__notch", text: /1 card left/
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+
+  test "paid account with over 1000 cards can publish and create via API" do
+    @account.override_limits(card_count: 1_500)
+    @account.create_subscription!(
+      stripe_customer_id: "cus_paid",
+      stripe_subscription_id: "sub_paid",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    assert_difference -> { Card.count }, 1 do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Paid API card" } },
+        as: :json
+    end
+    assert_response :created
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+end
