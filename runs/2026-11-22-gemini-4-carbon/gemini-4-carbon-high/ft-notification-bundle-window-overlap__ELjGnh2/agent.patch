+require "test_helper"
+
+class BundleMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :daily, timezone_name: "America/New_York")
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+  end
+
+  test "renders HTML and text digest grouped by board with links" do
+    freeze_time do
+      n1 = Notification.create!(user: @user, source: events(:logo_assignment_km), creator: users(:david))
+      n2 = Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+      bundle = @user.notification_bundles.sole
+
+      email = Current.without_account do
+        BundleMailer.notification(bundle)
+      end
+
+      assert_emails 1 do
+        email.deliver_now
+      end
+
+      assert_equal [ "kevin@37signals.com" ], email.to
+      assert_equal "2 new notifications in #{@user.account.name}", email.subject
+      assert email.html_part.present?
+      assert email.text_part.present?
+
+      html = email.html_part.body.decoded
+      text = email.text_part.body.decoded
+
+      assert_includes html, ERB::Util.html_escape(n1.card.title)
+      assert_includes html, n2.card.title
+      assert_includes html, n1.card.board.name
+      assert_includes html, "#{@user.account.slug}/notifications/settings"
+
+      assert_includes text, n1.card.title
+      assert_includes text, n2.card.title
+      assert_includes text, "#{@user.account.slug}/notifications/settings"
+    end
+  end
+
+  test "renders mention notifications properly" do
+    david = users(:david)
+    david.settings.update!(bundle_email_frequency: :every_few_hours)
+    david.notification_bundles.destroy_all
+
+    mention_notification = notifications(:logo_mentioned_david)
+    bundle = david.notification_bundles.create!(starts_at: 4.hours.ago, ends_at: Time.current)
+    bundle.entries.create!(notification: mention_notification)
+
+    email = BundleMailer.notification(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal "New notification in #{david.account.name}", email.subject
+    assert_includes email.html_part.body.decoded, "@mentioned you"
+    assert_includes email.text_part.body.decoded, "@mentioned you"
+  end
+end
