diff --git a/app/mailers/bundle_mailer.rb b/app/mailers/bundle_mailer.rb
new file mode 100644
index 0000000..f2c98d4
--- /dev/null
+++ b/app/mailers/bundle_mailer.rb
@@ -0,0 +1,27 @@
+class BundleMailer < ApplicationMailer
+  def notification(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.unread.ordered.preloaded
+
+    return if @notifications.none?
+
+    Current.with_account(@bundle.account) do
+      @user.in_time_zone do
+        mail(
+          to: @user.identity.email_address,
+          subject: subject_for(@notifications)
+        )
+      end
+    end
+  end
+
+  private
+    def subject_for(notifications)
+      if notifications.size == 1
+        "New notification in #{@bundle.account.name}"
+      else
+        "#{notifications.size} new notifications in #{@bundle.account.name}"
+      end
+    end
+end
