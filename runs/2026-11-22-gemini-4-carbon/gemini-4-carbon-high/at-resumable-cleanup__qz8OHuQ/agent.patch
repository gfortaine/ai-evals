diff --git a/lib/rails_ext/resque_continuable.rb b/lib/rails_ext/resque_continuable.rb
new file mode 100644
index 0000000..893ba35
--- /dev/null
+++ b/lib/rails_ext/resque_continuable.rb
@@ -0,0 +1,21 @@
+module ResqueContinuable
+  module WorkerTracking
+    def perform(job, &block)
+      previous_worker = Thread.current[:resque_worker]
+      Thread.current[:resque_worker] = self
+      super
+    ensure
+      Thread.current[:resque_worker] = previous_worker
+    end
+  end
+
+  module StoppingAdapter
+    def stopping?
+      super || !!Thread.current[:resque_worker]&.shutdown?
+    end
+  end
+end
+
+Resque::Worker.prepend ResqueContinuable::WorkerTracking
+Resque::Pool.term_behavior ||= "graceful_worker_shutdown_and_wait"
+ActiveJob::QueueAdapters::ResqueAdapter.prepend ResqueContinuable::StoppingAdapter
diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..17136c4
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,263 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  setup do
+    @ordered_leaves = Leaf.order(:id).to_a
+    @expected_titles = [
+      '"Welcome" to The Section',
+      'Chapter 1: "Beginnings"',
+      '"Summary"',
+      '"Reading" & "Writing"'
+    ]
+
+    @ordered_leaves.zip(@expected_titles).each do |leaf, clean_title|
+      leaf.update!(title: %("#{clean_title}"))
+    end
+  end
+
+  test "strips outer quotes once and preserves legitimate inner quotes" do
+    TitleCleanupJob.perform_now
+
+    assert_equal @expected_titles, @ordered_leaves.map { it.reload.title }
+  end
+
+  test "handles empty leaf collection" do
+    Leaf.delete_all
+
+    assert_nothing_raised { TitleCleanupJob.perform_now }
+    assert_nil JobCheckpoint.cursor_for("TitleCleanupJob")
+  end
+
+  test "resumes from where it left off when interrupted via stopping queue adapter" do
+    updated_ids = []
+    track_leaf_updates(updated_ids) do
+      TitleCleanupJob.perform_later
+
+      queue_adapter.with(stopping: -> { updated_ids.size >= 2 }) do
+        perform_enqueued_jobs
+      end
+
+      assert_equal @expected_titles.first(2), @ordered_leaves.first(2).map { it.reload.title }
+      assert_equal @expected_titles.last(2).map { %("#{it}") }, @ordered_leaves.last(2).map { it.reload.title }
+      assert_enqueued_jobs 1, only: TitleCleanupJob
+
+      perform_enqueued_jobs
+    end
+
+    assert_no_enqueued_jobs only: TitleCleanupJob
+    assert_equal @ordered_leaves.map(&:id), updated_ids
+    assert_equal @expected_titles, @ordered_leaves.map { it.reload.title }
+  end
+
+  test "resumes with interrupt_job_during_step helper including on the final leaf" do
+    TitleCleanupJob.perform_later
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: @ordered_leaves.last.id + 1) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal @expected_titles, @ordered_leaves.map { it.reload.title }
+    assert_enqueued_jobs 1, only: TitleCleanupJob
+
+    perform_enqueued_jobs
+    assert_no_enqueued_jobs only: TitleCleanupJob
+    assert_equal @expected_titles, @ordered_leaves.map { it.reload.title }
+    assert_nil JobCheckpoint.cursor_for("TitleCleanupJob")
+  end
+
+  test "resumes across multiple deploy interruptions until the tail is done" do
+    updated_ids = []
+    track_leaf_updates(updated_ids) do
+      TitleCleanupJob.perform_later
+
+      3.times do |i|
+        queue_adapter.with(stopping: -> { updated_ids.size >= i + 1 }) do
+          perform_enqueued_jobs
+        end
+        assert_enqueued_jobs 1, only: TitleCleanupJob
+      end
+
+      perform_enqueued_jobs
+    end
+
+    assert_no_enqueued_jobs only: TitleCleanupJob
+    assert_equal @ordered_leaves.map(&:id), updated_ids
+    assert_equal @expected_titles, @ordered_leaves.map { it.reload.title }
+  end
+
+  test "redoes at most the uncommitted leaf it was on after an error mid-leaf" do
+    attempts_by_id = Hash.new(0)
+    target_leaf = @ordered_leaves[2]
+
+    with_interrupted_update(
+      before_update: ->(leaf) {
+        attempts_by_id[leaf.id] += 1
+        raise "transient error" if leaf == target_leaf && attempts_by_id[leaf.id] == 1
+      }
+    ) do
+      TitleCleanupJob.perform_later
+      perform_enqueued_jobs
+      assert_enqueued_jobs 1, only: TitleCleanupJob
+
+      perform_enqueued_jobs
+    end
+
+    assert_equal 1, attempts_by_id[@ordered_leaves[0].id]
+    assert_equal 1, attempts_by_id[@ordered_leaves[1].id]
+    assert_equal 2, attempts_by_id[target_leaf.id]
+    assert_equal 1, attempts_by_id[@ordered_leaves[3].id]
+    assert_equal @expected_titles, @ordered_leaves.map { it.reload.title }
+  end
+
+  test "rolls back checkpoint atomically if leaf update transaction rolls back" do
+    target_leaf = @ordered_leaves[2]
+    failed_once = false
+    callback = -> {
+      if self == target_leaf && !failed_once
+        failed_once = true
+        raise "rollback inside transaction"
+      end
+    }
+
+    Leaf.set_callback(:update, :after, callback)
+    begin
+      TitleCleanupJob.perform_later
+      perform_enqueued_jobs
+      assert_equal %("#{@expected_titles[2]}"), target_leaf.reload.title
+      assert_equal @ordered_leaves[1].id + 1, JobCheckpoint.cursor_for("TitleCleanupJob")
+
+      perform_enqueued_jobs
+    ensure
+      Leaf.skip_callback(:update, :after, callback)
+    end
+
+    assert_equal @expected_titles, @ordered_leaves.map { it.reload.title }
+  end
+
+  test "does not clean a leaf twice if interrupted immediately after its update commits" do
+    interrupt = Class.new(Exception)
+    updated_ids = []
+
+    ActiveRecord::Base.cache do
+      with_interrupted_update(
+        after_update: ->(leaf) {
+          updated_ids << leaf.id
+          raise interrupt if updated_ids.size == 2
+        }
+      ) do
+        assert_raises(interrupt) { TitleCleanupJob.perform_now }
+      end
+
+      assert_equal @expected_titles.first(2), @ordered_leaves.first(2).map { it.reload.title }
+
+      track_leaf_updates(updated_ids) do
+        TitleCleanupJob.perform_now
+      end
+    end
+
+    assert_equal @ordered_leaves.map(&:id), updated_ids
+    assert_equal @expected_titles, @ordered_leaves.map { it.reload.title }
+  end
+
+  test "resumes after Resque TermException when running as enqueued job" do
+    raised = false
+
+    with_interrupted_update(
+      before_update: ->(leaf) {
+        if leaf == @ordered_leaves[2] && !raised
+          raised = true
+          raise Resque::TermException, "SIGTERM"
+        end
+      }
+    ) do
+      TitleCleanupJob.perform_later
+      perform_enqueued_jobs
+      assert_enqueued_jobs 1, only: TitleCleanupJob
+
+      perform_enqueued_jobs
+    end
+
+    assert_equal @expected_titles, @ordered_leaves.map { it.reload.title }
+  end
+
+  test "resque adapter reports stopping on shutdown and re-enqueues without resque-scheduler" do
+    adapter = ActiveJob::QueueAdapters::ResqueAdapter.new
+    worker = Resque::Worker.new(:default)
+    worker.fork_per_job = false
+
+    assert_not adapter.stopping?
+
+    enqueued_payloads = []
+    with_resque_enqueue_captured(enqueued_payloads) do
+      allow_worker_perform(worker) do
+        assert_not adapter.stopping?
+        worker.shutdown
+        assert adapter.stopping?
+
+        TitleCleanupJob.enable_test_adapter(adapter)
+        TitleCleanupJob.perform_now
+      ensure
+        TitleCleanupJob.enable_test_adapter(queue_adapter)
+      end
+    end
+
+    assert_not adapter.stopping?
+    assert_equal 1, enqueued_payloads.size
+    assert_equal @expected_titles.first, @ordered_leaves.first.reload.title
+    assert_equal %("#{@expected_titles.second}"), @ordered_leaves.second.reload.title
+
+    ActiveJob::Base.execute(enqueued_payloads.first.last)
+    assert_equal @expected_titles, @ordered_leaves.map { it.reload.title }
+  end
+
+  test "clears checkpoint on completion so a subsequent full run processes new titles" do
+    TitleCleanupJob.perform_now
+    assert_equal @expected_titles, @ordered_leaves.map { it.reload.title }
+
+    rewrapped = @ordered_leaves.map { %("#{it.title}") }
+    @ordered_leaves.zip(rewrapped).each { |leaf, title| leaf.update!(title: title) }
+
+    TitleCleanupJob.perform_now
+    assert_equal @expected_titles, @ordered_leaves.map { it.reload.title }
+  end
+
+  private
+    def track_leaf_updates(updated_ids, &block)
+      with_interrupted_update(after_update: ->(leaf) { updated_ids << leaf.id }, &block)
+    end
+
+    def with_interrupted_update(before_update: nil, after_update: nil)
+      original_update = Leaf.instance_method(:update!)
+
+      Leaf.define_method(:update!) do |*args, **kwargs|
+        before_update&.call(self)
+        original_update.bind_call(self, *args, **kwargs).tap do
+          after_update&.call(self)
+        end
+      end
+
+      yield
+    ensure
+      Leaf.define_method(:update!, original_update)
+    end
+
+    def allow_worker_perform(worker, &block)
+      captured_error = nil
+      worker.define_singleton_method(:report_failed_job) { |_job, error| captured_error = error }
+      fake_job = Object.new.tap { it.define_singleton_method(:perform) { block.call } }
+      worker.perform(fake_job)
+      raise captured_error if captured_error
+    end
+
+    def with_resque_enqueue_captured(enqueued_payloads)
+      original_enqueue_to = Resque.method(:enqueue_to)
+      Resque.define_singleton_method(:enqueue_to) do |queue, klass, payload|
+        enqueued_payloads << [ queue, klass, payload ]
+      end
+      yield
+    ensure
+      Resque.define_singleton_method(:enqueue_to, original_enqueue_to)
+    end
+end
