--- a/app/jobs/title_cleanup_job.rb
+++ b/app/jobs/title_cleanup_job.rb
@@ -1,11 +1,46 @@
 class TitleCleanupJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  CHECKPOINT_KEY = name
+
+  self.resume_options = {}
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    step :clean_titles, start: JobCheckpoint.cursor_for(CHECKPOINT_KEY) do |step|
+      start_cursor = [ step.cursor, JobCheckpoint.cursor_for(CHECKPOINT_KEY) ].compact.max
+
+      Leaf.find_each(start: start_cursor, order: :asc) do |leaf|
+        clean_leaf(leaf)
+        step.advance! from: leaf.id
+      end
+
+      JobCheckpoint.clear!(CHECKPOINT_KEY)
     end
+  rescue SignalException
+    raise unless enqueued_at.present? || Thread.current[:resque_worker]
+    interrupt!(reason: :stopping)
   end
 
   private
+    def resume_errors_after_advancing?
+      self.class.resume_errors_after_advancing? && (enqueued_at.present? || continuation.started?)
+    end
+
+    def clean_leaf(leaf)
+      checkpointed = false
+
+      JobCheckpoint.recording_after_update(->(record) {
+        if record == leaf
+          JobCheckpoint.advance!(CHECKPOINT_KEY, leaf.id + 1)
+          checkpointed = true
+        end
+      }) do
+        leaf.update!(title: cleaned(leaf.title))
+      end
+
+      JobCheckpoint.advance!(CHECKPOINT_KEY, leaf.id + 1) unless checkpointed
+    end
+
     def cleaned(title)
       title.delete_prefix('"').delete_suffix('"')
     end
diff --git a/app/models/job_checkpoint.rb b/app/models/job_checkpoint.rb
new file mode 100644
index 0000000..fa8be9c
--- /dev/null
+++ b/app/models/job_checkpoint.rb
@@ -0,0 +1,29 @@
+class JobCheckpoint < ApplicationRecord
+  thread_mattr_accessor :after_record_update
+
+  class << self
+    def cursor_for(key)
+      uncached { where(key: key).pick(:cursor) }
+    end
+
+    def advance!(key, cursor)
+      upsert(
+        { key: key, cursor: cursor },
+        unique_by: :key,
+        on_duplicate: Arel.sql("cursor = MAX(job_checkpoints.cursor, excluded.cursor), updated_at = excluded.updated_at")
+      )
+    end
+
+    def clear!(key)
+      where(key: key).delete_all
+    end
+
+    def recording_after_update(callback)
+      previous = after_record_update
+      self.after_record_update = callback
+      yield
+    ensure
+      self.after_record_update = previous
+    end
+  end
+end
