index 0000000..eb28c69
--- /dev/null
+++ b/app/views/sessions/magic_links/show.html.erb
@@ -0,0 +1,39 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] || flash[:shake] %>">
+  <header>
+    <h1 class="txt-x-large font-weight-black margin-block-end-half">Check your email</h1>
+    <p class="margin-none">Enter the verification code sent to <strong><%= email_address_pending_authentication %></strong></p>
+  </header>
+
+  <%= form_with url: session_magic_link_path, method: :post, class: "flex flex-column gap-half align-center", data: { controller: "form" } do |form| %>
+    <%= form.label :code, "Verification code", class: "for-screen-reader" %>
+    <%= form.text_field :code,
+          required: true,
+          autofocus: true,
+          autocomplete: "one-time-code",
+          autocorrect: "off",
+          autocapitalize: "characters",
+          spellcheck: "false",
+          class: "input center",
+          placeholder: "••••••" %>
+
+    <p class="txt-small txt-subtle margin-block-none">The code on its way to you works for <%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>.</p>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% if Rails.env.development? && flash[:magic_link_code].present? %>
+  <div class="flex align-center justify-center gap fill-shade border-radius pad margin-block-start center" style="max-inline-size: 42ch;">
+    <span class="txt-uppercase txt-subtle txt-x-small">PSST, here’s your code:</span>
+    <code class="txt-medium font-weight-black"><%= flash[:magic_link_code] %></code>
+  </div>
+<% end %>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
