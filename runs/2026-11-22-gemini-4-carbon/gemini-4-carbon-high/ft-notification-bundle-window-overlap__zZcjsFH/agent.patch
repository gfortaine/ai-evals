+      t.index [ :user_id, :starts_at, :ends_at ]
+      t.index [ :ends_at, :status ]
+    end
+
+    create_table :notification_bundle_entries, id: :uuid do |t|
+      t.uuid :account_id, null: false
+      t.uuid :notification_bundle_id, null: false
+      t.uuid :notification_id, null: false
+      t.timestamps
+
+      t.index :account_id
+      t.index :notification_id
+      t.index [ :notification_bundle_id, :notification_id ], unique: true, name: "idx_notification_bundle_entries_on_bundle_and_notification"
+    end
+  end
+end
