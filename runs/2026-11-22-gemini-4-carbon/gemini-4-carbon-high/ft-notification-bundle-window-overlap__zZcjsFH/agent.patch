@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Notification::BundleMailerTest < ActionMailer::TestCase
+  test "notification renders event and mention notifications in HTML and text" do
+    david = users(:david)
+    david.settings.update!(bundle_email_frequency: :every_few_hours, timezone_name: "America/New_York")
+    david.notifications.destroy_all
+    david.notification_bundles.destroy_all
+
+    Notification.create!(
+      user: david,
+      source: mentions(:logo_comment_david_mention_by_jz),
+      creator: users(:jz)
+    )
+    Notification.create!(
+      user: david,
+      source: events(:layout_commented),
+      creator: users(:kevin)
+    )
+
+    bundle = david.notification_bundles.sole
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ david.identity.email_address ], email.to
+    assert_equal "#{david.account.name}: 2 new notifications", email.subject
+    assert email.html_part.present?
+    assert email.text_part.present?
+    assert email.header["List-Unsubscribe"].present?
+    assert_equal "List-Unsubscribe=One-Click", email.header["List-Unsubscribe-Post"].to_s
+
+    html = email.html_part.body.decoded
+    text = email.text_part.body.decoded
+
+    assert_includes CGI.unescapeHTML(html), cards(:logo).title
+    assert_includes html, cards(:layout).title
+    assert_includes html, "@mentioned you"
+    assert_includes html, "#{david.account.slug}/notifications/settings"
+    assert_includes html, "#{david.account.slug}/notifications/unsubscribe/new"
+
+    assert_includes text, cards(:logo).title
+    assert_includes text, cards(:layout).title
+    assert_includes text, "@mentioned you"
+    assert_includes text, "#{david.account.slug}/notifications/settings"
+  end
+end
