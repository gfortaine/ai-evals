+class Notification::BundleMailerPreview < ActionMailer::Preview
+  def notification
+    user = User.active.joins(:notifications).merge(Notification.unread).first || User.active.first
+    bundle = Notification::Bundle.new(
+      account: user.account,
+      user: user,
+      starts_at: 4.hours.ago,
+      ends_at: Time.current
+    )
+    bundle.define_singleton_method(:notifications) { user.notifications }
+
+    Notification::BundleMailer.notification(bundle)
+  end
+end
