@@ -0,0 +1,55 @@
+<tr>
+  <td>
+    <h1 class="title"><%= @account.name %></h1>
+    <p class="subtitle">
+      You have <%= pluralize(@notifications.size, "new notification") %> since <%= @bundle.starts_at.strftime("%b %-d at %-l:%M%P") %>.
+    </p>
+
+    <% @notifications.group_by { |notification| notification.card.board }.sort_by { |board, _| board.name.downcase }.each_with_index do |(board, notifications), index| %>
+      <% if index > 0 %>
+        <hr class="notification__board-separator">
+      <% end %>
+
+      <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+      <% notifications.each do |notification| %>
+        <table class="notification">
+          <tr>
+            <td class="avatar__container">
+              <%= mail_avatar_tag(notification.creator) %>
+            </td>
+            <td>
+              <% case notification.source %>
+              <% when Event %>
+                <% event = notification.source %>
+                <h3 class="card__title"><%= link_to event_notification_title(event), polymorphic_url(notification) %></h3>
+                <p class="notification__details"><%= event_notification_body(event) %></p>
+              <% when Mention %>
+                <% mention = notification.source %>
+                <h3 class="card__title">
+                  <%= link_to(notification.card.title.presence || "Card #{notification.card.number}", polymorphic_url(notification)) %>
+                </h3>
+                <p class="notification__details">
+                  <strong class="notificaton__mention"><%= mention.mentioner.first_name %> @mentioned you</strong>
+                  <%= mention.source.mentionable_content.truncate(200) %>
+                </p>
+              <% else %>
+                <h3 class="card__title"><%= link_to notification.payload.title, notification.payload.url %></h3>
+                <p class="notification__details"><%= notification.payload.body %></p>
+              <% end %>
+
+              <p class="notification__author">
+                <%= notification.creator.name %> • <%= notification.updated_at.strftime("%b %-d at %-l:%M%P") %>
+              </p>
+            </td>
+          </tr>
+        </table>
+      <% end %>
+    <% end %>
+
+    <p class="footer">
+      <%= link_to "Notification settings", notifications_settings_url %> •
+      <%= link_to "Unsubscribe from email notifications", new_notifications_unsubscribe_url(access_token: @unsubscribe_token) %>
+    </p>
+  </td>
+</tr>
