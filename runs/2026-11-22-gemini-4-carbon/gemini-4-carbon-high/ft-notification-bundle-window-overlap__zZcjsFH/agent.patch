diff --git a/app/mailers/notification/bundle_mailer.rb b/app/mailers/notification/bundle_mailer.rb
new file mode 100644
index 0000000..8ea6abb
--- /dev/null
+++ b/app/mailers/notification/bundle_mailer.rb
@@ -0,0 +1,29 @@
+class Notification::BundleMailer < ApplicationMailer
+  helper NotificationsHelper
+
+  def notification(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.notifications.unread.ordered.preloaded
+    @unsubscribe_token = @user.generate_token_for(:unsubscribe)
+
+    Current.with_account(@account) do
+      @user.in_time_zone do
+        headers["List-Unsubscribe-Post"] = "List-Unsubscribe=One-Click"
+        headers["List-Unsubscribe"] = "<#{notifications_unsubscribe_url(access_token: @unsubscribe_token)}>"
+
+        mail \
+          to: @user.identity.email_address,
+          subject: subject_for(@notifications)
+      end
+    end
+  end
+
+  private
+    def subject_for(notifications)
+      count = notifications.size
+      label = count == 1 ? "1 new notification" : "#{count} new notifications"
+      "#{@account.name}: #{label}"
+    end
+end
