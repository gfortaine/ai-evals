index 0000000..06a11c0
--- /dev/null
+++ b/test/integration/with_raised_exceptions_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class WithRaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "raises controller exceptions inside the block and renders error pages before and after" do
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    result = with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+      :completed
+    end
+
+    assert_equal :completed, result
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "restores error page rendering when an exception escapes the block" do
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "keeps raising exceptions across nested blocks until the outermost block exits" do
+    with_raised_exceptions do
+      with_raised_exceptions do
+        assert_raises ActiveRecord::RecordNotFound do
+          get book_slug_path(books(:manual))
+        end
+      end
+
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+end
