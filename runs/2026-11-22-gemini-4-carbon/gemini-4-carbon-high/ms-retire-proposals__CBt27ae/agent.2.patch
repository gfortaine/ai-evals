+    def format_inserts(table, rows)
+      header = "-- Table: #{table} (#{rows.size} rows)\n"
+      return header if rows.empty?
+
+      quoted_table = qt(table)
+      cols = rows.first.keys.map { |col| qc(col) }.join(", ")
+      lines = rows.map do |row|
+        vals = row.values.map { |val| q(val) }.join(", ")
+        "INSERT INTO #{quoted_table} (#{cols}) VALUES (#{vals});"
+      end
+      "#{header}#{lines.join("\n")}\n"
+    end
+
+    def dump_column_updates(table, column_names)
+      select_cols = (["id"] + column_names).map { |col| qc(col) }.join(", ")
+      rows = connection.exec_query("SELECT #{select_cols} FROM #{qt(table)} ORDER BY id").to_a
+      header = "-- Column archive for #{table} (#{column_names.join(", ")}) (#{rows.size} rows)\n"
+      return header if rows.empty?
+
+      quoted_table = qt(table)
+      lines = rows.map do |row|
+        assignments = column_names.map { |col| "#{qc(col)} = #{q(row[col])}" }.join(", ")
+        "UPDATE #{quoted_table} SET #{assignments} WHERE \"id\" = #{q(row["id"])};"
+      end
+      "#{header}#{lines.join("\n")}\n"
+    end
+
+    def q(value)
+      connection.quote(value)
+    end
+
+    def qt(table)
+      connection.quote_table_name(table)
+    end
+
+    def qc(column)
+      connection.quote_column_name(column)
+    end
+
+    def row_count(table)
+      connection.select_value("SELECT COUNT(*) FROM #{qt(table)}").to_i
+    end
+
+    def rows_exist?(table, condition)
+      connection.select_value("SELECT COUNT(*) FROM #{qt(table)} WHERE #{condition}").to_i.positive?
+    end
+
+    def select_ids(sql)
+      connection.select_values(sql).map(&:to_i)
+    end
+
+    def ids_where(table, condition)
+      select_ids("SELECT id FROM #{qt(table)} WHERE #{condition} ORDER BY id")
+    end
+
+    def delete_by_ids(table, column, ids)
+      return if ids.empty?
+
+      delete_where(table, "#{qc(column)} IN (#{id_list(ids)})")
+    end
+
+    def delete_where(table, condition)
+      connection.execute("DELETE FROM #{qt(table)} WHERE #{condition}")
+    end
+
+    def id_list(ids)
+      ids.empty? ? "-1" : ids.map(&:to_i).join(", ")
+    end
+
+    def quoted_list(values)
+      values.map { |val| q(val) }.join(", ")
+    end
+end
