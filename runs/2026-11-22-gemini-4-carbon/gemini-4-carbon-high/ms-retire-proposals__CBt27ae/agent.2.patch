+    def build_linked_records_dump(ids)
+      sections = []
+      linked_queries(ids).each do |table, condition|
+        sql = "SELECT * FROM #{qt(table)} WHERE #{condition} ORDER BY id"
+        rows = connection.exec_query(sql).to_a
+        next if rows.empty?
+
+        sections << format_inserts(table, rows)
+      end
+      page_rows = custom_page_rows_to_clean
+      sections << format_inserts("site_customization_page_translations", page_rows) if page_rows.any?
+      sections.join("\n")
+    end
