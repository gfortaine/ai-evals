+    def custom_page_rows_to_clean
+      connection.exec_query(
+        "SELECT pt.* FROM site_customization_page_translations pt " \
+        "INNER JOIN site_customization_pages p ON p.id = pt.site_customization_page_id " \
+        "WHERE pt.locale = 'en' AND p.slug IN (#{quoted_list(WELCOME_SLUGS)}) " \
+        "AND (pt.content LIKE '%<li>Create new proposals</li>%' " \
+        "OR pt.content LIKE '%<li>Support proposals</li>%' " \
+        "OR pt.content LIKE '%<td>Proposals</td>%') " \
+        "ORDER BY pt.id"
+      ).to_a
+    end
+
+    def clean_custom_pages
+      custom_page_rows_to_clean.each do |row|
+        updated = row["content"]
+          .gsub(/\n[ \t]*<li>Create new proposals<\/li>/, "")
+          .gsub(/\n[ \t]*<li>Support proposals<\/li>/, "")
+          .gsub(/<tr>\s*<td class='text-center'>2<\/td>\s*<td>Proposals<\/td>\s*<\/tr>/, "")
+        next if updated == row["content"]
+
+        connection.execute(
+          "UPDATE site_customization_page_translations " \
+          "SET content = #{q(updated)} WHERE id = #{row["id"].to_i}"
+        )
+      end
+    end
