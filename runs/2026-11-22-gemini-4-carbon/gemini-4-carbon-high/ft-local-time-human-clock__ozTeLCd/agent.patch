diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..98c6dd9
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_datetime_tag returns nil when datetime is nil" do
+    assert_nil local_datetime_tag(nil)
+  end
+
+  test "local_datetime_tag renders raw UTC timestamp without server-formatted text" do
+    timestamp = Time.utc(2025, 9, 12, 17, 42, 0)
+
+    rendered = local_datetime_tag(timestamp, style: :relative)
+    fragment = Nokogiri::HTML::DocumentFragment.parse(rendered)
+    time_el = fragment.at_css("time")
+
+    assert_not_nil time_el
+    assert_equal "2025-09-12T17:42:00Z", time_el["datetime"]
+    assert_equal "local-time", time_el["data-controller"]
+    assert_equal "relative", time_el["data-local-time-style-value"]
+    assert_includes time_el["class"].split, "local-time-value"
+    assert_equal "", time_el.text
+  end
+
+  test "local_datetime_tag output is invariant across server timezones and server clock" do
+    timestamp = Time.utc(2025, 9, 12, 23, 30, 0)
+
+    rendered_utc = travel_to(timestamp + 5.minutes) do
+      Time.use_zone("UTC") { local_datetime_tag(timestamp, style: :ago) }
+    end
+
+    rendered_tokyo_later = travel_to(timestamp + 10.days) do
+      Time.use_zone("Asia/Tokyo") { local_datetime_tag(timestamp.in_time_zone("Asia/Tokyo"), style: :ago) }
+    end
+
+    assert_equal rendered_utc, rendered_tokyo_later
+  end
+
+  test "local_datetime_tag merges custom classes and data attributes" do
+    timestamp = Time.utc(2025, 9, 12, 17, 42, 0)
+
+    rendered = local_datetime_tag(
+      timestamp,
+      style: :time,
+      class: "event__timestamp txt-small",
+      data: { controller: "tooltip", custom: "yes" }
+    )
+    time_el = Nokogiri::HTML::DocumentFragment.parse(rendered).at_css("time")
+
+    assert_equal %w[local-time-value event__timestamp txt-small], time_el["class"].split
+    assert_equal %w[local-time tooltip], time_el["data-controller"].split
+    assert_equal "yes", time_el["data-custom"]
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..790ae39
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,190 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:kevin)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "renders comment timestamps in the viewer's timezone across today, last night, earlier in the week, and older dates" do
+    set_browser_timezone("America/New_York")
+
+    ny_zone = ActiveSupport::TimeZone["America/New_York"]
+    now_ny = Time.current.in_time_zone(ny_zone)
+
+    today_time = if now_ny.hour >= 14
+      ny_zone.local(now_ny.year, now_ny.month, now_ny.day, 13, 42, 0)
+    elsif now_ny.hour >= 2
+      (now_ny - 2.hours).change(sec: 0)
+    else
+      ny_zone.local(now_ny.year, now_ny.month, now_ny.day, 0, 1, 0)
+    end
+    expected_today_clock = today_time.strftime("%-l:%M %p")
+
+    yesterday_date = now_ny.to_date - 1.day
+    last_night_time = ny_zone.local(yesterday_date.year, yesterday_date.month, yesterday_date.day, 23, 15, 0)
+
+    five_days_ago_date = now_ny.to_date - 5.days
+    five_days_ago_time = ny_zone.local(five_days_ago_date.year, five_days_ago_date.month, five_days_ago_date.day, 14, 0, 0)
+
+    older_year = now_ny.month >= 10 ? now_ny.year : now_ny.year - 1
+    sep_12_time = ny_zone.local(older_year, 9, 12, 17, 42, 0)
+    expected_sep_12 = older_year == now_ny.year ? "Sep 12" : "Sep 12, #{older_year}"
+
+    c_today = @card.comments.create!(creator: @user, body: "Comment from today", created_at: today_time)
+    c_last_night = @card.comments.create!(creator: @user, body: "Comment from last night", created_at: last_night_time)
+    c_five_days = @card.comments.create!(creator: @user, body: "Comment from five days ago", created_at: five_days_ago_time)
+    c_sep_12 = @card.comments.create!(creator: @user, body: "Comment from Sep 12", created_at: sep_12_time)
+
+    sign_in_as(@user)
+    visit card_url(@card)
+
+    assert_equal expected_today_clock, comment_time_text(c_today)
+    assert_equal "yesterday", comment_time_text(c_last_night)
+    assert_equal "5 days ago", comment_time_text(c_five_days)
+    assert_equal expected_sep_12, comment_time_text(c_sep_12)
+  end
+
+  test "renders the same raw timestamp differently depending on the viewer's browser timezone" do
+    # 2025-09-12T22:42:00Z is Sep 12, 6:42 PM in America/New_York (EDT, UTC-4),
+    # and Sep 13, 7:42 AM in Asia/Tokyo (JST, UTC+9).
+    utc_timestamp = Time.utc(2025, 9, 12, 22, 42, 0)
+    comment = @card.comments.create!(creator: @user, body: "Cross-timezone comment", created_at: utc_timestamp)
+
+    set_browser_timezone("America/New_York")
+    sign_in_as(@user)
+    visit card_url(@card)
+
+    expected_ny = Time.current.in_time_zone("America/New_York").year == 2025 ? "Sep 12" : "Sep 12, 2025"
+    assert_equal expected_ny, comment_time_text(comment)
+
+    set_browser_timezone("Asia/Tokyo")
+    visit card_url(@card)
+
+    expected_tokyo = Time.current.in_time_zone("Asia/Tokyo").year == 2025 ? "Sep 13" : "Sep 13, 2025"
+    assert_equal expected_tokyo, comment_time_text(comment)
+  end
+
+  test "renders auto-closing entropy notice as tomorrow overnight and in N days further out" do
+    set_browser_timezone("America/New_York")
+    ny_zone = ActiveSupport::TimeZone["America/New_York"]
+    now_ny = Time.current.in_time_zone(ny_zone)
+
+    @board.update!(auto_postpone_period_in_days: 3)
+
+    tomorrow_date = now_ny.to_date + 1.day
+    overnight_closes_at = ny_zone.local(tomorrow_date.year, tomorrow_date.month, tomorrow_date.day, 3, 0, 0)
+    @card.update_columns(last_active_at: overnight_closes_at - 3.days)
+
+    sign_in_as(@user)
+    visit card_url(@card)
+
+    assert_selector "##{dom_id(@card, :closure_notice)}", text: "Moves to “Not Now” tomorrow if there’s no activity."
+
+    @card.update_columns(last_active_at: Time.current)
+    visit card_url(@card)
+
+    assert_selector "##{dom_id(@card, :closure_notice)}", text: "Moves to “Not Now” in 3 days if there’s no activity."
+  end
+
+  test "renders closed card dates, public cards, notifications, timeline, and access tokens in viewer timezone" do
+    utc_closed_at = Time.utc(2025, 9, 12, 22, 42, 0) # Sep 12 in NY, Sep 13 in Tokyo
+    @card.close(user: @user)
+    @card.closure.update_columns(created_at: utc_closed_at)
+    @board.publish
+
+    token = @user.identity.access_tokens.create!(description: "Test CLI", permission: "read")
+    token.update_columns(created_at: utc_closed_at)
+
+    set_browser_timezone("America/New_York")
+    visit published_card_url(@card)
+    assert_selector ".card__closed-date time", text: /Sep 12, 2025/i
+
+    set_browser_timezone("Asia/Tokyo")
+    visit published_card_url(@card)
+    assert_selector ".card__closed-date time", text: /Sep 13, 2025/i
+
+    sign_in_as(@user)
+    visit card_url(@card)
+    expected_completed_tokyo = Time.current.in_time_zone("Asia/Tokyo").year == 2025 ? "Sep 13" : "Sep 13, 2025"
+    assert_selector ".card-perma__closure-message", text: "Completed by #{@user.name} on #{expected_completed_tokyo}."
+
+    visit my_access_tokens_url
+    assert_selector "table.access-tokens td time", text: "9/13/25, 7:42 AM"
+
+    set_browser_timezone("America/New_York")
+    visit my_access_tokens_url
+    assert_selector "table.access-tokens td time", text: "9/12/25, 6:42 PM"
+  end
+
+  test "formats all local_time_helpers styles accurately across deterministic boundaries and morphing" do
+    set_browser_timezone("America/New_York")
+    sign_in_as(@user)
+    visit card_url(@card)
+
+    results = page.evaluate_async_script(<<~JS)
+      const done = arguments[arguments.length - 1]
+      import("helpers/local_time_helpers").then(({ formatLocalTime }) => {
+        const now = new Date("2025-09-17T19:42:00Z") // Wed Sep 17, 2025 3:42 PM EDT
+        done({
+          commentTwoHoursAgo: formatLocalTime(new Date("2025-09-17T17:42:00Z"), "relative", now),
+          commentLastNight: formatLocalTime(new Date("2025-09-17T03:30:00Z"), "relative", now),
+          commentFiveDaysAgo: formatLocalTime(new Date("2025-09-12T16:00:00Z"), "relative", now),
+          commentOlderSameYear: formatLocalTime(new Date("2025-09-02T16:00:00Z"), "relative", now),
+          commentOlderPrevYear: formatLocalTime(new Date("2024-09-12T16:00:00Z"), "relative", now),
+          agoJustNow: formatLocalTime(new Date("2025-09-17T19:41:40Z"), "ago", now),
+          agoMinutes: formatLocalTime(new Date("2025-09-17T19:37:00Z"), "ago", now),
+          agoHours: formatLocalTime(new Date("2025-09-17T17:42:00Z"), "ago", now),
+          agoLastNight: formatLocalTime(new Date("2025-09-17T03:30:00Z"), "ago", now),
+          inDaysToday: formatLocalTime(new Date("2025-09-18T02:00:00Z"), "indays", now),
+          inDaysOvernight: formatLocalTime(new Date("2025-09-18T06:00:00Z"), "indays", now),
+          inDaysThree: formatLocalTime(new Date("2025-09-20T19:42:00Z"), "indays", now),
+          weekdayToday: formatLocalTime(new Date("2025-09-17T15:00:00Z"), "agoorweekday", now),
+          weekdayYesterday: formatLocalTime(new Date("2025-09-16T15:00:00Z"), "agoorweekday", now),
+          weekdayOlder: formatLocalTime(new Date("2025-09-12T15:00:00Z"), "agoorweekday", now),
+          stampDate: formatLocalTime(new Date("2025-09-12T17:42:00Z"), "date", now),
+          accessTokenDateTime: formatLocalTime(new Date("2025-09-12T17:42:00Z"), "datetime", now)
+        })
+      })
+    JS
+
+    assert_equal "1:42 PM", results["commentTwoHoursAgo"]
+    assert_equal "yesterday", results["commentLastNight"]
+    assert_equal "5 days ago", results["commentFiveDaysAgo"]
+    assert_equal "Sep 2", results["commentOlderSameYear"]
+    assert_equal "Sep 12, 2024", results["commentOlderPrevYear"]
+    assert_equal "just now", results["agoJustNow"]
+    assert_equal "5 minutes ago", results["agoMinutes"]
+    assert_equal "2 hours ago", results["agoHours"]
+    assert_equal "yesterday", results["agoLastNight"]
+    assert_equal "today", results["inDaysToday"]
+    assert_equal "tomorrow", results["inDaysOvernight"]
+    assert_equal "in 3 days", results["inDaysThree"]
+    assert_equal "today", results["weekdayToday"]
+    assert_equal "yesterday", results["weekdayYesterday"]
+    assert_equal "Friday, September 12", results["weekdayOlder"]
+    assert_equal "Sep 12, 2025", results["stampDate"]
+    assert_equal "9/12/25, 1:42 PM", results["accessTokenDateTime"]
+
+    morphed_text = page.evaluate_script(<<~JS)
+      (() => {
+        const el = document.querySelector("#meta_card_#{@card.id} time")
+        el.textContent = ""
+        el.dispatchEvent(new CustomEvent("turbo:morph-element"))
+        return el.textContent
+      })()
+    JS
+    assert morphed_text.present?, "Expected local-time controller to re-populate textContent after turbo:morph-element"
+  end
+
+  private
+    def set_browser_timezone(timezone_id)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone_id)
+    end
+
+    def comment_time_text(comment)
+      element = find("##{dom_id(comment)} .comment__permalink-title time")
+      page.evaluate_script("arguments[0].textContent", element)
+    end
+end
