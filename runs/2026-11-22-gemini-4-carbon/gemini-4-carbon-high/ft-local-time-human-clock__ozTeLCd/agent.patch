diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..e009de1
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,65 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatFullDateTime, formatLocalTime } from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 60_000
+const activeControllers = new Set()
+let refreshTimer = null
+
+function refreshAll() {
+  const now = new Date()
+  for (const controller of activeControllers) {
+    controller.refresh(now)
+  }
+}
+
+function registerController(controller) {
+  activeControllers.add(controller)
+
+  if (!refreshTimer) {
+    refreshTimer = setInterval(refreshAll, REFRESH_INTERVAL)
+  }
+}
+
+function unregisterController(controller) {
+  activeControllers.delete(controller)
+
+  if (activeControllers.size === 0 && refreshTimer) {
+    clearInterval(refreshTimer)
+    refreshTimer = null
+  }
+}
+
+document.addEventListener("visibilitychange", () => {
+  if (document.visibilityState === "visible" && activeControllers.size > 0) {
+    refreshAll()
+  }
+})
+
+export default class extends Controller {
+  static values = { style: { type: String, default: "time" } }
+
+  connect() {
+    registerController(this)
+    this.refresh()
+  }
+
+  disconnect() {
+    unregisterController(this)
+  }
+
+  styleValueChanged() {
+    this.refresh()
+  }
+
+  refresh(nowOrEvent = new Date()) {
+    const raw = this.element.getAttribute("datetime")
+    if (!raw) return
+
+    const date = new Date(raw)
+    if (Number.isNaN(date.getTime())) return
+
+    const now = nowOrEvent instanceof Date ? nowOrEvent : new Date()
+    this.element.textContent = formatLocalTime(date, this.styleValue, now)
+    this.element.title = formatFullDateTime(date)
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..a484492
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,125 @@
+const MS_PER_DAY = 86_400_000
+
+let currentTimezone = null
+const formattersByTimezone = new Map()
+
+export function formatLocalTime(date, style = "time", now = new Date()) {
+  const formatters = getFormatters()
+  const daysDiff = differenceInLocalCalendarDays(now, date)
+
+  switch (style) {
+    case "time":
+      return normalizeSpaces(formatters.time.format(date))
+
+    case "shortdate":
+      return formatCalendarDate(date, now, formatters)
+
+    case "date":
+      return normalizeSpaces(formatters.dateWithYear.format(date))
+
+    case "datetime":
+      return normalizeSpaces(formatters.dateTime.format(date))
+
+    case "agoorweekday":
+      if (daysDiff === 0 || daysDiff === -1 || daysDiff === 1) {
+        return formatters.relative.format(daysDiff, "day")
+      }
+      return isSameLocalYear(date, now)
+        ? normalizeSpaces(formatters.weekday.format(date))
+        : normalizeSpaces(formatters.weekdayWithYear.format(date))
+
+    case "relative":
+      if (daysDiff === 0) {
+        return normalizeSpaces(formatters.time.format(date))
+      }
+      if (Math.abs(daysDiff) <= 6) {
+        return formatters.relative.format(daysDiff, "day")
+      }
+      return formatCalendarDate(date, now, formatters)
+
+    case "ago":
+      if (daysDiff === 0) {
+        const elapsedSeconds = Math.max(0, Math.floor((now - date) / 1000))
+        if (elapsedSeconds < 60) {
+          return "just now"
+        }
+        if (elapsedSeconds < 3600) {
+          return formatters.relative.format(-Math.floor(elapsedSeconds / 60), "minute")
+        }
+        return formatters.relative.format(-Math.floor(elapsedSeconds / 3600), "hour")
+      }
+      if (Math.abs(daysDiff) <= 6) {
+        return formatters.relative.format(daysDiff, "day")
+      }
+      return formatCalendarDate(date, now, formatters)
+
+    case "daysago":
+      if (Math.abs(daysDiff) <= 6) {
+        return formatters.relative.format(daysDiff, "day")
+      }
+      return formatCalendarDate(date, now, formatters)
+
+    case "indays":
+      if (daysDiff <= 0) {
+        return formatters.relative.format(0, "day")
+      }
+      return formatters.relative.format(daysDiff, "day")
+
+    default:
+      return normalizeSpaces(formatters.dateTime.format(date))
+  }
+}
+
+export function formatFullDateTime(date) {
+  return normalizeSpaces(getFormatters().fullDateTime.format(date))
+}
+
+function formatCalendarDate(date, now, formatters) {
+  return isSameLocalYear(date, now)
+    ? normalizeSpaces(formatters.shortDate.format(date))
+    : normalizeSpaces(formatters.dateWithYear.format(date))
+}
+
+function differenceInLocalCalendarDays(fromDate, toDate) {
+  return Math.round((localDayStamp(toDate) - localDayStamp(fromDate)) / MS_PER_DAY)
+}
+
+function localDayStamp(date) {
+  return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+function isSameLocalYear(firstDate, secondDate) {
+  return firstDate.getFullYear() === secondDate.getFullYear()
+}
+
+function normalizeSpaces(text) {
+  return text.replace(/\s+/g, " ").trim()
+}
+
+function getFormatters() {
+  if (!currentTimezone) {
+    currentTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC"
+    queueMicrotask(() => { currentTimezone = null })
+  }
+
+  let formatters = formattersByTimezone.get(currentTimezone)
+  if (!formatters) {
+    formatters = buildFormatters(currentTimezone)
+    formattersByTimezone.set(currentTimezone, formatters)
+  }
+
+  return formatters
+}
+
+function buildFormatters(timeZone) {
+  return {
+    time: new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit", timeZone }),
+    shortDate: new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone }),
+    dateWithYear: new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone }),
+    weekday: new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", timeZone }),
+    weekdayWithYear: new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric", timeZone }),
+    dateTime: new Intl.DateTimeFormat("en-US", { month: "numeric", day: "numeric", year: "2-digit", hour: "numeric", minute: "2-digit", timeZone }),
+    fullDateTime: new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit", timeZone }),
+    relative: new Intl.RelativeTimeFormat("en-US", { numeric: "auto" })
+  }
+}
