+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,34 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="search panel panel--wide center borderless unpad flex flex-column gap margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "search__form flex align-center gap-half" do |form| %>
+    <%= form.label :q, "Search", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards and comments…", class: "input full-width", autofocus: @search.blank?, autocorrect: "off", autocomplete: "off" %>
+    <%= form.button type: :submit, name: nil, class: "btn btn--link flex-item-no-shrink" do %>
+      <%= icon_tag "search" %>
+      <span>Search</span>
+    <% end %>
+  <% end %>
+
+  <% unless @search.blank? %>
+    <% if @page.records.any? %>
+      <div class="search-results flex flex-column gap-half">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <% @page.records.each do |card| %>
+            <%= render "searches/result", card: card, search: @search, matching_comments: @matching_comments_by_card_id.fetch(card.id, []) %>
+          <% end %>
+        <% end %>
+      </div>
+    <% else %>
+      <div class="blank-slate">No matching cards</div>
+    <% end %>
+  <% end %>
+</div>
