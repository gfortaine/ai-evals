diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..229bc5c
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,37 @@
+<%= card_article_tag card, id: dom_id(card), class: "card search-result" do %>
+  <header class="card__header">
+    <div class="card__board">
+      <span class="card__id">
+        <span class="for-screen-reader">Card number</span>
+        <%= card.number %>
+      </span>
+      <span class="card__board-name">
+        <span class="overflow-ellipsis"><%= card.board.name %></span>
+      </span>
+    </div>
+  </header>
+
+  <div class="search-result__body flex flex-column gap-half align-start txt-align-start">
+    <h3 class="card__title search-result__title">
+      <%= link_to card_path(card), class: "card__title-link search-result__link", data: { turbo_frame: "_top" } do %><%= card.title.present? ? highlight_search_terms(card.title, search.highlight_terms) : "Untitled" %><% end %>
+    </h3>
+
+    <% if search.description_matches?(card) %>
+      <p class="search-result__excerpt txt-small txt-break">
+        <%= search_excerpt(card.description, search.highlight_terms) %>
+      </p>
+    <% elsif matching_comments.empty? && card.description.present? %>
+      <p class="search-result__excerpt txt-small txt-break">
+        <%= format_excerpt(card.description, length: 200) %>
+      </p>
+    <% end %>
+
+    <% matching_comments.each do |comment| %>
+      <div class="search-result__comment txt-small txt-break">
+        <%= icon_tag "comment", class: "translucent" %>
+        <strong class="search-result__comment-author"><%= comment.creator.familiar_name %>:</strong>
+        <span class="search-result__comment-body"><%= search_excerpt(comment.body, search.highlight_terms) %></span>
+      </div>
+    <% end %>
+  </div>
+<% end %>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
