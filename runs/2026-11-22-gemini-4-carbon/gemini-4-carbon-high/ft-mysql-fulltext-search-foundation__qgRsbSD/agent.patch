diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..10ef279
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,89 @@
+module SearchesHelper
+  def highlight_search_terms(text, terms)
+    return "" if text.blank?
+
+    string = text.to_s
+    return ERB::Util.html_escape(string) if terms.blank?
+
+    pattern = search_highlight_pattern(terms)
+    parts = []
+    last_end = 0
+
+    string.scan(pattern) do
+      match = Regexp.last_match
+      parts << ERB::Util.html_escape(string[last_end...match.begin(0)]) if match.begin(0) > last_end
+      parts << tag.mark(match[0])
+      last_end = match.end(0)
+    end
+
+    parts << ERB::Util.html_escape(string[last_end..]) if last_end < string.length
+    safe_join(parts)
+  end
+
+  def search_excerpt(content, terms, radius: 100)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    text = text.gsub(/[[:space:]]+/, " ").strip
+    return "" if text.blank?
+    return ERB::Util.html_escape(text.truncate(radius * 2)) if terms.blank?
+
+    pattern = search_highlight_pattern(terms)
+    return ERB::Util.html_escape(text.truncate(radius * 2)) unless text.match?(pattern)
+    return highlight_search_terms(text, terms) if text.length <= radius * 2
+
+    windows = build_excerpt_windows(text, terms, radius)
+    snippets = windows.map do |start_idx, end_idx|
+      prefix = start_idx > 0 ? "…" : ""
+      suffix = end_idx < text.length ? "…" : ""
+      safe_join([ prefix, highlight_search_terms(text[start_idx...end_idx], terms), suffix ])
+    end
+
+    safe_join(snippets, " ")
+  end
+
+  private
+    def search_highlight_pattern(terms)
+      escaped = terms.map { |term| Regexp.escape(term) }.join("|")
+      /[\p{L}\p{N}]*(?:#{escaped})[\p{L}\p{N}]*/i
+    end
+
+    def build_excerpt_windows(text, terms, radius)
+      raw_ranges = terms.filter_map do |term|
+        word_pattern = /[\p{L}\p{N}]*#{Regexp.escape(term)}[\p{L}\p{N}]*/i
+        if match = word_pattern.match(text)
+          start_idx = snap_window_start(text, [ match.begin(0) - radius, 0 ].max, match.begin(0))
+          end_idx = snap_window_end(text, [ match.end(0) + radius, text.length ].min, match.end(0))
+          [ start_idx, end_idx ]
+        end
+      end.sort_by(&:first)
+
+      raw_ranges.first(3).each_with_object([]) do |(start_idx, end_idx), merged|
+        if merged.any? && start_idx <= merged.last[1]
+          merged.last[1] = [ merged.last[1], end_idx ].max
+        else
+          merged << [ start_idx, end_idx ]
+        end
+      end
+    end
+
+    def snap_window_start(text, idx, max_idx)
+      return 0 if idx <= 0
+
+      if idx > 0 && text[idx - 1].match?(/[^[:space:]]/) && text[idx].match?(/[^[:space:]]/)
+        space_idx = text.index(/[[:space:]]/, idx)
+        space_idx && space_idx < max_idx ? space_idx + 1 : idx
+      else
+        idx
+      end
+    end
+
+    def snap_window_end(text, idx, min_idx)
+      return text.length if idx >= text.length
+
+      if text[idx - 1].match?(/[^[:space:]]/) && text[idx].match?(/[^[:space:]]/)
+        space_idx = text.rindex(/[[:space:]]/, idx)
+        space_idx && space_idx > min_idx ? space_idx : idx
+      else
+        idx
+      end
+    end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..2399e94
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,217 @@
+class Search
+  MAX_MATCHING_COMMENTS_PER_CARD = 3
+
+  attr_reader :user, :query
+
+  def initialize(user:, query:)
+    @user = user
+    @query = query.is_a?(String) ? normalize_whitespace(query) : ""
+  end
+
+  def blank?
+    terms.empty?
+  end
+
+  def terms
+    @terms ||= parse_terms(query)
+  end
+
+  def highlight_terms
+    @highlight_terms ||= terms
+      .flat_map { |term| term.split(/[[:space:]]+/) }
+      .reject(&:blank?)
+      .uniq(&:downcase)
+      .sort_by { |term| -term.length }
+  end
+
+  def cards
+    @cards ||= find_cards
+  end
+
+  def description_matches?(card)
+    return false if blank? || card.description.blank?
+
+    matches_any_term?(plain_text(card.description))
+  end
+
+  def matching_comments_for(cards)
+    return {} if blank? || cards.empty?
+
+    comments_by_card = Hash.new { |hash, key| hash[key] = [] }
+
+    Comment.by_user
+      .where(account_id: user.account_id, card_id: cards.map(&:id))
+      .includes(:creator, :rich_text_body)
+      .order(created_at: :desc, id: :desc)
+      .each do |comment|
+        text = plain_text(comment.body)
+        comments_by_card[comment.card_id] << [ comment, text ] if matches_any_term?(text)
+      end
+
+    cards.each_with_object({}) do |card, result|
+      entries = comments_by_card[card.id]
+      result[card.id] = select_representative_comments(card, entries) if entries.any?
+    end
+  end
+
+  private
+    def parse_terms(raw_query)
+      return [] if raw_query.blank?
+
+      extracted = if raw_query.include?('"') && raw_query.count('"').even?
+        tokens = []
+        raw_query.scan(/"([^"]*)"|([^[:space:]"]+)/) do |quoted, word|
+          token = normalize_whitespace((quoted || word).to_s)
+          tokens << token if token.present?
+        end
+        tokens
+      else
+        raw_query.delete('"').split(/[[:space:]]+/).reject(&:blank?)
+      end
+
+      extracted.uniq(&:downcase)
+    end
+
+    def find_cards
+      return Card.none if blank?
+
+      base_scope = accessible_published_cards
+      candidate_scope = highlight_terms.reduce(base_scope) do |scope, term|
+        scope.merge(matching_card_scope_for_term(term))
+      end.reverse_chronologically
+
+      candidate_rows = candidate_scope.pluck(:id, :title)
+      return Card.none if candidate_rows.empty?
+
+      verified_ids = filter_verified_card_ids(candidate_rows)
+      return Card.none if verified_ids.empty?
+
+      base_scope.where(id: verified_ids).reverse_chronologically.preloaded
+    end
+
+    def accessible_published_cards
+      user.accessible_cards.published.where(account_id: user.account_id)
+    end
+
+    def matching_card_scope_for_term(term)
+      patterns = like_patterns_for(term)
+
+      title_predicate = Card.arel_table[:title].matches_any(patterns, "\\")
+      body_predicate = ActionText::RichText.arel_table[:body].matches_any(patterns, "\\")
+
+      description_card_ids = ActionText::RichText
+        .where(account_id: user.account_id, record_type: "Card", name: "description")
+        .where(body_predicate)
+        .select(:record_id)
+
+      comment_card_ids = Comment.by_user
+        .where(account_id: user.account_id)
+        .joins(:rich_text_body)
+        .where(body_predicate)
+        .select(:card_id)
+
+      Card.where(title_predicate)
+        .or(Card.where(id: description_card_ids))
+        .or(Card.where(id: comment_card_ids))
+    end
+
+    def like_patterns_for(term)
+      variants = [ term ]
+      variants.concat([ term.downcase, term.upcase, term.capitalize ]) unless term.ascii_only?
+
+      html_variants = variants.flat_map do |variant|
+        [ variant, CGI.escapeHTML(variant), variant.gsub("'", "&apos;") ]
+      end
+
+      html_variants.uniq.map do |variant|
+        "%#{ActiveRecord::Base.sanitize_sql_like(variant)}%"
+      end
+    end
+
+    def filter_verified_card_ids(candidate_rows)
+      candidate_ids = candidate_rows.map(&:first)
+
+      descriptions_by_card_id = ActionText::RichText
+        .where(account_id: user.account_id, record_type: "Card", name: "description", record_id: candidate_ids)
+        .pluck(:record_id, :body)
+        .to_h
+
+      comments_by_card_id = Hash.new { |hash, key| hash[key] = [] }
+      Comment.by_user
+        .where(account_id: user.account_id, card_id: candidate_ids)
+        .joins(:rich_text_body)
+        .pluck(:card_id, Arel.sql("action_text_rich_texts.body"))
+        .each do |card_id, body|
+          comments_by_card_id[card_id] << plain_text(body)
+        end
+
+      candidate_rows.filter_map do |card_id, title|
+        texts = [
+          normalize_whitespace(title.to_s),
+          plain_text(descriptions_by_card_id[card_id]),
+          *comments_by_card_id[card_id]
+        ]
+
+        card_id if matches_all_terms?(texts)
+      end
+    end
+
+    def select_representative_comments(card, entries)
+      selected = []
+      title_text = normalize_whitespace(card.title.to_s)
+      description_text = plain_text(card.description)
+      covered_terms = terms.select do |term|
+        term_matches_text?(term, title_text) || term_matches_text?(term, description_text)
+      end
+
+      entries.each do |comment, text|
+        if selected.empty? || (terms - covered_terms).any? { |term| term_matches_text?(term, text) }
+          selected << comment
+          covered_terms |= terms.select { |term| term_matches_text?(term, text) }
+        end
+
+        break if selected.size >= MAX_MATCHING_COMMENTS_PER_CARD && covered_terms.size >= terms.size
+      end
+
+      selected.first(MAX_MATCHING_COMMENTS_PER_CARD)
+    end
+
+    def matches_all_terms?(texts)
+      terms.all? do |term|
+        texts.any? { |text| term_matches_text?(term, text) }
+      end
+    end
+
+    def matches_any_term?(text)
+      return false if text.blank?
+
+      highlight_terms.any? { |term| term_matches_text?(term, text) }
+    end
+
+    def term_matches_text?(term, text)
+      return false if text.blank?
+
+      text.match?(term_regex(term))
+    end
+
+    def term_regex(term)
+      @term_regexes ||= {}
+      @term_regexes[term] ||= /#{Regexp.escape(term)}/i
+    end
+
+    def plain_text(value)
+      raw = if value.blank?
+        ""
+      elsif value.respond_to?(:to_plain_text)
+        value.to_plain_text
+      else
+        ActionText::Content.new(value.to_s).to_plain_text
+      end
+
+      normalize_whitespace(raw)
+    end
+
+    def normalize_whitespace(string)
+      string.gsub(/[[:space:]]+/, " ").strip
+    end
+end
