+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlight_search_terms wraps matched words in mark preserving case" do
+    assert_equal "The <mark>logo</mark> isn&#39;t <mark>BIG</mark> enough",
+      highlight_search_terms("The logo isn't BIG enough", [ "logo", "big" ])
+  end
+
+  test "highlight_search_terms wraps whole matched word excluding trailing punctuation" do
+    assert_equal "The text is <mark>overflowing</mark> the <mark>container</mark>.",
+      highlight_search_terms("The text is overflowing the container.", [ "overflow", "container" ])
+  end
+
+  test "highlight_search_terms escapes HTML in text and query safely" do
+    result = highlight_search_terms("<script>alert(1)</script> urgent <img src=x onerror=alert(1)>", [ "urgent", "script" ])
+    assert_equal "&lt;<mark>script</mark>&gt;alert(1)&lt;/<mark>script</mark>&gt; <mark>urgent</mark> &lt;img src=x onerror=alert(1)&gt;", result
+  end
+
+  test "search_excerpt centers around matches in long text and wraps matched words in mark" do
+    long_text = "#{"filler words " * 30}critical needle located here#{" more words" * 30}"
+    excerpt = search_excerpt(long_text, [ "needle" ], radius: 40)
+
+    assert_includes excerpt, "<mark>needle</mark>"
+    assert excerpt.start_with?("…")
+    assert excerpt.end_with?("…")
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..249bbb6
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,177 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @user = users(:david)
+    @board = boards(:writebook)
+  end
+
+  test "returns none for blank or non-string queries" do
+    assert_empty @user.search(nil).cards
+    assert_empty @user.search("").cards
+    assert_empty @user.search("   ").cards
+    assert_empty @user.search([ "logo" ]).cards
+  end
+
+  test "finds cards by title, description, or comment body" do
+    title_card = @board.cards.create!(title: "Zeppelin deployment", status: :published)
+    desc_card = @board.cards.create!(title: "Server setup", description: "<p>Deploy via <strong>zeppelin</strong> pipeline</p>", status: :published)
+    comment_card = @board.cards.create!(title: "Release checklist", status: :published)
+    comment_card.comments.create!(body: "<p>Verified zeppelin rollout</p>", creator: users(:kevin))
+
+    results = @user.search("zeppelin").cards.to_a
+    assert_equal [ comment_card, desc_card, title_card ], results
+  end
+
+  test "orders results newest first regardless of last_active_at" do
+    older_card = travel_to(3.days.ago) do
+      @board.cards.create!(title: "Quartz scheduler", status: :published)
+    end
+    newer_card = travel_to(1.day.ago) do
+      @board.cards.create!(title: "Quartz worker", status: :published)
+    end
+
+    # Touch older_card's last_active_at to be more recent than newer_card
+    older_card.comments.create!(body: "Bumping quartz activity", creator: users(:kevin))
+    assert_operator older_card.reload.last_active_at, :>, newer_card.reload.last_active_at
+
+    assert_equal [ newer_card, older_card ], @user.search("quartz").cards.to_a
+  end
+
+  test "deduplicates cards matching across title, description, and multiple comments" do
+    card = @board.cards.create!(title: "Nebula crash", description: "Nebula fails on boot", status: :published)
+    card.comments.create!(body: "First nebula log", creator: @user)
+    card.comments.create!(body: "Second nebula log", creator: users(:kevin))
+
+    assert_equal [ card ], @user.search("nebula").cards.to_a
+  end
+
+  test "multi-word query requires all terms across card fields" do
+    both_in_card = @board.cards.create!(title: "grineer galleon", status: :published)
+    split_across_fields = @board.cards.create!(title: "grineer outpost", status: :published)
+    split_across_fields.comments.create!(body: "Docked the galleon", creator: users(:kevin))
+    only_one_term = @board.cards.create!(title: "grineer patrol", status: :published)
+
+    results = @user.search("grineer galleon").cards.to_a
+    assert_includes results, both_in_card
+    assert_includes results, split_across_fields
+    assert_not_includes results, only_one_term
+  end
+
+  test "does not match HTML tags, attributes, or entity names in rich text" do
+    card = @board.cards.create!(
+      title: "Plain heading",
+      description: "<div class=\"custom-wrapper\"><p><strong>Bold</strong> &amp; <em>italic</em></p></div>",
+      status: :published
+    )
+
+    assert_not_includes @user.search("custom-wrapper").cards, card
+    assert_not_includes @user.search("strong").cards, card
+    assert_not_includes @user.search("amp").cards, card
+    assert_includes @user.search("Bold & italic").cards, card
+  end
+
+  test "handles SQL wildcard and regex special characters literally" do
+    percent_card = @board.cards.create!(title: "CPU at 100% usage", status: :published)
+    other_card = @board.cards.create!(title: "CPU at 1000 usage", status: :published)
+    underscore_card = @board.cards.create!(title: "Check external_account_id column", status: :published)
+    non_underscore_card = @board.cards.create!(title: "Check externalXaccountXid column", status: :published)
+    regex_card = @board.cards.create!(title: "Upgrade C++ (v2.0) [urgent]", status: :published)
+
+    assert_equal [ percent_card ], @user.search("100%").cards.to_a
+    assert_not_includes @user.search("100%").cards, other_card
+
+    assert_equal [ underscore_card ], @user.search("external_account_id").cards.to_a
+    assert_not_includes @user.search("external_account_id").cards, non_underscore_card
+
+    assert_equal [ regex_card ], @user.search("C++").cards.to_a
+    assert_equal [ regex_card ], @user.search("(v2.0)").cards.to_a
+    assert_equal [ regex_card ], @user.search("[urgent]").cards.to_a
+  end
+
+  test "handles Unicode case-insensitivity" do
+    card = @board.cards.create!(title: "Visit Café Éclair", status: :published)
+
+    assert_includes @user.search("café").cards, card
+    assert_includes @user.search("ÉCLAIR").cards, card
+  end
+
+  test "respects current board access when granted, revoked, or card moved" do
+    private_board = boards(:private)
+    private_card = Current.set(session: sessions(:kevin)) do
+      private_board.cards.create!(title: "Classified falcon project", status: :published)
+    end
+
+    assert_not_includes @user.search("falcon").cards, private_card
+    assert_includes users(:kevin).search("falcon").cards, private_card
+
+    # Grant access -> immediately visible
+    private_board.accesses.grant_to(@user)
+    assert_includes @user.search("falcon").cards, private_card
+
+    # Revoke access -> immediately hidden
+    private_board.accesses.revoke_from(@user)
+    assert_not_includes @user.search("falcon").cards, private_card
+
+    # Card created by david on accessible board, then moved to inaccessible board -> hidden from david
+    moved_card = @board.cards.create!(title: " Peregrine migration", status: :published)
+    moved_card.comments.create!(body: "Peregrine details", creator: @user)
+    assert_includes @user.search("Peregrine").cards, moved_card
+
+    Current.set(session: sessions(:kevin)) do
+      moved_card.move_to(private_board)
+    end
+    assert_not_includes @user.search("Peregrine").cards, moved_card
+  end
+
+  test "isolates accounts completely" do
+    # "paycheck" and "radio" belong to initech account
+    assert_empty @user.search("paycheck").cards
+    assert_empty @user.search("radio").cards
+
+    Current.with_account(accounts(:initech)) do
+      assert_equal [ cards(:paycheck) ], users(:mike).search("paycheck").cards.to_a
+    end
+  end
+
+  test "excludes draft cards and their comments until published" do
+    draft = @board.cards.create!(
+      title: "Drafted phoenix concept",
+      description: "Phoenix description in draft",
+      status: :drafted
+    )
+    comment_on_draft = Comment.new(account: draft.account, card: draft, creator: @user)
+    comment_on_draft.save!(validate: false)
+    ActionText::RichText.create!(account: draft.account, record: comment_on_draft, name: "body", body: "Phoenix comment on draft")
+
+    assert_empty @user.search("phoenix").cards
+
+    draft.publish
+    assert_equal [ draft ], @user.search("phoenix").cards.to_a
+  end
+
+  test "includes closed and postponed published cards" do
+    closed_card = @board.cards.create!(title: "Closed glacier ticket", status: :published)
+    closed_card.close
+
+    postponed_card = @board.cards.create!(title: "Postponed glacier ticket", status: :published)
+    postponed_card.postpone
+
+    results = @user.search("glacier").cards.to_a
+    assert_includes results, closed_card
+    assert_includes results, postponed_card
+  end
+
+  test "excludes system audit comments so renamed titles do not falsely match old title" do
+    card = @board.cards.create!(title: "Original caterpillar title", status: :published)
+    assert_includes @user.search("caterpillar").cards, card
+
+    card.update!(title: "Updated butterfly title")
+    # SystemCommenter created a comment containing "Original caterpillar title"
+    assert card.comments.by_system.exists?
+
+    assert_not_includes @user.search("caterpillar").cards, card
+    assert_includes @user.search("butterfly").cards, card
+  end
+end
