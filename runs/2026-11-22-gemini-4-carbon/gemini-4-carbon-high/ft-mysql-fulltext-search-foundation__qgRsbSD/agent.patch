diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..3b50868
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,145 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path(q: "logo")
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "search page renders without query or with blank query" do
+    get search_path
+    assert_response :success
+    assert_select "form[action='#{search_path}'][method='get'] input[name='q']"
+    assert_select "mark", count: 0
+
+    get search_path(q: "   ")
+    assert_response :success
+    assert_select "mark", count: 0
+  end
+
+  test "finds cards by title, description, or comment body newest first with matched words wrapped in mark" do
+    board = boards(:writebook)
+    card_by_title = nil
+    card_by_description = nil
+    card_by_comment = nil
+
+    with_current_user(:david) do
+      card_by_title = travel_to(3.minutes.ago) do
+        board.cards.create!(title: "Investigate caching bottleneck", creator: users(:david), status: :published)
+      end
+      card_by_description = travel_to(2.minutes.ago) do
+        board.cards.create!(title: "Slow dashboard", description: "The caching layer is stale", creator: users(:david), status: :published)
+      end
+      card_by_comment = travel_to(1.minute.ago) do
+        board.cards.create!(title: "API latency", creator: users(:david), status: :published).tap do |card|
+          card.comments.create!(body: "Confirmed caching issue in production", creator: users(:kevin))
+        end
+      end
+    end
+
+    get search_path(q: "caching")
+    assert_response :success
+
+    assert_select "##{dom_id(card_by_title)} h3 a[href='#{card_path(card_by_title)}'] mark", text: "caching"
+    assert_select "##{dom_id(card_by_description)} .search-result__excerpt mark", text: "caching"
+    assert_select "##{dom_id(card_by_comment)} .search-result__comment mark", text: "caching"
+
+    positions = [ card_by_comment, card_by_description, card_by_title ].map do |card|
+      response.body.index(card_path(card))
+    end
+    assert positions.all?(&:present?), "Expected all three matching cards to appear in search results"
+    assert_equal positions.sort, positions, "Expected results ordered newest first"
+  end
+
+  test "case-insensitive search wraps original word case in mark" do
+    get search_path(q: "LAYOUT")
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:layout))} mark", text: "Layout"
+  end
+
+  test "finds fixture comments and wraps matched words in mark" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:layout))} mark", text: "overflowing"
+  end
+
+  test "only shows results from boards the user currently has access to" do
+    private_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(
+        title: "Top secret roadmap",
+        description: "Confidential acquisition target",
+        creator: users(:kevin),
+        status: :published
+      )
+    end
+
+    get search_path(q: "Confidential")
+    assert_response :success
+    assert_select "a[href='#{card_path(private_card)}']", count: 0
+    assert_no_match(/Top secret roadmap/, response.body)
+
+    boards(:private).accesses.grant_to(users(:david))
+    get search_path(q: "Confidential")
+    assert_response :success
+    assert_select "a[href='#{card_path(private_card)}']", count: 1
+    assert_select "mark", text: "Confidential"
+
+    boards(:private).accesses.revoke_from(users(:david))
+    get search_path(q: "Confidential")
+    assert_response :success
+    assert_select "a[href='#{card_path(private_card)}']", count: 0
+  end
+
+  test "draft cards and their comments never turn up" do
+    draft = with_current_user(:david) do
+      boards(:writebook).cards.create!(
+        title: "Unpublished unicorn idea",
+        description: "Draft unicorn description",
+        creator: users(:david),
+        status: :published
+      ).tap do |card|
+        card.comments.create!(body: "Draft unicorn comment", creator: users(:david))
+        card.update_columns(status: "drafted")
+      end
+    end
+
+    get search_path(q: "unicorn")
+    assert_response :success
+    assert_select "a[href='#{card_path(draft)}']", count: 0
+    assert_select "mark", count: 0
+  end
+
+  test "escapes untrusted HTML while wrapping matched words in mark" do
+    xss_card = with_current_user(:david) do
+      boards(:writebook).cards.create!(
+        title: "<script>alert('title')</script> volcano",
+        description: "Safe volcano text",
+        creator: users(:david),
+        status: :published
+      )
+    end
+
+    get search_path(q: "volcano")
+    assert_response :success
+    assert_select "##{dom_id(xss_card)} mark", text: "volcano"
+    assert_select "script", text: /alert\('title'\)/, count: 0
+  end
+
+  test "handles non-string q parameter gracefully" do
+    get search_path, params: { q: [ "logo" ] }
+    assert_response :success
+  end
+
+  test "supports JSON format" do
+    get search_path(q: "overflowing", format: :json)
+    assert_response :success
+    assert_equal [ cards(:layout).number ], response.parsed_body.pluck("number")
+  end
+end
