@@ -0,0 +1,52 @@
+require "application_system_test_case"
+
+class SearchSystemTest < ApplicationSystemTestCase
+  test "searching cards by title, description, and comment body" do
+    sign_in_as(users(:david))
+
+    Current.set(account: accounts("37s"), session: sessions(:david)) do
+      travel_to(2.minutes.ago) do
+        boards(:writebook).cards.create!(
+          title: "Refactor search indexing",
+          description: "Improve query latency",
+          creator: users(:david),
+          status: :published
+        )
+      end
+
+      travel_to(1.minute.ago) do
+        card = boards(:writebook).cards.create!(
+          title: "Database maintenance",
+          creator: users(:david),
+          status: :published
+        )
+        card.comments.create!(body: "Needs indexing review", creator: users(:kevin))
+      end
+
+      boards(:private).cards.create!(
+        title: "Secret indexing plan",
+        creator: users(:kevin),
+        status: :published
+      )
+
+      boards(:writebook).cards.create!(
+        title: "Draft indexing notes",
+        creator: users(:david),
+        status: :drafted
+      )
+    end
+
+    visit search_url(q: "indexing")
+
+    assert_selector ".search-result", count: 2
+    assert_selector ".search-result mark", text: "indexing", count: 2
+    assert_no_text "Secret indexing plan"
+    assert_no_text "Draft indexing notes"
+
+    titles = all(".search-result__title").map(&:text)
+    assert_equal [ "Database maintenance", "Refactor search indexing" ], titles
+
+    click_on "Database maintenance"
+    assert_selector "h1", text: "Database maintenance"
+  end
+end
