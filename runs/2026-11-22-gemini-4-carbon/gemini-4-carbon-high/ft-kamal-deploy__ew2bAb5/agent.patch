@@ -80,6 +80,32 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  app_host = (ENV["APP_HOST"].presence || ENV["APP_FQDN"].presence || ENV["KAMAL_HOST"].presence)&.sub(/\Ahttps?:\/\//, "")&.chomp("/")
+
+  if app_host.present? && config.action_mailer.default_url_options.blank?
+    url_options = { host: app_host, protocol: (config.assume_ssl || config.force_ssl) ? "https" : "http" }
+    config.action_controller.default_url_options = url_options
+    config.action_mailer.default_url_options = url_options
+    routes.default_url_options.merge!(url_options)
+  end
+
+  if ENV["SMTP_ADDRESS"].present? && config.action_mailer.smtp_settings.blank?
+    smtp_tls = ENV["SMTP_TLS"] == "true" || ENV["SMTP_SSL"] == "true"
+
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = {
+      address: ENV["SMTP_ADDRESS"],
+      port: ENV.fetch("SMTP_PORT", 587).to_i,
+      domain: ENV["SMTP_DOMAIN"].presence || app_host,
+      user_name: ENV["SMTP_USERNAME"].presence,
+      password: ENV["SMTP_PASSWORD"].presence,
+      authentication: ENV["SMTP_AUTHENTICATION"].presence&.to_sym,
+      enable_starttls_auto: smtp_tls ? false : ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true",
+      tls: smtp_tls || nil,
+      openssl_verify_mode: ENV["SMTP_OPENSSL_VERIFY_MODE"].presence
+    }.compact
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
