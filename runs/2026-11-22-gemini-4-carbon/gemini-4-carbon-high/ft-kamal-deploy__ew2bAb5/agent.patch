new file mode 100644
index 0000000..19648e2
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,81 @@
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image (use your-user/app-name on external registries).
+image: fizzy
+
+# Deploy to your server.
+servers:
+  web:
+    - fizzy.example.com
+
+# Enable SSL auto certification via Let's Encrypt.
+# Note: If using Cloudflare, set encryption mode in SSL/TLS setting to "Full" to enable CF-to-app encryption.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Where you keep your container images.
+# Defaults to a local registry forwarded over SSH, so no external registry account is needed.
+registry:
+  server: localhost:5555
+  # Alternatives: ghcr.io / hub.docker.com / registry.digitalocean.com / ...
+  # username: your-user
+  # password:
+  #   - KAMAL_REGISTRY_PASSWORD
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    # Run the Solid Queue Supervisor inside the web server's Puma process to do jobs.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Your public hostname (used for links in emails, notifications, and exports).
+    APP_HOST: fizzy.example.com
+
+    # Outgoing mail server (SMTP).
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    # SMTP_DOMAIN: example.com
+    # SMTP_AUTHENTICATION: plain
+    # SMTP_ENABLE_STARTTLS_AUTO: true
+    # SMTP_TLS: false
+
+    # Allow multiple accounts to sign up on this instance (defaults to single-account).
+    # MULTI_TENANT: false
+
+    # Tune web and background job worker processes for your server size.
+    # WEB_CONCURRENCY: 2
+    # JOB_CONCURRENCY: 1
+  secret:
+    - SECRET_KEY_BASE
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+# Aliases are triggered with "bin/kamal <alias>".
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
+
+# Use a persistent storage volume for SQLite database files and local Active Storage files.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests. Combines all files from new and old
+# version inside the asset_path.
+asset_path: /rails/public/assets
+
+# Configure the image builder.
+builder:
+  arch: amd64
+  # arch: arm64
+
+# Use a different ssh user than root
+# ssh:
+#   user: app
