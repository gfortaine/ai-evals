diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..21b7c47
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "publish and unpublish" do
+    assert_not @board.published?
+    assert_nil @board.public_key
+
+    publication = @board.publish
+    assert @board.published?
+    assert publication.key.present?
+    assert_equal publication.key, @board.public_key
+
+    assert_equal publication, @board.publish
+
+    @board.unpublish
+    assert_not @board.published?
+    assert_nil @board.public_key
+    assert_not Board::Publication.exists?(publication.id)
+  end
+
+  test "republishing generates a new key" do
+    old_key = @board.publish.key
+    @board.unpublish
+
+    new_key = @board.publish.key
+    assert_not_equal old_key, new_key
+  end
+
+  test "find_by_published_key" do
+    @board.publish
+
+    assert_equal @board, Board.find_by_published_key(@board.public_key)
+
+    assert_raises(ActiveRecord::RecordNotFound) do
+      Board.find_by_published_key("nonexistent-key")
+    end
+
+    Current.with_account(accounts(:initech)) do
+      assert_raises(ActiveRecord::RecordNotFound) do
+        Board.find_by_published_key(@board.public_key)
+      end
+    end
+  end
+
+  test "publicly_accessible? for board, card, and comment" do
+    published_card = cards(:logo)
+    drafted_card = @board.cards.create!(creator: users(:david), status: :drafted, title: "Draft card")
+    comment = published_card.comments.first
+
