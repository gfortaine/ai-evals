diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..8220c9e
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,38 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy
+
+    scope :published, -> { joins(:publication) }
+  end
+
+  class_methods do
+    def find_by_published_key(key)
+      scope = published.where(board_publications: { key: key })
+      scope = scope.where(account: Current.account) if Current.account.present?
+      scope.first!
+    end
+  end
+
+  def published?
+    publication.present? && !publication.destroyed?
+  end
+
+  def publish
+    publication || create_publication!
+  end
+
+  def unpublish
+    publication&.destroy
+    association(:publication).reset
+  end
+
+  def public_key
+    publication&.key if published?
+  end
+
+  def publicly_accessible?
+    published?
+  end
+end
