@@ -0,0 +1,126 @@
+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @card = cards(:logo)
+  end
+
+  test "show published card of published board without authentication" do
+    get public_board_card_path(@board.public_key, @card)
+
+    assert_response :success
+    assert_select "h1", text: @card.title
+    assert_in_body @board.name
+  end
+
+  test "show published card with steps, tags, assignees, reactions, comments, and closure" do
+    Current.set(user: users(:kevin)) do
+      @card.steps.create!(content: "First step", completed: true)
+      @card.steps.create!(content: "Second step", completed: false)
+      @card.toggle_tag_with("urgent")
+      @card.toggle_assignment(users(:kevin))
+      @card.reactions.create!(reacter: users(:kevin), content: "👍")
+      comment = @card.comments.create!(creator: users(:david), body: "Looks great!")
+      comment.reactions.create!(reacter: users(:kevin), content: "🎉")
+      @card.gild
+      @card.close(user: users(:kevin))
+    end
+
+    get public_board_card_path(@board.public_key, @card)
+
+    assert_response :success
+    assert_select "h1", text: @card.title
+    assert_in_body "First step"
+    assert_in_body "Second step"
+    assert_in_body "urgent"
+    assert_in_body "Looks great!"
+    assert_in_body "👍"
+    assert_in_body "🎉"
+    assert_in_body "Done"
+    assert_select "form[action*='comments']", count: 0
+    assert_select "a[href='#{edit_card_path(@card)}']", count: 0
+  end
+
+  test "show postponed card of published board" do
+    Current.set(user: users(:kevin)) do
+      @card.postpone(user: users(:kevin))
+    end
+
+    get public_board_card_path(@board.public_key, @card)
+
+    assert_response :success
+    assert_in_body "Not Now"
+  end
+
+  test "signed-in user without board access or from another account can view public card" do
+    private_board = boards(:private)
+    private_card = Current.set(user: users(:kevin)) do
+      private_board.cards.create!(creator: users(:kevin), status: :published, title: "Shared milestone")
+    end
+    private_board.publish
+
+    sign_in_as :jz
+    get public_board_card_path(private_board.public_key, private_card)
+    assert_response :success
+    assert_select "h1", text: "Shared milestone"
+
+    logout_and_sign_in_as :mike
+    get public_board_card_path(private_board.public_key, private_card)
+    assert_response :success
+    assert_select "h1", text: "Shared milestone"
+  end
+
+  test "drafted card of published board returns not found" do
+    draft_card = @board.cards.create!(creator: users(:david), status: :drafted, title: "Secret draft")
+
+    get public_board_card_path(@board.public_key, draft_card)
+
+    assert_response :not_found
+  end
+
+  test "card from another board returns not found" do
+    other_board = boards(:private)
+    other_card = Current.set(user: users(:kevin)) do
+      other_board.cards.create!(creator: users(:kevin), status: :published, title: "Private card")
+    end
+
+    get public_board_card_path(@board.public_key, other_card)
+
+    assert_response :not_found
+  end
+
+  test "card of unpublished board returns not found" do
+    key = @board.public_key
+    @board.unpublish
+
+    get public_board_card_path(key, @card)
+
+    assert_response :not_found
+  end
+
+  test "card image and rich text embeds are publicly accessible only when card and board are published" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "embed.jpg",
+      content_type: "image/jpeg"
+    )
+    @card.update!(description: "<action-text-attachment sgid=\"#{embed_blob.attachable_plain_text_representation}\"></action-text-attachment>")
+
+    get rails_blob_path(@card.image, disposition: "inline")
+    assert_response :redirect
+
+    get rails_blob_path(embed_blob, disposition: "inline")
+    assert_response :redirect
+
+    @board.unpublish
+
+    get rails_blob_path(@card.image, disposition: "inline")
+    assert_redirected_to new_session_path(script_name: nil)
+
+    get rails_blob_path(embed_blob, disposition: "inline")
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+end
