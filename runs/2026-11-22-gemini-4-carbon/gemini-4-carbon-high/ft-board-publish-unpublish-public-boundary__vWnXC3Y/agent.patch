+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "publish board as HTML" do
+    assert_difference -> { Board::Publication.count }, 1 do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+  end
+
+  test "publish board as turbo stream" do
+    assert_difference -> { Board::Publication.count }, 1 do
+      post board_publication_path(@board, format: :turbo_stream)
+    end
+
+    assert_response :success
+    assert @board.reload.published?
+    assert_turbo_stream action: :replace, target: dom_id(@board, :publication)
+  end
+
+  test "publish board as JSON" do
+    assert_difference -> { Board::Publication.count }, 1 do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    assert @board.reload.published?
+    assert_equal public_board_url(@board.public_key), @response.parsed_body["public_url"]
+  end
+
+  test "unpublish board as HTML" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "unpublish board as turbo stream" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board, format: :turbo_stream)
+    end
+
+    assert_response :success
+    assert_not @board.reload.published?
+    assert_turbo_stream action: :replace, target: dom_id(@board, :publication)
+  end
+
+  test "unpublish board as JSON" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "owner can publish and unpublish board" do
+    @board.accesses.grant_to(users(:jason))
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    assert @board.reload.published?
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin member cannot publish or unpublish board" do
+    logout_and_sign_in_as :jz
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board)
+    end
+    assert_response :forbidden
+
+    @board.publish
+
+    assert_no_difference -> { Board::Publication.count } do
+      delete board_publication_path(@board)
+    end
+    assert_response :forbidden
+  end
+
+  test "non-admin board creator cannot publish or unpublish board" do
+    logout_and_sign_in_as :david
+    assert_equal users(:david), @board.creator
+    assert_not users(:david).admin?
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board), as: :json
+    end
+    assert_response :forbidden
+
+    @board.publish
+
+    assert_no_difference -> { Board::Publication.count } do
+      delete board_publication_path(@board), as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "admin without access to board gets not found" do
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(boards(:private)), as: :json
+    assert_response :not_found
+  end
+end
