+  test "board updates instantly on drop without waiting on the save and nothing shifts afterwards" do
+    triage = columns(:writebook_triage)
+    logo = cards(:logo)
+    layout = cards(:layout)
+    buy_domain = cards(:buy_domain)
+
+    visit board_url(@board)
+    expand_column("##{dom_id(triage)}")
+
+    # Hold the save request in flight until we explicitly release it
+    execute_script <<~JS
+      window.__saveGate = new Promise(resolve => { window.__releaseSave = resolve; });
+window.__saveCompleted = false;
+const origFetch = window.fetch;
+window.fetch = async function(url, options = {}) {
+  if (options.method && options.method.toUpperCase() !== "GET" && String(url).includes("/cards/")) {
+    await window.__saveGate;
+    const response = await origFetch.call(this, url, options);
+    window.__saveCompleted = true;
+    return response;
+  }
+  return origFetch.call(this, url, options);
+};
+    JS
+
+    drag_card(buy_domain, to: "##{dom_id(triage)}")
+
+    # Save has NOT reached the server yet
+    assert_nil buy_domain.reload.column
+
+    # Yet the DOM is ALREADY in its final state
+    expected_order = [ dom_id(logo, :article), dom_id(buy_domain, :article), dom_id(layout, :article) ]
+    assert_equal expected_order, card_ids_in("##{dom_id(triage)}")
+    assert_equal "3", column_count("##{dom_id(triage)}")
+    assert_equal "0", column_count("#maybe")
+    assert_no_selector ".drag-and-drop__dragged-item"
+    assert_no_selector ".drag-and-drop__hover-container"
+
+    rect_before_save = evaluate_script("document.querySelector('.card-columns ##{dom_id(buy_domain, :article)}').getBoundingClientRect().toJSON()")
+
+    # Release the save and wait for completion
+    execute_script("window.__releaseSave()")
+    assert_eventually -> { evaluate_script("window.__saveCompleted") == true }
+    assert_equal triage, buy_domain.reload.column
+    sleep 0.2
+
+    # Nothing shifted afterwards
+    assert_equal expected_order, card_ids_in("##{dom_id(triage)}")
+    rect_after_save = evaluate_script("document.querySelector('.card-columns ##{dom_id(buy_domain, :article)}').getBoundingClientRect().toJSON()")
+    assert_equal rect_before_save["top"], rect_after_save["top"]
+    assert_equal rect_before_save["left"], rect_after_save["left"]
+  end
