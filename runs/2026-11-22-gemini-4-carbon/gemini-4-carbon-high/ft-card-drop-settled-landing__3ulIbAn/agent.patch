+test "cards remain draggable after a broadcast morph" do
+  card = cards(:buy_domain)
+  target_column = columns(:writebook_in_progress)
+
+  visit board_url(@board)
+  assert_selector "turbo-cable-stream-source[connected]", visible: :all
+
+  Current.set(account: accounts("37s"), user: users(:david)) do
+    card.update!(title: "Updated title before drag")
+  end
+  perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+  within("#maybe") do
+    assert_selector "##{dom_id(card, :article)}", text: "Updated title before drag", wait: 5
+  end
+
+  expand_column("##{dom_id(target_column)}")
+  drag_card(card, to: "##{dom_id(target_column)}")
+
+  within("##{dom_id(target_column)}") do
+    assert_selector "##{dom_id(card, :article)}", text: "Updated title before drag"
+  end
+  assert_eventually -> { card.reload.column == target_column }
+end
+
+private
+    def expand_column(selector)
+      find("#{selector} .cards__expander").click if has_selector?("#{selector}.is-collapsed", wait: 0)
+      assert_selector "#{selector}.is-expanded"
+      assert_selector "#{selector} .cards__list"
+    end
+
+    def drag_card(card, to:)
+      within(".card-columns") do
+        find("##{dom_id(card, :article)}").drag_to(find(to))
+      end
+    end
+
+    def column_count(selector)
+      find("#{selector} .cards__expander-count", visible: :all).text(:all)
+    end
+
+    def card_ids_in(selector)
+      evaluate_script("Array.from(document.querySelectorAll('#{selector} .cards__list article.card')).map(el => el.id)")
+    end
+
+    def assert_eventually(condition, timeout: 5)
+      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
+      until condition.call
+        raise Minitest::Assertion, "Condition not met within #{timeout}s" if Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
+        sleep 0.05
+      end
+    end
+end
