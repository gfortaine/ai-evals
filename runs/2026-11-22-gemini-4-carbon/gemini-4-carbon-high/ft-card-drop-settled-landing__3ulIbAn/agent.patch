diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..8444446
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,320 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+import { Turbo } from "@hotwired/turbo-rails"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "container", "item" ]
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  #draggedItem = null
+  #sourceContainer = null
+  #currentContainer = null
+  #justDragged = false
+  #suppressClickTimer = null
+  #saveChain = Promise.resolve()
+
+  connect() {
+    this.mediaQuery = window.matchMedia(this.desktopBreakpointValue)
+    this.mediaQuery.addEventListener("change", this.#handleViewportChange)
+    this.element.addEventListener("click", this.#preventClickAfterDrag, true)
+    this.#updateDraggableItems()
+  }
+
+  disconnect() {
+    clearTimeout(this.#suppressClickTimer)
+    this.mediaQuery?.removeEventListener("change", this.#handleViewportChange)
+    this.element.removeEventListener("click", this.#preventClickAfterDrag, true)
+    this.#reset()
+    this.itemTargets.forEach(item => this.#setItemDraggable(item, false))
+  }
+
+  itemTargetConnected(item) {
+    this.#setItemDraggable(item, this.#isDesktop)
+  }
+
+  itemTargetDisconnected(item) {
+    if (!this.element.contains(item)) {
+      item.draggable = false
+    }
+  }
+
+  // Actions
+
+  dragStart(event) {
+    if (!this.#isDesktop) {
+      event.preventDefault()
+      return
+    }
+
+    const item = this.#itemFor(event.target)
+    if (!item) return
+
+    this.#draggedItem = item
+    this.#sourceContainer = this.#containerFor(item)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.dataset.id || item.id)
+    }
+
+    item.classList.add(this.#draggedItemClassName)
+  }
+
+  dragOver(event) {
+    if (!this.#draggedItem) return
+
+    event.preventDefault()
+
+    const container = this.#containerFor(event.target)
+    if (container && container !== this.#sourceContainer) {
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+      this.#setHoverContainer(container)
+    } else {
+      this.#clearHoverContainer()
+    }
+  }
+
+  dragLeave(event) {
+    if (!this.#draggedItem || !this.#currentContainer) return
+
+    if (!this.#currentContainer.contains(event.relatedTarget)) {
+      this.#clearHoverContainer()
+    }
+  }
+
+  drop(event) {
+    if (!this.#draggedItem) return
+
+    event.preventDefault()
+
+    const item = this.#draggedItem
+    const sourceContainer = this.#sourceContainer
+    const targetContainer = this.#containerFor(event.target)
+
+    this.#suppressClickAfterDrag()
+    this.#reset()
+
+    if (!targetContainer || targetContainer === sourceContainer) return
+
+    const hadLoadedList = this.#moveItem(item, sourceContainer, targetContainer)
+    this.#enqueueSave(() => this.#saveMove(item, targetContainer, hadLoadedList))
+  }
+
+  dragEnd() {
+    this.#suppressClickAfterDrag()
+    this.#reset()
+  }
+
+  preserveDraggable(event) {
+    if (event.detail.attributeName === "draggable") {
+      event.preventDefault()
+    }
+  }
+
+  refreshDraggable() {
+    this.#updateDraggableItems()
+  }
+
+  // Private
+
+  #handleViewportChange = () => {
+    if (!this.#isDesktop) this.#reset()
+    this.#updateDraggableItems()
+  }
+
+#preventClickAfterDrag = (event) => {
+  if (!this.#justDragged) return
+
+  this.#justDragged = false
+  clearTimeout(this.#suppressClickTimer)
+
+  if (this.#itemFor(event.target)) {
+    event.preventDefault()
+    event.stopImmediatePropagation()
+  }
+}
+
+#suppressClickAfterDrag() {
+  this.#justDragged = true
+  clearTimeout(this.#suppressClickTimer)
+  this.#suppressClickTimer = setTimeout(() => this.#justDragged = false, 100)
+}
+
+  get #isDesktop() {
+    return Boolean(this.mediaQuery?.matches)
+  }
+
+  get #draggedItemClassName() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : "drag-and-drop__dragged-item"
+  }
+
+  get #hoverContainerClassName() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : "drag-and-drop__hover-container"
+  }
+
+  #updateDraggableItems() {
+    const enabled = this.#isDesktop
+    this.itemTargets.forEach(item => this.#setItemDraggable(item, enabled))
+  }
+
+  #setItemDraggable(item, draggable) {
+    item.draggable = draggable
+    if (draggable) {
+      item.querySelectorAll("a, img").forEach(element => element.draggable = false)
+    }
+  }
+
+  #itemFor(node) {
+    const element = node instanceof Element ? node : node?.parentElement
+    return element?.closest('[data-drag-and-drop-target~="item"]') ?? null
+  }
+
+  #containerFor(node) {
+    const element = node instanceof Element ? node : node?.parentElement
+    return element?.closest('[data-drag-and-drop-target~="container"]') ?? null
+  }
+
+  #setHoverContainer(container) {
+    if (this.#currentContainer === container) return
+
+    this.#clearHoverContainer()
+    this.#currentContainer = container
+    this.#currentContainer.classList.add(this.#hoverContainerClassName)
+  }
+
+  #clearHoverContainer() {
+    if (!this.#currentContainer) return
+
+    this.#currentContainer.classList.remove(this.#hoverContainerClassName)
+    this.#currentContainer = null
+  }
+
+  #reset() {
+    this.#draggedItem?.classList.remove(this.#draggedItemClassName)
+    this.#clearHoverContainer()
+    this.containerTargets.forEach(container => container.classList.remove(this.#hoverContainerClassName))
+    this.#draggedItem = null
+    this.#sourceContainer = null
+  }
+
+  #moveItem(item, sourceContainer, targetContainer) {
+    this.#updateItemState(item, targetContainer)
+
+    const list = targetContainer.querySelector(".cards__list")
+    if (list) {
+      this.#insertItemIntoList(item, list, targetContainer)
+    } else {
+      item.remove()
+    }
+
+    if (sourceContainer) this.#adjustContainerCount(sourceContainer, -1)
+    this.#adjustContainerCount(targetContainer, 1)
+
+    return Boolean(list)
+  }
+
+  #insertItemIntoList(item, list, targetContainer) {
+    const prependAfterSelector = targetContainer.dataset.dragAndDropPrependAfter
+
+    if (prependAfterSelector && !item.matches(prependAfterSelector)) {
+      const matchingItems = Array.from(list.querySelectorAll('[data-drag-and-drop-target~="item"]'))
+        .filter(element => element.matches(prependAfterSelector))
+      const lastMatchingItem = matchingItems.at(-1)
+
+      if (lastMatchingItem) {
+        lastMatchingItem.after(item)
+        return
+      }
+    }
+
+    const insertionTarget = list.querySelector("turbo-frame") || list
+    insertionTarget.prepend(item)
+  }
+
+  #updateItemState(item, targetContainer) {
+    const status = targetContainer.dataset.dragAndDropCardStatus
+    const cardColor = targetContainer.dataset.dragAndDropCardColor
+
+    item.removeAttribute("aria-selected")
+    item.querySelectorAll(".card__closed").forEach(element => element.remove())
+    item.querySelector(".bubble")?.remove()
+
+    if (cardColor) {
+      item.style.setProperty("--card-color", cardColor)
+    }
+
+    if (status) {
+      const isClosed = status === "closed"
+      item.classList.toggle("card--active", status === "active")
+      item.classList.toggle("card--postponed", status === "postponed")
+      item.querySelector('[id^="assignees_card_"]')?.toggleAttribute("hidden", isClosed)
+      this.#toggleHoverSelectAction(item, !isClosed)
+    }
+
+    const updatedTime = item.querySelector(".card__meta-text--updated time[datetime]")
+    if (updatedTime) {
+      updatedTime.setAttribute("datetime", String(Math.floor(Date.now() / 1000)))
+    }
+  }
+
+  #toggleHoverSelectAction(item, enabled) {
+    const hoverAction = "mouseenter->navigable-list#hoverSelect"
+    const actions = (item.dataset.action || "").split(/\s+/).filter(Boolean)
+    const hasAction = actions.includes(hoverAction)
+
+    if (enabled && !hasAction) {
+      actions.push(hoverAction)
+      item.dataset.action = actions.join(" ")
+    } else if (!enabled && hasAction) {
+      const remaining = actions.filter(action => action !== hoverAction)
+      if (remaining.length > 0) {
+        item.dataset.action = remaining.join(" ")
+      } else {
+        delete item.dataset.action
+      }
+    }
+  }
+
+  #adjustContainerCount(container, delta) {
+    const countElement = container.querySelector(".cards__expander-count")
+    if (countElement) {
+      const currentCount = parseInt(countElement.dataset.count ?? countElement.textContent, 10) || 0
+      const nextCount = Math.max(0, currentCount + delta)
+      countElement.dataset.count = nextCount
+      countElement.textContent = nextCount > 99 ? "99+" : nextCount
+    }
+
+    const expander = container.querySelector(".cards__expander")
+    if (expander) {
+      const items = container.querySelectorAll('[data-css-variable-counter-target~="item"]')
+      const fallbackCount = parseInt(countElement?.dataset.count, 10) || 0
+      const count = items.length || fallbackCount
+      expander.style.setProperty("--card-count", Math.min(count, 15))
+    }
+  }
+
+  #enqueueSave(task) {
+    this.#saveChain = this.#saveChain.then(task, task)
+  }
+
+  async #saveMove(item, targetContainer, hadLoadedList) {
+    const urlTemplate = targetContainer.dataset.dragAndDropUrl
+    const id = item.dataset.id
+    if (!urlTemplate || !id) return
+
+    const url = urlTemplate.replace("__ID__", encodeURIComponent(id))
+    const method = targetContainer.dataset.dragAndDropMethod || "post"
+
+    const request = new FetchRequest(method, url, { responseKind: "json" })
+    const response = await request.perform()
+
+    if (!response.ok) {
+      Turbo.visit(window.location.href, { action: "replace" })
+    } else if (!hadLoadedList) {
+      targetContainer.querySelector("turbo-frame[src]")?.reload()
+    }
+  }
+}
