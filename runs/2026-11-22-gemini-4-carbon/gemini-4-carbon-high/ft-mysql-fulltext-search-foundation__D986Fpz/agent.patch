diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..5fbac84
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,99 @@
+module SearchesHelper
+  EXCERPT_MAX_LENGTH = 240
+  EXCERPT_RADIUS = 80
+  MAX_EXCERPT_WINDOWS = 3
+
+  def search_highlight(text, search)
+    plain = text.to_s
+    return "" if plain.blank?
+    return plain unless search.present?
+
+    parts = []
+    last_index = 0
+
+    plain.scan(search.combined_pattern) do
+      match = Regexp.last_match
+      parts << plain[last_index...match.begin(0)] if match.begin(0) > last_index
+      parts << tag.mark(match[0])
+      last_index = match.end(0)
+    end
+
+    parts << plain[last_index..] if last_index < plain.length
+    safe_join(parts)
+  end
+
+  def search_excerpt(content, search)
+    plain = search.plain_text(content)
+    return nil if plain.blank? || !search.matches?(plain)
+
+    if plain.length <= EXCERPT_MAX_LENGTH
+      search_highlight(plain, search)
+    else
+      windows = extract_excerpt_windows(plain, search)
+      snippets = windows.each_with_index.map do |(start_pos, end_pos), index|
+        parts = []
+        parts << "…" if start_pos > 0 && index == 0
+        parts << search_highlight(plain[start_pos...end_pos], search)
+        parts << "…" if end_pos < plain.length && index == windows.length - 1
+        safe_join(parts)
+      end
+      safe_join(snippets, " … ")
+    end
+  end
+
+  private
+    def extract_excerpt_windows(plain, search)
+      matches = collect_representative_matches(plain, search)
+      raw_windows = matches.map { |m_start, m_end| expand_window(plain, m_start, m_end) }
+      merge_windows(raw_windows)
+    end
+
+    def collect_representative_matches(plain, search)
+      selected = []
+
+      search.term_patterns.each do |pattern|
+        if match = plain.match(pattern)
+          range = [ match.begin(0), match.end(0) ]
+          selected << range unless selected.include?(range)
+        end
+      end
+
+      if selected.length < MAX_EXCERPT_WINDOWS
+        plain.scan(search.combined_pattern) do
+          break if selected.length >= MAX_EXCERPT_WINDOWS
+          match = Regexp.last_match
+          range = [ match.begin(0), match.end(0) ]
+          selected << range unless selected.include?(range)
+        end
+      end
+
+      selected.sort_by(&:first).first(MAX_EXCERPT_WINDOWS)
+    end
+
+    def expand_window(plain, m_start, m_end)
+      win_start = [ m_start - EXCERPT_RADIUS, 0 ].max
+      win_end = [ m_end + EXCERPT_RADIUS, plain.length ].min
+
+      if win_start > 0
+        next_space = plain.index(" ", win_start)
+        win_start = next_space + 1 if next_space && next_space < m_start
+      end
+
+      if win_end < plain.length
+        prev_space = plain.rindex(" ", win_end)
+        win_end = prev_space if prev_space && prev_space > m_end
+      end
+
+      [ win_start, win_end ]
+    end
+
+    def merge_windows(windows)
+      windows.each_with_object([]) do |(win_start, win_end), merged|
+        if merged.any? && win_start <= merged.last[1] + 10
+          merged.last[1] = [ merged.last[1], win_end ].max
+        else
+          merged << [ win_start, win_end ]
+        end
+      end
+    end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..54a5059
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,186 @@
+class Search
+  LIKE_ESCAPE = "!"
+  MAX_MATCHING_COMMENTS = 10
+
+  attr_reader :query, :user
+
+  def initialize(query:, user: Current.user)
+    @query = query.to_s.strip
+    @user = user
+  end
+
+  def present?
+    terms.any?
+  end
+
+  def blank?
+    terms.empty?
+  end
+
+  def terms
+    @terms ||= query.split(/\s+/).reject(&:blank?).uniq
+  end
+
+  def cards
+    @cards ||= if present? && user.present?
+      matching_cards
+    else
+      Card.none
+    end
+  end
+
+  def matches?(content)
+    plain = plain_text(content)
+    plain.present? && plain.match?(combined_pattern)
+  end
+
+  def matching_comments_for(card)
+    user_comments = card.comments
+      .select { |comment| !comment.creator.system? && comment.rich_text_body.present? && matches?(comment.rich_text_body) }
+      .sort_by { |comment| [ comment.created_at, comment.id ] }
+
+    select_representative_comments(user_comments)
+  end
+
+  def plain_text(content)
+    if content.blank?
+      ""
+    elsif content.respond_to?(:body) && content.body.respond_to?(:to_html) && content.body.to_html.include?("</t")
+      ActionText::Content.new(content.body.to_html.gsub(%r{</t[dhr]>}i, "\\0 ")).to_plain_text.gsub(/\s+/, " ").strip
+    elsif content.respond_to?(:to_plain_text)
+      content.to_plain_text.gsub(/\s+/, " ").strip
+    else
+      content.to_s.gsub(/\s+/, " ").strip
+    end
+  end
+
+  def combined_pattern
+    @combined_pattern ||= Regexp.union(terms.sort_by { -it.length }.map { |term| pattern_for(term) })
+  end
+
+  def term_patterns
+    @term_patterns ||= terms.map { |term| pattern_for(term) }
+  end
+
+  private
+    def matching_cards
+      matching_ids = candidate_cards
+        .preload(:rich_text_description, comments: [ :creator, :rich_text_body ])
+        .select { |card| card_matches_all_terms?(card) }
+        .map(&:id)
+
+      if matching_ids.any?
+        accessible_published_cards
+          .where(id: matching_ids)
+          .reverse_chronologically
+          .preloaded
+          .preload(comments: [ :creator, :rich_text_body ])
+      else
+        Card.none
+      end
+    end
+
+    def candidate_cards
+      terms.reduce(accessible_published_cards.reverse_chronologically) do |scope, term|
+        scope.where(sql_condition_for(term))
+      end
+    end
+
+    def accessible_published_cards
+      user.accessible_cards.published
+    end
+
+    def sql_condition_for(term)
+      cards_table = Card.arel_table
+      rich_texts_table = ActionText::RichText.arel_table
+
+      title_match = like_any(cards_table[:title], text_variants_for(term))
+
+      description_match = ActionText::RichText
+        .where(record_type: "Card", name: "description")
+        .where(rich_texts_table[:record_id].eq(cards_table[:id]))
+        .where(like_any(rich_texts_table[:body], html_variants_for(term)))
+        .arel.exists
+
+      comment_match = Comment.by_user
+        .joins(:rich_text_body)
+        .where(Comment.arel_table[:card_id].eq(cards_table[:id]))
+        .where(like_any(rich_texts_table[:body], html_variants_for(term)))
+        .arel.exists
+
+      title_match.or(description_match).or(comment_match)
+    end
+
+    def like_any(column, variants)
+      variants
+        .map { |variant| column.matches("%#{ActiveRecord::Base.sanitize_sql_like(variant, LIKE_ESCAPE)}%", LIKE_ESCAPE) }
+        .reduce(:or)
+    end
+
+    def text_variants_for(term)
+      apostrophe_variants = if term.match?(/['’]/)
+        [ term.tr("’", "'"), term.tr("'", "’") ].uniq
+      else
+        [ term ]
+      end
+
+      apostrophe_variants.flat_map do |variant|
+        if variant.ascii_only?
+          [ variant ]
+        else
+          [ variant, variant.downcase, variant.upcase, variant.capitalize ].uniq
+        end
+      end.uniq
+    end
+
+    def html_variants_for(term)
+      text_variants_for(term).flat_map do |variant|
+        escaped = CGI.escapeHTML(variant)
+        entity_apostrophe = variant.gsub("'", "&#39;")
+        [ variant, escaped, entity_apostrophe ].uniq
+      end.uniq
+    end
+
+    def card_matches_all_terms?(card)
+      searchable_texts = card_searchable_texts(card)
+      term_patterns.all? do |pattern|
+        searchable_texts.any? { |text| text.match?(pattern) }
+      end
+    end
+
+    def card_searchable_texts(card)
+      texts = []
+      texts << plain_text(card.title) if card.title.present?
+      texts << plain_text(card.rich_text_description) if card.rich_text_description.present?
+      card.comments.each do |comment|
+        if !comment.creator.system? && comment.rich_text_body.present?
+          texts << plain_text(comment.rich_text_body)
+        end
+      end
+      texts
+    end
+
+    def select_representative_comments(comments)
+      if comments.length <= MAX_MATCHING_COMMENTS
+        comments
+      else
+        selected = []
+        term_patterns.each do |pattern|
+          match = comments.find { |comment| plain_text(comment.rich_text_body).match?(pattern) }
+          selected << match if match && !selected.include?(match)
+        end
+        comments.each do |comment|
+          break if selected.length >= MAX_MATCHING_COMMENTS
+          selected << comment unless selected.include?(comment)
+        end
+        selected.sort_by { |comment| [ comment.created_at, comment.id ] }
+      end
+    end
+
+    def pattern_for(term)
+      escaped = Regexp.escape(term).gsub(/(?:'|’)/, "['’]")
+      prefix = term.match?(/\A[\p{L}\p{N}]/) ? '(?<![\p{L}\p{N}])' : ""
+      suffix = term.match?(/[\p{L}\p{N}]\z/) ? '[\p{L}\p{N}]*' : ""
+      /#{prefix}#{escaped}#{suffix}/i
+    end
+end
