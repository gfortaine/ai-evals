diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..fcbee73
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,37 @@
+<article id="<%= dom_id(card) %>" class="card search__result" style="--card-color: <%= card.color %>;" data-navigable-list-target="item">
+  <header class="card__header">
+    <div class="card__board">
+      <span class="card__id">
+        <span class="for-screen-reader">Card number</span>
+        <%= card.number %>
+      </span>
+      <span class="card__board-name">
+        <span class="overflow-ellipsis"><%= card.board.name %></span>
+      </span>
+    </div>
+
+    <div class="search__meta overflow-ellipsis flex-item-grow txt-align-end txt-x-small">
+      <span class="card__creator"><%= card.creator.familiar_name %></span>
+      <span class="card__timestamp"><%= local_datetime_tag(card.created_at, style: :timeordate) %></span>
+    </div>
+  </header>
+
+  <div class="search__body flex flex-column gap-half">
+    <h3 class="card__title">
+      <%= link_to(card.title.present? ? search_highlight(card.title, search) : "Untitled", card_path(card), class: "search__result-link", data: { turbo_frame: "_top" }) %>
+    </h3>
+
+    <% if description_excerpt = search_excerpt(card.rich_text_description, search) %>
+      <p class="search__excerpt search__excerpt--description margin-none txt-small"><%= description_excerpt %></p>
+    <% end %>
+
+    <% search.matching_comments_for(card).each do |comment| %>
+      <% if comment_excerpt = search_excerpt(comment.rich_text_body, search) %>
+        <div class="search__excerpt search__excerpt--comment txt-small flex align-start gap-half">
+          <%= icon_tag "comment", class: "search__comment-icon translucent flex-item-no-shrink" %>
+          <p class="margin-none"><strong><%= comment.creator.familiar_name %>:</strong> <%= comment_excerpt %></p>
+        </div>
+      <% end %>
+    <% end %>
+  </div>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..9d89fc8
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,36 @@
+<% @page_title = @search.present? ? "Search: #{@search.query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search center">
+  <%= form_with url: search_path, method: :get, class: "search__form flex align-center gap-half margin-block-end" do |form| %>
+    <%= form.label :q, "Search", class: "for-screen-reader" %>
+    <div class="search__input-container input input--actor flex align-center gap-half full-width">
+      <%= icon_tag "search", class: "search__icon translucent flex-item-no-shrink" %>
+      <%= form.search_field :q, value: @search.query, placeholder: "Search cards…",
+            autofocus: @search.blank?, autocorrect: "off", autocomplete: "off",
+            class: "input" %>
+    </div>
+    <%= form.button type: "submit", name: nil, class: "btn btn--link flex-item-no-shrink" do %>
+      <span>Search</span>
+    <% end %>
+  <% end %>
+
+  <% if @search.present? %>
+    <% if @page.records.any? %>
+      <div class="search__results flex flex-column gap" data-controller="navigable-list" data-action="keydown@document->navigable-list#navigate" data-navigable-list-actionable-items-value="true" data-navigable-list-focus-on-selection-value="false">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { search: @search } %>
+        <% end %>
+      </div>
+    <% else %>
+      <div class="blank-slate">No cards match “<%= @search.query %>”</div>
+    <% end %>
+  <% end %>
+</section>
