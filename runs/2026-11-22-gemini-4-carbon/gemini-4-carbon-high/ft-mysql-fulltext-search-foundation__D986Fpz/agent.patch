+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "wraps matched words in mark preserving case" do
+    search = Search.new(query: "layout broken")
+    assert_equal "<mark>Layout</mark> is <mark>broken</mark>", search_highlight("Layout is broken", search)
+  end
+
+  test "wraps full matched word for prefix queries" do
+    search = Search.new(query: "overflow")
+    assert_equal "The text is <mark>overflowing</mark> the container.", search_highlight("The text is overflowing the container.", search)
+  end
+
+  test "escapes HTML safely and handles searching for mark itself" do
+    search = Search.new(query: "mark bug")
+    result = search_highlight("Use <mark> & <script>alert(1)</script> for bug", search)
+    assert_equal "Use &lt;<mark>mark</mark>&gt; &amp; &lt;script&gt;alert(1)&lt;/script&gt; for <mark>bug</mark>", result
+  end
+
+  test "generates highlighted excerpts for long text covering multiple distant terms" do
+    long_text = "alpha " + ("filler " * 80) + "omega " + ("filler " * 80)
+    search = Search.new(query: "alpha omega")
+    excerpt = search_excerpt(long_text, search)
+
+    assert_includes excerpt, "<mark>alpha</mark>"
+    assert_includes excerpt, "<mark>omega</mark>"
+    assert excerpt.end_with?("…")
+    assert_operator excerpt.length, :<, long_text.length
+  end
+end
