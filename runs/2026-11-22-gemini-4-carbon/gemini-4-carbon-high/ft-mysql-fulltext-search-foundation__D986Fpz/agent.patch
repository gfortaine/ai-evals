+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @user = users(:david)
+    @board = boards(:writebook)
+  end
+
+  test "returns none for blank or nil query" do
+    assert_empty Search.new(query: nil, user: @user).cards
+    assert_empty Search.new(query: "", user: @user).cards
+    assert_empty Search.new(query: "   ", user: @user).cards
+  end
+
+  test "finds cards by title" do
+    results = Search.new(query: "logo", user: @user).cards
+    assert_includes results, cards(:logo)
+    assert_not_includes results, cards(:layout)
+  end
+
+  test "finds cards by description" do
+    card = @board.cards.create!(
+      title: "Homepage",
+      description: "<p>Update the <strong>typographic</strong> hierarchy on landing page</p>",
+      status: :published,
+      creator: @user
+    )
+
+    results = Search.new(query: "typographic", user: @user).cards
+    assert_equal [ card ], results.to_a
+  end
+
+  test "finds cards by table content in description" do
+    card = @board.cards.create!(
+      title: "Quarterly report",
+      description: "<table><tr><td>Revenue</td><td>Forecast</td></tr></table>",
+      status: :published,
+      creator: @user
+    )
+
+    assert_equal [ card ], Search.new(query: "Revenue", user: @user).cards.to_a
+    assert_equal [ card ], Search.new(query: "Forecast", user: @user).cards.to_a
+  end
+
+  test "finds cards by the body of any comment on them" do
+    card = @board.cards.create!(title: "Deployment checklist", status: :published, creator: @user)
+    card.comments.create!(body: "<p>First comment about migrations</p>", creator: @user)
+    card.comments.create!(body: "<p>Second comment about kubernetes</p>", creator: users(:kevin))
+
+    assert_equal [ card ], Search.new(query: "migrations", user: @user).cards.to_a
+    assert_equal [ card ], Search.new(query: "kubernetes", user: @user).cards.to_a
+  end
+
+  test "matches case-insensitively including unicode and across multiple words" do
+    unicode_card = @board.cards.create!(title: "Visit Café tomorrow", status: :published, creator: @user)
+
+    assert_includes Search.new(query: "LAYOUT", user: @user).cards, cards(:layout)
+    assert_includes Search.new(query: "broken layout", user: @user).cards, cards(:layout)
+    assert_includes Search.new(query: "layout overflowing", user: @user).cards, cards(:layout)
+    assert_includes Search.new(query: "café", user: @user).cards, unicode_card
+    assert_includes Search.new(query: "CAFÉ", user: @user).cards, unicode_card
+    assert_empty Search.new(query: "layout nonexistentword", user: @user).cards
+  end
+
+  test "does not match unrelated fields such as board name or step content" do
+    card = @board.cards.create!(title: "Plain task", status: :published, creator: @user)
+    card.steps.create!(content: "UniqueStepToken")
+
+    assert_empty Search.new(query: "Writebook", user: @user).cards
+    assert_empty Search.new(query: "UniqueStepToken", user: @user).cards
+  end
+
+  test "does not match HTML tags or attributes inside rich text" do
+    @board.cards.create!(
+      title: "Plain title",
+      description: '<div class="custom-wrapper"><p>Simple <strong>content</strong></p></div>',
+      status: :published,
+      creator: @user
+    )
+
+    assert_empty Search.new(query: "strong", user: @user).cards
+    assert_empty Search.new(query: "custom-wrapper", user: @user).cards
+  end
+
+  test "returns cards newest first without duplicates" do
+    older = @board.cards.create!(
+      title: "Unicorn alpha",
+      description: "Unicorn details",
+      status: :published,
+      creator: @user,
+      created_at: 3.days.ago,
+      last_active_at: 1.minute.ago
+    )
+    older.comments.create!(body: "Unicorn comment one", creator: @user)
+    older.comments.create!(body: "Unicorn comment two", creator: @user)
+
+    newer = @board.cards.create!(
+      title: "Unicorn beta",
+      status: :published,
+      creator: @user,
+      created_at: 1.day.ago,
+      last_active_at: 1.day.ago
+    )
+
+    results = Search.new(query: "unicorn", user: @user).cards.to_a
+    assert_equal [ newer, older ], results
+  end
+
+  test "includes closed and postponed published cards" do
+    closed_card = @board.cards.create!(title: "Zebra closed card", status: :published, creator: @user)
+    closed_card.close(user: @user)
+
+    postponed_card = @board.cards.create!(title: "Zebra postponed card", status: :published, creator: @user)
+    postponed_card.postpone(user: @user)
+
+    results = Search.new(query: "zebra", user: @user).cards.to_a
+    assert_includes results, closed_card
+    assert_includes results, postponed_card
+  end
+
+  test "only returns results from boards the user currently has access to" do
+    private_board = boards(:private)
+    private_card = Current.with(session: sessions(:kevin)) do
+      card = private_board.cards.create!(
+        title: "Confidential giraffe",
+        description: "Secret roadmap",
+        status: :published,
+        creator: users(:kevin)
+      )
+      card.comments.create!(body: "Classified budget", creator: users(:kevin))
+      card
+    end
+
+    assert_equal [ private_card ], Search.new(query: "giraffe", user: users(:kevin)).cards.to_a
+    assert_equal [ private_card ], Search.new(query: "roadmap", user: users(:kevin)).cards.to_a
+    assert_equal [ private_card ], Search.new(query: "Classified", user: users(:kevin)).cards.to_a
+
+    assert_empty Search.new(query: "giraffe", user: @user).cards
+    assert_empty Search.new(query: "roadmap", user: @user).cards
+    assert_empty Search.new(query: "Classified", user: @user).cards
+
+    private_board.accesses.grant_to(@user)
+    assert_equal [ private_card ], Search.new(query: "giraffe", user: @user).cards.to_a
+
+    private_board.accesses.revoke_from(@user)
+    assert_empty Search.new(query: "giraffe", user: @user).cards
+  end
+
+  test "hides card when moved to an inaccessible board" do
+    card = @board.cards.create!(title: "Movable pangolin", status: :published, creator: @user)
+    assert_equal [ card ], Search.new(query: "pangolin", user: @user).cards.to_a
+
+    Current.with(session: sessions(:kevin)) do
+      card.move_to(boards(:private))
+    end
+
+    assert_empty Search.new(query: "pangolin", user: @user).cards
+    assert_equal [ card ], Search.new(query: "pangolin", user: users(:kevin)).cards.to_a
+  end
+
+  test "never returns cards from other accounts" do
+    assert_empty Search.new(query: "paycheck", user: @user).cards
+    assert_empty Search.new(query: "radio", user: @user).cards
+  end
+
+  test "never returns draft cards or their comments" do
+    draft = @board.cards.create!(
+      title: "Platypus draft title",
+      description: "Platypus draft description",
+      status: :drafted,
+      creator: @user
+    )
+
+    comment_on_draft = Comment.new(account: draft.account, card: draft, creator: @user, body: "Platypus draft comment")
+    comment_on_draft.rich_text_body.account = draft.account
+    comment_on_draft.save!(validate: false)
+
+    assert_empty Search.new(query: "Platypus", user: @user).cards
+
+    reverted = @board.cards.create!(title: "Narwhal card", status: :published, creator: @user)
+    reverted.comments.create!(body: "Narwhal comment", creator: @user)
+    reverted.drafted!
+
+    assert_empty Search.new(query: "Narwhal", user: @user).cards
+
+    draft.publish
+    assert_includes Search.new(query: "Platypus", user: @user).cards, draft
+  end
+
+  test "does not match old title via system comment after rename" do
+    card = @board.cards.create!(title: "Archaeopteryx original", status: :published, creator: @user)
+    card.update!(title: "Pterodactyl replacement")
+
+    assert_empty Search.new(query: "Archaeopteryx", user: @user).cards
+    assert_equal [ card ], Search.new(query: "Pterodactyl", user: @user).cards.to_a
+  end
+
+  test "handles special SQL and regex characters safely" do
+    card = @board.cards.create!(
+      title: "Fix 100% [critical] (c++) foo_bar! issue",
+      description: "Check Tom & Jerry's 50% discount",
+      status: :published,
+      creator: @user
+    )
+
+    assert_includes Search.new(query: "100%", user: @user).cards, card
+    assert_includes Search.new(query: "[critical]", user: @user).cards, card
+    assert_includes Search.new(query: "(c++)", user: @user).cards, card
+    assert_includes Search.new(query: "bar", user: @user).cards, card
+    assert_includes Search.new(query: "Jerry's", user: @user).cards, card
+    assert_includes Search.new(query: "Tom & Jerry", user: @user).cards, card
+  end
+end
