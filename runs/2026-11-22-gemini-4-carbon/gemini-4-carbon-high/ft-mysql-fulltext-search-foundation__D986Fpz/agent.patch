diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..3918a30
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "requires authentication and account scope" do
+    sign_out
+    get search_path(q: "logo")
+    assert_redirected_to new_session_path(script_name: nil)
+
+    sign_in_as :david
+    integration_session.default_url_options[:script_name] = ""
+    get search_path(q: "logo")
+    assert_redirected_to session_menu_path
+  end
+
+  test "renders empty search page when query is omitted or blank" do
+    get search_path
+    assert_response :success
+    assert_select "form[action=?][method='get'] input[name='q']", search_path
+    assert_select "mark", count: 0
+
+    get search_path(q: "   ")
+    assert_response :success
+    assert_select "mark", count: 0
+  end
+
+  test "finds cards by title, description, or comment body newest first with matched words wrapped in mark" do
+    title_card = description_card = comment_card = nil
+
+    Current.with(session: sessions(:david)) do
+      board = boards(:writebook)
+      title_card = board.cards.create!(
+        title: "Fix telescope calibration",
+        status: :published,
+        creator: users(:david),
+        created_at: 3.minutes.ago
+      )
+      description_card = board.cards.create!(
+        title: "Observatory maintenance",
+        description: "<p>Adjust the telescope mirror alignment</p>",
+        status: :published,
+        creator: users(:david),
+        created_at: 2.minutes.ago
+      )
+      comment_card = board.cards.create!(
+        title: "Night schedule",
+        status: :published,
+        creator: users(:david),
+        created_at: 1.minute.ago
+      )
+      comment_card.comments.create!(body: "<p>Booked the telescope for Friday</p>", creator: users(:kevin))
+    end
+
+    get search_path(q: "telescope")
+    assert_response :success
+
+    assert_select "input[name='q'][value='telescope']"
+
+    result_ids = css_select("article.search__result").map { |node| node["id"] }
+    assert_equal [ dom_id(comment_card), dom_id(description_card), dom_id(title_card) ], result_ids
+
+    assert_select "##{dom_id(title_card)} a[href=?] mark", card_path(title_card), text: "telescope"
+    assert_select "##{dom_id(description_card)} mark", text: "telescope"
+    assert_select "##{dom_id(comment_card)} mark", text: "telescope"
+  end
+
+  test "highlights matched words across both title and comment when multi-word query spans them" do
+    get search_path(q: "layout overflowing")
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:layout))} mark", text: "Layout"
+    assert_select "##{dom_id(cards(:layout))} mark", text: "overflowing"
+  end
+
+  test "only shows results from boards the user currently has access to" do
+    private_card = Current.with(session: sessions(:kevin)) do
+      card = boards(:private).cards.create!(
+        title: "Secret submarine project",
+        description: "<p>Submarine hull specs</p>",
+        status: :published,
+        creator: users(:kevin)
+      )
+      card.comments.create!(body: "<p>Submarine sonar test</p>", creator: users(:kevin))
+      card
+    end
+
+    get search_path(q: "submarine")
+    assert_response :success
+    assert_select "article.search__result", count: 0
+    assert_select ".blank-slate"
+
+    sign_out
+    sign_in_as :kevin
+
+    get search_path(q: "submarine")
+    assert_response :success
+    assert_select "##{dom_id(private_card)}"
+    assert_select "mark", text: "Submarine"
+  end
+
+  test "never shows draft cards or their comments" do
+    draft = boards(:writebook).cards.create!(
+      title: "Draft chameleon card",
+      description: "<p>Chameleon description</p>",
+      status: :drafted,
+      creator: users(:david)
+    )
+    comment = Comment.new(account: draft.account, card: draft, creator: users(:david), body: "<p>Chameleon comment</p>")
+    comment.rich_text_body.account = draft.account
+    comment.save!(validate: false)
+
+    get search_path(q: "chameleon")
+    assert_response :success
+    assert_select "article.search__result", count: 0
+  end
+
+  test "renders JSON format" do
+    get search_path(format: :json), params: { q: "overflowing" }
+    assert_response :success
+    assert_equal [ cards(:layout).number ], @response.parsed_body.pluck("number")
+  end
+end
