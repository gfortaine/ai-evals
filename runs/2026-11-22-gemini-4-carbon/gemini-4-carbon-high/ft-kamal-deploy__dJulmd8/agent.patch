diff --git a/docs/deployment.md b/docs/deployment.md
new file mode 100644
index 0000000..77aafeb
--- /dev/null
+++ b/docs/deployment.md
@@ -0,0 +1,71 @@
+## Deployment
+
+Fizzy includes a [Kamal](https://kamal-deploy.org/) configuration (`config/deploy.yml` and `.kamal/secrets`) for deploying to a single Linux server:
+
+- Everything runs in one container (Thruster, Puma, and Solid Queue background jobs)
+- SQLite databases (primary, queue, cache, cable) and Active Storage uploads persist in a Docker volume across deploys
+- `kamal-proxy` terminates SSL automatically via Let's Encrypt
+- Kamal's built-in local registry streams images over SSH, so no external container registry is required
+
+### Prerequisites
+
+- A Linux server reachable via SSH as `root` (or configure `ssh.user` in `config/deploy.yml`) with ports `22`, `80`, and `443` open
+- A domain name with a DNS `A`/`AAAA` record pointing to your server
+- Docker installed locally on your machine (`bin/kamal setup` — or `kamal setup` if installed globally — will install Docker on the server if needed)
+
+### 1. Configure hostname and mail server
+
+Edit `config/deploy.yml`:
+
+1. Set your hostname under `proxy.host` (this also sets the SSH target and `APP_HOST` via the `*host` YAML alias; if SSH uses a separate IP address, replace `*host` under `servers.web`):
+   ```yaml
+   proxy:
+     ssl: true
+     host: &host fizzy.example.com
+   ```
+2. Fill in your outgoing SMTP server details under `env.clear`:
+   ```yaml
+   SMTP_ADDRESS: smtp.example.com
+   SMTP_PORT: 587
+   MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+   ```
+3. If your server is ARM-based (e.g., Hetzner CAX or AWS Graviton), change `builder.arch` from `amd64` to `arm64`.
+
+### 2. Configure secrets
+
+`.kamal/secrets` reads secrets from your environment (or a password manager like 1Password). Never commit raw credentials to git.
+
+Generate `SECRET_KEY_BASE` and Web Push VAPID keys:
+
+```sh
+bin/rails secret
+bin/rails runner 'key = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{key.public_key}\nVAPID_PRIVATE_KEY=#{key.private_key}"'
+```
+
+Export the secrets in your shell (or configure a password manager adapter in `.kamal/secrets`):
+
+```sh
+export SECRET_KEY_BASE="..."
+export SMTP_USERNAME="..."
+export SMTP_PASSWORD="..."
+export VAPID_PUBLIC_KEY="..."
+export VAPID_PRIVATE_KEY="..."
+```
+
+### 3. Deploy
+
+Run initial setup and deploy:
+
+```sh
+kamal setup
+```
+
+Once finished, Fizzy will be live at `https://your-host`. Visit it in your browser to create your account (sign-in verification codes are sent through your configured mail server).
+
+For subsequent deploys after making changes:
+
+```sh
+kamal deploy
+```
+
+All SQLite databases and uploaded files live in the `fizzy_storage` Docker volume (`/rails/storage`) and survive deploys and container restarts.
diff --git a/test/lib/kamal_deploy_config_test.rb b/test/lib/kamal_deploy_config_test.rb
new file mode 100644
index 0000000..b321932
--- /dev/null
+++ b/test/lib/kamal_deploy_config_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+require "kamal"
+require "open3"
+
+class KamalDeployConfigTest < ActiveSupport::TestCase
+  test "deploy config targets a single box with SSL proxy, persistent storage, and in-container jobs" do
+    with_env(
+      "SECRET_KEY_BASE" => "secret_123",
+      "SMTP_USERNAME" => "smtp_user",
+      "SMTP_PASSWORD" => "smtp_pass",
+      "VAPID_PUBLIC_KEY" => "vapid_pub",
+      "VAPID_PRIVATE_KEY" => "vapid_priv"
+    ) do
+      config = Kamal::Configuration.create_from(
+        config_file: Rails.root.join("config/deploy.yml"),
+        version: "test"
+      )
+
+      assert_equal "fizzy", config.service
+      assert_equal [ "web" ], config.roles.map(&:name)
+
+      web = config.role("web")
+      assert web.ssl?
+      assert_equal [ "fizzy.example.com" ], web.proxy.hosts
+      assert_equal [ "fizzy.example.com" ], web.hosts
+      assert config.registry.local?
+      assert_equal "/rails/public/assets", web.asset_path
+      assert_includes config.volume_args, "fizzy_storage:/rails/storage"
+
+      env = web.env(web.primary_host)
+      assert_equal true, env.clear["SOLID_QUEUE_IN_PUMA"]
+      assert_equal "fizzy.example.com", env.clear["APP_HOST"]
+      assert_equal "smtp.example.com", env.clear["SMTP_ADDRESS"]
+      assert_equal 587, env.clear["SMTP_PORT"]
+      assert_equal "Fizzy <fizzy@example.com>", env.clear["MAILER_FROM_ADDRESS"]
+
+      secrets_env = web.secrets_io(web.primary_host).read
+      assert_includes secrets_env, "SECRET_KEY_BASE=secret_123"
+      assert_includes secrets_env, "SMTP_USERNAME=smtp_user"
+      assert_includes secrets_env, "SMTP_PASSWORD=smtp_pass"
+      assert_includes secrets_env, "VAPID_PUBLIC_KEY=vapid_pub"
+      assert_includes secrets_env, "VAPID_PRIVATE_KEY=vapid_priv"
+    end
+  end
+
+  test "changing hostname anchor updates proxy, server, and APP_HOST together" do
+    yaml = Rails.root.join("config/deploy.yml").read.sub(
+      "host: &host fizzy.example.com",
+      "host: &host boards.acme.org"
+    )
+
+    Dir.mktmpdir do |dir|
+      deploy_file = Pathname.new(dir).join("deploy.yml")
+      deploy_file.write(yaml)
+
+      with_env("SECRET_KEY_BASE" => "secret_123") do
+        config = Kamal::Configuration.create_from(config_file: deploy_file, version: "test")
+        web = config.role("web")
+
+        assert_equal [ "boards.acme.org" ], web.proxy.hosts
+        assert_equal [ "boards.acme.org" ], web.hosts
+        assert_equal "boards.acme.org", web.env("boards.acme.org").clear["APP_HOST"]
+      end
+    end
+  end
+
+  test "production environment configures APP_HOST and SMTP from env" do
+    result = inspect_production_config(
+      "APP_HOST" => "https://boards.acme.org",
+      "SMTP_ADDRESS" => "smtp.acme.org",
+      "SMTP_PORT" => "2525",
+      "SMTP_USERNAME" => "mailer",
+      "SMTP_PASSWORD" => "s3cret",
+      "SMTP_AUTHENTICATION" => "login",
+      "SMTP_ENABLE_STARTTLS_AUTO" => "false"
+    )
+
+    expected_url_options = { "host" => "boards.acme.org", "protocol" => "https" }
+    assert_equal expected_url_options, result["routes_url_options"]
+    assert_equal expected_url_options, result["controller_url_options"]
+    assert_equal expected_url_options, result["mailer_url_options"]
+
+    assert_equal(
+      {
+        "address" => "smtp.acme.org",
+        "port" => 2525,
+        "domain" => "boards.acme.org",
+        "user_name" => "mailer",
+        "password" => "s3cret",
+        "authentication" => "login",
+        "enable_starttls_auto" => false,
+        "open_timeout" => 5,
+        "read_timeout" => 5
+      },
+      result["smtp_settings"]
+    )
+  end
+
+  test "production environment supports unauthenticated SMTP and DISABLE_SSL" do
+    result = inspect_production_config(
+      "APP_HOST" => "fizzy.internal:3000",
+      "DISABLE_SSL" => "true",
+      "SMTP_ADDRESS" => "relay.internal",
+      "SMTP_PORT" => "",
+      "SMTP_USERNAME" => "",
+      "SMTP_PASSWORD" => ""
+    )
+
+    expected_url_options = { "host" => "fizzy.internal:3000", "protocol" => "http" }
+    assert_equal expected_url_options, result["mailer_url_options"]
+    assert_equal(
+      {
+        "address" => "relay.internal",
+        "port" => 587,
+        "domain" => "fizzy.internal",
+        "open_timeout" => 5,
+        "read_timeout" => 5
+      },
+      result["smtp_settings"]
+    )
+  end
+
+  private
+    def inspect_production_config(extra_env)
+      env = {
+        "RAILS_ENV" => "production",
+        "RAILS_LOG_LEVEL" => "error",
+        "SAAS" => "false",
+        "BUNDLE_GEMFILE" => Rails.root.join("Gemfile").to_s,
+        "SECRET_KEY_BASE" => "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+      }.merge(extra_env)
+
+      script = <<~RUBY
+        require "json"
+        puts JSON.generate(
+          routes_url_options: Rails.application.routes.default_url_options,
+          controller_url_options: Rails.application.config.action_controller.default_url_options,
+          mailer_url_options: Rails.application.config.action_mailer.default_url_options,
+          smtp_settings: Rails.application.config.action_mailer.smtp_settings
+        )
+      RUBY
+
+      output, status = Open3.capture2(env, Rails.root.join("bin/rails").to_s, "runner", script, chdir: Rails.root.to_s)
+      assert status.success?, "production runner failed: #{output}"
+      JSON.parse(output.lines.last)
+    end
+
+    def with_env(vars)
+      saved = vars.keys.to_h { |k| [ k, ENV[k] ] }
+      vars.each { |k, v| v.nil? ? ENV.delete(k) : ENV[k] = v }
+      yield
+    ensure
+      saved.each { |k, v| v.nil? ? ENV.delete(k) : ENV[k] = v }
+    end
+end
