 This is the source code of [Fizzy](https://fizzy.do/), the Kanban tracking tool for issues and ideas by [37signals](https://37signals.com).
 
 
+## Deployment
+
+You can deploy Fizzy to your own server with [Kamal](https://kamal-deploy.org/).
+Please see our [Deployment guide](docs/deployment.md) for how to deploy Fizzy on a single Linux box.
+
+
 ## Development
 
 You are welcome -- and encouraged -- to modify Fizzy to your liking.
diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..8b82cc6
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,83 @@
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image.
+image: fizzy
+
+# Enable SSL auto certification via Let's Encrypt and allow for multiple apps on a single web server.
+# Replace with your hostname (DNS must point to your server).
+# If using Cloudflare, set SSL/TLS encryption mode to "Full" to enable CF-to-app encryption.
+proxy:
+  ssl: true
+  host: &host fizzy.example.com
+
+# Deploy to your Linux server. Replace *host with an IP address if SSH isn't reachable via your hostname.
+servers:
+  web:
+    - *host
+
+# Credentials for your image host. By default, Kamal uses a local registry forwarded over SSH,
+# so no external registry account is needed for a single server.
+registry:
+  server: localhost:5555
+  # Alternatives: hub.docker.com / registry.digitalocean.com / ghcr.io / ...
+  # username: your-user
+  # password:
+  #   - KAMAL_REGISTRY_PASSWORD
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    # Run the Solid Queue supervisor inside Puma so background jobs run in the same container.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Hostname used for links in emails, notifications, webhooks, and exports.
+    APP_HOST: *host
+
+    # Outgoing mail server (SMTP). Credentials are read from .kamal/secrets.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    # SMTP_DOMAIN: example.com
+    # SMTP_AUTHENTICATION: plain
+    # SMTP_ENABLE_STARTTLS_AUTO: true
+    # SMTP_TLS: true
+    # SMTP_OPENSSL_VERIFY_MODE: peer
+
+    # Allow multiple accounts to sign up on this instance (default: single account).
+    # MULTI_TENANT: true
+
+    # Tune Puma and Solid Queue concurrency for smaller servers if needed.
+    # WEB_CONCURRENCY: 2
+    # JOB_CONCURRENCY: 1
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# Persist SQLite databases (primary, queue, cache, cable) and Active Storage files across deploys.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets between versions to avoid 404s on in-flight requests during deploys.
+asset_path: /rails/public/assets
+
+# Configure the image builder.
+builder:
+  arch: amd64
+  # Change to arm64 if your server is ARM-based (e.g., Hetzner CAX, AWS Graviton).
+  # Build on the server itself instead of locally (useful on Apple Silicon deploying to amd64):
+  # remote: ssh://root@fizzy.example.com
+
+# Aliases are triggered with "bin/kamal <alias>".
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
+
+# Use a different ssh user than root:
+# ssh:
+#   user: app
