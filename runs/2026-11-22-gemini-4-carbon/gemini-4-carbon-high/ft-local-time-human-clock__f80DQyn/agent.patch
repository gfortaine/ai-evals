diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..16eb467
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,76 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, formatTooltip, parseDateTime } from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+const connectedControllers = new Set()
+let refreshTimer = null
+
+function refreshAll() {
+  const now = new Date()
+  connectedControllers.forEach(controller => controller.refresh(now))
+}
+
+function handleVisibilityChange() {
+  if (document.visibilityState === "visible") {
+    refreshAll()
+  }
+}
+
+function registerController(controller) {
+  connectedControllers.add(controller)
+
+  if (!refreshTimer) {
+    refreshTimer = setInterval(refreshAll, REFRESH_INTERVAL)
+    document.addEventListener("visibilitychange", handleVisibilityChange)
+  }
+}
+
+function unregisterController(controller) {
+  connectedControllers.delete(controller)
+
+  if (connectedControllers.size === 0 && refreshTimer) {
+    clearInterval(refreshTimer)
+    refreshTimer = null
+    document.removeEventListener("visibilitychange", handleVisibilityChange)
+  }
+}
+
+export default class extends Controller {
+  static values = { style: { type: String, default: "time" } }
+
+  #preserveCustomTitle = false
+
+  connect() {
+    this.#preserveCustomTitle = this.element.hasAttribute("title") && !this.element.hasAttribute("data-local-time-generated-title")
+    this.handleMorph = () => this.refresh()
+    this.element.addEventListener("turbo:morph-element", this.handleMorph)
+
+    registerController(this)
+    this.refresh()
+  }
+
+  disconnect() {
+    this.element.removeEventListener("turbo:morph-element", this.handleMorph)
+    unregisterController(this)
+  }
+
+  styleValueChanged() {
+    if (this.element.isConnected) {
+      this.refresh()
+    }
+  }
+
+  refresh(now = new Date()) {
+    const rawValue = this.element.getAttribute("datetime")
+    const date = parseDateTime(rawValue)
+    if (!date) return
+
+    this.element.textContent = formatLocalTime(date, this.styleValue, now)
+
+    if (!this.#preserveCustomTitle) {
+      this.element.title = formatTooltip(rawValue, date)
+      this.element.setAttribute("data-local-time-generated-title", "")
+    }
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..a741927
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,163 @@
+const DATE_ONLY_PATTERN = /^(\d{4})-(\d{2})-(\d{2})$/
+const MILLISECONDS_PER_DAY = 86_400_000
+
+let cachedTimezone
+let cachedFormatters
+
+export function parseDateTime(value) {
+  if (!value) return null
+
+  const dateOnlyMatch = DATE_ONLY_PATTERN.exec(value)
+  const date = dateOnlyMatch
+    ? new Date(Number(dateOnlyMatch[1]), Number(dateOnlyMatch[2]) - 1, Number(dateOnlyMatch[3]))
+    : new Date(value)
+
+  return Number.isNaN(date.getTime()) ? null : date
+}
+
+export function differenceInCalendarDays(fromDate, toDate) {
+  const fromDay = Date.UTC(fromDate.getFullYear(), fromDate.getMonth(), fromDate.getDate())
+  const toDay = Date.UTC(toDate.getFullYear(), toDate.getMonth(), toDate.getDate())
+  return Math.round((toDay - fromDay) / MILLISECONDS_PER_DAY)
+}
+
+export function formatLocalTime(date, style = "time", now = new Date()) {
+  switch (style) {
+    case "time":
+      return formatTime(date)
+    case "date":
+      return formatDate(date)
+    case "shortdate":
+      return formatShortDate(date, now)
+    case "datetime":
+      return formatDateTime(date)
+    case "relativedate":
+      return formatRelativeDate(date, now)
+    case "relative":
+      return formatRelative(date, now)
+    case "ago":
+      return formatAgo(date, now)
+    case "indays":
+      return formatInDays(date, now)
+    default:
+      return formatDateTime(date)
+  }
+}
+
+export function formatTooltip(rawValue, date) {
+  if (DATE_ONLY_PATTERN.test(rawValue)) {
+    return normalizeSpaces(formatters().fullDate.format(date))
+  } else {
+    return normalizeSpaces(formatters().fullDateTime.format(date))
+  }
+}
+
+function formatTime(date) {
+  return normalizeSpaces(formatters().time.format(date))
+}
+
+function formatDate(date) {
+  return normalizeSpaces(formatters().date.format(date))
+}
+
+function formatShortDate(date, now) {
+  if (date.getFullYear() === now.getFullYear()) {
+    return normalizeSpaces(formatters().shortDate.format(date))
+  } else {
+    return formatDate(date)
+  }
+}
+
+function formatDateTime(date) {
+  return normalizeSpaces(formatters().dateTime.format(date))
+}
+
+function formatRelativeDate(date, now) {
+  const daysDifference = differenceInCalendarDays(now, date)
+
+  if (daysDifference === 0 || daysDifference === -1 || daysDifference === 1) {
+    return formatters().relativeTime.format(daysDifference, "day")
+  } else if (date.getFullYear() === now.getFullYear()) {
+    return normalizeSpaces(formatters().weekdayDate.format(date))
+  } else {
+    return normalizeSpaces(formatters().weekdayDateWithYear.format(date))
+  }
+}
+
+function formatRelative(date, now) {
+  if (date > now && date - now < 60_000) {
+    return formatTime(date)
+  }
+
+  const daysAgo = differenceInCalendarDays(date, now)
+
+  if (daysAgo === 0) {
+    return formatTime(date)
+  } else if (daysAgo === 1) {
+    return "yesterday"
+  } else if (daysAgo === -1) {
+    return "tomorrow"
+  } else {
+    return formatShortDate(date, now)
+  }
+}
+
+function formatAgo(date, now) {
+  const secondsAgo = Math.round((now - date) / 1000)
+
+  if (secondsAgo < 60) {
+    return "just now"
+  } else if (secondsAgo < 3600) {
+    return formatters().relativeTime.format(-Math.floor(secondsAgo / 60), "minute")
+  }
+
+  const daysAgo = differenceInCalendarDays(date, now)
+
+  if (daysAgo <= 0) {
+    return formatters().relativeTime.format(-Math.max(1, Math.floor(secondsAgo / 3600)), "hour")
+  } else if (daysAgo === 1) {
+    return "yesterday"
+  } else if (daysAgo < 30) {
+    return formatters().relativeTime.format(-daysAgo, "day")
+  } else if (daysAgo < 365) {
+    return formatters().relativeTime.format(-Math.floor(daysAgo / 30), "month")
+  } else {
+    return formatters().relativeTime.format(-Math.floor(daysAgo / 365), "year")
+  }
+}
+
+function formatInDays(date, now) {
+  const daysUntil = Math.max(0, differenceInCalendarDays(now, date))
+  return formatters().relativeTime.format(daysUntil, "day")
+}
+
+function normalizeSpaces(string) {
+  return string.replace(/\s+/g, " ").trim()
+}
+
+function formatters() {
+  const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone
+
+  if (!cachedFormatters || cachedTimezone !== timezone) {
+    cachedTimezone = timezone
+    cachedFormatters = buildFormatters(timezone)
+  }
+
+  return cachedFormatters
+}
+
+function buildFormatters(timeZone) {
+  const tzOption = timeZone ? { timeZone } : {}
+
+  return {
+    relativeTime: new Intl.RelativeTimeFormat("en-US", { numeric: "auto" }),
+    time: new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit", ...tzOption }),
+    date: new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", ...tzOption }),
+    shortDate: new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", ...tzOption }),
+    dateTime: new Intl.DateTimeFormat("en-US", { dateStyle: "short", timeStyle: "short", ...tzOption }),
+    weekdayDate: new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", ...tzOption }),
+    weekdayDateWithYear: new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric", ...tzOption }),
+    fullDate: new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric", ...tzOption }),
+    fullDateTime: new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit", ...tzOption })
+  }
+}
