diff --git a/app/services/images/profile_images_copy.rb b/app/services/images/profile_images_copy.rb
new file mode 100644
index 0000000..08bf743
--- /dev/null
+++ b/app/services/images/profile_images_copy.rb
@@ -0,0 +1,377 @@
+require "fastimage"
+require "stringio"
+
+module Images
+  class ProfileImagesCopy
+    DEFAULT_BATCH_SIZE = 500
+    SKIPPED_IDENTIFIERS = [nil, "", Moderator::BanishUser::DEFAULT_PROFILE_IMAGE].freeze
+
+    def self.call(batch_size: DEFAULT_BATCH_SIZE)
+      new(batch_size: batch_size).call
+    end
+
+    def initialize(batch_size: DEFAULT_BATCH_SIZE)
+      @batch_size = batch_size
+    end
+
+    def call
+      users_copied = copy_records(User)
+      organizations_copied = copy_records(Organization)
+      articles_updated = refresh_stale_articles
+      notifications_updated = refresh_stale_notifications
+
+      if (users_copied + organizations_copied + articles_updated + notifications_updated).positive?
+        bust_global_caches
+      end
+
+      {
+        users_copied: users_copied,
+        organizations_copied: organizations_copied,
+        articles_updated: articles_updated,
+        notifications_updated: notifications_updated
+      }
+    end
+
+    private
+
+    attr_reader :batch_size
+
+    def copy_records(model_class)
+      copied = 0
+
+      model_class
+        .where.not(profile_image: SKIPPED_IDENTIFIERS)
+        .where.missing(:profile_image_attachment)
+        .find_each(batch_size: batch_size) do |record|
+          copied += 1 if copy_record(record)
+        end
+
+      copied
+    end
+
+    def copy_record(record)
+      identifier = record.legacy_profile_image_identifier
+      return false if identifier.blank? || SKIPPED_IDENTIFIERS.include?(identifier)
+      return false if ActiveStorage::Attachment.exists?(record: record, name: "profile_image")
+
+      source = fetch_source_bytes(record, identifier)
+      return false unless source
+
+      blob = create_blob_from_source(record, source)
+      return false unless attach_blob_to_record(record, blob)
+
+      record.reload
+      refresh_record_dependents(record)
+      true
+    end
+
+    def fetch_source_bytes(record, identifier)
+      if identifier.start_with?("http://", "https://")
+        fetch_remote_bytes(record, identifier)
+      else
+        fetch_carrierwave_bytes(record, identifier)
+      end
+    end
+
+    def fetch_carrierwave_bytes(record, identifier)
+      uploader = ProfileImageUploader.new(record, :profile_image)
+      uploader.retrieve_from_store!(identifier)
+      stored_file = uploader.file
+      unless stored_file.present? && stored_file.exists?
+        Rails.logger.warn(
+          "Skipping missing CarrierWave profile_image for #{record.class.name}##{record.id}: #{identifier}",
+        )
+        return
+      end
+
+      bytes = stored_file.read&.b
+      if bytes.blank?
+        Rails.logger.warn(
+          "Skipping empty CarrierWave profile_image for #{record.class.name}##{record.id}: #{identifier}",
+        )
+        return
+      end
+
+      filename = File.basename(identifier)
+      declared_type = stored_file.respond_to?(:content_type) ? stored_file.content_type : nil
+      content_type = resolve_content_type(bytes, filename: filename, declared_type: declared_type)
+
+      { bytes: bytes, filename: filename, content_type: content_type }
+    end
+
+    def fetch_remote_bytes(record, url)
+      downloaded = Images::ProfileImageProcessor.download_remote(url)
+      if downloaded[:error] || downloaded[:empty] || downloaded[:attachable].blank?
+        Rails.logger.warn(
+          "Skipping unreachable remote profile_image for #{record.class.name}##{record.id}: #{url}",
+        )
+        return
+      end
+
+      attachable = downloaded[:attachable]
+      io = attachable[:io]
+      io.rewind if io.respond_to?(:rewind)
+      bytes = io.read.to_s.b
+      return if bytes.empty?
+
+      filename = attachable[:filename].to_s
+      content_type = resolve_content_type(bytes, filename: filename, declared_type: attachable[:content_type])
+
+      { bytes: bytes, filename: filename, content_type: content_type }
+    end
+
+    def resolve_content_type(bytes, filename:, declared_type:)
+      normalized_declared = declared_type == "image/x-icon" ? "image/vnd.microsoft.icon" : declared_type
+      detected = Marcel::MimeType.for(
+        StringIO.new(bytes),
+        name: filename,
+        declared_type: normalized_declared.presence,
+      )
+      detected == "image/x-icon" ? "image/vnd.microsoft.icon" : detected
+    end
+
+    def create_blob_from_source(record, source)
+      bytes = source[:bytes]
+      filename = source[:filename]
+      ext = File.extname(filename).delete_prefix(".").downcase
+      token = ActiveStorage::Blob.generate_unique_secure_token
+      model_key = record.model_name.singular
+      key = if ext.present?
+              "uploads/#{model_key}/profile_image/#{token}.#{ext}"
+            else
+              "uploads/#{model_key}/profile_image/#{token}"
+            end
+
+      metadata = build_blob_metadata(bytes)
+
+      blob = ActiveStorage::Blob.build_after_unfurling(
+        key: key,
+        io: StringIO.new(bytes),
+        filename: filename,
+        content_type: source[:content_type],
+        metadata: metadata,
+        identify: false,
+      )
+      blob.save!
+      blob.upload_without_unfurling(StringIO.new(bytes))
+      blob
+    rescue Exception => e # rubocop:disable Lint/RescueException
+      blob.destroy if blob&.persisted?
+      raise e
+    end
+
+    def build_blob_metadata(bytes)
+      dimensions = FastImage.size(StringIO.new(bytes))
+      metadata = { identified: true, analyzed: true }
+      if dimensions.is_a?(Array) && dimensions.size == 2
+        metadata[:width] = dimensions[0]
+        metadata[:height] = dimensions[1]
+      end
+      metadata
+    end
+
+    def attach_blob_to_record(record, blob)
+      attached = false
+
+      record.with_lock do
+        unless ActiveStorage::Attachment.exists?(record: record, name: "profile_image")
+          ActiveStorage::Attachment.create!(name: "profile_image", record: record, blob: blob)
+          touch_record_cache_timestamps(record)
+          attached = true
+        end
+      end
+
+      blob.purge unless attached
+      attached
+    end
+
+    def touch_record_cache_timestamps(record)
+      now = [Time.current, record.updated_at&.+(0.001.seconds)].compact.max
+      if record.is_a?(User)
+        record.update_columns(
+          updated_at: now,
+          profile_updated_at: now,
+          latest_article_updated_at: now,
+        )
+      elsif record.is_a?(Organization)
+        record.update_columns(
+          updated_at: now,
+          latest_article_updated_at: now,
+        )
+      end
+    end
+
+    def refresh_record_dependents(record)
+      now = Time.current
+
+      if record.is_a?(User)
+        cached_entity = Articles::CachedEntity.from_object(record)
+        record.articles.find_each(batch_size: batch_size) do |article|
+          next unless cached_entity_stale?(article.cached_user, record)
+
+          article.update_columns(cached_user: cached_entity)
+        end
+        touch_user_comment_trees(record, now)
+      elsif record.is_a?(Organization)
+        cached_entity = Articles::CachedEntity.from_object(record)
+        record.articles.find_each(batch_size: batch_size) do |article|
+          next unless cached_entity_stale?(article.cached_organization, record)
+
+          article.update_columns(cached_organization: cached_entity)
+        end
+        record.users.update_all(organization_info_updated_at: now)
+      end
+    end
+
+    def touch_user_comment_trees(user, timestamp)
+      comment_rows = user.comments.pluck(:id, :ancestry)
+      return if comment_rows.empty?
+
+      comment_ids = comment_rows.map(&:first)
+      root_ids = comment_rows.filter_map { |_id, ancestry| ancestry&.split("/")&.first&.to_i }
+      Comment.where(id: (comment_ids + root_ids).uniq).update_all(updated_at: timestamp)
+    end
+
+    def refresh_stale_articles
+      updated = 0
+
+      Article
+        .includes(
+          user: { profile_image_attachment: :blob },
+          organization: { profile_image_attachment: :blob },
+        )
+        .find_each(batch_size: batch_size) do |article|
+          updates = stale_article_cache_updates(article)
+          next if updates.empty?
+
+          article.update_columns(updates)
+          updated += 1
+        end
+
+      updated
+    end
+
+    def stale_article_cache_updates(article)
+      updates = {}
+      if article.user && cached_entity_stale?(article.cached_user, article.user)
+        updates[:cached_user] = Articles::CachedEntity.from_object(article.user)
+      end
+      if article.organization && cached_entity_stale?(article.cached_organization, article.organization)
+        updates[:cached_organization] = Articles::CachedEntity.from_object(article.organization)
+      end
+      updates
+    end
+
+    def cached_entity_stale?(cached_entity, owner)
+      return true if cached_entity.nil?
+
+      cached_entity.profile_image_url != owner.profile_image_url ||
+        cached_entity.profile_image_90 != owner.profile_image_90
+    end
+
+    def refresh_stale_notifications
+      updated = 0
+
+      Notification.where.not(json_data: nil).in_batches(of: batch_size) do |relation|
+        notifications = relation.to_a
+        users_by_id, orgs_by_id = load_notification_actors(notifications)
+        next if users_by_id.empty? && orgs_by_id.empty?
+
+        notifications.each do |notification|
+          new_data, changed = rewrite_actor_images(notification.json_data, users_by_id, orgs_by_id)
+          next unless changed
+
+          notification.update_columns(json_data: new_data)
+          updated += 1
+        end
+      end
+
+      updated
+    end
+
+    def load_notification_actors(notifications)
+      user_ids = Set.new
+      org_ids = Set.new
+
+      notifications.each do |notification|
+        collect_actor_ids(notification.json_data, user_ids, org_ids)
+      end
+
+      users_by_id = if user_ids.any?
+                      User.with_attached_profile_image.where(id: user_ids.to_a).index_by(&:id)
+                    else
+                      {}
+                    end
+      orgs_by_id = if org_ids.any?
+                     Organization.with_attached_profile_image.where(id: org_ids.to_a).index_by(&:id)
+                   else
+                     {}
+                   end
+
+      [users_by_id, orgs_by_id]
+    end
+
+    def collect_actor_ids(node, user_ids, org_ids)
+      case node
+      when Hash
+        klass = node.dig("class", "name")
+        actor_id = node["id"]
+        if actor_id.present? && node.key?("profile_image_90")
+          user_ids << actor_id if klass == "User"
+          org_ids << actor_id if klass == "Organization"
+        end
+        node.each_value { |value| collect_actor_ids(value, user_ids, org_ids) }
+      when Array
+        node.each { |value| collect_actor_ids(value, user_ids, org_ids) }
+      end
+    end
+
+    def rewrite_actor_images(node, users_by_id, orgs_by_id)
+      case node
+      when Hash
+        changed = false
+        result = {}
+        node.each do |key, value|
+          updated_value, child_changed = rewrite_actor_images(value, users_by_id, orgs_by_id)
+          result[key] = updated_value
+          changed ||= child_changed
+        end
+
+        actor = lookup_actor(result, users_by_id, orgs_by_id)
+        if actor && result.key?("profile_image_90") && result["profile_image_90"] != actor.profile_image_90
+          result["profile_image_90"] = actor.profile_image_90
+          changed = true
+        end
+
+        [result, changed]
+      when Array
+        changed = false
+        mapped = node.map do |value|
+          updated_value, child_changed = rewrite_actor_images(value, users_by_id, orgs_by_id)
+          changed ||= child_changed
+          updated_value
+        end
+        [mapped, changed]
+      else
+        [node, false]
+      end
+    end
+
+    def lookup_actor(hash, users_by_id, orgs_by_id)
+      actor_id = hash["id"]
+      return unless actor_id
+
+      case hash.dig("class", "name")
+      when "User"
+        users_by_id[actor_id]
+      when "Organization"
+        orgs_by_id[actor_id]
+      end
+    end
+
+    def bust_global_caches
+      Settings::General.admin_action_taken_at = Time.current
+      EdgeCache::PurgeByKey.call([User.table_key, Organization.table_key, Article.table_key], soft: true)
+    end
+  end
+end
