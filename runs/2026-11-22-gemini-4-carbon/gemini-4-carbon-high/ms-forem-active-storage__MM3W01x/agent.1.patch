@@ -0,0 +1,130 @@
+require "rails_helper"
+
+RSpec.describe ActiveStorageInitializer do
+  describe ".service_name" do
+    it "returns explicit ACTIVE_STORAGE_SERVICE when configured" do
+      allow(ENV).to receive(:[]).and_call_original
+      allow(ENV).to receive(:[]).with("ACTIVE_STORAGE_SERVICE").and_return("local")
+
+      expect(described_class.service_name).to eq(:local)
+    end
+
+    it "returns :test in test environment by default" do
+      expect(described_class.service_name).to eq(:test)
+    end
+
+    context "when in production environment" do
+      before do
+        allow(Rails).to receive(:env).and_return(ActiveSupport::StringInquirer.new("production"))
+        allow(ENV).to receive(:[]).and_call_original
+        allow(ENV).to receive(:[]).with("ACTIVE_STORAGE_SERVICE").and_return(nil)
+      end
+
+      it "returns :forem_cloud when FOREM_CONTEXT is forem_cloud" do
+        allow(ENV).to receive(:[]).with("FILE_STORAGE_LOCATION").and_return(nil)
+        allow(ENV).to receive(:[]).with("FOREM_CONTEXT").and_return("forem_cloud")
+
+        expect(described_class.service_name).to eq(:forem_cloud)
+      end
+
+      it "returns :amazon when AWS_ID is present" do
+        allow(ENV).to receive(:[]).with("FILE_STORAGE_LOCATION").and_return(nil)
+        allow(ENV).to receive(:[]).with("FOREM_CONTEXT").and_return(nil)
+        allow(ApplicationConfig).to receive(:[]).with("AWS_ID").and_return("aws-id")
+
+        expect(described_class.service_name).to eq(:amazon)
+      end
+
+      it "returns :local when FILE_STORAGE_LOCATION is file" do
+        allow(ENV).to receive(:[]).with("FILE_STORAGE_LOCATION").and_return("file")
+
+        expect(described_class.service_name).to eq(:local)
+      end
+
+      it "returns :local when AWS_ID is blank" do
+        allow(ENV).to receive(:[]).with("FILE_STORAGE_LOCATION").and_return(nil)
+        allow(ENV).to receive(:[]).with("FOREM_CONTEXT").and_return(nil)
+        allow(ApplicationConfig).to receive(:[]).with("AWS_ID").and_return(nil)
+
+        expect(described_class.service_name).to eq(:local)
+      end
+    end
+  end
+
+  describe "ActiveStorage::Service::FogService" do
+    let(:bucket_name) { "forem-test-bucket" }
+    let(:credentials) do
+      {
+        provider: "AWS",
+        aws_access_key_id: "mock-key",
+        aws_secret_access_key: "mock-secret",
+        region: "us-east-1"
+      }
+    end
+    let(:service) do
+      ActiveStorage::Service.configure(
+        :amazon,
+        amazon: {
+          service: "Fog",
+          bucket: bucket_name,
+          public: true,
+          fog_public: true,
+          cache_control: "public, max-age=31536000",
+          credentials: credentials
+        },
+      )
+    end
+
+    before do
+      Fog.mock!
+      Fog::Mock.reset
+      service.connection.directories.create(key: bucket_name, public: true)
+    end
+
+    after do
+      Fog.unmock!
+    end
+
+    it "uploads, downloads, streams chunks, checks existence, and deletes objects", :aggregate_failures do
+      payload = "hello active storage fog".b
+      checksum = Digest::MD5.base64digest(payload)
+      key = "uploads/user/profile_image/avatar.png"
+
+      service.upload(key, StringIO.new(payload), checksum: checksum, content_type: "image/png")
+
+      expect(service.exist?(key)).to be(true)
+      expect(service.download(key)).to eq(payload)
+      expect(service.download_chunk(key, 0..4)).to eq("hello")
+      expect(service.url(key)).to eq("https://#{bucket_name}.s3.amazonaws.com/#{key}")
+
+      service.delete(key)
+      expect(service.exist?(key)).to be(false)
+    end
+
+    it "raises ActiveStorage::IntegrityError on checksum mismatch" do
+      expect do
+        service.upload("bad-key.png", StringIO.new("data"), checksum: "invalidchecksum==")
+      end.to raise_error(ActiveStorage::IntegrityError)
+    end
+
+    it "generates Forem Cloud /remoteimages URLs when asset_host_path is configured" do
+      allow(Settings::General).to receive(:app_domain).and_return("community.example.com")
+
+      cloud_service = ActiveStorage::Service.configure(
+        :forem_cloud,
+        forem_cloud: {
+          service: "Fog",
+          bucket: bucket_name,
+          public: true,
+          fog_public: false,
+          asset_host_path: "/remoteimages",
+          credentials: credentials.merge(region: "us-east-2")
+        },
+      )
+
+      expect(cloud_service.url("uploads/user/profile_image/token.gif")).to eq(
+        "https://community.example.com/remoteimages/uploads/user/profile_image/token.gif",
+      )
+    end
+  end
+end
