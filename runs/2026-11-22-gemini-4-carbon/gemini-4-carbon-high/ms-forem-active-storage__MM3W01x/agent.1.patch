diff --git a/spec/models/concerns/has_profile_image_spec.rb b/spec/models/concerns/has_profile_image_spec.rb
new file mode 100644
index 0000000..e203fce
--- /dev/null
+++ b/spec/models/concerns/has_profile_image_spec.rb
@@ -0,0 +1,219 @@
+require "rails_helper"
+require "exifr/jpeg"
+
+RSpec.describe HasProfileImage do
+  let(:jpg_path) { Rails.root.join("spec/fixtures/files/800x600.jpg") }
+  let(:png_path) { Rails.root.join("spec/fixtures/files/800x600.png") }
+  let(:webp_path) { Rails.root.join("spec/fixtures/files/800x600.webp") }
+  let(:pdf_path) { Rails.root.join("spec/fixtures/files/800x600.pdf") }
+  let(:gps_path) { Rails.root.join("spec/fixtures/files/image_gps_data.jpg") }
+
+  def build_legacy_carrierwave_user(image_file = png_path.open)
+    user = create(:user, profile_image: nil)
+    uploader = ProfileImageUploader.new(user, :profile_image)
+    uploader.store!(image_file)
+    user.update_columns(profile_image: uploader.identifier)
+    [user.reload, uploader]
+  end
+
+  def build_legacy_carrierwave_organization(image_file = png_path.open)
+    organization = build(:organization, profile_image: nil)
+    organization.save!(validate: false)
+    uploader = ProfileImageUploader.new(organization, :profile_image)
+    uploader.store!(image_file)
+    organization.update_columns(profile_image: uploader.identifier)
+    [organization.reload, uploader]
+  end
+
+  describe "new profile pictures on User" do
+    it "stores new uploads in Active Storage without writing to the CarrierWave column", :aggregate_failures do
+      user = create(:user, profile_image: fixture_file_upload("800x600.png", "image/png"))
+
+      expect(user.profile_image).to be_attached
+      expect(user.read_attribute(:profile_image)).to be_nil
+      expect(user.profile_image.download).to eq(File.binread(png_path))
+      expect(user.profile_image.blob.key).to match(%r{\Auploads/user/profile_image/[a-z0-9]+\.png\z})
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+      expect(user.profile_image.url).to eq(user.profile_image_url)
+      expect(user.profile_image.to_s).to eq(user.profile_image_url)
+      expect(user.as_json["profile_image"]).to eq("url" => user.profile_image_url)
+    end
+
+    it "downloads remote_profile_image_url into Active Storage", :aggregate_failures do
+      remote_url = "https://example.com/avatar.webp"
+      stub_request(:get, remote_url).to_return(
+        status: 200,
+        body: File.binread(webp_path),
+        headers: { "Content-Type" => "image/webp" },
+      )
+
+      user = create(:user, profile_image: nil)
+      user.remote_profile_image_url = remote_url
+      user.save!
+
+      expect(user.remote_profile_image_url).to eq(remote_url)
+      expect(user.profile_image).to be_attached
+      expect(user.read_attribute(:profile_image)).to be_nil
+      expect(user.profile_image.blob.key).to end_with(".webp")
+      expect(user.profile_image.download).to eq(File.binread(webp_path))
+    end
+
+    it "rejects unsupported formats and oversized files", :aggregate_failures do
+      user = create(:user)
+      user.profile_image = fixture_file_upload("800x600.pdf", "application/pdf")
+      expect(user).not_to be_valid
+      expect(user.errors[:profile_image]).to be_present
+
+      stub_const("ProfileImageUploader::MAX_FILE_SIZE", 1.kilobyte)
+      user.profile_image = fixture_file_upload("800x600.jpg", "image/jpeg")
+      expect(user).not_to be_valid
+      expect(user.errors.full_messages).to include("Profile image File size should be less than 1 KB")
+    end
+
+    it "strips EXIF and GPS metadata when image processing is enabled", :aggregate_failures do
+      expect(EXIFR::JPEG.new(gps_path.to_s).exif?).to be(true)
+      expect(EXIFR::JPEG.new(gps_path.to_s).gps).to be_present
+
+      Images::ProfileImageProcessor.enable_processing = true
+      user = create(:user, profile_image: fixture_file_upload("image_gps_data.jpg", "image/jpeg"))
+
+      Tempfile.create(["stored_avatar", ".jpg"]) do |tmp|
+        tmp.binmode
+        tmp.write(user.profile_image.download)
+        tmp.flush
+
+        expect(EXIFR::JPEG.new(tmp.path).exif?).to be(false)
+        expect(EXIFR::JPEG.new(tmp.path).gps).to be_nil
+      end
+    ensure
+      Images::ProfileImageProcessor.enable_processing = nil
+    end
+
+    it "busts profile image and identity caches when both name and profile_image change", :aggregate_failures do
+      user = create(:user)
+
+      sidekiq_assert_enqueued_with(job: Users::BustProfileImageCacheWorker, args: [user.id]) do
+        sidekiq_assert_enqueued_with(job: Users::BustProfileIdentityCacheWorker, args: [user.id]) do
+          user.update!(name: "Updated User Name", profile_image: fixture_file_upload("800x600.png", "image/png"))
+        end
+      end
+    end
+
+    it "purges Active Storage profile image when user is banished", :aggregate_failures do
+      admin = create(:user, :super_admin)
+      user = create(:user, profile_image: fixture_file_upload("800x600.png", "image/png"))
+      expect(user.profile_image).to be_attached
+
+      Moderator::BanishUser.call(admin: admin, user: user)
+      user.reload
+
+      expect(user.profile_image).not_to be_attached
+      expect(user.profile_image_url).to eq(Moderator::BanishUser::DEFAULT_PROFILE_IMAGE)
+    end
+
+    it "resets transient change state on dup", :aggregate_failures do
+      user = create(:user)
+      duped = user.dup
+
+      expect(duped.profile_image_saved_change?).to be(false)
+      expect(duped.remote_profile_image_url).to be_nil
+    end
+  end
+
+  describe "existing CarrierWave profile pictures on User" do
+    it "preserves existing CarrierWave URLs without migrating untouched records", :aggregate_failures do
+      user, uploader = build_legacy_carrierwave_user
+
+      expect(user.profile_image).not_to be_attached
+      expect(user.profile_image).to be_present
+      expect(user.profile_image_url).to eq(uploader.url)
+      expect(user.profile_image.url).to eq(uploader.url)
+      expect(user.profile_image.to_s).to eq(uploader.url)
+      expect(user.as_json["profile_image"]).to eq("url" => uploader.url)
+
+      user.update!(name: "Still On CarrierWave")
+      user.reload
+
+      expect(user.profile_image).not_to be_attached
+      expect(user.profile_image_url).to eq(uploader.url)
+    ensure
+      uploader&.remove!
+    end
+
+    it "stores new uploads in Active Storage while leaving the old CarrierWave file intact", :aggregate_failures do
+      user, uploader = build_legacy_carrierwave_user
+      legacy_file_path = uploader.file.path
+      expect(File.exist?(legacy_file_path)).to be(true)
+
+      user.update!(profile_image: fixture_file_upload("800x600.jpg", "image/jpeg"))
+      user.reload
+
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+      expect(user.profile_image.download).to eq(File.binread(jpg_path))
+      expect(File.exist?(legacy_file_path)).to be(true)
+    ensure
+      uploader&.remove!
+    end
+  end
+
+  describe "Organization profile pictures" do
+    it "stores new Organization profile pictures in Active Storage", :aggregate_failures do
+      organization = create(:organization, profile_image: fixture_file_upload("800x600.png", "image/png"))
+
+      expect(organization.profile_image).to be_attached
+      expect(organization.read_attribute(:profile_image)).to be_nil
+      expect(organization.profile_image.blob.key).to match(%r{\Auploads/organization/profile_image/[a-z0-9]+\.png\z})
+      expect(organization.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+      expect(organization.profile_image.download).to eq(File.binread(png_path))
+    end
+
+    it "keeps existing CarrierWave Organization profile pictures working and valid on updates", :aggregate_failures do
+      organization, uploader = build_legacy_carrierwave_organization
+
+      expect(organization.profile_image).not_to be_attached
+      expect(organization).to be_valid
+      expect(organization.profile_image_url).to eq(uploader.url)
+
+      organization.update!(summary: "Updated summary while keeping legacy logo")
+      organization.reload
+
+      expect(organization.profile_image).not_to be_attached
+      expect(organization.profile_image_url).to eq(uploader.url)
+    ensure
+      uploader&.remove!
+    end
+
+    it "moves an existing Organization to Active Storage when uploading a new profile picture", :aggregate_failures do
+      organization, uploader = build_legacy_carrierwave_organization
+      article = create(:article, organization: organization)
+      expect(article.cached_organization.profile_image_url).to eq(uploader.url)
+
+      sidekiq_perform_enqueued_jobs do
+        organization.update!(profile_image: fixture_file_upload("800x600.jpg", "image/jpeg"))
+      end
+      organization.reload
+
+      expect(organization.profile_image).to be_attached
+      expect(organization.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+      expect(article.reload.cached_organization.profile_image_url).to eq(organization.profile_image_url)
+    ensure
+      uploader&.remove!
+    end
+  end
+
+  describe "other uploads stay on CarrierWave" do
+    it "leaves all non-User/Organization profile uploads on CarrierWave", :aggregate_failures do
+      expect(Organization.new.cover_image).to be_a(CoverImageUploader)
+      expect(Tag.new.profile_image).to be_a(ProfileImageUploader)
+      expect(Tag.new.social_image).to be_a(ProfileImageUploader)
+      expect(Podcast.new.image).to be_a(ProfileImageUploader)
+      expect(Podcast.new.pattern_image).to be_a(ProfileImageUploader)
+      expect(Page.new.social_image).to be_a(ProfileImageUploader)
+      expect(Tweet.new.profile_image).to be_a(ProfileImageUploader)
+      expect(NavigationLink.new.image).to be_a(NavigationLinkImageUploader)
+      expect(Event.new.cover_image).to be_a(EventCoverImageUploader)
+      expect(Badge.new.badge_image).to be_a(BadgeUploader)
+    end
+  end
+end
