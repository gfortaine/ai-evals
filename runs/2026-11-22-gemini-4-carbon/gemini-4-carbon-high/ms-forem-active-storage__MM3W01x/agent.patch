+++ b/spec/requests/profile_images_active_storage_spec.rb
@@ -0,0 +1,142 @@
+require "rails_helper"
+
+RSpec.describe "Profile images via Active Storage" do
+  let(:png_path) { Rails.root.join("spec/fixtures/files/800x600.png") }
+  let(:jpg_path) { Rails.root.join("spec/fixtures/files/800x600.jpg") }
+  let(:api_v1_headers) { { "Accept" => "application/vnd.forem.api-v1+json" } }
+
+  describe "User profile image upload and serving" do
+    it "uploads a User profile image to Active Storage and serves it over HTTP and API", :aggregate_failures do
+      user = create(:user)
+      sign_in user
+
+      put profile_path(user.profile), params: {
+        user: {
+          name: user.name,
+          profile_image: fixture_file_upload("800x600.png", "image/png")
+        }
+      }
+      expect(response).to have_http_status(:found)
+
+      user.reload
+      expect(user.profile_image).to be_attached
+
+      get user.profile_image_url
+      expect(response).to have_http_status(:ok)
+      expect(response.media_type).to eq("image/png")
+      expect(response.body.b).to eq(File.binread(png_path))
+
+      get user.path
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(user.profile_image_url)
+
+      get api_profile_image_path(user.username)
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(user.profile_image_url_for(length: 640))
+      expect(response.parsed_body["profile_image_90"]).to eq(user.profile_image_url_for(length: 90))
+    end
+
+    it "returns profile_image.url in JSON when updating via UsersController#update", :aggregate_failures do
+      user = create(:user)
+      sign_in user
+
+      put "/users/#{user.id}",
+          params: { user: { profile_image: fixture_file_upload("800x600.png", "image/png") } },
+          headers: { "Accept" => "application/json" }
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["success"]).to be(true)
+      expect(response.parsed_body.dig("user", "profile_image", "url")).to eq(user.reload.profile_image_url)
+    end
+  end
+
+  describe "Organization profile image upload and serving" do
+    it "creates an Organization with an Active Storage profile image and serves it", :aggregate_failures do
+      user = create(:user)
+      sign_in user
+
+      post "/organizations", params: {
+        organization: {
+          name: "Active Storage Org",
+          slug: "asorg#{rand(10_000)}",
+          summary: "Org summary",
+          profile_image: fixture_file_upload("800x600.png", "image/png")
+        }
+      }
+      expect(response).to have_http_status(:found)
+
+      org = Organization.last
+      expect(org.profile_image).to be_attached
+
+      get org.profile_image_url
+      expect(response).to have_http_status(:ok)
+      expect(response.media_type).to eq("image/png")
+      expect(response.body.b).to eq(File.binread(png_path))
+
+      get api_profile_image_path(org.username)
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(org.profile_image_url_for(length: 640))
+
+      get api_organizations_path, headers: api_v1_headers
+      expect(response).to have_http_status(:ok)
+      org_json = response.parsed_body.detect { |item| item["id"] == org.id }
+      expect(org_json["profile_image"]).to eq("url" => org.profile_image_url)
+    end
+  end
+
+  describe "serving copied Active Storage profile pictures after CarrierWave retirement" do
+    it "serves User and Organization profile pictures from Active Storage without touching CarrierWave",
+       :aggregate_failures do
+      allow(ProfileImageUploader).to receive(:new).and_call_original
+
+      user = create(:user, profile_image: fixture_file_upload("800x600.png", "image/png"))
+      org = create(:organization, profile_image: fixture_file_upload("800x600.jpg", "image/jpeg"))
+      create(:organization_membership, user: user, organization: org, type_of_user: "admin")
+
+      ActiveRecord::Base.connection.exec_update(
+        "UPDATE users SET profile_image = $1 WHERE id = $2",
+        "SetRetiredUserColumn",
+        ["retired-carrierwave-avatar.png", user.id],
+      )
+      ActiveRecord::Base.connection.exec_update(
+        "UPDATE organizations SET profile_image = $1 WHERE id = $2",
+        "SetRetiredOrgColumn",
+        ["retired-carrierwave-logo.jpg", org.id],
+      )
+
+      article = create(:article, user: user, organization: org, published: true, score: 50)
+
+      get user.path
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(user.profile_image_url)
+      expect(response.body).not_to include("retired-carrierwave-avatar.png")
+
+      get org.path
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(org.profile_image_url)
+      expect(response.body).not_to include("retired-carrierwave-logo.jpg")
+
+      get article.path
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(user.profile_image_url)
+
+      get "/"
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(user.profile_image_url)
+      expect(response.body).to include(org.profile_image_url)
+
+      get api_profile_image_path(user.username)
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(user.profile_image_url_for(length: 640))
+
+      get api_profile_image_path(org.username)
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(org.profile_image_url_for(length: 640))
+
+      get api_organization_users_path(org.username), headers: api_v1_headers
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body.first["profile_image"]).to eq(user.profile_image_url_for(length: 320))
+
+      expect(ProfileImageUploader).not_to have_received(:new)
+    end
+  end
+end
