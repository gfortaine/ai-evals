diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..958ac69 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,73 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy archives current accesses and removes the book and its access grants" do
+    book = books(:handbook)
+
+    assert_equal 0, AccessArchive.count
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(book)
+    end
+
+    assert_redirected_to root_path
+    assert_not Book.exists?(book.id)
+    assert_empty Access.where(book_id: book.id)
+
+    archived = AccessArchive.where(book_id: book.id).pluck(:user_id, :level).to_h
+    assert_equal({
+      users(:david).id => "editor",
+      users(:jason).id => "editor",
+      users(:jz).id => "reader",
+      users(:kevin).id => "editor"
+    }, archived)
+  end
+
+  test "destroy records updated levels, omits revoked users, and writes nothing before deletion" do
+    sign_in :david
+    book = books(:handbook)
+
+    patch book_path(book), params: {
+      book: { title: book.title, everyone_access: false },
+      "editor_ids[]": users(:jz).id,
+      "reader_ids[]": [ users(:jz).id, users(:kevin).id ]
+    }
+    assert_redirected_to book_slug_path(book)
+    assert_equal 0, AccessArchive.count
+
+    delete book_path(book)
+    assert_redirected_to root_path
+
+    archived = AccessArchive.where(book_id: book.id).pluck(:user_id, :level).to_h
+    assert_equal({
+      users(:david).id => "editor",
+      users(:jz).id => "editor",
+      users(:kevin).id => "reader"
+    }, archived)
+  end
+
+  test "destroy writes no archive rows when nobody had access to the book" do
+    sign_in :david
+    book = books(:manual)
+    book.accesses.delete_all
+    book.update!(published: true, everyone_access: false)
+
+    assert_no_difference -> { AccessArchive.count } do
+      delete book_path(book)
+    end
+
+    assert_redirected_to root_path
+    assert_not Book.exists?(book.id)
+  end
+
+  test "destroy is forbidden for non-editors and writes no archive rows" do
+    sign_in :jz
+
+    assert_no_difference [ -> { Book.count }, -> { AccessArchive.count } ] do
+      delete book_path(books(:handbook))
+    end
+
+    assert_response :forbidden
+  end
 end
