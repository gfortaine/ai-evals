diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..5df50b7 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,26 @@
 module TimeHelper
+  def local_datetime_tag(datetime, style: :relative, **attributes)
+    if datetime.present?
+      data = (attributes.delete(:data) || {}).dup
+      data[:controller] = token_list("local-time", data[:controller])
+      data[:local_time_style_value] = style
+      data[:action] = token_list("turbo:morph-element->local-time#refresh", data[:action])
+
+      tag.time(
+        datetime: iso8601_timestamp(datetime),
+        class: token_list("local-time-value", attributes.delete(:class)),
+        data: data,
+        **attributes
+      )
+    end
+  end
+
+  private
+    def iso8601_timestamp(datetime)
+      if datetime.respond_to?(:utc)
+        datetime.utc.iso8601
+      else
+        datetime.iso8601
+      end
+    end
 end
