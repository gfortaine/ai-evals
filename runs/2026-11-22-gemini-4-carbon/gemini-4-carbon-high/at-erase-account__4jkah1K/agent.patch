diff --git a/app/models/book.rb b/app/models/book.rb
index 90b8292..ac9ad52 100644
--- a/app/models/book.rb
+++ b/app/models/book.rb
@@ -16,4 +16,37 @@ class Book < ApplicationRecord
   def markable
     leaves.active.positioned.map { it.leafable.markable }.join("\n\n")
   end
+
+  def erase
+    blob_ids, derivative_blob_ids = collect_attachment_blob_ids
+
+    destroy!
+
+    ActiveStorage::Blob.where(id: blob_ids).where.missing(:attachments).find_each(&:purge)
+    ActiveStorage::Blob.where(id: derivative_blob_ids).where.missing(:attachments).find_each(&:purge)
+  end
+
+  private
+    def collect_attachment_blob_ids
+      leaf_ids = leaves.pluck(:id)
+      picture_ids = leaves.where(leafable_type: "Picture").pluck(:leafable_id) +
+        Edit.where(leaf_id: leaf_ids, leafable_type: "Picture").pluck(:leafable_id)
+      page_ids = leaves.where(leafable_type: "Page").pluck(:leafable_id) +
+        Edit.where(leaf_id: leaf_ids, leafable_type: "Page").pluck(:leafable_id)
+      markdown_ids = ActionText::Markdown.where(record_type: "Page", record_id: page_ids.uniq).pluck(:id)
+
+      blob_ids = (
+        ActiveStorage::Attachment.where(record: self).pluck(:blob_id) +
+        ActiveStorage::Attachment.where(record_type: "Picture", record_id: picture_ids.uniq).pluck(:blob_id) +
+        ActiveStorage::Attachment.where(record_type: "ActionText::Markdown", record_id: markdown_ids).pluck(:blob_id)
+      ).uniq
+
+      variant_record_ids = ActiveStorage::VariantRecord.where(blob_id: blob_ids).pluck(:id)
+      derivative_blob_ids = (
+        ActiveStorage::Attachment.where(record_type: "ActiveStorage::VariantRecord", record_id: variant_record_ids).pluck(:blob_id) +
+        ActiveStorage::Attachment.where(record_type: "ActiveStorage::Blob", record_id: blob_ids).pluck(:blob_id)
+      ).uniq
+
+      [ blob_ids, derivative_blob_ids ]
+    end
 end
