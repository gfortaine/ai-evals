diff --git a/test/models/book/authorship_test.rb b/test/models/book/authorship_test.rb
new file mode 100644
index 0000000..2f0a9de
--- /dev/null
+++ b/test/models/book/authorship_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class Book::AuthorshipTest < ActiveSupport::TestCase
+  test "creator defaults to Current.user on create" do
+    Current.user = users(:kevin)
+    book = Book.create!(title: "Authored Book")
+
+    assert_equal users(:kevin), book.creator
+  end
+
+  test "remove_author clears creator even when Current.user is set and sets Deleted author" do
+    book = Book.create!(title: "Shared Book", author: "Kevin", creator: users(:kevin))
+
+    Current.user = users(:david)
+    book.remove_author
+
+    book.reload
+    assert_nil book.creator
+    assert_equal "Deleted author", book.author
+  end
+end
diff --git a/test/models/leaf/editable_test.rb b/test/models/leaf/editable_test.rb
index b654642..af80f69 100644
--- a/test/models/leaf/editable_test.rb
+++ b/test/models/leaf/editable_test.rb
@@ -64,3 +64,29 @@ class Leaf::EditableTest < ActiveSupport::TestCase
     assert_equal "This is _such_ a great handbook.", leaves(:welcome_page).edits.last.page.body.content
   end
 end
+
+class Leaf::EditableDestroyTest < ActiveSupport::TestCase
+  test "destroying a leaf destroys its historical edit leafables" do
+    leaf = leaves(:welcome_page)
+    original_page_id = leaf.leafable_id
+
+    leaf.edit leafable_params: { body: "Updated body" }
+    revised_page_id = leaf.reload.leafable_id
+
+    leaf.destroy!
+
+    assert_not Page.exists?(original_page_id)
+    assert_not Page.exists?(revised_page_id)
+  end
+
+  test "destroying a trashed leaf destroys its leafable and edits" do
+    leaf = leaves(:welcome_page)
+    page_id = leaf.leafable_id
+
+    leaf.trashed!
+    Leaf.find(leaf.id).destroy!
+
+    assert_not Page.exists?(page_id)
+    assert_empty Edit.where(leaf_id: leaf.id)
+  end
+end
diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..7728652 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,96 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "destroying a user erases all their data and private books including search hits and blobs" do
+    kevin = users(:kevin)
+    kevin.sessions.start!(user_agent: "TestBrowser", ip_address: "127.0.0.1")
+    ReadingMark.remember(leaves(:welcome_page), user: kevin)
+
+    private_book = Book.create!(title: "Kevin Private", author: "Kevin", everyone_access: false, creator: kevin)
+    private_book.update_access(editors: [ kevin.id ], readers: [ users(:jz).id ])
+    private_book.cover.attach(io: file_fixture("reading.webp").open, filename: "cover.webp", content_type: "image/webp")
+    cover_blob_id = private_book.cover.blob.id
+
+    page_leaf = private_book.press(Page.new(body: "v1 uniqueerasablev1"), title: "Secret Entry")
+    page_leaf.page.body.uploads.attach(io: file_fixture("white-rabbit.webp").open, filename: "rabbit.webp", content_type: "image/webp")
+    page_leaf.page.save!
+    upload_blob_id = page_leaf.page.body.uploads.last.blob.id
+    old_page_id = page_leaf.leafable_id
+    page_leaf.edit(leafable_params: { body: "v2 uniqueerasablev2" })
+    new_page_id = page_leaf.reload.leafable_id
+
+    pic_leaf = private_book.press(Picture.new(caption: "Secret Pic"), title: "Pic")
+    pic_leaf.picture.image.attach(io: file_fixture("reading.webp").open, filename: "pic.webp", content_type: "image/webp")
+    pic_leaf.picture.large_image.processed
+    pic_blob_id = pic_leaf.picture.image.blob.id
+
+    trashed_leaf = private_book.press(Section.new(body: "trashed uniqueerasabletrashed"), title: "Old Section")
+    trashed_leaf.trashed!
+
+    ReadingMark.remember(page_leaf, user: kevin)
+    ReadingMark.remember(page_leaf, user: users(:jz))
+
+    assert_includes Leaf.search("uniqueerasablev2"), page_leaf
+
+    Current.user = users(:david)
+    kevin.destroy!
+
+    assert_not User.exists?(kevin.id)
+    assert_empty Session.where(user_id: kevin.id)
+    assert_empty SignInEvent.for_address("kevin@example.com")
+    assert_empty ReadingMark.where(user_id: kevin.id)
+    assert_empty ReadingMark.where(leaf_id: page_leaf.id)
+    assert_empty Access.where(user_id: kevin.id)
+    assert_empty Access.where(book_id: private_book.id)
+
+    assert_not Book.exists?(private_book.id)
+    assert_empty Leaf.where(book_id: private_book.id)
+    assert_empty Edit.where(leaf_id: [ page_leaf.id, pic_leaf.id, trashed_leaf.id ])
+    assert_not Page.exists?(old_page_id)
+    assert_not Page.exists?(new_page_id)
+    assert_empty ActionText::Markdown.where(record_type: "Page", record_id: [ old_page_id, new_page_id ])
+    assert_not Picture.exists?(pic_leaf.leafable_id)
+    assert_not Section.exists?(trashed_leaf.leafable_id)
+    assert_not ActiveStorage::Blob.exists?(cover_blob_id)
+    assert_not ActiveStorage::Blob.exists?(upload_blob_id)
+    assert_not ActiveStorage::Blob.exists?(pic_blob_id)
+
+    assert_empty Leaf.search("uniqueerasablev2")
+    assert_equal 0, Leaf.connection.select_value(
+      "SELECT COUNT(*) FROM leaf_search_index WHERE leaf_search_index MATCH 'uniqueerasablev1 OR uniqueerasablev2 OR uniqueerasabletrashed'"
+    )
+  end
+
+  test "destroying a user preserves everyone books they created and bylines them Deleted author" do
+    kevin = users(:kevin)
+    books(:handbook).update!(creator: kevin, author: "Kevin", everyone_access: true)
+    ReadingMark.remember(leaves(:welcome_page), user: kevin)
+    ReadingMark.remember(leaves(:welcome_page), user: users(:jz))
+
+    Current.user = users(:david)
+    kevin.destroy!
+
+    books(:handbook).reload
+    assert_nil books(:handbook).creator
+    assert_equal "Deleted author", books(:handbook).author
+    assert books(:handbook).accessable?(user: users(:jz))
+    assert ReadingMark.exists?(user: users(:jz), leaf: leaves(:welcome_page))
+    assert_not ReadingMark.exists?(user_id: kevin.id)
+  end
+
+  test "destroying an already deactivated user erases sign-in events under their original email" do
+    kevin = users(:kevin)
+    original_email = kevin.email_address
+    session = kevin.sessions.start!(user_agent: "TestBrowser", ip_address: "127.0.0.1")
+    session.destroy!
+
+    kevin.update!(active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com")
+    assert SignInEvent.for_address(original_email).any?
+
+    kevin.destroy!
+
+    assert_not User.exists?(kevin.id)
+    assert_empty SignInEvent.for_address(original_email)
+  end
 end
