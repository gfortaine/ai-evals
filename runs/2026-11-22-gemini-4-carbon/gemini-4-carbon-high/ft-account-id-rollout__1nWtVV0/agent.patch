+  private
+    def uuid_type
+      @uuid_type ||= ActiveRecord::Type::Uuid.new
+    end
+
+    def generate_uuid
+      ActiveRecord::Type::Uuid.generate
+    end
+
+    def insert_row(connection, table, attributes)
+      id = generate_uuid
+      columns = connection.columns(table).index_by(&:name)
+      row = { "id" => id }.merge(attributes.stringify_keys)
+
+      col_names = row.keys.map { |k| connection.quote_column_name(k) }.join(", ")
+      values = row.map do |col_name, val|
+        col = columns.fetch(col_name)
+        if col.type == :uuid && !val.nil?
+          connection.quote(uuid_type.serialize(val))
+        else
+          connection.quote(val)
+        end
+      end.join(", ")
+
+      connection.execute("INSERT INTO #{connection.quote_table_name(table)} (#{col_names}) VALUES (#{values})")
+      id
+    end
+
+    def fetch_account_id(connection, table, id)
+      quoted_id = connection.quote(uuid_type.serialize(id))
+      raw = connection.select_value("SELECT account_id FROM #{connection.quote_table_name(table)} WHERE id = #{quoted_id}")
+      uuid_type.deserialize(raw)
+    end
+
+    def row_exists?(connection, table, id)
+      quoted_id = connection.quote(uuid_type.serialize(id))
+      connection.select_value("SELECT 1 FROM #{connection.quote_table_name(table)} WHERE id = #{quoted_id}").present?
+    end
+
+    def cleanup_inserted_rows(connection, valid_ids)
+      table_for_key = {
+        boards: :boards, filters: :filters, columns: :columns, cards: :cards, webhooks: :webhooks,
+        events: :events, comments: :comments, steps: :steps, push_subscriptions: :push_subscriptions,
+        notification_bundles: :notification_bundles, notifications: :notifications, tags: :tags,
+        taggings: :taggings, accesses: :accesses, board_publications: :board_publications,
+        user_settings: :user_settings, search_queries: :search_queries,
+        entropies_account: :entropies, storage_totals_account: :storage_totals, storage_totals_board: :storage_totals,
+        assignments: :assignments, card_activity_spikes: :card_activity_spikes,
+        card_goldnesses: :card_goldnesses, card_not_nows: :card_not_nows, closures: :closures,
+        pins: :pins, watches: :watches, webhook_delinquency_trackers: :webhook_delinquency_trackers,
+        webhook_deliveries: :webhook_deliveries, mentions_card: :mentions, mentions_comment: :mentions,
+        reactions_card: :reactions, reactions_comment: :reactions,
+        rich_texts_board: :action_text_rich_texts, rich_texts_card: :action_text_rich_texts,
+        card_attachment: :active_storage_attachments, preview_attachment: :active_storage_attachments,
+        variant_attachment: :active_storage_attachments, variant_record: :active_storage_variant_records,
+        variant_blob: :active_storage_blobs, preview_blob: :active_storage_blobs, card_blob: :active_storage_blobs
+      }
+
+      table_for_key.each do |key, table|
+        if id = valid_ids[key]
+          quoted_id = connection.quote(uuid_type.serialize(id))
+          connection.execute("DELETE FROM #{connection.quote_table_name(table)} WHERE id = #{quoted_id}")
+        end
+      end
+    end
+end
diff --git a/test/models/account/tenancy_test.rb b/test/models/account/tenancy_test.rb
