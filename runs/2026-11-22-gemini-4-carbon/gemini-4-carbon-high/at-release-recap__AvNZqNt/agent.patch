diff --git a/test/controllers/books/releases_controller_test.rb b/test/controllers/books/releases_controller_test.rb
new file mode 100644
index 0000000..a9db75c
--- /dev/null
+++ b/test/controllers/books/releases_controller_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    sign_in :david
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "edit renders release form for editable book" do
+    get edit_book_release_path(books(:handbook))
+
+    assert_response :success
+    assert_in_body "Release this book"
+  end
+
+  test "releasing a book displays the new title as published in recently updated" do
+    book = books(:handbook)
+    patch book_path(book), params: { book: { title: "Working Title" } }
+
+    patch book_release_path(book), params: { book: { title: "Official Title", subtitle: "Release Subtitle" } }
+    assert_redirected_to root_path
+    follow_redirect!
+
+    assert_response :success
+    assert_in_body "Recently updated"
+    assert_not_in_body "Working Title"
+    assert_select ".library__recents strong", text: "Official Title"
+    assert_select ".library__recents span", text: "Published"
+
+    get book_slug_path(book)
+    assert_response :success
+    assert_in_body "Official Title"
+  end
+
+  test "released book recap is visible to unauthenticated visitors without exposing draft recaps" do
+    patch book_path(books(:manual)), params: { book: { title: "Secret Draft Manual" } }
+    patch book_release_path(books(:handbook)), params: { book: { title: "Public Handbook" } }
+
+    sign_out
+    get root_path
+
+    assert_response :success
+    assert_select ".library__recents strong", text: "Public Handbook"
+    assert_select ".library__recents span", text: "Published"
+    assert_not_in_body "Secret Draft Manual"
+  end
+
+  test "renaming a book the ordinary way updates recently updated" do
+    book = books(:handbook)
+
+    patch book_path(book), params: { book: { title: "Ordinary Rename" } }
+    get root_path
+
+    assert_response :success
+    assert_select ".library__recents strong", text: "Ordinary Rename"
+    assert_select ".library__recents span", text: "Draft"
+  end
+
+  test "releasing a book preserves other book recaps until expiration" do
+    patch book_path(books(:manual)), params: { book: { title: "Draft Manual" } }
+    patch book_release_path(books(:handbook)), params: { book: { title: "Released Handbook" } }
+
+    get root_path
+    assert_response :success
+    assert_select ".library__recents strong", text: "Draft Manual"
+    assert_select ".library__recents strong", text: "Released Handbook"
+
+    travel Rails.application.config.x.recap.expires_in + 1.second do
+      get root_path
+      assert_response :success
+      assert_not_in_body "Recently updated"
+    end
+  end
+
+  test "releasing an already published book redirects back to book without changing title" do
+    book = books(:handbook)
+    book.update!(title: "Already Published", published: true)
+
+    patch book_release_path(book), params: { book: { title: "Ignored New Title" } }
+    assert_redirected_to book_slug_path(book)
+
+    get root_path
+    assert_response :success
+    assert_select ".library__recents strong", text: "Already Published"
+    assert_not_in_body "Ignored New Title"
+  end
+
+  test "non-editors cannot release a book" do
+    sign_in :jz
+
+    patch book_release_path(books(:handbook)), params: { book: { title: "Unauthorized Release" } }
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/book/release_test.rb b/test/models/book/release_test.rb
new file mode 100644
index 0000000..183d1b8
--- /dev/null
+++ b/test/models/book/release_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Book::ReleaseTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "finalize_release updates book and caches recap with released title" do
+    book = books(:handbook)
+    book.update!(title: "Working Title")
+
+    assert Book.finalize_release(book.id, title: "Final Title", subtitle: "First Edition")
+
+    book.reload
+    assert_equal "Final Title", book.title
+    assert_equal "First Edition", book.subtitle
+    assert book.published?
+    assert_equal({ title: "Final Title", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release preserves existing subtitle when subtitle is nil" do
+    book = books(:handbook)
+    book.update!(subtitle: "Existing Subtitle")
+
+    assert Book.finalize_release(book.id, title: "Final Handbook")
+
+    book.reload
+    assert_equal "Final Handbook", book.title
+    assert_equal "Existing Subtitle", book.subtitle
+    assert_equal({ title: "Final Handbook", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release caches recap when keeping the existing title" do
+    book = books(:handbook)
+
+    assert Book.finalize_release(book.id, title: book.title)
+
+    assert_equal({ title: "Handbook", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release returns false for already published book without overwriting recap" do
+    book = books(:handbook)
+    book.update!(title: "Published Title", published: true)
+
+    assert_not Book.finalize_release(book.id, title: "Ignored Title")
+
+    assert_equal "Published Title", book.reload.title
+    assert_equal({ title: "Published Title", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release raises RecordNotFound for missing book" do
+    assert_raises(ActiveRecord::RecordNotFound) do
+      Book.finalize_release(-1, title: "Missing")
+    end
+  end
+
+  test "release marker with separate book update still caches latest title" do
+    book = books(:handbook)
+    marker = ReleaseMarker.for(book.id)
+
+    Book.transaction do
+      book.update!(title: "Updated In Transaction")
+      marker.publish!
+    end
+
+    assert_equal({ title: "Updated In Transaction", published: true }, book.cached_recap)
+  end
+
+  test "recap stays per book when saving or releasing another book" do
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    manual.update!(title: "Operations Manual")
+    Book.finalize_release(handbook.id, title: "Company Handbook")
+
+    assert_equal({ title: "Operations Manual", published: false }, manual.cached_recap)
+    assert_equal({ title: "Company Handbook", published: true }, handbook.cached_recap)
+  end
+
+  test "recap expires on configured schedule" do
+    original_expires_in = Rails.application.config.x.recap.expires_in
+    Rails.application.config.x.recap.expires_in = 30.minutes
+
+    book = books(:handbook)
+    Book.finalize_release(book.id, title: "Scheduled Handbook")
+
+    travel 29.minutes do
+      assert_equal({ title: "Scheduled Handbook", published: true }, book.cached_recap)
+    end
+
+    travel 31.minutes do
+      assert_nil book.cached_recap
+    end
+  ensure
+    Rails.application.config.x.recap.expires_in = original_expires_in
+  end
+end
