diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..0dda2d3
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,309 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+const DEFAULT_DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const DEFAULT_HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  #saveQueue = Promise.resolve()
+
+  connect() {
+    this.draggedItem = null
+    this.sourceContainer = null
+    this.hoverContainer = null
+    this.justDragged = false
+
+    this.mediaQuery = window.matchMedia(this.desktopBreakpointValue)
+    this.handleViewportChange = this.#updateDraggableItems.bind(this)
+    this.mediaQuery.addEventListener("change", this.handleViewportChange)
+
+    this.preventPostDragClick = this.#preventPostDragClick.bind(this)
+    this.resetJustDragged = () => { this.justDragged = false }
+this.element.addEventListener("pointerdown", this.resetJustDragged, true)
+this.element.addEventListener("click", this.preventPostDragClick, true)
+
+    this.#updateDraggableItems()
+  }
+
+  disconnect() {
+    this.mediaQuery?.removeEventListener("change", this.handleViewportChange)
+    this.element.removeEventListener("pointerdown", this.resetJustDragged, true)
+this.element.removeEventListener("click", this.preventPostDragClick, true)
+    this.#cleanup()
+    this.itemTargets.forEach(item => item.draggable = false)
+  }
+
+  itemTargetConnected(element) {
+    this.#configureItem(element)
+  }
+
+  refresh() {
+    this.#updateDraggableItems()
+  }
+
+  preserveDraggable(event) {
+    if (event.detail?.attributeName === "draggable") {
+      event.preventDefault()
+    }
+  }
+
+  dragStart(event) {
+    if (!this.#isDesktop || this.#shouldIgnoreDragStart(event)) {
+      event.preventDefault()
+      return
+    }
+
+    const item = event.target.closest('[data-drag-and-drop-target~="item"]')
+    const container = item?.closest('[data-drag-and-drop-target~="container"]')
+    if (!item || !container) return
+
+    this.draggedItem = item
+    this.sourceContainer = container
+    this.justDragged = true
+
+    item.removeAttribute("aria-selected")
+    if (document.activeElement === item) item.blur()
+    item.classList.add(this.#draggedItemClass)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.dataset.id || item.id)
+    }
+  }
+
+  dragEnter(event) {
+    this.#handleHover(event)
+  }
+
+  dragOver(event) {
+    this.#handleHover(event)
+  }
+
+  dragLeave(event) {
+    if (!this.draggedItem || !this.hoverContainer) return
+    if (event.relatedTarget && this.hoverContainer.contains(event.relatedTarget)) return
+    if (!event.relatedTarget && (event.clientX !== 0 || event.clientY !== 0) && this.#isPointInside(this.hoverContainer, event.clientX, event.clientY)) return
+
+    if (this.hoverContainer.contains(event.target)) {
+      this.#clearHoverContainer()
+    }
+  }
+
+  drop(event) {
+    if (!this.draggedItem) return
+
+    const targetContainer = event.target.closest('[data-drag-and-drop-target~="container"]')
+    const item = this.draggedItem
+    const sourceContainer = this.sourceContainer
+
+    this.#cleanup()
+    this.#clearJustDraggedSoon()
+
+    if (!targetContainer || targetContainer === sourceContainer) return
+
+    event.preventDefault()
+
+    const frameWasLoaded = !!targetContainer.querySelector(".cards__list")
+    this.#moveItem(item, sourceContainer, targetContainer)
+    this.#saveDrop(item, targetContainer, frameWasLoaded)
+  }
+
+  dragEnd() {
+    this.#cleanup()
+    this.#clearJustDraggedSoon()
+  }
+
+  // Private
+
+  get #isDesktop() {
+    return this.mediaQuery ? this.mediaQuery.matches : true
+  }
+
+  get #draggedItemClass() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : DEFAULT_DRAGGED_ITEM_CLASS
+  }
+
+  get #hoverContainerClass() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : DEFAULT_HOVER_CONTAINER_CLASS
+  }
+
+  #shouldIgnoreDragStart(event) {
+    return !!event.target.closest("dialog[open], input, textarea, select, [contenteditable]")
+  }
+
+  #preventPostDragClick(event) {
+    if (this.justDragged) {
+      event.preventDefault()
+      event.stopImmediatePropagation()
+      this.justDragged = false
+    }
+  }
+
+  #clearJustDraggedSoon() {
+    setTimeout(() => { this.justDragged = false }, 100)
+  }
+
+  #updateDraggableItems() {
+    this.itemTargets.forEach(item => this.#configureItem(item))
+    if (!this.#isDesktop) this.#cleanup()
+  }
+
+  #configureItem(item) {
+    item.draggable = this.#isDesktop
+    item.querySelectorAll("a, img").forEach(element => element.draggable = false)
+  }
+
+  #handleHover(event) {
+    if (!this.draggedItem) return
+
+    const container = event.target.closest('[data-drag-and-drop-target~="container"]')
+    if (!container || container === this.sourceContainer) {
+      this.#clearHoverContainer()
+      return
+    }
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+    this.#setHoverContainer(container)
+  }
+
+  #setHoverContainer(container) {
+    if (this.hoverContainer === container) return
+
+    this.#clearHoverContainer()
+    this.hoverContainer = container
+    this.hoverContainer.classList.add(this.#hoverContainerClass)
+  }
+
+  #clearHoverContainer() {
+    if (this.hoverContainer) {
+      this.hoverContainer.classList.remove(this.#hoverContainerClass)
+      this.hoverContainer = null
+    }
+  }
+
+  #cleanup() {
+    if (this.draggedItem) {
+      this.draggedItem.classList.remove(this.#draggedItemClass)
+      this.draggedItem = null
+    }
+    this.sourceContainer = null
+    this.#clearHoverContainer()
+  }
+
+  #isPointInside(element, x, y) {
+    const rect = element.getBoundingClientRect()
+    return x > rect.left && x < rect.right && y > rect.top && y < rect.bottom
+  }
+
+  #moveItem(item, sourceContainer, targetContainer) {
+    this.#updateItemAppearance(item, targetContainer)
+
+    const list = targetContainer.querySelector(".cards__list")
+    if (list) {
+      this.#insertIntoList(item, list, targetContainer)
+    } else {
+      item.remove()
+    }
+
+    this.#adjustCount(sourceContainer, -1)
+    this.#adjustCount(targetContainer, 1)
+  }
+
+  #updateItemAppearance(item, targetContainer) {
+    const cardColor = targetContainer.dataset.dragAndDropCardColor
+    if (cardColor) {
+      item.style.setProperty("--card-color", cardColor)
+    }
+
+    const status = targetContainer.dataset.dragAndDropStatus
+    item.classList.toggle("card--active", status === "active")
+    item.classList.toggle("card--postponed", status === "postponed")
+
+    item.querySelector(".card__closed")?.remove()
+    item.querySelector(".bubble")?.remove()
+    item.querySelector('[id^="assignees_card_"]')?.toggleAttribute("hidden", status === "closed")
+    item.removeAttribute("aria-selected")
+
+    const updatedTime = item.querySelector(".card__meta-text--updated [datetime]")
+    if (updatedTime) {
+      updatedTime.setAttribute("datetime", Math.floor(Date.now() / 1000))
+      updatedTime.dispatchEvent(new Event("turbo:morph-element"))
+    }
+  }
+
+  #insertIntoList(item, list, targetContainer) {
+    const goldenFirst = targetContainer.dataset.dragAndDropGoldenFirst === "true"
+    const isGolden = item.classList.contains("golden-effect")
+
+    if (goldenFirst && !isGolden) {
+      const firstNonGoldenCard = list.querySelector('[data-drag-and-drop-target~="item"]:not(.golden-effect)')
+      if (firstNonGoldenCard) {
+        firstNonGoldenCard.before(item)
+        return
+      }
+
+      const goldenCards = list.querySelectorAll('[data-drag-and-drop-target~="item"].golden-effect')
+      if (goldenCards.length > 0) {
+        goldenCards[goldenCards.length - 1].after(item)
+        return
+      }
+    }
+
+    const firstCard = list.querySelector('[data-drag-and-drop-target~="item"]')
+    if (firstCard) {
+      firstCard.before(item)
+    } else {
+      list.prepend(item)
+    }
+  }
+
+  #adjustCount(container, delta) {
+    if (!container) return
+
+    const countElement = container.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const currentCount = parseInt(countElement.dataset.count ?? countElement.textContent, 10)
+    if (Number.isNaN(currentCount)) return
+
+    const nextCount = Math.max(0, currentCount + delta)
+    countElement.dataset.count = nextCount
+    countElement.textContent = nextCount > 99 ? "99+" : nextCount
+
+    const expanderButton = container.querySelector('[data-css-variable-counter-target~="counter"]')
+    if (expanderButton) {
+      expanderButton.style.setProperty("--card-count", Math.min(nextCount, 15))
+    }
+  }
+
+  #saveDrop(item, targetContainer, frameWasLoaded) {
+    const urlTemplate = targetContainer.dataset.dragAndDropUrl
+    const cardId = item.dataset.id
+    if (!urlTemplate || !cardId) return
+
+    const url = urlTemplate.replace("__ID__", encodeURIComponent(cardId))
+    const method = targetContainer.dataset.dragAndDropMethod || "post"
+
+    this.#saveQueue = this.#saveQueue
+      .then(async () => {
+        const request = new FetchRequest(method, url, {
+          responseKind: "json",
+          keepalive: true
+        })
+        await request.perform()
+
+        if (!frameWasLoaded) {
+          targetContainer.querySelector("turbo-frame[src]")?.reload()
+        }
+      })
+      .catch(error => console.error(error))
+  }
+}
