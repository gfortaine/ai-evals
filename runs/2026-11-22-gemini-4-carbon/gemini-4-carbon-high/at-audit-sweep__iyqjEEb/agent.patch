+    assert_response :forbidden
+
+    sign_out
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:manual))
+    end
+    assert_redirected_to new_session_url
+  end
 end
diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..8e7c63f 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,65 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "pages of an unreadable book stay unreadable regardless of book id in URL" do
+    secret_page, secret_section, secret_picture = create_unreadable_manual_leaves
+
+    get slugged_leafable_path(books(:handbook), books(:handbook).slug, secret_page, secret_page.slug)
+    assert_response :not_found
+    assert_not_in_body secret_page.leafable.body.content
+
+    get slugged_leafable_path(books(:handbook), books(:handbook).slug, secret_page, secret_page.slug, format: :md)
+    assert_response :not_found
+    assert_not_in_body secret_page.leafable.body.content
+
+    get slugged_leafable_path(books(:manual), books(:manual).slug, secret_page, secret_page.slug)
+    assert_response :not_found
+
+    get book_page_path(books(:handbook), secret_page)
+    assert_response :not_found
+
+    get book_section_path(books(:handbook), secret_section)
+    assert_response :not_found
+
+    get book_picture_path(books(:handbook), secret_picture)
+    assert_response :not_found
+
+    get edit_book_page_path(books(:handbook), secret_page)
+    assert_response :not_found
+
+    put book_page_path(books(:handbook), secret_page), params: { page: { body: "Overwritten" } }
+    assert_response :not_found
+    assert_equal "Top secret manual content", secret_page.reload.leafable.body.content
+
+    delete book_page_path(books(:handbook), secret_page)
+    assert_response :not_found
+    assert secret_page.reload.active?
+  end
+
+  test "signed out users cannot read unpublished pages via published book id while readable pages stay readable" do
+    sign_out
+    books(:handbook).update!(published: true)
+    secret_page, _ = create_unreadable_manual_leaves
+
+    get slugged_leafable_path(books(:handbook), books(:handbook).slug, secret_page, secret_page.slug)
+    assert_response :not_found
+    assert_not_in_body secret_page.leafable.body.content
+
+    get book_page_path(books(:handbook), secret_page)
+    assert_response :not_found
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+    assert_select "p", "This is such a great handbook."
+  end
+
+  private
+    def create_unreadable_manual_leaves
+      [
+        books(:manual).press(Page.new(body: "Top secret manual content"), title: "Secret Manual Page"),
+        books(:manual).press(Section.new(body: "Secret section content"), title: "Secret Manual Section"),
+        books(:manual).press(Picture.new(caption: "Secret picture caption"), title: "Secret Manual Picture")
+      ]
+    end
 end
diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..83ffef6
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "finds matching pages in readable books" do
+    get library_search_path(q: "Welcome")
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+  end
+
+  test "does not return pages from unreadable books even with SQL injection payloads" do
+    books(:manual).press Page.new(body: "Secret body"), title: "Confidential Manual Page"
+
+    [ "Confidential", "z' OR '1'='1", "z' OR 1=1 --", "') OR 1=1 --", "\" OR 1=1 --", "a' UNION SELECT * FROM leaves --" ].each do |query|
+      get library_search_path(q: query)
+
+      assert_response :success
+      assert_not_in_body "Confidential Manual Page"
+    end
+  end
+
+  test "returns pages from published books and excludes unpublished unreadable books" do
+    books(:manual).press Page.new(body: "Secret body"), title: "Confidential Manual Page"
+    published_book = Book.create!(title: "Public Guide", published: true, everyone_access: false)
+    published_book.press Page.new(body: "Public body"), title: "Public Guide Intro"
+
+    get library_search_path(q: "Public Guide Intro")
+    assert_response :success
+    assert_in_body "Public Guide Intro"
+    assert_not_in_body "Confidential Manual Page"
+
+    sign_out
+
+    get library_search_path(q: "Public Guide Intro")
+    assert_response :success
+    assert_in_body "Public Guide Intro"
+
+    [ "Welcome", "Confidential", "z' OR '1'='1", "z' OR 1=1 --" ].each do |query|
+      get library_search_path(q: query)
+      assert_response :success
+      assert_not_in_body "Confidential Manual Page"
+      assert_not_in_body "Welcome to The Handbook!"
+    end
+  end
+
+  test "treats apostrophes, backslashes, and punctuation as literal characters without error" do
+    books(:handbook).press Page.new(body: "Details"), title: "What's New?"
+    books(:handbook).press Page.new(body: "Paths"), title: "C:\\Users\\Docs"
+
+    get library_search_path(q: "'")
+    assert_response :success
+    assert_select ".search__result", text: /What's New\?/
+
+    get library_search_path(q: "What's")
+    assert_response :success
+    assert_select ".search__result", text: /What's New\?/
+
+    get library_search_path(q: "don't")
+    assert_response :success
+    assert_in_body "No matches."
+
+    get library_search_path(q: "!")
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+
+    get library_search_path(q: "\\")
+    assert_response :success
+    assert_in_body "C:\\Users\\Docs"
+    assert_not_in_body "Welcome to The Handbook!"
+
+    [ "\"", ";", "--", "/*", "\\%", "\\_" ].each do |query|
+      get library_search_path(q: query)
+      assert_response :success
+      assert_in_body "No matches."
+    end
+  end
+
+  test "percent sign is matched literally rather than acting as a wildcard" do
+    books(:handbook).press Page.new(body: "Discount details"), title: "Save 50% off"
+    books(:handbook).press Page.new(body: "Other details"), title: "Save 500 off"
+
+    get library_search_path(q: "Save 50% off")
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save 500 off"
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path(q: "%")
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save 500 off"
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Summary"
+  end
+
+  test "underscore is matched literally rather than acting as a wildcard" do
+    books(:handbook).press Page.new(body: "Snake case"), title: "snake_case_page"
+    books(:handbook).press Page.new(body: "Spaced"), title: "snake case page"
+
+    get library_search_path(q: "_")
+    assert_response :success
+    assert_in_body "snake_case_page"
+    assert_not_in_body "snake case page"
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Summary"
+
+    get library_search_path(q: "snake_case_page")
+    assert_response :success
+    assert_in_body "snake_case_page"
+    assert_not_in_body "snake case page"
+  end
+
+  test "handles blank and non-string query parameters safely" do
+    get library_search_path
+    assert_response :success
+    assert_select ".search__result", count: 0
+
+    get library_search_path(q: "   ")
+    assert_response :success
+    assert_select ".search__result", count: 0
+
+    get library_search_path(q: [ "Welcome" ])
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+end
