new file mode 100644
index 0000000..910969b
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,50 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render partial: "cards/comments/reactions/reaction", locals: { reaction: @reaction }, status: :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_delete_controller.js b/app/javascript/controllers/reaction_delete_controller.js
new file mode 100644
index 0000000..1010135
--- /dev/null
+++ b/app/javascript/controllers/reaction_delete_controller.js
@@ -0,0 +1,51 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { reacterId: String }
+  static classes = [ "deleteable", "expanded", "deleting" ]
+
+  connect() {
+    this.refresh()
+  }
+
+  refresh() {
+    if (this.#canDelete) {
+      this.element.classList.add(this.deleteableClass)
+      this.element.setAttribute("role", "button")
+      this.element.setAttribute("tabindex", "0")
+    } else {
+      this.element.classList.remove(this.deleteableClass, this.expandedClass)
+      this.element.removeAttribute("role")
+      this.element.removeAttribute("tabindex")
+    }
+  }
+
+  toggle(event) {
+    if (!this.#canDelete || event.target.closest("form")) return
+
+    this.element.classList.toggle(this.expandedClass)
+  }
+
+  toggleKey(event) {
+    if (!this.#canDelete || event.target.closest("form")) return
+
+    event.preventDefault()
+    this.element.classList.toggle(this.expandedClass)
+  }
+
+  close() {
+    this.element.classList.remove(this.expandedClass)
+  }
+
+  closeOnClickOutside({ target }) {
+    if (!this.element.contains(target)) this.close()
+  }
+
+  markDeleting() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  get #canDelete() {
+    return Boolean(window.Current?.user && window.Current.user.id === this.reacterIdValue)
+  }
+}
diff --git a/app/javascript/controllers/reaction_emoji_controller.js b/app/javascript/controllers/reaction_emoji_controller.js
new file mode 100644
index 0000000..cafb7f5
--- /dev/null
+++ b/app/javascript/controllers/reaction_emoji_controller.js
@@ -0,0 +1,52 @@
+import { Controller } from "@hotwired/stimulus"
+
+const segmenter = typeof Intl !== "undefined" && Intl.Segmenter ? new Intl.Segmenter() : null
+
+function splitGraphemes(text) {
+  if (segmenter) {
+    return Array.from(segmenter.segment(text), segment => segment.segment)
+  } else {
+    return Array.from(text)
+  }
+}
+
+export default class extends Controller {
+  static targets = [ "input" ]
+  static values = { maxLength: { type: Number, default: 16 } }
+
+  connect() {
+    if (this.hasInputTarget) {
+      this.inputTarget.focus()
+    }
+  }
+
+  insert(event) {
+    const emoji = event.currentTarget.value
+    const input = this.inputTarget
+    const start = input.selectionStart ?? input.value.length
+    const end = input.selectionEnd ?? input.value.length
+
+    const before = input.value.slice(0, start)
+    const after = input.value.slice(end)
+    const combined = splitGraphemes(before + emoji + after).slice(0, this.maxLengthValue).join("")
+
+    input.value = combined
+    input.setCustomValidity("")
+
+    const cursor = Math.min(before.length + emoji.length, combined.length)
+    input.focus()
+    input.setSelectionRange(cursor, cursor)
+    input.dispatchEvent(new Event("input", { bubbles: true }))
+  }
+
+  enforceMaxLength(event) {
+    if (event?.isComposing) return
+
+    const input = this.inputTarget
+    const graphemes = splitGraphemes(input.value)
+
+    if (graphemes.length > this.maxLengthValue) {
+      input.value = graphemes.slice(0, this.maxLengthValue).join("")
+    }
+  }
+}
