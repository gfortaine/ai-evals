+<%= turbo_frame_tag @comment, :new_reaction do %>
+  <%= form_with model: [ @card, @comment, Reaction.new ],
+        class: "reaction reaction__form expanded",
+        data: {
+          controller: "form reaction-emoji morph-guard",
+          action: "keydown.esc->form#cancel submit->form#preventEmptySubmit submit->form#preventComposingSubmit"
+        } do |form| %>
+    <label class="reaction__form-label flex align-center gap-half" for="<%= dom_id(@comment, :reaction_content) %>">
+      <figure class="reaction__avatar margin-none flex-item-no-shrink">
+        <%= avatar_tag Current.user, hidden_for_screen_reader: true, class: "non-clickable" %>
+      </figure>
+
+      <span class="for-screen-reader">Add your own reaction</span>
+
+      <%= form.text_field :content,
+            id: dom_id(@comment, :reaction_content),
+            autofocus: true,
+            autocomplete: "off",
+            autocorrect: "off",
+            required: true,
+            class: "input reaction__input txt-small",
+            style: "field-sizing: content",
+            data: {
+              "1p-ignore": "true",
+              form_target: "input",
+              reaction_emoji_target: "input",
+              action: "input->reaction-emoji#enforceMaxLength compositionstart->form#compositionStart compositionend->form#compositionEnd compositionend->reaction-emoji#enforceMaxLength"
+            } %>
+    </label>
+
+    <div class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <%= button_tag type: "button", class: "reaction__menu-btn btn borderless fill-transparent", data: { action: "dialog#toggle" } do %>
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Quick reaction menu</span>
+      <% end %>
+
+      <dialog class="reaction__popup popup panel shadow dialog" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <%= button_tag type: "button",
+                  class: "btn btn--circle borderless fill-transparent",
+                  value: emoji,
+                  title: label,
+                  data: { action: "dialog#close reaction-emoji#insert" } do %>
+              <%= emoji %>
+              <span class="for-screen-reader"><%= label %></span>
+            <% end %>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button type: :submit, class: "reaction__submit-btn btn borderless fill-transparent", data: { form_target: "submit" } do %>
+      <%= icon_tag "check-circle" %>
+      <span class="for-screen-reader">Submit reaction</span>
+    <% end %>
+
+    <%= link_to card_comment_reactions_path(@card, @comment),
+          class: "reaction__cancel-btn btn borderless fill-transparent",
+          role: "button",
+          data: { form_target: "cancel" } do %>
+      <%= icon_tag "close-circle" %>
+      <span class="for-screen-reader">Cancel reaction</span>
+    <% end %>
+  <% end %>
+<% end %>
