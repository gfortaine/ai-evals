+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  PUBLIC_IP = "93.184.216.34"
+
+  setup do
+    stub_dns_resolution(PUBLIC_IP)
+    Current.session = sessions(:david)
+  end
+
+  test "creating an event enqueues Event::RelayJob" do
+    assert_enqueued_with(job: Event::RelayJob) do
+      boards(:writebook).cards.create!(title: "Ship webhooks", status: :published)
+    end
+  end
+
+  test "relaying triggers active subscribed webhooks on the board and delivers POST once" do
+    active_webhook = webhooks(:active)
+    unsubscribed_webhook = Webhook.create!(
+      board: boards(:writebook),
+      name: "Comments Only",
+      url: "https://comments.example.com/webhooks",
+      subscribed_actions: [ "comment_created" ]
+    )
+    inactive_same_board = Webhook.create!(
+      board: boards(:writebook),
+      name: "Switched Off",
+      url: "https://off.example.com/webhooks",
+      subscribed_actions: [ "card_published" ],
+      active: false
+    )
+
+    active_stub = stub_request(:post, active_webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 200)
+    unsubscribed_stub = stub_request(:post, unsubscribed_webhook.url).to_return(status: 200)
+    inactive_stub = stub_request(:post, inactive_same_board.url).to_return(status: 200)
+
+    assert_difference -> { active_webhook.deliveries.count }, 1 do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        boards(:writebook).cards.create!(title: "Ship webhooks", status: :published)
+      end
+    end
+
+    assert_requested active_stub, times: 1
+    assert_not_requested unsubscribed_stub
+    assert_not_requested inactive_stub
+    assert_equal 0, unsubscribed_webhook.deliveries.count
+    assert_equal 0, inactive_same_board.deliveries.count
+  end
+end
