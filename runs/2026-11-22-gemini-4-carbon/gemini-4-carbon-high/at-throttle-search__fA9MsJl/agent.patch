index 0000000..a40832d
--- /dev/null
+++ b/lib/search_rate_limit_store.rb
@@ -0,0 +1,123 @@
+require "fileutils"
+require "json"
+
+class SearchRateLimitStore
+  MAX_REQUESTS = 30
+  WINDOW = 1.minute
+  MAX_TRACKED_KEYS = 10_000
+
+  def self.instance
+    @instance ||= new
+  end
+
+  def initialize(limit: MAX_REQUESTS, path: Rails.root.join("tmp", "cache", "search_rate_limits.json"))
+    @limit = limit
+    @path = path
+    @mutex = Mutex.new
+    @memory_only = false
+    @memory_state = {}
+  end
+
+  def use_memory_store!
+    @mutex.synchronize do
+      @memory_only = true
+      @memory_state.clear
+    end
+  end
+
+  def increment(key, amount = 1, expires_in: WINDOW, **)
+    now_us = current_time_us
+    cutoff_us = now_us - (expires_in.to_r * 1_000_000).to_i
+
+    with_state do |state|
+      dirty = prune_expired(state, cutoff_us)
+
+      timestamps = state[key]
+      current_count = timestamps ? timestamps.length : 0
+
+      if current_count + amount <= @limit
+        timestamps ||= (state[key] = [])
+        amount.times { timestamps << now_us }
+        evict_oldest_keys(state) if state.size > MAX_TRACKED_KEYS
+        [ timestamps.length, true ]
+      else
+        [ current_count + amount, dirty ]
+      end
+    end
+  end
+
+  def clear
+    @mutex.synchronize do
+      @memory_state.clear
+      return if @memory_only || !File.exist?(@path)
+
+      File.open(@path, File::RDWR | File::CREAT, 0o600) do |file|
+        file.flock(File::LOCK_EX)
+        file.truncate(0)
+      end
+    end
+  end
+
+  private
+    def with_state
+      @mutex.synchronize do
+        if @memory_only
+          result, _dirty = yield(@memory_state)
+          result
+        else
+          FileUtils.mkdir_p(@path.dirname)
+          File.open(@path, File::RDWR | File::CREAT, 0o600) do |file|
+            file.binmode
+            file.flock(File::LOCK_EX)
+
+            state = load_state(file.read)
+            result, dirty = yield(state)
+
+            if dirty
+              payload = state.empty? ? "" : JSON.generate(state)
+              file.rewind
+              file.write(payload)
+              file.flush
+              file.truncate(payload.bytesize)
+            end
+
+            result
+          end
+        end
+      end
+    end
+
+    def load_state(raw)
+      return {} if raw.empty?
+      loaded = JSON.parse(raw)
+      loaded.is_a?(Hash) ? loaded : {}
+    rescue JSON::ParserError, TypeError
+      {}
+    end
+
+    def prune_expired(state, cutoff_us)
+      dirty = false
+
+      state.each do |tracked_key, timestamps|
+        before = timestamps.length
+        timestamps.select! { |ts| ts > cutoff_us }
+        dirty = true if timestamps.length != before
+        state.delete(tracked_key) if timestamps.empty?
+      end
+
+      dirty
+    end
+
+    def evict_oldest_keys(state)
+      excess = state.size - MAX_TRACKED_KEYS
+      return if excess <= 0
+
+      state.sort_by { |_, timestamps| timestamps.last || 0 }.first(excess).each do |oldest_key, _|
+        state.delete(oldest_key)
+      end
+    end
+
+    def current_time_us
+      (Time.now.to_r * 1_000_000).to_i
+    end
+end
