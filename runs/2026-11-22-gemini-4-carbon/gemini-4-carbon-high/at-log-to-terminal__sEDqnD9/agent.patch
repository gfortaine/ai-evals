+require "test_helper"
+require "open3"
+require "tmpdir"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  test "runner shows library report on stdout and records it in development log" do
+    expected = expected_report_lines
+
+    stdout, logged, status = run_library_report("-e", "development")
+
+    assert_predicate status, :success?
+    assert_equal expected, report_lines(stdout)
+    assert_equal expected, report_lines(logged)
+  end
+
+  test "runner respects LOG_LEVEL severities on stdout and in development log" do
+    expected = [ "Library report: #{books(:manual).title} has no pages" ]
+
+    stdout, logged, status = run_library_report("-e", "development", env: { "LOG_LEVEL" => "warn" })
+
+    assert_predicate status, :success?
+    assert_equal expected, stdout.lines.map(&:chomp)
+    assert_equal expected, report_lines(logged)
+  end
+
+  test "runner does not duplicate lines when environment logger already outputs to stdout" do
+    expected = expected_report_lines
+
+    stdout, _logged, status = run_library_report(
+      "-e", "production",
+      env: { "SECRET_KEY_BASE" => "test-secret-key-base" }
+    )
+
+    assert_predicate status, :success?
+    assert_equal expected, report_lines(stdout)
+  end
+
+  private
+    def expected_report_lines
+      ordered_books = Book.order(:id).to_a
+
+      lines = [ "Library report: #{ordered_books.size} books" ]
+      ordered_books.each do |book|
+        pages = book.leaves.count
+        if pages.zero?
+          lines << "Library report: #{book.title} has no pages"
+        else
+          lines << "Library report: #{book.title} has #{pages} #{"page".pluralize(pages)}"
+        end
+      end
+      lines << "Library report: done"
+    end
+
+    def report_lines(output)
+      output.lines.filter_map { |line| line[/Library report: .*/] }
+    end
+
+    def run_library_report(*args, env: {})
+      lock_path = Rails.root.join("tmp/library_report_test.lock")
+      FileUtils.mkdir_p(lock_path.dirname)
+
+      File.open(lock_path, File::CREAT | File::RDWR) do |lock|
+        lock.flock(File::LOCK_EX)
+
+        Dir.mktmpdir do |dir|
+          db_path = File.join(dir, "library.sqlite3")
+          backup_current_database_to(db_path)
+
+          env_index = args.index("-e")
+          rails_env = env_index ? args[env_index + 1] : "development"
+          log_path = Rails.root.join("log/#{rails_env}.log")
+          offset = log_path.exist? ? log_path.size : 0
+
+          runner_env = {
+            "DATABASE_URL" => "sqlite3:#{db_path}",
+            "RAILS_ENV" => nil,
+            "TEST_ENV_NUMBER" => nil
+          }.merge(env)
+
+          stdout, _stderr, status = Open3.capture3(
+            runner_env,
+            Rails.root.join("bin/rails").to_s, "runner", *args, "script/library_report.rb",
+            chdir: Rails.root.to_s
+          )
+
+          logged = log_path.exist? ? File.binread(log_path, nil, offset).force_encoding("UTF-8") : ""
+          [ stdout, logged, status ]
+        end
+      end
+    end
+
+    def backup_current_database_to(dest_path)
+      dest = SQLite3::Database.new(dest_path)
+      backup = SQLite3::Backup.new(dest, "main", ActiveRecord::Base.connection.raw_connection, "main")
+      backup.step(-1)
+      backup.finish
+    ensure
+      dest&.close
+    end
+end
