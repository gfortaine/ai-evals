+  # Accept per-form CSRF tokens even while per_form_csrf_tokens is false so
+  # forms rendered on Rails 7.0 remain valid after a rollback to Rails 6.1.
+  def valid_per_form_csrf_token?(token, session)
+    correct_token = per_form_csrf_token(
+      session,
+      request.path.chomp('/'),
+      request.request_method
+    )
+    ActiveSupport::SecurityUtils.fixed_length_secure_compare(token, correct_token)
+  end
+  private :valid_per_form_csrf_token?
+
   def handle_unverified_request
     unless api_request?
       begin
@@ -550,8 +562,12 @@ class ApplicationController < ActionController::Base
 
   # Redirects to the request referer if present, redirects to args or call block otherwise.
   def redirect_to_referer_or(*args, &block)
-    if referer = request.headers["Referer"]
-      redirect_to referer
+    if (referer = request.headers["Referer"]).present? && referer_on_same_host?(referer)
+      if Rails.gem_version >= Gem::Version.new('7.0')
+        redirect_to referer, allow_other_host: true
+      else
+        redirect_to referer
+      end
     else
       if args.any?
         redirect_to *args
@@ -563,6 +579,18 @@ class ApplicationController < ActionController::Base
     end
   end
 
+  def referer_on_same_host?(referer)
+    uri = Addressable::URI.parse(referer.to_s)
+    if uri.host.present?
+      uri.host == request.host && %w[http https].include?(uri.scheme)
+    else
+      uri.scheme.nil? && referer.to_s.start_with?('/') && !referer.to_s.start_with?('//')
+    end
+  rescue Addressable::URI::InvalidURIError
+    false
+  end
+  private :referer_on_same_host?
+
