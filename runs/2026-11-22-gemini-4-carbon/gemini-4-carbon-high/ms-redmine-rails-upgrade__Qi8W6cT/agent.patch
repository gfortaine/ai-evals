+  def test_session_and_autologin_cookies_compatible_across_upgrade_and_rollback_with_rails_72
+    user = User.find(2)
+    ad = Rails.application.config.action_dispatch
+    secret = derive_key(ad.authenticated_encrypted_cookie_salt, 32, OpenSSL::Digest::SHA256)
+    rails72_encryptor = ActiveSupport::MessageEncryptor.new(
+      secret,
+      cipher: 'aes-256-gcm',
+      serializer: ActiveSupport::MessageEncryptor::NullSerializer
+    )
+
+    # 1. Upgrade: session cookie written by deployed Rails 7.2 keeps user signed in on Rails 8.1
+    session_token = user.generate_session_token
+    rails72_json = "{\"session_id\":\"#{SecureRandom.hex(16)}\",\"user_id\":#{user.id},\"tk\":\"#{session_token}\",\"note\":\"x\\u2028y\\u2029\"}"
+    sess = open_session
+    sess.cookies['_redmine_session'] = rails72_encryptor.encrypt_and_sign(
+      rails72_json,
+      purpose: 'cookie._redmine_session'
+    )
+    sess.get '/my/account'
+    assert_equal 200, sess.response.status
+    sess.assert_select 'input[name="user[mail]"][value=?]', user.mail
+
+    # 2. Autologin cookie issued before upgrade/rollback keeps user signed in without session cookie
+    with_settings :autologin => '7' do
+      autologin_value = Token.create!(:user => user, :action => 'autologin').value
+      auto_sess = open_session
+      auto_sess.cookies['autologin'] = autologin_value
+      auto_sess.get '/my/account'
+      assert_equal 200, auto_sess.response.status
+
+      # 3. Rollback: session cookie emitted by Rails 8.1 decrypts and parses on deployed Rails 7.2
+      login_sess = open_session
+      login_sess.post '/login', :params => {
+        :username => 'jsmith',
+        :password => 'jsmith',
+        :autologin => '1'
+      }
+      assert_equal 302, login_sess.response.status
+      login_sess.get '/issues', :params => {:set_filter => '1', :f => ['subject'], :op => {'subject' => '~'}, :v => {'subject' => ["sep\u2028\u2029"]}}
+      assert_equal 200, login_sess.response.status
+      raw_cookie = login_sess.cookies['_redmine_session']
+      decrypted_json = rails72_encryptor.decrypt_and_verify(raw_cookie, purpose: 'cookie._redmine_session')
+      decoded_session = ActiveSupport::JSON.decode(decrypted_json)
+
+      assert_includes decrypted_json.force_encoding(Encoding::UTF_8), "\u2028\u2029"
+      assert_equal user.id, decoded_session['user_id']
+      assert Token.where(:user_id => user.id, :value => decoded_session['tk'], :action => 'session').exists?
+      assert Token.where(:user_id => user.id, :value => login_sess.cookies['autologin'], :action => 'autologin').exists?
+    end
+  end
