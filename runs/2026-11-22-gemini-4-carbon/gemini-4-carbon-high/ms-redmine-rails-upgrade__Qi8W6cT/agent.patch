diff --git a/test/integration/upgrade_compatibility_test.rb b/test/integration/upgrade_compatibility_test.rb
new file mode 100644
index 0000000..cacd4a6
--- /dev/null
+++ b/test/integration/upgrade_compatibility_test.rb
@@ -0,0 +1,350 @@
+# frozen_string_literal: true
+
+require File.expand_path('../test_helper', __dir__)
+
+class UpgradeCompatibilityTest < Redmine::IntegrationTest
+  fixtures :projects, :users, :email_addresses, :user_preferences, :roles, :members, :member_roles,
+           :trackers, :projects_trackers, :issue_statuses, :enumerations, :issues, :journals, :journal_details,
+           :enabled_modules, :watchers, :tokens
+
+  def setup
+    Rails.application.config.redmine_verify_sessions = true
+  end
+
+  def teardown
+    Rails.application.config.redmine_verify_sessions = false
+  end
+
+  def test_framework_defaults_81_active_and_temporary_overrides_retired
+    cfg = Rails.application.config
+
+    assert_equal 8.1, cfg.loaded_config_version
+    assert_equal :json, cfg.action_dispatch.cookies_serializer
+    assert_equal :json_allow_marshal, cfg.active_support.message_serializer
+    assert_equal true, cfg.active_support.use_message_serializer_for_metadata
+    assert_equal false, cfg.active_support.escape_js_separators_in_json
+    assert_equal :raise, cfg.action_controller.action_on_path_relative_redirect
+    assert_equal false, cfg.active_record.belongs_to_required_by_default
+    assert_empty cfg.action_dispatch.cookies_rotations.encrypted
+    assert_empty cfg.action_dispatch.cookies_rotations.signed
+
+    # Retired pre-7.0 SHA1 mail_links tokens are no longer accepted
+    Issue.find(2).set_watcher(User.find(3), true)
+    sha1_secret = derive_key('mail_links', 64, OpenSSL::Digest::SHA1)
+    sha1_envelope = ActiveSupport::JSON.encode(
+      '_rails' => {
+        'data' => {'user_id' => 3, 'issue_id' => 2},
+        'exp' => 30.days.from_now.utc.iso8601(3),
+        'pur' => 'unwatch'
+      }
+    )
+    get '/mail_links/unwatch', :params => {:token => sign_raw_message(sha1_envelope, sha1_secret)}
+    assert_response :not_found
+    assert Issue.find(2).watched_by?(User.find(3))
+  end
+
+  def test_mail_links_accept_deployed_rails_72_and_70_sha256_tokens_and_reject_invalid_tokens
+    secret = derive_key('mail_links', 64, OpenSSL::Digest::SHA256)
+
+    # 1. Deployed Rails 7.2 default format (_rails.data JSON with escaped JS separators)
+    Issue.find(2).set_watcher(User.find(3), true)
+    envelope72 = "{\"_rails\":{\"data\":{\"user_id\":3,\"issue_id\":2,\"note\":\"a\\u2028b\\u2029\"},\"exp\":\"#{30.days.from_now.utc.iso8601(3)}\",\"pur\":\"unwatch\"}}"
+    get '/mail_links/unwatch', :params => {:token => sign_raw_message(envelope72, secret)}
+    assert_response :success
+    assert_not Issue.find(2).watched_by?(User.find(3))
+
+    # 2. Rails 8.1 default format (_rails.data JSON with raw UTF-8 U+2028/U+2029), strict & URL-safe Base64
+    [false, true].each do |url_safe|
+      Issue.find(2).set_watcher(User.find(3), true)
+      envelope81 = "{\"_rails\":{\"data\":{\"user_id\":3,\"issue_id\":2,\"note\":\"a\u2028b\u2029\"},\"exp\":\"#{30.days.from_now.utc.iso8601(3)}\",\"pur\":\"unwatch\"}}"
+      token81 = sign_raw_message(envelope81, secret, url_safe: url_safe)
+      get '/mail_links/unwatch', :params => {:token => token81}
+      assert_response :success
+      assert_not Issue.find(2).watched_by?(User.find(3))
+    end
+
+    # 3. Legacy _rails.message Marshal & JSON envelopes signed with SHA256 (via :json_allow_marshal)
+    [
+      Marshal.dump('user_id' => 3, 'issue_id' => 2),
+      ActiveSupport::JSON.encode({'user_id' => 3, 'issue_id' => 2})
+    ].each do |inner_payload|
+      Issue.find(2).set_watcher(User.find(3), true)
+      legacy_envelope = ActiveSupport::JSON.encode(
+        '_rails' => {
+          'message' => Base64.strict_encode64(inner_payload),
+          'exp' => 30.days.from_now.utc.iso8601(3),
+          'pur' => 'unwatch'
+        }
+      )
+      get '/mail_links/unwatch', :params => {:token => sign_raw_message(legacy_envelope, secret)}
