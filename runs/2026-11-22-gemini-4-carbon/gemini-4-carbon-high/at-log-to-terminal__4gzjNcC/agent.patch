@@ -0,0 +1,63 @@
+require "test_helper"
+require "open3"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  EXPECTED_REPORT = [
+    "Library report: 2 books",
+    "Library report: Manual has no pages",
+    "Library report: Handbook has 4 pages",
+    "Library report: done"
+  ]
+
+  test "prints report to terminal and records it in development log" do
+    stdout, logged, status = run_library_report
+
+    assert_predicate status, :success?
+    assert_equal EXPECTED_REPORT, report_lines(stdout)
+    assert_equal EXPECTED_REPORT, report_lines(logged)
+  end
+
+  test "respects LOG_LEVEL across terminal and development log" do
+    stdout, logged, status = run_library_report("LOG_LEVEL" => "info")
+
+    assert_predicate status, :success?
+    assert_equal EXPECTED_REPORT, report_lines(stdout)
+    assert_equal EXPECTED_REPORT, report_lines(logged)
+    assert_no_match(/SELECT/, stdout)
+    assert_no_match(/SELECT/, logged)
+
+    stdout, logged, status = run_library_report("LOG_LEVEL" => "warn")
+
+    assert_predicate status, :success?
+    assert_equal [ "Library report: Manual has no pages" ], report_lines(stdout)
+    assert_equal [ "Library report: Manual has no pages" ], report_lines(logged)
+  end
+
+  private
+    def run_library_report(env = {})
+      log_path = Rails.root.join("log/development.log")
+      lock_path = Rails.root.join("tmp/library_report_test.lock")
+      FileUtils.mkdir_p([ log_path.dirname, lock_path.dirname ])
+
+      database_path = Rails.root.join(Book.connection_db_config.database)
+      runner_env = { "DATABASE_URL" => "sqlite3:#{database_path}" }.merge(env)
+
+      File.open(lock_path, File::RDWR | File::CREAT) do |lock|
+        lock.flock(File::LOCK_EX)
+        offset = File.exist?(log_path) ? File.size(log_path) : 0
+
+        stdout, _stderr, status = Open3.capture3(
+          runner_env,
+          Rails.root.join("bin/rails").to_s, "runner", "-e", "development", "script/library_report.rb",
+          chdir: Rails.root.to_s
+        )
+
+        logged = File.exist?(log_path) ? File.binread(log_path, nil, offset).force_encoding(Encoding::UTF_8) : ""
+        [ stdout, logged, status ]
+      end
+    end
+
+    def report_lines(output)
+      output.lines.map(&:chomp).select { it.start_with?("Library report:") }
+    end
+end
