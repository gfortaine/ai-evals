diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..7c0d8f4
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,228 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+  end
+
+  test "due_for_incineration includes only accounts cancelled more than 30 days ago" do
+    other_cancelled_account = accounts(:initech)
+    active_account = accounts(:acme)
+
+    freeze_time do
+      @account.cancel(initiated_by: @user)
+      travel 10.days
+      other_cancelled_account.cancel(initiated_by: users(:mike))
+
+      travel 20.days
+      assert_empty Account.due_for_incineration
+      assert_not @account.due_for_incineration?
+
+      travel 1.second
+      assert_equal [ @account ], Account.due_for_incineration.to_a
+      assert @account.due_for_incineration?
+      assert_not other_cancelled_account.due_for_incineration?
+      assert_not active_account.due_for_incineration?
+    end
+  end
+
+  test "reactivated account is not due for incineration" do
+    @account.cancel(initiated_by: @user)
+
+    travel 31.days do
+      @account.reactivate
+
+      assert_not_includes Account.due_for_incineration, @account
+      assert_not @account.reload.due_for_incineration?
+    end
+  end
+
+  test "reactivated and recently re-cancelled account uses new cancellation timestamp" do
+    freeze_time do
+      @account.cancel(initiated_by: @user)
+
+      travel 25.days
+      @account.reactivate
+
+      travel 10.days
+      @account.cancel(initiated_by: @user)
+
+      travel 10.days
+      assert_not_includes Account.due_for_incineration, @account
+
+      travel 21.days
+      assert_includes Account.due_for_incineration, @account
+    end
+  end
+
+  test "incinerate runs incinerate callbacks" do
+    callback_called = false
+    Account.set_callback(:incinerate, :before) { callback_called = true }
+
+    @account.incinerate
+
+    assert callback_called
+  ensure
+    Account.reset_callbacks(:incinerate)
+  end
+
+  test "incinerate permanently removes account and all associated data while preserving other accounts and identities" do
+    stub_web_push_dns_resolution
+
+    other_account = accounts(:initech)
+    other_board = boards(:miltons_wish_list)
+    other_card = cards(:radio)
+    other_account_david = other_account.users.create!(name: "David in Initech", identity: identities(:david))
+
+    Current.with_account(other_account) do
+      other_card.reindex
+    end
+
+    identities_before = Identity.pluck(:id).sort
+
+    Current.with_account(@account) do
+      Current.user = users(:david)
+
+      board = boards(:writebook)
+      board.update!(public_description: "Public board description")
+      board.publish
+
+      card = cards(:logo)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+      embed_blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "embed.jpg",
+        content_type: "image/jpeg"
+      )
+      attachment_html = ActionText::Attachment.from_attachable(embed_blob).to_html
+      card.update!(description: "<p>Searchable description #{attachment_html}</p>")
+      card.reindex
+
+      comment = card.comments.create!(creator: users(:david), body: "<p>Searchable comment</p>")
+      comment.reindex
+
+      card.steps.create!(content: "Step 1")
+      card.create_activity_spike!
+      card.postpone(user: users(:david))
+
+      users(:david).avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg")
+      users(:david).remember_search("searchable")
+      users(:david).push_subscriptions.create!(endpoint: "https://fcm.googleapis.com/fcm/send/123", p256dh_key: "key", auth_key: "auth")
+      users(:david).notification_bundles.create!(starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+
+      filter = users(:david).filters.create!(
+        params_digest: "incinerate-test-digest",
+        fields: {},
+        boards: [ board ],
+        tags: [ tags(:web) ],
+        assignees: [ users(:jason) ],
+        creators: [ users(:david) ],
+        closers: [ users(:kevin) ]
+      )
+      assert_predicate filter, :persisted?
+
+      unattached_blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("unattached direct upload"),
+        filename: "orphan.txt",
+        content_type: "text/plain"
+      )
+      assert_predicate unattached_blob, :persisted?
+
+      account_export = Account::Export.create!(account: @account, user: users(:david))
+      account_export.file.attach(io: StringIO.new("account zip"), filename: "account.zip", content_type: "application/zip")
+
+      user_export = User::DataExport.create!(account: @account, user: users(:david))
+      user_export.file.attach(io: StringIO.new("user zip"), filename: "user.zip", content_type: "application/zip")
+
+      import = Account::Import.create!(account: @account, identity: identities(:david), status: :completed, completed_at: Time.current)
+      import.file.attach(io: StringIO.new("import zip"), filename: "import.zip", content_type: "application/zip")
+
+      @account.materialize_storage
+      board.materialize_storage
+      @account.cancel(initiated_by: @user)
+    end
+
+    account_id = @account.id
+    board_ids = @account.boards.pluck(:id)
+    filter_ids = Filter.where(account_id: account_id).pluck(:id)
+    blob_keys = ActiveStorage::Blob.where(account_id: account_id).pluck(:key)
+    service = ActiveStorage::Blob.service
+
+    assert_not_empty blob_keys
+    blob_keys.each do |key|
+      assert service.exist?(key), "Expected blob #{key} to exist in storage before incineration"
+    end
+
+    @account.incinerate
+
+    assert_not Account.exists?(account_id)
+
+    account_scoped_tables.each do |table|
+      remaining = count_for_account_in_table(table, account_id)
+      assert_equal 0, remaining, "Expected 0 rows for incinerated account in #{table}, found #{remaining}"
+    end
+
+    assert_equal 0, Storage::Total.where(owner_id: [ account_id, *board_ids ]).count
+
+    if ActiveRecord::Base.connection.table_exists?("search_records_fts")
+      assert_equal 1, ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM search_records_fts").to_i
+    end
+
+    %w[assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags].each do |join_table|
+      remaining = count_for_filters_in_join_table(join_table, filter_ids)
+      assert_equal 0, remaining, "Expected 0 rows in #{join_table}, found #{remaining}"
+    end
+
+    blob_keys.each do |key|
+      assert_not service.exist?(key), "Expected blob #{key} file to be deleted from storage service"
+    end
+
+    assert_equal identities_before, Identity.pluck(:id).sort
+    assert User.exists?(other_account_david.id)
+    assert Account.exists?(other_account.id)
+    assert Board.exists?(other_board.id)
+    assert Card.exists?(other_card.id)
+    assert_includes users(:mike).search(other_card.title).map(&:card), other_card
+  end
+
+  test "destroying an account directly cleans up storage entries without raising on attachment tracking" do
+    Current.with_account(@account) do
+      Current.user = users(:david)
+      cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    end
+
+    account_id = @account.id
+    assert_operator Storage::Entry.where(account_id: account_id).count, :>, 0
+
+    Current.without_account do
+      assert_nothing_raised do
+        @account.destroy!
+      end
+    end
+
+    assert_equal 0, Storage::Entry.where(account_id: account_id).count
+  end
+
+  private
+    def account_scoped_tables
+      ActiveRecord::Base.connection.tables.select do |table|
+        ActiveRecord::Base.connection.columns(table).any? { |column| column.name == "account_id" }
+      end
+    end
+
+    def count_for_account_in_table(table, account_id)
+      serialized_id = ActiveRecord::Type::Uuid.new.serialize(account_id)
+      sql = ActiveRecord::Base.sanitize_sql([ "SELECT COUNT(*) FROM #{table} WHERE account_id = ?", serialized_id ])
+      ActiveRecord::Base.connection.select_value(sql).to_i
+    end
+
+    def count_for_filters_in_join_table(table, filter_ids)
+      return 0 if filter_ids.empty?
+
+      serialized_ids = filter_ids.map { |id| ActiveRecord::Type::Uuid.new.serialize(id) }
+      sql = ActiveRecord::Base.sanitize_sql([ "SELECT COUNT(*) FROM #{table} WHERE filter_id IN (?)", serialized_ids ])
+      ActiveRecord::Base.connection.select_value(sql).to_i
+    end
+end
