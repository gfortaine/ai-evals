diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..ee8446b
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+require "fugit"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago and keeps others" do
+    due_account_1 = accounts(:"37s")
+    due_account_2 = Account.create_with_owner(
+      account: { name: "Second Due Account" },
+      owner: { name: "David", identity: identities(:david) }
+    )
+    recent_cancelled_account = accounts(:initech)
+    active_account = accounts(:acme)
+
+    due_account_1_id = due_account_1.id
+    due_account_2_id = due_account_2.id
+    due_account_board_id = boards(:writebook).id
+    due_account_card_id = cards(:logo).id
+
+    freeze_time do
+      due_account_1.cancel(initiated_by: users(:jason))
+      due_account_2.cancel(initiated_by: due_account_2.users.owner.first)
+
+      travel 15.days
+      recent_cancelled_account.cancel(initiated_by: users(:mike))
+
+      travel 16.days
+      perform_enqueued_jobs do
+        Account::IncinerateDueJob.perform_later
+      end
+    end
+
+    assert_not Account.exists?(due_account_1_id)
+    assert_not Account.exists?(due_account_2_id)
+    assert_not Account::Cancellation.exists?(account_id: due_account_1_id)
+    assert_not Board.exists?(due_account_board_id)
+    assert_not Card.exists?(due_account_card_id)
+    assert_equal 0, User.where(account_id: due_account_1_id).count
+
+    assert Account.exists?(recent_cancelled_account.id)
+    assert recent_cancelled_account.reload.cancelled?
+    assert Account.exists?(active_account.id)
+  end
+
+  test "does not incinerate accounts cancelled 30 days ago or less" do
+    account = accounts(:"37s")
+
+    freeze_time do
+      account.cancel(initiated_by: users(:jason))
+
+      travel 30.days
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert Account.exists?(account.id)
+    end
+  end
+
+  test "is configured as a recurring job" do
+    recurring_config = ActiveSupport::ConfigurationFile.parse(Rails.root.join("config/recurring.yml"))
+    production_tasks = recurring_config.fetch("production")
+
+    incinerate_task = production_tasks.values.find { |task| task["class"] == "Account::IncinerateDueJob" }
+    assert_not_nil incinerate_task, "Expected Account::IncinerateDueJob to be scheduled in config/recurring.yml"
+    assert_instance_of Fugit::Cron, Fugit.parse(incinerate_task["schedule"], multi: :fail)
+  end
+end
