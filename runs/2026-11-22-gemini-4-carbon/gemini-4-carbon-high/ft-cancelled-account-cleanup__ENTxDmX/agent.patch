diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..3cf909f 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,21 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    define_callbacks :incinerate
+
+    scope :due_for_incineration, -> { joins(:cancellation).merge(Account::Cancellation.due) }
+  end
+
+  def incinerate
+    run_callbacks :incinerate do
+      Account::Incinerator.new(self).run
+    end
+  end
+
+  def due_for_incineration?
+    cancellation&.due? || false
+  end
 end
diff --git a/app/models/account/incinerator.rb b/app/models/account/incinerator.rb
new file mode 100644
index 0000000..940319f
--- /dev/null
+++ b/app/models/account/incinerator.rb
@@ -0,0 +1,50 @@
+class Account::Incinerator
+  def initialize(account)
+    @account = account
+  end
+
+  def run
+    Current.without_account do
+      suppressing_turbo_broadcasts do
+        purge_blobs
+        destroy_exports
+        destroy_account
+        destroy_search_records
+        destroy_rich_texts
+      end
+    end
+  end
+
+  private
+    attr_reader :account
+
+    def suppressing_turbo_broadcasts(&block)
+      Board.suppressing_turbo_broadcasts do
+        Card.suppressing_turbo_broadcasts do
+          Account::Import.suppressing_turbo_broadcasts(&block)
+        end
+      end
+    end
+
+    def purge_blobs
+      ActiveStorage::Attachment.where(account_id: account.id).delete_all
+      ActiveStorage::VariantRecord.where(account_id: account.id).delete_all
+      ActiveStorage::Blob.where(account_id: account.id).find_each(&:purge)
+    end
+
+    def destroy_exports
+      Export.where(account_id: account.id).destroy_all
+    end
+
+    def destroy_account
+      account.destroy!
+    end
+
+    def destroy_search_records
+      Search::Record.for(account.id).where(account_id: account.id).destroy_all
+    end
+
+    def destroy_rich_texts
+      ActionText::RichText.where(account_id: account.id).delete_all
+    end
+end
