diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..95aab35
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,65 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limits, class_name: "Account::OverriddenLimits", dependent: :destroy
+
+    set_callback :cancel, :after, :cancel_stripe_subscription_later
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def plan
+    if active_subscription
+      active_subscription.plan
+    elsif comped?
+      Plan.paid
+    else
+      Plan.free
+    end
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    billing_waiver || create_billing_waiver!
+  rescue ActiveRecord::RecordNotUnique
+    reload_billing_waiver
+  end
+
+  def uncomp
+    if billing_waiver&.destroy
+      self.billing_waiver = nil
+    end
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    if overridden_limits
+      overridden_limits.update!(card_count: card_count, bytes_used: bytes_used)
+    else
+      create_overridden_limits!(card_count: card_count, bytes_used: bytes_used)
+    end
+  end
+
+  def reset_overridden_limits
+    if overridden_limits&.destroy
+      self.overridden_limits = nil
+    end
+  end
+
+  def cancel_stripe_subscription_later
+    if active_subscription&.stripe_subscription_id.present?
+      Account::CancelStripeSubscriptionJob.perform_later(self)
+    end
+  end
+
+  def cancel_stripe_subscription_now
+    subscription&.cancel_in_stripe
+  end
+end
