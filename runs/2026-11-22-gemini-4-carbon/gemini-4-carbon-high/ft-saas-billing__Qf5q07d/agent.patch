@@ -0,0 +1,44 @@
+<section id="subscription" class="settings__section settings-subscription">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <% if account.active_subscription %>
+      <div>
+        You’re on the <strong><%= account.plan.name %></strong> plan ($<%= account.plan.price %>/month, unlimited cards, <%= number_to_human_size(account.storage_limit) %> storage).
+      </div>
+      <% if account.active_subscription.to_be_canceled? %>
+        <div class="txt-small txt-subtle margin-block-start-quarter">
+          Scheduled to cancel on <%= account.active_subscription.cancel_at.strftime("%B %-d, %Y") %>.
+        </div>
+      <% end %>
+    <% elsif account.comped? %>
+      <div>
+        You’re on the <strong><%= account.plan.name %></strong> plan (comped — unlimited cards, <%= number_to_human_size(account.storage_limit) %> storage).
+      </div>
+    <% else %>
+      <div>
+        You’re on the <strong><%= account.plan.name %></strong> plan (<%= number_with_delimiter(account.card_count) %> of <%= number_with_delimiter(account.card_limit) %> cards, <%= number_to_human_size(account.bytes_used) %> of <%= number_to_human_size(account.storage_limit) %> storage).
+      </div>
+    <% end %>
+  </header>
+
+  <% if account.plan.free? %>
+    <%= form_with url: saas.account_subscription_path, method: :post, data: { turbo: false }, class: "flex flex-column gap-half align-start" do %>
+      <% Plan.paid_plans.each_with_index do |plan, index| %>
+        <label class="flex align-center gap-half txt-align-start">
+          <%= radio_button_tag :plan_key, plan.key, index.zero? %>
+          <span>
+            <strong><%= plan.name %></strong> — $<%= plan.price %>/month, <%= number_to_human_size(plan.storage_limit) %>
+          </span>
+        </label>
+      <% end %>
+
+      <button type="submit" class="btn btn--link settings-subscription__button">Upgrade</button>
+    <% end %>
+  <% end %>
+
+  <% if account.subscription&.stripe_customer_id.present? %>
+    <div>
+      <%= button_to "Manage subscription", saas.account_subscription_billing_portal_path, method: :post, class: "btn settings-subscription__button", form: { data: { turbo: false } } %>
+    </div>
+  <% end %>
+</section>
