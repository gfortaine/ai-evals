+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  test "admin sees current plan and Upgrade in settings on Free plan" do
+    sign_in_as :kevin
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "#subscription" do
+      assert_select "strong", text: "Free"
+      assert_select "label", text: /Unlimited — \$20\/month, 5 GB/
+      assert_select "label", text: /Unlimited\+ — \$25\/month, 500 GB/
+      assert_select "button", text: "Upgrade"
+    end
+  end
+
+  test "non-admin member does not see plan or Upgrade in settings" do
+    sign_in_as :jz
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "#subscription", count: 0
+  end
+
+  test "admin sees paid plan and Manage subscription in settings when subscribed" do
+    accounts(:"37s").create_subscription!(
+      stripe_customer_id: "cus_37s",
+      stripe_subscription_id: "sub_37s",
+      plan_key: "monthly_extra_storage_v1",
+      status: "active"
+    )
+
+    sign_in_as :kevin
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "#subscription" do
+      assert_select "strong", text: "Unlimited+"
+      assert_select "button", text: "Manage subscription"
+      assert_select "button", text: "Upgrade", count: 0
+    end
+  end
+
+  test "creating subscription redirects admin to Stripe Checkout" do
+    sign_in_as :mike
+
+    Stripe::Checkout::Session.expects(:create).with { |params|
+      params[:mode] == "subscription" &&
+        params[:line_items] == [ { price: Plan[:monthly_v1].stripe_price_id, quantity: 1 } ] &&
+        params[:client_reference_id] == accounts(:initech).id &&
+        params[:customer_email] == identities(:mike).email_address
+    }.returns(stub(url: "https://checkout.stripe.com/c/pay/cs_test_unlimited"))
+
+    post saas.account_subscription_path(script_name: accounts(:initech).slug),
+      params: { plan_key: "monthly_v1" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_unlimited"
+  end
+
+  test "creating Unlimited+ subscription uses Unlimited+ price id" do
+    sign_in_as :mike
+
+    Stripe::Checkout::Session.expects(:create).with { |params|
+      params[:line_items] == [ { price: Plan[:monthly_extra_storage_v1].stripe_price_id, quantity: 1 } ]
+    }.returns(stub(url: "https://checkout.stripe.com/c/pay/cs_test_plus"))
+
+    post saas.account_subscription_path(script_name: accounts(:initech).slug),
+      params: { plan_key: "monthly_extra_storage_v1" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_plus"
+  end
+
+  test "non-admin cannot start checkout or open customer portal" do
+    sign_in_as :jz
+
+    post saas.account_subscription_path(script_name: accounts(:"37s").slug), params: { plan_key: "monthly_v1" }
+    assert_response :forbidden
+
+    post saas.account_subscription_billing_portal_path(script_name: accounts(:"37s").slug)
+    assert_response :forbidden
+  end
+
+  test "billing portal redirects admin to Stripe Customer Portal" do
+    accounts(:initech).create_subscription!(
+      stripe_customer_id: "cus_portal_123",
+      stripe_subscription_id: "sub_portal_123",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    sign_in_as :mike
+
+    Stripe::BillingPortal::Session.expects(:create).with { |params|
+      params[:customer] == "cus_portal_123" && params[:return_url].include?(accounts(:initech).slug)
+    }.returns(stub(url: "https://billing.stripe.com/p/session/test_123"))
+
+    post saas.account_subscription_billing_portal_path(script_name: accounts(:initech).slug)
+
+    assert_redirected_to "https://billing.stripe.com/p/session/test_123"
+  end
+
+  test "works with WebMock stubbed Stripe HTTP endpoints without STRIPE_SECRET_KEY set" do
+    sign_in_as :mike
+
+    stub_request(:post, "https://api.stripe.com/v1/checkout/sessions")
+      .to_return(
+        status: 200,
+        body: { id: "cs_webmock_1", object: "checkout.session", url: "https://checkout.stripe.com/c/pay/cs_webmock_1" }.to_json,
+        headers: { "Content-Type" => "application/json" }
+      )
+
+    post saas.account_subscription_path(script_name: accounts(:initech).slug), params: { plan_key: "monthly_v1" }
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_webmock_1"
+
+    accounts(:initech).create_subscription!(
+      stripe_customer_id: "cus_webmock_1",
+      stripe_subscription_id: "sub_webmock_1",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    stub_request(:post, "https://api.stripe.com/v1/billing_portal/sessions")
+      .to_return(
+        status: 200,
+        body: { id: "bps_webmock_1", object: "billing_portal.session", url: "https://billing.stripe.com/p/session/bps_webmock_1" }.to_json,
+        headers: { "Content-Type" => "application/json" }
+      )
+
+    post saas.account_subscription_billing_portal_path(script_name: accounts(:initech).slug)
+    assert_redirected_to "https://billing.stripe.com/p/session/bps_webmock_1"
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..14e3cee
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "unauthenticated and non-staff access is rejected" do
+    untenanted do
+      get saas.admin_accounts_path
+      assert_redirected_to new_session_path
+    end
+
+    sign_in_as :jz
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :forbidden
+    end
+  end
+
+  test "lists accounts with each name linking to its page" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :success
+    Account.find_each do |account|
+      assert_select "a[href='#{saas.admin_account_path(account, script_name: nil)}']", text: account.name
+    end
+  end
+
+  test "account page supports Comp and Uncomp" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      get saas.admin_account_path(account)
+      assert_response :success
+      assert_select "button", text: "Comp"
+      assert_select "button", text: "Uncomp", count: 0
+
+      post saas.admin_account_billing_waiver_path(account)
+      assert_redirected_to saas.admin_account_path(account, script_name: nil)
+      assert account.reload.comped?
+
+      get saas.admin_account_path(account)
+      assert_response :success
+      assert_select "button", text: "Uncomp"
+      assert_select "button", text: "Comp", count: 0
+
+      delete saas.admin_account_billing_waiver_path(account)
+      assert_redirected_to saas.admin_account_path(account, script_name: nil)
+      assert_not account.reload.comped?
+    end
+  end
+
+  test "account page has Card count and Bytes used override form with Override and Reset" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      get saas.admin_account_path(account)
+      assert_response :success
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "button", text: "Override"
+      assert_select "button", text: "Reset"
+
+      post saas.admin_account_overridden_limits_path(account), params: {
+        overridden_limits: { card_count: 950, bytes_used: 2_147_483_648 }
+      }
+      assert_redirected_to saas.admin_account_path(account, script_name: nil)
+
+      account.reload
+      assert_equal 950, account.card_count
+      assert_equal 2_147_483_648, account.bytes_used
+
+      patch saas.admin_account_overridden_limits_path(account), params: {
+        overridden_limits: { card_count: 1_000, bytes_used: 500 }
+      }
+      assert_redirected_to saas.admin_account_path(account, script_name: nil)
+
+      account.reload
+      assert_equal 1_000, account.card_count
+      assert_equal 500, account.bytes_used
+
+      delete saas.admin_account_overridden_limits_path(account)
+      assert_redirected_to saas.admin_account_path(account, script_name: nil)
+
+      account.reload
+      assert_nil account.overridden_limits
+      assert_equal account.cards.published.count, account.card_count
+      assert_equal 0, account.bytes_used
+    end
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..726ce0c
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  test "free account out of cards can still draft" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 100)
+    accounts(:initech).override_limits(card_count: 1_000)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count }, +1 do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "free account out of cards is refused when creating through the API" do
+    sign_in_as :mike
+    accounts(:initech).override_limits(card_count: 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "API Card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "free account out of cards is refused when publishing" do
+    sign_in_as :mike
+    accounts(:initech).override_limits(card_count: 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "create buttons give way to Upgrade pitch when out of cards" do
+    sign_in_as :mike
+    accounts(:initech).override_limits(card_count: 1_000)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__notch" do
+      assert_select "a", text: "Upgrade"
+    end
+  end
+
+  test "warning counts down from 100 cards out" do
+    sign_in_as :mike
+
+    accounts(:initech).override_limits(card_count: 899)
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_no_match(/cards? left/, response.body)
+
+    accounts(:initech).override_limits(card_count: 900)
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+    assert_response :success
+    assert_select "strong", text: "100 cards left"
+
+    accounts(:initech).override_limits(card_count: 950)
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+    assert_response :success
+    assert_select "strong", text: "50 cards left"
+
+    accounts(:initech).override_limits(card_count: 999)
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+    assert_response :success
+    assert_select "strong", text: "1 card left"
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+
+  test "paid plan allows publishing and API creation past 1,000 cards and brings its own storage allowance" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    account.update_column(:cards_count, 100)
+    account.override_limits(card_count: 1_500, bytes_used: 3.gigabytes)
+
+    # Free plan refuses both card and 3 GB storage
+    post card_publish_path(cards(:unfinished_thoughts), script_name: account.slug)
+    assert_response :forbidden
+
+    # Upgrade to Unlimited ($20/mo, 5 GB)
+    account.create_subscription!(
+      stripe_customer_id: "cus_paid_initech",
+      stripe_subscription_id: "sub_paid_initech",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: account.slug)
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+
+    assert_difference -> { Card.count }, +1 do
+      post board_cards_path(boards(:miltons_wish_list), script_name: account.slug),
+        params: { card: { title: "Unlimited API card" } },
+        as: :json
+    end
+    assert_response :created
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..59db97e
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,173 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @secret = "whsec_test_secret"
+    @previous_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    @previous_monthly_price = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    @previous_extra_price = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+
+    ENV["STRIPE_WEBHOOK_SECRET"] = @secret
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited_20"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_unlimited_plus_25"
+  end
+
+  teardown do
+    ENV["STRIPE_WEBHOOK_SECRET"] = @previous_secret
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = @previous_monthly_price
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = @previous_extra_price
+  end
+
+  test "rejects missing or invalid signature" do
+    payload = subscription_event_payload(type: "customer.subscription.created").to_json
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: { "CONTENT_TYPE" => "application/json" }
+      assert_response :bad_request
+
+      post "/stripe/webhooks", params: payload, headers: {
+        "CONTENT_TYPE" => "application/json",
+        "Stripe-Signature" => "t=12345,v1=invalidsig"
+      }
+      assert_response :bad_request
+    end
+  end
+
+  test "creates Unlimited subscription and updates storage allowance to 5 GB" do
+    period_end = 1.month.from_now.to_i
+    payload = subscription_event_payload(
+      type: "customer.subscription.created",
+      price_id: "price_unlimited_20",
+      status: "active",
+      period_end: period_end,
+      metadata: { account_id: @account.id }
+    )
+
+    post_signed_webhook(payload)
+    assert_response :ok
+
+    @account.reload
+    assert_equal "Unlimited", @account.plan.name
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_equal "cus_initech_123", @account.subscription.stripe_customer_id
+    assert_equal "sub_initech_123", @account.subscription.stripe_subscription_id
+    assert_equal period_end, @account.subscription.current_period_end.to_i
+  end
+
+  test "upgrades subscription to Unlimited+ (500 GB) and cancels on subscription.deleted" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_initech_123",
+      stripe_subscription_id: "sub_initech_123",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    update_payload = subscription_event_payload(
+      type: "customer.subscription.updated",
+      price_id: "price_unlimited_plus_25",
+      status: "active"
+    )
+    post_signed_webhook(update_payload)
+    assert_response :ok
+
+    @account.reload
+    assert_equal "Unlimited+", @account.plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    delete_payload = subscription_event_payload(
+      type: "customer.subscription.deleted",
+      price_id: "price_unlimited_plus_25",
+      status: "canceled"
+    )
+    post_signed_webhook(delete_payload)
+    assert_response :ok
+
+    @account.reload
+    assert_equal "Free", @account.plan.name
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_nil @account.active_subscription
+  end
+
+  test "handles checkout.session.completed followed by customer.subscription.created without metadata on subscription" do
+    checkout_payload = {
+      id: "evt_checkout_1",
+      object: "event",
+      type: "checkout.session.completed",
+      data: {
+        object: {
+          id: "cs_test_1",
+          object: "checkout.session",
+          mode: "subscription",
+          client_reference_id: @account.id,
+          customer: "cus_from_checkout",
+          subscription: "sub_from_checkout",
+          payment_status: "paid",
+          metadata: { account_id: @account.id, plan_key: "monthly_v1" }
+        }
+      }
+    }
+
+    post_signed_webhook(checkout_payload)
+    assert_response :ok
+    assert_equal "Unlimited", @account.reload.plan.name
+
+    sub_payload = subscription_event_payload(
+      type: "customer.subscription.updated",
+      customer_id: "cus_from_checkout",
+      subscription_id: "sub_from_checkout",
+      price_id: "price_unlimited_plus_25",
+      status: "active",
+      metadata: {}
+    )
+
+    post_signed_webhook(sub_payload)
+    assert_response :ok
+    assert_equal "Unlimited+", @account.reload.plan.name
+  end
+
+  private
+    def post_signed_webhook(payload_hash)
+      raw = payload_hash.to_json
+      timestamp = Time.current.to_i
+      signature = OpenSSL::HMAC.hexdigest("SHA256", @secret, "#{timestamp}.#{raw}")
+
+      untenanted do
+        post "/stripe/webhooks", params: raw, headers: {
+          "CONTENT_TYPE" => "application/json",
+          "Stripe-Signature" => "t=#{timestamp},v1=#{signature}"
+        }
+      end
+    end
+
+    def subscription_event_payload(type:, customer_id: "cus_initech_123", subscription_id: "sub_initech_123", price_id: "price_unlimited_20", status: "active", period_end: 1.month.from_now.to_i, metadata: {})
+      {
+        id: "evt_#{SecureRandom.hex(6)}",
+        object: "event",
+        type: type,
+        data: {
+          object: {
+            id: subscription_id,
+            object: "subscription",
+            customer: customer_id,
+            status: status,
+            metadata: metadata,
+            items: {
+              object: "list",
+              data: [
+                {
+                  id: "si_123",
+                  object: "subscription_item",
+                  current_period_end: period_end,
+                  price: {
+                    id: price_id,
+                    object: "price"
+                  }
+                }
+              ]
+            }
+          }
+        }
+      }
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..d8f70e2
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "defaults to Free plan with 1,000 cards and 1 GB storage" do
+    assert_equal Plan.free, @account.plan
+    assert_equal "Free", @account.plan.name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_nil @account.active_subscription
+    assert_not @account.comped?
+  end
+
+  test "active Unlimited subscription brings unlimited cards and 5 GB storage allowance" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_unlimited",
+      stripe_subscription_id: "sub_unlimited",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    assert_equal "Unlimited", @account.plan.name
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert @account.plan.unlimited_cards?
+    assert_not_nil @account.active_subscription
+  end
+
+  test "active Unlimited+ subscription brings unlimited cards and 500 GB storage allowance" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_plus",
+      stripe_subscription_id: "sub_plus",
+      plan_key: "monthly_extra_storage_v1",
+      status: "active"
+    )
+
+    assert_equal "Unlimited+", @account.plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert @account.plan.unlimited_cards?
+  end
+
+  test "canceled subscription falls back to Free plan" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_canceled",
+      stripe_subscription_id: "sub_canceled",
+      plan_key: "monthly_v1",
+      status: "canceled"
+    )
+
+    assert_nil @account.active_subscription
+    assert_equal Plan.free, @account.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comp and uncomp toggle billing waiver" do
+    assert_not @account.comped?
+
+    @account.comp
+    assert @account.comped?
+    assert_equal "Unlimited", @account.plan.name
+    assert @account.plan.unlimited_cards?
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp
+    end
+
+    @account.uncomp
+    assert_not @account.comped?
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "override_limits and reset_overridden_limits override card_count and bytes_used" do
+    real_cards = @account.cards.published.count
+    assert_equal real_cards, @account.card_count
+    assert_equal 0, @account.bytes_used
+
+    @account.override_limits(card_count: 975, bytes_used: 2.gigabytes)
+    assert_equal 975, @account.card_count
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.exceeding_storage_limit?
+
+    @account.override_limits(card_count: 0, bytes_used: nil)
+    assert_equal 0, @account.card_count
+    assert_equal 0, @account.bytes_used
+
+    @account.reset_overridden_limits
+    assert_nil @account.overridden_limits
+    assert_equal real_cards, @account.card_count
+  end
+
+  test "canceling account enqueues stripe subscription cancellation job" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_cancel_acct",
+      stripe_subscription_id: "sub_cancel_acct",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    Stripe::Subscription.expects(:cancel).with("sub_cancel_acct").once
+
+    assert_enqueued_with(job: Account::CancelStripeSubscriptionJob, args: [ @account ]) do
+      @account.cancel!
+    end
+
+    perform_enqueued_jobs only: Account::CancelStripeSubscriptionJob
+  end
+end
diff --git a/saas/test/models/account/card_limited_test.rb b/saas/test/models/account/card_limited_test.rb
new file mode 100644
index 0000000..d50a079
--- /dev/null
+++ b/saas/test/models/account/card_limited_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Account::CardLimitedTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "counts only published cards when not overridden" do
+    published_count = @account.cards.published.count
+    assert @account.cards.drafted.exists?
+    assert_equal published_count, @account.card_count
+  end
+
+  test "not nearing or exceeding limit when more than 100 cards left" do
+    @account.override_limits(card_count: 899)
+
+    assert_equal 101, @account.cards_remaining
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "nearing card limit from 100 cards out down to 1 card left" do
+    @account.override_limits(card_count: 900)
+    assert_equal 100, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.override_limits(card_count: 950)
+    assert_equal 50, @account.cards_remaining
+    assert @account.nearing_card_limit?
+
+    @account.override_limits(card_count: 999)
+    assert_equal 1, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "exceeding card limit at 1,000 cards" do
+    @account.override_limits(card_count: 1_000)
+
+    assert_equal 0, @account.cards_remaining
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "paid and comped accounts do not near or exceed card limit" do
+    @account.override_limits(card_count: 2_500)
+    @account.comp
+
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+    assert_equal Float::INFINITY, @account.cards_remaining
+  end
+end
diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
new file mode 100644
index 0000000..a71a63e
--- /dev/null
+++ b/saas/test/models/plan_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "approved pricing plans" do
+    free = Plan.free
+    assert_equal "Free", free.name
+    assert_equal 0, free.price
+    assert_equal 1_000, free.card_limit
+    assert_equal 1.gigabyte, free.storage_limit
+    assert free.free?
+    assert_not free.paid?
+    assert_not free.unlimited_cards?
+    assert_nil free.stripe_price_id
+
+    unlimited = Plan[:monthly_v1]
+    assert_equal "Unlimited", unlimited.name
+    assert_equal 20, unlimited.price
+    assert_equal Float::INFINITY, unlimited.card_limit
+    assert_equal 5.gigabytes, unlimited.storage_limit
+    assert unlimited.paid?
+    assert_not unlimited.free?
+    assert unlimited.unlimited_cards?
+
+    unlimited_plus = Plan[:monthly_extra_storage_v1]
+    assert_equal "Unlimited+", unlimited_plus.name
+    assert_equal 25, unlimited_plus.price
+    assert_equal Float::INFINITY, unlimited_plus.card_limit
+    assert_equal 500.gigabytes, unlimited_plus.storage_limit
+    assert unlimited_plus.paid?
+    assert unlimited_plus.unlimited_cards?
+  end
+
+  test "looks up plans by key, alias, and stripe price id" do
+    assert_equal Plan.free, Plan["free_v1"]
+    assert_equal Plan.free, Plan["free"]
+    assert_equal Plan[:monthly_v1], Plan["unlimited"]
+    assert_equal Plan[:monthly_extra_storage_v1], Plan["unlimited_plus"]
+    assert_equal Plan[:monthly_extra_storage_v1], Plan["Unlimited+"]
+    assert_nil Plan["nonexistent"]
+
+    previous_monthly = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    previous_extra = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+    begin
+      ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited_test"
+      ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_unlimited_plus_test"
+
+      assert_equal Plan[:monthly_v1], Plan.find_by_price_id("price_unlimited_test")
+      assert_equal Plan[:monthly_extra_storage_v1], Plan.find_by_price_id("price_unlimited_plus_test")
+      assert_nil Plan.find_by_price_id("price_unknown")
+      assert_nil Plan.find_by_price_id(nil)
+    ensure
+      ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = previous_monthly
+      ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = previous_extra
+    end
+  end
+end
