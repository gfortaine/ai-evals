+            <strong><%= @account.plan.name %></strong>
+            <% if @account.comped? %>
+              <span>(Comped)</span>
+            <% end %>
+          </dd>
+        </div>
+        <div>
+          <dt class="txt-x-small txt-subtle">Usage</dt>
+          <dd class="margin-none">
+            <%= number_with_delimiter(@account.card_count) %> cards •
+            <%= number_to_human_size(@account.bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %>
+          </dd>
+        </div>
+      </dl>
+    </section>
+
+    <section class="settings__section txt-align-start">
+      <header>
+        <h2 class="divider">Billing waiver</h2>
+      </header>
+
+      <% if @account.comped? %>
+        <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account, script_name: nil), method: :delete, class: "btn" %>
+      <% else %>
+        <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account, script_name: nil), method: :post, class: "btn btn--link" %>
+      <% end %>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section txt-align-start">
+      <header>
+        <h2 class="divider">Override usage</h2>
+      </header>
+
+      <% overridden_limits = @account.overridden_limits || @account.build_overridden_limits %>
+      <%= form_with model: overridden_limits, scope: :overridden_limits, url: saas.admin_account_overridden_limits_path(@account, script_name: nil), class: "flex flex-column gap" do |form| %>
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :card_count, "Card count", class: "txt-small font-weight-bold" %>
+          <%= form.number_field :card_count, min: 0, class: "input full-width" %>
+        </div>
+
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :bytes_used, "Bytes used", class: "txt-small font-weight-bold" %>
+          <%= form.number_field :bytes_used, min: 0, class: "input full-width" %>
+        </div>
+
+        <div>
+          <button type="submit" class="btn btn--link">Override</button>
+        </div>
+      <% end %>
+
+      <div>
+        <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account, script_name: nil), method: :delete, class: "btn" %>
+      </div>
+    </section>
+  </div>
+</section>
