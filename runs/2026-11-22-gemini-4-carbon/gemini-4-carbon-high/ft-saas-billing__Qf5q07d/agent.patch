diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..cf2422a
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,185 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  class << self
+    def process_stripe_event(event)
+      case event.type
+      when "checkout.session.completed"
+        sync_from_checkout_session(event.data.object)
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.paused", "customer.subscription.resumed"
+        sync_from_stripe_subscription(event.data.object)
+      when "customer.subscription.deleted"
+        sync_from_stripe_subscription(event.data.object, force_status: "canceled")
+      when "invoice.upcoming", "invoice.created", "invoice.finalized", "invoice.paid", "invoice.payment_failed"
+        sync_from_invoice(event.data.object)
+      end
+    end
+
+    private
+      def sync_from_checkout_session(session)
+        return if session.respond_to?(:mode) && session.mode.present? && session.mode != "subscription"
+
+        customer_id = extract_id(session.try(:customer))
+        subscription_id = extract_id(session.try(:subscription))
+        subscription = find_or_initialize_subscription(
+          subscription_id: subscription_id,
+          customer_id: customer_id,
+          account_ref: metadata_value(session.try(:metadata), :account_id) || session.try(:client_reference_id)
+        )
+        return unless subscription && customer_id.present?
+
+        subscription.stripe_customer_id = customer_id
+        subscription.stripe_subscription_id = subscription_id if subscription_id.present?
+
+        if session.try(:subscription).is_a?(Stripe::Subscription)
+          apply_stripe_subscription_attributes(subscription, session.subscription)
+        elsif subscription.plan_key.blank? && (plan = Plan[metadata_value(session.try(:metadata), :plan_key)])
+          subscription.plan_key = plan.key
+          subscription.status ||= "active" unless session.try(:payment_status) == "unpaid"
+        end
+
+        subscription.save!
+      end
+
+      def sync_from_stripe_subscription(stripe_sub, force_status: nil)
+        customer_id = extract_id(stripe_sub.try(:customer))
+        subscription_id = extract_id(stripe_sub)
+        subscription = find_or_initialize_subscription(
+          subscription_id: subscription_id,
+          customer_id: customer_id,
+          account_ref: metadata_value(stripe_sub.try(:metadata), :account_id)
+        )
+        return unless subscription
+
+        subscription.stripe_customer_id = customer_id if customer_id.present?
+        apply_stripe_subscription_attributes(subscription, stripe_sub, force_status: force_status)
+        subscription.save! if subscription.stripe_customer_id.present?
+      end
+
+      def sync_from_invoice(invoice)
+        customer_id = extract_id(invoice.try(:customer))
+        subscription_id = extract_id(invoice.try(:subscription))
+        subscription = find_existing_subscription(subscription_id: subscription_id, customer_id: customer_id)
+
+        if subscription && invoice.respond_to?(:amount_due) && !invoice.amount_due.nil?
+          subscription.update!(next_amount_due_in_cents: invoice.amount_due)
+        end
+      end
+
+      def find_or_initialize_subscription(subscription_id:, customer_id:, account_ref:)
+        find_existing_subscription(subscription_id: subscription_id, customer_id: customer_id) ||
+          initialize_subscription_for_account(account_ref)
+      end
+
+      def find_existing_subscription(subscription_id:, customer_id:)
+        (find_by(stripe_subscription_id: subscription_id) if subscription_id.present?) ||
+          (find_by(stripe_customer_id: customer_id) if customer_id.present?)
+      end
+
+      def initialize_subscription_for_account(account_ref)
+        if account = locate_account(account_ref)
+          account.subscription || account.build_subscription
+        end
+      end
+
+      def locate_account(ref)
+        return nil if ref.blank?
+
+        Account.find_by(id: ref.to_s) ||
+          (Account.find_by(external_account_id: ref.to_s) if ref.to_s.match?(/\A\d+\z/))
+      end
+
+      def apply_stripe_subscription_attributes(subscription, stripe_sub, force_status: nil)
+        subscription.stripe_subscription_id = stripe_sub.id if stripe_sub.respond_to?(:id) && stripe_sub.id.present?
+        if plan = resolve_plan(stripe_sub, fallback_key: subscription.plan_key)
+          subscription.plan_key = plan.key
+        end
+        subscription.status = force_status || stripe_sub.try(:status)
+        subscription.current_period_end = extract_period_end(stripe_sub)
+        subscription.cancel_at = extract_cancel_at(stripe_sub)
+      end
+
+      def resolve_plan(stripe_sub, fallback_key: nil)
+        item = first_subscription_item(stripe_sub)
+        price = item&.try(:price) || stripe_sub.try(:plan)
+        price_id = extract_id(price)
+
+        Plan.find_by_price_id(price_id) ||
+          Plan[metadata_value(stripe_sub.try(:metadata), :plan_key)] ||
+          (Plan[price.try(:lookup_key)] unless price.is_a?(String)) ||
+          (Plan[metadata_value(price&.try(:metadata), :plan_key)] unless price.is_a?(String)) ||
+          (Plan.find_by_amount(price&.try(:unit_amount)) unless price.is_a?(String)) ||
+          Plan[fallback_key]
+      end
+
+      def first_subscription_item(stripe_sub)
+        stripe_sub.try(:items)&.try(:data)&.first
+      end
+
+      def extract_period_end(stripe_sub)
+        timestamp = first_subscription_item(stripe_sub)&.try(:current_period_end) ||
+          stripe_sub.try(:current_period_end) ||
+          stripe_object_field(stripe_sub, :current_period_end)
+
+        Time.at(timestamp).utc if timestamp.present?
+      end
+
+      def extract_cancel_at(stripe_sub)
+        timestamp = stripe_sub.try(:cancel_at) || stripe_object_field(stripe_sub, :cancel_at)
+        if timestamp.blank? && stripe_sub.try(:cancel_at_period_end)
+          return extract_period_end(stripe_sub)
+        end
+
+        Time.at(timestamp).utc if timestamp.present?
+      end
+
+      def stripe_object_field(object, key)
+        object[key] if object.respond_to?(:[])
+      rescue KeyError, NoMethodError
+        nil
+      end
+
+      def extract_id(value)
+        if value.is_a?(String)
+          value.presence
+        else
+          value&.try(:id)
+        end
+      end
+
+      def metadata_value(metadata, key)
+        return nil unless metadata.respond_to?(:[])
+
+        metadata[key] || metadata[key.to_s] || metadata[key.to_sym]
+      rescue KeyError, NoMethodError
+        nil
+      end
+  end
+
+  def plan
+    Plan[plan_key] || Plan.free
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def canceled?
+    status == "canceled"
+  end
+
+  def to_be_canceled?
+    active? && cancel_at.present?
+  end
+
+  def cancel_in_stripe
+    if active? && stripe_subscription_id.present?
+      Stripe::Subscription.cancel(stripe_subscription_id)
+    end
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..292dc80
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,110 @@
+class Plan
+  PLANS = {
+    free_v1: {
+      name: "Free",
+      price: 0,
+      card_limit: 1_000,
+      storage_limit: 1.gigabyte
+    },
+    monthly_v1: {
+      name: "Unlimited",
+      price: 20,
+      card_limit: Float::INFINITY,
+      storage_limit: 5.gigabytes,
+      stripe_price_env_var: "STRIPE_MONTHLY_V1_PRICE_ID",
+      default_stripe_price_id: "price_monthly_v1"
+    },
+    monthly_extra_storage_v1: {
+      name: "Unlimited+",
+      price: 25,
+      card_limit: Float::INFINITY,
+      storage_limit: 500.gigabytes,
+      stripe_price_env_var: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID",
+      default_stripe_price_id: "price_monthly_extra_storage_v1"
+    }
+  }.freeze
+
+  KEY_ALIASES = {
+    "free" => :free_v1,
+    "unlimited" => :monthly_v1,
+    "unlimited_plus" => :monthly_extra_storage_v1,
+    "unlimited+" => :monthly_extra_storage_v1
+  }.freeze
+
+  attr_reader :key, :name, :price, :card_limit, :storage_limit
+
+  class << self
+    def all
+      @all ||= PLANS.map { |key, attributes| new(key: key, **attributes) }.freeze
+    end
+
+    def paid_plans
+      @paid_plans ||= all.select(&:paid?).freeze
+    end
+
+    def free
+      find(:free_v1)
+    end
+
+    def paid
+      find(:monthly_v1)
+    end
+
+    def unlimited_plus
+      find(:monthly_extra_storage_v1)
+    end
+
+    def find(key)
+      return nil if key.blank?
+
+      normalized = key.to_s.strip.downcase
+      resolved_key = (KEY_ALIASES[normalized] || normalized).to_s
+      all.find { |plan| plan.key == resolved_key }
+    end
+    alias_method :[], :find
+
+    def find_by_price_id(price_id)
+      return nil if price_id.blank?
+
+      paid_plans.find { |plan| plan.stripe_price_id == price_id }
+    end
+
+    def find_by_amount(amount_in_cents)
+      return nil if amount_in_cents.blank?
+
+      paid_plans.find { |plan| plan.price * 100 == amount_in_cents.to_i }
+    end
+  end
+
+  def initialize(key:, name:, price:, card_limit:, storage_limit:, stripe_price_env_var: nil, default_stripe_price_id: nil)
+    @key = key.to_s
+    @name = name
+    @price = price
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @stripe_price_env_var = stripe_price_env_var
+    @default_stripe_price_id = default_stripe_price_id
+  end
+
+  def free?
+    price.zero?
+  end
+
+  def paid?
+    price.positive?
+  end
+
+  def unlimited_cards?
+    card_limit.infinite?
+  end
+
+  def stripe_price_id
+    if @stripe_price_env_var
+      ENV[@stripe_price_env_var].presence || @default_stripe_price_id
+    end
+  end
+
+  def to_param
+    key
+  end
+end
diff --git a/saas/app/views/account/settings/_subscription.html.erb b/saas/app/views/account/settings/_subscription.html.erb
