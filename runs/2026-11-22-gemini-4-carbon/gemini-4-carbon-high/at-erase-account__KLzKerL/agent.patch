diff --git a/lib/rails_ext/active_storage_immediate_purge.rb b/lib/rails_ext/active_storage_immediate_purge.rb
new file mode 100644
index 0000000..7980a30
--- /dev/null
+++ b/lib/rails_ext/active_storage_immediate_purge.rb
@@ -0,0 +1,23 @@
+module ActiveStorage::ImmediatePurge
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy :purge_dependent_blob, if: :purge_synchronously?
+  end
+
+  private
+    def purge_synchronously?
+      record&.attachment_reflections&.dig(name)&.options&.fetch(:dependent, nil) == :purge
+    end
+
+    def purge_dependent_blob
+      return unless blob && !ActiveStorage::Attachment.exists?(blob_id: blob_id)
+
+      blob.variant_records.each { it.image.purge }
+      blob.purge
+    end
+end
+
+ActiveSupport.on_load :active_storage_attachment do
+  ActiveStorage::Attachment.include ActiveStorage::ImmediatePurge
+end
