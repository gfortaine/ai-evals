@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  test "creating an event relays to subscribed active webhooks on the board" do
+    stub_dns_resolution("93.184.216.34")
+    webhook = webhooks(:active)
+    stub = stub_request(:post, webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    assert_difference -> { webhook.deliveries.count }, 1 do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        Current.with(account: accounts("37s"), user: users(:david)) do
+          boards(:writebook).cards.create!(title: "Ship webhooks", status: :published, creator: users(:david))
+        end
+      end
+    end
+
+    assert_requested stub, times: 1
+    delivery = webhook.deliveries.ordered.first
+    assert delivery.succeeded?
+    assert_equal "card_published", delivery.event.action
+  end
+
+  test "relays comment_created and card_auto_postponed events with full payload" do
+    board = boards(:writebook)
+    webhook = Webhook.create!(
+      board: board,
+      name: "Comments and Entropy",
+      url: "https://hooks.example.com/events",
+      subscribed_actions: [ "comment_created", "card_auto_postponed" ]
+    )
+
+    bodies = []
+    stub = stub_request(:post, webhook.url).to_return do |req|
+      bodies << JSON.parse(req.body)
+      { status: 200 }
+    end
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      Current.with(account: accounts("37s"), user: users(:david)) do
+        cards(:logo).comments.create!(body: "Looks great!", creator: users(:david))
+      end
+
+      Current.without_account do
+        cards(:logo).update_columns(last_active_at: 100.days.ago)
+        Card.auto_postpone_all_due
+      end
+    end
+
+    assert_requested stub, times: 2
+    assert_equal 2, webhook.deliveries.count
+    assert_equal [ "comment_created", "card_auto_postponed" ], bodies.map { |b| b["action"] }
+    assert_equal "Looks great!", bodies.first.dig("eventable", "body", "plain_text")
+    assert_equal cards(:logo).id, bodies.second.dig("eventable", "id")
+  end
+
+  test "does not relay to inactive webhooks or unsubscribed actions" do
+    webhook = webhooks(:active)
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        Current.with(account: accounts("37s"), user: users(:david)) do
+          cards(:logo).comments.create!(body: "Unsubscribed comment", creator: users(:david))
+        end
+      end
+    end
+
+    webhook.deactivate
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        Current.with(account: accounts("37s"), user: users(:david)) do
+          boards(:writebook).cards.create!(title: "Ignored while inactive", status: :published, creator: users(:david))
+        end
+      end
+    end
+
+    assert_not_requested stub
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
