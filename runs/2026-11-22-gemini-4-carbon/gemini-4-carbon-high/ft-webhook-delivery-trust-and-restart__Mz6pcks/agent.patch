--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -1,14 +1,50 @@
 class Webhook::Delivery < ApplicationRecord
+  STALE_THRESHOLD = 7.days
+  ENDPOINT_TIMEOUT = 7.seconds
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  MAX_RESPONSE_HEADERS_BYTES = 16.kilobytes
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
 
+  after_create_commit :deliver_later
+
   store :request, coder: JSON
   store :response, coder: JSON
 
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where created_at: ..STALE_THRESHOLD.ago }
+
+  class << self
+    def cleanup
+      stale.in_batches.delete_all
+    end
+  end
+
+  def deliver_later
+    Current.with_account(account) do
+      Webhook::DeliveryJob.perform_later(self)
+    end
+  end
+
+  def deliver
+    return unless claim_for_delivery
+
+    self.request[:headers] = headers
+    self.response = perform_request
+    self.state = :completed
+    save!
+
+    webhook.delinquency_tracker.record_delivery_of(self)
+  rescue
+    errored!
+    webhook.delinquency_tracker.record_delivery_of(self)
+    raise
+  end
+  alias_method :deliver_now, :deliver
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +65,168 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim_for_delivery
+      if new_record?
+        self.state = :in_progress
+        save!
+      elsif pending? && self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+        self.state = :in_progress
+        true
+      else
+        false
+      end
+    end
+
+    def perform_request
+      ip = resolve_destination_ip
+
+      if ip == :blocked
+        { error: :destination_unreachable }
+      else
+        http_response = http(ip).request(http_request)
+        { code: http_response.code.to_i, headers: extract_response_headers(http_response) }
+      end
+    rescue Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout, Errno::ETIMEDOUT, Timeout::Error
+      { error: :connection_timeout }
+    rescue OpenSSL::SSL::SSLError
+      { error: :tls_error }
+    rescue Resolv::ResolvError, SocketError, SystemCallError, IOError, Net::ProtocolError
+      { error: :destination_unreachable }
+    end
+
+    def resolve_destination_ip
+      hostname = uri.hostname.to_s
+
+      if localhost_hostname?(hostname)
+        :blocked
+      elsif ip_literal?(hostname)
+        SsrfProtection.blocked_address?(hostname) ? :blocked : hostname
+      else
+        resolve_public_dns_ip(hostname)
+      end
+    end
+
+    def localhost_hostname?(hostname)
+      hostname.casecmp?("localhost") || hostname.downcase.end_with?(".localhost")
+    end
+
+    def ip_literal?(hostname)
+      IPAddr.new(hostname)
+      true
+    rescue IPAddr::InvalidAddressError
+      false
+    end
+
+    def resolve_public_dns_ip(hostname)
+      ip_addresses = []
+      real_resolver = false
+
+      Resolv::DNS.open(nameserver: SsrfProtection::DNS_NAMESERVERS, timeouts: SsrfProtection::DNS_RESOLUTION_TIMEOUT) do |dns|
+        real_resolver = dns.is_a?(Resolv::DNS)
+        dns.each_address(hostname) do |ip_address|
+          ip_addresses << IPAddr.new(ip_address.to_s)
+        end
+      end
+
+      public_ip = ip_addresses.reject { |ip| SsrfProtection.blocked_address?(ip) }.sort_by { |ip| ip.ipv4? ? 0 : 1 }.first&.to_s
+
+      if public_ip
+        public_ip
+      elsif ip_addresses.empty? && real_resolver && dns_nameservers_unreachable?
+        nil
+      else
+        :blocked
+      end
+    end
+
+    def dns_nameservers_unreachable?
+      UDPSocket.open do |socket|
+        socket.connect(SsrfProtection::DNS_NAMESERVERS.first, 53)
+      end
+      false
+    rescue Errno::ENETUNREACH, Errno::EHOSTUNREACH, Errno::EACCES, Errno::EPERM
+      true
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    def http(ip)
+      Net::HTTP.new(uri.hostname, uri.port).tap do |http|
+        http.ipaddr = ip if ip
+        http.use_ssl = (uri.scheme == "https")
+        http.open_timeout = ENDPOINT_TIMEOUT
+        http.read_timeout = ENDPOINT_TIMEOUT
+        http.write_timeout = ENDPOINT_TIMEOUT
+      end
+    end
+
+    def http_request
+      Net::HTTP::Post.new(uri.request_uri, headers).tap do |post|
+        post.body = payload
+      end
+    end
+
+    def extract_response_headers(http_response)
+      response_headers = http_response.each_header.to_h
+      response_headers.to_json.bytesize <= MAX_RESPONSE_HEADERS_BYTES ? response_headers : {}
+    end
+
+    def headers
+      @headers ||= {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => content_type,
+        "X-Webhook-Signature" => signature,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601
+      }
+    end
+
+    def content_type
+      if webhook.for_campfire?
+        "text/html"
+      else
+        "application/json"
+      end
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def payload
+      @payload ||= if webhook.for_basecamp?
+        { content: render_payload(formats: :html) }.to_json
+      elsif webhook.for_slack?
+        { text: slack_text }.to_json
+      elsif webhook.for_campfire?
+        render_payload(formats: :html)
+      else
+        render_payload(formats: :json)
+      end
+    end
+
+    def slack_text
+      convert_html_to_mrkdwn(render_payload(formats: :html))
+    end
+
+    def convert_html_to_mrkdwn(html)
+      html
+        .gsub(/\s*<a\s+(?:[^>]*?\s+)?href="([^"]*)"[^>]*>(.*?)<\/a>/im) { " <#{CGI.unescapeHTML($1)}|#{$2}>" }
+        .gsub("&quot;", '"')
+        .gsub(/&#39;|&#x27;/i, "'")
+        .strip
+    end
+
+    def render_payload(formats:)
+      Current.with(account: account, user: nil) do
+        renderer.render(template: "webhooks/event", formats: formats, assigns: { event: event }, layout: false).strip
+      end
+    end
+
+    def renderer
+      ApplicationController.renderer.new(script_name: account.slug)
+    end
 end
diff --git a/test/integration/webhooks_test.rb b/test/integration/webhooks_test.rb
new file mode 100644
index 0000000..313fd9c
--- /dev/null
+++ b/test/integration/webhooks_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class WebhooksTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "board event triggers webhook POST and delivery log shows result in HTML and JSON" do
+    board = boards(:writebook)
+    webhook = webhooks(:active)
+
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      post card_closure_path(cards(:logo)), as: :turbo_stream
+      assert_response :success
+    end
+
+    assert_requested stub, times: 1
+
+    delivery = webhook.deliveries.ordered.first
+    assert_equal "card_closed", delivery.event.action
+    assert delivery.succeeded?
+
+    get board_webhook_path(board, webhook)
+    assert_response :success
+    assert_select "li##{dom_id(delivery)}.delivery--succeeded", /completed/
+
+    get board_webhook_deliveries_path(board, webhook), as: :json
+    assert_response :success
+    logged = @response.parsed_body.first
+    assert_equal delivery.id, logged["id"]
+    assert_equal "completed", logged["state"]
+    assert_equal 200, logged.dig("response", "code")
+    assert_nil logged.dig("response", "error")
+    assert_equal "card_closed", logged.dig("event", "action")
+    assert_not logged.dig("request", "headers").key?("X-Webhook-Signature")
+  end
+
+  test "delinquent receiver gets switched off after 10 consecutive failures over an hour and can be reactivated" do
+    board = boards(:writebook)
+    webhook = Webhook.create!(
+      board: board,
+      name: "Flaky Receiver",
+      url: "https://flaky.example.com/webhooks",
+      subscribed_actions: [ "card_published" ]
+    )
+
+    stub_request(:post, webhook.url).to_return(status: 503)
+
+    freeze_time do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        post board_cards_path(board), params: { card: { title: "Card 1" } }, as: :json
+        assert_response :created
+      end
+
+      assert webhook.reload.active?
+
+      8.times do |i|
+        travel 5.minutes
+        perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+          post board_cards_path(board), params: { card: { title: "Card #{i + 2}" } }, as: :json
+          assert_response :created
+        end
+      end
+
+      assert webhook.reload.active?
+
+      travel 25.minutes
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        post board_cards_path(board), params: { card: { title: "Card 10" } }, as: :json
+        assert_response :created
+      end
+
+      assert_not webhook.reload.active?
+
+      # Subsequent events no longer trigger the deactivated webhook
+      assert_no_difference -> { webhook.deliveries.count } do
+        perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+          post board_cards_path(board), params: { card: { title: "Card 11" } }, as: :json
+          assert_response :created
+        end
+      end
+
+      # Admin reactivates webhook; failure streak is reset
+      post board_webhook_activation_path(board, webhook)
+      assert_redirected_to board_webhook_path(board, webhook)
+      assert webhook.reload.active?
+      assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    end
+  end
+end
