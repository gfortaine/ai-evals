+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = Webhook.create!(
+      board: boards(:writebook),
+      name: "Tracked Webhook",
+      url: "https://example.com/webhook",
+      subscribed_actions: [ "card_published" ]
+    )
+    @tracker = @webhook.delinquency_tracker
+    @event = events(:logo_published)
+  end
+
+  test "does not deactivate before 10 consecutive failures even after an hour" do
+    freeze_time do
+      9.times do |i|
+        travel 10.minutes if i > 0
+        @tracker.record_delivery_of(failed_delivery)
+      end
+
+      assert_equal 9, @tracker.reload.consecutive_failures_count
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "does not deactivate on 10 consecutive failures within less than an hour" do
+    freeze_time do
+      @tracker.record_delivery_of(failed_delivery)
+      travel 59.minutes
+
+      9.times do
+        @tracker.record_delivery_of(failed_delivery)
+      end
+
+      assert_equal 10, @tracker.reload.consecutive_failures_count
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "deactivates webhook after 10 consecutive failures spanning at least an hour" do
+    freeze_time do
+      @tracker.record_delivery_of(failed_delivery)
+      first_failure_time = Time.current
+
+      8.times do
+        travel 5.minutes
+        @tracker.record_delivery_of(failed_delivery)
+      end
+
+      assert @webhook.reload.active?
+
+      travel_to first_failure_time + 1.hour
+      @tracker.record_delivery_of(failed_delivery)
+
+      assert_equal 10, @tracker.reload.consecutive_failures_count
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "resets streak when a delivery succeeds" do
+    freeze_time do
+      5.times do
+        @tracker.record_delivery_of(failed_delivery)
+        travel 15.minutes
+      end
+
+      assert_equal 5, @tracker.reload.consecutive_failures_count
+      assert_not_nil @tracker.first_failure_at
+
+      @tracker.record_delivery_of(succeeded_delivery)
+
+      assert_equal 0, @tracker.reload.consecutive_failures_count
+      assert_nil @tracker.first_failure_at
+
+      travel 2.hours
+      5.times do
+        @tracker.record_delivery_of(failed_delivery)
+      end
+
+      assert_equal 5, @tracker.reload.consecutive_failures_count
+      assert @webhook.reload.active?
+    end
+  end
+
+  private
+    def failed_delivery
+      Webhook::Delivery.new(webhook: @webhook, event: @event, state: :completed, response: { code: 500 })
+    end
+
+    def succeeded_delivery
+      Webhook::Delivery.new(webhook: @webhook, event: @event, state: :completed, response: { code: 200 })
+    end
+end
