@@ -0,0 +1,49 @@
+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthorized_access
+
+  layout "public"
+
+  before_action :set_import, only: :show
+
+  def show
+  end
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    if file = uploaded_file
+      @import = Account::Import.start(identity: Current.identity, file: file)
+
+      respond_to do |format|
+        format.html { redirect_to account_import_path(@import, script_name: nil), notice: "Import started. You'll receive an email when it's done." }
+        format.json { head :created, location: account_import_url(@import, script_name: nil) }
+      end
+    else
+      @import = Account::Import.new
+      @import.errors.add(:file, "must be selected")
+
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: { errors: @import.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  private
+    def set_import
+      @import = Current.identity.account_imports.find(params[:id])
+    end
+
+    def uploaded_file
+      candidate = params[:file] || params.dig(:import, :file) || params.dig(:account_import, :file)
+      candidate if candidate.present? && candidate.respond_to?(:read)
+    end
+
+    def request_authentication
+      session[:return_to_after_authenticating] = request.url
+      redirect_to_login_url
+    end
+end
