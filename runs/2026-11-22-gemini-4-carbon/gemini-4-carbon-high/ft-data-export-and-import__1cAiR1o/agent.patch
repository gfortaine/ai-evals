+require "test_helper"
+
+class Users::DataExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @member = users(:david)
+    sign_in_as @member
+  end
+
+  test "profile page shows export button only on current user's own profile" do
+    get user_path(@member)
+    assert_response :success
+    assert_select "form[action='#{user_data_exports_path(@member)}']"
+
+    get user_path(users(:kevin))
+    assert_response :success
+    assert_select "form[action='#{user_data_exports_path(users(:kevin))}']", count: 0
+  end
+
+  test "member downloads accessible cards as JSON with comments and attached files, and link expires after a day" do
+    visible_card = cards(:logo)
+    private_board = boards(:private)
+    hidden_card = nil
+    drafted_card = nil
+
+    Current.with_account(@account) do
+      # Attach cover image and description embed to visible card
+      visible_card.image.attach(
+        io: File.open(file_fixture("avatar.png"), "rb"),
+        filename: "avatar.png",
+        content_type: "image/png"
+      )
+      desc_blob = ActiveStorage::Blob.create_and_upload!(
+        io: File.open(file_fixture("moon.jpg"), "rb"),
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+      visible_card.update!(
+        description: "<p>See <action-text-attachment sgid=\"#{desc_blob.attachable_sgid}\" content-type=\"image/jpeg\" filename=\"moon.jpg\"></action-text-attachment></p>"
+      )
+
+      # Add two comments with attached files (including a duplicate filename moon.jpg!)
+      comment_blob_1 = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("spec pdf bytes"),
+        filename: "spec.pdf",
+        content_type: "application/pdf"
+      )
+      visible_card.comments.create!(
+        creator: @member,
+        body: "<p>Attached spec: <action-text-attachment sgid=\"#{comment_blob_1.attachable_sgid}\" content-type=\"application/pdf\" filename=\"spec.pdf\"></action-text-attachment></p>"
+      )
+
+      comment_blob_2 = ActiveStorage::Blob.create_and_upload!(
+        io: File.open(file_fixture("avatar.png"), "rb"),
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+      visible_card.comments.create!(
+        creator: users(:kevin),
+        body: "<p>Another moon: <action-text-attachment sgid=\"#{comment_blob_2.attachable_sgid}\" content-type=\"image/jpeg\" filename=\"moon.jpg\"></action-text-attachment></p>"
+      )
+
+      # Card on a private board @member cannot see
+      assert_not private_board.accessible_to?(@member)
+      with_current_user(:kevin) do
+        hidden_card = private_board.cards.create!(
+        creator: users(:kevin),
+        title: "Top Secret Private Card",
+        status: "published",
+        last_active_at: Time.current
+        )
+      end
+
+      # Drafted card should not be exported
+      drafted_card = boards(:writebook).cards.create!(
+        creator: @member,
+        title: "Unpublished Draft",
+        status: "drafted",
+        last_active_at: Time.current
+      )
+    end
+
+    ActionMailer::Base.deliveries.clear
+
+    assert_difference -> { User::DataExport.count }, 1 do
+      perform_enqueued_jobs do
+        post user_data_exports_path(@member)
+      end
+    end
+
+    assert_redirected_to user_path(@member)
+
+    export = @member.data_exports.order(created_at: :desc).first
+    assert export.completed?
+
+    email = ActionMailer::Base.deliveries.last
+    assert_not_nil email
+    assert_equal [ @member.identity.email_address ], email.to
+    assert_equal "Your Fizzy data export is ready", email.subject
+    assert_includes email.body.encoded, user_data_export_path(@member, export, script_name: @account.slug)
+
+    get user_data_export_path(@member, export)
+    assert_response :success
+    blob_href = css_select("a#download-link").first["href"]
+
+    get blob_href
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+
+    reader = ZipFile::Reader.new(StringIO.new(response.body))
+
+    # Visible card is exported; private and drafted cards are NOT exported
+    assert reader.exists?("#{visible_card.number}.json")
+    assert_not reader.exists?("#{hidden_card.number}.json")
+    assert_not reader.exists?("#{drafted_card.number}.json")
+
+    card_json = JSON.parse(reader.read("#{visible_card.number}.json"))
+    assert_equal visible_card.id, card_json["id"]
+    assert_equal visible_card.number, card_json["number"]
+    assert_equal visible_card.title, card_json["title"]
+    assert_equal "Writebook", card_json.dig("board", "name")
+
+    # Header image attached and present in zip
+    image_path = card_json.dig("image", "path")
+    assert_equal "#{visible_card.number}/avatar.png", image_path
+    assert_equal File.binread(file_fixture("avatar.png")), reader.read(image_path)
+
+    # Description embed present in zip
+    assert_equal 1, card_json["attachments"].size
+    desc_attachment_path = card_json["attachments"].first["path"]
+    assert_equal "#{visible_card.number}/moon.jpg", desc_attachment_path
+    assert_equal File.binread(file_fixture("moon.jpg")), reader.read(desc_attachment_path)
+
+    # Comments and comment attachments present in zip (including deduplicated filename moon-1.jpg)
+    spec_comment = card_json["comments"].find { |c| c.dig("body", "plain_text").include?("Attached spec") }
+    assert_not_nil spec_comment
+    spec_path = spec_comment["attachments"].first["path"]
+    assert_equal "#{visible_card.number}/spec.pdf", spec_path
+    assert_equal "spec pdf bytes", reader.read(spec_path)
+
+    moon2_comment = card_json["comments"].find { |c| c.dig("body", "plain_text").include?("Another moon") }
+    assert_not_nil moon2_comment
+    moon2_path = moon2_comment["attachments"].first["path"]
+    assert_equal "#{visible_card.number}/moon-1.jpg", moon2_path
+    assert_equal File.binread(file_fixture("avatar.png")), reader.read(moon2_path)
+
+    # Link expires after 1 day
+    travel 25.hours do
+      get user_data_export_path(@member, export)
+      assert_response :gone
+
+      get blob_href
+      assert_response :forbidden
+    end
+  end
+
+  test "user cannot start or download another user's data export" do
+    kevin = users(:kevin)
+
+    assert_no_difference -> { User::DataExport.count } do
+      post user_data_exports_path(kevin)
+    end
+    assert_response :forbidden
+
+    kevin_export = kevin.data_exports.create!(account: @account)
+    kevin_export.build_now
+
+    get user_data_export_path(kevin, kevin_export)
+    assert_response :forbidden
+
+    get rails_blob_path(kevin_export.file, disposition: :attachment)
+    assert_response :forbidden
+  end
+end
