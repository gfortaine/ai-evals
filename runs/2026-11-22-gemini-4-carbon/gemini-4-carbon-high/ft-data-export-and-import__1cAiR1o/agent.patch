diff --git a/app/models/user/data_export.rb b/app/models/user/data_export.rb
new file mode 100644
index 0000000..530c0b1
--- /dev/null
+++ b/app/models/user/data_export.rb
@@ -0,0 +1,214 @@
+class User::DataExport < Export
+  BATCH_SIZE = 100
+
+def download_url(**options)
+  Rails.application.routes.url_helpers.user_data_export_url(
+    user,
+    self,
+    **base_url_options,
+    script_name: account.slug,
+    **options
+  )
+end
+
+  private
+    def populate_zip
+      ZipFile.create_for(file, filename: filename) do |zip|
+        export_cards_to(zip)
+      end
+    end
+
+    def filename
+      "fizzy-cards-#{id}.zip"
+    end
+
+    def export_cards_to(zip)
+      accessible_cards_scope.in_batches(of: BATCH_SIZE) do |batch_relation|
+        cards = preload_cards(batch_relation)
+        cards.each do |card|
+          export_card(card, zip)
+        end
+      end
+    end
+
+    def accessible_cards_scope
+      user.accessible_cards.published
+    end
+
+    def preload_cards(relation)
+      relation.preload(
+        :board,
+        :column,
+        :tags,
+        :steps,
+        :closure,
+        :goldness,
+        :not_now,
+        { creator: :identity },
+        { assignees: :identity },
+        { image_attachment: :blob },
+        { rich_text_description: { embeds_attachments: :blob } },
+        { comments: [ { creator: :identity }, { rich_text_body: { embeds_attachments: :blob } } ] }
+      ).to_a
+    end
+
+    def export_card(card, zip)
+      blob_paths = {}
+      used_paths = Set.new
+
+      image_data = export_card_image(card, zip, blob_paths, used_paths)
+      card_attachments = export_rich_text_embeds(card.description, card.number, zip, blob_paths, used_paths)
+      comments_data = export_card_comments(card, zip, blob_paths, used_paths)
+
+      payload = serialize_card(card, image_data, card_attachments, comments_data, blob_paths)
+      zip.add_file("#{card.number}.json", JSON.pretty_generate(payload))
+    end
+
+    def export_card_image(card, zip, blob_paths, used_paths)
+      return nil unless card.image.attached?
+
+      blob = card.image.blob
+      path = write_blob_to_zip(blob, card.number, zip, blob_paths, used_paths)
+      serialize_blob(blob, path)
+    end
+
+    def export_rich_text_embeds(rich_text, card_number, zip, blob_paths, used_paths)
+      return [] unless rich_text.present?
+
+      rich_text.embeds_attachments.map do |attachment|
+        blob = attachment.blob
+        path = write_blob_to_zip(blob, card_number, zip, blob_paths, used_paths)
+        serialize_blob(blob, path)
+      end
+    end
+
+    def export_card_comments(card, zip, blob_paths, used_paths)
+      sorted_comments = card.comments.sort_by { |comment| [ comment.created_at, comment.id ] }
+
+      sorted_comments.map do |comment|
+        comment_attachments = export_rich_text_embeds(comment.body, card.number, zip, blob_paths, used_paths)
+
+        {
+          id: comment.id,
+          body: {
+            plain_text: comment.body.to_plain_text,
+            html: rewrite_rich_text_html(comment.body, blob_paths)
+          },
+          creator: serialize_user(comment.creator),
+          attachments: comment_attachments,
+          created_at: comment.created_at.utc.iso8601,
+          updated_at: comment.updated_at.utc.iso8601
+        }
+      end
+    end
+
+    def write_blob_to_zip(blob, card_number, zip, blob_paths, used_paths)
+      if existing_path = blob_paths[blob.id]
+        existing_path
+      else
+        safe_name = unique_attachment_filename(blob.filename.to_s, used_paths)
+        path = "#{card_number}/#{safe_name}"
+
+        zip.add_file(path, compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+
+        blob_paths[blob.id] = path
+        path
+      end
+    end
+
+    def unique_attachment_filename(raw_filename, used_paths)
+      sanitized = File.basename(raw_filename.to_s).gsub(/[\/\\:\0]/, "_").presence || "attachment"
+
+      if used_paths.add?(sanitized)
+        sanitized
+      else
+        ext = File.extname(sanitized)
+        stem = File.basename(sanitized, ext)
+        counter = 1
+
+        loop do
+          candidate = "#{stem}-#{counter}#{ext}"
+          if used_paths.add?(candidate)
+            break candidate
+          end
+          counter += 1
+        end
+      end
+    end
+
+    def serialize_card(card, image_data, card_attachments, comments_data, blob_paths)
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        description: card.description.to_plain_text,
+        description_html: rewrite_rich_text_html(card.description, blob_paths),
+        board: {
+          id: card.board.id,
+          name: card.board.name
+        },
+        column: card.column && {
+          id: card.column.id,
+          name: card.column.name,
+          color: card.column.color
+        },
+        creator: serialize_user(card.creator),
+        assignees: card.assignees.map { |assignee| serialize_user(assignee) },
+        tags: card.tags.map(&:title).sort,
+        steps: card.steps.map { |step| { id: step.id, content: step.content, completed: step.completed } },
+        closed: card.closed?,
+        closed_at: card.closure&.created_at&.utc&.iso8601,
+        postponed: card.postponed?,
+        golden: card.golden?,
+        due_on: card.due_on&.iso8601,
+        image: image_data,
+        attachments: card_attachments,
+        comments: comments_data,
+        created_at: card.created_at.utc.iso8601,
+        updated_at: card.updated_at.utc.iso8601,
+        last_active_at: card.last_active_at.utc.iso8601
+      }
+    end
+
+    def serialize_blob(blob, path)
+      {
+        filename: blob.filename.to_s,
+        content_type: blob.content_type,
+        byte_size: blob.byte_size,
+        path: path
+      }
+    end
+
+    def serialize_user(person)
+      return nil unless person
+
+      {
+        id: person.id,
+        name: person.name,
+        email_address: person.identity&.email_address
+      }
+    end
+
+    def rewrite_rich_text_html(rich_text, blob_paths)
+      return "" unless rich_text.present?
+
+      html = rich_text.body&.to_html.to_s
+      return "" if html.blank?
+
+      fragment = Nokogiri::HTML::DocumentFragment.parse(html)
+
+      fragment.css("action-text-attachment[sgid]").each do |node|
+        if parsed = SignedGlobalID.parse(node["sgid"], for: ::ActionText::Attachable::LOCATOR_NAME)
+          node.remove_attribute("sgid")
+          if parsed.model_name == "ActiveStorage::Blob" && (local_path = blob_paths[parsed.model_id])
+            node["url"] = local_path
+          end
+        end
+      end
+
+      fragment.to_html
+    end
+end
