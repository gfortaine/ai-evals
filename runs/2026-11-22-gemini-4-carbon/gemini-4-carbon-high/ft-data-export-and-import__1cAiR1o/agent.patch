diff --git a/app/models/zip_file/entry_io.rb b/app/models/zip_file/entry_io.rb
new file mode 100644
index 0000000..087106d
--- /dev/null
+++ b/app/models/zip_file/entry_io.rb
@@ -0,0 +1,86 @@
+class ZipFile::EntryIO
+  CHUNK_SIZE = 1.megabyte
+
+  attr_reader :size
+
+  def initialize(io, entry)
+    @io = io
+    @entry = entry
+    @size = entry.uncompressed_size
+    rewind
+  end
+
+  def rewind
+    @extractor = @entry.extractor_from(@io)
+    @buffer = "".b
+    @bytes_read = 0
+    @extractor_exhausted = (@size == 0 && @entry.compressed_size == 0)
+    0
+  rescue ZipKit::FileReader::UnsupportedFeature => error
+    raise ZipFile::UnsupportedFeatureError, error.message
+  rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::LocalHeaderPending, EOFError, Zlib::Error => error
+    raise ZipFile::InvalidZipError, error.message
+  end
+
+  def eof?
+    @buffer.empty? && extractor_eof?
+  end
+
+  def read(length = nil, outbuf = nil)
+    if length.nil?
+      read_all(outbuf)
+    elsif length == 0
+      replace_buffer(outbuf, "".b)
+    else
+      read_chunk(length, outbuf)
+    end
+  rescue ZipKit::FileReader::ReadError, EOFError, Zlib::Error => error
+    raise ZipFile::InvalidZipError, error.message
+  end
+
+  private
+    def extractor_eof?
+      @extractor_exhausted || @extractor.eof?
+    end
+
+    def read_all(outbuf)
+      fill_buffer until extractor_eof?
+      data = @buffer
+      @buffer = "".b
+      @bytes_read += data.bytesize
+      replace_buffer(outbuf, data)
+    end
+
+    def read_chunk(length, outbuf)
+      fill_buffer while @buffer.bytesize < length && !extractor_eof?
+
+      if @buffer.empty?
+        outbuf&.clear
+        nil
+      else
+        data = @buffer.byteslice(0, length)
+        @buffer = @buffer.byteslice(length..) || "".b
+        @bytes_read += data.bytesize
+        replace_buffer(outbuf, data)
+      end
+    end
+
+    def fill_buffer
+      return if extractor_eof?
+
+      chunk = @extractor.extract(CHUNK_SIZE)
+      if chunk.nil?
+        @extractor_exhausted = true
+      elsif chunk.bytesize > 0
+        @buffer << chunk.b
+      end
+    end
+
+    def replace_buffer(outbuf, data)
+      if outbuf
+        outbuf.replace(data)
+      else
+        data
+      end
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..a2f380e
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,68 @@
+class ZipFile::Reader
+  def initialize(io)
+    @io = io
+    @file_reader = ZipKit::FileReader.new
+    @entries = read_entries
+    @entries_by_path = @entries.index_by(&:filename)
+  end
+
+  def glob(pattern)
+    @entries_by_path.keys.select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def exists?(path)
+    @entries_by_path.key?(path)
+  end
+
+  def entry_size(path)
+    fetch_entry(path).uncompressed_size
+  end
+
+  def read(path)
+    open_file(path, &:read)
+  end
+
+  def open_file(path)
+    entry = fetch_entry(path)
+    ensure_offset_resolved(entry)
+    entry_io = ZipFile::EntryIO.new(@io, entry)
+
+    if block_given?
+      yield entry_io
+    else
+      entry_io
+    end
+  end
+
+  private
+    def read_entries
+      if @io.size == 0
+        raise ZipFile::InvalidZipError, "Archive is empty"
+      end
+
+      @file_reader.read_zip_structure(io: @io, read_local_headers: false)
+    rescue ZipKit::FileReader::UnsupportedFeature => error
+      raise ZipFile::UnsupportedFeatureError, error.message
+    rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, EOFError, ArgumentError, RangeError => error
+      raise ZipFile::InvalidZipError, error.message
+    end
+
+    def fetch_entry(path)
+      @entries_by_path.fetch(path) do
+        raise ZipFile::InvalidZipError, "Missing file in archive: #{path}"
+      end
+    end
+
+    def ensure_offset_resolved(entry)
+      unless entry.known_offset?
+        entry.compressed_data_offset = @file_reader.get_compressed_data_offset(
+          io: @io,
+          local_file_header_offset: entry.local_file_header_offset
+        )
+      end
+    rescue ZipKit::FileReader::UnsupportedFeature => error
+      raise ZipFile::UnsupportedFeatureError, error.message
+    rescue ZipKit::FileReader::ReadError, EOFError, ArgumentError, RangeError => error
+      raise ZipFile::InvalidZipError, error.message
+    end
+end
diff --git a/app/models/zip_file/remote_io.rb b/app/models/zip_file/remote_io.rb
new file mode 100644
index 0000000..4ad8340
--- /dev/null
+++ b/app/models/zip_file/remote_io.rb
@@ -0,0 +1,47 @@
+class ZipFile::RemoteIO < ZipKit::RemoteIO
+  def initialize(url, ssl_verify_peer: true)
+    super(url)
+    @ssl_verify_peer = ssl_verify_peer
+  end
+
+  protected
+    def request_range(range)
+      with_http do |http|
+        request = Net::HTTP::Get.new(@uri)
+        request.range = range
+        response = http.request(request)
+
+        case response.code
+        when "206", "200"
+          response.body
+        else
+          raise ZipFile::InvalidZipError, "Remote at #{@uri} replied with code #{response.code}"
+        end
+      end
+    end
+
+    def request_object_size
+      with_http do |http|
+        request = Net::HTTP::Get.new(@uri)
+        request.range = 0..0
+        response = http.request(request)
+
+        case response.code
+        when "206"
+          response["Content-Range"].split("/").last.to_i
+        when "200"
+          response["Content-Length"].to_i
+        else
+          raise ZipFile::InvalidZipError, "Remote at #{@uri} replied with code #{response.code}"
+        end
+      end
+    end
+
+  private
+    def with_http
+      http = Net::HTTP.new(@uri.hostname, @uri.port)
+      http.use_ssl = (@uri.scheme == "https")
+      http.verify_mode = OpenSSL::SSL::VERIFY_NONE unless @ssl_verify_peer
+      http.start { |conn| yield conn }
+    end
+end
