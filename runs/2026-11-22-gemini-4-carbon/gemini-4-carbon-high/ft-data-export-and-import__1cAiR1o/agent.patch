+    assert_redirected_to account_settings_path
+
+    export = Account::Export.order(created_at: :desc).first
+    assert export.completed?
+    assert export.file.attached?
+
+    email = ActionMailer::Base.deliveries.last
+    assert_not_nil email
+    assert_equal [ @admin.identity.email_address ], email.to
+    assert_equal "Your Fizzy account export is ready", email.subject
+    assert_includes email.body.encoded, account_export_path(export, script_name: @account.slug)
+
+    # Link works within 1 day
+    travel 23.hours do
+      get account_export_path(export)
+      assert_response :success
+      assert_select "a#download-link[data-controller='auto-click']"
+
+      blob_href = css_select("a#download-link").first["href"]
+      get blob_href
+      assert_response :redirect
+      follow_redirect!
+      assert_response :success
+      assert_equal "application/zip", response.media_type
+
+      reader = ZipFile::Reader.new(StringIO.new(response.body))
+      assert reader.glob("data/accounts/*.json").any?
+      assert reader.glob("data/boards/*.json").any?
+      assert reader.glob("data/cards/*.json").any?
+      assert reader.glob("storage/*").any?
+    end
+
+    # Link stops working after 1 day
+    blob_path = rails_blob_path(export.file, disposition: :attachment)
+    travel 25.hours do
+      get account_export_path(export)
+      assert_response :gone
+      assert_match(/expired/i, response.body)
+
+      get blob_path
+      assert_response :forbidden
+    end
+  end
+
+  test "non-admin cannot create or view account export" do
+    export = @account.exports.create!(user: @admin)
+    export.build_now
+
+    logout_and_sign_in_as users(:david)
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_path
+    end
+    assert_response :forbidden
+
+    get account_export_path(export)
+    assert_response :forbidden
+
+    get rails_blob_path(export.file, disposition: :attachment)
+    assert_response :forbidden
+  end
+
+  test "another admin cannot download an export requested by a different admin" do
+    export = @account.exports.create!(user: @admin)
+    export.build_now
+
+    logout_and_sign_in_as users(:jason)
+
+    get account_export_path(export)
+    assert_response :gone
+
+    get rails_blob_path(export.file, disposition: :attachment)
+    assert_response :forbidden
+  end
+end
