 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  test "converts blob and mention sgids to gids on export and re-signs them for the target account on import" do
+    source_account = accounts("37s")
+    user = users(:david)
+    card = cards(:logo)
+
+    blob = nil
+    Current.with_account(source_account) do
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: File.open(file_fixture("moon.jpg"), "rb"),
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+      card.update!(
+        description: <<~HTML
+          <p>Look at <a href="#{source_account.slug}/cards/#{card.number}">this card</a> and ping
+          <action-text-attachment sgid="#{user.attachable_sgid}" content-type="application/vnd.actiontext.mention"></action-text-attachment>
+          with <action-text-attachment sgid="#{blob.attachable_sgid}" content-type="image/jpeg" filename="moon.jpg"></action-text-attachment>
+          and remote <action-text-attachment url="https://example.com/demo.mp4" content-type="video/mp4"></action-text-attachment></p>
+        HTML
+      )
+    end
+
+    tempfile = Tempfile.new([ "rich_text_transfer", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Manifest.new(source_account).export_to(writer)
+    writer.close
+
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+
+    rich_text_json = reader.glob("data/action_text_rich_texts/*.json").flat_map { |p| JSON.parse(reader.read(p)) }
+    exported_rt = rich_text_json.find { |row| row["record_id"] == card.id && row["name"] == "description" }
+    assert_not_nil exported_rt
+    assert_no_match(/sgid=/, exported_rt["body"])
+    assert_includes exported_rt["body"], "gid=\"gid://fizzy/User/#{user.id}\""
+    assert_includes exported_rt["body"], "gid=\"gid://fizzy/ActiveStorage::Blob/#{blob.id}\""
+    assert_includes exported_rt["body"], 'url="https://example.com/demo.mp4"'
+
+    target_account = Account.create!(name: "Target")
+    manifest = Account::DataTransfer::Manifest.new(target_account)
+    manifest.check(reader)
+    mapper = manifest.import_from(reader)
+
+    imported_card = target_account.cards.find(mapper.remap_id(card.id))
+    imported_user = target_account.users.find(mapper.remap_id(user.id))
+    imported_blob = ActiveStorage::Blob.find(mapper.remap_id(blob.id))
+
+    imported_html = imported_card.description.body.to_html
+    assert_no_match(/\bgid="/, imported_html)
+    assert_includes imported_html, imported_user.attachable_sgid
+    assert_includes imported_html, imported_blob.attachable_sgid
+    assert_includes imported_html, "#{target_account.slug}/cards/#{card.number}"
+    assert_includes imported_html, "#{target_account.slug}/rails/active_storage/blobs/"
+    assert_includes imported_html, 'url="https://example.com/demo.mp4"'
+  ensure
+    tempfile&.close!
+  end
 end
