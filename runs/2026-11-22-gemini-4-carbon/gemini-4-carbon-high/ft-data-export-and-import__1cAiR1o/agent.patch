+class ExportMailer < ApplicationMailer
+  def completed(export)
+    @export = export
+    @user = export.user
+    @account = export.account
+    @download_url = download_url_for(export)
+
+    mail(
+      to: @user.identity.email_address,
+      subject: subject_for(export)
+    )
+  end
+
+  private
+    def download_url_for(export)
+      if export.is_a?(Account::Export)
+        account_export_url(export, script_name: export.account.slug)
+      else
+        user_data_export_url(export.user, export, script_name: export.account.slug)
+      end
+    end
+
+    def subject_for(export)
+      if export.is_a?(Account::Export)
+        "Your Fizzy account export is ready"
+      else
+        "Your Fizzy data export is ready"
+      end
+    end
+end
