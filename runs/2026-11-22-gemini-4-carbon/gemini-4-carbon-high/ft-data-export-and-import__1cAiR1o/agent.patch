+  test "reader reads deflated, stored, and empty entries and streams via EntryIO" do
+    tempfile = Tempfile.new([ "test", ".zip" ])
+    tempfile.binmode
+
+    binary_payload = Random.bytes(64 * 1024)
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("data/info.json", '{"hello":"world"}', compress: true)
+    writer.add_file("storage/blob1", binary_payload, compress: false)
+    writer.add_file("empty.txt", "", compress: true)
+    writer.add_file("empty_stored.bin", "", compress: false)
+    writer.close
+
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+
+    assert reader.exists?("data/info.json")
+    assert reader.exists?("storage/blob1")
+    assert_not reader.exists?("nope.json")
+    assert_equal [ "data/info.json" ], reader.glob("data/*.json")
+    assert_equal '{"hello":"world"}', reader.read("data/info.json")
+    assert_equal binary_payload.bytesize, reader.entry_size("storage/blob1")
+    assert_equal "", reader.read("empty.txt")
+    assert_equal "", reader.read("empty_stored.bin")
+
+    reader.open_file("storage/blob1") do |entry_io|
+      dest = StringIO.new("".b)
+      IO.copy_stream(entry_io, dest)
+      assert_equal binary_payload, dest.string
+
+      entry_io.rewind
+      assert_equal binary_payload.byteslice(0, 100), entry_io.read(100)
+    end
+  ensure
+    tempfile&.close!
+  end
+
+  test "reader raises InvalidZipError for empty or corrupt files" do
+    assert_raises(ZipFile::InvalidZipError) do
+      ZipFile::Reader.new(StringIO.new(""))
+    end
+
+    assert_raises(ZipFile::InvalidZipError) do
+      ZipFile::Reader.new(StringIO.new("definitely not a zip file"))
+    end
+  end
+
+  test "remote_io reads zip over HTTP range requests" do
+    tempfile = Tempfile.new([ "remote", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("hello.txt", "Remote Hello!", compress: true)
+    writer.add_file("bin/raw.dat", "BinaryContent123", compress: false)
+    writer.close
+
+    zip_bytes = File.binread(tempfile.path)
+    url = "https://storage.example.com/bucket/export.zip"
+
+    stub_request(:get, url).to_return do |request|
+      range_header = request.headers["Range"]
+      if range_header =~ /bytes=(\d+)-(\d+)/
+        first, last = $1.to_i, $2.to_i
+        slice = zip_bytes.byteslice(first..last)
+        {
+          status: 206,
+          body: slice,
+          headers: {
+            "Content-Range" => "bytes #{first}-#{first + slice.bytesize - 1}/#{zip_bytes.bytesize}",
+            "Content-Length" => slice.bytesize.to_s
+          }
+        }
+      else
+        { status: 200, body: zip_bytes, headers: { "Content-Length" => zip_bytes.bytesize.to_s } }
+      end
+    end
+
+    remote_io = ZipFile::RemoteIO.new(url)
+    reader = ZipFile::Reader.new(remote_io)
+
+    assert_equal "Remote Hello!", reader.read("hello.txt")
+    assert_equal "BinaryContent123", reader.read("bin/raw.dat")
+  ensure
+    tempfile&.close!
+  end
+end
