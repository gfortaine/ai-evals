+require "test_helper"
+
+class Account::DataTransfer::ManifestTest < ActiveSupport::TestCase
+  test "exports, checks, and imports full account data including boards, cards, comments, files, filters, and people" do
+    source_account = accounts("37s")
+    kevin = users(:kevin)
+    card = cards(:logo)
+    filter = nil
+
+    Current.with_account(source_account) do
+      card.image.attach(io: File.open(file_fixture("avatar.png"), "rb"), filename: "avatar.png", content_type: "image/png")
+      filter = kevin.filters.create!(
+        fields: { indexed_by: "closed", card_ids: [ card.id ] },
+        boards: [ boards(:writebook) ],
+        tags: [ tags(:web) ],
+        assignees: [ kevin ]
+      )
+    end
+
+    tempfile = Tempfile.new([ "manifest_test", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Manifest.new(source_account).export_to(writer)
+    writer.close
+
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+
+    target_account = Account.create!(name: "Placeholder")
+    manifest = Account::DataTransfer::Manifest.new(target_account)
+    manifest.check(reader)
+    mapper = manifest.import_from(reader)
+
+    target_account.reload
+    assert_equal source_account.name, target_account.name
+    assert_equal source_account.cards_count, target_account.cards_count
+    assert_not_equal source_account.external_account_id, target_account.external_account_id
+
+    assert_equal source_account.users.count, target_account.users.count
+    assert_equal source_account.boards.count, target_account.boards.count
+    assert_equal source_account.cards.count, target_account.cards.count
+    assert_equal Comment.where(account: source_account).count, Comment.where(account: target_account).count
+
+    imported_card = target_account.cards.find(mapper.remap_id(card.id))
+    assert imported_card.image.attached?
+    assert_equal "avatar.png", imported_card.image.filename.to_s
+    assert_equal File.binread(file_fixture("avatar.png")), imported_card.image.download
+
+    imported_kevin = target_account.users.find_by!(identity: kevin.identity)
+    imported_filter = imported_kevin.filters.find_by(id: mapper.remap_id(filter.id))
+    assert_not_nil imported_filter
+    assert_equal [ "Writebook" ], imported_filter.boards.map(&:name)
+    assert_equal [ "web" ], imported_filter.tags.map(&:title)
+    assert_equal [ imported_kevin.id ], imported_filter.assignees.map(&:id)
+    assert_equal [ imported_card.id ], imported_filter.card_ids
+  ensure
+    tempfile&.close!
+  end
+
+  test "check fails when attached file is missing from storage directory" do
+    source_account = accounts("37s")
+    card = cards(:logo)
+    filter = nil
+
+    Current.with_account(source_account) do
+      card.image.attach(io: File.open(file_fixture("moon.jpg"), "rb"), filename: "moon.jpg", content_type: "image/jpeg")
+    end
+
+    # Build an incomplete zip missing storage/* files
+    tempfile = Tempfile.new([ "broken_manifest", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Manifest.new(source_account).each_record_set do |rs|
+      next if rs.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+      rs.export(to: writer)
+    end
+    writer.close
+
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+
+    target_account = Account.create!(name: "Placeholder")
+    error = assert_raises(Account::DataTransfer::Error) do
+      Account::DataTransfer::Manifest.new(target_account).check(reader)
+    end
+    assert_match(/missing an attached file.*moon\.jpg/i, error.message)
+  ensure
+    tempfile&.close!
+  end
+end
