diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..5bc3409
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,266 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  test "unauthenticated user visiting /account/imports/new is redirected to login" do
+    untenanted do
+      get "/account/imports/new"
+      assert_redirected_to new_session_path(script_name: nil)
+    end
+  end
+
+  test "signed-in user imports an account export at /account/imports/new and gets a new account with everything and an email" do
+    source_account = accounts("37s")
+    kevin = users(:kevin)
+    david = users(:david)
+    card = cards(:logo)
+
+    # Enrich source account with card image, embedded file, comment attachment, avatar, and mention
+    Current.with_account(source_account) do
+      kevin.avatar.attach(
+        io: File.open(file_fixture("avatar.png"), "rb"),
+        filename: "avatar.png",
+        content_type: "image/png"
+      )
+      card.image.attach(
+        io: File.open(file_fixture("moon.jpg"), "rb"),
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+      comment_blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("important attachment bytes"),
+        filename: "notes.txt",
+        content_type: "text/plain"
+      )
+      card.comments.create!(
+        creator: kevin,
+        body: <<~HTML
+          <p>Hey <action-text-attachment sgid="#{david.attachable_sgid}" content-type="application/vnd.actiontext.mention"></action-text-attachment>
+          check <action-text-attachment sgid="#{comment_blob.attachable_sgid}" content-type="text/plain" filename="notes.txt"></action-text-attachment>
+          searchableuniqueword</p>
+        HTML
+      )
+    end
+
+    export = source_account.exports.create!(user: kevin)
+    export.build_now
+    zip_path = ActiveStorage::Blob.service.path_for(export.file.blob.key)
+
+    # Sign in as an identity who wasn't even in the 37s account (or has no account yet)
+    importer_identity = Identity.create!(email_address: "corporate-importer@example.com")
+    sign_in_as importer_identity
+    ActionMailer::Base.deliveries.clear
+
+    untenanted do
+      get "/account/imports/new"
+      assert_response :success
+      assert_select "form[action='/account/imports']"
+
+      uploaded = Rack::Test::UploadedFile.new(zip_path, "application/zip")
+
+      assert_difference -> { Account.count }, 1 do
+        perform_enqueued_jobs do
+          post "/account/imports", params: { file: uploaded }
+        end
+      end
+
+      import = importer_identity.account_imports.order(created_at: :desc).first
+      assert_redirected_to account_import_path(import, script_name: nil)
+      assert import.completed?
+
+      new_account = import.account
+      assert_not_nil new_account
+      assert_not_equal source_account.id, new_account.id
+      assert_not_equal source_account.external_account_id, new_account.external_account_id
+      assert_equal source_account.name, new_account.name
+
+      # Everything is in the new account: boards, cards, comments, files, people (+ the importer!)
+      assert_equal source_account.boards.pluck(:name).sort, new_account.boards.pluck(:name).sort
+      assert_equal source_account.cards.pluck(:number, :title).sort, new_account.cards.pluck(:number, :title).sort
+      assert_equal Comment.where(account: source_account).count, Comment.where(account: new_account).count
+      assert_equal source_account.users.count + 1, new_account.users.count
+
+      imported_kevin = new_account.users.find_by!(identity: kevin.identity)
+      assert imported_kevin.avatar.attached?
+      assert_equal File.binread(file_fixture("avatar.png")), imported_kevin.avatar.download
+
+      imported_card = new_account.cards.find_by!(number: card.number)
+      assert imported_card.image.attached?
+      assert_equal File.binread(file_fixture("moon.jpg")), imported_card.image.download
+
+      imported_comment = imported_card.comments.detect { |c| c.body.to_plain_text.include?("searchableuniqueword") }
+      assert_not_nil imported_comment
+      assert_equal 1, imported_comment.body.embeds.size
+      assert_equal "important attachment bytes", imported_comment.body.embeds.first.download
+
+      # Full-text search works in the new account
+      importer_user = new_account.users.find_by!(identity: importer_identity)
+      assert importer_user.admin?
+      search_results = Search::Record.for(new_account.id).search("searchableuniqueword", user: importer_user)
+      assert_includes search_results.map(&:card_id), imported_card.id
+
+      # Storage is reconciled
+      assert_operator new_account.bytes_used, :>, 0
+
+      # Completion email arrived with link to new account
+      email = ActionMailer::Base.deliveries.last
+      assert_not_nil email
+      assert_equal [ importer_identity.email_address ], email.to
+      assert_equal "Your Fizzy account import is complete", email.subject
+      assert_includes email.body.encoded, landing_path(script_name: new_account.slug)
+
+      # Importer can browse the new account directly
+      get board_path(new_account.boards.find_by!(name: "Writebook"), script_name: new_account.slug)
+      assert_response :success
+    end
+  end
+
+  test "submit without file returns unprocessable_entity and creates nothing" do
+    sign_in_as users(:kevin)
+
+    untenanted do
+      assert_no_difference [ -> { Account.count }, -> { Account::Import.count } ] do
+        post "/account/imports", params: {}
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "failed import of corrupt zip sends failure email explaining why and leaves nothing behind" do
+    sign_in_as users(:kevin)
+    ActionMailer::Base.deliveries.clear
+
+    corrupt_tempfile = Tempfile.new([ "corrupt", ".zip" ])
+    corrupt_tempfile.write("this is not a zip file at all")
+    corrupt_tempfile.rewind
+
+    untenanted do
+      assert_nothing_left_behind do
+        perform_enqueued_jobs do
+          post "/account/imports", params: {
+            file: Rack::Test::UploadedFile.new(corrupt_tempfile.path, "application/zip")
+          }
+        end
+      end
+    end
+
+    import = identities(:kevin).account_imports.order(created_at: :desc).first
+    assert import.failed?
+    assert_nil import.account_id
+    assert_not import.file.attached?
+    assert_match(/not a valid ZIP archive/i, import.failure_reason)
+
+    email = ActionMailer::Base.deliveries.last
+    assert_not_nil email
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_equal "Your Fizzy account import failed", email.subject
+    assert_includes email.body.encoded, import.failure_reason
+  ensure
+    corrupt_tempfile&.close!
+  end
+
+  test "failed import of user card export zip instead of account zip sends failure email and leaves nothing behind" do
+    david = users(:david)
+    user_export = david.data_exports.create!(account: accounts("37s"))
+    user_export.build_now
+    zip_path = ActiveStorage::Blob.service.path_for(user_export.file.blob.key)
+
+    sign_in_as david
+    ActionMailer::Base.deliveries.clear
+
+    untenanted do
+      assert_nothing_left_behind do
+        perform_enqueued_jobs do
+          post "/account/imports", params: {
+            file: Rack::Test::UploadedFile.new(zip_path, "application/zip")
+          }
+        end
+      end
+    end
+
+    import = identities(:david).account_imports.order(created_at: :desc).first
+    assert import.failed?
+    assert_match(/missing account data/i, import.failure_reason)
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal "Your Fizzy account import failed", email.subject
+    assert_includes email.body.encoded, import.failure_reason
+  end
+
+  test "import that fails mid-way after creating identities and uploading files rolls back everything and leaves nothing behind" do
+    source_account = accounts("37s")
+    kevin = users(:kevin)
+    card = cards(:logo)
+
+    Current.with_account(source_account) do
+      card.image.attach(
+        io: File.open(file_fixture("moon.jpg"), "rb"),
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+      brand_new_identity = Identity.create!(email_address: "brand-new-person@corp.example")
+      source_account.users.create!(identity: brand_new_identity, name: "Brand New", role: :member, verified_at: Time.current)
+    end
+
+    export = source_account.exports.create!(user: kevin)
+    export.build_now
+    zip_path = ActiveStorage::Blob.service.path_for(export.file.blob.key)
+
+    # Remove brand_new_identity's user & identity so importing will have to create a fresh Identity row inside UserRecordSet
+    Identity.find_by!(email_address: "brand-new-person@corp.example").destroy!
+    assert_not Identity.exists?(email_address: "brand-new-person@corp.example")
+
+    sign_in_as kevin
+    ActionMailer::Base.deliveries.clear
+
+    # Simulate an unexpected failure right at the end of the import transaction (after DB rows + storage files are written!)
+    Account::Import.any_instance.stubs(:reindex_search).raises(RuntimeError.new("Simulated disk full during indexing"))
+
+    storage_root = ActiveStorage::Blob.service.root
+    files_before = Dir.glob("#{storage_root}/**/*").select { |f| File.file?(f) }.sort
+
+    untenanted do
+      assert_nothing_left_behind do
+        perform_enqueued_jobs do
+          post "/account/imports", params: {
+            file: Rack::Test::UploadedFile.new(zip_path, "application/zip")
+          }
+        end
+      end
+    end
+
+    files_after = Dir.glob("#{storage_root}/**/*").select { |f| File.file?(f) }.sort
+    assert_equal files_before, files_after
+    assert_not Identity.exists?(email_address: "brand-new-person@corp.example")
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal "Your Fizzy account import failed", email.subject
+    assert_includes email.body.encoded, "Simulated disk full during indexing"
+  end
+
+  private
+    def assert_nothing_left_behind(&block)
+      tracked_counts = -> {
+        {
+          accounts: Account.count,
+          identities: Identity.count,
+          users: User.count,
+          boards: Board.count,
+          columns: Column.count,
+          cards: Card.count,
+          comments: Comment.count,
+          events: Event.count,
+          blobs: ActiveStorage::Blob.count,
+          attachments: ActiveStorage::Attachment.count,
+          rich_texts: ActionText::RichText.count,
+          storage_entries: Storage::Entry.count,
+          storage_totals: Storage::Total.count
+        }
+      }
+
+      before = tracked_counts.call
+      yield
+      after = tracked_counts.call
+
+      assert_equal before, after
+    end
+end
