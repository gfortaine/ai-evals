diff --git a/app/models/account/data_transfer/active_storage/file_record_set.rb b/app/models/account/data_transfer/active_storage/file_record_set.rb
index 1367a49..ea9535b 100644
--- a/app/models/account/data_transfer/active_storage/file_record_set.rb
+++ b/app/models/account/data_transfer/active_storage/file_record_set.rb
@@ -12,4 +12,55 @@ class Account::DataTransfer::ActiveStorage::FileRecordSet < Account::DataTransfe
       ::ActiveStorage::Attachment.where(account: account, record_type: INTERNAL_RECORD_TYPES).select(:blob_id)
     end
 
+    def export_records
+      records.find_each do |blob|
+        zip.add_file("storage/#{blob.key}", compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+    end
+
+    def check_records
+      each_blob_record do |blob_attrs|
+        storage_path = "storage/#{blob_attrs["key"]}"
+        unless zip.exists?(storage_path)
+          raise Account::DataTransfer::Error, "The archive is missing an attached file (#{blob_attrs["filename"]})."
+        end
+
+        expected_size = blob_attrs["byte_size"].to_i
+        actual_size = zip.entry_size(storage_path)
+        if expected_size != actual_size
+          raise Account::DataTransfer::Error, "The attached file #{blob_attrs["filename"]} in the archive is incomplete or corrupted."
+        end
+      end
+    end
+
+    def import_records(mapper)
+      service = ::ActiveStorage::Blob.service
+
+      each_blob_record do |blob_attrs|
+        old_key = blob_attrs["key"]
+        new_key = mapper.remap_token(old_key, namespace: "blob", length: 28)
+        mapper.uploaded_keys << new_key
+
+        zip.open_file("storage/#{old_key}") do |entry_io|
+          service.upload(
+            new_key,
+            entry_io,
+            content_type: blob_attrs["content_type"],
+            filename: ::ActiveStorage::Filename.new(blob_attrs["filename"].to_s)
+          )
+        end
+      end
+    end
+
+    def each_blob_record
+      zip.glob("data/#{::ActiveStorage::Blob.table_name}/*.json").each do |path|
+        parsed = JSON.parse(zip.read(path))
+        rows = parsed.is_a?(Array) ? parsed : [ parsed ]
+        rows.each { |row| yield row }
+      rescue JSON::ParserError
+        raise Account::DataTransfer::Error, "The archive contains corrupted blob metadata (#{path})."
+      end
+    end
 end
