diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..0da9547
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,201 @@
+class Account::Import < ApplicationRecord
+  STALE_THRESHOLD = 1.day
+
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  scope :stale, -> { where(status: %w[ completed failed ], updated_at: ...STALE_THRESHOLD.ago) }
+
+  class << self
+    def start(identity:, file:)
+      shell_account = nil
+      import = nil
+
+      Current.without_account do
+        shell_account = Account.create!(name: "Importing account...")
+        import = create!(identity: identity, account: shell_account)
+
+        Current.with_account(shell_account) do
+          import.file.attach(file)
+        end
+
+        import.process_later
+        import
+      end
+    rescue => error
+      Storage::Entry.suppressing_recording do
+        import&.file&.purge if import&.file&.attached?
+        import&.destroy
+        shell_account&.destroy
+      end
+      raise error
+    end
+
+    def cleanup
+      stale.find_each(&:destroy)
+    end
+  end
+
+  def process_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def process_now
+    return unless pending?
+
+    processing!
+    mapper = Account::DataTransfer::IdMapper.new(account)
+
+    Current.without_account do
+      Storage::Entry.suppressing_recording do
+        ZipFile.read_from(file) do |zip|
+          manifest = Account::DataTransfer::Manifest.new(account)
+          manifest.check(zip)
+
+          ApplicationRecord.transaction(requires_new: true) do
+            manifest.import_from(zip, mapper: mapper)
+            ensure_importer_access
+            reindex_search
+          end
+        end
+      end
+
+      reconcile_imported_storage
+      purge_uploaded_archive
+      mark_completed
+      deliver_completed_later
+    end
+  rescue => error
+    cleanup_failed_import(error, mapper)
+  end
+
+  private
+    def ensure_importer_access
+      importer_user = account.users.find_by(identity: identity)
+
+      if importer_user
+        updates = {}
+        updates[:active] = true unless importer_user.active?
+        updates[:verified_at] = Time.current unless importer_user.verified?
+
+        unless importer_user.admin?
+          updates[:role] = account.users.owner.exists? ? "admin" : "owner"
+        end
+
+        importer_user.update_columns(updates) if updates.any?
+      else
+        role = account.users.owner.exists? ? :admin : :owner
+        name = identity.users.order(created_at: :desc).pick(:name) || identity.email_address
+        importer_user = account.users.create!(
+          identity: identity,
+          name: name,
+          role: role,
+          active: true,
+          verified_at: Time.current
+        )
+        grant_board_access_to(importer_user)
+      end
+    end
+
+    def grant_board_access_to(importer_user)
+      board_ids = account.boards.ids - importer_user.accesses.pluck(:board_id)
+      return if board_ids.empty?
+
+      Access.insert_all(
+        board_ids.map do |board_id|
+          {
+            id: ActiveRecord::Type::Uuid.generate,
+            account_id: account.id,
+            board_id: board_id,
+            user_id: importer_user.id,
+            involvement: "watching"
+          }
+        end
+      )
+    end
+
+    def reindex_search
+      account.cards.includes(:rich_text_description).find_each(&:reindex)
+      Comment.where(account: account).includes(:rich_text_body, :card).find_each(&:reindex)
+    end
+
+    def reconcile_imported_storage
+      account.boards.find_each do |board|
+        board.reconcile_storage
+        board.materialize_storage
+      end
+
+      account.reconcile_storage
+      account.materialize_storage
+    end
+
+    def purge_uploaded_archive
+      Storage::Entry.suppressing_recording do
+        file.purge if file.attached?
+      end
+    end
+
+    def mark_completed
+      update!(status: :completed, completed_at: Time.current)
+    end
+
+    def deliver_completed_later
+      ImportMailer.completed(self).deliver_later
+    end
+
+    def cleanup_failed_import(error, mapper)
+      reason = failure_message_for(error)
+      failed_account = account
+
+      mapper&.uploaded_keys&.each do |key|
+        ActiveStorage::Blob.service.delete(key)
+      rescue StandardError
+        nil
+      end
+
+      Storage::Entry.suppressing_recording do
+        file.purge if file.attached?
+        update!(account: nil, status: :failed, failure_reason: reason)
+
+        if failed_account
+          purge_residual_account_records(failed_account.id)
+          if Account.exists?(failed_account.id)
+            failed_account.reload.destroy!
+          end
+        end
+      end
+
+      Current.without_account do
+        ImportMailer.failed(self).deliver_later
+      end
+    end
+
+    def purge_residual_account_records(failed_account_id)
+      ActiveStorage::Attachment.where(account_id: failed_account_id).delete_all
+      ActiveStorage::VariantRecord.where(account_id: failed_account_id).delete_all
+      ActiveStorage::Blob.where(account_id: failed_account_id).delete_all
+      ActionText::RichText.where(account_id: failed_account_id).delete_all
+      Storage::Entry.where(account_id: failed_account_id).delete_all
+      Storage::Total.where(owner_type: "Account", owner_id: failed_account_id).delete_all
+      Search::Record.for(failed_account_id).where(account_id: failed_account_id).destroy_all
+    end
+
+    def failure_message_for(error)
+      case error
+      when Account::DataTransfer::Error
+        error.message
+      when ZipFile::UnsupportedFeatureError
+        "The ZIP archive uses an unsupported format (such as encryption or split archives)."
+      when ZipFile::InvalidZipError
+        "The uploaded file is not a valid ZIP archive or is corrupted."
+      when ActiveRecord::RecordInvalid
+        "The archive contains invalid data: #{error.message}"
+      else
+        "The import could not be completed (#{error.message})."
+      end
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..22a75ed
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,76 @@
+class Export < ApplicationRecord
+  EXPIRATION_TIME = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  scope :current, -> { completed.where(completed_at: EXPIRATION_TIME.ago..) }
+  scope :expired, -> {
+    where(completed_at: ...EXPIRATION_TIME.ago)
+      .or(where.not(status: :completed).where(created_at: ...(EXPIRATION_TIME * 2).ago))
+  }
+
+  after_create_commit :build_later
+
+  class << self
+    def cleanup
+      expired.find_each(&:destroy)
+    end
+  end
+
+  def build_later
+    Export::BuildJob.perform_later(self)
+  end
+
+  def build_now
+    processing!
+
+    Current.with_account(account) do
+      populate_zip
+      mark_completed
+      deliver_notification_later
+    end
+  rescue => error
+    failed!
+    raise error
+  end
+
+  def expired?
+    if completed_at.present?
+      completed_at < EXPIRATION_TIME.ago
+    else
+      created_at < EXPIRATION_TIME.ago
+    end
+  end
+
+  def downloadable?
+    completed? && !expired? && file.attached?
+  end
+
+  def accessible_to?(accessor)
+    accessor.present? && accessor.active? && user == accessor && downloadable?
+  end
+
+  private
+    def populate_zip
+      raise NotImplementedError
+    end
+
+    def mark_completed
+      update!(status: :completed, completed_at: Time.current)
+    end
+
+    def deliver_notification_later
+      ExportMailer.completed(self).deliver_later
+    end
+
+    def base_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
