@@ -0,0 +1,227 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  setup do
+    leaves(:welcome_section).update!(title: '""Welcome" to the Section"')
+    leaves(:welcome_page).update!(title: '""Getting Started" Guide"')
+    leaves(:reading_picture).update!(title: '"Reading "Deeply""')
+    leaves(:summary_page).update!(title: '""Summary""')
+  end
+
+  test "strips outer stray quotes while keeping inner quotes intact" do
+    TitleCleanupJob.perform_now
+
+    assert_equal '"Welcome" to the Section', leaves(:welcome_section).reload.title
+    assert_equal '"Getting Started" Guide', leaves(:welcome_page).reload.title
+    assert_equal 'Reading "Deeply"', leaves(:reading_picture).reload.title
+    assert_equal '"Summary"', leaves(:summary_page).reload.title
+  end
+
+  test "resumes where it left off when interrupted via queue adapter stopping" do
+    TitleCleanupJob.perform_later
+
+    updates = 0
+    queue_adapter.with(stopping: -> { updates >= 2 }) do
+      with_leaf_update_counter(-> { updates += 1 }) do
+        perform_enqueued_jobs
+      end
+    end
+
+    assert_equal '"Welcome" to the Section', leaves(:welcome_section).reload.title
+    assert_equal '"Getting Started" Guide', leaves(:welcome_page).reload.title
+    assert_equal '"Reading "Deeply""', leaves(:reading_picture).reload.title
+    assert_equal '""Summary""', leaves(:summary_page).reload.title
+    assert_enqueued_jobs 1, only: TitleCleanupJob
+
+    resumed_leaf_ids = []
+    with_leaf_update_counter(->(id) { resumed_leaf_ids << id }) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal [ leaves(:reading_picture).id, leaves(:summary_page).id ], resumed_leaf_ids
+    assert_equal '"Welcome" to the Section', leaves(:welcome_section).reload.title
+    assert_equal '"Getting Started" Guide', leaves(:welcome_page).reload.title
+    assert_equal 'Reading "Deeply"', leaves(:reading_picture).reload.title
+    assert_equal '"Summary"', leaves(:summary_page).reload.title
+    assert_no_enqueued_jobs
+  end
+
+  test "resumes with interrupt_job_during_step helper" do
+    TitleCleanupJob.perform_later
+
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: leaves(:welcome_page).id.succ) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal '"Welcome" to the Section', leaves(:welcome_section).reload.title
+    assert_equal '"Getting Started" Guide', leaves(:welcome_page).reload.title
+    assert_equal '"Reading "Deeply""', leaves(:reading_picture).reload.title
+    assert_equal '""Summary""', leaves(:summary_page).reload.title
+
+    perform_enqueued_jobs
+
+    assert_equal '"Welcome" to the Section', leaves(:welcome_section).reload.title
+    assert_equal '"Getting Started" Guide', leaves(:welcome_page).reload.title
+    assert_equal 'Reading "Deeply"', leaves(:reading_picture).reload.title
+    assert_equal '"Summary"', leaves(:summary_page).reload.title
+  end
+
+  test "survives multiple interruptions across the collection" do
+    TitleCleanupJob.perform_later
+
+    3.times do
+      updates = 0
+      queue_adapter.with(stopping: -> { updates >= 1 }) do
+        with_leaf_update_counter(-> { updates += 1 }) do
+          perform_enqueued_jobs
+        end
+      end
+      assert_enqueued_jobs 1, only: TitleCleanupJob
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal '"Welcome" to the Section', leaves(:welcome_section).reload.title
+    assert_equal '"Getting Started" Guide', leaves(:welcome_page).reload.title
+    assert_equal 'Reading "Deeply"', leaves(:reading_picture).reload.title
+    assert_equal '"Summary"', leaves(:summary_page).reload.title
+    assert_no_enqueued_jobs
+  end
+
+  test "picks up where it left off and redoes at most the interrupted leaf after abrupt termination mid-update" do
+    updates = 0
+    assert_raises(SignalException) do
+      with_leaf_update_counter(-> {
+        updates += 1
+        raise SignalException, "TERM" if updates == 2
+      }) do
+        TitleCleanupJob.perform_now
+      end
+    end
+
+    assert_equal '"Welcome" to the Section', leaves(:welcome_section).reload.title
+    assert_equal '""Getting Started" Guide"', leaves(:welcome_page).reload.title
+    assert_equal '"Reading "Deeply""', leaves(:reading_picture).reload.title
+    assert_equal '""Summary""', leaves(:summary_page).reload.title
+
+    restarted_leaf_ids = []
+    with_leaf_update_counter(->(id) { restarted_leaf_ids << id }) do
+      TitleCleanupJob.perform_now
+    end
+
+    assert_equal [
+      leaves(:welcome_page).id,
+      leaves(:reading_picture).id,
+      leaves(:summary_page).id
+    ], restarted_leaf_ids
+    assert_equal '"Welcome" to the Section', leaves(:welcome_section).reload.title
+    assert_equal '"Getting Started" Guide', leaves(:welcome_page).reload.title
+    assert_equal 'Reading "Deeply"', leaves(:reading_picture).reload.title
+    assert_equal '"Summary"', leaves(:summary_page).reload.title
+  end
+
+  test "does not clean a leaf twice if interrupted after commit before advancing step" do
+    TitleCleanupJob.perform_later
+
+    committed = 0
+    callback = -> {
+      committed += 1
+      raise RuntimeError, "interrupted after commit" if committed == 2
+    }
+
+    Leaf.set_callback(:commit, :after, &callback)
+    begin
+      perform_enqueued_jobs
+    ensure
+      Leaf.skip_callback(:commit, :after, &callback)
+    end
+
+    assert_equal '"Welcome" to the Section', leaves(:welcome_section).reload.title
+    assert_equal '"Getting Started" Guide', leaves(:welcome_page).reload.title
+    assert_equal '"Reading "Deeply""', leaves(:reading_picture).reload.title
+    assert_enqueued_jobs 1, only: TitleCleanupJob
+
+    perform_enqueued_jobs
+
+    assert_equal '"Welcome" to the Section', leaves(:welcome_section).reload.title
+    assert_equal '"Getting Started" Guide', leaves(:welcome_page).reload.title
+    assert_equal 'Reading "Deeply"', leaves(:reading_picture).reload.title
+    assert_equal '"Summary"', leaves(:summary_page).reload.title
+  end
+
+  test "handles Resque::TermException by re-enqueuing to resume without losing progress" do
+    TitleCleanupJob.perform_later
+
+    updates = 0
+    with_leaf_update_counter(-> {
+      updates += 1
+      raise Resque::TermException, "SIGTERM" if updates == 2
+    }) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal '"Welcome" to the Section', leaves(:welcome_section).reload.title
+    assert_equal '""Getting Started" Guide"', leaves(:welcome_page).reload.title
+    assert_enqueued_jobs 1, only: TitleCleanupJob
+
+    perform_enqueued_jobs
+
+    assert_equal '"Welcome" to the Section', leaves(:welcome_section).reload.title
+    assert_equal '"Getting Started" Guide', leaves(:welcome_page).reload.title
+    assert_equal 'Reading "Deeply"', leaves(:reading_picture).reload.title
+    assert_equal '"Summary"', leaves(:summary_page).reload.title
+  end
+
+  test "resque adapter reports stopping when active Resque worker is shutting down" do
+    adapter = ActiveJob::QueueAdapters::ResqueAdapter.new
+    worker = Resque::Worker.new(:default)
+    resque_job = Struct.new(:inspect) do
+      define_method(:perform) do
+        raise "expected stopping" unless adapter.stopping?
+      end
+    end.new("test-job")
+
+    assert_not adapter.stopping?
+    worker.shutdown
+    worker.perform(resque_job)
+    assert_not adapter.stopping?
+  end
+
+  test "does not re-clean already cleaned leaves on subsequent runs while cleaning newly added leaves" do
+    TitleCleanupJob.perform_now
+    TitleCleanupJob.perform_now
+
+    assert_equal '"Welcome" to the Section', leaves(:welcome_section).reload.title
+    assert_equal '"Getting Started" Guide', leaves(:welcome_page).reload.title
+    assert_equal 'Reading "Deeply"', leaves(:reading_picture).reload.title
+    assert_equal '"Summary"', leaves(:summary_page).reload.title
+
+    new_leaf = books(:handbook).press(Section.new(body: "Body"), title: '""Appendix" Notes"')
+    TitleCleanupJob.perform_now
+    assert_equal '"Appendix" Notes', new_leaf.reload.title
+    assert_equal '"Welcome" to the Section', leaves(:welcome_section).reload.title
+  end
+
+  test "handles empty leaf collection" do
+    Leaf.destroy_all
+    assert_nothing_raised { TitleCleanupJob.perform_now }
+    assert_nil JobCheckpoint.read("TitleCleanupJob")
+  end
+
+  private
+    def with_leaf_update_counter(on_update)
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, payload|
+        if payload[:sql].start_with?('UPDATE "leaves"')
+          leaf_id = payload[:type_casted_binds]&.last
+          on_update.arity == 0 ? on_update.call : on_update.call(leaf_id)
+        end
+      end
+
+      yield
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+end
