diff --git a/lib/rails_ext/active_job_resque_continuable.rb b/lib/rails_ext/active_job_resque_continuable.rb
new file mode 100644
index 0000000..fce034a
--- /dev/null
+++ b/lib/rails_ext/active_job_resque_continuable.rb
@@ -0,0 +1,21 @@
+module ResqueWorkerCurrentTracking
+  def perform(job, &block)
+    previous_worker = Thread.current[:resque_worker]
+    Thread.current[:resque_worker] = self
+    super
+  ensure
+    Thread.current[:resque_worker] = previous_worker
+  end
+end
+
+Resque::Worker.prepend ResqueWorkerCurrentTracking
+
+ActiveSupport.on_load(:active_job) do
+  ActiveJob::QueueAdapters::ResqueAdapter.prepend(Module.new do
+    def stopping?
+      super ||
+        !!Thread.current[:resque_worker]&.shutdown? ||
+        !!Thread.current[:resque_worker]&.paused?
+    end
+  end)
+end
