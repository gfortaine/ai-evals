@@ -0,0 +1,11 @@
+class JobCheckpoint < ApplicationRecord
+  class << self
+    def read(job_name)
+      where(job_name: job_name).pick(:cursor)
+    end
+
+    def write!(job_name, cursor)
+      upsert({ job_name: job_name, cursor: cursor }, unique_by: :job_name)
+    end
+  end
+end
