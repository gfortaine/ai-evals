+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "particular_details for assignment changes" do
+    event = events(:logo_assignment_jz)
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, event.particular_details)
+
+    event.action = "card_unassigned"
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, event.particular_details)
+
+    event.particulars = {}
+    assert_equal({ assignee_ids: [] }, event.particular_details)
+  end
+
+  test "particular_details for board changes" do
+    event = events(:logo_published)
+    event.action = "card_board_changed"
+    event.particulars = { "particulars" => { "old_board" => "Writebook", "new_board" => "Private board" } }
+
+    assert_equal({ old_board: "Writebook", new_board: "Private board" }, event.particular_details)
+  end
+
+  test "particular_details returns empty strings for missing board values" do
+    event = events(:logo_published)
+    event.action = "card_board_changed"
+    event.particulars = {}
+
+    assert_equal({ old_board: "", new_board: "" }, event.particular_details)
+
+    event.particulars = { "particulars" => { "old_board" => nil, "new_board" => "New Board" } }
+    assert_equal({ old_board: "", new_board: "New Board" }, event.particular_details)
+  end
+
+  test "particular_details for title changes" do
+    event = events(:logo_published)
+    event.action = "card_title_changed"
+    event.particulars = { "particulars" => { "old_title" => "Old Title", "new_title" => "New Title" } }
+
+    assert_equal({ old_title: "Old Title", new_title: "New Title" }, event.particular_details)
+  end
+
+  test "particular_details returns empty strings for missing title values" do
+    event = events(:logo_published)
+    event.action = "card_title_changed"
+    event.particulars = {}
+
+    assert_equal({ old_title: "", new_title: "" }, event.particular_details)
+
+    event.particulars = { "particulars" => { "old_title" => "Old Title", "new_title" => nil } }
+    assert_equal({ old_title: "Old Title", new_title: "" }, event.particular_details)
+  end
+
+  test "particular_details for triage events" do
+    event = events(:logo_published)
+    event.action = "card_triaged"
+    event.particulars = { "particulars" => { "column" => "In Progress" } }
+
+    assert_equal({ column: "In Progress" }, event.particular_details)
+  end
+
+  test "particular_details returns empty string for missing column value" do
+    event = events(:logo_published)
+    event.action = "card_triaged"
+    event.particulars = {}
+
+    assert_equal({ column: "" }, event.particular_details)
+  end
+
+  test "particular_details returns empty hash for other events" do
+    %w[
+      card_published
+      card_closed
+      card_reopened
+      card_postponed
+      card_auto_postponed
+      card_sent_back_to_triage
+      comment_created
+    ].each do |action|
+      event = events(:logo_published)
+      event.action = action
+      event.particulars = { "particulars" => { "unexpected" => "value" } }
+
+      assert_equal({}, event.particular_details, "Expected empty particulars for #{action}")
+    end
+  end
+end
