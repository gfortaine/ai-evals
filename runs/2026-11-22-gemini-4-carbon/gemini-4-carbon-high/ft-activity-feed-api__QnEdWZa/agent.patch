diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..473ff79
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,406 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  EXPECTED_KEYS = %w[
+    id
+    action
+    created_at
+    description
+    particulars
+    url
+    eventable_type
+    eventable
+    board
+    creator
+  ].freeze
+
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index via /:account_slug/activities.json returns accessible activities newest first" do
+    get "/#{accounts("37s").external_account_id}/activities.json"
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    expected_ids = users(:kevin).accessible_events.activity.reverse_chronologically.pluck(:id)
+    assert_equal expected_ids, @response.parsed_body.pluck("id")
+  end
+
+  test "index with Accept application/json header" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  test "index rejects HTML requests" do
+    get activities_path
+    assert_response :not_acceptable
+
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+  end
+
+  test "orders same-timestamp events newest first" do
+    card = nil
+    freeze_time do
+      with_current_user(:kevin) do
+        card = boards(:writebook).cards.create!(title: "Frozen card", status: "published", creator: users(:kevin))
+        card.triage_into(columns(:writebook_in_progress))
+        card.close
+      end
+    end
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    card_events = @response.parsed_body.select { |item| item.dig("eventable", "id") == card.id }
+    assert_equal %w[card_closed card_triaged card_published], card_events.pluck("action")
+  end
+
+  test "card event representation and URL" do
+    event = events(:layout_assignment_jz)
+
+    get card_path(event.eventable), as: :json
+    expected_card = @response.parsed_body.except("steps")
+
+    get board_path(event.board), as: :json
+    expected_board = @response.parsed_body
+
+    get user_path(event.creator), as: :json
+    expected_creator = @response.parsed_body
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert_not_nil activity
+    assert_equal EXPECTED_KEYS.sort, activity.keys.sort
+
+    assert_equal event.id, activity["id"]
+    assert_equal "card_assigned", activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity["particulars"])
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal expected_card, activity["eventable"]
+    assert_equal expected_board, activity["board"]
+    assert_equal expected_creator, activity["creator"]
+  end
+
+  test "comment event representation and URL with comment anchor" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get card_comment_path(comment.card, comment), as: :json
+    expected_comment = @response.parsed_body
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert_not_nil activity
+    assert_equal EXPECTED_KEYS.sort, activity.keys.sort
+
+    assert_equal event.id, activity["id"]
+    assert_equal "comment_created", activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal expected_comment, activity["eventable"]
+  end
+
+  test "plain-text description is personalized for the current user" do
+    event = events(:logo_assignment_km)
+
+    get activities_path(format: :json)
+    kevin_activity = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert_equal event.description_for(users(:kevin)).to_plain_text, kevin_activity["description"]
+    assert_includes kevin_activity["description"], "David will handle"
+
+    logout_and_sign_in_as :david
+    get activities_path(format: :json)
+    david_activity = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert_equal event.description_for(users(:david)).to_plain_text, david_activity["description"]
+    assert_includes david_activity["description"], "David assigned Kevin"
+  end
+
+  test "omits drafted cards and system comments" do
+    draft = nil
+    published_card = nil
+    with_current_user(:kevin) do
+      draft = boards(:writebook).cards.create!(title: "Draft only", status: "drafted", creator: users(:kevin))
+      published_card = boards(:writebook).cards.create!(title: "Published card", status: "published", creator: users(:kevin))
+      published_card.close
+    end
+
+    assert published_card.comments.any? { |comment| comment.creator.system? }
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    card_ids = @response.parsed_body.select { |i| i["eventable_type"] == "Card" }.map { |i| i.dig("eventable", "id") }
+    comment_card_ids = @response.parsed_body.select { |i| i["eventable_type"] == "Comment" }.map { |i| i.dig("eventable", "card", "id") }
+
+    assert_not_includes card_ids, draft.id
+    assert_not_includes comment_card_ids, published_card.id
+  end
+
+  test "includes card_title_changed events and omits card_collection_changed events" do
+    with_current_user(:kevin) do
+      cards(:logo).update!(title: "Brand new logo title")
+    end
+
+    title_event = Event.where(action: "card_title_changed").last
+    assert_not_nil title_event
+
+    collection_event = boards(:writebook).events.create!(
+      action: "card_collection_changed",
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      particulars: { "particulars" => { "new_collection" => "Legacy" } }
+    )
+
+    resumed_event = boards(:writebook).events.create!(
+      action: "card_resumed",
+      creator: users(:kevin),
+      eventable: cards(:logo)
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    returned_ids = @response.parsed_body.pluck("id")
+    assert_includes returned_ids, title_event.id
+    assert_not_includes returned_ids, collection_event.id
+    assert_not_includes returned_ids, resumed_event.id
+
+    title_activity = @response.parsed_body.find { |item| item["id"] == title_event.id }
+    assert_equal(
+      { "old_title" => "The logo isn't big enough", "new_title" => "Brand new logo title" },
+      title_activity["particulars"]
+    )
+  end
+
+  test "exposes particulars for all supported event types and empty strings for missing values" do
+    card = nil
+    with_current_user(:kevin) do
+      card = boards(:writebook).cards.create!(title: "Lifecycle card", status: "published", creator: users(:kevin))
+      card.comments.create!(body: "Looks good", creator: users(:kevin))
+      card.triage_into(columns(:writebook_in_progress))
+      card.send_back_to_triage
+      card.toggle_assignment(users(:jz))
+      card.toggle_assignment(users(:jz))
+      card.postpone
+      card.auto_postpone(user: accounts("37s").system_user)
+      card.close
+      card.reopen
+      card.move_to(boards(:private))
+    end
+
+    missing_board_event = boards(:private).events.create!(
+      action: "card_board_changed",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: {}
+    )
+    missing_title_event = boards(:private).events.create!(
+      action: "card_title_changed",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: {}
+    )
+    missing_column_event = boards(:private).events.create!(
+      action: "card_triaged",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: {}
+    )
+
+    all_items = fetch_all_pages(activities_path(format: :json))
+    by_id = all_items.index_by { |item| item["id"] }
+    actions = all_items.pluck("action")
+
+    Event::ACTIVITY_ACTIONS.each do |expected_action|
+      assert_includes actions, expected_action
+    end
+
+    triaged_item = all_items.find { |i| i["action"] == "card_triaged" && i["id"] != missing_column_event.id }
+    assert_equal({ "column" => columns(:writebook_in_progress).name }, triaged_item["particulars"])
+
+    board_changed_item = all_items.find { |i| i["action"] == "card_board_changed" && i["id"] != missing_board_event.id }
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, board_changed_item["particulars"])
+
+    unassigned_item = all_items.find { |i| i["action"] == "card_unassigned" }
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, unassigned_item["particulars"])
+
+    %w[card_published card_closed card_reopened card_postponed card_auto_postponed card_sent_back_to_triage comment_created].each do |action|
+      item = all_items.find { |i| i["action"] == action }
+      assert_equal({}, item["particulars"], "Expected empty particulars for #{action}")
+    end
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, by_id[missing_board_event.id]["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, by_id[missing_title_event.id]["particulars"])
+    assert_equal({ "column" => "" }, by_id[missing_column_event.id]["particulars"])
+  end
+
+  test "returns only activity the current user can access including after board move" do
+    private_card = nil
+    moved_card = nil
+    moved_comment = nil
+    with_current_user(:kevin) do
+      private_card = boards(:private).cards.create!(title: "Top secret card", status: "published", creator: users(:kevin))
+      moved_card = boards(:writebook).cards.create!(title: "Moving to private", status: "published", creator: users(:kevin))
+      moved_comment = moved_card.comments.create!(body: "Comment before move", creator: users(:kevin))
+      moved_card.move_to(boards(:private))
+    end
+    private_event = private_card.events.last
+    moved_comment_event = moved_comment.events.last
+
+    get activities_path(format: :json)
+    assert_includes @response.parsed_body.pluck("id"), private_event.id
+    assert_includes @response.parsed_body.pluck("id"), moved_comment_event.id
+
+    logout_and_sign_in_as :david
+    david_items = fetch_all_pages(activities_path(format: :json))
+    david_ids = david_items.pluck("id")
+    assert_not_includes david_ids, private_event.id
+    assert_not_includes david_ids, moved_comment_event.id
+  end
+
+  test "filters by creator_ids and board_ids" do
+    private_card = nil
+    jz_card = nil
+    with_current_user(:kevin) do
+      private_card = boards(:private).cards.create!(title: "Private work", status: "published", creator: users(:kevin))
+    end
+    with_current_user(:jz) do
+      jz_card = boards(:writebook).cards.create!(title: "JZ card", status: "published", creator: users(:jz))
+    end
+
+    # Filter by single creator_id
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ] }
+    assert_response :success
+    assert_not_empty @response.parsed_body
+    assert @response.parsed_body.all? { |item| item.dig("creator", "id") == users(:david).id }
+
+    # Filter by multiple creator_ids
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id, users(:jz).id ] }
+    assert_response :success
+    creator_set = @response.parsed_body.map { |item| item.dig("creator", "id") }.uniq
+    assert_includes creator_set, users(:david).id
+    assert_includes creator_set, users(:jz).id
+    assert_includes @response.parsed_body.pluck("id"), jz_card.events.last.id
+    assert(@response.parsed_body.all? { |item| [ users(:david).id, users(:jz).id ].include?(item.dig("creator", "id")) })
+
+    # Filter by board_ids
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [ private_card.events.last.id ], @response.parsed_body.pluck("id")
+
+    # Combine creator_ids and board_ids
+    get activities_path(format: :json), params: {
+      creator_ids: [ users(:david).id ],
+      board_ids: [ boards(:private).id ]
+    }
+    assert_response :success
+    assert_empty @response.parsed_body
+
+    # Nonexistent IDs return empty array
+    get activities_path(format: :json), params: { creator_ids: [ "nonexistent-user-id" ] }
+    assert_response :success
+    assert_empty @response.parsed_body
+
+    # Filtering by an inaccessible board returns empty array rather than leaking or falling back
+    logout_and_sign_in_as :david
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_empty @response.parsed_body
+
+    # Filtering by both accessible and inaccessible boards only returns accessible board events
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id, boards(:writebook).id ] }
+    assert_response :success
+    assert_not_empty @response.parsed_body
+    assert @response.parsed_body.all? { |item| item.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "authenticates with personal access token" do
+    Session.delete_all
+    token = identities(:kevin).access_tokens.create!(description: "Activity reader", permission: :read).token
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer #{token}" }
+    assert_response :success
+    assert_not_empty @response.parsed_body
+  end
+
+  test "forbids users without access to the account" do
+    logout_and_sign_in_as :mike
+
+    get activities_path(format: :json)
+    assert_response :forbidden
+  end
+
+  test "paginates newest activity first across pages while preserving filters" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    base_time = 1.hour.from_now
+
+    35.times do |index|
+      board.events.create!(
+        action: "card_closed",
+        creator: users(:kevin),
+        eventable: card,
+        created_at: base_time + index.seconds
+      )
+    end
+
+    expected_ids = users(:kevin)
+      .accessible_events
+      .activity
+      .where(creator_id: users(:kevin).id, board_id: board.id)
+      .reverse_chronologically
+      .pluck(:id)
+
+    actual_ids = []
+    next_page = activities_path(format: :json, creator_ids: [ users(:kevin).id ], board_ids: [ board.id ])
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+    assert_equal expected_ids.size.to_s, @response.headers["X-Total-Count"]
+  end
+
+  private
+    def fetch_all_pages(initial_path)
+      items = []
+      next_page = initial_path
+
+      while next_page
+        get next_page, as: :json
+        assert_response :success
+        items.concat(@response.parsed_body)
+        next_page = next_page_from_link_header(@response.headers["Link"])
+      end
+
+      items
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
