diff --git a/app/controllers/activities_controller.rb b/app/controllers/activities_controller.rb
new file mode 100644
index 0000000..3f99f68
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,29 @@
+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from filtered_events
+      end
+    end
+  end
+
+  private
+    def filtered_events
+      events = Current.user.accessible_events.activity.reverse_chronologically.preloaded_for_api
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events = events.where(board_id: board_ids) if board_ids.present?
+      events
+    end
+
+    def creator_ids
+      Array(activity_params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(activity_params[:board_ids]).compact_blank
+    end
+
+    def activity_params
+      @activity_params ||= params.permit(:creator_ids, :board_ids, creator_ids: [], board_ids: [])
+    end
+end
