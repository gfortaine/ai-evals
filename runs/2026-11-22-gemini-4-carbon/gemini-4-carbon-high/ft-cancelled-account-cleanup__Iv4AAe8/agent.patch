diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..e1b2ba0
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+require "fugit"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago and leaves others untouched" do
+    now = Time.current
+
+    due_account_1 = accounts("37s")
+    due_account_2 = Account.create_with_owner(
+      account: { name: "Second Due Account" },
+      owner: { name: "Owner", identity: identities(:david) }
+    )
+    boundary_account = accounts(:initech)
+    recent_account = accounts(:acme)
+    active_account = Account.create!(name: "Still Active")
+
+    due_board_id = due_account_1.boards.first.id
+    due_card_id = due_account_1.cards.first.id
+
+    travel_to(now - 31.days) do
+      due_account_1.cancel(initiated_by: users(:jason))
+    end
+
+    travel_to(now - 30.days - 1.second) do
+      due_account_2.cancel(initiated_by: due_account_2.users.find_by!(role: :owner))
+    end
+
+    travel_to(now - 30.days) do
+      boundary_account.cancel(initiated_by: users(:mike))
+    end
+
+    travel_to(now - 10.days) do
+      recent_account.cancel(initiated_by: recent_account.users.create!(name: "Acme Owner", role: :owner))
+    end
+
+    travel_to(now) do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(due_account_1.id)
+    assert_not Account.exists?(due_account_2.id)
+    assert_not Board.exists?(due_board_id)
+    assert_not Card.exists?(due_card_id)
+    assert_not Account::Cancellation.exists?(account_id: due_account_1.id)
+    assert_not Account::Cancellation.exists?(account_id: due_account_2.id)
+
+    assert Account.exists?(boundary_account.id)
+    assert Account.exists?(recent_account.id)
+    assert Account.exists?(active_account.id)
+  end
+
+  test "uses latest cancellation timestamp when an account was reactivated and cancelled again" do
+    now = Time.current
+    account = accounts("37s")
+    owner = users(:jason)
+
+    travel_to(now - 40.days) { account.cancel(initiated_by: owner) }
+    travel_to(now - 20.days) { account.reactivate }
+    travel_to(now - 10.days) { account.cancel(initiated_by: owner) }
+
+    travel_to(now) do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+
+    travel_to(now + 21.days) do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+  end
+
+  test "works when enqueued and performed asynchronously" do
+    account = accounts("37s")
+
+    travel_to 31.days.ago do
+      account.cancel(initiated_by: users(:jason))
+    end
+
+    perform_enqueued_jobs do
+      Account::IncinerateDueJob.perform_later
+    end
+
+    assert_not Account.exists?(account.id)
+  end
+
+  test "is configured as a recurring job" do
+    config = ActiveSupport::ConfigurationFile.parse(Rails.root.join("config/recurring.yml"))
+
+    %w[ production development ].each do |env|
+      task = config.fetch(env).values.find { |entry| entry["class"] == "Account::IncinerateDueJob" }
+      assert_not_nil task, "Expected Account::IncinerateDueJob in #{env} recurring tasks"
+      assert_not_nil Fugit.parse(task["schedule"]), "Expected valid schedule for Account::IncinerateDueJob in #{env}"
+    end
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..748ca6e
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,176 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:jason)
+  end
+
+  test "due_for_incineration includes only accounts cancelled more than 30 days ago" do
+    now = Time.current
+
+    due_account = accounts("37s")
+    exact_boundary_account = accounts(:initech)
+    recent_account = accounts(:acme)
+    active_account = Account.create!(name: "Active Corp")
+
+    travel_to(now - Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.second) do
+      due_account.cancel(initiated_by: users(:jason))
+    end
+
+    travel_to(now - Account::Incineratable::INCINERATION_GRACE_PERIOD) do
+      exact_boundary_account.cancel(initiated_by: users(:mike))
+    end
+
+    travel_to(now - 29.days) do
+      recent_account.cancel(initiated_by: recent_account.users.create!(name: "Owner", role: :owner))
+    end
+
+    travel_to(now) do
+      assert_includes Account.due_for_incineration, due_account
+      assert_not_includes Account.due_for_incineration, exact_boundary_account
+      assert_not_includes Account.due_for_incineration, recent_account
+      assert_not_includes Account.due_for_incineration, active_account
+    end
+  end
+
+  test "due_for_incineration excludes reactivated accounts" do
+    travel_to 31.days.ago do
+      @account.cancel(initiated_by: @user)
+    end
+
+    assert_includes Account.due_for_incineration, @account
+
+    @account.reactivate
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "incinerate permanently removes account and all associated data while preserving other accounts and identities" do
+    Current.user = @user
+    other_account = accounts(:initech)
+    other_user = users(:mike)
+    shared_identity = identities(:kevin)
+
+    Current.with_account(other_account) do
+      other_card = other_account.cards.first || other_account.boards.first.cards.create!(title: "Initech Card", status: "published", creator: other_user)
+      other_card.image.attach(io: StringIO.new("initech-image"), filename: "initech.png", content_type: "image/png")
+    end
+
+    board = boards(:writebook)
+    board.update!(public_description: "<p>Public description</p>")
+    board.publish
+    board.auto_postpone_period_in_days = 7
+
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("card-image-bytes"), filename: "card.png", content_type: "image/png")
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    card.update!(description: "<p>Description #{ActionText::Attachment.from_attachable(embed_blob).to_html}</p>")
+    card.create_activity_spike! unless card.activity_spike
+    card.steps.create!(content: "Check step")
+
+    postponed_card = board.cards.create!(title: "Postponed", status: "published", creator: @user)
+    postponed_card.postpone(user: @user)
+
+    ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("unattached-data"),
+      filename: "orphan.txt",
+      content_type: "text/plain"
+    )
+
+    @user.avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    @user.avatar_thumbnail.processed
+    @user.push_subscriptions.build(account: @account, endpoint: "https://fcm.googleapis.com/fcm/send/test", p256dh_key: "p256", auth_key: "auth").save!(validate: false)
+    @user.remember_search("logo")
+
+    Notification::Bundle.create!(account: @account, user: @user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+
+    import = Account::Import.create!(account: @account, identity: @user.identity, status: :completed, completed_at: 1.hour.ago)
+    import.file.attach(io: StringIO.new("import-zip"), filename: "import.zip", content_type: "application/zip")
+
+    export = @account.exports.first
+    export.file.attach(io: StringIO.new("export-zip"), filename: "export.zip", content_type: "application/zip")
+
+    @account.materialize_storage
+    board.materialize_storage
+
+    @account.cancel(initiated_by: @user)
+
+    account_id = @account.id
+    board_ids = @account.boards.pluck(:id)
+    filter_ids = Filter.where(account_id: account_id).pluck(:id)
+    blob_keys = ActiveStorage::Blob.where(account_id: account_id).pluck(:key)
+    search_record_ids = Search::Record.for(account_id).where(account_id: account_id).pluck(:id)
+
+    assert_not_empty blob_keys
+    assert_not_empty filter_ids
+    assert_not_empty search_record_ids
+
+    @account.incinerate
+
+    assert_not Account.exists?(account_id)
+
+    account_scoped_tables.each do |table|
+      count = count_for_account(table, account_id)
+      assert_equal 0, count, "Expected 0 rows in #{table} for incinerated account, found #{count}"
+    end
+
+    assert_equal 0, Storage::Total.where(owner_id: [ account_id ] + board_ids).count
+
+    if Search::Record.connection.adapter_name == "SQLite"
+      assert_equal 0, Search::Record::SQLite::Fts.where(rowid: search_record_ids).count
+    end
+
+    %w[ assignees_filters boards_filters closers_filters creators_filters filters_tags ].each do |join_table|
+      assert_equal 0, count_for_filter_join(join_table, filter_ids), "Expected 0 rows in #{join_table}"
+    end
+
+    blob_keys.each do |key|
+      assert_not ActiveStorage::Blob.service.exist?(key), "Expected blob #{key} to be deleted from storage"
+    end
+
+    assert Identity.exists?(shared_identity.id), "Global identity should not be deleted"
+    assert Account.exists?(other_account.id), "Other account should not be deleted"
+    assert_operator Card.where(account_id: other_account.id).count, :>, 0
+    assert_operator ActiveStorage::Blob.where(account_id: other_account.id).count, :>, 0
+  end
+
+  test "incinerate runs callbacks" do
+    callback_called = false
+    Account.set_callback(:incinerate, :after) { callback_called = true }
+
+    account = Account.create!(name: "Callback Test")
+    account.incinerate
+
+    assert callback_called
+  ensure
+    Account.reset_callbacks(:incinerate)
+  end
+
+  private
+    def account_scoped_tables
+      ActiveRecord::Base.connection.tables.select do |table|
+        next false if table.start_with?("search_records_fts") || table.in?(%w[ schema_migrations ar_internal_metadata ])
+        ActiveRecord::Base.connection.columns(table).any? { |column| column.name == "account_id" }
+      end
+    end
+
+    def count_for_account(table, account_id)
+      klass = Class.new(ApplicationRecord) do
+        self.table_name = table
+        self.inheritance_column = :_type_disabled
+      end
+      klass.where(account_id: account_id).count
+    end
+
+    def count_for_filter_join(join_table, filter_ids)
+      klass = Class.new(ApplicationRecord) do
+        self.table_name = join_table
+      end
+      klass.where(filter_id: filter_ids).count
+    end
+end
