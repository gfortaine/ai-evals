+class Storage::Total < ApplicationRecord
+  belongs_to :account
+  belongs_to :owner, polymorphic: true
+
+  class << self
+    def bytes_used_for(owner)
+      if owner.persisted?
+        where(owner_type: owner.class.base_class.name, owner_id: owner.id).pick(:bytes_used) || 0
+      else
+        0
+      end
+    end
+
+    def find_or_create_for(owner)
+      owner_type = owner.class.base_class.name
+      find_by(owner_type: owner_type, owner_id: owner.id) ||
+        create_with(account_id: owner.account.id).create_or_find_by!(owner_type: owner_type, owner_id: owner.id)
+    end
+  end
+end
