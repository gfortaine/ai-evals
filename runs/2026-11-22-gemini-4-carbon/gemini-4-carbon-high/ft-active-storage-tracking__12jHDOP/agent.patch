+require "test_helper"
+
+class Account::StorageTrackedTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @other_account = accounts(:initech)
+    @board_1 = boards(:writebook)
+    @board_2 = boards(:private)
+    @user = users(:david)
