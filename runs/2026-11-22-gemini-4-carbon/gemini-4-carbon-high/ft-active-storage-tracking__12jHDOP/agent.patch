+class Storage::Entry < ApplicationRecord
+  belongs_to :account
+  belongs_to :board, optional: true
+  belongs_to :blob, class_name: "ActiveStorage::Blob", optional: true
+  belongs_to :record, polymorphic: true, optional: true
+
+  after_create :enqueue_materialization
+
+  class << self
+    def record(account_id:, board_id:, delta:, operation:, blob_id: nil, record_type: nil, record_id: nil)
+      if delta != 0 && account_id.present? && board_id.present? && !Storage.suppressed?(account_id: account_id, board_id: board_id)
+        create!(
+          account_id: account_id,
+          board_id: board_id,
+          blob_id: blob_id,
+          record_type: record_type,
+          record_id: record_id,
+          operation: operation,
+          delta: delta
+        )
+      end
+    end
+  end
+
+  private
+    def enqueue_materialization
+      Storage.enqueue_materialization(account_id)
+    end
+end
