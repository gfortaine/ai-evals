+    assert_equal 0, @other_account.bytes_used
+  end
+
+  test "sums usage across all boards in the account and isolates tenants" do
+    blob_1 = create_text_blob("1" * 150, filename: "b1.txt")
+    blob_2 = create_text_blob("2" * 250, filename: "b2.txt")
+    other_blob = Current.with_account(@other_account) do
+      create_text_blob("3" * 900, filename: "other.txt")
+    end
+
+    perform_enqueued_jobs do
+      cards(:logo).image.attach(blob_1)
+      @board_2.update!(public_description: ActionText::Content.new("<p>Private</p>").append_attachables(blob_2))
+      cards(:radio).image.attach(other_blob)
+    end
+
+    assert_equal 150, @board_1.bytes_used
+    assert_equal 250, @board_2.bytes_used
+    assert_equal 400, @account.bytes_used
+    assert_equal 900, boards(:miltons_wish_list).bytes_used
+    assert_equal 900, @other_account.bytes_used
+  end
+
+  test "ignores non-counted attachments like avatars, exports, imports, unattached blobs, mentions, and remote media" do
+    create_text_blob("U" * 500, filename: "unattached.txt")
+
+    @user.avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+
+    account_export = Account::Export.create!(account: @account, user: @user)
+    account_export.file.attach(io: StringIO.new("E" * 400), filename: "export.zip", content_type: "application/zip")
+
+    user_export = User::DataExport.create!(account: @account, user: @user)
+    user_export.file.attach(io: StringIO.new("D" * 300), filename: "user_export.zip", content_type: "application/zip")
+
+    import = Account::Import.create!(account: @account, identity: identities(:david))
+    import.file.attach(io: StringIO.new("I" * 600), filename: "import.zip", content_type: "application/zip")
+
+    cards(:logo).update!(description: <<~HTML + ActionText::Content.new("").append_attachables(@user).to_html)
+      <p>Remote video:</p>
+      <action-text-attachment url="https://example.com/video.mp4" content-type="video/mp4" filename="video.mp4"></action-text-attachment>
+    HTML
+
+    perform_enqueued_jobs
+
+    assert_equal 0, @board_1.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "destroying a board updates account bytes_used in the background without N+1 entry inserts" do
+    blob_1 = create_text_blob("A" * 300, filename: "a.txt")
+    blob_2 = create_text_blob("B" * 500, filename: "b.txt")
+
+    perform_enqueued_jobs do
+      cards(:logo).image.attach(blob_1)
+      @board_2.update!(public_description: ActionText::Content.new("<p>B2</p>").append_attachables(blob_2))
+    end
+    assert_equal 800, @account.bytes_used
+
+    assert_no_difference -> { Storage::Entry.count } do
+      @board_1.destroy!
+    end
+    assert_equal 800, @account.bytes_used
+
+    perform_enqueued_jobs
+
+    assert_equal 0, @board_1.bytes_used
+    assert_equal 500, @account.bytes_used
+  end
+
+  test "destroying a board with unmaterialized entries cleans up accurately" do
+    blob_1 = create_text_blob("A" * 300, filename: "a.txt")
+    blob_2 = create_text_blob("B" * 500, filename: "b.txt")
+
+    cards(:logo).image.attach(blob_1)
+    @board_2.update!(public_description: ActionText::Content.new("<p>B2</p>").append_attachables(blob_2))
+    @board_1.destroy!
+
+    perform_enqueued_jobs
+
+    assert_equal 500, @board_2.bytes_used
+    assert_equal 500, @account.bytes_used
+    assert_empty Storage::Entry.where(account_id: @account.id)
+  end
+
+  test "rolled back transactions do not change bytes_used or enqueue jobs" do
+    blob = create_text_blob("R" * 250, filename: "rollback.txt")
+
+    assert_no_enqueued_jobs only: Storage::MaterializeJob do
+      ApplicationRecord.transaction do
+        cards(:logo).image.attach(blob)
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_equal 0, @board_1.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "reconcile_storage recomputes exact board and account totals from live attachments" do
+    blob_1 = create_text_blob("1" * 125, filename: "1.txt")
+    blob_2 = create_text_blob("2" * 275, filename: "2.txt")
+
+    perform_enqueued_jobs do
+      cards(:logo).image.attach(blob_1)
+      @board_2.update!(public_description: ActionText::Content.new("<p>Desc</p>").append_attachables(blob_2))
+    end
+
+    Storage::Total.where(account_id: @account.id).delete_all
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board_1.bytes_used
+
+    @account.reconcile_storage
+
+    assert_equal 125, @board_1.bytes_used
+    assert_equal 275, @board_2.bytes_used
+    assert_equal 400, @account.bytes_used
+  end
+
+  private
+    def create_text_blob(content, filename: "file.txt")
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(content),
+        filename: filename,
+        content_type: "text/plain"
+      )
+    end
+end
