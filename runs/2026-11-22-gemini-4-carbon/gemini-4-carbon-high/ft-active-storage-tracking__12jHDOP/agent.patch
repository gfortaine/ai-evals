new file mode 100644
index 0000000..db2fba8
--- /dev/null
+++ b/test/integration/storage_tracking_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class StorageTrackingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    clear_enqueued_jobs
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+  end
+
+  test "tracks storage end-to-end across HTTP uploads, edits, moves, and deletions" do
+    moon_size = file_fixture("moon.jpg").size
+
+    # Upload card image via HTTP PATCH
+    patch card_path(@card), as: :turbo_stream, params: {
+      card: { image: fixture_file_upload("moon.jpg", "image/jpeg") }
+    }
+    assert_response :success
+    perform_enqueued_jobs
+
+    assert_equal moon_size, @board.bytes_used
+    assert_equal moon_size, @account.bytes_used
+
+    # Embed file in board description via HTTP PATCH
+    board_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("B" * 320),
+      filename: "board.txt",
+      content_type: "text/plain"
+    )
+    patch board_path(@board), params: {
+      board: {
+        name: @board.name,
+        public_description: %(<p>Welcome</p><action-text-attachment sgid="#{board_blob.attachable_sgid}"></action-text-attachment>)
+      }
+    }
+    assert_response :redirect
+    perform_enqueued_jobs
+
+    assert_equal moon_size + 320, @board.bytes_used
+    assert_equal moon_size + 320, @account.bytes_used
+
+    # Create comment with embedded file via HTTP POST
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("C" * 180),
+      filename: "comment.txt",
+      content_type: "text/plain"
+    )
+    post card_comments_path(@card), as: :turbo_stream, params: {
+      comment: {
+        body: %(<p>Attached</p><action-text-attachment sgid="#{comment_blob.attachable_sgid}"></action-text-attachment>)
+      }
+    }
+    assert_response :success
+    perform_enqueued_jobs
+
+    assert_equal moon_size + 500, @board.bytes_used
+    assert_equal moon_size + 500, @account.bytes_used
+
+    # Upload user avatar via HTTP PATCH (must NOT count)
+    patch user_path(users(:kevin)), params: {
+      user: { avatar: fixture_file_upload("avatar.png", "image/png") }
+    }
+    perform_enqueued_jobs
+
+    assert_equal moon_size + 500, @board.bytes_used
+    assert_equal moon_size + 500, @account.bytes_used
+
+    # Move card to private board via HTTP PATCH
+    patch card_board_path(@card), params: { board_id: @other_board.id }
+    assert_response :redirect
+    perform_enqueued_jobs
+
+    assert_equal 320, @board.bytes_used
+    assert_equal moon_size + 180, @other_board.bytes_used
+    assert_equal moon_size + 500, @account.bytes_used
+
+    # Delete card image via HTTP DELETE
+    delete card_image_path(@card)
+    assert_response :redirect
+    perform_enqueued_jobs
+
+    assert_equal 320, @board.bytes_used
+    assert_equal 180, @other_board.bytes_used
+    assert_equal 500, @account.bytes_used
+
+    # Delete private board via HTTP DELETE
+    delete board_path(@other_board)
+    assert_response :redirect
+    perform_enqueued_jobs
+
+    assert_equal 320, @board.bytes_used
+    assert_equal 320, @account.bytes_used
+  end
+end
diff --git a/test/jobs/storage/materialize_job_test.rb b/test/jobs/storage/materialize_job_test.rb
new file mode 100644
index 0000000..d0492f3
--- /dev/null
+++ b/test/jobs/storage/materialize_job_test.rb
@@ -0,0 +1,120 @@
+require "test_helper"
+
+class Storage::MaterializeJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @user = users(:david)
+    Current.session = sessions(:david)
+  end
+
+  test "coalesces multiple attachment changes within a single transaction into one job" do
+    blob_1 = create_text_blob("1" * 100, filename: "1.txt")
+    blob_2 = create_text_blob("2" * 200, filename: "2.txt")
+    blob_3 = create_text_blob("3" * 300, filename: "3.txt")
+
+    assert_enqueued_jobs 1, only: Storage::MaterializeJob do
+      ApplicationRecord.transaction do
+        cards(:logo).update!(
+          image: blob_1,
+          description: ActionText::Content.new("<p>Desc</p>").append_attachables(blob_2)
+        )
+        GC.start
+        cards(:logo).comments.create!(
+          creator: @user,
+          body: ActionText::Content.new("<p>Comment</p>").append_attachables(blob_3)
+        )
+      end
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal 600, @board.bytes_used
+    assert_equal 600, @account.bytes_used
+  end
+
+  test "debounces queued jobs across concurrent requests via cache and re-enqueues after job starts" do
+    original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+
+    blob_1 = create_text_blob("1" * 100, filename: "1.txt")
+    blob_2 = create_text_blob("2" * 200, filename: "2.txt")
+    blob_3 = create_text_blob("3" * 300, filename: "3.txt")
+
+    assert_enqueued_jobs 1, only: Storage::MaterializeJob do
+      cards(:logo).image.attach(blob_1)
+      cards(:shipping).image.attach(blob_2)
+    end
+
+    perform_enqueued_jobs
+    assert_equal 300, @account.bytes_used
+
+    assert_enqueued_jobs 1, only: Storage::MaterializeJob do
+      cards(:layout).image.attach(blob_3)
+    end
+
+    perform_enqueued_jobs
+    assert_equal 600, @account.bytes_used
+  ensure
+    Rails.cache = original_cache
+  end
+
+  test "drains entries across multiple batches when entry count exceeds batch size" do
+    total_entries = 15
+    rows = total_entries.times.map do |i|
+      {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: @account.id,
+        board_id: @board.id,
+        operation: "attach",
+        delta: 10,
+        created_at: Time.current
+      }
+    end
+    Storage::Entry.insert_all!(rows)
+
+    original_batch_size = Account::StorageTracked::MATERIALIZE_BATCH_SIZE
+    Account::StorageTracked.send(:remove_const, :MATERIALIZE_BATCH_SIZE)
+    Account::StorageTracked.const_set(:MATERIALIZE_BATCH_SIZE, 4)
+
+    Storage::MaterializeJob.perform_now(@account)
+
+    assert_equal 150, @board.bytes_used
+    assert_equal 150, @account.bytes_used
+    assert_empty Storage::Entry.where(account_id: @account.id)
+  ensure
+    Account::StorageTracked.send(:remove_const, :MATERIALIZE_BATCH_SIZE)
+    Account::StorageTracked.const_set(:MATERIALIZE_BATCH_SIZE, original_batch_size)
+  end
+
+  test "materialize_pending_later sweeps accounts with pending entries" do
+    Storage::Entry.insert_all!([
+      {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: @account.id,
+        board_id: @board.id,
+        operation: "attach",
+        delta: 420,
+        created_at: Time.current
+      }
+    ])
+
+    assert_enqueued_jobs 1, only: Storage::MaterializeJob do
+      Storage.materialize_pending_later
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal 420, @board.bytes_used
+    assert_equal 420, @account.bytes_used
+  end
+
+  private
+    def create_text_blob(content, filename: "file.txt")
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(content),
+        filename: filename,
+        content_type: "text/plain"
+      )
+    end
+end
