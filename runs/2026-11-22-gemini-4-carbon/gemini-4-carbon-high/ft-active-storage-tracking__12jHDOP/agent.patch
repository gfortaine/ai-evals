diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
index f85a27a..f0c3806 100644
--- a/config/initializers/active_storage.rb
+++ b/config/initializers/active_storage.rb
@@ -56,3 +56,56 @@ Rails.application.config.to_prepare do
   ActiveStorage::BaseController.include ActiveStorageControllerExtensions
   ActiveStorage::DirectUploadsController.include ActiveStorageDirectUploadsControllerExtensions
 end
+
+module ActiveStorageAttachmentStorageTracking
+  extend ActiveSupport::Concern
+
+  prepended do
+    after_create { Storage::Attachment.new(self).record_addition }
+    after_destroy :record_storage_removal_once
+    after_rollback { @_storage_removal_recorded = false }
+  end
+
+  def delete
+    if persisted? && !destroyed?
+      callback = Storage::Attachment.new(self).prepare_deletion unless @_storage_removal_recorded
+
+      ApplicationRecord.transaction do
+        super.tap do
+          if callback && !@_storage_removal_recorded
+            callback.call
+            @_storage_removal_recorded = true
+          end
+        end
+      end
+    else
+      super
+    end
+  end
+
+  def record_storage_removal_once
+    unless @_storage_removal_recorded
+      Storage::Attachment.new(self).record_removal
+      @_storage_removal_recorded = true
+    end
+  end
+end
+
+module ActiveStorageDetachManyStorageTracking
+  def detach
+    if attachments.any? && record.is_a?(ActionText::RichText)
+      attachment_records = attachments.to_a
+      ApplicationRecord.transaction do
+        attachment_records.each(&:record_storage_removal_once)
+        super
+      end
+    else
+      super
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  prepend ActiveStorageAttachmentStorageTracking
+  ActiveStorage::Attached::Changes::DetachMany.prepend ActiveStorageDetachManyStorageTracking
+end
