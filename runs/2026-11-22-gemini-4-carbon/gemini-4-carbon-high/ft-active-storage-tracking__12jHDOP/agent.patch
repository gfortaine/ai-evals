+module Board::StorageTracked
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :storage_total, as: :owner, class_name: "Storage::Total"
+
+    around_destroy :cleanup_board_storage
+  end
+
+  def bytes_used
+    Storage::Total.bytes_used_for(self)
+  end
+
+  def calculate_storage_bytes
+    board_description_storage_bytes +
+      card_images_storage_bytes +
+      card_descriptions_storage_bytes +
+      comments_storage_bytes
+  end
+
+  private
+    def cleanup_board_storage
+      if Storage.suppressed?(account_id: account_id)
+        yield
+      else
+        had_storage = Storage::Total.exists?(owner_type: "Board", owner_id: id) || Storage::Entry.exists?(board_id: id)
+        Storage.suppressing_board(id) do
+          yield
+        end
+        Storage::Entry.where(board_id: id).delete_all
+        Storage.enqueue_materialization(account_id) if had_storage
+      end
+    end
+
+    def board_description_storage_bytes
+      ActiveStorage::Attachment
+        .where(account_id: account_id, record_type: "ActionText::RichText", name: "embeds")
+        .where(record_id: ActionText::RichText.where(record_type: "Board", record_id: id, name: "public_description").select(:id))
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_images_storage_bytes
+      ActiveStorage::Attachment
+        .where(account_id: account_id, record_type: "Card", name: "image")
+        .where(record_id: cards.select(:id))
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_descriptions_storage_bytes
+      ActiveStorage::Attachment
+        .where(account_id: account_id, record_type: "ActionText::RichText", name: "embeds")
+        .where(record_id: ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id), name: "description").select(:id))
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def comments_storage_bytes
+      ActiveStorage::Attachment
+        .where(account_id: account_id, record_type: "ActionText::RichText", name: "embeds")
+        .where(record_id: ActionText::RichText.where(record_type: "Comment", record_id: Comment.where(card_id: cards.select(:id)).select(:id), name: "body").select(:id))
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+end
