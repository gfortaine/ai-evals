+require "test_helper"
+
+class Board::StorageTrackedTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @user = users(:david)
+    Current.session = sessions(:david)
+  end
+
+  test "bytes_used starts at 0 for new and existing boards without attachments" do
+    assert_equal 0, Board.new.bytes_used
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "counts card images in the background" do
+    card = cards(:logo)
+    blob = create_text_blob("card image content", filename: "hero.txt")
+
+    card.image.attach(blob)
+    assert_equal 0, @board.bytes_used
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+  end
+
+  test "updates bytes_used when card image is replaced or removed" do
+    card = cards(:logo)
+    blob1 = create_text_blob("A" * 120, filename: "one.txt")
+    blob2 = create_text_blob("B" * 350, filename: "two.txt")
+
+    perform_enqueued_jobs { card.image.attach(blob1) }
+    assert_equal 120, @board.bytes_used
+
+    perform_enqueued_jobs { card.image.attach(blob2) }
+    assert_equal 350, @board.bytes_used
+
+    perform_enqueued_jobs { card.image.purge_later }
+    assert_equal 0, @board.bytes_used
+
+    perform_enqueued_jobs { card.image.attach(blob1) }
+    assert_equal 120, @board.bytes_used
+
+    perform_enqueued_jobs { card.image.purge }
+    assert_equal 0, @board.bytes_used
+
+    perform_enqueued_jobs { card.image.attach(blob2) }
+    assert_equal 350, @board.bytes_used
+
+    perform_enqueued_jobs { card.image.detach }
+    assert_equal 0, @board.bytes_used
+
+    perform_enqueued_jobs { card.image.attach(blob1) }
+    assert_equal 120, @board.bytes_used
+
+    perform_enqueued_jobs { card.update!(image: nil) }
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "counts files embedded in board descriptions and excludes variants" do
+    image_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    file_blob = create_text_blob("D" * 200, filename: "spec.txt")
+
+    @board.update!(
+      public_description: ActionText::Content.new("<p>Docs</p>")
+        .append_attachables(image_blob)
+        .append_attachables(file_blob)
+    )
+    perform_enqueued_jobs
+
+    assert @board.public_description.embeds.first.variant(:small).processed?
+    assert_equal image_blob.byte_size + 200, @board.bytes_used
+
+    perform_enqueued_jobs do
+      @board.update!(public_description: ActionText::Content.new("<p>Docs</p>").append_attachables(file_blob))
+    end
+    assert_equal 200, @board.bytes_used
+
+    perform_enqueued_jobs do
+      @board.update!(public_description: "")
+    end
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "counts files embedded in card descriptions on both draft and published cards" do
+    draft_card = @board.cards.create!(creator: @user, status: :drafted)
+    published_card = cards(:logo)
+    blob1 = create_text_blob("1" * 150, filename: "draft.txt")
+    blob2 = create_text_blob("2" * 250, filename: "pub.txt")
+
+    perform_enqueued_jobs do
+      draft_card.update!(description: ActionText::Content.new("").append_attachables(blob1))
+      published_card.update!(description: ActionText::Content.new("<p>Body</p>").append_attachables(blob2))
+    end
+
+    assert_equal 400, @board.bytes_used
+
+    perform_enqueued_jobs { draft_card.update!(description: nil) }
+    assert_equal 250, @board.bytes_used
+
+    perform_enqueued_jobs { published_card.description.embeds.detach }
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "counts files embedded in comments and subtracts when edited or destroyed" do
+    card = cards(:logo)
+    blob1 = create_text_blob("C" * 180, filename: "c1.txt")
+    blob2 = create_text_blob("E" * 220, filename: "c2.txt")
+
+    comment = nil
+    perform_enqueued_jobs do
+      comment = card.comments.create!(
+        creator: @user,
+        body: ActionText::Content.new("<p>See attached</p>")
+          .append_attachables(blob1)
+          .append_attachables(blob2)
+      )
+    end
+    assert_equal 400, @board.bytes_used
+
+    perform_enqueued_jobs do
+      comment.update!(body: ActionText::Content.new("<p>Updated</p>").append_attachables(blob1))
+    end
+    assert_equal 180, @board.bytes_used
+
+    perform_enqueued_jobs { comment.destroy! }
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "transfers card image, description embeds, and comment embeds when card moves to another board" do
+    card = cards(:logo)
+    img_blob = create_text_blob("I" * 100, filename: "img.txt")
+    desc_blob = create_text_blob("D" * 200, filename: "desc.txt")
+    comment_blob = create_text_blob("M" * 300, filename: "comment.txt")
+    board_blob = create_text_blob("B" * 50, filename: "board.txt")
+
+    perform_enqueued_jobs do
+      @board.update!(public_description: ActionText::Content.new("<p>Board</p>").append_attachables(board_blob))
+      card.update!(image: img_blob, description: ActionText::Content.new("<p>Card</p>").append_attachables(desc_blob))
+      card.comments.create!(creator: @user, body: ActionText::Content.new("<p>Comment</p>").append_attachables(comment_blob))
+    end
+
+    assert_equal 650, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 650, @account.bytes_used
+
+    perform_enqueued_jobs { card.move_to(@other_board) }
+
+    assert_equal 50, @board.bytes_used
+    assert_equal 600, @other_board.bytes_used
+    assert_equal 650, @account.bytes_used
+  end
+
+  test "simultaneously moving card and changing attachments updates both boards accurately" do
+    card = cards(:logo)
+    old_blob = create_text_blob("O" * 100, filename: "old.txt")
+    new_blob = create_text_blob("N" * 275, filename: "new.txt")
+
+    perform_enqueued_jobs { card.update!(image: old_blob) }
+    assert_equal 100, @board.bytes_used
+
+    perform_enqueued_jobs { card.update!(board: @other_board, image: new_blob) }
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 275, @other_board.bytes_used
+    assert_equal 275, @account.bytes_used
+  end
+
+  test "moving card across multiple boards before jobs run settles accurately" do
+    third_board = @account.boards.create!(name: "Third Board", creator: @user)
+    card = cards(:logo)
+    blob = create_text_blob("X" * 450, filename: "x.txt")
+
+    card.image.attach(blob)
+    card.move_to(@other_board)
+    card.move_to(third_board)
+
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 450, third_board.bytes_used
+    assert_equal 450, @account.bytes_used
+  end
+
+  test "destroying a card subtracts its image, description, and comments from board and account" do
+    card = cards(:logo)
+    img_blob = create_text_blob("I" * 110, filename: "img.txt")
+    desc_blob = create_text_blob("D" * 220, filename: "desc.txt")
+    comment_blob = create_text_blob("C" * 330, filename: "comment.txt")
+
+    perform_enqueued_jobs do
+      card.update!(image: img_blob, description: ActionText::Content.new("<p>Desc</p>").append_attachables(desc_blob))
+      card.comments.create!(creator: @user, body: ActionText::Content.new("<p>Comment</p>").append_attachables(comment_blob))
+    end
+    assert_equal 660, @board.bytes_used
+    assert_equal 660, @account.bytes_used
+
+    perform_enqueued_jobs { card.destroy! }
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  private
+    def create_text_blob(content, filename: "file.txt")
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(content),
+        filename: filename,
+        content_type: "text/plain"
+      )
+    end
+end
