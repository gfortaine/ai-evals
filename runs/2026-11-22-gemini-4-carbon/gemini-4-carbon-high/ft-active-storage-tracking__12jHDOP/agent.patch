+class Storage::MaterializeJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  limits_concurrency to: 1, key: ->(account) { account }, duration: 5.minutes
+
+  def perform(account)
+    Storage.clear_materialization_debounce(account.id)
+    account.materialize_storage
+  end
+end
