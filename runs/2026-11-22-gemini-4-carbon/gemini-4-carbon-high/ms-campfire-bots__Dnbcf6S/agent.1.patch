@@ -0,0 +1,225 @@
+require "test_helper"
+require "capybara/rails"
+require "capybara/minitest"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  test "unauthenticated users are redirected to sign in" do
+    get bots_url
+    assert_redirected_to new_session_url
+
+    get new_bot_url
+    assert_redirected_to new_session_url
+  end
+
+  test "account edit page shows Set up chat bots link to both members and admins and hides bots from human member list" do
+    bot = User.bots.create!(name: "Hidden From People List Bot", creator: users(:kevin))
+
+    sign_in :kevin
+    get edit_account_url
+    assert_response :success
+    assert_select "a[href='#{bots_path}']", text: /Set up chat bots/
+    assert_select "turbo-frame#account_users", text: /#{bot.name}/, count: 0
+
+    sign_in :david
+    get edit_account_url
+    assert_response :success
+    assert_select "a[href='#{bots_path}']", text: /Set up chat bots/
+    assert_select "turbo-frame#account_users", text: /#{bot.name}/, count: 0
+  end
+
+  test "members see only their own bots without pagination while admins see all bots" do
+    30.times { |i| User.bots.create!(name: "Kevin Bot #{i}", creator: users(:kevin)) }
+    jz_bot = User.bots.create!(name: "JZ Bot", creator: users(:jz))
+
+    sign_in :kevin
+    get bots_url
+    assert_response :success
+    assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+    assert_select "menu li", count: 30
+    assert_select "li", text: /JZ Bot/, count: 0
+
+    first_bot = users(:kevin).bots.ordered.first
+    assert_select "li", text: /#{first_bot.name}/ do
+      assert_select "label", text: /Bot code/
+      assert_select "input[readonly][aria-label='Bot code'][value='#{first_bot.bot_key}']"
+      assert_select "a[href='#{edit_bot_path(first_bot)}']", text: /Edit #{first_bot.name}/
+    end
+
+    sign_in :david
+    get bots_url
+    assert_response :success
+    assert_select "menu li", count: 31
+    assert_select "li", text: /JZ Bot/
+  end
+
+  test "member can create edit and delete their own bot" do
+    sign_in :kevin
+
+    get new_bot_url
+    assert_response :success
+    assert_select "label", text: /Name the bot/
+    assert_select "input[placeholder='Name the bot'][required]"
+    assert_select "button[type='submit']", text: /Save changes/
+
+    assert_difference -> { User.active_bots.count }, +1 do
+      post bots_url, params: { bot: { name: "Deploy Bot", avatar: fixture_file_upload("moon.jpg", "image/jpeg") } }
+    end
+    assert_redirected_to bots_url
+
+    bot = User.active_bots.last
+    assert_equal "Deploy Bot", bot.name
+    assert_equal users(:kevin), bot.creator
+    assert bot.avatar.attached?
+
+    get user_avatar_url(bot.avatar_token)
+    assert_response :success
+    assert_equal "image/webp", response.content_type
+
+    get edit_bot_url(bot)
+    assert_response :success
+    assert_select "button[data-turbo-confirm]", text: /Delete this chat bot/
+
+    patch bot_url(bot), params: { bot: { name: "Renamed Bot", avatar: "" } }
+    assert_redirected_to bots_url
+    assert_equal "Renamed Bot", bot.reload.name
+    assert bot.avatar.attached?, "Updating name without new avatar should preserve existing avatar"
+
+    assert_difference -> { User.active_bots.count }, -1 do
+      delete bot_url(bot)
+    end
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+  end
+
+  test "blank bot name renders 422 on create and update" do
+    sign_in :kevin
+
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: "" } }
+      assert_response :unprocessable_content
+    end
+
+    bot = User.bots.create!(name: "Deploy Bot", creator: users(:kevin))
+    patch bot_url(bot), params: { bot: { name: "   " } }
+    assert_response :unprocessable_content
+    assert_equal "Deploy Bot", bot.reload.name
+  end
+
+  test "member cannot edit update or delete another member's bot" do
+    jz_bot = User.bots.create!(name: "JZ Bot", creator: users(:jz))
+    sign_in :kevin
+
+    get edit_bot_url(jz_bot)
+    assert_response :forbidden
+
+    patch bot_url(jz_bot), params: { bot: { name: "Hacked" } }
+    assert_response :forbidden
+
+    delete bot_url(jz_bot)
+    assert_response :forbidden
+    assert jz_bot.reload.active?
+  end
+
+  test "admin can edit update and delete another member's bot" do
+    kevin_bot = User.bots.create!(name: "Kevin Bot", creator: users(:kevin))
+    sign_in :david
+
+    get edit_bot_url(kevin_bot)
+    assert_response :success
+
+    patch bot_url(kevin_bot), params: { bot: { name: "Admin Updated" } }
+    assert_redirected_to bots_url
+    assert_equal "Admin Updated", kevin_bot.reload.name
+
+    delete bot_url(kevin_bot)
+    assert_redirected_to bots_url
+    assert kevin_bot.reload.deactivated?
+  end
+
+  test "bots cannot be accessed via human user admin or login endpoints" do
+    bot = User.bots.create!(name: "Deploy Bot", creator: users(:kevin))
+
+    post session_url, params: { email_address: "", password: "" }
+    assert_response :unauthorized
+
+    get session_transfer_url(bot.transfer_id)
+    put session_transfer_url(bot.transfer_id)
+    assert_response :bad_request
+
+    sign_in :david
+    assert_raises(ActiveRecord::RecordNotFound) { put account_user_url(bot), params: { user: { role: "administrator" } } }
+
+    get edit_bot_url(users(:kevin))
+    assert_response :not_found
+  end
+
+  test "bots can be added to closed and direct rooms the same way as people" do
+    bot = User.bots.create!(name: "Deploy Bot", creator: users(:kevin))
+    sign_in :david
+
+    closed_room = rooms(:designers)
+    get edit_rooms_closed_url(closed_room)
+    assert_response :success
+    assert_select "label.switch", text: /Give Deploy Bot access to this room/
+
+    put rooms_closed_url(closed_room), params: {
+      room: { name: closed_room.name },
+      user_ids: closed_room.user_ids + [ bot.id ]
+    }
+    assert closed_room.reload.users.include?(bot)
+
+    post rooms_directs_url, params: { user_ids: [ bot.id ] }
+    direct_room = Rooms::Direct.last
+    assert direct_room.users.include?(bot)
+  end
+end
+
+class BotsBrowserFlowTest < ActionDispatch::IntegrationTest
+  include Capybara::DSL
+  include Capybara::Minitest::Assertions
+
+  teardown do
+    Capybara.reset_sessions!
+  end
+
+  test "full UI flow using exact labels from account settings to bot creation editing and deletion" do
+    visit new_session_path
+    fill_in "email_address", with: users(:kevin).email_address
+    fill_in "password", with: "secret123456"
+    click_on "log_in"
+
+    visit "/account/edit"
+    click_on "Set up chat bots"
+    assert_current_path "/bots"
+
+    click_on "Add a chat bot"
+    assert_current_path "/bots/new"
+
+    fill_in "Name the bot", with: "Deploy Bot"
+    click_on "Save changes"
+    assert_current_path "/bots"
+
+    bot_code = nil
+    within("li", text: "Deploy Bot") do
+      field = find_field("Bot code", readonly: true)
+      bot_code = field.value
+      assert bot_code.present?
+      click_link "Edit Deploy Bot"
+    end
+
+    fill_in "Name the bot", with: "Release Bot"
+    click_on "Save changes"
+    assert_current_path "/bots"
+
+    within("li", text: "Release Bot") do
+      assert_equal bot_code, find_field("Bot code", readonly: true).value
+      click_link "Edit Release Bot"
+    end
+
+    delete_btn = find_button("Delete this chat bot")
+    assert delete_btn["data-turbo-confirm"].present?
+    click_button "Delete this chat bot"
+    assert_current_path "/bots"
+    assert_no_text "Release Bot"
+  end
+end
diff --git a/test/controllers/messages/by_bots_controller_test.rb b/test/controllers/messages/by_bots_controller_test.rb
