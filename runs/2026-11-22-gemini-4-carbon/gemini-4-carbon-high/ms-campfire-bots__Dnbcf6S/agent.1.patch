@@ -0,0 +1,130 @@
+require "test_helper"
+
+class Messages::ByBotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+    @bot = User.bots.create!(name: "Deploy Bot", creator: users(:kevin))
+    @open_room = rooms(:hq)
+  end
+
+  test "bot posts raw body to open room, broadcasts to clients, marks unread, and delivers web push notifications" do
+    expected_pushes = Push::Subscription.where(user: @open_room.users).count
+
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      WebPush.expects(:payload_send).with { |kwargs|
+        payload = JSON.parse(kwargs[:message])
+        payload["title"] == @open_room.name &&
+          payload.dig("options", "body") == "Deploy Bot: Deploy of v1.2.3 finished ✅"
+      }.times(expected_pushes)
+
+      assert_broadcasts UnreadRoomsChannel.stream_name_for(users(:david).id), 1 do
+        post "/rooms/#{@open_room.id}/#{@bot.bot_key}/messages",
+          params: +"Deploy of v1.2.3 finished ✅",
+          headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+      end
+    end
+
+    wait_for_web_push_delivery_pool_tasks(expected_pushes)
+
+    assert_response :created
+    message = Message.last
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal @bot, message.creator
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+    assert memberships(:david_hq).reload.unread?
+
+    assert_rendered_turbo_stream_broadcast @open_room, :messages, action: "append", target: [ @open_room, :messages ] do
+      assert_select ".message__author", text: "Deploy Bot"
+      assert_select ".message__body", text: /Deploy of v1\.2\.3 finished ✅/
+    end
+
+    sign_in :david
+    get room_url(@open_room)
+    assert_response :success
+    assert_select "##{dom_id(message)} .message__author", text: "Deploy Bot"
+    assert_select "##{dom_id(message)} .message__body", text: /Deploy of v1\.2\.3 finished ✅/
+  end
+
+  test "preserves angle brackets ampersands and multiline text safely" do
+    post "/rooms/#{@open_room.id}/#{@bot.bot_key}/messages",
+      params: +"Deploy by <alice@example.com> & 1 < 2\nAll green!",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :created
+    message = Message.last
+    assert_equal "Deploy by <alice@example.com> & 1 < 2\nAll green!", message.plain_text_body
+
+    sign_in :david
+    get room_url(@open_room)
+    assert_select "##{dom_id(message)} .message__body", text: /Deploy by <alice@example\.com> & 1 < 2/
+  end
+
+  test "supports file attachment upload via multipart form" do
+    post "/rooms/#{@open_room.id}/#{@bot.bot_key}/messages",
+      params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+
+    assert_response :created
+    message = Message.last
+    assert message.attachment?
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+  end
+
+  test "returns 422 on empty body and no attachment" do
+    assert_no_difference -> { Message.count } do
+      post "/rooms/#{@open_room.id}/#{@bot.bot_key}/messages"
+      assert_response :unprocessable_content
+
+      post "/rooms/#{@open_room.id}/#{@bot.bot_key}/messages", params: +""
+      assert_response :unprocessable_content
+
+      post "/rooms/#{@open_room.id}/#{@bot.bot_key}/messages", params: +"   \n\t  "
+      assert_response :unprocessable_content
+    end
+  end
+
+  test "returns 404 on bad room id or room the bot is not a member of" do
+    post "/rooms/999999/#{@bot.bot_key}/messages", params: +"Hello"
+    assert_response :not_found
+
+    closed_room = rooms(:designers)
+    assert_not closed_room.users.include?(@bot)
+    post "/rooms/#{closed_room.id}/#{@bot.bot_key}/messages", params: +"Hello"
+    assert_response :not_found
+  end
+
+  test "bot added to closed room can post messages to it" do
+    closed_room = rooms(:designers)
+    closed_room.memberships.grant_to(@bot)
+
+    post "/rooms/#{closed_room.id}/#{@bot.bot_key}/messages", params: +"Design deploy ready"
+    assert_response :created
+  end
+
+  test "returns 401 on invalid bot code or deleted bot" do
+    post "/rooms/#{@open_room.id}/invalid-code/messages", params: +"Hello"
+    assert_response :unauthorized
+
+    post "/rooms/#{@open_room.id}/invalid.code/messages", params: +"Hello"
+    assert_response :unauthorized
+
+    post "/rooms/999999/invalid-code/messages", params: +"Hello"
+    assert_response :unauthorized
+
+    bot_key = @bot.bot_key
+    @bot.deactivate
+
+    post "/rooms/#{@open_room.id}/#{bot_key}/messages", params: +"After deletion"
+    assert_response :unauthorized
+  end
+
+  private
+    def wait_for_web_push_delivery_pool_tasks(count)
+      start = Time.now
+      timeout = 1.0
+      pool = Rails.configuration.x.web_push_pool.delivery_pool
+      while pool.completed_task_count < count
+        raise "Timeout waiting for pool tasks to complete" if Time.now - start > timeout
+        sleep 0.02
+      end
+    end
+end
diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
