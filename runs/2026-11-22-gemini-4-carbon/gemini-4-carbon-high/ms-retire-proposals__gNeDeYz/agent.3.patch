--- /dev/null
+++ b/app/components/admin/legislation/proposals/toggle_selection_component.rb
@@ -0,0 +1,31 @@
+class Admin::Legislation::Proposals::ToggleSelectionComponent < ApplicationComponent
+  attr_reader :proposal
+
+  def initialize(proposal)
+    @proposal = proposal
+  end
+
+  private
+
+    def action
+      if selected?
+        :deselect
+      else
+        :select
+      end
+    end
+
+    def selected?
+      proposal.selected?
+    end
+
+    def options
+      {
+        "aria-label": label
+      }
+    end
+
+    def label
+      t("admin.actions.label", action: t("admin.actions.select"), name: proposal.title)
+    end
+end
