+require "test_helper"
+
+class CursorPaginationTest < ActionDispatch::IntegrationTest
+  private
+
+  def account_headers(subdomain, token = nil)
+    headers = { "X-Helpdesk-Account" => subdomain }
+    headers["Authorization"] = "Bearer #{token}" if token
+    headers
+  end
+
+  def create_business(subdomain:, name: "Acme Corp", email: nil)
+    owner_email = email || "owner@#{subdomain}.test"
+    account = Account.create!(name: name, subdomain: subdomain)
+    owner = account.users.create!(
+      name: "Owner #{subdomain}",
+      email: owner_email,
+      password: "secure-password-123",
+      role: "admin",
+      verified: true
+    )
+    account.update!(owner: owner)
+    session = account.sessions.create!(user: owner)
+    [ account, owner, session.token ]
+  end
+
+  def create_staff(account:, email:, role: "agent", name: "Agent", suspended: false, verified: true)
+    user = account.users.create!(
+      name: name,
+      email: email,
+      password: "secure-password-123",
+      role: role,
+      suspended: suspended,
+      verified: verified
+    )
+    token = (!suspended && verified) ? account.sessions.create!(user: user).token : nil
+    [ user, token ]
+  end
+
+  def create_customer(account:, email:, name: "Customer")
+    user = account.users.create!(
+      name: name,
+      email: email,
+      password: "secure-password-123",
+      role: "customer",
+      verified: true
+    )
+    session = account.sessions.create!(user: user)
+    [ user, session.token ]
+  end
+
+  def create_ticket_with_comment(account:, requester:, subject:, body: "Initial body", status: "open", priority: "normal", assignee: nil, group: nil, ts: Time.current)
+    ticket = account.tickets.create!(
+      requester: requester,
+      assignee: assignee,
+      group: group,
+      subject: subject,
+      status: status,
+      priority: priority,
+      created_at: ts,
+      updated_at: ts,
+      customer_updated_at: ts
+    )
+    account.comments.create!(
+      ticket: ticket,
+      author: requester,
+      body: body,
+      public: true,
+      created_at: ts,
+      updated_at: ts
+    )
+    ticket
+  end
