diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..bfa6675
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,87 @@
+module Api
+  module V1
+    class AccountsController < BaseController
+      before_action :require_account!, only: %i[show cancel reactivate]
+      before_action :authenticate_user!, only: %i[show cancel reactivate]
+      before_action :ensure_account_active!, only: %i[show cancel]
+      before_action :require_owner!, only: %i[cancel reactivate]
+
+      def create
+        account_attrs = require_hash_param(:account)
+        admin_attrs = account_attrs[:admin]
+
+        unless admin_attrs.is_a?(ActionController::Parameters) || admin_attrs.is_a?(Hash)
+          return render json: {
+            error: "Admin can't be blank",
+            errors: { admin: [ "can't be blank" ] }
+          }, status: :unprocessable_entity
+        end
+
+        account = Account.new(
+          name: account_attrs[:name],
+          subdomain: account_attrs[:subdomain]
+        )
+
+        user = User.new(
+          account: account,
+          name: admin_attrs[:name],
+          email: admin_attrs[:email],
+          password: admin_attrs[:password],
+          role: "admin",
+          verified: false
+        )
+
+        account_valid = account.valid?
+        user_valid = user.valid?
+
+        unless account_valid && user_valid
+          combined_errors = account.errors.to_hash(true)
+          user.errors.to_hash(true).each do |field, messages|
+            combined_errors[:"admin.#{field}"] = messages
+          end
+          all_messages = account.errors.full_messages + user.errors.full_messages
+          return render json: {
+            error: all_messages.to_sentence,
+            errors: combined_errors
+          }, status: :unprocessable_entity
+        end
+
+        verification_token = nil
+        ActiveRecord::Base.transaction do
+          account.save!
+          user.account = account
+          user.save!
+          account.update!(owner: user)
+          verification_token = user.issue_email_verification_token!
+        end
+
+        UserMailer.email_verification(user: user, token: verification_token.token).deliver_now
+
+        render json: {
+          account: account.api_json,
+          user: user.api_json
+        }, status: :created
+      end
+
+      def show
+        render json: { account: current_account.api_json }, status: :ok
+      end
+
+      def cancel
+        current_account.cancel!
+        render json: { account: current_account.api_json }, status: :ok
+      end
+
+      def reactivate
+        if !current_account.cancelled?
+          render json: { error: "Account is not cancelled" }, status: :unprocessable_entity
+        elsif current_account.cancellation_expired?
+          render json: { error: "Account cancellation period has expired" }, status: :unprocessable_entity
+        else
+          current_account.reactivate!
+          render json: { account: current_account.api_json }, status: :ok
+        end
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..b5ce4e1
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,139 @@
+module Api
+  module V1
+    class BaseController < ApplicationController
+      include Paginatable
+
+      MAX_BIGINT = (1 << 63) - 1
+
+      attr_reader :current_account, :current_user, :current_session
+
+      rescue_from ActionController::ParameterMissing do |exception|
+        render json: { error: exception.message }, status: :unprocessable_entity
+      end
+
+      rescue_from Paginatable::InvalidPaginationParameters do |exception|
+        render json: {
+          error: exception.message,
+          errors: exception.errors
+        }, status: :unprocessable_entity
+      end
+
+      rescue_from ActiveRecord::RecordInvalid do |exception|
+        render_validation_errors(exception.record)
+      end
+
+      rescue_from ActiveRecord::RecordNotUnique do
+        render json: { error: "Record already exists" }, status: :unprocessable_entity
+      end
+
+      rescue_from ActiveRecord::RecordNotFound do
+        render json: { error: "Not found" }, status: :not_found
+      end
+
+      def route_not_found
+        render json: { error: "Not found" }, status: :not_found
+      end
+
+      private
+
+      def require_hash_param(key)
+        value = params.require(key)
+        return value if value.is_a?(ActionController::Parameters) || value.is_a?(Hash)
+
+        raise ActionController::ParameterMissing, key
+      end
+
+      def require_account!
+        subdomain = request.headers["X-Helpdesk-Account"].to_s.strip.downcase
+        if subdomain.blank?
+          render json: { error: "Missing X-Helpdesk-Account header" }, status: :bad_request
+          return
+        end
+
+        @current_account = Account.find_by(subdomain: subdomain)
+        return if @current_account
+
+        render json: { error: "Account not found" }, status: :not_found
+      end
+
+      def authenticate_user!
+        token = bearer_token
+        if token.blank?
+          render json: { error: "Unauthorized" }, status: :unauthorized
+          return
+        end
+
+        session = current_account.sessions.includes(:user).find_by_raw_token(token)
+        if session.nil? || session.user.nil? || session.user.account_id != current_account.id || session.user.suspended?
+          render json: { error: "Unauthorized" }, status: :unauthorized
+          return
+        end
+
+        @current_session = session
+        @current_user = session.user
+      end
+
+      def ensure_account_active!
+        return if current_account&.active?
+
+        render json: { error: "Account is cancelled" }, status: :forbidden
+      end
+
+      def require_owner!
+        return if current_user&.owner?
+
+        render json: { error: "Forbidden" }, status: :forbidden
+      end
+
+      def require_admin!
+        return if current_user&.admin?
+
+        render json: { error: "Forbidden" }, status: :forbidden
+      end
+
+      def require_staff!
+        return if current_user&.staff?
+
+        render json: { error: "Forbidden" }, status: :forbidden
+      end
+
+      def require_customer!
+        return if current_user&.customer?
+
+        render json: { error: "Forbidden" }, status: :forbidden
+      end
+
+      def parse_boolean(value)
+        case value
+        when true, "true" then true
+        when false, "false" then false
+        else :invalid
+        end
+      end
+
+      def parse_non_negative_bigint(value)
+        id = if value.is_a?(Integer)
+          value
+        elsif value.is_a?(String)
+          stripped = value.strip
+          stripped.match?(/\A\d+\z/) ? stripped.to_i : nil
+        end
+
+        id if id && id >= 0 && id <= MAX_BIGINT
+      end
+
+      def bearer_token
+        header = request.headers["Authorization"].to_s
+        match = header.match(/\ABearer\s+(\S+)\z/i)
+        match && match[1]
+      end
+
+      def render_validation_errors(record)
+        render json: {
+          error: record.errors.full_messages.to_sentence,
+          errors: record.errors.to_hash(true)
+        }, status: :unprocessable_entity
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
new file mode 100644
index 0000000..e6ec057
--- /dev/null
+++ b/app/controllers/api/v1/email_verifications_controller.rb
@@ -0,0 +1,43 @@
+module Api
+  module V1
+    class EmailVerificationsController < BaseController
+      before_action :require_account!
+      before_action :ensure_account_active!
+
+      def create
+        ev_params = require_hash_param(:email_verification)
+        email = ev_params[:email].to_s.strip.downcase
+
+        if email.blank?
+          return render json: {
+            error: "Email can't be blank",
+            errors: { email: [ "can't be blank" ] }
+          }, status: :unprocessable_entity
+        end
+
+        user = current_account.users.find_by(email: email)
+        if user && !user.verified?
+          token_record = user.issue_email_verification_token!
+          UserMailer.email_verification(user: user, token: token_record.token).deliver_now
+        end
+
+        render json: { status: "ok" }, status: :ok
+      end
+
+      def confirm
+        ev_params = require_hash_param(:email_verification)
+        raw_token = ev_params[:token].to_s.strip
+
+        token_record = current_account.email_verification_tokens.includes(:user).find_by_raw_token(raw_token)
+        if token_record.nil? || token_record.expired? || token_record.user.account_id != current_account.id
+          return render json: { error: "Invalid or expired email verification token" }, status: :unprocessable_entity
+        end
+
+        user = token_record.user
+        user.verify_email!
+
+        render json: { user: user.api_json }, status: :ok
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/group_memberships_controller.rb b/app/controllers/api/v1/group_memberships_controller.rb
new file mode 100644
index 0000000..d6a4bd9
--- /dev/null
+++ b/app/controllers/api/v1/group_memberships_controller.rb
@@ -0,0 +1,155 @@
+module Api
+  module V1
+    class GroupMembershipsController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!
+      before_action :ensure_account_active!
+      before_action :require_staff!, only: %i[index show]
+      before_action :require_admin!, only: %i[create make_default destroy]
+      before_action :set_group_membership, only: %i[show make_default destroy]
+
+      def index
+        scope = current_account.group_memberships
+        filter_errors = {}
+        filter_messages = []
+
+        if params.key?(:group_id) && params[:group_id].to_s != ""
+          group_id = parse_non_negative_bigint(params[:group_id])
+          if group_id
+            scope = scope.where(group_id: group_id)
+          else
+            msg = "Group is invalid"
+            filter_errors[:group_id] = [ msg ]
+            filter_messages << msg
+          end
+        end
+
+        if params.key?(:user_id) && params[:user_id].to_s != ""
+          user_id = parse_non_negative_bigint(params[:user_id])
+          if user_id
+            scope = scope.where(user_id: user_id)
+          else
+            msg = "User is invalid"
+            filter_errors[:user_id] = [ msg ]
+            filter_messages << msg
+          end
+        end
+
+        if filter_errors.any?
+          return render json: {
+            error: filter_messages.to_sentence,
+            errors: filter_errors
+          }, status: :unprocessable_entity
+        end
+
+        scope = scope.by_id
+        records, meta = paginate(scope, cursor: { scope: "group_memberships", direction: :asc })
+
+        render json: {
+          group_memberships: records.map(&:api_json),
+          **meta
+        }, status: :ok
+      end
+
+      def show
+        render json: { group_membership: @group_membership.api_json }, status: :ok
+      end
+
+      def create
+        attrs = require_hash_param(:group_membership)
+        has_default = attrs.key?(:default)
+        parsed_default = has_default ? parse_boolean(attrs[:default]) : nil
+
+        parsed_group_id = parse_non_negative_bigint(attrs[:group_id])
+        parsed_user_id = parse_non_negative_bigint(attrs[:user_id])
+
+        membership = nil
+
+        current_account.with_lock do
+          group = parsed_group_id ? current_account.groups.find_by(id: parsed_group_id) : nil
+          user = parsed_user_id ? current_account.users.find_by(id: parsed_user_id) : nil
+
+          combined_errors = {}
+          all_messages = []
+
+          if group.nil?
+            msg = "Group is invalid"
+            combined_errors[:group_id] = [ msg ]
+            all_messages << msg
+          end
+
+          if user.nil? || !user.staff?
+            msg = "User is invalid"
+            combined_errors[:user_id] = [ msg ]
+            all_messages << msg
+          elsif group && current_account.group_memberships.exists?(group_id: group.id, user_id: user.id)
+            msg = "User has already been taken"
+            combined_errors[:user_id] = [ msg ]
+            all_messages << msg
+          end
+
+          if has_default && parsed_default == :invalid
+            msg = "Default is not included in the list"
+            combined_errors[:default] = [ msg ]
+            all_messages << msg
+          end
+
+          if combined_errors.any?
+            return render json: {
+              error: all_messages.to_sentence,
+              errors: combined_errors
+            }, status: :unprocessable_entity
+          end
+
+          has_existing = current_account.group_memberships.exists?(user_id: user.id)
+          make_default = !has_existing || (has_default && parsed_default == true)
+
+          if make_default && has_existing
+            current_account.group_memberships
+              .where(user_id: user.id, default: true)
+              .update_all(default: false, updated_at: Time.current)
+          end
+
+          membership = current_account.group_memberships.create!(
+            group: group,
+            user: user,
+            default: make_default
+          )
+        end
+
+        render json: { group_membership: membership.api_json }, status: :created
+      end
+
+      def make_default
+        current_account.with_lock do
+          @group_membership.reload
+
+          unless @group_membership.default?
+            current_account.group_memberships
+              .where(user_id: @group_membership.user_id, default: true)
+              .where.not(id: @group_membership.id)
+              .update_all(default: false, updated_at: Time.current)
+            @group_membership.update!(default: true)
+          end
+        end
+
+        render json: { group_membership: @group_membership.api_json }, status: :ok
+      end
+
+      def destroy
+        current_account.with_lock do
+          @group_membership.reload
+          @group_membership.destroy!
+        end
+
+        head :no_content
+      end
+
+      private
+
+      def set_group_membership
+        @group_membership = current_account.group_memberships.find(params[:id])
+      end
+    end
+  end
+end
