+  test "recently active ordering and pagination for requests, tickets, and comments" do
+    _account, owner_token = create_verified_business(subdomain: "acme")
+    _avery, avery_token = register_and_verify_customer(subdomain: "acme", email: "avery@example.test")
+
+    # Empty list pagination defaults
+    get "/api/v1/requests", headers: account_headers("acme", avery_token)
+    assert_response :ok
+    assert_equal(
+      {
+        "requests" => [],
+        "count" => 0,
+        "page" => 1,
+        "per_page" => 25,
+        "next_page" => nil,
+        "previous_page" => nil
+      },
+      response.parsed_body
+    )
+
+    # Create 30 requests at distinct timestamps
+    created_ids = []
+    30.times do |i|
+      travel((i + 1).seconds) do
+        post "/api/v1/requests",
+          params: {
+            request: {
+              subject: "Request ##{i + 1}",
+              comment: { body: "Initial comment #{i + 1}" }
+            }
+          },
+          headers: account_headers("acme", avery_token),
+          as: :json
+        assert_response :created
+        created_ids << response.parsed_body.dig("request", "id")
+      end
+    end
+
+    # Default pagination (page=1, per_page=25): newest (#30 down to #6)
+    get "/api/v1/requests", headers: account_headers("acme", avery_token)
+    assert_response :ok
+    page1 = response.parsed_body
+    assert_equal 30, page1["count"]
+    assert_equal 1, page1["page"]
+    assert_equal 25, page1["per_page"]
+    assert_equal 2, page1["next_page"]
+    assert_nil page1["previous_page"]
+    assert_equal created_ids.reverse.first(25), page1["requests"].map { |r| r["id"] }
+
+    # Page 2 with default per_page=25: remaining 5 (#5 down to #1)
+    get "/api/v1/requests", params: { page: 2 }, headers: account_headers("acme", avery_token)
+    assert_response :ok
+    page2 = response.parsed_body
+    assert_equal 30, page2["count"]
+    assert_equal 2, page2["page"]
+    assert_equal 25, page2["per_page"]
+    assert_nil page2["next_page"]
+    assert_equal 1, page2["previous_page"]
+    assert_equal created_ids.reverse.last(5), page2["requests"].map { |r| r["id"] }
+
+    # Staff reply to the oldest ticket (#1) without changing status moves it to #1 most recently active!
+    oldest_id = created_ids.first
+    travel 2.minutes do
+      patch "/api/v1/tickets/#{oldest_id}",
+        params: { ticket: { comment: { body: "Staff checking oldest ticket" } } },
+        headers: account_headers("acme", owner_token),
+        as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/tickets", params: { page: 1, per_page: 10 }, headers: account_headers("acme", owner_token)
+    assert_response :ok
+    tickets_p1 = response.parsed_body
+    assert_equal 30, tickets_p1["count"]
+    assert_equal 1, tickets_p1["page"]
+    assert_equal 10, tickets_p1["per_page"]
+    assert_equal 2, tickets_p1["next_page"]
+    assert_nil tickets_p1["previous_page"]
+    assert_equal oldest_id, tickets_p1["tickets"].first["id"]
+
+    get "/api/v1/requests", params: { page: 2, per_page: 10 }, headers: account_headers("acme", avery_token)
+    assert_response :ok
+    requests_p2 = response.parsed_body
+    assert_equal 30, requests_p2["count"]
+    assert_equal 2, requests_p2["page"]
+    assert_equal 10, requests_p2["per_page"]
+    assert_equal 3, requests_p2["next_page"]
+    assert_equal 1, requests_p2["previous_page"]
+    assert_equal 10, requests_p2["requests"].size
+
+    # Comment pagination (oldest first)
+    5.times do |i|
+      travel((3 + i).minutes) do
+        patch "/api/v1/tickets/#{oldest_id}",
+          params: { ticket: { comment: { body: "Follow-up #{i + 1}" } } },
+          headers: account_headers("acme", owner_token),
+          as: :json
+        assert_response :ok
+      end
+    end
+    # Total comments on oldest_id: 1 initial + 1 staff check + 5 follow-ups = 7
+    get "/api/v1/tickets/#{oldest_id}/comments",
+      params: { page: 2, per_page: 3 },
+      headers: account_headers("acme", owner_token)
+    assert_response :ok
+    cp2 = response.parsed_body
+    assert_equal 7, cp2["count"]
+    assert_equal 2, cp2["page"]
+    assert_equal 3, cp2["per_page"]
+    assert_equal 3, cp2["next_page"]
+    assert_equal 1, cp2["previous_page"]
+    assert_equal [ "Follow-up 2", "Follow-up 3", "Follow-up 4" ], cp2["comments"].map { |c| c["body"] }
+  end
