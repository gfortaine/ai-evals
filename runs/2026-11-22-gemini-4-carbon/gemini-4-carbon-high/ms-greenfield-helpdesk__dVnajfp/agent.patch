+class EmailMimeAndLiveRelayTest < ActionDispatch::IntegrationTest
+  INGRESS_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  INGRESS_PASSWORD = "live-relay-password"
+
+  def account_headers(subdomain, token = nil)
+    headers = { "X-Helpdesk-Account" => subdomain }
+    headers["Authorization"] = "Bearer #{token}" if token.present?
+    headers
+  end
+
+  def relay_auth_header
+    "Basic #{Base64.strict_encode64("actionmailbox:#{INGRESS_PASSWORD}")}"
+  end
+
+  def post_raw_inbound_email(raw_source)
+    post INGRESS_PATH,
+      params: raw_source,
+      headers: {
+        "Content-Type" => "message/rfc822",
+        "Authorization" => relay_auth_header
+      }
+  end
+
+  def create_verified_business(subdomain: "acme", owner_email: "jo@acme.test", password: "owner-password")
+    post "/api/v1/account/create",
