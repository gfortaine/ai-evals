+
+  test "custom merge notes, public visibility, no outbound email on merge, closed ticket rejects edits and email replies" do
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD, "HELPDESK_SUPPORT_DOMAIN" => nil) do
