+module Api
+  module V1
+    class TicketsController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!
+      before_action :ensure_account_active!
+      before_action :require_staff!
+      before_action :set_ticket, only: %i[show update comments merge]
+
+      def index
+        scope = current_account.tickets
+        filter_errors = {}
+        filter_messages = []
+
+        if params.key?(:status) && params[:status].to_s != ""
+          status = params[:status].is_a?(String) ? params[:status].strip : nil
+          if Ticket::STATUSES.include?(status)
+            scope = scope.where(status: status)
+          else
+            msg = "Status is not included in the list"
+            filter_errors[:status] = [ msg ]
+            filter_messages << msg
+          end
+        end
+
+        if params.key?(:priority) && params[:priority].to_s != ""
+          priority = params[:priority].is_a?(String) ? params[:priority].strip : nil
+          if Ticket::PRIORITIES.include?(priority)
+            scope = scope.where(priority: priority)
+          else
+            msg = "Priority is not included in the list"
+            filter_errors[:priority] = [ msg ]
+            filter_messages << msg
+          end
+        end
+
+        if params.key?(:group_id) && params[:group_id].to_s != ""
+          raw_group = params[:group_id]
+          if raw_group.is_a?(String) && raw_group.strip == "unassigned"
+            scope = scope.where(group_id: nil)
+          else
+            group_id = parse_non_negative_bigint(raw_group)
+            if group_id
+              scope = scope.where(group_id: group_id)
+            else
+              msg = "Group is invalid"
+              filter_errors[:group_id] = [ msg ]
+              filter_messages << msg
+            end
+          end
+        end
+
+        if params.key?(:assignee_id) && params[:assignee_id].to_s != ""
+          raw_assignee = params[:assignee_id]
+          if raw_assignee.is_a?(String) && raw_assignee.strip == "unassigned"
+            scope = scope.where(assignee_id: nil)
+          else
+            assignee_id = parse_non_negative_bigint(raw_assignee)
+            if assignee_id
+              scope = scope.where(assignee_id: assignee_id)
+            else
+              msg = "Assignee is invalid"
+              filter_errors[:assignee_id] = [ msg ]
+              filter_messages << msg
+            end
+          end
+        end
+
+        if params.key?(:requester_id) && params[:requester_id].to_s != ""
+          requester_id = parse_non_negative_bigint(params[:requester_id])
+          if requester_id
+            scope = scope.where(requester_id: requester_id)
+          else
+            msg = "Requester is invalid"
+            filter_errors[:requester_id] = [ msg ]
+            filter_messages << msg
+          end
+        end
+
+        if params.key?(:q) && !params[:q].nil?
+          if params[:q].is_a?(String)
+            query = params[:q].strip
+            scope = scope.matching_query(query) unless query.empty?
+          else
+            msg = "Query is invalid"
+            filter_errors[:q] = [ msg ]
+            filter_messages << msg
+          end
+        end
+
+        if filter_errors.any?
+          return render json: {
+            error: filter_messages.to_sentence,
+            errors: filter_errors
+          }, status: :unprocessable_entity
+        end
+
+        scope = scope.recent_activity
+        records, meta = paginate(
+          scope,
+          includes: %i[requester assignee group],
+          cursor: { scope: "tickets", timestamp_column: :updated_at, direction: :desc }
+        )
+
+        render json: {
+          tickets: records.map(&:ticket_json),
+          **meta
+        }, status: :ok
+      end
+
+      def show
+        render json: { ticket: @ticket.ticket_json }, status: :ok
+      end
+
+      def comments
+        scope = @ticket.comments.chronological
+        records, meta = paginate(
+          scope,
+          includes: :author,
+          cursor: { scope: "ticket_comments:#{@ticket.id}", timestamp_column: :created_at, direction: :asc }
+        )
+
+        render json: {
+          comments: records.map(&:api_json),
+          **meta
+        }, status: :ok
+      end
+
+      def update
+        ticket_attrs = require_hash_param(:ticket)
+        has_comment = ticket_attrs.key?(:comment)
+        has_status = ticket_attrs.key?(:status)
+        has_assignee = ticket_attrs.key?(:assignee_id)
+        has_group = ticket_attrs.key?(:group_id)
+        has_priority = ticket_attrs.key?(:priority)
+
+        comment = nil
+
+        current_account.with_lock do
+          @ticket = current_account.tickets.includes(:requester, :assignee, :group).find(@ticket.id)
+
+          if @ticket.closed?
+            return render json: {
+              error: "Closed ticket cannot be updated",
+              errors: { status: [ "Closed ticket cannot be updated" ] }
+            }, status: :unprocessable_entity
+          end
+
+          unless has_comment || has_status || has_assignee || has_group || has_priority
+            return render json: {
+              error: "Comment, status, assignee, group, or priority is required",
+              errors: { base: [ "Comment, status, assignee, group, or priority is required" ] }
+            }, status: :unprocessable_entity
+          end
+
+          was_grouped = @ticket.group_id.present?
+
+          if has_status
+            raw_status = ticket_attrs[:status]
+            @ticket.status = raw_status.is_a?(String) ? raw_status : nil
+          end
+
+          if has_priority
+            raw_priority = ticket_attrs[:priority]
+            @ticket.priority = raw_priority.is_a?(String) ? raw_priority : nil
+          end
+
+          invalid_group_input = false
+          explicitly_cleared_group = false
+          if has_group
+            raw_group_id = ticket_attrs[:group_id]
+            if raw_group_id.nil?
+              @ticket.group = nil
+              explicitly_cleared_group = true
+            else
+              parsed_group_id = parse_non_negative_bigint(raw_group_id)
+              if parsed_group_id
+                candidate_group = current_account.groups.find_by(id: parsed_group_id)
+                if candidate_group
+                  @ticket.group = candidate_group
+                else
+                  @ticket.group = nil
+                  invalid_group_input = true
+                end
+              else
+                @ticket.group = nil
+                invalid_group_input = true
+              end
+            end
+          end
+
+          invalid_assignee_input = false
+          conflicting_clear_group_and_assign = false
+          if has_assignee
+            raw_assignee_id = ticket_attrs[:assignee_id]
+            if raw_assignee_id.nil?
+              @ticket.assignee = nil
+            else
+              parsed_assignee_id = parse_non_negative_bigint(raw_assignee_id)
+              if parsed_assignee_id
+                candidate = current_account.users.find_by(id: parsed_assignee_id)
+                if candidate
+                  @ticket.assignee = candidate
+                  if explicitly_cleared_group
+                    if was_grouped || current_account.group_memberships.exists?(user_id: candidate.id)
+                      conflicting_clear_group_and_assign = true
+                    end
+                  elsif !has_group && @ticket.group_id.nil? && candidate.active_staff?
+                    default_membership = current_account.group_memberships
+                      .includes(:group)
+                      .find_by(user_id: candidate.id, default: true)
+                    @ticket.group = default_membership.group if default_membership
+                  end
+                else
+                  @ticket.assignee = nil
+                  invalid_assignee_input = true
+                end
+              else
+                @ticket.assignee = nil
+                invalid_assignee_input = true
+              end
+            end
+          elsif has_group && !invalid_group_input
+            if explicitly_cleared_group
+              @ticket.assignee = nil
+            elsif @ticket.assignee_id.present?
+              belongs_to_new_group = current_account.group_memberships.exists?(
+                group_id: @ticket.group_id,
+                user_id: @ticket.assignee_id
+              )
+              @ticket.assignee = nil unless belongs_to_new_group
+            end
+          end
+
+          invalid_comment_envelope = false
+          if has_comment
+            comment_attrs = ticket_attrs[:comment]
+            if comment_attrs.is_a?(ActionController::Parameters) || comment_attrs.is_a?(Hash)
+              public_value = if comment_attrs.key?(:public)
+                case comment_attrs[:public]
+                when true, "true" then true
+                when false, "false" then false
+                else nil
+                end
+              else
+                true
+              end
+
+              raw_body = comment_attrs[:body]
+              comment = @ticket.comments.new(
+                account: current_account,
+                author: current_user,
+                body: raw_body.is_a?(String) ? raw_body : nil,
+                public: public_value
+              )
+            else
+              invalid_comment_envelope = true
+            end
+          end
+
+          ticket_valid = @ticket.valid?
+          comment_valid = comment ? comment.valid? : !invalid_comment_envelope
+
+          if !ticket_valid || !comment_valid || invalid_group_input || invalid_assignee_input || conflicting_clear_group_and_assign
+            combined_errors = @ticket.errors.to_hash(true)
+            all_messages = @ticket.errors.full_messages.dup
+
+            if invalid_group_input
+              combined_errors[:group_id] = [ "Group is invalid" ]
+              all_messages << "Group is invalid"
+            end
+
+            if invalid_assignee_input
+              combined_errors[:assignee_id] = [ "Assignee is invalid" ]
+              all_messages << "Assignee is invalid"
+            elsif conflicting_clear_group_and_assign && !combined_errors.key?(:assignee_id)
+              msg = "Assignee must belong to the ticket's group"
+              combined_errors[:assignee_id] = [ msg ]
+              all_messages << msg
+            end
+
+            if invalid_comment_envelope
+              combined_errors[:comment] = [ "Comment can't be blank" ]
+              all_messages << "Comment can't be blank"
+            elsif comment && !comment_valid
+              comment.errors.to_hash(true).each do |field, messages|
+                combined_errors[:"comment.#{field}"] = messages
+              end
+              all_messages.concat(comment.errors.full_messages)
+            end
+
+            return render json: {
+              error: all_messages.to_sentence,
+              errors: combined_errors
+            }, status: :unprocessable_entity
+          end
+
+          customer_visible_change = (comment.present? && comment.public?) || @ticket.will_save_change_to_status?
+          now = Time.current
+
+          comment.save! if comment
+          @ticket.updated_at = now
+          @ticket.customer_updated_at = now if customer_visible_change
+          @ticket.save!
+        end
+
+        if comment&.public? && @ticket.via_email?
+          TicketMailer.staff_reply(ticket: @ticket, comment: comment).deliver_now
+        end
+
+        render json: { ticket: @ticket.ticket_json }, status: :ok
+      end
+
+      def merge
+        merge_attrs = require_hash_param(:merge)
+
+        source = nil
+        target = nil
+
+        current_account.with_lock do
+          source = current_account.tickets.includes(:requester, :assignee, :group).find(@ticket.id)
+
+          if source.closed?
+            return render json: {
+              error: "Closed ticket cannot be merged",
+              errors: { status: [ "Closed ticket cannot be merged" ] }
+            }, status: :unprocessable_entity
+          end
+
+          combined_errors = {}
+          all_messages = []
+
+          raw_target_id = merge_attrs[:target_id]
+          parsed_target_id = parse_non_negative_bigint(raw_target_id)
+
+          if raw_target_id.nil? || (raw_target_id.is_a?(String) && raw_target_id.strip.empty?)
+            msg = "Target can't be blank"
+            combined_errors[:target_id] = [ msg ]
+            all_messages << msg
+          elsif parsed_target_id.nil?
+            msg = "Target is invalid"
+            combined_errors[:target_id] = [ msg ]
+            all_messages << msg
+          elsif parsed_target_id == source.id
+            msg = "Target cannot be the same ticket"
+            combined_errors[:target_id] = [ msg ]
+            all_messages << msg
+          else
+            candidate = current_account.tickets.includes(:requester, :assignee, :group).find_by(id: parsed_target_id)
+            if candidate.nil?
+              msg = "Target is invalid"
+              combined_errors[:target_id] = [ msg ]
+              all_messages << msg
+            elsif candidate.requester_id != source.requester_id
+              msg = "Target must belong to the same customer"
+              combined_errors[:target_id] = [ msg ]
+              all_messages << msg
+            elsif candidate.closed?
+              msg = "Target ticket is closed"
+              combined_errors[:target_id] = [ msg ]
+              all_messages << msg
+            else
+              target = candidate
+            end
+          end
+
+          source_comment = build_merge_comment(
+            merge_attrs: merge_attrs,
+            key: :source_comment,
+            ticket: source,
+            default_body: "Merged into ticket ##{target&.id || parsed_target_id}.",
+            combined_errors: combined_errors,
+            all_messages: all_messages
+          )
+
+          target_comment = build_merge_comment(
+            merge_attrs: merge_attrs,
+            key: :target_comment,
+            ticket: target || source,
+            default_body: "Ticket ##{source.id} was merged into this ticket.",
+            combined_errors: combined_errors,
+            all_messages: all_messages
+          )
+
+          if combined_errors.any?
+            return render json: {
+              error: all_messages.to_sentence,
+              errors: combined_errors
+            }, status: :unprocessable_entity
+          end
+
+          now = Time.current
+
+          source_comment.created_at = now
+          source_comment.updated_at = now
+          source_comment.save!
+
+          target_comment.created_at = now
+          target_comment.updated_at = now
+          target_comment.save!
+
+          source.status = "closed"
+          source.merged_into = target
+          source.updated_at = now
+          source.customer_updated_at = now
+          source.save!
+
+          target.updated_at = now
+          target.customer_updated_at = now if target_comment.public?
+          target.save!
+        end
+
+        render json: {
+          source: source.ticket_json,
+          target: target.ticket_json
+        }, status: :ok
+      end
+
+      private
+
+      def set_ticket
+        @ticket = current_account.tickets.includes(:requester, :assignee, :group).find(params[:id])
+      end
+
+      def build_merge_comment(merge_attrs:, key:, ticket:, default_body:, combined_errors:, all_messages:)
+        label = key.to_s.humanize
+        if merge_attrs.key?(key)
+          comment_attrs = merge_attrs[key]
+          unless comment_attrs.is_a?(ActionController::Parameters) || comment_attrs.is_a?(Hash)
+            msg = "#{label} is invalid"
+            combined_errors[key] = [ msg ]
+            all_messages << msg
+            return nil
+          end
+
+          public_value = if comment_attrs.key?(:public)
+            case comment_attrs[:public]
+            when true, "true" then true
+            when false, "false" then false
+            else nil
+            end
+          else
+            false
+          end
+
+          body_value = if comment_attrs.key?(:body)
+            raw_body = comment_attrs[:body]
+            raw_body.is_a?(String) ? raw_body : nil
+          else
+            default_body
+          end
+
+          comment = Comment.new(
+            account: current_account,
+            ticket: ticket,
+            author: current_user,
+            body: body_value,
+            public: public_value
+          )
+        else
+          comment = Comment.new(
+            account: current_account,
+            ticket: ticket,
+            author: current_user,
+            body: default_body,
+            public: false
+          )
+        end
+
+        unless comment.valid?
+          comment.errors.to_hash(true).each do |field, messages|
+            combined_errors[:"#{key}.#{field}"] = messages
+          end
+          all_messages.concat(comment.errors.full_messages)
+        end
+
+        comment
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/users_controller.rb b/app/controllers/api/v1/users_controller.rb
new file mode 100644
index 0000000..2c44326
--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,144 @@
+module Api
+  module V1
+    class UsersController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!
+      before_action :ensure_account_active!
+      before_action :require_admin!
+      before_action :set_user, only: %i[show update]
+
+      def index
+        scope = current_account.users
+
+        if params.key?(:role) && params[:role].to_s != ""
+          role = params[:role].is_a?(String) ? params[:role].strip : nil
+          unless User::ROLES.include?(role)
+            return render json: {
+              error: "Role is not included in the list",
+              errors: { role: [ "Role is not included in the list" ] }
+            }, status: :unprocessable_entity
+          end
+          scope = scope.where(role: role)
+        end
+
+        if params.key?(:suspended) && params[:suspended].to_s != ""
+          suspended_val = parse_boolean(params[:suspended])
+          if suspended_val == :invalid
+            return render json: {
+              error: "Suspended is not included in the list",
+              errors: { suspended: [ "Suspended is not included in the list" ] }
+            }, status: :unprocessable_entity
+          end
+          scope = scope.where(suspended: suspended_val)
+        end
+
+        scope = scope.by_id
+        records, meta = paginate(scope, cursor: { scope: "users", direction: :asc })
+
+        render json: {
+          users: records.map(&:api_json),
+          **meta
+        }, status: :ok
+      end
+
+      def show
+        render json: { user: @user.api_json }, status: :ok
+      end
+
+      def update
+        user_attrs = require_hash_param(:user)
+        has_suspended = user_attrs.key?(:suspended)
+        has_role = user_attrs.key?(:role)
+        has_name = user_attrs.key?(:name)
+
+        unless has_suspended || has_role || has_name
+          return render json: {
+            error: "User attributes can't be blank",
+            errors: { base: [ "User attributes can't be blank" ] }
+          }, status: :unprocessable_entity
+        end
+
+        current_account.with_lock do
+          @user.reload
+          was_active_admin = @user.admin? && !@user.suspended? && @user.verified?
+          custom_errors = {}
+
+          if has_name
+            raw_name = user_attrs[:name]
+            @user.name = raw_name.is_a?(String) ? raw_name : nil
+          end
+
+          if has_role
+            raw_role = user_attrs[:role]
+            new_role = raw_role.is_a?(String) ? raw_role : nil
+            if @user.customer? && new_role != "customer"
+              custom_errors[:role] = [ "Customer role cannot be changed" ]
+            elsif @user.staff? && !User::STAFF_ROLES.include?(new_role)
+              custom_errors[:role] = [ "Role is not included in the list" ]
+            elsif @user.owner? && new_role != "admin"
+              custom_errors[:role] = [ "Account owner must remain an admin" ]
+            else
+              @user.role = new_role
+            end
+          end
+
+          if has_suspended
+            suspended_val = parse_boolean(user_attrs[:suspended])
+            if suspended_val == :invalid
+              @user.suspended = nil
+            else
+              @user.suspended = suspended_val
+            end
+          end
+
+          @user.valid?
+          combined_errors = @user.errors.to_hash(true)
+          all_messages = @user.errors.full_messages.dup
+
+          custom_errors.each do |field, msgs|
+            combined_errors[field] = (combined_errors[field] || []) + msgs
+            all_messages.concat(msgs)
+          end
+
+          will_be_active_admin = @user.admin? && @user.suspended == false && @user.verified?
+          if combined_errors.empty? && was_active_admin && !will_be_active_admin
+            other_active_admins = current_account.users
+              .where(role: "admin", suspended: false, verified: true)
+              .where.not(id: @user.id)
+              .exists?
+
+            unless other_active_admins
+              msg = "Cannot suspend or demote the last active admin"
+              err_key = has_suspended && @user.suspended ? :suspended : :role
+              combined_errors[err_key] = [ msg ]
+              all_messages << msg
+            end
+          end
+
+          if combined_errors.any?
+            return render json: {
+              error: all_messages.to_sentence,
+              errors: combined_errors
+            }, status: :unprocessable_entity
+          end
+
+          @user.save!
+
+          if @user.suspended?
+            @user.sessions.delete_all
+            @user.password_reset_tokens.delete_all
+            current_account.tickets.where(assignee_id: @user.id).update_all(assignee_id: nil)
+          end
+        end
+
+        render json: { user: @user.api_json }, status: :ok
+      end
+
+      private
+
+      def set_user
+        @user = current_account.users.find(params[:id])
+      end
+    end
+  end
+end
