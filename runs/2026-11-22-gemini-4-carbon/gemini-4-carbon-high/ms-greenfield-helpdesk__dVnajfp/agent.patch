+          name: subdomain.capitalize,
+          subdomain: subdomain,
+          admin: { name: "Jo", email: owner_email, password: password }
+        }
+      },
+      as: :json
+    assert_response :created
+    token = ActionMailer::Base.deliveries.last.body.decoded[/token=([A-Za-z0-9_-]+)/, 1]
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: owner_email, password: password } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+    session_token = response.parsed_body.dig("session", "token")
+    ActionMailer::Base.deliveries.clear
+
+    [ Account.find_by!(subdomain: subdomain), session_token ]
+  end
