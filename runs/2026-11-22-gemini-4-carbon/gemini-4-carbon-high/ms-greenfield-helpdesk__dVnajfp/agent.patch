+  test "cursor pagination avoids COUNT(*) and OFFSET and uses index scans on deep pages" do
+    account, _owner, owner_token = create_business(subdomain: "perfco")
+    customer, _ = create_customer(account: account, email: "cust@perfco.test")
+
+    now = Time.utc(2026, 11, 21, 16, 0, 0)
+    rows = 2_000.times.map do |i|
+      {
+        account_id: account.id,
+        requester_id: customer.id,
+        subject: "Perf ticket #{i}",
+        status: "open",
+        priority: "normal",
+        via_email: false,
+        reply_token: "perf_token_#{account.id}_#{i}",
+        created_at: now + i.seconds,
+        updated_at: now + i.seconds,
+        customer_updated_at: now + i.seconds
+      }
+    end
+    Ticket.insert_all!(rows)
+    ActiveRecord::Base.connection.execute("ANALYZE tickets")
+
+    sql_events = []
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |_name, _start, _finish, _id, payload|
+      next if payload[:name] == "SCHEMA" || payload[:sql].start_with?("BEGIN", "COMMIT", "ROLLBACK", "SAVEPOINT", "RELEASE")
+      sql_events << { sql: payload[:sql], binds: payload[:type_casted_binds] }
+    end
+
+    begin
+      get "/api/v1/tickets?status=open&page[size]=25", headers: account_headers("perfco", owner_token)
+      assert_response :ok
+      p1 = response.parsed_body
+
+      sql_events.clear
+      get p1.dig("links", "next"), headers: account_headers("perfco", owner_token)
+      assert_response :ok
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+
+    sql_queries = sql_events.map { |e| e[:sql] }
+    assert sql_queries.none? { |sql| sql.match?(/\bCOUNT\s*\(/i) }, "Cursor pagination must not run COUNT(*): #{sql_queries.inspect}"
+    assert sql_queries.none? { |sql| sql.match?(/\bOFFSET\b/i) }, "Cursor pagination must not use OFFSET: #{sql_queries.inspect}"
+
+    ticket_event = sql_events.find { |e| e[:sql].include?('FROM "tickets"') && e[:sql].include?("ORDER BY") }
+    assert_not_nil ticket_event
+    binds = ticket_event[:binds].is_a?(Proc) ? ticket_event[:binds].call : ticket_event[:binds]
+    plan_rows = ActiveRecord::Base.connection.exec_query("EXPLAIN #{ticket_event[:sql]}", "EXPLAIN", binds).rows.flatten
+    assert_match(/Index Scan/i, plan_rows.join("\n"))
+  end
+
+  test "merging tickets and filtering unassigned group/assignee work seamlessly with cursor pagination" do
