index 0000000..e697f05
--- /dev/null
+++ b/app/mailers/ticket_mailer.rb
@@ -0,0 +1,29 @@
+class TicketMailer < ApplicationMailer
+  def staff_reply(ticket:, comment:)
+    @ticket = ticket
+    @comment = comment
+    @account = ticket.account
+    @requester = ticket.requester
+
+    reply_address = @ticket.reply_email
+    subject = @ticket.subject.match?(/\ARe:\s/i) ? @ticket.subject : "Re: #{@ticket.subject}"
+
+    headers_hash = {
+      from: email_address_with_name(reply_address, @account.name),
+      reply_to: reply_address,
+      to: @requester.email,
+      subject: subject,
+      content_type: "text/plain; charset=UTF-8",
+      body: @comment.body
+    }
+
+    last_delivery = @ticket.inbound_email_deliveries.order(id: :desc).first
+    if last_delivery&.message_id.present?
+      formatted_msg_id = "<#{last_delivery.message_id}>"
+      headers_hash[:in_reply_to] = formatted_msg_id
+      headers_hash[:references] = formatted_msg_id
+    end
+
+    mail(**headers_hash)
+  end
+end
diff --git a/app/mailers/user_mailer.rb b/app/mailers/user_mailer.rb
new file mode 100644
index 0000000..907d8ef
--- /dev/null
+++ b/app/mailers/user_mailer.rb
@@ -0,0 +1,64 @@
+class UserMailer < ApplicationMailer
+  def email_verification(user:, token:)
+    @user = user
+    @account = user.account
+    @verification_url = HelpdeskConfig.verify_email_url(account: @account, token: token)
+
+    mail(
+      from: HelpdeskConfig.mail_from,
+      to: @user.email,
+      subject: "Verify your email for #{@account.name}",
+      content_type: "text/plain; charset=UTF-8",
+      content_transfer_encoding: "7bit",
+      body: <<~TEXT
+        Hi #{@user.name},
+
+        Please verify your email address for #{@account.name} by visiting the link below:
+
+        #{@verification_url}
+      TEXT
+    )
+  end
+
+  def password_reset(user:, token:)
+    @user = user
+    @account = user.account
+    @reset_url = HelpdeskConfig.reset_password_url(account: @account, token: token)
+
+    mail(
+      from: HelpdeskConfig.mail_from,
+      to: @user.email,
+      subject: "Reset your password for #{@account.name}",
+      content_type: "text/plain; charset=UTF-8",
+      content_transfer_encoding: "7bit",
+      body: <<~TEXT
+        Hi #{@user.name},
+
+        You can reset your password for #{@account.name} by visiting the link below:
+
+        #{@reset_url}
+      TEXT
+    )
+  end
+
+  def invitation(invitation:, token:)
+    @invitation = invitation
+    @account = invitation.account
+    @accept_url = HelpdeskConfig.accept_invitation_url(account: @account, token: token)
+
+    mail(
+      from: HelpdeskConfig.mail_from,
+      to: @invitation.email,
+      subject: "You're invited to join #{@account.name}",
+      content_type: "text/plain; charset=UTF-8",
+      content_transfer_encoding: "7bit",
+      body: <<~TEXT
+        You have been invited to join #{@account.name} as #{@invitation.role}.
+
+        Accept your invitation by visiting the link below:
+
+        #{@accept_url}
+      TEXT
+    )
+  end
+end
diff --git a/app/models/account.rb b/app/models/account.rb
