+  assert_equal [ true, true, false ], response.parsed_body["comments"].map { |c| c["public"] }
+
+  get "/api/v1/requests/#{first_id}/comments", headers: account_headers("edgeco", avery_token)
+  assert_equal 2, response.parsed_body["count"]
+  assert_equal [ true, true ], response.parsed_body["comments"].map { |c| c["public"] }
+
+  # Boundary pagination (count == per_page == 2), out-of-range page, and malformed pagination params
+  get "/api/v1/tickets", params: { page: 1, per_page: 2 }, headers: account_headers("edgeco", owner_token)
+  assert_response :ok
+  assert_equal 2, response.parsed_body["count"]
+  assert_nil response.parsed_body["next_page"]
+  assert_nil response.parsed_body["previous_page"]
+
+  get "/api/v1/tickets", params: { page: 4, per_page: 2 }, headers: account_headers("edgeco", owner_token)
+  assert_response :ok
+  assert_equal [], response.parsed_body["tickets"]
+  assert_equal 2, response.parsed_body["count"]
+  assert_equal 4, response.parsed_body["page"]
+  assert_nil response.parsed_body["next_page"]
+  assert_equal 1, response.parsed_body["previous_page"]
+
+  get "/api/v1/tickets", params: { page: 0, per_page: -5 }, headers: account_headers("edgeco", owner_token)
+  assert_response :ok
+  assert_equal 1, response.parsed_body["page"]
+  assert_equal 25, response.parsed_body["per_page"]
+
+  get "/api/v1/tickets", params: { "page[]" => 1 }, headers: account_headers("edgeco", owner_token)
+  assert_response :ok
+
+  # Non-numeric IDs return 404
+  get "/api/v1/tickets/not-an-id", headers: account_headers("edgeco", owner_token)
+  assert_response :not_found
+  get "/api/v1/requests/not-an-id", headers: account_headers("edgeco", avery_token)
+  assert_response :not_found
+
+  # Unknown keys only in PATCH return 422
+  patch "/api/v1/tickets/#{first_id}", params: { ticket: { unknown: 1 } }, headers: account_headers("edgeco", owner_token), as: :json
+  assert_response :unprocessable_entity
+  patch "/api/v1/requests/#{first_id}", params: { request: { unknown: 1 } }, headers: account_headers("edgeco", avery_token), as: :json
+  assert_response :unprocessable_entity
+
+  # Cancel and reactivate preserves all tickets and comments
+  post "/api/v1/account/cancel", headers: account_headers("edgeco", owner_token), as: :json
+  assert_response :ok
+
+  post "/api/v1/sessions",
+    params: { session: { email: "jo@edgeco.test", password: "owner-password" } },
+    headers: account_headers("edgeco"),
+    as: :json
+  recovery_token = response.parsed_body.dig("session", "token")
+
+  post "/api/v1/account/reactivate", headers: account_headers("edgeco", recovery_token), as: :json
+  assert_response :ok
+
+  get "/api/v1/tickets", headers: account_headers("edgeco", recovery_token)
+  assert_response :ok
+  assert_equal 2, response.parsed_body["count"]
+end
+end
diff --git a/test/integration/edge_cases_test.rb b/test/integration/edge_cases_test.rb
new file mode 100644
index 0000000..a34ddf6
--- /dev/null
+++ b/test/integration/edge_cases_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class EdgeCasesTest < ActionDispatch::IntegrationTest
+  test "CORS headers are included on actual API responses for allowed origin" do
+    with_env("HELPDESK_FRONTEND_URL" => "http://localhost:3001") do
+      post "/api/v1/account/create",
+        params: {
+          account: {
+            name: "CorsCo",
+            subdomain: "corsco",
+            admin: { name: "Jo", email: "jo@corsco.test", password: "my-first-password" }
+          }
+        },
+        headers: { "Origin" => "http://localhost:3001" },
+        as: :json
+
+      assert_response :created
+      assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+
+      get "/api/v1/portal",
+        headers: {
+          "Origin" => "http://localhost:3001",
+          "X-Helpdesk-Account" => "corsco"
+        }
+      assert_response :ok
+      assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+    end
+  end
+
+  test "malformed JSON returns 400 Bad Request with JSON content type" do
+    post "/api/v1/account/create",
+      params: "{malformed-json",
+      headers: { "Content-Type" => "application/json", "Accept" => "application/json" }
+
+    assert_response :bad_request
+    assert_includes response.media_type, "application/json"
+  end
+
+  test "expired verification and password reset tokens are rejected" do
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "ExpireTokenCo",
+          subdomain: "expiretokenco",
+          admin: { name: "Jo", email: "jo@expire.test", password: "my-first-password" }
+        }
+      },
+      as: :json
+    assert_response :created
+    v_token = ActionMailer::Base.deliveries.last.body.decoded[/token=([A-Za-z0-9]+)/, 1]
+
+    travel 25.hours do
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: v_token } },
+        headers: { "X-Helpdesk-Account" => "expiretokenco" },
+        as: :json
+      assert_response :unprocessable_entity
+    end
+
+    # Requesting a fresh link works
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "jo@expire.test" } },
+      headers: { "X-Helpdesk-Account" => "expiretokenco" },
+      as: :json
+    assert_response :ok
+    fresh_v_token = ActionMailer::Base.deliveries.last.body.decoded[/token=([A-Za-z0-9]+)/, 1]
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: fresh_v_token } },
+      headers: { "X-Helpdesk-Account" => "expiretokenco" },
+      as: :json
+    assert_response :ok
+
+    # Password reset expiration (> 2 hours)
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@expire.test" } },
+      headers: { "X-Helpdesk-Account" => "expiretokenco" },
+      as: :json
+    assert_response :ok
+    r_token = ActionMailer::Base.deliveries.last.body.decoded[/token=([A-Za-z0-9]+)/, 1]
+
+    travel 3.hours do
+      post "/api/v1/password_resets/confirm",
+        params: { password_reset: { token: r_token, password: "new-password" } },
+        headers: { "X-Helpdesk-Account" => "expiretokenco" },
+        as: :json
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "unknown api/v1 route returns 404 JSON" do
+    get "/api/v1/nonexistent"
+    assert_response :not_found
+    assert_equal "Not found", response.parsed_body["error"]
+  end
+end
diff --git a/test/integration/email_support_and_replies_test.rb b/test/integration/email_support_and_replies_test.rb
new file mode 100644
index 0000000..b32cc41
--- /dev/null
+++ b/test/integration/email_support_and_replies_test.rb
@@ -0,0 +1,1028 @@
+require "test_helper"
+require "base64"
+require "mail"
+
+class EmailSupportAndRepliesTest < ActionDispatch::IntegrationTest
+  INGRESS_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  INGRESS_PASSWORD = "super-secret-inbound-password"
+
+  def account_headers(subdomain, token = nil)
+    headers = { "X-Helpdesk-Account" => subdomain }
+    headers["Authorization"] = "Bearer #{token}" if token.present?
+    headers
+  end
+
+  def relay_auth_header(username: "actionmailbox", password: INGRESS_PASSWORD)
+    "Basic #{Base64.strict_encode64("#{username}:#{password}")}"
+  end
+
+  def post_raw_inbound_email(raw_source, auth: relay_auth_header, content_type: "message/rfc822")
+    headers = { "Content-Type" => content_type }
+    headers["Authorization"] = auth if auth
+    post INGRESS_PATH, params: raw_source, headers: headers
+  end
+
+  def build_raw_email(
+    from: "Alice Customer <alice@customer.test>",
+    to: "acme@support.example.test",
+    cc: nil,
+    bcc: nil,
+    subject: "Need help with order",
+    body: "Hello team,\nMy order hasn't arrived yet.",
+    message_id: nil,
+    headers: {},
+    &block
+  )
+    mail = Mail.new do |m|
+      m.from from if from
+      m.to to if to
+      m.cc cc if cc
+      if bcc
+        m.bcc bcc
+        m[:bcc].include_in_headers = true if m[:bcc]
+      end
+      m.subject subject unless subject.nil?
+      m.message_id message_id if message_id
+      headers.each { |k, v| m[k] = v }
+      if block
+        block.call(m)
+      elsif !body.nil?
+        m.body body
+      end
+    end
+    mail.to_s
+  end
+
+  def extract_token_from_email(mail)
+    assert_not_nil mail, "Expected an email to have been delivered"
+    token = mail.body.decoded[/token=([A-Za-z0-9_-]+)/, 1]
+    assert token.present?, "Expected token in email body:\n#{mail.body.decoded}"
+    token
+  end
+
+  def create_verified_business(name: "Acme", subdomain: "acme", owner_name: "Jo Admin", owner_email: "jo@acme.test", password: "owner-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: {
+            name: owner_name,
+            email: owner_email,
+            password: password
+          }
+        }
+      },
+      as: :json
+    assert_response :created
+
+    token = extract_token_from_email(ActionMailer::Base.deliveries.last)
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: owner_email, password: password } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+    session_token = response.parsed_body.dig("session", "token")
+    ActionMailer::Base.deliveries.clear
+
+    [ Account.find_by!(subdomain: subdomain), session_token ]
+  end
+
+  test "relay ingress authentication and media type validation" do
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD, "HELPDESK_SUPPORT_DOMAIN" => nil) do
+      create_verified_business(subdomain: "acme")
+      raw = build_raw_email
+
+      # Missing auth -> 401
+      post_raw_inbound_email(raw, auth: nil)
+      assert_response :unauthorized
+      assert_equal 0, Ticket.count
+
+      # Wrong password -> 401
+      post_raw_inbound_email(raw, auth: relay_auth_header(password: "wrong-password"))
+      assert_response :unauthorized
+      assert_equal 0, Ticket.count
+
+      # Wrong username -> 401
+      post_raw_inbound_email(raw, auth: relay_auth_header(username: "wronguser"))
+      assert_response :unauthorized
+      assert_equal 0, Ticket.count
+
+      # Wrong Content-Type -> 415
+      post_raw_inbound_email(raw, content_type: "text/plain")
+      assert_response :unsupported_media_type
+      assert_equal 0, Ticket.count
+
+      # Valid RFC822 message -> 204 No Content and processed synchronously in test
+      post_raw_inbound_email(raw)
+      assert_response :no_content
+      assert_equal 1, Ticket.count
+    end
+  end
+
+  test "new customer emailing support opens ticket, stays unverified, gets verification email, and can later use portal" do
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD, "HELPDESK_SUPPORT_DOMAIN" => nil) do
+      acme, staff_token = create_verified_business(name: "Acme", subdomain: "acme")
+
+      raw = build_raw_email(
+        from: "Alice Wonderland <ALICE@Wonderland.Test>",
+        to: "Acme Support <ACME@Support.Example.Test>",
+        subject: "  Broken widget #42  ",
+        message_id: "<first-mail@wonderland.test>"
+      ) do |m|
+        m.text_part { body "Plain text explanation\nLine two" }
+        m.html_part { body "<h1>HTML explanation</h1><p>Should not use HTML</p>" }
+      end
+
+      assert_difference -> { acme.users.where(role: "customer").count } => 1,
+                        -> { acme.tickets.count } => 1,
+                        -> { acme.comments.count } => 1,
+                        -> { ActionMailer::Base.deliveries.size } => 1 do
+        post_raw_inbound_email(raw)
+      end
+      assert_response :no_content
+
+      customer = acme.users.find_by!(email: "alice@wonderland.test")
+      assert_equal "Alice Wonderland", customer.name
+      assert_equal "customer", customer.role
+      assert_equal false, customer.verified?
+      assert_nil customer.email_verified_at
+
+      # Verification email sent so customer can later use portal
+      verification_mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "alice@wonderland.test" ], verification_mail.to
+      assert_includes verification_mail.body.decoded, "/verify-email?account=acme&token="
+      verify_token = extract_token_from_email(verification_mail)
+
+      # Ticket and plain-text comment are visible to staff immediately
+      get "/api/v1/tickets", headers: account_headers("acme", staff_token)
+      assert_response :ok
+      assert_equal 1, response.parsed_body["count"]
+      ticket_json = response.parsed_body["tickets"].first
+      assert_equal "Broken widget #42", ticket_json["subject"]
+      assert_equal "open", ticket_json["status"]
+      assert_equal "normal", ticket_json["priority"]
+      assert_equal customer.id, ticket_json["requester_id"]
+      ticket_id = ticket_json["id"]
+
+      get "/api/v1/tickets/#{ticket_id}/comments", headers: account_headers("acme", staff_token)
+      assert_response :ok
+      assert_equal 1, response.parsed_body["count"]
+      comment_json = response.parsed_body["comments"].first
+      assert_equal "Plain text explanation\nLine two", comment_json["body"]
+      assert_equal true, comment_json["public"]
+      assert_equal customer.id, comment_json.dig("author", "id")
+
+      # Second email from same unverified customer reuses customer, keeps unverified, does NOT resend verification email
+      ActionMailer::Base.deliveries.clear
+      raw2 = build_raw_email(
+        from: "alice@wonderland.test",
+        to: "acme@support.example.test",
+        subject: "Second issue",
+        body: "Another question",
+        message_id: "<second-mail@wonderland.test>"
+      )
+      assert_difference -> { acme.users.count } => 0,
+                        -> { acme.tickets.count } => 1,
+                        -> { ActionMailer::Base.deliveries.size } => 0 do
+        post_raw_inbound_email(raw2)
+      end
+      assert_equal false, customer.reload.verified?
+
+      # Original verification link still works, allowing customer to verify, set password, and use portal!
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: verify_token } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+      assert_equal true, customer.reload.verified?
+
+      post "/api/v1/password_resets",
+        params: { password_reset: { email: "alice@wonderland.test" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+      reset_token = extract_token_from_email(ActionMailer::Base.deliveries.last)
+
+      post "/api/v1/password_resets/confirm",
+        params: { password_reset: { token: reset_token, password: "portal-password-123" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+
+      post "/api/v1/sessions",
+        params: { session: { email: "alice@wonderland.test", password: "portal-password-123" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :created
+      customer_session_token = response.parsed_body.dig("session", "token")
+
+      get "/api/v1/requests", headers: account_headers("acme", customer_session_token)
+      assert_response :ok
+      assert_equal 2, response.parsed_body["count"]
+    end
+  end
+
+  test "reuses existing portal customer without verifying unverified accounts or emailing verified accounts" do
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD, "HELPDESK_SUPPORT_DOMAIN" => nil) do
+      acme, _staff_token = create_verified_business(subdomain: "acme")
+
+      # Unverified portal-registered customer
+      post "/api/v1/registrations",
+        params: { user: { name: "Bob Unverified", email: "bob@customer.test", password: "bob-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :created
+      bob = acme.users.find_by!(email: "bob@customer.test")
+      ActionMailer::Base.deliveries.clear
+
+      assert_difference -> { acme.users.count } => 0,
+                        -> { acme.tickets.count } => 1,
+                        -> { ActionMailer::Base.deliveries.size } => 0 do
+        post_raw_inbound_email(
+          build_raw_email(from: "bob@customer.test", to: "acme@support.example.test", subject: "Help Bob", body: "Hi")
+        )
+      end
+      assert_equal false, bob.reload.verified?
+      assert bob.authenticate("bob-password")
+
+      # Verified portal customer
+      carol = acme.users.create!(
+        name: "Carol Verified",
+        email: "carol@customer.test",
+        password: "carol-password",
+        role: "customer",
+        verified: true
+      )
+      assert_difference -> { acme.users.count } => 0,
+                        -> { acme.tickets.count } => 1,
+                        -> { ActionMailer::Base.deliveries.size } => 0 do
+        post_raw_inbound_email(
+          build_raw_email(from: "carol@customer.test", to: "acme@support.example.test", subject: "Help Carol", body: "Hi Carol")
+        )
+      end
+      assert_equal true, carol.reload.verified?
+      assert_equal carol.id, acme.tickets.order(:id).last.requester_id
+    end
+  end
+
+  test "finds business from To or Cc and custom HELPDESK_SUPPORT_DOMAIN; ignores mail addressed to multiple businesses" do
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD, "HELPDESK_SUPPORT_DOMAIN" => "mail.helpdesk.test") do
+      acme, _acme_token = create_verified_business(name: "Acme", subdomain: "acme", owner_email: "jo@acme.test")
+      globex, _globex_token = create_verified_business(name: "Globex", subdomain: "globex", owner_email: "hank@globex.test")
+
+      # Wrong domain (default support.example.test when custom domain is configured) -> ignored
+      post_raw_inbound_email(
+        build_raw_email(to: "acme@support.example.test", subject: "Wrong domain", body: "Body")
+      )
+      assert_response :no_content
+      assert_equal 0, acme.tickets.count
+
+      # Business found via Cc alongside external To recipient
+      post_raw_inbound_email(
+        build_raw_email(
+          from: "dave@customer.test",
+          to: "colleague@customer.test",
+          cc: "Acme Help <acme@mail.helpdesk.test>",
+          subject: "CC support request",
+          body: "Looping in Acme support"
+        )
+      )
+      assert_response :no_content
+      assert_equal 1, acme.tickets.count
+      assert_equal "CC support request", acme.tickets.first.subject
+
+      ActionMailer::Base.deliveries.clear
+
+      # Addressed to multiple businesses (To + Cc) -> ignored completely
+      assert_no_difference [ -> { Ticket.count }, -> { User.count }, -> { ActionMailer::Base.deliveries.size } ] do
+        post_raw_inbound_email(
+          build_raw_email(
+            from: "brandnew@customer.test",
+            to: "acme@mail.helpdesk.test",
+            cc: "globex@mail.helpdesk.test",
+            subject: "Blast both businesses",
+            body: "Help from anyone?"
+          )
+        )
+      end
+      assert_response :no_content
+
+      # Addressed to multiple businesses both in To -> ignored completely
+      assert_no_difference [ -> { Ticket.count }, -> { User.count } ] do
+        post_raw_inbound_email(
+          build_raw_email(
+            from: "brandnew@customer.test",
+            to: "acme@mail.helpdesk.test, globex@mail.helpdesk.test",
+            subject: "Both in To",
+            body: "Help"
+          )
+        )
+      end
+
+      # Addressed to active business + another subdomain under support domain -> ignored
+      assert_no_difference -> { Ticket.count } do
+        post_raw_inbound_email(
+          build_raw_email(
+            from: "dave@customer.test",
+            to: "acme@mail.helpdesk.test",
+            cc: "otherbiz@mail.helpdesk.test",
+            subject: "Two support subdomains",
+            body: "Help"
+          )
+        )
+      end
+    end
+  end
+
+  test "staff public reply emails requester with private reply address; replies thread, authorize requester only, and reopen pending/solved tickets" do
+    with_env("RAILS_INBOUND_EMAIL_PASSWORD" => INGRESS_PASSWORD, "HELPDESK_SUPPORT_DOMAIN" => nil) do
+      acme, staff_token = create_verified_business(name: "Acme", subdomain: "acme")
+
+      # 1. Customer opens email-origin ticket
+      post_raw_inbound_email(
+        build_raw_email(
+          from: "Eve <eve@customer.test>",
+          to: "acme@support.example.test",
+          subject: "Login error",
+          body: "I get error 500 when logging in.",
+          message_id: "<eve-open-1@customer.test>"
+        )
+      )
+      assert_response :no_content
+      eve = acme.users.find_by!(email: "eve@customer.test")
+      ticket = acme.tickets.sole
+      ActionMailer::Base.deliveries.clear
+
+      # 2. Staff internal note (public: false) does NOT email requester
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { comment: { body: "Internal investigation note", public: false } } },
+          headers: account_headers("acme", staff_token),
+          as: :json
+      end
+      assert_response :ok
+
+      # 3. Staff status/priority change without comment does NOT email requester
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { priority: "high" } },
+          headers: account_headers("acme", staff_token),
+          as: :json
+      end
+      assert_response :ok
+
+      # 4. Staff public reply + status pending DOES email requester with private reply address at support domain
+      assert_difference -> { ActionMailer::Base.deliveries.size } => 1 do
+        patch "/api/v1/tickets/#{ticket.id}",
+          params: { ticket: { status: "pending", comment: { body: "Could you share a screenshot?" } } },
+          headers: account_headers("acme", staff_token),
+          as: :json
+      end
+      assert_response :ok
+      assert_equal "pending", ticket.reload.status
+
+      outbound = ActionMailer::Base.deliveries.last
+      assert_equal [ "eve@customer.test" ], outbound.to
+      assert_equal "Re: Login error", outbound.subject
+      assert_includes outbound.body.decoded, "Could you share a screenshot?"
+
+      reply_address = outbound.reply_to.first
+      assert reply_address.present?
+      assert_match(/@support\.example\.test\z/, reply_address)
+      assert_not_equal "acme@support.example.test", reply_address
+      assert_equal [ reply_address ], outbound.from
+
+      ActionMailer::Base.deliveries.clear
+
