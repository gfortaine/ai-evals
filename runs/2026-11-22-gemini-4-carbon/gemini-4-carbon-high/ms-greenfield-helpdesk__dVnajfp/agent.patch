+    assert_equal "high", source_json["priority"]
+    assert_equal support_id, source_json["group_id"]
+    assert_equal pat.id, source_json["assignee_id"]
+
+    assert_equal target_id, target_json["id"]
+    assert_equal "pending", target_json["status"]
+    assert_nil target_json["merged_into_id"]
+    assert_equal "normal", target_json["priority"]
+    assert_equal billing_id, target_json["group_id"]
+    assert_equal sam.id, target_json["assignee_id"]
+
+    # Target email identity is unchanged
+    target_after = Ticket.find(target_id)
+    assert_equal target_reply_token_before, target_after.reply_token
