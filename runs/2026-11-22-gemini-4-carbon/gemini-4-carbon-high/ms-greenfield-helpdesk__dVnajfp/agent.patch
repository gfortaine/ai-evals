+    server = TCPServer.new("127.0.0.1", 0)
+    port = server.addr[1]
+    server.close
+
+    test_db_url = ActiveRecord::Base.connection_db_config.configuration_hash.then do |cfg|
+      "postgresql:///#{cfg[:database]}?host=#{cfg[:host]}"
+    end
+
+    account = Account.create!(name: "Acme Live", subdomain: "acmelive")
+    admin = account.users.create!(name: "Jo", email: "jo@acmelive.test", password: "password", role: "admin", verified: true)
+    account.update!(owner: admin)
+    session = account.sessions.create!(user: admin)
+    raw_token = session.token
+
+    env = {
+      "RAILS_ENV" => "test",
+      "DATABASE_URL" => test_db_url,
+      "RAILS_INBOUND_EMAIL_PASSWORD" => "puma-relay-secret",
+      "HELPDESK_SUPPORT_DOMAIN" => "support.example.test"
+    }
+
+    pid = Process.spawn(
+      env,
+      "bundle", "exec", "puma", "-b", "tcp://127.0.0.1:#{port}", "-t", "1:1", "--quiet",
+      chdir: Rails.root.to_s,
+      out: File::NULL,
+      err: File::NULL
+    )
+
+    begin
+      # Wait for Puma to boot
+      ready = false
+      40.times do
+        res = Net::HTTP.get_response(URI("http://127.0.0.1:#{port}/up"))
+        if res.is_a?(Net::HTTPSuccess)
+          ready = true
+          break
+        end
+      rescue StandardError
+        sleep 0.1
+      end
+      assert ready, "Expected Puma test server to become ready"
+
+      relayer = ActionMailbox::Relayer.new(
+        url: "http://127.0.0.1:#{port}/rails/action_mailbox/relay/inbound_emails",
+        password: "puma-relay-secret"
+      )
+
+      raw_mail = Mail.new(
+        from: "Live Customer <live@customer.test>",
+        to: "acmelive@support.example.test",
+        subject: "Live relay ticket",
+        body: "Processed synchronously before HTTP 204 returns!"
+      ).to_s
+
+      result = relayer.relay(raw_mail)
+      assert result.success?, "Expected relayer success, got #{result.inspect}"
+
+      # Immediately query /api/v1/tickets with zero sleep — ticket must already exist!
+      req = Net::HTTP::Get.new("/api/v1/tickets")
+      req["X-Helpdesk-Account"] = "acmelive"
+      req["Authorization"] = "Bearer #{raw_token}"
+      http_res = Net::HTTP.start("127.0.0.1", port) { |http| http.request(req) }
+      assert_equal "200", http_res.code
+
+      parsed = JSON.parse(http_res.body)
+      assert_equal 1, parsed["count"]
+      assert_equal "Live relay ticket", parsed.dig("tickets", 0, "subject")
+    ensure
+      Process.kill("TERM", pid) rescue nil
+      Process.wait(pid) rescue nil
+    end
+  end
+end
