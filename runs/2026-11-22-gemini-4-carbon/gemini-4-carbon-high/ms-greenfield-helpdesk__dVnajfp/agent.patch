diff --git a/app/models/ticket.rb b/app/models/ticket.rb
new file mode 100644
index 0000000..a75fe39
--- /dev/null
+++ b/app/models/ticket.rb
@@ -0,0 +1,173 @@
+require "securerandom"
+
+class Ticket < ApplicationRecord
+  STATUSES = %w[open pending solved closed].freeze
+  EDITABLE_STATUSES = %w[open pending solved].freeze
+  PRIORITIES = %w[normal high].freeze
+
+  belongs_to :account
+  belongs_to :requester, class_name: "User"
+  belongs_to :assignee, class_name: "User", optional: true
+  belongs_to :group, optional: true
+  belongs_to :merged_into, class_name: "Ticket", optional: true
+
+  has_many :merged_sources, class_name: "Ticket", foreign_key: :merged_into_id, dependent: :nullify
+  has_many :inbound_email_deliveries, dependent: :delete_all
+  has_many :comments, dependent: :delete_all
+
+  normalizes :subject, with: ->(subject) { subject.to_s.strip }
+
+  before_validation :set_default_customer_updated_at, on: :create
+  before_validation :ensure_reply_token, on: :create
+
+  validates :subject, presence: true
+  validates :status, presence: true
+  validates :priority, presence: true, inclusion: { in: PRIORITIES }
+  validates :customer_updated_at, presence: true
+  validates :via_email, inclusion: { in: [ true, false ] }
+  validates :reply_token, presence: true, uniqueness: true
+  validate :status_inclusion_for_merge_state
+  validate :requester_belongs_to_account
+  validate :group_belongs_to_account
+  validate :assignee_is_active_staff_of_account
+  validate :assignee_belongs_to_group
+  validate :merged_into_valid
+
+  scope :recent_activity, -> { order(updated_at: :desc, id: :desc) }
+  scope :recent_customer_activity, -> { order(customer_updated_at: :desc, id: :desc) }
+  scope :matching_query, ->(query) {
+    return none if query.include?("\u0000")
+
+    pattern = "%#{sanitize_sql_like(query, "\\")}%"
+    where(
+      <<~SQL.squish,
+        tickets.subject ILIKE :pattern ESCAPE :escape
+        OR EXISTS (
+          SELECT 1
+          FROM comments
+          WHERE comments.ticket_id = tickets.id
+            AND comments.account_id = tickets.account_id
+            AND comments.public = TRUE
+            AND comments.body ILIKE :pattern ESCAPE :escape
+        )
+      SQL
+      pattern: pattern,
+      escape: "\\"
+    )
+  }
+
+  def closed?
+    status == "closed"
+  end
+
+  def reply_email
+    HelpdeskConfig.ticket_reply_email(account: account, reply_token: reply_token)
+  end
+
+  def request_json
+    {
+      id: id,
+      subject: subject,
+      status: status,
+      requester_id: requester_id,
+      merged_into_id: merged_into_id,
+      created_at: created_at,
+      updated_at: customer_updated_at
+    }
+  end
+
+  def ticket_json
+    {
+      id: id,
+      subject: subject,
+      status: status,
+      priority: priority,
+      requester_id: requester_id,
+      requester: {
+        id: requester.id,
+        name: requester.name,
+        email: requester.email
+      },
+      group_id: group_id,
+      group: group ? {
+        id: group.id,
+        name: group.name
+      } : nil,
+      assignee_id: assignee_id,
+      assignee: assignee ? {
+        id: assignee.id,
+        name: assignee.name
+      } : nil,
+      merged_into_id: merged_into_id,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  private
+
+  def set_default_customer_updated_at
+    self.customer_updated_at ||= updated_at || created_at || Time.current
+  end
+
+  def ensure_reply_token
+    return if reply_token.present?
+
+    loop do
+      candidate = SecureRandom.hex(20)
+      unless self.class.exists?(reply_token: candidate)
+        self.reply_token = candidate
+        break
+      end
+    end
+  end
+
+  def status_inclusion_for_merge_state
+    return if status.blank?
+
+    allowed = merged_into_id.present? ? [ "closed" ] : EDITABLE_STATUSES
+    errors.add(:status, :inclusion) unless allowed.include?(status)
+  end
+
+  def requester_belongs_to_account
+    return if account_id.nil? || requester.nil? || requester.account_id.nil?
+    return if requester.account_id == account_id
+
+    errors.add(:requester, :invalid)
+  end
+
+  def group_belongs_to_account
+    return if group_id.nil?
+    return if group.present? && group.account_id == account_id
+
+    errors.add(:group_id, :invalid)
+  end
+
+  def assignee_is_active_staff_of_account
+    return if assignee_id.nil?
+    return if assignee.present? && assignee.account_id == account_id && assignee.active_staff?
+
+    errors.add(:assignee_id, :invalid)
+  end
+
+  def assignee_belongs_to_group
+    return if assignee_id.nil? || group_id.nil?
+    return if errors[:assignee_id].any? || errors[:group_id].any?
+    return if GroupMembership.exists?(account_id: account_id, group_id: group_id, user_id: assignee_id)
+
+    errors.add(:assignee_id, "must belong to the ticket's group")
+  end
+
+  def merged_into_valid
+    return if merged_into_id.nil?
+
+    if id.present? && merged_into_id == id
+      errors.add(:merged_into_id, :invalid)
+      return
+    end
+
+    if merged_into.nil? || merged_into.account_id != account_id || merged_into.requester_id != requester_id
+      errors.add(:merged_into_id, :invalid)
+    end
+  end
+end
diff --git a/app/models/user.rb b/app/models/user.rb
new file mode 100644
index 0000000..aaab060
--- /dev/null
+++ b/app/models/user.rb
@@ -0,0 +1,135 @@
+class User < ApplicationRecord
+  ROLES = %w[admin agent customer].freeze
+  STAFF_ROLES = %w[admin agent].freeze
+
+  belongs_to :account
+
+  has_many :sessions, dependent: :delete_all
+  has_many :email_verification_tokens, dependent: :delete_all
+  has_many :password_reset_tokens, dependent: :delete_all
+  has_many :sent_invitations, class_name: "Invitation", foreign_key: :invited_by_id, dependent: :nullify
+  has_many :group_memberships, dependent: :delete_all
+  has_many :groups, through: :group_memberships
+  has_many :comments, foreign_key: :author_id, dependent: :delete_all
+  has_many :requested_tickets, class_name: "Ticket", foreign_key: :requester_id, dependent: :destroy
+  has_many :assigned_tickets, class_name: "Ticket", foreign_key: :assignee_id, dependent: :nullify
+
+  has_secure_password
+
+  normalizes :name, with: ->(name) { name.to_s.strip }
+  normalizes :email, with: ->(email) { email.to_s.strip.downcase }
+
+  validates :name, presence: true
+  validates :email,
+    presence: true,
+    format: { with: URI::MailTo::EMAIL_REGEXP, allow_blank: true },
+    uniqueness: { scope: :account_id, case_sensitive: false }
+  validates :role, presence: true, inclusion: { in: ROLES }
+  validates :suspended, inclusion: { in: [ true, false ] }
+
+  before_save :sync_email_verified_at
+
+  scope :by_id, -> { order(id: :asc) }
+  scope :active_staff, -> { where(role: STAFF_ROLES, suspended: false, verified: true) }
+
+  def owner?
+    account.present? && account.owner_id == id
+  end
+
+  def staff?
+    STAFF_ROLES.include?(role)
+  end
+
+  def admin?
+    role == "admin"
+  end
+
+  def agent?
+    role == "agent"
+  end
+
+  def customer?
+    role == "customer"
+  end
+
+  def active_staff?
+    staff? && !suspended? && verified?
+  end
+
+  def default_group
+    group_memberships.includes(:group).find_by(default: true)&.group
+  end
+
+  def issue_email_verification_token!
+    transaction do
+      email_verification_tokens.delete_all
+      email_verification_tokens.create!(
+        account: account,
+        expires_at: 24.hours.from_now
+      )
+    end
+  end
+
+  def issue_password_reset_token!
+    transaction do
+      password_reset_tokens.delete_all
+      password_reset_tokens.create!(
+        account: account,
+        expires_at: 2.hours.from_now
+      )
+    end
+  end
+
+  def verify_email!
+    transaction do
+      update!(verified: true)
+      email_verification_tokens.delete_all
+    end
+  end
+
+  def change_password!(new_password)
+    if new_password.nil? || new_password.to_s.empty?
+      errors.add(:password, :blank)
+      raise ActiveRecord::RecordInvalid, self
+    end
+
+    transaction do
+      self.password = new_password
+      save!
+      sessions.delete_all
+      password_reset_tokens.delete_all
+    end
+  end
+
+  def api_json
+    {
+      id: id,
+      name: name,
+      email: email,
+      role: role,
+      verified: verified,
+      suspended: suspended,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  def staff_json
+    {
+      id: id,
+      name: name,
+      email: email,
+      role: role
+    }
+  end
+
+  private
+
+  def sync_email_verified_at
+    if verified?
+      self.email_verified_at ||= Time.current
+    else
+      self.email_verified_at = nil
+    end
+  end
+end
