+module Api
+  module V1
+    class PasswordResetsController < BaseController
+      before_action :require_account!
+      before_action :ensure_account_active!
+
+      def create
+        pr_params = require_hash_param(:password_reset)
+        email = pr_params[:email].to_s.strip.downcase
+
+        if email.blank?
+          return render json: {
+            error: "Email can't be blank",
+            errors: { email: [ "can't be blank" ] }
+          }, status: :unprocessable_entity
+        end
+
+        user = current_account.users.find_by(email: email)
+        if user && !user.suspended?
+          token_record = user.issue_password_reset_token!
+          UserMailer.password_reset(user: user, token: token_record.token).deliver_now
+        end
+
+        render json: { status: "ok" }, status: :ok
+      end
+
+      def confirm
+        pr_params = require_hash_param(:password_reset)
+        raw_token = pr_params[:token].to_s.strip
+        new_password = pr_params[:password]
+
+        token_record = current_account.password_reset_tokens.includes(:user).find_by_raw_token(raw_token)
+        if token_record.nil? || token_record.expired? || token_record.user.account_id != current_account.id || token_record.user.suspended?
+          return render json: { error: "Invalid or expired password reset token" }, status: :unprocessable_entity
+        end
+
+        user = token_record.user
+        user.change_password!(new_password)
+
+        render json: { user: user.api_json }, status: :ok
+      end
+    end
+  end
+end
