+        },
+        headers: account_headers("acme", admin_token),
+        as: :json
+      assert_response :ok
+
+      patch "/api/v1/tickets/#{target_id}",
+        params: {
+          ticket: {
+            status: "pending",
+            group_id: billing_id,
+            assignee_id: sam.id,
+            priority: "normal"
+          }
+        },
+        headers: account_headers("acme", admin_token),
+        as: :json
+      assert_response :ok
+    end
+
+    target_before = Ticket.find(target_id)
+    target_reply_token_before = target_before.reply_token
+    target_via_email_before = target_before.via_email
+    target_customer_updated_before = target_before.customer_updated_at
+
+    # Agent merges source into target with default notes
+    travel_to Time.utc(2026, 11, 21, 10, 5, 0) do
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        post "/api/v1/tickets/#{source_id}/merge",
