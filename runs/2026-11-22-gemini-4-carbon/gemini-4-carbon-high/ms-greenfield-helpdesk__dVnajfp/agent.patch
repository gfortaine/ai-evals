+
+    post "/api/v1/group_memberships", params: { group_membership: { group_id: billing_id, user_id: sam.id } }, headers: account_headers("acme", admin_token), as: :json
+    assert_response :created
+    post "/api/v1/group_memberships", params: { group_membership: { group_id: support_id, user_id: pat.id } }, headers: account_headers("acme", admin_token), as: :json
+    assert_response :created
+
+    req_source = nil
+    req_target = nil
+    travel_to Time.utc(2026, 11, 21, 10, 0, 0) do
+      req_source = create_customer_request(subdomain: "acme", customer_token: avery_token, subject: "Duplicate billing issue", body: "First duplicate message.")
+    end
+    travel_to Time.utc(2026, 11, 21, 10, 1, 0) do
+      req_target = create_customer_request(subdomain: "acme", customer_token: avery_token, subject: "Main billing issue", body: "Detailed description here.")
+    end
+
+    source_id = req_source["id"]
+    target_id = req_target["id"]
+
+    # Unmerged records include merged_into_id: nil in both customer and staff views
+    assert req_source.key?("merged_into_id")
+    assert_nil req_source["merged_into_id"]
+    assert req_target.key?("merged_into_id")
+    assert_nil req_target["merged_into_id"]
+
+    get "/api/v1/requests", headers: account_headers("acme", avery_token)
+    assert_response :ok
+    assert_equal [ nil, nil ], response.parsed_body.fetch("requests").map { |r| r.fetch("merged_into_id") }
+
+    get "/api/v1/tickets", headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal [ nil, nil ], response.parsed_body.fetch("tickets").map { |t| t.fetch("merged_into_id") }
+
+    # Set distinct statuses, assignments, priorities, and an extra comment on source before merging
+    travel_to Time.utc(2026, 11, 21, 10, 2, 0) do
+      patch "/api/v1/tickets/#{source_id}",
+        params: {
+          ticket: {
+            group_id: support_id,
+            assignee_id: pat.id,
+            priority: "high",
+            comment: { body: "Second comment on duplicate.", public: true }
