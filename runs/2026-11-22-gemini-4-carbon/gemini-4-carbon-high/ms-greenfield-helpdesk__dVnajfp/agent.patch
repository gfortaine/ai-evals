+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { priority: "normal" } },
+      headers: account_headers("acme", avery_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    travel_to Time.utc(2026, 11, 21, 10, 10, 0) do
+      patch "/api/v1/requests/#{ticket_id}",
+        params: { request: { priority: "normal", comment: { body: "Any update?" } } },
+        headers: account_headers("acme", avery_token),
+        as: :json
+      assert_response :ok
+      assert_not response.parsed_body.fetch("request").key?("priority")
+    end
+
+    get "/api/v1/tickets/#{ticket_id}", headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal "high", response.parsed_body.dig("ticket", "priority")
+
+    # Admin resets priority back to normal via PUT alongside assignment and status update
+    travel_to Time.utc(2026, 11, 21, 10, 15, 0) do
+      put "/api/v1/tickets/#{ticket_id}",
+        params: {
+          ticket: {
+            priority: "normal",
+            assignee_id: agent.id,
+            status: "pending",
+            comment: { body: "Sent receipt by email." }
+          }
+        },
+        headers: account_headers("acme", admin_token),
+        as: :json
+      assert_response :ok
+      updated = response.parsed_body.fetch("ticket")
+      assert_equal "normal", updated["priority"]
+      assert_equal "pending", updated["status"]
+      assert_equal agent.id, updated["assignee_id"]
+    end
+  end
+
+  test "staff combined inbox filters, literal case-insensitive search on subjects and public comments, deduplication, and pagination" do
+    acme, admin_token = create_verified_business(subdomain: "acme")
+    sam, sam_token = invite_and_login_staff(subdomain: "acme", admin_token: admin_token, name: "Sam Agent", email: "sam@acme.test")
+    pat, _pat_token = invite_and_login_staff(subdomain: "acme", admin_token: admin_token, name: "Pat Agent", email: "pat@acme.test")
+    avery, avery_token = register_and_verify_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    blair, blair_token = register_and_verify_customer(subdomain: "acme", name: "Blair", email: "blair@example.test")
+    casey, _casey_token = register_and_verify_customer(subdomain: "acme", name: "Casey", email: "casey@example.test")
+
+    # Ticket 1: Avery, open, unassigned, high priority, matches "receipt" in BOTH subject AND multiple public comments (must deduplicate!)
+    post "/api/v1/requests",
+      params: { request: { subject: "Missing RECEIPT for October", comment: { body: "First receipt comment." } } },
+      headers: account_headers("acme", avery_token),
+      as: :json
+    t1_id = response.parsed_body.dig("request", "id")
+    patch "/api/v1/requests/#{t1_id}",
+      params: { request: { comment: { body: "Second RECEIPT follow-up comment." } } },
+      headers: account_headers("acme", avery_token),
+      as: :json
+    assert_response :ok
+    patch "/api/v1/tickets/#{t1_id}",
+      params: { ticket: { priority: "high" } },
+      headers: account_headers("acme", admin_token),
+      as: :json
+    assert_response :ok
+
+    # Ticket 2: Blair, open, unassigned, high priority, matches "receipt" ONLY in later public reply
+    travel 1.minute do
+      post "/api/v1/requests",
+        params: { request: { subject: "Billing question", comment: { body: "Need an invoice copy." } } },
+        headers: account_headers("acme", blair_token),
+        as: :json
+    end
+    t2_id = response.parsed_body.dig("request", "id")
+    travel 2.minutes do
+      patch "/api/v1/tickets/#{t2_id}",
+        params: {
+          ticket: {
+            priority: "high",
+            comment: { body: "We attached your Receipt here.", public: true }
+          }
+        },
+        headers: account_headers("acme", sam_token),
+        as: :json
+      assert_response :ok
+    end
+
+    # Ticket 3: Avery, open, unassigned, high priority, mentions "receipt" ONLY in PRIVATE note (must NOT match q=receipt!)
+    travel 3.minutes do
+      post "/api/v1/requests",
+        params: { request: { subject: "Account login slow", comment: { body: "Page takes 5s to load." } } },
+        headers: account_headers("acme", avery_token),
+        as: :json
+    end
+    t3_id = response.parsed_body.dig("request", "id")
+    travel 4.minutes do
+      patch "/api/v1/tickets/#{t3_id}",
+        params: {
+          ticket: {
+            priority: "high",
+            comment: { body: "Internal note: also check receipt service.", public: false }
+          }
+        },
+        headers: account_headers("acme", admin_token),
+        as: :json
+      assert_response :ok
+    end
+
+    # Ticket 4: Avery, open, ASSIGNED to Sam, high priority, mentions "receipt"
+    travel 5.minutes do
+      post "/api/v1/requests",
+        params: { request: { subject: "Duplicate receipt email", comment: { body: "Got two copies." } } },
+        headers: account_headers("acme", avery_token),
+        as: :json
+    end
+    t4_id = response.parsed_body.dig("request", "id")
+    travel 6.minutes do
+      patch "/api/v1/tickets/#{t4_id}",
+        params: { ticket: { priority: "high", assignee_id: sam.id } },
+        headers: account_headers("acme", sam_token),
+        as: :json
+      assert_response :ok
+    end
+
+    # Ticket 5: Avery, pending, unassigned, normal priority, literal wildcard/regex/FTS special chars
+    travel 7.minutes do
+      post "/api/v1/requests",
+        params: {
+          request: {
+            subject: "Promo 100% discount code order_1 [urgent] (a|b)",
+            comment: { body: "Path C:\\temp\\inv_1 & 'quote' !op failed." }
+          }
+        },
+        headers: account_headers("acme", avery_token),
+        as: :json
+    end
+    t5_id = response.parsed_body.dig("request", "id")
+    travel 8.minutes do
+      patch "/api/v1/tickets/#{t5_id}",
+        params: { ticket: { status: "pending" } },
+        headers: account_headers("acme", admin_token),
+        as: :json
+      assert_response :ok
+    end
+
+    # Ticket 6: Blair, solved, assigned to Sam, normal priority
+    travel 9.minutes do
+      post "/api/v1/requests",
+        params: { request: { subject: "Export CSV", comment: { body: "How to export?" } } },
+        headers: account_headers("acme", blair_token),
+        as: :json
+    end
+    t6_id = response.parsed_body.dig("request", "id")
+    travel 10.minutes do
+      patch "/api/v1/tickets/#{t6_id}",
+        params: { ticket: { status: "solved", assignee_id: sam.id } },
+        headers: account_headers("acme", sam_token),
+        as: :json
+      assert_response :ok
+    end
+
+    # Exact combined query from prompt:
+    # GET /api/v1/tickets?status=open&assignee_id=unassigned&priority=high&q=receipt
+    get "/api/v1/tickets?status=open&assignee_id=unassigned&priority=high&q=receipt",
+      headers: account_headers("acme", sam_token)
+    assert_response :ok
+    assert_equal [ t2_id, t1_id ], response.parsed_body.fetch("tickets").map { |t| t["id"] }
+    assert_equal 2, response.parsed_body["count"]
+
+    # Pagination over filtered + searched query (verifies count and deduplication when T1 has 3 matches)
+    get "/api/v1/tickets",
+      params: { status: "open", assignee_id: "unassigned", priority: "high", q: "receipt", page: 1, per_page: 1 },
+      headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal [ t2_id ], response.parsed_body.fetch("tickets").map { |t| t["id"] }
+    assert_equal 2, response.parsed_body["count"]
+    assert_equal 2, response.parsed_body["next_page"]
+    assert_nil response.parsed_body["previous_page"]
+
+    get "/api/v1/tickets",
+      params: { status: "open", assignee_id: "unassigned", priority: "high", q: "receipt", page: 2, per_page: 1 },
+      headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal [ t1_id ], response.parsed_body.fetch("tickets").map { |t| t["id"] }
+    assert_equal 2, response.parsed_body["count"]
+    assert_nil response.parsed_body["next_page"]
+    assert_equal 1, response.parsed_body["previous_page"]
+
+    # Combine all 5 filters (status + assignee_id + requester_id + priority + q)
+    get "/api/v1/tickets",
+      params: { status: "open", assignee_id: sam.id, requester_id: avery.id, priority: "high", q: "RECEIPT" },
+      headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal [ t4_id ], response.parsed_body.fetch("tickets").map { |t| t["id"] }
+
+    # Individual filters
+    get "/api/v1/tickets", params: { priority: "normal" }, headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal [ t6_id, t5_id ], response.parsed_body.fetch("tickets").map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { priority: "high" }, headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal [ t4_id, t3_id, t2_id, t1_id ], response.parsed_body.fetch("tickets").map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { status: "solved" }, headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal [ t6_id ], response.parsed_body.fetch("tickets").map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { assignee_id: sam.id }, headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal [ t6_id, t4_id ], response.parsed_body.fetch("tickets").map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { assignee_id: pat.id }, headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal [], response.parsed_body.fetch("tickets")
+    assert_equal 0, response.parsed_body["count"]
+
+    get "/api/v1/tickets", params: { requester_id: blair.id }, headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal [ t6_id, t2_id ], response.parsed_body.fetch("tickets").map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { requester_id: casey.id }, headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal [], response.parsed_body.fetch("tickets")
+
+    get "/api/v1/tickets", params: { assignee_id: 999_999 }, headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal [], response.parsed_body.fetch("tickets")
+
+    get "/api/v1/tickets", params: { requester_id: 999_999 }, headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal [], response.parsed_body.fetch("tickets")
+
+    # Empty / blank filter values act as no-op
+    get "/api/v1/tickets",
+      params: { status: "", priority: "", assignee_id: "", requester_id: "", q: "   " },
+      headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal 6, response.parsed_body["count"]
+
+    # Literal text search: %, _, \, regex metacharacters, quotes, FTS operators, NUL byte
+    [
+      [ "100%", [ t5_id ] ],
+      [ "%", [ t5_id ] ],
+      [ "order_1", [ t5_id ] ],
+      [ "orderX1", [] ],
+      [ "___", [] ],
+      [ "C:\\temp\\", [ t5_id ] ],
+      [ "\\", [ t5_id ] ],
+      [ "[urgent] (a|b)", [ t5_id ] ],
+      [ "& 'quote' !op", [ t5_id ] ],
+      [ "foo\u0000bar", [] ]
+    ].each do |literal_q, expected_ids|
+      get "/api/v1/tickets", params: { q: literal_q }, headers: account_headers("acme", admin_token)
+      assert_response :ok, "Expected 200 OK for q=#{literal_q.inspect}"
+      assert_equal expected_ids, response.parsed_body.fetch("tickets").map { |t| t["id"] }, "Mismatch for q=#{literal_q.inspect}"
+    end
+
+    # Invalid / malformed filter values return 422
+    [
+      { status: "archived" },
+      { "status[]" => "open" },
+      { priority: "urgent" },
+      { "priority[]" => "high" },
+      { assignee_id: "nobody" },
+      { assignee_id: "-1" },
+      { assignee_id: "99999999999999999999999999" },
+      { "assignee_id[]" => sam.id },
+      { requester_id: "unassigned" },
+      { requester_id: "invalid" },
+      { requester_id: "-5" },
+      { requester_id: "99999999999999999999999999" },
+      { "requester_id[]" => avery.id },
+      { "q[]" => "receipt" }
+    ].each do |bad_params|
+      get "/api/v1/tickets", params: bad_params, headers: account_headers("acme", admin_token)
+      assert_response :unprocessable_entity, "Expected 422 for #{bad_params.inspect}"
+    end
+
+    # Multiple invalid filters report all errors
+    get "/api/v1/tickets",
+      params: { status: "bad", priority: "bad", assignee_id: "bad", requester_id: "bad" },
+      headers: account_headers("acme", admin_token)
+    assert_response :unprocessable_entity
+    errs = response.parsed_body.fetch("errors")
+    assert errs.key?("status")
+    assert errs.key?("priority")
+    assert errs.key?("assignee_id")
+    assert errs.key?("requester_id")
+
+    # Cross-tenant isolation on filters and search
+    _globex, globex_admin_token = create_verified_business(subdomain: "globex", owner_email: "jo@globex.test")
+    _globex_cust, globex_cust_token = register_and_verify_customer(subdomain: "globex", name: "Dana", email: "dana@example.test")
+
+    post "/api/v1/requests",
+      params: { request: { subject: "Globex receipt issue", comment: { body: "Globex receipt body" } } },
+      headers: account_headers("globex", globex_cust_token),
+      as: :json
+    assert_response :created
+    globex_t_id = response.parsed_body.dig("request", "id")
+    patch "/api/v1/tickets/#{globex_t_id}",
+      params: { ticket: { priority: "high" } },
+      headers: account_headers("globex", globex_admin_token),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/tickets",
+      params: { status: "open", assignee_id: "unassigned", priority: "high", q: "receipt" },
+      headers: account_headers("globex", globex_admin_token)
+    assert_response :ok
+    assert_equal [ globex_t_id ], response.parsed_body.fetch("tickets").map { |t| t["id"] }
+
+    get "/api/v1/tickets",
+      params: { requester_id: avery.id },
+      headers: account_headers("globex", globex_admin_token)
+    assert_response :ok
+    assert_equal [], response.parsed_body.fetch("tickets")
+
+    # Customer request status filter isolation, pagination, and validation
+    get "/api/v1/requests", params: { status: "open" }, headers: account_headers("acme", avery_token)
+    assert_response :ok
+    assert_equal [ t4_id, t3_id, t1_id ], response.parsed_body.fetch("requests").map { |r| r["id"] }
+    assert_equal 3, response.parsed_body["count"]
+
+    get "/api/v1/requests", params: { status: "open", page: 1, per_page: 2 }, headers: account_headers("acme", avery_token)
+    assert_response :ok
+    assert_equal [ t4_id, t3_id ], response.parsed_body.fetch("requests").map { |r| r["id"] }
+    assert_equal 3, response.parsed_body["count"]
+    assert_equal 2, response.parsed_body["next_page"]
+
+    get "/api/v1/requests", params: { status: "pending" }, headers: account_headers("acme", avery_token)
+    assert_response :ok
+    assert_equal [ t5_id ], response.parsed_body.fetch("requests").map { |r| r["id"] }
+
+    get "/api/v1/requests", params: { status: "solved" }, headers: account_headers("acme", avery_token)
+    assert_response :ok
+    assert_equal [], response.parsed_body.fetch("requests")
+
+    get "/api/v1/requests", params: { status: "solved" }, headers: account_headers("acme", blair_token)
+    assert_response :ok
+    assert_equal [ t6_id ], response.parsed_body.fetch("requests").map { |r| r["id"] }
+
+    get "/api/v1/requests", params: { status: "" }, headers: account_headers("acme", blair_token)
+    assert_response :ok
+    assert_equal [ t6_id, t2_id ], response.parsed_body.fetch("requests").map { |r| r["id"] }
+
+    get "/api/v1/requests", params: { status: "invalid" }, headers: account_headers("acme", avery_token)
+    assert_response :unprocessable_entity
+    assert_equal [ "Status is not included in the list" ], response.parsed_body.dig("errors", "status")
+
+    get "/api/v1/requests", params: { "status[]" => "open" }, headers: account_headers("acme", avery_token)
+    assert_response :unprocessable_entity
+
+    # Customer cannot use requester_id param to view another customer's requests
+    get "/api/v1/requests", params: { status: "solved", requester_id: blair.id }, headers: account_headers("acme", avery_token)
+    assert_response :ok
+    assert_equal [], response.parsed_body.fetch("requests")
+
+    # Cancelled account blocks filtered endpoints too
+    post "/api/v1/account/cancel", headers: account_headers("acme", admin_token), as: :json
+    assert_response :ok
+    acme.reload
+    avery_session = acme.sessions.create!(user: avery)
+    admin_session = acme.sessions.create!(user: acme.owner)
+
+    get "/api/v1/tickets", params: { priority: "high" }, headers: account_headers("acme", admin_session.token)
+    assert_response :forbidden
+
+    get "/api/v1/requests", params: { status: "open" }, headers: account_headers("acme", avery_session.token)
+    assert_response :forbidden
+  end
+end
