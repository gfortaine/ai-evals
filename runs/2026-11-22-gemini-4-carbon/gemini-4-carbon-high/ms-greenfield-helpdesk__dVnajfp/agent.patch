+      ActionMailer::Base.deliveries.clear
+
+      travel 2.minutes do
+        assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+          post "/api/v1/tickets/#{t_source2.id}/merge",
+            params: {
+              merge: {
+                target_id: t_target.id.to_s,
+                source_comment: { body: "Internal source note" },
+                target_comment: { body: "Merged #{t_source2.id} publicly.", public: true }
+              }
+            },
+            headers: account_headers("acme", admin_token),
+            as: :json
+        end
+        assert_response :ok
+        assert_equal "solved", response.parsed_body.dig("target", "status")
+      end
+
+      # Customer sees public source_comment on t_source, does NOT see private source_comment on t_source2,
+      # and sees public target_comment (but NOT private target_comment) on t_target
+      get "/api/v1/requests/#{t_source.id}/comments", headers: account_headers("acme", alice_token)
+      assert_response :ok
+      assert_equal [ "Where is order 100?", "Continuing in ticket #{t_target.id}." ],
+        response.parsed_body.fetch("comments").map { |c| c["body"] }
