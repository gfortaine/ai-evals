+    b1 = create_customer_request(subdomain: "acme", customer_token: blair_token, subject: "Blair 1", body: "BB1")
+    g1 = create_customer_request(subdomain: "globex", customer_token: dana_token, subject: "Globex 1", body: "GB1")
+
+    # Auth & role checks
+    post "/api/v1/tickets/#{a1['id']}/merge", params: { merge: { target_id: a2["id"] } }, as: :json
+    assert_response :bad_request
+
+    post "/api/v1/tickets/#{a1['id']}/merge", params: { merge: { target_id: a2["id"] } }, headers: account_headers("acme"), as: :json
+    assert_response :unauthorized
+
+    post "/api/v1/tickets/#{a1['id']}/merge", params: { merge: { target_id: a2["id"] } }, headers: account_headers("acme", avery_token), as: :json
+    assert_response :forbidden
+
+    # Not found / cross-tenant source
+    post "/api/v1/tickets/999999/merge", params: { merge: { target_id: a2["id"] } }, headers: account_headers("acme", admin_token), as: :json
+    assert_response :not_found
+
+    post "/api/v1/tickets/#{g1['id']}/merge", params: { merge: { target_id: a2["id"] } }, headers: account_headers("acme", admin_token), as: :json
+    assert_response :not_found
+
+    # Staff & customer cannot set status: "closed" directly via PATCH
+    patch "/api/v1/tickets/#{a1['id']}", params: { ticket: { status: "closed" } }, headers: account_headers("acme", admin_token), as: :json
+    assert_response :unprocessable_entity
+
+    patch "/api/v1/requests/#{a1['id']}", params: { request: { status: "closed" } }, headers: account_headers("acme", avery_token), as: :json
+    assert_response :unprocessable_entity
+
+    # Invalid merge envelopes, target_ids, different customer, cross-tenant target, self-merge, invalid notes
+    [
+      {},
+      { merge: "bad" },
+      { merge: {} },
+      { merge: { target_id: nil } },
+      { merge: { target_id: "" } },
+      { merge: { target_id: "abc" } },
+      { merge: { target_id: -1 } },
+      { merge: { target_id: 999_999 } },
+      { merge: { target_id: g1["id"] } },
+      { merge: { target_id: a1["id"] } },
+      { merge: { target_id: b1["id"] } },
+      { merge: { target_id: a2["id"], source_comment: "bad" } },
+      { merge: { target_id: a2["id"], target_comment: nil } },
+      { merge: { target_id: a2["id"], source_comment: { body: "   " } } },
+      { merge: { target_id: a2["id"], target_comment: { body: "" } } },
+      { merge: { target_id: a2["id"], source_comment: { body: "ok", public: "maybe" } } },
+      { merge: { target_id: a2["id"], target_comment: { body: "ok", public: 123 } } }
+    ].each do |bad_payload|
+      assert_no_difference -> { Comment.count } do
+        post "/api/v1/tickets/#{a1['id']}/merge",
+          params: bad_payload,
+          headers: account_headers("acme", admin_token),
+          as: :json
+      end
+      assert_response :unprocessable_entity, "Expected 422 for #{bad_payload.inspect}"
+      assert_equal "open", Ticket.find(a1["id"]).status
+      assert_nil Ticket.find(a1["id"]).merged_into_id
+    end
+
+    # Valid merge with source_comment: { public: true } (omitting body uses default text publicly)
+    post "/api/v1/tickets/#{a1['id']}/merge",
+      params: { merge: { target_id: a2["id"], source_comment: { public: true } } },
+      headers: account_headers("acme", admin_token),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/requests/#{a1['id']}/comments", headers: account_headers("acme", avery_token)
+    assert_equal 2, response.parsed_body["count"]
+
+    # Cannot merge already-closed source or merge into already-closed target
+    a3 = create_customer_request(subdomain: "acme", customer_token: avery_token, subject: "Avery 3", body: "B3")
+
+    post "/api/v1/tickets/#{a1['id']}/merge", params: { merge: { target_id: a3["id"] } }, headers: account_headers("acme", admin_token), as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/tickets/#{a3['id']}/merge", params: { merge: { target_id: a1["id"] } }, headers: account_headers("acme", admin_token), as: :json
+    assert_response :unprocessable_entity
+
+    # Portal-created target does not inherit via_email from email-created source
+    t_email_src = acme.tickets.create!(
+      requester_id: a3["requester_id"],
+      subject: "Email dup",
+      status: "open",
+      via_email: true
+    )
+    t_email_src.comments.create!(account: acme, author_id: a3["requester_id"], body: "Email body", public: true)
+
+    post "/api/v1/tickets/#{t_email_src.id}/merge",
+      params: { merge: { target_id: a3["id"] } },
+      headers: account_headers("acme", admin_token),
+      as: :json
+    assert_response :ok
+    assert_equal false, Ticket.find(a3["id"]).via_email
+
+    # Cancelled account rejects merge, and expired purge deletes merged & target tickets cleanly
+    post "/api/v1/account/cancel", headers: account_headers("acme", admin_token), as: :json
+    assert_response :ok
+
+    acme.update!(cancelled_at: 91.days.ago)
+    assert_equal 1, Account.purge_expired_cancelled_accounts!
+    assert_equal 0, Ticket.where(account_id: acme.id).count
+    assert Account.exists?(globex.id)
+  end
+
+test "search matching_query respects merge note privacy, NUL byte bodies fail cleanly, and customer destroy cascades cleanly" do
+  acme, admin_token = create_verified_business(subdomain: "acme")
+  avery, avery_token = register_and_verify_customer(subdomain: "acme", name: "Avery", email: "avery@customer.test")
+
+  t1 = create_customer_request(subdomain: "acme", customer_token: avery_token, subject: "Alpha issue", body: "Alpha initial")
+  t2 = create_customer_request(subdomain: "acme", customer_token: avery_token, subject: "Beta issue", body: "Beta initial")
+
+  # NUL-only body in merge note returns 422 instead of 500
+  post "/api/v1/tickets/#{t1['id']}/merge",
+    params: { merge: { target_id: t2["id"], source_comment: { body: "\u0000" } } },
+    headers: account_headers("acme", admin_token),
+    as: :json
+  assert_response :unprocessable_entity
+
+  # Merge with public source note ("PUBLICTOKEN123") and private target note ("PRIVATETOKEN456")
+  post "/api/v1/tickets/#{t1['id']}/merge",
+    params: {
+      merge: {
+        target_id: t2["id"],
+        source_comment: { body: "Follow PUBLICTOKEN123", public: true },
+        target_comment: { body: "Internal PRIVATETOKEN456", public: false }
+      }
+    },
+    headers: account_headers("acme", admin_token),
+    as: :json
+  assert_response :ok
+
+  # Public merge note is searchable; private merge note is NOT matched by q
+  get "/api/v1/tickets", params: { status: "closed", q: "PUBLICTOKEN123" }, headers: account_headers("acme", admin_token)
+  assert_response :ok
+  assert_equal [ t1["id"] ], response.parsed_body.fetch("tickets").map { |t| t["id"] }
+
+  get "/api/v1/tickets", params: { q: "PRIVATETOKEN456" }, headers: account_headers("acme", admin_token)
+  assert_response :ok
+  assert_equal [], response.parsed_body.fetch("tickets")
+
+  # Destroying requester cascades cleanly even when target ticket is destroyed before/after source ticket
+  assert_nothing_raised do
+    avery.destroy!
+  end
+  assert_equal 0, acme.tickets.count
+end
+end
