+      def merge
+        merge_attrs = require_hash_param(:merge)
+
+        source = nil
+        target = nil
+
+        current_account.with_lock do
+          source = current_account.tickets.includes(:requester, :assignee, :group).find(@ticket.id)
+
+          if source.closed?
+            return render json: {
+              error: "Closed ticket cannot be merged",
+              errors: { status: [ "Closed ticket cannot be merged" ] }
+            }, status: :unprocessable_entity
+          end
+
+          combined_errors = {}
+          all_messages = []
+
+          raw_target_id = merge_attrs[:target_id]
+          parsed_target_id = parse_non_negative_bigint(raw_target_id)
+
+          if raw_target_id.nil? || (raw_target_id.is_a?(String) && raw_target_id.strip.empty?)
+            msg = "Target can't be blank"
+            combined_errors[:target_id] = [ msg ]
+            all_messages << msg
+          elsif parsed_target_id.nil?
+            msg = "Target is invalid"
+            combined_errors[:target_id] = [ msg ]
+            all_messages << msg
+          elsif parsed_target_id == source.id
+            msg = "Target cannot be the same ticket"
+            combined_errors[:target_id] = [ msg ]
+            all_messages << msg
+          else
+            candidate = current_account.tickets.includes(:requester, :assignee, :group).find_by(id: parsed_target_id)
+            if candidate.nil?
+              msg = "Target is invalid"
+              combined_errors[:target_id] = [ msg ]
+              all_messages << msg
+            elsif candidate.requester_id != source.requester_id
+              msg = "Target must belong to the same customer"
+              combined_errors[:target_id] = [ msg ]
+              all_messages << msg
+            elsif candidate.closed?
+              msg = "Target ticket is closed"
+              combined_errors[:target_id] = [ msg ]
+              all_messages << msg
+            else
+              target = candidate
+            end
+          end
+
+          source_comment = build_merge_comment(
+            merge_attrs: merge_attrs,
+            key: :source_comment,
+            ticket: source,
+            default_body: "Merged into ticket ##{target&.id || parsed_target_id}.",
+            combined_errors: combined_errors,
+            all_messages: all_messages
+          )
+
+          target_comment = build_merge_comment(
+            merge_attrs: merge_attrs,
+            key: :target_comment,
+            ticket: target || source,
+            default_body: "Ticket ##{source.id} was merged into this ticket.",
+            combined_errors: combined_errors,
+            all_messages: all_messages
+          )
+
+          if combined_errors.any?
+            return render json: {
+              error: all_messages.to_sentence,
+              errors: combined_errors
+            }, status: :unprocessable_entity
+          end
+
+          now = Time.current
+
+          source_comment.created_at = now
+          source_comment.updated_at = now
+          source_comment.save!
+
+          target_comment.created_at = now
+          target_comment.updated_at = now
+          target_comment.save!
+
+          source.status = "closed"
+          source.merged_into = target
+          source.updated_at = now
+          source.customer_updated_at = now
+          source.save!
+
+          target.updated_at = now
+          target.customer_updated_at = now if target_comment.public?
+          target.save!
+        end
+
+        render json: {
+          source: source.ticket_json,
+          target: target.ticket_json
+        }, status: :ok
+      end
+
       private
 
       def set_ticket
         @ticket = current_account.tickets.includes(:requester, :assignee, :group).find(params[:id])
       end
+
+      def build_merge_comment(merge_attrs:, key:, ticket:, default_body:, combined_errors:, all_messages:)
+        label = key.to_s.humanize
+        if merge_attrs.key?(key)
+          comment_attrs = merge_attrs[key]
+          unless comment_attrs.is_a?(ActionController::Parameters) || comment_attrs.is_a?(Hash)
+            msg = "#{label} is invalid"
+            combined_errors[key] = [ msg ]
+            all_messages << msg
+            return nil
+          end
+
+          public_value = if comment_attrs.key?(:public)
+            case comment_attrs[:public]
+            when true, "true" then true
+            when false, "false" then false
+            else nil
+            end
+          else
+            false
+          end
+
+          body_value = if comment_attrs.key?(:body)
+            raw_body = comment_attrs[:body]
+            raw_body.is_a?(String) ? raw_body : nil
+          else
+            default_body
+          end
+
+          comment = Comment.new(
+            account: current_account,
+            ticket: ticket,
+            author: current_user,
+            body: body_value,
+            public: public_value
+          )
+        else
+          comment = Comment.new(
+            account: current_account,
+            ticket: ticket,
+            author: current_user,
+            body: default_body,
+            public: false
+          )
+        end
+
+        unless comment.valid?
+          comment.errors.to_hash(true).each do |field, messages|
+            combined_errors[:"#{key}.#{field}"] = messages
+          end
+          all_messages.concat(comment.errors.full_messages)
+        end
+
+        comment
+      end
     end
   end
 end
