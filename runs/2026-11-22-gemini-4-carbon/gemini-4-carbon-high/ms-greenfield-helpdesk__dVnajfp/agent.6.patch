+  test "combined 6-way inbox filters, multi-user group deletion default promotion, atomic rollbacks, and customer replies" do
+    acme, admin_token = create_verified_business(subdomain: "acme")
+    jo = acme.owner
+    sam, sam_token = invite_and_login_staff(subdomain: "acme", admin_token: admin_token, name: "Sam", email: "sam@acme.test")
+    pat, _pat_token = invite_and_login_staff(subdomain: "acme", admin_token: admin_token, name: "Pat", email: "pat@acme.test")
+    avery, avery_token = register_and_verify_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    post "/api/v1/groups", params: { group: { name: "G1" } }, headers: account_headers("acme", admin_token), as: :json
+    g1_id = response.parsed_body.dig("group", "id")
+    post "/api/v1/groups", params: { group: { name: "G2" } }, headers: account_headers("acme", admin_token), as: :json
+    g2_id = response.parsed_body.dig("group", "id")
+    post "/api/v1/groups", params: { group: { name: "G3" } }, headers: account_headers("acme", admin_token), as: :json
+    g3_id = response.parsed_body.dig("group", "id")
+
+    # Sam: G1 (default), G2, G3
+    # Pat: G1 (default), G3
+    # Jo:  G2 (default), G1 (non-default)
+    post "/api/v1/group_memberships", params: { group_membership: { group_id: g1_id, user_id: sam.id } }, headers: account_headers("acme", admin_token), as: :json
+    post "/api/v1/group_memberships", params: { group_membership: { group_id: g2_id, user_id: sam.id } }, headers: account_headers("acme", admin_token), as: :json
+    sam_g2_id = response.parsed_body.dig("group_membership", "id")
+    post "/api/v1/group_memberships", params: { group_membership: { group_id: g3_id, user_id: sam.id } }, headers: account_headers("acme", admin_token), as: :json
+
+    post "/api/v1/group_memberships", params: { group_membership: { group_id: g1_id, user_id: pat.id } }, headers: account_headers("acme", admin_token), as: :json
+    post "/api/v1/group_memberships", params: { group_membership: { group_id: g3_id, user_id: pat.id } }, headers: account_headers("acme", admin_token), as: :json
+    pat_g3_id = response.parsed_body.dig("group_membership", "id")
+
+    post "/api/v1/group_memberships", params: { group_membership: { group_id: g2_id, user_id: jo.id } }, headers: account_headers("acme", admin_token), as: :json
+    jo_g2_id = response.parsed_body.dig("group_membership", "id")
+    post "/api/v1/group_memberships", params: { group_membership: { group_id: g1_id, user_id: jo.id } }, headers: account_headers("acme", admin_token), as: :json
+
+    # Create tickets for combined filtering
+    t1_id = create_customer_ticket(subdomain: "acme", customer_token: avery_token, subject: "Refund invoice 42", body: "Need refund")
+    t2_id = create_customer_ticket(subdomain: "acme", customer_token: avery_token, subject: "Refund invoice 99", body: "Need refund too")
+
+    # Stringified group_id works; t1 = G2 + unassigned + high, t2 = G2 + Sam + high
+    patch "/api/v1/tickets/#{t1_id}",
+      params: { ticket: { group_id: g2_id.to_s, priority: "high" } },
+      headers: account_headers("acme", sam_token),
+      as: :json
+    assert_response :ok
+    assert_equal g2_id, response.parsed_body.dig("ticket", "group_id")
+
+    patch "/api/v1/tickets/#{t2_id}",
+      params: { ticket: { group_id: g2_id, assignee_id: sam.id, priority: "high", status: "pending" } },
+      headers: account_headers("acme", sam_token),
+      as: :json
+    assert_response :ok
+
+    # Customer reply reopens t2 while preserving group_id and assignee_id (even if customer sends group_id: nil)
+    patch "/api/v1/requests/#{t2_id}",
+      params: { request: { group_id: nil, comment: { body: "Here are more details" } } },
+      headers: account_headers("acme", avery_token),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/tickets/#{t2_id}", headers: account_headers("acme", sam_token)
+    assert_equal "open", response.parsed_body.dig("ticket", "status")
+    assert_equal g2_id, response.parsed_body.dig("ticket", "group_id")
+    assert_equal sam.id, response.parsed_body.dig("ticket", "assignee_id")
+
+    # Filter unassigned-agent tickets inside G2 queue
+    get "/api/v1/tickets",
+      params: { status: "open", priority: "high", group_id: g2_id, assignee_id: "unassigned", requester_id: avery.id, q: "refund" },
+      headers: account_headers("acme", sam_token)
+    assert_response :ok
+    assert_equal [ t1_id ], response.parsed_body.fetch("tickets").map { |t| t["id"] }
+
+    # Multiple invalid filters including group_id report all errors
+    get "/api/v1/tickets",
+      params: { status: "bad", priority: "bad", group_id: "bad", assignee_id: "bad", requester_id: "bad" },
+      headers: account_headers("acme", sam_token)
+    assert_response :unprocessable_entity
+    errs = response.parsed_body.fetch("errors")
+    assert errs.key?("status")
+    assert errs.key?("priority")
+    assert errs.key?("group_id")
+    assert errs.key?("assignee_id")
+    assert errs.key?("requester_id")
+
+    # Atomic rollback: valid group move (G2 -> G3, which would clear Jo if Jo were assigned, or keep Sam) + invalid status rolls back completely
+    patch "/api/v1/tickets/#{t2_id}",
+      params: { ticket: { assignee_id: jo.id } },
+      headers: account_headers("acme", admin_token),
+      as: :json
+    assert_response :ok
+    assert_equal jo.id, response.parsed_body.dig("ticket", "assignee_id")
+
+    patch "/api/v1/tickets/#{t2_id}",
+      params: { ticket: { group_id: g3_id, status: "not_a_status" } },
+      headers: account_headers("acme", admin_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    get "/api/v1/tickets/#{t2_id}", headers: account_headers("acme", admin_token)
+    assert_equal g2_id, response.parsed_body.dig("ticket", "group_id")
+    assert_equal jo.id, response.parsed_body.dig("ticket", "assignee_id")
+
+    # Deleting G1 promotes Sam -> G2 (lowest remaining ID) and Pat -> G3, while keeping Jo -> G2 as default!
+    delete "/api/v1/groups/#{g1_id}", headers: account_headers("acme", admin_token)
+    assert_response :no_content
+
+    get "/api/v1/group_memberships", params: { user_id: sam.id }, headers: account_headers("acme", admin_token)
+    sam_mems = response.parsed_body.fetch("group_memberships")
+    assert_equal 2, sam_mems.size
+    assert_equal [ true, false ], sam_mems.map { |m| m["default"] }
+    assert_equal sam_g2_id, sam_mems.first["id"]
+
+    get "/api/v1/group_memberships", params: { user_id: pat.id }, headers: account_headers("acme", admin_token)
+    pat_mems = response.parsed_body.fetch("group_memberships")
+    assert_equal [ pat_g3_id ], pat_mems.map { |m| m["id"] }
+    assert_equal [ true ], pat_mems.map { |m| m["default"] }
+
+    get "/api/v1/group_memberships", params: { user_id: jo.id }, headers: account_headers("acme", admin_token)
+    jo_mems = response.parsed_body.fetch("group_memberships")
+    assert_equal [ jo_g2_id ], jo_mems.map { |m| m["id"] }
+    assert_equal [ true ], jo_mems.map { |m| m["default"] }
+  end
+end
