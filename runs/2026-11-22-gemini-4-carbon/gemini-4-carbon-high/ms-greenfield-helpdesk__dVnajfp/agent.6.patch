+      as: :json
+    assert_response :ok
+
+    get "/api/v1/tickets/#{t3_id}", headers: account_headers("acme", admin_token)
+    assert_equal({ "id" => tech["id"], "name" => "Tier 2 Engineering" }, response.parsed_body.dig("ticket", "group"))
