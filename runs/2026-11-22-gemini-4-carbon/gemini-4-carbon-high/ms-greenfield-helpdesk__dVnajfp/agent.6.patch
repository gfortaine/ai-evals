+    assert_equal sam.id, response.parsed_body.dig("ticket", "assignee_id")
+
+    get "/api/v1/tickets/#{t3_id}", headers: account_headers("acme", admin_token)
+    assert_equal billing["id"], response.parsed_body.dig("ticket", "group_id")
+    assert_equal pat.id, response.parsed_body.dig("ticket", "assignee_id")
+
+    # 9. Deleting group Billing -> clears group_id AND assignee_id on t1 and t3, while keeping t2 (Tech Support + Sam) untouched!
+    delete "/api/v1/groups/#{billing['id']}", headers: account_headers("acme", admin_token)
+    assert_response :no_content
+
+    get "/api/v1/tickets/#{t1_id}", headers: account_headers("acme", admin_token)
+    assert_nil response.parsed_body.dig("ticket", "group_id")
+    assert_nil response.parsed_body.dig("ticket", "assignee_id")
+
+    get "/api/v1/tickets/#{t3_id}", headers: account_headers("acme", admin_token)
+    assert_nil response.parsed_body.dig("ticket", "group_id")
+    assert_nil response.parsed_body.dig("ticket", "assignee_id")
+
+    get "/api/v1/tickets/#{t2_id}", headers: account_headers("acme", admin_token)
+    assert_equal tech["id"], response.parsed_body.dig("ticket", "group_id")
+    assert_equal sam.id, response.parsed_body.dig("ticket", "assignee_id")
+
+    # 10. Suspension clears assignee_id on t2 (leaving Tech Support group in place!) and KEEPS Sam's memberships for later!
+    patch "/api/v1/users/#{sam.id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", admin_token),
