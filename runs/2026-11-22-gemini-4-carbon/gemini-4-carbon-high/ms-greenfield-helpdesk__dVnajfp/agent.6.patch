diff --git a/test/integration/groups_and_memberships_test.rb b/test/integration/groups_and_memberships_test.rb
new file mode 100644
index 0000000..f1e7856
--- /dev/null
+++ b/test/integration/groups_and_memberships_test.rb
@@ -0,0 +1,1014 @@
+require "test_helper"
+
+class GroupsAndMembershipsTest < ActionDispatch::IntegrationTest
+  def account_headers(subdomain, token = nil)
+    headers = { "X-Helpdesk-Account" => subdomain }
+    headers["Authorization"] = "Bearer #{token}" if token.present?
+    headers
+  end
+
+  def extract_token_from_last_email
+    mail = ActionMailer::Base.deliveries.last
+    assert_not_nil mail, "Expected an email to have been sent"
+    token = mail.body.decoded[/token=([A-Za-z0-9_-]+)/, 1]
+    assert token.present?, "Expected token in email body"
+    token
+  end
+
+  def create_verified_business(name: "Acme", subdomain: "acme", owner_name: "Jo Admin", owner_email: "jo@acme.test", password: "owner-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: {
+            name: owner_name,
+            email: owner_email,
+            password: password
+          }
+        }
+      },
+      as: :json
+    assert_response :created
+
+    token = extract_token_from_last_email
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: owner_email, password: password } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+
+    [ Account.find_by!(subdomain: subdomain), response.parsed_body.dig("session", "token") ]
+  end
+
+  def invite_and_login_staff(subdomain:, admin_token:, name:, email:, role: "agent", password: "staff-password")
+    post "/api/v1/invitations",
+      params: { invitation: { email: email, role: role } },
+      headers: account_headers(subdomain, admin_token),
+      as: :json
+    assert_response :created
+    inv_token = extract_token_from_last_email
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: inv_token, name: name, password: password } },
+      headers: account_headers(subdomain),\
+      as: :json
+    assert_response :created
+    user = User.find(response.parsed_body.dig("user", "id"))
+
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+
+    [ user, response.parsed_body.dig("session", "token") ]
+  end
+
+  def register_and_verify_customer(subdomain:, name:, email:, password: "customer-password")
+    post "/api/v1/registrations",
+      params: { user: { name: name, email: email, password: password } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+    user_id = response.parsed_body.dig("user", "id")
+
+    token = extract_token_from_last_email
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+
+    [ User.find(user_id), response.parsed_body.dig("session", "token") ]
+  end
+
+  def create_customer_ticket(subdomain:, customer_token:, subject:, body: "Help please")
+    post "/api/v1/requests",
+      params: { request: { subject: subject, comment: { body: body } } },
+      headers: account_headers(subdomain, customer_token),
+      as: :json
+    assert_response :created
+    response.parsed_body.dig("request", "id")
+  end
+
+  test "groups CRUD, permissions, ordering by ID asc, pagination, renaming, and validations" do
+    _account, owner_token = create_verified_business(subdomain: "acme")
+    _second_admin, second_admin_token = invite_and_login_staff(
+      subdomain: "acme",
+      admin_token: owner_token,
+      name: "Alex Admin",
+      email: "alex@acme.test",
+      role: "admin"
+    )
+    _agent, agent_token = invite_and_login_staff(
+      subdomain: "acme",
+      admin_token: owner_token,
+      name: "Sam Agent",
+      email: "sam@acme.test",
+      role: "agent"
+    )
+    _cust, cust_token = register_and_verify_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    post "/api/v1/groups",
+      params: { group: { name: "  Billing  " } },
+      headers: account_headers("acme", owner_token),
+      as: :json
+    assert_response :created
+    billing = response.parsed_body.fetch("group")
+    assert_equal "Billing", billing["name"]
+    assert_not_nil billing["id"]
+    assert_not_nil billing["created_at"]
+    assert_not_nil billing["updated_at"]
+
+    # Secondary admin can also create, rename, and delete groups
+    post "/api/v1/groups",
+      params: { group: { name: "Technical Support" } },
+      headers: account_headers("acme", second_admin_token),
+      as: :json
+    assert_response :created
+    tech = response.parsed_body.fetch("group")
+
+    post "/api/v1/groups",
+      params: { group: { name: "Onboarding" } },
+      headers: account_headers("acme", owner_token),
+      as: :json
+    assert_response :created
+    onboarding = response.parsed_body.fetch("group")
+
+    # Duplicate name (case-insensitive or whitespace-padded) fails with 422
+    post "/api/v1/groups",
+      params: { group: { name: "  billing " } },
+      headers: account_headers("acme", owner_token),
+      as: :json
+    assert_response :unprocessable_entity
+    assert response.parsed_body.fetch("errors").key?("name")
+
+    # Blank, NUL-only, missing, or non-string name fails with 422
+    [
+      { group: {} },
+      { group: { name: "" } },
+      { group: { name: "   " } },
+      { group: { name: "\u0000" } },
+      { group: { name: [ "Billing" ] } },
+      { group: { name: 123 } },
+      { group: "bad" },
+      {}
+    ].each do |bad_payload|
+      post "/api/v1/groups",
+        params: bad_payload,
+        headers: account_headers("acme", owner_token),
+        as: :json
+      assert_response :unprocessable_entity, "Expected 422 for #{bad_payload.inspect}"
+    end
+
+    # Agent can browse list & detail (ordered by ID asc, paginated), but cannot create, rename, or delete
+    get "/api/v1/groups", params: { page: 1, per_page: 2 }, headers: account_headers("acme", agent_token)
+    assert_response :ok
+    assert_equal [ billing["id"], tech["id"] ], response.parsed_body.fetch("groups").map { |g| g["id"] }
+    assert_equal 3, response.parsed_body["count"]
+    assert_equal 2, response.parsed_body["next_page"]
+
+    get "/api/v1/groups", params: { page: 2, per_page: 2 }, headers: account_headers("acme", agent_token)
+    assert_response :ok
+    assert_equal [ onboarding["id"] ], response.parsed_body.fetch("groups").map { |g| g["id"] }
+    assert_equal 1, response.parsed_body["previous_page"]
+    assert_nil response.parsed_body["next_page"]
+
+    get "/api/v1/groups/#{billing['id']}", headers: account_headers("acme", agent_token)
+    assert_response :ok
+    assert_equal "Billing", response.parsed_body.dig("group", "name")
+
+    post "/api/v1/groups", params: { group: { name: "Sales" } }, headers: account_headers("acme", agent_token), as: :json
+    assert_response :forbidden
+    patch "/api/v1/groups/#{billing['id']}", params: { group: { name: "Finance" } }, headers: account_headers("acme", agent_token), as: :json
+    assert_response :forbidden
+    delete "/api/v1/groups/#{billing['id']}", headers: account_headers("acme", agent_token)
+    assert_response :forbidden
+
+    # Customer cannot browse or mutate groups
+    get "/api/v1/groups", headers: account_headers("acme", cust_token)
+    assert_response :forbidden
+    get "/api/v1/groups/#{billing['id']}", headers: account_headers("acme", cust_token)
+    assert_response :forbidden
+    post "/api/v1/groups", params: { group: { name: "Sales" } }, headers: account_headers("acme", cust_token), as: :json
+    assert_response :forbidden
+    patch "/api/v1/groups/#{billing['id']}", params: { group: { name: "Finance" } }, headers: account_headers("acme", cust_token), as: :json
+    assert_response :forbidden
+    delete "/api/v1/groups/#{billing['id']}", headers: account_headers("acme", cust_token)
+    assert_response :forbidden
+
+    # Renaming to own name / casing change works; renaming to another group's name or empty fails
+    patch "/api/v1/groups/#{billing['id']}",
+      params: { group: { name: "BILLING" } },
+      headers: account_headers("acme", owner_token),
+      as: :json
+    assert_response :ok
+    assert_equal "BILLING", response.parsed_body.dig("group", "name")
+
+    patch "/api/v1/groups/#{billing['id']}",
+      params: { group: { name: "  Finance & Billing " } },
+      headers: account_headers("acme", second_admin_token),
+      as: :json
+    assert_response :ok
+    assert_equal "Finance & Billing", response.parsed_body.dig("group", "name")
+
+    patch "/api/v1/groups/#{billing['id']}",
+      params: { group: { name: "technical support" } },
+      headers: account_headers("acme", owner_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    patch "/api/v1/groups/#{billing['id']}",
+      params: { group: {} },
+      headers: account_headers("acme", owner_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    patch "/api/v1/groups/#{billing['id']}",
+      params: { group: { unknown: 1 } },
+      headers: account_headers("acme", owner_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Admin deletes group
+    delete "/api/v1/groups/#{onboarding['id']}", headers: account_headers("acme", second_admin_token)
+    assert_response :no_content
+
+    get "/api/v1/groups/#{onboarding['id']}", headers: account_headers("acme", owner_token)
+    assert_response :not_found
+  end
+
+  test "group memberships lifecycle, single-default invariant, make_default, fallback promotion, and filters" do
+    account, admin_token = create_verified_business(subdomain: "acme")
+    jo = account.owner
+    sam, sam_token = invite_and_login_staff(subdomain: "acme", admin_token: admin_token, name: "Sam", email: "sam@acme.test")
+    pat, _pat_token = invite_and_login_staff(subdomain: "acme", admin_token: admin_token, name: "Pat", email: "pat@acme.test")
+    avery, avery_token = register_and_verify_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    post "/api/v1/groups", params: { group: { name: "Billing" } }, headers: account_headers("acme", admin_token), as: :json
+    billing_id = response.parsed_body.dig("group", "id")
