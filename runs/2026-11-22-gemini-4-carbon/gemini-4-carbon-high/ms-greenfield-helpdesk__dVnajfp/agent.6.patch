+    # Remove Sam from Billing -> clears Sam on t1 (keeps t1 in Billing!), keeps Sam on t2 (Tech Support), keeps Pat on t3 (Billing)!
+    delete "/api/v1/group_memberships/#{sam_billing_mem_id}", headers: account_headers("acme", admin_token)
+    assert_response :no_content
+
+    get "/api/v1/tickets/#{t1_id}", headers: account_headers("acme", admin_token)
