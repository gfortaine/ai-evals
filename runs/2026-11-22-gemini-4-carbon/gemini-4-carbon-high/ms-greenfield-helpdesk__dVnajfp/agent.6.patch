+  test "cross-tenant isolation, auth/header errors, non-numeric IDs, account cancellation, reactivation, and purge" do
+    acme, acme_token = create_verified_business(name: "Acme", subdomain: "acme", owner_email: "jo@acme.test")
+    _globex, globex_token = create_verified_business(name: "Globex", subdomain: "globex", owner_email: "jo@globex.test")
+    _acme_cust, acme_cust_token = register_and_verify_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    # Same group name "Billing" can exist independently in both Acme and Globex
+    post "/api/v1/groups", params: { group: { name: "Billing" } }, headers: account_headers("acme", acme_token), as: :json
+    assert_response :created
+    acme_group_id = response.parsed_body.dig("group", "id")
+
+    post "/api/v1/groups", params: { group: { name: "Billing" } }, headers: account_headers("globex", globex_token), as: :json
+    assert_response :created
+    globex_group_id = response.parsed_body.dig("group", "id")
+
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: acme_group_id, user_id: acme.owner.id } },
+      headers: account_headers("acme", acme_token),
+      as: :json
+    assert_response :created
+    acme_mem_id = response.parsed_body.dig("group_membership", "id")
+
+    t_id = create_customer_ticket(subdomain: "acme", customer_token: acme_cust_token, subject: "Acme ticket")
+    patch "/api/v1/tickets/#{t_id}",
+      params: { ticket: { assignee_id: acme.owner.id } },
+      headers: account_headers("acme", acme_token),
+      as: :json
+    assert_response :ok
+    assert_equal acme_group_id, response.parsed_body.dig("ticket", "group_id")
+
+    # Globex cannot read, rename, delete, or reference Acme groups or memberships
+    get "/api/v1/groups/#{acme_group_id}", headers: account_headers("globex", globex_token)
+    assert_response :not_found
+    patch "/api/v1/groups/#{acme_group_id}", params: { group: { name: "Hacked" } }, headers: account_headers("globex", globex_token), as: :json
+    assert_response :not_found
+    delete "/api/v1/groups/#{acme_group_id}", headers: account_headers("globex", globex_token)
+    assert_response :not_found
+
+    get "/api/v1/group_memberships/#{acme_mem_id}", headers: account_headers("globex", globex_token)
+    assert_response :not_found
+    put "/api/v1/group_memberships/#{acme_mem_id}/make_default", headers: account_headers("globex", globex_token)
+    assert_response :not_found
+    delete "/api/v1/group_memberships/#{acme_mem_id}", headers: account_headers("globex", globex_token)
+    assert_response :not_found
+
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: acme_group_id, user_id: acme.owner.id } },
+      headers: account_headers("globex", globex_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: globex_group_id, user_id: acme.owner.id } },
+      headers: account_headers("globex", globex_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    patch "/api/v1/tickets/#{t_id}",
+      params: { ticket: { group_id: globex_group_id } },
+      headers: account_headers("acme", acme_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Missing header -> 400, unknown account -> 404, unauthenticated -> 401, non-numeric ID -> 404
+    get "/api/v1/groups"
+    assert_response :bad_request
+    get "/api/v1/group_memberships"
+    assert_response :bad_request
+
+    get "/api/v1/groups", headers: account_headers("nonexistent", acme_token)
+    assert_response :not_found
+
+    get "/api/v1/groups", headers: account_headers("acme")
+    assert_response :unauthorized
+    get "/api/v1/group_memberships", headers: account_headers("acme")
+    assert_response :unauthorized
+
+    get "/api/v1/groups/not-an-id", headers: account_headers("acme", acme_token)
+    assert_response :not_found
+    patch "/api/v1/groups/not-an-id", params: { group: { name: "X" } }, headers: account_headers("acme", acme_token), as: :json
+    assert_response :not_found
+    delete "/api/v1/groups/not-an-id", headers: account_headers("acme", acme_token)
+    assert_response :not_found
+    get "/api/v1/group_memberships/not-an-id", headers: account_headers("acme", acme_token)
+    assert_response :not_found
+    put "/api/v1/group_memberships/not-an-id/make_default", headers: account_headers("acme", acme_token)
+    assert_response :not_found
+    delete "/api/v1/group_memberships/not-an-id", headers: account_headers("acme", acme_token)
+    assert_response :not_found
+
+    # Cancelled account blocks /groups and /group_memberships; reactivation preserves everything; purge deletes cleanly
+    post "/api/v1/account/cancel", headers: account_headers("acme", acme_token), as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "owner-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+    recovery_token = response.parsed_body.dig("session", "token")
+
+    get "/api/v1/groups", headers: account_headers("acme", recovery_token)
+    assert_response :forbidden
+    get "/api/v1/group_memberships", headers: account_headers("acme", recovery_token)
+    assert_response :forbidden
+
+    post "/api/v1/account/reactivate", headers: account_headers("acme", recovery_token), as: :json
+    assert_response :ok
+
+    get "/api/v1/groups", headers: account_headers("acme", recovery_token)
+    assert_response :ok
+    assert_equal 1, response.parsed_body["count"]
+
+    get "/api/v1/group_memberships", headers: account_headers("acme", recovery_token)
+    assert_response :ok
+    assert_equal 1, response.parsed_body["count"]
+
+    acme.update!(cancelled_at: 91.days.ago)
+    acme_id = acme.id
+    Account.purge_expired_cancelled_accounts!
+    assert_not Account.exists?(acme_id)
+    assert_equal 0, Group.where(account_id: acme_id).count
+    assert_equal 0, GroupMembership.where(account_id: acme_id).count
+  end
