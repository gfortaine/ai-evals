+    assert_nil response.parsed_body.dig("ticket", "assignee_id")
+
+    get "/api/v1/group_memberships", params: { user_id: sam.id }, headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal 1, response.parsed_body["count"]
+    assert_equal tech["id"], response.parsed_body.fetch("group_memberships").first["group_id"]
+    assert_equal true, response.parsed_body.fetch("group_memberships").first["default"]
+
+    # Unsuspend Sam -> Sam's preserved default group (Tech Support) immediately applies when assigned to ungrouped t3!
+    patch "/api/v1/users/#{sam.id}",
+      params: { user: { suspended: false } },
+      headers: account_headers("acme", admin_token),
+      as: :json
+    assert_response :ok
+
+    patch "/api/v1/tickets/#{t3_id}",
+      params: { ticket: { assignee_id: sam.id } },
