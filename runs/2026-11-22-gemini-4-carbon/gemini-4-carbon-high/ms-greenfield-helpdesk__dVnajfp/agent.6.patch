+module Api
+  module V1
+    class GroupsController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!
+      before_action :ensure_account_active!
+      before_action :require_staff!, only: %i[index show]
+      before_action :require_admin!, only: %i[create update destroy]
+      before_action :set_group, only: %i[show update destroy]
+
+      def index
+        scope = current_account.groups.by_id
+        records, meta = paginate(scope)
+
+        render json: {
+          groups: records.map(&:api_json),
+          **meta
+        }, status: :ok
+      end
+
+      def show
+        render json: { group: @group.api_json }, status: :ok
+      end
+
+      def create
+        group_attrs = require_hash_param(:group)
+        raw_name = group_attrs[:name]
+
+        group = nil
+        current_account.with_lock do
+          group = current_account.groups.new(
+            name: raw_name.is_a?(String) ? raw_name : nil
+          )
+          group.save!
+        end
+
+        render json: { group: group.api_json }, status: :created
+      end
+
+      def update
+        group_attrs = require_hash_param(:group)
+
+        unless group_attrs.key?(:name)
+          return render json: {
+            error: "Name can't be blank",
+            errors: { name: [ "Name can't be blank" ] }
+          }, status: :unprocessable_entity
+        end
+
+        raw_name = group_attrs[:name]
+        current_account.with_lock do
+          @group.reload
+          @group.name = raw_name.is_a?(String) ? raw_name : nil
+          @group.save!
+        end
+
+        render json: { group: @group.api_json }, status: :ok
+      end
+
+      def destroy
+        current_account.with_lock do
+          @group.reload
+          @group.destroy!
+        end
+
+        head :no_content
+      end
+
+      private
+
+      def set_group
+        @group = current_account.groups.find(params[:id])
+      end
+    end
+  end
+end
