+  test "invalid cursor parameters, tampered cursors, cross-collection, cross-ticket, cross-customer, and cross-tenant cursors return 422" do
+    acme, _acme_owner, acme_owner_token = create_business(subdomain: "acmeval")
+    globex, _globex_owner, globex_owner_token = create_business(subdomain: "globexval")
+    cust_a, cust_a_token = create_customer(account: acme, email: "a@acmeval.test")
+    cust_b, cust_b_token = create_customer(account: acme, email: "b@acmeval.test")
+    globex_cust, _ = create_customer(account: globex, email: "c@globexval.test")
+
+    t_a1 = create_ticket_with_comment(account: acme, requester: cust_a, subject: "A1")
+    t_a2 = create_ticket_with_comment(account: acme, requester: cust_a, subject: "A2")
+    create_ticket_with_comment(account: acme, requester: cust_b, subject: "B1")
+    create_ticket_with_comment(account: globex, requester: globex_cust, subject: "G1")
+
+    get "/api/v1/tickets?page[size]=1", headers: account_headers("acmeval", acme_owner_token)
+    assert_response :ok
+    ticket_cursor = response.parsed_body.dig("meta", "after_cursor")
+
+    get "/api/v1/users?page[size]=1", headers: account_headers("acmeval", acme_owner_token)
+    assert_response :ok
+    user_cursor = response.parsed_body.dig("meta", "after_cursor")
+
+    get "/api/v1/tickets/#{t_a1.id}/comments?page[size]=1", headers: account_headers("acmeval", acme_owner_token)
+    assert_response :ok
+    t1_comment_cursor = response.parsed_body.dig("meta", "after_cursor")
+
+    get "/api/v1/requests?page[size]=1", headers: account_headers("acmeval", cust_a_token)
+    assert_response :ok
+    cust_a_req_cursor = response.parsed_body.dig("meta", "after_cursor")
+
+    # Tampered character in cursor
+    flipped_char = ticket_cursor[0] == "A" ? "B" : "A"
+    tampered_cursor = flipped_char + ticket_cursor[1..]
+
+    invalid_ticket_params = [
+      { page: { size: 0 } },
+      { page: { size: -3 } },
+      { page: { size: "abc" } },
+      { page: { size: "   " } },
+      { page: { size: [ "10" ] } },
+      { page: { size: "99999999999999999999999999" } },
+      { page: { unknown_key: 1 } },
+      { page: { number: 2 } },
+      { page: { after: "not-a-valid-cursor" } },
+      { page: { before: "!!!" } },
+      { page: { after: "   " } },
+      { page: { after: [ ticket_cursor ] } },
+      { page: { after: tampered_cursor } },
+      { page: { after: ticket_cursor, before: ticket_cursor } },
+      { page: { after: user_cursor } },
+      { page: { after: t1_comment_cursor } },
+      { page: { after: cust_a_req_cursor } }
+    ]
+
+    invalid_ticket_params.each do |bad_params|
+      get "/api/v1/tickets", params: bad_params, headers: account_headers("acmeval", acme_owner_token)
+      assert_response :unprocessable_entity, "Expected 422 for #{bad_params.inspect}"
+      assert response.parsed_body.key?("error")
+      assert response.parsed_body.key?("errors")
+    end
+
+    # Cross-tenant cursor replay rejected
+    get "/api/v1/tickets", params: { page: { after: ticket_cursor, size: 5 } }, headers: account_headers("globexval", globex_owner_token)
+    assert_response :unprocessable_entity
+
+    # Cross-ticket comment cursor replay rejected
+    get "/api/v1/tickets/#{t_a2.id}/comments", params: { page: { after: t1_comment_cursor, size: 5 } }, headers: account_headers("acmeval", acme_owner_token)
+    assert_response :unprocessable_entity
+
+    # Staff ticket_comments cursor replayed on customer request_comments rejected
+    get "/api/v1/requests/#{t_a1.id}/comments", params: { page: { after: t1_comment_cursor, size: 5 } }, headers: account_headers("acmeval", cust_a_token)
+    assert_response :unprocessable_entity
+
+    # Cross-customer request cursor replay rejected
+    get "/api/v1/requests", params: { page: { after: cust_a_req_cursor, size: 5 } }, headers: account_headers("acmeval", cust_b_token)
+    assert_response :unprocessable_entity
+
+    # Blank cursor or blank size acts as omitted (first page with default size 25)
+    get "/api/v1/tickets?page[size]=&page[after]=&page[before]=", headers: account_headers("acmeval", acme_owner_token)
+    assert_response :ok
+    assert_equal 3, response.parsed_body.fetch("tickets").size
+  end
