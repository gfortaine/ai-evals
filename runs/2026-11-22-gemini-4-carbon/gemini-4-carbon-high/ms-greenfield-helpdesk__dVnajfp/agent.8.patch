+    get "/api/v1/invitations?page[size]=10", headers: account_headers("emptycursor", owner_token)
+    assert_response :ok
+    assert_equal [], response.parsed_body["invitations"]
+    assert_equal({ "has_more" => false, "after_cursor" => nil, "before_cursor" => nil }, response.parsed_body["meta"])
