+    assert_equal expected_desc_ids[3, 3], p2.fetch("tickets").map { |t| t["id"] }
+    assert_equal true, p2.dig("meta", "has_more")
+    assert_not_nil p2.dig("links", "prev")
+    assert_not_nil p2.dig("links", "next")
+
+    get p2.dig("links", "next"), headers: account_headers("navco", owner_token)
+    assert_response :ok
+    p3 = response.parsed_body
