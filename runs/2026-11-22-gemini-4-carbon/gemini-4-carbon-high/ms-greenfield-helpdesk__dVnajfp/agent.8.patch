+  test "merging tickets and filtering unassigned group/assignee work seamlessly with cursor pagination" do
+    account, _owner, owner_token = create_business(subdomain: "mergecursor")
+    customer, customer_token = create_customer(account: account, email: "cust@mergecursor.test")
+    group = account.groups.create!(name: "Support")
+
+    base_ts = Time.utc(2026, 11, 21, 18, 0, 0)
+    t1 = create_ticket_with_comment(account: account, requester: customer, subject: "T1", ts: base_ts + 1.minute)
+    t2 = create_ticket_with_comment(account: account, requester: customer, subject: "T2", ts: base_ts + 2.minutes)
+    t3 = create_ticket_with_comment(account: account, requester: customer, subject: "T3", ts: base_ts + 3.minutes)
+    t4 = create_ticket_with_comment(account: account, requester: customer, subject: "T4", ts: base_ts + 4.minutes)
+    _grouped = create_ticket_with_comment(account: account, requester: customer, group: group, subject: "Grouped", ts: base_ts + 5.minutes)
+
+    # Filter unassigned group & assignee on page 1 (gets [t4, t3])
+    get "/api/v1/tickets",
+      params: { status: "open", group_id: "unassigned", assignee_id: "unassigned", page: { size: 2 } },
+      headers: account_headers("mergecursor", owner_token)
+    assert_response :ok
+    p1 = response.parsed_body
+    assert_equal [ t4.id, t3.id ], p1.fetch("tickets").map { |t| t["id"] }
+
+    # Customer also loads page 1 of requests (size=2: [_grouped, t4])
+    get "/api/v1/requests?page[size]=2", headers: account_headers("mergecursor", customer_token)
+    assert_response :ok
+    cust_p1 = response.parsed_body
+
+    # Merge boundary ticket t3 into t4 while both staff and customer are mid-browse!
+    travel_to(base_ts + 20.minutes) do
+      post "/api/v1/tickets/#{t3.id}/merge",
+        params: { merge: { target_id: t4.id } },
+        headers: account_headers("mergecursor", owner_token),
+        as: :json
+      assert_response :ok
+    end
+
+    # Staff follows next link: t3 is now closed, t4 moved newer, so [t2, t1] are returned cleanly!
+    get p1.dig("links", "next"), headers: account_headers("mergecursor", owner_token)
+    assert_response :ok
+    p2 = response.parsed_body
+    assert_equal [ t2.id, t1.id ], p2.fetch("tickets").map { |t| t["id"] }
+    assert_equal false, p2.dig("meta", "has_more")
+    assert_nil p2.dig("links", "next")
+
+    # Customer follows next link on requests: gets [t3, t2] or remaining requests with zero duplicates from page 1
+    get cust_p1.dig("links", "next"), headers: account_headers("mergecursor", customer_token)
+    assert_response :ok
+    cust_p2_ids = response.parsed_body.fetch("requests").map { |r| r["id"] }
+    assert_equal [], (cust_p1.fetch("requests").map { |r| r["id"] } & cust_p2_ids)
+  end
