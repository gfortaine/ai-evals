+    # Noise tickets that do not match the filter
+    create_ticket_with_comment(account: account, requester: customer, subject: "Solved receipt", status: "solved", priority: "high", ts: base_time + 20.minutes)
+    create_ticket_with_comment(account: account, requester: customer, subject: "Normal priority receipt", status: "open", priority: "normal", ts: base_time + 21.minutes)
