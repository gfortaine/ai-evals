+    assert_response :ok
+    assert_equal expected_desc_ids[3, 4], response.parsed_body.fetch("tickets").map { |t| t["id"] }
+    assert_equal false, response.parsed_body.dig("meta", "has_more")
+
+    # Past-the-end after_cursor and before-the-start before_cursor return empty page cleanly
+    get "/api/v1/tickets",
