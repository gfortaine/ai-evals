+    assert_nil response.parsed_body.dig("links", "next")
+    assert_nil response.parsed_body.dig("links", "prev")
+
+    # Follow links.next across 3 pages (3, 3, 1)
+    get "/api/v1/tickets",
+      params: { status: "open", priority: "high", group_id: billing_group.id, assignee_id: owner.id, q: "100% & receipt", page: { size: 3 } },
