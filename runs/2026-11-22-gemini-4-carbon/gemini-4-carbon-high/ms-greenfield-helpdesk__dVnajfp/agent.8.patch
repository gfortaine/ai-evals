+    assert_equal({ "has_more" => false, "after_cursor" => nil, "before_cursor" => nil }, response.parsed_body["meta"])
+    assert_equal({ "next" => nil, "prev" => nil }, response.parsed_body["links"])
+
+    get "/api/v1/tickets",
+      params: { status: "open", priority: "high", page: { before: p1.dig("meta", "before_cursor"), size: 3 } },
+      headers: account_headers("navco", owner_token)
+    assert_response :ok
+    assert_equal [], response.parsed_body["tickets"]
+    assert_equal({ "has_more" => false, "after_cursor" => nil, "before_cursor" => nil }, response.parsed_body["meta"])
+    assert_equal({ "next" => nil, "prev" => nil }, response.parsed_body["links"])
+  end
+
+  test "all remaining collections support cursor pagination (requests, ticket comments, request comments, invitations, users, staff, groups, group_memberships)" do
+    account, owner, owner_token = create_business(subdomain: "allcolls")
+    agent1, _agent1_token = create_staff(account: account, email: "a1@allcolls.test", name: "Agent 1")
+    agent2, _agent2_token = create_staff(account: account, email: "a2@allcolls.test", name: "Agent 2")
+    _suspended_agent, _ = create_staff(account: account, email: "susp@allcolls.test", name: "Susp", suspended: true)
