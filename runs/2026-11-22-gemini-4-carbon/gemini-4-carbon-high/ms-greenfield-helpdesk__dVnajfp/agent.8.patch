+  test "identical timestamps and 1-microsecond differences paginate deterministically without duplicates or skips" do
+    account, _owner, owner_token = create_business(subdomain: "tieco")
+    customer, _customer_token = create_customer(account: account, email: "cust@tieco.test")
+
+    exact_ts = Time.utc(2026, 11, 21, 15, 30, 45, 123_456)
+    tied = 5.times.map do |i|
+      create_ticket_with_comment(account: account, requester: customer, subject: "Tied #{i}", ts: exact_ts)
+    end
+    plus_one_usec = create_ticket_with_comment(
+      account: account,
+      requester: customer,
+      subject: "Plus 1 usec",
+      ts: Time.utc(2026, 11, 21, 15, 30, 45, 123_457)
+    )
+    minus_one_usec = create_ticket_with_comment(
+      account: account,
+      requester: customer,
+      subject: "Minus 1 usec",
+      ts: Time.utc(2026, 11, 21, 15, 30, 45, 123_455)
+    )
+
+    expected_order = [ plus_one_usec.id ] + tied.map(&:id).sort.reverse + [ minus_one_usec.id ]
+
+    forward_ids = []
+    last_page = nil
+    url = "/api/v1/tickets?page[size]=2"
+    while url
+      get url, headers: account_headers("tieco", owner_token)
+      assert_response :ok
+      last_page = response.parsed_body
+      forward_ids.concat(last_page.fetch("tickets").map { |t| t["id"] })
+      url = last_page.dig("links", "next")
+    end
+    assert_equal expected_order, forward_ids
+
+    # Walk backward from the last page all the way to the beginning
+    backward_pages = [ last_page.fetch("tickets").map { |t| t["id"] } ]
+    prev_url = last_page.dig("links", "prev")
+    while prev_url
+      get prev_url, headers: account_headers("tieco", owner_token)
+      assert_response :ok
+      backward_pages.unshift(response.parsed_body.fetch("tickets").map { |t| t["id"] })
+      prev_url = response.parsed_body.dig("links", "prev")
+    end
+    assert_equal expected_order, backward_pages.flatten
+  end
