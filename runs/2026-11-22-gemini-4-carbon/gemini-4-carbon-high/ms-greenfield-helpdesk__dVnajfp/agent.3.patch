diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
new file mode 100644
index 0000000..e26d7a9
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,43 @@
+module Api
+  module V1
+    class InvitationAcceptancesController < BaseController
+      before_action :require_account!
+      before_action :ensure_account_active!
+
+      def create
+        accept_params = require_hash_param(:invitation_acceptance)
+        raw_token = accept_params[:token].is_a?(String) ? accept_params[:token].strip : ""
+        raw_name = accept_params[:name]
+        raw_password = accept_params[:password]
+
+        user = nil
+        current_account.with_lock do
+          invitation = current_account.invitations.find_by_raw_token(raw_token)
+          if invitation.nil? || !invitation.pending? || current_account.users.exists?(email: invitation.email)
+            return render json: { error: "Invalid or expired invitation token" }, status: :unprocessable_entity
+          end
+
+          user = current_account.users.new(
+            name: raw_name.is_a?(String) ? raw_name : nil,
+            email: invitation.email,
+            password: raw_password.is_a?(String) ? raw_password : nil,
+            role: invitation.role,
+            verified: true
+          )
+
+          unless user.valid?
+            return render_validation_errors(user)
+          end
+
+          user.save!
+          invitation.update!(accepted_at: Time.current)
+        end
+
+        render json: {
+          user: user.api_json,
+          account: current_account.api_json
+        }, status: :created
+      end
+    end
+  end
+end
