+  test "cross-tenant isolation, validation errors, cancelled account restrictions, and purge cleanup" do
+    acme, acme_owner_token = create_verified_business(name: "Acme", subdomain: "acme", owner_email: "jo@acme.test")
+    globex, globex_owner_token = create_verified_business(name: "Globex", subdomain: "globex", owner_email: "jo@globex.test")
+
+    # Pending invite in Acme does NOT block customer registration or invite in Globex
+    post "/api/v1/invitations",
+      params: { invitation: { email: "shared@example.test", role: "agent" } },
+      headers: account_headers("acme", acme_owner_token),
+      as: :json
+    assert_response :created
+    acme_inv_id = response.parsed_body.dig("invitation", "id")
+    acme_inv_token = extract_invitation_token_from_last_email(expected_account: "acme")
+
+    post "/api/v1/registrations",
+      params: { user: { name: "Shared Globex Cust", email: "shared@example.test", password: "password" } },
+      headers: account_headers("globex"),
+      as: :json
+    assert_response :created
+
+    # Globex cannot preview, accept, inspect, resend, or revoke Acme invitation
+    post "/api/v1/invitation_previews",
+      params: { invitation_preview: { token: acme_inv_token } },
+      headers: account_headers("globex"),
+      as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: acme_inv_token, name: "H", password: "pw" } },
+      headers: account_headers("globex"),
+      as: :json
+    assert_response :unprocessable_entity
+
+    get "/api/v1/invitations/#{acme_inv_id}", headers: account_headers("globex", globex_owner_token)
+    assert_response :not_found
+
+    post "/api/v1/invitations/#{acme_inv_id}/resend", headers: account_headers("globex", globex_owner_token), as: :json
+    assert_response :not_found
+
+    delete "/api/v1/invitations/#{acme_inv_id}", headers: account_headers("globex", globex_owner_token), as: :json
+    assert_response :not_found
+
+    # Globex cannot inspect or suspend Acme users, nor assign Acme user to Globex ticket
+    get "/api/v1/users/#{acme.owner.id}", headers: account_headers("globex", globex_owner_token)
+    assert_response :not_found
+
+    patch "/api/v1/users/#{acme.owner.id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("globex", globex_owner_token),
+      as: :json
+    assert_response :not_found
+
+    # Invalid invitation role (e.g. customer) and invalid email return 422
+    post "/api/v1/invitations",
+      params: { invitation: { email: "cust@acme.test", role: "customer" } },
+      headers: account_headers("acme", acme_owner_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/invitations",
+      params: { invitation: { email: "not-an-email", role: "agent" } },
+      headers: account_headers("acme", acme_owner_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Cancelling Acme blocks previewing and accepting invitations, /users, /invitations, /staff
+    post "/api/v1/account/cancel", headers: account_headers("acme", acme_owner_token), as: :json
+    assert_response :ok
+
+    post "/api/v1/invitation_previews",
+      params: { invitation_preview: { token: acme_inv_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: acme_inv_token, name: "Sam", password: "pw" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    # Purge cleans up invitations too without FK issues
+    acme.update!(cancelled_at: 91.days.ago)
+    acme_id = acme.id
+    Account.purge_expired_cancelled_accounts!
+    assert_not Account.exists?(acme_id)
+    assert_equal 0, Invitation.where(account_id: acme_id).count
+    assert_equal 0, User.where(account_id: acme_id).count
+  end
