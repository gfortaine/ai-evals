+      headers: account_headers("acme", jo_token),
+      as: :json
+    assert_response :created
+    pat_invite_token = extract_invitation_token_from_last_email
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: pat_invite_token, name: "Pat Admin", password: "pat-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+    pat = User.find(response.parsed_body.dig("user", "id"))
+
+    patch "/api/v1/users/#{pat.id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", jo_token),
+      as: :json
+    assert_response :ok
+    assert_equal true, response.parsed_body.dig("user", "suspended")
+
+    # Now Jo is once again the last active admin and cannot suspend herself
+    patch "/api/v1/users/#{jo.id}",
+      params: { user: { suspended: true } },
+      headers: account_headers("acme", jo_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Unsuspend Sam -> Sam can sign in again and reappears in /staff
+    patch "/api/v1/users/#{sam.id}",
+      params: { user: { suspended: false } },
+      headers: account_headers("acme", jo_token),
+      as: :json
+    assert_response :ok
+    assert_equal false, response.parsed_body.dig("user", "suspended")
+
+    post "/api/v1/sessions",
+      params: { session: { email: "sam@acme.test", password: "sam-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+
+    get "/api/v1/staff", headers: account_headers("acme", jo_token)
+    assert_response :ok
+    assert_equal [ jo.id, sam.id ], response.parsed_body.fetch("staff").map { |s| s["id"] }
+
+    # Public reply on t1 DOES update customer-facing request and moves t1 to top of /requests!
+    travel 10.minutes do
+      patch "/api/v1/tickets/#{t1_id}",
+        params: {
+          ticket: {
+            comment: { body: "Billing refunded the duplicate charge.", public: true },
+            status: "pending"
+          }
+        },
+        headers: account_headers("acme", jo_token),
+        as: :json
+      assert_response :ok
+    end
+
+    get "/api/v1/requests", headers: account_headers("acme", avery_token)
+    assert_response :ok
+    assert_equal [ t1_id, t2_id ], response.parsed_body.fetch("requests").map { |r| r["id"] }
+    assert_equal "pending", response.parsed_body.fetch("requests").first["status"]
+    assert Time.iso8601(response.parsed_body.fetch("requests").first["updated_at"]) > Time.iso8601(req1_initial["updated_at"])
+  end
