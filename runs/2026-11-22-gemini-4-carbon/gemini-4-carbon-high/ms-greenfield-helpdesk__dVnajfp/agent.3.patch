+  test "pagination, malformed inputs, non-numeric ids, and unauthenticated checks on new endpoints" do
+    account, owner_token = create_verified_business(subdomain: "pagemore", owner_email: "jo@pagemore.test")
+
+    # Unauthenticated requests return 401
+    get "/api/v1/invitations", headers: account_headers("pagemore")
+    assert_response :unauthorized
+    post "/api/v1/invitations", params: { invitation: { email: "a@b.test", role: "agent" } }, headers: account_headers("pagemore"), as: :json
+    assert_response :unauthorized
+    get "/api/v1/users", headers: account_headers("pagemore")
+    assert_response :unauthorized
+    get "/api/v1/staff", headers: account_headers("pagemore")
+    assert_response :unauthorized
+
+    # Missing X-Helpdesk-Account header returns 400
+    post "/api/v1/invitation_previews", params: { invitation_preview: { token: "tok" } }, as: :json
+    assert_response :bad_request
+    post "/api/v1/invitation_acceptances", params: { invitation_acceptance: { token: "tok", name: "A", password: "pw" } }, as: :json
+    assert_response :bad_request
+    get "/api/v1/staff"
+    assert_response :bad_request
+    get "/api/v1/users"
+    assert_response :bad_request
+    get "/api/v1/invitations"
+    assert_response :bad_request
+
+    # Non-numeric IDs return 404
+    get "/api/v1/invitations/not-an-id", headers: account_headers("pagemore", owner_token)
+    assert_response :not_found
+    post "/api/v1/invitations/not-an-id/resend", headers: account_headers("pagemore", owner_token), as: :json
+    assert_response :not_found
+    delete "/api/v1/invitations/not-an-id", headers: account_headers("pagemore", owner_token), as: :json
+    assert_response :not_found
+    get "/api/v1/users/not-an-id", headers: account_headers("pagemore", owner_token)
+    assert_response :not_found
+    patch "/api/v1/users/not-an-id", params: { user: { suspended: true } }, headers: account_headers("pagemore", owner_token), as: :json
+    assert_response :not_found
+
+    # Malformed envelopes and invalid filter/update values return 422 (never 500)
+    post "/api/v1/invitations", params: { invitation: "bad" }, headers: account_headers("pagemore", owner_token), as: :json
+    assert_response :unprocessable_entity
+    post "/api/v1/invitation_previews", params: { invitation_preview: "bad" }, headers: account_headers("pagemore"), as: :json
+    assert_response :unprocessable_entity
+    post "/api/v1/invitation_previews", params: { invitation_preview: { token: [ "array" ] } }, headers: account_headers("pagemore"), as: :json
+    assert_response :unprocessable_entity
+    post "/api/v1/invitation_acceptances", params: { invitation_acceptance: "bad" }, headers: account_headers("pagemore"), as: :json
+    assert_response :unprocessable_entity
+    patch "/api/v1/users/#{account.owner.id}", params: { user: {} }, headers: account_headers("pagemore", owner_token), as: :json
+    assert_response :unprocessable_entity
+    patch "/api/v1/users/#{account.owner.id}", params: { user: { suspended: "not-a-bool" } }, headers: account_headers("pagemore", owner_token), as: :json
+    assert_response :unprocessable_entity
+    get "/api/v1/users", params: { role: "invalid" }, headers: account_headers("pagemore", owner_token)
+    assert_response :unprocessable_entity
+    get "/api/v1/users", params: { suspended: "invalid" }, headers: account_headers("pagemore", owner_token)
+    assert_response :unprocessable_entity
+
+    # Pagination works on /invitations, /users, and /staff with ID ascending order
+    3.times do |i|
+      post "/api/v1/invitations",
+        params: { invitation: { email: "staff#{i}@pagemore.test", role: i.even? ? "agent" : "admin" } },
+        headers: account_headers("pagemore", owner_token),
+        as: :json
+      assert_response :created
+      tok = extract_invitation_token_from_last_email(expected_account: "pagemore")
+      post "/api/v1/invitation_acceptances",
+        params: { invitation_acceptance: { token: tok, name: "Staff #{i}", password: "password-#{i}" } },
+        headers: account_headers("pagemore"),
+        as: :json
+      assert_response :created
+    end
+
+    get "/api/v1/invitations", params: { page: 1, per_page: 2 }, headers: account_headers("pagemore", owner_token)
+    assert_response :ok
+    assert_equal 3, response.parsed_body["count"]
+    assert_equal 2, response.parsed_body["invitations"].size
+    assert_equal 2, response.parsed_body["next_page"]
+    inv_ids_p1 = response.parsed_body["invitations"].map { |i| i["id"] }
+    assert_equal inv_ids_p1.sort, inv_ids_p1
+
+    get "/api/v1/users", params: { page: 1, per_page: 2 }, headers: account_headers("pagemore", owner_token)
+    assert_response :ok
+    assert_equal 4, response.parsed_body["count"]
+    assert_equal 2, response.parsed_body["users"].size
+    assert_equal 2, response.parsed_body["next_page"]
+
+    get "/api/v1/staff", params: { page: 2, per_page: 2 }, headers: account_headers("pagemore", owner_token)
+    assert_response :ok
+    assert_equal 4, response.parsed_body["count"]
+    assert_equal 2, response.parsed_body["staff"].size
+    assert_equal 1, response.parsed_body["previous_page"]
+    assert_nil response.parsed_body["next_page"]
+  end
+end
