+        user: {
+          name: name,
+          email: email,
+          password: password
+        }
+      },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+    user_json = response.parsed_body.fetch("user")
+    assert_equal "customer", user_json["role"]
+    assert_equal false, user_json["verified"]
+
+    token = extract_token_from_last_email
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :ok
