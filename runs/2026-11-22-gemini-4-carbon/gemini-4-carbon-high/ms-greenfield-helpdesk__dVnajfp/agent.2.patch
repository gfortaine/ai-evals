+    assert_response :forbidden
+
+    # Staff cannot use /requests routes (403 Forbidden)
+    get "/api/v1/requests", headers: account_headers("acme", acme_owner_token)
+    assert_response :forbidden
+    post "/api/v1/requests",
+      params: { request: { subject: "Staff req", comment: { body: "Nope" } } },
+      headers: account_headers("acme", acme_owner_token),
+      as: :json
+    assert_response :forbidden
+    get "/api/v1/requests/#{acme_req_id}", headers: account_headers("acme", acme_owner_token)
+    assert_response :forbidden
+    get "/api/v1/requests/#{acme_req_id}/comments", headers: account_headers("acme", acme_owner_token)
+    assert_response :forbidden
+    patch "/api/v1/requests/#{acme_req_id}",
+      params: { request: { status: "solved" } },
+      headers: account_headers("acme", acme_owner_token),
+      as: :json
+    assert_response :forbidden
+
+    # Cross-tenant isolation: Globex staff and Globex customer cannot see Acme ticket
+    get "/api/v1/tickets", headers: account_headers("globex", globex_owner_token)
+    assert_response :ok
+    assert_equal 0, response.parsed_body["count"]
+
+    get "/api/v1/tickets/#{acme_req_id}", headers: account_headers("globex", globex_owner_token)
+    assert_response :not_found
+
+    get "/api/v1/requests/#{acme_req_id}", headers: account_headers("globex", avery_globex_token)
+    assert_response :not_found
+
+    # Validation edge cases
+    post "/api/v1/requests",
+      params: { request: { subject: "   ", comment: { body: "Valid body" } } },
+      headers: account_headers("acme", avery_acme_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/requests",
+      params: { request: { subject: "Valid subject", comment: { body: "   " } } },
+      headers: account_headers("acme", avery_acme_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    post "/api/v1/requests",
+      params: { request: { subject: "No comment" } },
+      headers: account_headers("acme", avery_acme_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Customer cannot set status to pending or open directly
+    patch "/api/v1/requests/#{acme_req_id}",
+      params: { request: { comment: { body: "Try pending" }, status: "pending" } },
+      headers: account_headers("acme", avery_acme_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    patch "/api/v1/requests/#{acme_req_id}",
+      params: { request: { status: "open" } },
+      headers: account_headers("acme", avery_acme_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    # Staff cannot set unknown status or blank comment
+    patch "/api/v1/tickets/#{acme_req_id}",
+      params: { ticket: { status: "archived" } },
+      headers: account_headers("acme", acme_owner_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    patch "/api/v1/tickets/#{acme_req_id}",
+      params: { ticket: { comment: { body: "" }, status: "pending" } },
+      headers: account_headers("acme", acme_owner_token),
+      as: :json
+    assert_response :unprocessable_entity
+    get "/api/v1/tickets/#{acme_req_id}", headers: account_headers("acme", acme_owner_token)
+    assert_equal "open", response.parsed_body.dig("ticket", "status")
+
+    # Account cancellation blocks registrations, requests, and tickets; purge deletes all records
+    post "/api/v1/account/cancel", headers: account_headers("acme", acme_owner_token), as: :json
+    assert_response :ok
+
+    post "/api/v1/registrations",
+      params: { user: { name: "New", email: "new@example.test", password: "password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "owner-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+    owner_recovery_token = response.parsed_body.dig("session", "token")
+
+    get "/api/v1/tickets", headers: account_headers("acme", owner_recovery_token)
+    assert_response :forbidden
+
+    # Purge expired cancelled account cleans up tickets and comments without FK errors
+    acme.update!(cancelled_at: 91.days.ago)
+    acme_id = acme.id
+    Account.purge_expired_cancelled_accounts!
+    assert_not Account.exists?(acme_id)
+    assert_equal 0, Ticket.where(account_id: acme_id).count
+    assert_equal 0, Comment.where(account_id: acme_id).count
+  end
+
+test "additional edge cases: real-time ordering, boundary pagination, headers, auth, reactivation, and public visibility" do
+  account, owner_token = create_verified_business(subdomain: "edgeco", owner_email: "jo@edgeco.test")
+  second_admin = account.users.create!(
+    name: "Sam Admin",
+    email: "sam@edgeco.test",
+    password: "sam-password",
+    role: "admin",
+    verified: true
+  )
+  post "/api/v1/sessions",
+    params: { session: { email: second_admin.email, password: "sam-password" } },
+    headers: account_headers("edgeco"),
+    as: :json
+  second_admin_token = response.parsed_body.dig("session", "token")
+
+  _avery, avery_token = register_and_verify_customer(subdomain: "edgeco", name: "Avery", email: "avery@example.test")
+
+  # Missing header (400), unknown account (404), unauthenticated (401)
+  post "/api/v1/registrations", params: { user: { name: "X", email: "x@y.test", password: "pw" } }, as: :json
+  assert_response :bad_request
+
+  post "/api/v1/registrations",
+    params: { user: { name: "X", email: "x@y.test", password: "pw" } },
+    headers: account_headers("missing-co"),
+    as: :json
+  assert_response :not_found
+
+  get "/api/v1/requests", headers: account_headers("edgeco")
+  assert_response :unauthorized
+
+  get "/api/v1/tickets", headers: account_headers("edgeco")
+  assert_response :unauthorized
+
+  # Non-hash envelopes and empty updates return 422
+  post "/api/v1/registrations", params: { user: "bad" }, headers: account_headers("edgeco"), as: :json
+  assert_response :unprocessable_entity
+
+  post "/api/v1/requests", params: { request: "bad" }, headers: account_headers("edgeco", avery_token), as: :json
+  assert_response :unprocessable_entity
+
+  # Real-time ordering without travel + customer public:false attempt ignored
+  post "/api/v1/requests",
+    params: { request: { subject: "First", comment: { body: "First body", public: false } } },
+    headers: account_headers("edgeco", avery_token),
+    as: :json
+  assert_response :created
+  first_id = response.parsed_body.dig("request", "id")
+
+  post "/api/v1/requests",
+    params: { request: { subject: "Second", comment: { body: "Second body" } } },
+    headers: account_headers("edgeco", avery_token),
+    as: :json
+  assert_response :created
+  second_id = response.parsed_body.dig("request", "id")
+
+  get "/api/v1/requests", headers: account_headers("edgeco", avery_token)
+  assert_equal [ second_id, first_id ], response.parsed_body["requests"].map { |r| r["id"] }
+
+  # Customer solves second_id without comment; secondary admin reopens first_id / replies
+  patch "/api/v1/requests/#{second_id}",
+    params: { request: { status: "solved" } },
+    headers: account_headers("edgeco", avery_token),
+    as: :json
+  assert_response :ok
+  assert_equal "solved", response.parsed_body.dig("request", "status")
+
+  patch "/api/v1/tickets/#{first_id}",
+    params: { ticket: { comment: { body: "Secondary admin reply" }, status: "open" } },
+    headers: account_headers("edgeco", second_admin_token),
+    as: :json
+  assert_response :ok
+  assert_equal "open", response.parsed_body.dig("ticket", "status")
+
+  # Now first_id is most recently active on both /tickets and /requests
+  get "/api/v1/tickets", headers: account_headers("edgeco", second_admin_token)
+  assert_equal [ first_id, second_id ], response.parsed_body["tickets"].map { |t| t["id"] }
+
+  get "/api/v1/requests", headers: account_headers("edgeco", avery_token)
+  assert_equal [ first_id, second_id ], response.parsed_body["requests"].map { |r| r["id"] }
+
+  # Customer comment forced public: true; staff private comment hidden from customer
+  patch "/api/v1/tickets/#{first_id}",
+    params: { ticket: { comment: { body: "Internal staff note", public: false } } },
+    headers: account_headers("edgeco", owner_token),
+    as: :json
+  assert_response :ok
+
+  get "/api/v1/tickets/#{first_id}/comments", headers: account_headers("edgeco", owner_token)
+  assert_equal 3, response.parsed_body["count"]
+  assert_equal [ true, true, false ], response.parsed_body["comments"].map { |c| c["public"] }
+
+  get "/api/v1/requests/#{first_id}/comments", headers: account_headers("edgeco", avery_token)
+  assert_equal 2, response.parsed_body["count"]
+  assert_equal [ true, true ], response.parsed_body["comments"].map { |c| c["public"] }
+
+  # Boundary pagination (count == per_page == 2), out-of-range page, and malformed pagination params
+  get "/api/v1/tickets", params: { page: 1, per_page: 2 }, headers: account_headers("edgeco", owner_token)
+  assert_response :ok
+  assert_equal 2, response.parsed_body["count"]
+  assert_nil response.parsed_body["next_page"]
+  assert_nil response.parsed_body["previous_page"]
+
+  get "/api/v1/tickets", params: { page: 4, per_page: 2 }, headers: account_headers("edgeco", owner_token)
+  assert_response :ok
+  assert_equal [], response.parsed_body["tickets"]
+  assert_equal 2, response.parsed_body["count"]
+  assert_equal 4, response.parsed_body["page"]
+  assert_nil response.parsed_body["next_page"]
+  assert_equal 1, response.parsed_body["previous_page"]
+
+  get "/api/v1/tickets", params: { page: 0, per_page: -5 }, headers: account_headers("edgeco", owner_token)
+  assert_response :ok
+  assert_equal 1, response.parsed_body["page"]
+  assert_equal 25, response.parsed_body["per_page"]
+
+  get "/api/v1/tickets", params: { "page[]" => 1 }, headers: account_headers("edgeco", owner_token)
+  assert_response :ok
+
+  # Non-numeric IDs return 404
+  get "/api/v1/tickets/not-an-id", headers: account_headers("edgeco", owner_token)
+  assert_response :not_found
+  get "/api/v1/requests/not-an-id", headers: account_headers("edgeco", avery_token)
+  assert_response :not_found
+
+  # Unknown keys only in PATCH return 422
+  patch "/api/v1/tickets/#{first_id}", params: { ticket: { unknown: 1 } }, headers: account_headers("edgeco", owner_token), as: :json
+  assert_response :unprocessable_entity
+  patch "/api/v1/requests/#{first_id}", params: { request: { unknown: 1 } }, headers: account_headers("edgeco", avery_token), as: :json
+  assert_response :unprocessable_entity
+
+  # Cancel and reactivate preserves all tickets and comments
+  post "/api/v1/account/cancel", headers: account_headers("edgeco", owner_token), as: :json
+  assert_response :ok
+
+  post "/api/v1/sessions",
+    params: { session: { email: "jo@edgeco.test", password: "owner-password" } },
+    headers: account_headers("edgeco"),
+    as: :json
+  recovery_token = response.parsed_body.dig("session", "token")
+
+  post "/api/v1/account/reactivate", headers: account_headers("edgeco", recovery_token), as: :json
+  assert_response :ok
+
+  get "/api/v1/tickets", headers: account_headers("edgeco", recovery_token)
+  assert_response :ok
+  assert_equal 2, response.parsed_body["count"]
+end
+end
