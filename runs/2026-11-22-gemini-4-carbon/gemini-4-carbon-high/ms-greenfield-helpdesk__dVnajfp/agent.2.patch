+++ b/app/controllers/api/v1/requests_controller.rb
@@ -0,0 +1,164 @@
+module Api
+  module V1
+    class RequestsController < BaseController
+      before_action :require_account!
+      before_action :authenticate_user!
+      before_action :ensure_account_active!
+      before_action :require_customer!
+      before_action :set_ticket, only: %i[show update comments]
+
+      def index
+        scope = current_account.tickets.where(requester_id: current_user.id).recent_activity
+        records, meta = paginate(scope)
+
+        render json: {
+          requests: records.map(&:request_json),
+          **meta
+        }, status: :ok
+      end
+
+      def show
+        render json: { request: @ticket.request_json }, status: :ok
+      end
+
+      def comments
+        scope = @ticket.comments.public_only.chronological
+        records, meta = paginate(scope, includes: :author)
+
+        render json: {
+          comments: records.map(&:api_json),
+          **meta
+        }, status: :ok
+      end
+
+      def create
+        req_attrs = require_hash_param(:request)
+        raw_subject = req_attrs[:subject]
+
+        ticket = current_account.tickets.new(
+          requester: current_user,
+          subject: raw_subject.is_a?(String) ? raw_subject : nil,
+          status: "open"
+        )
+
+        comment_attrs = req_attrs[:comment]
+        unless comment_attrs.is_a?(ActionController::Parameters) || comment_attrs.is_a?(Hash)
+          ticket.valid?
+          combined_errors = ticket.errors.to_hash(true)
+          combined_errors[:comment] = [ "Comment can't be blank" ]
+          all_messages = ticket.errors.full_messages + [ "Comment can't be blank" ]
+          return render json: {
+            error: all_messages.to_sentence,
+            errors: combined_errors
+          }, status: :unprocessable_entity
+        end
+
+        raw_body = comment_attrs[:body]
+        comment = Comment.new(
+          account: current_account,
+          ticket: ticket,
+          author: current_user,
+          body: raw_body.is_a?(String) ? raw_body : nil,
+          public: true
+        )
+
+        ticket_valid = ticket.valid?
+        comment_valid = comment.valid?
+
+        unless ticket_valid && comment_valid
+          combined_errors = ticket.errors.to_hash(true)
+          comment.errors.to_hash(true).each do |field, messages|
+            combined_errors[:"comment.#{field}"] = messages
+          end
+          all_messages = ticket.errors.full_messages + comment.errors.full_messages
+          return render json: {
+            error: all_messages.to_sentence,
+            errors: combined_errors
+          }, status: :unprocessable_entity
+        end
+
+        ActiveRecord::Base.transaction do
+          ticket.save!
+          comment.ticket = ticket
+          comment.save!
+        end
+
+        render json: { request: ticket.request_json }, status: :created
+      end
+
+      def update
+        req_attrs = require_hash_param(:request)
+        has_comment = req_attrs.key?(:comment)
+        has_status = req_attrs.key?(:status)
+
+        unless has_comment || has_status
+          return render json: {
+            error: "Comment or status is required",
+            errors: { base: [ "Comment or status is required" ] }
+          }, status: :unprocessable_entity
+        end
+
+        combined_errors = {}
+        all_messages = []
+
+        if has_status
+          raw_status = req_attrs[:status]
+          if raw_status.is_a?(String) && raw_status == "solved"
+            @ticket.status = "solved"
+          else
+            combined_errors[:status] = [ "Status is not included in the list" ]
+            all_messages << "Status is not included in the list"
+          end
+        elsif @ticket.status.in?(%w[pending solved])
+          @ticket.status = "open"
+        end
+
+        comment = nil
+        if has_comment
+          comment_attrs = req_attrs[:comment]
+          if comment_attrs.is_a?(ActionController::Parameters) || comment_attrs.is_a?(Hash)
+            raw_body = comment_attrs[:body]
+            comment = @ticket.comments.new(
+              account: current_account,
+              author: current_user,
+              body: raw_body.is_a?(String) ? raw_body : nil,
+              public: true
+            )
+
+            unless comment.valid?
+              comment.errors.to_hash(true).each do |field, messages|
+                combined_errors[:"comment.#{field}"] = messages
+              end
+              all_messages.concat(comment.errors.full_messages)
+            end
+          else
+            combined_errors[:comment] = [ "Comment can't be blank" ]
+            all_messages << "Comment can't be blank"
+          end
+        end
+
+        if combined_errors.any?
+          return render json: {
+            error: all_messages.to_sentence,
+            errors: combined_errors
+          }, status: :unprocessable_entity
+        end
+
+        now = Time.current
+        ActiveRecord::Base.transaction do
+          comment.save! if comment
+          @ticket.updated_at = now
+          @ticket.save!
+        end
+
+        render json: { request: @ticket.request_json }, status: :ok
+      end
+
+      private
+
+      def set_ticket
+        @ticket = current_account.tickets.where(requester_id: current_user.id).find(params[:id])
+      end
+    end
+  end
+end
