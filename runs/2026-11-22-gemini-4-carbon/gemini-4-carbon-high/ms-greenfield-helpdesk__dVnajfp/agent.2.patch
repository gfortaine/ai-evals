--- /dev/null
+++ b/app/models/comment.rb
@@ -0,0 +1,39 @@
+class Comment < ApplicationRecord
+  belongs_to :account
+  belongs_to :ticket
+  belongs_to :author, class_name: "User"
+
+  validates :body, presence: true
+  validates :public, inclusion: { in: [ true, false ] }
+  validate :associations_belong_to_account
+
+  scope :public_only, -> { where(public: true) }
+  scope :chronological, -> { order(created_at: :asc, id: :asc) }
+
+  def api_json
+    {
+      id: id,
+      body: body,
+      public: self[:public],
+      author: {
+        id: author.id,
+        name: author.name
+      },
+      created_at: created_at
+    }
+  end
+
+  private
+
+  def associations_belong_to_account
+    return if account_id.nil?
+
+    if ticket.present? && ticket.account_id.present? && ticket.account_id != account_id
+      errors.add(:ticket, :invalid)
+    end
+
+    if author.present? && author.account_id.present? && author.account_id != account_id
+      errors.add(:author, :invalid)
+    end
+  end
+end
diff --git a/app/models/ticket.rb b/app/models/ticket.rb
new file mode 100644
index 0000000..26abf28
--- /dev/null
+++ b/app/models/ticket.rb
@@ -0,0 +1,52 @@
+class Ticket < ApplicationRecord
+  STATUSES = %w[open pending solved].freeze
+
+  belongs_to :account
+  belongs_to :requester, class_name: "User"
+
+  has_many :comments, dependent: :delete_all
+
+  normalizes :subject, with: ->(subject) { subject.to_s.strip }
+
+  validates :subject, presence: true
+  validates :status, presence: true, inclusion: { in: STATUSES }
+  validate :requester_belongs_to_account
+
+  scope :recent_activity, -> { order(updated_at: :desc, id: :desc) }
+
+  def request_json
+    {
+      id: id,
+      subject: subject,
+      status: status,
+      requester_id: requester_id,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  def ticket_json
+    {
+      id: id,
+      subject: subject,
+      status: status,
+      requester_id: requester_id,
+      requester: {
+        id: requester.id,
+        name: requester.name,
+        email: requester.email
+      },
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  private
+
+  def requester_belongs_to_account
+    return if account_id.nil? || requester.nil? || requester.account_id.nil?
+    return if requester.account_id == account_id
+
+    errors.add(:requester, :invalid)
+  end
+end
