index 0000000..0fe338f
--- /dev/null
+++ b/config/initializers/action_mailbox.rb
@@ -0,0 +1,37 @@
+module HelpdeskInboundEmailExtensions
+  module ClassMethods
+    def create_and_extract_message_id!(source, **options)
+      message_checksum = OpenSSL::Digest::SHA1.hexdigest(source)
+      message_id = extract_message_id(source) || generate_missing_message_id(message_checksum)
+
+      where(
+        message_id: message_id,
+        message_checksum: message_checksum,
+        status: %i[bounced failed]
+      ).find_each(&:destroy!)
+
+      super
+    end
+
+    private
+
+    def extract_message_id(source)
+      raw = super
+      cleaned = raw.to_s.strip.sub(/\A<+/, "").sub(/>+\z/, "").strip
+      cleaned.presence
+    end
+  end
+
+  def route_later
+    if Rails.env.test?
+      route
+    else
+      super
+    end
+  end
+end
+
+ActiveSupport.on_load(:action_mailbox_inbound_email) do
+  prepend HelpdeskInboundEmailExtensions
+  singleton_class.prepend HelpdeskInboundEmailExtensions::ClassMethods
+end
