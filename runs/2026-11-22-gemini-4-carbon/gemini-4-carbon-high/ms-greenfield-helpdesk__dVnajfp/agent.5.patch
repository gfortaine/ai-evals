+      ActionMailer::Base.deliveries.clear
+
+      # 1. Multipart mixed with text/plain attachment BEFORE text/plain body uses the body, not the attachment
+      mail_with_attachment = Mail.new do |m|
+        m.from "irene@customer.test"
+        m.to "acme@support.example.test"
+        m.subject "Re: Crash report"
+        m.add_file filename: "crash.txt", content: "ATTACHMENT CONTENT SHOULD NOT BE TICKET BODY"
+        m.text_part { body "Actual plain-text message body" }
+        m.html_part { body "<p>HTML part</p>" }
+      end
+      post_raw_inbound_email(mail_with_attachment.to_s)
+      assert_response :no_content
+      t1 = acme.tickets.order(:id).last
+      assert_equal "Re: Crash report", t1.subject
+      assert_equal "Actual plain-text message body", t1.comments.first.body
+
+      # Agent public reply emails requester and avoids double "Re: Re:"
+      ActionMailer::Base.deliveries.clear
+      patch "/api/v1/tickets/#{t1.id}",
+        params: { ticket: { status: "solved", comment: { body: "Agent reply here" } } },
+        headers: account_headers("acme", agent_token),
+        as: :json
+      assert_response :ok
+      agent_mail = ActionMailer::Base.deliveries.sole
+      assert_equal [ "irene@customer.test" ], agent_mail.to
+      assert_equal "Re: Crash report", agent_mail.subject
+      assert_includes agent_mail.body.decoded, "Agent reply here"
+      reply_addr = agent_mail.reply_to.first
+
+      # Invalid empty reply to solved ticket does not reopen or block valid retry with same Message-ID
+      post_raw_inbound_email(
+        "From: irene@customer.test\r\nTo: #{reply_addr}\r\nSubject: Re: Crash report\r\nMessage-ID: <reply-retry@customer.test>\r\n\r\n   "
+      )
+      assert_equal "solved", t1.reload.status
+      assert_equal 2, t1.comments.count
+
+      post_raw_inbound_email(
+        "From: irene@customer.test\r\nTo: #{reply_addr}\r\nSubject: Re: Crash report\r\nMessage-ID: reply-retry@customer.test\r\n\r\nFollow-up with real text"
+      )
+      assert_equal "open", t1.reload.status
+      assert_equal 3, t1.comments.count
+
+      # Duplicate with angle brackets is deduplicated against bracketless Message-ID
+      post_raw_inbound_email(
+        "From: irene@customer.test\r\nTo: #{reply_addr}\r\nSubject: Re: Crash report\r\nMessage-ID: <reply-retry@customer.test>\r\n\r\nFollow-up with real text"
+      )
+      assert_equal 3, t1.reload.comments.count
+
+      # 2. Raw 8-bit ISO-8859-1 binary payload
+      iso_raw = (+"From: Jose <jose@customer.test>\r\n" \
+        "To: undisclosed-recipients:;\r\n" \
+        "X-Original-To: <acme@support.example.test>\r\n" \
+        "Subject: ISO test\r\n" \
+        "MIME-Version: 1.0\r\n" \
+        "Content-Type: text/plain; charset=ISO-8859-1\r\n" \
+        "Content-Transfer-Encoding: 8bit\r\n\r\n" \
+        "Caf\xE9 support").force_encoding(Encoding::ASCII_8BIT)
+      assert_difference -> { acme.tickets.count } => 1 do
+        post_raw_inbound_email(iso_raw)
+      end
+      assert_equal "Café support", acme.tickets.order(:id).last.comments.first.body
+
+      # 3. HTML-only email falls back to stripped plain text; style-only HTML is rejected
+      style_only_html = "From: k@customer.test\r\nTo: acme@support.example.test\r\nSubject: Empty HTML\r\nContent-Type: text/html; charset=UTF-8\r\n\r\n<html><head><style>p{color:red}</style></head><body>  </body></html>"
+      assert_no_difference -> { acme.tickets.count } do
+        post_raw_inbound_email(style_only_html)
+      end
+
+      valid_html_only = "From: k@customer.test\r\nTo: acme@support.example.test\r\nSubject: HTML client\r\nContent-Type: text/html; charset=UTF-8\r\n\r\n<html><head><style>p{color:red}</style></head><body><p>Hello <b>Acme</b>!</p></body></html>"
+      assert_difference -> { acme.tickets.count } => 1 do
+        post_raw_inbound_email(valid_html_only)
+      end
+      assert_equal "Hello Acme!", acme.tickets.order(:id).last.comments.first.body
+
+      # 4. multipart/report bounce DSN is ignored
+      dsn_raw = <<~EML
+        From: postmaster@somewhere.test
+        To: acme@support.example.test
+        Subject: Undelivered Mail Returned to Sender
+        MIME-Version: 1.0
+        Content-Type: multipart/report; report-type=delivery-status; boundary="BOUND"
+
+        --BOUND
+        Content-Type: text/plain
+
+        This is the mail system at host somewhere.test.
+        --BOUND--
+      EML
+      assert_no_difference -> { acme.tickets.count } do
+        post_raw_inbound_email(dsn_raw)
+      end
+    end
+  end
+end
