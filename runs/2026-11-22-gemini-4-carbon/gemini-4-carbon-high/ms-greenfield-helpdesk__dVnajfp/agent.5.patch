+class EmailMimeAndLiveRelayTest < ActionDispatch::IntegrationTest
+  INGRESS_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  INGRESS_PASSWORD = "live-relay-password"
+
+  def account_headers(subdomain, token = nil)
+    headers = { "X-Helpdesk-Account" => subdomain }
+    headers["Authorization"] = "Bearer #{token}" if token.present?
+    headers
+  end
+
+  def relay_auth_header
+    "Basic #{Base64.strict_encode64("actionmailbox:#{INGRESS_PASSWORD}")}"
+  end
+
+  def post_raw_inbound_email(raw_source)
+    post INGRESS_PATH,
+      params: raw_source,
+      headers: {
+        "Content-Type" => "message/rfc822",
+        "Authorization" => relay_auth_header
+      }
+  end
+
+  def create_verified_business(subdomain: "acme", owner_email: "jo@acme.test", password: "owner-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: subdomain.capitalize,
+          subdomain: subdomain,
+          admin: { name: "Jo", email: owner_email, password: password }
+        }
+      },
+      as: :json
+    assert_response :created
+    token = ActionMailer::Base.deliveries.last.body.decoded[/token=([A-Za-z0-9_-]+)/, 1]
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: owner_email, password: password } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+    session_token = response.parsed_body.dig("session", "token")
+    ActionMailer::Base.deliveries.clear
+
+    [ Account.find_by!(subdomain: subdomain), session_token ]
+  end
+
