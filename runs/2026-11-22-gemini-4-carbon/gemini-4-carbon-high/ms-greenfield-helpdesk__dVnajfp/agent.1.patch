+
+    # Changing password in acme does not revoke globex session
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "acme-password", password: "acme-new-password" } },
+      headers: account_headers("acme", acme_session),
+      as: :json
+    assert_response :ok
+
+    get "/api/v1/me", headers: account_headers("globex", globex_session)
