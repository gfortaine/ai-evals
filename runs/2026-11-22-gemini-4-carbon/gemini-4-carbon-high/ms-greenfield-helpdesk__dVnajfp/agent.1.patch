+
+    # Confirm globex too
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: globex_verify } },
+      headers: account_headers("globex"),
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@shared.test", password: "acme-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+    acme_session = response.parsed_body.dig("session", "token")
+
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@shared.test", password: "globex-password" } },
+      headers: account_headers("globex"),
+      as: :json
+    assert_response :created
+    globex_session = response.parsed_body.dig("session", "token")
+
+    # Cross-tenant session usage is rejected
+    get "/api/v1/me", headers: account_headers("globex", acme_session)
