+
+class BusinessSignupAndAuthTest < ActionDispatch::IntegrationTest
+  def signup_account(name: "Acme", subdomain: "acme", admin_name: "Jo", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: {
+            name: admin_name,
+            email: email,
+            password: password
+          }
+        }
+      },
+      as: :json
+  end
+
+  def extract_token_from_last_email(expected_path:, expected_account:)
+    mail = ActionMailer::Base.deliveries.last
+    assert_not_nil mail, "Expected an email to have been delivered"
+    body = mail.body.decoded
+    pattern = %r{#{Regexp.escape(expected_path)}\?account=#{Regexp.escape(expected_account)}&token=([A-Za-z0-9_-]+)}
+    match = body.match(pattern)
+    assert_not_nil match, "Expected #{expected_path}?account=#{expected_account}&token=... in:\n#{body}"
+    match[1]
+  end
+
+  def account_headers(subdomain, token = nil)
+    headers = { "X-Helpdesk-Account" => subdomain }
+    headers["Authorization"] = "Bearer #{token}" if token
+    headers
+  end
+
+  test "full owner lifecycle: signup, email verification, portal, login, profile update, password change, logout" do
+    with_env("HELPDESK_FRONTEND_URL" => nil, "HELPDESK_MAIL_FROM" => nil) do
+      assert_difference -> { Account.count } => 1, -> { User.count } => 1, -> { ActionMailer::Base.deliveries.size } => 1 do
+        signup_account
+      end
+
+      assert_response :created
+      body = response.parsed_body
+
+      account_json = body.fetch("account")
+      user_json = body.fetch("user")
+
+      assert_kind_of Integer, account_json.fetch("id")
+      assert_equal "Acme", account_json.fetch("name")
+      assert_equal "acme", account_json.fetch("subdomain")
+      assert_not_nil account_json.fetch("created_at")
+      assert_not_nil account_json.fetch("updated_at")
+
+      assert_kind_of Integer, user_json.fetch("id")
+      assert_equal "Jo", user_json.fetch("name")
+      assert_equal "jo@acme.test", user_json.fetch("email")
+      assert_equal "admin", user_json.fetch("role")
+      assert_equal false, user_json.fetch("verified")
+      assert_not_nil user_json.fetch("created_at")
+      assert_not_nil user_json.fetch("updated_at")
+      assert_not user_json.key?("password")
+      assert_not user_json.key?("password_digest")
+
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "support@example.test" ], mail.from
+      assert_equal [ "jo@acme.test" ], mail.to
+      assert_includes mail.body.decoded, "http://localhost:3001/verify-email?account=acme&token="
+      verify_token = extract_token_from_last_email(expected_path: "http://localhost:3001/verify-email", expected_account: "acme")
+
+      # Public portal returns only name and subdomain inside portal
+      get "/api/v1/portal", headers: account_headers("acme")
+      assert_response :ok
+      assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, response.parsed_body)
+
+      # Unauthenticated GET /account is rejected
+      get "/api/v1/account", headers: account_headers("acme")
+      assert_response :unauthorized
+
+      # Cannot sign in before verifying email
+      post "/api/v1/sessions",
+        params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :forbidden
+
+      # Confirm email verification
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: verify_token } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+      assert_equal true, response.parsed_body.dig("user", "verified")
+
+      # Confirming same token again fails
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: verify_token } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_entity
+
+      # Sign in after verifying email (create 2 sessions to test single-session signout)
+      post "/api/v1/sessions",
+        params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :created
+      login_body = response.parsed_body
+      token_1 = login_body.dig("session", "token")
+      assert token_1.present?
+      assert_equal user_json["id"], login_body.dig("user", "id")
+      assert_equal true, login_body.dig("user", "verified")
+      assert_equal account_json["id"], login_body.dig("account", "id")
+
+      post "/api/v1/sessions",
+        params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :created
+      token_2 = response.parsed_body.dig("session", "token")
+      assert_not_equal token_1, token_2
+
+      # Signed-in user gets full account at GET /account
+      get "/api/v1/account", headers: account_headers("acme", token_1)
+      assert_response :ok
+      full_account = response.parsed_body.fetch("account")
+      assert_equal account_json["id"], full_account["id"]
+      assert_equal "Acme", full_account["name"]
+      assert_equal "acme", full_account["subdomain"]
+      assert_not_nil full_account["created_at"]
+      assert_not_nil full_account["updated_at"]
+
+      # GET /me and PATCH /me
+      get "/api/v1/me", headers: account_headers("acme", token_1)
+      assert_response :ok
+      assert_equal "Jo", response.parsed_body.dig("user", "name")
+
+      patch "/api/v1/me",
+        params: { user: { name: "Jo Smith", role: "customer", verified: false } },
+        headers: account_headers("acme", token_1),
+        as: :json
+      assert_response :ok
+      assert_equal "Jo Smith", response.parsed_body.dig("user", "name")
+      assert_equal "admin", response.parsed_body.dig("user", "role")
+      assert_equal true, response.parsed_body.dig("user", "verified")
+
+      # DELETE /session signs out ONLY that session
+      delete "/api/v1/session", headers: account_headers("acme", token_1)
+      assert_response :no_content
+
+      get "/api/v1/me", headers: account_headers("acme", token_1)
+      assert_response :unauthorized
+
+      get "/api/v1/me", headers: account_headers("acme", token_2)
+      assert_response :ok
+
+      # Create a 3rd session, then change password and verify ALL existing sessions are signed out
+      post "/api/v1/sessions",
+        params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      token_3 = response.parsed_body.dig("session", "token")
+
+      # Wrong current password fails without revoking sessions
+      put "/api/v1/me/password",
+        params: { password_change: { current_password: "wrong-password", password: "my-new-password" } },
+        headers: account_headers("acme", token_2),
+        as: :json
+      assert_response :unprocessable_entity
+
+      get "/api/v1/me", headers: account_headers("acme", token_2)
+      assert_response :ok
+
+      # Blank new password fails without revoking sessions
+      put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-first-password", password: "" } },
+        headers: account_headers("acme", token_2),
+        as: :json
+      assert_response :unprocessable_entity
+
+      get "/api/v1/me", headers: account_headers("acme", token_2)
+      assert_response :ok
+
+      # Valid password change signs out existing sessions
+      put "/api/v1/me/password",
+        params: { password_change: { current_password: "my-first-password", password: "my-new-password" } },
+        headers: account_headers("acme", token_2),
+        as: :json
+      assert_response :ok
+
+      get "/api/v1/me", headers: account_headers("acme", token_2)
+      assert_response :unauthorized
+      get "/api/v1/me", headers: account_headers("acme", token_3)
+      assert_response :unauthorized
+
+      # Old password fails login, new password succeeds
+      post "/api/v1/sessions",
+        params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unauthorized
+
+      post "/api/v1/sessions",
+        params: { session: { email: "jo@acme.test", password: "my-new-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :created
+    end
+  end
+
+  test "resending email verification and password reset links replaces old ones and respects custom env vars" do
+    with_env(
+      "HELPDESK_FRONTEND_URL" => "https://portal.helpdesk.test/",
+      "HELPDESK_MAIL_FROM" => "noreply@helpdesk.test"
+    ) do
+      signup_account
+      assert_response :created
+
+      mail_1 = ActionMailer::Base.deliveries.last
+      assert_equal [ "noreply@helpdesk.test" ], mail_1.from
+      token_v1 = extract_token_from_last_email(expected_path: "https://portal.helpdesk.test/verify-email", expected_account: "acme")
+
+      # Request another verification link
+      post "/api/v1/email_verifications",
+        params: { email_verification: { email: "jo@acme.test" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+
+      token_v2 = extract_token_from_last_email(expected_path: "https://portal.helpdesk.test/verify-email", expected_account: "acme")
+      assert_not_equal token_v1, token_v2
+
+      # Old verification token was replaced and no longer works
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: token_v1 } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_entity
+
+      # New verification token works
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: token_v2 } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+
+      # Sign in to create an active session before password reset
+      post "/api/v1/sessions",
+        params: { session: { email: "jo@acme.test", password: "my-first-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :created
+      active_token = response.parsed_body.dig("session", "token")
+
+      # Request password reset twice; 2nd link replaces 1st
+      post "/api/v1/password_resets",
+        params: { password_reset: { email: "jo@acme.test" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+      reset_1 = extract_token_from_last_email(expected_path: "https://portal.helpdesk.test/reset-password", expected_account: "acme")
+
+      post "/api/v1/password_resets",
+        params: { password_reset: { email: "jo@acme.test" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+      reset_mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "noreply@helpdesk.test" ], reset_mail.from
+      reset_2 = extract_token_from_last_email(expected_path: "https://portal.helpdesk.test/reset-password", expected_account: "acme")
+      assert_not_equal reset_1, reset_2
+
+      # Old reset token fails
+      post "/api/v1/password_resets/confirm",
+        params: { password_reset: { token: reset_1, password: "recovered-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_entity
+
+      # Blank password fails without consuming reset_2
+      post "/api/v1/password_resets/confirm",
+        params: { password_reset: { token: reset_2, password: "" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_entity
+
+      # Valid reset_2 succeeds and revokes existing sessions
+      post "/api/v1/password_resets/confirm",
+        params: { password_reset: { token: reset_2, password: "recovered-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :ok
+
+      # Existing session was revoked
+      get "/api/v1/me", headers: account_headers("acme", active_token)
+      assert_response :unauthorized
+
+      # Reset token cannot be reused
+      post "/api/v1/password_resets/confirm",
+        params: { password_reset: { token: reset_2, password: "another-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :unprocessable_entity
+
+      # Login works with recovered password
+      post "/api/v1/sessions",
+        params: { session: { email: "jo@acme.test", password: "recovered-password" } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :created
+    end
+  end
+
+  test "same email can belong to different businesses with strict tenant isolation" do
+    signup_account(name: "Acme", subdomain: "acme", admin_name: "Jo Acme", email: "jo@shared.test", password: "acme-password")
+    assert_response :created
+    acme_verify = extract_token_from_last_email(expected_path: "http://localhost:3001/verify-email", expected_account: "acme")
+
+    signup_account(name: "Globex", subdomain: "globex", admin_name: "Jo Globex", email: "jo@shared.test", password: "globex-password")
+    assert_response :created
+    globex_verify = extract_token_from_last_email(expected_path: "http://localhost:3001/verify-email", expected_account: "globex")
+
+    # Cannot confirm acme token against globex
