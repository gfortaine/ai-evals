@@ -0,0 +1,43 @@
+class UserMailer < ApplicationMailer
+  def email_verification(user:, token:)
+    @user = user
+    @account = user.account
+    @verification_url = HelpdeskConfig.verify_email_url(account: @account, token: token)
+
+    mail(
+      from: HelpdeskConfig.mail_from,
+      to: @user.email,
+      subject: "Verify your email for #{@account.name}",
+      content_type: "text/plain; charset=UTF-8",
+      content_transfer_encoding: "7bit",
+      body: <<~TEXT
+        Hi #{@user.name},
+
+        Please verify your email address for #{@account.name} by visiting the link below:
+
+        #{@verification_url}
+      TEXT
+    )
+  end
+
+  def password_reset(user:, token:)
+    @user = user
+    @account = user.account
+    @reset_url = HelpdeskConfig.reset_password_url(account: @account, token: token)
+
+    mail(
+      from: HelpdeskConfig.mail_from,
+      to: @user.email,
+      subject: "Reset your password for #{@account.name}",
+      content_type: "text/plain; charset=UTF-8",
+      content_transfer_encoding: "7bit",
+      body: <<~TEXT
+        Hi #{@user.name},
+
+        You can reset your password for #{@account.name} by visiting the link below:
+
+        #{@reset_url}
+      TEXT
+    )
+  end
+end
diff --git a/app/models/account.rb b/app/models/account.rb
new file mode 100644
index 0000000..a5d9769
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,88 @@
+class Account < ApplicationRecord
+  CANCELLATION_RETENTION_PERIOD = 90.days
+  SUBDOMAIN_FORMAT = /\A[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\z/
+
+  belongs_to :owner, class_name: "User", optional: true
+
+  has_many :sessions, dependent: :delete_all
+  has_many :email_verification_tokens, dependent: :delete_all
+  has_many :password_reset_tokens, dependent: :delete_all
+  has_many :users, dependent: :destroy
+
+  before_destroy :clear_owner_reference, prepend: true
+
+  normalizes :name, with: ->(name) { name.to_s.strip }
+  normalizes :subdomain, with: ->(subdomain) { subdomain.to_s.strip.downcase }
+
+  validates :name, presence: true
+  validates :subdomain,
+    presence: true,
+    length: { maximum: 63 },
+    format: { with: SUBDOMAIN_FORMAT, allow_blank: true },
+    uniqueness: { case_sensitive: false }
+
+  scope :active, -> { where(cancelled_at: nil) }
+  scope :cancelled, -> { where.not(cancelled_at: nil) }
+  scope :purgeable, -> { where("cancelled_at <= ?", CANCELLATION_RETENTION_PERIOD.ago) }
+
+  def self.purge_expired_cancelled_accounts!
+    purged_count = 0
+    purgeable.find_each do |account|
+      account.destroy!
+      purged_count += 1
+    end
+    purged_count
+  end
+
+  def active?
+    cancelled_at.nil?
+  end
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  def cancellation_expired?
+    cancelled? && cancelled_at <= CANCELLATION_RETENTION_PERIOD.ago
+  end
+
+  def reactivable?
+    cancelled? && !cancellation_expired?
+  end
+
+  def cancel!
+    transaction do
+      update!(cancelled_at: Time.current)
+      sessions.delete_all
+    end
+  end
+
+  def reactivate!
+    update!(cancelled_at: nil)
+  end
+
+  def portal_json
+    {
+      name: name,
+      subdomain: subdomain
+    }
+  end
+
+  def api_json
+    {
+      id: id,
+      name: name,
+      subdomain: subdomain,
+      owner_id: owner_id,
+      cancelled_at: cancelled_at,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  private
+
+  def clear_owner_reference
+    update_column(:owner_id, nil) if owner_id.present?
+  end
+end
