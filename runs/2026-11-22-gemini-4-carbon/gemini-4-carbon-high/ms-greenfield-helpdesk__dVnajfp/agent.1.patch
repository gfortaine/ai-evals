@@ -0,0 +1,43 @@
+module Api
+  module V1
+    class EmailVerificationsController < BaseController
+      before_action :require_account!
+      before_action :ensure_account_active!
+
+      def create
+        ev_params = require_hash_param(:email_verification)
+        email = ev_params[:email].to_s.strip.downcase
+
+        if email.blank?
+          return render json: {
+            error: "Email can't be blank",
+            errors: { email: [ "can't be blank" ] }
+          }, status: :unprocessable_entity
+        end
+
+        user = current_account.users.find_by(email: email)
+        if user && !user.verified?
+          token_record = user.issue_email_verification_token!
+          UserMailer.email_verification(user: user, token: token_record.token).deliver_now
+        end
+
+        render json: { status: "ok" }, status: :ok
+      end
+
+      def confirm
+        ev_params = require_hash_param(:email_verification)
+        raw_token = ev_params[:token].to_s.strip
+
+        token_record = current_account.email_verification_tokens.includes(:user).find_by_raw_token(raw_token)
+        if token_record.nil? || token_record.expired? || token_record.user.account_id != current_account.id
+          return render json: { error: "Invalid or expired email verification token" }, status: :unprocessable_entity
+        end
+
+        user = token_record.user
+        user.verify_email!
+
+        render json: { user: user.api_json }, status: :ok
+      end
+    end
+  end
+end
