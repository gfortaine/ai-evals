diff --git a/test/integration/account_cancellation_and_purge_test.rb b/test/integration/account_cancellation_and_purge_test.rb
new file mode 100644
index 0000000..3c24b42
--- /dev/null
+++ b/test/integration/account_cancellation_and_purge_test.rb
@@ -0,0 +1,226 @@
+require "test_helper"
+require "open3"
+
+class AccountCancellationAndPurgeTest < ActionDispatch::IntegrationTest
+  def create_verified_account_with_owner(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: subdomain.capitalize,
+          subdomain: subdomain,
+          admin: {
+            name: "Jo",
+            email: email,
+            password: password
+          }
+        }
+      },
+      as: :json
+    assert_response :created
+
+    mail = ActionMailer::Base.deliveries.last
+    token = mail.body.decoded[/token=([A-Za-z0-9_-]+)/, 1]
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+
+    Account.find_by!(subdomain: subdomain)
+  end
+
+  def login(subdomain:, email:, password:)
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+  end
+
+  def headers_for(subdomain, token = nil)
+    h = { "X-Helpdesk-Account" => subdomain }
+    h["Authorization"] = "Bearer #{token}" if token
+    h
+  end
+
+  test "owner can cancel and reactivate within 90 days; cancellation revokes sessions and stops ordinary access" do
+    account = create_verified_account_with_owner(subdomain: "acme")
+    second_admin = account.users.create!(
+      name: "Sam",
+      email: "sam@acme.test",
+      password: "sam-password",
+      role: "admin",
+      verified: true
+    )
+
+    login(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+    assert_response :created
+    owner_token_1 = response.parsed_body.dig("session", "token")
+
+    login(subdomain: "acme", email: "sam@acme.test", password: "sam-password")
+    assert_response :created
+    sam_token = response.parsed_body.dig("session", "token")
+
+    # Non-owner (even admin) cannot cancel the account
+    post "/api/v1/account/cancel", headers: headers_for("acme", sam_token), as: :json
+    assert_response :forbidden
+    assert account.reload.active?
+
+    # Owner cancels the account
+    post "/api/v1/account/cancel", headers: headers_for("acme", owner_token_1), as: :json
+    assert_response :ok
+    assert_not_nil response.parsed_body.dig("account", "cancelled_at")
+    assert account.reload.cancelled?
+    assert_equal 0, account.sessions.count
+
+    # Existing sessions are revoked (401)
+    get "/api/v1/me", headers: headers_for("acme", owner_token_1)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: headers_for("acme", sam_token)
+    assert_response :unauthorized
+
+    # Ordinary business access is stopped
+    get "/api/v1/portal", headers: headers_for("acme")
+    assert_response :forbidden
+
+    # Non-owner cannot sign in while cancelled
+    login(subdomain: "acme", email: second_admin.email, password: "sam-password")
+    assert_response :forbidden
+
+    # Owner CAN still sign in while cancelled (e.g. 89 days later)
+    travel 89.days do
+      login(subdomain: "acme", email: "jo@acme.test", password: "my-first-password")
+      assert_response :created
+      owner_recovery_token = response.parsed_body.dig("session", "token")
+      assert_not_nil response.parsed_body.dig("account", "cancelled_at")
+
+      # Even signed in as owner, ordinary endpoints remain blocked until reactivated
+      get "/api/v1/portal", headers: headers_for("acme")
+      assert_response :forbidden
+      get "/api/v1/account", headers: headers_for("acme", owner_recovery_token)
+      assert_response :forbidden
+      get "/api/v1/me", headers: headers_for("acme", owner_recovery_token)
+      assert_response :forbidden
+      patch "/api/v1/me", params: { user: { name: "Blocked" } }, headers: headers_for("acme", owner_recovery_token), as: :json
+      assert_response :forbidden
+
+      # Owner reactivates the account
+      post "/api/v1/account/reactivate", headers: headers_for("acme", owner_recovery_token), as: :json
+      assert_response :ok
+      assert_nil response.parsed_body.dig("account", "cancelled_at")
+      assert account.reload.active?
+
+      # Ordinary business access works again immediately
+      get "/api/v1/portal", headers: headers_for("acme")
+      assert_response :ok
+      get "/api/v1/account", headers: headers_for("acme", owner_recovery_token)
+      assert_response :ok
+      get "/api/v1/me", headers: headers_for("acme", owner_recovery_token)
+      assert_response :ok
+
+      # Non-owner can sign in again
+      login(subdomain: "acme", email: "sam@acme.test", password: "sam-password")
+      assert_response :created
+    end
+  end
+
+  test "cannot reactivate or sign in after 90 days of cancellation" do
+    create_verified_account_with_owner(subdomain: "expiredco")
+
+    login(subdomain: "expiredco", email: "jo@acme.test", password: "my-first-password")
+    owner_token = response.parsed_body.dig("session", "token")
+
+    post "/api/v1/account/cancel", headers: headers_for("expiredco", owner_token), as: :json
+    assert_response :ok
+
+    # Sign in at day 89 to hold a session across the 90-day mark
+    recovery_token = nil
+    travel 89.days do
+      login(subdomain: "expiredco", email: "jo@acme.test", password: "my-first-password")
+      assert_response :created
+      recovery_token = response.parsed_body.dig("session", "token")
+    end
+
+    travel 90.days + 1.second do
+      # Cannot sign in past 90 days
+      login(subdomain: "expiredco", email: "jo@acme.test", password: "my-first-password")
+      assert_response :forbidden
+
+      # Even with pre-existing recovery session, reactivation past 90 days is rejected
+      post "/api/v1/account/reactivate", headers: headers_for("expiredco", recovery_token), as: :json
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "bin/rails helpdesk:purge_cancelled_accounts permanently deletes expired cancelled accounts and all data" do
+    expired_account = create_verified_account_with_owner(subdomain: "oldcancel", email: "jo@old.test")
+    expired_account.users.create!(name: "Agent", email: "agent@old.test", password: "password", role: "agent", verified: false)
+    expired_account.users.first.issue_password_reset_token!
+    expired_account.users.last.issue_email_verification_token!
+    expired_account.sessions.create!(user: expired_account.users.first)
+    expired_account.update!(cancelled_at: 91.days.ago)
+
+    recent_cancelled = create_verified_account_with_owner(subdomain: "recentcancel", email: "jo@recent.test")
+    recent_cancelled.update!(cancelled_at: 89.days.ago)
+
+    active_account = create_verified_account_with_owner(subdomain: "stillactive", email: "jo@active.test")
+
+    expired_id = expired_account.id
+
+        Rails.application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+    Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+    Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+
+    assert_nil Account.find_by(id: expired_id)
+    assert_equal 0, User.where(account_id: expired_id).count
+    assert_equal 0, Session.where(account_id: expired_id).count
+    assert_equal 0, EmailVerificationToken.where(account_id: expired_id).count
+    assert_equal 0, PasswordResetToken.where(account_id: expired_id).count
+
+    assert Account.exists?(recent_cancelled.id)
+    assert Account.exists?(active_account.id)
+  end
+end
+
+class PurgeCancelledAccountsCliTaskTest < ActionDispatch::IntegrationTest
+  self.use_transactional_tests = false
+
+  teardown do
+    Account.find_each(&:destroy!)
+  end
+
+  test "CLI bin/rails helpdesk:purge_cancelled_accounts deletes committed expired cancelled accounts and all data" do
+    expired = Account.create!(name: "Old Co", subdomain: "oldco")
+    owner = expired.users.create!(name: "Jo", email: "jo@oldco.test", password: "password", role: "admin", verified: true)
+    expired.update!(owner: owner, cancelled_at: 91.days.ago)
+    agent = expired.users.create!(name: "Agent", email: "agent@oldco.test", password: "password", role: "agent", verified: false)
+    owner.issue_password_reset_token!
+    agent.issue_email_verification_token!
+    expired.sessions.create!(user: owner)
+
+    boundary = Account.create!(name: "Boundary Co", subdomain: "boundaryco", cancelled_at: 90.days.ago)
+    recent = Account.create!(name: "Recent Co", subdomain: "recentco", cancelled_at: 89.days.ago)
+    active = Account.create!(name: "Active Co", subdomain: "activeco")
+
+    test_db_url = ActiveRecord::Base.connection_db_config.configuration_hash.then do |cfg|
+      "postgresql:///#{cfg[:database]}?host=#{cfg[:host]}"
+    end
+
+    stdout, stderr, status = Open3.capture3(
+      { "RAILS_ENV" => "test", "DATABASE_URL" => test_db_url },
+      "bin/rails", "helpdesk:purge_cancelled_accounts",
+      chdir: Rails.root.to_s
+    )
+    assert status.success?, "Expected rake task to succeed, stderr: #{stderr}\nstdout: #{stdout}"
+
+    assert_not Account.exists?(expired.id)
+    assert_not Account.exists?(boundary.id)
+    assert_equal 0, User.where(account_id: expired.id).count
+    assert_equal 0, Session.where(account_id: expired.id).count
+    assert_equal 0, EmailVerificationToken.where(account_id: expired.id).count
+    assert_equal 0, PasswordResetToken.where(account_id: expired.id).count
+
+    assert Account.exists?(recent.id)
+    assert Account.exists?(active.id)
+  end
+end
