diff --git a/test/integration/ticket_priorities_and_filters_test.rb b/test/integration/ticket_priorities_and_filters_test.rb
new file mode 100644
index 0000000..7ea7840
--- /dev/null
+++ b/test/integration/ticket_priorities_and_filters_test.rb
@@ -0,0 +1,578 @@
+require "test_helper"
+
+class TicketPrioritiesAndFiltersTest < ActionDispatch::IntegrationTest
+  def account_headers(subdomain, token = nil)
+    headers = { "X-Helpdesk-Account" => subdomain }
+    headers["Authorization"] = "Bearer #{token}" if token.present?
+    headers
+  end
+
+  def extract_token_from_last_email
+    mail = ActionMailer::Base.deliveries.last
+    assert_not_nil mail, "Expected an email to have been sent"
+    token = mail.body.decoded[/token=([A-Za-z0-9_-]+)/, 1]
+    assert token.present?, "Expected token in email body"
+    token
+  end
+
+  def create_verified_business(name: "Acme", subdomain: "acme", owner_name: "Jo Admin", owner_email: "jo@acme.test", password: "owner-password")
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: {
+            name: owner_name,
+            email: owner_email,
+            password: password
+          }
+        }
+      },
+      as: :json
+    assert_response :created
+
+    token = extract_token_from_last_email
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: owner_email, password: password } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+
+    [ Account.find_by!(subdomain: subdomain), response.parsed_body.dig("session", "token") ]
+  end
+
+  def invite_and_login_staff(subdomain:, admin_token:, name:, email:, role: "agent", password: "staff-password")
+    post "/api/v1/invitations",
+      params: { invitation: { email: email, role: role } },
+      headers: account_headers(subdomain, admin_token),
+      as: :json
+    assert_response :created
+    inv_token = extract_token_from_last_email
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: inv_token, name: name, password: password } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+    user = User.find(response.parsed_body.dig("user", "id"))
+
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+
+    [ user, response.parsed_body.dig("session", "token") ]
+  end
+
+  def register_and_verify_customer(subdomain:, name:, email:, password: "customer-password")
+    post "/api/v1/registrations",
+      params: { user: { name: name, email: email, password: password } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+    user_id = response.parsed_body.dig("user", "id")
+
+    token = extract_token_from_last_email
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: account_headers(subdomain),
+      as: :json
+    assert_response :created
+
+    [ User.find(user_id), response.parsed_body.dig("session", "token") ]
+  end
+
+  test "ticket priority defaults to normal, is internal to staff, and supports staff updates and atomicity" do
+    _account, admin_token = create_verified_business(subdomain: "acme")
+    agent, agent_token = invite_and_login_staff(subdomain: "acme", admin_token: admin_token, name: "Sam Agent", email: "sam@acme.test")
+    _avery, avery_token = register_and_verify_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+
+    # Customer creates request; attempts to pass priority: "high" are ignored and request JSON has no priority
+    req_initial = nil
+    travel_to Time.utc(2026, 11, 21, 10, 0, 0) do
+      post "/api/v1/requests",
+        params: {
+          request: {
+            subject: "Cannot download receipt",
+            priority: "high",
+            comment: { body: "Receipt PDF fails." }
+          }
+        },
+        headers: account_headers("acme", avery_token),
+        as: :json
+      assert_response :created
+      req_initial = response.parsed_body.fetch("request")
+      assert_not req_initial.key?("priority")
+    end
+
+    ticket_id = req_initial["id"]
+
+    # Staff show & index responses include priority: "normal"
+    get "/api/v1/tickets/#{ticket_id}", headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal "normal", response.parsed_body.dig("ticket", "priority")
+
+    get "/api/v1/tickets", headers: account_headers("acme", agent_token)
+    assert_response :ok
+    assert_equal [ "normal" ], response.parsed_body.fetch("tickets").map { |t| t["priority"] }
+
+    # Customer is forbidden from updating tickets endpoint
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: { ticket: { priority: "high" } },
+      headers: account_headers("acme", avery_token),
+      as: :json
+    assert_response :forbidden
+
+    # Invalid priority values are rejected with 422 and never persist comments or changes
+    [ nil, "", "low", "urgent", "HIGH", 123, [ "high" ], { a: "b" } ].each do |bad_priority|
+      assert_no_difference -> { Comment.count } do
+        patch "/api/v1/tickets/#{ticket_id}",
+          params: {
+            ticket: {
+              priority: bad_priority,
+              comment: { body: "Should not be saved" }
+            }
+          },
+          headers: account_headers("acme", agent_token),
+          as: :json
+      end
+      assert_response :unprocessable_entity
+      assert response.parsed_body.dig("errors", "priority").present?
+    end
+
+    # Valid priority combined with invalid comment/status/assignee also fails atomically without changing priority
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: {
+        ticket: {
+          priority: "high",
+          comment: { body: "   " }
+        }
+      },
+      headers: account_headers("acme", agent_token),
+      as: :json
+    assert_response :unprocessable_entity
+    assert_equal "normal", Ticket.find(ticket_id).priority
+
+    patch "/api/v1/tickets/#{ticket_id}",
+      params: {
+        ticket: {
+          priority: "high",
+          assignee_id: 999_999
+        }
+      },
+      headers: account_headers("acme", agent_token),
+      as: :json
+    assert_response :unprocessable_entity
+    assert_equal "normal", Ticket.find(ticket_id).priority
+
+    # Agent marks ticket high priority; updates staff updated_at without touching customer request!
+    travel_to Time.utc(2026, 11, 21, 10, 5, 0) do
+      patch "/api/v1/tickets/#{ticket_id}",
+        params: { ticket: { priority: "high" } },
+        headers: account_headers("acme", agent_token),
+        as: :json
+      assert_response :ok
+      assert_equal "high", response.parsed_body.dig("ticket", "priority")
+      assert_equal "2026-11-21T10:05:00Z", Time.iso8601(response.parsed_body.dig("ticket", "updated_at")).utc.iso8601
+    end
+
+    # Customer request show & list remain 100% unchanged and never include priority
+    get "/api/v1/requests/#{ticket_id}", headers: account_headers("acme", avery_token)
+    assert_response :ok
+    assert_equal req_initial, response.parsed_body.fetch("request")
+    assert_not response.parsed_body.fetch("request").key?("priority")
+
+    get "/api/v1/requests", headers: account_headers("acme", avery_token)
+    assert_response :ok
+    assert_equal [ req_initial ], response.parsed_body.fetch("requests")
+
+    # Customer cannot probe internal priority via query param on /requests
+    get "/api/v1/requests", params: { priority: "normal" }, headers: account_headers("acme", avery_token)
+    assert_response :ok
+    assert_equal [ ticket_id ], response.parsed_body.fetch("requests").map { |r| r["id"] }
+
+    # Customer cannot update priority alone, and customer reply/solve does not reset high priority
+    patch "/api/v1/requests/#{ticket_id}",
+      params: { request: { priority: "normal" } },
+      headers: account_headers("acme", avery_token),
+      as: :json
+    assert_response :unprocessable_entity
+
+    travel_to Time.utc(2026, 11, 21, 10, 10, 0) do
+      patch "/api/v1/requests/#{ticket_id}",
+        params: { request: { priority: "normal", comment: { body: "Any update?" } } },
+        headers: account_headers("acme", avery_token),
+        as: :json
+      assert_response :ok
+      assert_not response.parsed_body.fetch("request").key?("priority")
+    end
+
+    get "/api/v1/tickets/#{ticket_id}", headers: account_headers("acme", admin_token)
+    assert_response :ok
+    assert_equal "high", response.parsed_body.dig("ticket", "priority")
+
+    # Admin resets priority back to normal via PUT alongside assignment and status update
+    travel_to Time.utc(2026, 11, 21, 10, 15, 0) do
+      put "/api/v1/tickets/#{ticket_id}",
+        params: {
+          ticket: {
+            priority: "normal",
+            assignee_id: agent.id,
+            status: "pending",
+            comment: { body: "Sent receipt by email." }
+          }
+        },
+        headers: account_headers("acme", admin_token),
+        as: :json
+      assert_response :ok
+      updated = response.parsed_body.fetch("ticket")
+      assert_equal "normal", updated["priority"]
+      assert_equal "pending", updated["status"]
+      assert_equal agent.id, updated["assignee_id"]
+    end
+  end
+
+  test "staff combined inbox filters, literal case-insensitive search on subjects and public comments, deduplication, and pagination" do
+    acme, admin_token = create_verified_business(subdomain: "acme")
+    sam, sam_token = invite_and_login_staff(subdomain: "acme", admin_token: admin_token, name: "Sam Agent", email: "sam@acme.test")
+    pat, _pat_token = invite_and_login_staff(subdomain: "acme", admin_token: admin_token, name: "Pat Agent", email: "pat@acme.test")
+    avery, avery_token = register_and_verify_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    blair, blair_token = register_and_verify_customer(subdomain: "acme", name: "Blair", email: "blair@example.test")
+    casey, _casey_token = register_and_verify_customer(subdomain: "acme", name: "Casey", email: "casey@example.test")
+
+    # Ticket 1: Avery, open, unassigned, high priority, matches "receipt" in BOTH subject AND multiple public comments (must deduplicate!)
+    post "/api/v1/requests",
+      params: { request: { subject: "Missing RECEIPT for October", comment: { body: "First receipt comment." } } },
+      headers: account_headers("acme", avery_token),
+      as: :json
+    t1_id = response.parsed_body.dig("request", "id")
+    patch "/api/v1/requests/#{t1_id}",
+      params: { request: { comment: { body: "Second RECEIPT follow-up comment." } } },
+      headers: account_headers("acme", avery_token),
+      as: :json
+    assert_response :ok
+    patch "/api/v1/tickets/#{t1_id}",
+      params: { ticket: { priority: "high" } },
+      headers: account_headers("acme", admin_token),
