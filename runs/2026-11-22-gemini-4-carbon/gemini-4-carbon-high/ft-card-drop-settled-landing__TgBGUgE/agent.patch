diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..63e51d6
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,320 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+import { Turbo } from "@hotwired/turbo-rails"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "container", "item" ]
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  #pendingSave = Promise.resolve()
+
+  connect() {
+    this.mediaQuery = window.matchMedia(this.desktopBreakpointValue)
+    this.handleViewportChange = this.refreshDraggableItems.bind(this)
+    this.mediaQuery.addEventListener("change", this.handleViewportChange)
+    this.refreshDraggableItems()
+  }
+
+  disconnect() {
+    this.mediaQuery?.removeEventListener("change", this.handleViewportChange)
+    this.#cleanup()
+  }
+
+  itemTargetConnected(element) {
+    if (this.mediaQuery) {
+      element.draggable = this.#isDesktop
+    }
+  }
+
+  refreshDraggableItems() {
+    const draggable = this.#isDesktop
+    this.itemTargets.forEach(item => {
+      item.draggable = draggable
+    })
+  }
+
+  preserveDraggable(event) {
+    if (event.detail.attributeName === "draggable" && event.target.matches('[data-drag-and-drop-target~="item"]')) {
+      event.preventDefault()
+    }
+  }
+
+  dragStart(event) {
+    if (!this.#isDesktop) return
+    if (event.target.closest("dialog[open], input, textarea, [contenteditable]")) return
+
+    const item = event.target.closest('[data-drag-and-drop-target~="item"]')
+    const container = item?.closest('[data-drag-and-drop-target~="container"]')
+    if (!item || !container || !this.element.contains(container)) return
+
+    this.#cleanup()
+    this.draggedItem = item
+    this.sourceContainer = container
+    this.wasDragging = true
+
+    this.#clearNavigableSelection(container, item)
+    item.classList.add(this.#draggedClass)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.id)
+    }
+  }
+
+  dragEnter(event) {
+    this.#updateHoveredContainer(event)
+  }
+
+  dragOver(event) {
+    this.#updateHoveredContainer(event)
+  }
+
+  dragLeave(event) {
+    if (!this.draggedItem || !this.hoveredContainer) return
+
+    const relatedTarget = event.relatedTarget
+    if (relatedTarget) {
+      if (!this.hoveredContainer.contains(relatedTarget)) {
+        this.#clearHoverContainer()
+      }
+    } else if (!this.#isPointInside(event.clientX, event.clientY, this.hoveredContainer)) {
+      this.#clearHoverContainer()
+    }
+  }
+
+  drop(event) {
+    if (!this.draggedItem) return
+
+    event.preventDefault()
+
+    const targetContainer = event.target.closest('[data-drag-and-drop-target~="container"]')
+    const item = this.draggedItem
+    const sourceContainer = this.sourceContainer
+
+    this.#cleanup()
+
+    if (!targetContainer || !sourceContainer || targetContainer === sourceContainer || !this.element.contains(targetContainer)) {
+      return
+    }
+
+    this.#moveItem(item, sourceContainer, targetContainer)
+    this.#enqueueSave(item, targetContainer)
+  }
+
+  dragEnd() {
+    if (this.wasDragging) {
+      this.#suppressNextClick()
+      this.wasDragging = false
+    }
+    this.#cleanup()
+  }
+
+  get #isDesktop() {
+    return this.mediaQuery?.matches ?? true
+  }
+
+  get #draggedClass() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : "drag-and-drop__dragged-item"
+  }
+
+  get #hoverClass() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : "drag-and-drop__hover-container"
+  }
+
+  #suppressNextClick() {
+    const preventClick = (event) => {
+      event.preventDefault()
+      event.stopImmediatePropagation()
+      cleanup()
+    }
+
+    const cleanup = () => {
+      clearTimeout(timer)
+      window.removeEventListener("click", preventClick, { capture: true })
+      window.removeEventListener("pointerdown", cleanup, { capture: true })
+    }
+
+    const timer = setTimeout(cleanup, 100)
+    window.addEventListener("click", preventClick, { capture: true })
+    window.addEventListener("pointerdown", cleanup, { capture: true })
+  }
+
+  #updateHoveredContainer(event) {
+    if (!this.draggedItem) return
+
+    const container = event.target.closest('[data-drag-and-drop-target~="container"]')
+    if (!container || !this.element.contains(container)) {
+      this.#clearHoverContainer()
+      return
+    }
+
+    event.preventDefault()
+
+    if (container === this.sourceContainer) {
+      this.#clearHoverContainer()
+      return
+    }
+
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    if (this.hoveredContainer !== container) {
+      this.#clearHoverContainer()
+      this.hoveredContainer = container
+      container.classList.add(this.#hoverClass)
+    }
+  }
+
+  #clearHoverContainer() {
+    if (this.hoveredContainer) {
+      this.hoveredContainer.classList.remove(this.#hoverClass)
+      this.hoveredContainer = null
+    }
+  }
+
+  #cleanup() {
+    if (this.draggedItem) {
+      this.draggedItem.classList.remove(this.#draggedClass)
+      this.draggedItem = null
+    }
+    this.#clearHoverContainer()
+    this.sourceContainer = null
+  }
+
+  #isPointInside(clientX, clientY, element) {
+    if (clientX === 0 && clientY === 0) return false
+
+    const rect = element.getBoundingClientRect()
+    return clientX >= rect.left && clientX <= rect.right && clientY >= rect.top && clientY <= rect.bottom
+  }
+
+  #clearNavigableSelection(container, item) {
+    item.removeAttribute("aria-selected")
+
+    const listElement = container.querySelector('[data-controller~="navigable-list"]')
+    if (listElement) {
+      const listController = this.application.getControllerForElementAndIdentifier(listElement, "navigable-list")
+      if (listController?.isSelected(item)) {
+        listController.clearSelection()
+      }
+    }
+  }
+
+  #moveItem(item, sourceContainer, targetContainer) {
+    const frame = targetContainer.querySelector("turbo-frame[src]")
+    const frameIsLoading = frame && (frame.hasAttribute("busy") || !targetContainer.querySelector(".cards__list"))
+
+    this.#updateCardAppearance(item, targetContainer)
+
+    if (frameIsLoading) {
+      item.remove()
+      frame.loaded.then(() => {
+        if (!targetContainer.querySelector(`#${CSS.escape(item.id)}`)) {
+          this.#insertItemIntoContainer(item, targetContainer)
+          this.#updateColumnProgress(targetContainer)
+        }
+      })
+    } else {
+      this.#insertItemIntoContainer(item, targetContainer)
+    }
+
+    this.#adjustColumnCount(sourceContainer, -1)
+    this.#adjustColumnCount(targetContainer, 1)
+  }
+
+  #insertItemIntoContainer(item, container) {
+    const list = container.querySelector(".cards__list")
+    if (!list) return
+
+    const insertionParent = list.querySelector("turbo-frame") || list
+    const cards = Array.from(list.querySelectorAll('[data-drag-and-drop-target~="item"]')).filter(card => card !== item)
+    const goldenFirst = container.dataset.goldenFirst !== "false"
+    const isGolden = item.classList.contains("golden-effect")
+
+    if (!goldenFirst || isGolden) {
+      if (cards.length > 0) {
+        cards[0].before(item)
+      } else {
+        insertionParent.prepend(item)
+      }
+    } else {
+      const firstNonGoldenCard = cards.find(card => !card.classList.contains("golden-effect"))
+      if (firstNonGoldenCard) {
+        firstNonGoldenCard.before(item)
+      } else if (cards.length > 0) {
+        cards[cards.length - 1].after(item)
+      } else {
+        insertionParent.prepend(item)
+      }
+    }
+  }
+
+  #updateCardAppearance(item, container) {
+    const cardColor = container.dataset.cardColor || "var(--color-card-default)"
+    const status = container.dataset.cardStatus || "active"
+
+    item.style.setProperty("--card-color", cardColor)
+    item.classList.toggle("card--active", status === "active")
+    item.classList.toggle("card--postponed", status === "postponed")
+
+    item.querySelector(".card__closed")?.remove()
+    item.querySelector('[id^="assignees_card_"]')?.toggleAttribute("hidden", status === "closed")
+    item.querySelector(".bubble")?.setAttribute("hidden", "")
+
+    const updatedTime = item.querySelector(".card__meta-text--updated time")
+    if (updatedTime) {
+      updatedTime.setAttribute("datetime", Math.floor(Date.now() / 1000))
+      updatedTime.dispatchEvent(new CustomEvent("turbo:morph-element", { bubbles: true }))
+    }
+  }
+
+  #adjustColumnCount(container, delta) {
+    const countElement = container.querySelector(".cards__expander-count")
+    if (countElement) {
+      const currentCount = parseInt(countElement.dataset.count ?? countElement.textContent, 10) || 0
+      const nextCount = Math.max(0, currentCount + delta)
+      countElement.dataset.count = nextCount
+      countElement.textContent = nextCount > 99 ? "99+" : nextCount
+    }
+
+    this.#updateColumnProgress(container)
+  }
+
+  #updateColumnProgress(container) {
+    const expanderButton = container.querySelector(".cards__expander")
+    const list = container.querySelector(".cards__list")
+    if (expanderButton && list) {
+      const loadedCardsCount = list.querySelectorAll('[data-drag-and-drop-target~="item"]').length
+      expanderButton.style.setProperty("--card-count", Math.min(loadedCardsCount, 15))
+    }
+  }
+
+  #enqueueSave(item, targetContainer) {
+    const urlTemplate = targetContainer.dataset.dropUrl
+    const method = targetContainer.dataset.dropMethod || "post"
+    const cardId = item.dataset.id
+    if (!urlTemplate || !cardId) return
+
+    const url = urlTemplate.replace("__id__", encodeURIComponent(cardId))
+
+    this.#pendingSave = this.#pendingSave
+      .then(() => this.#performSave(method, url))
+      .catch(() => this.#recoverFromFailedSave())
+  }
+
+  async #performSave(method, url) {
+    const request = new FetchRequest(method, url, { responseKind: "json", keepalive: true })
+    const response = await request.perform()
+    if (!response.ok) {
+      throw new Error(`Failed to save card move (${response.statusCode})`)
+    }
+  }
+
+  #recoverFromFailedSave() {
+    Turbo.visit(window.location.href, { action: "replace" })
+  }
+}
