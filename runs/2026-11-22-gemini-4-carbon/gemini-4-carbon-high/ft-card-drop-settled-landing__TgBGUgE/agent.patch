diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..35f44e8
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,284 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @board = boards(:writebook)
+  end
+
+  test "dragging a card across columns and statuses persists each change" do
+    card = cards(:buy_domain)
+    in_progress = columns(:writebook_in_progress)
+    on_hold = columns(:writebook_on_hold)
+
+    visit board_url(@board)
+
+    # Maybe? -> In progress (collapsed column)
+    drag_card(card, to: column_selector(in_progress))
+    assert_column_count(in_progress, 2)
+    assert_column_count("#maybe", 0)
+    wait_until { card.reload.column == in_progress }
+
+    # Expand In progress and verify card is already inside it
+    expand_column(in_progress)
+    within(column_selector(in_progress)) do
+      assert_selector card_selector(card)
+    end
+
+    # In progress -> On Hold (empty column)
+    drag_card(card, to: column_selector(on_hold))
+    assert_column_count(in_progress, 1)
+    assert_column_count(on_hold, 1)
+    wait_until { card.reload.column == on_hold }
+
+    # On Hold -> Not Now
+    expand_column(on_hold)
+    drag_card(card, to: "#not-now")
+    assert_column_count(on_hold, 0)
+    assert_column_count("#not-now", 1)
+    within(column_selector(on_hold)) do
+      assert_selector ".blank-slate--drag", text: "Drag cards here"
+    end
+    wait_until { card.reload.postponed? }
+
+    # Not Now -> Done
+    expand_column("#not-now")
+    drag_card(card, to: "#closed-cards")
+    assert_column_count("#not-now", 0)
+    assert_column_count("#closed-cards", 2)
+    wait_until { card.reload.closed? }
+
+    # Done -> Maybe?
+    expand_column("#closed-cards")
+    drag_card(card, to: "#maybe")
+    assert_column_count("#closed-cards", 1)
+    assert_column_count("#maybe", 1)
+    within("#maybe") do
+      assert_selector card_selector(card)
+    end
+    wait_until { card.reload.awaiting_triage? }
+  end
+
+  test "dragging a pinned card from Done to Not Now and into a column" do
+    card = cards(:shipping)
+    review = columns(:writebook_review)
+
+    visit board_url(@board)
+    expand_column("#closed-cards")
+
+    drag_card(card, to: "#not-now")
+    wait_until { card.reload.postponed? && !card.closed? }
+
+    expand_column("#not-now")
+    drag_card(card, to: column_selector(review))
+    wait_until { card.reload.triaged? && card.column == review }
+
+    expand_column(review)
+    within(column_selector(review)) do
+      assert_selector "#{card_selector(card)}.card--active"
+      assert_no_selector "#{card_selector(card)} .card__closed"
+    end
+  end
+
+  test "columns keep their own order and dragging within the same column is a no-op" do
+    triage = columns(:writebook_triage)
+    golden_card = cards(:logo)
+    regular_card = cards(:layout)
+    moved_card = cards(:buy_domain)
+
+    visit board_url(@board)
+    expand_column(triage)
+
+    assert_equal [ dom_id(golden_card, :article), dom_id(regular_card, :article) ], card_ids_in(column_selector(triage))
+
+    # Dragging within Triage does not reorder cards
+    drag_card(regular_card, to: ".card-columns #{card_selector(golden_card)}")
+    assert_equal [ dom_id(golden_card, :article), dom_id(regular_card, :article) ], card_ids_in(column_selector(triage))
+
+    # Dropping a non-golden card into Triage places it after golden cards and before other non-golden cards
+    drag_card(moved_card, to: column_selector(triage))
+    expected_order = [
+      dom_id(golden_card, :article),
+      dom_id(moved_card, :article),
+      dom_id(regular_card, :article)
+    ]
+    assert_equal expected_order, card_ids_in(column_selector(triage))
+    wait_until { moved_card.reload.column == triage }
+
+    # Dropping a golden card into In progress places it at the very top
+    in_progress = columns(:writebook_in_progress)
+    existing_in_progress = cards(:text)
+    drag_card(golden_card, to: column_selector(in_progress))
+    expand_column(in_progress)
+    assert_equal [ dom_id(golden_card, :article), dom_id(existing_in_progress, :article) ], card_ids_in(column_selector(in_progress))
+    wait_until { golden_card.reload.column == in_progress }
+
+    # Dropping golden then non-golden into Not Now places newest at the very top (Not Now does not group golden first)
+    drag_card(golden_card, to: "#not-now")
+    wait_until { golden_card.reload.postponed? }
+    drag_card(existing_in_progress, to: "#not-now")
+    wait_until { existing_in_progress.reload.postponed? }
+    expand_column("#not-now")
+    assert_equal [ dom_id(existing_in_progress, :article), dom_id(golden_card, :article) ], card_ids_in("#not-now")
+  end
+
+  test "drop updates the board instantly before save completes and nothing shifts afterwards" do
+    card = cards(:buy_domain)
+    triage = columns(:writebook_triage)
+
+    visit board_url(@board)
+    expand_column(triage)
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+
+    # Hold the network save in flight so we can inspect the board while saving
+    page.execute_script(<<~JS)
+      window.__originalFetch = window.fetch
+      window.__pendingSaveResolve = null
+      window.fetch = function(url, options) {
+        if (options && options.method && options.method !== "GET") {
+          return new Promise(resolve => {
+            window.__pendingSaveResolve = () => resolve(window.__originalFetch(url, options))
+          })
+        }
+        return window.__originalFetch(url, options)
+      }
+    JS
+
+    drag_card(card, to: column_selector(triage))
+
+    # While save is still paused, the card is already in Triage in its final position
+    assert_nil card.reload.column
+    expected_order = [
+      dom_id(cards(:logo), :article),
+      dom_id(card, :article),
+      dom_id(cards(:layout), :article)
+    ]
+    assert_equal expected_order, card_ids_in(column_selector(triage))
+    assert_no_selector ".drag-and-drop__dragged-item"
+    assert_no_selector ".drag-and-drop__hover-container"
+
+    rect_before_save = card_rect(card)
+
+    # Complete the save and also broadcast a board refresh from another user
+    page.execute_script("window.__pendingSaveResolve(); window.fetch = window.__originalFetch;")
+    wait_until { card.reload.column == triage }
+    @board.touch
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_equal expected_order, card_ids_in(column_selector(triage))
+    assert_equal rect_before_save, card_rect(card)
+    assert page.evaluate_script("arguments[0].draggable", board_card(card))
+  end
+
+  test "dragged card dims and hovered target column lights up" do
+    card = cards(:buy_domain)
+    triage = columns(:writebook_triage)
+    in_progress = columns(:writebook_in_progress)
+
+    visit board_url(@board)
+
+    # Start drag: card gets dimmed class, source column does not light up
+    page.execute_script(<<~JS, board_card(card))
+      const card = arguments[0]
+      window.__dt = new DataTransfer()
+      card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: window.__dt }))
+      card.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: window.__dt }))
+    JS
+
+    assert_selector ".card-columns #{card_selector(card)}.drag-and-drop__dragged-item"
+    assert_no_selector "#maybe.drag-and-drop__hover-container"
+
+    # Drag over Triage: Triage lights up
+    page.execute_script(<<~JS, find(column_selector(triage)))
+      arguments[0].dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: window.__dt }))
+    JS
+    assert_selector "#{column_selector(triage)}.drag-and-drop__hover-container"
+
+    # Move pointer to In progress: Triage un-highlights and In progress lights up
+    page.execute_script(<<~JS, find(column_selector(in_progress)))
+      arguments[0].dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: window.__dt }))
+    JS
+    assert_no_selector "#{column_selector(triage)}.drag-and-drop__hover-container"
+    assert_selector "#{column_selector(in_progress)}.drag-and-drop__hover-container"
+
+    # Leave column: In progress un-highlights
+    page.execute_script(<<~JS, find(column_selector(in_progress)))
+      arguments[0].dispatchEvent(new DragEvent("dragleave", { bubbles: true, cancelable: true, dataTransfer: window.__dt }))
+    JS
+    assert_no_selector "#{column_selector(in_progress)}.drag-and-drop__hover-container"
+
+    # Cancel drag: classes are cleaned up
+    page.execute_script(<<~JS, board_card(card))
+      arguments[0].dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer: window.__dt }))
+    JS
+    assert_no_selector ".drag-and-drop__dragged-item"
+    assert_no_selector ".drag-and-drop__hover-container"
+  end
+
+  test "clicking a card still navigates to it" do
+    card = cards(:buy_domain)
+
+    visit board_url(@board)
+    board_card(card).find(".card__link").click
+
+    assert_current_path card_path(card)
+  end
+
+  private
+    def column_selector(column)
+      column.is_a?(String) ? column : "##{dom_id(column)}"
+    end
+
+    def card_selector(card)
+      "##{dom_id(card, :article)}"
+    end
+
+    def board_card(card)
+      find(".card-columns #{card_selector(card)}")
+    end
+
+    def expand_column(column)
+      selector = column_selector(column)
+      within(selector) do
+        find(".cards__expander").click
+      end
+      assert_selector "#{selector}.is-expanded"
+    end
+
+    def drag_card(card, to:)
+      source = board_card(card)
+      target = find(to)
+      source.drag_to(target)
+    end
+
+    def assert_column_count(column, expected_count)
+      within(column_selector(column)) do
+        assert_selector ".cards__expander-count", text: expected_count.to_s, visible: :all
+      end
+    end
+
+    def card_ids_in(selector)
+      page.evaluate_script(<<~JS, find(selector))
+        Array.from(arguments[0].querySelectorAll(".cards__list article.card")).map(el => el.id)
+      JS
+    end
+
+    def card_rect(card)
+      page.evaluate_script(<<~JS, board_card(card))
+        (() => {
+          const r = arguments[0].getBoundingClientRect()
+          return { top: Math.round(r.top), left: Math.round(r.left), width: Math.round(r.width), height: Math.round(r.height) }
+        })()
+      JS
+    end
+
+    def wait_until(timeout: 5)
+      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
+      until yield
+        raise "Timed out waiting for condition" if Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
+        sleep 0.05
+      end
+    end
+end
