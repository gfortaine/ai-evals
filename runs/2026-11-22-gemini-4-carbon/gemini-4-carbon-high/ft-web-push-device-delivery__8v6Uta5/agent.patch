diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..3caf4cf
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,217 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static targets = [ "toggle", "explainer", "details" ]
+  static values = {
+    subscriptionsUrl: String,
+    endpoints: Array
+  }
+
+  async connect() {
+    await this.refresh()
+  }
+
+  async refresh() {
+    if (!this.#pushSupported) {
+      this.#setSubscribedState(false)
+      this.#disableToggle()
+      this.#showHelp()
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#setSubscribedState(false)
+      this.#disableToggle()
+      this.#showHelp()
+      return
+    }
+
+    await this.#syncState()
+  }
+
+  async toggle() {
+    if (this.toggleTarget.checked) {
+      await this.#enable()
+    } else {
+      await this.#disable()
+    }
+  }
+
+  // Private
+
+  get #pushSupported() {
+    return "serviceWorker" in navigator &&
+      "PushManager" in window &&
+      "Notification" in window &&
+      Boolean(this.#vapidPublicKey)
+  }
+
+  get #vapidPublicKey() {
+    return getMetaContent("vapid-public-key")?.trim()
+  }
+
+  async #syncState() {
+    if (Notification.permission !== "granted") {
+      this.#setSubscribedState(false)
+      return
+    }
+
+    const registration = await this.#serviceWorkerRegistration()
+    const subscription = await registration?.pushManager?.getSubscription()
+    const isSubscribed = Boolean(subscription && this.endpointsValue.includes(subscription.endpoint))
+
+    this.#setSubscribedState(isSubscribed)
+  }
+
+  async #enable() {
+    const permission = Notification.permission === "default"
+      ? await Notification.requestPermission()
+      : Notification.permission
+
+    if (permission !== "granted") {
+      this.#setSubscribedState(false)
+      if (permission === "denied") {
+        this.#disableToggle()
+        this.#showHelp()
+      }
+      return
+    }
+
+    this.toggleTarget.disabled = true
+
+    try {
+      const registration = await this.#serviceWorkerRegistration()
+      let subscription = await registration.pushManager.getSubscription()
+      if (!subscription) {
+        subscription = await this.#subscribe(registration)
+      }
+
+      const response = await post(this.subscriptionsUrlValue, {
+        body: { push_subscription: this.#extractSubscriptionParams(subscription) },
+        responseKind: "json"
+      })
+
+      if (response.ok) {
+        if (!this.endpointsValue.includes(subscription.endpoint)) {
+          this.endpointsValue = [ ...this.endpointsValue, subscription.endpoint ]
+        }
+        this.#setSubscribedState(true)
+      } else {
+        this.#setSubscribedState(false)
+      }
+    } catch (error) {
+      console.error("Failed to subscribe to push notifications:", error)
+      this.#setSubscribedState(false)
+      if (Notification.permission === "denied") {
+        this.#disableToggle()
+        this.#showHelp()
+      }
+    } finally {
+      if (Notification.permission !== "denied") {
+        this.toggleTarget.disabled = false
+      }
+    }
+  }
+
+  async #disable() {
+    this.toggleTarget.disabled = true
+
+    try {
+      const registration = await this.#serviceWorkerRegistration()
+      const subscription = await registration?.pushManager?.getSubscription()
+
+      if (subscription) {
+        await destroy(this.subscriptionsUrlValue, {
+          query: { endpoint: subscription.endpoint },
+          responseKind: "json"
+        })
+        await subscription.unsubscribe()
+        this.endpointsValue = this.endpointsValue.filter((endpoint) => endpoint !== subscription.endpoint)
+      }
+
+      this.#setSubscribedState(false)
+    } catch (error) {
+      console.error("Failed to unsubscribe from push notifications:", error)
+    } finally {
+      this.toggleTarget.disabled = false
+    }
+  }
+
+  async #serviceWorkerRegistration() {
+    const existing = await navigator.serviceWorker.getRegistration?.()
+    if (!existing) {
+      await navigator.serviceWorker.register?.("/service-worker.js", { scope: "/" })
+    }
+    return (await navigator.serviceWorker.ready) || existing
+  }
+
+  async #subscribe(registration) {
+    const applicationServerKey = this.#urlBase64ToUint8Array(this.#vapidPublicKey)
+
+    try {
+      return await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey
+      })
+    } catch (error) {
+      if (error.name === "InvalidStateError") {
+        const existing = await registration.pushManager.getSubscription()
+        await existing?.unsubscribe()
+        return await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey
+        })
+      }
+      throw error
+    }
+  }
+
+  #extractSubscriptionParams(subscription) {
+    const json = subscription.toJSON ? subscription.toJSON() : subscription
+    const p256dh = json.keys?.p256dh || this.#encodeKey(subscription.getKey?.("p256dh"))
+    const auth = json.keys?.auth || this.#encodeKey(subscription.getKey?.("auth"))
+
+    return {
+      endpoint: subscription.endpoint,
+      p256dh_key: p256dh,
+      auth_key: auth
+    }
+  }
+
+  #encodeKey(buffer) {
+    if (!buffer) return null
+
+    const bytes = new Uint8Array(buffer)
+    let binary = ""
+    bytes.forEach((byte) => binary += String.fromCharCode(byte))
+    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = atob(base64)
+    return Uint8Array.from(rawData, (char) => char.charCodeAt(0))
+  }
+
+  #setSubscribedState(subscribed) {
+    if (this.hasToggleTarget) {
+      this.toggleTarget.checked = subscribed
+    }
+    this.element.classList.toggle("notifications--on", subscribed)
+  }
+
+  #disableToggle() {
+    if (this.hasToggleTarget) {
+      this.toggleTarget.disabled = true
+    }
+  }
+
+  #showHelp() {
+    if (this.hasExplainerTarget) {
+      this.explainerTarget.open = true
+    }
+  }
+}
