index 0000000..376dabd
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,162 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @client_curve = OpenSSL::PKey::EC.generate("prime256v1")
+    @p256dh_key = Base64.urlsafe_encode64(@client_curve.public_key.to_bn.to_s(2), padding: false)
+    @auth_secret = Random.bytes(16)
+    @auth_key = Base64.urlsafe_encode64(@auth_secret, padding: false)
+    @endpoint = "https://fcm.googleapis.com/fcm/send/subscription-123"
+  end
+
+  test "validates presence and https endpoint" do
+    subscription = @user.push_subscriptions.new(endpoint: @endpoint, p256dh_key: @p256dh_key, auth_key: @auth_key)
+    assert subscription.valid?
+    assert_equal @user.account, subscription.account
+
+    subscription.endpoint = "http://fcm.googleapis.com/fcm/send/123"
+    assert_not subscription.valid?
+
+    subscription.endpoint = "https://127.0.0.1/internal"
+    assert_not subscription.valid?
+
+    subscription.endpoint = "https://169.254.169.254/latest/meta-data"
+    assert_not subscription.valid?
+
+    subscription.endpoint = "https://[::1]/internal"
+    assert_not subscription.valid?
+  end
+
+  test "push encrypts payload and signs VAPID header using VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY" do
+    vapid_key = WebPush.generate_key
+    subscription = @user.push_subscriptions.create!(
+      endpoint: @endpoint,
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+
+    captured_request = nil
+    stub_request(:post, @endpoint).with { |req| captured_request = req; true }.to_return(status: 201)
+
+    with_env("VAPID_PUBLIC_KEY" => vapid_key.public_key, "VAPID_PRIVATE_KEY" => vapid_key.private_key) do
+      subscription.push(title: "Theisse", body: "Added by David", path: "/897362094/cards/1")
+    end
+
+    assert_not_nil captured_request
+    assert_equal "aes128gcm", captured_request.headers["Content-Encoding"]
+
+    auth_header = captured_request.headers["Authorization"]
+    assert_match(/\Avapid t=([^,]+),k=([^\s]+)\z/, auth_header)
+    jwt_token = auth_header[/t=([^,]+)/, 1]
+    header_pub_key = auth_header[/k=([^\s]+)/, 1]
+    assert_equal vapid_key.public_key.delete("="), header_pub_key
+
+    decoded_jwt, _ = JWT.decode(jwt_token, vapid_key.curve, true, algorithm: "ES256")
+    assert_equal "https://fcm.googleapis.com", decoded_jwt["aud"]
+
+    decrypted_json = JSON.parse(decrypt_aes128gcm(captured_request.body))
+    assert_equal "Theisse", decrypted_json["title"]
+    assert_equal "Added by David", decrypted_json.dig("options", "body")
+    assert_equal "/897362094/cards/1", decrypted_json.dig("options", "data", "path")
+  end
+
+  test "destroys subscription when push service returns 410 Gone, 404 Not Found, or 401 Unauthorized" do
+    [ 410, 404, 401 ].each do |status|
+      subscription = @user.push_subscriptions.create!(
+        endpoint: "#{@endpoint}-#{status}",
+        p256dh_key: @p256dh_key,
+        auth_key: @auth_key
+      )
+      stub_request(:post, subscription.endpoint).to_return(status: status, body: "expired")
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        subscription.push(title: "Title", body: "Body", path: "/cards/1")
+      end
+    end
+  end
+
+  test "skips push in production when VAPID keys are not configured" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: @endpoint,
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+
+    Rails.stubs(:env).returns(ActiveSupport::EnvironmentInquirer.new("production"))
+    with_env("VAPID_PUBLIC_KEY" => nil, "VAPID_PRIVATE_KEY" => nil) do
+      assert_not Push.configured?
+      WebPush.expects(:payload_send).never
+      subscription.push(title: "Title", body: "Body", path: "/cards/1")
+    end
+  ensure
+    Rails.unstub(:env)
+  end
+
+  test "destroying session destroys associated push subscriptions" do
+    session = sessions(:david)
+    subscription = users(:david).push_subscriptions.create!(
+      session: session,
+      endpoint: @endpoint,
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      session.destroy
+    end
+    assert_not PushSubscription.exists?(subscription.id)
+  end
+
+  test "deactivating user destroys push subscriptions" do
+    @user.push_subscriptions.create!(
+      endpoint: @endpoint,
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      @user.deactivate
+    end
+  end
+
+  private
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+
+    def decrypt_aes128gcm(payload)
+      body = payload.b
+      salt = body.byteslice(0, 16)
+      _rs = body.byteslice(16, 4).unpack1("N")
+      idlen = body.byteslice(20, 1).unpack1("C")
+      server_pub_bytes = body.byteslice(21, idlen)
+      ciphertext_and_tag = body.byteslice(21 + idlen, body.bytesize - 21 - idlen)
+
+      group = OpenSSL::PKey::EC::Group.new("prime256v1")
+      server_pub_bn = OpenSSL::BN.new(server_pub_bytes, 2)
+      server_pub_point = OpenSSL::PKey::EC::Point.new(group, server_pub_bn)
+      shared_secret = @client_curve.dh_compute_key(server_pub_point)
+
+      client_pub_bytes = @client_curve.public_key.to_bn.to_s(2)
+      info = "WebPush: info\0".b + client_pub_bytes + server_pub_bytes
+      prk = OpenSSL::KDF.hkdf(shared_secret, salt: @auth_secret, info: info, hash: "SHA256", length: 32)
+      cek = OpenSSL::KDF.hkdf(prk, salt: salt, info: "Content-Encoding: aes128gcm\0", hash: "SHA256", length: 16)
+      nonce = OpenSSL::KDF.hkdf(prk, salt: salt, info: "Content-Encoding: nonce\0", hash: "SHA256", length: 12)
+
+      ciphertext = ciphertext_and_tag.byteslice(0, ciphertext_and_tag.bytesize - 16)
+      tag = ciphertext_and_tag.byteslice(-16, 16)
+
+      cipher = OpenSSL::Cipher.new("aes-128-gcm")
+      cipher.decrypt
+      cipher.key = cek
+      cipher.iv = nonce
+      cipher.auth_tag = tag
+      plaintext_with_padding = cipher.update(ciphertext) + cipher.final
+      plaintext_with_padding.sub(/\x02\x00*\z/n, "").force_encoding("UTF-8")
+    end
+end
