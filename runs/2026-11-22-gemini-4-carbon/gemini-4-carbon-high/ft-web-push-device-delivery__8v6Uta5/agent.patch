diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..ef6e0f1
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create registers a push subscription for the user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://fcm.googleapis.com/fcm/send/device-abc",
+          p256dh_key: "p256dh-test-key",
+          auth_key: "auth-test-key"
+        }
+      }, headers: { "HTTP_USER_AGENT" => "Mozilla/5.0 Test Browser" }
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://fcm.googleapis.com/fcm/send/device-abc", subscription.endpoint
+    assert_equal "p256dh-test-key", subscription.p256dh_key
+    assert_equal "auth-test-key", subscription.auth_key
+    assert_equal "Mozilla/5.0 Test Browser", subscription.user_agent
+    assert_not_nil subscription.session_id
+  end
+
+  test "create updates keys when posting an existing endpoint for the same user" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/device-abc",
+      p256dh_key: "old-p256dh",
+      auth_key: "old-auth"
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://fcm.googleapis.com/fcm/send/device-abc",
+          p256dh_key: "new-p256dh",
+          auth_key: "new-auth"
+        }
+      }
+    end
+
+    assert_response :ok
+    subscription.reload
+    assert_equal "new-p256dh", subscription.p256dh_key
+    assert_equal "new-auth", subscription.auth_key
+  end
+
+  test "rejects invalid push subscription endpoint" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "http://insecure.example.com/push",
+          p256dh_key: "p256dh",
+          auth_key: "auth"
+        }
+      }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "forbids managing another user's push subscriptions" do
+    other_user = users(:kevin)
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(other_user), params: {
+        push_subscription: {
+          endpoint: "https://fcm.googleapis.com/fcm/send/attacker",
+          p256dh_key: "p256dh",
+          auth_key: "auth"
+        }
+      }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy removes push subscription by id" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/device-abc",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription)
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy removes push subscription by endpoint" do
+    @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/device-abc",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: {
+        endpoint: "https://fcm.googleapis.com/fcm/send/device-abc"
+      }
+    end
+
+    assert_response :no_content
+  end
+end
diff --git a/test/models/notification/pushing_test.rb b/test/models/notification/pushing_test.rb
new file mode 100644
index 0000000..e237b32
--- /dev/null
+++ b/test/models/notification/pushing_test.rb
@@ -0,0 +1,145 @@
+require "test_helper"
+
+class Notification::PushingTest < ActiveSupport::TestCase
+  include Rails.application.routes.url_helpers
+
+  setup do
+    @kevin = users(:kevin)
+    @david = users(:david)
+    key = OpenSSL::PKey::EC.generate("prime256v1")
+    @p256dh = Base64.urlsafe_encode64(key.public_key.to_bn.to_s(2), padding: false)
+    @auth = Base64.urlsafe_encode64(Random.bytes(16), padding: false)
+    @subscription = @kevin.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/kevin-desktop",
+      p256dh_key: @p256dh,
+      auth_key: @auth
+    )
+  end
+
+  test "pushes card event notification with tray title, body, and card path" do
+    notifications(:layout_commented_kevin).destroy
+    event = events(:layout_commented)
+    expected_path = card_path(event.card, script_name: @kevin.account.slug)
+
+    captured_payload = nil
+    WebPush.expects(:payload_send).with do |**args|
+      captured_payload = JSON.parse(args[:message])
+      args[:endpoint] == @subscription.endpoint &&
+        args[:p256dh] == @subscription.p256dh_key &&
+        args[:auth] == @subscription.auth_key
+    end.once
+
+    perform_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @kevin, source: event, creator: @david)
+    end
+
+    assert_equal "RE: #{event.card.title}", captured_payload["title"]
+    assert_equal event.eventable.body.to_plain_text.truncate(200), captured_payload.dig("options", "body")
+    assert_equal expected_path, captured_payload.dig("options", "data", "path")
+  end
+
+  test "pushes card action notification matching tray copy" do
+    existing = notifications(:buy_domain_sent_back_to_triage_kevin)
+    event = existing.source
+    existing.destroy
+
+    captured_payload = nil
+    WebPush.expects(:payload_send).with do |**args|
+      captured_payload = JSON.parse(args[:message])
+      true
+    end.once
+
+    perform_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @kevin, source: event, creator: event.creator)
+    end
+
+    assert_equal event.card.title, captured_payload["title"]
+    assert_equal "Moved back to Maybe? by #{event.creator.name}", captured_payload.dig("options", "body")
+    assert_equal card_path(event.card, script_name: @kevin.account.slug), captured_payload.dig("options", "data", "path")
+  end
+
+  test "pushes mention notification with tray mention title, body, and card path" do
+    david_sub = @david.push_subscriptions.create!(
+      endpoint: "https://web.push.apple.com/david-iphone",
+      p256dh_key: @p256dh,
+      auth_key: @auth
+    )
+    notifications(:logo_mentioned_david).destroy
+    mention = mentions(:logo_comment_david_mention_by_jz)
+    expected_path = card_path(mention.card, script_name: @david.account.slug)
+
+    captured_payload = nil
+    WebPush.expects(:payload_send).with do |**args|
+      captured_payload = JSON.parse(args[:message])
+      args[:endpoint] == david_sub.endpoint
+    end.once
+
+    perform_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @david, source: mention, creator: mention.mentioner)
+    end
+
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", captured_payload["title"]
+    assert_equal mention.source.mentionable_content.truncate(200), captured_payload.dig("options", "body")
+    assert_equal expected_path, captured_payload.dig("options", "data", "path")
+  end
+
+  test "pushes when an existing notification for the same card is updated with a new source" do
+    existing = notifications(:layout_commented_kevin)
+    card = existing.card
+
+    captured_payload = nil
+    WebPush.expects(:payload_send).with do |**args|
+      captured_payload = JSON.parse(args[:message])
+      true
+    end.once
+
+    perform_enqueued_jobs only: [ NotifyRecipientsJob, Notification::PushJob ] do
+      card.comments.create!(body: "Follow-up on layout", creator: @david)
+    end
+
+    assert_equal "RE: #{card.title}", captured_payload["title"]
+    assert_equal "Follow-up on layout", captured_payload.dig("options", "body")
+    assert_equal card_path(card, script_name: @kevin.account.slug), captured_payload.dig("options", "data", "path")
+  end
+
+  test "reading and unreading a notification does not send a push" do
+    notification = notifications(:layout_commented_kevin)
+
+    WebPush.expects(:payload_send).never
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "does not push for cancelled accounts" do
+    @kevin.account.cancel(initiated_by: @david)
+    notifications(:layout_commented_kevin).destroy
+
+    WebPush.expects(:payload_send).never
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    end
+  end
+
+  test "continues delivering to remaining devices when one push service fails" do
+    second_sub = @kevin.push_subscriptions.create!(
+      endpoint: "https://updates.push.services.mozilla.com/wpush/v2/kevin-phone",
+      p256dh_key: @p256dh,
+      auth_key: @auth
+    )
+
+    stub_request(:post, @subscription.endpoint).to_return(status: 500, body: "Internal Error")
+    second_stub = stub_request(:post, second_sub.endpoint).to_return(status: 201)
+
+    notifications(:layout_commented_kevin).destroy
+
+    perform_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    end
+
+    assert_requested second_stub
+  end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
