new file mode 100644
index 0000000..1739810
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,48 @@
+class PushSubscription < ApplicationRecord
+  ENDPOINT_TIMEOUT = 5.seconds
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  belongs_to :session, optional: true
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :validate_endpoint
+
+  def push(title:, body:, path:)
+    return unless Push.configured?
+
+    WebPush.payload_send(
+      message: JSON.generate(title: title, options: { body: body, data: { path: path } }),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: Push.vapid_identification,
+      open_timeout: ENDPOINT_TIMEOUT,
+      read_timeout: ENDPOINT_TIMEOUT,
+      ssl_timeout: ENDPOINT_TIMEOUT
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized
+    destroy
+  end
+
+  private
+    def validate_endpoint
+      return if endpoint.blank?
+
+      uri = URI.parse(endpoint)
+      if uri.scheme != "https" || uri.hostname.blank?
+        errors.add(:endpoint, "must be an HTTPS URL")
+      elsif ip_literal?(uri.hostname) && SsrfProtection.blocked_address?(uri.hostname)
+        errors.add(:endpoint, "is not allowed")
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "is not a valid URL")
+    end
+
+    def ip_literal?(hostname)
+      IPAddr.new(hostname)
+      true
+    rescue IPAddr::InvalidAddressError
+      false
+    end
+end
