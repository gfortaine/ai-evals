diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..6f573f6
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,31 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy
+
+    delegate :key, to: :publication, prefix: true, allow_nil: true
+  end
+
+  class_methods do
+    def find_by_published_key(key)
+      joins(:publication).find_by!(board_publications: { key: key })
+    end
+  end
+
+  def published?
+    publication.present?
+  end
+  alias_method :publicly_accessible?, :published?
+
+  def publish
+    publication || create_publication!
+  end
+
+  def unpublish
+    if publication
+      publication.destroy
+      association(:publication).reset
+    end
+  end
+end
