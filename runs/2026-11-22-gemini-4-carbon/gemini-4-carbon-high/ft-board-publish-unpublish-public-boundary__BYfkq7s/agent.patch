diff --git a/app/controllers/public/base_controller.rb b/app/controllers/public/base_controller.rb
new file mode 100644
index 0000000..574cd3f
--- /dev/null
+++ b/app/controllers/public/base_controller.rb
@@ -0,0 +1,38 @@
+class Public::BaseController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthenticated_access
+
+  around_action :set_board_and_account
+
+  layout "public"
+
+  private
+    def set_board_and_account
+      @board = find_published_board
+
+      if @board.account.active?
+        Current.with_account(@board.account) do
+          yield
+        end
+      else
+        head :not_found
+      end
+    end
+
+    def find_published_board
+      scope = Current.account ? Current.account.boards : Board
+      scope.find_by_published_key(board_key)
+    end
+
+    def board_key
+      params[:board_key] || params[:key]
+    end
+
+    def default_url_options
+      if @board
+        super.merge(script_name: @board.account.slug)
+      else
+        super
+      end
+    end
+end
