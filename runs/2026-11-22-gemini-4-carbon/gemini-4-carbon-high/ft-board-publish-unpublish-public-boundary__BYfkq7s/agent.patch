diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
new file mode 100644
index 0000000..119b122
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,25 @@
+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_admin
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_back fallback_location: edit_board_path(@board) }
+      format.turbo_stream
+      format.json { render "boards/show", status: :created, location: public_board_url(@board.publication_key) }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_back fallback_location: edit_board_path(@board) }
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+end
