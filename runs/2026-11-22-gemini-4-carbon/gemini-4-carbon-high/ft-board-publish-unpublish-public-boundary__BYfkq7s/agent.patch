+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.publish
+    @card = cards(:logo)
+  end
+
+  test "anyone can open a published card of a public board directly" do
+    with_current_user(:david) do
+      @card.comments.create!(body: "Publicly visible comment")
+    end
+    step = @card.steps.create!(content: "First step", completed: true)
+    @card.reactions.create!(reacter: users(:kevin), content: "👍")
+    @card.assignments.create!(assignee: users(:david), assigner: users(:david))
+
+    get public_board_card_path(@publication.key, @card.number)
+
+    assert_response :success
+    assert_select "h1", text: @card.title
+    assert_in_body "Publicly visible comment"
+    assert_in_body step.content
+    assert_in_body "👍"
+    assert_in_body users(:kevin).familiar_name
+    assert_select "a[href='#{edit_card_path(@card)}']", count: 0
+    assert_select "form[action='#{card_comments_path(@card)}']", count: 0
+  end
+
+  test "closed and postponed published cards can be opened on a public board" do
+    with_current_user(:kevin) { @card.close }
+    get public_board_card_path(@publication.key, @card.number)
+    assert_response :success
+    assert_in_body "Completed by"
+
+    with_current_user(:david) { @card.postpone }
+    get public_board_card_path(@publication.key, @card.number)
+    assert_response :success
+    assert_in_body "Not Now"
+  end
+
+  test "drafted card of a public board cannot be opened" do
+    draft_card = @board.cards.create!(creator: users(:david), status: :drafted, title: "Unpublished draft")
+
+    get public_board_card_path(@publication.key, draft_card.number)
+    assert_response :not_found
+  end
+
+  test "card from another board cannot be opened via this board's public key" do
+    other_card = with_current_user(:kevin) do
+      other_board = Board.create!(name: "Other board")
+      other_board.cards.create!(status: :published, title: "Other board card")
+    end
+
+    get public_board_card_path(@publication.key, other_card.number)
+    assert_response :not_found
+  end
+
+  test "card cannot be opened after board is unpublished" do
+    @board.unpublish
+
+    get public_board_card_path(@publication.key, @card.number)
+    assert_response :not_found
+  end
+end
