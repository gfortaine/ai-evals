diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..e523197
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "publish and unpublish" do
+    board = boards(:writebook)
+    assert_not board.published?
+    assert_nil board.publication_key
+    assert_not board.publicly_accessible?
+
+    publication = board.publish
+    assert board.published?
+    assert board.publicly_accessible?
+    assert publication.key.present?
+    assert_equal publication.key, board.publication_key
+    assert_equal board, Board.find_by_published_key(publication.key)
+
+    original_key = publication.key
+    assert_equal publication, board.publish
+    assert_equal original_key, board.reload.publication_key
+
+    board.unpublish
+    assert_not board.reload.published?
+    assert_nil board.publication_key
+    assert_raises(ActiveRecord::RecordNotFound) do
+      Board.find_by_published_key(original_key)
+    end
+  end
+
+  test "republishing generates a new secret key" do
+    board = boards(:writebook)
+    first_key = board.publish.key
+
+    board.unpublish
+    second_key = board.publish.key
+
+    assert_not_equal first_key, second_key
+  end
+
+  test "card and comment publicly_accessible? follow published board and published card status" do
+    board = boards(:writebook)
+    published_card = cards(:logo)
+    drafted_card = board.cards.create!(creator: users(:david), status: :drafted, title: "Draft")
+    comment = published_card.comments.create!(creator: users(:david), body: "Hello")
+
+    assert_not published_card.publicly_accessible?
+    assert_not drafted_card.publicly_accessible?
+    assert_not comment.publicly_accessible?
+
+    board.publish
+
+    assert published_card.reload.publicly_accessible?
+    assert_not drafted_card.reload.publicly_accessible?
+    assert comment.reload.publicly_accessible?
+  end
+end
