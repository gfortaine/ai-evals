diff --git a/app/views/public/boards/cards/_container.html.erb b/app/views/public/boards/cards/_container.html.erb
new file mode 100644
index 0000000..e09fe99
--- /dev/null
+++ b/app/views/public/boards/cards/_container.html.erb
@@ -0,0 +1,107 @@
+<section id="<%= dom_id(card, :card_container) %>" class="card-perma" style="--card-color: <%= card.color %>;">
+  <% cache [ :public, card, board ] do %>
+    <div class="card-perma__bg">
+      <%= card_article_tag card, class: "card" do %>
+        <header class="card__header">
+          <div class="card__board">
+            <%= render "cards/display/common/board", card: card %>
+          </div>
+          <%= render "cards/display/preview/tags", card: card %>
+        </header>
+
+        <div class="card__body justify-space-between">
+          <div class="card__content">
+            <h1 class="card__title flex align-start gap-half">
+              <%= card_html_title(card) %>
+            </h1>
+
+            <% unless card.description.blank? %>
+              <div class="card__description lexxy-content" data-controller="syntax-highlight retarget-links">
+                <%= card.description %>
+              </div>
+            <% end %>
+
+            <% if card.steps.any? %>
+              <ol class="steps txt-small margin-block-start-auto">
+                <% card.steps.each do |step| %>
+                  <li class="step">
+                    <input type="checkbox" class="checkbox" disabled <%= "checked" if step.completed? %>>
+                    <span class="step__content"><%= step.content %></span>
+                  </li>
+                <% end %>
+              </ol>
+            <% end %>
+          </div>
+
+          <div class="card__stages">
+            <%= tag.span "Not now", class: [ "card__column-name btn", { "card__column-name--current": card.postponed? } ], style: "--column-color: var(--color-card-complete)" %>
+            <%= tag.span "Maybe?", class: [ "card__column-name card__column-name--stream btn", { "card__column-name--current": card.awaiting_triage? } ], style: "--column-color: var(--color-card-default)" %>
+            <% board.columns.sorted.each do |column| %>
+              <%= tag.span class: [ "card__column-name btn", { "card__column-name--current": column == card.column && card.open? } ], style: "--column-color: #{column.color}" do %>
+                <span class="overflow-ellipsis"><%= column.name %></span>
+              <% end %>
+            <% end %>
+            <%= tag.span "Done", class: [ "card__column-name btn", { "card__column-name--current": card.closed? } ], style: "--column-color: var(--color-card-complete)" %>
+          </div>
+
+          <%= render "cards/display/common/stamp", card: card %>
+        </div>
+
+        <footer class="card__footer">
+          <div class="card__meta" id="<%= dom_id(card, :meta) %>">
+            <div class="card__meta-avatars card__meta-avatars--author">
+              <%= avatar_preview_tag card.creator %>
+            </div>
+
+            <span class="card__meta-text card__meta-text--added">
+              <%= card_drafted_or_added(card) %> <%= local_datetime_tag(card.created_at, style: :daysago) %>
+            </span>
+
+            <span class="card__meta-text card__meta-text--author">
+              by <strong><%= card.creator.familiar_name %></strong>
+            </span>
+
+            <span class="card__meta-text card__meta-text--updated overflow-ellipsis">
+              <% if card.last_active_at != card.created_at %>
+                Updated
+                <%= local_datetime_tag(card.last_active_at, style: :daysago) %>
+              <% end %>
+            </span>
+
+            <span class="card__meta-text card__meta-text--assignees overflow-ellipsis">
+              <% if card.assignees.any? %>
+                Assigned to
+                <%= to_sentence(card.assignees.map { |assignee| tag.strong(assignee.familiar_name) }) %>
+              <% end %>
+            </span>
+
+            <% if card.assignees.any? %>
+              <div class="card__meta-avatars card__meta-avatars--assignees">
+                <% card.assignees.each do |assignee| %>
+                  <%= avatar_preview_tag assignee %>
+                <% end %>
+              </div>
+            <% end %>
+          </div>
+
+          <%= render "cards/display/perma/background", card: card %>
+          <%= render "public/boards/cards/reactions", reactable: card %>
+        </footer>
+      <% end %>
+
+      <% if card.entropic? %>
+        <%= render "cards/display/preview/bubble", card: card %>
+      <% end %>
+    </div>
+  <% end %>
+
+  <% if card.closed? %>
+    <div class="card-perma__closure-message flex gap-half justify-center">
+      <span>Completed by <%= card.closed_by.name %> on <%= local_datetime_tag(card.closed_at, style: :shortdate) %>.</span>
+    </div>
+  <% elsif card.entropic? && card.open? && !card.postponed? %>
+    <div class="card-perma__closure-message" id="<%= dom_id(card, :closure_notice) %>">
+      Moves to “Not Now” <%= local_datetime_tag(card.entropy.auto_clean_at, style: :indays) -%> if there’s no activity.
+    </div>
+  <% end %>
+</section>
