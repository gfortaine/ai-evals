+<% @page_title = @card.title %>
+<% @header_class = "header--card" %>
+
+<% content_for :head do %>
+  <%= tag.meta(property: "og:title", content: "#{@card.title} | #{@board.name}") %>
+  <%= tag.meta(property: "og:description", content: format_excerpt(@card&.description, length: 200)) %>
+  <%= tag.meta(property: "og:image", content: @card.image.attached? ? "#{request.base_url}#{url_for(@card.image)}" : "#{request.base_url}/opengraph.png") %>
+  <%= tag.meta(property: "og:url", content: public_board_card_url(@board.publication_key, @card)) %>
+<% end %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to @board.name, public_board_path(@board.publication_key), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+<% end %>
+
+<div data-controller="lightbox">
+  <%= render "public/boards/cards/container", card: @card, board: @board %>
+  <%= render "public/boards/cards/messages", card: @card %>
+
+  <%= render "layouts/lightbox" %>
+</div>
+
+<%= render "public/footer" %>
