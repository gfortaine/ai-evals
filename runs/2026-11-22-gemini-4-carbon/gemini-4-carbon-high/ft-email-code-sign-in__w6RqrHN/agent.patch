+require "application_system_test_case"
+
+class AuthenticationTest < ApplicationSystemTestCase
+  include ActionMailer::TestHelper
+
+  test "sign in by email code" do
+    visit new_session_url(script_name: nil)
+
+    assert_emails 1 do
+      fill_in "email_address", with: identities(:kevin).email_address
+      click_on "Let’s go"
+      assert_selector "h1", text: "Check your email"
+    end
+
+    code = ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}/]
+    fill_in "Code", with: code
+    click_on "Continue"
+
+    assert_current_path root_path
+  end
+
+  test "sign up by email code" do
+    visit new_signup_url(script_name: nil)
+
+    assert_emails 1 do
+      fill_in "signup_email_address", with: "browser-signup@example.com"
+      click_on "Let’s go"
+      assert_selector "h1", text: "Check your email"
+    end
+
+    code = ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}/]
+    fill_in "Code", with: code
+    click_on "Continue"
+
+    assert_selector "h1", text: "Complete your sign-up"
+    fill_in "signup_full_name", with: "Browser User"
+    click_on "Continue"
+
+    assert_selector "h2", text: "Welcome, and thanks for signing up for Fizzy."
+    account = Identity.find_by!(email_address: "browser-signup@example.com").accounts.last
+    assert_includes current_path, account.slug
+  end
+
+  test "join with a join code by email code" do
+    account = accounts("37s")
+    join_code = account_join_codes("37s")
+
+    visit join_url(code: join_code.code, script_name: account.slug)
+
+    assert_emails 1 do
+      fill_in "email_address", with: "browser-joiner@example.com"
+      click_on "Continue"
+      assert_selector "h1", text: "Check your email"
+    end
+
+    code = ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}/]
+    fill_in "Code", with: code
+    click_on "Continue"
+
+    assert_selector "h1", text: "Great! Now enter your name"
+    fill_in "user_name", with: "Browser Joiner"
+    click_on "Continue"
+
+    assert_no_selector "h1", text: "Great! Now enter your name"
+    assert_includes current_path, account.slug
+    user = account.users.joins(:identity).find_by!(identities: { email_address: "browser-joiner@example.com" })
+    assert_predicate user, :verified?
+    assert_equal "Browser Joiner", user.name
+  end
+end
