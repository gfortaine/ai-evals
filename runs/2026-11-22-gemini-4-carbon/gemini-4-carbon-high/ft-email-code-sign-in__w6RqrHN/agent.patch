+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+  <p class="margin-none">Then enter the verification code below:</p>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap", data: { controller: "form" } do |form| %>
+    <%= form.label :code, "Code", class: "for-screen-reader" %>
+    <%= form.text_field :code, required: true, class: "input center txt-uppercase",
+          autofocus: true, autocomplete: "one-time-code", autocorrect: "off", autocapitalize: "characters",
+          spellcheck: "false", placeholder: "••••••" %>
+
+    <p class="txt-small txt-subtle margin-none">
+      The code sent to <strong><%= email_address_pending_authentication %></strong> will work for <%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>.
+    </p>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <% if Rails.env.development? && flash[:magic_link_code].present? %>
+    <div class="flex align-center justify-center gap-half fill-shade border-radius pad margin-block-start txt-small">
+      <span>Psst, here's your code:</span>
+      <code class="font-weight-black"><%= flash[:magic_link_code] %></code>
+    </div>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
