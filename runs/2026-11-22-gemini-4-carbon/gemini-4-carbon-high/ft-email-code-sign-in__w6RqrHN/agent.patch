diff --git a/test/models/magic_link/code_test.rb b/test/models/magic_link/code_test.rb
new file mode 100644
index 0000000..279c317
--- /dev/null
+++ b/test/models/magic_link/code_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class MagicLink::CodeTest < ActiveSupport::TestCase
+  test "generate creates code of requested length from unambiguous alphabet" do
+    code = MagicLink::Code.generate(6)
+
+    assert_equal 6, code.length
+    assert_match(/\A[0-9A-HJ-KM-NP-Z]{6}\z/, code)
+  end
+
+  test "sanitize normalizes case, substitutions, and strips formatting" do
+    assert_equal "ABC123", MagicLink::Code.sanitize("abc-123")
+    assert_equal "ABC123", MagicLink::Code.sanitize("  abc 123 ")
+    assert_equal "011234", MagicLink::Code.sanitize("OIL234")
+    assert_equal "011234", MagicLink::Code.sanitize("oil234")
+    assert_nil MagicLink::Code.sanitize("")
+    assert_nil MagicLink::Code.sanitize("   ")
+    assert_nil MagicLink::Code.sanitize("---")
+    assert_nil MagicLink::Code.sanitize(nil)
+  end
+end
diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..59794ef
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "generates 6-character code and 15-minute expiration on create" do
+    freeze_time do
+      magic_link = @identity.magic_links.create!
+
+      assert_equal 6, magic_link.code.length
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert_predicate magic_link, :for_sign_in?
+    end
+  end
+
+  test "consume returns and destroys active magic link" do
+    magic_link = @identity.magic_links.create!
+
+    consumed = MagicLink.consume(magic_link.code)
+    assert_equal magic_link, consumed
+    assert_not MagicLink.exists?(magic_link.id)
+
+    assert_nil MagicLink.consume(magic_link.code)
+  end
+
+  test "consume accepts lowercase and formatted codes" do
+    magic_link = @identity.magic_links.create!
+
+    consumed = MagicLink.consume(" #{magic_link.code.downcase} ")
+    assert_equal magic_link, consumed
+  end
+
+  test "consume rejects expired magic link after 15 minutes" do
+    freeze_time do
+      magic_link = @identity.magic_links.create!
+
+      travel 15.minutes
+      assert_nil MagicLink.consume(magic_link.code)
+      assert MagicLink.exists?(magic_link.id)
+    end
+  end
+
+  test "consume works right before 15 minutes" do
+    freeze_time do
+      magic_link = @identity.magic_links.create!
+
+      travel 14.minutes + 59.seconds
+      assert_equal magic_link, MagicLink.consume(magic_link.code)
+    end
+  end
+
+  test "cleanup deletes stale magic links and keeps active ones" do
+    active = @identity.magic_links.create!
+    stale = @identity.magic_links.create!(expires_at: 1.minute.ago)
+
+    MagicLink.cleanup
+
+    assert MagicLink.exists?(active.id)
+    assert_not MagicLink.exists?(stale.id)
+  end
+end
