diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..73068de
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,47 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION_TIME = 15.minutes
+
+  belongs_to :identity
+
+  enum :purpose, %w[ sign_in sign_up ].index_by(&:itself), prefix: :for, default: :sign_in
+
+  scope :active, -> { where("expires_at > ?", Time.current) }
+  scope :stale, -> { where(expires_at: ..Time.current) }
+
+  normalizes :code, with: ->(value) { Code.sanitize(value) }
+
+  before_validation :generate_code, on: :create
+  before_validation :set_expiration, on: :create
+
+  validates :code, uniqueness: true, presence: true
+
+  class << self
+    def consume(code)
+      if sanitized = Code.sanitize(code)
+        active.find_by(code: sanitized)&.consume
+      end
+    end
+
+    def cleanup
+      stale.delete_all
+    end
+  end
+
+  def consume
+    destroy
+    self
+  end
+
+  private
+    def generate_code
+      self.code ||= loop do
+        candidate = Code.generate(CODE_LENGTH)
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+
+    def set_expiration
+      self.expires_at ||= EXPIRATION_TIME.from_now
+    end
+end
diff --git a/app/models/magic_link/code.rb b/app/models/magic_link/code.rb
new file mode 100644
index 0000000..e39b412
--- /dev/null
+++ b/app/models/magic_link/code.rb
@@ -0,0 +1,32 @@
+module MagicLink::Code
+  CODE_SUBSTITUTIONS = { "O" => "0", "I" => "1", "L" => "1" }.freeze
+  ALPHABET = (("0".."9").to_a + ("A".."Z").to_a - CODE_SUBSTITUTIONS.keys).freeze
+
+  class << self
+    def generate(length)
+      SecureRandom.alphanumeric(length, chars: ALPHABET)
+    end
+
+    def sanitize(code)
+      if code.present?
+        normalize_code(code)
+      end
+    end
+
+    private
+      def normalize_code(code)
+        code.to_s.upcase
+          .then { apply_substitutions(it) }
+          .then { remove_invalid_characters(it) }
+          .presence
+      end
+
+      def apply_substitutions(code)
+        CODE_SUBSTITUTIONS.reduce(code) { |result, (from, to)| result.gsub(from, to) }
+      end
+
+      def remove_invalid_characters(code)
+        code.gsub(/[^#{ALPHABET.join}]/, "")
+      end
+  end
+end
