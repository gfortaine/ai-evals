+
+  test "create rejects invalid code and allows retrying with valid code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      magic_link = MagicLink.last
+
+      post session_magic_link_path, params: { code: "000000" }
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+      assert cookies[:pending_authentication_token].present?
+
+      post session_magic_link_path, params: { code: magic_link.code }
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create rejects already-used code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      code = MagicLink.last.code
+
+      post session_magic_link_path, params: { code: code }
+      assert cookies[:session_token].present?
+
+      sign_out
+
+      post session_path, params: { email_address: identity.email_address }
+      post session_magic_link_path, params: { code: code }
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create rejects code after 15 minutes" do
+    identity = identities(:kevin)
+
+    freeze_time do
+      untenanted do
+        post session_path, params: { email_address: identity.email_address }
+        code = MagicLink.last.code
+
+        travel 15.minutes + 1.second
+
+        post session_magic_link_path, params: { code: code }
+        assert_redirected_to new_session_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create accepts code within 15 minutes" do
+    identity = identities(:kevin)
+
+    freeze_time do
+      untenanted do
+        post session_path, params: { email_address: identity.email_address }
+        code = MagicLink.last.code
+
+        travel 14.minutes + 59.seconds
+
+        post session_magic_link_path, params: { code: code }
+        assert_redirected_to landing_url
+        assert cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create rejects code belonging to a different email address" do
+    untenanted do
+      victim_magic_link = identities(:david).magic_links.create!
+      post session_path, params: { email_address: identities(:kevin).email_address }
+
+      post session_magic_link_path, params: { code: victim_magic_link.code }
+
+      assert_redirected_to new_session_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create via JSON returns session_token or 401 on invalid code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path(format: :json), params: { email_address: identity.email_address }
+      code = MagicLink.last.code
+
+      post session_magic_link_path(format: :json), params: { code: "000000" }
+      assert_response :unauthorized
+
+      post session_magic_link_path(format: :json), params: { code: code }
+      assert_response :success
+      assert_not_nil @response.parsed_body["session_token"]
+    end
+  end
+
+  test "create is rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      Rails.cache.stubs(:increment).returns(11)
+
+      post session_magic_link_path, params: { code: "ABC123" }
+      assert_redirected_to session_magic_link_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+end
