--- /dev/null
+++ b/test/mailers/report_digest_mailer_test.rb
@@ -0,0 +1,20 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly formats published book dates as short date" do
+    books(:handbook).update!(published: true)
+    books(:handbook).update_columns(updated_at: Time.utc(2024, 6, 17, 7, 56, 43))
+
+    email = ReportDigestMailer.weekly(users(:david))
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "david@example.com" ], email.to
+    assert_equal "Your Writebook digest", email.subject
+    assert_includes email.body.to_s, "Hi David,"
+    assert_includes email.body.to_s, "* Handbook, last edited 17 Jun"
+    assert_not_includes email.body.to_s, "Manual"
+  end
+end
diff --git a/test/models/book/reportable_test.rb b/test/models/book/reportable_test.rb
new file mode 100644
index 0000000..01330f9
--- /dev/null
+++ b/test/models/book/reportable_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class Book::ReportableTest < ActiveSupport::TestCase
+  test "report_summary formats character count with delimiter" do
+    leaves(:welcome_page).leafable.update!(body: "a" * 1234)
+
+    assert_equal "Handbook — 1,259 characters", books(:handbook).report_summary
+    assert_equal "Manual — 0 characters", books(:manual).report_summary
+  end
+
+  test "leaf_count counts active leaves" do
+    assert_equal 4, books(:handbook).leaf_count
+
+    leaves(:summary_page).trashed!
+    assert_equal 3, books(:handbook).leaf_count
+  end
+
+  test "last_edited_at returns latest active leaf timestamp" do
+    timestamp = Time.utc(2025, 1, 2, 3, 4, 5)
+    leaves(:welcome_page).update_columns(updated_at: timestamp)
+    Book.find(books(:handbook).id).leaves.where.not(id: leaves(:welcome_page).id).update_all(updated_at: timestamp - 1.day)
+
+    assert_equal timestamp, books(:handbook).last_edited_at
+    assert_nil books(:manual).last_edited_at
+  end
+end
