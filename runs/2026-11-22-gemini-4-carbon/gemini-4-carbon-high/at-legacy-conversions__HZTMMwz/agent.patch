diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..4ef3cf1
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class ReportArchiveJobTest < ActiveJob::TestCase
+  teardown do
+    [ books(:handbook), books(:manual) ].each do |book|
+      FileUtils.rm_f(archive_path_for(book))
+    end
+    Dir.rmdir(Rails.root.join(ReportArchiveJob::ARCHIVE_DIR)) rescue nil
+  end
+
+  test "perform writes archived timestamp header and markable content" do
+    book = books(:handbook)
+    timestamp = Time.utc(2024, 6, 17, 7, 56, 43)
+    leaves(:welcome_page).leafable.update!(body: "# Welcome")
+    leaves(:summary_page).leafable.update!(body: "# Summary")
+    book.leaves.update_all(updated_at: timestamp)
+
+    ReportArchiveJob.perform_now(book)
+
+    content = File.read(archive_path_for(book))
+    assert_equal "# archived 2024-06-17 07:56:43 UTC\n\n#{book.markable}", content
+  end
+
+  test "perform writes blank timestamp when book has no active leaves" do
+    book = books(:manual)
+
+    ReportArchiveJob.perform_now(book)
+
+    content = File.read(archive_path_for(book))
+    assert_equal "# archived \n\n", content
+  end
+
+  private
+    def archive_path_for(book)
+      Rails.root.join(ReportArchiveJob::ARCHIVE_DIR, "book-#{book.id}.txt")
+    end
+end
diff --git a/test/lib/publishing/report_card_test.rb b/test/lib/publishing/report_card_test.rb
new file mode 100644
index 0000000..e5a82d4
--- /dev/null
+++ b/test/lib/publishing/report_card_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Publishing::ReportCardTest < ActiveSupport::TestCase
+  test "to_text formats book metadata and active positioned leaf ids" do
+    book = books(:handbook)
+    book.update_columns(
+      created_at: Time.utc(2024, 6, 15, 9, 30, 0),
+      updated_at: Time.utc(2024, 6, 17, 7, 56, 43)
+    )
+    leaves(:summary_page).trashed!
+
+    expected_ids = [
+      leaves(:welcome_section).id,
+      leaves(:welcome_page).id,
+      leaves(:reading_picture).id
+    ].join(",")
+
+    expected = <<~TEXT
+      Book: Handbook
+      Leaves: 3
+      Started: June 15, 2024 09:30
+      Updated: 17 Jun 07:56
+      Covers: #{expected_ids}
+    TEXT
+
+    assert_equal expected, Publishing::ReportCard.new(book).to_text
+  end
+
+  test "to_text outputs null covers when book has no active leaves" do
+    book = books(:manual)
+    book.update_columns(
+      created_at: Time.utc(2024, 6, 15, 9, 30, 0),
+      updated_at: Time.utc(2024, 6, 17, 7, 56, 43)
+    )
+
+    expected = <<~TEXT
+      Book: Manual
+      Leaves: 0
+      Started: June 15, 2024 09:30
+      Updated: 17 Jun 07:56
+      Covers: null
+    TEXT
+
+    assert_equal expected, Publishing::ReportCard.new(book).to_text
+  end
+end
diff --git a/test/mailers/report_digest_mailer_test.rb b/test/mailers/report_digest_mailer_test.rb
