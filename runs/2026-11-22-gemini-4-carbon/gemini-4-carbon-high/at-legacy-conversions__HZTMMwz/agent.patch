diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..96b72e9
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "show renders last updated date and delimited character summary" do
+    leaves(:welcome_page).leafable.update!(body: "a" * 1234)
+    books(:handbook).update_columns(updated_at: Time.utc(2024, 6, 17, 7, 56, 43))
+
+    get book_report_path(books(:handbook))
+
+    assert_response :success
+    assert_in_body "Last updated June 17, 2024"
+    assert_in_body "Handbook — 1,259 characters"
+  end
+
+  test "show only shows books the current user can access" do
+    sign_in :kevin
+    books(:manual).update!(everyone_access: false)
+
+    get book_report_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "show with text format downloads formatted report card" do
+    book = books(:handbook)
+    book.update_columns(
+      created_at: Time.utc(2024, 6, 15, 9, 30, 0),
+      updated_at: Time.utc(2024, 6, 17, 7, 56, 43)
+    )
+    expected_ids = [
+      leaves(:welcome_section).id,
+      leaves(:welcome_page).id,
+      leaves(:summary_page).id,
+      leaves(:reading_picture).id
+    ].join(",")
+
+    get book_report_path(book, format: :text)
+
+    assert_response :success
+    assert_equal "text/plain", response.media_type
+    assert_match(/filename="shelf-report-20240617075643\.txt"/, response.headers["Content-Disposition"])
+    assert_in_body "Book: Handbook\n"
+    assert_in_body "Leaves: 4\n"
+    assert_in_body "Started: June 15, 2024 09:30\n"
+    assert_in_body "Updated: 17 Jun 07:56\n"
+    assert_in_body "Covers: #{expected_ids}\n"
+  end
+
+  test "show with text format renders null covers for empty book" do
+    get book_report_path(books(:manual), format: :text)
+
+    assert_response :success
+    assert_in_body "Leaves: 0\n"
+    assert_in_body "Covers: null\n"
+  end
+end
