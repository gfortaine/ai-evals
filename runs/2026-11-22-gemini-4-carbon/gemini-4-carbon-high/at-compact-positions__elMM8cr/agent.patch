diff --git a/test/models/book/maintenance_test.rb b/test/models/book/maintenance_test.rb
new file mode 100644
index 0000000..0beabd5
--- /dev/null
+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+require "rake"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "compact_positions! compacts gaps while preserving hand-arranged order" do
+    leaves(:reading_picture).move_to_position(0)
+    leaves(:summary_page).move_to_position(1)
+    leaves(:welcome_page).destroy!
+
+    expected_order = [ leaves(:reading_picture), leaves(:summary_page), leaves(:welcome_section) ]
+    assert_equal expected_order, @book.leaves.active.positioned
+
+    @book.compact_positions!
+
+    assert_equal expected_order, @book.leaves.active.positioned.reload
+    assert_equal [ 1, 2, 3 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions! preserves position of trashed leaves when restored" do
+    leaves(:summary_page).move_to_position(0)
+    leaves(:reading_picture).move_to_position(2)
+    # Order before trash: summary_page, welcome_section, reading_picture, welcome_page
+    leaves(:reading_picture).trashed!
+
+    @book.compact_positions!
+
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+    assert_equal [ leaves(:summary_page), leaves(:welcome_section), leaves(:welcome_page) ], @book.leaves.active.positioned
+
+    leaves(:reading_picture).active!
+
+    assert_equal [ leaves(:summary_page), leaves(:welcome_section), leaves(:reading_picture), leaves(:welcome_page) ], @book.leaves.active.positioned
+  end
+
+  test "compact_positions! breaks score ties by id and handles empty books" do
+    leaves(:welcome_section).update!(position_score: 5)
+    leaves(:summary_page).update!(position_score: 5)
+    leaves(:welcome_page).update!(position_score: 10)
+    leaves(:reading_picture).update!(position_score: 20)
+
+    expected_order = @book.leaves.positioned.to_a
+
+    @book.compact_positions!
+    books(:manual).compact_positions!
+
+    assert_equal expected_order, @book.leaves.positioned.reload
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+    assert_empty books(:manual).leaves
+  end
+
+  test "maintenance:compact_positions rake task compacts all books" do
+    Rails.application.load_tasks unless Rake::Task.task_defined?("maintenance:compact_positions")
+
+    leaves(:reading_picture).update!(position_score: -5)
+    leaves(:summary_page).update!(position_score: 42)
+
+    expected_order = [ leaves(:reading_picture), leaves(:welcome_section), leaves(:welcome_page), leaves(:summary_page) ]
+
+    Rake::Task["maintenance:compact_positions"].reenable
+    Rake::Task["maintenance:compact_positions"].invoke
+
+    assert_equal expected_order, @book.leaves.active.positioned.reload
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "live_leaf_count counts only non-trashed leaves for the book" do
+    assert_equal 4, @book.live_leaf_count
+    assert_equal 0, books(:manual).live_leaf_count
+
+    leaves(:welcome_page).trashed!
+
+    assert_equal 3, @book.live_leaf_count
+  end
+
+  test "double-quoted unknown column names raise instead of degrading to string literals" do
+    assert_raises(ActiveRecord::StatementInvalid) do
+      Book.connection.execute('SELECT "position_socre" FROM leaves')
+    end
+  end
+end
