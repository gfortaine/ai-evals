@@ -0,0 +1,16 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly lists published books with short updated dates" do
+    books(:handbook).update!(published: true)
+    books(:handbook).update_columns(updated_at: Time.utc(2026, 6, 15, 14, 30, 45))
+
+    mail = ReportDigestMailer.weekly(users(:david))
+
+    assert_equal [ "david@example.com" ], mail.to
+    assert_equal "Your Writebook digest", mail.subject
+    assert_includes mail.body.to_s, "Hi David,"
+    assert_includes mail.body.to_s, "* Handbook, last edited 15 Jun"
+    assert_not_includes mail.body.to_s, "Manual"
+  end
+end
