diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..aaa3fd9
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @book = books(:handbook)
+    sign_in :david
+  end
+
+  test "show renders last updated date and delimited character summary" do
+    leaves(:welcome_page).page.update!(body: "a" * 1234)
+    @book.update_columns(updated_at: Time.utc(2026, 6, 15, 14, 30, 45))
+
+    get book_report_path(@book)
+
+    assert_response :success
+    assert_in_body "Last updated June 15, 2026"
+    assert_in_body "Handbook — 1,259 characters"
+  end
+
+  test "show as text downloads report card with timestamped filename" do
+    @book.update_columns(
+      created_at: Time.utc(2026, 6, 10, 9, 5, 0),
+      updated_at: Time.utc(2026, 6, 15, 14, 30, 45)
+    )
+
+    get book_report_path(@book, format: :text)
+
+    assert_response :success
+    assert_equal "text/plain", response.media_type
+    assert_includes response.headers["Content-Disposition"], 'filename="shelf-report-20260615143045.txt"'
+    assert_in_body "Book: Handbook"
+    assert_in_body "Leaves: 4"
+    assert_in_body "Started: June 10, 2026 09:05"
+    assert_in_body "Updated: 15 Jun 14:30"
+    expected_ids = [
+      leaves(:welcome_section),
+      leaves(:welcome_page),
+      leaves(:summary_page),
+      leaves(:reading_picture)
+    ].map(&:id).join(",")
+    assert_in_body "Covers: #{expected_ids}"
+  end
+end
