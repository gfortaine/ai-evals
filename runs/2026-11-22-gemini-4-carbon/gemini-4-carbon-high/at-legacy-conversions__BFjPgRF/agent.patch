diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..177df49
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class ReportArchiveJobTest < ActiveJob::TestCase
+  test "perform writes archived timestamp and markable content" do
+    book = books(:handbook)
+    leaves(:welcome_page).page.update!(body: "Welcome content")
+    book.leaves.update_all(updated_at: Time.utc(2026, 6, 10, 9, 0, 0))
+    leaves(:welcome_page).update_columns(updated_at: Time.utc(2026, 6, 15, 14, 30, 45))
+
+    ReportArchiveJob.perform_now(book)
+
+    content = File.read(archive_path(book))
+    assert content.start_with?("# archived 2026-06-15 14:30:45 UTC\n\n")
+    assert_includes content, "Welcome content"
+  ensure
+    FileUtils.rm_f archive_path(book)
+  end
+
+  test "perform writes archive header when book has no leaves" do
+    book = books(:manual)
+
+    ReportArchiveJob.perform_now(book)
+
+    assert_equal "# archived \n\n", File.read(archive_path(book))
+  ensure
+    FileUtils.rm_f archive_path(book)
+  end
+
+  private
+    def archive_path(book)
+      Rails.root.join(ReportArchiveJob::ARCHIVE_DIR, "book-#{book.id}.txt")
+    end
+end
diff --git a/test/lib/publishing/report_card_test.rb b/test/lib/publishing/report_card_test.rb
new file mode 100644
index 0000000..7efdb7f
--- /dev/null
+++ b/test/lib/publishing/report_card_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Publishing::ReportCardTest < ActiveSupport::TestCase
+  test "to_text formats dates and active positioned leaf ids" do
+    book = books(:handbook)
+    leaves(:summary_page).trashed!
+    book.update_columns(
+      created_at: Time.utc(2026, 6, 10, 9, 5, 0),
+      updated_at: Time.utc(2026, 6, 15, 14, 30, 45)
+    )
+
+    expected_covers = [
+      leaves(:welcome_section),
+      leaves(:welcome_page),
+      leaves(:reading_picture)
+    ].map(&:id).join(",")
+
+    expected = <<~TEXT
+      Book: Handbook
+      Leaves: 3
+      Started: June 10, 2026 09:05
+      Updated: 15 Jun 14:30
+      Covers: #{expected_covers}
+    TEXT
+
+    assert_equal expected, Publishing::ReportCard.new(book).to_text
+  end
+
+  test "to_text formats empty leaf list as null" do
+    book = books(:manual)
+    book.update_columns(
+      created_at: Time.utc(2026, 6, 10, 9, 5, 0),
+      updated_at: Time.utc(2026, 6, 15, 14, 30, 45)
+    )
+
+    expected = <<~TEXT
+      Book: Manual
+      Leaves: 0
+      Started: June 10, 2026 09:05
+      Updated: 15 Jun 14:30
+      Covers: null
+    TEXT
+
+    assert_equal expected, Publishing::ReportCard.new(book).to_text
+  end
+end
diff --git a/test/lib/tasks/shelf_rake_test.rb b/test/lib/tasks/shelf_rake_test.rb
new file mode 100644
index 0000000..268e190
--- /dev/null
+++ b/test/lib/tasks/shelf_rake_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+require "rake"
+
+class ShelfRakeTest < ActiveJob::TestCase
+  setup do
+    Rails.application.load_tasks unless Rake::Task.task_defined?("shelf:archive")
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "shelf:archive enqueues archive job for every book" do
+    assert_enqueued_with(job: ReportArchiveJob, args: [ books(:handbook) ]) do
+      assert_enqueued_with(job: ReportArchiveJob, args: [ books(:manual) ]) do
+        Rake::Task["shelf:archive"].execute
+      end
+    end
+  end
+
+  test "shelf:digest mails weekly digest to active users" do
+    books(:handbook).update!(published: true)
+    books(:handbook).update_columns(updated_at: Time.utc(2026, 6, 15, 14, 30, 45))
+
+    perform_enqueued_jobs do
+      Rake::Task["shelf:digest"].execute
+    end
+
+    assert_equal User.active.count, ActionMailer::Base.deliveries.size
+    assert_includes ActionMailer::Base.deliveries.first.body.to_s, "* Handbook, last edited 15 Jun"
+  end
+end
