+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "creating an event enqueues Event::RelayJob" do
+    card = cards(:logo)
+
+    assert_enqueued_with(job: Event::RelayJob) do
+      card.close
+    end
+  end
+
+  test "relay_now triggers active webhooks subscribed to the action on the same board" do
+    webhook = webhooks(:active)
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    assert_difference -> { webhook.deliveries.count }, 1 do
+      perform_enqueued_jobs do
+        cards(:logo).close
+      end
+    end
+
+    assert_requested stub, times: 1
+    assert webhook.deliveries.ordered.first.succeeded?
+  end
+
+  test "does not trigger inactive webhooks" do
+    webhook = webhooks(:active)
+    webhook.deactivate
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      perform_enqueued_jobs do
+        cards(:logo).close
+      end
+    end
+
+    assert_not_requested stub
+  end
+
+  test "does not trigger webhooks on other boards" do
+    other_board_webhook = Webhook.create!(
+      board: boards(:private),
+      name: "Other Board Hook",
+      url: "https://other.example.com/webhooks",
+      subscribed_actions: [ "card_closed" ]
+    )
+    stub_request(:post, webhooks(:active).url).to_return(status: 200)
+    other_stub = stub_request(:post, other_board_webhook.url).to_return(status: 200)
+
+    assert_no_difference -> { other_board_webhook.deliveries.count } do
+      perform_enqueued_jobs do
+        cards(:logo).close
+      end
+    end
+
+    assert_not_requested other_stub
+  end
+
+  test "does not trigger webhooks not subscribed to the event action" do
+    webhook = webhooks(:active) # subscribed to card_published, card_assigned, card_closed
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      perform_enqueued_jobs do
+        cards(:logo).comments.create!(body: "Unsubscribed comment event")
+      end
+    end
+
+    assert_not_requested stub
+  end
+
+  test "relay_now is idempotent and delivers at most once per webhook and event" do
+    webhook = webhooks(:active)
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+    event = events(:logo_published)
+    webhook.deliveries.where(event: event).delete_all
+
+    perform_enqueued_jobs do
+      event.relay_now
+      event.relay_now
+    end
+
+    assert_equal 1, webhook.deliveries.where(event: event).count
+    assert_requested stub, times: 1
+  end
+
+  test "relays auto_postponed events created without Current.account" do
+    board = boards(:writebook)
+    webhook = Webhook.create!(
+      board: board,
+      name: "Auto Postpone Hook",
+      url: "https://autopostpone.example.com/webhooks",
+      subscribed_actions: [ "card_auto_postponed" ]
+    )
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    card = cards(:logo)
+    card.update_column(:last_active_at, 100.days.ago)
+
+    Current.without_account do
+      perform_enqueued_jobs do
+        Card.auto_postpone_all_due
+      end
+    end
+
+    assert_requested stub, times: 1
+    assert webhook.deliveries.last.succeeded?
+  end
+end
