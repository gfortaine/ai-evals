--- /dev/null
+++ b/test/models/webhook/triggerable_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Webhook::TriggerableTest < ActiveSupport::TestCase
+  test "triggered_by matches exact action and does not match substring actions" do
+    board = boards(:writebook)
+    postponed_webhook = Webhook.create!(
+      board: board,
+      name: "Postponed Only",
+      url: "https://example.com/postponed",
+      subscribed_actions: [ "card_postponed" ]
+    )
+    auto_postponed_webhook = Webhook.create!(
+      board: board,
+      name: "Auto Postponed Only",
+      url: "https://example.com/auto_postponed",
+      subscribed_actions: [ "card_auto_postponed" ]
+    )
+
+    auto_event = Event.create!(
+      board: board,
+      creator: users(:system),
+      eventable: cards(:logo),
+      action: "card_auto_postponed"
+    )
+
+    triggered = Webhook.triggered_by(auto_event)
+    assert_includes triggered, auto_postponed_webhook
+    assert_not_includes triggered, postponed_webhook
+  end
+
+  test "trigger creates a pending delivery and enqueues DeliveryJob once" do
+    webhook = webhooks(:active)
+    event = events(:layout_commented)
+
+    delivery = nil
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+      delivery = webhook.trigger(event)
+    end
+
+    assert delivery.pending?
+    assert_equal event, delivery.event
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      duplicate = webhook.trigger(event)
+      assert_equal delivery.id, duplicate.id
+    end
+  end
+end
