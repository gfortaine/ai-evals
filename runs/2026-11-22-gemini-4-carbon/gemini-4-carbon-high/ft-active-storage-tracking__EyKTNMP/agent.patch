+++ b/app/models/storage/totaled.rb
@@ -0,0 +1,21 @@
+module Storage::Totaled
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :storage_total, class_name: "Storage::Total", as: :owner
+  end
+
+  def bytes_used
+    if new_record? || destroyed?
+      0
+    else
+      Storage::Total.where(owner: self).pick(:bytes_used) || 0
+    end
+  end
+
+  def materialize_storage_later
+    Current.with_account(account) do
+      Storage::MaterializeJob.perform_later(self)
+    end
+  end
+end
