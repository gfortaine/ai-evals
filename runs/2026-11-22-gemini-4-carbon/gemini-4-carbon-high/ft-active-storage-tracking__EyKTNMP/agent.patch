+class CreateStorageTables < ActiveRecord::Migration[8.2]
+  def change
+    create_table :storage_entries, id: :uuid do |t|
+      t.uuid :account_id, null: false
+      t.uuid :board_id, null: false
+      t.bigint :delta, null: false
+      t.datetime :created_at, null: false
+
+      t.index [ :board_id, :id ]
+      t.index [ :account_id, :board_id ]
+    end
+
+    create_table :storage_totals, id: :uuid do |t|
+      t.uuid :account_id, null: false
+      t.uuid :owner_id, null: false
+      t.string :owner_type, null: false
+      t.bigint :bytes_used, default: 0, null: false
+      t.timestamps
+
+      t.index [ :owner_type, :owner_id ], unique: true
+      t.index [ :account_id, :owner_type, :bytes_used ], name: "index_storage_totals_on_account_owner_bytes"
+    end
+  end
+end
