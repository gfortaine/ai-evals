+++ b/app/models/storage/card.rb
@@ -0,0 +1,49 @@
+module Storage::Card
+  extend ActiveSupport::Concern
+
+  included do
+    after_update :transfer_storage_to_new_board, if: :saved_change_to_board_id?
+  end
+
+  private
+    def transfer_storage_to_new_board
+      old_board = ::Board.find_by(id: board_id_before_last_save)
+      return unless old_board
+
+      bytes = card_storage_bytes
+      if bytes > 0
+        Storage::Entry.record(account_id: old_board.account_id, board_id: old_board.id, delta: -bytes)
+        Storage::Entry.record(account_id: account_id, board_id: board_id, delta: bytes)
+      end
+    end
+
+    def card_storage_bytes
+      card_image_bytes + card_description_embed_bytes + card_comment_embed_bytes
+    end
+
+    def card_image_bytes
+      ::ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "Card", record_id: id, name: "image")
+        .lock("FOR SHARE")
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_description_embed_bytes
+      ::ActiveStorage::Attachment.joins(:blob)
+        .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+        .where(record_type: "ActionText::RichText", name: "embeds")
+        .where(action_text_rich_texts: { record_type: "Card", record_id: id, name: "description" })
+        .lock("FOR SHARE")
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_comment_embed_bytes
+      ::ActiveStorage::Attachment.joins(:blob)
+        .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+        .joins("INNER JOIN comments ON comments.id = action_text_rich_texts.record_id")
+        .where(record_type: "ActionText::RichText", name: "embeds")
+        .where(action_text_rich_texts: { record_type: "Comment", name: "body" }, comments: { card_id: id })
+        .lock("FOR SHARE")
+        .sum("active_storage_blobs.byte_size")
+    end
+end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
