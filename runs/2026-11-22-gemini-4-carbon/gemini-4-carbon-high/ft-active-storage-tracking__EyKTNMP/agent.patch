+++ b/app/models/storage/entry.rb
@@ -0,0 +1,13 @@
+class Storage::Entry < ApplicationRecord
+  belongs_to :account, optional: true
+  belongs_to :board, optional: true
+
+  class << self
+    def record(account_id:, board_id:, delta:)
+      return if delta.zero? || Storage.suppressed?(account_id: account_id, board_id: board_id)
+
+      create!(account_id: account_id, board_id: board_id, delta: delta)
+      Storage.enqueue_materialization_for_board(account_id: account_id, board_id: board_id)
+    end
+  end
+end
diff --git a/app/models/storage/total.rb b/app/models/storage/total.rb
new file mode 100644
index 0000000..22dc86f
--- /dev/null
+++ b/app/models/storage/total.rb
@@ -0,0 +1,33 @@
+class Storage::Total < ApplicationRecord
+  belongs_to :account, optional: true
+  belongs_to :owner, polymorphic: true, optional: true
+
+  class << self
+    def for_locked(owner)
+      if total = lock.find_by(owner: owner)
+        total
+      else
+        now = Time.current
+        insert({
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: account_id_for(owner),
+          owner_type: owner.class.name,
+          owner_id: owner.id,
+          bytes_used: 0,
+          created_at: now,
+          updated_at: now
+        })
+        lock.find_by!(owner: owner)
+      end
+    end
+
+    private
+      def account_id_for(owner)
+        if owner.is_a?(::Account)
+          owner.id
+        else
+          owner.account_id
+        end
+      end
+  end
+end
diff --git a/app/models/storage/totaled.rb b/app/models/storage/totaled.rb
