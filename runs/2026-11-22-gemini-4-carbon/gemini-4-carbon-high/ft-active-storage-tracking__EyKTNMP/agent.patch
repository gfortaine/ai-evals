new file mode 100644
index 0000000..fe98eb5
--- /dev/null
+++ b/test/integration/storage_tracking_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class StorageTrackingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    clear_enqueued_jobs
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+  end
+
+  test "tracks storage across controller actions for boards, cards, images, and comments" do
+    moon_size = file_fixture("moon.jpg").size
+
+    # Upload card image via controller
+    patch card_path(@card), as: :turbo_stream, params: {
+      card: { image: fixture_file_upload("moon.jpg", "image/jpeg") }
+    }
+    assert_response :success
+    perform_enqueued_jobs
+
+    assert_equal moon_size, @board.bytes_used
+    assert_equal moon_size, @account.bytes_used
+
+    # Embed file in board public description via controller
+    blob = Current.with_account(@account) do
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("board-embed" * 100),
+        filename: "guide.txt",
+        content_type: "text/plain"
+      )
+    end
+    patch board_path(@board), params: {
+      board: { name: @board.name, public_description: "<p>#{ActionText::Attachment.from_attachable(blob).to_html}</p>" }
+    }
+    assert_response :redirect
+    perform_enqueued_jobs
+
+    assert_equal moon_size + blob.byte_size, @board.bytes_used
+    assert_equal moon_size + blob.byte_size, @account.bytes_used
+
+    # Post comment with embedded file via controller
+    comment_blob = Current.with_account(@account) do
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("comment-embed" * 50),
+        filename: "Attachment.txt",
+        content_type: "text/plain"
+      )
+    end
+    post card_comments_path(@card), as: :turbo_stream, params: {
+      comment: { body: "<p>#{ActionText::Attachment.from_attachable(comment_blob).to_html}</p>" }
+    }
+    assert_response :success
+    perform_enqueued_jobs
+
+    assert_equal moon_size + blob.byte_size + comment_blob.byte_size, @board.bytes_used
+    assert_equal moon_size + blob.byte_size + comment_blob.byte_size, @account.bytes_used
+
+    # Move card to another board via controller
+    patch card_board_path(@card), params: { board_id: @other_board.id }
+    assert_response :redirect
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal moon_size + comment_blob.byte_size, @other_board.bytes_used
+    assert_equal moon_size + blob.byte_size + comment_blob.byte_size, @account.bytes_used
+
+    # Delete card image via controller
+    delete card_image_path(@card)
+    assert_response :redirect
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal comment_blob.byte_size, @other_board.bytes_used
+    assert_equal blob.byte_size + comment_blob.byte_size, @account.bytes_used
+
+    # Destroy board via controller
+    delete board_path(@board)
+    assert_response :redirect
+    perform_enqueued_jobs
+
+    assert_equal comment_blob.byte_size, @account.bytes_used
+  end
+end
diff --git a/test/models/storage_test.rb b/test/models/storage_test.rb
new file mode 100644
index 0000000..dfbb766
--- /dev/null
+++ b/test/models/storage_test.rb
@@ -0,0 +1,520 @@
+require "test_helper"
+
+class StorageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+    Current.session = sessions(:david)
+  end
+
+  test "account and board start with zero bytes used" do
+    assert_equal 0, Account.new.bytes_used
+    assert_equal 0, Board.new.bytes_used
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "bytes_used is calculated in the background" do
+    blob = create_blob("card image content", filename: "card.png", content_type: "image/png")
+
+    assert_enqueued_with(job: Storage::MaterializeJob, args: [ @board ]) do
+      @card.image.attach(blob)
+    end
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+  end
+
+  test "counts card images on published and drafted cards across attach, replace, purge_later, purge, detach, and nil" do
+    blob1 = create_blob("a" * 1_200, filename: "one.png", content_type: "image/png")
+    blob2 = create_blob("b" * 2_500, filename: "two.png", content_type: "image/png")
+    draft_blob = create_blob("c" * 800, filename: "draft.png", content_type: "image/png")
+
+    perform_enqueued_jobs do
+      @card.image.attach(blob1)
+    end
+    assert_equal 1_200, @board.bytes_used
+    assert_equal 1_200, @account.bytes_used
+
+    # Replace card image
+    perform_enqueued_jobs do
+      @card.image.attach(blob2)
+    end
+    assert_equal 2_500, @board.bytes_used
+    assert_equal 2_500, @account.bytes_used
+
+    # Attach image on a drafted card, then publish it (no double count)
+    draft = @board.cards.create!(creator: users(:david), status: :drafted)
+    perform_enqueued_jobs do
+      draft.image.attach(draft_blob)
+    end
+    assert_equal 3_300, @board.bytes_used
+    assert_equal 3_300, @account.bytes_used
+
+    perform_enqueued_jobs do
+      draft.publish
+    end
+    assert_equal 3_300, @board.bytes_used
+    assert_equal 3_300, @account.bytes_used
+
+    # Remove via purge_later (controller path)
+    perform_enqueued_jobs do
+      @card.image.purge_later
+    end
+    assert_equal 800, @board.bytes_used
+    assert_equal 800, @account.bytes_used
+
+    # Remove via detach
+    perform_enqueued_jobs do
+      draft.image.detach
+    end
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    # Re-attach and remove via purge and update!(image: nil)
+    b3 = create_blob("d" * 400, filename: "three.png", content_type: "image/png")
+    b4 = create_blob("e" * 600, filename: "four.png", content_type: "image/png")
+    perform_enqueued_jobs do
+      @card.image.attach(b3)
+      draft.image.attach(b4)
+    end
+    assert_equal 1_000, @board.bytes_used
+
+    perform_enqueued_jobs do
+      @card.image.purge
+    end
+    assert_equal 600, @board.bytes_used
+
+    perform_enqueued_jobs do
+      draft.update!(image: nil)
+    end
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "double destroy of the same attachment instance only subtracts once" do
+    blob1 = create_blob("x" * 1_000)
+    blob2 = create_blob("y" * 500)
+    other_card = cards(:layout)
+
+    perform_enqueued_jobs do
+      @card.image.attach(blob1)
+      other_card.image.attach(blob2)
+    end
+    assert_equal 1_500, @board.bytes_used
+
+    att_copy_1 = ActiveStorage::Attachment.find(@card.image.attachment.id)
+    att_copy_2 = ActiveStorage::Attachment.find(@card.image.attachment.id)
+
+    perform_enqueued_jobs do
+      att_copy_1.destroy
+      att_copy_2.destroy
+    end
+
+    assert_equal 500, @board.bytes_used
+    assert_equal 500, @account.bytes_used
+  end
+
+  test "counts files embedded in board descriptions without counting generated image variants" do
+    moon_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    pdf_blob = create_blob("pdf-bytes" * 100, filename: "spec.pdf", content_type: "application/pdf")
+
+    @board.update!(public_description: "<p>Welcome #{embed_html(moon_blob)} #{embed_html(pdf_blob)}</p>")
+    perform_enqueued_jobs
+
+    assert_operator ActiveStorage::VariantRecord.where(blob: moon_blob).count, :>, 0
+    expected = moon_blob.byte_size + pdf_blob.byte_size
+    assert_equal expected, @board.bytes_used
+    assert_equal expected, @account.bytes_used
+
+    # Remove one embed
+    perform_enqueued_jobs do
+      @board.update!(public_description: "<p>Welcome #{embed_html(pdf_blob)}</p>")
+    end
+    assert_equal pdf_blob.byte_size, @board.bytes_used
+    assert_equal pdf_blob.byte_size, @account.bytes_used
+
+    # Clear description to empty string
+    perform_enqueued_jobs do
+      @board.update!(public_description: "")
+    end
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "counts files embedded in card descriptions and ignores remote media and mentions" do
+    file_blob = create_blob("card-doc" * 200, filename: "notes.txt", content_type: "text/plain")
+    mention_html = ActionText::Attachment.from_attachable(users(:jz)).to_html
+    remote_video = <<~HTML
+      <action-text-attachment url="https://example.com/demo.mp4" content-type="video/mp4" filename="demo.mp4"></action-text-attachment>
+      <action-text-attachment url="https://example.com/pic.png" content-type="image/png" filename="pic.png"></action-text-attachment>
+    HTML
+
+    perform_enqueued_jobs do
+      @card.update!(description: "<p>Hi #{mention_html} #{embed_html(file_blob)} #{remote_video}</p>")
+    end
+
+    assert_equal file_blob.byte_size, @board.bytes_used
+    assert_equal file_blob.byte_size, @account.bytes_used
+
+    # Clear to nil
+    perform_enqueued_jobs do
+      @card.update!(description: nil)
+    end
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "counts files embedded in comments across create, update, and destroy" do
+    c1_blob = create_blob("comment-1" * 150)
+    c2_blob = create_blob("comment-2" * 300)
+
+    comment = nil
+    perform_enqueued_jobs do
+      comment = @card.comments.create!(body: "<p>See #{embed_html(c1_blob)}</p>")
+    end
+    assert_equal c1_blob.byte_size, @board.bytes_used
+    assert_equal c1_blob.byte_size, @account.bytes_used
+
+    perform_enqueued_jobs do
+      comment.update!(body: "<p>Updated #{embed_html(c1_blob)} and #{embed_html(c2_blob)}</p>")
+    end
+    assert_equal c1_blob.byte_size + c2_blob.byte_size, @board.bytes_used
+    assert_equal c1_blob.byte_size + c2_blob.byte_size, @account.bytes_used
+
+    perform_enqueued_jobs do
+      comment.destroy!
+    end
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "aggregates board usage across board and cards, and account usage across all boards in isolation" do
+    board_1_blob = create_blob("b1" * 500)
+    board_2_blob = create_blob("b2" * 700)
+    other_account = accounts(:initech)
+    other_account_board = boards(:miltons_wish_list)
+    other_account_card = cards(:unfinished_thoughts)
+
+    other_account_blob = Current.with_account(other_account) do
+      create_blob("initech" * 400)
+    end
+
+    perform_enqueued_jobs do
+      @board.update!(public_description: "<p>#{embed_html(board_1_blob)}</p>")
+      other_board_card = @other_board.cards.create!(title: "Private card", creator: users(:david), status: :published)
+      other_board_card.image.attach(board_2_blob)
+      other_account_card.image.attach(other_account_blob)
+    end
+
+    assert_equal 1_000, @board.bytes_used
+    assert_equal 1_400, @other_board.bytes_used
+    assert_equal 2_400, @account.bytes_used
+
+    assert_equal 2_800, other_account_board.bytes_used
+    assert_equal 2_800, other_account.bytes_used
+  end
+
+  test "moving a card between boards transfers card image, description, and comment bytes" do
+    img_blob = create_blob("i" * 1_000)
+    desc_blob = create_blob("d" * 2_000)
+    comm_blob = create_blob("c" * 3_000)
+    stay_blob = create_blob("s" * 500)
+
+    perform_enqueued_jobs do
+      @board.update!(public_description: "<p>#{embed_html(stay_blob)}</p>")
+      @card.image.attach(img_blob)
+      @card.update!(description: "<p>#{embed_html(desc_blob)}</p>")
+      @card.comments.create!(body: "<p>#{embed_html(comm_blob)}</p>")
+    end
+
+    assert_equal 6_500, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 6_500, @account.bytes_used
+
+    perform_enqueued_jobs do
+      @card.move_to(@other_board)
+    end
+
+    assert_equal 500, @board.bytes_used
+    assert_equal 6_000, @other_board.bytes_used
+    assert_equal 6_500, @account.bytes_used
+  end
+
+  test "attaching and moving a card in the same transaction or across multiple moves stays exact" do
+    b1 = create_blob("m" * 900)
+    third_board = @account.boards.create!(name: "Third", creator: users(:david))
+
+    perform_enqueued_jobs do
+      Card.transaction do
+        @card.image.attach(b1)
+        @card.move_to(@other_board)
+      end
+    end
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 900, @other_board.bytes_used
+    assert_equal 0, third_board.bytes_used
+    assert_equal 900, @account.bytes_used
+
+    # Chained moves before jobs run: other_board -> board -> third_board
+    @card.move_to(@board)
+    @card.move_to(third_board)
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 900, third_board.bytes_used
+    assert_equal 900, @account.bytes_used
+  end
+
+  test "destroying a card removes its image, description, and comment bytes" do
+    img_blob = create_blob("i" * 1_100)
+    desc_blob = create_blob("d" * 2_200)
+    comm_blob = create_blob("c" * 3_300)
+
+    perform_enqueued_jobs do
+      @card.image.attach(img_blob)
+      @card.update!(description: "<p>#{embed_html(desc_blob)}</p>")
+      @card.comments.create!(body: "<p>#{embed_html(comm_blob)}</p>")
+    end
+    assert_equal 6_600, @board.bytes_used
+    assert_equal 6_600, @account.bytes_used
+
+    perform_enqueued_jobs do
+      @card.destroy!
+    end
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "destroying a board updates account bytes in the background without per-attachment entry churn" do
+    b1_blob = create_blob("1" * 1_500)
+    b1_unmaterialized_blob = create_blob("u" * 750)
+    b2_blob = create_blob("2" * 2_000)
+
+    other_card = @other_board.cards.create!(title: "Other", creator: users(:david), status: :published)
+
+    perform_enqueued_jobs do
+      @card.image.attach(b1_blob)
+      other_card.image.attach(b2_blob)
+    end
+    assert_equal 3_500, @account.bytes_used
+
+    # Also add an unmaterialized attachment on @board right before destroying @board
+    @board.update!(public_description: "<p>#{embed_html(b1_unmaterialized_blob)}</p>")
+    clear_enqueued_jobs
+
+    assert_enqueued_with(job: Storage::MaterializeJob, args: [ @account ]) do
+      @board.destroy!
+    end
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, Storage::Entry.where(board_id: @board.id).count
+    # Account still reflects previous materialized value until background job runs
+    assert_equal 3_500, @account.bytes_used
+
+    perform_enqueued_jobs
+
+    assert_equal 2_000, @account.bytes_used
+  end
+
+  test "destroying an account cleans up all storage records without enqueueing storage jobs" do
+    temp_account = Account.create_with_owner(
+      account: { name: "Temp Account" },
+      owner: { name: "David", identity: identities(:david) }
+    )
+    owner = temp_account.users.find_by!(role: :owner)
+
+    Current.set(account: temp_account, user: owner) do
+      board = temp_account.boards.create!(name: "Temp Board")
+      card = board.cards.create!(title: "Temp Card", status: :published)
+      blob = create_blob("temp" * 500)
+
+      perform_enqueued_jobs do
+        card.image.attach(blob)
+      end
+      assert_equal 2_000, temp_account.bytes_used
+
+      assert_no_enqueued_jobs(only: Storage::MaterializeJob) do
+        temp_account.destroy!
+      end
+
+      assert_equal 0, temp_account.bytes_used
+      assert_equal 0, Storage::Entry.where(account_id: temp_account.id).count
+      assert_equal 0, Storage::Total.where(account_id: temp_account.id).count
+    end
+  end
+
+  test "ignores user avatars, exports, imports, and unattached blobs" do
+    users(:david).avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+
+    export = Account::Export.create!(account: @account, user: users(:david))
+    export.file.attach(io: StringIO.new("zip" * 1_000), filename: "export.zip", content_type: "application/zip")
+
+    import = Account::Import.create!(account: @account, identity: identities(:david))
+    import.file.attach(io: StringIO.new("imp" * 1_000), filename: "import.zip", content_type: "application/zip")
+
+    create_blob("unattached" * 500)
+
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "coalesces multiple attachment changes in a single transaction into one job per board and respects rollbacks" do
+    blobs = 5.times.map { |i| create_blob("f#{i}" * 100, filename: "f#{i}.txt") }
+
+    assert_enqueued_jobs 1, only: Storage::MaterializeJob do
+      ApplicationRecord.transaction do
+        @card.image.attach(blobs[0])
+        @card.update!(description: "<p>#{embed_html(blobs[1])} #{embed_html(blobs[2])}</p>")
+        @card.comments.create!(body: "<p>#{embed_html(blobs[3])} #{embed_html(blobs[4])}</p>")
+      end
+    end
+
+    perform_enqueued_jobs
+    expected = blobs.sum(&:byte_size)
+    assert_equal expected, @board.bytes_used
+    assert_equal expected, @account.bytes_used
+
+    # Rolled-back transaction does not enqueue or alter usage
+    rollback_blob = create_blob("rolled-back" * 300)
+    assert_no_enqueued_jobs(only: Storage::MaterializeJob) do
+      ApplicationRecord.transaction do
+        cards(:layout).image.attach(rollback_blob)
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_equal expected, @board.bytes_used
+    assert_equal expected, @account.bytes_used
+  end
+
+  test "processes large entry queues across multiple batches" do
+    blobs = 5.times.map { |i| create_blob("batch" * 100, filename: "b#{i}.txt") }
+
+    blobs.each_with_index do |blob, index|
+      card = @board.cards.create!(title: "Card #{index}", creator: users(:david), status: :published)
+      card.image.attach(blob)
+    end
+
+    clear_enqueued_jobs
+    assert_equal 5, Storage::Entry.where(board_id: @board.id).count
+
+    stub_const(Storage::Board, :BATCH_SIZE, 2) do
+      @board.materialize_storage
+    end
+
+    assert_equal 0, Storage::Entry.where(board_id: @board.id).count
+    assert_equal blobs.sum(&:byte_size), @board.bytes_used
+    assert_equal blobs.sum(&:byte_size), @account.bytes_used
+  end
+
+  test "reconcile_storage and account import restore exact board and account totals" do
+    img_blob = create_blob("img" * 400)
+    desc_blob = create_blob("desc" * 600)
+
+    perform_enqueued_jobs do
+      @card.image.attach(img_blob)
+      @board.update!(public_description: "<p>#{embed_html(desc_blob)}</p>")
+    end
+
+    expected_board_bytes = img_blob.byte_size + desc_blob.byte_size
+    assert_equal expected_board_bytes, @board.bytes_used
+    assert_equal expected_board_bytes, @account.bytes_used
+
+    # Corrupt totals and reconcile
+    Storage::Total.where(account_id: @account.id).update_all(bytes_used: 999_999)
+    @account.reconcile_storage
+
+    assert_equal expected_board_bytes, @board.bytes_used
+    assert_equal expected_board_bytes, @account.bytes_used
+
+    # Export and import round-trip
+    exporter = users(:david)
+    identity = exporter.identity
+    export = Account::Export.create!(account: @account, user: exporter)
+    export.build
+
+    export_tempfile = Tempfile.new([ "export", ".zip" ])
+    export.file.open { |f| FileUtils.cp(f.path, export_tempfile.path) }
+
+    board_id = @board.id
+    ActiveStorage::Blob.where(account: @account).delete_all
+    @account.destroy!
+
+    target_account = Account.create_with_owner(account: { name: "Imported" }, owner: { identity: identity, name: exporter.name })
+    import = Account::Import.create!(identity: identity, account: target_account)
+    Current.set(account: target_account) do
+      import.file.attach(io: File.open(export_tempfile.path), filename: "export.zip", content_type: "application/zip")
+    end
+
+    import.check
+    import.process
+
+    imported_board = target_account.boards.find(board_id)
+    assert_equal expected_board_bytes, imported_board.bytes_used
+    assert_equal expected_board_bytes, target_account.bytes_used
+  ensure
+    export_tempfile&.close
+    export_tempfile&.unlink
+  end
+
+  test "updating card board, image, and description simultaneously keeps board and account totals exact" do
+    old_img = create_blob("1" * 1_000)
+    old_desc = create_blob("2" * 2_000)
+    new_img = create_blob("3" * 3_500)
+    new_desc = create_blob("4" * 4_500)
+
+    perform_enqueued_jobs do
+      @card.update!(image: old_img, description: "<p>#{embed_html(old_desc)}</p>")
+    end
+    assert_equal 3_000, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 3_000, @account.bytes_used
+
+    perform_enqueued_jobs do
+      @card.update!(board: @other_board, image: new_img, description: "<p>#{embed_html(new_desc)}</p>")
+    end
+    assert_equal 0, @board.bytes_used
+    assert_equal 8_000, @other_board.bytes_used
+    assert_equal 8_000, @account.bytes_used
+  end
+
+  private
+    def create_blob(content, filename: "file.txt", content_type: "text/plain")
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(content),
+        filename: filename,
+        content_type: content_type
+      )
+    end
+
+    def embed_html(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+
+    def stub_const(mod, const_name, value)
+      original = mod.const_get(const_name)
+      mod.send(:remove_const, const_name)
+      mod.const_set(const_name, value)
+      yield
+    ensure
+      mod.send(:remove_const, const_name)
+      mod.const_set(const_name, original)
+    end
+end
