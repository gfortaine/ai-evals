diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
index f85a27a..7bdded5 100644
--- a/config/initializers/active_storage.rb
+++ b/config/initializers/active_storage.rb
@@ -56,3 +56,44 @@ Rails.application.config.to_prepare do
   ActiveStorage::BaseController.include ActiveStorageControllerExtensions
   ActiveStorage::DirectUploadsController.include ActiveStorageDirectUploadsControllerExtensions
 end
+
+module ActiveStorageAttachmentStorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :record_storage_addition
+    after_destroy :record_storage_removal, if: :storage_row_deleted?
+  end
+
+  def delete
+    if persisted?
+      rows_deleted = self.class._delete_record(_query_constraints_hash)
+      record_storage_removal if rows_deleted > 0
+    end
+    @destroyed = true
+    freeze
+  end
+
+  private
+    def destroy_row
+      super.tap do |rows_deleted|
+        @storage_row_deleted = rows_deleted > 0
+      end
+    end
+
+    def storage_row_deleted?
+      @storage_row_deleted
+    end
+
+    def record_storage_addition
+      Storage.record_attachment_delta(self, +1)
+    end
+
+    def record_storage_removal
+      Storage.record_attachment_delta(self, -1)
+    end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  include ActiveStorageAttachmentStorageTracking
+end
