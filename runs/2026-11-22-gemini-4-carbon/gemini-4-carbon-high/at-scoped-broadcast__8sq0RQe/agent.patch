diff --git a/test/controllers/pages_controller_test.rb b/test/controllers/pages_controller_test.rb
index 0b0ccec..cafcf67 100644
--- a/test/controllers/pages_controller_test.rb
+++ b/test/controllers/pages_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class PagesControllerTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -79,8 +81,85 @@ class PagesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "With even more interesting words.", updated_page.body.content
   end
 
+  test "update broadcasts being edited indicator to current editors" do
+    get edit_leafable_path(leaves(:welcome_page))
+    assert_response :ok
+    kevin_stream = being_edited_stream_from_response
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { page: { body: "Edited by David." } }
+    end
+    assert_response :no_content
+
+    assert_broadcasts kevin_stream, 1
+    assert_includes broadcasts(kevin_stream).first, "David"
+  end
+
+  test "update does not broadcast being edited indicator to removed collaborator" do
+    get edit_leafable_path(leaves(:welcome_page))
+    assert_response :ok
+    kevin_stream = being_edited_stream_from_response
+
+    sign_in :jason
+    get edit_leafable_path(leaves(:welcome_page))
+    assert_response :ok
+    jason_stream = being_edited_stream_from_response
+
+    books(:handbook).update!(everyone_access: false)
+    books(:handbook).update_access(editors: [ users(:david).id, users(:jason).id ], readers: [])
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { page: { body: "Edited after removal." } }
+    end
+    assert_response :no_content
+
+    assert_no_broadcasts kevin_stream
+    assert_broadcasts jason_stream, 1
+    assert_includes broadcasts(jason_stream).first, "David"
+  end
+
+  test "update does not broadcast being edited indicator to collaborator downgraded to reader" do
+    get edit_leafable_path(leaves(:welcome_page))
+    assert_response :ok
+    kevin_stream = being_edited_stream_from_response
+
+    books(:handbook).update_access(editors: [ users(:david).id, users(:jason).id ], readers: [ users(:kevin).id ])
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { page: { body: "Edited after downgrade." } }
+    end
+    assert_response :no_content
+
+    assert_no_broadcasts kevin_stream
+  end
+
+  test "update does not broadcast being edited indicator to deactivated user" do
+    get edit_leafable_path(leaves(:welcome_page))
+    assert_response :ok
+    kevin_stream = being_edited_stream_from_response
+
+    users(:kevin).deactivate
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { page: { body: "Edited after deactivation." } }
+    end
+    assert_response :no_content
+
+    assert_no_broadcasts kevin_stream
+  end
+
   private
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
     end
+
+    def being_edited_stream_from_response
+      source = css_select("turbo-cable-stream-source").first
+      assert_not_nil source
+      Turbo::StreamsChannel.verified_stream_name(source["signed-stream-name"])
+    end
 end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..d0f2049 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,28 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors includes active editors and accessible administrators" do
+    assert_equal [ users(:david), users(:jason), users(:kevin) ].sort_by(&:id), books(:handbook).editors.order(:id).to_a
+    assert_equal [ users(:david), users(:jason) ].sort_by(&:id), books(:manual).editors.order(:id).to_a
+  end
+
+  test "editors excludes removed, downgraded, and deactivated collaborators" do
+    books(:handbook).access_for(user: users(:kevin)).reader!
+    assert_not_includes books(:handbook).editors, users(:kevin)
+
+    books(:handbook).access_for(user: users(:kevin)).editor!
+    users(:kevin).deactivate
+    assert_not_includes books(:handbook).editors, users(:kevin)
+  end
+
+  test "editors on published book includes active administrators without explicit access but excludes readers" do
+    books(:manual).accesses.where(user: users(:jason)).delete_all
+    assert_not_includes books(:manual).editors, users(:jason)
+
+    books(:manual).update!(published: true)
+    assert_includes books(:manual).editors, users(:jason)
+    assert_not_includes books(:manual).editors, users(:jz)
+    assert_not_includes books(:manual).editors, users(:kevin)
+  end
 end
