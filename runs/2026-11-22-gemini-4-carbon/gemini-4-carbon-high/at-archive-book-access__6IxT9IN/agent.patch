diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..0ba7391 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,60 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy removes the book and archives current accesses" do
+    book = books(:handbook)
+    book_id = book.id
+
+    assert_empty AccessArchive.all
+
+    assert_difference -> { Book.count }, -1 do
+      assert_difference -> { AccessArchive.count }, 4 do
+        delete book_path(book)
+      end
+    end
+
+    assert_redirected_to root_path
+    assert_not Book.exists?(book_id)
+    assert_empty Access.where(book_id: book_id)
+
+    archived = AccessArchive.where(book_id: book_id).index_by(&:user_id)
+    assert_equal "editor", archived[users(:david).id].level
+    assert_equal "editor", archived[users(:jason).id].level
+    assert_equal "reader", archived[users(:jz).id].level
+    assert_equal "editor", archived[users(:kevin).id].level
+  end
+
+  test "destroy writes nothing before deletion and excludes revoked accesses" do
+    book = books(:handbook)
+    book_id = book.id
+
+    put book_path(book), params: {
+      book: { title: "Handbook", everyone_access: false },
+      editor_ids: [ users(:david).id ],
+      reader_ids: [ users(:jason).id ]
+    }
+
+    assert_empty AccessArchive.all
+
+    delete book_path(book)
+    assert_redirected_to root_path
+
+    archived = AccessArchive.where(book_id: book_id).index_by(&:user_id)
+    assert_equal [ users(:david).id, users(:jason).id, users(:kevin).id ].sort, archived.keys.sort
+    assert_equal "editor", archived[users(:david).id].level
+    assert_equal "reader", archived[users(:jason).id].level
+    assert_equal "editor", archived[users(:kevin).id].level
+    assert_nil archived[users(:jz).id]
+  end
+
+  test "destroy requires editor or administrator access" do
+    books(:handbook).access_for(user: users(:kevin)).update!(level: :reader)
+
+    assert_no_difference [ -> { Book.count }, -> { AccessArchive.count } ] do
+      delete book_path(books(:handbook))
+    end
+
+    assert_response :forbidden
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..9120c24 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,55 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroying a book archives its current accesses and removes the book and grants" do
+    book = books(:handbook)
+    book_id = book.id
+
+    assert_empty AccessArchive.all
+
+    assert_difference -> { AccessArchive.count }, 4 do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book_id)
+    assert_empty Access.where(book_id: book_id)
+
+    archived = AccessArchive.where(book_id: book_id).index_by(&:user_id)
+    assert_equal 4, archived.size
+
+    assert_equal [ "Handbook", "David", "editor" ], [ archived[users(:david).id].book_title, archived[users(:david).id].user_name, archived[users(:david).id].level ]
+    assert_equal [ "Handbook", "Jason", "editor" ], [ archived[users(:jason).id].book_title, archived[users(:jason).id].user_name, archived[users(:jason).id].level ]
+    assert_equal [ "Handbook", "JZ", "reader" ], [ archived[users(:jz).id].book_title, archived[users(:jz).id].user_name, archived[users(:jz).id].level ]
+    assert_equal [ "Handbook", "Kevin", "editor" ], [ archived[users(:kevin).id].book_title, archived[users(:kevin).id].user_name, archived[users(:kevin).id].level ]
+  end
+
+  test "destroying a book omits revoked users and records updated access levels" do
+    book = books(:handbook)
+    book.update!(everyone_access: false)
+    book.accesses.load
+    book.update_access(editors: [ users(:david).id ], readers: [ users(:kevin).id ])
+
+    assert_empty AccessArchive.all
+
+    book.destroy!
+
+    archived = AccessArchive.where(book_id: book.id).index_by(&:user_id)
+    assert_equal [ users(:david).id, users(:kevin).id ].sort, archived.keys.sort
+    assert_equal "editor", archived[users(:david).id].level
+    assert_equal "reader", archived[users(:kevin).id].level
+  end
+
+  test "destroying a book with no accesses writes no archive rows" do
+    unshared_book = Book.create!(title: "Unshared")
+    books(:manual).accesses.delete_all
+
+    assert_no_difference -> { AccessArchive.count } do
+      unshared_book.destroy!
+      books(:manual).destroy!
+    end
+
+    assert_not Book.exists?(unshared_book.id)
+    assert_not Book.exists?(books(:manual).id)
+  end
 end
