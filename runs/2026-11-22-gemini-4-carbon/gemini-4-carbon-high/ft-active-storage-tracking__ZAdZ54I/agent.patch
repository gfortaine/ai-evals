diff --git a/test/integration/storage_tracking_test.rb b/test/integration/storage_tracking_test.rb
new file mode 100644
index 0000000..2e022dc
--- /dev/null
+++ b/test/integration/storage_tracking_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class StorageTrackingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+  end
+
+  test "tracks storage across board, card, and comment controller actions" do
+    board_blob = upload_blob("board-desc" * 80, filename: "board.txt", content_type: "text/plain")
+    card_blob = upload_blob("card-desc" * 90, filename: "card.txt", content_type: "text/plain")
+    comment_blob = upload_blob("comment-body" * 110, filename: "comment.txt", content_type: "text/plain")
+    uploaded_image = fixture_file_upload("moon.jpg", "image/jpeg")
+    moon_size = file_fixture("moon.jpg").size
+
+    # Update board public description with embedded file
+    patch board_path(@board), params: {
+      board: { public_description: "<p>Welcome</p>#{embed_html(board_blob)}" }
+    }
+    perform_enqueued_jobs only: Storage::MaterializeJob
+    assert_equal board_blob.byte_size, @board.bytes_used
+    assert_equal board_blob.byte_size, @account.bytes_used
+
+    # Update card with image and embedded file in description
+    patch card_path(@card), as: :turbo_stream, params: {
+      card: {
+        image: uploaded_image,
+        description: "<p>Details</p>#{embed_html(card_blob)}"
+      }
+    }
+    assert_response :success
+    perform_enqueued_jobs only: Storage::MaterializeJob
+    assert_equal board_blob.byte_size + moon_size + card_blob.byte_size, @board.bytes_used
+
+    # Create comment with embedded file
+    post card_comments_path(@card), params: {
+      comment: { body: "<p>Reply</p>#{embed_html(comment_blob)}" }
+    }, as: :json
+    assert_response :created
+    comment = @card.comments.order(:created_at).last
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    card_total = moon_size + card_blob.byte_size + comment_blob.byte_size
+    assert_equal board_blob.byte_size + card_total, @board.bytes_used
+    assert_equal board_blob.byte_size + card_total, @account.bytes_used
+
+    # Move card to another board via controller
+    users(:david).accesses.find_or_create_by!(board: @other_board)
+    patch card_board_path(@card), params: { board_id: @other_board.id }
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal board_blob.byte_size, @board.bytes_used
+    assert_equal card_total, @other_board.bytes_used
+    assert_equal board_blob.byte_size + card_total, @account.bytes_used
+
+    # Delete comment via controller
+    delete card_comment_path(@card.reload, comment), as: :json
+    assert_response :no_content
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal moon_size + card_blob.byte_size, @other_board.bytes_used
+    assert_equal board_blob.byte_size + moon_size + card_blob.byte_size, @account.bytes_used
+
+    # Delete card via controller
+    delete card_path(@card), as: :json
+    assert_response :no_content
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 0, @other_board.bytes_used
+    assert_equal board_blob.byte_size, @board.bytes_used
+    assert_equal board_blob.byte_size, @account.bytes_used
+
+    # Delete board via controller
+    delete board_path(@board), as: :json
+    assert_response :no_content
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 0, @account.bytes_used
+  end
+
+  private
+    def upload_blob(content, filename:, content_type:)
+      Current.with_account(@account) do
+        ActiveStorage::Blob.create_and_upload!(
+          io: StringIO.new(content),
+          filename: filename,
+          content_type: content_type
+        )
+      end
+    end
+
+    def embed_html(blob)
+      Current.with_account(@account) do
+        ActionText::Attachment.from_attachable(blob).to_html
+      end
+    end
+end
diff --git a/test/jobs/storage/materialize_job_test.rb b/test/jobs/storage/materialize_job_test.rb
new file mode 100644
index 0000000..694ceab
--- /dev/null
+++ b/test/jobs/storage/materialize_job_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Storage::MaterializeJobTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "coalesces multiple attachment changes in a single transaction into one job" do
+    blob_1 = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("a" * 100), filename: "1.txt", content_type: "text/plain")
+    blob_2 = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("b" * 200), filename: "2.txt", content_type: "text/plain")
+    blob_3 = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("c" * 300), filename: "3.txt", content_type: "text/plain")
+
+    assert_enqueued_jobs 1, only: Storage::MaterializeJob do
+      ApplicationRecord.transaction do
+        @card.update!(description: [ blob_1, blob_2, blob_3 ].map { ActionText::Attachment.from_attachable(it).to_html }.join)
+        cards(:layout).image.attach(io: StringIO.new("d" * 400), filename: "4.png", content_type: "image/png")
+      end
+    end
+
+    assert_equal 4, @account.storage_entries.count
+
+    perform_enqueued_jobs
+
+    assert_equal 0, @account.storage_entries.count
+    assert_equal 1000, @board.bytes_used
+    assert_equal 1000, @account.bytes_used
+  end
+
+  test "processes entries across multiple batches and checkpoints between batches" do
+    stub_const(Account::Storable, :MATERIALIZE_BATCH_SIZE, 2) do
+      5.times do |i|
+        Storage::Entry.create!(
+          account: @account,
+          board: @board,
+          delta: (i + 1) * 100,
+          operation: "attach",
+          created_at: Time.current
+        )
+      end
+
+      checkpoints = 0
+      @account.materialize_storage_now(checkpoint: -> { checkpoints += 1 })
+
+      assert_equal 2, checkpoints
+      assert_equal 0, @account.storage_entries.count
+      assert_equal 1500, @board.bytes_used
+      assert_equal 1500, @account.bytes_used
+    end
+  end
+
+  test "running job when no entries are pending is a safe no-op" do
+    @card.image.attach(io: StringIO.new("x" * 250), filename: "x.png", content_type: "image/png")
+    perform_enqueued_jobs
+
+    assert_equal 250, @account.bytes_used
+
+    # Running a duplicate job after entries were already drained does not double count
+    Storage::MaterializeJob.perform_now(@account)
+
+    assert_equal 250, @board.bytes_used
+    assert_equal 250, @account.bytes_used
+  end
+
+  test "discards cleanly if account was destroyed before job runs" do
+    temp_account = Account.create!(name: "Ephemeral")
+    job = Current.with_account(temp_account) { Storage::MaterializeJob.new(temp_account) }
+    serialized = job.serialize
+    temp_account.destroy!
+
+    assert_nothing_raised do
+      ActiveJob::Base.execute(serialized)
+    end
+  end
+
+  private
+    def stub_const(mod, const_name, new_value)
+      old_value = mod.const_get(const_name)
+      mod.send(:remove_const, const_name)
+      mod.const_set(const_name, new_value)
+      yield
+    ensure
+      mod.send(:remove_const, const_name)
+      mod.const_set(const_name, old_value)
+    end
+end
