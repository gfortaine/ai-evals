+module Comment::Storable
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :track_storage_card_transfer, if: :will_save_change_to_card_id?
+  end
+
+  def calculate_bytes_used
+    rich_text_ids = ActionText::RichText
+      .where(record_type: "Comment", record_id: id, name: "body")
+      .select(:id)
+
+    ActiveStorage::Attachment
+      .joins(:blob)
+      .where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds")
+      .sum("active_storage_blobs.byte_size")
+  end
+
+  private
+    def track_storage_card_transfer
+      old_account_id, old_board_id = Card.where(id: card_id_was).pick(:account_id, :board_id)
+      new_account_id, new_board_id = if association(:card).loaded? && card
+        [ card.account_id, card.board_id ]
+      else
+        Card.where(id: card_id).pick(:account_id, :board_id)
+      end
+
+      return if old_board_id == new_board_id || old_board_id.nil? || new_board_id.nil?
+
+      bytes = calculate_bytes_used
+      return if bytes.zero?
+
+      Storage::Entry.record(
+        account_id: old_account_id,
+        board_id: old_board_id,
+        record_type: "Comment",
+        record_id: id,
+        delta: -bytes,
+        operation: "transfer_out"
+      )
+
+      Storage::Entry.record(
+        account_id: new_account_id,
+        board_id: new_board_id,
+        record_type: "Comment",
+        record_id: id,
+        delta: bytes,
+        operation: "transfer_in"
+      )
+    end
+end
diff --git a/app/models/storage.rb b/app/models/storage.rb
new file mode 100644
index 0000000..d0e2e3f
--- /dev/null
+++ b/app/models/storage.rb
@@ -0,0 +1,44 @@
+module Storage
+  class << self
+    def table_name_prefix
+      "storage_"
+    end
+
+    def destroying_account(account_id, &block)
+      with_suppressed_id(:storage_destroying_account_ids, account_id, &block)
+    end
+
+    def destroying_account?(account_id)
+      suppressed_id?(:storage_destroying_account_ids, account_id)
+    end
+
+    def destroying_board(board_id, &block)
+      with_suppressed_id(:storage_destroying_board_ids, board_id, &block)
+    end
+
+    def destroying_board?(board_id)
+      suppressed_id?(:storage_destroying_board_ids, board_id)
+    end
+
+    def destroying_card(card_id, &block)
+      with_suppressed_id(:storage_destroying_card_ids, card_id, &block)
+    end
+
+    def destroying_card?(card_id)
+      suppressed_id?(:storage_destroying_card_ids, card_id)
+    end
+
+    private
+      def with_suppressed_id(key, id)
+        ids = ActiveSupport::IsolatedExecutionState[key] ||= Set.new
+        added = ids.add?(id)
+        yield
+      ensure
+        ids.delete(id) if added
+      end
+
+      def suppressed_id?(key, id)
+        id.present? && ActiveSupport::IsolatedExecutionState[key]&.include?(id) || false
+      end
+  end
+end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..cc64cd9
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,56 @@
+class Storage::Entry < ApplicationRecord
+  PENDING_MATERIALIZATIONS = ObjectSpace::WeakKeyMap.new
+  PENDING_MATERIALIZATIONS_MUTEX = Mutex.new
+
+  belongs_to :account
+  belongs_to :board, optional: true
+
+  class << self
+    def record(account_id:, board_id:, delta:, operation:, record_type: nil, record_id: nil, blob_id: nil)
+      return if delta.zero? || account_id.blank?
+
+      create!(
+        account_id: account_id,
+        board_id: board_id,
+        record_type: record_type,
+        record_id: record_id,
+        blob_id: blob_id,
+        delta: delta,
+        operation: operation,
+        created_at: Time.current
+      )
+
+      enqueue_materialization_for(account_id)
+    end
+
+    private
+      def enqueue_materialization_for(account_id)
+        transaction = connection.current_transaction
+
+        if transaction.open? && transaction.joinable?
+          if register_pending_materialization?(transaction, account_id)
+            transaction.after_commit do
+              find_account(account_id)&.materialize_storage_later
+            end
+          end
+        else
+          find_account(account_id)&.materialize_storage_later
+        end
+      end
+
+      def register_pending_materialization?(transaction, account_id)
+        PENDING_MATERIALIZATIONS_MUTEX.synchronize do
+          pending = PENDING_MATERIALIZATIONS[transaction] ||= Set.new
+          !pending.add?(account_id).nil?
+        end
+      end
+
+      def find_account(account_id)
+        if Current.account&.id == account_id
+          Current.account
+        else
+          Account.find_by(id: account_id)
+        end
+      end
+  end
+end
