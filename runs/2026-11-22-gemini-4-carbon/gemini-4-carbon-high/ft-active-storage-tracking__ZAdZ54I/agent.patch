+class Storage::MaterializeJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account)
+    step :materialize do |step|
+      account.materialize_storage_now(checkpoint: -> { step.checkpoint! })
+    end
+  end
+end
