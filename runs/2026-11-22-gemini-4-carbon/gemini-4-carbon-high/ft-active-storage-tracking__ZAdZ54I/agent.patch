+  @board.update!(public_description: embed_html(b1))
+  @card.image.attach(io: StringIO.new(img), filename: "i.png", content_type: "image/png")
+  @card.update!(description: embed_html(b2))
+  temp_comment = @card.comments.create!(body: embed_html(b1))
