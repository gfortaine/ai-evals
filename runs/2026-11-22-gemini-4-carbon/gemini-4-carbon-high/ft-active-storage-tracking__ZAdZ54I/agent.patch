new file mode 100644
index 0000000..83eea0f
--- /dev/null
+++ b/app/models/board/storable.rb
@@ -0,0 +1,84 @@
+module Board::Storable
+  extend ActiveSupport::Concern
+
+  included do
+    include Storage::Totaled
+
+    around_destroy :track_storage_board_destruction, prepend: true
+  end
+
+  def calculate_bytes_used
+    board_description_bytes + card_images_bytes + card_descriptions_bytes + comments_bytes
+  end
+
+  private
+    def track_storage_board_destruction
+      if Storage.destroying_account?(account_id)
+        yield
+      elsif Board.where(id: id).lock.exists?
+        bytes = calculate_bytes_used
+
+        Storage.destroying_board(id) do
+          yield
+        end
+
+        if destroyed?
+          Storage::Total.where(owner_type: "Board", owner_id: id).delete_all
+
+          if bytes > 0
+            Storage::Entry.record(
+              account_id: account_id,
+              board_id: id,
+              record_type: "Board",
+              record_id: id,
+              delta: -bytes,
+              operation: "destroy_board"
+            )
+          end
+        end
+      else
+        Storage.destroying_board(id) do
+          yield
+        end
+      end
+    end
+
+    def board_description_bytes
+      rich_text_ids = ActionText::RichText
+        .where(record_type: "Board", record_id: id, name: "public_description")
+        .select(:id)
+
+      sum_embed_bytes(rich_text_ids)
+    end
+
+    def card_images_bytes
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "Card", record_id: cards.select(:id), name: "image")
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_descriptions_bytes
+      rich_text_ids = ActionText::RichText
+        .where(record_type: "Card", record_id: cards.select(:id), name: "description")
+        .select(:id)
+
+      sum_embed_bytes(rich_text_ids)
+    end
+
+    def comments_bytes
+      comment_ids = Comment.where(card_id: cards.select(:id)).select(:id)
+      rich_text_ids = ActionText::RichText
+        .where(record_type: "Comment", record_id: comment_ids, name: "body")
+        .select(:id)
+
+      sum_embed_bytes(rich_text_ids)
+    end
+
+    def sum_embed_bytes(rich_text_ids)
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds")
+        .sum("active_storage_blobs.byte_size")
+    end
+end
