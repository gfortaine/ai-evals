+  private
+    def upload_blob(content, filename:, content_type:)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(content),
+        filename: filename,
+        content_type: content_type
+      )
+    end
+
+    def embed_html(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+
+    def assert_queries_count(expected)
+      queries = []
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, payload|
+        queries << payload[:sql] unless payload[:name].in?(%w[ SCHEMA TRANSACTION ])
+      end
+      yield
+      assert_equal expected, queries.size, "Expected #{expected} queries, got #{queries.size}: #{queries.inspect}"
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+    end
+end
