+class Storage::ReconcileJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account)
+    step :reconcile do |step|
+      account.reconcile_storage_now(
+        start: step.cursor,
+        advance: ->(board_id) { step.advance! from: board_id }
+      )
+    end
+  end
+end
