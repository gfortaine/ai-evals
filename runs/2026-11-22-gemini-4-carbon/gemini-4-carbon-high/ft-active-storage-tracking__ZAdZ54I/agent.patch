+module Card::Storable
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :track_storage_board_transfer, if: :will_save_change_to_board_id?
+    around_destroy :track_storage_card_destruction, prepend: true
+  end
+
+  def calculate_bytes_used
+    card_image_bytes + card_description_bytes + comments_bytes
+  end
+
+  private
+    def track_storage_board_transfer
+      old_board_id = board_id_was
+      new_board_id = board_id
+      return if old_board_id == new_board_id || old_board_id.nil? || new_board_id.nil?
+
+      bytes = calculate_bytes_used
+      return if bytes.zero?
+
+      old_account_id = account_id_was || Board.where(id: old_board_id).pick(:account_id)
+      new_account_id = (association(:board).loaded? && board&.account_id) || Board.where(id: new_board_id).pick(:account_id)
+
+      Storage::Entry.record(
+        account_id: old_account_id,
+        board_id: old_board_id,
+        record_type: "Card",
+        record_id: id,
+        delta: -bytes,
+        operation: "transfer_out"
+      )
+
+      Storage::Entry.record(
+        account_id: new_account_id,
+        board_id: new_board_id,
+        record_type: "Card",
+        record_id: id,
+        delta: bytes,
+        operation: "transfer_in"
+      )
+    end
+
+    def track_storage_card_destruction
+      if Storage.destroying_account?(account_id) || Storage.destroying_board?(board_id)
+        yield
+      elsif Card.where(id: id).lock.exists?
+        bytes = calculate_bytes_used
+
+        Storage.destroying_card(id) do
+          yield
+        end
+
+        if destroyed? && bytes > 0
+          Storage::Entry.record(
+            account_id: account_id,
+            board_id: board_id,
+            record_type: "Card",
+            record_id: id,
+            delta: -bytes,
+            operation: "destroy_card"
+          )
+        end
+      else
+        Storage.destroying_card(id) do
+          yield
+        end
+      end
+    end
+
+    def card_image_bytes
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "Card", record_id: id, name: "image")
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_description_bytes
+      rich_text_ids = ActionText::RichText
+        .where(record_type: "Card", record_id: id, name: "description")
+        .select(:id)
+
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds")
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def comments_bytes
+      rich_text_ids = ActionText::RichText
+        .where(record_type: "Comment", record_id: comments.select(:id), name: "body")
+        .select(:id)
+
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds")
+        .sum("active_storage_blobs.byte_size")
+    end
+end
