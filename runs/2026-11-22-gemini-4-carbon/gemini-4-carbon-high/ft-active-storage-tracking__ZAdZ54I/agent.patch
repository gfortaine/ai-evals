+require "test_helper"
+
+class Storage::ReconcileJobTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+  end
+
+  test "reconciles bulk-inserted attachments across boards when callbacks were bypassed" do
+    blob_1 = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("bulk-1" * 100), filename: "b1.bin", content_type: "application/octet-stream")
+    blob_2 = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("bulk-2" * 150), filename: "b2.bin", content_type: "application/octet-stream")
+
+    other_card = @other_board.cards.create!(title: "Other", creator: users(:kevin), status: :published, last_active_at: Time.current)
+
+    # Simulate bulk import bypassing ActiveRecord callbacks
+    ActiveStorage::Attachment.insert_all!([
+      {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: @account.id,
+        name: "image",
+        record_type: "Card",
+        record_id: cards(:logo).id,
+        blob_id: blob_1.id,
+        created_at: Time.current
+      },
+      {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: @account.id,
+        name: "image",
+        record_type: "Card",
+        record_id: other_card.id,
+        blob_id: blob_2.id,
+        created_at: Time.current
+      }
+    ])
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    Storage::ReconcileJob.perform_now(@account)
+
+    assert_equal blob_1.byte_size, @board.bytes_used
+    assert_equal blob_2.byte_size, @other_board.bytes_used
+    assert_equal blob_1.byte_size + blob_2.byte_size, @account.bytes_used
+  end
+end
