@@ -0,0 +1,39 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <header>
+    <h1 class="txt-x-large font-weight-black margin-block-end-half"><%= @page_title %></h1>
+    <% if email_address_pending_authentication.present? %>
+      <p class="margin-none txt-medium">Then enter the six-character verification code we sent to <strong><%= email_address_pending_authentication %></strong>:</p>
+    <% else %>
+      <p class="margin-none txt-medium">Enter the six-character verification code from your email:</p>
+    <% end %>
+  </header>
+
+  <%= form_with url: session_magic_link_path, method: :post, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <label class="for-screen-reader" for="code">Verification code</label>
+    <%= form.text_field :code,
+          required: true,
+          autofocus: true,
+          autocomplete: "one-time-code",
+          autocorrect: "off",
+          autocapitalize: "characters",
+          spellcheck: "false",
+          placeholder: "••••••",
+          class: "input center txt-uppercase",
+          data: { "1p-ignore": true } %>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-subtle txt-small margin-none-block-end">
+    The code in your email will work for <%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>. Check your spam folder if you don’t see it.
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
