diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..8b32335
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,74 @@
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image (use your-user/fizzy on external registries).
+image: fizzy
+
+# Deploy to your server. Replace with your server's hostname or IP address.
+servers:
+  web:
+    - fizzy.example.com
+
+# Enable SSL auto certification via Let's Encrypt.
+# Your DNS A/AAAA record for this host must point to your server before running `kamal setup`.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Where you keep your container images.
+# Uses a local Docker registry by default so no external registry account is needed.
+registry:
+  server: localhost:5555
+
+  # Alternatives: hub.docker.com / registry.digitalocean.com / ghcr.io / ...
+  # server: ghcr.io
+  # username: your-user
+  # password:
+  #   - KAMAL_REGISTRY_PASSWORD
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    # Hostname used for links in emails, notifications, webhooks, and exports.
+    APP_HOST: fizzy.example.com
+
+    # Outbound email (SMTP)
+    MAILER_FROM_ADDRESS: Fizzy <noreply@fizzy.example.com>
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+
+    # Run the Solid Queue supervisor inside Puma so background jobs run in the same container.
+    SOLID_QUEUE_IN_PUMA: true
+    JOB_CONCURRENCY: 1
+
+    # Set number of Puma web workers (defaults to available CPU cores).
+    # WEB_CONCURRENCY: 2
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# Persist SQLite databases and uploaded Active Storage files across deploys.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests.
+asset_path: /rails/public/assets
+
+# Configure the image builder.
+builder:
+  arch: amd64 # Change to arm64 if your server uses ARM
+
+# Use a different ssh user than root
+# ssh:
+#   user: app
+
+# Aliases are triggered with "kamal <alias>" or "bin/kamal <alias>".
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
