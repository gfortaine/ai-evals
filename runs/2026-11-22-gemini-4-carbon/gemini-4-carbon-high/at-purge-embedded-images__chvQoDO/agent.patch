+
+    perform_enqueued_jobs do
+      leaf.reload.page.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Blob.service.exist?(blob.key)
+  end
+
+  test "destroying a leaf purges markdown uploads from superseded revisions" do
+    leaf = leaves(:welcome_page)
+    leaf.page.body.tap(&:save!).uploads.attach fixture_file_upload("reading.webp", "image/webp")
+    attachment = leaf.page.body.uploads.attachments.last
+    blob = attachment.blob
+
+    leaf.edit leafable_params: { body: "With ![image](#{attachment.slug_path})" }
+    revision_with_image = leaf.reload.page
+
+    travel 15.minutes
+    leaf.edit leafable_params: { body: "Image removed from current version" }
+    leaf.trashed!
+
+    perform_enqueued_jobs do
+      leaf.destroy!
+    end
+
+    assert_not Page.exists?(revision_with_image.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Blob.service.exist?(blob.key)
+  end
 end
