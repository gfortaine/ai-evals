+
+  test "editing a page carries over markdown uploads so destroying the page purges them" do
+    leaf = leaves(:welcome_page)
+    leaf.page.body.tap(&:save!).uploads.attach fixture_file_upload("reading.webp", "image/webp")
+    attachment = leaf.page.body.uploads.attachments.last
+    blob = attachment.blob
+
