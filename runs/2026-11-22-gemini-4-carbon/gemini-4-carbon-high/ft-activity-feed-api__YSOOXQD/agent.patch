diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..18f6edd
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,304 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns accessible activities newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    expected_ids = users(:kevin).activities.pluck(:id)
+    assert_equal expected_ids, @response.parsed_body.pluck("id")
+  end
+
+  test "index via Accept application/json header" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  test "index rejects HTML requests" do
+    get activities_path
+    assert_response :not_acceptable
+
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+  end
+
+  test "authenticates with bearer token for JSON requests only" do
+    sign_out
+    bearer = { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    get activities_path, env: bearer
+    assert_response :unauthorized
+
+    get activities_path(format: :json), env: bearer
+    assert_response :success
+  end
+
+  test "card event includes expected attributes and representations" do
+    event = events(:logo_assignment_jz)
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    item = @response.parsed_body.find { |record| record["id"] == event.id }
+    assert_not_nil item
+
+    expected_keys = %w[ id action created_at description particulars url eventable_type eventable board creator ]
+    assert_equal expected_keys.sort, item.keys.sort
+
+    assert_equal event.id, item["id"]
+    assert_equal "card_assigned", item["action"]
+    assert_equal event.created_at.utc.iso8601(3), item["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, item["description"]
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, item["particulars"])
+    assert_equal card_url(event.eventable), item["url"]
+    assert_equal "Card", item["eventable_type"]
+
+    assert_equal event.eventable.id, item.dig("eventable", "id")
+    assert_equal event.eventable.number, item.dig("eventable", "number")
+    assert_equal event.eventable.title, item.dig("eventable", "title")
+    assert_equal card_url(event.eventable), item.dig("eventable", "url")
+
+    assert_equal event.board.id, item.dig("board", "id")
+    assert_equal event.board.name, item.dig("board", "name")
+    assert_equal board_url(event.board), item.dig("board", "url")
+
+    assert_equal event.creator.id, item.dig("creator", "id")
+    assert_equal event.creator.name, item.dig("creator", "name")
+    assert_equal user_url(event.creator), item.dig("creator", "url")
+  end
+
+  test "comment event url jumps to comment on card and uses comment representation" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    item = @response.parsed_body.find { |record| record["id"] == event.id }
+    assert_not_nil item
+
+    expected_url = card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment))
+    assert_equal expected_url, item["url"]
+    assert_equal "Comment", item["eventable_type"]
+    assert_equal({}, item["particulars"])
+    assert_equal event.description_for(users(:kevin)).to_plain_text, item["description"]
+
+    assert_equal comment.id, item.dig("eventable", "id")
+    assert_equal comment.body.to_plain_text, item.dig("eventable", "body", "plain_text")
+    assert_equal card_comment_url(comment.card, comment), item.dig("eventable", "url")
+  end
+
+  test "description reflects the current user perspective" do
+    event = events(:logo_assignment_david)
+
+    get activities_path(format: :json)
+    kevin_item = @response.parsed_body.find { |record| record["id"] == event.id }
+    assert_equal event.description_for(users(:kevin)).to_plain_text, kevin_item["description"]
+
+    logout_and_sign_in_as :david
+    get activities_path(format: :json)
+    david_item = @response.parsed_body.find { |record| record["id"] == event.id }
+    assert_equal event.description_for(users(:david)).to_plain_text, david_item["description"]
+    assert_not_equal kevin_item["description"], david_item["description"]
+  end
+
+  test "mirrors HTML timeline actions except omitting card_collection_changed and including card_title_changed" do
+    expected_actions = (User::DayTimeline.const_get(:TIMELINEABLE_ACTIONS) - %w[ card_collection_changed ] + %w[ card_title_changed ]).sort
+    assert_equal expected_actions, Event::ACTIVITY_ACTIONS.sort
+
+    card = cards(:logo)
+    Current.set(session: sessions(:kevin)) do
+      card.update!(title: "Renamed logo card")
+    end
+    title_event = card.events.where(action: "card_title_changed").last
+    assert_not_nil title_event
+
+    deprecated_event = boards(:writebook).events.create!(
+      action: "card_collection_changed",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: { particulars: { new_collection: "Old Collection" } }
+    )
+    resumed_event = boards(:writebook).events.create!(
+      action: "card_resumed",
+      creator: users(:kevin),
+      eventable: card
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    returned_ids = @response.parsed_body.pluck("id")
+    assert_includes returned_ids, title_event.id
+    assert_not_includes returned_ids, deprecated_event.id
+    assert_not_includes returned_ids, resumed_event.id
+  end
+
+  test "exposes particulars for domain actions and empty strings for missing values" do
+    card = cards(:logo)
+    other_board = nil
+
+    Current.set(session: sessions(:kevin)) do
+      other_board = Board.create!(name: "Second Board", creator: users(:kevin), all_access: true)
+      card.update!(title: "Brand new title")
+      card.triage_into(columns(:writebook_in_progress))
+      card.toggle_assignment(users(:jz))
+      card.move_to(other_board)
+    end
+
+    missing_board_event = other_board.events.create!(
+      action: "card_board_changed",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: {}
+    )
+    missing_title_event = other_board.events.create!(
+      action: "card_title_changed",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: {}
+    )
+    missing_column_event = other_board.events.create!(
+      action: "card_triaged",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: {}
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    by_id = @response.parsed_body.index_by { |item| item["id"] }
+
+    title_event = card.events.where(action: "card_title_changed").where.not(id: missing_title_event.id).last
+    assert_equal({ "old_title" => "The logo isn't big enough", "new_title" => "Brand new title" }, by_id[title_event.id]["particulars"])
+
+    triage_event = card.events.where(action: "card_triaged").where.not(id: missing_column_event.id).last
+    assert_equal({ "column" => columns(:writebook_in_progress).name }, by_id[triage_event.id]["particulars"])
+
+    unassign_event = card.events.where(action: "card_unassigned").last
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, by_id[unassign_event.id]["particulars"])
+
+    board_event = card.events.where(action: "card_board_changed").where.not(id: missing_board_event.id).last
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Second Board" }, by_id[board_event.id]["particulars"])
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, by_id[missing_board_event.id]["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, by_id[missing_title_event.id]["particulars"])
+    assert_equal({ "column" => "" }, by_id[missing_column_event.id]["particulars"])
+
+    fresh_card = Current.set(session: sessions(:kevin)) { other_board.cards.create!(title: "Fresh", status: "published", creator: users(:kevin)) }
+    published_event = fresh_card.events.find_by!(action: "card_published")
+    get activities_path(format: :json)
+    by_id = @response.parsed_body.index_by { |item| item["id"] }
+    assert_equal({}, by_id[published_event.id]["particulars"])
+
+    sent_back_event = events(:buy_domain_sent_back_to_triage)
+    assert_equal({}, by_id[sent_back_event.id]["particulars"])
+  end
+
+  test "returns only activity the current user can access" do
+    private_card = Current.set(session: sessions(:kevin)) do
+      boards(:private).cards.create!(title: "Top secret", status: "published", creator: users(:kevin))
+    end
+    private_event = private_card.events.find_by!(action: "card_published")
+
+    get activities_path(format: :json)
+    assert_includes @response.parsed_body.pluck("id"), private_event.id
+
+    logout_and_sign_in_as :david
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+  end
+
+  test "filters by creator_ids" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+
+    assert @response.parsed_body.any?
+    @response.parsed_body.each do |item|
+      assert_equal users(:kevin).id, item.dig("creator", "id")
+    end
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id, users(:david).id ] }
+    assert_response :success
+    assert_equal [ users(:david).id, users(:kevin).id ].sort, @response.parsed_body.map { |item| item.dig("creator", "id") }.uniq.sort
+  end
+
+  test "filters by board_ids and respects board access" do
+    private_card = Current.set(session: sessions(:kevin)) do
+      boards(:private).cards.create!(title: "Private work", status: "published", creator: users(:kevin))
+    end
+    private_event = private_card.events.find_by!(action: "card_published")
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+
+    # Combine board_ids and creator_ids
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id ], creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+    assert @response.parsed_body.any?
+    @response.parsed_body.each do |item|
+      assert_equal boards(:writebook).id, item.dig("board", "id")
+      assert_equal users(:kevin).id, item.dig("creator", "id")
+    end
+
+    # Filtering by an inaccessible board returns empty array rather than leaking or falling back to all boards
+    logout_and_sign_in_as :david
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+
+    # Mixing accessible and inaccessible boards only returns events from accessible boards
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id, boards(:writebook).id ] }
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+  end
+
+  test "paginates newest activity first" do
+    card = cards(:logo)
+    base_time = 1.minute.ago
+
+    50.times do |index|
+      boards(:writebook).events.create!(
+        action: "card_closed",
+        creator: users(:kevin),
+        eventable: card,
+        created_at: base_time + index.seconds
+      )
+    end
+
+    expected_ids = users(:kevin).activities.pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_operator page_count, :>, 1
+    assert_equal expected_ids, actual_ids
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
