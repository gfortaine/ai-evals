diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..c3c9fbf 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,29 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def details
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(particular_value("assignee_ids")).compact }
+    when "card_board_changed"
+      { old_board: particular_value("old_board").to_s, new_board: particular_value("new_board").to_s }
+    when "card_title_changed"
+      { old_title: particular_value("old_title").to_s, new_title: particular_value("new_title").to_s }
+    when "card_triaged"
+      { column: particular_value("column").to_s }
+    else
+      {}
+    end
+  end
+
+  private
+    def particular_value(key)
+      nested = particulars&.dig("particulars")
+      if nested.is_a?(Hash) && nested.key?(key)
+        nested[key]
+      elsif particulars.is_a?(Hash)
+        particulars[key]
+      end
+    end
 end
diff --git a/app/models/user/timelined.rb b/app/models/user/timelined.rb
index 2cd808a..92d35cb 100644
--- a/app/models/user/timelined.rb
+++ b/app/models/user/timelined.rb
@@ -8,4 +8,12 @@ module User::Timelined
   def timeline_for(day, filter:)
     User::DayTimeline.new(self, day, filter)
   end
+
+  def activities(creator_ids: nil, board_ids: nil)
+    accessible_boards = board_ids.present? ? boards.where(id: board_ids) : boards
+
+    events = Event.activity.where(board: accessible_boards).reverse_chronologically
+    events = events.where(creator_id: creator_ids) if creator_ids.present?
+    events
+  end
 end
