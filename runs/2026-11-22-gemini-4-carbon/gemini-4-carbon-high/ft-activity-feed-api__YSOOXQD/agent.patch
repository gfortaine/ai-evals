+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "assignment details expose assignee_ids" do
+    event = events(:logo_assignment_jz)
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, event.details)
+
+    unassigned = Event.new(action: "card_unassigned", particulars: { assignee_ids: [ users(:kevin).id ] })
+    assert_equal({ assignee_ids: [ users(:kevin).id ] }, unassigned.details)
+
+    empty_assignment = Event.new(action: "card_assigned", particulars: {})
+    assert_equal({ assignee_ids: [] }, empty_assignment.details)
+  end
+
+  test "board change details expose old_board and new_board with empty string fallback" do
+    event = Event.new(
+      action: "card_board_changed",
+      particulars: { particulars: { old_board: "Writebook", new_board: "Fizzy" } }
+    )
+    assert_equal({ old_board: "Writebook", new_board: "Fizzy" }, event.details)
+
+    missing = Event.new(action: "card_board_changed", particulars: {})
+    assert_equal({ old_board: "", new_board: "" }, missing.details)
+  end
+
+  test "title change details expose old_title and new_title with empty string fallback" do
+    event = Event.new(
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Draft", new_title: "Final" } }
+    )
+    assert_equal({ old_title: "Draft", new_title: "Final" }, event.details)
+
+    missing = Event.new(action: "card_title_changed", particulars: {})
+    assert_equal({ old_title: "", new_title: "" }, missing.details)
+  end
+
+  test "triage details expose column with empty string fallback" do
+    event = Event.new(
+      action: "card_triaged",
+      particulars: { particulars: { column: "In Progress" } }
+    )
+    assert_equal({ column: "In Progress" }, event.details)
+
+    missing = Event.new(action: "card_triaged", particulars: {})
+    assert_equal({ column: "" }, missing.details)
+  end
+
+  test "other actions return empty details hash" do
+    %w[
+      card_published
+      card_closed
+      card_reopened
+      card_postponed
+      card_auto_postponed
+      card_sent_back_to_triage
+      comment_created
+    ].each do |action|
+      event = Event.new(action: action, particulars: { unexpected: "value" })
+      assert_equal({}, event.details, "Expected empty details for #{action}")
+    end
+  end
+end
