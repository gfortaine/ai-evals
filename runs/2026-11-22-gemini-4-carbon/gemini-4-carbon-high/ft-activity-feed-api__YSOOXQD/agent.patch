@@ -0,0 +1,26 @@
+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from activities
+      end
+    end
+  end
+
+  private
+    def activities
+      Current.user.activities(creator_ids: creator_ids_param, board_ids: board_ids_param).preloaded_for_api
+    end
+
+    def creator_ids_param
+      ids_param(:creator_ids)
+    end
+
+    def board_ids_param
+      ids_param(:board_ids)
+    end
+
+    def ids_param(key)
+      Array.wrap(params[key]).select { it.is_a?(String) }.compact_blank
+    end
+end
