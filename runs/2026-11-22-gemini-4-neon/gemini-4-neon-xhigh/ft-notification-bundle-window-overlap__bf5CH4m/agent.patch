 class User::Settings < ApplicationRecord
+  BUNDLING_PERIODS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
   belongs_to :account, default: -> { user.account }
   belongs_to :user
 
+  enum :bundle_email_frequency, %w[ never every_few_hours daily weekly ].index_by(&:itself),
+    default: :every_few_hours, prefix: :bundle_email, validate: true
+
+  after_update_commit :handle_bundle_email_frequency_change, if: :saved_change_to_bundle_email_frequency?
+
   def timezone
     if timezone_name.present?
       ActiveSupport::TimeZone[timezone_name] || default_timezone
@@ -10,8 +21,30 @@ class User::Settings < ApplicationRecord
     end
   end
 
+  def bundling_emails?
+    !bundle_email_never?
+  end
+
+  def bundling_period
+    BUNDLING_PERIODS[bundle_email_frequency]
+  end
+
   private
     def default_timezone
       ActiveSupport::TimeZone["UTC"]
     end
+
+    def handle_bundle_email_frequency_change
+      transaction do
+        User.where(id: user_id).lock.pick(:id)
+
+        if bundle_email_never?
+          user.notification_bundles.pending.destroy_all
+        else
+          user.notification_bundles.pending.where(Notification::Bundle.arel_table[:ends_at].gt(Time.current)).find_each do |bundle|
+            bundle.update(ends_at: bundle.starts_at + bundling_period)
+          end
+        end
+      end
+    end
 end
