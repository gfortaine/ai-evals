new file mode 100644
index 0000000..34c7780
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,30 @@
+class NotificationMailer < ApplicationMailer
+  helper NotificationsHelper, ExcerptHelper
+
+  def bundle(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.notifications.unread.preloaded.ordered
+
+    return if @notifications.empty? || @user.identity.blank?
+
+    @grouped_notifications = @notifications.group_by { |notification| notification.card.board }
+
+    Current.with_account(@account) do
+      mail(
+        to: @user.identity.email_address,
+        subject: subject_for(@notifications)
+      )
+    end
+  end
+
+  private
+    def subject_for(notifications)
+      if notifications.one?
+        "#{@account.name}: #{notifications.first.payload.title}"
+      else
+        "#{@account.name}: #{notifications.size} new notifications"
+      end
+    end
+end
