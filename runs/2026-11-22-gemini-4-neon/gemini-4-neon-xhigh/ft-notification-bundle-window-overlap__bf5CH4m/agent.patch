+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @settings = @user.settings
+  end
+
+  test "bundle_email_frequency defaults to every_few_hours" do
+    user = User.create!(account: accounts("37s"), name: "New User")
+    assert_equal "every_few_hours", user.settings.bundle_email_frequency
+    assert user.settings.bundle_email_every_few_hours?
+    assert user.settings.bundling_emails?
+    assert_equal 4.hours, user.settings.bundling_period
+  end
+
+  test "supports all four bundle_email_frequency options" do
+    @settings.update!(bundle_email_frequency: :never)
+    assert_equal "never", @settings.bundle_email_frequency
+    assert_not @settings.bundling_emails?
+    assert_nil @settings.bundling_period
+
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+    assert_equal "every_few_hours", @settings.bundle_email_frequency
+    assert @settings.bundling_emails?
+    assert_equal 4.hours, @settings.bundling_period
+
+    @settings.update!(bundle_email_frequency: :daily)
+    assert_equal "daily", @settings.bundle_email_frequency
+    assert @settings.bundling_emails?
+    assert_equal 1.day, @settings.bundling_period
+
+    @settings.update!(bundle_email_frequency: :weekly)
+    assert_equal "weekly", @settings.bundle_email_frequency
+    assert @settings.bundling_emails?
+    assert_equal 1.week, @settings.bundling_period
+  end
+
+  test "rejects invalid bundle_email_frequency values" do
+    @settings.bundle_email_frequency = "hourly"
+    assert_not @settings.valid?
+    assert_includes @settings.errors[:bundle_email_frequency], "is not included in the list"
+  end
+
+  test "switching frequency to never destroys pending bundles and nullifies notification bundle_id" do
+    travel_to Time.utc(2025, 1, 15, 10, 0, 0) do
+      notification = Notification.create!(user: @user, source: events(:layout_published), creator: users(:kevin))
+      bundle = notification.bundle
+      assert_not_nil bundle
+      assert bundle.pending?
+
+      @settings.update!(bundle_email_frequency: :never)
+
+      assert_not Notification::Bundle.exists?(bundle.id)
+      assert_nil notification.reload.bundle_id
+    end
+  end
+
+  test "switching frequency to never preserves already delivered bundles" do
+    travel_to Time.utc(2025, 1, 15, 10, 0, 0) do
+      delivered_bundle = @user.notification_bundles.create!(
+        starts_at: 8.hours.ago,
+        ends_at: 4.hours.ago,
+        status: :delivered
+      )
+      pending_bundle = @user.notification_bundles.create!(
+        starts_at: Time.current,
+        ends_at: 4.hours.from_now,
+        status: :pending
+      )
+
+      @settings.update!(bundle_email_frequency: :never)
+
+      assert Notification::Bundle.exists?(delivered_bundle.id)
+      assert_not Notification::Bundle.exists?(pending_bundle.id)
+    end
+  end
+
+  test "changing frequency adjusts ends_at of open pending bundle without touching ended or delivered bundles" do
+    travel_to Time.utc(2025, 1, 15, 10, 0, 0) do
+      delivered_bundle = @user.notification_bundles.create!(
+        starts_at: 10.hours.ago,
+        ends_at: 6.hours.ago,
+        status: :delivered
+      )
+      ended_pending_bundle = @user.notification_bundles.create!(
+        starts_at: 5.hours.ago,
+        ends_at: 1.hour.ago,
+        status: :pending
+      )
+      open_bundle = @user.notification_bundles.create!(
+        starts_at: Time.current,
+        ends_at: 4.hours.from_now,
+        status: :pending
+      )
+
+      @settings.update!(bundle_email_frequency: :daily)
+
+      assert_equal Time.utc(2025, 1, 15, 4, 0, 0), delivered_bundle.reload.ends_at
+      assert_equal Time.utc(2025, 1, 15, 9, 0, 0), ended_pending_bundle.reload.ends_at
+      assert_equal Time.utc(2025, 1, 16, 10, 0, 0), open_bundle.reload.ends_at
+    end
+  end
+end
