+require "rails_helper"
+require "exifr/jpeg"
+
+RSpec.describe ProfileImageAttachable do
+  let(:jpg_file) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+  let(:png_file) { fixture_file_upload("800x600.png", "image/png") }
+  let(:webp_file) { fixture_file_upload("800x600.webp", "image/webp") }
+  let(:pdf_file) { fixture_file_upload("800x600.pdf", "application/pdf") }
+  let(:svg_file) { fixture_file_upload("300x100.svg", "image/svg+xml") }
+  let(:gps_jpg_file) { fixture_file_upload("image_gps_data.jpg", "image/jpeg") }
+  let(:high_frame_gif) { fixture_file_upload("high_frame_count.gif", "image/gif") }
+
+  describe "new profile pictures go to Active Storage" do
+    it "stores new User profile pictures in Active Storage without writing to legacy column" do
+      user = create(:user, profile_image: jpg_file)
+
+      expect(user.profile_image).to be_attached
+      expect(user.read_attribute(:profile_image)).to be_nil
+      expect(user.profile_image.blob.content_type).to eq("image/jpeg")
+      expect(user.profile_image.blob.key).to end_with(".jpg")
+      expect(user.profile_image.blob.metadata).to include(
+        "identified" => true, "analyzed" => true, "width" => 800, "height" => 600,
+      )
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+      expect(user.profile_image_90).to eq(user.profile_image_url)
+      expect(user.as_json(only: %i[id profile_image])["profile_image"]).to eq("url" => user.profile_image_url)
+    end
+
+    it "stores new Organization profile pictures in Active Storage without writing to legacy column" do
+      org = create(:organization, profile_image: png_file)
+
+      expect(org.profile_image).to be_attached
+      expect(org.read_attribute(:profile_image)).to be_nil
+      expect(org.profile_image.blob.content_type).to eq("image/png")
+      expect(org.profile_image.blob.key).to end_with(".png")
+      expect(org.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+      expect(org.as_json(only: %i[id profile_image])["profile_image"]).to eq("url" => org.profile_image_url)
+    end
+
+    it "supports WebP profile images" do
+      user = create(:user, profile_image: webp_file)
+
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image.blob.content_type).to eq("image/webp")
+      expect(user.profile_image.blob.key).to end_with(".webp")
+    end
+
+    it "strips EXIF and GPS metadata from uploaded JPEGs" do
+      expect(EXIFR::JPEG.new(gps_jpg_file.path).exif?).to be(true)
+      expect(EXIFR::JPEG.new(gps_jpg_file.path).gps.present?).to be(true)
+
+      user = create(:user, profile_image: gps_jpg_file)
+      exif = EXIFR::JPEG.new(StringIO.new(user.profile_image.download))
+
+      expect(exif.exif?).to be(false)
+      expect(exif.gps.present?).to be(false)
+    end
+
+    it "attaches an existing ActiveStorage::Blob by signed_id" do
+      source_user = create(:user, profile_image: png_file)
+      signed_id = source_user.profile_image.blob.signed_id
+
+      target_user = create(:user, profile_image: signed_id)
+      expect(target_user.profile_image).to be_attached
+      expect(target_user.profile_image.blob).to eq(source_user.profile_image.blob)
+    end
+
+    it "ignores non-signed-id strings without raising InvalidSignature" do
+      user = build(:user, profile_image: "https://example.com/not-a-signed-id.png")
+      expect(user).to be_valid
+      expect(user.profile_image).not_to be_attached
+    end
+  end
+
+  describe "security and format validations" do
+    it "rejects PDF files" do
+      user = build(:user, profile_image: pdf_file)
+      expect(user).not_to be_valid
+      expect(user.errors[:profile_image]).to include(I18n.t("errors.messages.unsupported_image_type"))
+      expect(user.profile_image).not_to be_attached
+    end
+
+    it "rejects SVG files" do
+      user = build(:user, profile_image: svg_file)
+      expect(user).not_to be_valid
+      expect(user.errors[:profile_image]).to include(I18n.t("errors.messages.unsupported_image_type"))
+    end
+
+    it "rejects files exceeding ProfileImageUploader::MAX_FILE_SIZE" do
+      stub_const("ProfileImageUploader::MAX_FILE_SIZE", 2.megabytes)
+      large_file = fixture_file_upload("large_profile_img.jpg", "image/jpeg")
+
+      user = build(:user, profile_image: large_file)
+      expect(user).not_to be_valid
+      expect(user.errors.full_messages.to_sentence).to eq("Profile image File size should be less than 2 MB")
+    end
+
+    it "rejects image bombs exceeding 4096x4096 pixels" do
+      fast_image_double = instance_double(FastImage, type: :jpeg, size: [5000, 5000])
+      allow(FastImage).to receive(:new).and_return(fast_image_double)
+
+      user = build(:user, profile_image: jpg_file)
+      expect(user).not_to be_valid
+      expect(user.errors[:profile_image]).to include(
+        I18n.t("errors.messages.pixel_dimensions_error", x_size: 4096, y_size: 4096),
+      )
+    end
+
+    it "rejects animated GIFs with too many frames" do
+      stub_const("BaseUploader::FRAME_MAX", 20)
+      user = build(:user, profile_image: high_frame_gif)
+      expect(user).not_to be_valid
+      expect(user.errors[:profile_image]).to include(
+        I18n.t("uploaders.base_uploader.too_many_frames", frame_max: BaseUploader::FRAME_MAX),
+      )
+    end
+
+    it "preserves an existing valid Active Storage profile image when an invalid upload is attempted" do
+      user = create(:user, profile_image: jpg_file)
+      original_url = user.profile_image_url
+
+      user.profile_image = pdf_file
+      expect(user).not_to be_valid
+      expect(user.profile_image_url).to eq(original_url)
+      expect(user.reload.profile_image_url).to eq(original_url)
+    end
+  end
+
+  describe "existing CarrierWave profile pictures stay working (dual-read)" do
+    let(:legacy_filename) { "af153cd6-9994-4a68-83f4-8ddf3e13f0bf.jpg" }
+
+    it "serves legacy CarrierWave URLs for Users with no Active Storage attachment" do
+      user = create(:user, profile_image: nil)
+      user.update_column(:profile_image, legacy_filename)
+      user.reload
+
+      expected_url = "/uploads/user/profile_image/#{user.id}/#{legacy_filename}"
+      expect(user.profile_image).not_to be_attached
+      expect(user.profile_image_url).to eq(expected_url)
+      expect(user.profile_image_90).to eq(expected_url)
+      expect(user.as_json(only: %i[id profile_image])["profile_image"]).to eq("url" => expected_url)
+    end
+
+    it "serves legacy CarrierWave URLs for Organizations and allows updating other fields" do
+      org = create(:organization)
+      org.profile_image.purge
+      org.update_column(:profile_image, legacy_filename)
+      org.reload
+
+      expected_url = "/uploads/organization/profile_image/#{org.id}/#{legacy_filename}"
+      expect(org.profile_image).not_to be_attached
+      expect(org.profile_image_url).to eq(expected_url)
+      expect(org.profile_image_90).to eq(expected_url)
+
+      expect(org.update(summary: "Updated legacy org summary")).to be(true)
+      expect(org.reload.profile_image_url).to eq(expected_url)
+    end
+
+    it "switches a legacy CarrierWave User to Active Storage on new upload while preserving legacy column" do
+      user = create(:user, profile_image: nil)
+      user.update_column(:profile_image, legacy_filename)
+      user.reload
+      create(:article, user: user, published: true)
+      allow(Images::SocialImageWorker).to receive(:perform_async)
+
+      legacy_url = user.profile_image_url
+      expect(legacy_url).to eq("/uploads/user/profile_image/#{user.id}/#{legacy_filename}")
+
+      sidekiq_assert_enqueued_with(job: Users::BustProfileImageCacheWorker, args: [user.id]) do
+        user.update!(profile_image: png_file)
+      end
+
+      user.reload
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+      expect(user.profile_image_url).not_to eq(legacy_url)
+      # Legacy column remains intact for rolling-deploy / rollback safety
+      expect(user.read_attribute(:profile_image)).to eq(legacy_filename)
+      expect(Images::SocialImageWorker).to have_received(:perform_async).with(user.id, "User")
+    end
+
+    it "switches a legacy CarrierWave Organization to Active Storage and updates cached articles" do
+      org = create(:organization)
+      org.profile_image.purge
+      org.update_column(:profile_image, legacy_filename)
+      org.reload
+
+      article = create(:article, organization: org, published: true)
+      expect(article.cached_organization.profile_image_url).to eq(
+        "/uploads/organization/profile_image/#{org.id}/#{legacy_filename}",
+      )
+
+      allow(Images::SocialImageWorker).to receive(:perform_async)
+
+      sidekiq_perform_enqueued_jobs(only: Organizations::SaveArticleWorker) do
+        org.update!(profile_image: jpg_file)
+      end
+
+      org.reload
+      expect(org.profile_image).to be_attached
+      expect(org.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+      expect(org.read_attribute(:profile_image)).to eq(legacy_filename)
+      expect(article.reload.cached_organization.profile_image_url).to eq(org.profile_image_url)
+      expect(Images::SocialImageWorker).to have_received(:perform_async).with(org.id, "Organization")
+    end
+  end
+
+  describe "#remote_profile_image_url=" do
+    let(:remote_url) { "https://cdn.example.test/avatar.png" }
+
+    it "downloads a valid remote image and stores it in Active Storage" do
+      stub_request(:get, remote_url).to_return(
+        status: 200,
+        body: Rails.root.join("spec/fixtures/files/800x600.png").binread,
+        headers: { "Content-Type" => "image/png" },
+      )
+
+      user = create(:user, profile_image: nil)
+      user.remote_profile_image_url = remote_url
+      user.save!
+
+      expect(user.remote_profile_image_url).to eq(remote_url)
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image.blob.content_type).to eq("image/png")
+      expect(user.read_attribute(:profile_image)).to be_nil
+    end
+
+    it "records a validation error when remote download fails" do
+      stub_request(:get, remote_url).to_return(status: 404, body: "Not Found")
+
+      user = build(:user, profile_image: nil)
+      user.remote_profile_image_url = remote_url
+
+      expect(user).not_to be_valid
+      expect(user.errors[:profile_image]).to be_present
+      expect(user.profile_image).not_to be_attached
+    end
+
+    it "blocks private IP addresses via SSRF protection when enabled" do
+      allow(Images::RemoteProfileImageDownloader).to receive(:skip_ssrf_protection?).and_return(false)
+
+      user = build(:user, profile_image: nil)
+      user.remote_profile_image_url = "http://127.0.0.1/secret.png"
+
+      expect(user).not_to be_valid
+      expect(user.errors[:profile_image]).to be_present
+      expect(user.profile_image).not_to be_attached
+    end
+
+    it "attaches fallback File returned by Images::SafeRemoteProfileImageUrl" do
+      fallback_file = Images::SafeRemoteProfileImageUrl.call(nil)
+      user = create(:user, profile_image: nil)
+      user.remote_profile_image_url = fallback_file
+      user.save!
+
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image.blob.content_type).to eq("image/png")
+    end
+  end
+
+  describe "Moderator::BanishUser" do
+    it "purges an Active Storage profile image and falls back to DEFAULT_PROFILE_IMAGE" do
+      admin = create(:user, :super_admin)
+      user = create(:user, profile_image: jpg_file)
+      expect(user.profile_image).to be_attached
+
+      sidekiq_perform_enqueued_jobs do
+        Moderator::BanishUser.call(admin: admin, user: user)
+      end
+
+      user.reload
+      expect(user.profile_image).not_to be_attached
+      expect(user.profile_image_url).to eq(Moderator::BanishUser::DEFAULT_PROFILE_IMAGE)
+    end
+  end
+
+  describe "production URL generation" do
+    it "returns absolute HTTPS proxy URL in production when service is non-public (Disk)" do
+      user = create(:user, profile_image: jpg_file)
+      allow(Rails).to receive(:env).and_return(ActiveSupport::StringInquirer.new("production"))
+      allow(Settings::General).to receive(:app_domain).and_return("forem.example.com")
+      allow(ApplicationConfig).to receive(:[]).and_call_original
+      allow(ApplicationConfig).to receive(:[]).with("APP_PROTOCOL").and_return("https://")
+
+      expect(user.profile_image_url).to start_with("https://forem.example.com/rails/active_storage/blobs/proxy/")
+    end
+
+    it "returns permanent public URL directly when blob service is public (e.g., S3/FogAws)" do
+      user = create(:user, profile_image: png_file)
+      blob = user.profile_image.blob
+      public_service = instance_double(ActiveStorage::Service::FogAwsService, public?: true)
+      allow(public_service).to receive(:url).and_return("https://forem-uploads.s3.amazonaws.com/#{blob.key}")
+      allow(blob).to receive(:service).and_return(public_service)
+
+      expect(user.profile_image_url).to eq("https://forem-uploads.s3.amazonaws.com/#{blob.key}")
+    end
+  end
+
+  describe "other uploads stay on CarrierWave" do
+    it "keeps Tag#profile_image on CarrierWave" do
+      tag = build(:tag)
+      expect(tag.profile_image).to be_a(ProfileImageUploader)
+    end
+
+    it "keeps Organization#cover_image on CarrierWave" do
+      org = build(:organization)
+      expect(org.cover_image).to be_a(CoverImageUploader)
+    end
+
+    it "keeps Badge#badge_image on CarrierWave" do
+      badge = build(:badge)
+      expect(badge.badge_image).to be_a(BadgeUploader)
+    end
+
+    it "keeps Tweet#profile_image on CarrierWave" do
+      tweet = Tweet.new
+      expect(tweet.profile_image).to be_a(ProfileImageUploader)
+    end
+  end
+end
