diff --git a/spec/requests/profile_image_active_storage_spec.rb b/spec/requests/profile_image_active_storage_spec.rb
new file mode 100644
index 0000000..65fae6e
--- /dev/null
+++ b/spec/requests/profile_image_active_storage_spec.rb
@@ -0,0 +1,228 @@
+require "rails_helper"
+
+RSpec.describe "Profile image Active Storage serving and dual-read compatibility" do
+  let(:jpg_path) { Rails.root.join("spec/fixtures/files/800x600.jpg") }
+  let(:png_path) { Rails.root.join("spec/fixtures/files/800x600.png") }
+  let(:jpg_upload) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+  let(:png_upload) { fixture_file_upload("800x600.png", "image/png") }
+
+  describe "serving Active Storage blobs over HTTP" do
+    it "serves a User's Active Storage profile image directly with 200 OK and cache headers" do
+      user = create(:user, profile_image: jpg_upload)
+
+      get user.profile_image_url
+
+      expect(response).to have_http_status(:ok)
+      expect(response.media_type).to eq("image/jpeg")
+      expect(response.headers["Cache-Control"]).to include("public", "immutable")
+      expect(response.headers["Set-Cookie"]).to be_nil
+      expect(response.body.b).to eq(File.binread(jpg_path))
+    end
+
+    it "serves an Organization's Active Storage profile image directly with 200 OK" do
+      org = create(:organization, profile_image: png_upload)
+
+      get org.profile_image_url
+
+      expect(response).to have_http_status(:ok)
+      expect(response.media_type).to eq("image/png")
+      expect(response.body.b).to eq(File.binread(png_path))
+    end
+  end
+
+  describe "uploading via web and API endpoints" do
+    it "uploads a new User profile picture via PUT /users/:id.json and returns json.user.profile_image.url" do
+      user = create(:user)
+      sign_in user
+
+      put "/users/#{user.id}",
+          params: { user: { profile_image: png_upload } },
+          headers: { "Accept" => "application/json" }
+
+      expect(response).to have_http_status(:ok)
+      body = response.parsed_body
+      expect(body["success"]).to be(true)
+      expect(body.dig("user", "profile_image", "url")).to eq(user.reload.profile_image_url)
+      expect(user.profile_image).to be_attached
+
+      get body.dig("user", "profile_image", "url")
+      expect(response).to have_http_status(:ok)
+      expect(response.body.b).to eq(File.binread(png_path))
+    end
+
+    it "uploads a new Organization profile picture via PATCH /settings/organization/:slug" do
+      user = create(:user, :org_admin)
+      org = user.organizations.first
+      sign_in user
+
+      patch organization_settings_path(org.slug),
+            params: { organization: { profile_image: jpg_upload } }
+
+      expect(response).to redirect_to(organization_settings_path(org.slug))
+      expect(org.reload.profile_image).to be_attached
+
+      get org.profile_image_url
+      expect(response).to have_http_status(:ok)
+      expect(response.body.b).to eq(File.binread(jpg_path))
+    end
+
+    it "uploads via POST /api/organizations with a remote image URL into Active Storage" do
+      super_admin = create(:user, :super_admin)
+      api_secret = create(:api_secret, user: super_admin)
+      remote_url = "https://cdn.example.test/org-logo.png"
+      stub_request(:get, remote_url).to_return(
+        status: 200,
+        body: File.binread(png_path),
+        headers: { "Content-Type" => "image/png" },
+      )
+
+      post api_organizations_path,
+           params: {
+             organization: {
+               name: "AS API Org",
+               slug: "as-api-org",
+               summary: "Created via API",
+               url: "https://as-api-org.test",
+               profile_image: remote_url,
+               tag_line: "Tagline"
+             }
+           },
+           headers: {
+             "Accept" => "application/vnd.forem.api-v1+json",
+             "api-key" => api_secret.secret
+           }
+
+      expect(response).to have_http_status(:created)
+      org = Organization.find_by!(slug: "as-api-org")
+      expect(org.profile_image).to be_attached
+      expect(response.parsed_body["profile_image"]).to eq(org.profile_image_url)
+
+      get org.profile_image_url
+      expect(response).to have_http_status(:ok)
+    end
+  end
+
+  describe "rendering existing CarrierWave and new Active Storage profile pictures side by side" do
+    let(:legacy_user) do
+      create(:user, profile_image: nil).tap do |u|
+        u.update_column(:profile_image, "legacy-user-pic.jpg")
+        u.reload
+      end
+    end
+    let(:as_user) { create(:user, profile_image: jpg_upload) }
+
+    let(:legacy_org) do
+      create(:organization).tap do |o|
+        o.profile_image.purge
+        o.update_column(:profile_image, "legacy-org-pic.png")
+        o.reload
+      end
+    end
+    let(:as_org) { create(:organization, profile_image: png_upload) }
+
+    it "serves both legacy and Active Storage users in GET /api/profile_images/:username" do
+      headers = { "Accept" => "application/vnd.forem.api-v1+json" }
+
+      get api_profile_image_path(legacy_user.username), headers: headers
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(
+        "/uploads/user/profile_image/#{legacy_user.id}/legacy-user-pic.jpg",
+      )
+
+      get api_profile_image_path(as_user.username), headers: headers
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(as_user.profile_image_url)
+    end
+
+    it "serves both legacy and Active Storage organizations in GET /api/organizations" do
+      legacy_org
+      as_org
+
+      get api_organizations_path, headers: { "Accept" => "application/vnd.forem.api-v1+json" }
+      expect(response).to have_http_status(:ok)
+
+      by_id = response.parsed_body.index_by { |row| row["id"] }
+      expect(by_id[legacy_org.id]["profile_image"]).to eq(
+        "url" => "/uploads/organization/profile_image/#{legacy_org.id}/legacy-org-pic.png",
+      )
+      expect(by_id[as_org.id]["profile_image"]).to eq(
+        "url" => as_org.profile_image_url,
+      )
+    end
+
+    it "renders valid image URLs in admin organization pages" do
+      admin = create(:user, :super_admin)
+      sign_in admin
+
+      get admin_organization_path(as_org.id)
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(as_org.profile_image_url)
+      expect(response.body).not_to include("ActiveStorage::Attached::One")
+
+      get admin_organization_path(legacy_org.id)
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include("/uploads/organization/profile_image/#{legacy_org.id}/legacy-org-pic.png")
+    end
+
+    it "renders valid image URLs in admin audience segment pages" do
+      admin = create(:user, :super_admin)
+      sign_in admin
+
+      segment = create(:audience_segment, type_of: "manual")
+      segment.segmented_users.create!(user: as_user)
+      segment.segmented_users.create!(user: legacy_user)
+
+      get admin_audience_segment_path(segment.id)
+      expect(response).to have_http_status(:ok)
+      expect(response.body).to include(as_user.profile_image_url)
+      expect(response.body).to include("/uploads/user/profile_image/#{legacy_user.id}/legacy-user-pic.jpg")
+      expect(response.body).not_to include("ActiveStorage::Attached::One")
+    end
+
+    it "renders valid follower avatar URLs in NotifyMailer#new_follower_email" do
+      recipient = create(:user)
+
+      as_follow = create(:follow, followable: recipient, follower: as_user)
+      as_email = NotifyMailer.with(follow: as_follow).new_follower_email
+      expect(as_email.html_part.decoded).to include(as_user.profile_image_url)
+      expect(as_email.html_part.decoded).not_to include("ActiveStorage::Attached::One")
+
+      legacy_follow = create(:follow, followable: recipient, follower: legacy_user)
+      legacy_email = NotifyMailer.with(follow: legacy_follow).new_follower_email
+      expect(legacy_email.html_part.decoded).to include(
+        "/uploads/user/profile_image/#{legacy_user.id}/legacy-user-pic.jpg",
+      )
+    end
+
+    it "returns profile_image.url in Search::Organization for both legacy and Active Storage organizations" do
+      legacy_org
+      as_org
+
+      results = Search::Organization.search_documents.index_by { |doc| doc[:id] }
+      expect(results[legacy_org.id][:profile_image]).to eq(
+        url: "/uploads/organization/profile_image/#{legacy_org.id}/legacy-org-pic.png",
+      )
+      expect(results[as_org.id][:profile_image]).to eq(
+        url: as_org.profile_image_url,
+      )
+    end
+
+    it "rejects invalid profile_image uploads during user registration instead of silently replacing them" do
+      allow(Settings::Authentication).to receive(:allow_email_password_registration).and_return(true)
+      pdf_upload = fixture_file_upload("800x600.pdf", "application/pdf")
+
+      expect do
+        post users_path, params: {
+          user: {
+            name: "Invalid Pic User",
+            username: "invalidpicuser",
+            email: "invalidpic@example.com",
+            password: "password123",
+            password_confirmation: "password123",
+            profile_image: pdf_upload
+          }
+        }
+      end.not_to change(User, :count)
+    end
+  end
+end
