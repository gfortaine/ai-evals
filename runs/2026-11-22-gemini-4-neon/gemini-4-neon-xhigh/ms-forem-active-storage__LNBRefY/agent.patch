+require "rails_helper"
+
+RSpec.describe "Profile image Active Storage serving without CarrierWave" do
+  let(:jpg_path) { Rails.root.join("spec/fixtures/files/800x600.jpg") }
+  let(:png_path) { Rails.root.join("spec/fixtures/files/800x600.png") }
+  let(:jpg_upload) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+  let(:png_upload) { fixture_file_upload("800x600.png", "image/png") }
+
+  def capture_sql_queries(&block)
+    queries = []
+    callback = lambda do |_name, _start, _finish, _id, payload|
+      next if payload[:name] == "SCHEMA" || payload[:cached]
+
+      queries << payload[:sql]
+    end
+    ActiveSupport::Notifications.subscribed(callback, "sql.active_record", &block)
+    queries
+  end
+
+  describe "serving Active Storage blobs over HTTP" do
+    it "serves a User's Active Storage profile image directly with 200 OK and cache headers" do
+      user = create(:user, profile_image: jpg_upload)
+
+      get user.profile_image_url
+
+      expect(response).to have_http_status(:ok)
+      expect(response.media_type).to eq("image/jpeg")
+      expect(response.headers["Cache-Control"]).to include("public", "immutable")
+      expect(response.headers["Set-Cookie"]).to be_nil
+      expect(response.body.b).to eq(File.binread(jpg_path))
+    end
+
+    it "serves an Organization's Active Storage profile image directly with 200 OK" do
+      org = create(:organization, profile_image: png_upload)
+
+      get org.profile_image_url
+
+      expect(response).to have_http_status(:ok)
+      expect(response.media_type).to eq("image/png")
+      expect(response.body.b).to eq(File.binread(png_path))
+    end
+  end
+
+  describe "uploading via web and API endpoints" do
+    it "uploads a new User profile picture via PUT /users/:id.json and returns json.user.profile_image.url" do
+      user = create(:user)
+      sign_in user
+
+      put "/users/#{user.id}",
+          params: { user: { profile_image: png_upload } },
+          headers: { "Accept" => "application/json" }
+
+      expect(response).to have_http_status(:ok)
+      body = response.parsed_body
+      expect(body["success"]).to be(true)
+      expect(body.dig("user", "profile_image", "url")).to eq(user.reload.profile_image_url)
+      expect(user.profile_image).to be_attached
+
+      get body.dig("user", "profile_image", "url")
+      expect(response).to have_http_status(:ok)
+      expect(response.body.b).to eq(File.binread(png_path))
+    end
+
+    it "uploads a new Organization profile picture via PATCH /settings/organization/:slug" do
+      user = create(:user, :org_admin)
+      org = user.organizations.first
+      sign_in user
+
+      patch organization_settings_path(org.slug),
+            params: { organization: { profile_image: jpg_upload } }
+
+      expect(response).to redirect_to(organization_settings_path(org.slug))
+      expect(org.reload.profile_image).to be_attached
+
+      get org.profile_image_url
+      expect(response).to have_http_status(:ok)
+      expect(response.body.b).to eq(File.binread(jpg_path))
+    end
+
+    it "uploads via POST /api/organizations with a remote image URL into Active Storage" do
+      super_admin = create(:user, :super_admin)
+      api_secret = create(:api_secret, user: super_admin)
+      remote_url = "https://cdn.example.test/org-logo.png"
+      stub_request(:get, remote_url).to_return(
+        status: 200,
+        body: File.binread(png_path),
+        headers: { "Content-Type" => "image/png" },
+      )
+
+      post api_organizations_path,
+           params: {
+             organization: {
+               name: "AS API Org",
+               slug: "as-api-org",
+               summary: "Created via API",
+               url: "https://as-api-org.test",
+               profile_image: remote_url,
+               tag_line: "Tagline"
+             }
+           },
+           headers: {
+             "Accept" => "application/vnd.forem.api-v1+json",
+             "api-key" => api_secret.secret
+           }
+
+      expect(response).to have_http_status(:created)
+      org = Organization.find_by!(slug: "as-api-org")
+      expect(org.profile_image).to be_attached
+      expect(response.parsed_body["profile_image"]).to eq(org.profile_image_url)
+
+      get org.profile_image_url
+      expect(response).to have_http_status(:ok)
+    end
+
+    it "rejects invalid profile_image uploads during user registration instead of silently replacing them" do
+      allow(Settings::Authentication).to receive(:allow_email_password_registration).and_return(true)
+      pdf_upload = fixture_file_upload("800x600.pdf", "application/pdf")
+
+      expect do
+        post users_path, params: {
+          user: {
+            name: "Invalid Pic User",
+            username: "invalidpicuser",
+            email: "invalidpic@example.com",
+            password: "password123",
+            password_confirmation: "password123",
+            profile_image: pdf_upload
+          }
+        }
+      end.not_to change(User, :count)
+    end
+  end
+
+  describe "serving Active Storage across all endpoints without touching CarrierWave or legacy columns" do
+    let(:user) { create(:user, profile_image: jpg_upload) }
+    let(:org) { create(:organization, profile_image: png_upload) }
+    let(:headers) { { "Accept" => "application/vnd.forem.api-v1+json" } }
+
+    it "never queries users.profile_image or organizations.profile_image and never invokes ProfileImageUploader",
+       :aggregate_failures do
+      article = create(:article, user: user, organization: org, published: true)
+      tag = create(:tag, name: "ruby")
+      user.add_role(:tag_moderator, tag)
+      admin = create(:user, :super_admin)
+      segment = create(:audience_segment, type_of: "manual")
+      segment.segmented_users.create!(user: user)
+      follow = create(:follow, followable: admin, follower: user)
+
+      allow(ProfileImageUploader).to receive(:new).and_call_original
+
+      queries = capture_sql_queries do
+        get api_profile_image_path(user.username), headers: headers
+        expect(response).to have_http_status(:ok)
+        expect(response.parsed_body["profile_image"]).to eq(user.profile_image_url)
+
+        get api_profile_image_path(org.slug), headers: headers
+        expect(response).to have_http_status(:ok)
+        expect(response.parsed_body["profile_image"]).to eq(org.profile_image_url)
+
+        get api_organizations_path, headers: headers
+        expect(response).to have_http_status(:ok)
+        org_row = response.parsed_body.detect { |row| row["id"] == org.id }
+        expect(org_row["profile_image"]).to eq("url" => org.profile_image_url)
+
+        get api_organization_path(org.id), headers: headers
+        expect(response).to have_http_status(:ok)
+        expect(response.parsed_body["profile_image"]).to eq(org.profile_image_url)
+
+        get api_user_path(user.id), headers: headers
+        expect(response).to have_http_status(:ok)
+        expect(response.parsed_body["profile_image"]).to eq(user.profile_image_url)
+
+        get api_article_path(article.id), headers: headers
+        expect(response).to have_http_status(:ok)
+        expect(response.parsed_body.dig("user", "profile_image")).to eq(user.profile_image_url)
+        expect(response.parsed_body.dig("organization", "profile_image")).to eq(org.profile_image_url)
+
+        get "/stories/feed"
+        expect(response).to have_http_status(:ok)
+        feed_item = response.parsed_body.detect { |item| item["id"] == article.id }
+        expect(feed_item.dig("user", "profile_image_url")).to eq(user.profile_image_url)
+        expect(feed_item.dig("organization", "profile_image_url")).to eq(org.profile_image_url)
+
+        get "/#{user.username}"
+        expect(response).to have_http_status(:ok)
+        expect(response.body).to include(user.profile_image_url)
+
+        get "/#{org.slug}"
+        expect(response).to have_http_status(:ok)
+        expect(response.body).to include(org.profile_image_url)
+
+        sign_in admin
+
+        get "/t/#{tag.name}"
+        expect(response).to have_http_status(:ok)
+
+        get admin_organization_path(org.id)
+        expect(response).to have_http_status(:ok)
+        expect(response.body).to include(org.profile_image_url)
+        expect(response.body).not_to include("ActiveStorage::Attached::One")
+
+        get admin_audience_segment_path(segment.id)
+        expect(response).to have_http_status(:ok)
+        expect(response.body).to include(user.profile_image_url)
+        expect(response.body).not_to include("ActiveStorage::Attached::One")
+
+        user_search = Search::User.search_documents.detect { |doc| doc[:id] == user.id }
+        expect(user_search.dig(:user, :profile_image_90)).to eq(user.profile_image_url)
+
+        username_search = Search::Username.search_documents(user.username)
+        expect(username_search.detect { |doc| doc[:id] == user.id }[:profile_image_90]).to eq(user.profile_image_url)
+
+        org_search = Search::Organization.search_documents.detect { |doc| doc[:id] == org.id }
+        expect(org_search[:profile_image]).to eq(url: org.profile_image_url)
+
+        Users::SuggestForSidebar.call(admin, tag.name).to_a
+
+        email = NotifyMailer.with(follow: follow).new_follower_email
+        expect(email.html_part.decoded).to include(user.profile_image_url)
+      end
+
+      expect(ProfileImageUploader).not_to have_received(:new)
+
+      legacy_column_queries = queries.grep(
+        /"(?:users|organizations)"\."profile_image"|\b(?:users|organizations)\.profile_image\b/i,
+      )
+      expect(legacy_column_queries).to be_empty
+    end
+
+    it "ignores retired CarrierWave column values and falls back to BACKUP_LINK instead of dead /uploads URLs" do
+      unattached_user = create(:user, profile_image: nil)
+      User.where(id: unattached_user.id).update_all("profile_image = 'retired-avatar.jpg'")
+
+      get api_profile_image_path(unattached_user.username), headers: headers
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["profile_image"]).to eq(Images::Profile::BACKUP_LINK)
+      expect(response.parsed_body["profile_image"]).not_to include("/uploads/user/profile_image/")
+    end
+
+    it "keeps other CarrierWave uploads (Organization#cover_image, Tag#profile_image) working" do
+      org.update!(cover_image: jpg_upload)
+      expect(org.reload.cover_image).to be_a(CoverImageUploader)
+      expect(org.cover_image.url).to include("/uploads/organization/cover_image/#{org.id}/")
+
+      tag = create(:tag, profile_image: png_upload)
+      expect(tag.reload.profile_image).to be_a(ProfileImageUploader)
+      expect(tag.profile_image.url).to include("/uploads/tag/profile_image/#{tag.id}/")
+    end
+  end
+end
