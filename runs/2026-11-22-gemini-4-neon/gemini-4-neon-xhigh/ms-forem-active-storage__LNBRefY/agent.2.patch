@@ -0,0 +1,433 @@
+require "rails_helper"
+require "active_storage/service/fog_aws_service"
+
+RSpec.describe Images::CopyProfileImages do
+  let(:jpg_path) { Rails.root.join("spec/fixtures/files/800x600.jpg") }
+  let(:png_path) { Rails.root.join("spec/fixtures/files/800x600.png") }
+  let(:gif_path) { Rails.root.join("spec/fixtures/files/high_frame_count.gif") }
