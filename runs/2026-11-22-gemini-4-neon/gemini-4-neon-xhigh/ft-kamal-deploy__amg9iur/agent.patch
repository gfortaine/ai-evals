+  if config.action_mailer.smtp_settings.blank? && (smtp_address = ENV["SMTP_ADDRESS"].presence)
+    smtp_port = (ENV["SMTP_PORT"].presence || 587).to_i
+    smtp_user_name = ENV["SMTP_USERNAME"].presence
+    smtp_password = ENV["SMTP_PASSWORD"].presence
+    smtp_tls = if ENV["SMTP_TLS"].present?
+      ENV["SMTP_TLS"] == "true"
+    else
+      smtp_port == 465
+    end
+
+    smtp_settings = {
+      address: smtp_address,
+      port: smtp_port,
+      domain: ENV["SMTP_DOMAIN"].presence || app_host&.split(":")&.first,
+      user_name: smtp_user_name,
+      password: smtp_password,
+      authentication: ENV["SMTP_AUTHENTICATION"].presence || ("plain" if smtp_user_name || smtp_password)
+    }.compact
+
+    if smtp_tls
+      smtp_settings[:tls] = true
+    else
+      smtp_settings[:enable_starttls_auto] = ENV["SMTP_ENABLE_STARTTLS_AUTO"] != "false"
+    end
+
+    config.action_mailer.smtp_settings = smtp_settings
+  end
+
