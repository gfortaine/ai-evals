+<%= turbo_frame_tag @comment, :reacting do %>
+  <div class="reaction reaction__form expanded" data-controller="morph-guard">
+    <figure class="reaction__avatar margin-none flex-item-no-shrink" style="--avatar-size: auto;">
+      <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %>
+    </figure>
+
+    <div class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--circle borderless fill-transparent" data-action="dialog#open:stop">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Choose an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel fill-white shadow" data-dialog-target="dialog" data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing turbo:submit-end->dialog#close">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <%= button_to card_comment_reactions_path(@card, @comment),
+                  params: { reaction: { content: emoji } },
+                  class: "btn btn--circle borderless fill-transparent",
+                  title: label,
+                  aria: { label: label } do %>
+              <%= emoji %>
+            <% end %>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form_with model: [ @card, @comment, @reaction ],
+          class: "flex align-center gap-half",
+          data: {
+            controller: "form",
+            action: "submit->form#preventEmptySubmit submit->form#preventComposingSubmit keydown.esc->form#cancel:stop"
+          } do |form| %>
+      <%= form.label :content, class: "reaction__form-label flex align-center" do %>
+        <span class="for-screen-reader">Reaction</span>
+        <%= form.text_field :content,
+              class: "input reaction__input txt-small",
+              maxlength: 16,
+              size: 16,
+              required: true,
+              autofocus: true,
+              autocomplete: "off",
+              placeholder: "React…",
+              data: {
+                form_target: "input",
+                action: "compositionstart->form#compositionStart compositionend->form#compositionEnd",
+                "1p-ignore": "true"
+              } %>
+      <% end %>
+
+      <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle borderless fill-transparent" do %>
+        <%= icon_tag "check-circle" %>
+        <span class="for-screen-reader">Confirm</span>
+      <% end %>
+
+      <%= link_to card_comment_reactions_path(@card, @comment),
+            class: "reaction__cancel-btn btn btn--circle borderless fill-transparent",
+            data: { form_target: "cancel" } do %>
+        <%= icon_tag "close-circle" %>
+        <span class="for-screen-reader">Cancel</span>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
