diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..9434681
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,25 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { reactable&.account }
+  belongs_to :reactable, polymorphic: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  normalizes :content, with: -> { it.strip }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  scope :ordered, -> { order(created_at: :asc, id: :asc) }
+
+  after_commit :broadcast_card_refresh, on: %i[ create destroy ]
+
+  delegate :all_emoji?, to: :content, allow_nil: true
+  delegate :card, to: :reactable
+
+  private
+    def broadcast_card_refresh
+      return if destroyed_by_association
+
+      if reactable.present? && !reactable.destroyed? && card.present? && !card.destroyed?
+        card.broadcast_refresh
+      end
+    end
+end
