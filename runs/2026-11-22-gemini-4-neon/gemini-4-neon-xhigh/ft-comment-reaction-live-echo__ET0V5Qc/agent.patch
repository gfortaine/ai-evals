diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..b0f197c
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,64 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.preload(reacter: [ :avatar_attachment, :account ])
+  end
+
+  def show
+  end
+
+  def new
+    @reaction = @comment.reactions.build
+  end
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params)
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.html { redirect_to @card }
+        format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { head :unprocessable_entity }
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to @card }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden unless @reaction.reacter == Current.user
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..4634437
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,55 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { reacterId: String }
+  static classes = [ "deleteable", "expanded", "deleting" ]
+
+  connect() {
+    this.#syncOwnership()
+  }
+
+  toggle(event) {
+    if (!this.#isOwnedByCurrentUser) return
+    if (event.target.closest("form")) return
+
+    if (event.type === "keydown") {
+      event.preventDefault()
+    }
+
+    this.element.classList.toggle(this.expandedClass)
+  }
+
+  collapse() {
+    this.element.classList.remove(this.expandedClass)
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) {
+      this.collapse()
+    }
+  }
+
+  deleting() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  preserveState(event) {
+    if (event.detail?.attributeName === "class" || event.detail?.attributeName === "tabindex") {
+      event.preventDefault()
+    }
+  }
+
+  #syncOwnership() {
+    if (this.#isOwnedByCurrentUser) {
+      this.element.classList.add(this.deleteableClass)
+      this.element.setAttribute("tabindex", "0")
+    } else {
+      this.element.classList.remove(this.deleteableClass, this.expandedClass)
+      this.element.removeAttribute("tabindex")
+    }
+  }
+
+  get #isOwnedByCurrentUser() {
+    return Boolean(this.reacterIdValue && window.Current?.user?.id === this.reacterIdValue)
+  }
+}
