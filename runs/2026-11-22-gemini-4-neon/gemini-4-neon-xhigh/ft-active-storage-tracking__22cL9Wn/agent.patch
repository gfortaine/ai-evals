diff --git a/test/integration/storage_tracking_test.rb b/test/integration/storage_tracking_test.rb
new file mode 100644
index 0000000..42d510c
--- /dev/null
+++ b/test/integration/storage_tracking_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class StorageTrackingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = @account.boards.create!(name: "Destination", creator: users(:david), all_access: true)
+    @card = cards(:logo)
+  end
+
+  test "tracks storage usage through HTTP requests for card images, embeds, moves, and deletions" do
+    image = fixture_file_upload("moon.jpg", "image/jpeg")
+    expected_image_bytes = file_fixture("moon.jpg").size
+
+    # Upload card image via CardsController#update
+    patch card_path(@card), params: { card: { image: image } }, as: :turbo_stream
+    assert_response :success
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal expected_image_bytes, @board.bytes_used
+    assert_equal expected_image_bytes, @account.bytes_used
+
+    # Embed a file in a comment via Cards::CommentsController#create
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("c" * 300),
+      filename: "comment.txt",
+      content_type: "text/plain"
+    )
+    post card_comments_path(@card), params: { comment: { body: ActionText::Attachment.from_attachable(comment_blob).to_html } }, as: :turbo_stream
+    assert_response :success
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal expected_image_bytes + 300, @board.bytes_used
+    assert_equal expected_image_bytes + 300, @account.bytes_used
+
+    # Move card to another board via Cards::BoardsController#update
+    put card_board_path(@card), params: { board_id: @other_board.id }
+    assert_response :redirect
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 0, @board.bytes_used
+    assert_equal expected_image_bytes + 300, @other_board.bytes_used
+    assert_equal expected_image_bytes + 300, @account.bytes_used
+
+    # Delete card image via Cards::ImagesController#destroy (uses purge_later)
+    delete card_image_path(@card)
+    assert_response :redirect
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 300, @other_board.bytes_used
+    assert_equal 300, @account.bytes_used
+
+    # Embed a file in board public_description via BoardsController#update
+    board_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("b" * 200),
+      filename: "board.txt",
+      content_type: "text/plain"
+    )
+    patch board_path(@other_board), params: { board: { public_description: ActionText::Attachment.from_attachable(board_blob).to_html } }
+    assert_response :redirect
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 500, @other_board.bytes_used
+    assert_equal 500, @account.bytes_used
+
+    # Destroy card via CardsController#destroy
+    delete card_path(@card)
+    assert_response :redirect
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 200, @other_board.bytes_used
+    assert_equal 200, @account.bytes_used
+
+    # Destroy board via BoardsController#destroy
+    delete board_path(@other_board)
+    assert_response :redirect
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 0, @account.bytes_used
+  end
+end
