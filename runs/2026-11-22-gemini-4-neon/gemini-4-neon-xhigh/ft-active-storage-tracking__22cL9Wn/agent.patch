diff --git a/test/models/storage/materialization_and_reconciliation_test.rb b/test/models/storage/materialization_and_reconciliation_test.rb
new file mode 100644
index 0000000..674a152
--- /dev/null
+++ b/test/models/storage/materialization_and_reconciliation_test.rb
@@ -0,0 +1,277 @@
+require "test_helper"
+
+class Storage::MaterializationAndReconciliationTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+    @user = users(:david)
+  end
+
+  test "coalesces bursts of concurrent writes into a single background job per owner" do
+    memory_cache = ActiveSupport::Cache::MemoryStore.new
+    Rails.stubs(:cache).returns(memory_cache)
+
+    assert_enqueued_jobs 2, only: Storage::MaterializeJob do
+      10.times do |i|
+        blob = create_blob(size: 100 + i)
+        @card.comments.create!(body: embed_html(blob))
+      end
+    end
+
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    expected = (0...10).sum { |i| 100 + i }
+    assert_equal expected, @board.bytes_used
+    assert_equal expected, @account.bytes_used
+    assert_empty Storage::Entry.where(account_id: @account.id)
+
+    # Subsequent write after materialization enqueues a fresh job
+    assert_enqueued_jobs 2, only: Storage::MaterializeJob do
+      blob = create_blob(size: 500)
+      @card.comments.create!(body: embed_html(blob))
+    end
+
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal expected + 500, @board.bytes_used
+    assert_equal expected + 500, @account.bytes_used
+  end
+
+  test "materializes entries in batches and preserves exact signed totals across batch boundaries" do
+    # First batch sums negative (-300), second batch sums positive (+500) -> net +200
+    Storage::Entry.insert_all!([
+      { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, owner_type: "Board", owner_id: @board.id, delta: -200, operation: "detach", created_at: Time.current },
+      { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, owner_type: "Board", owner_id: @board.id, delta: -100, operation: "detach", created_at: Time.current },
+      { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, owner_type: "Board", owner_id: @board.id, delta: 250, operation: "attach", created_at: Time.current },
+      { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, owner_type: "Board", owner_id: @board.id, delta: 250, operation: "attach", created_at: Time.current }
+    ])
+
+    checkpoints = 0
+    with_const(Storage::Total, :BATCH_SIZE, 2) do
+      Storage::Total.materialize(@board) { checkpoints += 1 }
+    end
+
+    assert_equal 200, @board.bytes_used
+    assert_operator checkpoints, :>=, 2
+    assert_empty Storage::Entry.where(owner: @board)
+  end
+
+  test "bytes_used clamps negative raw totals to 0 without losing signed accuracy" do
+    Storage::Total.create!(account: @account, owner: @board, bytes_used: -100)
+    assert_equal 0, @board.bytes_used
+
+    Storage::Entry.create!(account: @account, owner: @board, delta: 250, operation: "attach")
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 150, @board.bytes_used
+  end
+
+  test "materialize_pending_later sweeps stranded entries and cleans up orphaned owners" do
+    Storage::Entry.insert_all!([
+      { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, owner_type: "Board", owner_id: @board.id, delta: 400, operation: "attach", created_at: Time.current },
+      { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, owner_type: "Account", owner_id: @account.id, delta: 400, operation: "attach", created_at: Time.current },
+      { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, owner_type: "Board", owner_id: ActiveRecord::Type::Uuid.generate, delta: 999, operation: "attach", created_at: Time.current }
+    ])
+
+    Storage::Entry.materialize_pending_later
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 400, @board.bytes_used
+    assert_equal 400, @account.bytes_used
+    assert_empty Storage::Entry.where(account_id: @account.id)
+  end
+
+  test "reconcile repairs drift and backfills existing attachments across batches" do
+    # Create attachments across board description, multiple cards, and multiple comments
+    board_blob = create_blob(size: 100)
+    @board.update!(public_description: embed_html(board_blob))
+
+    expected_board_bytes = 100
+    3.times do |i|
+      card = @board.cards.create!(title: "Card #{i}", creator: @user, status: :published)
+      card.image.attach(io: StringIO.new("a" * (50 + i)), filename: "c#{i}.png", content_type: "image/png")
+      desc_blob = create_blob(size: 70 + i)
+      card.update!(description: embed_html(desc_blob))
+      expected_board_bytes += (50 + i) + (70 + i)
+
+      3.times do |j|
+        comment_blob = create_blob(size: 30 + j)
+        card.comments.create!(body: embed_html(comment_blob))
+        expected_board_bytes += (30 + j)
+      end
+    end
+
+    other_blob = create_blob(size: 250)
+    @other_board.update!(public_description: embed_html(other_blob))
+
+    # Wipe storage totals and entries to simulate pre-existing unbackfilled data + drift + orphaned board total
+    Storage::Entry.where(account_id: @account.id).delete_all
+    Storage::Total.where(account_id: @account.id).delete_all
+    Storage::Total.create!(account: @account, owner: @board, bytes_used: 999_999)
+    Storage::Total.create!(account: @account, owner: @account, bytes_used: 123_456)
+    orphan_id = ActiveRecord::Type::Uuid.generate
+    Storage::Total.insert!({
+      id: orphan_id,
+      account_id: @account.id,
+      owner_type: "Board",
+      owner_id: ActiveRecord::Type::Uuid.generate,
+      bytes_used: 5000,
+      version: 0,
+      created_at: Time.current,
+      updated_at: Time.current
+    })
+
+    with_const(Storage::Calculator, :BATCH_SIZE, 2) do
+      @account.reconcile_storage_later
+      perform_enqueued_jobs only: Storage::ReconcileJob
+    end
+
+    assert_equal expected_board_bytes, @board.bytes_used
+    assert_equal 250, @other_board.bytes_used
+    assert_equal expected_board_bytes + 250, @account.bytes_used
+    assert_not Storage::Total.exists?(orphan_id)
+  end
+
+  test "reconciliation does not clobber concurrent writes that occur during calculation" do
+    @card.image.attach(io: StringIO.new("a" * 100), filename: "init.png", content_type: "image/png")
+    perform_enqueued_jobs only: Storage::MaterializeJob
+    assert_equal 100, @board.bytes_used
+
+    # Simulate a concurrent attachment arriving during the first calculate_storage_bytes call
+    calls = 0
+    original_calculate = @board.method(:calculate_storage_bytes)
+    @board.define_singleton_method(:calculate_storage_bytes) do |&checkpoint|
+      calls += 1
+      result = original_calculate.call(&checkpoint)
+      if calls == 1
+        # Simulate another user attaching 250 bytes and materializing while scan was in flight
+        Storage::Entry.create!(account: account, owner: self, delta: 250, operation: "attach")
+        Storage::Total.materialize(self)
+      end
+      result
+    end
+
+    @board.reconcile_storage
+
+    # First attempt detected concurrent version bump and retried instead of overwriting with stale 100
+    assert_operator calls, :>=, 2
+  end
+
+  test "account import calculates storage usage for imported account and boards" do
+    source_account = @account
+    exporter = @user
+    identity = exporter.identity
+
+    board_blob = create_blob(size: 120)
+    desc_blob = create_blob(size: 230)
+    comment_blob = create_blob(size: 340)
+
+    @board.update!(public_description: embed_html(board_blob))
+    @card.image.attach(io: StringIO.new("i" * 110), filename: "card.png", content_type: "image/png")
+    @card.update!(description: embed_html(desc_blob))
+    @card.comments.create!(body: embed_html(comment_blob))
+    @user.avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    expected_board_bytes = 120 + 110 + 230 + 340
+    assert_equal expected_board_bytes, @board.bytes_used
+    assert_equal expected_board_bytes, source_account.bytes_used
+
+    export = Account::Export.create!(account: source_account, user: exporter)
+    export.build
+    assert export.completed?
+
+    export_tempfile = Tempfile.new([ "export", ".zip" ])
+    export.file.open { |f| FileUtils.cp(f.path, export_tempfile.path) }
+
+    source_account.destroy!
+    ActiveStorage::VariantRecord.where(account: source_account).delete_all
+    ActiveStorage::Attachment.where(account: source_account).delete_all
+    ActiveStorage::Blob.where(account: source_account).delete_all
+
+    target_account = Account.create_with_owner(account: { name: "Imported" }, owner: { identity: identity, name: exporter.name })
+    import = Account::Import.create!(identity: identity, account: target_account)
+    Current.set(account: target_account) do
+      import.file.attach(io: File.open(export_tempfile.path), filename: "export.zip", content_type: "application/zip")
+    end
+
+    import.check
+    import.process
+    perform_enqueued_jobs only: Storage::ReconcileJob
+
+    imported_board = target_account.boards.find_by!(name: "Writebook")
+    assert_equal expected_board_bytes, imported_board.bytes_used
+    assert_equal expected_board_bytes, target_account.bytes_used
+  ensure
+    export_tempfile&.close
+    export_tempfile&.unlink
+  end
+
+  test "incremental updates stay O(1) regardless of existing attachments on the board" do
+    small_board = @account.boards.create!(name: "Small Board", creator: @user)
+    small_card = small_board.cards.create!(title: "Small 1", creator: @user, status: :published)
+    small_card.image.attach(io: StringIO.new("x" * 100), filename: "small_init.png", content_type: "image/png")
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    small_probe_card = small_board.cards.create!(title: "Small Probe", creator: @user, status: :published)
+    small_queries = count_queries do
+      small_probe_card.image.attach(io: StringIO.new("y" * 150), filename: "small_probe.png", content_type: "image/png")
+      Storage::Total.materialize(small_board)
+      Storage::Total.materialize(@account)
+    end
+
+    # Seed 25 cards with attachments on another board
+    large_board = @account.boards.create!(name: "Large Board", creator: @user)
+    25.times do |i|
+      card = large_board.cards.create!(title: "Bulk #{i}", creator: @user, status: :published)
+      card.image.attach(io: StringIO.new("x" * 100), filename: "img_#{i}.png", content_type: "image/png")
+    end
+    perform_enqueued_jobs only: Storage::MaterializeJob
+    assert_equal 2500, large_board.bytes_used
+
+    large_probe_card = large_board.cards.create!(title: "Large Probe", creator: @user, status: :published)
+    large_queries = count_queries do
+      large_probe_card.image.attach(io: StringIO.new("y" * 150), filename: "large_probe.png", content_type: "image/png")
+      Storage::Total.materialize(large_board)
+      Storage::Total.materialize(@account)
+    end
+
+    assert_equal 2650, large_board.bytes_used
+    assert_equal small_queries, large_queries
+  end
+
+  private
+    def create_blob(size:)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("b" * size),
+        filename: "file_#{size}.txt",
+        content_type: "text/plain"
+      )
+    end
+
+    def embed_html(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+
+    def count_queries
+      count = 0
+      counter = ->(_name, _start, _finish, _id, payload) do
+        count += 1 unless payload[:name] == "SCHEMA" || payload[:cached]
+      end
+      ActiveSupport::Notifications.subscribed(counter, "sql.active_record") { yield }
+      count
+    end
+
+    def with_const(mod, const_name, value)
+      original = mod.const_get(const_name)
+      mod.send(:remove_const, const_name)
+      mod.const_set(const_name, value)
+      yield
+    ensure
+      mod.send(:remove_const, const_name)
+      mod.const_set(const_name, original)
+    end
+end
