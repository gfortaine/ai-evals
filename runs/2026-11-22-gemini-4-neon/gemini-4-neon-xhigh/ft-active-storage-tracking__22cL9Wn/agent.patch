+
+    assert_equal 50, @board.bytes_used
+    assert_equal 600, @other_board.bytes_used
+    assert_equal 650, @account.bytes_used
+  end
+
+  test "chained card moves and edits before background jobs run stay accurate" do
+    third_board = @account.boards.create!(name: "Third", creator: @user)
+    comment_blob = create_blob(size: 250)
+
+    attach_card_image(@card, size: 100)
