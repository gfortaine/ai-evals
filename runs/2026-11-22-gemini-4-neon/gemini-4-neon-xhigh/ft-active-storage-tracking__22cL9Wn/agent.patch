+++ b/app/models/storage/tracked.rb
@@ -0,0 +1,25 @@
+module Storage::Tracked
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    Storage::Total.bytes_used_for(self)
+  end
+
+  def materialize_storage_later
+    Storage::Total.materialize_later(self)
+  end
+
+  def materialize_storage
+    Storage::Total.materialize(self)
+  end
+
+  def reconcile_storage_later
+    Current.with_account(account) do
+      Storage::ReconcileJob.perform_later(self)
+    end
+  end
+
+  def reconcile_storage
+    Storage::Total.reconcile(self)
+  end
+end
