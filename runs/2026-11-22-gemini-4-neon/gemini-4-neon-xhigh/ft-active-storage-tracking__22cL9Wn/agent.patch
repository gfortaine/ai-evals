@@ -0,0 +1,20 @@
+require "active_job/continuable"
+
+class Storage::MaterializeJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked, wait: :polynomially_longer
+
+  limits_concurrency to: 1, key: ->(owner) { owner }, duration: 5.minutes
+
+  def perform(owner)
+    step :materialize do |step|
+      Storage::Total.materialize(owner) do
+        step.checkpoint!
+      end
+    end
+  end
+end
