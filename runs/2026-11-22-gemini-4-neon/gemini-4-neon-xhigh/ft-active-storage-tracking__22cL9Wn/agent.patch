+      @card.destroy!
+    end
+
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 50, @board.bytes_used
+    assert_equal 50, @account.bytes_used
+  end
+
+  test "moving a card transfers its image, description embeds, and comment embeds between boards" do
+    board_blob = create_blob(size: 50)
+    desc_blob = create_blob(size: 200)
+    comment_blob = create_blob(size: 300)
+
