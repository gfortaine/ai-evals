+    assert_enqueued_with(job: Storage::MaterializeJob, args: [ @account ])
+
+    perform_enqueued_jobs
+
+    assert_equal 128, @board.bytes_used
+    assert_equal 128, @account.bytes_used
+  end
+
+  test "tracks card image attach, replace, purge_later, purge, detach, and nil update" do
+    attach_card_image(@card, size: 100)
+    perform_enqueued_jobs
+    assert_equal 100, @board.bytes_used
+    assert_equal 100, @account.bytes_used
+
+    # Replace image
+    attach_card_image(@card, size: 250)
+    perform_enqueued_jobs
+    assert_equal 250, @board.bytes_used
+    assert_equal 250, @account.bytes_used
+
+    # Remove via purge_later (used by Cards::ImagesController#destroy)
+    @card.image.purge_later
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    # Attach and remove via purge
+    attach_card_image(@card, size: 180)
+    perform_enqueued_jobs
+    assert_equal 180, @board.bytes_used
+
+    @card.image.purge
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    # Attach and remove via detach
+    attach_card_image(@card, size: 140)
+    perform_enqueued_jobs
+    assert_equal 140, @board.bytes_used
+
+    @card.image.detach
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    # Attach and remove via update(image: nil)
+    attach_card_image(@card, size: 90)
+    perform_enqueued_jobs
+    assert_equal 90, @board.bytes_used
+
+    @card.update!(image: nil)
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "tracks attachments on drafted cards and cards created with image and description" do
+    blob = create_blob(size: 320)
+
+    draft = @board.cards.create!(
+      title: "Draft card",
+      creator: @user,
+      status: :drafted,
+      image: { io: StringIO.new("x" * 200), filename: "draft.png", content_type: "image/png" },
+      description: embed_html(blob)
+    )
+    assert draft.drafted?
+
+    perform_enqueued_jobs
+
+    assert_equal 520, @board.bytes_used
+    assert_equal 520, @account.bytes_used
+  end
+
+  test "tracks files embedded in board public_description" do
+    blob1 = create_blob(size: 300)
+    blob2 = create_blob(size: 450)
+
+    @board.update!(public_description: "<p>Info</p>#{embed_html(blob1)}")
+    perform_enqueued_jobs
+    assert_equal 300, @board.bytes_used
+    assert_equal 300, @account.bytes_used
+
+    # Editing text without changing embeds does not double-count
+    @board.update!(public_description: "<p>Updated info</p>#{embed_html(blob1)}")
+    perform_enqueued_jobs
+    assert_equal 300, @board.bytes_used
+    assert_equal 300, @account.bytes_used
+
+    # Adding a second embed
+    @board.update!(public_description: "#{embed_html(blob1)}#{embed_html(blob2)}")
+    perform_enqueued_jobs
+    assert_equal 750, @board.bytes_used
+    assert_equal 750, @account.bytes_used
+
+    # Removing first embed
+    @board.update!(public_description: embed_html(blob2))
+    perform_enqueued_jobs
+    assert_equal 450, @board.bytes_used
+    assert_equal 450, @account.bytes_used
+
+    # Clearing public_description to empty string
+    @board.update!(public_description: "")
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "tracks files embedded in board created with public_description" do
+    blob = create_blob(size: 275)
+
+    new_board = @account.boards.create!(
+      name: "With Description",
+      creator: @user,
+      public_description: embed_html(blob)
+    )
+    perform_enqueued_jobs
+
+    assert_equal 275, new_board.bytes_used
+    assert_equal 275, @account.bytes_used
+  end
+
+  test "tracks files embedded in card description including clearing to blank or nil" do
+    blob1 = create_blob(size: 400)
+    blob2 = create_blob(size: 600)
+
+    @card.update!(description: "<p>Specs</p>#{embed_html(blob1)}#{embed_html(blob2)}")
+    perform_enqueued_jobs
+    assert_equal 1000, @board.bytes_used
+    assert_equal 1000, @account.bytes_used
+
+    # Swap out blob1 for plain text, keep blob2
+    @card.update!(description: "<p>Only second</p>#{embed_html(blob2)}")
+    perform_enqueued_jobs
+    assert_equal 600, @board.bytes_used
+    assert_equal 600, @account.bytes_used
+
+    # Clear to nil
+    @card.update!(description: nil)
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "tracks files embedded in comments across create, update, clear, and destroy" do
+    blob1 = create_blob(size: 220)
+    blob2 = create_blob(size: 330)
+    blob3 = create_blob(size: 410)
+
+    comment = @card.comments.create!(body: "<p>Look</p>#{embed_html(blob1)}")
+    perform_enqueued_jobs
+    assert_equal 220, @board.bytes_used
+    assert_equal 220, @account.bytes_used
+
+    comment.update!(body: "#{embed_html(blob1)}#{embed_html(blob2)}")
+    perform_enqueued_jobs
+    assert_equal 550, @board.bytes_used
+    assert_equal 550, @account.bytes_used
+
+    comment.update!(body: "No files now")
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    comment.update!(body: embed_html(blob3))
+    perform_enqueued_jobs
+    assert_equal 410, @board.bytes_used
+    assert_equal 410, @account.bytes_used
+
+    comment.destroy!
+    perform_enqueued_jobs only: Storage::MaterializeJob
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "counts embedded images by original blob size without counting generated variants" do
+    image_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    expected_size = image_blob.byte_size
+
+    @card.update!(description: embed_html(image_blob))
+    perform_enqueued_jobs
+
+    # Confirm variants were actually generated
+    assert @card.rich_text_description.embeds.sole.variant(:small).processed?
+    assert @card.rich_text_description.embeds.sole.variant(:large).processed?
+
+    assert_equal expected_size, @board.bytes_used
+    assert_equal expected_size, @account.bytes_used
+  end
+
+  test "does not count remote attachments, mentions, avatars, exports, imports, or unattached blobs" do
+    # Remote image & user mention in card description
+    @card.update!(description: <<~HTML)
+      <p>Hi <action-text-attachment sgid="#{@user.attachable_sgid}"></action-text-attachment></p>
+      <action-text-attachment url="https://example.com/remote.gif" content-type="image/gif" filename="remote.gif"></action-text-attachment>
+    HTML
+
+    # User avatar
+    @user.avatar.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    # Account export
+    account_export = Account::Export.create!(account: @account, user: @user)
+    account_export.file.attach(io: StringIO.new("z" * 1024), filename: "export.zip", content_type: "application/zip")
+
+    # User data export
+    user_export = User::DataExport.create!(account: @account, user: @user)
+    user_export.file.attach(io: StringIO.new("u" * 1024), filename: "user_export.zip", content_type: "application/zip")
+
+    # Account import
+    import = Account::Import.create!(account: @account, identity: @user.identity)
+    import.file.attach(io: StringIO.new("i" * 2048), filename: "import.zip", content_type: "application/zip")
+
+    # Unattached blob
+    create_blob(size: 4096)
+
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "aggregates usage across multiple boards in an account and isolates accounts" do
+    blob1 = create_blob(size: 100)
+    blob2 = create_blob(size: 200)
+    blob3 = create_blob(size: 350)
+
+    attach_card_image(@card, size: 150)
+    @board.update!(public_description: embed_html(blob1))
+
+    other_card = @other_board.cards.create!(title: "Private card", creator: @user, status: :published, description: embed_html(blob2))
+    other_card.comments.create!(body: embed_html(blob3))
+    perform_enqueued_jobs
+
+    assert_equal 250, @board.bytes_used
+    assert_equal 550, @other_board.bytes_used
+    assert_equal 800, @account.bytes_used
+
+    # Other account is completely unaffected
+    other_account = accounts(:initech)
+    assert_equal 0, other_account.bytes_used
+
+    # Mutating other account properly tracks against that account
+    initech_card = cards(:radio)
+    initech_board = initech_card.board
+    Current.with_account(other_account) do
+      attach_card_image(initech_card, size: 999)
+    end
+    perform_enqueued_jobs
+
+    assert_equal 999, initech_board.bytes_used
+    assert_equal 999, other_account.bytes_used
+    assert_equal 800, @account.bytes_used
+  end
+
+  test "destroying a card subtracts its image, description embeds, and comment embeds" do
+    board_blob = create_blob(size: 50)
+    desc_blob = create_blob(size: 200)
+    comment1_blob = create_blob(size: 300)
+    comment2_blob = create_blob(size: 400)
+
+    @board.update!(public_description: embed_html(board_blob))
+    attach_card_image(@card, size: 100)
+    @card.update!(description: embed_html(desc_blob))
