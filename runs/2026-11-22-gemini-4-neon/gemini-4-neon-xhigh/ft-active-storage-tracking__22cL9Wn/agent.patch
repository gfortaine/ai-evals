+  end
+
+  test "destroying a board subtracts its usage from the account and cleans up board storage records" do
+    board_blob = create_blob(size: 100)
+    card_blob = create_blob(size: 200)
+    comment_blob = create_blob(size: 300)
+    other_blob = create_blob(size: 400)
+
+    @board.update!(public_description: embed_html(board_blob))
