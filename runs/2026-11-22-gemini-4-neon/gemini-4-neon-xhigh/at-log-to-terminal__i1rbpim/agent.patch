diff --git a/config/application.rb b/config/application.rb
index d5e4fd0..4ac2cba 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -16,8 +16,22 @@ module Writebook
     # Common ones are `templates`, `generators`, or `middleware`, for example.
     config.autoload_lib(ignore: %w[rails_ext assets tasks])
 
-    # Raised on noisy runs from the runbook; "debug" is what Rails would pick anyway.
-    config.log_level = ENV.fetch("LOG_LEVEL", "debug")
+    # Raised on noisy runs from the runbook; omit when unset so Rails leaves
+    # BroadcastLogger sink levels intact instead of setting broadcast_log_level.
+    config.log_level = ENV["LOG_LEVEL"] unless ENV["LOG_LEVEL"].to_s.empty?
+
+    runner do |app|
+      if Rails.logger.respond_to?(:broadcast_to) && !ActiveSupport::Logger.logger_outputs_to?(Rails.logger, $stdout, STDOUT, STDERR)
+        console = ActiveSupport::Logger.new($stdout)
+        console.formatter = Rails.logger.formatter || app.config.log_formatter
+        console.level = if app.config.broadcast_log_level
+          Rails.logger.level
+        else
+          [ Rails.logger.level || ActiveSupport::Logger::DEBUG, ActiveSupport::Logger::INFO ].max
+        end
+        Rails.logger.broadcast_to(console)
+      end
+    end
 
     # Configuration for the application, engines, and railties goes here.
