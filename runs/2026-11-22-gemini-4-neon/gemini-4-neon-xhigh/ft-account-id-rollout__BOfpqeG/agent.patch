+      backfill_active_storage
+    end
+
+    def backfill_from_parent(table, parent_table, foreign_key)
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = (
+          SELECT #{parent_table}.account_id
+          FROM #{parent_table}
+          WHERE #{parent_table}.id = #{table}.#{foreign_key}
+        )
+        WHERE #{table}.account_id IS NULL
+      SQL
+
+      prune_orphans(table)
+    end
+
+    def backfill_account_or_board_polymorphic(table, association)
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = (
+          SELECT accounts.id
+          FROM accounts
+          WHERE accounts.id = #{table}.#{association}_id
+        )
+        WHERE #{table}.account_id IS NULL
+          AND #{table}.#{association}_type = 'Account'
+      SQL
+
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = (
+          SELECT boards.account_id
+          FROM boards
+          WHERE boards.id = #{table}.#{association}_id
+        )
+        WHERE #{table}.account_id IS NULL
+          AND #{table}.#{association}_type = 'Board'
+      SQL
+
+      prune_orphans(table)
+    end
+
+    def backfill_card_or_comment_polymorphic(table, association)
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = (
+          SELECT cards.account_id
+          FROM cards
+          WHERE cards.id = #{table}.#{association}_id
+        )
+        WHERE #{table}.account_id IS NULL
+          AND #{table}.#{association}_type = 'Card'
+      SQL
+
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = (
+          SELECT comments.account_id
+          FROM comments
+          WHERE comments.id = #{table}.#{association}_id
+        )
+        WHERE #{table}.account_id IS NULL
+          AND #{table}.#{association}_type = 'Comment'
+      SQL
+
+      prune_orphans(table)
+    end
+
+    def backfill_tags
+      execute <<~SQL
+        UPDATE tags
+        SET account_id = (
+          SELECT cards.account_id
+          FROM taggings
+          INNER JOIN cards ON cards.id = taggings.card_id
+          WHERE taggings.tag_id = tags.id
+            AND cards.account_id IS NOT NULL
+          LIMIT 1
+        )
+        WHERE tags.account_id IS NULL
+      SQL
+
+      prune_orphans(:tags)
+    end
+
+    def backfill_action_text_rich_texts
+      {
+        "Card" => "cards",
+        "Comment" => "comments",
+        "Board" => "boards"
+      }.each do |record_type, parent_table|
+        execute <<~SQL
+          UPDATE action_text_rich_texts
+          SET account_id = (
+            SELECT #{parent_table}.account_id
+            FROM #{parent_table}
+            WHERE #{parent_table}.id = action_text_rich_texts.record_id
+          )
+          WHERE action_text_rich_texts.account_id IS NULL
+            AND action_text_rich_texts.record_type = '#{record_type}'
+        SQL
+      end
+
+      prune_orphans(:action_text_rich_texts)
+    end
+
+    def backfill_active_storage
+      # 1. Primary attachments pointing to domain records or rich texts
+      {
+        "Card" => "cards",
+        "Comment" => "comments",
+        "Board" => "boards",
+        "User" => "users",
+        "Export" => "exports",
+        "Account::Export" => "exports",
+        "User::DataExport" => "exports",
+        "Account::Import" => "account_imports",
+        "ActionText::RichText" => "action_text_rich_texts"
+      }.each do |record_type, parent_table|
+        execute <<~SQL
+          UPDATE active_storage_attachments
+          SET account_id = (
+            SELECT #{parent_table}.account_id
+            FROM #{parent_table}
+            WHERE #{parent_table}.id = active_storage_attachments.record_id
+          )
+          WHERE active_storage_attachments.account_id IS NULL
+            AND active_storage_attachments.record_type = '#{record_type}'
+        SQL
+      end
+
+      # 2. Primary blobs from backfilled attachments
+      backfill_blobs_from_attachments
+
+      # 3. Preview attachments (record_type = 'ActiveStorage::Blob') and their blobs
+      execute <<~SQL
+        UPDATE active_storage_attachments
+        SET account_id = (
+          SELECT active_storage_blobs.account_id
+          FROM active_storage_blobs
+          WHERE active_storage_blobs.id = active_storage_attachments.record_id
+        )
+        WHERE active_storage_attachments.account_id IS NULL
+          AND active_storage_attachments.record_type = 'ActiveStorage::Blob'
+      SQL
+
+      backfill_blobs_from_attachments
+
+      # 4. Variant records from their parent blobs
+      execute <<~SQL
+        UPDATE active_storage_variant_records
+        SET account_id = (
+          SELECT active_storage_blobs.account_id
+          FROM active_storage_blobs
+          WHERE active_storage_blobs.id = active_storage_variant_records.blob_id
+        )
+        WHERE active_storage_variant_records.account_id IS NULL
+      SQL
+
+      # 5. Variant attachments (record_type = 'ActiveStorage::VariantRecord') and their blobs
+      execute <<~SQL
+        UPDATE active_storage_attachments
+        SET account_id = (
+          SELECT active_storage_variant_records.account_id
+          FROM active_storage_variant_records
+          WHERE active_storage_variant_records.id = active_storage_attachments.record_id
+        )
+        WHERE active_storage_attachments.account_id IS NULL
+          AND active_storage_attachments.record_type = 'ActiveStorage::VariantRecord'
+      SQL
+
+      backfill_blobs_from_attachments
+
+      # 6. Drop orphaned rows from all three ActiveStorage tables
+      prune_orphans(:active_storage_attachments)
+      prune_orphans(:active_storage_variant_records)
+      prune_orphans(:active_storage_blobs)
+    end
+
+    def backfill_blobs_from_attachments
+      execute <<~SQL
+        UPDATE active_storage_blobs
+        SET account_id = (
+          SELECT active_storage_attachments.account_id
+          FROM active_storage_attachments
+          WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+            AND active_storage_attachments.account_id IS NOT NULL
+          LIMIT 1
+        )
+        WHERE active_storage_blobs.account_id IS NULL
+      SQL
+    end
+
+    def prune_orphans(table)
+      execute <<~SQL
+        DELETE FROM #{table}
+        WHERE account_id IS NULL
+           OR NOT EXISTS (
+             SELECT 1 FROM accounts WHERE accounts.id = #{table}.account_id
+           )
+      SQL
+    end
+
+    def search_record_tables
+      if table_exists?(:search_records)
+        [ :search_records ]
+      else
+        (0..15).map { |i| :"search_records_#{i}" }.select { |t| table_exists?(t) }
+      end
+    end
+end
