@@ -0,0 +1,350 @@
+class RequireAccountIdOnAllTenantTables < ActiveRecord::Migration[8.2]
+  TABLES_ADDING_ACCOUNT_ID = %i[
+    accesses
+    action_text_rich_texts
+    active_storage_attachments
+    active_storage_blobs
+    active_storage_variant_records
+    assignees_filters
+    assigners_filters
+    assignments
+    board_publications
+    boards_filters
+    card_activity_spikes
+    card_goldnesses
+    card_not_nows
+    closers_filters
+    closures
+    creators_filters
+    entropies
+    filters_tags
+    mentions
+    pins
+    reactions
+    search_queries
+    storage_totals
+    taggings
+    user_settings
+    watches
+    webhook_delinquency_trackers
+    webhook_deliveries
+  ].freeze
+
+  TABLES_REQUIRING_ACCOUNT_ID = (TABLES_ADDING_ACCOUNT_ID + %i[
+    account_imports
+    account_join_codes
+    boards
+    cards
+    columns
+    comments
+    events
+    filters
+    notification_bundles
+    notifications
+    push_subscriptions
+    steps
+    tags
+    users
+    webhooks
+  ]).freeze
+
+  TABLES_INDEXING_ACCOUNT_ID = (TABLES_REQUIRING_ACCOUNT_ID - %i[ account_imports ]).freeze
+
+  def change
+    TABLES_ADDING_ACCOUNT_ID.each do |table|
+      add_column table, :account_id, :uuid
+    end
+
+    reversible do |dir|
+      dir.up do
+        backfill_and_prune_orphans
+      end
+    end
+
+    TABLES_REQUIRING_ACCOUNT_ID.each do |table|
+      change_column_null table, :account_id, false
+    end
+
+    TABLES_INDEXING_ACCOUNT_ID.each do |table|
+      add_index table, :account_id
+    end
+
+    remove_index :tags, :title, unique: true
+    add_index :tags, [ :account_id, :title ], unique: true
+  end
+
+  private
+    def backfill_and_prune_orphans
+      # Level 1: Direct account children (already have account_id)
+      %i[
+        users
+        account_join_codes
+        account_imports
+        account_cancellations
+        exports
+        storage_entries
+      ].each { |table| prune_orphans(table) }
+
+      search_record_tables.each { |table| prune_orphans(table) }
+
+      # Level 2: Children of users
+      backfill_from_parent(:boards, :users, :creator_id)
+      backfill_from_parent(:filters, :users, :creator_id)
+      backfill_from_parent(:notifications, :users, :user_id)
+      backfill_from_parent(:notification_bundles, :users, :user_id)
+      backfill_from_parent(:push_subscriptions, :users, :user_id)
+      backfill_from_parent(:user_settings, :users, :user_id)
+      backfill_from_parent(:search_queries, :users, :user_id)
+
+      # Level 3: Children of boards, accounts/boards polymorphic, and filters
+      backfill_from_parent(:cards, :boards, :board_id)
+      backfill_from_parent(:columns, :boards, :board_id)
+      backfill_from_parent(:events, :boards, :board_id)
+      backfill_from_parent(:webhooks, :boards, :board_id)
+      backfill_from_parent(:accesses, :boards, :board_id)
+      backfill_from_parent(:board_publications, :boards, :board_id)
+      backfill_account_or_board_polymorphic(:entropies, :container)
+      backfill_account_or_board_polymorphic(:storage_totals, :owner)
+
+      %i[
+        assignees_filters
+        assigners_filters
+        boards_filters
+        closers_filters
+        creators_filters
+        filters_tags
+      ].each { |table| backfill_from_parent(table, :filters, :filter_id) }
+
+      # Level 4: Children of cards and webhooks
+      backfill_from_parent(:comments, :cards, :card_id)
+      backfill_from_parent(:steps, :cards, :card_id)
+      backfill_from_parent(:assignments, :cards, :card_id)
+      backfill_from_parent(:card_activity_spikes, :cards, :card_id)
+      backfill_from_parent(:card_goldnesses, :cards, :card_id)
+      backfill_from_parent(:card_not_nows, :cards, :card_id)
+      backfill_from_parent(:closures, :cards, :card_id)
+      backfill_from_parent(:pins, :cards, :card_id)
+      backfill_from_parent(:watches, :cards, :card_id)
+      backfill_tags
+      backfill_from_parent(:taggings, :cards, :card_id)
+      backfill_from_parent(:webhook_delinquency_trackers, :webhooks, :webhook_id)
+      backfill_from_parent(:webhook_deliveries, :webhooks, :webhook_id)
+
+      # Level 5: Polymorphic children of cards, comments, and boards
+      backfill_card_or_comment_polymorphic(:mentions, :source)
+      backfill_card_or_comment_polymorphic(:reactions, :reactable)
+      backfill_action_text_rich_texts
+
