+test "index breaks timestamp ties by id descending" do
+  card = cards(:logo)
+  board = boards(:writebook)
+  creator = users(:kevin)
+  timestamp = 1.hour.from_now.change(usec: 0)
+
+  first_event = Event.create!(board: board, creator: creator, eventable: card, action: "card_published", created_at: timestamp)
+  second_event = Event.create!(board: board, creator: creator, eventable: card, action: "card_closed", created_at: timestamp)
+
+  get activities_path(format: :json)
+  assert_response :success
+
+  ids = @response.parsed_body.pluck("id")
+  expected_pair = [ first_event.id, second_event.id ].sort.reverse
+  assert_equal expected_pair, ids.first(2)
+end
+
+  private
+    def fetch_all_activity_ids
+      ids = []
+      next_page = activities_path(format: :json)
+
+      while next_page
+        get next_page, as: :json
+        assert_response :success
+        ids.concat(@response.parsed_body.pluck("id"))
+        next_page = next_page_from_link_header(@response.headers["Link"])
+      end
+
+      ids
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
