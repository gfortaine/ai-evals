+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "particular_details for assignment changes" do
+    event = events(:logo_assignment_jz)
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, event.particular_details)
+
+    unassigned = Event.new(action: "card_unassigned", particulars: { "assignee_ids" => [ users(:kevin).id ] })
+    assert_equal({ assignee_ids: [ users(:kevin).id ] }, unassigned.particular_details)
+
+    missing_assignees = Event.new(action: "card_assigned", particulars: nil)
+    assert_equal({ assignee_ids: [] }, missing_assignees.particular_details)
+  end
+
+  test "particular_details for board changes" do
+    event = Event.new(
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Writebook", "new_board" => "Private" } }
+    )
+    assert_equal({ old_board: "Writebook", new_board: "Private" }, event.particular_details)
+
+    missing = Event.new(action: "card_board_changed", particulars: { "particulars" => { "new_board" => "Private" } })
+    assert_equal({ old_board: "", new_board: "Private" }, missing.particular_details)
+
+    empty = Event.new(action: "card_board_changed", particulars: nil)
+    assert_equal({ old_board: "", new_board: "" }, empty.particular_details)
+  end
+
+  test "particular_details for title changes" do
+    event = Event.new(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } }
+    )
+    assert_equal({ old_title: "Old", new_title: "New" }, event.particular_details)
+
+    missing = Event.new(action: "card_title_changed", particulars: {})
+    assert_equal({ old_title: "", new_title: "" }, missing.particular_details)
+  end
+
+  test "particular_details for triage events" do
+    event = Event.new(
+      action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In Progress" } }
+    )
+    assert_equal({ column: "In Progress" }, event.particular_details)
+
+    missing = Event.new(action: "card_triaged", particulars: { "particulars" => { "column" => nil } })
+    assert_equal({ column: "" }, missing.particular_details)
+  end
+
+  test "particular_details for other events returns empty hash" do
+    %w[
+      card_published
+      card_closed
+      card_reopened
+      card_postponed
+      card_auto_postponed
+      card_sent_back_to_triage
+      comment_created
+    ].each do |action|
+      event = Event.new(action: action, particulars: { "particulars" => { "extra" => "ignored" } })
+      assert_equal({}, event.particular_details, "Expected empty particulars for #{action}")
+    end
+  end
+end
