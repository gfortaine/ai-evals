+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from filtered_events
+      end
+    end
+  end
+
+  private
+    def filtered_events
+      events = Current.user.accessible_events
+        .where(action: Event::ACTIVITY_ACTIONS)
+        .reverse_chronologically
+        .preload(
+          { creator: :identity },
+          { board: [ :entropy, :publication, :rich_text_public_description, { creator: :identity } ] },
+          { eventable: [
+            :goldness, :closure, :not_now, :tags, :image_attachment,
+            { column: :board },
+            { creator: :identity },
+            { assignees: :identity },
+            { board: [ :entropy, :publication, :rich_text_public_description, { creator: :identity } ] },
+            { rich_text_body: :embeds_attachments },
+            { rich_text_description: :embeds_attachments },
+            { card: [ :goldness, :closure, :image_attachment ] }
+          ] }
+        )
+
+      events = events.where(board_id: board_ids) if board_ids.present?
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events
+    end
+
+    def board_ids
+      @board_ids ||= extract_ids(params[:board_ids])
+    end
+
+    def creator_ids
+      @creator_ids ||= extract_ids(params[:creator_ids])
+    end
+
+    def extract_ids(value)
+      case value
+      when Array
+        value.filter_map { |id| id.to_s.presence unless id.is_a?(Hash) || id.is_a?(ActionController::Parameters) }
+      when String
+        [ value ].compact_blank
+      else
+        []
+      end
+    end
+end
