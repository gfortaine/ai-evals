diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..17993b0
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,513 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns flat array of accessible activities newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    expected_ids = users(:kevin).accessible_events
+      .where(action: Event::ACTIVITY_ACTIONS)
+      .reverse_chronologically
+      .pluck(:id)
+
+    assert_equal expected_ids, @response.parsed_body.pluck("id")
+  end
+
+  test "index works with Accept application/json header" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_not_empty @response.parsed_body
+  end
+
+  test "index works with bearer access token" do
+    sign_out
+    bearer = { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:jasons_api_token).token}" }
+
+    get activities_path(format: :json), env: bearer
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  test "index rejects HTML requests" do
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+
+    get activities_path
+    assert_response :not_acceptable
+  end
+
+  test "index includes expected fields and matches existing API representations for card events" do
+    event = events(:logo_published)
+    card = cards(:logo)
+
+    get cards_path(format: :json), params: { card_ids: [ card.id ] }
+    expected_card = @response.parsed_body.first
+
+    get board_path(event.board, format: :json)
+    expected_board = @response.parsed_body
+
+    get user_path(event.creator, format: :json)
+    expected_creator = @response.parsed_body
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert_not_nil activity
+
+    expected_keys = %w[ id action created_at description particulars url eventable_type eventable board creator ]
+    assert_equal expected_keys.sort, activity.keys.sort
+
+    assert_equal event.id, activity["id"]
+    assert_equal "card_published", activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_not_includes activity["description"], "<span"
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(card), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal expected_card, activity["eventable"]
+    assert_equal expected_board, activity["board"]
+    assert_equal expected_creator, activity["creator"]
+  end
+
+  test "index includes expected fields and matches existing API representations for comment events" do
+    event = events(:layout_commented)
+    comment = comments(:layout_overflowing_david)
+
+    get card_comment_path(comment.card, comment, format: :json)
+    expected_comment = @response.parsed_body
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert_not_nil activity
+
+    assert_equal "comment_created", activity["action"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), activity["url"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal expected_comment, activity["eventable"]
+  end
+
+  test "index mirrors HTML timeline events except omits card_collection_changed and includes card_title_changed" do
+    card = cards(:logo)
+    board = boards(:writebook)
+    creator = users(:kevin)
+    base_time = 10.minutes.from_now
+
+    included_actions = %w[
+      card_assigned
+      card_unassigned
+      card_published
+      card_closed
+      card_reopened
+      card_title_changed
+      card_board_changed
+      card_postponed
+      card_auto_postponed
+      card_triaged
+      card_sent_back_to_triage
+    ]
+
+    included_events = included_actions.each_with_index.map do |action, idx|
+      Event.create!(
+        board: board,
+        creator: creator,
+        eventable: card,
+        action: action,
+        created_at: base_time + idx.seconds
+      )
+    end
+
+    comment_event = Event.create!(
+      board: board,
+      creator: creator,
+      eventable: comments(:layout_overflowing_david),
+      action: "comment_created",
+      created_at: base_time + 20.seconds
+    )
+
+    collection_changed = Event.create!(
+      board: board,
+      creator: creator,
+      eventable: card,
+      action: "card_collection_changed",
+      particulars: { "particulars" => { "old_collection" => "Old", "new_collection" => "New" } },
+      created_at: base_time + 25.seconds
+    )
+
+    resumed_event = Event.create!(
+      board: board,
+      creator: creator,
+      eventable: card,
+      action: "card_resumed",
+      created_at: base_time + 26.seconds
+    )
+
+    all_ids = fetch_all_activity_ids
+
+    included_events.each do |event|
+      assert_includes all_ids, event.id, "Expected #{event.action} event to be included"
+    end
+    assert_includes all_ids, comment_event.id
+    assert_not_includes all_ids, collection_changed.id
+    assert_not_includes all_ids, resumed_event.id
+  end
+
+  test "index exposes particulars for assignment, board, title, and triage events" do
+    Current.session = sessions(:kevin)
+    card = cards(:logo)
+
+    # Assignment & unassignment via real domain methods
+    card.toggle_assignment(users(:kevin))
+    assigned_event = card.events.where(action: "card_assigned").order(:created_at, :id).last
+    card.toggle_assignment(users(:kevin))
+    unassigned_event = card.events.where(action: "card_unassigned").order(:created_at, :id).last
+
+    # Title change via real domain method
+    old_title = card.title
+    card.update!(title: "Brand new logo title")
+    title_changed_event = card.events.where(action: "card_title_changed").order(:created_at, :id).last
+
+    # Triage via real domain method
+    column = columns(:writebook_in_progress)
+    card.triage_into(column)
+    triaged_event = card.events.where(action: "card_triaged").order(:created_at, :id).last
+
+    # Send back to triage (should have empty particulars)
+    card.send_back_to_triage
+    sent_back_event = card.events.where(action: "card_sent_back_to_triage").order(:created_at, :id).last
+
+    # Board change via real domain method
+    old_board_name = card.board.name
+    card.move_to(boards(:private))
+    board_changed_event = card.events.where(action: "card_board_changed").order(:created_at, :id).last
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    by_id = @response.parsed_body.index_by { |item| item["id"] }
+
+    assert_equal({ "assignee_ids" => [ users(:kevin).id ] }, by_id.dig(assigned_event.id, "particulars"))
+    assert_equal({ "assignee_ids" => [ users(:kevin).id ] }, by_id.dig(unassigned_event.id, "particulars"))
+    assert_equal({ "old_title" => old_title, "new_title" => "Brand new logo title" }, by_id.dig(title_changed_event.id, "particulars"))
+    assert_equal({ "column" => column.name }, by_id.dig(triaged_event.id, "particulars"))
+    assert_equal({}, by_id.dig(sent_back_event.id, "particulars"))
+    assert_equal({ "old_board" => old_board_name, "new_board" => boards(:private).name }, by_id.dig(board_changed_event.id, "particulars"))
+  end
+
+  test "index returns empty strings for missing board, title, or column particulars" do
+    card = cards(:logo)
+    board = boards(:writebook)
+    creator = users(:kevin)
+    base_time = 10.minutes.from_now
+
+    missing_board = Event.create!(
+      board: board,
+      creator: creator,
+      eventable: card,
+      action: "card_board_changed",
+      particulars: {},
+      created_at: base_time + 1.second
+    )
+
+    partial_title = Event.create!(
+      board: board,
+      creator: creator,
+      eventable: card,
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old only" } },
+      created_at: base_time + 2.seconds
+    )
+
+    nil_column = Event.create!(
+      board: board,
+      creator: creator,
+      eventable: card,
+      action: "card_triaged",
+      particulars: nil,
+      created_at: base_time + 3.seconds
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    by_id = @response.parsed_body.index_by { |item| item["id"] }
+
