   end
+
+test "members are capped at bots_per_member (5 by default) and deleted bots do not count" do
+  bots = 5.times.map { |i| User.create_bot!(name: "Bot #{i + 1}", creator: users(:kevin)) }
+
+  assert users(:kevin).bot_limit_reached?
+  assert_not users(:kevin).can_create_bots?
+
+  extra = User.new(role: :bot, name: "Bot 6", creator: users(:kevin))
+  assert_not extra.valid?
+  assert extra.errors.of_kind?(:base, :bot_limit_reached)
+  assert_match /reached the limit/, extra.errors.full_messages.to_sentence
+
+  # Another member has their own independent quota
+  assert users(:jz).can_create_bots?
+  assert User.create_bot!(name: "JZ Bot 1", creator: users(:jz)).persisted?
+
+  # Deleting a bot frees a slot
+  bots.first.deactivate
+  assert_not users(:kevin).bot_limit_reached?
+  assert users(:kevin).can_create_bots?
+  replacement = User.create_bot!(name: "Replacement Bot", creator: users(:kevin))
+  assert replacement.persisted?
+  assert users(:kevin).bot_limit_reached?
+end
+
+test "administrators are not limited by bots_per_member even when set to 0" do
+  accounts(:signal).update!(settings: { bots_per_member: 0 })
+
+  assert_not users(:david).bot_limit_reached?
+  assert users(:david).can_create_bots?
+
+  3.times do |i|
+    assert User.create_bot!(name: "Admin Bot #{i + 1}", creator: users(:david)).persisted?
+  end
+
+  assert_not users(:david).bot_limit_reached?
+  assert users(:david).can_create_bots?
+
+  # Regular member cannot create any bot when limit is 0
+  assert users(:kevin).bot_limit_reached?
+  assert_not users(:kevin).can_create_bots?
+  assert_not User.new(role: :bot, name: "Blocked Bot", creator: users(:kevin)).valid?
+end
+
+test "lowering bots_per_member preserves existing bots and allows editing them while blocking new ones" do
+  bots = 4.times.map { |i| User.create_bot!(name: "Bot #{i + 1}", creator: users(:kevin)) }
+
+  accounts(:signal).update!(settings: { bots_per_member: 2 })
+
+  assert_equal 4, users(:kevin).created_bots.active.count
+  assert bots.all? { |b| b.reload.active? }
+  assert users(:kevin).bot_limit_reached?
+  assert_not User.new(role: :bot, name: "Bot 5", creator: users(:kevin)).valid?
+
+  # Existing bots can still be updated while over the limit
+  assert bots.first.update(name: "Renamed Bot 1")
+  assert_equal "Renamed Bot 1", bots.first.reload.name
+
+  # Still blocked after deleting 1 (3 active >= 2) and 2 (2 active >= 2)
+  bots[0].deactivate
+  assert users(:kevin).bot_limit_reached?
+  bots[1].deactivate
+  assert users(:kevin).bot_limit_reached?
+
+  # Allowed once active count drops below 2
+  bots[2].deactivate
+  assert users(:kevin).can_create_bots?
+  assert User.create_bot!(name: "New Bot", creator: users(:kevin)).persisted?
+end
 end
