+
+  test "any 2xx webhook response resets the consecutive failure counter" do
+    message = @room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} ping</div>"
+    )
+
+    [ 200, 201, 202, 204 ].each do |success_status|
+      WebMock.stub_request(:post, "https://bot.example.com/webhook").to_return(status: 500)
+      9.times { @webhook.deliver(message) }
+      assert_equal 9, @bot.reload.bot_webhook_failures
+      assert_not @bot.suspended?
+
+      WebMock.stub_request(:post, "https://bot.example.com/webhook").to_return(status: success_status)
+      @webhook.deliver(message)
+      assert_equal 0, @bot.reload.bot_webhook_failures
+      assert_not @bot.suspended?
+    end
+  end
+
+  test "suspended bot receives no mention or joined webhooks, including already-enqueued jobs" do
+    @bot.suspend!(reason: "failing_webhooks")
+
+    # Mention does not enqueue a job
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(@bot)} hello</div>"
+      )
+    end
+
+    # Joining a new room does not enqueue a job
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      rooms(:designers).memberships.grant_to(@bot)
+    end
+
+    # Even if a job was enqueued BEFORE suspension, performing it after suspension makes no HTTP request
+    @bot.reactivate!
+    mention = nil
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+      mention = @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(@bot)} queued</div>"
+      )
+    end
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+      rooms(:watercooler).memberships.grant_to(@bot)
+    end
+
+    @bot.suspend!(reason: "flooding")
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+    assert_not_requested :post, "https://bot.example.com/webhook"
+    assert_not_nil mention
+  end
+
+  test "webhook replies count toward flooding limit, are blocked during cooldown, and 5 attempts suspend the bot" do
+    freeze_time do
+      message = @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(@bot)} echo</div>"
+      )
+
+      WebMock.stub_request(:post, "https://bot.example.com/webhook")
+        .to_return(status: 200, body: "Webhook reply", headers: { "Content-Type" => "text/plain" })
+
+      # First 10 webhook replies are posted
+      assert_difference -> { @room.messages.count }, +10 do
+        10.times { @webhook.deliver(message) }
+      end
+      assert_not @bot.reload.in_bot_cooldown?
+      assert_not @bot.suspended?
+
+      # 11th webhook reply is rejected and starts a 30s cooldown
+      assert_no_difference -> { @room.messages.count } do
+        @webhook.deliver(message)
+      end
+      assert @bot.reload.in_bot_cooldown?
+      assert_not @bot.suspended?
+
+      # Non-reply 204 or blank 200 during cooldown does not count as a posting attempt
+      WebMock.stub_request(:post, "https://bot.example.com/webhook").to_return(status: 204)
+      @webhook.deliver(message)
+      WebMock.stub_request(:post, "https://bot.example.com/webhook")
+        .to_return(status: 200, body: "   ", headers: { "Content-Type" => "text/plain" })
+      @webhook.deliver(message)
+      assert_equal 0, @bot.reload.bot_cooldown_attempts
+
+      # 4 more reply attempts during cooldown are not posted and do not suspend yet
+      WebMock.stub_request(:post, "https://bot.example.com/webhook")
+        .to_return(status: 200, body: "<p>Still flooding</p>", headers: { "Content-Type" => "text/html" })
+      assert_no_difference -> { @room.messages.count } do
+        4.times { @webhook.deliver(message) }
+      end
+      assert_equal 4, @bot.reload.bot_cooldown_attempts
+      assert_not @bot.suspended?
+
+      # 5th reply attempt during cooldown suspends the bot and is not posted
+      assert_no_difference -> { @room.messages.count } do
+        @webhook.deliver(message)
+      end
+      assert @bot.reload.suspended?
+      assert_equal "flooding", @bot.suspension_reason
+
+      # Further deliveries skip HTTP completely because bot is suspended
+      WebMock.reset!
+      @webhook.deliver(message)
+      assert_not_requested :post, "https://bot.example.com/webhook"
+    end
+  end
+
+  test "reactivated bot receives webhooks and starts with a fresh failure counter" do
+    message = @room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} status</div>"
+    )
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook").to_return(status: 500)
+    10.times { @webhook.deliver(message) }
+    assert @bot.reload.suspended?
+
+    @bot.reactivate!
+    assert_not @bot.reload.suspended?
+    assert_equal 0, @bot.bot_webhook_failures
+
+    # One failure after reactivation does not immediately re-suspend
+    @webhook.deliver(message)
+    assert_not @bot.reload.suspended?
+    assert_equal 1, @bot.bot_webhook_failures
+
+    # Successful delivery works and posts reply
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(status: 200, body: "Back online!", headers: { "Content-Type" => "text/plain" })
+    assert_difference -> { @room.messages.count }, +1 do
+      @webhook.deliver(message)
+    end
+    assert_equal "Back online!", @room.messages.last.plain_text_body
+    assert_equal 0, @bot.reload.bot_webhook_failures
+  end
 end
