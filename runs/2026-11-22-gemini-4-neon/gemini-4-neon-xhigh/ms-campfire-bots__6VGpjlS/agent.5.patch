+
+test "posting over 10 messages in 10 seconds starts a 30s cooldown with 429 and Retry-After, and 5 attempts during cooldown suspend the bot" do
+  freeze_time do
+    assert_difference -> { @room.messages.count }, +10 do
+      10.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key),
+          params: "Message #{i + 1}",
+          headers: { "CONTENT_TYPE" => "text/plain" }
+        assert_response :created
+      end
+    end
+
+    # 11th message is rejected with 429 and Retry-After: 30
+    assert_no_difference -> { @room.messages.count } do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "Message 11",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+    assert_not @bot.reload.suspended?
+
+    # 4 more attempts during cooldown return 429 with decreasing Retry-After
+    [ 5, 5, 5, 5 ].each_with_index do |step, i|
+      travel step.seconds
+      assert_no_difference -> { @room.messages.count } do
+        post room_bot_messages_url(@room, @bot.bot_key),
+          params: "Cooldown spam #{i + 1}",
+          headers: { "CONTENT_TYPE" => "text/plain" }
+      end
+      assert_response :too_many_requests
+      assert_equal (30 - (i + 1) * 5).to_s, response.headers["Retry-After"]
+      assert_not @bot.reload.suspended?
+    end
+
+    # 5th attempt during the same cooldown suspends the bot and returns 403 Forbidden
+    assert_no_difference -> { @room.messages.count } do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "Final straw",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :forbidden
