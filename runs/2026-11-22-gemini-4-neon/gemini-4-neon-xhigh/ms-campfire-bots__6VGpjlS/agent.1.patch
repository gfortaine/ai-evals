+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+    @bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+    @room = rooms(:hq)
+  end
+
+  test "posting a raw text message creates message, returns 201 Created with Location header, and sets bot as author" do
+    assert_difference -> { @room.messages.count }, +1 do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "Deploy of v1.2.3 finished ✅",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+
+    message = @room.messages.last
+    assert_response :created
+    assert_equal message_path(message), response.headers["Location"]
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal @bot, message.creator
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+  end
+
+  test "raw request body is preserved without form-decoding or JSON wrapping" do
+    payload = "status=ok&percent=100% done + ready & deployed"
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: payload,
+      headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+
+    assert_response :created
+    assert_equal payload, @room.messages.last.plain_text_body
+  end
+
+  test "raw body works with text/plain and arbitrary content types including non-JSON application/json" do
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "Plain text notification",
+      headers: { "CONTENT_TYPE" => "text/plain; charset=utf-8" }
+    assert_response :created
+    assert_equal "Plain text notification", @room.messages.last.plain_text_body
+
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "{not valid json",
+      headers: { "CONTENT_TYPE" => "application/json" }
+    assert_response :created
+    assert_equal "{not valid json", @room.messages.last.plain_text_body
+  end
+
+  test "posting a file attachment via multipart creates attachment message and returns 201 Created" do
+    assert_difference -> { @room.messages.count }, +1 do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: { attachment: fixture_file_upload("earth.png", "image/png") }
+    end
+
+    message = @room.messages.last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal @bot, message.creator
+    assert message.attachment.attached?
+    assert_equal "earth.png", message.plain_text_body
+  end
+
+  test "broadcasts message to connected clients and unread rooms channel" do
+    assert_broadcasts UnreadRoomsChannel.stream_name_for(users(:david).id), 1 do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "Deploy of v1.2.3 finished ✅",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+
+    assert_response :created
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author strong", text: "Deploy Bot"
+      assert_select ".message__body", text: /Deploy of v1\.2\.3 finished ✅/
+    end
+  end
+
+  test "marks disconnected room members as unread and triggers push notifications just like human-authored messages" do
+    assert_enqueued_with(job: Room::PushMessageJob) do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "Deploy finished",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+
+    assert_response :created
+    assert memberships(:david_hq).reload.unread?
+
+    task_count = Push::Subscription.count
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      WebPush.expects(:payload_send).times(task_count)
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "Another deploy",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+    wait_for_pool_tasks(Rails.configuration.x.web_push_pool.delivery_pool, task_count)
+  end
+
+  test "bot message is indexed for full-text search" do
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "Release zeppelin-42 deployed",
+      headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+
+    assert_response :created
+    assert_equal [ @room.messages.last ], @room.messages.search("zeppelin")
+  end
+
+  test "returns 422 Unprocessable Content for empty body and no attachment" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key)
+    end
+    assert_response :unprocessable_content
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "   \n\t  ",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+    assert_response :unprocessable_content
+  end
+
+  test "returns 422 Unprocessable Content for multipart request without uploaded attachment" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: { other: "value" },
+        headers: { "CONTENT_TYPE" => "multipart/form-data" }
+    end
+    assert_response :unprocessable_content
+  end
+
+  test "returns 404 Not Found for bad room id" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url("999999", @bot.bot_key),
+        params: "Hello",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+    assert_response :not_found
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url("nonexistent.room", @bot.bot_key),
+        params: "Hello",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+    assert_response :not_found
+  end
+
+  test "returns 404 Not Found for closed room the bot is not a member of, and succeeds once added" do
+    closed_room = rooms(:designers)
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(closed_room, @bot.bot_key),
+        params: "Unauthorized room post",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+    assert_response :not_found
+
+    closed_room.memberships.grant_to(@bot)
+
+    assert_difference -> { closed_room.messages.count }, +1 do
+      post room_bot_messages_url(closed_room, @bot.bot_key),
+        params: "Now I am a member!",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+    assert_response :created
+
+    closed_room.memberships.revoke_from(@bot)
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(closed_room, @bot.bot_key),
+        params: "After removal",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+    assert_response :not_found
+  end
+
+  test "returns 401 Unauthorized for invalid bot code" do
+    [
+      "invalid",
+      "invalid.with.dots",
+      "#{@bot.id}-wrongtoken",
+      "#{users(:david).id}-#{@bot.bot_token}",
+      "999999-#{@bot.bot_token}"
+    ].each do |bad_key|
+      assert_no_difference -> { Message.count } do
+        post room_bot_messages_url(@room, bad_key),
+          params: "Hello",
+          headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+      end
+      assert_response :unauthorized, "Expected 401 for bot key #{bad_key.inspect}"
+    end
+  end
+
+  test "returns 401 Unauthorized before room lookup so room existence is not leaked" do
+    post room_bot_messages_url("999999", "bad-bot-key"),
+      params: "Hello",
+      headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+
+    assert_response :unauthorized
+  end
+
+  test "deleted bot can no longer post messages" do
+    bot_key = @bot.bot_key
+    @bot.deactivate
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, bot_key),
+        params: "Ghost message",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "allows non-browser and legacy user agents" do
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "From curl",
+      headers: {
+        "CONTENT_TYPE" => "application/x-www-form-urlencoded",
+        "HTTP_USER_AGENT" => "curl/8.5.0"
+      }
+    assert_response :created
+
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "From old UA",
+      headers: {
+        "CONTENT_TYPE" => "application/x-www-form-urlencoded",
+        "HTTP_USER_AGENT" => "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/114.0"
+      }
+    assert_response :created
+  end
+
+  test "bot message renders with bot name as author and sanitizes unsafe HTML" do
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "Deploy of v1.2.3 finished ✅ <script>alert(1)</script><a href=\"javascript:alert(1)\">link</a>",
+      headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    assert_response :created
+
+    sign_in :david
+    get room_url(@room)
+    assert_response :ok
+    assert_select ".message__author strong", text: "Deploy Bot"
+    assert_select ".message__body", text: /Deploy of v1\.2\.3 finished ✅/
+    assert_no_match /<script>/, response.body
+    assert_no_match /javascript:/, response.body
+  end
+
+  private
+    def wait_for_pool_tasks(pool, count)
+      start = Time.now
+      timeout = 1.0
+      while pool.completed_task_count < count
+        raise "Timeout waiting for pool tasks to complete" if Time.now - start > timeout
+        sleep 0.01
+      end
+    end
+end
