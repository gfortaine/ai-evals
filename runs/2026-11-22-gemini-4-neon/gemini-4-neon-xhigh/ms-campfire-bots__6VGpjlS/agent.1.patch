diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..a1bb37d
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,59 @@
+class Bots::MessagesController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  before_action :authenticate_bot
+  before_action :set_room
+
+  def create
+    if attachment_param.present?
+      @message = @room.messages.create_with_attachment!(attachment: attachment_param)
+    elsif text_body.present?
+      @message = @room.messages.create!(body: text_body)
+    else
+      return head :unprocessable_content
+    end
+
+    @message.broadcast_create
+    head :created, location: message_path(@message)
+  end
+
+  private
+    def process_action(*)
+      request.request_parameters = {} unless request.media_type == "multipart/form-data"
+      super
+    end
+
+    def allow_browser(**)
+      # Bot API clients (curl, shell scripts, CI jobs) are not web browsers.
+    end
+
+    def authenticate_bot
+      if bot = User.authenticate_bot(params[:bot_key])
+        Current.user = bot
+      else
+        head :unauthorized
+      end
+    end
+
+    def set_room
+      @room = Current.user.rooms.find(params[:room_id])
+    rescue ActiveRecord::RecordNotFound
+      head :not_found
+    end
+
+    def attachment_param
+      if request.media_type == "multipart/form-data" && params[:attachment].is_a?(ActionDispatch::Http::UploadedFile)
+        params[:attachment]
+      end
+    end
+
+    def text_body
+      return nil if request.media_type == "multipart/form-data"
+
+      raw = request.raw_post.dup.force_encoding(Encoding::UTF_8).scrub
+      raw if raw.present?
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..2dc0837
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,54 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+  before_action :ensure_can_administer, only: %i[ edit update destroy ]
+
+  def index
+    response.cache_control.replace(no_store: true)
+    @bots = User.bots_visible_to(Current.user).with_attached_avatar.ordered
+  end
+
+  def new
+    @bot = User.new(role: :bot)
+  end
+
+  def create
+    @bot = User.new(bot_params.merge(role: :bot, creator: Current.user))
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url
+  end
+
+  private
+    def set_bot
+      @bot = User.active.bot.find(params[:id])
+    end
+
+    def ensure_can_administer
+      head :forbidden unless Current.user.can_administer?(@bot)
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar).tap do |permitted|
+        permitted.delete(:avatar) if permitted[:avatar].blank?
+      end
+    end
+end
