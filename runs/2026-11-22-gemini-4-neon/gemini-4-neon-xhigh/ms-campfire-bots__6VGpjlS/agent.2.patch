+    assert_equal "application/json", received_content_type
+    assert_equal "mention", received_body["event"]
+    assert_equal users(:david).id, received_body["author"]["id"]
+    assert_equal "David", received_body["author"]["name"]
+    assert_equal @room.id, received_body["room"]["id"]
+    assert_equal "HQ", received_body["room"]["name"]
+    assert_equal "/rooms/#{@room.id}/#{@bot.bot_key}/messages", received_body["room"]["reply_to"]
+    assert_equal message.id, received_body["message"]["id"]
+    assert_equal "restart the build please", received_body["message"]["body"]["text"]
+    assert_equal message.body.body.to_html, received_body["message"]["body"]["html"]
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", received_body["message"]["link"]
+
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal "Restarting build #42 ✅\nCheck <logs> & status", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "&lt;logs&gt;"
+    assert_includes reply.body.body.to_html, "<br>"
+
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author strong", text: "Deploy Bot"
+      assert_select ".message__body", text: /Restarting build #42 ✅/
+    end
+  end
+
+  test "deliver creates and broadcasts rich HTML bot message on 200 text/html" do
+    message = @room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} status</div>"
+    )
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(
+        status: 200,
+        body: "<p>Build <strong>#42</strong> is <em>green</em></p>",
+        headers: { "Content-Type" => "text/html; charset=utf-8" }
+      )
+
+    assert_difference -> { @room.messages.count }, +1 do
+      @webhook.deliver(message)
+    end
+
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal "Build #42 is green", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "<strong>#42</strong>"
+
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author strong", text: "Deploy Bot"
+      assert_select ".message__body strong", text: "#42"
+    end
+  end
+
+  test "deliver handles non-UTF-8 response charsets cleanly" do
+    message = @room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} coffee</div>"
+    )
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
