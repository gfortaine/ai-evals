+      { status: 202, body: "accepted", headers: { "Content-Type" => "text/plain" } },
+      { status: 302, body: "redirect", headers: { "Location" => "https://other.example.com", "Content-Type" => "text/plain" } },
+      { status: 404, body: "not found", headers: { "Content-Type" => "text/plain" } },
+      { status: 500, body: "boom", headers: { "Content-Type" => "text/plain" } }
+    ]
+
+    responses.each do |response|
+      WebMock.stub_request(:post, "https://bot.example.com/webhook").to_return(**response)
+
+      assert_no_difference -> { @room.messages.count }, "Expected no message for #{response.inspect}" do
+        @webhook.deliver(message)
+      end
+    end
+  end
+
+  test "deliver ignores oversized response bodies" do
+    message = @room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} huge</div>"
+    )
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(
+        status: 200,
+        body: "a" * (Webhook::MAX_RESPONSE_BODY_SIZE + 1),
+        headers: { "Content-Type" => "text/plain" }
+      )
+
+    assert_no_difference -> { @room.messages.count } do
+      @webhook.deliver(message)
+    end
+  end
+
+  test "deliver rescues network errors and timeouts without raising or posting" do
+    message = @room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} timeout</div>"
+    )
+
+    [ Net::OpenTimeout, Net::ReadTimeout, Errno::ECONNREFUSED, SocketError ].each do |error_class|
+      WebMock.stub_request(:post, "https://bot.example.com/webhook").to_raise(error_class)
+
+      assert_no_difference -> { @room.messages.count } do
+        assert_nothing_raised do
+          @webhook.deliver(message)
+        end
+      end
+    end
+  end
+
+  test "deliver skips HTTP request if bot was deactivated or removed from the room before delivery" do
+    closed_room = rooms(:designers)
+    closed_room.memberships.grant_to(@bot)
+    message = closed_room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} hello</div>"
+    )
+
+    closed_room.memberships.revoke_from(@bot)
+
+    assert_no_difference -> { Message.count } do
+      @webhook.deliver(message)
+    end
+    assert_not_requested :post, "https://bot.example.com/webhook"
+
+    open_message = @room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} hello</div>"
+    )
+    @bot.update!(status: :deactivated)
+
+    assert_no_difference -> { Message.count } do
+      @webhook.deliver(open_message)
+    end
+    assert_not_requested :post, "https://bot.example.com/webhook"
+  end
+
+  test "synchronous bot reply echoing mention HTML does not enqueue another webhook job" do
+    message = @room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} echo</div>"
+    )
+
+    WebMock.stub_request(:post, "https://bot.example.com/webhook")
+      .to_return(
+        status: 200,
+        body: message.body.body.to_html,
+        headers: { "Content-Type" => "text/html" }
+      )
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_difference -> { @room.messages.count }, +1 do
+        @webhook.deliver(message)
+      end
+    end
+  end
+
+  test "deliver preserves query string on webhook URL" do
+    @bot.update!(webhook_url: "https://bot.example.com/webhook?secret=xyz&v=2")
+    message = @room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} hi</div>"
+    )
+
+    stub = WebMock.stub_request(:post, "https://bot.example.com/webhook?secret=xyz&v=2")
+      .to_return(status: 204)
+
+    @bot.webhook.deliver(message)
+    assert_requested stub
+  end
+end
