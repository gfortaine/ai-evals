diff --git a/app/models/webhook.rb b/app/models/webhook.rb
new file mode 100644
index 0000000..9be75fa
--- /dev/null
+++ b/app/models/webhook.rb
@@ -0,0 +1,153 @@
+require "net/http"
+
+class Webhook < ApplicationRecord
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+  MAX_RESPONSE_BODY_SIZE = 1.megabyte
+  ALLOWED_REPLY_CONTENT_TYPES = %w[ text/plain text/html ].freeze
+  USER_AGENT = "campfire/webhook"
+
+  NETWORK_ERRORS = [
+    Timeout::Error,
+    Net::ProtocolError,
+    SocketError,
+    SystemCallError,
+    IOError,
+    OpenSSL::SSL::SSLError,
+    URI::InvalidURIError,
+    Zlib::Error
+  ].freeze
+
+  belongs_to :user, inverse_of: :webhook
+
+  normalizes :url, with: ->(url) { url.strip }
+
+  validates :url, presence: true
+  validate :url_must_be_valid_http
+  validate :user_must_be_bot
+
+  def deliver_later(message)
+    Webhook::DeliveryJob.perform_later(self, message)
+  end
+
+  def deliver(message)
+    return unless deliverable_for?(message)
+
+    content_type, body = post(payload_for(message))
+    post_reply(message.room, content_type, body) if body.present?
+  rescue *NETWORK_ERRORS => error
+    Rails.logger.warn "Webhook##{id} delivery failed for Message##{message.id}: #{error.class} #{error.message}"
+  end
+
+  def payload_for(message)
+    routes = Rails.application.routes.url_helpers
+    room = message.room
+
+    {
+      event: "mention",
+      author: {
+        id: message.creator.id,
+        name: message.creator.name
+      },
+      room: {
+        id: room.id,
+        name: room.name,
+        reply_to: routes.room_bot_messages_path(room, user.bot_key)
+      },
+      message: {
+        id: message.id,
+        body: {
+          text: message.plain_text_body_without_mention(user),
+          html: message.body.body&.to_html.to_s
+        },
+        link: routes.room_at_message_path(room, message)
+      }
+    }
+  end
+
+  private
+    def url_must_be_valid_http
+      return if url.blank?
+
+      uri = URI.parse(url)
+      unless uri.is_a?(URI::HTTP) && uri.host.present? && (uri.port.nil? || (1..65535).cover?(uri.port))
+        errors.add :url, "must be a valid HTTP or HTTPS URL"
+      end
+    rescue URI::InvalidURIError
+      errors.add :url, "must be a valid HTTP or HTTPS URL"
+    end
+
+    def user_must_be_bot
+      errors.add :user, "must be a bot" unless user&.bot?
+    end
+
+    def deliverable_for?(message)
+      user.active? && user.bot? && user.bot_key.present? && !message.creator.bot? && message.room.users.exists?(user.id)
+    end
+
+    def post(payload)
+      uri = URI.parse(url)
+      request = Net::HTTP::Post.new(uri)
+      request["Content-Type"] = "application/json"
+      request["User-Agent"] = USER_AGENT
+      request.basic_auth(URI.decode_www_form_component(uri.user), URI.decode_www_form_component(uri.password.to_s)) if uri.user
+      request.body = payload.to_json
+
+      Net::HTTP.start(
+        uri.hostname,
+        uri.port,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT
+      ) do |http|
+        http.request(request) do |response|
+          return extract_reply(response)
+        end
+      end
+    end
+
+    def extract_reply(response)
+      return nil unless response.is_a?(Net::HTTPOK)
+
+      content_type = response.content_type&.downcase
+      return nil unless content_type.in?(ALLOWED_REPLY_CONTENT_TYPES)
+      return nil if response.content_length.to_i > MAX_RESPONSE_BODY_SIZE
+
+      raw_body = read_size_limited_body(response)
+      return nil if raw_body.nil?
+
+      [ content_type, decode_body(raw_body, response.type_params["charset"]) ]
+    end
+
+    def read_size_limited_body(response)
+      body = String.new(encoding: Encoding::BINARY)
+      response.read_body do |chunk|
+        return nil if body.bytesize + chunk.bytesize > MAX_RESPONSE_BODY_SIZE
+        body << chunk.b
+      end
+      body
+    end
+
+    def decode_body(raw_body, charset)
+      encoding = charset.present? ? Encoding.find(charset) : Encoding::UTF_8
+      if encoding == Encoding::UTF_8
+        raw_body.dup.force_encoding(Encoding::UTF_8).scrub
+      else
+        raw_body.dup.force_encoding(encoding).encode(Encoding::UTF_8, invalid: :replace, undef: :replace).scrub
+      end
+    rescue ArgumentError
+      raw_body.dup.force_encoding(Encoding::UTF_8).scrub
+    end
+
+    def post_reply(room, content_type, body)
+      formatted_body = case content_type
+      when "text/plain"
+        ERB::Util.html_escape(body).gsub(/\r\n?|\n/, "<br>")
+      when "text/html"
+        body
+      end
+
+      reply = room.messages.create!(body: formatted_body, creator: user)
+      reply.broadcast_create
+    end
+end
