+require "test_helper"
+
+class WebhookTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper, ActionDispatch::Assertions::SelectorAssertions
+
+  setup do
+    @bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin), webhook_url: "https://bot.example.com/webhook")
+    @webhook = @bot.webhook
+    @room = rooms(:hq)
+  end
+
+  test "accepts valid HTTP and HTTPS webhook URLs including localhost and private IPs" do
+    valid_urls = [
+      "https://bot.example.com/webhook",
+      "http://127.0.0.1:4567/hook",
+      "http://localhost:3000/bot",
+      "http://[::1]:8080/callback",
+      "http://192.168.1.50:9000/events?token=abc",
+      "https://bot.example.com"
+    ]
+
+    valid_urls.each do |url|
+      webhook = Webhook.new(user: @bot, url: url)
+      assert webhook.valid?, "Expected #{url.inspect} to be valid, got: #{webhook.errors.full_messages}"
+    end
+  end
+
+  test "rejects blank, malformed, and non-HTTP webhook URLs" do
+    invalid_urls = [
+      "",
+      "   ",
+      "not-a-url",
+      "example.com/hook",
+      "ftp://example.com/hook",
+      "javascript:alert(1)",
+      "file:///etc/passwd",
+      "http://",
+      "https://",
+      "http:///path",
+      "http://example.com:999999/hook",
+      "http://exa mple.com/hook"
+    ]
+
+    invalid_urls.each do |url|
+      webhook = Webhook.new(user: @bot, url: url)
+      assert_not webhook.valid?, "Expected #{url.inspect} to be invalid"
+    end
+  end
+
+  test "rejects webhooks attached to non-bot users" do
+    webhook = Webhook.new(user: users(:david), url: "https://bot.example.com/webhook")
+    assert_not webhook.valid?
+    assert_includes webhook.errors[:user], "must be a bot"
+  end
+
+  test "normalizes whitespace around URL" do
+    webhook = Webhook.new(user: @bot, url: "  https://bot.example.com/hook  ")
+    assert_equal "https://bot.example.com/hook", webhook.url
+  end
+
+  test "payload_for matches the webhook JSON contract with bot mention stripped from text" do
+    message = @room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)}&nbsp;restart the <strong>build</strong> please</div>"
+    )
+
+    payload = @webhook.payload_for(message)
+
+    assert_equal "mention", payload[:event]
+    assert_equal({ id: users(:david).id, name: "David" }, payload[:author])
+    assert_equal({
+      id: @room.id,
+      name: "HQ",
+      reply_to: "/rooms/#{@room.id}/#{@bot.bot_key}/messages"
+    }, payload[:room])
+    assert_equal message.id, payload[:message][:id]
+    assert_equal "restart the build please", payload[:message][:body][:text]
+    assert_equal message.body.body.to_html, payload[:message][:body][:html]
+    assert_includes payload[:message][:body][:html], "<strong>build</strong>"
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", payload[:message][:link]
+  end
+
+  test "payload_for strips only the target bot's own mention when multiple users or bots are mentioned" do
+    other_bot = User.create_bot!(name: "Audit Bot", creator: users(:kevin), webhook_url: "https://audit.example.com/hook")
+    message = @room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} #{mention_attachment_for(other_bot)} #{mention_attachment_for(:kevin)} check deploy</div>"
+    )
+
+    deploy_payload = @bot.webhook.payload_for(message)
+    audit_payload = other_bot.webhook.payload_for(message)
+
+    assert_equal "@Audit Bot @Kevin check deploy", deploy_payload[:message][:body][:text]
+    assert_equal "@Deploy Bot @Kevin check deploy", audit_payload[:message][:body][:text]
+    assert_equal "/rooms/#{@room.id}/#{@bot.bot_key}/messages", deploy_payload[:room][:reply_to]
+    assert_equal "/rooms/#{@room.id}/#{other_bot.bot_key}/messages", audit_payload[:room][:reply_to]
+  end
+
+  test "deliver posts application/json payload and creates and broadcasts bot message on 200 text/plain" do
+    message = @room.messages.create!(
+      creator: users(:david),
