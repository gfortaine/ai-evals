+        params: { attachment: fixture_file_upload("earth.png", "image/png") }
+    end
+
+    message = @room.messages.last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal @bot, message.creator
+    assert message.attachment.attached?
+    assert_equal "earth.png", message.plain_text_body
+  end
+
+  test "broadcasts message to connected clients and unread rooms channel" do
+    assert_broadcasts UnreadRoomsChannel.stream_name_for(users(:david).id), 1 do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "Deploy of v1.2.3 finished ✅",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+
+    assert_response :created
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author strong", text: "Deploy Bot"
+      assert_select ".message__body", text: /Deploy of v1\.2\.3 finished ✅/
+    end
+  end
+
+  test "marks disconnected room members as unread and triggers push notifications just like human-authored messages" do
+    assert_enqueued_with(job: Room::PushMessageJob) do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "Deploy finished",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+
+    assert_response :created
+    assert memberships(:david_hq).reload.unread?
+
+    task_count = Push::Subscription.count
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      WebPush.expects(:payload_send).times(task_count)
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "Another deploy",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+    wait_for_pool_tasks(Rails.configuration.x.web_push_pool.delivery_pool, task_count)
