+      <% if bot.webhook_url.present? %>
+        <div class="txt-small txt-subtle overflow-ellipsis"><%= bot.webhook_url %></div>
+      <% end %>
+    </div>
+
+    <hr class="separator" aria-hidden="true">
+
+    <%= link_to edit_bot_path(bot), class: "btn txt-small flex-item-no-shrink", aria: { label: "Edit #{bot.name}" } do %>
+      <%= image_tag "pencil.svg", size: 20, aria: { hidden: "true" } %>
+      <span class="for-screen-reader">Edit <%= bot.name %></span>
+    <% end %>
+  </div>
+
+  <% if bot.suspended? %>
+    <div class="flex align-center justify-space-between gap txt-small txt-align-start">
+      <div class="flex align-center gap-half flex-wrap txt-negative" role="status">
+        <strong>Suspended</strong>
+        <span aria-hidden="true">&middot;</span>
+        <span><%= bot.suspension_reason_description %></span>
+      </div>
+
+      <% if Current.user.administrator? %>
+        <%= button_to bot_suspension_path(bot), method: :delete,
+              class: "btn btn--reversed txt-small flex-item-no-shrink",
+              data: { turbo_confirm: "Are you sure you want to reactivate #{bot.name}?" } do %>
+          <%= image_tag "refresh.svg", size: 16, aria: { hidden: "true" } %>
+          <span>Reactivate</span>
+        <% end %>
+      <% end %>
+    </div>
+  <% end %>
+
+  <div class="flex align-center gap">
+    <label for="<%= dom_id(bot, :code) %>" class="txt-small txt-subtle txt-nowrap flex-item-no-shrink">Bot code</label>
+    <input type="text"
+           id="<%= dom_id(bot, :code) %>"
+           class="input input--code txt-small flex-item-grow min-width fill-white"
+           value="<%= bot.bot_key %>"
+           autocomplete="off"
+           spellcheck="false"
