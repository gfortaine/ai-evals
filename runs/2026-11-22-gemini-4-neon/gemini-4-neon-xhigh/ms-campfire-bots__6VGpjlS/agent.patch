diff --git a/app/models/user/bot.rb b/app/models/user/bot.rb
new file mode 100644
index 0000000..99ffeb8
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,241 @@
+module User::Bot
+  extend ActiveSupport::Concern
+
+  BOT_TOKEN_LENGTH = 24
+  BOT_RATE_LIMIT_MAX_MESSAGES = 10
+  BOT_RATE_LIMIT_WINDOW = 10.seconds
+  BOT_COOLDOWN_DURATION = 30.seconds
+  BOT_COOLDOWN_SUSPENSION_ATTEMPTS = 5
+  BOT_WEBHOOK_FAILURE_SUSPENSION_THRESHOLD = 10
+
+  BOT_SUSPENSION_REASONS = {
+    "flooding" => "Flooding (exceeded message rate limit during cooldown)",
+    "failing_webhooks" => "Failing webhooks (10 consecutive failed deliveries)"
+  }.freeze
+
+  included do
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :created_bots, -> { bot }, class_name: "User", foreign_key: :creator_id, inverse_of: :creator
+    has_one :webhook, dependent: :destroy, autosave: true, inverse_of: :user
+
+    scope :without_bots, -> { where.not(role: :bot) }
+    scope :auto_joining_open_rooms, -> { where(add_to_all_open_rooms: true) }
+    scope :suspended, -> { where.not(suspended_at: nil) }
+    scope :not_suspended, -> { where(suspended_at: nil) }
+    scope :bots_visible_to, ->(user) { user.administrator? ? active.bot : active.bot.where(creator: user) }
+
+    validate :creator_within_bot_limit, on: :create, if: :bot?
+
+    before_create :ensure_bot_token, if: :bot?
+  end
+
+  class_methods do
+    def create_bot!(attributes)
+      create!(attributes.with_defaults(creator: Current.user).merge(role: :bot))
+    end
+
+    def authenticate_bot(bot_key)
+      return nil if bot_key.blank?
+
+      id, token = bot_key.to_s.split("-", 2)
+      return nil if id.blank? || token.blank? || !id.match?(/\A\d+\z/)
+
+      if bot = active.bot.find_by(id: id)
+        bot if bot.bot_token.present? && ActiveSupport::SecurityUtils.secure_compare(bot.bot_token, token)
+      end
+    end
+  end
+
+  def can_create_bots?
+    !bot_limit_reached?
+  end
+
+  def bot_limit_reached?
+    return false if administrator?
+
+    limit = Current.account&.settings&.bots_per_member
+    return false if limit.nil?
+
+    created_bots.active.count >= limit
+  end
+
+  def bot_key
+    "#{id}-#{bot_token}" if bot? && bot_token.present?
+  end
+
+  def reset_bot_token
+    update!(bot_token: generate_bot_token)
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def suspension_reason_description
+    BOT_SUSPENSION_REASONS[suspension_reason] || suspension_reason
+  end
+
+  def in_bot_cooldown?(now = Time.current)
+    bot_cooldown_until.present? && now < bot_cooldown_until
+  end
+
+  def bot_cooldown_retry_after(now = Time.current)
+    [ (bot_cooldown_until - now).ceil, 1 ].max if in_bot_cooldown?(now)
+  end
+
+  def reserve_bot_post!(now: Time.current)
+    now = now.change(usec: now.usec)
+    now_usec = now.to_i * 1_000_000 + now.usec
+    window_usec = (BOT_RATE_LIMIT_WINDOW * 1_000_000).to_i
+
+    transaction do
+      reload
+      return [ :inactive, nil ] unless active? && bot?
+      return [ :suspended, nil ] if suspended?
+
+      if bot_cooldown_until.present? && now < bot_cooldown_until
+        attempts = bot_cooldown_attempts + 1
+        if attempts >= BOT_COOLDOWN_SUSPENSION_ATTEMPTS
+          update_columns(
+            suspended_at: now,
+            suspension_reason: "flooding",
+            bot_cooldown_until: nil,
+            bot_cooldown_attempts: attempts,
+            updated_at: now
+          )
+          return [ :suspended, nil ]
+        else
+          update_columns(bot_cooldown_attempts: attempts)
+          retry_after = [ (bot_cooldown_until - now).ceil, 1 ].max
+          return [ :cooldown, retry_after ]
+        end
+      end
+
+      recent = Array(bot_post_timestamps).select { |ts| (now_usec - ts) < window_usec }
+
+      if recent.size >= BOT_RATE_LIMIT_MAX_MESSAGES
+        cooldown_until = now + BOT_COOLDOWN_DURATION
+        update_columns(
+          bot_cooldown_until: cooldown_until,
+          bot_cooldown_attempts: 0,
+          bot_post_timestamps: recent
+        )
+        retry_after = [ (cooldown_until - now).ceil, 1 ].max
+        return [ :cooldown, retry_after ]
+      end
+
+      recent << now_usec
+      update_columns(
+        bot_cooldown_until: nil,
+        bot_cooldown_attempts: 0,
+        bot_post_timestamps: recent
+      )
+      [ :allowed, nil ]
+    end
+  end
+
+  def record_webhook_success!
+    transaction do
+      reload
+      return unless active? && bot? && !suspended?
+      return if bot_webhook_failures.zero?
+
+      update_columns(bot_webhook_failures: 0)
+    end
+  end
+
+  def record_webhook_failure!(now: Time.current)
+    now = now.change(usec: now.usec)
+
+    transaction do
+      reload
+      return unless active? && bot? && !suspended?
+
+      failures = bot_webhook_failures + 1
+      if failures >= BOT_WEBHOOK_FAILURE_SUSPENSION_THRESHOLD
+        update_columns(
+          bot_webhook_failures: failures,
+          suspended_at: now,
+          suspension_reason: "failing_webhooks",
+          bot_cooldown_until: nil,
+          updated_at: now
+        )
+      else
+        update_columns(bot_webhook_failures: failures)
+      end
+    end
+  end
+
+  def suspend!(reason:, now: Time.current)
+    raise ArgumentError, "Only bots can be suspended" unless bot?
+    now = now.change(usec: now.usec)
+
+    transaction do
+      reload
+      return unless active?
+
+      update_columns(
+        suspended_at: now,
+        suspension_reason: reason.to_s,
+        bot_cooldown_until: nil,
+        updated_at: now
+      )
+    end
+  end
+
+  def reactivate!
+    raise ArgumentError, "Only bots can be reactivated" unless bot?
+
+    transaction do
+      reload
+      return unless active?
+
+      update_columns(
+        suspended_at: nil,
+        suspension_reason: nil,
+        bot_cooldown_until: nil,
+        bot_cooldown_attempts: 0,
+        bot_post_timestamps: [],
+        bot_webhook_failures: 0,
+        updated_at: Time.current
+      )
+    end
+  end
+
+  def webhook_url
+    webhook.url if webhook.present? && !webhook.marked_for_destruction? && !webhook.destroyed?
+  end
+
+  def webhook_url=(url)
+    normalized = url.to_s.strip
+
+    if normalized.blank?
+      if webhook&.persisted?
+        webhook.mark_for_destruction
+      else
+        self.webhook = nil
+      end
+    elsif webhook.present? && !webhook.destroyed?
+      webhook.reload if webhook.marked_for_destruction?
+      webhook.url = normalized
+    else
+      build_webhook(url: normalized)
+    end
+  end
+
+  private
+    def creator_within_bot_limit
+      if creator&.bot_limit_reached?
+        limit = Current.account.settings.bots_per_member
+        errors.add(:base, :bot_limit_reached, message: "You've reached the limit of #{limit} #{"chat bot".pluralize(limit)}")
+      end
+    end
+
+    def ensure_bot_token
+      self.bot_token ||= generate_bot_token
+    end
+
+    def generate_bot_token
+      SecureRandom.base58(BOT_TOKEN_LENGTH)
+    end
+end
