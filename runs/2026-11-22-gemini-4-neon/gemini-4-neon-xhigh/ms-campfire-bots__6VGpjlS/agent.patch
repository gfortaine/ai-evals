+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+    @bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin))
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+  end
+
+  test "posting a raw text message creates message, returns 201 Created with Location header, and sets bot as author" do
+    assert_difference -> { @room.messages.count }, +1 do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "Deploy of v1.2.3 finished ✅",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+
+    message = @room.messages.last
+    assert_response :created
+    assert_equal message_path(message), response.headers["Location"]
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal @bot, message.creator
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+  end
+
+  test "raw request body is preserved without form-decoding or JSON wrapping" do
+    payload = "status=ok&percent=100% done + ready & deployed"
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: payload,
+      headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+
+    assert_response :created
+    assert_equal payload, @room.messages.last.plain_text_body
+  end
+
+  test "raw body works with text/plain and arbitrary content types including non-JSON application/json" do
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "Plain text notification",
+      headers: { "CONTENT_TYPE" => "text/plain; charset=utf-8" }
+    assert_response :created
+    assert_equal "Plain text notification", @room.messages.last.plain_text_body
+
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "{not valid json",
+      headers: { "CONTENT_TYPE" => "application/json" }
+    assert_response :created
+    assert_equal "{not valid json", @room.messages.last.plain_text_body
+  end
+
+  test "posting a file attachment via multipart creates attachment message and returns 201 Created" do
+    assert_difference -> { @room.messages.count }, +1 do
