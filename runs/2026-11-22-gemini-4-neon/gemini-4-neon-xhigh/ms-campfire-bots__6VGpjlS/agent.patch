+      params: "Now a member of Pets!",
+      headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+  end
+  assert_response :created
+end
+
+  test "returns 404 Not Found for closed room the bot is not a member of, and succeeds once added" do
+    closed_room = rooms(:designers)
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(closed_room, @bot.bot_key),
+        params: "Unauthorized room post",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+    assert_response :not_found
+
+    closed_room.memberships.grant_to(@bot)
+
+    assert_difference -> { closed_room.messages.count }, +1 do
+      post room_bot_messages_url(closed_room, @bot.bot_key),
+        params: "Now I am a member!",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+    assert_response :created
+
+    closed_room.memberships.revoke_from(@bot)
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(closed_room, @bot.bot_key),
+        params: "After removal",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+    assert_response :not_found
+  end
+
+  test "returns 401 Unauthorized for invalid bot code" do
+    [
+      "invalid",
+      "invalid.with.dots",
+      "#{@bot.id}-wrongtoken",
+      "#{users(:david).id}-#{@bot.bot_token}",
+      "999999-#{@bot.bot_token}"
+    ].each do |bad_key|
+      assert_no_difference -> { Message.count } do
+        post room_bot_messages_url(@room, bad_key),
+          params: "Hello",
+          headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+      end
+      assert_response :unauthorized, "Expected 401 for bot key #{bad_key.inspect}"
+    end
+  end
+
+  test "returns 401 Unauthorized before room lookup so room existence is not leaked" do
+    post room_bot_messages_url("999999", "bad-bot-key"),
+      params: "Hello",
+      headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+
+    assert_response :unauthorized
+  end
+
+  test "deleted bot can no longer post messages" do
+    bot_key = @bot.bot_key
+    @bot.deactivate
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, bot_key),
+        params: "Ghost message",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "allows non-browser and legacy user agents" do
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "From curl",
+      headers: {
+        "CONTENT_TYPE" => "application/x-www-form-urlencoded",
+        "HTTP_USER_AGENT" => "curl/8.5.0"
+      }
+    assert_response :created
+
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "From old UA",
+      headers: {
+        "CONTENT_TYPE" => "application/x-www-form-urlencoded",
+        "HTTP_USER_AGENT" => "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/114.0"
+      }
+    assert_response :created
+  end
+
+  test "bot message renders with bot name as author and sanitizes unsafe HTML" do
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "Deploy of v1.2.3 finished ✅ <script>alert(1)</script><a href=\"javascript:alert(1)\">link</a>",
+      headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    assert_response :created
+
+    sign_in :david
+    get room_url(@room)
+    assert_response :ok
+    assert_select ".message__author strong", text: "Deploy Bot"
+    assert_select ".message__body", text: /Deploy of v1\.2\.3 finished ✅/
+    assert_no_match /<script>/, response.body
+    assert_no_match /javascript:/, response.body
+  end
+
+
+test "posting over 10 messages in 10 seconds starts a 30s cooldown with 429 and Retry-After, and 5 attempts during cooldown suspend the bot" do
+  freeze_time do
+    assert_difference -> { @room.messages.count }, +10 do
+      10.times do |i|
+        post room_bot_messages_url(@room, @bot.bot_key),
+          params: "Message #{i + 1}",
+          headers: { "CONTENT_TYPE" => "text/plain" }
+        assert_response :created
+      end
+    end
+
+    # 11th message is rejected with 429 and Retry-After: 30
+    assert_no_difference -> { @room.messages.count } do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "Message 11",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+    assert_not @bot.reload.suspended?
+
+    # 4 more attempts during cooldown return 429 with decreasing Retry-After
+    [ 5, 5, 5, 5 ].each_with_index do |step, i|
+      travel step.seconds
+      assert_no_difference -> { @room.messages.count } do
+        post room_bot_messages_url(@room, @bot.bot_key),
+          params: "Cooldown spam #{i + 1}",
+          headers: { "CONTENT_TYPE" => "text/plain" }
+      end
+      assert_response :too_many_requests
+      assert_equal (30 - (i + 1) * 5).to_s, response.headers["Retry-After"]
+      assert_not @bot.reload.suspended?
+    end
+
+    # 5th attempt during the same cooldown suspends the bot and returns 403 Forbidden
+    assert_no_difference -> { @room.messages.count } do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "Final straw",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :forbidden
+    assert_nil response.headers["Retry-After"]
+    assert @bot.reload.suspended?
+    assert_equal "flooding", @bot.suspension_reason
+
+    # Further posts from suspended bot continue to return 403 Forbidden
+    assert_no_difference -> { @room.messages.count } do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "While suspended",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :forbidden
+  end
+end
+
+test "API messages and webhook replies share the same 10-message limit and cooldown suspension counter" do
+  freeze_time do
+    @bot.update!(webhook_url: "https://bot.example.com/hook")
+    mention = @room.messages.create!(
+      creator: users(:david),
+      body: "<div>#{mention_attachment_for(@bot)} ping</div>"
+    )
+    WebMock.stub_request(:post, "https://bot.example.com/hook")
+      .to_return(status: 200, body: "Webhook reply", headers: { "Content-Type" => "text/plain" })
+
+    # 6 via API + 4 via webhook replies = 10 messages
+    6.times do |i|
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "API #{i + 1}",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :created
+    end
+    assert_difference -> { @room.messages.count }, +4 do
+      4.times { @bot.webhook.deliver(mention) }
+    end
+
+    # 11th message via API hits cooldown
+    assert_no_difference -> { @room.messages.count } do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "API 11th",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+
+    # 2 webhook reply attempts + 2 API attempts during cooldown = 4 attempts (still not suspended)
+    assert_no_difference -> { @room.messages.count } do
+      2.times { @bot.webhook.deliver(mention) }
+      2.times do
+        post room_bot_messages_url(@room, @bot.bot_key),
+          params: "API cooldown",
+          headers: { "CONTENT_TYPE" => "text/plain" }
+        assert_response :too_many_requests
+      end
+    end
+    assert_not @bot.reload.suspended?
+
+    # 5th attempt via webhook reply suspends the bot
+    assert_no_difference -> { @room.messages.count } do
+      @bot.webhook.deliver(mention)
+    end
+    assert @bot.reload.suspended?
+    assert_equal "flooding", @bot.suspension_reason
+
+    # API now returns 403 Forbidden
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "Blocked",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :forbidden
+  end
+end
+
+test "posting succeeds again after cooldown expires, and rate limit applies across rooms and attachments" do
+  freeze_time do
+    other_room = rooms(:pets)
+    other_room.memberships.grant_to(@bot)
+
+    5.times do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "Room 1",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :created
+    end
+
+    4.times do
+      post room_bot_messages_url(other_room, @bot.bot_key),
+        params: "Room 2",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :created
+    end
+
+    # 10th message is an attachment
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: { attachment: fixture_file_upload("earth.png", "image/png") }
+    assert_response :created
+
+    # Blank (422) and unauthorized room (404) do not trigger cooldown
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "   ",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :unprocessable_content
+    assert_not @bot.reload.in_bot_cooldown?
+
+    post room_bot_messages_url(rooms(:designers), @bot.bot_key),
+      params: "Not a member",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :not_found
+    assert_not @bot.reload.in_bot_cooldown?
+
+    # 11th valid message (attachment) trips cooldown
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: { attachment: fixture_file_upload("earth.png", "image/png") }
+    end
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+
+    # After 30 seconds, posting succeeds again
+    travel 30.seconds
+    assert_difference -> { @room.messages.count }, +1 do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "Back after cooldown",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :created
+  end
+end
+
+test "suspended bot gets 403 Forbidden while invalid bot key still gets 401 Unauthorized, and reactivated bot gets 201" do
+  @bot.suspend!(reason: "failing_webhooks")
+
+  assert_no_difference -> { Message.count } do
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "Hello",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+  end
+  assert_response :forbidden
+
+  # Invalid bot key for a suspended bot still returns 401 (does not leak suspended status)
+  post room_bot_messages_url(@room, "#{@bot.id}-wrongtoken"),
+    params: "Hello",
+    headers: { "CONTENT_TYPE" => "text/plain" }
+  assert_response :unauthorized
+
+  # Reactivating allows posting immediately
+  @bot.reactivate!
+  assert_difference -> { @room.messages.count }, +1 do
+    post room_bot_messages_url(@room, @bot.bot_key),
+      params: "Reactivated!",
+      headers: { "CONTENT_TYPE" => "text/plain" }
+  end
+  assert_response :created
+end
+
+  private
+    def wait_for_pool_tasks(pool, count)
+      start = Time.now
+      timeout = 1.0
+      while pool.completed_task_count < count
+        raise "Timeout waiting for pool tasks to complete" if Time.now - start > timeout
+        sleep 0.01
+      end
+    end
+end
