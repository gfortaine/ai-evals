+      assert_equal 1, bot.bot_cooldown_retry_after(Time.current + 29.5.seconds)
+
+      # Still in cooldown at 29s
+      travel 29.seconds
+      assert bot.in_bot_cooldown?
+      assert_equal 1, bot.bot_cooldown_retry_after
+
+      # At 30s cooldown has expired
+      travel 1.second
+      assert_not bot.in_bot_cooldown?
+      assert_equal [ :allowed, nil ], bot.reserve_bot_post!
+      assert_equal 0, bot.bot_cooldown_attempts
+
+      # Triggering a second cooldown starts fresh at 0 attempts
+      9.times { assert_equal [ :allowed, nil ], bot.reserve_bot_post! }
+      assert_equal [ :cooldown, 30 ], bot.reserve_bot_post!
+      assert_equal 0, bot.bot_cooldown_attempts
+
+      4.times do
+        status, = bot.reserve_bot_post!
+        assert_equal :cooldown, status
+      end
+      assert_not bot.suspended?
+    end
+  end
+
+  test "record_webhook_failure! suspends after 10 consecutive failures and record_webhook_success! resets the count" do
+    bot = User.create_bot!(name: "Flaky Bot", creator: users(:kevin), webhook_url: "https://bot.example.com/hook")
+
+    9.times { bot.record_webhook_failure! }
+    assert_equal 9, bot.reload.bot_webhook_failures
+    assert_not bot.suspended?
+
+    bot.record_webhook_success!
+    assert_equal 0, bot.reload.bot_webhook_failures
+    assert_not bot.suspended?
+
+    9.times { bot.record_webhook_failure! }
+    assert_not bot.reload.suspended?
+
+    bot.record_webhook_failure!
+    assert bot.reload.suspended?
+    assert_equal "failing_webhooks", bot.suspension_reason
+    assert_match(/webhook/i, bot.suspension_reason_description)
+  end
+
+  test "suspended bot keeps rooms and messages, counts toward owner bot limit, and reactivation resets all limits" do
+    freeze_time do
+      accounts(:signal).update!(settings: { bots_per_member: 1 })
+      bot = User.create_bot!(name: "Limit Bot", creator: users(:kevin), webhook_url: "https://bot.example.com/hook")
+      room = rooms(:designers)
+      room.memberships.grant_to(bot)
+      message = room.messages.create!(creator: bot, body: "Before suspension")
+
+      # Suspend via flooding right after 10 messages
+      10.times { assert_equal [ :allowed, nil ], bot.reserve_bot_post! }
+      bot.reserve_bot_post! # starts cooldown
+      5.times { bot.reserve_bot_post! } # suspends
+      assert bot.reload.suspended?
+
+      # Keeps rooms and messages, still counts towards owner bot limit
+      assert_includes bot.rooms, room
+      assert Message.exists?(message.id)
+      assert users(:kevin).bot_limit_reached?
+      assert_not users(:kevin).can_create_bots?
+
+      # Reactivating immediately resets suspension, cooldown, recent posts, and webhook failures
+      bot.reactivate!
+      bot.reload
+      assert_not bot.suspended?
+      assert_nil bot.suspended_at
+      assert_nil bot.suspension_reason
+      assert_nil bot.bot_cooldown_until
+      assert_equal 0, bot.bot_cooldown_attempts
+      assert_equal 0, bot.bot_webhook_failures
+      assert_empty bot.bot_post_timestamps
+
+      # Can immediately post 10 fresh messages without hitting old timestamps
+      10.times { assert_equal [ :allowed, nil ], bot.reserve_bot_post! }
+    end
+  end
+end
