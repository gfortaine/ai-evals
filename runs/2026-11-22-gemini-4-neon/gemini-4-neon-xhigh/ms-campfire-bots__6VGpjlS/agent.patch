+require "test_helper"
+
+class Bots::SuspensionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = User.create_bot!(name: "Deploy Bot", creator: users(:kevin), webhook_url: "https://bot.example.com/hook")
+    @other_bot = User.create_bot!(name: "Healthy Bot", creator: users(:kevin))
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+  end
+
+  test "bots page lists suspended bot with Suspended status and flooding reason, and shows Reactivate button with confirmation only to administrators" do
+    @bot.suspend!(reason: "flooding")
+
+    # Bot owner (non-admin) sees Suspended + reason, but NO Reactivate button
+    sign_in :kevin
+    get bots_url
+    assert_response :ok
+
+    assert_select "li#user_#{@bot.id}" do
+      assert_select "strong", text: "Deploy Bot"
+      assert_select "strong", text: "Suspended"
+      assert_select "[role='status']", text: /Flooding/i
+      assert_select "button", text: /Reactivate/, count: 0
+      assert_select "form[action=?]", bot_suspension_path(@bot), count: 0
+    end
+
+    assert_select "li#user_#{@other_bot.id}" do
+      assert_select "strong", text: "Healthy Bot"
+      assert_select "strong", text: "Suspended", count: 0
+      assert_select "button", text: /Reactivate/, count: 0
+    end
+
+    # Administrator sees Suspended + reason AND Reactivate button with native turbo confirm
+    sign_in :david
+    get bots_url
+    assert_response :ok
+
+    assert_select "li#user_#{@bot.id}" do
+      assert_select "strong", text: "Deploy Bot"
+      assert_select "strong", text: "Suspended"
+      assert_select "[role='status']", text: /Flooding/i
+      assert_select "form[action=?][method='post']", bot_suspension_path(@bot) do
+        assert_select "input[name='_method'][value='delete']"
+        assert_select "button[data-turbo-confirm]", text: "Reactivate"
+      end
+    end
+
+    assert_select "li#user_#{@other_bot.id}" do
+      assert_select "strong", text: "Suspended", count: 0
+      assert_select "button", text: /Reactivate/, count: 0
+    end
+  end
+
+  test "bots page displays failing webhooks suspension reason" do
+    @bot.suspend!(reason: "failing_webhooks")
+
+    sign_in :david
+    get bots_url
+    assert_response :ok
+
+    assert_select "li#user_#{@bot.id}" do
+      assert_select "strong", text: "Suspended"
+      assert_select "[role='status']", text: /Failing webhooks/i
+      assert_select "button[data-turbo-confirm]", text: "Reactivate"
+    end
+  end
+
+  test "unauthenticated users are redirected when trying to reactivate a bot" do
+    @bot.suspend!(reason: "flooding")
+
+    delete bot_suspension_url(@bot)
+    assert_redirected_to new_session_url
+    assert @bot.reload.suspended?
+  end
+
+  test "non-administrators including the bot owner cannot reactivate a suspended bot" do
+    @bot.suspend!(reason: "flooding")
+
+    sign_in :kevin
+    delete bot_suspension_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+
+    sign_in :jz
+    delete bot_suspension_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "administrator can reactivate a suspended bot from the bots page and restore posting and webhooks" do
+    @bot.suspend!(reason: "failing_webhooks")
+
+    sign_in :david
+    delete bot_suspension_url(@bot)
+    assert_redirected_to bots_url
+    assert_not @bot.reload.suspended?
+    assert_nil @bot.suspension_reason
+
+    follow_redirect!
+    assert_response :ok
+    assert_select "li#user_#{@bot.id}" do
+      assert_select "strong", text: "Deploy Bot"
+      assert_select "strong", text: "Suspended", count: 0
+      assert_select "button", text: /Reactivate/, count: 0
+    end
+
+    # Bot can post via API again
+    assert_difference -> { @room.messages.count }, +1 do
+      post room_bot_messages_url(@room, @bot.bot_key),
+        params: "I am back!",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :created
+
+    # Bot receives mention webhooks again
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+      @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(@bot)} welcome back</div>"
+      )
+    end
+  end
+
+  test "reactivating non-bot or deactivated bot returns 404 for administrators" do
+    sign_in :david
+
+    assert_raises ActiveRecord::RecordNotFound do
+      delete bot_suspension_url(users(:kevin))
+    end
+
+    @bot.deactivate
+    assert_raises ActiveRecord::RecordNotFound do
+      delete bot_suspension_url(@bot)
+    end
+  end
+
+  test "editing a suspended bot or forging suspension params does not reactivate it" do
+    @bot.suspend!(reason: "failing_webhooks")
+
+    sign_in :kevin
+    patch bot_url(@bot), params: {
+      bot: {
+        name: "Fixed Hook Bot",
+        webhook_url: "https://fixed.example.com/hook",
+        suspended_at: nil,
+        suspension_reason: nil
+      }
+    }
+    assert_redirected_to bots_url
+
+    @bot.reload
+    assert_equal "Fixed Hook Bot", @bot.name
+    assert_equal "https://fixed.example.com/hook", @bot.webhook_url
+    assert @bot.suspended?
+    assert_equal "failing_webhooks", @bot.suspension_reason
+  end
+
+  test "suspended bot keeps its rooms and messages even when rooms are edited, and counts toward owner bot limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+    closed_room = rooms(:designers)
+    closed_room.memberships.grant_to(@bot)
+    message = @room.messages.create!(creator: @bot, body: "Keep my message")
+
+    @bot.suspend!(reason: "flooding")
+
+    # Keeps rooms and messages
+    assert_includes @bot.rooms, @room
+    assert_includes @bot.rooms, closed_room
+    assert Message.exists?(message.id)
+
+    # Editing closed room sees the suspended bot among active members so it is preserved
+    sign_in :david
+    get edit_rooms_closed_url(closed_room)
+    assert_response :ok
+    assert_includes response.body, @bot.name
+
+    # Editing open room sees the manual suspended bot as selected
+    get edit_rooms_open_url(@room)
+    assert_response :ok
+    assert_includes response.body, @bot.name
+
+    # Still counts towards Kevin's bot limit (2 of 2: @bot suspended + @other_bot active)
+    sign_in :kevin
+    get bots_url
+    assert_response :ok
+    assert_match(/reached the limit/, response.body)
+    assert_select "a[href=?]", new_bot_path, count: 0
+
+    assert_no_difference -> { User.bot.count } do
+      post bots_url, params: { bot: { name: "Third Bot" } }
+    end
+    assert_response :forbidden
+
+    # Deleting the suspended bot frees up the owner's bot limit slot
+    delete bot_url(@bot)
+    assert_redirected_to bots_url
+    assert_not @bot.reload.active?
+
+    assert_difference -> { User.active.bot.count }, +1 do
+      post bots_url, params: { bot: { name: "Replacement Bot" } }
+    end
+    assert_redirected_to bots_url
+  end
+end
