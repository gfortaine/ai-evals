+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  test "account settings page shows bot icon link to members and administrators" do
+    sign_in :kevin
+    get edit_account_url
+    assert_response :ok
+    assert_select "a[href=?][aria-label=?]", bots_path, "Set up chat bots"
+
+    sign_in :david
+    get edit_account_url
+    assert_response :ok
+    assert_select "a[href=?][aria-label=?]", bots_path, "Set up chat bots"
+  end
+
+  test "bots do not appear in the account settings people list" do
+    User.create_bot!(name: "Hidden Deploy Bot", creator: users(:david))
+
+    sign_in :david
+    get edit_account_url
+    assert_response :ok
+    assert_no_match /Hidden Deploy Bot/, response.body
