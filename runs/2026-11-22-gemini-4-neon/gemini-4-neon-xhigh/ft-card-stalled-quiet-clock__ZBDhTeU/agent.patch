+++ b/test/system/stalled_cards_test.rb
@@ -0,0 +1,80 @@
+require "application_system_test_case"
+
+class StalledCardsTest < ApplicationSystemTestCase
+  setup do
+    @card = cards(:logo)
+    with_current_user(:david) { @card.toggle_assignment(users(:david)) }
+    @card.update!(last_active_at: 16.days.ago)
+  end
+
+  test "shows stalled bubble on card show, cards index, and board, and resets on activity" do
+    sign_in_as(users(:david))
+
+    # Cards index filtered by stalled
+    visit cards_url(indexed_by: :stalled)
+    assert_selector "##{dom_id(@card, :article)}"
+    assert_no_selector "##{dom_id(cards(:layout), :article)}"
+    within "##{dom_id(@card, :bubble)}" do
+      assert_selector "[data-bubble-target='top']", text: /stalled for/i
+      assert_selector "[data-bubble-target='center']", text: "16"
+      assert_selector "[data-bubble-target='bottom']", text: /days/i
+    end
+
+    # Board column preview (expand column to view cards inside)
+    visit board_url(boards(:writebook))
+    find("##{dom_id(@card.column)} .cards__expander").click
+    within "##{dom_id(@card, :bubble)}" do
+      assert_selector "[data-bubble-target='top']", text: /stalled for/i
+      assert_selector "[data-bubble-target='center']", text: "16"
+      assert_selector "[data-bubble-target='bottom']", text: /days/i
+    end
+
+    # Card show page
+    visit card_url(@card)
+    within "##{dom_id(@card, :bubble)}" do
+      assert_selector "[data-bubble-target='top']", text: /stalled for/i
+      assert_selector "[data-bubble-target='center']", text: "16"
+      assert_selector "[data-bubble-target='bottom']", text: /days/i
+    end
+
+    # Any activity on the card resets it and hides the bubble
+    fill_in_lexxy with: "Picking this back up!"
+    click_on "Post"
+
+    assert_text "Picking this back up!"
+    assert_no_selector "##{dom_id(@card, :bubble)}", visible: true
+    assert_not @card.reload.stalled?
+
+    # No longer listed under indexed_by=stalled
+    visit cards_url(indexed_by: :stalled)
+    assert_no_selector "##{dom_id(@card, :article)}"
+  end
+
+  test "shows stalled bubble on public card and public board" do
+    boards(:writebook).publish
+
+    visit public_board_card_url(boards(:writebook).publication.key, @card)
+    within "##{dom_id(@card, :bubble)}" do
+      assert_selector "[data-bubble-target='top']", text: /stalled for/i
+      assert_selector "[data-bubble-target='center']", text: "16"
+      assert_selector "[data-bubble-target='bottom']", text: /days/i
+    end
+
+    visit public_board_column_url(boards(:writebook).publication.key, @card.column)
+    within "##{dom_id(@card, :bubble)}" do
+      assert_selector "[data-bubble-target='top']", text: /stalled for/i
+      assert_selector "[data-bubble-target='center']", text: "16"
+      assert_selector "[data-bubble-target='bottom']", text: /days/i
+    end
+  end
+
+  test "non-stalled burst card hides bubble" do
+    fresh = cards(:layout)
+    with_current_user(:david) { fresh.toggle_assignment(users(:kevin)) }
+
+    sign_in_as(users(:david))
+    visit card_url(fresh)
+
+    assert_no_selector "##{dom_id(fresh, :bubble)}", visible: true
+  end
+end
