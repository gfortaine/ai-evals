diff --git a/app/models/user/settings.rb b/app/models/user/settings.rb
index d83ffda..06e47c7 100644
--- a/app/models/user/settings.rb
+++ b/app/models/user/settings.rb
@@ -1,7 +1,18 @@
 class User::Settings < ApplicationRecord
+  AGGREGATION_PERIODS = {
+    every_few_hours: 4.hours,
+    daily: 1.day,
+    weekly: 1.week
+  }.with_indifferent_access.freeze
+
   belongs_to :account, default: -> { user.account }
   belongs_to :user
 
+  enum :bundle_email_frequency, %w[ never every_few_hours daily weekly ].index_by(&:itself),
+    default: :every_few_hours, prefix: :bundle_email, validate: true
+
+  after_update_commit :adjust_pending_notification_bundles, if: :saved_change_to_bundle_email_frequency?
+
   def timezone
     if timezone_name.present?
       ActiveSupport::TimeZone[timezone_name] || default_timezone
@@ -10,8 +21,43 @@ class User::Settings < ApplicationRecord
     end
   end
 
+  def bundling_emails?
+    !bundle_email_never?
+  end
+
+  def bundle_email_aggregation_period
+    AGGREGATION_PERIODS[bundle_email_frequency]
+  end
+
   private
     def default_timezone
       ActiveSupport::TimeZone["UTC"]
     end
+
+    def adjust_pending_notification_bundles
+      with_lock do
+        if bundle_email_never?
+          user.notification_bundles.pending.destroy_all
+        else
+          reschedule_open_notification_bundles
+        end
+      end
+    end
+
+    def reschedule_open_notification_bundles
+      now = Time.current
+      period = bundle_email_aggregation_period
+
+      user.notification_bundles.pending.where("ends_at > ?", now).order(:starts_at).each do |bundle|
+        new_ends_at = bundle.starts_at + period
+
+        if next_bundle = user.notification_bundles.where("starts_at > ?", bundle.starts_at).order(:starts_at).first
+          new_ends_at = [ new_ends_at, next_bundle.starts_at ].min
+        end
+
+        if new_ends_at > bundle.starts_at && new_ends_at != bundle.ends_at
+          bundle.update!(ends_at: new_ends_at)
+        end
+      end
+    end
 end
