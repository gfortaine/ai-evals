+        </h3>
+        <p class="notification__details">
+          <%= event_notification_body(event) %>
+        </p>
+      <% else %>
+        <h3 class="card__title">
+          <%= link_to notification.payload.title, polymorphic_url(notification) %>
+        </h3>
+        <p class="notification__details">
+          <%= notification.payload.body %>
+        </p>
+      <% end %>
+      <p class="notification__author">
