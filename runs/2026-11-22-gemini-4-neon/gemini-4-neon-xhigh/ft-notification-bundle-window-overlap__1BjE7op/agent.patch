diff --git a/app/mailers/notification/bundle_mailer.rb b/app/mailers/notification/bundle_mailer.rb
new file mode 100644
index 0000000..5f4ceaf
--- /dev/null
+++ b/app/mailers/notification/bundle_mailer.rb
@@ -0,0 +1,31 @@
+class Notification::BundleMailer < ApplicationMailer
+  helper NotificationsHelper, ExcerptHelper
+
+  def notification(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+
+    Current.with_account(@account) do
+      @notifications = bundle.unread_notifications.to_a
+
+      return if @notifications.empty? || !@user.active? || @user.system? || @user.identity&.email_address.blank?
+
+      @notifications_by_board = @notifications.group_by { |notification| notification.card.board }
+
+      mail(
+        to: @user.identity.email_address,
+        subject: subject_for(@notifications)
+      )
+    end
+  end
+
+  private
+    def subject_for(notifications)
+      if notifications.one?
+        "Fizzy: #{notifications.first.payload.title}"
+      else
+        "Fizzy: You have #{notifications.size} new notifications"
+      end
+    end
+end
