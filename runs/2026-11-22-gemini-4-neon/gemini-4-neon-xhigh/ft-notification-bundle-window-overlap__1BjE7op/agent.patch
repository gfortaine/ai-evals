+<table class="notification">
+  <tr>
+    <td class="avatar__container">
+      <%= mail_avatar_tag notification.creator %>
+    </td>
+    <td>
+      <% if notification.source.is_a?(Mention) %>
+        <% mention = notification.source %>
+        <p class="notification__details">
+          <span class="notificaton__mention"><%= mention.mentioner.first_name %> @mentioned you</span>
