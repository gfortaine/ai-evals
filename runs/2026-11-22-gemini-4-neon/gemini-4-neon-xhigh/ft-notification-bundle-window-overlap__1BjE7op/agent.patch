diff --git a/test/mailers/notification/bundle_mailer_test.rb b/test/mailers/notification/bundle_mailer_test.rb
new file mode 100644
index 0000000..fdb5a27
--- /dev/null
+++ b/test/mailers/notification/bundle_mailer_test.rb
@@ -0,0 +1,167 @@
+require "test_helper"
+
+class Notification::BundleMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @creator = users(:david)
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    Current.user = @creator
+  end
+
+  test "single notification email" do
+    notification = Notification.create!(
+      user: @user,
+      card: cards(:logo),
+      source: events(:logo_assignment_km),
+      creator: @creator
+    )
+    bundle = @user.notification_bundles.first
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "Fizzy: #{notification.payload.title}", email.subject
+    assert_match cards(:logo).board.name, email.html_part.body.decoded
+    assert_match ERB::Util.html_escape(cards(:logo).title), email.html_part.body.decoded
+    assert_match @user.account.slug, email.html_part.body.decoded
+    assert_match "notifications/settings", email.html_part.body.decoded
+    assert_match cards(:logo).title, email.text_part.body.decoded
+    assert_match "notifications/settings", email.text_part.body.decoded
+  end
+
+  test "multiple notifications including mentions grouped by board" do
+    Notification.create!(
+      user: @user,
+      card: cards(:logo),
+      source: events(:logo_assignment_km),
+      creator: @creator,
+      unread_count: 3
+    )
+
+    mention = @user.mentioned_by(@creator, at: comments(:layout_overflowing_david))
+    Notification.create!(
+      user: @user,
+      card: cards(:layout),
+      source: mention,
+      creator: @creator
+    )
+
+    private_board = boards(:private)
+    private_board.accesses.grant_to(@user)
+    private_card = private_board.cards.create!(title: "Top secret plan", creator: @creator, status: :published)
+    private_event = private_board.events.create!(action: "card_published", creator: @creator, eventable: private_card)
+    Notification.create!(
+      user: @user,
+      card: private_card,
+      source: private_event,
+      creator: @creator
+    )
+
+    bundle = @user.notification_bundles.first
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal "Fizzy: You have 3 new notifications", email.subject
+
+    html = email.html_part.body.decoded
+    assert_match boards(:writebook).name, html
+    assert_match private_board.name, html
+    assert_match "notification__board-separator", html
+    assert_match "3 updates", html
+    assert_match "@mentioned you", html
+    assert_match "Top secret plan", html
+
+    text = email.text_part.body.decoded
+    assert_match boards(:writebook).name, text
+    assert_match private_board.name, text
+    assert_match "@mentioned you", text
+    assert_match "Top secret plan", text
+  end
+
+  test "does not send email when all notifications in bundle are read" do
+    notification = Notification.create!(
+      user: @user,
+      card: cards(:logo),
+      source: events(:logo_assignment_km),
+      creator: @creator
+    )
+    bundle = @user.notification_bundles.first
+    notification.read
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_no_emails do
+      email.deliver_now
+    end
+  end
+
+  test "renders untitled card mention with fallback card number" do
+    untitled_card = boards(:writebook).cards.create!(title: "Temp", creator: @creator, status: :published)
+    untitled_card.update_column(:title, nil)
+    mention = @user.mentioned_by(@creator, at: untitled_card)
+    Notification.create!(
+      user: @user,
+      card: untitled_card,
+      source: mention,
+      creator: @creator
+    )
+    bundle = @user.notification_bundles.first
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_match "Card #{untitled_card.number}", email.html_part.body.decoded
+    assert_match "Card #{untitled_card.number}", email.text_part.body.decoded
+  end
+
+  test "renders comment event notification and creator avatar image when attached" do
+    @creator.avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+
+    Notification.create!(
+      user: @user,
+      card: cards(:layout),
+      source: events(:layout_commented),
+      creator: @creator
+    )
+    bundle = @user.notification_bundles.reload.first
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_match "RE: #{cards(:layout).title}", email.subject
+    assert_match "<img", email.html_part.body.decoded
+    assert_match "/avatar", email.html_part.body.decoded
+  end
+
+  test "does not send email for deactivated user" do
+    Notification.create!(
+      user: @user,
+      card: cards(:logo),
+      source: events(:logo_assignment_km),
+      creator: @creator
+    )
+    bundle = @user.notification_bundles.reload.first
+    @user.deactivate
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_no_emails do
+      email.deliver_now
+    end
+  end
+end
