+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "defaults bundle_email_frequency to every_few_hours" do
+    user = User.create!(account: accounts(:"37s"), name: "New User")
+    assert_equal "every_few_hours", user.settings.bundle_email_frequency
+    assert user.settings.bundle_email_every_few_hours?
+    assert user.bundling_emails?
+  end
+
+  test "supports never, every_few_hours, daily, and weekly frequencies" do
+    settings = users(:kevin).settings
+
+    settings.update!(bundle_email_frequency: :never)
+    assert settings.bundle_email_never?
+    assert_not settings.bundling_emails?
+    assert_nil settings.bundle_aggregation_period
+
+    settings.update!(bundle_email_frequency: :every_few_hours)
+    assert settings.bundle_email_every_few_hours?
+    assert settings.bundling_emails?
+    assert_equal 4.hours, settings.bundle_aggregation_period
+
+    settings.update!(bundle_email_frequency: :daily)
+    assert settings.bundle_email_daily?
+    assert settings.bundling_emails?
+    assert_equal 1.day, settings.bundle_aggregation_period
+
+    settings.update!(bundle_email_frequency: :weekly)
+    assert settings.bundle_email_weekly?
+    assert settings.bundling_emails?
+    assert_equal 1.week, settings.bundle_aggregation_period
+  end
+
+  test "rejects invalid bundle_email_frequency values" do
+    settings = users(:kevin).settings
+
+    assert_raises(ArgumentError) do
+      settings.bundle_email_frequency = :hourly
+    end
+  end
+
+  test "delegates bundle_email_frequency and bundling_emails? from user" do
+    kevin = users(:kevin)
+    kevin.settings.update!(bundle_email_frequency: :daily)
+    assert_equal "daily", kevin.bundle_email_frequency
+    assert kevin.bundling_emails?
+
+    kevin.settings.update!(bundle_email_frequency: :never)
+    assert_equal "never", kevin.bundle_email_frequency
+    assert_not kevin.bundling_emails?
+  end
+end
