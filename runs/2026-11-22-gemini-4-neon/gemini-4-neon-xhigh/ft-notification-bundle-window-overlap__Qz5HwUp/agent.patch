diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..a907988
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,35 @@
+class NotificationMailer < ApplicationMailer
+  helper NotificationsHelper, ExcerptHelper
+
+  def bundle(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.deliverable_notifications.to_a
+
+    return if @notifications.empty? || !@user.active? || @user.identity.blank?
+
+    @notifications_by_board = @notifications.group_by { |notification| notification.card.board }
+
+    @user.in_time_zone do
+      mail(
+        to: @user.identity.email_address,
+        subject: subject_for(@notifications)
+      )
+    end
+  end
+
+  private
+    def default_url_options
+      if @account
+        super.merge(script_name: @account.slug)
+      else
+        super
+      end
+    end
+
+    def subject_for(notifications)
+      count = notifications.size
+      "#{@account.name}: #{count} new #{"notification".pluralize(count)}"
+    end
+end
