+        <p class="card__title">
+          <%= link_to polymorphic_url(notification) do %>
+            <span class="notificaton__mention"><%= notification.source.mentioner.first_name %> @mentioned you</span>
+            on <%= notification.card.title.presence || "Card #{notification.card.number}" %>
+          <% end %>
+        </p>
+        <p class="notification__details">
+          <%= format_excerpt(notification.source.source.mentionable_content, length: 200) %>
+        </p>
+      <% else %>
+        <p class="card__title">
+          <%= link_to notification.payload.title, polymorphic_url(notification) %>
+        </p>
+        <p class="notification__details">
+          <%= notification.payload.body %>
+        </p>
+      <% end %>
+      <p class="notification__author">
+        <%= notification.creator.name %> &middot; <%= l(notification.updated_at, format: :short) %>
+      </p>
+    </td>
+  </tr>
+</table>
