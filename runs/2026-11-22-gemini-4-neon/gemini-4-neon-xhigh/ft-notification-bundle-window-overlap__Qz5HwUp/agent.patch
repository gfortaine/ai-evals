diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..0dd2402
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,772 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @kevin = users(:kevin)
+    @david = users(:david)
+    @jz = users(:jz)
+    @kevin.notifications.delete_all
+    @david.notifications.delete_all
+    @kevin.notification_bundles.delete_all
+    @david.notification_bundles.delete_all
+  end
+
+  test "clock starts when first notification lands with every_few_hours (4 hours)" do
+    freeze_time
+    @kevin.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    assert_difference -> { @kevin.notification_bundles.count }, 1 do
+      create_notification(user: @kevin, source: events(:logo_assignment_km))
+    end
+
+    bundle = @kevin.notification_bundles.last
+    assert bundle.pending?
+    assert_equal Time.current, bundle.starts_at
+    assert_equal 4.hours.from_now, bundle.ends_at
+  end
+
+  test "clock starts when first notification lands with daily frequency" do
+    freeze_time
+    @kevin.settings.update!(bundle_email_frequency: :daily)
+
+    create_notification(user: @kevin, source: events(:logo_assignment_km))
+
+    bundle = @kevin.notification_bundles.last
+    assert_equal Time.current, bundle.starts_at
+    assert_equal 1.day.from_now, bundle.ends_at
+  end
+
+  test "clock starts when first notification lands with weekly frequency" do
+    freeze_time
+    @kevin.settings.update!(bundle_email_frequency: :weekly)
+
+    create_notification(user: @kevin, source: events(:logo_assignment_km))
+
+    bundle = @kevin.notification_bundles.last
+    assert_equal Time.current, bundle.starts_at
+    assert_equal 1.week.from_now, bundle.ends_at
+  end
+
+  test "never frequency creates no bundle and sends no email" do
+    freeze_time
+    @kevin.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { @kevin.notification_bundles.count } do
+      notification = create_notification(user: @kevin, source: events(:logo_assignment_km))
+      assert_nil notification.bundle_id
+    end
+
+    travel 1.week
+
+    assert_no_emails do
+      Notification::Bundle.deliver_all
+    end
+  end
+
+  test "batches multiple notifications within the same window into one email" do
+    freeze_time
+    @kevin.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    n1 = create_notification(user: @kevin, source: events(:logo_assignment_km))
+
+    travel 1.hour
+    n2 = create_notification(user: @kevin, source: events(:layout_commented))
+
+    travel 2.hours
+    n3 = create_notification(user: @kevin, source: events(:buy_domain_sent_back_to_triage))
+
+    assert_equal 1, @kevin.notification_bundles.count
+    bundle = @kevin.notification_bundles.first
+    assert_equal [ n1.id, n2.id, n3.id ].sort, bundle.notifications.pluck(:id).sort
+
+    # Not due yet (only 3 hours elapsed)
+    assert_no_emails do
+      Notification::Bundle.deliver_all
+    end
+    assert bundle.reload.pending?
+
+    # 4 hours elapsed: due and delivers one email with all 3 notifications
+    travel 1.hour
+    assert_emails 1 do
+      Notification::Bundle.deliver_all
+    end
+
+    assert bundle.reload.delivered?
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @kevin.identity.email_address ], email.to
+    assert_match "3 new notifications", email.subject
+    assert_match cards(:logo).title, email.text_part.body.to_s
+    assert_match cards(:layout).title, email.text_part.body.to_s
+    assert_match cards(:buy_domain).title, email.text_part.body.to_s
+  end
+
+  test "each person has their own frequency and independent windows" do
+    freeze_time
+    @kevin.settings.update!(bundle_email_frequency: :every_few_hours)
+    @david.settings.update!(bundle_email_frequency: :daily)
+    @jz.settings.update!(bundle_email_frequency: :never)
+    @jz.notification_bundles.delete_all
+
+    create_notification(user: @kevin, source: events(:logo_assignment_km), creator: @david)
+    create_notification(user: @david, source: events(:layout_commented), creator: @kevin)
+    create_notification(user: @jz, source: events(:buy_domain_sent_back_to_triage), creator: @david)
+
+    assert_equal 1, @kevin.notification_bundles.count
+    assert_equal 1, @david.notification_bundles.count
+    assert_equal 0, @jz.notification_bundles.count
+
+    travel 4.hours
+    assert_emails 1 do
+      Notification::Bundle.deliver_all
+    end
+    assert_equal [ @kevin.identity.email_address ], ActionMailer::Base.deliveries.last.to
+    assert @david.notification_bundles.first.pending?
+
+    travel 20.hours
+    assert_emails 1 do
+      Notification::Bundle.deliver_all
+    end
+    assert_equal [ @david.identity.email_address ], ActionMailer::Base.deliveries.last.to
+  end
+
+  test "daily and weekly windows preserve local wall-clock time across DST" do
+    @kevin.settings.update!(timezone_name: "America/New_York", bundle_email_frequency: :daily)
+
+    # 2026-03-08 is US DST spring-forward day (23-hour day in America/New_York)
+    travel_to Time.utc(2026, 3, 7, 15, 0, 0) do # 10:00 AM EST
+      create_notification(user: @kevin, source: events(:logo_assignment_km))
+
+      bundle = @kevin.notification_bundles.last
+      assert_equal "2026-03-08 10:00:00 -0400", bundle.ends_at.in_time_zone("America/New_York").to_s
+    end
+  end
+
+  test "late notification arriving with timestamp before open window joins the open window" do
+    travel_to Time.utc(2026, 11, 21, 10, 5, 0) do
+      @kevin.settings.update!(bundle_email_frequency: :every_few_hours)
+
+      n1 = create_notification(user: @kevin, source: events(:logo_assignment_km))
+      bundle = @kevin.notification_bundles.last
+      assert_equal Time.utc(2026, 11, 21, 10, 5, 0), bundle.starts_at
+      assert_equal Time.utc(2026, 11, 21, 14, 5, 0), bundle.ends_at
+
+      # Late notification created 10 minutes earlier arrives after window already opened
+      n_late = create_notification(
+        user: @kevin,
+        source: events(:layout_commented),
+        created_at: Time.utc(2026, 11, 21, 9, 55, 0)
+      )
+
+      assert_equal 1, @kevin.notification_bundles.count
+      assert_equal bundle.id, n_late.bundle_id
+      assert_equal [ n1.id, n_late.id ].sort, bundle.notifications.pluck(:id).sort
+    end
+
+    travel_to Time.utc(2026, 11, 21, 14, 5, 0) do
+      assert_emails 1 do
+        Notification::Bundle.deliver_all
+      end
+
+      email = ActionMailer::Base.deliveries.last
+      assert_match cards(:logo).title, email.text_part.body.to_s
+      assert_match cards(:layout).title, email.text_part.body.to_s
+    end
+  end
+
+  test "very late notification hours before open window still joins the open window" do
+    travel_to Time.utc(2026, 11, 21, 10, 0, 0) do
+      @kevin.settings.update!(bundle_email_frequency: :every_few_hours)
+
+      create_notification(user: @kevin, source: events(:logo_assignment_km))
+      bundle = @kevin.notification_bundles.last
+
+      n_very_late = create_notification(
+        user: @kevin,
+        source: events(:layout_commented),
+        created_at: Time.utc(2026, 11, 21, 2, 0, 0)
+      )
+
+      assert_equal 1, @kevin.notification_bundles.count
+      assert_equal bundle.id, n_very_late.bundle_id
+    end
+  end
+
+  test "late notification from already-delivered window joins newly opened window without overlap" do
+    @kevin.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    travel_to Time.utc(2026, 11, 21, 6, 0, 0) do
+      create_notification(user: @kevin, source: events(:logo_assignment_km))
+    end
+
+    first_bundle = @kevin.notification_bundles.first
+    travel_to Time.utc(2026, 11, 21, 10, 0, 0) do
+      assert_emails(1) { Notification::Bundle.deliver_all }
+    end
+    assert first_bundle.reload.delivered?
+
+    travel_to Time.utc(2026, 11, 21, 10, 15, 0) do
+      create_notification(user: @kevin, source: events(:layout_commented))
+      second_bundle = @kevin.notification_bundles.pending.last
+
+      # Late notification with timestamp inside already-delivered first_bundle
+      n_late = create_notification(
+        user: @kevin,
+        source: events(:buy_domain_sent_back_to_triage),
+        created_at: Time.utc(2026, 11, 21, 9, 50, 0)
+      )
+
+      assert_equal 2, @kevin.notification_bundles.count
+      assert_equal second_bundle.id, n_late.bundle_id
+      assert_no_overlapping_bundles(@kevin)
+    end
+
+    travel_to Time.utc(2026, 11, 21, 14, 15, 0) do
+      assert_emails(1) { Notification::Bundle.deliver_all }
+      email = ActionMailer::Base.deliveries.last
+      assert_match cards(:layout).title, email.text_part.body.to_s
+      assert_match cards(:buy_domain).title, email.text_part.body.to_s
+      assert_no_match cards(:logo).title, email.text_part.body.to_s
+    end
+  end
+
+  test "late notification from already-delivered window with no open window opens non-overlapping next window" do
+    @kevin.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    travel_to Time.utc(2026, 11, 21, 6, 0, 0) do
+      create_notification(user: @kevin, source: events(:logo_assignment_km))
+    end
+
+    first_bundle = @kevin.notification_bundles.first
+    travel_to Time.utc(2026, 11, 21, 10, 0, 0) do
+      assert_emails(1) { Notification::Bundle.deliver_all }
+    end
+
+    travel_to Time.utc(2026, 11, 21, 10, 5, 0) do
+      n_late = create_notification(
+        user: @kevin,
+        source: events(:layout_commented),
