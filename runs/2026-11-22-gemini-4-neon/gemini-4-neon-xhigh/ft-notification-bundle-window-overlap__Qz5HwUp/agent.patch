+<table class="notification">
+  <tr>
+    <td class="avatar__container">
+      <%= mail_avatar_tag notification.creator %>
+    </td>
+    <td>
+      <% if notification.source.is_a?(Event) %>
+        <p class="card__title">
+          <%= link_to event_notification_title(notification.source), polymorphic_url(notification) %>
+        </p>
+        <p class="notification__details">
+          <%= event_notification_body(notification.source) %>
+        </p>
