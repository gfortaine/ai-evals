new file mode 100644
index 0000000..eee3134
--- /dev/null
+++ b/app/models/account/storage_tracked.rb
@@ -0,0 +1,52 @@
+module Account::StorageTracked
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :storage_total, as: :owner, class_name: "Storage::Total", dependent: :destroy
+    has_many :storage_entries, class_name: "Storage::Entry", dependent: :delete_all
+
+    around_destroy :suppress_storage_tracking, prepend: true
+    before_destroy :clear_storage_totals
+  end
+
+  def bytes_used
+    return 0 unless persisted?
+
+    usage = if association(:storage_total).loaded?
+      storage_total&.bytes_used
+    else
+      Storage::Total.where(owner: self).pick(:bytes_used)
+    end
+
+    [ usage.to_i, 0 ].max
+  end
+
+  def materialize_storage
+    Storage::Materializer.new(self).materialize
+  end
+
+  def materialize_storage_later
+    Current.with_account(self) do
+      Storage::MaterializeJob.perform_later(self)
+    end
+  end
+
+  def reconcile_storage
+    Storage::Reconciler.new(self).reconcile
+  end
+
+  def reconcile_storage_later
+    Current.with_account(self) do
+      Storage::ReconcileJob.perform_later(self)
+    end
+  end
+
+  private
+    def suppress_storage_tracking
+      Storage.without_tracking(id) { yield }
+    end
+
+    def clear_storage_totals
+      Storage::Total.where(account_id: id).delete_all
+    end
+end
