+class Storage::Total < ApplicationRecord
+  belongs_to :account
+  belongs_to :owner, polymorphic: true
+
+  validates :bytes_used, presence: true, numericality: { only_integer: true }
+
+  class << self
+    def ensure_for(account_id:, owner_type:, owner_id:)
+      now = Time.current
+
+      insert_all([
+        {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: account_id,
+          owner_type: owner_type,
+          owner_id: owner_id,
+          bytes_used: 0,
+          created_at: now,
+          updated_at: now
+        }
+      ])
+    end
+
+    def ensure_for_boards(account_id:, board_ids:)
+      return if board_ids.empty?
+
+      now = Time.current
+      rows = board_ids.map do |board_id|
+        {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: account_id,
+          owner_type: "Board",
+          owner_id: board_id,
+          bytes_used: 0,
+          created_at: now,
+          updated_at: now
+        }
+      end
+
+      insert_all(rows)
+    end
+  end
+end
