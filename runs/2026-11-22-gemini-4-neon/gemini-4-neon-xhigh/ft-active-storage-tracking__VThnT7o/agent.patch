+    assert_equal 1000, @board.bytes_used
+    assert_equal 1000, @other_board.bytes_used
+    assert_equal 2000, @account.bytes_used
+  end
+
+  test "deduplicates materialization job per transaction" do
+    blob1 = create_blob(100, "1.txt")
+    blob2 = create_blob(200, "2.txt")
+    blob3 = create_blob(300, "3.txt")
+
+    assert_enqueued_jobs 1, only: Storage::MaterializeJob do
+      @card.update!(description: "#{embed_html(blob1)} #{embed_html(blob2)} #{embed_html(blob3)}")
+    end
+
+    perform_enqueued_jobs
+    assert_equal 600, @board.bytes_used
+    assert_equal 600, @account.bytes_used
+  end
+
+  test "suppresses tracking and cleans up storage records when account is destroyed" do
+    @card.image.attach(io: StringIO.new("a" * 1000), filename: "a.png", content_type: "image/png")
+    perform_enqueued_jobs
+
+    # Also create a pending entry
+    @card.comments.create!(body: embed_html(create_blob(500, "pending.txt")))
+
+    account_id = @account.id
+
+    assert_no_enqueued_jobs only: Storage::MaterializeJob do
+      @account.destroy!
+    end
+
+    assert_empty Storage::Entry.where(account_id: account_id)
+    assert_empty Storage::Total.where(account_id: account_id)
+  end
+
+  test "reconciles storage usage after account export and import round-trip" do
+    exporter = users(:david)
+    identity = exporter.identity
+
+    board_blob = create_blob(200, "board.txt")
+    card_desc_blob = create_blob(300, "card.txt")
+    comment_blob = create_blob(400, "comment.txt")
+    other_blob = create_blob(700, "other.txt")
+
+    @board.update!(public_description: embed_html(board_blob))
+    @card.image.attach(io: StringIO.new("i" * 100), filename: "img.png", content_type: "image/png")
+    @card.update!(description: embed_html(card_desc_blob))
+    @card.comments.create!(body: embed_html(comment_blob))
+    @other_board.update!(public_description: embed_html(other_blob))
+    perform_enqueued_jobs
+
+    export = Account::Export.create!(account: @account, user: exporter)
+    export.build
+
+    export_tempfile = Tempfile.new([ "export", ".zip" ])
+    export.file.open { |f| FileUtils.cp(f.path, export_tempfile.path) }
+
+    writebook_id = @board.id
+    private_id = @other_board.id
+    ActiveStorage::Blob.where(account: @account).delete_all
+    @account.destroy!
+
+    target_account = Account.create_with_owner(account: { name: "Imported" }, owner: { identity: identity, name: exporter.name })
+    import = Account::Import.create!(identity: identity, account: target_account)
+    Current.set(account: target_account) do
+      import.file.attach(io: File.open(export_tempfile.path), filename: "export.zip", content_type: "application/zip")
+    end
+
+    import.check
+    import.process
+    perform_enqueued_jobs only: [ Storage::MaterializeJob, Storage::ReconcileJob ]
+
+    assert_equal 1700, target_account.bytes_used
+    assert_equal 1000, target_account.boards.find(writebook_id).bytes_used
+    assert_equal 700, target_account.boards.find(private_id).bytes_used
+  ensure
+    export_tempfile&.close
+    export_tempfile&.unlink
+  end
+
+  test "tracks creating a card with both image and embedded description in one create" do
+    desc_blob = create_blob(650, "desc.txt")
+
+    @board.cards.create!(
+      title: "Combined",
+      status: "published",
+      creator: users(:david),
+      image: { io: StringIO.new("i" * 350), filename: "img.png", content_type: "image/png" },
+      description: embed_html(desc_blob)
+    )
+    perform_enqueued_jobs
+
+    assert_equal 1000, @board.bytes_used
+    assert_equal 1000, @account.bytes_used
+  end
+
+  test "accurately updates storage when moving a card and clearing its image and description in the same update" do
+    desc_blob = create_blob(200, "old_desc.txt")
+
+    @card.image.attach(io: StringIO.new("i" * 100), filename: "old.png", content_type: "image/png")
+    @card.update!(description: embed_html(desc_blob))
+    perform_enqueued_jobs
+
+    assert_equal 300, @board.bytes_used
+
+    @card.update!(board: @other_board, image: nil, description: "")
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "handles nested savepoint rollback without leaking or enqueueing jobs" do
+    assert_no_enqueued_jobs only: Storage::MaterializeJob do
+      ApplicationRecord.transaction do
+        ApplicationRecord.transaction(requires_new: true) do
+          @card.image.attach(io: StringIO.new("a" * 500), filename: "sp.png", content_type: "image/png")
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert_equal 0, Storage::Entry.where(account: @account).count
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "discards materialization and reconciliation jobs cleanly if target is deleted before execution" do
+    new_account = Account.create!(name: "Ephemeral")
+    new_board = new_account.boards.create!(name: "Temp", creator: new_account.users.create!(name: "Owner", role: :owner))
+
+    new_account.materialize_storage_later
+    new_board.reconcile_storage_later
+    new_account.destroy!
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: [ Storage::MaterializeJob, Storage::ReconcileJob ]
+    end
+  end
+
+  test "reconcile_all_later enqueues reconciliation for every account" do
+    assert_enqueued_jobs Account.count, only: Storage::ReconcileJob do
+      Storage.reconcile_all_later
+    end
+  end
+
+  private
+    def create_blob(byte_size, filename)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("x" * byte_size),
+        filename: filename,
+        content_type: "text/plain"
+      )
+    end
+
+    def embed_html(blob)
+      %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+end
