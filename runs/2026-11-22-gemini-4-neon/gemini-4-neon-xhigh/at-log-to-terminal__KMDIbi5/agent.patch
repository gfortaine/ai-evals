index 0000000..8d9c962
--- /dev/null
+++ b/test/lib/library_report_runner_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+require "open3"
+
+class LibraryReportRunnerTest < ActiveSupport::TestCase
+  test "rails runner prints library report to stdout and records it in the log file" do
+    log_path = Rails.root.join("log/test.log")
+    offset = log_path.exist? ? log_path.size : 0
+
+    stdout, _stderr, status = Open3.capture3(
+      { "LOG_LEVEL" => nil },
+      Rails.root.join("bin/rails").to_s, "runner", "-e", "test", "script/library_report.rb",
+      chdir: Rails.root.to_s
+    )
+
+    assert status.success?, "expected runner to exit 0"
+
+    report_lines = stdout.lines.map(&:chomp)
+    assert_match(/\ALibrary report: \d+ books\z/, report_lines.first)
+    assert_equal "Library report: done", report_lines.last
+    assert report_lines.all? { |line| line.start_with?("Library report: ") },
+      "expected stdout to contain only report lines, got:\n#{stdout}"
+
+    logged = read_from_offset(log_path, offset)
+    positions = report_lines.map { |line| logged.index(line) }
+    assert positions.all?, "expected all report lines in log/test.log"
+    assert_equal positions.sort, positions, "expected report lines in log/test.log in the same order"
+    assert_includes logged, 'SELECT "books".* FROM "books"', "expected debug SQL logs to remain in log/test.log"
+  end
+
+  test "rails runner respects LOG_LEVEL across stdout and log file" do
+    log_path = Rails.root.join("log/test.log")
+    token = SecureRandom.hex(6)
+    code = <<~RUBY
+      Rails.logger.debug "probe-debug-#{token}"
+      Rails.logger.info "probe-info-#{token}"
+      Rails.logger.warn "probe-warn-#{token}"
+    RUBY
+
+    offset = log_path.exist? ? log_path.size : 0
+    stdout, _stderr, status = Open3.capture3(
+      { "LOG_LEVEL" => "warn" },
+      Rails.root.join("bin/rails").to_s, "runner", "-e", "test", code,
+      chdir: Rails.root.to_s
+    )
+
+    assert status.success?
+    logged = read_from_offset(log_path, offset)
+
+    assert_not_includes stdout, "probe-debug-#{token}"
+    assert_not_includes stdout, "probe-info-#{token}"
+    assert_includes stdout, "probe-warn-#{token}"
+
+    assert_not_includes logged, "probe-debug-#{token}"
+    assert_not_includes logged, "probe-info-#{token}"
+    assert_includes logged, "probe-warn-#{token}"
+  end
+
+  test "rails runner includes debug logs on stdout when LOG_LEVEL=debug is explicitly set" do
+    log_path = Rails.root.join("log/test.log")
+    token = SecureRandom.hex(6)
+    code = <<~RUBY
+      Rails.logger.debug "probe-debug-#{token}"
+      Rails.logger.info "probe-info-#{token}"
+    RUBY
+
+    offset = log_path.exist? ? log_path.size : 0
+    stdout, _stderr, status = Open3.capture3(
+      { "LOG_LEVEL" => "debug" },
+      Rails.root.join("bin/rails").to_s, "runner", "-e", "test", code,
+      chdir: Rails.root.to_s
+    )
+
+    assert status.success?
+    logged = read_from_offset(log_path, offset)
+
+    assert_includes stdout, "probe-debug-#{token}"
+    assert_includes stdout, "probe-info-#{token}"
+    assert_includes logged, "probe-debug-#{token}"
+    assert_includes logged, "probe-info-#{token}"
+  end
+
+  private
+    def read_from_offset(path, offset)
+      File.open(path, "rb") do |file|
+        file.seek(offset)
+        file.read.force_encoding(Encoding::UTF_8)
+      end
+    end
+end
