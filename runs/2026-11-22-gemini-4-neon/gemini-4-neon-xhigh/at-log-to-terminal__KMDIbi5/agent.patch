diff --git a/config/application.rb b/config/application.rb
index d5e4fd0..58da76e 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -16,8 +16,26 @@ module Writebook
     # Common ones are `templates`, `generators`, or `middleware`, for example.
     config.autoload_lib(ignore: %w[rails_ext assets tasks])
 
-    # Raised on noisy runs from the runbook; "debug" is what Rails would pick anyway.
-    config.log_level = ENV.fetch("LOG_LEVEL", "debug")
+    # Raised on noisy runs from the runbook; only assign when set so Rails's
+    # broadcast_log_level doesn't override per-sink logger levels.
+    if (log_level = ENV["LOG_LEVEL"]) && !log_level.empty?
+      config.log_level = log_level
+    end
+
+    runner do |app|
+      if Rails.logger.respond_to?(:broadcast_to) &&
+          !ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT, STDERR)
+        STDOUT.sync = true if app.config.autoflush_log
+        console = ActiveSupport::Logger.new(STDOUT)
+        console.formatter = Rails.logger.formatter if Rails.logger.formatter
+        console.level = if app.config.broadcast_log_level
+          Rails.logger.level
+        else
+          [ Rails.logger.level, ActiveSupport::Logger::INFO ].max
+        end
+        Rails.logger.broadcast_to(console)
+      end
+    end
 
     # Configuration for the application, engines, and railties goes here.
     #
diff --git a/test/lib/library_report_runner_test.rb b/test/lib/library_report_runner_test.rb
