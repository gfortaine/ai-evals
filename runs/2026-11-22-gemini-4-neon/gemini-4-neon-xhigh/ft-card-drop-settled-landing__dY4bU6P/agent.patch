diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..93e58e5
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,607 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+  end
+
+  test "visual feedback dims dragged card, lights up hovered column, ignores source column, and cleans up on cancel" do
+    visit board_url(@board)
+
+    card = cards(:buy_domain)
+    in_progress = columns(:writebook_in_progress)
+    card_selector = "##{dom_id(card, :article)}"
+    maybe_selector = "#maybe"
+    target_selector = "##{dom_id(in_progress)}"
+
+    assert_selector "#{maybe_selector} #{card_selector}[draggable='true']"
+    wait_for_column_frame(in_progress)
+
+    # Start dragging the card
+    dispatch_drag_event(card_selector, "dragstart")
+    assert_selector "#{card_selector}.drag-and-drop__dragged-item"
+
+    # Hovering over the source column does not light it up
+    dispatch_drag_event(maybe_selector, "dragenter")
+    dispatch_drag_event(maybe_selector, "dragover")
+    assert_no_selector "#{maybe_selector}.drag-and-drop__hover-container"
+
+    # Hovering over another column lights it up
+    dispatch_drag_event(target_selector, "dragenter")
+    dispatch_drag_event(target_selector, "dragover")
+    assert_selector "#{target_selector}.drag-and-drop__hover-container"
+
+    # Leaving to a child inside the same hovered column does NOT remove highlight
+    page.execute_script(<<~JS, target_selector)
+      const col = document.querySelector(arguments[0])
+      const child = col.querySelector(".cards__header")
+      col.dispatchEvent(new DragEvent("dragleave", { bubbles: true, cancelable: true, relatedTarget: child }))
+    JS
+    assert_selector "#{target_selector}.drag-and-drop__hover-container"
+
+    # Leaving outside the column removes highlight
+    dispatch_drag_event(target_selector, "dragleave")
+    assert_no_selector "#{target_selector}.drag-and-drop__hover-container"
+
+    # Cancelling removes dimmed state and keeps card in original column
+    dispatch_drag_event(card_selector, "dragend")
+    assert_no_selector "#{card_selector}.drag-and-drop__dragged-item"
+    assert_selector "#{maybe_selector} #{card_selector}"
+    assert_nil card.reload.column
+  end
+
+  test "dragging a card onto its own column keeps column order and makes no request" do
+    triage = columns(:writebook_triage)
+    first_card = cards(:logo)
+    second_card = cards(:layout)
+    first_card.update_column(:last_active_at, 1.hour.ago)
+    second_card.update_column(:last_active_at, 2.hours.ago)
+
+    visit board_url(@board)
+    expand_column(triage)
+    assert_selector "##{dom_id(triage)} ##{dom_id(first_card, :article)}"
+    assert_selector "##{dom_id(triage)} ##{dom_id(second_card, :article)}"
+
+    initial_order = card_ids_in("##{dom_id(triage)}")
+    assert_equal [ dom_id(first_card, :article), dom_id(second_card, :article) ], initial_order
+
+    # Track network requests to prove none are made
+    page.execute_script(<<~JS)
+      window.__dragRequests = 0
+      const origFetch = window.fetch
+      window.fetch = function(...args) {
+        window.__dragRequests++
+        return origFetch.apply(this, args)
+      }
+    JS
+
+    drag_and_drop("##{dom_id(second_card, :article)}", "##{dom_id(triage)}")
+
+    assert_equal initial_order, card_ids_in("##{dom_id(triage)}")
+    assert_equal 0, page.evaluate_script("window.__dragRequests")
+  end
+
+  test "dragging from Maybe? to a collapsed custom column updates immediately before save and persists" do
+    visit board_url(@board)
+
+    card = cards(:buy_domain)
+    in_progress = columns(:writebook_in_progress)
+    card_selector = "##{dom_id(card, :article)}"
+    target_selector = "##{dom_id(in_progress)}"
+
+    assert_selector "#maybe #{card_selector}[draggable='true']"
+    wait_for_column_frame(in_progress)
+
+    assert_equal "1", find("#maybe .cards__expander-count", visible: :all).text(:all)
+    assert_equal "1", find("#{target_selector} .cards__expander-count", visible: :all).text(:all)
+
+    # Intercept fetch so save stays pending while we assert instant optimistic state
+    install_deferred_fetch
+
+    drag_and_drop(card_selector, target_selector)
+
+    # Immediately (before save resolves!):
+    assert_no_selector "#maybe #{card_selector}", wait: 0
+    assert_selector "#{target_selector} #{card_selector}", visible: :all, wait: 0
+    assert_no_selector "#{card_selector}.drag-and-drop__dragged-item", visible: :all, wait: 0
+    assert_no_selector "#{target_selector}.drag-and-drop__hover-container", visible: :all, wait: 0
+
+    # Counts updated immediately
+    assert_equal "0", find("#maybe .cards__expander-count", visible: :all).text(:all)
+    assert_equal "2", find("#{target_selector} .cards__expander-count", visible: :all).text(:all)
+
+    # Card color updated immediately to target column's color
+    card_color = page.evaluate_script("document.querySelector(arguments[0]).style.getPropertyValue('--card-color').trim()", card_selector)
+    assert_equal in_progress.color.to_s, card_color
+
+    # Order inside target column is already right: dropped card first, existing card second
+    assert_equal [ dom_id(card, :article), dom_id(cards(:text), :article) ], card_ids_in(target_selector)
+
+    # DB has NOT saved yet because fetch is held
+    assert_nil card.reload.column
+
+    # Track whether any DOM morph happens on the originating tab when broadcast arrives
+    page.execute_script(<<~JS)
+      window.__morphCount = 0
+      document.addEventListener("turbo:morph", () => window.__morphCount++)
+    JS
+
+    # Now let the save complete and run any broadcast refresh jobs
+    release_deferred_fetches
+    wait_until { card.reload.column == in_progress }
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    # Expand target column: card is right there at the top, nothing shifted
+    expand_column(in_progress)
+    assert_equal [ dom_id(card, :article), dom_id(cards(:text), :article) ], card_ids_in(target_selector)
+    assert_equal 0, page.evaluate_script("window.__morphCount")
+
+    # Reload page: exact same board state from server
+    visit board_url(@board)
+    expand_column(in_progress)
+    assert_equal [ dom_id(card, :article), dom_id(cards(:text), :article) ], card_ids_in(target_selector)
+    assert_no_selector "#maybe #{card_selector}"
+  end
+
+  test "dragging between custom columns updates colors, empty placeholders, and persists" do
+    in_progress = columns(:writebook_in_progress)
+    on_hold = columns(:writebook_on_hold)
+    card = cards(:text)
+
+    visit board_url(@board)
+    wait_for_column_frame(in_progress)
+    wait_for_column_frame(on_hold)
+    expand_column(in_progress)
+
+    card_selector = "##{dom_id(card, :article)}"
+    assert_selector "##{dom_id(in_progress)} #{card_selector}[draggable='true']"
+    assert_no_selector "##{dom_id(in_progress)} .blank-slate--drag"
+
+    # Drag the only card from In progress to empty On Hold
+    drag_and_drop(card_selector, "##{dom_id(on_hold)}")
+
+    # Immediately: In progress shows "Drag cards here", On Hold has card with On Hold color
+    assert_selector "##{dom_id(in_progress)} .blank-slate--drag", text: "Drag cards here"
+    assert_selector "##{dom_id(on_hold)} #{card_selector}", visible: :all
+    card_color = page.evaluate_script("document.querySelector(arguments[0]).style.getPropertyValue('--card-color').trim()", card_selector)
+    assert_equal on_hold.color.to_s, card_color
+
+    wait_until { card.reload.column == on_hold }
+
+    # Expand On Hold: card is visible and "Drag cards here" is hidden
+    expand_column(on_hold)
+    assert_selector "##{dom_id(on_hold)} #{card_selector}"
+    assert_no_selector "##{dom_id(on_hold)} .blank-slate--drag"
+
+    # Drag card back to Maybe?
+    drag_and_drop(card_selector, "#maybe")
+
+    assert_selector "#maybe #{card_selector}"
+    assert_selector "##{dom_id(on_hold)} .blank-slate--drag", text: "Drag cards here"
+    card_color = page.evaluate_script("document.querySelector(arguments[0]).style.getPropertyValue('--card-color').trim()", card_selector)
+    assert_equal "var(--color-card-default)", card_color
+
+    wait_until { card.reload.awaiting_triage? }
+  end
+
+  test "dragging to and from Not Now and Done updates status, clears stamps, and persists" do
+    card = cards(:buy_domain)
+    in_progress = columns(:writebook_in_progress)
+    card_selector = "##{dom_id(card, :article)}"
+
+    visit board_url(@board)
+    wait_for_column_frame(in_progress)
+    wait_for_frame("not_now_column")
+    wait_for_frame("closed_column")
+
+    # 1. Maybe? -> Not Now
+    drag_and_drop(card_selector, "#not-now")
+    assert_selector "#not-now #{card_selector}.card--postponed", visible: :all
+    wait_until { card.reload.postponed? }
+
+    # Reload to get real server-rendered Not Now card (including .card__closed stamp)
+    visit board_url(@board)
+    wait_for_frame("not_now_column")
+    wait_for_frame("closed_column")
+    expand_column_by_id("not-now")
+    assert_selector "#not-now #{card_selector}.card--postponed"
+    assert_selector "#not-now #{card_selector} .card__closed", visible: :all
+
+    # 2. Not Now -> Done
+    drag_and_drop(card_selector, "#closed-cards")
+    assert_selector "#closed-cards #{card_selector}", visible: :all
+    assert_no_selector "#closed-cards #{card_selector}.card--postponed", visible: :all
+    wait_until { card.reload.closed? && !card.postponed? }
+
+    # Reload to get real server-rendered Done card (with .card__closed stamp)
+    visit board_url(@board)
+    wait_for_frame("closed_column")
+    wait_for_column_frame(in_progress)
+    expand_column_by_id("closed-cards")
+    assert_selector "#closed-cards #{card_selector}"
+    assert_selector "#closed-cards #{card_selector} .card__closed", visible: :all
+
+    # 3. Done -> In progress (reopens + removes stamp + restores column color immediately)
+    drag_and_drop(card_selector, "##{dom_id(in_progress)}")
+    assert_selector "##{dom_id(in_progress)} #{card_selector}.card--active", visible: :all
+    assert_no_selector "##{dom_id(in_progress)} #{card_selector} .card__closed", visible: :all
+    card_color = page.evaluate_script("document.querySelector(arguments[0]).style.getPropertyValue('--card-color').trim()", card_selector)
+    assert_equal in_progress.color.to_s, card_color
+    wait_until { card.reload.open? && card.column == in_progress }
+
+    # 4. In progress -> Done -> Not Now (verify only one reopen event)
+    expand_column(in_progress)
+    drag_and_drop(card_selector, "#closed-cards")
+    wait_until { card.reload.closed? }
+
+    reopen_events_before = card.events.where(action: "card_reopened").count
+    expand_column_by_id("closed-cards")
+    drag_and_drop(card_selector, "#not-now")
+    wait_until { card.reload.postponed? && card.open? }
+    assert_equal reopen_events_before + 1, card.events.where(action: "card_reopened").count
+
+    # 5. Not Now -> Maybe?
+    expand_column_by_id("not-now")
+    drag_and_drop(card_selector, "#maybe")
+    assert_selector "#maybe #{card_selector}.card--active"
+    assert_no_selector "#maybe #{card_selector}.card--postponed"
+    wait_until { card.reload.awaiting_triage? }
+  end
+
+  test "golden-first ordering matches server order on drop with no shifting" do
+    in_progress = columns(:writebook_in_progress)
+    golden_existing = cards(:text)
+    golden_existing.gild
+
+    regular_card = cards(:buy_domain)
