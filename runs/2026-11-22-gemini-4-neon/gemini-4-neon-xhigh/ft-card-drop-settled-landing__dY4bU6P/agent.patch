diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..44e3711
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,461 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { post, destroy } from "@rails/request.js"
+import { onNextEventLoopTick } from "helpers/timing_helpers"
+import { isMobile } from "helpers/platform_helpers"
+
+const MAX_PROGRESS_COUNT = 15 // should match first geared pagination page size
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "container", "item" ]
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  #draggedItem = null
+  #sourceContainer = null
+  #hoveredContainer = null
+  #pendingSaves = Promise.resolve()
+  #inFlightSaves = 0
+  #dropVersion = 0
+  #containerDropVersion = new WeakMap()
+  #frameFetchVersion = new WeakMap()
+  #staleFrames = new Set()
+  #needsPageRefresh = false
+  #mediaQuery = null
+  #handleMediaChange = null
+
+  connect() {
+    this.#mediaQuery = window.matchMedia(this.desktopBreakpointValue)
+    this.#handleMediaChange = () => this.#updateDraggableItems()
+    this.#mediaQuery.addEventListener("change", this.#handleMediaChange)
+    this.#updateDraggableItems()
+  }
+
+  disconnect() {
+    this.#mediaQuery?.removeEventListener("change", this.#handleMediaChange)
+    this.#resetDragState()
+    this.itemTargets.forEach(item => item.removeAttribute("draggable"))
+  }
+
+  itemTargetConnected(item) {
+    this.#updateDraggableItem(item)
+  }
+
+  // Actions
+
+  dragStart(event) {
+    if (!this.#isDragEnabled) {
+      event.preventDefault()
+      return
+    }
+
+    const item = event.currentTarget
+    const sourceContainer = this.#containerFor(item)
+    if (!sourceContainer) return
+
+    this.#draggedItem = item
+    this.#sourceContainer = sourceContainer
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.id || "")
+    }
+
+    onNextEventLoopTick(() => {
+      if (this.#draggedItem === item) {
+        item.classList.add(this.draggedItemClass)
+      }
+    })
+  }
+
+  dragEnter(event) {
+    this.#handleDragHover(event)
+  }
+
+  dragOver(event) {
+    this.#handleDragHover(event)
+  }
+
+  dragLeave(event) {
+    if (!this.#draggedItem) return
+
+    const container = event.currentTarget
+    if (container === this.#hoveredContainer && !container.contains(event.relatedTarget)) {
+      this.#clearHoverContainer()
+    }
+  }
+
+  drop(event) {
+    if (!this.#draggedItem) return
+
+    const item = this.#draggedItem
+    const sourceContainer = this.#sourceContainer
+    const targetContainer = event.currentTarget
+
+    this.#resetDragState()
+
+    if (targetContainer === sourceContainer) return
+
+    event.preventDefault()
+
+    this.#dropVersion += 1
+    this.#containerDropVersion.set(sourceContainer, this.#dropVersion)
+    this.#containerDropVersion.set(targetContainer, this.#dropVersion)
+    this.#inFlightSaves += 1
+
+    const snapshot = this.#captureSnapshot(item, sourceContainer, targetContainer)
+    const insertedIntoList = this.#moveItem(item, sourceContainer, targetContainer)
+
+    this.#enqueueSave(() => this.#persistMove(item, targetContainer, snapshot, insertedIntoList))
+  }
+
+  dragEnd() {
+    this.#resetDragState()
+  }
+
+  refresh() {
+    this.#updateDraggableItems()
+  }
+
+  preserveDragAttributes(event) {
+    const { attributeName } = event.detail
+    const target = event.target
+
+    if (attributeName === "draggable" && this.#isDragEnabled && target.matches('[data-drag-and-drop-target~="item"]')) {
+      event.preventDefault()
+    } else if (attributeName === "class" && (target === this.#draggedItem || target === this.#hoveredContainer)) {
+      event.preventDefault()
+    }
+  }
+
+  trackFrameFetch(event) {
+    const frame = event.target
+    if (frame?.tagName === "TURBO-FRAME") {
+      this.#frameFetchVersion.set(frame, this.#dropVersion)
+    }
+  }
+
+  preventStaleFrameRender(event) {
+    const frame = event.target
+    if (frame?.tagName !== "TURBO-FRAME") return
+
+    const container = this.#containerFor(frame)
+    if (!container) return
+
+    const containerVersion = this.#containerDropVersion.get(container) || 0
+    const fetchVersion = this.#frameFetchVersion.get(frame) ?? 0
+
+    if (fetchVersion < containerVersion || (this.#inFlightSaves > 0 && containerVersion > 0)) {
+      event.detail.render = () => {}
+
+      if (this.#inFlightSaves > 0) {
+        this.#staleFrames.add(frame)
+      } else {
+        onNextEventLoopTick(() => {
+          if (frame.isConnected) frame.reload()
+        })
+      }
+    }
+  }
+
+  preventStalePageMorph(event) {
+    if (event.detail.renderMethod === "morph" && this.#inFlightSaves > 0) {
+      event.detail.render = () => {}
+      this.#needsPageRefresh = true
+    }
+  }
+
+  // Private
+
+  get #isDragEnabled() {
+    if (isMobile()) return false
+
+    const mediaQuery = this.#mediaQuery || window.matchMedia(this.desktopBreakpointValue)
+    return mediaQuery.matches
+  }
+
+  #updateDraggableItems() {
+    this.itemTargets.forEach(item => this.#updateDraggableItem(item))
+  }
+
+  #updateDraggableItem(item) {
+    if (this.#isDragEnabled) {
+      item.setAttribute("draggable", "true")
+    } else {
+      item.removeAttribute("draggable")
+    }
+  }
+
+  #containerFor(element) {
+    return element.closest('[data-drag-and-drop-target~="container"]')
+  }
+
+  #handleDragHover(event) {
+    if (!this.#draggedItem) return
+
+    const container = event.currentTarget
+    if (container === this.#sourceContainer) {
+      this.#clearHoverContainer()
+      return
+    }
+
+    event.preventDefault()
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    this.#setHoverContainer(container)
+  }
+
+  #setHoverContainer(container) {
+    if (this.#hoveredContainer === container) return
+
+    this.#clearHoverContainer()
+    this.#hoveredContainer = container
+    this.#hoveredContainer.classList.add(this.hoverContainerClass)
+  }
+
+  #clearHoverContainer() {
+    this.#hoveredContainer?.classList.remove(this.hoverContainerClass)
+    this.#hoveredContainer = null
+  }
+
+  #resetDragState() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#clearHoverContainer()
+    this.#draggedItem = null
+    this.#sourceContainer = null
+  }
+
+  #captureSnapshot(item, sourceContainer, targetContainer) {
+    const updatedTime = item.querySelector(".card__meta-text--updated time")
+    const bubble = item.querySelector(".bubble")
+
+    return {
+      sourceContainer,
+      targetContainer,
+      previousParent: item.parentElement,
+      previousNextSibling: item.nextElementSibling,
+      previousCardColor: item.style.getPropertyValue("--card-color"),
+      wasActive: item.classList.contains("card--active"),
+      wasPostponed: item.classList.contains("card--postponed"),
+      stamps: Array.from(item.querySelectorAll(".card__closed")).map(stamp => ({
+        element: stamp,
+        parent: stamp.parentElement,
+        nextSibling: stamp.nextElementSibling
+      })),
+      previousUpdatedDatetime: updatedTime?.getAttribute("datetime"),
+      previousBubble: bubble ? {
+        hidden: bubble.hidden,
+        entropy: bubble.dataset.bubbleEntropyValue,
+        stalled: bubble.dataset.bubbleStalledValue
+      } : null
+    }
+  }
+
+  #moveItem(item, sourceContainer, targetContainer) {
+    this.#clearNavigableSelection(item, sourceContainer)
+    this.#updateItemState(item, targetContainer)
+
+    const insertedIntoList = this.#insertIntoContainer(item, targetContainer)
+
+    this.#adjustCount(sourceContainer, -1)
+    this.#adjustCount(targetContainer, +1)
+
+    return insertedIntoList
+  }
+
+  #clearNavigableSelection(item, sourceContainer) {
+    item.removeAttribute("aria-selected")
+
+    const listElement = sourceContainer.querySelector('[data-controller~="navigable-list"]')
+    const listController = listElement && this.application.getControllerForElementAndIdentifier(listElement, "navigable-list")
+    if (listController?.isSelected(item)) {
+      listController.clearSelection()
+    }
+  }
+
+  #updateItemState(item, targetContainer) {
+    item.classList.remove("card--active", "card--postponed")
+    item.querySelectorAll(".card__closed").forEach(stamp => stamp.remove())
+
+    const dropKind = targetContainer.dataset.dropKind
+    if (dropKind === "column" || dropKind === "stream") {
+      item.classList.add("card--active")
+      if (targetContainer.dataset.cardColor) {
+        item.style.setProperty("--card-color", targetContainer.dataset.cardColor)
+      }
+    } else if (dropKind === "not-now") {
+      item.classList.add("card--postponed")
+      item.style.setProperty("--card-color", "var(--color-card-default)")
+    }
+
+    const updatedTime = item.querySelector(".card__meta-text--updated time")
+    if (updatedTime) {
+      updatedTime.setAttribute("datetime", Math.floor(Date.now() / 1000))
+    }
+
+    const bubble = item.querySelector(".bubble")
+    if (bubble) {
+      bubble.hidden = true
+      bubble.dataset.bubbleEntropyValue = "{}"
+      bubble.dataset.bubbleStalledValue = "{}"
+    }
+  }
+
+  #insertIntoContainer(item, targetContainer) {
+    const cardsList = targetContainer.querySelector(".cards__list")
+    if (!cardsList) {
+      item.remove()
+      return false
+    }
+
+    const existingCards = Array.from(cardsList.querySelectorAll('[data-drag-and-drop-target~="item"]'))
+    const goldenFirst = targetContainer.dataset.goldenFirst === "true"
+    const isGolden = item.classList.contains("golden-effect")
+
+    if (existingCards.length === 0) {
+      const targetParent = cardsList.querySelector("turbo-frame") || cardsList
+      targetParent.prepend(item)
+    } else if (!goldenFirst || isGolden) {
+      existingCards[0].before(item)
+    } else {
+      const firstNonGolden = existingCards.find(card => !card.classList.contains("golden-effect"))
+      if (firstNonGolden) {
+        firstNonGolden.before(item)
+      } else {
+        existingCards[existingCards.length - 1].after(item)
+      }
+    }
+
+    return true
+  }
+
+  #adjustCount(container, delta) {
+    const countElement = container.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const currentCount = parseInt(countElement.dataset.count ?? countElement.textContent, 10)
+    if (Number.isNaN(currentCount)) return
+
+    const nextCount = Math.max(0, currentCount + delta)
+    countElement.dataset.count = nextCount
+    countElement.textContent = nextCount > 99 ? "99+" : String(nextCount)
+
+    const counterButton = container.querySelector('[data-css-variable-counter-target="counter"]')
+    if (counterButton) {
+      counterButton.style.setProperty("--card-count", Math.min(nextCount, MAX_PROGRESS_COUNT))
+    }
+  }
+
+  #enqueueSave(saveFn) {
+    const result = this.#pendingSaves.then(saveFn, saveFn)
+    this.#pendingSaves = result.catch(() => {})
+    return result
+  }
+
+  async #persistMove(item, targetContainer, snapshot, insertedIntoList) {
+    try {
+      const response = await this.#sendMoveRequest(item, targetContainer)
+
+      if (!response.ok) {
+        this.#revertMove(item, snapshot)
+        return
+      }
+
+      if (!insertedIntoList) {
+        const targetFrame = targetContainer.querySelector("turbo-frame")
+        if (targetFrame) this.#staleFrames.add(targetFrame)
+      }
+    } catch {
+      this.#revertMove(item, snapshot)
+    } finally {
+      this.#inFlightSaves -= 1
+      if (this.#inFlightSaves === 0) {
+        this.#flushDeferredRefreshes()
+      }
+    }
+  }
+
+  #flushDeferredRefreshes() {
+    if (this.#needsPageRefresh) {
+      this.#needsPageRefresh = false
+      this.#staleFrames.clear()
+      Turbo.visit(window.location.href, { action: "replace" })
+      return
+    }
+
+    if (this.#staleFrames.size > 0) {
+      const frames = Array.from(this.#staleFrames)
+      this.#staleFrames.clear()
+      frames.forEach(frame => {
+        if (frame.isConnected) frame.reload()
+      })
+    }
+  }
+
+  #sendMoveRequest(item, targetContainer) {
+    const options = { responseKind: "json", keepalive: true }
+
+    switch (targetContainer.dataset.dropKind) {
+      case "not-now":
+        return post(item.dataset.cardNotNowUrl, options)
+      case "closed":
+        return post(item.dataset.cardClosureUrl, options)
+      case "stream":
+        return destroy(item.dataset.cardTriageUrl, options)
+      case "column":
+        return post(item.dataset.cardTriageUrl, {
+          ...options,
+          body: { column_id: targetContainer.dataset.columnId }
+        })
+    }
+  }
+
+  #revertMove(item, snapshot) {
+    if (!snapshot.previousParent?.isConnected || (item.isConnected && this.#containerFor(item) !== snapshot.targetContainer)) {
+      Turbo.visit(window.location.href, { action: "replace" })
+      return
+    }
+
+    item.classList.toggle("card--active", snapshot.wasActive)
+    item.classList.toggle("card--postponed", snapshot.wasPostponed)
+
+    if (snapshot.previousCardColor) {
+      item.style.setProperty("--card-color", snapshot.previousCardColor)
+    } else {
+      item.style.removeProperty("--card-color")
+    }
+
+    snapshot.stamps.forEach(({ element, parent, nextSibling }) => {
+      if (nextSibling?.parentElement === parent) {
+        nextSibling.before(element)
+      } else {
+        parent?.append(element)
+      }
+    })
+
+    const updatedTime = item.querySelector(".card__meta-text--updated time")
+    if (updatedTime && snapshot.previousUpdatedDatetime != null) {
+      updatedTime.setAttribute("datetime", snapshot.previousUpdatedDatetime)
+    }
+
+    const bubble = item.querySelector(".bubble")
+    if (bubble && snapshot.previousBubble) {
+      bubble.hidden = snapshot.previousBubble.hidden
+      bubble.dataset.bubbleEntropyValue = snapshot.previousBubble.entropy
+      bubble.dataset.bubbleStalledValue = snapshot.previousBubble.stalled
+    }
+
+    if (snapshot.previousNextSibling?.parentElement === snapshot.previousParent) {
+      snapshot.previousNextSibling.before(item)
+    } else {
+      snapshot.previousParent.append(item)
+    }
+
+    this.#adjustCount(snapshot.sourceContainer, +1)
+    this.#adjustCount(snapshot.targetContainer, -1)
+  }
+}
