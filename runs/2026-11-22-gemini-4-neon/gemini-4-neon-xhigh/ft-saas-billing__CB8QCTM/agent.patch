+<% if Current.user.admin? %>
+  <section class="settings__section">
+    <header>
+      <h2 class="divider">Subscription</h2>
+    </header>
+
+    <% if @account.active_subscription&.paid? %>
+      <div class="flex flex-column gap-half">
+        <div>
+          <strong><%= @account.plan.name %></strong> — $<%= @account.plan.price %>/month
+        </div>
+
+        <div class="txt-small txt-ink-medium">
+          Unlimited cards · <%= number_to_human_size(@account.bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %> storage used
+        </div>
+
+        <% if @account.active_subscription.past_due? %>
+          <div class="txt-small txt-negative">
+            Your last payment failed. Please update your payment method.
+          </div>
+        <% elsif @account.active_subscription.to_be_canceled? %>
+          <div class="txt-small txt-ink-medium">
+            Cancels on <%= @account.active_subscription.cancel_at.strftime("%B %-d, %Y") %>.
+          </div>
+        <% elsif @account.active_subscription.current_period_end.present? %>
+          <div class="txt-small txt-ink-medium">
+            Renews on <%= @account.active_subscription.current_period_end.strftime("%B %-d, %Y") %>.
+          </div>
+        <% end %>
+
+        <div class="margin-block-start-half">
+          <%= button_to "Manage billing", saas.account_billing_portal_path, method: :post, class: "btn settings-subscription__button", data: { turbo: false } %>
+        </div>
+      </div>
+    <% elsif @account.comped? %>
+      <div class="flex flex-column gap-half">
+        <div>
+          <strong><%= @account.plan.name %></strong> (Comped)
+        </div>
+
+        <div class="txt-small txt-ink-medium">
+          Unlimited cards · <%= number_to_human_size(@account.bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %> storage used
+        </div>
+      </div>
+    <% else %>
+      <div class="flex flex-column gap-half">
+        <div>
+          <strong><%= @account.plan.name %></strong> —
+          <%= number_with_delimiter(@account.card_count) %> of <%= number_with_delimiter(@account.card_limit) %> cards ·
+          <%= number_to_human_size(@account.bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %> storage
+        </div>
+
+        <%= form_with url: saas.account_subscription_path, method: :post, data: { turbo: false }, class: "flex flex-column gap-half margin-block-start-half" do |form| %>
+          <div class="flex flex-column gap-quarter txt-align-start">
+            <% Plan.paid_plans.each_with_index do |plan, index| %>
+              <label class="flex align-center gap-half">
+                <%= form.radio_button :plan_key, plan.key, checked: index.zero? %>
+                <span>
+                  <strong><%= plan.name %></strong> — $<%= plan.price %>/month
+                  <span class="txt-small txt-ink-medium">(Unlimited cards, <%= number_to_human_size(plan.storage_limit) %>)</span>
+                </span>
+              </label>
+            <% end %>
+          </div>
+
+          <div class="margin-block-start-half">
+            <%= form.button "Upgrade", class: "btn btn--link settings-subscription__button" %>
+          </div>
+        <% end %>
+      </div>
+    <% end %>
+  </section>
+<% end %>
