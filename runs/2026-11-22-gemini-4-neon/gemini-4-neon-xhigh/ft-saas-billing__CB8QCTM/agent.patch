diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..30fbabd
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,359 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  WEBHOOK_SECRET = "whsec_test_secret_12345"
+
+  test "rejects missing or invalid signature" do
+    with_stripe_env do
+      untenanted do
+        post "/stripe/webhooks",
+          params: { id: "evt_bad", type: "customer.subscription.created" }.to_json,
+          headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "t=123,v1=invalid" }
+      end
+
+      assert_response :bad_request
+    end
+  end
+
+  test "rejects webhook when secret is not configured" do
+    with_env("STRIPE_WEBHOOK_SECRET" => nil) do
+      untenanted do
+        post "/stripe/webhooks",
+          params: { id: "evt_nosecret", type: "customer.subscription.created" }.to_json,
+          headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "t=123,v1=invalid" }
+      end
+
+      assert_response :bad_request
+    end
+  end
+
+  test "customer.subscription.created activates Unlimited plan and 5 GB storage" do
+    account = accounts(:initech)
+    account.create_subscription!(stripe_customer_id: "cus_wh_1")
+    period_end = 1.month.from_now.change(usec: 0)
+
+    with_stripe_env do
+      post_webhook(
+        id: "evt_sub_created",
+        type: "customer.subscription.created",
+        data: {
+          object: {
+            id: "sub_wh_1",
+            object: "subscription",
+            customer: "cus_wh_1",
+            status: "active",
+            cancel_at: nil,
+            items: {
+              data: [
+                {
+                  current_period_end: period_end.to_i,
+                  price: { id: "price_unlimited_wh", unit_amount: 2000 }
+                }
+              ]
+            }
+          }
+        }
+      )
+
+      assert_response :ok
+      account.reload
+      assert_equal Plan.paid, account.plan
+      assert_equal 5.gigabytes, account.storage_limit
+      assert_equal "sub_wh_1", account.subscription.stripe_subscription_id
+      assert_equal "active", account.subscription.status
+      assert_equal period_end.to_i, account.subscription.current_period_end.to_i
+      assert_equal 2000, account.subscription.next_amount_due_in_cents
+    end
+  end
+
+  test "customer.subscription.created can link account via metadata when no prior subscription row exists" do
+    account = accounts(:acme)
+
+    with_stripe_env do
+      post_webhook(
+        id: "evt_sub_meta",
+        type: "customer.subscription.created",
+        data: {
+          object: {
+            id: "sub_meta_1",
+            object: "subscription",
+            customer: "cus_meta_1",
+            status: "active",
+            metadata: { account_id: account.id },
+            items: {
+              data: [
+                {
+                  current_period_end: 1.month.from_now.to_i,
+                  price: { id: "price_unlimited_wh", unit_amount: 2000 }
+                }
+              ]
+            }
+          }
+        }
+      )
+
+      assert_response :ok
+      account.reload
+      assert_equal Plan.paid, account.plan
+      assert_equal "cus_meta_1", account.subscription.stripe_customer_id
+      assert_equal "sub_meta_1", account.subscription.stripe_subscription_id
+    end
+  end
+
+  test "customer.subscription.updated switches between Unlimited and Unlimited+ and updates cancellation" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_wh_2",
+      stripe_subscription_id: "sub_wh_2",
+      status: "active"
+    )
+    cancel_at = 2.weeks.from_now.change(usec: 0)
+
+    with_stripe_env do
+      post_webhook(
+        id: "evt_sub_upgrade",
+        type: "customer.subscription.updated",
+        data: {
+          object: {
+            id: "sub_wh_2",
+            object: "subscription",
+            customer: "cus_wh_2",
+            status: "active",
+            cancel_at: cancel_at.to_i,
+            items: {
+              data: [
+                {
+                  current_period_end: cancel_at.to_i,
+                  price: { id: "price_plus_wh", unit_amount: 2500 }
+                }
+              ]
+            }
+          }
+        }
+      )
+
+      assert_response :ok
+      account.reload
+      assert_equal Plan.extra_storage, account.plan
+      assert_equal 500.gigabytes, account.storage_limit
+      assert account.subscription.to_be_canceled?
+      assert_equal cancel_at.to_i, account.subscription.cancel_at.to_i
+
+      # Resume subscription
+      post_webhook(
+        id: "evt_sub_resume",
+        type: "customer.subscription.updated",
+        data: {
+          object: {
+            id: "sub_wh_2",
+            object: "subscription",
+            customer: "cus_wh_2",
+            status: "active",
+            cancel_at: nil,
+            items: {
+              data: [
+                {
+                  current_period_end: cancel_at.to_i,
+                  price: { id: "price_plus_wh", unit_amount: 2500 }
+                }
+              ]
+            }
+          }
+        }
+      )
+
+      assert_response :ok
+      assert_not account.subscription.reload.to_be_canceled?
+    end
+  end
+
+  test "customer.subscription.deleted reverts account to Free plan and 1 GB storage" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      plan_key: "monthly_extra_storage_v1",
+      stripe_customer_id: "cus_wh_3",
+      stripe_subscription_id: "sub_wh_3",
+      status: "active"
+    )
+
+    with_stripe_env do
+      post_webhook(
+        id: "evt_sub_deleted",
+        type: "customer.subscription.deleted",
+        data: {
+          object: {
+            id: "sub_wh_3",
+            object: "subscription",
+            customer: "cus_wh_3",
+            status: "canceled",
+            items: {
+              data: [
+                {
+                  price: { id: "price_plus_wh", unit_amount: 2500 }
+                }
+              ]
+            }
+          }
+        }
+      )
+
+      assert_response :ok
+      account.reload
+      assert_equal Plan.free, account.plan
+      assert_equal 1.gigabyte, account.storage_limit
+      assert account.subscription.canceled?
+      assert_nil account.active_subscription
+      assert_nil account.subscription.next_amount_due_in_cents
+    end
+  end
+
+  test "stale customer.subscription.deleted for older subscription does not clobber newer active subscription" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_wh_stale",
+      stripe_subscription_id: "sub_new",
+      status: "active"
+    )
+
+    with_stripe_env do
+      post_webhook(
+        id: "evt_stale_delete",
+        type: "customer.subscription.deleted",
+        data: {
+          object: {
+            id: "sub_old",
+            object: "subscription",
+            customer: "cus_wh_stale",
+            status: "canceled"
+          }
+        }
+      )
+
+      assert_response :ok
+      account.reload
+      assert_equal "sub_new", account.subscription.stripe_subscription_id
+      assert account.subscription.active?
+      assert_equal Plan.paid, account.plan
+    end
+  end
+
+  test "checkout.session.completed links subscription to account" do
+    account = accounts(:acme)
+
+    with_stripe_env do
+      post_webhook(
+        id: "evt_checkout_done",
+        type: "checkout.session.completed",
+        data: {
+          object: {
+            id: "cs_test_1",
+            object: "checkout.session",
+            mode: "subscription",
+            customer: "cus_checkout_1",
+            subscription: "sub_checkout_1",
+            client_reference_id: account.id,
+            payment_status: "paid",
+            metadata: { account_id: account.id, plan_key: "monthly_v1" }
+          }
+        }
+      )
+
+      assert_response :ok
+      account.reload
+      assert_equal "cus_checkout_1", account.subscription.stripe_customer_id
+      assert_equal "sub_checkout_1", account.subscription.stripe_subscription_id
+      assert_equal Plan.paid, account.plan
+    end
+  end
+
+  test "invoice.upcoming updates next_amount_due_in_cents" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_inv",
+      stripe_subscription_id: "sub_inv",
+      status: "active"
+    )
+
+    with_stripe_env do
+      post_webhook(
+        id: "evt_inv_upcoming",
+        type: "invoice.upcoming",
+        data: {
+          object: {
+            id: "in_upcoming",
+            object: "invoice",
+            customer: "cus_inv",
+            subscription: "sub_inv",
+            amount_due: 2500
+          }
+        }
+      )
+
+      assert_response :ok
+      assert_equal 2500, account.subscription.reload.next_amount_due_in_cents
+    end
+  end
+
+  test "unhandled event type and unknown customer return ok" do
+    with_stripe_env do
+      post_webhook(
+        id: "evt_other",
+        type: "payment_intent.created",
+        data: { object: { id: "pi_123", object: "payment_intent" } }
+      )
+      assert_response :ok
+
+      post_webhook(
+        id: "evt_unknown_cus",
+        type: "customer.subscription.updated",
+        data: {
+          object: {
+            id: "sub_unknown",
+            object: "subscription",
+            customer: "cus_does_not_exist",
+            status: "active"
+          }
+        }
+      )
+      assert_response :ok
+    end
+  end
+
+  private
+    def post_webhook(payload_hash)
+      payload = payload_hash.to_json
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, WEBHOOK_SECRET)
+      header = Stripe::Webhook::Signature.generate_header(
+        timestamp,
+        signature,
+        scheme: Stripe::Webhook::Signature::EXPECTED_SCHEME
+      )
+
+      untenanted do
+        post "/stripe/webhooks",
+          params: payload,
+          headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => header }
+      end
+    end
+
+    def with_stripe_env(&block)
+      with_env(
+        "STRIPE_WEBHOOK_SECRET" => WEBHOOK_SECRET,
+        "STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited_wh",
+        "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus_wh",
+        &block
+      )
+    end
+
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
diff --git a/saas/test/integration/billing_flow_test.rb b/saas/test/integration/billing_flow_test.rb
