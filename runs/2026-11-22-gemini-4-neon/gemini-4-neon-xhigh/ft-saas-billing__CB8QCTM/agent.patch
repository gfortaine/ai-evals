+require "test_helper"
+
+class Card::Limited::PublishingTest < ActionDispatch::IntegrationTest
+  test "cannot publish card when free account runs out of cards" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "cannot publish card via JSON when free account runs out of cards" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug), as: :json
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "can publish card when free account is under limit" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 999)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "paid account can publish card beyond 1,000 cards" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_500)
+    accounts(:initech).create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_pub",
+      stripe_subscription_id: "sub_pub",
+      status: "active"
+    )
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "paid Unlimited plan allows publishing when storage is between 1 GB and 5 GB" do
+    sign_in_as :mike
+    accounts(:initech).override_limits(bytes_used: 3.gigabytes)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+
+    accounts(:initech).create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_storage_pub",
+      stripe_subscription_id: "sub_storage_pub",
+      status: "active"
+    )
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "paid Unlimited+ plan allows publishing when storage is between 5 GB and 500 GB" do
+    sign_in_as :mike
+    accounts(:initech).override_limits(bytes_used: 50.gigabytes)
+    accounts(:initech).create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_plus_pub",
+      stripe_subscription_id: "sub_plus_pub",
+      status: "active"
+    )
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+    assert_response :forbidden
+
+    accounts(:initech).subscription.update!(plan_key: "monthly_extra_storage_v1")
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+end
