--- /dev/null
+++ b/saas/test/jobs/account/cancel_subscription_job_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Account::CancelSubscriptionJobTest < ActiveJob::TestCase
+  test "cancels active subscription in Stripe" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_job",
+      stripe_subscription_id: "sub_job",
+      status: "active"
+    )
+
+    Stripe::Subscription.expects(:cancel).with("sub_job").once
+
+    Account::CancelSubscriptionJob.perform_now(account)
+  end
+
+  test "ignores already missing subscription in Stripe" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_missing",
+      stripe_subscription_id: "sub_missing",
+      status: "active"
+    )
+
+    error = Stripe::InvalidRequestError.new("No such subscription", nil, code: "resource_missing")
+    Stripe::Subscription.expects(:cancel).with("sub_missing").raises(error)
+
+    assert_nothing_raised do
+      Account::CancelSubscriptionJob.perform_now(account)
+    end
+  end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..58ee7b1
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,191 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "defaults to free plan with 1,000 cards and 1 GB storage" do
+    assert_equal Plan.free, @account.plan
+    assert @account.free?
+    assert_not @account.paid?
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_nil @account.active_subscription
+  end
+
+  test "nearing and exceeding card limits on free plan" do
+    @account.update_column(:cards_count, 899)
+    assert_equal 101, @account.cards_remaining
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 900)
+    assert_equal 100, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 950)
+    assert_equal 50, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 999)
+    assert_equal 1, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 1_000)
+    assert_equal 0, @account.cards_remaining
+    assert_not @account.nearing_card_limit?
+    assert @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 1_250)
+    assert_equal 0, @account.cards_remaining
+    assert_not @account.nearing_card_limit?
+    assert @account.exceeding_card_limit?
+  end
+
+  test "active Unlimited subscription removes card limit and grants 5 GB storage" do
+    @account.update_column(:cards_count, 1_500)
+    @account.create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_unlimited",
+      stripe_subscription_id: "sub_unlimited",
+      status: "active"
+    )
+
+    assert_equal Plan.paid, @account.plan
+    assert @account.paid?
+    assert_not @account.free?
+    assert_equal Float::INFINITY, @account.cards_remaining
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.override_limits(bytes_used: 3.gigabytes)
+    assert_not @account.exceeding_storage_limit?
+
+    @account.override_limits(bytes_used: 5.gigabytes + 1)
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "active Unlimited+ subscription grants 500 GB storage" do
+    @account.create_subscription!(
+      plan_key: "monthly_extra_storage_v1",
+      stripe_customer_id: "cus_plus",
+      stripe_subscription_id: "sub_plus",
+      status: "active"
+    )
+
+    assert_equal Plan.extra_storage, @account.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    @account.override_limits(bytes_used: 100.gigabytes)
+    assert_not @account.exceeding_storage_limit?
+
+    @account.override_limits(bytes_used: 500.gigabytes + 1)
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "canceled subscription reverts account to free plan" do
+    @account.update_column(:cards_count, 1_000)
+    @account.create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_canceled",
+      stripe_subscription_id: "sub_canceled",
+      status: "canceled"
+    )
+
+    assert_nil @account.active_subscription
+    assert_equal Plan.free, @account.plan
+    assert @account.exceeding_card_limit?
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comp and uncomp toggle billing waiver and plan" do
+    @account.update_column(:cards_count, 1_200)
+    assert @account.exceeding_card_limit?
+
+    @account.comp
+    assert @account.comped?
+    assert_equal Plan.paid, @account.plan
+    assert_not @account.exceeding_card_limit?
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    # Idempotent comp
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp
+    end
+
+    @account.uncomp
+    assert_not @account.comped?
+    assert_equal Plan.free, @account.plan
+    assert @account.exceeding_card_limit?
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "override_limits overrides card_count and bytes_used without mutating real values" do
+    @account.update_column(:cards_count, 5)
+    @account.override_limits(card_count: 950, bytes_used: 2.gigabytes)
+
+    assert_equal 950, @account.card_count
+    assert_equal 5, @account.cards_count
+    assert_equal 50, @account.cards_remaining
+    assert @account.nearing_card_limit?
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert_equal 0, @account.actual_bytes_used
+    assert @account.exceeding_storage_limit?
+
+    @account.reset_overridden_limits
+    assert_nil @account.overridden_limits
+    assert_equal 5, @account.card_count
+    assert_equal 0, @account.bytes_used
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_storage_limit?
+  end
+
+  test "override_limits supports zero values" do
+    @account.update_column(:cards_count, 1_000)
+    @account.override_limits(card_count: 0, bytes_used: 0)
+
+    assert_equal 0, @account.card_count
+    assert_equal 0, @account.bytes_used
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "canceling account with active subscription enqueues cancel subscription job" do
+    @account.create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_cancel_job",
+      stripe_subscription_id: "sub_cancel_job",
+      status: "active"
+    )
+
+    assert_enqueued_with(job: Account::CancelSubscriptionJob, args: [ @account ]) do
+      @account.cancel(initiated_by: users(:mike))
+    end
+  end
+
+  test "canceling account without active subscription does not enqueue cancel subscription job" do
+    assert_no_enqueued_jobs only: Account::CancelSubscriptionJob do
+      @account.cancel(initiated_by: users(:mike))
+    end
+  end
+
+  test "storage_limit uses max of storage_exception and plan allowance" do
+    @account.add_storage_exception(2.gigabytes)
+    assert_equal 2.gigabytes, @account.storage_limit
+
+    @account.create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_max_storage",
+      stripe_subscription_id: "sub_max_storage",
+      status: "active"
+    )
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.add_storage_exception(10.gigabytes)
+    assert_equal 10.gigabytes, @account.storage_limit
+  end
+end
diff --git a/saas/test/models/account/overridden_limits_test.rb b/saas/test/models/account/overridden_limits_test.rb
