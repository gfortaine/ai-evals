+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "free plan pricing and limits" do
+    plan = Plan.free
+
+    assert_equal :free_v1, plan.key
+    assert_equal "Free", plan.name
+    assert_equal 0, plan.price
+    assert_equal 1_000, plan.card_limit
+    assert_equal 1.gigabyte, plan.storage_limit
+    assert plan.free?
+    assert_not plan.paid?
+    assert plan.limit_cards?
+    assert_nil plan.stripe_price_id
+  end
+
+  test "unlimited plan pricing and limits" do
+    plan = Plan.paid
+
+    assert_equal :monthly_v1, plan.key
+    assert_equal "Unlimited", plan.name
+    assert_equal 20, plan.price
+    assert_equal Float::INFINITY, plan.card_limit
+    assert_equal 5.gigabytes, plan.storage_limit
+    assert_not plan.free?
+    assert plan.paid?
+    assert_not plan.limit_cards?
+  end
+
+  test "unlimited plus plan pricing and limits" do
+    plan = Plan.extra_storage
+
+    assert_equal :monthly_extra_storage_v1, plan.key
+    assert_equal "Unlimited+", plan.name
+    assert_equal 25, plan.price
+    assert_equal Float::INFINITY, plan.card_limit
+    assert_equal 500.gigabytes, plan.storage_limit
+    assert_not plan.free?
+    assert plan.paid?
+    assert_not plan.limit_cards?
+  end
+
+  test "find resolves by string or symbol and returns nil for unknown" do
+    assert_equal Plan.free, Plan.find("free_v1")
+    assert_equal Plan.paid, Plan.find(:monthly_v1)
+    assert_equal Plan.extra_storage, Plan.find("monthly_extra_storage_v1")
+    assert_nil Plan.find(nil)
+    assert_nil Plan.find("")
+    assert_nil Plan.find("nonexistent")
+  end
+
+  test "find_by_price_id reads env dynamically and ignores blank price ids" do
+    with_env("STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited_123", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus_456") do
+      assert_equal "price_unlimited_123", Plan.paid.stripe_price_id
+      assert_equal "price_plus_456", Plan.extra_storage.stripe_price_id
+      assert_equal Plan.paid, Plan.find_by_price_id("price_unlimited_123")
+      assert_equal Plan.extra_storage, Plan.find_by_price_id("price_plus_456")
+      assert_nil Plan.find_by_price_id(nil)
+      assert_nil Plan.find_by_price_id("")
+      assert_nil Plan.find_by_price_id("price_unknown")
+    end
+  end
+
+  private
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
