@@ -0,0 +1,18 @@
+class Account::BillingPortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    stripe_customer_id = Current.account.subscription&.stripe_customer_id
+
+    if stripe_customer_id.present?
+      Stripe.api_key ||= ENV["STRIPE_SECRET_KEY"]
+      portal_session = Stripe::BillingPortal::Session.create(
+        customer: stripe_customer_id,
+        return_url: main_app.account_settings_url
+      )
+      redirect_to portal_session.url, allow_other_host: true, status: :see_other
+    else
+      redirect_to main_app.account_settings_path, alert: "No billing account found."
+    end
+  end
+end
diff --git a/saas/app/controllers/account/subscriptions_controller.rb b/saas/app/controllers/account/subscriptions_controller.rb
new file mode 100644
index 0000000..ce87093
--- /dev/null
+++ b/saas/app/controllers/account/subscriptions_controller.rb
@@ -0,0 +1,65 @@
+class Account::SubscriptionsController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+    redirect_to main_app.account_settings_path
+  end
+
+  def create
+    plan = target_plan
+    return head :unprocessable_entity unless plan&.paid?
+
+    Stripe.api_key ||= ENV["STRIPE_SECRET_KEY"]
+
+    if Current.account.active_subscription&.stripe_customer_id.present?
+      portal_session = Stripe::BillingPortal::Session.create(
+        customer: Current.account.subscription.stripe_customer_id,
+        return_url: main_app.account_settings_url
+      )
+      redirect_to portal_session.url, allow_other_host: true, status: :see_other
+    else
+      subscription = Current.account.subscription || create_stripe_customer_subscription
+      checkout_session = Stripe::Checkout::Session.create(
+        customer: subscription.stripe_customer_id,
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        success_url: main_app.account_settings_url,
+        cancel_url: main_app.account_settings_url,
+        client_reference_id: Current.account.id,
+        metadata: checkout_metadata(plan),
+        subscription_data: { metadata: checkout_metadata(plan) }
+      )
+      redirect_to checkout_session.url, allow_other_host: true, status: :see_other
+    end
+  end
+
+  private
+    def target_plan
+      if params[:plan_key].present?
+        Plan.find(params[:plan_key])
+      else
+        Plan.paid
+      end
+    end
+
+    def create_stripe_customer_subscription
+      customer = Stripe::Customer.create(
+        email: Current.user.identity.email_address,
+        name: Current.account.name,
+        metadata: {
+          account_id: Current.account.id,
+          external_account_id: Current.account.external_account_id
+        }
+      )
+
+      Current.account.create_subscription!(stripe_customer_id: customer.id)
+    end
+
+    def checkout_metadata(plan)
+      {
+        account_id: Current.account.id,
+        external_account_id: Current.account.external_account_id,
+        plan_key: plan.key.to_s
+      }
+    end
+end
