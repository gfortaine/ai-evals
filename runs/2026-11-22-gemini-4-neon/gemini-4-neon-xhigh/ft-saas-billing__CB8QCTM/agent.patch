diff --git a/saas/test/controllers/account/billing_portals_controller_test.rb b/saas/test/controllers/account/billing_portals_controller_test.rb
new file mode 100644
index 0000000..ae787d8
--- /dev/null
+++ b/saas/test/controllers/account/billing_portals_controller_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Account::BillingPortalsControllerTest < ActionDispatch::IntegrationTest
+  test "admin is redirected to Stripe Customer Portal" do
+    sign_in_as :kevin
+    accounts(:"37s").create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_portal_123",
+      stripe_subscription_id: "sub_portal_123",
+      status: "active"
+    )
+
+    Stripe::BillingPortal::Session.expects(:create).with(
+      customer: "cus_portal_123",
+      return_url: "http://www.example.com#{accounts(:"37s").slug}/account/settings"
+    ).returns(stub(url: "https://billing.stripe.com/p/session/bps_123"))
+
+    post saas.account_billing_portal_path
+
+    assert_response :see_other
+    assert_redirected_to "https://billing.stripe.com/p/session/bps_123"
+  end
+
+  test "admin without stripe customer is redirected back to settings" do
+    sign_in_as :kevin
+
+    Stripe::BillingPortal::Session.expects(:create).never
+
+    post saas.account_billing_portal_path
+
+    assert_redirected_to account_settings_path
+  end
+
+  test "non-admin cannot access billing portal" do
+    sign_in_as :david
+
+    post saas.account_billing_portal_path
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/account/settings_billing_test.rb b/saas/test/controllers/account/settings_billing_test.rb
new file mode 100644
index 0000000..5111a8b
--- /dev/null
+++ b/saas/test/controllers/account/settings_billing_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class Account::SettingsBillingTest < ActionDispatch::IntegrationTest
+  test "admin on free plan sees Free plan and Upgrade in settings" do
+    sign_in_as :kevin
+
+    get account_settings_path
+
+    assert_response :success
+    assert_match(/Free/, response.body)
+    assert_match(/Unlimited/, response.body)
+    assert_match(/\$20\/month/, response.body)
+    assert_match(/5 GB/, response.body)
+    assert_match(/Unlimited\+/, response.body)
+    assert_match(/\$25\/month/, response.body)
+    assert_match(/500 GB/, response.body)
+    assert_select "button", text: "Upgrade"
+  end
+
+  test "non-admin member does not see subscription or Upgrade in settings" do
+    sign_in_as :david
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "button", text: "Upgrade", count: 0
+    assert_select "h2", text: "Subscription", count: 0
+  end
+
+  test "admin on active Unlimited plan sees plan and Manage billing" do
+    sign_in_as :kevin
+    accounts(:"37s").create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_settings_unlim",
+      stripe_subscription_id: "sub_settings_unlim",
+      status: "active",
+      current_period_end: Time.utc(2026, 6, 15)
+    )
+
+    get account_settings_path
+
+    assert_response :success
+    assert_match(/Unlimited/, response.body)
+    assert_match(/\$20\/month/, response.body)
+    assert_match(/5 GB/, response.body)
+    assert_match(/June 15, 2026/, response.body)
+    assert_select "button", text: "Manage billing"
+    assert_select "button", text: "Upgrade", count: 0
+  end
+
+  test "admin on active Unlimited+ plan sees 500 GB allowance and Manage billing" do
+    sign_in_as :kevin
+    accounts(:"37s").create_subscription!(
+      plan_key: "monthly_extra_storage_v1",
+      stripe_customer_id: "cus_settings_plus",
+      stripe_subscription_id: "sub_settings_plus",
+      status: "active",
+      cancel_at: Time.utc(2026, 7, 1)
+    )
+
+    get account_settings_path
+
+    assert_response :success
+    assert_match(/Unlimited\+/, response.body)
+    assert_match(/\$25\/month/, response.body)
+    assert_match(/500 GB/, response.body)
+    assert_match(/Cancels on July 1, 2026/, response.body)
+    assert_select "button", text: "Manage billing"
+  end
+
+  test "admin on comped account sees Unlimited comped without Upgrade button" do
+    sign_in_as :kevin
+    accounts(:"37s").comp
+
+    get account_settings_path
+
+    assert_response :success
+    assert_match(/Unlimited/, response.body)
+    assert_match(/Comped/, response.body)
+    assert_select "button", text: "Upgrade", count: 0
+  end
+
+  test "owner sees subscription cancellation warning in danger zone when active subscription exists" do
+    sign_in_as :jason
+    accounts(:"37s").create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_cancel_notice",
+      stripe_subscription_id: "sub_cancel_notice",
+      status: "active"
+    )
+
+    get account_settings_path
+
+    assert_response :success
+    assert_match(/Your subscription will be canceled/, response.body)
+  end
+end
diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..9ad10e7
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  test "admin creates Stripe customer and redirects to Stripe Checkout for Unlimited plan" do
+    sign_in_as :kevin
+
+    with_env("STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited_test") do
+      Stripe::Customer.expects(:create).with(
+        has_entries(
+          email: "kevin@37signals.com",
+          name: accounts(:"37s").name
+        )
+      ).returns(stub(id: "cus_new_123"))
+
+      Stripe::Checkout::Session.expects(:create).with(
+        has_entries(
+          customer: "cus_new_123",
+          mode: "subscription",
+          line_items: [ { price: "price_unlimited_test", quantity: 1 } ],
+          client_reference_id: accounts(:"37s").id,
+          success_url: "http://www.example.com#{accounts(:"37s").slug}/account/settings",
+          cancel_url: "http://www.example.com#{accounts(:"37s").slug}/account/settings"
+        )
+      ).returns(stub(url: "https://checkout.stripe.com/c/pay/cs_test_123"))
+
+      post saas.account_subscription_path
+
+      assert_response :see_other
+      assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_123"
+      assert_equal "cus_new_123", accounts(:"37s").reload.subscription.stripe_customer_id
+    end
+  end
+
+  test "admin can select Unlimited+ plan for Stripe Checkout and reuses existing customer" do
+    sign_in_as :kevin
+    accounts(:"37s").create_subscription!(stripe_customer_id: "cus_existing_456")
+
+    with_env("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus_test") do
+      Stripe::Customer.expects(:create).never
+
+      Stripe::Checkout::Session.expects(:create).with(
+        has_entries(
+          customer: "cus_existing_456",
+          line_items: [ { price: "price_plus_test", quantity: 1 } ]
+        )
+      ).returns(stub(url: "https://checkout.stripe.com/c/pay/cs_test_plus"))
+
+      post saas.account_subscription_path, params: { plan_key: "monthly_extra_storage_v1" }
+
+      assert_response :see_other
+      assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_plus"
+    end
+  end
+
+  test "already active subscriber is redirected to Stripe Customer Portal" do
+    sign_in_as :kevin
+    accounts(:"37s").create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_active_789",
+      stripe_subscription_id: "sub_active_789",
+      status: "active"
+    )
+
+    Stripe::Checkout::Session.expects(:create).never
+    Stripe::BillingPortal::Session.expects(:create).with(
+      customer: "cus_active_789",
+      return_url: "http://www.example.com#{accounts(:"37s").slug}/account/settings"
+    ).returns(stub(url: "https://billing.stripe.com/p/session/bps_test"))
+
+    post saas.account_subscription_path
+
+    assert_response :see_other
+    assert_redirected_to "https://billing.stripe.com/p/session/bps_test"
+  end
+
+  test "rejects non-paid plan key" do
+    sign_in_as :kevin
+
+    post saas.account_subscription_path, params: { plan_key: "free_v1" }
+
+    assert_response :unprocessable_entity
+  end
+
+  test "non-admin cannot start checkout" do
+    sign_in_as :david
+
+    Stripe::Customer.expects(:create).never
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_subscription_path
+
+    assert_response :forbidden
+  end
+
+  private
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..9622968
