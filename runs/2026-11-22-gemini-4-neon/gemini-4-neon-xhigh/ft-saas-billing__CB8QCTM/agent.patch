+class Admin::Accounts::OverriddenLimitsController < AdminController
+  before_action :set_account
+
+  def create
+    @account.override_limits(**overridden_limits_params)
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+  rescue ActiveRecord::RecordInvalid => e
+    redirect_to saas.admin_account_path(@account), alert: e.record.errors.full_messages.to_sentence
+  end
+
+  def destroy
+    @account.reset_overridden_limits
+    redirect_to saas.admin_account_path(@account), notice: "Overridden limits reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:account_id]) || Account.find_by!(external_account_id: params[:account_id])
+    end
+
+    def overridden_limits_params
+      source = params[:overridden_limits].is_a?(ActionController::Parameters) ? params[:overridden_limits] : params
+      permitted = source.permit(:card_count, :bytes_used)
+
+      {
+        card_count: permitted[:card_count].presence,
+        bytes_used: permitted[:bytes_used].presence
+      }
+    end
+end
