@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "status helpers" do
+    sub = @account.create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_status",
+      stripe_subscription_id: "sub_status",
+      status: "active"
+    )
+
+    assert sub.active?
+    assert sub.paid?
+    assert_not sub.canceled?
+    assert_not sub.past_due?
+    assert_not sub.to_be_canceled?
+
+    sub.update!(cancel_at: 2.weeks.from_now)
+    assert sub.active?
+    assert sub.to_be_canceled?
+
+    sub.update!(status: "past_due", cancel_at: nil)
+    assert sub.active?
+    assert sub.past_due?
+
+    sub.update!(status: "trialing")
+    assert sub.active?
+
+    sub.update!(status: "canceled")
+    assert_not sub.active?
+    assert_not sub.paid?
+    assert sub.canceled?
+
+    sub.update!(status: "unpaid")
+    assert_not sub.active?
+
+    sub.update!(status: "paused")
+    assert_not sub.active?
+    assert sub.paused?
+  end
+
+  test "sync_from_stripe reads item current_period_end and legacy current_period_end" do
+    with_env("STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlim", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus") do
+      sub = @account.create_subscription!(stripe_customer_id: "cus_sync")
+      period_end = 1.month.from_now.change(usec: 0)
+
+      stripe_sub = Stripe::Subscription.construct_from(
+        id: "sub_basil",
+        object: "subscription",
+        customer: "cus_sync",
+        status: "active",
+        cancel_at: nil,
+        items: {
+          data: [
+            {
+              current_period_end: period_end.to_i,
+              price: { id: "price_unlim", unit_amount: 2000 }
+            }
+          ]
+        }
+      )
+
+      sub.sync_from_stripe(stripe_sub)
+      assert_equal "sub_basil", sub.stripe_subscription_id
+      assert_equal "monthly_v1", sub.plan_key
+      assert_equal "active", sub.status
+      assert_equal period_end.to_i, sub.current_period_end.to_i
+      assert_equal 2000, sub.next_amount_due_in_cents
+      assert_nil sub.cancel_at
+
+      # Upgrade to Unlimited+ with legacy top-level current_period_end and cancel_at_period_end
+      later_end = 2.months.from_now.change(usec: 0)
+      stripe_sub_plus = Stripe::Subscription.construct_from(
+        id: "sub_basil",
+        object: "subscription",
+        customer: "cus_sync",
+        status: "active",
+        current_period_end: later_end.to_i,
+        cancel_at_period_end: true,
+        items: {
+          data: [
+            {
+              price: { id: "price_plus", unit_amount: 2500 }
+            }
+          ]
+        }
+      )
+
+      sub.sync_from_stripe(stripe_sub_plus)
+      assert_equal "monthly_extra_storage_v1", sub.plan_key
+      assert_equal later_end.to_i, sub.current_period_end.to_i
+      assert_equal later_end.to_i, sub.cancel_at.to_i
+      assert_equal 2500, sub.next_amount_due_in_cents
+      assert sub.to_be_canceled?
+    end
+  end
+
+  private
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
