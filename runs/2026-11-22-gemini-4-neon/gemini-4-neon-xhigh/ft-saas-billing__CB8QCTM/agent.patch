+require "test_helper"
+
+class Card::Limited::CreationTest < ActionDispatch::IntegrationTest
+  test "cannot create cards via JSON when free account runs out of cards" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Blocked card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can still draft cards via HTML when free account runs out of cards" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "can create cards via JSON when under card limit" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 999)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Last free card" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "paid account can create cards via JSON beyond 1,000 cards" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_500)
+    accounts(:initech).create_subscription!(
+      plan_key: "monthly_v1",
+      stripe_customer_id: "cus_api_create",
+      stripe_subscription_id: "sub_api_create",
+      status: "active"
+    )
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Paid card" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "comped account can create cards via JSON beyond 1,000 cards" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_500)
+    accounts(:initech).comp
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Comped card" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+end
