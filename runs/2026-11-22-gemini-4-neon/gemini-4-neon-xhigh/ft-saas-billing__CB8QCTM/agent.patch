+require "test_helper"
+
+class Account::OverriddenLimitsTest < ActiveSupport::TestCase
+  test "validates non-negative integer values" do
+    account = accounts(:initech)
+
+    limits = account.build_overridden_limits(card_count: -1)
+    assert_not limits.valid?
+
+    limits = account.build_overridden_limits(bytes_used: -100)
+    assert_not limits.valid?
+
+    limits = account.build_overridden_limits(card_count: 0, bytes_used: 0)
+    assert limits.valid?
+
+    limits = account.build_overridden_limits(card_count: 950, bytes_used: nil)
+    assert limits.valid?
+  end
+end
