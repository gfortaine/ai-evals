diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
index c1e9c2f..2f24fc7 100644
--- a/test/models/account/import_test.rb
+++ b/test/models/account/import_test.rb
@@ -220,6 +220,54 @@ class Account::ImportTest < ActiveSupport::TestCase
     export_tempfile&.unlink
   end
 
+test "export and import round-trip reconciles closed_or_postponed on cards" do
+  source_account = accounts("37s")
+  exporter = users(:david)
+  identity = exporter.identity
+
+  Current.set(account: source_account, user: exporter) do
+    cards(:layout).postpone
+  end
+
+  export = Account::Export.create!(account: source_account, user: exporter)
+  export.build
+  assert export.completed?
+
+  export_tempfile = Tempfile.new([ "export", ".zip" ])
+  export.file.open { |f| FileUtils.cp(f.path, export_tempfile.path) }
+
+  # Verify closed_or_postponed is omitted from card JSON so old and new exports stay compatible
+  ZipFile.read_from(export.file.blob) do |zip|
+    card_json = JSON.parse(zip.read("data/cards/#{cards(:shipping).id}.json"))
+    assert_not card_json.key?("closed_or_postponed")
+  end
+
+  closed_card_id = cards(:shipping).id
+  postponed_card_id = cards(:layout).id
+  active_card_id = cards(:logo).id
+
+  source_account.destroy!
+
+  target_account = Account.create_with_owner(account: { name: "Import Test" }, owner: { identity: identity, name: exporter.name })
+  import = Account::Import.create!(identity: identity, account: target_account)
+  Current.set(account: target_account) do
+    import.file.attach(io: File.open(export_tempfile.path), filename: "export.zip", content_type: "application/zip")
+  end
+
+  import.check
+  assert_not import.failed?
+
+  import.process
+  assert import.completed?
+
+  assert Card.find(closed_card_id).closed_or_postponed?
+  assert Card.find(postponed_card_id).closed_or_postponed?
+  assert_not Card.find(active_card_id).closed_or_postponed?
+ensure
+  export_tempfile&.close
+  export_tempfile&.unlink
+end
+
   private
     def account_digest(account)
       {
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..33c408c 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,86 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "closed_or_postponed stays synchronized across close, reopen, postpone, and resume" do
+    card = cards(:logo)
+    assert_not card.closed_or_postponed?
+
+    card.close
+    assert card.reload.closed_or_postponed?
+
+    card.reopen
+    assert_not card.reload.closed_or_postponed?
+
+    card.postpone
+    assert card.reload.closed_or_postponed?
+
+    card.resume
+    assert_not card.reload.closed_or_postponed?
+
+    card.postpone
+    assert card.reload.closed_or_postponed?
+    card.close
+    assert card.reload.closed_or_postponed?
+
+    card.postpone
+    assert card.reload.closed_or_postponed?
+    card.triage_into(columns(:writebook_in_progress))
+    assert_not card.reload.closed_or_postponed?
+
+    closure = Closure.create!(card: card, user: users(:david))
+    not_now = Card::NotNow.create!(card: card, user: users(:david))
+    assert card.reload.closed_or_postponed?
+    closure.destroy!
+    assert card.reload.closed_or_postponed?
+    not_now.destroy!
+    assert_not card.reload.closed_or_postponed?
+  end
+
+  test "due_to_be_postponed excludes closed, postponed, and drafted cards" do
+    past_due = 400.days.ago
+
+    cards(:shipping).update!(last_active_at: past_due) # closed
+    cards(:unfinished_thoughts).update!(last_active_at: past_due) # drafted
+    cards(:layout).postpone
+    cards(:layout).update!(last_active_at: past_due) # postponed
+    cards(:logo).update!(last_active_at: past_due) # active and due
+
+    assert_equal [ cards(:logo) ], Card.due_to_be_postponed.to_a
+  end
+
+  test "due_to_be_postponed includes reopened and resumed cards when past due" do
+    past_due = 400.days.ago
+
+    cards(:shipping).reopen
+    cards(:shipping).update!(last_active_at: past_due)
+
+    cards(:layout).postpone
+    cards(:layout).resume
+    cards(:layout).update!(last_active_at: past_due)
+
+    assert_equal cards(:shipping, :layout).to_set, Card.due_to_be_postponed.to_set
+  end
+
+  test "due_to_be_postponed excludes closures and not_nows inserted without callbacks" do
+    past_due = 400.days.ago
+
+    cards(:logo).update!(last_active_at: past_due)
+    cards(:layout).update!(last_active_at: past_due)
+    cards(:text).update!(last_active_at: past_due)
+
+    Closure.insert_all!([ { id: ActiveRecord::Type::Uuid.generate, account_id: cards(:logo).account_id, card_id: cards(:logo).id, created_at: Time.current, updated_at: Time.current } ])
+    Card::NotNow.insert_all!([ { id: ActiveRecord::Type::Uuid.generate, account_id: cards(:layout).account_id, card_id: cards(:layout).id, created_at: Time.current, updated_at: Time.current } ])
+
+    assert_equal [ cards(:text) ], Card.due_to_be_postponed.to_a
+  end
+
+  test "due_to_be_postponed uses index_cards_for_entropy instead of scanning cards on SQLite" do
+    skip unless Card.connection.adapter_name == "SQLite"
+
+    plan = Card.due_to_be_postponed.reorder(id: :asc).limit(1000).explain.inspect
+
+    assert_includes plan, "index_cards_for_entropy"
+    assert_no_match(/SCAN cards\b/, plan)
+  end
 end
