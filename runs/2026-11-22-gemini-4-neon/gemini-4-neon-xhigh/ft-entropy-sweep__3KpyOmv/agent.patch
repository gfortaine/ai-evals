@@ -0,0 +1,24 @@
+class AddClosedOrPostponedToCards < ActiveRecord::Migration[8.2]
+  def change
+    add_column :cards, :closed_or_postponed, :boolean, default: false, null: false
+
+    reversible do |dir|
+      dir.up do
+        execute <<~SQL
+          UPDATE cards
+          SET closed_or_postponed = #{connection.quoted_true}
+          WHERE id IN (SELECT card_id FROM closures)
+        SQL
+
+        execute <<~SQL
+          UPDATE cards
+          SET closed_or_postponed = #{connection.quoted_true}
+          WHERE id IN (SELECT card_id FROM card_not_nows)
+        SQL
+      end
+    end
+
+    add_index :cards, [ :closed_or_postponed, :status, :board_id, :last_active_at, :id ],
+      name: "index_cards_for_entropy"
+  end
+end
