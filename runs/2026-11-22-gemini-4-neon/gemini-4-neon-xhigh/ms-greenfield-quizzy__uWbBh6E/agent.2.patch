+require "application_system_test_case"
+
+class QuizExportImportTest < ApplicationSystemTestCase
+  setup do
+    authenticate_as_moderator
+  end
+
+  test "exporting a quiz and re-importing it creates a new independent quiz preserving order and flags" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+    q1 = quiz.questions.build(body: 'Which HTTP status code means "Too Many Requests"?', active: true)
+    assert q1.save_with_option_rows([
+      { body: "418", correct: false },
+      { body: "429", correct: true }
+    ])
+    q2 = quiz.questions.build(body: "What does CSS stand for?", active: false)
+    assert q2.save_with_option_rows([
+      { body: "Cascading Style Sheets", correct: true },
+      { body: "Computer Style System", correct: false }
+    ])
+    q3 = quiz.questions.build(body: "Which protocols run over TCP?", active: true)
+    assert q3.save_with_option_rows([
+      { body: "HTTP/1.1", correct: true },
+      { body: "UDP", correct: false },
+      { body: "WebSocket", correct: true }
+    ])
+
+    # Move Q3 up so order is Q1, Q3, Q2
+    q3.move_up!
+
+    visit moderate_quiz_path(quiz)
+    click_link "Export"
+
+    # Exactly one <pre> element containing valid JSON with exact keys
+    assert_selector "pre", count: 1
+    exported_text = evaluate_script("document.querySelector('pre').textContent")
+    exported_inner = evaluate_script("document.querySelector('pre').innerText")
+    assert_equal exported_text, exported_inner
+
+    parsed = JSON.parse(exported_text)
+
+    assert_equal [ "title", "questions" ], parsed.keys
+    assert_equal "Frontend Fest 2026", parsed["title"]
+    assert_equal [
+      'Which HTTP status code means "Too Many Requests"?',
+      "Which protocols run over TCP?",
+      "What does CSS stand for?"
+    ], parsed["questions"].map { |q| q["text"] }
+    assert_equal [ true, true, false ], parsed["questions"].map { |q| q["active"] }
+    parsed["questions"].each do |q|
+      assert_equal [ "text", "active", "options" ], q.keys
+      q["options"].each { |o| assert_equal [ "text", "correct" ], o.keys }
+    end
+
+    # Copy JSON button works without errors and does not alter <pre>
+    click_button "Copy JSON"
+    assert_button "Copied!"
+    assert_equal exported_text, evaluate_script("document.querySelector('pre').textContent")
+
+    # Navigate to /moderate and import the exported JSON
+    visit "/moderate"
+    click_on "Import quiz"
+
+    fill_in "Quiz JSON", with: exported_text
+    click_button "Import"
+
+    # Opens the newly created quiz's page (different ID from original)
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_not_equal moderate_quiz_path(quiz), current_path
+    assert_equal 2, Quiz.count
+
+    # Verify question order, active flags, and options on the imported quiz page
+    items = all("ol.question-list > li")
+    assert_equal 3, items.size
+    assert_includes items[0].text, 'Which HTTP status code means "Too Many Requests"?'
+    assert_includes items[1].text, "Which protocols run over TCP?"
+    assert_includes items[2].text, "What does CSS stand for?"
+
+    within(items[0]) do
+      assert_checked_field "Active"
+      assert_selector "li.is-correct", text: "B. 429"
+    end
+    within(items[1]) do
+      assert_checked_field "Active"
+      assert_selector "li.is-correct", text: "A. HTTP/1.1"
+      assert_selector "li.is-correct", text: "C. WebSocket"
+    end
+    within(items[2]) do
+      assert_unchecked_field "Active"
+      assert_selector "li.is-correct", text: "A. Cascading Style Sheets"
+    end
+
+    # Preview on the imported quiz plays only active questions in order
+    click_link "Preview"
+    assert_text "Question 1 of 2"
+    assert_text 'Which HTTP status code means "Too Many Requests"?'
+    click_button "429"
+    assert_text "Correct!"
+    click_button "Next question"
+    assert_text "Question 2 of 2"
+    assert_text "Which protocols run over TCP?"
+
+    # Both quizzes appear in their own list items on /moderate
+    visit "/moderate"
+    assert_selector "ul.quiz-list > li", text: "Frontend Fest 2026", count: 2
+  end
+
+  test "import applies defaults for omitted active and correct, and rejects invalid JSON atomically" do
+    visit "/moderate"
+    click_on "Import quiz"
+
+    # 1. Invalid JSON syntax shows error and creates nothing
+    fill_in "Quiz JSON", with: "{ broken json"
+    click_button "Import"
+    assert_selector ".errors"
+    assert_field "Quiz JSON", with: "{ broken json"
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+
+    # 2. Rule violation on second question imports neither the quiz nor the first valid question
+    partial_invalid = JSON.pretty_generate(
+      title: "Should Not Exist",
+      questions: [
+        {
+          text: "Valid first question",
+          options: [
+            { text: "A", correct: true },
+            { text: "B" }
+          ]
+        },
+        {
+          text: "Invalid second question (no correct option)",
+          options: [
+            { text: "X" },
+            { text: "Y" }
+          ]
+        }
+      ]
+    )
+    fill_in "Quiz JSON", with: partial_invalid
+    click_button "Import"
+    assert_selector ".errors"
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+    assert_equal 0, Option.count
+
+    # 3. Valid JSON with optional active and correct omitted succeeds
+    minimal_valid = JSON.pretty_generate(
+      title: "Minimal Conference Quiz",
+      questions: [
+        {
+          text: "What is 2 + 2?",
+          options: [
+            { text: "3" },
+            { text: "4", correct: true }
+          ]
+        }
+      ]
+    )
+    fill_in "Quiz JSON", with: minimal_valid
+    click_button "Import"
+
+    assert_selector "h1", text: "Minimal Conference Quiz"
+    assert_equal 1, Quiz.count
+    within("ol.question-list > li", text: "What is 2 + 2?") do
+      assert_checked_field "Active"
+      assert_text "A. 3"
+      assert_selector "li.is-correct", text: "B. 4"
+    end
+
+    # Export of minimal imported quiz explicitly writes both active and correct
+    click_link "Export"
+    assert_selector "pre", count: 1
+    exported = JSON.parse(evaluate_script("document.querySelector('pre').textContent"))
+    assert_equal({
+      "title" => "Minimal Conference Quiz",
+      "questions" => [
+        {
+          "text" => "What is 2 + 2?",
+          "active" => true,
+          "options" => [
+            { "text" => "3", "correct" => false },
+            { "text" => "4", "correct" => true }
+          ]
+        }
+      ]
+    }, exported)
+  end
+
+  test "export and import round-trip special HTML characters, multiline text, and empty quizzes safely" do
+    # 1. Special characters including </pre>, </textarea>, <script>, quotes, newlines, unicode
+    quiz = Quiz.create!(title: %(Safe </pre> <script>alert(1)</script> & "Quotes"))
+    q = quiz.questions.build(body: "Line 1\nLine 2 & </textarea>", active: true)
+    assert q.save_with_option_rows([
+      { body: "<b>Option 1</b>", correct: true },
+      { body: "Café 日本語 🎉", correct: false }
+    ])
+
+    visit moderate_quiz_path(quiz)
+    click_link "Export"
+    assert_selector "pre", count: 1
+
+    exported_text = evaluate_script("document.querySelector('pre').textContent")
+    visit "/moderate"
+    click_on "Import quiz"
+    fill_in "Quiz JSON", with: exported_text
+    click_button "Import"
+
+    assert_selector "h1", text: %(Safe </pre> <script>alert(1)</script> & "Quotes")
+    click_link "Export"
+    assert_equal exported_text, evaluate_script("document.querySelector('pre').textContent")
+
+    # 2. Empty quiz round-trip
+    empty_quiz = Quiz.create!(title: "Empty Roundtrip")
+    visit moderate_quiz_path(empty_quiz)
+    click_link "Export"
+    assert_selector "pre", count: 1
+    empty_json = evaluate_script("document.querySelector('pre').textContent")
+    assert_equal({ "title" => "Empty Roundtrip", "questions" => [] }, JSON.parse(empty_json))
+
+    visit "/moderate"
+    click_on "Import quiz"
+    fill_in "Quiz JSON", with: empty_json
+    click_button "Import"
+    assert_selector "h1", text: "Empty Roundtrip"
+    assert_text "0 of 0 questions active"
+  end
+end
