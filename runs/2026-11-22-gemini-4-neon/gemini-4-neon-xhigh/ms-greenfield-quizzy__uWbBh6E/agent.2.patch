+module Moderate
+  class ImportsController < BaseController
+    def new
+      @raw_json = ""
+      @errors = []
+    end
+
+    def create
+      @raw_json = params[:quiz_json].is_a?(String) ? params[:quiz_json] : ""
+      result = Quiz::Importer.new(@raw_json).import
+
+      if result.success?
+        redirect_to moderate_quiz_path(result.quiz)
+      else
+        @errors = result.errors
+        render :new, status: :unprocessable_entity
+      end
+    end
+  end
+end
diff --git a/app/javascript/controllers/clipboard_controller.js b/app/javascript/controllers/clipboard_controller.js
new file mode 100644
index 0000000..7a826cf
--- /dev/null
+++ b/app/javascript/controllers/clipboard_controller.js
@@ -0,0 +1,47 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["source", "button"]
+
+  async copy() {
+    const text = this.sourceTarget.textContent
+    try {
+      if (navigator.clipboard && window.isSecureContext) {
+        await navigator.clipboard.writeText(text)
+      } else {
+        this.fallbackCopy(text)
+      }
+      this.showCopied()
+    } catch {
+      this.fallbackCopy(text)
+      this.showCopied()
+    }
+  }
+
+  fallbackCopy(text) {
+    const textarea = document.createElement("textarea")
+    textarea.value = text
+    textarea.setAttribute("readonly", "")
+    textarea.style.position = "fixed"
+    textarea.style.opacity = "0"
+    document.body.appendChild(textarea)
+    textarea.select()
+    document.execCommand("copy")
+    textarea.remove()
+  }
+
+  showCopied() {
+    if (!this.hasButtonTarget) return
+    const original = this.buttonTarget.dataset.originalLabel || this.buttonTarget.textContent
+    this.buttonTarget.dataset.originalLabel = original
+    this.buttonTarget.textContent = "Copied!"
+    clearTimeout(this.resetTimer)
+    this.resetTimer = setTimeout(() => {
+      this.buttonTarget.textContent = original
+    }, 2000)
+  }
+
+  disconnect() {
+    clearTimeout(this.resetTimer)
+  }
+}
