+require "application_system_test_case"
+
+class PrizesAndLeaderboardTest < ApplicationSystemTestCase
+  test "quiz settings has Number of winners defaulting to 3 with validation >= 1" do
+    authenticate_as_moderator
+    visit "/moderate"
+
+    click_on "New quiz"
+    assert_field "Number of winners", with: "3"
+    fill_in "Title", with: "Prizes Settings Quiz"
+    click_on "Save quiz"
+
+    assert_selector "h1", text: "Prizes Settings Quiz"
+    click_link "Settings"
+    assert_field "Number of winners", with: "3"
+
+    # Invalid values: 0, negative, blank
+    fill_in "Number of winners", with: "0"
+    click_on "Save quiz"
+    assert_text "Number of winners must be greater than or equal to 1"
+    assert_equal 3, Quiz.last.number_of_winners
+
+    fill_in "Number of winners", with: "-2"
+    click_on "Save quiz"
+    assert_text "Number of winners must be greater than or equal to 1"
+    assert_equal 3, Quiz.last.number_of_winners
+
+    fill_in "Number of winners", with: ""
+    click_on "Save quiz"
+    assert_text "Number of winners can't be blank"
+    assert_equal 3, Quiz.last.number_of_winners
+
+    # Valid update to 2
+    fill_in "Number of winners", with: "2"
+    click_on "Save quiz"
+    assert_selector "h1", text: "Prizes Settings Quiz"
+    assert_equal 2, Quiz.last.number_of_winners
+
+    click_link "Settings"
+    assert_field "Number of winners", with: "2"
+  end
+
+  test "scoring by points and speed (last pick, excluding wrong answers), instant live sync across big screen and phones, leaderboard, Top N, Draw, Reset winners, and reload persistence" do
+    quiz = Quiz.create!(title: "Speed & Prizes Talk", number_of_winners: 2)
+
+    q1 = quiz.questions.build(body: "Q1: Pick Ruby's creator", active: true)
+    q1.save_with_option_rows([
+      { body: "Matz", correct: true },
+      { body: "Guido", correct: false }
+    ])
+
+    q2 = quiz.questions.build(body: "Q2: Pick Rails' default test framework", active: true)
+    q2.save_with_option_rows([
+      { body: "Minitest", correct: true },
+      { body: "JUnit", correct: false }
+    ])
+
+    game_url = nil
+    join_url = nil
+
+    # Moderator starts a game
+    using_session(:moderator) do
+      authenticate_as_moderator
+      visit moderate_quiz_path(quiz)
+      click_button "Start a game"
+      assert_match %r{\A/moderate/games/\d+\z}, current_path
+      game_url = current_url
+      join_url = find(".lobby__url").text.strip
+    end
+
+    # Second browser acting as separate big screen projector
+    using_session(:big_screen) do
+      authenticate_as_moderator
+      visit game_url
+      assert_text "Speed & Prizes Talk"
+      assert_text "Players: 0"
+    end
+
+    # 5 players join: Alice, Bob, Charlie, Dave, Eve
+    {
+      alice: "Alice",
+      bob: "Bob",
+      charlie: "Charlie",
+      dave: "Dave",
+      eve: "Eve"
+    }.each do |sess, name|
+      using_session(sess) do
+        visit join_url
+        fill_in "Your name", with: name
+        click_button "Join"
+        assert_text "Hi, #{name}!"
+        assert_no_text "point"
+      end
+    end
+
+    using_session(:big_screen) { assert_text "Players: 5" }
+
+    # Start Q1 and measure near-instant live propagation to big screen and phones!
+    started_at = nil
+    using_session(:moderator) do
+      started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+      click_button "Start"
+      assert_text "Question 1 of 2"
+    end
+
+    using_session(:big_screen) do
+      assert_text "Q1: Pick Ruby's creator", wait: 2
+    end
+
+    [ :alice, :bob, :charlie, :dave, :eve ].each do |sess|
+      using_session(sess) do
+        assert_text "Q1: Pick Ruby's creator", wait: 2
+        assert_no_text "point"
+      end
+    end
+    elapsed_sync = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at
+    assert_operator elapsed_sync, :<, 3.0, "Expected near-instant sync across big screen and all 5 phones, took #{elapsed_sync.round(2)}s"
+
+    # Q1 answers:
+    # - Alice picks Matz (correct) quickly (~0.1s), then later switches to Guido and back to Matz!
+    # - Bob picks Matz (correct) quickly
+    # - Charlie picks Guido (wrong) after a long delay -> wrong answer time must NOT count!
+    # - Dave picks Guido (wrong) immediately
+    # - Eve does not answer
+    using_session(:alice) do
+      click_button "Matz"
+      within("button.play-option", text: "Matz") { assert_text "Your answer" }
+    end
+
+    using_session(:dave) do
+      click_button "Guido"
+      within("button.play-option", text: "Guido") { assert_text "Your answer" }
+    end
+
+    sleep 0.35
+
+    using_session(:bob) do
+      click_button "Matz"
+      within("button.play-option", text: "Matz") { assert_text "Your answer" }
+    end
+
+    sleep 0.35
+
+    # Alice switches to wrong, then back to Matz -> her LAST pick is slower than Bob!
+    using_session(:alice) do
+      click_button "Guido"
+      within("button.play-option", text: "Guido") { assert_text "Your answer" }
+      click_button "Matz"
+      within("button.play-option", text: "Matz") { assert_text "Your answer" }
+    end
+
+    # Charlie picks wrong even later -> should NOT hurt Charlie's Q2 tie-break!
+    sleep 0.25
+    using_session(:charlie) do
+      click_button "Guido"
+      within("button.play-option", text: "Guido") { assert_text "Your answer" }
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 4 / 5"
+      click_button "Finish"
+      assert_button "Next"
+    end
+
+    # Players see Correct!/Wrong!/No answer, still NO points shown during the game!
+    using_session(:alice) do
+      assert_text "Correct!"
+      assert_no_text "point"
+    end
+    using_session(:bob) do
+      assert_text "Correct!"
+      assert_no_text "point"
+    end
+    using_session(:charlie) do
+      assert_text "Wrong!"
+      assert_no_text "point"
+    end
+    using_session(:eve) do
+      assert_text "No answer"
+      assert_no_text "point"
+    end
+
+    # Move to Q2
+    using_session(:moderator) do
+      click_button "Next"
+      assert_text "Question 2 of 2"
+    end
+
+    using_session(:big_screen) { assert_text "Q2: Pick Rails' default test framework", wait: 2 }
+
+    # Q2 answers:
+    # - Bob picks Minitest fast -> 2 points (faster total than Alice!) -> Place 1
+    # - Alice picks Minitest slower -> 2 points -> Place 2
+    #   Wait: let's actually have Bob get 2 pts (Place 1), Alice get 1 pt (wrong on Q2), Charlie get 1 pt (fast on Q2), Dave get 1 pt (slow on Q2), Eve get 0 pts!
+    #   Wait: let's test BOTH speed ranking at 2 pts AND ties at N-th place for Draw!
+    #   With Number of winners = 2:
+    #   - If Bob = 2 pts (Place 1), Charlie = 1 pt (0.1s, Place 2), Dave = 1 pt (0.5s, Place 3), Alice = 1 pt (0.8s, Place 4), Eve = 0 pts (Place 5):
+    #     - Alice's Q1 last-pick time was ~0.8s, Q2 wrong (0s) -> 1 pt, ~0.8s!
+    #     - Charlie's Q1 wrong time was ~1.0s (EXCLUDED!), Q2 correct ~0.1s -> 1 pt, ~0.1s -> Place 2 (beats Dave and Alice!)
+    #     - Dave's Q1 wrong time was ~0.1s (EXCLUDED!), Q2 correct ~0.45s -> 1 pt, ~0.45s -> Place 3 (beats Alice!)
+    #     - Wait: Alice got Q1 right at ~0.8s and Q2 wrong -> 1 pt, ~0.8s -> Place 4!
+    #     - Bob got Q1 right (~0.4s) and Q2 right (~0.1s) -> 2 pts -> Place 1!
+    #     - Eve got 0 pts -> Place 5!
+    #   That tests EVERY SINGLE rule in ONE realistic game:
+    #     1. 2 points beats 1 point beats 0 points
+    #     2. Pluralization: "2 points", "1 point", "0 points"
+    #     3. Wrong answer time excluded (Charlie had slow wrong Q1, fast right Q2 -> beats Dave & Alice!)
+    #     4. Last pick time counts (Alice switched late on Q1 -> slower than Charlie & Dave!)
+    #     5. Draw with N=2: Bob (2 pts > 1 pt) ALWAYS wins, 1 remaining prize randomly drawn from {Charlie, Dave, Alice} (all 1 pt), Eve (0 pts) NEVER wins!
+    using_session(:bob) do
+      assert_text "Q2: Pick Rails' default test framework", wait: 2
+      click_button "Minitest"
+    end
+    using_session(:charlie) do
+      assert_text "Q2: Pick Rails' default test framework", wait: 2
+      click_button "Minitest"
+    end
+
+    sleep 0.4
+
+    using_session(:dave) do
+      assert_text "Q2: Pick Rails' default test framework", wait: 2
+      click_button "Minitest"
+    end
+
+    using_session(:alice) do
+      assert_text "Q2: Pick Rails' default test framework", wait: 2
+      click_button "JUnit"
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 4 / 5"
+      click_button "Finish"
+      assert_button "End quiz"
+      click_button "End quiz"
+    end
+
+    # Verify leaderboard LIVE on BOTH moderator and separate big_screen!
+    expected_rows = [
+      [ "1", "Bob", "2 points" ],
+      [ "2", "Charlie", "1 point" ],
+      [ "3", "Dave", "1 point" ],
+      [ "4", "Alice", "1 point" ],
+      [ "5", "Eve", "0 points" ]
+    ]
+
+    [ :moderator, :big_screen ].each do |screen|
+      using_session(screen) do
+        assert_selector "ol.leaderboard > li", count: 5
+        assert_button "Top 2"
+        assert_button "Draw"
+        assert_button "Reset winners"
+
+        items = all("ol.leaderboard > li")
+        expected_rows.each_with_index do |(place, name, pts), idx|
+          within(items[idx]) do
+            assert_selector ".leader__place", text: place
+            assert_selector ".leader__name", text: name
+            assert_selector ".leader__score", text: pts
+            assert_no_text "Winner"
+          end
+        end
+      end
+    end
+
+    # Verify EVERY player's phone updated LIVE with exact "Place X of 5" and points (and NO "You won!" yet)
+    {
+      bob: [ "Place 1 of 5", "2 points" ],
+      charlie: [ "Place 2 of 5", "1 point" ],
+      dave: [ "Place 3 of 5", "1 point" ],
+      alice: [ "Place 4 of 5", "1 point" ],
+      eve: [ "Place 5 of 5", "0 points" ]
+    }.each do |sess, (place_text, points_text)|
+      using_session(sess) do
+        assert_text place_text
+        assert_text points_text
+        inner = evaluate_script("document.body.innerText")
+        assert_includes inner, place_text
+        assert_includes inner, points_text
+        assert_no_text "You won!"
+      end
+    end
+
+    # Click "Top 2" -> Bob (1st) and Charlie (2nd) become winners LIVE on big screen AND phones!
+    using_session(:moderator) do
+      click_button "Top 2"
+    end
+
+    [ :moderator, :big_screen ].each do |screen|
+      using_session(screen) do
+        assert_selector "ol.leaderboard > li.is-winner", count: 2
+        within("ol.leaderboard > li", text: "Bob") { assert_text "Winner" }
+        within("ol.leaderboard > li", text: "Charlie") { assert_text "Winner" }
+        within("ol.leaderboard > li", text: "Dave") { assert_no_text "Winner" }
+        within("ol.leaderboard > li", text: "Alice") { assert_no_text "Winner" }
+        within("ol.leaderboard > li", text: "Eve") { assert_no_text "Winner" }
+      end
+    end
+
+    using_session(:bob) { assert_text "You won!" }
+    using_session(:charlie) { assert_text "You won!" }
+    using_session(:dave) { assert_no_text "You won!" }
+    using_session(:alice) { assert_no_text "You won!" }
+    using_session(:eve) { assert_no_text "You won!" }
+
+    # Click "Reset winners" -> removes all winners LIVE on big screen AND phones!
+    using_session(:moderator) do
+      click_button "Reset winners"
+    end
+
+    [ :moderator, :big_screen ].each do |screen|
+      using_session(screen) do
+        assert_no_selector "ol.leaderboard > li.is-winner"
+        within("ol.leaderboard") { assert_no_text "Winner" }
+      end
+    end
+
+    [ :bob, :charlie, :dave, :alice, :eve ].each do |sess|
+      using_session(sess) { assert_no_text "You won!" }
+    end
+
+    # Click "Draw" repeatedly -> Bob ALWAYS wins, Eve NEVER wins, 2nd winner drawn at random from {Charlie, Dave, Alice}
+    seen_second_winners = Set.new
+    20.times do
+      using_session(:moderator) do
+        click_button "Draw"
+        assert_selector "ol.leaderboard > li.is-winner", count: 2
+        winner_names = all("ol.leaderboard > li.is-winner .leader__name").map(&:text)
+        assert_equal 2, winner_names.size
+        assert_includes winner_names, "Bob"
+        assert_not_includes winner_names, "Eve"
+        other = (winner_names - [ "Bob" ]).first
+        assert_includes [ "Charlie", "Dave", "Alice" ], other
+        seen_second_winners.add(other)
+      end
+
+      break if seen_second_winners.size >= 2
+    end
+
+    assert_operator seen_second_winners.size, :>=, 2, "Expected repeated Draw clicks to draw different tied players"
+
+    # Verify phones match the latest Draw winners LIVE!
+    final_winner_names = nil
+    using_session(:big_screen) do
+      assert_selector "ol.leaderboard > li.is-winner", count: 2
+      final_winner_names = all("ol.leaderboard > li.is-winner .leader__name").map(&:text)
+    end
+
+    { bob: "Bob", charlie: "Charlie", dave: "Dave", alice: "Alice", eve: "Eve" }.each do |sess, name|
+      using_session(sess) do
+        if final_winner_names.include?(name)
+          assert_text "You won!"
+        else
+          assert_no_text "You won!"
+        end
+      end
+    end
+
+    # Verify reload persistence on big screen and phones
+    using_session(:big_screen) do
+      visit current_path
+      assert_selector "ol.leaderboard > li.is-winner", count: 2
+      reloaded_winners = all("ol.leaderboard > li.is-winner .leader__name").map(&:text)
+      assert_equal final_winner_names, reloaded_winners
+    end
+
+    using_session(:bob) do
+      visit current_path
+      assert_text "Place 1 of 5"
+      assert_text "2 points"
+      assert_text "You won!"
+    end
+
+    using_session(:eve) do
+      visit current_path
+      assert_text "Place 5 of 5"
+      assert_text "0 points"
+      assert_no_text "You won!"
+    end
+  end
+
+  test "0-point players never win, fewer than N scorers all win, and Wi-Fi drop on ended screen still catches up to winner updates" do
+    quiz = Quiz.create!(title: "Zero Points Rule", number_of_winners: 3)
+    q1 = quiz.questions.build(body: "1 + 1?", active: true)
+    q1.save_with_option_rows([
+      { body: "2", correct: true },
+      { body: "3", correct: false }
+    ])
+
+    join_url = nil
+    using_session(:moderator) do
+      authenticate_as_moderator
+      visit moderate_quiz_path(quiz)
+      click_button "Start a game"
+      join_url = find(".lobby__url").text.strip
+    end
+
+    { p1: "ScorerA", p2: "ScorerB", p3: "ZeroC", p4: "ZeroD" }.each do |sess, name|
+      using_session(sess) do
+        visit join_url
+        fill_in "Your name", with: name
+        click_button "Join"
+        assert_text "Hi, #{name}!"
+      end
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 4"
+      click_button "Start"
+    end
+
+    using_session(:p1) do
+      assert_text "1 + 1?"
+      click_button "2"
+    end
+    using_session(:p2) do
+      assert_text "1 + 1?"
+      click_button "2"
+    end
+    using_session(:p3) do
+      assert_text "1 + 1?"
+      click_button "3"
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 3 / 4"
+      click_button "Finish"
+      click_button "End quiz"
+      assert_button "Top 3"
+      assert_selector "ol.leaderboard > li", count: 4
+    end
+
+    # Drop p1's WebSocket on the ended screen (simulating Wi-Fi blip before prizes are picked!)
+    using_session(:p1) do
+      assert_text "1 point"
+      execute_script("(() => { const el = document.querySelector('[data-controller=\"player-game\"]'); const ctrl = window.Stimulus.getControllerForElementAndIdentifier(el, 'player-game'); if (ctrl && ctrl.consumer) ctrl.consumer.connection.close({ allowReconnect: true }); })()")
+    end
+
+    # Click "Top 3" -> only 2 players have points -> both win, 0-point players never win!
+    using_session(:moderator) do
+      click_button "Top 3"
+      assert_selector "ol.leaderboard > li.is-winner", count: 2
+      within("ol.leaderboard > li", text: "ScorerA") { assert_text "Winner" }
+      within("ol.leaderboard > li", text: "ScorerB") { assert_text "Winner" }
+      within("ol.leaderboard > li", text: "ZeroC") { assert_no_text "Winner" }
+      within("ol.leaderboard > li", text: "ZeroD") { assert_no_text "Winner" }
+    end
+
+    # p1 catches up live despite the WebSocket drop!
+    using_session(:p1) { assert_text "You won!", wait: 10 }
+    using_session(:p2) { assert_text "You won!" }
+    using_session(:p3) { assert_no_text "You won!" }
+    using_session(:p4) { assert_no_text "You won!" }
+
+    # Reset and click Draw -> same 2 scorers win, 0-point players still never win!
+    using_session(:moderator) do
+      click_button "Reset winners"
+      assert_no_selector "ol.leaderboard > li.is-winner"
+
+      click_button "Draw"
+      assert_selector "ol.leaderboard > li.is-winner", count: 2
+      within("ol.leaderboard > li", text: "ScorerA") { assert_text "Winner" }
+      within("ol.leaderboard > li", text: "ScorerB") { assert_text "Winner" }
+      within("ol.leaderboard > li", text: "ZeroC") { assert_no_text "Winner" }
+      within("ol.leaderboard > li", text: "ZeroD") { assert_no_text "Winner" }
+    end
+
+    using_session(:p1) { assert_text "You won!" }
+    using_session(:p2) { assert_text "You won!" }
+    using_session(:p3) { assert_no_text "You won!" }
+    using_session(:p4) { assert_no_text "You won!" }
+  end
+end
diff --git a/test/system/quiz_export_import_test.rb b/test/system/quiz_export_import_test.rb
new file mode 100644
index 0000000..43a37b1
--- /dev/null
+++ b/test/system/quiz_export_import_test.rb
@@ -0,0 +1,227 @@
+require "application_system_test_case"
+
+class QuizExportImportTest < ApplicationSystemTestCase
+  setup do
+    authenticate_as_moderator
+  end
+
+  test "exporting a quiz and re-importing it creates a new independent quiz preserving order and flags" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+    q1 = quiz.questions.build(body: 'Which HTTP status code means "Too Many Requests"?', active: true)
+    assert q1.save_with_option_rows([
+      { body: "418", correct: false },
+      { body: "429", correct: true }
+    ])
+    q2 = quiz.questions.build(body: "What does CSS stand for?", active: false)
+    assert q2.save_with_option_rows([
+      { body: "Cascading Style Sheets", correct: true },
+      { body: "Computer Style System", correct: false }
+    ])
+    q3 = quiz.questions.build(body: "Which protocols run over TCP?", active: true)
+    assert q3.save_with_option_rows([
+      { body: "HTTP/1.1", correct: true },
+      { body: "UDP", correct: false },
+      { body: "WebSocket", correct: true }
+    ])
+
+    # Move Q3 up so order is Q1, Q3, Q2
+    q3.move_up!
+
+    visit moderate_quiz_path(quiz)
+    click_link "Export"
+
+    # Exactly one <pre> element containing valid JSON with exact keys
+    assert_selector "pre", count: 1
+    exported_text = evaluate_script("document.querySelector('pre').textContent")
+    exported_inner = evaluate_script("document.querySelector('pre').innerText")
+    assert_equal exported_text, exported_inner
+
+    parsed = JSON.parse(exported_text)
+
+    assert_equal [ "title", "questions" ], parsed.keys
+    assert_equal "Frontend Fest 2026", parsed["title"]
+    assert_equal [
+      'Which HTTP status code means "Too Many Requests"?',
+      "Which protocols run over TCP?",
+      "What does CSS stand for?"
+    ], parsed["questions"].map { |q| q["text"] }
+    assert_equal [ true, true, false ], parsed["questions"].map { |q| q["active"] }
+    parsed["questions"].each do |q|
+      assert_equal [ "text", "active", "options" ], q.keys
+      q["options"].each { |o| assert_equal [ "text", "correct" ], o.keys }
+    end
+
+    # Copy JSON button works without errors and does not alter <pre>
+    click_button "Copy JSON"
+    assert_button "Copied!"
+    assert_equal exported_text, evaluate_script("document.querySelector('pre').textContent")
+
+    # Navigate to /moderate and import the exported JSON
+    visit "/moderate"
+    click_on "Import quiz"
+
+    fill_in "Quiz JSON", with: exported_text
+    click_button "Import"
+
+    # Opens the newly created quiz's page (different ID from original)
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_not_equal moderate_quiz_path(quiz), current_path
+    assert_equal 2, Quiz.count
+
+    # Verify question order, active flags, and options on the imported quiz page
+    items = all("ol.question-list > li")
+    assert_equal 3, items.size
+    assert_includes items[0].text, 'Which HTTP status code means "Too Many Requests"?'
+    assert_includes items[1].text, "Which protocols run over TCP?"
+    assert_includes items[2].text, "What does CSS stand for?"
+
+    within(items[0]) do
+      assert_checked_field "Active"
+      assert_selector "li.is-correct", text: "B. 429"
+    end
+    within(items[1]) do
+      assert_checked_field "Active"
+      assert_selector "li.is-correct", text: "A. HTTP/1.1"
+      assert_selector "li.is-correct", text: "C. WebSocket"
+    end
+    within(items[2]) do
+      assert_unchecked_field "Active"
+      assert_selector "li.is-correct", text: "A. Cascading Style Sheets"
+    end
+
+    # Preview on the imported quiz plays only active questions in order
+    click_link "Preview"
+    assert_text "Question 1 of 2"
+    assert_text 'Which HTTP status code means "Too Many Requests"?'
+    click_button "429"
+    assert_text "Correct!"
+    click_button "Next question"
+    assert_text "Question 2 of 2"
+    assert_text "Which protocols run over TCP?"
+
+    # Both quizzes appear in their own list items on /moderate
+    visit "/moderate"
+    assert_selector "ul.quiz-list > li", text: "Frontend Fest 2026", count: 2
+  end
+
+  test "import applies defaults for omitted active and correct, and rejects invalid JSON atomically" do
+    visit "/moderate"
+    click_on "Import quiz"
+
+    # 1. Invalid JSON syntax shows error and creates nothing
+    fill_in "Quiz JSON", with: "{ broken json"
+    click_button "Import"
+    assert_selector ".errors"
+    assert_field "Quiz JSON", with: "{ broken json"
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+
+    # 2. Rule violation on second question imports neither the quiz nor the first valid question
+    partial_invalid = JSON.pretty_generate(
+      title: "Should Not Exist",
+      questions: [
+        {
+          text: "Valid first question",
+          options: [
+            { text: "A", correct: true },
+            { text: "B" }
+          ]
+        },
+        {
+          text: "Invalid second question (no correct option)",
+          options: [
+            { text: "X" },
+            { text: "Y" }
+          ]
+        }
+      ]
+    )
+    fill_in "Quiz JSON", with: partial_invalid
+    click_button "Import"
+    assert_selector ".errors"
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+    assert_equal 0, Option.count
+
+    # 3. Valid JSON with optional active and correct omitted succeeds
+    minimal_valid = JSON.pretty_generate(
+      title: "Minimal Conference Quiz",
+      questions: [
+        {
+          text: "What is 2 + 2?",
+          options: [
+            { text: "3" },
+            { text: "4", correct: true }
+          ]
+        }
+      ]
+    )
+    fill_in "Quiz JSON", with: minimal_valid
+    click_button "Import"
+
+    assert_selector "h1", text: "Minimal Conference Quiz"
+    assert_equal 1, Quiz.count
+    within("ol.question-list > li", text: "What is 2 + 2?") do
+      assert_checked_field "Active"
+      assert_text "A. 3"
+      assert_selector "li.is-correct", text: "B. 4"
+    end
+
+    # Export of minimal imported quiz explicitly writes both active and correct
+    click_link "Export"
+    assert_selector "pre", count: 1
+    exported = JSON.parse(evaluate_script("document.querySelector('pre').textContent"))
+    assert_equal({
+      "title" => "Minimal Conference Quiz",
+      "questions" => [
+        {
+          "text" => "What is 2 + 2?",
+          "active" => true,
+          "options" => [
+            { "text" => "3", "correct" => false },
+            { "text" => "4", "correct" => true }
+          ]
+        }
+      ]
+    }, exported)
+  end
+
+  test "export and import round-trip special HTML characters, multiline text, and empty quizzes safely" do
+    # 1. Special characters including </pre>, </textarea>, <script>, quotes, newlines, unicode
+    quiz = Quiz.create!(title: %(Safe </pre> <script>alert(1)</script> & "Quotes"))
+    q = quiz.questions.build(body: "Line 1\nLine 2 & </textarea>", active: true)
+    assert q.save_with_option_rows([
+      { body: "<b>Option 1</b>", correct: true },
+      { body: "Café 日本語 🎉", correct: false }
+    ])
+
+    visit moderate_quiz_path(quiz)
+    click_link "Export"
+    assert_selector "pre", count: 1
+
+    exported_text = evaluate_script("document.querySelector('pre').textContent")
+    visit "/moderate"
+    click_on "Import quiz"
+    fill_in "Quiz JSON", with: exported_text
+    click_button "Import"
+
+    assert_selector "h1", text: %(Safe </pre> <script>alert(1)</script> & "Quotes")
+    click_link "Export"
+    assert_equal exported_text, evaluate_script("document.querySelector('pre').textContent")
+
+    # 2. Empty quiz round-trip
+    empty_quiz = Quiz.create!(title: "Empty Roundtrip")
+    visit moderate_quiz_path(empty_quiz)
+    click_link "Export"
+    assert_selector "pre", count: 1
+    empty_json = evaluate_script("document.querySelector('pre').textContent")
+    assert_equal({ "title" => "Empty Roundtrip", "questions" => [] }, JSON.parse(empty_json))
+
+    visit "/moderate"
+    click_on "Import quiz"
+    fill_in "Quiz JSON", with: empty_json
+    click_button "Import"
+    assert_selector "h1", text: "Empty Roundtrip"
+    assert_text "0 of 0 questions active"
+  end
+end
