+require "test_helper"
+require "capybara/cuprite"
+
+Capybara.register_driver(:cuprite_chromium) do |app|
+  Capybara::Cuprite::Driver.new(
+    app,
+    browser_path: "/usr/bin/chromium",
+    headless: true,
+    window_size: [ 1280, 900 ],
+    process_timeout: 30,
+    timeout: 15,
+    browser_options: {
+      "no-sandbox" => nil,
+      "disable-gpu" => nil,
+      "disable-dev-shm-usage" => nil
+    }
+  )
+end
+
+class ApplicationSystemTestCase < ActionDispatch::SystemTestCase
+  driven_by :cuprite_chromium
+
+  def authenticate_as_moderator(username = ENV["QUIZZY_MODERATOR_USERNAME"], password = ENV["QUIZZY_MODERATOR_PASSWORD"])
+    page.driver.browser.network.authorize(user: username, password: password, type: :server) do |request|
+      request.continue
+    end
+  end
+end
diff --git a/test/channels/game_channels_test.rb b/test/channels/game_channels_test.rb
new file mode 100644
index 0000000..182363f
--- /dev/null
+++ b/test/channels/game_channels_test.rb
@@ -0,0 +1,135 @@
+require "test_helper"
+
+module GameChannelTestHelper
+  def create_game(winners: 3, timer_minutes: 0, timer_seconds: 0)
+    quiz = Quiz.create!(
+      title: "Channel Quiz",
+      number_of_winners: winners,
+      timer_minutes: timer_minutes,
+      timer_seconds: timer_seconds
+    )
+    q = quiz.questions.build(body: "2 + 2?", active: true)
+    q.save_with_option_rows([
+      { body: "3", correct: false },
+      { body: "4", correct: true }
+    ])
+    Game.start_for_quiz!(quiz)
+  end
+end
+
+class GameModeratorChannelTest < ActionCable::Channel::TestCase
+  include GameChannelTestHelper
+  tests GameModeratorChannel
+
+  test "requires valid signed token and transmits state including ended leaderboard" do
+    game = create_game(winners: 2)
+
+    subscribe(token: "invalid-token")
+    assert subscription.rejected?
+
+    token = game.signed_id(purpose: :moderator_stream)
+    subscribe(token: token)
+    assert subscription.confirmed?
+    assert_has_stream game.moderator_stream_name
+    assert_equal "lobby", transmissions.last[:status]
+    assert_equal 2, transmissions.last[:winners_count]
+
+    unsubscribe
+
+    alice = game.players.create!(name: "Alice", client_token: "a")
+    game.start!
+    q = game.current_game_question
+    game.record_answer!(player: alice, game_question_id: q.id, game_option_id: q.game_options.find_by!(correct: true).id)
+    game.finish!
+    game.end_game!
+    game.pick_top_winners!
+
+    subscribe(token: token)
+    assert subscription.confirmed?
+    ended_payload = transmissions.last
+    assert_equal "ended", ended_payload[:status]
+    assert_equal 2, ended_payload[:winners_count]
+    assert_equal 1, ended_payload[:leaderboard].size
+    assert_equal true, ended_payload[:leaderboard][0][:winner]
+  end
+
+  test "timed game transmits timer_remaining_ms while open and auto-closes if expired" do
+    travel_to Time.zone.parse("2026-11-21 16:00:00") do
+      game = create_game(timer_minutes: 1, timer_seconds: 30)
+      game.start!
+
+      token = game.signed_id(purpose: :moderator_stream)
+      subscribe(token: token)
+      assert subscription.confirmed?
+      assert_equal 90_000, transmissions.last[:timer_remaining_ms]
+      unsubscribe
+
+      travel 91.seconds
+      subscribe(token: token)
+      assert subscription.confirmed?
+      assert_equal "question_closed", transmissions.last[:status]
+      assert_nil transmissions.last[:timer_remaining_ms]
+    end
+  end
+end
+
+class GamePlayerChannelTest < ActionCable::Channel::TestCase
+  include GameChannelTestHelper
+  tests GamePlayerChannel
+
+  test "tracks presence, transmits safe player state without timer, and transmits place/points/winner after end" do
+    game = create_game(timer_minutes: 1, timer_seconds: 30)
+    player = game.players.create!(name: "Alice", client_token: "tok-a")
+    game.start!
+
+    subscribe(code: game.code, token: "bad")
+    assert subscription.rejected?
+    assert_equal 0, GamePresence.active_count(game.id)
+
+    token = player.signed_id(purpose: :player_stream)
+    subscribe(code: game.code, token: token)
+    assert subscription.confirmed?
+    assert_has_stream game.public_stream_name
+    assert_has_stream game.player_stream_name(player)
+    assert_equal 1, GamePresence.active_count(game.id)
+
+    payload = transmissions.last
+    assert_equal "question_open", payload[:status]
+    assert_not payload.to_json.downcase.include?("correct")
+    assert_not payload.to_json.downcase.include?("timer")
+    assert_not payload.key?(:points)
+    assert_not payload.key?(:place)
+
+    unsubscribe
+    assert_equal 0, GamePresence.active_count(game.id)
+
+    q = game.current_game_question
+    game.record_answer!(player: player, game_question_id: q.id, game_option_id: q.game_options.find_by!(correct: true).id)
+    game.finish!
+    game.end_game!
+    game.pick_top_winners!
+
+    subscribe(code: game.code, token: token)
+    ended_payload = transmissions.last
+    assert_equal "ended", ended_payload[:status]
+    assert_equal 1, ended_payload[:place]
+    assert_equal 1, ended_payload[:total_players]
+    assert_equal 1, ended_payload[:points]
+    assert_equal true, ended_payload[:winner]
+  end
+end
+
+class GamePublicChannelTest < ActionCable::Channel::TestCase
+  include GameChannelTestHelper
+  tests GamePublicChannel
+
+  test "streams status without counting as active player" do
+    game = create_game
+
+    subscribe(code: game.code)
+    assert subscription.confirmed?
+    assert_has_stream game.public_stream_name
+    assert_equal 0, GamePresence.active_count(game.id)
+    assert_equal "lobby", transmissions.last[:status]
+  end
+end
