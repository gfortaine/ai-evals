+require "application_system_test_case"
+
+class LiveGameTest < ApplicationSystemTestCase
+  def create_conference_quiz
+    quiz = Quiz.create!(title: "Ruby Conf Live")
+
+    q1 = quiz.questions.build(body: "Which HTTP status means Too Many Requests?", active: true)
+    q1.save_with_option_rows([
+      { body: "418", correct: false },
+      { body: "429", correct: true },
+      { body: "503", correct: false }
+    ])
+
+    q2 = quiz.questions.build(body: "Inactive question that must be skipped", active: false)
+    q2.save_with_option_rows([
+      { body: "Skip A", correct: true },
+      { body: "Skip B", correct: false }
+    ])
+
+    q3 = quiz.questions.build(body: "Which protocols run over TCP?", active: true)
+    q3.save_with_option_rows([
+      { body: "HTTP/1.1", correct: true },
+      { body: "WebSocket", correct: true },
+      { body: "UDP", correct: false }
+    ])
+
+    q4 = quiz.questions.build(body: "Final question: 6 * 7?", active: true)
+    q4.save_with_option_rows([
+      { body: "41", correct: false },
+      { body: "42", correct: true }
+    ])
+
+    quiz
+  end
+
+  test "full live game with multiple players, live counters, answer changes, disconnects, late joiner, and no reloads" do
+    quiz = create_conference_quiz
+    join_url = nil
+    game = nil
+
+    # Moderator starts a game from the quiz page
+    using_session(:moderator) do
+      authenticate_as_moderator
+      visit moderate_quiz_path(quiz)
+      assert_selector "h1", text: "Ruby Conf Live"
+
+      click_button "Start a game"
+      assert_match %r{\A/moderate/games/\d+\z}, current_path
+
+      game = Game.last
+      assert_selector "h1", text: "Ruby Conf Live"
+
+      join_url = find(".lobby__url").text.strip
+      assert_includes join_url, "/play/#{game.code}"
+      assert_match %r{\Ahttp://.+?/play/#{game.code}\z}, join_url
+
+      # Verify QR code SVG is rendered with visible size and matches the exact join link
+      assert_selector ".qr svg path"
+      svg_dims = evaluate_script("(() => { const r = document.querySelector('.qr svg').getBoundingClientRect(); return [r.width, r.height]; })()")
+      assert_operator svg_dims[0], :>, 50
+      assert_operator svg_dims[1], :>, 50
+
+      expected_qr = RQRCode::QRCode.new(join_url, level: :m)
+      expected_path_d = Nokogiri::XML(expected_qr.as_svg(module_size: 8, offset: 32, standalone: true, use_path: true)).at_css("path")["d"]
+      actual_path_d = evaluate_script("document.querySelector('.qr svg path').getAttribute('d')")
+      assert_equal expected_path_d, actual_path_d
+
+      # Verify exact visible text with no newline splitting "Players: 0"
+      assert_text "Players: 0"
+      assert_includes evaluate_script("document.body.innerText"), "Players: 0"
+      assert_button "Start"
+    end
+
+    # Player 1 (Alice) opens join link, tests blank validation, then joins
+    using_session(:alice) do
+      visit join_url
+      assert_field "Your name"
+      assert_button "Join"
+
+      click_button "Join"
+      assert_text "Name can't be blank"
+
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    # Moderator sees Players: 1 LIVE without page reload
+    using_session(:moderator) do
+      assert_text "Players: 1"
+    end
+
+    # Player 2 (Bob) joins
+    using_session(:bob) do
+      visit join_url
+      fill_in "Your name", with: "Bob"
+      click_button "Join"
+      assert_text "Hi, Bob!"
+    end
+
+    # Moderator sees Players: 2 LIVE without page reload
+    using_session(:moderator) do
+      assert_text "Players: 2"
+      assert_includes evaluate_script("document.body.innerText"), "Players: 2"
+    end
+
+    # Bob leaves the page -> active players counter drops to 1 LIVE
+    using_session(:bob) do
+      visit "/"
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 1"
+    end
+
+    # Bob opens join link again in same browser -> remembered automatically, back to Players: 2
+    using_session(:bob) do
+      visit join_url
+      assert_text "Hi, Bob!"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 2"
+
+      # Moderator clicks Start -> Question 1 of 3 opens
+      click_button "Start"
+      assert_text "Question 1 of 3"
+      assert_text "Which HTTP status means Too Many Requests?"
+      assert_text "418"
+      assert_text "429"
+      assert_text "503"
+      assert_text "Answers: 0 / 2"
+      assert_includes evaluate_script("document.body.innerText"), "Answers: 0 / 2"
+      assert_button "Finish"
+      assert_no_text "Correct"
+    end
+
+    # Alice receives Question 1 LIVE without reload; verify NO correct answer leak in page source!
+    using_session(:alice) do
+      assert_text "Which HTTP status means Too Many Requests?"
+      assert_button "418"
+      assert_button "429"
+      assert_button "503"
+      assert_not_includes page.html.downcase, "correct"
+
+      # Alice taps wrong answer first -> marked "Your answer"
+      click_button "418"
+      within("button.play-option", text: "418") do
+        assert_text "Your answer"
+      end
+      within("button.play-option", text: "429") do
+        assert_no_text "Your answer"
+      end
+    end
+
+    # Moderator sees Answers: 1 / 2 LIVE
+    using_session(:moderator) do
+      assert_text "Answers: 1 / 2"
+    end
+
+    # Alice changes her mind to 429 -> last pick counts, still 1 / 2
+    using_session(:alice) do
+      click_button "429"
+      within("button.play-option", text: "429") do
+        assert_text "Your answer"
+      end
+      within("button.play-option", text: "418") do
+        assert_no_text "Your answer"
+      end
+    end
+
+    # Bob temporarily leaves -> active players drops so counter shows 1 / 1 LIVE
+    using_session(:bob) do
+      assert_text "Which HTTP status means Too Many Requests?"
+      visit "/"
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 1 / 1"
+    end
+
+    # Bob returns (remembered!) and picks wrong answer 503
+    using_session(:bob) do
+      visit join_url
+      assert_text "Which HTTP status means Too Many Requests?"
+      click_button "503"
+      within("button.play-option", text: "503") do
+        assert_text "Your answer"
+      end
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 2 / 2"
+
+      # Finish Question 1 -> shows answer count for each option + marks correct option with "Correct" + Next button
+      click_button "Finish"
+      assert_button "Next"
+      assert_no_button "End quiz"
+
+      within("ol.stage-options > li", text: "418") do
+        assert_selector ".stage-option__count", text: "0"
+        assert_no_text "Correct"
+      end
+      within("ol.stage-options > li", text: "429") do
+        assert_selector ".stage-option__count", text: "1"
+        assert_text "Correct"
+      end
+      within("ol.stage-options > li", text: "503") do
+        assert_selector ".stage-option__count", text: "1"
+        assert_no_text "Correct"
+      end
+    end
+
+    # Alice sees "Correct!" LIVE, Bob sees "Wrong!" LIVE (and NOT "Correct!")
+    using_session(:alice) do
+      assert_text "Correct!"
+      assert_selector "button.play-option[disabled]", count: 3
+    end
+
+    using_session(:bob) do
+      assert_text "Wrong!"
+      assert_no_text "Correct"
+    end
+
+    # Moderator clicks Next -> skips inactive Q2, opens Q3 as "Question 2 of 3"
+    using_session(:moderator) do
+      click_button "Next"
+      assert_text "Question 2 of 3"
+      assert_text "Which protocols run over TCP?"
+      assert_no_text "Inactive question that must be skipped"
+      assert_text "Answers: 0 / 2"
+    end
+
+    # Late joiner Charlie joins mid-game during Q2!
+    using_session(:charlie) do
+      visit join_url
+      fill_in "Your name", with: "Charlie"
+      click_button "Join"
+      assert_text "Which protocols run over TCP?"
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 0 / 3"
+    end
+
+    # Alice picks HTTP/1.1 (correct), Bob picks WebSocket (also correct), Charlie does not answer
+    using_session(:alice) do
+      assert_text "Which protocols run over TCP?"
+      click_button "HTTP/1.1"
+    end
+    using_session(:bob) do
+      assert_text "Which protocols run over TCP?"
+      click_button "WebSocket"
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 2 / 3"
+
+      click_button "Finish"
+      within("ol.stage-options > li", text: "HTTP/1.1") do
+        assert_text "Correct"
+        assert_selector ".stage-option__count", text: "1"
+      end
+      within("ol.stage-options > li", text: "WebSocket") do
+        assert_text "Correct"
+        assert_selector ".stage-option__count", text: "1"
+      end
+      within("ol.stage-options > li", text: "UDP") do
+        assert_no_text "Correct"
+        assert_selector ".stage-option__count", text: "0"
+      end
+    end
+
+    using_session(:alice) { assert_text "Correct!" }
+    using_session(:bob) { assert_text "Correct!" }
+    using_session(:charlie) do
+      assert_text "No answer"
+      assert_no_text "Correct!"
+      assert_no_text "Wrong!"
+    end
+
+    # Unjoined visitor opens join link right before end
+    using_session(:latecomer) do
+      visit join_url
+      assert_field "Your name"
+      assert_button "Join"
+    end
+
+    # Moderator moves to last question ("Question 3 of 3")
+    using_session(:moderator) do
+      click_button "Next"
+      assert_text "Question 3 of 3"
+      assert_text "Final question: 6 * 7?"
+    end
+
+    using_session(:charlie) do
+      assert_text "Final question: 6 * 7?"
+      click_button "42"
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 1 / 3"
+      click_button "Finish"
+
+      # Last question shows "End quiz" instead of "Next"
+      assert_button "End quiz"
+      assert_no_button "Next"
+    end
+
+    using_session(:charlie) { assert_text "Correct!" }
+    using_session(:alice) { assert_text "No answer" }
+    using_session(:bob) { assert_text "No answer" }
+
+    # Moderator ends the quiz -> everyone sees "The quiz is over" LIVE
+    using_session(:moderator) do
+      click_button "End quiz"
+      assert_text "The quiz is over"
+      assert_no_button "End quiz"
+    end
+
+    using_session(:alice) { assert_text "The quiz is over" }
+    using_session(:bob) { assert_text "The quiz is over" }
+    using_session(:charlie) { assert_text "The quiz is over" }
+    using_session(:latecomer) do
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+
+    # Fresh visitor after end cannot join
+    using_session(:after_end) do
+      visit join_url
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+  end
+
+  test "a quiz can be played multiple times with separate players, and single-question quiz goes straight to End quiz" do
+    quiz = Quiz.create!(title: "Rehearsal vs Talk")
+    q = quiz.questions.build(body: "Ready for launch?", active: true)
+    q.save_with_option_rows([
+      { body: "Yes", correct: true },
+      { body: "No", correct: false }
+    ])
+
+    game1_url = nil
+    game2_url = nil
+
+    # Game 1 (Rehearsal)
+    using_session(:moderator) do
+      authenticate_as_moderator
+      visit moderate_quiz_path(quiz)
+      click_button "Start a game"
+      game1_url = find(".lobby__url").text.strip
+    end
+
+    using_session(:alice) do
+      visit game1_url
+      fill_in "Your name", with: "Alice Rehearsal"
+      click_button "Join"
+      assert_text "Hi, Alice Rehearsal!"
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 1"
+      click_button "Start"
+      assert_text "Question 1 of 1"
+      click_button "Finish"
+      assert_button "End quiz"
+      assert_no_button "Next"
+      click_button "End quiz"
+      assert_text "The quiz is over"
+
+      # Go back to quiz and start Game 2 (Real talk)
+      click_link "← Back to quiz"
+      click_button "Start a game"
+      game2_url = find(".lobby__url").text.strip
+      assert_not_equal game1_url, game2_url
+      assert_text "Players: 0"
+    end
+
+    # Same browser (Alice) opening Game 2 is asked to join fresh for Game 2
+    using_session(:alice) do
+      visit game2_url
+      assert_field "Your name"
+      assert_button "Join"
+
+      fill_in "Your name", with: "Alice Live"
+      click_button "Join"
+      assert_text "Hi, Alice Live!"
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 1"
+    end
+
+    assert_equal 2, quiz.games.count
+  end
+
+  test "player recovers live state after temporary WebSocket disconnection on flaky Wi-Fi" do
+    quiz = Quiz.create!(title: "Conference Wi-Fi Quiz")
+    q1 = quiz.questions.build(body: "First Wi-Fi Q?", active: true)
+    q1.save_with_option_rows([ { body: "A1", correct: true }, { body: "A2", correct: false } ])
+    q2 = quiz.questions.build(body: "Second Wi-Fi Q?", active: true)
+    q2.save_with_option_rows([ { body: "B1", correct: false }, { body: "B2", correct: true } ])
+
+    join_url = nil
+    using_session(:moderator) do
+      authenticate_as_moderator
+      visit moderate_quiz_path(quiz)
+      click_button "Start a game"
+      join_url = find(".lobby__url").text.strip
+    end
+
+    using_session(:alice) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 1"
+      click_button "Start"
+      assert_text "Question 1 of 2"
+    end
+
+    using_session(:alice) do
+      assert_text "First Wi-Fi Q?"
+      # Simulate abrupt WebSocket drop (as on crowded conference Wi-Fi)
+      execute_script("(() => { const el = document.querySelector('[data-controller=\"player-game\"]'); const ctrl = window.Stimulus.getControllerForElementAndIdentifier(el, 'player-game'); if (ctrl && ctrl.consumer) ctrl.consumer.connection.close({ allowReconnect: true }); })()")
+    end
+
+    # Moderator advances through Q1 Finish -> Q2 while Alice's socket is dropping/reconnecting
+    using_session(:moderator) do
+      click_button "Finish"
+      click_button "Next"
+      assert_text "Question 2 of 2"
+    end
+
+    # Alice automatically catches up to Q2 without any page reload!
+    using_session(:alice) do
+      assert_text "Second Wi-Fi Q?", wait: 10
+      click_button "B2"
+      within("button.play-option", text: "B2") do
+        assert_text "Your answer"
+      end
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 1 / 1", wait: 10
+      click_button "Finish"
+    end
+
+    using_session(:alice) do
+      assert_text "Correct!"
+    end
+  end
+
+test "multi-tab same browser deduplicates presence, syncs answers across tabs, handles tab close, reloads, and XSS safely" do
+  quiz = Quiz.create!(title: "XSS <script>window.__xss=1</script> Quiz")
+  q = quiz.questions.build(body: "Safe <b>Question</b>?", active: true)
+  q.save_with_option_rows([
+    { body: "<img src=x onerror=window.__xss=2> Safe A", correct: true },
+    { body: "Safe B", correct: false }
+  ])
+
+  join_url = nil
+  using_session(:moderator) do
+    authenticate_as_moderator
+    visit moderate_quiz_path(quiz)
+    click_button "Start a game"
+    join_url = find(".lobby__url").text.strip
+    assert_text "Players: 0"
+  end
+
+  # Alice joins with special HTML characters in her name
+  xss_name = "<script>window.__xss=3</script> & \"Alice\""
+  using_session(:alice) do
+    visit join_url
+    fill_in "Your name", with: xss_name
+    click_button "Join"
+    assert_text "Hi, #{xss_name}!"
+    assert_nil evaluate_script("window.__xss")
+
+    # Open a second tab in the SAME browser -> remembered as Alice, still 1 active player!
+    second_tab = open_new_window
+    within_window(second_tab) do
+      visit join_url
+      assert_text "Hi, #{xss_name}!"
+    end
+  end
+
+  using_session(:moderator) do
+    assert_text "Players: 1"
+    click_button "Start"
+    assert_text "Question 1 of 1"
+    assert_text "Answers: 0 / 1"
+
+    # Reload moderator screen mid-question -> SSR renders open question cleanly
+    visit current_path
+    assert_text "Question 1 of 1"
+    assert_text "Safe <b>Question</b>?"
+    assert_text "Answers: 0 / 1"
+    assert_nil evaluate_script("window.__xss")
+  end
+
+  # Alice picks answer in Tab 1 -> Tab 2 syncs LIVE! Closing Tab 2 keeps Players = 1!
+  using_session(:alice) do
+    assert_text "Safe <b>Question</b>?"
+    click_button "<img src=x onerror=window.__xss=2> Safe A"
+    within("button.play-option", text: "Safe A") do
+      assert_text "Your answer"
+    end
+
+    second_tab = windows.last
+    within_window(second_tab) do
+      within("button.play-option", text: "Safe A") do
+        assert_text "Your answer"
+      end
+      assert_nil evaluate_script("window.__xss")
+    end
+    second_tab.close
+
+    # Reload Tab 1 -> remembers answer and still no correct leak in page source
+    visit current_path
+    within("button.play-option", text: "Safe A") do
+      assert_text "Your answer"
+    end
+    assert_not_includes page.html.downcase, "correct"
+  end
+
+  # Still 1 / 1 because Tab 1 is still open
+  using_session(:moderator) do
+    assert_text "Answers: 1 / 1"
+    click_button "Finish"
+    assert_button "End quiz"
+    within("ol.stage-options > li", text: "Safe A") do
+      assert_text "Correct"
+      assert_selector ".stage-option__count", text: "1"
+    end
+
+    # Reload moderator on closed question
+    visit current_path
+    assert_button "End quiz"
+    within("ol.stage-options > li", text: "Safe A") do
+      assert_text "Correct"
+      assert_selector ".stage-option__count", text: "1"
+    end
+  end
+
+  using_session(:alice) do
+    assert_text "Correct!"
+    # Reload player on closed question
+    visit current_path
+    assert_text "Correct!"
+  end
+
+  using_session(:moderator) do
+    click_button "End quiz"
+    assert_text "The quiz is over"
+    visit current_path
+    assert_text "The quiz is over"
+  end
+
+  using_session(:alice) do
+    assert_text "The quiz is over"
+    visit current_path
+    assert_text "The quiz is over"
+  end
+end
+end
