+require "rqrcode"
+
+module QrHelper
+  def qr_code_svg(url, aria_label: "QR code to join the quiz")
+    qr = RQRCode::QRCode.new(url.to_s, level: :m)
+    module_size = 8
+    quiet_zone = module_size * 4
+    dimension = (qr.modules.size * module_size) + (quiet_zone * 2)
+
+    inner = qr.as_svg(
+      color: "000000",
+      fill: "ffffff",
+      module_size: module_size,
+      offset: quiet_zone,
+      standalone: false,
+      use_path: true
+    )
+
+    content_tag(
+      :svg,
+      inner.html_safe,
+      xmlns: "http://www.w3.org/2000/svg",
+      viewBox: "0 0 #{dimension} #{dimension}",
+      width: dimension,
+      height: dimension,
+      "shape-rendering": "crispEdges",
+      role: "img",
+      "aria-label": aria_label
+    )
+  end
+end
