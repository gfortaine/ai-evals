diff --git a/app/views/moderate/games/show.html.erb b/app/views/moderate/games/show.html.erb
new file mode 100644
index 0000000..2423f6a
--- /dev/null
+++ b/app/views/moderate/games/show.html.erb
@@ -0,0 +1,183 @@
+<% content_for :title, "#{@game.quiz.title} · Live · Quizzy" %>
+<% content_for :head do %>
+  <meta name="turbo-cache-control" content="no-cache">
+<% end %>
+
+<%
+  cover_classes = case @state[:status]
+  when "lobby" then "cover"
+  when "ended" then "cover cover--night"
+  else "cover cover--blue cover--calm"
+  end
+%>
+
+<section class="<%= cover_classes %>"
+         data-controller="moderator-game"
+         data-moderator-game-stream-token-value="<%= @stream_token %>"
+         data-moderator-game-state-url-value="<%= state_moderate_game_path(@game) %>"
+         data-moderator-game-start-url-value="<%= start_moderate_game_path(@game) %>"
+         data-moderator-game-finish-url-value="<%= finish_moderate_game_path(@game) %>"
+         data-moderator-game-next-url-value="<%= next_moderate_game_path(@game) %>"
+         data-moderator-game-end-url-value="<%= end_moderate_game_path(@game) %>"
+         data-moderator-game-top-winners-url-value="<%= top_winners_moderate_game_path(@game) %>"
+         data-moderator-game-draw-winners-url-value="<%= draw_winners_moderate_game_path(@game) %>"
+         data-moderator-game-reset-winners-url-value="<%= reset_winners_moderate_game_path(@game) %>"
+         data-moderator-game-back-url-value="<%= moderate_quiz_path(@game.quiz) %>"
+         data-moderator-game-initial-state-value="<%= @state.to_json %>">
+  <div class="screen">
+    <div class="screen__top">
+      <span class="logo screen__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+      <span><%= @game.quiz.title %></span>
+    </div>
+
+    <div class="screen__body" data-moderator-game-target="body">
+      <% case @state[:status] %>
+      <% when "lobby" %>
+        <div class="lobby" data-stage="lobby">
+          <div>
+            <h1 class="lobby__title"><%= @game.quiz.title %></h1>
+            <div class="lobby__join">Join at</div>
+            <div class="lobby__url"><%= @join_url %></div>
+            <div class="counter-pill">
+              <span>Players: <strong data-moderator-game-target="playersCount"><%= @state[:active_players_count] %></strong></span>
+            </div>
+          </div>
+          <div class="qr">
+            <%= qr_code_svg(@join_url, aria_label: "QR code for #{@join_url}") %>
+          </div>
+        </div>
+
+      <% when "question_open" %>
+        <div data-stage="question_open">
+          <div class="stage-question__header">
+            <div class="stage-question__num">Question <%= @state[:question_number] %> of <%= @state[:total_questions] %></div>
+            <% if @state[:timer_remaining_ms].present? %>
+              <% remaining_seconds = [ (@state[:timer_remaining_ms].to_f / 1000.0).ceil, 0 ].max %>
+              <div class="stage-timer <%= 'stage-timer--urgent' if remaining_seconds <= 5 %>"
+                   data-moderator-game-target="timer"
+                   role="timer"
+                   aria-live="off"><%= format_timer_ms(@state[:timer_remaining_ms]) %></div>
+            <% end %>
+          </div>
+          <div class="stage-question__body"><%= @state[:question][:body] %></div>
+          <ol class="stage-options">
+            <% @state[:question][:options].each_with_index do |opt, idx| %>
+              <li class="stage-option">
+                <span class="stage-option__letter" aria-hidden="true"><%= option_letter(idx) %></span>
+                <span class="stage-option__title"><%= opt[:body] %></span>
+              </li>
+            <% end %>
+          </ol>
+        </div>
+
+      <% when "question_closed" %>
+        <div data-stage="question_closed">
+          <div class="stage-question__header">
+            <div class="stage-question__num">Question <%= @state[:question_number] %> of <%= @state[:total_questions] %></div>
+          </div>
+          <div class="stage-question__body"><%= @state[:question][:body] %></div>
+          <ol class="stage-options stage-options--results">
+            <% @state[:question][:options].each_with_index do |opt, idx| %>
+              <li class="stage-option <%= 'is-correct' if opt[:correct] %>" <%= 'data-correct="true"' if opt[:correct] %>>
+                <span class="stage-option__bar" style="--share: <%= opt[:share] %>%" aria-hidden="true"></span>
+                <span class="stage-option__letter" aria-hidden="true"><%= option_letter(idx) %></span>
+                <span class="stage-option__title"><%= opt[:body] %></span>
+                <% if opt[:correct] %>
+                  <span class="stage-option__mark">Correct</span>
+                <% end %>
+                <span class="stage-option__count"><%= opt[:count] %></span>
+              </li>
+            <% end %>
+          </ol>
+        </div>
+
+      <% when "ended" %>
+        <div class="leaderboard-layout" data-stage="ended">
+          <div>
+            <div class="screen__kicker"><%= @game.quiz.title %></div>
+            <h1 class="leaderboard-layout__title">The quiz is over</h1>
+          </div>
+          <div>
+            <% leaderboard = Array(@state[:leaderboard]) %>
+            <% if leaderboard.any? %>
+              <ol class="leaderboard">
+                <% leaderboard.each do |entry| %>
+                  <li class="leader <%= 'is-winner' if entry[:winner] %>"
+                      data-player-id="<%= entry[:player_id] %>"
+                      <%= 'data-winner="true"' if entry[:winner] %>>
+                    <span class="leader__place"><%= entry[:place] %></span>
+                    <span class="leader__identity">
+                      <span class="leader__name"><%= entry[:name] %></span>
+                      <% if entry[:winner] %>
+                        <span class="leader__badge">Winner</span>
+                      <% end %>
+                    </span>
+                    <span class="leader__score"><%= points_label(entry[:points]) %></span>
+                  </li>
+                <% end %>
+              </ol>
+            <% else %>
+              <p class="play-lead">No players joined this quiz.</p>
+            <% end %>
+          </div>
+        </div>
+      <% end %>
+    </div>
+  </div>
+
+  <div class="screen-controls" data-moderator-game-target="controls">
+    <div class="screen-controls__info">
+      <%= link_to "← Back to quiz", moderate_quiz_path(@game.quiz) %>
+      <% if @state[:status] == "question_open" %>
+        <span class="answers-counter">Answers: <span data-moderator-game-target="answersCount"><%= @state[:answers_count] %></span> / <span data-moderator-game-target="activePlayersCount"><%= @state[:active_players_count] %></span></span>
+      <% end %>
+    </div>
+
+    <div class="buttons">
+      <% case @state[:status] %>
+      <% when "lobby" %>
+        <%= button_to "Start",
+              start_moderate_game_path(@game),
+              method: :post,
+              class: "btn btn--pink btn--lg",
+              form: { class: "inline-form", data: { turbo: false, action: "submit->moderator-game#start" } } %>
+      <% when "question_open" %>
+        <%= button_to "Finish",
+              finish_moderate_game_path(@game),
+              method: :post,
+              class: "btn btn--pink btn--lg",
+              form: { class: "inline-form", data: { turbo: false, action: "submit->moderator-game#finish" } } %>
+      <% when "question_closed" %>
+        <% if @state[:last_question] %>
+          <%= button_to "End quiz",
+                end_moderate_game_path(@game),
+                method: :post,
+                class: "btn btn--pink btn--lg",
+                form: { class: "inline-form", data: { turbo: false, action: "submit->moderator-game#endGame" } } %>
+        <% else %>
+          <%= button_to "Next",
+                next_moderate_game_path(@game),
+                method: :post,
+                class: "btn btn--pink btn--lg",
+                form: { class: "inline-form", data: { turbo: false, action: "submit->moderator-game#next" } } %>
+        <% end %>
+      <% when "ended" %>
+        <%= button_to "Top #{@state[:winners_count]}",
+              top_winners_moderate_game_path(@game),
+              method: :post,
+              class: "btn btn--pink btn--lg",
+              form: { class: "inline-form", data: { turbo: false, action: "submit->moderator-game#topWinners" } } %>
+        <%= button_to "Draw",
+              draw_winners_moderate_game_path(@game),
+              method: :post,
+              class: "btn btn--light btn--lg",
+              form: { class: "inline-form", data: { turbo: false, action: "submit->moderator-game#drawWinners" } } %>
+        <%= button_to "Reset winners",
+              reset_winners_moderate_game_path(@game),
+              method: :post,
+              class: "btn btn--ghost btn--lg",
+              form: { class: "inline-form", data: { turbo: false, action: "submit->moderator-game#resetWinners" } } %>
+      <% end %>
+    </div>
+  </div>
+</section>
