diff --git a/app/views/moderate/quizzes/show.html.erb b/app/views/moderate/quizzes/show.html.erb
new file mode 100644
index 0000000..f38bb35
--- /dev/null
+++ b/app/views/moderate/quizzes/show.html.erb
@@ -0,0 +1,104 @@
+<% content_for :title, "#{@quiz.title} · Quizzy" %>
+
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<% if flash[:alert].present? %>
+  <div class="errors" role="alert"><%= flash[:alert] %></div>
+<% end %>
+<div class="page-head">
+  <div>
+    <h1><%= @quiz.title %></h1>
+    <div class="meta mt-2">
+      <%= @active_count %> of <%= @questions.size %> <%= "question".pluralize(@questions.size) %> active ·
+      <%= link_to "Settings", edit_moderate_quiz_path(@quiz) %> ·
+      <%= link_to "Export", moderate_quiz_export_path(@quiz) %>
+    </div>
+  </div>
+  <div class="buttons">
+    <%= link_to "Preview", moderate_quiz_preview_path(@quiz), class: "btn btn--ghost" %>
+    <%= button_to "Start a game",
+          moderate_quiz_games_path(@quiz),
+          method: :post,
+          class: "btn btn--pink",
+          form: { class: "inline-form" },
+          disabled: @active_count.zero?,
+          title: (@active_count.zero? ? "Activate at least one question to start a game" : nil) %>
+  </div>
+</div>
+
+<section class="section mt-0">
+  <div class="section-head">
+    <h2>Questions</h2>
+    <%= link_to "Add question", new_moderate_quiz_question_path(@quiz), class: "btn" %>
+  </div>
+
+  <% if @questions.any? %>
+    <% active_number = 0 %>
+    <ol class="question-list">
+      <% @questions.each_with_index do |question, index| %>
+        <% active_number += 1 if question.active? %>
+        <li class="card question-item <%= 'question-item--inactive' unless question.active? %>" id="<%= dom_id(question) %>">
+          <div class="question-item__num"><%= question.active? ? active_number : "—" %></div>
+          <div>
+            <div class="question-item__body"><%= question.body %></div>
+            <ul class="question-item__options">
+              <% question.options.each_with_index do |option, option_index| %>
+                <% if option.correct? %>
+                  <li class="is-correct" data-correct="true"><span aria-hidden="true">✓ </span><%= "#{option_letter(option_index)}. #{option.body}" %><span class="visually-hidden"> (correct)</span></li>
+                <% else %>
+                  <li><%= "#{option_letter(option_index)}. #{option.body}" %></li>
+                <% end %>
+              <% end %>
+            </ul>
+          </div>
+          <div class="question-item__actions">
+            <div class="buttons">
+              <%= button_to move_up_moderate_quiz_question_path(@quiz, question),
+                    method: :patch,
+                    class: "btn btn--ghost btn--icon",
+                    disabled: (index == 0),
+                    aria: { label: "Move up" },
+                    title: "Move up" do %>
+                <span aria-hidden="true">↑</span><span class="visually-hidden">Move up</span>
+              <% end %>
+              <%= button_to move_down_moderate_quiz_question_path(@quiz, question),
+                    method: :patch,
+                    class: "btn btn--ghost btn--icon",
+                    disabled: (index == @questions.size - 1),
+                    aria: { label: "Move down" },
+                    title: "Move down" do %>
+                <span aria-hidden="true">↓</span><span class="visually-hidden">Move down</span>
+              <% end %>
+            </div>
+
+            <%= form_with model: [ :moderate, @quiz, question ],
+                  url: toggle_active_moderate_quiz_question_path(@quiz, question),
+                  method: :patch,
+                  class: "inline-form",
+                  data: { controller: "auto-submit" } do |form| %>
+              <%= hidden_field_tag "question[active]", "0", id: nil %>
+              <label class="checkbox" for="question_<%= question.id %>_active">
+                <%= check_box_tag "question[active]", "1", question.active?,
+                      id: "question_#{question.id}_active",
+                      data: { action: "change->auto-submit#submit" } %>
+                Active
+              </label>
+            <% end %>
+
+            <div class="buttons">
+              <%= link_to "Edit", edit_moderate_quiz_question_path(@quiz, question), class: "btn btn--sm" %>
+              <%= button_to "Delete",
+                    moderate_quiz_question_path(@quiz, question),
+                    method: :delete,
+                    class: "btn btn--sm btn--danger",
+                    form: { data: { turbo_confirm: "Delete this question?" } } %>
+            </div>
+          </div>
+        </li>
+      <% end %>
+    </ol>
+  <% else %>
+    <div class="empty">
+      No questions yet. Add your first question to build this quiz.
+    </div>
+  <% end %>
+</section>
