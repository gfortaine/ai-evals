+  get "up" => "rails/health#show", as: :rails_health_check
+
+  root "home#show"
+
+  get "play/:code", to: "plays#show", as: :play
+  post "play/:code/join", to: "plays#join", as: :join_play
+  post "play/:code/answer", to: "plays#answer", as: :answer_play
+  get "play/:code/state", to: "plays#state", as: :state_play
+
+  namespace :moderate do
+    root to: "quizzes#index"
+
+    get "import", to: "imports#new", as: :new_import
+    post "import", to: "imports#create", as: :import
+
+    resources :quizzes do
+      resource :preview, only: :show, controller: "previews"
+      resource :export, only: :show, controller: "exports"
+      resources :games, only: :create
+      resources :questions, except: %i[index show] do
+        member do
+          patch :move_up
+          patch :move_down
+          patch :toggle_active
+        end
+      end
+    end
+
+    resources :games, only: :show do
+      member do
+        get :state
+        post :start
+        post :finish
+        post :next
+        post :end, action: :end_game
+        post :top_winners
+        post :draw_winners
+        post :reset_winners
+      end
+    end
+  end
+end
