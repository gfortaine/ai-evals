new file mode 100644
index 0000000..1e8c6a6
--- /dev/null
+++ b/test/models/game_scoring_and_winners_test.rb
@@ -0,0 +1,301 @@
+require "test_helper"
+
+class GameScoringAndWinnersTest < ActiveSupport::TestCase
+  def create_quiz(winners: 3, question_count: 3)
+    quiz = Quiz.create!(title: "Prizes Quiz", number_of_winners: winners)
+    question_count.times do |i|
+      q = quiz.questions.build(body: "Question #{i + 1}?", active: true)
+      q.save_with_option_rows([
+        { body: "Correct A", correct: true },
+        { body: "Correct B", correct: true },
+        { body: "Wrong C", correct: false }
+      ])
+    end
+    quiz
+  end
+
+  def option_by_body(question, body)
+    question.game_options.find_by!(body: body)
+  end
+
+  test "scores 1 point per correct answer, ranks ties by lower total correct answer time using last pick, and excludes wrong answer times" do
+    quiz = create_quiz(winners: 3, question_count: 2)
+    game = Game.start_for_quiz!(quiz)
+
+    alice = game.players.create!(name: "Alice", client_token: "a")
+    bob = game.players.create!(name: "Bob", client_token: "b")
+    charlie = game.players.create!(name: "Charlie", client_token: "c")
+    dave = game.players.create!(name: "Dave", client_token: "d")
+    eve = game.players.create!(name: "Eve", client_token: "e")
+
+    base = Time.zone.parse("2026-11-21 12:00:00")
+
+    # Question 1
+    travel_to(base) { game.start! }
+    q1 = game.reload.current_game_question
+
+    # Alice picks correct early (+1s), then changes to wrong (+2s), then back to correct (+5s) -> last pick is +5s
+    travel_to(base + 1.second) { game.record_answer!(player: alice, game_question_id: q1.id, game_option_id: option_by_body(q1, "Correct A").id) }
+    travel_to(base + 2.seconds) { game.record_answer!(player: alice, game_question_id: q1.id, game_option_id: option_by_body(q1, "Wrong C").id) }
+    travel_to(base + 5.seconds) { game.record_answer!(player: alice, game_question_id: q1.id, game_option_id: option_by_body(q1, "Correct B").id) }
+
+    # Bob picks correct at +3s
+    travel_to(base + 3.seconds) { game.record_answer!(player: bob, game_question_id: q1.id, game_option_id: option_by_body(q1, "Correct A").id) }
+
+    # Charlie picks wrong very slowly (+20s) -> must NOT count toward Charlie's correct answer time!
+    travel_to(base + 20.seconds) { game.record_answer!(player: charlie, game_question_id: q1.id, game_option_id: option_by_body(q1, "Wrong C").id) }
+
+    # Dave picks wrong at +0.5s -> 0 points
+    travel_to(base + 0.5.seconds) { game.record_answer!(player: dave, game_question_id: q1.id, game_option_id: option_by_body(q1, "Wrong C").id) }
+
+    # Eve does not answer Q1
+
+    # During open & closed question, players must NOT see points or leaderboard
+    assert_not game.player_state_for(alice).key?(:points)
+    assert_not game.player_state_for(alice).key?(:place)
+    assert_not game.player_state_for(alice).key?(:winner)
+
+    travel_to(base + 25.seconds) { game.finish! }
+    assert_not game.player_state_for(alice).key?(:points)
+    assert_not game.player_state_for(alice).key?(:place)
+    assert_not game.player_state_for(alice).key?(:winner)
+
+    # Question 2 opens at base + 30s
+    q2_open = base + 30.seconds
+    travel_to(q2_open) { game.next_question! }
+    q2 = game.reload.current_game_question
+
+    # Alice picks correct at +1s -> total correct time: 5s + 1s = 6s (2 points)
+    travel_to(q2_open + 1.second) { game.record_answer!(player: alice, game_question_id: q2.id, game_option_id: option_by_body(q2, "Correct A").id) }
+
+    # Bob picks correct at +4s -> total correct time: 3s + 4s = 7s (2 points) -> Alice (6s) beats Bob (7s)!
+    travel_to(q2_open + 4.seconds) { game.record_answer!(player: bob, game_question_id: q2.id, game_option_id: option_by_body(q2, "Correct B").id) }
+
+    # Charlie picks correct at +1.5s -> total correct time: 1.5s (1 point; Q1 wrong +20s excluded!)
+    travel_to(q2_open + 1.5.seconds) { game.record_answer!(player: charlie, game_question_id: q2.id, game_option_id: option_by_body(q2, "Correct A").id) }
+
+    # Dave picks correct at +2.0s -> total correct time: 2.0s (1 point) -> Charlie (1.5s) beats Dave (2.0s)!
+    travel_to(q2_open + 2.0.seconds) { game.record_answer!(player: dave, game_question_id: q2.id, game_option_id: option_by_body(q2, "Correct A").id) }
+
+    # Eve never answers -> 0 points
+
+    travel_to(q2_open + 10.seconds) { game.finish! }
+    travel_to(q2_open + 12.seconds) { game.end_game! }
+
+    entries = game.leaderboard_entries
+    assert_equal [ "Alice", "Bob", "Charlie", "Dave", "Eve" ], entries.map { |e| e[:name] }
+    assert_equal [ 1, 2, 3, 4, 5 ], entries.map { |e| e[:place] }
+    assert_equal [ 2, 2, 1, 1, 0 ], entries.map { |e| e[:points] }
+    assert_equal [ false, false, false, false, false ], entries.map { |e| e[:winner] }
+
+    # Verify player_state_for ended game
+    bob_state = game.player_state_for(bob)
+    assert_equal 2, bob_state[:place]
+    assert_equal 5, bob_state[:total_players]
+    assert_equal 2, bob_state[:points]
+    assert_equal false, bob_state[:winner]
+
+    eve_state = game.player_state_for(eve)
+    assert_equal 5, eve_state[:place]
+    assert_equal 5, eve_state[:total_players]
+    assert_equal 0, eve_state[:points]
+    assert_equal false, eve_state[:winner]
+  end
+
+  test "Top N selects first N leaderboard players with points > 0 and Reset winners clears them" do
+    quiz = create_quiz(winners: 3, question_count: 2)
+    game = Game.start_for_quiz!(quiz)
+    p1 = game.players.create!(name: "P1", client_token: "1")
+    p2 = game.players.create!(name: "P2", client_token: "2")
+    p3 = game.players.create!(name: "P3", client_token: "3")
+    p4 = game.players.create!(name: "P4", client_token: "4")
+
+    base = Time.zone.parse("2026-11-21 12:00:00")
+    travel_to(base) { game.start! }
+    q1 = game.reload.current_game_question
+    correct1 = option_by_body(q1, "Correct A")
+
+    # All 4 answer correctly at different speeds
+    travel_to(base + 1.second) { game.record_answer!(player: p1, game_question_id: q1.id, game_option_id: correct1.id) }
+    travel_to(base + 2.seconds) { game.record_answer!(player: p2, game_question_id: q1.id, game_option_id: correct1.id) }
+    travel_to(base + 3.seconds) { game.record_answer!(player: p3, game_question_id: q1.id, game_option_id: correct1.id) }
+    travel_to(base + 4.seconds) { game.record_answer!(player: p4, game_question_id: q1.id, game_option_id: correct1.id) }
+
+    travel_to(base + 5.seconds) { game.finish! }
+    travel_to(base + 6.seconds) { game.next_question! }
+    travel_to(base + 7.seconds) { game.finish! }
+
+    # Cannot pick winners before game ends
+    assert_not game.pick_top_winners!
+    assert_not game.draw_winners!
+    assert_not game.reset_winners!
+
+    travel_to(base + 8.seconds) { game.end_game! }
+
+    assert game.pick_top_winners!
+    assert_equal [ p1.id, p2.id, p3.id ], game.players.where(winner: true).order(:id).pluck(:id)
+    assert_equal true, game.player_state_for(p1)[:winner]
+    assert_equal false, game.player_state_for(p4)[:winner]
+
+    assert game.reset_winners!
+    assert_equal [], game.players.where(winner: true).pluck(:id)
+    assert_equal false, game.player_state_for(p1)[:winner]
+  end
+
+  test "players with 0 points never win, and if fewer than N have points all of them win" do
+    quiz = create_quiz(winners: 3, question_count: 1)
+    game = Game.start_for_quiz!(quiz)
+    p1 = game.players.create!(name: "Scorer1", client_token: "1")
+    p2 = game.players.create!(name: "Scorer2", client_token: "2")
+    p3 = game.players.create!(name: "Zero1", client_token: "3")
+    p4 = game.players.create!(name: "Zero2", client_token: "4")
+
+    base = Time.zone.parse("2026-11-21 12:00:00")
+    travel_to(base) { game.start! }
+    q1 = game.reload.current_game_question
+    correct1 = option_by_body(q1, "Correct A")
+    wrong1 = option_by_body(q1, "Wrong C")
+
+    travel_to(base + 1.second) { game.record_answer!(player: p1, game_question_id: q1.id, game_option_id: correct1.id) }
+    travel_to(base + 2.seconds) { game.record_answer!(player: p2, game_question_id: q1.id, game_option_id: correct1.id) }
+    travel_to(base + 0.5.seconds) { game.record_answer!(player: p3, game_question_id: q1.id, game_option_id: wrong1.id) }
+
+    travel_to(base + 5.seconds) { game.finish! }
+    travel_to(base + 6.seconds) { game.end_game! }
+
+    # Top 3 -> only 2 players have points, both win, 0-point players never win
+    game.pick_top_winners!
+    assert_equal [ p1.id, p2.id ], game.players.where(winner: true).order(:id).pluck(:id)
+
+    # Draw -> same rule: fewer than 3 have points, so all 2 with points win, 0-point players never win
+    game.draw_winners!
+    assert_equal [ p1.id, p2.id ], game.players.where(winner: true).order(:id).pluck(:id)
+    assert_not p3.reload.winner?
+    assert_not p4.reload.winner?
+  end
+
+  test "all players with 0 points results in 0 winners for both Top N and Draw" do
+    quiz = create_quiz(winners: 3, question_count: 1)
+    game = Game.start_for_quiz!(quiz)
+    game.players.create!(name: "ZeroA", client_token: "a")
+    game.players.create!(name: "ZeroB", client_token: "b")
+
+    game.start!
+    game.finish!
+    game.end_game!
+
+    game.pick_top_winners!
+    assert_equal 0, game.players.where(winner: true).count
+
+    game.draw_winners!
+    assert_equal 0, game.players.where(winner: true).count
+  end
+
+  test "Draw guarantees players above N-th place points and randomly draws remaining prizes among players tied at N-th place points regardless of speed" do
+    quiz = create_quiz(winners: 3, question_count: 3)
+    game = Game.start_for_quiz!(quiz)
+
+    # 1st: Alice (3 pts) -> strictly above cutoff (1 pt) -> ALWAYS wins
+    # 2nd: Bob (2 pts) -> strictly above cutoff (1 pt) -> ALWAYS wins
+    # 3rd-5th: Charlie (1 pt, 1s), Dave (1 pt, 2s), Eve (1 pt, 3s) -> tied at 3rd place's points (1 pt) -> 1 drawn at random!
+    # 6th: Frank (0 pts) -> NEVER wins
+    alice = game.players.create!(name: "Alice", client_token: "a")
+    bob = game.players.create!(name: "Bob", client_token: "b")
+    charlie = game.players.create!(name: "Charlie", client_token: "c")
+    dave = game.players.create!(name: "Dave", client_token: "d")
+    eve = game.players.create!(name: "Eve", client_token: "e")
+    frank = game.players.create!(name: "Frank", client_token: "f")
+
+    base = Time.zone.parse("2026-11-21 12:00:00")
+
+    # Q1: Alice, Bob, Charlie, Dave, Eve get it right (at different speeds)
+    travel_to(base) { game.start! }
+    q1 = game.reload.current_game_question
+    c1 = option_by_body(q1, "Correct A")
+    travel_to(base + 1.second) { game.record_answer!(player: alice, game_question_id: q1.id, game_option_id: c1.id) }
+    travel_to(base + 1.second) { game.record_answer!(player: bob, game_question_id: q1.id, game_option_id: c1.id) }
+    travel_to(base + 1.second) { game.record_answer!(player: charlie, game_question_id: q1.id, game_option_id: c1.id) }
+    travel_to(base + 2.seconds) { game.record_answer!(player: dave, game_question_id: q1.id, game_option_id: c1.id) }
+    travel_to(base + 3.seconds) { game.record_answer!(player: eve, game_question_id: q1.id, game_option_id: c1.id) }
+    travel_to(base + 5.seconds) { game.finish! }
+
+    # Q2: Alice, Bob get it right
+    travel_to(base + 10.seconds) { game.next_question! }
+    q2 = game.reload.current_game_question
+    c2 = option_by_body(q2, "Correct A")
+    travel_to(base + 11.seconds) { game.record_answer!(player: alice, game_question_id: q2.id, game_option_id: c2.id) }
+    travel_to(base + 11.seconds) { game.record_answer!(player: bob, game_question_id: q2.id, game_option_id: c2.id) }
+    travel_to(base + 15.seconds) { game.finish! }
+
+    # Q3: Alice gets it right
+    travel_to(base + 20.seconds) { game.next_question! }
+    q3 = game.reload.current_game_question
+    c3 = option_by_body(q3, "Correct A")
+    travel_to(base + 21.seconds) { game.record_answer!(player: alice, game_question_id: q3.id, game_option_id: c3.id) }
+    travel_to(base + 25.seconds) { game.finish! }
+    travel_to(base + 26.seconds) { game.end_game! }
+
+    # Verify Top 3 picks Alice, Bob, Charlie (fastest of 1-pt players)
+    game.pick_top_winners!
+    assert_equal [ alice.id, bob.id, charlie.id ].sort, game.players.where(winner: true).pluck(:id).sort
+
+    # Verify Draw over 30 draws: Alice & Bob ALWAYS win, Frank NEVER wins, and all 3 tied players (Charlie, Dave, Eve) get picked at least once
+    drawn_third = Set.new
+    rng = Random.new(12345)
+    30.times do
+      game.draw_winners!(random: rng)
+      winners = game.players.where(winner: true).pluck(:id)
+      assert_equal 3, winners.size
+      assert_includes winners, alice.id
+      assert_includes winners, bob.id
+      assert_not_includes winners, frank.id
+      third = (winners - [ alice.id, bob.id ]).first
+      assert_includes [ charlie.id, dave.id, eve.id ], third
+      drawn_third.add(third)
+    end
+
+    assert_equal Set[charlie.id, dave.id, eve.id], drawn_third
+  end
+
+  test "Draw handles all players tied at 1st place (nobody strictly above cutoff)" do
+    quiz = create_quiz(winners: 2, question_count: 1)
+    game = Game.start_for_quiz!(quiz)
+    players = 4.times.map { |i| game.players.create!(name: "P#{i + 1}", client_token: "t#{i}") }
+
+    base = Time.zone.parse("2026-11-21 12:00:00")
+    travel_to(base) { game.start! }
+    q1 = game.reload.current_game_question
+    c1 = option_by_body(q1, "Correct A")
+    players.each_with_index do |p, idx|
+      travel_to(base + (idx + 1).seconds) { game.record_answer!(player: p, game_question_id: q1.id, game_option_id: c1.id) }
+    end
+    travel_to(base + 10.seconds) { game.finish! }
+    travel_to(base + 11.seconds) { game.end_game! }
+
+    # Even the fastest player (P1) is in the random pool because nobody has MORE points than 2nd place!
+    seen_sets = Set.new
+    rng = Random.new(999)
+    30.times do
+      game.draw_winners!(random: rng)
+      winners = game.players.where(winner: true).pluck(:id).sort
+      assert_equal 2, winners.size
+      seen_sets.add(winners)
+    end
+
+    assert_operator seen_sets.size, :>, 1
+    assert seen_sets.any? { |s| !s.include?(players[0].id) }, "Fastest player should not be guaranteed when tied on points"
+  end
+
+  test "Draw handles game with 0 players gracefully" do
+    quiz = create_quiz(winners: 3, question_count: 1)
+    game = Game.start_for_quiz!(quiz)
+    game.start!
+    game.finish!
+    game.end_game!
+
+    assert_equal [], game.leaderboard_entries
+    assert game.pick_top_winners!
+    assert game.draw_winners!
+    assert game.reset_winners!
+  end
+end
diff --git a/test/models/game_test.rb b/test/models/game_test.rb
new file mode 100644
index 0000000..99f3479
--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,218 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  def build_quiz_with_questions
+    quiz = Quiz.create!(title: "Conference Quiz")
+
+    q1 = quiz.questions.build(body: "First active?", active: true)
+    q1.save_with_option_rows([
+      { body: "Wrong A", correct: false },
+      { body: "Right B", correct: true }
+    ])
+
+    q2 = quiz.questions.build(body: "Inactive skipped?", active: false)
+    q2.save_with_option_rows([
+      { body: "Skip 1", correct: true },
+      { body: "Skip 2", correct: false }
+    ])
+
+    q3 = quiz.questions.build(body: "Second active (multi)?", active: true)
+    q3.save_with_option_rows([
+      { body: "Right 1", correct: true },
+      { body: "Right 2", correct: true },
+      { body: "Wrong 3", correct: false }
+    ])
+
+    quiz
+  end
+
+  test "start_for_quiz! snapshots active questions and skips inactive ones" do
+    quiz = build_quiz_with_questions
+    game = Game.start_for_quiz!(quiz)
+
+    assert_equal "lobby", game.status
+    assert_match(/\A[A-Z2-9]{5}\z/, game.code)
+    assert_equal 2, game.game_questions.count
+    assert_equal [ "First active?", "Second active (multi)?" ], game.game_questions.ordered.pluck(:body)
+    assert_equal [ 1, 2 ], game.game_questions.ordered.pluck(:position)
+  end
+
+  test "start_for_quiz! raises NoActiveQuestionsError when quiz has no active questions" do
+    quiz = Quiz.create!(title: "Empty Quiz")
+    assert_raises(Game::NoActiveQuestionsError) do
+      Game.start_for_quiz!(quiz)
+    end
+  end
+
+  test "editing or deleting source quiz questions does not affect an existing game" do
+    quiz = build_quiz_with_questions
+    game = Game.start_for_quiz!(quiz)
+    game.start!
+
+    # Modify and delete original questions on the quiz
+    q1 = quiz.questions.ordered.first
+    q1.save_with_option_rows([
+      { body: "Changed Option 1", correct: true },
+      { body: "Changed Option 2", correct: false }
+    ])
+    quiz.questions.ordered.last.destroy!
+
+    game.reload
+    assert_equal 2, game.game_questions.count
+    assert_equal [ "Wrong A", "Right B" ], game.current_game_question.game_options.ordered.pluck(:body)
+  end
+
+  test "destroying a quiz cascades cleanly through games, players, and answers" do
+    quiz = build_quiz_with_questions
+    game = Game.start_for_quiz!(quiz)
+    player = game.players.create!(name: "Alice", client_token: "tok-1")
+    game.start!
+    q = game.current_game_question
+    game.record_answer!(player: player, game_question_id: q.id, game_option_id: q.game_options.first.id)
+
+    assert_equal 1, Game.count
+    assert_equal 1, Player.count
+    assert_equal 1, Answer.count
+
+    quiz.destroy!
+
+    assert_equal 0, Quiz.count
+    assert_equal 0, Game.count
+    assert_equal 0, GameQuestion.count
+    assert_equal 0, GameOption.count
+    assert_equal 0, Player.count
+    assert_equal 0, Answer.count
+  end
+
+  test "quiz export format stays strictly title and questions even after games are played" do
+    quiz = build_quiz_with_questions
+    game = Game.start_for_quiz!(quiz)
+    game.players.create!(name: "Alice", client_token: "tok-1")
+    game.start!
+
+    exported = Quiz::Exporter.new(quiz).as_json
+    assert_equal %w[title questions], exported.keys
+    assert_equal 3, exported["questions"].size
+  end
+
+  test "state transitions respect order and expected_version guard" do
+    quiz = build_quiz_with_questions
+    game = Game.start_for_quiz!(quiz)
+
+    # Cannot finish or next from lobby
+    assert_not game.finish!
+    assert_not game.next_question!
+    assert_not game.end_game!
+
+    # Wrong expected_version does nothing
+    assert_not game.start!(expected_version: 99)
+    assert game.lobby?
+
+    assert game.start!(expected_version: 0)
+    assert game.question_open?
+    assert_equal 1, game.current_question_number
+    assert_not game.last_question?
+
+    # Cannot next or end while question is open
+    assert_not game.next_question!
+    assert_not game.end_game!
+
+    assert game.finish!(expected_version: game.state_version)
+    assert game.question_closed?
+    assert_not game.end_game! # Not last question yet
+
+    # Double-click guard: stale version fails
+    stale = game.state_version
+    assert game.next_question!(expected_version: stale)
+    assert_not game.next_question!(expected_version: stale)
+
+    assert game.question_open?
+    assert_equal 2, game.current_question_number
+    assert game.last_question?
+
+    assert game.finish!
+    assert_not game.next_question! # Last question cannot next
+    assert game.end_game!
+    assert game.ended?
+  end
+
+  test "public_state and player_state_for never leak correct answers while question is open" do
+    quiz = build_quiz_with_questions
+    game = Game.start_for_quiz!(quiz)
+    player = game.players.create!(name: "Alice", client_token: "tok-1")
+    game.start!
+
+    pub = game.public_state
+    pstate = game.player_state_for(player)
+
+    assert_not pub.to_json.downcase.include?("correct")
+    assert_not pstate.to_json.downcase.include?("correct")
+    assert_not pstate.key?(:outcome)
+
+    # Pick wrong option first, then change to right option
+    q = game.current_game_question
+    wrong_opt = q.game_options.find_by!(correct: false)
+    right_opt = q.game_options.find_by!(correct: true)
+
+    res1 = game.record_answer!(player: player, game_question_id: q.id, game_option_id: wrong_opt.id)
+    assert res1[:ok]
+    assert_equal 1, game.current_answers_count
+
+    res2 = game.record_answer!(player: player, game_question_id: q.id, game_option_id: right_opt.id)
+    assert res2[:ok]
+    assert_equal 1, game.current_answers_count # Still 1 player who answered
+
+    # Still no leak after answering
+    assert_not game.player_state_for(player).to_json.downcase.include?("correct")
+
+    # Finish reveals correct options and outcome
+    game.finish!
+    closed_state = game.player_state_for(player)
+    assert_equal "correct", closed_state[:outcome]
+    assert_equal right_opt.id, closed_state[:selected_option_id]
+    assert_equal true, closed_state[:question][:options].find { |o| o[:id] == right_opt.id }[:correct]
+
+    # Answering after close is rejected
+    late = game.record_answer!(player: player, game_question_id: q.id, game_option_id: wrong_opt.id)
+    assert_not late[:ok]
+    assert_equal right_opt.id, Answer.find_by!(player: player, game_question: q).game_option_id
+  end
+
+  test "GamePresence deduplicates multiple connections per player and tracks HTTP leases" do
+    changed, count = GamePresence.connect(1, 10, "conn-a")
+    assert changed
+    assert_equal 1, count
+
+    # Second tab for same player does not double-count
+    changed, count = GamePresence.connect(1, 10, "conn-b")
+    assert_not changed
+    assert_equal 1, count
+
+    # Second player increments count
+    changed, count = GamePresence.connect(1, 20, "conn-c")
+    assert changed
+    assert_equal 2, count
+
+    # Closing first tab of player 10 keeps them present
+    changed, count = GamePresence.disconnect(1, 10, "conn-a")
+    assert_not changed
+    assert_equal 2, count
+
+    # Closing second tab of player 10 removes them
+    changed, count = GamePresence.disconnect(1, 10, "conn-b")
+    assert changed
+    assert_equal 1, count
+
+    # Different game is isolated
+    assert_equal 0, GamePresence.active_count(2)
+
+    # HTTP fallback lease works and is replaced when WS connects
+    changed, count = GamePresence.touch_http(1, 30, ttl: 5.0)
+    assert changed
+    assert_equal 2, count
+
+    changed, count = GamePresence.connect(1, 30, "conn-d")
+    assert_not changed
+    assert_equal 2, count
+  end
+end
diff --git a/test/models/game_timer_test.rb b/test/models/game_timer_test.rb
new file mode 100644
index 0000000..1c5b93f
--- /dev/null
+++ b/test/models/game_timer_test.rb
@@ -0,0 +1,195 @@
+require "test_helper"
+
+class GameTimerTest < ActiveSupport::TestCase
+  def create_quiz(timer_minutes: 0, timer_seconds: 0)
+    quiz = Quiz.create!(
+      title: "Timed Quiz",
+      timer_minutes: timer_minutes,
+      timer_seconds: timer_seconds
+    )
+
+    q1 = quiz.questions.build(body: "Q1?", active: true)
+    q1.save_with_option_rows([
+      { body: "Right 1", correct: true },
+      { body: "Wrong 1", correct: false }
+    ])
+
+    q2 = quiz.questions.build(body: "Q2?", active: true)
+    q2.save_with_option_rows([
+      { body: "Right 2", correct: true },
+      { body: "Wrong 2", correct: false }
+    ])
+
+    quiz
+  end
+
+  test "0 minutes and 0 seconds means no timer is set or scheduled" do
+    quiz = create_quiz(timer_minutes: 0, timer_seconds: 0)
+    game = Game.start_for_quiz!(quiz)
+    game.start!
+
+    assert_nil game.current_question_ends_at
+    assert_nil game.current_game_question.timer_ends_at
+    assert_nil game.timer_remaining_ms
+    assert_nil game.moderator_state[:timer_remaining_ms]
+    assert_not GameTimer.scheduled?(game.id)
+    assert_not game.sync_timer!
+    assert game.question_open?
+  end
+
+  test "opening a timed question sets deadline, exposes timer_remaining_ms only to moderator, and never leaks to players" do
+    freeze_time do
+      quiz = create_quiz(timer_minutes: 1, timer_seconds: 30)
+      game = Game.start_for_quiz!(quiz)
+      player = game.players.create!(name: "Alice", client_token: "tok-a")
+
+      assert_nil game.moderator_state[:timer_remaining_ms]
+
+      game.start!
+      expected_ends_at = Time.current + 90.seconds
+
+      assert_in_delta expected_ends_at.to_f, game.current_question_ends_at.to_f, 0.001
+      assert_in_delta expected_ends_at.to_f, game.current_game_question.timer_ends_at.to_f, 0.001
+      assert_equal 90_000, game.timer_remaining_ms
+      assert_equal 90_000, game.moderator_state[:timer_remaining_ms]
+      assert GameTimer.scheduled?(game.id)
+
+      # Players and public state must never see timer data
+      assert_not game.public_state.to_json.downcase.include?("timer")
+      assert_not game.player_state_for(player).to_json.downcase.include?("timer")
+    end
+  end
+
+  test "countdown progresses over time, auto-finishes at 0:00 via sync_timer!, and rejects late answers" do
+    travel_to Time.zone.parse("2026-11-21 12:00:00") do
+      quiz = create_quiz(timer_minutes: 0, timer_seconds: 5)
+      game = Game.start_for_quiz!(quiz)
+      alice = game.players.create!(name: "Alice", client_token: "tok-a")
+      bob = game.players.create!(name: "Bob", client_token: "tok-b")
+
+      game.start!
+      q1 = game.current_game_question
+      right_opt = q1.game_options.find_by!(correct: true)
+      wrong_opt = q1.game_options.find_by!(correct: false)
+
+      travel 2.seconds
+      assert_equal 3_000, game.timer_remaining_ms
+      assert_not game.sync_timer!
+      assert game.question_open?
+
+      # Alice answers before deadline
+      res_alice = game.record_answer!(player: alice, game_question_id: q1.id, game_option_id: right_opt.id)
+      assert res_alice[:ok]
+
+      # Travel to exact expiry (5 seconds elapsed)
+      travel 3.seconds
+      assert_equal 0, game.timer_remaining_ms
+      assert game.current_question_expired?
+
+      # Bob tries to answer right at expiry -> rejected and triggers auto-finish!
+      res_bob = game.record_answer!(player: bob, game_question_id: q1.id, game_option_id: wrong_opt.id)
+      assert_not res_bob[:ok]
+      assert_equal "question_closed", res_bob[:state][:status]
+      assert_equal "none", res_bob[:state][:outcome]
+
+      game.reload
+      assert game.question_closed?
+      assert_nil game.current_question_ends_at
+      assert_nil game.moderator_state[:timer_remaining_ms]
+      assert_not GameTimer.scheduled?(game.id)
+      assert_not_nil q1.reload.closed_at
+      assert_equal "correct", game.player_state_for(alice)[:outcome]
+      assert_equal "none", game.player_state_for(bob)[:outcome]
+
+      # Next question starts a fresh 5-second timer
+      game.next_question!
+      assert game.question_open?
+      assert_equal 2, game.current_question_number
+      assert_equal 5_000, game.timer_remaining_ms
+      assert GameTimer.scheduled?(game.id)
+
+      # Moderator finishes Q2 early before 0:00
+      travel 1.second
+      assert_equal 4_000, game.timer_remaining_ms
+      assert game.finish!
+      assert game.question_closed?
+      assert_nil game.current_question_ends_at
+      assert_not GameTimer.scheduled?(game.id)
+    end
+  end
+
+  test "destroying quiz cancels pending timer" do
+    quiz = create_quiz(timer_minutes: 1, timer_seconds: 0)
+    game = Game.start_for_quiz!(quiz)
+    game.start!
+    assert GameTimer.scheduled?(game.id)
+
+    quiz.destroy!
+    assert_not GameTimer.scheduled?(game.id)
+  end
+end
+
+class GameTimerRealTimeTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  teardown do
+    GameTimer.reset!
+    Game.destroy_all
+    Quiz.destroy_all
+  end
+
+  test "GameTimer automatically finishes an open question in real time when the timer reaches 0:00" do
+    quiz = Quiz.create!(title: "Real Time Timer", timer_minutes: 0, timer_seconds: 1)
+    q = quiz.questions.build(body: "Quick?", active: true)
+    q.save_with_option_rows([
+      { body: "Yes", correct: true },
+      { body: "No", correct: false }
+    ])
+
+    game = Game.start_for_quiz!(quiz)
+    game.start!
+    assert game.question_open?
+    assert GameTimer.scheduled?(game.id)
+
+    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 3.0
+    until game.reload.question_closed? || Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
+      sleep 0.05
+    end
+
+    assert game.reload.question_closed?, "Expected GameTimer to auto-finish the game at 0:00"
+    assert_nil game.current_question_ends_at
+    assert_not_nil game.current_game_question.closed_at
+  end
+
+  test "GameTimer.recover_open_games! re-arms open timed games and closes expired ones" do
+    quiz = Quiz.create!(title: "Recovery Quiz", timer_minutes: 0, timer_seconds: 1)
+    q = quiz.questions.build(body: "Recover?", active: true)
+    q.save_with_option_rows([
+      { body: "Yes", correct: true },
+      { body: "No", correct: false }
+    ])
+
+    expired_game = Game.start_for_quiz!(quiz)
+    expired_game.start!
+    expired_game.update_column(:current_question_ends_at, 2.seconds.ago)
+
+    active_game = Game.start_for_quiz!(quiz)
+    active_game.start!
+
+    # Simulate process restart losing in-memory timers
+    GameTimer.reset!
+    assert_not GameTimer.scheduled?(active_game.id)
+
+    GameTimer.recover_open_games!
+
+    assert expired_game.reload.question_closed?
+    assert active_game.reload.question_open?
+    assert GameTimer.scheduled?(active_game.id)
+
+    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 3.0
+    until active_game.reload.question_closed? || Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
+      sleep 0.05
+    end
+    assert active_game.reload.question_closed?
+  end
+end
