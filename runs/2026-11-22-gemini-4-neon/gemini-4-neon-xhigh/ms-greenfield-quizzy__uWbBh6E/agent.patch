@@ -0,0 +1,301 @@
+require "test_helper"
+
+class LiveGameTest < ActionDispatch::IntegrationTest
+  def create_quiz_with_active_question(winners: 3)
+    quiz = Quiz.create!(title: "HTTP Live Quiz", number_of_winners: winners)
+    q = quiz.questions.build(body: "Capital of France?", active: true)
+    q.save_with_option_rows([
+      { body: "Berlin", correct: false },
+      { body: "Paris", correct: true }
+    ])
+    quiz
+  end
+
+  test "moderator game endpoints require HTTP Basic auth" do
+    quiz = create_quiz_with_active_question
+    game = Game.start_for_quiz!(quiz)
+
+    post moderate_quiz_games_path(quiz)
+    assert_response :unauthorized
+
+    get moderate_game_path(game)
+    assert_response :unauthorized
+
+    get state_moderate_game_path(game)
+    assert_response :unauthorized
+
+    post start_moderate_game_path(game)
+    assert_response :unauthorized
+
+    post finish_moderate_game_path(game)
+    assert_response :unauthorized
+
+    post next_moderate_game_path(game)
+    assert_response :unauthorized
+
+    post end_moderate_game_path(game)
+    assert_response :unauthorized
+
+    post top_winners_moderate_game_path(game)
+    assert_response :unauthorized
+
+    post draw_winners_moderate_game_path(game)
+    assert_response :unauthorized
+
+    post reset_winners_moderate_game_path(game)
+    assert_response :unauthorized
+  end
+
+  test "quiz settings validates and updates number_of_winners" do
+    quiz = Quiz.create!(title: "Settings Quiz")
+    assert_equal 3, quiz.number_of_winners
+
+    get edit_moderate_quiz_path(quiz), headers: basic_auth_headers
+    assert_response :success
+    assert_includes response.body, "Number of winners"
+
+    patch moderate_quiz_path(quiz),
+          params: { quiz: { title: "Settings Quiz", number_of_winners: 0 } },
+          headers: basic_auth_headers
+    assert_response :unprocessable_entity
+    assert_includes response.body, "Number of winners must be greater than or equal to 1"
+    assert_equal 3, quiz.reload.number_of_winners
+
+    patch moderate_quiz_path(quiz),
+          params: { quiz: { title: "Settings Quiz", number_of_winners: 2 } },
+          headers: basic_auth_headers
+    assert_redirected_to moderate_quiz_path(quiz)
+    assert_equal 2, quiz.reload.number_of_winners
+  end
+
+  test "creating a game with no active questions redirects back with alert" do
+    quiz = Quiz.create!(title: "No Active Questions")
+    post moderate_quiz_games_path(quiz), headers: basic_auth_headers
+    assert_redirected_to moderate_quiz_path(quiz)
+    assert_equal 0, Game.count
+  end
+
+  test "player endpoints are public, remember player per game, never leak correct answer or points while open, and show place/points/winner after end" do
+    quiz = create_quiz_with_active_question(winners: 2)
+    game = Game.start_for_quiz!(quiz)
+
+    # Join page works without auth (case-insensitive code)
+    get play_path(game.code.downcase)
+    assert_response :success
+    assert_includes response.body, "Your name"
+    assert_includes response.body, "Join"
+
+    # Blank name rejected
+    post join_play_path(game.code), params: { player: { name: "   " } }
+    assert_response :unprocessable_entity
+    assert_equal 0, game.players.count
+
+    # Valid join remembers player via signed cookie
+    post join_play_path(game.code), params: { player: { name: "Alice" } }
+    assert_redirected_to play_path(game.code)
+    follow_redirect!
+    assert_response :success
+    assert_includes response.body, "Hi, Alice!"
+
+    # Opening join link again in same browser continues as Alice
+    get play_path(game.code)
+    assert_response :success
+    assert_includes response.body, "Hi, Alice!"
+    assert_not_includes response.body, "Your name"
+
+    # Start question as moderator
+    post start_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+
+    # Player HTML and JSON state MUST NOT leak correct answer or points while open
+    get play_path(game.code)
+    assert_response :success
+    assert_includes response.body, "Capital of France?"
+    assert_not_includes response.body.downcase, "correct"
+    assert_not_includes response.body.downcase, "point"
+
+    get state_play_path(game.code), as: :json
+    assert_response :success
+    assert_not_includes response.body.downcase, "correct"
+    assert_not response.parsed_body.key?("points")
+    assert_not response.parsed_body.key?("place")
+
+    # Submit answer
+    q = game.reload.current_game_question
+    paris = q.game_options.find_by!(body: "Paris")
+    berlin = q.game_options.find_by!(body: "Berlin")
+
+    post answer_play_path(game.code),
+         params: { game_question_id: q.id, game_option_id: paris.id },
+         as: :json
+    assert_response :ok
+
+    # Finish question
+    post finish_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+
+    # Player still does not see points during closed question
+    get play_path(game.code)
+    assert_response :success
+    assert_includes response.body, "Correct!"
+    assert_not_includes response.body.downcase, "point"
+
+    # Changing answer after finish is rejected with 409 Conflict
+    post answer_play_path(game.code),
+         params: { game_question_id: q.id, game_option_id: berlin.id },
+         as: :json
+    assert_response :conflict
+    assert_equal "correct", response.parsed_body["outcome"]
+
+    # End quiz
+    post end_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+    assert_equal 2, response.parsed_body["winners_count"]
+    assert_equal 1, response.parsed_body["leaderboard"].size
+    assert_equal "Alice", response.parsed_body["leaderboard"][0]["name"]
+    assert_equal 1, response.parsed_body["leaderboard"][0]["points"]
+    assert_equal false, response.parsed_body["leaderboard"][0]["winner"]
+
+    # Moderator SSR shows leaderboard and Top 2 / Draw / Reset winners buttons
+    get moderate_game_path(game), headers: basic_auth_headers
+    assert_response :success
+    assert_includes response.body, "Alice"
+    assert_includes response.body, "1 point"
+    assert_includes response.body, "Top 2"
+    assert_includes response.body, "Draw"
+    assert_includes response.body, "Reset winners"
+
+    # Player SSR shows place and points, not winner yet
+    get play_path(game.code)
+    assert_response :success
+    assert_includes response.body, "Place 1 of 1"
+    assert_includes response.body, "1 point"
+    assert_not_includes response.body, "You won!"
+
+    # Moderator picks Top 2 -> Alice wins
+    post top_winners_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+    assert_equal true, response.parsed_body["leaderboard"][0]["winner"]
+
+    get play_path(game.code)
+    assert_response :success
+    assert_includes response.body, "You won!"
+
+    # Moderator resets winners -> Alice no longer winner
+    post reset_winners_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+    assert_equal false, response.parsed_body["leaderboard"][0]["winner"]
+
+    get play_path(game.code)
+    assert_response :success
+    assert_not_includes response.body, "You won!"
+
+    # New browser cannot join after end
+    open_session do |late_visitor|
+      late_visitor.get play_path(game.code)
+      assert_equal 200, late_visitor.response.status
+      assert_includes late_visitor.response.body, "The quiz is over"
+      assert_not_includes late_visitor.response.body, "Your name"
+
+      late_visitor.post join_play_path(game.code), params: { player: { name: "Late Bob" } }
+      assert_equal 422, late_visitor.response.status
+      assert_includes late_visitor.response.body, "The quiz is over"
+    end
+    assert_equal 1, game.players.count
+
+    # Second game of same quiz asks same browser for name again
+    game2 = Game.start_for_quiz!(quiz)
+    get play_path(game2.code)
+    assert_response :success
+    assert_includes response.body, "Your name"
+    assert_includes response.body, "Join"
+  end
+
+  test "invalid game code returns 404" do
+    get play_path("ZZZZZ")
+    assert_response :not_found
+  end
+
+test "quiz settings validates and updates timer_minutes and timer_seconds" do
+  quiz = Quiz.create!(title: "Timer Settings Quiz")
+  assert_equal 0, quiz.timer_minutes
+  assert_equal 0, quiz.timer_seconds
+
+  get edit_moderate_quiz_path(quiz), headers: basic_auth_headers
+  assert_response :success
+  assert_includes response.body, "Timer minutes"
+  assert_includes response.body, "Timer seconds"
+
+  patch moderate_quiz_path(quiz),
+        params: { quiz: { title: "Timer Settings Quiz", timer_minutes: -1, timer_seconds: 30 } },
+        headers: basic_auth_headers
+  assert_response :unprocessable_entity
+  assert_includes response.body, "Timer minutes must be greater than or equal to 0"
+  assert_equal 0, quiz.reload.timer_minutes
+
+  patch moderate_quiz_path(quiz),
+        params: { quiz: { title: "Timer Settings Quiz", timer_minutes: 1, timer_seconds: 30 } },
+        headers: basic_auth_headers
+  assert_redirected_to moderate_quiz_path(quiz)
+  assert_equal 1, quiz.reload.timer_minutes
+  assert_equal 30, quiz.timer_seconds
+end
+
+test "timed game moderator endpoints include timer_remaining_ms, auto-finish on expiry, and player endpoints never expose timer" do
+  travel_to Time.zone.parse("2026-11-21 15:00:00") do
+    quiz = create_quiz_with_active_question
+    quiz.update!(timer_minutes: 0, timer_seconds: 5)
+    game = Game.start_for_quiz!(quiz)
+
+    post join_play_path(game.code), params: { player: { name: "Alice" } }
+    assert_redirected_to play_path(game.code)
+
+    post start_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+    start_data = JSON.parse(response.body)
+    assert_equal "question_open", start_data["status"]
+    assert_equal 5_000, start_data["timer_remaining_ms"]
+
+    # Moderator HTML renders M:SS countdown
+    get moderate_game_path(game), headers: basic_auth_headers
+    assert_response :success
+    assert_includes response.body, "0:05"
+
+    # Player endpoints never expose timer in HTML or JSON
+    get play_path(game.code)
+    assert_response :success
+    assert_not_includes response.body, "0:05"
+    assert_not_includes response.body, 'role="timer"'
+
+    get state_play_path(game.code), as: :json
+    assert_response :success
+    assert_not_includes response.body.downcase, "timer"
+
+    # After 2 seconds, reload shows 0:03 (does not restart)
+    travel 2.seconds
+    get moderate_game_path(game), headers: basic_auth_headers
+    assert_response :success
+    assert_includes response.body, "0:03"
+    assert_not_includes response.body, "0:05"
+
+    # After 3 more seconds (total 5s), late answer gets 409 and closes question
+    travel 3.seconds
+    q = game.reload.current_game_question
+    opt = q.game_options.find_by!(correct: true)
+    post answer_play_path(game.code),
+         params: { game_question_id: q.id, game_option_id: opt.id },
+         as: :json
+    assert_response :conflict
+    conflict_data = JSON.parse(response.body)
+    assert_equal "question_closed", conflict_data["status"]
+    assert_equal "none", conflict_data["outcome"]
+
+    # Moderator state reflects question_closed with no timer
+    get state_moderate_game_path(game), headers: basic_auth_headers, as: :json
+    assert_response :success
+    closed_data = JSON.parse(response.body)
+    assert_equal "question_closed", closed_data["status"]
+    assert_nil closed_data["timer_remaining_ms"]
+  end
+end
+end
