+++ b/test/models/question_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class QuestionTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Test Quiz")
+  end
+
+  test "saves with valid options skipping empty rows and allows multiple correct" do
+    question = @quiz.questions.build(body: "Pick languages", active: true)
+    result = question.save_with_option_rows([
+      { body: "Ruby", correct: true },
+      { body: "   ", correct: true },
+      { body: "Elixir", correct: true },
+      { body: "HTML", correct: false }
+    ])
+
+    assert result
+    assert_equal 3, question.options.count
+    assert_equal [ "Ruby", "Elixir", "HTML" ], question.options.ordered.pluck(:body)
+    assert_equal [ true, true, false ], question.options.ordered.pluck(:correct)
+    assert_equal [ 1, 2, 3 ], question.options.ordered.pluck(:position)
+  end
+
+  test "requires at least two non-empty options" do
+    question = @quiz.questions.build(body: "Solo", active: true)
+    result = question.save_with_option_rows([
+      { body: "Only one", correct: true },
+      { body: "", correct: false }
+    ])
+
+    assert_not result
+    assert_not question.persisted?
+    assert_includes question.errors.full_messages, "Add at least two options"
+  end
+
+  test "requires at least one correct non-empty option" do
+    question = @quiz.questions.build(body: "None right", active: true)
+    result = question.save_with_option_rows([
+      { body: "Alpha", correct: false },
+      { body: "Beta", correct: false },
+      { body: "   ", correct: true }
+    ])
+
+    assert_not result
+    assert_not question.persisted?
+    assert_includes question.errors.full_messages, "Mark at least one option as correct"
+  end
+
+  test "failed update does not modify existing question or options in DB" do
+    question = @quiz.questions.build(body: "Original?", active: true)
+    assert question.save_with_option_rows([
+      { body: "Yes", correct: true },
+      { body: "No", correct: false }
+    ])
+
+    question.assign_attributes(body: "Changed?", active: false)
+    result = question.save_with_option_rows([
+      { body: "A", correct: false },
+      { body: "B", correct: false }
+    ])
+
+    assert_not result
+    reloaded = Question.find(question.id)
+    assert_equal "Original?", reloaded.body
+    assert_equal true, reloaded.active?
+    assert_equal [ [ "Yes", true ], [ "No", false ] ], reloaded.options.ordered.pluck(:body, :correct)
+  end
+
+  test "move_up! and move_down! reorder questions and handle boundaries" do
+    q1 = @quiz.questions.create!(body: "Q1")
+    q2 = @quiz.questions.create!(body: "Q2")
+    q3 = @quiz.questions.create!(body: "Q3")
+
+    q1.move_up!
+    assert_equal [ q1, q2, q3 ], @quiz.questions.ordered.to_a
+
+    q3.move_up!
+    assert_equal [ q1, q3, q2 ], @quiz.questions.ordered.to_a
+
+    q1.move_down!
+    assert_equal [ q3, q1, q2 ], @quiz.questions.ordered.to_a
+
+    q2.move_down!
+    assert_equal [ q3, q1, q2 ], @quiz.questions.ordered.to_a
+  end
+end
diff --git a/test/models/quiz_export_import_test.rb b/test/models/quiz_export_import_test.rb
new file mode 100644
index 0000000..843fb24
--- /dev/null
+++ b/test/models/quiz_export_import_test.rb
@@ -0,0 +1,260 @@
+require "test_helper"
+
+class QuizExportImportTest < ActiveSupport::TestCase
+  test "exporter writes exact keys, preserves question and option order, and always writes active and correct" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+
+    q1 = quiz.questions.create!(body: 'Which HTTP status code means "Too Many Requests"?', active: true, position: 2)
+    q1.options.create!(body: "429", correct: true, position: 2)
+    q1.options.create!(body: "418", correct: false, position: 1)
+
+    q2 = quiz.questions.create!(body: "Inactive question", active: false, position: 1)
+    q2.options.create!(body: "Yes", correct: true, position: 1)
+    q2.options.create!(body: "No", correct: false, position: 2)
+
+    parsed = JSON.parse(Quiz::Exporter.new(quiz).to_json)
+
+    assert_equal [ "title", "questions" ], parsed.keys
+    assert_equal "Frontend Fest 2026", parsed["title"]
+    assert_equal 2, parsed["questions"].size
+
+    first_q = parsed["questions"][0]
+    assert_equal [ "text", "active", "options" ], first_q.keys
+    assert_equal "Inactive question", first_q["text"]
+    assert_same false, first_q["active"]
+    assert_equal [
+      { "text" => "Yes", "correct" => true },
+      { "text" => "No", "correct" => false }
+    ], first_q["options"]
+    first_q["options"].each { |opt| assert_equal [ "text", "correct" ], opt.keys }
+
+    second_q = parsed["questions"][1]
+    assert_equal [ "text", "active", "options" ], second_q.keys
+    assert_equal 'Which HTTP status code means "Too Many Requests"?', second_q["text"]
+    assert_same true, second_q["active"]
+    assert_equal [
+      { "text" => "418", "correct" => false },
+      { "text" => "429", "correct" => true }
+    ], second_q["options"]
+  end
+
+  test "exporter handles quiz with zero questions" do
+    quiz = Quiz.create!(title: "Empty Quiz")
+    parsed = JSON.parse(Quiz::Exporter.new(quiz).to_json)
+
+    assert_equal({ "title" => "Empty Quiz", "questions" => [] }, parsed)
+  end
+
+  test "importer imports full format and preserves order and multiple correct options" do
+    json = JSON.generate(
+      title: "Frontend Fest 2026",
+      questions: [
+        {
+          text: 'Which HTTP status code means "Too Many Requests"?',
+          active: true,
+          options: [
+            { text: "418", correct: false },
+            { text: "429", correct: true }
+          ]
+        },
+        {
+          text: "Which run over TCP?",
+          active: false,
+          options: [
+            { text: "HTTP/1.1", correct: true },
+            { text: "UDP", correct: false },
+            { text: "WebSocket", correct: true }
+          ]
+        }
+      ]
+    )
+
+    result = Quiz::Importer.new(json).import
+
+    assert result.success?
+    assert_empty result.errors
+
+    quiz = result.quiz.reload
+    assert_equal "Frontend Fest 2026", quiz.title
+
+    questions = quiz.questions.ordered.to_a
+    assert_equal 2, questions.size
+    assert_equal [ 1, 2 ], questions.map(&:position)
+    assert_equal [ 'Which HTTP status code means "Too Many Requests"?', "Which run over TCP?" ], questions.map(&:body)
+    assert_equal [ true, false ], questions.map(&:active?)
+
+    assert_equal [ [ "418", false, 1 ], [ "429", true, 2 ] ],
+                 questions[0].options.ordered.pluck(:body, :correct, :position)
+    assert_equal [ [ "HTTP/1.1", true, 1 ], [ "UDP", false, 2 ], [ "WebSocket", true, 3 ] ],
+                 questions[1].options.ordered.pluck(:body, :correct, :position)
+  end
+
+  test "importer defaults active to true and correct to false when omitted" do
+    json = JSON.generate(
+      title: "Defaults Quiz",
+      questions: [
+        {
+          text: "Pick 429",
+          options: [
+            { text: "418" },
+            { text: "429", correct: true },
+            { text: "503" }
+          ]
+        }
+      ]
+    )
+
+    result = Quiz::Importer.new(json).import
+
+    assert result.success?
+    q = result.quiz.questions.first
+    assert_equal true, q.active?
+    assert_equal [ [ "418", false ], [ "429", true ], [ "503", false ] ],
+                 q.options.ordered.pluck(:body, :correct)
+
+    # Re-exporting always includes both active and correct explicitly
+    exported = JSON.parse(Quiz::Exporter.new(result.quiz).to_json)
+    assert_same true, exported["questions"][0]["active"]
+    assert_same false, exported["questions"][0]["options"][0]["correct"]
+    assert_same true, exported["questions"][0]["options"][1]["correct"]
+    assert_same false, exported["questions"][0]["options"][2]["correct"]
+  end
+
+  test "importer always creates a new quiz even if a quiz with the same title exists" do
+    existing = Quiz.create!(title: "Same Title")
+    json = JSON.generate(title: "Same Title", questions: [])
+
+    result = assert_difference("Quiz.count", 1) do
+      Quiz::Importer.new(json).import
+    end
+
+    assert result.success?
+    assert_not_equal existing.id, result.quiz.id
+    assert_equal "Same Title", result.quiz.title
+  end
+
+  test "export then import round-trips special characters, multiline text, and unicode losslessly" do
+    quiz = Quiz.create!(title: %(Edge </pre> <script>alert(1)</script> & "Quotes" 🎉))
+    q = quiz.questions.build(body: "Line 1\nLine \"2\" & <tag> \\ path", active: false)
+    assert q.save_with_option_rows([
+      { body: "</textarea> & 'single'", correct: false },
+      { body: "Café 日本語", correct: true }
+    ])
+
+    exported_json = Quiz::Exporter.new(quiz).to_json
+    result = Quiz::Importer.new(exported_json).import
+
+    assert result.success?
+    assert_equal exported_json, Quiz::Exporter.new(result.quiz).to_json
+  end
+
+  test "importer rejects invalid JSON and non-object roots without creating anything" do
+    invalid_inputs = [
+      "",
+      "   ",
+      "{not valid json",
+      '{"title": "ok", "questions": []} trailing',
+      "[]",
+      '"just a string"',
+      "123",
+      "true",
+      "null"
+    ]
+
+    invalid_inputs.each do |input|
+      assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+        result = Quiz::Importer.new(input).import
+        assert_not result.success?, "Expected failure for input: #{input.inspect}"
+        assert_not_empty result.errors, "Expected errors for input: #{input.inspect}"
+      end
+    end
+  end
+
+  test "importer rejects rule violations and rolls back completely so nothing is imported" do
+    valid_q = {
+      text: "Valid Q1",
+      active: true,
+      options: [
+        { text: "Yes", correct: true },
+        { text: "No", correct: false }
+      ]
+    }
+
+    invalid_payloads = {
+      "missing title" => { questions: [ valid_q ] },
+      "blank title" => { title: "   ", questions: [ valid_q ] },
+      "non-string title" => { title: 42, questions: [ valid_q ] },
+      "missing questions" => { title: "Q" },
+      "null questions" => { title: "Q", questions: nil },
+      "non-array questions" => { title: "Q", questions: {} },
+      "non-object question" => { title: "Q", questions: [ valid_q, "not an object" ] },
+      "missing question text" => { title: "Q", questions: [ valid_q, { options: valid_q[:options] } ] },
+      "blank question text" => { title: "Q", questions: [ valid_q, { text: "  ", options: valid_q[:options] } ] },
+      "non-string question text" => { title: "Q", questions: [ valid_q, { text: 123, options: valid_q[:options] } ] },
+      "non-boolean active string" => { title: "Q", questions: [ valid_q, valid_q.merge(active: "true") ] },
+      "non-boolean active null" => { title: "Q", questions: [ valid_q, valid_q.merge(active: nil) ] },
+      "non-boolean active int" => { title: "Q", questions: [ valid_q, valid_q.merge(active: 1) ] },
+      "missing options" => { title: "Q", questions: [ valid_q, { text: "Q2" } ] },
+      "non-array options" => { title: "Q", questions: [ valid_q, { text: "Q2", options: {} } ] },
+      "zero options" => { title: "Q", questions: [ valid_q, { text: "Q2", options: [] } ] },
+      "only one option" => { title: "Q", questions: [ valid_q, { text: "Q2", options: [ { text: "Only", correct: true } ] } ] },
+      "no correct option (explicit false)" => {
+        title: "Q",
+        questions: [ valid_q, { text: "Q2", options: [ { text: "A", correct: false }, { text: "B", correct: false } ] } ]
+      },
+      "no correct option (omitted correct)" => {
+        title: "Q",
+        questions: [ valid_q, { text: "Q2", options: [ { text: "A" }, { text: "B" } ] } ]
+      },
+      "inactive question with no correct option" => {
+        title: "Q",
+        questions: [ valid_q, { text: "Q2", active: false, options: [ { text: "A" }, { text: "B" } ] } ]
+      },
+      "non-object option" => { title: "Q", questions: [ valid_q, { text: "Q2", options: [ "A", "B" ] } ] },
+      "blank option text" => {
+        title: "Q",
+        questions: [ valid_q, { text: "Q2", options: [ { text: "A", correct: true }, { text: "B", correct: false }, { text: "  " } ] } ]
+      },
+      "non-string option text" => {
+        title: "Q",
+        questions: [ valid_q, { text: "Q2", options: [ { text: "A", correct: true }, { text: 429, correct: false } ] } ]
+      },
+      "non-boolean option correct" => {
+        title: "Q",
+        questions: [ valid_q, { text: "Q2", options: [ { text: "A", correct: "yes" }, { text: "B", correct: false } ] } ]
+      },
+      "null option correct" => {
+        title: "Q",
+        questions: [ valid_q, { text: "Q2", options: [ { text: "A", correct: true }, { text: "B", correct: nil } ] } ]
+      }
+    }
+
+    invalid_payloads.each do |label, payload|
+      assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ], "Should import nothing for: #{label}" do
+        result = Quiz::Importer.new(JSON.generate(payload)).import
+        assert_not result.success?, "Expected failure for: #{label}"
+        assert_not_empty result.errors, "Expected errors for: #{label}"
+      end
+    end
+  end
+
+test "timer settings are excluded from export and imported quizzes default to 0:00" do
+  quiz = Quiz.create!(title: "Timed Export Quiz", timer_minutes: 1, timer_seconds: 30)
+  q = quiz.questions.build(body: "Export check?", active: true)
+  assert q.save_with_option_rows([
+    { body: "Yes", correct: true },
+    { body: "No", correct: false }
+  ])
+
+  exported_json = Quiz::Exporter.new(quiz).to_json
+  parsed = JSON.parse(exported_json)
+
+  assert_equal %w[title questions], parsed.keys
+  assert_not exported_json.downcase.include?("timer")
+
+  result = Quiz::Importer.new(exported_json).import
+  assert result.success?
+  assert_equal 0, result.quiz.timer_minutes
+  assert_equal 0, result.quiz.timer_seconds
+end
+end
diff --git a/test/models/quiz_test.rb b/test/models/quiz_test.rb
new file mode 100644
index 0000000..4c55318
--- /dev/null
+++ b/test/models/quiz_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class QuizTest < ActiveSupport::TestCase
+  test "requires a non-blank title" do
+    quiz = Quiz.new(title: "   ")
+    assert_not quiz.valid?
+    assert_includes quiz.errors.full_messages, "Title can't be blank"
+  end
+
+  test "strips surrounding whitespace from title" do
+    quiz = Quiz.create!(title: "  RubyConf 2026  ")
+    assert_equal "RubyConf 2026", quiz.title
+  end
+
+  test "number_of_winners defaults to 3 and requires an integer >= 1" do
+    quiz = Quiz.create!(title: "Prize Quiz")
+    assert_equal 3, quiz.number_of_winners
+
+    [ nil, "", "  " ].each do |blank_val|
+      q = Quiz.new(title: "Test", number_of_winners: blank_val)
+      assert_not q.valid?
+      assert_includes q.errors.full_messages, "Number of winners can't be blank"
+    end
+
+    [ 0, -1, -100 ].each do |small_val|
+      q = Quiz.new(title: "Test", number_of_winners: small_val)
+      assert_not q.valid?
+      assert_includes q.errors.full_messages, "Number of winners must be greater than or equal to 1"
+    end
+
+    q_float = Quiz.new(title: "Test", number_of_winners: 2.5)
+    assert_not q_float.valid?
+    assert_includes q_float.errors.full_messages, "Number of winners must be an integer"
+
+    q_str = Quiz.new(title: "Test", number_of_winners: "abc")
+    assert_not q_str.valid?
+    assert_includes q_str.errors.full_messages, "Number of winners is not a number"
+
+    [ 1, 5, 20 ].each do |valid_val|
+      q = Quiz.new(title: "Test", number_of_winners: valid_val)
+      assert q.valid?, "Expected #{valid_val} to be valid"
+    end
+  end
+
+  test "timer_minutes and timer_seconds default to 0, validate integers >= 0, and compute duration" do
+    quiz = Quiz.create!(title: "Timer Quiz")
+    assert_equal 0, quiz.timer_minutes
+    assert_equal 0, quiz.timer_seconds
+    assert_equal 0, quiz.timer_duration_seconds
+    assert_not quiz.timer_enabled?
+
+    quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    assert_equal 90, quiz.timer_duration_seconds
+    assert quiz.timer_enabled?
+
+    quiz.update!(timer_minutes: 0, timer_seconds: 5)
+    assert_equal 5, quiz.timer_duration_seconds
+    assert quiz.timer_enabled?
+
+    quiz.update!(timer_minutes: 0, timer_seconds: 90)
+    assert_equal 90, quiz.timer_duration_seconds
+    assert quiz.timer_enabled?
+
+    [ :timer_minutes, :timer_seconds ].each do |attr|
+      label = attr.to_s.humanize
+
+      [ nil, "", "  " ].each do |blank_val|
+        q = Quiz.new(title: "Test", attr => blank_val)
+        assert_not q.valid?
+        assert_includes q.errors.full_messages, "#{label} can't be blank"
+      end
+
+      [ -1, -50 ].each do |neg_val|
+        q = Quiz.new(title: "Test", attr => neg_val)
+        assert_not q.valid?
+        assert_includes q.errors.full_messages, "#{label} must be greater than or equal to 0"
+      end
+
+      q_float = Quiz.new(title: "Test", attr => 1.5)
+      assert_not q_float.valid?
+      assert_includes q_float.errors.full_messages, "#{label} must be an integer"
+
+      q_str = Quiz.new(title: "Test", attr => "abc")
+      assert_not q_str.valid?
+      assert_includes q_str.errors.full_messages, "#{label} is not a number"
+    end
+  end
+
+  test "active_questions returns only active questions in order" do
+    quiz = Quiz.create!(title: "Order test")
+    q1 = quiz.questions.create!(body: "First", active: true)
+    q2 = quiz.questions.create!(body: "Second (inactive)", active: false)
+    q3 = quiz.questions.create!(body: "Third", active: true)
+
+    assert_equal [ q1, q3 ], quiz.active_questions.to_a
+  end
+
+  test "destroying quiz cascades to questions and options" do
+    quiz = Quiz.create!(title: "Cascade")
+    q = quiz.questions.build(body: "Q1", active: true)
+    assert q.save_with_option_rows([
+      { body: "A", correct: true },
+      { body: "B", correct: false }
+    ])
+
+    assert_difference -> { Quiz.count } => -1, -> { Question.count } => -1, -> { Option.count } => -2 do
+      quiz.destroy!
+    end
+  end
+end
