@@ -0,0 +1,11 @@
+class GamePublicChannel < ApplicationCable::Channel
+  def subscribed
+    @game = Game.find_by(code: params[:code].to_s.upcase)
+    return reject unless @game
+
+    stream_from @game.public_stream_name
+    @game.reload
+    @game.sync_timer!
+    transmit({ type: "status", status: @game.status, state_version: @game.state_version })
+  end
+end
