@@ -0,0 +1,305 @@
+require "application_system_test_case"
+
+class TimerTest < ApplicationSystemTestCase
+  def create_timed_quiz(title:, timer_minutes: 0, timer_seconds: 0)
+    quiz = Quiz.create!(
+      title: title,
+      timer_minutes: timer_minutes,
+      timer_seconds: timer_seconds
+    )
+
+    q1 = quiz.questions.build(body: "Which planet is closest to the Sun?", active: true)
+    q1.save_with_option_rows([
+      { body: "Mercury", correct: true },
+      { body: "Venus", correct: false }
+    ])
+
+    q2 = quiz.questions.build(body: "What is 3 * 3?", active: true)
+    q2.save_with_option_rows([
+      { body: "8", correct: false },
+      { body: "9", correct: true }
+    ])
+
+    quiz
+  end
+
+  test "quiz settings has Timer minutes and Timer seconds defaulting to 0, validates, saves, and export omits timer" do
+    authenticate_as_moderator
+    visit "/moderate"
+
+    click_on "New quiz"
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+    fill_in "Title", with: "Tight Schedule Talk"
+    click_on "Save quiz"
+
+    assert_selector "h1", text: "Tight Schedule Talk"
+    click_link "Settings"
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+
+    # Invalid negative value is rejected
+    fill_in "Timer minutes", with: "-1"
+    click_on "Save quiz"
+    assert_text "Timer minutes must be greater than or equal to 0"
+    assert_equal 0, Quiz.last.timer_minutes
+
+    # Valid update to 1:30
+    fill_in "Timer minutes", with: "1"
+    fill_in "Timer seconds", with: "30"
+    click_on "Save quiz"
+
+    assert_selector "h1", text: "Tight Schedule Talk"
+    quiz = Quiz.last
+    assert_equal 1, quiz.timer_minutes
+    assert_equal 30, quiz.timer_seconds
+
+    click_link "Settings"
+    assert_field "Timer minutes", with: "1"
+    assert_field "Timer seconds", with: "30"
+
+    # Export format does not include timer
+    visit moderate_quiz_path(quiz)
+    click_link "Export"
+    exported_text = find("pre").text
+    parsed = JSON.parse(exported_text)
+    assert_equal %w[title questions], parsed.keys
+    assert_not exported_text.downcase.include?("timer")
+  end
+
+  test "0 minutes and 0 seconds shows no timer on big screen and waits for moderator Finish" do
+    quiz = create_timed_quiz(title: "Untimed Talk", timer_minutes: 0, timer_seconds: 0)
+
+    authenticate_as_moderator
+    visit moderate_quiz_path(quiz)
+    click_button "Start a game"
+    assert_current_path %r{\A/moderate/games/\d+\z}
+
+    click_button "Start"
+    assert_selector "[data-stage='question_open']"
+    assert_text "Which planet is closest to the Sun?"
+    assert_no_selector "[role='timer']"
+    assert_no_text "0:00"
+
+    sleep 1.2
+    assert_selector "[data-stage='question_open']"
+    assert_no_selector "[role='timer']"
+
+    click_button "Finish"
+    assert_selector "[data-stage='question_closed']"
+    assert_no_selector "[role='timer']"
+  end
+
+  test "1:30 timer displays M:SS format only on moderator big screen, not on player phone, and supports early Finish" do
+    quiz = create_timed_quiz(title: "Long Timer Talk", timer_minutes: 1, timer_seconds: 30)
+    join_url = nil
+
+    using_session(:moderator) do
+      authenticate_as_moderator
+      visit moderate_quiz_path(quiz)
+      click_button "Start a game"
+      assert_current_path %r{\A/moderate/games/\d+\z}
+      join_url = find(".lobby__url").text.strip
+    end
+
+    using_session(:alice) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Waiting for the quiz to start"
+    end
+
+    using_session(:moderator) do
+      click_button "Start"
+      assert_selector "[data-stage='question_open']"
+      timer_text = find("[role='timer']").text.strip
+      assert_match(/\A1:(30|29|28)\z/, timer_text, "Expected M:SS around 1:30, got #{timer_text.inspect}")
+    end
+
+    using_session(:alice) do
+      assert_text "Which planet is closest to the Sun?"
+      assert_no_selector "[role='timer']"
+      assert_no_text "1:30"
+      assert_no_text "1:29"
+      assert_no_text "1:28"
+      click_button "Mercury"
+      assert_selector "button.play-option.is-picked", text: "Mercury"
+    end
+
+    using_session(:moderator) do
+      assert_text "Answers: 1 / 1"
+      click_button "Finish"
+      assert_selector "[data-stage='question_closed']"
+      assert_no_selector "[role='timer']"
+      assert_selector "li.stage-option.is-correct", text: "Mercury"
+    end
+
+    using_session(:alice) do
+      assert_text "Correct!"
+      assert_no_selector "[role='timer']"
+    end
+  end
+
+  test "short countdown counts down across big screens, reload does not restart it, auto-finishes at 0:00 like Finish, and Next starts fresh timer" do
+    quiz = create_timed_quiz(title: "Fast Timer Talk", timer_minutes: 0, timer_seconds: 5)
+    game_url = nil
+    join_url = nil
+
+    using_session(:moderator) do
+      authenticate_as_moderator
+      visit moderate_quiz_path(quiz)
+      click_button "Start a game"
+      assert_current_path %r{\A/moderate/games/\d+\z}
+      game_url = current_url
+      join_url = find(".lobby__url").text.strip
+    end
+
+    using_session(:big_screen) do
+      authenticate_as_moderator
+      visit game_url
+      assert_text "Fast Timer Talk"
+    end
+
+    using_session(:alice) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Waiting for the quiz to start"
+    end
+
+    using_session(:bob) do
+      visit join_url
+      fill_in "Your name", with: "Bob"
+      click_button "Join"
+      assert_text "Waiting for the quiz to start"
+    end
+
+    using_session(:moderator) do
+      assert_text "Players: 2"
+      click_button "Start"
+      assert_selector "[data-stage='question_open']"
+      first_reading = find("[role='timer']").text.strip
+      assert_match(/\A0:0[45]\z/, first_reading, "Expected initial 0:05 countdown, got #{first_reading.inspect}")
+    end
+
+    using_session(:big_screen) do
+      assert_selector "[data-stage='question_open']"
+      screen_reading = find("[role='timer']").text.strip
+      assert_match(/\A0:0[345]\z/, screen_reading, "Expected countdown on big screen, got #{screen_reading.inspect}")
+    end
+
+    # Alice answers correctly; Bob doesn't answer; neither player sees a timer
+    using_session(:alice) do
+      assert_text "Which planet is closest to the Sun?"
+      assert_no_selector "[role='timer']"
+      assert_no_text "0:05"
+      assert_no_text "0:04"
+      click_button "Mercury"
+      assert_selector "button.play-option.is-picked", text: "Mercury"
+    end
+
+    using_session(:bob) do
+      assert_text "Which planet is closest to the Sun?"
+      assert_no_selector "[role='timer']"
+    end
+
+    # Wait ~2 seconds then reload moderator screen -> timer MUST NOT restart to 0:05
+    sleep 2.1
+    using_session(:moderator) do
+      visit current_path
+      assert_selector "[data-stage='question_open']"
+      reloaded_reading = find("[role='timer']").text.strip
+      assert_match(/\A0:0[123]\z/, reloaded_reading, "Reload restarted timer! Got #{reloaded_reading.inspect}")
+
+      # Do NOT click Finish — wait for timer to hit 0:00 and auto-finish by itself
+      assert_selector "[data-stage='question_closed']", wait: 6
+      assert_no_selector "[role='timer']"
+      assert_selector "li.stage-option.is-correct", text: "Mercury"
+      assert_button "Next"
+    end
+
+    # Second big screen also transitioned automatically at 0:00
+    using_session(:big_screen) do
+      assert_selector "[data-stage='question_closed']", wait: 5
+      assert_no_selector "[role='timer']"
+    end
+
+    # Players automatically receive question_closed outcomes as if Finish was clicked
+    using_session(:alice) do
+      assert_text "Correct!", wait: 5
+      assert_no_selector "[role='timer']"
+    end
+
+    using_session(:bob) do
+      assert_text "No answer", wait: 5
+      assert_no_selector "[role='timer']"
+    end
+
+    # Next opens Q2 with a fresh 0:05 countdown; moderator finishes Q2 early before 0:00
+    using_session(:moderator) do
+      click_button "Next"
+      assert_selector "[data-stage='question_open']"
+      assert_text "What is 3 * 3?"
+      q2_reading = find("[role='timer']").text.strip
+      assert_match(/\A0:0[45]\z/, q2_reading, "Expected fresh 0:05 on Q2, got #{q2_reading.inspect}")
+
+      click_button "Finish"
+      assert_selector "[data-stage='question_closed']"
+      assert_no_selector "[role='timer']"
+      assert_button "End quiz"
+
+      click_button "End quiz"
+      assert_selector "[data-stage='ended']"
+      assert_text "The quiz is over"
+      assert_text "Alice"
+      assert_text "1 point"
+    end
+
+    using_session(:alice) do
+      assert_text "Place 1 of 2", wait: 5
+      assert_text "1 point"
+    end
+  end
+
+  test "server auto-finishes timed question at 0:00 even if moderator leaves the game page" do
+    quiz = create_timed_quiz(title: "Unattended Timer Talk", timer_minutes: 0, timer_seconds: 2)
+    join_url = nil
+    game_url = nil
+
+    using_session(:moderator) do
+      authenticate_as_moderator
+      visit moderate_quiz_path(quiz)
+      click_button "Start a game"
+      assert_current_path %r{\A/moderate/games/\d+\z}
+      game_url = current_url
+      join_url = find(".lobby__url").text.strip
+    end
+
+    using_session(:alice) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Waiting for the quiz to start"
+    end
+
+    using_session(:moderator) do
+      click_button "Start"
+      assert_selector "[data-stage='question_open']"
+      # Moderator navigates away from the game screen immediately
+      visit moderate_quiz_path(quiz)
+      assert_selector "h1", text: "Unattended Timer Talk"
+    end
+
+    # Player still automatically gets question_closed at 0:00
+    using_session(:alice) do
+      assert_text "No answer", wait: 6
+    end
+
+    # When moderator returns to the game URL, it shows question_closed
+    using_session(:moderator) do
+      visit game_url
+      assert_selector "[data-stage='question_closed']"
+      assert_no_selector "[role='timer']"
+    end
+  end
+end
