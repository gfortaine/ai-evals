+module Moderate
+  class GamesController < BaseController
+    layout "application"
+
+    before_action :set_game, only: %i[show state start finish next end_game top_winners draw_winners reset_winners]
+    before_action :disable_caching, only: %i[show state]
+
+    def create
+      @quiz = Quiz.find(params[:quiz_id])
+      game = Game.start_for_quiz!(@quiz)
+      redirect_to moderate_game_path(game), status: :see_other
+    rescue Game::NoActiveQuestionsError => e
+      redirect_to moderate_quiz_path(@quiz), alert: e.message, status: :see_other
+    end
+
+    def show
+      @game.sync_timer!
+      @join_url = play_url(@game.code)
+      @stream_token = @game.signed_id(purpose: :moderator_stream, expires_in: 24.hours)
+      @state = @game.moderator_state(join_url: @join_url)
+    end
+
+    def state
+      @game.sync_timer!
+      render json: @game.moderator_state(join_url: play_url(@game.code))
+    end
+
+    def start
+      @game.start!(expected_version: params[:expected_version])
+      respond_with_game_state
+    end
+
+    def finish
+      @game.finish!(expected_version: params[:expected_version])
+      respond_with_game_state
+    end
+
+    def next
+      @game.next_question!(expected_version: params[:expected_version])
+      respond_with_game_state
+    end
+
+    def end_game
+      @game.end_game!(expected_version: params[:expected_version])
+      respond_with_game_state
+    end
+
+    def top_winners
+      @game.pick_top_winners!
+      respond_with_game_state
+    end
+
+    def draw_winners
+      @game.draw_winners!
+      respond_with_game_state
+    end
+
+    def reset_winners
+      @game.reset_winners!
+      respond_with_game_state
+    end
+
+    private
+
+    def set_game
+      @game = Game.find(params[:id])
+    end
+
+    def disable_caching
+      response.headers["Cache-Control"] = "no-store"
+    end
+
+    def respond_with_game_state
+      respond_to do |format|
+        format.json { render json: @game.reload.moderator_state(join_url: play_url(@game.code)) }
+        format.html { redirect_to moderate_game_path(@game), status: :see_other }
+      end
+    end
+  end
+end
