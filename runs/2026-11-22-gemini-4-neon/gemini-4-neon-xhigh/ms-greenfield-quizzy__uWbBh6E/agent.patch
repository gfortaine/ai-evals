+require "application_system_test_case"
+
+class ModeratorFlowTest < ApplicationSystemTestCase
+  setup do
+    authenticate_as_moderator
+  end
+
+  test "complete moderator workflow: quiz CRUD, question validation & CRUD, reordering, active toggle, and preview" do
+    # 1. Quizzes list and creating a quiz
+    visit "/moderate"
+    assert_text "Quizzes"
+
+    click_on "New quiz"
+    # Blank title fails validation and stays on form
+    click_on "Save quiz"
+    assert_text "Title can't be blank"
+    assert_equal 0, Quiz.count
+
+    fill_in "Title", with: "Frontend Fest 2026"
+    click_on "Save quiz"
+
+    # Saving opens the quiz page
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_link "Settings"
+    assert_link "Preview"
+
+    # 2. Verify quiz appears in a list item on /moderate
+    visit "/moderate"
+    within("ul.quiz-list > li", text: "Frontend Fest 2026") do
+      click_on "Frontend Fest 2026"
+    end
+    assert_selector "h1", text: "Frontend Fest 2026"
+
+    # 3. Question form: 4 empty rows by default, Active on by default, Add option, validation rules
+    click_on "Add question"
+    assert_field "Option 1"
+    assert_field "Option 2"
+    assert_field "Option 3"
+    assert_field "Option 4"
+    assert_checked_field "Active"
+
+    # Rule: at least two options
+    fill_in "Question", with: "Which HTTP status code means Too Many Requests?"
+    fill_in "Option 1", with: "418"
+    check "Option 1 is correct"
+    click_on "Save question"
+    assert_text "Add at least two options"
+    # Keeps typed values
+    assert_field "Question", with: "Which HTTP status code means Too Many Requests?"
+    assert_field "Option 1", with: "418"
+    assert_checked_field "Option 1 is correct"
+    assert_equal 0, Question.count
+
+    # Rule: at least one correct option
+    uncheck "Option 1 is correct"
+    fill_in "Option 2", with: "429"
+    click_on "Save question"
+    assert_text "Mark at least one option as correct"
+    assert_field "Option 1", with: "418"
+    assert_field "Option 2", with: "429"
+    assert_unchecked_field "Option 1 is correct"
+    assert_equal 0, Question.count
+
+    # Add a 5th option dynamically, check Option 5 is correct & uncheck, save with empty middle rows skipped
+    click_on "Add option"
+    assert_field "Option 5"
+    fill_in "Option 5", with: "503"
+    check "Option 5 is correct"
+    assert_checked_field "Option 5 is correct"
+    uncheck "Option 5 is correct"
+    check "Option 2 is correct"
+    click_on "Save question"
+
+    assert_selector "h1", text: "Frontend Fest 2026"
+    within("ol.question-list > li", text: "Which HTTP status code means Too Many Requests?") do
+      assert_text "418"
+      assert_text "429"
+      assert_text "503"
+      assert_selector "li.is-correct", text: "429"
+      assert_checked_field "Active"
+    end
+
+    # 4. Add a second question (multiple correct options) and a third question (inactive)
+    click_on "Add question"
+    fill_in "Question", with: "Which protocols run over TCP?"
+    fill_in "Option 1", with: "HTTP/1.1"
+    fill_in "Option 2", with: "WebSocket"
+    fill_in "Option 3", with: "UDP"
+    check "Option 1 is correct"
+    check "Option 2 is correct"
+    click_on "Save question"
+
+    click_on "Add question"
+    fill_in "Question", with: "What does CSS stand for?"
+    fill_in "Option 1", with: "Cascading Style Sheets"
+    fill_in "Option 2", with: "Computer Style System"
+    check "Option 1 is correct"
+    uncheck "Active"
+    click_on "Save question"
+
+    # Verify order and inactive state
+    items = all("ol.question-list > li")
+    assert_equal 3, items.size
+    assert_includes items[0].text, "Which HTTP status code means Too Many Requests?"
+    assert_includes items[1].text, "Which protocols run over TCP?"
+    assert_includes items[2].text, "What does CSS stand for?"
+
+    # 5. Move up / Move down buttons (located by button text/label!) change the order and persist
+    within(items[1]) do
+      click_button "Move up"
+    end
+    assert_selector "ol.question-list > li:nth-child(1)", text: "Which protocols run over TCP?"
+    assert_selector "ol.question-list > li:nth-child(2)", text: "Which HTTP status code means Too Many Requests?"
+
+    within(all("ol.question-list > li")[0]) do
+      click_button "Move down"
+    end
+    assert_selector "ol.question-list > li:nth-child(1)", text: "Which HTTP status code means Too Many Requests?"
+    assert_selector "ol.question-list > li:nth-child(2)", text: "Which protocols run over TCP?"
+
+    # 6. Active checkbox auto-saves immediately (with no extra button)
+    within("ol.question-list > li", text: "What does CSS stand for?") do
+      assert_unchecked_field "Active"
+      check "Active"
+    end
+    assert_text "3 of 3 questions active"
+    visit current_path
+    within("ol.question-list > li", text: "What does CSS stand for?") do
+      assert_checked_field "Active"
+      uncheck "Active"
+    end
+    assert_text "2 of 3 questions active"
+    visit current_path
+    within("ol.question-list > li", text: "What does CSS stand for?") do
+      assert_unchecked_field "Active"
+    end
+
+    # 7. Edit a question: failed save preserves input and does NOT mutate DB
+    within("ol.question-list > li", text: "What does CSS stand for?") do
+      click_link "Edit"
+    end
+    assert_field "Question", with: "What does CSS stand for?"
+    assert_field "Option 1", with: "Cascading Style Sheets"
+    assert_field "Option 2", with: "Computer Style System"
+    assert_unchecked_field "Active"
+
+    fill_in "Question", with: "Unsaved edit?"
+    uncheck "Option 1 is correct"
+    click_on "Save question"
+    assert_text "Mark at least one option as correct"
+    assert_field "Question", with: "Unsaved edit?"
+    assert_unchecked_field "Option 1 is correct"
+
+    # Navigating back proves DB was untouched
+    click_on "Cancel"
+    assert_text "What does CSS stand for?"
+    assert_no_text "Unsaved edit?"
+
+    # Now perform a valid edit
+    within("ol.question-list > li", text: "What does CSS stand for?") do
+      click_link "Edit"
+    end
+    fill_in "Question", with: "What does CSS mean?"
+    click_on "Save question"
+    assert_text "What does CSS mean?"
+
+    # 8. Preview skips inactive questions, checks Wrong! / Correct!, reveals multiple correct, scores & restarts
+    click_link "Preview"
+    assert_text "Question 1 of 2"
+    assert_text "Which HTTP status code means Too Many Requests?"
+    assert_no_text "What does CSS mean?"
+
+    # Pick wrong option on Q1
+    click_button "418"
+    assert_text "Wrong!"
+    assert_selector "button.play-option.is-correct", text: "429"
+    # Options are disabled after picking
+    assert_selector "button.play-option[disabled]", count: 3
+    click_button "Next question"
+
+    # Question 2 has 2 correct options; pick one of them
+    assert_text "Question 2 of 2"
+    assert_text "Which protocols run over TCP?"
+    click_button "WebSocket"
+    assert_text "Correct!"
+    assert_selector "button.play-option.is-correct", text: "HTTP/1.1"
+    assert_selector "button.play-option.is-correct", text: "WebSocket"
+    click_button "See score"
+
+    assert_text "Score: 1/2"
+
+    # Verify nothing stored in localStorage / sessionStorage
+    assert_equal 0, evaluate_script("window.localStorage.length")
+    assert_equal 0, evaluate_script("window.sessionStorage.length")
+
+    # Start over restarts preview
+    click_button "Start over"
+    assert_text "Question 1 of 2"
+    click_button "429"
+    assert_text "Correct!"
+    click_button "Next question"
+    click_button "HTTP/1.1"
+    assert_text "Correct!"
+    click_button "See score"
+    assert_text "Score: 2/2"
+
+    # 9. Delete question with native confirm dialog (dismiss keeps, accept deletes)
+    click_on "Back to quiz"
+    dismiss_confirm do
+      within("ol.question-list > li", text: "What does CSS mean?") do
+        click_button "Delete"
+      end
+    end
+    assert_text "What does CSS mean?"
+
+    accept_confirm do
+      within("ol.question-list > li", text: "What does CSS mean?") do
+        click_button "Delete"
+      end
+    end
+    assert_no_text "What does CSS mean?"
+
+    # 10. Settings: validation error keeps form & breadcrumb, update works, delete quiz uses native confirm
+    click_link "Settings"
+    assert_field "Title", with: "Frontend Fest 2026"
+    fill_in "Title", with: ""
+    click_on "Save quiz"
+    assert_text "Title can't be blank"
+    assert_link "← Frontend Fest 2026"
+
+    fill_in "Title", with: "Frontend Fest 2027"
+    click_on "Save quiz"
+    assert_selector "h1", text: "Frontend Fest 2027"
+
+    click_link "Settings"
+    dismiss_confirm do
+      click_button "Delete quiz"
+    end
+    assert_text "Settings"
+    assert_equal 1, Quiz.count
+
+    accept_confirm do
+      click_button "Delete quiz"
+    end
+    assert_selector "h1", text: "Quizzes"
+    assert_no_text "Frontend Fest 2027"
+    assert_equal 0, Quiz.count
+  end
+
+  test "preview handles zero active questions, single active question, and special HTML characters safely" do
+    quiz = Quiz.create!(title: "Edge <script>alert(1)</script> & \"Quotes\"")
+    visit moderate_quiz_path(quiz)
+    assert_selector "h1", text: "Edge <script>alert(1)</script> & \"Quotes\""
+
+    # 0 active questions
+    click_link "Preview"
+    assert_text "No active questions to preview."
+    click_on "Back to quiz"
+
+    # Add 1 active question with special chars
+    click_on "Add question"
+    fill_in "Question", with: "Is 1 < 2 & \"true\"?"
+    fill_in "Option 1", with: "<b>Yes</b>"
+    fill_in "Option 2", with: "<script>bad</script>"
+    check "Option 1 is correct"
+    click_on "Save question"
+
+    click_link "Preview"
+    assert_text "Question 1 of 1"
+    assert_text "Is 1 < 2 & \"true\"?"
+    click_button "<b>Yes</b>"
+    assert_text "Correct!"
+    # Single question goes straight to See score (no Next question button)
+    assert_no_button "Next question"
+    click_button "See score"
+    assert_text "Score: 1/1"
+  end
+
+  test "option row removal renumbers remaining rows cleanly" do
+    quiz = Quiz.create!(title: "Renumber Test")
+    visit new_moderate_quiz_question_path(quiz)
+
+    fill_in "Question", with: "Pick one"
+    fill_in "Option 1", with: "First"
+    fill_in "Option 2", with: "Second"
+    fill_in "Option 3", with: "Third"
+    check "Option 3 is correct"
+
+    # Remove Option 2
+    find('button[aria-label="Remove option 2"]').click
+
+    # Remaining rows should be renumbered cleanly
+    assert_field "Option 1", with: "First"
+    assert_field "Option 2", with: "Third"
+    assert_checked_field "Option 2 is correct"
+    assert_field "Option 3", with: ""
+    assert_no_field "Option 4"
+
+    # Adding an option creates Option 4
+    click_on "Add option"
+    assert_field "Option 4"
+
+    click_on "Save question"
+    within("ol.question-list > li", text: "Pick one") do
+      assert_text "First"
+      assert_text "Third"
+      assert_no_text "Second"
+      assert_selector "li.is-correct", text: "Third"
+    end
+  end
+end
