+require "test_helper"
+
+class ModerateQuestionsTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = Quiz.create!(title: "Rails Conf")
+  end
+
+  test "creating question with invalid options preserves typed values and saves nothing" do
+    assert_no_difference [ "Question.count", "Option.count" ] do
+      post moderate_quiz_questions_path(@quiz), headers: basic_auth_headers, params: {
+        question: {
+          body: "Which database?",
+          active: "0",
+          option_rows: {
+            "0" => { body: "SQLite", correct: "0" },
+            "1" => { body: "Postgres", correct: "0" },
+            "2" => { body: "", correct: "0" },
+            "3" => { body: "", correct: "0" },
+            "4" => { body: "DuckDB", correct: "0" }
+          }
+        }
+      }
+    end
+
+    assert_response :unprocessable_entity
+    assert_includes response.body, "Mark at least one option as correct"
+    assert_includes response.body, "Which database?"
+    assert_includes response.body, "SQLite"
+    assert_includes response.body, "Postgres"
+    assert_includes response.body, "DuckDB"
+    assert_includes response.body, "Option 5"
+  end
+
+  test "toggle_active persists active flag immediately" do
+    q = @quiz.questions.build(body: "Toggle me", active: true)
+    q.save_with_option_rows([
+      { body: "A", correct: true },
+      { body: "B", correct: false }
+    ])
+
+    patch toggle_active_moderate_quiz_question_path(@quiz, q),
+          headers: basic_auth_headers,
+          params: { question: { active: "0" } }
+
+    assert_response :see_other
+    assert_equal false, q.reload.active?
+
+    patch toggle_active_moderate_quiz_question_path(@quiz, q),
+          headers: basic_auth_headers,
+          params: { question: { active: "1" } }
+
+    assert_response :see_other
+    assert_equal true, q.reload.active?
+  end
+end
