+require "test_helper"
+
+class ModerateAuthTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = Quiz.create!(title: "Auth Quiz")
+    @question = @quiz.questions.build(body: "Q1", active: true)
+    @question.save_with_option_rows([
+      { body: "A", correct: true },
+      { body: "B", correct: false }
+    ])
+  end
+
+  test "GET /up returns 200 without auth and with arbitrary host" do
+    get "/up", headers: { "Host" => "custom-conference.example.local:9999" }
+    assert_response :ok
+  end
+
+  test "all moderator endpoints return 401 without credentials" do
+    [
+      [ :get, "/moderate" ],
+      [ :get, "/moderate/import" ],
+      [ :post, "/moderate/import" ],
+      [ :get, "/moderate/quizzes/new" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}/edit" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}/preview" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}/export" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}/questions/new" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}/questions/#{@question.id}/edit" ],
+      [ :post, "/moderate/quizzes" ],
+      [ :patch, "/moderate/quizzes/#{@quiz.id}" ],
+      [ :delete, "/moderate/quizzes/#{@quiz.id}" ],
+      [ :patch, "/moderate/quizzes/#{@quiz.id}/questions/#{@question.id}/move_up" ],
+      [ :patch, "/moderate/quizzes/#{@quiz.id}/questions/#{@question.id}/toggle_active" ]
+    ].each do |method, path|
+      public_send(method, path)
+      assert_response :unauthorized, "Expected 401 for #{method.upcase} #{path}"
+    end
+  end
+
+  test "returns 401 with wrong credentials" do
+    get "/moderate", headers: basic_auth_headers("wrong", "creds")
+    assert_response :unauthorized
+
+    get "/moderate", headers: basic_auth_headers(ENV["QUIZZY_MODERATOR_USERNAME"], "wrong")
+    assert_response :unauthorized
+
+    get "/moderate", headers: basic_auth_headers("wrong", ENV["QUIZZY_MODERATOR_PASSWORD"])
+    assert_response :unauthorized
+  end
+
+  test "returns 401 if moderator env credentials are not configured" do
+    with_moderator_credentials("", "") do
+      get "/moderate", headers: basic_auth_headers("", "")
+      assert_response :unauthorized
+    end
+  end
+
+  test "allows access with valid credentials" do
+    get "/moderate", headers: basic_auth_headers
+    assert_response :ok
+    assert_includes response.body, "Auth Quiz"
+  end
+end
