diff --git a/app/views/moderate/questions/_form.html.erb b/app/views/moderate/questions/_form.html.erb
new file mode 100644
index 0000000..298a3a6
--- /dev/null
+++ b/app/views/moderate/questions/_form.html.erb
@@ -0,0 +1,53 @@
+<%= form_with model: [ :moderate, @quiz, @question ], data: { controller: "option-rows" } do |form| %>
+  <% if @question.errors.any? %>
+    <div class="errors" role="alert">
+      <% if @question.errors.size == 1 %>
+        <%= @question.errors.full_messages.first %>
+      <% else %>
+        <ul>
+          <% @question.errors.full_messages.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      <% end %>
+    </div>
+  <% end %>
+
+  <div class="field">
+    <%= form.label :body, "Question" %>
+    <%= form.text_area :body, class: "input", rows: 3, autofocus: true %>
+  </div>
+
+  <div class="field">
+    <span class="field-label">Options</span>
+    <span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span>
+  </div>
+
+  <div class="option-rows" data-option-rows-target="list">
+    <% @option_rows.each_with_index do |row, index| %>
+      <%= render "option_row", row: row, index: index %>
+    <% end %>
+  </div>
+
+  <template data-option-rows-target="template">
+    <%= render "option_row", row: Question::OptionRow.new(body: "", correct: false), index: @option_rows.size %>
+  </template>
+
+  <div class="buttons" style="margin-bottom: 28px">
+    <button type="button" class="btn btn--ghost btn--sm" data-action="option-rows#add">Add option</button>
+  </div>
+
+  <div class="field">
+    <%= hidden_field_tag "question[active]", "0", id: nil %>
+    <label class="checkbox" for="question_active">
+      <%= check_box_tag "question[active]", "1", @question.active?, id: "question_active" %>
+      Active
+    </label>
+    <span class="field-hint">Only active questions are played.</span>
+  </div>
+
+  <div class="buttons">
+    <%= form.button "Save question", type: :submit, class: "btn btn--pink" %>
+    <%= link_to "Cancel", moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+  </div>
+<% end %>
