diff --git a/app/javascript/controllers/moderator_game_controller.js b/app/javascript/controllers/moderator_game_controller.js
new file mode 100644
index 0000000..c9f2cb7
--- /dev/null
+++ b/app/javascript/controllers/moderator_game_controller.js
@@ -0,0 +1,694 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["body", "controls", "playersCount", "answersCount", "activePlayersCount", "timer"]
+  static values = {
+    streamToken: String,
+    stateUrl: String,
+    startUrl: String,
+    finishUrl: String,
+    nextUrl: String,
+    endUrl: String,
+    topWinnersUrl: String,
+    drawWinnersUrl: String,
+    resetWinnersUrl: String,
+    backUrl: String,
+    initialState: Object
+  }
+
+  connect() {
+    this.state = { ...this.initialStateValue }
+    this.submitting = false
+    this.wsConnected = false
+    this.tearingDown = false
+    this.pollTimer = null
+    this.reconnectTimer = null
+    this.reconnectAttempts = 0
+    this.countdownInterval = null
+    this.expirySyncTimer = null
+    this.timerDeadlinePerfMs = null
+    this.timerQuestionId = null
+    this.lastRenderedTimerText = null
+    this.renderedStatus = this.state.status
+    this.renderedQuestionId = this.state.question ? this.state.question.id : null
+    this.renderedEndedSignature = this.endedSignature(this.state)
+
+    this.onOnline = () => {
+      this.reconnectAttempts = 0
+      if (this.consumer && !this.wsConnected) {
+        this.consumer.connection.open()
+      }
+      this.fetchState()
+    }
+    this.onVisibilityChange = () => {
+      if (document.visibilityState === "visible") {
+        this.updateTimerDisplay()
+        if (this.consumer && !this.wsConnected) {
+          this.consumer.connection.open()
+        }
+        this.fetchState()
+      }
+    }
+
+    window.addEventListener("online", this.onOnline)
+    document.addEventListener("visibilitychange", this.onVisibilityChange)
+
+    this.syncTimerFromState({ reset: true })
+    this.connectCable()
+  }
+
+  disconnect() {
+    this.tearingDown = true
+    this.stopPolling()
+    this.clearReconnectTimer()
+    this.stopCountdown()
+    window.removeEventListener("online", this.onOnline)
+    document.removeEventListener("visibilitychange", this.onVisibilityChange)
+
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  connectCable() {
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      { channel: "GameModeratorChannel", token: this.streamTokenValue },
+      {
+        connected: () => {
+          this.wsConnected = true
+          this.reconnectAttempts = 0
+          this.stopPolling()
+          this.clearReconnectTimer()
+        },
+        disconnected: () => {
+          this.wsConnected = false
+          if (this.tearingDown) return
+          this.startPolling()
+          this.scheduleReconnect()
+        },
+        rejected: () => {
+          this.wsConnected = false
+          if (!this.tearingDown) this.startPolling()
+        },
+        received: (data) => {
+          this.handleMessage(data)
+        }
+      }
+    )
+  }
+
+  scheduleReconnect() {
+    if (this.tearingDown || this.wsConnected || this.reconnectTimer) return
+    const base = Math.min(500 * Math.pow(1.6, this.reconnectAttempts), 5000)
+    const delay = Math.round(base + Math.random() * 400)
+    this.reconnectAttempts += 1
+    this.reconnectTimer = window.setTimeout(() => {
+      this.reconnectTimer = null
+      if (!this.tearingDown && !this.wsConnected && this.consumer) {
+        this.consumer.connection.open()
+      }
+    }, delay)
+  }
+
+  clearReconnectTimer() {
+    if (this.reconnectTimer) {
+      window.clearTimeout(this.reconnectTimer)
+      this.reconnectTimer = null
+    }
+  }
+
+  startPolling() {
+    if (this.pollTimer) return
+    this.pollTimer = window.setInterval(() => {
+      if (!this.wsConnected) {
+        this.fetchState()
+      }
+    }, 1200)
+  }
+
+  stopPolling() {
+    if (this.pollTimer) {
+      window.clearInterval(this.pollTimer)
+      this.pollTimer = null
+    }
+  }
+
+  syncTimerFromState({ reset = false } = {}) {
+    const hasTimer =
+      this.state.status === "question_open" &&
+      typeof this.state.timer_remaining_ms === "number"
+
+    if (!hasTimer) {
+      this.stopCountdown()
+      return
+    }
+
+    const questionId = this.state.question ? this.state.question.id : null
+    const serverRemainingMs = Math.max(0, this.state.timer_remaining_ms)
+    const candidateDeadline = performance.now() + serverRemainingMs
+
+    if (reset || this.timerDeadlinePerfMs === null || this.timerQuestionId !== questionId) {
+      this.clearExpirySyncTimer()
+      this.timerQuestionId = questionId
+      this.timerDeadlinePerfMs = candidateDeadline
+      this.lastRenderedTimerText = null
+    } else if (
+      candidateDeadline < this.timerDeadlinePerfMs - 150 ||
+      Math.abs(candidateDeadline - this.timerDeadlinePerfMs) > 1000
+    ) {
+      this.timerDeadlinePerfMs = candidateDeadline
+    }
+
+    if (this.remainingTimerMs() > 0) {
+      this.startCountdownInterval()
+    } else {
+      this.stopCountdownInterval()
+      this.scheduleExpirySync(120)
+    }
+
+    this.updateTimerDisplay()
+  }
+
+  startCountdownInterval() {
+    if (this.countdownInterval) return
+    this.countdownInterval = window.setInterval(() => {
+      this.updateTimerDisplay()
+    }, 100)
+  }
+
+  stopCountdownInterval() {
+    if (this.countdownInterval) {
+      window.clearInterval(this.countdownInterval)
+      this.countdownInterval = null
+    }
+  }
+
+  clearExpirySyncTimer() {
+    if (this.expirySyncTimer) {
+      window.clearTimeout(this.expirySyncTimer)
+      this.expirySyncTimer = null
+    }
+  }
+
+  stopCountdown() {
+    this.stopCountdownInterval()
+    this.clearExpirySyncTimer()
+    this.timerDeadlinePerfMs = null
+    this.timerQuestionId = null
+    this.lastRenderedTimerText = null
+  }
+
+  scheduleExpirySync(delay = 120) {
+    if (this.tearingDown || this.expirySyncTimer) return
+    if (this.state.status !== "question_open") return
+
+    this.expirySyncTimer = window.setTimeout(async () => {
+      this.expirySyncTimer = null
+      if (this.tearingDown || this.state.status !== "question_open") return
+      await this.fetchState()
+      if (!this.tearingDown && this.state.status === "question_open" && this.remainingTimerMs() <= 0) {
+        this.scheduleExpirySync(250)
+      }
+    }, delay)
+  }
+
+  remainingTimerMs() {
+    if (this.timerDeadlinePerfMs === null) {
+      return typeof this.state.timer_remaining_ms === "number"
+        ? Math.max(0, this.state.timer_remaining_ms)
+        : 0
+    }
+    return Math.max(0, this.timerDeadlinePerfMs - performance.now())
+  }
+
+  remainingTimerSeconds() {
+    return Math.ceil(this.remainingTimerMs() / 1000)
+  }
+
+  updateTimerDisplay() {
+    if (this.state.status !== "question_open" || typeof this.state.timer_remaining_ms !== "number") {
+      return
+    }
+
+    const remainingMs = this.remainingTimerMs()
+    const seconds = Math.ceil(remainingMs / 1000)
+    const text = this.formatTimer(seconds)
+
+    if (this.hasTimerTarget) {
+      if (text !== this.lastRenderedTimerText) {
+        this.timerTarget.textContent = text
+        this.lastRenderedTimerText = text
+      }
+      this.timerTarget.classList.toggle("stage-timer--urgent", seconds <= 5)
+    }
+
+    if (remainingMs <= 0) {
+      this.stopCountdownInterval()
+      this.scheduleExpirySync(120)
+    }
+  }
+
+  formatTimer(totalSeconds) {
+    const clamped = Math.max(0, Math.floor(totalSeconds))
+    const minutes = Math.floor(clamped / 60)
+    const seconds = clamped % 60
+    return `${minutes}:${String(seconds).padStart(2, "0")}`
+  }
+
+  async fetchState() {
+    try {
+      const response = await fetch(this.stateUrlValue, {
+        headers: { Accept: "application/json" },
+        credentials: "same-origin",
+        cache: "no-store"
+      })
+      if (!response.ok) return
+      const data = await response.json()
+      this.applyState(data)
+    } catch (_error) {
+      // Network hiccup; next reconnect or poll will retry.
+    }
+  }
+
+  handleMessage(data) {
+    if (!data || typeof data !== "object") return
+
+    if (data.type === "counts") {
+      if (typeof data.state_version === "number" && data.state_version < this.state.state_version) {
+        return
+      }
+      this.state.active_players_count = data.active_players_count
+      this.state.answers_count = data.answers_count
+      this.updateCounters()
+      return
+    }
+
+    if (data.type === "state") {
+      this.applyState(data)
+    }
+  }
+
+  applyState(nextState) {
+    if (!nextState || typeof nextState !== "object") return
+
+    const nextVersion = Number(nextState.state_version ?? 0)
+    const currentVersion = Number(this.state.state_version ?? 0)
+    if (nextVersion < currentVersion) return
+
+    const joinUrl = nextState.join_url || this.state.join_url
+    const nextEndedSignature = this.endedSignature(nextState)
+    const sameScreen =
+      nextState.status === this.renderedStatus &&
+      (nextState.question ? nextState.question.id : null) === this.renderedQuestionId &&
+      (nextState.status !== "ended" || nextEndedSignature === this.renderedEndedSignature)
+
+    this.state = { ...nextState, join_url: joinUrl }
+
+    if (sameScreen) {
+      this.updateCounters()
+      this.syncTimerFromState({ reset: false })
+      return
+    }
+
+    this.syncTimerFromState({ reset: true })
+    this.render()
+    this.updateTimerDisplay()
+  }
+
+  endedSignature(state) {
+    if (!state || state.status !== "ended") return null
+    const entries = Array.isArray(state.leaderboard) ? state.leaderboard : []
+    return JSON.stringify({
+      winners_count: state.winners_count ?? 3,
+      leaderboard: entries.map((e) => [e.player_id, e.place, e.name, e.points, Boolean(e.winner)])
+    })
+  }
+
+  updateCounters() {
+    const active = String(this.state.active_players_count ?? 0)
+    const answers = String(this.state.answers_count ?? 0)
+
+    if (this.hasPlayersCountTarget) {
+      this.playersCountTarget.textContent = active
+    }
+    if (this.hasAnswersCountTarget) {
+      this.answersCountTarget.textContent = answers
+    }
+    if (this.hasActivePlayersCountTarget) {
+      this.activePlayersCountTarget.textContent = active
+    }
+  }
+
+  start(event) {
+    this.submitTransition(event, this.startUrlValue)
+  }
+
+  finish(event) {
+    this.submitTransition(event, this.finishUrlValue)
+  }
+
+  next(event) {
+    this.submitTransition(event, this.nextUrlValue)
+  }
+
+  endGame(event) {
+    this.submitTransition(event, this.endUrlValue)
+  }
+
+  topWinners(event) {
+    this.submitTransition(event, this.topWinnersUrlValue, { includeVersion: false })
+  }
+
+  drawWinners(event) {
+    this.submitTransition(event, this.drawWinnersUrlValue, { includeVersion: false })
+  }
+
+  resetWinners(event) {
+    this.submitTransition(event, this.resetWinnersUrlValue, { includeVersion: false })
+  }
+
+  async submitTransition(event, url, { includeVersion = true } = {}) {
+    if (event) event.preventDefault()
+    if (this.submitting) return
+
+    this.submitting = true
+    const actionButtons = Array.from(this.controlsTarget.querySelectorAll("button"))
+    actionButtons.forEach((button) => { button.disabled = true })
+
+    try {
+      const payload = includeVersion ? { expected_version: this.state.state_version } : {}
+      const response = await fetch(url, {
+        method: "POST",
+        headers: {
+          Accept: "application/json",
+          "Content-Type": "application/json",
+          "X-CSRF-Token": this.csrfToken()
+        },
+        credentials: "same-origin",
+        body: JSON.stringify(payload)
+      })
+
+      if (response.ok) {
+        const data = await response.json()
+        this.applyState(data)
+      } else {
+        await this.fetchState()
+      }
+    } catch (_error) {
+      actionButtons.forEach((button) => {
+        if (button.isConnected) button.disabled = false
+      })
+    } finally {
+      this.submitting = false
+      this.controlsTarget.querySelectorAll("button").forEach((button) => {
+        button.disabled = false
+      })
+    }
+  }
+
+  render() {
+    this.updateCoverClasses()
+    this.renderBody()
+    this.renderControls()
+    this.renderedStatus = this.state.status
+    this.renderedQuestionId = this.state.question ? this.state.question.id : null
+    this.renderedEndedSignature = this.endedSignature(this.state)
+  }
+
+  updateCoverClasses() {
+    this.element.classList.remove("cover--blue", "cover--calm", "cover--night")
+    if (this.state.status === "ended") {
+      this.element.classList.add("cover--night")
+    } else if (this.state.status === "question_open" || this.state.status === "question_closed") {
+      this.element.classList.add("cover--blue", "cover--calm")
+    }
+  }
+
+  renderBody() {
+    if (this.state.status === "lobby") {
+      this.updateCounters()
+      return
+    }
+
+    this.bodyTarget.textContent = ""
+
+    if (this.state.status === "question_open") {
+      this.bodyTarget.appendChild(this.buildQuestionStage(false))
+    } else if (this.state.status === "question_closed") {
+      this.bodyTarget.appendChild(this.buildQuestionStage(true))
+    } else if (this.state.status === "ended") {
+      this.bodyTarget.appendChild(this.buildEndedStage())
+    }
+  }
+
+  buildQuestionStage(closed) {
+    const wrapper = document.createElement("div")
+    wrapper.dataset.stage = closed ? "question_closed" : "question_open"
+
+    const header = document.createElement("div")
+    header.className = "stage-question__header"
+
+    const num = document.createElement("div")
+    num.className = "stage-question__num"
+    num.textContent = `Question ${this.state.question_number} of ${this.state.total_questions}`
+    header.appendChild(num)
+
+    if (!closed && typeof this.state.timer_remaining_ms === "number") {
+      const timer = document.createElement("div")
+      const seconds = this.remainingTimerSeconds()
+      timer.className = seconds <= 5 ? "stage-timer stage-timer--urgent" : "stage-timer"
+      timer.dataset.moderatorGameTarget = "timer"
+      timer.setAttribute("role", "timer")
+      timer.setAttribute("aria-live", "off")
+      timer.textContent = this.formatTimer(seconds)
+      header.appendChild(timer)
+    }
+
+    wrapper.appendChild(header)
+
+    const body = document.createElement("div")
+    body.className = "stage-question__body"
+    body.textContent = this.state.question.body
+    wrapper.appendChild(body)
+
+    const list = document.createElement("ol")
+    list.className = closed ? "stage-options stage-options--results" : "stage-options"
+
+    this.state.question.options.forEach((opt, idx) => {
+      const li = document.createElement("li")
+      li.className = "stage-option"
+
+      if (closed && opt.correct) {
+        li.classList.add("is-correct")
+        li.dataset.correct = "true"
+      }
+
+      if (closed) {
+        const bar = document.createElement("span")
+        bar.className = "stage-option__bar"
+        bar.style.setProperty("--share", `${opt.share ?? 0}%`)
+        bar.setAttribute("aria-hidden", "true")
+        li.appendChild(bar)
+      }
+
+      const letter = document.createElement("span")
+      letter.className = "stage-option__letter"
+      letter.setAttribute("aria-hidden", "true")
+      letter.textContent = this.optionLetter(idx)
+      li.appendChild(letter)
+
+      const title = document.createElement("span")
+      title.className = "stage-option__title"
+      title.textContent = opt.body
+      li.appendChild(title)
+
+      if (closed && opt.correct) {
+        const mark = document.createElement("span")
+        mark.className = "stage-option__mark"
+        mark.textContent = "Correct"
+        li.appendChild(mark)
+      }
+
+      if (closed) {
+        const count = document.createElement("span")
+        count.className = "stage-option__count"
+        count.textContent = String(opt.count ?? 0)
+        li.appendChild(count)
+      }
+
+      list.appendChild(li)
+    })
+
+    wrapper.appendChild(list)
+    return wrapper
+  }
+
+  buildEndedStage() {
+    const wrapper = document.createElement("div")
+    wrapper.className = "leaderboard-layout"
+    wrapper.dataset.stage = "ended"
+
+    const left = document.createElement("div")
+    const kicker = document.createElement("div")
+    kicker.className = "screen__kicker"
+    kicker.textContent = this.state.quiz_title
+    left.appendChild(kicker)
+
+    const title = document.createElement("h1")
+    title.className = "leaderboard-layout__title"
+    title.textContent = "The quiz is over"
+    left.appendChild(title)
+    wrapper.appendChild(left)
+
+    const right = document.createElement("div")
+    const entries = Array.isArray(this.state.leaderboard) ? this.state.leaderboard : []
+
+    if (entries.length > 0) {
+      const list = document.createElement("ol")
+      list.className = "leaderboard"
+
+      entries.forEach((entry) => {
+        const li = document.createElement("li")
+        li.className = entry.winner ? "leader is-winner" : "leader"
+        li.dataset.playerId = String(entry.player_id)
+        if (entry.winner) {
+          li.dataset.winner = "true"
+        }
+
+        const place = document.createElement("span")
+        place.className = "leader__place"
+        place.textContent = String(entry.place)
+        li.appendChild(place)
+
+        const identity = document.createElement("span")
+        identity.className = "leader__identity"
+
+        const name = document.createElement("span")
+        name.className = "leader__name"
+        name.textContent = entry.name
+        identity.appendChild(name)
+
+        if (entry.winner) {
+          const badge = document.createElement("span")
+          badge.className = "leader__badge"
+          badge.textContent = "Winner"
+          identity.appendChild(badge)
+        }
+
+        li.appendChild(identity)
+
+        const score = document.createElement("span")
+        score.className = "leader__score"
+        score.textContent = this.pointsLabel(entry.points)
+        li.appendChild(score)
+
+        list.appendChild(li)
+      })
+
+      right.appendChild(list)
+    } else {
+      const empty = document.createElement("p")
+      empty.className = "play-lead"
+      empty.textContent = "No players joined this quiz."
+      right.appendChild(empty)
+    }
+
+    wrapper.appendChild(right)
+    return wrapper
+  }
+
+  renderControls() {
+    this.controlsTarget.textContent = ""
+
+    const info = document.createElement("div")
+    info.className = "screen-controls__info"
+
+    const backLink = document.createElement("a")
+    backLink.href = this.backUrlValue
+    backLink.textContent = "← Back to quiz"
+    info.appendChild(backLink)
+
+    if (this.state.status === "question_open") {
+      const counter = document.createElement("span")
+      counter.className = "answers-counter"
+      counter.append("Answers: ")
+
+      const answeredSpan = document.createElement("span")
+      answeredSpan.dataset.moderatorGameTarget = "answersCount"
+      answeredSpan.textContent = String(this.state.answers_count ?? 0)
+      counter.appendChild(answeredSpan)
+
+      counter.append(" / ")
+
+      const activeSpan = document.createElement("span")
+      activeSpan.dataset.moderatorGameTarget = "activePlayersCount"
+      activeSpan.textContent = String(this.state.active_players_count ?? 0)
+      counter.appendChild(activeSpan)
+
+      info.appendChild(counter)
+    }
+
+    this.controlsTarget.appendChild(info)
+
+    const buttons = document.createElement("div")
+    buttons.className = "buttons"
+
+    if (this.state.status === "lobby") {
+      buttons.appendChild(this.buildActionButton("Start", "click->moderator-game#start"))
+    } else if (this.state.status === "question_open") {
+      buttons.appendChild(this.buildActionButton("Finish", "click->moderator-game#finish"))
+    } else if (this.state.status === "question_closed") {
+      if (this.state.last_question) {
+        buttons.appendChild(this.buildActionButton("End quiz", "click->moderator-game#endGame"))
+      } else {
+        buttons.appendChild(this.buildActionButton("Next", "click->moderator-game#next"))
+      }
+    } else if (this.state.status === "ended") {
+      const winnersCount = this.state.winners_count ?? 3
+      buttons.appendChild(this.buildActionButton(`Top ${winnersCount}`, "click->moderator-game#topWinners", "btn btn--pink btn--lg"))
+      buttons.appendChild(this.buildActionButton("Draw", "click->moderator-game#drawWinners", "btn btn--light btn--lg"))
+      buttons.appendChild(this.buildActionButton("Reset winners", "click->moderator-game#resetWinners", "btn btn--ghost btn--lg"))
+    }
+
+    if (this.submitting) {
+      buttons.querySelectorAll("button").forEach((button) => { button.disabled = true })
+    }
+
+    this.controlsTarget.appendChild(buttons)
+  }
+
+  buildActionButton(label, action, className = "btn btn--pink btn--lg") {
+    const button = document.createElement("button")
+    button.type = "button"
+    button.className = className
+    button.dataset.action = action
+    button.textContent = label
+    return button
+  }
+
+  pointsLabel(points) {
+    const count = Number(points) || 0
+    return count === 1 ? "1 point" : `${count} points`
+  }
+
+  optionLetter(index) {
+    if (index < 26) {
+      return String.fromCharCode(65 + index)
+    }
+    const first = String.fromCharCode(65 + Math.floor(index / 26) - 1)
+    const second = String.fromCharCode(65 + (index % 26))
+    return `${first}${second}`
+  }
+
+  csrfToken() {
+    const meta = document.querySelector('meta[name="csrf-token"]')
+    return meta ? meta.getAttribute("content") : ""
+  }
+}
diff --git a/app/javascript/controllers/option_rows_controller.js b/app/javascript/controllers/option_rows_controller.js
new file mode 100644
index 0000000..5f491a2
--- /dev/null
+++ b/app/javascript/controllers/option_rows_controller.js
@@ -0,0 +1,74 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["list", "row", "template"]
+
+  add() {
+    const fragment = this.templateTarget.content.cloneNode(true)
+    this.listTarget.appendChild(fragment)
+    this.renumber()
+
+    const rows = this.rowTargets
+    const lastRow = rows[rows.length - 1]
+    const input = lastRow?.querySelector('[data-role="body"]')
+    if (input) input.focus()
+  }
+
+  remove(event) {
+    const row = event.currentTarget.closest('[data-option-rows-target="row"]')
+    if (!row) return
+
+    row.remove()
+    this.renumber()
+  }
+
+  renumber() {
+    this.rowTargets.forEach((row, index) => {
+      const number = index + 1
+      const bodyId = `question_option_rows_${index}_body`
+      const correctId = `question_option_rows_${index}_correct`
+
+      const bodyLabel = row.querySelector('[data-role="body-label"]')
+      if (bodyLabel) {
+        bodyLabel.setAttribute("for", bodyId)
+        bodyLabel.textContent = `Option ${number}`
+      }
+
+      const bodyInput = row.querySelector('[data-role="body"]')
+      if (bodyInput) {
+        bodyInput.id = bodyId
+        bodyInput.name = `question[option_rows][${index}][body]`
+        bodyInput.placeholder = `Option ${number}`
+        bodyInput.setAttribute("aria-label", `Option ${number}`)
+      }
+
+      const hiddenInput = row.querySelector('[data-role="correct-hidden"]')
+      if (hiddenInput) {
+        hiddenInput.name = `question[option_rows][${index}][correct]`
+      }
+
+      const correctLabel = row.querySelector('[data-role="correct-label"]')
+      if (correctLabel) {
+        correctLabel.setAttribute("for", correctId)
+      }
+
+      const correctInput = row.querySelector('[data-role="correct"]')
+      if (correctInput) {
+        correctInput.id = correctId
+        correctInput.name = `question[option_rows][${index}][correct]`
+        correctInput.setAttribute("aria-label", `Option ${number} is correct`)
+      }
+
+      const correctPrefix = row.querySelector('[data-role="correct-prefix"]')
+      if (correctPrefix) {
+        correctPrefix.textContent = `Option ${number} is `
+      }
+
+      const removeButton = row.querySelector('[data-role="remove"]')
+      if (removeButton) {
+        removeButton.setAttribute("aria-label", `Remove option ${number}`)
+        removeButton.setAttribute("title", `Remove option ${number}`)
+      }
+    })
+  }
+}
diff --git a/app/javascript/controllers/play_join_controller.js b/app/javascript/controllers/play_join_controller.js
new file mode 100644
index 0000000..6d0d331
--- /dev/null
+++ b/app/javascript/controllers/play_join_controller.js
@@ -0,0 +1,126 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["body"]
+  static values = {
+    code: String,
+    stateUrl: String
+  }
+
+  connect() {
+    this.ended = false
+    this.wsConnected = false
+    this.tearingDown = false
+    this.pollTimer = null
+    this.reconnectTimer = null
+    this.reconnectAttempts = 0
+
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      { channel: "GamePublicChannel", code: this.codeValue },
+      {
+        connected: () => {
+          this.wsConnected = true
+          this.reconnectAttempts = 0
+          this.stopPolling()
+          this.clearReconnectTimer()
+        },
+        disconnected: () => {
+          this.wsConnected = false
+          if (this.tearingDown || this.ended) return
+          this.startPolling()
+          this.scheduleReconnect()
+        },
+        rejected: () => {
+          this.wsConnected = false
+          if (!this.tearingDown && !this.ended) this.startPolling()
+        },
+        received: (data) => {
+          if (data && data.status === "ended") {
+            this.renderEnded()
+          }
+        }
+      }
+    )
+  }
+
+  disconnect() {
+    this.tearingDown = true
+    this.stopPolling()
+    this.clearReconnectTimer()
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  scheduleReconnect() {
+    if (this.tearingDown || this.wsConnected || this.ended || this.reconnectTimer) return
+    const base = Math.min(500 * Math.pow(1.6, this.reconnectAttempts), 5000)
+    const delay = Math.round(base + Math.random() * 400)
+    this.reconnectAttempts += 1
+    this.reconnectTimer = window.setTimeout(() => {
+      this.reconnectTimer = null
+      if (!this.tearingDown && !this.wsConnected && !this.ended && this.consumer) {
+        this.consumer.connection.open()
+      }
+    }, delay)
+  }
+
+  clearReconnectTimer() {
+    if (this.reconnectTimer) {
+      window.clearTimeout(this.reconnectTimer)
+      this.reconnectTimer = null
+    }
+  }
+
+  startPolling() {
+    if (this.pollTimer || this.ended) return
+    this.pollTimer = window.setInterval(async () => {
+      if (this.wsConnected || this.ended) return
+      try {
+        const response = await fetch(this.stateUrlValue, {
+          headers: { Accept: "application/json" },
+          cache: "no-store"
+        })
+        if (!response.ok) return
+        const data = await response.json()
+        if (data && data.status === "ended") {
+          this.renderEnded()
+        }
+      } catch (_error) {
+        // Ignore transient network errors.
+      }
+    }, 1500)
+  }
+
+  stopPolling() {
+    if (this.pollTimer) {
+      window.clearInterval(this.pollTimer)
+      this.pollTimer = null
+    }
+  }
+
+  renderEnded() {
+    if (this.ended) return
+    this.ended = true
+    this.stopPolling()
+    this.clearReconnectTimer()
+
+    this.bodyTarget.textContent = ""
+    const waiting = document.createElement("div")
+    waiting.className = "waiting"
+
+    const heading = document.createElement("h1")
+    heading.className = "play-title"
+    heading.textContent = "The quiz is over"
+    waiting.appendChild(heading)
+
+    this.bodyTarget.appendChild(waiting)
+  }
+}
diff --git a/app/javascript/controllers/player_game_controller.js b/app/javascript/controllers/player_game_controller.js
new file mode 100644
index 0000000..d3719cb
--- /dev/null
+++ b/app/javascript/controllers/player_game_controller.js
@@ -0,0 +1,723 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["body"]
+  static values = {
+    code: String,
+    streamToken: String,
+    stateUrl: String,
+    answerUrl: String,
+    initialState: Object
+  }
+
+  connect() {
+    this.state = { ...this.initialStateValue }
+    this.selectedQuestionId = this.state.question ? this.state.question.id : null
+    this.selectedOptionId = this.state.selected_option_id ?? null
+    this.confirmedOptionId = this.selectedOptionId
+    this.pendingAnswer = null
+    this.answerInFlight = false
+    this.retryAttempts = 0
+    this.retryTimer = null
+    this.endedResultFetchTimer = null
+    this.reconcileAfterFlight = false
+    this.wsConnected = false
+    this.tearingDown = false
+    this.pollTimer = null
+    this.reconnectTimer = null
+    this.reconnectAttempts = 0
+    this.renderedStatus = this.state.status
+    this.renderedQuestionId = this.selectedQuestionId
+    this.renderedEndedSignature = this.endedSignature(this.state)
+
+    this.onOnline = () => {
+      this.reconnectAttempts = 0
+      if (this.consumer && !this.wsConnected) {
+        this.consumer.connection.open()
+      }
+      this.flushPendingAnswer()
+      this.fetchState(false)
+    }
+
+    this.onVisibilityChange = () => {
+      if (document.visibilityState === "visible") {
+        if (this.consumer && !this.wsConnected) {
+          this.consumer.connection.open()
+        }
+        this.fetchState(false)
+      }
+    }
+
+    this.onPageHide = () => {
+      this.teardownCable()
+    }
+
+    this.onPageShow = (event) => {
+      if (event.persisted) {
+        this.tearingDown = false
+        this.connectCable()
+        this.fetchState(false)
+      }
+    }
+
+    window.addEventListener("online", this.onOnline)
+    document.addEventListener("visibilitychange", this.onVisibilityChange)
+    window.addEventListener("pagehide", this.onPageHide)
+    window.addEventListener("pageshow", this.onPageShow)
+
+    this.connectCable()
+  }
+
+  disconnect() {
+    this.tearingDown = true
+    this.stopPolling()
+    this.clearReconnectTimer()
+    this.clearRetryTimer()
+    this.clearEndedResultFetchTimer()
+    window.removeEventListener("online", this.onOnline)
+    document.removeEventListener("visibilitychange", this.onVisibilityChange)
+    window.removeEventListener("pagehide", this.onPageHide)
+    window.removeEventListener("pageshow", this.onPageShow)
+    this.teardownCable()
+  }
+
+  connectCable() {
+    if (this.consumer) return
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      {
+        channel: "GamePlayerChannel",
+        code: this.codeValue,
+        token: this.streamTokenValue
+      },
+      {
+        connected: () => {
+          this.wsConnected = true
+          this.reconnectAttempts = 0
+          this.stopPolling()
+          this.clearReconnectTimer()
+        },
+        disconnected: () => {
+          this.wsConnected = false
+          if (this.tearingDown) return
+          this.startPolling()
+          this.scheduleReconnect()
+        },
+        rejected: () => {
+          this.wsConnected = false
+          if (!this.tearingDown) this.startPolling()
+        },
+        received: (data) => {
+          this.handleMessage(data)
+        }
+      }
+    )
+  }
+
+  teardownCable() {
+    this.tearingDown = true
+    this.wsConnected = false
+    this.clearReconnectTimer()
+    this.stopPolling()
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  scheduleReconnect() {
+    if (this.tearingDown || this.wsConnected || this.reconnectTimer) return
+    const base = Math.min(500 * Math.pow(1.6, this.reconnectAttempts), 5000)
+    const delay = Math.round(base + Math.random() * 400)
+    this.reconnectAttempts += 1
+    this.reconnectTimer = window.setTimeout(() => {
+      this.reconnectTimer = null
+      if (!this.tearingDown && !this.wsConnected && this.consumer) {
+        this.consumer.connection.open()
+      }
+    }, delay)
+  }
+
+  clearReconnectTimer() {
+    if (this.reconnectTimer) {
+      window.clearTimeout(this.reconnectTimer)
+      this.reconnectTimer = null
+    }
+  }
+
+  startPolling() {
+    if (this.pollTimer) return
+    const interval = 1100 + Math.floor(Math.random() * 350)
+    this.pollTimer = window.setInterval(() => {
+      if (!this.wsConnected) {
+        this.fetchState(true)
+      }
+    }, interval)
+  }
+
+  stopPolling() {
+    if (this.pollTimer) {
+      window.clearInterval(this.pollTimer)
+      this.pollTimer = null
+    }
+  }
+
+  clearRetryTimer() {
+    if (this.retryTimer) {
+      window.clearTimeout(this.retryTimer)
+      this.retryTimer = null
+    }
+  }
+
+  clearEndedResultFetchTimer() {
+    if (this.endedResultFetchTimer) {
+      window.clearTimeout(this.endedResultFetchTimer)
+      this.endedResultFetchTimer = null
+    }
+  }
+
+  scheduleEndedResultFetch() {
+    if (this.endedResultFetchTimer || this.tearingDown) return
+    this.endedResultFetchTimer = window.setTimeout(() => {
+      this.endedResultFetchTimer = null
+      if (!this.tearingDown && this.state.status === "ended" && typeof this.state.place !== "number") {
+        this.fetchState(false)
+      }
+    }, 250)
+  }
+
+  async fetchState(fallback) {
+    try {
+      const url = fallback ? `${this.stateUrlValue}?fallback=1` : this.stateUrlValue
+      const response = await fetch(url, {
+        headers: { Accept: "application/json" },
+        credentials: "same-origin",
+        cache: "no-store"
+      })
+      if (!response.ok) return
+      const data = await response.json()
+      this.applyState(data, { authoritative: true })
+    } catch (_error) {
+      // Transient Wi-Fi error; next reconnect or poll will sync.
+    }
+  }
+
+  handleMessage(data) {
+    if (!data || typeof data !== "object") return
+
+    if (data.type === "player_answer") {
+      if (
+        this.state.status === "question_open" &&
+        this.state.question &&
+        this.state.question.id === data.game_question_id &&
+        !this.answerInFlight &&
+        !this.pendingAnswer
+      ) {
+        this.selectedQuestionId = data.game_question_id
+        this.selectedOptionId = data.selected_option_id
+        this.confirmedOptionId = data.selected_option_id
+        this.updateOpenOptionSelection()
+      }
+      return
+    }
+
+    if (data.type === "state") {
+      const hasPersonal = Object.prototype.hasOwnProperty.call(data, "selected_option_id")
+      this.applyState(data, { authoritative: hasPersonal })
+    }
+  }
+
+  endedSignature(state) {
+    if (!state || state.status !== "ended") return null
+    return JSON.stringify([
+      state.place ?? null,
+      state.total_players ?? null,
+      state.points ?? null,
+      Boolean(state.winner)
+    ])
+  }
+
+  applyState(nextState, { authoritative = false } = {}) {
+    if (!nextState || typeof nextState !== "object") return
+
+    const nextVersion = Number(nextState.state_version ?? 0)
+    const currentVersion = Number(this.state.state_version ?? 0)
+    if (nextVersion < currentVersion) return
+
+    const playerName = nextState.player_name || this.state.player_name
+    const nextQuestionId = nextState.question ? nextState.question.id : null
+    const hasPersonal = Object.prototype.hasOwnProperty.call(nextState, "selected_option_id")
+
+    if (nextState.status === "ended") {
+      this.pendingAnswer = null
+      this.clearRetryTimer()
+
+      const hasResult = Object.prototype.hasOwnProperty.call(nextState, "place")
+      const alreadyHasResult = Object.prototype.hasOwnProperty.call(this.state, "place")
+
+      if (hasResult) {
+        this.clearEndedResultFetchTimer()
+        this.state = { ...nextState, player_name: playerName }
+        const nextSignature = this.endedSignature(this.state)
+        if (this.renderedStatus !== "ended" || nextSignature !== this.renderedEndedSignature) {
+          this.render()
+        }
+        return
+      }
+
+      if (alreadyHasResult && this.state.status === "ended" && nextVersion <= currentVersion) {
+        return
+      }
+
+      this.state = {
+        ...nextState,
+        player_name: playerName,
+        ...(alreadyHasResult ? {
+          place: this.state.place,
+          total_players: this.state.total_players,
+          points: this.state.points,
+          winner: this.state.winner
+        } : {})
+      }
+
+      const nextSignature = this.endedSignature(this.state)
+      if (this.renderedStatus !== "ended" || nextSignature !== this.renderedEndedSignature) {
+        this.render()
+      }
+
+      if (!alreadyHasResult) {
+        this.scheduleEndedResultFetch()
+      }
+      return
+    }
+
+    if (nextState.status === "lobby") {
+      this.state = { ...nextState, player_name: playerName }
+      if (this.renderedStatus !== "lobby") {
+        this.render()
+      }
+      return
+    }
+
+    if (nextState.status === "question_open") {
+      const isNewQuestion = nextQuestionId !== this.selectedQuestionId
+      if (hasPersonal) {
+        const localTapInFlight =
+          !isNewQuestion &&
+          this.state.status === "question_open" &&
+          (this.answerInFlight || this.pendingAnswer)
+
+        if (!localTapInFlight) {
+          this.selectedQuestionId = nextQuestionId
+          this.selectedOptionId = nextState.selected_option_id ?? null
+          this.confirmedOptionId = this.selectedOptionId
+        }
+      } else if (isNewQuestion) {
+        this.selectedQuestionId = nextQuestionId
+        this.selectedOptionId = null
+        this.confirmedOptionId = null
+        this.pendingAnswer = null
+        this.clearRetryTimer()
+      }
+
+      const sameOpenQuestion =
+        this.renderedStatus === "question_open" &&
+        this.renderedQuestionId === nextQuestionId
+
+      this.state = { ...nextState, player_name: playerName }
+
+      if (sameOpenQuestion) {
+        this.updateOpenOptionSelection()
+      } else {
+        this.render()
+      }
+      return
+    }
+
+    if (nextState.status === "question_closed") {
+      this.pendingAnswer = null
+      this.clearRetryTimer()
+
+      if (hasPersonal) {
+        this.selectedQuestionId = nextQuestionId
+        this.selectedOptionId = nextState.selected_option_id ?? null
+        this.confirmedOptionId = this.selectedOptionId
+        this.state = {
+          ...nextState,
+          player_name: playerName,
+          outcome: nextState.outcome || this.computeOutcome(nextState.question, this.selectedOptionId)
+        }
+        this.render()
+        return
+      }
+
+      if (this.answerInFlight) {
+        this.reconcileAfterFlight = true
+        this.state = { ...nextState, player_name: playerName }
+        this.bodyTarget.querySelectorAll("button.play-option").forEach((btn) => { btn.disabled = true })
+        return
+      }
+
+      if (nextQuestionId !== this.selectedQuestionId) {
+        this.state = { ...nextState, player_name: playerName }
+        this.fetchState(false)
+        return
+      }
+
+      this.state = {
+        ...nextState,
+        player_name: playerName,
+        selected_option_id: this.selectedOptionId,
+        outcome: this.computeOutcome(nextState.question, this.selectedOptionId)
+      }
+      this.render()
+    }
+  }
+
+  pickOption(event) {
+    const button = event.currentTarget
+    if (this.state.status !== "question_open" || !this.state.question) return
+
+    const questionId = Number(button.dataset.questionId)
+    const optionId = Number(button.dataset.optionId)
+    if (questionId !== this.state.question.id) return
+
+    this.selectedQuestionId = questionId
+    this.selectedOptionId = optionId
+    this.updateOpenOptionSelection()
+
+    this.pendingAnswer = { questionId, optionId }
+    this.retryAttempts = 0
+    this.clearRetryTimer()
+    this.flushPendingAnswer()
+  }
+
+  async flushPendingAnswer() {
+    if (this.answerInFlight || !this.pendingAnswer) return
+
+    const toSend = this.pendingAnswer
+    this.pendingAnswer = null
+
+    if (
+      this.state.status !== "question_open" ||
+      !this.state.question ||
+      this.state.question.id !== toSend.questionId
+    ) {
+      return
+    }
+
+    this.answerInFlight = true
+    let needReconcile = false
+
+    try {
+      const response = await fetch(this.answerUrlValue, {
+        method: "POST",
+        headers: {
+          Accept: "application/json",
+          "Content-Type": "application/json",
+          "X-CSRF-Token": this.csrfToken()
+        },
+        credentials: "same-origin",
+        body: JSON.stringify({
+          game_question_id: toSend.questionId,
+          game_option_id: toSend.optionId
+        })
+      })
+
+      if (response.ok) {
+        this.confirmedOptionId = toSend.optionId
+        this.retryAttempts = 0
+        if (this.reconcileAfterFlight) {
+          needReconcile = true
+        }
+      } else if (response.status === 409) {
+        const data = await response.json()
+        this.pendingAnswer = null
+        this.reconcileAfterFlight = false
+        this.applyState(data, { authoritative: true })
+      } else if (response.status >= 500) {
+        this.scheduleAnswerRetry(toSend)
+      }
+    } catch (_error) {
+      this.scheduleAnswerRetry(toSend)
+    } finally {
+      this.answerInFlight = false
+      if (needReconcile || this.reconcileAfterFlight) {
+        this.reconcileAfterFlight = false
+        this.fetchState(false)
+      } else if (this.pendingAnswer) {
+        this.flushPendingAnswer()
+      }
+    }
+  }
+
+  scheduleAnswerRetry(toSend) {
+    if (this.pendingAnswer) return
+    if (this.state.status !== "question_open") {
+      if (this.reconcileAfterFlight) {
+        this.reconcileAfterFlight = false
+        this.fetchState(false)
+      }
+      return
+    }
+    if (this.retryAttempts >= 4) return
+
+    const delays = [400, 1000, 2000, 3000]
+    const delay = delays[this.retryAttempts] ?? 3000
+    this.retryAttempts += 1
+    this.pendingAnswer = toSend
+
+    this.clearRetryTimer()
+    this.retryTimer = window.setTimeout(() => {
+      this.retryTimer = null
+      this.flushPendingAnswer()
+    }, delay)
+  }
+
+  computeOutcome(question, selectedOptionId) {
+    if (selectedOptionId == null) return "none"
+    const picked = question && question.options
+      ? question.options.find((opt) => opt.id === selectedOptionId)
+      : null
+    if (!picked) return "none"
+    return picked.correct ? "correct" : "wrong"
+  }
+
+  updateOpenOptionSelection() {
+    const buttons = this.bodyTarget.querySelectorAll("button.play-option")
+    buttons.forEach((button) => {
+      const optId = Number(button.dataset.optionId)
+      const isPicked = optId === this.selectedOptionId
+      button.classList.toggle("is-picked", isPicked)
+      button.setAttribute("aria-pressed", isPicked ? "true" : "false")
+      const mark = button.querySelector(".play-option__mark")
+      if (mark) {
+        mark.textContent = isPicked ? "Your answer" : ""
+      }
+    })
+  }
+
+  render() {
+    this.bodyTarget.textContent = ""
+    const topAligned = this.state.status === "question_open" || this.state.status === "question_closed"
+    this.bodyTarget.classList.toggle("play__body--top", topAligned)
+
+    if (this.state.status === "lobby") {
+      this.renderLobby()
+    } else if (this.state.status === "question_open") {
+      this.renderOpenQuestion()
+    } else if (this.state.status === "question_closed") {
+      this.renderClosedQuestion()
+    } else if (this.state.status === "ended") {
+      this.renderEnded()
+    }
+
+    this.renderedStatus = this.state.status
+    this.renderedQuestionId = this.state.question ? this.state.question.id : null
+    this.renderedEndedSignature = this.endedSignature(this.state)
+  }
+
+  renderLobby() {
+    const waiting = document.createElement("div")
+    waiting.className = "waiting"
+
+    const gem = document.createElement("div")
+    gem.className = "waiting__gem"
+    gem.setAttribute("aria-hidden", "true")
+    gem.textContent = "?"
+    waiting.appendChild(gem)
+
+    const heading = document.createElement("h1")
+    heading.className = "play-title"
+    heading.textContent = `Hi, ${this.state.player_name}!`
+    waiting.appendChild(heading)
+
+    const lead = document.createElement("p")
+    lead.className = "play-lead"
+    lead.textContent = "Waiting for the quiz to start…"
+    waiting.appendChild(lead)
+
+    this.bodyTarget.appendChild(waiting)
+  }
+
+  renderOpenQuestion() {
+    const num = document.createElement("div")
+    num.className = "play-question__num"
+    num.textContent = `Question ${this.state.question_number} of ${this.state.total_questions}`
+    this.bodyTarget.appendChild(num)
+
+    const body = document.createElement("div")
+    body.className = "play-question__body"
+    body.textContent = this.state.question.body
+    this.bodyTarget.appendChild(body)
+
+    const list = document.createElement("div")
+    list.className = "play-options"
+
+    this.state.question.options.forEach((opt, idx) => {
+      const picked = opt.id === this.selectedOptionId
+
+      const button = document.createElement("button")
+      button.type = "button"
+      button.className = picked ? "play-option is-picked" : "play-option"
+      button.setAttribute("aria-pressed", picked ? "true" : "false")
+      button.dataset.action = "click->player-game#pickOption"
+      button.dataset.questionId = String(this.state.question.id)
+      button.dataset.optionId = String(opt.id)
+
+      const letter = document.createElement("span")
+      letter.className = "play-option__letter"
+      letter.setAttribute("aria-hidden", "true")
+      letter.textContent = this.optionLetter(idx)
+      button.appendChild(letter)
+
+      const title = document.createElement("span")
+      title.className = "play-option__title"
+      title.textContent = opt.body
+      button.appendChild(title)
+
+      const mark = document.createElement("span")
+      mark.className = "play-option__mark"
+      mark.textContent = picked ? "Your answer" : ""
+      button.appendChild(mark)
+
+      list.appendChild(button)
+    })
+
+    this.bodyTarget.appendChild(list)
+  }
+
+  renderClosedQuestion() {
+    const num = document.createElement("div")
+    num.className = "play-question__num"
+    num.textContent = `Question ${this.state.question_number} of ${this.state.total_questions}`
+    this.bodyTarget.appendChild(num)
+
+    const body = document.createElement("div")
+    body.className = "play-question__body"
+    body.textContent = this.state.question.body
+    this.bodyTarget.appendChild(body)
+
+    const list = document.createElement("div")
+    list.className = "play-options is-locked is-revealed"
+
+    this.state.question.options.forEach((opt, idx) => {
+      const picked = opt.id === this.selectedOptionId
+
+      const button = document.createElement("button")
+      button.type = "button"
+      button.disabled = true
+      button.className = "play-option"
+      if (picked) button.classList.add("is-picked")
+      if (opt.correct) button.classList.add("is-correct")
+
+      const letter = document.createElement("span")
+      letter.className = "play-option__letter"
+      letter.setAttribute("aria-hidden", "true")
+      letter.textContent = this.optionLetter(idx)
+      button.appendChild(letter)
+
+      const title = document.createElement("span")
+      title.className = "play-option__title"
+      title.textContent = opt.body
+      button.appendChild(title)
+
+      const mark = document.createElement("span")
+      mark.className = "play-option__mark"
+      mark.textContent = picked ? "Your answer" : ""
+      button.appendChild(mark)
+
+      list.appendChild(button)
+    })
+
+    this.bodyTarget.appendChild(list)
+
+    const outcome = this.state.outcome || this.computeOutcome(this.state.question, this.selectedOptionId)
+    const status = document.createElement("div")
+    status.setAttribute("role", "status")
+    if (outcome === "correct") {
+      status.className = "play-status play-status--right"
+      status.textContent = "Correct!"
+    } else if (outcome === "wrong") {
+      status.className = "play-status play-status--wrong"
+      status.textContent = "Wrong!"
+    } else {
+      status.className = "play-status play-status--neutral"
+      status.textContent = "No answer"
+    }
+    this.bodyTarget.appendChild(status)
+  }
+
+  renderEnded() {
+    if (typeof this.state.place === "number") {
+      const card = document.createElement("div")
+      card.className = "result-card"
+
+      const over = document.createElement("p")
+      over.className = "play-lead"
+      over.textContent = "The quiz is over"
+      card.appendChild(over)
+
+      const placeBig = document.createElement("div")
+      placeBig.className = "result-card__place"
+      placeBig.setAttribute("aria-hidden", "true")
+      placeBig.textContent = String(this.state.place)
+      card.appendChild(placeBig)
+
+      const placeLabel = document.createElement("h1")
+      placeLabel.className = "result-card__label"
+      placeLabel.textContent = `Place ${this.state.place} of ${this.state.total_players}`
+      card.appendChild(placeLabel)
+
+      const score = document.createElement("div")
+      score.className = "result-card__score"
+      score.textContent = this.pointsLabel(this.state.points ?? 0)
+      card.appendChild(score)
+
+      if (this.state.winner) {
+        const banner = document.createElement("div")
+        banner.className = "winner-banner"
+        banner.setAttribute("role", "status")
+        banner.textContent = "You won!"
+        card.appendChild(banner)
+      }
+
+      this.bodyTarget.appendChild(card)
+      return
+    }
+
+    const waiting = document.createElement("div")
+    waiting.className = "waiting"
+
+    const heading = document.createElement("h1")
+    heading.className = "play-title"
+    heading.textContent = "The quiz is over"
+    waiting.appendChild(heading)
+
+    this.bodyTarget.appendChild(waiting)
+  }
+
+  pointsLabel(points) {
+    const count = Number(points) || 0
+    return count === 1 ? "1 point" : `${count} points`
+  }
+
+  optionLetter(index) {
+    if (index < 26) {
+      return String.fromCharCode(65 + index)
+    }
+    const first = String.fromCharCode(65 + Math.floor(index / 26) - 1)
+    const second = String.fromCharCode(65 + (index % 26))
+    return `${first}${second}`
+  }
+
+  csrfToken() {
+    const meta = document.querySelector('meta[name="csrf-token"]')
+    return meta ? meta.getAttribute("content") : ""
+  }
+}
diff --git a/app/javascript/controllers/preview_controller.js b/app/javascript/controllers/preview_controller.js
new file mode 100644
index 0000000..e770ead
--- /dev/null
+++ b/app/javascript/controllers/preview_controller.js
@@ -0,0 +1,201 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["stage"]
+  static values = {
+    questions: Array,
+    backUrl: String
+  }
+
+  connect() {
+    this.currentIndex = 0
+    this.score = 0
+    this.answered = false
+    this.render()
+  }
+
+  pick(event) {
+    if (this.answered) return
+    this.answered = true
+
+    const pickedIndex = Number(event.currentTarget.dataset.optionIndex)
+    const question = this.questionsValue[this.currentIndex]
+    const pickedOption = question.options[pickedIndex]
+    const isCorrect = Boolean(pickedOption.correct)
+
+    if (isCorrect) {
+      this.score += 1
+    }
+
+    const optionsEl = this.stageTarget.querySelector(".play-options")
+    optionsEl.classList.add("is-locked", "is-revealed")
+
+    const buttons = optionsEl.querySelectorAll(".play-option")
+    buttons.forEach((button, index) => {
+      button.disabled = true
+      if (index === pickedIndex) {
+        button.classList.add("is-picked")
+      }
+      if (question.options[index].correct) {
+        button.classList.add("is-correct")
+        button.dataset.correct = "true"
+        const mark = button.querySelector(".play-option__mark")
+        if (mark) mark.textContent = "✓ Correct"
+      }
+    })
+
+    const feedback = document.createElement("div")
+    feedback.setAttribute("role", "status")
+    feedback.className = isCorrect
+      ? "play-status play-status--right"
+      : "play-status play-status--wrong"
+    feedback.textContent = isCorrect ? "Correct!" : "Wrong!"
+    this.stageTarget.appendChild(feedback)
+
+    const actions = document.createElement("div")
+    actions.className = "preview-actions"
+
+    const nextButton = document.createElement("button")
+    nextButton.type = "button"
+    nextButton.className = "btn btn--pink"
+    nextButton.dataset.action = "preview#next"
+    const isLast = this.currentIndex === this.questionsValue.length - 1
+    nextButton.textContent = isLast ? "See score" : "Next question"
+    actions.appendChild(nextButton)
+
+    this.stageTarget.appendChild(actions)
+  }
+
+  next() {
+    this.currentIndex += 1
+    this.answered = false
+    this.render()
+  }
+
+  startOver() {
+    this.currentIndex = 0
+    this.score = 0
+    this.answered = false
+    this.render()
+  }
+
+  render() {
+    this.stageTarget.textContent = ""
+    const questions = this.questionsValue || []
+
+    if (questions.length === 0) {
+      this.renderEmpty()
+      return
+    }
+
+    if (this.currentIndex >= questions.length) {
+      this.renderScore(questions.length)
+      return
+    }
+
+    this.renderQuestion(questions[this.currentIndex], this.currentIndex, questions.length)
+  }
+
+  renderEmpty() {
+    const empty = document.createElement("div")
+    empty.className = "empty"
+    empty.textContent = "No active questions to preview."
+    this.stageTarget.appendChild(empty)
+
+    const actions = document.createElement("div")
+    actions.className = "preview-actions"
+
+    const backLink = document.createElement("a")
+    backLink.className = "btn"
+    backLink.href = this.backUrlValue
+    backLink.textContent = "Back to quiz"
+    actions.appendChild(backLink)
+
+    this.stageTarget.appendChild(actions)
+  }
+
+  renderQuestion(question, index, total) {
+    const progress = document.createElement("div")
+    progress.className = "play-question__num"
+    progress.textContent = `Question ${index + 1} of ${total}`
+    this.stageTarget.appendChild(progress)
+
+    const body = document.createElement("div")
+    body.className = "play-question__body"
+    body.textContent = question.body
+    this.stageTarget.appendChild(body)
+
+    const optionsList = document.createElement("div")
+    optionsList.className = "play-options"
+
+    question.options.forEach((option, optionIndex) => {
+      const button = document.createElement("button")
+      button.type = "button"
+      button.className = "play-option"
+      button.dataset.optionIndex = String(optionIndex)
+      button.dataset.action = "preview#pick"
+
+      const letter = document.createElement("span")
+      letter.className = "play-option__letter"
+      letter.setAttribute("aria-hidden", "true")
+      letter.textContent = this.optionLetter(optionIndex)
+
+      const title = document.createElement("span")
+      title.className = "play-option__title"
+      title.textContent = option.body
+
+      const mark = document.createElement("span")
+      mark.className = "play-option__mark"
+
+      button.appendChild(letter)
+      button.appendChild(title)
+      button.appendChild(mark)
+      optionsList.appendChild(button)
+    })
+
+    this.stageTarget.appendChild(optionsList)
+  }
+
+  renderScore(total) {
+    const card = document.createElement("div")
+    card.className = "result-card"
+
+    const place = document.createElement("div")
+    place.className = "result-card__place"
+    place.textContent = `${this.score}/${total}`
+    card.appendChild(place)
+
+    const scoreLine = document.createElement("div")
+    scoreLine.className = "result-card__score mt-2"
+    scoreLine.textContent = `Score: ${this.score}/${total}`
+    card.appendChild(scoreLine)
+
+    const actions = document.createElement("div")
+    actions.className = "preview-actions"
+
+    const restartBtn = document.createElement("button")
+    restartBtn.type = "button"
+    restartBtn.className = "btn btn--pink"
+    restartBtn.dataset.action = "preview#startOver"
+    restartBtn.textContent = "Start over"
+    actions.appendChild(restartBtn)
+
+    const backLink = document.createElement("a")
+    backLink.className = "btn btn--ghost"
+    backLink.href = this.backUrlValue
+    backLink.textContent = "Back to quiz"
+    actions.appendChild(backLink)
+
+    card.appendChild(actions)
+    this.stageTarget.appendChild(card)
+  }
+
+  optionLetter(index) {
+    if (index < 26) {
+      return String.fromCharCode(65 + index)
+    }
+    const first = String.fromCharCode(65 + Math.floor(index / 26) - 1)
+    const second = String.fromCharCode(65 + (index % 26))
+    return `${first}${second}`
+  }
+}
