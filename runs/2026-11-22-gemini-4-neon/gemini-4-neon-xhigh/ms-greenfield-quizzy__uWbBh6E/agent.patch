+require "digest"
+
+module Moderate
+  class BaseController < ApplicationController
+    before_action :authenticate_moderator
+
+    layout "moderate"
+
+    private
+
+    def authenticate_moderator
+      expected_user = ENV["QUIZZY_MODERATOR_USERNAME"].to_s
+      expected_pass = ENV["QUIZZY_MODERATOR_PASSWORD"].to_s
+
+      authenticate_or_request_with_http_basic("Quizzy Moderator") do |username, password|
+        next false if expected_user.empty? || expected_pass.empty?
+
+        user_match = ActiveSupport::SecurityUtils.secure_compare(
+          Digest::SHA256.hexdigest(username.to_s),
+          Digest::SHA256.hexdigest(expected_user)
+        )
+        pass_match = ActiveSupport::SecurityUtils.secure_compare(
+          Digest::SHA256.hexdigest(password.to_s),
+          Digest::SHA256.hexdigest(expected_pass)
+        )
+        user_match && pass_match
+      end
+    end
+  end
+end
