@@ -0,0 +1,37 @@
+ENV["RAILS_ENV"] ||= "test"
+ENV["QUIZZY_MODERATOR_USERNAME"] ||= "moderator"
+ENV["QUIZZY_MODERATOR_PASSWORD"] ||= "secret-pass"
+
+require_relative "../config/environment"
+require "rails/test_help"
+
+module ActiveSupport
+  class TestCase
+    fixtures :all
+
+    setup do
+      GamePresence.reset!
+      GameTimer.reset!
+    end
+
+    teardown do
+      GamePresence.reset!
+      GameTimer.reset!
+    end
+
+    def basic_auth_headers(username = ENV["QUIZZY_MODERATOR_USERNAME"], password = ENV["QUIZZY_MODERATOR_PASSWORD"])
+      { "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials(username, password) }
+    end
+
+    def with_moderator_credentials(username, password)
+      old_user = ENV["QUIZZY_MODERATOR_USERNAME"]
+      old_pass = ENV["QUIZZY_MODERATOR_PASSWORD"]
+      ENV["QUIZZY_MODERATOR_USERNAME"] = username
+      ENV["QUIZZY_MODERATOR_PASSWORD"] = password
+      yield
+    ensure
+      ENV["QUIZZY_MODERATOR_USERNAME"] = old_user
+      ENV["QUIZZY_MODERATOR_PASSWORD"] = old_pass
+    end
+  end
+end
