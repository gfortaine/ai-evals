@@ -0,0 +1,26 @@
+class Answer < ApplicationRecord
+  belongs_to :game
+  belongs_to :player
+  belongs_to :game_question
+  belongs_to :game_option
+
+  validates :answered_at, presence: true
+  validates :player_id, uniqueness: { scope: :game_question_id }
+  validate :associations_match_game
+
+  private
+
+  def associations_match_game
+    if player && player.game_id != game_id
+      errors.add(:player, "must belong to the game")
+    end
+
+    if game_question && game_question.game_id != game_id
+      errors.add(:game_question, "must belong to the game")
+    end
+
+    if game_option && game_question && game_option.game_question_id != game_question.id
+      errors.add(:game_option, "must belong to the question")
+    end
+  end
+end
