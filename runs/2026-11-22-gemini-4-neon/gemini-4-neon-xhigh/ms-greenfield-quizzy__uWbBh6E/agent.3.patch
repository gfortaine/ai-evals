diff --git a/app/views/plays/show.html.erb b/app/views/plays/show.html.erb
new file mode 100644
index 0000000..9fba5fe
--- /dev/null
+++ b/app/views/plays/show.html.erb
@@ -0,0 +1,77 @@
+<% content_for :title, "#{@game.quiz.title} · Quizzy" %>
+<% content_for :head do %>
+  <meta name="turbo-cache-control" content="no-cache">
+<% end %>
+
+<div class="play"
+     data-controller="player-game"
+     data-player-game-code-value="<%= @game.code %>"
+     data-player-game-stream-token-value="<%= @player_stream_token %>"
+     data-player-game-state-url-value="<%= state_play_path(@game.code) %>"
+     data-player-game-answer-url-value="<%= answer_play_path(@game.code) %>"
+     data-player-game-initial-state-value="<%= @state.to_json %>">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+    <span><%= @player.name %></span>
+  </div>
+
+  <div class="play__body <%= 'play__body--top' if @state[:status] == 'question_open' || @state[:status] == 'question_closed' %>"
+       data-player-game-target="body">
+    <% case @state[:status] %>
+    <% when "lobby" %>
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+        <p class="play-lead">Waiting for the quiz to start…</p>
+      </div>
+
+    <% when "question_open" %>
+      <div class="play-question__num">Question <%= @state[:question_number] %> of <%= @state[:total_questions] %></div>
+      <div class="play-question__body"><%= @state[:question][:body] %></div>
+      <div class="play-options">
+        <% @state[:question][:options].each_with_index do |opt, idx| %>
+          <% picked = (@state[:selected_option_id] == opt[:id]) %>
+          <button type="button"
+                  class="play-option <%= 'is-picked' if picked %>"
+                  aria-pressed="<%= picked ? 'true' : 'false' %>"
+                  data-action="click->player-game#pickOption"
+                  data-question-id="<%= @state[:question][:id] %>"
+                  data-option-id="<%= opt[:id] %>">
+            <span class="play-option__letter" aria-hidden="true"><%= option_letter(idx) %></span>
+            <span class="play-option__title"><%= opt[:body] %></span>
+            <span class="play-option__mark"><%= "Your answer" if picked %></span>
+          </button>
+        <% end %>
+      </div>
+
+    <% when "question_closed" %>
+      <div class="play-question__num">Question <%= @state[:question_number] %> of <%= @state[:total_questions] %></div>
+      <div class="play-question__body"><%= @state[:question][:body] %></div>
+      <div class="play-options is-locked is-revealed">
+        <% @state[:question][:options].each_with_index do |opt, idx| %>
+          <% picked = (@state[:selected_option_id] == opt[:id]) %>
+          <button type="button"
+                  class="play-option <%= 'is-picked' if picked %> <%= 'is-correct' if opt[:correct] %>"
+                  disabled>
+            <span class="play-option__letter" aria-hidden="true"><%= option_letter(idx) %></span>
+            <span class="play-option__title"><%= opt[:body] %></span>
+            <span class="play-option__mark"><%= "Your answer" if picked %></span>
+          </button>
+        <% end %>
+      </div>
+      <%
+        status_class, status_text = case @state[:outcome]
+        when "correct" then [ "play-status--right", "Correct!" ]
+        when "wrong"   then [ "play-status--wrong", "Wrong!" ]
+        else                [ "play-status--neutral", "No answer" ]
+        end
+      %>
+      <div class="play-status <%= status_class %>" role="status"><%= status_text %></div>
+
+    <% when "ended" %>
+      <div class="waiting">
+        <h1 class="play-title">The quiz is over</h1>
+      </div>
+    <% end %>
+  </div>
+</div>
