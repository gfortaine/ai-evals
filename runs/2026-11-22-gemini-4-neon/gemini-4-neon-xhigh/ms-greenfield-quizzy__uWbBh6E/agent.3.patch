index 0000000..f1a1a6d
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,63 @@
+module Moderate
+  class GamesController < BaseController
+    layout "application"
+
+    before_action :set_game, only: %i[show state start finish next end_game]
+    before_action :disable_caching, only: %i[show state]
+
+    def create
+      @quiz = Quiz.find(params[:quiz_id])
+      game = Game.start_for_quiz!(@quiz)
+      redirect_to moderate_game_path(game), status: :see_other
+    rescue Game::NoActiveQuestionsError => e
+      redirect_to moderate_quiz_path(@quiz), alert: e.message, status: :see_other
+    end
+
+    def show
+      @join_url = play_url(@game.code)
+      @stream_token = @game.signed_id(purpose: :moderator_stream, expires_in: 24.hours)
+      @state = @game.moderator_state(join_url: @join_url)
+    end
+
+    def state
+      render json: @game.moderator_state(join_url: play_url(@game.code))
+    end
+
+    def start
+      @game.start!(expected_version: params[:expected_version])
+      respond_with_game_state
+    end
+
+    def finish
+      @game.finish!(expected_version: params[:expected_version])
+      respond_with_game_state
+    end
+
+    def next
+      @game.next_question!(expected_version: params[:expected_version])
+      respond_with_game_state
+    end
+
+    def end_game
+      @game.end_game!(expected_version: params[:expected_version])
+      respond_with_game_state
+    end
+
+    private
+
+    def set_game
+      @game = Game.find(params[:id])
+    end
+
+    def disable_caching
+      response.headers["Cache-Control"] = "no-store"
+    end
+
+    def respond_with_game_state
+      respond_to do |format|
+        format.json { render json: @game.reload.moderator_state(join_url: play_url(@game.code)) }
+        format.html { redirect_to moderate_game_path(@game), status: :see_other }
+      end
+    end
+  end
+end
diff --git a/app/controllers/plays_controller.rb b/app/controllers/plays_controller.rb
new file mode 100644
index 0000000..bdf80c6
--- /dev/null
+++ b/app/controllers/plays_controller.rb
@@ -0,0 +1,123 @@
+class PlaysController < ApplicationController
+  CLIENT_TOKEN_COOKIE = :quizzy_client_token
+
+  before_action :set_game
+  before_action :disable_caching
+
+  def show
+    @player = current_player_for(@game)
+
+    if @player
+      @state = @game.player_state_for(@player)
+      @player_stream_token = @player.signed_id(purpose: :player_stream, expires_in: 24.hours)
+      render :show
+    elsif @game.ended?
+      render :ended
+    else
+      @player = @game.players.build
+      render :join
+    end
+  end
+
+  def join
+    if @game.ended?
+      return render :ended, status: :unprocessable_entity
+    end
+
+    if current_player_for(@game)
+      return redirect_to play_path(@game.code), status: :see_other
+    end
+
+    token = ensure_client_token
+    @player = @game.players.build(name: params.dig(:player, :name), client_token: token)
+
+    if @game.reload.ended?
+      return render :ended, status: :unprocessable_entity
+    end
+
+    if @player.save
+      redirect_to play_path(@game.code), status: :see_other
+    else
+      render :join, status: :unprocessable_entity
+    end
+  rescue ActiveRecord::RecordNotUnique
+    redirect_to play_path(@game.code), status: :see_other
+  end
+
+  def answer
+    @player = current_player_for(@game)
+    unless @player
+      return respond_to do |format|
+        format.json { render json: { error: "Join the game first" }, status: :unauthorized }
+        format.html { redirect_to play_path(@game.code), status: :see_other }
+      end
+    end
+
+    result = @game.record_answer!(
+      player: @player,
+      game_question_id: params[:game_question_id],
+      game_option_id: params[:game_option_id]
+    )
+
+    if result[:ok]
+      respond_to do |format|
+        format.json { render json: result, status: :ok }
+        format.html { redirect_to play_path(@game.code), status: :see_other }
+      end
+    else
+      respond_to do |format|
+        format.json { render json: result[:state], status: :conflict }
+        format.html { redirect_to play_path(@game.code), status: :see_other }
+      end
+    end
+  end
+
+  def state
+    @player = current_player_for(@game)
+
+    if @player
+      if params[:fallback] == "1"
+        changed, _count = GamePresence.touch_http(@game.id, @player.id)
+        @game.broadcast_moderator_counts! if changed
+      end
+      render json: @game.player_state_for(@player)
+    else
+      render json: @game.public_state
+    end
+  end
+
+  private
+
+  def set_game
+    @game = Game.find_by!(code: params[:code].to_s.upcase)
+  end
+
+  def disable_caching
+    response.headers["Cache-Control"] = "no-store"
+  end
+
+  def current_client_token
+    cookies.signed[CLIENT_TOKEN_COOKIE].presence
+  end
+
+  def ensure_client_token
+    existing = current_client_token
+    return existing if existing
+
+    token = SecureRandom.hex(24)
+    cookies.signed[CLIENT_TOKEN_COOKIE] = {
+      value: token,
+      httponly: true,
+      same_site: :lax,
+      expires: 1.year.from_now
+    }
+    token
+  end
+
+  def current_player_for(game)
+    token = current_client_token
+    return nil unless token
+
+    game.players.find_by(client_token: token)
+  end
+end
diff --git a/app/helpers/qr_helper.rb b/app/helpers/qr_helper.rb
new file mode 100644
index 0000000..703cb9d
--- /dev/null
+++ b/app/helpers/qr_helper.rb
@@ -0,0 +1,31 @@
+require "rqrcode"
+
+module QrHelper
+  def qr_code_svg(url, aria_label: "QR code to join the quiz")
+    qr = RQRCode::QRCode.new(url.to_s, level: :m)
+    module_size = 8
+    quiet_zone = module_size * 4
+    dimension = (qr.modules.size * module_size) + (quiet_zone * 2)
+
+    inner = qr.as_svg(
+      color: "000000",
+      fill: "ffffff",
+      module_size: module_size,
+      offset: quiet_zone,
+      standalone: false,
+      use_path: true
+    )
+
+    content_tag(
+      :svg,
+      inner.html_safe,
+      xmlns: "http://www.w3.org/2000/svg",
+      viewBox: "0 0 #{dimension} #{dimension}",
+      width: dimension,
+      height: dimension,
+      "shape-rendering": "crispEdges",
+      role: "img",
+      "aria-label": aria_label
+    )
+  end
+end
diff --git a/app/javascript/controllers/moderator_game_controller.js b/app/javascript/controllers/moderator_game_controller.js
new file mode 100644
index 0000000..7fb4ddf
--- /dev/null
+++ b/app/javascript/controllers/moderator_game_controller.js
@@ -0,0 +1,444 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["body", "controls", "playersCount", "answersCount", "activePlayersCount"]
+  static values = {
+    streamToken: String,
+    stateUrl: String,
+    startUrl: String,
+    finishUrl: String,
+    nextUrl: String,
+    endUrl: String,
+    backUrl: String,
+    initialState: Object
+  }
+
+  connect() {
+    this.state = { ...this.initialStateValue }
+    this.submitting = false
+    this.wsConnected = false
+    this.tearingDown = false
+    this.pollTimer = null
+    this.reconnectTimer = null
+    this.reconnectAttempts = 0
+    this.renderedStatus = this.state.status
+    this.renderedQuestionId = this.state.question ? this.state.question.id : null
+
+    this.onOnline = () => {
+      this.reconnectAttempts = 0
+      if (this.consumer && !this.wsConnected) {
+        this.consumer.connection.open()
+      }
+      this.fetchState()
+    }
+    this.onVisibilityChange = () => {
+      if (document.visibilityState === "visible") {
+        if (this.consumer && !this.wsConnected) {
+          this.consumer.connection.open()
+        }
+        this.fetchState()
+      }
+    }
+
+    window.addEventListener("online", this.onOnline)
+    document.addEventListener("visibilitychange", this.onVisibilityChange)
+
+    this.connectCable()
+  }
+
+  disconnect() {
+    this.tearingDown = true
+    this.stopPolling()
+    this.clearReconnectTimer()
+    window.removeEventListener("online", this.onOnline)
+    document.removeEventListener("visibilitychange", this.onVisibilityChange)
+
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  connectCable() {
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      { channel: "GameModeratorChannel", token: this.streamTokenValue },
+      {
+        connected: () => {
+          this.wsConnected = true
+          this.reconnectAttempts = 0
+          this.stopPolling()
+          this.clearReconnectTimer()
+        },
+        disconnected: () => {
+          this.wsConnected = false
+          if (this.tearingDown) return
+          this.startPolling()
+          this.scheduleReconnect()
+        },
+        rejected: () => {
+          this.wsConnected = false
+          if (!this.tearingDown) this.startPolling()
+        },
+        received: (data) => {
+          this.handleMessage(data)
+        }
+      }
+    )
+  }
+
+  scheduleReconnect() {
+    if (this.tearingDown || this.wsConnected || this.reconnectTimer) return
+    const base = Math.min(500 * Math.pow(1.6, this.reconnectAttempts), 5000)
+    const delay = Math.round(base + Math.random() * 400)
+    this.reconnectAttempts += 1
+    this.reconnectTimer = window.setTimeout(() => {
+      this.reconnectTimer = null
+      if (!this.tearingDown && !this.wsConnected && this.consumer) {
+        this.consumer.connection.open()
+      }
+    }, delay)
+  }
+
+  clearReconnectTimer() {
+    if (this.reconnectTimer) {
+      window.clearTimeout(this.reconnectTimer)
+      this.reconnectTimer = null
+    }
+  }
+
+  startPolling() {
+    if (this.pollTimer) return
+    this.pollTimer = window.setInterval(() => {
+      if (!this.wsConnected) {
+        this.fetchState()
+      }
+    }, 1200)
+  }
+
+  stopPolling() {
+    if (this.pollTimer) {
+      window.clearInterval(this.pollTimer)
+      this.pollTimer = null
+    }
+  }
+
+  async fetchState() {
+    try {
+      const response = await fetch(this.stateUrlValue, {
+        headers: { Accept: "application/json" },
+        credentials: "same-origin",
+        cache: "no-store"
+      })
+      if (!response.ok) return
+      const data = await response.json()
+      this.applyState(data)
+    } catch (_error) {
+      // Network hiccup; next reconnect or poll will retry.
+    }
+  }
+
+  handleMessage(data) {
+    if (!data || typeof data !== "object") return
+
+    if (data.type === "counts") {
+      if (typeof data.state_version === "number" && data.state_version < this.state.state_version) {
+        return
+      }
+      this.state.active_players_count = data.active_players_count
+      this.state.answers_count = data.answers_count
+      this.updateCounters()
+      return
+    }
+
+    if (data.type === "state") {
+      this.applyState(data)
+    }
+  }
+
+  applyState(nextState) {
+    if (!nextState || typeof nextState !== "object") return
+
+    const nextVersion = Number(nextState.state_version ?? 0)
+    const currentVersion = Number(this.state.state_version ?? 0)
+    if (nextVersion < currentVersion) return
+
+    const joinUrl = nextState.join_url || this.state.join_url
+    const sameScreen =
+      nextState.status === this.renderedStatus &&
+      (nextState.question ? nextState.question.id : null) === this.renderedQuestionId
+
+    this.state = { ...nextState, join_url: joinUrl }
+
+    if (sameScreen) {
+      this.updateCounters()
+      return
+    }
+
+    this.render()
+  }
+
+  updateCounters() {
+    const active = String(this.state.active_players_count ?? 0)
+    const answers = String(this.state.answers_count ?? 0)
+
+    if (this.hasPlayersCountTarget) {
+      this.playersCountTarget.textContent = active
+    }
+    if (this.hasAnswersCountTarget) {
+      this.answersCountTarget.textContent = answers
+    }
+    if (this.hasActivePlayersCountTarget) {
+      this.activePlayersCountTarget.textContent = active
+    }
+  }
+
+  start(event) {
+    this.submitTransition(event, this.startUrlValue)
+  }
+
+  finish(event) {
+    this.submitTransition(event, this.finishUrlValue)
+  }
+
+  next(event) {
+    this.submitTransition(event, this.nextUrlValue)
+  }
+
+  endGame(event) {
+    this.submitTransition(event, this.endUrlValue)
+  }
+
+  async submitTransition(event, url) {
+    if (event) event.preventDefault()
+    if (this.submitting) return
+
+    this.submitting = true
+    const actionButton = this.controlsTarget.querySelector("button")
+    if (actionButton) actionButton.disabled = true
+
+    try {
+      const response = await fetch(url, {
+        method: "POST",
+        headers: {
+          Accept: "application/json",
+          "Content-Type": "application/json",
+          "X-CSRF-Token": this.csrfToken()
+        },
+        credentials: "same-origin",
+        body: JSON.stringify({ expected_version: this.state.state_version })
+      })
+
+      if (response.ok) {
+        const data = await response.json()
+        this.applyState(data)
+      } else {
+        await this.fetchState()
+      }
+    } catch (_error) {
+      if (actionButton && actionButton.isConnected) {
+        actionButton.disabled = false
+      }
+    } finally {
+      this.submitting = false
+      const currentButton = this.controlsTarget.querySelector("button")
+      if (currentButton) currentButton.disabled = false
+    }
+  }
+
+  render() {
+    this.updateCoverClasses()
+    this.renderBody()
+    this.renderControls()
+    this.renderedStatus = this.state.status
+    this.renderedQuestionId = this.state.question ? this.state.question.id : null
+  }
+
+  updateCoverClasses() {
+    this.element.classList.remove("cover--blue", "cover--calm", "cover--night")
+    if (this.state.status === "ended") {
+      this.element.classList.add("cover--night")
+    } else if (this.state.status === "question_open" || this.state.status === "question_closed") {
+      this.element.classList.add("cover--blue", "cover--calm")
+    }
+  }
+
+  renderBody() {
+    if (this.state.status === "lobby") {
+      this.updateCounters()
+      return
+    }
+
+    this.bodyTarget.textContent = ""
+
+    if (this.state.status === "question_open") {
+      this.bodyTarget.appendChild(this.buildQuestionStage(false))
+    } else if (this.state.status === "question_closed") {
+      this.bodyTarget.appendChild(this.buildQuestionStage(true))
+    } else if (this.state.status === "ended") {
+      this.bodyTarget.appendChild(this.buildEndedStage())
+    }
+  }
+
+  buildQuestionStage(closed) {
+    const wrapper = document.createElement("div")
+    wrapper.dataset.stage = closed ? "question_closed" : "question_open"
+
+    const num = document.createElement("div")
+    num.className = "stage-question__num"
+    num.textContent = `Question ${this.state.question_number} of ${this.state.total_questions}`
+    wrapper.appendChild(num)
+
+    const body = document.createElement("div")
+    body.className = "stage-question__body"
+    body.textContent = this.state.question.body
+    wrapper.appendChild(body)
+
+    const list = document.createElement("ol")
+    list.className = closed ? "stage-options stage-options--results" : "stage-options"
+
+    this.state.question.options.forEach((opt, idx) => {
+      const li = document.createElement("li")
+      li.className = "stage-option"
+
+      if (closed && opt.correct) {
+        li.classList.add("is-correct")
+        li.dataset.correct = "true"
+      }
+
+      if (closed) {
+        const bar = document.createElement("span")
+        bar.className = "stage-option__bar"
+        bar.style.setProperty("--share", `${opt.share ?? 0}%`)
+        bar.setAttribute("aria-hidden", "true")
+        li.appendChild(bar)
+      }
+
+      const letter = document.createElement("span")
+      letter.className = "stage-option__letter"
+      letter.setAttribute("aria-hidden", "true")
+      letter.textContent = this.optionLetter(idx)
+      li.appendChild(letter)
+
+      const title = document.createElement("span")
+      title.className = "stage-option__title"
+      title.textContent = opt.body
+      li.appendChild(title)
+
+      if (closed && opt.correct) {
+        const mark = document.createElement("span")
+        mark.className = "stage-option__mark"
+        mark.textContent = "Correct"
+        li.appendChild(mark)
+      }
+
+      if (closed) {
+        const count = document.createElement("span")
+        count.className = "stage-option__count"
+        count.textContent = String(opt.count ?? 0)
+        li.appendChild(count)
+      }
+
+      list.appendChild(li)
+    })
+
+    wrapper.appendChild(list)
+    return wrapper
+  }
+
+  buildEndedStage() {
+    const wrapper = document.createElement("div")
+    wrapper.dataset.stage = "ended"
+
+    const kicker = document.createElement("div")
+    kicker.className = "screen__kicker"
+    kicker.textContent = this.state.quiz_title
+    wrapper.appendChild(kicker)
+
+    const title = document.createElement("h1")
+    title.className = "lobby__title"
+    title.textContent = "The quiz is over"
+    wrapper.appendChild(title)
+
+    return wrapper
+  }
+
+  renderControls() {
+    this.controlsTarget.textContent = ""
+
+    const info = document.createElement("div")
+    info.className = "screen-controls__info"
+
+    const backLink = document.createElement("a")
+    backLink.href = this.backUrlValue
+    backLink.textContent = "← Back to quiz"
+    info.appendChild(backLink)
+
+    if (this.state.status === "question_open") {
+      const counter = document.createElement("span")
+      counter.className = "answers-counter"
+      counter.append("Answers: ")
+
+      const answeredSpan = document.createElement("span")
+      answeredSpan.dataset.moderatorGameTarget = "answersCount"
+      answeredSpan.textContent = String(this.state.answers_count ?? 0)
+      counter.appendChild(answeredSpan)
+
+      counter.append(" / ")
+
+      const activeSpan = document.createElement("span")
+      activeSpan.dataset.moderatorGameTarget = "activePlayersCount"
+      activeSpan.textContent = String(this.state.active_players_count ?? 0)
+      counter.appendChild(activeSpan)
+
+      info.appendChild(counter)
+    }
+
+    this.controlsTarget.appendChild(info)
+
+    const buttons = document.createElement("div")
+    buttons.className = "buttons"
+
+    if (this.state.status === "lobby") {
+      buttons.appendChild(this.buildActionButton("Start", "click->moderator-game#start"))
+    } else if (this.state.status === "question_open") {
+      buttons.appendChild(this.buildActionButton("Finish", "click->moderator-game#finish"))
+    } else if (this.state.status === "question_closed") {
+      if (this.state.last_question) {
+        buttons.appendChild(this.buildActionButton("End quiz", "click->moderator-game#endGame"))
+      } else {
+        buttons.appendChild(this.buildActionButton("Next", "click->moderator-game#next"))
+      }
+    }
+
+    this.controlsTarget.appendChild(buttons)
+  }
+
+  buildActionButton(label, action) {
+    const button = document.createElement("button")
+    button.type = "button"
+    button.className = "btn btn--pink btn--lg"
+    button.dataset.action = action
+    button.textContent = label
+    return button
+  }
+
+  optionLetter(index) {
+    if (index < 26) {
+      return String.fromCharCode(65 + index)
+    }
+    const first = String.fromCharCode(65 + Math.floor(index / 26) - 1)
+    const second = String.fromCharCode(65 + (index % 26))
+    return `${first}${second}`
+  }
+
+  csrfToken() {
+    const meta = document.querySelector('meta[name="csrf-token"]')
+    return meta ? meta.getAttribute("content") : ""
+  }
+}
diff --git a/app/javascript/controllers/play_join_controller.js b/app/javascript/controllers/play_join_controller.js
new file mode 100644
index 0000000..6d0d331
--- /dev/null
+++ b/app/javascript/controllers/play_join_controller.js
@@ -0,0 +1,126 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["body"]
+  static values = {
+    code: String,
+    stateUrl: String
+  }
+
+  connect() {
+    this.ended = false
+    this.wsConnected = false
+    this.tearingDown = false
+    this.pollTimer = null
+    this.reconnectTimer = null
+    this.reconnectAttempts = 0
+
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      { channel: "GamePublicChannel", code: this.codeValue },
+      {
+        connected: () => {
+          this.wsConnected = true
+          this.reconnectAttempts = 0
+          this.stopPolling()
+          this.clearReconnectTimer()
+        },
+        disconnected: () => {
+          this.wsConnected = false
+          if (this.tearingDown || this.ended) return
+          this.startPolling()
+          this.scheduleReconnect()
+        },
+        rejected: () => {
+          this.wsConnected = false
+          if (!this.tearingDown && !this.ended) this.startPolling()
+        },
+        received: (data) => {
+          if (data && data.status === "ended") {
+            this.renderEnded()
+          }
+        }
+      }
+    )
+  }
+
+  disconnect() {
+    this.tearingDown = true
+    this.stopPolling()
+    this.clearReconnectTimer()
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  scheduleReconnect() {
+    if (this.tearingDown || this.wsConnected || this.ended || this.reconnectTimer) return
+    const base = Math.min(500 * Math.pow(1.6, this.reconnectAttempts), 5000)
+    const delay = Math.round(base + Math.random() * 400)
+    this.reconnectAttempts += 1
+    this.reconnectTimer = window.setTimeout(() => {
+      this.reconnectTimer = null
+      if (!this.tearingDown && !this.wsConnected && !this.ended && this.consumer) {
+        this.consumer.connection.open()
+      }
+    }, delay)
+  }
+
+  clearReconnectTimer() {
+    if (this.reconnectTimer) {
+      window.clearTimeout(this.reconnectTimer)
+      this.reconnectTimer = null
+    }
+  }
+
+  startPolling() {
+    if (this.pollTimer || this.ended) return
+    this.pollTimer = window.setInterval(async () => {
+      if (this.wsConnected || this.ended) return
+      try {
+        const response = await fetch(this.stateUrlValue, {
+          headers: { Accept: "application/json" },
+          cache: "no-store"
+        })
+        if (!response.ok) return
+        const data = await response.json()
+        if (data && data.status === "ended") {
+          this.renderEnded()
+        }
+      } catch (_error) {
+        // Ignore transient network errors.
+      }
+    }, 1500)
+  }
+
+  stopPolling() {
+    if (this.pollTimer) {
+      window.clearInterval(this.pollTimer)
+      this.pollTimer = null
+    }
+  }
+
+  renderEnded() {
+    if (this.ended) return
+    this.ended = true
+    this.stopPolling()
+    this.clearReconnectTimer()
+
+    this.bodyTarget.textContent = ""
+    const waiting = document.createElement("div")
+    waiting.className = "waiting"
+
+    const heading = document.createElement("h1")
+    heading.className = "play-title"
+    heading.textContent = "The quiz is over"
+    waiting.appendChild(heading)
+
+    this.bodyTarget.appendChild(waiting)
+  }
+}
diff --git a/app/javascript/controllers/player_game_controller.js b/app/javascript/controllers/player_game_controller.js
new file mode 100644
index 0000000..dc0a88a
--- /dev/null
+++ b/app/javascript/controllers/player_game_controller.js
@@ -0,0 +1,617 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["body"]
+  static values = {
+    code: String,
+    streamToken: String,
+    stateUrl: String,
+    answerUrl: String,
+    initialState: Object
+  }
+
+  connect() {
+    this.state = { ...this.initialStateValue }
+    this.selectedQuestionId = this.state.question ? this.state.question.id : null
+    this.selectedOptionId = this.state.selected_option_id ?? null
+    this.confirmedOptionId = this.selectedOptionId
+    this.pendingAnswer = null
+    this.answerInFlight = false
+    this.retryAttempts = 0
+    this.retryTimer = null
+    this.reconcileAfterFlight = false
+    this.wsConnected = false
+    this.tearingDown = false
+    this.pollTimer = null
+    this.reconnectTimer = null
+    this.reconnectAttempts = 0
+    this.renderedStatus = this.state.status
+    this.renderedQuestionId = this.selectedQuestionId
+
+    this.onOnline = () => {
+      this.reconnectAttempts = 0
+      if (this.consumer && !this.wsConnected) {
+        this.consumer.connection.open()
+      }
+      this.flushPendingAnswer()
+      this.fetchState(false)
+    }
+
+    this.onVisibilityChange = () => {
+      if (document.visibilityState === "visible") {
+        if (this.consumer && !this.wsConnected) {
+          this.consumer.connection.open()
+        }
+        this.fetchState(false)
+      }
+    }
+
+    this.onPageHide = () => {
+      this.teardownCable()
+    }
+
+    this.onPageShow = (event) => {
+      if (event.persisted) {
+        this.tearingDown = false
+        this.connectCable()
+        this.fetchState(false)
+      }
+    }
+
+    window.addEventListener("online", this.onOnline)
+    document.addEventListener("visibilitychange", this.onVisibilityChange)
+    window.addEventListener("pagehide", this.onPageHide)
+    window.addEventListener("pageshow", this.onPageShow)
+
+    this.connectCable()
+  }
+
+  disconnect() {
+    this.tearingDown = true
+    this.stopPolling()
+    this.clearReconnectTimer()
+    this.clearRetryTimer()
+    window.removeEventListener("online", this.onOnline)
+    document.removeEventListener("visibilitychange", this.onVisibilityChange)
+    window.removeEventListener("pagehide", this.onPageHide)
+    window.removeEventListener("pageshow", this.onPageShow)
+    this.teardownCable()
+  }
+
+  connectCable() {
+    if (this.consumer) return
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      {
+        channel: "GamePlayerChannel",
+        code: this.codeValue,
+        token: this.streamTokenValue
+      },
+      {
+        connected: () => {
+          this.wsConnected = true
+          this.reconnectAttempts = 0
+          this.stopPolling()
+          this.clearReconnectTimer()
+        },
+        disconnected: () => {
+          this.wsConnected = false
+          if (this.tearingDown) return
+          this.startPolling()
+          this.scheduleReconnect()
+        },
+        rejected: () => {
+          this.wsConnected = false
+          if (!this.tearingDown) this.startPolling()
+        },
+        received: (data) => {
+          this.handleMessage(data)
+        }
+      }
+    )
+  }
+
+  teardownCable() {
+    this.tearingDown = true
+    this.wsConnected = false
+    this.clearReconnectTimer()
+    this.stopPolling()
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  scheduleReconnect() {
+    if (this.tearingDown || this.wsConnected || this.reconnectTimer || this.state.status === "ended") return
+    const base = Math.min(500 * Math.pow(1.6, this.reconnectAttempts), 5000)
+    const delay = Math.round(base + Math.random() * 400)
+    this.reconnectAttempts += 1
+    this.reconnectTimer = window.setTimeout(() => {
+      this.reconnectTimer = null
+      if (!this.tearingDown && !this.wsConnected && this.consumer && this.state.status !== "ended") {
+        this.consumer.connection.open()
+      }
+    }, delay)
+  }
+
+  clearReconnectTimer() {
+    if (this.reconnectTimer) {
+      window.clearTimeout(this.reconnectTimer)
+      this.reconnectTimer = null
+    }
+  }
+
+  startPolling() {
+    if (this.pollTimer || this.state.status === "ended") return
+    const interval = 1100 + Math.floor(Math.random() * 350)
+    this.pollTimer = window.setInterval(() => {
+      if (!this.wsConnected && this.state.status !== "ended") {
+        this.fetchState(true)
+      }
+    }, interval)
+  }
+
+  stopPolling() {
+    if (this.pollTimer) {
+      window.clearInterval(this.pollTimer)
+      this.pollTimer = null
+    }
+  }
+
+  clearRetryTimer() {
+    if (this.retryTimer) {
+      window.clearTimeout(this.retryTimer)
+      this.retryTimer = null
+    }
+  }
+
+  async fetchState(fallback) {
+    try {
+      const url = fallback ? `${this.stateUrlValue}?fallback=1` : this.stateUrlValue
+      const response = await fetch(url, {
+        headers: { Accept: "application/json" },
+        credentials: "same-origin",
+        cache: "no-store"
+      })
+      if (!response.ok) return
+      const data = await response.json()
+      this.applyState(data, { authoritative: true })
+    } catch (_error) {
+      // Transient Wi-Fi error; next reconnect or poll will sync.
+    }
+  }
+
+  handleMessage(data) {
+    if (!data || typeof data !== "object") return
+
+    if (data.type === "player_answer") {
+      if (
+        this.state.status === "question_open" &&
+        this.state.question &&
+        this.state.question.id === data.game_question_id &&
+        !this.answerInFlight &&
+        !this.pendingAnswer
+      ) {
+        this.selectedQuestionId = data.game_question_id
+        this.selectedOptionId = data.selected_option_id
+        this.confirmedOptionId = data.selected_option_id
+        this.updateOpenOptionSelection()
+      }
+      return
+    }
+
+    if (data.type === "state") {
+      const hasPersonal = Object.prototype.hasOwnProperty.call(data, "selected_option_id")
+      this.applyState(data, { authoritative: hasPersonal })
+    }
+  }
+
+  applyState(nextState, { authoritative = false } = {}) {
+    if (!nextState || typeof nextState !== "object") return
+
+    const nextVersion = Number(nextState.state_version ?? 0)
+    const currentVersion = Number(this.state.state_version ?? 0)
+    if (nextVersion < currentVersion) return
+
+    const playerName = nextState.player_name || this.state.player_name
+    const nextQuestionId = nextState.question ? nextState.question.id : null
+    const hasPersonal = Object.prototype.hasOwnProperty.call(nextState, "selected_option_id")
+
+    if (nextState.status === "ended") {
+      this.pendingAnswer = null
+      this.clearRetryTimer()
+      this.clearReconnectTimer()
+      this.stopPolling()
+      this.state = { ...nextState, player_name: playerName }
+      this.render()
+      return
+    }
+
+    if (nextState.status === "lobby") {
+      this.state = { ...nextState, player_name: playerName }
+      if (this.renderedStatus !== "lobby") {
+        this.render()
+      }
+      return
+    }
+
+    if (nextState.status === "question_open") {
+      const isNewQuestion = nextQuestionId !== this.selectedQuestionId
+      if (hasPersonal) {
+        const localTapInFlight =
+          !isNewQuestion &&
+          this.state.status === "question_open" &&
+          (this.answerInFlight || this.pendingAnswer)
+
+        if (!localTapInFlight) {
+          this.selectedQuestionId = nextQuestionId
+          this.selectedOptionId = nextState.selected_option_id ?? null
+          this.confirmedOptionId = this.selectedOptionId
+        }
+      } else if (isNewQuestion) {
+        this.selectedQuestionId = nextQuestionId
+        this.selectedOptionId = null
+        this.confirmedOptionId = null
+        this.pendingAnswer = null
+        this.clearRetryTimer()
+      }
+
+      const sameOpenQuestion =
+        this.renderedStatus === "question_open" &&
+        this.renderedQuestionId === nextQuestionId
+
+      this.state = { ...nextState, player_name: playerName }
+
+      if (sameOpenQuestion) {
+        this.updateOpenOptionSelection()
+      } else {
+        this.render()
+      }
+      return
+    }
+
+    if (nextState.status === "question_closed") {
+      this.pendingAnswer = null
+      this.clearRetryTimer()
+
+      if (hasPersonal) {
+        this.selectedQuestionId = nextQuestionId
+        this.selectedOptionId = nextState.selected_option_id ?? null
+        this.confirmedOptionId = this.selectedOptionId
+        this.state = {
+          ...nextState,
+          player_name: playerName,
+          outcome: nextState.outcome || this.computeOutcome(nextState.question, this.selectedOptionId)
+        }
+        this.render()
+        return
+      }
+
+      if (this.answerInFlight) {
+        this.reconcileAfterFlight = true
+        this.state = { ...nextState, player_name: playerName }
+        this.bodyTarget.querySelectorAll("button.play-option").forEach((btn) => { btn.disabled = true })
+        return
+      }
+
+      if (nextQuestionId !== this.selectedQuestionId) {
+        this.state = { ...nextState, player_name: playerName }
+        this.fetchState(false)
+        return
+      }
+
+      this.state = {
+        ...nextState,
+        player_name: playerName,
+        selected_option_id: this.selectedOptionId,
+        outcome: this.computeOutcome(nextState.question, this.selectedOptionId)
+      }
+      this.render()
+    }
+  }
+
+  pickOption(event) {
+    const button = event.currentTarget
+    if (this.state.status !== "question_open" || !this.state.question) return
+
+    const questionId = Number(button.dataset.questionId)
+    const optionId = Number(button.dataset.optionId)
+    if (questionId !== this.state.question.id) return
+
+    this.selectedQuestionId = questionId
+    this.selectedOptionId = optionId
+    this.updateOpenOptionSelection()
+
+    this.pendingAnswer = { questionId, optionId }
+    this.retryAttempts = 0
+    this.clearRetryTimer()
+    this.flushPendingAnswer()
+  }
+
+  async flushPendingAnswer() {
+    if (this.answerInFlight || !this.pendingAnswer) return
+
+    const toSend = this.pendingAnswer
+    this.pendingAnswer = null
+
+    if (
+      this.state.status !== "question_open" ||
+      !this.state.question ||
+      this.state.question.id !== toSend.questionId
+    ) {
+      return
+    }
+
+    this.answerInFlight = true
+    let needReconcile = false
+
+    try {
+      const response = await fetch(this.answerUrlValue, {
+        method: "POST",
+        headers: {
+          Accept: "application/json",
+          "Content-Type": "application/json",
+          "X-CSRF-Token": this.csrfToken()
+        },
+        credentials: "same-origin",
+        body: JSON.stringify({
+          game_question_id: toSend.questionId,
+          game_option_id: toSend.optionId
+        })
+      })
+
+      if (response.ok) {
+        this.confirmedOptionId = toSend.optionId
+        this.retryAttempts = 0
+        if (this.reconcileAfterFlight) {
+          needReconcile = true
+        }
+      } else if (response.status === 409) {
+        const data = await response.json()
+        this.pendingAnswer = null
+        this.reconcileAfterFlight = false
+        this.applyState(data, { authoritative: true })
+      } else if (response.status >= 500) {
+        this.scheduleAnswerRetry(toSend)
+      }
+    } catch (_error) {
+      this.scheduleAnswerRetry(toSend)
+    } finally {
+      this.answerInFlight = false
+      if (needReconcile || this.reconcileAfterFlight) {
+        this.reconcileAfterFlight = false
+        this.fetchState(false)
+      } else if (this.pendingAnswer) {
+        this.flushPendingAnswer()
+      }
+    }
+  }
+
+  scheduleAnswerRetry(toSend) {
+    if (this.pendingAnswer) return
+    if (this.state.status !== "question_open") {
+      if (this.reconcileAfterFlight) {
+        this.reconcileAfterFlight = false
+        this.fetchState(false)
+      }
+      return
+    }
+    if (this.retryAttempts >= 4) return
+
+    const delays = [400, 1000, 2000, 3000]
+    const delay = delays[this.retryAttempts] ?? 3000
+    this.retryAttempts += 1
+    this.pendingAnswer = toSend
+
+    this.clearRetryTimer()
+    this.retryTimer = window.setTimeout(() => {
+      this.retryTimer = null
+      this.flushPendingAnswer()
+    }, delay)
+  }
+
+  computeOutcome(question, selectedOptionId) {
+    if (selectedOptionId == null) return "none"
+    const picked = question && question.options
+      ? question.options.find((opt) => opt.id === selectedOptionId)
+      : null
+    if (!picked) return "none"
+    return picked.correct ? "correct" : "wrong"
+  }
+
+  updateOpenOptionSelection() {
+    const buttons = this.bodyTarget.querySelectorAll("button.play-option")
+    buttons.forEach((button) => {
+      const optId = Number(button.dataset.optionId)
+      const isPicked = optId === this.selectedOptionId
+      button.classList.toggle("is-picked", isPicked)
+      button.setAttribute("aria-pressed", isPicked ? "true" : "false")
+      const mark = button.querySelector(".play-option__mark")
+      if (mark) {
+        mark.textContent = isPicked ? "Your answer" : ""
+      }
+    })
+  }
+
+  render() {
+    this.bodyTarget.textContent = ""
+    const topAligned = this.state.status === "question_open" || this.state.status === "question_closed"
+    this.bodyTarget.classList.toggle("play__body--top", topAligned)
+
+    if (this.state.status === "lobby") {
+      this.renderLobby()
+    } else if (this.state.status === "question_open") {
+      this.renderOpenQuestion()
+    } else if (this.state.status === "question_closed") {
+      this.renderClosedQuestion()
+    } else if (this.state.status === "ended") {
+      this.renderEnded()
+    }
+
+    this.renderedStatus = this.state.status
+    this.renderedQuestionId = this.state.question ? this.state.question.id : null
+  }
+
+  renderLobby() {
+    const waiting = document.createElement("div")
+    waiting.className = "waiting"
+
+    const gem = document.createElement("div")
+    gem.className = "waiting__gem"
+    gem.setAttribute("aria-hidden", "true")
+    gem.textContent = "?"
+    waiting.appendChild(gem)
+
+    const heading = document.createElement("h1")
+    heading.className = "play-title"
+    heading.textContent = `Hi, ${this.state.player_name}!`
+    waiting.appendChild(heading)
+
+    const lead = document.createElement("p")
+    lead.className = "play-lead"
+    lead.textContent = "Waiting for the quiz to start…"
+    waiting.appendChild(lead)
+
+    this.bodyTarget.appendChild(waiting)
+  }
+
+  renderOpenQuestion() {
+    const num = document.createElement("div")
+    num.className = "play-question__num"
+    num.textContent = `Question ${this.state.question_number} of ${this.state.total_questions}`
+    this.bodyTarget.appendChild(num)
+
+    const body = document.createElement("div")
+    body.className = "play-question__body"
+    body.textContent = this.state.question.body
+    this.bodyTarget.appendChild(body)
+
+    const list = document.createElement("div")
+    list.className = "play-options"
+
+    this.state.question.options.forEach((opt, idx) => {
+      const picked = opt.id === this.selectedOptionId
+
+      const button = document.createElement("button")
+      button.type = "button"
+      button.className = picked ? "play-option is-picked" : "play-option"
+      button.setAttribute("aria-pressed", picked ? "true" : "false")
+      button.dataset.action = "click->player-game#pickOption"
+      button.dataset.questionId = String(this.state.question.id)
+      button.dataset.optionId = String(opt.id)
+
+      const letter = document.createElement("span")
+      letter.className = "play-option__letter"
+      letter.setAttribute("aria-hidden", "true")
+      letter.textContent = this.optionLetter(idx)
+      button.appendChild(letter)
+
+      const title = document.createElement("span")
+      title.className = "play-option__title"
+      title.textContent = opt.body
+      button.appendChild(title)
+
+      const mark = document.createElement("span")
+      mark.className = "play-option__mark"
+      mark.textContent = picked ? "Your answer" : ""
+      button.appendChild(mark)
+
+      list.appendChild(button)
+    })
+
+    this.bodyTarget.appendChild(list)
+  }
+
+  renderClosedQuestion() {
+    const num = document.createElement("div")
+    num.className = "play-question__num"
+    num.textContent = `Question ${this.state.question_number} of ${this.state.total_questions}`
+    this.bodyTarget.appendChild(num)
+
+    const body = document.createElement("div")
+    body.className = "play-question__body"
+    body.textContent = this.state.question.body
+    this.bodyTarget.appendChild(body)
+
+    const list = document.createElement("div")
+    list.className = "play-options is-locked is-revealed"
+
+    this.state.question.options.forEach((opt, idx) => {
+      const picked = opt.id === this.selectedOptionId
+
+      const button = document.createElement("button")
+      button.type = "button"
+      button.disabled = true
+      button.className = "play-option"
+      if (picked) button.classList.add("is-picked")
+      if (opt.correct) button.classList.add("is-correct")
+
+      const letter = document.createElement("span")
+      letter.className = "play-option__letter"
+      letter.setAttribute("aria-hidden", "true")
+      letter.textContent = this.optionLetter(idx)
+      button.appendChild(letter)
+
+      const title = document.createElement("span")
+      title.className = "play-option__title"
+      title.textContent = opt.body
+      button.appendChild(title)
+
+      const mark = document.createElement("span")
+      mark.className = "play-option__mark"
+      mark.textContent = picked ? "Your answer" : ""
+      button.appendChild(mark)
+
+      list.appendChild(button)
+    })
+
+    this.bodyTarget.appendChild(list)
+
+    const outcome = this.state.outcome || this.computeOutcome(this.state.question, this.selectedOptionId)
+    const status = document.createElement("div")
+    status.setAttribute("role", "status")
+    if (outcome === "correct") {
+      status.className = "play-status play-status--right"
+      status.textContent = "Correct!"
+    } else if (outcome === "wrong") {
+      status.className = "play-status play-status--wrong"
+      status.textContent = "Wrong!"
+    } else {
+      status.className = "play-status play-status--neutral"
+      status.textContent = "No answer"
+    }
+    this.bodyTarget.appendChild(status)
+  }
+
+  renderEnded() {
+    const waiting = document.createElement("div")
+    waiting.className = "waiting"
+
+    const heading = document.createElement("h1")
+    heading.className = "play-title"
+    heading.textContent = "The quiz is over"
+    waiting.appendChild(heading)
+
+    this.bodyTarget.appendChild(waiting)
+  }
+
+  optionLetter(index) {
+    if (index < 26) {
+      return String.fromCharCode(65 + index)
+    }
+    const first = String.fromCharCode(65 + Math.floor(index / 26) - 1)
+    const second = String.fromCharCode(65 + (index % 26))
+    return `${first}${second}`
+  }
+
+  csrfToken() {
+    const meta = document.querySelector('meta[name="csrf-token"]')
+    return meta ? meta.getAttribute("content") : ""
+  }
+}
