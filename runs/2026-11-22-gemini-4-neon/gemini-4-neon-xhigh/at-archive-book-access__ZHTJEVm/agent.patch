diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..62e379d 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,89 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy deletes book and archives current accesses" do
+    book = books(:handbook)
+    assert_equal 0, AccessArchive.count
+
+    assert_difference -> { Book.count }, -1 do
+      assert_difference -> { Access.where(book_id: book.id).count }, -4 do
+        delete book_path(book)
+      end
+    end
+
+    assert_redirected_to root_url
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal 4, archives.count
+    assert_equal [ "Handbook" ], archives.pluck(:book_title).uniq
+
+    expected = {
+      users(:david).id => [ users(:david).name, "editor" ],
+      users(:jason).id => [ users(:jason).name, "editor" ],
+      users(:jz).id => [ users(:jz).name, "reader" ],
+      users(:kevin).id => [ users(:kevin).name, "editor" ]
+    }
+    actual = archives.each_with_object({}) { |row, map| map[row.user_id] = [ row.user_name, row.level ] }
+    assert_equal expected, actual
+  end
+
+  test "destroy records updated access levels and omits revoked users" do
+    book = books(:handbook)
+
+    patch book_path(book), params: {
+      book: { everyone_access: false },
+      editor_ids: [ users(:jz).id ],
+      reader_ids: [ users(:david).id ]
+    }
+
+    assert_equal 0, AccessArchive.count
+
+    delete book_path(book)
+
+    assert_redirected_to root_url
+
+    archives = AccessArchive.where(book_id: book.id)
+    expected = {
+      users(:kevin).id => [ users(:kevin).name, "editor" ],
+      users(:jz).id => [ users(:jz).name, "editor" ],
+      users(:david).id => [ users(:david).name, "reader" ]
+    }
+    actual = archives.each_with_object({}) { |row, map| map[row.user_id] = [ row.user_name, row.level ] }
+    assert_equal expected, actual
+  end
+
+  test "destroy writes no archive rows when forbidden" do
+    sign_in :jz
+    book = books(:handbook)
+
+    assert_no_difference -> { Book.count } do
+      assert_no_difference -> { AccessArchive.count } do
+        delete book_path(book)
+      end
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy archives only users with access grants when an admin deletes a published book" do
+    sign_in :david
+    book = books(:manual)
+    book.update!(published: true, everyone_access: false)
+    book.update_access(editors: [], readers: [ users(:jz).id ])
+
+    assert_equal 0, AccessArchive.count
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(book)
+    end
+
+    assert_redirected_to root_url
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal 1, archives.count
+    assert_equal users(:jz).id, archives.first.user_id
+    assert_equal users(:jz).name, archives.first.user_name
+    assert_equal "reader", archives.first.level
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..c0794f1 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,70 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroying a book archives each user's access level" do
+    book = books(:handbook)
+    assert_empty AccessArchive.where(book_id: book.id)
+
+    book.destroy
+
+    assert_not Book.exists?(book.id)
+    assert_empty Access.where(book_id: book.id)
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal 4, archives.count
+    assert_equal [ "Handbook" ], archives.pluck(:book_title).uniq
+
+    expected = {
+      users(:david).id => [ users(:david).name, "editor" ],
+      users(:jason).id => [ users(:jason).name, "editor" ],
+      users(:jz).id => [ users(:jz).name, "reader" ],
+      users(:kevin).id => [ users(:kevin).name, "editor" ]
+    }
+    actual = archives.each_with_object({}) { |row, map| map[row.user_id] = [ row.user_name, row.level ] }
+    assert_equal expected, actual
+  end
+
+  test "destroying a book omits revoked accesses and records updated levels" do
+    book = books(:handbook)
+    book.update!(everyone_access: false)
+    book.update_access(editors: [ users(:david).id ], readers: [ users(:kevin).id ])
+
+    assert_empty AccessArchive.where(book_id: book.id)
+
+    book.destroy
+
+    archives = AccessArchive.where(book_id: book.id)
+    expected = {
+      users(:david).id => [ users(:david).name, "editor" ],
+      users(:kevin).id => [ users(:kevin).name, "reader" ]
+    }
+    actual = archives.each_with_object({}) { |row, map| map[row.user_id] = [ row.user_name, row.level ] }
+    assert_equal expected, actual
+  end
+
+  test "destroying a book with no accesses creates no archive rows" do
+    unshared_book = Book.create!(title: "Unshared Book", everyone_access: false)
+    orphan_book = Book.create!(title: "Orphan Book", everyone_access: true)
+
+    assert_no_difference -> { AccessArchive.count } do
+      unshared_book.destroy
+      orphan_book.destroy
+    end
+
+    assert_not Book.exists?(unshared_book.id)
+    assert_not Book.exists?(orphan_book.id)
+  end
+
+  test "destroying a book ignores stale cached accesses" do
+    book = books(:handbook)
+    book.accesses.load
+    Access.find_by!(book: book, user: users(:jz)).destroy!
+
+    book.destroy
+
+    archived_user_ids = AccessArchive.where(book_id: book.id).pluck(:user_id)
+    assert_not_includes archived_user_ids, users(:jz).id
+    assert_equal 3, archived_user_ids.size
+  end
 end
