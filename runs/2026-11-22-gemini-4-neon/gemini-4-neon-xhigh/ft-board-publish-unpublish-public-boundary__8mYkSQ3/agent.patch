+  assert_queries_match(/FROM [`"]board_publications[`"].* IN \(/, count: 1) do
+    get boards_path, as: :json
+    assert_response :success
+  end
+
+  writebook_json = @response.parsed_body.find { |b| b["id"] == boards(:writebook).id }
+  private_json = @response.parsed_body.find { |b| b["id"] == boards(:private).id }
+
+  assert_equal public_board_url(boards(:writebook).publication.key), writebook_json["public_url"]
