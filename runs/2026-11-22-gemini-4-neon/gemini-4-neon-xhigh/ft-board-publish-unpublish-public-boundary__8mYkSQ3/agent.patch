+
+test "show as JSON returns public_url when published and invalidates cache on publish/unpublish" do
+  board = boards(:writebook)
+
+  with_actionview_partial_caching do
+    get board_path(board), as: :json
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+
+    travel 1.second do
+      board.publish
+    end
