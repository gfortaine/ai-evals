diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..53d6657
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_not @board.publicly_accessible?
+    assert_nil @board.publication
+  end
+
+  test "publish creates a publication with a secret key" do
+    publication = @board.publish
+
+    assert @board.published?
+    assert @board.publicly_accessible?
+    assert publication.persisted?
+    assert publication.key.present?
+    assert_equal @board.account, publication.account
+    assert_equal publication.key, publication.to_param
+  end
+
+  test "publish is idempotent and preserves the existing key" do
+    first = @board.publish
+    second = @board.publish
+
+    assert_equal first.id, second.id
+    assert_equal first.key, second.key
+  end
+
+  test "unpublish destroys the publication and clears association" do
+    @board.publish
+    assert @board.published?
+
+    @board.unpublish
+
+    assert_not @board.published?
+    assert_not @board.publicly_accessible?
+    assert_nil @board.publication
+    assert_not Board::Publication.exists?(board_id: @board.id)
+  end
+
+  test "unpublish on unpublished board is a no-op" do
+    assert_nothing_raised { @board.unpublish }
+    assert_not @board.published?
+  end
+
+  test "republishing generates a new secret key" do
+    first_key = @board.publish.key
+    @board.unpublish
+    second_key = @board.publish.key
+
+    assert_not_equal first_key, second_key
+    assert_nil Board.find_by_published_key(first_key)
+    assert_equal @board, Board.find_by_published_key(second_key)
+  end
+
+  test "find_by_published_key scopes to account" do
+    key = @board.publish.key
+
+    assert_equal @board, accounts("37s").boards.find_by_published_key(key)
+    assert_nil accounts("initech").boards.find_by_published_key(key)
+  end
+
+  test "published scope returns only published boards" do
+    assert_not_includes Board.published, @board
+
+    @board.publish
+
+    assert_includes Board.published, @board
+    assert_not_includes Board.published, boards(:private)
+  end
+
+  test "destroying board destroys publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy!
+    end
+  end
+
+  test "card and comment publicly_accessible? reflect board publication and card status" do
+    card = cards(:logo)
+    comment = comments(:logo_1)
+    draft_card = @board.cards.create!(creator: users(:david), title: "Draft", status: :drafted)
+
+    assert_not card.publicly_accessible?
+    assert_not comment.publicly_accessible?
+    assert_not draft_card.publicly_accessible?
+
+    @board.publish
+
+    assert card.reload.publicly_accessible?
+    assert comment.reload.publicly_accessible?
+    assert_not draft_card.reload.publicly_accessible?
+
+    @board.unpublish
+
+    assert_not card.reload.publicly_accessible?
+    assert_not comment.reload.publicly_accessible?
+  end
+end
