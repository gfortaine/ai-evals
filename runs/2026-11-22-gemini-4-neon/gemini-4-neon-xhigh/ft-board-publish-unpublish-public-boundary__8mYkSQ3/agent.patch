diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..129babe
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,42 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy
+
+    scope :published, -> { joins(:publication) }
+  end
+
+  class_methods do
+    def find_by_published_key(key)
+      joins(:publication).find_by(board_publications: { key: key })
+    end
+
+    def find_by_published_key!(key)
+      joins(:publication).find_by!(board_publications: { key: key })
+    end
+  end
+
+  def publish
+    if published?
+      publication
+    else
+      create_publication!
+    end
+  rescue ActiveRecord::RecordNotUnique
+    reload_publication
+  end
+
+  def unpublish
+    publication&.destroy
+    association(:publication).target = nil
+  end
+
+  def published?
+    publication.present? && !publication.destroyed?
+  end
+
+  def publicly_accessible?
+    published?
+  end
+end
