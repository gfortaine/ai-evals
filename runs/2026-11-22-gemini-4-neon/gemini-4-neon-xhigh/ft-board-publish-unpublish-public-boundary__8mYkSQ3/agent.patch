index 0000000..aa08dee
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,197 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "create publishes the board" do
+    assert_not @board.published?
+
+    assert_difference -> { Board::Publication.count }, +1 do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+  end
+
+  test "create as turbo stream replaces publication frame" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      post board_publication_path(@board, format: :turbo_stream)
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@board, :publication)
+    assert @board.reload.published?
+  end
+
+  test "create as JSON returns board with public_url" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    @board.reload
+    assert @board.published?
+    assert_equal public_board_url(@board.publication.key), @response.parsed_body["public_url"]
+  end
+
+  test "destroy unpublishes the board" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "destroy as turbo stream replaces publication frame" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board, format: :turbo_stream)
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@board, :publication)
+    assert_not @board.reload.published?
+  end
+
+  test "destroy as JSON returns no content" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "board creator can publish and unpublish their own board" do
+    logout_and_sign_in_as :david
+
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin cannot publish board" do
+    logout_and_sign_in_as :jz
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board)
+    end
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin cannot unpublish board" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    assert_no_difference -> { Board::Publication.count } do
+      delete board_publication_path(@board)
+    end
+
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "non-admin cannot publish or unpublish board as JSON" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_not @board.reload.published?
+
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "cannot publish board without access" do
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(boards(:private))
+    assert_response :not_found
+    assert_not boards(:private).reload.published?
+  end
+
+  test "create is idempotent and keeps the same public key" do
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    first_url = @response.parsed_body["public_url"]
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    assert_equal first_url, @response.parsed_body["public_url"]
+  end
+
+  test "destroy is idempotent on unpublished board" do
+    assert_no_difference -> { Board::Publication.count } do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "bearer token requires write permission to publish and unpublish" do
+    sign_out
+    read_token = { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:jasons_api_token).token}" }
+    write_token = { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    post board_publication_path(@board), env: read_token, as: :json
+    assert_response :unauthorized
+    assert_not @board.reload.published?
+
+    post board_publication_path(@board), env: write_token, as: :json
+    assert_response :created
+    assert @board.reload.published?
+    assert_equal public_board_url(@board.publication.key), @response.parsed_body["public_url"]
+
+    delete board_publication_path(@board), env: read_token, as: :json
+    assert_response :unauthorized
+    assert @board.reload.published?
+
+    delete board_publication_path(@board), env: write_token, as: :json
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "board edit page shows publication controls for admin" do
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "form[action='#{board_publication_path(@board)}'] input[type=checkbox][name=published]:not([disabled])"
+
+    @board.publish
+
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "input[readonly][value='#{public_board_url(@board.publication.key)}']"
+  end
+
+  test "board edit page disables publication toggle for non-admin" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "form[action='#{board_publication_path(@board)}'] input[type=checkbox][name=published][disabled]"
+    assert_select "input[readonly][value='#{public_board_url(@board.publication.key)}']"
+  end
+end
