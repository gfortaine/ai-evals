+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "show published card of published board without authentication" do
+    @board.publish
+
+    get public_board_card_path(@board.publication.key, @card)
+
+    assert_response :success
+    assert_select "h1.card__title", text: @card.title
+    assert_in_body comments(:logo_1).body.to_plain_text
+    assert_select "a[href='#{public_board_path(@board.publication.key)}']"
+    assert_equal "none", response.headers["X-Robots-Tag"]
+  end
+
+  test "show closed and postponed published cards of published board" do
+    @board.publish
+
+    closed_card = cards(:shipping)
+    closed_card.close(user: users(:david))
+    get public_board_card_path(@board.publication.key, closed_card)
+    assert_response :success
+    assert_select "h1.card__title", text: closed_card.title
+
+    postponed_card = cards(:buy_domain)
+    postponed_card.postpone(user: users(:david))
+    get public_board_card_path(@board.publication.key, postponed_card)
+    assert_response :success
+    assert_select "h1.card__title", text: postponed_card.title
+  end
+
+  test "show returns not found for drafted card on published board" do
+    @board.publish
+    draft_card = @board.cards.create!(creator: users(:david), title: "Secret draft", status: :drafted)
+
+    get public_board_card_path(@board.publication.key, draft_card)
+
+    assert_response :not_found
+  end
+
+  test "show returns not found for card belonging to another board" do
+    @board.publish
+    other_card = Current.with(user: users(:kevin)) do
+      boards(:private).cards.create!(creator: users(:kevin), title: "Private card", status: :published)
+    end
+
+    get public_board_card_path(@board.publication.key, other_card)
+
+    assert_response :not_found
+  end
+
+  test "show returns not found for invalid board key" do
+    get public_board_card_path("invalid-key", @card)
+
+    assert_response :not_found
+  end
+
+  test "show returns not found after board is unpublished" do
+    key = @board.publish.key
+    @board.unpublish
+
+    get public_board_card_path(key, @card)
+
+    assert_response :not_found
+  end
+
+  test "show does not leak edit or user profile links" do
+    @board.publish
+
+    get public_board_card_path(@board.publication.key, @card)
+
+    assert_response :success
+    assert_select "a[href='#{edit_card_path(@card)}']", count: 0
+    assert_select "a[href='#{user_path(@card.creator)}']", count: 0
+  end
+
+  test "show renders steps, tags, assignees, reactions, image, and description on published card" do
+    @board.publish
+    Current.with(user: users(:david)) do
+      @card.steps.create!(content: "Completed step", completed: true)
+      @card.steps.create!(content: "Pending step", completed: false)
+      @card.reactions.create!(reacter: users(:kevin), content: "👍")
+      @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+      @card.gild
+    end
+
+    get public_board_card_path(@board.publication.key, @card)
+
+    assert_response :success
+    assert_in_body "Completed step"
+    assert_in_body "Pending step"
+    assert_in_body "👍"
+    assert_select "input[type=checkbox][disabled][checked]"
+    assert_select "input[type=checkbox][disabled]:not([checked])"
+  end
+end
