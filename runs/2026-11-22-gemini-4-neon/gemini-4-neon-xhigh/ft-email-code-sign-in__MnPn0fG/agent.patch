+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] || flash[:shake] %>">
+  <header>
+    <h1 class="txt-x-large font-weight-black margin-none">Check your email</h1>
+    <p class="margin-block-start-half">Then enter the verification code we sent to <strong><%= email_address_pending_authentication %></strong></p>
+  </header>
+
+  <%= form_with url: session_magic_link_path, method: :post, class: "flex flex-column gap-half" do |form| %>
+    <%= form.label :code, "Verification code", class: "for-screen-reader" %>
