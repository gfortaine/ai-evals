diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..e949a20
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "generates a 6-character code and 15-minute expiration on create" do
+    freeze_time do
+      magic_link = MagicLink.create!(identity: identities(:kevin))
+
+      assert_equal 6, magic_link.code.length
+      assert_match /\A[0-9A-HJKMNP-TV-Z]{6}\z/, magic_link.code
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert magic_link.for_sign_in?
+    end
+  end
+
+  test "supports sign_up purpose" do
+    magic_link = MagicLink.create!(identity: identities(:kevin), purpose: :sign_up)
+
+    assert magic_link.for_sign_up?
+    assert_not magic_link.for_sign_in?
+  end
+
+  test "consume finds, deletes, and returns active magic link once" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    assert_difference -> { MagicLink.count }, -1 do
+      assert_equal magic_link, MagicLink.consume(magic_link.code)
+    end
+
+    assert_nil MagicLink.consume(magic_link.code)
+  end
+
+  test "consume normalizes lowercase, whitespace, punctuation, and lookalike characters" do
+    magic_link = MagicLink.create!(identity: identities(:kevin), code: "01A2B3")
+
+    assert_equal magic_link, MagicLink.consume(" o l - a 2 b 3 ")
+  end
+
+  test "consume handles I and L substitutions" do
+    magic_link = MagicLink.create!(identity: identities(:kevin), code: "110ABC")
+
+    assert_equal magic_link, MagicLink.consume("iloabc")
+  end
+
+  test "consume returns nil for blank or unknown codes" do
+    assert_nil MagicLink.consume(nil)
+    assert_nil MagicLink.consume("")
+    assert_nil MagicLink.consume("   ")
+    assert_nil MagicLink.consume("---")
+    assert_nil MagicLink.consume("ZZZZZZ")
+  end
+
+  test "code works for 15 minutes and expires at 15 minutes" do
+    freeze_time do
+      still_valid = MagicLink.create!(identity: identities(:kevin))
+      will_expire = MagicLink.create!(identity: identities(:david))
+
+      travel 14.minutes + 59.seconds
+      assert_equal still_valid, MagicLink.consume(still_valid.code)
+
+      travel 1.second
+      assert_nil MagicLink.consume(will_expire.code)
+    end
+  end
+
+  test "scoped consume via identity does not consume another identity's code" do
+    kevin_link = MagicLink.create!(identity: identities(:kevin))
+    david = identities(:david)
+
+    assert_no_difference -> { MagicLink.count } do
+      assert_nil david.magic_links.consume(kevin_link.code)
+    end
+
+    assert_equal kevin_link, identities(:kevin).magic_links.consume(kevin_link.code)
+  end
+
+  test "cleanup removes only expired magic links" do
+    freeze_time do
+      expired = MagicLink.create!(identity: identities(:kevin))
+      travel 15.minutes
+      active = MagicLink.create!(identity: identities(:david))
+
+      assert_difference -> { MagicLink.count }, -1 do
+        MagicLink.cleanup
+      end
+
+      assert_not MagicLink.exists?(expired.id)
+      assert MagicLink.exists?(active.id)
+    end
+  end
+
+  test "identity send_magic_link creates record and enqueues email" do
+    identity = identities(:kevin)
+
+    magic_link = nil
+    assert_difference -> { MagicLink.count }, 1 do
+      assert_enqueued_emails 1 do
+        magic_link = identity.send_magic_link
+      end
+    end
+
+    assert_equal identity, magic_link.identity
+    assert magic_link.for_sign_in?
+  end
+
+  test "identity send_magic_link supports for: :sign_up" do
+    identity = identities(:kevin)
+
+    magic_link = nil
+    assert_enqueued_emails 1 do
+      magic_link = identity.send_magic_link(for: :sign_up)
+    end
+
+    assert magic_link.for_sign_up?
+  end
+
+  test "destroying identity destroys its magic links" do
+    identity = Identity.create!(email_address: "ephemeral@example.com")
+    magic_link = identity.magic_links.create!
+
+    identity.destroy!
+
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+end
diff --git a/test/system/email_code_authentication_test.rb b/test/system/email_code_authentication_test.rb
new file mode 100644
index 0000000..5699604
--- /dev/null
+++ b/test/system/email_code_authentication_test.rb
@@ -0,0 +1,96 @@
+require "application_system_test_case"
+
+class EmailCodeAuthenticationTest < ApplicationSystemTestCase
+  include ActionMailer::TestHelper
+
+  test "sign in by email code" do
+    identity = identities(:kevin)
+
+    visit new_session_url(script_name: nil)
+    fill_in "email_address", with: identity.email_address
+
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+      click_on "Let’s go"
+      assert_selector "h1", text: "Check your email"
+    end
+
+    code = extract_code_from_last_email
+
+    # Wrong code keeps us on the code screen with an alert
+    fill_in "code", with: "WRONG1"
+    click_on "Verify"
+    assert_text "Try another code."
+    assert_current_path session_magic_link_path(script_name: nil)
+
+    # Correct code signs us in
+    fill_in "code", with: code
+    click_on "Verify"
+
+    assert_current_path root_path(script_name: accounts("37s").slug)
+  end
+
+  test "sign up by email code" do
+    visit new_signup_url(script_name: nil)
+    fill_in "signup[email_address]", with: "newperson@example.com"
+
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+      click_on "Let’s go"
+      assert_selector "h1", text: "Check your email"
+    end
+
+    code = extract_code_from_last_email
+
+    fill_in "code", with: code
+    click_on "Verify"
+
+    assert_selector "h1", text: "Complete your sign-up"
+    fill_in "signup[full_name]", with: "New Person"
+    click_on "Continue"
+
+    assert_text "Playground"
+
+    identity = Identity.find_by!(email_address: "newperson@example.com")
+    account = identity.accounts.last
+    assert_not_nil account
+    assert_current_path %r{\A#{Regexp.escape(account.slug)}/}
+  end
+
+  test "join with a join code by email code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    visit join_url(code: join_code.code, script_name: account.slug)
+    fill_in "email_address", with: "joiningperson@example.com"
+
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+      click_on "Continue"
+      assert_selector "h1", text: "Check your email"
+    end
+
+    code = extract_code_from_last_email
+
+    fill_in "code", with: code
+    click_on "Verify"
+
+    # Verification auto-submits and advances to the name entry screen
+    assert_selector "h1", text: "Great! Now enter your name"
+    fill_in "user[name]", with: "Joining Person"
+    click_on "Continue"
+
+    assert_current_path %r{\A#{Regexp.escape(account.slug)}/}
+    assert_no_selector "h1", text: "Great! Now enter your name"
+
+    user = account.users.find_by!(identity: Identity.find_by!(email_address: "joiningperson@example.com"))
+    assert user.verified?
+    assert_equal "Joining Person", user.name
+  end
+
+  private
+    def extract_code_from_last_email
+      email = ActionMailer::Base.deliveries.last
+      assert_not_nil email, "Expected an email to be delivered"
+      match = email.subject.match(/([0-9A-Z]{6})\z/)
+      assert_not_nil match, "Expected 6-character code in email subject: #{email.subject.inspect}"
+      match[1]
+    end
+end
