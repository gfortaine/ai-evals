index 0000000..3863843
--- /dev/null
+++ b/app/controllers/concerns/authentication/via_magic_link.rb
@@ -0,0 +1,71 @@
+module Authentication::ViaMagicLink
+  extend ActiveSupport::Concern
+
+  included do
+    helper_method :email_address_pending_authentication
+  end
+
+  private
+    def ensure_that_email_address_pending_authentication_exists
+      unless email_address_pending_authentication.present?
+        respond_to do |format|
+          format.html { redirect_to new_session_path(script_name: nil), alert: "Enter your email address to sign in." }
+          format.json { render json: { message: "Enter your email address to sign in." }, status: :unauthorized }
+        end
+      end
+    end
+
+    def redirect_to_session_magic_link(magic_link)
+      serve_development_magic_link(magic_link)
+      set_pending_authentication_token(magic_link.identity.email_address, expires_at: magic_link.expires_at)
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path(script_name: nil) }
+        format.json { render json: { pending_authentication_token: pending_authentication_token }, status: :created }
+      end
+    end
+
+    def redirect_to_fake_session_magic_link(email_address)
+      set_pending_authentication_token(email_address)
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path(script_name: nil) }
+        format.json { render json: { pending_authentication_token: pending_authentication_token }, status: :created }
+      end
+    end
+
+    def serve_development_magic_link(magic_link)
+      if Rails.env.development?
+        flash[:magic_link_code] = magic_link.code
+      end
+    end
+
+    def set_pending_authentication_token(email_address, expires_at: MagicLink::EXPIRATION_TIME.from_now)
+      normalized_email = Identity.normalize_value_for(:email_address, email_address) || email_address.to_s
+      @pending_authentication_token = pending_authentication_token_verifier.generate(normalized_email, expires_at: expires_at)
+
+      cookies[:pending_authentication_token] = {
+        value: @pending_authentication_token,
+        httponly: true,
+        same_site: :lax,
+        expires: expires_at
+      }
+    end
+
+    def pending_authentication_token
+      @pending_authentication_token || cookies[:pending_authentication_token]
+    end
+
+    def email_address_pending_authentication
+      pending_authentication_token_verifier.verified(pending_authentication_token)
+    end
+
+    def clear_pending_authentication_token
+      @pending_authentication_token = nil
+      cookies.delete(:pending_authentication_token)
+    end
+
+    def pending_authentication_token_verifier
+      Rails.application.message_verifier(:pending_authentication)
+    end
+end
