+++ b/test/mailers/magic_link_mailer_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class MagicLinkMailerTest < ActionMailer::TestCase
+  test "sign_in_instructions for sign in includes code in subject and body" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+    assert_includes email.subject, magic_link.code
+    assert email.html_part.present?
+    assert email.text_part.present?
+    assert_includes email.html_part.body.decoded, magic_link.code
+    assert_includes email.text_part.body.decoded, magic_link.code
+    assert_match /15 minutes/i, email.html_part.body.decoded
+    assert_match /15 minutes/i, email.text_part.body.decoded
+  end
+
+  test "sign_in_instructions for sign up includes code in subject and sign up copy" do
+    magic_link = MagicLink.create!(identity: identities(:kevin), purpose: :sign_up)
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+    assert_match /Welcome to Fizzy/i, email.html_part.body.decoded
+    assert_match /Welcome to Fizzy/i, email.text_part.body.decoded
+    assert_includes email.html_part.body.decoded, magic_link.code
+    assert_includes email.text_part.body.decoded, magic_link.code
+  end
+end
