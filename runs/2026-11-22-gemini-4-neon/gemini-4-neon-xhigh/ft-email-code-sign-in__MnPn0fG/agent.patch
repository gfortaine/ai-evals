+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,305 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "show renders code form when pending authentication token is present" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      get session_magic_link_path
+
+      assert_response :success
+      assert_select "form[action=?][method='post']", session_magic_link_path do
+        assert_select "input[name='code']"
+      end
+      assert_in_body @identity.email_address
+    end
+  end
+
+  test "show redirects to new session when pending authentication token is missing" do
+    untenanted do
+      get session_magic_link_path
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "show redirects authenticated users" do
+    sign_in_as @identity
+
+    untenanted do
+      get session_magic_link_path
+
+      assert_redirected_to root_url
+    end
+  end
+
+  test "create signs in with valid code and consumes it" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      code = extract_code_from_last_email
+      assert_equal 6, code.length
+
+      assert_difference -> { MagicLink.count }, -1 do
+        post session_magic_link_path, params: { code: code }
+      end
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "create redirects back to original protected URL after signing in" do
+    target_url = cards_url(script_name: accounts("37s").slug)
+    get target_url
+    assert_redirected_to new_session_path(script_name: nil)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path(script_name: nil), params: { email_address: @identity.email_address }
+      end
+
+      post session_magic_link_path(script_name: nil), params: { code: extract_code_from_last_email }
+
+      assert_redirected_to target_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create accepts lowercase and spaced codes" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      code = extract_code_from_last_email
+      mangled = " #{code[0, 3].downcase} #{code[3, 3].downcase} "
+
+      post session_magic_link_path, params: { code: mangled }
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with sign up magic link redirects to signup completion" do
+    untenanted do
+      assert_emails 1 do
+        post signup_path, params: { signup: { email_address: "brandnew@example.com" } }
+      end
+
+      post session_magic_link_path, params: { code: extract_code_from_last_email }
+
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with invalid code redirects back and allows retry" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      code = extract_code_from_last_email
+
+      post session_magic_link_path, params: { code: "WRONG1" }
+
+      assert_redirected_to session_magic_link_path
+      assert_equal "Try another code.", flash[:alert]
+      assert_not cookies[:session_token].present?
+      assert cookies[:pending_authentication_token].present?
+
+      # Retrying with the valid code succeeds
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with blank code redirects back with alert" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+
+      post session_magic_link_path, params: { code: "" }
+
+      assert_redirected_to session_magic_link_path
+      assert_equal "Try another code.", flash[:alert]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create rejects reused code" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      token = cookies[:pending_authentication_token]
+      code = extract_code_from_last_email
+
+      post session_magic_link_path, params: { code: code }
+      assert cookies[:session_token].present?
+
+      sign_out
+
+      cookies[:pending_authentication_token] = token
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create succeeds before 15 minutes and fails at 15 minutes" do
+    freeze_time do
+      untenanted do
+        assert_emails 1 do
+          post session_path, params: { email_address: @identity.email_address }
+        end
+
+        code = extract_code_from_last_email
+
+        travel 14.minutes + 59.seconds
+        post session_magic_link_path, params: { code: code }
+
+        assert_redirected_to landing_url
+        assert cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create rejects expired code after 15 minutes" do
+    freeze_time do
+      untenanted do
+        assert_emails 1 do
+          post session_path, params: { email_address: @identity.email_address }
+        end
+
+        code = extract_code_from_last_email
+
+        travel 15.minutes
+        post session_magic_link_path, params: { code: code }
+
+        assert_redirected_to new_session_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create rejects expired magic link even with a fresh pending token" do
+    freeze_time do
+      untenanted do
+        assert_emails 1 do
+          post session_path, params: { email_address: @identity.email_address }
+        end
+
+        expired_code = extract_code_from_last_email
+
+        travel 14.minutes
+        assert_emails 1 do
+          post session_path, params: { email_address: @identity.email_address }
+        end
+
+        travel 1.minute
+        post session_magic_link_path, params: { code: expired_code }
+
+        assert_redirected_to session_magic_link_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create rejects another identity's code without consuming it" do
+    other_magic_link = identities(:david).magic_links.create!
+
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+
+      post session_magic_link_path, params: { code: other_magic_link.code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+      assert MagicLink.exists?(other_magic_link.id)
+    end
+  end
+
+  test "create via JSON succeeds and returns session token" do
+    untenanted do
+      assert_emails 1 do
+        post session_path(format: :json), params: { email_address: @identity.email_address }, as: :json
+      end
+
+      assert_response :created
+      pending_token = @response.parsed_body["pending_authentication_token"]
+      assert pending_token.present?
+
+      code = extract_code_from_last_email
+
+      post session_magic_link_path(format: :json),
+        params: { code: code },
+        headers: { "Cookie" => "pending_authentication_token=#{pending_token}" },
+        as: :json
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create via JSON with invalid code returns unauthorized" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: @identity.email_address }, as: :json
+      pending_token = @response.parsed_body["pending_authentication_token"]
+
+      post session_magic_link_path(format: :json),
+        params: { code: "WRONG1" },
+        headers: { "Cookie" => "pending_authentication_token=#{pending_token}" },
+        as: :json
+
+      assert_response :unauthorized
+      assert_equal "Try another code.", @response.parsed_body["message"]
+    end
+  end
+
+  test "create via JSON without pending authentication token returns unauthorized" do
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "ABC123" }, as: :json
+
+      assert_response :unauthorized
+    end
+  end
+
+  test "create is rate limited" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+
+      Rails.cache.stubs(:increment).returns(11)
+
+      post session_magic_link_path, params: { code: "ABC123" }
+      assert_redirected_to session_magic_link_path
+      assert_equal "Wait 15 minutes, then try again.", flash[:alert]
+
+      post session_magic_link_path(format: :json), params: { code: "ABC123" }, as: :json
+      assert_response :too_many_requests
+    end
+  end
+
+  private
+    def extract_code_from_last_email
+      email = ActionMailer::Base.deliveries.last
+      assert_not_nil email, "Expected an email to be delivered"
+      match = email.subject.match(/([0-9A-Z]{6})\z/)
+      assert_not_nil match, "Expected 6-character code in email subject: #{email.subject.inspect}"
+      match[1]
+    end
+end
