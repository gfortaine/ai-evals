+  def test_mail_link_token_written_by_rails_81_is_verifiable_on_rollback_to_rails_72
+    token = Mailer.mail_link_token(
+      :unwatch,
+      'user_id' => 3,
+      'issue_id' => 2,
+      'note' => "a\u2028b\u2029c"
+    )
+
+    # Rails 8.1 (`load_defaults 8.1`) writes the single-serialized JSON `_rails.data`
+    # envelope signed with HMAC-SHA1 using the SHA256 PBKDF2 key, wire-identical to
+    # deployed Rails 7.2 (`load_defaults 7.2`).
+    encoded_data, digest = token.split('--')
+    sha256_secret = derive_key('mail_links', 64, OpenSSL::Digest::SHA256)
+    expected_digest = OpenSSL::HMAC.hexdigest('SHA1', sha256_secret, encoded_data)
+    assert_equal expected_digest, digest
+
+    envelope = ActiveSupport::JSON.decode(Base64.strict_decode64(encoded_data))
+    assert envelope.key?('_rails')
+    assert envelope['_rails'].key?('data')
+    assert_not envelope['_rails'].key?('message')
+    assert_equal 'unwatch', envelope['_rails']['pur']
+    assert envelope['_rails']['exp'].present?
+    assert_equal(
+      {'user_id' => 3, 'issue_id' => 2, 'note' => "a\u2028b\u2029c"},
