+  def test_retired_sha1_and_marshal_session_cookies_are_not_accepted
+    user = User.find(2)
+    payload = build_session_payload(user)
+
+    # 1. Retired SHA1 aes-256-gcm session cookie
+    sha1_gcm_secret = derive_key(
+      'authenticated encrypted cookie',
+      ActiveSupport::MessageEncryptor.key_len('aes-256-gcm'),
+      OpenSSL::Digest::SHA1
+    )
+    sha1_gcm = ActiveSupport::MessageEncryptor.new(
+      sha1_gcm_secret,
+      cipher: 'aes-256-gcm',
+      serializer: ActiveSupport::MessageEncryptor::NullSerializer
+    )
+    cookies['_redmine_session'] = sha1_gcm.encrypt_and_sign(
+      JSON.generate(payload),
+      purpose: 'cookie._redmine_session'
+    )
+    get '/my/account'
+    assert_response :redirect
+
+    # 2. Retired SHA1 aes-256-cbc + Marshal session cookie
+    sha1_cbc_secret = derive_key(
+      'encrypted cookie',
+      ActiveSupport::MessageEncryptor.key_len('aes-256-cbc'),
+      OpenSSL::Digest::SHA1
+    )
+    sha1_sign_secret = derive_key('signed encrypted cookie', 64, OpenSSL::Digest::SHA1)
+    sha1_cbc = ActiveSupport::MessageEncryptor.new(
+      sha1_cbc_secret,
+      sha1_sign_secret,
+      cipher: 'aes-256-cbc',
+      digest: 'SHA1',
+      serializer: ActiveSupport::MessageEncryptor::NullSerializer
+    )
+    cookies['_redmine_session'] = sha1_cbc.encrypt_and_sign(Marshal.dump(payload))
+    get '/my/account'
