+  def test_signed_and_encrypted_cookies_are_bidirectional_with_deployed_rails_72
+    sha256_signed_secret = derive_key('signed cookie', 64, OpenSSL::Digest::SHA256)
+    verifier = ActiveSupport::MessageVerifier.new(
+      sha256_signed_secret,
+      digest: 'SHA1',
+      serializer: ActiveSupport::MessageEncryptor::NullSerializer
+    )
+    signed_from_72 = verifier.generate(
+      JSON.generate('hello' => "rails72\u2028\u2029").gsub("\u2028", '\u2028').gsub("\u2029", '\u2029'),
+      purpose: 'cookie.test_signed'
+    )
+    encrypted_from_72 = encrypt_sha256_json_cookie(
+      {'hello' => "rails72\u2028\u2029"},
+      cookie_name: 'test_encrypted',
+      escape_js_separators: true
+    )
+
+    env = Rack::MockRequest.env_for(
+      '/',
+      'HTTP_COOKIE' => "test_signed=#{CGI.escape(signed_from_72)}; test_encrypted=#{CGI.escape(encrypted_from_72)}"
+    )
+    env.merge!(Rails.application.env_config)
+    request = ActionDispatch::Request.new(env)
+
+    assert_equal({'hello' => "rails72\u2028\u2029"}, request.cookie_jar.signed['test_signed'])
+    assert_equal({'hello' => "rails72\u2028\u2029"}, request.cookie_jar.encrypted['test_encrypted'])
+
+    # Reverse direction: write with Rails 8.1 and verify/decrypt with Rails 7.2 wire parameters
+    write_env = Rack::MockRequest.env_for('/').merge(Rails.application.env_config)
+    jar = ActionDispatch::Request.new(write_env).cookie_jar
+    jar.signed['test_signed'] = {value: {'hello' => "rails81\u2028\u2029"}}
+    jar.encrypted['test_encrypted'] = {value: {'hello' => "rails81\u2028\u2029"}}
+    resp = ActionDispatch::Response.new
+    jar.write(resp)
+    set_cookies = Array(resp.headers['set-cookie'])
+    raw_signed_81 = CGI.unescape(set_cookies.find {|c| c.start_with?('test_signed=')}[/^test_signed=([^;]+)/, 1])
+    raw_encrypted_81 = CGI.unescape(set_cookies.find {|c| c.start_with?('test_encrypted=')}[/^test_encrypted=([^;]+)/, 1])
+
+    assert_equal(
+      {'hello' => "rails81\u2028\u2029"},
+      ActiveSupport::JSON.decode(verifier.verify(raw_signed_81, purpose: 'cookie.test_signed'))
+    )
+
+    sha256_gcm_secret = derive_key(
+      'authenticated encrypted cookie',
+      ActiveSupport::MessageEncryptor.key_len('aes-256-gcm'),
+      OpenSSL::Digest::SHA256
+    )
+    encryptor = ActiveSupport::MessageEncryptor.new(
+      sha256_gcm_secret,
+      cipher: 'aes-256-gcm',
+      serializer: ActiveSupport::MessageEncryptor::NullSerializer
+    )
+    assert_equal(
+      {'hello' => "rails81\u2028\u2029"},
+      ActiveSupport::JSON.decode(encryptor.decrypt_and_verify(raw_encrypted_81, purpose: 'cookie.test_encrypted'))
+    )
+  end
