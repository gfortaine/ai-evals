+      sha256_gcm_secret,
+      cipher: 'aes-256-gcm',
+      serializer: ActiveSupport::MessageEncryptor::NullSerializer
+    )
+    cookies['_redmine_session'] = sha256_gcm.encrypt_and_sign(
