diff --git a/app/controllers/application_controller.rb b/app/controllers/application_controller.rb
index 85e6588..eeb1223 100644
--- a/app/controllers/application_controller.rb
+++ b/app/controllers/application_controller.rb
@@ -791,4 +791,21 @@ class ApplicationController < ActionController::Base
   def _include_layout?(*args)
     api_request? ? false : super
   end
+
+  private
+
+  # Accept per-form CSRF tokens on verification even while per_form_csrf_tokens is false.
+  # This keeps generating global CSRF tokens (safe for rollback to the prior Rails 6.1 release)
+  # while also accepting forms rendered by the next Rails 7.0 release (load_defaults 7.0) after
+  # a rollback, avoiding InvalidAuthenticityToken -> handle_unverified_request signing users out.
+  def valid_per_form_csrf_token?(token, session)
+    return super if per_form_csrf_tokens
+
+    correct_token = per_form_csrf_token(
+      session,
+      request.path.chomp("/"),
+      request.request_method
+    )
+    ActiveSupport::SecurityUtils.fixed_length_secure_compare(token, correct_token)
+  end
 end
