diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..f5bbfb3
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,366 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { Turbo } from "@hotwired/turbo-rails"
+import { isMobile } from "helpers/platform_helpers"
+import { onNextEventLoopTick } from "helpers/timing_helpers"
+
+const ITEM_SELECTOR = '[data-drag-and-drop-target~="item"]'
+const CONTAINER_SELECTOR = '[data-drag-and-drop-target~="container"]'
+
+export default class extends Controller {
+  static targets = [ "container", "item" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  #draggedItem = null
+  #sourceContainer = null
+  #hoveredContainer = null
+  #saveQueue = Promise.resolve()
+
+  connect() {
+    this.mediaQuery = window.matchMedia(this.desktopBreakpointValue)
+    this.handleMediaChange = this.#refreshDraggable.bind(this)
+    this.mediaQuery.addEventListener("change", this.handleMediaChange)
+    this.#refreshDraggable()
+  }
+
+  disconnect() {
+    this.mediaQuery?.removeEventListener("change", this.handleMediaChange)
+    this.#clearDragState()
+  }
+
+  itemTargetConnected(item) {
+    if (this.mediaQuery) {
+      item.draggable = this.#enabled
+    }
+  }
+
+  preserveDraggable(event) {
+    if (event.detail.attributeName === "draggable" && event.target.matches(ITEM_SELECTOR)) {
+      event.preventDefault()
+    }
+  }
+
+  dragStart(event) {
+    if (!this.#enabled) {
+      event.preventDefault()
+      return
+    }
+
+    const item = event.currentTarget
+    const sourceContainer = item.closest(CONTAINER_SELECTOR)
+    if (!sourceContainer) return
+
+    this.#draggedItem = item
+    this.#sourceContainer = sourceContainer
+
+    item.removeAttribute("aria-selected")
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.id)
+    }
+
+    onNextEventLoopTick(() => {
+      if (this.#draggedItem === item) {
+        item.classList.add(this.draggedItemClass)
+      }
+    })
+  }
+
+  dragEnter(event) {
+    if (!this.#draggedItem) return
+
+    const container = event.currentTarget
+    if (container === this.#sourceContainer) {
+      this.#clearHoverContainer()
+      return
+    }
+
+    event.preventDefault()
+    this.#setHoverContainer(container)
+  }
+
+  dragOver(event) {
+    if (!this.#draggedItem) return
+
+    const container = event.currentTarget
+    if (container === this.#sourceContainer) {
+      this.#clearHoverContainer()
+      return
+    }
+
+    event.preventDefault()
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+    this.#setHoverContainer(container)
+  }
+
+  dragLeave(event) {
+    if (!this.#draggedItem) return
+
+    const container = event.currentTarget
+    if (container !== this.#hoveredContainer) return
+
+    if (event.relatedTarget && container.contains(event.relatedTarget)) return
+
+    if (!event.relatedTarget && (event.clientX !== 0 || event.clientY !== 0)) {
+      const rect = container.getBoundingClientRect()
+      const inside =
+        event.clientX >= rect.left &&
+        event.clientX <= rect.right &&
+        event.clientY >= rect.top &&
+        event.clientY <= rect.bottom
+      if (inside) return
+    }
+
+    this.#clearHoverContainer()
+  }
+
+  drop(event) {
+    if (!this.#draggedItem) return
+
+    const item = this.#draggedItem
+    const sourceContainer = this.#sourceContainer
+    const targetContainer = event.currentTarget
+
+    this.#clearDragState()
+
+    if (targetContainer === sourceContainer) return
+
+    event.preventDefault()
+    this.#moveItem(item, sourceContainer, targetContainer)
+  }
+
+  dragEnd() {
+    this.#clearDragState()
+  }
+
+  // Private
+
+  get #enabled() {
+    return Boolean(this.mediaQuery?.matches) && !isMobile()
+  }
+
+  #refreshDraggable() {
+    const enabled = this.#enabled
+    this.itemTargets.forEach(item => {
+      item.draggable = enabled
+    })
+  }
+
+  #setHoverContainer(container) {
+    if (this.#hoveredContainer === container) return
+
+    this.#clearHoverContainer()
+    this.#hoveredContainer = container
+    container.classList.add(this.hoverContainerClass)
+  }
+
+  #clearHoverContainer() {
+    if (this.#hoveredContainer) {
+      this.#hoveredContainer.classList.remove(this.hoverContainerClass)
+      this.#hoveredContainer = null
+    }
+  }
+
+  #clearDragState() {
+    this.#clearHoverContainer()
+
+    if (this.#draggedItem) {
+      this.#draggedItem.classList.remove(this.draggedItemClass)
+      this.#draggedItem = null
+    }
+
+    this.#sourceContainer = null
+  }
+
+  #moveItem(item, sourceContainer, targetContainer) {
+    const snapshot = this.#captureSnapshot(item, sourceContainer, targetContainer)
+
+    this.#applyCardState(item, targetContainer)
+    const inserted = this.#insertItem(item, targetContainer)
+    this.#adjustCount(sourceContainer, -1)
+    this.#adjustCount(targetContainer, 1)
+
+    this.#enqueueSave(async () => {
+      try {
+        const response = await this.#persistMove(item, targetContainer)
+        if (!response?.ok) {
+          this.#rollback(snapshot, inserted)
+        } else if (!inserted) {
+          targetContainer.querySelector("turbo-frame")?.reload()
+        }
+      } catch {
+        this.#rollback(snapshot, inserted)
+      }
+    })
+  }
+
+  #captureSnapshot(item, sourceContainer, targetContainer) {
+    const updatedTime = item.querySelector(".card__meta-text--updated time[datetime]")
+    const stamps = Array.from(item.querySelectorAll(".card__closed"))
+    const bubble = item.querySelector(".bubble")
+
+    return {
+      item,
+      sourceContainer,
+      targetContainer,
+      originalParent: item.parentElement,
+      originalNextSibling: item.nextSibling,
+      originalColor: item.style.getPropertyValue("--card-color"),
+      originalPostponed: item.classList.contains("card--postponed"),
+      originalActive: item.classList.contains("card--active"),
+      removedStamps: stamps.map(node => ({ node, parent: node.parentElement, nextSibling: node.nextSibling })),
+      removedBubble: bubble ? { node: bubble, parent: bubble.parentElement, nextSibling: bubble.nextSibling } : null,
+      updatedTime,
+      originalUpdatedDatetime: updatedTime?.getAttribute("datetime") ?? null
+    }
+  }
+
+  #applyCardState(item, targetContainer) {
+    const dropType = targetContainer.dataset.dragAndDropDropType
+    const cardColor = targetContainer.dataset.cardColor
+
+    if (document.activeElement === item) {
+      item.blur()
+    }
+    item.removeAttribute("aria-selected")
+
+    if (cardColor) {
+      item.style.setProperty("--card-color", cardColor)
+    }
+
+    item.classList.toggle("card--postponed", dropType === "not_now")
+    item.classList.toggle("card--active", dropType === "stream" || dropType === "column")
+
+    item.querySelectorAll(".card__closed").forEach(stamp => stamp.remove())
+    item.querySelector(".bubble")?.remove()
+
+    const updatedTime = item.querySelector(".card__meta-text--updated time[datetime]")
+    if (updatedTime) {
+      updatedTime.setAttribute("datetime", String(Math.floor(Date.now() / 1000)))
+    }
+  }
+
+  #insertItem(item, targetContainer) {
+    const targetList = targetContainer.querySelector(".cards__list")
+    if (!targetList) {
+      item.remove()
+      return false
+    }
+
+    const goldenFirst = targetContainer.dataset.dragAndDropGoldenFirst === "true"
+    const isGolden = item.classList.contains("golden-effect")
+
+    if (goldenFirst && !isGolden) {
+      const firstNonGolden = targetList.querySelector(`${ITEM_SELECTOR}:not(.golden-effect)`)
+      if (firstNonGolden) {
+        firstNonGolden.before(item)
+        return true
+      }
+
+      const cards = targetList.querySelectorAll(ITEM_SELECTOR)
+      if (cards.length > 0) {
+        cards[cards.length - 1].after(item)
+        return true
+      }
+    } else {
+      const firstCard = targetList.querySelector(ITEM_SELECTOR)
+      if (firstCard) {
+        firstCard.before(item)
+        return true
+      }
+    }
+
+    const paginationFrame = targetList.querySelector("turbo-frame")
+    if (paginationFrame) {
+      paginationFrame.prepend(item)
+    } else {
+      targetList.prepend(item)
+    }
+
+    return true
+  }
+
+  #adjustCount(container, delta) {
+    const countEl = container.querySelector(".cards__expander-count")
+    if (!countEl) return
+
+    const current = parseInt(countEl.dataset.count ?? countEl.textContent, 10)
+    if (Number.isNaN(current)) return
+
+    const next = Math.max(0, current + delta)
+    countEl.dataset.count = next
+    countEl.textContent = next > 99 ? "99+" : String(next)
+  }
+
+  #enqueueSave(task) {
+    this.#saveQueue = this.#saveQueue.then(task, task)
+  }
+
+  #persistMove(item, targetContainer) {
+    const dropType = targetContainer.dataset.dragAndDropDropType
+
+    switch (dropType) {
+      case "not_now":
+        return post(item.dataset.cardNotNowUrl, { responseKind: "json" })
+      case "closed":
+        return post(item.dataset.cardClosureUrl, { responseKind: "json" })
+      case "stream":
+        return destroy(item.dataset.cardTriageUrl, { responseKind: "json" })
+      case "column":
+        return post(item.dataset.cardTriageUrl, {
+          body: { column_id: targetContainer.dataset.dragAndDropColumnId },
+          responseKind: "json"
+        })
+      default:
+        return Promise.resolve(null)
+    }
+  }
+
+  #rollback(snapshot, inserted) {
+    const { item, sourceContainer, targetContainer, originalParent, originalNextSibling } = snapshot
+
+    if (item.isConnected && !targetContainer.contains(item)) return
+
+    const canRevertInPlace = originalParent?.isConnected && (
+      inserted ? targetContainer.contains(item) : !item.isConnected
+    )
+
+    if (!canRevertInPlace) {
+      Turbo.visit(window.location.href, { action: "replace" })
+      return
+    }
+
+    if (snapshot.originalColor) {
+      item.style.setProperty("--card-color", snapshot.originalColor)
+    } else {
+      item.style.removeProperty("--card-color")
+    }
+
+    item.classList.toggle("card--postponed", snapshot.originalPostponed)
+    item.classList.toggle("card--active", snapshot.originalActive)
+
+    snapshot.removedStamps.forEach(({ node, parent, nextSibling }) => {
+      parent?.insertBefore(node, nextSibling?.parentElement === parent ? nextSibling : null)
+    })
+
+    if (snapshot.removedBubble) {
+      const { node, parent, nextSibling } = snapshot.removedBubble
+      parent?.insertBefore(node, nextSibling?.parentElement === parent ? nextSibling : null)
+    }
+
+    if (snapshot.updatedTime && snapshot.originalUpdatedDatetime !== null) {
+      snapshot.updatedTime.setAttribute("datetime", snapshot.originalUpdatedDatetime)
+    }
+
+    originalParent.insertBefore(item, originalNextSibling?.parentElement === originalParent ? originalNextSibling : null)
+
+    this.#adjustCount(targetContainer, -1)
+    this.#adjustCount(sourceContainer, 1)
+  }
+}
