+    assert_equal expected_after_non_golden, card_ids_in("##{dom_id(@triage)}")
+
+    # 2. Golden into Triage -> lands at VERY TOP (before older golden logo)
+    expand_column "##{dom_id(@in_progress)}"
+    assert_selector "##{dom_id(@in_progress)} ##{dom_id(golden, :article)}"
+    drag_card_to_column golden, "##{dom_id(@triage)}"
+    wait_until { golden.reload.column == @triage }
+
+    expand_column "##{dom_id(@triage)}"
+    expected_after_golden = [
+      dom_id(golden, :article),
+      dom_id(cards(:logo), :article),
+      dom_id(non_golden, :article),
+      dom_id(cards(:layout), :article)
+    ]
+    assert_equal expected_after_golden, card_ids_in("##{dom_id(@triage)}")
+
+    visit_board
+    expand_column "##{dom_id(@triage)}"
+    assert_equal expected_after_golden, card_ids_in("##{dom_id(@triage)}")
+
+    # 3. Non-golden into column with ONLY golden cards -> lands AFTER the golden card
+    cards(:text).triage_into(@in_progress) # golden card alone in In progress
+    visit_board
+    expand_column "##{dom_id(@in_progress)}"
+    assert_equal [ dom_id(golden, :article) ], card_ids_in("##{dom_id(@in_progress)}")
+
+    # Send non_golden to Maybe? then drag into In progress (which has only golden)
+    non_golden.send_back_to_triage
+    visit_board
+    expand_column "##{dom_id(@in_progress)}"
+    drag_card_to_column non_golden, "##{dom_id(@in_progress)}"
+    expected_all_golden_dest = [ dom_id(golden, :article), dom_id(non_golden, :article) ]
+    assert_equal expected_all_golden_dest, card_ids_in("##{dom_id(@in_progress)}")
+    wait_until { non_golden.reload.column == @in_progress }
+
+    visit_board
+    expand_column "##{dom_id(@in_progress)}"
+    assert_equal expected_all_golden_dest, card_ids_in("##{dom_id(@in_progress)}")
+
+    # 4. Non-golden into Done with a golden card -> Done sorts recently_closed_first (top)
+    cards(:shipping).gild
+    visit_board
+    expand_column "##{dom_id(@in_progress)}"
+    drag_card_to_column non_golden, "#closed-cards"
+    wait_until { non_golden.reload.closed? }
+
+    expand_column "#closed-cards"
+    expected_done_order = [
+      dom_id(non_golden, :article),
