diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..39616a5
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,129 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @manual_leaf = books(:manual).press Page.new(body: "Confidential content"), title: "Secret Manual Page"
+    sign_in :kevin
+  end
+
+  test "show renders empty search without query" do
+    get library_search_path
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "show finds matching pages in accessible books" do
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /The Welcome Section/
+    assert_select "a.search__result", text: /Welcome to The Handbook!/
+    assert_select "a.search__result", count: 2
+  end
+
+  test "show does not return pages from books the user cannot open" do
+    get library_search_path, params: { q: "Secret" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_select "p.search__no_matches"
+  end
+
+  test "show returns pages from published books when signed out and hides unpublished books" do
+    books(:handbook).update!(published: true)
+    sign_out
+
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_select "a.search__result", text: /Welcome to The Handbook!/
+
+    get library_search_path, params: { q: "Secret" }
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "show returns no matches when signed out and no books are published" do
+    sign_out
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_select "p.search__no_matches"
+  end
+
+  test "show treats SQL injection payloads as literal data" do
+    [
+      "' OR 1=1 OR ''='",
+      "') OR 1=1 --",
+      "' OR '1'='1",
+      "' UNION SELECT * FROM leaves --"
+    ].each do |payload|
+      get library_search_path, params: { q: payload }
+
+      assert_response :success
+      assert_select "a.search__result", count: 0
+    end
+  end
+
+  test "show handles apostrophes and punctuation without error and finds matching titles" do
+    books(:handbook).press Page.new(body: "Body"), title: "It's O'Reilly's Guide"
+
+    get library_search_path, params: { q: "'" }
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /It's O'Reilly's Guide/
+
+    get library_search_path, params: { q: "It's" }
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /It's O'Reilly's Guide/
+  end
+
+  test "show treats percent sign as a literal character rather than a wildcard" do
+    books(:handbook).press Page.new(body: "Discount"), title: "Save 50% off"
+    books(:handbook).press Page.new(body: "Other"), title: "Save 500 off"
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /Save 50% off/
+
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /Save 50% off/
+  end
+
+  test "show treats underscore as a literal character rather than a wildcard" do
+    books(:handbook).press Page.new(body: "Code"), title: "snake_case"
+    books(:handbook).press Page.new(body: "Code"), title: "snakeXcase"
+
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /snake_case/
+
+    get library_search_path, params: { q: "_______" }
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "show treats backslash as a literal character" do
+    books(:handbook).press Page.new(body: "Path"), title: "C:\\Docs"
+
+    get library_search_path, params: { q: "\\" }
+    assert_response :success
+    assert_select "a.search__result", count: 1, text: /C:\\Docs/
+
+    get library_search_path, params: { q: "\\%" }
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "show excludes trashed leaves" do
+    leaves(:summary_page).trashed!
+
+    get library_search_path, params: { q: "Summary" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_select "p.search__no_matches"
+  end
+end
