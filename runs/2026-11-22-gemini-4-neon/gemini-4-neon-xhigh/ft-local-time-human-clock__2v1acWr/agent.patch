diff --git a/test/controllers/local_time_rendering_test.rb b/test/controllers/local_time_rendering_test.rb
new file mode 100644
index 0000000..2fb330a
--- /dev/null
+++ b/test/controllers/local_time_rendering_test.rb
@@ -0,0 +1,152 @@
+require "test_helper"
+
+class LocalTimeRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "card show renders raw UTC timestamps for meta, comments, and auto-close notice" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    get card_path(card)
+    assert_response :success
+
+    assert_select "body[data-controller~='local-time']"
+    assert_select ".card__meta-text--added time.local-time-value[datetime='#{card.created_at.utc.iso8601}'][data-local-time-target='daysago']", text: ""
+    assert_select ".card__meta-text--updated time.local-time-value[datetime='#{card.last_active_at.utc.iso8601}'][data-local-time-target='daysago']", text: ""
+    assert_select "##{dom_id(comment)} .comment__permalink-title time.local-time-value[datetime='#{comment.created_at.utc.iso8601}'][data-local-time-target='daysago']", text: ""
+
+    assert_select "##{dom_id(card, :closure_notice)}" do |elements|
+      assert_no_match(/\bin\s+<time/, elements.first.to_html)
+      assert_select "time.local-time-value[datetime='#{card.entropy.auto_clean_at.utc.iso8601}'][data-local-time-target='indays']", text: ""
+    end
+  end
+
+  test "closed card renders raw UTC timestamps for stamp, bridge description, and closure message" do
+    card = cards(:shipping)
+    assert card.closed?
+
+    get card_path(card)
+    assert_response :success
+
+    iso = card.closed_at.utc.iso8601
+    assert_select ".card__closed[data-local-time-target='date'][data-local-time-attribute='data-bridge-description'][data-datetime='#{iso}']"
+    assert_select ".card__closed[data-bridge-description]", count: 0
+    assert_select ".card__closed-date time.local-time-value[datetime='#{iso}'][data-local-time-target='date']", text: ""
+    assert_select ".card-perma__closure-message time.local-time-value[datetime='#{iso}'][data-local-time-target='shortdate']", text: ""
+  end
+
+  test "postponed card renders raw UTC timestamps for stamp and bridge description" do
+    card = cards(:layout)
+    card.postpone(user: users(:kevin))
+
+    get card_path(card)
+    assert_response :success
+
+    iso = card.postponed_at.utc.iso8601
+    assert_select ".card__closed[data-local-time-target='date'][data-local-time-attribute='data-bridge-description'][data-datetime='#{iso}']"
+    assert_select ".card__closed[data-bridge-description]", count: 0
+    assert_select ".card__closed-date time.local-time-value[datetime='#{iso}'][data-local-time-target='date']", text: ""
+  end
+
+  test "cached card and comment HTML is identical across viewer timezones" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    with_actionview_partial_caching do
+      cookies[:timezone] = "America/Los_Angeles"
+      get card_path(card)
+      assert_response :success
+      la_meta_html = css_select("##{dom_id(card, :meta)}").to_html
+      la_closure_html = css_select("##{dom_id(card, :closure_notice)}").to_html
+      la_comment_html = css_select("##{dom_id(comment)}").to_html
+
+      cookies[:timezone] = "Asia/Tokyo"
+      get card_path(card)
+      assert_response :success
+      tokyo_meta_html = css_select("##{dom_id(card, :meta)}").to_html
+      tokyo_closure_html = css_select("##{dom_id(card, :closure_notice)}").to_html
+      tokyo_comment_html = css_select("##{dom_id(comment)}").to_html
+
+      assert_equal la_comment_html, tokyo_comment_html
+      assert_equal la_meta_html, tokyo_meta_html
+      assert_equal la_closure_html, tokyo_closure_html
+    end
+  end
+
+  test "public card and board render local-time controller and raw UTC timestamps" do
+    board = boards(:writebook)
+    board.publish
+    card = cards(:logo)
+
+    sign_out
+    get published_card_path(card)
+    assert_response :success
+
+    assert_select "body[data-controller~='local-time']"
+    assert_select ".card__meta-text--added time.local-time-value[datetime='#{card.created_at.utc.iso8601}'][data-local-time-target='daysago']", text: ""
+    assert_select ".card__meta-text--updated time.local-time-value[datetime='#{card.last_active_at.utc.iso8601}'][data-local-time-target='daysago']", text: ""
+  end
+
+  test "notifications render raw UTC timestamps" do
+    notification = notifications(:logo_assignment_kevin)
+
+    get notifications_path
+    assert_response :success
+
+    assert_select "##{dom_id(notification)} .card__timestamp time.local-time-value[datetime='#{notification.created_at.utc.iso8601}'][data-local-time-target='daysago']", text: ""
+  end
+
+  test "access tokens render raw UTC timestamps" do
+    token = identities(:kevin).access_tokens.create!(description: "CLI token", permission: "read")
+
+    get my_access_tokens_path
+    assert_response :success
+
+    assert_select "td time.local-time-value[datetime='#{token.created_at.utc.iso8601}'][data-local-time-target='datetime']", text: ""
+  end
+
+  test "webhook deliveries render raw UTC timestamps" do
+    webhook = webhooks(:active)
+    delivery = webhook_deliveries(:successfully_completed)
+
+    get board_webhook_path(webhook.board, webhook)
+    assert_response :success
+
+    assert_select "##{dom_id(delivery)} time.local-time-value[datetime='#{delivery.created_at.utc.iso8601}'][data-local-time-target='daysago']", text: ""
+  end
+
+  test "events timeline renders raw UTC timestamps for column headers, hourly blocks, and empty days" do
+    travel_to Time.utc(2025, 1, 22, 17, 30, 0)
+    event = events(:layout_assignment_jz)
+    event.update!(created_at: Time.current.beginning_of_day + 8.hours)
+
+    earlier_event = events(:logo_published)
+    earlier_event.update!(created_at: 4.days.ago)
+
+    get events_path
+    assert_response :success
+
+    assert_select ".events__column-header time.local-time-value[data-local-time-target='agoday']", text: ""
+    assert_select ".event__timestamp time.local-time-value[datetime='#{event.created_at.utc.iso8601}'][data-local-time-target='time']", text: ""
+    assert_select ".events__none time.local-time-value[data-local-time-target='agoday']", text: ""
+  end
+
+  test "expanded events column renders raw UTC timestamp in header" do
+    get events_day_timeline_column_path("added")
+    assert_response :success
+
+    assert_select "h1.header__title time.local-time-value[data-local-time-target='agoday']", text: ""
+  end
+
+  test "search results render raw UTC timestamps" do
+    card = cards(:logo)
+    card.reindex
+
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select ".search__result time.local-time-value[data-local-time-target='daysago']", text: ""
+  end
+end
