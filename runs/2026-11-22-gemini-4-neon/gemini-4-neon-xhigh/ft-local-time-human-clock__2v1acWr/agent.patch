diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..d8a8d5d
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,137 @@
+import { Controller } from "@hotwired/stimulus"
+import {
+  parseDate,
+  formatTime,
+  formatDate,
+  formatShortDate,
+  formatDatetime,
+  formatDaysAgo,
+  formatInDays,
+  formatAgoDay,
+  formatFullDate,
+  formatFullDatetime
+} from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 30_000 // 30 seconds
+
+const FORMATTERS = {
+  time: formatTime,
+  date: formatDate,
+  shortdate: formatShortDate,
+  datetime: formatDatetime,
+  daysago: formatDaysAgo,
+  indays: formatInDays,
+  agoday: formatAgoDay
+}
+
+const DATE_ONLY_STYLES = new Set([ "date", "shortdate", "agoday" ])
+
+export default class extends Controller {
+  static targets = [ "time", "date", "shortdate", "datetime", "daysago", "indays", "agoday" ]
+
+  #timer
+
+  connect() {
+    this.#timer = setInterval(() => this.refreshAll(), REFRESH_INTERVAL)
+    document.addEventListener("visibilitychange", this.#handleVisibilityChange)
+    document.addEventListener("turbo:morph", this.#handleMorph)
+    document.addEventListener("turbo:morph-element", this.#handleMorphElement)
+    document.addEventListener("turbo:frame-render", this.#handleFrameRender)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+    document.removeEventListener("visibilitychange", this.#handleVisibilityChange)
+    document.removeEventListener("turbo:morph", this.#handleMorph)
+    document.removeEventListener("turbo:morph-element", this.#handleMorphElement)
+    document.removeEventListener("turbo:frame-render", this.#handleFrameRender)
+  }
+
+  timeTargetConnected(target) { this.#formatTarget(target, "time") }
+  dateTargetConnected(target) { this.#formatTarget(target, "date") }
+  shortdateTargetConnected(target) { this.#formatTarget(target, "shortdate") }
+  datetimeTargetConnected(target) { this.#formatTarget(target, "datetime") }
+  daysagoTargetConnected(target) { this.#formatTarget(target, "daysago") }
+  indaysTargetConnected(target) { this.#formatTarget(target, "indays") }
+  agodayTargetConnected(target) { this.#formatTarget(target, "agoday") }
+
+  refreshAll() {
+    const now = new Date()
+
+    for (const style of this.constructor.targets) {
+      for (const target of this[`${style}Targets`]) {
+        this.#formatTarget(target, style, now)
+      }
+    }
+  }
+
+  #handleVisibilityChange = () => {
+    if (document.visibilityState === "visible") {
+      this.refreshAll()
+    }
+  }
+
+  #handleMorph = () => {
+    this.refreshAll()
+  }
+
+  #handleMorphElement = (event) => {
+    const element = event.target
+    if (!(element instanceof Element)) return
+
+    this.#formatElementIfTarget(element)
+  }
+
+  #handleFrameRender = (event) => {
+    const frame = event.target
+    if (!(frame instanceof Element)) return
+
+    const now = new Date()
+    for (const element of frame.querySelectorAll("[data-local-time-target]")) {
+      this.#formatElementIfTarget(element, now)
+    }
+  }
+
+  #formatElementIfTarget(element, now = new Date()) {
+    const targetValue = element.dataset.localTimeTarget
+    if (!targetValue) return
+
+    for (const style of targetValue.trim().split(/\s+/)) {
+      if (FORMATTERS[style]) {
+        this.#formatTarget(element, style, now)
+      }
+    }
+  }
+
+  #formatTarget(target, style, now = new Date()) {
+    const rawDatetime = target.getAttribute("datetime") || target.dataset.datetime
+    const date = parseDate(rawDatetime)
+    if (!date) return
+
+    const formatted = FORMATTERS[style](date, now)
+    const attribute = target.dataset.localTimeAttribute
+
+    if (attribute) {
+      if (target.getAttribute(attribute) !== formatted) {
+        target.setAttribute(attribute, formatted)
+      }
+    } else {
+      if (target.textContent !== formatted) {
+        target.textContent = formatted
+      }
+
+      const title = this.#formatTitle(date, style)
+      if (target.title !== title) {
+        target.title = title
+      }
+    }
+  }
+
+  #formatTitle(date, style) {
+    if (DATE_ONLY_STYLES.has(style)) {
+      return formatFullDate(date)
+    } else {
+      return formatFullDatetime(date)
+    }
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..6449784
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,101 @@
+export function parseDate(value) {
+  if (!value) return null
+
+  const dateOnlyMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value)
+  const date = dateOnlyMatch
+    ? new Date(Number(dateOnlyMatch[1]), Number(dateOnlyMatch[2]) - 1, Number(dateOnlyMatch[3]))
+    : new Date(value)
+
+  return Number.isNaN(date.getTime()) ? null : date
+}
+
+export function differenceInCalendarDays(fromDate, toDate) {
+  const fromDay = Date.UTC(fromDate.getFullYear(), fromDate.getMonth(), fromDate.getDate())
+  const toDay = Date.UTC(toDate.getFullYear(), toDate.getMonth(), toDate.getDate())
+  return Math.round((toDay - fromDay) / (1000 * 60 * 60 * 24))
+}
+
+export function formatTime(date) {
+  return normalizeSpaces(getFormatters().time.format(date))
+}
+
+export function formatDate(date) {
+  return normalizeSpaces(getFormatters().date.format(date))
+}
+
+export function formatShortDate(date, now = new Date()) {
+  if (date.getFullYear() === now.getFullYear()) {
+    return normalizeSpaces(getFormatters().shortDate.format(date))
+  } else {
+    return formatDate(date)
+  }
+}
+
+export function formatDatetime(date) {
+  return normalizeSpaces(getFormatters().datetime.format(date))
+}
+
+export function formatDaysAgo(date, now = new Date()) {
+  const diffDays = differenceInCalendarDays(now, date)
+
+  if (diffDays === 0) {
+    return formatTime(date)
+  } else if (diffDays >= -6 && diffDays <= 6) {
+    return getFormatters().relativeDay.format(diffDays, "day")
+  } else {
+    return formatShortDate(date, now)
+  }
+}
+
+export function formatInDays(date, now = new Date()) {
+  const diffDays = Math.max(0, differenceInCalendarDays(now, date))
+  return getFormatters().relativeDay.format(diffDays, "day")
+}
+
+export function formatAgoDay(date, now = new Date()) {
+  const diffDays = differenceInCalendarDays(now, date)
+
+  if (diffDays >= -1 && diffDays <= 1) {
+    return getFormatters().relativeDay.format(diffDays, "day")
+  } else if (date.getFullYear() === now.getFullYear()) {
+    return normalizeSpaces(getFormatters().longDate.format(date))
+  } else {
+    return normalizeSpaces(getFormatters().longDateWithYear.format(date))
+  }
+}
+
+export function formatFullDate(date) {
+  return normalizeSpaces(getFormatters().fullDate.format(date))
+}
+
+export function formatFullDatetime(date) {
+  return normalizeSpaces(getFormatters().fullDatetime.format(date))
+}
+
+let cachedTimeZone
+let formatters
+
+function getFormatters() {
+  const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone
+
+  if (!formatters || cachedTimeZone !== timeZone) {
+    cachedTimeZone = timeZone
+    formatters = {
+      time: new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }),
+      shortDate: new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" }),
+      date: new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }),
+      longDate: new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }),
+      longDateWithYear: new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" }),
+      datetime: new Intl.DateTimeFormat("en-US", { dateStyle: "short", timeStyle: "short" }),
+      fullDate: new Intl.DateTimeFormat("en-US", { dateStyle: "full" }),
+      fullDatetime: new Intl.DateTimeFormat("en-US", { dateStyle: "full", timeStyle: "short" }),
+      relativeDay: new Intl.RelativeTimeFormat("en-US", { numeric: "auto" })
+    }
+  }
+
+  return formatters
+}
+
+function normalizeSpaces(string) {
+  return string.replace(/[\u202f\u00a0]/g, " ")
+}
