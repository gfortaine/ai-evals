@@ -0,0 +1,91 @@
+require "test_helper"
+
+class QuizImportExportTest < ActionDispatch::IntegrationTest
+  test "export page shows exact JSON inside the only pre element" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+    q = quiz.questions.build(body: 'Which HTTP status code means "Too Many Requests"?', active: true)
+    q.save_with_option_rows([
+      { body: "418", correct: false },
+      { body: "429", correct: true }
+    ])
+
+    get moderate_quiz_export_path(quiz), headers: moderator_auth_headers
+    assert_response :success
+
+    pre_elements = css_select("pre")
+    assert_equal 1, pre_elements.size
+
+    parsed = JSON.parse(pre_elements.first.text)
+    assert_equal({
+      "title" => "Frontend Fest 2026",
+      "questions" => [
+        {
+          "text" => 'Which HTTP status code means "Too Many Requests"?',
+          "active" => true,
+          "options" => [
+            { "text" => "418", "correct" => false },
+            { "text" => "429", "correct" => true }
+          ]
+        }
+      ]
+    }, parsed)
+  end
+
+  test "importing valid JSON creates a new quiz and redirects to its page" do
+    existing = Quiz.create!(title: "Frontend Fest 2026")
+    payload = {
+      "title" => "Frontend Fest 2026",
+      "questions" => [
+        {
+          "text" => "First?",
+          "options" => [
+            { "text" => "A" },
+            { "text" => "B", "correct" => true }
+          ]
+        }
+      ]
+    }.to_json
+
+    assert_difference "Quiz.count", 1 do
+      assert_difference "Question.count", 1 do
+        assert_difference "Option.count", 2 do
+          post moderate_import_path,
+            headers: moderator_auth_headers,
+            params: { import: { json: payload } }
+        end
+      end
+    end
+
+    imported = Quiz.order(:id).last
+    assert_not_equal existing.id, imported.id
+    assert_redirected_to moderate_quiz_path(imported)
+  end
+
+  test "importing invalid JSON returns 422, preserves input, and creates nothing" do
+    bad_json = '{"title": "Broken", "questions": [{"text": "Q?", "options": [{"text": "Only one", "correct": true}]}]}'
+
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      post moderate_import_path,
+        headers: moderator_auth_headers,
+        params: { import: { json: bad_json } }
+    end
+
+    assert_response :unprocessable_entity
+    assert_select ".errors[role='alert']"
+    assert_equal bad_json, css_select("textarea[name='import[json]']").first.text.strip
+  end
+
+  test "importing with missing or malformed params returns 422 gracefully" do
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      post moderate_import_path, headers: moderator_auth_headers, params: {}
+    end
+    assert_response :unprocessable_entity
+    assert_select ".errors[role='alert']"
+
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      post moderate_import_path, headers: moderator_auth_headers, params: { import: "not-a-hash" }
+    end
+    assert_response :unprocessable_entity
+    assert_select ".errors[role='alert']"
+  end
+end
diff --git a/test/models/quiz/exporter_test.rb b/test/models/quiz/exporter_test.rb
new file mode 100644
index 0000000..a9bcfea
--- /dev/null
+++ b/test/models/quiz/exporter_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Quiz::ExporterTest < ActiveSupport::TestCase
+  test "exports exact keys, values, and order" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+
+    q1 = quiz.questions.build(body: 'Which HTTP status code means "Too Many Requests"?', active: true)
+    assert q1.save_with_option_rows([
+      { body: "418", correct: false },
+      { body: "429", correct: true }
+    ])
+
+    q2 = quiz.questions.build(body: "What does CSS stand for?", active: false)
+    assert q2.save_with_option_rows([
+      { body: "Cascading Style Sheets", correct: true },
+      { body: "Computer Style System", correct: false },
+      { body: "Creative Style Syntax", correct: false }
+    ])
+
+    # Reorder so q2 comes before q1
+    assert q2.move_up!
+
+    json = Quiz::Exporter.new(quiz).to_json
+    parsed = JSON.parse(json)
+
+    assert_equal %w[questions title], parsed.keys.sort
+    assert_equal "Frontend Fest 2026", parsed["title"]
+    assert_equal 2, parsed["questions"].size
+
+    first_q = parsed["questions"][0]
+    assert_equal %w[active options text], first_q.keys.sort
+    assert_equal "What does CSS stand for?", first_q["text"]
+    assert_same false, first_q["active"]
+    assert_equal [
+      { "text" => "Cascading Style Sheets", "correct" => true },
+      { "text" => "Computer Style System", "correct" => false },
+      { "text" => "Creative Style Syntax", "correct" => false }
+    ], first_q["options"]
+    first_q["options"].each do |opt|
+      assert_equal %w[correct text], opt.keys.sort
+      assert_includes [ true, false ], opt["correct"]
+    end
+
+    second_q = parsed["questions"][1]
+    assert_equal %w[active options text], second_q.keys.sort
+    assert_equal 'Which HTTP status code means "Too Many Requests"?', second_q["text"]
+    assert_same true, second_q["active"]
+    assert_equal [
+      { "text" => "418", "correct" => false },
+      { "text" => "429", "correct" => true }
+    ], second_q["options"]
+  end
+
+  test "exports empty quiz with empty questions array" do
+    quiz = Quiz.create!(title: "Empty Quiz")
+    parsed = JSON.parse(Quiz::Exporter.new(quiz).to_json)
+
+    assert_equal({ "title" => "Empty Quiz", "questions" => [] }, parsed)
+  end
+
+  test "preserves option position order even when opposite of id order" do
+    quiz = Quiz.create!(title: "Option Order Quiz")
+    question = quiz.questions.create!(body: "Pick one", position: 1, active: true)
+    question.options.create!(body: "Second by pos", correct: false, position: 2)
+    question.options.create!(body: "First by pos", correct: true, position: 1)
+
+    parsed = JSON.parse(Quiz::Exporter.new(quiz).to_json)
+    assert_equal [ "First by pos", "Second by pos" ], parsed["questions"][0]["options"].map { |o| o["text"] }
+  end
+end
diff --git a/test/models/quiz/importer_test.rb b/test/models/quiz/importer_test.rb
new file mode 100644
index 0000000..66ea4f7
--- /dev/null
+++ b/test/models/quiz/importer_test.rb
@@ -0,0 +1,195 @@
+require "test_helper"
+
+class Quiz::ImporterTest < ActiveSupport::TestCase
+  test "imports valid quiz JSON matching spec format" do
+    json = <<~JSON
+      {
+        "title": "Frontend Fest 2026",
+        "questions": [
+          {
+            "text": "Which HTTP status code means \\"Too Many Requests\\"?",
+            "active": true,
+            "options": [
+              {"text": "418", "correct": false},
+              {"text": "429", "correct": true}
+            ]
+          },
+          {
+            "text": "Inactive question?",
+            "active": false,
+            "options": [
+              {"text": "Alpha", "correct": true},
+              {"text": "Beta", "correct": true},
+              {"text": "Gamma", "correct": false}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    importer = Quiz::Importer.new(json: json)
+    assert importer.import
+    assert_empty importer.errors
+
+    quiz = importer.quiz
+    assert quiz.persisted?
+    assert_equal "Frontend Fest 2026", quiz.title
+    assert_equal 2, quiz.questions.count
+
+    q1, q2 = quiz.questions.ordered.includes(:options).to_a
+    assert_equal 'Which HTTP status code means "Too Many Requests"?', q1.body
+    assert q1.active?
+    assert_equal [ [ "418", false ], [ "429", true ] ], q1.options.map { |o| [ o.body, o.correct? ] }
+
+    assert_equal "Inactive question?", q2.body
+    assert_not q2.active?
+    assert_equal [ [ "Alpha", true ], [ "Beta", true ], [ "Gamma", false ] ], q2.options.map { |o| [ o.body, o.correct? ] }
+  end
+
+  test "defaults active to true and correct to false when omitted" do
+    json = {
+      "title" => "Minimal Quiz",
+      "questions" => [
+        {
+          "text" => "2 + 2?",
+          "options" => [
+            { "text" => "3" },
+            { "text" => "4", "correct" => true },
+            { "text" => "5" }
+          ]
+        }
+      ]
+    }.to_json
+
+    importer = Quiz::Importer.new(json: json)
+    assert importer.import
+
+    q = importer.quiz.questions.first
+    assert q.active?
+    assert_equal [ [ "3", false ], [ "4", true ], [ "5", false ] ], q.options.map { |o| [ o.body, o.correct? ] }
+  end
+
+  test "always creates a new quiz even when a quiz with the same title exists" do
+    existing = Quiz.create!(title: "Frontend Fest 2026")
+    json = {
+      "title" => "Frontend Fest 2026",
+      "questions" => [
+        {
+          "text" => "New question?",
+          "options" => [
+            { "text" => "Yes", "correct" => true },
+            { "text" => "No" }
+          ]
+        }
+      ]
+    }.to_json
+
+    importer = Quiz::Importer.new(json: json)
+    assert_difference "Quiz.count", 1 do
+      assert importer.import
+    end
+
+    assert_not_equal existing.id, importer.quiz.id
+    assert_equal 0, existing.questions.count
+    assert_equal 1, importer.quiz.questions.count
+  end
+
+  test "imports quiz with empty questions array" do
+    importer = Quiz::Importer.new(json: '{"title": "Blank Slate", "questions": []}')
+    assert importer.import
+    assert_equal "Blank Slate", importer.quiz.title
+    assert_equal 0, importer.quiz.questions.count
+  end
+
+  test "round-trips exporter output identically" do
+    original = Quiz.create!(title: "Roundtrip <b>&</b> \"Quotes\"")
+    q1 = original.questions.build(body: "First\nmultiline?", active: false)
+    q1.save_with_option_rows([ { body: "Opt 1", correct: true }, { body: "Opt 2", correct: false } ])
+    q2 = original.questions.build(body: "Second?", active: true)
+    q2.save_with_option_rows([ { body: "Opt A", correct: false }, { body: "Opt B", correct: true }, { body: "Opt C", correct: true } ])
+
+    exported = Quiz::Exporter.new(original).to_json
+    importer = Quiz::Importer.new(json: exported)
+    assert importer.import
+    assert_not_equal original.id, importer.quiz.id
+    assert_equal exported, Quiz::Exporter.new(importer.quiz).to_json
+  end
+
+  test "rejects invalid JSON and malformed structures without creating records" do
+    invalid_payloads = [
+      "",
+      "   \n\t  ",
+      "{not valid json",
+      "null",
+      "[]",
+      '"just a string"',
+      "123",
+      "true",
+      "{}",
+      '{"questions": []}',
+      '{"title": "   ", "questions": []}',
+      '{"title": 123, "questions": []}',
+      '{"title": null, "questions": []}',
+      '{"title": "No Questions Key"}',
+      '{"title": "Null Questions", "questions": null}',
+      '{"title": "Hash Questions", "questions": {}}',
+      '{"title": "Bad Q Item", "questions": ["string"]}',
+      '{"title": "Missing Q Text", "questions": [{"options": [{"text": "A", "correct": true}, {"text": "B"}]}]}',
+      '{"title": "Blank Q Text", "questions": [{"text": "   ", "options": [{"text": "A", "correct": true}, {"text": "B"}]}]}',
+      '{"title": "Numeric Q Text", "questions": [{"text": 42, "options": [{"text": "A", "correct": true}, {"text": "B"}]}]}',
+      '{"title": "String Active", "questions": [{"text": "Q?", "active": "true", "options": [{"text": "A", "correct": true}, {"text": "B"}]}]}',
+      '{"title": "Null Active", "questions": [{"text": "Q?", "active": null, "options": [{"text": "A", "correct": true}, {"text": "B"}]}]}',
+      '{"title": "Missing Options", "questions": [{"text": "Q?"}]}',
+      '{"title": "Non-Array Options", "questions": [{"text": "Q?", "options": {}}]}',
+      '{"title": "Zero Options", "questions": [{"text": "Q?", "options": []}]}',
+      '{"title": "One Option", "questions": [{"text": "Q?", "options": [{"text": "A", "correct": true}]}]}',
+      '{"title": "Non-Object Option", "questions": [{"text": "Q?", "options": ["A", "B"]}]}',
+      '{"title": "Blank Option", "questions": [{"text": "Q?", "options": [{"text": "A", "correct": true}, {"text": "  ", "correct": false}]}]}',
+      '{"title": "Extra Blank Option", "questions": [{"text": "Q?", "options": [{"text": "A", "correct": true}, {"text": "B"}, {"text": ""}]}]}',
+      '{"title": "Numeric Option Text", "questions": [{"text": "Q?", "options": [{"text": 1, "correct": true}, {"text": "B"}]}]}',
+      '{"title": "String Correct", "questions": [{"text": "Q?", "options": [{"text": "A", "correct": "true"}, {"text": "B"}]}]}',
+      '{"title": "Null Correct", "questions": [{"text": "Q?", "options": [{"text": "A", "correct": null}, {"text": "B", "correct": true}]}]}',
+      '{"title": "No Correct Explicit", "questions": [{"text": "Q?", "options": [{"text": "A", "correct": false}, {"text": "B", "correct": false}]}]}',
+      '{"title": "No Correct Default", "questions": [{"text": "Q?", "options": [{"text": "A"}, {"text": "B"}]}]}'
+    ]
+
+    invalid_payloads.each do |payload|
+      assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ], "Expected nothing created for: #{payload.inspect}" do
+        importer = Quiz::Importer.new(json: payload)
+        assert_not importer.import, "Expected import to fail for: #{payload.inspect}"
+        assert importer.errors.any?, "Expected errors for: #{payload.inspect}"
+        assert_nil importer.quiz
+      end
+    end
+  end
+
+  test "is atomic when a later question breaks a rule" do
+    json = {
+      "title" => "Partial Failure Quiz",
+      "questions" => [
+        {
+          "text" => "Valid first question?",
+          "active" => true,
+          "options" => [
+            { "text" => "Yes", "correct" => true },
+            { "text" => "No", "correct" => false }
+          ]
+        },
+        {
+          "text" => "Broken second question (no correct option)",
+          "options" => [
+            { "text" => "Wrong 1", "correct" => false },
+            { "text" => "Wrong 2", "correct" => false }
+          ]
+        }
+      ]
+    }.to_json
+
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      importer = Quiz::Importer.new(json: json)
+      assert_not importer.import
+      assert_includes importer.errors.full_messages.join(" "), "Question 2"
+      assert_nil importer.quiz
+    end
+  end
+end
diff --git a/test/system/import_export_test.rb b/test/system/import_export_test.rb
new file mode 100644
index 0000000..80ed57f
--- /dev/null
+++ b/test/system/import_export_test.rb
@@ -0,0 +1,318 @@
+require "application_system_test_case"
+
+class ImportExportTest < ApplicationSystemTestCase
+  setup do
+    authorize_moderator
+  end
+
+  test "exporting a quiz and re-importing it creates an independent copy with identical contents and order" do
+    special_title = "Frontend Fest 2026 🎉 </pre><script>window.__xss=1</script>"
+    quiz = Quiz.create!(title: special_title)
+
+    q1 = quiz.questions.build(body: 'Which HTTP status code means "Too Many Requests"?', active: true)
+    assert q1.save_with_option_rows([
+      { body: "418", correct: false },
+      { body: "429", correct: true },
+      { body: "503", correct: false }
+    ])
+
+    q2 = quiz.questions.build(body: "What does CSS stand for?", active: false)
+    assert q2.save_with_option_rows([
+      { body: "Cascading Style Sheets", correct: true },
+      { body: "Computer Style System", correct: false }
+    ])
+
+    q3 = quiz.questions.build(body: "Which protocols run over TCP?", active: true)
+    assert q3.save_with_option_rows([
+      { body: "HTTP/1.1", correct: true },
+      { body: "WebSocket", correct: true },
+      { body: "UDP", correct: false }
+    ])
+
+    # Reorder so order is q2, q1, q3
+    assert q2.move_up!
+
+    # Open quiz page and click Export
+    visit moderate_quiz_path(quiz)
+    assert_link "Export"
+    click_link "Export"
+
+    # Exactly one <pre> element containing valid JSON with exact keys
+    assert_selector "pre", count: 1
+    assert_nil evaluate_script("window.__xss")
+
+    exported_text = find("pre").text
+    parsed = JSON.parse(exported_text)
+
+    assert_equal %w[questions title], parsed.keys.sort
+    assert_equal special_title, parsed["title"]
+    assert_equal [
+      "What does CSS stand for?",
+      'Which HTTP status code means "Too Many Requests"?',
+      "Which protocols run over TCP?"
+    ], parsed["questions"].map { |q| q["text"] }
+    assert_equal [ false, true, true ], parsed["questions"].map { |q| q["active"] }
+
+    parsed["questions"].each do |q|
+      assert_equal %w[active options text], q.keys.sort
+      q["options"].each do |opt|
+        assert_equal %w[correct text], opt.keys.sort
+        assert_includes [ true, false ], opt["correct"]
+      end
+    end
+
+    # Navigate to /moderate and click Import quiz
+    visit "/moderate"
+    click_on "Import quiz"
+
+    assert_field "Quiz JSON"
+    assert_button "Import"
+
+    fill_in "Quiz JSON", with: exported_text
+    click_button "Import"
+
+    # Opens the newly created quiz page (not the original quiz)
+    assert_selector "h1", text: special_title
+    assert_nil evaluate_script("window.__xss")
+    assert_not_equal moderate_quiz_path(quiz), current_path
+    assert_equal 2, Quiz.count
+
+    # Check questions order, active state, and options order
+    assert_text "2 of 3 questions active"
+    items = all("ol.question-list > li")
+    assert_equal 3, items.size
+
+    assert_equal [
+      "What does CSS stand for?",
+      'Which HTTP status code means "Too Many Requests"?',
+      "Which protocols run over TCP?"
+    ], items.map { |li| li.find(".question-item__body").text }
+
+    within(items[0]) do
+      assert_unchecked_field "Active"
+      assert_equal [ "A. Cascading Style Sheets (correct)", "B. Computer Style System" ],
+        all("ul.question-item__options li").map { |el| el.text(:all) }
+    end
+
+    within(items[1]) do
+      assert_checked_field "Active"
+      assert_selector "li.is-correct", text: "429"
+    end
+
+    within(items[2]) do
+      assert_checked_field "Active"
+      assert_selector "li.is-correct", count: 2
+    end
+
+    # Preview on imported quiz skips inactive Q1 and runs active questions in order
+    click_link "Preview"
+    assert_text "Question 1 of 2"
+    assert_text 'Which HTTP status code means "Too Many Requests"?'
+    click_button "429"
+    assert_text "Correct!"
+    click_button "Next question"
+    assert_text "Question 2 of 2"
+    assert_text "Which protocols run over TCP?"
+    click_button "WebSocket"
+    assert_text "Correct!"
+    click_button "See score"
+    assert_text "Score: 2/2"
+    click_link "← Back to quiz"
+
+    # Editing imported quiz leaves original quiz untouched
+    click_link "Settings"
+    fill_in "Title", with: "Copied Quiz Renamed"
+    click_button "Save quiz"
+    assert_selector "h1", text: "Copied Quiz Renamed"
+    assert_equal special_title, quiz.reload.title
+
+    # Both quizzes appear as separate list items on /moderate
+    visit "/moderate"
+    assert_selector "ul.quiz-list > li", count: 2
+  end
+
+  test "importing JSON with optional active and correct omitted applies defaults and export writes both" do
+    minimal_json = <<~JSON
+      {
+        "title": "Minimal Conf 2026",
+        "questions": [
+          {
+            "text": "Which planet is closest to the Sun?",
+            "options": [
+              {"text": "Venus"},
+              {"text": "Mercury", "correct": true},
+              {"text": "Mars"}
+            ]
+          }
+        ]
+      }
+    JSON
+
+    visit "/moderate"
+    click_on "Import quiz"
+    fill_in "Quiz JSON", with: minimal_json
+    click_button "Import"
+
+    assert_selector "h1", text: "Minimal Conf 2026"
+    assert_text "1 of 1 question active"
+    within("ol.question-list > li") do
+      assert_checked_field "Active"
+      assert_selector "li.is-correct", count: 1
+      assert_selector "li.is-correct", text: "Mercury"
+    end
+
+    # Export always writes both active and correct
+    click_link "Export"
+    assert_selector "pre", count: 1
+    exported = JSON.parse(find("pre").text)
+    assert_equal({
+      "title" => "Minimal Conf 2026",
+      "questions" => [
+        {
+          "text" => "Which planet is closest to the Sun?",
+          "active" => true,
+          "options" => [
+            { "text" => "Venus", "correct" => false },
+            { "text" => "Mercury", "correct" => true },
+            { "text" => "Mars", "correct" => false }
+          ]
+        }
+      ]
+    }, exported)
+  end
+
+  test "invalid JSON and rule violations show errors and import nothing" do
+    visit "/moderate"
+    click_on "Import quiz"
+
+    # 1. Invalid JSON syntax (including </textarea> to verify safe escaping)
+    bad_payload = "{broken </textarea><script>window.__xss=1</script>"
+    fill_in "Quiz JSON", with: bad_payload
+    click_button "Import"
+
+    assert_selector ".errors[role='alert']"
+    assert_nil evaluate_script("window.__xss")
+    assert_field "Quiz JSON", with: bad_payload
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+    assert_equal 0, Option.count
+
+    # 2. Valid Q1 + invalid Q2 (only 1 option) -> nothing imported!
+    partial_invalid = {
+      "title" => "Should Not Exist",
+      "questions" => [
+        {
+          "text" => "Good question?",
+          "options" => [
+            { "text" => "Yes", "correct" => true },
+            { "text" => "No", "correct" => false }
+          ]
+        },
+        {
+          "text" => "Only one option?",
+          "options" => [
+            { "text" => "Alone", "correct" => true }
+          ]
+        }
+      ]
+    }.to_json
+
+    fill_in "Quiz JSON", with: partial_invalid
+    click_button "Import"
+
+    assert_selector ".errors[role='alert']", text: /Question 2/i
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+    assert_equal 0, Option.count
+
+    # 3. Valid Q1 + invalid Q2 (no correct option) -> nothing imported!
+    no_correct = {
+      "title" => "Also Should Not Exist",
+      "questions" => [
+        {
+          "text" => "Good question?",
+          "options" => [
+            { "text" => "Yes", "correct" => true },
+            { "text" => "No" }
+          ]
+        },
+        {
+          "text" => "No correct answer?",
+          "options" => [
+            { "text" => "A" },
+            { "text" => "B" }
+          ]
+        }
+      ]
+    }.to_json
+
+    fill_in "Quiz JSON", with: no_correct
+    click_button "Import"
+
+    assert_selector ".errors[role='alert']", text: /Question 2/i
+    assert_equal 0, Quiz.count
+    assert_equal 0, Question.count
+    assert_equal 0, Option.count
+  end
+
+  test "accessibility tree exposes exact expected names for import and export controls" do
+    quiz = Quiz.create!(title: "A11y Export Quiz")
+
+    visit "/moderate"
+    ax_nodes = page.driver.browser.page.command("Accessibility.getFullAXTree")["nodes"]
+    names_by_role = extract_names_by_role(ax_nodes)
+    assert_includes names_by_role["link"], "Import quiz"
+    assert_includes names_by_role["link"], "New quiz"
+
+    visit moderate_quiz_path(quiz)
+    ax_nodes = page.driver.browser.page.command("Accessibility.getFullAXTree")["nodes"]
+    names_by_role = extract_names_by_role(ax_nodes)
+    assert_includes names_by_role["link"], "Export"
+
+    visit moderate_import_path
+    ax_nodes = page.driver.browser.page.command("Accessibility.getFullAXTree")["nodes"]
+    names_by_role = extract_names_by_role(ax_nodes)
+    assert_includes names_by_role["textbox"], "Quiz JSON"
+    assert_includes names_by_role["button"], "Import"
+  end
+
+  test "import and export work with URL-embedded Basic Auth" do
+    page.driver.browser.headers.clear
+    server = Capybara.current_session.server
+    user = ENV["QUIZZY_MODERATOR_USERNAME"]
+    pass = ENV["QUIZZY_MODERATOR_PASSWORD"]
+
+    visit "http://#{user}:#{pass}@#{server.host}:#{server.port}/moderate"
+    click_on "Import quiz"
+    fill_in "Quiz JSON", with: {
+      "title" => "URL Auth Imported Quiz",
+      "questions" => [
+        {
+          "text" => "Works?",
+          "options" => [
+            { "text" => "Yes", "correct" => true },
+            { "text" => "No" }
+          ]
+        }
+      ]
+    }.to_json
+    click_button "Import"
+
+    assert_selector "h1", text: "URL Auth Imported Quiz"
+    click_link "Export"
+    assert_selector "pre", count: 1
+    assert_equal "URL Auth Imported Quiz", JSON.parse(find("pre").text)["title"]
+  end
+
+  private
+
+  def extract_names_by_role(ax_nodes)
+    names_by_role = Hash.new { |h, k| h[k] = [] }
+    ax_nodes.each do |node|
+      role = node.dig("role", "value")
+      name = node.dig("name", "value")
+      names_by_role[role] << name if role && name
+    end
+    names_by_role
+  end
+end
