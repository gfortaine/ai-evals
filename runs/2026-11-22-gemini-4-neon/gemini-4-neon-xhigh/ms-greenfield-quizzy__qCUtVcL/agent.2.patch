+<% content_for :title, "Quizzy · Import quiz" %>
+
+<div class="breadcrumbs">
+  <%= link_to "← All quizzes", moderate_root_path %>
+</div>
+
+<div class="page-head">
+  <h1>Import quiz</h1>
+</div>
+
+<%= form_with url: moderate_import_path, method: :post, html: { novalidate: true, data: { turbo: false } } do %>
+  <div class="card">
+    <% if @importer.errors.any? %>
