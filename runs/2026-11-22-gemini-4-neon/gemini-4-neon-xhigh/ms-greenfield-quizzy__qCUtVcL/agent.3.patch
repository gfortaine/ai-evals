diff --git a/app/views/play/games/show.html.erb b/app/views/play/games/show.html.erb
new file mode 100644
index 0000000..5e8396a
--- /dev/null
+++ b/app/views/play/games/show.html.erb
@@ -0,0 +1,110 @@
+<% content_for :title, "Quizzy · #{@game.quiz.title}" %>
+
+<%
+  body_top = @player.present? && (@state[:status] == "question_open" || @state[:status] == "question_closed")
+%>
+
+<div class="play"
+     data-controller="player-game"
+     data-player-game-code-value="<%= @game.code %>"
+     data-player-game-joined-value="<%= @player.present? %>"
+     data-player-game-player-token-value="<%= @player_stream_token %>"
+     data-player-game-initial-state-value="<%= @state.to_json %>"
+     data-player-game-state-url-value="<%= state_play_game_path(@game.code) %>"
+     data-player-game-answer-url-value="<%= answer_play_game_path(@game.code) %>"
+     data-player-game-leave-url-value="<%= leave_play_game_path(@game.code) %>">
+
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+    <span data-player-game-target="topMeta">
+      <% if @player && (@state[:status] == "question_open" || @state[:status] == "question_closed") %>
+        Hi, <%= @player.name %>!
+      <% else %>
+        <%= @game.quiz.title %>
+      <% end %>
+    </span>
+  </div>
+
+  <div class="play__body <%= 'play__body--top' if body_top %>" data-player-game-target="body">
+    <% if @state[:status] == "finished" %>
+      <div class="result-card">
+        <div class="play-title">The quiz is over</div>
+        <p class="play-lead">Thanks for playing!</p>
+      </div>
+
+    <% elsif @player.nil? %>
+      <div>
+        <h1 class="play-title"><%= @game.quiz.title %></h1>
+        <%= form_with model: @join_form_player,
+              url: join_play_game_path(@game.code),
+              method: :post,
+              class: "join-form",
+              html: { novalidate: true, data: { turbo: false } } do |f| %>
+          <% if @join_form_player&.errors&.any? %>
+            <div class="errors" role="alert"><%= @join_form_player.errors.full_messages.first %></div>
+          <% end %>
+          <label class="field-label" for="player_name">Your name</label>
+          <%= f.text_field :name,
+                id: "player_name",
+                class: "input",
+                placeholder: "Your name",
+                autocomplete: "name",
+                maxlength: 80,
+                autofocus: true,
+                required: true %>
+          <button type="submit" class="btn btn--pink">Join</button>
+        <% end %>
+      </div>
+
+    <% elsif @state[:status] == "lobby" %>
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+        <p class="play-lead">Waiting for the quiz to start…</p>
+      </div>
+
+    <% elsif @state[:status] == "question_open" %>
+      <% q = @state[:question] %>
+      <div class="play-question__num">Question <%= q[:number] %> of <%= q[:total] %></div>
+      <div class="play-question__body"><%= q[:body] %></div>
+      <div class="play-options">
+        <% q[:options].each do |opt| %>
+          <% picked = (@state[:selected_option_id] == opt[:id]) %>
+          <button type="button"
+                  class="play-option <%= 'is-picked' if picked %>"
+                  data-option-id="<%= opt[:id] %>"
+                  data-action="player-game#pickOption">
+            <span class="play-option__letter" aria-hidden="true"><%= opt[:letter] %></span>
+            <span class="play-option__title"><%= opt[:body] %></span>
+            <span class="play-option__mark"><%= "Your answer" if picked %></span>
+          </button>
+        <% end %>
+      </div>
+      <div class="play-feedback" data-role="feedback"></div>
+
+    <% elsif @state[:status] == "question_closed" %>
+      <% q = @state[:question] %>
+      <% outcome = @state[:outcome] %>
+      <div class="play-question__num">Question <%= q[:number] %> of <%= q[:total] %></div>
+      <div class="play-question__body"><%= q[:body] %></div>
+      <div class="play-options is-locked is-revealed">
+        <% q[:options].each do |opt| %>
+          <% picked = (@state[:selected_option_id] == opt[:id]) %>
+          <button type="button"
+                  class="play-option <%= 'is-picked' if picked %> <%= 'is-correct' if opt[:correct] %>"
+                  disabled>
+            <span class="play-option__letter" aria-hidden="true"><%= opt[:letter] %></span>
+            <span class="play-option__title"><%= opt[:body] %></span>
+            <span class="play-option__mark"><%= picked ? "Your answer" : (opt[:correct] ? "✓" : "") %></span>
+          </button>
+        <% end %>
+      </div>
+      <% status_class, status_text = case outcome
+         when "correct" then [ "play-status--right", "Correct!" ]
+         when "wrong" then [ "play-status--wrong", "Wrong!" ]
+         else [ "play-status--neutral", "No answer" ]
+         end %>
+      <div class="play-status <%= status_class %>" role="status"><%= status_text %></div>
+    <% end %>
+  </div>
+</div>
