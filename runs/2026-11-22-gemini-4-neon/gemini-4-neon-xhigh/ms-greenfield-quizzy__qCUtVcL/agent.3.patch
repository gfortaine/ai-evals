@@ -0,0 +1,375 @@
+require "application_system_test_case"
+require "rqrcode"
+
+class LiveGameSystemTest < ApplicationSystemTestCase
+  setup do
+    @quiz = Quiz.create!(title: "Conference Talk 2026")
+
+    q1 = @quiz.questions.build(body: "Which HTTP code means Too Many Requests?", active: true)
+    q1.save_with_option_rows([
+      { body: "418", correct: false },
+      { body: "429", correct: true },
+      { body: "503", correct: false }
+    ])
+
+    q2 = @quiz.questions.build(body: "Inactive hidden question?", active: false)
+    q2.save_with_option_rows([
+      { body: "Yes", correct: true },
+      { body: "No", correct: false }
+    ])
+
+    q3 = @quiz.questions.build(body: "Which protocols run over TCP?", active: true)
+    q3.save_with_option_rows([
+      { body: "HTTP/1.1", correct: true },
+      { body: "WebSocket", correct: true },
+      { body: "UDP", correct: false }
+    ])
+  end
+
+  test "complete live game flow across moderator and multiple players without reloads" do
+    join_url = nil
+
+    Capybara.using_session(:moderator) do
+      authorize_moderator
+      visit moderate_quiz_path(@quiz)
+
+      click_button "Start a game"
+      assert_match %r{/moderate/games/\d+}, current_path
+
+      assert_selector "h1", text: "Conference Talk 2026"
+      assert_selector ".qr svg"
+
+      join_url = find(".lobby__url").text.strip
+      assert_match %r{\Ahttp://[^/\s]+/play/[A-Z2-9]{5}\z}, join_url
+      assert_not_includes join_url, ENV["QUIZZY_MODERATOR_PASSWORD"]
+
+      # Verify SVG matches the exact QR code path for join_url
+      expected_path = RQRCode::QRCode.new(join_url).as_svg(
+        color: "000000", fill: "ffffff", shape_rendering: "crispEdges",
+        module_size: 6, offset: 24, standalone: true, use_path: true, viewbox: true
+      )[/d="([^"]+)"/, 1]
+      actual_path = find(".qr svg path")["d"]
+      assert_equal expected_path, actual_path
+
+      # Verify innerText of counter pill is literally "Players: 0" (no newline)
+      assert_equal "Players: 0", evaluate_script("document.querySelector('.counter-pill').innerText.trim()")
+      assert_button "Start"
+    end
+
+    # Alice opens join link: before submitting Join, she must NOT count as a player
+    Capybara.using_session(:alice) do
+      visit join_url
+      assert_field "Your name"
+      assert_button "Join"
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 0"
+    end
+
+    # Alice joins -> big screen updates live to Players: 1
+    Capybara.using_session(:alice) do
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 1"
+    end
+
+    # Bob joins -> big screen updates live to Players: 2
+    Capybara.using_session(:bob) do
+      visit join_url
+      fill_in "Your name", with: "Bob"
+      click_button "Join"
+      assert_text "Hi, Bob!"
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 2"
+    end
+
+    # Bob leaves the page -> big screen drops live to Players: 1
+    Capybara.using_session(:bob) do
+      visit root_path
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 1"
+    end
+
+    # Bob reopens join link in the same browser -> remembered as Bob, no join form!
+    Capybara.using_session(:bob) do
+      visit join_url
+      assert_no_field "Your name"
+      assert_text "Hi, Bob!"
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Players: 2"
+    end
+
+    # Moderator starts Question 1 (skips inactive Q2 -> "Question 1 of 2")
+    Capybara.using_session(:moderator) do
+      click_button "Start"
+      assert_text "Question 1 of 2"
+      assert_text "Which HTTP code means Too Many Requests?"
+      assert_text "Answers: 0 / 2"
+      assert_button "Finish"
+      assert_no_text "Correct"
+    end
+
+    # Alice & Bob receive Q1 live without reload; NO correct answer in page source!
+    Capybara.using_session(:alice) do
+      assert_text "Which HTTP code means Too Many Requests?"
+      assert_button "418"
+      assert_button "429"
+      assert_button "503"
+      assert_not_includes page.html.downcase, "correct"
+
+      # Tap 418 first -> marked "Your answer"
+      click_button "418"
+      assert_selector "button.play-option.is-picked", text: /418.*Your answer/m
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 1 / 2"
+    end
+
+    # Alice changes her answer to 429 -> last pick counts, answer counter stays 1 / 2
+    Capybara.using_session(:alice) do
+      click_button "429"
+      assert_selector "button.play-option.is-picked", text: /429.*Your answer/m
+      assert_no_selector "button.play-option", text: /418.*Your answer/m
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 1 / 2"
+    end
+
+    # Charlie joins late mid-game -> gets Q1 immediately and increments denominator to 3
+    Capybara.using_session(:charlie) do
+      visit join_url
+      fill_in "Your name", with: "Charlie"
+      click_button "Join"
+      assert_text "Which HTTP code means Too Many Requests?"
+      click_button "503"
+      assert_selector "button.play-option.is-picked", text: /503.*Your answer/m
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 2 / 3"
+    end
+
+    # Bob disconnects mid-question -> denominator drops live to 2 / 2
+    Capybara.using_session(:bob) do
+      visit root_path
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 2 / 2"
+    end
+
+    # Bob returns before Finish -> denominator returns to 2 / 3
+    Capybara.using_session(:bob) do
+      visit join_url
+      assert_text "Which HTTP code means Too Many Requests?"
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 2 / 3"
+
+      # Moderator closes Q1 with Finish
+      click_button "Finish"
+      assert_button "Next"
+      assert_no_button "End quiz"
+
+      within("ol.stage-options > li", text: "429") do
+        assert_text "Correct"
+        assert_selector ".stage-option__count", text: "1"
+      end
+      within("ol.stage-options > li", text: "503") do
+        assert_no_text "Correct"
+        assert_selector ".stage-option__count", text: "1"
+      end
+      within("ol.stage-options > li", text: "418") do
+        assert_no_text "Correct"
+        assert_selector ".stage-option__count", text: "0"
+      end
+    end
+
+    # Verify live player outcomes without page reload
+    Capybara.using_session(:alice) do
+      assert_text "Correct!"
+      assert_selector "button.play-option[disabled]", count: 3
+    end
+    Capybara.using_session(:charlie) do
+      assert_text "Wrong!"
+      assert_no_text "Correct"
+    end
+    Capybara.using_session(:bob) do
+      assert_text "No answer"
+      assert_no_text "Correct"
+    end
+
+    # Moderator advances to Q2 (actually Q3, since Q2 was inactive)
+    Capybara.using_session(:moderator) do
+      click_button "Next"
+      assert_text "Question 2 of 2"
+      assert_text "Which protocols run over TCP?"
+      assert_no_text "Inactive hidden question?"
+      assert_text "Answers: 0 / 3"
+    end
+
+    # All 3 players live-update to Q3 and pick different options (2 correct options!)
+    Capybara.using_session(:alice) do
+      assert_text "Which protocols run over TCP?"
+      click_button "HTTP/1.1"
+      assert_selector "button.play-option.is-picked", text: /HTTP\/1\.1.*Your answer/m
+    end
+    Capybara.using_session(:bob) do
+      assert_text "Which protocols run over TCP?"
+      click_button "WebSocket"
+      assert_selector "button.play-option.is-picked", text: /WebSocket.*Your answer/m
+    end
+    Capybara.using_session(:charlie) do
+      assert_text "Which protocols run over TCP?"
+      click_button "UDP"
+      assert_selector "button.play-option.is-picked", text: /UDP.*Your answer/m
+    end
+
+    Capybara.using_session(:moderator) do
+      assert_text "Answers: 3 / 3"
+      click_button "Finish"
+
+      # Last question shows "End quiz" instead of "Next"
+      assert_button "End quiz"
+      assert_no_button "Next"
+
+      within("ol.stage-options > li", text: "HTTP/1.1") do
+        assert_text "Correct"
+        assert_selector ".stage-option__count", text: "1"
+      end
+      within("ol.stage-options > li", text: "WebSocket") do
+        assert_text "Correct"
+        assert_selector ".stage-option__count", text: "1"
+      end
+      within("ol.stage-options > li", text: "UDP") do
+        assert_no_text "Correct"
+        assert_selector ".stage-option__count", text: "1"
+      end
+    end
+
+    Capybara.using_session(:alice) { assert_text "Correct!" }
+    Capybara.using_session(:bob) { assert_text "Correct!" }
+    Capybara.using_session(:charlie) { assert_text "Wrong!" }
+
+    # Visitor Dave is sitting on join form before end -> should live-update to "The quiz is over"
+    Capybara.using_session(:dave) do
+      visit join_url
+      assert_field "Your name"
+    end
+
+    # Moderator ends quiz
+    Capybara.using_session(:moderator) do
+      click_button "End quiz"
+      assert_text "The quiz is over"
+      assert_no_button "End quiz"
+    end
+
+    # Everyone live-updates to "The quiz is over" without page reload
+    Capybara.using_session(:alice) { assert_text "The quiz is over" }
+    Capybara.using_session(:bob) { assert_text "The quiz is over" }
+    Capybara.using_session(:charlie) { assert_text "The quiz is over" }
+    Capybara.using_session(:dave) do
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+
+    # Brand new visitor opening join link after end sees "The quiz is over" and cannot join
+    Capybara.using_session(:eve) do
+      visit join_url
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+  end
+
+  test "playing same quiz twice creates isolated games and supports URL-embedded basic auth and Wi-Fi recovery" do
+    single_quiz = Quiz.create!(title: "Rehearsal vs Talk")
+    q = single_quiz.questions.build(body: "Is Rails awesome?", active: true)
+    q.save_with_option_rows([
+      { body: "Yes", correct: true },
+      { body: "Totally", correct: true }
+    ])
+
+    game1_url = nil
+    game2_url = nil
+
+    # Moderator uses URL-embedded Basic Auth (like QA tests sometimes do!)
+    Capybara.using_session(:mod_url_auth) do
+      server = Capybara.current_session.server
+      user = ENV["QUIZZY_MODERATOR_USERNAME"]
+      pass = ENV["QUIZZY_MODERATOR_PASSWORD"]
+      visit "http://#{user}:#{pass}@#{server.host}:#{server.port}#{moderate_quiz_path(single_quiz)}"
+
+      click_button "Start a game"
+      assert_text "Rehearsal vs Talk"
+      game1_url = find(".lobby__url").text.strip
+      assert_not_includes game1_url, pass
+    end
+
+    Capybara.using_session(:player_one) do
+      visit game1_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+
+      # Simulate conference Wi-Fi drop (close WebSocket and go offline via JS / network)
+      execute_script("window.Stimulus.controllers.forEach(c => { if (c.consumer) c.consumer.disconnect() })")
+    end
+
+    Capybara.using_session(:mod_url_auth) do
+      click_button "Start"
+      assert_text "Question 1 of 1"
+    end
+
+    # Player recovers automatically via online/polling sync without reloading the page!
+    Capybara.using_session(:player_one) do
+      execute_script("window.dispatchEvent(new Event('online'))")
+      assert_text "Is Rails awesome?"
+      click_button "Yes"
+      assert_selector "button.play-option.is-picked", text: /Yes.*Your answer/m
+    end
+
+    Capybara.using_session(:mod_url_auth) do
+      assert_text "Answers: 1 / 1"
+      click_button "Finish"
+      # Single-question quiz immediately shows "End quiz"
+      assert_button "End quiz"
+      assert_no_button "Next"
+      click_button "End quiz"
+      assert_text "The quiz is over"
+
+      # Start a second game of the same quiz
+      click_link "← Back to quiz"
+      click_button "Start a game"
+      assert_text "Players: 0"
+      game2_url = find(".lobby__url").text.strip
+      assert_not_equal game1_url, game2_url
+    end
+
+    # Same browser opening Game 2 is asked for name again (fresh player per game),
+    # while Game 1 still says "The quiz is over"
+    Capybara.using_session(:player_one) do
+      visit game2_url
+      assert_field "Your name"
+      assert_button "Join"
+
+      visit game1_url
+      assert_text "The quiz is over"
+    end
+  end
+end
