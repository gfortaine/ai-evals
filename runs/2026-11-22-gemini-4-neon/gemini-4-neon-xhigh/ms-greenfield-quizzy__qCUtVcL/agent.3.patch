diff --git a/app/channels/application_cable/connection.rb b/app/channels/application_cable/connection.rb
new file mode 100644
index 0000000..66df35f
--- /dev/null
+++ b/app/channels/application_cable/connection.rb
@@ -0,0 +1,36 @@
+module ApplicationCable
+  class Connection < ActionCable::Connection::Base
+    identified_by :connection_id, :moderator_authenticated
+
+    def connect
+      self.connection_id = SecureRandom.uuid
+      self.moderator_authenticated = valid_moderator_basic_auth?
+    end
+
+    def signed_cookie(name)
+      cookies.signed[name]
+    rescue StandardError
+      nil
+    end
+
+    private
+
+    def valid_moderator_basic_auth?
+      expected_username = ENV["QUIZZY_MODERATOR_USERNAME"].to_s
+      expected_password = ENV["QUIZZY_MODERATOR_PASSWORD"].to_s
+      return false if expected_username.empty? || expected_password.empty?
+
+      auth = request.authorization.to_s
+      return false unless auth.start_with?("Basic ")
+
+      decoded = Base64.decode64(auth.delete_prefix("Basic "))
+      username, password = decoded.split(":", 2)
+      return false if username.nil? || password.nil?
+
+      ActiveSupport::SecurityUtils.secure_compare(username, expected_username) &
+        ActiveSupport::SecurityUtils.secure_compare(password, expected_password)
+    rescue StandardError
+      false
+    end
+  end
+end
diff --git a/app/channels/moderator_channel.rb b/app/channels/moderator_channel.rb
new file mode 100644
index 0000000..664bffc
--- /dev/null
+++ b/app/channels/moderator_channel.rb
@@ -0,0 +1,33 @@
+class ModeratorChannel < ApplicationCable::Channel
+  def subscribed
+    @game = Game.find_by(id: params[:game_id])
+    unless @game && authorized_moderator?(@game.id)
+      reject
+      return
+    end
+
+    stream_from @game.moderator_stream_name
+    transmit(@game.moderator_state)
+  end
+
+  def sync
+    return unless @game
+
+    @game.reload
+    transmit(@game.moderator_state)
+  rescue ActiveRecord::RecordNotFound
+    # Game was deleted
+  end
+
+  private
+
+  def authorized_moderator?(game_id)
+    return true if connection.moderator_authenticated
+
+    token = params[:token].to_s
+    return false if token.empty?
+
+    verified_game_id = Rails.application.message_verifier(:moderator_stream).verified(token)
+    verified_game_id.present? && verified_game_id.to_i == game_id
+  end
+end
diff --git a/app/channels/player_channel.rb b/app/channels/player_channel.rb
new file mode 100644
index 0000000..362b80e
--- /dev/null
+++ b/app/channels/player_channel.rb
@@ -0,0 +1,77 @@
+class PlayerChannel < ApplicationCable::Channel
+  def subscribed
+    @game = Game.find_by(code: params[:code].to_s.upcase)
+    unless @game
+      reject
+      return
+    end
+
+    @player = resolve_player(@game)
+    @subscription_key = "#{connection.connection_id}:#{object_id}"
+    stream_from @game.players_stream_name
+
+    if @player
+      stream_from @game.player_stream_name(@player.id)
+      changed, _count = GamePresence.connect_ws(@game.id, @player.id, @subscription_key)
+      @game.broadcast_moderator_state! if changed && (@game.lobby? || @game.question_open?)
+      transmit(@game.player_state(@player))
+    else
+      transmit(@game.public_player_state.merge(joined: false))
+    end
+  end
+
+  def heartbeat
+    return unless @game && @player
+
+    changed, _count = GamePresence.heartbeat_ws(@game.id, @player.id, @subscription_key)
+    return unless changed
+
+    @game.reload
+    @game.broadcast_moderator_state! if @game.lobby? || @game.question_open?
+  rescue ActiveRecord::RecordNotFound
+    # Game was deleted
+  end
+
+  def sync
+    return unless @game
+
+    @game.reload
+    if @player
+      transmit(@game.player_state(@player))
+    else
+      transmit(@game.public_player_state.merge(joined: false))
+    end
+  rescue ActiveRecord::RecordNotFound
+    # Game was deleted
+  end
+
+  def unsubscribed
+    return unless @game && @player
+
+    changed, _count = GamePresence.disconnect_ws(@game.id, @subscription_key)
+    return unless changed
+
+    @game.reload
+    @game.broadcast_moderator_state! if @game.lobby? || @game.question_open?
+  rescue ActiveRecord::RecordNotFound
+    # Game was deleted
+  end
+
+  private
+
+  def resolve_player(game)
+    cookie_token = connection.signed_cookie(Game.player_cookie_name(game.code))
+    if cookie_token.present?
+      player = game.players.find_by(token: cookie_token)
+      return player if player
+    end
+
+    stream_token = params[:player_token].to_s
+    return nil if stream_token.empty?
+
+    payload = Rails.application.message_verifier(:player_stream).verified(stream_token)
+    return nil unless payload.is_a?(Array) && payload.length == 2 && payload[0].to_i == game.id
+
+    game.players.find_by(id: payload[1].to_i)
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
new file mode 100644
index 0000000..54defa3
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,90 @@
+require "rqrcode"
+
+module Moderate
+  class GamesController < BaseController
+    layout "application", only: :show
+
+    before_action :set_no_store_cache, only: %i[show state]
+    before_action :set_game, only: %i[show state start finish next_question end_game]
+
+    def create
+      @quiz = Quiz.find(params[:quiz_id])
+      @game = Game.start_for_quiz!(@quiz)
+      redirect_to moderate_game_path(@game)
+    rescue Game::NoActiveQuestionsError
+      redirect_to moderate_quiz_path(@quiz), alert: "Add at least one active question before starting a game."
+    end
+
+    def show
+      @quiz = @game.quiz
+      @join_url = "#{request.base_url}#{play_game_path(@game.code)}"
+      @qr_svg = build_qr_svg(@join_url)
+      @moderator_token = Rails.application.message_verifier(:moderator_stream).generate(@game.id)
+      @state = @game.moderator_state
+    end
+
+    def state
+      render json: @game.moderator_state
+    end
+
+    def start
+      transitioned = @game.start!
+      @game.broadcast_all! if transitioned
+      respond_with_state
+    end
+
+    def finish
+      transitioned = @game.finish_question!(expected_question_id: params[:expected_question_id])
+      @game.broadcast_all! if transitioned
+      respond_with_state
+    end
+
+    def next_question
+      transitioned = @game.next_question!(expected_question_id: params[:expected_question_id])
+      @game.broadcast_all! if transitioned
+      respond_with_state
+    end
+
+    def end_game
+      transitioned = @game.end_game!(expected_question_id: params[:expected_question_id])
+      @game.broadcast_all! if transitioned
+      respond_with_state
+    end
+
+    private
+
+    def set_game
+      @game = Game.includes(:quiz, game_questions: :game_options).find(params[:id])
+    end
+
+    def set_no_store_cache
+      response.headers["Cache-Control"] = "no-store"
+    end
+
+    def respond_with_state
+      @game.reload
+      respond_to do |format|
+        format.json { render json: @game.moderator_state }
+        format.html { redirect_to moderate_game_path(@game), status: :see_other }
+      end
+    end
+
+    def build_qr_svg(url)
+      svg = RQRCode::QRCode.new(url).as_svg(
+        color: "000000",
+        fill: "ffffff",
+        shape_rendering: "crispEdges",
+        module_size: 6,
+        offset: 24,
+        standalone: true,
+        use_path: true,
+        viewbox: true,
+        svg_attributes: {
+          role: "img",
+          "aria-label": "Join QR code"
+        }
+      )
+      svg.sub(/\A<\?xml[^?]*\?>\s*/, "")
+    end
+  end
+end
diff --git a/app/controllers/play/games_controller.rb b/app/controllers/play/games_controller.rb
new file mode 100644
index 0000000..f80fce0
--- /dev/null
+++ b/app/controllers/play/games_controller.rb
@@ -0,0 +1,129 @@
+module Play
+  class GamesController < ApplicationController
+    before_action :set_no_store_cache
+    before_action :set_game
+    before_action :load_player
+
+    def show
+      if @player && !@game.finished?
+        touch_player_presence(@player)
+        @player_stream_token = Rails.application.message_verifier(:player_stream).generate([ @game.id, @player.id ])
+        @state = @game.player_state(@player)
+      elsif @player && @game.finished?
+        @player_stream_token = ""
+        @state = @game.player_state(@player)
+      else
+        @player_stream_token = ""
+        @state = @game.public_player_state.merge(joined: false)
+        @join_form_player = @game.players.new
+      end
+    end
+
+    def join
+      if @game.finished?
+        redirect_to play_game_path(@game.code)
+        return
+      end
+
+      if @player
+        redirect_to play_game_path(@game.code)
+        return
+      end
+
+      @join_form_player = @game.players.new(name: join_name_param)
+
+      if @join_form_player.save
+        cookies.signed[Game.player_cookie_name(@game.code)] = {
+          value: @join_form_player.token,
+          httponly: true,
+          same_site: :lax,
+          expires: 7.days.from_now
+        }
+        touch_player_presence(@join_form_player)
+        redirect_to play_game_path(@game.code)
+      else
+        @player_stream_token = ""
+        @state = @game.public_player_state.merge(joined: false)
+        render :show, status: :unprocessable_entity
+      end
+    end
+
+    def state
+      if @player
+        touch_player_presence(@player) unless @game.finished?
+        render json: @game.player_state(@player)
+      else
+        render json: @game.public_player_state.merge(joined: false)
+      end
+    end
+
+    def answer
+      unless @player
+        render json: { ok: false, error: "Not joined" }, status: :unauthorized
+        return
+      end
+
+      game_question_id = params[:game_question_id].to_i
+      game_option_id = params[:game_option_id].to_i
+
+      selected_id = @game.submit_answer!(
+        player: @player,
+        game_question_id: game_question_id,
+        game_option_id: game_option_id
+      )
+
+      if selected_id
+        GamePresence.touch_http(@game.id, @player.id)
+        @game.broadcast_moderator_state!
+        @game.broadcast_player_answer!(@player.id, game_question_id, selected_id)
+        render json: {
+          ok: true,
+          game_question_id: game_question_id,
+          selected_option_id: selected_id
+        }
+      else
+        @game.reload
+        render json: {
+          ok: false,
+          state: @game.player_state(@player)
+        }, status: :conflict
+      end
+    end
+
+    def leave
+      if @player
+        changed, _count = GamePresence.leave_http(@game.id, @player.id)
+        @game.broadcast_moderator_state! if changed && (@game.lobby? || @game.question_open?)
+      end
+
+      head :no_content
+    end
+
+    private
+
+    def set_no_store_cache
+      response.headers["Cache-Control"] = "no-store"
+    end
+
+    def set_game
+      @game = Game.includes(:quiz).find_by!(code: params[:code].to_s.upcase)
+    end
+
+    def load_player
+      token = cookies.signed[Game.player_cookie_name(@game.code)]
+      @player = token.present? ? @game.players.find_by(token: token) : nil
+    end
+
+    def touch_player_presence(player)
+      changed, _count = GamePresence.touch_http(@game.id, player.id)
+      @game.broadcast_moderator_state! if changed && (@game.lobby? || @game.question_open?)
+    end
+
+    def join_name_param
+      player_param = params[:player]
+      return player_param[:name].to_s if player_param.is_a?(ActionController::Parameters) || player_param.is_a?(Hash)
+
+      params[:name].to_s
+    end
+  end
+end
diff --git a/app/javascript/controllers/moderator_game_controller.js b/app/javascript/controllers/moderator_game_controller.js
new file mode 100644
index 0000000..034168c
--- /dev/null
+++ b/app/javascript/controllers/moderator_game_controller.js
@@ -0,0 +1,494 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["screen", "topMeta", "stage", "controlsInfo", "controlsAction", "qrTemplate"]
+  static values = {
+    gameId: Number,
+    token: String,
+    initialState: Object,
+    stateUrl: String,
+    startUrl: String,
+    finishUrl: String,
+    nextUrl: String,
+    endUrl: String,
+    quizUrl: String,
+    joinUrl: String
+  }
+
+  connect() {
+    this.state = this.initialStateValue || {}
+    this.renderedKey = this.viewKey(this.state)
+    this.cableConnected = false
+    this.actionInFlight = false
+    this.pollTimer = null
+    this.connectGraceTimer = null
+
+    this.handleOnline = () => this.recoverConnection()
+    this.handleVisibility = () => {
+      if (document.visibilityState === "visible") this.recoverConnection()
+    }
+    this.handlePageShow = (event) => {
+      if (event.persisted) this.recoverConnection()
+    }
+
+    window.addEventListener("online", this.handleOnline)
+    document.addEventListener("visibilitychange", this.handleVisibility)
+    window.addEventListener("pageshow", this.handlePageShow)
+
+    if (this.state.status !== "finished") {
+      this.connectCable()
+      this.connectGraceTimer = setTimeout(() => {
+        if (!this.cableConnected && this.state.status !== "finished") {
+          this.startPolling()
+        }
+      }, 2500)
+    }
+  }
+
+  disconnect() {
+    this.stopConnectGrace()
+    this.stopPolling()
+    window.removeEventListener("online", this.handleOnline)
+    document.removeEventListener("visibilitychange", this.handleVisibility)
+    window.removeEventListener("pageshow", this.handlePageShow)
+
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  connectCable() {
+    const wsUrl = `${window.location.origin.replace(/^http/, "ws")}/cable`
+    this.consumer = createConsumer(wsUrl)
+    this.subscription = this.consumer.subscriptions.create(
+      {
+        channel: "ModeratorChannel",
+        game_id: this.gameIdValue,
+        token: this.tokenValue
+      },
+      {
+        connected: () => {
+          this.cableConnected = true
+          this.stopConnectGrace()
+          this.stopPolling()
+        },
+        disconnected: () => {
+          this.cableConnected = false
+          if (this.state.status !== "finished") {
+            this.startPolling()
+          }
+        },
+        received: (data) => {
+          this.applyState(data)
+        }
+      }
+    )
+  }
+
+  stopConnectGrace() {
+    if (this.connectGraceTimer) {
+      clearTimeout(this.connectGraceTimer)
+      this.connectGraceTimer = null
+    }
+  }
+
+  recoverConnection() {
+    if (this.state.status === "finished") return
+    if (this.consumer) {
+      const conn = this.consumer.connection
+      if (!conn.isOpen() || conn.monitor.connectionIsStale()) {
+        conn.reopen()
+      }
+    }
+    this.syncState()
+  }
+
+  startPolling() {
+    if (this.pollTimer || this.state.status === "finished") return
+    this.pollTimer = setInterval(() => this.syncState(), 1500)
+  }
+
+  stopPolling() {
+    if (this.pollTimer) {
+      clearInterval(this.pollTimer)
+      this.pollTimer = null
+    }
+  }
+
+  async syncState() {
+    try {
+      const url = new URL(this.stateUrlValue, window.location.origin).href
+      const response = await fetch(url, {
+        headers: { "Accept": "application/json" },
+        credentials: "same-origin",
+        cache: "no-store"
+      })
+      if (!response.ok) return
+      const data = await response.json()
+      this.applyState(data)
+    } catch {
+      // Transient network error; next poll/reconnect will retry
+    }
+  }
+
+  start() {
+    this.postTransition(this.startUrlValue)
+  }
+
+  finish() {
+    this.postTransition(this.finishUrlValue, {
+      expected_question_id: this.state.question?.id
+    })
+  }
+
+  nextQuestion() {
+    this.postTransition(this.nextUrlValue, {
+      expected_question_id: this.state.question?.id
+    })
+  }
+
+  endGame() {
+    this.postTransition(this.endUrlValue, {
+      expected_question_id: this.state.question?.id
+    })
+  }
+
+  async postTransition(path, payload = {}) {
+    if (this.actionInFlight) return
+    this.actionInFlight = true
+    this.setActionButtonsDisabled(true)
+
+    try {
+      const csrfToken = document.querySelector("meta[name='csrf-token']")?.content || ""
+      const url = new URL(path, window.location.origin).href
+      const response = await fetch(url, {
+        method: "POST",
+        headers: {
+          "Content-Type": "application/json",
+          "Accept": "application/json",
+          "X-CSRF-Token": csrfToken
+        },
+        credentials: "same-origin",
+        body: JSON.stringify(payload)
+      })
+
+      if (response.ok) {
+        const data = await response.json()
+        this.applyState(data)
+      } else {
+        await this.syncState()
+      }
+    } catch {
+      await this.syncState()
+    } finally {
+      this.actionInFlight = false
+      this.setActionButtonsDisabled(false)
+    }
+  }
+
+  setActionButtonsDisabled(disabled) {
+    if (!this.hasControlsActionTarget) return
+    this.controlsActionTarget.querySelectorAll("button").forEach((btn) => {
+      btn.disabled = disabled
+    })
+  }
+
+  stateRank(state) {
+    if (!state || !state.status) return [-1, 0]
+    switch (state.status) {
+      case "lobby":
+        return [0, 0]
+      case "question_open":
+        return [state.question?.number || 1, 1]
+      case "question_closed":
+        return [state.question?.number || 1, 2]
+      case "finished":
+        return [Number.MAX_SAFE_INTEGER, 0]
+      default:
+        return [-1, 0]
+    }
+  }
+
+  compareRank(a, b) {
+    if (a[0] !== b[0]) return a[0] - b[0]
+    return a[1] - b[1]
+  }
+
+  viewKey(state) {
+    if (!state || !state.status) return ""
+    if (state.status === "question_open" || state.status === "question_closed") {
+      return `${state.status}:${state.question?.id}`
+    }
+    return state.status
+  }
+
+  applyState(nextState) {
+    if (!nextState || !nextState.status) return
+    if (this.compareRank(this.stateRank(nextState), this.stateRank(this.state)) < 0) {
+      return
+    }
+
+    this.state = nextState
+    const nextKey = this.viewKey(nextState)
+
+    if (nextState.status === "finished") {
+      this.stopConnectGrace()
+      this.stopPolling()
+    }
+
+    if (nextKey === this.renderedKey) {
+      this.updateLiveCounters(nextState)
+      return
+    }
+
+    this.renderedKey = nextKey
+    this.renderFull(nextState)
+  }
+
+  updateLiveCounters(state) {
+    if (state.status === "lobby") {
+      const el = this.stageTarget.querySelector("[data-role='players-count']")
+      if (el) {
+        const count = state.players_count ?? state.active_players_count ?? 0
+        el.textContent = String(count)
+      }
+    } else if (state.status === "question_open") {
+      const el = this.topMetaTarget.querySelector("[data-role='answers-counter']")
+      if (el) {
+        const answered = state.answers_count ?? 0
+        const active = state.active_players_count ?? 0
+        el.textContent = `Answers: ${answered} / ${active}`
+      }
+    }
+  }
+
+  renderFull(state) {
+    if (state.status === "lobby") {
+      this.screenTarget.className = "screen cover"
+    } else if (state.status === "finished") {
+      this.screenTarget.className = "screen cover cover--night"
+    } else {
+      this.screenTarget.className = "screen cover cover--blue"
+    }
+
+    this.renderTopMeta(state)
+    this.renderStage(state)
+    this.renderControlsAction(state)
+  }
+
+  renderTopMeta(state) {
+    this.topMetaTarget.replaceChildren()
+
+    if (state.status === "question_open") {
+      const counter = document.createElement("div")
+      counter.className = "answers-counter"
+      counter.dataset.role = "answers-counter"
+      counter.textContent = `Answers: ${state.answers_count ?? 0} / ${state.active_players_count ?? 0}`
+      this.topMetaTarget.appendChild(counter)
+    } else if (state.status === "question_closed" || state.status === "finished") {
+      const title = document.createElement("div")
+      title.className = "screen__quiz-title"
+      title.textContent = state.quiz_title || ""
+      this.topMetaTarget.appendChild(title)
+    }
+  }
+
+  renderStage(state) {
+    this.stageTarget.replaceChildren()
+
+    if (state.status === "lobby") {
+      const lobby = document.createElement("div")
+      lobby.className = "lobby"
+
+      const left = document.createElement("div")
+
+      const title = document.createElement("h1")
+      title.className = "lobby__title"
+      title.textContent = state.quiz_title || ""
+
+      const joinLabel = document.createElement("div")
+      joinLabel.className = "lobby__join"
+      joinLabel.textContent = "Join at"
+
+      const joinUrl = document.createElement("div")
+      joinUrl.className = "lobby__url"
+      joinUrl.textContent = this.joinUrlValue
+
+      const pill = document.createElement("div")
+      pill.className = "counter-pill"
+      const pillSpan = document.createElement("span")
+      pillSpan.append(document.createTextNode("Players: "))
+      const strong = document.createElement("strong")
+      strong.dataset.role = "players-count"
+      strong.textContent = String(state.players_count ?? state.active_players_count ?? 0)
+      pillSpan.appendChild(strong)
+      pill.appendChild(pillSpan)
+
+      left.append(title, joinLabel, joinUrl, pill)
+
+      const qr = document.createElement("div")
+      qr.className = "qr"
+      if (this.hasQrTemplateTarget) {
+        qr.appendChild(this.qrTemplateTarget.content.cloneNode(true))
+      }
+
+      lobby.append(left, qr)
+      this.stageTarget.appendChild(lobby)
+      return
+    }
+
+    if (state.status === "question_open" && state.question) {
+      const q = state.question
+      const wrap = document.createElement("div")
+      wrap.className = "stage-question"
+
+      const num = document.createElement("div")
+      num.className = "stage-question__num"
+      num.textContent = `Question ${q.number} of ${q.total}`
+
+      const body = document.createElement("div")
+      body.className = "stage-question__body"
+      body.textContent = q.body
+
+      const list = document.createElement("ol")
+      list.className = "stage-options"
+
+      q.options.forEach((opt) => {
+        const li = document.createElement("li")
+        li.className = "stage-option"
+
+        const letter = document.createElement("span")
+        letter.className = "stage-option__letter"
+        letter.setAttribute("aria-hidden", "true")
+        letter.textContent = opt.letter
+
+        const optTitle = document.createElement("span")
+        optTitle.className = "stage-option__title"
+        optTitle.textContent = opt.body
+
+        li.append(letter, optTitle)
+        list.appendChild(li)
+      })
+
+      wrap.append(num, body, list)
+      this.stageTarget.appendChild(wrap)
+      return
+    }
+
+    if (state.status === "question_closed" && state.question) {
+      const q = state.question
+      const wrap = document.createElement("div")
+      wrap.className = "stage-question"
+
+      const num = document.createElement("div")
+      num.className = "stage-question__num"
+      num.textContent = `Question ${q.number} of ${q.total}`
+
+      const body = document.createElement("div")
+      body.className = "stage-question__body"
+      body.textContent = q.body
+
+      const list = document.createElement("ol")
+      list.className = "stage-options stage-options--results"
+
+      q.options.forEach((opt) => {
+        const li = document.createElement("li")
+        li.className = opt.correct ? "stage-option is-correct" : "stage-option"
+        if (opt.correct) li.dataset.correct = "true"
+
+        const bar = document.createElement("span")
+        bar.className = "stage-option__bar"
+        bar.style.setProperty("--share", `${opt.share ?? 0}%`)
+        bar.setAttribute("aria-hidden", "true")
+
+        const letter = document.createElement("span")
+        letter.className = "stage-option__letter"
+        letter.setAttribute("aria-hidden", "true")
+        letter.textContent = opt.letter
+
+        const optTitle = document.createElement("span")
+        optTitle.className = "stage-option__title"
+        optTitle.textContent = opt.body
+
+        li.append(bar, letter, optTitle)
+
+        if (opt.correct) {
+          const mark = document.createElement("span")
+          mark.className = "stage-option__mark"
+          mark.textContent = "Correct"
+          li.appendChild(mark)
+        }
+
+        const count = document.createElement("span")
+        count.className = "stage-option__count"
+        count.textContent = String(opt.count ?? 0)
+        li.appendChild(count)
+
+        list.appendChild(li)
+      })
+
+      wrap.append(num, body, list)
+      this.stageTarget.appendChild(wrap)
+      return
+    }
+
+    if (state.status === "finished") {
+      const wrap = document.createElement("div")
+      wrap.className = "stage-over"
+
+      const kicker = document.createElement("div")
+      kicker.className = "screen__kicker"
+      kicker.textContent = state.quiz_title || ""
+
+      const title = document.createElement("h1")
+      title.className = "lobby__title"
+      title.textContent = "The quiz is over"
+
+      wrap.append(kicker, title)
+      this.stageTarget.appendChild(wrap)
+    }
+  }
+
+  renderControlsAction(state) {
+    this.controlsActionTarget.replaceChildren()
+
+    let label = null
+    let btnClass = "btn btn--light"
+    let handler = null
+
+    if (state.status === "lobby") {
+      label = "Start"
+      btnClass = "btn btn--light"
+      handler = () => this.start()
+    } else if (state.status === "question_open") {
+      label = "Finish"
+      btnClass = "btn btn--pink"
+      handler = () => this.finish()
+    } else if (state.status === "question_closed" && state.question) {
+      if (state.question.is_last) {
+        label = "End quiz"
+        btnClass = "btn btn--pink"
+        handler = () => this.endGame()
+      } else {
+        label = "Next"
+        btnClass = "btn btn--light"
+        handler = () => this.nextQuestion()
+      }
+    }
+
+    if (label && handler) {
+      const btn = document.createElement("button")
+      btn.type = "button"
+      btn.className = btnClass
+      btn.textContent = label
+      btn.addEventListener("click", handler)
+      this.controlsActionTarget.appendChild(btn)
+    }
+  }
+}
diff --git a/app/javascript/controllers/player_game_controller.js b/app/javascript/controllers/player_game_controller.js
new file mode 100644
index 0000000..98d8306
--- /dev/null
+++ b/app/javascript/controllers/player_game_controller.js
@@ -0,0 +1,608 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["topMeta", "body"]
+  static values = {
+    code: String,
+    joined: Boolean,
+    playerToken: String,
+    initialState: Object,
+    stateUrl: String,
+    answerUrl: String,
+    leaveUrl: String
+  }
+
+  connect() {
+    this.state = this.initialStateValue || {}
+    this.playerName = this.state.player?.name || ""
+    this.selectedOptionId = this.state.selected_option_id ?? null
+    this.renderedKey = this.viewKey(this.state)
+    this.cableConnected = false
+    this.sendingPick = false
+    this.pendingPick = null
+    this.needsClosedSync = false
+    this.heartbeatTimer = null
+    this.pollTimer = null
+    this.connectGraceTimer = null
+
+    this.handleOnline = () => this.recoverConnection()
+    this.handleVisibility = () => {
+      if (document.visibilityState === "visible") this.recoverConnection()
+    }
+    this.handlePageShow = (event) => {
+      if (event.persisted) this.recoverConnection()
+    }
+    this.handlePageHide = () => {
+      if (this.joinedValue && !this.cableConnected && this.leaveUrlValue && this.state.status !== "finished") {
+        this.sendLeaveBeacon()
+      }
+    }
+
+    window.addEventListener("online", this.handleOnline)
+    document.addEventListener("visibilitychange", this.handleVisibility)
+    window.addEventListener("pageshow", this.handlePageShow)
+    window.addEventListener("pagehide", this.handlePageHide)
+
+    if (this.state.status !== "finished") {
+      this.connectCable()
+      this.connectGraceTimer = setTimeout(() => {
+        if (!this.cableConnected && this.state.status !== "finished") {
+          this.startPolling()
+        }
+      }, 2500)
+    }
+  }
+
+  disconnect() {
+    this.stopConnectGrace()
+    this.stopHeartbeat()
+    this.stopPolling()
+    window.removeEventListener("online", this.handleOnline)
+    document.removeEventListener("visibilitychange", this.handleVisibility)
+    window.removeEventListener("pageshow", this.handlePageShow)
+    window.removeEventListener("pagehide", this.handlePageHide)
+
+    if (this.subscription) {
+      this.subscription.unsubscribe()
+      this.subscription = null
+    }
+    if (this.consumer) {
+      this.consumer.disconnect()
+      this.consumer = null
+    }
+  }
+
+  connectCable() {
+    const wsUrl = `${window.location.origin.replace(/^http/, "ws")}/cable`
+    this.consumer = createConsumer(wsUrl)
+    this.subscription = this.consumer.subscriptions.create(
+      {
+        channel: "PlayerChannel",
+        code: this.codeValue,
+        player_token: this.playerTokenValue || ""
+      },
+      {
+        connected: () => {
+          this.cableConnected = true
+          this.stopConnectGrace()
+          this.stopPolling()
+          if (this.joinedValue && this.state.status !== "finished") {
+            this.startHeartbeat()
+          }
+        },
+        disconnected: () => {
+          this.cableConnected = false
+          this.stopHeartbeat()
+          if (this.state.status !== "finished") {
+            this.startPolling()
+          }
+        },
+        received: (data) => {
+          this.handleMessage(data)
+        }
+      }
+    )
+  }
+
+  stopConnectGrace() {
+    if (this.connectGraceTimer) {
+      clearTimeout(this.connectGraceTimer)
+      this.connectGraceTimer = null
+    }
+  }
+
+  recoverConnection() {
+    if (this.state.status === "finished") return
+    if (this.consumer) {
+      const conn = this.consumer.connection
+      if (!conn.isOpen() || conn.monitor.connectionIsStale()) {
+        conn.reopen()
+      }
+    }
+    this.syncState()
+  }
+
+  startHeartbeat() {
+    if (this.heartbeatTimer || !this.joinedValue || this.state.status === "finished") return
+    this.heartbeatTimer = setInterval(() => {
+      if (this.cableConnected && this.subscription) {
+        this.subscription.perform("heartbeat")
+      }
+    }, 3000)
+  }
+
+  stopHeartbeat() {
+    if (this.heartbeatTimer) {
+      clearInterval(this.heartbeatTimer)
+      this.heartbeatTimer = null
+    }
+  }
+
+  startPolling() {
+    if (this.pollTimer || this.state.status === "finished") return
+    this.pollTimer = setInterval(() => this.syncState(), 1500)
+  }
+
+  stopPolling() {
+    if (this.pollTimer) {
+      clearInterval(this.pollTimer)
+      this.pollTimer = null
+    }
+  }
+
+  sendLeaveBeacon() {
+    try {
+      const csrfToken = document.querySelector("meta[name='csrf-token']")?.content || ""
+      const formData = new FormData()
+      formData.append("authenticity_token", csrfToken)
+      navigator.sendBeacon(new URL(this.leaveUrlValue, window.location.origin).href, formData)
+    } catch {
+      // Best effort
+    }
+  }
+
+  async syncState() {
+    try {
+      const url = new URL(this.stateUrlValue, window.location.origin).href
+      const response = await fetch(url, {
+        headers: { "Accept": "application/json" },
+        credentials: "same-origin",
+        cache: "no-store"
+      })
+      if (!response.ok) return
+      const data = await response.json()
+      this.applyState(data)
+    } catch {
+      // Retry on next tick/reconnect
+    }
+  }
+
+  handleMessage(data) {
+    if (!data) return
+
+    if (data.type === "answer_updated") {
+      if (
+        this.joinedValue &&
+        this.state.status === "question_open" &&
+        this.state.question &&
+        this.state.question.id === data.game_question_id &&
+        !this.sendingPick &&
+        !this.pendingPick
+      ) {
+        this.selectedOptionId = data.selected_option_id
+        this.updateOpenOptionSelection()
+      }
+      return
+    }
+
+    this.applyState(data)
+  }
+
+  pickOption(event) {
+    const button = event.currentTarget
+    if (!this.joinedValue || this.state.status !== "question_open" || !this.state.question) return
+
+    const optionId = Number(button.dataset.optionId)
+    if (!optionId) return
+
+    this.pendingPick = {
+      questionId: this.state.question.id,
+      optionId: optionId
+    }
+
+    this.setPendingButton(optionId)
+    this.flushPendingPick()
+  }
+
+  setPendingButton(optionId) {
+    this.bodyTarget.querySelectorAll("button.play-option").forEach((btn) => {
+      btn.classList.toggle("is-pending", Number(btn.dataset.optionId) === optionId)
+    })
+  }
+
+  clearPendingButtons() {
+    this.bodyTarget.querySelectorAll("button.play-option.is-pending").forEach((btn) => {
+      btn.classList.remove("is-pending")
+    })
+  }
+
+  async flushPendingPick() {
+    if (this.sendingPick) return
+    this.sendingPick = true
+
+    try {
+      while (this.pendingPick && this.state.status === "question_open" && this.state.question) {
+        const pick = this.pendingPick
+        this.pendingPick = null
+
+        if (pick.questionId !== this.state.question.id) continue
+
+        const result = await this.submitPickWithRetry(pick)
+
+        if (result.conflict && result.state) {
+          this.pendingPick = null
+          this.clearPendingButtons()
+          this.applyState(result.state)
+          break
+        }
+
+        if (result.ok) {
+          if (this.state.status === "question_open" && this.state.question?.id === pick.questionId) {
+            this.selectedOptionId = result.selected_option_id
+            if (!this.pendingPick) {
+              this.clearPendingButtons()
+              this.updateOpenOptionSelection()
+            }
+          }
+        }
+      }
+    } finally {
+      this.sendingPick = false
+      this.clearPendingButtons()
+
+      if (this.needsClosedSync) {
+        this.needsClosedSync = false
+        await this.syncState()
+      }
+    }
+  }
+
+  async submitPickWithRetry(pick) {
+    const delays = [300, 600, 1200, 2000]
+    const csrfToken = document.querySelector("meta[name='csrf-token']")?.content || ""
+    const url = new URL(this.answerUrlValue, window.location.origin).href
+
+    for (let attempt = 0; attempt <= delays.length; attempt++) {
+      if (this.pendingPick || this.state.status !== "question_open" || this.state.question?.id !== pick.questionId) {
+        return { superseded: true }
+      }
+
+      try {
+        const response = await fetch(url, {
+          method: "POST",
+          headers: {
+            "Content-Type": "application/json",
+            "Accept": "application/json",
+            "X-CSRF-Token": csrfToken
+          },
+          credentials: "same-origin",
+          body: JSON.stringify({
+            game_question_id: pick.questionId,
+            game_option_id: pick.optionId
+          })
+        })
+
+        if (response.ok) {
+          return await response.json()
+        }
+
+        if (response.status === 409) {
+          const data = await response.json().catch(() => ({}))
+          return { conflict: true, state: data.state }
+        }
+
+        if (response.status >= 400 && response.status < 500) {
+          return { failed: true }
+        }
+      } catch {
+        // Network error on conference Wi-Fi; retry below
+      }
+
+      if (attempt < delays.length) {
+        await new Promise((resolve) => setTimeout(resolve, delays[attempt]))
+      }
+    }
+
+    return { failed: true }
+  }
+
+  stateRank(state) {
+    if (!state || !state.status) return [-1, 0]
+    switch (state.status) {
+      case "lobby":
+        return [0, 0]
+      case "question_open":
+        return [state.question?.number || 1, 1]
+      case "question_closed":
+        return [state.question?.number || 1, 2]
+      case "finished":
+        return [Number.MAX_SAFE_INTEGER, 0]
+      default:
+        return [-1, 0]
+    }
+  }
+
+  compareRank(a, b) {
+    if (a[0] !== b[0]) return a[0] - b[0]
+    return a[1] - b[1]
+  }
+
+  viewKey(state) {
+    if (!state || !state.status) return ""
+    if (state.status === "finished") return "finished"
+    if (!this.joinedValue) return "join_form"
+    if (state.status === "question_open" || state.status === "question_closed") {
+      return `${state.status}:${state.question?.id}`
+    }
+    return state.status
+  }
+
+  applyState(nextState) {
+    if (!nextState || !nextState.status) return
+
+    if (nextState.player?.name) {
+      this.playerName = nextState.player.name
+    }
+
+    // If visitor has not joined yet, keep join form intact unless the quiz ended
+    if (!this.joinedValue) {
+      if (nextState.status === "finished") {
+        this.state = nextState
+        this.renderedKey = "finished"
+        this.stopConnectGrace()
+        this.stopPolling()
+        this.stopHeartbeat()
+        this.renderFinished(nextState)
+      }
+      return
+    }
+
+    const rankDiff = this.compareRank(this.stateRank(nextState), this.stateRank(this.state))
+    if (rankDiff < 0) return
+
+    const prevQuestionId = this.state.question?.id
+    const nextQuestionId = nextState.question?.id
+    const questionChanged = prevQuestionId !== nextQuestionId
+
+    if ("selected_option_id" in nextState) {
+      if (!this.sendingPick && !this.pendingPick) {
+        this.selectedOptionId = nextState.selected_option_id
+      }
+    } else if (questionChanged) {
+      this.selectedOptionId = null
+      this.pendingPick = null
+    }
+
+    const wasOpen = this.state.status === "question_open"
+    this.state = nextState
+
+    if (nextState.status === "finished") {
+      this.stopConnectGrace()
+      this.stopPolling()
+      this.stopHeartbeat()
+      if (this.renderedKey !== "finished") {
+        this.renderedKey = "finished"
+        this.renderFinished(nextState)
+      }
+      return
+    }
+
+    if (nextState.status === "question_closed" && wasOpen && this.sendingPick) {
+      this.needsClosedSync = true
+    }
+
+    const nextKey = this.viewKey(nextState)
+    if (nextKey === this.renderedKey) {
+      if (nextState.status === "question_open") {
+        this.updateOpenOptionSelection()
+      } else if (nextState.status === "question_closed" && ("outcome" in nextState || "selected_option_id" in nextState)) {
+        this.renderClosedQuestion(nextState)
+      }
+      return
+    }
+
+    this.renderedKey = nextKey
+
+    if (nextState.status === "lobby") {
+      this.renderLobby(nextState)
+    } else if (nextState.status === "question_open") {
+      this.renderOpenQuestion(nextState)
+    } else if (nextState.status === "question_closed") {
+      this.renderClosedQuestion(nextState)
+    }
+  }
+
+  updateOpenOptionSelection() {
+    const buttons = this.bodyTarget.querySelectorAll("button.play-option")
+    buttons.forEach((btn) => {
+      const isPicked = Number(btn.dataset.optionId) === this.selectedOptionId
+      btn.classList.toggle("is-picked", isPicked)
+      const mark = btn.querySelector(".play-option__mark")
+      if (mark) {
+        mark.textContent = isPicked ? "Your answer" : ""
+      }
+    })
+  }
+
+  renderLobby(state) {
+    this.topMetaTarget.textContent = state.quiz_title || ""
+    this.bodyTarget.className = "play__body"
+    this.bodyTarget.replaceChildren()
+
+    const waiting = document.createElement("div")
+    waiting.className = "waiting"
+
+    const gem = document.createElement("div")
+    gem.className = "waiting__gem"
+    gem.setAttribute("aria-hidden", "true")
+    gem.textContent = "?"
+
+    const title = document.createElement("h1")
+    title.className = "play-title"
+    title.textContent = `Hi, ${this.playerName}!`
+
+    const lead = document.createElement("p")
+    lead.className = "play-lead"
+    lead.textContent = "Waiting for the quiz to start…"
+
+    waiting.append(gem, title, lead)
+    this.bodyTarget.appendChild(waiting)
+  }
+
+  renderOpenQuestion(state) {
+    const q = state.question
+    if (!q) return
+
+    this.topMetaTarget.textContent = `Hi, ${this.playerName}!`
+    this.bodyTarget.className = "play__body play__body--top"
+    this.bodyTarget.replaceChildren()
+
+    const num = document.createElement("div")
+    num.className = "play-question__num"
+    num.textContent = `Question ${q.number} of ${q.total}`
+
+    const body = document.createElement("div")
+    body.className = "play-question__body"
+    body.textContent = q.body
+
+    const optionsEl = document.createElement("div")
+    optionsEl.className = "play-options"
+
+    q.options.forEach((opt) => {
+      const picked = this.selectedOptionId === opt.id
+      const btn = document.createElement("button")
+      btn.type = "button"
+      btn.className = picked ? "play-option is-picked" : "play-option"
+      btn.dataset.optionId = String(opt.id)
+      btn.addEventListener("click", (event) => this.pickOption(event))
+
+      const letter = document.createElement("span")
+      letter.className = "play-option__letter"
+      letter.setAttribute("aria-hidden", "true")
+      letter.textContent = opt.letter
+
+      const title = document.createElement("span")
+      title.className = "play-option__title"
+      title.textContent = opt.body
+
+      const mark = document.createElement("span")
+      mark.className = "play-option__mark"
+      mark.textContent = picked ? "Your answer" : ""
+
+      btn.append(letter, title, mark)
+      optionsEl.appendChild(btn)
+    })
+
+    const feedback = document.createElement("div")
+    feedback.className = "play-feedback"
+    feedback.dataset.role = "feedback"
+
+    this.bodyTarget.append(num, body, optionsEl, feedback)
+  }
+
+  renderClosedQuestion(state) {
+    const q = state.question
+    if (!q) return
+
+    this.topMetaTarget.textContent = `Hi, ${this.playerName}!`
+    this.bodyTarget.className = "play__body play__body--top"
+    this.bodyTarget.replaceChildren()
+
+    const num = document.createElement("div")
+    num.className = "play-question__num"
+    num.textContent = `Question ${q.number} of ${q.total}`
+
+    const body = document.createElement("div")
+    body.className = "play-question__body"
+    body.textContent = q.body
+
+    const optionsEl = document.createElement("div")
+    optionsEl.className = "play-options is-locked is-revealed"
+
+    const selectedId = "selected_option_id" in state ? state.selected_option_id : this.selectedOptionId
+    this.selectedOptionId = selectedId
+
+    q.options.forEach((opt) => {
+      const picked = selectedId === opt.id
+      const btn = document.createElement("button")
+      btn.type = "button"
+      btn.disabled = true
+      const classes = ["play-option"]
+      if (picked) classes.push("is-picked")
+      if (opt.correct) classes.push("is-correct")
+      btn.className = classes.join(" ")
+
+      const letter = document.createElement("span")
+      letter.className = "play-option__letter"
+      letter.setAttribute("aria-hidden", "true")
+      letter.textContent = opt.letter
+
+      const title = document.createElement("span")
+      title.className = "play-option__title"
+      title.textContent = opt.body
+
+      const mark = document.createElement("span")
+      mark.className = "play-option__mark"
+      mark.textContent = picked ? "Your answer" : (opt.correct ? "✓" : "")
+
+      btn.append(letter, title, mark)
+      optionsEl.appendChild(btn)
+    })
+
+    let outcome = state.outcome
+    if (!outcome) {
+      if (selectedId == null) {
+        outcome = "no_answer"
+      } else {
+        const pickedOpt = q.options.find((opt) => opt.id === selectedId)
+        outcome = pickedOpt && pickedOpt.correct ? "correct" : "wrong"
+      }
+    }
+
+    const statusEl = document.createElement("div")
+    statusEl.setAttribute("role", "status")
+    if (outcome === "correct") {
+      statusEl.className = "play-status play-status--right"
+      statusEl.textContent = "Correct!"
+    } else if (outcome === "wrong") {
+      statusEl.className = "play-status play-status--wrong"
+      statusEl.textContent = "Wrong!"
+    } else {
+      statusEl.className = "play-status play-status--neutral"
+      statusEl.textContent = "No answer"
+    }
+
+    this.bodyTarget.append(num, body, optionsEl, statusEl)
+  }
+
+  renderFinished(state) {
+    this.topMetaTarget.textContent = state.quiz_title || ""
+    this.bodyTarget.className = "play__body"
+    this.bodyTarget.replaceChildren()
+
+    const card = document.createElement("div")
+    card.className = "result-card"
+
+    const title = document.createElement("div")
+    title.className = "play-title"
+    title.textContent = "The quiz is over"
+
+    const lead = document.createElement("p")
+    lead.className = "play-lead"
+    lead.textContent = "Thanks for playing!"
+
+    card.append(title, lead)
+    this.bodyTarget.appendChild(card)
+  }
+}
