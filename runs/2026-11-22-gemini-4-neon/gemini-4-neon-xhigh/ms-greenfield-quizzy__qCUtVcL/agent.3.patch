diff --git a/app/views/moderate/games/show.html.erb b/app/views/moderate/games/show.html.erb
new file mode 100644
index 0000000..4f84d05
--- /dev/null
+++ b/app/views/moderate/games/show.html.erb
@@ -0,0 +1,113 @@
+<% content_for :title, "Quizzy · Live · #{@quiz.title}" %>
+
+<%
+  cover_class = case @state[:status]
+                when "lobby" then "screen cover"
+                when "finished" then "screen cover cover--night"
+                else "screen cover cover--blue"
+                end
+%>
+
+<div class="<%= cover_class %>"
+     data-controller="moderator-game"
+     data-moderator-game-game-id-value="<%= @game.id %>"
+     data-moderator-game-token-value="<%= @moderator_token %>"
+     data-moderator-game-initial-state-value="<%= @state.to_json %>"
+     data-moderator-game-state-url-value="<%= state_moderate_game_path(@game) %>"
+     data-moderator-game-start-url-value="<%= start_moderate_game_path(@game) %>"
+     data-moderator-game-finish-url-value="<%= finish_moderate_game_path(@game) %>"
+     data-moderator-game-next-url-value="<%= next_question_moderate_game_path(@game) %>"
+     data-moderator-game-end-url-value="<%= end_game_moderate_game_path(@game) %>"
+     data-moderator-game-quiz-url-value="<%= moderate_quiz_path(@quiz) %>"
+     data-moderator-game-join-url-value="<%= @join_url %>"
+     data-moderator-game-target="screen">
+
+  <template data-moderator-game-target="qrTemplate"><%= @qr_svg.html_safe %></template>
+
+  <header class="screen__top">
+    <span class="logo screen__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+    <div data-moderator-game-target="topMeta">
+      <% if @state[:status] == "question_open" %>
+        <div class="answers-counter" data-role="answers-counter">Answers: <%= @state[:answers_count] %> / <%= @state[:active_players_count] %></div>
+      <% elsif @state[:status] == "question_closed" || @state[:status] == "finished" %>
+        <div class="screen__quiz-title"><%= @quiz.title %></div>
+      <% end %>
+    </div>
+  </header>
+
+  <main class="screen__body" data-moderator-game-target="stage">
+    <% case @state[:status] %>
+    <% when "lobby" %>
+      <div class="lobby">
+        <div>
+          <h1 class="lobby__title"><%= @quiz.title %></h1>
+          <div class="lobby__join">Join at</div>
+          <div class="lobby__url"><%= @join_url %></div>
+          <div class="counter-pill"><span>Players: <strong data-role="players-count"><%= @state[:players_count] %></strong></span></div>
+        </div>
+        <div class="qr"><%= @qr_svg.html_safe %></div>
+      </div>
+
+    <% when "question_open" %>
+      <% q = @state[:question] %>
+      <div class="stage-question">
+        <div class="stage-question__num">Question <%= q[:number] %> of <%= q[:total] %></div>
+        <div class="stage-question__body"><%= q[:body] %></div>
+        <ol class="stage-options">
+          <% q[:options].each do |opt| %>
+            <li class="stage-option">
+              <span class="stage-option__letter" aria-hidden="true"><%= opt[:letter] %></span>
+              <span class="stage-option__title"><%= opt[:body] %></span>
+            </li>
+          <% end %>
+        </ol>
+      </div>
+
+    <% when "question_closed" %>
+      <% q = @state[:question] %>
+      <div class="stage-question">
+        <div class="stage-question__num">Question <%= q[:number] %> of <%= q[:total] %></div>
+        <div class="stage-question__body"><%= q[:body] %></div>
+        <ol class="stage-options stage-options--results">
+          <% q[:options].each do |opt| %>
+            <li class="stage-option <%= 'is-correct' if opt[:correct] %>"<%= ' data-correct="true"'.html_safe if opt[:correct] %>>
+              <span class="stage-option__bar" style="--share: <%= opt[:share] %>%" aria-hidden="true"></span>
+              <span class="stage-option__letter" aria-hidden="true"><%= opt[:letter] %></span>
+              <span class="stage-option__title"><%= opt[:body] %></span>
+              <% if opt[:correct] %>
+                <span class="stage-option__mark">Correct</span>
+              <% end %>
+              <span class="stage-option__count"><%= opt[:count] %></span>
+            </li>
+          <% end %>
+        </ol>
+      </div>
+
+    <% when "finished" %>
+      <div class="stage-over">
+        <div class="screen__kicker"><%= @quiz.title %></div>
+        <h1 class="lobby__title">The quiz is over</h1>
+      </div>
+    <% end %>
+  </main>
+
+  <footer class="screen-controls">
+    <div class="screen-controls__info" data-moderator-game-target="controlsInfo">
+      <%= link_to "← Back to quiz", moderate_quiz_path(@quiz) %>
+    </div>
+    <div data-moderator-game-target="controlsAction">
+      <% case @state[:status] %>
+      <% when "lobby" %>
+        <button type="button" class="btn btn--light" data-action="moderator-game#start">Start</button>
+      <% when "question_open" %>
+        <button type="button" class="btn btn--pink" data-action="moderator-game#finish">Finish</button>
+      <% when "question_closed" %>
+        <% if @state[:question][:is_last] %>
+          <button type="button" class="btn btn--pink" data-action="moderator-game#endGame">End quiz</button>
+        <% else %>
+          <button type="button" class="btn btn--light" data-action="moderator-game#nextQuestion">Next</button>
+        <% end %>
+      <% end %>
+    </div>
+  </footer>
+</div>
