+require "application_system_test_case"
+
+class LiveGameEdgeCasesSystemTest < ApplicationSystemTestCase
+  setup do
+    @quiz = Quiz.create!(title: "Edge Cases Live Quiz")
+    @q1 = @quiz.questions.build(body: "First question?", active: true)
+    @q1.save_with_option_rows([
+      { body: "Alpha", correct: true },
+      { body: "Beta", correct: false }
+    ])
+  end
+
+  test "toggling active checkbox dynamically disables and enables Start a game button" do
+    authorize_moderator
+    visit moderate_quiz_path(@quiz)
+
+    assert_button "Start a game", disabled: false
+
+    within("ol.question-list > li", text: "First question?") do
+      uncheck "Active"
+    end
+    assert_text "0 of 1 question active"
+    assert_button "Start a game", disabled: true
+
+    within("ol.question-list > li", text: "First question?") do
+      check "Active"
+    end
+    assert_text "1 of 1 question active"
+    assert_button "Start a game", disabled: false
+  end
+
+  test "player reload preserves pick, moderator reload preserves stage, duplicate tabs count once, and special chars are escaped" do
+    join_url = nil
+    game_path = nil
+
+    Capybara.using_session(:mod_edge) do
+      authorize_moderator
+      visit moderate_quiz_path(@quiz)
+      click_button "Start a game"
+      game_path = current_path
+      join_url = find(".lobby__url").text.strip
+      assert_text "Players: 0"
+    end
+
+    # Player joins with HTML/special characters in name
+    tricky_name = %(<img src=x onerror="window.__xss=1"> & "Bob")
+    Capybara.using_session(:edge_player) do
+      visit join_url
+      fill_in "Your name", with: tricky_name
+      click_button "Join"
+      assert_text "Hi, #{tricky_name}!"
+      assert_nil evaluate_script("window.__xss")
+    end
+
+    Capybara.using_session(:mod_edge) do
+      assert_text "Players: 1"
+    end
+
+    # Same player opens a second tab in the same browser -> still 1 player!
+    Capybara.using_session(:edge_player) do
+      second_tab = open_new_window
+      within_window(second_tab) do
+        visit join_url
+        assert_text "Hi, #{tricky_name}!"
+      end
+    end
+
+    Capybara.using_session(:mod_edge) do
+      assert_text "Players: 1"
+      click_button "Start"
+      assert_text "Question 1 of 1"
+      assert_text "Answers: 0 / 1"
+    end
+
+    # Player picks Alpha in first tab -> second tab live-syncs "Your answer", and reload keeps "Your answer"
+    Capybara.using_session(:edge_player) do
+      assert_text "First question?"
+      click_button "Alpha"
+      assert_selector "button.play-option.is-picked", text: /Alpha.*Your answer/m
+
+      second_tab = windows.last
+      within_window(second_tab) do
+        assert_selector "button.play-option.is-picked", text: /Alpha.*Your answer/m
+        second_tab.close
+      end
+
+      # Reload first tab -> remembers player & pick, and can still change pick to Beta
+      visit join_url
+      assert_selector "button.play-option.is-picked", text: /Alpha.*Your answer/m
+      click_button "Beta"
+      assert_selector "button.play-option.is-picked", text: /Beta.*Your answer/m
+    end
+
+    # Moderator reloads big screen mid-question -> still sees Question 1 of 1, Answers: 1 / 1, and Finish works!
+    Capybara.using_session(:mod_edge) do
+      visit game_path
+      assert_text "Question 1 of 1"
+      assert_text "Answers: 1 / 1"
+      click_button "Finish"
+      assert_button "End quiz"
+
+      within("ol.stage-options > li", text: "Alpha") do
+        assert_text "Correct"
+        assert_selector ".stage-option__count", text: "0"
+      end
+      within("ol.stage-options > li", text: "Beta") do
+        assert_no_text "Correct"
+        assert_selector ".stage-option__count", text: "1"
+      end
+
+      # Reload moderator on closed question -> still sees results and End quiz works!
+      visit game_path
+      assert_button "End quiz"
+      click_button "End quiz"
+      assert_text "The quiz is over"
+    end
+
+    Capybara.using_session(:edge_player) do
+      assert_text "The quiz is over"
+    end
+  end
+end
diff --git a/test/system/live_game_test.rb b/test/system/live_game_test.rb
