+    presence: true,
+    numericality: {
+      only_integer: true,
+      greater_than_or_equal_to: 0,
+      less_than_or_equal_to: MAX_TIMER_SECONDS,
+      allow_blank: true
+    }
 
   def active_questions
     questions.active
   end
+
+  def question_timer_seconds
+    (timer_minutes.to_i * 60) + timer_seconds.to_i
+  end
+
+  def timer_enabled?
+    question_timer_seconds > 0
+  end
 end
