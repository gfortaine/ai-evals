+    # After 25 seconds, reloading moderator page shows 1:05 (not 1:30!)
+    travel_to(t0 + 25.seconds, with_usec: true) do
+      get moderate_game_path(game), headers: moderator_auth_headers
+      assert_response :success
+      assert_includes response.body, ">1:05<"
+    end
+
+    # After 85 seconds, shows 0:05
+    travel_to(t0 + 85.seconds, with_usec: true) do
+      get moderate_game_path(game), headers: moderator_auth_headers
+      assert_response :success
+      assert_includes response.body, ">0:05<"
+    end
+
+    # At 90 seconds (0:00), late answer is rejected and closes the question automatically
+    q1 = game.reload.current_question
+    right_opt = q1.game_options.find_by!(correct: true)
+    travel_to(t0 + 90.seconds, with_usec: true) do
+      post answer_play_game_path(game.code),
+           params: { game_question_id: q1.id, game_option_id: right_opt.id },
+           as: :json
+      assert_response :conflict
+      body = JSON.parse(response.body)
+      assert_equal false, body["ok"]
+      assert_equal "question_closed", body.dig("state", "status")
+      assert_equal "no_answer", body.dig("state", "outcome")
+      assert_equal 0, game.answers.count
+
+      # Moderator state reflects closed question with no timer
+      get state_moderate_game_path(game), as: :json, headers: moderator_auth_headers
+      assert_response :success
+      mod_json = JSON.parse(response.body)
+      assert_equal "question_closed", mod_json["status"]
+      assert_nil mod_json["timer"]
+    end
+  end
+
+  test "zero-timer game omits timer from moderator HTML and JSON" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    game = Game.start_for_quiz!(@quiz)
+    game.start!
+
+    get moderate_game_path(game), headers: moderator_auth_headers
