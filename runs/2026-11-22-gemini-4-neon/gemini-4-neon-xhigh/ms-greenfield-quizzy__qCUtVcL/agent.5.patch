+
+  test "question auto-finishes on server even when moderator leaves the game page" do
+    quiz = Quiz.create!(title: "Headless Auto Finish", timer_minutes: 0, timer_seconds: 2)
+    q = quiz.questions.build(body: "Is Ruby fun?", active: true)
+    q.save_with_option_rows([
+      { body: "Yes", correct: true },
+      { body: "No", correct: false }
+    ])
+
+    game_path = nil
+    join_url = nil
+
+    Capybara.using_session(:mod_away) do
+      authorize_moderator
+      visit moderate_quiz_path(quiz)
+      click_button "Start a game"
+      game_path = current_path
+      join_url = find(".lobby__url").text.strip
+    end
+
+    Capybara.using_session(:player_away) do
+      visit join_url
+      fill_in "Your name", with: "Clara"
+      click_button "Join"
+      assert_text "Hi, Clara!"
+    end
+
+    Capybara.using_session(:mod_away) do
+      assert_text "Players: 1", wait: 2
+      click_button "Start"
+      assert_text "Is Ruby fun?"
+      # Immediately navigate away so NO moderator screen is open!
+      visit "/moderate"
+      assert_text "Quizzes"
+    end
+
+    # Even with no moderator browser on the game screen, timer finishes on the server and updates player!
+    Capybara.using_session(:player_away) do
+      assert_text "No answer", wait: 5
+    end
+
+    Capybara.using_session(:mod_away) do
+      visit game_path
+      assert_button "End quiz"
+      assert_no_selector "[data-role='question-timer']"
+    end
+  end
+
+  private
+
+  def parse_mmss(text)
+    mins, secs = text.split(":").map(&:to_i)
+    (mins * 60) + secs
+  end
+end
