+      assert_text "Correct!", wait: 2
+    end
+
+    Capybara.using_session(:bob_auto) do
+      assert_text "No answer", wait: 2
+    end
+
+    # Question 2 opens with fresh 0:05 countdown, Bob answers Rails, auto-finishes to End quiz!
+    Capybara.using_session(:mod_auto) do
+      click_button "Next"
+      assert_text "Best Ruby web framework?"
+      assert_selector "[data-role='question-timer']", text: /\A0:0[45]\z/
+    end
+
+    Capybara.using_session(:bob_auto) do
+      assert_text "Best Ruby web framework?", wait: 2
+      click_button "Rails"
+      assert_selector "button.play-option.is-picked", text: /Rails.*Your answer/m
+    end
+
+    Capybara.using_session(:mod_auto) do
+      assert_button "End quiz", wait: 7
+      assert_no_selector "[data-role='question-timer']"
+      click_button "End quiz"
+      assert_text "The quiz is over"
+      assert_selector "ol.leaderboard > li", count: 2
+      click_button "Top 1"
