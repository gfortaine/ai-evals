+require "test_helper"
+
+class TimerIntegrationTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = Quiz.create!(title: "Conference Timed Talk", timer_minutes: 1, timer_seconds: 30)
+    @q1 = @quiz.questions.build(body: "Which command starts Rails?", active: true)
+    @q1.save_with_option_rows([
+      { body: "bin/rails server", correct: true },
+      { body: "bin/rails fly", correct: false }
+    ])
+    @q2 = @quiz.questions.build(body: "What is 2 + 2?", active: true)
+    @q2.save_with_option_rows([
+      { body: "3", correct: false },
+      { body: "4", correct: true }
+    ])
+  end
+
+  test "quiz settings renders and validates Timer minutes and Timer seconds" do
+    get new_moderate_quiz_path, headers: moderator_auth_headers
+    assert_response :success
+    assert_includes response.body, "Timer minutes"
+    assert_includes response.body, "Timer seconds"
+
+    get edit_moderate_quiz_path(@quiz), headers: moderator_auth_headers
+    assert_response :success
+    assert_includes response.body, 'value="1"'
+    assert_includes response.body, 'value="30"'
+
+    # Invalid negative value rejected
+    patch moderate_quiz_path(@quiz),
+          params: { quiz: { title: @quiz.title, winners_count: 3, timer_minutes: -1, timer_seconds: 30 } },
+          headers: moderator_auth_headers
+    assert_response :unprocessable_entity
+    assert_includes response.body, "Timer minutes must be greater than or equal to 0"
+    assert_equal 1, @quiz.reload.timer_minutes
+
+    # Invalid blank seconds rejected
+    patch moderate_quiz_path(@quiz),
+          params: { quiz: { title: @quiz.title, winners_count: 3, timer_minutes: 0, timer_seconds: "" } },
+          headers: moderator_auth_headers
+    assert_response :unprocessable_entity
+    assert_includes response.body, "Timer seconds can&#39;t be blank"
+    assert_equal 30, @quiz.reload.timer_seconds
+
+    # Valid update to 0m 0s disables timer
+    patch moderate_quiz_path(@quiz),
+          params: { quiz: { title: @quiz.title, winners_count: 3, timer_minutes: 0, timer_seconds: 0 } },
+          headers: moderator_auth_headers
+    assert_redirected_to moderate_quiz_path(@quiz)
+    @quiz.reload
+    assert_equal 0, @quiz.timer_minutes
+    assert_equal 0, @quiz.timer_seconds
+    assert_not @quiz.timer_enabled?
+  end
+
+  test "export format never includes timer settings and import defaults timer to 0:00" do
+    get moderate_quiz_export_path(@quiz), headers: moderator_auth_headers
+    assert_response :success
+    assert_not_includes response.body, "timer_minutes"
+    assert_not_includes response.body, "timer_seconds"
+    assert_not_includes response.body, "question_timer"
+
+    exported_json = Quiz::Exporter.new(@quiz).to_json
+    parsed = JSON.parse(exported_json)
+    assert_equal %w[questions title], parsed.keys.sort
+
+    post moderate_import_path,
+         params: { import: { json: exported_json } },
+         headers: moderator_auth_headers
+    assert_response :redirect
+
+    imported = Quiz.order(:id).last
+    assert_not_equal @quiz.id, imported.id
+    assert_equal 0, imported.timer_minutes
+    assert_equal 0, imported.timer_seconds
+  end
+
+  test "moderator big screen renders countdown, reload keeps elapsed time, player never sees timer, and expiration closes question" do
+    game = Game.start_for_quiz!(@quiz)
+
+    # Player joins
+    post join_play_game_path(game.code), params: { player: { name: "Alice" } }
+    assert_redirected_to play_game_path(game.code)
+
+    # In lobby, moderator sees no timer
+    get moderate_game_path(game), headers: moderator_auth_headers
+    assert_response :success
+    assert_not_includes response.body, 'data-role="question-timer"'
+
+    t0 = Time.zone.parse("2026-11-22 15:00:00 UTC")
+    travel_to(t0, with_usec: true) do
+      post start_moderate_game_path(game), as: :json, headers: moderator_auth_headers
+      assert_response :success
+      data = JSON.parse(response.body)
+      assert_equal "question_open", data["status"]
+      assert_equal 90, data.dig("timer", "duration_seconds")
+      assert_equal 90_000, data.dig("timer", "remaining_ms")
+
+      # Moderator HTML renders 1:30
+      get moderate_game_path(game), headers: moderator_auth_headers
+      assert_response :success
+      assert_includes response.body, 'data-role="question-timer"'
+      assert_includes response.body, ">1:30<"
+
+      # Player HTML and JSON never show or leak the timer
+      get play_game_path(game.code)
+      assert_response :success
+      assert_not_includes response.body, "question-timer"
+      assert_not_includes response.body, "1:30"
+      assert_not_includes response.body, "remaining_ms"
+
+      get state_play_game_path(game.code), as: :json
+      assert_response :success
+      player_json = JSON.parse(response.body)
+      assert_not player_json.key?("timer")
