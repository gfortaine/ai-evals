diff --git a/test/models/book/maintenance_test.rb b/test/models/book/maintenance_test.rb
new file mode 100644
index 0000000..1f88084
--- /dev/null
+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+require "rake"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "compact_positions! preserves hand-arranged ordering and compacts scores into 1..n" do
+    leaves(:reading_picture).update!(position_score: 10)
+    leaves(:summary_page).update!(position_score: 25)
+    leaves(:welcome_page).update!(position_score: 50)
+    leaves(:welcome_section).update!(position_score: 100)
+
+    expected = [
+      leaves(:reading_picture),
+      leaves(:summary_page),
+      leaves(:welcome_page),
+      leaves(:welcome_section)
+    ]
+
+    books(:handbook).compact_positions!
+
+    assert_equal expected, books(:handbook).leaves.active.positioned
+    assert_equal [ 1, 2, 3, 4 ], books(:handbook).leaves.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions! preserves a moved trashed page's position when restored" do
+    leaves(:reading_picture).move_to_position(1)
+    leaves(:reading_picture).trashed!
+
+    books(:handbook).compact_positions!
+
+    assert_equal [
+      leaves(:welcome_section),
+      leaves(:welcome_page),
+      leaves(:summary_page)
+    ], books(:handbook).leaves.active.positioned
+
+    leaves(:reading_picture).active!
+
+    assert_equal [
+      leaves(:welcome_section),
+      leaves(:reading_picture),
+      leaves(:welcome_page),
+      leaves(:summary_page)
+    ], books(:handbook).leaves.active.positioned
+  end
+
+  test "compact_positions! preserves a trashed page's position when gaps precede it" do
+    leaves(:welcome_section).update!(position_score: 10)
+    leaves(:welcome_page).update!(position_score: 20, status: :trashed)
+    leaves(:summary_page).update!(position_score: 30)
+    leaves(:reading_picture).update!(position_score: 40)
+
+    books(:handbook).compact_positions!
+
+    leaves(:welcome_page).active!
+
+    assert_equal [
+      leaves(:welcome_section),
+      leaves(:welcome_page),
+      leaves(:summary_page),
+      leaves(:reading_picture)
+    ], books(:handbook).leaves.active.positioned
+    assert_equal [ 1, 2, 3, 4 ], books(:handbook).leaves.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions! preserves tie-breaking by id and handles negative and fractional scores" do
+    leaves(:reading_picture).update!(position_score: -5.5)
+    leaves(:welcome_page).update!(position_score: 0.25)
+    leaves(:summary_page).update!(position_score: 0.25)
+    leaves(:welcome_section).update!(position_score: 100.75)
+
+    expected = books(:handbook).leaves.positioned.to_a
+
+    books(:handbook).compact_positions!
+
+    assert_equal expected, books(:handbook).leaves.positioned.to_a
+    assert_equal [ 1, 2, 3, 4 ], books(:handbook).leaves.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions! only affects the target book and handles empty books" do
+    assert_nothing_raised { books(:manual).compact_positions! }
+
+    manual_leaf = books(:manual).press Page.new(body: "Manual intro"), title: "Intro"
+    manual_leaf.update!(position_score: 42)
+
+    leaves(:welcome_section).update!(position_score: 99)
+    books(:handbook).compact_positions!
+
+    assert_equal 42, manual_leaf.reload.position_score
+    assert_equal [ 1, 2, 3, 4 ], books(:handbook).leaves.positioned.pluck(:position_score)
+  end
+
+  test "live_leaf_count returns count of non-trashed leaves" do
+    assert_equal 4, books(:handbook).live_leaf_count
+    assert_equal 0, books(:manual).live_leaf_count
+
+    leaves(:welcome_page).trashed!
+    leaves(:summary_page).trashed!
+
+    assert_equal 2, books(:handbook).live_leaf_count
+
+    leaves(:welcome_page).active!
+
+    assert_equal 3, books(:handbook).live_leaf_count
+  end
+
+  test "sqlite3 strict strings rejects double-quoted unknown columns" do
+    assert ActiveRecord::ConnectionAdapters::SQLite3Adapter.strict_strings_by_default
+
+    assert_raises ActiveRecord::StatementInvalid do
+      Book.connection.select_value('SELECT "position_socre" FROM leaves LIMIT 1')
+    end
+  end
+
+  test "maintenance:compact_positions rake task compacts all books" do
+    Rails.application.load_tasks unless Rake::Task.task_defined?("maintenance:compact_positions")
+
+    leaves(:reading_picture).update!(position_score: 5)
+    leaves(:welcome_section).update!(position_score: 50)
+    manual_leaf = books(:manual).press Page.new(body: "Manual intro"), title: "Intro"
+    manual_leaf.update!(position_score: 77)
+
+    expected_handbook = books(:handbook).leaves.positioned.to_a
+
+    Rake::Task["maintenance:compact_positions"].execute
+
+    assert_equal expected_handbook, books(:handbook).leaves.positioned.to_a
+    assert_equal [ 1, 2, 3, 4 ], books(:handbook).leaves.positioned.pluck(:position_score)
+    assert_equal [ 1 ], books(:manual).leaves.positioned.pluck(:position_score)
+  end
+end
