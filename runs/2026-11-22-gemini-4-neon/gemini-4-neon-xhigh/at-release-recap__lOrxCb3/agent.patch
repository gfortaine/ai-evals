diff --git a/test/controllers/books/releases_controller_test.rb b/test/controllers/books/releases_controller_test.rb
new file mode 100644
index 0000000..3267b59
--- /dev/null
+++ b/test/controllers/books/releases_controller_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    @book = books(:manual)
+    sign_in :david
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "edit renders the release form" do
+    get edit_book_release_path(@book)
+
+    assert_response :success
+    assert_in_body "Release this book"
+  end
+
+  test "releasing a book shows the new title as published in Recently updated" do
+    patch book_release_path(@book), params: { book: { title: "The Final Manual", subtitle: "Edition 1" } }
+
+    assert_redirected_to root_path
+    follow_redirect!
+    assert_response :success
+
+    assert_select ".library__recents" do
+      assert_select "strong", text: "The Final Manual"
+      assert_select "span", text: "Published"
+      assert_select "strong", text: "Manual", count: 0
+    end
+
+    get book_slug_path(@book.reload)
+    assert_response :success
+    assert_in_body "The Final Manual"
+  end
+
+  test "releasing an already published book redirects back to the book without changing it" do
+    @book.update!(title: "Already Out", published: true)
+
+    patch book_release_path(@book), params: { book: { title: "Attempted Rename" } }
+
+    assert_redirected_to book_slug_path(@book)
+    assert_equal "Already Out", @book.reload.title
+    assert_equal({ title: "Already Out", published: true }, @book.cached_recap)
+  end
+
+  test "ordinary rename keeps Recently updated in sync alongside a released book" do
+    patch book_release_path(@book), params: { book: { title: "The Final Manual" } }
+    patch book_path(books(:handbook)), params: { book: { title: "Updated Handbook" } }
+
+    get root_path
+    assert_response :success
+
+    assert_select ".library__recents" do
+      assert_select "strong", text: "The Final Manual"
+      assert_select "strong", text: "Updated Handbook"
+    end
+  end
+
+  test "non-editor cannot release a book" do
+    sign_in :jz
+
+    get edit_book_release_path(@book)
+    assert_response :forbidden
+
+    patch book_release_path(@book), params: { book: { title: "Unauthorized Release" } }
+    assert_response :forbidden
+    assert_not @book.reload.published?
+  end
+end
diff --git a/test/models/book/recap_test.rb b/test/models/book/recap_test.rb
new file mode 100644
index 0000000..0361d1a
--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "unupdated book has no cached recap" do
+    assert_nil books(:manual).cached_recap
+  end
+
+  test "ordinary update writes current title and published state to recap" do
+    book = books(:manual)
+    book.update!(title: "Renamed Manual")
+
+    assert_equal({ title: "Renamed Manual", published: false }, book.cached_recap)
+  end
+
+  test "recap stays per book so saving one never overwrites another's" do
+    manual = books(:manual)
+    handbook = books(:handbook)
+
+    manual.update!(title: "Updated Manual")
+    handbook.update!(title: "Updated Handbook", published: true)
+
+    assert_equal({ title: "Updated Manual", published: false }, manual.cached_recap)
+    assert_equal({ title: "Updated Handbook", published: true }, handbook.cached_recap)
+    assert_not_equal manual.recap_cache_key, handbook.recap_cache_key
+  end
+
+  test "recaps expire on the configured schedule" do
+    book = books(:manual)
+    original_expires_in = Rails.application.config.x.recap.expires_in
+
+    book.update!(title: "Expiring Manual")
+    assert_equal({ title: "Expiring Manual", published: false }, book.cached_recap)
+
+    travel original_expires_in - 1.minute do
+      assert_equal({ title: "Expiring Manual", published: false }, book.cached_recap)
+    end
+
+    travel original_expires_in + 1.minute do
+      assert_nil book.cached_recap
+    end
+
+    begin
+      Rails.application.config.x.recap.expires_in = 10.minutes
+      book.update!(title: "Short Lived Manual")
+
+      travel 9.minutes do
+        assert_equal({ title: "Short Lived Manual", published: false }, book.cached_recap)
+      end
+
+      travel 11.minutes do
+        assert_nil book.cached_recap
+      end
+    ensure
+      Rails.application.config.x.recap.expires_in = original_expires_in
+    end
+  end
+
+  test "two instances of the same book updated in one transaction write committed values to recap" do
+    first = Book.find(books(:manual).id)
+    second = Book.find(books(:manual).id)
+
+    Book.transaction do
+      first.update!(title: "Final Manual")
+      second.update!(published: true)
+    end
+
+    assert_equal({ title: "Final Manual", published: true }, first.cached_recap)
+  end
+
+  test "updating title and publishing via ReleaseMarker writes committed values to recap" do
+    book = Book.find(books(:manual).id)
+    marker = ReleaseMarker.for(book.id)
+
+    Book.transaction do
+      book.update!(title: "Released via Marker")
+      marker.publish!
+    end
+
+    assert_equal({ title: "Released via Marker", published: true }, book.cached_recap)
+  end
+end
diff --git a/test/models/book/release_test.rb b/test/models/book/release_test.rb
new file mode 100644
index 0000000..6461a79
--- /dev/null
+++ b/test/models/book/release_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Book::ReleaseTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "finalize_release publishes the book with the new title and caches the right recap" do
+    book = books(:manual)
+
+    assert Book.finalize_release(book.id, title: "Published Manual", subtitle: "First Edition")
+
+    book.reload
+    assert_equal "Published Manual", book.title
+    assert_equal "First Edition", book.subtitle
+    assert book.published?
+    assert_equal({ title: "Published Manual", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release preserves existing subtitle when subtitle is omitted" do
+    book = books(:manual)
+    book.update!(subtitle: "Original Subtitle")
+
+    assert Book.finalize_release(book.id, title: "Published Manual")
+
+    book.reload
+    assert_equal "Published Manual", book.title
+    assert_equal "Original Subtitle", book.subtitle
+    assert book.published?
+    assert_equal({ title: "Published Manual", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release returns false and leaves already-published book untouched" do
+    book = books(:manual)
+    book.update!(title: "Already Published", published: true)
+
+    assert_not Book.finalize_release(book.id, title: "Overwritten Title", subtitle: "Nope")
+
+    book.reload
+    assert_equal "Already Published", book.title
+    assert_equal({ title: "Already Published", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release raises RecordNotFound for nonexistent book" do
+    assert_raises(ActiveRecord::RecordNotFound) do
+      Book.finalize_release(-1, title: "Ghost")
+    end
+  end
+
+  test "finalize_release does not overwrite another book's recap" do
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    handbook.update!(title: "Handbook Draft")
+    assert Book.finalize_release(manual.id, title: "Published Manual")
+
+    assert_equal({ title: "Handbook Draft", published: false }, handbook.cached_recap)
+    assert_equal({ title: "Published Manual", published: true }, manual.cached_recap)
+  end
+
+  test "finalize_release recap expires on the configured schedule" do
+    book = books(:manual)
+    assert Book.finalize_release(book.id, title: "Published Manual")
+    assert_equal({ title: "Published Manual", published: true }, book.cached_recap)
+
+    travel Rails.application.config.x.recap.expires_in + 1.minute do
+      assert_nil book.cached_recap
+    end
+  end
+end
