@@ -16,8 +16,19 @@ module Writebook
     # Common ones are `templates`, `generators`, or `middleware`, for example.
     config.autoload_lib(ignore: %w[rails_ext assets tasks])
 
-    # Raised on noisy runs from the runbook; "debug" is what Rails would pick anyway.
-    config.log_level = ENV.fetch("LOG_LEVEL", "debug")
+    # Raised on noisy runs from the runbook. Only assign when explicitly set so
+    # Rails leaves per-sink BroadcastLogger levels intact by default.
+    config.log_level = ENV["LOG_LEVEL"] if ENV["LOG_LEVEL"].present?
+
+    runner do
+      unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDERR, STDOUT, $stdout)
+        console = ActiveSupport::Logger.new($stdout)
+        console.formatter = Rails.logger.formatter if Rails.logger.formatter
+        console.level = ENV["LOG_LEVEL"].present? ? Rails.logger.level : [ Rails.logger.level, ActiveSupport::Logger::INFO ].max
+        Rails.logger = ActiveSupport::BroadcastLogger.new(Rails.logger) unless Rails.logger.is_a?(ActiveSupport::BroadcastLogger)
+        Rails.logger.broadcast_to(console)
+      end
+    end
 
