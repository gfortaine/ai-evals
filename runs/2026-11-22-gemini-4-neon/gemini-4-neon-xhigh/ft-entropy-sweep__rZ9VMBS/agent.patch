diff --git a/test/jobs/card/auto_postpone_all_due_job_test.rb b/test/jobs/card/auto_postpone_all_due_job_test.rb
new file mode 100644
index 0000000..4a5d35c
--- /dev/null
+++ b/test/jobs/card/auto_postpone_all_due_job_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class Card::AutoPostponeAllDueJobTest < ActiveJob::TestCase
+  test "postpones all due cards across accounts without an active account context" do
+    cards(:logo).update!(last_active_at: entropies(:writebook_board).auto_postpone_period.seconds.ago - 2.days)
+    cards(:radio).update!(last_active_at: entropies(:miltons_wish_list_board).auto_postpone_period.seconds.ago - 2.days)
+
+    Current.reset
+
+    assert_difference -> { Card.postponed.count }, +2 do
+      Card::AutoPostponeAllDueJob.perform_now
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert_equal accounts("37s").system_user, cards(:logo).postponed_by
+    assert cards(:radio).reload.postponed?
+    assert_equal accounts(:initech).system_user, cards(:radio).postponed_by
+  end
+
+  test "limits concurrency to prevent overlapping runs" do
+    assert_equal 1, Card::AutoPostponeAllDueJob.concurrency_limit
+    assert_equal :discard, Card::AutoPostponeAllDueJob.concurrency_on_conflict
+    assert_equal "Card::AutoPostponeAllDueJob/auto_postpone_all_due", Card::AutoPostponeAllDueJob.new.concurrency_key
+  end
+end
