+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create saves a push subscription for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: "https://fcm.googleapis.com/fcm/send/device-token",
+            p256dh_key: "BEl62iUYgUivxIkv69yViEuiBIa",
+            auth_key: "tBHItJI5svbpez7KI4CCXg"
+          }
+        },
+        headers: { "User-Agent" => "Mozilla/5.0 TestBrowser" }
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://fcm.googleapis.com/fcm/send/device-token", subscription.endpoint
+    assert_equal "BEl62iUYgUivxIkv69yViEuiBIa", subscription.p256dh_key
+    assert_equal "tBHItJI5svbpez7KI4CCXg", subscription.auth_key
+    assert_equal "Mozilla/5.0 TestBrowser", subscription.user_agent
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create accepts JSON payload" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: "https://web.push.apple.com/Q12345",
+            p256dh_key: "p256dh-key-value",
+            auth_key: "auth-key-value"
+          }
+        },
+        as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create is idempotent for the same endpoint and touches updated_at" do
+    existing = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/existing",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key",
+      updated_at: 2.days.ago
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: existing.endpoint,
+            p256dh_key: existing.p256dh_key,
+            auth_key: existing.auth_key
+          }
+        }
+    end
+
+    assert_response :ok
+    assert existing.reload.updated_at > 1.minute.ago
+  end
+
+  test "create updates rotated keys for an existing endpoint without duplicating" do
+    existing = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/existing",
+      p256dh_key: "old-p256dh",
+      auth_key: "old-auth"
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: existing.endpoint,
+            p256dh_key: "new-p256dh",
+            auth_key: "new-auth"
+          }
+        }
+    end
+
+    assert_response :ok
+    existing.reload
+    assert_equal "new-p256dh", existing.p256dh_key
+    assert_equal "new-auth", existing.auth_key
+  end
+
+  test "create rejects invalid endpoint or missing keys" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: "http://127.0.0.1/push",
+            p256dh_key: "key",
+            auth_key: "auth"
+          }
+        }
+    end
+
+    assert_response :unprocessable_entity
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: "https://fcm.googleapis.com/fcm/send/abc",
+            p256dh_key: "",
+            auth_key: ""
+          }
+        }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create is forbidden for another user" do
+    other_user = users(:kevin)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(other_user),
+        params: {
+          push_subscription: {
+            endpoint: "https://fcm.googleapis.com/fcm/send/abc",
+            p256dh_key: "key",
+            auth_key: "auth"
+          }
+        }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create allows the same endpoint for users in different accounts" do
+    endpoint = "https://fcm.googleapis.com/fcm/send/shared-browser"
+
+    post user_push_subscriptions_path(@user),
+      params: { push_subscription: { endpoint: endpoint, p256dh_key: "key1", auth_key: "auth1" } }
+    assert_response :created
+
+    other_account = accounts(:initech)
+    other_user = other_account.users.create!(identity: @user.identity, name: @user.name, verified_at: Time.current)
+
+    assert_difference -> { other_user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(other_user, script_name: other_account.slug),
+        params: { push_subscription: { endpoint: endpoint, p256dh_key: "key1", auth_key: "auth1" } }
+    end
+
+    assert_response :created
+  end
+
+  test "destroy removes the user's push subscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/to-delete",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription)
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy is forbidden for another user" do
+    other_user = users(:kevin)
+    subscription = other_user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/other",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    assert_no_difference -> { Push::Subscription.count } do
+      delete user_push_subscription_path(other_user, subscription)
+    end
+
+    assert_response :forbidden
+  end
+end
