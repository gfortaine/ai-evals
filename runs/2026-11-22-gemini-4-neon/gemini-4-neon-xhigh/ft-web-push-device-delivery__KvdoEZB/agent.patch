@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Notification::MessageTest < ActiveSupport::TestCase
+  include NotificationsHelper
+
+  test "event notifications match tray title and body" do
+    notifications_to_check = [
+      [ notifications(:logo_assignment_kevin), "The logo isn't big enough", "Assigned to Kevin" ],
+      [ notifications(:layout_commented_kevin), "RE: Layout is broken", comments(:layout_overflowing_david).body.to_plain_text.truncate(200) ],
+      [ notifications(:buy_domain_sent_back_to_triage_kevin), "Buy domain", "Moved back to Maybe? by David" ]
+    ]
+
+    notifications_to_check.each do |notification, expected_title, expected_body|
+      message = Notification::Message.new(notification)
+      assert_equal expected_title, message.title
+      assert_equal expected_body, message.body
+      assert_equal event_notification_title(notification.source), message.title
+      assert_equal event_notification_body(notification.source), message.body
+    end
+  end
+
+  test "all card event actions produce exact tray body text" do
+    card = cards(:logo)
+    david = users(:david)
+    board = boards(:writebook)
+
+    cases = {
+      "card_published" => "Added by David",
+      "card_unassigned" => "Unassigned by David",
+      "card_closed" => "Moved to Done by David",
+      "card_reopened" => "Reopened by David",
+      "card_postponed" => "Moved to Not Now by David",
+      "card_auto_postponed" => "Moved to Not Now due to inactivity",
+      "card_title_changed" => "Renamed by David",
+      "card_board_changed" => "Moved by David",
+      "card_sent_back_to_triage" => "Moved back to Maybe? by David"
+    }
+
+    cases.each do |action, expected_body|
+      event = Event.new(board: board, creator: david, eventable: card, action: action)
+      notification = Notification.new(user: users(:kevin), creator: david, source: event, card: card)
+      message = Notification::Message.new(notification)
+
+      assert_equal card.title, message.title
+      assert_equal expected_body, message.body
+    end
+
+    triaged_event = Event.new(board: board, creator: david, eventable: card, action: "card_triaged", particulars: { "particulars" => { "column" => "Triage" } })
+    triaged_notification = Notification.new(user: users(:kevin), creator: david, source: triaged_event, card: card)
+    assert_equal "Moved to Triage by David", Notification::Message.new(triaged_notification).body
+  end
+
+  test "mention notifications match tray title and body" do
+    mention_notification = notifications(:logo_mentioned_david)
+    message = Notification::Message.new(mention_notification)
+
+    assert_equal "JZ @mentioned you", message.title
+    assert_equal mention_notification.source.source.mentionable_content.truncate(200), message.body
+  end
+
+  test "untitled card falls back to card number" do
+    card = cards(:logo)
+    card.update_column(:title, nil)
+    notification = notifications(:logo_assignment_kevin)
+    message = Notification::Message.new(notification)
+
+    assert_equal "Card #{card.number}", message.title
+  end
+end
