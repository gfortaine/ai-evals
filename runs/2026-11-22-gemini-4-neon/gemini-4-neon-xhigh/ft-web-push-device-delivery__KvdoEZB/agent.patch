+    payload = decrypt_payload(captured_body)
+    comment = comments(:layout_overflowing_david)
+
+    assert_equal "RE: Layout is broken", payload["title"]
+    assert_equal comment.body.to_plain_text.truncate(200), payload.dig("options", "body")
+    assert_equal "/app-icon-192.png", payload.dig("options", "icon")
+    assert_equal "#{@kevin.account.slug}/cards/#{comment.card.number}#comment_#{comment.id}", payload.dig("options", "data", "path")
+    assert_equal @kevin.notifications.unread.count, payload.dig("options", "data", "badge")
+  end
+
+  test "mention notification pushes mention title, body, and opens the card" do
+    notifications(:logo_mentioned_david).destroy
+    subscription = create_subscription_for(@david, endpoint: "https://push.example.com/david-desktop")
+    captured_body = nil
+
+    request_stub = stub_request(:post, subscription.endpoint)
+      .with(ipaddr: PUBLIC_PUSH_IP)
+      .with { |request| captured_body = request.body; true }
+      .to_return(status: 201)
+
+    mention = mentions(:logo_card_david_mention_by_jz)
+
+    with_vapid_keys do
+      perform_enqueued_jobs do
+        Notifier.for(mention).notify
+      end
+    end
+
+    assert_requested request_stub
+    payload = decrypt_payload(captured_body)
+
+    assert_equal "JZ @mentioned you", payload["title"]
+    assert_equal mention.source.mentionable_content.truncate(200), payload.dig("options", "body")
+    assert_equal "#{@david.account.slug}/cards/#{mention.card.number}", payload.dig("options", "data", "path")
+  end
+
+  test "updating an existing notification for the same card also pushes" do
+    # Kevin already has a read notification on the layout card; a new comment updates it
+    existing = notifications(:layout_commented_kevin)
+    existing.read
+
+    subscription = create_subscription_for(@kevin, endpoint: "https://push.example.com/kevin-phone")
+    captured_body = nil
+
+    request_stub = stub_request(:post, subscription.endpoint)
+      .with(ipaddr: PUBLIC_PUSH_IP)
+      .with { |request| captured_body = request.body; true }
+      .to_return(status: 201)
+
+    new_comment = cards(:layout).comments.create!(body: "A brand new follow-up comment", creator: @david)
+    new_event = boards(:writebook).events.create!(action: "comment_created", creator: @david, eventable: new_comment)
+
+    with_vapid_keys do
+      perform_enqueued_jobs do
+        Notifier.for(new_event).notify
+      end
+    end
+
+    assert_requested request_stub
+    payload = decrypt_payload(captured_body)
+
+    assert_equal "RE: Layout is broken", payload["title"]
+    assert_equal "A brand new follow-up comment", payload.dig("options", "body")
+    assert_equal "#{@kevin.account.slug}/cards/#{cards(:layout).number}#comment_#{new_comment.id}", payload.dig("options", "data", "path")
+  end
+
+  test "marking a notification as read or unread does not push" do
+    notification = notifications(:logo_assignment_kevin)
+    subscription = create_subscription_for(@kevin, endpoint: "https://push.example.com/kevin-phone")
+    request_stub = stub_request(:post, subscription.endpoint).to_return(status: 201)
+
+    with_vapid_keys do
+      perform_enqueued_jobs do
+        notification.read
+        notification.unread
+      end
+    end
+
+    assert_not_requested request_stub
+  end
+
+  test "delivers to all of a user's devices even if one subscription is expired" do
+    notifications(:layout_commented_kevin).destroy
+    expired_sub = create_subscription_for(@kevin, endpoint: "https://push.example.com/old-phone")
+    active_sub = create_subscription_for(@kevin, endpoint: "https://push.example.com/new-desktop")
+
+    expired_stub = stub_request(:post, expired_sub.endpoint).with(ipaddr: PUBLIC_PUSH_IP).to_return(status: 410)
+    active_stub = stub_request(:post, active_sub.endpoint).with(ipaddr: PUBLIC_PUSH_IP).to_return(status: 201)
+
+    with_vapid_keys do
+      perform_enqueued_jobs do
+        Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+      end
+    end
+
+    assert_requested expired_stub
+    assert_requested active_stub
+    assert_not Push::Subscription.exists?(expired_sub.id)
+    assert Push::Subscription.exists?(active_sub.id)
+  end
+
+  test "skips push if notification was read before the job ran" do
+    notifications(:layout_commented_kevin).destroy
+    subscription = create_subscription_for(@kevin, endpoint: "https://push.example.com/kevin-phone")
+    request_stub = stub_request(:post, subscription.endpoint).to_return(status: 201)
+
+    notification = Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    notification.read
+
+    with_vapid_keys do
+      perform_enqueued_jobs
+    end
+
+    assert_not_requested request_stub
+  end
+
+  test "skips push if user lost access to the board before the job ran" do
+    notifications(:layout_commented_kevin).destroy
+    subscription = create_subscription_for(@kevin, endpoint: "https://push.example.com/kevin-phone")
+    request_stub = stub_request(:post, subscription.endpoint).to_return(status: 201)
+
+    notification = Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.where(user: @kevin).delete_all
+
+    with_vapid_keys do
+      perform_enqueued_jobs
+    end
+
+    assert_not_requested request_stub
+  end
+
+  test "deactivating a user destroys their push subscriptions" do
+    subscription = create_subscription_for(@kevin, endpoint: "https://push.example.com/kevin-phone")
+
+    @kevin.deactivate
+
+    assert_not Push::Subscription.exists?(subscription.id)
+  end
+
+  private
+    def create_subscription_for(user, endpoint:)
+      user.push_subscriptions.create!(
+        endpoint: endpoint,
+        p256dh_key: @keys[:p256dh_key],
+        auth_key: @keys[:auth_key]
+      )
+    end
+
+    def decrypt_payload(body)
+      JSON.parse(decrypt_web_push_payload(body, client_ec: @keys[:client_ec], auth_key: @keys[:auth_key]))
+    end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..7f1a91d
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,169 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @keys = generate_push_subscription_keys
+    stub_dns_resolution(PUBLIC_PUSH_IP)
+  end
+
+  test "validates required attributes" do
+    subscription = Push::Subscription.new(user: @user)
+
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "can't be blank"
+    assert_includes subscription.errors[:p256dh_key], "can't be blank"
+    assert_includes subscription.errors[:auth_key], "can't be blank"
+  end
+
+  test "validates endpoint must be a valid HTTPS URL" do
+    invalid_endpoints = [
+      "not a url",
+      "http://fcm.googleapis.com/fcm/send/abc",
+      "ftp://example.com/push",
+      "javascript:alert(1)",
+      "https://",
+      "//example.com/push"
+    ]
+
+    invalid_endpoints.each do |endpoint|
+      subscription = build_subscription(endpoint: endpoint)
+      assert_not subscription.valid?, "Expected #{endpoint.inspect} to be invalid"
+      assert_includes subscription.errors[:endpoint], "must be a valid HTTPS URL"
+    end
+  end
+
+  test "rejects private and local addresses in endpoint" do
+    blocked_endpoints = [
+      "https://localhost/push",
+      "https://sub.localhost/push",
+      "https://127.0.0.1/push",
+      "https://10.0.0.1/push",
+      "https://169.254.169.254/latest/meta-data",
+      "https://192.168.1.1/push",
+      "https://[::1]/push",
+      "https://[::ffff:127.0.0.1]/push"
+    ]
+
+    blocked_endpoints.each do |endpoint|
+      subscription = build_subscription(endpoint: endpoint)
+      assert_not subscription.valid?, "Expected #{endpoint.inspect} to be blocked"
+      assert_includes subscription.errors[:endpoint], "must not point to a private or local address"
+    end
+  end
+
+  test "normalizes whitespace around endpoint" do
+    subscription = build_subscription(endpoint: "  https://example.com/push  ")
+    assert subscription.valid?
+    assert_equal "https://example.com/push", subscription.endpoint
+  end
+
+  test "delivers encrypted web push pinned to resolved public IP with VAPID authorization" do
+    subscription = create_subscription(endpoint: "https://example.com/push")
+    captured_request = nil
+
+    request_stub = stub_request(:post, "https://example.com/push")
+      .with(ipaddr: PUBLIC_PUSH_IP)
+      .with { |request| captured_request = request; true }
+      .to_return(status: 201)
+
+    with_vapid_keys do |vapid_key|
+      subscription.notification(
+        title: "The logo isn't big enough",
+        options: { body: "Added by David", icon: "/app-icon-192.png", data: { path: "/897362094/cards/1", badge: 2 } }
+      )
+
+      assert_requested request_stub
+      assert_equal "aes128gcm", captured_request.headers["Content-Encoding"]
+      assert_equal "application/octet-stream", captured_request.headers["Content-Type"]
+
+      auth_header = captured_request.headers["Authorization"]
+      assert_match(/\Avapid t=([^,]+),k=(.+)\z/, auth_header)
+      token, key_param = auth_header.match(/\Avapid t=([^,]+),k=(.+)\z/).captures
+      assert_equal vapid_key.public_key_for_push_header, key_param
+
+      decoded_jwt, = JWT.decode(token, vapid_key.curve, true, algorithm: "ES256")
+      assert_equal "https://example.com", decoded_jwt["aud"]
+      assert_match(/\Amailto:/, decoded_jwt["sub"])
+
+      decrypted = JSON.parse(decrypt_web_push_payload(captured_request.body, client_ec: @keys[:client_ec], auth_key: @keys[:auth_key]))
+      assert_equal "The logo isn't big enough", decrypted["title"]
+      assert_equal "Added by David", decrypted.dig("options", "body")
+      assert_equal "/897362094/cards/1", decrypted.dig("options", "data", "path")
+      assert_equal 2, decrypted.dig("options", "data", "badge")
+    end
+  end
+
+  test "blocks DNS rebinding to private IP during delivery" do
+    subscription = create_subscription(endpoint: "https://rebind.attacker.example/push")
+    stub_dns_resolution("169.254.169.254")
+    request_stub = stub_request(:post, "https://rebind.attacker.example/push").to_return(status: 201)
+
+    with_vapid_keys do
+      subscription.notification(title: "Secret", options: { body: "Internal" })
+    end
+
+    assert_not_requested request_stub
+    assert Push::Subscription.exists?(subscription.id)
+  end
+
+  test "destroys subscription when push service responds with 410 Gone" do
+    subscription = create_subscription(endpoint: "https://example.com/push/expired")
+    stub_request(:post, subscription.endpoint).with(ipaddr: PUBLIC_PUSH_IP).to_return(status: 410)
+
+    with_vapid_keys do
+      assert_difference -> { Push::Subscription.count }, -1 do
+        subscription.notification(title: "Test", options: { body: "Hello" })
+      end
+    end
+  end
+
+  test "destroys subscription when push service responds with 404 Not Found" do
+    subscription = create_subscription(endpoint: "https://example.com/push/missing")
+    stub_request(:post, subscription.endpoint).with(ipaddr: PUBLIC_PUSH_IP).to_return(status: 404)
+
+    with_vapid_keys do
+      assert_difference -> { Push::Subscription.count }, -1 do
+        subscription.notification(title: "Test", options: { body: "Hello" })
+      end
+    end
+  end
+
+  test "keeps subscription on transient 503 or 429 or 401 errors" do
+    [ 401, 429, 503 ].each do |status|
+      subscription = create_subscription(endpoint: "https://example.com/push/status-#{status}")
+      stub_request(:post, subscription.endpoint).with(ipaddr: PUBLIC_PUSH_IP).to_return(status: status)
+
+      with_vapid_keys do
+        assert_no_difference -> { Push::Subscription.count } do
+          subscription.notification(title: "Test", options: { body: "Hello" })
+        end
+      end
+    end
+  end
+
+  test "does not send push when VAPID keys are not configured" do
+    subscription = create_subscription(endpoint: "https://example.com/push")
+    request_stub = stub_request(:post, subscription.endpoint).to_return(status: 201)
+
+    without_vapid_keys do
+      subscription.notification(title: "Test", options: { body: "Hello" })
+    end
+
+    assert_not_requested request_stub
+  end
+
+  private
+    def build_subscription(endpoint: "https://example.com/push")
+      Push::Subscription.new(
+        user: @user,
+        endpoint: endpoint,
+        p256dh_key: @keys[:p256dh_key],
+        auth_key: @keys[:auth_key]
+      )
+    end
+
+    def create_subscription(endpoint: "https://example.com/push")
+      build_subscription(endpoint: endpoint).tap(&:save!)
+    end
+end
diff --git a/test/system/push_notifications_test.rb b/test/system/push_notifications_test.rb
new file mode 100644
index 0000000..50da4d0
--- /dev/null
+++ b/test/system/push_notifications_test.rb
@@ -0,0 +1,190 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:david)
+    sign_in_as(@user)
+  end
+
+  test "turning on push notifications subscribes and posts push_subscription params" do
+    keys = generate_push_subscription_keys
+
+    with_vapid_keys do |vapid_key|
+      visit notifications_settings_url
+
+      assert_selector "button", text: "Turn on notifications"
+      assert_no_selector ".notifications--on"
+
+      page.execute_script(<<~JS, keys[:p256dh_key], keys[:auth_key])
+        const [p256dh, auth] = arguments
+        let currentSubscription = null
+        window.__subscribedApplicationServerKey = null
+
+        window.Notification = {
+          permission: "default",
+          async requestPermission() {
+            this.permission = "granted"
+            return "granted"
+          }
+        }
+        window.PushManager = function() {}
+
+        const registration = {
+          pushManager: {
+            async getSubscription() {
+              return currentSubscription
+            },
+            async subscribe(options) {
+              window.__subscribedApplicationServerKey = Array.from(new Uint8Array(options.applicationServerKey))
+              currentSubscription = {
+                endpoint: "https://fcm.googleapis.com/fcm/send/system-test-device",
+                options: { applicationServerKey: options.applicationServerKey },
+                toJSON() {
+                  return {
+                    endpoint: this.endpoint,
+                    keys: { p256dh, auth }
+                  }
+                }
+              }
+              return currentSubscription
+            }
+          }
+        }
+
+        Object.defineProperty(navigator, "serviceWorker", {
+          configurable: true,
+          value: {
+            async getRegistration() { return registration },
+            async register() { return registration },
+            ready: Promise.resolve(registration)
+          }
+        })
+      JS
+
+      click_button "Turn on notifications"
+
+      assert_selector ".notifications--on"
+      assert_text "Notifications are on for this device."
+
+      subscription = @user.push_subscriptions.reload.last
+      assert_not_nil subscription
+      assert_equal "https://fcm.googleapis.com/fcm/send/system-test-device", subscription.endpoint
+      assert_equal keys[:p256dh_key], subscription.p256dh_key
+      assert_equal keys[:auth_key], subscription.auth_key
+
+      expected_key_bytes = Base64.urlsafe_decode64(vapid_key.public_key).bytes
+      actual_key_bytes = page.evaluate_script("window.__subscribedApplicationServerKey")
+      assert_equal expected_key_bytes, actual_key_bytes
+    end
+  end
+
+  test "blocked browser permission displays browser help copy" do
+    with_vapid_keys do
+      visit notifications_settings_url
+
+      assert_selector "button", text: "Turn on notifications"
+      assert_no_text "Notifications are blocked."
+
+      click_button "Turn on notifications"
+
+      assert_text "Notifications are blocked."
+      assert_selector ".notifications-help[data-notifications-target='details']", visible: true
+      assert_no_selector ".notifications--on"
+    end
+  end
+
+  test "service worker displays push notifications and opens the card on click" do
+    visit notifications_settings_url
+
+    result = page.evaluate_async_script(<<~JS)
+      const done = arguments[arguments.length - 1]
+      ;(async () => {
+        const response = await fetch("/service-worker.js")
+        const swSource = await response.text()
+        const origin = window.location.origin
+
+        const harness = `
+          const __listeners = {}
+          const __shown = []
+          const __openedUrls = []
+          let __closed = false
+          let __badged = null
+
+          self.importScripts = () => {}
+          self.TurboOffline = {
+            addRule() {},
+            start() {},
+            handlers: { networkFirst() { return {} }, cacheFirst() { return {} } }
+          }
+          Object.defineProperty(self, "location", { value: { origin: ${JSON.stringify(origin)} } })
+          Object.defineProperty(self, "navigator", {
+            value: { async setAppBadge(count) { __badged = count } }
+          })
+          self.registration = {
+            async showNotification(title, options) { __shown.push({ title, options }) }
+          }
+          self.clients = {
+            claim() { return Promise.resolve() },
+            async matchAll() { return [] },
+            async openWindow(url) { __openedUrls.push(url) }
+          }
+          self.addEventListener = (name, handler) => { __listeners[name] = handler }
+
+          ${swSource}
+
+          ;(async () => {
+            const waitPromises = []
+            const pushPayload = {
+              title: "RE: Layout is broken",
+              options: {
+                body: "The text is overflowing the container.",
+                icon: "/app-icon-192.png",
+                data: { path: "/897362094/cards/2#comment_abc", badge: 3 }
+              }
+            }
+
+            __listeners.push({
+              data: { json() { return pushPayload } },
+              waitUntil(p) { waitPromises.push(p) }
+            })
+            await Promise.all(waitPromises)
+
+            const clickPromises = []
+            __listeners.notificationclick({
+              notification: {
+                data: pushPayload.options.data,
+                close() { __closed = true }
+              },
+              waitUntil(p) { clickPromises.push(p) }
+            })
+            await Promise.all(clickPromises)
+
+            self.postMessage({ shown: __shown, badged: __badged, closed: __closed, openedUrls: __openedUrls, origin: ${JSON.stringify(origin)} })
+          })().catch((err) => self.postMessage({ error: err.message }))
+        `
+
+        const blob = new Blob([harness], { type: "application/javascript" })
+        const url = URL.createObjectURL(blob)
+        const worker = new Worker(url)
+        worker.onmessage = (e) => {
+          worker.terminate()
+          URL.revokeObjectURL(url)
+          done(e.data)
+        }
+        worker.onerror = (e) => {
+          worker.terminate()
+          URL.revokeObjectURL(url)
+          done({ error: e.message })
+        }
+      })().catch((err) => done({ error: err.message }))
+    JS
+
+    assert_nil result["error"]
+    assert_equal 1, result["shown"].length
+    assert_equal "RE: Layout is broken", result["shown"].first["title"]
+    assert_equal "The text is overflowing the container.", result["shown"].first.dig("options", "body")
+    assert_equal 3, result["badged"]
+    assert_equal true, result["closed"]
+    assert_equal [ "#{result["origin"]}/897362094/cards/2#comment_abc" ], result["openedUrls"]
+  end
+end
