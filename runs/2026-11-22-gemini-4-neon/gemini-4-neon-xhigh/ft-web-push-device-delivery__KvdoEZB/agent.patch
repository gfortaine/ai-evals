diff --git a/app/models/notification/message.rb b/app/models/notification/message.rb
new file mode 100644
index 0000000..e5e6e64
--- /dev/null
+++ b/app/models/notification/message.rb
@@ -0,0 +1,70 @@
+class Notification::Message
+  class << self
+    def event_title(event)
+      case event_action(event)
+      when "comment_created" then "RE: #{card_title(event.eventable.card)}"
+      else card_title(event.eventable)
+      end
+    end
+
+    def event_body(event)
+      creator = event.creator.name
+
+      case event_action(event)
+      when "card_assigned" then "Assigned to #{event.assignees.none? ? "self" : event.assignees.pluck(:name).to_sentence}"
+      when "card_unassigned" then "Unassigned by #{creator}"
+      when "card_published" then "Added by #{creator}"
+      when "card_closed" then "Moved to Done by #{creator}"
+      when "card_reopened" then "Reopened by #{creator}"
+      when "card_postponed" then "Moved to Not Now by #{creator}"
+      when "card_auto_postponed" then "Moved to Not Now due to inactivity"
+      when "card_title_changed" then "Renamed by #{creator}"
+      when "card_board_changed" then "Moved by #{creator}"
+      when "card_triaged" then "Moved to #{event.particulars.dig("particulars", "column")} by #{creator}"
+      when "card_sent_back_to_triage" then "Moved back to Maybe? by #{creator}"
+      when "comment_created" then comment_body(event)
+      else creator
+      end
+    end
+
+    private
+      def event_action(event)
+        if event.action.card_published? && event.eventable.assigned_to?(event.creator)
+          "card_assigned"
+        else
+          event.action
+        end
+      end
+
+      def comment_body(event)
+        event.eventable.body.to_plain_text.truncate(200)
+      end
+
+      def card_title(card)
+        card.title.presence || "Card #{card.number}"
+      end
+  end
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def title
+    case source
+    when Event then self.class.event_title(source)
+    when Mention then "#{source.mentioner.first_name} @mentioned you"
+    end
+  end
+
+  def body
+    case source
+    when Event then self.class.event_body(source)
+    when Mention then source.source.mentionable_content.truncate(200)
+    end
+  end
+
+  private
+    attr_reader :notification
+
+    delegate :source, to: :notification
+end
diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..6a6acce
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,20 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :push_later, on: [ :create, :update ], if: :should_push?
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self)
+  end
+
+  def push_now
+    Notification::Pusher.new(self).push
+  end
+
+  private
+    def should_push?
+      !read? && (previously_new_record? || source_id_previously_changed? || source_type_previously_changed?)
+    end
+end
diff --git a/app/models/notification/pusher.rb b/app/models/notification/pusher.rb
new file mode 100644
index 0000000..43a4ad7
--- /dev/null
+++ b/app/models/notification/pusher.rb
@@ -0,0 +1,49 @@
+class Notification::Pusher
+  include Rails.application.routes.url_helpers
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def push
+    return unless pushable?
+
+    subscriptions = user.push_subscriptions.to_a
+    return if subscriptions.empty?
+
+    payload = build_payload
+    subscriptions.each do |subscription|
+      subscription.notification(**payload)
+    end
+  end
+
+  private
+    attr_reader :notification
+
+    delegate :user, :account, :source, :card, to: :notification
+
+    def pushable?
+      Push.configured? && !notification.read? && user.active? && !user.system? && account.active? &&
+        source.present? && notification.notifiable_target.present? && card.present? && card.accessible_to?(user)
+    end
+
+    def build_payload
+      message = Notification::Message.new(notification)
+
+      {
+        title: message.title,
+        options: {
+          body: message.body,
+          icon: "/app-icon-192.png",
+          data: {
+            path: target_path,
+            badge: user.notifications.unread.count
+          }
+        }
+      }
+    end
+
+    def target_path
+      polymorphic_path(notification, script_name: account.slug, only_path: true)
+    end
+end
diff --git a/app/models/push.rb b/app/models/push.rb
new file mode 100644
index 0000000..a6d9ffd
--- /dev/null
+++ b/app/models/push.rb
@@ -0,0 +1,40 @@
+module Push
+  class << self
+    def table_name_prefix
+      "push_"
+    end
+
+    def configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].presence || Rails.configuration.x.vapid.public_key.presence
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"].presence || Rails.configuration.x.vapid.private_key.presence
+    end
+
+    def vapid_subject
+      ENV["VAPID_SUBJECT"].presence || Rails.configuration.x.vapid.subject.presence || default_vapid_subject
+    end
+
+    def vapid_options
+      {
+        subject: vapid_subject,
+        public_key: vapid_public_key,
+        private_key: vapid_private_key
+      }
+    end
+
+    private
+      def default_vapid_subject
+        from = ENV.fetch("MAILER_FROM_ADDRESS", "Fizzy <support@fizzy.do>")
+        address = Mail::Address.new(from).address
+        "mailto:#{address}"
+      rescue Mail::Field::IncompleteParseError, Mail::Field::ParseError
+        "mailto:support@fizzy.do"
+      end
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..1736ea5
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,58 @@
+class Push::Subscription < ApplicationRecord
+  ENDPOINT_TIMEOUT = 5
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  normalizes :endpoint, with: -> { it.strip }
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :validate_endpoint_url
+
+  def notification(**payload)
+    return unless Push.configured?
+
+    WebPush.payload_send(
+      message: payload.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: Push.vapid_options,
+      open_timeout: ENDPOINT_TIMEOUT,
+      read_timeout: ENDPOINT_TIMEOUT,
+      ssl_timeout: ENDPOINT_TIMEOUT
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPushSsrfProtection::PrivateAddressError => error
+    Rails.logger.warn("[Push::Subscription##{id}] Blocked push delivery: #{error.message}")
+  rescue WebPush::ResponseError, OpenSSL::OpenSSLError, ArgumentError,
+         Net::OpenTimeout, Net::ReadTimeout, Errno::ECONNREFUSED, Errno::ECONNRESET,
+         Errno::EHOSTUNREACH, Errno::ETIMEDOUT, SocketError, Resolv::ResolvError, Resolv::ResolvTimeout => error
+    Rails.logger.warn("[Push::Subscription##{id}] Failed push delivery: #{error.class}: #{error.message}")
+  end
+
+  private
+    def validate_endpoint_url
+      return if endpoint.blank?
+
+      uri = URI.parse(endpoint)
+
+      if uri.is_a?(URI::HTTPS) && uri.host.present?
+        errors.add(:endpoint, "must not point to a private or local address") if blocked_host?(uri.host)
+      else
+        errors.add(:endpoint, "must be a valid HTTPS URL")
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "must be a valid HTTPS URL")
+    end
+
+    def blocked_host?(host)
+      return true if host.casecmp?("localhost") || host.downcase.end_with?(".localhost")
+
+      ip = IPAddr.new(host.delete_prefix("[").delete_suffix("]"))
+      SsrfProtection.blocked_address?(ip)
+    rescue IPAddr::InvalidAddressError
+      false
+    end
+end
