diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..9371ff0
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,188 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static targets = [ "bell", "details", "explainer", "notAllowedNotice", "unsupportedNotice" ]
+  static classes = [ "on" ]
+  static values = { subscriptionsUrl: String }
+
+  async connect() {
+    if (!this.#isSupported) {
+      this.#showUnsupported()
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#showBlocked()
+      return
+    }
+
+    if (Notification.permission === "granted") {
+      await this.#syncExistingSubscription()
+    }
+  }
+
+  async attemptToSubscribe() {
+    if (!this.#isSupported) {
+      this.#showUnsupported()
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#showBlocked()
+      return
+    }
+
+    const permission = await Notification.requestPermission()
+
+    if (permission === "granted") {
+      await this.#subscribe()
+    } else if (permission === "denied") {
+      this.#showBlocked()
+    }
+  }
+
+  async #syncExistingSubscription() {
+    try {
+      const registration = await navigator.serviceWorker.getRegistration("/")
+      const subscription = await registration?.pushManager?.getSubscription()
+      if (!subscription) return
+
+      const applicationServerKey = this.#applicationServerKey
+      if (applicationServerKey && !this.#keysMatch(subscription.options?.applicationServerKey, applicationServerKey)) {
+        await this.#subscribe()
+      } else if (await this.#postSubscription(subscription)) {
+        this.#showEnabled()
+      }
+    } catch (error) {
+      console.error("Failed to sync push subscription:", error)
+    }
+  }
+
+  async #subscribe() {
+    const applicationServerKey = this.#applicationServerKey
+    if (!applicationServerKey) return
+
+    try {
+      const registration = await this.#getServiceWorkerRegistration()
+      let subscription = await registration.pushManager.getSubscription()
+
+      if (subscription && !this.#keysMatch(subscription.options?.applicationServerKey, applicationServerKey)) {
+        await subscription.unsubscribe()
+        subscription = null
+      }
+
+      if (!subscription) {
+        subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey
+        })
+      }
+
+      if (await this.#postSubscription(subscription)) {
+        this.#showEnabled()
+      }
+    } catch (error) {
+      console.error("Failed to subscribe to push notifications:", error)
+      if (Notification.permission === "denied") {
+        this.#showBlocked()
+      }
+    }
+  }
+
+  async #getServiceWorkerRegistration() {
+    const existing = await navigator.serviceWorker.getRegistration("/")
+    if (!existing) {
+      await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    }
+    return navigator.serviceWorker.ready
+  }
+
+  async #postSubscription(subscription) {
+    const response = await post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: this.#extractSubscriptionParams(subscription)
+      }
+    })
+
+    return response.ok
+  }
+
+  #extractSubscriptionParams(subscription) {
+    const json = typeof subscription.toJSON === "function" ? subscription.toJSON() : {}
+    const endpoint = json.endpoint || subscription.endpoint
+    const p256dh = json.keys?.p256dh || this.#encodeKey(subscription.getKey?.("p256dh"))
+    const auth = json.keys?.auth || this.#encodeKey(subscription.getKey?.("auth"))
+
+    return { endpoint, p256dh_key: p256dh, auth_key: auth }
+  }
+
+  #encodeKey(key) {
+    if (!key) return ""
+    return btoa(String.fromCharCode(...new Uint8Array(key)))
+      .replace(/\+/g, "-")
+      .replace(/\//g, "_")
+      .replace(/=+$/, "")
+  }
+
+  #showEnabled() {
+    this.element.classList.add(this.onClass)
+    if (this.hasExplainerTarget) this.explainerTarget.hidden = true
+    if (this.hasNotAllowedNoticeTarget) this.notAllowedNoticeTarget.hidden = true
+    if (this.hasUnsupportedNoticeTarget) this.unsupportedNoticeTarget.hidden = true
+    this.#toggleDetails(false)
+  }
+
+  #showBlocked() {
+    this.element.classList.remove(this.onClass)
+    if (this.hasExplainerTarget) this.explainerTarget.hidden = false
+    if (this.hasNotAllowedNoticeTarget) this.notAllowedNoticeTarget.hidden = false
+    if (this.hasUnsupportedNoticeTarget) this.unsupportedNoticeTarget.hidden = true
+    this.#toggleDetails(true)
+  }
+
+  #showUnsupported() {
+    this.element.classList.remove(this.onClass)
+    if (this.hasBellTarget) this.bellTarget.hidden = true
+    if (this.hasExplainerTarget) this.explainerTarget.hidden = false
+    if (this.hasNotAllowedNoticeTarget) this.notAllowedNoticeTarget.hidden = true
+    this.#toggleDetails(false)
+
+    const hasInstallInstructions = this.element.querySelector(".pwa__instructions") !== null
+    if (this.hasUnsupportedNoticeTarget) {
+      this.unsupportedNoticeTarget.hidden = hasInstallInstructions
+    }
+  }
+
+  #toggleDetails(visible) {
+    this.detailsTargets.forEach((detail) => {
+      detail.hidden = !visible
+    })
+  }
+
+  #keysMatch(existingKeyBuffer, expectedKeyBytes) {
+    if (!existingKeyBuffer) return true
+    const existingBytes = new Uint8Array(existingKeyBuffer)
+    if (existingBytes.length !== expectedKeyBytes.length) return false
+    return existingBytes.every((byte, index) => byte === expectedKeyBytes[index])
+  }
+
+  get #isSupported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get #applicationServerKey() {
+    const vapidPublicKey = getMetaContent("vapid-public-key")
+    if (!vapidPublicKey) return null
+
+    return this.#urlBase64ToUint8Array(vapidPublicKey)
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - base64String.length % 4) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = atob(base64)
+    return Uint8Array.from(rawData, (char) => char.charCodeAt(0))
+  }
+}
