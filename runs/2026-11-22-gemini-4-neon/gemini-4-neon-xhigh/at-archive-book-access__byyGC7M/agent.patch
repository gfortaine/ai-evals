diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..eeef944 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,99 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy archives access list and removes book and accesses" do
+    book = books(:handbook)
+    assert_equal 0, AccessArchive.count
+
+    assert_difference -> { Book.count }, -1 do
+      assert_difference -> { Access.count }, -4 do
+        assert_difference -> { AccessArchive.count }, +4 do
+          delete book_path(book)
+        end
+      end
+    end
+
+    assert_redirected_to root_url
+
+    archives = AccessArchive.where(book_id: book.id)
+    expected = [
+      [ users(:david).id, users(:david).name, "editor" ],
+      [ users(:jason).id, users(:jason).name, "editor" ],
+      [ users(:jz).id, users(:jz).name, "reader" ],
+      [ users(:kevin).id, users(:kevin).name, "editor" ]
+    ]
+
+    actual = archives.order(:user_id).map { |a| [ a.user_id, a.user_name, a.level ] }
+    assert_equal expected.sort_by(&:first), actual
+    assert archives.all? { |a| a.book_id == book.id && a.book_title == "Handbook" }
+  end
+
+  test "destroy reflects access updates and excludes revoked users" do
+    sign_in :david
+    book = books(:manual)
+
+    patch book_path(book), params: {
+      book: { title: "Updated Manual", everyone_access: false },
+      editor_ids: [ users(:jz).id ],
+      reader_ids: [ users(:kevin).id ]
+    }
+    assert_redirected_to book_slug_url(book)
+    assert_equal 0, AccessArchive.count
+
+    delete book_path(book)
+    assert_redirected_to root_url
+
+    archives = AccessArchive.where(book_id: book.id)
+    expected = [
+      [ users(:david).id, users(:david).name, "editor" ],
+      [ users(:jz).id, users(:jz).name, "editor" ],
+      [ users(:kevin).id, users(:kevin).name, "reader" ]
+    ]
+
+    actual = archives.order(:user_id).map { |a| [ a.user_id, a.user_name, a.level ] }
+    assert_equal expected.sort_by(&:first), actual
+    assert archives.all? { |a| a.book_title == "Updated Manual" }
+  end
+
+  test "destroy by admin archives only users who actually had access" do
+    sign_in :david
+    book = books(:manual)
+    book.update!(everyone_access: false, published: true)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+
+    assert_difference -> { Book.count }, -1 do
+      assert_difference -> { Access.count }, -2 do
+        assert_difference -> { AccessArchive.count }, +2 do
+          delete book_path(book)
+        end
+      end
+    end
+
+    assert_redirected_to root_url
+
+    archives = AccessArchive.where(book_id: book.id)
+    expected = [
+      [ users(:jz).id, users(:jz).name, "reader" ],
+      [ users(:kevin).id, users(:kevin).name, "editor" ]
+    ]
+
+    actual = archives.order(:user_id).map { |a| [ a.user_id, a.user_name, a.level ] }
+    assert_equal expected.sort_by(&:first), actual
+  end
+
+  test "destroy is forbidden for reader and writes no archive rows" do
+    sign_in :jz
+    book = books(:handbook)
+
+    assert_no_difference -> { Book.count } do
+      assert_no_difference -> { Access.count } do
+        assert_no_difference -> { AccessArchive.count } do
+          delete book_path(book)
+        end
+      end
+    end
+
+    assert_response :forbidden
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..bc4cbd4 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,90 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroy archives access list and removes book and accesses" do
+    book = books(:handbook)
+    assert_equal 0, AccessArchive.count
+
+    book.destroy
+
+    assert_not Book.exists?(book.id)
+    assert_empty Access.where(book_id: book.id)
+    assert_not_empty books(:manual).accesses
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal 4, archives.count
+
+    expected = [
+      [ users(:david).id, users(:david).name, "editor" ],
+      [ users(:jason).id, users(:jason).name, "editor" ],
+      [ users(:jz).id, users(:jz).name, "reader" ],
+      [ users(:kevin).id, users(:kevin).name, "editor" ]
+    ]
+
+    actual = archives.order(:user_id).map { |a| [ a.user_id, a.user_name, a.level ] }
+    assert_equal expected.sort_by(&:first), actual
+    assert archives.all? { |a| a.book_id == book.id && a.book_title == "Handbook" && a.created_at.present? }
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy
+    end
+  end
+
+  test "destroy archives current levels and excludes revoked accesses" do
+    book = books(:manual)
+    book.update!(everyone_access: false)
+
+    book.update_access(editors: [ users(:jz).id ], readers: [ users(:david).id ])
+    assert_equal 0, AccessArchive.count
+
+    book.destroy
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal 2, archives.count
+
+    expected = [
+      [ users(:david).id, users(:david).name, "reader" ],
+      [ users(:jz).id, users(:jz).name, "editor" ]
+    ]
+
+    actual = archives.order(:user_id).map { |a| [ a.user_id, a.user_name, a.level ] }
+    assert_equal expected.sort_by(&:first), actual
+  end
+
+  test "destroy reads fresh accesses even if association was preloaded before revocation" do
+    book = books(:manual)
+    book.accesses.load
+    Access.find_by!(book: book, user: users(:jason)).destroy!
+    assert_equal 0, AccessArchive.count
+
+    book.destroy
+
+    archived_user_ids = AccessArchive.where(book_id: book.id).pluck(:user_id).sort
+    assert_equal [ users(:david).id, users(:jz).id ].sort, archived_user_ids
+  end
+
+  test "destroy writes no archive rows for a book with no accesses" do
+    book = Book.create!(title: "Orphan Book", everyone_access: false)
+    assert_empty book.accesses
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy
+    end
+
+    assert_not Book.exists?(book.id)
+  end
+
+  test "destroy writes no archive rows if rolled back" do
+    book = books(:handbook)
+
+    ActiveRecord::Base.transaction(requires_new: true) do
+      book.destroy!
+      raise ActiveRecord::Rollback
+    end
+
+    assert Book.exists?(book.id)
+    assert_equal 4, Access.where(book_id: book.id).count
+    assert_equal 0, AccessArchive.count
+  end
 end
