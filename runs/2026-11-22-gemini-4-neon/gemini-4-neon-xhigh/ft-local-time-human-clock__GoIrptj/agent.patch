+require "test_helper"
+
+class LocalTimeRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "application layout mounts the local-time controller and omits server timezone meta tag" do
+    get card_path(cards(:logo))
+    assert_response :success
+
+    assert_select "body[data-controller*='local-time']"
+    assert_select "meta[name='timezone']", count: 0
+  end
+
+  test "public layout mounts the local-time controller" do
+    board = boards(:writebook)
+    board.publish
+
+    get published_card_path(cards(:logo))
+    assert_response :success
+
+    assert_select "body[data-controller*='local-time']"
+    assert_select "time[datetime='#{cards(:logo).created_at.utc.iso8601}'][data-local-time-target='agooron']", text: ""
+    assert_select "time[datetime='#{cards(:logo).last_active_at.utc.iso8601}'][data-local-time-target='agooron']", text: ""
+  end
+
+  test "card show sends raw UTC timestamps for meta, comments, and auto-close notice" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    get card_path(card)
+    assert_response :success
+
+    assert_select ".card__meta-text--added time[datetime='#{card.created_at.utc.iso8601}'][data-local-time-target='agooron']", text: ""
+    assert_select ".card__meta-text--updated time[datetime='#{card.last_active_at.utc.iso8601}'][data-local-time-target='agooron']", text: ""
+    assert_select "##{dom_id(comment)} .comment__permalink-title time[datetime='#{comment.created_at.utc.iso8601}'][data-local-time-target='relative']", text: ""
+    assert_select "##{dom_id(card, :closure_notice)} time[datetime='#{card.entropy.auto_clean_at.utc.iso8601}'][data-local-time-target='indays']", text: ""
+    assert_select "button[data-controller='bridge--share'][data-bridge-share-description*='#{card.created_at.utc.iso8601}']"
+  end
+
+  test "closed and postponed cards send raw UTC timestamps for stamps and closure notice" do
+    closed_card = cards(:shipping)
+    get card_path(closed_card)
+    assert_response :success
+
+    assert_select ".card__closed[data-bridge-description-datetime='#{closed_card.closed_at.utc.iso8601}']"
+    assert_select ".card__closed-date time[datetime='#{closed_card.closed_at.utc.iso8601}'][data-local-time-target='date']", text: ""
+    assert_select ".card-perma__closure-message time[datetime='#{closed_card.closed_at.utc.iso8601}'][data-local-time-target='agooron']", text: ""
+
+    postponed_card = cards(:logo)
+    postponed_card.postpone(user: users(:kevin))
+    get card_path(postponed_card)
+    assert_response :success
+
+    assert_select ".card__closed[data-bridge-description-datetime='#{postponed_card.postponed_at.utc.iso8601}']"
+    assert_select ".card__closed-date time[datetime='#{postponed_card.postponed_at.utc.iso8601}'][data-local-time-target='date']", text: ""
+  end
+
+  test "cached card, comment, and notification fragments are identical across different user timezones" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+    notification = notifications(:logo_assignment_kevin)
+
+    with_actionview_partial_caching do
+      cookies[:timezone] = "America/New_York"
+      get card_path(card)
+      assert_response :success
+      ny_card_html = css_select("##{dom_id(card, :card_container)}").to_html
+      ny_comment_html = css_select("##{dom_id(comment)}").to_html
+
+      get notifications_path
+      assert_response :success
+      ny_notification_html = css_select("##{dom_id(notification)}").to_html
+
+      cookies[:timezone] = "Asia/Tokyo"
+      get card_path(card)
+      assert_response :success
+      tokyo_card_html = css_select("##{dom_id(card, :card_container)}").to_html
+      tokyo_comment_html = css_select("##{dom_id(comment)}").to_html
+
+      get notifications_path
+      assert_response :success
+      tokyo_notification_html = css_select("##{dom_id(notification)}").to_html
+
+      assert_equal ny_card_html, tokyo_card_html
+      assert_equal ny_comment_html, tokyo_comment_html
+      assert_equal ny_notification_html, tokyo_notification_html
+    end
+  end
+
+  test "board, events, day timeline columns, empty days, notifications, access tokens, searches, pins, and webhooks emit raw UTC timestamps" do
+    # Board preview
+    get board_path(boards(:writebook))
+    assert_response :success
+    assert_select ".card__meta-text--added time[data-local-time-target='agooron']", text: ""
+    assert_select ".card__meta-text--updated time[data-local-time-target='relative']", text: ""
+
+    # Events timeline & empty days
+    Event.where(created_at: ...Time.current.beginning_of_day).update_all(created_at: 3.days.ago)
