diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..c47935c
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,192 @@
+import { Controller } from "@hotwired/stimulus"
+import {
+  formatDate,
+  formatDatetime,
+  formatDay,
+  formatFullDatetime,
+  formatFullDay,
+  formatInDays,
+  formatRelativeParts,
+  formatTime
+} from "helpers/time_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute
+
+export default class extends Controller {
+  static targets = [ "time", "date", "datetime", "day", "relative", "agooron", "indays" ]
+
+  #abortController
+  #timer
+
+  connect() {
+    this.#abortController = new AbortController()
+    const { signal } = this.#abortController
+
+    document.addEventListener("turbo:morph", () => this.refreshAll(), { signal })
+    document.addEventListener("turbo:morph-element", (event) => this.#refreshElement(event.target), { signal })
+    document.addEventListener("turbo:frame-render", (event) => this.#refreshWithin(event.target), { signal })
+    document.addEventListener("visibilitychange", () => {
+      if (!document.hidden) this.refreshAll()
+    }, { signal })
+
+    this.#timer = setInterval(() => this.refreshAll(), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+    this.#abortController?.abort()
+  }
+
+  timeTargetConnected(target) {
+    this.#formatTime(target)
+  }
+
+  dateTargetConnected(target) {
+    this.#formatDate(target)
+  }
+
+  datetimeTargetConnected(target) {
+    this.#formatDatetime(target)
+  }
+
+  dayTargetConnected(target) {
+    this.#formatDay(target)
+  }
+
+  relativeTargetConnected(target) {
+    this.#formatRelative(target)
+  }
+
+  agooronTargetConnected(target) {
+    this.#formatAgoOrOn(target)
+  }
+
+  indaysTargetConnected(target) {
+    this.#formatInDays(target)
+  }
+
+  refreshAll() {
+    const now = new Date()
+
+    this.timeTargets.forEach(target => this.#formatTime(target))
+    this.dateTargets.forEach(target => this.#formatDate(target))
+    this.datetimeTargets.forEach(target => this.#formatDatetime(target))
+    this.dayTargets.forEach(target => this.#formatDay(target, now))
+    this.relativeTargets.forEach(target => this.#formatRelative(target, now))
+    this.agooronTargets.forEach(target => this.#formatAgoOrOn(target, now))
+    this.indaysTargets.forEach(target => this.#formatInDays(target, now))
+  }
+
+  // Private
+
+  #refreshElement(element) {
+    if (element?.matches?.("[data-local-time-target]")) {
+      this.#refreshTarget(element)
+    }
+  }
+
+  #refreshWithin(container) {
+    if (!container?.querySelectorAll) return
+
+    this.#refreshElement(container)
+    container.querySelectorAll("[data-local-time-target]").forEach(target => this.#refreshTarget(target))
+  }
+
+  #refreshTarget(target, now = new Date()) {
+    const styles = target.dataset.localTimeTarget?.split(/\s+/) || []
+
+    for (const style of styles) {
+      switch (style) {
+        case "time": return this.#formatTime(target)
+        case "date": return this.#formatDate(target)
+        case "datetime": return this.#formatDatetime(target)
+        case "day": return this.#formatDay(target, now)
+        case "relative": return this.#formatRelative(target, now)
+        case "agooron": return this.#formatAgoOrOn(target, now)
+        case "indays": return this.#formatInDays(target, now)
+      }
+    }
+  }
+
+  #formatTime(target) {
+    const date = this.#parseDate(target)
+    if (!date) return
+
+    this.#render(target, { value: formatTime(date), title: formatFullDatetime(date) })
+  }
+
+  #formatDate(target) {
+    const date = this.#parseDate(target)
+    if (!date) return
+
+    this.#render(target, { value: formatDate(date), title: formatFullDatetime(date) })
+  }
+
+  #formatDatetime(target) {
+    const date = this.#parseDate(target)
+    if (!date) return
+
+    this.#render(target, { value: formatDatetime(date), title: formatFullDatetime(date) })
+  }
+
+  #formatDay(target, now = new Date()) {
+    const date = this.#parseDate(target)
+    if (!date) return
+
+    this.#render(target, { value: formatDay(date, now), title: formatFullDay(date) })
+  }
+
+  #formatRelative(target, now = new Date()) {
+    const date = this.#parseDate(target)
+    if (!date) return
+
+    const { prefix, value } = formatRelativeParts(date, now, { withPreposition: false })
+    this.#render(target, { prefix, value, title: formatFullDatetime(date) })
+  }
+
+  #formatAgoOrOn(target, now = new Date()) {
+    const date = this.#parseDate(target)
+    if (!date) return
+
+    const { prefix, value } = formatRelativeParts(date, now, { withPreposition: true })
+    this.#render(target, { prefix, value, title: formatFullDatetime(date) })
+  }
+
+  #formatInDays(target, now = new Date()) {
+    const date = this.#parseDate(target)
+    if (!date) return
+
+    this.#render(target, { value: formatInDays(date, now), title: formatFullDatetime(date) })
+  }
+
+  #parseDate(target) {
+    const datetime = target.getAttribute("datetime")
+    if (!datetime) return null
+
+    const date = new Date(datetime)
+    return Number.isNaN(date.getTime()) ? null : date
+  }
+
+  #render(target, { prefix = "", value, title }) {
+    if (target.title !== title) {
+      target.title = title
+    }
+
+    const expectedText = `${prefix}${value}`
+    const valueSpan = target.querySelector(":scope > .local-time-value")
+
+    if (valueSpan && target.textContent === expectedText && valueSpan.textContent === value) {
+      return
+    }
+
+    const span = document.createElement("span")
+    span.className = "local-time-value"
+    span.textContent = value
+
+    if (prefix) {
+      target.replaceChildren(document.createTextNode(prefix), span)
+    } else {
+      target.replaceChildren(span)
+    }
+  }
+}
