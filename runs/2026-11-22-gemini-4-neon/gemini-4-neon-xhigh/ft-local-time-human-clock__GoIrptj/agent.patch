+    assert_select ".events__column-header time[data-local-time-target='day']", text: ""
+    assert_select ".event__timestamp time[data-local-time-target='time']", text: ""
+    assert_select ".events__none time[data-local-time-target='day']", text: ""
+
+    # Day timeline expanded column
+    get events_day_timeline_column_path("updated")
+    assert_response :success
+    assert_select "h1.header__title time[data-local-time-target='day']", text: ""
+
+    # Notifications
+    get notifications_path
+    assert_response :success
+    assert_select ".card__timestamp time[data-local-time-target='relative']", text: ""
+
+    # Pins
+    cards(:logo).pin_by(users(:kevin))
+    get my_pins_path
+    assert_response :success
+    assert_select ".card__meta-text--updated time[data-local-time-target='relative']", text: ""
+
+    # Access tokens
+    identities(:kevin).access_tokens.create!(description: "CLI", permission: "read")
+    get my_access_tokens_path
+    assert_response :success
+    assert_select "table.access-tokens td time[data-local-time-target='datetime']", text: ""
+
+    # Search results
+    cards(:logo).reindex
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select ".search__result time[data-local-time-target='relative']", text: ""
+
+    # Webhook deliveries
+    get board_webhook_path(boards(:writebook), webhooks(:active))
+    assert_response :success
+    assert_select "time[datetime='#{webhook_deliveries(:successfully_completed).created_at.utc.iso8601}'][data-local-time-target='relative']", text: ""
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..93d7049
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,248 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    using_wait_time(10) { sign_in_as users(:kevin) }
+  end
+
+  teardown do
+    set_browser_timezone("")
+  end
+
+  test "comments, card meta, auto-close notice, stamps, and access tokens render in the viewer's own timezone" do
+    set_browser_timezone("America/New_York")
+    tz = ActiveSupport::TimeZone["America/New_York"]
+    now = Time.current.in_time_zone(tz)
+
+    today_time = now.hour >= 2 ? (now - 2.hours).change(sec: 0) : now.beginning_of_day + 5.minutes
+    last_night = now.yesterday.end_of_day - 30.minutes
+    five_days_ago = now - 5.days
+    earlier_this_year = now.yday > 14 ? (now - 14.days) : (now + 14.days)
+    last_year = (now - 400.days).change(hour: 13, min: 42, sec: 0)
+
+    card = cards(:logo)
+    c_today = card.comments.create!(creator: users(:kevin), body: "Today comment", created_at: today_time)
+    c_yesterday = card.comments.create!(creator: users(:kevin), body: "Last night comment", created_at: last_night)
+    c_five_days = card.comments.create!(creator: users(:kevin), body: "Earlier in week comment", created_at: five_days_ago)
+    c_older_same_year = card.comments.create!(creator: users(:kevin), body: "Older same year comment", created_at: earlier_this_year)
+    c_last_year = card.comments.create!(creator: users(:kevin), body: "Last year comment", created_at: last_year)
+
+    card.update_columns(created_at: five_days_ago, last_active_at: (now.tomorrow.beginning_of_day + 1.hour) - card.auto_postpone_period)
+
+    visit card_url(card)
+
+    # Comment timestamps
+    assert_time_text "##{dom_id(c_today)} .comment__permalink-title time", today_time.strftime("%-l:%M %p")
+    assert_time_text "##{dom_id(c_yesterday)} .comment__permalink-title time", "yesterday"
+    assert_time_text "##{dom_id(c_five_days)} .comment__permalink-title time", "5 days ago"
+    assert_time_text "##{dom_id(c_older_same_year)} .comment__permalink-title time", earlier_this_year.strftime("%b %-d")
+    assert_time_text "##{dom_id(c_last_year)} .comment__permalink-title time", last_year.strftime("%b %-d, %Y")
+
+    # Tooltip contains full localized date & time
+    assert_includes find("##{dom_id(c_today)} .comment__permalink-title time")[:title], today_time.strftime("%-l:%M %p")
+
+    # Card meta uses .local-time-value span
+    assert_time_text ".card__meta-text--added time", "5 days ago"
+    assert_selector ".card__meta-text--added time .local-time-value"
+
+    # Card auto-closing overnight -> "tomorrow" (and entropy bubble agrees: Closes in 1 day)
+    assert_selector "##{dom_id(card, :closure_notice)}", text: /Moves to “Not Now” tomorrow if there’s no activity\./
+    assert_selector "##{dom_id(card, :bubble)} [data-bubble-target='center']", text: "1"
+
+    # Card auto-closing in 3 days -> "in 3 days" (and entropy bubble agrees: Closes in 3 days)
+    card.update_column(:last_active_at, (now + 3.days) - card.auto_postpone_period)
+    visit card_url(card)
+    assert_selector "##{dom_id(card, :closure_notice)}", text: /Moves to “Not Now” in 3 days if there’s no activity\./
+    assert_selector "##{dom_id(card, :bubble)} [data-bubble-target='center']", text: "3"
+
+    # Card auto-closing later today -> "today"
+    card.update_column(:last_active_at, (now.end_of_day - 5.minutes) - card.auto_postpone_period)
+    visit card_url(card)
+    assert_selector "##{dom_id(card, :closure_notice)}", text: /Moves to “Not Now” today if there’s no activity\./
+
+    # Posting a new comment via Turbo Stream renders its local time immediately
+    find("lexxy-editor").click
+    send_keys("Fresh live comment")
+    submit_button = find("button.comment__submit:not([disabled])")
+    scroll_to(submit_button, align: :center)
+    submit_button.click
+    assert_selector ".comment", text: "Fresh live comment"
+    live_comment = card.comments.order(:created_at).last
+    assert_selector "##{dom_id(live_comment)} .comment__permalink-title time .local-time-value", text: /\A\d{1,2}:\d{2} [AP]M\z/
+
+    # Closed card stamp and closure message
+    closed_card = cards(:shipping)
+    closed_at = Time.utc(2025, 9, 12, 17, 42, 0) # Sep 12 1:42 PM in NY, Sep 13 2:42 AM in Tokyo
+    closed_card.closure.update_column(:created_at, closed_at)
+
+    visit card_url(closed_card)
+    assert_time_text ".card__closed-date time", "Sep 12, 2025"
+    assert_time_text ".card-perma__closure-message time", "on Sep 12, 2025"
+
+    # Switch browser to Asia/Tokyo — the EXACT same UTC timestamp flips to Sep 13, 2025!
+    set_browser_timezone("Asia/Tokyo")
+    visit card_url(closed_card)
+    assert_time_text ".card__closed-date time", "Sep 13, 2025"
+    assert_time_text ".card-perma__closure-message time", "on Sep 13, 2025"
+
+    # Access tokens table renders full date and time in viewer's timezone
+    token = identities(:kevin).access_tokens.create!(description: "CLI token", permission: "read")
+    token.update_column(:created_at, closed_at)
+
+    set_browser_timezone("America/New_York")
+    visit my_access_tokens_url
+    assert_time_text "tr[style*='#{dom_id(token)}'] td time", "Sep 12, 2025, 1:42 PM"
+
+    set_browser_timezone("Asia/Tokyo")
+    visit my_access_tokens_url
+    assert_time_text "tr[style*='#{dom_id(token)}'] td time", "Sep 13, 2025, 2:42 AM"
+  end
+
+  test "public pages, events, notifications, webhooks, searches, Turbo morph, and time helper edge cases render accurately" do
+    set_browser_timezone("America/New_York")
+
+    # Public card page (uses layouts/public.html.erb)
+    board = boards(:writebook)
+    board.publish
+    card = cards(:layout)
+    card.update_columns(created_at: Time.utc(2025, 9, 12, 17, 42, 0), last_active_at: Time.utc(2025, 9, 12, 17, 42, 0))
+
+    visit published_card_url(card)
+    assert_time_text ".card__meta-text--added time", "on Sep 12, 2025"
+    assert_time_text ".card__meta-text--updated time", "on Sep 12, 2025"
+
+    # Events timeline & empty days
+    Event.where(created_at: ...Time.current.beginning_of_day).update_all(created_at: 3.days.ago)
+    events(:layout_assignment_jz).update!(created_at: Time.current)
+    visit events_url
+    assert_time_text ".events__column-header time", "today", match: :first
+    assert_selector ".event__timestamp time .local-time-value"
+    assert_selector ".events__none time .local-time-value"
+
+    # Notifications
+    visit notifications_url
+    assert_selector ".card__timestamp time .local-time-value"
+
+    # Webhook deliveries
+    delivery = webhook_deliveries(:successfully_completed)
+    delivery.update_column(:created_at, Time.utc(2025, 9, 12, 17, 42, 0))
+    visit board_webhook_url(boards(:writebook), webhooks(:active))
+    assert_time_text "##{dom_id(delivery)} time", "Sep 12, 2025"
+
+    # Search results
+    card.reindex
+    visit search_url(q: "layout")
+    assert_selector ".search__result time .local-time-value"
+
+    # Verify Turbo morph re-populates morphed <time> elements and invalid datetime does not crash
+    visit card_url(card)
+    morph_result = page.evaluate_script(<<~JS)
+      (() => {
+        const time = document.querySelector(".card__meta-text--added time")
+        time.setAttribute("datetime", "2024-05-01T17:42:00Z")
+        time.textContent = ""
+        time.dispatchEvent(new CustomEvent("turbo:morph-element", { bubbles: true }))
+        const validMorphed = time.textContent
+
+        const invalid = document.createElement("time")
+        invalid.setAttribute("datetime", "not-a-date")
+        invalid.setAttribute("data-local-time-target", "relative")
+        document.body.appendChild(invalid)
+        invalid.dispatchEvent(new CustomEvent("turbo:morph-element", { bubbles: true }))
+        const invalidText = invalid.textContent
+        invalid.remove()
+
+        return { validMorphed, invalidText }
+      })()
+    JS
+    assert_equal "on May 1, 2024", morph_result["validMorphed"]
+    assert_equal "", morph_result["invalidText"]
+
+    # Verify exact helper formatting rules & edge cases (DST, year boundary, leap year, overdue)
+    results = page.evaluate_async_script(<<~JS)
+      const done = arguments[arguments.length - 1]
+      import("helpers/time_helpers").then((helpers) => {
+        // Fixed "now": Friday Sep 12, 2025 3:42 PM EDT (19:42 UTC)
+        const now = new Date("2025-09-12T19:42:00Z")
+
+        const out = {
+          twoHoursAgo: helpers.formatRelativeParts(new Date("2025-09-12T17:42:00Z"), now),
+          twoHoursAgoPrep: helpers.formatRelativeParts(new Date("2025-09-12T17:42:00Z"), now, { withPreposition: true }),
+          lastNight: helpers.formatRelativeParts(new Date("2025-09-12T03:30:00Z"), now), // 11:30 PM EDT Sep 11 (same UTC day!)
+          fiveDaysAgo: helpers.formatRelativeParts(new Date("2025-09-07T19:42:00Z"), now),
+          sevenDaysAgo: helpers.formatRelativeParts(new Date("2025-09-05T19:42:00Z"), now),
+          sevenDaysAgoPrep: helpers.formatRelativeParts(new Date("2025-09-05T19:42:00Z"), now, { withPreposition: true }),
+          previousYear: helpers.formatRelativeParts(new Date("2024-09-12T17:42:00Z"), now),
+          previousYearPrep: helpers.formatRelativeParts(new Date("2024-09-12T17:42:00Z"), now, { withPreposition: true }),
+          overnightAutoClose: helpers.formatInDays(new Date("2025-09-13T05:00:00Z"), now), // 1:00 AM EDT Sep 13
+          inThreeDays: helpers.formatInDays(new Date("2025-09-15T19:42:00Z"), now),
+          todayAutoClose: helpers.formatInDays(new Date("2025-09-12T23:00:00Z"), now),
+          overdueAutoClose: helpers.formatInDays(new Date("2025-09-10T19:42:00Z"), now),
+          dstSpringForward: helpers.formatRelativeParts(
+            new Date("2025-03-09T12:00:00Z"),
+            new Date("2025-03-10T12:00:00Z")
+          ),
+          dstFallBack: helpers.formatRelativeParts(
+            new Date("2025-11-02T12:00:00Z"),
+            new Date("2025-11-03T12:00:00Z")
+          ),
+          yearBoundary: helpers.formatRelativeParts(
+            new Date("2026-01-01T04:30:00Z"), // Dec 31 2025 11:30 PM EST in NY
+            new Date("2026-01-01T06:00:00Z")  // Jan 1 2026 1:00 AM EST in NY
+          ),
+          leapYear: helpers.formatRelativeParts(
+            new Date("2024-02-28T17:00:00Z"),
+            new Date("2024-03-01T17:00:00Z")
+          ),
+          dayToday: helpers.formatDay(now, now),
+          dayYesterday: helpers.formatDay(new Date("2025-09-12T03:30:00Z"), now),
+          daySameYear: helpers.formatDay(new Date("2025-09-05T19:42:00Z"), now),
+          dayLastYear: helpers.formatDay(new Date("2024-09-12T17:42:00Z"), now)
+        }
+        done(out)
+      })
+    JS
+
+    assert_equal({ "prefix" => "", "value" => "1:42 PM" }, results["twoHoursAgo"])
+    assert_equal({ "prefix" => "at ", "value" => "1:42 PM" }, results["twoHoursAgoPrep"])
+    assert_equal({ "prefix" => "", "value" => "yesterday" }, results["lastNight"])
+    assert_equal({ "prefix" => "", "value" => "5 days ago" }, results["fiveDaysAgo"])
+    assert_equal({ "prefix" => "", "value" => "Sep 5" }, results["sevenDaysAgo"])
+    assert_equal({ "prefix" => "on ", "value" => "Sep 5" }, results["sevenDaysAgoPrep"])
+    assert_equal({ "prefix" => "", "value" => "Sep 12, 2024" }, results["previousYear"])
+    assert_equal({ "prefix" => "on ", "value" => "Sep 12, 2024" }, results["previousYearPrep"])
+    assert_equal "tomorrow", results["overnightAutoClose"]
+    assert_equal "in 3 days", results["inThreeDays"]
+    assert_equal "today", results["todayAutoClose"]
+    assert_equal "today", results["overdueAutoClose"]
+    assert_equal({ "prefix" => "", "value" => "yesterday" }, results["dstSpringForward"])
+    assert_equal({ "prefix" => "", "value" => "yesterday" }, results["dstFallBack"])
+    assert_equal({ "prefix" => "", "value" => "yesterday" }, results["yearBoundary"])
+    assert_equal({ "prefix" => "", "value" => "2 days ago" }, results["leapYear"])
+    assert_equal "today", results["dayToday"]
+    assert_equal "yesterday", results["dayYesterday"]
+    assert_equal "Friday, September 5", results["daySameYear"]
+    assert_equal "Thursday, September 12, 2024", results["dayLastYear"]
+
+    # Fractional-hour timezone (Asia/Kolkata UTC+5:30)
+    set_browser_timezone("Asia/Kolkata")
+    kolkata_time = page.evaluate_async_script(<<~JS)
+      const done = arguments[arguments.length - 1]
+      import("helpers/time_helpers").then((helpers) => {
+        done(helpers.formatDatetime(new Date("2025-09-12T17:42:00Z")))
+      })
+    JS
+    assert_equal "Sep 12, 2025, 11:12 PM", kolkata_time
+  end
+
+  private
+    def set_browser_timezone(timezone_id)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone_id)
+    end
+
+    def assert_time_text(selector, expected_text, **options)
+      assert_selector "#{selector} .local-time-value", **options
+      element = find(selector, **options)
+      assert_equal expected_text, page.evaluate_script("arguments[0].textContent", element)
+    end
+end
