diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..b04aaf3
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,78 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :set_current_locale
+
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def set_current_locale(&action)
+      I18n.with_locale(resolve_current_locale, &action)
+    end
+
+    def resolve_current_locale
+      identity = current_locale_identity
+
+      if requested = valid_locale(params[:locale])
+        persist_locale(requested, identity: identity)
+        requested
+      elsif saved = valid_locale(identity&.locale)
+        saved
+      elsif stored = valid_locale(cookies[:locale])
+        stored
+      else
+        I18n.default_locale
+      end
+    end
+
+    def current_locale_identity
+      Current.identity || find_session_by_cookie&.identity
+    end
+
+    def persist_locale(locale, identity: current_locale_identity)
+      if identity
+        update_identity_locale(identity, locale)
+        cookies.delete(:locale)
+      else
+        cookies[:locale] = { value: locale.to_s, httponly: true, same_site: :lax }
+      end
+    end
+
+    def sync_locale_on_sign_in(identity)
+      if stored = valid_locale(cookies[:locale])
+        update_identity_locale(identity, stored)
+        cookies.delete(:locale)
+        I18n.locale = stored
+      elsif saved = valid_locale(identity.locale)
+        I18n.locale = saved
+      end
+    end
+
+    def sync_locale_for_bearer_identity(identity)
+      if requested = valid_locale(params[:locale])
+        update_identity_locale(identity, requested)
+        cookies.delete(:locale)
+        I18n.locale = requested
+      elsif saved = valid_locale(identity.locale)
+        I18n.locale = saved
+      end
+    end
+
+    def update_identity_locale(identity, locale)
+      if identity.locale != locale.to_s
+        ActiveRecord::Base.connected_to(role: :writing, prevent_writes: false) do
+          identity.update(locale: locale.to_s)
+        end
+      end
+    end
+
+    def valid_locale(locale)
+      return unless locale.is_a?(String) && locale.present?
+
+      normalized = locale.strip.downcase
+      normalized.to_sym if I18n.available_locales.map(&:to_s).include?(normalized)
+    end
+end
