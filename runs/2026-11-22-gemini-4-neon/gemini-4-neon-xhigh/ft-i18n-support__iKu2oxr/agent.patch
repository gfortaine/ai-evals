diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..64fa8e3
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,43 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+let cachedRaw
+let cachedData
+
+function loadI18nData() {
+  const raw = getMetaContent("i18n")
+  if (raw !== cachedRaw) {
+    cachedRaw = raw
+    try {
+      cachedData = raw ? JSON.parse(raw) : {}
+    } catch {
+      cachedData = {}
+    }
+  }
+  return cachedData || {}
+}
+
+export function currentLocale() {
+  return loadI18nData().locale || document.documentElement.lang || "en"
+}
+
+export function intlLocale() {
+  return loadI18nData().intl_locale || "en-US"
+}
+
+export function t(key, replacements = {}) {
+  const value = lookup(key)
+  if (typeof value !== "string") return key
+
+  return value.replace(/%\{(\w+)\}/g, (_, name) => {
+    return Object.prototype.hasOwnProperty.call(replacements, name) ? replacements[name] : `%{${name}}`
+  })
+}
+
+export function tCount(key, count, replacements = {}) {
+  const pluralKey = count === 1 ? `${key}.one` : `${key}.other`
+  return t(pluralKey, { count, ...replacements })
+}
+
+function lookup(key) {
+  return key.split(".").reduce((obj, part) => (obj && obj[part] !== undefined ? obj[part] : undefined), loadI18nData())
+}
