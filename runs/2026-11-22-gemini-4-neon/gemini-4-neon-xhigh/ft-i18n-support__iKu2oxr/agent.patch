+require "test_helper"
+
+class JapaneseMailersTest < ActionMailer::TestCase
+  setup do
+    @identity = identities(:david)
+    @identity.update!(locale: "ja")
+    @user = users(:david)
+    @account = accounts("37s")
+  end
+
+  test "MagicLinkMailer renders sign_in and sign_up emails in Japanese" do
+    sign_in_link = @identity.magic_links.create!(purpose: :sign_in)
+    email = MagicLinkMailer.sign_in_instructions(sign_in_link)
+
+    assert_equal "Fizzy確認コード: #{sign_in_link.code}", email.subject
+    assert_includes email.html_part.body.decoded, '<html lang="ja">'
+    assert_includes email.html_part.body.decoded, "Fizzy確認コード"
+    assert_includes email.html_part.body.decoded, "15分"
+    assert_includes email.text_part.body.decoded, "この6文字の確認コード"
+    assert_includes email.text_part.body.decoded, "15分"
+
+    sign_up_link = @identity.magic_links.create!(purpose: :sign_up)
+    email = MagicLinkMailer.sign_in_instructions(sign_up_link)
+    assert_includes email.html_part.body.decoded, "Fizzyへようこそ！"
+    assert_includes email.text_part.body.decoded, "アカウント作成を完了するため"
+  end
+
+  test "AccountMailer renders cancellation email in Japanese" do
+    cancellation = Account::Cancellation.new(account: @account, initiated_by: @user)
+    email = AccountMailer.cancellation(cancellation)
+
+    assert_equal "Fizzyアカウントが解約されました", email.subject
+    assert_includes email.html_part.body.decoded, '<html lang="ja">'
+    assert_includes email.html_part.body.decoded, "今後の流れ"
+    assert_includes email.html_part.body.decoded, "約1か月"
+    assert_includes email.text_part.body.decoded, "解約されました"
+    assert_includes email.text_part.body.decoded, "約1か月"
+  end
+
+  test "ExportMailer renders completed email in Japanese" do
+    export = @account.exports.create!(user: @user)
+    email = ExportMailer.completed(export)
+
+    assert_equal "Fizzyデータのエクスポートが完了しました", email.subject
+    assert_includes email.html_part.body.decoded, "Fizzyデータをダウンロード"
+    assert_includes email.text_part.body.decoded, "データをダウンロード:"
+  end
+
+  test "ImportMailer renders completed and failed emails in Japanese" do
+    completed = ImportMailer.completed(@identity, @account)
+    assert_equal "Fizzyアカウントのインポートが完了しました", completed.subject
+    assert_includes completed.html_part.body.decoded, "アカウントを開く"
+    assert_includes completed.text_part.body.decoded, "インポートが完了しました"
+
+    %i[ conflict invalid_export nil ].each do |reason|
+      import = @account.imports.create!(identity: @identity, status: :failed, failure_reason: reason == :nil ? nil : reason)
+      failed = ImportMailer.failed(import)
+      assert_equal "Fizzyアカウントのインポートに失敗しました", failed.subject
+      assert_includes failed.html_part.body.decoded, "インポートできませんでした"
+      assert_includes failed.text_part.body.decoded, "インポートできませんでした"
+    end
+  end
+
+  test "UserMailer renders email_change_confirmation in Japanese" do
+    email = UserMailer.email_change_confirmation(email_address: "new@example.com", token: "tok123", user: @user)
+
+    assert_equal "新しいメールアドレスを確認してください", email.subject
+    assert_includes email.body.decoded, "メールアドレスの変更を確認"
+    assert_includes email.body.decoded, "はい、このメールアドレスを使用します"
+  end
+
+  test "Notification::BundleMailer renders in Japanese with localized date and count" do
+    bundle = @user.notification_bundles.create!(
+      starts_at: Time.utc(2026, 11, 19, 15, 5, 0),
+      ends_at: Time.utc(2026, 11, 19, 17, 0, 0)
+    )
+    @user.notifications.where(card: cards(:logo)).delete_all
+    Notification.create!(
+      account: @account,
+      user: @user,
+      creator: users(:kevin),
+      source: events(:logo_published),
+      card: cards(:logo),
+      created_at: Time.utc(2026, 11, 19, 16, 0, 0)
+    )
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_includes email.subject, "新しい通知"
+    assert_includes email.html_part.body.decoded, "11月19日(木) 15:05以降の通知"
+    assert_includes email.html_part.body.decoded, "1件の新しい通知"
+    assert_includes email.html_part.body.decoded, "が追加"
+    assert_includes email.text_part.body.decoded, "11月19日(木) 15:05以降の通知"
+    assert_includes email.text_part.body.decoded, "1件の新しい通知"
+    assert_includes email.text_part.body.decoded, "通知の頻度を変更する:"
+  end
+
+  test "deliver_later delivers in recipient identity locale even when enqueued in English" do
+    sign_in_link = @identity.magic_links.create!(purpose: :sign_in)
+
+    I18n.with_locale(:en) do
+      perform_enqueued_jobs do
+        MagicLinkMailer.sign_in_instructions(sign_in_link).deliver_later
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal "Fizzy確認コード: #{sign_in_link.code}", email.subject
+    assert_includes email.html_part.body.decoded, "Fizzy確認コード"
+  end
+end
