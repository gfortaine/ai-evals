+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,184 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  PUBLIC_TEST_IP = "93.184.216.34"
+
+  setup do
+    Current.session = sessions(:david)
+    stub_dns_resolution(PUBLIC_TEST_IP)
+  end
+
+  test "creating an event enqueues relay job" do
+    assert_enqueued_with(job: Event::RelayJob) do
+      cards(:logo).close
+    end
+  end
+
+  test "event delivers POST to subscribed active webhooks on the board and logs the result" do
+    webhook = webhooks(:active)
+    request_stub = stub_request(:post, webhook.url)
+      .with(ipaddr: PUBLIC_TEST_IP)
+      .to_return(status: 200, body: "received")
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      cards(:logo).close
+    end
+
+    assert_requested request_stub, times: 1
+
+    event = Event.where(action: "card_closed", eventable: cards(:logo)).last
+    delivery = webhook.deliveries.find_by!(event: event)
+    assert delivery.completed?
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+    assert_equal "fizzy/1.0.0 Webhook", delivery.sanitized_request.dig(:headers, "User-Agent")
+  end
+
+  test "event does not deliver to unsubscribed or inactive webhooks or webhooks on other boards" do
+    active_writebook = webhooks(:active) # subscribed to card_published, card_assigned, card_closed
+    inactive_writebook = Webhook.create!(
+      board: boards(:writebook),
+      name: "Inactive on writebook",
+      url: "https://inactive.example.com/hook",
+      active: false,
+      subscribed_actions: [ "card_closed" ]
+    )
+    other_board_webhook = Webhook.create!(
+      board: boards(:private),
+      name: "Active on private",
+      url: "https://other.example.com/hook",
+      active: true,
+      subscribed_actions: [ "card_closed", "comment_created" ]
+    )
+
+    active_stub = stub_request(:post, active_writebook.url).to_return(status: 200)
+    inactive_stub = stub_request(:post, inactive_writebook.url).to_return(status: 200)
+    other_stub = stub_request(:post, other_board_webhook.url).to_return(status: 200)
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      cards(:logo).comments.create!(body: "Not subscribed on writebook")
+    end
+
+    assert_not_requested active_stub
+    assert_not_requested inactive_stub
+    assert_not_requested other_stub
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      cards(:logo).close
+    end
+
+    assert_requested active_stub, times: 1
+    assert_not_requested inactive_stub
+    assert_not_requested other_stub
+  end
+
+  test "event delivers to all active subscribed webhooks on the same board" do
+    first_webhook = webhooks(:active)
+    second_webhook = Webhook.create!(
+      board: boards(:writebook),
+      name: "Second API",
+      url: "https://second.example.com/webhooks",
+      subscribed_actions: [ "card_closed" ]
+    )
+
+    first_stub = stub_request(:post, first_webhook.url).to_return(status: 200)
+    second_stub = stub_request(:post, second_webhook.url).to_return(status: 201)
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      cards(:logo).close
+    end
+
+    assert_requested first_stub, times: 1
+    assert_requested second_stub, times: 1
+  end
+
+  test "re-running relay delivers each event exactly once" do
+    webhook = webhooks(:active)
+    request_stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    event = nil
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      cards(:logo).close
+      event = Event.where(action: "card_closed", eventable: cards(:logo)).last
+    end
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      Event::RelayJob.perform_now(event)
+      event.relay_now
+    end
+
+    assert_requested request_stub, times: 1
+    assert_equal 1, webhook.deliveries.where(event: event).count
+  end
+
+  test "end-to-end failing receiver gets switched off after ten consecutive failures over an hour" do
+    freeze_time
+
+    webhook = webhooks(:active)
+    failing_stub = stub_request(:post, webhook.url).to_return(status: 500)
+
+    10.times do |i|
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        boards(:writebook).cards.create!(title: "Card #{i}", status: :published)
+      end
+
+      if i < 9
+        assert webhook.reload.active?, "webhook should remain active after #{i + 1} failure(s)"
+        travel 7.minutes
+      end
+    end
+
+    assert_requested failing_stub, times: 10
+    assert_not webhook.reload.active?, "webhook should be switched off after 10 failures over an hour"
+
+    # Subsequent events should not trigger any more POSTs while switched off
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      boards(:writebook).cards.create!(title: "Card after deactivation", status: :published)
+    end
+
+    assert_requested failing_stub, times: 10
+  end
+
+  test "all permitted actions render valid JSON and HTML payloads" do
+    webhook = Webhook.create!(
+      board: boards(:writebook),
+      name: "All Events JSON",
+      url: "https://all-json.example.com/webhooks",
+      subscribed_actions: Webhook::PERMITTED_ACTIONS
+    )
+    campfire_webhook = Webhook.create!(
+      board: boards(:writebook),
+      name: "All Events Campfire",
+      url: "https://chat.example.com/rooms/123/456-bot/messages",
+      subscribed_actions: Webhook::PERMITTED_ACTIONS
+    )
+
+    stub_request(:post, webhook.url).to_return(status: 200)
+    stub_request(:post, campfire_webhook.url).to_return(status: 200)
+
+    Webhook::PERMITTED_ACTIONS.each do |action|
+      eventable = action == "comment_created" ? comments(:layout_1) : cards(:logo)
+      particulars = case action
+      when "card_assigned", "card_unassigned" then { assignee_ids: [ users(:jz).id ] }
+      when "card_board_changed" then { particulars: { old_board: "Old", new_board: "Writebook" } }
+      when "card_triaged" then { particulars: { column: "Triage" } }
+      else {}
+      end
+
+      event = boards(:writebook).events.create!(
+        action: action,
+        creator: users(:david),
+        eventable: eventable,
+        particulars: particulars
+      )
+
+      json_delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+      json_delivery.deliver
+      assert json_delivery.reload.succeeded?, "JSON delivery failed for #{action}"
+
+      campfire_delivery = Webhook::Delivery.create!(webhook: campfire_webhook, event: event)
+      campfire_delivery.deliver
+      assert campfire_delivery.reload.succeeded?, "Campfire delivery failed for #{action}"
+    end
+  end
+end
