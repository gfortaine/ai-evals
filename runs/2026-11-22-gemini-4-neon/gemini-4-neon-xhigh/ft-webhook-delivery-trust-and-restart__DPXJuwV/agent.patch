+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self)
+  end
+
+  def relay_now
+    Current.with_account(account) do
+      webhooks_for_relay.each do |webhook|
+        webhook.trigger(self)
+      end
+    end
+  end
+
+  private
+    def webhooks_for_relay
+      board.webhooks.active.select { |webhook| webhook.subscribed_to?(action) }
+    end
+end
