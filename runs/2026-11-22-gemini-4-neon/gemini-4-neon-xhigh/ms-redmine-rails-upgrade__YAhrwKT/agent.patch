+  def test_cache_format_version_and_cross_version_cache_compatibility
+    assert_equal 7.1, ActiveSupport.cache_format_version
+    assert_equal 7.1, ActiveSupport::Cache.format_version
+
+    Dir.mktmpdir do |dir|
+      store = ActiveSupport::Cache::FileStore.new(dir)
+
+      # Writes and reads Rails 7.1 ("\x00\x11") format entries (identical across Rails 7.2 & 8.1)
+      store.write('k71', 'héllo 7.1 ✓')
+      path71 = store.send(:normalize_key, 'k71', {})
+      assert File.binread(path71).start_with?("\x00\x11".b)
+      assert_equal 'héllo 7.1 ✓', store.read('k71')
+
+      store.write('k71_big', 'x' * 2048)
+      assert_equal 'x' * 2048, store.read('k71_big')
+
+      store.write('k71_obj', [['English', 'en'], ['Français', 'fr']])
+      assert_equal [['English', 'en'], ['Français', 'fr']], store.read('k71_obj')
+
+      # Also continues to read legacy Rails 6.1 Marshal cache entries natively
+      entry61 = ActiveSupport::Cache::Entry.new('cached html ✓')
+      path61 = store.send(:normalize_key, 'k61', {})
+      FileUtils.mkdir_p(File.dirname(path61))
+      File.binwrite(path61, Marshal.dump(entry61))
+      assert_equal 'cached html ✓', store.read('k61')
+    end
+  end
