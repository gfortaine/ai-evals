diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..93a96da
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,110 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  DEACTIVATED_UUID_PATTERN = /(?:-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})+(?=@)/i
+  DEACTIVATED_FALLBACK_PATTERN = /-deactivated-[^@]+(?=@)/i
+
+  included do
+    before_destroy :erase_created_books, prepend: true
+    after_destroy :erase_sign_in_events
+    after_destroy_commit :delete_erased_blob_files
+  end
+
+  def erase
+    destroy!
+  end
+
+  def sign_in_email_addresses
+    addresses = [ email_address ]
+    if email_address.present?
+      original = original_email_address
+      addresses << original if original.present?
+    end
+    addresses.compact.uniq
+  end
+
+  private
+    def original_email_address
+      if email_address.match?(DEACTIVATED_UUID_PATTERN)
+        email_address.sub(DEACTIVATED_UUID_PATTERN, "")
+      elsif !active? && email_address.match?(DEACTIVATED_FALLBACK_PATTERN)
+        email_address.sub(DEACTIVATED_FALLBACK_PATTERN, "")
+      end
+    end
+
+    def erase_created_books
+      @erased_blobs = []
+
+      anonymize_shared_books
+      destroy_private_books
+
+      association(:created_books).reset
+    end
+
+    def anonymize_shared_books
+      Book.where(creator_id: id).with_everyone_access.find_each(&:anonymize_author)
+    end
+
+    def destroy_private_books
+      private_book_ids = Book.where(creator_id: id).without_everyone_access.pluck(:id)
+      return if private_book_ids.empty?
+
+      blob_ids = collect_blob_ids_for_books(private_book_ids)
+
+      Book.where(id: private_book_ids).find_each(&:destroy!)
+
+      destroy_unattached_blobs(blob_ids)
+    end
+
+    def collect_blob_ids_for_books(book_ids)
+      leaf_ids = Leaf.where(book_id: book_ids).pluck(:id)
+
+      picture_ids = (
+        Leaf.where(id: leaf_ids, leafable_type: "Picture").pluck(:leafable_id) +
+        Edit.where(leaf_id: leaf_ids, leafable_type: "Picture").pluck(:leafable_id)
+      ).uniq
+
+      page_ids = (
+        Leaf.where(id: leaf_ids, leafable_type: "Page").pluck(:leafable_id) +
+        Edit.where(leaf_id: leaf_ids, leafable_type: "Page").pluck(:leafable_id)
+      ).uniq
+
+      markdown_ids = ActionText::Markdown.where(record_type: "Page", record_id: page_ids).pluck(:id)
+
+      (
+        ActiveStorage::Attachment.where(record_type: "Book", record_id: book_ids).pluck(:blob_id) +
+        ActiveStorage::Attachment.where(record_type: "Picture", record_id: picture_ids).pluck(:blob_id) +
+        ActiveStorage::Attachment.where(record_type: "ActionText::Markdown", record_id: markdown_ids).pluck(:blob_id)
+      ).uniq
+    end
+
+    def destroy_unattached_blobs(blob_ids)
+      return if blob_ids.empty?
+
+      unattached_blobs = ActiveStorage::Blob.where(id: blob_ids).where.missing(:attachments)
+      unattached_ids = unattached_blobs.pluck(:id)
+      return if unattached_ids.empty?
+
+      variant_record_ids = ActiveStorage::VariantRecord.where(blob_id: unattached_ids).pluck(:id)
+      derivative_blob_ids = (
+        ActiveStorage::Attachment.where(record_type: "ActiveStorage::VariantRecord", record_id: variant_record_ids).pluck(:blob_id) +
+        ActiveStorage::Attachment.where(record_type: "ActiveStorage::Blob", record_id: unattached_ids).pluck(:blob_id)
+      ).uniq
+
+      unattached_blobs.find_each do |blob|
+        blob.destroy
+        @erased_blobs << blob if blob.destroyed?
+      end
+
+      destroy_unattached_blobs(derivative_blob_ids)
+    end
+
+    def erase_sign_in_events
+      SignInEvent.for_address(sign_in_email_addresses).delete_all
+    end
+
+    def delete_erased_blob_files
+      Array(@erased_blobs).each(&:delete)
+      @erased_blobs = []
+    end
+end
