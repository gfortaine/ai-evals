diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..fc6d61f
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,297 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "erasing a user deletes the user row, sessions, accesses, reading marks, and sign-in events without recording a sign-out event" do
+    alice = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    session = alice.sessions.create!(user_agent: "TestBrowser", ip_address: "10.0.0.1")
+    ReadingMark.remember(leaves(:welcome_page), user: alice)
+
+    other_event = SignInEvent.create!(action: :signed_in, email_address: "alice2@example.com", ip_address: "10.0.0.2", user_agent: "Other")
+    david_event = SignInEvent.create!(action: :signed_in, email_address: users(:david).email_address, ip_address: "10.0.0.3", user_agent: "Admin")
+
+    assert_equal 1, SignInEvent.for_address("alice@example.com").count
+    assert alice.accesses.exists?
+    assert alice.reading_marks.exists?
+
+    alice.erase
+
+    assert_not User.exists?(alice.id)
+    assert_not Session.exists?(session.id)
+    assert_equal 0, Access.where(user_id: alice.id).count
+    assert_equal 0, ReadingMark.where(user_id: alice.id).count
+    assert_equal 0, SignInEvent.for_address("alice@example.com").count
+
+    assert SignInEvent.exists?(other_event.id)
+    assert SignInEvent.exists?(david_event.id)
+  end
+
+  test "erasing a user destroys private books and all nested records, blobs, variants, files, and search index entries" do
+    alice = User.create!(name: "Alice Private", email_address: "alice-private@example.com", password: "secret123456")
+    Current.user = alice
+
+    private_book = Book.create!(title: "Alice Diary", author: "Alice Private", everyone_access: false)
+    private_book.update_access(editors: [ alice.id ], readers: [ users(:kevin).id ])
+    private_book.cover.attach(io: file_fixture("reading.webp").open, filename: "cover.webp", content_type: "image/webp")
+
+    # Page with upload and an edit revision (each revision has its own Page and ActionText::Markdown)
+    page_leaf = private_book.press Page.new(body: "OriginalSecretDiaryToken"), title: "Diary Entry"
+    page_leaf.page.body.uploads.attach(io: file_fixture("pixel.bmp").open, filename: "upload1.bmp", content_type: "image/bmp")
+    page_leaf.page.body.save!
+    first_page_id = page_leaf.leafable_id
+    first_markdown_id = page_leaf.page.markdown_body.id
+    first_upload_blob = page_leaf.page.body.uploads.blobs.first
+
+    page_leaf.edit(leafable_params: { body: "UpdatedSecretDiaryToken" })
+    page_leaf.page.body.uploads.attach(io: file_fixture("white-rabbit.webp").open, filename: "upload2.webp", content_type: "image/webp")
+    page_leaf.page.body.save!
+    second_page_id = page_leaf.leafable_id
+    second_markdown_id = page_leaf.page.markdown_body.id
+    second_upload_blob = page_leaf.page.body.uploads.blobs.first
+
+    # Trashed page
+    trashed_leaf = private_book.press Page.new(body: "TrashedSecretToken"), title: "Trashed Entry"
+    trashed_page_id = trashed_leaf.leafable_id
+    trashed_leaf.trashed!
+
+    # Section with a pre-existing stale FTS entry even though its body is now nil
+    section_leaf = private_book.press Section.new(body: nil), title: "Secret Section"
+    section_id = section_leaf.leafable_id
+    ActiveRecord::Base.connection.execute(
+      ActiveRecord::Base.sanitize_sql_array([
+        "INSERT INTO leaf_search_index(rowid, title, content) VALUES (?, ?, ?)",
+        section_leaf.id, "Secret Section", "ClearedSectionSecretToken"
+      ])
+    )
+
+    # Picture with processed variant and an edit revision
+    picture = Picture.new(caption: "Private photo")
+    picture.image.attach(io: file_fixture("reading.webp").open, filename: "private-pic.webp", content_type: "image/webp")
+    picture_leaf = private_book.press picture, title: "Private Photo"
+    picture.large_image.processed
+    picture_blob = picture.image.blob
+    variant_blob = picture_blob.variant_records.first.image.blob
+    first_picture_id = picture.id
+    picture_leaf.edit(leafable_params: { caption: "Edited private photo" })
+    second_picture_id = picture_leaf.leafable_id
+
+    # Reading marks from both Alice and Kevin on the private book
+    ReadingMark.remember(page_leaf, user: alice)
+    ReadingMark.remember(page_leaf, user: users(:kevin))
+
+    cover_blob = private_book.cover.blob
+    private_leaf_ids = [ page_leaf.id, trashed_leaf.id, section_leaf.id, picture_leaf.id ]
+    private_blobs = [ cover_blob, first_upload_blob, second_upload_blob, picture_blob, variant_blob ]
+
+    assert_equal 3, fts_rows_for(private_leaf_ids).count
+
+    Current.user = users(:david)
+    perform_enqueued_jobs do
+      alice.erase
+    end
+
+    assert_not User.exists?(alice.id)
+    assert_not Book.exists?(private_book.id)
+    assert_equal 0, Access.where(book_id: private_book.id).count
+    assert_equal 0, Leaf.where(book_id: private_book.id).count
+    assert_equal 0, Edit.where(leaf_id: private_leaf_ids).count
+    assert_equal 0, ReadingMark.where(leaf_id: private_leaf_ids).count
+    assert_equal 0, Page.where(id: [ first_page_id, second_page_id, trashed_page_id ]).count
+    assert_equal 0, Section.where(id: section_id).count
+    assert_equal 0, Picture.where(id: [ first_picture_id, second_picture_id ]).count
+    assert_equal 0, ActionText::Markdown.where(id: [ first_markdown_id, second_markdown_id ]).count
+
+    private_blob_ids = private_blobs.map(&:id)
+    assert_equal 0, ActiveStorage::Attachment.where(blob_id: private_blob_ids).count
+    assert_equal 0, ActiveStorage::VariantRecord.where(blob_id: private_blob_ids).count
+    assert_equal 0, ActiveStorage::Blob.where(id: private_blob_ids).count
+
+    private_blobs.each do |blob|
+      assert_not blob.service.exist?(blob.key), "Expected blob file #{blob.key} to be deleted from storage"
+    end
+
+    assert_empty fts_rows_for(private_leaf_ids)
+    assert_empty Leaf.search("UpdatedSecretDiaryToken")
+    assert_empty Leaf.search("TrashedSecretToken")
+    assert_empty Leaf.search("ClearedSectionSecretToken")
+  ensure
+    Current.reset
+  end
+
+  test "erasing a user keeps everyone_access books, clears creator, bylines Deleted author, and keeps them working" do
+    alice = User.create!(name: "Alice Author", email_address: "alice-author@example.com", password: "secret123456")
+    Current.user = alice
+
+    shared_book = Book.create!(title: "Team Playbook", author: "Alice Author", everyone_access: true)
+    shared_book.update_access(editors: [ alice.id, users(:david).id ], readers: [])
+    shared_leaf = shared_book.press Page.new(body: "SharedPlaybookSearchableContent"), title: "Playbook Page"
+    shared_book.cover.attach(io: file_fixture("reading.webp").open, filename: "shared-cover.webp", content_type: "image/webp")
+    shared_cover_blob = shared_book.cover.blob
+
+    blank_author_shared_book = Book.create!(title: "Unnamed Shared", author: nil, everyone_access: true)
+
+    # Preload created_books to verify stale association cache does not cause shared book deletion
+    alice.created_books.load
+
+    ReadingMark.remember(shared_leaf, user: alice)
+    ReadingMark.remember(shared_leaf, user: users(:kevin))
+
+    # Also a book created by someone else where Alice had access
+    other_book = books(:handbook)
+    other_book.update!(author: "Original Author", creator: users(:david))
+    ReadingMark.remember(leaves(:welcome_page), user: alice)
+
+    original_updated_at = shared_book.updated_at
+    travel 1.minute
+
+    Current.user = users(:david)
+    alice.erase
+
+    assert_not User.exists?(alice.id)
+
+    shared_book.reload
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+    assert shared_book.updated_at > original_updated_at
+    assert shared_book.everyone_access?
+    assert shared_book.cover.attached?
+    assert ActiveStorage::Blob.exists?(shared_cover_blob.id)
+    assert Leaf.exists?(shared_leaf.id)
+    assert_includes Leaf.search("SharedPlaybookSearchableContent"), shared_leaf
+
+    blank_author_shared_book.reload
+    assert_nil blank_author_shared_book.creator_id
+    assert_equal "Deleted author", blank_author_shared_book.author
+
+    # Alice's own access & reading mark removed; other users keep theirs
+    assert_equal 0, Access.where(user_id: alice.id).count
+    assert_equal 0, ReadingMark.where(user_id: alice.id).count
+    assert shared_book.accessable?(user: users(:kevin))
+    assert shared_book.editable?(user: users(:david))
+    assert ReadingMark.exists?(user: users(:kevin), leaf: shared_leaf)
+
+    # Subsequent edits to the anonymized book by an admin do not reassign creator_id
+    shared_book.update!(title: "Team Playbook v2")
+    assert_nil shared_book.reload.creator_id
+
+    # Other people's books remain untouched
+    other_book.reload
+    assert_equal users(:david).id, other_book.creator_id
+    assert_equal "Original Author", other_book.author
+  ensure
+    Current.reset
+  end
+
+  test "erasing a previously deactivated user deletes sign-in events under their original email address" do
+    alice = User.create!(name: "Old Alice", email_address: "alice.smith+work@sub.example.com", password: "secret123456")
+    alice.sessions.create!(user_agent: "OldBrowser", ip_address: "192.168.1.10")
+    alice.sessions.last.destroy! # creates signed_out event under original email
+
+    Current.user = alice
+    private_book = Book.create!(title: "Old Alice Private", author: "Old Alice", everyone_access: false)
+    private_leaf = private_book.press Page.new(body: "OldAliceSecretContent"), title: "Old Secret"
+    shared_book = Book.create!(title: "Old Alice Shared", author: "Old Alice", everyone_access: true)
+    shared_book.update_access(editors: [ alice.id ], readers: [])
+    ReadingMark.remember(leaves(:welcome_page), user: alice)
+
+    # Deactivate the old way
+    alice.deactivate
+    assert_not alice.reload.active?
+    assert_match(/\Aalice\.smith\+work-deactivated-[0-9a-f-]{36}@sub\.example\.com\z/i, alice.email_address)
+
+    # Also add an event under the deactivated address just in case, plus an unrelated user's event
+    SignInEvent.create!(action: :signed_in, email_address: alice.email_address, ip_address: "192.168.1.11", user_agent: "Edge")
+    unrelated_event = SignInEvent.create!(action: :signed_in, email_address: "alice.smith@sub.example.com", ip_address: "192.168.1.12", user_agent: "Other")
+
+    assert_equal 2, SignInEvent.for_address("alice.smith+work@sub.example.com").count
+
+    Current.user = users(:david)
+    alice.erase
+
+    assert_not User.exists?(alice.id)
+    assert_not Book.exists?(private_book.id)
+    assert_empty fts_rows_for([ private_leaf.id ])
+    assert_equal 0, ReadingMark.where(user_id: alice.id).count
+    assert_equal 0, Access.where(user_id: alice.id).count
+    assert_equal 0, SignInEvent.for_address("alice.smith+work@sub.example.com").count
+    assert_equal 0, SignInEvent.for_address(alice.email_address).count
+    assert SignInEvent.exists?(unrelated_event.id)
+
+    shared_book.reload
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+  ensure
+    Current.reset
+  end
+
+  test "sign_in_email_addresses handles repeated deactivation and non-uuid deactivated addresses" do
+    uuid1 = SecureRandom.uuid
+    uuid2 = SecureRandom.uuid
+
+    twice_deactivated = User.new(active: false, email_address: "alice-deactivated-#{uuid1}-deactivated-#{uuid2}@example.com")
+    assert_equal [ twice_deactivated.email_address, "alice@example.com" ], twice_deactivated.sign_in_email_addresses
+
+    short_token = User.new(active: false, email_address: "bob-deactivated-abc123@example.com")
+    assert_equal [ "bob-deactivated-abc123@example.com", "bob@example.com" ], short_token.sign_in_email_addresses
+
+    active_user = User.new(active: true, email_address: "carol@example.com")
+    assert_equal [ "carol@example.com" ], active_user.sign_in_email_addresses
+  end
+
+  test "erasing a private book does not purge a blob still attached to a kept book" do
+    alice = User.create!(name: "Blob Sharer", email_address: "sharer@example.com", password: "secret123456")
+    Current.user = alice
+
+    shared_book = Book.create!(title: "Shared With Blob", everyone_access: true)
+    shared_book.cover.attach(io: file_fixture("reading.webp").open, filename: "shared.webp", content_type: "image/webp")
+    shared_blob = shared_book.cover.blob
+
+    private_book = Book.create!(title: "Private Sharing Blob", everyone_access: false)
+    private_book.cover.attach(shared_blob)
+
+    Current.user = users(:david)
+    alice.erase
+
+    assert_not Book.exists?(private_book.id)
+    assert Book.exists?(shared_book.id)
+    assert ActiveStorage::Blob.exists?(shared_blob.id)
+    assert shared_book.reload.cover.attached?
+    assert shared_blob.service.exist?(shared_blob.key)
+  ensure
+    Current.reset
+  end
+
+  test "rolling back an erasure transaction preserves all rows and blob files" do
+    alice = User.create!(name: "Rollback Alice", email_address: "rollback@example.com", password: "secret123456")
+    Current.user = alice
+    private_book = Book.create!(title: "Rollback Book", everyone_access: false)
+    private_book.cover.attach(io: file_fixture("reading.webp").open, filename: "rollback.webp", content_type: "image/webp")
+    leaf = private_book.press Page.new(body: "RollbackSearchablePhrase"), title: "Rollback Page"
+    cover_blob = private_book.cover.blob
+
+    ActiveRecord::Base.transaction(requires_new: true) do
+      alice.erase
+      raise ActiveRecord::Rollback
+    end
+
+    assert User.exists?(alice.id)
+    assert Book.exists?(private_book.id)
+    assert ActiveStorage::Blob.exists?(cover_blob.id)
+    assert cover_blob.service.exist?(cover_blob.key)
+    assert_not_empty fts_rows_for([ leaf.id ])
+  ensure
+    Current.reset
+  end
+
+  private
+    def fts_rows_for(leaf_ids)
+      return [] if leaf_ids.empty?
+
+      sql = ActiveRecord::Base.sanitize_sql_array([
+        "SELECT rowid, title, content FROM leaf_search_index WHERE rowid IN (?)",
+        leaf_ids
+      ])
+      ActiveRecord::Base.connection.select_all(sql).to_a
+    end
+end
