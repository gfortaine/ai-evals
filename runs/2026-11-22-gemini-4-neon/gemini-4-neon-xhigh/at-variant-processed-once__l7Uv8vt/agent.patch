diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..6b55ff3 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -38,4 +38,44 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "uploaded picture is derived once in the background and reused when read" do
+    transforms = 0
+    subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { transforms += 1 }
+
+    assert_difference -> { ActiveStorage::Blob.count }, 2 do
+      perform_enqueued_jobs do
+        put leafable_path(leaves(:reading_picture)), params: {
+          picture: {
+            image: fixture_file_upload("white-rabbit.webp", "image/webp")
+          }
+        }
+        assert_response :no_content
+      end
+    end
+
+    blob = leaves(:reading_picture).reload.picture.image.blob
+    assert_equal 1, transforms
+    assert_equal 1, blob.variant_records.count
+    assert ActiveStorage::Blob.service.exist?(blob.variant_records.sole.image.blob.key)
+
+    assert_no_difference -> { ActiveStorage::Blob.count } do
+      get book_slug_path(books(:handbook))
+      assert_response :ok
+
+      img = css_select("#leaf_#{leaves(:reading_picture).id} .toc__thumbnail img").first
+      get img["src"]
+      assert_response :redirect
+
+      follow_redirect!
+      assert_response :ok
+      assert_equal "image/webp", response.content_type
+      assert_equal blob.variant_records.sole.image.blob.download, response.body
+    end
+
+    assert_equal 1, transforms
+    assert_equal 1, blob.variant_records.reload.count
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+  end
 end
