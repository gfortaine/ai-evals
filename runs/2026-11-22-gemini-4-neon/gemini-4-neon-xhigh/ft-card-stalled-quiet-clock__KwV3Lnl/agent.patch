     assert_not Card.exists?(card.id)
   end
+
+  test "index filters by stalled in HTML and JSON" do
+    stalled_card, active_card = Current.set(user: users(:kevin)) do
+      stalled = boards(:writebook).cards.create!(title: "Stalled card", creator: users(:kevin), status: :published)
+      stalled.toggle_assignment(users(:david))
+      active = boards(:writebook).cards.create!(title: "Active card", creator: users(:kevin), status: :published)
