+
+    travel 15.days do
+      get card_path(card)
+      assert_response :success
+      assert_select "##{dom_id(card, :bubble)}:not([hidden])", text: /Stalled for.*15.*days/m
+
+      get card_path(card), as: :json
+      assert_response :success
+      assert_equal true, @response.parsed_body["stalled"]
+
+      # Also shown on board stream and columns
+      get board_path(boards(:writebook))
+      assert_response :success
+      assert_select "##{dom_id(card, :bubble)}:not([hidden])", text: /Stalled for.*15.*days/m
+
+      # Posting a comment resets stalled
+      post card_comments_path(card), params: { comment: { body: "Back on it" } }, as: :turbo_stream
+      assert_response :success
+      assert_turbo_stream action: :replace, target: dom_id(card, "bubble")
+
+      get card_path(card)
+      assert_response :success
+      assert_select "##{dom_id(card, :bubble)}[hidden]"
+      assert_no_match(/Stalled for/, response.body)
+
+      get card_path(card), as: :json
+      assert_response :success
+      assert_equal false, @response.parsed_body["stalled"]
+    end
+  end
+
+  test "removing header image resets stalled card" do
