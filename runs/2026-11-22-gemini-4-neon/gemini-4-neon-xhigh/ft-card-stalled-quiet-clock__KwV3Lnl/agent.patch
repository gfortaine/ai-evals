+        c.toggle_assignment(users(:david))
+      end
+    end
+
+    travel 2.weeks do
+      assert card.reload.stalled?
+
+      delete card_image_path(card)
+      assert_redirected_to card_path(card)
+      assert_not card.reload.stalled?
+    end
+  end
 end
