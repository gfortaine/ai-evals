diff --git a/spec/support/test_prof.rb b/spec/support/test_prof.rb
new file mode 100644
index 0000000..310669d
--- /dev/null
+++ b/spec/support/test_prof.rb
@@ -0,0 +1,28 @@
+# frozen_string_literal: true
+
+require 'test_prof/recipes/rspec/before_all'
+require 'test_prof/recipes/rspec/let_it_be'
+
+TestProf::LetItBe.configure do |config|
+  # Return a fresh ActiveRecord instance per example so mutated attributes and
+  # lazily-cached associations (such as Account#account_stat) never leak across examples.
+  config.default_modifiers[:refind] = true
+end
+
+TestProf::BeforeAll.configure do |config|
+  config.before(:begin) do |scope|
+    Rails.application.reload_routes_unless_loaded
+
+    if scope&.metadata&.dig(:type) == :model && !scope.metadata[:sidekiq_inline]
+      Sidekiq.testing!(:fake)
+      Sidekiq::Job.clear_all
+    else
+      Sidekiq.testing!(:inline)
+    end
+  end
+
+  config.after(:rollback) do
+    Rails.cache.clear
+    RedisConnection.with { |redis| redis.del(redis.keys) }
+  end
+end
