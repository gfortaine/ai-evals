diff --git a/spec/support/test_prof.rb b/spec/support/test_prof.rb
new file mode 100644
index 0000000..49f1042
--- /dev/null
+++ b/spec/support/test_prof.rb
@@ -0,0 +1,51 @@
+# frozen_string_literal: true
+
+require 'test_prof/recipes/rspec/before_all'
+require 'test_prof/recipes/rspec/let_it_be'
+require 'test_prof/recipes/rspec/factory_default'
+
+TestProf::LetItBe.configure do |config|
+  # Return a fresh ActiveRecord instance per example so mutated attributes and
+  # lazily-cached associations (such as Account#account_stat) never leak across examples.
+  config.default_modifiers[:refind] = true
+end
+
+TestProf::FactoryDefault.configure do |config|
+  config.preserve_attributes = true
+end
+
+# TestProf::FactoryDefault's Fabrication patch intercepts nested Fabricate.create calls,
+# while Mastodon fabricators commonly use Fabricate.build for belongs_to associations.
+# Extend Fabricate.build to also honor registered defaults for nested calls (depth >= 2).
+module FabricationFactoryDefaultBuildExt
+  def build(name, overrides = {}, &block)
+    self.fabrication_depth += 1
+    return super if block
+    return super if fabrication_depth < 2
+
+    TestProf::FactoryDefault.get(name, nil, overrides, **{}) ||
+      TestProf::FactoryDefault.profiler.instrument(name, nil, overrides) { super }
+  ensure
+    self.fabrication_depth -= 1
+  end
+end
+
+Fabricate.singleton_class.prepend(FabricationFactoryDefaultBuildExt)
+
+TestProf::BeforeAll.configure do |config|
+  config.before(:begin) do |scope|
+    Rails.application.reload_routes_unless_loaded
+
+    if %i(model request).include?(scope&.metadata&.dig(:type)) && !scope.metadata[:sidekiq_inline]
+      Sidekiq.testing!(:fake)
+      Sidekiq::Job.clear_all
+    else
+      Sidekiq.testing!(:inline)
+    end
+  end
+
+  config.after(:rollback) do
+    Rails.cache.clear
+    RedisConnection.with { |redis| redis.del(redis.keys) }
+  end
+end
