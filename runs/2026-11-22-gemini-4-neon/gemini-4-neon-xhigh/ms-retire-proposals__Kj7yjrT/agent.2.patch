+        execute("DELETE FROM images WHERE id IN (#{img_list})")
+      end
+
+      document_ids = select_values("SELECT id FROM documents WHERE documentable_type IN (#{quoted})").map(&:to_i)
+      if document_ids.any?
+        doc_list = document_ids.join(", ")
+        execute("DELETE FROM active_storage_attachments WHERE record_type = 'Document' AND record_id IN (#{doc_list})")
+        execute("DELETE FROM documents WHERE id IN (#{doc_list})")
+      end
+    end
+
+    def quoted_removed_types
+      @quoted_removed_types ||= REMOVED_TYPES.map { |t| quote(t) }.join(", ")
+    end
+end
