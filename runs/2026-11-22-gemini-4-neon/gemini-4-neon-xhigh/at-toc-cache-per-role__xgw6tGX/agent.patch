diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..5a5dd0c 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,207 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "show does not serve cached editor controls to a reader after an editor opens the book" do
+    with_caching do
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_editor_toc_controls(books(:handbook))
+
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_reader_toc_controls(books(:handbook))
+    end
+  end
+
+  test "show does not serve cached editor controls to an unauthenticated reader on a published book" do
+    books(:handbook).update!(published: true)
+
+    with_caching do
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_editor_toc_controls(books(:handbook))
+
+      sign_out
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_reader_toc_controls(books(:handbook))
+    end
+  end
+
+  test "show serves editor controls to an editor after a reader opens the book" do
+    with_caching do
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_reader_toc_controls(books(:handbook))
+
+      sign_in :kevin
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_editor_toc_controls(books(:handbook))
+    end
+  end
+
+  test "show reflects updated user permissions when cached" do
+    with_caching do
+      get book_slug_path(books(:handbook))
+      assert_editor_toc_controls(books(:handbook))
+
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_reader_toc_controls(books(:handbook))
+
+      books(:handbook).update_access(
+        editors: [ users(:david).id, users(:jason).id, users(:jz).id ],
+        readers: [ users(:kevin).id ]
+      )
+
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_editor_toc_controls(books(:handbook))
+
+      sign_in :kevin
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_reader_toc_controls(books(:handbook))
+    end
+  end
+
+  test "show reflects a renamed entry for both readers and editors when cached" do
+    with_caching do
+      get book_slug_path(books(:handbook))
+      assert_in_body "Welcome to The Handbook!"
+
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_in_body "Welcome to The Handbook!"
+
+      sign_in :kevin
+      put leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Updated Welcome" } }
+      assert_response :no_content
+
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_in_body "Updated Welcome"
+      assert_not_in_body "Welcome to The Handbook!"
+      assert_reader_toc_controls(books(:handbook))
+
+      sign_in :kevin
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_in_body "Updated Welcome"
+      assert_not_in_body "Welcome to The Handbook!"
+      assert_editor_toc_controls(books(:handbook))
+    end
+  end
+
+  test "show updates cached entry links when the book slug changes" do
+    with_caching do
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_select "a[href='#{leafable_slug_path(leaves(:welcome_page))}']"
+
+      books(:handbook).update!(slug: "updated-handbook")
+
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_select "a[href='#{leafable_slug_path(leaves(:welcome_page).reload)}']"
+      assert_not_in_body "/#{books(:handbook).id}/handbook/"
+    end
+  end
+
+  test "show fetches cached entries in a single batch read without per-entry cache lookups" do
+    with_caching do
+      cold_reads = []
+      cold_multi_reads = []
+      cold_writes = []
+      cold_multi_writes = []
+
+      collect_cache_events(reads: cold_reads, multi_reads: cold_multi_reads, writes: cold_writes, multi_writes: cold_multi_writes) do
+        get book_slug_path(books(:handbook))
+      end
+
+      assert_response :success
+      assert_equal 1, cold_multi_reads.size
+      assert_equal books(:handbook).leaves.active.count, cold_multi_reads.first[:keys].size
+      assert_equal 1, cold_multi_writes.size
+      assert_equal 1, cold_reads.size
+      assert_equal 1, cold_writes.size
+
+      leaves(:welcome_page).update!(title: "Fresh Title")
+
+      warm_reads = []
+      warm_multi_reads = []
+      warm_writes = []
+      warm_multi_writes = []
+
+      collect_cache_events(reads: warm_reads, multi_reads: warm_multi_reads, writes: warm_writes, multi_writes: warm_multi_writes) do
+        get book_slug_path(books(:handbook))
+      end
+
+      assert_response :success
+      assert_in_body "Fresh Title"
+      assert_equal 1, warm_multi_reads.size
+      assert_equal books(:handbook).leaves.active.count - 1, warm_multi_reads.first[:hits].size
+      assert_equal 1, warm_multi_writes.size
+      assert_equal 1, warm_multi_writes.first[:size]
+      assert_equal 1, warm_reads.size
+      assert_equal 1, warm_writes.size
+    end
+  end
+
+  private
+    def with_caching
+      previous_perform_caching = ActionController::Base.perform_caching
+      previous_cache_store = ActionController::Base.cache_store
+      previous_collection_cache = ActionView::PartialRenderer.collection_cache
+      previous_rails_cache = Rails.cache
+
+      memory_store = ActiveSupport::Cache::MemoryStore.new
+      ActionController::Base.perform_caching = true
+      ActionController::Base.cache_store = memory_store
+      ActionView::PartialRenderer.collection_cache = memory_store
+      Rails.cache = memory_store
+
+      yield memory_store
+    ensure
+      ActionController::Base.perform_caching = previous_perform_caching
+      ActionController::Base.cache_store = previous_cache_store
+      ActionView::PartialRenderer.collection_cache = previous_collection_cache
+      Rails.cache = previous_rails_cache
+    end
+
+    def collect_cache_events(reads:, multi_reads:, writes:, multi_writes:)
+      subscribers = [
+        ActiveSupport::Notifications.subscribe("cache_read.active_support") { |*, payload| reads << payload[:key] },
+        ActiveSupport::Notifications.subscribe("cache_read_multi.active_support") { |*, payload| multi_reads << { keys: payload[:key], hits: payload[:hits] } },
+        ActiveSupport::Notifications.subscribe("cache_write.active_support") { |*, payload| writes << payload[:key] },
+        ActiveSupport::Notifications.subscribe("cache_write_multi.active_support") { |*, payload| multi_writes << { size: payload[:key].size } }
+      ]
+
+      yield
+    ensure
+      subscribers.each { |subscriber| ActiveSupport::Notifications.unsubscribe(subscriber) }
+    end
+
+    def assert_editor_toc_controls(book)
+      book.leaves.active.each do |leaf|
+        assert_select "a[href='#{edit_leafable_path(leaf)}']"
+        assert_select "a[href='#{leafable_slug_path(leaf)}']"
+      end
+      assert_select "form.leaf__delete", count: book.leaves.active.count
+      assert_select ".arrangement__handle", count: book.leaves.active.count
+    end
+
+    def assert_reader_toc_controls(book)
+      book.leaves.active.each do |leaf|
+        assert_select "a[href='#{edit_leafable_path(leaf)}']", count: 0
+        assert_select "a[href='#{leafable_slug_path(leaf)}']"
+      end
+      assert_select "form.leaf__delete", count: 0
+      assert_select ".arrangement__handle", count: 0
+    end
 end
