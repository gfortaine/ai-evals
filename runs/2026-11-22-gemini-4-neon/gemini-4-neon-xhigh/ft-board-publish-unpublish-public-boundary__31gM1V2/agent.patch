diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..958b26b
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,34 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public link</h2>
+
+    <p class="margin-none-block-start">
+      Turn on the public link to share a read-only view of this board with anyone who has the secret URL.
+    </p>
+
+    <div class="flex align-center justify-center gap-half margin-block-end">
+      <%= form_with url: board_publication_path(board), method: board.published? ? :delete : :post, data: { controller: "form" } do %>
+        <label class="switch">
+          <%= check_box_tag :published, "1", board.published?, class: "switch__input", disabled: !Current.user.admin?, data: { action: "change->form#submit" } %>
+          <span class="switch__btn round"></span>
+          <span class="for-screen-reader"><%= board.published? ? "Unpublish this board" : "Publish this board" %></span>
+        </label>
+      <% end %>
+    </div>
+
+    <% if board.published? %>
+      <% url = public_board_url(board.publication) %>
+      <div class="flex align-center gap-half">
+        <input type="text" class="input flex-item-grow" value="<%= url %>" readonly>
+        <%= button_to_copy_to_clipboard(url) do %>
+          <%= icon_tag "copy-paste" %>
+          <span class="for-screen-reader">Copy public link</span>
+        <% end %>
+        <%= link_to url, class: "btn", target: "_blank", rel: "noopener noreferrer", data: { controller: "tooltip" } do %>
+          <%= icon_tag "world" %>
+          <span class="for-screen-reader">Open public board</span>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+<% end %>
