+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admin can publish board" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+    assert @board.publication.key.present?
+  end
+
+  test "admin can publish board via turbo stream" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@board, :publication)
+  end
+
+  test "admin can publish board as JSON" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    assert_equal public_board_url(@board.publication), @response.parsed_body["public_url"]
+  end
+
+  test "owner can publish and unpublish board" do
+    @board.accesses.grant_to(users(:jason))
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "admin can unpublish board" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "admin can unpublish board via turbo stream" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@board, :publication)
+  end
+
+  test "admin can unpublish board as JSON" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "publishing an already published board keeps the existing key" do
+    @board.publish
+    original_key = @board.publication.key
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert_equal original_key, @board.reload.publication.key
+    assert_equal public_board_url(@board.publication), @response.parsed_body["public_url"]
+  end
+
+  test "unpublishing an already unpublished board succeeds" do
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin member cannot publish board" do
+    logout_and_sign_in_as :jz
+
+    assert_no_changes -> { @board.reload.published? } do
+      post board_publication_path(@board)
+    end
+
+    assert_response :forbidden
+  end
+
+  test "non-admin board creator cannot publish board" do
+    logout_and_sign_in_as :david
+    assert_equal users(:david), @board.creator
+
+    assert_no_changes -> { @board.reload.published? } do
+      post board_publication_path(@board)
+    end
+
+    assert_response :forbidden
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+  end
+
+  test "non-admin cannot unpublish board" do
+    @board.publish
+    logout_and_sign_in_as :david
+
+    assert_no_changes -> { @board.reload.published? } do
+      delete board_publication_path(@board)
+    end
+
+    assert_response :forbidden
+
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+  end
+
+  test "admin without access to board gets not found" do
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(boards(:private))
+    assert_response :not_found
+
+    delete board_publication_path(boards(:private))
+    assert_response :not_found
+  end
+
+  test "unauthenticated user cannot publish or unpublish board" do
+    sign_out
+
+    post board_publication_path(@board)
+    assert_redirected_to new_session_url(script_name: nil)
+    assert_not @board.reload.published?
+  end
+
+  test "board edit shows publication controls for admin" do
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "input[name=published]:not([disabled])"
+
+    @board.publish
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "input[value='#{public_board_url(@board.publication)}']"
+  end
+
+  test "board edit disables publication toggle for non-admin" do
+    @board.publish
+    logout_and_sign_in_as :david
+
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "input[name=published][disabled]"
+    assert_select "input[value='#{public_board_url(@board.publication)}']"
+  end
+
+  test "bearer token authorization for publishing and unpublishing" do
+    sign_out
+
+    admin_write_token = identities(:kevin).access_tokens.create!(description: "Admin write", permission: :write)
+    admin_read_token = identities(:kevin).access_tokens.create!(description: "Admin read", permission: :read)
+    member_write_token = identity_access_tokens(:davids_api_token)
+
+    post board_publication_path(@board), as: :json, headers: { "Authorization" => "Bearer #{admin_read_token.token}" }
+    assert_response :unauthorized
+    assert_not @board.reload.published?
+
+    post board_publication_path(@board), as: :json, headers: { "Authorization" => "Bearer #{member_write_token.token}" }
+    assert_response :forbidden
+    assert_not @board.reload.published?
+
+    post board_publication_path(@board), as: :json, headers: { "Authorization" => "Bearer #{admin_write_token.token}" }
+    assert_response :created
+    assert @board.reload.published?
+    assert_equal public_board_url(@board.publication), @response.parsed_body["public_url"]
+
+    delete board_publication_path(@board), as: :json, headers: { "Authorization" => "Bearer #{member_write_token.token}" }
+    assert_response :forbidden
+    assert @board.reload.published?
+
+    delete board_publication_path(@board), as: :json, headers: { "Authorization" => "Bearer #{admin_write_token.token}" }
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+end
