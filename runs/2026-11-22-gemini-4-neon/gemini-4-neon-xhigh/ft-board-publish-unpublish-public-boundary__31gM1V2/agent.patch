+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @card = cards(:logo)
+  end
+
+  test "anyone can view a published card without signing in" do
+    @card.steps.create!(content: "Review draft", completed: true)
+    @card.steps.create!(content: "Publish it", completed: false)
+
+    get public_board_card_path(@board.publication, @card)
+
+    assert_response :success
+    assert_select "h1", text: /#{Regexp.escape(@card.title)}/
+    assert_select "a[href='#{public_board_path(@board.publication)}']"
+    assert_select "meta[property='og:url'][content='#{public_board_card_url(@board.publication, @card)}']"
+    assert_includes response.body, "Review draft"
+    assert_includes response.body, "Publish it"
+    assert_includes response.body, comments(:logo_1).body.to_plain_text
+  end
+
+  test "published card does not leak private links or editing controls" do
+    get public_board_card_path(@board.publication, @card)
+
+    assert_response :success
+    assert_select "a[href='#{edit_card_path(@card)}']", count: 0
+    assert_select "a[href='#{board_path(@board)}']", count: 0
+    assert_select "a[href='#{user_path(@card.creator)}']", count: 0
+    assert_select "form[action='#{card_comments_path(@card)}']", count: 0
+  end
+
+  test "closed and postponed published cards can be viewed" do
+    get public_board_card_path(@board.publication, cards(:shipping))
+    assert_response :success
+    assert_includes response.body, cards(:shipping).title
+
+    postponed = Current.set(user: users(:david)) do
+      @board.cards.create!(title: "Later card", status: :published, creator: users(:david)).tap do |card|
+        card.postpone(user: users(:david))
+      end
+    end
+
+    get public_board_card_path(@board.publication, postponed)
+    assert_response :success
+    assert_includes response.body, postponed.title
+  end
+
+  test "drafted card on a published board returns not found" do
+    draft = @board.cards.create!(title: "Secret Draft", status: :drafted, creator: users(:david))
+
+    get public_board_card_path(@board.publication, draft)
+
+    assert_response :not_found
+  end
+
+  test "card belonging to another board returns not found" do
+    other_card = Current.set(user: users(:kevin)) do
+      boards(:private).cards.create!(title: "Private Card", status: :published, creator: users(:kevin))
+    end
+
+    get public_board_card_path(@board.publication, other_card)
+
+    assert_response :not_found
+  end
+
+  test "nonexistent card number returns not found" do
+    get public_board_card_path(@board.publication, 999999)
+
+    assert_response :not_found
+  end
+
+  test "invalid board key returns not found" do
+    get public_board_card_path("invalid-key", @card)
+
+    assert_response :not_found
+  end
+
+  test "unpublished board returns not found" do
+    key = @board.publication.key
+    @board.unpublish
+
+    get public_board_card_path(key, @card)
+
+    assert_response :not_found
+  end
+
+  test "renders card with image, reactions, tags, assignees, mentions, and system comments" do
+    Current.set(user: users(:david)) do
+      @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      @card.reactions.create!(content: "🎉", reacter: users(:david))
+      comments(:logo_1).reactions.create!(content: "Nice!", reacter: users(:kevin))
+      @card.comments.create!(creator: accounts("37s").system_user, body: "System update")
+      mention_html = ActionText::Attachment.from_attachable(users(:kevin)).to_html
+      @card.update!(description: "<p>Hello #{mention_html}</p>")
+    end
+
+    get public_board_card_path(@board.publication, @card)
+
+    assert_response :success
+    assert_includes response.body, "🎉"
+    assert_includes response.body, "Nice!"
+    assert_includes response.body, "System update"
+    assert_includes response.body, "Kevin"
+    assert_select ".card__background img"
+  end
+end
