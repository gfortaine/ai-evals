diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..050f7f4
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are unpublished by default" do
+    assert_not @board.published?
+    assert_not @board.publicly_accessible?
+    assert_nil @board.publication
+  end
+
+  test "publish creates a publication with a secret key and touches the board" do
+    original_updated_at = @board.updated_at
+
+    travel 1.minute do
+      @board.publish
+    end
+
+    assert @board.published?
+    assert @board.publicly_accessible?
+    assert @board.publication.present?
+    assert @board.publication.key.present?
+    assert_equal @board.account, @board.publication.account
+    assert_equal @board.publication.key, @board.publication.to_param
+    assert_operator @board.reload.updated_at, :>, original_updated_at
+  end
+
+  test "publish is idempotent and keeps the same key" do
+    @board.publish
+    original_key = @board.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      @board.publish
+    end
+
+    assert_equal original_key, @board.reload.publication.key
+  end
+
+  test "unpublish destroys publication and updates state immediately" do
+    @board.publish
+    assert @board.published?
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+    assert_not @board.publicly_accessible?
+    assert_nil @board.publication
+    assert_not @board.reload.published?
+  end
+
+  test "unpublish on an unpublished board is a no-op" do
+    assert_no_difference -> { Board::Publication.count } do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+  end
+
+  test "re-publishing generates a new secret key" do
+    @board.publish
+    first_key = @board.publication.key
+
+    @board.unpublish
+    @board.publish
+    second_key = @board.publication.key
+
+    assert_not_equal first_key, second_key
+    assert_nil Board.find_by_published_key(first_key)
+    assert_equal @board, Board.find_by_published_key(second_key)
+  end
+
+  test "published scope and find_by_published_key" do
+    @board.publish
+    key = @board.publication.key
+
+    assert_includes Board.published, @board
+    assert_not_includes Board.published, boards(:private)
+    assert_equal @board, Board.find_by_published_key(key)
+    assert_equal @board, accounts("37s").boards.find_by_published_key(key)
+    assert_nil accounts(:initech).boards.find_by_published_key(key)
+    assert_nil Board.find_by_published_key("nonexistent")
+  end
+
+  test "destroying a board destroys its publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy!
+    end
+  end
+
+  test "card and comment publicly_accessible? depend on board and card publication" do
+    published_card = cards(:logo)
+    comment = comments(:logo_1)
+    drafted_card = @board.cards.create!(title: "Secret draft", status: :drafted, creator: users(:david))
+
+    assert_not published_card.publicly_accessible?
+    assert_not comment.publicly_accessible?
+    assert_not drafted_card.publicly_accessible?
+
+    @board.publish
+
+    assert published_card.reload.publicly_accessible?
+    assert comment.reload.publicly_accessible?
+    assert_not drafted_card.reload.publicly_accessible?
+
+    @board.unpublish
+
+    assert_not published_card.reload.publicly_accessible?
+    assert_not comment.reload.publicly_accessible?
+  end
+end
