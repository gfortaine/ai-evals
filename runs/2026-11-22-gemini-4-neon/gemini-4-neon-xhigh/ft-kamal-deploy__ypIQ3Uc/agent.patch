index 0000000..ccda9d0
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,94 @@
+# Deploy Fizzy to a single Linux server with Docker, SQLite, Thruster, Solid Queue,
+# and automatic SSL via kamal-proxy.
+#
+# Quick start:
+#   1. Replace `fizzy.example.com` below with your hostname (and server IP if different).
+#   2. Fill in your mail server settings (`MAILER_FROM_ADDRESS`, `SMTP_ADDRESS`, `SMTP_PORT`).
+#   3. Set your secrets in your environment or `.kamal/secrets` (`SECRET_KEY_BASE`, `SMTP_USERNAME`, `SMTP_PASSWORD`).
+#   4. Run `bin/kamal setup`.
+#
+# See docs/deployment.md for the full guide.
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image (use your-user/fizzy on external registries).
+image: fizzy
+
+# Deploy to your Linux server (replace with your server's hostname or IP address).
+servers:
+  web:
+    - fizzy.example.com
+
+# Terminate SSL at kamal-proxy with automatic Let's Encrypt certificates.
+# Point your hostname's DNS A/AAAA record at your server with ports 80 and 443 open.
+# If using Cloudflare, set SSL/TLS encryption mode to "Full".
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Push images directly to your server via Kamal's built-in local registry (no external registry required).
+# To use an external registry (Docker Hub, GHCR, etc.) instead, change `server` and uncomment `username`/`password`.
+registry:
+  server: localhost:5555
+  # server: ghcr.io
+  # username: your-user
+  # password:
+  #   - KAMAL_REGISTRY_PASSWORD
+
+# Inject ENV variables into the container (secrets come from .kamal/secrets).
+env:
+  clear:
+    # Public hostname used for links in emails, webhooks, exports, and background jobs.
+    APP_HOST: fizzy.example.com
+
+    # Outgoing mail server (SMTP) settings for magic link sign-in codes and notifications.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    # SMTP_DOMAIN: example.com
+    # SMTP_AUTHENTICATION: plain
+    # SMTP_TLS: true
+    # SMTP_ENABLE_STARTTLS_AUTO: false
+
+    # Run Solid Queue inside Puma so background and recurring jobs run in the same container.
+    SOLID_QUEUE_IN_PUMA: true
+    JOB_CONCURRENCY: 1
+
+    # Set the number of Puma worker processes (defaults to number of CPU cores).
+    # WEB_CONCURRENCY: 2
+
+    # Allow multiple accounts to sign up (by default Fizzy allows a single account signup).
+    # MULTI_TENANT: true
+
+    # Log everything from Rails.
+    # RAILS_LOG_LEVEL: debug
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# Persist SQLite databases (primary, queue, cache, cable) and Active Storage uploads across deploys.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets between versions during zero-downtime deploys.
+asset_path: /rails/public/assets
+
+# Configure the image builder for your server's architecture (amd64 or arm64).
+builder:
+  arch: amd64
+  # remote: ssh://root@your-builder-host
+
+# Helpful shortcuts triggered with `bin/kamal <alias>`.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
+
+# Use a different SSH user than root.
+# ssh:
+#   user: deploy
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..67ddd67 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,47 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Configure default URL options from APP_HOST for mailers, webhooks, exports, and background jobs.
+  # Don't overwrite if already set (e.g. by fizzy-saas).
+  if (app_host = ENV["APP_HOST"].presence)
+    url_options = { host: app_host, protocol: config.force_ssl ? "https" : "http" }
+    config.action_controller.default_url_options = url_options if config.action_controller.default_url_options.blank?
+    config.action_mailer.default_url_options = url_options if config.action_mailer.default_url_options.blank?
+    routes.default_url_options = url_options if routes.default_url_options.blank?
+  end
+
+  # Configure outgoing SMTP from environment variables.
+  # Don't overwrite if already set (e.g. by fizzy-saas).
+  if config.action_mailer.smtp_settings.blank? && ENV["SMTP_ADDRESS"].present?
+    smtp_port = ENV["SMTP_PORT"].presence&.to_i || 587
+    smtp_tls = if ENV["SMTP_TLS"].present?
+      ENV["SMTP_TLS"] == "true"
+    else
+      smtp_port == 465
+    end
+    smtp_username = ENV["SMTP_USERNAME"].presence
+    smtp_password = ENV["SMTP_PASSWORD"].presence
+    smtp_authentication = case ENV["SMTP_AUTHENTICATION"].presence
+    when nil
+      :plain if smtp_username || smtp_password
+    when "none"
+      nil
+    else
+      ENV["SMTP_AUTHENTICATION"].to_sym
+    end
+
+    config.action_mailer.smtp_settings = {
+      address: ENV["SMTP_ADDRESS"],
+      port: smtp_port,
+      domain: ENV["SMTP_DOMAIN"].presence || ENV["APP_HOST"].presence,
+      user_name: smtp_username,
+      password: smtp_password,
+      authentication: smtp_authentication,
+      tls: (true if smtp_tls),
+      enable_starttls_auto: !smtp_tls && ENV["SMTP_ENABLE_STARTTLS_AUTO"] != "false"
+    }.compact
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
