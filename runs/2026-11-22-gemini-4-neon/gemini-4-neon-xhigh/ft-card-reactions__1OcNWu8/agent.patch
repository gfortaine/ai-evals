diff --git a/app/controllers/reactions_controller.rb b/app/controllers/reactions_controller.rb
new file mode 100644
index 0000000..911aaf4
--- /dev/null
+++ b/app/controllers/reactions_controller.rb
@@ -0,0 +1,49 @@
+class ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_reactable
+
+  with_options only: :destroy do
+    before_action :set_reaction
+    before_action :ensure_permission_to_administer_reaction
+  end
+
+  def index
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @reactable.reactions.create!(params.expect(reaction: :content))
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_reactable
+      raise NotImplementedError
+    end
+
+    def set_reaction
+      @reaction = @reactable.reactions.find(params[:id])
+    end
+
+    def ensure_permission_to_administer_reaction
+      head :forbidden if Current.user != @reaction.reacter
+    end
+end
diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..f91542a
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,37 @@
+module ReactionsHelper
+  def reactable_reactions_path(reactable, **)
+    case reactable
+    when Card
+      card_reactions_path(reactable, **)
+    when Comment
+      card_comment_reactions_path(reactable.card, reactable, **)
+    end
+  end
+
+  def new_reactable_reaction_path(reactable, **)
+    case reactable
+    when Card
+      new_card_reaction_path(reactable, **)
+    when Comment
+      new_card_comment_reaction_path(reactable.card, reactable, **)
+    end
+  end
+
+  def reactable_reaction_path(reaction, **)
+    case reaction.reactable
+    when Card
+      card_reaction_path(reaction.reactable, reaction, **)
+    when Comment
+      card_comment_reaction_path(reaction.reactable.card, reaction.reactable, reaction, **)
+    end
+  end
+
+  def reactable_reaction_url(reaction, **)
+    case reaction.reactable
+    when Card
+      card_reaction_url(reaction.reactable, reaction, **)
+    when Comment
+      card_comment_reaction_url(reaction.reactable.card, reaction.reactable, reaction, **)
+    end
+  end
+end
