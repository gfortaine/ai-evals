diff --git a/test/system/card_reactions_test.rb b/test/system/card_reactions_test.rb
new file mode 100644
index 0000000..eb79f04
--- /dev/null
+++ b/test/system/card_reactions_test.rb
@@ -0,0 +1,105 @@
+require "application_system_test_case"
+
+class CardReactionsTest < ApplicationSystemTestCase
+  setup do
+    @card = cards(:logo)
+    sign_in_as users(:david)
+  end
+
+  test "adding and deleting a reaction on a card and seeing boost count in board column" do
+    # Initially no boost count on board column preview
+    visit board_url(@card.board)
+    expand_column(@card.column)
+    within("##{dom_id(@card, :article)}") do
+      assert_no_selector ".card__boosts"
+    end
+
+    # Visit card detail view and add a text reaction
+    visit card_url(@card)
+    within("##{dom_id(@card, :reacting)}") do
+      find(".reactions__trigger").click
+      fill_in "reaction_content", with: "Ship it!"
+      find(".reaction__submit-btn").click
+      assert_selector ".reaction", text: "Ship it!"
+    end
+
+    # Add an emoji reaction via the emoji picker menu
+    within("##{dom_id(@card, :reacting)}") do
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      assert_selector "dialog.reaction__popup[open]"
+      popup_width = page.evaluate_script("document.querySelector('.card-perma dialog.reaction__popup').getBoundingClientRect().width")
+      assert_operator popup_width, :>, 260, "Reaction emoji picker popup should not be constrained to 260px inside a card"
+      find(".reaction__emoji-btn[data-emoji='👍']").click
+      find(".reaction__submit-btn").click
+      assert_selector ".reaction", text: "👍"
+    end
+
+    # Board column preview shows boost count of 2
+    visit board_url(@card.board)
+    expand_column(@card.column)
+    within("##{dom_id(@card, :article)}") do
+      assert_selector ".card__boosts strong", text: "2"
+    end
+
+    # Delete both reactions from card detail view
+    visit card_url(@card)
+    within("##{dom_id(@card, :reacting)}") do
+      find(".reaction", text: "Ship it!").find("[data-reaction-delete-target='content']").click
+      find(".reaction.expanded .reaction__delete").click
+      assert_no_selector ".reaction", text: "Ship it!"
+
+      find(".reaction", text: "👍").find("[data-reaction-delete-target='content']").click
+      find(".reaction.expanded .reaction__delete").click
+      assert_no_selector ".reaction", text: "👍"
+    end
+
+    # Board column preview no longer shows boost count
+    visit board_url(@card.board)
+    expand_column(@card.column)
+    within("##{dom_id(@card, :article)}") do
+      assert_no_selector ".card__boosts"
+    end
+  end
+
+  test "card reactions cannot be deleted by another user" do
+    @card.reactions.create!(content: "🔥", reacter: users(:kevin))
+
+    visit card_url(@card)
+    within("##{dom_id(@card, :reacting)}") do
+      assert_selector ".reaction", text: "🔥"
+      assert_no_selector ".reaction--deleteable"
+      find(".reaction", text: "🔥").find("[data-reaction-delete-target='content']").click
+      assert_no_selector ".reaction.expanded"
+    end
+  end
+
+  test "comment reactions continue to work alongside card reactions" do
+    comment = comments(:logo_agreement_jz)
+
+    visit card_url(@card)
+    within("##{dom_id(comment, :reacting)}") do
+      find(".reactions__trigger").click
+      fill_in "reaction_content", with: "Agreed!"
+      find(".reaction__submit-btn").click
+      assert_selector ".reaction", text: "Agreed!"
+    end
+
+    within("##{dom_id(@card, :reacting)}") do
+      assert_no_selector ".reaction", text: "Agreed!"
+    end
+
+    # Comment reactions do not appear as card boost count
+    visit board_url(@card.board)
+    expand_column(@card.column)
+    within("##{dom_id(@card, :article)}") do
+      assert_no_selector ".card__boosts"
+    end
+  end
+
+  private
+    def expand_column(column)
+      column_el = find("##{dom_id(column)}")
+      column_el.find(".cards__expander").click if column_el[:class].include?("is-collapsed")
+    end
+end
