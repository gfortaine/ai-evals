+<% @page_title = "Account import" %>
+
+<section class="panel panel--centered flex flex-column gap">
+  <% if @import.completed? && @import.account %>
+    <h1 class="txt-x-large font-weight-black margin-none">Your account is ready</h1>
+    <p class="margin-none">
+      <strong><%= @import.account.name %></strong> has been imported with all of its boards, cards, comments, files, and people.
+    </p>
+    <%= link_to "Open #{@import.account.name}", root_url(script_name: @import.account.slug), class: "btn btn--link center" %>
+  <% elsif @import.failed? %>
+    <h1 class="txt-x-large font-weight-black txt-negative margin-none">Import failed</h1>
+    <p class="margin-none">We couldn’t complete your import, and nothing was left behind.</p>
+    <% if @import.failure_reason.present? %>
+      <p class="margin-none"><strong>Reason:</strong> <%= @import.failure_reason %></p>
+    <% end %>
+    <%= link_to "Try importing again", new_account_import_path(script_name: nil), class: "btn center" %>
+  <% else %>
