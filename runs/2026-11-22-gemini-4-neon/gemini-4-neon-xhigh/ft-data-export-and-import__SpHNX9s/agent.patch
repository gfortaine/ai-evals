+    tempfile.binmode
+    binary_data = (0..255).to_a.pack("C*") * 500
+
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("text.json", '{"hello":"world"}', compress: true)
+    writer.add_file("binary.bin", binary_data, compress: false)
+    writer.add_file("empty_deflated.txt", "", compress: true)
+    writer.add_file("empty_stored.txt", "", compress: false)
+    writer.close
+
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+
+    assert_equal [ "text.json", "binary.bin", "empty_deflated.txt", "empty_stored.txt" ].sort, reader.entries.sort
+    assert reader.exists?("text.json")
