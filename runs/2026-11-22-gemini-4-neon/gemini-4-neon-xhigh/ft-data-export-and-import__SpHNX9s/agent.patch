index 0000000..d3e1d5f
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,242 @@
+class Account::Import < ApplicationRecord
+  CLEANUP_MODELS = [
+    ::ActionText::RichText,
+    ::ActiveStorage::Attachment,
+    ::ActiveStorage::VariantRecord,
+    ::ActiveStorage::Blob,
+    ::Webhook::Delivery,
+    ::Notification::Bundle,
+    ::Notification,
+    ::Event,
+    ::Webhook::DelinquencyTracker,
+    ::Filter,
+    ::Mention,
+    ::Reaction,
+    ::Pin,
+    ::Watch,
+    ::Card::ActivitySpike,
+    ::Card::NotNow,
+    ::Card::Goldness,
+    ::Closure,
+    ::Tagging,
+    ::Assignment,
+    ::Step,
+    ::Comment,
+    ::Card,
+    ::Access,
+    ::Webhook,
+    ::Board::Publication,
+    ::Entropy,
+    ::Column,
+    ::Board,
+    ::Tag,
+    ::User::Settings,
+    ::User,
+    ::Account::JoinCode,
+    ::Account::Cancellation,
+    ::Export,
+    ::Search::Query,
+    ::Push::Subscription
+  ].freeze
+
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  validate :file_must_be_attached, on: :create
+
+  def accessible_to?(_accessor)
+    false
+  end
+
+  def process_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def process_now
+    return unless pending?
+
+    Current.without_account do
+      processing!
+
+      unless file.attached?
+        fail_with("No export file was attached.")
+        return
+      end
+
+      context = Account::DataTransfer::ImportContext.new
+
+      begin
+        ZipFile.read_from(file) do |zip|
+          Account::DataTransfer::Manifest.new.import(from: zip, context: context)
+        end
+
+        finalize_imported_account(context.account)
+
+        update!(status: :completed, account: context.account)
+        purge_uploaded_file
+        Account::ImportMailer.completed(self).deliver_later
+      rescue ZipFile::InvalidError, Account::DataTransfer::Error => e
+        cleanup_failed_import(context)
+        fail_with(e.message)
+      rescue ActiveStorage::IntegrityError
+        cleanup_failed_import(context)
+        fail_with("An attachment file in the archive failed checksum verification and appears to be corrupted.")
+      rescue StandardError => e
+        Rails.error.report(e, context: { account_import_id: id, identity_id: identity_id })
+        cleanup_failed_import(context)
+        fail_with("An unexpected error occurred while importing your account.")
+      end
+    end
+  end
+
+  private
+    def file_must_be_attached
+      errors.add(:file, "must be selected") unless file.attached?
+    end
+
+    def finalize_imported_account(imported_account)
+      sync_cards_count(imported_account)
+      ensure_importer_access(imported_account)
+
+      Current.with_account(imported_account) do
+        reindex_search(imported_account)
+        reconcile_storage(imported_account)
+      end
+    end
+
+    def sync_cards_count(imported_account)
+      max_number = imported_account.cards.maximum(:number) || 0
+      imported_account.update_column(:cards_count, max_number) if imported_account.cards_count < max_number
+    end
+
+    def ensure_importer_access(imported_account)
+      existing_user = imported_account.users.find_by(identity_id: identity.id)
+
+      if existing_user.nil?
+        display_name = identity.users.where(active: true).pick(:name) || identity.email_address
+        new_user = imported_account.users.create!(
+          identity: identity,
+          name: display_name,
+          role: :admin,
+          active: true,
+          verified_at: Time.current
+        )
+        grant_board_accesses(imported_account, new_user)
+      elsif !existing_user.active?
+        existing_user.update!(active: true, verified_at: existing_user.verified_at || Time.current)
+        grant_board_accesses(imported_account, existing_user)
+      end
+    end
+
+    def grant_board_accesses(imported_account, user)
+      now = Time.current
+      rows = imported_account.boards.pluck(:id).map do |board_id|
+        {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: imported_account.id,
+          board_id: board_id,
+          user_id: user.id,
+          involvement: "access_only",
+          created_at: now,
+          updated_at: now
+        }
+      end
+      Access.insert_all(rows) if rows.any?
+    end
+
+    def reindex_search(imported_account)
+      imported_account.cards.published.includes(:rich_text_description).find_each(&:reindex)
+
+      Comment.where(account_id: imported_account.id)
+        .joins(:card).merge(Card.published)
+        .includes(:rich_text_body, :card)
+        .find_each(&:reindex)
+    end
+
+    def reconcile_storage(imported_account)
+      imported_account.boards.find_each do |board|
+        board.reconcile_storage
+        board.materialize_storage
+      end
+
+      imported_account.reconcile_storage
+      imported_account.materialize_storage
+    end
+
+    def cleanup_failed_import(context)
+      delete_uploaded_files(context)
+      delete_imported_account_data(context.account) if context.account
+      delete_created_identities(context.created_identity_ids)
+      purge_uploaded_file
+      context.account = nil
+    end
+
+    def delete_uploaded_files(context)
+      deleted_keys = Set.new
+
+      context.uploaded_files.each do |service, key|
+        next if deleted_keys.include?(key)
+
+        service.delete(key)
+        deleted_keys.add(key)
+      rescue StandardError
+        nil
+      end
+
+      if context.account
+        ActiveStorage::Blob.where(account_id: context.account.id).find_each do |blob|
+          next if deleted_keys.include?(blob.key)
+
+          blob.service.delete(blob.key)
+          deleted_keys.add(blob.key)
+        rescue StandardError
+          nil
+        end
+      end
+    end
+
+    def delete_imported_account_data(imported_account)
+      account_id = imported_account.id
+
+      Search::Record.for(account_id).where(account_id: account_id).delete_all
+      Storage::Entry.where(account_id: account_id).delete_all
+
+      board_ids = Board.where(account_id: account_id).pluck(:id)
+      Storage::Total.where(owner_type: "Account", owner_id: account_id).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: board_ids).delete_all if board_ids.any?
+
+      filter_ids = Filter.where(account_id: account_id).pluck(:id)
+      if filter_ids.any?
+        Account::DataTransfer::FilterRecordSet::JOIN_ASSOCIATIONS.each_value do |config|
+          config[:model].where(filter_id: filter_ids).delete_all
+        end
+      end
+
+      CLEANUP_MODELS.each do |model|
+        model.where(account_id: account_id).delete_all
+      end
+
+      Account.where(id: account_id).delete_all
+    end
+
+    def delete_created_identities(identity_ids)
+      return if identity_ids.blank?
+
+      Identity.where(id: identity_ids).where.missing(:users).delete_all
+    end
+
+    def purge_uploaded_file
+      file.purge if file.attached?
+    rescue StandardError
+      nil
+    end
+
+    def fail_with(reason)
+      update!(status: :failed, account: nil, failure_reason: reason)
+      Account::ImportMailer.failed(self).deliver_later
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
