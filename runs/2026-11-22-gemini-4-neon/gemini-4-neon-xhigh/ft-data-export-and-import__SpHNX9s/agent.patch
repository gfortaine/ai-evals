+++ b/test/models/account/export_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+    @member = users(:david)
+  end
+
+  test "build_now creates zip attachment, completes export, and emails admin" do
+    export = @account.account_exports.create!(user: @admin)
+
+    assert_enqueued_emails 1 do
+      export.build_now
+    end
+
+    export.reload
+    assert export.completed?
+    assert_not_nil export.completed_at
+    assert export.ready?
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+
+    ZipFile.read_from(export.file) do |zip|
+      assert zip.exists?("manifest.json")
+      assert zip.glob("data/accounts/*.json").any?
+      assert zip.glob("data/boards/*.json").any?
+      assert zip.glob("data/cards/*.json").any?
+      assert zip.glob("data/users/*.json").any?
+    end
+  end
+
+  test "accessible_to? enforces admin ownership and 1-day expiration" do
+    export = @account.account_exports.create!(user: @admin)
+    export.build_now
+
+    assert export.accessible_to?(@admin)
+    assert_not export.accessible_to?(@member)
+    assert_not export.accessible_to?(users(:jason))
+    assert_not export.accessible_to?(nil)
+
+    travel 23.hours do
+      assert export.accessible_to?(@admin)
+      assert_not export.expired?
+    end
+
+    travel 25.hours do
+      assert export.expired?
+      assert_not export.ready?
+      assert_not export.accessible_to?(@admin)
+    end
+  end
+
+  test "Export.cleanup destroys expired exports and keeps recent ones" do
+    recent = @account.account_exports.create!(user: @admin)
+    recent.build_now
+
+    expired = @account.account_exports.create!(user: @admin)
+    expired.build_now
+    expired.update!(completed_at: 25.hours.ago)
+
+    assert_difference -> { Export.count }, -1 do
+      Export.cleanup
+    end
+
+    assert Export.exists?(recent.id)
+    assert_not Export.exists?(expired.id)
+  end
+
+  test "account incineration removes account exports and their blobs" do
+    account = accounts(:initech)
+    user = users(:mike)
+
+    Current.with_account(account) do
+      export = account.account_exports.create!(user: user)
+      export.build_now
+      assert Export.where(account_id: account.id).exists?
+
+      perform_enqueued_jobs
+      account.incinerate
+      perform_enqueued_jobs
+
+      assert_empty Export.where(account_id: account.id)
+      assert_empty ActiveStorage::Blob.where(account_id: account.id)
+    end
+  end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..572f141
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,294 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @source_account = accounts(:"37s")
+    @david = users(:david)
+    @identity = @david.identity
+  end
+
+  test "imports a full account export into a new account with search and storage reconciled and sends completion email" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "logo-img.jpg", content_type: "image/jpeg")
+    card.update!(description: "<p>Unique searchable zebra phrase</p>")
+
+    new_person_identity = Identity.create!(email_address: "newcomer@example.com")
+    @source_account.users.create!(identity: new_person_identity, name: "Newcomer", role: :member, verified_at: Time.current)
+
+    export_bytes = build_account_export_zip(@source_account)
+
+    # Remove newcomer's identity before import to prove import recreates missing identities
+    @source_account.users.where(identity: new_person_identity).delete_all
+    new_person_identity.delete
+
+    import = create_import_from_bytes(@identity, export_bytes)
+    uploaded_zip_key = import.file.blob.key
+
+    assert_enqueued_emails 1 do
+      import.process_now
+    end
+
+    import.reload
+    assert import.completed?
+    assert_not_nil import.account
+    assert_not_equal @source_account.id, import.account.id
+    assert_not import.file.attached?, "Uploaded import ZIP should be purged after completion"
+    assert_not ActiveStorage::Blob.service.exist?(uploaded_zip_key)
+
+    imported = import.account
+    assert_equal @source_account.name, imported.name
+    assert_equal @source_account.boards.count, imported.boards.count
+    assert_equal @source_account.cards.count, imported.cards.count
+    assert_equal Comment.where(account_id: @source_account.id).count, Comment.where(account_id: imported.id).count
+
+    # Recreated identity for people in the account
+    recreated_identity = Identity.find_by(email_address: "newcomer@example.com")
+    assert_not_nil recreated_identity
+    assert imported.users.exists?(identity: recreated_identity, name: "Newcomer")
+
+    # Importer already in account -> no duplicate user
+    assert_equal 1, imported.users.where(identity: @identity).count
+
+    # Attached files work
+    imported_card = imported.cards.find_by!(number: card.number)
+    assert imported_card.image.attached?
+    assert_equal file_fixture("moon.jpg").binread, imported_card.image.download
+
+    # Full-text search works immediately on the imported account
+    imported_david = imported.users.find_by!(identity: @identity)
+    results = Search::Record.for(imported.id).search("zebra", user: imported_david)
+    assert_includes results.map(&:card), imported_card
+
+    # Storage total is reconciled
+    assert_equal file_fixture("moon.jpg").size, imported.bytes_used
+
+    # Creating a new card in the imported account gets the next card number cleanly
+    Current.with_account(imported) do
+      Current.session = Session.new(identity: @identity)
+      new_card = imported.boards.first.cards.create!(title: "Post-import card", creator: imported_david, status: :published)
+      assert_operator new_card.number, :>, imported_card.number
+    end
+  end
+
+  test "grants admin access when importing as an identity not present in the export" do
+    export_bytes = build_account_export_zip(@source_account)
+    outsider = Identity.create!(email_address: "outsider@example.com")
+
+    import = create_import_from_bytes(outsider, export_bytes)
+    import.process_now
+
+    import.reload
+    assert import.completed?
+
+    outsider_user = import.account.users.find_by(identity: outsider)
+    assert_not_nil outsider_user
+    assert outsider_user.admin?
+    assert outsider_user.active?
+    assert_equal import.account.boards.count, outsider_user.boards.count
+  end
+
+  test "non-zip file fails with clear email and leaves nothing behind" do
+    snapshot = database_snapshot
+
+    import = create_import_from_bytes(@identity, "this is plain text, not a zip", filename: "bad.zip")
+    uploaded_zip_key = import.file.blob.key
+
+    assert_enqueued_emails 1 do
+      import.process_now
+    end
+
+    import.reload
+    assert import.failed?
+    assert_nil import.account_id
+    assert_match /Invalid ZIP archive/, import.failure_reason
+    assert_not import.file.attached?
+    assert_not ActiveStorage::Blob.service.exist?(uploaded_zip_key)
+    assert_equal snapshot, database_snapshot
+  end
+
+  test "uploading a user data export zip instead of an account export fails cleanly and leaves nothing behind" do
+    user_export = @david.data_exports.create!(account: @source_account)
+    user_export.build_now
+    user_export_bytes = user_export.file.download
+
+    snapshot = database_snapshot
+    import = create_import_from_bytes(@identity, user_export_bytes)
+    uploaded_zip_key = import.file.blob.key
+
+    assert_enqueued_emails 1 do
+      import.process_now
+    end
+
+    import.reload
+    assert import.failed?
+    assert_nil import.account_id
+    assert_match /not a valid Fizzy account export/, import.failure_reason
+    assert_not ActiveStorage::Blob.service.exist?(uploaded_zip_key)
+    assert_equal snapshot, database_snapshot
+  end
+
+  test "missing attachment file mid-import rolls back all records, identities, and previously uploaded files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "first.jpg", content_type: "image/jpeg")
+    card2 = cards(:layout)
+    card2.image.attach(io: file_fixture("avatar.png").open, filename: "second.png", content_type: "image/png")
+
+    # Add a brand-new person whose identity will be created during UserRecordSet before FileRecordSet fails
+    temp_identity = Identity.create!(email_address: "ephemeral-person@example.com")
+    @source_account.users.create!(identity: temp_identity, name: "Ephemeral", role: :member)
+
+    good_bytes = build_account_export_zip(@source_account)
+
+    # Remove temp_identity so import will have to create it
+    @source_account.users.where(identity: temp_identity).delete_all
+    temp_identity.delete
+
+    # Rebuild the ZIP omitting one storage file so the first file uploads and the second fails!
+    broken_bytes = strip_zip_entry(good_bytes, "storage/#{card2.image.blob.id}")
+
+    snapshot = database_snapshot
+    import = create_import_from_bytes(@identity, broken_bytes)
+    uploaded_zip_key = import.file.blob.key
+
+    uploaded_keys = []
+    original_upload = ActiveStorage::Blob.service.method(:upload)
+    ActiveStorage::Blob.service.define_singleton_method(:upload) do |key, *args, **kwargs|
+      uploaded_keys << key
+      original_upload.call(key, *args, **kwargs)
+    end
+
+    begin
+      assert_enqueued_emails 1 do
+        import.process_now
+      end
+    ensure
+      ActiveStorage::Blob.service.singleton_class.remove_method(:upload)
+    end
+
+    import.reload
+    assert import.failed?
+    assert_nil import.account_id
+    assert_match /Missing attachment file for second\.png/, import.failure_reason
+    assert_not Identity.exists?(email_address: "ephemeral-person@example.com")
+    assert_not ActiveStorage::Blob.service.exist?(uploaded_zip_key)
+    assert_not_empty uploaded_keys, "Expected at least one file to have been uploaded before failing"
+    uploaded_keys.each do |key|
+      assert_not ActiveStorage::Blob.service.exist?(key), "Uploaded file #{key} should have been deleted on rollback"
+    end
+    assert_equal snapshot, database_snapshot
+  end
+
+  test "corrupted JSON mid-import rolls back everything and emails failure reason" do
+    good_bytes = build_account_export_zip(@source_account)
+    broken_bytes = replace_zip_entry(good_bytes, "data/cards/000001.json", "{not valid json!!!")
+
+    snapshot = database_snapshot
+    import = create_import_from_bytes(@identity, broken_bytes)
+    uploaded_zip_key = import.file.blob.key
+
+    assert_enqueued_emails 1 do
+      import.process_now
+    end
+
+    import.reload
+    assert import.failed?
+    assert_nil import.account_id
+    assert_match /Invalid JSON/, import.failure_reason
+    assert_not ActiveStorage::Blob.service.exist?(uploaded_zip_key)
+    assert_equal snapshot, database_snapshot
+  end
+
+  test "corrupted attachment bytes fail integrity check and leave nothing behind" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "corrupt.jpg", content_type: "image/jpeg")
+
+    good_bytes = build_account_export_zip(@source_account)
+    broken_bytes = replace_zip_entry(good_bytes, "storage/#{card.image.blob.id}", "totally wrong bytes")
+
+    snapshot = database_snapshot
+    import = create_import_from_bytes(@identity, broken_bytes)
+    uploaded_zip_key = import.file.blob.key
+
+    assert_enqueued_emails 1 do
+      import.process_now
+    end
+
+    import.reload
+    assert import.failed?
+    assert_nil import.account_id
+    assert_match /checksum/i, import.failure_reason
+    assert_not ActiveStorage::Blob.service.exist?(uploaded_zip_key)
+    assert_equal snapshot, database_snapshot
+  end
+
+  private
+    def build_account_export_zip(account)
+      buf = StringIO.new("".b)
+      writer = ZipFile::Writer.new(buf)
+      Account::DataTransfer::Manifest.new(account).export(to: writer)
+      writer.close
+      buf.string
+    end
+
+    def create_import_from_bytes(identity, bytes, filename: "export.zip")
+      Current.without_account do
+        identity.account_imports.create!(
+          file: { io: StringIO.new(bytes), filename: filename, content_type: "application/zip" }
+        )
+      end
+    end
+
+    def strip_zip_entry(zip_bytes, excluded_path)
+      reader = ZipFile::Reader.new(StringIO.new(zip_bytes))
+      out = StringIO.new("".b)
+      writer = ZipFile::Writer.new(out)
+
+      reader.entries.each do |entry|
+        next if entry == excluded_path
+
+        writer.add_file(entry, reader.read(entry), compress: !entry.start_with?("storage/"))
+      end
+
+      writer.close
+      out.string
+    end
+
+    def replace_zip_entry(zip_bytes, target_path, replacement)
+      reader = ZipFile::Reader.new(StringIO.new(zip_bytes))
+      out = StringIO.new("".b)
+      writer = ZipFile::Writer.new(out)
+
+      reader.entries.each do |entry|
+        content = (entry == target_path) ? replacement : reader.read(entry)
+        writer.add_file(entry, content, compress: !entry.start_with?("storage/"))
+      end
+
+      writer.close
+      out.string
+    end
+
+    def database_snapshot
+      {
+        accounts: Account.count,
+        users: User.count,
+        identities: Identity.count,
+        boards: Board.count,
+        columns: Column.count,
+        cards: Card.count,
+        comments: Comment.count,
+        tags: Tag.count,
+        accesses: Access.count,
+        entropies: Entropy.count,
+        filters: Filter.count,
+        events: Event.count,
+        rich_texts: ActionText::RichText.count,
+        blobs: ActiveStorage::Blob.count,
+        attachments: ActiveStorage::Attachment.count,
+        variants: ActiveStorage::VariantRecord.count,
+        storage_entries: Storage::Entry.count,
+        storage_totals: Storage::Total.count
+      }
+    end
+end
