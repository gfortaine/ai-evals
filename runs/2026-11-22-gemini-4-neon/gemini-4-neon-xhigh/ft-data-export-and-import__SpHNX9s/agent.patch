diff --git a/app/mailers/export_mailer.rb b/app/mailers/export_mailer.rb
new file mode 100644
index 0000000..3837066
--- /dev/null
+++ b/app/mailers/export_mailer.rb
@@ -0,0 +1,25 @@
+class ExportMailer < ApplicationMailer
+  def completed(export)
+    @export = export
+    @user = export.user
+    @account = export.account
+    @download_url = download_url_for(export)
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your Fizzy data export is ready to download"
+    )
+  end
+
+  private
+    def download_url_for(export)
+      case export
+      when Account::Export
+        account_export_url(export, script_name: export.account.slug)
+      when User::DataExport
+        user_data_export_url(export.user, export, script_name: export.account.slug)
+      else
+        raise ArgumentError, "Unknown export type: #{export.class.name}"
+      end
+    end
+end
