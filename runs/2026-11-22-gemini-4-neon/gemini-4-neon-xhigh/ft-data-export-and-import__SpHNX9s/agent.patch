@@ -0,0 +1,224 @@
+require "test_helper"
+
+class Account::DataTransferTest < ActiveSupport::TestCase
+  test "id mapper is bijective, preserves UUIDv7 ordering, and rejects invalid UUIDs" do
+    mapper = Account::DataTransfer::IdMapper.new
+
+    id1 = ActiveRecord::Type::Uuid.generate
+    sleep 0.002
+    id2 = ActiveRecord::Type::Uuid.generate
+
+    mapped1 = mapper.map(id1)
+    mapped2 = mapper.map(id2)
+
+    assert_not_equal id1, mapped1
+    assert_not_equal id2, mapped2
+    assert_not_equal mapped1, mapped2
+    assert_equal id1, mapper.unmap(mapped1)
+    assert_equal id2, mapper.unmap(mapped2)
+    assert_operator mapped1, :<, mapped2
+    assert_nil mapper.map(nil)
+
+    assert_raises Account::DataTransfer::InvalidDataError do
+      mapper.map("not-a-valid-uuid!")
+    end
+  end
+
+  test "full account export and import preserves all domain records, files, filters, events, and colors" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    david = users(:david)
+    jz = users(:jz)
+    card = cards(:logo)
+
+    Current.account = account
+    Current.session = Session.new(identity: david.identity)
+
+    # Add rich domain records so every table is exercised
+    board.update!(public_description: "<p>Public board info</p>")
+    board.publish
+    board.update!(auto_postpone_period_in_days: 7)
+
+    column = board.columns.create!(name: "QA Review", color: Color::COLORS[4].value, position: 5)
+    card.update!(column: column)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "header.jpg", content_type: "image/jpeg")
+
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "diagram.png",
+      content_type: "image/png"
+    )
+    card.update!(description: "<p>See #{ActionText::Attachment.from_attachable(embed_blob).to_html}</p>")
+    card.steps.create!(content: "First step", completed: true)
+    card.gild
+    card.reactions.create!(reacter: david, content: "👍")
+
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("report pdf bytes"),
+      filename: "report.pdf",
+      content_type: "application/pdf"
+    )
+    comment = card.comments.create!(
+      creator: jz,
+      body: "<p>Attached #{ActionText::Attachment.from_attachable(comment_blob).to_html}</p>"
+    )
+    comment.reactions.create!(reacter: david, content: "🎉")
+
+    david.avatar.attach(io: file_fixture("avatar.png").open, filename: "david.png", content_type: "image/png")
+    david.create_settings!(bundle_email_frequency: :daily, timezone_name: "America/Chicago")
+
+    # Deactivated user without identity
+    deactivated = account.users.create!(name: "Former Employee", role: :member, active: false, identity: nil)
+
+    webhook = board.webhooks.create!(name: "CI Hook", url: "https://example.com/hook", subscribed_actions: %w[ card_closed ])
+    assign_event = board.events.create!(
+      action: "card_assigned",
+      creator: david,
+      eventable: card,
+      particulars: { assignee_ids: [ jz.id ] }
+    )
+
+    # Create an internal export blob that must NOT be exported recursively
+    existing_export = account.account_exports.create!(user: david)
+    existing_export.file.attach(io: StringIO.new("old export zip"), filename: "old.zip", content_type: "application/zip")
+
+    # Export to zip
+    tempfile = Tempfile.new([ "account_export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Manifest.new(account).export(to: writer)
+    writer.close
+
+    # Import into a NEW account on the same instance (no collisions!)
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+    context = Account::DataTransfer::ImportContext.new
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      Account::DataTransfer::Manifest.new.import(from: reader, context: context)
+    end
+
+    imported = context.account
+    assert_not_nil imported
+    assert_not_equal account.id, imported.id
+    assert_not_equal account.external_account_id, imported.external_account_id
+    assert_equal account.name, imported.name
+    assert_equal account.cards_count, imported.cards_count
+    assert_not_nil imported.join_code
+
+    # People & settings & avatars
+    assert_equal account.users.count, imported.users.count
+    imported_david = imported.users.find_by!(name: david.name)
+    assert_equal david.identity_id, imported_david.identity_id
+    assert imported_david.avatar.attached?
+    assert_equal file_fixture("avatar.png").binread, imported_david.avatar.download
+    assert imported_david.avatar.variant(:thumb).processed?
+    assert_equal "daily", imported_david.settings.bundle_email_frequency
+    assert_equal "America/Chicago", imported_david.settings.timezone_name
+
+    imported_deactivated = imported.users.find_by!(name: "Former Employee")
+    assert_not imported_deactivated.active?
+    assert_nil imported_deactivated.identity_id
+
+    # Boards, columns (raw CSS color!), entropy, publication
+    assert_equal account.boards.count, imported.boards.count
+    imported_board = imported.boards.find_by!(name: board.name)
+    assert_equal "<p>Public board info</p>", imported_board.public_description.body.to_html
+    assert imported_board.published?
+    assert_not_equal board.publication.key, imported_board.publication.key
+    assert_equal 7, imported_board.entropy.auto_postpone_period_in_days
+
+    imported_col = imported_board.columns.find_by!(name: "QA Review")
+    assert_equal Color::COLORS[4], imported_col.color
+    assert_equal Color::COLORS[4].value, imported_col[:color]
+
+    # Cards, steps, tags, goldness, reactions, images, comments, attachments
+    assert_equal account.cards.count, imported.cards.count
+    imported_card = imported.cards.find_by!(number: card.number)
+    assert_equal card.title, imported_card.title
+    assert_equal imported_col, imported_card.column
+    assert imported_card.golden?
+    assert_equal [ "First step" ], imported_card.steps.pluck(:content)
+    assert_equal card.reactions.pluck(:content).sort, imported_card.reactions.pluck(:content).sort
+    assert imported_card.image.attached?
+    assert_equal file_fixture("moon.jpg").binread, imported_card.image.download
+    assert_not_equal card.image.blob.key, imported_card.image.blob.key
+
+    imported_embed = imported_card.rich_text_description.embeds.first
+    assert_not_nil imported_embed
+    assert_equal "diagram.png", imported_embed.filename.to_s
+    assert_equal file_fixture("avatar.png").binread, imported_embed.download
+
+    imported_comment = imported_card.comments.find { |c| c.body.to_plain_text.include?("Attached") }
+    assert_not_nil imported_comment
+    assert_equal [ "🎉" ], imported_comment.reactions.pluck(:content)
+    imported_comment_file = imported_comment.rich_text_body.embeds.first
+    assert_equal "report.pdf", imported_comment_file.filename.to_s
+    assert_equal "report pdf bytes", imported_comment_file.download
+
+    # Webhooks
+    imported_webhook = imported_board.webhooks.find_by!(name: "CI Hook")
+    assert_equal %w[ card_closed ], imported_webhook.subscribed_actions
+    assert_not_nil imported_webhook.delinquency_tracker
+
+    # Events with remapped assignee_ids
+    imported_jz = imported.users.find_by!(name: jz.name)
+    imported_assign_event = imported_board.events.find_by!(action: "card_assigned", eventable: imported_card)
+    assert_equal [ imported_jz.id ], imported_assign_event.assignee_ids
+    assert_equal [ imported_jz ], imported_assign_event.assignees.to_a
+
+    # Filters & HABTM join tables
+    original_filter = filters(:jz_assignments)
+    imported_filter = Filter.find_by!(account_id: imported.id, creator_id: imported_david.id)
+    assert_equal [ imported_jz ], imported_filter.assignees.to_a
+    assert_equal original_filter.tags.pluck(:title), imported_filter.tags.pluck(:title)
+
+    # Internal export blob was excluded
+    assert_not ActiveStorage::Blob.where(account_id: imported.id, filename: "old.zip").exists?
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  test "rejects tampered cross-account records during import" do
+    account = accounts(:"37s")
+    other_account = accounts(:initech)
+
+    buf = StringIO.new("".b)
+    writer = ZipFile::Writer.new(buf)
+    writer.add_file("manifest.json", JSON.generate(format: Account::DataTransfer::FORMAT, version: 1))
+    writer.add_file("data/accounts/000001.json", JSON.generate([ account.attributes.as_json ]))
+    tampered_tag = Tag.new(
+      id: ActiveRecord::Type::Uuid.generate,
+      account_id: other_account.id,
+      title: "injected",
+      created_at: Time.current,
+      updated_at: Time.current
+    )
+    writer.add_file("data/tags/000001.json", JSON.generate([ tampered_tag.attributes.as_json ]))
+    writer.close
+
+    reader = ZipFile::Reader.new(StringIO.new(buf.string))
+    context = Account::DataTransfer::ImportContext.new
+
+    error = assert_raises Account::DataTransfer::InvalidDataError do
+      Account::DataTransfer::Manifest.new.import(from: reader, context: context)
+    end
+
+    assert_match /does not belong to the exported account/, error.message
+  end
+
+  test "rejects unsupported export format version" do
+    buf = StringIO.new("".b)
+    writer = ZipFile::Writer.new(buf)
+    writer.add_file("manifest.json", JSON.generate(format: Account::DataTransfer::FORMAT, version: 999))
+    writer.close
+
+    reader = ZipFile::Reader.new(StringIO.new(buf.string))
+    context = Account::DataTransfer::ImportContext.new
+
+    assert_raises Account::DataTransfer::UnsupportedVersionError do
+      Account::DataTransfer::Manifest.new.import(from: reader, context: context)
+    end
+  end
+end
diff --git a/test/models/account/export_test.rb b/test/models/account/export_test.rb
new file mode 100644
