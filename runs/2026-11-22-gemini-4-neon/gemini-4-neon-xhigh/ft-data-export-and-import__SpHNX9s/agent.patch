 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @david = users(:david)
+    @jz = users(:jz)
+    Current.session = Session.new(identity: @david.identity)
+  end
+
+  test "exports and re-imports rich text with user mentions, blob embeds, and external attachments" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    mention_html = ActionText::Attachment.from_attachable(@jz).to_html
+    blob_html = ActionText::Attachment.from_attachable(blob).to_html
+    external_html = '<action-text-attachment url="https://videos.37signals.com/demo.mp4" content-type="video/mp4" filename="demo.mp4"></action-text-attachment>'
+
+    card = @board.cards.create!(
+      title: "Rich text card",
+      creator: @david,
+      status: :published,
+      description: "<p>Hey #{mention_html} check #{blob_html} and #{external_html}</p>"
+    )
+
+    tempfile = Tempfile.new([ "rt", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Manifest.new(@account).export(to: writer)
+    writer.close
+
+    # Verify exported HTML uses portable unsigned gid instead of instance-specific sgid
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+    rich_text_entries = reader.glob("data/action_text_rich_texts/*.json")
+    exported_records = rich_text_entries.flat_map { |p| JSON.parse(reader.read(p)) }
+    exported_card_rt = exported_records.find { |r| r["record_type"] == "Card" && r["record_id"] == card.id }
+
+    assert_not_nil exported_card_rt
+    assert_includes exported_card_rt["body"], "gid://fizzy/User/#{@jz.id}"
+    assert_includes exported_card_rt["body"], "gid://fizzy/ActiveStorage::Blob/#{blob.id}"
+    assert_not_includes exported_card_rt["body"], 'sgid="'
+    assert_includes exported_card_rt["body"], "https://videos.37signals.com/demo.mp4"
+
+    # Import into a new account
+    context = Account::DataTransfer::ImportContext.new
+    Account::DataTransfer::Manifest.new.import(from: reader, context: context)
+
+    new_account = context.account
+    new_card = new_account.cards.find_by!(title: "Rich text card")
+    new_jz = new_account.users.find_by!(name: @jz.name)
+    new_blob = ActiveStorage::Blob.where(account_id: new_account.id, filename: "moon.jpg").first!
+
+    assert_not_equal @jz.id, new_jz.id
+    assert_not_equal blob.id, new_blob.id
+
+    attachables = new_card.description.body.attachables
+    assert_includes attachables, new_jz
+    assert_includes attachables, new_blob
+
+    # Blob attachment url should point to the new account slug
+    fragment = Nokogiri::HTML::DocumentFragment.parse(new_card.description.body.to_html)
+    blob_node = fragment.css("action-text-attachment").find { |n| n["filename"] == "moon.jpg" }
+    assert_not_nil blob_node
+    assert_includes blob_node["url"], new_account.slug
+    assert_nil blob_node["gid"]
+
+    # External video preserved verbatim
+    ext_node = fragment.css("action-text-attachment").find { |n| n["filename"] == "demo.mp4" }
+    assert_equal "https://videos.37signals.com/demo.mp4", ext_node["url"]
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  test "re-signs attachments even when importing with a different SignedGlobalID verifier secret" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "cross-instance.jpg",
+      content_type: "image/jpeg"
+    )
+
+    card = @board.cards.create!(
+      title: "Cross instance card",
+      creator: @david,
+      status: :published,
+      description: "<p>#{ActionText::Attachment.from_attachable(@jz).to_html} #{ActionText::Attachment.from_attachable(blob).to_html}</p>"
+    )
+
+    tempfile = Tempfile.new([ "cross", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Manifest.new(@account).export(to: writer)
+    writer.close
+
+    # Simulate a second Fizzy instance with a completely different secret key!
+    original_verifier = SignedGlobalID.verifier
+    different_verifier = ActiveSupport::MessageVerifier.new("completely-different-instance-secret-key")
+
+    begin
+      SignedGlobalID.verifier = different_verifier
+
+      tempfile.rewind
+      reader = ZipFile::Reader.new(tempfile)
+      context = Account::DataTransfer::ImportContext.new
+      Account::DataTransfer::Manifest.new.import(from: reader, context: context)
+
+      new_card = context.account.cards.find_by!(title: "Cross instance card")
+      new_jz = context.account.users.find_by!(name: @jz.name)
+      new_blob = ActiveStorage::Blob.where(account_id: context.account.id, filename: "cross-instance.jpg").first!
+
+      attachables = new_card.description.body.attachables
+      assert_includes attachables, new_jz
+      assert_includes attachables, new_blob
+    ensure
+      SignedGlobalID.verifier = original_verifier
+    end
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
 end
