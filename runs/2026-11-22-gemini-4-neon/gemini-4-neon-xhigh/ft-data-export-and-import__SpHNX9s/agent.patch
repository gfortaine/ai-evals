+<% @page_title = "Import a Fizzy account" %>
+
+<section class="panel panel--centered flex flex-column gap">
+  <h1 class="txt-x-large font-weight-black txt-tight-lines margin-none"><%= @page_title %></h1>
+  <p class="margin-none">Upload a Fizzy account export (.zip) to create a new account with all of its boards, cards, comments, files, and people.</p>
+
+  <%= form_with model: @import, url: account_imports_path(script_name: nil), class: "flex flex-column gap", data: { turbo: false } do |form| %>
+    <% if @import.errors.any? %>
+      <div class="txt-negative txt-small txt-align-start">
+        <p class="margin-block-none font-weight-bold">Your import couldn’t be started:</p>
+        <ul class="margin-block-none">
+          <% @import.errors.full_messages.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <%= form.file_field :file, accept: ".zip,application/zip", required: true, direct_upload: true, class: "input" %>
+
+    <button type="submit" class="btn btn--link center">
+      <span>Start import</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small txt-tinted margin-none">
+    We’ll email you at <strong><%= Current.identity.email_address %></strong> when your new account is ready.
+  </p>
+</section>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
