+
+    assert_equal '{"hello":"world"}', reader.read("text.json")
+    assert_equal binary_data, reader.read("binary.bin")
+    assert_equal "", reader.read("empty_deflated.txt")
+    assert_equal "", reader.read("empty_stored.txt")
+
+    assert_raises ZipFile::EntryNotFound do
+      reader.read("missing.txt")
+    end
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  test "reader streams via EntryIO with IO.copy_stream and rewind" do
+    tempfile = Tempfile.new([ "test", ".zip" ])
+    tempfile.binmode
+    payload = SecureRandom.random_bytes(200_000)
+
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("large.bin", payload, compress: false)
+    writer.add_file("large_deflated.txt", "abcdefgh" * 50_000, compress: true)
+    writer.close
+
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+
+    reader.open("large.bin") do |io|
+      assert_equal payload.bytesize, io.size
+      out = StringIO.new("".b)
+      IO.copy_stream(io, out)
+      assert_equal payload, out.string
+
+      io.rewind
+      out2 = StringIO.new("".b)
+      IO.copy_stream(io, out2)
+      assert_equal payload, out2.string
+    end
+
+    reader.open("large_deflated.txt") do |io|
+      out = StringIO.new("".b)
+      IO.copy_stream(io, out)
