+++ b/app/models/export.rb
@@ -0,0 +1,77 @@
+class Export < ApplicationRecord
+  EXPORT_EXPIRATION = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  scope :expired, -> do
+    where(completed_at: ...EXPORT_EXPIRATION.ago)
+      .or(where(completed_at: nil, created_at: ...EXPORT_EXPIRATION.ago))
+  end
+  scope :current, -> { completed.where(completed_at: EXPORT_EXPIRATION.ago..) }
+
+  class << self
+    def cleanup
+      expired.find_each(&:destroy)
+    end
+  end
+
+  def expired?
+    if completed_at.present?
+      completed_at < EXPORT_EXPIRATION.ago
+    else
+      created_at < EXPORT_EXPIRATION.ago
+    end
+  end
+
+  def ready?
+    completed? && !expired? && file.attached?
+  end
+
+  def accessible_to?(accessor)
+    return false if accessor.nil? || !ready?
+
+    user == accessor && accessor.active?
+  end
+
+  def build_later
+    Export::BuildJob.perform_later(self)
+  end
+
+  def build_now
+    Current.with_account(account) do
+      processing!
+
+      ZipFile.create_for(file, filename: filename) do |zip|
+        populate(zip)
+      end
+
+      mark_completed
+      notify_user
+    end
+  rescue StandardError
+    failed! if persisted?
+    raise
+  end
+
+  private
+    def populate(zip)
+      raise NotImplementedError
+    end
+
+    def filename
+      "fizzy-export-#{id}.zip"
+    end
+
+    def mark_completed
+      update!(status: :completed, completed_at: Time.current)
+    end
+
+    def notify_user
+      ExportMailer.completed(self).deliver_later if user.identity&.email_address.present?
+    end
+end
