@@ -0,0 +1,103 @@
+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts(:"37s")
+    @david = users(:david)
+    @kevin = users(:kevin)
+    @board = boards(:writebook)
+    Current.session = Session.new(identity: @david.identity)
+  end
+
+  test "exports only cards the user can see as JSON with comments and all attached files" do
+    # Create a private board Kevin CANNOT access
+    secret_board = @account.boards.create!(name: "Executive Only", all_access: false, creator: @david)
+    secret_board.accesses.where(user: @kevin).delete_all
+    secret_card = secret_board.cards.create!(title: "Top Secret Plan", creator: @david, status: :published)
+
+    # Create a drafted card (unpublished) on accessible board
+    draft_card = @board.cards.create!(title: "Unpublished Draft", creator: @david, status: :drafted)
+
+    # Attach header image, description embed, and comment embed (including duplicate filename!) to a visible card
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    desc_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "spec.png",
+      content_type: "image/png"
+    )
+    card.update!(description: "<p>Design spec: #{ActionText::Attachment.from_attachable(desc_blob).to_html}</p>")
+
+    # Same filename "moon.jpg" in a comment to verify filename deduplication!
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "moon.jpg",
+      content_type: "image/png"
+    )
+    card.comments.create!(
+      creator: @david,
+      body: "<p>Another moon #{ActionText::Attachment.from_attachable(comment_blob).to_html}</p>"
+    )
+
+    export = @kevin.data_exports.create!(account: @account)
+
+    assert_enqueued_emails 1 do
+      export.build_now
+    end
+
+    export.reload
+    assert export.completed?
+    assert export.ready?
+    assert export.accessible_to?(@kevin)
+    assert_not export.accessible_to?(@david)
+
+    ZipFile.read_from(export.file) do |zip|
+      # Visible card is included
+      assert zip.exists?("#{card.number}.json")
+
+      # Inaccessible board's card and draft card are NOT included
+      assert_not zip.exists?("#{secret_card.number}.json")
+      assert_not zip.exists?("#{draft_card.number}.json")
+
+      card_json = JSON.parse(zip.read("#{card.number}.json"))
+      assert_equal card.number, card_json["number"]
+      assert_equal card.title, card_json["title"]
+      assert_equal @board.name, card_json["board"]
+      assert_equal "#{card.number}/moon.jpg", card_json["image"]
+
+      # Attachments on card: header image + description embed
+      card_attachment_paths = card_json["attachments"].map { |a| a["path"] }
+      assert_includes card_attachment_paths, "#{card.number}/moon.jpg"
+      assert_includes card_attachment_paths, "#{card.number}/spec.png"
+
+      # Comments included with their attachments (deduplicated moon-2.jpg!)
+      assert_operator card_json["comments"].size, :>=, 2
+      moon_comment = card_json["comments"].find { |c| c["body"].include?("Another moon") }
+      assert_not_nil moon_comment
+      assert_equal [ "#{card.number}/moon-2.jpg" ], moon_comment["attachments"].map { |a| a["path"] }
+      assert_includes moon_comment["body_html"], "#{card.number}/moon-2.jpg"
+
+      # Verify actual binary bytes inside the ZIP!
+      assert_equal file_fixture("moon.jpg").binread, zip.read("#{card.number}/moon.jpg")
+      assert_equal file_fixture("avatar.png").binread, zip.read("#{card.number}/spec.png")
+      assert_equal file_fixture("avatar.png").binread, zip.read("#{card.number}/moon-2.jpg")
+    end
+  end
+
+  test "handles user with no accessible cards gracefully" do
+    @kevin.accesses.delete_all
+    export = @kevin.data_exports.create!(account: @account)
+
+    export.build_now
+    export.reload
+
+    assert export.completed?
+    assert export.file.attached?
+
+    ZipFile.read_from(export.file) do |zip|
+      assert_empty zip.entries
+    end
+  end
+end
