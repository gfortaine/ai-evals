@@ -0,0 +1,188 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+  end
+
+  test "unauthenticated visitor is redirected to login from /account/imports/new" do
+    untenanted do
+      get "/account/imports/new"
+      assert_redirected_to new_session_url(script_name: nil)
+    end
+  end
+
+  test "signed-in user can visit /account/imports/new and import an exported account end-to-end" do
+    # Attach a real file to verify files survive the full HTTP export -> HTTP import flow
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "logo-hero.jpg", content_type: "image/jpeg")
+
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    # Step 1: Export the account via HTTP
+    post account_exports_path
+    perform_enqueued_jobs
+    export = Account::Export.order(:created_at).last
+
+    get rails_blob_path(export.file, disposition: :attachment)
+    follow_redirect!
+    exported_zip_bytes = response.body
+
+    clear_enqueued_jobs
+    ActionMailer::Base.deliveries.clear
+
+    # Step 2: Visit /account/imports/new (untenanted!)
+    untenanted do
+      get "/account/imports/new"
+      assert_response :success
+      assert_select "form[action='/account/imports']"
+
+      # Step 3: Upload the exported zip file
+      tempfile = Tempfile.new([ "upload", ".zip" ])
+      tempfile.binmode
+      tempfile.write(exported_zip_bytes)
+      tempfile.rewind
+      uploaded_file = Rack::Test::UploadedFile.new(tempfile.path, "application/zip", true, original_filename: "account.zip")
+
+      assert_difference -> { Account::Import.count }, 1 do
+        assert_enqueued_with job: Account::ImportJob do
+          post "/account/imports", params: { account_import: { file: uploaded_file } }
+        end
+      end
+
+      import = Account::Import.order(:created_at).last
+      assert_redirected_to "/account/imports/#{import.id}"
+
+      # Step 4: Process import job and verify completion email + new account!
+      assert_difference -> { Account.count }, 1 do
+        assert_emails 1 do
+          perform_enqueued_jobs
+        end
+      end
+
+      import.reload
+      assert import.completed?
+      new_account = import.account
+      assert_not_equal @account.id, new_account.id
+
+      email = ActionMailer::Base.deliveries.last
+      assert_equal [ @admin.identity.email_address ], email.to
+      assert_equal "Your Fizzy account import is complete", email.subject
+      assert_includes email.text_part.body.to_s, root_url(host: "example.com", script_name: new_account.slug)
+
+      # Status page shows link to the new account
+      get "/account/imports/#{import.id}"
+      assert_response :success
+      assert_select "a[href=?]", root_url(script_name: new_account.slug)
+
+      # User can actually browse boards & cards in the newly imported account!
+      get board_path(new_account.boards.first, script_name: new_account.slug)
+      assert_response :success
+
+      new_card = new_account.cards.find_by!(number: card.number)
+      get card_path(new_card, script_name: new_account.slug)
+      assert_response :success
+      assert new_card.image.attached?
+      assert_equal file_fixture("moon.jpg").binread, new_card.image.download
+    ensure
+      tempfile&.close
+      tempfile&.unlink
+    end
+  end
+
+  test "uploading an invalid file sends failure email with reason and leaves nothing behind" do
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    untenanted do
+      tempfile = Tempfile.new([ "not_a_zip", ".zip" ])
+      tempfile.write("definitely not a zip")
+      tempfile.rewind
+      uploaded_file = Rack::Test::UploadedFile.new(tempfile.path, "application/zip", true, original_filename: "not_a_zip.zip")
+
+      assert_no_difference -> { Account.count } do
+        post "/account/imports", params: { account_import: { file: uploaded_file } }
+        assert_emails 1 do
+          perform_enqueued_jobs
+        end
+      end
+
+      import = Account::Import.order(:created_at).last
+      assert import.failed?
+      assert_nil import.account_id
+      assert_not import.file.attached?
+
+      email = ActionMailer::Base.deliveries.last
+      assert_equal [ @admin.identity.email_address ], email.to
+      assert_equal "Your Fizzy account import failed", email.subject
+      assert_includes email.text_part.body.to_s, import.failure_reason
+
+      get "/account/imports/#{import.id}"
+      assert_response :success
+      assert_includes response.body, import.failure_reason
+    ensure
+      tempfile&.close
+      tempfile&.unlink
+    end
+  end
+
+  test "submitting without a file returns unprocessable entity" do
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    untenanted do
+      assert_no_difference -> { Account::Import.count } do
+        post "/account/imports", params: { account_import: { file: nil } }
+      end
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "cannot view another identity's import" do
+    other_import = Current.without_account do
+      identities(:david).account_imports.create!(
+        file: { io: StringIO.new("zip"), filename: "test.zip", content_type: "application/zip" }
+      )
+    end
+
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    untenanted do
+      get "/account/imports/#{other_import.id}"
+      assert_response :not_found
+    end
+  end
+
+  test "visiting tenanted account/imports/new redirects to untenanted /account/imports/new" do
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    get account_imports_path.sub(/imports\z/, "imports/new")
+    assert_redirected_to new_account_import_url(script_name: nil)
+  end
+
+  test "untenanted direct upload works for signed-in user on import page" do
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    untenanted do
+      post rails_direct_uploads_path,
+        params: {
+          blob: {
+            filename: "big-account-export.zip",
+            byte_size: 12345,
+            checksum: "GQ5SqLsM7ylnji0Wgd9wNC==",
+            content_type: "application/zip"
+          }
+        },
+        as: :json
+
+      assert_response :success
+      assert_includes response.parsed_body.keys, "direct_upload"
+    end
+  end
+end
