+    def populate(zip)
+      exportable_cards.find_each(batch_size: 100) do |card|
+        export_card(zip, card)
+      end
+    end
+
+    def exportable_cards
+      user.accessible_cards.published.includes(
+        :board, :column, :tags, :steps, :closure, :goldness, :not_now,
+        :rich_text_description,
+        image_attachment: :blob,
+        creator: :identity,
+        assignees: :identity,
+        reactions: :reacter
+      )
+    end
+
+    def export_card(zip, card)
+      blob_paths = {}
+      used_filenames = Set.new
+      card_attachments = []
+
+      image_path = if card.image.attached?
+        path = export_blob(zip, card, card.image.blob, blob_paths, used_filenames)
+        card_attachments << serialize_attachment(card.image.blob, path)
+        path
+      end
+
+      if card.rich_text_description
+        card.rich_text_description.embeds.includes(:blob).each do |embed|
+          path = export_blob(zip, card, embed.blob, blob_paths, used_filenames)
+          card_attachments << serialize_attachment(embed.blob, path)
+        end
+      end
+
+      comments_data = card.comments.chronologically.includes(
+        :rich_text_body,
+        creator: :identity,
+        reactions: :reacter
+      ).map do |comment|
+        comment_attachments = []
+
+        if comment.rich_text_body
+          comment.rich_text_body.embeds.includes(:blob).each do |embed|
+            path = export_blob(zip, card, embed.blob, blob_paths, used_filenames)
+            comment_attachments << serialize_attachment(embed.blob, path)
+          end
+        end
+
+        serialize_comment(comment, blob_paths, comment_attachments)
+      end
+
+      card_data = serialize_card(card, blob_paths, image_path, card_attachments, comments_data)
+      zip.add_file("#{card.number}.json", JSON.pretty_generate(card_data))
+    end
+
+    def export_blob(zip, card, blob, blob_paths, used_filenames)
+      return blob_paths[blob.id] if blob_paths.key?(blob.id)
+
+      filename = unique_filename(blob.filename.to_s, used_filenames)
+      path = "#{card.number}/#{filename}"
+
+      zip.add_file(path, compress: false) do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+
+      blob_paths[blob.id] = path
+    end
+
+    def unique_filename(raw_filename, used_filenames)
+      sanitized = ActiveStorage::Filename.new(raw_filename.presence || "attachment").sanitized
+      candidate = sanitized
+      extension = File.extname(sanitized)
+      stem = File.basename(sanitized, extension)
+      counter = 2
+
+      while used_filenames.include?(candidate.downcase)
+        candidate = "#{stem}-#{counter}#{extension}"
+        counter += 1
+      end
+
+      used_filenames.add(candidate.downcase)
+      candidate
+    end
+
+    def serialize_card(card, blob_paths, image_path, attachments, comments)
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        board: card.board.name,
+        column: card.column&.name,
+        status: card.status,
+        closed: card.closed?,
+        closed_at: card.closed_at&.utc&.iso8601,
+        postponed: card.postponed?,
+        golden: card.golden?,
+        due_on: card.due_on&.iso8601,
+        creator: serialize_user(card.creator),
+        assignees: card.assignees.map { |assignee| serialize_user(assignee) },
+        tags: card.tags.map(&:title).sort,
+        steps: card.steps.sort_by(&:created_at).map { |step| { content: step.content, completed: step.completed } },
+        description: card.description.to_plain_text,
+        description_html: rewrite_rich_text_html(card.rich_text_description, blob_paths),
+        image: image_path,
+        attachments: attachments,
+        reactions: card.reactions.map { |reaction| serialize_reaction(reaction) },
+        comments: comments,
+        created_at: card.created_at.utc.iso8601,
+        updated_at: card.updated_at.utc.iso8601,
+        last_active_at: card.last_active_at.utc.iso8601
+      }
+    end
+
+    def serialize_comment(comment, blob_paths, attachments)
+      {
+        id: comment.id,
+        creator: serialize_user(comment.creator),
+        body: comment.body.to_plain_text,
+        body_html: rewrite_rich_text_html(comment.rich_text_body, blob_paths),
+        attachments: attachments,
+        reactions: comment.reactions.map { |reaction| serialize_reaction(reaction) },
+        created_at: comment.created_at.utc.iso8601,
+        updated_at: comment.updated_at.utc.iso8601
+      }
+    end
+
+    def serialize_user(record)
+      return nil unless record
+
+      {
+        name: record.name,
+        email_address: record.identity&.email_address
+      }
+    end
+
+    def serialize_attachment(blob, path)
+      {
+        filename: blob.filename.to_s,
+        content_type: blob.content_type,
+        byte_size: blob.byte_size,
+        path: path
+      }
+    end
+
+    def serialize_reaction(reaction)
+      {
+        content: reaction.content,
+        reacter: reaction.reacter&.name,
+        created_at: reaction.created_at.utc.iso8601
+      }
+    end
+
+    def rewrite_rich_text_html(rich_text, blob_paths)
+      html = rich_text&.body&.to_html
+      return "" if html.blank?
+
+      fragment = Nokogiri::HTML::DocumentFragment.parse(html)
+
+      fragment.css("action-text-attachment[sgid]").each do |node|
+        parsed = SignedGlobalID.parse(node["sgid"], for: "attachable")
+        if parsed && parsed.model_name == "ActiveStorage::Blob" && blob_paths.key?(parsed.model_id)
+          node["url"] = blob_paths[parsed.model_id]
+          node.remove_attribute("sgid")
+        end
+      end
+
+      fragment.to_html
+    end
+
+    def filename
+      "fizzy-cards-export-#{created_at.strftime('%Y%m%d')}.zip"
+    end
+end
