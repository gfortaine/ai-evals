+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,62 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  layout "public"
+
+  before_action :set_import, only: :show
+
+  def new
+    @import = Current.identity.account_imports.new
+  end
+
+  def create
+    @import = Current.identity.account_imports.new(import_params)
+
+    if @import.save
+      @import.process_later
+
+      respond_to do |format|
+        format.html { redirect_to account_import_path(@import, script_name: nil) }
+        format.json { render json: import_json, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: { errors: @import.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def show
+    respond_to do |format|
+      format.html
+      format.json { render json: import_json }
+    end
+  end
+
+  private
+    def redirect_tenanted_request
+      redirect_to new_account_import_url(script_name: nil) if Current.account.present?
+    end
+
+    def set_import
+      @import = Current.identity.account_imports.find(params[:id])
+    end
+
+    def import_params
+      if params.key?(:account_import)
+        params.expect(account_import: [ :file ])
+      else
+        params.permit(:file)
+      end
+    end
+
+    def import_json
+      {
+        id: @import.id,
+        status: @import.status,
+        failure_reason: @import.failure_reason,
+        account_url: @import.completed? && @import.account ? root_url(script_name: @import.account.slug) : nil
+      }
+    end
+end
