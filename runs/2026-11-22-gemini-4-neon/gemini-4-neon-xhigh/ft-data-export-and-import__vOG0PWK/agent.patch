+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_export, only: :show
+
+  def show
+    if @export.nil? || @export.expired?
+      respond_to do |format|
+        format.html { render :expired, status: :not_found }
+        format.any { head :not_found }
+      end
+    elsif @export.downloadable?
+      respond_to do |format|
+        format.html
+        format.zip { redirect_to rails_blob_path(@export.file, disposition: :attachment) }
+        format.json { render json: export_json(@export) }
+      end
+    else
+      respond_to do |format|
+        format.html
+        format.zip { head :not_found }
+        format.json { render json: export_json(@export) }
+      end
+    end
+  end
+
+  def create
+    @export = Current.account.account_exports.create!(user: Current.user)
+    @export.build_later
+
+    respond_to do |format|
+      format.html { redirect_to account_settings_path, notice: "Export started. We’ll email you a download link when it’s ready." }
+      format.json { render json: export_json(@export), status: :created, location: account_export_path(@export) }
+    end
+  end
+
+  private
+    def set_export
+      @export = Current.account.account_exports.find_by(id: params[:id], user: Current.user)
+    end
+
+    def export_json(export)
+      {
+        id: export.id,
+        status: export.status,
+        download_url: export.downloadable? ? rails_blob_url(export.file, disposition: :attachment) : nil
+      }
+    end
+end
diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
