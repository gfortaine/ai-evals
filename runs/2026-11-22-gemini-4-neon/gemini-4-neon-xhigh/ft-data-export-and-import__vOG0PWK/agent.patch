diff --git a/test/models/user/data_export_test.rb b/test/models/user/data_export_test.rb
new file mode 100644
index 0000000..d1305ac
--- /dev/null
+++ b/test/models/user/data_export_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    Current.account = @account
+    Current.user = @user
+  end
+
+  test "exports accessible published cards as JSON with comments, images, and attached files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "header.jpg", content_type: "image/jpeg")
+
+    desc_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "diagram.png",
+      content_type: "image/png"
+    )
+    card.update!(description: "<p>See attached diagram #{ActionText::Attachment.from_attachable(desc_blob).to_html}</p>")
+
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("PDF file contents"),
+      filename: "report.pdf",
+      content_type: "application/pdf"
+    )
+    # Also attach a second file with the SAME filename to verify collision handling
+    dup_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("Second PDF contents"),
+      filename: "report.pdf",
+      content_type: "application/pdf"
+    )
+    card.comments.create!(
+      creator: @user,
+      body: "<p>Reports: #{ActionText::Attachment.from_attachable(comment_blob).to_html} #{ActionText::Attachment.from_attachable(dup_blob).to_html}</p>"
+    )
+
+    # Create a private board the user CANNOT see
+    private_board = @account.boards.create!(name: "Secret Board", creator: users(:kevin), all_access: false)
+    secret_card = private_board.cards.create!(title: "Top Secret", status: "published", creator: users(:kevin))
+
+    # Create a draft card on an accessible board
+    draft_card = boards(:writebook).cards.create!(title: "My Draft", status: "drafted", creator: @user)
+
+    export = @user.data_exports.create!(account: @account)
+
+    assert_enqueued_emails 1 do
+      export.build_now
+    end
+
+    export.reload
+    assert export.completed?
+    assert export.file.attached?
+    assert export.downloadable?
+
+    ZipFile.read_from(export.file) do |zip|
+      manifest = JSON.parse(zip.read("manifest.json"))
+      assert_equal "user_data_export", manifest["type"]
+
+      # Accessible card is exported
+      assert zip.exists?("#{card.number}.json")
+      card_json = JSON.parse(zip.read("#{card.number}.json"))
+
+      assert_equal card.number, card_json["number"]
+      assert_equal card.title, card_json["title"]
+      assert_equal card.board.name, card_json["board"]
+      assert_includes card_json["description"], "See attached diagram"
+
+      # Header image exported and matches bytes
+      assert_equal "header.jpg", card_json["image"]["filename"]
+      assert zip.exists?(card_json["image"]["path"])
+      assert_equal file_fixture("moon.jpg").binread, zip.read(card_json["image"]["path"])
+
+      # Description embedded image exported and matches bytes
+      assert_equal 1, card_json["attachments"].size
+      assert_equal "diagram.png", card_json["attachments"].first["filename"]
+      assert_equal file_fixture("avatar.png").binread, zip.read(card_json["attachments"].first["path"])
+
+      # Comments and comment file attachments exported (including duplicate filenames!)
+      assert card_json["comments"].size >= 1
+      report_comment = card_json["comments"].find { |c| c["attachments"].size == 2 }
+      assert_not_nil report_comment
+      paths = report_comment["attachments"].map { |a| a["path"] }
+      assert_equal 2, paths.uniq.size
+      assert_equal "PDF file contents", zip.read(paths[0])
+      assert_equal "Second PDF contents", zip.read(paths[1])
+
+      # Private board card, draft card, and other account's cards are NOT exported
+      assert_not zip.exists?("#{secret_card.number}.json")
+      assert_not zip.exists?("#{draft_card.number}.json")
+      assert_not(zip.exists?("#{cards(:radio).number}.json") &&
+        JSON.parse(zip.read("#{cards(:radio).number}.json"))["id"] == cards(:radio).id)
+    end
+  end
+
+  test "handles user with zero accessible cards" do
+    @user.accesses.destroy_all
+
+    export = @user.data_exports.create!(account: @account)
+    export.build_now
+
+    assert export.completed?
+    ZipFile.read_from(export.file) do |zip|
+      assert_equal [ "manifest.json" ], zip.entries
+    end
+  end
+
+  test "expires after 24 hours" do
+    export = @user.data_exports.create!(account: @account)
+    export.build_now
+
+    assert export.accessible_to?(@user)
+    assert_not export.accessible_to?(users(:kevin))
+
+    travel 25.hours do
+      assert export.expired?
+      assert_not export.downloadable?
+      assert_not export.accessible_to?(@user)
+    end
+  end
+end
