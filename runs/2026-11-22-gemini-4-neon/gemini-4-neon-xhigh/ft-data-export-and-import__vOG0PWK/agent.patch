+    assert_equal "Compressed content", reader.read("deflated.txt")
+    assert_equal "\x00\x01\x02\xFF".b, reader.read("stored.bin")
+    assert_equal "", reader.read("empty.txt")
+    assert_equal large_content.bytesize, reader.entry_size("large.bin")
+
+    # Verify streaming via IO.copy_stream and rewind
+    reader.open_entry("large.bin") do |entry_io|
+      assert_equal large_content.bytesize, entry_io.size
+      dest = StringIO.new(+"")
+      dest.binmode
