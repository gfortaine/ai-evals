+<% @page_title = "Import a Fizzy account" %>
+
+<div class="panel panel--centered flex flex-column gap-half" style="--panel-size: 50ch;">
+  <h1 class="txt-x-large font-weight-black margin-none">
+    <%= @page_title %>
+  </h1>
+
+  <p class="margin-none-block-start">
+    Upload a Fizzy account export <code>.zip</code> file to create a new account with all of its boards, cards, comments, files, and people. We’ll email you at <strong><%= Current.identity.email_address %></strong> when it’s ready.
+  </p>
+
+  <%= form_with model: @import, url: account_imports_path(script_name: nil), class: "flex flex-column gap", data: { turbo: false } do |form| %>
+    <% if @import.errors.any? %>
+      <div class="txt-negative txt-small txt-align-start">
+        <p class="margin-block-none font-weight-bold">Couldn’t start import:</p>
+        <ul class="margin-block-none">
+          <% @import.errors.full_messages.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <label class="flex flex-column gap-half txt-align-start">
+      <span class="font-weight-bold">Account export file (.zip)</span>
+      <%= form.file_field :file, accept: ".zip,application/zip", required: true, class: "input full-width" %>
+    </label>
+
+    <button type="submit" class="btn btn--link center">
+      <span>Import account</span>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
diff --git a/app/views/account/imports/show.html.erb b/app/views/account/imports/show.html.erb
