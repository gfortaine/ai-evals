@@ -0,0 +1,35 @@
+<% @page_title = "Account import" %>
+
+<div class="panel panel--centered flex flex-column gap-half" style="--panel-size: 50ch;">
+  <% if @import.completed? && @import.account %>
+    <h1 class="txt-x-large font-weight-black margin-none">Import complete!</h1>
+    <p class="margin-none-block-start margin-block-end-half">
+      Your new account <strong><%= @import.account.name %></strong> is ready with all of its boards, cards, comments, files, and people.
+    </p>
+
+    <%= link_to "Open #{@import.account.name}", landing_path(script_name: @import.account.slug), class: "btn btn--link center" %>
+  <% elsif @import.failed? %>
+    <h1 class="txt-x-large font-weight-black margin-none">Import failed</h1>
+    <p class="margin-none-block-start margin-block-end-half">
+      We couldn’t complete your account import, and nothing was left behind.
+    </p>
