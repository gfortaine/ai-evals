 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    @board = boards(:writebook)
+    Current.account = @account
+    Current.user = @user
+  end
+
+  test "exports sgids as portable gids and re-signs them for new records on import" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    user_attachment = ActionText::Attachment.from_attachable(@user).to_html
+    blob_attachment = ActionText::Attachment.from_attachable(blob).to_html
+    remote_attachment = '<action-text-attachment url="https://example.com/video.mp4" content-type="video/mp4" filename="video.mp4"></action-text-attachment>'
+
+    card = @board.cards.create!(
+      title: "Rich text transfer test",
+      status: "published",
+      creator: @user,
+      description: "<p>Hey #{user_attachment} look at #{blob_attachment} and #{remote_attachment}</p>"
+    )
+
+    tempfile = Tempfile.new([ "rich_text", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(@account).export(writer)
+    writer.close
+
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+
+    exported_records = reader.glob("data/action_text_rich_texts/*.json").flat_map { |p| JSON.parse(reader.read(p)) }
+    exported_card_rt = exported_records.find { |r| r["record_type"] == "Card" && r["record_id"] == card.id }
+    assert_not_nil exported_card_rt
+
+    exported_body = exported_card_rt["body"]
+    assert_not_includes exported_body, "sgid="
+    assert_includes exported_body, "gid=\"gid://fizzy/User/#{@user.id}\""
+    assert_includes exported_body, "gid=\"gid://fizzy/ActiveStorage::Blob/#{blob.id}\""
+    assert_includes exported_body, 'url="https://example.com/video.mp4"'
+    assert_not_includes exported_body, "/rails/active_storage/blobs/"
+
+    # Import into a new account with remapped IDs
+    new_account = Account.create!(name: "Imported Account")
+    context = Account::DataTransfer::Context.new(identity: identities(:david))
+    context.account = new_account
+    context.id_map.register(@account.id, new_account.id)
+
+    new_user_id = context.id_map.remap(@user.id)
+    new_blob_id = context.id_map.remap(blob.id)
+    new_card_id = context.id_map.remap(card.id)
+    now = Time.current.utc.iso8601(6)
+
+    User.insert_all!([ {
+      id: new_user_id, account_id: new_account.id, name: "David", role: "member",
+      active: true, created_at: now, updated_at: now
+    } ])
+    ActiveStorage::Blob.insert_all!([ {
+      id: new_blob_id, account_id: new_account.id, key: ActiveStorage::Blob.generate_unique_secure_token,
+      filename: "moon.jpg", content_type: "image/jpeg", byte_size: blob.byte_size,
+      checksum: blob.checksum, service_name: ActiveStorage::Blob.service.name.to_s, created_at: now
+    } ])
+
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(nil).import(reader, context: context)
+
+    imported_rt = ActionText::RichText.find_by!(account_id: new_account.id, record_type: "Card", record_id: new_card_id)
+    imported_body = imported_rt.read_attribute("body").to_html
+
+    assert_not_includes imported_body, " gid="
+    assert_includes imported_body, "sgid="
+    assert_includes imported_body, "#{new_account.slug}/rails/active_storage/blobs/"
+    assert_includes imported_body, 'url="https://example.com/video.mp4"'
+
+    attachables = imported_rt.body.attachments.map(&:attachable)
+    assert_includes attachables, User.find(new_user_id)
+    assert_includes attachables, ActiveStorage::Blob.find(new_blob_id)
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
 end
