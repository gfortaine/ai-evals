+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+    @member = users(:david)
+    Current.account = @account
+    Current.user = @admin
+  end
+
+  test "build_now creates a complete zip archive and sends completion email" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = @account.account_exports.create!(user: @admin)
+
+    assert_enqueued_emails 1 do
+      export.build_now
+    end
+
+    export.reload
+    assert export.completed?
+    assert export.completed_at.present?
+    assert export.file.attached?
+    assert export.downloadable?
+    assert_equal "application/zip", export.file.content_type
+
+    ZipFile.read_from(export.file) do |zip|
+      manifest = JSON.parse(zip.read("manifest.json"))
+      assert_equal 1, manifest["version"]
+      assert_equal "account_export", manifest["type"]
+      assert_equal @account.name, manifest["account_name"]
+
+      accounts_json = zip.glob("data/accounts/*.json").flat_map { |p| JSON.parse(zip.read(p)) }
+      assert_equal [ @account.id ], accounts_json.map { |a| a["id"] }
+
+      users_json = zip.glob("data/users/*.json").flat_map { |p| JSON.parse(zip.read(p)) }
+      exported_emails = users_json.map { |u| u["email_address"] }.compact
+      assert_includes exported_emails, @admin.identity.email_address
+      assert_not_includes exported_emails, identities(:mike).email_address
+
+      columns_json = zip.glob("data/columns/*.json").flat_map { |p| JSON.parse(zip.read(p)) }
+      columns_json.each do |col|
+        assert_kind_of String, col["color"]
+        assert_match(/\Avar\(--color-/, col["color"])
+      end
+
+      cards_json = zip.glob("data/cards/*.json").flat_map { |p| JSON.parse(zip.read(p)) }
+      assert_includes cards_json.map { |c| c["id"] }, card.id
+      assert_not_includes cards_json.map { |c| c["id"] }, cards(:radio).id
+
+      assert zip.exists?("storage/files/#{card.image.blob.id}")
+      assert_equal file_fixture("moon.jpg").binread, zip.read("storage/files/#{card.image.blob.id}")
+    end
+  end
+
+  test "excludes previous export attachments and blobs from new account export" do
+    first_export = @account.account_exports.create!(user: @admin)
+    first_export.build_now
+    first_export_blob_id = first_export.file.blob.id
+
+    second_export = @account.account_exports.create!(user: @admin)
+    second_export.build_now
+
+    ZipFile.read_from(second_export.file) do |zip|
+      blobs_json = zip.glob("data/active_storage_blobs/*.json").flat_map { |p| JSON.parse(zip.read(p)) }
+      assert_not_includes blobs_json.map { |b| b["id"] }, first_export_blob_id
+      assert_not zip.exists?("storage/files/#{first_export_blob_id}")
+
+      attachments_json = zip.glob("data/active_storage_attachments/*.json").flat_map { |p| JSON.parse(zip.read(p)) }
+      assert attachments_json.none? { |a| a["record_type"] == "Export" }
+    end
+  end
+
+  test "accessible_to? enforces requesting admin and 24-hour expiration" do
+    export = @account.account_exports.create!(user: @admin)
+    export.build_now
+
+    assert export.accessible_to?(@admin)
+    assert_not export.accessible_to?(@member)
+    assert_not export.accessible_to?(users(:jason))
+
+    travel 23.hours do
+      assert export.downloadable?
+      assert export.accessible_to?(@admin)
+    end
+
+    travel 25.hours do
+      assert export.expired?
+      assert_not export.downloadable?
+      assert_not export.accessible_to?(@admin)
+    end
+  end
+
+  test "Export.cleanup removes expired exports and keeps current ones" do
+    expired_export = @account.account_exports.create!(user: @admin)
+    expired_export.build_now
+    expired_export.update!(completed_at: 25.hours.ago)
+
+    current_export = @account.account_exports.create!(user: @admin)
+    current_export.build_now
+
+    assert_difference -> { Export.count }, -1 do
+      Export.cleanup
+    end
+
+    assert_not Export.exists?(expired_export.id)
+    assert Export.exists?(current_export.id)
+  end
+
+  test "marks export as failed when an error occurs during build" do
+    export = @account.account_exports.create!(user: @admin)
+    Account::DataTransfer::Manifest.any_instance.stubs(:export).raises(StandardError, "boom")
+
+    assert_raises(StandardError) do
+      export.build_now
+    end
+
+    assert export.reload.failed?
+    assert_not export.file.attached?
+  end
+end
