@@ -0,0 +1,58 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  layout "public"
+
+  before_action :set_import, only: :show
+
+  def new
+    @import = Current.identity.account_imports.new
+  end
+
+  def create
+    @import = Current.identity.account_imports.new(file: uploaded_file)
+
+    if @import.save
+      @import.process_later
+
+      respond_to do |format|
+        format.html { redirect_to account_import_path(@import, script_name: nil), notice: "Import started. We’ll email you when your new account is ready." }
+        format.json { render json: import_json(@import), status: :created, location: account_import_path(@import, script_name: nil) }
+      end
+    else
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: { errors: @import.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def show
+    respond_to do |format|
+      format.html
+      format.json { render json: import_json(@import) }
+    end
+  end
+
+  private
+    def set_import
+      @import = Current.identity.account_imports.find(params[:id])
+    end
+
+    def uploaded_file
+      if params[:account_import].present?
+        params.expect(account_import: [ :file ])[:file]
+      else
+        params[:file]
+      end
+    end
+
+    def import_json(import)
+      {
+        id: import.id,
+        status: import.status,
+        failure_reason: import.failure_reason,
+        account_url: import.account ? landing_url(script_name: import.account.slug) : nil
+      }
+    end
+end
