+  test "reader reads compressed, stored, empty, and large entries" do
+    large_content = ("A".."Z").to_a.join * 100_000 # ~2.6MB
+    tempfile = Tempfile.new([ "test", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("deflated.txt", "Compressed content", compress: true)
+    writer.add_file("stored.bin", "\x00\x01\x02\xFF".b, compress: false)
+    writer.add_file("empty.txt", "", compress: false)
+    writer.add_file("large.bin", large_content, compress: false)
+    writer.close
+
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+
+    assert_equal [ "deflated.txt", "empty.txt", "large.bin", "stored.bin" ], reader.entries.sort
+    assert reader.exists?("deflated.txt")
