+        "created_at" => attrs["created_at"] || now,
+        "updated_at" => attrs["updated_at"] || now
+      } ])
+
+      context.id_map.register(old_account_id, new_account_id)
+      context.account = Account.find(new_account_id)
+      context.account.create_join_code!
+    end
