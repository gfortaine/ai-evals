diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..8d21d3e
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+    @member = users(:david)
+  end
+
+  test "admin sees export section on account settings page" do
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action='#{account_exports_path}']"
+  end
+
+  test "non-admin does not see export section on account settings page" do
+    sign_in_as @member
+    clear_enqueued_jobs
+
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action='#{account_exports_path}']", count: 0
+  end
+
+  test "admin can request an account export and download it when ready" do
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    assert_difference -> { Account::Export.count }, 1 do
+      assert_enqueued_with(job: ExportJob) do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    export = Account::Export.last
+    assert_equal @admin, export.user
+
+    assert_emails 1 do
+      perform_enqueued_jobs
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @admin.identity.email_address ], email.to
+    assert_match account_export_path(export), email.body.encoded
+
+    # Visit the download link from the email
+    get account_export_path(export)
+    assert_response :success
+    assert_select "a[href*='#{rails_blob_path(export.reload.file, disposition: :attachment)}']"
+
+    # Direct .zip format redirects to attachment download
+    get account_export_path(export, format: :zip)
+    assert_response :redirect
+
+    # Follow redirect to actually download the zip bytes
+    follow_redirect!
+    follow_redirect!
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+
+    reader = ZipFile::Reader.new(StringIO.new(response.body))
+    assert reader.exists?("manifest.json")
+    assert_equal "account_export", JSON.parse(reader.read("manifest.json"))["type"]
+  end
+
+  test "non-admin cannot create or view an account export" do
+    sign_in_as @member
+    clear_enqueued_jobs
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+    assert_response :forbidden
+
+    export = @account.account_exports.create!(user: @admin)
+    export.build_now
+
+    get account_export_path(export)
+    assert_response :forbidden
+
+    get rails_blob_path(export.file, disposition: :attachment)
+    assert_response :forbidden
+  end
+
+  test "another admin cannot access someone else's account export" do
+    export = @account.account_exports.create!(user: @admin)
+    export.build_now
+
+    sign_in_as users(:jason)
+    clear_enqueued_jobs
+
+    get account_export_path(export)
+    assert_response :not_found
+
+    get rails_blob_path(export.file, disposition: :attachment)
+    assert_response :forbidden
+  end
+
+  test "download link stops working after 24 hours" do
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    export = @account.account_exports.create!(user: @admin)
+    export.build_now
+
+    travel 25.hours do
+      get account_export_path(export)
+      assert_response :not_found
+      assert_match(/expired/i, response.body)
+
+      get account_export_path(export, format: :zip)
+      assert_response :not_found
+
+      get rails_blob_path(export.file, disposition: :attachment)
+      assert_response :forbidden
+    end
+  end
+end
