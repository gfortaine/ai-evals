+  def import(zip, context:)
+    with_zip(zip) do
+      paths = zip.glob("data/#{model_dir}/*.json")
+      raise Account::DataTransfer::ImportError, "The export archive is missing account data." if paths.empty?
+
+      raw_records = parse_json_array(paths.first)
