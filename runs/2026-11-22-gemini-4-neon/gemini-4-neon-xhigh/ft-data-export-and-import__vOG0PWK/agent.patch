+    assert import.reload.completed?, "Import failed: #{import.failure_reason}"
+    imported_card = import.account.cards.find_by!(number: card.number)
+    attachables = imported_card.description.body.attachments.map(&:attachable)
+
+    imported_david = import.account.users.find_by!(identity: @david.identity)
+    assert_includes attachables, imported_david
+    imported_blob = attachables.grep(ActiveStorage::Blob).first
+    assert_not_nil imported_blob
+    assert_equal "cross-instance payload", imported_blob.download
+  ensure
+    SignedGlobalID.verifier = original_verifier
+  end
+end
+
+test "imports from an S3 service via HTTP range streaming without downloading whole archive" do
+  require "active_storage/service/s3_service"
+
+  card = cards(:logo)
+  card.image.attach(io: file_fixture("moon.jpg").open, filename: "s3-moon.jpg", content_type: "image/jpeg")
+
+  export = @source_account.account_exports.create!(user: @admin)
+  export.build_now
+  zip_bytes = export.file.download
+  total_size = zip_bytes.bytesize
+
+  s3_url = "https://s3.example.test/bucket/huge-import.zip?X-Amz-Signature=abc"
+  stub_request(:get, s3_url).to_return do |request|
+    match = request.headers["Range"].match(/bytes=(\d+)-(\d+)/)
+    start_pos = match[1].to_i
+    end_pos = match[2].to_i
+    body = zip_bytes.byteslice(start_pos..end_pos)
+    {
+      status: 206,
+      body: body,
+      headers: {
+        "Content-Range" => "bytes #{start_pos}-#{end_pos}/#{total_size}",
+        "Content-Length" => body.bytesize.to_s
+      }
+    }
+  end
+
+  fake_s3_service = ActiveStorage::Service::S3Service.allocate
+  fake_config = Struct.new(:ssl_verify_peer).new(false)
+  fake_low_level = Struct.new(:config).new(fake_config)
+  fake_client = Struct.new(:client).new(fake_low_level)
+  fake_s3_service.stubs(:client).returns(fake_client)
+  fake_s3_service.stubs(:url).returns(s3_url)
+
+  Current.account = nil
+  import = Account::Import.create!(
+    identity: @admin.identity,
+    file: { io: StringIO.new(zip_bytes), filename: "s3-import.zip", content_type: "application/zip" }
+  )
+  import.file.blob.stubs(:service).returns(fake_s3_service)
+  fake_s3_service.stubs(:delete)
+
+  import.process_now
+
+  assert import.reload.completed?, "Import failed: #{import.failure_reason}"
+  imported_card = import.account.cards.find_by!(number: card.number)
+  assert_equal file_fixture("moon.jpg").binread, imported_card.image.download
+end
+
+  private
+    def assert_nothing_left_behind(&block)
+      counts_before = snapshot_table_counts
+      yield
+      counts_after = snapshot_table_counts
+      assert_equal counts_before, counts_after, "Expected no leftover records after failed import"
+    end
+
+    def snapshot_table_counts
+      {
+        accounts: Account.count,
+        users: User.count,
+        identities: Identity.count,
+        boards: Board.count,
+        columns: Column.count,
+        cards: Card.count,
+        comments: Comment.count,
+        events: Event.count,
+        tags: Tag.count,
+        filters: Filter.count,
+        blobs: ActiveStorage::Blob.count,
+        attachments: ActiveStorage::Attachment.count,
+        rich_texts: ActionText::RichText.count,
+        entropies: Entropy.count,
+        join_codes: Account::JoinCode.count
+      }
+    end
+
+    def rewrite_zip_modifying(attachment, replacements)
+      out = StringIO.new(+"")
+      out.binmode
+      writer = ZipFile::Writer.new(out)
+
+      ZipFile.read_from(attachment) do |reader|
+        reader.entries.each do |path|
+          content = replacements.key?(path) ? replacements[path] : reader.read(path)
+          writer.add_file(path, content, compress: !path.start_with?("storage/files/"))
+        end
+      end
+
+      writer.close
+      out.string
+    end
+
+    def rewrite_zip_excluding(attachment, excluded_path)
+      out = StringIO.new(+"")
+      out.binmode
+      writer = ZipFile::Writer.new(out)
+
+      ZipFile.read_from(attachment) do |reader|
+        reader.entries.each do |path|
+          next if path == excluded_path
+          writer.add_file(path, reader.read(path), compress: !path.start_with?("storage/files/"))
+        end
+      end
+
+      writer.close
+      out.string
+    end
+end
