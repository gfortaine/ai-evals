+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+  end
+
+  test "unauthenticated user visiting /account/imports/new is redirected to login" do
+    get "/account/imports/new"
+    assert_redirected_to new_session_url(script_name: nil)
+  end
+
+  test "signed-in user can view /account/imports/new" do
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    get "/account/imports/new"
+    assert_response :success
+    assert_select "form[action='/account/imports']"
+    assert_select "input[type='file']"
+  end
+
+  test "submitting without a file renders unprocessable_entity" do
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    assert_no_difference -> { Account::Import.count } do
+      post "/account/imports"
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "signed-in user can upload an account export zip at /account/imports and gets a new account + email" do
+    # First create a real account export zip
+    export = @account.account_exports.create!(user: @admin)
+    export.build_now
+
+    tempfile = Tempfile.new([ "account-export", ".zip" ])
+    tempfile.binmode
+    tempfile.write(export.file.download)
+    tempfile.rewind
+
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    uploaded = Rack::Test::UploadedFile.new(tempfile.path, "application/zip", true, original_filename: "account-export.zip")
+
+    assert_difference -> { Account::Import.count }, 1 do
+      assert_enqueued_with(job: Account::ImportJob) do
+        post "/account/imports", params: { account_import: { file: uploaded } }
+      end
+    end
+
+    import = Account::Import.last
+    assert_redirected_to "/account/imports/#{import.id}"
+
+    follow_redirect!
+    assert_response :success
+    assert_match(/Importing your account/i, response.body)
+
+    assert_difference -> { Account.count }, 1 do
+      assert_emails 1 do
+        perform_enqueued_jobs
+      end
+    end
+
+    import.reload
+    assert import.completed?
+    assert_not_nil import.account
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @admin.identity.email_address ], email.to
+    assert_match import.account.slug, email.body.encoded
+
+    get "/account/imports/#{import.id}"
+    assert_response :success
+    assert_match(/Import complete/i, response.body)
+    assert_select "a[href*='#{import.account.slug}']"
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  test "uploading an invalid file emails failure reason and leaves no account behind" do
+    tempfile = Tempfile.new([ "bad", ".zip" ])
+    tempfile.write("definitely not a zip file")
+    tempfile.rewind
+
+    sign_in_as @admin
+    clear_enqueued_jobs
+    uploaded = Rack::Test::UploadedFile.new(tempfile.path, "application/zip", true, original_filename: "bad.zip")
+
+    post "/account/imports", params: { account_import: { file: uploaded } }
+    import = Account::Import.last
+    assert_redirected_to "/account/imports/#{import.id}"
+
+    assert_no_difference -> { Account.count } do
+      assert_emails 1 do
+        perform_enqueued_jobs
+      end
+    end
+
+    import.reload
+    assert import.failed?
+    assert_nil import.account
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @admin.identity.email_address ], email.to
+    assert_match(/failed/i, email.subject)
+    assert_match import.failure_reason, email.body.encoded
+
+    get "/account/imports/#{import.id}"
+    assert_response :success
+    assert_match(/Import failed/i, response.body)
+    assert_match import.failure_reason, response.body
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  test "signed-in user cannot view another identity's import" do
+    import = Account::Import.create!(
+      identity: @admin.identity,
+      file: { io: StringIO.new("data"), filename: "test.zip", content_type: "application/zip" }
+    )
+
+    sign_in_as users(:david)
+    clear_enqueued_jobs
+
+    get "/account/imports/#{import.id}"
+    assert_response :not_found
+  end
+
+  test "tenanted request to /account/imports/new redirects away" do
+    sign_in_as @admin
+    clear_enqueued_jobs
+
+    get new_account_import_path
+    assert_redirected_to root_url
+  end
+end
