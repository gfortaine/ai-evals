+<% @page_title = "Account export" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Account Settings", account_settings_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+<% end %>
+
+<div class="panel panel--centered center flex flex-column gap-half" style="--panel-size: 50ch;">
+  <% if @export.downloadable? %>
+    <h1 class="txt-x-large font-weight-black margin-none">Your account export is ready</h1>
+    <p class="margin-none-block-start margin-block-end-half">
+      Your download should start automatically. If it doesn’t, use the button below. This link will expire 24 hours after the export completed.
+    </p>
+
+    <%= link_to "Download account export",
+        rails_blob_path(@export.file, disposition: :attachment),
+        class: "btn btn--link center",
+        data: { controller: "auto-click", turbo: false } %>
+  <% elsif @export.failed? %>
+    <h1 class="txt-x-large font-weight-black margin-none">Export failed</h1>
+    <p class="margin-none-block-start margin-block-end-half">
+      Something went wrong while preparing your account export. Please try starting a new export from Account Settings.
+    </p>
+
+    <%= link_to "Back to Account Settings", account_settings_path, class: "btn center" %>
+  <% else %>
+    <h1 class="txt-x-large font-weight-black margin-none">Preparing your account export…</h1>
+    <p class="margin-none-block-start margin-block-end-half">
+      Your export is still being built. We’ll email you a download link as soon as it’s ready.
+    </p>
+
+    <%= link_to "Back to Account Settings", account_settings_path, class: "btn center" %>
+  <% end %>
+</div>
