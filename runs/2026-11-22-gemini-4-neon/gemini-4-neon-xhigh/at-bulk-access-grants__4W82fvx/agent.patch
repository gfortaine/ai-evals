@@ -0,0 +1,438 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Roster Book", everyone_access: false)
+  end
+
+  test "imports grants in order and notifies each user" do
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: "editor" },
+      { user_id: users(:david).id.to_s, level: :editor }
+    ]
+
+    result = nil
+    assert_enqueued_jobs 3, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_instance_of Book::AccessImport::Result, result
+    assert_nil result.duplicate_index
+    assert_equal 3, result.accesses.size
+    assert_equal [ users(:kevin).id, users(:jz).id, users(:david).id ], result.accesses.map(&:user_id)
+    assert_equal %w[ reader editor editor ], result.accesses.map(&:level)
+    assert result.accesses.all?(&:persisted?)
+    assert result.accesses.all? { |access| access.book_id == @book.id }
+    assert result.accesses.first.reader?
+    assert result.accesses.second.editor?
+
+    result.accesses.each do |access|
+      assert_enqueued_with(job: Book::AccessNotificationJob, args: [ access ])
+    end
+
+    perform_enqueued_jobs
+  end
+
+  test "returned accesses support standard ActiveRecord operations and time zones" do
+    Time.use_zone("America/Chicago") do
+      result = Book::AccessImport.new(@book, [ { user_id: users(:kevin).id, level: :reader } ]).import
+      access = result.accesses.first
+      reloaded = Access.find(access.id)
+
+      assert_equal reloaded.attributes, access.attributes
+      assert_equal reloaded.created_at.zone, access.created_at.zone
+
+      access.update!(level: :editor)
+      assert access.reload.editor?
+    end
+  end
+
+  test "imports an empty list without writing or notifying" do
+    result = nil
+    queries = capture_queries do
+      assert_no_enqueued_jobs do
+        result = Book::AccessImport.new(@book, []).import
+      end
+    end
+
+    assert_equal Book::AccessImport::Result.new([], nil), result
+    assert_empty queries[:writes]
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "accepts a single-pass enumerator of grants" do
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :editor }
+    ].each
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_nil result.duplicate_index
+    assert_equal [ users(:kevin).id, users(:jz).id ], result.accesses.map(&:user_id)
+  end
+
+  test "allows importing users who already have access to another book" do
+    assert books(:handbook).accessable?(user: users(:kevin))
+
+    result = Book::AccessImport.new(@book, [ { user_id: users(:kevin).id, level: :reader } ]).import
+
+    assert_nil result.duplicate_index
+    assert_equal 1, result.accesses.size
+    assert @book.accessable?(user: users(:kevin))
+  end
+
+  test "does not pollute preloaded accesses association on rejection and refreshes it on success" do
+    @book.accesses.load
+    assert_equal 0, @book.accesses.size
+
+    assert_raises(ActiveRecord::RecordInvalid) do
+      Book::AccessImport.new(@book, [
+        { user_id: users(:kevin).id, level: :reader },
+        { user_id: users(:jz).id, level: :bogus }
+      ]).import
+    end
+    assert_equal 0, @book.accesses.size
+
+    Book::AccessImport.new(@book, [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :editor }
+    ]).import
+    assert_equal 2, @book.accesses.size
+  end
+
+  test "rejects duplicate user within the same sheet without writing or notifying" do
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :editor },
+      { user_id: users(:kevin).id.to_s, level: :editor }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal Book::AccessImport::Result.new([], 2), result
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "rejects duplicate user already on the book at index 0 without writing or notifying" do
+    existing = @book.accesses.create!(user: users(:kevin), level: :reader)
+    grants = [
+      { user_id: users(:kevin).id, level: :editor },
+      { user_id: users(:jz).id, level: :reader }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal Book::AccessImport::Result.new([], 0), result
+    assert_equal [ existing.id ], @book.accesses.pluck(:id)
+  end
+
+  test "rejects duplicate user already on the book later in the sheet without writing or notifying" do
+    existing = @book.accesses.create!(user: users(:david), level: :editor)
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :reader },
+      { user_id: users(:david).id, level: :reader }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal Book::AccessImport::Result.new([], 2), result
+    assert_equal [ existing.id ], @book.accesses.pluck(:id)
+  end
+
+  test "rejects unknown level with RecordInvalid instead of ArgumentError without writing or notifying" do
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :superadmin }
+    ]
+
+    error = nil
+    assert_no_enqueued_jobs do
+      error = assert_raises(ActiveRecord::RecordInvalid) do
+        Book::AccessImport.new(@book, grants).import
+      end
+    end
+
+    assert_includes error.record.errors[:level], "is not included in the list"
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "rejects blank or nil level with RecordInvalid without writing or notifying" do
+    [ nil, "" ].each do |bad_level|
+      grants = [
+        { user_id: users(:kevin).id, level: :reader },
+        { user_id: users(:jz).id, level: bad_level }
+      ]
+
+      error = nil
+      assert_no_enqueued_jobs do
+        error = assert_raises(ActiveRecord::RecordInvalid) do
+          Book::AccessImport.new(@book, grants).import
+        end
+      end
+
+      assert_includes error.record.errors[:level], "is not included in the list"
+      assert_equal 0, @book.accesses.count
+    end
+  end
+
+  test "rejects unknown or missing user with RecordInvalid without writing or notifying" do
+    [ -1, nil ].each do |bad_user_id|
+      grants = [
+        { user_id: users(:kevin).id, level: :reader },
+        { user_id: bad_user_id, level: :reader }
+      ]
+
+      error = nil
+      assert_no_enqueued_jobs do
+        error = assert_raises(ActiveRecord::RecordInvalid) do
+          Book::AccessImport.new(@book, grants).import
+        end
+      end
+
+      assert_includes error.record.errors[:user], "must exist"
+      assert_equal 0, @book.accesses.count
+    end
+  end
+
+  test "preserves row-order precedence between duplicates and invalid rows" do
+    dup_first = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:kevin).id, level: :editor },
+      { user_id: users(:jz).id, level: :bogus }
+    ]
+    assert_no_enqueued_jobs do
+      result = Book::AccessImport.new(@book, dup_first).import
+      assert_equal Book::AccessImport::Result.new([], 1), result
+    end
+
+    invalid_first = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :bogus },
+      { user_id: users(:kevin).id, level: :editor }
+    ]
+    assert_no_enqueued_jobs do
+      assert_raises(ActiveRecord::RecordInvalid) do
+        Book::AccessImport.new(@book, invalid_first).import
+      end
+    end
+
+    both_on_same_row = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:kevin).id, level: :bogus }
+    ]
+    assert_no_enqueued_jobs do
+      assert_raises(ActiveRecord::RecordInvalid) do
+        Book::AccessImport.new(@book, both_on_same_row).import
+      end
+    end
+  end
+
+  test "does not notify if an enclosing transaction rolls back" do
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :editor }
+    ]
+
+    assert_no_enqueued_jobs do
+      ActiveRecord::Base.transaction do
+        Book::AccessImport.new(@book, grants).import
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "notifies once an enclosing transaction commits" do
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :editor }
+    ]
+
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob do
+      ActiveRecord::Base.transaction do
+        Book::AccessImport.new(@book, grants).import
+      end
+    end
+
+    assert_equal 2, @book.accesses.count
+  end
+
+  test "sixteen names costs the same database writes as four when taken" do
+    batch_users = create_users(16)
+
+    book_4 = Book.create!(title: "Book 4", everyone_access: false)
+    book_16 = Book.create!(title: "Book 16", everyone_access: false)
+
+    grants_4 = batch_users.first(4).map { |u| { user_id: u.id, level: :reader } }
+    grants_16 = batch_users.map { |u| { user_id: u.id, level: :reader } }
+
+    queries_4 = capture_queries { Book::AccessImport.new(book_4, grants_4).import }
+    queries_16 = capture_queries { Book::AccessImport.new(book_16, grants_16).import }
+
+    assert_equal 1, queries_4[:writes].size
+    assert_equal queries_4[:writes].size, queries_16[:writes].size
+    assert_equal queries_4[:reads].size, queries_16[:reads].size
+    assert_equal 4, book_4.accesses.count
+    assert_equal 16, book_16.accesses.count
+  end
+
+  test "large roster imports in a single write query" do
+    batch_users = create_users(200)
+    grants = batch_users.each_with_index.map do |u, index|
+      { user_id: u.id, level: index.even? ? :reader : :editor }
+    end
+
+    result = nil
+    queries = capture_queries do
+      assert_enqueued_jobs 200, only: Book::AccessNotificationJob do
+        result = Book::AccessImport.new(@book, grants).import
+      end
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal 1, queries[:writes].size
+    assert_equal 2, queries[:reads].size
+    assert_equal batch_users.map(&:id), result.accesses.map(&:user_id)
+    assert_equal 200, @book.accesses.count
+  end
+
+  test "sixteen names costs the same database writes as four when turned down for duplicates" do
+    batch_users = create_users(16)
+
+    dup_4 = batch_users.first(3).map { |u| { user_id: u.id, level: :reader } } + [ { user_id: batch_users[0].id, level: :editor } ]
+    dup_16 = batch_users.first(15).map { |u| { user_id: u.id, level: :reader } } + [ { user_id: batch_users[0].id, level: :editor } ]
+
+    queries_4 = capture_queries do
+      result = Book::AccessImport.new(@book, dup_4).import
+      assert_equal 3, result.duplicate_index
+    end
+
+    queries_16 = capture_queries do
+      result = Book::AccessImport.new(@book, dup_16).import
+      assert_equal 15, result.duplicate_index
+    end
+
+    assert_equal 0, queries_4[:writes].size
+    assert_equal queries_4[:writes].size, queries_16[:writes].size
+    assert_equal queries_4[:reads].size, queries_16[:reads].size
+  end
+
+  test "sixteen names costs the same database writes as four when turned down for an existing access" do
+    batch_users = create_users(16)
+    @book.accesses.create!(user: batch_users.last, level: :reader)
+
+    grants_4 = batch_users.first(3).map { |u| { user_id: u.id, level: :reader } } + [ { user_id: batch_users.last.id, level: :editor } ]
+    grants_16 = batch_users.first(15).map { |u| { user_id: u.id, level: :reader } } + [ { user_id: batch_users.last.id, level: :editor } ]
+
+    queries_4 = capture_queries do
+      result = Book::AccessImport.new(@book, grants_4).import
+      assert_equal 3, result.duplicate_index
+    end
+
+    queries_16 = capture_queries do
+      result = Book::AccessImport.new(@book, grants_16).import
+      assert_equal 15, result.duplicate_index
+    end
+
+    assert_equal 0, queries_4[:writes].size
+    assert_equal queries_4[:writes].size, queries_16[:writes].size
+    assert_equal queries_4[:reads].size, queries_16[:reads].size
+  end
+
+  test "sixteen names costs the same database writes as four when turned down for an invalid level" do
+    batch_users = create_users(16)
+
+    bad_4 = batch_users.first(3).map { |u| { user_id: u.id, level: :reader } } + [ { user_id: batch_users[3].id, level: :wizard } ]
+    bad_16 = batch_users.first(15).map { |u| { user_id: u.id, level: :reader } } + [ { user_id: batch_users[15].id, level: :wizard } ]
+
+    queries_4 = capture_queries do
+      assert_raises(ActiveRecord::RecordInvalid) { Book::AccessImport.new(@book, bad_4).import }
+    end
+
+    queries_16 = capture_queries do
+      assert_raises(ActiveRecord::RecordInvalid) { Book::AccessImport.new(@book, bad_16).import }
+    end
+
+    assert_equal 0, queries_4[:writes].size
+    assert_equal queries_4[:writes].size, queries_16[:writes].size
+    assert_equal queries_4[:reads].size, queries_16[:reads].size
+  end
+
+  test "handles concurrent RecordNotUnique race condition cleanly" do
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :editor }
+    ]
+
+    @book.accesses.create!(user: users(:jz), level: :reader)
+
+    importer = Book::AccessImport.new(@book, grants)
+    importer.define_singleton_method(:validate_and_find_duplicate) { |_candidates| nil }
+    importer.define_singleton_method(:insert_accesses) { |_candidates| raise ActiveRecord::RecordNotUnique, "simulated race" }
+
+    result = nil
+    assert_no_enqueued_jobs do
+      result = importer.import
+    end
+
+    assert_equal Book::AccessImport::Result.new([], 1), result
+    assert_equal 1, @book.accesses.count
+  end
+
+  test "access validates unknown level instead of raising ArgumentError" do
+    access = Access.new(book: @book, user: users(:kevin), level: :unknown)
+
+    assert_not access.valid?
+    assert_includes access.errors[:level], "is not included in the list"
+  end
+
+  private
+    def create_users(count)
+      rows = count.times.map do |i|
+        {
+          name: "Batch User #{i}",
+          email_address: "batch-user-#{i}@example.com",
+          password_digest: "digest",
+          role: 0,
+          active: true
+        }
+      end
+      ids = User.insert_all!(rows, returning: %w[ id ]).rows.flatten
+      User.where(id: ids).order(:id).to_a
+    end
+
+    def capture_queries
+      queries = { reads: [], writes: [] }
+      callback = lambda do |*, payload|
+        next if payload[:name] == "SCHEMA" || payload[:name] == "TRANSACTION"
+
+        sql = payload[:sql]
+        if sql.match?(/\A\s*(INSERT|UPDATE|DELETE)/i)
+          queries[:writes] << sql
+        elsif sql.match?(/\A\s*SELECT/i)
+          queries[:reads] << sql
+        end
+      end
+
+      ActiveSupport::Notifications.subscribed(callback, "sql.active_record") do
+        yield
+      end
+
+      queries
+    end
+end
