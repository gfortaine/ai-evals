diff --git a/test/controllers/books/releases_controller_test.rb b/test/controllers/books/releases_controller_test.rb
new file mode 100644
index 0000000..ca31c9b
--- /dev/null
+++ b/test/controllers/books/releases_controller_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    @book = books(:manual)
+    sign_in :david
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "edit renders release form for an editor" do
+    get edit_book_release_path(@book)
+
+    assert_response :success
+    assert_in_body "Release this book"
+  end
+
+  test "non-editor cannot access release actions" do
+    sign_in :jz
+
+    get edit_book_release_path(@book)
+    assert_response :forbidden
+
+    patch book_release_path(@book), params: { book: { title: "Unauthorized Release" } }
+    assert_response :forbidden
+    assert_not @book.reload.published?
+  end
+
+  test "releasing a book shows the new title and published status in recently updated" do
+    patch book_release_path(@book), params: { book: { title: "Published Manual", subtitle: "Edition 1" } }
+    assert_redirected_to root_path
+
+    follow_redirect!
+    assert_response :success
+    assert_select ".library__recents" do
+      assert_select "strong", text: "Published Manual"
+      assert_select "strong", text: "Manual", count: 0
+      assert_select "span", text: "Published"
+    end
+
+    get book_slug_path(@book.reload)
+    assert_response :success
+    assert_in_body "Published Manual"
+  end
+
+  test "renaming a book updates the recently updated list" do
+    patch book_path(@book), params: { book: { title: "Renamed Manual" } }
+    assert_redirected_to book_slug_path(@book.reload)
+
+    get root_path
+    assert_response :success
+    assert_select ".library__recents" do
+      assert_select "strong", text: "Renamed Manual"
+      assert_select "span", text: "Draft"
+    end
+  end
+
+  test "released book recap disappears from recently updated after expiration" do
+    patch book_release_path(@book), params: { book: { title: "Published Manual" } }
+    assert_redirected_to root_path
+
+    travel Rails.application.config.x.recap.expires_in + 1.second do
+      get root_path
+      assert_response :success
+      assert_select ".library__recents", count: 0
+    end
+  end
+
+  test "releasing an already published book redirects to the book without changing it" do
+    @book.update!(published: true)
+
+    patch book_release_path(@book), params: { book: { title: "Changed Again" } }
+    assert_redirected_to book_slug_path(@book)
+
+    assert_equal "Manual", @book.reload.title
+    assert_equal({ title: "Manual", published: true }, @book.cached_recap)
+  end
+end
diff --git a/test/models/book/recap_test.rb b/test/models/book/recap_test.rb
new file mode 100644
index 0000000..ef18cd3
--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "updating a book caches its recap" do
+    book = books(:manual)
+    book.update!(title: "Updated Manual")
+
+    assert_equal({ title: "Updated Manual", published: false }, book.cached_recap)
+  end
+
+  test "recaps are stored per book without overwriting each other" do
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    handbook.update!(title: "Handbook Second Edition")
+    manual.update!(title: "Manual Final", published: true)
+
+    assert_equal({ title: "Handbook Second Edition", published: false }, handbook.cached_recap)
+    assert_equal({ title: "Manual Final", published: true }, manual.cached_recap)
+  end
+
+  test "recaps expire on the configured schedule" do
+    book = books(:manual)
+    expires_in = Rails.application.config.x.recap.expires_in
+
+    book.update!(title: "Expiring Manual")
+    assert_equal({ title: "Expiring Manual", published: false }, book.cached_recap)
+
+    travel expires_in - 1.minute do
+      assert_equal({ title: "Expiring Manual", published: false }, book.cached_recap)
+    end
+
+    travel expires_in + 1.second do
+      assert_nil book.cached_recap
+    end
+  end
+
+  test "recap reflects committed attributes when multiple instances are updated in one transaction" do
+    first = Book.find(books(:manual).id)
+    second = Book.find(books(:manual).id)
+
+    Book.transaction do
+      first.update!(title: "Released Title")
+      second.update!(published: true)
+    end
+
+    assert_equal({ title: "Released Title", published: true }, books(:manual).cached_recap)
+  end
+
+  test "recap reflects committed attributes when a leaf touch runs on a separate book instance in the same transaction" do
+    book = books(:handbook)
+    leaf = Leaf.find(leaves(:welcome_page).id)
+    leaf.book # preload separate Book instance with old title
+
+    Book.transaction do
+      book.update!(title: "Renamed Handbook")
+      leaf.update!(title: "Updated Welcome")
+    end
+
+    assert_equal({ title: "Renamed Handbook", published: false }, book.cached_recap)
+  end
+
+  test "rolled back updates do not write a recap" do
+    book = books(:manual)
+
+    Book.transaction do
+      book.update!(title: "Rolled Back Title")
+      raise ActiveRecord::Rollback
+    end
+
+    assert_nil book.cached_recap
+  end
+end
diff --git a/test/models/book/release_test.rb b/test/models/book/release_test.rb
new file mode 100644
index 0000000..c9dfad5
--- /dev/null
+++ b/test/models/book/release_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Book::ReleaseTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "finalize_release publishes the book and caches the recap with the released title" do
+    book = books(:manual)
+
+    assert Book.finalize_release(book.id, title: "Final Manual", subtitle: "First Edition")
+
+    book.reload
+    assert_equal "Final Manual", book.title
+    assert_equal "First Edition", book.subtitle
+    assert book.published?
+    assert_equal({ title: "Final Manual", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release preserves existing subtitle when subtitle is nil" do
+    book = books(:manual)
+    book.update!(subtitle: "Existing Subtitle")
+
+    assert Book.finalize_release(book.id, title: "Final Manual")
+
+    book.reload
+    assert_equal "Final Manual", book.title
+    assert_equal "Existing Subtitle", book.subtitle
+    assert book.published?
+    assert_equal({ title: "Final Manual", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release returns false and does not modify an already published book" do
+    book = books(:manual)
+    book.update!(published: true)
+
+    assert_not Book.finalize_release(book.id, title: "Should Not Change")
+
+    book.reload
+    assert_equal "Manual", book.title
+    assert_equal({ title: "Manual", published: true }, book.cached_recap)
+  end
+
+  test "finalize_release does not overwrite another book's recap" do
+    books(:handbook).update!(title: "Updated Handbook")
+
+    assert Book.finalize_release(books(:manual).id, title: "Released Manual")
+
+    assert_equal({ title: "Updated Handbook", published: false }, books(:handbook).cached_recap)
+    assert_equal({ title: "Released Manual", published: true }, books(:manual).cached_recap)
+  end
+
+  test "finalize_release raises when book does not exist" do
+    assert_raises ActiveRecord::RecordNotFound do
+      Book.finalize_release(-1, title: "Missing")
+    end
+  end
+end
