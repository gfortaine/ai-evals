index 90020f0..b555658 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,14 @@
 module TimeHelper
+  def local_datetime_tag(datetime, style: :time, **attributes)
+    return unless datetime
+
+    data = attributes.delete(:data) || {}
+    classes = [ "local-time-value", attributes.delete(:class) ]
+    iso_timestamp = datetime.respond_to?(:utc) ? datetime.utc.iso8601 : datetime.iso8601
+
+    tag.time **attributes,
+      class: classes,
+      datetime: iso_timestamp,
+      data: data.merge(local_time_target: style)
+  end
 end
