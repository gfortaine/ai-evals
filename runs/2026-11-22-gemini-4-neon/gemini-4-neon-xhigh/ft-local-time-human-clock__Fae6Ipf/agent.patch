diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..b78ef2f
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,122 @@
+import { Controller } from "@hotwired/stimulus"
+import {
+  formatTime,
+  formatDate,
+  formatShortDate,
+  formatDateTime,
+  formatFullDateTime,
+  formatRelativeTime,
+  formatRelativeDay,
+  formatInDays
+} from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static targets = [ "time", "date", "shortdate", "datetime", "relative", "day", "indays" ]
+
+  #timer
+  #formatters = {
+    time: (date) => formatTime(date),
+    date: (date) => formatDate(date),
+    shortdate: (date, now) => formatShortDate(date, now),
+    datetime: (date) => formatDateTime(date),
+    relative: (date, now) => formatRelativeTime(date, now),
+    day: (date, now) => formatRelativeDay(date, now),
+    indays: (date, now) => formatInDays(date, now)
+  }
+
+  connect() {
+    this.#timer = setInterval(() => this.refreshAll(), REFRESH_INTERVAL)
+    this.element.addEventListener("turbo:morph-element", this.#handleMorphElement)
+    document.addEventListener("visibilitychange", this.#handleVisibilityChange)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+    this.element.removeEventListener("turbo:morph-element", this.#handleMorphElement)
+    document.removeEventListener("visibilitychange", this.#handleVisibilityChange)
+  }
+
+  timeTargetConnected(target) {
+    this.#refreshTarget(target, "time")
+  }
+
+  dateTargetConnected(target) {
+    this.#refreshTarget(target, "date")
+  }
+
+  shortdateTargetConnected(target) {
+    this.#refreshTarget(target, "shortdate")
+  }
+
+  datetimeTargetConnected(target) {
+    this.#refreshTarget(target, "datetime")
+  }
+
+  relativeTargetConnected(target) {
+    this.#refreshTarget(target, "relative")
+  }
+
+  dayTargetConnected(target) {
+    this.#refreshTarget(target, "day")
+  }
+
+  indaysTargetConnected(target) {
+    this.#refreshTarget(target, "indays")
+  }
+
+  refreshAll() {
+    const now = new Date()
+
+    for (const style of Object.keys(this.#formatters)) {
+      for (const target of this[`${style}Targets`]) {
+        this.#refreshTarget(target, style, now)
+      }
+    }
+  }
+
+  #handleMorphElement = (event) => {
+    const target = event.target
+    const targets = target?.dataset?.localTimeTarget?.split(/\s+/)
+    if (!targets) return
+
+    for (const style of targets) {
+      if (this.#formatters[style]) {
+        this.#refreshTarget(target, style)
+      }
+    }
+  }
+
+  #handleVisibilityChange = () => {
+    if (!document.hidden) {
+      this.refreshAll()
+    }
+  }
+
+  #refreshTarget(target, style, now = new Date()) {
+    const datetime = target.getAttribute("datetime") || target.dataset.datetime
+    if (!datetime) return
+
+    const date = new Date(datetime)
+    if (isNaN(date.getTime())) return
+
+    const formatted = this.#formatters[style](date, now)
+    const attribute = target.dataset.localTimeAttribute
+
+    if (attribute) {
+      if (target.getAttribute(attribute) !== formatted) {
+        target.setAttribute(attribute, formatted)
+      }
+    } else {
+      if (target.textContent !== formatted) {
+        target.textContent = formatted
+      }
+
+      const title = formatFullDateTime(date)
+      if (target.title !== title) {
+        target.title = title
+      }
+    }
+  }
+}
