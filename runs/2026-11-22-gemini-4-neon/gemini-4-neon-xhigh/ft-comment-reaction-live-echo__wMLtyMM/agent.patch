new file mode 100644
index 0000000..ef873c7
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,60 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.ordered.preload(reacter: [ :avatar_attachment, :account ])
+  end
+
+  def new
+    @reaction = @comment.reactions.new
+  end
+
+  def create
+    @reaction = @comment.reactions.new(reaction_params)
+
+    respond_to do |format|
+      if @reaction.save
+        format.turbo_stream
+        format.html { redirect_to @card }
+        format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+      else
+        format.turbo_stream { render turbo_stream: turbo_stream.replace([ @comment, :new_reaction ], partial: "cards/comments/reactions/new", locals: { comment: @comment, reaction: @reaction }), status: :unprocessable_entity }
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to @card }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..7b88b1e
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,56 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { reacterId: String }
+  static targets = [ "delete" ]
+
+  connect() {
+    this.syncOwnership()
+  }
+
+  deleteTargetConnected(element) {
+    if (!this.#isOwnedByCurrentUser) {
+      element.remove()
+    }
+  }
+
+  syncOwnership() {
+    if (this.#isOwnedByCurrentUser) {
+      this.element.classList.add("reaction--deleteable")
+    } else if (this.hasDeleteTarget) {
+      this.deleteTarget.remove()
+    }
+  }
+
+  toggle(event) {
+    if (!this.#isOwnedByCurrentUser) return
+    if (event.target.closest("form")) return
+
+    event.preventDefault()
+    this.element.classList.toggle("expanded")
+  }
+
+  collapse() {
+    this.element.classList.remove("expanded")
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) {
+      this.collapse()
+    }
+  }
+
+  delete() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  restoreOnFailure(event) {
+    if (!event.detail.success) {
+      this.element.classList.remove("reaction--deleting")
+    }
+  }
+
+  get #isOwnedByCurrentUser() {
+    return window.Current?.user?.id === this.reacterIdValue
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
