diff --git a/app/views/cards/comments/reactions/_new.html.erb b/app/views/cards/comments/reactions/_new.html.erb
new file mode 100644
index 0000000..b971021
--- /dev/null
+++ b/app/views/cards/comments/reactions/_new.html.erb
@@ -0,0 +1,75 @@
+<%= turbo_frame_tag comment, :new_reaction do %>
+  <div class="reaction reaction__form expanded" data-controller="morph-guard">
+    <figure class="reaction__avatar margin-none flex-item-no-shrink">
+      <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true, class: "btn btn--circle" %>
+    </figure>
+
+    <%= form_with model: reaction,
+          url: card_comment_reactions_path(comment.card, comment),
+          class: "flex align-center gap-half",
+          data: {
+            controller: "form reaction-form",
+            action: "keydown.esc->form#cancel:stop submit->form#preventEmptySubmit submit->form#preventComposingSubmit compositionstart->form#compositionStart compositionend->form#compositionEnd"
+          } do |form| %>
+      <label class="reaction__form-label flex align-center">
+        <%= form.text_field :content,
+              class: "input reaction__input txt-small",
+              maxlength: 16,
+              required: true,
+              autofocus: true,
+              autocomplete: "off",
+              placeholder: "React…",
+              aria: { label: "Add a reaction" },
+              data: {
+                form_target: "input",
+                reaction_form_target: "input"
+              } %>
+      </label>
+
+      <div class="reaction__menu"
+           data-controller="dialog"
+           data-action="click@document->dialog#closeOnClickOutside">
+        <button type="button"
+                class="reaction__menu-btn btn btn--circle borderless fill-transparent"
+                data-action="click->dialog#toggle:stop"
+                title="Pick an emoji">
+          <%= icon_tag "reaction" %>
+          <span class="for-screen-reader">Pick an emoji</span>
+        </button>
+
+        <dialog class="reaction__popup popup panel shadow"
+                data-dialog-target="dialog"
+                data-action="keydown.esc->dialog#close:stop turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
+          <div class="reaction__emoji-list">
+            <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+              <button type="button"
+                      class="btn btn--circle borderless fill-transparent"
+                      title="<%= label %>"
+                      aria-label="<%= label %>"
+                      data-emoji="<%= emoji %>"
+                      data-action="click->reaction-form#pickEmoji click->dialog#close">
+                <%= emoji %>
+              </button>
+            <% end %>
+          </div>
+        </dialog>
+      </div>
+
+      <%= form.button type: :submit,
+            class: "reaction__submit-btn btn btn--circle borderless fill-transparent",
+            title: "Save reaction",
+            data: { form_target: "submit" } do %>
+        <%= icon_tag "check-circle" %>
+        <span class="for-screen-reader">Save reaction</span>
+      <% end %>
+
+      <%= link_to card_comment_reactions_path(comment.card, comment),
+            class: "reaction__cancel-btn btn btn--circle borderless fill-transparent",
+            title: "Cancel",
+            data: { form_target: "cancel", turbo_frame: dom_id(comment, :new_reaction) } do %>
+        <%= icon_tag "close-circle" %>
+        <span class="for-screen-reader">Cancel</span>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
