+
+    logout_and_sign_in_as :david
+
+    get card_comment_reactions_path(private_card, private_comment), as: :json
+    assert_response :not_found
+
+    post card_comment_reactions_path(private_card, private_comment), params: { reaction: { content: "👀" } }, as: :json
+    assert_response :not_found
+  end
+
+  test "comment JSON includes reactions_url" do
+    get card_comment_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal card_comment_reactions_url(@card, @comment), @response.parsed_body["reactions_url"]
+  end
+
+  test "comment fragment cache invalidates when reactions are added or removed" do
+    previous_cache_store = ActionController::Base.cache_store
+    ActionController::Base.cache_store = ActiveSupport::Cache.lookup_store(:memory_store)
+
+    with_actionview_partial_caching do
+      get card_path(@card)
+      assert_response :success
+      assert_select "##{ActionView::RecordIdentifier.dom_id(@comment)} .reactions__list .reaction", count: 0
+
+      reaction = @comment.reactions.create!(content: "🚀", reacter: users(:david))
+
+      get card_path(@card)
+      assert_response :success
+      assert_select "##{ActionView::RecordIdentifier.dom_id(@comment)} .reactions__list .reaction", count: 1
+      assert_select "##{ActionView::RecordIdentifier.dom_id(reaction)}", text: /🚀/
+
+      reaction.destroy!
+
+      get card_path(@card)
+      assert_response :success
+      assert_select "##{ActionView::RecordIdentifier.dom_id(@comment)} .reactions__list .reaction", count: 0
+    end
