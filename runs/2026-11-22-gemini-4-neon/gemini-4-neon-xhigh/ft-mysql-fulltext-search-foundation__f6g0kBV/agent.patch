diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..bd69b47
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,53 @@
+<% card = result.card %>
+
+<article id="<%= dom_id(card, :search_result) %>" class="search__result" style="--card-color: <%= card.color %>">
+  <header class="search__result-header flex align-center gap-half txt-x-small translucent">
+    <span class="search__result-board">
+      <%= link_to card.board.name, card.board, class: "txt-ink", data: { turbo_frame: "_top" } %>
+    </span>
+    <span aria-hidden="true">&middot;</span>
+    <span class="search__result-number">#<%= card.number %></span>
+    <% if card.closed? %>
+      <span class="search__result-status">Done</span>
+    <% elsif card.postponed? %>
+      <span class="search__result-status">Not now</span>
+    <% elsif card.triaged? %>
+      <span class="search__result-status"><%= card.column.name %></span>
+    <% end %>
+    <span class="margin-inline-start-auto">
+      <%= local_datetime_tag card.created_at, style: :agoorweekday %>
+    </span>
+  </header>
+
+  <h2 class="search__result-title">
+    <%= link_to result.highlighted_title, card_path(card), class: "search__result-link", data: { turbo_frame: "_top" } %>
+  </h2>
+
+  <% if result.description_matched? || (result.matching_comments.none? && result.description_text.present?) %>
+    <p class="search__result-excerpt">
+      <%= result.highlighted_description %>
+    </p>
+  <% end %>
+
+  <% if result.matching_comments.any? %>
+    <ul class="search__result-comments flex flex-column gap-half" role="list">
+      <% result.displayed_matching_comments.each do |comment| %>
+        <li class="search__result-comment">
+          <%= link_to card_path(card, anchor: dom_id(comment)), class: "search__result-comment-link", data: { turbo_frame: "_top" } do %>
+            <span class="search__result-comment-author txt-x-small translucent">
+              <%= comment.creator.name %> commented
+            </span>
+            <p class="search__result-comment-body">
+              <%= result.highlighted_comment_body(comment) %>
+            </p>
+          <% end %>
+        </li>
+      <% end %>
+      <% if result.remaining_matching_comments_count > 0 %>
+        <li class="search__result-more-comments txt-x-small translucent">
+          <%= link_to "+ #{pluralize(result.remaining_matching_comments_count, "more matching comment")}", card_path(card), data: { turbo_frame: "_top" } %>
+        </li>
+      <% end %>
+    </ul>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..1234931
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,42 @@
+<% @page_title = @search.present? ? "Search: #{@search.query}" : "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search panel panel--wide center borderless unpad flex flex-column gap">
+  <%= form_with url: search_path, method: :get, class: "search__form flex align-center gap-half" do |form| %>
+    <div class="input input--actor flex align-center gap-half full-width">
+      <%= icon_tag "search", class: "translucent flex-item-no-shrink" %>
+      <%= form.search_field :q,
+            value: @search.query.to_s,
+            placeholder: "Search cards and comments…",
+            aria: { label: "Search cards and comments" },
+            autofocus: !@search.present?,
+            autocomplete: "off",
+            class: "input full-width" %>
+    </div>
+    <%= form.button type: "submit", class: "btn btn--reversed flex-item-no-shrink" do %>
+      <span>Search</span>
+    <% end %>
+  <% end %>
+
+  <% if @search.present? %>
+    <% if @page.records.any? %>
+      <div class="search__results flex flex-column gap-half">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "searches/result", collection: @page.records.map { |card| @search.result_for(card) }, as: :result %>
+        <% end %>
+      </div>
+    <% else %>
+      <div class="blank-slate">No cards match “<%= @search.query %>”</div>
+    <% end %>
+  <% else %>
+    <div class="blank-slate">Search for cards by title, description, or comment</div>
+  <% end %>
+</section>
diff --git a/config/routes.rb b/config/routes.rb
