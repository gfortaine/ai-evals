@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Search::HighlighterTest < ActiveSupport::TestCase
+  test "wraps matched words in mark preserving case" do
+    highlighter = Search::Highlighter.new(Search::Query.new("layout"))
+    assert_equal "<mark>Layout</mark> is broken", highlighter.highlight("Layout is broken")
+  end
+
+  test "wraps multiple matched words in mark" do
+    highlighter = Search::Highlighter.new(Search::Query.new("logo big"))
+    assert_equal "The <mark>logo</mark> isn&#39;t <mark>big</mark> enough", highlighter.highlight("The logo isn't big enough")
+  end
+
+  test "wraps prefix-matched whole word in mark" do
+    highlighter = Search::Highlighter.new(Search::Query.new("overflow"))
+    assert_equal "The text is <mark>overflowing</mark> the container.", highlighter.highlight("The text is overflowing the container.")
+  end
+
+  test "escapes HTML to prevent XSS" do
+    highlighter = Search::Highlighter.new(Search::Query.new("script"))
+    result = highlighter.highlight('<script>alert("xss")</script>')
+    assert_equal "&lt;<mark>script</mark>&gt;alert(&quot;xss&quot;)&lt;/<mark>script</mark>&gt;", result
+    assert result.html_safe?
+  end
+
+  test "does not corrupt HTML entities" do
+    amp_highlighter = Search::Highlighter.new(Search::Query.new("amp"))
+    assert_equal "A &amp; B", amp_highlighter.highlight("A & B")
+
+    att_highlighter = Search::Highlighter.new(Search::Query.new("AT&T"))
+    assert_equal "Call <mark>AT&amp;T</mark> today", att_highlighter.highlight("Call AT&T today")
+  end
+
+  test "excerpt centers snippet around deep match in long text" do
+    prefix = ("alpha beta gamma " * 30).strip
+    suffix = ("delta epsilon zeta " * 30).strip
+    long_text = "#{prefix} flamingo #{suffix}"
+
+    highlighter = Search::Highlighter.new(Search::Query.new("flamingo"))
+    excerpt = highlighter.excerpt(long_text)
+
+    assert_includes excerpt, "<mark>flamingo</mark>"
+    assert excerpt.start_with?("…")
+    assert excerpt.end_with?("…")
+    assert_operator excerpt.length, :<, 300
+  end
+end
diff --git a/test/models/search/query_test.rb b/test/models/search/query_test.rb
new file mode 100644
index 0000000..e53bd67
--- /dev/null
+++ b/test/models/search/query_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Search::QueryTest < ActiveSupport::TestCase
+  test "blank and non-string queries" do
+    [ nil, "", "   ", [ "foo" ], { a: "b" } ].each do |input|
+      query = Search::Query.new(input)
+      assert_not query.present?
+      assert_not query.valid?
+      assert_empty query.terms
+      assert_empty query.sql_tokens
+      assert_equal "", query.to_s
+    end
+  end
+
+  test "empty quotes query is present but not valid" do
+    query = Search::Query.new('""')
+    assert query.present?
+    assert_not query.valid?
+    assert_empty query.terms
+  end
+
+  test "parses words and deduplicates case-insensitively" do
+    query = Search::Query.new("  Logo   BIG  logo ")
+    assert query.valid?
+    assert_equal [ "Logo", "BIG" ], query.terms
+    assert_equal [ "logo", "big" ], query.sql_tokens
+  end
+
+  test "parses quoted phrases and remaining words" do
+    query = Search::Query.new('"big enough" logo')
+    assert_equal [ "big enough", "logo" ], query.terms
+    assert_equal [ "big", "enough", "logo" ], query.sql_tokens
+  end
+
+  test "handles unbalanced quotes gracefully" do
+    query = Search::Query.new('"unclosed phrase here')
+    assert_equal [ "unclosed", "phrase", "here" ], query.terms
+  end
+
+  test "matches words at word boundaries and prefixes" do
+    query = Search::Query.new("overflow")
+    assert query.matches_any?("The text is overflowing the container.")
+
+    go_query = Search::Query.new("go")
+    assert_not go_query.matches_any?("The logo isn't big enough")
+    assert go_query.matches_any?("Let's go now")
+
+    profile_query = Search::Query.new("profile")
+    assert profile_query.matches_any?("Update user_profile_settings")
+  end
+
+  test "matches quoted phrases across whitespace" do
+    query = Search::Query.new('"big enough"')
+    assert query.matches_any?("The logo isn't big enough")
+    assert query.matches_any?("The logo isn't big\n  enough")
+    assert_not query.matches_any?("The logo isn't big and enough")
+  end
+
+  test "matches Unicode case-insensitively and CJK" do
+    cafe = Search::Query.new("café")
+    assert cafe.matches_any?("Visit the CAFÉ tomorrow")
+    assert_equal [ "caf" ], cafe.sql_tokens
+
+    umlaut = Search::Query.new("ÖÄ")
+    assert umlaut.matches_any?("Test öä value")
+    assert_empty umlaut.sql_tokens
+
+    cjk = Search::Query.new("日本語")
+    assert cjk.matches_any?("テスト日本語です")
+    assert_equal [ "日本語" ], cjk.sql_tokens
+  end
+
+  test "matches special punctuation and regex metacharacters safely" do
+    cpp = Search::Query.new("C++")
+    assert cpp.matches_any?("Rewrite in C++ now")
+    assert_not cpp.matches_any?("Rewrite in AC++ now")
+
+    regex_chars = Search::Query.new("foo.*bar")
+    assert regex_chars.matches_any?("Check foo.*bar literally")
+    assert_not regex_chars.matches_any?("Check fooXYZbar")
+  end
+end
