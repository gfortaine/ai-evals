@@ -0,0 +1,178 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "finds cards by title" do
+    results = Search.new(user: users(:david), query: "logo").cards.to_a
+    assert_equal [ cards(:logo) ], results
+  end
+
+  test "finds cards by description" do
+    cards(:buy_domain).update!(description: "Register a shiny <p><strong>pineapple</strong></p> domain")
+
+    results = Search.new(user: users(:david), query: "pineapple").cards.to_a
+    assert_equal [ cards(:buy_domain) ], results
+  end
+
+  test "finds cards by comment body" do
+    results = Search.new(user: users(:david), query: "overflowing").cards.to_a
+    assert_equal [ cards(:layout) ], results
+  end
+
+  test "finds cards when query words span title, description, and comments" do
+    cards(:buy_domain).update!(description: "Check DNS registrar")
+    cards(:buy_domain).comments.create!(body: "Let's use Cloudflare for this", creator: users(:david))
+
+    results = Search.new(user: users(:david), query: "domain registrar cloudflare").cards.to_a
+    assert_equal [ cards(:buy_domain) ], results
+  end
+
+  test "deduplicates cards matching across title, description, and multiple comments" do
+    card = boards(:writebook).cards.create!(
+      title: "Flamingo header",
+      description: "Make the flamingo bigger",
+      status: :published,
+      creator: users(:david)
+    )
+    card.comments.create!(body: "First flamingo note", creator: users(:david))
+    card.comments.create!(body: "Second flamingo note", creator: users(:kevin))
+
+    results = Search.new(user: users(:david), query: "flamingo").cards.to_a
+    assert_equal [ card ], results
+  end
+
+  test "orders matching cards newest first" do
+    oldest = boards(:writebook).cards.create!(title: "Zebra one", created_at: 3.days.ago, status: :published, creator: users(:david))
+    middle = boards(:writebook).cards.create!(title: "Zebra two", created_at: 2.days.ago, status: :published, creator: users(:david))
+    newest = boards(:writebook).cards.create!(title: "Zebra three", created_at: 1.day.ago, status: :published, creator: users(:david))
+
+    # Even if oldest gets a brand new comment, card ordering stays newest first
+    oldest.comments.create!(body: "Zebra comment", creator: users(:david), created_at: Time.current)
+
+    results = Search.new(user: users(:david), query: "zebra").cards.to_a
+    assert_equal [ newest, middle, oldest ], results
+  end
+
+  test "only returns cards from boards the user currently has access to" do
+    private_card = boards(:private).cards.create!(title: "Secret unicorn project", status: :published, creator: users(:kevin))
+
+    assert_empty Search.new(user: users(:david), query: "unicorn").cards.to_a
+    assert_equal [ private_card ], Search.new(user: users(:kevin), query: "unicorn").cards.to_a
+
+    # Grant access to David -> immediately visible
+    boards(:private).accesses.grant_to(users(:david))
+    assert_equal [ private_card ], Search.new(user: users(:david), query: "unicorn").cards.to_a
+
+    # Revoke access from David -> immediately hidden
+    boards(:private).accesses.revoke_from(users(:david))
+    assert_empty Search.new(user: users(:david), query: "unicorn").cards.to_a
+  end
+
+  test "reflects card board moves immediately" do
+    card = boards(:writebook).cards.create!(title: "Nomad card", status: :published, creator: users(:kevin))
+    assert_equal [ card ], Search.new(user: users(:david), query: "nomad").cards.to_a
+
+    card.move_to(boards(:private))
+    assert_empty Search.new(user: users(:david), query: "nomad").cards.to_a
+    assert_equal [ card ], Search.new(user: users(:kevin), query: "nomad").cards.to_a
+
+    card.move_to(boards(:writebook))
+    assert_equal [ card ], Search.new(user: users(:david), query: "nomad").cards.to_a
+  end
+
+  test "never leaks cards from other accounts" do
+    assert_empty Search.new(user: users(:david), query: "radio").cards.to_a
+    assert_empty Search.new(user: users(:david), query: "paycheck").cards.to_a
+
+    Current.account = accounts(:initech)
+    assert_equal [ cards(:radio) ], Search.new(user: users(:mike), query: "radio").cards.to_a
+  end
+
+  test "never returns draft cards or their comments" do
+    draft = boards(:writebook).cards.create!(
+      title: "Drafted platypus title",
+      description: "Drafted platypus description",
+      status: :drafted,
+      creator: users(:david)
+    )
+    comment = draft.comments.build(body: "Drafted platypus comment", creator: users(:david), account: draft.account)
+    comment.rich_text_body.account = draft.account
+    comment.save!(validate: false)
+
+    assert_empty Search.new(user: users(:david), query: "platypus").cards.to_a
+
+    # Also verify reverting a published card with comments to drafted excludes both card and comments
+    published = boards(:writebook).cards.create!(title: "Published narwhal", status: :published, creator: users(:david))
+    published.comments.create!(body: "Narwhal discussion", creator: users(:david))
+    assert_equal [ published ], Search.new(user: users(:david), query: "narwhal").cards.to_a
+
+    published.drafted!
+    assert_empty Search.new(user: users(:david), query: "narwhal").cards.to_a
+    assert_empty Search.new(user: users(:david), query: "discussion").cards.to_a
+
+    # Publishing a draft makes it searchable
+    draft.publish
+    assert_equal [ draft ], Search.new(user: users(:david), query: "platypus").cards.to_a
+  end
+
+  test "excludes system comments such as title changes" do
+    card = boards(:writebook).cards.create!(title: "Original alpaca", status: :published, creator: users(:david))
+    assert_equal [ card ], Search.new(user: users(:david), query: "alpaca").cards.to_a
+
+    card.update!(title: "Updated llama")
+    assert_empty Search.new(user: users(:david), query: "alpaca").cards.to_a
+    assert_equal [ card ], Search.new(user: users(:david), query: "llama").cards.to_a
+  end
+
+  test "does not match HTML tags or attributes in rich text" do
+    cards(:buy_domain).update!(description: '<p>Check <a href="https://hidden-url.example">this <strong>link</strong></a></p>')
+
+    assert_empty Search.new(user: users(:david), query: "strong").cards.to_a
+    assert_empty Search.new(user: users(:david), query: "href").cards.to_a
+    assert_empty Search.new(user: users(:david), query: "hidden-url").cards.to_a
+    assert_equal [ cards(:buy_domain) ], Search.new(user: users(:david), query: "link").cards.to_a
+  end
+
+  test "matches phrases across inline HTML tags and HTML entities" do
+    card = boards(:writebook).cards.create!(
+      title: "Support card",
+      description: "<p>Call <strong>AT&amp;T</strong> right <em>now</em></p>",
+      status: :published,
+      creator: users(:david)
+    )
+
+    assert_equal [ card ], Search.new(user: users(:david), query: "AT&T").cards.to_a
+    assert_equal [ card ], Search.new(user: users(:david), query: '"right now"').cards.to_a
+  end
+
+  test "handles SQL LIKE wildcards literally" do
+    percent_card = boards(:writebook).cards.create!(title: "100% done", status: :published, creator: users(:david))
+    boards(:writebook).cards.create!(title: "1000 items", status: :published, creator: users(:david))
+
+    assert_equal [ percent_card ], Search.new(user: users(:david), query: "100%").cards.to_a
+    assert_empty Search.new(user: users(:david), query: "%").cards.to_a.reject { |c| c == percent_card }
+  end
+
+  test "handles Unicode case-insensitive search" do
+    card = boards(:writebook).cards.create!(title: "CAFÉ opening", status: :published, creator: users(:david))
+
+    assert_equal [ card ], Search.new(user: users(:david), query: "café").cards.to_a
+  end
+
+  test "includes closed and postponed published cards" do
+    cards(:shipping).close unless cards(:shipping).closed?
+    assert_equal [ cards(:shipping) ], Search.new(user: users(:david), query: "ship").cards.to_a
+
+    cards(:buy_domain).postpone
+    assert_equal [ cards(:buy_domain) ], Search.new(user: users(:david), query: "domain").cards.to_a
+  end
+
+  test "blank query returns no cards" do
+    assert_empty Search.new(user: users(:david), query: nil).cards.to_a
+    assert_empty Search.new(user: users(:david), query: "").cards.to_a
+    assert_empty Search.new(user: users(:david), query: "   ").cards.to_a
+  end
+end
