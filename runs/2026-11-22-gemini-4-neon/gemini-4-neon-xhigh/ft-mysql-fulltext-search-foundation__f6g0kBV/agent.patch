@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Search::ResultTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "highlighted_title falls back to Untitled when title is blank" do
+    card = cards(:logo)
+    card.update_column(:title, nil)
+
+    result = Search::Result.new(card: card, query: Search::Query.new("logo"))
+    assert_equal "Untitled", result.highlighted_title
+  end
+
+  test "displayed_matching_comments excludes non-matching and system comments" do
+    card = boards(:writebook).cards.create!(title: "Status card", status: :published)
+    card.close # creates a system comment
+    matching = card.comments.create!(body: "Discussing tangerine design", creator: users(:david))
+    card.comments.create!(body: "Unrelated comment", creator: users(:kevin))
+
+    result = Search::Result.new(card: card.reload, query: Search::Query.new("tangerine"))
+    assert_equal [ matching ], result.matching_comments
+    assert_equal [ matching ], result.displayed_matching_comments
+    assert_equal 0, result.remaining_matching_comments_count
+    assert_includes result.highlighted_comment_body(matching), "<mark>tangerine</mark>"
+  end
+
+  test "displayed_matching_comments caps count while covering all matched terms" do
+    card = boards(:writebook).cards.create!(title: "Unrelated title", status: :published)
+    alpha = card.comments.create!(body: "First alpha mention", created_at: 5.hours.ago)
+    beta_1 = card.comments.create!(body: "Beta comment one", created_at: 4.hours.ago)
+    beta_2 = card.comments.create!(body: "Beta comment two", created_at: 3.hours.ago)
+    beta_3 = card.comments.create!(body: "Beta comment three", created_at: 2.hours.ago)
+    beta_4 = card.comments.create!(body: "Beta comment four", created_at: 1.hour.ago)
+
+    result = Search::Result.new(card: card.reload, query: Search::Query.new("alpha beta"))
+
+    assert_equal 5, result.matching_comments.size
+    assert_equal 3, result.displayed_matching_comments.size
+    assert_equal 2, result.remaining_matching_comments_count
+    assert_includes result.displayed_matching_comments, alpha
+    assert_includes result.displayed_matching_comments, beta_4
+    assert_includes result.displayed_matching_comments, beta_3
+    assert_not_includes result.displayed_matching_comments, beta_1
+    assert_not_includes result.displayed_matching_comments, beta_2
+  end
+end
