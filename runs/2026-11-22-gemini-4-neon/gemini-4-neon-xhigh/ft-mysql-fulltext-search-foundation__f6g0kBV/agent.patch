+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path(q: "logo")
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "show without query renders search form and empty state" do
+    get search_path
+    assert_response :success
+    assert_select "form[action=?][method='get'] input[name='q']", search_path
+    assert_select ".search__result", count: 0
+  end
+
+  test "show with blank query returns no results" do
+    get search_path(q: "   ")
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "show finds card by title with matched words wrapped in mark" do
+    get search_path(q: "logo big")
+    assert_response :success
+
+    assert_select "input[name='q'][value='logo big']"
+    assert_select ".search__result", count: 1
+    assert_select ".search__result-link[href=?]", card_path(cards(:logo))
+    assert_select ".search__result-title mark", text: "logo"
+    assert_select ".search__result-title mark", text: "big"
+  end
+
+  test "show finds card by description with matched words wrapped in mark" do
+    cards(:buy_domain).update!(description: "Check the registrar pricing for pineapple domains")
+
+    get search_path(q: "pineapple")
+    assert_response :success
+
+    assert_select ".search__result", count: 1
+    assert_select ".search__result-link[href=?]", card_path(cards(:buy_domain))
+    assert_select ".search__result-excerpt mark", text: "pineapple"
+  end
+
+  test "show highlights match deep inside a long description" do
+    filler = ("lorem ipsum dolor sit amet " * 25).strip
+    cards(:buy_domain).update!(description: "#{filler} kumquat #{filler}")
+
+    get search_path(q: "kumquat")
+    assert_response :success
+
+    assert_select ".search__result", count: 1
+    assert_select ".search__result-excerpt mark", text: "kumquat"
+  end
+
+  test "show finds card by comment body with matched words wrapped in mark" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select ".search__result", count: 1
+    assert_select ".search__result-link[href=?]", card_path(cards(:layout))
+    assert_select ".search__result-comment-link[href=?]", card_path(cards(:layout), anchor: dom_id(comments(:layout_overflowing_david)))
+    assert_select ".search__result-comment-body mark", text: "overflowing"
+  end
+
+  test "show renders results newest first" do
+    older, newer = with_current_user(:david) do
+      [
+        boards(:writebook).cards.create!(title: "Quokka older", created_at: 3.days.ago, status: :published),
+        boards(:writebook).cards.create!(title: "Quokka newer", created_at: 1.day.ago, status: :published)
+      ]
+    end
+
+    get search_path(q: "quokka")
+    assert_response :success
+
+    result_ids = css_select(".search__result").map { |el| el["id"] }
+    assert_equal [ dom_id(newer, :search_result), dom_id(older, :search_result) ], result_ids
+  end
+
+  test "show only returns results from boards user currently has access to" do
+    private_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Classified falcon", status: :published)
+    end
+
+    get search_path(q: "falcon")
+    assert_response :success
+    assert_select ".search__result", count: 0
+
+    boards(:private).accesses.grant_to(users(:david))
+    get search_path(q: "falcon")
+    assert_response :success
+    assert_select ".search__result", count: 1
+    assert_select ".search__result-link[href=?]", card_path(private_card)
+
+    boards(:private).accesses.revoke_from(users(:david))
+    get search_path(q: "falcon")
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "show updates immediately when a card moves between boards" do
+    card = with_current_user(:kevin) do
+      boards(:writebook).cards.create!(title: "Migrating osprey", status: :published)
+    end
+
+    get search_path(q: "osprey")
+    assert_response :success
+    assert_select ".search__result", count: 1
+
+    with_current_user(:kevin) { card.move_to(boards(:private)) }
+
+    get search_path(q: "osprey")
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "show does not return cards from other accounts" do
+    get search_path(q: "radio")
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "show reflects title edits and comment deletions immediately" do
+    card = with_current_user(:david) do
+      boards(:writebook).cards.create!(title: "Initial wallaby", status: :published)
+    end
+    comment = with_current_user(:david) do
+      card.comments.create!(body: "Temporary wombat note")
+    end
+
+    get search_path(q: "wallaby")
+    assert_select ".search__result", count: 1
+    get search_path(q: "wombat")
+    assert_select ".search__result", count: 1
+
+    with_current_user(:david) do
+      card.update!(title: "Renamed kangaroo")
+      comment.destroy!
+    end
+
+    get search_path(q: "wallaby")
+    assert_select ".search__result", count: 0
+    get search_path(q: "wombat")
+    assert_select ".search__result", count: 0
+    get search_path(q: "kangaroo")
+    assert_select ".search__result", count: 1
+  end
+
+  test "show never turns up draft cards or their comments" do
+    draft = boards(:writebook).cards.create!(
+      title: "Secretive badger draft",
+      description: "Badger description",
+      status: :drafted,
+      creator: users(:david)
+    )
+    comment = draft.comments.build(body: "Badger comment", creator: users(:david), account: draft.account)
+    comment.rich_text_body.account = draft.account
+    comment.save!(validate: false)
+
+    get search_path(q: "badger")
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "show escapes HTML to prevent XSS in card content and query" do
+    with_current_user(:david) do
+      boards(:writebook).cards.create!(
+        title: '<script>alert("xss")</script> pelican',
+        description: "<img src=x onerror=alert(1)> pelican body",
+        status: :published
+      )
+    end
+
+    get search_path(q: "pelican")
+    assert_response :success
+    assert_no_match %r{<script>alert\("xss"\)</script>}, response.body
+    assert_select ".search__result-title mark", text: "pelican"
+
+    get search_path(q: "<script>alert(1)</script>")
+    assert_response :success
+    assert_no_match %r{<script>alert\(1\)</script>}, response.body
+  end
+
+  test "show handles pagination" do
+    with_current_user(:david) do
+      18.times do |i|
+        boards(:writebook).cards.create!(
+          title: "Paginated kiwi #{i}",
+          created_at: (20 - i).hours.ago,
+          status: :published
+        )
+      end
+    end
+
+    get search_path(q: "kiwi")
+    assert_response :success
+    assert_select ".search__result", count: 15
+    assert_select "a.pagination-link[href*='page=2']"
+
+    get search_path(q: "kiwi", page: 2)
+    assert_response :success
+    assert_select ".search__result", count: 3
+  end
+
+  test "show handles non-string q param safely" do
+    get "#{search_path}?q[]=logo"
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "show includes no results message when nothing matches" do
+    get search_path(q: "nonexistenttermxyz")
+    assert_response :success
+    assert_select ".search__result", count: 0
+    assert_select ".blank-slate", text: /nonexistenttermxyz/
+  end
+
+  test "navigation menu links to search" do
+    get my_menu_path
+    assert_response :success
+    assert_select "a[href=?]", search_path
+  end
+end
