diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..453a8f8
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,450 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  #saveQueue = Promise.resolve()
+  #pendingSaves = 0
+  #deferredRefresh = false
+  #dragStartTimer = null
+  #handleViewportChange = null
+
+  connect() {
+    this.mediaQuery = window.matchMedia(this.desktopBreakpointValue)
+    this.#handleViewportChange = this.#updateDraggableItems.bind(this)
+    this.mediaQuery.addEventListener("change", this.#handleViewportChange)
+    this.#updateDraggableItems()
+  }
+
+  disconnect() {
+    this.mediaQuery?.removeEventListener("change", this.#handleViewportChange)
+    this.#clearDragState()
+    this.itemTargets.forEach(item => item.removeAttribute("draggable"))
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = this.#isDesktop
+  }
+
+  // Actions
+
+  dragStart(event) {
+    if (!this.#isDesktop) return
+
+    const item = this.#itemFrom(event.target)
+    const sourceContainer = this.#containerFrom(item)
+    if (!item || !sourceContainer) return
+
+    this.draggedItem = item
+    this.sourceContainer = sourceContainer
+
+    item.removeAttribute("aria-selected")
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.id)
+    }
+
+    // Apply dimmed style on the next tick so the browser captures the normal card as the drag image
+    this.#dragStartTimer = setTimeout(() => {
+      if (this.draggedItem === item) {
+        item.classList.add(this.draggedItemClass)
+      }
+    }, 0)
+  }
+
+  dragEnter(event) {
+    if (!this.draggedItem) return
+
+    this.#updateHoverContainer(event)
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    this.#updateHoverContainer(event)
+  }
+
+  dragLeave(event) {
+    if (!this.draggedItem || !this.hoveredContainer) return
+    if (!this.hoveredContainer.contains(event.target)) return
+
+    if (!event.relatedTarget || !this.hoveredContainer.contains(event.relatedTarget)) {
+      this.#clearHoveredContainer()
+    }
+  }
+
+  drop(event) {
+    if (!this.draggedItem) return
+
+    const item = this.draggedItem
+    const sourceContainer = this.sourceContainer
+    const targetContainer = this.#containerFrom(event.target)
+
+    this.#clearDragState()
+
+    if (!targetContainer || targetContainer === sourceContainer) {
+      this.#flushDeferredRefreshIfIdle()
+      return
+    }
+
+    event.preventDefault()
+
+    this.#moveCard(item, sourceContainer, targetContainer)
+  }
+
+  dragEnd() {
+    this.#clearDragState()
+    this.#flushDeferredRefreshIfIdle()
+  }
+
+  deferRefresh(event) {
+    const streamElement = event.target
+    if (streamElement?.action !== "refresh") return
+
+    const requestId = streamElement.getAttribute("request-id")
+    if (requestId && Turbo.session?.recentRequests?.has(requestId)) return
+
+    if (this.draggedItem || this.#pendingSaves > 0) {
+      event.preventDefault()
+      this.#deferredRefresh = true
+    }
+  }
+
+  // Private
+
+  get #isDesktop() {
+    return (this.mediaQuery || window.matchMedia(this.desktopBreakpointValue)).matches
+  }
+
+  #updateDraggableItems() {
+    const draggable = this.#isDesktop
+    this.itemTargets.forEach(item => {
+      item.draggable = draggable
+    })
+  }
+
+  #itemFrom(element) {
+    if (!(element instanceof Element)) return null
+    const item = element.closest('[data-drag-and-drop-target~="item"]')
+    return item && this.element.contains(item) ? item : null
+  }
+
+  #containerFrom(element) {
+    if (!(element instanceof Element)) return null
+    const container = element.closest('[data-drag-and-drop-target~="container"]')
+    return container && this.element.contains(container) ? container : null
+  }
+
+  #updateHoverContainer(event) {
+    const container = this.#containerFrom(event.target)
+
+    if (container && container !== this.sourceContainer) {
+      event.preventDefault()
+      if (event.dataTransfer) {
+        event.dataTransfer.dropEffect = "move"
+      }
+      this.#setHoveredContainer(container)
+    } else {
+      this.#clearHoveredContainer()
+    }
+  }
+
+  #setHoveredContainer(container) {
+    if (this.hoveredContainer === container) return
+
+    this.#clearHoveredContainer()
+    this.hoveredContainer = container
+    container.classList.add(this.hoverContainerClass)
+  }
+
+  #clearHoveredContainer() {
+    if (this.hoveredContainer) {
+      this.hoveredContainer.classList.remove(this.hoverContainerClass)
+      this.hoveredContainer = null
+    }
+  }
+
+  #clearDragState() {
+    clearTimeout(this.#dragStartTimer)
+    this.#dragStartTimer = null
+
+    if (this.draggedItem) {
+      this.draggedItem.classList.remove(this.draggedItemClass)
+      this.draggedItem = null
+    }
+
+    this.sourceContainer = null
+    this.#clearHoveredContainer()
+  }
+
+  #moveCard(card, sourceContainer, targetContainer) {
+    const snapshot = this.#snapshotCard(card, sourceContainer, targetContainer)
+
+    this.#clearSourceSelection(sourceContainer)
+    this.#applyCardStateFor(card, targetContainer)
+    const insertedIntoList = this.#insertCardInto(card, targetContainer)
+    this.#adjustCount(sourceContainer, -1)
+    this.#adjustCount(targetContainer, +1)
+
+    this.#enqueueSave(snapshot, insertedIntoList)
+  }
+
+  #clearSourceSelection(sourceContainer) {
+    const listElement = sourceContainer.querySelector('[data-controller~="navigable-list"]')
+    if (!listElement) return
+
+    const navigableList = this.application.getControllerForElementAndIdentifier(listElement, "navigable-list")
+    navigableList?.clearSelection()
+  }
+
+  #snapshotCard(card, sourceContainer, targetContainer) {
+    const stamp = card.querySelector(".card__closed")
+    const updatedTime = card.querySelector(".card__meta-text--updated time")
+    const bubble = card.querySelector(".bubble")
+
+    return {
+      card,
+      sourceContainer,
+      targetContainer,
+      parent: card.parentNode,
+      nextSibling: card.nextSibling,
+      cardColor: card.style.getPropertyValue("--card-color"),
+      wasActive: card.classList.contains("card--active"),
+      wasPostponed: card.classList.contains("card--postponed"),
+      action: card.dataset.action,
+      stamp,
+      stampParent: stamp?.parentNode,
+      stampNextSibling: stamp?.nextSibling,
+      updatedDatetime: updatedTime?.getAttribute("datetime"),
+      bubbleEntropy: bubble?.dataset.bubbleEntropyValue,
+      bubbleStalled: bubble?.dataset.bubbleStalledValue
+    }
+  }
+
+  #applyCardStateFor(card, targetContainer) {
+    const action = targetContainer.dataset.dragAndDropAction
+    const cardColor = targetContainer.dataset.cardColor
+
+    if (cardColor) {
+      card.style.setProperty("--card-color", cardColor)
+    }
+
+    card.classList.toggle("card--active", action === "triage" || action === "untriage")
+    card.classList.toggle("card--postponed", action === "postpone")
+    card.removeAttribute("aria-selected")
+
+    card.querySelector(".card__closed")?.remove()
+
+    this.#toggleHoverSelect(card, action !== "close")
+
+    const updatedTime = card.querySelector(".card__meta-text--updated time")
+    if (updatedTime) {
+      updatedTime.setAttribute("datetime", Math.floor(Date.now() / 1000))
+    }
+
+    const bubble = card.querySelector(".bubble")
+    if (bubble) {
+      this.#resetBubble(bubble)
+    }
+  }
+
+  #toggleHoverSelect(card, enabled) {
+    const hoverAction = "mouseenter->navigable-list#hoverSelect"
+    const actions = (card.dataset.action || "").split(/\s+/).filter(Boolean)
+    const hasHoverAction = actions.includes(hoverAction)
+
+    if (enabled && !hasHoverAction) {
+      actions.push(hoverAction)
+    } else if (!enabled && hasHoverAction) {
+      actions.splice(actions.indexOf(hoverAction), 1)
+    }
+
+    if (actions.length > 0) {
+      card.dataset.action = actions.join(" ")
+    } else {
+      delete card.dataset.action
+    }
+  }
+
+  #resetBubble(bubble) {
+    if (bubble.dataset.bubbleEntropyValue) {
+      try {
+        const entropy = JSON.parse(bubble.dataset.bubbleEntropyValue)
+        const futureDate = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000)
+        entropy.closesAt = futureDate.toISOString()
+        bubble.dataset.bubbleEntropyValue = JSON.stringify(entropy)
+      } catch {
+        // Ignore malformed JSON
+      }
+    }
+
+    delete bubble.dataset.bubbleStalledValue
+    bubble.hidden = true
+  }
+
+  #insertCardInto(card, targetContainer) {
+    const list = targetContainer.querySelector(".cards__list")
+    if (!list) {
+      card.remove()
+      return false
+    }
+
+    const existingCards = Array.from(list.querySelectorAll('[data-drag-and-drop-target~="item"]'))
+    const goldenFirst = targetContainer.dataset.dragAndDropGoldenFirst === "true"
+    const isCardGolden = card.classList.contains("golden-effect")
+
+    if (existingCards.length > 0) {
+      if (goldenFirst && !isCardGolden) {
+        const lastGoldenCard = existingCards.findLast(existing => existing.classList.contains("golden-effect"))
+        if (lastGoldenCard) {
+          lastGoldenCard.after(card)
+        } else {
+          existingCards[0].before(card)
+        }
+      } else {
+        existingCards[0].before(card)
+      }
+    } else {
+      const paginationFrame = list.querySelector('turbo-frame[id*="-pagination-contents-"]')
+      const insertionTarget = paginationFrame || list
+      insertionTarget.prepend(card)
+    }
+
+    return true
+  }
+
+  #adjustCount(container, delta) {
+    const countElement = container.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const currentCount = parseInt(countElement.dataset.count ?? countElement.textContent, 10)
+    if (Number.isNaN(currentCount)) return
+
+    const nextCount = Math.max(0, currentCount + delta)
+    countElement.dataset.count = nextCount
+    countElement.textContent = nextCount > 99 ? "99+" : String(nextCount)
+
+    const button = container.querySelector(".cards__expander")
+    if (button) {
+      button.style.setProperty("--card-count", Math.min(nextCount, 15))
+    }
+  }
+
+  #enqueueSave(snapshot, insertedIntoList) {
+    this.#pendingSaves++
+
+    this.#saveQueue = this.#saveQueue.then(async () => {
+      try {
+        const response = await this.#performMoveRequest(snapshot.card, snapshot.targetContainer)
+        if (!response?.ok) {
+          this.#revertMove(snapshot)
+        } else if (!insertedIntoList) {
+          snapshot.targetContainer.querySelector("turbo-frame")?.reload()
+        }
+      } catch {
+        this.#revertMove(snapshot)
+      } finally {
+        this.#pendingSaves--
+        this.#flushDeferredRefreshIfIdle()
+      }
+    })
+  }
+
+  #performMoveRequest(card, targetContainer) {
+    const action = targetContainer.dataset.dragAndDropAction
+    const options = { responseKind: "json", keepalive: true }
+
+    switch (action) {
+      case "triage":
+        if (!card.dataset.cardTriageUrl) return null
+        return post(card.dataset.cardTriageUrl, {
+          ...options,
+          body: { column_id: targetContainer.dataset.dragAndDropColumnId }
+        })
+      case "untriage":
+        if (!card.dataset.cardTriageUrl) return null
+        return destroy(card.dataset.cardTriageUrl, options)
+      case "postpone":
+        if (!card.dataset.cardNotNowUrl) return null
+        return post(card.dataset.cardNotNowUrl, options)
+      case "close":
+        if (!card.dataset.cardClosureUrl) return null
+        return post(card.dataset.cardClosureUrl, options)
+      default:
+        return null
+    }
+  }
+
+  #revertMove(snapshot) {
+    const { card, sourceContainer, targetContainer } = snapshot
+    const currentContainer = this.#containerFrom(card)
+
+    // If the card was already dragged elsewhere after this failed move, leave it where the newer move put it
+    if (currentContainer && currentContainer !== targetContainer) return
+
+    if (snapshot.cardColor) {
+      card.style.setProperty("--card-color", snapshot.cardColor)
+    } else {
+      card.style.removeProperty("--card-color")
+    }
+
+    card.classList.toggle("card--active", snapshot.wasActive)
+    card.classList.toggle("card--postponed", snapshot.wasPostponed)
+
+    if (snapshot.action) {
+      card.dataset.action = snapshot.action
+    } else {
+      delete card.dataset.action
+    }
+
+    if (snapshot.stamp && snapshot.stampParent?.isConnected) {
+      if (snapshot.stampNextSibling?.parentNode === snapshot.stampParent) {
+        snapshot.stampParent.insertBefore(snapshot.stamp, snapshot.stampNextSibling)
+      } else {
+        snapshot.stampParent.append(snapshot.stamp)
+      }
+    }
+
+    const updatedTime = card.querySelector(".card__meta-text--updated time")
+    if (updatedTime && snapshot.updatedDatetime) {
+      updatedTime.setAttribute("datetime", snapshot.updatedDatetime)
+    }
+
+    const bubble = card.querySelector(".bubble")
+    if (bubble) {
+      if (snapshot.bubbleEntropy !== undefined) {
+        bubble.dataset.bubbleEntropyValue = snapshot.bubbleEntropy
+      }
+      if (snapshot.bubbleStalled !== undefined) {
+        bubble.dataset.bubbleStalledValue = snapshot.bubbleStalled
+      }
+    }
+
+    if (snapshot.parent?.isConnected) {
+      if (snapshot.nextSibling?.parentNode === snapshot.parent) {
+        snapshot.parent.insertBefore(card, snapshot.nextSibling)
+      } else {
+        snapshot.parent.append(card)
+      }
+    } else {
+      this.#insertCardInto(card, sourceContainer)
+    }
+
+    this.#adjustCount(sourceContainer, +1)
+    this.#adjustCount(targetContainer, -1)
+  }
+
+  #flushDeferredRefreshIfIdle() {
+    if (this.#deferredRefresh && !this.draggedItem && this.#pendingSaves === 0) {
+      this.#deferredRefresh = false
+      Turbo.session.refresh(document.baseURI, { method: "morph", scroll: "preserve" })
+    }
+  }
+}
