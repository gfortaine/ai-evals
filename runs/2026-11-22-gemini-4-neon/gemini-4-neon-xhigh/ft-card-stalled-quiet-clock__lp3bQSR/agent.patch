diff --git a/test/system/stalled_cards_test.rb b/test/system/stalled_cards_test.rb
new file mode 100644
index 0000000..20200da
--- /dev/null
+++ b/test/system/stalled_cards_test.rb
@@ -0,0 +1,110 @@
+require "application_system_test_case"
+
+class StalledCardsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "stalled card shows stalled bubble on board, cards index, and card page, and resets on activity" do
+    stalled_stream_card = make_stalled(cards(:buy_domain), days_ago: 16)
+    stalled_column_card = make_stalled(cards(:logo), days_ago: 20)
+    normal_card = cards(:layout)
+
+    # 1. Board view shows stalled bubble on stalled card in Maybe? stream
+    visit board_url(boards(:writebook))
+    within("##{dom_id(stalled_stream_card, :article)} .bubble") do
+      assert_selector "[data-bubble-target='top']", text: /Stalled for/i
+      assert_selector "[data-bubble-target='center']", text: "16"
+      assert_selector "[data-bubble-target='bottom']", text: /days/i
+    end
+
+    # Non-stalled card in the board column does not show a visible bubble
+    visit board_column_url(boards(:writebook), columns(:writebook_triage))
+    within("##{dom_id(stalled_column_card, :article)} .bubble") do
+      assert_selector "[data-bubble-target='top']", text: /Stalled for/i
+      assert_selector "[data-bubble-target='center']", text: "20"
+      assert_selector "[data-bubble-target='bottom']", text: /days/i
+    end
+    within("##{dom_id(normal_card, :article)}") do
+      assert_no_selector ".bubble", visible: true
+    end
+
+    # 2. Cards index with indexed_by=stalled lists only stalled cards and shows stalled bubble
+    visit cards_url(indexed_by: :stalled)
+    assert_selector "##{dom_id(stalled_stream_card, :article)}"
+    assert_selector "##{dom_id(stalled_column_card, :article)}"
+    assert_no_selector "##{dom_id(normal_card, :article)}"
+    within("##{dom_id(stalled_stream_card, :article)} .bubble") do
+      assert_selector "[data-bubble-target='top']", text: /Stalled for/i
+      assert_selector "[data-bubble-target='center']", text: "16"
+      assert_selector "[data-bubble-target='bottom']", text: /days/i
+    end
+
+    # 3. Card show page displays the stalled bubble
+    visit card_url(stalled_stream_card)
+    within("##{dom_id(stalled_stream_card, 'bubble')}") do
+      assert_selector "[data-bubble-target='top']", text: /Stalled for/i
+      assert_selector "[data-bubble-target='center']", text: "16"
+      assert_selector "[data-bubble-target='bottom']", text: /days/i
+    end
+
+    # 4. Posting a comment resets the stalled state and hides the bubble
+    within("##{dom_id(stalled_stream_card, :new_comment)}") do
+      find("lexxy-editor [contenteditable='true']").click
+      send_keys "Picking this back up!"
+      click_on "Post"
+    end
+
+    assert_text "Picking this back up!"
+    assert_no_selector "##{dom_id(stalled_stream_card, 'bubble')}", visible: true
+    assert_not stalled_stream_card.reload.stalled?
+
+    # 5. Stalled index no longer includes the reset card
+    visit cards_url(indexed_by: :stalled)
+    assert_no_selector "##{dom_id(stalled_stream_card, :article)}"
+    assert_selector "##{dom_id(stalled_column_card, :article)}"
+  end
+
+  test "filtering by Stalled from the cards index UI lists stalled cards" do
+    stalled_card = make_stalled(cards(:buy_domain), days_ago: 15)
+    normal_card = cards(:layout)
+
+    visit cards_url(expand_all: true)
+    click_on "Status…"
+    click_on "Stalled"
+
+    assert_selector "##{dom_id(stalled_card, :article)}"
+    assert_no_selector "##{dom_id(normal_card, :article)}"
+  end
+
+  test "stalled card shows stalled bubble on public card page and public board column" do
+    boards(:writebook).publish
+    stalled_card = make_stalled(cards(:logo), days_ago: 18)
+
+    visit published_card_url(stalled_card)
+    within("##{dom_id(stalled_card, 'bubble')}") do
+      assert_selector "[data-bubble-target='top']", text: /Stalled for/i
+      assert_selector "[data-bubble-target='center']", text: "18"
+      assert_selector "[data-bubble-target='bottom']", text: /days/i
+    end
+
+    visit public_board_column_url(boards(:writebook).publication.key, columns(:writebook_triage))
+    within("##{dom_id(stalled_card, :article)} .bubble") do
+      assert_selector "[data-bubble-target='top']", text: /Stalled for/i
+      assert_selector "[data-bubble-target='center']", text: "18"
+      assert_selector "[data-bubble-target='bottom']", text: /days/i
+    end
+  end
+
+  private
+    def make_stalled(card, days_ago:)
+      travel_to days_ago.days.ago do
+        Current.set(user: users(:david)) do
+          card.toggle_assignment(users(:david))
+        end
+      end
+      card.reload
+    end
+end
