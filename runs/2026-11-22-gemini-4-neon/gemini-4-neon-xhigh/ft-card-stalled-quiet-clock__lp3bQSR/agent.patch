diff --git a/test/controllers/cards/stalled_test.rb b/test/controllers/cards/stalled_test.rb
new file mode 100644
index 0000000..9ff0272
--- /dev/null
+++ b/test/controllers/cards/stalled_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class Cards::StalledTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "cards index with indexed_by=stalled lists only stalled cards" do
+    stalled = make_stalled(cards(:logo))
+    active = cards(:layout)
+
+    get cards_path(indexed_by: :stalled)
+    assert_response :success
+
+    assert_select "##{dom_id(stalled, :article)}.card--stalled" do
+      assert_select ".bubble:not([hidden])"
+      assert_select "[data-bubble-target='top']", text: "Stalled for"
+      assert_select "[data-bubble-target='bottom']", text: "days"
+    end
+    assert_select "##{dom_id(active, :article)}", count: 0
+  end
+
+  test "cards index as JSON with indexed_by=stalled returns only stalled cards with stalled flag" do
+    stalled = make_stalled(cards(:logo))
+
+    get cards_path(indexed_by: :stalled), as: :json
+    assert_response :success
+
+    returned_ids = @response.parsed_body.map { |card| card["id"] }
+    assert_equal [ stalled.id ], returned_ids
+    assert_equal true, @response.parsed_body.first["stalled"]
+  end
+
+  test "card show displays stalled indicator for stalled card and hides it for non-stalled card" do
+    stalled = make_stalled(cards(:logo))
+
+    get card_path(stalled)
+    assert_response :success
+    assert_select "##{dom_id(stalled, :article)}.card--stalled"
+    assert_select "##{dom_id(stalled, 'bubble')}:not([hidden])" do
+      assert_select "[data-bubble-target='top']", text: "Stalled for"
+      assert_select "[data-bubble-target='center']", text: stalled.stalled_days.to_s
+      assert_select "[data-bubble-target='bottom']", text: "days"
+    end
+
+    get card_path(cards(:layout))
+    assert_response :success
+    assert_select "##{dom_id(cards(:layout), :article)}.card--stalled", count: 0
+    assert_select "##{dom_id(cards(:layout), 'bubble')}[hidden]"
+  end
+
+  test "card show as JSON reflects stalled state" do
+    stalled = make_stalled(cards(:logo))
+
+    get card_path(stalled), as: :json
+    assert_response :success
+    assert_equal true, @response.parsed_body["stalled"]
+
+    get card_path(cards(:layout)), as: :json
+    assert_response :success
+    assert_equal false, @response.parsed_body["stalled"]
+  end
+
+  test "board stream and column views display stalled indicator on stalled cards" do
+    stalled_in_stream = make_stalled(cards(:buy_domain))
+    stalled_in_column = make_stalled(cards(:logo))
+
+    get board_path(boards(:writebook))
+    assert_response :success
+    assert_select "##{dom_id(stalled_in_stream, :article)}.card--stalled" do
+      assert_select ".bubble:not([hidden])"
+      assert_select "[data-bubble-target='top']", text: "Stalled for"
+    end
+
+    get board_column_path(boards(:writebook), columns(:writebook_triage))
+    assert_response :success
+    assert_select "##{dom_id(stalled_in_column, :article)}.card--stalled" do
+      assert_select ".bubble:not([hidden])"
+      assert_select "[data-bubble-target='top']", text: "Stalled for"
+    end
+  end
+
+  test "public board and public card views display stalled indicator on stalled cards" do
+    boards(:writebook).publish
+    stalled_in_column = make_stalled(cards(:logo))
+
+    get public_board_column_path(boards(:writebook).publication.key, columns(:writebook_triage))
+    assert_response :success
+    assert_select "##{dom_id(stalled_in_column, :article)}.card--stalled" do
+      assert_select ".bubble:not([hidden])"
+      assert_select "[data-bubble-target='top']", text: "Stalled for"
+    end
+
+    get published_card_path(stalled_in_column)
+    assert_response :success
+    assert_select "##{dom_id(stalled_in_column, :article)}.card--stalled"
+    assert_select "##{dom_id(stalled_in_column, 'bubble')}:not([hidden])" do
+      assert_select "[data-bubble-target='top']", text: "Stalled for"
+    end
+  end
+
+  test "commenting on a stalled card via controller resets stalled and updates bubble" do
+    stalled = make_stalled(cards(:logo))
+
+    post card_comments_path(stalled), params: { comment: { body: "Back on this!" } }, as: :turbo_stream
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(stalled, "bubble")
+
+    assert_not stalled.reload.stalled?
+
+    get cards_path(indexed_by: :stalled), as: :json
+    assert_equal [], @response.parsed_body
+  end
+
+  test "stalled status appears in filter dropdown options" do
+    get cards_path
+    assert_response :success
+    assert_select "[data-combobox-value='stalled'][data-combobox-label='Stalled']"
+  end
+
+  private
+    def make_stalled(card)
+      travel_to 16.days.ago do
+        Current.set(user: users(:david)) do
+          card.toggle_assignment(users(:david))
+        end
+      end
+      card.reload
+    end
+end
