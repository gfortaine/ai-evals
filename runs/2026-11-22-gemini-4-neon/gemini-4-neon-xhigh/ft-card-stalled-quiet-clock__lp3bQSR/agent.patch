diff --git a/test/models/card/activity_spikes_test.rb b/test/models/card/activity_spikes_test.rb
new file mode 100644
index 0000000..c2a27bc
--- /dev/null
+++ b/test/models/card/activity_spikes_test.rb
@@ -0,0 +1,384 @@
+require "test_helper"
+
+class Card::ActivitySpikesTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    Current.session = sessions(:david)
+  end
+
+  test "card without a burst is not stalled after two weeks of inactivity" do
+    card = boards(:writebook).cards.create!(title: "Quiet card", status: :published)
+
+    travel 3.weeks do
+      assert_not card.reload.stalled?
+      assert_not_includes Card.stalled, card
+    end
+  end
+
+  test "three comments from two people within a third of the board auto-close period triggers a burst" do
+    entropies(:writebook_board).update!(auto_postpone_period: 30.days)
+    card = boards(:writebook).cards.create!(title: "Lively card", status: :published)
+
+    card.comments.create!(creator: users(:david), body: "First")
+    travel 4.days
+    card.comments.create!(creator: users(:kevin), body: "Second")
+    travel 4.days
+    card.comments.create!(creator: users(:david), body: "Third")
+
+    assert card.reload.activity_spiked?
+    assert_not card.stalled?
+
+    travel 13.days
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+
+    travel 1.day
+    assert card.reload.stalled?
+    assert_includes Card.stalled, card
+    assert_equal 14, card.stalled_days
+  end
+
+  test "three comments from only one person does not trigger a burst" do
+    card = boards(:writebook).cards.create!(title: "Monologue", status: :published)
+
+    3.times { |i| card.comments.create!(creator: users(:david), body: "Comment #{i}") }
+
+    assert_not card.reload.activity_spiked?
+
+    travel 3.weeks do
+      assert_not card.reload.stalled?
+    end
+  end
+
+  test "two comments from two people does not trigger a burst" do
+    card = boards(:writebook).cards.create!(title: "Short exchange", status: :published)
+
+    card.comments.create!(creator: users(:david), body: "One")
+    card.comments.create!(creator: users(:kevin), body: "Two")
+
+    assert_not card.reload.activity_spiked?
+
+    travel 3.weeks do
+      assert_not card.reload.stalled?
+    end
+  end
+
+  test "system comments do not count toward a comment burst" do
+    card = boards(:writebook).cards.create!(title: "System chatter", status: :published)
+
+    card.comments.create!(creator: users(:david), body: "User 1")
+    card.comments.create!(creator: users(:kevin), body: "User 2")
+    card.update!(title: "Renamed title") # Creates a system comment
+
+    assert_equal 3, card.comments.count
+    assert_not card.reload.activity_spiked?
+
+    travel 3.weeks do
+      assert_not card.reload.stalled?
+    end
+  end
+
+  test "three comments from two people spread beyond a third of the board auto-close period does not trigger a burst" do
+    entropies(:writebook_board).update!(auto_postpone_period: 30.days) # 1/3 is 10 days
+    card = boards(:writebook).cards.create!(title: "Slow thread", status: :published)
+
+    card.comments.create!(creator: users(:david), body: "Day 0")
+    travel 6.days
+    card.comments.create!(creator: users(:kevin), body: "Day 6")
+    travel 5.days # Day 11 (> 10 days from Day 0)
+    card.comments.create!(creator: users(:david), body: "Day 11")
+
+    assert_not card.reload.activity_spiked?
+
+    travel 3.weeks do
+      assert_not card.reload.stalled?
+    end
+  end
+
+  test "comment burst window uses board auto-close override when present" do
+    entropies(:writebook_board).update!(auto_postpone_period: 90.days) # 1/3 is 30 days
+    card = boards(:writebook).cards.create!(title: "Long period card", status: :published)
+
+    card.comments.create!(creator: users(:david), body: "Day 0")
+    travel 12.days
+    card.comments.create!(creator: users(:kevin), body: "Day 12")
+    travel 12.days # Day 24 (within 30 days)
+    card.comments.create!(creator: users(:david), body: "Day 24")
+
+    assert card.reload.activity_spiked?
+
+    travel 2.weeks do
+      assert card.reload.stalled?
+    end
+  end
+
+  test "comment burst window falls back to account default auto-close period" do
+    entropies(:writebook_board).destroy
+    entropies("37s_account").update!(auto_postpone_period: 30.days) # 1/3 is 10 days
+    card = boards(:writebook).cards.create!(title: "Account entropy card", status: :published)
+
+    card.comments.create!(creator: users(:david), body: "Day 0")
+    travel 6.days
+    card.comments.create!(creator: users(:kevin), body: "Day 6")
+    travel 5.days # Day 11 (> 10 days)
+    card.comments.create!(creator: users(:david), body: "Day 11")
+
+    assert_not card.reload.activity_spiked?
+
+    travel 2.days # Day 13: Day 6 + Day 11 + Day 13 (span 7 days <= 10 days)
+    card.comments.create!(creator: users(:kevin), body: "Day 13")
+
+    assert card.reload.activity_spiked?
+  end
+
+  test "assigning someone triggers a burst and stalls after two weeks" do
+    card = boards(:writebook).cards.create!(title: "Assigned card", status: :published)
+
+    card.toggle_assignment(users(:kevin))
+
+    assert card.reload.activity_spiked?
+    assert_not card.stalled?
+
+    travel 2.weeks do
+      assert card.reload.stalled?
+      assert_includes Card.stalled, card
+    end
+  end
+
+  test "unassigning someone does not trigger a burst" do
+    card = cards(:logo) # Already assigned to jz in fixtures, no burst
+    assert card.assigned_to?(users(:jz))
+
+    card.toggle_assignment(users(:jz))
+
+    assert_not card.reload.activity_spiked?
+
+    travel 3.weeks do
+      assert_not card.reload.stalled?
+    end
+  end
+
+  test "moving a freshly assigned card to a column still stalls after two weeks of inactivity" do
+    card = boards(:writebook).cards.create!(title: "Triaged after assign", status: :published)
+
+    card.toggle_assignment(users(:kevin))
+    card.triage_into(columns(:writebook_in_progress))
+
+    travel 2.weeks do
+      assert card.reload.stalled?
+    end
+  end
+
+  test "reopening a closed card triggers a burst and stalls after two weeks" do
+    card = cards(:shipping)
+    assert card.closed?
+
+    card.reopen
+
+    assert card.reload.activity_spiked?
+    assert_not card.stalled?
+
+    travel 2.weeks do
+      assert card.reload.stalled?
+      assert_includes Card.stalled, card
+    end
+  end
+
+  test "activity before two weeks restarts the inactivity clock" do
+    card = boards(:writebook).cards.create!(title: "Active after burst", status: :published)
+    card.toggle_assignment(users(:kevin))
+
+    travel 10.days
+    card.update!(title: "Refined title")
+
+    travel 5.days # 15 days after burst, 5 days after title change
+    assert_not card.reload.stalled?
+
+    travel 9.days # 14 days after title change
+    assert card.reload.stalled?
+  end
+
+  test "commenting on a stalled card resets it and does not re-trigger burst from pre-reset comments" do
+    entropies(:writebook_board).update!(auto_postpone_period: 90.days) # 1/3 is 30 days
+    card = boards(:writebook).cards.create!(title: "Reset by comment", status: :published)
+
+    card.comments.create!(creator: users(:david), body: "1")
+    card.comments.create!(creator: users(:kevin), body: "2")
+    card.comments.create!(creator: users(:david), body: "3")
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    # A single comment resets it, even though the old 3 comments are still within 30 days
+    card.comments.create!(creator: users(:jz), body: "Checking in")
+    assert_not card.reload.stalled?
+    assert_not card.activity_spiked?
+
+    # Two weeks later with no new burst, it stays un-stalled
+    travel 15.days
+    assert_not card.reload.stalled?
+  end
+
+  test "a new comment burst after resetting a stalled card stalls again after two weeks" do
+    entropies(:writebook_board).update!(auto_postpone_period: 90.days)
+    card = boards(:writebook).cards.create!(title: "Second burst", status: :published)
+
+    card.comments.create!(creator: users(:david), body: "1")
+    card.comments.create!(creator: users(:kevin), body: "2")
+    card.comments.create!(creator: users(:david), body: "3")
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    # First comment resets it (counts as 1 of a new burst)
+    card.comments.create!(creator: users(:jz), body: "New 1")
+    assert_not card.reload.stalled?
+    assert_not card.activity_spiked?
+
+    # Second comment still not enough
+    card.comments.create!(creator: users(:kevin), body: "New 2")
+    assert_not card.reload.activity_spiked?
+
+    # Third comment from 2 people triggers a new burst
+    card.comments.create!(creator: users(:jz), body: "New 3")
+    assert card.reload.activity_spiked?
+    assert_not card.stalled?
+
+    travel 2.weeks
+    assert card.reload.stalled?
+  end
+
+  test "various card activities reset a stalled card" do
+    activities = {
+      title_change: ->(card) { card.update!(title: "Updated title") },
+      description_change: ->(card) { card.update!(description: "Updated description") },
+      triage: ->(card) { card.triage_into(columns(:writebook_in_progress)) },
+      send_back_to_triage: ->(card) {
+        card.send_back_to_triage
+      },
+      board_change: ->(card) { card.move_to(boards(:private)) },
+      card_reaction: ->(card) { card.reactions.create!(content: "👍") },
+      comment_reaction: ->(card) { card.comments.first.reactions.create!(content: "🎉") },
+      comment_edit: ->(card) { card.comments.by_user.first.update!(body: "Edited comment") },
+      step_create: ->(card) { card.steps.create!(content: "Next step") },
+      step_update: ->(card) { card.steps.first.update!(completed: true) },
+      step_destroy: ->(card) { card.steps.first.destroy! },
+      tag_toggle: ->(card) { card.toggle_tag_with("urgent") },
+      gild: ->(card) { card.gild },
+      unassign: ->(card) { card.toggle_assignment(users(:kevin)) }
+    }
+
+    activities.each do |name, action|
+      travel_to Time.current do
+        card = boards(:writebook).cards.create!(title: "Stalled for #{name}", status: :published, column: columns(:writebook_triage))
+        card.comments.create!(creator: users(:david), body: "Seed comment")
+        card.steps.create!(content: "Seed step")
+        card.toggle_assignment(users(:kevin))
+
+        travel 15.days
+        assert card.reload.stalled?, "Expected card to be stalled before #{name}"
+
+        action.call(card)
+        assert_not card.reload.stalled?, "Expected #{name} to reset stalled state"
+        assert_not card.activity_spiked?, "Expected #{name} to clear activity spike"
+
+        travel 15.days
+        assert_not card.reload.stalled?, "Expected card not to re-stall after #{name} with no new burst"
+      end
+    end
+  end
+
+  test "assigning someone to a stalled card resets it now and starts a new burst" do
+    card = boards(:writebook).cards.create!(title: "Reassigned card", status: :published)
+    card.toggle_assignment(users(:kevin))
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    card.toggle_assignment(users(:jz))
+    assert_not card.reload.stalled?
+    assert card.activity_spiked?
+
+    travel 15.days
+    assert card.reload.stalled?
+  end
+
+  test "closed, postponed, and drafted cards are not stalled" do
+    card = boards(:writebook).cards.create!(title: "Will close", status: :published)
+    card.toggle_assignment(users(:kevin))
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    card.close
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+
+    # Postponing a stalled card removes it from stalled
+    postponed_card = boards(:writebook).cards.create!(title: "Will postpone", status: :published)
+    postponed_card.toggle_assignment(users(:kevin))
+    travel 15.days
+    assert postponed_card.reload.stalled?
+
+    postponed_card.postpone
+    assert_not postponed_card.reload.stalled?
+    assert_not_includes Card.stalled, postponed_card
+
+    # Resuming from Not Now does not carry over the old burst
+    postponed_card.triage_into(columns(:writebook_in_progress))
+    travel 15.days
+    assert_not postponed_card.reload.stalled?
+
+    # Drafted card is never stalled
+    draft = cards(:unfinished_thoughts)
+    draft.record_activity_spike
+    draft.update!(last_active_at: 3.weeks.ago)
+    assert_not draft.stalled?
+    assert_not_includes Card.stalled, draft
+  end
+
+  test "indexed_by stalled scope works cross-account" do
+    cards(:logo).toggle_assignment(users(:david))
+    cards(:radio).toggle_assignment(users(:mike))
+
+    travel 15.days do
+      assert_equal cards(:logo, :radio).to_set, Card.indexed_by("stalled").to_set
+    end
+  end
+
+  test "backdating last_active_at after a burst preserves the burst" do
+    card = cards(:layout)
+    card.toggle_assignment(users(:david))
+    card.update!(last_active_at: 3.weeks.ago)
+
+    assert card.reload.stalled?
+    assert_equal 21, card.stalled_days
+    assert_includes Card.stalled, card
+  end
+
+  test "comment reset and subsequent burst work without frozen time" do
+    unfreeze_time
+    entropies(:writebook_board).update!(auto_postpone_period: 90.days)
+    card = boards(:writebook).cards.create!(title: "Real clock card", status: :published)
+
+    travel_to 16.days.ago do
+      card.comments.create!(creator: users(:david), body: "Old 1")
+      card.comments.create!(creator: users(:kevin), body: "Old 2")
+      card.comments.create!(creator: users(:david), body: "Old 3")
+    end
+
+    assert card.reload.stalled?
+
+    # Single comment resets without freezing time (even if comment.created_at < touch_last_active_at by milliseconds)
+    card.comments.create!(creator: users(:jz), body: "New 1")
+    assert_not card.reload.stalled?
+    assert_not card.activity_spiked?
+
+    # Two more comments from a second person complete a new burst of 3
+    card.comments.create!(creator: users(:kevin), body: "New 2")
+    assert_not card.reload.activity_spiked?
+
+    card.comments.create!(creator: users(:jz), body: "New 3")
+    assert card.reload.activity_spiked?
+  end
+end
