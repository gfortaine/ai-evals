diff --git a/app/models/card/activity_spikes.rb b/app/models/card/activity_spikes.rb
new file mode 100644
index 0000000..5980751
--- /dev/null
+++ b/app/models/card/activity_spikes.rb
@@ -0,0 +1,92 @@
+module Card::ActivitySpikes
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  COMMENTS_FOR_BURST = 3
+  USERS_FOR_BURST = 2
+
+  included do
+    has_one :activity_spike, dependent: :destroy, class_name: "Card::ActivitySpike"
+
+    scope :stalled, -> do
+      active
+        .joins(:activity_spike)
+        .where.not(card_activity_spikes: { spiked_at: nil })
+        .where(cards: { last_active_at: ..STALLED_AFTER.ago })
+    end
+
+    after_update :reset_stalled_activity_spike, if: :saved_change_to_last_active_at?
+  end
+
+  def stalled?
+    active? && activity_spiked? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def activity_spiked?
+    activity_spike&.spiked_at.present?
+  end
+
+  def stalls_at
+    last_active_at + STALLED_AFTER if active? && activity_spiked?
+  end
+
+  def stalled_days
+    ((Time.current - last_active_at) / 1.day).floor if stalled?
+  end
+
+  def detect_activity_spike_for_event(event)
+    case event.action
+    when "card_assigned", "card_reopened"
+      record_activity_spike(at: event.created_at)
+    when "card_closed", "card_postponed", "card_auto_postponed"
+      reset_activity_spike(at: event.created_at)
+    end
+  end
+
+  def detect_activity_spike_for_comment(comment)
+    return if comment.creator.system?
+
+    if comment_burst_at?(comment.created_at)
+      record_activity_spike(at: comment.created_at)
+    end
+  end
+
+  def record_activity_spike(at: Time.current)
+    if activity_spike
+      activity_spike.update!(spiked_at: at)
+    else
+      create_activity_spike!(spiked_at: at)
+    end
+  rescue ActiveRecord::RecordNotUnique
+    reload_activity_spike&.update!(spiked_at: at)
+  end
+
+  def reset_activity_spike(at: Time.current)
+    if activity_spike
+      activity_spike.update!(spiked_at: nil, reset_at: at)
+    end
+  end
+
+  private
+    def reset_stalled_activity_spike
+      previous_last_active_at = last_active_at_before_last_save
+
+      if activity_spiked? && previous_last_active_at.present? && previous_last_active_at <= STALLED_AFTER.ago && last_active_at > STALLED_AFTER.ago
+        reset_activity_spike(at: @activity_spike_reset_at || last_active_at)
+      end
+    end
+
+    def comment_burst_at?(timestamp)
+      window_start = [ timestamp - activity_spike_comment_window, activity_spike&.reset_at ].compact.max
+      comments_count, creators_count = comments
+        .by_user
+        .where(created_at: window_start..timestamp)
+        .pick(Arel.sql("COUNT(*)"), Arel.sql("COUNT(DISTINCT comments.creator_id)"))
+
+      comments_count >= COMMENTS_FOR_BURST && creators_count >= USERS_FOR_BURST
+    end
+
+    def activity_spike_comment_window
+      (auto_postpone_period / 3.0).seconds
+    end
+end
