index 0000000..2f2bbb3
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,268 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "erasing an active user removes user, sessions, sign-in events, accesses, and reading marks" do
+    kevin = users(:kevin)
+    david = users(:david)
+
+    kevin_session = kevin.sessions.start!(user_agent: "KevinBrowser", ip_address: "10.0.0.1")
+    david_session = david.sessions.start!(user_agent: "DavidBrowser", ip_address: "10.0.0.2")
+
+    ReadingMark.remember(leaves(:welcome_page), user: kevin)
+    ReadingMark.remember(leaves(:welcome_page), user: david)
+
+    assert_equal 1, SignInEvent.for_address(kevin.email_address).count
+
+    Current.user = david
+    kevin.destroy!
+
+    assert_not User.exists?(kevin.id)
+    assert_not Session.exists?(kevin_session.id)
+    assert Session.exists?(david_session.id)
+    assert_equal 0, SignInEvent.for_address("kevin@example.com").count
+    assert_equal 1, SignInEvent.for_address("david@example.com").count
+    assert_equal 0, Access.where(user_id: kevin.id).count
+    assert_equal 0, ReadingMark.where(user_id: kevin.id).count
+    assert ReadingMark.exists?(user: david, leaf: leaves(:welcome_page))
+  end
+
+  test "erasing a user with active sessions does not record new signed_out events" do
+    kevin = users(:kevin)
+    kevin.sessions.start!(user_agent: "Browser1", ip_address: "10.0.0.1")
+    kevin.sessions.start!(user_agent: "Browser2", ip_address: "10.0.0.2")
+
+    kevin.destroy!
+
+    assert_equal 0, SignInEvent.for_address("kevin@example.com").count
+  end
+
+  test "erasing a user destroys private books, their leaves, edits, leafables, markdowns, blobs, and search hits" do
+    kevin = users(:kevin)
+    david = users(:david)
+
+    Current.user = kevin
+    private_book = Book.create!(title: "Kevin Private Notes", author: "Kevin", everyone_access: false)
+    private_book.cover.attach(
+      io: File.open(file_fixture("reading.webp")),
+      filename: "kevin-cover.webp",
+      content_type: "image/webp"
+    )
+    private_book.update_access(editors: [ kevin.id ], readers: [ david.id ])
+
+    # Edited and trashed page with uploads on both revisions
+    page_leaf = private_book.press(Page.new(body: "kevin_revision_secret_alpha"), title: "Secret Notes")
+    page_leaf.page.body.uploads.attach(
+      io: File.open(file_fixture("reading.webp")),
+      filename: "kevin-upload-v1.webp",
+      content_type: "image/webp"
+    )
+    page_leaf.page.body.save!
+    first_page_id = page_leaf.leafable_id
+    first_markdown_id = page_leaf.page.markdown_body.id
+
+    page_leaf.edit(leafable_params: { body: "kevin_current_secret_beta" })
+    page_leaf.page.body.uploads.attach(
