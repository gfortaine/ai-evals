diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..5faa7a3
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,85 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  DELETED_AUTHOR = "Deleted author"
+  DEACTIVATED_EMAIL_UUID_PATTERN = /(?:-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})+(?=@)/i
+  DEACTIVATED_EMAIL_FALLBACK_PATTERN = /-deactivated-(?!.*-deactivated-)[^@]+(?=@)/
+
+  included do
+    before_destroy :prepare_erasure, prepend: true
+    after_destroy :erase_sign_in_events
+    after_destroy_commit :purge_erased_book_blobs
+  end
+
+  private
+    def prepare_erasure
+      anonymize_shared_books
+      @erased_book_blob_ids = collect_private_book_blob_ids
+      destroy_private_books
+    end
+
+    def anonymize_shared_books
+      created_books.with_everyone_access.find_each do |book|
+        book.update!(creator: nil, author: DELETED_AUTHOR)
+      end
+    end
+
+    def destroy_private_books
+      created_books.where.not(everyone_access: true).find_each(&:destroy!)
+    end
+
+    def collect_private_book_blob_ids
+      book_ids = created_books.where.not(everyone_access: true).pluck(:id)
+      return [] if book_ids.empty?
+
+      leaf_ids = Leaf.where(book_id: book_ids).pluck(:id)
+
+      picture_ids = (
+        Leaf.where(id: leaf_ids, leafable_type: "Picture").pluck(:leafable_id) +
+        Edit.where(leaf_id: leaf_ids, leafable_type: "Picture").pluck(:leafable_id)
+      ).uniq
+
+      page_ids = (
+        Leaf.where(id: leaf_ids, leafable_type: "Page").pluck(:leafable_id) +
+        Edit.where(leaf_id: leaf_ids, leafable_type: "Page").pluck(:leafable_id)
+      ).uniq
+
+      markdown_ids = ActionText::Markdown.where(record_type: "Page", record_id: page_ids).pluck(:id)
+
+      (
+        ActiveStorage::Attachment.where(record_type: "Book", record_id: book_ids).pluck(:blob_id) +
+        ActiveStorage::Attachment.where(record_type: "Picture", record_id: picture_ids).pluck(:blob_id) +
+        ActiveStorage::Attachment.where(record_type: "ActionText::Markdown", record_id: markdown_ids).pluck(:blob_id)
+      ).uniq
+    end
+
+    def erase_sign_in_events
+      SignInEvent.for_address(sign_in_email_addresses).delete_all
+    end
+
+    def purge_erased_book_blobs
+      return if @erased_book_blob_ids.blank?
+
+      ActiveStorage::Blob.where(id: @erased_book_blob_ids).find_each do |blob|
+        next if blob.attachments.exists?
+
+        blob.variant_records.find_each { |variant_record| variant_record.image.purge }
+        blob.preview_image.purge if blob.preview_image.attached?
+        blob.purge
+      end
+    end
+
+    def sign_in_email_addresses
+      addresses = [ email_address ]
+
+      if email_address.present?
+        if email_address.match?(DEACTIVATED_EMAIL_UUID_PATTERN)
+          addresses << email_address.sub(DEACTIVATED_EMAIL_UUID_PATTERN, "")
+        elsif !active? && email_address.match?(DEACTIVATED_EMAIL_FALLBACK_PATTERN)
+          addresses << email_address.sub(DEACTIVATED_EMAIL_FALLBACK_PATTERN, "")
+        end
+      end
+
+      addresses.compact.uniq
+    end
+end
