+  test "erasing a previously deactivated user removes their sign-in events stored under their original email" do
+    kevin = users(:kevin)
+    david = users(:david)
+
+    kevin.sessions.start!(user_agent: "Safari", ip_address: "10.0.0.5")
+    SignInEvent.create!(email_address: "kevin@example.com", action: :signed_out, ip_address: "10.0.0.5", user_agent: "Safari")
+    SignInEvent.create!(email_address: "david@example.com", action: :signed_in, ip_address: "10.0.0.6", user_agent: "Chrome")
+
+    Current.user = kevin
+    private_book = Book.create!(title: "Old Private Book", author: "Kevin", everyone_access: false)
+    private_leaf = private_book.press(Page.new(body: "deactivated_user_secret_phrase"), title: "Old Secret")
+    shared_book = Book.create!(title: "Old Shared Book", author: "Kevin", everyone_access: true)
+    shared_book.update_access(editors: [ kevin.id ], readers: [ david.id ])
+    ReadingMark.remember(private_leaf, user: kevin)
+    ReadingMark.remember(leaves(:welcome_page), user: kevin)
+
+    # Simulate legacy removal
+    kevin.deactivate
+    deactivated_email = kevin.reload.email_address
+    assert_not kevin.active?
+    assert_match(/\Akevin-deactivated-[0-9a-f-]+@example\.com\z/i, deactivated_email)
+
+    # Also test a sign-in event somehow recorded under the deactivated address
+    SignInEvent.create!(email_address: deactivated_email, action: :signed_out)
+
+    Current.user = david
+    kevin.destroy!
+
+    assert_not User.exists?(kevin.id)
+    assert_equal 0, SignInEvent.for_address("kevin@example.com").count
+    assert_equal 0, SignInEvent.for_address(deactivated_email).count
+    assert_equal 1, SignInEvent.for_address("david@example.com").count
+    assert_equal 0, ReadingMark.where(user_id: kevin.id).count
+    assert_not Book.exists?(private_book.id)
+    assert_empty Leaf.search("deactivated_user_secret_phrase")
+
+    shared_book.reload
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+  end
+
+  test "erasing a deactivated user with special characters in local part or non-standard token strips deactivation suffix" do
+    user = User.create!(name: "Alice Plus", email_address: "alice.o-connor+books@sub.example.com", password: "secret")
+    SignInEvent.create!(email_address: "alice.o-connor+books@sub.example.com", action: :signed_in)
+    user.deactivate
+    user.destroy!
+
+    assert_equal 0, SignInEvent.for_address("alice.o-connor+books@sub.example.com").count
+
+    user2 = User.create!(name: "Bob Legacy", email_address: "bob-legacy-deactivated-abc123@example.com", password: "secret", active: false)
+    SignInEvent.create!(email_address: "bob-legacy@example.com", action: :signed_in)
+    user2.destroy!
+
+    assert_equal 0, SignInEvent.for_address("bob-legacy@example.com").count
+  end
+
+  test "erasing a user whose active email contains -deactivated- does not erase unrelated sign-in events" do
+    SignInEvent.create!(email_address: "alice@example.com", action: :signed_in)
+    user = User.create!(name: "Weird Email", email_address: "alice-deactivated-note@example.com", password: "secret", active: true)
+    SignInEvent.create!(email_address: "alice-deactivated-note@example.com", action: :signed_in)
+
+    user.destroy!
+
+    assert_equal 0, SignInEvent.for_address("alice-deactivated-note@example.com").count
+    assert_equal 1, SignInEvent.for_address("alice@example.com").count
+  end
