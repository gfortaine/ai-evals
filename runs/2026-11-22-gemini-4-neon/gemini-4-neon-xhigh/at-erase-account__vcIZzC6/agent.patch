+  test "erasing a user preserves books shared with everyone and bylines them Deleted author" do
+    kevin = users(:kevin)
+    david = users(:david)
+    jz = users(:jz)
+
+    Current.user = kevin
+    shared_book = Book.create!(title: "Shared Team Guide", author: "Kevin", everyone_access: true)
+    shared_book.cover.attach(
+      io: File.open(file_fixture("reading.webp")),
+      filename: "shared-cover.webp",
+      content_type: "image/webp"
+    )
+    shared_book.update_access(editors: [ kevin.id ], readers: [ david.id, jz.id ])
+    shared_leaf = shared_book.press(Page.new(body: "helpful_shared_team_content"), title: "Getting Started")
+
+    ReadingMark.remember(shared_leaf, user: kevin)
+    ReadingMark.remember(shared_leaf, user: jz)
+
+    original_updated_at = shared_book.updated_at
+
+    travel 5.seconds do
+      Current.user = david
+      kevin.destroy!
+    end
+
+    assert_not User.exists?(kevin.id)
+    assert Book.exists?(shared_book.id)
+
+    shared_book.reload
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+    assert_operator shared_book.updated_at, :>, original_updated_at
+    assert shared_book.cover.attached?
+    assert ActiveStorage::Blob.service.exist?(shared_book.cover.blob.key)
+
+    assert_not shared_book.accesses.exists?(user_id: kevin.id)
+    assert shared_book.accessable?(user: david)
+    assert shared_book.accessable?(user: jz)
+    assert_not ReadingMark.exists?(user_id: kevin.id)
+    assert ReadingMark.exists?(user: jz, leaf: shared_leaf)
+    assert_includes Leaf.search("helpful_shared_team_content"), shared_leaf
+
+    # Editing the surviving book later does not reassign creator_id to Current.user
+    Current.user = david
+    shared_book.update!(title: "Shared Team Guide v2")
+    assert_nil shared_book.reload.creator_id
+  end
