diff --git a/lib/rails_ext/resque_continuable.rb b/lib/rails_ext/resque_continuable.rb
new file mode 100644
index 0000000..f70474f
--- /dev/null
+++ b/lib/rails_ext/resque_continuable.rb
@@ -0,0 +1,22 @@
+module ResqueContinuable
+  module Adapter
+    def stopping?
+      super || !!Thread.current[:resque_worker]&.shutdown?
+    end
+  end
+
+  module Worker
+    def perform(job, &block)
+      previous = Thread.current[:resque_worker]
+      Thread.current[:resque_worker] = self
+      super
+    ensure
+      Thread.current[:resque_worker] = previous
+    end
+  end
+end
+
+ActiveSupport.on_load :active_job do
+  ActiveJob::QueueAdapters::ResqueAdapter.prepend ResqueContinuable::Adapter
+  Resque::Worker.prepend ResqueContinuable::Worker
+end
diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
