diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
index 0000000..953c1b1
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,307 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  include PushTestHelper
+
+  setup do
+    @kevin = users(:kevin)
+    @david = users(:david)
+    @account = @kevin.account
+    stub_dns_resolution(PUBLIC_TEST_IP)
+  end
+
+  test "creating a comment notification pushes exact tray text and card path to all subscribed devices" do
+    phone_keys = generate_push_client_keys
+    desktop_keys = generate_push_client_keys
+
+    phone_endpoint = "https://web.push.apple.com/phone-token"
+    desktop_endpoint = "https://fcm.googleapis.com/fcm/send/desktop-token"
+
+    @kevin.push_subscriptions.create!(endpoint: phone_endpoint, p256dh_key: phone_keys[:p256dh_key], auth_key: phone_keys[:auth_key])
+    @kevin.push_subscriptions.create!(endpoint: desktop_endpoint, p256dh_key: desktop_keys[:p256dh_key], auth_key: desktop_keys[:auth_key])
+
+    captured = {}
+    stub_request(:post, phone_endpoint).with { |req| captured[:phone] = req; true }.to_return(status: 201)
+    stub_request(:post, desktop_endpoint).with { |req| captured[:desktop] = req; true }.to_return(status: 201)
+
+    notifications(:layout_commented_kevin).destroy
+
+    with_vapid_keys do
+      perform_enqueued_jobs do
+        Notification.create!(user: @kevin, source: events(:layout_commented), creator: @david)
+      end
+    end
+
+    assert captured[:phone], "Expected push to phone"
+    assert captured[:desktop], "Expected push to desktop"
+
+    phone_payload = decrypt_web_push_payload(captured[:phone].body, ec_key: phone_keys[:ec_key], auth_bytes: phone_keys[:auth_bytes])
+    desktop_payload = decrypt_web_push_payload(captured[:desktop].body, ec_key: desktop_keys[:ec_key], auth_bytes: desktop_keys[:auth_bytes])
+
+    comment = events(:layout_commented).eventable
+    expected_path = "#{@account.slug}/cards/#{comment.card.number}##{ActionView::RecordIdentifier.dom_id(comment)}"
+
+    [ phone_payload, desktop_payload ].each do |payload|
+      assert_equal "RE: Layout is broken", payload["title"]
+      assert_equal "The text is overflowing the container.", payload.dig("options", "body")
+      assert_equal "/app-icon-192.png", payload.dig("options", "icon")
+      assert_equal expected_path, payload.dig("options", "data", "path")
+      assert_equal @kevin.notifications.unread.count, payload.dig("options", "data", "badge")
+    end
+  end
+
+  test "comment mention notification pushes exact tray text and opens the mentioned comment on the card" do
+    client_keys = generate_push_client_keys
+    endpoint = "https://fcm.googleapis.com/fcm/send/david-desktop"
+    @david.push_subscriptions.create!(endpoint: endpoint, p256dh_key: client_keys[:p256dh_key], auth_key: client_keys[:auth_key])
+
+    captured = nil
+    stub_request(:post, endpoint).with { |req| captured = req; true }.to_return(status: 201)
+
+    notifications(:logo_mentioned_david).destroy
+
+    with_vapid_keys do
+      perform_enqueued_jobs do
+        Notifier.for(mentions(:logo_comment_david_mention_by_jz)).notify
+      end
+    end
+
+    assert captured, "Expected push for mention"
+    payload = decrypt_web_push_payload(captured.body, ec_key: client_keys[:ec_key], auth_bytes: client_keys[:auth_bytes])
+
+    mention = mentions(:logo_comment_david_mention_by_jz)
+    expected_path = "#{@account.slug}/cards/#{mention.card.number}##{ActionView::RecordIdentifier.dom_id(mention.source)}"
+
+    assert_equal "JZ @mentioned you", payload["title"]
+    assert_equal "I agree.", payload.dig("options", "body")
+    assert_equal expected_path, payload.dig("options", "data", "path")
+  end
+
+  test "card mention notification pushes exact tray text and opens the mentioned card" do
+    client_keys = generate_push_client_keys
+    endpoint = "https://fcm.googleapis.com/fcm/send/david-card-mention"
+    @david.push_subscriptions.create!(endpoint: endpoint, p256dh_key: client_keys[:p256dh_key], auth_key: client_keys[:auth_key])
+
+    cards(:logo).update!(description: "Check out this new logo direction")
+    notifications(:logo_mentioned_david).destroy
+
+    captured = nil
+    stub_request(:post, endpoint).with { |req| captured = req; true }.to_return(status: 201)
+
+    with_vapid_keys do
+      perform_enqueued_jobs do
+        Notifier.for(mentions(:logo_card_david_mention_by_jz)).notify
+      end
+    end
+
+    assert captured, "Expected push for card mention"
+    payload = decrypt_web_push_payload(captured.body, ec_key: client_keys[:ec_key], auth_bytes: client_keys[:auth_bytes])
+
+    assert_equal "JZ @mentioned you", payload["title"]
+    assert_equal "Check out this new logo direction", payload.dig("options", "body")
+    assert_equal "#{@account.slug}/cards/#{cards(:logo).number}", payload.dig("options", "data", "path")
+  end
+
+  test "updating an existing card notification with new activity sends a push for the new activity" do
+    client_keys = generate_push_client_keys
+    endpoint = "https://fcm.googleapis.com/fcm/send/kevin-laptop"
+    @kevin.push_subscriptions.create!(endpoint: endpoint, p256dh_key: client_keys[:p256dh_key], auth_key: client_keys[:auth_key])
+
+    # Kevin already has a notification for the logo card (logo_assignment_kevin)
+    assert @kevin.notifications.exists?(card: cards(:logo))
+
+    captured = nil
+    stub_request(:post, endpoint).with { |req| captured = req; true }.to_return(status: 201)
+
+    with_vapid_keys do
+      perform_enqueued_jobs do
+        # New comment on the same logo card updates Kevin's existing notification
+        comment = cards(:logo).comments.create!(body: "New comment on logo!", creator: @david)
+        cards(:logo).watch_by(@kevin)
+        event = boards(:writebook).events.create!(action: "comment_created", creator: @david, eventable: comment)
+        Notifier.for(event).notify
+      end
+    end
+
+    assert captured, "Expected push when existing card notification is updated with new activity"
+    payload = decrypt_web_push_payload(captured.body, ec_key: client_keys[:ec_key], auth_bytes: client_keys[:auth_bytes])
+
+    assert_equal "RE: The logo isn't big enough", payload["title"]
+    assert_equal "New comment on logo!", payload.dig("options", "body")
+    assert_match %r{\A#{@account.slug}/cards/#{cards(:logo).number}#comment_}, payload.dig("options", "data", "path")
+  end
+
+  test "marking a notification read or manually unread does not send a push" do
+    client_keys = generate_push_client_keys
+    endpoint = "https://fcm.googleapis.com/fcm/send/kevin-no-push"
+    @kevin.push_subscriptions.create!(endpoint: endpoint, p256dh_key: client_keys[:p256dh_key], auth_key: client_keys[:auth_key])
+
+    stub = stub_request(:post, endpoint).to_return(status: 201)
+    notification = notifications(:logo_assignment_kevin)
+
+    with_vapid_keys do
+      perform_enqueued_jobs do
+        notification.read
+        notification.unread
+      end
+    end
+
+    assert_not_requested stub
+  end
+
+  test "expired subscription on one device does not block delivery to other devices" do
+    dead_keys = generate_push_client_keys
+    live_keys = generate_push_client_keys
+
+    dead_endpoint = "https://example.com/push/dead-phone"
+    live_endpoint = "https://example.com/push/live-desktop"
+
+    dead_sub = @kevin.push_subscriptions.create!(endpoint: dead_endpoint, p256dh_key: dead_keys[:p256dh_key], auth_key: dead_keys[:auth_key])
