@@ -0,0 +1,48 @@
+module Push
+  DEFAULT_VAPID_SUBJECT = "mailto:support@fizzy.do"
+
+  class << self
+    def table_name_prefix
+      "push_"
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].presence || Rails.configuration.x.vapid.public_key.presence
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"].presence || Rails.configuration.x.vapid.private_key.presence
+    end
+
+    def vapid_subject
+      ENV["VAPID_SUBJECT"].presence || Rails.configuration.x.vapid.subject.presence || default_vapid_subject
+    end
+
+    def vapid_credentials
+      {
+        subject: vapid_subject,
+        public_key: vapid_public_key,
+        private_key: vapid_private_key
+      }
+    end
+
+    def configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    private
+      def default_vapid_subject
+        if email = extract_email_address(ENV["MAILER_FROM_ADDRESS"])
+          "mailto:#{email}"
+        else
+          DEFAULT_VAPID_SUBJECT
+        end
+      end
+
+      def extract_email_address(value)
+        Mail::Address.new(value).address if value.present?
+      rescue Mail::Field::IncompleteParseError, Mail::Field::ParseError
+        nil
+      end
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..b3f68c3
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,58 @@
+class Push::Subscription < ApplicationRecord
+  ENDPOINT_TIMEOUT = 5.seconds
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  normalizes :endpoint, with: -> { it.strip }
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :validate_endpoint
+
+  def deliver(payload)
+    message = payload.is_a?(String) ? payload : payload.to_json
+
+    WebPush.payload_send(
+      message: message,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: Push.vapid_credentials,
+      open_timeout: ENDPOINT_TIMEOUT,
+      read_timeout: ENDPOINT_TIMEOUT,
+      ssl_timeout: ENDPOINT_TIMEOUT
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPush::Error, OpenSSL::OpenSSLError, ArgumentError,
+    Net::OpenTimeout, Net::ReadTimeout, SocketError,
+    Errno::ECONNREFUSED, Errno::ECONNRESET, Errno::EHOSTUNREACH, Errno::ETIMEDOUT => e
+    Rails.logger.warn "Failed to deliver web push notification to subscription #{id}: #{e.class}: #{e.message}"
+  end
+
+  private
+    def validate_endpoint
+      return if endpoint.blank?
+
+      uri = URI.parse(endpoint)
+
+      if uri.is_a?(URI::HTTPS) && uri.hostname.present?
+        errors.add(:endpoint, "cannot point to a private or local address") if blocked_host?(uri.hostname)
+      else
+        errors.add(:endpoint, "must be a valid HTTPS URL")
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "must be a valid HTTPS URL")
+    end
+
+    def blocked_host?(hostname)
+      if hostname.casecmp?("localhost") || hostname.downcase.end_with?(".localhost")
+        true
+      else
+        ipaddr = IPAddr.new(hostname)
+        SsrfProtection.blocked_address?(ipaddr)
+      end
+    rescue IPAddr::InvalidAddressError
+      false
+    end
+end
